-- A third-party style grammar with no compiler imports: one `key = literal`
-- assignment checked against the host record type `settings`. It proves the
-- tooling contract is a public surface rather than a first-party registry.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{Diagnose, DiagnosticClassGrammar, DiagnosticSeverityError}
use stdlib/file.{FileRead}
use stdlib/grammar.{Grammar, ParseResult, Parsed, Rejected}
use stdlib/grammar/tooling.{*}
use stdlib/grammar/tooling/staging.{*}
use stdlib/io/types.{IoError}
use stdlib/json.{Json, JsonEntry, JsonNull, JsonNumber, JsonObject, JsonString}
use stdlib/list as list
use stdlib/list.{List, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{SemanticTypeFact, SemanticTypeNamed, SemanticTypePrimitive}
use stdlib/source.{Span}
use stdlib/typecheck.{TypeCheck, TypeName, NamedTypeField}

pub type AssignmentLiteral { IntegerLiteral, TextLiteral }

pub type AssignmentSyntax {
  key: str,
  key_span: Span,
  literal: AssignmentLiteral,
  literal_span: Span
}

pub type AssignmentGrammar { AssignmentGrammar }

pub fn grammar() -> AssignmentGrammar { AssignmentGrammar() }

--- A second exported grammar using the same syntax but a file-owned context.
--- It exists to prove staging-site context selection without compiler help.
pub type FileAssignmentGrammar { FileAssignmentGrammar }

fn whitespace(byte: u8) -> bool { byte == 32 or byte == 9 or byte == 10 or byte == 13 }

fn letter(byte: u8) -> bool {
  (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95
}

fn digit(byte: u8) -> bool { byte >= 48 and byte <= 57 }

fn skip(source: Span, initial: usize) -> usize {
  let mut position = initial
  while position < source.len() {
    match source.byte_at(position) {
      Some(byte) if whitespace(byte) -> { position = position + 1 }
      _ -> return position
    }
  }
  position
}

fn scan_letters(source: Span, initial: usize) -> usize {
  let mut position = initial
  while position < source.len() {
    match source.byte_at(position) {
      Some(byte) if letter(byte) -> { position = position + 1 }
      _ -> return position
    }
  }
  position
}

fn scan_digits(source: Span, initial: usize) -> usize {
  let mut position = initial
  while position < source.len() {
    match source.byte_at(position) {
      Some(byte) if digit(byte) -> { position = position + 1 }
      _ -> return position
    }
  }
  position
}

fn part(source: Span, start: usize, end: usize) -> Span {
  source.subspan(start, end).unwrap()
}

fn text_of(source: Span, start: usize, end: usize) -> str {
  match part(source, start, end).text() {
    Some(text) -> text
    None -> ""
  }
}

fn reject(source: Span, position: usize, message: str) -[Diagnose]> ParseResult<AssignmentSyntax>
{
  let end = if position < source.len() { position + 1 } else { position }
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      message,
      part(source, position, end).location()
    )
  )
  Rejected<AssignmentSyntax>()
}

fn finish(
  source: Span,
  key_start: usize,
  key_end: usize,
  literal: AssignmentLiteral,
  literal_start: usize,
  literal_end: usize
) -[Diagnose]> ParseResult<AssignmentSyntax> {
  let trailing = skip(source, literal_end)
  if trailing < source.len() { reject(source, trailing, "unexpected input after the literal") } else {
    Parsed<AssignmentSyntax>(
      AssignmentSyntax {
        key: text_of(source, key_start, key_end),
        key_span: part(source, key_start, key_end),
        literal: literal,
        literal_span: part(source, literal_start, literal_end)
      }
    )
  }
}

impl Grammar for AssignmentGrammar {
  type Syntax = AssignmentSyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<AssignmentSyntax> {
    let key_start = skip(source, 0)
    let key_end = scan_letters(source, key_start)
    if key_end == key_start { return reject(source, key_start, "expected an assignment key") }
    let equals = skip(source, key_end)
    match source.byte_at(equals) {
      Some(byte) if byte == 61 -> {
        let value_start = skip(source, equals + 1)
        match source.byte_at(value_start) {
          Some(byte) if digit(byte) -> finish(
            source,
            key_start,
            key_end,
            IntegerLiteral,
            value_start,
            scan_digits(source, value_start)
          )
          Some(byte) if byte == 34 -> {
            let mut end = value_start + 1
            while end < source.len() {
              match source.byte_at(end) {
                Some(inner) if inner == 34 -> break
                _ -> { end = end + 1 }
              }
            }
            if end >= source.len() { reject(source, value_start, "text literal is not closed") } else {
              finish(source, key_start, key_end, TextLiteral, value_start, end + 1)
            }
          }
          _ -> reject(source, value_start, "expected an integer or a quoted text literal")
        }
      }
      _ -> reject(source, equals, "expected '=' after the key")
    }
  }
}

impl Grammar for FileAssignmentGrammar {
  type Syntax = AssignmentSyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<AssignmentSyntax> {
    AssignmentGrammar().parse(source)
  }
}

fn report_at(span: Span, message: str) -[Diagnose]> nil {
  Diagnose.report(
    diagnostic.uncoded(DiagnosticSeverityError, DiagnosticClassGrammar, message, span.location())
  )
  nil
}

fn literal_matches(literal: AssignmentLiteral, description: SemanticTypeFact) -> bool {
  match (literal, description) {
    (IntegerLiteral, SemanticTypePrimitive(name)) -> name == "i64"
    (TextLiteral, SemanticTypePrimitive(name)) -> name == "str"
    _ -> false
  }
}

--- The checked assignment in the form staging persists: the key, the host
--- field's type as a fact, and the literal as spelled. No session identity
--- survives into it.
pub type AssignmentPlan {
  key: str,
  field: SemanticTypeFact,
  literal: AssignmentLiteral,
  text: str
}

fn settings_request() -> TypeName<ToolTypeIdentity> {
  TypeName { qualifier: None<str>(), name: "settings", arguments: Nil<ToolTypeIdentity>() }
}

fn literal_text(syntax: AssignmentSyntax) -> str {
  match syntax.literal_span.text() {
    Some(text) -> text
    None -> ""
  }
}

-- The one package-owned check: the tooling report and the staged plan are
-- two views of its result.
fn resolve_assignment(
  syntax: AssignmentSyntax
) -[TypeCheck<ToolTypeIdentity>, Diagnose]> Result<AssignmentPlan, StagingRefusal> {
  match TypeCheck<ToolTypeIdentity>.resolve(settings_request()) {
    Err(_) -> {
      report_at(syntax.key_span, "the host declares no settings record")
      Err<AssignmentPlan, StagingRefusal>(StagingCheckRejected)
    }
    Ok(settings) -> match TypeCheck<ToolTypeIdentity>.field(
      settings.identity,
      NamedTypeField(syntax.key)
    ) {
      Err(_) -> {
        report_at(syntax.key_span, "settings has no field with this name")
        Err<AssignmentPlan, StagingRefusal>(StagingCheckRejected)
      }
      Ok(field) -> if literal_matches(syntax.literal, field.description) {
        Ok<AssignmentPlan, StagingRefusal>(
          AssignmentPlan {
            key: syntax.key,
            field: field.description,
            literal: syntax.literal,
            text: literal_text(syntax)
          }
        )
      } else {
        report_at(syntax.literal_span, "the literal does not match the field type")
        Err<AssignmentPlan, StagingRefusal>(StagingCheckRejected)
      }
    }
  }
}

impl GrammarTooling for AssignmentGrammar {
  type Syntax = AssignmentSyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarHostTypesContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: AssignmentSyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    match resolve_assignment(syntax) {
      Ok(_) -> checked_report()
      Err(_) -> rejected_report()
    }
  }

  fn check_with_context(
    self,
    syntax: AssignmentSyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    unsupported_report(GrammarFileContext)
  }
}

fn context_bytes(
  context: Path,
  limit: usize
) -[FileRead]> Result<Bytes, StagingRefusal> {
  match FileRead.read_all(context, limit) {
    Ok(content) -> Ok<Bytes, StagingRefusal>(content)
    Err(_) -> Err<Bytes, StagingRefusal>(StagingContextUnavailable)
  }
}

impl GrammarTooling for FileAssignmentGrammar {
  type Syntax = AssignmentSyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarFileContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: AssignmentSyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    unsupported_report(GrammarHostTypesContext)
  }

  fn check_with_context(
    self,
    syntax: AssignmentSyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    match context_bytes(context, limit) {
      Ok(_) -> checked_report()
      Err(_) -> context_unavailable_report()
    }
  }
}

fn fact_name(fact: SemanticTypeFact) -> str {
  match fact {
    SemanticTypePrimitive(name) -> name
    SemanticTypeNamed(name, _) -> name
    _ -> "other"
  }
}

fn literal_name(literal: AssignmentLiteral) -> str {
  match literal {
    IntegerLiteral -> "integer"
    TextLiteral -> "text"
  }
}

fn platform_known(platform: str) -> bool {
  platform == "macos-aarch64" or platform == "linux-aarch64"
}

fn typed_plan_support() -> List<StagingSupport> {
  let supports = [
    StagingSupport {
      capability: StagingTypedPlan,
      budget: StagingBudget { seconds: 5, bytes: __i64_to_usize(4096) }
    }
  ]
  list.from_slice(supports[..])
}

fn sink_refused(error: IoError) -> StagingReport {
  StagingReport { outcome: StagingSinkRefused(error), facts: JsonNull }
}

fn plan_facts(plan: AssignmentPlan) -> Json {
  let entries = [
    JsonEntry("key", JsonString(plan.key)),
    JsonEntry("literal", JsonString(literal_name(plan.literal)))
  ]
  JsonObject(list.from_slice(entries[..]))
}

--- Staging renders the plan as two text lines, the header and the value, so
--- a budget that admits the first and refuses the second leaves a partial
--- artifact the compiler must discard.
impl GrammarStaging for AssignmentGrammar {
  type Syntax = AssignmentSyntax
  type Persistent = AssignmentPlan

  fn stagings(self) -> List<StagingSupport> { typed_plan_support() }

  fn persist(
    self,
    syntax: AssignmentSyntax,
    context: StagingContext
  ) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<AssignmentPlan, StagingRefusal> {
    match context {
      StagingFileContext(_, _) -> Err<AssignmentPlan, StagingRefusal>(
        StagingContextUnsupported(GrammarFileContext)
      )
      StagingHostTypes -> resolve_assignment(syntax)
    }
  }

  fn emit(
    self,
    plan: AssignmentPlan,
    target: StagingTarget
  ) -[StagingSink, Diagnose]> StagingReport {
    if not platform_known(target.platform) {
      StagingReport { outcome: StagingUnsupportedTarget, facts: JsonNull }
    } else {
      let typed = "assignment ".concat(plan.key).concat(" : ").concat(fact_name(plan.field))
      let header = typed.concat("\n")
      let value = "= ".concat(plan.text).concat("\n")
      match StagingSink.emit(bytes.from_str(header)) {
        Err(error) -> sink_refused(error)
        Ok(_) -> match StagingSink.emit(bytes.from_str(value)) {
          Err(error) -> sink_refused(error)
          Ok(_) -> StagingReport { outcome: StagingEmitted, facts: plan_facts(plan) }
        }
      }
    }
  }
}

pub type FileAssignmentPlan { source: str, context: Bytes }

impl GrammarStaging for FileAssignmentGrammar {
  type Syntax = AssignmentSyntax
  type Persistent = FileAssignmentPlan

  fn stagings(self) -> List<StagingSupport> { typed_plan_support() }

  fn persist(
    self,
    syntax: AssignmentSyntax,
    context: StagingContext
  ) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<
    FileAssignmentPlan,
    StagingRefusal
  > {
    match context {
      StagingHostTypes -> Err<FileAssignmentPlan, StagingRefusal>(
        StagingContextUnsupported(GrammarHostTypesContext)
      )
      StagingFileContext(context_path, limit) -> match context_bytes(context_path, limit) {
        Err(error) -> Err<FileAssignmentPlan, StagingRefusal>(error)
        Ok(content) -> Ok<FileAssignmentPlan, StagingRefusal>(
          FileAssignmentPlan { source: syntax.key, context: content }
        )
      }
    }
  }

  fn emit(
    self,
    plan: FileAssignmentPlan,
    target: StagingTarget
  ) -[StagingSink, Diagnose]> StagingReport {
    if not platform_known(target.platform) {
      StagingReport { outcome: StagingUnsupportedTarget, facts: JsonNull }
    } else {
      let prefix = bytes.from_str(plan.source.concat("\n"))
      match StagingSink.emit(prefix) {
        Err(error) -> sink_refused(error)
        Ok(_) -> match StagingSink.emit(plan.context) {
          Err(error) -> sink_refused(error)
          Ok(_) -> StagingReport { outcome: StagingEmitted, facts: JsonNull }
        }
      }
    }
  }
}

--- The same syntax staged by a grammar whose plan keeps the session token
--- the host answered with. The conformance suite's two-session byte
--- identity test exists to catch exactly this plan.
pub type LeakyAssignmentGrammar { LeakyAssignmentGrammar }

pub type LeakyPlan { key: str, token: i64 }

impl Grammar for LeakyAssignmentGrammar {
  type Syntax = AssignmentSyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<AssignmentSyntax> {
    AssignmentGrammar().parse(source)
  }
}

impl GrammarStaging for LeakyAssignmentGrammar {
  type Syntax = AssignmentSyntax
  type Persistent = LeakyPlan

  fn stagings(self) -> List<StagingSupport> { typed_plan_support() }

  fn persist(
    self,
    syntax: AssignmentSyntax,
    context: StagingContext
  ) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<LeakyPlan, StagingRefusal> {
    match TypeCheck<ToolTypeIdentity>.resolve(settings_request()) {
      Err(_) -> Err<LeakyPlan, StagingRefusal>(StagingCheckRejected)
      Ok(settings) -> Ok<LeakyPlan, StagingRefusal>(
        LeakyPlan { key: syntax.key, token: tool_type_identity_token(settings.identity) }
      )
    }
  }

  fn emit(self, plan: LeakyPlan, target: StagingTarget) -[StagingSink, Diagnose]> StagingReport {
    let token = JsonNumber(plan.token).stringify().unwrap_or("?")
    let line = plan.key.concat(" ").concat(token).concat("\n")
    match StagingSink.emit(bytes.from_str(line)) {
      Err(error) -> sink_refused(error)
      Ok(_) -> StagingReport { outcome: StagingEmitted, facts: JsonNull }
    }
  }
}
