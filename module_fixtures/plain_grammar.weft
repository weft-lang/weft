-- A grammar with no tooling conformance: one bare word. It proves parse-only
-- consumers see the `Grammar` contract alone, and that host or context
-- checking of a grammar without `GrammarTooling` is a type error, not a
-- runtime refusal.

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{Diagnose, DiagnosticClassGrammar, DiagnosticSeverityError}
use stdlib/grammar.{Grammar, ParseResult, Parsed, Rejected}
use stdlib/option.{Option, Some, None}
use stdlib/source.{Span}

pub type WordSyntax { word: str, word_span: Span }

pub type WordGrammar { WordGrammar }

pub fn grammar() -> WordGrammar { WordGrammar() }

fn letter(byte: u8) -> bool {
  (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
}

fn scan_letters(source: Span, initial: usize) -> usize {
  let mut position = initial
  while position < source.len() {
    match source.byte_at(position) {
      Some(byte) if letter(byte) -> { position = position + 1 }
      _ -> return position
    }
  }
  position
}

fn reject(source: Span, position: usize, message: str) -[Diagnose]> ParseResult<WordSyntax> {
  let end = if position < source.len() { position + 1 } else { position }
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      message,
      source.subspan(position, end).unwrap().location()
    )
  )
  Rejected<WordSyntax>()
}

impl Grammar for WordGrammar {
  type Syntax = WordSyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<WordSyntax> {
    let end = scan_letters(source, 0)
    if end == 0 { reject(source, 0, "expected a word") } else {
      if end < source.len() { reject(source, end, "unexpected input after the word") } else {
        let word_span = source.subspan(0, end).unwrap()
        Parsed<WordSyntax>(
          WordSyntax {
            word: match word_span.text() { Some(text) -> text, None -> "" },
            word_span: word_span
          }
        )
      }
    }
  }
}
