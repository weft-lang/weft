use module_fixtures/g4_type_dep_right as right

pub type SameError {
  LeftFirst,
  LeftSecond
}

pub type SameRecord {
  left: i64
}

pub fn make() -> SameError {
  if right.touch() == 0 { LeftFirst } else { LeftSecond }
}

pub fn make_record(value: i64) -> SameRecord {
  SameRecord { left: value }
}
