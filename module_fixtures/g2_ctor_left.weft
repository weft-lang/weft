pub type LeftChoice {
  Same(i64),
  Empty
}

pub type LeftBox<T> {
  Packed(T)
}

pub fn read(choice: LeftChoice) -> i64 {
  match choice {
    Same(value) -> value
    Empty -> 0
  }
}

pub fn unpack<T>(box: LeftBox<T>, fallback: T) -> T {
  match box {
    Packed(value) -> value
    _ -> fallback
  }
}

type HiddenChoice {
  Hidden(i64)
}

impl LeftChoice {
  pub fn same_value(self) -> i64 {
    match self {
      Same(value) -> value
      Empty -> 0
    }
  }

  fn hidden_value(self) -> i64 { 99 }

  pub(package) fn package_value(self) -> i64 { 77 }
}

impl<T> LeftBox<T> {
  pub fn value_or(self, fallback: T) -> T {
    match self {
      Packed(value) -> value
    }
  }
}
