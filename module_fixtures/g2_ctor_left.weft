pub type LeftChoice {
  Same(i64),
  Empty
}

pub type LeftBox<T> {
  Packed(T)
}

pub type Echo {
  Echo(i64)
}

pub fn read(choice: LeftChoice) -> i64 {
  match choice {
    Same(value) -> value
    Empty -> 0
  }
}

pub fn unpack<T>(box: LeftBox<T>, fallback: T) -> T {
  match box {
    Packed(value) -> value
    _ -> fallback
  }
}

pub fn read_echo(value: Echo) -> i64 {
  match value { Echo(inner) -> inner }
}

type HiddenChoice {
  Hidden(i64)
}

impl LeftChoice {
  pub fn origin_value() -> i64 { 101 }

  pub fn same_value(self) -> i64 {
    match self {
      Same(value) -> value
      Empty -> 0
    }
  }

  fn hidden_value(self) -> i64 { 99 }

  fn hidden_origin_value() -> i64 { 98 }

  pub(package) fn package_value(self) -> i64 { 77 }

  pub(package) fn package_origin_value() -> i64 { 76 }
}

impl<T> LeftBox<T> {
  pub fn type_marker() -> i64 { 55 }

  pub fn value_or(self, fallback: T) -> T {
    match self {
      Packed(value) -> value
    }
  }
}
