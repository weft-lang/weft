pub type LeftChoice {
  Same(i64),
  Empty
}

pub type LeftBox<T> {
  Packed(T)
}

pub fn read(choice: LeftChoice) -> i64 {
  match choice {
    Same(value) -> value
    Empty -> 0
  }
}

pub fn unpack<T>(box: LeftBox<T>, fallback: T) -> T {
  match box {
    Packed(value) -> value
    _ -> fallback
  }
}

type HiddenChoice {
  Hidden(i64)
}
