-- Assertion helpers that perform Test on a root's behalf. The generated
-- harness must discharge these operations even though the root never spells
-- them.

use stdlib/test.{Test}

pub fn assert_close(got: f64, expected: f64) -[Test]> nil {
  Test.assert_near_f64(got, expected, 0.001)
  nil
}

pub fn assert_distinct_text(got: str, unexpected: str) -[Test]> nil {
  Test.assert_str_ne(got, unexpected)
  nil
}

pub fn assert_ordered(low: i64, high: i64) -[Test]> nil {
  Test.assert_lt(low, high)
  Test.assert_ge(high, low)
  nil
}
