use module_fixtures/g4_opaque_left.{Same, make, read}

pub effect OpaqueRelay {
  fn relay(value: Same) -> Same
}

pub fn make_value(value: i64) -> Same { make(value) }

pub fn read_value(value: Same) -> i64 { read(value) }

pub fn relay_value(value: Same) -[OpaqueRelay]> Same {
  OpaqueRelay.relay(value)
}
