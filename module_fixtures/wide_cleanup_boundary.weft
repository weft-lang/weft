use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new}
use stdlib/drop.{*}
use stdlib/http.{HttpHeaders, http_headers_empty}
use stdlib/json.{Json}

pub type ImportedCleanupWide = opaque(owned OwnedAbortToken, str, i64, bool, i64)

pub type ImportedCleanupResult {
  ImportedCleanupReady(owned ImportedCleanupWide, Json, HttpHeaders)
}

impl Drop for ImportedCleanupWide {
  fn drop(self) -> i64 {
    match self {
      ImportedCleanupWide((token, buffered, offset, reusable, identity)) -> token.drop()
    }
  }
}

pub fn imported_cleanup_wide_new(log: i64) -> owned ImportedCleanupWide {
  ImportedCleanupWide((owned_abort_token_new(log, 7), "buffered", 20, true, 22))
}

pub fn imported_cleanup_result(
  value: owned ImportedCleanupWide,
  document: Json
) -> ImportedCleanupResult {
  ImportedCleanupReady(value, document, http_headers_empty())
}

pub fn imported_cleanup_wide_check_and_drop(value: owned ImportedCleanupWide) -> i64 {
  match value {
    ImportedCleanupWide((token, buffered, offset, reusable, identity)) -> {
      let dropped = token.drop()
      if buffered == "buffered" and offset + identity == 42 and reusable { 42 } else { 0 }
    }
  }
}
