use module_fixtures/g4_opaque_trait.{OpaqueIdentity}
use runtime/defer_order_test.{defer_order_log_read, defer_order_log_write}
use stdlib/drop.{*}
use stdlib/result.{Result, result_ok}
use stdlib/string.{str_concat}

pub type Same = opaque i64

pub type ManagedOpaque = opaque(str, bool)

pub fn make(value: i64) -> Same { Same(value) }

pub fn read(value: Same) -> i64 {
  match value { Same(inner) -> inner }
}

pub fn make_owned(log: i64) -> owned Same { Same(log) }

pub fn make_managed(prefix: str) -> ManagedOpaque {
  ManagedOpaque((str_concat(prefix, ".test"), true))
}

pub fn make_managed_result(prefix: str) -> Result<ManagedOpaque, i64> {
  result_ok<ManagedOpaque, i64>(make_managed(prefix))
}

pub effect ImportedBorrowEffect {
  fn inspect(value: borrow Same) -> i64
}

pub fn inspect_borrowed(value: borrow Same) -> i64 { 303 }

pub fn perform_borrowed(value: borrow Same) -[ImportedBorrowEffect]> i64 {
  ImportedBorrowEffect.inspect(value)
}

impl Same {
  pub fn native_identity(self: Same) -> i64 { 101 }
}

impl ManagedOpaque {
  pub fn managed_text(self) -> str {
    match self {
      ManagedOpaque(parts) -> match parts { (text, present) -> text }
    }
  }
}

impl OpaqueIdentity for Same {
  fn trait_identity(self: Same) -> i64 { 1001 }
}

impl Drop for Same {
  fn drop(self: i64) -> i64 {
    defer_order_log_write(self, defer_order_log_read(self) * 10 + 1)
  }
}
