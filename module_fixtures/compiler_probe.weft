-- Pass-level probes supply their complete language environment explicitly.
-- Load their imports and required runtime support, then check that exact
-- graph. Full project/prelude integration is exercised by ordinary test roots.
-- Including the implicit SDK facade here would make a one-function metric
-- depend on every implementation reachable through Display and Iterator.

use compiler/grammar.{weft_grammar}
use compiler/type_registry.{ttable_new}
use compiler/pipeline.{AstModule, TypedModule, PipelineParseResult, pipeline_parse_local_with_error_count, pipeline_parse_source_with_origin_standalone, pipeline_check_loaded, pipeline_diagnose_render, pipeline_diagnose_render_report}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/panic.{panic}

pub fn probe_check_source_with_origin(src: i64, len: i64, trusted: i64, strict: i64) -> TypedModule {
  match pipeline_parse_local_with_error_count(weft_grammar(), src, len, ttable_new()) {
    PipelineParseResult(_, errors) -> if errors != 0 { panic("compiler probe failed parsing") } else { nil }
  }
  match pipeline_parse_source_with_origin_standalone(src, len, trusted, strict) {
    AstModule(fns, source, tt) -> {
      let errors = handle pipeline_check_loaded(fns, src, tt) {
        Diagnose.report(diagnostic) -> { pipeline_diagnose_render_report(tt, diagnostic) resume(0) }
        Diagnose.error(message, span) -> { pipeline_diagnose_render(tt, src, message, span) resume(0) }
        Diagnose.warn(message, span) -> { pipeline_diagnose_render(tt, src, message, span) resume(0) }
        Diagnose.note(message, span) -> { pipeline_diagnose_render(tt, src, message, span) resume(0) }
      }
      if errors != 0 { panic("compiler probe failed checking") } else { TypedModule(fns, src, tt) }
    }
  }
}

pub fn probe_check_source(src: i64, len: i64) -> TypedModule {
  probe_check_source_with_origin(src, len, 0, 1)
}
