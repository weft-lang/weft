use compiler/weft/products.{AstModule, TypedModule}
-- Pass-level probes supply their complete language environment explicitly.
-- They inspect reusable declarations, including effectful functions named main;
-- executable-entry closure is checked by the program and native product tests.
-- Load their imports and required runtime support, then check that exact
-- graph. Full project/prelude integration is exercised by ordinary test roots.
-- Including the implicit SDK facade here would make a one-function metric
-- depend on every implementation reachable through Display and Iterator.
use compiler/source/input.{source_from_bytes}
use compiler/weft/check/table.{ttable_new}
use compiler/pipeline.{
  PipelineParseResult,
  pipeline_complete_runtime_parse,
  pipeline_parse_local_with_error_count,
  pipeline_parse_source_with_origin_standalone,
  pipeline_register_sdk_source_origin,
  pipeline_parse_with_error_count,
  pipeline_diagnose_render,
  pipeline_diagnose_render_report
}
use compiler/weft/check as weft_check
use compiler/weft/check.{CheckDeclarations}
use runtime/source_acquire.{SourceAcquire, source_acquire_with_checkout}
use stdlib/grammar.{CheckResult, Checked, CheckRejected}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/panic.{panic}

-- Positive compiler fixtures must not lower a rejected fact view.
pub fn require_checked(result: CheckResult<TypedModule>) -> TypedModule {
  match result {
    Checked(typed) -> typed
    CheckRejected -> panic("compiler fixture failed checking")
  }
}

fn probe_parse_sdk_source_with_origin_acquire(
  src: i64,
  len: i64,
  trusted: i64,
  strict: i64
) -[SourceAcquire]> AstModule {
  let source = source_from_bytes(src, len)
  let retained = __str_ptr(source.text)
  let tt = ttable_new()
  let sdk_package = handle pipeline_register_sdk_source_origin(
    tt,
    retained,
    len,
    "module_fixtures/generated_compiler_probe.weft",
    trusted,
    strict
  ) {
    Diagnose.report(diagnostic) -> {
      pipeline_diagnose_render_report(tt, diagnostic)
      resume(0)
    }
    Diagnose.error(message, span) -> {
      pipeline_diagnose_render(tt, retained, message, span)
      resume(0)
    }
    Diagnose.warn(message, span) -> {
      pipeline_diagnose_render(tt, retained, message, span)
      resume(0)
    }
    Diagnose.note(message, span) -> {
      pipeline_diagnose_render(tt, retained, message, span)
      resume(0)
    }
  }
  if sdk_package <= 0 { panic("compiler probe failed loading the SDK package") } else { nil }
  match pipeline_parse_with_error_count(source, tt) {
    PipelineParseResult(parsed, errors) ->
      if errors != 0 { panic("compiler probe failed parsing") }
    else { pipeline_complete_runtime_parse(parsed) }
  }
}

pub fn probe_parse_source_with_origin(
  src: i64,
  len: i64,
  trusted: i64,
  strict: i64
) -> AstModule {
  match pipeline_parse_local_with_error_count(source_from_bytes(src, len), ttable_new()) {
    PipelineParseResult(_, errors) -> if errors != 0 { panic("compiler probe failed parsing") }
    else { nil }
  }
  pipeline_parse_source_with_origin_standalone(src, len, trusted, strict)
}

pub fn probe_parse_sdk_source_with_origin(
  src: i64,
  len: i64,
  trusted: i64,
  strict: i64
) -> AstModule {
  -- Generated compiler probes are SDK-package fixtures. Their deliberate use
  -- of package-visible compiler/runtime surfaces must not grant that authority
  -- to an anonymous application root.
  source_acquire_with_checkout(
    ".",
    () => probe_parse_sdk_source_with_origin_acquire(src, len, trusted, strict)
  )
}

fn probe_check_ast(ast: AstModule) -> TypedModule {
  match ast {
    AstModule(fns, parsed_source, parsed_tt, owners, declarations) -> {
      let checked = handle weft_check.with_purpose(
        CheckDeclarations,
        AstModule(fns, parsed_source, parsed_tt, owners, declarations)
      ) {
        Diagnose.report(diagnostic) -> {
          pipeline_diagnose_render_report(parsed_tt, diagnostic)
          resume(0)
        }
        Diagnose.error(message, span) -> {
          pipeline_diagnose_render(parsed_tt, parsed_source, message, span)
          resume(0)
        }
        Diagnose.warn(message, span) -> {
          pipeline_diagnose_render(parsed_tt, parsed_source, message, span)
          resume(0)
        }
        Diagnose.note(message, span) -> {
          pipeline_diagnose_render(parsed_tt, parsed_source, message, span)
          resume(0)
        }
      }
      require_checked(checked)
    }
  }
}

pub fn probe_check_source_with_origin(
  src: i64,
  len: i64,
  trusted: i64,
  strict: i64
) -> TypedModule {
  probe_check_ast(probe_parse_source_with_origin(src, len, trusted, strict))
}

pub fn probe_check_sdk_source_with_origin(
  src: i64,
  len: i64,
  trusted: i64,
  strict: i64
) -> TypedModule {
  probe_check_ast(
    probe_parse_sdk_source_with_origin(src, len, trusted, strict)
  )
}

pub fn probe_check_source(src: i64, len: i64) -> TypedModule {
  probe_check_source_with_origin(src, len, 0, 1)
}
