-- A context-checked grammar that tries to read beyond its context file. The
-- tooling conformance suite must confine it to the requested path and limit;
-- the grammar reports each escape it is allowed, so a checked outcome with no
-- diagnostics means every escape was denied.

use stdlib/bytes.{Bytes}
use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{
  Diagnose,
  DiagnosticClassGrammar,
  DiagnosticLocationNone,
  DiagnosticSeverityError
}
use stdlib/file.{FileRead}
use stdlib/grammar.{Grammar, ParseResult, Parsed}
use stdlib/grammar/tooling.{*}
use stdlib/io/types.{IoError, IoPermissionDenied}
use stdlib/list as list
use stdlib/list.{List}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/source.{Span}
use stdlib/typecheck.{TypeCheck}

pub type GreedySyntax { GreedySyntax }

pub type GreedyGrammar { GreedyGrammar }

pub fn grammar() -> GreedyGrammar { GreedyGrammar() }

--- The path the grammar tries to read besides its context.
pub fn escape_path() -> Path {
  path.from_utf8("test/fixtures/comptime_einsum_context_v1.json").unwrap()
}

impl Grammar for GreedyGrammar {
  type Syntax = GreedySyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<GreedySyntax> {
    Parsed<GreedySyntax>(GreedySyntax())
  }
}

fn report_escape(message: str) -[Diagnose]> nil {
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      message,
      DiagnosticLocationNone
    )
  )
  nil
}

-- Report when a read that must be denied was answered or failed for another
-- reason; a permission denial is the expected, silent outcome.
fn expect_denied(attempt: Result<Bytes, IoError>, message: str) -[Diagnose]> nil {
  match attempt {
    Ok(_) -> report_escape(message)
    Err(IoPermissionDenied) -> nil
    Err(_) -> report_escape("an out-of-context read failed without a permission denial")
  }
}

impl GrammarTooling for GreedyGrammar {
  type Syntax = GreedySyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarFileContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: GreedySyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    unsupported_report(GrammarHostTypesContext)
  }

  fn check_with_context(
    self,
    syntax: GreedySyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    match FileRead.read_all(context, limit) {
      Err(_) -> context_unavailable_report()
      Ok(_) -> {
        expect_denied(
          FileRead.read_all(escape_path(), limit),
          "a read outside the context was answered"
        )
        expect_denied(
          FileRead.read_all(context, limit + 1),
          "a read beyond the context limit was answered"
        )
        checked_report()
      }
    }
  }
}
