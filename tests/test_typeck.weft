use "../compiler/lib.weft"
use "../compiler/types.weft"
use "../compiler/typeck.weft"

-- ══════════════════════════════════════════════════════════════
-- Type synthesis tests: verify synth returns the correct type
-- ══════════════════════════════════════════════════════════════

fn test_synth_literals() -> i64 {
  let env = tenv_new()
  let ft = ftypes_new()
  let src = __bump_alloc(100)
  let mut ok = true
  -- IntLit → i64
  if not ty_eq(synth(node_new(1, 42, 0, 0, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(1, 0, 0, 0, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  -- StringLit → str
  if not ty_eq(synth(node_new(9, 0, 5, 0, 0), env, ft, src), ty_str()) { ok = false } else { ok = ok }
  -- While → nil
  let int_n = node_new(1, 1, 0, 0, 0)
  if not ty_eq(synth(node_new(10, int_n, int_n, 0, 0), env, ft, src), ty_nil()) { ok = false } else { ok = ok }
  -- Assign → nil
  if not ty_eq(synth(node_new(12, 0, 0, int_n, 0), env, ft, src), ty_nil()) { ok = false } else { ok = ok }
  -- Not → bool
  if not ty_eq(synth(node_new(22, int_n, 0, 0, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

fn test_synth_binops() -> i64 {
  let env = tenv_new()
  let ft = ftypes_new()
  let src = __bump_alloc(100)
  let int_n = node_new(1, 1, 0, 0, 0)
  let mut ok = true
  -- Arithmetic ops → i64
  if not ty_eq(synth(node_new(3, 1, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 2, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 3, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 4, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 11, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  -- Comparison ops → bool
  if not ty_eq(synth(node_new(3, 5, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 6, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 7, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 8, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 9, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 10, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  -- Logical ops → bool
  if not ty_eq(synth(node_new(3, 12, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 13, int_n, int_n, 0), env, ft, src), ty_bool()) { ok = false } else { ok = ok }
  -- Bitwise ops → i64
  if not ty_eq(synth(node_new(3, 14, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 15, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 16, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 17, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(synth(node_new(3, 18, int_n, int_n, 0), env, ft, src), ty_i64()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ══════════════════════════════════════════════════════════════
-- Type environment tests
-- ══════════════════════════════════════════════════════════════

fn test_tenv() -> i64 {
  let src = __bump_alloc(100)
  -- Write "x" at offset 0 and "y" at offset 1
  __mem_store8(src, 120)
  __mem_store8(src + 1, 121)
  let mut ok = true
  -- Empty env returns 0
  let empty = tenv_new()
  if tenv_lookup(empty, src, 0, 1) != 0 { ok = false } else { ok = ok }
  -- Bind x → i64
  let env1 = tenv_bind(empty, src, 0, 1, ty_i64())
  let x_ty = tenv_lookup(env1, src, 0, 1)
  if not ty_eq(x_ty, ty_i64()) { ok = false } else { ok = ok }
  -- y not found
  if tenv_lookup(env1, src, 1, 1) != 0 { ok = false } else { ok = ok }
  -- Bind y → str, x still works
  let env2 = tenv_bind(env1, src, 1, 1, ty_str())
  if not ty_eq(tenv_lookup(env2, src, 0, 1), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(tenv_lookup(env2, src, 1, 1), ty_str()) { ok = false } else { ok = ok }
  -- Shadowing: rebind x → bool
  let env3 = tenv_bind(env2, src, 0, 1, ty_bool())
  if not ty_eq(tenv_lookup(env3, src, 0, 1), ty_bool()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ══════════════════════════════════════════════════════════════
-- Function type table tests
-- ══════════════════════════════════════════════════════════════

fn test_ftypes() -> i64 {
  let src = __bump_alloc(100)
  __mem_store8(src, 102)
  __mem_store8(src + 1, 103)
  let mut ok = true
  let ft = ftypes_new()
  -- Empty table returns 0
  if ftypes_lookup(ft, src, 0, 1) != 0 { ok = false } else { ok = ok }
  -- Add f → i64
  ftypes_add(ft, src, 0, 1, ty_i64())
  if not ty_eq(ftypes_lookup(ft, src, 0, 1), ty_i64()) { ok = false } else { ok = ok }
  -- g not found
  if ftypes_lookup(ft, src, 1, 1) != 0 { ok = false } else { ok = ok }
  -- Add g → str
  ftypes_add(ft, src, 1, 1, ty_str())
  if not ty_eq(ftypes_lookup(ft, src, 1, 1), ty_str()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ══════════════════════════════════════════════════════════════
-- Type error detection tests
-- ══════════════════════════════════════════════════════════════

fn test_check_arith() -> i64 {
  let src = __bump_alloc(100)
  let mut ok = true
  -- i64 + i64: 0 errors
  if check_arith_operand(ty_i64(), ty_i64(), src) != 0 { ok = false } else { ok = ok }
  -- str + i64: 1 error (LHS)
  if check_arith_operand(ty_str(), ty_i64(), src) != 1 { ok = false } else { ok = ok }
  -- i64 + str: 1 error (RHS)
  if check_arith_operand(ty_i64(), ty_str(), src) != 1 { ok = false } else { ok = ok }
  -- str + str: 2 errors (both)
  if check_arith_operand(ty_str(), ty_str(), src) != 2 { ok = false } else { ok = ok }
  -- bool + i64: 1 error
  if check_arith_operand(ty_bool(), ty_i64(), src) != 1 { ok = false } else { ok = ok }
  -- nil + nil: 2 errors
  if check_arith_operand(ty_nil(), ty_nil(), src) != 2 { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ══════════════════════════════════════════════════════════════
-- Let binding type propagation
-- ══════════════════════════════════════════════════════════════

fn test_synth_let() -> i64 {
  let env = tenv_new()
  let ft = ftypes_new()
  let src = __bump_alloc(100)
  __mem_store8(src, 120)
  let mut ok = true
  -- let x = 42; x → i64 (x inherits type from 42)
  let val = node_new(1, 42, 0, 0, 0)
  let body = node_new(2, 0, 1, 0, 0)
  let let_node = node_new(6, 0, 1, val, body)
  let let_ty = synth(let_node, env, ft, src)
  if not ty_eq(let_ty, ty_i64()) { ok = false } else { ok = ok }
  -- let x = "hello"; x → str
  let sval = node_new(9, 0, 5, 0, 0)
  let let_str = node_new(6, 0, 1, sval, body)
  let str_ty = synth(let_str, env, ft, src)
  if not ty_eq(str_ty, ty_str()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ══════════════════════════════════════════════════════════════
-- Main: run all test groups
-- ══════════════════════════════════════════════════════════════

fn main() -> i64 {
  let mut fails = 0
  fails = fails + test_synth_literals()
  fails = fails + test_synth_binops()
  fails = fails + test_tenv()
  fails = fails + test_ftypes()
  fails = fails + test_check_arith()
  fails = fails + test_synth_let()
  if fails == 0 { 0 } else { fails }
}
