use "../compiler/lib.weft"
use "../compiler/types.weft"
use "../compiler/typeck.weft"

-- Test the type checker's synth function directly
-- by building AST nodes and checking their inferred types

fn main() -> i64 {
  let env = tenv_new()
  let ft = ftypes_new()
  let src = __bump_alloc(100)
  let mut ok = true

  -- IntLit → i64
  let int_node = node_new(1, 42, 0, 0, 0)
  let int_ty = synth(int_node, env, ft, src)
  if not ty_eq(int_ty, ty_i64()) { ok = false } else { ok = ok }

  -- StringLit → str
  let str_node = node_new(9, 0, 5, 0, 0)
  let str_ty = synth(str_node, env, ft, src)
  if not ty_eq(str_ty, ty_str()) { ok = false } else { ok = ok }

  -- BinOp + → i64
  let add_node = node_new(3, 1, int_node, int_node, 0)
  let add_ty = synth(add_node, env, ft, src)
  if not ty_eq(add_ty, ty_i64()) { ok = false } else { ok = ok }

  -- BinOp == → bool
  let eq_node = node_new(3, 5, int_node, int_node, 0)
  let eq_ty = synth(eq_node, env, ft, src)
  if not ty_eq(eq_ty, ty_bool()) { ok = false } else { ok = ok }

  -- BinOp and → bool
  let and_node = node_new(3, 12, int_node, int_node, 0)
  let and_ty = synth(and_node, env, ft, src)
  if not ty_eq(and_ty, ty_bool()) { ok = false } else { ok = ok }

  -- BinOp % → i64
  let mod_node = node_new(3, 11, int_node, int_node, 0)
  let mod_ty = synth(mod_node, env, ft, src)
  if not ty_eq(mod_ty, ty_i64()) { ok = false } else { ok = ok }

  -- Not → bool
  let not_node = node_new(22, int_node, 0, 0, 0)
  let not_ty = synth(not_node, env, ft, src)
  if not ty_eq(not_ty, ty_bool()) { ok = false } else { ok = ok }

  -- While → nil
  let while_node = node_new(10, int_node, int_node, 0, 0)
  let while_ty = synth(while_node, env, ft, src)
  if not ty_eq(while_ty, ty_nil()) { ok = false } else { ok = ok }

  -- Assign → nil
  let assign_node = node_new(12, 0, 0, int_node, 0)
  let assign_ty = synth(assign_node, env, ft, src)
  if not ty_eq(assign_ty, ty_nil()) { ok = false } else { ok = ok }

  -- Subtype checks used by type checker
  if not is_subtype(ty_i64(), ty_i64()) { ok = false } else { ok = ok }
  if is_subtype(ty_str(), ty_i64()) { ok = false } else { ok = ok }

  if ok { 0 } else { 1 }
}
