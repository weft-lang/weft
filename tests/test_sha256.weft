use "../compiler/lib.weft"
use "../compiler/sha256.weft"

-- SHA-256 test vectors from NIST

fn test_empty() -> i64 {
  -- SHA-256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
  let out = __bump_alloc(32)
  let data = __bump_alloc(1)
  sha256(data, 0, out)
  let mut ok = true
  -- Check first 4 bytes: e3b0c442
  if __mem_load8(out) != 227 { ok = false } else { ok = ok }
  if __mem_load8(out + 1) != 176 { ok = false } else { ok = ok }
  if __mem_load8(out + 2) != 196 { ok = false } else { ok = ok }
  if __mem_load8(out + 3) != 66 { ok = false } else { ok = ok }
  -- Check last 4 bytes: 7852b855
  if __mem_load8(out + 28) != 120 { ok = false } else { ok = ok }
  if __mem_load8(out + 29) != 82 { ok = false } else { ok = ok }
  if __mem_load8(out + 30) != 184 { ok = false } else { ok = ok }
  if __mem_load8(out + 31) != 85 { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

fn test_abc() -> i64 {
  -- SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
  let data = __bump_alloc(4)
  __mem_store8(data, 97) __mem_store8(data + 1, 98) __mem_store8(data + 2, 99)
  let out = __bump_alloc(32)
  sha256(data, 3, out)
  let mut ok = true
  -- Check first 4 bytes: ba7816bf
  if __mem_load8(out) != 186 { ok = false } else { ok = ok }
  if __mem_load8(out + 1) != 120 { ok = false } else { ok = ok }
  if __mem_load8(out + 2) != 22 { ok = false } else { ok = ok }
  if __mem_load8(out + 3) != 191 { ok = false } else { ok = ok }
  -- Check bytes 4-7: 8f01cfea
  if __mem_load8(out + 4) != 143 { ok = false } else { ok = ok }
  if __mem_load8(out + 5) != 1 { ok = false } else { ok = ok }
  if __mem_load8(out + 6) != 207 { ok = false } else { ok = ok }
  if __mem_load8(out + 7) != 234 { ok = false } else { ok = ok }
  -- Check last 4 bytes: f20015ad
  if __mem_load8(out + 28) != 242 { ok = false } else { ok = ok }
  if __mem_load8(out + 29) != 0 { ok = false } else { ok = ok }
  if __mem_load8(out + 30) != 21 { ok = false } else { ok = ok }
  if __mem_load8(out + 31) != 173 { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

fn test_long() -> i64 {
  -- SHA-256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  -- = 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
  let msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  let data = __str_ptr(msg)
  let len = __str_len(msg)
  let out = __bump_alloc(32)
  sha256(data, len, out)
  let mut ok = true
  -- Check first 4 bytes: 248d6a61
  if __mem_load8(out) != 36 { ok = false } else { ok = ok }
  if __mem_load8(out + 1) != 141 { ok = false } else { ok = ok }
  if __mem_load8(out + 2) != 106 { ok = false } else { ok = ok }
  if __mem_load8(out + 3) != 97 { ok = false } else { ok = ok }
  -- Check last 4 bytes: 19db06c1
  if __mem_load8(out + 28) != 25 { ok = false } else { ok = ok }
  if __mem_load8(out + 29) != 219 { ok = false } else { ok = ok }
  if __mem_load8(out + 30) != 6 { ok = false } else { ok = ok }
  if __mem_load8(out + 31) != 193 { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

fn test_single_byte() -> i64 {
  -- SHA-256("a") first 4 bytes = ca978112
  let data = __bump_alloc(1)
  __mem_store8(data, 97)
  let out = __bump_alloc(32)
  sha256(data, 1, out)
  let mut ok = true
  if __mem_load8(out) != 202 { ok = false } else { ok = ok }
  if __mem_load8(out + 1) != 151 { ok = false } else { ok = ok }
  if __mem_load8(out + 2) != 129 { ok = false } else { ok = ok }
  if __mem_load8(out + 3) != 18 { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

fn test_55_bytes() -> i64 {
  -- 55 bytes = just under single block padding boundary
  let data = __bump_alloc(55)
  let mut i = 0
  while i < 55 { __mem_store8(data + i, 97) i = i + 1 }
  let out = __bump_alloc(32)
  sha256(data, 55, out)
  -- Just verify it doesn't crash and produces non-zero hash
  if __mem_load8(out) == 0 { if __mem_load8(out + 1) == 0 { 1 } else { 0 } } else { 0 }
}

fn test_56_bytes() -> i64 {
  -- 56 bytes = exact padding boundary (needs 2 blocks)
  let data = __bump_alloc(56)
  let mut i = 0
  while i < 56 { __mem_store8(data + i, 97) i = i + 1 }
  let out = __bump_alloc(32)
  sha256(data, 56, out)
  if __mem_load8(out) == 0 { if __mem_load8(out + 1) == 0 { 1 } else { 0 } } else { 0 }
}

fn test_64_bytes() -> i64 {
  -- 64 bytes = exact block size
  let data = __bump_alloc(64)
  let mut i = 0
  while i < 64 { __mem_store8(data + i, 97) i = i + 1 }
  let out = __bump_alloc(32)
  sha256(data, 64, out)
  if __mem_load8(out) == 0 { if __mem_load8(out + 1) == 0 { 1 } else { 0 } } else { 0 }
}

fn test_property_deterministic() -> i64 {
  -- Same input produces same hash
  let data = __bump_alloc(3)
  __mem_store8(data, 97) __mem_store8(data + 1, 98) __mem_store8(data + 2, 99)
  let out1 = __bump_alloc(32)
  let out2 = __bump_alloc(32)
  sha256(data, 3, out1)
  sha256(data, 3, out2)
  let mut ok = true
  let mut i = 0
  while i < 32 {
    if __mem_load8(out1 + i) != __mem_load8(out2 + i) { ok = false } else { ok = ok }
    i = i + 1
  }
  if ok { 0 } else { 1 }
}

fn test_property_different() -> i64 {
  -- Different inputs produce different hashes
  let d1 = __bump_alloc(1)
  let d2 = __bump_alloc(1)
  __mem_store8(d1, 97) __mem_store8(d2, 98)
  let o1 = __bump_alloc(32)
  let o2 = __bump_alloc(32)
  sha256(d1, 1, o1)
  sha256(d2, 1, o2)
  -- At least one byte should differ
  let mut same = true
  let mut i = 0
  while i < 32 {
    if __mem_load8(o1 + i) != __mem_load8(o2 + i) { same = false } else { same = same }
    i = i + 1
  }
  if same { 1 } else { 0 }
}

fn main() -> i64 {
  let mut fails = 0
  fails = fails + test_empty()
  fails = fails + test_abc()
  fails = fails + test_long()
  fails = fails + test_single_byte()
  fails = fails + test_55_bytes()
  fails = fails + test_56_bytes()
  fails = fails + test_64_bytes()
  fails = fails + test_property_deterministic()
  fails = fails + test_property_different()
  if fails == 0 { 0 } else { fails }
}
