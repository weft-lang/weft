use "../compiler/lib.weft"
use "../compiler/types.weft"

fn main() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let b = ty_bool()
  let n = ty_nil()
  let nev = ty_never()
  let any = ty_any()

  let mut ok = true
  -- Basics
  if not ty_is_empty(nev) { ok = false } else { ok = ok }
  if ty_is_empty(i) { ok = false } else { ok = ok }
  if not is_subtype(i, i) { ok = false } else { ok = ok }
  if not is_subtype(nev, i) { ok = false } else { ok = ok }
  if not is_subtype(i, any) { ok = false } else { ok = ok }
  if is_subtype(i, s) { ok = false } else { ok = ok }

  -- Union subtyping
  let i_or_s = ty_union(i, s)
  if not is_subtype(i, i_or_s) { ok = false } else { ok = ok }
  if not is_subtype(s, i_or_s) { ok = false } else { ok = ok }
  if is_subtype(b, i_or_s) { ok = false } else { ok = ok }

  -- Intersection emptiness
  if not ty_is_empty(ty_inter(i, s)) { ok = false } else { ok = ok }

  -- Complement
  if ty_is_empty(ty_compl(i)) { ok = false } else { ok = ok }

  -- T & ~T = empty
  if not ty_is_empty(ty_inter(i, ty_compl(i))) { ok = false } else { ok = ok }

  -- Nullable
  let nullable_i = ty_nullable(i)
  if not is_subtype(i, nullable_i) { ok = false } else { ok = ok }
  if not is_subtype(n, nullable_i) { ok = false } else { ok = ok }
  if is_subtype(s, nullable_i) { ok = false } else { ok = ok }

  -- Union subtyping: i64|str <: i64|str|bool
  let i_s_b = ty_union(i_or_s, b)
  if not is_subtype(i_or_s, i_s_b) { ok = false } else { ok = ok }

  if ok { 42 } else { 0 }
}
