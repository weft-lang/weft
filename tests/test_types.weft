use "../compiler/lib.weft"
use "../compiler/types.weft"

-- Each test function returns 0 on success, 1 on failure

-- ═══════════════════════════════════════════════════════════════
-- 1. Emptiness: what is and isn't the empty set
-- ═══════════════════════════════════════════════════════════════
fn test_emptiness() -> i64 {
  let mut ok = true
  -- never is empty
  if not ty_is_empty(ty_never()) { ok = false } else { ok = ok }
  -- primitives are not empty
  if ty_is_empty(ty_i64()) { ok = false } else { ok = ok }
  if ty_is_empty(ty_str()) { ok = false } else { ok = ok }
  if ty_is_empty(ty_bool()) { ok = false } else { ok = ok }
  if ty_is_empty(ty_nil()) { ok = false } else { ok = ok }
  -- any is not empty
  if ty_is_empty(ty_any()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 2. Primitive disjointness: all pairs of different prims are empty
-- ═══════════════════════════════════════════════════════════════
fn test_prim_disjoint() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let b = ty_bool()
  let n = ty_nil()
  let mut ok = true
  -- All 6 pairs of 4 primitives
  if not ty_is_empty(ty_inter(i, s)) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(i, b)) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(i, n)) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(s, b)) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(s, n)) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(b, n)) { ok = false } else { ok = ok }
  -- Self-intersection is NOT empty
  if ty_is_empty(ty_inter(i, i)) { ok = false } else { ok = ok }
  if ty_is_empty(ty_inter(s, s)) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 3. Subtype reflexivity and basic relationships
-- ═══════════════════════════════════════════════════════════════
fn test_subtype_basic() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let b = ty_bool()
  let n = ty_nil()
  let mut ok = true
  -- Reflexivity: T <: T
  if not is_subtype(i, i) { ok = false } else { ok = ok }
  if not is_subtype(s, s) { ok = false } else { ok = ok }
  if not is_subtype(b, b) { ok = false } else { ok = ok }
  if not is_subtype(n, n) { ok = false } else { ok = ok }
  -- never <: T for all T
  if not is_subtype(ty_never(), i) { ok = false } else { ok = ok }
  if not is_subtype(ty_never(), s) { ok = false } else { ok = ok }
  if not is_subtype(ty_never(), b) { ok = false } else { ok = ok }
  if not is_subtype(ty_never(), n) { ok = false } else { ok = ok }
  if not is_subtype(ty_never(), ty_any()) { ok = false } else { ok = ok }
  -- T <: any for all T
  if not is_subtype(i, ty_any()) { ok = false } else { ok = ok }
  if not is_subtype(s, ty_any()) { ok = false } else { ok = ok }
  if not is_subtype(b, ty_any()) { ok = false } else { ok = ok }
  if not is_subtype(n, ty_any()) { ok = false } else { ok = ok }
  -- Different prims NOT subtypes of each other
  if is_subtype(i, s) { ok = false } else { ok = ok }
  if is_subtype(s, i) { ok = false } else { ok = ok }
  if is_subtype(i, b) { ok = false } else { ok = ok }
  if is_subtype(b, i) { ok = false } else { ok = ok }
  if is_subtype(s, n) { ok = false } else { ok = ok }
  if is_subtype(n, s) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 4. Union subtyping
-- ═══════════════════════════════════════════════════════════════
fn test_union_subtype() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let b = ty_bool()
  let n = ty_nil()
  let mut ok = true
  -- T <: T | U
  let i_or_s = ty_union(i, s)
  if not is_subtype(i, i_or_s) { ok = false } else { ok = ok }
  if not is_subtype(s, i_or_s) { ok = false } else { ok = ok }
  -- Other prims NOT subtype of T | U
  if is_subtype(b, i_or_s) { ok = false } else { ok = ok }
  if is_subtype(n, i_or_s) { ok = false } else { ok = ok }
  -- T|U <: T|U|V (widening)
  let i_s_b = ty_union(i_or_s, b)
  if not is_subtype(i_or_s, i_s_b) { ok = false } else { ok = ok }
  if not is_subtype(i, i_s_b) { ok = false } else { ok = ok }
  if not is_subtype(b, i_s_b) { ok = false } else { ok = ok }
  -- T|U is NOT subtype of T alone
  if is_subtype(i_or_s, i) { ok = false } else { ok = ok }
  if is_subtype(i_or_s, s) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 5. Complement and self-contradiction
-- ═══════════════════════════════════════════════════════════════
fn test_complement() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let mut ok = true
  -- ~T is not empty (other types inhabit it)
  if ty_is_empty(ty_compl(i)) { ok = false } else { ok = ok }
  if ty_is_empty(ty_compl(s)) { ok = false } else { ok = ok }
  -- ~never = any (not empty)
  if ty_is_empty(ty_compl(ty_never())) { ok = false } else { ok = ok }
  -- T & ~T = empty (self-contradiction) for all primitives
  if not ty_is_empty(ty_inter(i, ty_compl(i))) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(s, ty_compl(s))) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(ty_bool(), ty_compl(ty_bool()))) { ok = false } else { ok = ok }
  if not ty_is_empty(ty_inter(ty_nil(), ty_compl(ty_nil()))) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 6. Nullable (T? = T | nil)
-- ═══════════════════════════════════════════════════════════════
fn test_nullable() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let n = ty_nil()
  let mut ok = true
  -- T <: T?
  if not is_subtype(i, ty_nullable(i)) { ok = false } else { ok = ok }
  if not is_subtype(s, ty_nullable(s)) { ok = false } else { ok = ok }
  -- nil <: T?
  if not is_subtype(n, ty_nullable(i)) { ok = false } else { ok = ok }
  if not is_subtype(n, ty_nullable(s)) { ok = false } else { ok = ok }
  -- Other types NOT subtype of T?
  if is_subtype(s, ty_nullable(i)) { ok = false } else { ok = ok }
  if is_subtype(i, ty_nullable(s)) { ok = false } else { ok = ok }
  -- T? is NOT subtype of T (because nil isn't T)
  if is_subtype(ty_nullable(i), i) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 7. Identity laws: T|never=T, T&any=T, T|any=any, T&never=never
-- ═══════════════════════════════════════════════════════════════
fn test_identities() -> i64 {
  let i = ty_i64()
  let nev = ty_never()
  let any = ty_any()
  let mut ok = true
  -- T | never <: T and T <: T | never (equivalent)
  let i_or_nev = ty_union(i, nev)
  if not is_subtype(i_or_nev, i) { ok = false } else { ok = ok }
  if not is_subtype(i, i_or_nev) { ok = false } else { ok = ok }
  -- T & any: T <: T&any and T&any <: T (equivalent)
  let i_and_any = ty_inter(i, any)
  if not is_subtype(i, i_and_any) { ok = false } else { ok = ok }
  if not is_subtype(i_and_any, i) { ok = false } else { ok = ok }
  -- T & never = never (empty)
  if not ty_is_empty(ty_inter(i, nev)) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 8. Type equality
-- ═══════════════════════════════════════════════════════════════
fn test_type_equality() -> i64 {
  let mut ok = true
  -- Same types are equal
  if not ty_eq(ty_i64(), ty_i64()) { ok = false } else { ok = ok }
  if not ty_eq(ty_str(), ty_str()) { ok = false } else { ok = ok }
  if not ty_eq(ty_never(), ty_never()) { ok = false } else { ok = ok }
  if not ty_eq(ty_any(), ty_any()) { ok = false } else { ok = ok }
  -- Different types are not equal
  if ty_eq(ty_i64(), ty_str()) { ok = false } else { ok = ok }
  if ty_eq(ty_never(), ty_any()) { ok = false } else { ok = ok }
  if ty_eq(ty_i64(), ty_never()) { ok = false } else { ok = ok }
  -- Compound types
  if not ty_eq(ty_union(ty_i64(), ty_str()), ty_union(ty_i64(), ty_str())) { ok = false } else { ok = ok }
  if ty_eq(ty_union(ty_i64(), ty_str()), ty_union(ty_str(), ty_i64())) { ok = false } else { ok = ok }
  -- Complement equality
  if not ty_eq(ty_compl(ty_i64()), ty_compl(ty_i64())) { ok = false } else { ok = ok }
  if ty_eq(ty_compl(ty_i64()), ty_compl(ty_str())) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 9. Nested types: union of unions, complement of complement
-- ═══════════════════════════════════════════════════════════════
fn test_nested() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let b = ty_bool()
  let n = ty_nil()
  let mut ok = true
  -- (i64|str) | (bool|nil) should contain all four
  let left = ty_union(i, s)
  let right = ty_union(b, n)
  let all4 = ty_union(left, right)
  if not is_subtype(i, all4) { ok = false } else { ok = ok }
  if not is_subtype(s, all4) { ok = false } else { ok = ok }
  if not is_subtype(b, all4) { ok = false } else { ok = ok }
  if not is_subtype(n, all4) { ok = false } else { ok = ok }
  -- Intersection of unions: (i64|str) & (i64|bool) should contain i64
  let l = ty_union(i, s)
  let r = ty_union(i, b)
  let isect = ty_inter(l, r)
  if not is_subtype(i, isect) { ok = false } else { ok = ok }
  -- str should NOT be subtype of (i64|str) & (i64|bool)
  if is_subtype(s, isect) { ok = false } else { ok = ok }
  -- bool should NOT be subtype either
  if is_subtype(b, isect) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 10. Property: subtype transitivity (A<:B and B<:C implies A<:C)
-- ═══════════════════════════════════════════════════════════════
fn test_transitivity() -> i64 {
  let i = ty_i64()
  let i_or_s = ty_union(i, ty_str())
  let i_s_b = ty_union(i_or_s, ty_bool())
  let mut ok = true
  -- i64 <: i64|str <: i64|str|bool → i64 <: i64|str|bool
  if not is_subtype(i, i_or_s) { ok = false } else { ok = ok }
  if not is_subtype(i_or_s, i_s_b) { ok = false } else { ok = ok }
  if not is_subtype(i, i_s_b) { ok = false } else { ok = ok }
  -- never <: i64 <: any → never <: any
  if not is_subtype(ty_never(), i) { ok = false } else { ok = ok }
  if not is_subtype(i, ty_any()) { ok = false } else { ok = ok }
  if not is_subtype(ty_never(), ty_any()) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 11. Property: union commutativity for subtyping
--     A|B and B|A should have the same subtypes and supertypes
-- ═══════════════════════════════════════════════════════════════
fn test_union_commutative() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let ab = ty_union(i, s)
  let ba = ty_union(s, i)
  let mut ok = true
  -- Both directions of subtyping should hold (equivalent types)
  if not is_subtype(ab, ba) { ok = false } else { ok = ok }
  if not is_subtype(ba, ab) { ok = false } else { ok = ok }
  -- Same members
  if not is_subtype(i, ab) { ok = false } else { ok = ok }
  if not is_subtype(i, ba) { ok = false } else { ok = ok }
  if not is_subtype(s, ab) { ok = false } else { ok = ok }
  if not is_subtype(s, ba) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- 12. De Morgan: ~(A|B) equivalent to ~A & ~B
-- ═══════════════════════════════════════════════════════════════
fn test_de_morgan() -> i64 {
  let i = ty_i64()
  let s = ty_str()
  let mut ok = true
  -- ~(i64|str) should be equivalent to ~i64 & ~str
  let not_union = ty_compl(ty_union(i, s))
  let inter_nots = ty_inter(ty_compl(i), ty_compl(s))
  -- Both directions: they should be mutual subtypes
  if not is_subtype(not_union, inter_nots) { ok = false } else { ok = ok }
  if not is_subtype(inter_nots, not_union) { ok = false } else { ok = ok }
  -- Neither i64 nor str should be in ~(i64|str)
  if is_subtype(i, not_union) { ok = false } else { ok = ok }
  if is_subtype(s, not_union) { ok = false } else { ok = ok }
  -- bool SHOULD be in ~(i64|str) (it's neither i64 nor str)
  if not is_subtype(ty_bool(), not_union) { ok = false } else { ok = ok }
  if ok { 0 } else { 1 }
}

-- ═══════════════════════════════════════════════════════════════
-- Main: run all tests, report individual results
-- ═══════════════════════════════════════════════════════════════
fn main() -> i64 {
  let mut fails = 0
  fails = fails + test_emptiness()
  fails = fails + test_prim_disjoint()
  fails = fails + test_subtype_basic()
  fails = fails + test_union_subtype()
  fails = fails + test_complement()
  fails = fails + test_nullable()
  fails = fails + test_identities()
  fails = fails + test_type_equality()
  fails = fails + test_nested()
  fails = fails + test_transitivity()
  fails = fails + test_union_commutative()
  fails = fails + test_de_morgan()
  if fails == 0 { 42 } else { fails }
}
