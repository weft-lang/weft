use stdlib/console as console
use stdlib/console/terminal as terminal

effect Audience {
  fn name() -> str
}

fn welcome() -[Audience]> str {
  "Hello, ".concat(Audience.name()).concat("!")
}

fn main() -> nil {
  with terminal() {
    handle console.println(welcome()) {
      Audience.name() -> resume("world")
    }
  }
}
