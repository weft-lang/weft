use runtime/console_write as terminal
use stdlib/console.{ConsoleWrite, println}
use stdlib/iter as iter
use stdlib/option.{*}
use stdlib/result.{Err, Ok}

default handler terminal()

fn double(value: i64) -> i64 { value * 2 }
fn divisible_by_three(value: i64) -> bool { value % 3 == 0 }
fn at_least_ten(value: i64) -> bool { value >= 10 }
fn add(total: i64, value: i64) -> i64 { total + value }

fn print_transition(window: borrow [i64]) -[ConsoleWrite]> nil {
  println("{window[0]} -> {window[1]}")
}

fn main() -> nil {
  let total = iter.range(1, 20)
    |> iter.map(double)
    |> iter.filter(divisible_by_three)
    |> iter.take(4)
    |> iter.fold(0, add)

  let first_double_digit = iter.find(iter.range(1, 20), at_least_ten)
  let (double_digits, single_digits) = iter.partition(
    iter.range(1, 13),
    at_least_ten
  )
  let double_digit_total = iter.fold(double_digits, 0, add)
  let single_digit_total = iter.fold(single_digits, 0, add)

  println("sum: {total}")
  println("double-digit sum: {double_digit_total}")
  println("single-digit sum: {single_digit_total}")
  match first_double_digit {
    Some(value) -> println("first double digit: {value}")
    None -> println("no double digit found")
  }
  match iter.each_window(iter.range(8, 12), 2, print_transition) {
    Ok(_) -> nil
    Err(_) -> println("invalid transition width")
  }
}
