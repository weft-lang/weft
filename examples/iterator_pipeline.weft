use runtime/console_write as terminal
use stdlib/console.{println}
use stdlib/iter.{iter_filter, iter_fold, iter_map, iter_range, iter_take}

default handler terminal()

fn double(value: i64) -> i64 { value * 2 }
fn divisible_by_three(value: i64) -> i64 { if value % 3 == 0 { 1 } else { 0 } }
fn add(total: i64, value: i64) -> i64 { total + value }

fn main() -> nil {
  let total = iter_range(1, 20)
    |> iter_map<i64, i64>(double)
    |> iter_filter<i64>(divisible_by_three)
    |> iter_take<i64>(4)
    |> iter_fold<i64, i64>(0, add)

  println("sum: {total}")
}
