use runtime/console_write as terminal
use stdlib/console.{println}
use stdlib/iter as iter

default handler terminal()

fn double(value: i64) -> i64 { value * 2 }
fn divisible_by_three(value: i64) -> bool { value % 3 == 0 }
fn add(total: i64, value: i64) -> i64 { total + value }

fn main() -> nil {
  let total = iter.range(1, 20)
    |> iter.map<i64, i64>(double)
    |> iter.filter<i64>(divisible_by_three)
    |> iter.take<i64>(4)
    |> iter.fold<i64, i64>(0, add)

  println("sum: {total}")
}
