-- CHAMP map benchmark: insert N keys, look up all, count
-- Benchmark: persistent data structure performance, hashing, allocation
use "stdlib/map.weft"
use "stdlib/display.weft"

fn bench_map(n: i64) -> i64 {
  -- Insert n key-value pairs
  let mut m = map_new()
  for i in 0..n {
    m = map_put(m, i, i * i)
  }
  -- Verify all keys present
  let mut found: i64 = 0
  for i in 0..n {
    if map_contains(m, i) == 1 { found = found + 1 } else { 0 }
  }
  -- Verify values correct
  let mut correct: i64 = 0
  for i in 0..n {
    if map_get(m, i, 0 - 1) == i * i { correct = correct + 1 } else { 0 }
  }
  let ns = int_to_str(n)
  println("map benchmark (n={ns})")
  println(str_concat("  inserted: ", int_to_str(n)))
  println(str_concat("  found:    ", int_to_str(found)))
  println(str_concat("  correct:  ", int_to_str(correct)))
  let size = map_size(m)
  println(str_concat("  size:     ", int_to_str(size)))
  size
}

fn main() -> i64 {
  bench_map(1000)
  0
}
