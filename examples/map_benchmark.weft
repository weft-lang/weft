-- CHAMP map benchmark: insert N keys, look up all, count
-- Benchmark: persistent data structure performance, hashing, allocation
use stdlib/map as map
use stdlib/map.{*}
use stdlib/option.{Option}

fn bench_map(n: i64) -> i64 {
  -- Insert n key-value pairs
  let mut m = map.new<i64, i64>()
  for i in 0..n {
    m = m.insert(i, i * i)
  }
  -- Verify all keys present
  let mut found: i64 = 0
  for i in 0..n {
    if m.contains_key(i) { found = found + 1 } else { 0 }
  }
  -- Verify values correct
  let mut correct: i64 = 0
  for i in 0..n {
    if m.get(i).unwrap_or(0 - 1) == i * i { correct = correct + 1 } else { 0 }
  }
  let size = m.len()
  if found == n and correct == n and size == n { 0 } else { 1 }
}

fn main() -> i64 {
  bench_map(1000)
}
