-- Sorted collections workload: deterministic map iteration plus set algebra.
-- Benchmark: vector-backed ordered collections and comparator-heavy lookups.

use stdlib/sorted_map as sorted_map
use stdlib/sorted_set as sorted_set
use stdlib/option.{Option}
use stdlib/string
use stdlib/vector

fn main() -> i64 {
  let counts = sorted_map.new<str, i64>()
  counts.insert("gamma", 3)
  counts.insert("alpha", 1)
  counts.insert("beta", 2)
  counts.insert("beta", 20)
  let keys = counts.keys()

  let left = sorted_set.new<i64>()
  let right = sorted_set.new<i64>()
  left.insert(5)
  left.insert(1)
  left.insert(3)
  right.insert(3)
  right.insert(4)
  right.insert(5)

  let unioned = left.union(right)
  let both = left.intersection(right)
  let both_values = both.values()

  if counts.len() == 3 and
    keys.get(0).expect("first sorted key exists") == "alpha" and
    keys.get(1).unwrap() == "beta" and
    keys.get(2).unwrap() == "gamma" and
    counts.get("absent").is_none() and
    counts.get("beta").expect("beta was inserted") == 20 and
    unioned.len() == 4 and
    both.len() == 2 and
    both_values.get(0).expect("first common value exists") == 3 and
    both_values.get(1).unwrap() == 5 {
    0
  } else {
    1
  }
}
