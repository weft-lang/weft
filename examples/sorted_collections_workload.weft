-- Sorted collections workload: deterministic map iteration plus set algebra.
-- Benchmark: vector-backed ordered collections and comparator-heavy lookups.

use stdlib/sorted_map.{*}
use stdlib/sorted_set.{*}
use stdlib/option.{*}
use stdlib/string.{*}
use stdlib/vector.{*}

fn main() -> i64 {
  let counts = sorted_map_new<str, i64>()
  counts.insert("gamma", 3)
  counts.insert("alpha", 1)
  counts.insert("beta", 2)
  counts.insert("beta", 20)
  let keys = counts.keys()

  let left = sorted_set_new<i64>()
  let right = sorted_set_new<i64>()
  left.insert(5)
  left.insert(1)
  left.insert(3)
  right.insert(3)
  right.insert(4)
  right.insert(5)

  let unioned = left.union(right)
  let both = left.intersection(right)

  if counts.len() == 3 and
     str_eq(vector_get<str>(keys, 0, ""), "alpha") == 1 and
     counts.get("beta").unwrap_or(0) == 20 and
     unioned.len() == 4 and
     both.len() == 2 and
     vector_get<i64>(both.values(), 0, 0) == 3 {
    0
  } else {
    1
  }
}
