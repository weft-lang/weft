-- Sorted collections workload: deterministic map iteration plus set algebra.
-- Benchmark: vector-backed ordered collections and comparator-heavy lookups.

use "stdlib/sorted_map.weft"
use "stdlib/sorted_set.weft"
use "stdlib/string.weft"
use "stdlib/vector.weft"

fn main() -> i64 {
  let counts = sorted_map_new<str, i64>()
  sorted_map_put<str, i64>(counts, "gamma", 3, sorted_cmp_str)
  sorted_map_put<str, i64>(counts, "alpha", 1, sorted_cmp_str)
  sorted_map_put<str, i64>(counts, "beta", 2, sorted_cmp_str)
  sorted_map_put<str, i64>(counts, "beta", 20, sorted_cmp_str)
  let keys = sorted_map_keys<str, i64>(counts)

  let left = sorted_set_new<i64>()
  let right = sorted_set_new<i64>()
  sorted_set_insert<i64>(left, 5, sorted_cmp_i64)
  sorted_set_insert<i64>(left, 1, sorted_cmp_i64)
  sorted_set_insert<i64>(left, 3, sorted_cmp_i64)
  sorted_set_insert<i64>(right, 3, sorted_cmp_i64)
  sorted_set_insert<i64>(right, 4, sorted_cmp_i64)
  sorted_set_insert<i64>(right, 5, sorted_cmp_i64)

  let unioned = sorted_set_union<i64>(left, right, sorted_cmp_i64)
  let both = sorted_set_intersection<i64>(left, right, sorted_cmp_i64)

  if sorted_map_len(counts) == 3 and
     str_eq(vector_get<str>(keys, 0, ""), "alpha") == 1 and
     sorted_map_get<str, i64>(counts, "beta", 0, sorted_cmp_str) == 20 and
     sorted_set_len(unioned) == 4 and
     sorted_set_len(both) == 2 and
     vector_get<i64>(sorted_set_values<i64>(both), 0, 0) == 3 {
    0
  } else {
    1
  }
}
