-- Graph workload: adjacency matrix plus vector-queue reachability.
-- Benchmark: vector-backed graph basics, nested scans, queue growth.
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn graph_new(nodes: usize) -> owned Vector<i64> {
  let capacity = nodes.checked_mul(nodes).expect("graph dimensions fit storage")
  let mut graph = vector.with_capacity<i64>(capacity)
  let zero: usize = 0
  for i in zero..capacity {
    graph.push(0)
  }
  graph
}

fn graph_index(nodes: usize, from: usize, to: usize) -> usize {
  let row = from.checked_mul(nodes).expect("graph row fits storage")
  row.checked_add(to).expect("graph index fits storage")
}

fn graph_add_edge(graph: borrow mut Vector<i64>, nodes: usize, from: usize, to: usize) -> nil {
  graph.set(graph_index(nodes, from, to), 1).expect("graph edge is in bounds")
  nil
}

fn graph_has_edge(graph: borrow Vector<i64>, nodes: usize, from: usize, to: usize) -> i64 {
  graph.get(graph_index(nodes, from, to)).unwrap_or(0)
}

fn graph_out_degree(graph: borrow Vector<i64>, nodes: usize, from: usize) -> i64 {
  let mut total = 0
  let zero: usize = 0
  for to in zero..nodes {
    total = total + graph_has_edge(graph, nodes, from, to)
  }
  total
}

fn graph_reachable_marks(graph: borrow Vector<i64>, nodes: usize, start: usize) -> owned Vector<i64> {
  let mut seen = vector.with_capacity<i64>(nodes)
  let zero: usize = 0
  for i in zero..nodes {
    seen.push(0)
  }

  let mut queue = vector.with_capacity<usize>(nodes)
  seen.set(start, 1).expect("start node is in bounds")
  queue.push(start)

  let mut head: usize = 0
  while head < queue.len() {
    let node = queue.get(head).expect("queued index is in bounds")
    head = head + 1
    for next in zero..nodes {
      if graph_has_edge(graph, nodes, node, next) == 1 and seen.get(next).unwrap_or(0) == 0 {
        seen.set(next, 1).expect("reachable node is in bounds")
        queue.push(next)
      } else { 0 }
    }
  }
  seen
}

fn graph_reachable_count(graph: borrow Vector<i64>, nodes: usize, start: usize) -> i64 {
  let seen = graph_reachable_marks(graph, nodes, start)
  seen.fold<i64>(0, (acc: i64, mark: i64) => acc + mark)
}

fn main() -> i64 {
  let nodes: usize = 6
  let mut graph = graph_new(nodes)
  graph_add_edge(graph, nodes, 0, 1)
  graph_add_edge(graph, nodes, 0, 2)
  graph_add_edge(graph, nodes, 1, 3)
  graph_add_edge(graph, nodes, 2, 3)
  graph_add_edge(graph, nodes, 3, 4)

  let mut ok = 1
  if graph_has_edge(graph, nodes, 0, 1) != 1 { ok = 0 } else { 0 }
  if graph_has_edge(graph, nodes, 4, 0) != 0 { ok = 0 } else { 0 }
  if graph_out_degree(graph, nodes, 0) != 2 { ok = 0 } else { 0 }
  if graph_reachable_count(graph, nodes, 0) != 5 { ok = 0 } else { 0 }
  if graph_reachable_count(graph, nodes, 5) != 1 { ok = 0 } else { 0 }

  if ok == 1 { 0 } else { 1 }
}
