-- Graph workload: adjacency matrix plus vector-queue reachability.
-- Benchmark: vector-backed graph basics, nested scans, queue growth.

use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn graph_new(nodes: usize) -> owned Vector<bool> {
  let capacity = nodes.checked_mul(nodes).expect("graph dimensions fit storage")
  let mut graph = vector.with_capacity<bool>(capacity)
  let zero: usize = 0
  for i in zero..capacity {
    graph.push(false)
  }
  graph
}

fn graph_index(nodes: usize, from: usize, to: usize) -> usize {
  let row = from.checked_mul(nodes).expect("graph row fits storage")
  row.checked_add(to).expect("graph index fits storage")
}

fn graph_add_edge(graph: borrow mut Vector<bool>, nodes: usize, from: usize, to: usize) -> nil {
  graph.set(graph_index(nodes, from, to), true).expect("graph edge is in bounds")
  nil
}

fn graph_has_edge(graph: borrow Vector<bool>, nodes: usize, from: usize, to: usize) -> bool {
  graph.get(graph_index(nodes, from, to)).expect("graph coordinates are in bounds")
}

fn graph_out_degree(graph: borrow Vector<bool>, nodes: usize, from: usize) -> usize {
  let mut total: usize = 0
  let zero: usize = 0
  for to in zero..nodes {
    if graph_has_edge(graph, nodes, from, to) { total = total + 1 }
  }
  total
}

fn graph_reachable_marks(graph: borrow Vector<bool>, nodes: usize, start: usize) -> owned Vector<bool> {
  let mut seen = vector.with_capacity<bool>(nodes)
  let zero: usize = 0
  for i in zero..nodes {
    seen.push(false)
  }

  let mut queue = vector.with_capacity<usize>(nodes)
  seen.set(start, true).expect("start node is in bounds")
  queue.push(start)

  let mut head: usize = 0
  while head < queue.len() {
    let node = queue.get(head).expect("queued index is in bounds")
    head = head + 1
    for next in zero..nodes {
      if graph_has_edge(graph, nodes, node, next) and not seen.get(next).expect("node is in bounds") {
        seen.set(next, true).expect("reachable node is in bounds")
        queue.push(next)
      } else { 0 }
    }
  }
  seen
}

fn graph_reachable_count(graph: borrow Vector<bool>, nodes: usize, start: usize) -> usize {
  let seen = graph_reachable_marks(graph, nodes, start)
  seen.fold<usize>(0, (total: usize, marked: bool) => if marked { total + 1 } else { total })
}

fn main() -> i64 {
  let nodes: usize = 6
  let mut graph = graph_new(nodes)
  graph_add_edge(graph, nodes, 0, 1)
  graph_add_edge(graph, nodes, 0, 2)
  graph_add_edge(graph, nodes, 1, 3)
  graph_add_edge(graph, nodes, 2, 3)
  graph_add_edge(graph, nodes, 3, 4)

  if graph_has_edge(graph, nodes, 0, 1) and
    not graph_has_edge(graph, nodes, 4, 0) and
    graph_out_degree(graph, nodes, 0) == 2 and
    graph_reachable_count(graph, nodes, 0) == 5 and
    graph_reachable_count(graph, nodes, 5) == 1 {
    0
  } else { 1 }
}
