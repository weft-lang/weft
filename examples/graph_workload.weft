-- Graph workload: adjacency matrix plus vector-queue reachability.
-- Benchmark: vector-backed graph basics, nested scans, queue growth.
use stdlib/option.{Option}
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn graph_new(nodes: i64) -> Vector<i64> {
  let graph = vector.with_capacity<i64>(nodes * nodes)
  for i in 0..nodes * nodes {
    graph.push(0)
  }
  graph
}

fn graph_index(nodes: i64, from: i64, to: i64) -> i64 {
  from * nodes + to
}

fn graph_add_edge(graph: Vector<i64>, nodes: i64, from: i64, to: i64) -> i64 {
  graph.set(graph_index(nodes, from, to), 1)
}

fn graph_has_edge(graph: Vector<i64>, nodes: i64, from: i64, to: i64) -> i64 {
  graph.get(graph_index(nodes, from, to)).unwrap_or(0)
}

fn graph_out_degree(graph: Vector<i64>, nodes: i64, from: i64) -> i64 {
  let mut total = 0
  for to in 0..nodes {
    total = total + graph_has_edge(graph, nodes, from, to)
  }
  total
}

fn graph_reachable_marks(graph: Vector<i64>, nodes: i64, start: i64) -> Vector<i64> {
  let seen = vector.with_capacity<i64>(nodes)
  for i in 0..nodes {
    seen.push(0)
  }

  let queue = vector.with_capacity<i64>(nodes)
  seen.set(start, 1)
  queue.push(start)

  let mut head = 0
  while head < queue.len() {
    let node = queue.get(head).expect("queued index is in bounds")
    head = head + 1
    for next in 0..nodes {
      if graph_has_edge(graph, nodes, node, next) == 1 and seen.get(next).unwrap_or(0) == 0 {
        seen.set(next, 1)
        queue.push(next)
      } else { 0 }
    }
  }
  seen
}

fn graph_reachable_count(graph: Vector<i64>, nodes: i64, start: i64) -> i64 {
  let seen = graph_reachable_marks(graph, nodes, start)
  seen.fold<i64>(0, (acc: i64, mark: i64) => acc + mark)
}

fn main() -> i64 {
  let nodes = 6
  let graph = graph_new(nodes)
  graph_add_edge(graph, nodes, 0, 1)
  graph_add_edge(graph, nodes, 0, 2)
  graph_add_edge(graph, nodes, 1, 3)
  graph_add_edge(graph, nodes, 2, 3)
  graph_add_edge(graph, nodes, 3, 4)

  let mut ok = 1
  if graph_has_edge(graph, nodes, 0, 1) != 1 { ok = 0 } else { 0 }
  if graph_has_edge(graph, nodes, 4, 0) != 0 { ok = 0 } else { 0 }
  if graph_out_degree(graph, nodes, 0) != 2 { ok = 0 } else { 0 }
  if graph_reachable_count(graph, nodes, 0) != 5 { ok = 0 } else { 0 }
  if graph_reachable_count(graph, nodes, 5) != 1 { ok = 0 } else { 0 }

  if ok == 1 { 0 } else { 1 }
}
