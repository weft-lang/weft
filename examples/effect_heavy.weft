-- Heavy effect dispatch: perform in a tight loop
-- Benchmark: handler dispatch overhead, inlining effectiveness
-- This is the workload where handler inlining matters most.
use stdlib/option.{*}
use stdlib/vector.{*}

effect Counter {
  fn inc() -> i64
  fn get() -> i64
}

fn count_with_effects(n: i64) -[Counter]> i64 {
  for i in 0..n {
    Counter.inc()
  }
  Counter.get()
}

fn with_counter(f: () -[Counter]> i64) -> i64 {
  let cell = vector_with_capacity<i64>(1)
  cell.push(0)
  handle f() {
    Counter.inc() -> {
      let cur = cell.get(0).unwrap_or(0)
      cell.set(0, cur + 1)
      resume(0)
    }
    Counter.get() -> resume(cell.get(0).unwrap_or(0))
  }
}

fn main() -> i64 {
  let result = with_counter(() => count_with_effects(10000))
  if result == 10000 { 0 } else { 1 }
}
