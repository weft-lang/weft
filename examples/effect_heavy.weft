-- Heavy effect dispatch: perform in a tight loop
-- Benchmark: handler dispatch overhead, inlining effectiveness
-- This is the workload where handler inlining matters most.
use "stdlib/display.weft"

effect Counter {
  fn inc() -> i64
  fn get() -> i64
}

fn count_with_effects(n: i64) -[Counter]> i64 {
  for i in 0..n {
    Counter.inc()
  }
  Counter.get()
}

fn with_counter(f: () -[Counter]> i64) -> i64 {
  let cell = __bump_alloc(8)
  __mem_store64(cell, 0)
  handle f() {
    Counter.inc() -> {
      let cur = __mem_load64(cell)
      __mem_store64(cell, cur + 1)
      resume(0)
    }
    Counter.get() -> resume(__mem_load64(cell))
  }
}

fn main() -> i64 {
  let result = with_counter(() => count_with_effects(10000))
  println(str_concat("effect_heavy count = ", int_to_str(result)))
  0
}
