-- Heavy effect dispatch: perform in a tight loop
-- Benchmark: handler dispatch overhead, inlining effectiveness
-- This is the workload where handler inlining matters most.
use stdlib/state as state
use stdlib/state.{State}

effect Counter {
  fn inc() -> nil
  fn get() -> i64
}

fn count_with_effects(n: i64) -[Counter]> i64 {
  for i in 0..n {
    Counter.inc()
  }
  Counter.get()
}

fn main() -> i64 {
  let (result, final_count) = state.run(0, () => {
    handle count_with_effects(10000) {
      Counter.inc() -> {
        State<i64>.put(State<i64>.get() + 1)
        resume(nil)
      }
      Counter.get() -> resume(State<i64>.get())
    }
  })
  if result == 10000 and final_count == 10000 { 0 } else { 1 }
}
