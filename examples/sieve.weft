-- Sieve of Eratosthenes: count primes strictly below limit.
-- Benchmark: indexed boolean storage and nested loops.

use stdlib/option
use stdlib/result
use stdlib/vector as vector

fn sieve(limit: usize) -> usize {
  if limit <= 2 { return 0 }
  let mut candidates = vector.with_capacity<bool>(limit)
  let zero: usize = 0
  for value in zero..limit { candidates.push(value >= 2) }
  let mut prime: usize = 2
  -- Division tests the square bound without overflowing prime * prime.
  while prime <= (limit - 1) / prime {
    if candidates.get(prime).expect("prime candidate is in bounds") {
      let mut multiple = prime * prime
      while multiple < limit {
        candidates.set(multiple, false).expect("composite is in bounds")
        if limit - multiple <= prime { break }
        multiple = multiple + prime
      }
    }
    prime = prime + 1
  }
  candidates.fold<usize>(0, (count: usize, candidate: bool) => if candidate { count + 1 } else { count })
}

fn main() -> i64 {
  if sieve(10000) == 1229 and sieve(0) == 0 and sieve(1) == 0 and
    sieve(2) == 0 and sieve(3) == 1 and sieve(4) == 2 and sieve(10) == 4 {
    0
  } else { 1 }
}
