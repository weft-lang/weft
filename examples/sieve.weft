-- Sieve of Eratosthenes: find primes up to N
-- Benchmark: array-like access patterns, nested loops, conditionals
fn sieve(limit: i64) -> i64 {
  -- Allocate a boolean array (1 = prime candidate, 0 = composite)
  let arr = __bump_alloc(limit * 8)
  -- Initialize: all numbers >= 2 are candidates
  for i in 0..limit {
    if i >= 2 { __mem_store64(arr + i * 8, 1) }
    else { __mem_store64(arr + i * 8, 0) }
  }
  -- Sieve: for each prime p, mark p*p, p*p+p, ... as composite
  let mut p = 2
  while p * p < limit {
    if __mem_load64(arr + p * 8) == 1 {
      let mut j = p * p
      while j < limit {
        __mem_store64(arr + j * 8, 0)
        j = j + p
      }
    } else { 0 }
    p = p + 1
  }
  -- Count primes
  let mut count: i64 = 0
  for i in 0..limit {
    if __mem_load64(arr + i * 8) == 1 { count = count + 1 } else { 0 }
  }
  count
}

fn main() -> i64 {
  let limit = 10000
  let count = sieve(limit)
  if count == 1229 { 0 } else { 1 }
}
