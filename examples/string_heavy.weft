-- String-heavy: lots of concatenation and conversion
-- Benchmark: allocation patterns for string building
use "stdlib/display.weft"

fn build_string(n: i64) -> i64 {
  let mut result = ""
  for i in 0..n {
    let is = int_to_str(i)
    result = str_concat(result, str_concat(is, " "))
  }
  result
}

fn main() -> i64 {
  let s = build_string(200)
  let len = str_len(s)
  println(str_concat("string_heavy len = ", int_to_str(len)))
  0
}
