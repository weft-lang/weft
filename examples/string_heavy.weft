-- String-heavy: lots of concatenation and conversion
-- Benchmark: allocation patterns for string building

use stdlib/string

fn build_string(n: i64) -> str {
  let mut result = ""
  for i in 0..n {
    result = "{result}{i} "
  }
  result
}

fn main() -> i64 {
  let s = build_string(200)
  let len = s.len()
  if len == 690 and s.starts_with("0 1 2 3 ") and s.ends_with("197 198 199 ") and
    build_string(0) == "" and build_string(4) == "0 1 2 3 " { 0 } else { 1 }
}
