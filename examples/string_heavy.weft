-- String-heavy: lots of concatenation and conversion
-- Benchmark: allocation patterns for string building
use stdlib/string.{*}

fn build_string(n: i64) -> str {
  let mut result = ""
  for i in 0..n {
    result = "{result}{i} "
  }
  result
}

fn main() -> i64 {
  let s = build_string(200)
  let len = s.len()
  if len == 690 { 0 } else { 1 }
}
