-- Closure-heavy: many lambda allocations and indirect calls
-- Benchmark: closure allocation overhead, indirect call dispatch
use stdlib/list as list
use stdlib/list.{List}

-- Apply a chain of transformations, each as a closure
fn apply_chain(xs: List<i64>, n: i64) -> List<i64> {
  let mut result: List<i64> = xs
  for i in 0..n {
    result = result.map<i64>((x: i64) => x + 1)
  }
  result
}

fn main() -> i64 {
  let data = list.range(0, 100)
  -- Apply 100 map passes, each incrementing by 1
  let result = apply_chain(data, 10)
  -- First element should be 0 + 10 = 10
  let first = match result.first() {
    Some(value) -> value
    None -> 0 - 1
  }
  -- Sum should be sum(10..110) = 5950
  let sum = result.fold<i64>(0, (acc: i64, x: i64) => acc + x)
  if first == 10 and sum == 5950 { 0 } else { 1 }
}
