-- Fibonacci: recursive and iterative
-- Benchmark: measures function call overhead and loop performance
use "stdlib/display.weft"

fn fib_recursive(n: i64) -> i64 {
  if n <= 1 { n }
  else { fib_recursive(n - 1) + fib_recursive(n - 2) }
}

fn fib_iterative(n: i64) -> i64 {
  let mut a: i64 = 0
  let mut b: i64 = 1
  for i in 0..n {
    let tmp = b
    b = a + b
    a = tmp
  }
  a
}

fn main() -> i64 {
  let n = 30
  let result = fib_recursive(n)
  let ns = int_to_str(n)
  println("fib_recursive({ns})")
  println(str_concat("  = ", int_to_str(result)))

  let result2 = fib_iterative(n)
  println("fib_iterative({ns})")
  println(str_concat("  = ", int_to_str(result2)))
  0
}
