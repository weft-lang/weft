-- Monomorphisation-heavy: many different type instantiations
-- Benchmark: specialisation cache effectiveness, code size
use stdlib/option.{Option, Some}
use stdlib/result.{Ok, Result}

fn identity<T>(x: T) -> T { x }
fn wrap<T>(x: T) -> T { identity<T>(x) }
fn double_wrap<T>(x: T) -> T { wrap<T>(wrap<T>(x)) }

fn main() -> i64 {
  -- Many different instantiations
  let a = identity<i64>(42)
  let b = identity<str>("hello")
  let c = identity<bool>(true)
  let d = wrap<i64>(10)
  let e = wrap<str>("world")
  let f = double_wrap<i64>(20)

  -- Generic function with Option
  let g = identity<Option<i64>>(Some<i64>(42))
  let h = identity<Result<i64, str>>(Ok<i64, str>(42))

  -- Verify
  let sum = a + d + f
  if sum == 72 { 0 } else { 1 }
}
