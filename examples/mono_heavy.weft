-- Monomorphisation-heavy: many different type instantiations.
-- Benchmark: specialisation cache effectiveness and code size.

use stdlib/option.{Option, Some, None}
use stdlib/result.{Ok, Err, Result}

fn identity<T>(value: T) -> T { value }

fn wrap<T>(value: T) -> T { identity(value) }

fn double_wrap<T>(value: T) -> T { value |> wrap() |> wrap() }

fn main() -> i64 {
  let number = identity(42)
  let greeting = identity("hello")
  let enabled = identity(true)
  let wrapped_number = wrap(10)
  let wrapped_text = wrap("world")
  let twice_wrapped = double_wrap(20)
  let optional = identity(Some(42))
  let missing: Option<i64> = identity<Option<i64>>(None)
  let success: Result<i64, str> = identity(Ok<i64, str>(42))
  let failure: Result<i64, str> = double_wrap(Err<i64, str>("unavailable"))
  let variants_ok = match (optional, missing, success, failure) {
    (Some(value), None, Ok(result), Err(message)) -> value == 42 and result == 42 and message == "unavailable"
    _ -> false
  }
  if number + wrapped_number + twice_wrapped == 72 and
    greeting == "hello" and enabled and wrapped_text == "world" and variants_ok {
    0
  } else { 1 }
}
