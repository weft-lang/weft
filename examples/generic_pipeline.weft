-- Persistent generic data: materialized map/filter results followed by folds.
-- Benchmark: monomorphisation and higher-order generic functions.

use stdlib/list as list
use stdlib/list.{List}

fn sum(values: List<i64>) -> i64 {
  values.fold(0, (total: i64, value: i64) => total + value)
}

fn main() -> i64 {
  let data = list.range(1, 11)
  -- These are persistent lists; all transformations leave data available.
  let doubled: List<i64> = data.map((value: i64) => value * 2)
  let shifted: List<i64> = data.map((value: i64) => value + 100)
  let evens: List<i64> = data.filter((value: i64) => value % 2 == 0)
  if sum(doubled) == 110 and sum(shifted) == 1055 and
    sum(evens) == 30 and sum(data) == 55 {
    0
  } else { 1 }
}
