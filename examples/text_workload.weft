-- Text workload: trim/split/join/search plus UTF-8 codepoint counting.
-- Benchmark: byte-oriented strings layered with scalar-aware UTF-8 helpers.

use stdlib/option.{Option}
use stdlib/string
use stdlib/vector

fn main() -> i64 {
  let text = " \talpha beta Ω mega data\n"
  let trimmed = text.trim()
  let parts = trimmed.split(" ")
  let joined = parts.join("|")
  if parts.len() == 5 and
     joined.contains("Ω") and
     joined.find("data").unwrap_or(0 - 1) == 19 and
     joined.scalar_count() == 22 {
    0
  } else {
    1
  }
}
