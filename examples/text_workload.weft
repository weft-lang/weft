-- Text workload: trim/split/join/search plus UTF-8 codepoint counting.
-- Benchmark: byte-oriented strings layered with scalar-aware UTF-8 helpers.

use "stdlib/string.weft"
use "stdlib/vector.weft"

fn main() -> i64 {
  let text = " \talpha beta Ω mega data\n"
  let trimmed = str_trim(text)
  let parts = str_split(trimmed, " ")
  let joined = str_join(parts, "|")
  if vector_len(parts) == 5 and
     str_contains(joined, "Ω") == 1 and
     str_find(joined, "data") == 19 and
     str_codepoint_count(joined) == 22 {
    0
  } else {
    1
  }
}
