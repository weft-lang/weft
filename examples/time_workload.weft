-- Date/time workload: calendar arithmetic and duration/instant helpers.
-- Benchmark: pure stdlib arithmetic with boundary-heavy date conversion.
use stdlib/time.{*}

fn main() -> i64 {
  let start = date_new(2024, 2, 28)
  let next = date_add_days(start, 1)
  let after = date_add_days(start, 2)
  let before_epoch = date_from_epoch_day(0 - 1)
  let duration = duration_add(duration_hours(1), duration_minutes(30))
  let later = instant_add(instant_from_millis(1000), duration)
  let elapsed = instant_duration_since(later, instant_from_millis(1000))

  let mut ok = 1
  if date_year(next) != 2024 or date_month(next) != 2 or date_day(next) != 29 { ok = 0 } else { 0 }
  if date_year(after) != 2024 or date_month(after) != 3 or date_day(after) != 1 { ok = 0 } else { 0 }
  if date_year(before_epoch) != 1969 or date_month(before_epoch) != 12 or date_day(before_epoch) != 31 { ok = 0 } else { 0 }
  if duration_to_millis(elapsed) != 5400000 { ok = 0 } else { 0 }
  if date_day_of_week(date_new(1970, 1, 1)) != 4 { ok = 0 } else { 0 }

  if ok == 1 { 0 } else { 1 }
}
