-- Date/time workload: calendar arithmetic and duration/instant helpers.
-- Benchmark: pure stdlib arithmetic with boundary-heavy date conversion.
use stdlib/option.{Option}
use stdlib/time as time
use stdlib/time.{Date, Thursday}

fn main() -> i64 {
  let start = time.date(2024, 2, 28).unwrap()
  let next = start.add_days(1)
  let after = start.add_days(2)
  let before_epoch = time.from_epoch_day(0 - 1)
  let duration = time.duration_add(time.duration_hours(1), time.duration_minutes(30))
  let later = time.instant_add(time.instant_from_millis(1000), duration)
  let elapsed = time.instant_duration_since(later, time.instant_from_millis(1000))

  let mut ok = 1
  if next.year() != 2024 or next.month() != 2 or next.day() != 29 { ok = 0 } else { 0 }
  if after.year() != 2024 or after.month() != 3 or after.day() != 1 { ok = 0 } else { 0 }
  if before_epoch.year() != 1969 or before_epoch.month() != 12 or before_epoch.day() != 31 { ok = 0 } else { 0 }
  if time.duration_to_millis(elapsed) != 5400000 { ok = 0 } else { 0 }
  let epoch_is_thursday = match time.date(1970, 1, 1).unwrap().weekday() {
    Thursday -> true
    _ -> false
  }
  if not epoch_is_thursday { ok = 0 } else { 0 }

  if ok == 1 { 0 } else { 1 }
}
