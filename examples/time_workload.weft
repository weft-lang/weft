-- Date/time workload: calendar arithmetic and duration/instant helpers.
-- Benchmark: pure stdlib arithmetic with boundary-heavy date conversion.

use stdlib/option.{Option}
use stdlib/time as time
use stdlib/time.{Duration}
use stdlib/time/calendar as calendar
use stdlib/time/calendar.{Date, Thursday}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant}

fn main() -> i64 {
  let start = calendar.date(2024, 2, 28).unwrap()
  let next = start.add_days(1)
  let after = start.add_days(2)
  let before_epoch = calendar.from_epoch_day(0 - 1)
  let duration = time.hours(1).add(time.minutes(30))
  let later = monotonic.nanoseconds(1000000000).add(duration)
  let elapsed = later.duration_since(monotonic.nanoseconds(1000000000))

  let epoch_is_thursday = match calendar.date(1970, 1, 1).unwrap().weekday() {
    Thursday -> true
    _ -> false
  }
  if next.year() == 2024 and next.month() == 2 and next.day() == 29 and
    after.year() == 2024 and after.month() == 3 and after.day() == 1 and
    before_epoch.year() == 1969 and before_epoch.month() == 12 and before_epoch.day() == 31 and
    elapsed.milliseconds() == 5400000 and epoch_is_thursday {
    0
  } else { 1 }
}
