-- Scoped tasks and a capacity-one channel with bounded backpressure.

use stdlib/result.{Err, Ok}
use stdlib/task as task
use stdlib/task/channel as channel
use stdlib/task/channel.{Channel}

fn produce() -[Channel<i64>]> bool {
  match Channel<i64>.send(20) {
    channel.SendAccepted -> nil
    channel.SendClosed(returned) -> return false
  }
  match Channel<i64>.send(22) {
    channel.SendAccepted -> nil
    channel.SendClosed(returned) -> return false
  }
  match Channel<i64>.close() {
    channel.ClosedNow -> true
    channel.AlreadyClosed -> false
  }
}

fn receive() -[Channel<i64>]> i64 {
  let mut total = 0
  loop {
    match Channel<i64>.receive() {
      channel.Received(value) -> { total = total + value }
      channel.Drained -> return total
    }
  }
}

fn concurrent_sum() -[task.TaskScope, Channel<i64>]> (bool, i64) {
  let producer = task.spawn(produce)
  let consumer = task.spawn(receive)
  (producer.join(), consumer.join())
}

fn main() -> i64 {
  match channel.capacity(1) {
    Ok(capacity) -> match task.with_sequential_channel(capacity, concurrent_sum) {
      (true, 42) -> 0
      _ -> 1
    }
    Err(error) -> 1
  }
}
