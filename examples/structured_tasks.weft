-- examples/structured_tasks.weft -- scoped tasks and bounded backpressure

use stdlib/result.{Err, Ok}
use stdlib/task as task
use stdlib/task/channel as channel
use stdlib/task/channel.{Channel}

fn publish(value: i64) -[Channel<i64>]> i64 {
  match Channel<i64>.send(value) {
    channel.SendAccepted -> 1
    channel.SendClosed(returned) -> 0 - returned
  }
}

fn produce() -[Channel<i64>]> i64 {
  let first = publish(20)
  let second = publish(22)
  let closed = match Channel<i64>.close() {
    channel.ClosedNow -> 1
    channel.AlreadyClosed -> 0
  }
  first + second + closed
}

fn receive() -[Channel<i64>]> i64 {
  let first = match Channel<i64>.receive() {
    channel.Received(value) -> value
    channel.Drained -> 0
  }
  let second = match Channel<i64>.receive() {
    channel.Received(value) -> value
    channel.Drained -> 0
  }
  first + second
}

fn concurrent_sum() -[task.TaskScope, Channel<i64>]> i64 {
  let producer = task.spawn(produce)
  let consumer = task.spawn(receive)
  producer.join() * 100 + consumer.join()
}

fn main() -> i64 {
  match channel.capacity(1) {
    Ok(capacity) -> {
      let result = task.with_sequential_channel(capacity, concurrent_sum)
      if result == 342 { 0 } else { 2 }
    }
    Err(error) -> 1
  }
}
