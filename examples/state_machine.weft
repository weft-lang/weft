-- Word scanner using a typed State effect.
-- Benchmark: effect dispatch and handler inlining over a byte-oriented loop.

use stdlib/bytes as bytes
use stdlib/state as state
use stdlib/state.{State}

type WordPosition {
  BetweenWords,
  InsideWord
}

fn count_words(text: str) -[State<WordPosition>]> i64 {
  let bytes = bytes.from_str(text).to_vector()
  let space: u8 = 32
  let mut words = 0
  State<WordPosition>.put(BetweenWords)

  for byte in bytes {
    if byte == space {
      State<WordPosition>.put(BetweenWords)
    } else {
      match State<WordPosition>.get() {
        BetweenWords -> {
          words = words + 1
          State<WordPosition>.put(InsideWord)
        }
        InsideWord -> nil
      }
    }
  }
  words
}

fn main() -> i64 {
  let text = "the quick brown fox jumps over the lazy dog"
  let (count, final_position) = state.run(BetweenWords, () => count_words(text))
  if count == 9 { 0 } else { 1 }
}
