-- State machine: tokenizer using the State effect
-- Benchmark: effect dispatch overhead, handler inlining effectiveness
use "stdlib/vector.weft"

effect State {
  fn get() -> i64
  fn put(val: i64) -> i64
}

fn with_state(init: i64, f: () -[State]> i64) -> i64 {
  let cell = vector_with_capacity<i64>(1)
  vector_push<i64>(cell, init)
  handle f() {
    State.get() -> resume(vector_get<i64>(cell, 0, init))
    State.put(v) -> {
      vector_set<i64>(cell, 0, v)
      resume(0)
    }
  }
}

-- Count the number of "words" (runs of non-space characters)
-- in a byte vector using a state machine
fn count_words(chars: Vector<i64>) -[State]> i64 {
  let len = vector_len<i64>(chars)
  let mut words: i64 = 0
  -- State: 0 = in space, 1 = in word
  State.put(0)
  for i in 0..len {
    let ch = vector_get<i64>(chars, i, 32)
    let in_word = State.get()
    if ch == 32 {
      -- Space: transition to "in space"
      State.put(0)
    } else {
      -- Non-space: if transitioning from space, count a new word
      if in_word == 0 {
        words = words + 1
        State.put(1)
      } else { 0 }
    }
  }
  words
}

fn main() -> i64 {
  let text = vector_with_capacity<i64>(43)
  vector_push<i64>(text, 116) vector_push<i64>(text, 104) vector_push<i64>(text, 101)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 113) vector_push<i64>(text, 117) vector_push<i64>(text, 105) vector_push<i64>(text, 99) vector_push<i64>(text, 107)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 98) vector_push<i64>(text, 114) vector_push<i64>(text, 111) vector_push<i64>(text, 119) vector_push<i64>(text, 110)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 102) vector_push<i64>(text, 111) vector_push<i64>(text, 120)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 106) vector_push<i64>(text, 117) vector_push<i64>(text, 109) vector_push<i64>(text, 112) vector_push<i64>(text, 115)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 111) vector_push<i64>(text, 118) vector_push<i64>(text, 101) vector_push<i64>(text, 114)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 116) vector_push<i64>(text, 104) vector_push<i64>(text, 101)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 108) vector_push<i64>(text, 97) vector_push<i64>(text, 122) vector_push<i64>(text, 121)
  vector_push<i64>(text, 32)
  vector_push<i64>(text, 100) vector_push<i64>(text, 111) vector_push<i64>(text, 103)
  let n = with_state(0, () => count_words(text))
  if n == 9 { 0 } else { 1 }
}
