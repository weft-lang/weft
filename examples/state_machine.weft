-- State machine: tokenizer using the State effect
-- Benchmark: effect dispatch overhead, handler inlining effectiveness
use "stdlib/display.weft"

effect State {
  fn get() -> i64
  fn put(val: i64) -> i64
}

fn with_state(init: i64, f: () -[State]> i64) -> i64 {
  let cell = __bump_alloc(8)
  __mem_store64(cell, init)
  handle f() {
    State.get() -> resume(__mem_load64(cell))
    State.put(v) -> {
      __mem_store64(cell, v)
      resume(0)
    }
  }
}

-- Count the number of "words" (runs of non-space characters)
-- in a string using a state machine
fn count_words(s: i64) -[State]> i64 {
  let ptr = __str_ptr(s)
  let len = __str_len(s)
  let mut words: i64 = 0
  -- State: 0 = in space, 1 = in word
  State.put(0)
  for i in 0..len {
    let ch = __mem_load8(ptr + i)
    let in_word = State.get()
    if ch == 32 {
      -- Space: transition to "in space"
      State.put(0)
    } else {
      -- Non-space: if transitioning from space, count a new word
      if in_word == 0 {
        words = words + 1
        State.put(1)
      } else { 0 }
    }
  }
  words
}

fn main() -> i64 {
  let text = "the quick brown fox jumps over the lazy dog"
  let n = with_state(0, () => count_words(text))
  println(str_concat("word count = ", int_to_str(n)))
  0
}
