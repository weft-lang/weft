-- Word scanner using a typed State effect.
-- Benchmark: effect dispatch and handler inlining over a byte-oriented loop.

use stdlib/bytes.{bytes_from_str, bytes_to_vector}
use stdlib/vector.{Vector, vector_get_in_bounds, vector_new, vector_push, vector_set}

type WordPosition {
  BetweenWords,
  InsideWord
}

effect WordState {
  fn get() -> WordPosition
  fn put(position: WordPosition) -> nil
}

fn with_word_state(initial: WordPosition, body: () -[WordState]> i64) -> i64 {
  let cell = vector_new<WordPosition>()
  vector_push<WordPosition>(cell, initial)
  handle body() {
    WordState.get() -> resume(vector_get_in_bounds<WordPosition>(cell, 0))
    WordState.put(position) -> {
      vector_set<WordPosition>(cell, 0, position)
      resume(nil)
    }
  }
}

fn count_words(text: str) -[WordState]> i64 {
  let bytes = bytes_to_vector(bytes_from_str(text))
  let space: u8 = 32
  let mut words = 0
  WordState.put(BetweenWords)

  for byte in bytes {
    if byte == space {
      WordState.put(BetweenWords)
    } else {
      match WordState.get() {
        BetweenWords -> {
          words = words + 1
          WordState.put(InsideWord)
        }
        InsideWord -> nil
      }
    }
  }
  words
}

fn main() -> i64 {
  let text = "the quick brown fox jumps over the lazy dog"
  let count = with_word_state(BetweenWords, () => count_words(text))
  if count == 9 { 0 } else { 1 }
}
