-- Count runs of non-space bytes using a typed State effect.
-- ASCII space separates words; tabs and other whitespace are ordinary bytes.
-- Benchmark: effect dispatch and handler inlining over a byte-oriented loop.

use stdlib/bytes as bytes
use stdlib/state as state
use stdlib/state.{State}

type WordPosition {
  BetweenWords,
    InsideWord
}

fn count_words(text: str) -[State<WordPosition>]> i64 {
  let bytes = bytes.from_str(text).to_vector()
  let space: u8 = 32
  let mut words = 0
  State<WordPosition>.put(BetweenWords)

  for byte in bytes {
    if byte == space {
      State<WordPosition>.put(BetweenWords)
    } else {
      match State<WordPosition>.get() {
        BetweenWords -> {
          words = words + 1
          State<WordPosition>.put(InsideWord)
        }
        InsideWord -> nil
      }
    }
  }
  words
}

fn scanner_matches(text: str, expected: i64, ends_inside: bool) -> bool {
  let (count, final_position) = state.run(BetweenWords, () => count_words(text))
  let inside = match final_position { InsideWord -> true BetweenWords -> false }
  count == expected and inside == ends_inside
}

fn main() -> i64 {
  if scanner_matches("the quick brown fox jumps over the lazy dog", 9, true) and
    scanner_matches("", 0, false) and scanner_matches("   ", 0, false) and
    scanner_matches("  one   two  ", 2, false) and scanner_matches("hello Ω", 2, true) and
    scanner_matches("one\ttwo", 1, true) {
    0
  } else { 1 }
}
