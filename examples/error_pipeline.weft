-- Error handling: validate and transform through a typed Fail effect.
-- Benchmark: effect dispatch and recoverable error propagation.

use stdlib/fail as fail
use stdlib/fail.{Fail}
use stdlib/result.{Err, Ok, Result}

type PipelineError { NotPositive, BelowRange, AboveRange }

fn require_positive(value: i64) -[Fail<PipelineError>]> i64 {
  if value > 0 { value } else { Fail<PipelineError>.fail(NotPositive) }
}

fn validate_range(value: i64, lower: i64, upper: i64) -[Fail<PipelineError>]> i64 {
  match value {
    value if value < lower -> Fail<PipelineError>.fail(BelowRange)
    value if value > upper -> Fail<PipelineError>.fail(AboveRange)
    value -> value
  }
}

fn square(value: i64) -> i64 { value * value }

fn process(input: i64) -[Fail<PipelineError>]> i64 {
  input |> require_positive() |> validate_range(2, 100) |> square()
}

fn main() -> i64 {
  let happy = fail.run(() => process(7))
  let nonpositive = fail.run(() => process(-5))
  let below = fail.run(() => process(1))
  let above = fail.run(() => process(200))
  let variants_ok = match (happy, nonpositive, below, above) {
    (Ok(value), Err(NotPositive), Err(BelowRange), Err(AboveRange)) -> value == 49
    _ -> false
  }
  -- Process 1 through 99; only 1 lies outside the accepted range.
  let mut sum = 0
  for input in 1..100 {
    match fail.run(() => process(input)) {
      Ok(value) -> { sum = sum + value }
      Err(BelowRange) -> nil
      Err(NotPositive) -> return 1
      Err(AboveRange) -> return 1
    }
  }
  let boundaries_ok = match (fail.run(() => process(2)), fail.run(() => process(100))) {
    (Ok(lower), Ok(upper)) -> lower == 4 and upper == 10000
    _ -> false
  }
  if variants_ok and boundaries_ok and sum == 328349 { 0 } else { 1 }
}
