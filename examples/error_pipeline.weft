-- Error handling pipeline: parse → validate → transform using ? operator
-- Benchmark: effect dispatch for error propagation, real-world pattern
use "stdlib/result.weft"
use "stdlib/fail.weft"
use "stdlib/display.weft"

fn parse_positive(x: i64) -> i64 {
  if x > 0 { Ok<i64>(x) }
  else { Err<i64>(1) }
}

fn validate_range(x: i64, lo: i64, hi: i64) -> i64 {
  if x >= lo {
    if x <= hi { Ok<i64>(x) }
    else { Err<i64>(2) }
  } else { Err<i64>(3) }
}

fn transform(x: i64) -> i64 { Ok<i64>(x * x) }

fn process(input: i64) -[Fail]> i64 {
  let parsed = parse_positive(input)?
  let valid = validate_range(parsed, 1, 100)?
  transform(valid)?
}

fn safe_process(input: i64) -> i64 {
  handle process(input) {
    Fail.fail(code) -> resume(0 - code)
  }
}

fn main() -> i64 {
  -- Happy path: 7 → parse ok → range ok → 49
  let r1 = safe_process(7)
  println(str_concat("process(7)  = ", int_to_str(r1)))

  -- Error: negative → parse fails with code 1
  let r2 = safe_process(0 - 5)
  println(str_concat("process(-5) = ", int_to_str(r2)))

  -- Error: out of range → validate fails with code 2
  let r3 = safe_process(200)
  println(str_concat("process(200)= ", int_to_str(r3)))

  -- Run 1000 iterations for benchmarking
  let mut sum: i64 = 0
  for i in 1..100 {
    let r = safe_process(i)
    if r > 0 { sum = sum + r } else { 0 }
  }
  println(str_concat("sum of squares 1..99 = ", int_to_str(sum)))
  0
}
