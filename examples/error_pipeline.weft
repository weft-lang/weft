-- Error handling pipeline: parse → validate → transform using Fail
-- Benchmark: effect dispatch for error propagation, real-world pattern
use stdlib/fail.{Fail, try_result}
use stdlib/result.{Err, Ok, Result}

type PipelineError {
  NotPositive,
  BelowRange,
  AboveRange
}

fn parse_positive(value: i64) -> Result<i64, PipelineError> {
  if value > 0 {
    Ok(value)
  } else {
    Err(NotPositive)
  }
}

fn validate_range(value: i64, lower: i64, upper: i64) -> Result<i64, PipelineError> {
  if value < lower {
    Err(BelowRange)
  } else {
    if value > upper {
      Err(AboveRange)
    } else {
      Ok(value)
    }
  }
}

fn transform(value: i64) -> i64 { value * value }

fn process(input: i64) -[Fail<PipelineError>]> i64 {
  let parsed = parse_positive(input)?
  let valid = validate_range(parsed, 1, 100)?
  transform(valid)
}

fn safe_process(input: i64) -> i64 {
  match try_result<i64, PipelineError>(() => process(input)) {
    Ok(value) -> value
    Err(error) -> match error {
      NotPositive -> 0 - 1
      BelowRange -> 0 - 3
      AboveRange -> 0 - 2
    }
  }
}

fn main() -> i64 {
  -- Happy path: 7 → parse ok → range ok → 49
  let r1 = safe_process(7)

  -- Error: negative → parse fails with code 1
  let r2 = safe_process(0 - 5)

  -- Error: out of range → validate fails with code 2
  let r3 = safe_process(200)

  -- Run 1000 iterations for benchmarking
  let mut sum: i64 = 0
  for i in 1..100 {
    let r = safe_process(i)
    if r > 0 { sum = sum + r } else { 0 }
  }
  if r1 == 49 and r2 == 0 - 1 and r3 == 0 - 2 and sum == 328350 { 0 } else { 1 }
}
