-- Error handling pipeline: parse → validate → transform using Fail
-- Benchmark: effect dispatch for error propagation, real-world pattern
use stdlib/fail.{*}

type PipeResult {
  PipeOk(i64),
  PipeErr(i64)
}

fn parse_positive(x: i64) -> PipeResult {
  if x > 0 { PipeOk(x) }
  else { PipeErr(1) }
}

fn validate_range(x: i64, lo: i64, hi: i64) -> PipeResult {
  if x >= lo {
    if x <= hi { PipeOk(x) }
    else { PipeErr(2) }
  } else { PipeErr(3) }
}

fn transform(x: i64) -> PipeResult { PipeOk(x * x) }

fn process(input: i64) -[Fail<i64>]> i64 {
  match parse_positive(input) {
    PipeOk(parsed) -> {
      match validate_range(parsed, 1, 100) {
        PipeOk(valid) -> {
          match transform(valid) {
            PipeOk(value) -> value
            PipeErr(code) -> Fail.fail(code)
          }
        }
        PipeErr(code) -> Fail.fail(code)
      }
    }
    PipeErr(code) -> Fail.fail(code)
  }
}

fn safe_process(input: i64) -> i64 {
  match try_result<i64, i64>(() => process(input)) {
    Ok(value) -> value
    Err(code) -> 0 - code
  }
}

fn main() -> i64 {
  -- Happy path: 7 → parse ok → range ok → 49
  let r1 = safe_process(7)

  -- Error: negative → parse fails with code 1
  let r2 = safe_process(0 - 5)

  -- Error: out of range → validate fails with code 2
  let r3 = safe_process(200)

  -- Run 1000 iterations for benchmarking
  let mut sum: i64 = 0
  for i in 1..100 {
    let r = safe_process(i)
    if r > 0 { sum = sum + r } else { 0 }
  }
  if r1 == 49 and r2 == 0 - 1 and r3 == 0 - 2 and sum == 328350 { 0 } else { 1 }
}
