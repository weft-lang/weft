-- Quicksort on a List: functional, persistent, recursive
-- Benchmark: allocation-heavy, recursive, higher-order (filter)
use stdlib/list.{Cons, List, Nil}

fn quicksort(xs: List<i64>) -> List<i64> {
  match xs {
    Nil -> Nil<i64>()
    Cons(pivot, rest) -> {
      let lo = rest.filter((x: i64) => x < pivot)
      let hi = rest.filter((x: i64) => x >= pivot)
      quicksort(lo).concat(Cons<i64>(pivot, quicksort(hi)))
    }
  }
}

fn main() -> i64 {
  -- Sort [5, 3, 8, 1, 9, 2, 7, 4, 6, 0]
  let data = Cons<i64>(5, Cons<i64>(3, Cons<i64>(8, Cons<i64>(1,
    Cons<i64>(9, Cons<i64>(2, Cons<i64>(7, Cons<i64>(4,
    Cons<i64>(6, Cons<i64>(0, Nil<i64>()))))))))))
  let sorted = quicksort(data)
  -- Verify: first element should be 0, last should be 9
  let first = match sorted.first() {
    Some(value) -> value
    None -> 0 - 1
  }
  let last = sorted.fold<i64>(0, (acc: i64, x: i64) => x)
  if first == 0 and last == 9 and sorted.len() == 10 { 0 } else { 1 }
}
