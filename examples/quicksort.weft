-- Quicksort on a List: functional, persistent, recursive
-- Benchmark: allocation-heavy, recursive, higher-order (filter)
use "stdlib/list.weft"

fn quicksort(xs: i64) -> i64 {
  if list_empty(xs) == 1 {
    xs
  } else {
    let pivot = list_first_or<i64>(xs, 0)
    let rest = list_rest_or_nil(xs)
    let lo = list_filter<i64>(rest, (x: i64) => if x < pivot { 1 } else { 0 })
    let hi = list_filter<i64>(rest, (x: i64) => if x >= pivot { 1 } else { 0 })
    list_concat(quicksort(lo), Cons<i64>(pivot, quicksort(hi)))
  }
}

-- Concatenate two lists
fn list_concat(a: i64, b: i64) -> i64 {
  if list_empty(a) == 1 {
    b
  } else {
    Cons<i64>(list_first_or<i64>(a, 0), list_concat(list_rest_or_nil(a), b))
  }
}

fn main() -> i64 {
  -- Sort [5, 3, 8, 1, 9, 2, 7, 4, 6, 0]
  let data = Cons<i64>(5, Cons<i64>(3, Cons<i64>(8, Cons<i64>(1,
    Cons<i64>(9, Cons<i64>(2, Cons<i64>(7, Cons<i64>(4,
    Cons<i64>(6, Cons<i64>(0, Nil))))))))))
  let sorted = quicksort(data)
  -- Verify: first element should be 0, last should be 9
  let first = list_first_or<i64>(sorted, 0 - 1)
  let last_r = list_fold<i64, i64>(sorted, 0, (acc: i64, x: i64) => x)
  -- Count = 10
  let count = list_fold<i64, i64>(sorted, 0, (acc: i64, x: i64) => acc + 1)
  if first == 0 and last_r == 9 and count == 10 { 0 } else { 1 }
}
