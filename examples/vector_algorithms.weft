-- Vector-backed algorithms: stdlib heapsort plus binary search.
-- Benchmark: mutable contiguous storage, bounds checks, search.

use stdlib/option.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

fn binary_search_i64(items: Vector<i64>, needle: i64) -> i64 {
  let mut lo = 0
  let mut hi = items.len()
  let mut found = 0 - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let value = items.get(mid).expect("binary-search midpoint is in bounds")
    if value == needle {
      found = mid
      lo = hi
    } else {
      if value < needle {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
  }
  found
}

fn checksum_i64(items: Vector<i64>) -> i64 {
  items.fold<i64>(0, (acc: i64, x: i64) => acc + x)
}

fn main() -> i64 {
  let items = vector.with_capacity<i64>(10)
  items.push(5)
  items.push(3)
  items.push(8)
  items.push(1)
  items.push(9)
  items.push(2)
  items.push(7)
  items.push(4)
  items.push(6)
  items.push(0)
  items.sort()
  if items.get(0).unwrap_or(0 - 1) == 0 and
     items.get(9).unwrap_or(0 - 1) == 9 and
     binary_search_i64(items, 7) == 7 and
     checksum_i64(items) == 45 {
    0
  } else {
    1
  }
}
