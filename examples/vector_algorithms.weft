-- Vector-backed algorithms: stdlib heapsort plus binary search.
-- Benchmark: mutable contiguous storage, bounds checks, search.

use stdlib/option.{Option, Some, None}
use stdlib/ord.{Ord, Less, Equal, Greater}
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn binary_search_i64(items: borrow Vector<i64>, needle: i64) -> Option<usize> {
  let mut lo: usize = 0
  let mut hi = items.len()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let value = items.get(mid).expect("binary-search midpoint is in bounds")
    match value.compare(needle) {
      Less -> { lo = mid + 1 }
      Equal -> return Some(mid)
      Greater -> { hi = mid }
    }
  }
  None
}

fn checksum_i64(items: borrow Vector<i64>) -> i64 {
  items.fold(0, (acc: i64, x: i64) => acc + x)
}

fn main() -> i64 {
  let mut items = vector.with_capacity<i64>(10)
  items.push(5)
  items.push(3)
  items.push(8)
  items.push(1)
  items.push(9)
  items.push(2)
  items.push(7)
  items.push(4)
  items.push(6)
  items.push(0)
  let sorted = items.sort()
  let empty = vector.new<i64>()
  if sorted.get(0).unwrap_or(0 - 1) == 0 and
     sorted.get(9).unwrap_or(0 - 1) == 9 and
     binary_search_i64(sorted, 7).unwrap() == 7 and
     binary_search_i64(sorted, 0).unwrap() == 0 and
     binary_search_i64(sorted, 9).unwrap() == 9 and
     binary_search_i64(sorted, 10).is_none() and
     binary_search_i64(sorted, 0 - 1).is_none() and
     binary_search_i64(empty, 0).is_none() and
     checksum_i64(sorted) == 45 {
    0
  } else {
    1
  }
}
