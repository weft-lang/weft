-- Vector-backed algorithms: insertion sort plus binary search.
-- Benchmark: mutable contiguous storage, nested loops, bounds checks, search.

use "stdlib/vector.weft"

fn insertion_sort_i64(items: i64) -> i64 {
  let len = vector_len(items)
  let mut i = 1
  while i < len {
    let key = vector_get<i64>(items, i, 0)
    let mut j = i - 1
    let mut moving = 1
    while moving == 1 {
      if j >= 0 and vector_get<i64>(items, j, 0) > key {
        vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0))
        j = j - 1
      } else {
        moving = 0
      }
    }
    vector_set<i64>(items, j + 1, key)
    i = i + 1
  }
  items
}

fn binary_search_i64(items: i64, needle: i64) -> i64 {
  let mut lo = 0
  let mut hi = vector_len(items)
  let mut found = 0 - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let value = vector_get<i64>(items, mid, 0)
    if value == needle {
      found = mid
      lo = hi
    } else {
      if value < needle {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
  }
  found
}

fn checksum_i64(items: i64) -> i64 {
  vector_fold<i64, i64>(items, 0, (acc: i64, x: i64) => acc + x)
}

fn main() -> i64 {
  let items = vector_with_capacity<i64>(10)
  vector_push<i64>(items, 5)
  vector_push<i64>(items, 3)
  vector_push<i64>(items, 8)
  vector_push<i64>(items, 1)
  vector_push<i64>(items, 9)
  vector_push<i64>(items, 2)
  vector_push<i64>(items, 7)
  vector_push<i64>(items, 4)
  vector_push<i64>(items, 6)
  vector_push<i64>(items, 0)
  insertion_sort_i64(items)
  if vector_get<i64>(items, 0, 0 - 1) == 0 and
     vector_get<i64>(items, 9, 0 - 1) == 9 and
     binary_search_i64(items, 7) == 7 and
     checksum_i64(items) == 45 {
    0
  } else {
    1
  }
}
