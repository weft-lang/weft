-- Record-vector workload: idiomatic Vector<Record> storage and field access.
-- Benchmark: inline record payloads without raw memory or struct-of-arrays.

use stdlib/option.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

type Particle { x: i64, y: i64, vx: i64, vy: i64, mass: i64 }

fn make_particle(i: i64) -> Particle {
  Particle {
    x: i,
    y: i * 2,
    vx: i - i / 3 * 3 + 1,
    vy: i - i / 5 * 5 + 2,
    mass: i - i / 7 * 7 + 1
  }
}

fn particle_score(p: Particle) -> i64 {
  p.x + p.y + p.vx * 3 + p.vy * 5 + p.mass * 7
}

fn update_particles(particles: Vector<Particle>, steps: i64) -> Vector<Particle> {
  let len = particles.len()
  for step in 0..steps {
    for i in 0..len {
      let p = particles.get(i).expect("particle index is in bounds")
      let next = Particle {
        x: p.x + p.vx + step - step / 2 * 2,
        y: p.y + p.vy,
        vx: p.vx,
        vy: p.vy,
        mass: p.mass
      }
      particles.set(i, next)
    }
  }
  particles
}

fn checksum_particles(particles: Vector<Particle>) -> i64 {
  let len = particles.len()
  let mut sum = 0
  for i in 0..len {
    sum = sum + particle_score(particles.get(i).expect("particle index is in bounds"))
  }
  sum
}

fn main() -> i64 {
  let particles = vector.with_capacity<Particle>(128)
  for i in 0..128 {
    particles.push(make_particle(i))
  }
  update_particles(particles, 16)
  let checksum = checksum_particles(particles)
  if particles.len() == 128 and
     vector_element_size<Particle>(particles) == 40 and
     checksum == 44491 {
    0
  } else {
    1
  }
}
