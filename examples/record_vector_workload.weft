-- Record-vector workload: idiomatic Vector<Record> storage and field access.
-- Benchmark: inline record payloads without raw memory or struct-of-arrays.

use stdlib/option.{Option}
use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/result.{Result}

type Particle { x: i64, y: i64, vx: i64, vy: i64, mass: i64 }

fn make_particle(i: i64) -> Particle {
  Particle {
    x: i,
    y: i * 2,
    vx: i % 3 + 1,
    vy: i % 5 + 2,
    mass: i % 7 + 1
  }
}

fn particle_score(p: Particle) -> i64 {
  p.x + p.y + p.vx * 3 + p.vy * 5 + p.mass * 7
}

fn update_particles(particles: borrow mut Vector<Particle>, steps: i64) -> nil {
  let len = particles.len()
  let zero: usize = 0
  for step in 0..steps {
    for i in zero..len {
      let p = particles.get(i).expect("particle index is in bounds")
      let next = p.{x: p.x + p.vx + step % 2, y: p.y + p.vy}
      particles.set(i, next).expect("particle index is in bounds")
    }
  }
}

fn checksum_particles(particles: borrow Vector<Particle>) -> i64 {
  particles.fold(0, (sum: i64, particle: Particle) => sum + particle_score(particle))
}

fn main() -> i64 {
  let mut particles = vector.with_capacity<Particle>(128)
  for i in 0..128 {
    particles.push(make_particle(i))
  }
  update_particles(particles, 16)
  let checksum = checksum_particles(particles)
  if particles.len() == 128 and
     checksum == 44491 {
    0
  } else {
    1
  }
}
