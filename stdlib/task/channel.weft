-- stdlib/task/channel.weft -- bounded effectful channels with exact close outcomes

use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Result, Err, Ok}
use stdlib/vector as vector
use stdlib/vector.{vector_clear, vector_len, vector_push, vector_remove_at, vector_set}
use stdlib/vector/handles.{Vector}

--- A validated nonzero bound for one channel's buffered values.
pub type Capacity = opaque i64

--- A typed failure to construct a bounded channel capacity.
pub type CapacityError {
  --- Zero cannot provide a buffered backpressure boundary.
  CapacityZero,
    --- The requested platform-sized count cannot fit the runtime index domain.
    CapacityTooLarge
}

--- The exact result of publishing one value.
pub type SendResult<T: Sendable> {
  --- The channel accepted the value.
  SendAccepted,
    --- The channel was closed and returns the unconsumed value to its owner.
    SendClosed(T)
}

--- The exact result of receiving from a channel.
pub type ReceiveResult<T: Sendable> {
  --- One buffered value was received.
  Received(T),
    --- The channel is closed and every accepted value has been drained.
    Drained
}

--- The exact result of closing a channel.
pub type CloseResult {
  --- This operation performed the first close transition.
  ClosedNow,
    --- The channel had already been closed.
    AlreadyClosed
}

--- One scoped bounded publication capability for `T`.
---
--- Distinct element types are distinct effect atoms. Nested handlers provide
--- distinct nearest scopes for the same atom; no first-class channel handle
--- can escape its owning handler.
pub effect Channel<T: Sendable> {
  --- Publish one value or return it when the scope is closed.
  fn send(value: T) -> SendResult<T>
    --- Receive one accepted value or report a closed, drained scope.
    fn receive() -> ReceiveResult<T>
    --- Close the scope idempotently and wake every suspended operation.
    fn close() -> CloseResult
}

--- Validate a nonzero bounded channel capacity.
pub fn capacity(value: usize) -> Result<Capacity, CapacityError> {
  match value.to_u64().to_i64_checked() {
    Err(_) -> Err<Capacity, CapacityError>(CapacityTooLarge)
    Ok(0) -> Err<Capacity, CapacityError>(CapacityZero)
    Ok(size) -> Ok<Capacity, CapacityError>(Capacity(size))
  }
}

-- The handler-owned state contains the fixed buffer and a one-word close
-- slot. Waiters live in structured task records, never in an unbounded side
-- queue. The buffer cannot grow because offers are admitted only below the
-- validated capacity.
pub (package) type ChannelState<T: Sendable> {
  ChannelStateDisabled,
    ChannelState(i64, Vector<T>, Vector<i64>)
}

pub (package) fn channel_capacity_value(capacity: Capacity) -> i64 {
  match capacity {
    Capacity(value) -> value
  }
}

pub (package) fn channel_state_new<T: Sendable>(capacity: i64) -> ChannelState<T> {
  let values = vector.with_capacity<T>(capacity.to_usize_checked().expect("channel capacity is validated"))
  let mut closed = vector.with_capacity<i64>(1)
  closed.push(0)
  ChannelState<T>(capacity, values, closed)
}

pub (package) fn channel_state_disabled<T: Sendable>() -> ChannelState<T> {
  ChannelStateDisabled<T>()
}

-- Drop every value still buffered when the enclosing structured handler exits.
-- This is a semantic cleanup boundary, not a scheduler policy: normal return,
-- cancellation, and outward abort all use the same operation.
pub(package) fn channel_state_cleanup<T: Sendable>(state: ChannelState<T>) -> nil {
  match state {
    ChannelStateDisabled -> nil
    ChannelState(capacity, values, closed) -> vector_clear<T>(values)
  }
}

pub (package) fn channel_state_is_closed<T: Sendable>(state: ChannelState<T>) -> bool {
  match state {
    ChannelStateDisabled -> true
    ChannelState(capacity, values, closed) -> match closed.get(0) {
      Some(value) -> value != 0
      None -> true
    }
  }
}

pub (package) fn channel_state_is_full<T: Sendable>(state: ChannelState<T>) -> bool {
  match state {
    ChannelStateDisabled -> true
    ChannelState(capacity, values, closed) -> vector_len<T>(values) >= capacity
  }
}

pub (package) fn channel_state_is_empty<T: Sendable>(state: ChannelState<T>) -> bool {
  match state {
    ChannelStateDisabled -> true
    ChannelState(capacity, values, closed) -> values.is_empty()
  }
}

pub (package) fn channel_state_offer<T: Sendable>(state: ChannelState<T>, value: T) -> i64 {
  match state {
    ChannelStateDisabled -> 0
    ChannelState(capacity, values, closed) -> {
      if channel_state_is_closed<T>(state) or vector_len<T>(values) >= capacity { 0 }
      else {
        vector_push<T>(values, value)
        1
      }
    }
  }
}

pub (package) fn channel_state_take<T: Sendable>(state: ChannelState<T>) -> Option<T> {
  match state {
    ChannelStateDisabled -> None<T>()
    ChannelState(capacity, values, closed) -> vector_remove_at<T>(values, 0)
  }
}

pub (package) fn channel_state_close<T: Sendable>(state: ChannelState<T>) -> CloseResult {
  match state {
    ChannelStateDisabled -> AlreadyClosed
    ChannelState(capacity, values, closed) -> {
      if channel_state_is_closed<T>(state) { AlreadyClosed }
      else {
        vector_set<i64>(closed, 0, 1)
        ClosedNow
      }
    }
  }
}
