-- stdlib/eq.weft — Eq trait for equality comparison
--
-- Eq provides structural equality. Implement for types that support ==.

--- Structural equality producing a boolean result.
pub trait Eq {
  --- Return whether this value equals `other`.
  fn eq(self, other: Self) -> bool
}

impl Eq for i64 {
  fn eq(self: Self, other: Self) -> bool {
    self == other
  }
}

impl Eq for bool {
  fn eq(self: Self, other: Self) -> bool {
    self == other
  }
}

impl Eq for str {
  fn eq(self: Self, other: Self) -> bool {
    self == other
  }
}
