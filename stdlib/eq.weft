-- stdlib/eq.weft — Eq trait for equality comparison
--
-- Eq provides structural equality. Implement for types that support ==.
-- Returns true (1) or false (0).

trait Eq {
  fn eq(self: i64, other: i64) -> i64
}

impl Eq for i64 {
  fn eq(self: i64, other: i64) -> i64 {
    if self == other { true } else { false }
  }
}

impl Eq for bool {
  fn eq(self: i64, other: i64) -> i64 {
    if self == other { true } else { false }
  }
}
