-- stdlib/continuation.weft -- explicit owner cells for stored continuations

use "runtime/alloc.weft"
use "runtime/rc.weft"
use "stdlib/unsafe.weft"

type ContinuationCell {
  ContinuationCell(i64)
}

fn continuation_cell_new() -> ContinuationCell {
  let ptr = alloc_bump(8)
  __mem_store64(ptr, 0)
  ContinuationCell(ptr)
}

fn continuation_cell_ptr(cell: ContinuationCell) -> i64 {
  match cell {
    ContinuationCell(ptr) -> ptr
  }
}

fn continuation_cell_is_full(cell: ContinuationCell) -> i64 {
  if __mem_load64(continuation_cell_ptr(cell)) == 0 { 0 } else { 1 }
}

fn continuation_cell_store_i64(cell: ContinuationCell, k: Continuation<i64, i64>) -> i64 {
  handle continuation_cell_store_i64_raw(continuation_cell_ptr(cell), k) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(0)
  }
}

fn continuation_cell_resume_i64(cell: ContinuationCell, value: i64, default: i64) -> i64 {
  handle continuation_cell_resume_i64_raw(continuation_cell_ptr(cell), value, default) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(0)
  }
}

fn continuation_cell_drop_i64(cell: ContinuationCell) -> i64 {
  continuation_cell_drop_i64_raw(continuation_cell_ptr(cell))
}
