-- stdlib/continuation.weft -- explicit owner cells for stored continuations

use runtime/rc.{*}

pub type ContinuationCell {
  ContinuationCell(i64)
}

pub fn continuation_cell_new() -> ContinuationCell {
  ContinuationCell(runtime_continuation_cell_new())
}

pub fn continuation_cell_from_ptr(ptr: i64) -> ContinuationCell {
  ContinuationCell(ptr)
}

pub fn continuation_cell_ptr(cell: ContinuationCell) -> i64 {
  match cell {
    ContinuationCell(ptr) -> ptr
  }
}

pub fn continuation_cell_is_full(cell: ContinuationCell) -> i64 {
  runtime_continuation_cell_is_full(continuation_cell_ptr(cell))
}

pub fn continuation_cell_store_i64(cell: ContinuationCell, k: Continuation<i64, i64>) -> i64 {
  runtime_continuation_cell_store_i64(continuation_cell_ptr(cell), k)
}

pub fn continuation_cell_resume_i64(cell: ContinuationCell, value: i64, default: i64) -> i64 {
  runtime_continuation_cell_resume_i64(continuation_cell_ptr(cell), value, default)
}

pub fn continuation_cell_drop_i64(cell: ContinuationCell) -> i64 {
  runtime_continuation_cell_drop_i64(continuation_cell_ptr(cell))
}
