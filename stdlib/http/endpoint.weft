-- stdlib/http/endpoint.weft — distinct HTTP client and server authorities
--
-- Client authority can establish outbound HTTPS exchanges; server authority
-- can listen and accept inbound HTTPS exchanges. Both return the same owned
-- body stream and consume the same pure HTTP message semantics. Established
-- body I/O is a separate capability from opening either direction.

use stdlib/bytes.{Bytes}
use stdlib/dns as dns
use stdlib/dns.{DnsAnyFamily, DnsError, DnsResolve}
use stdlib/drop.{Drop}
use stdlib/http as http
use stdlib/http.{HttpBodyFraming, HttpConnectionClose, HttpConnectionPersistent, HttpConnectionReuse, HttpLimits, HttpMethod, HttpParseError, HttpProtocolSwitch, HttpRequestHead, HttpRequestHeadFailed, HttpRequestHeadNeedMore, HttpRequestHeadReady, HttpResponseHead, HttpResponseHeadFailed, HttpResponseHeadNeedMore, HttpResponseHeadReady}
use stdlib/http/stream.{HttpBodyError, HttpBodyIO, HttpBodyStream, HttpConnection, HttpConnectionClientOrigin, HttpConnectionReceive, HttpConnectionReceiveFailed, HttpConnectionReceived, HttpConnectionPeerClosed, HttpConnectionServerPeer, HttpConnectionSnapshot, HttpConnectionSnapshotted, HttpConnectionWrite, HttpConnectionWriteFailed, HttpConnectionWritten, http_body_cancel_direct, http_body_close_connection_direct, http_body_connection_advance, http_body_connection_receive, http_body_finish_direct, http_body_read_direct, http_body_reader_open, http_body_write_direct, http_body_write_wire, http_body_writer_open, http_connection_disallow_reuse, http_connection_from_tls, http_connection_has_client_origin, http_connection_is_reusable, http_connection_matches_origin, http_connection_snapshot}
use stdlib/http/transport.{HttpTransportIO, HttpTransportRelease, http_transport_tls_close_direct, http_transport_tls_read_direct, http_transport_tls_release_direct, http_transport_tls_write_direct}
use stdlib/net_address.{IpV4, IpV6, SocketAddress}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random.{SecureRandom}
use stdlib/tcp as tcp
use stdlib/tcp.{TcpConnect, TcpConnectOptions, TcpError, TcpListen, TcpListenOptions, TcpListener, TcpListenerIO, TcpListenerReadinessFailed, TcpListenerReady, TcpReadiness, TcpReadinessError, TcpResourceExhausted, TcpStream, TcpStreamIO, tcp_error_from_platform_status}
use stdlib/time.{Time}
use stdlib/tls.{TlsError, TlsSession, tls_client_open, tls_server_open}
use stdlib/tls/stream.{TlsStream, TlsStreamError, TlsStreamHandshakeFailed, TlsStreamHandshakeReady, tls_stream_handshake}
use stdlib/url.{Url, UrlDomain, UrlHost, UrlHttp, UrlHttps, UrlIpv4, UrlIpv6, UrlScheme, UrlWs, UrlWss}
use stdlib/vector.{vector_get_in_bounds, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- A failure while opening or advancing one HTTP exchange.
pub type HttpExchangeError {
  --- The selected handler does not implement this URL scheme.
  HttpExchangeUnsupportedScheme(UrlScheme),
    --- Canonical host resolution failed.
    HttpExchangeDns(DnsError),
    --- No resolved candidate could establish TCP.
    HttpExchangeTcp(TcpError),
    --- TCP readiness failed before an inbound accept.
    HttpExchangeReadiness(TcpReadinessError),
    --- TLS session construction failed.
    HttpExchangeTls(TlsError),
    --- The owned TLS-over-TCP transition failed.
    HttpExchangeTlsStream(TlsStreamError),
    --- HTTP head or framing validation failed.
    HttpExchangeProtocol(HttpParseError),
    --- Body-stream construction or transport failed.
    HttpExchangeBody(HttpBodyError),
    --- The peer closed before a complete HTTP head arrived.
    HttpExchangeUnexpectedEof,
    --- A reusable connection did not belong to the requested URL origin.
    HttpExchangeConnectionOrigin,
    --- A connection marked for closure was offered for another request.
    HttpExchangeConnectionNotReusable,
    --- A protocol-upgrade operation received ordinary HTTP body framing.
    HttpExchangeExpectedProtocolSwitch(HttpBodyFraming)
}

--- An outbound request body ready for incremental writes.
pub type HttpClientBegin<S> {
  --- The request head was sent and the body owner is ready.
  HttpClientRequestReady(owned HttpBodyStream<S>),
    --- The exchange failed before returning a body owner.
    HttpClientRequestFailed(HttpExchangeError)
}

--- A complete response head joined to its inbound body owner.
pub type HttpClientResponse<S> {
  --- The response head and bounded body stream are ready.
  HttpClientResponseReady(HttpResponseHead, owned HttpBodyStream<S>),
    --- The response failed and consumed the unusable connection.
    HttpClientResponseFailed(HttpExchangeError)
}

--- A validated switching response joined to its raw transport connection.
pub type HttpClientUpgrade<S> {
  --- The response switched protocols and returned the exact connection owner.
  HttpClientUpgradeReady(HttpResponseHead, owned HttpConnection<S>),
    --- Response parsing or protocol selection failed and consumed the connection.
    HttpClientUpgradeFailed(HttpExchangeError)
}

--- An owned listening endpoint interpreted by `HttpServer`.
pub type HttpServerListener = opaque owned TcpListener

impl Drop for HttpServerListener {
  fn drop(self) -[TcpListenerIO]> i64 {
    match self { HttpServerListener(listener) -> listener.drop() }
  }
}

--- Completion of one inbound listener creation.
pub type HttpServerListen {
  --- The server listener and its actual bound numeric endpoint are ready.
  --- The address is especially useful when binding an ephemeral port.
  HttpServerListening(owned HttpServerListener, SocketAddress),
    --- The listener could not be created.
    HttpServerListenFailed(HttpExchangeError)
}

--- One accepted request while preserving the listener owner.
pub type HttpServerAccept {
  --- The listener, validated request head, and request body owner.
  HttpServerRequestReady(owned HttpServerListener, HttpRequestHead, owned HttpBodyStream<TlsStream>),
    --- Accept or protocol setup failed and returned the listener.
    HttpServerAcceptFailed(owned HttpServerListener, HttpExchangeError)
}

--- One subsequent request on an established persistent server connection.
pub type HttpServerRequest {
  --- The validated request head and its inbound body owner.
  HttpServerPersistentRequestReady(HttpRequestHead, owned HttpBodyStream<TlsStream>),
    --- The persistent connection was consumed after setup or parsing failed.
    HttpServerPersistentRequestFailed(HttpExchangeError)
}

--- An outbound response body ready for incremental writes.
pub type HttpServerRespond {
  --- The response head was sent and the body owner is ready.
  HttpServerResponseReady(owned HttpBodyStream<TlsStream>),
    --- The response failed and consumed the unusable connection.
    HttpServerResponseFailed(HttpExchangeError)
}

--- Completion of one switching response on an established server connection.
pub type HttpServerUpgrade {
  --- The switching head was sent and the raw connection is ready.
  HttpServerUpgradeReady(owned HttpConnection<TlsStream>),
    --- Validation or transport failed and consumed the connection.
    HttpServerUpgradeFailed(HttpExchangeError)
}

--- Authority to establish and advance outbound HTTP client exchanges.
pub effect HttpClient<S> {
  --- Connect, authenticate, send one request head, and return its body writer.
  fn begin(url: Url, request: HttpRequestHead, limits: HttpLimits) -> HttpClientBegin<S>
  --- Send a request over a returned idle connection of the same origin.
  fn reuse(
    url: Url,
    connection: owned HttpConnection<S>,
    request: HttpRequestHead,
    limits: HttpLimits
  ) -> HttpClientBegin<S>
  --- Read and validate the response head after the request body completes.
  fn response(
    connection: owned HttpConnection<S>,
    request_method: HttpMethod,
    limits: HttpLimits
  ) -> HttpClientResponse<S>
  --- Read a response head and require an HTTP protocol switch.
  fn upgrade(
    connection: owned HttpConnection<S>,
    request_method: HttpMethod,
    limits: HttpLimits
  ) -> HttpClientUpgrade<S>
}

--- Authority to listen for and advance inbound HTTP server exchanges.
pub effect HttpServer {
  --- Bind one server listener.
  fn listen(address: SocketAddress, options: TcpListenOptions) -> HttpServerListen
  --- Accept, authenticate, and parse one request head.
  fn accept(listener: owned HttpServerListener, limits: HttpLimits) -> HttpServerAccept
  --- Parse the next request on a returned persistent server connection.
  fn request(connection: owned HttpConnection<TlsStream>, limits: HttpLimits) -> HttpServerRequest
  --- Send one validated response head and return its body writer.
  fn respond(
    connection: owned HttpConnection<TlsStream>,
    response: HttpResponseHead,
    limits: HttpLimits
  ) -> HttpServerRespond
  --- Send one protocol-switching response and return the raw connection.
  fn upgrade(
    connection: owned HttpConnection<TlsStream>,
    response: HttpResponseHead
  ) -> HttpServerUpgrade
}

fn http_endpoint_listener(listener: owned TcpListener) -[TcpListenerIO]> owned HttpServerListener {
  HttpServerListener(listener)
}

fn http_endpoint_drop_connection<S>(
  connection: owned HttpConnection<S>
) -[HttpTransportRelease<S>]> i64 {
  connection.drop()
}

fn http_endpoint_drop_stream(stream: owned TlsStream) -[TcpStreamIO]> i64 {
  stream.drop()
}

fn http_endpoint_client_candidates(
  url: Url
) -[DnsResolve]> Result<Vector<SocketAddress>, DnsError> {
  let port = url.effective_port()
  match url.host() {
    UrlDomain(name) -> dns.resolve(name, port, DnsAnyFamily)
    UrlIpv4(address) -> dns.numeric_candidates(IpV4(address), port, DnsAnyFamily)
    UrlIpv6(address) -> dns.numeric_candidates(IpV6(address), port, DnsAnyFamily)
  }
}

fn http_endpoint_connect_candidates(
  candidates: Vector<SocketAddress>,
  options: TcpConnectOptions
) -[TcpConnect]> Result<owned TcpStream, HttpExchangeError> {
  let mut index = 0
  let mut last = TcpResourceExhausted
  while index < candidates.len() {
    match tcp.connect(vector_get_in_bounds<SocketAddress>(candidates, index), options) {
      Ok(stream) -> return Ok<owned TcpStream, HttpExchangeError>(stream)
      Err(error) -> { last = error }
    }
    index = index + 1
  }
  Err<owned TcpStream, HttpExchangeError>(HttpExchangeTcp(last))
}

fn http_endpoint_handshake(
  transport: owned TcpStream,
  session: owned TlsSession
) -[TcpReadiness, TcpStreamIO]> Result<owned TlsStream, HttpExchangeError> {
  match tls_stream_handshake(transport, session) {
    TlsStreamHandshakeReady(stream) -> Ok<owned TlsStream, HttpExchangeError>(stream)
    TlsStreamHandshakeFailed(stream, error) -> {
      http_endpoint_drop_stream(stream)
      Err<owned TlsStream, HttpExchangeError>(HttpExchangeTlsStream(error))
    }
  }
}

fn http_endpoint_apply_reuse<S>(
  connection: owned HttpConnection<S>,
  reuse: HttpConnectionReuse
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  match reuse {
    HttpConnectionPersistent -> connection
    HttpConnectionClose -> http_connection_disallow_reuse(connection)
  }
}

type HttpRequestConnectionHead<S> {
  HttpRequestConnectionReady(owned HttpConnection<S>, HttpRequestHead),
    HttpRequestConnectionFailed(HttpExchangeError)
}

type HttpResponseConnectionHead<S> {
  HttpResponseConnectionReady(owned HttpConnection<S>, HttpResponseHead),
    HttpResponseConnectionFailed(HttpExchangeError)
}

fn http_endpoint_request_head<S>(
  connection: owned HttpConnection<S>,
  limits: HttpLimits
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpRequestConnectionHead<S> {
  let mut current: owned HttpConnection<S> = connection
  loop {
    match http_connection_snapshot(current) {
      HttpConnectionSnapshotted(returned, bytes) -> {
        let source = bytes.to_vector()
        match http.parse_request_head(source[..], limits) {
          HttpRequestHeadFailed(error) -> {
            http_endpoint_drop_connection(returned)
            break (HttpRequestConnectionFailed(HttpExchangeProtocol(error)))
          }
          HttpRequestHeadReady(head, framing, consumed) -> {
            let advanced = http_body_connection_advance(returned, __u64_to_i64(__usize_to_u64(consumed)))
            break (HttpRequestConnectionReady(
              http_endpoint_apply_reuse(advanced, head.connection()),
              head
            ))
          }
          HttpRequestHeadNeedMore -> match http_body_connection_receive(returned, 16384) {
            HttpConnectionReceived(connection) -> { current = connection }
            HttpConnectionPeerClosed(connection) -> {
              http_endpoint_drop_connection(connection)
              break (HttpRequestConnectionFailed(HttpExchangeUnexpectedEof))
            }
            HttpConnectionReceiveFailed(connection, error) -> {
              http_endpoint_drop_connection(connection)
              break (HttpRequestConnectionFailed(HttpExchangeBody(error)))
            }
          }
        }
      }
    }
  }
}

fn http_endpoint_response_head<S>(
  connection: owned HttpConnection<S>,
  request_method: HttpMethod,
  limits: HttpLimits
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpResponseConnectionHead<S> {
  let mut current: owned HttpConnection<S> = connection
  loop {
    match http_connection_snapshot(current) {
      HttpConnectionSnapshotted(returned, bytes) -> {
        let source = bytes.to_vector()
        match http.parse_response_head(source[..], request_method, limits) {
          HttpResponseHeadFailed(error) -> {
            http_endpoint_drop_connection(returned)
            break (HttpResponseConnectionFailed(HttpExchangeProtocol(error)))
          }
          HttpResponseHeadReady(head, framing, consumed) -> {
            let advanced = http_body_connection_advance(returned, __u64_to_i64(__usize_to_u64(consumed)))
            break (HttpResponseConnectionReady(
              http_endpoint_apply_reuse(advanced, head.connection()),
              head
            ))
          }
          HttpResponseHeadNeedMore -> match http_body_connection_receive(returned, 16384) {
            HttpConnectionReceived(connection) -> { current = connection }
            HttpConnectionPeerClosed(connection) -> {
              http_endpoint_drop_connection(connection)
              break (HttpResponseConnectionFailed(HttpExchangeUnexpectedEof))
            }
            HttpConnectionReceiveFailed(connection, error) -> {
              http_endpoint_drop_connection(connection)
              break (HttpResponseConnectionFailed(HttpExchangeBody(error)))
            }
          }
        }
      }
    }
  }
}

fn http_client_begin_tls(
  trust_roots: Bytes,
  url: Url,
  request: HttpRequestHead,
  limits: HttpLimits
) -[DnsResolve, HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>, SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, Time]> HttpClientBegin<TlsStream> {
  match url.scheme() {
    UrlHttps -> match http_endpoint_client_candidates(url) {
      Err(error) -> HttpClientRequestFailed(HttpExchangeDns(error))
      Ok(candidates) -> match http_endpoint_connect_candidates(candidates, tcp.connect_options()) {
        Err(error) -> HttpClientRequestFailed(error)
        Ok(transport) -> match tls_client_open(url.host(), trust_roots) {
          Err(error) -> HttpClientRequestFailed(HttpExchangeTls(error))
          Ok(session) -> match http_endpoint_handshake(transport, session) {
            Err(error) -> HttpClientRequestFailed(error)
            Ok(stream) -> {
              let connection = http_connection_from_tls(
                stream,
                vector_with_capacity<u8>(0),
                0,
                HttpConnectionPersistent,
                HttpConnectionClientOrigin(url.origin())
              )
              http_client_reuse_transport<TlsStream>(url, connection, request, limits)
            }
          }
        }
      }
    }
    scheme -> HttpClientRequestFailed(HttpExchangeUnsupportedScheme(scheme))
  }
}

pub(package) fn http_client_reuse_transport<S>(
  url: Url,
  connection: owned HttpConnection<S>,
  request: HttpRequestHead,
  limits: HttpLimits
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpClientBegin<S> {
  if not http_connection_matches_origin(connection, url.origin()) {
    http_endpoint_drop_connection(connection)
    HttpClientRequestFailed(HttpExchangeConnectionOrigin)
  } else { if not http_connection_is_reusable(connection) {
      http_endpoint_drop_connection(connection)
      HttpClientRequestFailed(HttpExchangeConnectionNotReusable)
    } else {
      let selected = http_endpoint_apply_reuse(connection, request.connection())
      match http_body_write_wire(selected, request.encode()) {
        HttpConnectionWriteFailed(failed, error) -> {
          http_endpoint_drop_connection(failed)
          HttpClientRequestFailed(HttpExchangeBody(error))
        }
        HttpConnectionWritten(ready) -> match http_body_writer_open(
          ready,
          request.body_framing(),
          limits,
          false
        ) {
          Err(error) -> HttpClientRequestFailed(HttpExchangeBody(error))
          Ok(body) -> HttpClientRequestReady(body)
        }
      }
    } }
}

pub(package) fn http_client_response_transport<S>(
  connection: owned HttpConnection<S>,
  request_method: HttpMethod,
  limits: HttpLimits
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpClientResponse<S> {
  match http_endpoint_response_head(connection, request_method, limits) {
    HttpResponseConnectionFailed(error) -> HttpClientResponseFailed(error)
    HttpResponseConnectionReady(ready, head) -> match http_body_reader_open(
      ready,
      head.body_framing(),
      limits,
      false
    ) {
      Err(error) -> HttpClientResponseFailed(HttpExchangeBody(error))
      Ok(body) -> HttpClientResponseReady(head, body)
    }
  }
}

pub(package) fn http_client_upgrade_transport<S>(
  connection: owned HttpConnection<S>,
  request_method: HttpMethod,
  limits: HttpLimits
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpClientUpgrade<S> {
  match http_endpoint_response_head(connection, request_method, limits) {
    HttpResponseConnectionFailed(error) -> HttpClientUpgradeFailed(error)
    HttpResponseConnectionReady(ready, head) -> match head.body_framing() {
      HttpProtocolSwitch -> HttpClientUpgradeReady(
        head,
        http_connection_disallow_reuse(ready)
      )
      framing -> {
        http_endpoint_drop_connection(ready)
        HttpClientUpgradeFailed(HttpExchangeExpectedProtocolSwitch(framing))
      }
    }
  }
}

fn http_server_listen_tls(
  address: SocketAddress,
  options: TcpListenOptions
) -[TcpListen, TcpListenerIO]> HttpServerListen {
  match tcp.listen(address, options) {
    Err(error) -> HttpServerListenFailed(HttpExchangeTcp(error))
    Ok(listener) -> match listener.local_address() {
      Err(error) -> {
        let dropped = listener.drop()
        HttpServerListenFailed(HttpExchangeTcp(error))
      }
      Ok(bound) -> HttpServerListening(http_endpoint_listener(listener), bound)
    }
  }
}

fn http_server_accept_tls(
  certificate: Bytes,
  private_key: Bytes,
  listener: owned HttpServerListener,
  limits: HttpLimits
) -[HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>, SecureRandom, TcpListenerIO, TcpReadiness, TcpStreamIO]> HttpServerAccept {
  match listener {
    HttpServerListener(raw_listener) -> match raw_listener.wait_acceptable() {
      TcpListenerReadinessFailed(returned, error) -> HttpServerAcceptFailed(
        http_endpoint_listener(returned),
        HttpExchangeReadiness(error)
      )
      TcpListenerReady(returned) -> {
        let mut ready: owned TcpListener = returned
        match ready.accept() {
          Err(error) -> HttpServerAcceptFailed(
            http_endpoint_listener(ready),
            HttpExchangeTcp(error)
          )
          Ok(transport) -> match tls_server_open(certificate, private_key) {
            Err(error) -> HttpServerAcceptFailed(
              http_endpoint_listener(ready),
              HttpExchangeTls(error)
            )
            Ok(session) -> match http_endpoint_handshake(transport, session) {
              Err(error) -> HttpServerAcceptFailed(http_endpoint_listener(ready), error)
              Ok(stream) -> {
                let connection = http_connection_from_tls(
                  stream,
                  vector_with_capacity<u8>(0),
                  0,
                  HttpConnectionPersistent,
                  HttpConnectionServerPeer
                )
                match http_endpoint_request_head(connection, limits) {
                  HttpRequestConnectionFailed(error) -> HttpServerAcceptFailed(
                    http_endpoint_listener(ready),
                    error
                  )
                  HttpRequestConnectionReady(request_connection, head) -> match http_body_reader_open(
                    request_connection,
                    head.body_framing(),
                    limits,
                    false
                  ) {
                    Err(error) -> HttpServerAcceptFailed(
                      http_endpoint_listener(ready),
                      HttpExchangeBody(error)
                    )
                    Ok(body) -> HttpServerRequestReady(http_endpoint_listener(ready), head, body)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn http_server_request_tls(
  connection: owned HttpConnection<TlsStream>,
  limits: HttpLimits
) -[HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>]> HttpServerRequest {
  if http_connection_has_client_origin(connection) {
    http_endpoint_drop_connection(connection)
    HttpServerPersistentRequestFailed(HttpExchangeConnectionOrigin)
  } else { if not http_connection_is_reusable(connection) {
      http_endpoint_drop_connection(connection)
      HttpServerPersistentRequestFailed(HttpExchangeConnectionNotReusable)
    } else { match http_endpoint_request_head(connection, limits) {
    HttpRequestConnectionFailed(error) -> HttpServerPersistentRequestFailed(error)
    HttpRequestConnectionReady(request_connection, head) -> match http_body_reader_open(
      request_connection,
      head.body_framing(),
      limits,
      false
    ) {
      Err(error) -> HttpServerPersistentRequestFailed(HttpExchangeBody(error))
      Ok(body) -> HttpServerPersistentRequestReady(head, body)
    }
  } } }
}

fn http_server_respond_tls(
  connection: owned HttpConnection<TlsStream>,
  response: HttpResponseHead,
  limits: HttpLimits
) -[HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>]> HttpServerRespond {
  let selected = http_endpoint_apply_reuse(connection, response.connection())
  match http_body_write_wire(selected, response.encode()) {
    HttpConnectionWriteFailed(failed, error) -> {
      http_endpoint_drop_connection(failed)
      HttpServerResponseFailed(HttpExchangeBody(error))
    }
    HttpConnectionWritten(ready) -> match http_body_writer_open(
      ready,
      response.body_framing(),
      limits,
      false
    ) {
      Err(error) -> HttpServerResponseFailed(HttpExchangeBody(error))
      Ok(body) -> HttpServerResponseReady(body)
    }
  }
}

fn http_server_upgrade_tls(
  connection: owned HttpConnection<TlsStream>,
  response: HttpResponseHead
) -[HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>]> HttpServerUpgrade {
  match response.body_framing() {
    HttpProtocolSwitch -> match http_body_write_wire(
      http_connection_disallow_reuse(connection),
      response.encode()
    ) {
      HttpConnectionWriteFailed(failed, error) -> {
        http_endpoint_drop_connection(failed)
        HttpServerUpgradeFailed(HttpExchangeBody(error))
      }
      HttpConnectionWritten(ready) -> HttpServerUpgradeReady(ready)
    }
    framing -> {
      http_endpoint_drop_connection(connection)
      HttpServerUpgradeFailed(HttpExchangeExpectedProtocolSwitch(framing))
    }
  }
}

impl HttpServerListener {
  --- Close and consume this listener.
  pub fn close(self: owned HttpServerListener) -[TcpListenerIO]> Result<nil, TcpError> {
    let status = self.drop()
    if status == 0 { Ok<nil, TcpError>(nil) }
    else { Err<nil, TcpError>(tcp_error_from_platform_status(status)) }
  }
}

--- Interpret `HttpClient` and `HttpBodyIO` through validating outbound TLS.
pub fn http_client_with_tls<T, E>(
  trust_roots: Bytes,
  body: () -[HttpClient<TlsStream>, HttpBodyIO<TlsStream>, HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>, E]> T
) -[DnsResolve, SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, Time, E]> T {
  handle {
    handle {
      handle {
        handle body() {
          HttpClient<TlsStream>.begin(url, request, limits) -> resume(http_client_begin_tls(trust_roots, url, request, limits))
          HttpClient<TlsStream>.reuse(url, connection, request, limits) -> resume(http_client_reuse_transport<TlsStream>(url, connection, request, limits))
          HttpClient<TlsStream>.response(connection, request_method, limits) -> resume(http_client_response_transport<TlsStream>(connection, request_method, limits))
          HttpClient<TlsStream>.upgrade(connection, request_method, limits) -> resume(http_client_upgrade_transport<TlsStream>(connection, request_method, limits))
        }
      } {
        HttpBodyIO<TlsStream>.read(stream, limit) -> resume(http_body_read_direct<TlsStream>(stream, limit))
        HttpBodyIO<TlsStream>.write(stream, data) -> resume(http_body_write_direct<TlsStream>(stream, data))
        HttpBodyIO<TlsStream>.finish(stream, trailers) -> resume(http_body_finish_direct<TlsStream>(stream, trailers))
        HttpBodyIO<TlsStream>.cancel(stream) -> resume(http_body_cancel_direct<TlsStream>(stream))
        HttpBodyIO<TlsStream>.close(connection) -> resume(http_body_close_connection_direct<TlsStream>(connection))
      }
    } {
      HttpTransportIO<TlsStream>.read(transport, limit) -> resume(http_transport_tls_read_direct(transport, limit))
      HttpTransportIO<TlsStream>.write(transport, data) -> resume(http_transport_tls_write_direct(transport, data))
      HttpTransportIO<TlsStream>.close(transport) -> resume(http_transport_tls_close_direct(transport))
    }
  } {
    HttpTransportRelease<TlsStream>.release(transport) -> resume(http_transport_tls_release_direct(transport))
  }
}

--- Interpret `HttpServer` and `HttpBodyIO` through validating inbound TLS.
pub fn http_server_with_tls<T, E>(
  certificate: Bytes,
  private_key: Bytes,
  body: () -[HttpServer, HttpBodyIO<TlsStream>, HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpListenerIO, E]> T
) -[SecureRandom, TcpListen, TcpListenerIO, TcpReadiness, TcpStreamIO, E]> T {
  handle {
    handle {
      handle {
        handle body() {
          HttpServer.listen(address, options) -> resume(http_server_listen_tls(address, options))
          HttpServer.accept(listener, limits) -> resume(http_server_accept_tls(certificate, private_key, listener, limits))
          HttpServer.request(connection, limits) -> resume(http_server_request_tls(connection, limits))
          HttpServer.respond(connection, response, limits) -> resume(http_server_respond_tls(connection, response, limits))
          HttpServer.upgrade(connection, response) -> resume(http_server_upgrade_tls(connection, response))
        }
      } {
        HttpBodyIO<TlsStream>.read(stream, limit) -> resume(http_body_read_direct<TlsStream>(stream, limit))
        HttpBodyIO<TlsStream>.write(stream, data) -> resume(http_body_write_direct<TlsStream>(stream, data))
        HttpBodyIO<TlsStream>.finish(stream, trailers) -> resume(http_body_finish_direct<TlsStream>(stream, trailers))
        HttpBodyIO<TlsStream>.cancel(stream) -> resume(http_body_cancel_direct<TlsStream>(stream))
        HttpBodyIO<TlsStream>.close(connection) -> resume(http_body_close_connection_direct<TlsStream>(connection))
      }
    } {
      HttpTransportIO<TlsStream>.read(transport, limit) -> resume(http_transport_tls_read_direct(transport, limit))
      HttpTransportIO<TlsStream>.write(transport, data) -> resume(http_transport_tls_write_direct(transport, data))
      HttpTransportIO<TlsStream>.close(transport) -> resume(http_transport_tls_close_direct(transport))
    }
  } {
    HttpTransportRelease<TlsStream>.release(transport) -> resume(http_transport_tls_release_direct(transport))
  }
}

--- Interpret both endpoint authorities and established body I/O through TLS.
--- Client and server remain distinct effects inside `body`; this combined
--- scope is for processes that deliberately possess both capabilities.
pub fn http_with_tls<T, E>(
  trust_roots: Bytes,
  certificate: Bytes,
  private_key: Bytes,
  body: () -[HttpClient<TlsStream>, HttpServer, HttpBodyIO<TlsStream>, HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpListenerIO, E]> T
) -[DnsResolve, SecureRandom, TcpConnect, TcpListen, TcpListenerIO, TcpReadiness, TcpStreamIO, Time, E]> T {
  handle {
    handle {
      handle {
        handle {
          handle body() {
            HttpClient<TlsStream>.begin(url, request, limits) -> resume(http_client_begin_tls(trust_roots, url, request, limits))
            HttpClient<TlsStream>.reuse(url, connection, request, limits) -> resume(http_client_reuse_transport<TlsStream>(url, connection, request, limits))
            HttpClient<TlsStream>.response(connection, request_method, limits) -> resume(http_client_response_transport<TlsStream>(connection, request_method, limits))
            HttpClient<TlsStream>.upgrade(connection, request_method, limits) -> resume(http_client_upgrade_transport<TlsStream>(connection, request_method, limits))
          }
        } {
          HttpServer.listen(address, options) -> resume(http_server_listen_tls(address, options))
          HttpServer.accept(listener, limits) -> resume(http_server_accept_tls(certificate, private_key, listener, limits))
          HttpServer.request(connection, limits) -> resume(http_server_request_tls(connection, limits))
          HttpServer.respond(connection, response, limits) -> resume(http_server_respond_tls(connection, response, limits))
          HttpServer.upgrade(connection, response) -> resume(http_server_upgrade_tls(connection, response))
        }
      } {
        HttpBodyIO<TlsStream>.read(stream, limit) -> resume(http_body_read_direct<TlsStream>(stream, limit))
        HttpBodyIO<TlsStream>.write(stream, data) -> resume(http_body_write_direct<TlsStream>(stream, data))
        HttpBodyIO<TlsStream>.finish(stream, trailers) -> resume(http_body_finish_direct<TlsStream>(stream, trailers))
        HttpBodyIO<TlsStream>.cancel(stream) -> resume(http_body_cancel_direct<TlsStream>(stream))
        HttpBodyIO<TlsStream>.close(connection) -> resume(http_body_close_connection_direct<TlsStream>(connection))
      }
    } {
      HttpTransportIO<TlsStream>.read(transport, limit) -> resume(http_transport_tls_read_direct(transport, limit))
      HttpTransportIO<TlsStream>.write(transport, data) -> resume(http_transport_tls_write_direct(transport, data))
      HttpTransportIO<TlsStream>.close(transport) -> resume(http_transport_tls_close_direct(transport))
    }
  } {
    HttpTransportRelease<TlsStream>.release(transport) -> resume(http_transport_tls_release_direct(transport))
  }
}
