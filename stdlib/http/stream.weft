-- stdlib/http/stream.weft — owned bounded HTTP/1 body transport
--
-- A body stream owns the live TLS connection until its framing boundary is
-- proven. Fixed-length and chunked completion can return a reusable
-- connection; close-delimited and explicit-close messages consume it. Chunk
-- data is delivered incrementally, so a large wire chunk is never hidden in
-- a whole-body buffer.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/drop.{Drop}
use stdlib/http as http
use stdlib/http.{HttpBodyFraming, HttpBodyTooLarge, HttpChunkHeadData, HttpChunkHeadEnd, HttpChunkHeadFailed, HttpChunkHeadNeedMore, HttpChunked, HttpConnectTunnel, HttpConnectionClose, HttpConnectionPersistent, HttpConnectionReuse, HttpContentLength, HttpForbiddenTrailer, HttpHeaders, HttpInvalidChunkTerminator, HttpLimits, HttpNoBody, HttpParseError, HttpProtocolSwitch, HttpUntilConnectionClose}
use stdlib/http/transport.{HttpTransport, HttpTransportError, HttpTransportIO, HttpTransportInvalidProgress, HttpTransportReadClosed, HttpTransportReadData, HttpTransportReadFailed, HttpTransportRelease, HttpTransportWriteFailed, HttpTransportWrote, http_transport_close, http_transport_from_tls, http_transport_read, http_transport_with_tls, http_transport_write}
use stdlib/result.{Err, Ok, Result}
use stdlib/tcp.{TcpReadiness, TcpStreamIO}
use stdlib/tls/stream.{TlsStream}
use stdlib/url.{UrlOrigin}
use stdlib/vector.{vector_get_in_bounds, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- A bounded body operation failure.
pub type HttpBodyError {
  --- The TLS transport failed while preserving the body owner.
  HttpBodyTransport(HttpTransportError),
    --- The HTTP framing parser rejected the wire prefix.
    HttpBodyProtocol(HttpParseError),
    --- A caller requested an empty or overlarge plaintext fragment.
    HttpBodyFragmentLimit(usize),
    --- The peer closed before a fixed or chunked body boundary was complete.
    HttpBodyUnexpectedEof(usize),
    --- A write would exceed the exact declared Content-Length.
    HttpBodyWriteOverflow(usize, usize),
    --- A fixed-length writer was finished with bytes still outstanding.
    HttpBodyWriteIncomplete(usize),
    --- The operation does not apply to this stream direction.
    HttpBodyWrongDirection,
    --- HTTP/1 switching and tunnel framing require their later protocol owner.
    HttpBodyUnsupportedUpgrade(HttpBodyFraming)
}

--- One established HTTP/1 TLS connection between message boundaries.
---
--- A connection is returned only after the body framing boundary is proven.
--- Dropping it closes the underlying TLS/TCP resource exactly once.
pub type HttpConnection<S> = opaque(owned HttpTransport<S>, Vector<u8>, i64, bool, HttpConnectionIdentity)

--- The authority identity retained by an established HTTP connection.
---
--- Client origins are carried through every body transition so pooling cannot
--- be keyed by an untrusted check-in argument. Server-side connections are a
--- distinct alternative and can never satisfy a client-origin checkout.
pub (package) type HttpConnectionIdentity {
  HttpConnectionClientOrigin(UrlOrigin),
    HttpConnectionServerPeer
}

type HttpBodyState {
  HttpBodyReadNone,
    HttpBodyReadFixed(i64),
    HttpBodyReadChunkHead(i64),
    HttpBodyReadChunkData(i64, i64),
    HttpBodyReadChunkTerminator(i64),
    HttpBodyReadUntilClose(i64),
    HttpBodyWriteNone,
    HttpBodyWriteFixed(i64),
    HttpBodyWriteChunked(i64),
    HttpBodyWriteUntilClose(i64)
}

--- One owned request or response body while its wire boundary is active.
---
--- Every operation moves the stream and returns its unique successor. Drop
--- closes an incomplete message rather than returning a reusable connection.
pub type HttpBodyStream<S> = opaque(owned HttpConnection<S>, HttpBodyStreamState)

type HttpBodyStreamState {
  framing: HttpBodyState,
    limits: HttpLimits,
    close_at_end: bool
}

--- One bounded read outcome.
pub type HttpBodyReadOutcome<S> {
  --- A non-empty content fragment arrived with the successor stream.
  HttpBodyReadData(owned HttpBodyStream<S>, Bytes),
    --- The body ended and the connection is safe for another HTTP message.
    HttpBodyReadEnd(owned HttpConnection<S>, HttpHeaders),
    --- The body ended on a connection that was then consumed and closed.
    HttpBodyReadEndClosed(HttpHeaders),
    --- Reading failed without fabricating or losing the stream owner.
    HttpBodyReadFailed(owned HttpBodyStream<S>, HttpBodyError),
    --- Body bytes completed, but authenticated connection close failed.
    HttpBodyReadCloseFailed(HttpBodyError)
}

--- One bounded write outcome.
pub type HttpBodyWriteOutcome<S> {
  --- The complete input fragment was accepted with the successor stream.
  HttpBodyWrote(owned HttpBodyStream<S>, usize),
    --- Writing failed without fabricating or losing the stream owner.
    HttpBodyWriteFailed(owned HttpBodyStream<S>, HttpBodyError)
}

--- Completion of one outbound body.
pub type HttpBodyFinishOutcome<S> {
  --- The exact body boundary was written and the connection remains usable.
  HttpBodyFinished(owned HttpConnection<S>),
    --- The exact body boundary was written and the connection was then closed.
    HttpBodyFinishedClosed,
    --- Completion failed while returning the stream for explicit policy.
    HttpBodyFinishFailed(owned HttpBodyStream<S>, HttpBodyError),
    --- The boundary completed, but authenticated connection close failed.
    HttpBodyFinishCloseFailed(HttpBodyError)
}

--- Transport interpretation for owned body operations.
---
--- Production installs this through `http_body_with_tls`; future mock/replay
--- handlers consume the same typed stream transitions without network access.
pub effect HttpBodyIO<S> {
  --- Read one bounded content fragment or terminal body boundary.
  fn read(stream: owned HttpBodyStream<S>, limit: usize) -> HttpBodyReadOutcome<S>
  --- Write one bounded content fragment.
  fn write(stream: owned HttpBodyStream<S>, data: Bytes) -> HttpBodyWriteOutcome<S>
  --- Finish an outbound body, supplying trailers only for chunked framing.
  fn finish(stream: owned HttpBodyStream<S>, trailers: HttpHeaders) -> HttpBodyFinishOutcome<S>
  --- Cancel an active body and close its underlying connection.
  fn cancel(stream: owned HttpBodyStream<S>) -> Result<nil, HttpBodyError>
  --- Close and consume an idle connection.
  fn close(connection: owned HttpConnection<S>) -> Result<nil, HttpBodyError>
}

fn http_body_usize_to_i64(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn http_body_i64_to_usize(value: i64) -> usize {
  __i64_to_usize(if value < 0 { 0 } else { value })
}

fn http_body_fragment_limit() -> i64 { 16384 }

fn http_connection_wrap<S>(
  transport: owned HttpTransport<S>,
  buffered: Vector<u8>,
  offset: i64,
  reusable: bool,
  identity: HttpConnectionIdentity
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  HttpConnection<S>((transport, buffered, offset, reusable, identity))
}

pub (package) fn http_connection_from_tls(
  transport: owned TlsStream,
  buffered: Vector<u8>,
  offset: i64,
  reuse: HttpConnectionReuse,
  identity: HttpConnectionIdentity
) -[HttpTransportRelease<TlsStream>, TcpStreamIO]> owned HttpConnection<TlsStream> {
  http_connection_wrap<TlsStream>(
    http_transport_from_tls(transport),
    buffered,
    offset,
    match reuse { HttpConnectionPersistent -> true HttpConnectionClose -> false },
    identity
  )
}

pub(package) fn http_connection_from_transport<S>(
  transport: owned HttpTransport<S>,
  buffered: Vector<u8>,
  offset: i64,
  reuse: HttpConnectionReuse,
  identity: HttpConnectionIdentity
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  http_connection_wrap<S>(
    transport,
    buffered,
    offset,
    match reuse { HttpConnectionPersistent -> true HttpConnectionClose -> false },
    identity
  )
}

impl<S> Drop for HttpConnection<S> {
  fn drop(self: HttpConnection<S>) -[HttpTransportRelease<S>]> i64 {
    match self {
      HttpConnection((transport, buffered, offset, reusable, identity)) -> transport.drop()
    }
  }
}

fn http_body_stream_wrap<S>(
  connection: owned HttpConnection<S>,
  state: HttpBodyState,
  limits: HttpLimits,
  close_at_end: bool
) -[HttpTransportRelease<S>]> owned HttpBodyStream<S> {
  HttpBodyStream<S>((connection, HttpBodyStreamState {
    framing: state,
      limits: limits,
      close_at_end: close_at_end
  }))
}

impl<S> Drop for HttpBodyStream<S> {
  fn drop(self: HttpBodyStream<S>) -[HttpTransportRelease<S>]> i64 {
    match self {
      HttpBodyStream((connection, state)) -> connection.drop()
    }
  }
}

fn http_body_limit_i64(limits: HttpLimits) -> i64 {
  http_body_usize_to_i64(limits.body_bytes())
}

pub(package) fn http_body_buffer_available<S>(connection: borrow HttpConnection<S>) -> i64 {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> buffered.len() - offset
  }
}

fn http_body_buffer_byte<S>(connection: borrow HttpConnection<S>, relative: i64) -> i64 {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(buffered, offset + relative)))
  }
}

pub(package) fn http_body_buffer_copy<S>(connection: borrow HttpConnection<S>, count: i64) -> Bytes {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> {
      let out = vector_with_capacity<u8>(count)
      for index in 0..count {
        out.push(vector_get_in_bounds<u8>(buffered, offset + index))
      }
      bytes.from_vector(out)
    }
  }
}

pub(package) fn http_body_buffered_bytes<S>(connection: borrow HttpConnection<S>) -> Bytes {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> {
      let count = buffered.len() - offset
      let out = vector_with_capacity<u8>(if count > 0 { count } else { 0 })
      for index in 0..count {
        out.push(vector_get_in_bounds<u8>(buffered, offset + index))
      }
      bytes.from_vector(out)
    }
  }
}

pub(package) type HttpConnectionSnapshot<S> {
  HttpConnectionSnapshotted(owned HttpConnection<S>, Bytes)
}

pub(package) fn http_connection_snapshot<S>(
  connection: owned HttpConnection<S>
) -[HttpTransportRelease<S>]> HttpConnectionSnapshot<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> {
      let count = buffered.len() - offset
      let out = vector_with_capacity<u8>(if count > 0 { count } else { 0 })
      for index in 0..count {
        out.push(vector_get_in_bounds<u8>(buffered, offset + index))
      }
      HttpConnectionSnapshotted(
        http_connection_wrap<S>(transport, buffered, offset, reusable, identity),
        bytes.from_vector(out)
      )
    }
  }
}

pub(package) fn http_body_connection_advance<S>(
  connection: owned HttpConnection<S>,
  count: i64
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> http_connection_wrap<S>(
      transport,
      buffered,
      offset + count,
      reusable,
      identity
    )
  }
}

pub(package) fn http_body_connection_take<S>(
  connection: owned HttpConnection<S>,
  count: i64
) -[HttpTransportRelease<S>]> (owned HttpConnection<S>, Bytes) {
  let data = http_body_buffer_copy(connection, count)
  (http_body_connection_advance(connection, count), data)
}

fn http_body_connection_append<S>(
  connection: owned HttpConnection<S>,
  data: Bytes
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> {
      let values = data.to_vector()
      let remaining = buffered.len() - offset
      let compact = vector_with_capacity<u8>(remaining + values.len())
      for index in 0..remaining {
        compact.push(vector_get_in_bounds<u8>(buffered, offset + index))
      }
      for index in 0..values.len() {
        compact.push(vector_get_in_bounds<u8>(values, index))
      }
      http_connection_wrap<S>(transport, compact, 0, reusable, identity)
    }
  }
}

fn http_body_connection_compact<S>(
  connection: owned HttpConnection<S>
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> {
      let count = buffered.len() - offset
      let compact = vector_with_capacity<u8>(if count > 0 { count } else { 0 })
      for index in 0..count {
        compact.push(vector_get_in_bounds<u8>(buffered, offset + index))
      }
      http_connection_wrap<S>(transport, compact, 0, reusable, identity)
    }
  }
}

fn http_body_connection_can_reuse<S>(connection: borrow HttpConnection<S>) -> bool {
  match connection { HttpConnection((transport, buffered, offset, reusable, identity)) -> reusable }
}

pub(package) fn http_connection_matches_origin<S>(
  connection: borrow HttpConnection<S>,
  origin: UrlOrigin
) -> bool {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> match identity {
      HttpConnectionClientOrigin(actual) -> actual.eq(origin)
      HttpConnectionServerPeer -> false
    }
  }
}

pub(package) fn http_connection_is_reusable<S>(connection: borrow HttpConnection<S>) -> bool {
  http_body_connection_can_reuse(connection)
}

pub(package) fn http_connection_has_client_origin<S>(connection: borrow HttpConnection<S>) -> bool {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> match identity {
      HttpConnectionClientOrigin(origin) -> true
      HttpConnectionServerPeer -> false
    }
  }
}

pub(package) fn http_connection_disallow_reuse<S>(
  connection: owned HttpConnection<S>
) -[HttpTransportRelease<S>]> owned HttpConnection<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> http_connection_wrap<S>(
      transport,
      buffered,
      offset,
      false,
      identity
    )
  }
}

pub(package) fn http_body_reader_open<S>(
  connection: owned HttpConnection<S>,
  framing: HttpBodyFraming,
  limits: HttpLimits,
  close_at_end: bool
) -[HttpTransportRelease<S>]> Result<owned HttpBodyStream<S>, HttpBodyError> {
  match framing {
    HttpNoBody -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyReadNone, limits, close_at_end)
    )
    HttpContentLength(count) -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(
      connection,
      HttpBodyReadFixed(http_body_usize_to_i64(count)),
      limits,
      close_at_end
    )
    )
    HttpChunked -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyReadChunkHead(0), limits, close_at_end)
    )
    HttpUntilConnectionClose -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyReadUntilClose(0), limits, true)
    )
    HttpProtocolSwitch -> Err<owned HttpBodyStream<S>, HttpBodyError>(
      HttpBodyUnsupportedUpgrade(HttpProtocolSwitch)
    )
    HttpConnectTunnel -> Err<owned HttpBodyStream<S>, HttpBodyError>(
      HttpBodyUnsupportedUpgrade(HttpConnectTunnel)
    )
  }
}

pub(package) fn http_body_writer_open<S>(
  connection: owned HttpConnection<S>,
  framing: HttpBodyFraming,
  limits: HttpLimits,
  close_at_end: bool
) -[HttpTransportRelease<S>]> Result<owned HttpBodyStream<S>, HttpBodyError> {
  match framing {
    HttpNoBody -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyWriteNone, limits, close_at_end)
    )
    HttpContentLength(count) -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(
      connection,
      HttpBodyWriteFixed(http_body_usize_to_i64(count)),
      limits,
      close_at_end
    )
    )
    HttpChunked -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyWriteChunked(0), limits, close_at_end)
    )
    HttpUntilConnectionClose -> Ok<owned HttpBodyStream<S>, HttpBodyError>(
      http_body_stream_wrap<S>(connection, HttpBodyWriteUntilClose(0), limits, true)
    )
    framing -> Err<owned HttpBodyStream<S>, HttpBodyError>(HttpBodyUnsupportedUpgrade(framing))
  }
}

pub(package) type HttpConnectionReceive<S> {
  HttpConnectionReceived(owned HttpConnection<S>),
    HttpConnectionPeerClosed(owned HttpConnection<S>),
    HttpConnectionReceiveFailed(owned HttpConnection<S>, HttpBodyError)
}

pub(package) fn http_body_connection_receive<S>(
  connection: owned HttpConnection<S>,
  limit: i64
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpConnectionReceive<S> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> match http_transport_read<S>(transport, http_body_i64_to_usize(limit)) {
      HttpTransportReadData(transport, data) -> HttpConnectionReceived(
        http_body_connection_append<S>(
          http_connection_wrap<S>(transport, buffered, offset, reusable, identity),
          data
        )
      )
      HttpTransportReadClosed(transport) -> HttpConnectionPeerClosed(
        http_connection_wrap<S>(transport, buffered, offset, false, identity)
      )
      HttpTransportReadFailed(transport, error) -> HttpConnectionReceiveFailed(
        http_connection_wrap<S>(transport, buffered, offset, false, identity),
        HttpBodyTransport(error)
      )
    }
  }
}

pub(package) fn http_body_close_connection_direct<S>(
  connection: owned HttpConnection<S>
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> Result<nil, HttpBodyError> {
  match connection {
    HttpConnection((transport, buffered, offset, reusable, identity)) -> match http_transport_close<S>(transport) {
      Err(error) -> Err<nil, HttpBodyError>(HttpBodyTransport(error))
      Ok(done) -> Ok<nil, HttpBodyError>(nil)
    }
  }
}

pub(package) fn http_body_cancel_direct<S>(
  stream: owned HttpBodyStream<S>
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> Result<nil, HttpBodyError> {
  match stream {
    HttpBodyStream((connection, state)) ->
      http_body_close_connection_direct(connection)
  }
}

fn http_body_complete_read<S>(
  connection: owned HttpConnection<S>,
  trailers: HttpHeaders,
  close_at_end: bool
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpBodyReadOutcome<S> {
  let close = close_at_end or not http_body_connection_can_reuse(connection)
  if close {
    match http_body_close_connection_direct(connection) {
      Err(error) -> HttpBodyReadCloseFailed(error)
      Ok(done) -> HttpBodyReadEndClosed(trailers)
    }
  } else {
    HttpBodyReadEnd(http_body_connection_compact(connection), trailers)
  }
}

pub(package) fn http_body_read_direct<S>(
  stream: owned HttpBodyStream<S>,
  limit: usize
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpBodyReadOutcome<S> {
  let requested = http_body_usize_to_i64(limit)
  if requested <= 0 or requested > http_body_fragment_limit() {
    HttpBodyReadFailed(stream, HttpBodyFragmentLimit(limit))
  } else {
    let mut current: owned HttpBodyStream<S> = stream
    loop {
      match current {
        HttpBodyStream((connection, stream_state)) -> {
          let { framing: state, limits, close_at_end } = stream_state
          match state {
          HttpBodyReadNone -> break (http_body_complete_read(
            connection,
            http.headers(),
            close_at_end
          ))
          HttpBodyReadFixed(remaining) -> {
            if remaining == 0 {
              break (http_body_complete_read(
                connection,
                http.headers(),
                close_at_end
              ))
            } else {
              let available = http_body_buffer_available(connection)
              if available > 0 {
                let count = if available < requested { available } else { requested }
                let take = if count < remaining { count } else { remaining }
                let (connection, data) = http_body_connection_take(connection, take)
                break (HttpBodyReadData(
                  http_body_stream_wrap(
                  connection,
                  HttpBodyReadFixed(remaining - take),
                  limits,
                  close_at_end
                ),
                  data
                ))
              } else {
                match http_body_connection_receive(
                  connection,
                  if remaining < requested { remaining } else { requested }
                ) {
                  HttpConnectionReceived(connection) -> {
                    current = http_body_stream_wrap(
                      connection,
                      HttpBodyReadFixed(remaining),
                      limits,
                      close_at_end
                    )
                  }
                  HttpConnectionPeerClosed(connection) -> break (HttpBodyReadFailed(
                    http_body_stream_wrap(
                    connection,
                    HttpBodyReadFixed(remaining),
                    limits,
                    true
                  ),
                    HttpBodyUnexpectedEof(http_body_i64_to_usize(remaining))
                  ))
                  HttpConnectionReceiveFailed(connection, error) -> break (HttpBodyReadFailed(
                    http_body_stream_wrap(
                    connection,
                    HttpBodyReadFixed(remaining),
                    limits,
                    true
                  ),
                    error
                  ))
                }
              }
            }
          }
          HttpBodyReadChunkHead(total) -> {
            match connection {
              HttpConnection((transport, buffered, offset, reusable, identity)) -> {
                let source_owner = vector_with_capacity<u8>(buffered.len() - offset)
                for index in offset..buffered.len() {
                  source_owner.push(vector_get_in_bounds<u8>(buffered, index))
                }
                let parsed = http.parse_chunk_head(source_owner[..], limits)
                let connection = http_connection_wrap(
                  transport,
                  buffered,
                  offset,
                  reusable,
                  identity
                )
                match parsed {
                  HttpChunkHeadFailed(error) -> break (HttpBodyReadFailed(
                    http_body_stream_wrap(connection, HttpBodyReadChunkHead(total), limits, true),
                    HttpBodyProtocol(error)
                  ))
                  HttpChunkHeadEnd(trailers, consumed) -> {
                    let advanced = http_body_connection_advance(connection, http_body_usize_to_i64(consumed))
                    break (http_body_complete_read(advanced, trailers, close_at_end))
                  }
                  HttpChunkHeadData(size, consumed) -> {
                    let count = http_body_usize_to_i64(size)
                    if total > http_body_limit_i64(limits) - count {
                      break (HttpBodyReadFailed(
                        http_body_stream_wrap(connection, HttpBodyReadChunkHead(total), limits, true),
                        HttpBodyProtocol(HttpBodyTooLarge(total))
                      ))
                    } else {
                      current = http_body_stream_wrap(
                        http_body_connection_advance(connection, http_body_usize_to_i64(consumed)),
                        HttpBodyReadChunkData(count, total),
                        limits,
                        close_at_end
                      )
                    }
                  }
                  HttpChunkHeadNeedMore -> match http_body_connection_receive(
                    connection,
                    http_body_fragment_limit()
                  ) {
                    HttpConnectionReceived(received) -> {
                      current = http_body_stream_wrap(
                        received,
                        HttpBodyReadChunkHead(total),
                        limits,
                        close_at_end
                      )
                    }
                    HttpConnectionPeerClosed(received) -> break (HttpBodyReadFailed(
                      http_body_stream_wrap(received, HttpBodyReadChunkHead(total), limits, true),
                      HttpBodyUnexpectedEof(http_body_i64_to_usize(1))
                    ))
                    HttpConnectionReceiveFailed(received, error) -> break (HttpBodyReadFailed(
                      http_body_stream_wrap(received, HttpBodyReadChunkHead(total), limits, true),
                      error
                    ))
                  }
                }
              }
            }
          }
          HttpBodyReadChunkData(remaining, total) -> {
            if remaining == 0 {
              current = http_body_stream_wrap(
                connection,
                HttpBodyReadChunkTerminator(total),
                limits,
                close_at_end
              )
            } else {
              let available = http_body_buffer_available(connection)
              if available > 0 {
                let count = if available < requested { available } else { requested }
                let take = if count < remaining { count } else { remaining }
                let (connection, data) = http_body_connection_take(connection, take)
                break (HttpBodyReadData(
                  http_body_stream_wrap(
                  connection,
                  HttpBodyReadChunkData(remaining - take, total + take),
                  limits,
                  close_at_end
                ),
                  data
                ))
              } else {
                match http_body_connection_receive(
                  connection,
                  if remaining < requested { remaining } else { requested }
                ) {
                  HttpConnectionReceived(connection) -> {
                    current = http_body_stream_wrap(
                      connection,
                      HttpBodyReadChunkData(remaining, total),
                      limits,
                      close_at_end
                    )
                  }
                  HttpConnectionPeerClosed(connection) -> break (HttpBodyReadFailed(
                    http_body_stream_wrap(connection, HttpBodyReadChunkData(remaining, total), limits, true),
                    HttpBodyUnexpectedEof(http_body_i64_to_usize(remaining))
                  ))
                  HttpConnectionReceiveFailed(connection, error) -> break (HttpBodyReadFailed(
                    http_body_stream_wrap(connection, HttpBodyReadChunkData(remaining, total), limits, true),
                    error
                  ))
                }
              }
            }
          }
          HttpBodyReadChunkTerminator(total) -> {
            let available = http_body_buffer_available(connection)
            if available >= 2 {
              if http_body_buffer_byte(connection, 0) != 13 or
                http_body_buffer_byte(connection, 1) != 10 {
                break (HttpBodyReadFailed(
                  http_body_stream_wrap(connection, HttpBodyReadChunkTerminator(total), limits, true),
                  HttpBodyProtocol(HttpInvalidChunkTerminator(total))
                ))
              } else {
                current = http_body_stream_wrap(
                  http_body_connection_advance(connection, 2),
                  HttpBodyReadChunkHead(total),
                  limits,
                  close_at_end
                )
              }
            } else {
              match http_body_connection_receive(connection, http_body_fragment_limit()) {
                HttpConnectionReceived(connection) -> {
                  current = http_body_stream_wrap(
                    connection,
                    HttpBodyReadChunkTerminator(total),
                    limits,
                    close_at_end
                  )
                }
                HttpConnectionPeerClosed(connection) -> break (HttpBodyReadFailed(
                  http_body_stream_wrap(connection, HttpBodyReadChunkTerminator(total), limits, true),
                  HttpBodyUnexpectedEof(http_body_i64_to_usize(2 - available))
                ))
                HttpConnectionReceiveFailed(connection, error) -> break (HttpBodyReadFailed(
                  http_body_stream_wrap(connection, HttpBodyReadChunkTerminator(total), limits, true),
                  error
                ))
              }
            }
          }
          HttpBodyReadUntilClose(total) -> {
            let available = http_body_buffer_available(connection)
            if available > 0 {
              let count = if available < requested { available } else { requested }
              if total > http_body_limit_i64(limits) - count {
                break (HttpBodyReadFailed(
                  http_body_stream_wrap(connection, HttpBodyReadUntilClose(total), limits, true),
                  HttpBodyProtocol(HttpBodyTooLarge(total))
                ))
              } else {
                let (connection, data) = http_body_connection_take(connection, count)
                break (HttpBodyReadData(
                  http_body_stream_wrap(connection, HttpBodyReadUntilClose(total + count), limits, true),
                  data
                ))
              }
            } else {
              match http_body_connection_receive(connection, requested) {
                HttpConnectionReceived(connection) -> {
                  current = http_body_stream_wrap(
                    connection,
                    HttpBodyReadUntilClose(total),
                    limits,
                    true
                  )
                }
                HttpConnectionPeerClosed(connection) -> break (http_body_complete_read(
                  connection,
                  http.headers(),
                  true
                ))
                HttpConnectionReceiveFailed(connection, error) -> break (HttpBodyReadFailed(
                  http_body_stream_wrap(connection, HttpBodyReadUntilClose(total), limits, true),
                  error
                ))
              }
            }
          }
          _ -> break (HttpBodyReadFailed(
            http_body_stream_wrap(connection, state, limits, close_at_end),
            HttpBodyWrongDirection
          ))
          }
        }
      }
    }
  }
}

fn http_body_bytes_suffix(values: Bytes, offset: i64, count: i64) -> Bytes {
  let source = values.to_vector()
  bytes.from_slice(source[http_body_i64_to_usize(offset)..http_body_i64_to_usize(offset + count)])
}

pub(package) type HttpConnectionWrite<S> {
  HttpConnectionWritten(owned HttpConnection<S>),
    HttpConnectionWriteFailed(owned HttpConnection<S>, HttpBodyError)
}

pub(package) fn http_body_write_wire<S>(
  connection: owned HttpConnection<S>,
  wire: Bytes
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpConnectionWrite<S> {
  let total = wire.len()
  let mut position = 0
  let mut current: owned HttpConnection<S> = connection
  loop {
    if position >= total { break (HttpConnectionWritten(current)) }
    else {
      let count = if total - position < http_body_fragment_limit() {
        total - position
      } else {
        http_body_fragment_limit()
      }
      let fragment = http_body_bytes_suffix(wire, position, count)
      match current {
        HttpConnection((transport, buffered, offset, reusable, identity)) -> match http_transport_write<S>(transport, fragment) {
          HttpTransportWriteFailed(returned, error) -> break (HttpConnectionWriteFailed(
            http_connection_wrap<S>(returned, buffered, offset, false, identity),
            HttpBodyTransport(error)
          ))
          HttpTransportWrote(transport, wrote) -> {
            let progress = http_body_usize_to_i64(wrote)
            if progress <= 0 or progress > count {
              break (HttpConnectionWriteFailed(
                http_connection_wrap<S>(transport, buffered, offset, false, identity),
                HttpBodyTransport(HttpTransportInvalidProgress)
              ))
            } else {
              current = http_connection_wrap<S>(
                transport,
                buffered,
                offset,
                reusable,
                identity
              )
              position = position + progress
            }
          }
        }
      }
    }
  }
}

pub(package) fn http_body_write_direct<S>(
  stream: owned HttpBodyStream<S>,
  data: Bytes
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpBodyWriteOutcome<S> {
  let count = data.len()
  if count < 0 or count > http_body_fragment_limit() {
    HttpBodyWriteFailed(stream, HttpBodyFragmentLimit(http_body_i64_to_usize(if count < 0 { 0 } else { count })))
  } else { if count == 0 {
      HttpBodyWrote(stream, http_body_i64_to_usize(0))
    } else {
      match stream {
        HttpBodyStream((connection, stream_state)) -> {
          let { framing: state, limits, close_at_end } = stream_state
          match state {
          HttpBodyWriteNone -> HttpBodyWriteFailed(
            http_body_stream_wrap(connection, state, limits, close_at_end),
            HttpBodyWriteOverflow(http_body_i64_to_usize(0), http_body_i64_to_usize(count))
          )
          HttpBodyWriteFixed(remaining) -> if count > remaining {
            HttpBodyWriteFailed(
              http_body_stream_wrap(connection, state, limits, close_at_end),
              HttpBodyWriteOverflow(http_body_i64_to_usize(remaining), http_body_i64_to_usize(count))
            )
          } else { match http_body_write_wire(connection, data) {
              HttpConnectionWriteFailed(failed, error) -> HttpBodyWriteFailed(
                http_body_stream_wrap(
                failed,
                state,
                limits,
                true
              ),
                error
              )
              HttpConnectionWritten(connection) -> HttpBodyWrote(
                http_body_stream_wrap(
                connection,
                HttpBodyWriteFixed(remaining - count),
                limits,
                close_at_end
              ),
                http_body_i64_to_usize(count)
              )
            } }
          HttpBodyWriteUntilClose(total) -> if total > http_body_limit_i64(limits) - count {
            HttpBodyWriteFailed(
              http_body_stream_wrap(connection, state, limits, close_at_end),
              HttpBodyProtocol(HttpBodyTooLarge(total))
            )
          } else { match http_body_write_wire(connection, data) {
              HttpConnectionWriteFailed(failed, error) -> HttpBodyWriteFailed(
                http_body_stream_wrap(failed, state, limits, true),
                error
              )
              HttpConnectionWritten(connection) -> HttpBodyWrote(
                http_body_stream_wrap(
                connection,
                HttpBodyWriteUntilClose(total + count),
                limits,
                true
              ),
                http_body_i64_to_usize(count)
              )
            } }
          HttpBodyWriteChunked(total) -> if total > http_body_limit_i64(limits) - count {
            HttpBodyWriteFailed(
              http_body_stream_wrap(connection, state, limits, close_at_end),
              HttpBodyProtocol(HttpBodyTooLarge(total))
            )
          } else { match http.encode_chunk(data, limits) {
              Err(error) -> HttpBodyWriteFailed(
                http_body_stream_wrap(connection, state, limits, close_at_end),
                HttpBodyProtocol(error)
              )
              Ok(wire) -> match http_body_write_wire(connection, wire) {
                HttpConnectionWriteFailed(failed, error) -> HttpBodyWriteFailed(
                  http_body_stream_wrap(
                  failed,
                  state,
                  limits,
                  true
                ),
                  error
                )
                HttpConnectionWritten(connection) -> HttpBodyWrote(
                  http_body_stream_wrap(
                  connection,
                  HttpBodyWriteChunked(total + count),
                  limits,
                  close_at_end
                ),
                  http_body_i64_to_usize(count)
                )
              }
            } }
          _ -> HttpBodyWriteFailed(
            http_body_stream_wrap(connection, state, limits, close_at_end),
            HttpBodyWrongDirection
          )
          }
        }
      }
    } }
}

fn http_body_complete_write<S>(
  connection: owned HttpConnection<S>,
  close_at_end: bool
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpBodyFinishOutcome<S> {
  let close = close_at_end or not http_body_connection_can_reuse(connection)
  if close {
    match http_body_close_connection_direct(connection) {
      Err(error) -> HttpBodyFinishCloseFailed(error)
      Ok(done) -> HttpBodyFinishedClosed
    }
  } else {
    HttpBodyFinished(http_body_connection_compact(connection))
  }
}

pub(package) fn http_body_finish_direct<S>(
  stream: owned HttpBodyStream<S>,
  trailers: HttpHeaders
) -[HttpTransportIO<S>, HttpTransportRelease<S>]> HttpBodyFinishOutcome<S> {
  match stream {
    HttpBodyStream((connection, stream_state)) -> {
      let { framing: state, limits, close_at_end } = stream_state
      match state {
      HttpBodyWriteNone -> if trailers.len() != 0 {
        HttpBodyFinishFailed(
          http_body_stream_wrap(connection, state, limits, close_at_end),
          HttpBodyProtocol(HttpForbiddenTrailer(0))
        )
      } else {
        http_body_complete_write(connection, close_at_end)
      }
      HttpBodyWriteFixed(remaining) -> if remaining != 0 {
        HttpBodyFinishFailed(
          http_body_stream_wrap(connection, state, limits, close_at_end),
          HttpBodyWriteIncomplete(http_body_i64_to_usize(remaining))
        )
      } else { if trailers.len() != 0 {
          HttpBodyFinishFailed(
            http_body_stream_wrap(connection, state, limits, close_at_end),
            HttpBodyProtocol(HttpForbiddenTrailer(0))
          )
        } else {
          http_body_complete_write(connection, close_at_end)
        } }
      HttpBodyWriteChunked(total) -> match http.encode_chunk_end(trailers, limits) {
        Err(error) -> HttpBodyFinishFailed(
          http_body_stream_wrap(connection, state, limits, close_at_end),
          HttpBodyProtocol(error)
        )
        Ok(wire) -> match http_body_write_wire(connection, wire) {
          HttpConnectionWriteFailed(failed, error) -> HttpBodyFinishFailed(
            http_body_stream_wrap(
            failed,
            state,
            limits,
            true
          ),
            error
          )
          HttpConnectionWritten(connection) -> http_body_complete_write(connection, close_at_end)
        }
      }
      HttpBodyWriteUntilClose(total) -> if trailers.len() != 0 {
        HttpBodyFinishFailed(
          http_body_stream_wrap(connection, state, limits, true),
          HttpBodyProtocol(HttpForbiddenTrailer(0))
        )
      } else {
        http_body_complete_write(connection, true)
      }
      _ -> HttpBodyFinishFailed(
        http_body_stream_wrap(connection, state, limits, close_at_end),
        HttpBodyWrongDirection
      )
      }
    }
  }
}

--- Read one non-empty body fragment of at most 16 KiB.
pub fn http_body_read<S>(
  stream: owned HttpBodyStream<S>,
  limit: usize
) -[HttpBodyIO<S>, HttpTransportRelease<S>]> HttpBodyReadOutcome<S> {
  HttpBodyIO<S>.read(stream, limit)
}

--- Write one body fragment of at most 16 KiB.
pub fn http_body_write<S>(
  stream: owned HttpBodyStream<S>,
  data: Bytes
) -[HttpBodyIO<S>, HttpTransportRelease<S>]> HttpBodyWriteOutcome<S> {
  HttpBodyIO<S>.write(stream, data)
}

--- Finish an outbound body with an optional chunked trailer section.
pub fn http_body_finish<S>(
  stream: owned HttpBodyStream<S>,
  trailers: HttpHeaders
) -[HttpBodyIO<S>, HttpTransportRelease<S>]> HttpBodyFinishOutcome<S> {
  HttpBodyIO<S>.finish(stream, trailers)
}

--- Cancel an active body and deterministically close its connection.
pub fn http_body_cancel<S>(
  stream: owned HttpBodyStream<S>
) -[HttpBodyIO<S>, HttpTransportRelease<S>]> Result<nil, HttpBodyError> {
  HttpBodyIO<S>.cancel(stream)
}

--- Close and consume an idle HTTP connection.
pub fn http_connection_close<S>(
  connection: owned HttpConnection<S>
) -[HttpBodyIO<S>, HttpTransportRelease<S>]> Result<nil, HttpBodyError> {
  HttpBodyIO<S>.close(connection)
}

--- Interpret owned body operations through transport state `S`.
pub fn http_body_with_transport<S, T, E>(
  body: () -[HttpBodyIO<S>, HttpTransportRelease<S>, E]> T
) -[HttpTransportIO<S>, HttpTransportRelease<S>, E]> T {
  handle body() {
    HttpBodyIO<S>.read(stream, limit) -> resume(http_body_read_direct<S>(stream, limit))
    HttpBodyIO<S>.write(stream, data) -> resume(http_body_write_direct<S>(stream, data))
    HttpBodyIO<S>.finish(stream, trailers) -> resume(http_body_finish_direct<S>(stream, trailers))
    HttpBodyIO<S>.cancel(stream) -> resume(http_body_cancel_direct<S>(stream))
    HttpBodyIO<S>.close(connection) -> resume(http_body_close_connection_direct<S>(connection))
  }
}

--- Interpret owned body operations through the validating TLS transport.
pub fn http_body_with_tls<T, E>(
  body: () -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, E]> T
) -[TcpReadiness, TcpStreamIO, E]> T {
  http_transport_with_tls<T, E>(() => http_body_with_transport<TlsStream, T, E>(body))
}
