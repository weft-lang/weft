-- stdlib/hash.weft — Hash trait and hash function implementations
--
-- Provides the Hash trait for types that can be hashed, and
-- a standard hash function (djb2 variant) for map/set keys.

use stdlib/string.{*}

pub trait Hash {
  fn hash(self: Self) -> i64
}

impl Hash for i64 {
  fn hash(self: i64) -> i64 {
    -- Mix bits: multiply by golden ratio prime, xor with shift
    let h = self * 2654435761
    let h2 = h bxor (h bshr 16)
    -- Ensure positive
    if h2 < 0 { 0 - h2 } else { h2 }
  }
}

impl Hash for str {
  fn hash(self: str) -> i64 {
    let len = str_len(self)
    let mut h = 5381
    for i in 0..len {
      h = h * 33 + str_byte_at(self, i)
    }
    if h < 0 { 0 - h } else { h }
  }
}

-- Population count: count the number of set bits in a 64-bit value
-- Used by CHAMP for compressed array indexing.
pub(package) fn popcount(x: i64) -> i64 {
  -- Software popcount via parallel bit counting
  let mut v = x
  -- Mask to handle as unsigned: work on low 32 bits for CHAMP (32-wide trie)
  v = v band 4294967295
  v = v - ((v bshr 1) band 1431655765)
  v = (v band 858993459) + ((v bshr 2) band 858993459)
  v = (v + (v bshr 4)) band 252645135
  v = v * 16843009
  (v bshr 24) band 255
}

-- Compute the compressed index for a CHAMP node.
-- Given a bitmap and a bit position, return the number of set bits
-- below that position (= the array index for that entry).
pub(package) fn compressed_index(bitmap: i64, bit: i64) -> i64 {
  popcount(bitmap band (bit - 1))
}
