-- stdlib/json.weft — JSON values, parser, accessors, and emitter
--
-- Integral numbers retain exact i64 identity; fractional, exponent, signed
-- zero, and wider numeric spellings use finite IEEE f64 identity.

use runtime/memory.{*}
use runtime/string.{*}
use stdlib/num.{*}
use stdlib/list.{*}
use stdlib/math as math
use stdlib/option.{*}
use stdlib/panic.{panic}
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/utf8 as utf8
use stdlib/utf8.{utf8_encode_scalar_into}

--- A JSON value with exact `i64` and finite-or-nonfinite `f64` number cases.
pub type Json {
  --- The JSON `null` value.
  JsonNull,
  --- A JSON boolean.
  JsonBool(bool),
  --- A JSON number represented exactly as an `i64`.
  JsonNumber(i64),
  --- A JSON number represented as an `f64`.
  JsonFloat(f64),
  --- A JSON string containing decoded text.
  JsonString(str),
  --- A JSON array whose list order is its document order.
  JsonArray(List<Json>),
  --- A JSON object whose entry list preserves document order and duplicates.
  JsonObject(List<JsonEntry>)
}

--- A key-value entry in a JSON object.
pub type JsonEntry {
  --- Pair a decoded string key with its JSON value.
  JsonEntry(str, Json)
}

fn json_list_len_i64<T>(items: List<T>) -> i64 {
  match items.len().to_u64().to_i64_checked() {
    Ok(count) -> count
    Err(_) -> panic("JSON collection length exceeds signed compatibility domain")
  }
}

fn json_list_get_i64<T>(items: List<T>, index: i64) -> Option<T> {
  match index.to_usize_checked() {
    Ok(finite_index) -> items.get(finite_index)
    Err(_) -> None<T>()
  }
}

pub(package) type JsonParseStep {
  JsonParsed(i64, Json),
  JsonParseFailed(i64)
}

--- Why a complete JSON document could not be parsed.
pub type JsonParseError {
  --- The UTF-8 byte offset at which parsing failed.
  JsonInvalidSyntax(i64)
}

--- Why a JSON value could not be encoded as a document.
pub type JsonStringifyError {
  --- The value contains a non-finite floating-point number.
  JsonNonFiniteNumber
}

--- Construct the JSON `null` value.
pub(package) fn json_null() -> Json { JsonNull }
--- Construct a JSON boolean.
pub(package) fn json_bool(value: bool) -> Json { JsonBool(value) }
--- Construct a JSON number with exact `i64` identity.
pub(package) fn json_number(value: i64) -> Json { JsonNumber(value) }
--- Construct a JSON number with `f64` identity.
pub(package) fn json_float(value: f64) -> Json { JsonFloat(value) }
--- Construct a JSON string from decoded text.
pub(package) fn json_string(value: str) -> Json { JsonString(value) }
--- Construct a JSON array preserving the list's order.
pub(package) fn json_array(items: List<Json>) -> Json { JsonArray(items) }
--- Construct a JSON object preserving entry order and duplicate keys.
pub(package) fn json_object(entries: List<JsonEntry>) -> Json { JsonObject(entries) }
--- Construct a JSON object entry.
pub(package) fn json_entry(key: str, value: Json) -> JsonEntry { JsonEntry(key, value) }

--- Return `0` null, `1` boolean, `2` number, `3` string, `4` array, or `5` object.
pub(package) fn json_kind(value: Json) -> i64 {
  match value {
    JsonNull -> 0
    JsonBool(v) -> 1
    JsonNumber(v) -> 2
    JsonFloat(v) -> 2
    JsonString(v) -> 3
    JsonArray(v) -> 4
    JsonObject(v) -> 5
  }
}

--- Return an object's decoded entry key.
pub(package) fn json_entry_key(entry: JsonEntry) -> str {
  match entry {
    JsonEntry(key, value) -> key
  }
}

--- Return an object's entry value.
pub(package) fn json_entry_value(entry: JsonEntry) -> Json {
  match entry {
    JsonEntry(key, value) -> value
  }
}

pub(package) fn json_parse_ok_result(pos: i64, value: Json) -> JsonParseStep {
  JsonParsed(pos, value)
}

pub(package) fn json_parse_bad_result(pos: i64) -> JsonParseStep {
  JsonParseFailed(pos)
}

pub(package) fn json_is_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 }
  else { if ch == 9 { 1 } else { 0 } } } }
}

pub(package) fn json_skip_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and json_is_ws(mem_load8_at(src, p)) == 1 {
    p = p + 1
  }
  p
}

pub(package) fn json_is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}

pub(package) fn json_hex_value(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { ch - 48 }
  else { if ch >= 65 and ch <= 70 { ch - 55 }
  else { if ch >= 97 and ch <= 102 { ch - 87 }
  else { 0 - 1 } } }
}

pub(package) fn json_hex4(src: i64, n: i64, pos: i64) -> i64 {
  if pos < 0 or pos + 4 > n { 0 - 1 }
  else {
    let h1 = json_hex_value(mem_load8_at(src, pos))
    let h2 = json_hex_value(mem_load8_at(src, pos + 1))
    let h3 = json_hex_value(mem_load8_at(src, pos + 2))
    let h4 = json_hex_value(mem_load8_at(src, pos + 3))
    if h1 < 0 or h2 < 0 or h3 < 0 or h4 < 0 { 0 - 1 }
    else { h1 * 4096 + h2 * 256 + h3 * 16 + h4 }
  }
}

pub(package) fn json_src_eq(src: i64, pos: i64, n: i64, literal: str) -> i64 {
  let len = str_len(literal)
  if pos + len > n { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < len {
      if mem_load8_at(src, pos + i) != str_byte_at(literal, i) {
        ok = 0
        i = len
      } else { i = i + 1 }
    }
    ok
  }
}

pub(package) fn json_string_from_bytes(data: i64, len: i64) -> str {
  runtime_str_from_bytes(data, len)
}

pub(package) fn json_parse_string_raw(src: i64, n: i64, pos: i64) -> JsonParseStep {
  if pos >= n { json_parse_bad_result(pos) }
  else { if mem_load8_at(src, pos) != 34 { json_parse_bad_result(pos) }
  else {
    let value = runtime_str_alloc_uninit(n - pos)
    let out = runtime_str_ptr(value)
    let mut out_len = 0
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      if p >= n {
        ok = 0
        done = 1
      } else {
        let ch = mem_load8_at(src, p)
        if ch == 34 {
          done = 1
          p = p + 1
        } else { if ch < 32 {
          ok = 0
          done = 1
        } else { if ch == 92 {
          if p + 1 >= n {
            ok = 0
            done = 1
          } else {
            let esc = mem_load8_at(src, p + 1)
            if esc == 117 {
              let first = json_hex4(src, n, p + 2)
              if first < 0 {
                ok = 0
                done = 1
              } else {
                let mut code = first
                let mut consumed = 6
                if first >= 55296 and first <= 56319 {
                  if p + 12 > n or mem_load8_at(src, p + 6) != 92 or mem_load8_at(src, p + 7) != 117 {
                    ok = 0
                    done = 1
                  } else {
                    let low = json_hex4(src, n, p + 8)
                    if low < 56320 or low > 57343 {
                      ok = 0
                      done = 1
                    } else {
                      code = 65536 + (first - 55296) * 1024 + (low - 56320)
                      consumed = 12
                    }
                  }
                } else { if first >= 56320 and first <= 57343 {
                  ok = 0
                  done = 1
                } else { 0 } }
                if ok == 1 {
                  if utf8.is_scalar(code) {
                    let next_out = utf8_encode_scalar_into(out, out_len, code)
                    if next_out < 0 {
                      ok = 0
                      done = 1
                    } else {
                      out_len = next_out
                      p = p + consumed
                    }
                  } else {
                    ok = 0
                    done = 1
                  }
                }
              }
            } else {
              let decoded = match esc {
                34 -> 34
                47 -> 47
                92 -> 92
                98 -> 8
                102 -> 12
                110 -> 10
                114 -> 13
                116 -> 9
                _ -> 0 - 1
              }
              if decoded < 0 {
                ok = 0
                done = 1
              } else {
                mem_store8_at(out, out_len, decoded)
                out_len = out_len + 1
                p = p + 2
              }
            }
          }
        } else {
          mem_store8_at(out, out_len, ch)
          out_len = out_len + 1
          p = p + 1
        } } }
      }
    }
    if ok == 1 {
      runtime_str_set_len(value, out_len)
      json_parse_ok_result(p, JsonString(value))
    }
    else { json_parse_bad_result(p) }
  } }
}

pub(package) fn json_parse_literal(src: i64, n: i64, pos: i64, literal: str, value: Json) -> JsonParseStep {
  let len = str_len(literal)
  if json_src_eq(src, pos, n, literal) == 1 {
    json_parse_ok_result(pos + len, value)
  } else {
    json_parse_bad_result(pos)
  }
}

pub(package) fn json_parse_number_error(error: NumParseError) -> JsonParseStep {
  match error {
    NumParseEmpty(at) -> json_parse_bad_result(at)
    NumParseInvalid(at) -> json_parse_bad_result(at)
    NumParseOverflow(at) -> json_parse_bad_result(at)
    NumParseUnderflow(at) -> json_parse_bad_result(at)
    NumParseTrailing(at) -> json_parse_bad_result(at)
  }
}

pub(package) fn json_parse_float_number(src: i64, end: i64, start: i64) -> JsonParseStep {
  match num_parse_f64_prefix_bytes(src, end, start) {
    Ok((value, next)) -> if next == end {
      json_parse_ok_result(end, JsonFloat(value))
    } else {
      json_parse_bad_result(next)
    }
    Err(error) -> json_parse_number_error(error)
  }
}

pub(package) fn json_parse_number(src: i64, n: i64, pos: i64) -> JsonParseStep {
  if pos >= n { json_parse_bad_result(pos) }
  else { if mem_load8_at(src, pos) == 43 {
    json_parse_bad_result(pos)
  } else {
    let neg = if mem_load8_at(src, pos) == 45 { 1 } else { 0 }
    let integer_start = pos + neg
    if integer_start >= n or num_is_digit(mem_load8_at(src, integer_start)) == 0 {
      json_parse_bad_result(pos)
    } else { if mem_load8_at(src, integer_start) == 48 and integer_start + 1 < n and num_is_digit(mem_load8_at(src, integer_start + 1)) == 1 {
      json_parse_bad_result(pos)
    } else {
      let mut p = integer_start
      while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
      let mut floating = 0
      let mut malformed = 0
      let mut error_pos = p
      if p < n and mem_load8_at(src, p) == 46 {
        floating = 1
        p = p + 1
        let fraction_start = p
        while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
        if p == fraction_start { malformed = 1 error_pos = p } else { 0 }
      } else { 0 }
      if malformed == 0 and p < n and (mem_load8_at(src, p) == 69 or mem_load8_at(src, p) == 101) {
        floating = 1
        p = p + 1
        if p < n and (mem_load8_at(src, p) == 43 or mem_load8_at(src, p) == 45) { p = p + 1 } else { 0 }
        let exponent_start = p
        while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
        if p == exponent_start { malformed = 1 error_pos = p } else { 0 }
      } else { 0 }
      if malformed == 1 {
        json_parse_bad_result(error_pos)
      } else {
        if floating == 1 {
          json_parse_float_number(src, p, pos)
        } else {
          match num_parse_i64_prefix_bytes(src, p, pos) {
            Ok((value, next)) -> if next == p and (neg == 0 or value != 0) {
              json_parse_ok_result(p, JsonNumber(value))
            } else {
              json_parse_float_number(src, p, pos)
            }
            Err(error) -> json_parse_float_number(src, p, pos)
          }
        }
      }
    } }
  } }
}

pub(package) fn json_parse_array(src: i64, n: i64, pos: i64) -> JsonParseStep {
  let mut items: List<Json> = Nil<Json>()
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 93 {
    json_parse_ok_result(p + 1, JsonArray(items))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      match json_parse_value(src, n, p) {
        JsonParseFailed(offset) -> {
          ok = 0
          p = offset
          done = 1
          0
        }
        JsonParsed(next, value) -> {
          items = items.prepend(value)
          p = json_skip_ws(src, n, next)
          if p < n and mem_load8_at(src, p) == 44 {
            p = json_skip_ws(src, n, p + 1)
            if p < n and mem_load8_at(src, p) == 93 {
              ok = 0
              done = 1
            } else { 0 }
          } else { if p < n and mem_load8_at(src, p) == 93 {
            p = p + 1
            done = 1
          } else {
            ok = 0
            done = 1
          } }
          0
        }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonArray(items.reverse())) } else { json_parse_bad_result(p) }
  }
}

pub(package) fn json_parse_object(src: i64, n: i64, pos: i64) -> JsonParseStep {
  let mut entries: List<JsonEntry> = Nil<JsonEntry>()
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 125 {
    json_parse_ok_result(p + 1, JsonObject(entries))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      match json_parse_string_raw(src, n, p) {
        JsonParseFailed(offset) -> {
          ok = 0
          p = offset
          done = 1
          0
        }
        JsonParsed(key_next, key_value) -> {
          let key = json_string_value(key_value, "")
          p = json_skip_ws(src, n, key_next)
          if p >= n or mem_load8_at(src, p) != 58 {
            ok = 0
            done = 1
          } else {
            p = json_skip_ws(src, n, p + 1)
            match json_parse_value(src, n, p) {
              JsonParseFailed(offset) -> {
                ok = 0
                p = offset
                done = 1
                0
              }
              JsonParsed(value_next, value) -> {
                entries = entries.prepend(JsonEntry(key, value))
                p = json_skip_ws(src, n, value_next)
                if p < n and mem_load8_at(src, p) == 44 {
                  p = json_skip_ws(src, n, p + 1)
                  if p < n and mem_load8_at(src, p) == 125 {
                    ok = 0
                    done = 1
                  } else { 0 }
                } else { if p < n and mem_load8_at(src, p) == 125 {
                  p = p + 1
                  done = 1
                } else {
                  ok = 0
                  done = 1
                } }
                0
              }
            }
          }
          0
        }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonObject(entries.reverse())) } else { json_parse_bad_result(p) }
  }
}

pub(package) fn json_parse_value(src: i64, n: i64, pos: i64) -> JsonParseStep {
  let p = json_skip_ws(src, n, pos)
  if p >= n { json_parse_bad_result(p) }
  else {
    let ch = mem_load8_at(src, p)
    match ch {
      34 -> json_parse_string_raw(src, n, p)
      45 -> json_parse_number(src, n, p)
      48 -> json_parse_number(src, n, p)
      49 -> json_parse_number(src, n, p)
      50 -> json_parse_number(src, n, p)
      51 -> json_parse_number(src, n, p)
      52 -> json_parse_number(src, n, p)
      53 -> json_parse_number(src, n, p)
      54 -> json_parse_number(src, n, p)
      55 -> json_parse_number(src, n, p)
      56 -> json_parse_number(src, n, p)
      57 -> json_parse_number(src, n, p)
      91 -> json_parse_array(src, n, p)
      123 -> json_parse_object(src, n, p)
      102 -> json_parse_literal(src, n, p, "false", JsonBool(false))
      110 -> json_parse_literal(src, n, p, "null", JsonNull)
      116 -> json_parse_literal(src, n, p, "true", JsonBool(true))
      _ -> json_parse_bad_result(p)
    }
  }
}

--- Parse one complete UTF-8 JSON document, permitting surrounding whitespace.
pub(package) fn json_parse(source: str) -> Result<Json, JsonParseError> {
  let src = runtime_str_ptr(source)
  let n = runtime_str_len(source)
  if not utf8.validate(source) { Err<Json, JsonParseError>(JsonInvalidSyntax(0)) }
  else {
    match json_parse_value(src, n, 0) {
      JsonParseFailed(offset) -> Err<Json, JsonParseError>(JsonInvalidSyntax(offset))
      JsonParsed(next, value) -> {
        let end = json_skip_ws(src, n, next)
        if end == n { Ok<Json, JsonParseError>(value) }
        else { Err<Json, JsonParseError>(JsonInvalidSyntax(end)) }
      }
    }
  }
}

--- Return a JSON boolean, or `default` for another kind.
pub(package) fn json_bool_value(value: Json, default: bool) -> bool {
  match value {
    JsonBool(v) -> v
    _ -> default
  }
}

--- Return an exact JSON integer, or `default` for another kind.
pub(package) fn json_number_value(value: Json, default: i64) -> i64 {
  match value {
    JsonNumber(v) -> v
    _ -> default
  }
}

--- Return a JSON float or an integer converted to `f64`, else `default`.
pub(package) fn json_float_value(value: Json, default: f64) -> f64 {
  match value {
    JsonFloat(v) -> v
    JsonNumber(v) -> v.to_f64()
    _ -> default
  }
}

--- Return a JSON string's decoded text, or `default` for another kind.
pub(package) fn json_string_value(value: Json, default: str) -> str {
  match value {
    JsonString(v) -> v
    _ -> default
  }
}

--- Return a JSON array's length, or zero for another kind.
pub(package) fn json_array_len(value: Json) -> i64 {
  match value {
    JsonArray(items) -> json_list_len_i64(items)
    _ -> 0
  }
}

--- Return a JSON array's items, or an empty list for another kind.
pub(package) fn json_array_items(value: Json) -> List<Json> {
  match value {
    JsonArray(items) -> items
    _ -> Nil<Json>()
  }
}

--- Look up a zero-based JSON array item, returning none when absent or not an array.
pub(package) fn json_array_get(value: Json, index: i64) -> Option<Json> {
  match value {
    JsonArray(items) -> json_list_get_i64(items, index)
    _ -> None<Json>()
  }
}

--- Return a JSON object's entry count, including duplicates, or zero otherwise.
pub(package) fn json_object_len(value: Json) -> i64 {
  match value {
    JsonObject(entries) -> json_list_len_i64(entries)
    _ -> 0
  }
}

--- Return a JSON object's ordered entries, or an empty list for another kind.
pub(package) fn json_object_entries(value: Json) -> List<JsonEntry> {
  match value {
    JsonObject(entries) -> entries
    _ -> Nil<JsonEntry>()
  }
}

--- Return the first object entry matching `key`, or none when absent.
pub(package) fn json_object_get(value: Json, key: str) -> Option<Json> {
  match value {
    JsonObject(entries) -> {
      let mut result = JsonNull
      let mut found = 0
      let mut cur = entries
      let mut done = 0
      while done == 0 {
        match cur {
          Nil -> {
            done = 1
            0
          }
          Cons(entry, rest) -> {
            if str_eq(json_entry_key(entry), key) == 1 {
              result = json_entry_value(entry)
              found = 1
              done = 1
            } else {
              cur = rest
            }
            0
          }
        }
      }
      if found == 1 { Some<Json>(result) } else { None<Json>() }
    }
    _ -> None<Json>()
  }
}

--- Return the first matching object's exact integer, or `default`.
pub(package) fn json_object_get_i64(value: Json, key: str, default: i64) -> i64 {
  let opt = json_object_get(value, key)
  match opt {
    Some(found) -> json_number_value(found, default)
    None -> default
  }
}

--- Return the first matching object's decoded string, or `default`.
pub(package) fn json_object_get_str(value: Json, key: str, default: str) -> str {
  let opt = json_object_get(value, key)
  match opt {
    Some(found) -> json_string_value(found, default)
    None -> default
  }
}

--- Return the first matching object's boolean, or `default`.
pub(package) fn json_object_get_bool(value: Json, key: str, default: bool) -> bool {
  let opt = json_object_get(value, key)
  match opt {
    Some(found) -> json_bool_value(found, default)
    None -> default
  }
}

pub(package) fn json_hex_digit(value: i64) -> i64 {
  if value < 10 { 48 + value } else { 65 + value - 10 }
}

pub(package) fn json_write_u00_escape(out: i64, pos: i64, ch: i64) -> i64 {
  mem_store8_at(out, pos, 92)
  mem_store8_at(out, pos + 1, 117)
  mem_store8_at(out, pos + 2, 48)
  mem_store8_at(out, pos + 3, 48)
  mem_store8_at(out, pos + 4, json_hex_digit(ch / 16))
  mem_store8_at(out, pos + 5, json_hex_digit(ch - ch / 16 * 16))
  pos + 6
}

--- Quote and escape decoded text as a JSON string token.
pub(package) fn json_quote_string(s: str) -> str {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  let value = runtime_str_alloc_uninit(n * 6 + 2)
  let out = runtime_str_ptr(value)
  let mut p = 0
  mem_store8_at(out, p, 34)
  p = p + 1
  for i in 0..n {
    let ch = mem_load8_at(src, i)
    if ch == 34 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 34)
      p = p + 2
    } else { if ch == 92 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 92)
      p = p + 2
    } else { if ch == 8 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 98)
      p = p + 2
    } else { if ch == 12 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 102)
      p = p + 2
    } else { if ch == 10 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 110)
      p = p + 2
    } else { if ch == 13 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 114)
      p = p + 2
    } else { if ch == 9 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 116)
      p = p + 2
    } else { if ch < 32 {
      p = json_write_u00_escape(out, p, ch)
    } else {
      mem_store8_at(out, p, ch)
      p = p + 1
    } } } } } } } }
  }
  mem_store8_at(out, p, 34)
  p = p + 1
  runtime_str_set_len(value, p)
  value
}

pub(package) fn json_all_numbers_finite(value: Json) -> bool {
  match value {
    JsonFloat(number) -> number.is_finite()
    JsonArray(items) -> {
      let mut cur = items
      let mut finite = true
      let mut done = false
      while not done and finite {
        match cur {
          Nil -> { done = true }
          Cons(value, rest) -> {
            finite = json_all_numbers_finite(value)
            cur = rest
          }
        }
      }
      finite
    }
    JsonObject(entries) -> {
      let mut cur = entries
      let mut finite = true
      let mut done = false
      while not done and finite {
        match cur {
          Nil -> { done = true }
          Cons(entry, rest) -> {
            finite = json_all_numbers_finite(json_entry_value(entry))
            cur = rest
          }
        }
      }
      finite
    }
    _ -> true
  }
}

pub(package) fn json_stringify_array_raw(items: List<Json>) -> str {
  let mut out = "["
  let mut cur = items
  let mut first = 1
  let mut done = false
  while not done {
    match cur {
      Nil -> { done = true }
      Cons(value, rest) -> {
        if first == 0 { out = str_concat(out, ",") } else { first = 0 }
        out = str_concat(out, json_stringify_raw(value))
        cur = rest
      }
    }
  }
  str_concat(out, "]")
}

pub(package) fn json_stringify_object_raw(entries: List<JsonEntry>) -> str {
  let mut out = "{"
  let mut cur = entries
  let mut first = 1
  let mut done = false
  while not done {
    match cur {
      Nil -> { done = true }
      Cons(entry, rest) -> {
        if first == 0 { out = str_concat(out, ",") } else { first = 0 }
        out = str_concat(out, json_quote_string(json_entry_key(entry)))
        out = str_concat(out, ":")
        out = str_concat(out, json_stringify_raw(json_entry_value(entry)))
        cur = rest
      }
    }
  }
  str_concat(out, "}")
}

pub(package) fn json_stringify_raw(value: Json) -> str {
  match value {
    JsonNull -> "null"
    JsonBool(v) -> if v { "true" } else { "false" }
    JsonNumber(v) -> int_to_str(v)
    JsonFloat(v) -> num_render_f64(v)
    JsonString(v) -> json_quote_string(v)
    JsonArray(items) -> json_stringify_array_raw(items)
    JsonObject(entries) -> json_stringify_object_raw(entries)
  }
}

--- Encode one complete JSON document, rejecting non-finite numbers.
pub(package) fn json_stringify(value: Json) -> Result<str, JsonStringifyError> {
  if json_all_numbers_finite(value) {
    Ok<str, JsonStringifyError>(json_stringify_raw(value))
  } else {
    Err<str, JsonStringifyError>(JsonNonFiniteNumber)
  }
}

--- Parse one complete UTF-8 JSON document, permitting surrounding whitespace.
pub fn parse(source: str) -> Result<Json, JsonParseError> { json_parse(source) }

impl JsonEntry {
  --- Return the decoded object key.
  pub fn key(self) -> str { json_entry_key(self) }

  --- Return the entry value.
  pub fn value(self) -> Json { json_entry_value(self) }
}

impl Json {
  --- Return the boolean payload, or `None` for another JSON alternative.
  pub fn as_bool(self) -> Option<bool> {
    match self { JsonBool(value) -> Some<bool>(value) _ -> None<bool>() }
  }

  --- Return the exact integer payload, or `None` for another alternative.
  pub fn as_i64(self) -> Option<i64> {
    match self { JsonNumber(value) -> Some<i64>(value) _ -> None<i64>() }
  }

  --- Return a floating payload, converting an exact integer when necessary.
  pub fn as_f64(self) -> Option<f64> {
    match self {
      JsonFloat(value) -> Some<f64>(value)
      JsonNumber(value) -> Some<f64>(value.to_f64())
      _ -> None<f64>()
    }
  }

  --- Return the decoded string payload, or `None` for another alternative.
  pub fn as_str(self) -> Option<str> {
    match self { JsonString(value) -> Some<str>(value) _ -> None<str>() }
  }

  --- Return ordered array items, or `None` for another alternative.
  pub fn items(self) -> Option<List<Json>> {
    match self { JsonArray(items) -> Some<List<Json>>(items) _ -> None<List<Json>>() }
  }

  --- Return ordered object entries, including duplicates, or `None` otherwise.
  pub fn entries(self) -> Option<List<JsonEntry>> {
    match self { JsonObject(entries) -> Some<List<JsonEntry>>(entries) _ -> None<List<JsonEntry>>() }
  }

  --- Return the array item at `index`, or `None` when absent or not an array.
  pub fn at(self, index: i64) -> Option<Json> { json_array_get(self, index) }

  --- Return the first object value for `key`, or `None` when absent or not an object.
  pub fn get(self, key: str) -> Option<Json> { json_object_get(self, key) }

  --- Return an array or object's length, or `None` for a scalar value.
  pub fn len(self) -> Option<i64> {
    match self {
      JsonArray(items) -> Some<i64>(json_list_len_i64(items))
      JsonObject(entries) -> Some<i64>(json_list_len_i64(entries))
      _ -> None<i64>()
    }
  }

  --- Encode one complete JSON document, rejecting non-finite numbers.
  pub fn stringify(self) -> Result<str, JsonStringifyError> { json_stringify(self) }
}
