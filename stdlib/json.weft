-- stdlib/json.weft — JSON values, parser, accessors, and emitter
--
-- Numbers are i64 in this first stdlib slice. Fractional/exponent forms are
-- rejected until Weft has a broader numeric story in the stdlib.

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "stdlib/option.weft"
use "stdlib/string.weft"
use "stdlib/utf8.weft"
use "stdlib/vector.weft"

type Json {
  JsonNull,
  JsonBool(i64),
  JsonNumber(i64),
  JsonString(str),
  JsonArray(i64),
  JsonObject(i64)
}

type JsonEntry {
  JsonEntry(str, Json)
}

fn json_null() -> Json { JsonNull }
fn json_bool(value: i64) -> Json { JsonBool(value) }
fn json_number(value: i64) -> Json { JsonNumber(value) }
fn json_string(value: str) -> Json { JsonString(value) }
fn json_array(items: i64) -> Json { JsonArray(items) }
fn json_object(entries: i64) -> Json { JsonObject(entries) }
fn json_entry(key: str, value: Json) -> JsonEntry { JsonEntry(key, value) }

fn json_kind(value: Json) -> i64 {
  match value {
    JsonNull -> 0
    JsonBool(v) -> 1
    JsonNumber(v) -> 2
    JsonString(v) -> 3
    JsonArray(v) -> 4
    JsonObject(v) -> 5
  }
}

fn json_entry_key(entry: JsonEntry) -> str {
  match entry {
    JsonEntry(key, value) -> key
  }
}

fn json_entry_value(entry: JsonEntry) -> Json {
  match entry {
    JsonEntry(key, value) -> value
  }
}

fn json_parse_result(ok: i64, pos: i64, value: Json) -> i64 {
  let result = alloc_bump(24)
  __mem_store64(result, ok)
  __mem_store64(result + 8, pos)
  __mem_store64(result + 16, value)
  result
}

fn json_parse_ok_result(pos: i64, value: Json) -> i64 {
  json_parse_result(1, pos, value)
}

fn json_parse_bad_result(pos: i64) -> i64 {
  json_parse_result(0, pos, JsonNull)
}

fn json_result_ok(result: i64) -> i64 { __mem_load64(result) }
fn json_result_pos(result: i64) -> i64 { __mem_load64(result + 8) }
fn json_result_value(result: i64) -> Json { __mem_load64(result + 16) }

fn json_is_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 }
  else { if ch == 9 { 1 } else { 0 } } } }
}

fn json_skip_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and json_is_ws(__mem_load8(src + p)) == 1 {
    p = p + 1
  }
  p
}

fn json_is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}

fn json_hex_value(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { ch - 48 }
  else { if ch >= 65 and ch <= 70 { ch - 55 }
  else { if ch >= 97 and ch <= 102 { ch - 87 }
  else { 0 - 1 } } }
}

fn json_src_eq(src: i64, pos: i64, n: i64, literal: str) -> i64 {
  let len = __str_len(literal)
  if pos + len > n { 0 }
  else {
    let lit = __str_ptr(literal)
    let mut ok = 1
    let mut i = 0
    while i < len {
      if __mem_load8(src + pos + i) != __mem_load8(lit + i) {
        ok = 0
        i = len
      } else { i = i + 1 }
    }
    ok
  }
}

fn json_string_from_bytes(data: i64, len: i64) -> str {
  let out = alloc_bump_rounded(len, 8)
  mem_copy(out, data, len)
  let desc = alloc_words(2)
  __mem_store64(desc, out)
  __mem_store64(desc + 8, len)
  desc
}

fn json_parse_string_raw(src: i64, n: i64, pos: i64) -> i64 {
  if pos >= n { json_parse_bad_result(pos) }
  else { if __mem_load8(src + pos) != 34 { json_parse_bad_result(pos) }
  else {
    let out = alloc_bump(n - pos)
    let mut out_len = 0
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      if p >= n {
        ok = 0
        done = 1
      } else {
        let ch = __mem_load8(src + p)
        if ch == 34 {
          done = 1
          p = p + 1
        } else { if ch < 32 {
          ok = 0
          done = 1
        } else { if ch == 92 {
          if p + 1 >= n {
            ok = 0
            done = 1
          } else {
            let esc = __mem_load8(src + p + 1)
            if esc == 117 {
              if p + 5 >= n {
                ok = 0
                done = 1
              } else {
                let h1 = json_hex_value(__mem_load8(src + p + 2))
                let h2 = json_hex_value(__mem_load8(src + p + 3))
                let h3 = json_hex_value(__mem_load8(src + p + 4))
                let h4 = json_hex_value(__mem_load8(src + p + 5))
                if h1 < 0 or h2 < 0 or h3 < 0 or h4 < 0 {
                  ok = 0
                  done = 1
                } else {
                  let code = h1 * 4096 + h2 * 256 + h3 * 16 + h4
                  if utf8_scalar_is_valid(code) == 1 {
                    let next_out = utf8_encode_scalar_into(out, out_len, code)
                    if next_out < 0 {
                      ok = 0
                      done = 1
                    } else {
                      out_len = next_out
                      p = p + 6
                    }
                  } else {
                    ok = 0
                    done = 1
                  }
                }
              }
            } else {
              let decoded = match esc {
                34 -> 34
                47 -> 47
                92 -> 92
                98 -> 8
                102 -> 12
                110 -> 10
                114 -> 13
                116 -> 9
                _ -> 0 - 1
              }
              if decoded < 0 {
                ok = 0
                done = 1
              } else {
                __mem_store8(out + out_len, decoded)
                out_len = out_len + 1
                p = p + 2
              }
            }
          }
        } else {
          __mem_store8(out + out_len, ch)
          out_len = out_len + 1
          p = p + 1
        } } }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonString(json_string_from_bytes(out, out_len))) }
    else { json_parse_bad_result(p) }
  } }
}

fn json_parse_literal(src: i64, n: i64, pos: i64, literal: str, value: Json) -> i64 {
  let len = __str_len(literal)
  if json_src_eq(src, pos, n, literal) == 1 {
    json_parse_ok_result(pos + len, value)
  } else {
    json_parse_bad_result(pos)
  }
}

fn json_parse_number(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  let mut neg = 0
  if p < n and __mem_load8(src + p) == 45 {
    neg = 1
    p = p + 1
  } else { 0 }
  if p >= n { json_parse_bad_result(pos) }
  else {
    let first = __mem_load8(src + p)
    if json_is_digit(first) == 0 { json_parse_bad_result(pos) }
    else {
      let leading_zero = if first == 48 { 1 } else { 0 }
      let mut value = 0
      while p < n and json_is_digit(__mem_load8(src + p)) == 1 {
        value = value * 10 + (__mem_load8(src + p) - 48)
        p = p + 1
      }
      if leading_zero == 1 and p > pos + neg + 1 {
        json_parse_bad_result(pos)
      } else { if p < n and (__mem_load8(src + p) == 46 or __mem_load8(src + p) == 69 or __mem_load8(src + p) == 101) {
        json_parse_bad_result(p)
      } else {
        json_parse_ok_result(p, JsonNumber(if neg == 1 { 0 - value } else { value }))
      } }
    }
  }
}

fn json_parse_array(src: i64, n: i64, pos: i64) -> i64 {
  let items = vector_with_capacity<Json>(4)
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and __mem_load8(src + p) == 93 {
    json_parse_ok_result(p + 1, JsonArray(items))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      let parsed = json_parse_value(src, n, p)
      if json_result_ok(parsed) == 0 {
        ok = 0
        p = json_result_pos(parsed)
        done = 1
      } else {
        vector_push<Json>(items, json_result_value(parsed))
        p = json_skip_ws(src, n, json_result_pos(parsed))
        if p < n and __mem_load8(src + p) == 44 {
          p = json_skip_ws(src, n, p + 1)
          if p < n and __mem_load8(src + p) == 93 {
            ok = 0
            done = 1
          } else { 0 }
        } else { if p < n and __mem_load8(src + p) == 93 {
          p = p + 1
          done = 1
        } else {
          ok = 0
          done = 1
        } }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonArray(items)) } else { json_parse_bad_result(p) }
  }
}

fn json_parse_object(src: i64, n: i64, pos: i64) -> i64 {
  let entries = vector_with_capacity<JsonEntry>(4)
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and __mem_load8(src + p) == 125 {
    json_parse_ok_result(p + 1, JsonObject(entries))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      let key_result = json_parse_string_raw(src, n, p)
      if json_result_ok(key_result) == 0 {
        ok = 0
        p = json_result_pos(key_result)
        done = 1
      } else {
        let key = json_string_value(json_result_value(key_result), "")
        p = json_skip_ws(src, n, json_result_pos(key_result))
        if p >= n or __mem_load8(src + p) != 58 {
          ok = 0
          done = 1
        } else {
          p = json_skip_ws(src, n, p + 1)
          let value_result = json_parse_value(src, n, p)
          if json_result_ok(value_result) == 0 {
            ok = 0
            p = json_result_pos(value_result)
            done = 1
          } else {
            vector_push<JsonEntry>(entries, JsonEntry(key, json_result_value(value_result)))
            p = json_skip_ws(src, n, json_result_pos(value_result))
            if p < n and __mem_load8(src + p) == 44 {
              p = json_skip_ws(src, n, p + 1)
              if p < n and __mem_load8(src + p) == 125 {
                ok = 0
                done = 1
              } else { 0 }
            } else { if p < n and __mem_load8(src + p) == 125 {
              p = p + 1
              done = 1
            } else {
              ok = 0
              done = 1
            } }
          }
        }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonObject(entries)) } else { json_parse_bad_result(p) }
  }
}

fn json_parse_value(src: i64, n: i64, pos: i64) -> i64 {
  let p = json_skip_ws(src, n, pos)
  if p >= n { json_parse_bad_result(p) }
  else {
    let ch = __mem_load8(src + p)
    match ch {
      34 -> json_parse_string_raw(src, n, p)
      45 -> json_parse_number(src, n, p)
      48 -> json_parse_number(src, n, p)
      49 -> json_parse_number(src, n, p)
      50 -> json_parse_number(src, n, p)
      51 -> json_parse_number(src, n, p)
      52 -> json_parse_number(src, n, p)
      53 -> json_parse_number(src, n, p)
      54 -> json_parse_number(src, n, p)
      55 -> json_parse_number(src, n, p)
      56 -> json_parse_number(src, n, p)
      57 -> json_parse_number(src, n, p)
      91 -> json_parse_array(src, n, p)
      123 -> json_parse_object(src, n, p)
      102 -> json_parse_literal(src, n, p, "false", JsonBool(0))
      110 -> json_parse_literal(src, n, p, "null", JsonNull)
      116 -> json_parse_literal(src, n, p, "true", JsonBool(1))
      _ -> json_parse_bad_result(p)
    }
  }
}

fn json_parse(source: str) -> i64 {
  let src = __str_ptr(source)
  let n = __str_len(source)
  let parsed = json_parse_value(src, n, 0)
  if json_result_ok(parsed) == 0 { parsed }
  else {
    let end = json_skip_ws(src, n, json_result_pos(parsed))
    if end == n { parsed } else { json_parse_bad_result(end) }
  }
}

fn json_bool_value(value: Json, default: i64) -> i64 {
  match value {
    JsonBool(v) -> v
    _ -> default
  }
}

fn json_number_value(value: Json, default: i64) -> i64 {
  match value {
    JsonNumber(v) -> v
    _ -> default
  }
}

fn json_string_value(value: Json, default: str) -> str {
  match value {
    JsonString(v) -> v
    _ -> default
  }
}

fn json_array_len(value: Json) -> i64 {
  match value {
    JsonArray(items) -> vector_len(items)
    _ -> 0
  }
}

fn json_array_items(value: Json) -> i64 {
  match value {
    JsonArray(items) -> items
    _ -> vector_new<Json>()
  }
}

fn json_array_get(value: Json, index: i64) -> i64 {
  match value {
    JsonArray(items) -> vector_get_option<Json>(items, index)
    _ -> None
  }
}

fn json_object_len(value: Json) -> i64 {
  match value {
    JsonObject(entries) -> vector_len(entries)
    _ -> 0
  }
}

fn json_object_entries(value: Json) -> i64 {
  match value {
    JsonObject(entries) -> entries
    _ -> vector_new<JsonEntry>()
  }
}

fn json_object_get(value: Json, key: str) -> i64 {
  match value {
    JsonObject(entries) -> {
      let mut result = None
      let mut i = 0
      let mut done = 0
      while done == 0 and i < vector_len(entries) {
        let entry = vector_get<JsonEntry>(entries, i, JsonEntry("", JsonNull))
        if str_eq(json_entry_key(entry), key) == 1 {
          result = Some<Json>(json_entry_value(entry))
          done = 1
        } else {
          i = i + 1
        }
      }
      result
    }
    _ -> None
  }
}

fn json_option_is_some(opt: i64) -> i64 {
  match opt {
    Some(v) -> 1
    None -> 0
  }
}

fn json_option_value_or(opt: i64, default: Json) -> Json {
  match opt {
    Some(v) -> v
    None -> default
  }
}

fn json_object_get_i64(value: Json, key: str, default: i64) -> i64 {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_number_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

fn json_object_get_str(value: Json, key: str, default: str) -> str {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_string_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

fn json_object_get_bool(value: Json, key: str, default: i64) -> i64 {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_bool_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

fn json_hex_digit(value: i64) -> i64 {
  if value < 10 { 48 + value } else { 65 + value - 10 }
}

fn json_write_u00_escape(out: i64, pos: i64, ch: i64) -> i64 {
  __mem_store8(out + pos, 92)
  __mem_store8(out + pos + 1, 117)
  __mem_store8(out + pos + 2, 48)
  __mem_store8(out + pos + 3, 48)
  __mem_store8(out + pos + 4, json_hex_digit(ch / 16))
  __mem_store8(out + pos + 5, json_hex_digit(ch - ch / 16 * 16))
  pos + 6
}

fn json_quote_string(s: str) -> str {
  let src = __str_ptr(s)
  let n = __str_len(s)
  let out = alloc_bump_rounded(n * 6 + 2, 8)
  let mut p = 0
  __mem_store8(out + p, 34)
  p = p + 1
  for i in 0..n {
    let ch = __mem_load8(src + i)
    if ch == 34 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 34)
      p = p + 2
    } else { if ch == 92 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 92)
      p = p + 2
    } else { if ch == 8 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 98)
      p = p + 2
    } else { if ch == 12 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 102)
      p = p + 2
    } else { if ch == 10 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 110)
      p = p + 2
    } else { if ch == 13 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 114)
      p = p + 2
    } else { if ch == 9 {
      __mem_store8(out + p, 92)
      __mem_store8(out + p + 1, 116)
      p = p + 2
    } else { if ch < 32 {
      p = json_write_u00_escape(out, p, ch)
    } else {
      __mem_store8(out + p, ch)
      p = p + 1
    } } } } } } } }
  }
  __mem_store8(out + p, 34)
  p = p + 1
  json_string_from_bytes(out, p)
}

fn json_stringify_array(items: i64) -> str {
  let mut out = "["
  for i in 0..vector_len(items) {
    if i > 0 { out = str_concat(out, ",") } else { 0 }
    out = str_concat(out, json_stringify(vector_get<Json>(items, i, JsonNull)))
  }
  str_concat(out, "]")
}

fn json_stringify_object(entries: i64) -> str {
  let mut out = "{"
  for i in 0..vector_len(entries) {
    if i > 0 { out = str_concat(out, ",") } else { 0 }
    let entry = vector_get<JsonEntry>(entries, i, JsonEntry("", JsonNull))
    out = str_concat(out, json_quote_string(json_entry_key(entry)))
    out = str_concat(out, ":")
    out = str_concat(out, json_stringify(json_entry_value(entry)))
  }
  str_concat(out, "}")
}

fn json_stringify(value: Json) -> str {
  match value {
    JsonNull -> "null"
    JsonBool(v) -> if v == 0 { "false" } else { "true" }
    JsonNumber(v) -> int_to_str(v)
    JsonString(v) -> json_quote_string(v)
    JsonArray(items) -> json_stringify_array(items)
    JsonObject(entries) -> json_stringify_object(entries)
  }
}
