-- stdlib/json.weft — JSON values, parser, accessors, and emitter
--
-- Integral numbers retain exact i64 identity; fractional, exponent, signed
-- zero, and wider numeric spellings use finite IEEE f64 identity.

use runtime/memory.{*}
use runtime/string.{*}
use stdlib/num.{*}
use stdlib/list.{*}
use stdlib/math.{math_is_finite_f64}
use stdlib/string.{*}
use stdlib/utf8.{*}

--- A JSON value with exact `i64` and finite-or-nonfinite `f64` number cases.
pub type Json {
  --- The JSON `null` value.
  JsonNull,
  --- A JSON boolean; zero is false and any nonzero value is true.
  JsonBool(i64),
  --- A JSON number represented exactly as an `i64`.
  JsonNumber(i64),
  --- A JSON number represented as an `f64`.
  JsonFloat(f64),
  --- A JSON string containing decoded text.
  JsonString(str),
  --- A JSON array whose list order is its document order.
  JsonArray(List<Json>),
  --- A JSON object whose entry list preserves document order and duplicates.
  JsonObject(List<JsonEntry>)
}

--- A key-value entry in a JSON object.
pub type JsonEntry {
  --- Pair a decoded string key with its JSON value.
  JsonEntry(str, Json)
}

--- The result of parsing JSON, including a byte position.
pub type JsonResult {
  --- A parse flag, next-or-error byte position, and parsed value.
  JsonResult(i64, i64, Json)
}

--- An optional JSON value returned by collection lookups.
pub type JsonOption {
  --- A lookup that found a JSON value.
  JsonSome(Json),
  --- A lookup with no matching value.
  JsonNone
}

--- The explicit success or failure result of JSON stringification.
pub type JsonStringifyResult {
  --- A successfully encoded JSON document.
  JsonStringifyOk(str),
  --- Failure because the value contains a non-finite floating-point number.
  JsonStringifyErr
}

--- Construct the JSON `null` value.
pub fn json_null() -> Json { JsonNull }
--- Construct a JSON boolean, where zero is false and nonzero is true.
pub fn json_bool(value: i64) -> Json { JsonBool(value) }
--- Construct a JSON number with exact `i64` identity.
pub fn json_number(value: i64) -> Json { JsonNumber(value) }
--- Construct a JSON number with `f64` identity.
pub fn json_float(value: f64) -> Json { JsonFloat(value) }
--- Construct a JSON string from decoded text.
pub fn json_string(value: str) -> Json { JsonString(value) }
--- Construct a JSON array preserving the list's order.
pub fn json_array(items: List<Json>) -> Json { JsonArray(items) }
--- Construct a JSON object preserving entry order and duplicate keys.
pub fn json_object(entries: List<JsonEntry>) -> Json { JsonObject(entries) }
--- Construct a JSON object entry.
pub fn json_entry(key: str, value: Json) -> JsonEntry { JsonEntry(key, value) }

--- Return `0` null, `1` boolean, `2` number, `3` string, `4` array, or `5` object.
pub fn json_kind(value: Json) -> i64 {
  match value {
    JsonNull -> 0
    JsonBool(v) -> 1
    JsonNumber(v) -> 2
    JsonFloat(v) -> 2
    JsonString(v) -> 3
    JsonArray(v) -> 4
    JsonObject(v) -> 5
  }
}

--- Return an object's decoded entry key.
pub fn json_entry_key(entry: JsonEntry) -> str {
  match entry {
    JsonEntry(key, value) -> key
  }
}

--- Return an object's entry value.
pub fn json_entry_value(entry: JsonEntry) -> Json {
  match entry {
    JsonEntry(key, value) -> value
  }
}

pub(package) fn json_parse_result(ok: i64, pos: i64, value: Json) -> JsonResult {
  JsonResult(ok, pos, value)
}

pub(package) fn json_parse_ok_result(pos: i64, value: Json) -> JsonResult {
  json_parse_result(1, pos, value)
}

pub(package) fn json_parse_bad_result(pos: i64) -> JsonResult {
  json_parse_result(0, pos, JsonNull)
}

--- Return `1` for a successful parse and `0` for failure.
pub fn json_result_ok(result: JsonResult) -> i64 {
  match result {
    JsonResult(ok, pos, value) -> ok
  }
}

--- Return the next byte position on success or the error byte position on failure.
pub fn json_result_pos(result: JsonResult) -> i64 {
  match result {
    JsonResult(ok, pos, value) -> pos
  }
}

--- Return the parsed value; failed parses carry `JsonNull`.
pub fn json_result_value(result: JsonResult) -> Json {
  match result {
    JsonResult(ok, pos, value) -> value
  }
}

pub(package) fn json_is_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 }
  else { if ch == 9 { 1 } else { 0 } } } }
}

pub(package) fn json_skip_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and json_is_ws(mem_load8_at(src, p)) == 1 {
    p = p + 1
  }
  p
}

pub(package) fn json_is_digit(ch: i64) -> i64 {
  if ch >= 48 { if ch <= 57 { 1 } else { 0 } } else { 0 }
}

pub(package) fn json_hex_value(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { ch - 48 }
  else { if ch >= 65 and ch <= 70 { ch - 55 }
  else { if ch >= 97 and ch <= 102 { ch - 87 }
  else { 0 - 1 } } }
}

pub(package) fn json_hex4(src: i64, n: i64, pos: i64) -> i64 {
  if pos < 0 or pos + 4 > n { 0 - 1 }
  else {
    let h1 = json_hex_value(mem_load8_at(src, pos))
    let h2 = json_hex_value(mem_load8_at(src, pos + 1))
    let h3 = json_hex_value(mem_load8_at(src, pos + 2))
    let h4 = json_hex_value(mem_load8_at(src, pos + 3))
    if h1 < 0 or h2 < 0 or h3 < 0 or h4 < 0 { 0 - 1 }
    else { h1 * 4096 + h2 * 256 + h3 * 16 + h4 }
  }
}

pub(package) fn json_src_eq(src: i64, pos: i64, n: i64, literal: str) -> i64 {
  let len = str_len(literal)
  if pos + len > n { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < len {
      if mem_load8_at(src, pos + i) != str_byte_at(literal, i) {
        ok = 0
        i = len
      } else { i = i + 1 }
    }
    ok
  }
}

pub(package) fn json_string_from_bytes(data: i64, len: i64) -> str {
  runtime_str_from_bytes(data, len)
}

pub(package) fn json_parse_string_raw(src: i64, n: i64, pos: i64) -> JsonResult {
  if pos >= n { json_parse_bad_result(pos) }
  else { if mem_load8_at(src, pos) != 34 { json_parse_bad_result(pos) }
  else {
    let value = runtime_str_alloc_uninit(n - pos)
    let out = runtime_str_ptr(value)
    let mut out_len = 0
    let mut p = pos + 1
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      if p >= n {
        ok = 0
        done = 1
      } else {
        let ch = mem_load8_at(src, p)
        if ch == 34 {
          done = 1
          p = p + 1
        } else { if ch < 32 {
          ok = 0
          done = 1
        } else { if ch == 92 {
          if p + 1 >= n {
            ok = 0
            done = 1
          } else {
            let esc = mem_load8_at(src, p + 1)
            if esc == 117 {
              let first = json_hex4(src, n, p + 2)
              if first < 0 {
                ok = 0
                done = 1
              } else {
                let mut code = first
                let mut consumed = 6
                if first >= 55296 and first <= 56319 {
                  if p + 12 > n or mem_load8_at(src, p + 6) != 92 or mem_load8_at(src, p + 7) != 117 {
                    ok = 0
                    done = 1
                  } else {
                    let low = json_hex4(src, n, p + 8)
                    if low < 56320 or low > 57343 {
                      ok = 0
                      done = 1
                    } else {
                      code = 65536 + (first - 55296) * 1024 + (low - 56320)
                      consumed = 12
                    }
                  }
                } else { if first >= 56320 and first <= 57343 {
                  ok = 0
                  done = 1
                } else { 0 } }
                if ok == 1 {
                  if utf8_scalar_is_valid(code) {
                    let next_out = utf8_encode_scalar_into(out, out_len, code)
                    if next_out < 0 {
                      ok = 0
                      done = 1
                    } else {
                      out_len = next_out
                      p = p + consumed
                    }
                  } else {
                    ok = 0
                    done = 1
                  }
                }
              }
            } else {
              let decoded = match esc {
                34 -> 34
                47 -> 47
                92 -> 92
                98 -> 8
                102 -> 12
                110 -> 10
                114 -> 13
                116 -> 9
                _ -> 0 - 1
              }
              if decoded < 0 {
                ok = 0
                done = 1
              } else {
                mem_store8_at(out, out_len, decoded)
                out_len = out_len + 1
                p = p + 2
              }
            }
          }
        } else {
          mem_store8_at(out, out_len, ch)
          out_len = out_len + 1
          p = p + 1
        } } }
      }
    }
    if ok == 1 {
      runtime_str_set_len(value, out_len)
      json_parse_ok_result(p, JsonString(value))
    }
    else { json_parse_bad_result(p) }
  } }
}

pub(package) fn json_parse_literal(src: i64, n: i64, pos: i64, literal: str, value: Json) -> JsonResult {
  let len = str_len(literal)
  if json_src_eq(src, pos, n, literal) == 1 {
    json_parse_ok_result(pos + len, value)
  } else {
    json_parse_bad_result(pos)
  }
}

pub(package) fn json_parse_number(src: i64, n: i64, pos: i64) -> JsonResult {
  if pos >= n { json_parse_bad_result(pos) }
  else { if mem_load8_at(src, pos) == 43 {
    json_parse_bad_result(pos)
  } else {
    let neg = if mem_load8_at(src, pos) == 45 { 1 } else { 0 }
    let integer_start = pos + neg
    if integer_start >= n or num_is_digit(mem_load8_at(src, integer_start)) == 0 {
      json_parse_bad_result(pos)
    } else { if mem_load8_at(src, integer_start) == 48 and integer_start + 1 < n and num_is_digit(mem_load8_at(src, integer_start + 1)) == 1 {
      json_parse_bad_result(pos)
    } else {
      let mut p = integer_start
      while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
      let mut floating = 0
      let mut malformed = 0
      let mut error_pos = p
      if p < n and mem_load8_at(src, p) == 46 {
        floating = 1
        p = p + 1
        let fraction_start = p
        while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
        if p == fraction_start { malformed = 1 error_pos = p } else { 0 }
      } else { 0 }
      if malformed == 0 and p < n and (mem_load8_at(src, p) == 69 or mem_load8_at(src, p) == 101) {
        floating = 1
        p = p + 1
        if p < n and (mem_load8_at(src, p) == 43 or mem_load8_at(src, p) == 45) { p = p + 1 } else { 0 }
        let exponent_start = p
        while p < n and num_is_digit(mem_load8_at(src, p)) == 1 { p = p + 1 }
        if p == exponent_start { malformed = 1 error_pos = p } else { 0 }
      } else { 0 }
      if malformed == 1 {
        json_parse_bad_result(error_pos)
      } else {
        let integer = num_parse_i64_prefix_bytes(src, p, pos)
        if floating == 0 and neg == 0 and num_parse_i64_is_ok(integer) == 1 {
          json_parse_ok_result(p, JsonNumber(num_parse_i64_value_or(integer, 0)))
        } else { if floating == 0 and neg == 1 and num_parse_i64_is_ok(integer) == 1 and num_parse_i64_value_or(integer, 1) != 0 {
          json_parse_ok_result(p, JsonNumber(num_parse_i64_value_or(integer, 0)))
        } else {
          let parsed = num_parse_f64_prefix_bytes(src, p, pos)
          if num_parse_f64_is_ok(parsed) == 1 and num_parse_f64_next_pos(parsed) == p {
            json_parse_ok_result(p, JsonFloat(num_parse_f64_value_or(parsed, 0.0)))
          } else { json_parse_bad_result(num_parse_f64_error_pos(parsed)) }
        } }
      }
    } }
  } }
}

pub(package) fn json_parse_array(src: i64, n: i64, pos: i64) -> JsonResult {
  let mut items: List<Json> = list_nil<Json>()
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 93 {
    json_parse_ok_result(p + 1, JsonArray(items))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      let parsed = json_parse_value(src, n, p)
      if json_result_ok(parsed) == 0 {
        ok = 0
        p = json_result_pos(parsed)
        done = 1
      } else {
        items = list_cons<Json>(json_result_value(parsed), items)
        p = json_skip_ws(src, n, json_result_pos(parsed))
        if p < n and mem_load8_at(src, p) == 44 {
          p = json_skip_ws(src, n, p + 1)
          if p < n and mem_load8_at(src, p) == 93 {
            ok = 0
            done = 1
          } else { 0 }
        } else { if p < n and mem_load8_at(src, p) == 93 {
          p = p + 1
          done = 1
        } else {
          ok = 0
          done = 1
        } }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonArray(list_reverse<Json>(items))) } else { json_parse_bad_result(p) }
  }
}

pub(package) fn json_parse_object(src: i64, n: i64, pos: i64) -> JsonResult {
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  let mut p = json_skip_ws(src, n, pos + 1)
  if p < n and mem_load8_at(src, p) == 125 {
    json_parse_ok_result(p + 1, JsonObject(entries))
  } else {
    let mut done = 0
    let mut ok = 1
    while done == 0 {
      let key_result = json_parse_string_raw(src, n, p)
      if json_result_ok(key_result) == 0 {
        ok = 0
        p = json_result_pos(key_result)
        done = 1
      } else {
        let key = json_string_value(json_result_value(key_result), "")
        p = json_skip_ws(src, n, json_result_pos(key_result))
        if p >= n or mem_load8_at(src, p) != 58 {
          ok = 0
          done = 1
        } else {
          p = json_skip_ws(src, n, p + 1)
          let value_result = json_parse_value(src, n, p)
          if json_result_ok(value_result) == 0 {
            ok = 0
            p = json_result_pos(value_result)
            done = 1
          } else {
            entries = list_cons<JsonEntry>(JsonEntry(key, json_result_value(value_result)), entries)
            p = json_skip_ws(src, n, json_result_pos(value_result))
            if p < n and mem_load8_at(src, p) == 44 {
              p = json_skip_ws(src, n, p + 1)
              if p < n and mem_load8_at(src, p) == 125 {
                ok = 0
                done = 1
              } else { 0 }
            } else { if p < n and mem_load8_at(src, p) == 125 {
              p = p + 1
              done = 1
            } else {
              ok = 0
              done = 1
            } }
          }
        }
      }
    }
    if ok == 1 { json_parse_ok_result(p, JsonObject(list_reverse<JsonEntry>(entries))) } else { json_parse_bad_result(p) }
  }
}

pub(package) fn json_parse_value(src: i64, n: i64, pos: i64) -> JsonResult {
  let p = json_skip_ws(src, n, pos)
  if p >= n { json_parse_bad_result(p) }
  else {
    let ch = mem_load8_at(src, p)
    match ch {
      34 -> json_parse_string_raw(src, n, p)
      45 -> json_parse_number(src, n, p)
      48 -> json_parse_number(src, n, p)
      49 -> json_parse_number(src, n, p)
      50 -> json_parse_number(src, n, p)
      51 -> json_parse_number(src, n, p)
      52 -> json_parse_number(src, n, p)
      53 -> json_parse_number(src, n, p)
      54 -> json_parse_number(src, n, p)
      55 -> json_parse_number(src, n, p)
      56 -> json_parse_number(src, n, p)
      57 -> json_parse_number(src, n, p)
      91 -> json_parse_array(src, n, p)
      123 -> json_parse_object(src, n, p)
      102 -> json_parse_literal(src, n, p, "false", JsonBool(0))
      110 -> json_parse_literal(src, n, p, "null", JsonNull)
      116 -> json_parse_literal(src, n, p, "true", JsonBool(1))
      _ -> json_parse_bad_result(p)
    }
  }
}

--- Parse one complete UTF-8 JSON document, permitting surrounding whitespace.
pub fn json_parse(source: str) -> JsonResult {
  let src = runtime_str_ptr(source)
  let n = runtime_str_len(source)
  if not utf8_validate(source) { json_parse_bad_result(0) }
  else {
    let parsed = json_parse_value(src, n, 0)
    if json_result_ok(parsed) == 0 { parsed }
    else {
      let end = json_skip_ws(src, n, json_result_pos(parsed))
      if end == n { parsed } else { json_parse_bad_result(end) }
    }
  }
}

--- Return a JSON boolean's integer representation, or `default` for another kind.
pub fn json_bool_value(value: Json, default: i64) -> i64 {
  match value {
    JsonBool(v) -> v
    _ -> default
  }
}

--- Return an exact JSON integer, or `default` for another kind.
pub fn json_number_value(value: Json, default: i64) -> i64 {
  match value {
    JsonNumber(v) -> v
    _ -> default
  }
}

--- Return a JSON float or an integer converted to `f64`, else `default`.
pub fn json_float_value(value: Json, default: f64) -> f64 {
  match value {
    JsonFloat(v) -> v
    JsonNumber(v) -> num_i64_to_f64(v)
    _ -> default
  }
}

--- Return a JSON string's decoded text, or `default` for another kind.
pub fn json_string_value(value: Json, default: str) -> str {
  match value {
    JsonString(v) -> v
    _ -> default
  }
}

--- Return a JSON array's length, or zero for another kind.
pub fn json_array_len(value: Json) -> i64 {
  match value {
    JsonArray(items) -> list_len<Json>(items)
    _ -> 0
  }
}

--- Return a JSON array's items, or an empty list for another kind.
pub fn json_array_items(value: Json) -> List<Json> {
  match value {
    JsonArray(items) -> items
    _ -> list_nil<Json>()
  }
}

--- Look up a zero-based JSON array item, returning none when absent or not an array.
pub fn json_array_get(value: Json, index: i64) -> JsonOption {
  match value {
    JsonArray(items) -> match list_nth<Json>(items, index) {
      Some(item) -> JsonSome(item)
      None -> JsonNone
    }
    _ -> JsonNone
  }
}

--- Return a JSON object's entry count, including duplicates, or zero otherwise.
pub fn json_object_len(value: Json) -> i64 {
  match value {
    JsonObject(entries) -> list_len<JsonEntry>(entries)
    _ -> 0
  }
}

--- Return a JSON object's ordered entries, or an empty list for another kind.
pub fn json_object_entries(value: Json) -> List<JsonEntry> {
  match value {
    JsonObject(entries) -> entries
    _ -> list_nil<JsonEntry>()
  }
}

--- Return the first object entry matching `key`, or none when absent.
pub fn json_object_get(value: Json, key: str) -> JsonOption {
  match value {
    JsonObject(entries) -> {
      let mut result = JsonNull
      let mut found = 0
      let mut cur = entries
      let mut done = 0
      while done == 0 {
        match cur {
          Nil -> {
            done = 1
            0
          }
          Cons(entry, rest) -> {
            if str_eq(json_entry_key(entry), key) == 1 {
              result = json_entry_value(entry)
              found = 1
              done = 1
            } else {
              cur = rest
            }
            0
          }
        }
      }
      if found == 1 { JsonSome(result) } else { JsonNone }
    }
    _ -> JsonNone
  }
}

--- Return `1` when an optional JSON value is present and `0` otherwise.
pub fn json_option_is_some(opt: JsonOption) -> i64 {
  match opt {
    JsonSome(v) -> 1
    JsonNone -> 0
  }
}

--- Return an optional JSON value, or `default` when absent.
pub fn json_option_value_or(opt: JsonOption, default: Json) -> Json {
  match opt {
    JsonSome(v) -> v
    JsonNone -> default
  }
}

--- Return the first matching object's exact integer, or `default`.
pub fn json_object_get_i64(value: Json, key: str, default: i64) -> i64 {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_number_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

--- Return the first matching object's decoded string, or `default`.
pub fn json_object_get_str(value: Json, key: str, default: str) -> str {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_string_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

--- Return the first matching object's boolean representation, or `default`.
pub fn json_object_get_bool(value: Json, key: str, default: i64) -> i64 {
  let opt = json_object_get(value, key)
  if json_option_is_some(opt) == 1 {
    json_bool_value(json_option_value_or(opt, JsonNull), default)
  } else { default }
}

pub(package) fn json_hex_digit(value: i64) -> i64 {
  if value < 10 { 48 + value } else { 65 + value - 10 }
}

pub(package) fn json_write_u00_escape(out: i64, pos: i64, ch: i64) -> i64 {
  mem_store8_at(out, pos, 92)
  mem_store8_at(out, pos + 1, 117)
  mem_store8_at(out, pos + 2, 48)
  mem_store8_at(out, pos + 3, 48)
  mem_store8_at(out, pos + 4, json_hex_digit(ch / 16))
  mem_store8_at(out, pos + 5, json_hex_digit(ch - ch / 16 * 16))
  pos + 6
}

--- Quote and escape decoded text as a JSON string token.
pub fn json_quote_string(s: str) -> str {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  let value = runtime_str_alloc_uninit(n * 6 + 2)
  let out = runtime_str_ptr(value)
  let mut p = 0
  mem_store8_at(out, p, 34)
  p = p + 1
  for i in 0..n {
    let ch = mem_load8_at(src, i)
    if ch == 34 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 34)
      p = p + 2
    } else { if ch == 92 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 92)
      p = p + 2
    } else { if ch == 8 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 98)
      p = p + 2
    } else { if ch == 12 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 102)
      p = p + 2
    } else { if ch == 10 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 110)
      p = p + 2
    } else { if ch == 13 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 114)
      p = p + 2
    } else { if ch == 9 {
      mem_store8_at(out, p, 92)
      mem_store8_at(out, p + 1, 116)
      p = p + 2
    } else { if ch < 32 {
      p = json_write_u00_escape(out, p, ch)
    } else {
      mem_store8_at(out, p, ch)
      p = p + 1
    } } } } } } } }
  }
  mem_store8_at(out, p, 34)
  p = p + 1
  runtime_str_set_len(value, p)
  value
}

pub(package) fn json_all_numbers_finite(value: Json) -> bool {
  match value {
    JsonFloat(number) -> math_is_finite_f64(number)
    JsonArray(items) -> {
      let mut cur = items
      let mut finite = true
      while not list_empty<Json>(cur) and finite {
        finite = json_all_numbers_finite(list_first_or<Json>(cur, JsonNull))
        cur = list_rest_or_nil<Json>(cur)
      }
      finite
    }
    JsonObject(entries) -> {
      let mut cur = entries
      let mut finite = true
      while not list_empty<JsonEntry>(cur) and finite {
        finite = json_all_numbers_finite(json_entry_value(list_first_or<JsonEntry>(cur, JsonEntry("", JsonNull))))
        cur = list_rest_or_nil<JsonEntry>(cur)
      }
      finite
    }
    _ -> true
  }
}

pub(package) fn json_stringify_array_raw(items: List<Json>) -> str {
  let mut out = "["
  let mut cur = items
  let mut first = 1
  while not list_empty<Json>(cur) {
    if first == 0 { out = str_concat(out, ",") } else { first = 0 }
    out = str_concat(out, json_stringify_raw(list_first_or<Json>(cur, JsonNull)))
    cur = list_rest_or_nil<Json>(cur)
  }
  str_concat(out, "]")
}

pub(package) fn json_stringify_object_raw(entries: List<JsonEntry>) -> str {
  let mut out = "{"
  let mut cur = entries
  let mut first = 1
  while not list_empty<JsonEntry>(cur) {
    if first == 0 { out = str_concat(out, ",") } else { first = 0 }
    let entry = list_first_or<JsonEntry>(cur, JsonEntry("", JsonNull))
    out = str_concat(out, json_quote_string(json_entry_key(entry)))
    out = str_concat(out, ":")
    out = str_concat(out, json_stringify_raw(json_entry_value(entry)))
    cur = list_rest_or_nil<JsonEntry>(cur)
  }
  str_concat(out, "}")
}

pub(package) fn json_stringify_raw(value: Json) -> str {
  match value {
    JsonNull -> "null"
    JsonBool(v) -> if v == 0 { "false" } else { "true" }
    JsonNumber(v) -> int_to_str(v)
    JsonFloat(v) -> num_f64_to_str(v)
    JsonString(v) -> json_quote_string(v)
    JsonArray(items) -> json_stringify_array_raw(items)
    JsonObject(entries) -> json_stringify_object_raw(entries)
  }
}

--- Encode JSON, returning an empty string if any floating-point number is non-finite.
pub fn json_stringify(value: Json) -> str {
  if json_all_numbers_finite(value) { json_stringify_raw(value) } else { "" }
}

--- Encode JSON with explicit failure for non-finite floating-point numbers.
pub fn json_stringify_checked(value: Json) -> JsonStringifyResult {
  if json_all_numbers_finite(value) { JsonStringifyOk(json_stringify_raw(value)) } else { JsonStringifyErr }
}

--- Return `1` for successful checked stringification and `0` for failure.
pub fn json_stringify_is_ok(result: JsonStringifyResult) -> i64 {
  match result { JsonStringifyOk(value) -> 1 JsonStringifyErr -> 0 }
}

--- Return encoded JSON, or `default` after checked stringification fails.
pub fn json_stringify_value_or(result: JsonStringifyResult, default: str) -> str {
  match result { JsonStringifyOk(value) -> value JsonStringifyErr -> default }
}
