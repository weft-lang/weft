-- stdlib/math.weft — scalar math helpers

--- Return a quiet `f64` NaN value.
pub fn nan_f64() -> f64 {
  0.0 / 0.0
}

--- Return positive `f64` infinity.
pub fn infinity_f64() -> f64 {
  1.0 / 0.0
}

--- Return negative `f64` infinity.
pub fn negative_infinity_f64() -> f64 {
  0.0 - infinity_f64()
}

--- Return whether an `f64` value is NaN.
pub fn is_nan_f64(value: f64) -> bool {
  value != value
}

--- Return whether an `f64` value is positive or negative infinity.
pub fn is_infinite_f64(value: f64) -> bool {
  if value == infinity_f64() {
    true
  } else {
    value == negative_infinity_f64()
  }
}

--- Return whether an `f64` value is neither NaN nor infinite.
pub fn is_finite_f64(value: f64) -> bool {
  not is_nan_f64(value) and not is_infinite_f64(value)
}

--- Return the absolute value of an `f64` value.
pub fn abs_f64(value: f64) -> f64 {
  let zero: f64 = 0.0
  if value < zero { zero - value } else { value }
}

--- Return the lesser `f64`, propagating NaN from either argument.
pub fn min_f64(a: f64, b: f64) -> f64 {
  if is_nan_f64(a) {
    a
  } else {
    if is_nan_f64(b) {
      b
    } else {
      if a < b { a } else { b }
    }
  }
}

--- Return the greater `f64`, propagating NaN from either argument.
pub fn max_f64(a: f64, b: f64) -> f64 {
  if is_nan_f64(a) {
    a
  } else {
    if is_nan_f64(b) {
      b
    } else {
      if a > b { a } else { b }
    }
  }
}

--- Clamp an `f64` value to the inclusive range from `low` to `high`.
pub fn clamp_f64(value: f64, low: f64, high: f64) -> f64 {
  min_f64(max_f64(value, low), high)
}

--- Return the IEEE-754 square root of an `f64` value.
pub fn sqrt_f64(value: f64) -> f64 {
  __f64_sqrt(value)
}

--- Return a quiet `f32` NaN value.
pub fn nan_f32() -> f32 {
  0.0 / 0.0
}

--- Return positive `f32` infinity.
pub fn infinity_f32() -> f32 {
  1.0 / 0.0
