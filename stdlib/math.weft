--- Return whether an `f32` value is neither NaN nor infinite.
pub fn is_finite_f32(value: f32) -> bool {
  not is_nan_f32(value) and not is_infinite_f32(value)
}

--- Return the absolute value of an `f32` value.
pub fn abs_f32(value: f32) -> f32 {
  let zero: f32 = 0.0
  if value < zero { zero - value } else { value }
}

--- Return the lesser `f32`, propagating NaN from either argument.
pub fn min_f32(a: f32, b: f32) -> f32 {
  if is_nan_f32(a) {
    a
  } else {
    if is_nan_f32(b) {
      b
    } else {
      if a < b { a } else { b }
    }
  }
}

--- Return the greater `f32`, propagating NaN from either argument.
pub fn max_f32(a: f32, b: f32) -> f32 {
  if is_nan_f32(a) {
    a
  } else {
    if is_nan_f32(b) {
      b
    } else {
      if a > b { a } else { b }
    }
