-- stdlib/math.weft — scalar math helpers

--- Return a quiet `f64` NaN value.
pub fn nan_f64() -> f64 {
  0.0 / 0.0
}

--- Return positive `f64` infinity.
pub fn infinity_f64() -> f64 {
  1.0 / 0.0
}

--- Return negative `f64` infinity.
pub fn negative_infinity_f64() -> f64 {
  0.0 - infinity_f64()
}

impl f64 {
  --- Return whether this value is NaN.
  fn is_nan(self: f64) -> bool {
    self != self
  }

  --- Return whether this value is positive or negative infinity.
  fn is_infinite(self: f64) -> bool {
    if self == infinity_f64() {
      true
    } else {
      self == negative_infinity_f64()
    }
  }

  --- Return whether this value is neither NaN nor infinite.
  fn is_finite(self: f64) -> bool {
    not self.is_nan() and not self.is_infinite()
  }

  --- Return the absolute value of this value.
  fn abs(self: f64) -> f64 {
    let zero: f64 = 0.0
    if self < zero { zero - self } else { self }
  }

  --- Return the lesser value, propagating NaN from either argument.
  fn min(self: f64, other: f64) -> f64 {
    if self.is_nan() {
      self
    } else {
      if other.is_nan() {
        other
      } else {
        if self < other { self } else { other }
      }
    }
  }

  --- Return the greater value, propagating NaN from either argument.
  fn max(self: f64, other: f64) -> f64 {
    if self.is_nan() {
      self
    } else {
      if other.is_nan() {
        other
      } else {
        if self > other { self } else { other }
      }
    }
  }

  --- Clamp this value to the inclusive range from `low` to `high`.
  fn clamp(self: f64, low: f64, high: f64) -> f64 {
    self.max(low).min(high)
  }

  --- Return the IEEE-754 square root of this value.
  fn sqrt(self: f64) -> f64 {
    __f64_sqrt(self)
  }
}

--- Return a quiet `f32` NaN value.
pub fn nan_f32() -> f32 {
  0.0 / 0.0
}

--- Return positive `f32` infinity.
pub fn infinity_f32() -> f32 {
