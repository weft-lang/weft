-- stdlib/math.weft — scalar math helpers

--- Return a quiet `f64` NaN value.
pub fn math_nan_f64() -> f64 {
  0.0 / 0.0
}

--- Return positive `f64` infinity.
pub fn math_infinity_f64() -> f64 {
  1.0 / 0.0
}

--- Return negative `f64` infinity.
pub fn math_negative_infinity_f64() -> f64 {
  0.0 - math_infinity_f64()
}

--- Return whether an `f64` value is NaN.
pub fn math_is_nan_f64(value: f64) -> i64 {
  if value == value { 0 } else { 1 }
}

--- Return whether an `f64` value is positive or negative infinity.
pub fn math_is_infinite_f64(value: f64) -> i64 {
  if value == math_infinity_f64() {
    1
  } else {
    if value == math_negative_infinity_f64() { 1 } else { 0 }
  }
}

--- Return whether an `f64` value is neither NaN nor infinite.
pub fn math_is_finite_f64(value: f64) -> i64 {
  if math_is_nan_f64(value) == 1 {
    0
  } else {
    if math_is_infinite_f64(value) == 1 { 0 } else { 1 }
  }
}

--- Return the absolute value of an `f64` value.
pub fn math_abs_f64(value: f64) -> f64 {
  let zero: f64 = 0.0
  if value < zero { zero - value } else { value }
}

--- Return the lesser `f64`, propagating NaN from either argument.
pub fn math_min_f64(a: f64, b: f64) -> f64 {
  if math_is_nan_f64(a) == 1 {
    a
  } else {
    if math_is_nan_f64(b) == 1 {
      b
    } else {
      if a < b { a } else { b }
    }
  }
}

--- Return the greater `f64`, propagating NaN from either argument.
pub fn math_max_f64(a: f64, b: f64) -> f64 {
  if math_is_nan_f64(a) == 1 {
    a
  } else {
    if math_is_nan_f64(b) == 1 {
      b
    } else {
      if a > b { a } else { b }
    }
  }
}

--- Clamp an `f64` value to the inclusive range from `low` to `high`.
pub fn math_clamp_f64(value: f64, low: f64, high: f64) -> f64 {
  math_min_f64(math_max_f64(value, low), high)
}

--- Return the IEEE-754 square root of an `f64` value.
pub fn math_sqrt_f64(value: f64) -> f64 {
  __f64_sqrt(value)
}

--- Return a quiet `f32` NaN value.
pub fn math_nan_f32() -> f32 {
  0.0 / 0.0
}

--- Return positive `f32` infinity.
pub fn math_infinity_f32() -> f32 {
  1.0 / 0.0
}

--- Return negative `f32` infinity.
pub fn math_negative_infinity_f32() -> f32 {
  0.0 - math_infinity_f32()
}

--- Return whether an `f32` value is NaN.
pub fn math_is_nan_f32(value: f32) -> i64 {
  if value == value { 0 } else { 1 }
}

--- Return whether an `f32` value is positive or negative infinity.
pub fn math_is_infinite_f32(value: f32) -> i64 {
  if value == math_infinity_f32() {
    1
  } else {
    if value == math_negative_infinity_f32() { 1 } else { 0 }
  }
}

--- Return whether an `f32` value is neither NaN nor infinite.
pub fn math_is_finite_f32(value: f32) -> i64 {
  if math_is_nan_f32(value) == 1 {
    0
  } else {
    if math_is_infinite_f32(value) == 1 { 0 } else { 1 }
  }
}

--- Return the absolute value of an `f32` value.
pub fn math_abs_f32(value: f32) -> f32 {
  let zero: f32 = 0.0
  if value < zero { zero - value } else { value }
}

--- Return the lesser `f32`, propagating NaN from either argument.
pub fn math_min_f32(a: f32, b: f32) -> f32 {
  if math_is_nan_f32(a) == 1 {
    a
  } else {
    if math_is_nan_f32(b) == 1 {
      b
    } else {
      if a < b { a } else { b }
    }
  }
}

--- Return the greater `f32`, propagating NaN from either argument.
pub fn math_max_f32(a: f32, b: f32) -> f32 {
  if math_is_nan_f32(a) == 1 {
    a
  } else {
    if math_is_nan_f32(b) == 1 {
      b
    } else {
      if a > b { a } else { b }
    }
  }
}

--- Clamp an `f32` value to the inclusive range from `low` to `high`.
pub fn math_clamp_f32(value: f32, low: f32, high: f32) -> f32 {
  math_min_f32(math_max_f32(value, low), high)
}

--- Return the IEEE-754 square root of an `f32` value.
pub fn math_sqrt_f32(value: f32) -> f32 {
  __f32_sqrt(value)
}
