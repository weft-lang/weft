--- Return negative `f32` infinity.
pub fn negative_infinity_f32() -> f32 {
  0.0 - infinity_f32()
}

--- Return whether an `f32` value is NaN.
pub fn is_nan_f32(value: f32) -> bool {
  value != value
}

--- Return whether an `f32` value is positive or negative infinity.
pub fn is_infinite_f32(value: f32) -> bool {
  if value == infinity_f32() {
    true
  } else {
    value == negative_infinity_f32()
