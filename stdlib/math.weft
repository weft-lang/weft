  --- Return the absolute value of this value.
  fn abs(self: f32) -> f32 {
    let zero: f32 = 0.0
    if self < zero { zero - self } else { self }
  }

  --- Return the lesser value, propagating NaN from either argument.
  fn min(self: f32, other: f32) -> f32 {
    if self.is_nan() {
      self
    } else {
      if other.is_nan() {
        other
      } else {
        if self < other { self } else { other }
      }
    }
  }

  --- Return the greater value, propagating NaN from either argument.
  fn max(self: f32, other: f32) -> f32 {
    if self.is_nan() {
      self
    } else {
      if other.is_nan() {
        other
      } else {
        if self > other { self } else { other }
      }
    }
  }

  --- Clamp this value to the inclusive range from `low` to `high`.
  fn clamp(self: f32, low: f32, high: f32) -> f32 {
