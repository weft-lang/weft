-- stdlib/grammar/staging.weft — the host program's view of a staged source
--
-- `embed<G>(source)` marks a host-type staging site, while
-- `embed_with_file<G>(source, context)` selects a bounded context file. At
-- build time the compiler hands
-- the literal to the export's driver, which checks it with the package's
-- own checker and, when the export stages typed plans, persists the checked
-- plan as bytes the product carries. The host program receives a
-- `Staged<G>`: the source identity its diagnostics name and the artifact,
-- if the export emits one. `G` is nominal, so a `Staged<SqlGrammar>` cannot
-- be handed to another package's runtime.
--
-- `embed` is a blessed primitive: the checker recognises this declaration
-- by identity, requires `G` to be a manifest grammar export and the
-- argument to be a staged literal (a raw string or an escape-free plain
-- string, never computed or interpolated), and records the site as a
-- semantic fact. The site is lowered by the compiler; this body is reached
-- only when it was not.

use stdlib/bytes.{Bytes, bytes_from_storage}
use stdlib/diagnostic/schema.{DiagnosticSource, DiagnosticSourceNamed}
use stdlib/grammar.{Grammar}
use stdlib/option.{Option, Some, None}
use stdlib/panic.{panic}

--- The bytes a package staged for a site, with their content digest.
pub type StagedBytes { content: str, bytes: Bytes }

--- The build-time result of one staging site as the program sees it.
pub type Staged<G> {
  --- The retained source identity the site's diagnostics and facts name.
  source: DiagnosticSource,
  --- The artifact incorporated into this product, or none for an export
  --- that only validates.
  artifact: Option<StagedBytes>
}

--- The fixed maximum number of context-file bytes a staging site may read.
--- The driver still observes the exact path, limit, size and digest used by
--- the package, so this ceiling is part of the reproducible build input.
pub fn file_context_limit() -> usize { __i64_to_usize(1048576) }

--- Stage `source` for the grammar export `G` against host types at build time.
pub fn embed<G: Grammar>(source: str) -> Staged<G> {
  panic("a staging site was not lowered by the compiler")
}

--- Stage `source` for `G` against the file named by the staged `context`
--- literal. Relative paths are resolved from the package build directory.
--- Both arguments must be raw strings or escape-free plain strings so their
--- bytes, identities and diagnostic offsets are compile-time facts.
pub fn embed_with_file<G: Grammar>(source: str, context: str) -> Staged<G> {
  panic("a file-context staging site was not lowered by the compiler")
}

-- Lowered sites. The compiler attaches the verified material to the site's
-- checker fact and lowers the accepted `embed<G>` call directly to one of
-- these constructors. Artifact storage is emitted inline in the native image
-- and wrapped as opaque immutable bytes without copying or decoding.
--- The `Staged<G>` of a site whose export validated the source and emits
--- nothing.
pub fn validated<G: Grammar>(source_name: str) -> Staged<G> {
  Staged<G> { source: DiagnosticSourceNamed(source_name), artifact: None<StagedBytes>() }
}

--- The `Staged<G>` of a site whose export staged an artifact: `content` is
--- its verified digest and `storage` is compiler-owned static byte storage.
pub(package) fn staged_from_static<G: Grammar>(
  source_name: str,
  content: str,
  storage: str
) -> Staged<G> {
  Staged<G> {
    source: DiagnosticSourceNamed(source_name),
    artifact: Some<StagedBytes>(
      StagedBytes { content: content, bytes: bytes_from_storage(storage) }
    )
  }
}
