-- Tool-driven checking of an exported grammar.
--
-- A blessed tool resolves a package's public `Grammar` type through the
-- package manifest and parses with the `Grammar` contract. When that same
-- type also conforms to `GrammarTooling`, the tool can check parsed syntax
-- against host types it answers itself, or against a bounded context file the
-- grammar loads. Guest syntax, plans and identities never leave the package:
-- a tool sees outcomes and structured diagnostics only. Support is declared
-- by `contexts` and enforced by the caller before any check; a request that
-- arrives anyway is answered with `GrammarCheckUnsupported`.

use stdlib/diagnostic/schema.{Diagnose}
use stdlib/file.{FileRead}
use stdlib/list.{List, Cons, Nil}
use stdlib/path.{Path}
use stdlib/typecheck.{TypeCheck}

--- A checking context an exported grammar can accept. Parsing needs none.
pub type GrammarContextKind {
  --- Host types the tool answers through `TypeCheck<ToolTypeIdentity>`.
  GrammarHostTypesContext,
  --- A bounded context file the grammar loads and interprets itself.
  GrammarFileContext
}

--- Identity domain of host types issued to a tool-driven grammar. The
--- representation is opaque to grammars, but a token is not an unforgeable
--- capability: any handler answering `TypeCheck<ToolTypeIdentity>` must
--- validate every token it receives against the identities it issued and
--- answer `ForeignTypeIdentity` for anything else.
pub type ToolTypeIdentity = opaque i64

--- Issue a tool type identity. Handlers answering
--- `TypeCheck<ToolTypeIdentity>` construct identities from their own table.
pub fn tool_type_identity(token: i64) -> ToolTypeIdentity { ToolTypeIdentity(token) }

--- Recover the token behind an identity so a handler can look it up in its
--- own table; the handler decides whether the token is valid.
pub fn tool_type_identity_token(identity: ToolTypeIdentity) -> i64 {
  match identity { ToolTypeIdentity(token) -> token }
}

--- The outcome of one tool-driven check.
pub type GrammarCheckOutcome {
  --- The syntax checked; the checked value stays inside the package.
  GrammarChecked,
  --- Checking reported errors through Diagnose.
  GrammarCheckRejected,
  --- The grammar does not accept this context kind; nothing was checked.
  GrammarCheckUnsupported(GrammarContextKind),
  --- The context file could not be acquired or was invalid; the grammar
  --- reported the exact reason through Diagnose and checked nothing.
  GrammarContextUnavailable
}

--- What a tool learns from one check.
pub type GrammarCheckReport { outcome: GrammarCheckOutcome }

--- The report of a check that accepted its syntax.
pub fn checked_report() -> GrammarCheckReport { GrammarCheckReport { outcome: GrammarChecked } }

--- The report of a check that reported errors.
pub fn rejected_report() -> GrammarCheckReport {
  GrammarCheckReport { outcome: GrammarCheckRejected }
}

--- The report for a context kind the grammar does not accept.
pub fn unsupported_report(kind: GrammarContextKind) -> GrammarCheckReport {
  GrammarCheckReport { outcome: GrammarCheckUnsupported(kind) }
}

--- The report for a context file that was unavailable or invalid.
pub fn context_unavailable_report() -> GrammarCheckReport {
  GrammarCheckReport { outcome: GrammarContextUnavailable }
}

--- Tool-driven checking for a grammar. `Syntax` is the exported `Grammar`'s
--- syntax type; a concrete tool driver names both on one value and the
--- checker enforces their agreement.
pub trait GrammarTooling {
  type Syntax
  --- The context kinds this grammar checks against.
  fn contexts(self) -> List<GrammarContextKind>
  --- Check against host types answered by the tool.
  fn check_with_host(
    self,
    syntax: Self.Syntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport
  --- Load a bounded context file and check against it.
  fn check_with_context(
    self,
    syntax: Self.Syntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport
}

--- Whether two context kinds are the same kind.
pub fn context_kind_same(left: GrammarContextKind, right: GrammarContextKind) -> bool {
  match (left, right) {
    (GrammarHostTypesContext, GrammarHostTypesContext) -> true
    (GrammarFileContext, GrammarFileContext) -> true
    _ -> false
  }
}

--- Whether a declared context list accepts one kind.
pub fn supports_context(kinds: List<GrammarContextKind>, kind: GrammarContextKind) -> bool {
  match kinds {
    Nil -> false
    Cons(first, rest) -> if context_kind_same(first, kind) { true } else {
      supports_context(rest, kind)
    }
  }
}
