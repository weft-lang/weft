            mini_sql_type_result(0, 1)
          }
        } else {
          let arg_result = mini_sql_host_scalar_type_for_query(arg, query, table_ty, src, host_offset)
          let mut errors = mini_sql_type_result_errors(arg_result)
          let arg_ty = mini_sql_type_result_ty(arg_result)
          if mini_sql_expr_has_aggregate(arg) == 1 {
            mini_sql_type_error_at("mini_sql type error: nested aggregate not allowed", mini_sql_projection_expr_start(arg), host_offset)
            errors = errors + 1
          } else { 0 }
          if kind == mini_sql_agg_count() {
            mini_sql_type_result(ty_i64(), errors)
          } else { if kind == mini_sql_agg_sum() {
            if arg_ty != 0 {
              let arg_i64 = mini_sql_host_type_is_i64(arg_ty)
              if arg_i64 == 0 {
                mini_sql_type_error_at("mini_sql type error: aggregate sum requires i64", mini_sql_projection_expr_start(arg), host_offset)
                errors = errors + 1
              } else { 0 }
            } else { 0 }
            mini_sql_type_result(ty_i64(), errors)
          } else { if kind == mini_sql_agg_min() or kind == mini_sql_agg_max() {
            mini_sql_type_result(arg_ty, errors)
          } else {
            mini_sql_type_result(0, errors)
          } } }
        }
      }
      714 -> mini_sql_host_qualified_ref_type(expr, query, table_ty, src, host_offset)
      _ -> mini_sql_type_result(0, 0)
    }
  }
}

pub(package) fn mini_sql_host_projection_type(item: i64, query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  mini_sql_host_scalar_type_for_query(mini_sql_select_item_expr(item), query, table_ty, src, host_offset)
}

pub(package) fn mini_sql_check_host_columns(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if mini_sql_query_star(query) == 1 { 0 }
  else {
    let cols = node_f1(query)
    let ncols = nlist_len(cols)
    let mut i = 0
    let mut errors = 0
    while i < ncols {
      let item = nlist_get(cols, i)
      let result = mini_sql_host_projection_type(item, query, table_ty, src, host_offset)
      errors = errors + mini_sql_type_result_errors(result)
      i = i + 1
    }
    errors
  }
}

pub(package) fn mini_sql_host_type_eq(left: i64, right: i64) -[TypeCheck]> i64 {
  if left == 0 or right == 0 { 0 }
  else {
    let lr = TypeCheck.subtype(left, right)
    let rl = TypeCheck.subtype(right, left)
    if lr == 1 and rl == 1 { 1 } else { 0 }
  }
}

pub(package) fn mini_sql_host_type_is_i64(ty: i64) -[TypeCheck]> i64 {
  mini_sql_host_type_eq(ty, ty_i64())
}

pub(package) fn mini_sql_host_type_is_bool(ty: i64) -[TypeCheck]> i64 {
