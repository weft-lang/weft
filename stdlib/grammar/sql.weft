}

pub(package) fn mini_sql_query_alias_count(query: i64, src: i64, ident: i64) -> i64 {
  if query == 0 or ident == 0 or mini_sql_query_star(query) == 1 { 0 }
  else {
    let cols = node_f1(query)
    let ncols = nlist_len(cols)
    let mut i = 0
    let mut count = 0
    while i < ncols {
      let item = nlist_get(cols, i)
      if mini_sql_select_item_has_alias(item) == 1 and mini_sql_ident_same(src, mini_sql_select_item_alias(item), ident) == 1 {
        count = count + 1
      } else { 0 }
      i = i + 1
    }
    count
  }
}

pub(package) fn mini_sql_query_alias_expr(query: i64, src: i64, ident: i64) -> i64 {
  if query == 0 or ident == 0 or mini_sql_query_star(query) == 1 { 0 }
  else {
    let cols = node_f1(query)
    let ncols = nlist_len(cols)
    let mut i = 0
    let mut found = 0
    while i < ncols and found == 0 {
      let item = nlist_get(cols, i)
      if mini_sql_select_item_has_alias(item) == 1 and mini_sql_ident_same(src, mini_sql_select_item_alias(item), ident) == 1 {
        found = mini_sql_select_item_expr(item)
      } else { 0 }
      i = i + 1
    }
    found
  }
}

pub(package) fn mini_sql_source_qualifier_matches(table_node: i64, table_alias: i64, src: i64, qualifier: i64) -> i64 {
  if table_node == 0 or qualifier == 0 { 0 }
  else {
    if table_alias != 0 {
      mini_sql_ident_same(src, table_alias, qualifier)
    } else {
      mini_sql_ident_same(src, table_node, qualifier)
    }
  }
}

pub(package) fn mini_sql_query_qualifier_matches(query: i64, src: i64, qualifier: i64) -> i64 {
  if query == 0 or qualifier == 0 { 0 }
  else {
    if mini_sql_source_qualifier_matches(mini_sql_query_table_node(query), mini_sql_query_table_alias(query), src, qualifier) == 1 { 1 }
    else {
      let joins = mini_sql_query_joins(query)
      if joins == 0 { 0 }
      else {
        let njoins = nlist_len(joins)
        let mut i = 0
        let mut found = 0
        while i < njoins and found == 0 {
          let join = nlist_get(joins, i)
          if mini_sql_source_qualifier_matches(mini_sql_join_table_node(join), mini_sql_join_table_alias(join), src, qualifier) == 1 {
            found = 1
          } else {
            i = i + 1
          }
        }
        found
      }
    }
  }
}

pub(package) fn mini_sql_ascii_lower(ch: i64) -> i64 {
  if ch >= 65 and ch <= 90 { ch + 32 } else { ch }
}

pub(package) fn mini_sql_is_ident_start(ch: i64) -> i64 {
  if is_alpha(ch) == 1 { 1 } else { if ch == 95 { 1 } else { 0 } }
}

pub(package) fn mini_sql_is_ident_continue(ch: i64) -> i64 {
  if mini_sql_is_ident_start(ch) == 1 { 1 } else { is_digit(ch) }
}

pub(package) fn mini_sql_skip_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and is_ws(mem_load8_at(src, p)) == 1 {
    p = p + 1
  }
  p
}

pub(package) fn mini_sql_word_matches(src: i64, n: i64, pos: i64, word: str) -> i64 {
  let len = __str_len(word)
  if pos + len > n { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      if mini_sql_ascii_lower(mem_load8_at(src, pos + i)) != mini_sql_ascii_lower(mem_load8_at(__str_ptr(word), i)) {
        ok = 0
        i = len
      } else {
        i = i + 1
      }
    }
    if ok == 0 { 0 }
    else {
      if pos + len < n and mini_sql_is_ident_continue(mem_load8_at(src, pos + len)) == 1 { 0 } else { 1 }
    }
  }
}

pub(package) fn mini_sql_ident_eq(src: i64, ident: i64, word: str) -> i64 {
  if ident == 0 { 0 }
  else { src_eq(src, node_f1(ident), node_f2(ident), word) }
}

pub(package) fn mini_sql_ident_matches_word(src: i64, n: i64, ident: i64, word: str) -> i64 {
  if ident == 0 { 0 }
  else {
    if mini_sql_ident_len(ident) != __str_len(word) { 0 }
    else { mini_sql_word_matches(src, n, mini_sql_ident_start(ident), word) }
  }
}

pub(package) fn mini_sql_ident_is_reserved(src: i64, n: i64, ident: i64) -> i64 {
  if mini_sql_ident_matches_word(src, n, ident, "select") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "from") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "where") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "as") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "and") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "or") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "true") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "false") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "order") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "by") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "asc") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "desc") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "limit") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "offset") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "group") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "having") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "join") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "on") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "distinct") == 1 { 1 }
  else { 0 } } } } } } } } } } } } } } } } } } }
}

pub(package) fn mini_sql_error_at(msg: str, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  Diagnose.error(msg, host_offset + pos)
}

pub(package) fn mini_sql_recover_to_keyword(src: i64, n: i64, pos: i64, keyword: str) -> i64 {
  let mut p = pos
  let mut result = n
  while p < n {
    if mini_sql_word_matches(src, n, p, keyword) == 1 {
      result = p
      p = n
    } else {
      p = p + 1
    }
  }
  result
}

pub(package) fn mini_sql_parse_ident(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    if mini_sql_is_ident_start(mem_load8_at(src, p)) == 0 { mini_sql_result(0, p) }
    else {
      let mut end = p + 1
      while end < n and mini_sql_is_ident_continue(mem_load8_at(src, end)) == 1 {
        end = end + 1
      }
      mini_sql_result(mini_sql_ident_new(p, end - p), end)
    }
  }
}

pub(package) fn mini_sql_parse_int_literal(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let mut end = p
  let mut value = 0
  while end < n and is_digit(mem_load8_at(src, end)) == 1 {
    value = value * 10 + mem_load8_at(src, end) - 48
    end = end + 1
  }
  if end == p { mini_sql_result(0, p) }
  else { mini_sql_result(mini_sql_lit_new(p, end - p, mini_sql_ty_i64(), value), end) }
}

pub(package) fn mini_sql_parse_bool_literal(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "true") == 1 {
    mini_sql_result(mini_sql_lit_new(p, 4, mini_sql_ty_bool(), 1), p + 4)
  } else { if mini_sql_word_matches(src, n, p, "false") == 1 {
    mini_sql_result(mini_sql_lit_new(p, 5, mini_sql_ty_bool(), 0), p + 5)
  } else { mini_sql_result(0, p) } }
}

pub(package) fn mini_sql_parse_string_literal(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n or mem_load8_at(src, p) != 39 { mini_sql_result(0, p) }
  else {
    let mut end = p + 1
    let mut closed = 0
    while end < n and closed == 0 {
      if mem_load8_at(src, end) == 39 {
        closed = 1
      } else {
        end = end + 1
      }
    }
    if closed == 1 {
      mini_sql_result(mini_sql_lit_new(p + 1, end - p - 1, mini_sql_ty_str(), 0), end + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: unterminated string literal", p, host_offset)
      mini_sql_result(mini_sql_lit_new(p + 1, n - p - 1, mini_sql_ty_str(), 0), n)
    }
  }
}

pub(package) fn mini_sql_parse_literal(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let bool_res = mini_sql_parse_bool_literal(src, n, p)
  if mini_sql_result_node(bool_res) != 0 { bool_res }
  else { if p < n and mem_load8_at(src, p) == 39 {
    mini_sql_parse_string_literal(src, n, p, host_offset)
  } else {
    mini_sql_parse_int_literal(src, n, p)
  } }
}

pub(package) fn mini_sql_agg_kind_from_ident(src: i64, n: i64, ident: i64) -> i64 {
  if mini_sql_ident_matches_word(src, n, ident, "count") == 1 { mini_sql_agg_count() }
  else { if mini_sql_ident_matches_word(src, n, ident, "sum") == 1 { mini_sql_agg_sum() }
  else { if mini_sql_ident_matches_word(src, n, ident, "min") == 1 { mini_sql_agg_min() }
  else { if mini_sql_ident_matches_word(src, n, ident, "max") == 1 { mini_sql_agg_max() }
  else { 0 } } } }
}

pub(package) fn mini_sql_parse_aggregate_call(src: i64, n: i64, ident: i64, open_pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let kind = mini_sql_agg_kind_from_ident(src, n, ident)
  if kind == 0 {
    mini_sql_error_at("mini_sql parse error: unknown aggregate function", mini_sql_ident_start(ident), host_offset)
  } else { 0 }
  let mut p = mini_sql_skip_ws(src, n, open_pos + 1)
  let mut star = 0
  let mut arg = 0
  if p < n and mem_load8_at(src, p) == 42 {
    star = 1
    p = mini_sql_skip_ws(src, n, p + 1)
  } else {
    let arg_res = mini_sql_parse_scalar_expr(src, n, p, host_offset)
    arg = mini_sql_result_node(arg_res)
    if arg == 0 {
      mini_sql_error_at("mini_sql parse error: expected aggregate expression", mini_sql_result_pos(arg_res), host_offset)
      p = mini_sql_result_pos(arg_res)
    } else {
      p = mini_sql_skip_ws(src, n, mini_sql_result_pos(arg_res))
    }
  }
  if p < n and mem_load8_at(src, p) == 41 {
    mini_sql_result(mini_sql_agg_call_new(kind, arg, star, mini_sql_ident_start(ident)), p + 1)
  } else {
    mini_sql_error_at("mini_sql parse error: expected ')' in aggregate", p, host_offset)
    mini_sql_result(mini_sql_agg_call_new(kind, arg, star, mini_sql_ident_start(ident)), p)
  }
}

pub(package) fn mini_sql_parse_qualified_ref_tail(src: i64, n: i64, qualifier: i64, dot_pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let field_res = mini_sql_parse_ident(src, n, dot_pos + 1)
  let field = mini_sql_result_node(field_res)
  if field == 0 {
    mini_sql_error_at("mini_sql parse error: expected field after '.'", mini_sql_result_pos(field_res), host_offset)
    mini_sql_result(mini_sql_qualified_ref_new(qualifier, 0), mini_sql_result_pos(field_res))
  } else {
    if mini_sql_ident_is_reserved(src, n, field) == 1 {
      mini_sql_error_at("mini_sql parse error: expected field after '.'", mini_sql_ident_start(field), host_offset)
      mini_sql_result(mini_sql_qualified_ref_new(qualifier, 0), dot_pos + 1)
    } else {
      mini_sql_result(mini_sql_qualified_ref_new(qualifier, field), mini_sql_result_pos(field_res))
    }
  }
}

pub(package) fn mini_sql_parse_scalar_atom(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p < n and mem_load8_at(src, p) == 40 {
    let inner_res = mini_sql_parse_scalar_expr(src, n, p + 1, host_offset)
    let inner = mini_sql_result_node(inner_res)
    let after_inner = mini_sql_skip_ws(src, n, mini_sql_result_pos(inner_res))
    if after_inner < n and mem_load8_at(src, after_inner) == 41 {
      mini_sql_result(inner, after_inner + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: expected ')' in expression", after_inner, host_offset)
      mini_sql_result(inner, after_inner)
    }
  }
  else {
    let lit_res = mini_sql_parse_literal(src, n, p, host_offset)
    let lit = mini_sql_result_node(lit_res)
    if lit != 0 { lit_res }
    else {
      let id_res = mini_sql_parse_ident(src, n, p)
      let id = mini_sql_result_node(id_res)
      if id == 0 { mini_sql_result(0, mini_sql_result_pos(id_res)) }
      else {
        let after_id = mini_sql_skip_ws(src, n, mini_sql_result_pos(id_res))
        if after_id < n and mem_load8_at(src, after_id) == 40 {
          mini_sql_parse_aggregate_call(src, n, id, after_id, host_offset)
        } else { if after_id < n and mem_load8_at(src, after_id) == 46 {
          if mini_sql_ident_is_reserved(src, n, id) == 1 { mini_sql_result(0, p) }
          else { mini_sql_parse_qualified_ref_tail(src, n, id, after_id, host_offset) }
        } else {
          if mini_sql_ident_is_reserved(src, n, id) == 1 { mini_sql_result(0, p) }
          else { id_res }
        } }
      }
    }
  }
}

pub(package) fn mini_sql_parse_scalar_mul_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    match mem_load8_at(src, p) {
      42 -> mini_sql_result(mini_sql_expr_mul(), p + 1)
      47 -> mini_sql_result(mini_sql_expr_div(), p + 1)
      _ -> mini_sql_result(0, p)
    }
  }
}

pub(package) fn mini_sql_parse_scalar_add_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    match mem_load8_at(src, p) {
      43 -> mini_sql_result(mini_sql_expr_add(), p + 1)
      45 -> mini_sql_result(mini_sql_expr_sub(), p + 1)
      124 -> {
        if p + 1 < n and mem_load8_at(src, p + 1) == 124 {
          mini_sql_result(mini_sql_expr_concat(), p + 2)
        } else { mini_sql_result(0, p) }
      }
      _ -> mini_sql_result(0, p)
    }
  }
}

pub(package) fn mini_sql_parse_scalar_mul(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_scalar_atom(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let op_res = mini_sql_parse_scalar_mul_op(src, n, p)
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      done = 1
    } else {
      let right_res = mini_sql_parse_scalar_atom(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected expression after operator", mini_sql_result_pos(right_res), host_offset)
        left = mini_sql_expr_binary_new(left, 0, op)
        p = mini_sql_result_pos(right_res)
      } else {
        left = mini_sql_expr_binary_new(left, right, op)
        p = mini_sql_result_pos(right_res)
      }
    }
  }
  mini_sql_result(left, p)
}

pub(package) fn mini_sql_parse_scalar_expr(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_scalar_mul(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let op_res = mini_sql_parse_scalar_add_op(src, n, p)
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      done = 1
    } else {
      let right_res = mini_sql_parse_scalar_mul(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected expression after operator", mini_sql_result_pos(right_res), host_offset)
        left = mini_sql_expr_binary_new(left, 0, op)
        p = mini_sql_result_pos(right_res)
      } else {
        left = mini_sql_expr_binary_new(left, right, op)
        p = mini_sql_result_pos(right_res)
      }
    }
  }
  mini_sql_result(left, p)
}

pub(package) fn mini_sql_parse_projection_expr(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  mini_sql_parse_scalar_expr(src, n, pos, host_offset)
}

pub(package) fn mini_sql_parse_projection_alias(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let explicit_as = if mini_sql_word_matches(src, n, p, "as") == 1 { 1 } else { 0 }
  let alias_pos = if explicit_as == 1 { mini_sql_skip_ws(src, n, p + 2) } else { p }
  let alias_res = mini_sql_parse_ident(src, n, alias_pos)
  let alias = mini_sql_result_node(alias_res)
  let result = alloc_zeroed(24)
  if alias == 0 {
    if explicit_as == 1 {
      mini_sql_error_at("mini_sql parse error: expected alias after AS", mini_sql_result_pos(alias_res), host_offset)
    } else { 0 }
    mem_store64_at(result, 0, 0)
    mem_store64_at(result, 8, alias_pos)
    mem_store64_at(result, 16, explicit_as)
  } else {
    if mini_sql_ident_is_reserved(src, n, alias) == 1 {
      if explicit_as == 1 {
        mini_sql_error_at("mini_sql parse error: expected alias after AS", mini_sql_ident_start(alias), host_offset)
      } else { 0 }
      mem_store64_at(result, 0, 0)
      mem_store64_at(result, 8, alias_pos)
      mem_store64_at(result, 16, explicit_as)
    } else {
      mem_store64_at(result, 0, alias)
      mem_store64_at(result, 8, mini_sql_result_pos(alias_res))
      mem_store64_at(result, 16, explicit_as)
    }
  }
  result
}

pub(package) fn mini_sql_alias_result_alias(result: i64) -> i64 { mem_load64_at(result, 0) }
pub(package) fn mini_sql_alias_result_pos(result: i64) -> i64 { mem_load64_at(result, 8) }
pub(package) fn mini_sql_alias_result_explicit_as(result: i64) -> i64 { mem_load64_at(result, 16) }

pub(package) fn mini_sql_parse_table_alias(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let explicit_as = if mini_sql_word_matches(src, n, p, "as") == 1 { 1 } else { 0 }
  let alias_pos = if explicit_as == 1 { mini_sql_skip_ws(src, n, p + 2) } else { p }
  let alias_res = mini_sql_parse_ident(src, n, alias_pos)
  let alias = mini_sql_result_node(alias_res)
  let result = alloc_zeroed(24)
  if alias == 0 {
    if explicit_as == 1 {
      mini_sql_error_at("mini_sql parse error: expected table alias after AS", mini_sql_result_pos(alias_res), host_offset)
    } else { 0 }
    mem_store64_at(result, 0, 0)
    mem_store64_at(result, 8, alias_pos)
    mem_store64_at(result, 16, explicit_as)
  } else {
    if mini_sql_ident_is_reserved(src, n, alias) == 1 {
      if explicit_as == 1 {
        mini_sql_error_at("mini_sql parse error: expected table alias after AS", mini_sql_ident_start(alias), host_offset)
      } else { 0 }
      mem_store64_at(result, 0, 0)
      mem_store64_at(result, 8, alias_pos)
      mem_store64_at(result, 16, explicit_as)
    } else {
      mem_store64_at(result, 0, alias)
      mem_store64_at(result, 8, mini_sql_result_pos(alias_res))
      mem_store64_at(result, 16, explicit_as)
