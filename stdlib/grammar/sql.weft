-- The first-party SQL grammar, implemented entirely through public services.

use stdlib/diagnostic/schema.{Diagnose}
use stdlib/grammar.{Grammar, ParseResult}
use stdlib/grammar/sql/parse as parser
use stdlib/grammar/sql/syntax.{SqlSyntax}
use stdlib/source.{Span}

--- The first-party SQL parser producing retained, grammar-owned syntax.
--- Identifiers are ASCII; quoted text preserves Unicode and byte provenance.
--- Recovery reports structured diagnostics and retains explicit expression
--- holes. Integer literals must fit i64. Nested expressions and operator
--- chains are bounded at 128 to keep malformed input from exhausting the stack.
pub type SqlGrammar {
  --- Construct the stateless SQL parser value.
  SqlGrammar
}

--- Construct the first-party SQL parser.
pub fn grammar() -> SqlGrammar { SqlGrammar() }

impl Grammar for SqlGrammar {
  type Syntax = SqlSyntax

  fn parse(self, source: Span) -[Diagnose]> ParseResult<SqlSyntax> {
    parser.parse(source)
  }
}
