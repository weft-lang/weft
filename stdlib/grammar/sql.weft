pub(package) fn mini_sql_order_desc() -> i64 { 2 }

pub(package) fn mini_sql_agg_count() -> i64 { 1 }
pub(package) fn mini_sql_agg_sum() -> i64 { 2 }
pub(package) fn mini_sql_agg_min() -> i64 { 3 }
pub(package) fn mini_sql_agg_max() -> i64 { 4 }

