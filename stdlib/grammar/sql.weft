pub(package) fn mini_sql_check_ast_at(query: i64, src: i64, tt: i64, host_offset: i64) -[Diagnose]> i64 {
  let table_node = mini_sql_query_table_node(query)
  let table_id = mini_sql_table_id(src, table_node)
  if table_id == mini_sql_table_unknown() {
    mini_sql_type_error_at("mini_sql type error: unknown table", mini_sql_ident_start(table_node), host_offset)
    1
  } else {
    mini_sql_check_catalog_joins(query, table_id, src, host_offset) + mini_sql_check_columns(query, table_id, src, host_offset) + mini_sql_check_where(query, table_id, src, host_offset) + mini_sql_check_group_by(query, table_id, src, host_offset) + mini_sql_check_having(query, table_id, src, host_offset) + mini_sql_check_order(query, table_id, src, host_offset) + mini_sql_check_limit_offset(query, table_id, src, host_offset) + mini_sql_check_grouped_query_catalog(query, table_id, src, host_offset)
  }
}

