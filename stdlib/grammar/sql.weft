pub(package) fn mini_sql_check_grouped_query_catalog(query: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  if mini_sql_query_is_grouped(query) == 0 { 0 }
  else {
    let group_items = mini_sql_query_group_items(query)
    let mut errors = 0
    if mini_sql_query_star(query) == 1 {
      mini_sql_type_error_at("mini_sql type error: grouped query cannot select star", 0, host_offset)
      errors = errors + 1
    } else {
      let cols = node_f1(query)
      let ncols = nlist_len(cols)
      let mut i = 0
      while i < ncols {
        let expr = mini_sql_select_item_expr(nlist_get(cols, i))
        if mini_sql_expr_grouped_ok(expr, group_items, src) == 0 {
          mini_sql_type_error_at("mini_sql type error: non-aggregate projection must appear in GROUP BY", mini_sql_projection_expr_start(expr), host_offset)
          errors = errors + 1
        } else { 0 }
        i = i + 1
      }
    }
    let order_items = mini_sql_query_order_items(query)
    if order_items != 0 {
      let norder = nlist_len(order_items)
      let mut j = 0
      while j < norder {
        let expr = mini_sql_order_item_expr(nlist_get(order_items, j))
        if mini_sql_expr_grouped_ok_with_aliases_catalog(expr, query, group_items, table_id, src) == 0 {
