pub(package) fn mini_sql_host_column_match_count(query: i64, table_ty: i64, src: i64, column: i64) -[TypeCheck]> i64 {
  let mut count = 0
  let primary_ty = TypeCheck.resolve_field_type(table_ty, src, mini_sql_ident_start(column), mini_sql_ident_len(column))
  if primary_ty != 0 { count = count + 1 } else { 0 }
  let joins = mini_sql_query_joins(query)
  if joins != 0 {
    let njoins = nlist_len(joins)
    let mut i = 0
    while i < njoins {
      let join = nlist_get(joins, i)
      let join_table = mini_sql_join_table_node(join)
      let join_ty = TypeCheck.resolve_type(src, mini_sql_ident_start(join_table), mini_sql_ident_len(join_table))
      if join_ty != 0 {
        let field_ty = TypeCheck.resolve_field_type(join_ty, src, mini_sql_ident_start(column), mini_sql_ident_len(column))
        if field_ty != 0 { count = count + 1 } else { 0 }
      } else { 0 }
      i = i + 1
    }
  } else { 0 }
  count
}

pub(package) fn mini_sql_host_unique_column_type(query: i64, table_ty: i64, src: i64, column: i64) -[TypeCheck]> i64 {
  let mut found_ty = 0
  let mut count = 0
  let primary_ty = TypeCheck.resolve_field_type(table_ty, src, mini_sql_ident_start(column), mini_sql_ident_len(column))
  if primary_ty != 0 {
    found_ty = primary_ty
    count = count + 1
  } else { 0 }
  let joins = mini_sql_query_joins(query)
  if joins != 0 {
    let njoins = nlist_len(joins)
    let mut i = 0
    while i < njoins {
      let join = nlist_get(joins, i)
      let join_table = mini_sql_join_table_node(join)
      let join_table_ty = TypeCheck.resolve_type(src, mini_sql_ident_start(join_table), mini_sql_ident_len(join_table))
      if join_table_ty != 0 {
        let field_ty = TypeCheck.resolve_field_type(join_table_ty, src, mini_sql_ident_start(column), mini_sql_ident_len(column))
        if field_ty != 0 {
          found_ty = field_ty
          count = count + 1
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
  } else { 0 }
  if count == 1 { found_ty } else { 0 }
}

pub(package) fn mini_sql_host_unqualified_ref_type(expr: i64, query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let count = mini_sql_host_column_match_count(query, table_ty, src, expr)
  if count == 0 {
    mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(expr), host_offset)
    mini_sql_type_result(0, 1)
  } else { if count > 1 {
    mini_sql_type_error_at("mini_sql type error: ambiguous column", mini_sql_ident_start(expr), host_offset)
    mini_sql_type_result(0, 1)
  } else {
    mini_sql_type_result(mini_sql_host_unique_column_type(query, table_ty, src, expr), 0)
  } }
}

pub(package) fn mini_sql_host_qualified_source_type(query: i64, table_ty: i64, src: i64, qualifier: i64) -[TypeCheck]> i64 {
  if mini_sql_source_qualifier_matches(mini_sql_query_table_node(query), mini_sql_query_table_alias(query), src, qualifier) == 1 {
    table_ty
  } else {
    let joins = mini_sql_query_joins(query)
    if joins == 0 { 0 }
    else {
      let njoins = nlist_len(joins)
      let mut i = 0
      let mut found = 0
      while i < njoins and found == 0 {
        let join = nlist_get(joins, i)
        if mini_sql_source_qualifier_matches(mini_sql_join_table_node(join), mini_sql_join_table_alias(join), src, qualifier) == 1 {
          let join_table = mini_sql_join_table_node(join)
          found = TypeCheck.resolve_type(src, mini_sql_ident_start(join_table), mini_sql_ident_len(join_table))
        } else {
          i = i + 1
        }
      }
      found
    }
  }
}

pub(package) fn mini_sql_host_qualified_ref_type(expr: i64, query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let qualifier = mini_sql_qualified_ref_qualifier(expr)
  let field = mini_sql_qualified_ref_field(expr)
  if field == 0 { mini_sql_type_result(0, 0) }
  else {
    let source_ty = mini_sql_host_qualified_source_type(query, table_ty, src, qualifier)
    if source_ty == 0 {
      mini_sql_type_error_at("mini_sql type error: unknown table qualifier", mini_sql_ident_start(qualifier), host_offset)
      mini_sql_type_result(0, 1)
    } else {
      let col_ty = TypeCheck.resolve_field_type(source_ty, src, mini_sql_ident_start(field), mini_sql_ident_len(field))
      if col_ty == 0 {
        mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(field), host_offset)
        mini_sql_type_result(0, 1)
      } else {
        mini_sql_type_result(col_ty, 0)
      }
    }
  }
}

pub(package) fn mini_sql_host_scalar_type_with_aliases(expr: i64, query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if expr == 0 { mini_sql_type_result(0, 0) }
  else {
    match node_tag(expr) {
      702 -> {
        let field_count = mini_sql_host_column_match_count(query, table_ty, src, expr)
        if field_count == 1 {
          mini_sql_type_result(mini_sql_host_unique_column_type(query, table_ty, src, expr), 0)
        } else { if field_count > 1 {
          mini_sql_type_error_at("mini_sql type error: ambiguous column", mini_sql_ident_start(expr), host_offset)
          mini_sql_type_result(0, 1)
        } else {
          let alias_count = mini_sql_query_alias_count(query, src, expr)
          if alias_count == 1 {
            mini_sql_host_scalar_type_for_query(mini_sql_query_alias_expr(query, src, expr), query, table_ty, src, host_offset)
          } else { if alias_count > 1 {
            mini_sql_type_error_at("mini_sql type error: ambiguous projection alias", mini_sql_ident_start(expr), host_offset)
            mini_sql_type_result(0, 1)
          } else {
            mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(expr), host_offset)
            mini_sql_type_result(0, 1)
          } }
        } }
      }
      704 -> mini_sql_type_result(mini_sql_lit_weft_type(expr), 0)
      708 -> {
        let left = mini_sql_host_scalar_type_with_aliases(node_f1(expr), query, table_ty, src, host_offset)
        let right = mini_sql_host_scalar_type_with_aliases(node_f2(expr), query, table_ty, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let op = node_f3(expr)
        if mini_sql_expr_op_is_arithmetic(op) == 1 {
          if left_ty != 0 {
            let left_i64 = mini_sql_host_type_is_i64(left_ty)
            if left_i64 == 0 {
              mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          if right_ty != 0 {
            let right_i64 = mini_sql_host_type_is_i64(right_ty)
            if right_i64 == 0 {
              mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          mini_sql_type_result(ty_i64(), errors)
        } else {
          if left_ty != 0 {
            let left_str = mini_sql_host_type_is_str(left_ty)
            if left_str == 0 {
              mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          if right_ty != 0 {
            let right_str = mini_sql_host_type_is_str(right_ty)
            if right_str == 0 {
              mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          mini_sql_type_result(ty_str(), errors)
        }
      }
      712 -> mini_sql_host_scalar_type_for_query(expr, query, table_ty, src, host_offset)
      714 -> mini_sql_host_qualified_ref_type(expr, query, table_ty, src, host_offset)
      _ -> mini_sql_type_result(0, 0)
    }
  }
}

pub(package) fn mini_sql_host_predicate_type(pred: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if pred == 0 { mini_sql_type_result(0, 0) }
  else {
    match node_tag(pred) {
      702 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      703 -> {
        let left_expr = node_f1(pred)
        let right_expr = node_f2(pred)
        let op = node_f3(pred)
        let left = mini_sql_host_scalar_type(left_expr, table_ty, src, host_offset)
        let right = mini_sql_host_scalar_type(right_expr, table_ty, src, host_offset)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        if mini_sql_cmp_is_relational(op) == 1 and left_ty != 0 and right_ty != 0 {
          let left_numeric = mini_sql_host_type_is_i64(left_ty)
          let right_numeric = mini_sql_host_type_is_i64(right_ty)
          if left_numeric == 0 or right_numeric == 0 {
            mini_sql_type_error_at("mini_sql type error: relational predicate requires i64", mini_sql_projection_expr_start(right_expr), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(ty_bool(), errors)
        } else { if mini_sql_cmp_is_equality(op) == 1 and left_ty != 0 and right_ty != 0 {
          let same = mini_sql_host_type_eq(left_ty, right_ty)
          if same == 0 {
            mini_sql_type_error_at("mini_sql type error: predicate type mismatch", mini_sql_projection_expr_start(right_expr), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(ty_bool(), errors)
        } else {
          mini_sql_type_result(ty_bool(), errors)
        } }
      }
      704 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      706 -> {
        let left = mini_sql_host_predicate_type(node_f1(pred), table_ty, src, host_offset)
        let right = mini_sql_host_predicate_type(node_f2(pred), table_ty, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        if left_ty != 0 {
          let left_bool = mini_sql_host_type_is_bool(left_ty)
          if left_bool == 0 {
            mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f1(pred)), host_offset)
            errors = errors + 1
          } else { 0 }
        } else { 0 }
        if right_ty != 0 {
          let right_bool = mini_sql_host_type_is_bool(right_ty)
          if right_bool == 0 {
            mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f2(pred)), host_offset)
            errors = errors + 1
          } else { 0 }
        } else { 0 }
        mini_sql_type_result(ty_bool(), errors)
      }
      708 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      712 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      _ -> mini_sql_type_result(0, 0)
    }
  }
}

