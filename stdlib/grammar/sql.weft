pub(package) fn mini_sql_is_query_tail_start(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { 1 }
  else {
    if mini_sql_word_matches(src, n, p, "where") == 1 { 1 }
    else { if mini_sql_word_matches(src, n, p, "group") == 1 { 1 }
    else { if mini_sql_word_matches(src, n, p, "having") == 1 { 1 }
    else { if mini_sql_word_matches(src, n, p, "order") == 1 { 1 }
    else { if mini_sql_word_matches(src, n, p, "limit") == 1 { 1 }
    else { if mini_sql_word_matches(src, n, p, "offset") == 1 { 1 }
    else { 0 } } } } } }
  }
}

pub(package) fn mini_sql_parse_joins(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let joins = nlist_new()
  let mut p = mini_sql_skip_ws(src, n, pos)
  while p < n and mini_sql_word_matches(src, n, p, "join") == 1 {
    p = mini_sql_skip_ws(src, n, p + 4)
    let table_res = mini_sql_parse_ident(src, n, p)
    let table_node = mini_sql_result_node(table_res)
    if table_node == 0 {
      mini_sql_error_at("mini_sql parse error: expected join table name", mini_sql_result_pos(table_res), host_offset)
      p = mini_sql_result_pos(table_res)
    } else {
      p = mini_sql_result_pos(table_res)
    }
    let alias_res = mini_sql_parse_table_alias(src, n, p, host_offset)
    let table_alias = mini_sql_alias_result_alias(alias_res)
    p = mini_sql_alias_result_pos(alias_res)
    p = mini_sql_skip_ws(src, n, p)
    if mini_sql_word_matches(src, n, p, "on") == 0 {
      mini_sql_error_at("mini_sql parse error: expected ON", p, host_offset)
      nlist_add(joins, mini_sql_join_new(table_node, table_alias, 0))
      if mini_sql_is_query_tail_start(src, n, p) == 1 {
        0
      } else {
        p = n
      }
    } else {
      let on_res = mini_sql_parse_predicate_or(src, n, p + 2, host_offset)
      let on_node = mini_sql_result_node(on_res)
      if on_node == 0 {
        mini_sql_error_at("mini_sql parse error: expected join predicate", mini_sql_result_pos(on_res), host_offset)
      } else { 0 }
      nlist_add(joins, mini_sql_join_new(table_node, table_alias, on_node))
      p = mini_sql_skip_ws(src, n, mini_sql_result_pos(on_res))
    }
  }
  mini_sql_result(joins, p)
}

pub(package) fn mini_sql_parse_projection_item(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let expr_res = mini_sql_parse_projection_expr(src, n, pos, host_offset)
  let expr = mini_sql_result_node(expr_res)
  if expr == 0 {
    mini_sql_error_at("mini_sql parse error: expected selected expression", mini_sql_result_pos(expr_res), host_offset)
    mini_sql_result(0, mini_sql_result_pos(expr_res))
  } else {
    let alias_res = mini_sql_parse_projection_alias(src, n, mini_sql_result_pos(expr_res), host_offset)
    let alias = mini_sql_alias_result_alias(alias_res)
    let explicit_as = mini_sql_alias_result_explicit_as(alias_res)
    mini_sql_result(mini_sql_select_item_new(expr, alias, explicit_as), mini_sql_alias_result_pos(alias_res))
  }
}

pub(package) fn mini_sql_parse_columns(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let cols = nlist_new()
  let mut p = mini_sql_skip_ws(src, n, pos)
  let mut star = 0
  if p < n and mem_load8_at(src, p) == 42 {
    star = 1
    p = p + 1
  } else {
    let mut done = 0
    while done == 0 {
      let item_res = mini_sql_parse_projection_item(src, n, p, host_offset)
      let item = mini_sql_result_node(item_res)
      if item == 0 {
        p = mini_sql_result_pos(item_res)
        done = 1
      } else {
        nlist_add(cols, item)
        p = mini_sql_skip_ws(src, n, mini_sql_result_pos(item_res))
        if p < n and mem_load8_at(src, p) == 44 {
          p = mini_sql_skip_ws(src, n, p + 1)
          if mini_sql_word_matches(src, n, p, "from") == 1 {
            mini_sql_error_at("mini_sql parse error: expected selected expression after comma", p, host_offset)
            done = 1
          } else { 0 }
        } else {
          done = 1
        }
      }
    }
  }
  let result = alloc_zeroed(24)
  mem_store64_at(result, 0, cols)
  mem_store64_at(result, 8, p)
  mem_store64_at(result, 16, star)
  result
}

pub(package) fn mini_sql_columns_result_cols(result: i64) -> i64 { mem_load64_at(result, 0) }
pub(package) fn mini_sql_columns_result_pos(result: i64) -> i64 { mem_load64_at(result, 8) }
pub(package) fn mini_sql_columns_result_star(result: i64) -> i64 { mem_load64_at(result, 16) }

pub(package) fn mini_sql_parse_cmp_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    let ch = mem_load8_at(src, p)
    match ch {
      61 -> mini_sql_result(mini_sql_cmp_eq(), p + 1)
      33 -> {
        if p + 1 < n and mem_load8_at(src, p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_ne(), p + 2)
        } else { mini_sql_result(0, p) }
      }
      60 -> {
        if p + 1 < n and mem_load8_at(src, p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_le(), p + 2)
        } else { if p + 1 < n and mem_load8_at(src, p + 1) == 62 {
          mini_sql_result(mini_sql_cmp_ne(), p + 2)
        } else { mini_sql_result(mini_sql_cmp_lt(), p + 1) } }
      }
      62 -> {
        if p + 1 < n and mem_load8_at(src, p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_ge(), p + 2)
        } else { mini_sql_result(mini_sql_cmp_gt(), p + 1) }
      }
      _ -> mini_sql_result(0, p)
    }
  }
}

pub(package) fn mini_sql_parse_predicate_leaf(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let left_res = mini_sql_parse_scalar_expr(src, n, p, host_offset)
  let left = mini_sql_result_node(left_res)
  if left == 0 {
    mini_sql_error_at("mini_sql parse error: expected predicate expression", mini_sql_result_pos(left_res), host_offset)
    mini_sql_result(0, n)
  } else {
    let op_res = mini_sql_parse_cmp_op(src, n, mini_sql_result_pos(left_res))
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      left_res
    } else {
      let right_res = mini_sql_parse_scalar_expr(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected predicate expression", mini_sql_result_pos(right_res), host_offset)
        mini_sql_result(mini_sql_where_cmp_new(left, 0, op), mini_sql_result_pos(right_res))
      } else {
        mini_sql_result(mini_sql_where_cmp_new(left, right, op), mini_sql_result_pos(right_res))
      }
    }
  }
}

pub(package) fn mini_sql_parse_predicate_atom(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p < n and mem_load8_at(src, p) == 40 {
    let inner_res = mini_sql_parse_predicate_or(src, n, p + 1, host_offset)
    let inner = mini_sql_result_node(inner_res)
    let after_inner = mini_sql_skip_ws(src, n, mini_sql_result_pos(inner_res))
    if after_inner < n and mem_load8_at(src, after_inner) == 41 {
      mini_sql_result(inner, after_inner + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: expected ')' in predicate", after_inner, host_offset)
      mini_sql_result(inner, after_inner)
    }
  } else {
    mini_sql_parse_predicate_leaf(src, n, p, host_offset)
  }
}

pub(package) fn mini_sql_parse_predicate_and(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_predicate_atom(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let next = mini_sql_skip_ws(src, n, p)
    if mini_sql_word_matches(src, n, next, "and") == 1 {
      let right_res = mini_sql_parse_predicate_atom(src, n, next + 3, host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        left = mini_sql_where_bool_new(left, 0, mini_sql_logic_and())
      } else {
        left = mini_sql_where_bool_new(left, right, mini_sql_logic_and())
      }
      p = mini_sql_result_pos(right_res)
    } else {
      done = 1
    }
  }
  mini_sql_result(left, p)
}

pub(package) fn mini_sql_parse_predicate_or(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_predicate_and(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let next = mini_sql_skip_ws(src, n, p)
    if mini_sql_word_matches(src, n, next, "or") == 1 {
      let right_res = mini_sql_parse_predicate_and(src, n, next + 2, host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        left = mini_sql_where_bool_new(left, 0, mini_sql_logic_or())
      } else {
        left = mini_sql_where_bool_new(left, right, mini_sql_logic_or())
      }
      p = mini_sql_result_pos(right_res)
    } else {
      done = 1
    }
  }
  mini_sql_result(left, p)
}

pub(package) fn mini_sql_parse_where(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "where") == 0 { mini_sql_result(0, p) }
  else {
    p = mini_sql_skip_ws(src, n, p + 5)
    mini_sql_parse_predicate_or(src, n, p, host_offset)
  }
}

pub(package) fn mini_sql_parse_group_by(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let items = nlist_new()
  let mut p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "group") == 0 { mini_sql_result(items, p) }
  else {
    p = mini_sql_skip_ws(src, n, p + 5)
    if mini_sql_word_matches(src, n, p, "by") == 0 {
      mini_sql_error_at("mini_sql parse error: expected BY", p, host_offset)
      mini_sql_result(items, n)
    } else {
      p = mini_sql_skip_ws(src, n, p + 2)
      let mut done = 0
      while done == 0 {
        let expr_res = mini_sql_parse_scalar_expr(src, n, p, host_offset)
        let expr = mini_sql_result_node(expr_res)
        if expr == 0 {
          mini_sql_error_at("mini_sql parse error: expected group expression", mini_sql_result_pos(expr_res), host_offset)
          p = n
          done = 1
        } else {
          nlist_add(items, expr)
          p = mini_sql_skip_ws(src, n, mini_sql_result_pos(expr_res))
          if p < n and mem_load8_at(src, p) == 44 {
            p = mini_sql_skip_ws(src, n, p + 1)
          } else {
            done = 1
          }
        }
      }
      mini_sql_result(items, p)
    }
  }
}

pub(package) fn mini_sql_parse_having(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "having") == 0 { mini_sql_result(0, p) }
  else {
    p = mini_sql_skip_ws(src, n, p + 6)
    mini_sql_parse_predicate_or(src, n, p, host_offset)
  }
}

pub(package) fn mini_sql_parse_order_by(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let items = nlist_new()
  let mut p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "order") == 0 { mini_sql_result(items, p) }
  else {
    p = mini_sql_skip_ws(src, n, p + 5)
    if mini_sql_word_matches(src, n, p, "by") == 0 {
      mini_sql_error_at("mini_sql parse error: expected BY", p, host_offset)
      mini_sql_result(items, n)
    } else {
      p = mini_sql_skip_ws(src, n, p + 2)
      let mut done = 0
      while done == 0 {
        let expr_res = mini_sql_parse_scalar_expr(src, n, p, host_offset)
        let expr = mini_sql_result_node(expr_res)
        if expr == 0 {
          mini_sql_error_at("mini_sql parse error: expected order expression", mini_sql_result_pos(expr_res), host_offset)
          p = n
          done = 1
        } else {
          p = mini_sql_skip_ws(src, n, mini_sql_result_pos(expr_res))
          let mut direction = mini_sql_order_asc()
          if mini_sql_word_matches(src, n, p, "asc") == 1 {
            p = mini_sql_skip_ws(src, n, p + 3)
          } else { if mini_sql_word_matches(src, n, p, "desc") == 1 {
            direction = mini_sql_order_desc()
            p = mini_sql_skip_ws(src, n, p + 4)
          } else { 0 } }
          nlist_add(items, mini_sql_order_item_new(expr, direction))
          if p < n and mem_load8_at(src, p) == 44 {
            p = mini_sql_skip_ws(src, n, p + 1)
          } else {
            done = 1
          }
        }
      }
      mini_sql_result(items, p)
    }
  }
}

pub(package) fn mini_sql_limit_offset_result(limit_expr: i64, offset_expr: i64, pos: i64) -> i64 {
  let result = alloc_zeroed(24)
  mem_store64_at(result, 0, limit_expr)
  mem_store64_at(result, 8, offset_expr)
  mem_store64_at(result, 16, pos)
  result
}

pub(package) fn mini_sql_limit_offset_result_limit(result: i64) -> i64 { mem_load64_at(result, 0) }
pub(package) fn mini_sql_limit_offset_result_offset(result: i64) -> i64 { mem_load64_at(result, 8) }
pub(package) fn mini_sql_limit_offset_result_pos(result: i64) -> i64 { mem_load64_at(result, 16) }

pub(package) fn mini_sql_parse_limit_offset(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, pos)
  let mut limit_expr = 0
  let mut offset_expr = 0
  if mini_sql_word_matches(src, n, p, "limit") == 1 {
    let expr_res = mini_sql_parse_scalar_expr(src, n, p + 5, host_offset)
    let expr = mini_sql_result_node(expr_res)
    if expr == 0 {
      mini_sql_error_at("mini_sql parse error: expected limit expression", mini_sql_result_pos(expr_res), host_offset)
      p = n
    } else {
      limit_expr = expr
      p = mini_sql_skip_ws(src, n, mini_sql_result_pos(expr_res))
    }
  } else { 0 }
  if p < n and mini_sql_word_matches(src, n, p, "offset") == 1 {
    let expr_res = mini_sql_parse_scalar_expr(src, n, p + 6, host_offset)
    let expr = mini_sql_result_node(expr_res)
    if expr == 0 {
      mini_sql_error_at("mini_sql parse error: expected offset expression", mini_sql_result_pos(expr_res), host_offset)
      p = n
    } else {
      offset_expr = expr
      p = mini_sql_skip_ws(src, n, mini_sql_result_pos(expr_res))
    }
  } else { 0 }
  mini_sql_limit_offset_result(limit_expr, offset_expr, p)
}

pub(package) fn mini_sql_parse_source_at(src: i64, n: i64, tt: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, 0)
  if mini_sql_word_matches(src, n, p, "select") == 0 {
    mini_sql_error_at("mini_sql parse error: expected SELECT", p, host_offset)
    mini_sql_empty_query()
  } else {
    p = mini_sql_skip_ws(src, n, p + 6)
    let distinct = if mini_sql_word_matches(src, n, p, "distinct") == 1 { 1 } else { 0 }
    if distinct == 1 { p = mini_sql_skip_ws(src, n, p + 8) } else { 0 }
    let cols_res = mini_sql_parse_columns(src, n, p, host_offset)
    let cols = mini_sql_columns_result_cols(cols_res)
    let star = mini_sql_columns_result_star(cols_res)
    p = mini_sql_skip_ws(src, n, mini_sql_columns_result_pos(cols_res))
    if mini_sql_word_matches(src, n, p, "from") == 0 {
      mini_sql_error_at("mini_sql parse error: expected FROM", p, host_offset)
      p = mini_sql_recover_to_keyword(src, n, p, "from")
    } else { 0 }
    if p < n and mini_sql_word_matches(src, n, p, "from") == 1 { p = mini_sql_skip_ws(src, n, p + 4) } else { 0 }
    let table_res = mini_sql_parse_ident(src, n, p)
    let table_node = mini_sql_result_node(table_res)
    if table_node == 0 {
      mini_sql_error_at("mini_sql parse error: expected table name", mini_sql_result_pos(table_res), host_offset)
    } else {
      p = mini_sql_result_pos(table_res)
    }
    let alias_res = mini_sql_parse_table_alias(src, n, p, host_offset)
    let table_alias = mini_sql_alias_result_alias(alias_res)
    p = mini_sql_alias_result_pos(alias_res)
    let joins_res = mini_sql_parse_joins(src, n, p, host_offset)
    let joins = mini_sql_result_node(joins_res)
    p = mini_sql_result_pos(joins_res)
    let where_res = mini_sql_parse_where(src, n, p, host_offset)
    let where_node = mini_sql_result_node(where_res)
    p = mini_sql_skip_ws(src, n, mini_sql_result_pos(where_res))
    let group_res = mini_sql_parse_group_by(src, n, p, host_offset)
    let group_items = mini_sql_result_node(group_res)
    p = mini_sql_skip_ws(src, n, mini_sql_result_pos(group_res))
    let having_res = mini_sql_parse_having(src, n, p, host_offset)
    let having_node = mini_sql_result_node(having_res)
    p = mini_sql_skip_ws(src, n, mini_sql_result_pos(having_res))
    let order_res = mini_sql_parse_order_by(src, n, p, host_offset)
    let order_items = mini_sql_result_node(order_res)
    p = mini_sql_skip_ws(src, n, mini_sql_result_pos(order_res))
    let limit_res = mini_sql_parse_limit_offset(src, n, p, host_offset)
    let limit_expr = mini_sql_limit_offset_result_limit(limit_res)
    let offset_expr = mini_sql_limit_offset_result_offset(limit_res)
    p = mini_sql_skip_ws(src, n, mini_sql_limit_offset_result_pos(limit_res))
    if p < n {
      mini_sql_error_at("mini_sql parse error: unexpected trailing input", p, host_offset)
    } else { 0 }
    let tail = mini_sql_query_tail_new(group_items, having_node, order_items, limit_expr, offset_expr)
    mini_sql_query_new_with_distinct(cols, table_node, where_node, star, distinct, tail, table_alias, joins)
  }
}

pub(package) fn mini_sql_parse_source(src: i64, n: i64, tt: i64) -[Diagnose]> i64 {
  mini_sql_parse_source_at(src, n, tt, 0)
}

pub(package) fn mini_sql_table_id(src: i64, table_node: i64) -> i64 {
  if mini_sql_ident_eq(src, table_node, "users") == 1 { mini_sql_table_users() }
  else { if mini_sql_ident_eq(src, table_node, "orders") == 1 { mini_sql_table_orders() }
  else { mini_sql_table_unknown() } }
}

pub(package) fn mini_sql_column_type(table_id: i64, src: i64, column: i64) -> i64 {
  match table_id {
    1 -> {
      if mini_sql_ident_eq(src, column, "id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "name") == 1 { mini_sql_ty_str() }
      else { if mini_sql_ident_eq(src, column, "active") == 1 { mini_sql_ty_bool() }
      else { mini_sql_ty_unknown() } } }
    }
    2 -> {
      if mini_sql_ident_eq(src, column, "id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "user_id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "total") == 1 { mini_sql_ty_i64() }
      else { mini_sql_ty_unknown() } } }
    }
    _ -> mini_sql_ty_unknown()
  }
}

pub(package) fn mini_sql_catalog_column_match_count(query: i64, table_id: i64, src: i64, column: i64) -> i64 {
  let mut count = 0
  if mini_sql_column_type(table_id, src, column) != mini_sql_ty_unknown() {
    count = count + 1
  } else { 0 }
  let joins = mini_sql_query_joins(query)
  if joins != 0 {
    let njoins = nlist_len(joins)
    let mut i = 0
    while i < njoins {
      let join = nlist_get(joins, i)
      let join_table_id = mini_sql_table_id(src, mini_sql_join_table_node(join))
      if mini_sql_column_type(join_table_id, src, column) != mini_sql_ty_unknown() {
        count = count + 1
      } else { 0 }
      i = i + 1
    }
  } else { 0 }
  count
}

pub(package) fn mini_sql_catalog_unique_column_type(query: i64, table_id: i64, src: i64, column: i64) -> i64 {
  let mut found_ty = mini_sql_ty_unknown()
  let mut count = 0
  let primary_ty = mini_sql_column_type(table_id, src, column)
  if primary_ty != mini_sql_ty_unknown() {
    found_ty = primary_ty
    count = count + 1
  } else { 0 }
  let joins = mini_sql_query_joins(query)
  if joins != 0 {
    let njoins = nlist_len(joins)
    let mut i = 0
    while i < njoins {
      let join = nlist_get(joins, i)
      let join_ty = mini_sql_column_type(mini_sql_table_id(src, mini_sql_join_table_node(join)), src, column)
      if join_ty != mini_sql_ty_unknown() {
        found_ty = join_ty
        count = count + 1
      } else { 0 }
      i = i + 1
    }
  } else { 0 }
  if count == 1 { found_ty } else { mini_sql_ty_unknown() }
}

pub(package) fn mini_sql_catalog_unqualified_ref_type(expr: i64, query: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  let count = mini_sql_catalog_column_match_count(query, table_id, src, expr)
  if count == 0 {
    mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(expr), host_offset)
    mini_sql_type_result(mini_sql_ty_unknown(), 1)
  } else { if count > 1 {
    mini_sql_type_error_at("mini_sql type error: ambiguous column", mini_sql_ident_start(expr), host_offset)
    mini_sql_type_result(mini_sql_ty_unknown(), 1)
  } else {
    mini_sql_type_result(mini_sql_catalog_unique_column_type(query, table_id, src, expr), 0)
  } }
}

pub(package) fn mini_sql_catalog_qualified_source_table_id(query: i64, table_id: i64, src: i64, qualifier: i64) -> i64 {
  if mini_sql_source_qualifier_matches(mini_sql_query_table_node(query), mini_sql_query_table_alias(query), src, qualifier) == 1 {
    table_id
  } else {
    let joins = mini_sql_query_joins(query)
    if joins == 0 { mini_sql_table_unknown() }
    else {
      let njoins = nlist_len(joins)
      let mut i = 0
      let mut found = mini_sql_table_unknown()
      while i < njoins and found == mini_sql_table_unknown() {
        let join = nlist_get(joins, i)
        if mini_sql_source_qualifier_matches(mini_sql_join_table_node(join), mini_sql_join_table_alias(join), src, qualifier) == 1 {
          found = mini_sql_table_id(src, mini_sql_join_table_node(join))
        } else {
          i = i + 1
        }
      }
      found
    }
  }
}

pub(package) fn mini_sql_catalog_qualified_ref_type(expr: i64, query: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  let qualifier = mini_sql_qualified_ref_qualifier(expr)
  let field = mini_sql_qualified_ref_field(expr)
  if field == 0 { mini_sql_type_result(mini_sql_ty_unknown(), 0) }
  else {
    let source_table_id = mini_sql_catalog_qualified_source_table_id(query, table_id, src, qualifier)
    if source_table_id == mini_sql_table_unknown() {
      mini_sql_type_error_at("mini_sql type error: unknown table qualifier", mini_sql_ident_start(qualifier), host_offset)
      mini_sql_type_result(mini_sql_ty_unknown(), 1)
    } else {
      let col_type = mini_sql_column_type(source_table_id, src, field)
      if col_type == mini_sql_ty_unknown() {
        mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(field), host_offset)
        mini_sql_type_result(mini_sql_ty_unknown(), 1)
      } else {
        mini_sql_type_result(col_type, 0)
      }
    }
  }
}

pub(package) fn mini_sql_type_error_at(msg: str, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  Diagnose.error(msg, host_offset + pos)
}

pub(package) fn mini_sql_projection_expr_start(expr: i64) -> i64 {
  if expr == 0 { 0 }
  else {
    match node_tag(expr) {
      702 -> mini_sql_ident_start(expr)
      704 -> node_f1(expr)
      708 -> mini_sql_projection_expr_start(node_f1(expr))
      712 -> mini_sql_agg_start(expr)
      714 -> mini_sql_qualified_ref_start(expr)
      _ -> 0
    }
  }
}

pub(package) fn mini_sql_expr_has_aggregate(expr: i64) -> i64 {
  if expr == 0 { 0 }
  else {
    match node_tag(expr) {
      703 -> {
        if mini_sql_expr_has_aggregate(node_f1(expr)) == 1 { 1 }
        else { mini_sql_expr_has_aggregate(node_f2(expr)) }
      }
      706 -> {
        if mini_sql_expr_has_aggregate(node_f1(expr)) == 1 { 1 }
        else { mini_sql_expr_has_aggregate(node_f2(expr)) }
      }
      708 -> {
        if mini_sql_expr_has_aggregate(node_f1(expr)) == 1 { 1 }
        else { mini_sql_expr_has_aggregate(node_f2(expr)) }
      }
      712 -> 1
      _ -> 0
    }
  }
}

pub(package) fn mini_sql_ident_same(src: i64, left: i64, right: i64) -> i64 {
  if left == 0 or right == 0 { 0 }
  else {
    let llen = mini_sql_ident_len(left)
    let rlen = mini_sql_ident_len(right)
    if llen != rlen { 0 }
    else {
      let mut i = 0
      let mut ok = 1
      while i < llen {
        let lc = mini_sql_ascii_lower(mem_load8_at(src, mini_sql_ident_start(left) + i))
        let rc = mini_sql_ascii_lower(mem_load8_at(src, mini_sql_ident_start(right) + i))
        if lc != rc {
          ok = 0
          i = llen
        } else {
          i = i + 1
        }
      }
      ok
    }
  }
}

pub(package) fn mini_sql_expr_same(src: i64, left: i64, right: i64) -> i64 {
  if left == 0 or right == 0 { 0 }
  else {
    let ltag = node_tag(left)
    let rtag = node_tag(right)
    if ltag != rtag { 0 }
    else {
      match ltag {
        702 -> mini_sql_ident_same(src, left, right)
        714 -> {
          if mini_sql_ident_same(src, mini_sql_qualified_ref_qualifier(left), mini_sql_qualified_ref_qualifier(right)) == 1 {
            mini_sql_ident_same(src, mini_sql_qualified_ref_field(left), mini_sql_qualified_ref_field(right))
          } else { 0 }
        }
        704 -> {
          if mini_sql_lit_type(left) != mini_sql_lit_type(right) { 0 }
          else {
            let lty = mini_sql_lit_type(left)
            if lty == mini_sql_ty_str() {
              if node_f2(left) != node_f2(right) { 0 }
              else {
                let mut i = 0
                let mut ok = 1
                while i < node_f2(left) {
                  if mem_load8_at(src, node_f1(left) + i) != mem_load8_at(src, node_f1(right) + i) {
                    ok = 0
                    i = node_f2(left)
                  } else {
                    i = i + 1
                  }
                }
                ok
              }
            } else {
              if node_f4(left) == node_f4(right) { 1 } else { 0 }
            }
          }
        }
        708 -> {
          if node_f3(left) != node_f3(right) { 0 }
          else {
            if mini_sql_expr_same(src, node_f1(left), node_f1(right)) == 1 {
              mini_sql_expr_same(src, node_f2(left), node_f2(right))
            } else { 0 }
          }
        }
        _ -> 0
      }
    }
  }
}

pub(package) fn mini_sql_expr_matches_group(expr: i64, group_items: i64, src: i64) -> i64 {
  if group_items == 0 { 0 }
  else {
    let nitems = nlist_len(group_items)
    let mut i = 0
    let mut found = 0
    while i < nitems and found == 0 {
      if mini_sql_expr_same(src, expr, nlist_get(group_items, i)) == 1 {
        found = 1
      } else {
        i = i + 1
      }
    }
    found
  }
}

