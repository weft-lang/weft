pub(package) fn mini_sql_order_item_tag() -> i64 { 710 }
pub(package) fn mini_sql_query_tail_tag() -> i64 { 711 }
pub(package) fn mini_sql_agg_call_tag() -> i64 { 712 }
pub(package) fn mini_sql_paging_tag() -> i64 { 713 }
pub(package) fn mini_sql_qualified_ref_tag() -> i64 { 714 }
pub(package) fn mini_sql_join_tag() -> i64 { 715 }

pub(package) fn mini_sql_cmp_eq() -> i64 { 1 }
pub(package) fn mini_sql_cmp_ne() -> i64 { 2 }
