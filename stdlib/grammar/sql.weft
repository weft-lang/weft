pub(package) fn mini_sql_table_users() -> i64 { 1 }
pub(package) fn mini_sql_table_orders() -> i64 { 2 }

pub(package) fn mini_sql_result(node: i64, pos: i64) -> i64 {
  let r = alloc_zeroed(16)
  mem_store64_at(r, 0, node)
  mem_store64_at(r, 8, pos)
  r
}

pub(package) fn mini_sql_result_node(r: i64) -> i64 { mem_load64_at(r, 0) }
pub(package) fn mini_sql_result_pos(r: i64) -> i64 { mem_load64_at(r, 8) }

pub(package) fn mini_sql_paging_new(limit_expr: i64, offset_expr: i64) -> i64 {
  node_new(mini_sql_paging_tag(), limit_expr, offset_expr, 0, 0)
}

pub(package) fn mini_sql_query_tail_new(group_items: i64, having_node: i64, order_items: i64, limit_expr: i64, offset_expr: i64) -> i64 {
  node_new(mini_sql_query_tail_tag(), group_items, having_node, order_items, mini_sql_paging_new(limit_expr, offset_expr))
}

pub(package) fn mini_sql_query_flags(star: i64, distinct: i64) -> i64 {
  star + distinct * 2
}

pub(package) fn mini_sql_query_meta_new_with_flags(flags: i64, tail: i64, table_alias: i64, joins: i64) -> i64 {
  node_new(mini_sql_query_meta_tag(), flags, tail, table_alias, joins)
}

pub(package) fn mini_sql_query_meta_new_with_joins(star: i64, tail: i64, table_alias: i64, joins: i64) -> i64 {
  mini_sql_query_meta_new_with_flags(mini_sql_query_flags(star, 0), tail, table_alias, joins)
}

pub(package) fn mini_sql_query_meta_new(star: i64, tail: i64, table_alias: i64) -> i64 {
  mini_sql_query_meta_new_with_joins(star, tail, table_alias, nlist_new())
}

pub(package) fn mini_sql_query_new_with_distinct(columns: i64, table_node: i64, where_node: i64, star: i64, distinct: i64, tail: i64, table_alias: i64, joins: i64) -> i64 {
  node_new(mini_sql_query_tag(), columns, table_node, where_node, mini_sql_query_meta_new_with_flags(mini_sql_query_flags(star, distinct), tail, table_alias, joins))
}

pub(package) fn mini_sql_query_new_with_joins(columns: i64, table_node: i64, where_node: i64, star: i64, tail: i64, table_alias: i64, joins: i64) -> i64 {
  node_new(mini_sql_query_tag(), columns, table_node, where_node, mini_sql_query_meta_new_with_joins(star, tail, table_alias, joins))
}

pub(package) fn mini_sql_query_new_with_tail(columns: i64, table_node: i64, where_node: i64, star: i64, tail: i64, table_alias: i64) -> i64 {
  node_new(mini_sql_query_tag(), columns, table_node, where_node, mini_sql_query_meta_new(star, tail, table_alias))
}

pub(package) fn mini_sql_query_new_with_order(columns: i64, table_node: i64, where_node: i64, star: i64, order_items: i64) -> i64 {
  mini_sql_query_new_with_tail(columns, table_node, where_node, star, mini_sql_query_tail_new(nlist_new(), 0, order_items, 0, 0), 0)
}

pub(package) fn mini_sql_query_new(columns: i64, table_node: i64, where_node: i64, star: i64) -> i64 {
  mini_sql_query_new_with_order(columns, table_node, where_node, star, nlist_new())
}

