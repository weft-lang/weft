}

pub(package) fn mini_sql_tokens_source_len(tokens: i64) -> i64 {
  if tokens == 0 { 0 }
  else { if node_tag(tokens) == mini_sql_tokens_tag() { node_f1(tokens) } else { 0 } }
}

pub(package) fn mini_sql_query_column_count(query: i64) -> i64 {
  if query == 0 { 0 } else { nlist_len(node_f1(query)) }
}

pub(package) fn mini_sql_query_meta_flags(query: i64) -> i64 {
  if query == 0 { 0 }
  else {
    let meta = node_f4(query)
    if meta == 0 { 0 }
    else { if meta == 1 { 1 } else { node_f1(meta) } }
  }
}

pub(package) fn mini_sql_query_star(query: i64) -> i64 {
  let flags = mini_sql_query_meta_flags(query)
  if flags == 1 or flags == 3 { 1 } else { 0 }
}

pub(package) fn mini_sql_query_distinct(query: i64) -> i64 {
  let flags = mini_sql_query_meta_flags(query)
  if flags == 2 or flags == 3 { 1 } else { 0 }
}

pub(package) fn mini_sql_query_has_distinct(query: i64) -> i64 {
  mini_sql_query_distinct(query)
}

pub(package) fn mini_sql_query_has_where(query: i64) -> i64 {
  if query == 0 { 0 } else { if node_f3(query) == 0 { 0 } else { 1 } }
}

