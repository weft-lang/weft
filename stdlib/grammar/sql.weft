        errors = errors + 1
      } else { 0 }
    } else { 0 }
    errors
  }
}

pub(package) fn mini_sql_check_host_joins(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let joins = mini_sql_query_joins(query)
  if joins == 0 { 0 }
  else {
    let njoins = nlist_len(joins)
    let mut i = 0
    let mut errors = 0
    while i < njoins {
      let join = nlist_get(joins, i)
      let join_table = mini_sql_join_table_node(join)
      let join_ty = TypeCheck.resolve_type(src, mini_sql_ident_start(join_table), mini_sql_ident_len(join_table))
      if join_ty == 0 {
        mini_sql_type_error_at("mini_sql type error: unknown table", mini_sql_ident_start(join_table), host_offset)
        errors = errors + 1
      } else { 0 }
      let on_node = mini_sql_join_on_node(join)
      if on_node != 0 {
        let result = mini_sql_host_predicate_type_for_query(on_node, query, table_ty, src, host_offset)
        errors = errors + mini_sql_type_result_errors(result)
        if mini_sql_expr_has_aggregate(on_node) == 1 {
          mini_sql_type_error_at("mini_sql type error: aggregate not allowed in JOIN ON", mini_sql_predicate_start(on_node), host_offset)
          errors = errors + 1
        } else { 0 }
        let ty = mini_sql_type_result_ty(result)
        if ty != 0 {
          let is_bool = mini_sql_host_type_is_bool(ty)
          if is_bool == 0 {
            mini_sql_type_error_at("mini_sql type error: join predicate must be bool", mini_sql_predicate_start(on_node), host_offset)
            errors = errors + 1
          } else { 0 }
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    errors
  }
}

pub(package) fn mini_sql_check_host_group_by(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let items = mini_sql_query_group_items(query)
  if items == 0 { 0 }
  else {
    let nitems = nlist_len(items)
    let mut i = 0
    let mut errors = 0
    while i < nitems {
      let expr = nlist_get(items, i)
      let result = mini_sql_host_scalar_type_for_query(expr, query, table_ty, src, host_offset)
      errors = errors + mini_sql_type_result_errors(result)
      if mini_sql_expr_has_aggregate(expr) == 1 {
        mini_sql_type_error_at("mini_sql type error: aggregate not allowed in GROUP BY", mini_sql_projection_expr_start(expr), host_offset)
        errors = errors + 1
      } else { 0 }
      i = i + 1
    }
    errors
  }
}

pub(package) fn mini_sql_check_host_having(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let having = mini_sql_query_having_node(query)
  if having == 0 { 0 }
  else {
    let result = mini_sql_host_predicate_type_with_aliases(having, query, table_ty, src, host_offset)
    let mut errors = mini_sql_type_result_errors(result)
    let ty = mini_sql_type_result_ty(result)
    if ty != 0 {
      let is_bool = mini_sql_host_type_is_bool(ty)
      if is_bool == 0 {
        mini_sql_type_error_at("mini_sql type error: having expression must be bool", mini_sql_predicate_start(having), host_offset)
        errors = errors + 1
      } else { 0 }
    } else { 0 }
    if mini_sql_expr_grouped_ok_with_aliases_host(having, query, mini_sql_query_group_items(query), table_ty, src) == 0 {
      mini_sql_type_error_at("mini_sql type error: non-aggregate HAVING expression must appear in GROUP BY", mini_sql_predicate_start(having), host_offset)
      errors = errors + 1
    } else { 0 }
    errors
  }
}

pub(package) fn mini_sql_check_host_order(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let items = mini_sql_query_order_items(query)
  if items == 0 { 0 }
  else {
    let nitems = nlist_len(items)
    let mut i = 0
    let mut errors = 0
    while i < nitems {
      let item = nlist_get(items, i)
      let result = mini_sql_host_scalar_type_with_aliases(mini_sql_order_item_expr(item), query, table_ty, src, host_offset)
      errors = errors + mini_sql_type_result_errors(result)
      i = i + 1
    }
    errors
  }
}

pub(package) fn mini_sql_check_grouped_query_host(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if mini_sql_query_is_grouped(query) == 0 { 0 }
  else {
    let group_items = mini_sql_query_group_items(query)
    let mut errors = 0
    if mini_sql_query_star(query) == 1 {
      mini_sql_type_error_at("mini_sql type error: grouped query cannot select star", 0, host_offset)
      errors = errors + 1
    } else {
      let cols = node_f1(query)
      let ncols = nlist_len(cols)
      let mut i = 0
      while i < ncols {
        let expr = mini_sql_select_item_expr(nlist_get(cols, i))
        if mini_sql_expr_grouped_ok(expr, group_items, src) == 0 {
          mini_sql_type_error_at("mini_sql type error: non-aggregate projection must appear in GROUP BY", mini_sql_projection_expr_start(expr), host_offset)
          errors = errors + 1
        } else { 0 }
        i = i + 1
      }
    }
    let order_items = mini_sql_query_order_items(query)
    if order_items != 0 {
      let norder = nlist_len(order_items)
      let mut j = 0
      while j < norder {
        let expr = mini_sql_order_item_expr(nlist_get(order_items, j))
        if mini_sql_expr_grouped_ok_with_aliases_host(expr, query, group_items, table_ty, src) == 0 {
          mini_sql_type_error_at("mini_sql type error: non-aggregate order expression must appear in GROUP BY", mini_sql_projection_expr_start(expr), host_offset)
          errors = errors + 1
        } else { 0 }
        j = j + 1
      }
    } else { 0 }
    errors
  }
}

pub(package) fn mini_sql_check_host_i64_tail_expr(expr: i64, query: i64, table_ty: i64, src: i64, host_offset: i64, msg: str) -[TypeCheck, Diagnose]> i64 {
  if expr == 0 { 0 }
  else {
    let result = mini_sql_host_scalar_type_for_query(expr, query, table_ty, src, host_offset)
    let mut errors = mini_sql_type_result_errors(result)
    if mini_sql_expr_has_aggregate(expr) == 1 {
      mini_sql_type_error_at("mini_sql type error: aggregate not allowed in query tail", mini_sql_projection_expr_start(expr), host_offset)
      errors = errors + 1
    } else { 0 }
    let ty = mini_sql_type_result_ty(result)
    if ty != 0 {
      let is_i64 = mini_sql_host_type_is_i64(ty)
      if is_i64 == 0 {
        mini_sql_type_error_at(msg, mini_sql_projection_expr_start(expr), host_offset)
        errors = errors + 1
      } else { 0 }
    } else { 0 }
    errors
  }
}

pub(package) fn mini_sql_check_host_limit_offset(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  mini_sql_check_host_i64_tail_expr(mini_sql_query_limit_expr(query), query, table_ty, src, host_offset, "mini_sql type error: limit expression requires i64") +
    mini_sql_check_host_i64_tail_expr(mini_sql_query_offset_expr(query), query, table_ty, src, host_offset, "mini_sql type error: offset expression requires i64")
}

pub(package) fn mini_sql_check_ast_host_at(query: i64, src: i64, tt: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let table_node = mini_sql_query_table_node(query)
  let table_ty = TypeCheck.resolve_type(src, mini_sql_ident_start(table_node), mini_sql_ident_len(table_node))
  if table_ty == 0 {
    mini_sql_type_error_at("mini_sql type error: unknown table", mini_sql_ident_start(table_node), host_offset)
    1
  } else {
    mini_sql_check_host_joins(query, table_ty, src, host_offset) + mini_sql_check_host_columns(query, table_ty, src, host_offset) + mini_sql_check_host_where(query, table_ty, src, host_offset) + mini_sql_check_host_group_by(query, table_ty, src, host_offset) + mini_sql_check_host_having(query, table_ty, src, host_offset) + mini_sql_check_host_order(query, table_ty, src, host_offset) + mini_sql_check_host_limit_offset(query, table_ty, src, host_offset) + mini_sql_check_grouped_query_host(query, table_ty, src, host_offset)
  }
}

pub(package) fn mini_sql_check_ast_host(query: i64, src: i64, tt: i64) -[TypeCheck, Diagnose]> i64 {
  mini_sql_check_ast_host_at(query, src, tt, 0)
}

impl Grammar for SqlGrammar {
  fn lex(self: i64, source: i64, source_len: i64) -> i64 {
    mini_sql_tokens_new(source_len)
  }

  fn parse_tokens(self: i64, tokens: i64, source: i64, tt: i64) -[Diagnose]> i64 {
    mini_sql_parse_source(source, mini_sql_tokens_source_len(tokens), tt)
  }

  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -[Diagnose]> i64 {
    mini_sql_parse_source(source, source_len, tt)
  }
}

impl TypedGrammar for SqlGrammar {
  fn check(self: i64, fns: i64, source: i64, tt: i64) -[TypeCheck, Diagnose]> i64 {
    mini_sql_check_ast_host(fns, source, tt)
  }
}
