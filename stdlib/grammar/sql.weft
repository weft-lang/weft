-- stdlib/grammar/sql.weft -- the first-party embedded SQL grammar module
--
-- This is intentionally not full SQL. It is the first non-Weft Grammar
-- implementation: SELECT projections FROM table with an optional WHERE.

use compiler/grammar.{*}
use compiler/diagnose.{*}
use compiler/lib.{*}
use compiler/parse.{*}
use compiler/typecheck_effect.{*}
use compiler/types.{*}
use runtime/alloc.{*}
use runtime/memory.{*}

pub type SqlGrammar { SqlGrammar }

pub fn mini_sql_grammar() -> SqlGrammar { SqlGrammar() }

pub(package) fn mini_sql_query_tag() -> i64 { 701 }
pub(package) fn mini_sql_ident_tag() -> i64 { 702 }
pub(package) fn mini_sql_where_eq_tag() -> i64 { 703 }
pub(package) fn mini_sql_lit_tag() -> i64 { 704 }
pub(package) fn mini_sql_tokens_tag() -> i64 { 705 }
