  if query == 0 { 0 }
  else {
    let meta = node_f4(query)
    if meta == 0 or meta == 1 { 0 }
    else {
      let tail = node_f2(meta)
      if tail == 0 { 0 } else { node_f3(tail) }
    }
  }
}

