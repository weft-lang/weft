-- stdlib/grammar/einsum.weft -- explicit einsum grammar

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{Diagnose, DiagnosticClassGrammar, DiagnosticSeverityError}
use stdlib/grammar as public_grammar
use stdlib/grammar.{Parsed, Rejected}
use stdlib/grammar/einsum/syntax.{*}
use stdlib/list as list
use stdlib/list.{Nil}
use stdlib/option
use stdlib/option.{Some, None}
use stdlib/source.{Span}

--- The first-party parser for explicit einsum equations.
pub type EinsumGrammar {
  --- Construct the stateless einsum parser value.
  EinsumGrammar
}

--- Construct the first-party einsum parser.
pub fn grammar() -> EinsumGrammar { EinsumGrammar() }

type EinsumSequenceDelimiter {
  EinsumSequenceComma,
  EinsumSequenceArrow,
  EinsumSequenceEnd
}

type EinsumSequenceParse {
  EinsumSequenceParsed(EinsumAxes, Span, usize, EinsumSequenceDelimiter),
  EinsumSequenceRejected
}

fn einsum_ascii_whitespace(byte: u8) -> bool {
  byte == 32 or byte == 9 or byte == 10 or byte == 13
}

fn einsum_ascii_axis(byte: u8) -> bool {
  (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
}

fn einsum_skip_whitespace(source: Span, initial: usize) -> usize {
  let mut position = initial
  let mut scanning = true
  while position < source.len() and scanning {
    match source.byte_at(position) {
      Some(byte) -> if einsum_ascii_whitespace(byte) { position = position + 1 }
        else { scanning = false }
      None -> { scanning = false }
    }
  }
  position
}

fn einsum_error_span(source: Span, position: usize) -> Span {
  let end = if position < source.len() { position + 1 } else { position }
  source.subspan(position, end).unwrap()
}

fn einsum_parse_error(source: Span, position: usize, message: str) -[Diagnose]> nil {
  Diagnose.report(diagnostic.uncoded(
    DiagnosticSeverityError,
    DiagnosticClassGrammar,
    message,
    einsum_error_span(source, position).location()
  ))
  nil
}

fn einsum_axis(source: Span, position: usize) -> EinsumAxis {
  let span = source.subspan(position, position + 1).unwrap()
  EinsumAxis { name: span.text().unwrap(), span: span }
}

fn einsum_parse_sequence(source: Span, initial: usize, allow_empty: bool, output: bool) -[Diagnose]> EinsumSequenceParse {
  let start = einsum_skip_whitespace(source, initial)
  let mut position = start
  let mut end = start
  let mut axes: EinsumAxes = Nil<EinsumAxis>()
  let mut delimiter = EinsumSequenceEnd
  let mut done = false
  while position < source.len() and not done {
    match source.byte_at(position) {
      None -> { done = true }
      Some(byte) -> if einsum_ascii_whitespace(byte) {
        position = position + 1
      } else { if einsum_ascii_axis(byte) {
        axes = axes.append(einsum_axis(source, position))
        position = position + 1
        end = position
      } else { if byte == 44 and not output {
        delimiter = EinsumSequenceComma
        position = position + 1
        done = true
      } else { if byte == 45 and not output {
        match source.byte_at(position + 1) {
          Some(next) if next == 62 -> {
            delimiter = EinsumSequenceArrow
            position = position + 2
            done = true
          }
          _ -> {
            einsum_parse_error(source, position, "einsum requires `->` before its output axes")
            return EinsumSequenceRejected()
          }
        }
      } else {
        einsum_parse_error(source, position, "einsum axes must be ASCII letters separated by `,` and `->`")
        return EinsumSequenceRejected()
      } } } }
    }
  }
  if axes.is_empty() and not allow_empty {
    einsum_parse_error(source, start, "einsum operand requires at least one axis")
    EinsumSequenceRejected()
  } else {
    EinsumSequenceParsed(axes, source.subspan(start, end).unwrap(), position, delimiter)
  }
}

fn einsum_parse(source: Span) -[Diagnose]> public_grammar.ParseResult<EinsumSyntax> {
  let mut position: usize = 0
  let mut operands: EinsumOperandsSyntax = Nil<EinsumOperandSyntax>()
  let mut reading_operands = true
  while reading_operands {
    match einsum_parse_sequence(source, position, false, false) {
      EinsumSequenceRejected -> return Rejected<EinsumSyntax>()
      EinsumSequenceParsed(axes, span, next, delimiter) -> {
        operands = operands.append(EinsumOperandSyntax { axes: axes, span: span })
        match delimiter {
          EinsumSequenceComma -> { position = next }
          EinsumSequenceArrow -> {
            position = next
            reading_operands = false
          }
          EinsumSequenceEnd -> {
            einsum_parse_error(source, next, "einsum requires an explicit `->` output")
            return Rejected<EinsumSyntax>()
          }
        }
      }
    }
  }
  match einsum_parse_sequence(source, position, true, true) {
    EinsumSequenceRejected -> Rejected<EinsumSyntax>()
    EinsumSequenceParsed(output, span, next, delimiter) -> Parsed(EinsumSyntax {
      operands: operands,
      output: output,
      span: source
    })
  }
}

impl public_grammar.Grammar for EinsumGrammar {
  type Syntax = EinsumSyntax

  fn parse(self, source: Span) -[Diagnose]> public_grammar.ParseResult<EinsumSyntax> {
    einsum_parse(source)
  }
}
