-- Host-aware checking from einsum syntax to sealed contraction plans.

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{Diagnose, DiagnosticClassType, DiagnosticSeverityError}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/grammar/einsum/plan.{*}
use stdlib/grammar/einsum/syntax.{*}
use stdlib/list as list
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/source.{Span}
use stdlib/tensor as tensor
use stdlib/tensor.{TensorDimensions, TensorShape}
use stdlib/typecheck.{TypeCheck, TypeName, ResolvedType, TypeQueryError}

--- An einsum checker configured with typed operand shapes in source order.
pub type EinsumChecker<I> {
  --- Operand descriptions supplied by the host expression boundary.
  operands: EinsumOperandSpecs<I>
}

--- Construct an einsum checker for one host identity domain and operand list.
pub fn checker<I>(operands: EinsumOperandSpecs<I>) -> EinsumChecker<I> {
  EinsumChecker<I> { operands: operands }
}

type EinsumAxesBind {
  EinsumAxesBound(EinsumPlanAxes, EinsumAxisBindings),
  EinsumAxesRejected
}

type EinsumOperandsBind<I> {
  EinsumOperandsBound(EinsumPlanOperands<I>, EinsumPlanAxes),
  EinsumOperandsRejected
}

fn einsum_check_error(span: Span, message: str) -[Diagnose]> nil {
  Diagnose.report(diagnostic.uncoded(DiagnosticSeverityError, DiagnosticClassType, message, span.location()))
  nil
}

fn einsum_type_name<I>(name: str) -> TypeName<I> {
  TypeName<I> { qualifier: None<str>(), name: name, arguments: Nil<I>() }
}

fn einsum_resolve_f64<I>(span: Span) -[TypeCheck<I>, Diagnose]> Option<ResolvedType<I>> {
  match TypeCheck<I>.resolve(einsum_type_name<I>("f64")) {
    Ok(element) -> Some(element)
    Err(_) -> {
      einsum_check_error(span, "einsum host does not expose the required `f64` element type")
      None<ResolvedType<I>>()
    }
  }
}

fn einsum_type_equivalent<I>(actual: ResolvedType<I>, expected: ResolvedType<I>, span: Span) -[TypeCheck<I>, Diagnose]> bool {
  match TypeCheck<I>.subtype(actual.identity, expected.identity) {
    Err(_) -> {
      einsum_check_error(span, "einsum operand element identity is not valid in this host scope")
      false
    }
    Ok(false) -> {
      einsum_check_error(span, "einsum reference execution currently requires `f64` operands")
      false
    }
    Ok(true) -> match TypeCheck<I>.subtype(expected.identity, actual.identity) {
      Ok(true) -> true
      Ok(false) -> {
        einsum_check_error(span, "einsum reference execution currently requires exactly `f64` operands")
        false
      }
      Err(_) -> {
        einsum_check_error(span, "einsum operand element identity is not valid in this host scope")
        false
      }
    }
  }
}

fn einsum_find_axis(axes: EinsumPlanAxes, name: str) -> Option<EinsumPlanAxis> {
  match axes {
    Nil -> None<EinsumPlanAxis>()
    Cons(axis, rest) -> if axis.name == name { Some(axis) }
      else { einsum_find_axis(rest, name) }
  }
}

fn einsum_bind_axes(source: EinsumAxes, dimensions: TensorDimensions, all: EinsumPlanAxes, bound: EinsumAxisBindings) -[Diagnose]> EinsumAxesBind {
  match (source, dimensions) {
    (Nil, Nil) -> EinsumAxesBound(all, bound)
    (Cons(axis, axis_rest), Cons(dimension, dimension_rest)) -> {
      let semantic = match einsum_find_axis(all, axis.name) {
        Some(existing) -> if existing.dimension == dimension { existing }
          else {
            einsum_check_error(axis.span, "einsum axis has inconsistent dimensions across operands")
            return EinsumAxesRejected()
          }
        None -> EinsumPlanAxis { position: all.len(), name: axis.name, dimension: dimension }
      }
      let next_all = match einsum_find_axis(all, axis.name) {
        Some(_) -> all
        None -> all.append(semantic)
      }
      einsum_bind_axes(
        axis_rest,
        dimension_rest,
        next_all,
        bound.append(EinsumAxisBinding { source: axis, axis: semantic })
      )
    }
    _ -> EinsumAxesRejected()
  }
}

fn einsum_bind_operands<I>(source: EinsumOperandsSyntax, specs: EinsumOperandSpecs<I>, expected: ResolvedType<I>, all: EinsumPlanAxes, bound: EinsumPlanOperands<I>, position: usize) -[TypeCheck<I>, Diagnose]> EinsumOperandsBind<I> {
  match (source, specs) {
    (Nil, Nil) -> EinsumOperandsBound<I>(bound, all)
    (Cons(syntax, syntax_rest), Cons(spec, spec_rest)) -> {
      if syntax.axes.len() != spec.shape.rank() {
        einsum_check_error(syntax.span, "einsum operand axis count must equal its tensor rank")
        EinsumOperandsRejected<I>()
      } else { if not einsum_type_equivalent<I>(spec.element, expected, syntax.span) {
        EinsumOperandsRejected<I>()
      } else { match einsum_bind_axes(syntax.axes, spec.shape.dimensions(), all, Nil<EinsumAxisBinding>()) {
        EinsumAxesRejected -> EinsumOperandsRejected<I>()
        EinsumAxesBound(next_all, axes) -> einsum_bind_operands<I>(
          syntax_rest,
          spec_rest,
          expected,
          next_all,
          bound.append(EinsumPlanOperand<I> {
            position: position,
            element: spec.element,
            shape: spec.shape,
            axes: axes
          }),
          position + 1
        )
      } } }
    }
    _ -> EinsumOperandsRejected<I>()
  }
}

fn einsum_bind_output(source: EinsumAxes, all: EinsumPlanAxes, bound: EinsumPlanAxes) -[Diagnose]> Option<EinsumPlanAxes> {
  match source {
    Nil -> Some(bound)
    Cons(axis, rest) -> match einsum_find_axis(bound, axis.name) {
      Some(_) -> {
        einsum_check_error(axis.span, "einsum output axis may appear only once")
        None<EinsumPlanAxes>()
      }
      None -> match einsum_find_axis(all, axis.name) {
        None -> {
          einsum_check_error(axis.span, "einsum output axis does not occur in any operand")
          None<EinsumPlanAxes>()
        }
        Some(semantic) -> einsum_bind_output(rest, all, bound.append(semantic))
      }
    }
  }
}

fn einsum_reduction_axes(all: EinsumPlanAxes, output: EinsumPlanAxes) -> EinsumPlanAxes {
  let mut reduction: EinsumPlanAxes = Nil<EinsumPlanAxis>()
  for axis in all {
    match einsum_find_axis(output, axis.name) {
      Some(_) -> nil
      None -> { reduction = reduction.append(axis); nil }
    }
  }
  reduction
}

fn einsum_dimensions(axes: EinsumPlanAxes) -> TensorDimensions {
  let mut dimensions: TensorDimensions = Nil<usize>()
  for axis in axes { dimensions = dimensions.append(axis.dimension) }
  dimensions
}

fn einsum_checked_shape(axes: EinsumPlanAxes, span: Span, role: str) -[Diagnose]> Option<TensorShape> {
  match tensor.shape(einsum_dimensions(axes)) {
    Ok(value) -> Some(value)
    Err(_) -> {
      einsum_check_error(span, role)
      None<TensorShape>()
    }
  }
}

fn einsum_check_plan<I>(syntax: EinsumSyntax, specs: EinsumOperandSpecs<I>) -[TypeCheck<I>, Diagnose]> CheckResult<EinsumPlan<I>> {
  if syntax.operands.len() != specs.len() {
    einsum_check_error(syntax.span, "einsum operand specification count does not match its equation")
    return CheckRejected<EinsumPlan<I>>()
  } else { if specs.is_empty() {
    einsum_check_error(syntax.span, "einsum requires at least one typed operand")
    return CheckRejected<EinsumPlan<I>>()
  } else { nil } }
  let expected = match einsum_resolve_f64<I>(syntax.span) {
    Some(value) -> value
    None -> return CheckRejected<EinsumPlan<I>>()
  }
  match einsum_bind_operands<I>(syntax.operands, specs, expected, Nil<EinsumPlanAxis>(), Nil<EinsumPlanOperand<I>>(), 0) {
    EinsumOperandsRejected -> CheckRejected<EinsumPlan<I>>()
    EinsumOperandsBound(operands, axes) -> match einsum_bind_output(syntax.output, axes, Nil<EinsumPlanAxis>()) {
      None -> CheckRejected<EinsumPlan<I>>()
      Some(output_axes) -> {
        let reduction_axes = einsum_reduction_axes(axes, output_axes)
        let output_shape = einsum_checked_shape(output_axes, syntax.span, "einsum output shape exceeds the representable element count")
        let reduction_shape = einsum_checked_shape(reduction_axes, syntax.span, "einsum reduction shape exceeds the representable element count")
        match (output_shape, reduction_shape) {
          (Some(output), Some(reduction)) -> Checked(checked_plan(EinsumPlanParts<I> {
            operands: operands,
            axes: axes,
            output_axes: output_axes,
            reduction_axes: reduction_axes,
            output_shape: output,
            reduction_shape: reduction,
            element: expected,
            reduction: EinsumExactSourceOrder
          }))
          _ -> CheckRejected<EinsumPlan<I>>()
        }
      }
    }
  }
}

impl<I> CheckedGrammar for EinsumChecker<I> {
  type Syntax = EinsumSyntax
  type Checked = EinsumPlan<I>
  type Identity = I

  fn check(self, syntax: EinsumSyntax) -[TypeCheck<I>, Diagnose]> CheckResult<EinsumPlan<I>> {
    einsum_check_plan<I>(syntax, self.operands)
  }
}
