-- Grammar-owned syntax for explicit einsum contractions.

use stdlib/list.{List}
use stdlib/source.{Span}

--- One einsum axis label together with its exact source byte range.
pub type EinsumAxis {
  --- The single ASCII letter naming this axis.
  name: str,
  --- Exact source range of the axis label.
  span: Span
}

--- Ordered axes in one operand or result specification.
pub type EinsumAxes = List<EinsumAxis>

--- One source operand's ordered axis specification.
pub type EinsumOperandSyntax {
  --- Axes from the operand's outermost dimension to its innermost dimension.
  axes: EinsumAxes,
  --- Exact source range covering this operand specification.
  span: Span
}

--- Source operands in evaluation order.
pub type EinsumOperandsSyntax = List<EinsumOperandSyntax>

--- A parsed explicit einsum equation such as `ij,jk->ik`.
pub type EinsumSyntax {
  --- Ordered source operand specifications.
  operands: EinsumOperandsSyntax,
  --- Ordered axes of the result; an empty sequence denotes a scalar.
  output: EinsumAxes,
  --- Complete retained source range supplied to the grammar.
  span: Span
}
