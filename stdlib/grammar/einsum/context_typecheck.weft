-- TypeCheck interpretation backed by a checked einsum context value.

use stdlib/grammar/einsum/context.{EinsumContext, EinsumContextElement, EinsumContextF64}
use stdlib/grammar/einsum/plan.{EinsumOperandSpec, EinsumOperandSpecs}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{SemanticTypePrimitive}
use stdlib/typecheck.{TypeCheck, TypeName, TypeField, ResolvedType, ResolvedField, TypeQueryError, TypeNotFound, TypeArgumentCount, TypeFieldNotFound, TypeFieldsUnavailable}

--- Scoped type identities issued by one checked einsum context.
pub type EinsumContextIdentity {
  --- The exact `f64` element identity.
  EinsumContextF64Identity
}

fn einsum_context_resolved(element: EinsumContextElement) -> ResolvedType<EinsumContextIdentity> {
  match element {
    EinsumContextF64 -> ResolvedType<EinsumContextIdentity> {
      identity: EinsumContextF64Identity,
      description: SemanticTypePrimitive("f64")
    }
  }
}

fn einsum_context_resolve(context: EinsumContext, request: TypeName<EinsumContextIdentity>) -> Result<ResolvedType<EinsumContextIdentity>, TypeQueryError> {
  match request.qualifier {
    Some(_) -> Err<ResolvedType<EinsumContextIdentity>, TypeQueryError>(TypeNotFound)
    None -> if not request.arguments.is_empty() {
      Err<ResolvedType<EinsumContextIdentity>, TypeQueryError>(TypeArgumentCount(0, request.arguments.len()))
    } else if request.name == "f64" {
      Ok<ResolvedType<EinsumContextIdentity>, TypeQueryError>(einsum_context_resolved(context.element))
    } else {
      Err<ResolvedType<EinsumContextIdentity>, TypeQueryError>(TypeNotFound)
    }
  }
}

--- Project checked operand specifications from a versioned context.
pub fn operand_specs(context: EinsumContext) -> EinsumOperandSpecs<EinsumContextIdentity> {
  let mut reversed = Nil<EinsumOperandSpec<EinsumContextIdentity>>()
  for shape in context.operands {
    reversed = Cons(EinsumOperandSpec<EinsumContextIdentity> {
      element: einsum_context_resolved(context.element),
      shape: shape
    }, reversed)
  }
  reversed.reverse()
}

--- Interpret host type queries from one checked einsum context value.
pub implements TypeCheck<EinsumContextIdentity>(context: EinsumContext) {
  TypeCheck<EinsumContextIdentity>.resolve(request) -> resume(einsum_context_resolve(context, request))
  TypeCheck<EinsumContextIdentity>.field(base, field) -> resume(Err<ResolvedType<EinsumContextIdentity>, TypeQueryError>(TypeFieldNotFound))
  TypeCheck<EinsumContextIdentity>.fields(base) -> resume(Err<List<ResolvedField<EinsumContextIdentity>>, TypeQueryError>(TypeFieldsUnavailable))
  TypeCheck<EinsumContextIdentity>.subtype(actual, expected) -> resume(Ok<bool, TypeQueryError>(true))
}
