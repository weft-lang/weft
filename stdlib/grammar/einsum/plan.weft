-- Checked contraction plans produced by the first-party einsum grammar.

use stdlib/grammar/einsum/syntax.{EinsumAxis}
use stdlib/list.{List}
use stdlib/tensor.{TensorShape}
use stdlib/typecheck.{ResolvedType}

--- One typed tensor operand supplied to the einsum checker.
pub type EinsumOperandSpec<I> {
  --- Host identity and semantic description of the tensor element type.
  element: ResolvedType<I>,
  --- Checked runtime shape of the operand.
  shape: TensorShape
}

--- Typed operand specifications in source order.
pub type EinsumOperandSpecs<I> = List<EinsumOperandSpec<I>>

--- Construct one checker operand from a resolved element type and tensor shape.
pub fn operand<I>(element: ResolvedType<I>, shape: TensorShape) -> EinsumOperandSpec<I> {
  EinsumOperandSpec<I> { element: element, shape: shape }
}

--- One dimension unified across every occurrence of an axis label.
pub type EinsumPlanAxis {
  --- Stable zero-based position in first-appearance order.
  position: usize,
  --- Axis name retained from its first source occurrence.
  name: str,
  --- Unified extent of this axis.
  dimension: usize
}

--- Ordered checked axes.
pub type EinsumPlanAxes = List<EinsumPlanAxis>

--- One source occurrence bound to its unified checked axis.
pub type EinsumAxisBinding {
  --- Source axis occurrence used for diagnostics and tooling.
  source: EinsumAxis,
  --- Unified semantic axis used by execution and lowering.
  axis: EinsumPlanAxis
}

--- Checked axis bindings in tensor dimension order.
pub type EinsumAxisBindings = List<EinsumAxisBinding>

--- One checked tensor operand in source evaluation order.
pub type EinsumPlanOperand<I> {
  --- Stable zero-based operand position.
  position: usize,
  --- Checked host element type.
  element: ResolvedType<I>,
  --- Exact checked tensor shape.
  shape: TensorShape,
  --- Tensor dimensions bound to unified semantic axes.
  axes: EinsumAxisBindings
}

--- Checked tensor operands in source order.
pub type EinsumPlanOperands<I> = List<EinsumPlanOperand<I>>

--- Floating-point reduction behavior promised by an einsum interpretation.
pub type EinsumReductionSemantics {
  --- Observe reduction coordinates lexicographically in checked axis order.
  EinsumExactSourceOrder
}

pub(package) type EinsumPlanParts<I> {
  operands: EinsumPlanOperands<I>,
  axes: EinsumPlanAxes,
  output_axes: EinsumPlanAxes,
  reduction_axes: EinsumPlanAxes,
  output_shape: TensorShape,
  reduction_shape: TensorShape,
  element: ResolvedType<I>,
  reduction: EinsumReductionSemantics
}

--- A checked contraction plan ready for deterministic execution or lowering.
--- Construction is sealed so every axis is bound, every dimension agrees and
--- every operand has the checked element type.
pub type EinsumPlan<I> = opaque EinsumPlanParts<I>

pub(package) fn checked_plan<I>(parts: EinsumPlanParts<I>) -> EinsumPlan<I> {
  EinsumPlan<I>(parts)
}

impl<I> EinsumPlan<I> {
  --- Return checked operands in source evaluation order.
  pub fn operands(self) -> EinsumPlanOperands<I> {
    match self { EinsumPlan(parts) -> parts.operands }
  }

  --- Return all unified axes in first-appearance order.
  pub fn axes(self) -> EinsumPlanAxes {
    match self { EinsumPlan(parts) -> parts.axes }
  }

  --- Return result axes in the explicit output order.
  pub fn output_axes(self) -> EinsumPlanAxes {
    match self { EinsumPlan(parts) -> parts.output_axes }
  }

  --- Return contracted axes in deterministic reduction order.
  pub fn reduction_axes(self) -> EinsumPlanAxes {
    match self { EinsumPlan(parts) -> parts.reduction_axes }
  }

  --- Return the checked result tensor shape.
  pub fn output_shape(self) -> TensorShape {
    match self { EinsumPlan(parts) -> parts.output_shape }
  }

  --- Return the checked reduction-coordinate shape.
  pub fn reduction_shape(self) -> TensorShape {
    match self { EinsumPlan(parts) -> parts.reduction_shape }
  }

  --- Return the checked host element type shared by all operands and output.
  pub fn element(self) -> ResolvedType<I> {
    match self { EinsumPlan(parts) -> parts.element }
  }

  --- Return the floating-point reduction behavior required by this plan.
  pub fn reduction_semantics(self) -> EinsumReductionSemantics {
    match self { EinsumPlan(parts) -> parts.reduction }
  }
}
