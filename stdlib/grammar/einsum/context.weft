-- Versioned einsum operand contexts loaded through bounded FileRead authority.

use stdlib/file as file
use stdlib/file.{FileRead}
use stdlib/io/types.{IoTextError}
use stdlib/json as json
use stdlib/json.{Json, JsonEntry, JsonArray, JsonNumber, JsonObject, JsonString, JsonParseError}
use stdlib/list.{List, Cons, Nil}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/tensor as tensor
use stdlib/tensor.{TensorShape, TensorShapeError}

--- The checked element domain described by an einsum build context.
---
--- Exact-source-order reference execution currently supports `f64`. Keeping
--- that choice typed makes widening the domain an explicit semantic change.
pub type EinsumContextElement {
  --- IEEE-754 binary64 tensor elements.
  EinsumContextF64
}

--- Operand shapes in equation source order.
pub type EinsumOperandShapes = List<TensorShape>

--- A checked version-one context for one einsum equation.
pub type EinsumContext {
  --- The exact element domain shared by every operand and the result.
  element: EinsumContextElement,
  --- Checked operand shapes in equation source order.
  operands: EinsumOperandShapes
}

--- Why einsum context acquisition or validation failed.
pub type EinsumContextError {
  --- Bounded file acquisition or UTF-8 validation failed.
  EinsumContextReadFailed(IoTextError),
  --- The file was UTF-8 but not a complete JSON document.
  EinsumContextJsonInvalid(JsonParseError),
  --- The document root must be an object.
  EinsumContextRootObjectRequired,
  --- A required root member is missing or repeated.
  EinsumContextRootMemberRequired(str),
  --- The only accepted context version is one.
  EinsumContextVersionUnsupported,
  --- The element member must be the string `f64`.
  EinsumContextElementUnsupported,
  --- The operands member must be an array.
  EinsumContextOperandsArrayRequired,
  --- At least one operand shape is required.
  EinsumContextOperandsEmpty,
  --- The indexed operand shape must be an array of dimensions.
  EinsumContextShapeArrayRequired(usize),
  --- The indexed dimension must be a non-negative integer representable by `usize`.
  EinsumContextDimensionInvalid(usize, usize),
  --- The indexed operand shape exceeds the representable element count.
  EinsumContextShapeInvalid(usize, TensorShapeError)
}

fn einsum_context_entry_count(entries: List<JsonEntry>, wanted: str) -> usize {
  match entries {
    Nil -> {
      let zero: usize = 0
      zero
    }
    Cons(entry, rest) -> {
      let here: usize = if entry.key() == wanted { 1 } else { 0 }
      here + einsum_context_entry_count(rest, wanted)
    }
  }
}

fn einsum_context_entry(entries: List<JsonEntry>, wanted: str) -> Json {
  match entries {
    Nil -> JsonObject(Nil<JsonEntry>())
    Cons(entry, rest) -> if entry.key() == wanted { entry.value() }
      else { einsum_context_entry(rest, wanted) }
  }
}

fn einsum_context_dimensions(items: List<Json>, operand: usize, dimension: usize) -> Result<List<usize>, EinsumContextError> {
  match items {
    Nil -> Ok<List<usize>, EinsumContextError>(Nil<usize>())
    Cons(item, rest) -> match item {
      JsonNumber(value) -> match value.to_usize_checked() {
        Err(_) -> Err<List<usize>, EinsumContextError>(EinsumContextDimensionInvalid(operand, dimension))
        Ok(checked) -> match einsum_context_dimensions(rest, operand, dimension + 1) {
          Err(error) -> Err<List<usize>, EinsumContextError>(error)
          Ok(dimensions) -> Ok<List<usize>, EinsumContextError>(Cons(checked, dimensions))
        }
      }
      _ -> Err<List<usize>, EinsumContextError>(EinsumContextDimensionInvalid(operand, dimension))
    }
  }
}

fn einsum_context_shape(value: Json, position: usize) -> Result<TensorShape, EinsumContextError> {
  match value {
    JsonArray(items) -> match einsum_context_dimensions(items, position, 0) {
      Err(error) -> Err<TensorShape, EinsumContextError>(error)
      Ok(dimensions) -> match tensor.shape(dimensions) {
        Err(error) -> Err<TensorShape, EinsumContextError>(EinsumContextShapeInvalid(position, error))
        Ok(shape) -> Ok<TensorShape, EinsumContextError>(shape)
      }
    }
    _ -> Err<TensorShape, EinsumContextError>(EinsumContextShapeArrayRequired(position))
  }
}

fn einsum_context_shapes(items: List<Json>, position: usize) -> Result<EinsumOperandShapes, EinsumContextError> {
  match items {
    Nil -> Ok<EinsumOperandShapes, EinsumContextError>(Nil<TensorShape>())
    Cons(item, rest) -> match einsum_context_shape(item, position) {
      Err(error) -> Err<EinsumOperandShapes, EinsumContextError>(error)
      Ok(shape) -> match einsum_context_shapes(rest, position + 1) {
        Err(error) -> Err<EinsumOperandShapes, EinsumContextError>(error)
        Ok(shapes) -> Ok<EinsumOperandShapes, EinsumContextError>(Cons(shape, shapes))
      }
    }
  }
}

--- Validate one complete version-one JSON einsum context.
---
--- The document shape is
--- `{"context_version":1,"element":"f64","operands":[[2,3],[3,4]]}`.
pub fn parse(source: str) -> Result<EinsumContext, EinsumContextError> {
  match json.parse(source) {
    Err(error) -> Err<EinsumContext, EinsumContextError>(EinsumContextJsonInvalid(error))
    Ok(document) -> match document {
      JsonObject(root) -> {
        if einsum_context_entry_count(root, "context_version") != 1 {
          Err<EinsumContext, EinsumContextError>(EinsumContextRootMemberRequired("context_version"))
        } else if einsum_context_entry_count(root, "element") != 1 {
          Err<EinsumContext, EinsumContextError>(EinsumContextRootMemberRequired("element"))
        } else if einsum_context_entry_count(root, "operands") != 1 {
          Err<EinsumContext, EinsumContextError>(EinsumContextRootMemberRequired("operands"))
        } else { match einsum_context_entry(root, "context_version") {
          JsonNumber(1) -> match einsum_context_entry(root, "element") {
            JsonString(name) if name == "f64" -> match einsum_context_entry(root, "operands") {
              JsonArray(items) -> match items {
                Nil -> Err<EinsumContext, EinsumContextError>(EinsumContextOperandsEmpty)
                _ -> match einsum_context_shapes(items, 0) {
                  Err(error) -> Err<EinsumContext, EinsumContextError>(error)
                  Ok(operands) -> Ok<EinsumContext, EinsumContextError>(EinsumContext {
                    element: EinsumContextF64,
                    operands: operands
                  })
                }
              }
              _ -> Err<EinsumContext, EinsumContextError>(EinsumContextOperandsArrayRequired)
            }
            _ -> Err<EinsumContext, EinsumContextError>(EinsumContextElementUnsupported)
          }
          _ -> Err<EinsumContext, EinsumContextError>(EinsumContextVersionUnsupported)
        } }
      }
      _ -> Err<EinsumContext, EinsumContextError>(EinsumContextRootObjectRequired)
    }
  }
}

--- Read, UTF-8 validate, and parse one bounded version-one context file.
pub fn load(path: Path, limit: usize) -[FileRead]> Result<EinsumContext, EinsumContextError> {
  match file.read_text(path, limit) {
    Err(error) -> Err<EinsumContext, EinsumContextError>(EinsumContextReadFailed(error))
    Ok(source) -> parse(source)
  }
}
