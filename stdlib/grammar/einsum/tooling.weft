-- Tool-driven checking for the einsum grammar.
--
-- This module carries the `GrammarTooling` conformance of `EinsumGrammar`, so
-- a parse-only consumer of the grammar never compiles the checker or context
-- code. The SDK manifest names it as the export's tooling module.

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{
  Diagnose,
  DiagnosticClassGrammar,
  DiagnosticLocationNone,
  DiagnosticSeverityError
}
use stdlib/file.{FileRead}
use stdlib/grammar.{CheckedGrammar, Checked, CheckRejected}
use stdlib/grammar/einsum.{EinsumGrammar}
use stdlib/grammar/einsum/check as einsum_check
use stdlib/grammar/einsum/context as einsum_context
use stdlib/grammar/einsum/context.{
  EinsumContextError,
  EinsumContextReadFailed,
  EinsumContextJsonInvalid,
  EinsumContextRootObjectRequired,
  EinsumContextRootMemberRequired,
  EinsumContextVersionUnsupported,
  EinsumContextElementUnsupported
}
use stdlib/grammar/einsum/context_typecheck as context_typecheck
use stdlib/grammar/einsum/context_typecheck.{EinsumContextIdentity}
use stdlib/grammar/einsum/syntax.{EinsumSyntax}
use stdlib/grammar/tooling.{*}
use stdlib/list as list
use stdlib/list.{List}
use stdlib/path.{Path}
use stdlib/result.{Ok, Err}
use stdlib/string.{str_concat}
use stdlib/typecheck.{TypeCheck}

fn context_failure_message(error: EinsumContextError) -> str {
  match error {
    EinsumContextReadFailed(_) -> "einsum context file could not be read within its limit"
    EinsumContextJsonInvalid(_) -> "einsum context file is not a complete JSON document"
    EinsumContextRootObjectRequired -> "einsum context root must be an object"
    EinsumContextRootMemberRequired(member) ->
      str_concat("einsum context root member is missing or repeated: ", member)
    EinsumContextVersionUnsupported -> "einsum context version is not supported"
    EinsumContextElementUnsupported -> "einsum context element type is not supported"
    _ -> "einsum context content was rejected"
  }
}

fn report_context_failure(error: EinsumContextError) -[Diagnose]> nil {
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      context_failure_message(error),
      DiagnosticLocationNone
    )
  )
  nil
}

--- Einsum operand shapes come only from a context file this package
--- interprets itself; host-type checking is declared unsupported and refused
--- before any query is made.
impl GrammarTooling for EinsumGrammar {
  type Syntax = EinsumSyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarFileContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: EinsumSyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    unsupported_report(GrammarHostTypesContext)
  }

  fn check_with_context(
    self,
    syntax: EinsumSyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    match einsum_context.load(context, limit) {
      Err(error) -> {
        report_context_failure(error)
        context_unavailable_report()
      }
      Ok(loaded) -> with context_typecheck(loaded) {
        let checker = einsum_check.checker<EinsumContextIdentity>(
          context_typecheck.operand_specs(loaded)
        )
        match checker.check(syntax) {
          Checked(_) -> checked_report()
          CheckRejected -> rejected_report()
        }
      }
    }
  }
}
