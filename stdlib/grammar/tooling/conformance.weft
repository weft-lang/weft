-- Shared conformance for tool-driven grammars.
--
-- Tests and tool drivers use these entry points so one contract governs
-- both: parse outcomes carry no syntax payload, declared context support is
-- enforced before a grammar is called, and every check answers with a
-- structured outcome.

use stdlib/bytes.{Bytes}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/file.{FileRead}
use stdlib/io/types.{IoError, IoPermissionDenied}
use stdlib/grammar.{Grammar, Parsed, Recovered, Rejected}
use stdlib/grammar/tooling.{*}
use stdlib/grammar/tooling/staging.{*}
use stdlib/json.{Json}
use stdlib/option.{Some, None}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/source.{Span}
use stdlib/typecheck.{TypeCheck}

--- A parse outcome without the grammar's syntax value.
pub type ParseOutcome {
  ParseOutcomeParsed,
  ParseOutcomeRecovered,
  ParseOutcomeRejected
}

--- Parse with the `Grammar` contract and keep only the outcome.
pub fn parse_outcome<G: Grammar>(grammar: G, source: Span) -[Diagnose]> ParseOutcome {
  match grammar.parse(source) {
    Parsed(_) -> ParseOutcomeParsed
    Recovered(_) -> ParseOutcomeRecovered
    Rejected -> ParseOutcomeRejected
  }
}

--- Check against host types only when the grammar declares that context;
--- otherwise refuse without calling the grammar.
pub fn host_check<G: GrammarTooling>(
  grammar: G,
  syntax: G.Syntax
) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckOutcome {
  if supports_context(grammar.contexts(), GrammarHostTypesContext) {
    grammar.check_with_host(syntax).outcome
  } else { GrammarCheckUnsupported(GrammarHostTypesContext) }
}

-- Forward a read only when it stays within the requested context file and
-- limit; anything else is denied without reaching the outer capability.
fn confined_read(
  requested: Path,
  requested_limit: usize,
  context: Path,
  limit: usize
) -[FileRead]> Result<Bytes, IoError> {
  if requested.eq(context) and requested_limit <= limit {
    FileRead.read_all(requested, requested_limit)
  } else { Err<Bytes, IoError>(IoPermissionDenied) }
}

--- Check against a bounded context file only when the grammar declares that
--- context; otherwise refuse without reading anything. The grammar's reads
--- are confined to the requested file and limit: any other read is denied
--- without reaching the outer file capability.
pub fn context_check<G: GrammarTooling>(
  grammar: G,
  syntax: G.Syntax,
  context: Path,
  limit: usize
) -[FileRead, Diagnose]> GrammarCheckOutcome {
  if supports_context(grammar.contexts(), GrammarFileContext) {
    let report = handle grammar.check_with_context(syntax, context, limit) {
      FileRead.read_all(requested, requested_limit) ->
        resume(confined_read(requested, requested_limit, context, limit))
    }
    report.outcome
  } else { GrammarCheckUnsupported(GrammarFileContext) }
}

--- Everything a stage answers once its syntax has been accepted.
pub type StageResult {
  --- The package emitted its plan: the bytes are in the sink and the value
  --- is the package's facts envelope.
  StageEmitted(Json),
  --- A `validate_only` site: the syntax checked and nothing was emitted.
  StagedNothing,
  --- The package withheld a plan; the reason has been reported.
  StageRefused(StagingRefusal),
  --- The package does not emit for the requested capability.
  StageRefusedNoStaging,
  --- The package cannot encode for the target's platform.
  StageUnsupportedTarget(str),
  --- The sink refused a chunk; whatever it holds must be discarded.
  StageSinkRefused(IoError)
}

fn persist_confined<G: GrammarStaging>(
  grammar: G,
  syntax: G.Syntax,
  context: StagingContext
) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<G.Persistent, StagingRefusal> {
  match context {
    StagingHostTypes -> handle grammar.persist(syntax, context) {
      FileRead.read_all(requested, requested_limit) ->
        resume(Err<Bytes, IoError>(IoPermissionDenied))
    }
    StagingFileContext(file, limit) -> handle grammar.persist(syntax, context) {
      FileRead.read_all(requested, requested_limit) ->
        resume(confined_read(requested, requested_limit, file, limit))
    }
  }
}

--- Stage accepted syntax for a target: check and persist under the context,
--- then emit unless the site is `validate_only`, which is checked and never
--- emits. A capability the package does not declare is refused before the
--- grammar is called. Reads are confined to the context file exactly as
--- `context_check` confines them; under host types every read is denied.
pub fn stage<G: GrammarStaging>(
  grammar: G,
  syntax: G.Syntax,
  context: StagingContext,
  target: StagingTarget
) -[TypeCheck<ToolTypeIdentity>, FileRead, StagingSink, Diagnose]> StageResult {
  let permitted = match target.capability {
    StagingValidateOnly -> true
    StagingTypedPlan -> match support_for(grammar.stagings(), StagingTypedPlan) {
      Some(_) -> true
      None -> false
    }
  }
  if not permitted { StageRefusedNoStaging } else {
    match persist_confined(grammar, syntax, context) {
      Err(refusal) -> StageRefused(refusal)
      Ok(plan) -> match target.capability {
        StagingValidateOnly -> StagedNothing
        StagingTypedPlan -> {
          let report = grammar.emit(plan, target)
          match report.outcome {
            StagingEmitted -> StageEmitted(report.facts)
            StagingUnsupportedTarget -> StageUnsupportedTarget(target.platform)
            StagingSinkRefused(error) -> StageSinkRefused(error)
          }
        }
      }
    }
  }
}
