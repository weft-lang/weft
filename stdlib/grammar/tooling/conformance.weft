-- Shared conformance for tool-driven grammars.
--
-- Tests and tool drivers use these entry points so one contract governs
-- both: parse outcomes carry no syntax payload, declared context support is
-- enforced before a grammar is called, and every check answers with a
-- structured outcome.

use stdlib/diagnostic/schema.{Diagnose}
use stdlib/file.{FileRead}
use stdlib/grammar.{Grammar, Parsed, Recovered, Rejected}
use stdlib/grammar/tooling.{*}
use stdlib/path.{Path}
use stdlib/source.{Span}
use stdlib/typecheck.{TypeCheck}

--- A parse outcome without the grammar's syntax value.
pub type ParseOutcome {
  ParseOutcomeParsed,
  ParseOutcomeRecovered,
  ParseOutcomeRejected
}

--- Parse with the `Grammar` contract and keep only the outcome.
pub fn parse_outcome<G: Grammar>(grammar: G, source: Span) -[Diagnose]> ParseOutcome {
  match grammar.parse(source) {
    Parsed(_) -> ParseOutcomeParsed
    Recovered(_) -> ParseOutcomeRecovered
    Rejected -> ParseOutcomeRejected
  }
}

--- Check against host types only when the grammar declares that context;
--- otherwise refuse without calling the grammar.
pub fn host_check<G: GrammarTooling>(
  grammar: G,
  syntax: G.Syntax
) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckOutcome {
  if supports_context(grammar.contexts(), GrammarHostTypesContext) {
    grammar.check_with_host(syntax).outcome
  } else { GrammarCheckUnsupported(GrammarHostTypesContext) }
}

--- Check against a bounded context file only when the grammar declares that
--- context; otherwise refuse without reading anything.
pub fn context_check<G: GrammarTooling>(
  grammar: G,
  syntax: G.Syntax,
  context: Path,
  limit: usize
) -[FileRead, Diagnose]> GrammarCheckOutcome {
  if supports_context(grammar.contexts(), GrammarFileContext) {
    grammar.check_with_context(syntax, context, limit).outcome
  } else { GrammarCheckUnsupported(GrammarFileContext) }
}
