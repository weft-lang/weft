-- stdlib/grammar/tooling/digest.weft — content digests in artifact-facts form
--
-- One spelling of a content digest serves the tool protocol's observed
-- inputs, a staging sink's report and the compiler's verification of a
-- staged artifact, so the three can never disagree on its form.

use runtime/sha256.{sha256_digest_of_storage}
use runtime/string.{runtime_str_from_utf8_vector}
use stdlib/bytes.{Bytes, bytes_storage}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/vector as vector

--- The digest of exact content, in the artifact-facts form `sha256:<hex>`.
pub fn content_digest(content: Bytes) -> str {
  let digest = sha256_digest_of_storage(bytes_storage(content))
  let prefix = "sha256:"
  let mut text = vector.with_capacity<u8>(71)
  let first: usize = 0
  for index in first..prefix.len() { text.push(prefix.byte_at(index).unwrap_or(0)) }
  for index in first..digest.len() {
    let byte = digest.get(index).unwrap_or(0)
    text.push(hex_digit(byte / 16))
    text.push(hex_digit(byte % 16))
  }
  match runtime_str_from_utf8_vector(text) {
    nil -> panic("A content digest is ASCII")
    rendered: str -> rendered
  }
}

fn hex_digit(value: u8) -> u8 { if value < 10 { 48 + value } else { 87 + value } }
