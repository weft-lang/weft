-- stdlib/grammar/tooling/digest.weft — content digests in artifact-facts form
--
-- One spelling of a content digest serves the tool protocol's observed
-- inputs, a staging sink's report and the compiler's verification of a
-- staged artifact, so the three can never disagree on its form.

use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_load8_at, mem_store8_at}
use runtime/sha256.{sha256}
use runtime/string.{runtime_str_byte_at, runtime_str_from_bytes_copy}
use stdlib/bytes.{Bytes}
use stdlib/vector.{vector_data, vector_len}

--- The digest of exact content, in the artifact-facts form `sha256:<hex>`.
pub fn content_digest(content: Bytes) -> str {
  let values = content.to_vector()
  let raw = alloc_zeroed(32)
  sha256(vector_data<u8>(values), vector_len<u8>(values), raw)
  let text = alloc_zeroed(71)
  let prefix = "sha256:"
  for index in 0..7 { mem_store8_at(text, index, prefix_byte(prefix, index)) }
  for index in 0..32 {
    let byte = mem_load8_at(raw, index)
    mem_store8_at(text, 7 + index * 2, hex_digit(byte / 16))
    mem_store8_at(text, 8 + index * 2, hex_digit(byte - byte / 16 * 16))
  }
  runtime_str_from_bytes_copy(text, 71)
}

fn prefix_byte(prefix: str, index: i64) -> i64 { runtime_str_byte_at(prefix, index) }

fn hex_digit(value: i64) -> i64 { if value < 10 { 48 + value } else { 87 + value } }
