-- A deterministic host for tool-driven grammar checks.
--
-- A catalog of named types described as semantic facts stands in for a
-- compiler's checked module, so grammar tooling conformance can be exercised
-- without a compiler and a tool driver can be tested against known answers.
-- Identities are catalog positions; any other token is a foreign identity.

use stdlib/grammar/tooling.{ToolTypeIdentity, tool_type_identity, tool_type_identity_token}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/typecheck.{*}

--- One host type the fixture knows by name.
pub type HostCatalogEntry { name: str, description: SemanticTypeFact }

--- The complete host vocabulary answered by the fixture.
pub type HostCatalog = List<HostCatalogEntry>

--- A primitive type entry described by its spelling.
pub fn catalog_primitive(name: str) -> HostCatalogEntry {
  HostCatalogEntry { name: name, description: SemanticTypePrimitive(name) }
}

--- The primitive vocabulary a catalog needs for record field types.
pub fn primitive_catalog() -> HostCatalog {
  Cons(
    catalog_primitive("i64"),
    Cons(
      catalog_primitive("str"),
      Cons(catalog_primitive("bool"), Cons(catalog_primitive("f64"), Nil<HostCatalogEntry>()))
    )
  )
}

fn record_fields_from(fields: List<(str, str)>, position: i64) -> SemanticRecordFieldFactList {
  match fields {
    Nil -> SemanticRecordFieldFactListNil
    Cons(field, rest) -> SemanticRecordFieldFactListCons(
      SemanticRecordField(field.0, position, SemanticTypePrimitive(field.1)),
      record_fields_from(rest, position + 1)
    )
  }
}

--- A closed record type entry whose fields have primitive types.
pub fn catalog_record(name: str, fields: List<(str, str)>) -> HostCatalogEntry {
  HostCatalogEntry {
    name: name,
    description: SemanticTypeRecord(record_fields_from(fields, 0), false, false)
  }
}

--- Append one entry to a catalog.
pub fn catalog_with(catalog: HostCatalog, entry: HostCatalogEntry) -> HostCatalog {
  catalog.append(entry)
}

fn find_index(catalog: HostCatalog, name: str, index: i64) -> Option<i64> {
  match catalog {
    Nil -> None<i64>()
    Cons(entry, rest) -> if entry.name == name { Some<i64>(index) } else {
      find_index(rest, name, index + 1)
    }
  }
}

fn entry_at(catalog: HostCatalog, index: i64) -> Option<HostCatalogEntry> {
  match catalog {
    Nil -> None<HostCatalogEntry>()
    Cons(entry, rest) -> if index == 0 { Some<HostCatalogEntry>(entry) } else {
      if index < 0 { None<HostCatalogEntry>() } else { entry_at(rest, index - 1) }
    }
  }
}

fn resolved_entry(entry: HostCatalogEntry, index: i64) -> ResolvedType<ToolTypeIdentity> {
  ResolvedType { identity: tool_type_identity(index + 1), description: entry.description }
}

fn resolve_name(
  catalog: HostCatalog,
  name: str
) -> Result<ResolvedType<ToolTypeIdentity>, TypeQueryError> {
  match find_index(catalog, name, 0) {
    None -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeNotFound)
    Some(index) -> match entry_at(catalog, index) {
      Some(entry) -> Ok<ResolvedType<ToolTypeIdentity>, TypeQueryError>(
        resolved_entry(entry, index)
      )
      None -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeNotFound)
    }
  }
}

fn catalog_resolve(
  catalog: HostCatalog,
  request: TypeName<ToolTypeIdentity>
) -> Result<ResolvedType<ToolTypeIdentity>, TypeQueryError> {
  match request.qualifier {
    Some(_) -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeNotFound)
    None -> if not request.arguments.is_empty() {
      Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(
        TypeArgumentCount(0, request.arguments.len())
      )
    } else { resolve_name(catalog, request.name) }
  }
}

fn identity_entry(
  catalog: HostCatalog,
  identity: ToolTypeIdentity
) -> Result<HostCatalogEntry, TypeQueryError> {
  match entry_at(catalog, tool_type_identity_token(identity) - 1) {
    Some(entry) -> Ok<HostCatalogEntry, TypeQueryError>(entry)
    None -> Err<HostCatalogEntry, TypeQueryError>(ForeignTypeIdentity)
  }
}

fn field_type(
  catalog: HostCatalog,
  fact: SemanticTypeFact
) -> Result<ResolvedType<ToolTypeIdentity>, TypeQueryError> {
  match fact {
    SemanticTypePrimitive(name) -> resolve_name(catalog, name)
    SemanticTypeNamed(name, _) -> resolve_name(catalog, name)
    _ -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeNotFound)
  }
}

fn find_field(fields: SemanticRecordFieldFactList, name: str) -> Option<SemanticTypeFact> {
  match fields {
    SemanticRecordFieldFactListCons(SemanticRecordField(field_name, _, value), rest) ->
      if field_name == name { Some<SemanticTypeFact>(value) } else { find_field(rest, name) }
    SemanticRecordFieldFactListCons(_, rest) -> find_field(rest, name)
    _ -> None<SemanticTypeFact>()
  }
}

fn catalog_field(
  catalog: HostCatalog,
  base: ToolTypeIdentity,
  selector: TypeField
) -> Result<ResolvedType<ToolTypeIdentity>, TypeQueryError> {
  match identity_entry(catalog, base) {
    Err(error) -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(error)
    Ok(entry) -> match entry.description {
      SemanticTypeRecord(fields, _, _) -> match selector {
        NamedTypeField(name) -> match find_field(fields, name) {
          Some(fact) -> field_type(catalog, fact)
          None -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeFieldNotFound)
        }
        PositionalTypeField(_) -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(
          TypeFieldNotFound
        )
      }
      _ -> Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeFieldsUnavailable)
    }
  }
}

fn resolved_fields(
  catalog: HostCatalog,
  fields: SemanticRecordFieldFactList
) -> Result<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError> {
  match fields {
    SemanticRecordFieldFactListNil -> Ok<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(
      Nil<ResolvedField<ToolTypeIdentity>>()
    )
    SemanticRecordFieldFactListCons(SemanticRecordField(name, _, value), rest) ->
      match field_type(catalog, value) {
        Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(error)
        Ok(resolved) -> match resolved_fields(catalog, rest) {
          Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(error)
          Ok(others) -> Ok<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(
            Cons(ResolvedField { selector: NamedTypeField(name), value: resolved }, others)
          )
        }
      }
    _ -> Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(TypeFieldsUnavailable)
  }
}

fn catalog_fields(
  catalog: HostCatalog,
  base: ToolTypeIdentity
) -> Result<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError> {
  match identity_entry(catalog, base) {
    Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(error)
    Ok(entry) -> match entry.description {
      SemanticTypeRecord(fields, _, _) -> resolved_fields(catalog, fields)
      _ -> Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(TypeFieldsUnavailable)
    }
  }
}

fn catalog_subtype(
  catalog: HostCatalog,
  actual: ToolTypeIdentity,
  expected: ToolTypeIdentity
) -> Result<bool, TypeQueryError> {
  match identity_entry(catalog, actual) {
    Err(error) -> Err<bool, TypeQueryError>(error)
    Ok(_) -> match identity_entry(catalog, expected) {
      Err(error) -> Err<bool, TypeQueryError>(error)
      Ok(_) -> Ok<bool, TypeQueryError>(
        tool_type_identity_token(actual) == tool_type_identity_token(expected)
      )
    }
  }
}

--- Answer host type queries from one fixed catalog.
pub implements TypeCheck<ToolTypeIdentity>(catalog: HostCatalog) {
  TypeCheck<ToolTypeIdentity>.resolve(request) -> resume(catalog_resolve(catalog, request))
  TypeCheck<ToolTypeIdentity>.field(base, selector) -> resume(
    catalog_field(catalog, base, selector)
  )
  TypeCheck<ToolTypeIdentity>.fields(base) -> resume(catalog_fields(catalog, base))
  TypeCheck<ToolTypeIdentity>.subtype(actual, expected) -> resume(
    catalog_subtype(catalog, actual, expected)
  )
}
