-- stdlib/grammar/tooling/protocol.weft — the weft-grammar-tool/1 wire contract
--
-- One JSON document per line, exchanged between a compiler and a grammar
-- driver product over an interactive child session. The runtime moves
-- bytes; every shape, version and validation rule lives here, so a
-- protocol revision never touches the process layer. Framing is exact:
-- unknown kinds, missing members and the wrong protocol name are structured
-- errors, never silent defaults.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/diagnostic/json as diagnostic_json
use stdlib/diagnostic/schema.{Diagnostic}
use stdlib/grammar/tooling.{*}
use stdlib/grammar/tooling/conformance.{
  ParseOutcome,
  ParseOutcomeParsed,
  ParseOutcomeRecovered,
  ParseOutcomeRejected
}
use stdlib/grammar/tooling/staging.{StagingCapability, StagingTypedPlan, StagingValidateOnly}
use stdlib/json as json
use stdlib/json.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{SemanticTypeFact}
use stdlib/semantic_type/json as types
use stdlib/string.{str_concat}
use stdlib/typecheck.{*}
use stdlib/vector as vector
use stdlib/vector.{
  Vector,
  vector_clear,
  vector_get_in_bounds,
  vector_len,
  vector_push,
  vector_set
}

--- The protocol name and version carried by every request and response.
pub fn protocol_name() -> str { "weft-grammar-tool/1" }

--- The largest protocol line either peer accepts, in bytes. A request carries
--- one source text and a response one diagnostic list; a longer line is a
--- protocol violation, not a large document, and the peer stops reading
--- before it stores the excess.
pub fn frame_limit() -> usize { __i64_to_usize(16777216) }

-- Framing ------------------------------------------------------------------
--- Bytes of protocol frames as they arrive. Chunks accumulate in one mutable
--- buffer and are scanned once for the newline that ends a frame; a line is
--- materialised only when it is complete, so framing stays linear in the
--- input however it is chunked. `scanned` is a one-slot vector holding the
--- offset up to which no newline was found.
pub type FrameBuffer { values: Vector<u8>, scanned: Vector<i64> }

pub fn frame_buffer() -> FrameBuffer {
  let scanned = vector.with_capacity<i64>(__i64_to_usize(1))
  vector_push<i64>(scanned, 0)
  FrameBuffer { values: vector.new<u8>(), scanned: scanned }
}

fn frame_scanned(buffer: FrameBuffer) -> i64 {
  let scanned = buffer.scanned
  vector_get_in_bounds<i64>(scanned, 0)
}

fn frame_set_scanned(buffer: FrameBuffer, offset: i64) -> nil {
  let scanned = buffer.scanned
  vector_set<i64>(scanned, 0, offset)
  nil
}

--- Bytes currently buffered.
pub fn frame_buffer_len(buffer: FrameBuffer) -> usize {
  let values = buffer.values
  __i64_to_usize(vector_len<u8>(values))
}

fn bytes_of_range(values: Vector<u8>, start: i64, end: i64) -> Bytes {
  bytes.from_vector_range(values, __i64_to_usize(start), __i64_to_usize(end)).unwrap_or(
    bytes.empty()
  )
}

--- Drop the bytes before `start`, keeping the rest at the front.
fn frame_drop_prefix(buffer: FrameBuffer, start: i64) -> nil {
  let values = buffer.values
  let rest = bytes_of_range(values, start, vector_len<u8>(values))
  vector_clear<u8>(values)
  rest.append_to(values)
  frame_set_scanned(buffer, 0)
}

--- Accept a chunk unless the line it continues would exceed `limit`: only the
--- bytes that belong to the current line count, the whole chunk when it has
--- no newline or the bytes before its first newline. A refused chunk empties
--- the buffer and answers false.
pub fn frame_buffer_accept(buffer: FrameBuffer, chunk: Bytes, limit: usize) -> bool {
  let newline: u8 = __u64_to_u8(10)
  let line_bytes = match chunk.find(newline) {
    Some(index) -> index
    None -> chunk.len()
  }
  if frame_buffer_len(buffer) + line_bytes > limit {
    let values = buffer.values
    vector_clear<u8>(values)
    frame_set_scanned(buffer, 0)
    false
  } else {
    let values = buffer.values
    chunk.append_to(values)
    true
  }
}

--- The next complete line without its newline, removed from the buffer, or
--- `None` when no newline has arrived yet.
pub fn frame_buffer_take_line(buffer: FrameBuffer) -> Option<Bytes> {
  let values = buffer.values
  let newline: u8 = __u64_to_u8(10)
  let len = vector_len<u8>(values)
  let mut index = frame_scanned(buffer)
  while index < len and vector_get_in_bounds<u8>(values, index) != newline { index = index + 1 }
  if index < len {
    let line = bytes_of_range(values, 0, index)
    frame_drop_prefix(buffer, index + 1)
    Some<Bytes>(line)
  } else {
    frame_set_scanned(buffer, len)
    None<Bytes>()
  }
}

--- Everything buffered as a final unterminated line, emptying the buffer.
pub fn frame_buffer_take_rest(buffer: FrameBuffer) -> Bytes {
  let values = buffer.values
  let line = bytes_of_range(values, 0, vector_len<u8>(values))
  vector_clear<u8>(values)
  frame_set_scanned(buffer, 0)
  line
}

--- The resolved grammar a request is addressed to; echoed by the response.
pub type ToolGrammar { package_name: str, export: str, module: str, declaration: str }

--- What a check is asked to consult.
pub type ToolContext {
  --- Parse only.
  ToolNoContext,
  --- Host types answered by the compiler through type queries.
  ToolHostContext,
  --- A bounded context file the grammar interprets itself.
  ToolFileContext(Path, usize)
}

--- A build target a stage is asked for, with the private sink directory the
--- compiler created for it.
pub type ToolStageTarget { capability: StagingCapability, platform: str, sink: Path }

--- What a request asks the driver to do beyond parsing.
pub type ToolOperation {
  --- Check under the context; the default when a request names no operation.
  ToolOperationCheck,
  --- Check under the context, then stage for the target.
  ToolOperationStage(ToolStageTarget)
}

--- A request to parse and optionally check or stage embedded source.
pub type ToolRequest {
  grammar: ToolGrammar,
  --- The source identity every diagnostic range names.
  source_name: str,
  source_text: str,
  context: ToolContext,
  operation: ToolOperation
}

--- The check phase of a response.
pub type ToolCheckOutcome {
  --- The request asked for parsing only.
  ToolCheckNotRequested,
  ToolChecked,
  ToolCheckRejected,
  --- The grammar does not support the requested context kind.
  ToolCheckUnsupported(GrammarContextKind),
  --- The context file could not be loaded or interpreted.
  ToolContextUnavailable,
  --- The export names no tooling module; the driver can only parse.
  ToolCheckRefusedNoTooling,
  --- The syntax was recovered or rejected, so checking was withheld.
  ToolCheckRefusedParseNotAccepted
}

--- What a context file read produced.
pub type ToolObservedOutcome {
  --- The read succeeded with this many bytes and this content digest.
  ToolObservedContent(usize, str),
  --- The read failed with the named I/O error.
  ToolObservedFailure(str)
}

--- One file read the grammar performed while checking.
pub type ToolObservedInput { path: Path, limit: usize, outcome: ToolObservedOutcome }

--- The artifact a driver reports having written into the sink: its size and
--- digest as written, the byte budget the sink enforced, and the package's
--- facts envelope.
pub type ToolStagedArtifact { size: usize, content: str, budget: usize, facts: Json }

--- The stage phase of a response.
pub type ToolStageOutcome {
  --- The request asked for a check only.
  ToolStageNotRequested,
  --- The package emitted an artifact into the sink.
  ToolStaged(ToolStagedArtifact),
  --- The syntax checked; the capability emits nothing.
  ToolStagedNothing,
  --- The syntax was recovered or rejected, so staging was withheld.
  ToolStageRefusedParseNotAccepted,
  --- The package's check rejected the source.
  ToolStageRefusedCheckRejected,
  --- The package emits nothing for the requested capability.
  ToolStageRefusedNoStaging,
  --- The export names no tooling module; the driver can only parse.
  ToolStageRefusedNoTooling,
  --- The context file could not be acquired or was invalid.
  ToolStageContextUnavailable,
  --- The package does not stage against this context kind.
  ToolStageContextUnsupported(GrammarContextKind),
  --- The package cannot encode its plan for the target's platform.
  ToolStageUnsupportedTarget,
  --- The sink refused a chunk; the named I/O error follows.
  ToolStageSinkRefused(str)
}

--- The driver's final answer.
pub type ToolResponse {
  grammar: ToolGrammar,
  parse: ParseOutcome,
  check: ToolCheckOutcome,
  stage: ToolStageOutcome,
  diagnostics: List<Diagnostic>,
  observed_inputs: List<ToolObservedInput>
}

--- A host type query raised by the grammar while checking.
pub type ToolQuery {
  ToolQueryResolve(TypeName<ToolTypeIdentity>),
  ToolQueryField(ToolTypeIdentity, TypeField),
  ToolQueryFields(ToolTypeIdentity),
  ToolQuerySubtype(ToolTypeIdentity, ToolTypeIdentity)
}

--- The compiler's answer to one query.
pub type ToolReply {
  ToolReplyType(ResolvedType<ToolTypeIdentity>),
  ToolReplyFields(List<ResolvedField<ToolTypeIdentity>>),
  ToolReplyBool(bool),
  ToolReplyError(TypeQueryError)
}

--- A line written by the driver: a query, or the response that ends the exchange.
pub type ToolDriverMessage {
  ToolDriverQuery(ToolQuery),
  ToolDriverResponse(ToolResponse)
}

--- Why a line is not a valid protocol message.
pub type ToolProtocolError {
  --- The named member is missing or misshapen inside the given message kind.
  ToolProtocolShape(str, str),
  --- The protocol name does not match this version.
  ToolProtocolVersion(str),
  --- The line is not a JSON document; the offset of the failure.
  ToolProtocolJson(usize),
  ToolProtocolDiagnostic(diagnostic_json.DiagnosticJsonError),
  ToolProtocolType(types.SemanticJsonError),
  --- A path is not UTF-8 text and cannot travel in this version.
  ToolProtocolPath(str)
}

fn entry(key: str, value: Json) -> JsonEntry { JsonEntry(key, value) }

fn object1(first: JsonEntry) -> Json { JsonObject(Cons(first, Nil<JsonEntry>())) }

fn object2(first: JsonEntry, second: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Nil<JsonEntry>())))
}

fn object3(first: JsonEntry, second: JsonEntry, third: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Cons(third, Nil<JsonEntry>()))))
}

fn object4(first: JsonEntry, second: JsonEntry, third: JsonEntry, fourth: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Cons(third, Cons(fourth, Nil<JsonEntry>())))))
}

fn object5(
  first: JsonEntry,
  second: JsonEntry,
  third: JsonEntry,
  fourth: JsonEntry,
  fifth: JsonEntry
) -> Json {
  JsonObject(Cons(first, Cons(second, Cons(third, Cons(fourth, Cons(fifth, Nil<JsonEntry>()))))))
}

fn object6(
  first: JsonEntry,
  second: JsonEntry,
  third: JsonEntry,
  fourth: JsonEntry,
  fifth: JsonEntry,
  sixth: JsonEntry
) -> Json {
  JsonObject(
    Cons(
      first,
      Cons(second, Cons(third, Cons(fourth, Cons(fifth, Cons(sixth, Nil<JsonEntry>())))))
    )
  )
}

fn shape<T>(kind: str, what: str) -> Result<T, ToolProtocolError> {
  Err<T, ToolProtocolError>(ToolProtocolShape(kind, what))
}

fn kind_of(value: Json) -> str { json_object_get_str(value, "kind", "") }

fn text_member(value: Json, kind: str, key: str) -> Result<str, ToolProtocolError> {
  match json_object_get(value, key) {
    Some(JsonString(text)) -> Ok<str, ToolProtocolError>(text)
    _ -> shape<str>(kind, key)
  }
}

fn object_member(value: Json, kind: str, key: str) -> Result<Json, ToolProtocolError> {
  match json_object_get(value, key) {
    Some(inner) -> if json_kind(inner) == 5 { Ok<Json, ToolProtocolError>(inner) } else {
      shape<Json>(kind, key)
    }
    None -> shape<Json>(kind, key)
  }
}

fn array_member(value: Json, kind: str, key: str) -> Result<List<Json>, ToolProtocolError> {
  match json_object_get(value, key) {
    Some(JsonArray(items)) -> Ok<List<Json>, ToolProtocolError>(items)
    _ -> shape<List<Json>>(kind, key)
  }
}

fn usize_member(value: Json, kind: str, key: str) -> Result<usize, ToolProtocolError> {
  match json_object_get(value, key) {
    Some(JsonNumber(number)) -> match number.to_usize_checked() {
      Ok(converted) -> Ok<usize, ToolProtocolError>(converted)
      Err(_) -> shape<usize>(kind, key)
    }
    _ -> shape<usize>(kind, key)
  }
}

fn token_member(value: Json, kind: str, key: str) -> Result<ToolTypeIdentity, ToolProtocolError> {
  match json_object_get(value, key) {
    Some(JsonNumber(token)) -> Ok<ToolTypeIdentity, ToolProtocolError>(tool_type_identity(token))
    _ -> shape<ToolTypeIdentity>(kind, key)
  }
}

fn usize_json(value: usize) -> Json {
  match value.to_u64().to_i64_checked() {
    Ok(number) -> JsonNumber(number)
    Err(_) -> JsonNumber(0 - 1)
  }
}

fn token_json(identity: ToolTypeIdentity) -> Json {
  JsonNumber(tool_type_identity_token(identity))
}

fn path_json(value: Path) -> Result<Json, ToolProtocolError> {
  match value.to_utf8() {
    Ok(text) -> Ok<Json, ToolProtocolError>(JsonString(text))
    Err(_) -> Err<Json, ToolProtocolError>(ToolProtocolPath("path is not UTF-8"))
  }
}

fn path_member(value: Json, kind: str, key: str) -> Result<Path, ToolProtocolError> {
  match text_member(value, kind, key) {
    Err(error) -> Err<Path, ToolProtocolError>(error)
    Ok(text) -> match path.from_utf8(text) {
      Ok(parsed) -> Ok<Path, ToolProtocolError>(parsed)
      Err(_) -> Err<Path, ToolProtocolError>(ToolProtocolPath(text))
    }
  }
}

-- Lines.
--- Render one message as a line: the document followed by a newline.
pub fn render_line(value: Json) -> str {
  match json_stringify(value) {
    Ok(text) -> str_concat(text, "\n")
    Err(_) -> "null\n"
  }
}

--- Parse one line into a document.
pub fn parse_line(text: str) -> Result<Json, ToolProtocolError> {
  match json.parse(text) {
    Ok(value) -> if json_kind(value) == 5 { Ok<Json, ToolProtocolError>(value) } else {
      shape<Json>("message", "object")
    }
    Err(JsonInvalidSyntax(offset)) -> Err<Json, ToolProtocolError>(ToolProtocolJson(offset))
  }
}

-- Grammar identity.
fn encode_grammar(grammar: ToolGrammar) -> Json {
  object4(
    entry("package", JsonString(grammar.package_name)),
    entry("export", JsonString(grammar.export)),
    entry("module", JsonString(grammar.module)),
    entry("declaration", JsonString(grammar.declaration))
  )
}

fn decode_grammar(value: Json) -> Result<ToolGrammar, ToolProtocolError> {
  match text_member(value, "grammar", "package") {
    Err(error) -> Err<ToolGrammar, ToolProtocolError>(error)
    Ok(package_name) -> match text_member(value, "grammar", "export") {
      Err(error) -> Err<ToolGrammar, ToolProtocolError>(error)
      Ok(export) -> match text_member(value, "grammar", "module") {
        Err(error) -> Err<ToolGrammar, ToolProtocolError>(error)
        Ok(module) -> match text_member(value, "grammar", "declaration") {
          Err(error) -> Err<ToolGrammar, ToolProtocolError>(error)
          Ok(declaration) -> Ok<ToolGrammar, ToolProtocolError>(
            ToolGrammar {
              package_name: package_name,
              export: export,
              module: module,
              declaration: declaration
            }
          )
        }
      }
    }
  }
}

--- Whether two grammar identities name the same export.
pub fn same_grammar(left: ToolGrammar, right: ToolGrammar) -> bool {
  left.package_name == right.package_name and left.export == right.export and
    left.module == right.module and left.declaration == right.declaration
}

-- Request.
fn encode_context(context: ToolContext) -> Result<Json, ToolProtocolError> {
  match context {
    ToolNoContext -> Ok<Json, ToolProtocolError>(object1(entry("kind", JsonString("none"))))
    ToolHostContext -> Ok<Json, ToolProtocolError>(object1(entry("kind", JsonString("host"))))
    ToolFileContext(context_path, limit) -> match path_json(context_path) {
      Err(error) -> Err<Json, ToolProtocolError>(error)
      Ok(path_value) -> Ok<Json, ToolProtocolError>(
        object3(
          entry("kind", JsonString("file")),
          entry("path", path_value),
          entry("limit", usize_json(limit))
        )
      )
    }
  }
}

fn capability_name(capability: StagingCapability) -> str {
  match capability {
    StagingValidateOnly -> "validate_only"
    StagingTypedPlan -> "typed_plan"
  }
}

fn decode_capability(name: str) -> Result<StagingCapability, ToolProtocolError> {
  if name == "validate_only" { Ok<StagingCapability, ToolProtocolError>(StagingValidateOnly) }
  else {
    if name == "typed_plan" { Ok<StagingCapability, ToolProtocolError>(StagingTypedPlan) }
    else { shape<StagingCapability>("target", "capability") }
  }
}

fn encode_target(target: ToolStageTarget) -> Result<Json, ToolProtocolError> {
  match path_json(target.sink) {
    Err(error) -> Err<Json, ToolProtocolError>(error)
    Ok(sink) -> Ok<Json, ToolProtocolError>(
      object3(
        entry("capability", JsonString(capability_name(target.capability))),
        entry("platform", JsonString(target.platform)),
        entry("sink", sink)
      )
    )
  }
}

fn decode_target(value: Json) -> Result<ToolStageTarget, ToolProtocolError> {
  match text_member(value, "target", "capability") {
    Err(error) -> Err<ToolStageTarget, ToolProtocolError>(error)
    Ok(capability_text) -> match decode_capability(capability_text) {
      Err(error) -> Err<ToolStageTarget, ToolProtocolError>(error)
      Ok(capability) -> match text_member(value, "target", "platform") {
        Err(error) -> Err<ToolStageTarget, ToolProtocolError>(error)
        Ok(platform) -> match path_member(value, "target", "sink") {
          Err(error) -> Err<ToolStageTarget, ToolProtocolError>(error)
          Ok(sink) -> Ok<ToolStageTarget, ToolProtocolError>(
            ToolStageTarget { capability: capability, platform: platform, sink: sink }
          )
        }
      }
    }
  }
}

--- Encode a request line document. A check names no operation, so every
--- request an older peer understands is unchanged; a stage names its
--- operation and target.
pub fn encode_request(request: ToolRequest) -> Result<Json, ToolProtocolError> {
  match encode_context(request.context) {
    Err(error) -> Err<Json, ToolProtocolError>(error)
    Ok(context) -> {
      let protocol = entry("protocol", JsonString(protocol_name()))
      let grammar = entry("grammar", encode_grammar(request.grammar))
      let source = entry(
        "source",
        object2(
          entry("name", JsonString(request.source_name)),
          entry("text", JsonString(request.source_text))
        )
      )
      match request.operation {
        ToolOperationCheck -> Ok<Json, ToolProtocolError>(
          object4(protocol, grammar, source, entry("context", context))
        )
        ToolOperationStage(target) -> match encode_target(target) {
          Err(error) -> Err<Json, ToolProtocolError>(error)
          Ok(target_json) -> Ok<Json, ToolProtocolError>(
            object6(
              protocol,
              grammar,
              source,
              entry("context", context),
              entry("operation", JsonString("stage")),
              entry("target", target_json)
            )
          )
        }
      }
    }
  }
}

fn decode_operation(value: Json) -> Result<ToolOperation, ToolProtocolError> {
  match json_object_get(value, "operation") {
    None -> Ok<ToolOperation, ToolProtocolError>(ToolOperationCheck)
    Some(JsonString(name)) -> if name == "check" {
      Ok<ToolOperation, ToolProtocolError>(ToolOperationCheck)
    } else {
      if name == "stage" {
        match object_member(value, "request", "target") {
          Err(error) -> Err<ToolOperation, ToolProtocolError>(error)
          Ok(target_json) -> match decode_target(target_json) {
            Err(error) -> Err<ToolOperation, ToolProtocolError>(error)
            Ok(target) -> Ok<ToolOperation, ToolProtocolError>(ToolOperationStage(target))
          }
        }
      } else { shape<ToolOperation>("request", "operation") }
    }
    Some(_) -> shape<ToolOperation>("request", "operation")
  }
}

fn decode_context(value: Json) -> Result<ToolContext, ToolProtocolError> {
  let kind = kind_of(value)
  if kind == "none" { Ok<ToolContext, ToolProtocolError>(ToolNoContext) }
  else {
    if kind == "host" { Ok<ToolContext, ToolProtocolError>(ToolHostContext) }
    else {
      if kind == "file" {
        match path_member(value, kind, "path") {
          Err(error) -> Err<ToolContext, ToolProtocolError>(error)
          Ok(context_path) -> match usize_member(value, kind, "limit") {
            Err(error) -> Err<ToolContext, ToolProtocolError>(error)
            Ok(limit) -> Ok<ToolContext, ToolProtocolError>(ToolFileContext(context_path, limit))
          }
        }
      } else { shape<ToolContext>("context", "kind") }
    }
  }
}

--- Decode a request line document.
pub fn decode_request(value: Json) -> Result<ToolRequest, ToolProtocolError> {
  match text_member(value, "request", "protocol") {
    Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
    Ok(protocol) -> if protocol != protocol_name() {
      Err<ToolRequest, ToolProtocolError>(ToolProtocolVersion(protocol))
    } else {
      match object_member(value, "request", "grammar") {
        Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
        Ok(grammar_json) -> match decode_grammar(grammar_json) {
          Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
          Ok(grammar) -> match object_member(value, "request", "source") {
            Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
            Ok(source) -> match text_member(source, "source", "name") {
              Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
              Ok(source_name) -> match text_member(source, "source", "text") {
                Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
                Ok(source_text) -> match object_member(value, "request", "context") {
                  Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
                  Ok(context_json) -> match decode_context(context_json) {
                    Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
                    Ok(context) -> match decode_operation(value) {
                      Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
                      Ok(operation) -> Ok<ToolRequest, ToolProtocolError>(
                        ToolRequest {
                          grammar: grammar,
                          source_name: source_name,
                          source_text: source_text,
                          context: context,
                          operation: operation
                        }
                      )
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

-- Queries.
fn encode_type_name(name: TypeName<ToolTypeIdentity>) -> Json {
  object3(
    entry("qualifier", match name.qualifier { Some(text) -> JsonString(text), None -> JsonNull }),
    entry("name", JsonString(name.name)),
    entry(
      "arguments",
      JsonArray(name.arguments.map<Json>((identity: ToolTypeIdentity) => token_json(identity)))
    )
  )
}

fn encode_selector(selector: TypeField) -> Json {
  match selector {
    NamedTypeField(name) -> object1(entry("name", JsonString(name)))
    PositionalTypeField(position) -> object1(entry("position", usize_json(position)))
  }
}

--- Encode a query line document.
pub fn encode_query(query: ToolQuery) -> Json {
  match query {
    ToolQueryResolve(request) -> object2(
      entry("query", JsonString("resolve")),
      entry("request", encode_type_name(request))
    )
    ToolQueryField(base, selector) -> object3(
      entry("query", JsonString("field")),
      entry("base", token_json(base)),
      entry("selector", encode_selector(selector))
    )
    ToolQueryFields(base) -> object2(
      entry("query", JsonString("fields")),
      entry("base", token_json(base))
    )
    ToolQuerySubtype(actual, expected) -> object3(
      entry("query", JsonString("subtype")),
      entry("actual", token_json(actual)),
      entry("expected", token_json(expected))
    )
  }
}

fn decode_tokens(items: List<Json>) -> Result<List<ToolTypeIdentity>, ToolProtocolError> {
  match items {
    Nil -> Ok<List<ToolTypeIdentity>, ToolProtocolError>(Nil<ToolTypeIdentity>())
    Cons(JsonNumber(token), rest) -> match decode_tokens(rest) {
      Err(error) -> Err<List<ToolTypeIdentity>, ToolProtocolError>(error)
      Ok(tail) -> Ok<List<ToolTypeIdentity>, ToolProtocolError>(
        Cons(tool_type_identity(token), tail)
      )
    }
    Cons(_, _) -> shape<List<ToolTypeIdentity>>("type_name", "arguments")
  }
}

fn decode_type_name(value: Json) -> Result<TypeName<ToolTypeIdentity>, ToolProtocolError> {
  let qualifier = match json_object_get(value, "qualifier") {
    Some(JsonString(text)) -> Ok<Option<str>, ToolProtocolError>(Some<str>(text))
    Some(JsonNull) -> Ok<Option<str>, ToolProtocolError>(None<str>())
    None -> Ok<Option<str>, ToolProtocolError>(None<str>())
    _ -> shape<Option<str>>("type_name", "qualifier")
  }
  match qualifier {
    Err(error) -> Err<TypeName<ToolTypeIdentity>, ToolProtocolError>(error)
    Ok(qualifier_value) -> match text_member(value, "type_name", "name") {
      Err(error) -> Err<TypeName<ToolTypeIdentity>, ToolProtocolError>(error)
      Ok(name) -> match array_member(value, "type_name", "arguments") {
        Err(error) -> Err<TypeName<ToolTypeIdentity>, ToolProtocolError>(error)
        Ok(items) -> match decode_tokens(items) {
          Err(error) -> Err<TypeName<ToolTypeIdentity>, ToolProtocolError>(error)
          Ok(arguments) -> Ok<TypeName<ToolTypeIdentity>, ToolProtocolError>(
            TypeName { qualifier: qualifier_value, name: name, arguments: arguments }
          )
        }
      }
    }
  }
}

fn decode_selector(value: Json) -> Result<TypeField, ToolProtocolError> {
  match json_object_get(value, "name") {
    Some(JsonString(name)) -> Ok<TypeField, ToolProtocolError>(NamedTypeField(name))
    Some(_) -> shape<TypeField>("selector", "name")
    None -> match usize_member(value, "selector", "position") {
      Err(error) -> Err<TypeField, ToolProtocolError>(error)
      Ok(position) -> Ok<TypeField, ToolProtocolError>(PositionalTypeField(position))
    }
  }
}

--- Decode a query line document.
pub fn decode_query(value: Json) -> Result<ToolQuery, ToolProtocolError> {
  match text_member(value, "query", "query") {
    Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
    Ok(kind) -> if kind == "resolve" {
      match object_member(value, kind, "request") {
        Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
        Ok(request_json) -> match decode_type_name(request_json) {
          Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
          Ok(request) -> Ok<ToolQuery, ToolProtocolError>(ToolQueryResolve(request))
        }
      }
    } else {
      if kind == "field" {
        match token_member(value, kind, "base") {
          Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
          Ok(base) -> match object_member(value, kind, "selector") {
            Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
            Ok(selector_json) -> match decode_selector(selector_json) {
              Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
              Ok(selector) -> Ok<ToolQuery, ToolProtocolError>(ToolQueryField(base, selector))
            }
          }
        }
      } else {
        if kind == "fields" {
          match token_member(value, kind, "base") {
            Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
            Ok(base) -> Ok<ToolQuery, ToolProtocolError>(ToolQueryFields(base))
          }
        } else {
          if kind == "subtype" {
            match token_member(value, kind, "actual") {
              Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
              Ok(actual) -> match token_member(value, kind, "expected") {
                Err(error) -> Err<ToolQuery, ToolProtocolError>(error)
                Ok(expected) -> Ok<ToolQuery, ToolProtocolError>(
                  ToolQuerySubtype(actual, expected)
                )
              }
            }
          } else { shape<ToolQuery>("query", "query") }
        }
      }
    }
  }
}

-- Replies.
fn encode_resolved(resolved: ResolvedType<ToolTypeIdentity>) -> Json {
  object2(
    entry("identity", token_json(resolved.identity)),
    entry("description", types.encode_type(resolved.description))
  )
}

fn encode_issue(issue: TypeArgumentIssue) -> Json {
  match issue {
    TypeArgumentTraitRequired(position, argument, bound) ->
      object4(
        entry("kind", JsonString("trait_required")),
        entry("position", usize_json(position)),
        entry("argument", types.encode_type(argument)),
        entry("bound", types.encode_type(bound))
      )
    TypeArgumentAssociatedTypesRejected(position, argument, bound) ->
      object4(
        entry("kind", JsonString("associated_types_rejected")),
        entry("position", usize_json(position)),
        entry("argument", types.encode_type(argument)),
        entry("bound", types.encode_type(bound))
      )
    TypeArgumentIssueOther(name) -> object2(
      entry("kind", JsonString("other")),
      entry("name", JsonString(name))
    )
  }
}

fn encode_query_error(error: TypeQueryError) -> Json {
  match error {
    TypeNotFound -> object1(entry("kind", JsonString("not_found")))
    TypeFieldNotFound -> object1(entry("kind", JsonString("field_not_found")))
    TypeFieldsUnavailable -> object1(entry("kind", JsonString("fields_unavailable")))
    TypeArgumentCount(expected, actual) -> object3(
      entry("kind", JsonString("argument_count")),
      entry("expected", usize_json(expected)),
      entry("actual", usize_json(actual))
    )
    TypeArgumentsRejected(issues) -> object2(
      entry("kind", JsonString("arguments_rejected")),
      entry(
        "issues",
        JsonArray(issues.map<Json>((issue: TypeArgumentIssue) => encode_issue(issue)))
      )
    )
    ForeignTypeIdentity -> object1(entry("kind", JsonString("foreign_identity")))
  }
}

--- Encode a reply line document.
pub fn encode_reply(reply: ToolReply) -> Json {
  match reply {
    ToolReplyType(resolved) -> object1(entry("ok", encode_resolved(resolved)))
    ToolReplyFields(fields) -> object1(
      entry(
        "ok",
        JsonArray(
          fields.map<Json>(
            (field: ResolvedField<ToolTypeIdentity>) => object2(
              entry("selector", encode_selector(field.selector)),
              entry("value", encode_resolved(field.value))
            )
          )
        )
      )
    )
    ToolReplyBool(flag) -> object1(entry("ok", JsonBool(flag)))
    ToolReplyError(error) -> object1(entry("error", encode_query_error(error)))
  }
}

fn typed<T>(result: Result<T, types.SemanticJsonError>) -> Result<T, ToolProtocolError> {
  match result {
    Ok(value) -> Ok<T, ToolProtocolError>(value)
    Err(error) -> Err<T, ToolProtocolError>(ToolProtocolType(error))
  }
}

fn decode_resolved(value: Json) -> Result<ResolvedType<ToolTypeIdentity>, ToolProtocolError> {
  match token_member(value, "resolved", "identity") {
    Err(error) -> Err<ResolvedType<ToolTypeIdentity>, ToolProtocolError>(error)
    Ok(identity) -> match object_member(value, "resolved", "description") {
      Err(error) -> Err<ResolvedType<ToolTypeIdentity>, ToolProtocolError>(error)
      Ok(description_json) -> match typed<SemanticTypeFact>(types.decode_type(description_json)) {
        Err(error) -> Err<ResolvedType<ToolTypeIdentity>, ToolProtocolError>(error)
        Ok(description) -> Ok<ResolvedType<ToolTypeIdentity>, ToolProtocolError>(
          ResolvedType { identity: identity, description: description }
        )
      }
    }
  }
}

fn decode_fields(
  items: List<Json>
) -> Result<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError> {
  match items {
    Nil -> Ok<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(
      Nil<ResolvedField<ToolTypeIdentity>>()
    )
    Cons(item, rest) -> match object_member(item, "field", "selector") {
      Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(error)
      Ok(selector_json) -> match decode_selector(selector_json) {
        Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(error)
        Ok(selector) -> match object_member(item, "field", "value") {
          Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(error)
          Ok(value_json) -> match decode_resolved(value_json) {
            Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(error)
            Ok(value) -> match decode_fields(rest) {
              Err(error) -> Err<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(error)
              Ok(tail) -> Ok<List<ResolvedField<ToolTypeIdentity>>, ToolProtocolError>(
                Cons(ResolvedField { selector: selector, value: value }, tail)
              )
            }
          }
        }
      }
    }
  }
}

fn decode_issue(item: Json) -> Result<TypeArgumentIssue, ToolProtocolError> {
  let kind = kind_of(item)
  if kind == "other" {
    match text_member(item, kind, "name") {
      Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
      Ok(name) -> Ok<TypeArgumentIssue, ToolProtocolError>(TypeArgumentIssueOther(name))
    }
  } else {
    if kind == "trait_required" or kind == "associated_types_rejected" {
      match usize_member(item, kind, "position") {
        Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
        Ok(position) -> match object_member(item, kind, "argument") {
          Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
          Ok(argument_json) -> match typed<SemanticTypeFact>(types.decode_type(argument_json)) {
            Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
            Ok(argument) -> match object_member(item, kind, "bound") {
              Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
              Ok(bound_json) -> match typed<SemanticTypeFact>(types.decode_type(bound_json)) {
                Err(error) -> Err<TypeArgumentIssue, ToolProtocolError>(error)
                Ok(bound) -> if kind == "trait_required" {
                  Ok<TypeArgumentIssue, ToolProtocolError>(
                    TypeArgumentTraitRequired(position, argument, bound)
                  )
                } else {
                  Ok<TypeArgumentIssue, ToolProtocolError>(
                    TypeArgumentAssociatedTypesRejected(position, argument, bound)
                  )
                }
              }
            }
          }
        }
      }
    } else { shape<TypeArgumentIssue>("issue", "kind") }
  }
}

fn decode_issues(items: List<Json>) -> Result<List<TypeArgumentIssue>, ToolProtocolError> {
  match items {
    Nil -> Ok<List<TypeArgumentIssue>, ToolProtocolError>(Nil<TypeArgumentIssue>())
    Cons(item, rest) -> match decode_issue(item) {
      Err(error) -> Err<List<TypeArgumentIssue>, ToolProtocolError>(error)
      Ok(issue) -> match decode_issues(rest) {
        Err(error) -> Err<List<TypeArgumentIssue>, ToolProtocolError>(error)
        Ok(tail) -> Ok<List<TypeArgumentIssue>, ToolProtocolError>(Cons(issue, tail))
      }
    }
  }
}

fn decode_query_error(value: Json) -> Result<TypeQueryError, ToolProtocolError> {
  let kind = kind_of(value)
  if kind == "not_found" { Ok<TypeQueryError, ToolProtocolError>(TypeNotFound) }
  else {
    if kind == "field_not_found" { Ok<TypeQueryError, ToolProtocolError>(TypeFieldNotFound) }
    else {
      if kind == "fields_unavailable" {
        Ok<TypeQueryError, ToolProtocolError>(TypeFieldsUnavailable)
      }
      else {
        if kind == "foreign_identity" {
          Ok<TypeQueryError, ToolProtocolError>(ForeignTypeIdentity)
        }
        else {
          if kind == "argument_count" {
            match usize_member(value, kind, "expected") {
              Err(error) -> Err<TypeQueryError, ToolProtocolError>(error)
              Ok(expected) -> match usize_member(value, kind, "actual") {
                Err(error) -> Err<TypeQueryError, ToolProtocolError>(error)
                Ok(actual) -> Ok<TypeQueryError, ToolProtocolError>(
                  TypeArgumentCount(expected, actual)
                )
              }
            }
          } else {
            if kind == "arguments_rejected" {
              match array_member(value, kind, "issues") {
                Err(error) -> Err<TypeQueryError, ToolProtocolError>(error)
                Ok(items) -> match decode_issues(items) {
                  Err(error) -> Err<TypeQueryError, ToolProtocolError>(error)
                  Ok(issues) -> Ok<TypeQueryError, ToolProtocolError>(
                    TypeArgumentsRejected(issues)
                  )
                }
              }
            } else { shape<TypeQueryError>("query_error", "kind") }
          }
        }
      }
    }
  }
}

--- Decode a reply line document.
pub fn decode_reply(value: Json) -> Result<ToolReply, ToolProtocolError> {
  match json_object_get(value, "ok") {
    Some(JsonBool(flag)) -> Ok<ToolReply, ToolProtocolError>(ToolReplyBool(flag))
    Some(JsonArray(items)) -> match decode_fields(items) {
      Err(error) -> Err<ToolReply, ToolProtocolError>(error)
      Ok(fields) -> Ok<ToolReply, ToolProtocolError>(ToolReplyFields(fields))
    }
    Some(JsonObject(entries)) -> match decode_resolved(JsonObject(entries)) {
      Err(error) -> Err<ToolReply, ToolProtocolError>(error)
      Ok(resolved) -> Ok<ToolReply, ToolProtocolError>(ToolReplyType(resolved))
    }
    Some(_) -> shape<ToolReply>("reply", "ok")
    None -> match object_member(value, "reply", "error") {
      Err(error) -> Err<ToolReply, ToolProtocolError>(error)
      Ok(error_json) -> match decode_query_error(error_json) {
        Err(error) -> Err<ToolReply, ToolProtocolError>(error)
        Ok(query_error) -> Ok<ToolReply, ToolProtocolError>(ToolReplyError(query_error))
      }
    }
  }
}

-- Response.
--- The wire name of a parse outcome.
pub fn parse_name(outcome: ParseOutcome) -> str {
  match outcome {
    ParseOutcomeParsed -> "parsed"
    ParseOutcomeRecovered -> "recovered"
    ParseOutcomeRejected -> "rejected"
  }
}

fn context_kind_name(kind: GrammarContextKind) -> str {
  match kind {
    GrammarHostTypesContext -> "host_types"
    GrammarFileContext -> "file"
  }
}

--- The wire shape of a check outcome; tools reuse it so one vocabulary
--- describes the check phase everywhere.
pub fn encode_check(outcome: ToolCheckOutcome) -> Json {
  match outcome {
    ToolCheckNotRequested -> JsonString("not_requested")
    ToolChecked -> JsonString("checked")
    ToolCheckRejected -> JsonString("rejected")
    ToolCheckUnsupported(kind) -> object1(
      entry("unsupported", JsonString(context_kind_name(kind)))
    )
    ToolContextUnavailable -> JsonString("context_unavailable")
    ToolCheckRefusedNoTooling -> object1(entry("refused", JsonString("no_tooling")))
    ToolCheckRefusedParseNotAccepted -> object1(
      entry("refused", JsonString("parse_not_accepted"))
    )
  }
}

--- The wire shape of one observed input; paths must be UTF-8.
pub fn encode_observed(input: ToolObservedInput) -> Result<Json, ToolProtocolError> {
  match path_json(input.path) {
    Err(error) -> Err<Json, ToolProtocolError>(error)
    Ok(path_value) -> Ok<Json, ToolProtocolError>(
      object3(
        entry("path", path_value),
        entry("limit", usize_json(input.limit)),
        entry(
          "outcome",
          match input.outcome {
            ToolObservedContent(size, digest) -> object1(
              entry(
                "ok",
                object2(entry("size", usize_json(size)), entry("content", JsonString(digest)))
              )
            )
            ToolObservedFailure(name) -> object1(entry("error", JsonString(name)))
          }
        )
      )
    )
  }
}

fn encode_observed_list(
  inputs: List<ToolObservedInput>,
  acc: List<Json>
) -> Result<List<Json>, ToolProtocolError> {
  match inputs {
    Nil -> Ok<List<Json>, ToolProtocolError>(acc.reverse())
    Cons(input, rest) -> match encode_observed(input) {
      Err(error) -> Err<List<Json>, ToolProtocolError>(error)
      Ok(encoded) -> encode_observed_list(rest, Cons(encoded, acc))
    }
  }
}

--- The wire shape of a stage outcome, in the protocol's own vocabulary.
pub fn encode_stage(outcome: ToolStageOutcome) -> Json {
  match outcome {
    ToolStageNotRequested -> JsonString("not_requested")
    ToolStaged(artifact) -> object1(
      entry(
        "staged",
        object4(
          entry("size", usize_json(artifact.size)),
          entry("content", JsonString(artifact.content)),
          entry("budget", usize_json(artifact.budget)),
          entry("facts", artifact.facts)
        )
      )
    )
    ToolStagedNothing -> JsonString("staged_nothing")
    ToolStageRefusedParseNotAccepted -> object1(
      entry("refused", JsonString("parse_not_accepted"))
    )
    ToolStageRefusedCheckRejected -> object1(entry("refused", JsonString("check_rejected")))
    ToolStageRefusedNoStaging -> object1(entry("refused", JsonString("no_staging")))
    ToolStageRefusedNoTooling -> object1(entry("refused", JsonString("no_tooling")))
    ToolStageContextUnavailable -> JsonString("context_unavailable")
    ToolStageContextUnsupported(kind) -> object1(
      entry("unsupported", object1(entry("context", JsonString(context_kind_name(kind)))))
    )
    ToolStageUnsupportedTarget -> object1(entry("unsupported", JsonString("target")))
    ToolStageSinkRefused(name) -> object1(entry("sink_refused", JsonString(name)))
  }
}

fn object7(
  first: JsonEntry,
  second: JsonEntry,
  third: JsonEntry,
  fourth: JsonEntry,
  fifth: JsonEntry,
  sixth: JsonEntry,
  seventh: JsonEntry
) -> Json {
  JsonObject(
    Cons(
      first,
      Cons(
        second,
        Cons(third, Cons(fourth, Cons(fifth, Cons(sixth, Cons(seventh, Nil<JsonEntry>())))))
      )
    )
  )
}

--- Encode a response line document.
pub fn encode_response(response: ToolResponse) -> Result<Json, ToolProtocolError> {
  match encode_observed_list(response.observed_inputs, Nil<Json>()) {
    Err(error) -> Err<Json, ToolProtocolError>(error)
    Ok(observed) -> Ok<Json, ToolProtocolError>(
      object7(
        entry("response", JsonString(protocol_name())),
        entry("grammar", encode_grammar(response.grammar)),
        entry("parse", JsonString(parse_name(response.parse))),
        entry("check", encode_check(response.check)),
        entry("stage", encode_stage(response.stage)),
        entry(
          "diagnostics",
          JsonArray(
            response.diagnostics.map<Json>(
              (diagnostic: Diagnostic) => diagnostic_json.encode(diagnostic)
            )
          )
        ),
        entry("observed_inputs", JsonArray(observed))
      )
    )
  }
}

fn decode_staged(value: Json) -> Result<ToolStageOutcome, ToolProtocolError> {
  match usize_member(value, "staged", "size") {
    Err(error) -> Err<ToolStageOutcome, ToolProtocolError>(error)
    Ok(size) -> match text_member(value, "staged", "content") {
      Err(error) -> Err<ToolStageOutcome, ToolProtocolError>(error)
      Ok(content) -> match usize_member(value, "staged", "budget") {
        Err(error) -> Err<ToolStageOutcome, ToolProtocolError>(error)
        Ok(budget) -> match json_object_get(value, "facts") {
          None -> shape<ToolStageOutcome>("staged", "facts")
          Some(facts) -> Ok<ToolStageOutcome, ToolProtocolError>(
            ToolStaged(
              ToolStagedArtifact { size: size, content: content, budget: budget, facts: facts }
            )
          )
        }
      }
    }
  }
}

fn decode_stage_refusal(reason: str) -> Result<ToolStageOutcome, ToolProtocolError> {
  if reason == "parse_not_accepted" {
    Ok<ToolStageOutcome, ToolProtocolError>(ToolStageRefusedParseNotAccepted)
  } else {
    if reason == "check_rejected" {
      Ok<ToolStageOutcome, ToolProtocolError>(ToolStageRefusedCheckRejected)
    } else {
      if reason == "no_staging" {
        Ok<ToolStageOutcome, ToolProtocolError>(ToolStageRefusedNoStaging)
      } else {
        if reason == "no_tooling" {
          Ok<ToolStageOutcome, ToolProtocolError>(ToolStageRefusedNoTooling)
        } else { shape<ToolStageOutcome>("stage", "refused") }
      }
    }
  }
}

fn decode_stage_unsupported(value: Json) -> Result<ToolStageOutcome, ToolProtocolError> {
  match value {
    JsonString(what) -> if what == "target" {
      Ok<ToolStageOutcome, ToolProtocolError>(ToolStageUnsupportedTarget)
    } else { shape<ToolStageOutcome>("stage", "unsupported") }
    JsonObject(_) -> match json_object_get(value, "context") {
      Some(JsonString(kind_name)) -> match decode_context_kind(kind_name) {
        Err(error) -> Err<ToolStageOutcome, ToolProtocolError>(error)
        Ok(kind) -> Ok<ToolStageOutcome, ToolProtocolError>(ToolStageContextUnsupported(kind))
      }
      _ -> shape<ToolStageOutcome>("stage", "unsupported")
    }
    _ -> shape<ToolStageOutcome>("stage", "unsupported")
  }
}

fn decode_stage(value: Json) -> Result<ToolStageOutcome, ToolProtocolError> {
  match value {
    JsonString(name) -> if name == "not_requested" {
      Ok<ToolStageOutcome, ToolProtocolError>(ToolStageNotRequested)
    } else {
      if name == "staged_nothing" {
        Ok<ToolStageOutcome, ToolProtocolError>(ToolStagedNothing)
      } else {
        if name == "context_unavailable" {
          Ok<ToolStageOutcome, ToolProtocolError>(ToolStageContextUnavailable)
        } else { shape<ToolStageOutcome>("response", "stage") }
      }
    }
    JsonObject(_) -> match json_object_get(value, "staged") {
      Some(artifact) -> decode_staged(artifact)
      None -> match json_object_get(value, "refused") {
        Some(JsonString(reason)) -> decode_stage_refusal(reason)
        Some(_) -> shape<ToolStageOutcome>("stage", "refused")
        None -> match json_object_get(value, "unsupported") {
          Some(what) -> decode_stage_unsupported(what)
          None -> match json_object_get(value, "sink_refused") {
            Some(JsonString(name)) -> Ok<ToolStageOutcome, ToolProtocolError>(
              ToolStageSinkRefused(name)
            )
            _ -> shape<ToolStageOutcome>("response", "stage")
          }
        }
      }
    }
    _ -> shape<ToolStageOutcome>("response", "stage")
  }
}

fn decode_parse(name: str) -> Result<ParseOutcome, ToolProtocolError> {
  if name == "parsed" { Ok<ParseOutcome, ToolProtocolError>(ParseOutcomeParsed) }
  else {
    if name == "recovered" { Ok<ParseOutcome, ToolProtocolError>(ParseOutcomeRecovered) }
    else {
      if name == "rejected" { Ok<ParseOutcome, ToolProtocolError>(ParseOutcomeRejected) }
      else { shape<ParseOutcome>("response", "parse") }
    }
  }
}

fn decode_context_kind(name: str) -> Result<GrammarContextKind, ToolProtocolError> {
  if name == "host_types" { Ok<GrammarContextKind, ToolProtocolError>(GrammarHostTypesContext) }
  else {
    if name == "file" { Ok<GrammarContextKind, ToolProtocolError>(GrammarFileContext) }
    else { shape<GrammarContextKind>("check", "unsupported") }
  }
}

fn decode_check(value: Json) -> Result<ToolCheckOutcome, ToolProtocolError> {
  match value {
    JsonString(name) -> if name == "not_requested" {
      Ok<ToolCheckOutcome, ToolProtocolError>(ToolCheckNotRequested)
    }
    else {
      if name == "checked" { Ok<ToolCheckOutcome, ToolProtocolError>(ToolChecked) }
      else {
        if name == "rejected" { Ok<ToolCheckOutcome, ToolProtocolError>(ToolCheckRejected) }
        else {
          if name == "context_unavailable" {
            Ok<ToolCheckOutcome, ToolProtocolError>(ToolContextUnavailable)
          }
          else { shape<ToolCheckOutcome>("response", "check") }
        }
      }
    }
    JsonObject(_) -> match json_object_get(value, "unsupported") {
      Some(JsonString(kind_name)) -> match decode_context_kind(kind_name) {
        Err(error) -> Err<ToolCheckOutcome, ToolProtocolError>(error)
        Ok(kind) -> Ok<ToolCheckOutcome, ToolProtocolError>(ToolCheckUnsupported(kind))
      }
      Some(_) -> shape<ToolCheckOutcome>("check", "unsupported")
      None -> match json_object_get(value, "refused") {
        Some(JsonString(reason)) -> if reason == "no_tooling" {
          Ok<ToolCheckOutcome, ToolProtocolError>(ToolCheckRefusedNoTooling)
        }
        else {
          if reason == "parse_not_accepted" {
            Ok<ToolCheckOutcome, ToolProtocolError>(ToolCheckRefusedParseNotAccepted)
          }
          else { shape<ToolCheckOutcome>("check", "refused") }
        }
        _ -> shape<ToolCheckOutcome>("check", "refused")
      }
    }
    _ -> shape<ToolCheckOutcome>("response", "check")
  }
}

fn decode_diagnostics(items: List<Json>) -> Result<List<Diagnostic>, ToolProtocolError> {
  match items {
    Nil -> Ok<List<Diagnostic>, ToolProtocolError>(Nil<Diagnostic>())
    Cons(item, rest) -> match diagnostic_json.decode(item) {
      Err(error) -> Err<List<Diagnostic>, ToolProtocolError>(ToolProtocolDiagnostic(error))
      Ok(diagnostic) -> match decode_diagnostics(rest) {
        Err(error) -> Err<List<Diagnostic>, ToolProtocolError>(error)
        Ok(tail) -> Ok<List<Diagnostic>, ToolProtocolError>(Cons(diagnostic, tail))
      }
    }
  }
}

fn decode_observed(item: Json) -> Result<ToolObservedInput, ToolProtocolError> {
  match path_member(item, "observed_input", "path") {
    Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
    Ok(observed_path) -> match usize_member(item, "observed_input", "limit") {
      Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
      Ok(limit) -> match object_member(item, "observed_input", "outcome") {
        Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
        Ok(outcome) -> match json_object_get(outcome, "ok") {
          Some(content) -> match usize_member(content, "observed_input", "size") {
            Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
            Ok(size) -> match text_member(content, "observed_input", "content") {
              Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
              Ok(digest) -> Ok<ToolObservedInput, ToolProtocolError>(
                ToolObservedInput {
                  path: observed_path,
                  limit: limit,
                  outcome: ToolObservedContent(size, digest)
                }
              )
            }
          }
          None -> match text_member(outcome, "observed_input", "error") {
            Err(error) -> Err<ToolObservedInput, ToolProtocolError>(error)
            Ok(name) -> Ok<ToolObservedInput, ToolProtocolError>(
              ToolObservedInput {
                path: observed_path,
                limit: limit,
                outcome: ToolObservedFailure(name)
              }
            )
          }
        }
      }
    }
  }
}

fn decode_observed_list(items: List<Json>) -> Result<List<ToolObservedInput>, ToolProtocolError> {
  match items {
    Nil -> Ok<List<ToolObservedInput>, ToolProtocolError>(Nil<ToolObservedInput>())
    Cons(item, rest) -> match decode_observed(item) {
      Err(error) -> Err<List<ToolObservedInput>, ToolProtocolError>(error)
      Ok(input) -> match decode_observed_list(rest) {
        Err(error) -> Err<List<ToolObservedInput>, ToolProtocolError>(error)
        Ok(tail) -> Ok<List<ToolObservedInput>, ToolProtocolError>(Cons(input, tail))
      }
    }
  }
}

-- A response without a stage member answers a check: the member is additive.
fn decode_response_stage(value: Json) -> Result<ToolStageOutcome, ToolProtocolError> {
  match json_object_get(value, "stage") {
    None -> Ok<ToolStageOutcome, ToolProtocolError>(ToolStageNotRequested)
    Some(stage_json) -> decode_stage(stage_json)
  }
}

--- Decode a response line document.
pub fn decode_response(value: Json) -> Result<ToolResponse, ToolProtocolError> {
  match text_member(value, "response", "response") {
    Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
    Ok(protocol) -> if protocol != protocol_name() {
      Err<ToolResponse, ToolProtocolError>(ToolProtocolVersion(protocol))
    } else {
      match object_member(value, "response", "grammar") {
        Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
        Ok(grammar_json) -> match decode_grammar(grammar_json) {
          Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
          Ok(grammar) -> match text_member(value, "response", "parse") {
            Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
            Ok(parse_text) -> match decode_parse(parse_text) {
              Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
              Ok(parse) -> match json_object_get(value, "check") {
                None -> shape<ToolResponse>("response", "check")
                Some(check_json) -> match decode_check(check_json) {
                  Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                  Ok(check) -> match decode_response_stage(value) {
                    Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                    Ok(stage) -> match array_member(value, "response", "diagnostics") {
                      Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                      Ok(diagnostic_items) -> match decode_diagnostics(diagnostic_items) {
                        Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                        Ok(diagnostics) -> match array_member(
                          value,
                          "response",
                          "observed_inputs"
                        ) {
                          Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                          Ok(observed_items) -> match decode_observed_list(observed_items) {
                            Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
                            Ok(observed) -> Ok<ToolResponse, ToolProtocolError>(
                              ToolResponse {
                                grammar: grammar,
                                parse: parse,
                                check: check,
                                stage: stage,
                                diagnostics: diagnostics,
                                observed_inputs: observed
                              }
                            )
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

--- Decode a line the driver wrote: a query, or the response that ends the exchange.
pub fn decode_driver_message(value: Json) -> Result<ToolDriverMessage, ToolProtocolError> {
  match json_object_get(value, "query") {
    Some(_) -> match decode_query(value) {
      Err(error) -> Err<ToolDriverMessage, ToolProtocolError>(error)
      Ok(query) -> Ok<ToolDriverMessage, ToolProtocolError>(ToolDriverQuery(query))
    }
    None -> match decode_response(value) {
      Err(error) -> Err<ToolDriverMessage, ToolProtocolError>(error)
      Ok(response) -> Ok<ToolDriverMessage, ToolProtocolError>(ToolDriverResponse(response))
    }
  }
}

--- Render an error for tool output.
pub fn error_message(error: ToolProtocolError) -> str {
  match error {
    ToolProtocolShape(kind, what) -> str_concat(
      "grammar tool protocol: ",
      str_concat(kind, str_concat(" needs ", what))
    )
    ToolProtocolVersion(name) -> str_concat("grammar tool protocol: unsupported protocol ", name)
    ToolProtocolJson(_) -> "grammar tool protocol: line is not a JSON document"
    ToolProtocolDiagnostic(inner) -> diagnostic_json.error_message(inner)
    ToolProtocolType(inner) -> types.error_message(inner)
    ToolProtocolPath(text) -> str_concat("grammar tool protocol: path is not UTF-8 text: ", text)
  }
}
