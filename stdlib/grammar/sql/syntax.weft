-- Public, grammar-owned SQL syntax values.

use stdlib/list.{List}
use stdlib/option.{Option}
use stdlib/source.{Span}

--- An SQL identifier together with its exact source range.
pub type SqlIdentifier {
  --- Identifier text as written in the query.
  text: str,
  --- Exact byte range in the retained query source.
  span: Span
}

--- A scalar arithmetic or concatenation operator.
pub type SqlScalarOperator {
  --- Integer addition.
  SqlAdd,
  --- Integer subtraction.
  SqlSubtract,
  --- Integer multiplication.
  SqlMultiply,
  --- Integer division.
  SqlDivide,
  --- String concatenation.
  SqlConcat
}

--- A comparison operator producing a boolean predicate.
pub type SqlComparisonOperator {
  --- Equality.
  SqlEqual,
  --- Inequality.
  SqlNotEqual,
  --- Less than.
  SqlLess,
  --- Less than or equal.
  SqlLessEqual,
  --- Greater than.
  SqlGreater,
  --- Greater than or equal.
  SqlGreaterEqual
}

--- A boolean connective between predicate expressions.
pub type SqlLogicalOperator {
  --- Conjunction.
  SqlAnd,
  --- Disjunction.
  SqlOr
}

--- An aggregate supported by the first-party SQL grammar.
pub type SqlAggregateKind {
  --- Count rows or non-null input values.
  SqlCount,
  --- Sum integer input values.
  SqlSum,
  --- Select the minimum input value.
  SqlMin,
  --- Select the maximum input value.
  SqlMax
}

--- A recoverable SQL expression tree.
--- `SqlInvalidExpression` is retained only after parse recovery and can never
--- enter a checked plan.
pub type SqlExpression {
  --- An unqualified column reference.
  SqlColumn(SqlIdentifier),
  --- A table- or alias-qualified column reference.
  SqlQualifiedColumn(SqlIdentifier, SqlIdentifier),
  --- An integer literal and its exact source range.
  SqlIntegerLiteral(i64, Span),
  --- A string literal value and its content range, excluding quotes.
  SqlStringLiteral(str, Span),
  --- A boolean literal and its exact source range.
  SqlBooleanLiteral(bool, Span),
  --- A scalar operation over two expressions.
  SqlScalarExpression(SqlScalarOperator, SqlExpression, SqlExpression),
  --- A comparison over two expressions.
  SqlComparisonExpression(SqlComparisonOperator, SqlExpression, SqlExpression),
  --- A boolean operation over two predicate expressions.
  SqlLogicalExpression(SqlLogicalOperator, SqlExpression, SqlExpression),
  --- An aggregate call; no argument represents `count(*)`.
  SqlAggregateExpression(SqlAggregateKind, Option<SqlExpression>, Span),
  --- A recovered expression hole at the reported source position.
  SqlInvalidExpression(Span)
}

--- One projected expression and its optional output alias.
pub type SqlProjection {
  --- Expression evaluated for the output column.
  expression: SqlExpression,
  --- Explicit or implicit projection alias, when present.
  alias: Option<SqlIdentifier>
}

--- The projection form of a query.
pub type SqlSelection {
  --- Select every field from the primary source.
  SqlSelectAll,
  --- Select an ordered list of expressions.
  SqlSelect(List<SqlProjection>)
}

--- One table source and the optional qualifier introduced for it.
pub type SqlSource {
  --- Table type name; absent only in recovered syntax.
  table: Option<SqlIdentifier>,
  --- Alias used to qualify this source, when present.
  alias: Option<SqlIdentifier>
}

--- An inner join and its recovered or complete predicate.
pub type SqlJoinClause {
  --- Joined table and alias.
  source: SqlSource,
  --- Join predicate evaluated over all sources introduced so far.
  predicate: SqlExpression
}

--- Ordering direction for one expression.
pub type SqlOrderDirection {
  --- Ascending order.
  SqlAscending,
  --- Descending order.
  SqlDescending
}

--- One ordered expression in an `ORDER BY` clause.
pub type SqlOrder {
  --- Expression used as the ordering key.
  expression: SqlExpression,
  --- Direction applied to that key.
  direction: SqlOrderDirection
}

--- A complete or recovered SELECT query.
pub type SqlQuery {
  --- Whether duplicate output rows are removed.
  distinct: bool,
  --- Star or explicit ordered projection.
  selection: SqlSelection,
  --- Primary table source.
  source: SqlSource,
  --- Inner joins in source order.
  joins: List<SqlJoinClause>,
  --- Optional row predicate.
  predicate: Option<SqlExpression>,
  --- Grouping keys in source order.
  groups: List<SqlExpression>,
  --- Optional grouped-result predicate.
  having: Option<SqlExpression>,
  --- Ordering keys in observation order.
  order: List<SqlOrder>,
  --- Optional row limit expression.
  limit: Option<SqlExpression>,
  --- Optional row offset expression.
  offset: Option<SqlExpression>
}

--- SQL syntax paired with the complete retained embedded source range.
pub type SqlSyntax {
  --- Parsed or recovered query value.
  query: SqlQuery,
  --- Complete embedded source range supplied to the grammar.
  span: Span
}
