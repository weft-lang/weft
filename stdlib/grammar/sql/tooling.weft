-- Tool-driven checking for the SQL grammar.
--
-- This module carries the `GrammarTooling` conformance of `SqlGrammar`, so a
-- parse-only consumer of the grammar never compiles the checker or schema
-- code. The SDK manifest names it as the export's tooling module, and a tool
-- driver imports it explicitly.

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{
  Diagnose,
  DiagnosticClassGrammar,
  DiagnosticLocationNone,
  DiagnosticSeverityError
}
use stdlib/file.{FileRead}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql.{SqlGrammar}
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/schema as sql_schema
use stdlib/grammar/sql/schema.{
  SqlSchemaError,
  SqlSchemaReadFailed,
  SqlSchemaJsonInvalid,
  SqlSchemaRootObjectRequired,
  SqlSchemaRootMemberRequired,
  SqlSchemaVersionUnsupported
}
use stdlib/grammar/sql/schema_typecheck as schema_types
use stdlib/grammar/sql/syntax.{SqlSyntax}
use stdlib/grammar/sql/staged as staged
use stdlib/grammar/sql/staged.{SqlPersistentPlan}
use stdlib/grammar/tooling.{*}
use stdlib/grammar/tooling/staging.{*}
use stdlib/bytes as bytes
use stdlib/io/types.{IoError}
use stdlib/json.{Json, JsonEntry, JsonNull, JsonNumber, JsonObject}
use stdlib/list as list
use stdlib/list.{List}
use stdlib/num
use stdlib/path.{Path}
use stdlib/result
use stdlib/result.{Ok, Err, Result}
use stdlib/string.{str_concat}
use stdlib/typecheck.{TypeCheck}

fn schema_failure_message(error: SqlSchemaError) -> str {
  match error {
    SqlSchemaReadFailed(_) -> "SQL schema file could not be read within its limit"
    SqlSchemaJsonInvalid(_) -> "SQL schema file is not a complete JSON document"
    SqlSchemaRootObjectRequired -> "SQL schema root must be an object"
    SqlSchemaRootMemberRequired(member) ->
      str_concat("SQL schema root member is missing or repeated: ", member)
    SqlSchemaVersionUnsupported -> "SQL schema version is not supported"
    _ -> "SQL schema content was rejected"
  }
}

fn report_schema_failure(error: SqlSchemaError) -[Diagnose]> nil {
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      schema_failure_message(error),
      DiagnosticLocationNone
    )
  )
  nil
}

fn outcome_of<I>(result: CheckResult<SqlPlan<I>>) -> GrammarCheckReport {
  match result {
    Checked(_) -> checked_report()
    CheckRejected -> rejected_report()
  }
}

--- Host types answered by the tool, or a schema file interpreted by this
--- package's own schema handler. The checked plan never leaves the package.
impl GrammarTooling for SqlGrammar {
  type Syntax = SqlSyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarHostTypesContext, GrammarFileContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: SqlSyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    outcome_of<ToolTypeIdentity>(sql_check.checker<ToolTypeIdentity>().check(syntax))
  }

  fn check_with_context(
    self,
    syntax: SqlSyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    match sql_schema.load(context, limit) {
      Err(error) -> {
        report_schema_failure(error)
        context_unavailable_report()
      }
      Ok(schema) -> with schema_types(schema) {
        outcome_of<schema_types.SqlSchemaIdentity>(
          sql_check.checker<schema_types.SqlSchemaIdentity>().check(syntax)
        )
      }
    }
  }
}

fn staging_supports() -> List<StagingSupport> {
  let supports = [
    StagingSupport {
      capability: StagingTypedPlan,
      budget: StagingBudget {
        seconds: 5,
        bytes: 4194304.to_usize_checked().expect("SQL staging budget fits usize")
      }
    }
  ]
  list.from_slice(supports[..])
}

fn staging_sink_refused(error: IoError) -> StagingReport {
  StagingReport { outcome: StagingSinkRefused(error), facts: JsonNull }
}

fn staging_facts(plan: SqlPersistentPlan) -> Json {
  let fields = [
    JsonEntry("schema_version", JsonNumber(1)),
    JsonEntry(
      "sources",
      JsonNumber(plan.sources.len().to_u64().to_i64_checked().unwrap_or(0))
    )
  ]
  JsonObject(list.from_slice(fields[..]))
}

fn persist_host(
  syntax: SqlSyntax
) -[TypeCheck<ToolTypeIdentity>, Diagnose]> Result<SqlPersistentPlan, StagingRefusal> {
  match sql_check.checker<ToolTypeIdentity>().check(syntax) {
    CheckRejected -> Err<SqlPersistentPlan, StagingRefusal>(StagingCheckRejected)
    Checked(plan) -> Ok<SqlPersistentPlan, StagingRefusal>(
      staged.persistent<ToolTypeIdentity>(syntax, plan)
    )
  }
}

fn persist_schema(
  syntax: SqlSyntax,
  context: Path,
  limit: usize
) -[FileRead, Diagnose]> Result<SqlPersistentPlan, StagingRefusal> {
  match sql_schema.load(context, limit) {
    Err(error) -> {
      report_schema_failure(error)
      Err<SqlPersistentPlan, StagingRefusal>(StagingContextUnavailable)
    }
    Ok(schema) -> with schema_types(schema) {
      match sql_check.checker<schema_types.SqlSchemaIdentity>().check(syntax) {
        CheckRejected -> Err<SqlPersistentPlan, StagingRefusal>(StagingCheckRejected)
        Checked(plan) -> Ok<SqlPersistentPlan, StagingRefusal>(
          staged.persistent<schema_types.SqlSchemaIdentity>(syntax, plan)
        )
      }
    }
  }
}

impl GrammarStaging for SqlGrammar {
  type Syntax = SqlSyntax
  type Persistent = SqlPersistentPlan

  fn stagings(self) -> List<StagingSupport> { staging_supports() }

  fn persist(
    self,
    syntax: SqlSyntax,
    context: StagingContext
  ) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<
    SqlPersistentPlan,
    StagingRefusal
  > {
    match context {
      StagingHostTypes -> persist_host(syntax)
      StagingFileContext(context_path, limit) -> persist_schema(syntax, context_path, limit)
    }
  }

  fn emit(
    self,
    plan: SqlPersistentPlan,
    target: StagingTarget
  ) -[StagingSink, Diagnose]> StagingReport {
    if target.platform != "macos-aarch64" and target.platform != "linux-aarch64" {
      StagingReport { outcome: StagingUnsupportedTarget, facts: JsonNull }
    } else {
      match StagingSink.emit(bytes.from_str(staged.encode(plan))) {
        Err(error) -> staging_sink_refused(error)
        Ok(_) -> StagingReport { outcome: StagingEmitted, facts: staging_facts(plan) }
      }
    }
  }
}
