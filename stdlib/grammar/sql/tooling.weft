-- Tool-driven checking for the SQL grammar.
--
-- This module carries the `GrammarTooling` conformance of `SqlGrammar`, so a
-- parse-only consumer of the grammar never compiles the checker or schema
-- code. The SDK manifest names it as the export's tooling module, and a tool
-- driver imports it explicitly.

use stdlib/diagnostic as diagnostic
use stdlib/diagnostic/schema.{
  Diagnose,
  DiagnosticClassGrammar,
  DiagnosticLocationNone,
  DiagnosticSeverityError
}
use stdlib/file.{FileRead}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql.{SqlGrammar}
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/schema as sql_schema
use stdlib/grammar/sql/schema.{
  SqlSchemaError,
  SqlSchemaReadFailed,
  SqlSchemaJsonInvalid,
  SqlSchemaRootObjectRequired,
  SqlSchemaRootMemberRequired,
  SqlSchemaVersionUnsupported
}
use stdlib/grammar/sql/schema_typecheck as schema_types
use stdlib/grammar/sql/syntax.{SqlSyntax}
use stdlib/grammar/tooling.{*}
use stdlib/list as list
use stdlib/list.{List}
use stdlib/path.{Path}
use stdlib/result.{Ok, Err}
use stdlib/string.{str_concat}
use stdlib/typecheck.{TypeCheck}

fn schema_failure_message(error: SqlSchemaError) -> str {
  match error {
    SqlSchemaReadFailed(_) -> "SQL schema file could not be read within its limit"
    SqlSchemaJsonInvalid(_) -> "SQL schema file is not a complete JSON document"
    SqlSchemaRootObjectRequired -> "SQL schema root must be an object"
    SqlSchemaRootMemberRequired(member) ->
      str_concat("SQL schema root member is missing or repeated: ", member)
    SqlSchemaVersionUnsupported -> "SQL schema version is not supported"
    _ -> "SQL schema content was rejected"
  }
}

fn report_schema_failure(error: SqlSchemaError) -[Diagnose]> nil {
  Diagnose.report(
    diagnostic.uncoded(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      schema_failure_message(error),
      DiagnosticLocationNone
    )
  )
  nil
}

fn outcome_of<I>(result: CheckResult<SqlPlan<I>>) -> GrammarCheckReport {
  match result {
    Checked(_) -> checked_report()
    CheckRejected -> rejected_report()
  }
}

--- Host types answered by the tool, or a schema file interpreted by this
--- package's own schema handler. The checked plan never leaves the package.
impl GrammarTooling for SqlGrammar {
  type Syntax = SqlSyntax

  fn contexts(self) -> List<GrammarContextKind> {
    let kinds = [GrammarHostTypesContext, GrammarFileContext]
    list.from_slice(kinds[..])
  }

  fn check_with_host(
    self,
    syntax: SqlSyntax
  ) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckReport {
    outcome_of<ToolTypeIdentity>(sql_check.checker<ToolTypeIdentity>().check(syntax))
  }

  fn check_with_context(
    self,
    syntax: SqlSyntax,
    context: Path,
    limit: usize
  ) -[FileRead, Diagnose]> GrammarCheckReport {
    match sql_schema.load(context, limit) {
      Err(error) -> {
        report_schema_failure(error)
        context_unavailable_report()
      }
      Ok(schema) -> with schema_types(schema) {
        outcome_of<schema_types.SqlSchemaIdentity>(
          sql_check.checker<schema_types.SqlSchemaIdentity>().check(syntax)
        )
      }
    }
  }
}
