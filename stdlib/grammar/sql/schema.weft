-- Versioned SQL schemas loaded through ordinary bounded FileRead authority.

use stdlib/file as file
use stdlib/file.{FileRead}
use stdlib/io/types.{IoTextError}
use stdlib/json as json
use stdlib/json.{Json, JsonEntry, JsonObject, JsonNumber, JsonString, JsonParseError}
use stdlib/list as list
use stdlib/list.{List, Cons, Nil}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}

--- A scalar field type supported by checked SQL schemas.
pub type SqlSchemaType {
  --- The host `i64` value set.
  SqlSchemaInteger,
  --- The host `str` value set.
  SqlSchemaText,
  --- The host `bool` value set.
  SqlSchemaBoolean
}

--- One ordered field in a schema table.
pub type SqlSchemaField {
  --- The non-empty field name used by SQL resolution.
  name: str,
  --- The field's exact supported scalar type.
  value: SqlSchemaType
}

--- Fields in schema declaration order.
pub type SqlSchemaFields = List<SqlSchemaField>

--- One named record-shaped SQL source.
pub type SqlSchemaTable {
  --- The non-empty table name used by SQL resolution.
  name: str,
  --- Its non-empty, uniquely named ordered fields.
  fields: SqlSchemaFields
}

--- Tables in schema declaration order.
pub type SqlSchemaTables = List<SqlSchemaTable>

--- A checked version-one SQL schema.
pub type SqlSchema {
  --- Ordered tables available to SQL checking.
  tables: SqlSchemaTables
}

--- Why schema acquisition or validation failed.
pub type SqlSchemaError {
  --- Bounded file acquisition or UTF-8 validation failed.
  SqlSchemaReadFailed(IoTextError),
  --- The file was UTF-8 but not a complete JSON document.
  SqlSchemaJsonInvalid(JsonParseError),
  --- The document root must be an object.
  SqlSchemaRootObjectRequired,
  --- A required root member is missing or repeated.
  SqlSchemaRootMemberRequired(str),
  --- The only accepted schema version is one.
  SqlSchemaVersionUnsupported,
  --- The `tables` member must be an object.
  SqlSchemaTablesObjectRequired,
  --- A table name must not be empty.
  SqlSchemaTableNameEmpty,
  --- A table name occurs more than once.
  SqlSchemaTableRepeated(str),
  --- The named table must contain an object of fields.
  SqlSchemaTableObjectRequired(str),
  --- A table must declare at least one field.
  SqlSchemaTableEmpty(str),
  --- A field name must not be empty.
  SqlSchemaFieldNameEmpty(str),
  --- A field name occurs more than once in one table.
  SqlSchemaFieldRepeated(str, str),
  --- A field type must be the string `i64`, `str`, or `bool`.
  SqlSchemaFieldTypeUnsupported(str, str)
}

fn sql_schema_entry_count(entries: List<JsonEntry>, wanted: str) -> usize {
  match entries {
    Nil -> {
      let zero: usize = 0
      zero
    }
    Cons(entry, rest) -> {
      let here: usize = if entry.key() == wanted { 1 } else { 0 }
      here + sql_schema_entry_count(rest, wanted)
    }
  }
}

fn sql_schema_entry(entries: List<JsonEntry>, wanted: str) -> Json {
  match entries {
    Cons(entry, rest) -> if entry.key() == wanted { entry.value() }
      else { sql_schema_entry(rest, wanted) }
    Nil -> JsonObject(Nil<JsonEntry>())
  }
}

fn sql_schema_type(table: str, field: str, value: Json) -> Result<SqlSchemaType, SqlSchemaError> {
  match value {
    JsonString(name) -> if name == "i64" {
      Ok<SqlSchemaType, SqlSchemaError>(SqlSchemaInteger)
    } else if name == "str" {
      Ok<SqlSchemaType, SqlSchemaError>(SqlSchemaText)
    } else if name == "bool" {
      Ok<SqlSchemaType, SqlSchemaError>(SqlSchemaBoolean)
    } else {
      Err<SqlSchemaType, SqlSchemaError>(SqlSchemaFieldTypeUnsupported(table, field))
    }
    _ -> Err<SqlSchemaType, SqlSchemaError>(SqlSchemaFieldTypeUnsupported(table, field))
  }
}

fn sql_schema_field_exists(fields: SqlSchemaFields, wanted: str) -> bool {
  match fields {
    Nil -> false
    Cons(field, rest) -> field.name == wanted or sql_schema_field_exists(rest, wanted)
  }
}

fn sql_schema_fields(table: str, entries: List<JsonEntry>) -> Result<SqlSchemaFields, SqlSchemaError> {
  let mut reversed = Nil<SqlSchemaField>()
  for entry in entries {
    let name = entry.key()
    if name == "" { return Err<SqlSchemaFields, SqlSchemaError>(SqlSchemaFieldNameEmpty(table)) }
    else if sql_schema_field_exists(reversed, name) {
      return Err<SqlSchemaFields, SqlSchemaError>(SqlSchemaFieldRepeated(table, name))
    } else { nil }
    match sql_schema_type(table, name, entry.value()) {
      Err(error) -> return Err<SqlSchemaFields, SqlSchemaError>(error)
      Ok(value) -> { reversed = Cons(SqlSchemaField { name: name, value: value }, reversed) }
    }
  }
  match reversed {
    Nil -> Err<SqlSchemaFields, SqlSchemaError>(SqlSchemaTableEmpty(table))
    _ -> Ok<SqlSchemaFields, SqlSchemaError>(reversed.reverse())
  }
}

fn sql_schema_table_exists(tables: SqlSchemaTables, wanted: str) -> bool {
  match tables {
    Nil -> false
    Cons(table, rest) -> table.name == wanted or sql_schema_table_exists(rest, wanted)
  }
}

fn sql_schema_tables(entries: List<JsonEntry>) -> Result<SqlSchemaTables, SqlSchemaError> {
  let mut reversed = Nil<SqlSchemaTable>()
  for entry in entries {
    let name = entry.key()
    if name == "" { return Err<SqlSchemaTables, SqlSchemaError>(SqlSchemaTableNameEmpty) }
    else if sql_schema_table_exists(reversed, name) {
      return Err<SqlSchemaTables, SqlSchemaError>(SqlSchemaTableRepeated(name))
    } else { nil }
    match entry.value() {
      JsonObject(fields) -> match sql_schema_fields(name, fields) {
        Err(error) -> return Err<SqlSchemaTables, SqlSchemaError>(error)
        Ok(checked) -> { reversed = Cons(SqlSchemaTable { name: name, fields: checked }, reversed) }
      }
      _ -> return Err<SqlSchemaTables, SqlSchemaError>(SqlSchemaTableObjectRequired(name))
    }
  }
  Ok<SqlSchemaTables, SqlSchemaError>(reversed.reverse())
}

--- Validate one complete version-one JSON schema document.
---
--- The document shape is
--- `{"schema_version":1,"tables":{"users":{"id":"i64"}}}`.
--- Object declaration order becomes table and field order; duplicate names
--- are rejected rather than silently applying first- or last-wins policy.
pub fn parse(source: str) -> Result<SqlSchema, SqlSchemaError> {
  match json.parse(source) {
    Err(error) -> Err<SqlSchema, SqlSchemaError>(SqlSchemaJsonInvalid(error))
    Ok(document) -> match document {
      JsonObject(root) -> {
        if sql_schema_entry_count(root, "schema_version") != 1 {
          Err<SqlSchema, SqlSchemaError>(SqlSchemaRootMemberRequired("schema_version"))
        } else if sql_schema_entry_count(root, "tables") != 1 {
          Err<SqlSchema, SqlSchemaError>(SqlSchemaRootMemberRequired("tables"))
        } else { match sql_schema_entry(root, "schema_version") {
          JsonNumber(1) -> match sql_schema_entry(root, "tables") {
            JsonObject(tables) -> match sql_schema_tables(tables) {
              Err(error) -> Err<SqlSchema, SqlSchemaError>(error)
              Ok(checked) -> Ok<SqlSchema, SqlSchemaError>(SqlSchema { tables: checked })
            }
            _ -> Err<SqlSchema, SqlSchemaError>(SqlSchemaTablesObjectRequired)
          }
          _ -> Err<SqlSchema, SqlSchemaError>(SqlSchemaVersionUnsupported)
        }
        }
      }
      _ -> Err<SqlSchema, SqlSchemaError>(SqlSchemaRootObjectRequired)
    }
  }
}

--- Read, UTF-8 validate, and parse one bounded version-one schema file.
pub fn load(path: Path, limit: usize) -[FileRead]> Result<SqlSchema, SqlSchemaError> {
  match file.read_text(path, limit) {
    Err(error) -> Err<SqlSchema, SqlSchemaError>(SqlSchemaReadFailed(error))
    Ok(source) -> parse(source)
  }
}
