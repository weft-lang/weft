-- TypeCheck interpretation backed by a checked SQL schema value.

use stdlib/grammar/sql/schema.{*}
use stdlib/list as list
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/typecheck.{*}

--- Scoped identities issued by one SQL schema type handler.
pub type SqlSchemaIdentity {
  --- The exact `i64` identity.
  SqlSchemaIntegerIdentity,
  --- The exact `str` identity.
  SqlSchemaTextIdentity,
  --- The exact `bool` identity.
  SqlSchemaBooleanIdentity,
  --- One record-shaped table identity.
  SqlSchemaTableIdentity(SqlSchemaTable)
}

fn sql_schema_type_identity(value: SqlSchemaType) -> SqlSchemaIdentity {
  match value {
    SqlSchemaInteger -> SqlSchemaIntegerIdentity
    SqlSchemaText -> SqlSchemaTextIdentity
    SqlSchemaBoolean -> SqlSchemaBooleanIdentity
  }
}

fn sql_schema_type_description(value: SqlSchemaType) -> SemanticTypeFact {
  match value {
    SqlSchemaInteger -> SemanticTypePrimitive("i64")
    SqlSchemaText -> SemanticTypePrimitive("str")
    SqlSchemaBoolean -> SemanticTypePrimitive("bool")
  }
}

fn sql_schema_resolved_type(value: SqlSchemaType) -> ResolvedType<SqlSchemaIdentity> {
  ResolvedType {
    identity: sql_schema_type_identity(value),
    description: sql_schema_type_description(value)
  }
}

fn sql_schema_semantic_fields(fields: SqlSchemaFields, position: i64) -> SemanticRecordFieldFactList {
  match fields {
    Nil -> SemanticRecordFieldFactListNil
    Cons(field, rest) -> SemanticRecordFieldFactListCons(
      SemanticRecordField(field.name, position, sql_schema_type_description(field.value)),
      sql_schema_semantic_fields(rest, position + 1)
    )
  }
}

fn sql_schema_resolved_table(table: SqlSchemaTable) -> ResolvedType<SqlSchemaIdentity> {
  ResolvedType {
    identity: SqlSchemaTableIdentity(table),
    description: SemanticTypeRecord(sql_schema_semantic_fields(table.fields, 0), false, false)
  }
}

fn sql_schema_find_table(tables: SqlSchemaTables, name: str) -> Result<SqlSchemaTable, TypeQueryError> {
  match tables {
    Nil -> Err<SqlSchemaTable, TypeQueryError>(TypeNotFound)
    Cons(table, rest) -> if table.name == name {
      Ok<SqlSchemaTable, TypeQueryError>(table)
    } else {
      sql_schema_find_table(rest, name)
    }
  }
}

fn sql_schema_find_field(fields: SqlSchemaFields, name: str) -> Result<ResolvedType<SqlSchemaIdentity>, TypeQueryError> {
  match fields {
    Nil -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(TypeFieldNotFound)
    Cons(field, rest) -> if field.name == name {
      Ok<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(sql_schema_resolved_type(field.value))
    } else {
      sql_schema_find_field(rest, name)
    }
  }
}

fn sql_schema_type_same(left: SqlSchemaType, right: SqlSchemaType) -> bool {
  match (left, right) {
    (SqlSchemaInteger, SqlSchemaInteger) -> true
    (SqlSchemaText, SqlSchemaText) -> true
    (SqlSchemaBoolean, SqlSchemaBoolean) -> true
    _ -> false
  }
}

fn sql_schema_fields_same(left: SqlSchemaFields, right: SqlSchemaFields) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(left_field, left_rest), Cons(right_field, right_rest)) ->
      left_field.name == right_field.name and
      sql_schema_type_same(left_field.value, right_field.value) and
      sql_schema_fields_same(left_rest, right_rest)
    _ -> false
  }
}

fn sql_schema_table_same(left: SqlSchemaTable, right: SqlSchemaTable) -> bool {
  left.name == right.name and sql_schema_fields_same(left.fields, right.fields)
}

fn sql_schema_resolve(schema: SqlSchema, request: TypeName<SqlSchemaIdentity>) -> Result<ResolvedType<SqlSchemaIdentity>, TypeQueryError> {
  match request.qualifier {
    Some(_) -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(TypeNotFound)
    None -> if not request.arguments.is_empty() {
      Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(TypeArgumentCount(0, request.arguments.len()))
    } else if request.name == "i64" {
      Ok<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(sql_schema_resolved_type(SqlSchemaInteger))
    } else if request.name == "str" {
      Ok<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(sql_schema_resolved_type(SqlSchemaText))
    } else if request.name == "bool" {
      Ok<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(sql_schema_resolved_type(SqlSchemaBoolean))
    } else {
      match sql_schema_find_table(schema.tables, request.name) {
        Err(error) -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(error)
        Ok(table) -> Ok<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(sql_schema_resolved_table(table))
      }
    }
  }
}

fn sql_schema_table_in_scope(schema: SqlSchema, table: SqlSchemaTable) -> Result<SqlSchemaTable, TypeQueryError> {
  match sql_schema_find_table(schema.tables, table.name) {
    Ok(current) -> if sql_schema_table_same(current, table) {
      Ok<SqlSchemaTable, TypeQueryError>(current)
    } else {
      Err<SqlSchemaTable, TypeQueryError>(ForeignTypeIdentity)
    }
    Err(_) -> Err<SqlSchemaTable, TypeQueryError>(ForeignTypeIdentity)
  }
}

fn sql_schema_field(schema: SqlSchema, identity: SqlSchemaIdentity, field: TypeField) -> Result<ResolvedType<SqlSchemaIdentity>, TypeQueryError> {
  match identity {
    SqlSchemaTableIdentity(table) -> match sql_schema_table_in_scope(schema, table) {
      Err(error) -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(error)
      Ok(current) -> match field {
        NamedTypeField(name) -> sql_schema_find_field(current.fields, name)
        PositionalTypeField(_) -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(TypeFieldNotFound)
      }
    }
    _ -> Err<ResolvedType<SqlSchemaIdentity>, TypeQueryError>(TypeFieldsUnavailable)
  }
}

fn sql_schema_resolved_fields(fields: SqlSchemaFields) -> List<ResolvedField<SqlSchemaIdentity>> {
  let mut reversed = Nil<ResolvedField<SqlSchemaIdentity>>()
  for field in fields {
    reversed = Cons(ResolvedField {
      selector: NamedTypeField(field.name),
      value: sql_schema_resolved_type(field.value)
    }, reversed)
  }
  reversed.reverse()
}

fn sql_schema_fields(schema: SqlSchema, identity: SqlSchemaIdentity) -> Result<List<ResolvedField<SqlSchemaIdentity>>, TypeQueryError> {
  match identity {
    SqlSchemaTableIdentity(table) -> match sql_schema_table_in_scope(schema, table) {
      Err(error) -> Err<List<ResolvedField<SqlSchemaIdentity>>, TypeQueryError>(error)
      Ok(current) -> Ok<List<ResolvedField<SqlSchemaIdentity>>, TypeQueryError>(sql_schema_resolved_fields(current.fields))
    }
    _ -> Err<List<ResolvedField<SqlSchemaIdentity>>, TypeQueryError>(TypeFieldsUnavailable)
  }
}

fn sql_schema_identity_in_scope(schema: SqlSchema, identity: SqlSchemaIdentity) -> bool {
  match identity {
    SqlSchemaIntegerIdentity -> true
    SqlSchemaTextIdentity -> true
    SqlSchemaBooleanIdentity -> true
    SqlSchemaTableIdentity(table) -> match sql_schema_table_in_scope(schema, table) {
      Ok(_) -> true
      Err(_) -> false
    }
  }
}

fn sql_schema_identity_same(left: SqlSchemaIdentity, right: SqlSchemaIdentity) -> bool {
  match (left, right) {
    (SqlSchemaIntegerIdentity, SqlSchemaIntegerIdentity) -> true
    (SqlSchemaTextIdentity, SqlSchemaTextIdentity) -> true
    (SqlSchemaBooleanIdentity, SqlSchemaBooleanIdentity) -> true
    (SqlSchemaTableIdentity(left_table), SqlSchemaTableIdentity(right_table)) -> left_table.name == right_table.name
    _ -> false
  }
}

--- Interpret host type queries from one checked SQL schema value.
pub implements TypeCheck<SqlSchemaIdentity>(schema: SqlSchema) {
  TypeCheck<SqlSchemaIdentity>.resolve(request) -> resume(sql_schema_resolve(schema, request))
  TypeCheck<SqlSchemaIdentity>.field(base, field) -> resume(sql_schema_field(schema, base, field))
  TypeCheck<SqlSchemaIdentity>.fields(base) -> resume(sql_schema_fields(schema, base))
  TypeCheck<SqlSchemaIdentity>.subtype(actual, expected) -> if sql_schema_identity_in_scope(schema, actual) and sql_schema_identity_in_scope(schema, expected) {
    resume(Ok<bool, TypeQueryError>(sql_schema_identity_same(actual, expected)))
  } else {
    resume(Err<bool, TypeQueryError>(ForeignTypeIdentity))
  }
}
