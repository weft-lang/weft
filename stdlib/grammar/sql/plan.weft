-- Checked relational plans produced by the first-party SQL grammar.

use stdlib/grammar/sql/syntax.{SqlAggregateKind, SqlComparisonOperator, SqlIdentifier, SqlLogicalOperator, SqlOrderDirection, SqlScalarOperator}
use stdlib/list.{List}
use stdlib/option.{Option}
use stdlib/semantic_type.{SemanticTypeFact}
use stdlib/source.{Span}
use stdlib/typecheck.{ResolvedField, ResolvedType}

--- Ordered host fields retained for one SQL source.
pub type SqlPlanFields<I> = List<ResolvedField<I>>

--- One resolved table input in a checked SQL plan.
pub type SqlPlanSource<I> {
  --- Zero-based source position; the primary source is zero.
  position: usize,
  --- Table name from the query.
  table: SqlIdentifier,
  --- Optional qualifier introduced by the query.
  alias: Option<SqlIdentifier>,
  --- Host row identity and stable type description.
  row: ResolvedType<I>,
  --- Host fields in declared semantic order.
  fields: SqlPlanFields<I>
}

--- Resolved SQL sources in query order.
pub type SqlPlanSources<I> = List<SqlPlanSource<I>>

--- A column bound unambiguously to one resolved source.
pub type SqlColumnBinding<I> {
  --- Source containing the selected field.
  source: SqlPlanSource<I>,
  --- Field name from the query.
  field: SqlIdentifier,
  --- Zero-based position in the source's ordered host fields.
  position: usize,
  --- Host field identity and stable type description.
  value: ResolvedType<I>
}

--- A typed expression understood by SQL plan interpreters.
pub type SqlPlanExpression<I> {
  --- Read one bound source field.
  SqlPlanColumn(SqlColumnBinding<I>),
  --- Produce a typed integer literal.
  SqlPlanIntegerLiteral(i64, ResolvedType<I>, Span),
  --- Produce a typed string literal.
  SqlPlanStringLiteral(str, ResolvedType<I>, Span),
  --- Produce a typed boolean literal.
  SqlPlanBooleanLiteral(bool, ResolvedType<I>, Span),
  --- Apply a checked scalar operator.
  SqlPlanScalarExpression(SqlScalarOperator, SqlPlanExpression<I>, SqlPlanExpression<I>, ResolvedType<I>),
  --- Apply a checked comparison operator.
  SqlPlanComparisonExpression(SqlComparisonOperator, SqlPlanExpression<I>, SqlPlanExpression<I>, ResolvedType<I>),
  --- Apply a checked boolean operator.
  SqlPlanLogicalExpression(SqlLogicalOperator, SqlPlanExpression<I>, SqlPlanExpression<I>, ResolvedType<I>),
  --- Apply a checked aggregate; no argument represents `count(*)`.
  SqlPlanAggregateExpression(SqlAggregateKind, Option<SqlPlanExpression<I>>, ResolvedType<I>, Span)
}

--- Checked expressions in semantic observation order.
pub type SqlPlanExpressions<I> = List<SqlPlanExpression<I>>

impl<I> SqlPlanExpression<I> {
  --- Return the retained diagnostic anchor for this expression.
  --- Compound expressions use their first operand's origin; expanded aliases
  --- retain the origin of the expression they name.
  pub fn origin(self) -> Span {
    match self {
      SqlPlanColumn(binding) -> binding.field.span
      SqlPlanIntegerLiteral(_, _, span) -> span
      SqlPlanStringLiteral(_, _, span) -> span
      SqlPlanBooleanLiteral(_, _, span) -> span
      SqlPlanScalarExpression(_, left, _, _) -> left.origin()
      SqlPlanComparisonExpression(_, left, _, _) -> left.origin()
      SqlPlanLogicalExpression(_, left, _, _) -> left.origin()
      SqlPlanAggregateExpression(_, _, _, span) -> span
    }
  }
}

--- One typed output expression and its optional name.
pub type SqlPlanProjection<I> {
  --- Checked expression evaluated for this output field.
  expression: SqlPlanExpression<I>,
  --- Explicit query alias, when present.
  alias: Option<SqlIdentifier>
}

--- Explicit projected fields in output order.
pub type SqlPlanProjections<I> = List<SqlPlanProjection<I>>

--- Projection selected by a checked plan.
pub type SqlPlanSelection<I> {
  --- Preserve the primary host row as the output row.
  SqlPlanSelectAll(SqlPlanSource<I>),
  --- Construct an ordered output row from typed expressions.
  SqlPlanSelect(SqlPlanProjections<I>)
}

--- One checked inner join.
pub type SqlPlanJoin<I> {
  --- Resolved source introduced by the join.
  source: SqlPlanSource<I>,
  --- Boolean predicate evaluated for the join.
  predicate: SqlPlanExpression<I>
}

--- Checked inner joins in source order.
pub type SqlPlanJoins<I> = List<SqlPlanJoin<I>>

--- One checked ordering key.
pub type SqlPlanOrder<I> {
  --- Typed expression producing the ordering key.
  expression: SqlPlanExpression<I>,
  --- Observation direction for equal-prefix rows.
  direction: SqlOrderDirection
}

--- Checked ordering keys in observation order.
pub type SqlPlanOrders<I> = List<SqlPlanOrder<I>>

--- One field in the plan's stable output description.
pub type SqlOutputField {
  --- Alias or source-column name, when the query supplies one.
  name: Option<str>,
  --- Stable host type description of the produced value.
  value: SemanticTypeFact
}

--- Ordered fields in a structural SQL output row.
pub type SqlOutputFields = List<SqlOutputField>

--- Output row shape without exposing compiler type storage.
pub type SqlOutputShape {
  --- The primary source row is preserved by `SELECT *`.
  SqlOutputSource(SemanticTypeFact),
  --- An ordered structural row is constructed by explicit projection.
  SqlOutputRecord(SqlOutputFields)
}

--- Null policy fixed by this initial executable plan contract.
pub type SqlNullSemantics {
  --- Nullable inputs are rejected until three-valued predicates are supported.
  SqlNullsRejected
}

pub(package) type SqlPlanParts<I> {
  --- Whether duplicate output rows are removed.
  distinct: bool,
  --- Primary host row input.
  source: SqlPlanSource<I>,
  --- Checked inner joins in source order.
  joins: SqlPlanJoins<I>,
  --- Star or explicit typed projection.
  selection: SqlPlanSelection<I>,
  --- Optional pre-group row predicate.
  predicate: Option<SqlPlanExpression<I>>,
  --- Checked grouping keys.
  groups: SqlPlanExpressions<I>,
  --- Optional grouped-result predicate.
  having: Option<SqlPlanExpression<I>>,
  --- Checked ordering keys in observation order.
  order: SqlPlanOrders<I>,
  --- Optional checked row limit.
  limit: Option<SqlPlanExpression<I>>,
  --- Optional checked row offset.
  offset: Option<SqlPlanExpression<I>>,
  --- Stable output shape for downstream tools and interpreters.
  output: SqlOutputShape,
  --- Explicit null policy used while checking this plan.
  nulls: SqlNullSemantics
}

--- A checked relational plan ready for interpretation or lowering.
---
--- Construction is sealed to the grammar checker, so every public plan has
--- resolved sources, valid expression types, legal grouping and constant
--- paging expressions. Interpreters consume this value without re-checking it.
pub type SqlPlan<I> = opaque SqlPlanParts<I>

pub(package) fn checked_plan<I>(parts: SqlPlanParts<I>) -> SqlPlan<I> {
  SqlPlan<I>(parts)
}

impl<I> SqlPlan<I> {
  --- Return whether duplicate output rows are removed.
  pub fn is_distinct(self) -> bool { match self { SqlPlan(parts) -> parts.distinct } }

  --- Return the primary host row input.
  pub fn source(self) -> SqlPlanSource<I> { match self { SqlPlan(parts) -> parts.source } }

  --- Return checked inner joins in source order.
  pub fn joins(self) -> SqlPlanJoins<I> { match self { SqlPlan(parts) -> parts.joins } }

  --- Return the checked projection.
  pub fn selection(self) -> SqlPlanSelection<I> { match self { SqlPlan(parts) -> parts.selection } }

  --- Return the optional pre-group row predicate.
  pub fn predicate(self) -> Option<SqlPlanExpression<I>> { match self { SqlPlan(parts) -> parts.predicate } }

  --- Return checked grouping keys.
  pub fn groups(self) -> SqlPlanExpressions<I> { match self { SqlPlan(parts) -> parts.groups } }

  --- Return the optional grouped-result predicate.
  pub fn having(self) -> Option<SqlPlanExpression<I>> { match self { SqlPlan(parts) -> parts.having } }

  --- Return checked ordering keys in observation order.
  pub fn order(self) -> SqlPlanOrders<I> { match self { SqlPlan(parts) -> parts.order } }

  --- Return the optional checked row limit.
  pub fn limit(self) -> Option<SqlPlanExpression<I>> { match self { SqlPlan(parts) -> parts.limit } }

  --- Return the optional checked row offset.
  pub fn offset(self) -> Option<SqlPlanExpression<I>> { match self { SqlPlan(parts) -> parts.offset } }

  --- Return the stable output shape.
  pub fn output(self) -> SqlOutputShape { match self { SqlPlan(parts) -> parts.output } }

  --- Return the null policy fixed while checking.
  pub fn null_semantics(self) -> SqlNullSemantics { match self { SqlPlan(parts) -> parts.nulls } }
}
