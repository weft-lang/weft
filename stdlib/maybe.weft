-- stdlib/maybe.weft — Maybe effect for nullable value chaining
--
-- The Maybe effect represents the absence of a value. Functions that
-- may produce nothing declare -[Maybe]> in their effect signature.
-- Handlers provide a default:
--
--   handle get_nested_value() {
--     Maybe.none() -> default_value
--   }
--
-- The ?. operator (when implemented) desugars to Maybe.none().

use "stdlib/option.weft"

effect Maybe {
  fn none() -> i64
}

-- try_option (Maybe -> Option conversion) was REMOVED 2026-08-03 for the
-- same reason as try_result (stdlib/fail.weft): tier 2 has no abort edge,
-- so `handle Some(f()) { Maybe.none() -> None() }` produced Some(None())
-- whenever the perform inside f was not in tail position of the handle
-- body. The generic replacement lands with brief 4j + 4c phase F:
--   fn try_option<T>(f: () -[Maybe]> T) -> Option<T> {
--     handle f() {
--       Maybe.none() -> None()
--       return v -> Some(v)
--     }
--   }
