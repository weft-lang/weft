-- stdlib/maybe.weft — Maybe effect for nullable value chaining
--
-- The Maybe effect represents the absence of a value. Functions that
-- may produce nothing declare -[Maybe]> in their effect signature.
-- Handlers provide a default:
--
--   handle get_nested_value() {
--     Maybe.none() -> default_value
--   }
--
-- The ?. operator desugars to Maybe.none().

use stdlib/option.{*}

pub effect Maybe {
  fn none() -> never
}

pub fn try_option<T>(f: () -[Maybe]> T) -> Option<T> {
  handle f() {
    Maybe.none() -> None<T>()
    return value -> Some<T>(value)
  }
}
