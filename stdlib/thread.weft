-- stdlib/thread.weft -- Threading via libSystem pthread
--
-- Provides spawn/join for parallel execution.
-- This file provides strict stdlib facades over trusted runtime helpers that
-- decode pre-resolved function pointers.

use runtime/thread.{*}

-- Extract the real function address from a Weft closure pair.
-- Weft function values are [thunk_ptr, env_ptr]. The thunk has 7 MOV
-- instructions (shifting args) + 1 B instruction (branch to real fn).
-- The B at thunk+28 encodes a PC-relative offset: target = PC + imm26*4.
pub fn fn_addr(closure: (i64) -> i64) -> i64 {
  runtime_fn_addr(closure)
}

pub fn fn_thunk_insn(closure: (i64) -> i64) -> i64 {
  runtime_fn_thunk_insn(closure)
}

pub fn fn_addr_unsafe(closure: (i64) -[Unsafe]> i64) -> i64 {
  runtime_fn_addr_unsafe(closure)
}
