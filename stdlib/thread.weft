-- stdlib/thread.weft -- Threading via libSystem pthread
--
-- Provides spawn/join for parallel execution.
-- NOTE: pthread_create/pthread_join must be called via __got_* from the
-- MAIN source file (not from use'd files -- compiler limitation).
-- This file provides helpers that work with pre-resolved function pointers.

-- Extract the real function address from a Weft closure pair.
-- Weft function values are [thunk_ptr, env_ptr]. The thunk has 7 MOV
-- instructions (shifting args) + 1 B instruction (branch to real fn).
-- The B at thunk+28 encodes a PC-relative offset: target = PC + imm26*4.
fn fn_addr(closure: i64) -> i64 {
  let thunk = __mem_load64(closure)
  let b0 = __mem_load8(thunk + 28)
  let b1 = __mem_load8(thunk + 29)
  let b2 = __mem_load8(thunk + 30)
  let b3 = __mem_load8(thunk + 31)
  let insn = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
  let imm26 = insn - insn / 67108864 * 67108864
  let offset = if imm26 >= 33554432 { imm26 - 67108864 } else { imm26 }
  thunk + 28 + offset * 4
}
