-- stdlib/secure_random/deterministic.weft — exact reproducible byte stream

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/num.{num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok}
use stdlib/secure_random.{SecureRandom, SecureRandomError, SecureRandomExhausted, SecureRandomLimitExceeded}
use stdlib/vector.{vector_get_in_bounds, vector_new}
use stdlib/vector/handles.{Vector}

--- An exact non-wrapping deterministic byte stream with hidden cursor state.
pub type Stream = opaque(Bytes, Vector<i64>)

--- Prepare an exact non-wrapping byte stream for deterministic interpretation.
pub fn stream(source: Bytes) -> Stream {
  let cursor: Vector<i64> = vector_new<i64>()
  cursor.push(0)
  Stream((source, cursor))
}

fn count_i64(count: usize) -> i64 {
  match num_u64_to_i64_checked(num_usize_to_u64(count)) {
    Ok(value) -> value
    Err(error) -> 0 - 1
  }
}

fn copy(source: Bytes, start: i64, count: i64) -> Bytes {
  if count == 0 {
    bytes.empty()
  } else {
    let out = vector_new<u8>()
    for i in 0..count {
      match source.get(start + i) {
        Some(value) -> out.push(value)
        None -> 0
      }
    }
    bytes.from_vector(out)
  }
}

--- Interpret SecureRandom through a deterministic sequential byte stream.
--- A request succeeds only when its complete next range exists; failures do
--- not advance the stream.
pub implements SecureRandom(state: Stream) {
  SecureRandom.bytes(count) -> match state {
    Stream((source, cursor)) -> {
      let start = vector_get_in_bounds<i64>(cursor, 0)
      let requested = count_i64(count)
      let available = source.len() - start
      if requested < 0 {
        resume(Err<Bytes, SecureRandomError>(SecureRandomLimitExceeded(count)))
      } else { if requested > available {
        resume(Err<Bytes, SecureRandomError>(SecureRandomExhausted(
          count,
          __i64_to_usize(if available < 0 { 0 } else { available })
        )))
      } else {
        let values = copy(source, start, requested)
        cursor.set(0, start + requested)
        resume(Ok<Bytes, SecureRandomError>(values))
      } }
    }
  }
}
