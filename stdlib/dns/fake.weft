-- stdlib/dns/fake.weft — deterministic local DNS interpretation

use stdlib/dns.{DnsError, DnsFamily, DnsNameNotFound, DnsResolve, dns_candidates_from_addresses}
use stdlib/eq.{Eq}
use stdlib/idna.{DomainName}
use stdlib/net_address.{IpAddress, SocketAddress}
use stdlib/result.{Err, Result}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds}
use stdlib/vector/handles.{Vector}

--- One exact answer in a deterministic resolver configuration.
pub type Record {
  --- Resolve this name to the listed IP addresses in observation order.
  --- IPv6 answers have scope id zero; the request port is applied later.
  Addresses(DomainName, Vector<IpAddress>),
  --- Resolve this name to the supplied typed failure.
  Failure(DomainName, DnsError)
}

--- A snapshotted deterministic resolver configuration.
pub type Resolver = opaque Vector<Record>

fn clone_addresses(addresses: Vector<IpAddress>) -> Vector<IpAddress> {
  let copy = vector.with_capacity<IpAddress>(addresses.len())
  for index in 0..addresses.len() {
    copy.push(vector_get_in_bounds<IpAddress>(addresses, index))
  }
  copy
}

--- Snapshot deterministic records and their address lists.
--- Later records override earlier records for the same exact domain identity.
pub fn from_records(records: Vector<Record>) -> Resolver {
  let snapshot = vector.with_capacity<Record>(records.len())
  for index in 0..records.len() {
    match vector_get_in_bounds<Record>(records, index) {
      Addresses(host, addresses) ->
        snapshot.push(Addresses(host, clone_addresses(addresses)))
      Failure(host, error) -> snapshot.push(Failure(host, error))
    }
  }
  Resolver(snapshot)
}

fn lookup(
  resolver: Resolver,
  host: DomainName,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  match resolver {
    Resolver(records) -> {
      let mut index = records.len() - 1
      while index >= 0 {
        match vector_get_in_bounds<Record>(records, index) {
          Addresses(record_host, addresses) -> {
            if record_host.eq(host) {
              return dns_candidates_from_addresses(addresses, port, family)
            } else { 0 }
          }
          Failure(record_host, error) -> {
            if record_host.eq(host) {
              return Err<Vector<SocketAddress>, DnsError>(error)
            } else { 0 }
          }
        }
        index = index - 1
      }
      Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
    }
  }
}

--- Interpret DNS through a deterministic, fully local resolver.
--- Each successful query receives a fresh independently mutable candidate list.
pub implements DnsResolve(resolver: Resolver) {
  DnsResolve.resolve(host, port, family) ->
    resume(lookup(resolver, host, port, family))
}
