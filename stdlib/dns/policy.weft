-- stdlib/dns/policy.weft — lexical DNS authority narrowing

use stdlib/dns.{DnsError, DnsPolicyDenied, DnsResolve}
use stdlib/eq.{Eq}
use stdlib/idna.{DomainName}
use stdlib/net_address.{SocketAddress}
use stdlib/result.{Err}
use stdlib/vector.{vector_get_in_bounds, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- One exact canonical host and port admitted by a DNS policy.
pub type Target {
  --- Permit this exact `DomainName` identity and port.
  Target(DomainName, u16)
}

--- A snapshotted value policy that can narrow, but never grant, DNS authority.
pub type Policy = opaque Vector<Target>

--- Snapshot an allowlist of exact canonical host-and-port targets.
pub fn allow_only(targets: Vector<Target>) -> Policy {
  let snapshot = vector_with_capacity<Target>(targets.len())
  for index in 0..targets.len() {
    snapshot.push(vector_get_in_bounds<Target>(targets, index))
  }
  Policy(snapshot)
}

fn allows(policy: Policy, host: DomainName, port: u16) -> bool {
  match policy {
    Policy(targets) -> {
      let mut allowed = false
      let mut index = 0
      while index < targets.len() and not allowed {
        match vector_get_in_bounds<Target>(targets, index) {
          Target(target_host, target_port) -> {
            if target_host.eq(host) and target_port == port { allowed = true }
            else { 0 }
          }
        }
        index = index + 1
      }
      allowed
    }
  }
}

--- Narrow DNS authority to an exact snapshotted allowlist.
--- Allowed requests delegate to the enclosing resolver; denied requests do
--- not perform outward and return `DnsPolicyDenied`.
pub implements DnsResolve(policy: Policy) {
  DnsResolve.resolve(host, port, family) -> {
    if allows(policy, host, port) {
      resume(DnsResolve.resolve(host, port, family))
    } else {
      resume(Err<Vector<SocketAddress>, DnsError>(DnsPolicyDenied))
    }
  }
}
