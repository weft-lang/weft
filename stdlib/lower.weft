-- Handler-selected lowering for typed semantic products.

--- Select an interpretation from checked source `S` to semantic product `P`.
---
--- Possessing this effect does not grant source acquisition, diagnostics, or
--- native emission. A handler may interpret, compile, or specialize the same
--- checked source while preserving the operation's product contract.
pub effect Lower<S, P> {
  --- Lower one checked source value under the installed interpretation.
  fn lower(source: S) -> P
}

--- Request the installed lowering interpretation for `source`.
pub fn lower<S, P>(source: S) -[Lower<S, P>]> P {
  Lower.lower(source)
}
