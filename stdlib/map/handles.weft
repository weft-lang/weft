-- stdlib/map/handles.weft -- sealed persistent map and set handle identities
-- The implementation lives in stdlib/map.weft over runtime/map_storage.weft.
-- Declaring the nominal handles in this leaf lets the storage runtime name
-- them without importing the collection module that consumes it.
-- Sealed nominal handle over the trusted persistent CHAMP root. Keys and
-- values occupy one machine word in the trie; the storage bridge carries each
-- concrete type's cleanup kind so managed words own balanced family stakes.

--- An opaque persistent hash map from `K` to `V`.
pub type Map<K, V> { }

--- An opaque persistent hash set of `T`, operated on by `stdlib/set`.
pub type Set<T> { }

pub(package) type MapStorageRegion { }
