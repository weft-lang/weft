-- stdlib/set.weft — Persistent hash set using CHAMP trie
--
-- Built on top of Map: a Set<T> is a Map<T, ()> where values are always 1.
-- Provides membership testing, insertion, and set operations.

use "stdlib/map.weft"
use "stdlib/list.weft"
use "runtime/rc.weft"

-- Create an empty set
fn set_new() -> i64 {
  map_new()
}

-- Insert an element. Returns a new set (persistent).
fn set_add(s: i64, elem: i64) -> i64 {
  map_put(s, elem, 1)
}

-- Check if an element is in the set
fn set_contains(s: i64, elem: i64) -> i64 {
  map_contains(s, elem)
}

-- Build a set from a list
fn set_from_list(list: List<i64>) -> i64 {
  let mut s = set_new()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      let head = list_first_or<i64>(cur, 0)
      s = set_add(s, head)
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  s
}

-- Count elements in a set by iterating a known range
-- (Full iteration requires CHAMP node walking — deferred)
fn set_count_in_range(s: i64, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if set_contains(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

-- Managed persistent set wrapper

fn persistent_set_new() -> rc i64 {
  persistent_map_new()
}

fn persistent_set_root(s: i64) -> i64 {
  persistent_map_root(s)
}

fn persistent_set_add(s: i64, elem: i64) -> rc i64 {
  persistent_map_put(s, elem, 1)
}

fn persistent_set_contains(s: i64, elem: i64) -> i64 {
  persistent_map_contains(s, elem)
}

fn persistent_set_size(s: i64) -> i64 {
  persistent_map_size(s)
}

fn persistent_set_from_list(list: List<i64>) -> rc i64 {
  let mut s: rc i64 = persistent_set_new()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      let head = list_first_or<i64>(cur, 0)
      s = persistent_set_add(s, head)
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  s
}

fn persistent_set_count_in_range(s: i64, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if persistent_set_contains(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}
