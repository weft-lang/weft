-- stdlib/set.weft — Persistent hash set using CHAMP trie
--
-- Built on top of Map: a Set<T> is a Map<T, i64> where values are always 1.
-- Provides membership testing, insertion, and set operations.

use stdlib/map.{*}
use stdlib/list.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use stdlib/iter/protocol.{Collect}
use runtime/map_storage.{*}

--- Construct an empty persistent set whose elements provide stable `Hash` and `Eq`.
pub fn set_new<T: Hash & Eq>() -> Set<T> {
  set_storage_from_map<T>(map_new<T, i64>())
}

impl<T: Hash & Eq> Set<T> {
  --- Return a set containing `elem`, leaving this version unchanged.
  pub fn insert(self, elem: T) -> Set<T> {
    set_storage_from_map<T>(set_storage_map<T>(self).insert(elem, 1))
  }

  --- Return whether `elem` is present.
  pub fn contains(self, elem: T) -> bool {
    set_storage_map<T>(self).contains_key(elem)
  }

  --- Return a set without `elem`, leaving this version unchanged.
  pub fn remove(self, elem: T) -> Set<T> {
    set_storage_from_map<T>(set_storage_map<T>(self).remove(elem))
  }

  --- Return all elements present in either set.
  pub fn union(self, other: Set<T>) -> Set<T> {
    let mut out = self
    let mut values = set_storage_map<T>(other).keys()
    let mut done = 0
    while done == 0 {
      match values {
        Nil -> { done = 1 0 }
        Cons(value, rest) -> {
          out = out.insert(value)
          values = rest
          0
        }
      }
    }
    out
  }

  --- Return the elements present in both sets.
  pub fn intersection(self, other: Set<T>) -> Set<T> {
    let mut out = set_new<T>()
    let mut values = set_storage_map<T>(self).keys()
    let mut done = 0
    while done == 0 {
      match values {
        Nil -> { done = 1 0 }
        Cons(value, rest) -> {
          if other.contains(value) {
            out = out.insert(value)
          } else { 0 }
          values = rest
          0
        }
      }
    }
    out
  }

  --- Return the elements present here but absent from `other`.
  pub fn difference(self, other: Set<T>) -> Set<T> {
    let mut out = self
    let mut values = set_storage_map<T>(other).keys()
    let mut done = 0
    while done == 0 {
      match values {
        Nil -> { done = 1 0 }
        Cons(value, rest) -> {
          out = out.remove(value)
          values = rest
          0
        }
      }
    }
    out
  }
}

-- Count elements in a set by iterating a known range
-- (Full iteration requires CHAMP node walking — deferred)
pub(package) fn set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if s.contains(i) {
      count = count + 1
    } else { 0 }
  }
  count
}

impl<T> Set<T> {
  --- Return the number of distinct elements in this set.
  pub fn len(self) -> i64 {
    set_storage_map<T>(self).len()
  }
}

--- Iterate each set element once in its backing map's stable traversal order.
pub(package) fn set_into_iter<T>(s: Set<T>) -> Iterator<T> {
  let values = set_storage_map<T>(s).keys()
  let producer = () => {
    let mut current = values
    let mut done = 0
    while done == 0 {
      match current {
        Cons(value, rest) -> {
          generator_yield<T>(value)
          current = rest
          0
        }
        Nil -> {
          done = 1
          0
        }
      }
    }
    0
  }
  iter_from_generator<T>(generator_new<T, i64>(producer))
}

impl<T> IntoIterator for Set<T> {
  type Item = T

  fn into_iter(self: Set<T>) -> Iterator<T> {
    set_into_iter<T>(self)
  }
}

impl<T: Hash & Eq> Collect for Set<T> {
  type Item = T

  fn empty() -> Self {
    set_new<T>()
  }

  fn collect_from(self, source: Iterator<T>) -> Self {
    let mut result = self
    let mut done = false
    while not done {
      match iter_next<T>(source) {
        Some(value) -> {
          result = result.insert(value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    result
  }
}

pub(package) fn set_is_promoted<T>(s: Set<T>) -> i64 {
  set_storage_is_promoted<T>(s)
}

pub(package) fn set_promote<T>(s: Set<T>) -> i64 {
  map_promote<T, i64>(set_storage_map<T>(s))
}

-- Managed persistent set wrapper

pub(package) fn persistent_set_new<T: Hash & Eq>() -> Set<T> {
  set_new<T>()
}

pub(package) fn persistent_set_root<T>(s: Set<T>) -> i64 {
  persistent_map_root<T, i64>(set_storage_map<T>(s))
}

pub(package) fn persistent_set_add<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  s.insert(elem)
}

pub(package) fn persistent_set_remove<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  s.remove(elem)
}

pub(package) fn persistent_set_union<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  left.union(right)
}

pub(package) fn persistent_set_intersection<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  left.intersection(right)
}

pub(package) fn persistent_set_difference<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  left.difference(right)
}

pub(package) fn persistent_set_contains<T: Hash & Eq>(s: Set<T>, elem: T) -> bool {
  s.contains(elem)
}

pub(package) fn persistent_set_size<T>(s: Set<T>) -> i64 {
  s.len()
}

pub(package) fn persistent_set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if persistent_set_contains<i64>(s, i) {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn persistent_set_is_promoted<T>(s: Set<T>) -> i64 {
  set_is_promoted<T>(s)
}

pub(package) fn persistent_set_promote<T>(s: Set<T>) -> i64 {
  set_promote<T>(s)
}
