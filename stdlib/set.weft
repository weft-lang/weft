-- stdlib/set.weft — Persistent hash set using CHAMP trie
--
-- Built on top of Map: a Set<T> is a Map<T, i64> where values are always 1.
-- Provides membership testing, insertion, and set operations.

use "stdlib/map.weft"
use "stdlib/list.weft"
use "runtime/map_storage.weft"

-- Create an empty typed set. Elements must provide stable hashing and equality.
fn set_new<T: Hash & Eq>() -> Set<T> {
  set_storage_from_map<T>(map_new<T, i64>())
}

-- Insert an element. Returns a new set (persistent).
fn set_add<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_storage_from_map<T>(map_put<T, i64>(set_storage_map<T>(s), elem, 1))
}

-- Check if an element is in the set
fn set_contains<T: Hash & Eq>(s: Set<T>, elem: T) -> i64 {
  map_contains<T, i64>(set_storage_map<T>(s), elem)
}

-- Build a set from a list
fn set_from_list<T: Hash & Eq>(list: List<T>) -> Set<T> {
  let mut set = set_new<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> { done = 1 0 }
      Cons(elem, rest) -> {
        set = set_add<T>(set, elem)
        cur = rest
        0
      }
    }
  }
  set
}

-- Count elements in a set by iterating a known range
-- (Full iteration requires CHAMP node walking — deferred)
fn set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if set_contains<i64>(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn set_size<T>(s: Set<T>) -> i64 {
  map_size<T, i64>(set_storage_map<T>(s))
}

fn set_is_promoted<T>(s: Set<T>) -> i64 {
  set_storage_is_promoted<T>(s)
}

fn set_promote<T>(s: Set<T>) -> i64 {
  map_promote<T, i64>(set_storage_map<T>(s))
}

-- Managed persistent set wrapper

fn persistent_set_new<T: Hash & Eq>() -> Set<T> {
  set_new<T>()
}

fn persistent_set_root<T>(s: Set<T>) -> i64 {
  persistent_map_root<T, i64>(set_storage_map<T>(s))
}

fn persistent_set_add<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_add<T>(s, elem)
}

fn persistent_set_contains<T: Hash & Eq>(s: Set<T>, elem: T) -> i64 {
  set_contains<T>(s, elem)
}

fn persistent_set_size<T>(s: Set<T>) -> i64 {
  set_size<T>(s)
}

fn persistent_set_from_list<T: Hash & Eq>(list: List<T>) -> Set<T> {
  let mut set = persistent_set_new<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> { done = 1 0 }
      Cons(elem, rest) -> {
        set = persistent_set_add<T>(set, elem)
        cur = rest
        0
      }
    }
  }
  set
}

fn persistent_set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if persistent_set_contains<i64>(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn persistent_set_is_promoted<T>(s: Set<T>) -> i64 {
  set_is_promoted<T>(s)
}

fn persistent_set_promote<T>(s: Set<T>) -> i64 {
  set_promote<T>(s)
}
