-- stdlib/set.weft — Persistent hash set using CHAMP trie
--
-- Built on top of Map: a Set<T> is a Map<T, ()> where values are always 1.
-- Provides membership testing, insertion, and set operations.

use "stdlib/map.weft"
use "stdlib/list.weft"
use "runtime/map_storage.weft"

-- Create an empty set
fn set_new() -> Set<i64> {
  set_storage_from_map<i64>(map_new())
}

-- Insert an element. Returns a new set (persistent).
fn set_add(s: Set<i64>, elem: i64) -> Set<i64> {
  set_storage_from_map<i64>(map_put(set_storage_map<i64>(s), elem, 1))
}

-- Check if an element is in the set
fn set_contains(s: Set<i64>, elem: i64) -> i64 {
  map_contains(set_storage_map<i64>(s), elem)
}

-- Build a set from a list
fn set_from_list(list: List<i64>) -> Set<i64> {
  let mut s: Set<i64> = set_new()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      let head = list_first_or<i64>(cur, 0)
      s = set_add(s, head)
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  s
}

-- Count elements in a set by iterating a known range
-- (Full iteration requires CHAMP node walking — deferred)
fn set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if set_contains(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn set_size(s: Set<i64>) -> i64 {
  map_size(set_storage_map<i64>(s))
}

fn set_is_promoted(s: Set<i64>) -> i64 {
  set_storage_is_promoted<i64>(s)
}

fn set_promote(s: Set<i64>) -> i64 {
  map_promote(set_storage_map<i64>(s))
}

-- Managed persistent set wrapper

fn persistent_set_new() -> Set<i64> {
  set_new()
}

fn persistent_set_root(s: Set<i64>) -> i64 {
  persistent_map_root(set_storage_map<i64>(s))
}

fn persistent_set_add(s: Set<i64>, elem: i64) -> Set<i64> {
  set_add(s, elem)
}

fn persistent_set_contains(s: Set<i64>, elem: i64) -> i64 {
  set_contains(s, elem)
}

fn persistent_set_size(s: Set<i64>) -> i64 {
  set_size(s)
}

fn persistent_set_from_list(list: List<i64>) -> Set<i64> {
  let mut s: Set<i64> = persistent_set_new()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      let head = list_first_or<i64>(cur, 0)
      s = persistent_set_add(s, head)
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  s
}

fn persistent_set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if persistent_set_contains(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn persistent_set_is_promoted(s: Set<i64>) -> i64 {
  set_is_promoted(s)
}

fn persistent_set_promote(s: Set<i64>) -> i64 {
  set_promote(s)
}
