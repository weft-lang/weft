-- stdlib/set.weft — Persistent hash set using CHAMP trie
--
-- Built on top of Map: a Set<T> is a Map<T, i64> where values are always 1.
-- Provides membership testing, insertion, and set operations.

use stdlib/map.{*}
use stdlib/list.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use runtime/map_storage.{*}

--- Construct an empty persistent set whose elements provide stable `Hash` and `Eq`.
pub fn set_new<T: Hash & Eq>() -> Set<T> {
  set_storage_from_map<T>(map_new<T, i64>())
}

--- Return a set containing `elem`, leaving the input version unchanged.
pub fn set_add<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_storage_from_map<T>(map_put<T, i64>(set_storage_map<T>(s), elem, 1))
}

--- Return `1` when `elem` is present and `0` otherwise.
pub fn set_contains<T: Hash & Eq>(s: Set<T>, elem: T) -> i64 {
  map_contains<T, i64>(set_storage_map<T>(s), elem)
}

--- Return a set without `elem`, leaving the input version unchanged.
pub fn set_remove<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_storage_from_map<T>(map_remove<T, i64>(set_storage_map<T>(s), elem))
}

-- Hash-set algebra is expressed through the typed persistent API. Each walk is
-- linear in the visited set and each membership/update keeps CHAMP's bounded
-- hash-trie cost; no nested collection scan is hidden here.
--- Return all elements present in either input set.
pub fn set_union<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  let mut out = left
  let mut values = map_keys<T, i64>(set_storage_map<T>(right))
  let mut done = 0
  while done == 0 {
    match values {
      Nil -> { done = 1 0 }
      Cons(value, rest) -> {
        out = set_add<T>(out, value)
        values = rest
        0
      }
    }
  }
  out
}

--- Return the elements present in both input sets.
pub fn set_intersection<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  let mut out = set_new<T>()
  let mut values = map_keys<T, i64>(set_storage_map<T>(left))
  let mut done = 0
  while done == 0 {
    match values {
      Nil -> { done = 1 0 }
      Cons(value, rest) -> {
        if set_contains<T>(right, value) == 1 {
          out = set_add<T>(out, value)
        } else { 0 }
        values = rest
        0
      }
    }
  }
  out
}

--- Return the elements present in `left` but absent from `right`.
pub fn set_difference<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  let mut out = left
  let mut values = map_keys<T, i64>(set_storage_map<T>(right))
  let mut done = 0
  while done == 0 {
    match values {
      Nil -> { done = 1 0 }
      Cons(value, rest) -> {
        out = set_remove<T>(out, value)
        values = rest
        0
      }
    }
  }
  out
}

--- Build a persistent set from a list, collapsing duplicate elements.
pub fn set_from_list<T: Hash & Eq>(list: List<T>) -> Set<T> {
  let mut set = set_new<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> { done = 1 0 }
      Cons(elem, rest) -> {
        set = set_add<T>(set, elem)
        cur = rest
        0
      }
    }
  }
  set
}

-- Count elements in a set by iterating a known range
-- (Full iteration requires CHAMP node walking — deferred)
pub(package) fn set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if set_contains<i64>(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

--- Return the number of distinct elements in a set.
pub fn set_size<T>(s: Set<T>) -> i64 {
  map_size<T, i64>(set_storage_map<T>(s))
}

--- Iterate each set element once in its backing map's stable traversal order.
pub fn set_into_iter<T>(s: Set<T>) -> Iterator<T> {
  let values = map_keys<T, i64>(set_storage_map<T>(s))
  let producer = () => {
    let mut current = values
    let mut done = 0
    while done == 0 {
      match current {
        Cons(value, rest) -> {
          generator_yield<T>(value)
          current = rest
          0
        }
        Nil -> {
          done = 1
          0
        }
      }
    }
    0
  }
  iter_from_generator<T>(generator_new<T, i64>(producer))
}

impl<T> IntoIterator for Set<T> {
  type Item = T

  fn into_iter(self: Set<T>) -> Iterator<T> {
    set_into_iter<T>(self)
  }
}

pub(package) fn set_is_promoted<T>(s: Set<T>) -> i64 {
  set_storage_is_promoted<T>(s)
}

pub(package) fn set_promote<T>(s: Set<T>) -> i64 {
  map_promote<T, i64>(set_storage_map<T>(s))
}

-- Managed persistent set wrapper

pub(package) fn persistent_set_new<T: Hash & Eq>() -> Set<T> {
  set_new<T>()
}

pub(package) fn persistent_set_root<T>(s: Set<T>) -> i64 {
  persistent_map_root<T, i64>(set_storage_map<T>(s))
}

pub(package) fn persistent_set_add<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_add<T>(s, elem)
}

pub(package) fn persistent_set_remove<T: Hash & Eq>(s: Set<T>, elem: T) -> Set<T> {
  set_remove<T>(s, elem)
}

pub(package) fn persistent_set_union<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  set_union<T>(left, right)
}

pub(package) fn persistent_set_intersection<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  set_intersection<T>(left, right)
}

pub(package) fn persistent_set_difference<T: Hash & Eq>(left: Set<T>, right: Set<T>) -> Set<T> {
  set_difference<T>(left, right)
}

pub(package) fn persistent_set_contains<T: Hash & Eq>(s: Set<T>, elem: T) -> i64 {
  set_contains<T>(s, elem)
}

pub(package) fn persistent_set_size<T>(s: Set<T>) -> i64 {
  set_size<T>(s)
}

pub(package) fn persistent_set_from_list<T: Hash & Eq>(list: List<T>) -> Set<T> {
  let mut set = persistent_set_new<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> { done = 1 0 }
      Cons(elem, rest) -> {
        set = persistent_set_add<T>(set, elem)
        cur = rest
        0
      }
    }
  }
  set
}

pub(package) fn persistent_set_count_in_range(s: Set<i64>, start: i64, end: i64) -> i64 {
  let mut count: i64 = 0
  for i in start..end {
    if persistent_set_contains<i64>(s, i) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn persistent_set_is_promoted<T>(s: Set<T>) -> i64 {
  set_is_promoted<T>(s)
}

pub(package) fn persistent_set_promote<T>(s: Set<T>) -> i64 {
  set_promote<T>(s)
}
