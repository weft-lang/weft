-- stdlib/time.weft - pure duration/instant/date helpers plus Time effect
--
-- Core arithmetic is pure and millisecond-based. Wall-clock access is an
-- explicit effect so tests/tools can install deterministic handlers.

use "stdlib/option.weft"

type Duration {
  Duration(i64)
}

type Instant {
  Instant(i64)
}

type Date {
  Date(i64, i64, i64)
}

effect Time {
  fn now_millis() -> i64
}

fn duration_millis(ms: i64) -> Duration { Duration(ms) }
fn duration_seconds(seconds: i64) -> Duration { Duration(seconds * 1000) }
fn duration_minutes(minutes: i64) -> Duration { duration_seconds(minutes * 60) }
fn duration_hours(hours: i64) -> Duration { duration_minutes(hours * 60) }
fn duration_days(days: i64) -> Duration { duration_hours(days * 24) }

fn duration_to_millis(d: Duration) -> i64 {
  match d { Duration(ms) -> ms }
}

fn duration_to_seconds(d: Duration) -> i64 {
  duration_to_millis(d) / 1000
}

fn duration_add(a: Duration, b: Duration) -> Duration {
  duration_millis(duration_to_millis(a) + duration_to_millis(b))
}

fn duration_sub(a: Duration, b: Duration) -> Duration {
  duration_millis(duration_to_millis(a) - duration_to_millis(b))
}

fn duration_neg(d: Duration) -> Duration {
  duration_millis(0 - duration_to_millis(d))
}

fn duration_cmp(a: Duration, b: Duration) -> i64 {
  let am = duration_to_millis(a)
  let bm = duration_to_millis(b)
  if am < bm { 0 - 1 } else { if am > bm { 1 } else { 0 } }
}

fn duration_clamp(value: Duration, lo: Duration, hi: Duration) -> Duration {
  if duration_cmp(value, lo) < 0 { lo }
  else { if duration_cmp(value, hi) > 0 { hi } else { value } }
}

fn instant_from_millis(ms: i64) -> Instant { Instant(ms) }

fn instant_to_millis(i: Instant) -> i64 {
  match i { Instant(ms) -> ms }
}

fn instant_add(i: Instant, d: Duration) -> Instant {
  instant_from_millis(instant_to_millis(i) + duration_to_millis(d))
}

fn instant_sub(i: Instant, d: Duration) -> Instant {
  instant_from_millis(instant_to_millis(i) - duration_to_millis(d))
}

fn instant_duration_since(later: Instant, earlier: Instant) -> Duration {
  duration_millis(instant_to_millis(later) - instant_to_millis(earlier))
}

fn instant_cmp(a: Instant, b: Instant) -> i64 {
  let am = instant_to_millis(a)
  let bm = instant_to_millis(b)
  if am < bm { 0 - 1 } else { if am > bm { 1 } else { 0 } }
}

fn time_now() -[Time]> Instant {
  instant_from_millis(Time.now_millis())
}

fn date_new(year: i64, month: i64, day: i64) -> Date {
  Date(year, month, day)
}

fn date_year(date: Date) -> i64 {
  match date { Date(year, month, day) -> year }
}

fn date_month(date: Date) -> i64 {
  match date { Date(year, month, day) -> month }
}

fn date_day(date: Date) -> i64 {
  match date { Date(year, month, day) -> day }
}

fn date_is_leap_year(year: i64) -> i64 {
  if year - year / 400 * 400 == 0 { 1 }
  else { if year - year / 100 * 100 == 0 { 0 }
  else { if year - year / 4 * 4 == 0 { 1 } else { 0 } } }
}

fn date_days_in_month(year: i64, month: i64) -> i64 {
  match month {
    1 -> 31
    2 -> if date_is_leap_year(year) == 1 { 29 } else { 28 }
    3 -> 31
    4 -> 30
    5 -> 31
    6 -> 30
    7 -> 31
    8 -> 31
    9 -> 30
    10 -> 31
    11 -> 30
    12 -> 31
    _ -> 0
  }
}

fn date_days_in_year(year: i64) -> i64 {
  if date_is_leap_year(year) == 1 { 366 } else { 365 }
}

fn date_is_valid(year: i64, month: i64, day: i64) -> i64 {
  if month < 1 or month > 12 { 0 }
  else {
    let max_day = date_days_in_month(year, month)
    if day < 1 or day > max_day { 0 } else { 1 }
  }
}

fn date_new_option(year: i64, month: i64, day: i64) -> Option<Date> {
  if date_is_valid(year, month, day) == 1 {
    Some<Date>(Date(year, month, day))
  } else {
    None<Date>()
  }
}

fn date_days_before_year(year: i64) -> i64 {
  let mut days = 0
  if year >= 1970 {
    for y in 1970..year {
      days = days + date_days_in_year(y)
    }
  } else {
    let mut y = year
    while y < 1970 {
      days = days - date_days_in_year(y)
      y = y + 1
    }
  }
  days
}

fn date_to_epoch_day(date: Date) -> i64 {
  let year = date_year(date)
  let month = date_month(date)
  let day = date_day(date)
  let mut days = date_days_before_year(year)
  for m in 1..month {
    days = days + date_days_in_month(year, m)
  }
  days + day - 1
}

fn date_from_epoch_day(epoch_day: i64) -> Date {
  let mut year = 1970
  let mut days = epoch_day
  while days < 0 {
    year = year - 1
    days = days + date_days_in_year(year)
  }
  while days >= date_days_in_year(year) {
    days = days - date_days_in_year(year)
    year = year + 1
  }
  let mut month = 1
  while days >= date_days_in_month(year, month) {
    days = days - date_days_in_month(year, month)
    month = month + 1
  }
  Date(year, month, days + 1)
}

fn date_add_days(date: Date, days: i64) -> Date {
  date_from_epoch_day(date_to_epoch_day(date) + days)
}

-- 0 = Sunday, 1 = Monday, ..., 6 = Saturday.
fn date_day_of_week(date: Date) -> i64 {
  let mut value = date_to_epoch_day(date) + 4
  while value < 0 { value = value + 7 }
  value - value / 7 * 7
}
