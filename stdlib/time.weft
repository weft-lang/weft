-- stdlib/time.weft - pure duration/instant/date helpers plus Time effect
--
-- Core arithmetic is pure and millisecond-based. Wall-clock access is an
-- explicit effect so tests/tools can install deterministic handlers.

use stdlib/option.{*}
use stdlib/ord.{*}

--- A signed duration represented in milliseconds.
pub type Duration {
  --- A duration containing the given signed millisecond count.
  Duration(i64)
}

--- An instant on the clock selected by a `Time` handler.
pub type Instant {
  --- An instant containing the handler's millisecond value.
  Instant(i64)
}

type DateParts {
  year: i64,
  month: i64,
  day: i64
}

--- A valid proleptic Gregorian calendar date.
pub type Date = opaque DateParts

--- A day in the seven-day calendar week.
pub type Weekday {
  Sunday
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

impl Ord for Duration {
  fn compare(self: Self, other: Self) -> Ordering {
    ord_compare<i64>(duration_to_millis(self), duration_to_millis(other))
  }
}

impl Ord for Instant {
  fn compare(self: Self, other: Self) -> Ordering {
    ord_compare<i64>(instant_to_millis(self), instant_to_millis(other))
  }
}

--- Clock reads and sleeping supplied by a program or test handler.
pub effect Time {
  --- Read the handler's current millisecond clock.
  fn now_millis() -> i64
  --- Read the handler's current nanosecond clock.
  fn now_nanos() -> i64
  --- Sleep for `ms` milliseconds under the handler's policy.
  fn sleep_millis(ms: i64) -> i64
}

--- Construct a duration from milliseconds.
pub fn duration_millis(ms: i64) -> Duration { Duration(ms) }
--- Construct a duration from seconds.
pub fn duration_seconds(seconds: i64) -> Duration { Duration(seconds * 1000) }
--- Construct a duration from minutes.
pub fn duration_minutes(minutes: i64) -> Duration { duration_seconds(minutes * 60) }
--- Construct a duration from hours.
pub fn duration_hours(hours: i64) -> Duration { duration_minutes(hours * 60) }
--- Construct a duration from 24-hour days.
pub fn duration_days(days: i64) -> Duration { duration_hours(days * 24) }

--- Return a duration's signed millisecond count.
pub fn duration_to_millis(d: Duration) -> i64 {
  match d { Duration(ms) -> ms }
}

--- Return whole seconds, truncating the millisecond remainder.
pub fn duration_to_seconds(d: Duration) -> i64 {
  duration_to_millis(d) / 1000
}

--- Add two signed durations.
pub fn duration_add(a: Duration, b: Duration) -> Duration {
  duration_millis(duration_to_millis(a) + duration_to_millis(b))
}

--- Subtract `b` from `a`.
pub fn duration_sub(a: Duration, b: Duration) -> Duration {
  duration_millis(duration_to_millis(a) - duration_to_millis(b))
}

--- Negate a signed duration.
pub fn duration_neg(d: Duration) -> Duration {
  duration_millis(0 - duration_to_millis(d))
}

--- Compare durations by signed milliseconds.
pub fn duration_cmp(a: Duration, b: Duration) -> Ordering {
  a.compare(b)
}

--- Clamp a duration to the inclusive range from `lo` to `hi`.
pub fn duration_clamp(value: Duration, lo: Duration, hi: Duration) -> Duration {
  match duration_cmp(value, lo) {
    Less -> lo
    _ -> match duration_cmp(value, hi) {
      Greater -> hi
      _ -> value
    }
  }
}

--- Construct an instant from a handler-defined millisecond value.
pub fn instant_from_millis(ms: i64) -> Instant { Instant(ms) }

--- Return an instant's handler-defined millisecond value.
pub fn instant_to_millis(i: Instant) -> i64 {
  match i { Instant(ms) -> ms }
}

--- Move an instant forward by a signed duration.
pub fn instant_add(i: Instant, d: Duration) -> Instant {
  instant_from_millis(instant_to_millis(i) + duration_to_millis(d))
}

--- Move an instant backward by a signed duration.
pub fn instant_sub(i: Instant, d: Duration) -> Instant {
  instant_from_millis(instant_to_millis(i) - duration_to_millis(d))
}

--- Return the signed duration from `earlier` to `later`.
pub fn instant_duration_since(later: Instant, earlier: Instant) -> Duration {
  duration_millis(instant_to_millis(later) - instant_to_millis(earlier))
}

--- Compare instants by their handler-defined millisecond values.
pub fn instant_cmp(a: Instant, b: Instant) -> Ordering {
  a.compare(b)
}

--- Read the current millisecond clock as an `Instant`.
pub fn time_now() -[Time]> Instant {
  instant_from_millis(Time.now_millis())
}

--- Read the current nanosecond clock value.
pub fn time_now_nanos() -[Time]> i64 {
  Time.now_nanos()
}

-- Returns 0 after sleeping, or -1 for an invalid duration/platform failure.
--- Sleep for milliseconds, returning `0` on success and `-1` on failure.
pub fn time_sleep_millis(ms: i64) -[Time]> i64 {
  Time.sleep_millis(ms)
}

fn date_unchecked(year: i64, month: i64, day: i64) -> Date {
  Date(DateParts { year: year, month: month, day: day })
}

--- Return whether a proleptic Gregorian year is a leap year.
pub fn is_leap_year(year: i64) -> bool {
  if year - year / 400 * 400 == 0 { true }
  else { if year - year / 100 * 100 == 0 { false }
  else { year - year / 4 * 4 == 0 } }
}

fn month_length(year: i64, month: i64) -> i64 {
  match month {
    1 -> 31
    2 -> if is_leap_year(year) { 29 } else { 28 }
    3 -> 31
    4 -> 30
    5 -> 31
    6 -> 30
    7 -> 31
    8 -> 31
    9 -> 30
    10 -> 31
    11 -> 30
    12 -> 31
    _ -> 0
  }
}

--- Return the number of days in a valid one-based month.
pub fn days_in_month(year: i64, month: i64) -> Option<i64> {
  let days = month_length(year, month)
  if days == 0 { None } else { Some<i64>(days) }
}

--- Return 365 or 366 days for a year.
pub fn days_in_year(year: i64) -> i64 {
  if is_leap_year(year) { 366 } else { 365 }
}

fn date_valid(year: i64, month: i64, day: i64) -> bool {
  if month < 1 or month > 12 { false }
  else {
    let max_day = month_length(year, month)
    day >= 1 and day <= max_day
  }
}

--- Construct a date only when the calendar triple is valid.
pub fn date(year: i64, month: i64, day: i64) -> Option<Date> {
  if date_valid(year, month, day) {
    Some<Date>(date_unchecked(year, month, day))
  } else {
    None
  }
}

fn days_before_year(year: i64) -> i64 {
  let mut days = 0
  if year >= 1970 {
    for y in 1970..year {
      days = days + days_in_year(y)
    }
  } else {
    let mut y = year
    while y < 1970 {
      days = days - days_in_year(y)
      y = y + 1
    }
  }
  days
}

--- Convert signed days since 1970-01-01 to a date.
pub fn from_epoch_day(epoch_day: i64) -> Date {
  let mut year = 1970
  let mut days = epoch_day
  while days < 0 {
    year = year - 1
    days = days + days_in_year(year)
  }
  while days >= days_in_year(year) {
    days = days - days_in_year(year)
    year = year + 1
  }
  let mut month = 1
  while days >= month_length(year, month) {
    days = days - month_length(year, month)
    month = month + 1
  }
  date_unchecked(year, month, days + 1)
}

impl Date {
  --- Return the date's year.
  pub fn year(self) -> i64 {
    match self { Date(parts) -> parts.year }
  }

  --- Return the date's one-based month.
  pub fn month(self) -> i64 {
    match self { Date(parts) -> parts.month }
  }

  --- Return the date's one-based day.
  pub fn day(self) -> i64 {
    match self { Date(parts) -> parts.day }
  }

  --- Convert the date to signed days since 1970-01-01.
  pub fn to_epoch_day(self) -> i64 {
    let year = self.year()
    let month = self.month()
    let mut days = days_before_year(year)
    for m in 1..month {
      days = days + month_length(year, m)
    }
    days + self.day() - 1
  }

  --- Add signed calendar days to the date.
  pub fn add_days(self, days: i64) -> Date {
    from_epoch_day(self.to_epoch_day() + days)
  }

  --- Return the date's day in the seven-day calendar week.
  pub fn weekday(self) -> Weekday {
    let mut value = self.to_epoch_day() + 4
    while value < 0 { value = value + 7 }
    match value - value / 7 * 7 {
      0 -> Sunday
      1 -> Monday
      2 -> Tuesday
      3 -> Wednesday
      4 -> Thursday
      5 -> Friday
      _ -> Saturday
    }
  }
}
