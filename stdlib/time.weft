-- stdlib/time.weft - pure duration/instant/date helpers plus Time effect
--
-- Core arithmetic is pure and millisecond-based. Wall-clock access is an
-- explicit effect so tests/tools can install deterministic handlers.

use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/result.{Err, Ok, Result}

--- A signed duration with millisecond precision.
pub type Duration = opaque i64

--- An instant on the clock selected by a `Time` handler.
pub type Instant = opaque i64

type DateParts {
  year: i64,
  month: i64,
  day: i64
}

--- A valid proleptic Gregorian calendar date.
pub type Date = opaque DateParts

--- A day in the seven-day calendar week.
pub type Weekday {
  Sunday
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

--- Why a requested sleep could not complete.
pub type SleepError {
  --- A negative duration cannot be used for sleeping.
  InvalidSleepDuration
  --- The selected Time handler rejected or failed the sleep request.
  SleepFailed(i64)
}

impl Ord for Duration {
  fn compare(self: Self, other: Self) -> Ordering {
    ord_compare<i64>(duration_value(self), duration_value(other))
  }
}

impl Ord for Instant {
  fn compare(self: Self, other: Self) -> Ordering {
    ord_compare<i64>(instant_value(self), instant_value(other))
  }
}

--- Clock reads and sleeping supplied by a program or test handler.
pub effect Time {
  --- Read the handler's current millisecond clock.
  fn now_millis() -> i64
  --- Read the handler's current nanosecond clock.
  fn now_nanos() -> i64
  --- Sleep for `ms` milliseconds under the handler's policy.
  fn sleep_millis(ms: i64) -> i64
}

fn duration_value(duration: Duration) -> i64 {
  match duration { Duration(ms) -> ms }
}

fn instant_value(value: Instant) -> i64 {
  match value { Instant(ms) -> ms }
}

--- Construct a duration from milliseconds.
pub fn milliseconds(value: i64) -> Duration { Duration(value) }
--- Construct a duration from seconds.
pub fn seconds(value: i64) -> Duration { Duration(value * 1000) }
--- Construct a duration from minutes.
pub fn minutes(value: i64) -> Duration { seconds(value * 60) }
--- Construct a duration from hours.
pub fn hours(value: i64) -> Duration { minutes(value * 60) }
--- Construct a duration from 24-hour days.
pub fn days(value: i64) -> Duration { hours(value * 24) }

--- Construct an instant from a handler-defined millisecond value.
pub fn instant(milliseconds: i64) -> Instant { Instant(milliseconds) }

impl Duration {
  --- Return the signed millisecond count.
  pub fn milliseconds(self) -> i64 { duration_value(self) }

  --- Return whole seconds, truncating the millisecond remainder.
  pub fn whole_seconds(self) -> i64 { self.milliseconds() / 1000 }

  --- Add another signed duration.
  pub fn add(self, other: Duration) -> Duration {
    milliseconds(self.milliseconds() + other.milliseconds())
  }

  --- Subtract another signed duration.
  pub fn subtract(self, other: Duration) -> Duration {
    milliseconds(self.milliseconds() - other.milliseconds())
  }

  --- Negate the duration.
  pub fn negate(self) -> Duration {
    milliseconds(0 - self.milliseconds())
  }

  --- Clamp the duration to the inclusive range from `lower` to `upper`.
  pub fn clamp(self, lower: Duration, upper: Duration) -> Duration {
    match self.compare(lower) {
      Less -> lower
      _ -> match self.compare(upper) {
        Greater -> upper
        _ -> self
      }
    }
  }
}

impl Instant {
  --- Return the handler-defined millisecond value.
  pub fn milliseconds(self) -> i64 { instant_value(self) }

  --- Move the instant forward by a signed duration.
  pub fn add(self, duration: Duration) -> Instant {
    instant(self.milliseconds() + duration.milliseconds())
  }

  --- Move the instant backward by a signed duration.
  pub fn subtract(self, duration: Duration) -> Instant {
    instant(self.milliseconds() - duration.milliseconds())
  }

  --- Return the signed duration from `earlier` to this instant.
  pub fn duration_since(self, earlier: Instant) -> Duration {
    milliseconds(self.milliseconds() - earlier.milliseconds())
  }
}

--- Read the current millisecond clock as an `Instant`.
pub fn now() -[Time]> Instant {
  instant(Time.now_millis())
}

--- Read the current nanosecond clock value.
pub fn now_nanos() -[Time]> i64 {
  Time.now_nanos()
}

--- Sleep for a non-negative duration under the selected handler.
pub fn sleep(duration: Duration) -[Time]> Result<nil, SleepError> {
  let milliseconds = duration.milliseconds()
  if milliseconds < 0 {
    Err<nil, SleepError>(InvalidSleepDuration())
  } else {
    let status = Time.sleep_millis(milliseconds)
    if status == 0 {
      Ok<nil, SleepError>(nil)
    } else {
      Err<nil, SleepError>(SleepFailed(status))
    }
  }
}

fn date_unchecked(year: i64, month: i64, day: i64) -> Date {
  Date(DateParts { year: year, month: month, day: day })
}

--- Return whether a proleptic Gregorian year is a leap year.
pub fn is_leap_year(year: i64) -> bool {
  if year - year / 400 * 400 == 0 { true }
  else { if year - year / 100 * 100 == 0 { false }
  else { year - year / 4 * 4 == 0 } }
}

fn month_length(year: i64, month: i64) -> i64 {
  match month {
    1 -> 31
    2 -> if is_leap_year(year) { 29 } else { 28 }
    3 -> 31
    4 -> 30
    5 -> 31
    6 -> 30
    7 -> 31
    8 -> 31
    9 -> 30
    10 -> 31
    11 -> 30
    12 -> 31
    _ -> 0
  }
}

--- Return the number of days in a valid one-based month.
pub fn days_in_month(year: i64, month: i64) -> Option<i64> {
  let days = month_length(year, month)
  if days == 0 { None } else { Some<i64>(days) }
}

--- Return 365 or 366 days for a year.
pub fn days_in_year(year: i64) -> i64 {
  if is_leap_year(year) { 366 } else { 365 }
}

fn date_valid(year: i64, month: i64, day: i64) -> bool {
  if month < 1 or month > 12 { false }
  else {
    let max_day = month_length(year, month)
    day >= 1 and day <= max_day
  }
}

--- Construct a date only when the calendar triple is valid.
pub fn date(year: i64, month: i64, day: i64) -> Option<Date> {
  if date_valid(year, month, day) {
    Some<Date>(date_unchecked(year, month, day))
  } else {
    None
  }
}

fn days_before_year(year: i64) -> i64 {
  let mut days = 0
  if year >= 1970 {
    for y in 1970..year {
      days = days + days_in_year(y)
    }
  } else {
    let mut y = year
    while y < 1970 {
      days = days - days_in_year(y)
      y = y + 1
    }
  }
  days
}

--- Convert signed days since 1970-01-01 to a date.
pub fn from_epoch_day(epoch_day: i64) -> Date {
  let mut year = 1970
  let mut days = epoch_day
  while days < 0 {
    year = year - 1
    days = days + days_in_year(year)
  }
  while days >= days_in_year(year) {
    days = days - days_in_year(year)
    year = year + 1
  }
  let mut month = 1
  while days >= month_length(year, month) {
    days = days - month_length(year, month)
    month = month + 1
  }
  date_unchecked(year, month, days + 1)
}

impl Date {
  --- Return the date's year.
  pub fn year(self) -> i64 {
    match self { Date(parts) -> parts.year }
  }

  --- Return the date's one-based month.
  pub fn month(self) -> i64 {
    match self { Date(parts) -> parts.month }
  }

  --- Return the date's one-based day.
  pub fn day(self) -> i64 {
    match self { Date(parts) -> parts.day }
  }

  --- Convert the date to signed days since 1970-01-01.
  pub fn to_epoch_day(self) -> i64 {
    let year = self.year()
    let month = self.month()
    let mut days = days_before_year(year)
    for m in 1..month {
      days = days + month_length(year, m)
    }
    days + self.day() - 1
  }

  --- Add signed calendar days to the date.
  pub fn add_days(self, days: i64) -> Date {
    from_epoch_day(self.to_epoch_day() + days)
  }

  --- Return the date's day in the seven-day calendar week.
  pub fn weekday(self) -> Weekday {
    let mut value = self.to_epoch_day() + 4
    while value < 0 { value = value + 7 }
    match value - value / 7 * 7 {
      0 -> Sunday
      1 -> Monday
      2 -> Tuesday
      3 -> Wednesday
      4 -> Thursday
      5 -> Friday
      _ -> Saturday
    }
  }
}
