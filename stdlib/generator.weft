-- stdlib/generator.weft -- synchronous pull generators over deferred yield

use stdlib/continuation.{*}
use stdlib/option.{*}
use runtime/effects.{*}
use runtime/rc.{*}

--- Deferred yield/resume exchange used by synchronous pull generators.
pub effect GeneratorYield {
  --- Suspend with one encoded value and return the next sent `i64` word.
  @deferred fn yield(value: i64) -> i64
}

--- A synchronous generator yielding `T` and completing with `R`.
pub type Generator<T, R> {
  --- Wrap an owned generator state; use `generator.start` to construct it.
  Generator(i64)
}

--- Yield a typed value, suspend the producer, and return the next sent `i64`.
pub fn yield<T>(value: T) -[GeneratorYield]> i64 {
  -- The fiber packet transports one managed word. A one-element array is the
  -- canonical managed carrier for every T, including multi-lane tuples and
  -- records; transmuting T itself would silently keep only its first lane.
  let carrier: [T; 1] = [value]
  runtime_generator_yield_word(runtime_generator_state_word_from<[T; 1]>(carrier))
}

pub(package) fn generator_start_body<T, R>(producer: () -[GeneratorYield]> R) -[GeneratorYield]> i64 {
  let result: R = producer()
  let carrier: [R; 1] = [result]
  let word = runtime_generator_state_word_from<[R; 1]>(carrier)
  runtime_generator_word_retain_maybe(word)
  word
}

--- Start a typed producer eagerly, running it to its first yield or completion.
pub fn start<T, R>(producer: () -[GeneratorYield]> R) -> Generator<T, R> {
  let runner = () => generator_start_body<T, R>(producer)
  Generator<T, R>(runtime_generator_state_start(runtime_generator_state_word_from_any(runner)))
}

pub(package) fn generator_state<T, R>(g: Generator<T, R>) -> i64 {
  match g {
    Generator(ptr) -> ptr
  }
}

pub(package) fn generator_cell<T, R>(g: Generator<T, R>) -> ContinuationCell {
  continuation_cell_from_ptr(runtime_generator_state_cell(generator_state<T, R>(g)))
}

impl<T, R> Generator<T, R> {
  --- Return whether a typed yield is buffered and ready to retrieve.
  pub fn has_current(self) -> bool {
    runtime_generator_state_has_current(generator_state<T, R>(self)) == 1
  }

  --- Return whether the generator has completed or been closed.
  pub fn is_done(self) -> bool {
    runtime_generator_state_is_done(generator_state<T, R>(self)) == 1
  }

  --- Return the completion result after the generator finishes, or `None` while pending.
  pub fn result(self) -> Option<R> {
    let state = generator_state<T, R>(self)
    if runtime_generator_state_is_done(state) != 1 or state == 0 {
      None<R>()
    } else {
      let word = runtime_generator_state_result_word(state)
      let carrier = runtime_generator_state_word_as<[R; 1]>(word)
      Some<R>(carrier[0])
    }
  }

  --- Retrieve the next typed yield, resuming with `sent` when none is buffered.
  --- A value passed while the eager first yield is buffered is not delivered.
  pub fn send(self, sent: i64) -> Option<T> {
    let state = generator_state<T, R>(self)
    if runtime_generator_state_has_current(state) == 1 {
      let carrier = runtime_generator_state_take_current<[T; 1]>(state)
      Some<T>(carrier[0])
    } else {
      if runtime_generator_state_is_done(state) == 1 {
        None<T>()
      } else {
        let value = runtime_generator_state_resume_word(state, sent)
        if runtime_generator_state_has_current(state) == 0 and runtime_generator_state_is_done(state) == 1 {
          None<T>()
        } else {
          let carrier = runtime_generator_state_word_as<[T; 1]>(value)
          Some<T>(carrier[0])
        }
      }
    }
  }

  --- Retrieve the next typed yield, resuming the producer with zero if needed.
  pub fn next(self) -> Option<T> {
    self.send(0)
  }

  --- Close an unfinished typed generator and run suspended cleanup once.
  pub fn close(self) -> nil {
    runtime_generator_state_drop(generator_state<T, R>(self))
    nil
  }
}
