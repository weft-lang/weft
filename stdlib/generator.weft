-- stdlib/generator.weft -- synchronous pull generators over deferred yield

use "stdlib/continuation.weft"
use "runtime/effects.weft"

effect GeneratorYield {
  @deferred fn yield(value: i64) -> i64
}

type GeneratorI64 {
  GeneratorI64(i64)
}

type GeneratorNextI64 {
  GeneratorDone
  GeneratorValue(i64)
}

fn generator_yield_i64(value: i64) -[GeneratorYield]> i64 {
  GeneratorYield.yield(value)
}

fn generator_i64_new(producer: () -[GeneratorYield]> i64) -> GeneratorI64 {
  -- Lowered by codegen for literal zero-arg lambdas.
  GeneratorI64(0)
}

fn generator_i64_state(g: GeneratorI64) -> i64 {
  match g {
    GeneratorI64(ptr) -> ptr
  }
}

fn generator_i64_cell(g: GeneratorI64) -> ContinuationCell {
  ContinuationCell(__mem_load64(generator_i64_state(g)))
}

fn generator_i64_has_current(g: GeneratorI64) -> i64 {
  __mem_load64(generator_i64_state(g) + 16)
}

fn generator_i64_is_done(g: GeneratorI64) -> i64 {
  __mem_load64(generator_i64_state(g) + 24)
}

fn generator_i64_result_or(g: GeneratorI64, default: i64) -> i64 {
  if generator_i64_is_done(g) == 1 {
    __mem_load64(generator_i64_state(g) + 32)
  } else {
    default
  }
}

fn generator_next_is_done(next: GeneratorNextI64) -> i64 {
  match next {
    GeneratorDone -> 1
    GeneratorValue(value) -> 0
  }
}

fn generator_next_value_or(next: GeneratorNextI64, default: i64) -> i64 {
  match next {
    GeneratorDone -> default
    GeneratorValue(value) -> value
  }
}

fn generator_i64_send(g: GeneratorI64, sent: i64) -> GeneratorNextI64 {
  let ptr = generator_i64_state(g)
  if __mem_load64(ptr + 16) == 1 {
    let value = __mem_load64(ptr + 8)
    __mem_store64(ptr + 16, 0)
    GeneratorValue(value)
  } else {
    if __mem_load64(ptr + 24) == 1 {
      GeneratorDone
    } else {
      let cell = generator_i64_cell(g)
      let value = continuation_cell_resume_i64(cell, sent, 0)
      if continuation_cell_is_full(cell) == 1 {
        GeneratorValue(value)
      } else {
        __mem_store64(ptr + 24, 1)
        __mem_store64(ptr + 32, value)
        GeneratorDone
      }
    }
  }
}

fn generator_i64_next(g: GeneratorI64) -> GeneratorNextI64 {
  generator_i64_send(g, 0)
}

fn generator_i64_drop(g: GeneratorI64) -> i64 {
  let ptr = generator_i64_state(g)
  if __mem_load64(ptr + 24) == 1 {
    0
  } else {
    __mem_store64(ptr + 16, 0)
    __mem_store64(ptr + 24, 1)
    continuation_cell_drop_i64(generator_i64_cell(g))
  }
}
