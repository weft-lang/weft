-- stdlib/generator.weft -- synchronous pull generators over deferred yield

use stdlib/continuation.{*}
use runtime/effects.{*}
use runtime/rc.{*}

pub effect GeneratorYield {
  @deferred fn yield(value: i64) -> i64
}

pub type GeneratorI64 {
  GeneratorI64(i64)
}

pub type GeneratorNextI64 {
  GeneratorDone
  GeneratorValue(i64)
}

pub type Generator<T, R> {
  Generator(i64)
}

pub type GeneratorNext<T> {
  GeneratorNextDone
  GeneratorNextValue(T)
}

pub fn generator_yield_i64(value: i64) -[GeneratorYield]> i64 {
  runtime_generator_yield_word(value)
}

pub fn generator_yield<T>(value: T) -[GeneratorYield]> i64 {
  runtime_generator_yield_word(runtime_generator_state_word_from<T>(value))
}

pub fn generator_i64_new(producer: () -[GeneratorYield]> i64) -> GeneratorI64 {
  GeneratorI64(runtime_generator_state_start(runtime_generator_state_word_from_any(producer)))
}

pub(package) fn generator_new_body<T, R>(producer: () -[GeneratorYield]> R) -[GeneratorYield]> i64 {
  let result: R = producer()
  let word = runtime_generator_state_word_from<R>(result)
  runtime_generator_word_retain_maybe(word)
  word
}

pub fn generator_new<T, R>(producer: () -[GeneratorYield]> R) -> Generator<T, R> {
  let runner = () => generator_new_body<T, R>(producer)
  Generator<T, R>(runtime_generator_state_start(runtime_generator_state_word_from_any(runner)))
}

pub(package) fn generator_i64_state(g: GeneratorI64) -> i64 {
  match g {
    GeneratorI64(ptr) -> ptr
  }
}

pub(package) fn generator_state<T, R>(g: Generator<T, R>) -> i64 {
  match g {
    Generator(ptr) -> ptr
  }
}

pub(package) fn generator_i64_cell(g: GeneratorI64) -> ContinuationCell {
  continuation_cell_from_ptr(runtime_generator_state_cell(generator_i64_state(g)))
}

pub(package) fn generator_cell<T, R>(g: Generator<T, R>) -> ContinuationCell {
  continuation_cell_from_ptr(runtime_generator_state_cell(generator_state<T, R>(g)))
}

pub fn generator_i64_has_current(g: GeneratorI64) -> i64 {
  runtime_generator_state_has_current(generator_i64_state(g))
}

pub fn generator_has_current<T, R>(g: Generator<T, R>) -> i64 {
  runtime_generator_state_has_current(generator_state<T, R>(g))
}

pub fn generator_i64_is_done(g: GeneratorI64) -> i64 {
  runtime_generator_state_is_done(generator_i64_state(g))
}

pub fn generator_is_done<T, R>(g: Generator<T, R>) -> i64 {
  runtime_generator_state_is_done(generator_state<T, R>(g))
}

pub fn generator_i64_result_or(g: GeneratorI64, default: i64) -> i64 {
  runtime_generator_state_result_word_or(generator_i64_state(g), default)
}

pub fn generator_result_or<T, R>(g: Generator<T, R>, default: R) -> R {
  let word = runtime_generator_state_result_word_or(generator_state<T, R>(g), runtime_generator_state_word_from<R>(default))
  runtime_generator_state_word_as<R>(word)
}

pub fn generator_next_is_done(next: GeneratorNextI64) -> i64 {
  match next {
    GeneratorDone -> 1
    GeneratorValue(value) -> 0
  }
}

pub fn generator_generic_next_is_done<T>(next: GeneratorNext<T>) -> i64 {
  match next {
    GeneratorNextDone -> 1
    GeneratorNextValue(value) -> 0
  }
}

pub fn generator_next_value_or(next: GeneratorNextI64, default: i64) -> i64 {
  match next {
    GeneratorDone -> default
    GeneratorValue(value) -> value
  }
}

pub fn generator_generic_next_value_or<T>(next: GeneratorNext<T>, default: T) -> T {
  match next {
    GeneratorNextDone -> default
    GeneratorNextValue(value) -> value
  }
}

pub fn generator_i64_send(g: GeneratorI64, sent: i64) -> GeneratorNextI64 {
  let ptr = generator_i64_state(g)
  if runtime_generator_state_has_current(ptr) == 1 {
    let value = runtime_generator_state_take_current<i64>(ptr)
    GeneratorValue(value)
  } else {
    if runtime_generator_state_is_done(ptr) == 1 {
      GeneratorDone
    } else {
      let value = runtime_generator_state_resume_word(ptr, sent)
      if runtime_generator_state_has_current(ptr) == 0 and runtime_generator_state_is_done(ptr) == 1 {
        GeneratorDone
      } else {
        GeneratorValue(value)
      }
    }
  }
}

pub fn generator_send<T, R>(g: Generator<T, R>, sent: i64) -> GeneratorNext<T> {
  let ptr = generator_state<T, R>(g)
  if runtime_generator_state_has_current(ptr) == 1 {
    let value = runtime_generator_state_take_current<T>(ptr)
    GeneratorNextValue<T>(value)
  } else {
    if runtime_generator_state_is_done(ptr) == 1 {
      GeneratorNextDone
    } else {
      let value = runtime_generator_state_resume_word(ptr, sent)
      if runtime_generator_state_has_current(ptr) == 0 and runtime_generator_state_is_done(ptr) == 1 {
        GeneratorNextDone
      } else {
        GeneratorNextValue<T>(runtime_generator_state_word_as<T>(value))
      }
    }
  }
}

pub fn generator_i64_next(g: GeneratorI64) -> GeneratorNextI64 {
  generator_i64_send(g, 0)
}

pub fn generator_next<T, R>(g: Generator<T, R>) -> GeneratorNext<T> {
  generator_send<T, R>(g, 0)
}

pub fn generator_i64_drop(g: GeneratorI64) -> i64 {
  runtime_generator_state_drop(generator_i64_state(g))
}

pub fn generator_drop<T, R>(g: Generator<T, R>) -> i64 {
  runtime_generator_state_drop(generator_state<T, R>(g))
}
