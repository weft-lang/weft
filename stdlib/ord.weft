-- stdlib/ord.weft — canonical total-order trait

use "stdlib/string.weft"

-- `compare` returns a negative value, zero, or a positive value according as
-- self sorts before, with, or after `other`. Relational operators dispatch to
-- this method for non-numeric values; numeric operators retain direct lowering.
trait Ord {
  fn compare(self, other: Self) -> i64
}

impl Ord for i8 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for i16 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for i32 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for i64 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for isize {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for u8 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for u16 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for u32 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for u64 {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for usize {
  fn compare(self: Self, other: Self) -> i64 {
    if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
  }
}

impl Ord for f32 {
  fn compare(self: Self, other: Self) -> i64 {
    if self != self {
      if other != other { 0 } else { 1 }
    } else { if other != other {
      0 - 1
    } else {
      if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
    } }
  }
}

impl Ord for f64 {
  fn compare(self: Self, other: Self) -> i64 {
    if self != self {
      if other != other { 0 } else { 1 }
    } else { if other != other {
      0 - 1
    } else {
      if self < other { 0 - 1 } else { if self > other { 1 } else { 0 } }
    } }
  }
}

-- Bytewise UTF-8 ordering is deterministic and agrees with the historical
-- sorted-map comparator. Equal prefixes sort by byte length.
impl Ord for str {
  fn compare(self: Self, other: Self) -> i64 {
    let self_len = str_len(self)
    let other_len = str_len(other)
    let n = if self_len < other_len { self_len } else { other_len }
    let mut result = 0
    let mut done = 0
    let mut i = 0
    while done == 0 and i < n {
      let self_byte = str_byte_at(self, i)
      let other_byte = str_byte_at(other, i)
      if self_byte < other_byte {
        result = 0 - 1
        done = 1
      } else { if self_byte > other_byte {
        result = 1
        done = 1
      } else {
        i = i + 1
      } }
    }
    if result != 0 {
      result
    } else {
      if self_len < other_len { 0 - 1 }
      else { if self_len > other_len { 1 } else { 0 } }
    }
  }
}

fn ord_compare<T: Ord>(a: T, b: T) -> i64 {
  a.compare(b)
}
