-- stdlib/ord.weft — canonical total-order trait

use runtime/string.{*}

--- The exhaustive result of comparing two values in a total order.
pub type Ordering {
  Less,
  Equal,
  Greater
}

--- A deterministic total order over values of one type.
pub trait Ord {
  --- Return the exact ordering of `self` relative to `other`.
  fn compare(self, other: Self) -> Ordering
}

impl Ord for i8 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for i16 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for i32 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for i64 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for isize {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for u8 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for u16 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for u32 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for u64 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for usize {
  fn compare(self: Self, other: Self) -> Ordering {
    if self < other { Less } else { if self > other { Greater } else { Equal } }
  }
}

impl Ord for f32 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self != self {
      if other != other { Equal } else { Greater }
    } else { if other != other {
      Less
    } else {
      if self < other { Less } else { if self > other { Greater } else { Equal } }
    } }
  }
}

impl Ord for f64 {
  fn compare(self: Self, other: Self) -> Ordering {
    if self != self {
      if other != other { Equal } else { Greater }
    } else { if other != other {
      Less
    } else {
      if self < other { Less } else { if self > other { Greater } else { Equal } }
    } }
  }
}

-- Bytewise UTF-8 ordering is deterministic and agrees with the historical
-- sorted-map comparator. Equal prefixes sort by byte length.
impl Ord for str {
  fn compare(self: Self, other: Self) -> Ordering {
    let self_len = runtime_str_len(self)
    let other_len = runtime_str_len(other)
    let n = if self_len < other_len { self_len } else { other_len }
    let mut result = Equal
    let mut done = 0
    let mut i = 0
    while done == 0 and i < n {
      let self_byte = runtime_str_byte_at(self, i)
      let other_byte = runtime_str_byte_at(other, i)
      if self_byte < other_byte {
        result = Less
        done = 1
      } else { if self_byte > other_byte {
        result = Greater
        done = 1
      } else {
        i = i + 1
      } }
    }
    match result {
      Less -> Less
      Greater -> Greater
      Equal -> {
        if self_len < other_len { Less }
        else { if self_len > other_len { Greater } else { Equal } }
      }
    }
  }
}

--- Compare two values using their `Ord` implementation.
pub fn ord_compare<T: Ord>(a: T, b: T) -> Ordering {
  a.compare(b)
}
