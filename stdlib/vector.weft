-- stdlib/vector.weft — mutable contiguous vectors
--
-- Vector handles are compiler-managed pointers to
-- [data, length, capacity, elem_size, elem_mode, array leaf count,
-- array leaf stride, array leaf cleanup kind]. Boxed/runtime-managed values
-- still use one-word handles, while scalar numeric elements, eligible plain
-- records, and fixed arrays use concrete payload storage.

use runtime/memory.{*}
use runtime/vector_storage.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/drop.{Drop}
use stdlib/eq.{Eq}
use stdlib/iter/core.{from_generator, iter_from_vector_word, iter_next, iter_remaining_lower}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}
use stdlib/num/scalar.{
  num_scalar_i64_to_usize,
  num_scalar_usize_checked_add,
  num_scalar_usize_checked_mul,
  num_scalar_usize_to_i64
}
use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
pub use stdlib/vector/handles.{PersistentVector, Vector}

-- Vector and persistent-vector handles are declared in vector/handles.weft so
-- signature-only consumers do not drag this implementation into their IR.
pub(package) fn vector_header_size() -> i64 { vector_storage_header_size() }

pub(package) fn vector_data_offset() -> i64 { 0 }

pub(package) fn vector_len_offset() -> i64 { 8 }

pub(package) fn vector_capacity_offset() -> i64 { 16 }

pub(package) fn vector_element_size_offset() -> i64 { 24 }

pub(package) fn vector_element_mode_offset() -> i64 { 32 }

pub(package) fn vector_element_leaf_count_offset() -> i64 { 40 }

pub(package) fn vector_element_leaf_stride_offset() -> i64 { 48 }

pub(package) fn vector_element_leaf_kind_offset() -> i64 { 56 }

pub(package) fn vector_element_mode_word() -> i64 { 0 }

pub(package) fn vector_element_mode_record_payload() -> i64 { 7 }

pub(package) fn vector_element_size_of<T>() -> i64 { 8 }

pub(package) fn vector_element_mode_of<T>() -> i64 { vector_element_mode_word() }

-- -1 means ordinary word/record storage; zero is a real empty-array plan.
pub(package) fn vector_element_leaf_count_of<T>() -> i64 { 0 - 1 }

pub(package) fn vector_element_leaf_stride_of<T>() -> i64 { 0 }

pub(package) fn vector_element_leaf_kind_of<T>() -> i64 { 0 }

--- A vector allocation or growth request cannot fit its storage domain.
pub type CapacityError {
  --- The requested element count cannot be represented for this element type.
  CapacityUnrepresentable(usize),
  --- Adding the requested capacity to the current length overflowed `usize`.
  CapacityAdditionOverflow(usize, usize)
}

--- A mutable vector operation addressed an element outside the current value.
pub type IndexError {
  --- The requested index and the vector length at the failed operation.
  IndexOutOfBounds(usize, usize)
}

fn vector_count_from_storage(count: i64) -> usize {
  match num_scalar_i64_to_usize(count) {
    Some(value) -> value
    None -> panic("Vector count invariant violated")
  }
}

pub(package) fn vector_normalize_capacity(capacity: i64) -> i64 {
  if capacity < 0 { 0 } else { capacity }
}

--- Construct an empty mutable vector.
pub fn new<T>() -> owned Vector<T> {
  let zero: usize = 0
  with_capacity<T>(zero)
}

--- Construct an empty mutable vector with at least `capacity` slots.
--- Panic when the requested count cannot fit this vector's storage.
pub fn with_capacity<T>(capacity: usize) -> owned Vector<T> {
  let elem_size = vector_element_size_of<T>()
  let elem_mode = vector_element_mode_of<T>()
  match vector_storage_size(capacity, elem_size) {
    VectorStorageUnrepresentable -> panic("Vector capacity is too large")
    VectorStorageSized(checked_capacity, bytes) -> vector_storage_new<T>(
      checked_capacity,
      bytes,
      elem_size,
      elem_mode,
      vector_element_leaf_count_of<T>(),
      vector_element_leaf_stride_of<T>(),
      vector_element_leaf_kind_of<T>()
    )
  }
}

--- Try to construct an empty mutable vector with at least `capacity` slots.
--- Default-allocator exhaustion remains process-terminal; this result reports
--- only an element count that cannot fit the platform storage representation.
pub fn try_with_capacity<T>(capacity: usize) -> Result<owned Vector<T>, CapacityError> {
  let elem_size = vector_element_size_of<T>()
  let elem_mode = vector_element_mode_of<T>()
  match vector_storage_size(capacity, elem_size) {
    VectorStorageUnrepresentable -> Err<owned Vector<T>, CapacityError>(
      CapacityUnrepresentable(capacity)
    )
    VectorStorageSized(checked_capacity, bytes) -> Ok<owned Vector<T>, CapacityError>(
      vector_storage_new<T>(
        checked_capacity,
        bytes,
        elem_size,
        elem_mode,
        vector_element_leaf_count_of<T>(),
        vector_element_leaf_stride_of<T>(),
        vector_element_leaf_kind_of<T>()
      )
    )
  }
}

--- Return the number of initialized elements.
pub(package) fn vector_len<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_len<T>(vec)
}

--- Consume the vector and iterate its values in index order without copying.
pub(package) fn vector_into_iter<T>(vec: owned Vector<T>) -> owned Iterator<T> {
  iter_from_vector_word<T>(vector_storage_take_owned_word<T>(vec))
}

impl<T> IntoIterator for owned Vector<T> {
  type Item = T

  fn into_iter(self: owned Vector<T>) -> owned Iterator<T> {
    vector_into_iter<T>(self)
  }
}

-- An owned vector's ordinary managed receiver carries its one storage stake;
-- consuming the Drop call releases that stake and runs the vector finalizer.
impl<T> Drop for Vector<T> {
  fn drop(self) -> nil { nil }
}

impl<T> Collect for Vector<T> {
  type Item = T
  type Output = owned Vector<T>

  fn from_iter(source: owned Iterator<T>) -> owned Vector<T> {
    let capacity = iter_remaining_lower<T>(source)
    let mut values = source
    let mut result = with_capacity<T>(vector_count_from_storage(capacity))
    let mut done = false
    while not done {
      match iter_next<T>(values) {
        Some(value) -> {
          vector_push_borrowed<T>(result, value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    result
  }
}

--- Return the number of elements the current allocation can hold.
pub(package) fn vector_capacity<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_capacity<T>(vec)
}

pub(package) fn vector_data<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_data<T>(vec)
}

pub(package) fn vector_element_size<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_element_size<T>(vec)
}

pub(package) fn vector_element_mode<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_element_mode<T>(vec)
}

pub(package) fn vector_element_leaf_count<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_element_leaf_count<T>(vec)
}

pub(package) fn vector_element_leaf_stride<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_element_leaf_stride<T>(vec)
}

pub(package) fn vector_element_leaf_kind<T>(vec: borrow Vector<T>) -> i64 {
  vector_storage_element_leaf_kind<T>(vec)
}

pub(package) fn vector_capacity_bytes<T>(vec: borrow Vector<T>) -> i64 {
  match vector_storage_size_i64(vector_capacity<T>(vec), vector_element_size<T>(vec)) {
    VectorStorageSized(_, bytes) -> bytes
    VectorStorageUnrepresentable -> panic("Vector storage invariant violated")
  }
}

--- Return whether the vector has no elements.
pub(package) fn vector_is_empty<T>(vec: borrow Vector<T>) -> bool {
  vector_len<T>(vec) == 0
}

fn vector_reserve_count<T>(vec: borrow Vector<T>, needed: i64) -> bool {
  match num_scalar_i64_to_usize(needed) {
    None -> false
    Some(count) -> vector_storage_reserve<T>(vec, count)
  }
}

pub(package) fn vector_reserve_borrowed<T>(vec: borrow mut Vector<T>, needed: i64) -> bool {
  vector_reserve_count<T>(vec, needed)
}

fn vector_try_reserve_additional<T>(
  vec: borrow mut Vector<T>,
  additional: usize
) -> Result<nil, CapacityError> {
  let length = vector_count_from_storage(vector_len<T>(vec))
  match num_scalar_usize_checked_add(length, additional) {
    None -> Err<nil, CapacityError>(CapacityAdditionOverflow(length, additional))
    Some(needed) -> if vector_storage_reserve<T>(vec, needed) {
      Ok<nil, CapacityError>(nil)
    } else {
      Err<nil, CapacityError>(CapacityUnrepresentable(needed))
    }
  }
}

--- Ensure capacity for internal vector-backed state that has already sealed
--- its mutation authority behind another opaque abstraction.
pub(package) fn vector_reserve<T>(vec: borrow Vector<T>, needed: i64) -> bool {
  vector_reserve_count<T>(vec, needed)
}

pub(package) fn vector_push_borrowed<T>(vec: borrow mut Vector<T>, value: T) -> bool {
  vector_storage_push<T>(vec, value)
}

--- Append through an internal vector-backed abstraction's sealed state.
pub(package) fn vector_push<T>(vec: borrow Vector<T>, value: T) -> bool {
  vector_storage_push<T>(vec, value)
}

--- Append through an internal vector-backed abstraction that already reserved
--- its complete batch.
pub(package) fn vector_push_reserved<T>(vec: borrow Vector<T>, value: T) -> bool {
  vector_storage_push_reserved<T>(vec, value)
}

--- Return whether `index` identifies an element.
pub(package) fn vector_in_bounds<T>(vec: borrow Vector<T>, index: i64) -> bool {
  index >= 0 and index < vector_len<T>(vec)
}

pub(package) fn vector_load_value<T>(addr: i64, elem_size: i64, elem_mode: i64, default: T) -> T {
  vector_storage_load_value<T>(addr, elem_size, elem_mode, default)
}

pub(package) fn vector_store_value<T>(addr: i64, elem_size: i64, elem_mode: i64, value: T) -> i64
{
  vector_storage_store_value<T>(addr, elem_size, elem_mode, value)
}

--- Return the element at `index`, or `default` when out of bounds.
pub(package) fn vector_get<T>(vec: borrow Vector<T>, index: i64, default: T) -> T {
  if not vector_in_bounds<T>(vec, index) { default }
  else { vector_storage_get_or<T>(vec, index, default) }
}

pub(package) fn vector_get_in_bounds<T>(vec: borrow Vector<T>, index: i64) -> T {
  vector_storage_get_in_bounds<T>(vec, index)
}

-- Borrowed field read: payload `field` of the managed element at
-- `index`, without materialising an owned element reference. The
-- element stays container-owned for the duration of the read (no user
-- code runs inside), and the RESULT follows F's static ownership
-- class: managed payloads are retained (+1, released by the caller's
-- machinery at lifetime end), scalars are plain copies. Caller
-- maintains bounds, like vector_get_in_bounds. Managed-element vectors
-- only (the slot holds a pointer to a heap object).
pub(package) fn vector_get_field_in_bounds<T, F>(
  vec: borrow Vector<T>,
  index: i64,
  field: i64
) -> F {
  vector_storage_get_field_in_bounds<T, F>(vec, index, field, vector_element_mode_of<F>())
}

--- Return `Some(element)` at `index`, or `None` when out of bounds.
pub(package) fn vector_get_option<T>(vec: borrow Vector<T>, index: i64) -> Option<T> {
  if not vector_in_bounds<T>(vec, index) { None<T>() }
  else { Some<T>(vector_storage_get_in_bounds<T>(vec, index)) }
}

pub(package) fn vector_set_borrowed<T>(vec: borrow mut Vector<T>, index: i64, value: T) -> bool {
  vector_storage_set<T>(vec, index, value)
}

pub(package) fn vector_set<T>(vec: borrow Vector<T>, index: i64, value: T) -> bool {
  vector_storage_set<T>(vec, index, value)
}

fn vector_replace<T>(vec: borrow mut Vector<T>, index: usize, value: T) -> Result<T, IndexError> {
  let length = vector_count_from_storage(vector_len<T>(vec))
  if index >= length {
    Err<T, IndexError>(IndexOutOfBounds(index, length))
  } else {
    match num_scalar_usize_to_i64(index) {
      None -> Err<T, IndexError>(IndexOutOfBounds(index, length))
      Some(storage_index) ->
        Ok<T, IndexError>(vector_storage_replace<T>(vec, storage_index, value))
    }
  }
}

pub(package) fn vector_pop_borrowed<T>(vec: borrow mut Vector<T>) -> Option<T> {
  vector_storage_pop<T>(vec)
}

pub(package) fn vector_pop<T>(vec: borrow Vector<T>) -> Option<T> {
  vector_storage_pop<T>(vec)
}

pub(package) fn vector_clear_borrowed<T>(vec: borrow mut Vector<T>) -> nil {
  vector_storage_truncate<T>(vec, 0)
}

pub(package) fn vector_clear<T>(vec: borrow Vector<T>) -> nil {
  vector_storage_truncate<T>(vec, 0)
}

pub(package) fn vector_truncate_borrowed<T>(vec: borrow mut Vector<T>, len: i64) -> nil {
  vector_storage_truncate<T>(vec, len)
}

--- Fold elements from first to last with a pure callback.
pub(package) fn vector_fold<T, A>(vec: borrow Vector<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  for i in 0..vector_len<T>(vec) { acc = f(acc, vector_storage_get_in_bounds<T>(vec, i)) }
  acc
}

--- Add every `i64` element to `init` from first to last.
pub(package) fn vector_sum_i64(vec: borrow Vector<i64>, init: i64) -> i64 {
  let mut acc = init
  let len = vector_len<i64>(vec)
  let mut i = 0
  while i < len {
    acc = acc + vector_get<i64>(vec, i, 0)
    i = i + 1
  }
  acc
}

-- Explicit owning conversion from either slice kind. Fixed arrays reach this
-- helper through the checker's full-slice fact, so every source follows the
-- same value/retain semantics and produces independent growable storage.
--- Copy an array or slice into independent growable vector storage.
pub fn to_vector<T>(values: [T]) -> owned Vector<T> {
  let mut result = new<T>()
  for value in values {
    vector_push_borrowed<T>(result, value)
  }
  result
}

-- Semantic signature for `vector.to_array<N>()`. The checker instantiates A
-- as exactly `[T; N]`; typed lowering replaces the call with the exact-length
-- branch, array copy, and Option construction. As with the element-layout
-- intrinsics above, this body is a conservative bootstrap fallback only.
--- Copy into a fixed array, returning `None` unless its length is exact.
--- Call with method syntax such as `values.to_array<3>()`.
pub fn to_array<T, A>(vec: borrow Vector<T>) -> Option<A> {
  None<A>()
}

--- Transform elements into a new vector in source order.
pub(package) fn vector_map<T, U>(vec: borrow Vector<T>, f: (T) -> U) -> owned Vector<U> {
  let len = vector_len<T>(vec)
  let mut result = with_capacity<U>(vector_count_from_storage(len))
  for i in 0..len { vector_push_borrowed<U>(result, f(vector_storage_get_in_bounds<T>(vec, i))) }
  result
}

fn vector_slice_checked<T>(
  vec: borrow Vector<T>,
  start: usize,
  end: usize
) -> Option<owned Vector<T>> {
  let length = vector_count_from_storage(vector_len<T>(vec))
  if start > end or end > length {
    None<owned Vector<T>>()
  } else {
    match num_scalar_usize_to_i64(start) {
      None -> None<owned Vector<T>>()
      Some(first) -> match num_scalar_usize_to_i64(end) {
        None -> None<owned Vector<T>>()
        Some(last) -> {
          let mut result = with_capacity<T>(end - start)
          let mut index = first
          while index < last {
            vector_push_borrowed<T>(result, vector_get_in_bounds<T>(vec, index))
            index = index + 1
          }
          Some<owned Vector<T>>(result)
        }
      }
    }
  }
}

-- Insert while preserving order. `index == len` appends; indices outside
-- [0, len] leave the vector unchanged and return zero.
--- Insert in place while preserving order; `index == len` appends.
--- Return whether insertion succeeded; invalid indices leave the vector unchanged.
pub(package) fn vector_insert_at<T>(vec: borrow Vector<T>, index: i64, value: T) -> bool {
  let len = vector_len<T>(vec)
  if index < 0 or index > len { false }
  else {
    if not vector_storage_push<T>(vec, value) { false }
    else {
      let mut i = len
      while i > index {
        vector_storage_swap<T>(vec, i - 1, i)
        i = i - 1
      }
      true
    }
  }
}

pub(package) fn vector_insert_at_borrowed<T>(
  vec: borrow mut Vector<T>,
  index: i64,
  value: T
) -> bool {
  vector_insert_at<T>(vec, index, value)
}

-- Remove while preserving order. Invalid indices return None without
-- changing the vector.
--- Remove and return an element while preserving order, or `None` if absent.
pub(package) fn vector_remove_at<T>(vec: borrow Vector<T>, index: i64) -> Option<T> {
  let len = vector_len<T>(vec)
  if index < 0 or index >= len { None<T>() }
  else {
    let mut i = index
    while i + 1 < len {
      vector_storage_swap<T>(vec, i, i + 1)
      i = i + 1
    }
    vector_storage_pop<T>(vec)
  }
}

pub(package) fn vector_remove_at_borrowed<T>(vec: borrow mut Vector<T>, index: i64) -> Option<T> {
  vector_remove_at<T>(vec, index)
}

--- Copy `left` followed by `right` into a new vector.
pub(package) fn vector_concat<T>(
  left: borrow Vector<T>,
  right: borrow Vector<T>
) -> owned Vector<T> {
  let left_len = vector_len<T>(left)
  let right_len = vector_len<T>(right)
  let left_count = vector_count_from_storage(left_len)
  let right_count = vector_count_from_storage(right_len)
  let total = match num_scalar_usize_checked_add(left_count, right_count) {
    Some(count) -> count
    None -> panic("Vector concatenation capacity overflowed")
  }
  let mut result = with_capacity<T>(total)
  for i in 0..left_len {
    vector_push_borrowed<T>(result, vector_get_in_bounds<T>(left, i))
  }
  for i in 0..right_len {
    vector_push_borrowed<T>(result, vector_get_in_bounds<T>(right, i))
  }
  result
}

-- Reverse in place and return the same handle for pipe-friendly use.
--- Reverse in place and return the same vector handle.
pub(package) fn vector_reverse<T>(vec: owned Vector<T>) -> owned Vector<T> {
  let mut result = vec
  let len = vector_len<T>(result)
  let mut left = 0
  let mut right = len - 1
  while left < right {
    vector_swap_borrowed<T>(result, left, right)
    left = left + 1
    right = right - 1
  }
  result
}

--- Copy elements accepted by a pure predicate into a new vector.
pub(package) fn vector_filter<T>(vec: borrow Vector<T>, predicate: (T) -> bool) -> owned Vector<T>
{
  let len = vector_len<T>(vec)
  let mut result = with_capacity<T>(vector_count_from_storage(len))
  for i in 0..len {
    let value = vector_get_in_bounds<T>(vec, i)
    if predicate(value) {
      vector_push_borrowed<T>(result, value)
    } else { 0 }
  }
  result
}

--- Return the first element accepted by a pure predicate, or `None`.
pub(package) fn vector_find<T>(vec: borrow Vector<T>, predicate: (T) -> bool) -> Option<T> {
  let len = vector_len<T>(vec)
  let mut result = None<T>()
  let mut i = 0
  while i < len {
    let value = vector_get_in_bounds<T>(vec, i)
    if predicate(value) {
      result = Some<T>(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

--- Return the first index equivalent to `needle` under `same`, or `None`.
pub(package) fn vector_index_of_by<T>(
  vec: borrow Vector<T>,
  needle: T,
  same: (T, T) -> bool
) -> Option<usize> {
  let len = vector_len<T>(vec)
  let mut result = None<usize>()
  let mut i = 0
  while i < len {
    if same(vector_get_in_bounds<T>(vec, i), needle) {
      result = Some<usize>(__i64_to_usize(i))
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

pub(package) fn vector_ord_equal<T: Ord>(left: T, right: T) -> bool {
  match left.compare(right) {
    Equal -> true
    _ -> false
  }
}

--- Return the first index equal under `Ord`, or `None`.
pub(package) fn vector_index_of<T: Ord>(vec: borrow Vector<T>, needle: T) -> Option<usize> {
  vector_index_of_by<T>(vec, needle, vector_ord_equal)
}

--- Return whether an `Ord`-equal element is present.
pub(package) fn vector_contains<T: Ord>(vec: borrow Vector<T>, needle: T) -> bool {
  match vector_index_of<T>(vec, needle) {
    Some(index) -> true
    None -> false
  }
}

-- Return a new vector with adjacent equivalent elements collapsed. This is
-- linear and leaves the source unchanged; non-adjacent duplicates remain.
--- Copy into a new vector while collapsing adjacent equivalent elements.
--- Non-adjacent duplicates remain.
pub(package) fn vector_dedup_by<T>(vec: borrow Vector<T>, same: (T, T) -> bool) -> owned Vector<T>
{
  let len = vector_len<T>(vec)
  let mut result = with_capacity<T>(vector_count_from_storage(len))
  for i in 0..len {
    let value = vector_get_in_bounds<T>(vec, i)
    let keep = if vector_is_empty<T>(result) { true }
    else { not same(vector_get_in_bounds<T>(result, vector_len<T>(result) - 1), value) }
    if keep { vector_push_borrowed<T>(result, value) } else { 0 }
  }
  result
}

--- Copy while collapsing adjacent `Ord`-equal elements.
pub(package) fn vector_dedup<T: Ord>(vec: borrow Vector<T>) -> owned Vector<T> {
  vector_dedup_by<T>(vec, vector_ord_equal)
}

--- Construct the ascending half-open integer range `[start, end)`.
--- Return an empty vector when `end <= start`.
pub fn range(start: i64, end: i64) -> owned Vector<i64> {
  let size = if end <= start { 0 } else { end - start }
  let mut result = with_capacity<i64>(vector_count_from_storage(size))
  for i in start..end {
    vector_push_borrowed<i64>(result, i)
  }
  result
}

pub(package) fn vector_index_of_i64(vec: borrow Vector<i64>, needle: i64) -> Option<usize> {
  vector_index_of<i64>(vec, needle)
}

pub(package) fn vector_contains_i64(vec: borrow Vector<i64>, needle: i64) -> bool {
  vector_contains<i64>(vec, needle)
}

-- Managed persistent vector scaffold
--
-- The mutable Vector above stays the hot local-mutation representation. This
-- surface is for immutable shared data: one managed root box points at an
-- immutable vector header. Completed chunks live in a 32-way tree; the current
-- partial chunk lives in a tail. Updates path-copy the touched tree branch or
-- tail while older roots keep their view. Every version in a family retains one
-- region owner; cross-thread promotion marks that owner without walking the
-- tree, and the last version releases managed-element stakes and unmaps all
-- structural-copy segments together.
pub(package) fn persistent_vector_chunk_size() -> i64 { persistent_vector_storage_chunk_size() }

pub(package) fn persistent_vector_header_size() -> i64 { persistent_vector_storage_header_size() }

pub(package) fn persistent_vector_node_size() -> i64 { persistent_vector_storage_node_size() }

pub(package) fn persistent_vector_len_offset() -> i64 { 0 }

pub(package) fn persistent_vector_element_size_offset() -> i64 { 8 }

pub(package) fn persistent_vector_element_mode_offset() -> i64 { 16 }

pub(package) fn persistent_vector_tree_count_offset() -> i64 { 24 }

pub(package) fn persistent_vector_tree_depth_offset() -> i64 { 32 }

pub(package) fn persistent_vector_tree_root_offset() -> i64 { 40 }

pub(package) fn persistent_vector_tail_offset() -> i64 { 48 }

pub(package) fn persistent_vector_element_leaf_count_offset() -> i64 { 56 }

pub(package) fn persistent_vector_element_leaf_stride_offset() -> i64 { 64 }

pub(package) fn persistent_vector_element_leaf_kind_offset() -> i64 { 72 }

pub(package) fn persistent_vector_box<T>(root: i64, region: i64) -> PersistentVector<T> {
  persistent_vector_storage_box<T>(root, region)
}

pub(package) fn persistent_vector_make_root(
  region: i64,
  len: i64,
  elem_size: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64,
  tree_count: i64,
  tree_depth: i64,
  tree_root: i64,
  tail: i64
) -> i64 {
  persistent_vector_storage_make_root(
    region,
    len,
    elem_size,
    elem_mode,
    leaf_count,
    leaf_stride,
    leaf_kind,
    tree_count,
    tree_depth,
    tree_root,
    tail
  )
}

pub(package) fn persistent_vector_empty<T>() -> PersistentVector<T> {
  let region = persistent_vector_storage_region_new()
  let raw_region = persistent_vector_storage_region_word(region)
  let root = persistent_vector_make_root(
    raw_region,
    0,
    vector_element_size_of<T>(),
    vector_element_mode_of<T>(),
    vector_element_leaf_count_of<T>(),
    vector_element_leaf_stride_of<T>(),
    vector_element_leaf_kind_of<T>(),
    0,
    1,
    0,
    0
  )
  persistent_vector_box<T>(root, raw_region)
}

pub(package) fn persistent_vector_root<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_root<T>(vec)
}

pub(package) fn persistent_vector_region<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_region<T>(vec)
}

--- Return the number of elements in a persistent vector.
pub(package) fn persistent_vector_len<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_len(root)
}

pub(package) fn persistent_vector_chunk_count<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  if root == 0 {
    0
  } else {
    let len = persistent_vector_storage_len(root)
    if len == 0 { 0 } else {
      (len + persistent_vector_chunk_size() - 1) / persistent_vector_chunk_size()
    }
  }
}

pub(package) fn persistent_vector_tree_depth<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tree_depth(root)
}

pub(package) fn persistent_vector_tree_root<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tree_root(root)
}

pub(package) fn persistent_vector_tail<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tail(root)
}

pub(package) fn persistent_vector_in_bounds<T>(vec: PersistentVector<T>, index: i64) -> bool {
  index >= 0 and index < persistent_vector_len<T>(vec)
}

pub(package) fn persistent_vector_pow32(exp: i64) -> i64 {
  let mut result = 1
  let mut i = 0
  while i < exp {
    result = result * persistent_vector_chunk_size()
    i = i + 1
  }
  result
}

pub(package) fn persistent_vector_slot(chunk_index: i64, depth: i64) -> i64 {
  let div = persistent_vector_pow32(depth - 1)
  let value = chunk_index / div
  value - value / persistent_vector_chunk_size() * persistent_vector_chunk_size()
}

pub(package) fn persistent_vector_tail_count_for_len(len: i64, tree_count: i64) -> i64 {
  len - tree_count * persistent_vector_chunk_size()
}

pub(package) fn persistent_vector_copy_node(region: i64, node: i64) -> i64 {
  persistent_vector_storage_copy_node(region, node)
}

pub(package) fn persistent_vector_copy_chunk(
  region: i64,
  chunk: i64,
  elem_size: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64
) -> i64 {
  persistent_vector_storage_copy_chunk(
    region,
    chunk,
    elem_size,
    elem_mode,
    leaf_count,
    leaf_stride,
    leaf_kind
  )
}

pub(package) fn persistent_vector_tree_chunk(node: i64, depth: i64, chunk_index: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let slot = persistent_vector_slot(chunk_index, depth)
    let child = persistent_vector_storage_node_child(node, slot)
    if depth <= 1 { child } else { persistent_vector_tree_chunk(child, depth - 1, chunk_index) }
  }
}

pub(package) fn persistent_vector_tree_assoc_chunk(
  region: i64,
  node: i64,
  depth: i64,
  chunk_index: i64,
  chunk: i64
) -> i64 {
  let next = persistent_vector_copy_node(region, node)
  let slot = persistent_vector_slot(chunk_index, depth)
  if depth <= 1 {
    persistent_vector_storage_node_set_child(next, slot, chunk)
  } else {
    let old_child = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_child = persistent_vector_tree_assoc_chunk(
      region,
      old_child,
      depth - 1,
      chunk_index,
      chunk
    )
    persistent_vector_storage_node_set_child(next, slot, new_child)
  }
  next
}

pub(package) fn persistent_vector_tree_set<T>(
  region: i64,
  node: i64,
  depth: i64,
  chunk_index: i64,
  slot_in_chunk: i64,
  elem_size: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64,
  value: T
) -> i64 {
  let next = persistent_vector_copy_node(region, node)
  let slot = persistent_vector_slot(chunk_index, depth)
  if depth <= 1 {
    let old_chunk = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_chunk = persistent_vector_copy_chunk(
      region,
      old_chunk,
      elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    vector_store_value<T>(new_chunk + slot_in_chunk * elem_size, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(
      region,
      new_chunk + slot_in_chunk * elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    persistent_vector_storage_node_set_child(next, slot, new_chunk)
  } else {
    let old_child = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_child = persistent_vector_tree_set<T>(
      region,
      old_child,
      depth - 1,
      chunk_index,
      slot_in_chunk,
      elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind,
      value
    )
    persistent_vector_storage_node_set_child(next, slot, new_child)
  }
  next
}

pub(package) fn persistent_vector_get_option<T>(vec: PersistentVector<T>, index: i64) -> Option<T>
{
  if not persistent_vector_in_bounds<T>(vec, index) {
    None<T>()
  } else {
    let root = persistent_vector_root<T>(vec)
    let elem_size = persistent_vector_storage_element_size(root)
    let elem_mode = persistent_vector_storage_element_mode(root)
    let tree_count = persistent_vector_storage_tree_count(root)
    let tree_depth = persistent_vector_storage_tree_depth(root)
    let tree_root = persistent_vector_storage_tree_root(root)
    let tail = persistent_vector_storage_tail(root)
    let tail_start = tree_count * persistent_vector_chunk_size()
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    if index >= tail_start {
      Some<T>(
        vector_storage_load_value_in_bounds<T>(
          tail + (index - tail_start) * elem_size,
          elem_size,
          elem_mode
        )
      )
    } else {
      let chunk = persistent_vector_tree_chunk(tree_root, tree_depth, chunk_index)
      Some<T>(
        vector_storage_load_value_in_bounds<T>(chunk + slot * elem_size, elem_size, elem_mode)
      )
    }
  }
}

--- Return a version with `value` appended, leaving `vec` unchanged.
pub(package) fn persistent_vector_push<T>(
  vec: PersistentVector<T>,
  value: T
) -> PersistentVector<T> {
  let root = persistent_vector_root<T>(vec)
  let region = persistent_vector_region<T>(vec)
  let len = if root == 0 { 0 } else { persistent_vector_storage_len(root) }
  let elem_size = if root == 0 { vector_element_size_of<T>() } else {
    persistent_vector_storage_element_size(root)
  }
  let elem_mode = if root == 0 { vector_element_mode_of<T>() } else {
    persistent_vector_storage_element_mode(root)
  }
  let leaf_count = if root == 0 { vector_element_leaf_count_of<T>() } else {
    persistent_vector_storage_element_leaf_count(root)
  }
  let leaf_stride = if root == 0 { vector_element_leaf_stride_of<T>() } else {
    persistent_vector_storage_element_leaf_stride(root)
  }
  let leaf_kind = if root == 0 { vector_element_leaf_kind_of<T>() } else {
    persistent_vector_storage_element_leaf_kind(root)
  }
  let tree_count = if root == 0 { 0 } else { persistent_vector_storage_tree_count(root) }
  let tree_depth = if root == 0 { 1 } else { persistent_vector_storage_tree_depth(root) }
  let tree_root = if root == 0 { 0 } else { persistent_vector_storage_tree_root(root) }
  let tail = if root == 0 { 0 } else { persistent_vector_storage_tail(root) }
  let tail_count = persistent_vector_tail_count_for_len(len, tree_count)
  if tail_count < persistent_vector_chunk_size() {
    let new_tail = persistent_vector_copy_chunk(
      region,
      tail,
      elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    vector_store_value<T>(new_tail + tail_count * elem_size, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(
      region,
      new_tail + tail_count * elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    persistent_vector_box<T>(
      persistent_vector_make_root(
        region,
        len + 1,
        elem_size,
        elem_mode,
        leaf_count,
        leaf_stride,
        leaf_kind,
        tree_count,
        tree_depth,
        tree_root,
        new_tail
      ),
      region
    )
  } else {
    let needs_grow = if tree_count >= persistent_vector_pow32(tree_depth) { 1 } else { 0 }
    let next_depth = if needs_grow == 1 { tree_depth + 1 } else { tree_depth }
    let base_tree = if needs_grow == 1 {
      let node = persistent_vector_copy_node(region, 0)
      if tree_root != 0 { persistent_vector_storage_node_set_child(node, 0, tree_root) } else {
        0
      }
      node
    } else { tree_root }
    let next_tree = persistent_vector_tree_assoc_chunk(
      region,
      base_tree,
      next_depth,
      tree_count,
      tail
    )
    let new_tail = persistent_vector_copy_chunk(
      region,
      0,
      elem_size,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    vector_store_value<T>(new_tail, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(
      region,
      new_tail,
      elem_mode,
      leaf_count,
      leaf_stride,
      leaf_kind
    )
    persistent_vector_box<T>(
      persistent_vector_make_root(
        region,
        len + 1,
        elem_size,
        elem_mode,
        leaf_count,
        leaf_stride,
        leaf_kind,
        tree_count + 1,
        next_depth,
        next_tree,
        new_tail
      ),
      region
    )
  }
}

--- Return a version with an in-bounds element replaced, leaving `vec` unchanged.
--- An out-of-bounds index returns a semantically unchanged version.
pub(package) fn persistent_vector_set<T>(
  vec: PersistentVector<T>,
  index: i64,
  value: T
) -> PersistentVector<T> {
  let root = persistent_vector_root<T>(vec)
  let region = persistent_vector_region<T>(vec)
  if root == 0 or index < 0 or index >= persistent_vector_len<T>(vec) {
    persistent_vector_box<T>(root, region)
  } else {
    let len = persistent_vector_storage_len(root)
    let elem_size = persistent_vector_storage_element_size(root)
    let elem_mode = persistent_vector_storage_element_mode(root)
    let leaf_count = persistent_vector_storage_element_leaf_count(root)
    let leaf_stride = persistent_vector_storage_element_leaf_stride(root)
    let leaf_kind = persistent_vector_storage_element_leaf_kind(root)
    let tree_count = persistent_vector_storage_tree_count(root)
    let tree_depth = persistent_vector_storage_tree_depth(root)
    let tree_root = persistent_vector_storage_tree_root(root)
    let tail = persistent_vector_storage_tail(root)
    let tail_start = tree_count * persistent_vector_chunk_size()
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    if index >= tail_start {
      let new_tail = persistent_vector_copy_chunk(
        region,
        tail,
        elem_size,
        elem_mode,
        leaf_count,
        leaf_stride,
        leaf_kind
      )
      vector_store_value<T>(
        new_tail + (index - tail_start) * elem_size,
        elem_size,
        elem_mode,
        value
      )
      persistent_vector_storage_register_stored(
        region,
        new_tail + (index - tail_start) * elem_size,
        elem_mode,
        leaf_count,
        leaf_stride,
        leaf_kind
      )
      persistent_vector_box<T>(
        persistent_vector_make_root(
          region,
          len,
          elem_size,
          elem_mode,
          leaf_count,
          leaf_stride,
          leaf_kind,
          tree_count,
          tree_depth,
          tree_root,
          new_tail
        ),
        region
      )
    } else {
      let next_tree = persistent_vector_tree_set<T>(
        region,
        tree_root,
        tree_depth,
        chunk_index,
        slot,
        elem_size,
        elem_mode,
        leaf_count,
        leaf_stride,
        leaf_kind,
        value
      )
      persistent_vector_box<T>(
        persistent_vector_make_root(
          region,
          len,
          elem_size,
          elem_mode,
          leaf_count,
          leaf_stride,
          leaf_kind,
          tree_count,
          tree_depth,
          next_tree,
          tail
        ),
        region
      )
    }
  }
}

pub(package) fn persistent_vector_into_iter<T>(vec: PersistentVector<T>) -> owned Iterator<T> {
  let producer: () -[GeneratorYield]> i64 = () => {
    let mut index = 0
    while index < persistent_vector_len<T>(vec) {
      match persistent_vector_get_option<T>(vec, index) {
        Some(value) -> {
          generator.yield<T>(value)
          0
        }
        None -> 0
      }
      index = index + 1
    }
    0
  }
  from_generator<T, i64>(generator.start<T, i64>(producer))
}

impl<T> PersistentVector<T> {
  --- Return the number of elements.
  pub fn len(self) -> usize {
    vector_count_from_storage(persistent_vector_len<T>(self))
  }

  --- Return whether this vector has no elements.
  pub fn is_empty(self) -> bool {
    persistent_vector_len<T>(self) == 0
  }

  --- Return the element at `index` when it is in bounds.
  pub fn get(self, index: usize) -> Option<T> {
    match num_scalar_usize_to_i64(index) {
      Some(storage_index) -> persistent_vector_get_option<T>(self, storage_index)
      None -> None<T>()
    }
  }

  --- Return a version with `value` appended, leaving this version unchanged.
  pub fn push(self, value: T) -> PersistentVector<T> {
    persistent_vector_push<T>(self, value)
  }

  --- Return an updated version when `index` is in bounds.
  pub fn set(self, index: usize, value: T) -> Option<PersistentVector<T>> {
    match num_scalar_usize_to_i64(index) {
      Some(storage_index) -> if persistent_vector_in_bounds<T>(self, storage_index) {
        Some<PersistentVector<T>>(persistent_vector_set<T>(self, storage_index, value))
      } else {
        None<PersistentVector<T>>()
      }
      None -> None<PersistentVector<T>>()
    }
  }
}

impl<T: Eq> Eq for PersistentVector<T> {
  fn eq(self, other: Self) -> bool {
    if self.len() != other.len() { return false }
    let mut index: usize = 0
    while index < self.len() {
      match (self.get(index), other.get(index)) {
        (Some(left), Some(right)) -> if left != right { return false }
        _ -> return false
      }
      index = index + 1
    }
    true
  }
}

impl<T> IntoIterator for PersistentVector<T> {
  type Item = T

  fn into_iter(self) -> owned Iterator<T> {
    persistent_vector_into_iter<T>(self)
  }
}

impl<T> Collect for PersistentVector<T> {
  type Item = T
  type Output = PersistentVector<T>

  fn from_iter(source: owned Iterator<T>) -> Self {
    let mut values = source
    let mut result = persistent_vector_empty<T>()
    let mut done = false
    while not done {
      match iter_next<T>(values) {
        Some(value) -> {
          result = result.push(value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    result
  }
}

pub(package) fn persistent_vector_is_promoted<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_is_promoted<T>(vec)
}

pub(package) fn persistent_vector_promote<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_promote<T>(vec)
}

pub(package) fn vector_swap_borrowed<T>(vec: borrow mut Vector<T>, left: i64, right: i64) -> bool
{
  vector_storage_swap<T>(vec, left, right)
}

pub(package) fn vector_swap<T>(vec: borrow Vector<T>, left: i64, right: i64) -> bool {
  vector_storage_swap<T>(vec, left, right)
}

-- Restore the max-heap rooted at `start` over the half-open range [0, end).
-- Compiler and runtime worklists whose mutation authority is owned by an
-- enclosing scope sort through the shared handle.
pub(package) fn vector_sort_sift_down_in_place<T>(
  vec: borrow Vector<T>,
  start: i64,
  end: i64,
  cmp: (T, T) -> Ordering
) -> i64 {
  let mut root = start
  let mut done = false
  while not done {
    let child = root * 2 + 1
    if child >= end {
      done = true
    } else {
      let mut candidate = root
      match cmp(
        vector_storage_get_in_bounds<T>(vec, candidate),
        vector_storage_get_in_bounds<T>(vec, child)
      ) {
        Less -> { candidate = child }
        _ -> nil
      }
      let right = child + 1
      if right < end {
        match cmp(
          vector_storage_get_in_bounds<T>(vec, candidate),
          vector_storage_get_in_bounds<T>(vec, right)
        ) {
          Less -> { candidate = right }
          _ -> nil
        }
      } else { nil }
      if candidate == root {
        done = true
      } else {
        vector_storage_swap<T>(vec, root, candidate)
        root = candidate
      }
    }
  }
  1
}

pub(package) fn vector_sort_sift_down<T>(
  vec: borrow mut Vector<T>,
  start: i64,
  end: i64,
  cmp: (T, T) -> Ordering
) -> i64 {
  vector_sort_sift_down_in_place<T>(vec, start, end, cmp)
}

-- Package implementations with enclosing ownership may sort an ordinary
-- managed worklist without exposing its representation.
pub(package) fn vector_sort_by_in_place<T>(vec: borrow Vector<T>, cmp: (T, T) -> Ordering) -> i64
{
  let len = vector_len<T>(vec)
  let mut start = len / 2
  while start > 0 {
    start = start - 1
    vector_sort_sift_down_in_place<T>(vec, start, len, cmp)
  }
  let mut end = len
  while end > 1 {
    end = end - 1
    vector_storage_swap<T>(vec, 0, end)
    vector_sort_sift_down_in_place<T>(vec, 0, end, cmp)
  }
  1
}

-- In-place unstable heapsort: O(n log n) comparisons in the worst case and
-- O(1) auxiliary storage. Returns the same typed vector for pipe-friendly use.
--- Sort in place with a pure total-order comparator and return the same handle.
--- The heapsort is unstable, uses constant auxiliary storage, and is
--- `O(n log n)` in the worst case.
pub(package) fn vector_sort_by<T>(
  vec: owned Vector<T>,
  cmp: (T, T) -> Ordering
) -> owned Vector<T> {
  let mut result = vec
  vector_sort_by_in_place<T>(result, cmp)
  result
}

fn vector_ord_compare<T: Ord>(left: T, right: T) -> Ordering {
  left.compare(right)
}

pub(package) fn vector_sort_in_place<T: Ord>(vec: borrow Vector<T>) -> i64 {
  vector_sort_by_in_place<T>(vec, vector_ord_compare)
}

--- Sort in place by `Ord` and return the same vector handle.
pub(package) fn vector_sort<T: Ord>(vec: owned Vector<T>) -> owned Vector<T> {
  vector_sort_by<T>(vec, vector_ord_compare)
}

impl<T> Vector<T> {
  --- Return the number of initialized elements.
  pub fn len(self: borrow Self) -> usize {
    vector_count_from_storage(vector_len<T>(self))
  }

  --- Return the number of elements the current allocation can hold.
  pub fn capacity(self: borrow Self) -> usize {
    vector_count_from_storage(vector_capacity<T>(self))
  }

  --- Return whether this vector has no elements.
  pub fn is_empty(self: borrow Self) -> bool {
    vector_is_empty<T>(self)
  }

  --- Reserve room for at least `additional` elements beyond the current length.
  --- Panic when the resulting count cannot fit this vector's storage.
  pub fn reserve(self: borrow mut Self, additional: usize) -> nil {
    match vector_try_reserve_additional<T>(self, additional) {
      Ok(_) -> nil
      Err(_) -> panic("Vector capacity is too large")
    }
  }

  --- Try to reserve room for at least `additional` elements beyond the current
  --- length. Default-allocator exhaustion remains process-terminal.
  pub fn try_reserve(self: borrow mut Self, additional: usize) -> Result<nil, CapacityError> {
    vector_try_reserve_additional<T>(self, additional)
  }

  --- Append an element in place.
  pub fn push(self: borrow mut Self, value: T) -> nil {
    if vector_push_borrowed<T>(self, value) { nil }
    else { panic("Vector capacity is too large") }
  }

  --- Return the element at `index` when it is in bounds.
  pub fn get(self: borrow Self, index: usize) -> Option<T> {
    match num_scalar_usize_to_i64(index) {
      Some(storage_index) -> vector_get_option<T>(self, storage_index)
      None -> None<T>()
    }
  }

  --- Replace and return an element, or report the requested index and length.
  pub fn set(self: borrow mut Self, index: usize, value: T) -> Result<T, IndexError> {
    vector_replace<T>(self, index, value)
  }

  --- Exchange two elements, reporting the first invalid index in source order.
  pub fn swap(self: borrow mut Self, left: usize, right: usize) -> Result<nil, IndexError> {
    let length = vector_count_from_storage(vector_len<T>(self))
    if left >= length {
      Err<nil, IndexError>(IndexOutOfBounds(left, length))
    } else {
      if right >= length {
        Err<nil, IndexError>(IndexOutOfBounds(right, length))
      } else {
        match num_scalar_usize_to_i64(left) {
          None -> Err<nil, IndexError>(IndexOutOfBounds(left, length))
          Some(storage_left) -> match num_scalar_usize_to_i64(right) {
            None -> Err<nil, IndexError>(IndexOutOfBounds(right, length))
            Some(storage_right) -> {
              vector_swap_borrowed<T>(self, storage_left, storage_right)
              Ok<nil, IndexError>(nil)
            }
          }
        }
      }
    }
  }

  --- Remove and return the last element, or `None` when empty.
  pub fn pop(self: borrow mut Self) -> Option<T> {
    vector_pop_borrowed<T>(self)
  }

  --- Remove every element in place while retaining allocated capacity.
  pub fn clear(self: borrow mut Self) -> nil {
    vector_clear_borrowed<T>(self)
  }

  --- Fold elements from first to last with a pure callback.
  pub fn fold<A>(self: borrow Self, init: A, f: (A, T) -> A) -> A {
    vector_fold<T, A>(self, init, f)
  }

  --- Transform elements into a new vector in source order.
  pub fn map<U>(self: borrow Self, f: (T) -> U) -> owned Vector<U> {
    vector_map<T, U>(self, f)
  }

  --- Copy the checked half-open range `[start, end)` into a new vector.
  pub fn slice(self: borrow Self, start: usize, end: usize) -> Option<owned Vector<T>> {
    vector_slice_checked<T>(self, start, end)
  }

  --- Insert in place while preserving order; `index == len` appends.
  pub fn insert(self: borrow mut Self, index: usize, value: T) -> Result<nil, IndexError> {
    let length = vector_count_from_storage(vector_len<T>(self))
    if index > length {
      Err<nil, IndexError>(IndexOutOfBounds(index, length))
    } else {
      match num_scalar_usize_to_i64(index) {
        None -> Err<nil, IndexError>(IndexOutOfBounds(index, length))
        Some(storage_index) -> if vector_insert_at_borrowed<T>(self, storage_index, value) {
          Ok<nil, IndexError>(nil)
        } else {
          panic("Vector capacity is too large")
        }
      }
    }
  }

  --- Remove and return an element while preserving order.
  pub fn remove(self: borrow mut Self, index: usize) -> Option<T> {
    match num_scalar_usize_to_i64(index) {
      Some(storage_index) -> vector_remove_at_borrowed<T>(self, storage_index)
      None -> None<T>()
    }
  }

  --- Copy this vector followed by `other` into a new vector.
  pub fn concat(self: borrow Self, other: borrow Vector<T>) -> owned Vector<T> {
    vector_concat<T>(self, other)
  }

  --- Reverse in place and return this vector handle.
  pub fn reverse(self: owned Self) -> owned Vector<T> {
    vector_reverse<T>(self)
  }

  --- Copy elements accepted by a pure predicate into a new vector.
  pub fn filter(self: borrow Self, predicate: (T) -> bool) -> owned Vector<T> {
    vector_filter<T>(self, predicate)
  }

  --- Return the first element accepted by a pure predicate.
  pub fn find(self: borrow Self, predicate: (T) -> bool) -> Option<T> {
    vector_find<T>(self, predicate)
  }

  --- Return the first index equivalent to `needle` under `same`.
  pub fn index_of_by(self: borrow Self, needle: T, same: (T, T) -> bool) -> Option<usize> {
    vector_index_of_by<T>(self, needle, same)
  }

  --- Copy while collapsing adjacent elements equivalent under `same`.
  pub fn dedup_by(self: borrow Self, same: (T, T) -> bool) -> owned Vector<T> {
    vector_dedup_by<T>(self, same)
  }

  --- Sort in place with a pure comparator and return this vector handle.
  pub fn sort_by(self: owned Self, cmp: (T, T) -> Ordering) -> owned Vector<T> {
    vector_sort_by<T>(self, cmp)
  }
}

impl<T: Ord> Vector<T> {
  --- Return the first index equal to `needle` under `Ord`.
  pub fn index_of(self: borrow Self, needle: T) -> Option<usize> {
    vector_index_of<T>(self, needle)
  }

  --- Return whether an `Ord`-equal element is present.
  pub fn contains(self: borrow Self, needle: T) -> bool {
    vector_contains<T>(self, needle)
  }

  --- Copy while collapsing adjacent `Ord`-equal elements.
  pub fn dedup(self: borrow Self) -> owned Vector<T> {
    vector_dedup<T>(self)
  }

  --- Sort in place by `Ord` and return this vector handle.
  pub fn sort(self: owned Self) -> owned Vector<T> {
    vector_sort<T>(self)
  }
}
