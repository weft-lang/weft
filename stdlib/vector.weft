-- stdlib/vector.weft — mutable contiguous vectors
--
-- Vector handles are raw pointers to [data, length, capacity, elem_size,
-- elem_mode]. Boxed/runtime-managed values still use one-word handles, while
-- scalar numeric elements and eligible plain records can use concrete payload
-- storage.

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "runtime/rc.weft"
use "stdlib/option.weft"

fn vector_header_size() -> i64 { 40 }
fn vector_data_offset() -> i64 { 0 }
fn vector_len_offset() -> i64 { 8 }
fn vector_capacity_offset() -> i64 { 16 }
fn vector_element_size_offset() -> i64 { 24 }
fn vector_element_mode_offset() -> i64 { 32 }

fn vector_element_mode_word() -> i64 { 0 }
fn vector_element_mode_record_payload() -> i64 { 7 }

fn vector_element_size_of<T>() -> i64 { 8 }

fn vector_element_mode_of<T>() -> i64 { vector_element_mode_word() }

fn vector_normalize_capacity(capacity: i64) -> i64 {
  if capacity < 0 { 0 } else { capacity }
}

fn vector_new<T>() -> i64 {
  vector_with_capacity<T>(0)
}

fn vector_with_capacity<T>(capacity: i64) -> i64 {
  let cap = vector_normalize_capacity(capacity)
  let elem_size = vector_element_size_of<T>()
  let elem_mode = vector_element_mode_of<T>()
  let header = alloc_bump(vector_header_size())
  let data = if cap == 0 or elem_size <= 0 { 0 } else { alloc_bump(cap * elem_size) }
  __mem_store64(header + vector_data_offset(), data)
  __mem_store64(header + vector_len_offset(), 0)
  __mem_store64(header + vector_capacity_offset(), cap)
  __mem_store64(header + vector_element_size_offset(), elem_size)
  __mem_store64(header + vector_element_mode_offset(), elem_mode)
  header
}

fn vector_len(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_len_offset()) }
}

fn vector_capacity(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_capacity_offset()) }
}

fn vector_data(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_data_offset()) }
}

fn vector_element_size(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_element_size_offset()) }
}

fn vector_element_mode(vec: i64) -> i64 {
  if vec == 0 { vector_element_mode_word() } else { __mem_load64(vec + vector_element_mode_offset()) }
}

fn vector_capacity_bytes(vec: i64) -> i64 {
  vector_capacity(vec) * vector_element_size(vec)
}

fn vector_is_empty(vec: i64) -> i64 {
  if vector_len(vec) == 0 { 1 } else { 0 }
}

fn vector_next_capacity(current: i64, needed: i64) -> i64 {
  let mut cap = if current <= 0 { 1 } else { current * 2 }
  while cap < needed {
    cap = cap * 2
  }
  cap
}

fn vector_reserve<T>(vec: i64, needed: i64) -> i64 {
  if vec == 0 { 0 }
  else {
    let cap = vector_capacity(vec)
    if needed <= cap { vec }
    else {
      let len = vector_len(vec)
      let old_data = vector_data(vec)
      let elem_size = vector_element_size(vec)
      let new_cap = vector_next_capacity(cap, needed)
      let new_data = if elem_size <= 0 { 0 } else { alloc_bump(new_cap * elem_size) }
      if old_data != 0 and new_data != 0 { mem_copy(new_data, old_data, len * elem_size) } else { 0 }
      __mem_store64(vec + vector_data_offset(), new_data)
      __mem_store64(vec + vector_capacity_offset(), new_cap)
      vec
    }
  }
}

fn vector_push<T>(vec: i64, value: T) -> i64 {
  if vec == 0 { 0 }
  else {
    let len = vector_len(vec)
    vector_reserve<T>(vec, len + 1)
    let data = vector_data(vec)
    let elem_size = vector_element_size(vec)
    vector_store_value<T>(data + len * elem_size, elem_size, vector_element_mode(vec), value)
    __mem_store64(vec + vector_len_offset(), len + 1)
    vec
  }
}

fn vector_in_bounds(vec: i64, index: i64) -> i64 {
  if index < 0 { 0 }
  else { if index >= vector_len(vec) { 0 } else { 1 } }
}

fn vector_load_value<T>(addr: i64, elem_size: i64, elem_mode: i64, default: T) -> T {
  if elem_size <= 0 { default } else { __mem_load_sized(addr, elem_size, elem_mode) }
}

fn vector_store_value<T>(addr: i64, elem_size: i64, elem_mode: i64, value: T) -> i64 {
  if elem_size <= 0 { 0 } else { __mem_store_sized(addr, elem_size, elem_mode, value) 0 }
}

fn vector_get<T>(vec: i64, index: i64, default: T) -> T {
  if vector_in_bounds(vec, index) == 0 {
    default
  } else {
    let elem_size = vector_element_size(vec)
    vector_load_value<T>(vector_data(vec) + index * elem_size, elem_size, vector_element_mode(vec), default)
  }
}

fn vector_get_option<T>(vec: i64, index: i64) -> i64 {
  if vector_in_bounds(vec, index) == 0 {
    None
  } else {
    let elem_size = vector_element_size(vec)
    Some<T>(vector_load_value<T>(vector_data(vec) + index * elem_size, elem_size, vector_element_mode(vec), __mem_load64(None)))
  }
}

fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 {
  if vector_in_bounds(vec, index) == 0 {
    0
  } else {
    let elem_size = vector_element_size(vec)
    vector_store_value<T>(vector_data(vec) + index * elem_size, elem_size, vector_element_mode(vec), value)
    1
  }
}

fn vector_pop<T>(vec: i64) -> i64 {
  let len = vector_len(vec)
  if len <= 0 {
    None
  } else {
    let next_len = len - 1
    let elem_size = vector_element_size(vec)
    let value = vector_load_value<T>(vector_data(vec) + next_len * elem_size, elem_size, vector_element_mode(vec), __mem_load64(None))
    __mem_store64(vec + vector_len_offset(), next_len)
    Some<T>(value)
  }
}

fn vector_clear(vec: i64) -> i64 {
  if vec == 0 { 0 }
  else {
    __mem_store64(vec + vector_len_offset(), 0)
    vec
  }
}

fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let len = vector_len(vec)
  let data = vector_data(vec)
  let elem_size = vector_element_size(vec)
  let elem_mode = vector_element_mode(vec)
  for i in 0..len {
    acc = f(acc, vector_load_value<T>(data + i * elem_size, elem_size, elem_mode, __mem_load64(None)))
  }
  acc
}

fn vector_map<T, U>(vec: i64, f: (T) -> U) -> i64 {
  let len = vector_len(vec)
  let result = vector_with_capacity<U>(len)
  let data = vector_data(vec)
  let elem_size = vector_element_size(vec)
  let elem_mode = vector_element_mode(vec)
  for i in 0..len {
    vector_push<U>(result, f(vector_load_value<T>(data + i * elem_size, elem_size, elem_mode, __mem_load64(None))))
  }
  result
}

fn vector_from_range(start: i64, end: i64) -> i64 {
  let size = if end <= start { 0 } else { end - start }
  let result = vector_with_capacity<i64>(size)
  for i in start..end {
    vector_push<i64>(result, i)
  }
  result
}

fn vector_index_of_i64(vec: i64, needle: i64) -> i64 {
  let len = vector_len(vec)
  let data = vector_data(vec)
  let elem_size = vector_element_size(vec)
  let elem_mode = vector_element_mode(vec)
  let mut result = 0 - 1
  let mut i = 0
  while i < len {
    if vector_load_value<i64>(data + i * elem_size, elem_size, elem_mode, 0) == needle {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

fn vector_contains_i64(vec: i64, needle: i64) -> i64 {
  if vector_index_of_i64(vec, needle) < 0 { 0 } else { 1 }
}

-- Managed persistent vector scaffold
--
-- The mutable Vector above stays the hot local-mutation representation. This
-- surface is for immutable shared data: one managed root box points at a raw
-- immutable header whose chunk table and chunks are path-copied on update.
fn persistent_vector_chunk_size() -> i64 { 32 }
fn persistent_vector_header_size() -> i64 { 40 }
fn persistent_vector_len_offset() -> i64 { 0 }
fn persistent_vector_element_size_offset() -> i64 { 8 }
fn persistent_vector_element_mode_offset() -> i64 { 16 }
fn persistent_vector_chunk_count_offset() -> i64 { 24 }
fn persistent_vector_chunks_offset() -> i64 { 32 }

fn persistent_vector_box(root: i64) -> rc i64 {
  let box: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(box, root)
  box
}

fn persistent_vector_make_root(len: i64, elem_size: i64, elem_mode: i64, chunk_count: i64, chunks: i64) -> i64 {
  let root = alloc_bump(persistent_vector_header_size())
  __mem_store64(root + persistent_vector_len_offset(), len)
  __mem_store64(root + persistent_vector_element_size_offset(), elem_size)
  __mem_store64(root + persistent_vector_element_mode_offset(), elem_mode)
  __mem_store64(root + persistent_vector_chunk_count_offset(), chunk_count)
  __mem_store64(root + persistent_vector_chunks_offset(), chunks)
  root
}

fn persistent_vector_new<T>() -> rc i64 {
  persistent_vector_box(persistent_vector_make_root(0, vector_element_size_of<T>(), vector_element_mode_of<T>(), 0, 0))
}

fn persistent_vector_root(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec) }
}

fn persistent_vector_len(vec: i64) -> i64 {
  let root = persistent_vector_root(vec)
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_len_offset()) }
}

fn persistent_vector_chunk_count(vec: i64) -> i64 {
  let root = persistent_vector_root(vec)
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_chunk_count_offset()) }
}

fn persistent_vector_in_bounds(vec: i64, index: i64) -> i64 {
  if index < 0 { 0 } else { if index >= persistent_vector_len(vec) { 0 } else { 1 } }
}

fn persistent_vector_get<T>(vec: i64, index: i64, default: T) -> T {
  let root = persistent_vector_root(vec)
  if root == 0 or index < 0 or index >= persistent_vector_len(vec) {
    default
  } else {
    let elem_size = __mem_load64(root + persistent_vector_element_size_offset())
    let elem_mode = __mem_load64(root + persistent_vector_element_mode_offset())
    let chunks = __mem_load64(root + persistent_vector_chunks_offset())
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    let chunk = __mem_load64(chunks + chunk_index * 8)
    vector_load_value<T>(chunk + slot * elem_size, elem_size, elem_mode, default)
  }
}

fn persistent_vector_push<T>(vec: i64, value: T) -> rc i64 {
  let root = persistent_vector_root(vec)
  let len = if root == 0 { 0 } else { __mem_load64(root + persistent_vector_len_offset()) }
  let elem_size = if root == 0 { vector_element_size_of<T>() } else { __mem_load64(root + persistent_vector_element_size_offset()) }
  let elem_mode = if root == 0 { vector_element_mode_of<T>() } else { __mem_load64(root + persistent_vector_element_mode_offset()) }
  let old_chunk_count = if root == 0 { 0 } else { __mem_load64(root + persistent_vector_chunk_count_offset()) }
  let old_chunks = if root == 0 { 0 } else { __mem_load64(root + persistent_vector_chunks_offset()) }
  let slot = len - len / persistent_vector_chunk_size() * persistent_vector_chunk_size()
  let new_chunk_count = if slot == 0 { old_chunk_count + 1 } else { old_chunk_count }
  let new_chunks = if new_chunk_count <= 0 { 0 } else { alloc_bump(new_chunk_count * 8) }
  if old_chunk_count > 0 and old_chunks != 0 and new_chunks != 0 {
    mem_copy(new_chunks, old_chunks, old_chunk_count * 8)
  } else { 0 }
  let chunk = alloc_bump(persistent_vector_chunk_size() * elem_size)
  if slot != 0 and old_chunks != 0 {
    let old_chunk = __mem_load64(old_chunks + (old_chunk_count - 1) * 8)
    mem_copy(chunk, old_chunk, persistent_vector_chunk_size() * elem_size)
  } else { 0 }
  vector_store_value<T>(chunk + slot * elem_size, elem_size, elem_mode, value)
  __mem_store64(new_chunks + (new_chunk_count - 1) * 8, chunk)
  persistent_vector_box(persistent_vector_make_root(len + 1, elem_size, elem_mode, new_chunk_count, new_chunks))
}

fn persistent_vector_set<T>(vec: i64, index: i64, value: T) -> rc i64 {
  let root = persistent_vector_root(vec)
  if root == 0 or index < 0 or index >= persistent_vector_len(vec) {
    persistent_vector_box(root)
  } else {
    let len = __mem_load64(root + persistent_vector_len_offset())
    let elem_size = __mem_load64(root + persistent_vector_element_size_offset())
    let elem_mode = __mem_load64(root + persistent_vector_element_mode_offset())
    let chunk_count = __mem_load64(root + persistent_vector_chunk_count_offset())
    let old_chunks = __mem_load64(root + persistent_vector_chunks_offset())
    let new_chunks = alloc_bump(chunk_count * 8)
    mem_copy(new_chunks, old_chunks, chunk_count * 8)
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    let old_chunk = __mem_load64(old_chunks + chunk_index * 8)
    let new_chunk = alloc_bump(persistent_vector_chunk_size() * elem_size)
    mem_copy(new_chunk, old_chunk, persistent_vector_chunk_size() * elem_size)
    vector_store_value<T>(new_chunk + slot * elem_size, elem_size, elem_mode, value)
    __mem_store64(new_chunks + chunk_index * 8, new_chunk)
    persistent_vector_box(persistent_vector_make_root(len, elem_size, elem_mode, chunk_count, new_chunks))
  }
}

fn vector_swap<T>(vec: i64, left: i64, right: i64) -> i64 {
  if vector_in_bounds(vec, left) == 0 { 0 }
  else { if vector_in_bounds(vec, right) == 0 { 0 }
  else {
    let data = vector_data(vec)
    let elem_size = vector_element_size(vec)
    let elem_mode = vector_element_mode(vec)
    let a = vector_load_value<T>(data + left * elem_size, elem_size, elem_mode, __mem_load64(None))
    let b = vector_load_value<T>(data + right * elem_size, elem_size, elem_mode, __mem_load64(None))
    vector_store_value<T>(data + left * elem_size, elem_size, elem_mode, b)
    vector_store_value<T>(data + right * elem_size, elem_size, elem_mode, a)
    1
  } }
}
