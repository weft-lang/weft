-- stdlib/vector.weft — mutable contiguous vectors
--
-- Vector handles are compiler-managed pointers to
-- [data, length, capacity, elem_size, elem_mode]. Boxed/runtime-managed
-- values still use one-word handles, while scalar numeric elements and
-- eligible plain records can use concrete payload storage.

use "runtime/memory.weft"
use "runtime/vector_storage.weft"
use "stdlib/option.weft"
use "stdlib/ord.weft"

-- A sealed nominal handle. Its runtime representation is the storage pointer
-- itself; trusted runtime/vector_storage.weft is the only inhabitant producer.
-- The element argument is therefore a real static identity with no wrapper
-- allocation and no change to the optimizer's vector value facts.
type Vector<T> { }

-- Immutable vectors use the same sealed, zero-wrapper representation over a
-- persistent-region root box. The type argument prevents versions with
-- different element types from crossing at public call sites.
type PersistentVector<T> { }
type PersistentVectorStorageRegion { }

fn vector_header_size() -> i64 { vector_storage_header_size() }
fn vector_data_offset() -> i64 { 0 }
fn vector_len_offset() -> i64 { 8 }
fn vector_capacity_offset() -> i64 { 16 }
fn vector_element_size_offset() -> i64 { 24 }
fn vector_element_mode_offset() -> i64 { 32 }

fn vector_element_mode_word() -> i64 { 0 }
fn vector_element_mode_record_payload() -> i64 { 7 }

fn vector_element_size_of<T>() -> i64 { 8 }

fn vector_element_mode_of<T>() -> i64 { vector_element_mode_word() }

fn vector_normalize_capacity(capacity: i64) -> i64 {
  if capacity < 0 { 0 } else { capacity }
}

fn vector_new<T>() -> Vector<T> {
  vector_with_capacity<T>(0)
}

fn vector_with_capacity<T>(capacity: i64) -> Vector<T> {
  let cap = vector_normalize_capacity(capacity)
  let elem_size = vector_element_size_of<T>()
  let elem_mode = vector_element_mode_of<T>()
  vector_storage_new<T>(cap, elem_size, elem_mode)
}

fn vector_len<T>(vec: Vector<T>) -> i64 {
  vector_storage_len<T>(vec)
}

fn vector_capacity<T>(vec: Vector<T>) -> i64 {
  vector_storage_capacity<T>(vec)
}

fn vector_data<T>(vec: Vector<T>) -> i64 {
  vector_storage_data<T>(vec)
}

fn vector_element_size<T>(vec: Vector<T>) -> i64 {
  vector_storage_element_size<T>(vec)
}

fn vector_element_mode<T>(vec: Vector<T>) -> i64 {
  vector_storage_element_mode<T>(vec)
}

fn vector_capacity_bytes<T>(vec: Vector<T>) -> i64 {
  vector_capacity<T>(vec) * vector_element_size<T>(vec)
}

fn vector_is_empty<T>(vec: Vector<T>) -> i64 {
  if vector_len<T>(vec) == 0 { 1 } else { 0 }
}

fn vector_next_capacity(current: i64, needed: i64) -> i64 {
  let mut cap = if current <= 0 { 1 } else { current * 2 }
  while cap < needed {
    cap = cap * 2
  }
  cap
}

fn vector_reserve<T>(vec: Vector<T>, needed: i64) -> i64 {
  if vector_storage_is_null<T>(vec) == 1 { 0 }
  else {
    let cap = vector_capacity<T>(vec)
    if needed <= cap { 1 }
    else {
      let len = vector_len<T>(vec)
      let old_data = vector_data<T>(vec)
      let elem_size = vector_element_size<T>(vec)
      let new_cap = vector_next_capacity(cap, needed)
      let new_data = vector_storage_alloc_bytes(new_cap * elem_size)
      if old_data != 0 and new_data != 0 { mem_copy(new_data, old_data, len * elem_size) } else { 0 }
      -- Growth abandons the old buffer; element stakes moved with the
      -- copy, so the raw bytes go straight back to the heap. Keep the
      -- old buffer if the new allocation failed — it is still live.
      if new_data != 0 {
        vector_storage_free_bytes(old_data, cap * elem_size)
        vector_storage_set_data_capacity<T>(vec, new_data, new_cap)
        1
      } else { 0 }
    }
  }
}

fn vector_push<T>(vec: Vector<T>, value: T) -> i64 {
  if vector_storage_is_null<T>(vec) == 1 { 0 }
  else {
    let len = vector_len<T>(vec)
    if vector_reserve<T>(vec, len + 1) == 0 { 0 }
    else {
      let data = vector_data<T>(vec)
      let elem_size = vector_element_size<T>(vec)
      vector_store_value<T>(data + len * elem_size, elem_size, vector_element_mode<T>(vec), value)
      vector_storage_set_len<T>(vec, len + 1)
      1
    }
  }
}

fn vector_in_bounds<T>(vec: Vector<T>, index: i64) -> i64 {
  if index < 0 { 0 }
  else { if index >= vector_len<T>(vec) { 0 } else { 1 } }
}

fn vector_load_value<T>(addr: i64, elem_size: i64, elem_mode: i64, default: T) -> T {
  vector_storage_load_value<T>(addr, elem_size, elem_mode, default)
}

fn vector_store_value<T>(addr: i64, elem_size: i64, elem_mode: i64, value: T) -> i64 {
  vector_storage_store_value<T>(addr, elem_size, elem_mode, value)
}

fn vector_get<T>(vec: Vector<T>, index: i64, default: T) -> T {
  if vector_in_bounds<T>(vec, index) == 0 {
    default
  } else {
    let elem_size = vector_element_size<T>(vec)
    vector_load_value<T>(vector_data<T>(vec) + index * elem_size, elem_size, vector_element_mode<T>(vec), default)
  }
}

fn vector_get_in_bounds<T>(vec: Vector<T>, index: i64) -> T {
  let elem_size = vector_element_size<T>(vec)
  vector_storage_load_value_in_bounds<T>(vector_data<T>(vec) + index * elem_size, elem_size, vector_element_mode<T>(vec))
}

-- Borrowed field read: payload `field` of the managed element at
-- `index`, without materialising an owned element reference. The
-- element stays container-owned for the duration of the read (no user
-- code runs inside), and the RESULT follows F's static ownership
-- class: managed payloads are retained (+1, released by the caller's
-- machinery at lifetime end), scalars are plain copies. Caller
-- maintains bounds, like vector_get_in_bounds. Managed-element vectors
-- only (the slot holds a pointer to a heap object).
fn vector_get_field_in_bounds<T, F>(vec: Vector<T>, index: i64, field: i64) -> F {
  let w = vector_storage_field_word(vector_data<T>(vec) + index * vector_element_size<T>(vec), field)
  if vector_element_mode_of<F>() == vector_storage_managed_mode() { vector_storage_retain_word(w) } else { 0 }
  vector_storage_word_as<F>(w)
}

fn vector_get_option<T>(vec: Vector<T>, index: i64) -> Option<T> {
  if vector_in_bounds<T>(vec, index) == 0 {
    option_none<T>()
  } else {
    let elem_size = vector_element_size<T>(vec)
    option_some<T>(vector_storage_load_value_in_bounds<T>(vector_data<T>(vec) + index * elem_size, elem_size, vector_element_mode<T>(vec)))
  }
}

fn vector_set<T>(vec: Vector<T>, index: i64, value: T) -> i64 {
  if vector_in_bounds<T>(vec, index) == 0 {
    0
  } else {
    let elem_size = vector_element_size<T>(vec)
    let elem_mode = vector_element_mode<T>(vec)
    -- Overwrite drops the container's stake in the old element before
    -- the store retains the new one (2q slice 2).
    vector_storage_release_element(vector_data<T>(vec) + index * elem_size, elem_mode)
    vector_store_value<T>(vector_data<T>(vec) + index * elem_size, elem_size, elem_mode, value)
    1
  }
}

fn vector_pop<T>(vec: Vector<T>) -> Option<T> {
  let len = vector_len<T>(vec)
  if len <= 0 {
    option_none<T>()
  } else {
    let next_len = len - 1
    let elem_size = vector_element_size<T>(vec)
    let value = vector_storage_load_value_in_bounds<T>(vector_data<T>(vec) + next_len * elem_size, elem_size, vector_element_mode<T>(vec))
    vector_storage_set_len<T>(vec, next_len)
    -- Wrap first (the option constructor retains the payload), then drop
    -- the container's stake in the popped slot.
    let result = option_some<T>(value)
    vector_storage_release_element(vector_data<T>(vec) + next_len * elem_size, vector_element_mode<T>(vec))
    result
  }
}

fn vector_clear<T>(vec: Vector<T>) -> i64 {
  if vector_storage_is_null<T>(vec) == 1 { 0 }
  else {
    let len = vector_len<T>(vec)
    let elem_size = vector_element_size<T>(vec)
    let elem_mode = vector_element_mode<T>(vec)
    let mut i = 0
    while i < len {
      vector_storage_release_element(vector_data<T>(vec) + i * elem_size, elem_mode)
      i = i + 1
    }
    vector_storage_set_len<T>(vec, 0)
  }
}

fn vector_fold<T, A>(vec: Vector<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let len = vector_len<T>(vec)
  let data = vector_data<T>(vec)
  let elem_size = vector_element_size<T>(vec)
  let elem_mode = vector_element_mode<T>(vec)
  for i in 0..len {
    acc = f(acc, vector_storage_load_value_in_bounds<T>(data + i * elem_size, elem_size, elem_mode))
  }
  acc
}

fn vector_sum_i64(vec: Vector<i64>, init: i64) -> i64 {
  let mut acc = init
  let len = vector_len<i64>(vec)
  let mut i = 0
  while i < len {
    acc = acc + vector_get<i64>(vec, i, 0)
    i = i + 1
  }
  acc
}

fn vector_map<T, U>(vec: Vector<T>, f: (T) -> U) -> Vector<U> {
  let len = vector_len<T>(vec)
  let result = vector_with_capacity<U>(len)
  let data = vector_data<T>(vec)
  let elem_size = vector_element_size<T>(vec)
  let elem_mode = vector_element_mode<T>(vec)
  for i in 0..len {
    vector_push<U>(result, f(vector_storage_load_value_in_bounds<T>(data + i * elem_size, elem_size, elem_mode)))
  }
  result
}

-- Copy the clamped half-open range [start, end). Negative starts clamp to
-- zero, oversized ends clamp to the vector length, and inverted ranges are
-- empty. The source vector is unchanged.
fn vector_slice<T>(vec: Vector<T>, start: i64, end: i64) -> Vector<T> {
  let len = vector_len<T>(vec)
  let from = if start < 0 { 0 } else { if start > len { len } else { start } }
  let to = if end < 0 { 0 } else { if end > len { len } else { end } }
  let count = if to <= from { 0 } else { to - from }
  let result = vector_with_capacity<T>(count)
  let mut i = from
  while i < to {
    vector_push<T>(result, vector_get_in_bounds<T>(vec, i))
    i = i + 1
  }
  result
}

-- Insert while preserving order. `index == len` appends; indices outside
-- [0, len] leave the vector unchanged and return zero.
fn vector_insert_at<T>(vec: Vector<T>, index: i64, value: T) -> i64 {
  let len = vector_len<T>(vec)
  if index < 0 or index > len { 0 }
  else {
    if vector_push<T>(vec, value) == 0 { 0 }
    else {
      let mut i = len
      while i > index {
        vector_swap<T>(vec, i - 1, i)
        i = i - 1
      }
      1
    }
  }
}

-- Remove while preserving order. Invalid indices return None without
-- changing the vector.
fn vector_remove_at<T>(vec: Vector<T>, index: i64) -> Option<T> {
  let len = vector_len<T>(vec)
  if index < 0 or index >= len { option_none<T>() }
  else {
    let mut i = index
    while i + 1 < len {
      vector_swap<T>(vec, i, i + 1)
      i = i + 1
    }
    vector_pop<T>(vec)
  }
}

fn vector_concat<T>(left: Vector<T>, right: Vector<T>) -> Vector<T> {
  let left_len = vector_len<T>(left)
  let right_len = vector_len<T>(right)
  let result = vector_with_capacity<T>(left_len + right_len)
  for i in 0..left_len {
    vector_push<T>(result, vector_get_in_bounds<T>(left, i))
  }
  for i in 0..right_len {
    vector_push<T>(result, vector_get_in_bounds<T>(right, i))
  }
  result
}

-- Reverse in place and return the same handle for pipe-friendly use.
fn vector_reverse<T>(vec: Vector<T>) -> Vector<T> {
  let len = vector_len<T>(vec)
  let mut left = 0
  let mut right = len - 1
  while left < right {
    vector_swap<T>(vec, left, right)
    left = left + 1
    right = right - 1
  }
  vec
}

fn vector_filter<T>(vec: Vector<T>, predicate: (T) -> bool) -> Vector<T> {
  let len = vector_len<T>(vec)
  let result = vector_with_capacity<T>(len)
  for i in 0..len {
    let value = vector_get_in_bounds<T>(vec, i)
    if predicate(value) {
      vector_push<T>(result, value)
    } else { 0 }
  }
  result
}

fn vector_find<T>(vec: Vector<T>, predicate: (T) -> bool) -> Option<T> {
  let len = vector_len<T>(vec)
  let mut result = option_none<T>()
  let mut i = 0
  while i < len {
    let value = vector_get_in_bounds<T>(vec, i)
    if predicate(value) {
      result = option_some<T>(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

fn vector_index_of_by<T>(vec: Vector<T>, needle: T, same: (T, T) -> bool) -> Option<usize> {
  let len = vector_len<T>(vec)
  let mut result = option_none<usize>()
  let mut i = 0
  while i < len {
    if same(vector_get_in_bounds<T>(vec, i), needle) {
      result = option_some<usize>(__i64_to_usize(i))
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

fn vector_ord_equal<T: Ord>(left: T, right: T) -> bool {
  ord_compare<T>(left, right) == 0
}

fn vector_index_of<T: Ord>(vec: Vector<T>, needle: T) -> Option<usize> {
  vector_index_of_by<T>(vec, needle, vector_ord_equal)
}

fn vector_contains<T: Ord>(vec: Vector<T>, needle: T) -> i64 {
  match vector_index_of<T>(vec, needle) {
    Some(index) -> 1
    None -> 0
  }
}

-- Return a new vector with adjacent equivalent elements collapsed. This is
-- linear and leaves the source unchanged; non-adjacent duplicates remain.
fn vector_dedup_by<T>(vec: Vector<T>, same: (T, T) -> bool) -> Vector<T> {
  let len = vector_len<T>(vec)
  let result = vector_with_capacity<T>(len)
  for i in 0..len {
    let value = vector_get_in_bounds<T>(vec, i)
    let keep = if vector_is_empty<T>(result) == 1 { true }
      else { not same(vector_get_in_bounds<T>(result, vector_len<T>(result) - 1), value) }
    if keep { vector_push<T>(result, value) } else { 0 }
  }
  result
}

fn vector_dedup<T: Ord>(vec: Vector<T>) -> Vector<T> {
  vector_dedup_by<T>(vec, vector_ord_equal)
}

fn vector_from_range(start: i64, end: i64) -> Vector<i64> {
  let size = if end <= start { 0 } else { end - start }
  let result = vector_with_capacity<i64>(size)
  for i in start..end {
    vector_push<i64>(result, i)
  }
  result
}

fn vector_index_of_i64(vec: Vector<i64>, needle: i64) -> Option<usize> {
  vector_index_of<i64>(vec, needle)
}

fn vector_contains_i64(vec: Vector<i64>, needle: i64) -> i64 {
  vector_contains<i64>(vec, needle)
}

-- Managed persistent vector scaffold
--
-- The mutable Vector above stays the hot local-mutation representation. This
-- surface is for immutable shared data: one managed root box points at an
-- immutable vector header. Completed chunks live in a 32-way tree; the current
-- partial chunk lives in a tail. Updates path-copy the touched tree branch or
-- tail while older roots keep their view. Every version in a family retains one
-- region owner; cross-thread promotion marks that owner without walking the
-- tree, and the last version releases managed-element stakes and unmaps all
-- structural-copy segments together.
fn persistent_vector_chunk_size() -> i64 { persistent_vector_storage_chunk_size() }
fn persistent_vector_header_size() -> i64 { persistent_vector_storage_header_size() }
fn persistent_vector_node_size() -> i64 { persistent_vector_storage_node_size() }
fn persistent_vector_len_offset() -> i64 { 0 }
fn persistent_vector_element_size_offset() -> i64 { 8 }
fn persistent_vector_element_mode_offset() -> i64 { 16 }
fn persistent_vector_tree_count_offset() -> i64 { 24 }
fn persistent_vector_tree_depth_offset() -> i64 { 32 }
fn persistent_vector_tree_root_offset() -> i64 { 40 }
fn persistent_vector_tail_offset() -> i64 { 48 }

fn persistent_vector_box<T>(root: i64, region: i64) -> PersistentVector<T> {
  persistent_vector_storage_box<T>(root, region)
}

fn persistent_vector_make_root(region: i64, len: i64, elem_size: i64, elem_mode: i64, tree_count: i64, tree_depth: i64, tree_root: i64, tail: i64) -> i64 {
  persistent_vector_storage_make_root(region, len, elem_size, elem_mode, tree_count, tree_depth, tree_root, tail)
}

fn persistent_vector_new<T>() -> PersistentVector<T> {
  let region = persistent_vector_storage_region_new()
  let raw_region = persistent_vector_storage_region_word(region)
  let root = persistent_vector_make_root(raw_region, 0, vector_element_size_of<T>(), vector_element_mode_of<T>(), 0, 1, 0, 0)
  persistent_vector_box<T>(root, raw_region)
}

fn persistent_vector_root<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_root<T>(vec)
}

fn persistent_vector_region<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_region<T>(vec)
}

fn persistent_vector_len<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_len(root)
}

fn persistent_vector_chunk_count<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  if root == 0 {
    0
  } else {
    let len = persistent_vector_storage_len(root)
    if len == 0 { 0 } else { (len + persistent_vector_chunk_size() - 1) / persistent_vector_chunk_size() }
  }
}

fn persistent_vector_tree_depth<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tree_depth(root)
}

fn persistent_vector_tree_root<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tree_root(root)
}

fn persistent_vector_tail<T>(vec: PersistentVector<T>) -> i64 {
  let root = persistent_vector_root<T>(vec)
  persistent_vector_storage_tail(root)
}

fn persistent_vector_in_bounds<T>(vec: PersistentVector<T>, index: i64) -> i64 {
  if index < 0 { 0 } else { if index >= persistent_vector_len<T>(vec) { 0 } else { 1 } }
}

fn persistent_vector_pow32(exp: i64) -> i64 {
  let mut result = 1
  let mut i = 0
  while i < exp {
    result = result * persistent_vector_chunk_size()
    i = i + 1
  }
  result
}

fn persistent_vector_slot(chunk_index: i64, depth: i64) -> i64 {
  let div = persistent_vector_pow32(depth - 1)
  let value = chunk_index / div
  value - value / persistent_vector_chunk_size() * persistent_vector_chunk_size()
}

fn persistent_vector_tail_count_for_len(len: i64, tree_count: i64) -> i64 {
  len - tree_count * persistent_vector_chunk_size()
}

fn persistent_vector_copy_node(region: i64, node: i64) -> i64 {
  persistent_vector_storage_copy_node(region, node)
}

fn persistent_vector_copy_chunk(region: i64, chunk: i64, elem_size: i64, elem_mode: i64) -> i64 {
  persistent_vector_storage_copy_chunk(region, chunk, elem_size, elem_mode)
}

fn persistent_vector_tree_chunk(node: i64, depth: i64, chunk_index: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let slot = persistent_vector_slot(chunk_index, depth)
    let child = persistent_vector_storage_node_child(node, slot)
    if depth <= 1 { child } else { persistent_vector_tree_chunk(child, depth - 1, chunk_index) }
  }
}

fn persistent_vector_tree_assoc_chunk(region: i64, node: i64, depth: i64, chunk_index: i64, chunk: i64) -> i64 {
  let next = persistent_vector_copy_node(region, node)
  let slot = persistent_vector_slot(chunk_index, depth)
  if depth <= 1 {
    persistent_vector_storage_node_set_child(next, slot, chunk)
  } else {
    let old_child = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_child = persistent_vector_tree_assoc_chunk(region, old_child, depth - 1, chunk_index, chunk)
    persistent_vector_storage_node_set_child(next, slot, new_child)
  }
  next
}

fn persistent_vector_tree_set<T>(region: i64, node: i64, depth: i64, chunk_index: i64, slot_in_chunk: i64, elem_size: i64, elem_mode: i64, value: T) -> i64 {
  let next = persistent_vector_copy_node(region, node)
  let slot = persistent_vector_slot(chunk_index, depth)
  if depth <= 1 {
    let old_chunk = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_chunk = persistent_vector_copy_chunk(region, old_chunk, elem_size, elem_mode)
    vector_store_value<T>(new_chunk + slot_in_chunk * elem_size, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(region, new_chunk + slot_in_chunk * elem_size, elem_mode)
    persistent_vector_storage_node_set_child(next, slot, new_chunk)
  } else {
    let old_child = if node == 0 { 0 } else { persistent_vector_storage_node_child(node, slot) }
    let new_child = persistent_vector_tree_set<T>(region, old_child, depth - 1, chunk_index, slot_in_chunk, elem_size, elem_mode, value)
    persistent_vector_storage_node_set_child(next, slot, new_child)
  }
  next
}

fn persistent_vector_get<T>(vec: PersistentVector<T>, index: i64, default: T) -> T {
  let root = persistent_vector_root<T>(vec)
  if root == 0 or index < 0 or index >= persistent_vector_len<T>(vec) {
    default
  } else {
    let elem_size = persistent_vector_storage_element_size(root)
    let elem_mode = persistent_vector_storage_element_mode(root)
    let tree_count = persistent_vector_storage_tree_count(root)
    let tree_depth = persistent_vector_storage_tree_depth(root)
    let tree_root = persistent_vector_storage_tree_root(root)
    let tail = persistent_vector_storage_tail(root)
    let tail_start = tree_count * persistent_vector_chunk_size()
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    if index >= tail_start {
      vector_load_value<T>(tail + (index - tail_start) * elem_size, elem_size, elem_mode, default)
    } else {
      let chunk = persistent_vector_tree_chunk(tree_root, tree_depth, chunk_index)
      vector_load_value<T>(chunk + slot * elem_size, elem_size, elem_mode, default)
    }
  }
}

fn persistent_vector_push<T>(vec: PersistentVector<T>, value: T) -> PersistentVector<T> {
  let root = persistent_vector_root<T>(vec)
  let region = persistent_vector_region<T>(vec)
  let len = if root == 0 { 0 } else { persistent_vector_storage_len(root) }
  let elem_size = if root == 0 { vector_element_size_of<T>() } else { persistent_vector_storage_element_size(root) }
  let elem_mode = if root == 0 { vector_element_mode_of<T>() } else { persistent_vector_storage_element_mode(root) }
  let tree_count = if root == 0 { 0 } else { persistent_vector_storage_tree_count(root) }
  let tree_depth = if root == 0 { 1 } else { persistent_vector_storage_tree_depth(root) }
  let tree_root = if root == 0 { 0 } else { persistent_vector_storage_tree_root(root) }
  let tail = if root == 0 { 0 } else { persistent_vector_storage_tail(root) }
  let tail_count = persistent_vector_tail_count_for_len(len, tree_count)
  if tail_count < persistent_vector_chunk_size() {
    let new_tail = persistent_vector_copy_chunk(region, tail, elem_size, elem_mode)
    vector_store_value<T>(new_tail + tail_count * elem_size, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(region, new_tail + tail_count * elem_size, elem_mode)
    persistent_vector_box<T>(persistent_vector_make_root(region, len + 1, elem_size, elem_mode, tree_count, tree_depth, tree_root, new_tail), region)
  } else {
    let needs_grow = if tree_count >= persistent_vector_pow32(tree_depth) { 1 } else { 0 }
    let next_depth = if needs_grow == 1 { tree_depth + 1 } else { tree_depth }
    let base_tree = if needs_grow == 1 {
      let node = persistent_vector_copy_node(region, 0)
      if tree_root != 0 { persistent_vector_storage_node_set_child(node, 0, tree_root) } else { 0 }
      node
    } else { tree_root }
    let next_tree = persistent_vector_tree_assoc_chunk(region, base_tree, next_depth, tree_count, tail)
    let new_tail = persistent_vector_copy_chunk(region, 0, elem_size, elem_mode)
    vector_store_value<T>(new_tail, elem_size, elem_mode, value)
    persistent_vector_storage_register_stored(region, new_tail, elem_mode)
    persistent_vector_box<T>(persistent_vector_make_root(region, len + 1, elem_size, elem_mode, tree_count + 1, next_depth, next_tree, new_tail), region)
  }
}

fn persistent_vector_set<T>(vec: PersistentVector<T>, index: i64, value: T) -> PersistentVector<T> {
  let root = persistent_vector_root<T>(vec)
  let region = persistent_vector_region<T>(vec)
  if root == 0 or index < 0 or index >= persistent_vector_len<T>(vec) {
    persistent_vector_box<T>(root, region)
  } else {
    let len = persistent_vector_storage_len(root)
    let elem_size = persistent_vector_storage_element_size(root)
    let elem_mode = persistent_vector_storage_element_mode(root)
    let tree_count = persistent_vector_storage_tree_count(root)
    let tree_depth = persistent_vector_storage_tree_depth(root)
    let tree_root = persistent_vector_storage_tree_root(root)
    let tail = persistent_vector_storage_tail(root)
    let tail_start = tree_count * persistent_vector_chunk_size()
    let chunk_index = index / persistent_vector_chunk_size()
    let slot = index - chunk_index * persistent_vector_chunk_size()
    if index >= tail_start {
      let new_tail = persistent_vector_copy_chunk(region, tail, elem_size, elem_mode)
      vector_store_value<T>(new_tail + (index - tail_start) * elem_size, elem_size, elem_mode, value)
      persistent_vector_storage_register_stored(region, new_tail + (index - tail_start) * elem_size, elem_mode)
      persistent_vector_box<T>(persistent_vector_make_root(region, len, elem_size, elem_mode, tree_count, tree_depth, tree_root, new_tail), region)
    } else {
      let next_tree = persistent_vector_tree_set<T>(region, tree_root, tree_depth, chunk_index, slot, elem_size, elem_mode, value)
      persistent_vector_box<T>(persistent_vector_make_root(region, len, elem_size, elem_mode, tree_count, tree_depth, next_tree, tail), region)
    }
  }
}

fn persistent_vector_is_promoted<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_is_promoted<T>(vec)
}

fn persistent_vector_promote<T>(vec: PersistentVector<T>) -> i64 {
  persistent_vector_storage_promote<T>(vec)
}

fn vector_swap<T>(vec: Vector<T>, left: i64, right: i64) -> i64 {
  if vector_in_bounds<T>(vec, left) == 0 { 0 }
  else { if vector_in_bounds<T>(vec, right) == 0 { 0 }
  else { if left == right { 1 }
  else {
    let data = vector_data<T>(vec)
    let elem_size = vector_element_size<T>(vec)
    let elem_mode = vector_element_mode<T>(vec)
    let left_addr = data + left * elem_size
    let right_addr = data + right * elem_size
    let a = vector_storage_load_value_in_bounds<T>(left_addr, elem_size, elem_mode)
    let b = vector_storage_load_value_in_bounds<T>(right_addr, elem_size, elem_mode)
    -- The owned temporaries keep both values alive while the vector gives up
    -- its old stakes; each replacement store then establishes the new stake.
    -- Without the releases, every managed swap leaked two references.
    vector_storage_release_element(left_addr, elem_mode)
    vector_storage_release_element(right_addr, elem_mode)
    vector_store_value<T>(left_addr, elem_size, elem_mode, b)
    vector_store_value<T>(right_addr, elem_size, elem_mode, a)
    1
  } } }
}

-- Restore the max-heap rooted at `start` over the half-open range [0, end).
-- The comparator follows Ord.compare: negative, zero, or positive.
fn vector_sort_sift_down<T>(vec: Vector<T>, start: i64, end: i64, cmp: (T, T) -> i64) -> i64 {
  let mut root = start
  let mut done = 0
  while done == 0 {
    let child = root * 2 + 1
    if child >= end {
      done = 1
    } else {
      let mut candidate = root
      if cmp(vector_get_in_bounds<T>(vec, candidate), vector_get_in_bounds<T>(vec, child)) < 0 {
        candidate = child
      } else { 0 }
      let right = child + 1
      if right < end and cmp(vector_get_in_bounds<T>(vec, candidate), vector_get_in_bounds<T>(vec, right)) < 0 {
        candidate = right
      } else { 0 }
      if candidate == root {
        done = 1
      } else {
        vector_swap<T>(vec, root, candidate)
        root = candidate
      }
    }
  }
  1
}

-- In-place unstable heapsort: O(n log n) comparisons in the worst case and
-- O(1) auxiliary storage. Returns the same typed vector for pipe-friendly use.
fn vector_sort_by<T>(vec: Vector<T>, cmp: (T, T) -> i64) -> Vector<T> {
  let len = vector_len<T>(vec)
  let mut start = len / 2
  while start > 0 {
    start = start - 1
    vector_sort_sift_down<T>(vec, start, len, cmp)
  }
  let mut end = len
  while end > 1 {
    end = end - 1
    vector_swap<T>(vec, 0, end)
    vector_sort_sift_down<T>(vec, 0, end, cmp)
  }
  vec
}

fn vector_sort<T: Ord>(vec: Vector<T>) -> Vector<T> {
  vector_sort_by<T>(vec, ord_compare)
}
