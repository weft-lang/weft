-- stdlib/vector.weft — mutable contiguous vectors
--
-- Vector handles are raw pointers to [data, length, capacity]. Elements are
-- stored as one machine word, matching the current runtime representation for
-- integers, pointers, variants, records, closures, and strings.

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "stdlib/option.weft"

fn vector_header_size() -> i64 { 24 }
fn vector_data_offset() -> i64 { 0 }
fn vector_len_offset() -> i64 { 8 }
fn vector_capacity_offset() -> i64 { 16 }

fn vector_normalize_capacity(capacity: i64) -> i64 {
  if capacity < 0 { 0 } else { capacity }
}

fn vector_new<T>() -> i64 {
  vector_with_capacity<T>(0)
}

fn vector_with_capacity<T>(capacity: i64) -> i64 {
  let cap = vector_normalize_capacity(capacity)
  let header = alloc_bump(vector_header_size())
  let data = if cap == 0 { 0 } else { alloc_bump(cap * 8) }
  __mem_store64(header + vector_data_offset(), data)
  __mem_store64(header + vector_len_offset(), 0)
  __mem_store64(header + vector_capacity_offset(), cap)
  header
}

fn vector_len(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_len_offset()) }
}

fn vector_capacity(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_capacity_offset()) }
}

fn vector_data(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + vector_data_offset()) }
}

fn vector_is_empty(vec: i64) -> i64 {
  if vector_len(vec) == 0 { 1 } else { 0 }
}

fn vector_next_capacity(current: i64, needed: i64) -> i64 {
  let mut cap = if current <= 0 { 1 } else { current * 2 }
  while cap < needed {
    cap = cap * 2
  }
  cap
}

fn vector_reserve<T>(vec: i64, needed: i64) -> i64 {
  if vec == 0 { 0 }
  else {
    let cap = vector_capacity(vec)
    if needed <= cap { vec }
    else {
      let len = vector_len(vec)
      let old_data = vector_data(vec)
      let new_cap = vector_next_capacity(cap, needed)
      let new_data = alloc_bump(new_cap * 8)
      if old_data != 0 { mem_copy(new_data, old_data, len * 8) } else { 0 }
      __mem_store64(vec + vector_data_offset(), new_data)
      __mem_store64(vec + vector_capacity_offset(), new_cap)
      vec
    }
  }
}

fn vector_push<T>(vec: i64, value: T) -> i64 {
  if vec == 0 { 0 }
  else {
    let len = vector_len(vec)
    vector_reserve<T>(vec, len + 1)
    let data = vector_data(vec)
    __mem_store64(data + len * 8, value)
    __mem_store64(vec + vector_len_offset(), len + 1)
    vec
  }
}

fn vector_in_bounds(vec: i64, index: i64) -> i64 {
  if index < 0 { 0 }
  else { if index >= vector_len(vec) { 0 } else { 1 } }
}

fn vector_get<T>(vec: i64, index: i64, default: T) -> T {
  if vector_in_bounds(vec, index) == 0 {
    default
  } else {
    __mem_load64(vector_data(vec) + index * 8)
  }
}

fn vector_get_option<T>(vec: i64, index: i64) -> i64 {
  if vector_in_bounds(vec, index) == 0 {
    None
  } else {
    Some<T>(__mem_load64(vector_data(vec) + index * 8))
  }
}

fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 {
  if vector_in_bounds(vec, index) == 0 {
    0
  } else {
    __mem_store64(vector_data(vec) + index * 8, value)
    1
  }
}

fn vector_pop<T>(vec: i64) -> i64 {
  let len = vector_len(vec)
  if len <= 0 {
    None
  } else {
    let next_len = len - 1
    let value = __mem_load64(vector_data(vec) + next_len * 8)
    __mem_store64(vec + vector_len_offset(), next_len)
    Some<T>(value)
  }
}

fn vector_clear(vec: i64) -> i64 {
  if vec == 0 { 0 }
  else {
    __mem_store64(vec + vector_len_offset(), 0)
    vec
  }
}

fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let len = vector_len(vec)
  let data = vector_data(vec)
  for i in 0..len {
    acc = f(acc, __mem_load64(data + i * 8))
  }
  acc
}

fn vector_map<T, U>(vec: i64, f: (T) -> U) -> i64 {
  let len = vector_len(vec)
  let result = vector_with_capacity<U>(len)
  let data = vector_data(vec)
  for i in 0..len {
    vector_push<U>(result, f(__mem_load64(data + i * 8)))
  }
  result
}

fn vector_from_range(start: i64, end: i64) -> i64 {
  let size = if end <= start { 0 } else { end - start }
  let result = vector_with_capacity<i64>(size)
  for i in start..end {
    vector_push<i64>(result, i)
  }
  result
}

fn vector_index_of_i64(vec: i64, needle: i64) -> i64 {
  let len = vector_len(vec)
  let data = vector_data(vec)
  let mut result = 0 - 1
  let mut i = 0
  while i < len {
    if __mem_load64(data + i * 8) == needle {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

fn vector_contains_i64(vec: i64, needle: i64) -> i64 {
  if vector_index_of_i64(vec, needle) < 0 { 0 } else { 1 }
}

fn vector_swap<T>(vec: i64, left: i64, right: i64) -> i64 {
  if vector_in_bounds(vec, left) == 0 { 0 }
  else { if vector_in_bounds(vec, right) == 0 { 0 }
  else {
    let data = vector_data(vec)
    let a = __mem_load64(data + left * 8)
    let b = __mem_load64(data + right * 8)
    __mem_store64(data + left * 8, b)
    __mem_store64(data + right * 8, a)
    1
  } }
}
