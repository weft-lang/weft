-- stdlib/task.weft -- effectful structured tasks without function colouring

use runtime/spawn_task.{*}
use runtime/net_poller.{NetPollCancel, NetPollDeadline, NetPollError, NetPollEvent, NetPollInterest, NetPollRegistration, NetPollTerminationSignal, NetPollWait, NetPoller, NetPollAlreadyResolved, NetPollCancelled, NetPollEventReady, NetPollForMillis, NetPollForever, NetPollImmediate, NetPollInterrupt, NetPollInterrupted, NetPollInvalidEvent, NetPollInvalidRegistration, NetPollLimit, NetPollPlatform, NetPollReady, NetPollReadyError, NetPollReadable, NetPollTerminate, NetPollTermination, NetPollTimedOut, NetPollWritable, net_poll_registration_same, net_poller_adopt_listener, net_poller_adopt_stream, net_poller_cancel, net_poller_enable_shutdown, net_poller_open, net_poller_register, net_poller_wait}
use runtime/panic.{runtime_trap}
use runtime/time.{runtime_platform_now_nanos, runtime_platform_sleep_millis}
use stdlib/task/cancellation.{Cancellation, CancellationOutcome, with_deadline, with_scope}
use stdlib/task/cancellation.{CancellationReason, CancellationShutdown, request}
use stdlib/task/channel.{AlreadyClosed, Capacity, Channel, ChannelState, CloseResult, ClosedNow, Drained, ReceiveResult, Received, SendAccepted, SendClosed, SendResult, channel_capacity_value, channel_state_cleanup, channel_state_close, channel_state_disabled, channel_state_is_closed, channel_state_is_empty, channel_state_is_full, channel_state_new, channel_state_offer, channel_state_take}
use stdlib/continuation.{continuation_cell_from_ptr, continuation_cell_resume_i64, continuation_cell_store_i64}
use stdlib/fail.{Fail}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/task/shutdown.{ShutdownInterrupt, ShutdownSignal, ShutdownTerminate}
use stdlib/tcp.{TcpListener, TcpListenerReadiness, TcpListenerReadinessFailed, TcpListenerReady, TcpReadiness, TcpReadinessError, TcpReadinessInterrupted, TcpReadinessInvalidated, TcpReadinessPlatform, TcpReadinessResourceExhausted, TcpStream, TcpStreamReadiness, TcpStreamReadinessFailed, TcpStreamReady}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant, MonotonicClock}
use stdlib/time/sleep as sleep
use stdlib/time/sleep.{InvalidSleepDuration, Sleep, SleepDurationOutOfRange, SleepError, SleepUnavailable}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_pop, vector_push, vector_remove_at}
use stdlib/vector/handles.{Vector}

--- A single-use observation right for one child in the enclosing task scope.
---
--- The scope owns the child and guarantees cleanup. Consuming `join` returns
--- its ordinary result without introducing a future or async-coloured type.
pub type Task<T> = opaque i64

fn task_from_word<T>(word: i64) -> unique Task<T> {
  Task<T>(word)
}

fn task_observation_word<T>(task: unique Task<T>) -> i64 {
  match task {
    Task(word) -> word
  }
}

--- Structured child execution within the nearest task scope.
---
--- Application code submits typed work with `task.spawn` and observes its result
--- by consuming `child.join()`. The scope owns every child through completion.
pub effect TaskScope {
  -- Private scheduler operations are the compiler/runtime lowering boundary for
  -- the typed public functions above. They are not application capabilities.
  pub(package) fn submit(work: i64) -> i64,
    pub(package) fn join(task: i64) -> i64
}

-- One internal suspension atom keeps public capabilities tail-resumptive and
-- makes the scheduler—not time effects or TaskScope—the sole owner of stored one-shot
-- continuations. The private variant keeps every suspension reason explicit
-- while still lowering each nullary case to a scalar tag.
type EventLoopSuspendMode {
  Runnable,
    Joining,
    Sleeping,
    Polling,
    ChannelSending,
    ChannelReceiving
}

effect EventLoopSuspend {
  @deferred fn suspend(task: i64, mode: EventLoopSuspendMode, value: i64) -> i64
}

-- The poller and all registration identities remain behind this private,
-- tail-resumptive seam. Its resource borrows end before EventLoopSuspend
-- stores a continuation containing the corresponding owner.
effect EventLoopPoll {
  fn register_stream(stream: borrow TcpStream, interest: NetPollInterest) -> Result<NetPollRegistration, NetPollError>
    fn register_listener(listener: borrow TcpListener, interest: NetPollInterest) -> Result<NetPollRegistration, NetPollError>
    fn wait(deadline: NetPollDeadline) -> Result<NetPollWait, NetPollError>
    fn cancel(registration: NetPollRegistration) -> Result<NetPollCancel, NetPollError>
}

-- Signal delivery reaches this private scheduler seam only after kqueue has
-- returned in ordinary execution context. Public code receives the exact
-- CancellationReason through the enclosing cancellation scope instead of a
-- callback or arbitrary signal-control capability.
effect EventLoopShutdown {
  fn observed(signal: NetPollTerminationSignal) -> nil
}

type EventLoopRegistration {
  task: i64,
    registration: NetPollRegistration
}

type EventLoopNoChannel {
  EventLoopNoChannel
}

fn event_loop_poll_error_status(error: NetPollError) -> i64 {
  match error {
    NetPollInterrupted -> 0 - 1
    NetPollLimit -> 0 - 2
    NetPollInvalidRegistration -> 0 - 3
    NetPollInvalidEvent -> 0 - 3
    NetPollPlatform(code) -> 0 - 1000 - code
  }
}

fn event_loop_readiness_error(status: i64) -> TcpReadinessError {
  match status {
    code if code == 0 - 1 -> TcpReadinessInterrupted
    code if code == 0 - 2 -> TcpReadinessResourceExhausted
    code if code == 0 - 3 -> TcpReadinessInvalidated
    code -> TcpReadinessPlatform(0 - code - 1000)
  }
}

fn event_loop_shutdown_signal(signal: NetPollTerminationSignal) -> ShutdownSignal {
  match signal {
    NetPollInterrupt -> ShutdownInterrupt
    NetPollTerminate -> ShutdownTerminate
  }
}

fn event_loop_track_registration(
  registrations: Vector<EventLoopRegistration>,
  task: i64,
  registration: NetPollRegistration
) -> i64 {
  vector_push<EventLoopRegistration>(registrations,
    EventLoopRegistration { task: task, registration: registration }
  )
}

fn event_loop_find_registration(
  registrations: Vector<EventLoopRegistration>,
  registration: NetPollRegistration
) -> i64 {
  let mut index = 0
  let mut found = 0 - 1
  while index < vector.vector_len<EventLoopRegistration>(registrations) and found < 0 {
    let entry = vector_get_in_bounds<EventLoopRegistration>(registrations, index)
    if net_poll_registration_same(entry.registration, registration) {
      found = index
    } else { 0 }
    index = index + 1
  }
  found
}

fn event_loop_wake_registration(
  registrations: Vector<EventLoopRegistration>,
  registration: NetPollRegistration,
  status: i64
) -> i64 {
  let index = event_loop_find_registration(registrations, registration)
  if index < 0 { 0 }
  else {
    let entry = vector_get_in_bounds<EventLoopRegistration>(registrations, index)
    let removed = vector_remove_at<EventLoopRegistration>(registrations, index)
    runtime_spawn_task_wake_polling(entry.task, status)
  }
}

fn event_loop_wake_all_registrations(
  registrations: Vector<EventLoopRegistration>,
  status: i64
) -> i64 {
  let mut count = 0
  while registrations.len() > 0 {
    match vector_pop<EventLoopRegistration>(registrations) {
      Some(entry) -> {
        count = count + runtime_spawn_task_wake_polling(entry.task, status)
      }
      None -> { runtime_trap(47, 0) }
    }
  }
  count
}

fn event_loop_cancel_registrations(
  poller: borrow mut NetPoller,
  registrations: Vector<EventLoopRegistration>
) -> i64 {
  let mut count = 0
  while registrations.len() > 0 {
    match vector_pop<EventLoopRegistration>(registrations) {
      Some(entry) -> {
        match net_poller_cancel(poller, entry.registration) {
          Ok(outcome) -> match outcome {
            NetPollCancelled -> { count = count + 1 }
            NetPollAlreadyResolved -> { count = count + 1 }
          }
          Err(error) -> { count = count + 0 }
        }
      }
      None -> { runtime_trap(47, 0) }
    }
  }
  count
}

fn event_loop_channel_send<T: Sendable>(
  state: ChannelState<T>,
  scope: i64,
  task: i64,
  value: T
) -[EventLoopSuspend]> SendResult<T> {
  while not channel_state_is_closed<T>(state) and channel_state_is_full<T>(state) {
    EventLoopSuspend.suspend(task, ChannelSending, 0)
  }
  if channel_state_is_closed<T>(state) { SendClosed<T>(value) }
  else {
    if channel_state_offer<T>(state, value) != 1 { runtime_trap(47, 0) } else { nil }
    runtime_spawn_scope_wake_next_channel(scope, runtime_spawn_task_channel_receiving(), 0)
    SendAccepted<T>()
  }
}

fn event_loop_channel_receive<T: Sendable>(
  state: ChannelState<T>,
  scope: i64,
  task: i64
) -[EventLoopSuspend]> ReceiveResult<T> {
  while not channel_state_is_closed<T>(state) and channel_state_is_empty<T>(state) {
    EventLoopSuspend.suspend(task, ChannelReceiving, 0)
  }
  match channel_state_take<T>(state) {
    Some(value) -> {
      runtime_spawn_scope_wake_next_channel(scope, runtime_spawn_task_channel_sending(), 0)
      Received<T>(value)
    }
    None -> {
      if channel_state_is_closed<T>(state) { Drained<T>() }
      else { runtime_trap(47, 0) }
    }
  }
}

fn event_loop_channel_close<T: Sendable>(
  state: ChannelState<T>,
  scope: i64
) -> CloseResult {
  let outcome = channel_state_close<T>(state)
  match outcome {
    ClosedNow -> { runtime_spawn_scope_wake_all_channel(scope, 0) }
    AlreadyClosed -> { 0 }
  }
  outcome
}

--- Submit an effectful Sendable task to the enclosing structured scope.
---
--- The callback keeps its ordinary result `T` and its real effects `E`.
--- `TaskScope` is ordinary effect propagation, not an async-coloured function
--- kind. Concrete captures are checked by the shared sealed Sendable fact.
pub fn spawn<T: Sendable, E>(f: () -[TaskScope, E]> T) -[TaskScope, E]> unique Task<T> {
  let work = runtime_spawn_work_pack<T, TaskScope | E>(f)
  task_from_word<T>(TaskScope.submit(work))
}

impl<T> Task<T> {
  --- Consume this task observation right and return its ordinary result.
  pub fn join(self: unique Self) -[TaskScope]> T {
    runtime_spawn_work_take<T>(TaskScope.join(task_observation_word<T>(self)))
  }
}

fn sequential_run<E>(scope: i64, task: i64) -[E]> i64 {
  handle runtime_spawn_task_run<TaskScope | E>(task) {
    TaskScope.submit(work) -> {
      let child = runtime_spawn_scope_track(scope, work)
      sequential_run<E>(scope, child)
      resume(child)
    }
    TaskScope.join(child) -> resume(runtime_spawn_task_join(child))
  }
}

--- Run a structured task scope with deterministic sequential execution.
---
--- This policy admits exactly the same Sendable task values as a future
--- cross-thread executor. Tasks execute in deterministic issue order; every
--- accepted task finishes or is cleaned before the scope returns or aborts.
pub fn with_sequential<T, E>(body: () -[TaskScope, E]> T) -[E]> T {
  let scope = runtime_spawn_scope_new()
  defer runtime_spawn_scope_cleanup(scope)
  handle body() {
    TaskScope.submit(work) -> {
      let task = runtime_spawn_scope_track(scope, work)
      sequential_run<E>(scope, task)
      resume(task)
    }
    TaskScope.join(task) -> resume(runtime_spawn_task_join(task))
  }
}

fn sequential_channel_run_task<C: Sendable, E>(
  state: ChannelState<C>,
  scope: i64,
  task: i64
) -[E]> i64 {
  let result = handle {
    handle {
      handle runtime_spawn_task_run<TaskScope | Channel<C> | E>(task) {
        TaskScope.submit(work) -> {
          let child = runtime_spawn_scope_track(scope, work)
          if child == 0 { runtime_trap(47, 0) } else { nil }
          resume(EventLoopSuspend.suspend(task, Runnable, child))
        }
        TaskScope.join(target) -> {
          if runtime_spawn_task_state(target) == runtime_spawn_task_complete() {
            resume(runtime_spawn_task_join(target))
          } else {
            resume(EventLoopSuspend.suspend(task, Joining, target))
          }
        }
      }
    } {
      Channel<C>.send(value) -> resume(event_loop_channel_send<C>(state, scope, task, value))
      Channel<C>.receive() -> resume(event_loop_channel_receive<C>(state, scope, task))
      Channel<C>.close() -> resume(event_loop_channel_close<C>(state, scope))
    }
  } {
    EventLoopSuspend.suspend(current, mode, value) with k -> {
      if current != task { runtime_trap(47, 0) } else { nil }
      let cell = continuation_cell_from_ptr(runtime_spawn_task_continuation_cell(task))
      if continuation_cell_store_i64(cell, k) != 1 { runtime_trap(47, 0) } else { nil }
      match mode {
        Runnable -> {
          if runtime_spawn_task_suspend_runnable(task, value) != 1 { runtime_trap(47, 0) } else { 0 }
        }
        Joining -> {
          if runtime_spawn_task_wait_for(task, value) != 1 { runtime_trap(47, 0) } else { 0 }
        }
        Sleeping -> runtime_trap(47, 0)
        Polling -> runtime_trap(47, 0)
        ChannelSending -> {
          if runtime_spawn_task_suspend_channel(task, runtime_spawn_task_channel_sending()) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        ChannelReceiving -> {
          if runtime_spawn_task_suspend_channel(task, runtime_spawn_task_channel_receiving()) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
      }
    }
  }
  runtime_spawn_task_wake_waiter(task)
  result
}

fn sequential_channel_drive<C: Sendable, E>(
  state: ChannelState<C>,
  scope: i64
) -[E]> i64 {
  let mut result = 0
  let mut active = runtime_spawn_scope_has_active(scope)
  while active == 1 {
    let task = runtime_spawn_scope_next_runnable(scope)
    if task == 0 { runtime_trap(47, 0) }
    else {
      if runtime_spawn_task_state(task) == runtime_spawn_task_pending() {
        result = sequential_channel_run_task<C, E>(state, scope, task)
      } else {
        let resume_value = runtime_spawn_task_begin_resume(task)
        let cell = continuation_cell_from_ptr(runtime_spawn_task_continuation_cell(task))
        result = continuation_cell_resume_i64(cell, resume_value, 0)
        runtime_spawn_task_wake_waiter(task)
      }
    }
    active = runtime_spawn_scope_has_active(scope)
  }
  result
}

--- Run one bounded channel and its structured tasks under deterministic issue-order scheduling.
---
--- Full producers and empty consumers yield their one-shot continuations. The
--- fixed buffer never grows, and close wakes every waiter exactly once.
pub fn with_sequential_channel<C: Sendable, T, E>(
  capacity: Capacity,
  body: () -[TaskScope, Channel<C>, E]> T
) -[E]> T {
  let scope = runtime_spawn_scope_new()
  let state = channel_state_new<C>(channel_capacity_value(capacity))
  defer runtime_spawn_scope_cleanup(scope)
  defer channel_state_cleanup<C>(state)
  let work = runtime_spawn_work_pack<T, TaskScope | Channel<C> | E>(body)
  let root = runtime_spawn_scope_track(scope, work)
  if root == 0 { runtime_trap(47, 0) } else { nil }
  sequential_channel_drive<C, E>(state, scope)
  runtime_spawn_work_take<T>(runtime_spawn_task_join(root))
}

fn event_loop_drive<C: Sendable, E>(
  channel: ChannelState<C>,
  scope: i64,
  registrations: Vector<EventLoopRegistration>,
  shutdown_enabled: i64
) -[EventLoopPoll, EventLoopShutdown, E]> i64 {
  let mut result = 0
  let mut active = runtime_spawn_scope_has_active(scope)
  while active == 1 {
    let now = runtime_platform_now_nanos()
    if now < 0 { runtime_trap(47, 0) } else { runtime_spawn_scope_wake_due(scope, now) }
    let task = runtime_spawn_scope_next_runnable(scope)
    if task != 0 {
      if runtime_spawn_task_state(task) == runtime_spawn_task_pending() {
        result = event_loop_run_task<C, E>(channel, scope, task, registrations)
      } else {
        let resume_value = runtime_spawn_task_begin_resume(task)
        let cell = continuation_cell_from_ptr(runtime_spawn_task_continuation_cell(task))
        result = continuation_cell_resume_i64(cell, resume_value, 0)
        runtime_spawn_task_wake_waiter(task)
      }
    } else {
      let delay = runtime_spawn_scope_next_sleep_millis(scope, now)
      if registrations.len() > 0 or shutdown_enabled == 1 {
        let deadline = match delay {
          millis if millis < 0 -> NetPollForever
          0 -> NetPollImmediate
          millis -> NetPollForMillis(__i64_to_usize(millis))
        }
        match EventLoopPoll.wait(deadline) {
          Ok(wait) -> match wait {
            NetPollTimedOut -> { 0 }
            NetPollEventReady(event) -> match event {
              NetPollReady(registration, available, eof) -> {
                event_loop_wake_registration(registrations, registration, 0)
              }
              NetPollReadyError(registration, error) -> {
                event_loop_wake_registration(
                  registrations,
                  registration,
                  event_loop_poll_error_status(error)
                )
              }
              NetPollTermination(signal, occurrences) -> {
                EventLoopShutdown.observed(signal)
                0
              }
            }
          }
          Err(NetPollInterrupted) -> { 0 }
          Err(error) -> {
            event_loop_wake_all_registrations(
              registrations,
              event_loop_poll_error_status(error)
            )
          }
        }
      } else {
        if delay < 0 { runtime_trap(47, 0) }
        else { runtime_platform_sleep_millis(delay) }
      }
    }
    active = runtime_spawn_scope_has_active(scope)
  }
  result
}

fn event_loop_run_task<C: Sendable, E>(
  channel: ChannelState<C>,
  scope: i64,
  task: i64,
  registrations: Vector<EventLoopRegistration>
) -[EventLoopPoll, E]> i64 {
  let result = handle {
    handle {
      handle {
        handle {
          handle {
            handle runtime_spawn_task_run<TaskScope | MonotonicClock | Sleep | TcpReadiness | Channel<C> | E>(task) {
              TaskScope.submit(work) -> {
                let child = runtime_spawn_scope_track(scope, work)
                if child == 0 { runtime_trap(47, 0) } else { nil }
                resume(EventLoopSuspend.suspend(task, Runnable, child))
              }
              TaskScope.join(target) -> {
                if runtime_spawn_task_state(target) == runtime_spawn_task_complete() {
                  resume(runtime_spawn_task_join(target))
                } else {
                  resume(EventLoopSuspend.suspend(task, Joining, target))
                }
              }
            }
          } {
            MonotonicClock.now() -> {
              let now = runtime_platform_now_nanos()
              if now < 0 {
                runtime_trap(47, 0)
              } else {
                resume(monotonic.nanoseconds(now))
              }
            }
          }
        } {
          Sleep.wait(duration) -> {
            match duration.milliseconds() {
              millis if millis < 0 -> resume(Err<nil, SleepError>(InvalidSleepDuration))
              0 -> resume(Ok<nil, SleepError>(nil))
              millis -> {
                let now = runtime_platform_now_nanos()
                match now {
                  instant if instant < 0 -> resume(Err<nil, SleepError>(SleepUnavailable))
                  instant if millis > 9223372036854 -> resume(Err<nil, SleepError>(SleepDurationOutOfRange))
                  instant if instant > 9223372036854775807 - millis * 1000000 -> resume(Err<nil, SleepError>(SleepDurationOutOfRange))
                  instant -> {
                    let status = EventLoopSuspend.suspend(task, Sleeping, instant + millis * 1000000)
                    resume(sleep.result_from_platform_status(status))
                  }
                }
              }
            }
          }
        }
      } {
        TcpReadiness.readable(stream) -> {
          match EventLoopPoll.register_stream(stream, NetPollReadable) {
            Err(error) -> resume(TcpStreamReadinessFailed(stream, event_loop_readiness_error(event_loop_poll_error_status(error))))
            Ok(registration) -> {
              if event_loop_track_registration(registrations, task, registration) != 1 {
                let cancelled = EventLoopPoll.cancel(registration)
                resume(TcpStreamReadinessFailed(stream, TcpReadinessResourceExhausted))
              } else {
                let status = EventLoopSuspend.suspend(task, Polling, 0)
                if status == 0 {
                  resume(TcpStreamReady(stream))
                } else {
                  resume(TcpStreamReadinessFailed(stream, event_loop_readiness_error(status)))
                }
              }
            }
          }
        }
        TcpReadiness.writable(stream) -> {
          match EventLoopPoll.register_stream(stream, NetPollWritable) {
            Err(error) -> resume(TcpStreamReadinessFailed(stream, event_loop_readiness_error(event_loop_poll_error_status(error))))
            Ok(registration) -> {
              if event_loop_track_registration(registrations, task, registration) != 1 {
                let cancelled = EventLoopPoll.cancel(registration)
                resume(TcpStreamReadinessFailed(stream, TcpReadinessResourceExhausted))
              } else {
                let status = EventLoopSuspend.suspend(task, Polling, 0)
                if status == 0 {
                  resume(TcpStreamReady(stream))
                } else {
                  resume(TcpStreamReadinessFailed(stream, event_loop_readiness_error(status)))
                }
              }
            }
          }
        }
        TcpReadiness.acceptable(listener) -> {
          match EventLoopPoll.register_listener(listener, NetPollReadable) {
            Err(error) -> resume(TcpListenerReadinessFailed(listener, event_loop_readiness_error(event_loop_poll_error_status(error))))
            Ok(registration) -> {
              if event_loop_track_registration(registrations, task, registration) != 1 {
                let cancelled = EventLoopPoll.cancel(registration)
                resume(TcpListenerReadinessFailed(listener, TcpReadinessResourceExhausted))
              } else {
                let status = EventLoopSuspend.suspend(task, Polling, 0)
                if status == 0 {
                  resume(TcpListenerReady(listener))
                } else {
                  resume(TcpListenerReadinessFailed(listener, event_loop_readiness_error(status)))
                }
              }
            }
          }
        }
      }
    } {
      Channel<C>.send(value) -> resume(event_loop_channel_send<C>(channel, scope, task, value))
      Channel<C>.receive() -> resume(event_loop_channel_receive<C>(channel, scope, task))
      Channel<C>.close() -> resume(event_loop_channel_close<C>(channel, scope))
    }
  } {
    EventLoopSuspend.suspend(current, mode, value) with k -> {
      if current != task { runtime_trap(47, 0) } else { nil }
      let cell = continuation_cell_from_ptr(runtime_spawn_task_continuation_cell(task))
      if continuation_cell_store_i64(cell, k) != 1 { runtime_trap(47, 0) } else { nil }
      match mode {
        Runnable -> {
          if runtime_spawn_task_suspend_runnable(task, value) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        Joining -> {
          if runtime_spawn_task_wait_for(task, value) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        Sleeping -> {
          if runtime_spawn_task_suspend_sleeping(task, value) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        Polling -> {
          if runtime_spawn_task_suspend_polling(task) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        ChannelSending -> {
          if runtime_spawn_task_suspend_channel(task, runtime_spawn_task_channel_sending()) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
        ChannelReceiving -> {
          if runtime_spawn_task_suspend_channel(task, runtime_spawn_task_channel_receiving()) != 1 {
            runtime_trap(47, 0)
          } else { 0 }
        }
      }
    }
  }
  runtime_spawn_task_wake_waiter(task)
  result
}

--- Run a single-threaded production event loop over stored continuations.
---
--- TaskScope, monotonic time, sleep, TCP readiness and bounded channels keep
--- their ordinary effect
--- signatures. Waiting tasks yield their one-shot continuation; the executor
--- blocks in the platform only when no accepted task is runnable, and the
--- structured scope drains every task before returning.
fn event_loop_execute<C: Sendable, T, E>(
  channel: ChannelState<C>,
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Channel<C>, E]> T,
  scope: i64,
  registrations: Vector<EventLoopRegistration>,
  shutdown_enabled: i64
) -[EventLoopPoll, EventLoopShutdown, E]> T {
  let work = runtime_spawn_work_pack<T, TaskScope | MonotonicClock | Sleep | TcpReadiness | Channel<C> | E>(body)
  let root = runtime_spawn_scope_track(scope, work)
  if root == 0 { runtime_trap(47, 0) } else { nil }
  event_loop_drive<C, E>(channel, scope, registrations, shutdown_enabled)
  runtime_spawn_work_take<T>(runtime_spawn_task_join(root))
}

fn event_loop_with_poller<C: Sendable, T, E>(
  poller: borrow mut NetPoller,
  channel: ChannelState<C>,
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Channel<C>, E]> T,
  shutdown_enabled: i64
) -[EventLoopShutdown, E]> T {
  let scope = runtime_spawn_scope_new()
  -- Registration storage is handler-scoped shared scheduler state.
  let registrations: Vector<EventLoopRegistration> = vector.with_capacity<EventLoopRegistration>(8)
  defer runtime_spawn_scope_cleanup(scope)
  -- Keep cancellation outside the EventLoopPoll handler. On an outward abort
  -- the handler frame is gone before deferred work runs; this direct backend
  -- cleanup therefore both remains handled and precedes continuation/resource
  -- drops by the LIFO ordering above.
  defer event_loop_cancel_registrations(poller, registrations)
  handle event_loop_execute<C, T, E>(channel, body, scope, registrations, shutdown_enabled) {
    EventLoopPoll.register_stream(stream, interest) -> {
      match net_poller_adopt_stream(poller, stream) {
        Err(error) -> resume(Err<NetPollRegistration, NetPollError>(error))
        Ok(resource) -> resume(net_poller_register(poller, resource, interest))
      }
    }
    EventLoopPoll.register_listener(listener, interest) -> {
      match net_poller_adopt_listener(poller, listener) {
        Err(error) -> resume(Err<NetPollRegistration, NetPollError>(error))
        Ok(resource) -> resume(net_poller_register(poller, resource, interest))
      }
    }
    EventLoopPoll.wait(deadline) -> resume(net_poller_wait(poller, deadline))
    EventLoopPoll.cancel(registration) -> resume(net_poller_cancel(poller, registration))
  }
}

--- Run a single-threaded production event loop over stored continuations.
---
--- Timer and TCP-readiness waits suspend without blocking runnable tasks. The
--- structured scope drains every accepted task before returning.
pub fn with_event_loop<T, E>(
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, E]> T
) -[E]> T {
  let channel = channel_state_disabled<EventLoopNoChannel>()
  match net_poller_open() {
    Err(error) -> runtime_trap(47, 0)
    Ok(opened) -> {
      let mut poller: owned NetPoller = opened
      handle event_loop_with_poller<EventLoopNoChannel, T, E>(poller, channel, body, 0) {
        EventLoopShutdown.observed(signal) -> runtime_trap(47, 0)
      }
    }
  }
}

--- Run one bounded channel inside the production timer/readiness event loop.
---
--- The body uses the same `Channel<C>` operations as
--- `with_sequential_channel`; handler choice does not change its task or
--- publication signatures.
pub fn with_event_loop_channel<C: Sendable, T, E>(
  capacity: Capacity,
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Channel<C>, E]> T
) -[E]> T {
  let channel = channel_state_new<C>(channel_capacity_value(capacity))
  defer channel_state_cleanup<C>(channel)
  match net_poller_open() {
    Err(error) -> runtime_trap(47, 0)
    Ok(opened) -> {
      let mut poller: owned NetPoller = opened
      handle event_loop_with_poller<C, T, E>(poller, channel, body, 0) {
        EventLoopShutdown.observed(signal) -> runtime_trap(47, 0)
      }
    }
  }
}

fn event_loop_shutdown_with_channel<C: Sendable, T, E>(
  channel: ChannelState<C>,
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Channel<C>, Cancellation, Fail<CancellationReason>, E]> T
) -[Cancellation, Fail<CancellationReason>, E]> T {
  defer channel_state_cleanup<C>(channel)
  match net_poller_open() {
    Err(error) -> runtime_trap(47, 0)
    Ok(opened) -> {
      let mut poller: owned NetPoller = opened
      match net_poller_enable_shutdown(poller) {
        Err(error) -> runtime_trap(47, 0)
        Ok(ready) -> {
          handle event_loop_with_poller<
            C,
            T,
            Cancellation | Fail<CancellationReason> | E
          >(poller, channel, body, 1) {
            EventLoopShutdown.observed(signal) -> {
              let reason = CancellationShutdown(event_loop_shutdown_signal(signal))
              request(reason)
              Fail<CancellationReason>.fail(reason)
            }
          }
        }
      }
    }
  }
}

--- Run the production event loop with scoped SIGINT/SIGTERM cancellation.
---
--- Delivery is coalesced by the platform poller and observed only after the
--- kernel wait returns in ordinary execution context. The first signal
--- becomes an exact `CancellationShutdown` reason; abort then runs structured
--- LIFO cleanup before process dispositions are restored.
pub fn with_event_loop_shutdown<T, E>(
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Cancellation, Fail<CancellationReason>, E]> T
) -[E]> CancellationOutcome<T> {
  let channel = channel_state_disabled<EventLoopNoChannel>()
  with_scope<T, E>(() => event_loop_shutdown_with_channel<
    EventLoopNoChannel,
    T,
    E
  >(channel, body))
}

--- Run one bounded channel with scoped SIGINT/SIGTERM cancellation.
---
--- Signal delivery and channel backpressure share the same structured event
--- loop. An external shutdown drops or resumes every owned continuation
--- exactly once while the fixed-capacity buffer remains bounded.
pub fn with_event_loop_channel_shutdown<C: Sendable, T, E>(
  capacity: Capacity,
  body: () -[TaskScope, MonotonicClock, Sleep, TcpReadiness, Channel<C>, Cancellation, Fail<CancellationReason>, E]> T
) -[E]> CancellationOutcome<T> {
  let channel = channel_state_new<C>(channel_capacity_value(capacity))
  with_scope<T, E>(() => event_loop_shutdown_with_channel<C, T, E>(channel, body))
}

--- Run a deterministic sequential task scope with cooperative cancellation.
---
--- Cancellation is installed outside TaskScope so child task operations observe
--- the same nearest scope. A checkpoint abort still reaches TaskScope's deferred
--- task cleanup before the typed cancellation outcome is returned.
pub fn with_sequential_cancellation<T, E>(body: () -[TaskScope, Cancellation, Fail<CancellationReason>, E]> T) -[E]> CancellationOutcome<T> {
  with_scope<T, E>(() => with_sequential<T, Cancellation | Fail<CancellationReason> | E>(body))
}

--- Run a deterministic sequential task scope with a cooperative deadline.
---
--- Monotonic time is consulted only at cancellation checkpoints; no polling,
--- sleeping, or busy-wait fallback is introduced by the sequential policy.
pub fn with_sequential_deadline<T, E>(deadline: Instant, body: () -[TaskScope, Cancellation, Fail<CancellationReason>, E]> T) -[MonotonicClock, E]> CancellationOutcome<T> {
  with_deadline<T, E>(deadline, () => with_sequential<T, Cancellation | Fail<CancellationReason> | E>(body))
}
