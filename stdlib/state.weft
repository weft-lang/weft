-- stdlib/state.weft -- generic State effect helpers

effect State<S> {
  fn get() -> S
  fn put(v: S) -> nil
}

fn state_get<S>() -[State<S>]> S {
  State.get()
}

fn state_put<S>(v: S) -[State<S>]> nil {
  State.put(v)
}

fn state_modify<S>(f: (S) -> S) -[State<S>]> S {
  let current = State.get()
  let next = f(current)
  State.put(next)
  next
}
