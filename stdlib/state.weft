-- stdlib/state.weft -- i64 State effect helpers

effect State {
  fn get() -> i64
  fn put(v: i64) -> i64
}

fn state_get() -[State]> i64 {
  State.get()
}

fn state_put(v: i64) -[State]> i64 {
  State.put(v)
}

fn state_modify(f: (i64) -> i64) -[State]> i64 {
  let current = State.get()
  let next = f(current)
  State.put(next)
  next
}
