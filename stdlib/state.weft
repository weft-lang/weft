-- stdlib/state.weft -- generic State effect helpers

use stdlib/vector.{*}

pub effect State<S> {
  fn get() -> S
  fn put(v: S) -> nil
}

-- The nominal wrapper keeps every S representable as one Vector element:
-- scalar specialisations may inline, while structural and managed values use
-- the ordinary nominal managed representation. The handler captures only the
-- immutable Vector handle; mutation stays inside Vector's safe API.
type StateSlotValue<S> {
  StateSlotValue(S)
}

fn state_slot_new<S>(initial: S) -> Vector<StateSlotValue<S>> {
  let slot = vector_with_capacity<StateSlotValue<S>>(1)
  vector_push<StateSlotValue<S>>(slot, StateSlotValue<S>(initial))
  slot
}

fn state_slot_get<S>(slot: Vector<StateSlotValue<S>>) -> S {
  match vector_get_in_bounds<StateSlotValue<S>>(slot, 0) {
    StateSlotValue(value) -> value
  }
}

fn state_slot_put<S>(slot: Vector<StateSlotValue<S>>, value: S) -> nil {
  vector_set<StateSlotValue<S>>(slot, 0, StateSlotValue<S>(value))
  nil
}

pub fn with_state<S, T, E>(initial: S, f: () -[State<S>, E]> T) -[E]> (T, S) {
  let slot = state_slot_new<S>(initial)
  handle f() {
    State.get() -> resume(state_slot_get<S>(slot))
    State.put(next) -> {
      state_slot_put<S>(slot, next)
      resume(nil)
    }
    return value -> (value, state_slot_get<S>(slot))
  }
}

pub fn state_get<S>() -[State<S>]> S {
  State.get()
}

pub fn state_put<S>(v: S) -[State<S>]> nil {
  State.put(v)
}

pub fn state_modify<S>(f: (S) -> S) -[State<S>]> S {
  let current = State.get()
  let next = f(current)
  State.put(next)
  next
}
