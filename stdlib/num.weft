-- stdlib/num.weft — numeric conversion helpers
--
-- Parsing is pure and returns explicit success/failure variants. Prefix
-- parsing reports the next byte offset so parsers can compose without sentinels.

use runtime/memory.{*}
use runtime/float.{*}
use runtime/string.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/string.{*}

--- A numeric parse failure carrying its UTF-8 byte offset.
pub type NumParseError {
  --- No input was available at the requested position.
  NumParseEmpty(i64),
  --- The input does not begin with a complete supported number spelling.
  NumParseInvalid(i64),
  --- The magnitude is too large for the destination type.
  NumParseOverflow(i64),
  --- A non-zero magnitude is too small for the destination float type.
  NumParseUnderflow(i64),
  --- A strict parse found bytes after a valid numeric prefix.
  NumParseTrailing(i64)
}

pub(package) type NumFloatScan {
  NumFloatScan(i64, i64, i64, i64, i64, i64, i64)
}

--- A checked integer conversion failure.
pub type NumCastError {
  --- The source value cannot be represented by the destination type.
  NumCastOutOfRange
}

--- An exact floating-point to integer conversion failure.
pub type NumExactIntError {
  --- The source value is not a number.
  NumExactIntNaN,
  --- The source is fractional, infinite, or outside the destination range.
  NumExactIntNotExact
}

--- Marker trait implemented by every built-in scalar numeric type.
pub trait Num {
}

--- Width and signedness metadata for built-in integer types.
pub trait NumInteger {
  --- Return the integer representation width in bits.
  fn bit_width(self: i64) -> i64
  --- Return whether this is a signed integer type.
  fn is_signed(self: i64) -> bool
}

--- Minimum and maximum values for built-in signed integer types.
pub trait NumSignedInteger {
  --- Return the least representable value, widened to `i64`.
  fn min_i64(self: i64) -> i64
  --- Return the greatest representable value, widened to `i64`.
  fn max_i64(self: i64) -> i64
}

--- Maximum values for built-in unsigned integer types.
pub trait NumUnsignedInteger {
  --- Return the greatest representable value, widened to `u64`.
  fn max_u64(self: i64) -> u64
}

--- IEEE representation metadata for built-in floating-point types.
pub trait NumFloat {
  --- Return the complete floating-point representation width in bits.
  fn float_width(self: i64) -> i64
  --- Return the significand precision in bits, including its implicit bit.
  fn mantissa_bits(self: i64) -> i64
  --- Return the stored exponent-field width in bits.
  fn exponent_bits(self: i64) -> i64
}

-- Private numeric tags keep the scanner compact. They never cross the public
-- API boundary; callers receive `NumParseError` variants.
pub(package) fn num_parse_code_empty() -> i64 { 1 }
pub(package) fn num_parse_code_invalid() -> i64 { 2 }
pub(package) fn num_parse_code_overflow() -> i64 { 3 }
pub(package) fn num_parse_code_trailing() -> i64 { 4 }
pub(package) fn num_parse_code_underflow() -> i64 { 5 }

pub(package) fn num_parse_error_from_code(code: i64, pos: i64) -> NumParseError {
  match code {
    1 -> NumParseEmpty(pos)
    2 -> NumParseInvalid(pos)
    3 -> NumParseOverflow(pos)
    4 -> NumParseTrailing(pos)
    5 -> NumParseUnderflow(pos)
    _ -> NumParseInvalid(pos)
  }
}

--- Render an `i64` in canonical base-ten notation.
pub(package) fn num_render_i64(value: i64) -> str { int_to_str(value) }

--- Render an `f64` with deterministic shortest round-tripping notation.
pub(package) fn num_render_f64(value: f64) -> str { runtime_f64_to_shortest(value) }

--- Render an `f32` with deterministic shortest round-tripping notation.
pub(package) fn num_render_f32(value: f32) -> str { runtime_f32_to_shortest(value) }

--- Return an `f64` value's exact IEEE 754 binary representation.
pub(package) fn num_f64_bits(value: f64) -> u64 { runtime_f64_to_bits(value) }

--- Construct an `f64` from an exact IEEE 754 binary representation.
pub fn f64_from_bits(bits: u64) -> f64 { runtime_f64_from_bits(bits) }

--- Return an `f32` value's exact IEEE 754 binary representation.
pub(package) fn num_f32_bits(value: f32) -> u32 { runtime_f32_to_bits(value) }

--- Construct an `f32` from an exact IEEE 754 binary representation.
pub fn f32_from_bits(bits: u32) -> f32 { runtime_f32_from_bits(bits) }

--- Convert `i64` to `i8`, failing when the value is out of range.
fn num_checked_i64_to_i8(value: i64) -> Result<i8, NumCastError> {
  if value >= -128 and value <= 127 { Ok<i8, NumCastError>(__i64_to_i8(value)) }
  else { Err<i8, NumCastError>(NumCastOutOfRange) }
}

--- Convert `i64` to `i16`, failing when the value is out of range.
fn num_checked_i64_to_i16(value: i64) -> Result<i16, NumCastError> {
  if value >= -32768 and value <= 32767 { Ok<i16, NumCastError>(__i64_to_i16(value)) }
  else { Err<i16, NumCastError>(NumCastOutOfRange) }
}

--- Convert `i64` to `i32`, failing when the value is out of range.
fn num_checked_i64_to_i32(value: i64) -> Result<i32, NumCastError> {
  if value >= -2147483648 and value <= 2147483647 { Ok<i32, NumCastError>(__i64_to_i32(value)) }
  else { Err<i32, NumCastError>(NumCastOutOfRange) }
}

--- Convert `i64` to the current 64-bit `isize` range.
fn num_checked_i64_to_isize(value: i64) -> Result<isize, NumCastError> {
  Ok<isize, NumCastError>(__i64_to_isize(value))
}

--- Convert `i64` to `u8`, failing when the value is out of range.
fn num_checked_i64_to_u8(value: i64) -> Result<u8, NumCastError> {
  if value >= 0 and value <= 255 { Ok<u8, NumCastError>(__i64_to_u8(value)) }
  else { Err<u8, NumCastError>(NumCastOutOfRange) }
}

--- Convert `i64` to `u16`, failing when the value is out of range.
fn num_checked_i64_to_u16(value: i64) -> Result<u16, NumCastError> {
  if value >= 0 and value <= 65535 { Ok<u16, NumCastError>(__i64_to_u16(value)) }
  else { Err<u16, NumCastError>(NumCastOutOfRange) }
}

--- Convert `i64` to `u32`, failing when the value is out of range.
fn num_checked_i64_to_u32(value: i64) -> Result<u32, NumCastError> {
  if value >= 0 and value <= 4294967295 { Ok<u32, NumCastError>(__i64_to_u32(value)) }
  else { Err<u32, NumCastError>(NumCastOutOfRange) }
}

--- Convert non-negative `i64` to `u64`, failing for negative input.
fn num_checked_i64_to_u64(value: i64) -> Result<u64, NumCastError> {
  if value >= 0 { Ok<u64, NumCastError>(__i64_to_u64(value)) }
  else { Err<u64, NumCastError>(NumCastOutOfRange) }
}

--- Convert non-negative `i64` to the current 64-bit `usize` range.
fn num_checked_i64_to_usize(value: i64) -> Result<usize, NumCastError> {
  if value >= 0 { Ok<usize, NumCastError>(__i64_to_usize(value)) }
  else { Err<usize, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `i8`, failing when the value is out of range.
fn num_checked_u64_to_i8(value: u64) -> Result<i8, NumCastError> {
  if value <= 127 { Ok<i8, NumCastError>(__u64_to_i8(value)) }
  else { Err<i8, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `i16`, failing when the value is out of range.
fn num_checked_u64_to_i16(value: u64) -> Result<i16, NumCastError> {
  if value <= 32767 { Ok<i16, NumCastError>(__u64_to_i16(value)) }
  else { Err<i16, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `i32`, failing when the value is out of range.
fn num_checked_u64_to_i32(value: u64) -> Result<i32, NumCastError> {
  if value <= 2147483647 { Ok<i32, NumCastError>(__u64_to_i32(value)) }
  else { Err<i32, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `i64`, failing when the value is out of range.
fn num_checked_u64_to_i64(value: u64) -> Result<i64, NumCastError> {
  if value <= 9223372036854775807 { Ok<i64, NumCastError>(__u64_to_i64(value)) }
  else { Err<i64, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to the current 64-bit `isize`, failing when out of range.
fn num_checked_u64_to_isize(value: u64) -> Result<isize, NumCastError> {
  if value <= 9223372036854775807 { Ok<isize, NumCastError>(__u64_to_isize(value)) }
  else { Err<isize, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `u8`, failing when the value is out of range.
fn num_checked_u64_to_u8(value: u64) -> Result<u8, NumCastError> {
  if value <= 255 { Ok<u8, NumCastError>(__u64_to_u8(value)) }
  else { Err<u8, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `u16`, failing when the value is out of range.
fn num_checked_u64_to_u16(value: u64) -> Result<u16, NumCastError> {
  if value <= 65535 { Ok<u16, NumCastError>(__u64_to_u16(value)) }
  else { Err<u16, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to `u32`, failing when the value is out of range.
fn num_checked_u64_to_u32(value: u64) -> Result<u32, NumCastError> {
  if value <= 4294967295 { Ok<u32, NumCastError>(__u64_to_u32(value)) }
  else { Err<u32, NumCastError>(NumCastOutOfRange) }
}

--- Convert `u64` to the current 64-bit `usize` range.
fn num_checked_u64_to_usize(value: u64) -> Result<usize, NumCastError> {
  Ok<usize, NumCastError>(__u64_to_usize(value))
}

--- Convert `f64` to `i64` only when the value round-trips exactly.
---
--- NaN has its own typed error; fractional, infinite, and out-of-range values
--- report `NumExactIntNotExact` rather than truncating.
pub(package) fn num_exact_i64_from_f64(value: f64) -> Result<i64, NumExactIntError> {
  if value != value {
    Err<i64, NumExactIntError>(NumExactIntNaN)
  } else {
    let truncated = __f64_to_i64_trunc(value)
    if truncated.to_f64() == value {
      Ok<i64, NumExactIntError>(truncated)
    } else {
      Err<i64, NumExactIntError>(NumExactIntNotExact)
    }
  }
}

