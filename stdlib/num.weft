  if value >= 0 and value <= 4294967295 { num_int_cast_ok<u32>(__i64_to_u32(value)) }
  else { num_int_cast_err<u32>(num_int_cast_err_out_of_range()) }
}

pub fn num_i64_to_u64_checked(value: i64) -> NumIntCast<u64> {
