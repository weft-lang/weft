pub fn num_f32_to_f64(value: f32) -> f64 { __f32_to_f64(value) }

pub fn num_f64_to_f32_round(value: f64) -> f32 { __f64_to_f32(value) }

pub fn num_i64_to_i8_checked(value: i64) -> NumIntCast<i8> {
  if value >= -128 and value <= 127 { num_int_cast_ok<i8>(__i64_to_i8(value)) }
  else { num_int_cast_err<i8>(num_int_cast_err_out_of_range()) }
}

pub fn num_i64_to_i16_checked(value: i64) -> NumIntCast<i16> {
  if value >= -32768 and value <= 32767 { num_int_cast_ok<i16>(__i64_to_i16(value)) }
  else { num_int_cast_err<i16>(num_int_cast_err_out_of_range()) }
}

pub fn num_i64_to_i32_checked(value: i64) -> NumIntCast<i32> {
  if value >= -2147483648 and value <= 2147483647 { num_int_cast_ok<i32>(__i64_to_i32(value)) }
  else { num_int_cast_err<i32>(num_int_cast_err_out_of_range()) }
}

pub fn num_i64_to_isize_checked(value: i64) -> NumIntCast<isize> {
  num_int_cast_ok<isize>(__i64_to_isize(value))
}

pub fn num_i64_to_u8_checked(value: i64) -> NumIntCast<u8> {
  if value >= 0 and value <= 255 { num_int_cast_ok<u8>(__i64_to_u8(value)) }
  else { num_int_cast_err<u8>(num_int_cast_err_out_of_range()) }
}

pub fn num_i64_to_u16_checked(value: i64) -> NumIntCast<u16> {
  if value >= 0 and value <= 65535 { num_int_cast_ok<u16>(__i64_to_u16(value)) }
  else { num_int_cast_err<u16>(num_int_cast_err_out_of_range()) }
}

