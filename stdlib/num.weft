impl usize {
  --- Add two platform-sized unsigned values, or return `None` on overflow.
  pub fn checked_add(self: usize, other: usize) -> Option<usize> {
    num_scalar_usize_checked_add(self, other)
  }

  --- Subtract two platform-sized unsigned values, or return `None` on underflow.
  pub fn checked_sub(self: usize, other: usize) -> Option<usize> {
    num_scalar_usize_checked_sub(self, other)
  }

  --- Multiply two platform-sized unsigned values, or return `None` on overflow.
  pub fn checked_mul(self: usize, other: usize) -> Option<usize> {
    num_scalar_usize_checked_mul(self, other)
  }

  fn to_u64(self: usize) -> u64 {
    __usize_to_u64(self)
  }

  fn to_f64(self: usize) -> f64 {
    __usize_to_f64(self)
  }

  fn to_f32_round(self: usize) -> f32 {
    __usize_to_f32(self)
  }
}

