-- stdlib/num.weft — numeric conversion helpers
--
-- Parsing is pure and returns explicit success/failure variants. Prefix
-- parsing reports the next byte offset so parsers can compose without sentinels.

use runtime/memory.{*}
use runtime/float.{*}
use runtime/string.{*}
use stdlib/string.{*}

pub type NumParseI64 {
  NumParseI64Ok(i64, i64),
  NumParseI64Err(i64, i64)
}

pub type NumFloatParseError {
  NumFloatParseEmpty,
  NumFloatParseInvalid,
  NumFloatParseOverflow,
  NumFloatParseUnderflow,
  NumFloatParseTrailing
}

pub type NumParseF64 {
  NumParseF64Ok(f64, i64),
  NumParseF64Err(NumFloatParseError, i64)
}

pub type NumParseF32 {
  NumParseF32Ok(f32, i64),
  NumParseF32Err(NumFloatParseError, i64)
}

pub(package) type NumFloatScan {
  NumFloatScan(i64, i64, i64, i64, i64, i64, i64)
}

pub type NumF64ToI64 {
  NumF64ToI64Ok(i64),
  NumF64ToI64Err(i64)
}

pub type NumIntCast<T> {
  NumIntCastOk(T),
  NumIntCastErr(i64)
}

pub trait Num {
}

pub trait NumInteger {
  fn bit_width(self: i64) -> i64
  fn is_signed(self: i64) -> i64
}

pub trait NumSignedInteger {
  fn min_i64(self: i64) -> i64
  fn max_i64(self: i64) -> i64
}

pub trait NumUnsignedInteger {
  fn max_u64(self: i64) -> u64
}

pub trait NumFloat {
  fn float_width(self: i64) -> i64
  fn mantissa_bits(self: i64) -> i64
  fn exponent_bits(self: i64) -> i64
}

pub fn num_parse_err_empty() -> i64 { 1 }
pub fn num_parse_err_invalid() -> i64 { 2 }
pub fn num_parse_err_overflow() -> i64 { 3 }
pub fn num_parse_err_trailing() -> i64 { 4 }
pub fn num_parse_err_underflow() -> i64 { 5 }

pub fn num_float_parse_error_code(error: NumFloatParseError) -> i64 {
  match error {
    NumFloatParseEmpty -> num_parse_err_empty()
    NumFloatParseInvalid -> num_parse_err_invalid()
    NumFloatParseOverflow -> num_parse_err_overflow()
    NumFloatParseUnderflow -> num_parse_err_underflow()
    NumFloatParseTrailing -> num_parse_err_trailing()
  }
}

pub fn num_f64_to_i64_err_nan() -> i64 { 1 }
pub fn num_f64_to_i64_err_not_exact() -> i64 { 2 }

pub fn num_int_cast_err_out_of_range() -> i64 { 1 }

pub(package) fn num_parse_i64_ok(value: i64, next: i64) -> NumParseI64 {
  NumParseI64Ok(value, next)
}

pub(package) fn num_parse_i64_err(code: i64, pos: i64) -> NumParseI64 {
  NumParseI64Err(code, pos)
}

pub(package) fn num_parse_f64_ok(value: f64, next: i64) -> NumParseF64 {
  NumParseF64Ok(value, next)
}

pub(package) fn num_parse_f64_err(error: NumFloatParseError, pos: i64) -> NumParseF64 {
  NumParseF64Err(error, pos)
}

pub(package) fn num_parse_f32_ok(value: f32, next: i64) -> NumParseF32 {
  NumParseF32Ok(value, next)
}

pub(package) fn num_parse_f32_err(error: NumFloatParseError, pos: i64) -> NumParseF32 {
  NumParseF32Err(error, pos)
}

pub(package) fn num_f64_to_i64_ok(value: i64) -> NumF64ToI64 {
  NumF64ToI64Ok(value)
}

pub(package) fn num_f64_to_i64_err(code: i64) -> NumF64ToI64 {
  NumF64ToI64Err(code)
}

pub(package) fn num_int_cast_ok<T>(value: T) -> NumIntCast<T> {
  NumIntCastOk<T>(value)
}

pub(package) fn num_int_cast_err<T>(code: i64) -> NumIntCast<T> {
  NumIntCastErr<T>(code)
}

pub fn num_parse_i64_is_ok(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 1
    NumParseI64Err(code, pos) -> 0
  }
}

pub fn num_parse_f64_is_ok(result: NumParseF64) -> i64 {
  match result {
    NumParseF64Ok(value, next) -> 1
    NumParseF64Err(error, pos) -> 0
  }
}

pub fn num_parse_f32_is_ok(result: NumParseF32) -> i64 {
  match result {
    NumParseF32Ok(value, next) -> 1
    NumParseF32Err(error, pos) -> 0
  }
}

pub fn num_f64_to_i64_is_ok(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 1
    NumF64ToI64Err(code) -> 0
  }
}

pub fn num_int_cast_is_ok<T>(result: NumIntCast<T>) -> i64 {
  match result {
    NumIntCastOk(value) -> 1
    NumIntCastErr(code) -> 0
  }
}

pub fn num_parse_i64_value_or(result: NumParseI64, default: i64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> value
    NumParseI64Err(code, pos) -> default
  }
}

pub fn num_parse_f64_value_or(result: NumParseF64, default: f64) -> f64 {
  match result {
    NumParseF64Ok(value, next) -> value
    NumParseF64Err(error, pos) -> default
  }
}

pub fn num_parse_f32_value_or(result: NumParseF32, default: f32) -> f32 {
  match result {
    NumParseF32Ok(value, next) -> value
    NumParseF32Err(error, pos) -> default
  }
}

pub fn num_f64_to_i64_value_or(result: NumF64ToI64, default: i64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> value
    NumF64ToI64Err(code) -> default
  }
}

pub fn num_int_cast_value_or<T>(result: NumIntCast<T>, default: T) -> T {
  match result {
    NumIntCastOk(value) -> value
    NumIntCastErr(code) -> default
  }
}

pub fn num_parse_i64_next_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

pub fn num_parse_f64_next_pos(result: NumParseF64) -> i64 {
  match result {
    NumParseF64Ok(value, next) -> next
    NumParseF64Err(error, pos) -> pos
  }
}

pub fn num_parse_f32_next_pos(result: NumParseF32) -> i64 {
  match result {
    NumParseF32Ok(value, next) -> next
    NumParseF32Err(error, pos) -> pos
  }
}

pub fn num_parse_i64_error_code(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 0
    NumParseI64Err(code, pos) -> code
  }
}

pub fn num_parse_f64_error_code(result: NumParseF64) -> i64 {
  match result {
    NumParseF64Ok(value, next) -> 0
    NumParseF64Err(error, pos) -> num_float_parse_error_code(error)
  }
}

pub fn num_parse_f32_error_code(result: NumParseF32) -> i64 {
  match result {
    NumParseF32Ok(value, next) -> 0
    NumParseF32Err(error, pos) -> num_float_parse_error_code(error)
  }
}

pub fn num_f64_to_i64_error_code(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 0
    NumF64ToI64Err(code) -> code
  }
}

pub fn num_int_cast_error_code<T>(result: NumIntCast<T>) -> i64 {
  match result {
    NumIntCastOk(value) -> 0
    NumIntCastErr(code) -> code
  }
}

pub fn num_parse_i64_error_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

pub fn num_parse_f64_error_pos(result: NumParseF64) -> i64 {
  match result {
    NumParseF64Ok(value, next) -> next
    NumParseF64Err(error, pos) -> pos
  }
}

pub fn num_parse_f32_error_pos(result: NumParseF32) -> i64 {
  match result {
    NumParseF32Ok(value, next) -> next
    NumParseF32Err(error, pos) -> pos
  }
}

pub fn num_i64_to_str(value: i64) -> str { int_to_str(value) }

pub fn num_f64_to_str(value: f64) -> str { runtime_f64_to_shortest(value) }

pub fn num_f32_to_str(value: f32) -> str { runtime_f32_to_shortest(value) }

pub fn num_f64_to_bits(value: f64) -> u64 { runtime_f64_to_bits(value) }

pub fn num_f64_from_bits(bits: u64) -> f64 { runtime_f64_from_bits(bits) }

pub fn num_f32_to_bits(value: f32) -> u32 { runtime_f32_to_bits(value) }

pub fn num_f32_from_bits(bits: u32) -> f32 { runtime_f32_from_bits(bits) }

pub fn num_accepts_numeric<T: Num>(value: T) -> i64 { 1 }

pub fn num_bit_width<T: NumInteger>(value: T) -> i64 {
  value.bit_width()
}

pub fn num_is_signed<T: NumInteger>(value: T) -> i64 {
  value.is_signed()
}

pub fn num_signed_min_i64<T: NumSignedInteger>(value: T) -> i64 {
  value.min_i64()
}

pub fn num_signed_max_i64<T: NumSignedInteger>(value: T) -> i64 {
  value.max_i64()
}

pub fn num_unsigned_max_u64<T: NumUnsignedInteger>(value: T) -> u64 {
  value.max_u64()
}

pub fn num_float_width<T: NumFloat>(value: T) -> i64 {
  value.float_width()
}

pub fn num_float_mantissa_bits<T: NumFloat>(value: T) -> i64 {
  value.mantissa_bits()
}

pub fn num_float_exponent_bits<T: NumFloat>(value: T) -> i64 {
  value.exponent_bits()
}

