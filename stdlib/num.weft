pub(package) fn num_is_digit(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { 1 } else { 0 }
}

pub(package) fn num_i64_limit_string(neg: i64) -> str {
  if neg == 1 { "9223372036854775808" } else { "9223372036854775807" }
}

pub(package) fn num_digits_exceed_i64_limit(src: i64, start: i64, end: i64, neg: i64) -> i64 {
  let mut significant = start
  while significant < end and mem_load8_at(src, significant) == 48 {
    significant = significant + 1
  }
  let significant_len = end - significant
  if significant_len == 0 {
    0
  } else {
    let limit = num_i64_limit_string(neg)
    let limit_len = str_len(limit)
    if significant_len > limit_len {
      1
    } else { if significant_len < limit_len {
      0
    } else {
      let mut result = 0
      let mut done = 0
      let mut i = 0
      while done == 0 and i < significant_len {
        let got = mem_load8_at(src, significant + i)
        let allowed = str_byte_at(limit, i)
        if got > allowed {
          result = 1
          done = 1
        } else { if got < allowed {
          done = 1
        } else {
          i = i + 1
        } }
      }
      result
    } }
  }
}

pub(package) fn num_parse_i64_prefix_bytes(src: i64, n: i64, pos: usize) -> Result<(i64, usize), NumParseError> {
  if pos >= num_parse_offset_from_storage(n) {
    Err<(i64, usize), NumParseError>(NumParseEmpty(pos))
  } else {
    let offset = pos |> __usize_to_u64() |> __u64_to_i64()
    let first = mem_load8_at(src, offset)
    let neg = if first == 45 { 1 } else { 0 }
    let digit_start = if first == 45 or first == 43 { offset + 1 } else { offset }
    if digit_start >= n {
      Err<(i64, usize), NumParseError>(NumParseInvalid(num_parse_offset_from_storage(digit_start)))
    } else { if num_is_digit(mem_load8_at(src, digit_start)) == 0 {
      Err<(i64, usize), NumParseError>(NumParseInvalid(num_parse_offset_from_storage(digit_start)))
    } else {
      let mut p = digit_start
      while p < n and num_is_digit(mem_load8_at(src, p)) == 1 {
        p = p + 1
      }
      if num_digits_exceed_i64_limit(src, digit_start, p, neg) == 1 {
        Err<(i64, usize), NumParseError>(NumParseOverflow(num_parse_offset_from_storage(p)))
      } else {
        let mut value = 0
        let mut i = digit_start
        while i < p {
          value = value * 10 - (mem_load8_at(src, i) - 48)
          i = i + 1
        }
        if neg == 1 {
          Ok<(i64, usize), NumParseError>((value, num_parse_offset_from_storage(p)))
        } else {
          Ok<(i64, usize), NumParseError>((0 - value, num_parse_offset_from_storage(p)))
        }
      }
    } }
  }
}

--- Parse a signed decimal `i64` prefix beginning at UTF-8 byte offset `pos`.
---
--- An optional leading `+` or `-` is accepted. Success reports the first
--- unconsumed byte; valid trailing input is deliberately left to the caller.
--- At or past the end, `NumParseEmpty` preserves the requested position.
pub fn parse_i64_prefix(s: str, pos: usize) -> Result<(i64, usize), NumParseError> {
  num_parse_i64_prefix_bytes(runtime_str_ptr(s), str_len(s), pos)
}

--- Parse an entire signed decimal `i64`, rejecting trailing bytes.
pub fn parse_i64(s: str) -> Result<i64, NumParseError> {
  match parse_i64_prefix(s, 0) {
    Err(error) -> Err<i64, NumParseError>(error)
    Ok((value, next)) -> if next == s.len() {
      Ok<i64, NumParseError>(value)
    } else {
      Err<i64, NumParseError>(NumParseTrailing(next))
    }
  }
}

pub(package) fn num_bytes_equal(source: i64, n: i64, start: i64, expected: str) -> bool {
  let len = str_len(expected)
  if start < 0 or start > n or len > n - start { false }
  else {
    let mut i = 0
    let mut equal = true
    while i < len and equal {
      if mem_load8_at(source, start + i) == str_byte_at(expected, i) {
        i = i + 1
      } else {
        equal = false
      }
    }
    equal
  }
}

-- Scan the decimal grammar without converting it. The final field is the
-- scientific decimal exponent of the first significant digit, clamped well
-- beyond either IEEE lane so pathological exponent spellings classify in
-- bounded time before arbitrary-precision conversion begins.
pub(package) fn num_float_scan_prefix_bytes(source: i64, n: i64, pos: i64) -> NumFloatScan {
  if pos < 0 or pos >= n {
    NumFloatRejected(NumParseEmpty(num_parse_offset_from_storage(pos)))
  } else {
    let first = mem_load8_at(source, pos)
    let negative = first == 45
    let start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if start >= n {
      NumFloatRejected(NumParseInvalid(num_parse_offset_from_storage(start)))
    } else {
      let mut p = start
      let mut digit_count = 0
      let mut digits_before_dot = 0
      let mut first_nonzero = 0 - 1
      while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
        if first_nonzero < 0 and mem_load8_at(source, p) != 48 { first_nonzero = digit_count } else { 0 }
        digit_count = digit_count + 1
        digits_before_dot = digits_before_dot + 1
        p = p + 1
      }
      if p < n and mem_load8_at(source, p) == 46 {
        p = p + 1
        while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
          if first_nonzero < 0 and mem_load8_at(source, p) != 48 { first_nonzero = digit_count } else { 0 }
          digit_count = digit_count + 1
          p = p + 1
        }
      } else { 0 }
      if digit_count == 0 {
        NumFloatRejected(NumParseInvalid(num_parse_offset_from_storage(start)))
      } else {
        let mut source_exponent = 0
        let mut exponent_negative = false
        if p < n and (mem_load8_at(source, p) == 101 or mem_load8_at(source, p) == 69) {
          p = p + 1
          if p < n and (mem_load8_at(source, p) == 43 or mem_load8_at(source, p) == 45) {
            exponent_negative = mem_load8_at(source, p) == 45
            p = p + 1
          } else { 0 }
          let exponent_start = p
          while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
            if source_exponent < 100000 {
              source_exponent = source_exponent * 10 + mem_load8_at(source, p) - 48
              if source_exponent > 100000 { source_exponent = 100000 } else { 0 }
            } else { 0 }
            p = p + 1
          }
          if p == exponent_start {
            return NumFloatRejected(NumParseInvalid(num_parse_offset_from_storage(p)))
          } else { 0 }
        } else { 0 }
        let signed_exponent = if exponent_negative { 0 - source_exponent } else { source_exponent }
        let nonzero = first_nonzero >= 0
        let decimal_exponent = if nonzero {
          signed_exponent + digits_before_dot - first_nonzero - 1
        } else { 0 }
        NumFloatScanned(start, p, negative, nonzero, decimal_exponent)
      }
    }
  }
}

pub(package) fn num_f64_from_unsigned_bits(bits: i64, negative: bool) -> f64 {
  let magnitude: u64 = __i64_to_u64(bits)
  let word: u64 = if negative { magnitude bor 9223372036854775808 } else { magnitude }
  runtime_f64_from_bits(word)
}

pub(package) fn num_f32_from_unsigned_bits(bits: i64, negative: bool) -> f32 {
  let magnitude: u32 = __i64_to_u32(bits)
  let word: u32 = if negative { magnitude bor 2147483648 } else { magnitude }
  runtime_f32_from_bits(word)
}

pub(package) fn num_parse_f64_prefix_bytes(source: i64, n: i64, pos: usize) -> Result<(f64, usize), NumParseError> {
  if pos >= num_parse_offset_from_storage(n) {
    Err<(f64, usize), NumParseError>(NumParseEmpty(pos))
  } else {
    let offset = pos |> __usize_to_u64() |> __u64_to_i64()
    let first = mem_load8_at(source, offset)
    let negative = first == 45
    let start = if first == 45 or first == 43 { offset + 1 } else { offset }
    if num_bytes_equal(source, n, start, "inf") {
      Ok<(f64, usize), NumParseError>((num_f64_from_unsigned_bits(9218868437227405312, negative), num_parse_offset_from_storage(start + 3)))
    } else { if num_bytes_equal(source, n, start, "NaN") {
      Ok<(f64, usize), NumParseError>((runtime_f64_from_bits(9221120237041090560), num_parse_offset_from_storage(start + 3)))
    } else {
      match num_float_scan_prefix_bytes(source, n, offset) {
        NumFloatRejected(error) -> Err<(f64, usize), NumParseError>(error)
        NumFloatScanned(_, end, _, true, exponent) if exponent > 308 ->
          Err<(f64, usize), NumParseError>(NumParseOverflow(num_parse_offset_from_storage(end)))
        NumFloatScanned(_, end, _, true, exponent) if exponent < 0 - 324 ->
          Err<(f64, usize), NumParseError>(NumParseUnderflow(num_parse_offset_from_storage(end)))
        NumFloatScanned(start, end, negative, nonzero, _) -> {
          let converted = runtime_float_decimal_f64_bits(source, start, end - start)
          let bits = runtime_float_bits_result_bits(converted)
          let next = num_parse_offset_from_storage(end)
          match bits {
            _ if runtime_float_bits_result_ok(converted) != 1 -> Err<(f64, usize), NumParseError>(NumParseInvalid(next))
            9218868437227405312 -> Err<(f64, usize), NumParseError>(NumParseOverflow(next))
            0 if nonzero -> Err<(f64, usize), NumParseError>(NumParseUnderflow(next))
            _ -> Ok<(f64, usize), NumParseError>((num_f64_from_unsigned_bits(bits, negative), next))
          }
        }
      }
    } }
  }
}

pub(package) fn num_parse_f32_prefix_bytes(source: i64, n: i64, pos: usize) -> Result<(f32, usize), NumParseError> {
  if pos >= num_parse_offset_from_storage(n) {
    Err<(f32, usize), NumParseError>(NumParseEmpty(pos))
  } else {
    let offset = pos |> __usize_to_u64() |> __u64_to_i64()
    let first = mem_load8_at(source, offset)
    let negative = first == 45
    let start = if first == 45 or first == 43 { offset + 1 } else { offset }
    if num_bytes_equal(source, n, start, "inf") {
      Ok<(f32, usize), NumParseError>((num_f32_from_unsigned_bits(2139095040, negative), num_parse_offset_from_storage(start + 3)))
    } else { if num_bytes_equal(source, n, start, "NaN") {
      Ok<(f32, usize), NumParseError>((runtime_f32_from_bits(2143289344), num_parse_offset_from_storage(start + 3)))
    } else {
      match num_float_scan_prefix_bytes(source, n, offset) {
        NumFloatRejected(error) -> Err<(f32, usize), NumParseError>(error)
        NumFloatScanned(_, end, _, true, exponent) if exponent > 38 ->
          Err<(f32, usize), NumParseError>(NumParseOverflow(num_parse_offset_from_storage(end)))
        -- The zero/min-subnormal midpoint is about 7.006e-46, so the exact
        -- converter must decide whether exponent -46 rounds up or to zero.
        NumFloatScanned(_, end, _, true, exponent) if exponent < 0 - 46 ->
          Err<(f32, usize), NumParseError>(NumParseUnderflow(num_parse_offset_from_storage(end)))
        NumFloatScanned(start, end, negative, nonzero, _) -> {
          let converted = runtime_float_decimal_f32_bits(source, start, end - start)
          let bits = runtime_float_bits_result_bits(converted)
          let next = num_parse_offset_from_storage(end)
          match bits {
            _ if runtime_float_bits_result_ok(converted) != 1 -> Err<(f32, usize), NumParseError>(NumParseInvalid(next))
            2139095040 -> Err<(f32, usize), NumParseError>(NumParseOverflow(next))
            0 if nonzero -> Err<(f32, usize), NumParseError>(NumParseUnderflow(next))
            _ -> Ok<(f32, usize), NumParseError>((num_f32_from_unsigned_bits(bits, negative), next))
          }
        }
      }
    } }
  }
}

--- Parse an `f64` prefix at byte offset `pos` with nearest-even rounding.
---
--- Decimal/exponent forms, signed zero, `inf`, `-inf`, and `NaN` are
--- supported. Success reports the first unconsumed UTF-8 byte offset.
--- At or past the end, `NumParseEmpty` preserves the requested position.
pub fn parse_f64_prefix(source: str, pos: usize) -> Result<(f64, usize), NumParseError> {
  num_parse_f64_prefix_bytes(runtime_str_ptr(source), str_len(source), pos)
}

--- Parse an `f32` prefix at byte offset `pos` with nearest-even rounding.
---
--- Decimal/exponent forms, signed zero, `inf`, `-inf`, and `NaN` are
--- supported. Success reports the first unconsumed UTF-8 byte offset.
--- At or past the end, `NumParseEmpty` preserves the requested position.
pub fn parse_f32_prefix(source: str, pos: usize) -> Result<(f32, usize), NumParseError> {
  num_parse_f32_prefix_bytes(runtime_str_ptr(source), str_len(source), pos)
}

--- Parse an entire `f64`, rejecting trailing bytes with a typed error.
pub fn parse_f64(source: str) -> Result<f64, NumParseError> {
  match parse_f64_prefix(source, 0) {
    Err(error) -> Err<f64, NumParseError>(error)
    Ok((value, next)) -> if next == source.len() {
      Ok<f64, NumParseError>(value)
    } else {
      Err<f64, NumParseError>(NumParseTrailing(next))
    }
  }
}

--- Parse an entire `f32`, rejecting trailing bytes with a typed error.
pub fn parse_f32(source: str) -> Result<f32, NumParseError> {
  match parse_f32_prefix(source, 0) {
    Err(error) -> Err<f32, NumParseError>(error)
    Ok((value, next)) -> if next == source.len() {
      Ok<f32, NumParseError>(value)
    } else {
      Err<f32, NumParseError>(NumParseTrailing(next))
    }
  }
}
