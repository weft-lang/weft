pub(package) fn num_is_digit(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { 1 } else { 0 }
}

pub(package) fn num_i64_limit_string(neg: i64) -> str {
  if neg == 1 { "9223372036854775808" } else { "9223372036854775807" }
}

pub(package) fn num_digits_exceed_i64_limit(src: i64, start: i64, end: i64, neg: i64) -> i64 {
  let mut significant = start
  while significant < end and mem_load8_at(src, significant) == 48 {
    significant = significant + 1
  }
  let significant_len = end - significant
  if significant_len == 0 {
    0
  } else {
    let limit = num_i64_limit_string(neg)
    let limit_len = str_len(limit)
    if significant_len > limit_len {
      1
    } else { if significant_len < limit_len {
      0
    } else {
      let mut result = 0
      let mut done = 0
      let mut i = 0
      while done == 0 and i < significant_len {
        let got = mem_load8_at(src, significant + i)
        let allowed = str_byte_at(limit, i)
        if got > allowed {
          result = 1
          done = 1
        } else { if got < allowed {
          done = 1
        } else {
          i = i + 1
        } }
      }
      result
    } }
  }
}

pub(package) fn num_parse_i64_prefix_bytes(src: i64, n: i64, pos: i64) -> Result<(i64, i64), NumParseError> {
  if pos < 0 or pos >= n {
    Err<(i64, i64), NumParseError>(NumParseEmpty(pos))
  } else {
    let first = mem_load8_at(src, pos)
    let neg = if first == 45 { 1 } else { 0 }
    let digit_start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if digit_start >= n {
      Err<(i64, i64), NumParseError>(NumParseInvalid(digit_start))
    } else { if num_is_digit(mem_load8_at(src, digit_start)) == 0 {
      Err<(i64, i64), NumParseError>(NumParseInvalid(digit_start))
    } else {
      let mut p = digit_start
      while p < n and num_is_digit(mem_load8_at(src, p)) == 1 {
        p = p + 1
      }
      if num_digits_exceed_i64_limit(src, digit_start, p, neg) == 1 {
        Err<(i64, i64), NumParseError>(NumParseOverflow(p))
      } else {
        let mut value = 0
        let mut i = digit_start
        while i < p {
          value = value * 10 - (mem_load8_at(src, i) - 48)
          i = i + 1
        }
        if neg == 1 {
          Ok<(i64, i64), NumParseError>((value, p))
        } else {
          Ok<(i64, i64), NumParseError>((0 - value, p))
        }
      }
    } }
  }
}

--- Parse a signed decimal `i64` prefix beginning at UTF-8 byte offset `pos`.
---
--- An optional leading `+` or `-` is accepted. Success reports the first
--- unconsumed byte; valid trailing input is deliberately left to the caller.
pub fn parse_i64_prefix(s: str, pos: i64) -> Result<(i64, i64), NumParseError> {
  num_parse_i64_prefix_bytes(runtime_str_ptr(s), str_len(s), pos)
}

--- Parse an entire signed decimal `i64`, rejecting trailing bytes.
pub fn parse_i64(s: str) -> Result<i64, NumParseError> {
  match parse_i64_prefix(s, 0) {
    Err(error) -> Err<i64, NumParseError>(error)
    Ok((value, next)) -> if next == str_len(s) {
      Ok<i64, NumParseError>(value)
    } else {
      Err<i64, NumParseError>(NumParseTrailing(next))
    }
  }
}

pub(package) fn num_float_scan_code(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> code }
}

pub(package) fn num_float_scan_error_pos(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> error_pos }
}

pub(package) fn num_float_scan_end(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> end }
}

pub(package) fn num_float_scan_start(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> start }
}

pub(package) fn num_float_scan_negative(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> negative }
}

pub(package) fn num_float_scan_nonzero(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> nonzero }
}

pub(package) fn num_float_scan_decimal_exponent(scan: NumFloatScan) -> i64 {
  match scan { NumFloatScan(code, error_pos, end, start, negative, nonzero, decimal_exponent) -> decimal_exponent }
}

pub(package) fn num_bytes_equal(source: i64, n: i64, start: i64, expected: str) -> i64 {
  let len = str_len(expected)
  if start < 0 or start + len > n { 0 }
  else {
    let mut i = 0
    let mut equal = 1
    while i < len and equal == 1 {
      if mem_load8_at(source, start + i) == str_byte_at(expected, i) {
        i = i + 1
      } else {
        equal = 0
      }
    }
    equal
  }
}

-- Scan the decimal grammar without converting it. The final field is the
-- scientific decimal exponent of the first significant digit, clamped well
-- beyond either IEEE lane so pathological exponent spellings classify in
-- bounded time before arbitrary-precision conversion begins.
pub(package) fn num_float_scan_prefix_bytes(source: i64, n: i64, pos: i64) -> NumFloatScan {
  if pos < 0 or pos >= n {
    NumFloatScan(num_parse_code_empty(), pos, pos, pos, 0, 0, 0)
  } else {
    let first = mem_load8_at(source, pos)
    let negative = if first == 45 { 1 } else { 0 }
    let start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if start >= n {
      NumFloatScan(num_parse_code_invalid(), start, start, start, negative, 0, 0)
    } else {
      let mut p = start
      let mut digit_count = 0
      let mut digits_before_dot = 0
      let mut first_nonzero = 0 - 1
      while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
        if first_nonzero < 0 and mem_load8_at(source, p) != 48 { first_nonzero = digit_count } else { 0 }
        digit_count = digit_count + 1
        digits_before_dot = digits_before_dot + 1
        p = p + 1
      }
      if p < n and mem_load8_at(source, p) == 46 {
        p = p + 1
        while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
          if first_nonzero < 0 and mem_load8_at(source, p) != 48 { first_nonzero = digit_count } else { 0 }
          digit_count = digit_count + 1
          p = p + 1
        }
      } else { 0 }
      if digit_count == 0 {
        NumFloatScan(num_parse_code_invalid(), start, p, start, negative, 0, 0)
      } else {
        let mut source_exponent = 0
        let mut exponent_negative = 0
        let mut exponent_error = 0
        let mut exponent_error_pos = p
        if p < n and (mem_load8_at(source, p) == 101 or mem_load8_at(source, p) == 69) {
          p = p + 1
          if p < n and (mem_load8_at(source, p) == 43 or mem_load8_at(source, p) == 45) {
            if mem_load8_at(source, p) == 45 { exponent_negative = 1 } else { 0 }
            p = p + 1
          } else { 0 }
          let exponent_start = p
          while p < n and num_is_digit(mem_load8_at(source, p)) == 1 {
            if source_exponent < 100000 {
              source_exponent = source_exponent * 10 + mem_load8_at(source, p) - 48
              if source_exponent > 100000 { source_exponent = 100000 } else { 0 }
            } else { 0 }
            p = p + 1
          }
          if p == exponent_start {
            exponent_error = 1
            exponent_error_pos = p
          } else { 0 }
        } else { 0 }
        if exponent_error == 1 {
          NumFloatScan(num_parse_code_invalid(), exponent_error_pos, p, start, negative, 0, 0)
        } else {
          let signed_exponent = if exponent_negative == 1 { 0 - source_exponent } else { source_exponent }
          let nonzero = if first_nonzero >= 0 { 1 } else { 0 }
          let decimal_exponent = if nonzero == 1 {
            signed_exponent + digits_before_dot - first_nonzero - 1
          } else { 0 }
          NumFloatScan(0, p, p, start, negative, nonzero, decimal_exponent)
        }
      }
    }
  }
}

pub(package) fn num_f64_from_unsigned_bits(bits: i64, negative: i64) -> f64 {
  let magnitude: u64 = __i64_to_u64(bits)
  let word: u64 = if negative == 1 { magnitude bor 9223372036854775808 } else { magnitude }
  runtime_f64_from_bits(word)
}

pub(package) fn num_f32_from_unsigned_bits(bits: i64, negative: i64) -> f32 {
  let magnitude: u32 = __i64_to_u32(bits)
  let word: u32 = if negative == 1 { magnitude bor 2147483648 } else { magnitude }
  runtime_f32_from_bits(word)
}

pub(package) fn num_parse_f64_prefix_bytes(source: i64, n: i64, pos: i64) -> Result<(f64, i64), NumParseError> {
  if pos < 0 or pos >= n {
    Err<(f64, i64), NumParseError>(NumParseEmpty(pos))
  } else {
    let first = mem_load8_at(source, pos)
    let negative = if first == 45 { 1 } else { 0 }
    let start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if num_bytes_equal(source, n, start, "inf") == 1 {
      Ok<(f64, i64), NumParseError>((num_f64_from_unsigned_bits(9218868437227405312, negative), start + 3))
    } else { if num_bytes_equal(source, n, start, "NaN") == 1 {
      Ok<(f64, i64), NumParseError>((runtime_f64_from_bits(9221120237041090560), start + 3))
    } else {
      let scan = num_float_scan_prefix_bytes(source, n, pos)
      let code = num_float_scan_code(scan)
      if code != 0 {
        Err<(f64, i64), NumParseError>(num_parse_error_from_code(code, num_float_scan_error_pos(scan)))
      } else {
        let decimal_exponent = num_float_scan_decimal_exponent(scan)
        if num_float_scan_nonzero(scan) == 1 and decimal_exponent > 308 {
          Err<(f64, i64), NumParseError>(NumParseOverflow(num_float_scan_end(scan)))
        } else { if num_float_scan_nonzero(scan) == 1 and decimal_exponent < 0 - 324 {
          Err<(f64, i64), NumParseError>(NumParseUnderflow(num_float_scan_end(scan)))
        } else {
          let start0 = num_float_scan_start(scan)
          let end = num_float_scan_end(scan)
          let converted = runtime_float_decimal_f64_bits(source, start0, end - start0)
          let bits = runtime_float_bits_result_bits(converted)
          if runtime_float_bits_result_ok(converted) != 1 {
            Err<(f64, i64), NumParseError>(NumParseInvalid(end))
          } else { if bits == 9218868437227405312 {
            Err<(f64, i64), NumParseError>(NumParseOverflow(end))
          } else { if bits == 0 and num_float_scan_nonzero(scan) == 1 {
            Err<(f64, i64), NumParseError>(NumParseUnderflow(end))
          } else {
            Ok<(f64, i64), NumParseError>((num_f64_from_unsigned_bits(bits, num_float_scan_negative(scan)), end))
          } } }
        } }
      }
    } }
  }
}

pub(package) fn num_parse_f32_prefix_bytes(source: i64, n: i64, pos: i64) -> Result<(f32, i64), NumParseError> {
  if pos < 0 or pos >= n {
    Err<(f32, i64), NumParseError>(NumParseEmpty(pos))
  } else {
    let first = mem_load8_at(source, pos)
    let negative = if first == 45 { 1 } else { 0 }
    let start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if num_bytes_equal(source, n, start, "inf") == 1 {
      Ok<(f32, i64), NumParseError>((num_f32_from_unsigned_bits(2139095040, negative), start + 3))
    } else { if num_bytes_equal(source, n, start, "NaN") == 1 {
      Ok<(f32, i64), NumParseError>((runtime_f32_from_bits(2143289344), start + 3))
    } else {
      let scan = num_float_scan_prefix_bytes(source, n, pos)
      let code = num_float_scan_code(scan)
      if code != 0 {
        Err<(f32, i64), NumParseError>(num_parse_error_from_code(code, num_float_scan_error_pos(scan)))
      } else {
        let decimal_exponent = num_float_scan_decimal_exponent(scan)
        if num_float_scan_nonzero(scan) == 1 and decimal_exponent > 38 {
          Err<(f32, i64), NumParseError>(NumParseOverflow(num_float_scan_end(scan)))
        } else { if num_float_scan_nonzero(scan) == 1 and decimal_exponent < 0 - 45 {
          Err<(f32, i64), NumParseError>(NumParseUnderflow(num_float_scan_end(scan)))
        } else {
          let start0 = num_float_scan_start(scan)
          let end = num_float_scan_end(scan)
          let converted = runtime_float_decimal_f32_bits(source, start0, end - start0)
          let bits = runtime_float_bits_result_bits(converted)
          if runtime_float_bits_result_ok(converted) != 1 {
            Err<(f32, i64), NumParseError>(NumParseInvalid(end))
          } else { if bits == 2139095040 {
            Err<(f32, i64), NumParseError>(NumParseOverflow(end))
          } else { if bits == 0 and num_float_scan_nonzero(scan) == 1 {
            Err<(f32, i64), NumParseError>(NumParseUnderflow(end))
          } else {
            Ok<(f32, i64), NumParseError>((num_f32_from_unsigned_bits(bits, num_float_scan_negative(scan)), end))
          } } }
        } }
      }
    } }
  }
}

--- Parse an `f64` prefix at byte offset `pos` with nearest-even rounding.
---
--- Decimal/exponent forms, signed zero, `inf`, `-inf`, and `NaN` are
--- supported. Success reports the first unconsumed UTF-8 byte offset.
pub fn parse_f64_prefix(source: str, pos: i64) -> Result<(f64, i64), NumParseError> {
  num_parse_f64_prefix_bytes(runtime_str_ptr(source), str_len(source), pos)
}

--- Parse an `f32` prefix at byte offset `pos` with nearest-even rounding.
---
--- Decimal/exponent forms, signed zero, `inf`, `-inf`, and `NaN` are
--- supported. Success reports the first unconsumed UTF-8 byte offset.
pub fn parse_f32_prefix(source: str, pos: i64) -> Result<(f32, i64), NumParseError> {
  num_parse_f32_prefix_bytes(runtime_str_ptr(source), str_len(source), pos)
}

--- Parse an entire `f64`, rejecting trailing bytes with a typed error.
pub fn parse_f64(source: str) -> Result<f64, NumParseError> {
  match parse_f64_prefix(source, 0) {
    Err(error) -> Err<f64, NumParseError>(error)
    Ok((value, next)) -> if next == str_len(source) {
      Ok<f64, NumParseError>(value)
    } else {
      Err<f64, NumParseError>(NumParseTrailing(next))
    }
  }
}

--- Parse an entire `f32`, rejecting trailing bytes with a typed error.
pub fn parse_f32(source: str) -> Result<f32, NumParseError> {
  match parse_f32_prefix(source, 0) {
    Err(error) -> Err<f32, NumParseError>(error)
    Ok((value, next)) -> if next == str_len(source) {
      Ok<f32, NumParseError>(value)
    } else {
      Err<f32, NumParseError>(NumParseTrailing(next))
    }
  }
}
