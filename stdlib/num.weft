}

pub fn num_u64_to_i64_checked(value: u64) -> NumIntCast<i64> {
  if value <= 9223372036854775807 { num_int_cast_ok<i64>(__u64_to_i64(value)) }
  else { num_int_cast_err<i64>(num_int_cast_err_out_of_range()) }
}

pub fn num_u64_to_isize_checked(value: u64) -> NumIntCast<isize> {
