-- stdlib/num.weft — numeric conversion helpers
--
-- Parsing is pure and returns explicit success/failure variants. Prefix
-- parsing reports the next byte offset so parsers can compose without sentinels.

use "stdlib/string.weft"

type NumParseI64 {
  NumParseI64Ok(i64, i64),
  NumParseI64Err(i64, i64)
}

type NumF64ToI64 {
  NumF64ToI64Ok(i64),
  NumF64ToI64Err(i64)
}

fn num_parse_err_empty() -> i64 { 1 }
fn num_parse_err_invalid() -> i64 { 2 }
fn num_parse_err_overflow() -> i64 { 3 }
fn num_parse_err_trailing() -> i64 { 4 }

fn num_f64_to_i64_err_nan() -> i64 { 1 }
fn num_f64_to_i64_err_not_exact() -> i64 { 2 }

fn num_parse_i64_ok(value: i64, next: i64) -> NumParseI64 {
  NumParseI64Ok(value, next)
}

fn num_parse_i64_err(code: i64, pos: i64) -> NumParseI64 {
  NumParseI64Err(code, pos)
}

fn num_f64_to_i64_ok(value: i64) -> NumF64ToI64 {
  NumF64ToI64Ok(value)
}

fn num_f64_to_i64_err(code: i64) -> NumF64ToI64 {
  NumF64ToI64Err(code)
}

fn num_parse_i64_is_ok(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 1
    NumParseI64Err(code, pos) -> 0
  }
}

fn num_f64_to_i64_is_ok(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 1
    NumF64ToI64Err(code) -> 0
  }
}

fn num_parse_i64_value_or(result: NumParseI64, default: i64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> value
    NumParseI64Err(code, pos) -> default
  }
}

fn num_f64_to_i64_value_or(result: NumF64ToI64, default: i64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> value
    NumF64ToI64Err(code) -> default
  }
}

fn num_parse_i64_next_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

fn num_parse_i64_error_code(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 0
    NumParseI64Err(code, pos) -> code
  }
}

fn num_f64_to_i64_error_code(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 0
    NumF64ToI64Err(code) -> code
  }
}

fn num_parse_i64_error_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

fn num_i64_to_str(value: i64) -> str { int_to_str(value) }

fn num_i8_to_f64(value: i8) -> f64 { __i8_to_f64(value) }

fn num_i16_to_f64(value: i16) -> f64 { __i16_to_f64(value) }

fn num_i32_to_f64(value: i32) -> f64 { __i32_to_f64(value) }

fn num_i64_to_f64(value: i64) -> f64 { __i64_to_f64(value) }

fn num_isize_to_f64(value: isize) -> f64 { __isize_to_f64(value) }

fn num_u8_to_f64(value: u8) -> f64 { __u8_to_f64(value) }

fn num_u16_to_f64(value: u16) -> f64 { __u16_to_f64(value) }

fn num_u32_to_f64(value: u32) -> f64 { __u32_to_f64(value) }

fn num_u64_to_f64(value: u64) -> f64 { __u64_to_f64(value) }

fn num_usize_to_f64(value: usize) -> f64 { __usize_to_f64(value) }

fn num_i8_to_f32_round(value: i8) -> f32 { __i8_to_f32(value) }

fn num_i16_to_f32_round(value: i16) -> f32 { __i16_to_f32(value) }

fn num_i32_to_f32_round(value: i32) -> f32 { __i32_to_f32(value) }

fn num_i64_to_f32_round(value: i64) -> f32 { __i64_to_f32(value) }

fn num_isize_to_f32_round(value: isize) -> f32 { __isize_to_f32(value) }

fn num_u8_to_f32_round(value: u8) -> f32 { __u8_to_f32(value) }

fn num_u16_to_f32_round(value: u16) -> f32 { __u16_to_f32(value) }

fn num_u32_to_f32_round(value: u32) -> f32 { __u32_to_f32(value) }

fn num_u64_to_f32_round(value: u64) -> f32 { __u64_to_f32(value) }

fn num_usize_to_f32_round(value: usize) -> f32 { __usize_to_f32(value) }

fn num_f32_to_f64(value: f32) -> f64 { __f32_to_f64(value) }

fn num_f64_to_f32_round(value: f64) -> f32 { __f64_to_f32(value) }

fn num_f64_to_i64_exact(value: f64) -> NumF64ToI64 {
  if value != value {
    num_f64_to_i64_err(num_f64_to_i64_err_nan())
  } else {
    let truncated = __f64_to_i64_trunc(value)
    if num_i64_to_f64(truncated) == value {
      num_f64_to_i64_ok(truncated)
    } else {
      num_f64_to_i64_err(num_f64_to_i64_err_not_exact())
    }
  }
}

impl i8 {
  fn to_f64(self: i8) -> f64 {
    num_i8_to_f64(self)
  }

  fn to_f32_round(self: i8) -> f32 {
    num_i8_to_f32_round(self)
  }
}

impl i16 {
  fn to_f64(self: i16) -> f64 {
    num_i16_to_f64(self)
  }

  fn to_f32_round(self: i16) -> f32 {
    num_i16_to_f32_round(self)
  }
}

impl i32 {
  fn to_f64(self: i32) -> f64 {
    num_i32_to_f64(self)
  }

  fn to_f32_round(self: i32) -> f32 {
    num_i32_to_f32_round(self)
  }
}

impl i64 {
  fn to_f64(self: i64) -> f64 {
    num_i64_to_f64(self)
  }

  fn to_f32_round(self: i64) -> f32 {
    num_i64_to_f32_round(self)
  }
}

impl isize {
  fn to_f64(self: isize) -> f64 {
    num_isize_to_f64(self)
  }

  fn to_f32_round(self: isize) -> f32 {
    num_isize_to_f32_round(self)
  }
}

impl u8 {
  fn to_f64(self: u8) -> f64 {
    num_u8_to_f64(self)
  }

  fn to_f32_round(self: u8) -> f32 {
    num_u8_to_f32_round(self)
  }
}

impl u16 {
  fn to_f64(self: u16) -> f64 {
    num_u16_to_f64(self)
  }

  fn to_f32_round(self: u16) -> f32 {
    num_u16_to_f32_round(self)
  }
}

impl u32 {
  fn to_f64(self: u32) -> f64 {
    num_u32_to_f64(self)
  }

  fn to_f32_round(self: u32) -> f32 {
    num_u32_to_f32_round(self)
  }
}

impl u64 {
  fn to_f64(self: u64) -> f64 {
    num_u64_to_f64(self)
  }

  fn to_f32_round(self: u64) -> f32 {
    num_u64_to_f32_round(self)
  }
}

impl usize {
  fn to_f64(self: usize) -> f64 {
    num_usize_to_f64(self)
  }

  fn to_f32_round(self: usize) -> f32 {
    num_usize_to_f32_round(self)
  }
}

impl f64 {
  fn to_i64_exact(self: f64) -> NumF64ToI64 {
    num_f64_to_i64_exact(self)
  }

  fn to_f32_round(self: f64) -> f32 {
    num_f64_to_f32_round(self)
  }
}

impl f32 {
  fn to_f64(self: f32) -> f64 {
    num_f32_to_f64(self)
  }
}

fn num_is_digit(ch: i64) -> i64 {
  if ch >= 48 and ch <= 57 { 1 } else { 0 }
}

fn num_i64_limit_string(neg: i64) -> str {
  if neg == 1 { "9223372036854775808" } else { "9223372036854775807" }
}

fn num_digits_exceed_i64_limit(src: i64, start: i64, end: i64, neg: i64) -> i64 {
  let mut significant = start
  while significant < end and __mem_load8(src + significant) == 48 {
    significant = significant + 1
  }
  let significant_len = end - significant
  if significant_len == 0 {
    0
  } else {
    let limit = num_i64_limit_string(neg)
    let limit_len = __str_len(limit)
    if significant_len > limit_len {
      1
    } else { if significant_len < limit_len {
      0
    } else {
      let limit_ptr = __str_ptr(limit)
      let mut result = 0
      let mut done = 0
      let mut i = 0
      while done == 0 and i < significant_len {
        let got = __mem_load8(src + significant + i)
        let allowed = __mem_load8(limit_ptr + i)
        if got > allowed {
          result = 1
          done = 1
        } else { if got < allowed {
          done = 1
        } else {
          i = i + 1
        } }
      }
      result
    } }
  }
}

fn num_parse_i64_prefix_bytes(src: i64, n: i64, pos: i64) -> NumParseI64 {
  if pos < 0 or pos >= n {
    num_parse_i64_err(num_parse_err_empty(), pos)
  } else {
    let first = __mem_load8(src + pos)
    let neg = if first == 45 { 1 } else { 0 }
    let digit_start = if first == 45 or first == 43 { pos + 1 } else { pos }
    if digit_start >= n {
      num_parse_i64_err(num_parse_err_invalid(), digit_start)
    } else { if num_is_digit(__mem_load8(src + digit_start)) == 0 {
      num_parse_i64_err(num_parse_err_invalid(), digit_start)
    } else {
      let mut p = digit_start
      while p < n and num_is_digit(__mem_load8(src + p)) == 1 {
        p = p + 1
      }
      if num_digits_exceed_i64_limit(src, digit_start, p, neg) == 1 {
        num_parse_i64_err(num_parse_err_overflow(), p)
      } else {
        let mut value = 0
        let mut i = digit_start
        while i < p {
          value = value * 10 - (__mem_load8(src + i) - 48)
          i = i + 1
        }
        if neg == 1 {
          num_parse_i64_ok(value, p)
        } else {
          num_parse_i64_ok(0 - value, p)
        }
      }
    } }
  }
}

fn num_parse_i64_prefix(s: str, pos: i64) -> NumParseI64 {
  num_parse_i64_prefix_bytes(__str_ptr(s), __str_len(s), pos)
}

fn num_parse_i64(s: str) -> NumParseI64 {
  let parsed = num_parse_i64_prefix(s, 0)
  if num_parse_i64_is_ok(parsed) == 0 {
    parsed
  } else {
    let end = num_parse_i64_next_pos(parsed)
    if end == __str_len(s) {
      parsed
    } else {
      num_parse_i64_err(num_parse_err_trailing(), end)
    }
  }
}
