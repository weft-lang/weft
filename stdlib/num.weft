-- stdlib/num.weft — numeric conversion helpers
--
-- Parsing is pure and returns explicit success/failure variants. Prefix
-- parsing reports the next byte offset so parsers can compose without sentinels.

use "stdlib/string.weft"

type NumParseI64 {
  NumParseI64Ok(i64, i64),
  NumParseI64Err(i64, i64)
}

type NumF64ToI64 {
  NumF64ToI64Ok(i64),
  NumF64ToI64Err(i64)
}

type NumIntCast<T> {
  NumIntCastOk(T),
  NumIntCastErr(i64)
}

trait Num {
}

trait NumInteger {
  fn bit_width(self: i64) -> i64
  fn is_signed(self: i64) -> i64
}

trait NumSignedInteger {
  fn min_i64(self: i64) -> i64
  fn max_i64(self: i64) -> i64
}

trait NumUnsignedInteger {
  fn max_u64(self: i64) -> u64
}

trait NumFloat {
  fn float_width(self: i64) -> i64
  fn mantissa_bits(self: i64) -> i64
  fn exponent_bits(self: i64) -> i64
}

fn num_parse_err_empty() -> i64 { 1 }
fn num_parse_err_invalid() -> i64 { 2 }
fn num_parse_err_overflow() -> i64 { 3 }
fn num_parse_err_trailing() -> i64 { 4 }

fn num_f64_to_i64_err_nan() -> i64 { 1 }
fn num_f64_to_i64_err_not_exact() -> i64 { 2 }

fn num_int_cast_err_out_of_range() -> i64 { 1 }

fn num_parse_i64_ok(value: i64, next: i64) -> NumParseI64 {
  NumParseI64Ok(value, next)
}

fn num_parse_i64_err(code: i64, pos: i64) -> NumParseI64 {
  NumParseI64Err(code, pos)
}

fn num_f64_to_i64_ok(value: i64) -> NumF64ToI64 {
  NumF64ToI64Ok(value)
}

fn num_f64_to_i64_err(code: i64) -> NumF64ToI64 {
  NumF64ToI64Err(code)
}

fn num_int_cast_ok<T>(value: T) -> NumIntCast<T> {
  NumIntCastOk<T>(value)
}

fn num_int_cast_err<T>(code: i64) -> NumIntCast<T> {
  NumIntCastErr<T>(code)
}

fn num_parse_i64_is_ok(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 1
    NumParseI64Err(code, pos) -> 0
  }
}

fn num_f64_to_i64_is_ok(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 1
    NumF64ToI64Err(code) -> 0
  }
}

fn num_int_cast_is_ok<T>(result: NumIntCast<T>) -> i64 {
  match result {
    NumIntCastOk(value) -> 1
    NumIntCastErr(code) -> 0
  }
}

fn num_parse_i64_value_or(result: NumParseI64, default: i64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> value
    NumParseI64Err(code, pos) -> default
  }
}

fn num_f64_to_i64_value_or(result: NumF64ToI64, default: i64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> value
    NumF64ToI64Err(code) -> default
  }
}

fn num_int_cast_value_or<T>(result: NumIntCast<T>, default: T) -> T {
  match result {
    NumIntCastOk(value) -> value
    NumIntCastErr(code) -> default
  }
}

fn num_parse_i64_next_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

fn num_parse_i64_error_code(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> 0
    NumParseI64Err(code, pos) -> code
  }
}

fn num_f64_to_i64_error_code(result: NumF64ToI64) -> i64 {
  match result {
    NumF64ToI64Ok(value) -> 0
    NumF64ToI64Err(code) -> code
  }
}

fn num_int_cast_error_code<T>(result: NumIntCast<T>) -> i64 {
  match result {
    NumIntCastOk(value) -> 0
    NumIntCastErr(code) -> code
  }
}

fn num_parse_i64_error_pos(result: NumParseI64) -> i64 {
  match result {
    NumParseI64Ok(value, next) -> next
    NumParseI64Err(code, pos) -> pos
  }
}

fn num_i64_to_str(value: i64) -> str { int_to_str(value) }

fn num_accepts_numeric<T: Num>(value: T) -> i64 { 1 }

fn num_bit_width<T: NumInteger>(value: T) -> i64 {
  value.bit_width()
}

fn num_is_signed<T: NumInteger>(value: T) -> i64 {
  value.is_signed()
}

fn num_signed_min_i64<T: NumSignedInteger>(value: T) -> i64 {
  value.min_i64()
}

fn num_signed_max_i64<T: NumSignedInteger>(value: T) -> i64 {
  value.max_i64()
}

fn num_unsigned_max_u64<T: NumUnsignedInteger>(value: T) -> u64 {
  value.max_u64()
}

fn num_float_width<T: NumFloat>(value: T) -> i64 {
  value.float_width()
}

fn num_float_mantissa_bits<T: NumFloat>(value: T) -> i64 {
  value.mantissa_bits()
}

fn num_float_exponent_bits<T: NumFloat>(value: T) -> i64 {
  value.exponent_bits()
}

fn num_i8_to_i64(value: i8) -> i64 { __i8_to_i64(value) }

fn num_i16_to_i64(value: i16) -> i64 { __i16_to_i64(value) }

fn num_i32_to_i64(value: i32) -> i64 { __i32_to_i64(value) }

fn num_isize_to_i64(value: isize) -> i64 { __isize_to_i64(value) }

fn num_u8_to_u64(value: u8) -> u64 { __u8_to_u64(value) }

fn num_u16_to_u64(value: u16) -> u64 { __u16_to_u64(value) }

fn num_u32_to_u64(value: u32) -> u64 { __u32_to_u64(value) }

fn num_usize_to_u64(value: usize) -> u64 { __usize_to_u64(value) }

fn num_i8_to_f64(value: i8) -> f64 { __i8_to_f64(value) }

fn num_i16_to_f64(value: i16) -> f64 { __i16_to_f64(value) }

fn num_i32_to_f64(value: i32) -> f64 { __i32_to_f64(value) }

fn num_i64_to_f64(value: i64) -> f64 { __i64_to_f64(value) }

fn num_isize_to_f64(value: isize) -> f64 { __isize_to_f64(value) }

fn num_u8_to_f64(value: u8) -> f64 { __u8_to_f64(value) }

fn num_u16_to_f64(value: u16) -> f64 { __u16_to_f64(value) }

fn num_u32_to_f64(value: u32) -> f64 { __u32_to_f64(value) }

fn num_u64_to_f64(value: u64) -> f64 { __u64_to_f64(value) }

fn num_usize_to_f64(value: usize) -> f64 { __usize_to_f64(value) }

fn num_i8_to_f32_round(value: i8) -> f32 { __i8_to_f32(value) }

fn num_i16_to_f32_round(value: i16) -> f32 { __i16_to_f32(value) }

fn num_i32_to_f32_round(value: i32) -> f32 { __i32_to_f32(value) }

fn num_i64_to_f32_round(value: i64) -> f32 { __i64_to_f32(value) }

fn num_isize_to_f32_round(value: isize) -> f32 { __isize_to_f32(value) }

fn num_u8_to_f32_round(value: u8) -> f32 { __u8_to_f32(value) }

fn num_u16_to_f32_round(value: u16) -> f32 { __u16_to_f32(value) }

fn num_u32_to_f32_round(value: u32) -> f32 { __u32_to_f32(value) }

fn num_u64_to_f32_round(value: u64) -> f32 { __u64_to_f32(value) }

fn num_usize_to_f32_round(value: usize) -> f32 { __usize_to_f32(value) }

fn num_f32_to_f64(value: f32) -> f64 { __f32_to_f64(value) }

fn num_f64_to_f32_round(value: f64) -> f32 { __f64_to_f32(value) }

fn num_i64_to_i8_checked(value: i64) -> NumIntCast<i8> {
  if value >= -128 and value <= 127 { num_int_cast_ok<i8>(__i64_to_i8(value)) }
  else { num_int_cast_err<i8>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_i16_checked(value: i64) -> NumIntCast<i16> {
  if value >= -32768 and value <= 32767 { num_int_cast_ok<i16>(__i64_to_i16(value)) }
  else { num_int_cast_err<i16>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_i32_checked(value: i64) -> NumIntCast<i32> {
  if value >= -2147483648 and value <= 2147483647 { num_int_cast_ok<i32>(__i64_to_i32(value)) }
  else { num_int_cast_err<i32>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_isize_checked(value: i64) -> NumIntCast<isize> {
  num_int_cast_ok<isize>(__i64_to_isize(value))
}

fn num_i64_to_u8_checked(value: i64) -> NumIntCast<u8> {
  if value >= 0 and value <= 255 { num_int_cast_ok<u8>(__i64_to_u8(value)) }
  else { num_int_cast_err<u8>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_u16_checked(value: i64) -> NumIntCast<u16> {
  if value >= 0 and value <= 65535 { num_int_cast_ok<u16>(__i64_to_u16(value)) }
  else { num_int_cast_err<u16>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_u32_checked(value: i64) -> NumIntCast<u32> {
  if value >= 0 and value <= 4294967295 { num_int_cast_ok<u32>(__i64_to_u32(value)) }
  else { num_int_cast_err<u32>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_u64_checked(value: i64) -> NumIntCast<u64> {
  if value >= 0 { num_int_cast_ok<u64>(__i64_to_u64(value)) }
  else { num_int_cast_err<u64>(num_int_cast_err_out_of_range()) }
}

fn num_i64_to_usize_checked(value: i64) -> NumIntCast<usize> {
  if value >= 0 { num_int_cast_ok<usize>(__i64_to_usize(value)) }
  else { num_int_cast_err<usize>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_i8_checked(value: u64) -> NumIntCast<i8> {
  if value <= 127 { num_int_cast_ok<i8>(__u64_to_i8(value)) }
  else { num_int_cast_err<i8>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_i16_checked(value: u64) -> NumIntCast<i16> {
  if value <= 32767 { num_int_cast_ok<i16>(__u64_to_i16(value)) }
  else { num_int_cast_err<i16>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_i32_checked(value: u64) -> NumIntCast<i32> {
  if value <= 2147483647 { num_int_cast_ok<i32>(__u64_to_i32(value)) }
  else { num_int_cast_err<i32>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_i64_checked(value: u64) -> NumIntCast<i64> {
  if value <= 9223372036854775807 { num_int_cast_ok<i64>(__u64_to_i64(value)) }
  else { num_int_cast_err<i64>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_isize_checked(value: u64) -> NumIntCast<isize> {
  if value <= 9223372036854775807 { num_int_cast_ok<isize>(__u64_to_isize(value)) }
  else { num_int_cast_err<isize>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_u8_checked(value: u64) -> NumIntCast<u8> {
  if value <= 255 { num_int_cast_ok<u8>(__u64_to_u8(value)) }
  else { num_int_cast_err<u8>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_u16_checked(value: u64) -> NumIntCast<u16> {
  if value <= 65535 { num_int_cast_ok<u16>(__u64_to_u16(value)) }
  else { num_int_cast_err<u16>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_u32_checked(value: u64) -> NumIntCast<u32> {
  if value <= 4294967295 { num_int_cast_ok<u32>(__u64_to_u32(value)) }
  else { num_int_cast_err<u32>(num_int_cast_err_out_of_range()) }
}

fn num_u64_to_usize_checked(value: u64) -> NumIntCast<usize> {
  num_int_cast_ok<usize>(__u64_to_usize(value))
}

fn num_f64_to_i64_exact(value: f64) -> NumF64ToI64 {
  if value != value {
    num_f64_to_i64_err(num_f64_to_i64_err_nan())
  } else {
    let truncated = __f64_to_i64_trunc(value)
    if num_i64_to_f64(truncated) == value {
      num_f64_to_i64_ok(truncated)
    } else {
      num_f64_to_i64_err(num_f64_to_i64_err_not_exact())
    }
  }
}

