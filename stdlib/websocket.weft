-- stdlib/websocket.weft — pure bounded RFC 6455 frame semantics
--
-- Header parsing and payload delivery are separate prefix state machines. A
-- caller can therefore stream a large frame through bounded HTTP/TLS reads
-- without retaining its whole payload. Client masking is capability-scoped:
-- only SecureRandom can produce an outbound client frame's fresh key.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, InvalidUtf8, bytes_concat, bytes_push}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpHeader, HttpHeaders, HttpNoBody, HttpProtocolSwitch, HttpRequestHead, HttpResponseHead}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random as secure_random
use stdlib/secure_random.{SecureRandom, SecureRandomError}
use stdlib/string.{str_concat}
use stdlib/vector as vector

--- The local endpoint role, which fixes inbound and outbound masking policy.
pub type WebSocketRole {
  --- A client receives unmasked frames and sends freshly masked frames.
  WebSocketClient,
    --- A server receives masked frames and sends unmasked frames.
    WebSocketServer
}

--- One opcode admitted by the RFC 6455 alpha frame floor.
pub type WebSocketOpcode {
  --- A continuation fragment for the current text or binary message.
  WebSocketContinuation,
    --- The first or only fragment of a UTF-8 text message.
    WebSocketText,
    --- The first or only fragment of a binary message.
    WebSocketBinary,
    --- The close-handshake control frame.
    WebSocketClose,
    --- A ping control frame requiring a matching pong payload.
    WebSocketPing,
    --- A pong control frame.
    WebSocketPong
}

--- Bounded frame and reassembled-message byte limits.
pub type WebSocketLimits = opaque WebSocketLimitsParts

--- A precise WebSocket framing, control, or entropy failure.
pub type WebSocketError {
  --- A frame limit was not positive.
  WebSocketInvalidFrameLimit(usize),
    --- A message limit was not positive or was smaller than the frame limit.
    WebSocketInvalidMessageLimit(usize),
    --- An RSV bit was set without a negotiated extension.
    WebSocketReservedBits(i64),
    --- An unassigned opcode was received.
    WebSocketReservedOpcode(i64),
    --- A server received an unmasked client frame.
    WebSocketMaskRequired,
    --- A client received a masked server frame.
    WebSocketMaskForbidden,
    --- An extended payload length used a shorter noncanonical encoding.
    WebSocketNoncanonicalLength(usize),
    --- A 64-bit payload length set its forbidden high bit.
    WebSocketInvalidLength(usize),
    --- A frame exceeded the configured byte limit.
    WebSocketFrameTooLarge(usize),
    --- A control frame cleared FIN.
    WebSocketFragmentedControl,
    --- A control payload exceeded 125 bytes.
    WebSocketControlTooLarge(usize),
    --- Control decoding was requested for a data opcode.
    WebSocketExpectedControl,
    --- A close payload contained exactly one byte.
    WebSocketInvalidClosePayload,
    --- A close payload used a code forbidden on the wire.
    WebSocketInvalidCloseCode(i64),
    --- A close reason was not canonical UTF-8.
    WebSocketInvalidCloseReason(usize),
    --- A close reason left too little room for its two-byte status.
    WebSocketCloseReasonTooLong(usize),
    --- A continuation arrived without an unfinished data message.
    WebSocketContinuationWithoutMessage,
    --- A new data message arrived before the prior fragmented message ended.
    WebSocketInterleavedMessage,
    --- Reassembled data exceeded the configured message limit.
    WebSocketMessageTooLarge(usize),
    --- A payload chunk did not agree with its validated frame length.
    WebSocketPayloadLengthMismatch(usize, usize),
    --- A text message contained malformed or truncated UTF-8 at this offset.
    WebSocketInvalidText(usize),
    --- Data arrived after the peer's close frame.
    WebSocketDataAfterClose,
    --- Fresh client masking-key generation failed.
    WebSocketRandom(SecureRandomError)
}

--- One validated frame header without its streamed payload bytes.
pub type WebSocketFrameHeader = opaque WebSocketFrameHeaderParts

--- Prefix parsing of one WebSocket frame header.
pub type WebSocketFrameParse {
  --- The current prefix is valid but lacks a complete header.
  WebSocketFrameNeedMore,
    --- One complete header and its exact consumed byte count.
    WebSocketFrameReady(WebSocketFrameHeader, usize),
    --- The prefix cannot begin a valid frame for this local role.
    WebSocketFrameFailed(WebSocketError)
}

--- A streaming payload decoder derived from one validated header.
pub type WebSocketPayloadDecoder = opaque WebSocketPayloadParts

--- One bounded payload transition with masking removed when required.
pub type WebSocketPayloadRead {
  --- A non-empty payload chunk and successor decoder.
  WebSocketPayloadChunk(WebSocketPayloadDecoder, Bytes, usize),
    --- The final, possibly empty payload chunk.
    WebSocketPayloadEnd(Bytes, usize),
    --- A non-empty frame needs another transport fragment.
    WebSocketPayloadNeedInput(WebSocketPayloadDecoder)
}

--- A decoded control frame with its semantic close alternative.
pub type WebSocketControl {
  --- Begin or acknowledge the closing handshake.
  WebSocketControlClose(WebSocketCloseValue),
    --- A ping payload that must be reproduced in its pong.
    WebSocketControlPing(Bytes),
    --- One received pong payload.
    WebSocketControlPong(Bytes)
}

--- The close status and reason carried on the wire.
pub type WebSocketCloseValue {
  --- No status code was supplied.
  WebSocketCloseWithoutStatus,
    --- A validated status code and UTF-8 diagnostic reason.
    WebSocketCloseWithStatus(i64, str)
}

--- A precise HTTP upgrade negotiation failure.
pub type WebSocketHandshakeError {
  --- A client handshake could not obtain its 16-byte nonce.
  WebSocketHandshakeRandom(SecureRandomError),
    --- The request method was not GET.
    WebSocketHandshakeMethod,
    --- The HTTP wire version was not 1.1.
    WebSocketHandshakeHttpVersion,
    --- The request or response did not switch protocols.
    WebSocketHandshakeStatus,
    --- Upgrade was absent, duplicated, or did not select WebSocket.
    WebSocketHandshakeUpgrade,
    --- Connection did not contain the Upgrade token.
    WebSocketHandshakeConnection,
    --- Sec-WebSocket-Key was absent, duplicated, or not canonical 16-byte base64.
    WebSocketHandshakeKey,
    --- Sec-WebSocket-Version was absent, duplicated, or not 13.
    WebSocketHandshakeVersion,
    --- Sec-WebSocket-Accept was absent, duplicated, or did not match the nonce.
    WebSocketHandshakeAccept,
    --- The server selected an extension the client did not offer or install.
    WebSocketHandshakeExtensions,
    --- The server selected a subprotocol the client did not offer.
    WebSocketHandshakeProtocol,
    --- An upgrade request carried HTTP body framing.
    WebSocketHandshakeBody
}

--- Client nonce and expected server proof for one upgrade attempt.
pub type WebSocketClientUpgrade = opaque WebSocketClientUpgradeParts

--- Pure sent/received state for the bidirectional close handshake.
pub type WebSocketCloseHandshake = opaque WebSocketClosePhase

--- One close-handshake action derived from a send or receive transition.
pub type WebSocketCloseTransition {
  --- A local close was sent first; await the peer's close.
  WebSocketCloseAwaitPeer(WebSocketCloseHandshake),
    --- A peer close arrived first and must be echoed with the same payload.
    WebSocketCloseEcho(WebSocketCloseHandshake, WebSocketCloseValue),
    --- Both directions have now carried a close frame.
    WebSocketCloseComplete(WebSocketCloseHandshake),
    --- This direction had already closed; no second wire frame is needed.
    WebSocketCloseDuplicate(WebSocketCloseHandshake)
}

--- The semantic kind of a data message payload.
pub type WebSocketMessageKind {
  --- UTF-8 text, validated across every fragment boundary.
  WebSocketTextMessage,
    --- Uninterpreted binary bytes.
    WebSocketBinaryMessage
}

--- Whether one frame carries data or an interleaved control payload.
pub type WebSocketMessageContent {
  --- A text-message payload segment.
  WebSocketTextContent,
    --- A binary-message payload segment.
    WebSocketBinaryContent,
    --- A close, ping, or pong payload outside message reassembly.
    WebSocketControlContent
}

--- Which side of the close handshake governs a data-frame transition.
pub type WebSocketMessageFlow {
  --- Receiving data is forbidden after the peer has sent close.
  WebSocketReceiveMessages,
    --- Sending data is forbidden after the local endpoint has sent close.
    WebSocketSendMessages
}

--- Immutable sequencing and UTF-8 state between complete frames.
pub type WebSocketMessageState = opaque WebSocketMessageProgress

--- One validated frame while its already-unmasked payload is consumed.
pub type WebSocketMessageFrame = opaque WebSocketMessageFrameParts

--- A direct payload-boundary input from the streaming frame decoder.
pub type WebSocketMessageInput {
  --- A nonterminal, non-empty payload chunk.
  WebSocketMessageChunk(Bytes),
    --- The final, possibly empty payload chunk.
    WebSocketMessageEnd(Bytes)
}

--- One message-validation transition.
pub type WebSocketMessageRead {
  --- More payload remains in this frame.
  WebSocketMessageMore(WebSocketMessageFrame),
    --- The frame ended and produced the successor sequencing state.
    WebSocketMessageDone(WebSocketMessageState),
    --- The payload or message sequence is invalid.
    WebSocketMessageFailed(WebSocketError)
}

type WebSocketLimitsParts {
  frame_bytes: usize,
    message_bytes: usize
}

type WebSocketClientUpgradeParts {
  key: str,
    accept: str
}

type WebSocketHeaderScan {
  WebSocketHeaderAbsent,
    WebSocketHeaderSingle(Bytes),
    WebSocketHeaderRepeated
}

type WebSocketMask = opaque Bytes

type WebSocketMasking {
  WebSocketUnmasked,
    WebSocketMasked(WebSocketMask)
}

type WebSocketFrameHeaderParts {
  final: bool,
    opcode: WebSocketOpcode,
    payload_bytes: usize,
    masking: WebSocketMasking
}

type WebSocketPayloadParts {
  masking: WebSocketMasking,
    position: usize,
    remaining: usize
}

type WebSocketMessageBoundary { WebSocketMessageContinues, WebSocketMessageEnds }

type WebSocketUtf8Range {
  WebSocketUtf8Ordinary,
    WebSocketUtf8ThreeByteMinimum,
    WebSocketUtf8BelowSurrogates,
    WebSocketUtf8FourByteMinimum,
    WebSocketUtf8ScalarMaximum
}

type WebSocketUtf8Progress {
  WebSocketUtf8Boundary(usize),
    WebSocketUtf8Continuation(usize, usize, usize, WebSocketUtf8Range)
}

type WebSocketMessageProgress {
  WebSocketMessageIdle,
    WebSocketTextInProgress(usize, WebSocketUtf8Progress),
    WebSocketBinaryInProgress(usize)
}

type WebSocketFrameValidation {
  WebSocketControlValidation(WebSocketMessageProgress),
    WebSocketBinaryValidation(WebSocketMessageBoundary, usize),
    WebSocketTextValidation(WebSocketMessageBoundary, usize, WebSocketUtf8Progress)
}

type WebSocketMessageFrameParts {
  validation: WebSocketFrameValidation,
    remaining: usize
}

type WebSocketClosePhase {
  WebSocketCloseOpen,
    WebSocketCloseSent,
    WebSocketCloseReceived,
    WebSocketCloseExchanged
}

fn websocket_u8_to_i64(value: u8) -> i64 {
  value.to_u64().to_i64_checked().unwrap()
}

fn websocket_i64_to_u8(value: i64) -> u8 {
  value.to_u8_checked().unwrap()
}

fn websocket_count_byte(value: usize) -> u8 {
  value.to_u64().to_u8_checked().unwrap()
}

fn websocket_byte_count(value: i64) -> usize {
  value.to_usize_checked().unwrap()
}

fn websocket_bytes_len(values: Bytes) -> usize { values.len() }

fn websocket_bytes_slice(values: Bytes, start: usize, end: usize) -> Bytes {
  values.slice(start, end).unwrap()
}

fn websocket_byte(values: Bytes, index: usize) -> i64 {
  websocket_u8_to_i64(values.get(index).unwrap())
}

fn websocket_u32(value: i64) -> i64 { value band 4294967295 }

fn websocket_rotl32(value: i64, bits: i64) -> i64 {
  websocket_u32((websocket_u32(value) bshl bits) bor (websocket_u32(value) bshr (32 - bits)))
}

fn websocket_sha1(values: Bytes) -> Bytes {
  let original_bytes = websocket_bytes_len(values)
  let mut padded = bytes_push(values, websocket_i64_to_u8(128))
  while (websocket_bytes_len(padded) - websocket_bytes_len(padded) / 64 * 64) != 56 {
    padded = bytes_push(padded, websocket_i64_to_u8(0))
  }
  let bit_length = original_bytes * 8
  let shifts: [usize; 8] = [56, 48, 40, 32, 24, 16, 8, 0]
  for shift in shifts {
    padded = bytes_push(padded, websocket_count_byte((bit_length bshr shift) band 255))
  }
  let mut words = vector.new<i64>()
  let origin: usize = 0
  for index in origin..80 { words.push(0) }
  let mut h0 = 1732584193
  let mut h1 = 4023233417
  let mut h2 = 2562383102
  let mut h3 = 271733878
  let mut h4 = 3285377520
  let mut block: usize = 0
  while block < websocket_bytes_len(padded) {
    let origin: usize = 0
    for index in origin..16 {
      let start = block + index * 4
      words.set(index,
        websocket_byte(padded, start) * 16777216 +
        websocket_byte(padded, start + 1) * 65536 +
        websocket_byte(padded, start + 2) * 256 +
        websocket_byte(padded, start + 3)
      )
    }
    let expanded_start: usize = 16
    for index in expanded_start..80 {
      words.set(index, websocket_rotl32(
        words[..][index - 3] bxor
        words[..][index - 8] bxor
        words[..][index - 14] bxor
        words[..][index - 16],
        1
      ))
    }
    let mut a = h0
    let mut b = h1
    let mut c = h2
    let mut d = h3
    let mut e = h4
    let origin: usize = 0
    for index in origin..80 {
      let f = if index < 20 { (b band c) bor ((b bxor 4294967295) band d) }
      else { if index < 40 { b bxor c bxor d }
        else { if index < 60 { (b band c) bor (b band d) bor (c band d) }
          else { b bxor c bxor d } } }
      let k = if index < 20 { 1518500249 }
      else { if index < 40 { 1859775393 }
        else { if index < 60 { 2400959708 }
          else { 3395469782 } } }
      let next = websocket_u32(
        websocket_rotl32(a, 5) + websocket_u32(f) + e + k + words[..][index]
      )
      e = d
      d = c
      c = websocket_rotl32(b, 30)
      b = a
      a = next
    }
    h0 = websocket_u32(h0 + a)
    h1 = websocket_u32(h1 + b)
    h2 = websocket_u32(h2 + c)
    h3 = websocket_u32(h3 + d)
    h4 = websocket_u32(h4 + e)
    block = block + 64
  }
  let mut digest = bytes.empty()
  for word in [h0, h1, h2, h3, h4] {
    for shift in [24, 16, 8, 0] {
      digest = bytes_push(digest, websocket_i64_to_u8((word bshr shift) band 255))
    }
  }
  digest
}

fn websocket_base64_byte(value: i64) -> u8 {
  websocket_i64_to_u8(if value < 26 { 65 + value }
  else { if value < 52 { 97 + value - 26 }
    else { if value < 62 { 48 + value - 52 }
      else { if value == 62 { 43 } else { 47 } } } })
}

fn websocket_base64_encode(values: Bytes) -> str {
  let mut out = bytes.empty()
  let mut index: usize = 0
  while index < websocket_bytes_len(values) {
    let available = websocket_bytes_len(values) - index
    let first = websocket_byte(values, index)
    let second = if available > 1 { websocket_byte(values, index + 1) } else { 0 }
    let third = if available > 2 { websocket_byte(values, index + 2) } else { 0 }
    out = bytes_push(out, websocket_base64_byte(first bshr 2))
    out = bytes_push(out, websocket_base64_byte(((first band 3) bshl 4) bor (second bshr 4)))
    out = bytes_push(out, if available > 1 {
      websocket_base64_byte(((second band 15) bshl 2) bor (third bshr 6))
    } else { websocket_i64_to_u8(61) })
    out = bytes_push(out, if available > 2 {
      websocket_base64_byte(third band 63)
    } else { websocket_i64_to_u8(61) })
    index = index + 3
  }
  out.to_utf8().unwrap()
}

fn websocket_base64_value(byte: i64) -> Option<i64> {
  match byte {
    value if value >= 65 and value <= 90 -> Some<i64>(value - 65)
    value if value >= 97 and value <= 122 -> Some<i64>(value - 97 + 26)
    value if value >= 48 and value <= 57 -> Some<i64>(value - 48 + 52)
    43 -> Some<i64>(62)
    47 -> Some<i64>(63)
    _ -> None<i64>()
  }
}

fn websocket_base64_16_valid(value: Bytes) -> bool {
  if value.len() != 24 or websocket_byte(value, 22) != 61 or websocket_byte(value, 23) != 61 {
    return false
  }
  let origin: usize = 0
  for index in origin..22 {
    match websocket_base64_value(websocket_byte(value, index)) {
      None -> return false
      Some(decoded) -> if index == 21 and (decoded band 15) != 0 { return false }
    }
  }
  true
}

fn websocket_ascii_lower(byte: i64) -> i64 {
  if byte >= 65 and byte <= 90 { byte + 32 } else { byte }
}

fn websocket_range_ascii_equal(values: Bytes, start: usize, end: usize, expected: str) -> bool {
  let reference = bytes.from_str(expected)
  if end - start != websocket_bytes_len(reference) { false }
  else {
    let mut index: usize = 0
    let mut equal = true
    while equal and index < websocket_bytes_len(reference) {
      if websocket_ascii_lower(websocket_byte(values, start + index)) !=
        websocket_ascii_lower(websocket_byte(reference, index)) {
        equal = false
      } else { index = index + 1 }
    }
    equal
  }
}

fn websocket_value_single_token(values: Bytes, expected: str) -> bool {
  let mut start: usize = 0
  let mut end = websocket_bytes_len(values)
  while start < end and (websocket_byte(values, start) == 32 or websocket_byte(values, start) == 9) {
    start = start + 1
  }
  while end > start and (websocket_byte(values, end - 1) == 32 or websocket_byte(values, end - 1) == 9) {
    end = end - 1
  }
  websocket_range_ascii_equal(values, start, end, expected)
}

fn websocket_value_has_token(values: Bytes, expected: str) -> bool {
  let mut position: usize = 0
  let mut found = false
  while not found and position < websocket_bytes_len(values) {
    while position < websocket_bytes_len(values) and
      (websocket_byte(values, position) == 32 or websocket_byte(values, position) == 9 or
      websocket_byte(values, position) == 44) {
      position = position + 1
    }
    let start = position
    while position < websocket_bytes_len(values) and websocket_byte(values, position) != 44 {
      position = position + 1
    }
    let mut end = position
    while end > start and (websocket_byte(values, end - 1) == 32 or websocket_byte(values, end - 1) == 9) {
      end = end - 1
    }
    if websocket_range_ascii_equal(values, start, end, expected) { found = true }
  }
  found
}

fn websocket_header_scan(headers: HttpHeaders, name: str) -> WebSocketHeaderScan {
  let mut found = WebSocketHeaderAbsent
  for header in headers {
    if header.name().text() == name {
      found = match found {
        WebSocketHeaderAbsent -> WebSocketHeaderSingle(header.value())
        WebSocketHeaderSingle(_) -> return WebSocketHeaderRepeated
        WebSocketHeaderRepeated -> return WebSocketHeaderRepeated
      }
    } else { nil }
  }
  found
}

fn websocket_headers_have_token(headers: HttpHeaders, name: str, token: str) -> bool {
  for header in headers {
    if header.name().text() == name and websocket_value_has_token(header.value(), token) {
      return true
    } else { nil }
  }
  false
}

fn websocket_value_exact(values: Bytes, expected: str) -> bool {
  match values.to_utf8() {
    Ok(text) -> text == expected
    Err(error) -> false
  }
}

fn websocket_headers_append(headers: HttpHeaders, name: str, value: str) -> HttpHeaders {
  headers.append(http.header(http.parse_field_name(name).unwrap(), bytes.from_str(value)).unwrap())
}

fn websocket_accept(key: str) -> str {
  websocket_base64_encode(websocket_sha1(
    bytes.from_str(str_concat(key, "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
  ))
}

fn websocket_limits_parts(limits: WebSocketLimits) -> WebSocketLimitsParts {
  match limits { WebSocketLimits(parts) -> parts }
}

fn websocket_header_parts(header: WebSocketFrameHeader) -> WebSocketFrameHeaderParts {
  match header { WebSocketFrameHeader(parts) -> parts }
}

fn websocket_mask_bytes(mask: WebSocketMask) -> Bytes {
  match mask { WebSocketMask(bytes) -> bytes }
}

fn websocket_opcode_value(opcode: WebSocketOpcode) -> i64 {
  match opcode {
    WebSocketContinuation -> 0
    WebSocketText -> 1
    WebSocketBinary -> 2
    WebSocketClose -> 8
    WebSocketPing -> 9
    WebSocketPong -> 10
  }
}

fn websocket_opcode_parse(value: i64) -> Result<WebSocketOpcode, WebSocketError> {
  match value {
    0 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketContinuation)
    1 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketText)
    2 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketBinary)
    8 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketClose)
    9 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketPing)
    10 -> Ok<WebSocketOpcode, WebSocketError>(WebSocketPong)
    other -> Err<WebSocketOpcode, WebSocketError>(WebSocketReservedOpcode(other))
  }
}

fn websocket_opcode_is_control(opcode: WebSocketOpcode) -> bool {
  match opcode {
    WebSocketClose -> true
    WebSocketPing -> true
    WebSocketPong -> true
    _ -> false
  }
}

fn websocket_mask_policy(role: WebSocketRole, masked: bool) -> Result<nil, WebSocketError> {
  match role {
    WebSocketClient -> if masked {
      Err<nil, WebSocketError>(WebSocketMaskForbidden)
    } else { Ok<nil, WebSocketError>(nil) }
    WebSocketServer -> if masked {
      Ok<nil, WebSocketError>(nil)
    } else { Err<nil, WebSocketError>(WebSocketMaskRequired) }
  }
}

fn websocket_length16(source: Bytes, start: usize) -> usize {
  websocket_byte_count(websocket_byte(source, start)) * 256 + websocket_byte_count(websocket_byte(source, start + 1))
}

fn websocket_length64(source: Bytes, start: usize) -> usize {
  let mut value: usize = 0
  let origin: usize = 0
  for index in origin..8 {
    value = value * 256 + websocket_byte_count(websocket_byte(source, start + index))
  }
  value
}

fn websocket_mask_at(masking: WebSocketMasking, position: usize) -> i64 {
  match masking {
    WebSocketUnmasked -> 0
    WebSocketMasked(mask) -> websocket_byte(
      websocket_mask_bytes(mask),
      position - position / 4 * 4
    )
  }
}

fn websocket_unmask(masking: WebSocketMasking, position: usize, values: Bytes) -> Bytes {
  match masking {
    WebSocketUnmasked -> values
    WebSocketMasked(mask) -> {
      let mut out = bytes.empty()
      let origin: usize = 0
      for index in origin..websocket_bytes_len(values) {
        out = bytes_push(out, websocket_i64_to_u8(
          websocket_byte(values, index) bxor websocket_mask_at(WebSocketMasked(mask), position + index)
        ))
      }
      out
    }
  }
}

fn websocket_validate_frame(
  final: bool,
  opcode: WebSocketOpcode,
  payload_bytes: usize,
  limits: WebSocketLimits
) -> Result<nil, WebSocketError> {
  if payload_bytes > 9223372036854775807 {
    Err<nil, WebSocketError>(WebSocketInvalidLength(payload_bytes))
  } else { if payload_bytes > websocket_limits_parts(limits).frame_bytes {
      Err<nil, WebSocketError>(WebSocketFrameTooLarge(payload_bytes))
    } else { if websocket_opcode_is_control(opcode) and not final {
        Err<nil, WebSocketError>(WebSocketFragmentedControl)
      } else { if websocket_opcode_is_control(opcode) and payload_bytes > 125 {
          Err<nil, WebSocketError>(WebSocketControlTooLarge(payload_bytes))
        } else { Ok<nil, WebSocketError>(nil) } } } }
}

fn websocket_frame_header(
  final: bool,
  opcode: WebSocketOpcode,
  payload_bytes: usize,
  masking: WebSocketMasking
) -> WebSocketFrameHeader {
  WebSocketFrameHeader(WebSocketFrameHeaderParts {
    final: final,
      opcode: opcode,
      payload_bytes: payload_bytes,
      masking: masking
  })
}

--- Construct limits, requiring a positive frame bound within the message bound.
fn websocket_limits_build(
  frame_bytes: usize,
  message_bytes: usize
) -> Result<WebSocketLimits, WebSocketError> {
  if frame_bytes == 0 {
    Err<WebSocketLimits, WebSocketError>(WebSocketInvalidFrameLimit(frame_bytes))
  } else { if message_bytes < frame_bytes {
      Err<WebSocketLimits, WebSocketError>(WebSocketInvalidMessageLimit(message_bytes))
    } else { Ok<WebSocketLimits, WebSocketError>(WebSocketLimits(WebSocketLimitsParts {
        frame_bytes: frame_bytes,
          message_bytes: message_bytes
      })) } }
}

--- Return 16 MiB frame and 64 MiB reassembled-message defaults.
fn websocket_default_limits() -> WebSocketLimits {
  websocket_limits_build(16777216, 67108864).unwrap()
}

--- Begin one client upgrade with a fresh canonical 16-byte nonce.
fn websocket_client_upgrade() -[SecureRandom]> Result<WebSocketClientUpgrade, WebSocketHandshakeError> {
  match secure_random.bytes(16) {
    Err(error) -> Err<WebSocketClientUpgrade, WebSocketHandshakeError>(
      WebSocketHandshakeRandom(error)
    )
    Ok(nonce) -> {
      let key = websocket_base64_encode(nonce)
      Ok<WebSocketClientUpgrade, WebSocketHandshakeError>(
        WebSocketClientUpgrade(WebSocketClientUpgradeParts {
        key: key,
          accept: websocket_accept(key)
      })
      )
    }
  }
}

--- Derive the four protocol fields to append to a client GET request.
---
--- The caller remains responsible for the ordinary Host field and request
--- target. Extensions and subprotocols are deliberately absent at this floor.
fn websocket_client_upgrade_headers(upgrade: WebSocketClientUpgrade) -> HttpHeaders {
  match upgrade {
    WebSocketClientUpgrade(parts) -> http.headers()
      |> websocket_headers_append("upgrade", "websocket")
      |> websocket_headers_append("connection", "Upgrade")
      |> websocket_headers_append("sec-websocket-key", parts.key)
      |> websocket_headers_append("sec-websocket-version", "13")
  }
}

--- Validate a server's 101 response against the originating client nonce.
fn websocket_client_validate_upgrade(
  upgrade: WebSocketClientUpgrade,
  response: HttpResponseHead
) -> Result<nil, WebSocketHandshakeError> {
  let parts = match upgrade { WebSocketClientUpgrade(value) -> value }
  match response.version() {
    Http11 -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeHttpVersion)
  }
  if response.status().code() != 101 {
    return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeStatus)
  } else { nil }
  match response.body_framing() {
    HttpProtocolSwitch -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeStatus)
  }
  let headers = response.headers()
  match websocket_header_scan(headers, "upgrade") {
    WebSocketHeaderSingle(value) if websocket_value_single_token(value, "websocket") -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeUpgrade)
  }
  if not websocket_headers_have_token(headers, "connection", "upgrade") {
    return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeConnection)
  } else { nil }
  match websocket_header_scan(headers, "sec-websocket-accept") {
    WebSocketHeaderSingle(value) if websocket_value_exact(value, parts.accept) -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeAccept)
  }
  match websocket_header_scan(headers, "sec-websocket-extensions") {
    WebSocketHeaderAbsent -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeExtensions)
  }
  match websocket_header_scan(headers, "sec-websocket-protocol") {
    WebSocketHeaderAbsent -> nil
    _ -> return Err<nil, WebSocketHandshakeError>(WebSocketHandshakeProtocol)
  }
  Ok<nil, WebSocketHandshakeError>(nil)
}

--- Validate a server-side GET upgrade and derive its exact 101 fields.
---
--- The alpha floor installs neither extension nor subprotocol negotiation.
--- Offers are safely declined by omission; selection requires a future
--- explicit policy and grammar rather than being inferred from raw strings.
fn websocket_server_upgrade(
  request: HttpRequestHead
) -> Result<HttpHeaders, WebSocketHandshakeError> {
  match request.method() {
    HttpGet -> nil
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeMethod)
  }
  match request.version() {
    Http11 -> nil
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeHttpVersion)
  }
  match request.body_framing() {
    HttpNoBody -> nil
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeBody)
  }
  let headers = request.headers()
  match websocket_header_scan(headers, "upgrade") {
    WebSocketHeaderSingle(value) if websocket_value_single_token(value, "websocket") -> nil
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeUpgrade)
  }
  if not websocket_headers_have_token(headers, "connection", "upgrade") {
    return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeConnection)
  } else { nil }
  let key = match websocket_header_scan(headers, "sec-websocket-key") {
    WebSocketHeaderSingle(value) if websocket_base64_16_valid(value) -> value
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeKey)
  }
  match websocket_header_scan(headers, "sec-websocket-version") {
    WebSocketHeaderSingle(value) if websocket_value_exact(value, "13") -> nil
    _ -> return Err<HttpHeaders, WebSocketHandshakeError>(WebSocketHandshakeVersion)
  }
  let accept = websocket_accept(key.to_utf8().unwrap())
  Ok<HttpHeaders, WebSocketHandshakeError>(
    http.headers()
    |> websocket_headers_append("upgrade", "websocket")
    |> websocket_headers_append("connection", "Upgrade")
    |> websocket_headers_append("sec-websocket-accept", accept)
  )
}

--- Parse one complete frame header without buffering payload bytes.
fn websocket_parse_frame_header(
  source: Bytes,
  role: WebSocketRole,
  limits: WebSocketLimits
) -> WebSocketFrameParse {
  if websocket_bytes_len(source) < 2 { WebSocketFrameNeedMore }
  else {
    let first = websocket_byte(source, 0)
    let second = websocket_byte(source, 1)
    let reserved = first band 112
    let final = (first band 128) != 0
    let masked = (second band 128) != 0
    if reserved != 0 { WebSocketFrameFailed(WebSocketReservedBits(reserved)) }
    else { match websocket_opcode_parse(first band 15) {
        Err(error) -> WebSocketFrameFailed(error)
        Ok(opcode) -> match websocket_mask_policy(role, masked) {
          Err(error) -> WebSocketFrameFailed(error)
          Ok(done) -> {
            let marker = second band 127
            let extended: usize = if marker < 126 { 0 } else { if marker == 126 { 2 } else { 8 } }
            if websocket_bytes_len(source) < 2 + extended { WebSocketFrameNeedMore }
            else {
              if marker == 127 and websocket_byte(source, 2) >= 128 {
                WebSocketFrameFailed(WebSocketInvalidLength(websocket_length64(source, 2)))
              } else {
                let payload_bytes = if marker < 126 { websocket_byte_count(marker) }
                else { if marker == 126 { websocket_length16(source, 2) }
                  else { websocket_length64(source, 2) } }
                if marker == 126 and payload_bytes < 126 {
                  WebSocketFrameFailed(WebSocketNoncanonicalLength(payload_bytes))
                } else { if marker == 127 and payload_bytes <= 65535 {
                    WebSocketFrameFailed(WebSocketNoncanonicalLength(payload_bytes))
                  } else { match websocket_validate_frame(final, opcode, payload_bytes, limits) {
                      Err(error) -> WebSocketFrameFailed(error)
                      Ok(valid) -> {
                        let mask_start = 2 + extended
                        let mask_bytes: usize = if masked { 4 } else { 0 }
                        let header_bytes = mask_start + mask_bytes
                        if websocket_bytes_len(source) < header_bytes { WebSocketFrameNeedMore }
                        else {
                          let masking = if masked {
                            WebSocketMasked(WebSocketMask(websocket_bytes_slice(source, mask_start, mask_start + 4)))
                          } else { WebSocketUnmasked }
                          WebSocketFrameReady(
                            websocket_frame_header(final, opcode, payload_bytes, masking),
                            header_bytes
                          )
                        }
                      }
                    } } } }
            }
          }
        }
      }
    } }
}
}

--- Return whether this header is the final fragment.
fn websocket_frame_is_final(header: WebSocketFrameHeader) -> bool {
  websocket_header_parts(header).final
}

--- Return the header's direct typed opcode.
fn websocket_frame_opcode(header: WebSocketFrameHeader) -> WebSocketOpcode {
  websocket_header_parts(header).opcode
}

--- Return the exact payload byte count.
fn websocket_frame_payload_bytes(header: WebSocketFrameHeader) -> usize {
  websocket_header_parts(header).payload_bytes
}

--- Return whether masking will be removed during payload delivery.
fn websocket_frame_is_masked(header: WebSocketFrameHeader) -> bool {
  match websocket_header_parts(header).masking {
    WebSocketUnmasked -> false
    WebSocketMasked(mask) -> true
  }
}

--- Start streaming the payload described by a validated frame header.
fn websocket_payload_decoder(header: WebSocketFrameHeader) -> WebSocketPayloadDecoder {
  let parts = websocket_header_parts(header)
  WebSocketPayloadDecoder(WebSocketPayloadParts {
    masking: parts.masking,
      position: 0,
      remaining: parts.payload_bytes
  })
}

--- Return the exact payload bytes still required by a frame decoder.
fn websocket_payload_remaining(decoder: WebSocketPayloadDecoder) -> usize {
  match decoder { WebSocketPayloadDecoder(parts) -> parts.remaining }
}

--- Consume at most the remaining payload prefix and remove masking in place.
---
--- The caller retains any unconsumed transport suffix. Empty input needs more
--- only for a non-empty frame; an empty frame completes with an empty chunk.
fn websocket_payload_read(
  decoder: WebSocketPayloadDecoder,
  source: Bytes
) -> WebSocketPayloadRead {
  match decoder {
    WebSocketPayloadDecoder(parts) -> if parts.remaining == 0 {
      WebSocketPayloadEnd(bytes.empty(), 0)
    } else { if source.is_empty() {
        WebSocketPayloadNeedInput(decoder)
      } else {
        let source_bytes = websocket_bytes_len(source)
        let count = if source_bytes < parts.remaining { source_bytes } else { parts.remaining }
        let chunk = websocket_unmask(
          parts.masking,
          parts.position,
          websocket_bytes_slice(source, 0, count)
        )
        if count == parts.remaining {
          WebSocketPayloadEnd(chunk, count)
        } else {
          WebSocketPayloadChunk(
            WebSocketPayloadDecoder(WebSocketPayloadParts {
            masking: parts.masking,
              position: parts.position + count,
              remaining: parts.remaining - count
          }),
            chunk,
            count
          )
        }
      } }
  }
}

fn websocket_message_progress(state: WebSocketMessageState) -> WebSocketMessageProgress {
  match state { WebSocketMessageState(progress) -> progress }
}

fn websocket_message_frame_parts(frame: WebSocketMessageFrame) -> WebSocketMessageFrameParts {
  match frame { WebSocketMessageFrame(parts) -> parts }
}

fn websocket_message_add_bytes(current: usize, added: usize, limit: usize) -> Result<usize, WebSocketError> {
  if current > limit or added > limit - current {
    Err<usize, WebSocketError>(WebSocketMessageTooLarge(limit))
  } else { Ok<usize, WebSocketError>(current + added) }
}

fn websocket_message_frame(validation: WebSocketFrameValidation, remaining: usize) -> WebSocketMessageFrame {
  WebSocketMessageFrame(WebSocketMessageFrameParts { validation: validation, remaining: remaining })
}

--- Construct the idle inbound message state.
fn websocket_message_state() -> WebSocketMessageState { WebSocketMessageState(WebSocketMessageIdle) }

--- Return the unfinished message kind, if one exists between frames.
fn websocket_message_pending(state: WebSocketMessageState) -> Option<WebSocketMessageKind> {
  match websocket_message_progress(state) {
    WebSocketMessageIdle -> None<WebSocketMessageKind>()
    WebSocketTextInProgress(count, text) -> Some<WebSocketMessageKind>(WebSocketTextMessage)
    WebSocketBinaryInProgress(count) -> Some<WebSocketMessageKind>(WebSocketBinaryMessage)
  }
}

fn websocket_begin_text(boundary: WebSocketMessageBoundary, current: usize, added: usize, text: WebSocketUtf8Progress, limit: usize) -> Result<WebSocketMessageFrame, WebSocketError> {
  match websocket_message_add_bytes(current, added, limit) {
    Err(error) -> Err<WebSocketMessageFrame, WebSocketError>(error)
    Ok(total) -> Ok<WebSocketMessageFrame, WebSocketError>(websocket_message_frame(WebSocketTextValidation(boundary, total, text), added))
  }
}

fn websocket_begin_binary(boundary: WebSocketMessageBoundary, current: usize, added: usize, limit: usize) -> Result<WebSocketMessageFrame, WebSocketError> {
  match websocket_message_add_bytes(current, added, limit) {
    Err(error) -> Err<WebSocketMessageFrame, WebSocketError>(error)
    Ok(total) -> Ok<WebSocketMessageFrame, WebSocketError>(websocket_message_frame(WebSocketBinaryValidation(boundary, total), added))
  }
}

--- Validate one header against message fragmentation and size state.
--- Control frames preserve the unfinished message and its UTF-8 progress.
fn websocket_message_begin(
  state: WebSocketMessageState,
  handshake: WebSocketCloseHandshake,
  flow: WebSocketMessageFlow,
  header: WebSocketFrameHeader,
  limits: WebSocketLimits
) -> Result<WebSocketMessageFrame, WebSocketError> {
  let current = websocket_message_progress(state)
  let frame = websocket_header_parts(header)
  let boundary = if frame.final { WebSocketMessageEnds } else { WebSocketMessageContinues }
  let closed = match flow {
    WebSocketReceiveMessages -> websocket_close_was_received(handshake)
    WebSocketSendMessages -> websocket_close_was_sent(handshake)
  }
  match websocket_validate_frame(frame.final, frame.opcode, frame.payload_bytes, limits) {
    Err(error) -> return Err<WebSocketMessageFrame, WebSocketError>(error)
    Ok(valid) -> nil
  }
  let limit = websocket_limits_parts(limits).message_bytes
  match frame.opcode {
    WebSocketClose -> Ok<WebSocketMessageFrame, WebSocketError>(websocket_message_frame(WebSocketControlValidation(current), frame.payload_bytes))
    WebSocketPing -> Ok<WebSocketMessageFrame, WebSocketError>(websocket_message_frame(WebSocketControlValidation(current), frame.payload_bytes))
    WebSocketPong -> Ok<WebSocketMessageFrame, WebSocketError>(websocket_message_frame(WebSocketControlValidation(current), frame.payload_bytes))
    WebSocketContinuation -> if closed {
      Err<WebSocketMessageFrame, WebSocketError>(WebSocketDataAfterClose)
    } else { match current {
        WebSocketMessageIdle -> Err<WebSocketMessageFrame, WebSocketError>(WebSocketContinuationWithoutMessage)
        WebSocketTextInProgress(count, text) -> websocket_begin_text(boundary, count, frame.payload_bytes, text, limit)
        WebSocketBinaryInProgress(count) -> websocket_begin_binary(boundary, count, frame.payload_bytes, limit)
      } }
    WebSocketText -> if closed {
      Err<WebSocketMessageFrame, WebSocketError>(WebSocketDataAfterClose)
    } else { match current {
        WebSocketMessageIdle -> websocket_begin_text(boundary, 0, frame.payload_bytes, WebSocketUtf8Boundary(0), limit)
        _ -> Err<WebSocketMessageFrame, WebSocketError>(WebSocketInterleavedMessage)
      } }
    WebSocketBinary -> if closed {
      Err<WebSocketMessageFrame, WebSocketError>(WebSocketDataAfterClose)
    } else { match current {
        WebSocketMessageIdle -> websocket_begin_binary(boundary, 0, frame.payload_bytes, limit)
        _ -> Err<WebSocketMessageFrame, WebSocketError>(WebSocketInterleavedMessage)
      } }
  }
}

--- Return the semantic payload kind carried by this frame.
fn websocket_message_content(frame: WebSocketMessageFrame) -> WebSocketMessageContent {
  match websocket_message_frame_parts(frame).validation {
    WebSocketControlValidation(progress) -> WebSocketControlContent
    WebSocketBinaryValidation(boundary, count) -> WebSocketBinaryContent
    WebSocketTextValidation(boundary, count, text) -> WebSocketTextContent
  }
}

fn websocket_utf8_read(progress: WebSocketUtf8Progress, values: Bytes) -> Result<WebSocketUtf8Progress, WebSocketError> {
  let mut position: usize = 0
  let mut scalar_start: usize = 0
  let mut remaining: usize = 0
  let mut range = WebSocketUtf8Ordinary
  match progress {
    WebSocketUtf8Boundary(at) -> { position = at }
    WebSocketUtf8Continuation(at, start, left, bounds) -> {
      position = at
      scalar_start = start
      remaining = left
      range = bounds
    }
  }
  -- Keep octets in their wire domain; typed range and lead-byte provenance
  -- cross fragments, while these byte counters remain local to one scan.
  let origin: usize = 0
  for index in origin..values.len() {
    let byte = values.get(index).unwrap()
    if remaining > 0 {
      let valid = match range {
        WebSocketUtf8Ordinary -> byte >= 128 and byte <= 191
        WebSocketUtf8ThreeByteMinimum -> byte >= 160 and byte <= 191
        WebSocketUtf8BelowSurrogates -> byte >= 128 and byte <= 159
        WebSocketUtf8FourByteMinimum -> byte >= 144 and byte <= 191
        WebSocketUtf8ScalarMaximum -> byte >= 128 and byte <= 143
      }
      if not valid { return Err<WebSocketUtf8Progress, WebSocketError>(WebSocketInvalidText(position + index)) }
      remaining = remaining - 1
      range = WebSocketUtf8Ordinary
    } else { if byte > 127 {
        scalar_start = position + index
        match byte {
          value if value >= 194 and value <= 223 -> { remaining = 1 }
          224 -> { remaining = 2; range = WebSocketUtf8ThreeByteMinimum }
          value if (value >= 225 and value <= 236) or (value >= 238 and value <= 239) -> { remaining = 2 }
          237 -> { remaining = 2; range = WebSocketUtf8BelowSurrogates }
          240 -> { remaining = 3; range = WebSocketUtf8FourByteMinimum }
          value if value >= 241 and value <= 243 -> { remaining = 3 }
          244 -> { remaining = 3; range = WebSocketUtf8ScalarMaximum }
          _ -> return Err<WebSocketUtf8Progress, WebSocketError>(WebSocketInvalidText(position + index))
        }
      } }
  }
  if remaining == 0 {
    Ok<WebSocketUtf8Progress, WebSocketError>(WebSocketUtf8Boundary(position + values.len()))
  } else {
    Ok<WebSocketUtf8Progress, WebSocketError>(WebSocketUtf8Continuation(position + values.len(), scalar_start, remaining, range))
  }
}

fn websocket_validation_read(validation: WebSocketFrameValidation, values: Bytes) -> Result<WebSocketFrameValidation, WebSocketError> {
  match validation {
    WebSocketTextValidation(boundary, count, text) -> match websocket_utf8_read(text, values) {
      Err(error) -> Err<WebSocketFrameValidation, WebSocketError>(error)
      Ok(next) -> Ok<WebSocketFrameValidation, WebSocketError>(WebSocketTextValidation(boundary, count, next))
    }
    other -> Ok<WebSocketFrameValidation, WebSocketError>(other)
  }
}

fn websocket_validation_finish(validation: WebSocketFrameValidation) -> WebSocketMessageRead {
  match validation {
    WebSocketControlValidation(progress) -> WebSocketMessageDone(WebSocketMessageState(progress))
    WebSocketBinaryValidation(boundary, count) -> match boundary {
      WebSocketMessageContinues -> WebSocketMessageDone(WebSocketMessageState(WebSocketBinaryInProgress(count)))
      WebSocketMessageEnds -> WebSocketMessageDone(WebSocketMessageState(WebSocketMessageIdle))
    }
    WebSocketTextValidation(boundary, count, text) -> match boundary {
      WebSocketMessageContinues -> WebSocketMessageDone(WebSocketMessageState(WebSocketTextInProgress(count, text)))
      WebSocketMessageEnds -> match text {
        WebSocketUtf8Boundary(position) -> WebSocketMessageDone(WebSocketMessageState(WebSocketMessageIdle))
        WebSocketUtf8Continuation(position, scalar_start, remaining, range) -> WebSocketMessageFailed(WebSocketInvalidText(scalar_start))
      }
    }
  }
}

fn websocket_message_failure(actual: usize, expected: usize) -> WebSocketMessageRead {
  WebSocketMessageFailed(WebSocketPayloadLengthMismatch(actual, expected))
}

--- Validate one already-unmasked payload transition without retaining it.
--- Chunk is nonempty and shorter than the remaining payload; End is exact.
--- UTF-8 continuation and lead-byte provenance survive transport/frame splits.
fn websocket_message_read(decoder: WebSocketMessageFrame, input: WebSocketMessageInput) -> WebSocketMessageRead {
  let frame = websocket_message_frame_parts(decoder)
  match input {
    WebSocketMessageChunk(values) -> {
      let count = values.len()
      if count == 0 or count >= frame.remaining { return websocket_message_failure(count, frame.remaining) }
      match websocket_validation_read(frame.validation, values) {
        Err(error) -> WebSocketMessageFailed(error)
        Ok(next) -> WebSocketMessageMore(websocket_message_frame(next, frame.remaining - count))
      }
    }
    WebSocketMessageEnd(values) -> {
      let count = values.len()
      if count != frame.remaining { return websocket_message_failure(count, frame.remaining) }
      match websocket_validation_read(frame.validation, values) {
        Err(error) -> WebSocketMessageFailed(error)
        Ok(next) -> websocket_validation_finish(next)
      }
    }
  }
}

--- Validate one complete outbound frame against message sequencing and UTF-8.
---
--- This is the send-side counterpart to `websocket_message_begin` plus
--- `websocket_message_read`; transport wrappers consume it as the single
--- semantic source before offering any frame bytes.
fn websocket_message_write(
  state: WebSocketMessageState,
  handshake: WebSocketCloseHandshake,
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  limits: WebSocketLimits
) -> Result<WebSocketMessageState, WebSocketError> {
  let header = websocket_frame_header(
    final,
    opcode,
    websocket_bytes_len(payload),
    WebSocketUnmasked
  )
  match websocket_message_begin(
    state,
    handshake,
    WebSocketSendMessages,
    header,
    limits
  ) {
    Err(error) -> Err<WebSocketMessageState, WebSocketError>(error)
    Ok(frame) -> match websocket_message_read(frame, WebSocketMessageEnd(payload)) {
      WebSocketMessageDone(next) -> Ok<WebSocketMessageState, WebSocketError>(next)
      WebSocketMessageFailed(error) -> Err<WebSocketMessageState, WebSocketError>(error)
      WebSocketMessageMore(returned) -> Err<WebSocketMessageState, WebSocketError>(
        WebSocketPayloadLengthMismatch(websocket_bytes_len(payload), websocket_bytes_len(payload))
      )
    }
  }
}

fn websocket_close_code_valid(code: i64) -> bool {
  (code >= 1000 and code <= 1014 and code != 1004 and code != 1005 and code != 1006) or
    (code >= 3000 and code <= 4999)
}

--- Decode one complete control payload after frame-level validation.
fn websocket_decode_control(
  opcode: WebSocketOpcode,
  payload: Bytes
) -> Result<WebSocketControl, WebSocketError> {
  if websocket_bytes_len(payload) > 125 {
    Err<WebSocketControl, WebSocketError>(WebSocketControlTooLarge(websocket_bytes_len(payload)))
  } else { match opcode {
      WebSocketPing -> Ok<WebSocketControl, WebSocketError>(WebSocketControlPing(payload))
      WebSocketPong -> Ok<WebSocketControl, WebSocketError>(WebSocketControlPong(payload))
      WebSocketClose -> if payload.is_empty() {
        Ok<WebSocketControl, WebSocketError>(WebSocketControlClose(WebSocketCloseWithoutStatus))
      } else { if websocket_bytes_len(payload) == 1 {
          Err<WebSocketControl, WebSocketError>(WebSocketInvalidClosePayload)
        } else {
          let code = websocket_length16(payload, 0).to_u64().to_i64_checked().unwrap()
          if not websocket_close_code_valid(code) {
            Err<WebSocketControl, WebSocketError>(WebSocketInvalidCloseCode(code))
          } else {
            let reason_bytes = websocket_bytes_slice(payload, 2, websocket_bytes_len(payload))
            match reason_bytes.to_utf8() {
              Err(error) -> match error {
                InvalidUtf8(offset) -> Err<WebSocketControl, WebSocketError>(
                  WebSocketInvalidCloseReason(2 + offset)
                )
              }
              Ok(reason) -> Ok<WebSocketControl, WebSocketError>(
                WebSocketControlClose(WebSocketCloseWithStatus(code, reason))
              )
            }
          }
        } }
      _ -> Err<WebSocketControl, WebSocketError>(WebSocketExpectedControl)
    } }
}

--- Construct a sendable close value with a registered/application status.
fn websocket_close(code: i64, reason: str) -> Result<WebSocketCloseValue, WebSocketError> {
  if not websocket_close_code_valid(code) {
    Err<WebSocketCloseValue, WebSocketError>(WebSocketInvalidCloseCode(code))
  } else { if reason.len() > 123 {
      Err<WebSocketCloseValue, WebSocketError>(WebSocketCloseReasonTooLong(reason.len()))
    } else {
      Ok<WebSocketCloseValue, WebSocketError>(WebSocketCloseWithStatus(code, reason))
    } }
}

--- Construct an open close-handshake state.
fn websocket_close_handshake() -> WebSocketCloseHandshake {
  WebSocketCloseHandshake(WebSocketCloseOpen)
}

--- Record a locally sent close and derive whether to await or finish.
fn websocket_close_on_send(state: WebSocketCloseHandshake) -> WebSocketCloseTransition {
  match state {
    WebSocketCloseHandshake(phase) -> match phase {
      WebSocketCloseOpen -> WebSocketCloseAwaitPeer(WebSocketCloseHandshake(WebSocketCloseSent))
      WebSocketCloseReceived -> WebSocketCloseComplete(WebSocketCloseHandshake(WebSocketCloseExchanged))
      WebSocketCloseSent -> WebSocketCloseDuplicate(state)
      WebSocketCloseExchanged -> WebSocketCloseDuplicate(state)
    }
  }
}

--- Record a peer close, requiring an exact echo only when not already sent.
fn websocket_close_on_receive(state: WebSocketCloseHandshake, close: WebSocketCloseValue) -> WebSocketCloseTransition {
  match state {
    WebSocketCloseHandshake(phase) -> match phase {
      WebSocketCloseOpen -> WebSocketCloseEcho(WebSocketCloseHandshake(WebSocketCloseReceived), close)
      WebSocketCloseSent -> WebSocketCloseComplete(WebSocketCloseHandshake(WebSocketCloseExchanged))
      WebSocketCloseReceived -> WebSocketCloseDuplicate(state)
      WebSocketCloseExchanged -> WebSocketCloseDuplicate(state)
    }
  }
}

--- Return whether a local close has been sent.
fn websocket_close_was_sent(state: WebSocketCloseHandshake) -> bool {
  match state { WebSocketCloseHandshake(phase) -> match phase {
      WebSocketCloseOpen -> false
      WebSocketCloseReceived -> false
      WebSocketCloseSent -> true
      WebSocketCloseExchanged -> true
    } }
}

--- Return whether a peer close has been received.
fn websocket_close_was_received(state: WebSocketCloseHandshake) -> bool {
  match state { WebSocketCloseHandshake(phase) -> match phase {
      WebSocketCloseOpen -> false
      WebSocketCloseSent -> false
      WebSocketCloseReceived -> true
      WebSocketCloseExchanged -> true
    } }
}

--- Return whether both close directions are complete.
fn websocket_close_is_complete(state: WebSocketCloseHandshake) -> bool {
  match state { WebSocketCloseHandshake(phase) -> match phase {
      WebSocketCloseExchanged -> true
      _ -> false
    } }
}

pub (package) fn websocket_close_payload(close: WebSocketCloseValue) -> Bytes {
  match close {
    WebSocketCloseWithoutStatus -> bytes.empty()
    WebSocketCloseWithStatus(code, reason) -> {
      let mut out = bytes.empty()
      out = bytes_push(out, websocket_i64_to_u8((code bshr 8) band 255))
      out = bytes_push(out, websocket_i64_to_u8(code band 255))
      bytes_concat(out, bytes.from_str(reason))
    }
  }
}

fn websocket_append_length(out: Bytes, payload_bytes: usize, masked: bool) -> Bytes {
  let mask_bit: usize = if masked { 128 } else { 0 }
  let mut result = out
  if payload_bytes <= 125 {
    result = bytes_push(result, websocket_count_byte(mask_bit + payload_bytes))
  } else { if payload_bytes <= 65535 {
      result = bytes_push(result, websocket_count_byte(mask_bit + 126))
      result = bytes_push(result, websocket_count_byte((payload_bytes bshr 8) band 255))
      result = bytes_push(result, websocket_count_byte(payload_bytes band 255))
    } else {
      result = bytes_push(result, websocket_count_byte(mask_bit + 127))
      let shifts: [usize; 8] = [56, 48, 40, 32, 24, 16, 8, 0]
      for shift in shifts {
        result = bytes_push(result, websocket_count_byte((payload_bytes bshr shift) band 255))
      }
    } }
  result
}

fn websocket_encode(
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  masking: WebSocketMasking,
  limits: WebSocketLimits
) -> Result<Bytes, WebSocketError> {
  match websocket_validate_frame(final, opcode, websocket_bytes_len(payload), limits) {
    Err(error) -> Err<Bytes, WebSocketError>(error)
    Ok(done) -> {
      match opcode {
        WebSocketClose -> match websocket_decode_control(opcode, payload) {
          Err(error) -> return Err<Bytes, WebSocketError>(error)
          Ok(control) -> nil
        }
        _ -> nil
      }
      let masked = match masking { WebSocketUnmasked -> false WebSocketMasked(mask) -> true }
      let mut out = bytes.empty()
      out = bytes_push(out, websocket_i64_to_u8(
        (if final { 128 } else { 0 }) + websocket_opcode_value(opcode)
      ))
      out = websocket_append_length(out, websocket_bytes_len(payload), masked)
      match masking {
        WebSocketUnmasked -> Ok<Bytes, WebSocketError>(bytes_concat(out, payload))
        WebSocketMasked(mask) -> {
          let key = websocket_mask_bytes(mask)
          out = bytes_concat(out, key)
          Ok<Bytes, WebSocketError>(bytes_concat(
            out,
            websocket_unmask(WebSocketMasked(mask), 0, payload)
          ))
        }
      }
    }
  }
}

--- Encode one unmasked server frame after all per-frame validations.
fn websocket_encode_server_frame(
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  limits: WebSocketLimits
) -> Result<Bytes, WebSocketError> {
  websocket_encode(final, opcode, payload, WebSocketUnmasked, limits)
}

--- Encode one client frame with a fresh unpredictable four-byte mask.
fn websocket_encode_client_frame(
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  limits: WebSocketLimits
) -[SecureRandom]> Result<Bytes, WebSocketError> {
  match secure_random.bytes(4) {
    Err(error) -> Err<Bytes, WebSocketError>(WebSocketRandom(error))
    Ok(mask) -> websocket_encode(
      final,
      opcode,
      payload,
      WebSocketMasked(WebSocketMask(mask)),
      limits
    )
  }
}

--- Encode a validated close value for an unmasked server endpoint.
fn websocket_encode_server_close(
  close: WebSocketCloseValue,
  limits: WebSocketLimits
) -> Result<Bytes, WebSocketError> {
  websocket_encode_server_frame(true, WebSocketClose, websocket_close_payload(close), limits)
}

--- Encode a validated close value with a fresh client mask.
fn websocket_encode_client_close(
  close: WebSocketCloseValue,
  limits: WebSocketLimits
) -[SecureRandom]> Result<Bytes, WebSocketError> {
  websocket_encode_client_frame(true, WebSocketClose, websocket_close_payload(close), limits)
}

--- Construct frame and reassembled-message limits.
pub fn limits(
  frame_bytes: usize,
  message_bytes: usize
) -> Result<WebSocketLimits, WebSocketError> {
  websocket_limits_build(frame_bytes, message_bytes)
}

--- Return the standard frame and message limits.
pub fn default_limits() -> WebSocketLimits { websocket_default_limits() }

--- Begin a client upgrade with a fresh protocol nonce.
pub fn client_upgrade() -[SecureRandom]> Result<WebSocketClientUpgrade, WebSocketHandshakeError> {
  websocket_client_upgrade()
}

--- Validate a server upgrade request and derive its response headers.
pub fn server_upgrade(
  request: HttpRequestHead
) -> Result<HttpHeaders, WebSocketHandshakeError> {
  websocket_server_upgrade(request)
}

--- Parse one complete frame header without buffering its payload.
pub fn parse_frame_header(
  source: Bytes,
  role: WebSocketRole,
  limits: WebSocketLimits
) -> WebSocketFrameParse {
  websocket_parse_frame_header(source, role, limits)
}

--- Decode one complete control payload after frame validation.
pub fn decode_control(
  opcode: WebSocketOpcode,
  payload: Bytes
) -> Result<WebSocketControl, WebSocketError> {
  websocket_decode_control(opcode, payload)
}

--- Construct the idle inbound or outbound message state.
pub fn message_state() -> WebSocketMessageState { websocket_message_state() }

--- Construct a validated close value.
pub fn close(code: i64, reason: str) -> Result<WebSocketCloseValue, WebSocketError> {
  websocket_close(code, reason)
}

--- Construct an open close-handshake state.
pub fn close_handshake() -> WebSocketCloseHandshake { websocket_close_handshake() }

--- Encode one unmasked server frame.
pub fn encode_server_frame(
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  limits: WebSocketLimits
) -> Result<Bytes, WebSocketError> {
  websocket_encode_server_frame(final, opcode, payload, limits)
}

--- Encode one freshly masked client frame.
pub fn encode_client_frame(
  final: bool,
  opcode: WebSocketOpcode,
  payload: Bytes,
  limits: WebSocketLimits
) -[SecureRandom]> Result<Bytes, WebSocketError> {
  websocket_encode_client_frame(final, opcode, payload, limits)
}

impl WebSocketClientUpgrade {
  --- Return the protocol headers for this client request proof.
  pub fn headers(self) -> HttpHeaders { websocket_client_upgrade_headers(self) }

  --- Validate the server response against this request proof.
  pub fn validate(self, response: HttpResponseHead) -> Result<nil, WebSocketHandshakeError> {
    websocket_client_validate_upgrade(self, response)
  }
}

impl WebSocketFrameHeader {
  --- Return whether this frame ends its message.
  pub fn is_final(self) -> bool { websocket_frame_is_final(self) }

  --- Return the validated frame opcode.
  pub fn opcode(self) -> WebSocketOpcode { websocket_frame_opcode(self) }

  --- Return the declared payload length in bytes.
  pub fn payload_bytes(self) -> usize { websocket_frame_payload_bytes(self) }

  --- Return whether the payload is masked on the wire.
  pub fn is_masked(self) -> bool { websocket_frame_is_masked(self) }

  --- Start a streaming decoder for this frame's payload.
  pub fn payload_decoder(self) -> WebSocketPayloadDecoder {
    websocket_payload_decoder(self)
  }
}

impl WebSocketPayloadDecoder {
  --- Return the number of payload bytes still required.
  pub fn remaining(self) -> usize { websocket_payload_remaining(self) }

  --- Consume the next payload fragment from `source`.
  pub fn read(self, source: Bytes) -> WebSocketPayloadRead {
    websocket_payload_read(self, source)
  }
}

impl WebSocketMessageState {
  --- Return the kind of fragmented message awaiting continuation, if any.
  pub fn pending(self) -> Option<WebSocketMessageKind> {
    websocket_message_pending(self)
  }

  --- Validate a frame header and begin decoding its message contribution.
  pub fn begin(
    self,
    handshake: WebSocketCloseHandshake,
    flow: WebSocketMessageFlow,
    header: WebSocketFrameHeader,
    limits: WebSocketLimits
  ) -> Result<WebSocketMessageFrame, WebSocketError> {
    websocket_message_begin(self, handshake, flow, header, limits)
  }

  --- Encode one message fragment and advance the fragmentation state.
  pub fn write(
    self,
    handshake: WebSocketCloseHandshake,
    final: bool,
    opcode: WebSocketOpcode,
    payload: Bytes,
    limits: WebSocketLimits
  ) -> Result<WebSocketMessageState, WebSocketError> {
    websocket_message_write(self, handshake, final, opcode, payload, limits)
  }
}

impl WebSocketMessageFrame {
  --- Return the semantic content selected by this frame header.
  pub fn content(self) -> WebSocketMessageContent {
    websocket_message_content(self)
  }

  --- Consume the frame payload from the supplied message input.
  pub fn read(self, input: WebSocketMessageInput) -> WebSocketMessageRead {
    websocket_message_read(self, input)
  }
}

impl WebSocketOpcode {
  --- Decode this control opcode's complete validated payload.
  pub fn decode_control(self, payload: Bytes) -> Result<WebSocketControl, WebSocketError> {
    websocket_decode_control(self, payload)
  }
}

impl WebSocketCloseHandshake {
  --- Record sending a close frame and return the exact transition.
  pub fn on_send(self) -> WebSocketCloseTransition { websocket_close_on_send(self) }

  --- Record receiving a close frame and return the exact transition.
  pub fn on_receive(self, close: WebSocketCloseValue) -> WebSocketCloseTransition {
    websocket_close_on_receive(self, close)
  }

  --- Return whether a close frame has been sent.
  pub fn was_sent(self) -> bool { websocket_close_was_sent(self) }

  --- Return whether a close frame has been received.
  pub fn was_received(self) -> bool { websocket_close_was_received(self) }

  --- Return whether both sides of the close handshake are complete.
  pub fn is_complete(self) -> bool { websocket_close_is_complete(self) }
}

impl WebSocketCloseValue {
  --- Encode this close value as one unmasked server frame.
  pub fn encode_server(self, limits: WebSocketLimits) -> Result<Bytes, WebSocketError> {
    websocket_encode_server_close(self, limits)
  }

  --- Encode this close value as one freshly masked client frame.
  pub fn encode_client(
    self,
    limits: WebSocketLimits
  ) -[SecureRandom]> Result<Bytes, WebSocketError> {
    websocket_encode_client_close(self, limits)
  }
}
