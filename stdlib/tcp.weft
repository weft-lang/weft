-- stdlib/tcp.weft — capability-scoped owned TCP transport
--
-- Opening outbound and inbound endpoints are distinct authorities. Established
-- streams and listeners remain opaque owned resources: no descriptor, sockaddr
-- storage, integer option or platform sentinel crosses this module boundary.

use stdlib/drop.{Drop}
use stdlib/eq.{Eq}
use stdlib/io/types.{IoReadProgress, IoWriteProgress}
use stdlib/net_address.{SocketAddress}
use stdlib/result.{Result, Err, Ok}
use stdlib/vector.{vector_get_in_bounds, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- Options applied while creating an outbound TCP stream.
pub type TcpConnectOptions {
  --- Disable Nagle coalescing after a connection is established.
  no_delay: bool,
  --- Ask the platform to keep an idle connection alive.
  keep_alive: bool
}

--- Options applied while creating a listening TCP socket.
pub type TcpListenOptions {
  --- Maximum pending-connection hint supplied to the platform.
  backlog: usize,
  --- Permit safe local-address reuse according to platform TCP semantics.
  reuse_address: bool
}

--- A value policy that can narrow, but never grant, outbound TCP authority.
pub type TcpConnectPolicy {
  --- Delegate only exact numeric endpoints in the snapshotted allowlist.
  TcpConnectPolicyAllowOnly(Vector<SocketAddress>)
}

--- A value policy that can narrow, but never grant, inbound TCP authority.
pub type TcpListenPolicy {
  --- Delegate only exact local endpoints in the snapshotted allowlist.
  TcpListenPolicyAllowOnly(Vector<SocketAddress>)
}

--- The direction disabled by a TCP half-close operation.
pub type TcpShutdown {
  --- Disable further reads while preserving writes.
  TcpShutdownRead,
  --- Disable further writes while preserving reads.
  TcpShutdownWrite,
  --- Disable both reads and writes without releasing the owned stream.
  TcpShutdownBoth
}

--- A portable TCP transport failure family.
pub type TcpError {
  --- A blocking operation was interrupted and may be retried by policy.
  TcpInterrupted,
  --- Progress would block on the current non-blocking resource.
  TcpWouldBlock,
  --- The remote endpoint refused the connection.
  TcpConnectionRefused,
  --- An established connection was reset by its peer or the network.
  TcpConnectionReset,
  --- The local transport aborted an established or pending connection.
  TcpConnectionAborted,
  --- A write reached a peer that no longer accepts data.
  TcpBrokenPipe,
  --- The operation required an established connection.
  TcpNotConnected,
  --- The selected local endpoint is already in use.
  TcpAddressInUse,
  --- The selected local address is unavailable on this host.
  TcpAddressUnavailable,
  --- The destination network is unreachable.
  TcpNetworkUnreachable,
  --- The operation exceeded its configured platform deadline.
  TcpTimedOut,
  --- The process lacks authority for the requested socket operation.
  TcpPermissionDenied,
  --- A local value policy rejected the endpoint before a platform operation.
  TcpPolicyDenied,
  --- The platform could not allocate another socket or transport buffer.
  TcpResourceExhausted,
  --- A backend reported progress outside the requested byte range.
  TcpInvalidProgress,
  --- The platform reported an otherwise unmapped positive error code.
  TcpPlatform(i64)
}

--- A recoverable failure while registering or observing TCP readiness.
---
--- Every failure outcome below also returns the resource owner, so policy may
--- retry, close, or select another handler without fabricating authority.
pub type TcpReadinessError {
  --- The platform readiness wait was interrupted before resolving an event.
  TcpReadinessInterrupted,
  --- The readiness backend could not allocate another registration.
  TcpReadinessResourceExhausted,
  --- A registration was invalidated before it could be resolved safely.
  TcpReadinessInvalidated,
  --- The readiness backend reported an otherwise unmapped positive error.
  TcpReadinessPlatform(i64)
}

-- Resource representations are declaration-private. Runtime and canonical
-- deterministic handlers receive only the package bridges below.
--- An opaque, single-owner established TCP byte stream.
pub type TcpStream = opaque i64

--- An opaque, single-owner TCP listening socket.
pub type TcpListener = opaque i64

--- Ownership-preserving completion of stream readiness.
pub type TcpStreamReadiness {
  --- The stream may make progress; the next I/O operation remains advisory.
  TcpStreamReady(owned TcpStream),
  --- Readiness failed without consuming or closing the stream owner.
  TcpStreamReadinessFailed(owned TcpStream, TcpReadinessError)
}

--- Ownership-preserving completion of listener readiness.
pub type TcpListenerReadiness {
  --- The listener may accept a connection; readiness remains advisory.
  TcpListenerReady(owned TcpListener),
  --- Readiness failed without consuming or closing the listener owner.
  TcpListenerReadinessFailed(owned TcpListener, TcpReadinessError)
}

--- Authority to create an outbound TCP stream.
pub effect TcpConnect {
  --- Connect to one numeric endpoint without fabricating ownership on failure.
  fn connect(
    address: SocketAddress,
    options: TcpConnectOptions
  ) -> Result<owned TcpStream, TcpError>
}

--- Authority to bind and create a TCP listener.
pub effect TcpListen {
  --- Bind and listen without fabricating ownership on failure.
  fn listen(
    address: SocketAddress,
    options: TcpListenOptions
  ) -> Result<owned TcpListener, TcpError>
}

--- Authority to suspend an owned TCP resource until progress may be possible.
---
--- Operations move the owner into the handler and return it in every outcome.
--- Buffers and borrows never cross the suspension boundary; callers perform
--- the ordinary partial I/O operation after ownership returns.
pub effect TcpReadiness {
  --- Suspend until a stream may read bytes or observe EOF.
  fn readable(stream: owned TcpStream) -> TcpStreamReadiness
  --- Suspend until a stream may write bytes.
  fn writable(stream: owned TcpStream) -> TcpStreamReadiness
  --- Suspend until a listener may accept a connection.
  fn acceptable(listener: owned TcpListener) -> TcpListenerReadiness
}

--- Authority to operate on an already-owned TCP stream.
pub effect TcpStreamIO {
  --- Read at most `buffer.len` bytes into a non-escaping mutable view.
  fn read(stream: borrow mut TcpStream, buffer: [mut u8]) -> Result<IoReadProgress, TcpError>
  --- Write at most `buffer.len` bytes from a non-escaping shared view.
  fn write(stream: borrow mut TcpStream, buffer: [u8]) -> Result<IoWriteProgress, TcpError>
  --- Apply portable stream options to an established connection.
  fn configure(stream: borrow mut TcpStream, options: TcpConnectOptions) -> Result<nil, TcpError>
  --- Disable one or both directions without releasing ownership.
  fn shutdown(stream: borrow mut TcpStream, direction: TcpShutdown) -> Result<nil, TcpError>
  --- Observe the local numeric endpoint of an established stream.
  fn local_address(stream: borrow TcpStream) -> Result<SocketAddress, TcpError>
  --- Observe the remote numeric endpoint of an established stream.
  fn peer_address(stream: borrow TcpStream) -> Result<SocketAddress, TcpError>
  --- Release the underlying resource; negative values carry platform errors.
  fn release(stream: TcpStream) -> i64
}

--- Authority to accept and operate on an already-owned TCP listener.
pub effect TcpListenerIO {
  --- Accept one stream without fabricating ownership on failure.
  fn accept(listener: borrow mut TcpListener) -> Result<owned TcpStream, TcpError>
  --- Observe the listener's bound numeric endpoint.
  fn local_address(listener: borrow TcpListener) -> Result<SocketAddress, TcpError>
  --- Release the underlying resource; negative values carry platform errors.
  fn release(listener: TcpListener) -> i64
}

impl Drop for TcpStream {
  fn drop(self) -[TcpStreamIO]> i64 {
    match self { TcpStream(token) -> TcpStreamIO.release(TcpStream(token)) }
  }
}

impl Drop for TcpListener {
  fn drop(self) -[TcpListenerIO]> i64 {
    match self { TcpListener(token) -> TcpListenerIO.release(TcpListener(token)) }
  }
}

--- Construct the conservative default outbound options.
pub fn tcp_connect_options_default() -> TcpConnectOptions {
  TcpConnectOptions { no_delay: true, keep_alive: false }
}

--- Construct listener options with an explicit backlog and no address reuse.
pub fn tcp_listen_options(backlog: usize) -> TcpListenOptions {
  TcpListenOptions { backlog: backlog, reuse_address: false }
}

fn tcp_connect_policy_snapshot(policy: TcpConnectPolicy) -> TcpConnectPolicy {
  match policy {
    TcpConnectPolicyAllowOnly(addresses) -> {
      let snapshot = vector_with_capacity<SocketAddress>(addresses.len())
      for index in 0..addresses.len() {
        snapshot.push(vector_get_in_bounds<SocketAddress>(addresses, index))
      }
      TcpConnectPolicyAllowOnly(snapshot)
    }
  }
}

fn tcp_listen_policy_snapshot(policy: TcpListenPolicy) -> TcpListenPolicy {
  match policy {
    TcpListenPolicyAllowOnly(addresses) -> {
      let snapshot = vector_with_capacity<SocketAddress>(addresses.len())
      for index in 0..addresses.len() {
        snapshot.push(vector_get_in_bounds<SocketAddress>(addresses, index))
      }
      TcpListenPolicyAllowOnly(snapshot)
    }
  }
}

fn tcp_policy_addresses_allow(addresses: Vector<SocketAddress>, address: SocketAddress) -> bool {
  let mut allowed = false
  let mut index = 0
  while index < addresses.len() and not allowed {
    if vector_get_in_bounds<SocketAddress>(addresses, index).eq(address) {
      allowed = true
    } else { 0 }
    index = index + 1
  }
  allowed
}

fn tcp_connect_policy_allows(policy: TcpConnectPolicy, address: SocketAddress) -> bool {
  match policy {
    TcpConnectPolicyAllowOnly(addresses) -> tcp_policy_addresses_allow(addresses, address)
  }
}

fn tcp_listen_policy_allows(policy: TcpListenPolicy, address: SocketAddress) -> bool {
  match policy {
    TcpListenPolicyAllowOnly(addresses) -> tcp_policy_addresses_allow(addresses, address)
  }
}

--- Narrow outbound authority to a snapshotted endpoint policy for `body`.
--- Allowed requests delegate to the enclosing connector; denied requests do
--- not perform outward and return `TcpPolicyDenied`.
pub fn tcp_connect_with_policy<T, E>(
  policy: TcpConnectPolicy,
  body: () -[TcpConnect, E]> T
) -[TcpConnect, E]> T {
  let snapshot = tcp_connect_policy_snapshot(policy)
  handle body() {
    TcpConnect.connect(address, options) -> {
      if tcp_connect_policy_allows(snapshot, address) {
        resume(TcpConnect.connect(address, options))
      } else {
        resume(Err<owned TcpStream, TcpError>(TcpPolicyDenied))
      }
    }
  }
}

--- Narrow inbound authority to a snapshotted endpoint policy for `body`.
--- Allowed requests delegate to the enclosing listener; denied requests do
--- not perform outward and return `TcpPolicyDenied`.
pub fn tcp_listen_with_policy<T, E>(
  policy: TcpListenPolicy,
  body: () -[TcpListen, E]> T
) -[TcpListen, E]> T {
  let snapshot = tcp_listen_policy_snapshot(policy)
  handle body() {
    TcpListen.listen(address, options) -> {
      if tcp_listen_policy_allows(snapshot, address) {
        resume(TcpListen.listen(address, options))
      } else {
        resume(Err<owned TcpListener, TcpError>(TcpPolicyDenied))
      }
    }
  }
}

--- Connect to a numeric endpoint and return its single owned stream.
pub fn tcp_connect(
  address: SocketAddress,
  options: TcpConnectOptions
) -[TcpConnect]> Result<owned TcpStream, TcpError> {
  TcpConnect.connect(address, options)
}

--- Bind a numeric endpoint and return its single owned listener.
pub fn tcp_listen(
  address: SocketAddress,
  options: TcpListenOptions
) -[TcpListen]> Result<owned TcpListener, TcpError> {
  TcpListen.listen(address, options)
}

--- Suspend until `stream` may read, returning its owner in every outcome.
pub fn tcp_wait_readable(stream: owned TcpStream) -[TcpReadiness, TcpStreamIO]> TcpStreamReadiness {
  TcpReadiness.readable(stream)
}

--- Suspend until `stream` may write, returning its owner in every outcome.
pub fn tcp_wait_writable(stream: owned TcpStream) -[TcpReadiness, TcpStreamIO]> TcpStreamReadiness {
  TcpReadiness.writable(stream)
}

--- Suspend until `listener` may accept, returning its owner in every outcome.
pub fn tcp_wait_acceptable(listener: owned TcpListener) -[TcpListenerIO, TcpReadiness]> TcpListenerReadiness {
  TcpReadiness.acceptable(listener)
}

--- Accept one connection from an owned listener.
pub fn tcp_accept(
  listener: borrow mut TcpListener
) -[TcpListenerIO]> Result<owned TcpStream, TcpError> {
  TcpListenerIO.accept(listener)
}

--- Read into `buffer`, preserving partial progress and orderly EOF.
pub fn tcp_read(
  stream: borrow mut TcpStream,
  buffer: [mut u8]
) -[TcpStreamIO]> Result<IoReadProgress, TcpError> {
  TcpStreamIO.read(stream, buffer)
}

--- Write from `buffer`, preserving partial progress.
pub fn tcp_write(
  stream: borrow mut TcpStream,
  buffer: [u8]
) -[TcpStreamIO]> Result<IoWriteProgress, TcpError> {
  TcpStreamIO.write(stream, buffer)
}

--- Apply portable options to an established or accepted stream.
pub fn tcp_stream_configure(
  stream: borrow mut TcpStream,
  options: TcpConnectOptions
) -[TcpStreamIO]> Result<nil, TcpError> {
  TcpStreamIO.configure(stream, options)
}

--- Disable one or both stream directions without releasing ownership.
pub fn tcp_shutdown(
  stream: borrow mut TcpStream,
  direction: TcpShutdown
) -[TcpStreamIO]> Result<nil, TcpError> {
  TcpStreamIO.shutdown(stream, direction)
}

--- Observe an established stream's local numeric endpoint.
pub fn tcp_stream_local_address(
  stream: borrow TcpStream
) -[TcpStreamIO]> Result<SocketAddress, TcpError> {
  TcpStreamIO.local_address(stream)
}

--- Observe an established stream's remote numeric endpoint.
pub fn tcp_stream_peer_address(
  stream: borrow TcpStream
) -[TcpStreamIO]> Result<SocketAddress, TcpError> {
  TcpStreamIO.peer_address(stream)
}

--- Observe a listener's bound numeric endpoint.
pub fn tcp_listener_local_address(
  listener: borrow TcpListener
) -[TcpListenerIO]> Result<SocketAddress, TcpError> {
  TcpListenerIO.local_address(listener)
}

-- close consumes the owner even when the platform reports failure: retrying a
-- descriptor after close reports an error is not safe on supported targets.
--- Close and consume an owned stream, even when the platform reports failure.
pub fn tcp_stream_close(stream: owned TcpStream) -[TcpStreamIO]> Result<nil, TcpError> {
  let status = stream.drop()
  if status == 0 { Ok<nil, TcpError>(nil) }
  else { Err<nil, TcpError>(tcp_error_from_platform_status(status)) }
}

--- Close and consume an owned listener, even when the platform reports failure.
pub fn tcp_listener_close(listener: owned TcpListener) -[TcpListenerIO]> Result<nil, TcpError> {
  let status = listener.drop()
  if status == 0 { Ok<nil, TcpError>(nil) }
  else { Err<nil, TcpError>(tcp_error_from_platform_status(status)) }
}

-- Darwin and Linux share the mapped socket errno values used here. Target-
-- specific runtime leaves preserve every other positive code in TcpPlatform.
pub(package) fn tcp_error_from_platform_status(status: i64) -> TcpError {
  let code = if status < 0 { 0 - status } else { status }
  if code == 4 { TcpInterrupted }
  else { if code == 11 or code == 35 { TcpWouldBlock }
  else { if code == 61 or code == 111 { TcpConnectionRefused }
  else { if code == 54 or code == 104 { TcpConnectionReset }
  else { if code == 53 or code == 103 { TcpConnectionAborted }
  else { if code == 32 { TcpBrokenPipe }
  else { if code == 57 or code == 107 { TcpNotConnected }
  else { if code == 48 or code == 98 { TcpAddressInUse }
  else { if code == 49 or code == 99 { TcpAddressUnavailable }
  else { if code == 51 or code == 101 { TcpNetworkUnreachable }
  else { if code == 60 or code == 110 { TcpTimedOut }
  else { if code == 1 or code == 13 { TcpPermissionDenied }
  else { if code == 12 or code == 23 or code == 24 or code == 55 or code == 105 { TcpResourceExhausted }
  else { TcpPlatform(code) } } } } } } } } } } } } }
}

pub(package) fn tcp_stream_from_token(token: i64) -> owned TcpStream {
  TcpStream(token)
}

pub(package) fn tcp_listener_from_token(token: i64) -> owned TcpListener {
  TcpListener(token)
}

pub(package) fn tcp_stream_token(stream: borrow TcpStream) -> i64 {
  match stream { TcpStream(token) -> token }
}

pub(package) fn tcp_listener_token(listener: borrow TcpListener) -> i64 {
  match listener { TcpListener(token) -> token }
}

pub(package) fn tcp_stream_release_token(stream: TcpStream) -> i64 {
  match stream { TcpStream(token) -> token }
}

pub(package) fn tcp_listener_release_token(listener: TcpListener) -> i64 {
  match listener { TcpListener(token) -> token }
}
