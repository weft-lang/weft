-- stdlib/process.weft — typed process capability and owned child resources

use stdlib/bytes.{Bytes}
use stdlib/drop.{Drop}
use stdlib/list.{List}
use stdlib/result.{Result}
use stdlib/time/monotonic.{Instant}

--- The exact way a child process terminated.
pub type ProcTermination {
  --- The child returned an ordinary exit code.
  ProcExited(i64),
  --- The child was terminated by a signal number.
  ProcSignaled(i64)
}

--- A process operation failure, distinct from child termination.
pub type ProcError {
  --- The requested child image could not be started.
  ProcSpawnFailed(i64),
  --- The platform could not observe or reap the child.
  ProcWaitFailed(i64),
  --- Captured output could not be drained completely.
  ProcCaptureFailed(i64),
  --- A session stream operation failed with a platform error code.
  ProcStreamFailed(i64)
}

--- Captured completion of an owned child process.
pub type ProcOutput {
  --- The child completed before its optional deadline.
  ProcCompleted(ProcTermination, str, str),
  --- The deadline elapsed and the handler killed and reaped the child.
  ProcTimedOut(ProcTermination, str, str),
  --- Spawning, waiting, or capture failed; partial output is preserved.
  ProcFailed(ProcError, str, str)
}

--- An opaque single-owner child process and its runtime-owned state.
pub type ProcHandle = opaque i64

--- An opaque single-owner interactive child: its standard input is writable
--- and its standard output and error are readable as they arrive. Every
--- operation moves the session in and returns it, so no borrow spans an
--- effect operation and a deferred handler remains possible.
pub type ProcSession = opaque i64

--- Which output stream a session read produced.
pub type ProcStream {
  --- The child's standard output.
  ProcStdout,
  --- The child's standard error.
  ProcStderr
}

--- Progress of one bounded session read.
pub type ProcReadOutcome {
  --- Bytes arrived on the named stream, at most the requested limit.
  ProcReadChunk(ProcStream, Bytes),
  --- Both output streams reached end of input.
  ProcReadEnded,
  --- The deadline elapsed before any byte arrived; the session stays usable.
  ProcReadTimedOut,
  --- Reading failed; the session stays owned and must still be finished or dropped.
  ProcReadFailed(ProcError)
}

--- Progress of one session write.
pub type ProcWriteOutcome {
  --- Every byte of the chunk reached the child's standard input.
  ProcWritten,
  --- The child no longer reads its input; this many bytes were accepted first.
  ProcWriteRefused(usize),
  --- The deadline elapsed after this many bytes were accepted.
  ProcWriteTimedOut(usize),
  --- Writing failed after this many bytes were accepted.
  ProcWriteFailed(ProcError, usize)
}

--- Authority to start, observe, and release child processes.
---
--- Production handlers inherit the current process environment. Tests can
--- interpret the same operations without starting an operating-system child.
---
--- Sessions carry bounded byte chunks only; message framing belongs to the
--- consumer. While a write cannot progress the handler drains the child's
--- output into session storage, so a child blocked on a full output pipe
--- never blocks the writer; reads serve that stored output first, standard
--- output before standard error, and it grows until it is read.
pub effect Proc {
  --- Run one child synchronously with inherited standard streams.
  fn run(path: str, args: List<str>) -> Result<ProcTermination, ProcError>
  --- Start one child with separately captured standard output and error.
  fn spawn(path: str, args: List<str>) -> owned ProcHandle
  --- Consume a child owner, wait without a deadline, and capture its output.
  fn wait(resource: ProcHandle) -> ProcOutput
  --- Consume a child owner and enforce an absolute monotonic deadline.
  fn wait_until(resource: ProcHandle, deadline: Instant) -> ProcOutput
  --- Release an unconsumed child owner by killing, closing, and reaping it.
  fn release(resource: ProcHandle) -> i64
  --- Start one child whose standard input is writable and whose output
  --- streams are readable while it runs. A failed start is carried inside
  --- the session and reported by every later operation.
  fn open_session(path: str, args: List<str>) -> owned ProcSession
  --- Write one chunk to the child's standard input before an absolute
  --- deadline. A deadline already passed attempts the write once.
  fn session_write(
    session: ProcSession,
    chunk: Bytes,
    deadline: Instant
  ) -> (owned ProcSession, ProcWriteOutcome)
  --- Close the child's standard input so it observes end of input. Later
  --- writes are refused without touching the platform; closing twice is a
  --- no-op.
  fn session_close_input(session: ProcSession) -> owned ProcSession
  --- Read the next chunk of at most `limit` bytes from either output stream
  --- before an absolute deadline. A deadline already passed polls once. A
  --- zero limit is refused.
  fn session_read(
    session: ProcSession,
    limit: usize,
    deadline: Instant
  ) -> (owned ProcSession, ProcReadOutcome)
  --- Consume the session: close its input, read the remaining output until
  --- both streams end, and reap the child without a deadline. The output
  --- reported is what reads had not consumed.
  fn session_finish(session: ProcSession) -> ProcOutput
  --- Consume the session as `session_finish`, killing and reaping the child
  --- when the absolute deadline elapses first.
  fn session_finish_until(session: ProcSession, deadline: Instant) -> ProcOutput
  --- Release an unconsumed session by killing, closing, and reaping it.
  fn session_release(session: ProcSession) -> i64
}

impl Drop for ProcHandle {
  fn drop(self) -[Proc]> i64 {
    Proc.release(self)
  }
}

impl Drop for ProcSession {
  fn drop(self) -[Proc]> i64 {
    Proc.session_release(self)
  }
}

-- Trusted runtime bridges. Ordinary modules cannot construct or project the
-- opaque resource, while deterministic handlers still use the public effect.
pub(package) fn proc_handle_from_token(token: i64) -> owned ProcHandle {
  ProcHandle(token)
}

pub(package) fn proc_handle_token(resource: borrow ProcHandle) -> i64 {
  match resource {
    ProcHandle(token) -> token
  }
}

pub(package) fn proc_handle_release_token(resource: ProcHandle) -> i64 {
  match resource {
    ProcHandle(token) -> token
  }
}

pub(package) fn proc_session_from_token(token: i64) -> owned ProcSession {
  ProcSession(token)
}

pub(package) fn proc_session_token(session: borrow ProcSession) -> i64 {
  match session {
    ProcSession(token) -> token
  }
}

pub(package) fn proc_session_release_token(session: ProcSession) -> i64 {
  match session {
    ProcSession(token) -> token
  }
}
