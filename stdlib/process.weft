-- stdlib/process.weft — Process spawning via libSystem
--
-- These functions call through the GOT (Global Offset Table) to
-- dynamically-linked libSystem functions. Binaries that use this
-- module get real dyld linkage with LC_LOAD_DYLIB for libSystem.
--
-- The compiler itself does NOT use this module (it's a static binary).
-- Only user programs that `use "stdlib/process.weft"` get libSystem linkage.
--
-- GOT-backed calls are explicitly Unsafe. Trusted platform wrappers live in
-- runtime modules; ordinary imported support code may call them only through
-- an effect boundary supplied by its caller.

use "runtime/process.weft"

-- posix_spawn: create a new process
-- Returns 0 on success, error code on failure.
-- pid: pointer to store child PID
-- path: null-terminated path to executable
-- file_actions: posix_spawn_file_actions_t* (0 for default)
-- attrp: posix_spawnattr_t* (0 for default)
-- argv: null-terminated array of char* arguments
-- envp: null-terminated array of char* environment (0 for inherit)
fn posix_spawn(pid: i64, path: i64, file_actions: i64, attrp: i64, argv: i64, envp: i64) -[Unsafe]> i64 {
  runtime_posix_spawn(pid, path, file_actions, attrp, argv, envp)
}

-- waitpid: wait for a child process
-- Returns child PID on success, -1 on error.
fn waitpid(pid: i64, stat_loc: i64, options: i64) -[Unsafe]> i64 {
  runtime_waitpid(pid, stat_loc, options)
}

-- exit: terminate the process with the given exit code
fn libc_exit(code: i64) -[Unsafe]> i64 {
  runtime_libc_exit(code)
}

-- Trusted libSystem write wrapper. It stays effectful so the optimiser never
-- treats an OS write as a pure scalar call.
fn libsystem_write(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  runtime_libsystem_write(fd, buf, len)
}

-- Helper: create a null-terminated C string from a Weft string literal
fn make_cstr(s: str) -> i64 {
  runtime_process_make_cstr(s)
}

-- Helper: run an executable, wait for it, return exit status
fn run_command(path: i64, argv: i64) -[Unsafe]> i64 {
  runtime_process_run_command(path, argv)
}
