-- stdlib/process.weft — typed process capability and owned child resources

use stdlib/bytes.{Bytes}
use stdlib/drop.{Drop}
use stdlib/list.{List}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/result.{Result}
use runtime/unsafe.{Unsafe}
use stdlib/time/monotonic.{Instant}

--- The exact way a child process terminated.
pub type ProcTermination {
  --- The child returned an ordinary exit code.
  ProcExited(i64),
  --- The child was terminated by a signal number.
  ProcSignaled(i64)
}

--- A process operation failure, distinct from child termination.
pub type ProcError {
  --- The requested child image could not be started.
  ProcSpawnFailed(i64),
  --- The platform could not observe or reap the child.
  ProcWaitFailed(i64),
  --- Captured output could not be drained completely.
  ProcCaptureFailed(i64),
  --- A session stream operation failed with a platform error code.
  ProcStreamFailed(i64),
  --- The child produced more unread output than the session's store limit
  --- while being finished; it was killed and reaped and the output kept is
  --- exactly the limit.
  ProcOutputLimitExceeded(usize),
  --- The owner belongs to another interpretation of `Proc`, such as a
  --- deterministic handler's scripted child; this handler refused it without
  --- touching any platform state.
  ProcOwnerForeign
}

--- Captured completion of an owned child process.
pub type ProcOutput {
  --- The child completed before its optional deadline.
  ProcCompleted(ProcTermination, str, str),
  --- The deadline elapsed and the handler killed and reaped the child.
  ProcTimedOut(ProcTermination, str, str),
  --- Spawning, waiting, or capture failed; partial output is preserved.
  ProcFailed(ProcError, str, str)
}

-- Which interpretation of Proc an owner belongs to. A platform owner holds
-- runtime state that only the trusted runtime may touch; a scripted owner
-- holds an identifier a deterministic handler chose, and names no platform
-- state at all.
pub(package) type ProcOwner {
  PlatformProcOwner(i64),
  ScriptedProcOwner(i64)
}

--- An opaque single-owner child process and its runtime-owned state.
pub type ProcHandle = opaque ProcOwner

--- An opaque single-owner interactive child: its standard input is writable
--- and its standard output and error are readable as they arrive. Every
--- operation moves the session in and returns it, so no borrow spans an
--- effect operation and a deferred handler remains possible.
pub type ProcSession = opaque ProcOwner

--- Which output stream a session read produced.
pub type ProcStream {
  --- The child's standard output.
  ProcStdout,
  --- The child's standard error.
  ProcStderr
}

--- Progress of one bounded session read.
pub type ProcReadOutcome {
  --- Bytes arrived on the named stream, at most the requested limit.
  ProcReadChunk(ProcStream, Bytes),
  --- Both output streams reached end of input.
  ProcReadEnded,
  --- The deadline elapsed before any byte arrived; the session stays usable.
  ProcReadTimedOut,
  --- Reading failed; the session stays owned and must still be finished or dropped.
  ProcReadFailed(ProcError)
}

--- Progress of one session write.
pub type ProcWriteOutcome {
  --- Every byte of the chunk reached the child's standard input.
  ProcWritten,
  --- The child no longer reads its input; this many bytes were accepted first.
  ProcWriteRefused(usize),
  --- The session holds its store limit of unread output and the child has
  --- accepted this many bytes; read stored output, then write the rest.
  ProcWriteBlocked(usize),
  --- The deadline elapsed after this many bytes were accepted.
  ProcWriteTimedOut(usize),
  --- Writing failed after this many bytes were accepted.
  ProcWriteFailed(ProcError, usize)
}

--- Authority to start, observe, and release child processes.
---
--- Production handlers inherit the current process environment. Tests can
--- interpret the same operations without starting an operating-system child.
---
--- Sessions carry bounded byte chunks only; message framing belongs to the
--- consumer. While a write cannot progress the handler drains the child's
--- output into session storage, so a child blocked on a full output pipe
--- never blocks the writer; reads serve that stored output first, standard
--- output before standard error. The store is bounded by the limit given
--- when the session opens: a write that cannot progress once the store is
--- full reports `ProcWriteBlocked`, and finishing a child whose unread
--- output would exceed the limit kills it and reports
--- `ProcOutputLimitExceeded`. Every read and write honours its deadline on
--- every iteration, whether or not it is making progress.
pub effect Proc {
  --- Run one child synchronously with inherited standard streams.
  fn run(path: str, args: List<str>) -> Result<ProcTermination, ProcError>
  --- Start one child with separately captured standard output and error.
  fn spawn(path: str, args: List<str>) -> owned ProcHandle
  --- Consume a child owner, wait without a deadline, and capture its output.
  fn wait(resource: ProcHandle) -> ProcOutput
  --- Consume a child owner and enforce an absolute monotonic deadline.
  fn wait_until(resource: ProcHandle, deadline: Instant) -> ProcOutput
  --- Release an unconsumed child owner by killing, closing, and reaping it.
  fn release(resource: ProcHandle) -> i64
  --- Start one child whose standard input is writable and whose output
  --- streams are readable while it runs. `store_limit` bounds the unread
  --- output the session holds on the caller's behalf. A failed start is
  --- carried inside the session and reported by every later operation.
  fn open_session(path: str, args: List<str>, store_limit: usize) -> owned ProcSession
  --- Write one chunk to the child's standard input before an absolute
  --- deadline. A deadline already passed attempts the write once.
  fn session_write(
    session: ProcSession,
    chunk: Bytes,
    deadline: Instant
  ) -> (owned ProcSession, ProcWriteOutcome)
  --- Close the child's standard input so it observes end of input. Later
  --- writes are refused without touching the platform; closing twice is a
  --- no-op.
  fn session_close_input(session: ProcSession) -> owned ProcSession
  --- Read the next chunk of at most `limit` bytes from either output stream
  --- before an absolute deadline. A deadline already passed polls once. A
  --- zero limit is refused.
  fn session_read(
    session: ProcSession,
    limit: usize,
    deadline: Instant
  ) -> (owned ProcSession, ProcReadOutcome)
  --- Consume the session: close its input, read the remaining output until
  --- both streams end, and reap the child without a deadline. The output
  --- reported is what reads had not consumed, bounded by the store limit.
  fn session_finish(session: ProcSession) -> ProcOutput
  --- Consume the session as `session_finish`, killing and reaping the child
  --- when the absolute deadline elapses first.
  fn session_finish_until(session: ProcSession, deadline: Instant) -> ProcOutput
  --- Release an unconsumed session by killing, closing, and reaping it.
  fn session_release(session: ProcSession) -> i64
}

impl Drop for ProcHandle {
  fn drop(self) -[Proc]> i64 {
    Proc.release(self)
  }
}

impl Drop for ProcSession {
  fn drop(self) -[Proc]> i64 {
    Proc.session_release(self)
  }
}

-- Trusted runtime bridges. Minting an owner from platform state, or reading
-- that state back, is an unsafe operation, so only the trusted runtime can
-- perform one. Strict code holds, moves and releases owners, and can neither
-- forge platform state nor duplicate an owner of it.
pub(package) fn proc_handle_from_platform(state: i64) -[Unsafe]> owned ProcHandle {
  ProcHandle(PlatformProcOwner(state))
}

pub(package) fn proc_handle_release_owner(resource: ProcHandle) -[Unsafe]> ProcOwner {
  match resource {
    ProcHandle(owner) -> owner
  }
}

pub(package) fn proc_session_from_platform(state: i64) -[Unsafe]> owned ProcSession {
  ProcSession(PlatformProcOwner(state))
}

pub(package) fn proc_session_release_owner(session: ProcSession) -[Unsafe]> ProcOwner {
  match session {
    ProcSession(owner) -> owner
  }
}

--- A child owner for a deterministic `Proc` handler, named by `id`. A handler
--- that starts real children refuses a scripted owner instead of interpreting
--- it.
pub fn scripted_handle(id: i64) -> owned ProcHandle { ProcHandle(ScriptedProcOwner(id)) }

--- A session owner for a deterministic `Proc` handler, named by `id`.
pub fn scripted_session(id: i64) -> owned ProcSession { ProcSession(ScriptedProcOwner(id)) }

--- The identifier of a scripted child owner, or `None` for a child the host
--- platform started.
pub fn scripted_handle_id(resource: borrow ProcHandle) -> Option<i64> {
  match resource {
    ProcHandle(ScriptedProcOwner(id)) -> Some(id)
    ProcHandle(PlatformProcOwner(_)) -> None<i64>()
  }
}

--- The identifier of a scripted session owner, or `None` for a session the
--- host platform started.
pub fn scripted_session_id(session: borrow ProcSession) -> Option<i64> {
  match session {
    ProcSession(ScriptedProcOwner(id)) -> Some(id)
    ProcSession(PlatformProcOwner(_)) -> None<i64>()
  }
}

--- Consume a scripted child owner and return its identifier. A deterministic
--- handler that receives an owner the host platform started has been given
--- another interpretation's resource, so this aborts rather than strand its
--- platform state.
pub fn release_scripted_handle(resource: ProcHandle) -> i64 {
  match resource {
    ProcHandle(ScriptedProcOwner(id)) -> id
    ProcHandle(PlatformProcOwner(_)) -> panic(
      "a deterministic Proc handler received a child the host platform started"
    )
  }
}

--- Consume a scripted session owner and return its identifier, aborting for
--- a session the host platform started.
pub fn release_scripted_session(session: ProcSession) -> i64 {
  match session {
    ProcSession(ScriptedProcOwner(id)) -> id
    ProcSession(PlatformProcOwner(_)) -> panic(
      "a deterministic Proc handler received a session the host platform started"
    )
  }
}
