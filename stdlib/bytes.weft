-- stdlib/bytes.weft — immutable arbitrary byte sequences
--
-- Bytes deliberately uses persistent storage: unlike Vector<u8>, a Bytes
-- value cannot be mutated through an alias and can cross Sendable boundaries.
-- Mutable I/O buffers remain Vector<u8> plus scoped [mut u8] borrows.

use runtime/string.{runtime_str_byte_at, runtime_str_from_bytes_copy, runtime_str_len}
use stdlib/num.{num_i64_to_u8_checked, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/option.{Option, None, Some}
use stdlib/result.{Result, Err, Ok}
use stdlib/utf8.{Utf8Decoded, Utf8Malformed, utf8_decode_next_bytes}
use stdlib/vector.{persistent_vector_new, vector_data, vector_get_in_bounds, vector_new}
use stdlib/vector/handles.{PersistentVector, Vector}

--- An immutable, persistent sequence of arbitrary bytes.
pub type Bytes = opaque PersistentVector<u8>

--- A failure to decode bytes as UTF-8 text.
pub type Utf8Error {
  --- Invalid UTF-8 beginning at the reported byte offset.
  InvalidUtf8(i64)
}

--- Construct an empty byte sequence.
pub fn bytes_empty() -> Bytes {
  Bytes(persistent_vector_new<u8>())
}

--- Copy a borrowed byte slice into immutable storage.
pub fn bytes_from_slice(values: [u8]) -> Bytes {
  let mut out = persistent_vector_new<u8>()
  for value in values {
    out = out.push(value)
  }
  Bytes(out)
}

-- Copying is intentional: later mutation of the source Vector cannot change
-- an immutable Bytes value.
--- Copy a mutable vector into independent immutable storage.
pub fn bytes_from_vector(values: Vector<u8>) -> Bytes {
  let mut out = persistent_vector_new<u8>()
  for i in 0..values.len() {
    out = out.push(vector_get_in_bounds<u8>(values, i))
  }
  Bytes(out)
}

--- Copy the UTF-8 encoding of `text` into a byte sequence.
pub fn bytes_from_str(text: str) -> Bytes {
  let mut out = persistent_vector_new<u8>()
  for i in 0..runtime_str_len(text) {
    let byte = num_i64_to_u8_checked(runtime_str_byte_at(text, i)).unwrap_or(0)
    out = out.push(byte)
  }
  Bytes(out)
}

--- Return the number of bytes.
pub fn bytes_len(values: Bytes) -> i64 {
  match values {
    Bytes(storage) -> storage.len()
  }
}

--- Return whether the sequence contains no bytes.
pub fn bytes_is_empty(values: Bytes) -> bool {
  bytes_len(values) == 0
}

-- Persistent byte construction is package-visible so incremental protocol
-- parsers can retain only their bounded unfinished prefix without exposing
-- the opaque storage representation.
pub(package) fn bytes_push(values: Bytes, value: u8) -> Bytes {
  match values {
    Bytes(storage) -> Bytes(storage.push(value))
  }
}

pub(package) fn bytes_concat(left: Bytes, right: Bytes) -> Bytes {
  match left {
    Bytes(storage) -> match right {
      Bytes(other) -> {
        let mut out = storage
        for index in 0..other.len() {
          out = out.push(other.get(index).unwrap_or(0))
        }
        Bytes(out)
      }
    }
  }
}

pub(package) fn bytes_copy_range(values: Bytes, start: i64, end: i64) -> Bytes {
  match values {
    Bytes(storage) -> {
      let first = if start < 0 { 0 } else { start }
      let last = if end > storage.len() { storage.len() } else { end }
      let mut out = persistent_vector_new<u8>()
      let mut index = first
      while index < last {
        out = out.push(storage.get(index).unwrap_or(0))
        index = index + 1
      }
      Bytes(out)
    }
  }
}

--- Copy the half-open byte range, or return `None` for invalid bounds.
pub fn bytes_slice(values: Bytes, start: usize, end: usize) -> Option<Bytes> {
  let first = num_u64_to_i64_checked(num_usize_to_u64(start)).unwrap_or(0 - 1)
  let last = num_u64_to_i64_checked(num_usize_to_u64(end)).unwrap_or(0 - 1)
  if first < 0 or last < first or last > bytes_len(values) {
    None<Bytes>()
  } else {
    Some<Bytes>(bytes_copy_range(values, first, last))
  }
}

--- Return the byte at `index`, or `None` when out of bounds.
pub fn bytes_get(values: Bytes, index: i64) -> Option<u8> {
  match values {
    Bytes(storage) -> storage.get(index)
  }
}

--- Return the first index of `needle`, or `-1` when absent.
pub fn bytes_find(values: Bytes, needle: u8) -> i64 {
  match values {
    Bytes(storage) -> {
      let n = storage.len()
      let mut i = 0
      let mut found = 0 - 1
      while found < 0 and i < n {
        if storage.get(i).unwrap_or(0) == needle {
          found = i
        } else {
          i = i + 1
        }
      }
      found
    }
  }
}

--- Compare two byte sequences by length and contents.
pub fn bytes_equal(left: Bytes, right: Bytes) -> bool {
  match left {
    Bytes(left_storage) -> match right {
      Bytes(right_storage) -> {
        let n = left_storage.len()
        if n != right_storage.len() {
          false
        } else {
          let mut same = true
          let mut i = 0
          while same and i < n {
            if left_storage.get(i).unwrap_or(0) != right_storage.get(i).unwrap_or(0) {
              same = false
            } else {
              i = i + 1
            }
          }
          same
        }
      }
    }
  }
}

-- The returned Vector is an independent mutable copy.
--- Copy the bytes into an independent mutable vector.
pub fn bytes_to_vector(values: Bytes) -> Vector<u8> {
  match values {
    Bytes(storage) -> {
      let out = vector_new<u8>()
      for i in 0..storage.len() {
        out.push(storage.get(i).unwrap_or(0))
      }
      out
    }
  }
}

--- Return the first invalid UTF-8 byte offset, or `-1` when valid.
pub fn bytes_utf8_error_offset(values: Bytes) -> i64 {
  let contiguous = bytes_to_vector(values)
  let n = contiguous.len()
  let src = vector_data<u8>(contiguous)
  let mut pos = 0
  let mut error = 0 - 1
  while error < 0 and pos < n {
    match utf8_decode_next_bytes(src, n, pos) {
      Utf8Malformed(offset) -> { error = offset }
      Utf8Decoded(next, scalar) -> { pos = next }
    }
  }
  error
}

--- Decode valid UTF-8, reporting the first invalid byte offset on failure.
pub fn bytes_to_utf8(values: Bytes) -> Result<str, Utf8Error> {
  let contiguous = bytes_to_vector(values)
  let n = contiguous.len()
  let src = vector_data<u8>(contiguous)
  let mut pos = 0
  let mut error = 0 - 1
  while error < 0 and pos < n {
    match utf8_decode_next_bytes(src, n, pos) {
      Utf8Malformed(offset) -> { error = offset }
      Utf8Decoded(next, scalar) -> { pos = next }
    }
  }
  if error < 0 {
    Ok<str, Utf8Error>(runtime_str_from_bytes_copy(src, n))
  } else {
    Err<str, Utf8Error>(InvalidUtf8(error))
  }
}

--- Return a UTF-8 error's byte offset, or `default` for future error forms.
pub fn utf8_error_offset_or(error: Utf8Error, default: i64) -> i64 {
  match error {
    InvalidUtf8(offset) -> offset
  }
}
