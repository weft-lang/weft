-- stdlib/bytes.weft — immutable arbitrary byte sequences
--
-- Bytes deliberately uses persistent storage: unlike Vector<u8>, a Bytes
-- value cannot be mutated through an alias and can cross Sendable boundaries.
-- Mutable I/O buffers remain Vector<u8> plus scoped [mut u8] borrows.

use runtime/string.{runtime_str_byte_at, runtime_str_from_bytes_copy, runtime_str_len}
use stdlib/eq.{Eq}
use stdlib/num
use stdlib/option.{Option, None, Some}
use stdlib/result.{Result, Err, Ok}
use stdlib/utf8.{Utf8Decoded, Utf8Malformed, utf8_decode_next_bytes}
use stdlib/persistent_vector as persistent_vector
use stdlib/vector as vector
use stdlib/vector.{vector_data, vector_get_in_bounds}
use stdlib/vector/handles.{PersistentVector, Vector}

--- An immutable, persistent sequence of arbitrary bytes.
pub type Bytes = opaque PersistentVector<u8>

--- A failure to decode bytes as UTF-8 text.
pub type Utf8Error {
  --- Invalid UTF-8 beginning at the reported byte offset.
  InvalidUtf8(usize)
}

--- Construct an empty byte sequence.
pub fn empty() -> Bytes {
  Bytes(persistent_vector.new<u8>())
}

--- Copy a borrowed byte slice into immutable storage.
pub fn from_slice(values: [u8]) -> Bytes {
  let mut out = persistent_vector.new<u8>()
  for value in values {
    out = out.push(value)
  }
  Bytes(out)
}

-- Copying is intentional: later mutation of the source Vector cannot change
-- an immutable Bytes value.
--- Copy a mutable vector into independent immutable storage.
pub fn from_vector(values: borrow Vector<u8>) -> Bytes {
  let mut out = persistent_vector.new<u8>()
  for i in 0..values.len() {
    out = out.push(vector_get_in_bounds<u8>(values, i))
  }
  Bytes(out)
}

--- Copy the UTF-8 encoding of `text` into a byte sequence.
pub fn from_str(text: str) -> Bytes {
  let mut out = persistent_vector.new<u8>()
  for i in 0..runtime_str_len(text) {
    let byte = runtime_str_byte_at(text, i).to_u8_checked().unwrap_or(0)
    out = out.push(byte)
  }
  Bytes(out)
}

impl Bytes {
  --- Return the number of bytes as a platform-sized unsigned count.
  pub fn len(self) -> usize {
    match self {
      Bytes(storage) -> storage.len().to_usize_checked().unwrap_or(0)
    }
  }

  -- Temporary package bridge for migrating compiler consumers before the
  -- public finite-count API changes domains.
  pub(package) fn migration_len_usize(self) -> usize {
    self.len()
  }

  --- Return whether the sequence contains no bytes.
  pub fn is_empty(self) -> bool {
    self.len() == 0
  }

  --- Copy the half-open byte range, or return `None` for invalid bounds.
  pub fn slice(self, start: usize, end: usize) -> Option<Bytes> {
    let first = start.to_u64().to_i64_checked().unwrap_or(0 - 1)
    let last = end.to_u64().to_i64_checked().unwrap_or(0 - 1)
    let length = self.len().to_u64().to_i64_checked().unwrap_or(0 - 1)
    if first < 0 or last < first or last > length {
      None<Bytes>()
    } else {
      Some<Bytes>(bytes_copy_range_in_bounds(self, first, last))
    }
  }

  --- Return the byte at `index`, or `None` when out of bounds.
  pub fn get(self, index: usize) -> Option<u8> {
    match index.to_u64().to_i64_checked() {
      Err(error) -> None<u8>()
      Ok(raw_index) -> match self {
        Bytes(storage) -> storage.get(raw_index)
      }
    }
  }

  -- Temporary package bridge paired with `migration_len_usize`.
  pub(package) fn migration_get_usize(self, index: usize) -> Option<u8> {
    self.get(index)
  }

  --- Return the first index of `needle`, or `None` when absent.
  pub fn find(self, needle: u8) -> Option<usize> {
    match self {
      Bytes(storage) -> {
        let n = storage.len()
        let mut i = 0
        let mut found: Option<usize> = None<usize>()
        while found.is_none() and i < n {
          if storage.get(i).unwrap_or(0) == needle {
            found = Some<usize>(i.to_usize_checked().unwrap_or(0))
          } else {
            i = i + 1
          }
        }
        found
      }
    }
  }

  --- Copy the bytes into an independent mutable vector.
  pub fn to_vector(self) -> owned Vector<u8> {
    match self {
      Bytes(storage) -> {
        let mut out = vector.new<u8>()
        for i in 0..storage.len() {
          out.push(storage.get(i).unwrap_or(0))
        }
        out
      }
    }
  }

  --- Decode valid UTF-8, reporting the first invalid byte offset on failure.
  pub fn to_utf8(self) -> Result<str, Utf8Error> {
    let contiguous = self.to_vector()
    let n = contiguous.len()
    let src = vector_data<u8>(contiguous)
    let mut pos = 0
    let mut error: Option<usize> = None<usize>()
    while error.is_none() and pos < n {
      match utf8_decode_next_bytes(src, n, pos) {
        Utf8Malformed(offset) -> {
          error = Some<usize>(offset.to_usize_checked().unwrap_or(0))
        }
        Utf8Decoded(next, scalar) -> { pos = next }
      }
    }
    match error {
      None -> Ok<str, Utf8Error>(runtime_str_from_bytes_copy(src, n))
      Some(offset) -> Err<str, Utf8Error>(InvalidUtf8(offset))
    }
  }
}

-- Persistent byte construction is package-visible so incremental protocol
-- parsers can retain only their bounded unfinished prefix without exposing
-- the opaque storage representation.
pub(package) fn bytes_push(values: Bytes, value: u8) -> Bytes {
  match values {
    Bytes(storage) -> Bytes(storage.push(value))
  }
}

pub(package) fn bytes_concat(left: Bytes, right: Bytes) -> Bytes {
  match left {
    Bytes(storage) -> match right {
      Bytes(other) -> {
        let mut out = storage
        for index in 0..other.len() {
          out = out.push(other.get(index).unwrap_or(0))
        }
        Bytes(out)
      }
    }
  }
}

fn bytes_copy_range_in_bounds(values: Bytes, start: i64, end: i64) -> Bytes {
  match values {
    Bytes(storage) -> {
      let mut out = persistent_vector.new<u8>()
      let mut index = start
      while index < end {
        out = out.push(storage.get(index).unwrap_or(0))
        index = index + 1
      }
      Bytes(out)
    }
  }
}

fn bytes_same(left: Bytes, right: Bytes) -> bool {
  match left {
    Bytes(left_storage) -> match right {
      Bytes(right_storage) -> {
        let n = left_storage.len()
        if n != right_storage.len() {
          false
        } else {
          let mut same = true
          let mut i = 0
          while same and i < n {
            if left_storage.get(i).unwrap_or(0) != right_storage.get(i).unwrap_or(0) {
              same = false
            } else {
              i = i + 1
            }
          }
          same
        }
      }
    }
  }
}

impl Eq for Bytes {
  fn eq(self: Self, other: Self) -> bool {
    bytes_same(self, other)
  }
}
