-- stdlib/bytes.weft — immutable arbitrary byte sequences
--
-- Bytes uses contiguous immutable storage. The representation is shared with
-- the runtime's byte-addressed string storage, but stays opaque: arbitrary
-- bytes become `str` only through the validating `to_utf8` boundary. Unlike
-- Vector<u8>, a Bytes value cannot be mutated through an alias and can cross
-- Sendable boundaries. Mutable I/O buffers remain Vector<u8> plus scoped
-- [mut u8] borrows.

use runtime/string.{
  runtime_str_byte_at,
  runtime_str_concat,
  runtime_str_eq,
  runtime_str_len,
  runtime_str_slice_bytes,
  runtime_str_storage_from_vector,
  runtime_str_storage_from_vector_range,
  runtime_str_storage_push_byte,
  runtime_str_utf8_first_malformed
}
use runtime/vector_storage.{vector_storage_append_text_bytes}
use stdlib/eq.{Eq}
use stdlib/num
use stdlib/option.{Option, None, Some}
use stdlib/result.{Result, Err, Ok}
use stdlib/panic.{panic}
use stdlib/vector as vector
use stdlib/vector.{vector_len, vector_reserve}
use stdlib/vector/handles.{Vector}

--- An immutable, persistent sequence of arbitrary bytes.
pub type Bytes = opaque str

--- A failure to decode bytes as UTF-8 text.
pub type Utf8Error {
  --- Invalid UTF-8 beginning at the reported byte offset.
  InvalidUtf8(usize)
}

--- Construct an empty byte sequence.
pub fn empty() -> Bytes {
  Bytes("")
}

--- Copy a borrowed byte slice into immutable storage.
pub fn from_slice(values: [u8]) -> Bytes {
  let mut out = vector.new<u8>()
  for value in values {
    out.push(value)
  }
  from_vector(out)
}

-- Copying is intentional: later mutation of the source Vector cannot change
-- an immutable Bytes value.
--- Copy a mutable vector into independent immutable storage.
pub fn from_vector(values: borrow Vector<u8>) -> Bytes {
  Bytes(runtime_str_storage_from_vector(values))
}

--- Copy bytes `[start, end)` of a mutable vector into independent immutable
--- storage, or return `None` when the range lies outside the vector.
pub fn from_vector_range(values: borrow Vector<u8>, start: usize, end: usize) -> Option<Bytes> {
  if start > end { return None<Bytes>() }
  match (start.to_u64().to_i64_checked(), (end - start).to_u64().to_i64_checked()) {
    (Ok(first), Ok(count)) -> match runtime_str_storage_from_vector_range(values, first, count) {
      storage: str -> Some<Bytes>(Bytes(storage))
      nil -> None<Bytes>()
    }
    _ -> None<Bytes>()
  }
}

--- Copy the UTF-8 encoding of `text` into a byte sequence.
pub fn from_str(text: str) -> Bytes {
  Bytes(runtime_str_slice_bytes(text, 0, runtime_str_len(text)))
}

impl Bytes {
  --- Return the number of bytes as a platform-sized unsigned count.
  pub fn len(self) -> usize {
    match self {
      Bytes(storage) -> runtime_str_len(storage).to_usize_checked().unwrap_or(0)
    }
  }

  --- Return whether the sequence contains no bytes.
  pub fn is_empty(self) -> bool {
    self.len() == 0
  }

  --- Copy the half-open byte range, or return `None` for invalid bounds.
  pub fn slice(self, start: usize, end: usize) -> Option<Bytes> {
    let length = self.len()
    if start > end or end > length {
      None<Bytes>()
    } else {
      Some<Bytes>(bytes_copy_range_in_bounds(self, start, end))
    }
  }

  --- Return the byte at `index`, or `None` when out of bounds.
  pub fn get(self, index: usize) -> Option<u8> {
    match self {
      Bytes(storage) -> {
        let position = index.to_u64().to_i64_checked().unwrap_or(0 - 1)
        if position < 0 or position >= runtime_str_len(storage) {
          None<u8>()
        } else {
          Some<u8>(runtime_str_byte_at(storage, position).to_u8_checked().unwrap_or(0))
        }
      }
    }
  }

  --- Return the first index of `needle`, or `None` when absent.
  pub fn find(self, needle: u8) -> Option<usize> {
    match self {
      Bytes(storage) -> {
        let n = runtime_str_len(storage)
        let mut i = 0
        let mut found: Option<usize> = None<usize>()
        while found.is_none() and i < n {
          if runtime_str_byte_at(storage, i).to_u8_checked().unwrap_or(0) == needle {
            found = Some<usize>(i.to_usize_checked().unwrap_or(0))
          } else {
            i = i + 1
          }
        }
        found
      }
    }
  }

  --- Copy the bytes into an independent mutable vector.
  pub fn to_vector(self) -> owned Vector<u8> {
    let out = vector.with_capacity<u8>(self.len())
    self.append_to(out)
    out
  }

  --- Append the bytes to the end of `out` in one copy.
  pub fn append_to(self, out: borrow Vector<u8>) -> nil {
    match self {
      Bytes(storage) -> {
        let length = runtime_str_len(storage)
        if not vector_reserve<u8>(out, vector_len<u8>(out) + length) {
          panic("Byte vector capacity is too large")
        }
        if not vector_storage_append_text_bytes(out, storage, 0, length) {
          panic("Byte vector capacity invariant violated")
        }
        nil
      }
    }
  }

  --- Decode valid UTF-8, reporting the first invalid byte offset on failure.
  pub fn to_utf8(self) -> Result<str, Utf8Error> {
    match self {
      Bytes(storage) -> match runtime_str_utf8_first_malformed(storage) {
        offset if offset < 0 -> Ok<str, Utf8Error>(storage)
        offset -> Err<str, Utf8Error>(InvalidUtf8(offset.to_usize_checked().unwrap_or(0)))
      }
    }
  }
}

-- Byte construction is package-visible so incremental protocol
-- parsers can retain only their bounded unfinished prefix without exposing
-- the opaque storage representation.
-- Immutable storage — compiler-owned static product data, or storage a
-- trusted runtime leaf has just produced and no longer references — wraps
-- without copying. This is package-private so arbitrary bytes cannot be
-- surfaced as a public `str`.
pub(package) fn bytes_from_storage(storage: str) -> Bytes {
  Bytes(storage)
}

-- Trusted compiler and protocol code may retain the opaque byte storage while
-- preserving its length. Ordinary packages cannot observe it as `str`.
pub(package) fn bytes_storage(values: Bytes) -> str {
  match values {
    Bytes(storage) -> storage
  }
}

pub(package) fn bytes_push(values: Bytes, value: u8) -> Bytes {
  match values {
    Bytes(storage) -> Bytes(runtime_str_storage_push_byte(storage, value))
  }
}

pub(package) fn bytes_concat(left: Bytes, right: Bytes) -> Bytes {
  match left {
    Bytes(storage) -> match right {
      Bytes(other) -> Bytes(runtime_str_concat(storage, other))
    }
  }
}

fn bytes_copy_range_in_bounds(values: Bytes, start: usize, end: usize) -> Bytes {
  match values {
    Bytes(storage) -> {
      let first = start.to_u64().to_i64_checked().unwrap_or(0)
      let last = end.to_u64().to_i64_checked().unwrap_or(first)
      Bytes(runtime_str_slice_bytes(storage, first, last - first))
    }
  }
}

fn bytes_same(left: Bytes, right: Bytes) -> bool {
  match left {
    Bytes(left_storage) -> match right {
      Bytes(right_storage) -> runtime_str_eq(left_storage, right_storage) == 1
    }
  }
}

impl Eq for Bytes {
  fn eq(self: Self, other: Self) -> bool {
    bytes_same(self, other)
  }
}
