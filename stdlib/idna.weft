-- stdlib/idna.weft — canonical international domain-name identity
--
-- DomainName is the shared semantic value for DNS, URL hosts, and certificate
-- matching. Construction applies the pinned strict Unicode 17 UTS #46
-- nontransitional ToASCII profile; consumers never reinterpret source text.

use compiler/weft/unicode/normalization_data.{unicode_canonical_combining_class}
use runtime/string.{
  runtime_str_byte_at,
  runtime_str_eq,
  runtime_str_from_utf8_vector,
  runtime_str_len,
  runtime_str_utf8_decode
}
use runtime/utf8.{Utf8StorageScalar, Utf8StorageMalformed}
use stdlib/display.{Display}
use stdlib/eq.{Eq}
use stdlib/panic.{panic}
use stdlib/result.{Result, Err, Ok}
use stdlib/string.{str_concat}
use stdlib/unicode as unicode
use stdlib/unicode/data/idna.{*}
use stdlib/unicode/data/property.{unicode_general_category_code}
use stdlib/utf8.{utf8_scalar_vector_text}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_set}
use stdlib/vector/handles.{Vector}

--- A canonical international domain name under Weft's Unicode 17 profile.
---
--- The hidden string contains lowercase ASCII labels without a trailing dot;
--- the second lane records whether the source named the absolute DNS root.
pub type DomainName = opaque(str, bool)

--- A typed failure to construct canonical domain identity.
---
--- Every constructor carries the zero-based source byte offset followed by
--- the zero-based label index.
pub type IdnaError {
  --- The source was empty or contained an empty label.
  IdnaEmptyLabel(i64, i64),
  --- A forged string violated Weft's valid UTF-8 invariant.
  IdnaInvalidUtf8(i64, i64),
  --- UTS #46 or strict STD3 rules disallow a source scalar.
  IdnaDisallowed(i64, i64),
  --- A label violated the leading, trailing, or third/fourth hyphen rule.
  IdnaHyphen(i64, i64),
  --- An `xn--` label was not a canonical non-ASCII Punycode label.
  IdnaInvalidPunycode(i64, i64),
  --- A label began with a Unicode combining mark.
  IdnaLeadingCombiningMark(i64, i64),
  --- A join control violated the IDNA ContextJ rule.
  IdnaJoinerContext(i64, i64),
  --- A bidirectional label violated RFC 5893's domain-wide rules.
  IdnaBidi(i64, i64),
  --- A canonical ASCII label exceeded 63 octets.
  IdnaLabelTooLong(i64, i64),
  --- The canonical name exceeded 253 octets without its root marker.
  IdnaNameTooLong(i64, i64)
}

fn idna_domain_text(value: DomainName) -> str {
  match value { DomainName(parts) -> match parts { (text, absolute) -> text } }
}

fn idna_domain_absolute(value: DomainName) -> bool {
  match value { DomainName(parts) -> match parts { (text, absolute) -> absolute } }
}

impl DomainName {
  --- Return canonical lowercase ASCII A-label text without a trailing root dot.
  pub fn ascii(self) -> str { idna_domain_text(self) }

  --- Return whether the source explicitly named the absolute DNS root.
  pub fn is_absolute(self) -> bool { idna_domain_absolute(self) }
}

impl Eq for DomainName {
  fn eq(self: Self, other: Self) -> bool {
    match self {
      DomainName(left_parts) -> match left_parts {
        (left_text, left_absolute) -> match other {
          DomainName(right_parts) -> match right_parts {
            (right_text, right_absolute) ->
              runtime_str_eq(left_text, right_text) == 1 and left_absolute == right_absolute
          }
        }
      }
    }
  }
}

impl Display for DomainName {
  fn display(self: Self) -> str {
    match self {
      DomainName(parts) -> match parts {
        (text, absolute) -> if absolute { str_concat(text, ".") } else { text }
      }
    }
  }
}

-- Each processing stage records the first failure at its source byte offset
-- and label index; `nil` means the stage succeeded.
type IdnaFailure = IdnaError?

fn idna_get(values: borrow Vector<i64>, index: i64) -> i64 {
  vector_get_in_bounds<i64>(values, index)
}

fn idna_scalar_range_text(scalars: borrow Vector<i64>, start: i64, end: i64) -> str {
  let mut range = vector.with_capacity<i64>(__i64_to_usize(end - start))
  for index in start..end { range.push(idna_get(scalars, index)) }
  utf8_scalar_vector_text(range)
}

-- Map source scalars and retain one original byte offset per resulting label.
fn idna_map_source(
  source: str,
  mapped: borrow mut Vector<i64>,
  label_offsets: borrow mut Vector<i64>
) -> IdnaFailure {
  let n = runtime_str_len(source)
  let mut source_pos = 0
  let mut label = 0
  let mut failure: IdnaFailure = nil
  label_offsets.push(0)
  while source_pos < n and failure == nil {
    match runtime_str_utf8_decode(source, source_pos) {
      Utf8StorageMalformed(offset) -> { failure = IdnaInvalidUtf8(offset, label) }
      Utf8StorageScalar(next_pos, scalar) -> {
        let base = vector_len<i64>(mapped)
        if not unicode_idna_map_push(scalar, mapped) {
          failure = IdnaDisallowed(source_pos, label)
        } else {
          for index in base..vector_len<i64>(mapped) {
            if idna_get(mapped, index) == 46 {
              label = label + 1
              label_offsets.push(next_pos)
            } else { nil }
          }
          source_pos = next_pos
        }
      }
    }
  }
  failure
}

-- Split normalized text at dots into scalars and per-label scalar ranges.
fn idna_decode_text(
  text: str,
  scalars: borrow mut Vector<i64>,
  starts: borrow mut Vector<i64>,
  ends: borrow mut Vector<i64>
) -> IdnaFailure {
  let n = runtime_str_len(text)
  let mut pos = 0
  let mut label = 0
  let mut failure: IdnaFailure = nil
  starts.push(0)
  while pos < n and failure == nil {
    match runtime_str_utf8_decode(text, pos) {
      Utf8StorageMalformed(offset) -> { failure = IdnaInvalidUtf8(offset, label) }
      Utf8StorageScalar(next, scalar) -> {
        if scalar == 46 {
          ends.push(vector_len<i64>(scalars))
          label = label + 1
          starts.push(vector_len<i64>(scalars))
        } else { scalars.push(scalar) }
        pos = next
      }
    }
  }
  ends.push(vector_len<i64>(scalars))
  failure
}

fn idna_ascii_lower(byte: i64) -> i64 {
  if byte >= 65 and byte <= 90 { byte + 32 } else { byte }
}

fn idna_is_alabel(scalars: borrow Vector<i64>, start: i64, end: i64) -> bool {
  end - start >= 4 and idna_ascii_lower(idna_get(scalars, start)) == 120 and
    idna_ascii_lower(idna_get(scalars, start + 1)) == 110 and idna_get(scalars, start + 2) ==
    45 and
    idna_get(scalars, start + 3) == 45
}

fn idna_puny_digit(scalar: i64) -> i64 {
  let byte = idna_ascii_lower(scalar)
  if byte >= 97 and byte <= 122 { byte - 97 }
  else { if byte >= 48 and byte <= 57 { byte - 22 } else { 0 - 1 } }
}

fn idna_puny_byte(digit: i64) -> u8 {
  __i64_to_u8(if digit < 26 { 97 + digit } else { 22 + digit })
}

fn idna_puny_adapt(delta: i64, points: i64, first: bool) -> i64 {
  let mut value = if first { delta / 700 } else { delta / 2 }
  value = value + value / points
  let mut k = 0
  while value > 455 {
    value = value / 35
    k = k + 36
  }
  k + (36 * value) / (value + 38)
}

-- Decode the Punycode payload `input[start, end)`, appending its scalars to
-- `out`. Return the decoded count, or -1 for a syntax or arithmetic failure.
fn idna_puny_decode(
  input: borrow Vector<i64>,
  start: i64,
  end: i64,
  out: borrow mut Vector<i64>
) -> i64 {
  let base = vector_len<i64>(out)
  let mut delimiter = 0 - 1
  let mut syntax_ok = true
  for scan in start..end {
    let scalar = idna_get(input, scan)
    if scalar >= 128 { syntax_ok = false } else if scalar == 45 { delimiter = scan } else { nil }
  }
  let basic_end = if delimiter >= start { delimiter } else { start }
  let mut out_count = 0
  let mut scan = start
  while scan < basic_end and syntax_ok {
    out.push(idna_get(input, scan))
    out_count = out_count + 1
    scan = scan + 1
  }
  let mut index = if delimiter >= start { delimiter + 1 } else { start }
  let mut n = 128
  let mut i = 0
  let mut bias = 72
  let mut first_delta = true
  while index < end and syntax_ok {
    let old_i = i
    let mut weight = 1
    let mut k = 36
    let mut done = false
    while not done and syntax_ok {
      if index >= end { syntax_ok = false }
      else {
        let digit = idna_puny_digit(idna_get(input, index))
        index = index + 1
        if digit < 0 or digit > (2147483647 - i) / weight { syntax_ok = false }
        else {
          i = i + digit * weight
          let threshold = if k <= bias { 1 } else { if k >= bias + 26 { 26 } else { k - bias } }
          if digit < threshold { done = true }
          else {
            let digit_base = 36 - threshold
            if weight > 2147483647 / digit_base { syntax_ok = false }
            else {
              weight = weight * digit_base
              k = k + 36
            }
          }
        }
      }
    }
    if syntax_ok {
      let points = out_count + 1
      bias = idna_puny_adapt(i - old_i, points, first_delta)
      first_delta = false
      if i / points > 1114111 - n { syntax_ok = false }
      else {
        n = n + i / points
        i = i - (i / points) * points
        if n > 1114111 or n >= 55296 and n <= 57343 { syntax_ok = false }
        else {
          -- Insert `n` at decoded position `i`, shifting the tail right.
          out.push(0)
          let mut move = out_count
          while move > i {
            vector_set<i64>(out, base + move, idna_get(out, base + move - 1))
            move = move - 1
          }
          vector_set<i64>(out, base + i, n)
          out_count = out_count + 1
          i = i + 1
        }
      }
    }
  }
  if syntax_ok { out_count } else { 0 - 1 }
}

-- Decode A-labels into the shared U-label scalars and retain label metadata.
fn idna_prepare_labels(
  input: borrow Vector<i64>,
  starts: borrow Vector<i64>,
  ends: borrow Vector<i64>,
  label_count: i64,
  source_offsets: borrow Vector<i64>,
  u: borrow mut Vector<i64>,
  u_starts: borrow mut Vector<i64>,
  u_ends: borrow mut Vector<i64>,
  alabels: borrow mut Vector<bool>
) -> IdnaFailure {
  let mut label = 0
  let mut failure: IdnaFailure = nil
  while label < label_count and failure == nil {
    let start = idna_get(starts, label)
    let end = idna_get(ends, label)
    let source_offset = idna_get(source_offsets, label)
    u_starts.push(vector_len<i64>(u))
    if start == end {
      alabels.push(false)
      failure = IdnaEmptyLabel(source_offset, label)
    } else {
      let is_alabel = idna_is_alabel(input, start, end)
      alabels.push(is_alabel)
      if is_alabel {
        let u_start = vector_len<i64>(u)
        let decoded = idna_puny_decode(input, start + 4, end, u)
        if decoded <= 0 { failure = IdnaInvalidPunycode(source_offset, label) }
        else {
          let mut has_non_ascii = false
          for index in u_start..(u_start + decoded) {
            if idna_get(u, index) >= 128 { has_non_ascii = true } else { nil }
          }
          if not has_non_ascii or
            not idna_scalar_range_text(u, u_start, u_start + decoded).is_normalized_nfc() {
              failure = IdnaInvalidPunycode(source_offset, label)
            } else { nil }
        }
      } else {
        for index in start..end { u.push(idna_get(input, index)) }
      }
    }
    u_ends.push(vector_len<i64>(u))
    label = label + 1
  }
  failure
}

fn idna_is_std3_scalar(scalar: i64) -> bool {
  scalar >= 97 and scalar <= 122 or scalar >= 48 and scalar <= 57 or scalar == 45 or scalar >= 128
}

fn idna_is_mark(scalar: i64) -> bool {
  let category = unicode_general_category_code(scalar)
  category == 10 or category == 11 or category == 12
}

fn idna_contextj_ok(scalars: borrow Vector<i64>, start: i64, end: i64, index: i64) -> bool {
  let scalar = idna_get(scalars, index)
  if scalar == 8205 {
    index > start and unicode_canonical_combining_class(idna_get(scalars, index - 1)) == 9
  } else if scalar == 8204 {
    if index > start and unicode_canonical_combining_class(idna_get(scalars, index - 1)) == 9 {
      true
    } else {
      let transparent = unicode_idna_joining_transparent()
      let mut before = index - 1
      while before >= start and unicode_idna_joining_code(idna_get(scalars, before)) ==
        transparent {
          before = before - 1
        }
      let mut after = index + 1
      while after < end and unicode_idna_joining_code(idna_get(scalars, after)) == transparent {
        after = after + 1
      }
      if before < start or after >= end { false }
      else {
        let left = unicode_idna_joining_code(idna_get(scalars, before))
        let right = unicode_idna_joining_code(idna_get(scalars, after))
        (
          left == unicode_idna_joining_left_joining() or left ==
            unicode_idna_joining_dual_joining()
        ) and
          (
            right == unicode_idna_joining_right_joining() or right ==
              unicode_idna_joining_dual_joining()
          )
      }
    }
  } else { true }
}

fn idna_domain_has_rtl(scalars: borrow Vector<i64>) -> bool {
  let mut rtl = false
  let mut i = 0
  let count = vector_len<i64>(scalars)
  while i < count and not rtl {
    let code = unicode_idna_bidi_code(idna_get(scalars, i))
    if code == unicode_idna_bidi_right_to_left() or code == unicode_idna_bidi_arabic_letter() or
      code == unicode_idna_bidi_arabic_number() {
        rtl = true
      } else { i = i + 1 }
  }
  rtl
}

fn idna_bidi_ltr_allowed(code: i64) -> bool {
  code == unicode_idna_bidi_left_to_right() or code == unicode_idna_bidi_european_number() or
    code == unicode_idna_bidi_european_separator() or code == unicode_idna_bidi_common_separator() or
    code == unicode_idna_bidi_european_terminator() or code == unicode_idna_bidi_other_neutral() or
    code == unicode_idna_bidi_boundary_neutral() or code == unicode_idna_bidi_nonspacing_mark()
}

fn idna_bidi_rtl_allowed(code: i64) -> bool {
  code == unicode_idna_bidi_right_to_left() or code == unicode_idna_bidi_arabic_letter() or
    code == unicode_idna_bidi_arabic_number() or code == unicode_idna_bidi_european_number() or
    code == unicode_idna_bidi_european_separator() or code == unicode_idna_bidi_common_separator() or
    code == unicode_idna_bidi_european_terminator() or code == unicode_idna_bidi_other_neutral() or
    code == unicode_idna_bidi_boundary_neutral() or code == unicode_idna_bidi_nonspacing_mark()
}

fn idna_bidi_label_ok(scalars: borrow Vector<i64>, start: i64, end: i64) -> bool {
  let first = unicode_idna_bidi_code(idna_get(scalars, start))
  let rtl = first == unicode_idna_bidi_right_to_left() or first ==
    unicode_idna_bidi_arabic_letter()
  let ltr = first == unicode_idna_bidi_left_to_right()
  let mut ok = rtl or ltr
  let mut has_en = false
  let mut has_an = false
  let mut i = start
  while i < end and ok {
    let code = unicode_idna_bidi_code(idna_get(scalars, i))
    if code == unicode_idna_bidi_european_number() { has_en = true } else { nil }
    if code == unicode_idna_bidi_arabic_number() { has_an = true } else { nil }
    ok = if rtl { idna_bidi_rtl_allowed(code) } else { idna_bidi_ltr_allowed(code) }
    i = i + 1
  }
  let mut last = end - 1
  while last > start and unicode_idna_bidi_code(idna_get(scalars, last)) ==
    unicode_idna_bidi_nonspacing_mark() {
      last = last - 1
    }
  let last_code = unicode_idna_bidi_code(idna_get(scalars, last))
  if rtl {
    let last_ok = last_code == unicode_idna_bidi_right_to_left() or last_code ==
      unicode_idna_bidi_arabic_letter() or last_code == unicode_idna_bidi_european_number() or
      last_code == unicode_idna_bidi_arabic_number()
    ok and last_ok and not (has_en and has_an)
  } else {
    ok and (
      last_code == unicode_idna_bidi_left_to_right() or last_code ==
        unicode_idna_bidi_european_number()
    )
  }
}

-- A U-label scalar is valid only when strict STD3 admits it and UTS #46 maps
-- it to itself.
fn idna_scalar_is_valid(scalar: i64, scratch: borrow mut Vector<i64>) -> bool {
  scratch.clear()
  idna_is_std3_scalar(scalar) and unicode_idna_map_push(scalar, scratch) and
    vector_len<i64>(scratch) == 1 and idna_get(scratch, 0) == scalar
}

fn idna_validate_label(
  scalars: borrow Vector<i64>,
  start: i64,
  end: i64,
  domain_bidi: bool,
  offset: i64,
  label: i64
) -> IdnaFailure {
  if start >= end { IdnaEmptyLabel(offset, label) }
  else {
    let first = idna_get(scalars, start)
    let last = idna_get(scalars, end - 1)
    if first == 45 or last == 45 or end - start >= 4 and idna_get(scalars, start + 2) == 45 and
      idna_get(scalars, start + 3) == 45 {
        IdnaHyphen(offset, label)
      } else if idna_is_mark(first) { IdnaLeadingCombiningMark(offset, label) }
    else {
      let mut scratch = vector.new<i64>()
      let mut failure: IdnaFailure = nil
      let mut i = start
      while i < end and failure == nil {
        let scalar = idna_get(scalars, i)
        if not idna_scalar_is_valid(scalar, scratch) { failure = IdnaDisallowed(offset, label) }
        else if (scalar == 8204 or scalar == 8205) and not idna_contextj_ok(
          scalars,
          start,
          end,
          i
        ) {
          failure = IdnaJoinerContext(offset, label)
        } else { nil }
        i = i + 1
      }
      if failure == nil and domain_bidi and not idna_bidi_label_ok(scalars, start, end) {
        IdnaBidi(offset, label)
      } else { failure }
    }
  }
}

fn idna_validate_labels(
  scalars: borrow Vector<i64>,
  starts: borrow Vector<i64>,
  ends: borrow Vector<i64>,
  label_count: i64,
  source_offsets: borrow Vector<i64>
) -> IdnaFailure {
  let domain_bidi = idna_domain_has_rtl(scalars)
  let mut failure: IdnaFailure = nil
  let mut label = 0
  while label < label_count and failure == nil {
    failure = idna_validate_label(
      scalars,
      idna_get(starts, label),
      idna_get(ends, label),
      domain_bidi,
      idna_get(source_offsets, label),
      label
    )
    label = label + 1
  }
  failure
}

-- Append the Punycode encoding of `scalars[start, end)` to `out`, reporting
-- whether its arithmetic stayed within range.
fn idna_puny_encode(
  scalars: borrow Vector<i64>,
  start: i64,
  end: i64,
  out: borrow mut Vector<u8>
) -> bool {
  let mut basic = 0
  for i in start..end {
    let scalar = idna_get(scalars, i)
    if scalar < 128 {
      out.push(__i64_to_u8(scalar))
      basic = basic + 1
    } else { nil }
  }
  let count = end - start
  let mut handled = basic
  if basic > 0 and handled < count { out.push(__i64_to_u8(45)) } else { nil }
  let mut n = 128
  let mut delta = 0
  let mut bias = 72
  let mut ok = true
  while handled < count and ok {
    let mut minimum = 1114112
    for i in start..end {
      let scalar = idna_get(scalars, i)
      if scalar >= n and scalar < minimum { minimum = scalar } else { nil }
    }
    if minimum > 1114111 or minimum - n > (2147483647 - delta) / (handled + 1) { ok = false }
    else {
      delta = delta + (minimum - n) * (handled + 1)
      n = minimum
      let mut i = start
      while i < end and ok {
        let scalar = idna_get(scalars, i)
        if scalar < n {
          if delta == 2147483647 { ok = false } else { delta = delta + 1 }
        } else if scalar == n {
          let mut q = delta
          let mut k = 36
          let mut done = false
          while not done {
            let threshold = if k <= bias { 1 } else { if k >= bias + 26 { 26 } else { k - bias } }
            if q < threshold {
              out.push(idna_puny_byte(q))
              done = true
            } else {
              out.push(
                idna_puny_byte(
                  threshold + (q - threshold) - ((q - threshold) / (36 - threshold)) * (
                    36 - threshold
                  )
                )
              )
              q = (q - threshold) / (36 - threshold)
              k = k + 36
            }
          }
          bias = idna_puny_adapt(delta, handled + 1, handled == basic)
          delta = 0
          handled = handled + 1
        } else { nil }
        i = i + 1
      }
      delta = delta + 1
      n = n + 1
    }
  }
  ok
}

fn idna_ascii_matches_scalars(
  out: borrow Vector<u8>,
  out_start: i64,
  out_end: i64,
  input: borrow Vector<i64>,
  start: i64,
  end: i64
) -> bool {
  if out_end - out_start != end - start { false }
  else {
    let mut i = 0
    let mut same = true
    while i < end - start and same {
      let byte = __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(out, out_start + i)))
      if byte != idna_get(input, start + i) { same = false } else { i = i + 1 }
    }
    same
  }
}

fn idna_emit_name(
  input: borrow Vector<i64>,
  input_starts: borrow Vector<i64>,
  input_ends: borrow Vector<i64>,
  scalars: borrow Vector<i64>,
  starts: borrow Vector<i64>,
  ends: borrow Vector<i64>,
  alabels: borrow Vector<bool>,
  label_count: i64,
  source_offsets: borrow Vector<i64>,
  out: borrow mut Vector<u8>
) -> IdnaFailure {
  let mut label = 0
  let mut failure: IdnaFailure = nil
  while label < label_count and failure == nil {
    if label > 0 { out.push(__i64_to_u8(46)) } else { nil }
    let label_out_start = vector_len<u8>(out)
    let start = idna_get(starts, label)
    let end = idna_get(ends, label)
    let source_offset = idna_get(source_offsets, label)
    let mut non_ascii = false
    for i in start..end {
      if idna_get(scalars, i) >= 128 { non_ascii = true } else { nil }
    }
    if not non_ascii {
      for i in start..end { out.push(__i64_to_u8(idna_get(scalars, i))) }
    } else {
      out.push(__i64_to_u8(120))
      out.push(__i64_to_u8(110))
      out.push(__i64_to_u8(45))
      out.push(__i64_to_u8(45))
      if not idna_puny_encode(scalars, start, end, out) {
        failure = IdnaInvalidPunycode(source_offset, label)
      } else { nil }
    }
    if failure == nil {
      let label_end = vector_len<u8>(out)
      if label_end - label_out_start > 63 { failure = IdnaLabelTooLong(source_offset, label) }
      else if vector_get_in_bounds<bool>(alabels, label) and not idna_ascii_matches_scalars(
        out,
        label_out_start,
        label_end,
        input,
        idna_get(input_starts, label),
        idna_get(input_ends, label)
      ) {
        failure = IdnaInvalidPunycode(source_offset, label)
      } else { nil }
    } else { nil }
    label = label + 1
  }
  failure
}

--- Construct canonical domain identity using Unicode 17 UTS #46 ToASCII.
---
--- Processing is nontransitional and enables strict STD3, hyphen, Bidi,
--- ContextJ, and DNS-length checks. One trailing root dot is retained as
--- semantic state; it is not part of `DomainName.ascii()`.
pub fn parse(source: str) -> Result<DomainName, IdnaError> {
  let n = runtime_str_len(source)
  let mut mapped = vector.new<i64>()
  let mut source_offsets = vector.new<i64>()
  let mut failure = idna_map_source(source, mapped, source_offsets)
  let normalized = if failure == nil { utf8_scalar_vector_text(mapped).normalize_nfc() } else {
    ""
  }
  let mut input = vector.new<i64>()
  let mut input_starts = vector.new<i64>()
  let mut input_ends = vector.new<i64>()
  if failure == nil { failure = idna_decode_text(normalized, input, input_starts, input_ends) }
  else { nil }
  let mut label_count = vector_len<i64>(input_starts)
  let normalized_len = runtime_str_len(normalized)
  let absolute = normalized_len > 0 and runtime_str_byte_at(normalized, normalized_len - 1) == 46
  -- Dots are removed while decoding, so a final dot appears as a final empty label.
  if failure == nil and label_count > 1 and idna_get(input_starts, label_count - 1) ==
    idna_get(input_ends, label_count - 1) {
      label_count = label_count - 1
    } else { nil }
  if failure == nil and (n == 0 or label_count <= 0) { failure = IdnaEmptyLabel(0, 0) } else {
    nil
  }
  let mut u = vector.new<i64>()
  let mut u_starts = vector.new<i64>()
  let mut u_ends = vector.new<i64>()
  let mut alabels = vector.new<bool>()
  if failure == nil {
    failure = idna_prepare_labels(
      input,
      input_starts,
      input_ends,
      label_count,
      source_offsets,
      u,
      u_starts,
      u_ends,
      alabels
    )
  } else { nil }
  if failure == nil {
    failure = idna_validate_labels(u, u_starts, u_ends, label_count, source_offsets)
  } else { nil }
  let mut ascii = vector.new<u8>()
  if failure == nil {
    failure = idna_emit_name(
      input,
      input_starts,
      input_ends,
      u,
      u_starts,
      u_ends,
      alabels,
      label_count,
      source_offsets,
      ascii
    )
  } else { nil }
  if failure == nil and vector_len<u8>(ascii) > 253 {
    failure = IdnaNameTooLong(n, label_count - 1)
  } else { nil }
  match failure {
    nil -> match runtime_str_from_utf8_vector(ascii) {
      nil -> panic("IDNA emitted a non-ASCII name")
      text: str -> Ok<DomainName, IdnaError>(DomainName((text, absolute)))
    }
    error: IdnaError -> Err<DomainName, IdnaError>(error)
  }
}
