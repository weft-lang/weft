-- Compile-time evaluation observations over ordinary effectful Weft code.

use stdlib/comptime/file_observer as file_observer
pub use stdlib/comptime/types.{ComptimeEvaluation, ComptimeFileObservation, ComptimeFileObservations}
use stdlib/file.{FileRead}

--- Evaluate `body` while recording and forwarding every bounded file read.
---
--- `FileRead` remains in the result effect set because this handler observes
--- authority supplied by its caller; it does not grant filesystem access.
--- Every unrelated effect in `E` passes through unchanged.
pub fn observe_file_reads<T, E>(body: () -[FileRead, E]> T) -[FileRead, E]> ComptimeEvaluation<T> {
  let observer = file_observer.observer()
  let value = with file_observer(observer) { body() }
  ComptimeEvaluation {
    value: value,
    file_observations: file_observer.observations(observer)
  }
}
