-- stdlib/unicode/security.weft — UTS #39 security fact producers
--
-- Kept separate from the wider public Unicode surface so compiler identifier
-- diagnostics consume the same pinned algorithms without importing casing,
-- segmentation or compatibility-normalization tables.

use compiler/unicode_identifier_data.{unicode_default_ignorable}
use compiler/unicode_normalization_data.{unicode_canonical_decompose_into, unicode_canonical_order}
use compiler/unicode_security_data.{*}
use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment, alloc_words}
use runtime/memory.{mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_eq, runtime_str_len, runtime_str_ptr}
use stdlib/utf8.{Utf8Decoded, Utf8Malformed, utf8_decode_next_bytes, utf8_encode_scalar_into, utf8_scalar_encoded_len}

-- UAX #9 explicit embedding, override and isolate controls. Directional marks
-- (LRM/RLM/ALM) do not open formatting state and are deliberately excluded.
pub(package) fn unicode_security_is_directional_formatting(scalar: i64) -> i64 {
  if scalar >= 8234 and scalar <= 8238 { 1 }
  else { if scalar >= 8294 and scalar <= 8297 { 1 } else { 0 } }
}

pub(package) fn unicode_security_is_mixed_script_bytes(src: i64, start: i64, len: i64) -> i64 {
  let end = start + len
  let mut resolved_0 = unicode_security_script_all_0()
  let mut resolved_1 = unicode_security_script_all_1()
  let mut resolved_2 = unicode_security_script_all_2()
  let mut pos = start
  let mut valid = 1
  while pos < end and valid == 1 {
    match utf8_decode_next_bytes(src, end, pos) {
      Utf8Malformed(offset) -> { valid = 0 }
      Utf8Decoded(next, scalar) -> {
        resolved_0 = resolved_0 band unicode_security_script_mask_0(scalar)
        resolved_1 = resolved_1 band unicode_security_script_mask_1(scalar)
        resolved_2 = resolved_2 band unicode_security_script_mask_2(scalar)
        pos = next
      }
    }
  }
  if valid == 1 and pos == end and (resolved_0 bor resolved_1 bor resolved_2) == 0 { 1 } else { 0 }
}

pub(package) fn unicode_security_skeleton_bytes(src: i64, start: i64, len: i64) -> str {
  let mark = alloc_bump_mark()
  let end = start + len
  let decomposed = alloc_words(len * 4 + 4)
  let mut decomposed_count = 0
  let mut pos = start
  let mut valid = 1
  while pos < end and valid == 1 {
    match utf8_decode_next_bytes(src, end, pos) {
      Utf8Malformed(offset) -> { valid = 0 }
      Utf8Decoded(next, scalar) -> {
        decomposed_count = unicode_canonical_decompose_into(
          scalar, decomposed, decomposed_count
        )
        pos = next
      }
    }
  }
  if valid == 0 or pos != end {
    alloc_bump_restore_same_segment(mark)
    ""
  } else {
    unicode_canonical_order(decomposed, decomposed_count)
    let mapped = alloc_words(decomposed_count * unicode_confusable_max_expansion() + 4)
    let mut mapped_count = 0
    let mut i = 0
    while i < decomposed_count {
      let scalar = mem_load64_at(decomposed, i * 8)
      if unicode_default_ignorable(scalar) == 0 {
        let next = unicode_confusable_map_into(scalar, mapped, mapped_count)
        if next < 0 {
          mem_store64_at(mapped, mapped_count * 8, scalar)
          mapped_count = mapped_count + 1
        } else { mapped_count = next }
      } else { 0 }
      i = i + 1
    }
    unicode_canonical_order(mapped, mapped_count)

    let mut out_len = 0
    i = 0
    while i < mapped_count {
      out_len = out_len + utf8_scalar_encoded_len(mem_load64_at(mapped, i * 8))
      i = i + 1
    }
    let out = runtime_str_alloc_uninit(out_len)
    let out_ptr = runtime_str_ptr(out)
    let mut out_pos = 0
    i = 0
    while i < mapped_count {
      out_pos = utf8_encode_scalar_into(out_ptr, out_pos, mem_load64_at(mapped, i * 8))
      i = i + 1
    }
    alloc_bump_restore_same_segment(mark)
    out
  }
}

pub(package) fn unicode_security_is_mixed_script(text: str) -> i64 {
  unicode_security_is_mixed_script_bytes(runtime_str_ptr(text), 0, runtime_str_len(text))
}

pub(package) fn unicode_security_skeleton(text: str) -> str {
  unicode_security_skeleton_bytes(runtime_str_ptr(text), 0, runtime_str_len(text))
}

pub(package) fn unicode_security_are_confusable(a: str, b: str) -> i64 {
  runtime_str_eq(unicode_security_skeleton(a), unicode_security_skeleton(b))
}
