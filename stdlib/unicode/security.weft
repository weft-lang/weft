-- stdlib/unicode/security.weft — UTS #39 security fact producers
--
-- Kept separate from the wider public Unicode surface so compiler identifier
-- diagnostics consume the same pinned algorithms without importing casing,
-- segmentation or compatibility-normalization tables.

use compiler/weft/unicode/identifier_data.{unicode_default_ignorable}
use compiler/weft/unicode/normalization_data.{
  unicode_canonical_decompose_push,
  unicode_canonical_order
}
use compiler/weft/unicode/security_data.{*}
use runtime/string.{runtime_str_eq, runtime_str_len, runtime_str_utf8_decode}
use runtime/utf8.{Utf8StorageScalar, Utf8StorageMalformed}
use stdlib/utf8.{utf8_scalar_vector_text}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len}
use stdlib/vector/handles.{Vector}

-- UAX #9 explicit embedding, override and isolate controls. Directional marks
-- (LRM/RLM/ALM) do not open formatting state and are deliberately excluded.
pub(package) fn unicode_security_is_directional_formatting(scalar: i64) -> i64 {
  if scalar >= 8234 and scalar <= 8238 { 1 }
  else { if scalar >= 8294 and scalar <= 8297 { 1 } else { 0 } }
}

pub(package) fn unicode_security_is_mixed_script(text: str) -> i64 {
  let n = runtime_str_len(text)
  let mut resolved_0 = unicode_security_script_all_0()
  let mut resolved_1 = unicode_security_script_all_1()
  let mut resolved_2 = unicode_security_script_all_2()
  let mut pos = 0
  let mut valid = true
  while pos < n and valid {
    match runtime_str_utf8_decode(text, pos) {
      Utf8StorageMalformed(offset) -> { valid = false }
      Utf8StorageScalar(next, scalar) -> {
        resolved_0 = resolved_0 band unicode_security_script_mask_0(scalar)
        resolved_1 = resolved_1 band unicode_security_script_mask_1(scalar)
        resolved_2 = resolved_2 band unicode_security_script_mask_2(scalar)
        pos = next
      }
    }
  }
  if valid and pos == n and (resolved_0 bor resolved_1 bor resolved_2) == 0 { 1 } else { 0 }
}

-- UTS #39 skeleton: NFD, drop default-ignorables, map confusables (whose
-- targets are pushed already decomposed), then NFD ordering again.
pub(package) fn unicode_security_skeleton(text: str) -> str {
  let n = runtime_str_len(text)
  let mut decomposed = vector.new<i64>()
  let mut pos = 0
  let mut valid = true
  while pos < n and valid {
    match runtime_str_utf8_decode(text, pos) {
      Utf8StorageMalformed(offset) -> { valid = false }
      Utf8StorageScalar(next, scalar) -> {
        unicode_canonical_decompose_push(scalar, decomposed)
        pos = next
      }
    }
  }
  if not valid { "" }
  else {
    unicode_canonical_order(decomposed)
    let mut mapped = vector.new<i64>()
    for index in 0..vector_len<i64>(decomposed) {
      let scalar = vector_get_in_bounds<i64>(decomposed, index)
      if unicode_default_ignorable(scalar) == 0 {
        if not unicode_confusable_push(scalar, mapped) { mapped.push(scalar) } else { nil }
      } else { nil }
    }
    unicode_canonical_order(mapped)
    utf8_scalar_vector_text(mapped)
  }
}

pub(package) fn unicode_security_are_confusable(a: str, b: str) -> i64 {
  runtime_str_eq(unicode_security_skeleton(a), unicode_security_skeleton(b))
}
