-- stdlib/unicode/segmentation.weft — Unicode 17 default text boundaries
--
-- The state predicates operate on decoded scalar buffers. Public text APIs
-- live in stdlib/unicode.weft so Unicode text semantics have one facade.

use runtime/memory.{mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_len}
use stdlib/unicode/data/segmentation.{*}
use stdlib/utf8.{utf8_decode_is_ok, utf8_decode_next, utf8_decode_next_pos, utf8_decode_scalar}

pub(package) fn unicode_segmentation_decode(text: str, scalars: i64, offsets: i64) -> i64 {
  let n = runtime_str_len(text)
  let mut count = 0
  let mut pos = 0
  let mut valid = 1
  while pos < n and valid == 1 {
    mem_store64_at(offsets, count * 8, pos)
    let decoded = utf8_decode_next(text, pos)
    if utf8_decode_is_ok(decoded) == 0 { valid = 0 }
    else {
      mem_store64_at(scalars, count * 8, utf8_decode_scalar(decoded))
      count = count + 1
      pos = utf8_decode_next_pos(decoded)
    }
  }
  if valid == 1 and pos == n {
    mem_store64_at(offsets, count * 8, n)
    count
  } else { 0 - 1 }
}

pub(package) fn unicode_segmentation_scalar_index_at_offset(offsets: i64, count: i64, byte_offset: i64) -> i64 {
  let mut lo = 0
  let mut hi = count + 1
  let mut found = 0 - 1
  while lo < hi and found < 0 {
    let mid = lo + (hi - lo) / 2
    let value = mem_load64_at(offsets, mid * 8)
    if byte_offset < value { hi = mid }
    else { if byte_offset > value { lo = mid + 1 } else { found = mid } }
  }
  found
}

pub(package) fn unicode_gcb_is_control(code: i64) -> i64 {
  if code == unicode_gcb_control() or code == unicode_gcb_cr() or code == unicode_gcb_lf() { 1 } else { 0 }
}

pub(package) fn unicode_grapheme_is_incb_conjunct(scalars: i64, index: i64) -> i64 {
  let current = unicode_incb_break_code(mem_load64_at(scalars, index * 8))
  if current != unicode_incb_consonant() { 0 }
  else {
    let mut i = index - 1
    let mut saw_linker = 0
    let mut scanning = 1
    while i >= 0 and scanning == 1 {
      let code = unicode_incb_break_code(mem_load64_at(scalars, i * 8))
      if code == unicode_incb_linker() {
        saw_linker = 1
        i = i - 1
      } else { if code == unicode_incb_extend() { i = i - 1 }
      else { scanning = 0 } }
    }
    if saw_linker == 1 and i >= 0 and unicode_incb_break_code(mem_load64_at(scalars, i * 8)) == unicode_incb_consonant() { 1 } else { 0 }
  }
}

pub(package) fn unicode_grapheme_is_emoji_zwj(scalars: i64, index: i64) -> i64 {
  if unicode_extended_pictographic_break_code(mem_load64_at(scalars, index * 8)) == 0 { 0 }
  else {
    let mut i = index - 1
    if i < 0 or unicode_grapheme_break_code(mem_load64_at(scalars, i * 8)) != unicode_gcb_zwj() { 0 }
    else {
      i = i - 1
      while i >= 0 and unicode_grapheme_break_code(mem_load64_at(scalars, i * 8)) == unicode_gcb_extend() { i = i - 1 }
      if i >= 0 and unicode_extended_pictographic_break_code(mem_load64_at(scalars, i * 8)) == 1 { 1 } else { 0 }
    }
  }
}

pub(package) fn unicode_grapheme_has_odd_ri_prefix(scalars: i64, index: i64) -> i64 {
  let mut i = index - 1
  let mut count = 0
  while i >= 0 and unicode_grapheme_break_code(mem_load64_at(scalars, i * 8)) == unicode_gcb_regional_indicator() {
    count = count + 1
    i = i - 1
  }
  count - count / 2 * 2
}

-- Unicode 17 UAX #29 GB1–GB999, extended grapheme-cluster profile.
pub(package) fn unicode_grapheme_break_at_scalars(scalars: i64, count: i64, index: i64) -> i64 {
  if index < 0 or index > count { 0 }
  else { if index == 0 or index == count { 1 }
  else {
    let left = unicode_grapheme_break_code(mem_load64_at(scalars, (index - 1) * 8))
    let right = unicode_grapheme_break_code(mem_load64_at(scalars, index * 8))
    if left == unicode_gcb_cr() and right == unicode_gcb_lf() { 0 }
    else { if unicode_gcb_is_control(left) == 1 or unicode_gcb_is_control(right) == 1 { 1 }
    else { if left == unicode_gcb_l() and (right == unicode_gcb_l() or right == unicode_gcb_v() or right == unicode_gcb_lv() or right == unicode_gcb_lvt()) { 0 }
    else { if (left == unicode_gcb_lv() or left == unicode_gcb_v()) and (right == unicode_gcb_v() or right == unicode_gcb_t()) { 0 }
    else { if (left == unicode_gcb_lvt() or left == unicode_gcb_t()) and right == unicode_gcb_t() { 0 }
    else { if right == unicode_gcb_extend() or right == unicode_gcb_zwj() or right == unicode_gcb_spacingmark() { 0 }
    else { if left == unicode_gcb_prepend() { 0 }
    else { if unicode_grapheme_is_incb_conjunct(scalars, index) == 1 { 0 }
    else { if unicode_grapheme_is_emoji_zwj(scalars, index) == 1 { 0 }
    else { if left == unicode_gcb_regional_indicator() and right == unicode_gcb_regional_indicator() and unicode_grapheme_has_odd_ri_prefix(scalars, index) == 1 { 0 }
    else { 1 } } } } } } } } } }
  } }
}

pub(package) fn unicode_wb_is_newline(code: i64) -> i64 {
  if code == unicode_wb_cr() or code == unicode_wb_lf() or code == unicode_wb_newline() { 1 } else { 0 }
}

pub(package) fn unicode_wb_is_ignored(code: i64) -> i64 {
  if code == unicode_wb_extend() or code == unicode_wb_format() or code == unicode_wb_zwj() { 1 } else { 0 }
}

pub(package) fn unicode_wb_is_ahletter(code: i64) -> i64 {
  if code == unicode_wb_aletter() or code == unicode_wb_hebrew_letter() { 1 } else { 0 }
}

pub(package) fn unicode_wb_is_mid_letter(code: i64) -> i64 {
  if code == unicode_wb_midletter() or code == unicode_wb_midnumlet() or code == unicode_wb_single_quote() { 1 } else { 0 }
}

pub(package) fn unicode_wb_is_mid_num(code: i64) -> i64 {
  if code == unicode_wb_midnum() or code == unicode_wb_midnumlet() or code == unicode_wb_single_quote() { 1 } else { 0 }
}

pub(package) fn unicode_word_previous_significant(scalars: i64, index: i64) -> i64 {
  let mut i = index
  while i >= 0 and unicode_wb_is_ignored(unicode_word_break_code(mem_load64_at(scalars, i * 8))) == 1 { i = i - 1 }
  i
}

pub(package) fn unicode_word_next_significant(scalars: i64, count: i64, index: i64) -> i64 {
  let mut i = index
  while i < count and unicode_wb_is_ignored(unicode_word_break_code(mem_load64_at(scalars, i * 8))) == 1 { i = i + 1 }
  if i < count { i } else { 0 - 1 }
}

pub(package) fn unicode_word_has_emoji_zwj_left(scalars: i64, index: i64) -> i64 {
  if index <= 0 { 0 }
  else {
    let left = unicode_word_break_code(mem_load64_at(scalars, (index - 1) * 8))
    let right_is_pictographic = unicode_extended_pictographic_break_code(mem_load64_at(scalars, index * 8))
    if left == unicode_wb_zwj() and right_is_pictographic == 1 { 1 } else { 0 }
  }
}

pub(package) fn unicode_word_has_odd_ri_prefix(scalars: i64, index: i64) -> i64 {
  let mut i = unicode_word_previous_significant(scalars, index - 1)
  let mut count = 0
  let mut scanning = 1
  while i >= 0 and scanning == 1 {
    if unicode_word_break_code(mem_load64_at(scalars, i * 8)) == unicode_wb_regional_indicator() {
      count = count + 1
      i = unicode_word_previous_significant(scalars, i - 1)
    } else { scanning = 0 }
  }
  count - count / 2 * 2
}

-- Unicode 17 UAX #29 WB1–WB999, default word-boundary profile.
pub(package) fn unicode_word_break_at_scalars(scalars: i64, count: i64, index: i64) -> i64 {
  if index < 0 or index > count { 0 }
  else { if index == 0 or index == count { 1 }
  else {
    let raw_left = unicode_word_break_code(mem_load64_at(scalars, (index - 1) * 8))
    let raw_right = unicode_word_break_code(mem_load64_at(scalars, index * 8))
    if raw_left == unicode_wb_cr() and raw_right == unicode_wb_lf() { 0 }
    else { if unicode_wb_is_newline(raw_left) == 1 or unicode_wb_is_newline(raw_right) == 1 { 1 }
    else { if unicode_word_has_emoji_zwj_left(scalars, index) == 1 { 0 }
    else { if raw_left == unicode_wb_wsegspace() and raw_right == unicode_wb_wsegspace() { 0 }
    else { if unicode_wb_is_ignored(raw_right) == 1 { 0 }
    else {
      let left_pos = unicode_word_previous_significant(scalars, index - 1)
      let right_pos = unicode_word_next_significant(scalars, count, index)
      let left = if left_pos < 0 { unicode_wb_other() } else { unicode_word_break_code(mem_load64_at(scalars, left_pos * 8)) }
      let right = if right_pos < 0 { unicode_wb_other() } else { unicode_word_break_code(mem_load64_at(scalars, right_pos * 8)) }
      let before_left_pos = unicode_word_previous_significant(scalars, left_pos - 1)
      let after_right_pos = unicode_word_next_significant(scalars, count, right_pos + 1)
      let before_left = if before_left_pos < 0 { unicode_wb_other() } else { unicode_word_break_code(mem_load64_at(scalars, before_left_pos * 8)) }
      let after_right = if after_right_pos < 0 { unicode_wb_other() } else { unicode_word_break_code(mem_load64_at(scalars, after_right_pos * 8)) }
      if unicode_wb_is_ahletter(left) == 1 and unicode_wb_is_ahletter(right) == 1 { 0 }
      else { if unicode_wb_is_ahletter(left) == 1 and unicode_wb_is_mid_letter(right) == 1 and unicode_wb_is_ahletter(after_right) == 1 { 0 }
      else { if unicode_wb_is_mid_letter(left) == 1 and unicode_wb_is_ahletter(before_left) == 1 and unicode_wb_is_ahletter(right) == 1 { 0 }
      else { if left == unicode_wb_hebrew_letter() and right == unicode_wb_single_quote() { 0 }
      else { if left == unicode_wb_hebrew_letter() and right == unicode_wb_double_quote() and after_right == unicode_wb_hebrew_letter() { 0 }
      else { if left == unicode_wb_double_quote() and before_left == unicode_wb_hebrew_letter() and right == unicode_wb_hebrew_letter() { 0 }
      else { if left == unicode_wb_numeric() and right == unicode_wb_numeric() { 0 }
      else { if unicode_wb_is_ahletter(left) == 1 and right == unicode_wb_numeric() { 0 }
      else { if left == unicode_wb_numeric() and unicode_wb_is_ahletter(right) == 1 { 0 }
      else { if unicode_wb_is_mid_num(left) == 1 and before_left == unicode_wb_numeric() and right == unicode_wb_numeric() { 0 }
      else { if left == unicode_wb_numeric() and unicode_wb_is_mid_num(right) == 1 and after_right == unicode_wb_numeric() { 0 }
      else { if left == unicode_wb_katakana() and right == unicode_wb_katakana() { 0 }
      else { if (unicode_wb_is_ahletter(left) == 1 or left == unicode_wb_numeric() or left == unicode_wb_katakana() or left == unicode_wb_extendnumlet()) and right == unicode_wb_extendnumlet() { 0 }
      else { if left == unicode_wb_extendnumlet() and (unicode_wb_is_ahletter(right) == 1 or right == unicode_wb_numeric() or right == unicode_wb_katakana()) { 0 }
      else { if left == unicode_wb_regional_indicator() and right == unicode_wb_regional_indicator() and unicode_word_has_odd_ri_prefix(scalars, index) == 1 { 0 }
      else { 1 } } } } } } } } } } } } } } }
    } } } } }
  } }
}

pub(package) fn unicode_sb_is_paragraph(code: i64) -> i64 {
  if code == unicode_sb_sep() or code == unicode_sb_cr() or code == unicode_sb_lf() { 1 } else { 0 }
}

pub(package) fn unicode_sb_is_ignored(code: i64) -> i64 {
  if code == unicode_sb_extend() or code == unicode_sb_format() { 1 } else { 0 }
}

pub(package) fn unicode_sb_is_term(code: i64) -> i64 {
  if code == unicode_sb_sterm() or code == unicode_sb_aterm() { 1 } else { 0 }
}

pub(package) fn unicode_sentence_previous_significant(scalars: i64, index: i64) -> i64 {
  let mut i = index
  while i >= 0 and unicode_sb_is_ignored(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 { i = i - 1 }
  i
}

pub(package) fn unicode_sentence_next_significant(scalars: i64, count: i64, index: i64) -> i64 {
  let mut i = index
  while i < count and unicode_sb_is_ignored(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 { i = i + 1 }
  if i < count { i } else { 0 - 1 }
}

pub(package) fn unicode_sentence_term_before_boundary(scalars: i64, index: i64) -> i64 {
  let mut i = unicode_sentence_previous_significant(scalars, index - 1)
  if i >= 0 and unicode_sb_is_paragraph(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 {
    i = unicode_sentence_previous_significant(scalars, i - 1)
  } else { 0 }
  while i >= 0 and unicode_sentence_break_code(mem_load64_at(scalars, i * 8)) == unicode_sb_sp() {
    i = unicode_sentence_previous_significant(scalars, i - 1)
  }
  while i >= 0 and unicode_sentence_break_code(mem_load64_at(scalars, i * 8)) == unicode_sb_close() {
    i = unicode_sentence_previous_significant(scalars, i - 1)
  }
  if i >= 0 and unicode_sb_is_term(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 { i } else { 0 - 1 }
}

pub(package) fn unicode_sentence_close_term_before_boundary(scalars: i64, index: i64) -> i64 {
  let mut i = unicode_sentence_previous_significant(scalars, index - 1)
  while i >= 0 and unicode_sentence_break_code(mem_load64_at(scalars, i * 8)) == unicode_sb_close() {
    i = unicode_sentence_previous_significant(scalars, i - 1)
  }
  if i >= 0 and unicode_sb_is_term(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 { i } else { 0 - 1 }
}

pub(package) fn unicode_sentence_ignored_run_is_unattached(scalars: i64, index: i64) -> i64 {
  if index <= 0 or unicode_sb_is_ignored(unicode_sentence_break_code(mem_load64_at(scalars, (index - 1) * 8))) == 0 { 0 }
  else {
    let i = unicode_sentence_previous_significant(scalars, index - 1)
    if i < 0 or unicode_sb_is_paragraph(unicode_sentence_break_code(mem_load64_at(scalars, i * 8))) == 1 { 1 } else { 0 }
  }
}

pub(package) fn unicode_sentence_has_lower_ahead(scalars: i64, count: i64, index: i64) -> i64 {
  let mut i = unicode_sentence_next_significant(scalars, count, index)
  let mut searching = 1
  let mut found = 0
  while i >= 0 and searching == 1 {
    let code = unicode_sentence_break_code(mem_load64_at(scalars, i * 8))
    if code == unicode_sb_lower() {
      found = 1
      searching = 0
    } else { if code == unicode_sb_oletter() or code == unicode_sb_upper() or unicode_sb_is_paragraph(code) == 1 or unicode_sb_is_term(code) == 1 {
      searching = 0
    } else { i = unicode_sentence_next_significant(scalars, count, i + 1) } }
  }
  found
}

-- Unicode 17 UAX #29 SB1–SB998, default sentence-boundary profile.
pub(package) fn unicode_sentence_break_at_scalars(scalars: i64, count: i64, index: i64) -> i64 {
  if index < 0 or index > count { 0 }
  else { if index == 0 or index == count { 1 }
  else {
    let raw_left = unicode_sentence_break_code(mem_load64_at(scalars, (index - 1) * 8))
    let raw_right = unicode_sentence_break_code(mem_load64_at(scalars, index * 8))
    if raw_left == unicode_sb_cr() and raw_right == unicode_sb_lf() { 0 }
    else { if unicode_sb_is_paragraph(raw_left) == 1 { 1 }
    else { if unicode_sb_is_ignored(raw_right) == 1 { 0 }
    else { if unicode_sentence_ignored_run_is_unattached(scalars, index) == 1 { 0 }
    else {
      let left_pos = unicode_sentence_previous_significant(scalars, index - 1)
      let right_pos = unicode_sentence_next_significant(scalars, count, index)
      let left = if left_pos < 0 { unicode_sb_other() } else { unicode_sentence_break_code(mem_load64_at(scalars, left_pos * 8)) }
      let right = if right_pos < 0 { unicode_sb_other() } else { unicode_sentence_break_code(mem_load64_at(scalars, right_pos * 8)) }
      let before_left_pos = unicode_sentence_previous_significant(scalars, left_pos - 1)
      let before_left = if before_left_pos < 0 { unicode_sb_other() } else { unicode_sentence_break_code(mem_load64_at(scalars, before_left_pos * 8)) }
      if left == unicode_sb_aterm() and right == unicode_sb_numeric() { 0 }
      else { if left == unicode_sb_aterm() and (before_left == unicode_sb_upper() or before_left == unicode_sb_lower()) and right == unicode_sb_upper() { 0 }
      else {
        let term_pos = unicode_sentence_term_before_boundary(scalars, index)
        if term_pos < 0 { 0 }
        else {
          let term = unicode_sentence_break_code(mem_load64_at(scalars, term_pos * 8))
          if term == unicode_sb_aterm() and unicode_sentence_has_lower_ahead(scalars, count, index) == 1 { 0 }
          else { if right == unicode_sb_scontinue() or unicode_sb_is_term(right) == 1 { 0 }
          else {
            let close_term_pos = unicode_sentence_close_term_before_boundary(scalars, index)
            if close_term_pos >= 0 and (right == unicode_sb_close() or right == unicode_sb_sp() or unicode_sb_is_paragraph(right) == 1) { 0 }
            else { if right == unicode_sb_sp() or unicode_sb_is_paragraph(right) == 1 { 0 }
            else { 1 } }
          } }
        }
      } }
    } } } }
  } }
}
