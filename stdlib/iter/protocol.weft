-- stdlib/iter/protocol.weft -- the language-level iteration protocol

--- A stateful one-pass pull iterator over values of type `T`.
pub type Iterator<T> {
  --- Wrap iterator state and cleanup; prefer the public constructors.
  Iterator(i64, () -> nil)
}

--- Convert a value into a one-pass iterator with an exact item type.
pub trait IntoIterator {
  --- The values yielded by this collection or producer.
  type Item

  --- Create a fresh iterator over `self`.
  fn into_iter(self: Self) -> Iterator<Self.Item>
}

--- Construct a collection from a finite iterator without exposing its builder.
pub trait Collect {
  --- The values accepted by this collection.
  type Item

  --- Construct the collection's empty seed.
  fn empty() -> Self

  --- Consume `source` into this seed and return the completed collection.
  fn collect_from(self: Self, source: Iterator<Self.Item>) -> Self
}

impl<T> IntoIterator for Iterator<T> {
  type Item = T

  fn into_iter(self: Iterator<T>) -> Iterator<T> {
    self
  }
}
