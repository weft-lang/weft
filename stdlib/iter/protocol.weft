-- stdlib/iter/protocol.weft -- the language-level iteration protocol

--- A stateful, linearly owned, one-pass pull iterator over values of type `T`.
---
--- Construction and representation are private to the iterator family. Use a
--- collection's `into_iter`, `iter.range`, or another iterator constructor.
pub type Iterator<T> = opaque i64

pub(package) fn iterator_from_runtime_state<T>(state: i64) -> owned Iterator<T> {
  Iterator<T>(state)
}

pub(package) fn iterator_runtime_state<T>(iterator: borrow Iterator<T>) -> i64 {
  match iterator {
    Iterator(state) -> state
  }
}

pub(package) fn iterator_into_runtime_state<T>(iterator: owned Iterator<T>) -> i64 {
  match iterator {
    Iterator(state) -> state
  }
}

--- Convert a value into a linearly owned iterator with an exact item type.
pub trait IntoIterator {
  --- The values yielded by this collection or producer.
  type Item

  --- Create a fresh iterator over `self`.
  fn into_iter(self: Self) -> owned Iterator<Self.Item>
}

--- Construct a collection from a finite iterator without exposing its builder.
pub trait Collect {
  --- The values accepted by this collection.
  type Item

  --- Construct the collection's empty seed.
  fn empty() -> Self

  --- Consume `source` into this seed and return the completed collection.
  fn collect_from(self: Self, source: owned Iterator<Self.Item>) -> Self
}

impl<T> IntoIterator for Iterator<T> {
  type Item = T

  fn into_iter(self: Iterator<T>) -> owned Iterator<T> {
    self
  }
}
