-- stdlib/iter/protocol.weft -- the language-level iteration protocol

--- A stateful one-pass pull iterator over values of type `T`.
---
--- Construction and representation are private to the iterator family. Use a
--- collection's `into_iter`, `iter.range`, or another iterator constructor.
type IteratorRuntimeState {
  IteratorRuntimeState(i64, () -> nil)
}

pub type Iterator<T> = opaque IteratorRuntimeState

pub(package) fn iterator_from_runtime_parts<T>(state: i64, dropper: () -> nil) -> Iterator<T> {
  Iterator<T>(IteratorRuntimeState(state, dropper))
}

pub(package) fn iterator_runtime_state<T>(iterator: Iterator<T>) -> i64 {
  match iterator {
    Iterator(parts) -> match parts {
      IteratorRuntimeState(state, dropper) -> state
    }
  }
}

pub(package) fn iterator_runtime_dropper<T>(iterator: Iterator<T>) -> () -> nil {
  match iterator {
    Iterator(parts) -> match parts {
      IteratorRuntimeState(state, dropper) -> dropper
    }
  }
}

--- Convert a value into a one-pass iterator with an exact item type.
pub trait IntoIterator {
  --- The values yielded by this collection or producer.
  type Item

  --- Create a fresh iterator over `self`.
  fn into_iter(self: Self) -> Iterator<Self.Item>
}

--- Construct a collection from a finite iterator without exposing its builder.
pub trait Collect {
  --- The values accepted by this collection.
  type Item

  --- Construct the collection's empty seed.
  fn empty() -> Self

  --- Consume `source` into this seed and return the completed collection.
  fn collect_from(self: Self, source: Iterator<Self.Item>) -> Self
}

impl<T> IntoIterator for Iterator<T> {
  type Item = T

  fn into_iter(self: Iterator<T>) -> Iterator<T> {
    self
  }
}
