-- stdlib/iter/materialize.weft -- eager iterator materialization consumers

use stdlib/iter/core.{iter_next}
use stdlib/iter/protocol.{IntoIterator}
use stdlib/num
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_swap_borrowed, vector_truncate_borrowed}

--- Why a bounded traversal could not represent its requested width.
pub type WidthError {
  --- A traversal width must be nonzero.
  WidthZero,
  --- The requested platform-sized width cannot fit its bounded buffer.
  WidthTooLarge
}

type ChunkFillState {
  ChunkFilling,
  ChunkSourceDone
}

fn discard_chunk<T>(chunk: owned Vector<T>) -> nil { nil }

fn chunk_source_open(state: ChunkFillState) -> bool {
  match state {
    ChunkFilling -> true
    ChunkSourceDone -> false
  }
}

fn traversal_width(value: usize) -> Result<usize, WidthError> {
  match value.to_u64().to_i64_checked() {
    Err(_) -> Err<usize, WidthError>(WidthTooLarge)
    Ok(0) -> Err<usize, WidthError>(WidthZero)
    Ok(_) -> Ok<usize, WidthError>(value)
  }
}

-- The rolling buffer reserves twice the width so it can keep one contiguous
-- window while amortizing compaction. Stay within its signed storage domain.
fn window_max_width() -> usize { 4611686018427387903 }

--- Consume a source into values accepted and rejected by `pred`.
---
--- Both vectors preserve source order. The predicate is pure; use `iter.each`
--- when routing itself must perform effects.
pub fn partition<S: IntoIterator>(input: S, pred: (S.Item) -> bool) -> (owned Vector<S.Item>, owned Vector<S.Item>) {
  let mut accepted = vector.new<S.Item>()
  let mut rejected = vector.new<S.Item>()
  let mut source = input.into_iter()
  let mut done = false
  while not done {
    match iter_next<S.Item>(source) {
      Some(value) -> {
        if pred(value) {
          accepted.push(value)
        } else {
          rejected.push(value)
        }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  (accepted, rejected)
}

--- Consume a source through bounded, source-ordered owned chunks.
---
--- Every completed vector moves into `f`. The final vector may contain fewer
--- than `width` values. Callback effects remain visible to the caller.
pub fn each_chunk<S: IntoIterator, E>(
  input: S,
  width: usize,
  f: (owned Vector<S.Item>) -[E]> nil
) -[E]> Result<nil, WidthError> {
  match traversal_width(width) {
    Err(error) -> Err<nil, WidthError>(error)
    Ok(capacity) -> {
      let mut source = input.into_iter()
      let mut state = ChunkFilling
      while chunk_source_open(state) {
        let mut chunk = vector.with_capacity<S.Item>(capacity)
        while chunk.len() < capacity and chunk_source_open(state) {
          match iter_next<S.Item>(source) {
            Some(value) -> {
              chunk.push(value)
              nil
            }
            None -> {
              state = ChunkSourceDone
              nil
            }
          }
        }
        match state {
          ChunkFilling -> { f(chunk) }
          ChunkSourceDone -> {
            match chunk.len() {
              0 -> discard_chunk<S.Item>(chunk)
              _ -> f(chunk)
            }
          }
        }
      }
      Ok<nil, WidthError>(nil)
    }
  }
}

fn window_apply<T, E>(
  values: borrow Vector<T>,
  start: usize,
  width: usize,
  f: (borrow [T]) -[E]> nil
) -[E]> nil {
  let view = values[start..start + width]
  f(view)
}

fn window_compact<T>(values: borrow mut Vector<T>, width: i64) -> nil {
  let keep = width - 1
  for index in 0..keep {
    match vector_swap_borrowed<T>(values, index, width + index) {
      true -> nil
      false -> panic("iterator window compaction index invariant failed")
    }
  }
  vector_truncate_borrowed<T>(values, keep)
}

--- Consume a source through overlapping, source-ordered borrowed windows.
---
--- Every immutable slice is valid only for its callback. Callback effects
--- remain visible, and the bounded rolling buffer is reclaimed on every exit.
pub fn each_window<S: IntoIterator, E>(
  input: S,
  width: usize,
  f: (borrow [S.Item]) -[E]> nil
) -[E]> Result<nil, WidthError> {
  match traversal_width(width) {
    Err(error) -> Err<nil, WidthError>(error)
    Ok(size) if size > window_max_width() -> Err<nil, WidthError>(WidthTooLarge)
    Ok(size) -> {
      let storage_size = size.to_u64().to_i64_checked().expect("iterator width fits storage")
      let mut source = input.into_iter()
      let mut values = vector.with_capacity<S.Item>(size + size)
      let zero: usize = 0
      let one: usize = 1
      let mut start = zero
      let mut done = false
      while not done {
        match iter_next<S.Item>(source) {
          Some(value) -> {
            values.push(value)
            if values.len() - start == size {
              window_apply<S.Item, E>(values, start, size, f)
              start = start + one
              if start == size {
                window_compact<S.Item>(values, storage_size)
                start = zero
              } else { nil }
            } else { nil }
          }
          None -> {
            done = true
            nil
          }
        }
      }
      Ok<nil, WidthError>(nil)
    }
  }
}
