-- stdlib/iter/materialize.weft -- eager iterator materialization consumers

use stdlib/iter/core.{iter_next}
use stdlib/iter/protocol.{IntoIterator}
use stdlib/num
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{Vector}

--- Why a chunk traversal could not represent its requested bound.
pub type ChunkError {
  --- A chunk width must be nonzero.
  ChunkSizeZero,
  --- The requested platform-sized count cannot fit the vector index domain.
  ChunkSizeTooLarge
}

type ChunkFillState {
  ChunkFilling,
  ChunkSourceDone
}

fn discard_chunk<T>(chunk: owned Vector<T>) -> nil { nil }

fn chunk_source_open(state: ChunkFillState) -> bool {
  match state {
    ChunkFilling -> true
    ChunkSourceDone -> false
  }
}

--- Consume a source into values accepted and rejected by `pred`.
---
--- Both vectors preserve source order. The predicate is pure; use `iter.each`
--- when routing itself must perform effects.
pub fn partition<S: IntoIterator>(input: S, pred: (S.Item) -> bool) -> (owned Vector<S.Item>, owned Vector<S.Item>) {
  let mut accepted = vector.new<S.Item>()
  let mut rejected = vector.new<S.Item>()
  let mut source = input.into_iter()
  let mut done = false
  while not done {
    match iter_next<S.Item>(source) {
      Some(value) -> {
        if pred(value) {
          accepted.push(value)
        } else {
          rejected.push(value)
        }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  (accepted, rejected)
}

--- Consume a source through bounded, source-ordered owned chunks.
---
--- Every completed vector moves into `f`. The final vector may contain fewer
--- than `size` values. Callback effects remain visible to the caller.
pub fn each_chunk<S: IntoIterator, E>(
  input: S,
  size: usize,
  f: (owned Vector<S.Item>) -[E]> nil
) -[E]> Result<nil, ChunkError> {
  match size.to_u64().to_i64_checked() {
    Err(_) -> Err<nil, ChunkError>(ChunkSizeTooLarge)
    Ok(0) -> Err<nil, ChunkError>(ChunkSizeZero)
    Ok(capacity) -> {
      let mut source = input.into_iter()
      let mut state = ChunkFilling
      while chunk_source_open(state) {
        let mut chunk = vector.with_capacity<S.Item>(capacity)
        while chunk.len() < capacity and chunk_source_open(state) {
          match iter_next<S.Item>(source) {
            Some(value) -> {
              chunk.push(value)
              nil
            }
            None -> {
              state = ChunkSourceDone
              nil
            }
          }
        }
        match state {
          ChunkFilling -> { f(chunk) }
          ChunkSourceDone -> {
            match chunk.len() {
              0 -> discard_chunk<S.Item>(chunk)
              _ -> f(chunk)
            }
          }
        }
      }
      Ok<nil, ChunkError>(nil)
    }
  }
}
