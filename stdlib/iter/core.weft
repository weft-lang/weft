-- stdlib/iter/core.weft -- pull iterators over generic generators

use runtime/iter_state.{*}
use runtime/rc.{runtime_generator_state_word_as}
use stdlib/drop.{Drop}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}
use stdlib/iter/protocol.{*}

pub(package) fn iter_noop_drop() -> nil { nil }

pub(package) fn iter_keep_generator_producer(producer: () -[GeneratorYield]> i64) -> nil { nil }

pub(package) fn iter_make<T>(state: i64) -> owned Iterator<T> {
  iterator_from_runtime_state<T>(state)
}

--- Adapt a typed generator with an `i64` completion result into an iterator.
pub fn from_generator<T>(g: owned Generator<T, i64>) -> owned Iterator<T> {
  iter_from_generator_with_dropper<T>(g, iter_noop_drop)
}

pub(package) fn iter_from_generator_with_dropper<T>(g: owned Generator<T, i64>, dropper: () -> nil) -> owned Iterator<T> {
  let state = runtime_iter_state_new(runtime_iter_kind_generator(), generator_into_runtime_state<T, i64>(g), 0, dropper)
  iter_make<T>(state)
}

--- Construct an ascending half-open integer iterator `[start, end)`.
pub fn range(start: i64, end: i64) -> owned Iterator<i64> {
  let state = runtime_iter_state_new(runtime_iter_kind_range_i64(), start, end, iter_noop_drop)
  iter_make<i64>(state)
}

pub(package) fn iter_close_runtime_state<T>(state: i64) -> nil {
  if state == 0 or runtime_iter_state_closed(state) == 1 {
    nil
  } else {
    runtime_iter_state_set_closed(state, 1)
    runtime_iter_state_run_dropper(state)
    runtime_iter_state_release_dropper(state)
    runtime_iter_state_release_generator(state)
    nil
  }
}

pub(package) fn iter_next_runtime_state<T>(state: i64) -> Option<T> {
  match runtime_iter_state_kind(state) {
    1 -> {
      if runtime_iter_state_closed(state) == 1 {
        None<T>()
      } else {
        match generator_next_runtime_state<T, i64>(runtime_iter_state_generator_word(state)) {
          None -> {
            iter_close_runtime_state<T>(state)
            None<T>()
          }
          Some(value) -> Some<T>(value)
        }
      }
    }
    2 -> {
      let current = runtime_iter_state_first(state)
      let end = runtime_iter_state_second(state)
      if current >= end {
        iter_close_runtime_state<T>(state)
        None<T>()
      } else {
        runtime_iter_state_set_first(state, current + 1)
        Some<T>(runtime_generator_state_word_as<T>(current))
      }
    }
    _ -> None<T>()
  }
}

pub(package) fn iter_drop_runtime_state<T>(state: i64) -> nil {
  if state == 0 { nil }
  else {
    if runtime_iter_state_closed(state) != 1 {
      match runtime_iter_state_kind(state) {
        1 -> iter_close_runtime_state<T>(state)
        2 -> {
          runtime_iter_state_set_first(state, runtime_iter_state_second(state))
          iter_close_runtime_state<T>(state)
        }
        _ -> iter_close_runtime_state<T>(state)
      }
    } else { nil }
    runtime_iter_state_release(state)
    nil
  }
}

pub(package) fn iter_next<T>(iterator: borrow mut Iterator<T>) -> Option<T> {
  iter_next_runtime_state<T>(iterator_runtime_state<T>(iterator))
}

impl<T> Iterator<T> {
  --- Return the next value, or `None` after exhaustion.
  pub fn next(self: borrow mut Self) -> Option<T> {
    iter_next<T>(self)
  }

  --- Consume this iterator and deterministically close its producer.
  pub fn close(self: owned Self) -> nil {
    self.drop()
  }
}

impl<T> Drop for Iterator<T> {
  fn drop(self) -> nil {
    iter_drop_runtime_state<T>(iterator_into_runtime_state<T>(self))
  }
}

--- Lazily transform values with a pure function; dropping the result drops `it`.
pub fn map<T, U>(it: owned Iterator<T>, f: (T) -> U) -> owned Iterator<U> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          generator.yield<U>(f(value))
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<U>(generator.start<U, i64>(producer), dropper)
}

--- Lazily retain values for which `pred` returns true.
--- Dropping the result also drops the source iterator.
pub fn filter<T>(it: owned Iterator<T>, pred: (T) -> bool) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          if pred(value) {
            generator.yield<T>(value)
          } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T>(generator.start<T, i64>(producer), dropper)
}

--- Lazily yield at most `limit` values; non-positive limits yield none.
--- Exhausting or dropping the result closes the source iterator.
pub fn take<T>(it: owned Iterator<T>, limit: i64) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut remaining = limit
    let mut done = if limit <= 0 { 1 } else { 0 }
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          generator.yield<T>(value)
          remaining = remaining - 1
          if remaining <= 0 { done = 1 } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T>(generator.start<T, i64>(producer), dropper)
}

--- Consume an iterator and fold its values in order with a pure callback.
pub fn fold<T, A>(it: owned Iterator<T>, init: A, f: (A, T) -> A) -> A {
  let mut source = it
  let mut acc = init
  let mut done = 0
  while done == 0 {
    let next = source.next()
    match next {
      Some(value) -> {
        acc = f(acc, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  acc
}

-- Compiler fusion target for the fully scalar range/map/filter/take/fold
-- shape. This is package-private implementation vocabulary: the optimiser
-- selects it from the resolved traversal-role fact, never from source syntax.
pub(package) fn iter_range_map_filter_take_fold_i64(
  start: i64,
  end: i64,
  map_value: (i64) -> i64,
  keep_value: (i64) -> bool,
  limit: i64,
  init: i64,
  fold_value: (i64, i64) -> i64
) -> i64 {
  let mut current = start
  let mut remaining = limit
  let mut acc = init
  while current < end and remaining > 0 {
    let mapped = map_value(current)
    if keep_value(mapped) {
      acc = fold_value(acc, mapped)
      remaining = remaining - 1
    } else { 0 }
    current = current + 1
  }
  acc
}

--- Consume an iterator and return its remaining value count.
pub fn count<T>(it: owned Iterator<T>) -> i64 {
  let mut source = it
  let mut count = 0
  let mut done = 0
  while done == 0 {
    let next = source.next()
    match next {
      Some(value) -> {
        count = count + 1
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  count
}
