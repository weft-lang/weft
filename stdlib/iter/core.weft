-- stdlib/iter/core.weft -- pull iterators over generic generators

use runtime/iter_state.{*}
use runtime/rc.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}
use stdlib/iter/protocol.{*}

pub(package) fn iter_noop_drop() -> nil { nil }

pub(package) fn iter_keep_generator_producer(producer: () -[GeneratorYield]> i64) -> nil { nil }

pub(package) fn iter_make<T>(state: i64, dropper: () -> nil) -> Iterator<T> {
  iterator_from_runtime_parts<T>(state, dropper)
}

--- Adapt a typed generator with an `i64` completion result into an iterator.
pub fn from_generator<T>(g: Generator<T, i64>) -> Iterator<T> {
  iter_from_generator_with_dropper<T>(g, iter_noop_drop)
}

pub(package) fn iter_from_generator_with_dropper<T>(g: Generator<T, i64>, dropper: () -> nil) -> Iterator<T> {
  let state = runtime_iter_state_new(runtime_iter_kind_generator(), g, 0, dropper)
  iter_make<T>(state, dropper)
}

--- Construct an ascending half-open integer iterator `[start, end)`.
pub fn range(start: i64, end: i64) -> Iterator<i64> {
  let state = runtime_iter_state_new(runtime_iter_kind_range_i64(), start, end, iter_noop_drop)
  iter_make<i64>(state, iter_noop_drop)
}

--- Close an iterator idempotently and run its configured close cleanup.
pub(package) fn iter_close<T>(it: Iterator<T>) -> nil {
  let state = iterator_runtime_state<T>(it)
  if state == 0 { nil } else {
    if runtime_iter_state_closed(state) == 1 {
      nil
    } else {
      runtime_iter_state_set_closed(state, 1)
      let dropper = iterator_runtime_dropper<T>(it)
      dropper()
      runtime_iter_state_release_dropper(state)
      runtime_iter_state_release_generator(state)
      nil
    }
  }
}

--- Consume and return the next value, or `None` after exhaustion or close.
pub(package) fn iter_next<T>(it: Iterator<T>) -> Option<T> {
  let state = iterator_runtime_state<T>(it)
  let kind = runtime_iter_state_kind(state)
  if kind == runtime_iter_kind_generator() {
    if runtime_iter_state_closed(state) == 1 {
      None
    } else {
      let g = runtime_generator_state_word_as<Generator<T, i64>>(runtime_iter_state_generator_word(state))
      let next = g.next()
      match next {
        None -> {
          iter_close<T>(it)
          None
        }
        Some(value) -> Some<T>(value)
      }
    }
  } else {
    if kind == runtime_iter_kind_range_i64() {
      let current = runtime_iter_state_first(state)
      let end = runtime_iter_state_second(state)
      if current >= end {
        iter_close<T>(it)
        None
      } else {
        runtime_iter_state_set_first(state, current + 1)
        Some<T>(runtime_generator_state_word_as<T>(current))
      }
    } else {
      None
    }
  }
}

--- Cancel pending iteration, drop any suspended generator, and close once.
pub(package) fn iter_drop<T>(it: Iterator<T>) -> nil {
  let state = iterator_runtime_state<T>(it)
  let kind = runtime_iter_state_kind(state)
  if state != 0 and runtime_iter_state_closed(state) != 1 {
    if kind == runtime_iter_kind_generator() {
      let g = runtime_generator_state_word_as<Generator<T, i64>>(runtime_iter_state_generator_word(state))
      g.close()
      iter_close<T>(it)
    } else {
      if kind == runtime_iter_kind_range_i64() {
        runtime_iter_state_set_first(state, runtime_iter_state_second(state))
      } else { nil }
      iter_close<T>(it)
    }
  } else { nil }
  nil
}

--- Lazily transform values with a pure function; dropping the result drops `it`.
pub fn map<T, U>(it: Iterator<T>, f: (T) -> U) -> Iterator<U> {
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          generator.yield<U>(f(value))
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<U>(generator.start<U, i64>(producer), dropper)
}

--- Lazily retain values for which `pred` returns true.
--- Dropping the result also drops the source iterator.
pub fn filter<T>(it: Iterator<T>, pred: (T) -> bool) -> Iterator<T> {
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          if pred(value) {
            generator.yield<T>(value)
          } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<T>(generator.start<T, i64>(producer), dropper)
}

--- Lazily yield at most `limit` values; non-positive limits yield none.
--- Exhausting or dropping the result closes the source iterator.
pub fn take<T>(it: Iterator<T>, limit: i64) -> Iterator<T> {
  let producer = () => {
    let mut remaining = limit
    let mut done = if limit <= 0 { 1 } else { 0 }
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          generator.yield<T>(value)
          remaining = remaining - 1
          if remaining <= 0 { done = 1 } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<T>(generator.start<T, i64>(producer), dropper)
}

--- Consume an iterator and fold its values in order with a pure callback.
pub fn fold<T, A>(it: Iterator<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        acc = f(acc, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  acc
}

-- Compiler fusion target for the fully scalar range/map/filter/take/fold
-- shape. This is package-private implementation vocabulary: the optimiser
-- selects it from the resolved traversal-role fact, never from source syntax.
pub(package) fn iter_range_map_filter_take_fold_i64(
  start: i64,
  end: i64,
  map_value: (i64) -> i64,
  keep_value: (i64) -> bool,
  limit: i64,
  init: i64,
  fold_value: (i64, i64) -> i64
) -> i64 {
  let mut current = start
  let mut remaining = limit
  let mut acc = init
  while current < end and remaining > 0 {
    let mapped = map_value(current)
    if keep_value(mapped) {
      acc = fold_value(acc, mapped)
      remaining = remaining - 1
    } else { 0 }
    current = current + 1
  }
  acc
}

--- Consume an iterator and return its remaining value count.
pub fn count<T>(it: Iterator<T>) -> i64 {
  let mut count = 0
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        count = count + 1
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  count
}

impl<T> Iterator<T> {
  --- Consume and return the next value, or `None` after exhaustion.
  pub fn next(self: Iterator<T>) -> Option<T> {
    iter_next<T>(self)
  }

  --- Close this iterator idempotently, dropping any suspended producer.
  pub fn close(self: Iterator<T>) -> nil {
    iter_drop<T>(self)
  }

}
