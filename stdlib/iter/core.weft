-- stdlib/iter/core.weft -- pull iterators over generic generators

use runtime/iter_state.{*}
use runtime/rc.{runtime_generator_state_word_as}
use stdlib/drop.{Drop}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}
use stdlib/iter/protocol.{*}

type IteratorRuntimeKind {
  IteratorRuntimeGenerator,
  IteratorRuntimeRangeI64,
  IteratorRuntimeEmpty,
  IteratorRuntimeUnknown
}

fn iter_runtime_kind(state: i64) -> IteratorRuntimeKind {
  match runtime_iter_state_kind(state) {
    1 -> IteratorRuntimeGenerator
    2 -> IteratorRuntimeRangeI64
    3 -> IteratorRuntimeEmpty
    _ -> IteratorRuntimeUnknown
  }
}

pub(package) fn iter_noop_drop() -> nil { nil }

pub(package) fn iter_keep_generator_producer(producer: () -[GeneratorYield]> i64) -> nil { nil }

pub(package) fn iter_make<T>(state: i64) -> owned Iterator<T> {
  iterator_from_runtime_state<T>(state)
}

--- Adapt a typed generator into an iterator, explicitly discarding its
--- completion result after the final yielded value.
pub fn from_generator<T, R>(g: owned Generator<T, R>) -> owned Iterator<T> {
  iter_from_generator_with_dropper<T, R>(g, iter_noop_drop)
}

pub(package) fn iter_from_generator_with_dropper<T, R>(g: owned Generator<T, R>, dropper: () -> nil) -> owned Iterator<T> {
  let state = runtime_iter_state_new(runtime_iter_kind_generator(), generator_into_runtime_state<T, R>(g), 0, dropper)
  iter_make<T>(state)
}

--- Construct an ascending half-open integer iterator `[start, end)`.
pub fn range(start: i64, end: i64) -> owned Iterator<i64> {
  let state = runtime_iter_state_new(runtime_iter_kind_range_i64(), start, end, iter_noop_drop)
  iter_make<i64>(state)
}

--- Construct an empty iterator without allocating a suspended producer.
pub fn empty<T>() -> owned Iterator<T> {
  iter_make<T>(runtime_iter_state_new(runtime_iter_kind_empty(), 0, 0, iter_noop_drop))
}

--- Construct an iterator that yields `value` exactly once.
pub fn once<T>(value: T) -> owned Iterator<T> {
  let producer = () => {
    generator.yield<T>(value)
    0
  }
  from_generator<T, i64>(generator.start<T, i64>(producer))
}

pub(package) fn iter_close_runtime_state<T>(state: i64) -> nil {
  if state == 0 or runtime_iter_state_closed(state) == 1 {
    nil
  } else {
    runtime_iter_state_set_closed(state, 1)
    runtime_iter_state_run_dropper(state)
    runtime_iter_state_release_dropper(state)
    runtime_iter_state_release_generator(state)
    nil
  }
}

pub(package) fn iter_next_runtime_state<T>(state: i64) -> Option<T> {
  match iter_runtime_kind(state) {
    IteratorRuntimeGenerator -> {
      if runtime_iter_state_closed(state) == 1 {
        None<T>()
      } else {
        match generator_next_runtime_state<T>(runtime_iter_state_generator_word(state)) {
          None -> {
            iter_close_runtime_state<T>(state)
            None<T>()
          }
          Some(value) -> Some<T>(value)
        }
      }
    }
    IteratorRuntimeRangeI64 -> {
      let current = runtime_iter_state_first(state)
      let end = runtime_iter_state_second(state)
      if current >= end {
        iter_close_runtime_state<T>(state)
        None<T>()
      } else {
        runtime_iter_state_set_first(state, current + 1)
        Some<T>(runtime_generator_state_word_as<T>(current))
      }
    }
    IteratorRuntimeEmpty -> {
      iter_close_runtime_state<T>(state)
      None<T>()
    }
    IteratorRuntimeUnknown -> {
      iter_close_runtime_state<T>(state)
      None<T>()
    }
  }
}

pub(package) fn iter_drop_runtime_state<T>(state: i64) -> nil {
  if state == 0 { nil }
  else {
    if runtime_iter_state_closed(state) != 1 {
      match iter_runtime_kind(state) {
        IteratorRuntimeGenerator -> iter_close_runtime_state<T>(state)
        IteratorRuntimeRangeI64 -> {
          runtime_iter_state_set_first(state, runtime_iter_state_second(state))
          iter_close_runtime_state<T>(state)
        }
        IteratorRuntimeEmpty -> iter_close_runtime_state<T>(state)
        IteratorRuntimeUnknown -> iter_close_runtime_state<T>(state)
      }
    } else { nil }
    runtime_iter_state_release(state)
    nil
  }
}

pub(package) fn iter_next<T>(iterator: borrow mut Iterator<T>) -> Option<T> {
  iter_next_runtime_state<T>(iterator_runtime_state<T>(iterator))
}

impl<T> Iterator<T> {
  --- Return the next value, or `None` after exhaustion.
  pub fn next(self: borrow mut Self) -> Option<T> {
    iter_next<T>(self)
  }

  --- Consume this iterator and deterministically close its producer.
  pub fn close(self: owned Self) -> nil {
    self.drop()
  }
}

impl<T> Drop for Iterator<T> {
  fn drop(self) -> nil {
    iter_drop_runtime_state<T>(iterator_into_runtime_state<T>(self))
  }
}

--- Lazily transform values with a pure function; dropping the result drops `it`.
pub fn map<T, U>(it: owned Iterator<T>, f: (T) -> U) -> owned Iterator<U> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          generator.yield<U>(f(value))
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<U, i64>(generator.start<U, i64>(producer), dropper)
}

--- Lazily retain values for which `pred` returns true.
--- Dropping the result also drops the source iterator.
pub fn filter<T>(it: owned Iterator<T>, pred: (T) -> bool) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          if pred(value) {
            generator.yield<T>(value)
          } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily yield each `Some` value produced by `f`, discarding `None`.
--- This combines filtering and type-changing mapping in one typed operation.
pub fn filter_map<T, U>(it: owned Iterator<T>, f: (T) -> Option<U>) -> owned Iterator<U> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = false
    while not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          match f(value) {
            Some(mapped) -> {
              generator.yield<U>(mapped)
              nil
            }
            None -> nil
          }
        }
        None -> {
          done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<U, i64>(generator.start<U, i64>(producer), dropper)
}

--- Lazily yield at most `limit` values; a zero limit yields none.
--- Exhausting or dropping the result closes the source iterator.
pub fn take<T>(it: owned Iterator<T>, limit: usize) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut remaining: usize = limit
    let mut done = if limit == 0 { 1 } else { 0 }
    while done == 0 {
      let next = iter_next_runtime_state<T>(source)
      match next {
        Some(value) -> {
          generator.yield<T>(value)
          remaining = remaining - 1
          if remaining == 0 { done = 1 } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily yield every value from `first`, followed by every value from
--- `second`. Dropping the result closes both sources.
pub fn chain<T>(first: owned Iterator<T>, second: owned Iterator<T>) -> owned Iterator<T> {
  let first_source = iterator_into_runtime_state<T>(first)
  let second_source = iterator_into_runtime_state<T>(second)
  let producer = () => {
    let mut first_done = false
    while not first_done {
      match iter_next_runtime_state<T>(first_source) {
        Some(value) -> {
          generator.yield<T>(value)
          nil
        }
        None -> {
          first_done = true
          nil
        }
      }
    }
    let mut second_done = false
    while not second_done {
      match iter_next_runtime_state<T>(second_source) {
        Some(value) -> {
          generator.yield<T>(value)
          nil
        }
        None -> {
          second_done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(first_source)
    iter_drop_runtime_state<T>(second_source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily discard at most `count` leading values, then yield the remainder.
pub fn skip<T>(it: owned Iterator<T>, count: usize) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut remaining = count
    let mut done = false
    while remaining > 0 and not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          remaining = remaining - 1
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    while not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          generator.yield<T>(value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily yield the longest leading run for which `pred` remains true.
--- The first rejected value is consumed, and later values are not read.
pub fn take_while<T>(it: owned Iterator<T>, pred: (T) -> bool) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut done = false
    while not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          if pred(value) {
            generator.yield<T>(value)
          } else {
            done = true
          }
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily discard the longest leading run for which `pred` is true, then
--- yield the first rejected value and every later value without retesting.
pub fn skip_while<T>(it: owned Iterator<T>, pred: (T) -> bool) -> owned Iterator<T> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut skipping = true
    let mut done = false
    while not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          if skipping {
            if pred(value) {
              nil
            } else {
              skipping = false
              generator.yield<T>(value)
            }
          } else {
            generator.yield<T>(value)
          }
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<T, i64>(generator.start<T, i64>(producer), dropper)
}

--- Lazily pair each value with its zero-based position.
pub fn enumerate<T>(it: owned Iterator<T>) -> owned Iterator<(usize, T)> {
  let source = iterator_into_runtime_state<T>(it)
  let producer = () => {
    let mut index: usize = 0
    let mut done = false
    while not done {
      match iter_next_runtime_state<T>(source) {
        Some(value) -> {
          generator.yield<(usize, T)>((index, value))
          index = index + 1
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(source)
  }
  iter_from_generator_with_dropper<(usize, T), i64>(generator.start<(usize, T), i64>(producer), dropper)
}

--- Lazily pair values at the same position, stopping at the shorter source.
--- Each pair is observed left-to-right; dropping the result closes both.
pub fn zip<T, U>(left: owned Iterator<T>, right: owned Iterator<U>) -> owned Iterator<(T, U)> {
  let left_source = iterator_into_runtime_state<T>(left)
  let right_source = iterator_into_runtime_state<U>(right)
  let producer = () => {
    let mut done = false
    while not done {
      match iter_next_runtime_state<T>(left_source) {
        None -> {
          done = true
          nil
        }
        Some(left_value) -> {
          match iter_next_runtime_state<U>(right_source) {
            None -> {
              done = true
              nil
            }
            Some(right_value) -> {
              generator.yield<(T, U)>((left_value, right_value))
              nil
            }
          }
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop_runtime_state<T>(left_source)
    iter_drop_runtime_state<U>(right_source)
  }
  iter_from_generator_with_dropper<(T, U), i64>(generator.start<(T, U), i64>(producer), dropper)
}

--- Consume an iterator and fold its values in order with a pure callback.
pub fn fold<T, A>(it: owned Iterator<T>, init: A, f: (A, T) -> A) -> A {
  let mut source = it
  let mut acc = init
  let mut done = 0
  while done == 0 {
    let next = source.next()
    match next {
      Some(value) -> {
        acc = f(acc, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  acc
}

-- Compiler fusion target for the fully scalar range/map/filter/take/fold
-- shape. This is package-private implementation vocabulary: the optimiser
-- selects it from the resolved traversal-role fact, never from source syntax.
pub(package) fn iter_range_map_filter_take_fold_i64(
  start: i64,
  end: i64,
  map_value: (i64) -> i64,
  keep_value: (i64) -> bool,
  limit: usize,
  init: i64,
  fold_value: (i64, i64) -> i64
) -> i64 {
  let mut current = start
  let mut remaining: usize = limit
  let mut acc = init
  while current < end and remaining > 0 {
    let mapped = map_value(current)
    if keep_value(mapped) {
      acc = fold_value(acc, mapped)
      remaining = remaining - 1
    } else { 0 }
    current = current + 1
  }
  acc
}

--- Consume an iterator and return its remaining value count.
pub fn count<T>(it: owned Iterator<T>) -> usize {
  let mut source = it
  let mut count: usize = 0
  let mut done = 0
  while done == 0 {
    let next = source.next()
    match next {
      Some(value) -> {
        count = count + 1
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  count
}

--- Consume an iterator and return its first value, or `None` when empty.
pub fn first<T>(it: owned Iterator<T>) -> Option<T> {
  let mut source = it
  source.next()
}

--- Consume an iterator and return its last value, or `None` when empty.
pub fn last<T>(it: owned Iterator<T>) -> Option<T> {
  let mut source = it
  let mut result = None<T>()
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        result = Some<T>(value)
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Consume an iterator and return its zero-based `index` value.
--- Return `None` without reading later values when the index is reached.
pub fn nth<T>(it: owned Iterator<T>, index: usize) -> Option<T> {
  let mut source = it
  let mut current: usize = 0
  let mut result = None<T>()
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        if current == index {
          result = Some<T>(value)
          done = true
        } else {
          current = current + 1
        }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Consume an iterator until `pred` accepts a value, then return that value.
pub fn find<T>(it: owned Iterator<T>, pred: (T) -> bool) -> Option<T> {
  let mut source = it
  let mut result = None<T>()
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        if pred(value) {
          result = Some<T>(value)
          done = true
        } else { nil }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Consume an iterator until `f` returns `Some`, changing the result type
--- while expressing filtering through `Option<U>` rather than a sentinel.
pub fn find_map<T, U>(it: owned Iterator<T>, f: (T) -> Option<U>) -> Option<U> {
  let mut source = it
  let mut result = None<U>()
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        match f(value) {
          Some(mapped) -> {
            result = Some<U>(mapped)
            done = true
            nil
          }
          None -> nil
        }
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Return whether `pred` accepts at least one value.
--- An empty iterator returns `false`; later values are not read after a match.
pub fn any<T>(it: owned Iterator<T>, pred: (T) -> bool) -> bool {
  let mut source = it
  let mut result = false
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        if pred(value) {
          result = true
          done = true
        } else { nil }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Return whether `pred` accepts every value.
--- An empty iterator returns `true`; later values are not read after failure.
pub fn all<T>(it: owned Iterator<T>, pred: (T) -> bool) -> bool {
  let mut source = it
  let mut result = true
  let mut done = false
  while not done {
    match source.next() {
      Some(value) -> {
        if not pred(value) {
          result = false
          done = true
        } else { nil }
        nil
      }
      None -> {
        done = true
        nil
      }
    }
  }
  result
}

--- Consume an iterator by combining values from left to right.
--- Return `None` for an empty iterator; use `fold` when a seed is available.
pub fn reduce<T>(it: owned Iterator<T>, f: (T, T) -> T) -> Option<T> {
  let mut source = it
  match source.next() {
    None -> None<T>()
    Some(first_value) -> {
      let mut result = first_value
      let mut done = false
      while not done {
        match source.next() {
          Some(value) -> {
            result = f(result, value)
            nil
          }
          None -> {
            done = true
            nil
          }
        }
      }
      Some<T>(result)
    }
  }
}
