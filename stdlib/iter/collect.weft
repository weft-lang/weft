-- stdlib/iter/collect.weft -- iterator collection adapters

use stdlib/iter/core.{*}
use stdlib/vector.{*}

--- Consume an iterator into a new vector in iteration order.
pub fn iter_collect_vector<T>(it: Iterator<T>) -> Vector<T> {
  let result = vector_new<T>()
  let mut done = 0
  while done == 0 {
    match iter_next<T>(it) {
      Some(value) -> {
        vector_push<T>(result, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

--- Consume, transform, and collect in one pass without an intermediate iterator.
pub fn iter_map_collect_vector<T, U>(it: Iterator<T>, f: (T) -> U) -> Vector<U> {
  let result = vector_new<U>()
  let mut done = 0
  while done == 0 {
    match iter_next<T>(it) {
      Some(value) -> {
        vector_push<U>(result, f(value))
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

--- Consume an `i64` iterator, collecting values whose predicate returns `1`.
pub fn iter_filter_collect_i64(it: Iterator<i64>, pred: (i64) -> i64) -> Vector<i64> {
  let result = vector_new<i64>()
  let mut done = 0
  while done == 0 {
    match iter_next<i64>(it) {
      Some(value) -> {
        if pred(value) == 1 { vector_push<i64>(result, value) } else { 0 }
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

--- Collect at most `limit` values, then explicitly close the source iterator.
--- Non-positive limits collect an empty vector.
pub fn iter_take_collect_vector<T>(it: Iterator<T>, limit: i64) -> Vector<T> {
  let result = vector_new<T>()
  let mut remaining = limit
  let mut done = if limit <= 0 { 1 } else { 0 }
  while done == 0 {
    match iter_next<T>(it) {
      Some(value) -> {
        vector_push<T>(result, value)
        remaining = remaining - 1
        if remaining <= 0 { done = 1 } else { 0 }
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  iter_drop<T>(it)
  result
}
