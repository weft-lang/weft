-- stdlib/iter/collect.weft -- generic iterator collection

use stdlib/iter/protocol.{Collect, Iterator}

impl<T> Iterator<T> {
  --- Consume this iterator into collection `C`.
  pub fn collect<C: Collect & {type Item = T}>(self: owned Self) -> C {
    let result = C.empty()
    result.collect_from(self)
  }
}
