-- Immutable source values and checked byte ranges shared by grammars and tools.

use stdlib/diagnostic/schema.{DiagnosticSource, DiagnosticLocation, DiagnosticSourceRange}
use stdlib/option.{Option, None, Some}
use stdlib/string

--- Immutable source text paired with its diagnostic identity.
--- Ranges retain this value, so their text survives the original binding.
pub type Source {
  --- The complete source contents, indexed by UTF-8 storage byte offsets.
  text: str,
  --- The logical name or buffer identity used by diagnostics.
  identity: DiagnosticSource
}

--- A checked half-open byte range retaining its original source.
--- Byte ranges may point inside a scalar when diagnosing malformed syntax.
pub type Span = opaque (Source, usize, usize)

impl Source {
  --- Select all source bytes, including an empty source's end position.
  pub fn all(self) -> Span {
    Span((self, 0, self.text.len()))
  }

  --- Select `[start, end)`, or return `None` for reversed or invalid bounds.
  pub fn span(self, start: usize, end: usize) -> Option<Span> {
    if start > end or end > self.text.len() {
      None<Span>()
    } else {
      Some<Span>(Span((self, start, end)))
    }
  }
}

impl Span {
  --- Return the original source retained by this range.
  pub fn source(self) -> Source {
    match self { Span((source, start, end)) -> source }
  }

  --- Return the inclusive byte offset in the original source.
  pub fn start(self) -> usize {
    match self { Span((source, start, end)) -> start }
  }

  --- Return the exclusive byte offset in the original source.
  pub fn end(self) -> usize {
    match self { Span((source, start, end)) -> end }
  }

  --- Return this range's byte length.
  pub fn len(self) -> usize {
    match self { Span((source, start, end)) -> end - start }
  }

  --- Return whether this range is an empty source position.
  pub fn is_empty(self) -> bool { self.len() == 0 }

  --- Select a range relative to this one, retaining original-source offsets.
  --- Neither end may exceed this range; invalid or reversed bounds return `None`.
  pub fn subspan(self, start: usize, end: usize) -> Option<Span> {
    match self {
      Span((source, first, last)) -> {
        if start > end or end > last - first {
          None<Span>()
        } else {
          Some<Span>(Span((source, first + start, first + end)))
        }
      }
    }
  }

  --- Read a byte relative to this range, or return `None` beyond its end.
  pub fn byte_at(self, index: usize) -> Option<u8> {
    match self {
      Span((source, start, end)) -> {
        if index >= end - start { None<u8>() }
        else { source.text.byte_at(start + index) }
      }
    }
  }

  --- Copy this range as text, or return `None` if it splits a UTF-8 scalar.
  pub fn text(self) -> Option<str> {
    match self { Span((source, start, end)) -> source.text.slice(start, end) }
  }

  --- Project this range into the shared structured diagnostic vocabulary.
  pub fn location(self) -> DiagnosticLocation {
    match self {
      Span((source, start, end)) -> DiagnosticSourceRange(source.identity, start, end)
    }
  }
}
