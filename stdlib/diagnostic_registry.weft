-- stdlib/diagnostic_registry.weft -- append-only stable diagnostic codes
--
-- Numeric families are reserved by diagnostic class. Entries are ordered by
-- code and may only be appended; an assigned code or summary is never reused
-- or rewritten. `weft explain` consumes this same registry.
--
--   E0xxx parse       E1xxx type        E2xxx effect
--   E3xxx ownership   E4xxx module      E5xxx link
--   E6xxx grammar     E7xxx tool        E8xxx runtime
--   E9xxx test/other

use stdlib/diagnostic_type.{*}

pub type DiagnosticRegistryEntry {
  DiagnosticRegistryEntry(str, DiagnosticClass, str)
}

pub fn diagnostic_registry_count() -> i64 { 1 }

pub fn diagnostic_registry_entry(index: i64) -> DiagnosticRegistryEntry {
  match index {
    0 -> DiagnosticRegistryEntry("E4001", DiagnosticClassModule, "module import graph contains a cycle")
    _ -> DiagnosticRegistryEntry("", DiagnosticClassOther("unknown"), "unknown diagnostic code")
  }
}

pub fn diagnostic_code_module_import_cycle() -> DiagnosticCode {
  DiagnosticCodeAssigned("E4001")
}
