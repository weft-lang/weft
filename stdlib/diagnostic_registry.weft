-- stdlib/diagnostic_registry.weft -- append-only stable diagnostic codes
--
-- Numeric families are reserved by diagnostic class. Entries are ordered by
-- code and may only be appended; an assigned code or summary is never reused
-- or rewritten. `weft explain` consumes this same registry.
--
--   E0xxx/W0xxx parse E1xxx type        E2xxx effect
--   E3xxx ownership   E4xxx module      E5xxx link
--   E6xxx grammar     E7xxx tool        E8xxx runtime
--   E9xxx test/other

use stdlib/diagnostic_type.{*}

--- An append-only diagnostic code, class, and one-line summary.
pub type DiagnosticRegistryEntry {
  --- Construct one registry entry from its stable public fields.
  DiagnosticRegistryEntry(str, DiagnosticClass, str)
}

--- Return the number of assigned diagnostic codes in this schema version.
pub fn diagnostic_registry_count() -> i64 { 26 }

--- Return a registry entry by append-only index, or an unknown sentinel.
pub fn diagnostic_registry_entry(index: i64) -> DiagnosticRegistryEntry {
  match index {
    0 -> DiagnosticRegistryEntry("E4001", DiagnosticClassModule, "module import graph contains a cycle")
    1 -> DiagnosticRegistryEntry("E4002", DiagnosticClassModule, "qualified module member does not exist")
    2 -> DiagnosticRegistryEntry("E4003", DiagnosticClassModule, "qualified module member is ambiguous")
    3 -> DiagnosticRegistryEntry("E4004", DiagnosticClassModule, "qualified module member is not visible")
    4 -> DiagnosticRegistryEntry("E4005", DiagnosticClassModule, "module member has the wrong value kind")
    5 -> DiagnosticRegistryEntry("E4006", DiagnosticClassModule, "re-export widens the original visibility")
    6 -> DiagnosticRegistryEntry("E5001", DiagnosticClassLink, "dependency manifest is malformed")
    7 -> DiagnosticRegistryEntry("E5002", DiagnosticClassLink, "dependency key does not match its package name")
    8 -> DiagnosticRegistryEntry("E5003", DiagnosticClassLink, "dependency resolves to conflicting source identities")
    9 -> DiagnosticRegistryEntry("E5004", DiagnosticClassLink, "package dependency graph contains a cycle")
    10 -> DiagnosticRegistryEntry("E5005", DiagnosticClassLink, "package lock is malformed or unsupported")
    11 -> DiagnosticRegistryEntry("E5006", DiagnosticClassLink, "resolved package identity does not match the lock")
    12 -> DiagnosticRegistryEntry("E5007", DiagnosticClassLink, "dependency manifest attempts to grant package trust")
    13 -> DiagnosticRegistryEntry("E5008", DiagnosticClassLink, "binding module lacks an exact root trust grant")
    14 -> DiagnosticRegistryEntry("E5009", DiagnosticClassLink, "package export does not resolve to the required public declaration")
    15 -> DiagnosticRegistryEntry("W0001", DiagnosticClassParse, "identifier contains mixed scripts")
    16 -> DiagnosticRegistryEntry("W0002", DiagnosticClassParse, "identifier is confusable with another spelling in this source")
    17 -> DiagnosticRegistryEntry("W0003", DiagnosticClassParse, "source text contains an invisible bidi formatting control")
    18 -> DiagnosticRegistryEntry("E1001", DiagnosticClassType, "name is not defined in this scope")
    19 -> DiagnosticRegistryEntry("E1002", DiagnosticClassType, "expression does not match the expected type")
    20 -> DiagnosticRegistryEntry("E1003", DiagnosticClassType, "match does not cover every possible value")
    21 -> DiagnosticRegistryEntry("E2001", DiagnosticClassEffect, "required effect is not available in this context")
    22 -> DiagnosticRegistryEntry("E1004", DiagnosticClassType, "type does not satisfy a required trait")
    23 -> DiagnosticRegistryEntry("E0001", DiagnosticClassParse, "source text cannot be tokenized as Weft")
    24 -> DiagnosticRegistryEntry("E0002", DiagnosticClassParse, "source tokens do not match the Weft grammar")
    25 -> DiagnosticRegistryEntry("E0003", DiagnosticClassParse, "syntax is recognized but not supported")
    _ -> DiagnosticRegistryEntry("", DiagnosticClassOther("unknown"), "unknown diagnostic code")
  }
}

-- Teaching bodies share the registry index so append-only codes, summaries,
-- and explanations cannot silently become separate catalogues. Every body
-- states the cause, the repair direction, and a concrete example.
--- Return the teaching explanation for a registry index, or an empty string.
pub fn diagnostic_registry_explanation(index: i64) -> str {
  match index {
    0 -> "What happened:\nA module can reach itself by following import edges, so there is no well-founded order in which to load the graph.\n\nHow to fix:\nBreak the cycle by moving shared declarations into a third module or by reversing an unnecessary dependency.\n\nExample:\nIf app imports data and data imports app, move their shared types into model and import model from both."
    1 -> "What happened:\nThe qualifier resolved to a module, but that module has no declaration with the requested name.\n\nHow to fix:\nCheck the spelling and the module's public API, or import the module that actually owns the declaration.\n\nExample:\nFor math.square(4), export square from math or change the call to the module where square is declared."
    2 -> "What happened:\nMore than one visible declaration matches the qualified member, so choosing one would make name resolution depend on an arbitrary order.\n\nHow to fix:\nUse a more specific module path, narrow a wildcard import, or rename one imported member.\n\nExample:\nReplace tools.parse with text_tools.parse when both text_tools and data_tools expose parse."
    3 -> "What happened:\nThe declaration exists, but its visibility does not allow access from the requesting module or package.\n\nHow to fix:\nUse a public wrapper, move the call inside the owning boundary, or deliberately widen the declaration to pub when it is part of the API.\n\nExample:\nA private decode_raw helper stays internal; export decode and call codec.decode instead."
    4 -> "What happened:\nThe name resolved, but the declaration is not the kind required at this position, such as using a type where a value or constructor is required.\n\nHow to fix:\nSelect a member of the expected namespace or change the expression to the appropriate declaration form.\n\nExample:\nIf packet.Header is a type, construct its public variant or call a value-level factory instead of calling Header as a function."
    5 -> "What happened:\nA re-export tries to make a declaration more visible than its owner allowed. Re-exporting cannot grant authority the original module withheld.\n\nHow to fix:\nKeep the same or narrower visibility, or widen the declaration at its authoritative definition after reviewing the API boundary.\n\nExample:\nA package-visible helper cannot be re-exported as pub; first make the owning declaration pub."
    6 -> "What happened:\nThe dependency manifest could not be decoded according to the supported package schema.\n\nHow to fix:\nCheck required fields, value types, quoting, and the declared schema or toolchain version.\n\nExample:\nA dependency source must be a supported source object, not an unquoted path or an unknown field shape."
    7 -> "What happened:\nThe local dependency key names one package, but the dependency's own manifest declares a different package name.\n\nHow to fix:\nMake the root dependency key and the dependency manifest name agree; aliases must use the explicit alias mechanism when supported.\n\nExample:\nA dependency keyed as json must not resolve to a package whose manifest name is json_core."
    8 -> "What happened:\nThe resolver found the same package identity through incompatible source or content identities. Continuing would make imports depend on graph traversal order.\n\nHow to fix:\nPin every path to one content identity and regenerate the lock after removing the conflicting source declaration.\n\nExample:\nDo not resolve util from both a local checkout and a different locked archive in one graph."
    9 -> "What happened:\nThe package dependency graph contains a cycle, so package initialization and trust composition have no stable dependency order.\n\nHow to fix:\nExtract the shared API into a lower-level package or invert one dependency through an interface owned by the caller.\n\nExample:\nIf ui depends on model and model depends on ui, move shared messages into a third package."
    10 -> "What happened:\nThe lock file is malformed or uses a schema version this toolchain does not understand. The resolver will not guess at dependency identity.\n\nHow to fix:\nUse the matching Weft toolchain, repair the file, or regenerate it from a valid manifest with weft pkg lock.\n\nExample:\nDelete hand-edited unknown fields and regenerate the lock rather than copying an entry from another schema version."
    11 -> "What happened:\nResolved package bytes do not match the identity recorded in the lock, which can indicate a changed path, stale lock, or tampered source.\n\nHow to fix:\nInspect the source change, then deliberately regenerate the lock if the new content is intended.\n\nExample:\nAfter editing a path dependency, run weft pkg lock and review the changed content digest before building."
    12 -> "What happened:\nA dependency tried to grant trusted authority. Trust is non-transitive and may only be granted explicitly by the root package.\n\nHow to fix:\nRemove the dependency-side trust declaration; if the binding is genuinely required, add the exact grant in the root manifest after auditing it.\n\nExample:\nA TLS package cannot make its own native binding trusted merely by declaring it in its manifest."
    13 -> "What happened:\nA native binding module is not covered by the root manifest's exact trust grant. Similar package or path names do not confer authority.\n\nHow to fix:\nAudit the binding and add the precise package/module grant at the root, or replace it with a safe implementation.\n\nExample:\nGrant vendor_tls/native explicitly; granting vendor_tls or another sibling module is not sufficient."
    14 -> "What happened:\nA package export does not resolve to a public declaration at the required module identity. Private, missing, or wrong-kind declarations cannot form the package API.\n\nHow to fix:\nCorrect the export path and make the authoritative declaration public without widening unrelated helpers.\n\nExample:\nExport codec.decode only when decode is pub in the codec module named by the manifest."
    15 -> "What happened:\nOne identifier mixes scripts in a way that can disguise its spelling and make review unsafe.\n\nHow to fix:\nUse a single expected script for the identifier, or rename it to an unambiguous ASCII spelling when scripts must interact nearby.\n\nExample:\nDo not mix Latin a with Cyrillic letters inside one variable name; rename the whole identifier consistently."
    16 -> "What happened:\nTwo identifier spellings in the same source have the same security skeleton and may be visually confusable even though their Unicode scalars differ.\n\nHow to fix:\nRename one identifier so the distinction is visible and meaningful; copying the intended spelling from its declaration is safest.\n\nExample:\nLatin pay and a lookalike spelling using Cyrillic characters must not coexist as separate names."
    17 -> "What happened:\nSource text contains an invisible bidirectional formatting control that can make displayed token order differ from compiled token order.\n\nHow to fix:\nRemove the control and express direction in string data or editor metadata, never in executable source layout.\n\nExample:\nA right-to-left override beside a comment or delimiter must be deleted rather than hidden in the file."
    18 -> "What happened:\nName lookup found no declaration visible under this spelling in the current lexical and module scope.\n\nHow to fix:\nCorrect the spelling, add the required selective or qualified import, or declare the value before use.\n\nExample:\nUse math.square(4) after importing math, or selectively import square before calling square(4)."
    19 -> "What happened:\nA value's checked type is not a subtype of the type required by its context. Weft does not insert an implicit conversion that could hide the mismatch.\n\nHow to fix:\nPass the expected type, change the annotation or signature when it is wrong, or call an explicit checked conversion.\n\nExample:\nFor fn twice(n: i64), call twice(2), not twice(\"2\"); parse the string first if it is external input."
    20 -> "What happened:\nThe match leaves at least one value in the scrutinee type uncovered. Guards do not count as total coverage because they may be false.\n\nHow to fix:\nAdd arms for the missing variants or a final unguarded arm that deliberately handles the residual set.\n\nExample:\nMatching Option<T> requires both Some(value) and None unless an earlier type narrowing proves one impossible."
    21 -> "What happened:\nThe expression may perform an effect that is absent from the surrounding function signature and is not discharged by an enclosing handler.\n\nHow to fix:\nAdd the exact effect to the function contract, install an appropriate handler, or use a pure operation.\n\nExample:\nA call to ConsoleWrite.print inside fn run() -> nil must be handled or run must declare -[ConsoleWrite]> nil."
    22 -> "What happened:\nA generic operation requires a trait, but the checked argument type has no matching visible implementation satisfying that bound.\n\nHow to fix:\nUse a conforming type, add a lawful non-overlapping implementation in an allowed package, or relax the generic requirement if the algorithm does not need it.\n\nExample:\nSorting Vector<Item> requires Item: Ord and an Ord implementation with the required method signature."
    23 -> "What happened:\nThe byte stream is not valid Weft source text, for example because UTF-8, normalization, identifier, or forbidden-control invariants fail before grammar parsing.\n\nHow to fix:\nSave the file as valid UTF-8, normalize source identifiers to NFC, and remove invalid or invisible source scalars.\n\nExample:\nReplace a malformed UTF-8 byte sequence instead of relying on replacement-character decoding."
    24 -> "What happened:\nThe source was tokenized, but the tokens do not form a valid Weft construct at this location. The primary label points at the first token where the parser could no longer continue that construct.\n\nHow to fix:\nUse the expected token named by the diagnostic and check the immediately preceding delimiter or declaration.\n\nExample:\nA function signature needs balanced parameter parentheses and a complete braced body."
    25 -> "What happened:\nThe parser recognized a reserved language shape, but this toolchain deliberately fences it because its semantics are not implemented soundly yet.\n\nHow to fix:\nUse the supported alternative named by the diagnostic or wait for the owning language brief; do not rely on the rejected spelling being ignored.\n\nExample:\nWhen a diagnostic rejects an unsupported call-site label, pass the argument positionally rather than assuming the label is checked."
    _ -> ""
  }
}

--- Return whether a registry index has a teaching explanation.
pub fn diagnostic_registry_has_explanation(index: i64) -> bool {
  __str_len(diagnostic_registry_explanation(index)) > 0
}

--- Return `E4001`, module import graph cycle.
pub fn diagnostic_code_module_import_cycle() -> DiagnosticCode {
  DiagnosticCodeAssigned("E4001")
}

--- Return `E4002`, missing qualified module member.
pub fn diagnostic_code_module_member_missing() -> DiagnosticCode { DiagnosticCodeAssigned("E4002") }
--- Return `E4003`, ambiguous qualified module member.
pub fn diagnostic_code_module_member_ambiguous() -> DiagnosticCode { DiagnosticCodeAssigned("E4003") }
