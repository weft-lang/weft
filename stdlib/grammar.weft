-- Grammar-owned syntax over retained source with explicit recovery.

use stdlib/source.{Span}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/typecheck.{TypeCheck}

--- The result of parsing, independently of any checking or execution step.
pub type ParseResult<T> {
  --- Complete syntax with no parse errors; warnings may still be reported.
  Parsed(T),
  --- Partial syntax retained for tooling after reporting parse errors.
  Recovered(T),
  --- Input could not produce a syntax product; errors have been reported.
  Rejected
}

--- The result of semantic checking, distinct from recoverable parse syntax.
--- Only `Checked` contains a value that lowering or execution may consume.
pub type CheckResult<T> {
  --- A semantically valid grammar-owned checked representation.
  Checked(T),
  --- Checking failed after reporting structured diagnostics.
  CheckRejected
}

--- A language's source parser; source acquisition is supplied by its caller.
--- Implementations own their syntax and need not produce a token stream.
pub trait Grammar {
  --- The grammar's structured syntax product, before semantic checking.
  type Syntax
  --- Parse a retained source range and report diagnostics in its source space.
  fn parse(self, source: Span) -[Diagnose]> ParseResult<Self.Syntax>
}

--- A grammar's semantic pass over its own syntax representation.
---
--- `Identity` is selected by the checker value so a compiler handler can use
--- scoped opaque identities while a test catalog can use ordinary values.
--- Host inspection and diagnostics are the only capabilities in this common
--- contract; lowering and execution are separate interpretations.
pub trait CheckedGrammar {
  --- The grammar-owned representation accepted from parsing.
  type Syntax
  --- The grammar-owned semantic representation produced on success.
  type Checked
  --- The identity domain interpreted by the installed host type handler.
  type Identity
  --- Check syntax against host types and report source-aware diagnostics.
  fn check(
    self,
    syntax: Self.Syntax
  ) -[TypeCheck<Self.Identity>, Diagnose]> CheckResult<Self.Checked>
}
