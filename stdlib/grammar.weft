-- Grammar-owned syntax over retained source with explicit recovery.

use stdlib/source.{Span}
use stdlib/diagnostic/schema.{Diagnose}

--- The result of parsing, independently of any checking or execution step.
pub type ParseResult<T> {
  --- Complete syntax with no parse errors; warnings may still be reported.
  Parsed(T),
    --- Partial syntax retained for tooling after reporting parse errors.
    Recovered(T),
    --- Input could not produce a syntax product; errors have been reported.
    Rejected
}

--- A language's source parser; source acquisition is supplied by its caller.
--- Implementations own their syntax and need not produce a token stream.
pub trait Grammar {
  --- The grammar's structured syntax product, before semantic checking.
  type Syntax
  --- Parse a retained source range and report diagnostics in its source space.
  fn parse(self, source: Span) -[Diagnose]> ParseResult<Self.Syntax>
}
