-- stdlib/default.weft — canonical construction of ordinary default values

use stdlib/option.{*}
use stdlib/list.{*}

--- Canonical construction of an ordinary default value.
pub trait Default {
  --- Construct the implementing type's canonical default.
  fn default() -> Self
}

--- Construct the canonical default for `T`.
pub fn default<T: Default>() -> T {
  T.default()
}

impl Default for i8 {
  fn default() -> Self { 0 }
}

impl Default for i16 {
  fn default() -> Self { 0 }
}

impl Default for i32 {
  fn default() -> Self { 0 }
}

impl Default for i64 {
  fn default() -> Self { 0 }
}

impl Default for isize {
  fn default() -> Self { 0 }
}

impl Default for u8 {
  fn default() -> Self { 0 }
}

impl Default for u16 {
  fn default() -> Self { 0 }
}

impl Default for u32 {
  fn default() -> Self { 0 }
}

impl Default for u64 {
  fn default() -> Self { 0 }
}

impl Default for usize {
  fn default() -> Self { 0 }
}

impl Default for f32 {
  fn default() -> Self { 0.0 }
}

impl Default for f64 {
  fn default() -> Self { 0.0 }
}

impl Default for bool {
  fn default() -> Self { false }
}

impl Default for str {
  fn default() -> Self { "" }
}

impl Default for nil {
  fn default() -> Self { nil }
}

impl<T> Default for Option<T> {
  fn default() -> Self { option_none<T>() }
}

impl<T> Default for List<T> {
  fn default() -> Self { list_nil<T>() }
}
