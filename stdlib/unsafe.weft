-- stdlib/unsafe.weft -- typed boundary for unsafe operations
--
-- Unsafe is an effect. Operations that fabricate pointers, reinterpret memory,
-- call raw syscalls, or cross FFI boundaries must carry -[Unsafe]> until a
-- trusted wrapper handles the effect and exposes a safe API.

effect Unsafe {
  fn raw_offset(ptr: i64, offset: i64) -> i64
  fn transmute(value: i64) -> i64
  fn raw_syscall(num: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
  fn int_to_ptr(addr: i64) -> i64
  fn runtime_state() -> i64
  fn raw_call_i64(fn_ptr: i64, arg: i64) -> i64
}

fn unsafe_raw_offset(ptr: i64, offset: i64) -[Unsafe]> i64 {
  Unsafe.raw_offset(ptr, offset)
}

fn unsafe_transmute(value: i64) -[Unsafe]> i64 {
  Unsafe.transmute(value)
}

fn unsafe_raw_syscall(num: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -[Unsafe]> i64 {
  Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5)
}

fn unsafe_int_to_ptr(addr: i64) -[Unsafe]> i64 {
  Unsafe.int_to_ptr(addr)
}

fn unsafe_runtime_state() -[Unsafe]> i64 {
  Unsafe.runtime_state()
}

fn unsafe_raw_call_i64(fn_ptr: i64, arg: i64) -[Unsafe]> i64 {
  Unsafe.raw_call_i64(fn_ptr, arg)
}
