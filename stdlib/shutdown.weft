--- The external process event that requested structured shutdown.
--- This intentionally names only the two portable graceful-termination
--- sources installed by Spawn's production handler. It is not an arbitrary
--- signal-number or process-control API.
pub type ShutdownSignal {
  --- Interactive interruption (`SIGINT` on supported platforms).
  ShutdownInterrupt,
    --- Service termination (`SIGTERM` on supported platforms).
    ShutdownTerminate,
}
