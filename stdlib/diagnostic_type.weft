-- stdlib/diagnostic_type.weft -- stable L8 diagnostic value/effect contract

-- This declaration-only surface lets effect signatures depend on Diagnose
-- without pulling diagnostic helper implementations into analysis inputs.

use stdlib/semantic_type.{*}

--- The presentation and control-flow severity of a diagnostic.
pub type DiagnosticSeverity {
  --- A failure that prevents the requested operation from succeeding.
  DiagnosticSeverityError
  --- A recoverable concern that should be brought to the user's attention.
  DiagnosticSeverityWarning
  --- Supporting information that is neither an error nor a warning.
  DiagnosticSeverityNote
}

--- The subsystem or language concept responsible for a diagnostic.
pub type DiagnosticClass {
  --- Source decoding, lexing, parsing, or parser-recovery diagnostics.
  DiagnosticClassParse
  --- Type checking and type-relation diagnostics.
  DiagnosticClassType
  --- Effect availability, discharge, or identity diagnostics.
  DiagnosticClassEffect
  --- Ownership, borrowing, lifetime, or cleanup diagnostics.
  DiagnosticClassOwnership
  --- Module resolution, visibility, and import diagnostics.
  DiagnosticClassModule
  --- Package, binding, binary, or link diagnostics.
  DiagnosticClassLink
  --- Embedded-grammar diagnostics.
  DiagnosticClassGrammar
  --- Formatter, test runner, LSP, MCP, or other tool diagnostics.
  DiagnosticClassTool
  --- Diagnostics produced while executing a compiled program.
  DiagnosticClassRuntime
  --- Native test assertion and harness diagnostics.
  DiagnosticClassTest
  --- An additive diagnostic family identified by a stable display name.
  DiagnosticClassOther(str)
}

--- A stable registry code, or the explicit legacy unassigned state.
pub type DiagnosticCode {
  --- A diagnostic not yet assigned an append-only registry code.
  DiagnosticCodeUnassigned
  --- A stable, append-only diagnostic code such as `E1002`.
  DiagnosticCodeAssigned(str)
}

--- The identity of source text referenced by a diagnostic.
pub type DiagnosticSource {
  --- An unavailable or deliberately unspecified source identity.
  DiagnosticSourceUnknown
  --- An opaque in-process source-buffer identity.
  DiagnosticSourceBuffer(i64)
  --- A source identified by its logical path or display name.
  DiagnosticSourceNamed(str)
}

--- A location in source text using half-open UTF-8 byte offsets.
pub type DiagnosticLocation {
  --- A diagnostic with no source range.
  DiagnosticLocationNone
  --- The half-open byte range `[start, end)` within a source.
  DiagnosticSourceRange(DiagnosticSource, i64, i64)
}

--- A labelled source location that explains or supports a diagnostic.
pub type DiagnosticRelatedLocation {
  --- Pair a human-readable relationship label with its source location.
  DiagnosticRelatedLocation(str, DiagnosticLocation)
}

--- An ordered list of related diagnostic locations.
pub type DiagnosticRelatedLocationList {
  --- An empty related-location list.
  DiagnosticRelatedLocationNil
  --- A related location followed by the rest of the list.
  DiagnosticRelatedLocationCons(DiagnosticRelatedLocation, DiagnosticRelatedLocationList)
}

--- A producer's confidence that a suggested edit can be applied as written.
pub type DiagnosticSuggestionApplicability {
  --- No applicability guarantee was supplied.
  DiagnosticSuggestionUnspecified
  --- The producer guarantees that tools may apply the edit mechanically.
  DiagnosticSuggestionMachineApplicable
  --- The edit is plausible but requires user review.
  DiagnosticSuggestionMaybeIncorrect
}

--- One source replacement proposed by a diagnostic.
pub type DiagnosticTextEdit {
  --- Replace a half-open source location with the given text.
  DiagnosticTextEdit(DiagnosticLocation, str)
}

--- An ordered list of source edits in a diagnostic suggestion.
pub type DiagnosticTextEditList {
  --- An empty text-edit list.
  DiagnosticTextEditNil
  --- A text edit followed by the rest of the list.
  DiagnosticTextEditCons(DiagnosticTextEdit, DiagnosticTextEditList)
}

--- A teaching message plus its applicability and structured source edits.
pub type DiagnosticSuggestion {
  --- Construct a suggestion from prose, applicability, and ordered edits.
  DiagnosticSuggestion(str, DiagnosticSuggestionApplicability, DiagnosticTextEditList)
}

-- Machine-actionable payload fields are deliberately a small open value
-- algebra. Consumers must keep an `other` arm when matching this type; later
-- teaching payloads can add variants without changing the envelope.
--- An extensible, machine-actionable field in a structured diagnostic.
pub type DiagnosticField {
  --- A named text value.
  DiagnosticFieldText(str, str)
  --- A named signed integer value.
  DiagnosticFieldI64(str, i64)
  --- A named boolean value.
  DiagnosticFieldBool(str, bool)
  --- A named source location.
  DiagnosticFieldLocation(str, DiagnosticLocation)
  --- A named semantic type fact in source vocabulary.
  DiagnosticFieldType(str, SemanticTypeFact)
  --- A named declaration-resolved semantic effect atom.
  DiagnosticFieldEffectAtom(str, SemanticEffectAtomFact)
  --- A named semantic effect set.
  DiagnosticFieldEffectSet(str, SemanticEffectSetFact)
  --- A structured repair suggestion and any typed edits it carries.
  DiagnosticFieldSuggestion(DiagnosticSuggestion)
}

--- An ordered list of extensible diagnostic payload fields.
pub type DiagnosticFieldList {
  --- An empty diagnostic-field list.
  DiagnosticFieldNil
  --- A diagnostic field followed by the rest of the list.
  DiagnosticFieldCons(DiagnosticField, DiagnosticFieldList)
}

--- A versioned structured diagnostic independent of any renderer.
pub type Diagnostic {
  --- Construct a diagnostic envelope from its stable schema fields.
  Diagnostic(
    DiagnosticSeverity,
    DiagnosticClass,
    DiagnosticCode,
    str,
    DiagnosticLocation,
    DiagnosticRelatedLocationList,
    DiagnosticFieldList
  )
}

--- Structured diagnostic reporting supplied by a compiler or tool handler.
pub effect Diagnose {
  -- Canonical structured operation. The legacy operations remain during the
  -- producer migration; new consumers and failure events use report.
  --- Report one canonical structured diagnostic.
  fn report(diagnostic: Diagnostic) -> i64
  --- Report a legacy uncoded error at a byte span.
  fn error(msg: str, span: i64) -> i64
  --- Report a legacy uncoded warning at a byte span.
  fn warn(msg: str, span: i64) -> i64
  --- Report a legacy uncoded note at a byte span.
  fn note(msg: str, span: i64) -> i64
}
