-- stdlib/semantic_type.weft -- stable source-level type vocabulary
--
-- L7 tooling facts and L8 diagnostics share these values. Keeping the
-- vocabulary below compiler internals guarantees that hovers, diagnostics,
-- MCP, and LSP cannot drift into separate renderings of the same type.

--- A stable, additive source-vocabulary description of a type.
---
--- These facts preserve the type spelling and structure useful to tools; they
--- are not the compiler's normalized DNF representation. Consumers must
--- accept `SemanticTypeOther` so newer producers remain forward compatible.
pub type SemanticTypeFact {
  --- The empty type, written `never`.
  SemanticTypeBottom,
  --- The universal type, written `any`.
  SemanticTypeTop,
  --- A primitive type named by its source spelling, such as `i64` or `str`.
  SemanticTypePrimitive(str),
  --- An unqualified named type and its ordered type arguments.
  SemanticTypeNamed(str, SemanticTypeFactList),
  --- A module-qualified named type and its ordered type arguments.
  SemanticTypeQualifiedNamed(str, str, SemanticTypeFactList),
  --- A type variable named by its source spelling.
  SemanticTypeVariable(str),
  --- The union of two source-level type facts.
  SemanticTypeUnion(SemanticTypeFact, SemanticTypeFact),
  --- The intersection of two source-level type facts.
  SemanticTypeIntersection(SemanticTypeFact, SemanticTypeFact),
  --- The complement of a source-level type fact.
  SemanticTypeComplement(SemanticTypeFact),
  --- A function's ordered parameters, result, and declared effect set.
  SemanticTypeFunction(SemanticTypeFactList, SemanticTypeFact, SemanticEffectSetFact),
  --- Record or tuple fields, followed by `open` and `tuple` flags.
  SemanticTypeRecord(SemanticRecordFieldFactList, bool, bool),
  --- A one-shot continuation from its input type to its output type.
  SemanticTypeContinuation(SemanticTypeFact, SemanticTypeFact),
  --- A pointer to an inner type; the boolean records mutable access.
  SemanticTypePointer(SemanticTypeFact, bool),
  --- A weak managed reference to an inner type.
  SemanticTypeWeak(SemanticTypeFact),
  --- A unique value of an inner type.
  SemanticTypeUnique(SemanticTypeFact),
  --- An owned resource of an inner type.
  SemanticTypeOwned(SemanticTypeFact),
  --- A borrow of an inner type; the boolean records mutable access.
  SemanticTypeBorrow(SemanticTypeFact, bool),
  --- An unqualified trait atom.
  SemanticTypeTrait(str),
  --- A module-qualified trait atom.
  SemanticTypeQualifiedTrait(str, str),
  --- A fixed-length array's element type and length.
  SemanticTypeArray(SemanticTypeFact, i64),
  --- A slice's element type; the boolean records mutable access.
  SemanticTypeSlice(SemanticTypeFact, bool),
  --- An associated type selected from its owner type.
  SemanticTypeAssociated(SemanticTypeFact, str),
  --- An additive type form preserved by its canonical source spelling.
  SemanticTypeOther(str)
}

--- An ordered, extensible list of semantic type facts.
pub type SemanticTypeFactList {
  --- An empty semantic-type list.
  SemanticTypeFactListNil,
  --- A semantic type fact followed by the rest of the list.
  SemanticTypeFactListCons(SemanticTypeFact, SemanticTypeFactList),
  --- An additive list tail preserved by its canonical source spelling.
  SemanticTypeFactListOther(str)
}

--- One named or positional field in a semantic record or tuple fact.
pub type SemanticRecordFieldFact {
  --- A field's source name, zero-based position, and semantic type.
  SemanticRecordField(str, i64, SemanticTypeFact),
  --- An additive field form preserved by its canonical source spelling.
  SemanticRecordFieldOther(str)
}

--- An ordered, extensible list of semantic record-field facts.
pub type SemanticRecordFieldFactList {
  --- An empty record-field list.
  SemanticRecordFieldFactListNil,
  --- A semantic record field followed by the rest of the list.
  SemanticRecordFieldFactListCons(SemanticRecordFieldFact, SemanticRecordFieldFactList),
  --- An additive field-list tail preserved by its canonical source spelling.
  SemanticRecordFieldFactListOther(str)
}

--- A declaration-resolved effect identity and its ordered type arguments.
pub type SemanticEffectAtomFact {
  --- An unqualified effect atom and its ordered type arguments.
  SemanticEffectAtom(str, SemanticTypeFactList),
  --- A module-qualified effect atom and its ordered type arguments.
  SemanticQualifiedEffectAtom(str, str, SemanticTypeFactList),
  --- An additive effect form preserved by its canonical source spelling.
  SemanticEffectAtomOther(str)
}

--- An ordered, extensible list of semantic effect atoms.
pub type SemanticEffectAtomFactList {
  --- An empty effect-atom list.
  SemanticEffectAtomFactListNil,
  --- A semantic effect atom followed by the rest of the list.
  SemanticEffectAtomFactListCons(SemanticEffectAtomFact, SemanticEffectAtomFactList),
  --- An additive atom-list tail preserved by its canonical source spelling.
  SemanticEffectAtomFactListOther(str)
}

--- A closed or polymorphically open semantic effect set.
pub type SemanticEffectSetFact {
  --- A closed set containing exactly the ordered effect atoms.
  SemanticEffectsClosed(SemanticEffectAtomFactList),
  --- Concrete effect atoms plus a named polymorphic tail.
  SemanticEffectsOpen(SemanticEffectAtomFactList, str),
  --- An additive effect-set form preserved by its canonical source spelling.
  SemanticEffectsOther(str)
}
