-- stdlib/string/builder.weft -- linearly owned UTF-8 construction

use runtime/string.{runtime_str_byte_at, runtime_str_from_bytes_copy, runtime_str_len}
use stdlib/drop.{Drop}
use stdlib/num/scalar.{num_scalar_i64_to_usize, num_scalar_usize_checked_add, num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/vector as vector
use stdlib/vector.{vector_data, vector_len, vector_push_reserved, vector_reserve}
use stdlib/vector/handles.{Vector}

--- A linearly owned append-only builder for immutable UTF-8 text.
---
--- Its mutable byte storage is private. Only complete `str` values can be
--- appended, so ordinary code cannot create malformed intermediate text.
pub type Builder = opaque owned Vector<u8>

--- Construct an empty text builder.
pub fn new() -> owned Builder {
  Builder(vector.new<u8>())
}

--- Construct an empty text builder with room for at least `byte_capacity`
--- encoded bytes.
pub fn with_capacity(byte_capacity: usize) -> owned Builder {
  Builder(vector.with_capacity<u8>(byte_capacity))
}

fn builder_storage_sum(left: i64, right: i64) -> i64 {
  let left_count = match num_scalar_i64_to_usize(left) {
    Some(value) -> value
    None -> panic("String builder length invariant violated")
  }
  let right_count = match num_scalar_i64_to_usize(right) {
    Some(value) -> value
    None -> panic("String length invariant violated")
  }
  let total = match num_scalar_usize_checked_add(left_count, right_count) {
    Some(value) -> value
    None -> panic("String builder capacity is too large")
  }
  match num_scalar_usize_to_i64(total) {
    Some(value) -> value
    None -> panic("String builder capacity is too large")
  }
}

impl Builder {
  --- Return the number of encoded bytes appended so far.
  pub fn len(self: borrow Self) -> usize {
    match self { Builder(values) -> values.len() }
  }

  --- Return whether no text has been appended.
  pub fn is_empty(self: borrow Self) -> bool {
    self.len() == 0
  }

  --- Append one complete UTF-8 string.
  pub fn append(self: borrow mut Self, text: str) -> nil {
    match self {
      Builder(values) -> {
        let length = runtime_str_len(text)
        let needed = builder_storage_sum(vector_len<u8>(values), length)
        if vector_reserve<u8>(values, needed) { nil }
        else { panic("String builder capacity is too large") }
        for index in 0..length {
          let byte = __i64_to_u8(runtime_str_byte_at(text, index))
          if vector_push_reserved<u8>(values, byte) { nil }
          else { panic("String builder capacity invariant violated") }
        }
      }
    }
  }

  --- Consume the builder and copy its initialized bytes into immutable text.
  pub fn finish(self: owned Self) -> str {
    match self {
      Builder(values) -> {
        runtime_str_from_bytes_copy(vector_data<u8>(values), vector_len<u8>(values))
      }
    }
  }
}

impl Drop for Builder {
  fn drop(self) -> nil {
    match self {
      Builder(values) -> values.drop()
    }
  }
}
