fn par_task_run_raw(task: i64) -[Unsafe]> i64 {
  runtime_par_task_run_raw(task)
}

fn par_task_run(task: i64) -> i64 {
  runtime_par_task_run(task)
}

fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 {
  let task = par_task_new(f, arg)
  par_task_run(task)
  task
}

fn par_work_sequential_submit(work: i64) -> i64 {
  runtime_par_work_run(work)
  work
}

-- The proven monomorphic task cell remains only as a scheduling envelope:
-- workers receive one typed carrier and execute its compiler-emitted entry.
-- Queue saturation runs that same carrier inline, so submission never erases
-- T and never manufactures an untyped result/sentinel path.
fn par_work_pthread_submit(pool: i64, work: i64) -> i64 {
  if pool == 0 or work == 0 {
    par_work_sequential_submit(work)
  } else {
    runtime_par_work_promote_closure(work)
    let envelope = par_pool_task_new(pool, runtime_par_work_run, work)
    if par_pool_enqueue_task(pool, envelope) == 1 { work }
    else {
      par_task_discard_unawaited(envelope)
      par_work_sequential_submit(work)
    }
  }
}

fn par_task_await_result(task: i64) -> ParRuntimeResult {
  if task == 0 {
    ParErr(par_error_invalid_handle())
  } else {
    if par_task_done(task) == 0 {
      ParErr(par_error_not_ready())
    } else {
      if par_task_awaited(task) != 0 {
        ParErr(par_error_already_awaited())
      } else {
        runtime_par_task_release_for_await(task)
        ParOk(par_task_result(task))
      }
    }
  }
}

fn par_task_await(task: i64) -> i64 {
  par_runtime_result_unwrap_or(par_task_await_result(task), 0)
}

fn par_task_discard_unawaited(task: i64) -> i64 {
  if task == 0 {
    par_error_invalid_handle()
  } else {
    runtime_par_task_discard_unawaited(task)
  }
}

