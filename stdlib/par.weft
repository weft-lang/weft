    }
  }
}

fn par_pthread_cond_wait_raw(cond: i64, mutex: i64) -[Unsafe]> i64 {
  __got_pthread_cond_wait(cond, mutex, 0, 0, 0, 0)
}

fn par_pthread_cond_signal_raw(cond: i64) -[Unsafe]> i64 {
  __got_pthread_cond_signal(cond, 0, 0, 0, 0, 0)
}

fn par_pthread_cond_broadcast_raw(cond: i64) -[Unsafe]> i64 {
  __got_pthread_cond_broadcast(cond, 0, 0, 0, 0, 0)
