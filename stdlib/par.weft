fn par_pthread_cond_signal(cond: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(par_pthread_cond_signal_raw(cond))
  }
