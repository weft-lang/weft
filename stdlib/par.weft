-- stdlib/par.weft -- Structured concurrency via algebraic effects
--
-- Par is an effect for parallel execution. The effect DECLARATION is here.
-- Handlers install the runtime policy. The default linked-test policy below
-- uses pthread helpers, while later runtime work can replace it with a worker
-- pool without changing the Par effect surface.
--
-- Usage (in main source file):
--
--   use "stdlib/par.weft"
--
--   fn my_computation() -[Par]> i64 {
--     let a = Par.spawn(worker1, arg1)
--     let b = Par.spawn(worker2, arg2)
--     Par.await(a) + Par.await(b)
--   }
--
--   fn main() -> i64 {
--     handle my_computation() {
--       Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
--       Par.await(h) -> resume(par_pthread_await(h))
--     }
--   }

use "stdlib/list.weft"
use "runtime/par_pool_storage.weft"
use "runtime/par_pthread.weft"
use "runtime/par_queue.weft"
use "runtime/par_sync.weft"
use "runtime/par_task.weft"
use "runtime/rc.weft"

type ParRuntimeResult {
  ParOk(i64),
  ParErr(i64)
}

effect Par {
  fn spawn(f: (i64) -> i64, arg: i64) -> i64,
  fn await(h: i64) -> i64,
  fn submit(work: i64) -> i64,
  fn join(task: i64) -> i64
}

fn par_spawn<T: Sendable>(f: () -> T) -[Par]> unique ParTask<T> {
  runtime_par_task_from_word<T>(Par.submit(runtime_par_work_pack<T>(f)))
}

fn par_await<T>(task: unique ParTask<T>) -[Par]> T {
  runtime_par_work_take<T>(Par.join(runtime_par_task_observation_word<T>(task)))
}

fn par_error_invalid_handle() -> i64 { 0 - 1 }
fn par_error_already_awaited() -> i64 { 0 - 2 }
fn par_error_not_ready() -> i64 { 0 - 3 }
fn par_error_queue_full() -> i64 { 0 - 4 }

fn par_runtime_result_unwrap_or(res: ParRuntimeResult, default: i64) -> i64 {
  match res {
    ParOk(v) -> v
    ParErr(e) -> default
  }
}

fn par_pthread_make_handle(tid: i64) -> i64 {
  runtime_par_pthread_make_handle(tid)
}

fn par_pthread_create_status_result(status: i64, tid: i64) -> ParRuntimeResult {
  if status == 0 {
    ParOk(par_pthread_make_handle(tid))
  } else {
    ParErr(status)
  }
}

fn par_pthread_handle_is_valid(h: i64) -> bool {
  runtime_par_pthread_handle_is_valid(h)
}

fn par_pthread_spawn_result(f: (i64) -> i64, arg: i64) -> ParRuntimeResult {
  closure_default_promote(f)
  rc_default_promote_maybe(arg)
  let created = runtime_par_pthread_spawn(f, arg)
  par_pthread_create_status_result(runtime_par_pair_status(created), runtime_par_pair_value(created))
}

fn par_pthread_spawn(f: (i64) -> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_spawn_result(f, arg), 0)
}

fn par_pthread_await_result(h: i64) -> ParRuntimeResult {
  if par_pthread_handle_is_valid(h) == false {
    ParErr(par_error_invalid_handle())
  } else {
    if runtime_par_pthread_handle_joined(h) != 0 {
      ParErr(par_error_already_awaited())
    } else {
      let joined = runtime_par_pthread_join_handle(h)
      if runtime_par_pair_status(joined) == 0 {
        runtime_par_pthread_handle_mark_joined(h)
        ParOk(runtime_par_pair_value(joined))
      } else {
        ParErr(runtime_par_pair_status(joined))
      }
    }
  }
}

fn par_pthread_await(h: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_await_result(h), 0)
}

fn par_pthread_spawn_unsafe_result(f: (i64) -[Unsafe]> i64, arg: i64) -> ParRuntimeResult {
  closure_default_promote(f)
  rc_default_promote_maybe(arg)
  let created = runtime_par_pthread_spawn_unsafe(f, arg)
  par_pthread_create_status_result(runtime_par_pair_status(created), runtime_par_pair_value(created))
}

fn par_pthread_spawn_unsafe(f: (i64) -[Unsafe]> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_spawn_unsafe_result(f, arg), 0)
}

fn par_task_new(f: (i64) -> i64, arg: i64) -> i64 {
  runtime_par_task_new(f, arg)
}

fn par_task_new_promoted(f: (i64) -> i64, arg: i64) -> i64 {
  closure_default_promote(f)
  rc_default_promote_maybe(arg)
  par_task_new(f, arg)
}

fn par_pool_task_new(pool: i64, f: (i64) -> i64, arg: i64) -> i64 {
