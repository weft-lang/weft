fn par_current_runtime_state() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

fn par_worker_new(worker_id: i64, pool: i64, local_queue: i64, shared_queue: i64, worker_count: i64) -> i64 {
  let worker = alloc_bump(par_worker_size())
  __mem_store64(worker + par_worker_id_offset(), worker_id)
  __mem_store64(worker + par_worker_pool_offset(), pool)
  __mem_store64(worker + par_worker_local_queue_offset(), local_queue)
  __mem_store64(worker + par_worker_shared_queue_offset(), shared_queue)
  __mem_store64(worker + par_worker_count_offset(), worker_count)
  __mem_store64(worker + par_worker_runtime_state_offset(), par_current_runtime_state())
  __mem_store64(worker + par_worker_handler_stack_offset(), 0)
  worker
}

fn par_worker_id(worker: i64) -> i64 {
  __mem_load64(worker + par_worker_id_offset())
}

