-- stdlib/par.weft -- Structured concurrency via algebraic effects
--
-- Par is an effect for parallel execution. The effect DECLARATION is here.
-- Handlers install the runtime policy. The default linked-test policy below
-- uses pthread helpers, while later runtime work can replace it with a worker
-- pool without changing the Par effect surface.
--
-- Usage (in main source file):
--
--   use "stdlib/par.weft"
--
--   fn my_computation() -[Par]> i64 {
--     let a = Par.spawn(worker1, arg1)
--     let b = Par.spawn(worker2, arg2)
--     Par.await(a) + Par.await(b)
--   }
--
--   fn main() -> i64 {
--     handle my_computation() {
--       Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
--       Par.await(h) -> resume(par_pthread_await(h))
--     }
--   }

use "stdlib/thread.weft"
use "stdlib/list.weft"
use "stdlib/unsafe.weft"
use "runtime/alloc.weft"

type ParRuntimeResult {
  ParOk(i64),
  ParErr(i64)
}

effect Par {
  fn spawn(f: (i64) -> i64, arg: i64) -> i64,
  fn await(h: i64) -> i64
}

fn par_error_invalid_handle() -> i64 { 0 - 1 }
fn par_error_already_awaited() -> i64 { 0 - 2 }

fn par_handle_magic() -> i64 { 7319521 }
fn par_handle_magic_offset() -> i64 { 0 }
fn par_handle_tid_offset() -> i64 { 8 }
fn par_handle_joined_offset() -> i64 { 16 }
fn par_handle_size() -> i64 { 24 }

fn par_runtime_result_unwrap_or(res: ParRuntimeResult, default: i64) -> i64 {
  match res {
    ParOk(v) -> v
    ParErr(e) -> default
  }
}

fn par_pthread_make_handle(tid: i64) -> i64 {
  let hnd = alloc_bump(par_handle_size())
  __mem_store64(hnd + par_handle_magic_offset(), par_handle_magic())
  __mem_store64(hnd + par_handle_tid_offset(), tid)
  __mem_store64(hnd + par_handle_joined_offset(), 0)
  hnd
}

fn par_pthread_create_status_result(status: i64, tid: i64) -> ParRuntimeResult {
  if status == 0 {
    ParOk(par_pthread_make_handle(tid))
  } else {
    ParErr(status)
  }
}

fn par_pthread_handle_is_valid(h: i64) -> bool {
  if h == 0 {
    false
  } else {
    __mem_load64(h + par_handle_magic_offset()) == par_handle_magic()
  }
}

fn par_pthread_spawn_result(f: (i64) -> i64, arg: i64) -> ParRuntimeResult {
  let created = handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let tid = alloc_bump(8)
      let status = __got_pthread_create(tid, 0, fn_addr(f), arg, 0, 0)
      let thread_id = if status == 0 { __mem_load64(tid) } else { 0 }
      let result = alloc_bump(16)
      __mem_store64(result, status)
      __mem_store64(result + 8, thread_id)
      resume(result)
    }
  }
  par_pthread_create_status_result(__mem_load64(created), __mem_load64(created + 8))
}

fn par_pthread_spawn(f: (i64) -> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_spawn_result(f, arg), 0)
}

fn par_pthread_await_result(h: i64) -> ParRuntimeResult {
  if par_pthread_handle_is_valid(h) == false {
    ParErr(par_error_invalid_handle())
  } else {
    if __mem_load64(h + par_handle_joined_offset()) != 0 {
      ParErr(par_error_already_awaited())
    } else {
      let joined = handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
        Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
          let retval = alloc_bump(8)
          let status = __got_pthread_join(__mem_load64(h + par_handle_tid_offset()), retval, 0, 0, 0, 0)
          let result = alloc_bump(16)
          __mem_store64(result, status)
          __mem_store64(result + 8, __mem_load64(retval))
          resume(result)
        }
      }
      if __mem_load64(joined) == 0 {
        __mem_store64(h + par_handle_joined_offset(), 1)
        ParOk(__mem_load64(joined + 8))
      } else {
        ParErr(__mem_load64(joined))
      }
    }
  }
}

fn par_pthread_await(h: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_await_result(h), 0)
}

fn par_pthread_spawn_unsafe_result(f: (i64) -[Unsafe]> i64, arg: i64) -> ParRuntimeResult {
  let created = handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let tid = alloc_bump(8)
      let status = __got_pthread_create(tid, 0, fn_addr_unsafe(f), arg, 0, 0)
      let thread_id = if status == 0 { __mem_load64(tid) } else { 0 }
      let result = alloc_bump(16)
      __mem_store64(result, status)
      __mem_store64(result + 8, thread_id)
      resume(result)
    }
  }
  par_pthread_create_status_result(__mem_load64(created), __mem_load64(created + 8))
}

fn par_pthread_spawn_unsafe(f: (i64) -[Unsafe]> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_spawn_unsafe_result(f, arg), 0)
}

fn par_pthread_mutex_size() -> i64 { 56 }

fn par_pthread_mutex_new() -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let mutex = alloc_bump(par_pthread_mutex_size())
      __got_pthread_mutex_init(mutex, 0, 0, 0, 0, 0)
      resume(mutex)
    }
  }
}

fn par_pthread_mutex_destroy(mutex: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let status = __got_pthread_mutex_destroy(mutex, 0, 0, 0, 0, 0)
      resume(status)
    }
  }
}

fn par_pthread_mutex_lock_raw(mutex: i64) -[Unsafe]> i64 {
  __got_pthread_mutex_lock(mutex, 0, 0, 0, 0, 0)
}

fn par_pthread_mutex_unlock_raw(mutex: i64) -[Unsafe]> i64 {
  __got_pthread_mutex_unlock(mutex, 0, 0, 0, 0, 0)
}

fn par_pool_mutex_offset() -> i64 { 0 }
fn par_pool_next_offset() -> i64 { 8 }
fn par_pool_count_offset() -> i64 { 16 }
fn par_pool_items_offset() -> i64 { 24 }
fn par_pool_results_offset() -> i64 { 32 }
fn par_pool_fn_ptr_offset() -> i64 { 40 }
fn par_pool_state_size() -> i64 { 48 }

fn par_pool_list_len(items: i64) -> i64 {
  let mut n = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      n = n + 1
      cur = __mem_load64(cur + 16)
    }
  }
  n
}

fn par_pool_fill_items(items: i64, out: i64) -> i64 {
  let mut i = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      __mem_store64(out + i * 8, __mem_load64(cur + 8))
      i = i + 1
      cur = __mem_load64(cur + 16)
    }
  }
  i
}

fn par_pool_results_to_list(results: i64, count: i64) -> i64 {
  let mut out = Nil
  let mut i = count - 1
  while i >= 0 {
    out = Cons<i64>(__mem_load64(results + i * 8), out)
    i = i - 1
  }
  out
}

fn par_pool_worker_count(count: i64, requested: i64) -> i64 {
  if count <= 0 {
    0
  } else {
    let base = if requested <= 0 { 1 } else { requested }
    if base > count { count } else { base }
  }
}

fn par_pool_worker(state: i64) -[Unsafe]> i64 {
  let mutex = __mem_load64(state + par_pool_mutex_offset())
  let count = __mem_load64(state + par_pool_count_offset())
  let items = __mem_load64(state + par_pool_items_offset())
  let results = __mem_load64(state + par_pool_results_offset())
  let fn_ptr = __mem_load64(state + par_pool_fn_ptr_offset())
  let mut running = 1

  while running == 1 {
    par_pthread_mutex_lock_raw(mutex)
    let index = __mem_load64(state + par_pool_next_offset())
    if index >= count {
      par_pthread_mutex_unlock_raw(mutex)
      running = 0
    } else {
      __mem_store64(state + par_pool_next_offset(), index + 1)
      par_pthread_mutex_unlock_raw(mutex)
      let item = __mem_load64(items + index * 8)
      let value = __call_i64(fn_ptr, item)
      __mem_store64(results + index * 8, value)
    }
  }

  0
}

-- Batch pthread pool map. The callback must currently be C-callable via
-- fn_addr, so top-level pure functions are the intended surface for now.
fn par_pthread_pool_map(items: i64, f: (i64) -> i64, requested_workers: i64) -> i64 {
  let count = par_pool_list_len(items)
  if count == 0 {
    Nil
  } else {
    let worker_count = par_pool_worker_count(count, requested_workers)
    let item_array = alloc_bump(count * 8)
    let result_array = alloc_bump(count * 8)
    par_pool_fill_items(items, item_array)

    let mutex = par_pthread_mutex_new()
    let state = alloc_bump(par_pool_state_size())
    __mem_store64(state + par_pool_mutex_offset(), mutex)
    __mem_store64(state + par_pool_next_offset(), 0)
    __mem_store64(state + par_pool_count_offset(), count)
    __mem_store64(state + par_pool_items_offset(), item_array)
    __mem_store64(state + par_pool_results_offset(), result_array)
    __mem_store64(state + par_pool_fn_ptr_offset(), fn_addr(f))

    let handles = alloc_bump(worker_count * 8)
    let mut spawning = 0
    let mut spawned = 0
    let mut spawn_error = 0
    while spawning < worker_count {
      if spawn_error == 0 {
        let spawned_worker = par_pthread_spawn_unsafe_result(par_pool_worker, state)
        match spawned_worker {
          ParOk(h) -> {
            __mem_store64(handles + spawning * 8, h)
            spawned = spawned + 1
          }
          ParErr(e) -> {
            spawn_error = e
          }
        }
      } else {
        spawning = worker_count
      }
      spawning = spawning + 1
    }

    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(__mem_load64(handles + awaiting * 8))
      awaiting = awaiting + 1
    }

    par_pthread_mutex_destroy(mutex)
    if spawn_error == 0 {
      par_pool_results_to_list(result_array, count)
    } else {
      list_map<i64, i64>(items, f)
    }
  }
}

fn par_pthread_pool_map_or_sequential(items: i64, f: (i64) -> i64, requested_workers: i64, runtime_available: i64) -> i64 {
  if runtime_available == 0 {
    list_map<i64, i64>(items, f)
  } else {
    par_pthread_pool_map(items, f, requested_workers)
  }
}

fn par_map(items: i64, f: (i64) -> i64) -[Par]> i64 {
  let mut handles = Nil
  let mut cur = items
  let mut spawning = 1
  while spawning == 1 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      spawning = 0
    } else {
      let item = __mem_load64(cur + 8)
      handles = Cons<i64>(Par.spawn(f, item), handles)
      cur = __mem_load64(cur + 16)
    }
  }

  let ordered = list_reverse<i64>(handles)
  let mut result = Nil
  let mut hs = ordered
  let mut awaiting = 1
  while awaiting == 1 {
    let tag = __mem_load64(hs)
    if tag == __mem_load64(Nil) {
      awaiting = 0
    } else {
      let h = __mem_load64(hs + 8)
      result = Cons<i64>(Par.await(h), result)
      hs = __mem_load64(hs + 16)
    }
  }
  list_reverse<i64>(result)
}
