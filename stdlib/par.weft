  runtime_par_task_arg(task)
}

fn par_task_result(task: i64) -> i64 {
  runtime_par_task_result(task)
}

fn par_task_done(task: i64) -> i64 {
  runtime_par_task_done(task)
}

fn par_task_awaited(task: i64) -> i64 {
  runtime_par_task_awaited(task)
