-- stdlib/par.weft -- Structured concurrency via algebraic effects
--
-- Par is an effect for parallel execution. The effect DECLARATION is here.
-- Handlers install the runtime policy. The default linked-test policy below
-- uses pthread helpers, while later runtime work can replace it with a worker
-- pool without changing the Par effect surface.
--
-- Usage (in main source file):
--
--   use "stdlib/par.weft"
--
--   fn my_computation() -[Par]> i64 {
--     let a = Par.spawn(worker1, arg1)
--     let b = Par.spawn(worker2, arg2)
--     Par.await(a) + Par.await(b)
--   }
--
--   fn main() -> i64 {
--     handle my_computation() {
--       Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
--       Par.await(h) -> resume(par_pthread_await(h))
--     }
--   }

use "stdlib/thread.weft"
use "stdlib/list.weft"
use "stdlib/unsafe.weft"
use "runtime/alloc.weft"

effect Par {
  fn spawn(f: (i64) -> i64, arg: i64) -> i64
  fn await(h: i64) -> i64
}

fn par_pthread_spawn(f: (i64) -> i64, arg: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let tid = alloc_bump(8)
      __got_pthread_create(tid, 0, fn_addr(f), arg, 0, 0)
      let hnd = alloc_bump(8)
      __mem_store64(hnd, __mem_load64(tid))
      resume(hnd)
    }
  }
}

fn par_pthread_await(h: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let retval = alloc_bump(8)
      __got_pthread_join(__mem_load64(h), retval, 0, 0, 0, 0)
      resume(__mem_load64(retval))
    }
  }
}

fn par_map(items: i64, f: (i64) -> i64) -[Par]> i64 {
  let mut handles = Nil
  let mut cur = items
  let mut spawning = 1
  while spawning == 1 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      spawning = 0
    } else {
      let item = __mem_load64(cur + 8)
      handles = Cons<i64>(Par.spawn(f, item), handles)
      cur = __mem_load64(cur + 16)
    }
  }

  let ordered = list_reverse<i64>(handles)
  let mut result = Nil
  let mut hs = ordered
  let mut awaiting = 1
  while awaiting == 1 {
    let tag = __mem_load64(hs)
    if tag == __mem_load64(Nil) {
      awaiting = 0
    } else {
      let h = __mem_load64(hs + 8)
      result = Cons<i64>(Par.await(h), result)
      hs = __mem_load64(hs + 16)
    }
  }
  list_reverse<i64>(result)
}
