fn par_pool_pending_add_raw(pool: i64, delta: i64) -[Unsafe]> i64 {
  let mutex = par_pool_control_mutex(pool)
  par_pthread_mutex_lock_raw(mutex)
  let next = par_pool_pending_count(pool) + delta
  __mem_store64(pool + par_pool_pending_count_offset(), next)
  par_pthread_mutex_unlock_raw(mutex)
  next
}

fn par_pool_pending_add(pool: i64, delta: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(par_pool_pending_add_raw(pool, delta))
  }
}

fn par_pool_signal_work_raw(pool: i64) -[Unsafe]> i64 {
  par_pthread_cond_signal_raw(par_pool_control_cond(pool))
}

fn par_pool_signal_work(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(par_pool_signal_work_raw(pool))
  }
}

fn par_pool_request_shutdown_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = par_pool_control_mutex(pool)
  par_pthread_mutex_lock_raw(mutex)
  __mem_store64(pool + par_pool_shutdown_offset(), 1)
  par_pthread_cond_broadcast_raw(par_pool_control_cond(pool))
  par_pthread_mutex_unlock_raw(mutex)
  0
}

fn par_pool_request_shutdown(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(par_pool_request_shutdown_raw(pool))
  }
}

fn par_pool_wait_for_work_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = par_pool_control_mutex(pool)
  par_pthread_mutex_lock_raw(mutex)
  let mut waiting = 1
  let mut should_stop = 0
  while waiting == 1 {
    if par_pool_pending_count(pool) > 0 {
      waiting = 0
    } else {
      if par_pool_shutdown_requested(pool) != 0 {
        should_stop = 1
        waiting = 0
      } else {
        par_pthread_cond_wait_raw(par_pool_control_cond(pool), mutex)
      }
    }
  }
  par_pthread_mutex_unlock_raw(mutex)
  should_stop
}

fn par_worker_at(workers: i64, index: i64) -> i64 {
  __mem_load64(workers + index * 8)
}

fn par_worker_steal_task_raw(worker: i64) -[Unsafe]> i64 {
  let pool = par_worker_pool(worker)
  let workers = par_pool_workers(pool)
  let total = par_pool_worker_count_value(pool)
  let self_id = par_worker_id(worker)
  let mut step = 1
  let mut task = par_queue_empty_value()
  while step < total {
    if task < 0 {
      let raw_victim_id = self_id + step
      let victim_id = if raw_victim_id >= total { raw_victim_id - total } else { raw_victim_id }
      let victim = par_worker_at(workers, victim_id)
      if victim != 0 {
        task = par_deque_steal_top_raw(par_worker_local_queue(victim))
      } else {
        0
      }
    } else {
      step = total
    }
    step = step + 1
  }
  task
}

fn par_worker_pop_task_raw(worker: i64) -[Unsafe]> i64 {
  let local_task = par_deque_pop_bottom_raw(par_worker_local_queue(worker))
  if local_task >= 0 {
    local_task
  } else {
    let shared_task = par_queue_pop_raw(par_worker_shared_queue(worker))
    if shared_task >= 0 {
      shared_task
    } else {
      par_worker_steal_task_raw(worker)
    }
  }
}

fn par_pool_list_len(items: i64) -> i64 {
  let mut n = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      n = n + 1
      cur = __mem_load64(cur + 16)
    }
  }
  n
}

fn par_pool_fill_items(items: i64, out: i64) -> i64 {
  let mut i = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      __mem_store64(out + i * 8, __mem_load64(cur + 8))
      i = i + 1
      cur = __mem_load64(cur + 16)
    }
  }
  i
}

fn par_task_array_results_to_list(tasks: i64, count: i64) -> i64 {
  let mut out = Nil
  let mut i = count - 1
  while i >= 0 {
    out = Cons<i64>(par_task_await(__mem_load64(tasks + i * 8)), out)
    i = i - 1
  }
  out
}

fn par_pool_worker_count(count: i64, requested: i64) -> i64 {
  if count <= 0 {
    0
  } else {
    let base = if requested <= 0 { 1 } else { requested }
    if base > count { count } else { base }
  }
}

fn par_pool_local_capacity(count: i64, worker_count: i64) -> i64 {
  if count <= 0 {
    1
  } else {
    if worker_count <= 0 {
      count
    } else {
      (count + worker_count - 1) / worker_count
    }
  }
}

fn par_pool_seed_task_queues(count: i64, worker_count: i64, workers: i64, shared_queue: i64, tasks: i64) -> i64 {
  let mut loading = 0
  let mut target = 0
  let mut shared_count = 0
  while loading < count {
    let task = __mem_load64(tasks + loading * 8)
    let pushed_local = if worker_count <= 0 {
      0
    } else {
      let worker = par_worker_at(workers, target)
      if worker == 0 {
        0
      } else {
        par_deque_push_bottom(par_worker_local_queue(worker), task)
      }
    }
    if pushed_local == 0 {
      if par_queue_push(shared_queue, task) == 1 {
        shared_count = shared_count + 1
      } else { 0 }
    } else { 0 }
    loading = loading + 1
    if worker_count > 0 {
      target = par_queue_next(target, worker_count)
    } else { 0 }
  }
  shared_count
}

fn par_pool_take_submit_cursor_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = par_pool_control_mutex(pool)
  par_pthread_mutex_lock_raw(mutex)
  let worker_count = par_pool_worker_count_value(pool)
  let current = __mem_load64(pool + par_pool_submit_cursor_offset())
  if worker_count > 0 {
    __mem_store64(pool + par_pool_submit_cursor_offset(), par_queue_next(current, worker_count))
  } else { 0 }
  par_pthread_mutex_unlock_raw(mutex)
  current
}

fn par_pool_take_submit_cursor(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(par_pool_take_submit_cursor_raw(pool))
  }
}

fn par_pool_enqueue_task(pool: i64, task: i64) -> i64 {
  if pool == 0 {
    0
  } else {
    if task == 0 {
      0
    } else {
      par_pool_pending_add(pool, 1)
      let worker_count = par_pool_worker_count_value(pool)
      let workers = par_pool_workers(pool)
      let target = par_pool_take_submit_cursor(pool)
      let local_pushed = if worker_count <= 0 {
        0
      } else {
        let worker = par_worker_at(workers, target)
        if worker == 0 {
          0
        } else {
          par_deque_push_bottom(par_worker_local_queue(worker), task)
        }
      }
      let pushed = if local_pushed == 1 {
        1
      } else {
        par_queue_push(par_pool_queue(pool), task)
      }
      if pushed == 1 {
        par_pool_signal_work(pool)
        1
      } else {
        par_pool_pending_add(pool, 0 - 1)
        0
      }
    }
  }
}

fn par_pool_worker(state: i64) -[Unsafe]> i64 {
  par_worker_enter_runtime_raw(state)
  let mut running = 1

  while running == 1 {
    let task = par_worker_pop_task_raw(state)
    if task < 0 {
      running = 0
    } else {
      par_task_run_raw(task)
    }
  }

  0
}

fn par_pool_persistent_worker(state: i64) -[Unsafe]> i64 {
  par_worker_enter_runtime_raw(state)
  let pool = par_worker_pool(state)
  let mut running = 1

  while running == 1 {
    let task = par_worker_pop_task_raw(state)
    if task < 0 {
      if par_pool_wait_for_work_raw(pool) == 1 {
        running = 0
      } else { 0 }
    } else {
      par_pool_pending_add_raw(pool, 0 - 1)
      par_task_run_raw(task)
    }
  }

  0
}

-- Batch pthread pool map. Tasks store managed Weft closure pairs, so both
-- top-level functions and captured pure lambdas use the same worker path.
fn par_pthread_pool_map(items: i64, f: (i64) -> i64, requested_workers: i64) -> i64 {
  let count = par_pool_list_len(items)
  if count == 0 {
    Nil
  } else {
    let worker_count = par_pool_worker_count(count, requested_workers)
    let item_array = alloc_bump(count * 8)
    let task_array = alloc_bump(count * 8)
    par_pool_fill_items(items, item_array)
    let mut creating = 0
    while creating < count {
      __mem_store64(task_array + creating * 8, par_task_new_promoted(f, __mem_load64(item_array + creating * 8)))
      creating = creating + 1
    }

    let queue = par_queue_new(count)

    let state = alloc_bump(par_pool_state_size())
    __mem_store64(state + par_pool_queue_offset(), queue)
    __mem_store64(state + par_pool_count_offset(), count)
    __mem_store64(state + par_pool_items_offset(), item_array)
    __mem_store64(state + par_pool_results_offset(), 0)
    __mem_store64(state + par_pool_reserved_offset(), 0)
    __mem_store64(state + par_pool_shutdown_offset(), 0)
    __mem_store64(state + par_pool_submit_cursor_offset(), 0)
    __mem_store64(state + par_pool_control_mutex_offset(), par_pthread_mutex_new())
    __mem_store64(state + par_pool_control_cond_offset(), par_pthread_cond_new())
    __mem_store64(state + par_pool_pending_count_offset(), 0)

    let workers = alloc_bump(worker_count * 8)
    let local_queues = alloc_bump(worker_count * 8)
    let handles = alloc_bump(worker_count * 8)
    __mem_store64(state + par_pool_workers_offset(), workers)
    __mem_store64(state + par_pool_worker_count_offset(), worker_count)
    __mem_store64(state + par_pool_handles_offset(), handles)
    __mem_store64(state + par_pool_spawned_count_offset(), 0)
    __mem_store64(state + par_pool_local_queues_offset(), local_queues)
    let mut preparing = 0
    let local_capacity = par_pool_local_capacity(count, worker_count)
    while preparing < worker_count {
      let local_queue = par_deque_new(local_capacity)
      __mem_store64(local_queues + preparing * 8, local_queue)
      __mem_store64(workers + preparing * 8, par_worker_new(preparing, state, local_queue, queue, worker_count))
      preparing = preparing + 1
    }
    par_pool_seed_task_queues(count, worker_count, workers, queue, task_array)

    let mut spawning = 0
    let mut spawned = 0
    let mut spawn_error = 0
    while spawning < worker_count {
      if spawn_error == 0 {
        let spawned_worker = par_pthread_spawn_unsafe_result(par_pool_worker, __mem_load64(workers + spawning * 8))
        match spawned_worker {
          ParOk(h) -> {
            __mem_store64(handles + spawning * 8, h)
            spawned = spawned + 1
            __mem_store64(state + par_pool_spawned_count_offset(), spawned)
          }
          ParErr(e) -> {
            spawn_error = e
          }
        }
      } else {
        spawning = worker_count
      }
      spawning = spawning + 1
    }

    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(__mem_load64(handles + awaiting * 8))
      awaiting = awaiting + 1
    }

    par_queue_destroy(queue)
    par_pthread_cond_destroy(par_pool_control_cond(state))
    par_pthread_mutex_destroy(par_pool_control_mutex(state))
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(__mem_load64(local_queues + destroying * 8))
      destroying = destroying + 1
    }
    if spawn_error == 0 {
      par_task_array_results_to_list(task_array, count)
    } else {
      list_map<i64, i64>(items, f)
    }
  }
}

fn par_pthread_pool_start_worker_count(requested_workers: i64) -> i64 {
  if requested_workers <= 0 { 1 } else { requested_workers }
}

fn par_pthread_pool_start_result(requested_workers: i64, task_capacity: i64) -> ParRuntimeResult {
  let worker_count = par_pthread_pool_start_worker_count(requested_workers)
  let capacity = if task_capacity <= 0 { worker_count } else { task_capacity }
  let queue = par_queue_new(capacity)
  let state = alloc_bump(par_pool_state_size())
  __mem_store64(state + par_pool_queue_offset(), queue)
  __mem_store64(state + par_pool_count_offset(), 0)
  __mem_store64(state + par_pool_items_offset(), 0)
  __mem_store64(state + par_pool_results_offset(), 0)
  __mem_store64(state + par_pool_reserved_offset(), 0)
  __mem_store64(state + par_pool_shutdown_offset(), 0)
  __mem_store64(state + par_pool_submit_cursor_offset(), 0)
  __mem_store64(state + par_pool_control_mutex_offset(), par_pthread_mutex_new())
  __mem_store64(state + par_pool_control_cond_offset(), par_pthread_cond_new())
  __mem_store64(state + par_pool_pending_count_offset(), 0)

  let workers = alloc_bump(worker_count * 8)
  let local_queues = alloc_bump(worker_count * 8)
  let handles = alloc_bump(worker_count * 8)
  __mem_store64(state + par_pool_workers_offset(), workers)
  __mem_store64(state + par_pool_worker_count_offset(), worker_count)
  __mem_store64(state + par_pool_handles_offset(), handles)
  __mem_store64(state + par_pool_spawned_count_offset(), 0)
  __mem_store64(state + par_pool_local_queues_offset(), local_queues)

  let mut preparing = 0
  while preparing < worker_count {
    let local_queue = par_deque_new(capacity)
    __mem_store64(local_queues + preparing * 8, local_queue)
    __mem_store64(workers + preparing * 8, par_worker_new(preparing, state, local_queue, queue, worker_count))
    preparing = preparing + 1
  }

  let mut spawning = 0
  let mut spawned = 0
  let mut spawn_error = 0
  while spawning < worker_count {
    if spawn_error == 0 {
      let spawned_worker = par_pthread_spawn_unsafe_result(par_pool_persistent_worker, __mem_load64(workers + spawning * 8))
      match spawned_worker {
        ParOk(h) -> {
          __mem_store64(handles + spawning * 8, h)
          spawned = spawned + 1
          __mem_store64(state + par_pool_spawned_count_offset(), spawned)
        }
        ParErr(e) -> {
          spawn_error = e
        }
      }
    } else {
      spawning = worker_count
    }
    spawning = spawning + 1
  }

  if spawn_error == 0 {
    ParOk(state)
  } else {
    par_pool_request_shutdown(state)
    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(__mem_load64(handles + awaiting * 8))
      awaiting = awaiting + 1
    }
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(__mem_load64(local_queues + destroying * 8))
      destroying = destroying + 1
    }
    par_queue_destroy(queue)
    par_pthread_cond_destroy(par_pool_control_cond(state))
    par_pthread_mutex_destroy(par_pool_control_mutex(state))
    ParErr(spawn_error)
  }
}

fn par_pthread_pool_start(requested_workers: i64, task_capacity: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_start_result(requested_workers, task_capacity), 0)
}

fn par_pthread_pool_submit_result(pool: i64, f: (i64) -> i64, arg: i64) -> ParRuntimeResult {
  if pool == 0 {
    ParErr(par_error_invalid_handle())
  } else {
    let task = par_task_new_promoted(f, arg)
    if par_pool_enqueue_task(pool, task) == 1 {
      ParOk(task)
    } else {
      par_task_discard_unawaited(task)
      ParErr(par_error_queue_full())
    }
  }
}

fn par_pthread_pool_submit(pool: i64, f: (i64) -> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_submit_result(pool, f, arg), 0)
}

fn par_pthread_pool_await_result(task: i64) -> ParRuntimeResult {
  par_task_await_blocking_result(task)
}

fn par_pthread_pool_await(task: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_await_result(task), 0)
}

fn par_pthread_pool_shutdown(pool: i64) -> i64 {
  if pool == 0 {
    par_error_invalid_handle()
  } else {
    par_pool_request_shutdown(pool)
    let handles = __mem_load64(pool + par_pool_handles_offset())
    let spawned = __mem_load64(pool + par_pool_spawned_count_offset())
    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(__mem_load64(handles + awaiting * 8))
      awaiting = awaiting + 1
    }
    par_queue_destroy(par_pool_queue(pool))
    let local_queues = __mem_load64(pool + par_pool_local_queues_offset())
    let worker_count = par_pool_worker_count_value(pool)
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(__mem_load64(local_queues + destroying * 8))
      destroying = destroying + 1
    }
    par_pthread_cond_destroy(par_pool_control_cond(pool))
    par_pthread_mutex_destroy(par_pool_control_mutex(pool))
    0
  }
}

fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 {
  handle body() {
    Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg))
    Par.await(h) -> resume(par_task_await(h))
  }
}

fn par_with_pthread_pool_i64(requested_workers: i64, task_capacity: i64, body: () -[Par]> i64) -> i64 {
  let pool = par_pthread_pool_start(requested_workers, task_capacity)
  if pool == 0 {
    par_with_sequential_i64(body)
  } else {
    let result = handle body() {
      Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg))
      Par.await(h) -> resume(par_pthread_pool_await(h))
    }
    par_pthread_pool_shutdown(pool)
    result
  }
}

fn par_pthread_pool_map_or_sequential(items: i64, f: (i64) -> i64, requested_workers: i64, runtime_available: i64) -> i64 {
  if runtime_available == 0 {
    list_map<i64, i64>(items, f)
  } else {
    par_pthread_pool_map(items, f, requested_workers)
  }
}

fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 {
  list_map<i64, i64>(items, f)
}

fn par_pthread_pool_map_scoped_i64(items: i64, f: (i64) -> i64, pool: i64) -> i64 {
  let available = if pool == 0 { 0 } else { 1 }
  let workers = if available == 0 { 1 } else { par_pool_worker_count_value(pool) }
  par_pthread_pool_map_or_sequential(items, f, workers, available)
}

fn par_map(items: i64, f: (i64) -> i64) -[Par]> i64 {
  let mut handles = Nil
  let mut cur = items
  let mut spawning = 1
  while spawning == 1 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      spawning = 0
    } else {
      let item = __mem_load64(cur + 8)
      handles = Cons<i64>(Par.spawn(f, item), handles)
      cur = __mem_load64(cur + 16)
    }
  }

  let ordered = list_reverse<i64>(handles)
  let mut result = Nil
  let mut hs = ordered
  let mut awaiting = 1
  while awaiting == 1 {
    let tag = __mem_load64(hs)
    if tag == __mem_load64(Nil) {
      awaiting = 0
    } else {
      let h = __mem_load64(hs + 8)
      result = Cons<i64>(Par.await(h), result)
      hs = __mem_load64(hs + 16)
    }
  }
  list_reverse<i64>(result)
}
