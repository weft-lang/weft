fn par_pool_list_len(items: List<i64>) -> i64 {
  let mut n = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      n = n + 1
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  n
}

fn par_pool_fill_items(items: List<i64>, out: i64) -> i64 {
  let mut i = 0
  let mut cur = items
  let mut done = 0
  while done == 0 {
    if list_empty<i64>(cur) == 1 {
      done = 1
    } else {
      runtime_par_word_array_set(out, i, list_first_or<i64>(cur, 0))
      i = i + 1
      cur = list_rest_or_nil<i64>(cur)
    }
  }
  i
}

fn par_task_array_results_to_list(tasks: i64, count: i64) -> List<i64> {
  let mut out: List<i64> = list_nil<i64>()
  let mut i = count - 1
  while i >= 0 {
    out = list_cons<i64>(par_task_await(runtime_par_word_array_get(tasks, i)), out)
    i = i - 1
  }
  out
}

fn par_pool_worker_count(count: i64, requested: i64) -> i64 {
  if count <= 0 {
    0
  } else {
    let base = if requested <= 0 { 1 } else { requested }
    if base > count { count } else { base }
  }
}

fn par_pool_local_capacity(count: i64, worker_count: i64) -> i64 {
  if count <= 0 {
    1
  } else {
    if worker_count <= 0 {
      count
    } else {
      (count + worker_count - 1) / worker_count
    }
  }
}

fn par_pool_seed_task_queues(count: i64, worker_count: i64, workers: i64, shared_queue: i64, tasks: i64) -> i64 {
  let mut loading = 0
  let mut target = 0
  let mut shared_count = 0
  while loading < count {
    let task = runtime_par_word_array_get(tasks, loading)
    let pushed_local = if worker_count <= 0 {
      0
    } else {
      let worker = par_worker_at(workers, target)
      if worker == 0 {
        0
      } else {
        par_deque_push_bottom(par_worker_local_queue(worker), task)
      }
    }
    if pushed_local == 0 {
      if par_queue_push(shared_queue, task) == 1 {
        shared_count = shared_count + 1
      } else { 0 }
    } else { 0 }
    loading = loading + 1
    if worker_count > 0 {
      target = par_queue_next(target, worker_count)
    } else { 0 }
  }
  shared_count
}

fn par_pool_take_submit_cursor_raw(pool: i64) -[Unsafe]> i64 {
  runtime_par_pool_take_submit_cursor_raw(pool)
}

fn par_pool_take_submit_cursor(pool: i64) -> i64 {
  runtime_par_pool_take_submit_cursor(pool)
}

fn par_pool_enqueue_task(pool: i64, task: i64) -> i64 {
  if pool == 0 {
    0
  } else {
    if task == 0 {
      0
    } else {
      par_pool_pending_add(pool, 1)
      let worker_count = par_pool_worker_count_value(pool)
      let workers = par_pool_workers(pool)
      let target = par_pool_take_submit_cursor(pool)
      let local_pushed = if worker_count <= 0 {
        0
      } else {
        let worker = par_worker_at(workers, target)
        if worker == 0 {
          0
        } else {
          par_deque_push_bottom(par_worker_local_queue(worker), task)
        }
      }
      let pushed = if local_pushed == 1 {
        1
      } else {
        par_queue_push(par_pool_queue(pool), task)
      }
      if pushed == 1 {
        par_pool_signal_work(pool)
        1
      } else {
        par_pool_pending_add(pool, 0 - 1)
        0
      }
    }
  }
}

fn par_pool_worker(state: i64) -[Unsafe]> i64 {
  par_worker_enter_runtime_raw(state)
  let mut running = 1

  while running == 1 {
    let task = par_worker_pop_task_raw(state)
    if task < 0 {
      running = 0
    } else {
      par_task_run_raw(task)
    }
  }

  0
}

fn par_pool_persistent_worker(state: i64) -[Unsafe]> i64 {
  par_worker_enter_runtime_raw(state)
  let pool = par_worker_pool(state)
  let mut running = 1

  while running == 1 {
    let task = par_worker_pop_task_raw(state)
    if task < 0 {
      if par_pool_wait_for_work_raw(pool) == 1 {
        running = 0
      } else { 0 }
    } else {
      par_pool_pending_add_raw(pool, 0 - 1)
      par_task_run_raw(task)
    }
  }

  0
}

-- Batch pthread pool map. Tasks store managed Weft closure pairs, so both
-- top-level functions and captured pure lambdas use the same worker path.
fn par_pthread_pool_map(items: List<i64>, f: (i64) -> i64, requested_workers: i64) -> List<i64> {
  let count = par_pool_list_len(items)
  if count == 0 {
    list_nil<i64>()
  } else {
    let worker_count = par_pool_worker_count(count, requested_workers)
    let item_array = runtime_par_word_array_new(count)
    let task_array = runtime_par_word_array_new(count)
    par_pool_fill_items(items, item_array)
    let queue = par_queue_new(count)
    let state = runtime_par_pool_state_new(queue, count, item_array)
    let mut creating = 0
    while creating < count {
      runtime_par_word_array_set(task_array, creating, par_pool_task_new_promoted(state, f, runtime_par_word_array_get(item_array, creating)))
      creating = creating + 1
    }
    let workers = runtime_par_word_array_new(worker_count)
    let local_queues = runtime_par_word_array_new(worker_count)
    let handles = runtime_par_word_array_new(worker_count)
    runtime_par_pool_install_worker_arrays(state, workers, worker_count, handles, local_queues)
    let mut preparing = 0
    let local_capacity = par_pool_local_capacity(count, worker_count)
    while preparing < worker_count {
      let local_queue = par_deque_new(local_capacity)
      runtime_par_word_array_set(local_queues, preparing, local_queue)
      runtime_par_word_array_set(workers, preparing, par_worker_new(preparing, state, local_queue, queue, worker_count))
      preparing = preparing + 1
    }
    par_pool_seed_task_queues(count, worker_count, workers, queue, task_array)

    let mut spawning = 0
    let mut spawned = 0
    let mut spawn_error = 0
    while spawning < worker_count {
      if spawn_error == 0 {
        let spawned_worker = par_pthread_spawn_unsafe_result(par_pool_worker, runtime_par_word_array_get(workers, spawning))
        match spawned_worker {
          ParOk(h) -> {
            runtime_par_word_array_set(handles, spawning, h)
            spawned = spawned + 1
            runtime_par_pool_record_spawned_count(state, spawned)
            0
          }
          ParErr(e) -> {
            spawn_error = e
            0
          }
        }
      } else {
        spawning = worker_count
      }
      spawning = spawning + 1
    }

    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(runtime_par_word_array_get(handles, awaiting))
      awaiting = awaiting + 1
    }

    let result = if spawn_error == 0 {
      par_task_array_results_to_list(task_array, count)
    } else {
      list_map<i64, i64>(items, f)
    }
    runtime_par_pool_task_scope_cleanup(state)
    par_queue_destroy(queue)
    par_pthread_cond_destroy(par_pool_control_cond(state))
    par_pthread_mutex_destroy(par_pool_control_mutex(state))
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(runtime_par_word_array_get(local_queues, destroying))
      destroying = destroying + 1
    }
    result
  }
}

fn par_pthread_pool_start_worker_count(requested_workers: i64) -> i64 {
  if requested_workers <= 0 { 1 } else { requested_workers }
}

fn par_pthread_pool_start_result(requested_workers: i64, task_capacity: i64) -> ParRuntimeResult {
  let worker_count = par_pthread_pool_start_worker_count(requested_workers)
  let capacity = if task_capacity <= 0 { worker_count } else { task_capacity }
  let queue = par_queue_new(capacity)
  let state = runtime_par_pool_state_new(queue, 0, 0)
  let workers = runtime_par_word_array_new(worker_count)
  let local_queues = runtime_par_word_array_new(worker_count)
  let handles = runtime_par_word_array_new(worker_count)
  runtime_par_pool_install_worker_arrays(state, workers, worker_count, handles, local_queues)

  let mut preparing = 0
  while preparing < worker_count {
    let local_queue = par_deque_new(capacity)
    runtime_par_word_array_set(local_queues, preparing, local_queue)
    runtime_par_word_array_set(workers, preparing, par_worker_new(preparing, state, local_queue, queue, worker_count))
    preparing = preparing + 1
  }

  let mut spawning = 0
  let mut spawned = 0
  let mut spawn_error = 0
  while spawning < worker_count {
    if spawn_error == 0 {
      let spawned_worker = par_pthread_spawn_unsafe_result(par_pool_persistent_worker, runtime_par_word_array_get(workers, spawning))
      match spawned_worker {
        ParOk(h) -> {
          runtime_par_word_array_set(handles, spawning, h)
          spawned = spawned + 1
          runtime_par_pool_record_spawned_count(state, spawned)
          0
        }
        ParErr(e) -> {
          spawn_error = e
          0
        }
      }
    } else {
      spawning = worker_count
    }
    spawning = spawning + 1
  }

  if spawn_error == 0 {
    ParOk(state)
  } else {
    par_pool_request_shutdown(state)
    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(runtime_par_word_array_get(handles, awaiting))
      awaiting = awaiting + 1
    }
    runtime_par_pool_task_scope_cleanup(state)
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(runtime_par_word_array_get(local_queues, destroying))
      destroying = destroying + 1
    }
    par_queue_destroy(queue)
    par_pthread_cond_destroy(par_pool_control_cond(state))
    par_pthread_mutex_destroy(par_pool_control_mutex(state))
    ParErr(spawn_error)
  }
}

fn par_pthread_pool_start(requested_workers: i64, task_capacity: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_start_result(requested_workers, task_capacity), 0)
}

fn par_pthread_pool_submit_result(pool: i64, f: (i64) -> i64, arg: i64) -> ParRuntimeResult {
  if pool == 0 {
    ParErr(par_error_invalid_handle())
  } else {
    let task = par_pool_task_new_promoted(pool, f, arg)
    if par_pool_enqueue_task(pool, task) == 1 {
      ParOk(task)
    } else {
      par_task_discard_unawaited(task)
      ParErr(par_error_queue_full())
    }
  }
}

fn par_pthread_pool_submit(pool: i64, f: (i64) -> i64, arg: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_submit_result(pool, f, arg), 0)
}

fn par_pthread_pool_submit_prepared_result(pool: i64, f: (i64) -> i64, arg: i64) -> ParRuntimeResult {
  if pool == 0 {
    ParErr(par_error_invalid_handle())
  } else {
    let task = par_pool_task_new(pool, f, arg)
    if par_pool_enqueue_task(pool, task) == 1 {
      ParOk(task)
    } else {
      par_task_discard_unawaited(task)
      ParErr(par_error_queue_full())
    }
  }
}

fn par_pthread_pool_submit_prepared(pool: i64, f: (i64) -> i64, arg: i64) -> i64 {
  if pool == 0 {
    par_error_invalid_handle()
  } else {
    let task = par_pool_task_new(pool, f, arg)
    if par_pool_enqueue_task(pool, task) == 1 {
      task
    } else {
      par_task_discard_unawaited(task)
      par_error_queue_full()
    }
  }
}

fn par_pthread_pool_await_result(task: i64) -> ParRuntimeResult {
  par_task_await_blocking_result(task)
}

fn par_pthread_pool_await(task: i64) -> i64 {
  par_runtime_result_unwrap_or(par_pthread_pool_await_result(task), 0)
}

fn par_pthread_pool_shutdown(pool: i64) -> i64 {
  if pool == 0 {
    par_error_invalid_handle()
  } else {
    par_pool_request_shutdown(pool)
    let handles = runtime_par_pool_handles(pool)
    let spawned = runtime_par_pool_spawned_count(pool)
    let mut awaiting = 0
    while awaiting < spawned {
      par_pthread_await(runtime_par_word_array_get(handles, awaiting))
      awaiting = awaiting + 1
    }
    runtime_par_pool_task_scope_cleanup(pool)
    par_queue_destroy(par_pool_queue(pool))
    let local_queues = runtime_par_pool_local_queues(pool)
    let worker_count = par_pool_worker_count_value(pool)
    let mut destroying = 0
    while destroying < worker_count {
      par_deque_destroy(runtime_par_word_array_get(local_queues, destroying))
      destroying = destroying + 1
    }
    par_pthread_cond_destroy(par_pool_control_cond(pool))
    par_pthread_mutex_destroy(par_pool_control_mutex(pool))
    0
  }
}

fn par_with_sequential_i64<E>(body: () -[Par, E]> i64) -[E]> i64 {
  let tasks = par_task_scope_new()
  let works = runtime_par_work_scope_new()
  defer par_task_scope_cleanup(tasks)
  defer runtime_par_work_scope_cleanup(works)
  handle body() {
    Par.spawn(f, arg) -> resume(par_task_scope_track(tasks, par_sequential_submit(f, arg)))
    Par.await(h) -> resume(par_task_await(h))
    Par.submit(work) -> resume(runtime_par_work_scope_track(works, par_work_sequential_submit(work)))
    Par.join(task) -> resume(runtime_par_work_join(task))
  }
}

fn par_with_pthread_pool_i64<E>(requested_workers: i64, task_capacity: i64, body: () -[Par, E]> i64) -[E]> i64 {
  let pool = par_pthread_pool_start(requested_workers, task_capacity)
  if pool == 0 {
    par_with_sequential_i64(body)
  } else {
    let works = runtime_par_work_scope_new()
    defer runtime_par_work_scope_cleanup(works)
    -- LIFO cleanup must join every worker before carrier results are dropped.
    defer par_pthread_pool_shutdown(pool)
    handle body() {
      Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg))
      Par.await(h) -> resume(par_pthread_pool_await(h))
      Par.submit(work) -> resume(runtime_par_work_scope_track(works, par_work_pthread_submit(pool, work)))
      Par.join(task) -> resume(runtime_par_work_join(task))
    }
  }
}

fn par_pthread_pool_map_or_sequential(items: List<i64>, f: (i64) -> i64, requested_workers: i64, runtime_available: i64) -> List<i64> {
  if runtime_available == 0 {
    list_map<i64, i64>(items, f)
  } else {
    par_pthread_pool_map(items, f, requested_workers)
  }
}

fn par_sequential_map_i64(items: List<i64>, f: (i64) -> i64) -> List<i64> {
  list_map<i64, i64>(items, f)
}

fn par_pthread_pool_map_scoped_i64(items: List<i64>, f: (i64) -> i64, pool: i64) -> List<i64> {
  let available = if pool == 0 { 0 } else { 1 }
  let workers = if available == 0 { 1 } else { par_pool_worker_count_value(pool) }
  par_pthread_pool_map_or_sequential(items, f, workers, available)
}

fn par_map(items: List<i64>, f: (i64) -> i64) -[Par]> List<i64> {
  let mut handles: List<i64> = list_nil<i64>()
  let mut cur = items
  let mut spawning = 1
  while spawning == 1 {
    if list_empty<i64>(cur) == 1 {
      spawning = 0
    } else {
      let item = list_first_or<i64>(cur, 0)
      handles = list_cons<i64>(Par.spawn(f, item), handles)
      cur = list_rest_or_nil<i64>(cur)
    }
  }

  let ordered = list_reverse<i64>(handles)
  let mut result: List<i64> = list_nil<i64>()
  let mut hs = ordered
  let mut awaiting = 1
  while awaiting == 1 {
    if list_empty<i64>(hs) == 1 {
      awaiting = 0
    } else {
      let h = list_first_or<i64>(hs, 0)
      result = list_cons<i64>(Par.await(h), result)
      hs = list_rest_or_nil<i64>(hs)
    }
  }
  list_reverse<i64>(result)
}
