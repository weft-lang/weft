-- stdlib/assert.weft -- assertions for ordinary programs

use stdlib/eq.{*}
use stdlib/panic.{*}

pub fn assert(condition: bool) -> nil {
  if condition { nil } else { panic("assertion failed") }
}

pub fn assert_msg(condition: bool, msg: str) -> nil {
  if condition { nil } else { panic(msg) }
}

pub fn assert_eq<T: Eq>(got: T, expected: T) -> nil {
  if got.eq(expected) { nil }
  else { panic("assertion failed: values are not equal") }
}
