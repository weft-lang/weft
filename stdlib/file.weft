-- stdlib/file.weft — safe high-level file authority
--
-- Streaming handles remain owned by stdlib/io until reusable owned-resource
-- borrows land. These whole-file operations expose no descriptor, flag, mode,
-- pointer or sentinel and are directly mockable through capability handlers.

use stdlib/bytes.{Bytes, bytes_from_str, bytes_to_utf8}
use stdlib/fail.{Fail}
use stdlib/io.{FileHandle, IO, io_file_close_raw, io_file_flush_raw, io_file_open_append_checked_with, io_file_open_read_checked_with, io_file_open_read_write_checked_with, io_file_open_write_checked_with, io_file_read_raw, io_file_seek_current_raw, io_file_seek_end_raw, io_file_seek_start_raw, io_file_write_raw}
use stdlib/io/types.{IoError, IoTextError, IoTextInvalidUtf8, IoTextIo}
use stdlib/io/types.{IoInvalidProgress, IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes, io_error_from_errno, io_read_progress_from_status, io_write_progress_from_status}
use stdlib/path.{Path, path_runtime_string}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/vector.{vector_data, vector_get_in_bounds, vector_len, vector_push, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- The whole-file write policy used by `FileWrite.write_all`.
pub type FileWriteMode {
  --- Create a new file and fail if it already exists.
  FileCreateNew,
  --- Create a file or replace its existing contents.
  FileCreateOrTruncate,
  --- Append after the current file contents.
  FileAppend,
  --- Replace the destination atomically when the handler supports it.
  FileAtomicReplace
}

--- The reference point for a streaming seek.
pub type FileSeekOrigin {
  --- Seek relative to the beginning of the file.
  FileSeekStart,
  --- Seek relative to the current position.
  FileSeekCurrent,
  --- Seek relative to the end of the file.
  FileSeekEnd
}

--- Capability for bounded whole-file reads.
pub effect FileRead {
  --- Read a complete file up to `limit` bytes.
  fn read_all(path: Path, limit: usize) -> Result<Bytes, IoError>
}

--- Capability for complete whole-file writes.
pub effect FileWrite {
  --- Write all bytes according to `mode`.
  fn write_all(path: Path, values: Bytes, mode: FileWriteMode) -> Result<usize, IoError>
}

--- Read a complete file up to `limit` bytes.
pub fn file_read_all(path: Path, limit: usize) -[FileRead]> Result<Bytes, IoError> {
  FileRead.read_all(path, limit)
}

--- Create a new file containing `values`, failing if it exists.
pub fn file_create_new(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileCreateNew)
}

--- Create or truncate a file and write all `values`.
pub fn file_write_all(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileCreateOrTruncate)
}

--- Append all `values` to a file, creating it when absent.
pub fn file_append_all(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileAppend)
}

--- Atomically replace a file's contents when supported by the handler.
pub fn file_atomic_replace(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileAtomicReplace)
}

--- Read a bounded file and validate its complete contents as UTF-8 text.
pub fn file_read_text(path: Path, limit: usize) -[FileRead]> Result<str, IoTextError> {
  match file_read_all(path, limit) {
    Err(error) -> result_err<str, IoTextError>(IoTextIo(error))
    Ok(values) -> match bytes_to_utf8(values) {
      Err(error) -> result_err<str, IoTextError>(IoTextInvalidUtf8(error))
      Ok(text) -> result_ok<str, IoTextError>(text)
    }
  }
}

--- Create a new file from UTF-8 text, failing if it exists.
pub fn file_create_new_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  file_create_new(path, bytes_from_str(text))
}

--- Create or truncate a file and write UTF-8 text.
pub fn file_write_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  file_write_all(path, bytes_from_str(text))
}

--- Append UTF-8 text to a file, creating it when absent.
pub fn file_append_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  file_append_all(path, bytes_from_str(text))
}

--- Atomically replace a file with UTF-8 text when supported by the handler.
pub fn file_atomic_replace_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  file_atomic_replace(path, bytes_from_str(text))
}

--- Return a stable discriminator for a whole-file write mode.
pub fn file_write_mode_kind(mode: FileWriteMode) -> i64 {
  match mode {
    FileCreateNew -> 1
    FileCreateOrTruncate -> 2
    FileAppend -> 3
    FileAtomicReplace -> 4
  }
}

fn file_open_failure(status: i64) -[Fail<IoError>]> never {
  Fail<IoError>.fail(io_error_from_errno(status))
}

--- Open an owned streaming handle for reading.
pub fn file_open_read(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_read_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for truncating writes.
pub fn file_open_write(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_write_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for reading and truncating writes.
pub fn file_open_read_write(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_read_write_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for appending writes.
pub fn file_open_append(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_append_checked_with(path_runtime_string(path), file_open_failure)
}

fn file_stream_len(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn file_stream_scratch(len: i64) -> Vector<u8> {
  let values = vector_with_capacity<u8>(len)
  for i in 0..len { vector_push<u8>(values, __u64_to_u8(0)) }
  values
}

--- Read into `buffer`, returning bytes read, EOF, or a typed I/O error.
pub fn file_read(file: borrow mut FileHandle, buffer: [mut u8]) -[IO]> Result<IoReadProgress, IoError> {
  let len = file_stream_len(buffer.len)
  if len < 0 {
    result_err<IoReadProgress, IoError>(IoInvalidProgress)
  } else { if len == 0 {
    result_ok<IoReadProgress, IoError>(IoReadBytes(__i64_to_usize(0)))
  } else {
    let scratch = file_stream_scratch(len)
    let status = io_file_read_raw(file, vector_data<u8>(scratch), len)
    if status > len {
      result_err<IoReadProgress, IoError>(IoInvalidProgress)
    } else {
      if status > 0 {
        for i in 0..status {
          buffer[__i64_to_usize(i)] = vector_get_in_bounds<u8>(scratch, i)
        }
      } else { 0 }
      io_read_progress_from_status(status)
    }
  } }
}

--- Write from `buffer`, returning bytes written or a typed I/O error.
pub fn file_write(file: borrow mut FileHandle, buffer: [u8]) -[IO]> Result<IoWriteProgress, IoError> {
  let len = file_stream_len(buffer.len)
  if len < 0 {
    result_err<IoWriteProgress, IoError>(IoInvalidProgress)
  } else { if len == 0 {
    result_ok<IoWriteProgress, IoError>(IoWroteBytes(__i64_to_usize(0)))
  } else {
    let scratch = vector_with_capacity<u8>(len)
    for i in 0..len { vector_push<u8>(scratch, buffer[__i64_to_usize(i)]) }
    let status = io_file_write_raw(file, vector_data<u8>(scratch), len)
    if status > len { result_err<IoWriteProgress, IoError>(IoInvalidProgress) }
    else { io_write_progress_from_status(status) }
  } }
}

--- Reposition a streaming handle relative to `origin`.
pub fn file_seek(file: borrow mut FileHandle, offset: i64, origin: FileSeekOrigin) -[IO]> Result<i64, IoError> {
  let status = match origin {
    FileSeekStart -> io_file_seek_start_raw(file, offset)
    FileSeekCurrent -> io_file_seek_current_raw(file, offset)
    FileSeekEnd -> io_file_seek_end_raw(file, offset)
  }
  if status < 0 { result_err<i64, IoError>(io_error_from_errno(status)) }
  else { result_ok<i64, IoError>(status) }
}

--- Flush buffered writes for a streaming handle.
pub fn file_flush(file: borrow mut FileHandle) -[IO]> Result<nil, IoError> {
  let status = io_file_flush_raw(file)
  if status == 0 { result_ok<nil, IoError>(nil) }
  else { if status < 0 { result_err<nil, IoError>(io_error_from_errno(status)) }
  else { result_err<nil, IoError>(IoInvalidProgress) } }
}

-- close consumes the owner even when the platform reports failure: POSIX
-- close errors do not make retrying a descriptor safe.
--- Close and consume an owned handle, even when the platform reports failure.
pub fn file_close(file: owned FileHandle) -[IO]> Result<nil, IoError> {
  let status = io_file_close_raw(file)
  if status == 0 { result_ok<nil, IoError>(nil) }
  else { if status < 0 { result_err<nil, IoError>(io_error_from_errno(status)) }
  else { result_err<nil, IoError>(IoInvalidProgress) } }
}
