-- stdlib/file.weft — safe high-level file authority
--
-- Whole-file operations are directly mockable through capability handlers.
-- Streaming handles expose typed borrowed methods without revealing a
-- descriptor, flag, pointer, or platform sentinel.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/fail.{Fail}
pub use stdlib/io.{FileHandle}
use stdlib/io.{IO, io_file_close_raw, io_file_flush_raw, io_file_open_append_checked_with, io_file_open_read_checked_with, io_file_open_read_write_checked_with, io_file_open_write_checked_with, io_file_read_raw, io_file_seek_current_raw, io_file_seek_end_raw, io_file_seek_start_raw, io_file_write_raw}
use stdlib/io/types.{IoError, IoTextError, IoTextInvalidUtf8, IoTextIo}
use stdlib/io/types.{IoInvalidProgress, IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes, io_error_from_errno, io_read_progress_from_status, io_write_progress_from_status}
use stdlib/path.{Path, path_runtime_string}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{vector_data, vector_get_in_bounds, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- The whole-file write policy used by `FileWrite.write_all`.
pub type FileWriteMode {
  --- Create a new file and fail if it already exists.
  FileCreateNew,
  --- Create a file or replace its existing contents.
  FileCreateOrTruncate,
  --- Append after the current file contents.
  FileAppend,
  --- Replace the destination atomically when the handler supports it.
  FileAtomicReplace
}

--- The reference point for a streaming seek.
pub type FileSeekOrigin {
  --- Seek relative to the beginning of the file.
  FileSeekStart,
  --- Seek relative to the current position.
  FileSeekCurrent,
  --- Seek relative to the end of the file.
  FileSeekEnd
}

--- Capability for bounded whole-file reads.
pub effect FileRead {
  --- Read a complete file up to `limit` bytes.
  fn read_all(path: Path, limit: usize) -> Result<Bytes, IoError>
}

--- Capability for complete whole-file writes.
pub effect FileWrite {
  --- Write all bytes according to `mode`.
  fn write_all(path: Path, values: Bytes, mode: FileWriteMode) -> Result<usize, IoError>
}

--- Read a complete file up to `limit` bytes.
pub fn read_all(path: Path, limit: usize) -[FileRead]> Result<Bytes, IoError> {
  FileRead.read_all(path, limit)
}

--- Create a new file containing `values`, failing if it exists.
pub fn create_new(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileCreateNew)
}

--- Create or truncate a file and write all `values`.
pub fn write_all(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileCreateOrTruncate)
}

--- Append all `values` to a file, creating it when absent.
pub fn append_all(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileAppend)
}

--- Atomically replace a file's contents when supported by the handler.
pub fn atomic_replace(path: Path, values: Bytes) -[FileWrite]> Result<usize, IoError> {
  FileWrite.write_all(path, values, FileAtomicReplace)
}

--- Read a bounded file and validate its complete contents as UTF-8 text.
pub fn read_text(path: Path, limit: usize) -[FileRead]> Result<str, IoTextError> {
  match read_all(path, limit) {
    Err(error) -> Err<str, IoTextError>(IoTextIo(error))
    Ok(values) -> match values.to_utf8() {
      Err(error) -> Err<str, IoTextError>(IoTextInvalidUtf8(error))
      Ok(text) -> Ok<str, IoTextError>(text)
    }
  }
}

--- Create a new file from UTF-8 text, failing if it exists.
pub fn create_new_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  create_new(path, bytes.from_str(text))
}

--- Create or truncate a file and write UTF-8 text.
pub fn write_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  write_all(path, bytes.from_str(text))
}

--- Append UTF-8 text to a file, creating it when absent.
pub fn append_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  append_all(path, bytes.from_str(text))
}

--- Atomically replace a file with UTF-8 text when supported by the handler.
pub fn atomic_replace_text(path: Path, text: str) -[FileWrite]> Result<usize, IoError> {
  atomic_replace(path, bytes.from_str(text))
}

fn file_open_failure(status: i64) -[Fail<IoError>]> never {
  Fail<IoError>.fail(io_error_from_errno(status))
}

--- Open an owned streaming handle for reading.
pub fn open_read(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_read_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for truncating writes.
pub fn open_write(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_write_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for reading and truncating writes.
pub fn open_read_write(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_read_write_checked_with(path_runtime_string(path), file_open_failure)
}

--- Open an owned streaming handle for appending writes.
pub fn open_append(path: Path) -[IO, Fail<IoError>]> owned FileHandle {
  io_file_open_append_checked_with(path_runtime_string(path), file_open_failure)
}

fn file_stream_len(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn file_stream_scratch(len: i64) -> Vector<u8> {
  let values = vector_with_capacity<u8>(len)
  for i in 0..len { values.push(__u64_to_u8(0)) }
  values
}

impl FileHandle {
  --- Read into `buffer`, returning bytes read, EOF, or a typed I/O error.
  pub fn read(self: borrow mut Self, buffer: [mut u8]) -[IO]> Result<IoReadProgress, IoError> {
    let len = file_stream_len(buffer.len)
    if len < 0 {
      Err<IoReadProgress, IoError>(IoInvalidProgress)
    } else { if len == 0 {
      Ok<IoReadProgress, IoError>(IoReadBytes(__i64_to_usize(0)))
    } else {
      let scratch = file_stream_scratch(len)
      let status = io_file_read_raw(self, vector_data<u8>(scratch), len)
      if status > len {
        Err<IoReadProgress, IoError>(IoInvalidProgress)
      } else {
        if status > 0 {
          for i in 0..status {
            buffer[__i64_to_usize(i)] = vector_get_in_bounds<u8>(scratch, i)
          }
        } else { 0 }
        io_read_progress_from_status(status)
      }
    } }
  }

  --- Write from `buffer`, returning bytes written or a typed I/O error.
  pub fn write(self: borrow mut Self, buffer: [u8]) -[IO]> Result<IoWriteProgress, IoError> {
    let len = file_stream_len(buffer.len)
    if len < 0 {
      Err<IoWriteProgress, IoError>(IoInvalidProgress)
    } else { if len == 0 {
      Ok<IoWriteProgress, IoError>(IoWroteBytes(__i64_to_usize(0)))
    } else {
      let scratch = vector_with_capacity<u8>(len)
      for i in 0..len { scratch.push(buffer[__i64_to_usize(i)]) }
      let status = io_file_write_raw(self, vector_data<u8>(scratch), len)
      if status > len { Err<IoWriteProgress, IoError>(IoInvalidProgress) }
      else { io_write_progress_from_status(status) }
    } }
  }

  --- Reposition relative to `origin`.
  pub fn seek(self: borrow mut Self, offset: i64, origin: FileSeekOrigin) -[IO]> Result<i64, IoError> {
    let status = match origin {
      FileSeekStart -> io_file_seek_start_raw(self, offset)
      FileSeekCurrent -> io_file_seek_current_raw(self, offset)
      FileSeekEnd -> io_file_seek_end_raw(self, offset)
    }
    if status < 0 { Err<i64, IoError>(io_error_from_errno(status)) }
    else { Ok<i64, IoError>(status) }
  }

  --- Flush buffered writes.
  pub fn flush(self: borrow mut Self) -[IO]> Result<nil, IoError> {
    let status = io_file_flush_raw(self)
    if status == 0 { Ok<nil, IoError>(nil) }
    else { if status < 0 { Err<nil, IoError>(io_error_from_errno(status)) }
    else { Err<nil, IoError>(IoInvalidProgress) } }
  }

  -- close consumes the owner even when the platform reports failure: POSIX
  -- close errors do not make retrying a descriptor safe.
  --- Close and consume the handle, even when the platform reports failure.
  pub fn close(self: owned Self) -[IO]> Result<nil, IoError> {
    let status = io_file_close_raw(self)
    if status == 0 { Ok<nil, IoError>(nil) }
    else { if status < 0 { Err<nil, IoError>(io_error_from_errno(status)) }
    else { Err<nil, IoError>(IoInvalidProgress) } }
  }
}
