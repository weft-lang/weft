-- stdlib/env/fixed.weft — deterministic process startup interpretation

use stdlib/env.{Env}
use stdlib/list.{Cons, List, Nil}
use stdlib/string.{str_byte_at, str_len, str_slice_bytes}

fn argument(arguments: List<str>, index: i64) -> str? {
  let mut rest = arguments
  let mut position = 0
  let mut found: str? = nil
  let mut done = index < 0
  while not done {
    match rest {
      Nil -> { done = true }
      Cons(value, tail) -> {
        if position == index {
          found = value
          done = true
        } else {
          rest = tail
          position = position + 1
        }
      }
    }
  }
  found
}

fn count(arguments: List<str>) -> i64 {
  arguments.fold(0, (total, value) => total + 1)
}

-- A name is valid when it is non-empty and contains neither `=` nor NUL,
-- the bytes that end a name or an entry in a platform environment.
fn valid_name(name: str) -> bool {
  not name.is_empty() and not name.contains("=") and not name.contains("\0")
}

-- The value of `entry` when it names `name`: the bytes after its first `=`,
-- exactly as a platform environment stores them.
fn entry_value(entry: str, name: str) -> str? {
  let n = str_len(name)
  if str_len(entry) > n and str_byte_at(entry, n) == 61 and entry.starts_with(name) {
    str_slice_bytes(entry, n + 1, str_len(entry) - n - 1)
  } else { nil }
}

fn variable(environment: List<str>, name: str) -> str? {
  let mut rest = environment
  let mut found: str? = nil
  let mut done = not valid_name(name)
  while not done {
    match rest {
      Nil -> { done = true }
      Cons(entry, tail) -> match entry_value(entry, name) {
        value: str -> {
          found = value
          done = true
        }
        nil -> { rest = tail }
      }
    }
  }
  found
}

--- Interpret `Env` through a fixed argument list and environment, as a
--- process started with them would observe. `arguments` includes argument
--- zero. `environment` holds entries in the platform's `NAME=value` form,
--- searched in order: the first entry naming a variable answers, and an
--- entry without `=` names none. Like the platform handler, the handler
--- answers `nil` for an empty name or one containing `=` or NUL.
pub implements Env(arguments: List<str>, environment: List<str>) {
  Env.arg_count() -> resume(count(arguments))
  Env.arg(index) -> resume(argument(arguments, index))
  Env.var(name) -> resume(variable(environment, name))
}
