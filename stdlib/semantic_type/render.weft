-- stdlib/semantic_type/render.weft -- canonical source-language type rendering

use runtime/string.{runtime_int_to_str}
use stdlib/semantic_type.{*}
use stdlib/string/builder as string_builder
use stdlib/string/builder.{Builder}

pub(package) fn semantic_type_append_list(
  out: borrow mut Builder,
  list: SemanticTypeFactList
) -> nil {
  let mut current = list
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticTypeFactListNil -> { done = true }
      SemanticTypeFactListCons(ty, rest) -> {
        if not first { out.append(", ") } else { first = false }
        semantic_type_append(out, ty)
        current = rest
      }
      SemanticTypeFactListOther(name) -> {
        if not first { out.append(", ") } else { nil }
        out.append(name)
        done = true
      }
    }
  }
}

pub(package) fn semantic_type_append_effect_atom(
  out: borrow mut Builder,
  atom: SemanticEffectAtomFact
) -> nil {
  match atom {
    SemanticEffectAtom(name, args) -> {
      out.append(name)
      match args {
        SemanticTypeFactListNil -> nil
        _ -> { out.append("<") semantic_type_append_list(out, args) out.append(">") }
      }
    }
    SemanticQualifiedEffectAtom(module_name, name, args) -> {
      out.append(module_name)
      out.append(".")
      out.append(name)
      match args {
        SemanticTypeFactListNil -> nil
        _ -> { out.append("<") semantic_type_append_list(out, args) out.append(">") }
      }
    }
    SemanticEffectAtomOther(name) -> out.append(name)
  }
}

pub(package) fn semantic_type_append_effect_atoms(
  out: borrow mut Builder,
  atoms: SemanticEffectAtomFactList
) -> bool {
  let mut current = atoms
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticEffectAtomFactListNil -> { done = true }
      SemanticEffectAtomFactListCons(atom, rest) -> {
        if not first { out.append(", ") } else { first = false }
        semantic_type_append_effect_atom(out, atom)
        current = rest
      }
      SemanticEffectAtomFactListOther(name) -> {
        if not first { out.append(", ") } else { nil }
        out.append(name)
        done = true
      }
    }
  }
  not first
}

pub(package) fn semantic_type_append_effects(
  out: borrow mut Builder,
  effects: SemanticEffectSetFact
) -> nil {
  match effects {
    SemanticEffectsClosed(SemanticEffectAtomFactListNil) -> out.append(" -> ")
    SemanticEffectsClosed(atoms) -> {
      out.append(" -[")
      semantic_type_append_effect_atoms(out, atoms)
      out.append("]> ")
    }
    SemanticEffectsOpen(atoms, tail) -> {
      out.append(" -[")
      let had_atoms = semantic_type_append_effect_atoms(out, atoms)
      if had_atoms { out.append(", ") } else { nil }
      out.append(tail)
      out.append("]> ")
    }
    SemanticEffectsOther(name) -> { out.append(" -[") out.append(name) out.append("]> ") }
  }
}

--- Render a comma-separated type list without delimiters.
pub(package) fn semantic_type_list_render(list: SemanticTypeFactList) -> str {
  let mut out = string_builder.with_capacity(32)
  semantic_type_append_list(out, list)
  out.finish()
}

--- Render a function effect arrow: ` -> `, or ` -[atoms]> ` with any tail.
pub(package) fn semantic_type_effects_arrow(effects: SemanticEffectSetFact) -> str {
  let mut out = string_builder.with_capacity(16)
  semantic_type_append_effects(out, effects)
  out.finish()
}

impl SemanticEffectAtomFact {
  --- Render this effect atom in canonical source-language spelling.
  pub fn render(self) -> str {
    let mut out = string_builder.with_capacity(32)
    semantic_type_append_effect_atom(out, self)
    out.finish()
  }
}

-- Effect-set facts render as the source-level capability list without the
-- function arrow. This keeps diagnostics natural while function-type
-- rendering continues to own `->` / `-[...]>` punctuation.
impl SemanticEffectSetFact {
  --- Render this effect set as a capability list, using `pure` when empty.
  pub fn render(self) -> str {
    let mut out = string_builder.with_capacity(32)
    match self {
      SemanticEffectsClosed(SemanticEffectAtomFactListNil) -> out.append("pure")
      SemanticEffectsClosed(atoms) -> {
        semantic_type_append_effect_atoms(out, atoms)
        nil
      }
      SemanticEffectsOpen(atoms, tail) -> {
        let had_atoms = semantic_type_append_effect_atoms(out, atoms)
        if had_atoms { out.append(", ") } else { nil }
        out.append(tail)
      }
      SemanticEffectsOther(name) -> out.append(name)
    }
    out.finish()
  }
}

pub(package) fn semantic_type_append_record_fields(
  out: borrow mut Builder,
  fields: SemanticRecordFieldFactList,
  tuple: bool
) -> nil {
  let mut current = fields
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticRecordFieldFactListNil -> { done = true }
      SemanticRecordFieldFactListCons(field, rest) -> {
        if not first { out.append(", ") } else { first = false }
        match field {
          SemanticRecordField(name, index, ty) -> {
            if not tuple { out.append(name) out.append(": ") } else { nil }
            semantic_type_append(out, ty)
          }
          SemanticRecordFieldOther(name) -> out.append(name)
        }
        current = rest
      }
      SemanticRecordFieldFactListOther(name) -> {
        if not first { out.append(", ") } else { nil }
        out.append(name)
        done = true
      }
    }
  }
}

pub(package) fn semantic_type_record_field_count(fields: SemanticRecordFieldFactList) -> i64 {
  let mut current = fields
  let mut count = 0
  let mut done = false
  while not done {
    match current {
      SemanticRecordFieldFactListNil -> { done = true }
      SemanticRecordFieldFactListCons(field, rest) -> { count = count + 1 current = rest }
      SemanticRecordFieldFactListOther(name) -> { count = count + 1 done = true }
    }
  }
  count
}

-- Mirrors the source grammar: union < intersection < prefix < atom. Rendering
-- through this table preserves the fact's set meaning instead of relying on a
-- consumer to guess where parentheses belonged.
pub(package) fn semantic_type_precedence(ty: SemanticTypeFact) -> i64 {
  match ty {
    SemanticTypeUnion(left, right) -> 1
    SemanticTypeIntersection(left, right) -> 2
    SemanticTypeComplement(inner) -> 3
    SemanticTypePointer(inner, mutable) -> 3
    SemanticTypeWeak(inner) -> 3
    SemanticTypeUnique(inner) -> 3
    SemanticTypeOwned(inner) -> 3
    SemanticTypeBorrow(inner, mutable) -> 3
    _ -> 4
  }
}

pub(package) fn semantic_type_append_at(
  out: borrow mut Builder,
  ty: SemanticTypeFact,
  minimum_precedence: i64
) -> nil {
  let grouped = semantic_type_precedence(ty) < minimum_precedence
  if grouped { out.append("(") } else { nil }
  match ty {
    SemanticTypeBottom -> out.append("never")
    SemanticTypeTop -> out.append("any")
    SemanticTypePrimitive(name) -> out.append(name)
    SemanticTypeNamed(name, args) -> {
      out.append(name)
      match args {
        SemanticTypeFactListNil -> nil
        _ -> { out.append("<") semantic_type_append_list(out, args) out.append(">") }
      }
    }
    SemanticTypeQualifiedNamed(module_name, name, args) -> {
      out.append(module_name)
      out.append(".")
      out.append(name)
      match args {
        SemanticTypeFactListNil -> nil
        _ -> { out.append("<") semantic_type_append_list(out, args) out.append(">") }
      }
    }
    SemanticTypeVariable(name) -> out.append(name)
    SemanticTypeUnion(left, right) -> {
      semantic_type_append_at(out, left, 1)
      out.append(" | ")
      semantic_type_append_at(out, right, 1)
    }
    SemanticTypeIntersection(left, right) -> {
      semantic_type_append_at(out, left, 2)
      out.append(" & ")
      semantic_type_append_at(out, right, 2)
    }
    SemanticTypeComplement(inner) -> { out.append("~") semantic_type_append_at(out, inner, 3) }
    SemanticTypeFunction(params, result, effects) -> {
      out.append("(")
      semantic_type_append_list(out, params)
      out.append(")")
      semantic_type_append_effects(out, effects)
      semantic_type_append(out, result)
    }
    SemanticTypeRecord(fields, open, tuple) -> {
      if tuple { out.append("(") } else { out.append("{") }
      semantic_type_append_record_fields(out, fields, tuple)
      let field_count = semantic_type_record_field_count(fields)
      if open { if field_count > 0 { out.append(", ..") } else { out.append("..") } }
      else { if tuple and field_count == 1 { out.append(",") } else { nil } }
      if tuple { out.append(")") } else { out.append("}") }
    }
    SemanticTypeContinuation(input, output) -> {
      out.append("continuation<")
      semantic_type_append(out, input)
      out.append(", ")
      semantic_type_append(out, output)
      out.append(">")
    }
    SemanticTypePointer(inner, mutable) -> {
      if mutable { out.append("*mut ") } else { out.append("*") }
      semantic_type_append_at(out, inner, 3)
    }
    SemanticTypeWeak(inner) -> { out.append("weak ") semantic_type_append_at(out, inner, 3) }
    SemanticTypeUnique(inner) -> { out.append("unique ") semantic_type_append_at(out, inner, 3) }
    SemanticTypeOwned(inner) -> { out.append("owned ") semantic_type_append_at(out, inner, 3) }
    SemanticTypeBorrow(inner, mutable) -> {
      if mutable { out.append("borrow mut ") } else { out.append("borrow ") }
      semantic_type_append_at(out, inner, 3)
    }
    SemanticTypeTrait(name) -> out.append(name)
    SemanticTypeQualifiedTrait(module_name, name) -> {
      out.append(module_name)
      out.append(".")
      out.append(name)
    }
    SemanticTypeArray(inner, length) -> {
      out.append("[")
      semantic_type_append(out, inner)
      out.append("; ")
      out.append(runtime_int_to_str(length))
      out.append("]")
    }
    SemanticTypeSlice(inner, mutable) -> {
      if mutable { out.append("[mut ") } else { out.append("[") }
      semantic_type_append(out, inner)
      out.append("]")
    }
    SemanticTypeAssociated(owner, name) -> {
      semantic_type_append_at(out, owner, 4)
      out.append(".")
      out.append(name)
    }
    SemanticTypeOther(name) -> out.append(name)
  }
  if grouped { out.append(")") } else { nil }
}

pub(package) fn semantic_type_append(out: borrow mut Builder, ty: SemanticTypeFact) -> nil {
  semantic_type_append_at(out, ty, 0)
}

impl SemanticTypeFact {
  --- Render this semantic type fact with canonical source syntax.
  pub fn render(self) -> str {
    let mut out = string_builder.with_capacity(64)
    semantic_type_append(out, self)
    out.finish()
  }
}
