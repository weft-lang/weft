-- stdlib/semantic_type/json.weft — JSON codec for the semantic type fact family
--
-- The encoding is the `kind`-tagged vocabulary the compiler's tools already
-- emit for type facts. A list terminator carried by an `...Other` variant is
-- encoded as `{"kind":"list_other"}` so it is never confused with an
-- `Other` element. Decoding is exact: an unknown kind or a missing member is
-- a structured error, never a silent default.

use stdlib/json.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/string.{str_concat}

--- Why a JSON document is not a semantic type fact.
pub type SemanticJsonError {
  --- The named member is missing or has the wrong shape at the given kind.
  SemanticJsonShape(str, str),
  --- The `kind` tag is not part of this schema.
  SemanticJsonUnknownKind(str)
}

fn entry(key: str, value: Json) -> JsonEntry { JsonEntry(key, value) }

fn object1(first: JsonEntry) -> Json { JsonObject(Cons(first, Nil<JsonEntry>())) }

fn object2(first: JsonEntry, second: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Nil<JsonEntry>())))
}

fn object3(first: JsonEntry, second: JsonEntry, third: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Cons(third, Nil<JsonEntry>()))))
}

fn object4(first: JsonEntry, second: JsonEntry, third: JsonEntry, fourth: JsonEntry) -> Json {
  JsonObject(Cons(first, Cons(second, Cons(third, Cons(fourth, Nil<JsonEntry>())))))
}

fn kind_of(value: Json) -> str { json_object_get_str(value, "kind", "") }

fn member(value: Json, key: str) -> Option<Json> { json_object_get(value, key) }

fn shape<T>(kind: str, what: str) -> Result<T, SemanticJsonError> {
  Err<T, SemanticJsonError>(SemanticJsonShape(kind, what))
}

fn text_member(value: Json, kind: str, key: str) -> Result<str, SemanticJsonError> {
  match member(value, key) {
    Some(JsonString(text)) -> Ok<str, SemanticJsonError>(text)
    _ -> shape<str>(kind, key)
  }
}

fn bool_member(value: Json, kind: str, key: str) -> Result<bool, SemanticJsonError> {
  match member(value, key) {
    Some(JsonBool(flag)) -> Ok<bool, SemanticJsonError>(flag)
    _ -> shape<bool>(kind, key)
  }
}

fn number_member(value: Json, kind: str, key: str) -> Result<i64, SemanticJsonError> {
  match member(value, key) {
    Some(JsonNumber(number)) -> Ok<i64, SemanticJsonError>(number)
    _ -> shape<i64>(kind, key)
  }
}

fn object_member(value: Json, kind: str, key: str) -> Result<Json, SemanticJsonError> {
  match member(value, key) {
    Some(inner) -> if json_kind(inner) == 5 { Ok<Json, SemanticJsonError>(inner) } else {
      shape<Json>(kind, key)
    }
    None -> shape<Json>(kind, key)
  }
}

fn array_member(value: Json, kind: str, key: str) -> Result<List<Json>, SemanticJsonError> {
  match member(value, key) {
    Some(JsonArray(items)) -> Ok<List<Json>, SemanticJsonError>(items)
    _ -> shape<List<Json>>(kind, key)
  }
}

-- Encoding.
--- Encode a type fact.
pub fn encode_type(fact: SemanticTypeFact) -> Json {
  match fact {
    SemanticTypeBottom -> object1(entry("kind", JsonString("bottom")))
    SemanticTypeTop -> object1(entry("kind", JsonString("top")))
    SemanticTypePrimitive(name) -> object2(
      entry("kind", JsonString("primitive")),
      entry("name", JsonString(name))
    )
    SemanticTypeNamed(name, arguments) ->
      object3(
        entry("kind", JsonString("named")),
        entry("name", JsonString(name)),
        entry("arguments", encode_type_list(arguments))
      )
    SemanticTypeQualifiedNamed(module_name, name, arguments) ->
      object4(
        entry("kind", JsonString("qualified_named")),
        entry("module", JsonString(module_name)),
        entry("name", JsonString(name)),
        entry("arguments", encode_type_list(arguments))
      )
    SemanticTypeVariable(name) -> object2(
      entry("kind", JsonString("variable")),
      entry("name", JsonString(name))
    )
    SemanticTypeUnion(left, right) ->
      object3(
        entry("kind", JsonString("union")),
        entry("left", encode_type(left)),
        entry("right", encode_type(right))
      )
    SemanticTypeIntersection(left, right) ->
      object3(
        entry("kind", JsonString("intersection")),
        entry("left", encode_type(left)),
        entry("right", encode_type(right))
      )
    SemanticTypeComplement(inner) -> object2(
      entry("kind", JsonString("complement")),
      entry("inner", encode_type(inner))
    )
    SemanticTypeFunction(parameters, result, effects) ->
      object4(
        entry("kind", JsonString("function")),
        entry("parameters", encode_type_list(parameters)),
        entry("return_type", encode_type(result)),
        entry("effects", encode_effect_set(effects))
      )
    SemanticTypeRecord(fields, open, tuple) ->
      object4(
        entry("kind", JsonString("record")),
        entry("fields", encode_record_fields(fields)),
        entry("open", JsonBool(open)),
        entry("tuple", JsonBool(tuple))
      )
    SemanticTypeContinuation(input, result) ->
      object3(
        entry("kind", JsonString("continuation")),
        entry("input", encode_type(input)),
        entry("result", encode_type(result))
      )
    SemanticTypePointer(inner, mutable) ->
      object3(
        entry("kind", JsonString("pointer")),
        entry("inner", encode_type(inner)),
        entry("mutable", JsonBool(mutable))
      )
    SemanticTypeWeak(inner) -> object2(
      entry("kind", JsonString("weak")),
      entry("inner", encode_type(inner))
    )
    SemanticTypeUnique(inner) -> object2(
      entry("kind", JsonString("unique")),
      entry("inner", encode_type(inner))
    )
    SemanticTypeOwned(inner) -> object2(
      entry("kind", JsonString("owned")),
      entry("inner", encode_type(inner))
    )
    SemanticTypeBorrow(inner, mutable) ->
      object3(
        entry("kind", JsonString("borrow")),
        entry("inner", encode_type(inner)),
        entry("mutable", JsonBool(mutable))
      )
    SemanticTypeTrait(name) -> object2(
      entry("kind", JsonString("trait")),
      entry("name", JsonString(name))
    )
    SemanticTypeQualifiedTrait(module_name, name) ->
      object3(
        entry("kind", JsonString("qualified_trait")),
        entry("module", JsonString(module_name)),
        entry("name", JsonString(name))
      )
    SemanticTypeArray(element, length) ->
      object3(
        entry("kind", JsonString("array")),
        entry("element", encode_type(element)),
        entry("length", JsonNumber(length))
      )
    SemanticTypeSlice(element, mutable) ->
      object3(
        entry("kind", JsonString("slice")),
        entry("element", encode_type(element)),
        entry("mutable", JsonBool(mutable))
      )
    SemanticTypeAssociated(base, name) ->
      object3(
        entry("kind", JsonString("associated")),
        entry("base", encode_type(base)),
        entry("name", JsonString(name))
      )
    SemanticTypeOther(name) -> object2(
      entry("kind", JsonString("other")),
      entry("name", JsonString(name))
    )
  }
}

fn list_other(name: str) -> Json {
  object2(entry("kind", JsonString("list_other")), entry("name", JsonString(name)))
}

fn type_list_items(facts: SemanticTypeFactList, acc: List<Json>) -> List<Json> {
  match facts {
    SemanticTypeFactListNil -> acc.reverse()
    SemanticTypeFactListCons(fact, rest) -> type_list_items(rest, Cons(encode_type(fact), acc))
    SemanticTypeFactListOther(name) -> Cons(list_other(name), acc).reverse()
  }
}

--- Encode an ordered type fact list, keeping an `Other` terminator.
pub fn encode_type_list(facts: SemanticTypeFactList) -> Json {
  JsonArray(type_list_items(facts, Nil<Json>()))
}

fn record_field_items(fields: SemanticRecordFieldFactList, acc: List<Json>) -> List<Json> {
  match fields {
    SemanticRecordFieldFactListNil -> acc.reverse()
    SemanticRecordFieldFactListCons(field, rest) -> {
      let encoded = match field {
        SemanticRecordField(name, index, fact) ->
          object3(
            entry("name", JsonString(name)),
            entry("index", JsonNumber(index)),
            entry("type", encode_type(fact))
          )
        SemanticRecordFieldOther(name) -> object2(
          entry("kind", JsonString("other")),
          entry("name", JsonString(name))
        )
      }
      record_field_items(rest, Cons(encoded, acc))
    }
    SemanticRecordFieldFactListOther(name) -> Cons(list_other(name), acc).reverse()
  }
}

--- Encode record fields in declared order.
pub fn encode_record_fields(fields: SemanticRecordFieldFactList) -> Json {
  JsonArray(record_field_items(fields, Nil<Json>()))
}

--- Encode one effect atom.
pub fn encode_effect_atom(atom: SemanticEffectAtomFact) -> Json {
  match atom {
    SemanticEffectAtom(name, arguments) ->
      object2(entry("name", JsonString(name)), entry("arguments", encode_type_list(arguments)))
    SemanticQualifiedEffectAtom(module_name, name, arguments) ->
      object3(
        entry("module", JsonString(module_name)),
        entry("name", JsonString(name)),
        entry("arguments", encode_type_list(arguments))
      )
    SemanticEffectAtomOther(name) -> object2(
      entry("kind", JsonString("other")),
      entry("name", JsonString(name))
    )
  }
}

fn effect_atom_items(atoms: SemanticEffectAtomFactList, acc: List<Json>) -> List<Json> {
  match atoms {
    SemanticEffectAtomFactListNil -> acc.reverse()
    SemanticEffectAtomFactListCons(atom, rest) -> effect_atom_items(
      rest,
      Cons(encode_effect_atom(atom), acc)
    )
    SemanticEffectAtomFactListOther(name) -> Cons(list_other(name), acc).reverse()
  }
}

--- Encode an effect set.
pub fn encode_effect_set(effects: SemanticEffectSetFact) -> Json {
  match effects {
    SemanticEffectsClosed(atoms) -> object2(
      entry("kind", JsonString("closed")),
      entry("atoms", JsonArray(effect_atom_items(atoms, Nil<Json>())))
    )
    SemanticEffectsOpen(atoms, tail) ->
      object3(
        entry("kind", JsonString("open")),
        entry("atoms", JsonArray(effect_atom_items(atoms, Nil<Json>()))),
        entry("tail", JsonString(tail))
      )
    SemanticEffectsOther(name) -> object2(
      entry("kind", JsonString("other")),
      entry("name", JsonString(name))
    )
  }
}

-- Decoding.
fn decode_pair(
  value: Json,
  kind: str,
  left_key: str,
  right_key: str
) -> Result<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError> {
  match object_member(value, kind, left_key) {
    Err(error) -> Err<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError>(error)
    Ok(left_json) -> match object_member(value, kind, right_key) {
      Err(error) -> Err<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError>(error)
      Ok(right_json) -> match decode_type(left_json) {
        Err(error) -> Err<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError>(error)
        Ok(left) -> match decode_type(right_json) {
          Err(error) -> Err<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError>(error)
          Ok(right) -> Ok<(SemanticTypeFact, SemanticTypeFact), SemanticJsonError>((left, right))
        }
      }
    }
  }
}

fn decode_inner(value: Json, kind: str, key: str) -> Result<SemanticTypeFact, SemanticJsonError> {
  match object_member(value, kind, key) {
    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
    Ok(inner) -> decode_type(inner)
  }
}

fn decode_named(value: Json, kind: str) -> Result<SemanticTypeFact, SemanticJsonError> {
  match text_member(value, kind, "name") {
    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
    Ok(name) -> match array_member(value, kind, "arguments") {
      Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
      Ok(items) -> match decode_type_list(items) {
        Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
        Ok(arguments) -> if kind == "named" {
          Ok<SemanticTypeFact, SemanticJsonError>(SemanticTypeNamed(name, arguments))
        } else {
          match text_member(value, kind, "module") {
            Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
            Ok(module_name) -> Ok<SemanticTypeFact, SemanticJsonError>(
              SemanticTypeQualifiedNamed(module_name, name, arguments)
            )
          }
        }
      }
    }
  }
}

fn decode_function(value: Json) -> Result<SemanticTypeFact, SemanticJsonError> {
  match array_member(value, "function", "parameters") {
    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
    Ok(items) -> match decode_type_list(items) {
      Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
      Ok(parameters) -> match decode_inner(value, "function", "return_type") {
        Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
        Ok(result) -> match object_member(value, "function", "effects") {
          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
          Ok(effects_json) -> match decode_effect_set(effects_json) {
            Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
            Ok(effects) -> Ok<SemanticTypeFact, SemanticJsonError>(
              SemanticTypeFunction(parameters, result, effects)
            )
          }
        }
      }
    }
  }
}

fn decode_record(value: Json) -> Result<SemanticTypeFact, SemanticJsonError> {
  match array_member(value, "record", "fields") {
    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
    Ok(items) -> match decode_record_fields(items) {
      Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
      Ok(fields) -> match bool_member(value, "record", "open") {
        Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
        Ok(open) -> match bool_member(value, "record", "tuple") {
          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
          Ok(tuple) -> Ok<SemanticTypeFact, SemanticJsonError>(
            SemanticTypeRecord(fields, open, tuple)
          )
        }
      }
    }
  }
}

fn decode_flagged(
  value: Json,
  kind: str,
  key: str
) -> Result<(SemanticTypeFact, bool), SemanticJsonError> {
  match decode_inner(value, kind, key) {
    Err(error) -> Err<(SemanticTypeFact, bool), SemanticJsonError>(error)
    Ok(inner) -> match bool_member(value, kind, "mutable") {
      Err(error) -> Err<(SemanticTypeFact, bool), SemanticJsonError>(error)
      Ok(flag) -> Ok<(SemanticTypeFact, bool), SemanticJsonError>((inner, flag))
    }
  }
}

--- Decode a type fact.
pub fn decode_type(value: Json) -> Result<SemanticTypeFact, SemanticJsonError> {
  if json_kind(value) != 5 { return shape<SemanticTypeFact>("type", "object") } else { 0 }
  let kind = kind_of(value)
  if kind == "bottom" { Ok<SemanticTypeFact, SemanticJsonError>(SemanticTypeBottom) }
  else {
    if kind == "top" { Ok<SemanticTypeFact, SemanticJsonError>(SemanticTypeTop) }
    else {
      if kind == "primitive" {
        match text_member(value, kind, "name") {
          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
          Ok(name) -> Ok<SemanticTypeFact, SemanticJsonError>(SemanticTypePrimitive(name))
        }
      } else {
        if kind == "named" or kind == "qualified_named" { decode_named(value, kind) }
        else {
          if kind == "variable" {
            match text_member(value, kind, "name") {
              Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
              Ok(name) -> Ok<SemanticTypeFact, SemanticJsonError>(SemanticTypeVariable(name))
            }
          } else {
            if kind == "union" {
              match decode_pair(value, kind, "left", "right") {
                Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                Ok((left, right)) -> Ok<SemanticTypeFact, SemanticJsonError>(
                  SemanticTypeUnion(left, right)
                )
              }
            } else {
              if kind == "intersection" {
                match decode_pair(value, kind, "left", "right") {
                  Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                  Ok((left, right)) -> Ok<SemanticTypeFact, SemanticJsonError>(
                    SemanticTypeIntersection(left, right)
                  )
                }
              } else {
                if kind == "complement" {
                  match decode_inner(value, kind, "inner") {
                    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                    Ok(inner) -> Ok<SemanticTypeFact, SemanticJsonError>(
                      SemanticTypeComplement(inner)
                    )
                  }
                } else {
                  if kind == "function" { decode_function(value) }
                  else {
                    if kind == "record" { decode_record(value) }
                    else {
                      if kind == "continuation" {
                        match decode_pair(value, kind, "input", "result") {
                          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                          Ok((input, result)) -> Ok<SemanticTypeFact, SemanticJsonError>(
                            SemanticTypeContinuation(input, result)
                          )
                        }
                      } else {
                        if kind == "pointer" {
                          match decode_flagged(value, kind, "inner") {
                            Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                            Ok((inner, mutable)) -> Ok<SemanticTypeFact, SemanticJsonError>(
                              SemanticTypePointer(inner, mutable)
                            )
                          }
                        } else {
                          if kind == "weak" {
                            match decode_inner(value, kind, "inner") {
                              Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                              Ok(inner) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                SemanticTypeWeak(inner)
                              )
                            }
                          } else {
                            if kind == "unique" {
                              match decode_inner(value, kind, "inner") {
                                Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                                Ok(inner) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                  SemanticTypeUnique(inner)
                                )
                              }
                            } else {
                              if kind == "owned" {
                                match decode_inner(value, kind, "inner") {
                                  Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                                  Ok(inner) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                    SemanticTypeOwned(inner)
                                  )
                                }
                              } else {
                                if kind == "borrow" {
                                  match decode_flagged(value, kind, "inner") {
                                    Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(error)
                                    Ok((inner, mutable)) -> Ok<
                                      SemanticTypeFact,
                                      SemanticJsonError
                                    >(SemanticTypeBorrow(inner, mutable))
                                  }
                                } else {
                                  if kind == "trait" {
                                    match text_member(value, kind, "name") {
                                      Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                        error
                                      )
                                      Ok(name) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                        SemanticTypeTrait(name)
                                      )
                                    }
                                  } else {
                                    if kind == "qualified_trait" {
                                      match text_member(value, kind, "module") {
                                        Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                          error
                                        )
                                        Ok(module_name) -> match text_member(value, kind, "name") {
                                          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                            error
                                          )
                                          Ok(name) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                            SemanticTypeQualifiedTrait(module_name, name)
                                          )
                                        }
                                      }
                                    } else {
                                      if kind == "array" {
                                        match decode_inner(value, kind, "element") {
                                          Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                            error
                                          )
                                          Ok(element) -> match number_member(
                                            value,
                                            kind,
                                            "length"
                                          ) {
                                            Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                              error
                                            )
                                            Ok(length) -> Ok<SemanticTypeFact, SemanticJsonError>(
                                              SemanticTypeArray(element, length)
                                            )
                                          }
                                        }
                                      } else {
                                        if kind == "slice" {
                                          match decode_flagged(value, kind, "element") {
                                            Err(error) -> Err<SemanticTypeFact, SemanticJsonError>(
                                              error
                                            )
                                            Ok((element, mutable)) -> Ok<
                                              SemanticTypeFact,
                                              SemanticJsonError
                                            >(SemanticTypeSlice(element, mutable))
                                          }
                                        } else {
                                          if kind == "associated" {
                                            match decode_inner(value, kind, "base") {
                                              Err(error) -> Err<
                                                SemanticTypeFact,
                                                SemanticJsonError
                                              >(error)
                                              Ok(base) -> match text_member(value, kind, "name") {
                                                Err(error) -> Err<
                                                  SemanticTypeFact,
                                                  SemanticJsonError
                                                >(error)
                                                Ok(name) -> Ok<
                                                  SemanticTypeFact,
                                                  SemanticJsonError
                                                >(SemanticTypeAssociated(base, name))
                                              }
                                            }
                                          } else {
                                            if kind == "other" {
                                              match text_member(value, kind, "name") {
                                                Err(error) -> Err<
                                                  SemanticTypeFact,
                                                  SemanticJsonError
                                                >(error)
                                                Ok(name) -> Ok<
                                                  SemanticTypeFact,
                                                  SemanticJsonError
                                                >(SemanticTypeOther(name))
                                              }
                                            } else {
                                              Err<SemanticTypeFact, SemanticJsonError>(
                                                SemanticJsonUnknownKind(kind)
                                              )
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn decode_type_items(items: List<Json>) -> Result<SemanticTypeFactList, SemanticJsonError> {
  match items {
    Nil -> Ok<SemanticTypeFactList, SemanticJsonError>(SemanticTypeFactListNil)
    Cons(item, rest) -> if json_kind(item) == 5 and kind_of(item) == "list_other" {
      match text_member(item, "list_other", "name") {
        Err(error) -> Err<SemanticTypeFactList, SemanticJsonError>(error)
        Ok(name) -> Ok<SemanticTypeFactList, SemanticJsonError>(SemanticTypeFactListOther(name))
      }
    } else {
      match decode_type(item) {
        Err(error) -> Err<SemanticTypeFactList, SemanticJsonError>(error)
        Ok(fact) -> match decode_type_items(rest) {
          Err(error) -> Err<SemanticTypeFactList, SemanticJsonError>(error)
          Ok(tail) -> Ok<SemanticTypeFactList, SemanticJsonError>(
            SemanticTypeFactListCons(fact, tail)
          )
        }
      }
    }
  }
}

--- Decode an ordered type fact list.
pub fn decode_type_list(items: List<Json>) -> Result<SemanticTypeFactList, SemanticJsonError> {
  decode_type_items(items)
}

fn decode_record_field(item: Json) -> Result<SemanticRecordFieldFact, SemanticJsonError> {
  if json_kind(item) != 5 { return shape<SemanticRecordFieldFact>("record_field", "object") } else {
    0
  }
  if kind_of(item) == "other" {
    match text_member(item, "other", "name") {
      Err(error) -> Err<SemanticRecordFieldFact, SemanticJsonError>(error)
      Ok(name) -> Ok<SemanticRecordFieldFact, SemanticJsonError>(SemanticRecordFieldOther(name))
    }
  } else {
    match text_member(item, "record_field", "name") {
      Err(error) -> Err<SemanticRecordFieldFact, SemanticJsonError>(error)
      Ok(name) -> match number_member(item, "record_field", "index") {
        Err(error) -> Err<SemanticRecordFieldFact, SemanticJsonError>(error)
        Ok(index) -> match decode_inner(item, "record_field", "type") {
          Err(error) -> Err<SemanticRecordFieldFact, SemanticJsonError>(error)
          Ok(fact) -> Ok<SemanticRecordFieldFact, SemanticJsonError>(
            SemanticRecordField(name, index, fact)
          )
        }
      }
    }
  }
}

--- Decode record fields in declared order.
pub fn decode_record_fields(
  items: List<Json>
) -> Result<SemanticRecordFieldFactList, SemanticJsonError> {
  match items {
    Nil -> Ok<SemanticRecordFieldFactList, SemanticJsonError>(SemanticRecordFieldFactListNil)
    Cons(item, rest) -> if json_kind(item) == 5 and kind_of(item) == "list_other" {
      match text_member(item, "list_other", "name") {
        Err(error) -> Err<SemanticRecordFieldFactList, SemanticJsonError>(error)
        Ok(name) -> Ok<SemanticRecordFieldFactList, SemanticJsonError>(
          SemanticRecordFieldFactListOther(name)
        )
      }
    } else {
      match decode_record_field(item) {
        Err(error) -> Err<SemanticRecordFieldFactList, SemanticJsonError>(error)
        Ok(field) -> match decode_record_fields(rest) {
          Err(error) -> Err<SemanticRecordFieldFactList, SemanticJsonError>(error)
          Ok(tail) -> Ok<SemanticRecordFieldFactList, SemanticJsonError>(
            SemanticRecordFieldFactListCons(field, tail)
          )
        }
      }
    }
  }
}

--- Decode one effect atom.
pub fn decode_effect_atom(item: Json) -> Result<SemanticEffectAtomFact, SemanticJsonError> {
  if json_kind(item) != 5 { return shape<SemanticEffectAtomFact>("effect_atom", "object") } else {
    0
  }
  if kind_of(item) == "other" {
    match text_member(item, "other", "name") {
      Err(error) -> Err<SemanticEffectAtomFact, SemanticJsonError>(error)
      Ok(name) -> Ok<SemanticEffectAtomFact, SemanticJsonError>(SemanticEffectAtomOther(name))
    }
  } else {
    match text_member(item, "effect_atom", "name") {
      Err(error) -> Err<SemanticEffectAtomFact, SemanticJsonError>(error)
      Ok(name) -> match array_member(item, "effect_atom", "arguments") {
        Err(error) -> Err<SemanticEffectAtomFact, SemanticJsonError>(error)
        Ok(items) -> match decode_type_list(items) {
          Err(error) -> Err<SemanticEffectAtomFact, SemanticJsonError>(error)
          Ok(arguments) -> match member(item, "module") {
            Some(JsonString(module_name)) -> Ok<SemanticEffectAtomFact, SemanticJsonError>(
              SemanticQualifiedEffectAtom(module_name, name, arguments)
            )
            Some(_) -> shape<SemanticEffectAtomFact>("effect_atom", "module")
            None -> Ok<SemanticEffectAtomFact, SemanticJsonError>(
              SemanticEffectAtom(name, arguments)
            )
          }
        }
      }
    }
  }
}

fn decode_effect_atoms(items: List<Json>) -> Result<SemanticEffectAtomFactList, SemanticJsonError>
{
  match items {
    Nil -> Ok<SemanticEffectAtomFactList, SemanticJsonError>(SemanticEffectAtomFactListNil)
    Cons(item, rest) -> if json_kind(item) == 5 and kind_of(item) == "list_other" {
      match text_member(item, "list_other", "name") {
        Err(error) -> Err<SemanticEffectAtomFactList, SemanticJsonError>(error)
        Ok(name) -> Ok<SemanticEffectAtomFactList, SemanticJsonError>(
          SemanticEffectAtomFactListOther(name)
        )
      }
    } else {
      match decode_effect_atom(item) {
        Err(error) -> Err<SemanticEffectAtomFactList, SemanticJsonError>(error)
        Ok(atom) -> match decode_effect_atoms(rest) {
          Err(error) -> Err<SemanticEffectAtomFactList, SemanticJsonError>(error)
          Ok(tail) -> Ok<SemanticEffectAtomFactList, SemanticJsonError>(
            SemanticEffectAtomFactListCons(atom, tail)
          )
        }
      }
    }
  }
}

--- Decode an effect set.
pub fn decode_effect_set(value: Json) -> Result<SemanticEffectSetFact, SemanticJsonError> {
  if json_kind(value) != 5 { return shape<SemanticEffectSetFact>("effect_set", "object") } else {
    0
  }
  let kind = kind_of(value)
  if kind == "closed" or kind == "open" {
    match array_member(value, kind, "atoms") {
      Err(error) -> Err<SemanticEffectSetFact, SemanticJsonError>(error)
      Ok(items) -> match decode_effect_atoms(items) {
        Err(error) -> Err<SemanticEffectSetFact, SemanticJsonError>(error)
        Ok(atoms) -> if kind == "closed" {
          Ok<SemanticEffectSetFact, SemanticJsonError>(SemanticEffectsClosed(atoms))
        } else {
          match text_member(value, kind, "tail") {
            Err(error) -> Err<SemanticEffectSetFact, SemanticJsonError>(error)
            Ok(tail) -> Ok<SemanticEffectSetFact, SemanticJsonError>(
              SemanticEffectsOpen(atoms, tail)
            )
          }
        }
      }
    }
  } else {
    if kind == "other" {
      match text_member(value, kind, "name") {
        Err(error) -> Err<SemanticEffectSetFact, SemanticJsonError>(error)
        Ok(name) -> Ok<SemanticEffectSetFact, SemanticJsonError>(SemanticEffectsOther(name))
      }
    } else { Err<SemanticEffectSetFact, SemanticJsonError>(SemanticJsonUnknownKind(kind)) }
  }
}

--- Render an error for tool output.
pub fn error_message(error: SemanticJsonError) -> str {
  match error {
    SemanticJsonShape(kind, what) -> str_concat(
      "semantic type JSON: ",
      str_concat(kind, str_concat(" needs ", what))
    )
    SemanticJsonUnknownKind(kind) -> str_concat("semantic type JSON: unknown kind ", kind)
  }
}
