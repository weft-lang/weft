-- stdlib/dir.weft -- directory and filesystem metadata capability

use stdlib/eq.{Eq}
use stdlib/result.{*}
use stdlib/vector.{*}
use stdlib/io/types.{IoError}
use stdlib/path.{Path}

--- A portable filesystem entry kind.
pub type DirKind {
  --- A regular file.
  DirFile,
  --- A directory.
  DirDirectory,
  --- Another entry kind, including a symbolic link reported by `lstat`.
  DirOther
}

impl Eq for DirKind {
  fn eq(self: Self, other: Self) -> bool {
    match self {
      DirFile -> match other { DirFile -> true _ -> false }
      DirDirectory -> match other { DirDirectory -> true _ -> false }
      DirOther -> match other { DirOther -> true _ -> false }
    }
  }
}

--- Portable metadata plus traversal identity for one filesystem view.
pub type DirMetadata {
  --- Whether the requested path exists.
  exists: bool,
  --- The entry kind when it exists.
  kind: DirKind,
  --- The entry size in bytes when meaningful for its kind.
  size: i64,
  --- The last-modified time in Unix epoch milliseconds.
  modified_millis: i64,
  --- The device component of ephemeral traversal identity.
  device: i64,
  --- The inode component of ephemeral traversal identity.
  inode: i64
}

-- Mutation operations return 0 on success and the platform errno on failure.
-- stat treats an absent final path as successful metadata with exists=false;
-- other inspection failures remain Err(errno).
--- Legacy text-path directory authority; prefer `DirInspect` and `DirMutate`.
pub effect Dir {
  --- List directory entry names using the legacy text-path adapter.
  fn list(path: str) -> Result<Vector<str>, i64>
  --- Follow links and inspect metadata using the legacy adapter.
  fn stat(path: str) -> Result<DirMetadata, i64>
  --- Inspect a link itself rather than following it.
  fn lstat(path: str) -> Result<DirMetadata, i64>
  --- Create one directory using the legacy adapter.
  fn mkdir(path: str) -> i64
  --- Remove one filesystem entry using the legacy adapter.
  fn remove(path: str) -> i64
  --- Rename one filesystem entry using the legacy adapter.
  fn rename(from: str, to: str) -> i64
  --- Return the current directory using the legacy adapter.
  fn getcwd() -> Result<str, i64>
}

-- Safe public authority split. The legacy str/i64 Dir effect remains the
-- trusted adapter while callers migrate; these operations carry native Path
-- identity and typed errors and cannot imply one another.
--- Capability for non-mutating directory and metadata inspection.
pub effect DirInspect {
  --- List child paths without coercing native bytes to text.
  fn list(path: Path) -> Result<Vector<Path>, IoError>
  --- Follow links and inspect filesystem metadata.
  fn stat(path: Path) -> Result<DirMetadata, IoError>
  --- Inspect a link itself rather than following it.
  fn lstat(path: Path) -> Result<DirMetadata, IoError>
  --- Return the current directory as a native path.
  fn current() -> Result<Path, IoError>
}

--- Capability for directory and entry mutation.
pub effect DirMutate {
  --- Create one directory.
  fn mkdir(path: Path) -> Result<nil, IoError>
  --- Remove one filesystem entry.
  fn remove(path: Path) -> Result<nil, IoError>
  --- Rename one filesystem entry.
  fn rename(from: Path, to: Path) -> Result<nil, IoError>
}

--- List child paths without text coercion.
pub fn list(path: Path) -[DirInspect]> Result<Vector<Path>, IoError> {
  DirInspect.list(path)
}

--- Follow links and inspect filesystem metadata.
pub fn metadata(path: Path) -[DirInspect]> Result<DirMetadata, IoError> {
  DirInspect.stat(path)
}

--- Inspect metadata for a link itself rather than its target.
pub fn symlink_metadata(path: Path) -[DirInspect]> Result<DirMetadata, IoError> {
  DirInspect.lstat(path)
}

--- Return the current directory as a native path.
pub fn current() -[DirInspect]> Result<Path, IoError> {
  DirInspect.current()
}

--- Create one directory.
pub fn create(path: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.mkdir(path)
}

--- Remove one filesystem entry.
pub fn remove(path: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.remove(path)
}

--- Rename one filesystem entry.
pub fn rename(from: Path, to: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.rename(from, to)
}
