-- stdlib/dir.weft -- directory and filesystem metadata capability

use stdlib/result.{*}
use stdlib/vector.{*}
use stdlib/io_types.{IoError}
use stdlib/path.{Path}

pub type DirKind {
  DirFile,
  DirDirectory,
  DirOther
}

pub type DirMetadata {
  exists: bool,
  kind: DirKind,
  size: i64,
  modified_millis: i64,
  -- Traversal identity for one mounted filesystem view; not persistent storage.
  device: i64,
  inode: i64
}

-- Mutation operations return 0 on success and the platform errno on failure.
-- stat treats an absent final path as successful metadata with exists=false;
-- other inspection failures remain Err(errno).
pub effect Dir {
  fn list(path: str) -> Result<Vector<str>, i64>
  fn stat(path: str) -> Result<DirMetadata, i64>
  -- Unlike stat, lstat reports a symbolic link itself as DirOther.
  fn lstat(path: str) -> Result<DirMetadata, i64>
  fn mkdir(path: str) -> i64
  fn remove(path: str) -> i64
  fn rename(from: str, to: str) -> i64
  fn getcwd() -> Result<str, i64>
}

-- Safe public authority split. The legacy str/i64 Dir effect remains the
-- trusted adapter while callers migrate; these operations carry native Path
-- identity and typed errors and cannot imply one another.
pub effect DirInspect {
  fn list(path: Path) -> Result<Vector<Path>, IoError>
  fn stat(path: Path) -> Result<DirMetadata, IoError>
  fn lstat(path: Path) -> Result<DirMetadata, IoError>
  fn current() -> Result<Path, IoError>
}

pub effect DirMutate {
  fn mkdir(path: Path) -> Result<nil, IoError>
  fn remove(path: Path) -> Result<nil, IoError>
  fn rename(from: Path, to: Path) -> Result<nil, IoError>
}

pub fn dir_list(path: Path) -[DirInspect]> Result<Vector<Path>, IoError> {
  DirInspect.list(path)
}

pub fn dir_metadata(path: Path) -[DirInspect]> Result<DirMetadata, IoError> {
  DirInspect.stat(path)
}

pub fn dir_symlink_metadata(path: Path) -[DirInspect]> Result<DirMetadata, IoError> {
  DirInspect.lstat(path)
}

pub fn dir_current() -[DirInspect]> Result<Path, IoError> {
  DirInspect.current()
}

pub fn dir_create(path: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.mkdir(path)
}

pub fn dir_remove(path: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.remove(path)
}

pub fn dir_rename(from: Path, to: Path) -[DirMutate]> Result<nil, IoError> {
  DirMutate.rename(from, to)
}

pub fn dir_kind_code(kind: DirKind) -> i64 {
  match kind {
    DirFile -> 1
    DirDirectory -> 2
    DirOther -> 3
  }
}
