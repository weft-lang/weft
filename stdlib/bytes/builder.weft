-- stdlib/bytes/builder.weft -- linearly owned binary construction

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/drop.{Drop}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{
  IndexError,
  IndexOutOfBounds,
  vector_get_in_bounds,
  vector_len,
  vector_push_reserved,
  vector_reserve,
  vector_set
}
use stdlib/vector/handles.{Vector}

--- A linearly owned append-only builder for binary data.
---
--- Fixed-width integers are written little-endian, the byte order of every
--- binary format the SDK emits. Finishing yields immutable `Bytes`.
pub type Builder = opaque owned Vector<u8>

--- Construct an empty binary builder.
pub fn new() -> owned Builder {
  Builder(vector.new<u8>())
}

--- Construct an empty binary builder with room for at least `byte_capacity`
--- bytes.
pub fn with_capacity(byte_capacity: usize) -> owned Builder {
  Builder(vector.with_capacity<u8>(byte_capacity))
}

-- Lengths and offsets of builder storage are below its i64 length.
fn builder_count(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn builder_reserve(values: borrow Vector<u8>, additional: i64) -> nil {
  if not vector_reserve<u8>(values, vector_len<u8>(values) + additional) {
    panic("Binary builder capacity is too large")
  }
}

-- Append the low `count` bytes of `value`, least significant first. The
-- caller has reserved room for them.
fn builder_push_le(values: borrow Vector<u8>, value: u64, count: i64) -> nil {
  let mut remaining = value
  for _ in 0..count {
    vector_push_reserved<u8>(values, __u64_to_u8(remaining band 255))
    remaining = remaining bshr 8
  }
}

impl Builder {
  --- Return the number of bytes appended so far.
  pub fn len(self: borrow Self) -> usize {
    match self { Builder(values) -> values.len() }
  }

  --- Return whether no bytes have been appended.
  pub fn is_empty(self: borrow Self) -> bool {
    self.len() == 0
  }

  --- Append one byte.
  pub fn push(self: borrow mut Self, value: u8) -> nil {
    match self {
      Builder(values) -> {
        builder_reserve(values, 1)
        vector_push_reserved<u8>(values, value)
        nil
      }
    }
  }

  --- Append a 16-bit integer, least significant byte first.
  pub fn append_u16_le(self: borrow mut Self, value: u16) -> nil {
    match self {
      Builder(values) -> {
        builder_reserve(values, 2)
        builder_push_le(values, __u16_to_u64(value), 2)
      }
    }
  }

  --- Append a 32-bit integer, least significant byte first.
  pub fn append_u32_le(self: borrow mut Self, value: u32) -> nil {
    match self {
      Builder(values) -> {
        builder_reserve(values, 4)
        builder_push_le(values, __u32_to_u64(value), 4)
      }
    }
  }

  --- Append a 64-bit integer, least significant byte first.
  pub fn append_u64_le(self: borrow mut Self, value: u64) -> nil {
    match self {
      Builder(values) -> {
        builder_reserve(values, 8)
        builder_push_le(values, value, 8)
      }
    }
  }

  --- Append every byte of `values`.
  pub fn append(self: borrow mut Self, values: Bytes) -> nil {
    match self { Builder(out) -> values.append_to(out) }
  }

  --- Append the UTF-8 encoding of `text`, without a terminator.
  pub fn append_text(self: borrow mut Self, text: str) -> nil {
    match self { Builder(out) -> bytes.from_str(text).append_to(out) }
  }

  --- Append every byte appended to `other` so far.
  pub fn append_from(self: borrow mut Self, other: borrow Builder) -> nil {
    let count = builder_count(other.len())
    match self {
      Builder(out) -> match other {
        Builder(values) -> {
          builder_reserve(out, count)
          for index in 0..count {
            vector_push_reserved<u8>(out, vector_get_in_bounds<u8>(values, index))
          }
        }
      }
    }
  }

  --- Append `count` zero bytes.
  pub fn append_zeros(self: borrow mut Self, count: usize) -> nil {
    let total = builder_count(count)
    match self {
      Builder(values) -> {
        builder_reserve(values, total)
        for _ in 0..total { vector_push_reserved<u8>(values, __i64_to_u8(0)) }
      }
    }
  }

  --- Append zero bytes until the builder holds at least `length` bytes.
  pub fn pad_to(self: borrow mut Self, length: usize) -> nil {
    let current = self.len()
    if current < length { self.append_zeros(length - current) }
  }

  --- Overwrite the four bytes at `offset` with `value`, least significant
  --- first. Refuses, changing nothing, unless all four lie in the builder.
  pub fn set_u32_le(self: borrow mut Self, offset: usize, value: u32) -> Result<nil, IndexError> {
    let length = self.len()
    if offset > length or length - offset < 4 {
      return Err<nil, IndexError>(IndexOutOfBounds(offset, length))
    }
    let start = builder_count(offset)
    let mut remaining = __u32_to_u64(value)
    match self {
      Builder(values) -> for index in 0..4 {
        vector_set<u8>(values, start + index, __u64_to_u8(remaining band 255))
        remaining = remaining bshr 8
      }
    }
    Ok<nil, IndexError>(nil)
  }

  --- The 32-bit integer stored least significant first at `offset`, if all
  --- four of its bytes lie in the builder.
  pub fn get_u32_le(self: borrow Self, offset: usize) -> Option<u32> {
    let length = self.len()
    if offset > length or length - offset < 4 { return None<u32>() }
    let start = builder_count(offset)
    let mut value: u64 = 0
    match self {
      Builder(values) -> for index in 0..4 {
        let byte = __u8_to_u64(vector_get_in_bounds<u8>(values, start + 3 - index))
        value = (value bshl 8) bor byte
      }
    }
    Some<u32>(__u64_to_u32(value))
  }

  --- Consume the builder and copy its bytes into immutable `Bytes`.
  pub fn finish(self: owned Self) -> Bytes {
    match self { Builder(values) -> bytes.from_vector(values) }
  }
}

impl Drop for Builder {
  fn drop(self) -> nil {
    match self {
      Builder(values) -> values.drop()
    }
  }
}
