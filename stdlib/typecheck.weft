-- Structured host inspection for grammars and semantic tools.

use stdlib/list.{List}
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/semantic_type.{SemanticTypeFact}

--- A visible type name and its ordered arguments in the handler's scope.
--- A qualifier denotes an imported module name, rather than a filesystem path.
pub type TypeName<I> {
  --- The optional module qualifier visible to the host scope.
  qualifier: Option<str>,
  --- The primitive or declared type name.
  name: str,
  --- Already resolved type identities used as generic arguments.
  arguments: List<I>
}

--- A type's query identity and an independently retainable semantic description.
--- Descriptions are source vocabulary, never normalized DNF or identity keys.
pub type ResolvedType<I> {
  --- An identity interpreted only by the handler that issued it.
  identity: I,
  --- The shared structured type vocabulary used by diagnostics and tooling.
  description: SemanticTypeFact
}

--- Select a named record field or a zero-based tuple position.
pub type TypeField {
  --- A field selected by its source name.
  NamedTypeField(str),
  --- A tuple element selected by its zero-based position.
  PositionalTypeField(usize)
}

--- One ordered field returned from a host record or tuple inspection.
pub type ResolvedField<I> {
  --- Named or positional selector accepted by `TypeCheck.field`.
  selector: TypeField,
  --- Scoped identity and stable description of the field type.
  value: ResolvedType<I>
}

--- One rejected generic argument constraint, expressed only in stable type facts.
--- The zero-based position identifies the argument in the original request.
pub type TypeArgumentIssue {
  --- The argument does not conform to the required trait atom.
  TypeArgumentTraitRequired(usize, SemanticTypeFact, SemanticTypeFact),
  --- The trait conforms, but its requested associated-type bindings do not.
  TypeArgumentAssociatedTypesRejected(usize, SemanticTypeFact, SemanticTypeFact),
  --- An additive constraint form retained for forward-compatible consumers.
  TypeArgumentIssueOther(str)
}

--- A failed host query, distinct from a successful negative subtype answer.
pub type TypeQueryError {
  --- No type with this name is visible in the handler's scope.
  TypeNotFound,
  --- The type does not expose the requested named or positional field.
  TypeFieldNotFound,
  --- The type has no inspectable record or tuple field sequence.
  TypeFieldsUnavailable,
  --- The type expects the first argument count but received the second.
  TypeArgumentCount(usize, usize),
  --- Generic arguments violate the host's constraints, with structured reasons.
  TypeArgumentsRejected(List<TypeArgumentIssue>),
  --- An identity was issued by another handler scope or an expired scope.
  ForeignTypeIdentity
}

--- Inspect host types without receiving compiler storage or source-loading authority.
--- Handlers choose the identity representation and enforce its scope. A grammar
--- can use the same contract with a compiler host or an ordinary test catalog.
pub effect TypeCheck<I> {
  --- Resolve a visible primitive or declared type with exact generic arguments.
  fn resolve(request: TypeName<I>) -> Result<ResolvedType<I>, TypeQueryError>
  --- Inspect one field, preserving its identity and full substituted type.
  fn field(base: I, field: TypeField) -> Result<ResolvedType<I>, TypeQueryError>
  --- Inspect all fields in declared or tuple order.
  fn fields(base: I) -> Result<List<ResolvedField<I>>, TypeQueryError>
  --- Decide semantic subtyping; false is a valid answer, not a query failure.
  fn subtype(actual: I, expected: I) -> Result<bool, TypeQueryError>
}
