-- stdlib/string.weft — String operations
--
-- Weft strings are descriptors: [data_ptr(8), length(8)]
-- __str_ptr(s) returns data_ptr, __str_len(s) returns length.
-- String data is immutable UTF-8 bytes in the heap.
--
-- Layering note:
-- - `str` storage and compiler spans are byte-oriented UTF-8.
-- - `stdlib/string.weft` owns common string construction/comparison helpers.
-- - `stdlib/utf8.weft` should own scalar-aware UTF-8 validation, decoding,
--   encoding, codepoint counts, and boundary checks.
-- - Later `stdlib/unicode.weft` should own table-driven Unicode semantics such
--   as normalization, case folding, grapheme clusters, collation, and locale.

use "stdlib/io.weft"
use "stdlib/utf8.weft"
use "stdlib/vector.weft"
use "runtime/alloc.weft"

-- Concatenate two strings: "hello" ++ " world" → "hello world"
fn str_concat(a: str, b: str) -> str {
  let a_ptr = __str_ptr(a)
  let a_len = __str_len(a)
  let b_ptr = __str_ptr(b)
  let b_len = __str_len(b)
  let total = a_len + b_len
  -- Allocate data buffer (aligned to 8)
  let data = alloc_bump_rounded(total, 8)
  -- Copy a's bytes
  for i in 0..a_len {
    __mem_store8(data + i, __mem_load8(a_ptr + i))
  }
  -- Copy b's bytes
  for i in 0..b_len {
    __mem_store8(data + a_len + i, __mem_load8(b_ptr + i))
  }
  -- Allocate descriptor [data_ptr, length]
  let desc = alloc_words(2)
  __mem_store64(desc, data)
  __mem_store64(desc + 8, total)
  desc
}

-- Convert i64 to decimal string
fn int_to_str(n: i64) -> str {
  if n == 0 {
    "0"
  } else {
    -- Handle negative
    let is_neg = if n < 0 { 1 } else { 0 }
    let mut val = if n < 0 { 0 - n } else { n }
    -- Extract digits into a temporary buffer (max 20 digits for i64)
    let buf = alloc_bump(24)
    let mut pos = 0
    while val > 0 {
      let digit = val - val / 10 * 10
      __mem_store8(buf + pos, digit + 48)
      val = val / 10
      pos = pos + 1
    }
    if is_neg == 1 {
      __mem_store8(buf + pos, 45)
      pos = pos + 1
    } else { 0 }
    -- Reverse into final string
    let total = pos
    let data = alloc_bump_rounded(total, 8)
    for i in 0..total {
      __mem_store8(data + i, __mem_load8(buf + total - 1 - i))
    }
    -- Allocate descriptor
    let desc = alloc_words(2)
    __mem_store64(desc, data)
    __mem_store64(desc + 8, total)
    desc
  }
}

-- String length
fn str_len(s: str) -> i64 { __str_len(s) }

fn str_word_byte_at(s: i64, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

fn str_byte_at(s: str, index: i64) -> i64 {
  str_word_byte_at(s, index)
}

-- String equality (byte comparison)
fn str_eq(a: str, b: str) -> i64 {
  let a_len = __str_len(a)
  let b_len = __str_len(b)
  if a_len != b_len { false }
  else {
    let a_ptr = __str_ptr(a)
    let b_ptr = __str_ptr(b)
    let mut eq = true
    let mut i = 0
    while i < a_len {
      if __mem_load8(a_ptr + i) != __mem_load8(b_ptr + i) {
        eq = false
        i = a_len
      } else { i = i + 1 }
    }
    eq
  }
}

fn str_from_bytes_copy(ptr: i64, len: i64) -> str {
  if len <= 0 {
    ""
  } else {
    let data = alloc_bump_rounded(len, 8)
    for i in 0..len {
      __mem_store8(data + i, __mem_load8(ptr + i))
    }
    let desc = alloc_words(2)
    __mem_store64(desc, data)
    __mem_store64(desc + 8, len)
    desc
  }
}

fn str_slice_bytes(s: str, start: i64, len: i64) -> str {
  let n = __str_len(s)
  if start < 0 or len < 0 or start > n {
    ""
  } else {
    let take = if start + len > n { n - start } else { len }
    str_from_bytes_copy(__str_ptr(s) + start, take)
  }
}

fn str_eq_at(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  let needle_len = __str_len(needle)
  if pos < 0 or pos + needle_len > n { 0 }
  else {
    let needle_ptr = __str_ptr(needle)
    let mut ok = 1
    let mut i = 0
    while ok == 1 and i < needle_len {
      if __mem_load8(src + pos + i) != __mem_load8(needle_ptr + i) {
        ok = 0
      } else {
        i = i + 1
      }
    }
    ok
  }
}

fn str_find_from(s: str, needle: str, start: i64) -> i64 {
  let n = __str_len(s)
  let needle_len = __str_len(needle)
  let p0 = if start < 0 { 0 } else { start }
  if needle_len == 0 {
    if p0 <= n { p0 } else { 0 - 1 }
  } else { if p0 > n or needle_len > n {
    0 - 1
  } else {
    let src = __str_ptr(s)
    let mut p = p0
    let mut found = 0 - 1
    while found < 0 and p + needle_len <= n {
      if str_eq_at(src, p, n, needle) == 1 {
        found = p
      } else {
        p = p + 1
      }
    }
    found
  } }
}

fn str_find(s: str, needle: str) -> i64 {
  str_find_from(s, needle, 0)
}

fn str_contains(s: str, needle: str) -> i64 {
  if str_find(s, needle) < 0 { 0 } else { 1 }
}

fn str_is_ascii_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 9 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 } else { 0 } } } }
}

fn str_trim(s: str) -> str {
  let ptr = __str_ptr(s)
  let n = __str_len(s)
  let mut start = 0
  let mut end = n
  while start < end and str_is_ascii_ws(__mem_load8(ptr + start)) == 1 {
    start = start + 1
  }
  while end > start and str_is_ascii_ws(__mem_load8(ptr + end - 1)) == 1 {
    end = end - 1
  }
  str_slice_bytes(s, start, end - start)
}

fn str_split(s: str, sep: str) -> i64 {
  let parts = vector_new<str>()
  let n = __str_len(s)
  let sep_len = __str_len(sep)
  if sep_len == 0 {
    vector_push<str>(parts, s)
  } else {
    let mut start = 0
    let mut done = 0
    while done == 0 {
      let found = str_find_from(s, sep, start)
      if found < 0 {
        vector_push<str>(parts, str_slice_bytes(s, start, n - start))
        done = 1
      } else {
        vector_push<str>(parts, str_slice_bytes(s, start, found - start))
        start = found + sep_len
      }
    }
  }
  parts
}

fn str_join(parts: i64, sep: str) -> str {
  let count = vector_len(parts)
  if count <= 0 {
    ""
  } else {
    let mut out = vector_get<str>(parts, 0, "")
    for i in 1..count {
      out = str_concat(str_concat(out, sep), vector_get<str>(parts, i, ""))
    }
    out
  }
}

fn str_is_utf8(s: str) -> i64 { utf8_validate(s) }
fn str_codepoint_count(s: str) -> i64 { utf8_codepoint_count(s) }
fn str_is_utf8_boundary(s: str, pos: i64) -> i64 { utf8_is_boundary(s, pos) }

-- Write a string to a file descriptor
fn str_write(fd: i64, s: str) -[IO]> i64 {
  io_write(fd, __str_ptr(s), __str_len(s))
}

-- Print a string to stdout
fn print(s: str) -[IO]> i64 {
  str_write(1, s)
}

-- Print a string to stdout followed by newline
fn println(s: str) -[IO]> i64 {
  print(s)
  let nl = "\n"
  io_write(1, __str_ptr(nl), 1)
}
