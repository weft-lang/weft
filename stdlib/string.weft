-- stdlib/string.weft — String operations
--
-- Weft strings are immutable UTF-8 byte sequences. Storage layout and raw
-- descriptor access are isolated behind `runtime/string.weft`.
--
-- Layering note:
-- - `str` storage and compiler spans are byte-oriented UTF-8.
-- - `stdlib/string.weft` owns common string construction/comparison helpers.
-- - `stdlib/utf8.weft` should own scalar-aware UTF-8 validation, decoding,
--   encoding, codepoint counts, and boundary checks.
-- - Later `stdlib/unicode.weft` should own table-driven Unicode semantics such
--   as normalization, case folding, grapheme clusters, collation, and locale.

use stdlib/io.{*}
use stdlib/utf8.{*}
use stdlib/vector.{*}
use runtime/string.{*}

-- Concatenate two strings: "hello" ++ " world" → "hello world"
--- Concatenate two immutable UTF-8 strings.
pub fn str_concat(a: str, b: str) -> str {
  runtime_str_concat(a, b)
}

-- Convert i64 to decimal string
--- Render an `i64` in canonical base-ten notation.
pub fn int_to_str(n: i64) -> str {
  runtime_int_to_str(n)
}

-- String length
--- Return a string's UTF-8 storage length in bytes, not scalar count.
pub fn str_len(s: str) -> i64 { runtime_str_len(s) }

pub(package) fn str_word_len(s: i64) -> i64 { runtime_str_word_len(s) }

pub(package) fn str_word_byte_at(s: i64, index: i64) -> i64 {
  runtime_str_word_byte_at(s, index)
}

pub(package) fn str_byte_at(s: str, index: i64) -> i64 {
  runtime_str_byte_at(s, index)
}

-- String equality (byte comparison)
--- Return `1` when two strings have identical UTF-8 bytes, otherwise `0`.
pub fn str_eq(a: str, b: str) -> i64 {
  runtime_str_eq(a, b)
}

pub(package) fn str_from_bytes_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes_copy(ptr, len)
}

pub(package) fn str_slice_bytes(s: str, start: i64, len: i64) -> str {
  runtime_str_slice_bytes(s, start, len)
}

pub(package) fn str_eq_at(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  runtime_str_eq_at_bytes(src, pos, n, needle)
}

--- Find `needle` at or after byte offset `start`, returning `-1` if absent.
---
--- Negative starts clamp to zero. An empty needle matches any position from
--- zero through the byte length; starts beyond the end return `-1`.
pub fn str_find_from(s: str, needle: str, start: i64) -> i64 {
  let n = str_len(s)
  let needle_len = str_len(needle)
  let p0 = if start < 0 { 0 } else { start }
  if needle_len == 0 {
    if p0 <= n { p0 } else { 0 - 1 }
  } else { if p0 > n or needle_len > n {
    0 - 1
  } else {
    let src = runtime_str_ptr(s)
    let mut p = p0
    let mut found = 0 - 1
    while found < 0 and p + needle_len <= n {
      if str_eq_at(src, p, n, needle) == 1 {
        found = p
      } else {
        p = p + 1
      }
    }
    found
  } }
}

--- Return the first matching UTF-8 byte offset, or `-1` when absent.
pub fn str_find(s: str, needle: str) -> i64 {
  str_find_from(s, needle, 0)
}

--- Return `1` when `s` contains `needle`, otherwise `0`.
pub fn str_contains(s: str, needle: str) -> i64 {
  if str_find(s, needle) < 0 { 0 } else { 1 }
}

--- Return `1` when `s` begins with `prefix`, otherwise `0`.
pub fn str_starts_with(s: str, prefix: str) -> i64 {
  let n = str_len(s)
  let prefix_len = str_len(prefix)
  if prefix_len > n { 0 }
  else { str_eq_at(runtime_str_ptr(s), 0, n, prefix) }
}

--- Return `1` when `s` ends with `suffix`, otherwise `0`.
pub fn str_ends_with(s: str, suffix: str) -> i64 {
  let n = str_len(s)
  let suffix_len = str_len(suffix)
  if suffix_len > n { 0 }
  else { str_eq_at(runtime_str_ptr(s), n - suffix_len, n, suffix) }
}

-- Replace all non-overlapping byte-sequence matches. An empty needle is a
-- no-op; scalar-aware replacement belongs with the future Unicode layer.
--- Replace every non-overlapping occurrence, leaving an empty needle unchanged.
pub fn str_replace(s: str, needle: str, replacement: str) -> str {
  let n = str_len(s)
  let needle_len = str_len(needle)
  if needle_len == 0 { s }
  else {
    let replacement_len = str_len(replacement)
    let mut matches = 0
    let mut pos = 0
    while pos < n {
      if pos + needle_len <= n and str_eq_at(runtime_str_ptr(s), pos, n, needle) == 1 {
        matches = matches + 1
        pos = pos + needle_len
      } else {
        pos = pos + 1
      }
    }
    let out = runtime_str_alloc_uninit(n + matches * (replacement_len - needle_len))
    let out_len = str_len(out)
    let out_ptr = runtime_str_ptr(out)
    pos = 0
    let mut out_pos = 0
    while pos < n {
      if pos + needle_len <= n and str_eq_at(runtime_str_ptr(s), pos, n, needle) == 1 {
        runtime_str_builder_copy(out_ptr, out_len, out_pos, replacement, 0, replacement_len)
        pos = pos + needle_len
        out_pos = out_pos + replacement_len
      } else {
        runtime_str_builder_set_byte(out_ptr, out_len, out_pos, str_byte_at(s, pos))
        pos = pos + 1
        out_pos = out_pos + 1
      }
    }
    out
  }
}

-- ASCII-only case conversion for v1. Non-ASCII UTF-8 bytes are preserved
-- byte-for-byte; full Unicode case mapping belongs in stdlib/unicode.weft.
pub(package) fn str_to_upper(s: str) -> str {
  let n = str_len(s)
  let out = runtime_str_alloc_uninit(n)
  let out_ptr = runtime_str_ptr(out)
  for i in 0..n {
    let byte = str_byte_at(s, i)
    let mapped = if byte >= 97 and byte <= 122 { byte - 32 } else { byte }
    runtime_str_builder_set_byte(out_ptr, n, i, mapped)
  }
  out
}

pub(package) fn str_to_lower(s: str) -> str {
  let n = str_len(s)
  let out = runtime_str_alloc_uninit(n)
  let out_ptr = runtime_str_ptr(out)
  for i in 0..n {
    let byte = str_byte_at(s, i)
    let mapped = if byte >= 65 and byte <= 90 { byte + 32 } else { byte }
    runtime_str_builder_set_byte(out_ptr, n, i, mapped)
  }
  out
}

--- Repeat `s` `count` times; zero or negative counts return an empty string.
pub fn str_repeat(s: str, count: i64) -> str {
  let repeats = if count < 0 { 0 } else { count }
  let n = str_len(s)
  let out_len = n * repeats
  let out = runtime_str_alloc_uninit(out_len)
  let out_ptr = runtime_str_ptr(out)
  for i in 0..repeats {
    runtime_str_builder_copy(out_ptr, out_len, i * n, s, 0, n)
  }
  out
}

pub(package) fn str_builder_write_fill(out_ptr: i64, out_len: i64, start: i64, fill: str, count: i64) -> i64 {
  let fill_len = str_len(fill)
  if fill_len <= 0 { 0 }
  else {
    let mut remaining = count
    let mut pos = start
    while remaining > 0 {
      let take = if remaining < fill_len { remaining } else { fill_len }
      runtime_str_builder_copy(out_ptr, out_len, pos, fill, 0, take)
      pos = pos + take
      remaining = remaining - take
    }
    count
  }
}

-- Byte-width padding with a repeated fill string, truncated exactly at the
-- requested width. Empty fill or a satisfied width returns the input.
pub(package) fn str_pad_start(s: str, width: i64, fill: str) -> str {
  let n = str_len(s)
  if width <= n or str_len(fill) == 0 { s }
  else {
    let out = runtime_str_alloc_uninit(width)
    let out_ptr = runtime_str_ptr(out)
    str_builder_write_fill(out_ptr, width, 0, fill, width - n)
    runtime_str_builder_copy(out_ptr, width, width - n, s, 0, n)
    out
  }
}

pub(package) fn str_pad_end(s: str, width: i64, fill: str) -> str {
  let n = str_len(s)
  if width <= n or str_len(fill) == 0 { s }
  else {
    let out = runtime_str_alloc_uninit(width)
    let out_ptr = runtime_str_ptr(out)
    runtime_str_builder_copy(out_ptr, width, 0, s, 0, n)
    str_builder_write_fill(out_ptr, width, n, fill, width - n)
    out
  }
}

pub(package) fn str_is_ascii_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 9 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 } else { 0 } } } }
}

--- Remove ASCII space, tab, line-feed, and carriage-return at both ends.
---
--- This does not apply the Unicode White_Space property.
pub fn str_trim(s: str) -> str {
  let n = str_len(s)
  let mut start = 0
  let mut end = n
  while start < end and str_is_ascii_ws(str_byte_at(s, start)) == 1 {
    start = start + 1
  }
  while end > start and str_is_ascii_ws(str_byte_at(s, end - 1)) == 1 {
    end = end - 1
  }
  str_slice_bytes(s, start, end - start)
}

--- Split on non-overlapping separators while preserving empty fields.
---
--- An empty separator returns a one-element vector containing `s`.
pub fn str_split(s: str, sep: str) -> Vector<str> {
  let parts = vector_new<str>()
  let n = str_len(s)
  let sep_len = str_len(sep)
  if sep_len == 0 {
    vector_push<str>(parts, s)
  } else {
    let mut start = 0
    let mut done = 0
    while done == 0 {
      let found = str_find_from(s, sep, start)
      if found < 0 {
        vector_push<str>(parts, str_slice_bytes(s, start, n - start))
        done = 1
      } else {
        vector_push<str>(parts, str_slice_bytes(s, start, found - start))
        start = found + sep_len
      }
    }
  }
  parts
}

--- Join strings with `sep`, returning an empty string for an empty vector.
pub fn str_join(parts: Vector<str>, sep: str) -> str {
  let count = vector_len<str>(parts)
  if count <= 0 {
    ""
  } else {
    let mut out = vector_get<str>(parts, 0, "")
    for i in 1..count {
      out = str_concat(str_concat(out, sep), vector_get<str>(parts, i, ""))
    }
    out
  }
}

--- Return `1` when all bytes form valid UTF-8, otherwise `0`.
pub fn str_is_utf8(s: str) -> i64 { utf8_validate(s) }
--- Count Unicode scalars, returning `-1` when the bytes are malformed UTF-8.
pub fn str_codepoint_count(s: str) -> i64 { utf8_codepoint_count(s) }
--- Return `1` when `pos` is a valid in-range UTF-8 scalar boundary.
pub fn str_is_utf8_boundary(s: str, pos: i64) -> i64 { utf8_is_boundary(s, pos) }

-- Write a string to a file descriptor
pub(package) fn str_write(fd: i64, s: str) -[IO]> i64 {
  io_write(fd, runtime_str_ptr(s), runtime_str_len(s))
}

-- Print a string to stdout
pub(package) fn print(s: str) -[IO]> i64 {
  str_write(1, s)
}

-- Print a string to stdout followed by newline
pub(package) fn println(s: str) -[IO]> i64 {
  print(s)
  let nl = "\n"
  io_write(1, runtime_str_ptr(nl), 1)
}
