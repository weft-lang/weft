-- stdlib/string.weft — String operations
--
-- Weft strings are immutable UTF-8 byte sequences. Storage layout and raw
-- descriptor access are isolated behind `runtime/string.weft`.
--
-- Layering note:
-- - `str` storage and compiler spans are byte-oriented UTF-8.
-- - `stdlib/string.weft` owns common string construction/comparison helpers.
-- - `stdlib/utf8.weft` should own scalar-aware UTF-8 validation, decoding,
--   encoding, codepoint counts, and boundary checks.
-- - Later `stdlib/unicode.weft` should own table-driven Unicode semantics such
--   as normalization, case folding, grapheme clusters, collation, and locale.

use stdlib/io.{*}
use stdlib/num/scalar.{num_scalar_i64_to_usize, num_scalar_usize_checked_add, num_scalar_usize_checked_mul, num_scalar_usize_to_i64}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/string/builder as string_builder
use stdlib/utf8.{*}
use stdlib/vector as vector
use stdlib/vector.{*}
use runtime/string.{*}

-- Concatenate two strings: "hello" ++ " world" → "hello world"
--- Concatenate two immutable UTF-8 strings.
pub(package) fn str_concat(a: str, b: str) -> str {
  runtime_str_concat(a, b)
}

-- Convert i64 to decimal string
--- Render an `i64` in canonical base-ten notation.
pub(package) fn int_to_str(n: i64) -> str {
  runtime_int_to_str(n)
}

-- String length
--- Return a string's UTF-8 storage length in bytes, not scalar count.
pub(package) fn str_len(s: str) -> i64 { runtime_str_len(s) }

fn str_byte_len(s: str) -> usize {
  match num_scalar_i64_to_usize(str_len(s)) {
    Some(length) -> length
    None -> panic("String length invariant violated")
  }
}

fn str_storage_size(size: usize, message: str) -> i64 {
  match num_scalar_usize_to_i64(size) {
    Some(value) -> value
    None -> panic(message)
  }
}

pub(package) fn str_word_len(s: i64) -> i64 { runtime_str_word_len(s) }

pub(package) fn str_word_byte_at(s: i64, index: i64) -> i64 {
  runtime_str_word_byte_at(s, index)
}

pub(package) fn str_byte_at(s: str, index: i64) -> i64 {
  runtime_str_byte_at(s, index)
}

-- String equality (byte comparison)
pub(package) fn str_eq(a: str, b: str) -> i64 {
  runtime_str_eq(a, b)
}

pub(package) fn str_from_bytes_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes_copy(ptr, len)
}

pub(package) fn str_slice_bytes(s: str, start: i64, len: i64) -> str {
  runtime_str_slice_bytes(s, start, len)
}

pub(package) fn str_eq_at(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  runtime_str_eq_at_bytes(src, pos, n, needle)
}

--- Find `needle` at or after byte offset `start`, returning `-1` if absent.
---
--- Negative starts clamp to zero. An empty needle matches any position from
--- zero through the byte length; starts beyond the end return `-1`.
pub(package) fn str_find_from(s: str, needle: str, start: i64) -> i64 {
  let n = str_len(s)
  let needle_len = str_len(needle)
  let p0 = if start < 0 { 0 } else { start }
  if needle_len == 0 {
    if p0 <= n { p0 } else { 0 - 1 }
  } else { if p0 > n or needle_len > n {
    0 - 1
  } else {
    let src = runtime_str_ptr(s)
    let mut p = p0
    let mut found = 0 - 1
    while found < 0 and p + needle_len <= n {
      if str_eq_at(src, p, n, needle) == 1 {
        found = p
      } else {
        p = p + 1
      }
    }
    found
  } }
}

--- Return the first matching UTF-8 byte offset, or `-1` when absent.
pub(package) fn str_find(s: str, needle: str) -> i64 {
  str_find_from(s, needle, 0)
}

--- Return `1` when `s` contains `needle`, otherwise `0`.
pub(package) fn str_contains(s: str, needle: str) -> i64 {
  if str_find(s, needle) < 0 { 0 } else { 1 }
}

--- Return `1` when `s` begins with `prefix`, otherwise `0`.
pub(package) fn str_starts_with(s: str, prefix: str) -> i64 {
  let n = str_len(s)
  let prefix_len = str_len(prefix)
  if prefix_len > n { 0 }
  else { str_eq_at(runtime_str_ptr(s), 0, n, prefix) }
}

--- Return `1` when `s` ends with `suffix`, otherwise `0`.
pub(package) fn str_ends_with(s: str, suffix: str) -> i64 {
  let n = str_len(s)
  let suffix_len = str_len(suffix)
  if suffix_len > n { 0 }
  else { str_eq_at(runtime_str_ptr(s), n - suffix_len, n, suffix) }
}

-- Replace all non-overlapping byte-sequence matches. An empty needle is a
-- no-op; scalar-aware replacement belongs with the future Unicode layer.
--- Replace every non-overlapping occurrence, leaving an empty needle unchanged.
pub(package) fn str_replace(s: str, needle: str, replacement: str) -> str {
  let n = str_len(s)
  let needle_len = str_len(needle)
  if needle_len == 0 { s }
  else {
    let replacement_len = str_len(replacement)
    let mut matches = 0
    let mut pos = 0
    while pos < n {
      if pos + needle_len <= n and str_eq_at(runtime_str_ptr(s), pos, n, needle) == 1 {
        matches = matches + 1
        pos = pos + needle_len
      } else {
        pos = pos + 1
      }
    }
    let out = runtime_str_alloc_uninit(n + matches * (replacement_len - needle_len))
    let out_len = str_len(out)
    let out_ptr = runtime_str_ptr(out)
    pos = 0
    let mut out_pos = 0
    while pos < n {
      if pos + needle_len <= n and str_eq_at(runtime_str_ptr(s), pos, n, needle) == 1 {
        runtime_str_builder_copy(out_ptr, out_len, out_pos, replacement, 0, replacement_len)
        pos = pos + needle_len
        out_pos = out_pos + replacement_len
      } else {
        runtime_str_builder_set_byte(out_ptr, out_len, out_pos, str_byte_at(s, pos))
        pos = pos + 1
        out_pos = out_pos + 1
      }
    }
    out
  }
}

-- ASCII-only case conversion for v1. Non-ASCII UTF-8 bytes are preserved
-- byte-for-byte; full Unicode case mapping belongs in stdlib/unicode.weft.
pub(package) fn str_to_upper(s: str) -> str {
  let n = str_len(s)
  let out = runtime_str_alloc_uninit(n)
  let out_ptr = runtime_str_ptr(out)
  for i in 0..n {
    let byte = str_byte_at(s, i)
    let mapped = if byte >= 97 and byte <= 122 { byte - 32 } else { byte }
    runtime_str_builder_set_byte(out_ptr, n, i, mapped)
  }
  out
}

pub(package) fn str_to_lower(s: str) -> str {
  let n = str_len(s)
  let out = runtime_str_alloc_uninit(n)
  let out_ptr = runtime_str_ptr(out)
  for i in 0..n {
    let byte = str_byte_at(s, i)
    let mapped = if byte >= 65 and byte <= 90 { byte + 32 } else { byte }
    runtime_str_builder_set_byte(out_ptr, n, i, mapped)
  }
  out
}

--- Repeat `s` `count` times.
pub(package) fn str_repeat(s: str, count: usize) -> str {
  let byte_length = str_byte_len(s)
  if byte_length == 0 { "" }
  else {
    match count {
      0 -> ""
      1 -> s
      _ -> {
        let output_size = match num_scalar_usize_checked_mul(byte_length, count) {
          Some(size) -> size
          None -> panic("Repeated string is too large")
        }
        let out_len = str_storage_size(output_size, "Repeated string is too large")
        let repeats = str_storage_size(count, "Repeated string is too large")
        let n = str_len(s)
        let out = runtime_str_alloc_uninit(out_len)
        let out_ptr = runtime_str_ptr(out)
        for i in 0..repeats {
          runtime_str_builder_copy(out_ptr, out_len, i * n, s, 0, n)
        }
        out
      }
    }
  }
}

pub(package) fn str_builder_write_fill(out_ptr: i64, out_len: i64, start: i64, fill: str, count: i64) -> i64 {
  let fill_len = str_len(fill)
  if fill_len <= 0 { 0 }
  else {
    let mut remaining = count
    let mut pos = start
    while remaining > 0 {
      let take = if remaining < fill_len { remaining } else { fill_len }
      runtime_str_builder_copy(out_ptr, out_len, pos, fill, 0, take)
      pos = pos + take
      remaining = remaining - take
    }
    count
  }
}

-- Byte-width padding with a repeated fill string, truncated exactly at the
-- requested width. Empty fill or a satisfied width returns the input.
pub(package) fn str_pad_start(s: str, width: usize, fill: str) -> str {
  let byte_length = str_byte_len(s)
  if width <= byte_length or str_len(fill) == 0 { s }
  else {
    let storage_width = str_storage_size(width, "Padded string is too large")
    let n = str_len(s)
    let out = runtime_str_alloc_uninit(storage_width)
    let out_ptr = runtime_str_ptr(out)
    str_builder_write_fill(out_ptr, storage_width, 0, fill, storage_width - n)
    runtime_str_builder_copy(out_ptr, storage_width, storage_width - n, s, 0, n)
    out
  }
}

pub(package) fn str_pad_end(s: str, width: usize, fill: str) -> str {
  let byte_length = str_byte_len(s)
  if width <= byte_length or str_len(fill) == 0 { s }
  else {
    let storage_width = str_storage_size(width, "Padded string is too large")
    let n = str_len(s)
    let out = runtime_str_alloc_uninit(storage_width)
    let out_ptr = runtime_str_ptr(out)
    runtime_str_builder_copy(out_ptr, storage_width, 0, s, 0, n)
    str_builder_write_fill(out_ptr, storage_width, n, fill, storage_width - n)
    out
  }
}

pub(package) fn str_is_ascii_ws(ch: i64) -> i64 {
  if ch == 32 { 1 }
  else { if ch == 9 { 1 }
  else { if ch == 10 { 1 }
  else { if ch == 13 { 1 } else { 0 } } } }
}

--- Remove ASCII space, tab, line-feed, and carriage-return at both ends.
---
--- This does not apply the Unicode White_Space property.
pub(package) fn str_trim(s: str) -> str {
  let n = str_len(s)
  let mut start = 0
  let mut end = n
  while start < end and str_is_ascii_ws(str_byte_at(s, start)) == 1 {
    start = start + 1
  }
  while end > start and str_is_ascii_ws(str_byte_at(s, end - 1)) == 1 {
    end = end - 1
  }
  str_slice_bytes(s, start, end - start)
}

--- Split on non-overlapping separators while preserving empty fields.
---
--- An empty separator returns a one-element vector containing `s`.
pub(package) fn str_split(s: str, sep: str) -> owned Vector<str> {
  let mut parts = vector.new<str>()
  let n = str_len(s)
  let sep_len = str_len(sep)
  if sep_len == 0 {
    parts.push(s)
  } else {
    let mut start = 0
    let mut done = 0
    while done == 0 {
      let found = str_find_from(s, sep, start)
      if found < 0 {
        parts.push(str_slice_bytes(s, start, n - start))
        done = 1
      } else {
        parts.push(str_slice_bytes(s, start, found - start))
        start = found + sep_len
      }
    }
  }
  parts
}

-- Compute the exact immutable result capacity before allocating the builder.
fn str_join_capacity(parts: borrow Vector<str>, sep: str) -> usize {
  let mut total: usize = 0
  let separator_length = match num_scalar_i64_to_usize(str_len(sep)) {
    Some(length) -> length
    None -> panic("String length invariant violated")
  }
  let count = vector_len<str>(parts)
  for index in 0..count {
    if index > 0 {
      total = match num_scalar_usize_checked_add(total, separator_length) {
        Some(length) -> length
        None -> panic("Joined string is too large")
      }
    } else { nil }
    let value = vector_get_in_bounds<str>(parts, index)
    let value_length = match num_scalar_i64_to_usize(str_len(value)) {
      Some(length) -> length
      None -> panic("String length invariant violated")
    }
    total = match num_scalar_usize_checked_add(total, value_length) {
      Some(length) -> length
      None -> panic("Joined string is too large")
    }
  }
  total
}

--- Join a borrowed vector of strings with `separator`, returning empty for an
--- empty vector.
pub fn join(parts: borrow Vector<str>, separator: str) -> str {
  let count = vector_len<str>(parts)
  if count == 0 {
    ""
  } else {
    let mut out = string_builder.with_capacity(str_join_capacity(parts, separator))
    for index in 0..count {
      if index > 0 { out.append(separator) } else { nil }
      out.append(vector_get_in_bounds<str>(parts, index))
    }
    out.finish()
  }
}

impl str {
  --- Concatenate two immutable UTF-8 strings.
  pub fn concat(self, other: str) -> str { str_concat(self, other) }

  --- Return the UTF-8 storage length in bytes, not scalar count.
  pub fn len(self) -> usize { str_byte_len(self) }

  --- Return whether the string contains no bytes.
  pub fn is_empty(self) -> bool { self.len() == 0 }

  --- Find `needle` at or after byte offset `start`.
  --- Starts beyond the byte length return `None`.
  pub fn find_from(self, needle: str, start: usize) -> Option<usize> {
    match num_scalar_usize_to_i64(start) {
      None -> None<usize>()
      Some(storage_start) -> match num_scalar_i64_to_usize(str_find_from(self, needle, storage_start)) {
        None -> None<usize>()
        Some(found) -> Some<usize>(found)
      }
    }
  }

  --- Return the first matching UTF-8 byte offset.
  pub fn find(self, needle: str) -> Option<usize> {
    self.find_from(needle, 0)
  }

  --- Return whether the string contains `needle`.
  pub fn contains(self, needle: str) -> bool { str_contains(self, needle) == 1 }

  --- Return whether the string begins with `prefix`.
  pub fn starts_with(self, prefix: str) -> bool { str_starts_with(self, prefix) == 1 }

  --- Return whether the string ends with `suffix`.
  pub fn ends_with(self, suffix: str) -> bool { str_ends_with(self, suffix) == 1 }

  --- Replace every non-overlapping occurrence, leaving an empty needle unchanged.
  pub fn replace(self, needle: str, replacement: str) -> str {
    str_replace(self, needle, replacement)
  }

  --- Repeat the string `count` times.
  pub fn repeat(self, count: usize) -> str { str_repeat(self, count) }

  --- Remove ASCII space, tab, line-feed, and carriage-return at both ends.
  pub fn trim(self) -> str { str_trim(self) }

  --- Split on non-overlapping separators while preserving empty fields.
  pub fn split(self, separator: str) -> owned Vector<str> { str_split(self, separator) }

  --- Convert ASCII letters to uppercase while preserving other bytes.
  pub fn to_ascii_upper(self) -> str { str_to_upper(self) }

  --- Convert ASCII letters to lowercase while preserving other bytes.
  pub fn to_ascii_lower(self) -> str { str_to_lower(self) }

  --- Pad the beginning to `width` bytes with a repeated fill string.
  pub fn pad_start(self, width: usize, fill: str) -> str { str_pad_start(self, width, fill) }

  --- Pad the end to `width` bytes with a repeated fill string.
  pub fn pad_end(self, width: usize, fill: str) -> str { str_pad_end(self, width, fill) }

  --- Count Unicode scalar values.
  pub fn scalar_count(self) -> usize {
    match num_scalar_i64_to_usize(utf8_count_scalars(self)) {
      Some(count) -> count
      None -> panic("String UTF-8 invariant violated")
    }
  }

  --- Return whether `pos` is a valid in-range UTF-8 scalar boundary.
  pub fn is_scalar_boundary(self, pos: usize) -> bool {
    match num_scalar_usize_to_i64(pos) {
      None -> false
      Some(storage_pos) -> utf8_scalar_boundary(self, storage_pos)
    }
  }
}

-- Write a string to a file descriptor
pub(package) fn str_write(fd: i64, s: str) -[IO]> i64 {
  io_write(fd, runtime_str_ptr(s), runtime_str_len(s))
}

-- Print a string to stdout
pub(package) fn print(s: str) -[IO]> i64 {
  str_write(1, s)
}

-- Print a string to stdout followed by newline
pub(package) fn println(s: str) -[IO]> i64 {
  print(s)
  let nl = "\n"
  io_write(1, runtime_str_ptr(nl), 1)
}
