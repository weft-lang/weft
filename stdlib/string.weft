-- stdlib/string.weft — String operations
--
-- Weft strings are descriptors: [data_ptr(8), length(8)]
-- __str_ptr(s) returns data_ptr, __str_len(s) returns length.
-- String data is immutable UTF-8 bytes in the heap.

use "stdlib/io.weft"

-- Concatenate two strings: "hello" ++ " world" → "hello world"
fn str_concat(a: i64, b: i64) -> i64 {
  let a_ptr = __str_ptr(a)
  let a_len = __str_len(a)
  let b_ptr = __str_ptr(b)
  let b_len = __str_len(b)
  let total = a_len + b_len
  -- Allocate data buffer (aligned to 8)
  let aligned = (total + 7) / 8 * 8
  let data = __bump_alloc(aligned)
  -- Copy a's bytes
  for i in 0..a_len {
    __mem_store8(data + i, __mem_load8(a_ptr + i))
  }
  -- Copy b's bytes
  for i in 0..b_len {
    __mem_store8(data + a_len + i, __mem_load8(b_ptr + i))
  }
  -- Allocate descriptor [data_ptr, length]
  let desc = __bump_alloc(16)
  __mem_store64(desc, data)
  __mem_store64(desc + 8, total)
  desc
}

-- Convert i64 to decimal string
fn int_to_str(n: i64) -> i64 {
  if n == 0 {
    "0"
  } else {
    -- Handle negative
    let is_neg = if n < 0 { 1 } else { 0 }
    let mut val = if n < 0 { 0 - n } else { n }
    -- Extract digits into a temporary buffer (max 20 digits for i64)
    let buf = __bump_alloc(24)
    let mut pos = 0
    while val > 0 {
      let digit = val - val / 10 * 10
      __mem_store8(buf + pos, digit + 48)
      val = val / 10
      pos = pos + 1
    }
    if is_neg == 1 {
      __mem_store8(buf + pos, 45)
      pos = pos + 1
    } else { 0 }
    -- Reverse into final string
    let total = pos
    let aligned = (total + 7) / 8 * 8
    let data = __bump_alloc(aligned)
    for i in 0..total {
      __mem_store8(data + i, __mem_load8(buf + total - 1 - i))
    }
    -- Allocate descriptor
    let desc = __bump_alloc(16)
    __mem_store64(desc, data)
    __mem_store64(desc + 8, total)
    desc
  }
}

-- String length
fn str_len(s: i64) -> i64 { __str_len(s) }

-- String equality (byte comparison)
fn str_eq(a: i64, b: i64) -> i64 {
  let a_len = __str_len(a)
  let b_len = __str_len(b)
  if a_len != b_len { false }
  else {
    let a_ptr = __str_ptr(a)
    let b_ptr = __str_ptr(b)
    let mut eq = true
    let mut i = 0
    while i < a_len {
      if __mem_load8(a_ptr + i) != __mem_load8(b_ptr + i) {
        eq = false
        i = a_len
      } else { i = i + 1 }
    }
    eq
  }
}

-- Write a string to a file descriptor
fn str_write(fd: i64, s: i64) -> i64 {
  io_write(fd, __str_ptr(s), __str_len(s))
}

-- Print a string to stdout
fn print(s: i64) -> i64 {
  str_write(1, s)
}

-- Print a string to stdout followed by newline
fn println(s: i64) -> i64 {
  print(s)
  let nl = "\n"
  io_write(1, __str_ptr(nl), 1)
}
