-- stdlib/map.weft — Persistent hash map using CHAMP trie
--
-- CHAMP = Compressed Hash-Array Mapped Prefix-tree
-- State of the art for persistent/immutable hash maps.
-- Used by Clojure, Scala, Rust's `im` crate.
--
-- Each node has:
--   [data_map(8), node_map(8), content_ptr(8), content_len(8)] = 32 bytes
--
-- data_map: 32-bit bitmap — which hash slots have inline key-value pairs
-- node_map: 32-bit bitmap — which hash slots have sub-nodes
-- content: array of entries — data pairs (key, val) first, then sub-node pointers
--
-- At each trie level, 5 bits of the hash select a slot (32-wide branching).
-- Structural sharing: insert/remove create new path, share unchanged subtrees.

use "stdlib/hash.weft"
use "stdlib/eq.weft"
use "stdlib/list.weft"
use "runtime/map_storage.weft"

-- ══════════════════════════════════════════════════════════════
-- Node layout
-- ══════════════════════════════════════════════════════════════

fn champ_node_new(region: i64, data_map: i64, node_map: i64, content: i64, content_len: i64) -> i64 {
  map_storage_node_new(region, data_map, node_map, content, content_len)
}

fn champ_data_map(node: i64) -> i64 { map_storage_data_map(node) }
fn champ_node_map(node: i64) -> i64 { map_storage_node_map(node) }
fn champ_content(node: i64) -> i64 { map_storage_content(node) }
fn champ_content_len(node: i64) -> i64 { map_storage_content_len(node) }

fn champ_empty_node(region: i64) -> i64 {
  map_storage_empty_node(region)
}

-- Number of data entries (key-value pairs) in this node
fn champ_data_count(node: i64) -> i64 {
  popcount(champ_data_map(node))
}

-- Number of sub-node entries in this node
fn champ_node_count(node: i64) -> i64 {
  popcount(champ_node_map(node))
}

-- Get data key at index i (data entries are stored as [key, val] pairs)
fn champ_data_key(node: i64, idx: i64) -> i64 {
  map_storage_data_key(node, idx)
}

-- Get data value at index i
fn champ_data_val(node: i64, idx: i64) -> i64 {
  map_storage_data_val(node, idx)
}

-- Get sub-node at index i (sub-nodes stored after all data entries)
fn champ_sub_node(node: i64, idx: i64) -> i64 {
  let data_count = champ_data_count(node)
  map_storage_sub_node(node, data_count, idx)
}

-- ══════════════════════════════════════════════════════════════
-- Lookup
-- ══════════════════════════════════════════════════════════════

-- Extract 5 bits of hash at the given depth (0 = bits 0-4, 1 = bits 5-9, etc.)
fn hash_fragment(hash: i64, depth: i64) -> i64 {
  (hash bshr (depth * 5)) band 31
}

-- Convert a hash fragment to a bit position in the bitmap
fn frag_to_bit(frag: i64) -> i64 {
  1 bshl frag
}

-- Look up a key in a CHAMP node. Returns the value, or 0 if not found.
-- sentinel = value to return if key is absent (caller provides)
fn champ_get(node: i64, key: i64, key_hash: i64, depth: i64, sentinel: i64) -> i64 {
  let frag = hash_fragment(key_hash, depth)
  let bit = frag_to_bit(frag)
  let dm = champ_data_map(node)
  let nm = champ_node_map(node)
  if (dm band bit) != 0 {
    -- Data entry at this position: compare keys
    let idx = compressed_index(dm, bit)
    let stored_key = champ_data_key(node, idx)
    if stored_key == key {
      champ_data_val(node, idx)
    } else { sentinel }
  } else {
    if (nm band bit) != 0 {
      -- Sub-node at this position: recurse
      let idx = compressed_index(nm, bit)
      let sub = champ_sub_node(node, idx)
      champ_get(sub, key, key_hash, depth + 1, sentinel)
    } else {
      -- Empty slot: key not found
      sentinel
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Insert (persistent — returns new node, shares structure)
-- ══════════════════════════════════════════════════════════════

-- Insert or update a key-value pair. Returns a new node (persistent).
fn champ_put(region: i64, node: i64, key: i64, val: i64, key_hash: i64, depth: i64) -> i64 {
  let frag = hash_fragment(key_hash, depth)
  let bit = frag_to_bit(frag)
  let dm = champ_data_map(node)
  let nm = champ_node_map(node)
  if (dm band bit) != 0 {
    -- Data entry exists at this position
    let idx = compressed_index(dm, bit)
    let stored_key = champ_data_key(node, idx)
    if stored_key == key {
      -- Same key: update value (create new node with updated content)
      let dc = champ_data_count(node)
      let nc = champ_node_count(node)
      let total_size = dc * 16 + nc * 8
      let new_content = map_storage_copy_content_update_val(region, champ_content(node), total_size, idx, val)
      champ_node_new(region, dm, nm, new_content, champ_content_len(node))
    } else {
      -- Different key at same position: push both down to sub-node
      let stored_val = champ_data_val(node, idx)
      let stored_hash = stored_key.hash()
      -- Create sub-node containing both entries
      let sub = champ_put(region, champ_put(region, champ_empty_node(region), stored_key, stored_val, stored_hash, depth + 1), key, val, key_hash, depth + 1)
      -- Remove data entry, add sub-node
      champ_migrate_to_node(region, node, dm, nm, bit, idx, sub)
    }
  } else {
    if (nm band bit) != 0 {
      -- Sub-node exists: recurse into it
      let idx = compressed_index(nm, bit)
      let sub = champ_sub_node(node, idx)
      let new_sub = champ_put(region, sub, key, val, key_hash, depth + 1)
      -- Replace sub-node pointer
      champ_replace_sub_node(region, node, dm, nm, idx, new_sub)
    } else {
      -- Empty slot: insert data entry
      let idx = compressed_index(dm, bit)
      champ_insert_data(region, node, dm bor bit, nm, idx, key, val)
    }
  }
}

-- Insert a new data entry at position idx in the content array
fn champ_insert_data(region: i64, node: i64, new_dm: i64, nm: i64, idx: i64, key: i64, val: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let new_total = (dc + 1) * 16 + nc * 8
  let new_content = map_storage_insert_data_content(region, old_content, dc, nc, idx, key, val)
  champ_node_new(region, new_dm, nm, new_content, new_total)
}

-- Migrate a data entry to a sub-node (collision handling)
fn champ_migrate_to_node(region: i64, node: i64, dm: i64, nm: i64, bit: i64, data_idx: i64, sub: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let new_dm = dm bxor bit
  let new_nm = nm bor bit
  let node_idx = compressed_index(new_nm, bit)
  let new_dc = dc - 1
  let new_nc = nc + 1
  let new_total = new_dc * 16 + new_nc * 8
  let new_content = map_storage_migrate_with_nodes_content(region, old_content, dc, new_nc, data_idx, node_idx, sub)
  champ_node_new(region, new_dm, new_nm, new_content, new_total)
}

-- Replace a sub-node pointer at index
fn champ_replace_sub_node(region: i64, node: i64, dm: i64, nm: i64, idx: i64, new_sub: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let total = dc * 16 + nc * 8
  let new_content = map_storage_replace_sub_content(region, old_content, total, dc, idx, new_sub)
  champ_node_new(region, dm, nm, new_content, total)
}

-- ══════════════════════════════════════════════════════════════
-- Map API — user-facing wrapper
-- ══════════════════════════════════════════════════════════════

-- Create an empty map
fn map_new() -> rc i64 {
  let region: rc i64 = map_storage_persistent_region_new()
  let raw_region: i64 = region
  map_storage_persistent_box(champ_empty_node(raw_region), raw_region)
}

-- Get a value by key. Returns sentinel if not found.
fn map_get(m: i64, key: i64, sentinel: i64) -> i64 {
  let root = map_storage_persistent_root(m)
  if root == 0 { sentinel }
  else {
    let h = key.hash()
    champ_get(root, key, h, 0, sentinel)
  }
}

-- Insert or update a key-value pair. Returns a new map (persistent).
fn map_put(m: i64, key: i64, val: i64) -> rc i64 {
  let root = map_storage_persistent_root(m)
  let region = map_storage_persistent_region(m)
  let h = key.hash()
  map_storage_persistent_box(champ_put(region, root, key, val, h, 0), region)
}

-- Check if a key exists
fn map_contains(m: i64, key: i64) -> i64 {
  let sentinel = 0 - 9999999
  let result = map_get(m, key, sentinel)
  if result == sentinel { 0 } else { 1 }
}

-- Fold over all key-value pairs in the map.
-- Visits every entry by walking the CHAMP trie recursively.
-- f(acc, key, val) → new_acc
fn map_fold<A>(m: i64, init: A, f: (A, i64, i64) -> A) -> A {
  let root = map_storage_persistent_root(m)
  if root == 0 { init } else { champ_fold<A>(root, init, f) }
}

-- Walk a CHAMP node, applying f to each data entry, then recursing into sub-nodes.
fn champ_fold<A>(node: i64, acc: A, f: (A, i64, i64) -> A) -> A {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let content = champ_content(node)
  -- Fold over data entries
  let mut a = acc
  for i in 0..dc {
    let key = map_storage_content_data_key(content, i)
    let val = map_storage_content_data_val(content, i)
    a = f(a, key, val)
  }
  -- Recurse into sub-nodes
  for i in 0..nc {
    let sub = map_storage_content_sub_node(content, dc, i)
    a = champ_fold<A>(sub, a, f)
  }
  a
}

-- Get all keys as a List
fn map_cons_key_i64(acc: List<i64>, key: i64, val: i64) -> List<i64> {
  list_cons<i64>(key, acc)
}

fn map_cons_value_i64(acc: List<i64>, key: i64, val: i64) -> List<i64> {
  list_cons<i64>(val, acc)
}

fn map_keys(m: i64) -> List<i64> {
  map_fold<List<i64>>(m, list_nil<i64>(), map_cons_key_i64)
}

-- Get all values as a List
fn map_values(m: i64) -> List<i64> {
  map_fold<List<i64>>(m, list_nil<i64>(), map_cons_value_i64)
}

-- Count entries in the map
fn map_size(m: i64) -> i64 {
  map_fold<i64>(m, 0, (acc: i64, key: i64, val: i64) => acc + 1)
}

-- ══════════════════════════════════════════════════════════════
-- Managed persistent root wrapper
-- ══════════════════════════════════════════════════════════════

-- The internal CHAMP node API above uses bare pointers inside one immutable
-- version family. Public maps box each root with a family-region owner:
-- Par promotion marks the version plus that one owner in O(1), unchanged
-- subtries remain shared, and the last version unmaps every historical path
-- copy.
fn persistent_map_new() -> rc i64 {
  map_new()
}

fn persistent_map_root(m: i64) -> i64 {
  map_storage_persistent_root(m)
}

fn persistent_map_get(m: i64, key: i64, sentinel: i64) -> i64 {
  map_get(m, key, sentinel)
}

fn persistent_map_contains(m: i64, key: i64) -> i64 {
  map_contains(m, key)
}

fn persistent_map_put(m: i64, key: i64, val: i64) -> rc i64 {
  map_put(m, key, val)
}

fn persistent_map_fold<A>(m: i64, init: A, f: (A, i64, i64) -> A) -> A {
  map_fold<A>(m, init, f)
}

fn persistent_map_keys(m: i64) -> List<i64> {
  persistent_map_fold<List<i64>>(m, list_nil<i64>(), map_cons_key_i64)
}

fn persistent_map_values(m: i64) -> List<i64> {
  persistent_map_fold<List<i64>>(m, list_nil<i64>(), map_cons_value_i64)
}

fn persistent_map_size(m: i64) -> i64 {
  persistent_map_fold<i64>(m, 0, (acc: i64, key: i64, val: i64) => acc + 1)
}
