-- stdlib/map.weft — Persistent hash map using CHAMP trie
--
-- CHAMP = Compressed Hash-Array Mapped Prefix-tree
-- State of the art for persistent/immutable hash maps.
-- Used by Clojure, Scala, Rust's `im` crate.
--
-- Each node has:
--   [data_map(8), node_map(8), content_ptr(8), content_len(8)] = 32 bytes
--
-- data_map: 32-bit bitmap — which hash slots have inline key-value pairs
-- node_map: 32-bit bitmap — which hash slots have sub-nodes
-- content: array of entries — data pairs (key, val) first, then sub-node pointers
--
-- At each trie level, 5 bits of the hash select a slot (32-wide branching).
-- Structural sharing: insert/remove create new path, share unchanged subtrees.

use stdlib/hash.{*}
use stdlib/eq.{*}
use stdlib/list.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/iter/core.{from_generator, iter_next}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}
use stdlib/option.{*}
use runtime/map_storage.{*}

-- Sealed nominal handle over the trusted persistent CHAMP root. Keys and
-- values occupy one machine word in the trie; the storage bridge carries each
-- concrete type's cleanup kind so managed words own balanced family stakes.
--- An opaque persistent hash map from `K` to `V`.
pub type Map<K, V> { }
--- An opaque persistent hash set of `T`, operated on by `stdlib/set`.
pub type Set<T> { }
pub(package) type MapStorageRegion { }

-- ══════════════════════════════════════════════════════════════
-- Node layout
-- ══════════════════════════════════════════════════════════════

pub(package) fn champ_node_new(region: i64, data_map: i64, node_map: i64, content: i64, content_len: i64) -> i64 {
  map_storage_node_new(region, data_map, node_map, content, content_len)
}

pub(package) fn champ_data_map(node: i64) -> i64 { map_storage_data_map(node) }
pub(package) fn champ_node_map(node: i64) -> i64 { map_storage_node_map(node) }
pub(package) fn champ_content(node: i64) -> i64 { map_storage_content(node) }
pub(package) fn champ_content_len(node: i64) -> i64 { map_storage_content_len(node) }

pub(package) fn champ_empty_node(region: i64) -> i64 {
  map_storage_empty_node(region)
}

-- Full-hash collisions terminate in a linear bucket. `-1` is outside the
-- ordinary 32-bit data bitmap domain; node_map carries the bucket length.
pub(package) fn champ_collision_marker() -> i64 { 0 - 1 }

pub(package) fn champ_is_collision(node: i64) -> i64 {
  if champ_data_map(node) == champ_collision_marker() { 1 } else { 0 }
}

-- Number of data entries (key-value pairs) in this node
pub(package) fn champ_data_count(node: i64) -> i64 {
  if champ_is_collision(node) == 1 { 1 }
  else { popcount(champ_data_map(node)) }
}

-- Number of sub-node entries in this node
pub(package) fn champ_node_count(node: i64) -> i64 {
  if champ_is_collision(node) == 1 { champ_node_map(node) }
  else { popcount(champ_node_map(node)) }
}

-- Get data key at index i (data entries are stored as [key, val] pairs)
pub(package) fn champ_data_key<K>(node: i64, idx: i64) -> K {
  map_storage_data_key<K>(node, idx)
}

-- Get data value at index i
pub(package) fn champ_data_val<V>(node: i64, idx: i64) -> V {
  map_storage_data_val<V>(node, idx)
}

-- Get sub-node at index i (sub-nodes stored after all data entries)
pub(package) fn champ_sub_node(node: i64, idx: i64) -> i64 {
  let data_count = champ_data_count(node)
  map_storage_sub_node(node, data_count, idx)
}

-- ══════════════════════════════════════════════════════════════
-- Lookup
-- ══════════════════════════════════════════════════════════════

-- Extract 5 bits of hash at the given depth (0 = bits 0-4, 1 = bits 5-9, etc.)
pub(package) fn hash_fragment(hash: i64, depth: i64) -> i64 {
  (hash bshr (depth * 5)) band 31
}

-- Convert a hash fragment to a bit position in the bitmap
pub(package) fn frag_to_bit(frag: i64) -> i64 {
  1 bshl frag
}

-- Look up a key in a CHAMP node without fabricating a generic sentinel.
pub(package) fn champ_get<K: Hash & Eq, V>(node: i64, key: K, key_hash: i64, depth: i64) -> Option<V> {
  if champ_is_collision(node) == 1 {
    let stored_key = champ_data_key<K>(node, 0)
    if stored_key.eq(key) { Some<V>(champ_data_val<V>(node, 0)) }
    else {
      if champ_node_count(node) == 0 { None<V>() }
      else { champ_get<K, V>(champ_sub_node(node, 0), key, key_hash, depth) }
    }
  } else {
    let frag = hash_fragment(key_hash, depth)
    let bit = frag_to_bit(frag)
    let dm = champ_data_map(node)
    let nm = champ_node_map(node)
    if (dm band bit) != 0 {
      -- Data entry at this position: compare keys
      let idx = compressed_index(dm, bit)
      let stored_key = champ_data_key<K>(node, idx)
      if stored_key.eq(key) {
        Some<V>(champ_data_val<V>(node, idx))
      } else { None<V>() }
    } else {
      if (nm band bit) != 0 {
        -- Sub-node at this position: recurse
        let idx = compressed_index(nm, bit)
        let sub = champ_sub_node(node, idx)
        champ_get<K, V>(sub, key, key_hash, depth + 1)
      } else {
        -- Empty slot: key not found
        None<V>()
      }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Insert (persistent — returns new node, shares structure)
-- ══════════════════════════════════════════════════════════════

pub(package) fn champ_collision_node<K, V>(region: i64, key: K, val: V, next: i64) -> i64 {
  let node_count = if next == 0 { 0 } else { 1 }
  let content = map_storage_collision_content<K, V>(region, key, val, next)
  champ_node_new(region, champ_collision_marker(), node_count, content, 16 + node_count * 8)
}

pub(package) fn champ_collision_two<K, V>(region: i64, first_key: K, first_val: V, second_key: K, second_val: V) -> i64 {
  let tail = champ_collision_node<K, V>(region, second_key, second_val, 0)
  champ_collision_node<K, V>(region, first_key, first_val, tail)
}

-- Insert or update a key-value pair. Returns a new node (persistent).
pub(package) fn champ_put<K: Hash & Eq, V>(region: i64, node: i64, key: K, val: V, key_hash: i64, depth: i64) -> i64 {
  if champ_is_collision(node) == 1 {
    let stored_key = champ_data_key<K>(node, 0)
    let node_count = champ_node_count(node)
    if stored_key.eq(key) {
      let content = map_storage_copy_content_update_val<K, V>(region, champ_content(node), 1, node_count, 0, val)
      champ_node_new(region, champ_collision_marker(), node_count, content, 16 + node_count * 8)
    } else {
      let stored_val = champ_data_val<V>(node, 0)
      let next = if node_count == 0 {
        champ_collision_node<K, V>(region, key, val, 0)
      } else {
        champ_put<K, V>(region, champ_sub_node(node, 0), key, val, key_hash, depth)
      }
      champ_collision_node<K, V>(region, stored_key, stored_val, next)
    }
  } else {
    let frag = hash_fragment(key_hash, depth)
    let bit = frag_to_bit(frag)
    let dm = champ_data_map(node)
    let nm = champ_node_map(node)
    if (dm band bit) != 0 {
      -- Data entry exists at this position
      let idx = compressed_index(dm, bit)
      let stored_key = champ_data_key<K>(node, idx)
      if stored_key.eq(key) {
        -- Same key: update value (create new node with updated content)
        let dc = champ_data_count(node)
        let nc = champ_node_count(node)
        let new_content = map_storage_copy_content_update_val<K, V>(region, champ_content(node), dc, nc, idx, val)
        champ_node_new(region, dm, nm, new_content, champ_content_len(node))
      } else {
        -- Different key at the same fragment. Equal full hashes terminate in
        -- a collision bucket; unequal hashes continue down the trie.
        let stored_val = champ_data_val<V>(node, idx)
        let stored_hash = stored_key.hash()
        let sub = if stored_hash == key_hash {
          champ_collision_two<K, V>(region, stored_key, stored_val, key, val)
        } else {
          champ_put<K, V>(region, champ_put<K, V>(region, champ_empty_node(region), stored_key, stored_val, stored_hash, depth + 1), key, val, key_hash, depth + 1)
        }
        champ_migrate_to_node<K, V>(region, node, dm, nm, bit, idx, sub)
      }
    } else {
      if (nm band bit) != 0 {
        -- Sub-node exists: recurse into it
        let idx = compressed_index(nm, bit)
        let sub = champ_sub_node(node, idx)
        let new_sub = champ_put<K, V>(region, sub, key, val, key_hash, depth + 1)
        -- Replace sub-node pointer
        champ_replace_sub_node<K, V>(region, node, dm, nm, idx, new_sub)
      } else {
        -- Empty slot: insert data entry
        let idx = compressed_index(dm, bit)
        champ_insert_data<K, V>(region, node, dm bor bit, nm, idx, key, val)
      }
    }
  }
}

-- Insert a new data entry at position idx in the content array
pub(package) fn champ_insert_data<K, V>(region: i64, node: i64, new_dm: i64, nm: i64, idx: i64, key: K, val: V) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let new_total = (dc + 1) * 16 + nc * 8
  let new_content = map_storage_insert_data_content<K, V>(region, old_content, dc, nc, idx, key, val)
  champ_node_new(region, new_dm, nm, new_content, new_total)
}

-- Migrate a data entry to a sub-node (collision handling)
pub(package) fn champ_migrate_to_node<K, V>(region: i64, node: i64, dm: i64, nm: i64, bit: i64, data_idx: i64, sub: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let new_dm = dm bxor bit
  let new_nm = nm bor bit
  let node_idx = compressed_index(new_nm, bit)
  let new_dc = dc - 1
  let new_nc = nc + 1
  let new_total = new_dc * 16 + new_nc * 8
  let new_content = map_storage_migrate_with_nodes_content<K, V>(region, old_content, dc, new_nc, data_idx, node_idx, sub)
  champ_node_new(region, new_dm, new_nm, new_content, new_total)
}

-- Replace a sub-node pointer at index
pub(package) fn champ_replace_sub_node<K, V>(region: i64, node: i64, dm: i64, nm: i64, idx: i64, new_sub: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let old_content = champ_content(node)
  let total = dc * 16 + nc * 8
  let new_content = map_storage_replace_sub_content<K, V>(region, old_content, dc, nc, idx, new_sub)
  champ_node_new(region, dm, nm, new_content, total)
}

-- Empty ordinary nodes are pruned when removal returns through a parent. The
-- full-hash collision marker is never considered empty.
pub(package) fn champ_is_empty(node: i64) -> i64 {
  if champ_is_collision(node) == 1 { 0 }
  else {
    if champ_data_map(node) == 0 and champ_node_map(node) == 0 { 1 } else { 0 }
  }
}

pub(package) fn champ_remove_data<K, V>(region: i64, node: i64, dm: i64, nm: i64, bit: i64, idx: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  if dc == 1 and nc == 0 {
    champ_empty_node(region)
  } else {
    let new_content = map_storage_remove_data_content<K, V>(region, champ_content(node), dc, nc, idx)
    champ_node_new(region, dm bxor bit, nm, new_content, (dc - 1) * 16 + nc * 8)
  }
}

pub(package) fn champ_remove_sub_node<K, V>(region: i64, node: i64, dm: i64, nm: i64, bit: i64, idx: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  if dc == 0 and nc == 1 {
    champ_empty_node(region)
  } else {
    let new_content = map_storage_remove_sub_content<K, V>(region, champ_content(node), dc, nc, idx)
    champ_node_new(region, dm, nm bxor bit, new_content, dc * 16 + (nc - 1) * 8)
  }
}

-- Remove a key persistently. Zero is an internal miss sentinel: every real
-- CHAMP node, including an empty result, is region-allocated and non-zero.
pub(package) fn champ_remove<K: Hash & Eq, V>(region: i64, node: i64, key: K, key_hash: i64, depth: i64) -> i64 {
  if champ_is_collision(node) == 1 {
    let stored_key = champ_data_key<K>(node, 0)
    let node_count = champ_node_count(node)
    if stored_key.eq(key) {
      if node_count == 0 { champ_empty_node(region) }
      else { champ_sub_node(node, 0) }
    } else {
      if node_count == 0 { 0 }
      else {
        let next = champ_remove<K, V>(region, champ_sub_node(node, 0), key, key_hash, depth)
        if next == 0 { 0 }
        else {
          let stored_val = champ_data_val<V>(node, 0)
          if champ_is_empty(next) == 1 {
            champ_collision_node<K, V>(region, stored_key, stored_val, 0)
          } else {
            champ_collision_node<K, V>(region, stored_key, stored_val, next)
          }
        }
      }
    }
  } else {
    let frag = hash_fragment(key_hash, depth)
    let bit = frag_to_bit(frag)
    let dm = champ_data_map(node)
    let nm = champ_node_map(node)
    if (dm band bit) != 0 {
      let idx = compressed_index(dm, bit)
      let stored_key = champ_data_key<K>(node, idx)
      if stored_key.eq(key) {
        champ_remove_data<K, V>(region, node, dm, nm, bit, idx)
      } else { 0 }
    } else {
      if (nm band bit) != 0 {
        let idx = compressed_index(nm, bit)
        let next = champ_remove<K, V>(region, champ_sub_node(node, idx), key, key_hash, depth + 1)
        if next == 0 { 0 }
        else {
          if champ_is_empty(next) == 1 {
            champ_remove_sub_node<K, V>(region, node, dm, nm, bit, idx)
          } else {
            champ_replace_sub_node<K, V>(region, node, dm, nm, idx, next)
          }
        }
      } else { 0 }
    }
  }
}

-- ══════════════════════════════════════════════════════════════
-- Map API — user-facing wrapper
-- ══════════════════════════════════════════════════════════════

--- Construct an empty persistent map whose keys provide stable `Hash` and `Eq`.
pub fn new<K: Hash & Eq, V>() -> Map<K, V> {
  let region = map_storage_persistent_region_new_typed()
  let raw_region = map_storage_persistent_region_word(region)
  map_storage_persistent_box<K, V>(champ_empty_node(raw_region), raw_region)
}

impl<K: Hash & Eq, V> Map<K, V> {
  --- Look up `key`, returning `Some(value)` when present and `None` otherwise.
  pub fn get(self, key: K) -> Option<V> {
    let root = map_storage_persistent_root<K, V>(self)
    if root == 0 { None<V>() }
    else { champ_get<K, V>(root, key, key.hash(), 0) }
  }

  --- Return a map with `key` bound to `value`, leaving this version unchanged.
  pub fn insert(self, key: K, value: V) -> Map<K, V> {
    let root = map_storage_persistent_root<K, V>(self)
    let region = map_storage_persistent_region<K, V>(self)
    let h = key.hash()
    map_storage_persistent_box<K, V>(champ_put<K, V>(region, root, key, value, h, 0), region)
  }

  --- Return a map without `key`, leaving this version unchanged.
  --- Untouched structure is shared; removing an absent key is semantically a
  --- no-op even though the returned map has its own version handle.
  pub fn remove(self, key: K) -> Map<K, V> {
    let root = map_storage_persistent_root<K, V>(self)
    let region = map_storage_persistent_region<K, V>(self)
    let next = champ_remove<K, V>(region, root, key, key.hash(), 0)
    if next == 0 {
      map_storage_persistent_box<K, V>(root, region)
    } else {
      map_storage_persistent_box<K, V>(next, region)
    }
  }

  --- Return whether `key` is present.
  pub fn contains_key(self, key: K) -> bool {
    match self.get(key) {
      Some(value) -> true
      None -> false
    }
  }

}

impl<K, V> Map<K, V> {
  --- Fold every key-value pair in unspecified hash-trie order.
  --- The pure callback receives the accumulator, key, and value in that order.
  pub fn fold<A>(self, init: A, f: (A, K, V) -> A) -> A {
    let root = map_storage_persistent_root<K, V>(self)
    if root == 0 { init } else { champ_fold<K, V, A>(root, init, f) }
  }

  --- Return every key as a list in unspecified hash-trie order.
  pub fn keys(self) -> List<K> {
    let root = map_storage_persistent_root<K, V>(self)
    if root == 0 { Nil<K>() } else { champ_keys<K, V>(root, Nil<K>()) }
  }

  --- Return every value as a list in unspecified hash-trie order.
  pub fn values(self) -> List<V> {
    let root = map_storage_persistent_root<K, V>(self)
    if root == 0 { Nil<V>() } else { champ_values<K, V>(root, Nil<V>()) }
  }

  --- Return the number of key-value entries in the map.
  pub fn len(self) -> i64 {
    let root = map_storage_persistent_root<K, V>(self)
    if root == 0 { 0 } else { champ_size(root) }
  }
}

-- Walk a CHAMP node, applying f to each data entry, then recursing into sub-nodes.
pub(package) fn champ_fold<K, V, A>(node: i64, acc: A, f: (A, K, V) -> A) -> A {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let content = champ_content(node)
  -- Fold over data entries
  let mut a = acc
  for i in 0..dc {
    let key = map_storage_content_data_key<K>(content, i)
    let val = map_storage_content_data_val<V>(content, i)
    a = f(a, key, val)
  }
  -- Recurse into sub-nodes
  for i in 0..nc {
    let sub = map_storage_content_sub_node(content, dc, i)
    a = champ_fold<K, V, A>(sub, a, f)
  }
  a
}

pub(package) fn champ_keys<K, V>(node: i64, acc: List<K>) -> List<K> {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let content = champ_content(node)
  let mut keys = acc
  for i in 0..dc {
    keys = keys.prepend(map_storage_content_data_key<K>(content, i))
  }
  for i in 0..nc {
    keys = champ_keys<K, V>(map_storage_content_sub_node(content, dc, i), keys)
  }
  keys
}

pub(package) fn champ_values<K, V>(node: i64, acc: List<V>) -> List<V> {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let content = champ_content(node)
  let mut values = acc
  for i in 0..dc {
    values = values.prepend(map_storage_content_data_val<V>(content, i))
  }
  for i in 0..nc {
    values = champ_values<K, V>(map_storage_content_sub_node(content, dc, i), values)
  }
  values
}

pub(package) fn map_iter_produce<K, V>(m: Map<K, V>) -[GeneratorYield]> i64 {
  let root = map_storage_persistent_root<K, V>(m)
  if root == 0 { 0 } else { champ_iter_yield<K, V>(root) }
}

pub(package) fn champ_iter_yield<K, V>(node: i64) -[GeneratorYield]> i64 {
  let data_count = champ_data_count(node)
  let node_count = champ_node_count(node)
  let content = champ_content(node)
  for i in 0..data_count {
    let key = map_storage_content_data_key<K>(content, i)
    let value = map_storage_content_data_val<V>(content, i)
    generator.yield<(K, V)>((key, value))
  }
  for i in 0..node_count {
    champ_iter_yield<K, V>(map_storage_content_sub_node(content, data_count, i))
  }
  0
}

impl<K, V> IntoIterator for Map<K, V> {
  type Item = (K, V)

  fn into_iter(self: Map<K, V>) -> owned Iterator<(K, V)> {
    let producer = () => map_iter_produce<K, V>(self)
    from_generator<(K, V), i64>(generator.start<(K, V), i64>(producer))
  }
}

impl<K: Hash & Eq, V> Collect for Map<K, V> {
  type Item = (K, V)
  type Output = Map<K, V>

  fn from_iter(source: owned Iterator<(K, V)>) -> Self {
    let mut values = source
    let mut result = new<K, V>()
    let mut done = false
    while not done {
      match iter_next<(K, V)>(values) {
        Some((key, value)) -> {
          result = result.insert(key, value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    result
  }
}

pub(package) fn champ_size(node: i64) -> i64 {
  let dc = champ_data_count(node)
  let nc = champ_node_count(node)
  let content = champ_content(node)
  let mut size = dc
  for i in 0..nc {
    size = size + champ_size(map_storage_content_sub_node(content, dc, i))
  }
  size
}

pub(package) fn map_is_promoted<K, V>(m: Map<K, V>) -> i64 {
  map_storage_is_promoted<K, V>(m)
}

pub(package) fn map_promote<K, V>(m: Map<K, V>) -> i64 {
  map_storage_promote<K, V>(m)
}

-- ══════════════════════════════════════════════════════════════
-- Managed persistent root wrapper
-- ══════════════════════════════════════════════════════════════

-- The internal CHAMP node API above uses bare pointers inside one immutable
-- version family. Public maps box each root with a family-region owner:
-- Par promotion marks the version plus that one owner in O(1), unchanged
-- subtries remain shared, and the last version unmaps every historical path
-- copy.
pub(package) fn persistent_map_new<K: Hash & Eq, V>() -> Map<K, V> {
  new<K, V>()
}

pub(package) fn persistent_map_root<K, V>(m: Map<K, V>) -> i64 {
  map_storage_persistent_root<K, V>(m)
}

pub(package) fn persistent_map_get<K: Hash & Eq, V>(m: Map<K, V>, key: K) -> Option<V> {
  m.get(key)
}

pub(package) fn persistent_map_contains<K: Hash & Eq, V>(m: Map<K, V>, key: K) -> bool {
  m.contains_key(key)
}

pub(package) fn persistent_map_put<K: Hash & Eq, V>(m: Map<K, V>, key: K, val: V) -> Map<K, V> {
  m.insert(key, val)
}

pub(package) fn persistent_map_remove<K: Hash & Eq, V>(m: Map<K, V>, key: K) -> Map<K, V> {
  m.remove(key)
}

pub(package) fn persistent_map_fold<K, V, A>(m: Map<K, V>, init: A, f: (A, K, V) -> A) -> A {
  m.fold<A>(init, f)
}

pub(package) fn persistent_map_keys<K, V>(m: Map<K, V>) -> List<K> {
  m.keys()
}

pub(package) fn persistent_map_values<K, V>(m: Map<K, V>) -> List<V> {
  m.values()
}

pub(package) fn persistent_map_size<K, V>(m: Map<K, V>) -> i64 {
  m.len()
}

pub(package) fn persistent_map_is_promoted<K, V>(m: Map<K, V>) -> i64 {
  map_is_promoted<K, V>(m)
}

pub(package) fn persistent_map_promote<K, V>(m: Map<K, V>) -> i64 {
  map_promote<K, V>(m)
}
