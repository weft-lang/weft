-- stdlib/io.weft — IO effect for controlled side effects
--
-- IO is a contagious effect. Functions that perform IO must declare
-- -[IO]> in their signature. The effect is handled at the program
-- boundary (main installs the real syscall handler).
--
-- In tests, a mock handler can intercept IO operations for
-- deterministic testing without actual file/console access.

use "runtime/buffer.weft"
use "runtime/syscall.weft"
use "runtime/string.weft"
use "stdlib/drop.weft"

effect IO {
  fn read(fd: i64, buf: i64, len: i64) -> i64
  fn write(fd: i64, buf: i64, len: i64) -> i64
  fn open(path: str, flags: i64, mode: i64) -> i64
  fn close(fd: i64) -> i64
}

type FileHandle {
  fd: i64
}

impl Drop for FileHandle {
  fn drop(self) -[IO]> i64 {
    IO.close(self.fd)
  }
}

fn io_o_rdonly() -> i64 { 0 }
fn io_o_wronly() -> i64 { 1 }
fn io_o_creat() -> i64 { 512 }
fn io_o_trunc() -> i64 { 1024 }
fn io_o_write_create_trunc() -> i64 { io_o_wronly() + io_o_creat() + io_o_trunc() }
fn io_mode_user_rw() -> i64 { 420 }
fn io_read_chunk_size() -> i64 { 4096 }

fn io_string_from_bytes(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

fn io_read(fd: i64, buf: i64, len: i64) -[IO]> i64 {
  IO.read(fd, buf, len)
}

fn io_write(fd: i64, buf: i64, len: i64) -[IO]> i64 {
  IO.write(fd, buf, len)
}

fn io_open(path: str, flags: i64, mode: i64) -[IO]> i64 {
  IO.open(path, flags, mode)
}

fn io_close(fd: i64) -[IO]> i64 {
  IO.close(fd)
}

fn io_file_from_fd(fd: i64) -> owned FileHandle {
  FileHandle { fd: fd }
}

fn io_file_open(path: str, flags: i64, mode: i64) -[IO]> owned FileHandle {
  io_file_from_fd(io_open(path, flags, mode))
}

fn io_file_open_read(path: str) -[IO]> owned FileHandle {
  io_file_open(path, io_o_rdonly(), 0)
}

fn io_file_open_write_create_trunc(path: str) -[IO]> owned FileHandle {
  io_file_open(path, io_o_write_create_trunc(), io_mode_user_rw())
}

-- Convenience: print a string to stderr
fn io_eprint(s: str) -[IO]> i64 {
  IO.write(2, runtime_str_ptr(s), runtime_str_len(s))
}

-- Convenience: print to stdout
fn io_print(s: str) -[IO]> i64 {
  IO.write(1, runtime_str_ptr(s), runtime_str_len(s))
}

fn io_read_fd_all(fd: i64) -[IO]> str {
  let chunk = io_read_chunk_size()
  let scratch_buf = buf_new(chunk)
  let scratch = buf_ptr(scratch_buf)
  let out = buf_new(chunk)
  let mut done = 0
  while done == 0 {
    let n = IO.read(fd, scratch, chunk)
    if n > 0 {
      bscopy(out, scratch, n, 0)
      if n < chunk { done = 1 } else { 0 }
    } else {
      done = 1
    }
  }
  let len = buf_len(out)
  io_string_from_bytes(buf_ptr(out), len)
}

fn io_read_file(path: str) -[IO]> str {
  let fd = io_open(path, io_o_rdonly(), 0)
  if fd < 0 {
    ""
  } else {
    let data = io_read_fd_all(fd)
    IO.close(fd)
    data
  }
}

fn io_write_file(path: str, data: str) -[IO]> i64 {
  let fd = io_open(path, io_o_write_create_trunc(), io_mode_user_rw())
  if fd < 0 {
    fd
  } else {
    let written = IO.write(fd, runtime_str_ptr(data), runtime_str_len(data))
    IO.close(fd)
    written
  }
}

-- Raw syscall wrappers (for the default IO handler)
fn raw_read(fd: i64, buf: i64, len: i64) -> i64 {
  sys_read(fd, buf, len)
}
fn raw_write(fd: i64, buf: i64, len: i64) -> i64 {
  sys_write(fd, buf, len)
}
fn raw_open(path: str, flags: i64, mode: i64) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open(raw_path, flags, mode))
}
fn raw_close(fd: i64) -> i64 {
  sys_close(fd)
}

fn raw_unlink(path: str) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_unlink(raw_path))
}

fn with_raw_io_i64(f: () -[IO]> i64) -> i64 {
  handle f() {
    IO.read(fd, buf, len) -> resume(raw_read(fd, buf, len))
    IO.write(fd, buf, len) -> resume(raw_write(fd, buf, len))
    IO.open(path, flags, mode) -> resume(raw_open(path, flags, mode))
    IO.close(fd) -> resume(raw_close(fd))
  }
}

fn with_raw_io_str(f: () -[IO]> str) -> str {
  handle f() {
    IO.read(fd, buf, len) -> resume(raw_read(fd, buf, len))
    IO.write(fd, buf, len) -> resume(raw_write(fd, buf, len))
    IO.open(path, flags, mode) -> resume(raw_open(path, flags, mode))
    IO.close(fd) -> resume(raw_close(fd))
  }
}

fn io_write_file_raw(path: str, data: str) -> i64 {
  with_raw_io_i64(() => io_write_file(path, data))
}

fn io_read_file_raw(path: str) -> str {
  with_raw_io_str(() => io_read_file(path))
}
