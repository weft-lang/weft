-- stdlib/io.weft — IO effect for controlled side effects
--
-- IO is a contagious effect. Functions that perform IO must declare
-- -[IO]> in their signature. The effect is handled at the program
-- boundary (main installs the real syscall handler).
--
-- In tests, a mock handler can intercept IO operations for
-- deterministic testing without actual file/console access.

use runtime/buffer.{*}
use runtime/syscall.{*}
use runtime/string.{*}
use stdlib/drop.{*}

--- Legacy handler-facing I/O transport used by owned streaming files.
---
--- Application code should prefer `ConsoleRead`/`ConsoleWrite`,
--- `FileRead`/`FileWrite`, directory capabilities, and the typed streaming
--- functions in `stdlib/file`. These operations carry descriptor, pointer,
--- and platform-status conventions only between package/runtime adapters.
pub effect IO {
  --- Handler operation: read at most `len` bytes into package-managed storage.
  fn read(fd: i64, buf: i64, len: i64) -> i64
  --- Handler operation: write at most `len` bytes from package-managed storage.
  fn write(fd: i64, buf: i64, len: i64) -> i64
  --- Handler operation: open an existing file for streaming reads.
  fn open_read(path: str) -> i64
  --- Handler operation: create or truncate a file for streaming writes.
  fn open_write(path: str) -> i64
  --- Handler operation: create or truncate a file for streaming reads and writes.
  fn open_read_write(path: str) -> i64
  --- Handler operation: create a file or open it for streaming appends.
  fn open_append(path: str) -> i64
  --- Handler operation: close an adapter-owned descriptor.
  fn close(fd: i64) -> i64
  --- Handler operation: reposition from the beginning of a file.
  fn seek_start(fd: i64, offset: i64) -> i64
  --- Handler operation: reposition from the current file position.
  fn seek_current(fd: i64, offset: i64) -> i64
  --- Handler operation: reposition from the end of a file.
  fn seek_end(fd: i64, offset: i64) -> i64
  --- Handler operation: flush an adapter-owned descriptor.
  fn flush(fd: i64) -> i64
}

-- The descriptor representation is declaration-private. Ordinary callers can
-- receive and move the owned capability, but cannot forge or inspect it.
--- An opaque, single-owner streaming file capability.
---
--- Construct and operate on handles through `stdlib/file`; consuming close or
--- deterministic `Drop` releases the underlying resource exactly once.
pub type FileHandle = opaque i64

impl Drop for FileHandle {
  fn drop(self) -[IO]> i64 {
    match self { FileHandle(fd) -> IO.close(fd) }
  }
}

pub(package) fn io_mode_user_rw() -> i64 { 420 }

pub(package) fn io_read_chunk_size() -> i64 { 4096 }

pub(package) fn io_string_from_bytes(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

pub(package) fn io_read(fd: i64, buf: i64, len: i64) -[IO]> i64 {
  IO.read(fd, buf, len)
}

pub(package) fn io_write(fd: i64, buf: i64, len: i64) -[IO]> i64 {
  IO.write(fd, buf, len)
}

pub(package) fn io_open_read(path: str) -[IO]> i64 {
  IO.open_read(path)
}

pub(package) fn io_open_write(path: str) -[IO]> i64 {
  IO.open_write(path)
}

pub(package) fn io_open_read_write(path: str) -[IO]> i64 {
  IO.open_read_write(path)
}

pub(package) fn io_open_append(path: str) -[IO]> i64 {
  IO.open_append(path)
}

pub(package) fn io_close(fd: i64) -[IO]> i64 {
  IO.close(fd)
}

fn io_file_from_fd(fd: i64) -> owned FileHandle {
  FileHandle(fd)
}

pub(package) fn io_file_open_read(path: str) -[IO]> owned FileHandle {
  io_file_from_fd(io_open_read(path))
}

pub(package) fn io_file_open_write_create_trunc(path: str) -[IO]> owned FileHandle {
  io_file_from_fd(io_open_write(path))
}

pub(package) fn io_file_open_read_write_create_trunc(path: str) -[IO]> owned FileHandle {
  io_file_from_fd(io_open_read_write(path))
}

pub(package) fn io_file_open_append(path: str) -[IO]> owned FileHandle {
  io_file_from_fd(io_open_append(path))
}

-- Typed public file APIs build on these package-only representation bridges.
-- No descriptor or pointer-shaped argument escapes stdlib/runtime code.
fn io_file_open_checked_status<E>(
  status: i64,
  on_error: (i64) -[E]> never
) -[E]> owned FileHandle {
  if status < 0 { on_error(status) } else { 0 }
  io_file_from_fd(status)
}

pub(package) fn io_file_open_read_checked_with<E>(path: str, on_error: (i64) -[E]> never) -[IO, E]> owned FileHandle {
  io_file_open_checked_status<E>(IO.open_read(path), on_error)
}

pub(package) fn io_file_open_write_checked_with<E>(path: str, on_error: (i64) -[E]> never) -[IO, E]> owned FileHandle {
  io_file_open_checked_status<E>(IO.open_write(path), on_error)
}

pub(package) fn io_file_open_read_write_checked_with<E>(path: str, on_error: (i64) -[E]> never) -[IO, E]> owned FileHandle {
  io_file_open_checked_status<E>(IO.open_read_write(path), on_error)
}

pub(package) fn io_file_open_append_checked_with<E>(path: str, on_error: (i64) -[E]> never) -[IO, E]> owned FileHandle {
  io_file_open_checked_status<E>(IO.open_append(path), on_error)
}

pub(package) fn io_file_read_raw(file: borrow mut FileHandle, buf: i64, len: i64) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.read(fd, buf, len) }
}

pub(package) fn io_file_write_raw(file: borrow mut FileHandle, buf: i64, len: i64) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.write(fd, buf, len) }
}

pub(package) fn io_file_seek_start_raw(file: borrow mut FileHandle, offset: i64) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.seek_start(fd, offset) }
}

pub(package) fn io_file_seek_current_raw(file: borrow mut FileHandle, offset: i64) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.seek_current(fd, offset) }
}

pub(package) fn io_file_seek_end_raw(file: borrow mut FileHandle, offset: i64) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.seek_end(fd, offset) }
}

pub(package) fn io_file_flush_raw(file: borrow mut FileHandle) -[IO]> i64 {
  match file { FileHandle(fd) -> IO.flush(fd) }
}

pub(package) fn io_file_close_raw(file: owned FileHandle) -[IO]> i64 {
  file.drop()
}

-- Convenience: print a string to stderr
pub(package) fn io_eprint(s: str) -[IO]> i64 {
  IO.write(2, runtime_str_ptr(s), runtime_str_len(s))
}

-- Convenience: print to stdout
pub(package) fn io_print(s: str) -[IO]> i64 {
  IO.write(1, runtime_str_ptr(s), runtime_str_len(s))
}

pub(package) fn io_read_fd_all(fd: i64) -[IO]> str {
  let chunk = io_read_chunk_size()
  let scratch_buf = buf_new(chunk)
  let scratch = buf_ptr(scratch_buf)
  let out = buf_new(chunk)
  let mut done = 0
  while done == 0 {
    let n = IO.read(fd, scratch, chunk)
    if n > 0 {
      bscopy(out, scratch, n, 0)
      if n < chunk { done = 1 } else { 0 }
    } else {
      done = 1
    }
  }
  let len = buf_len(out)
  io_string_from_bytes(buf_ptr(out), len)
}

pub(package) fn io_read_file(path: str) -[IO]> str {
  let fd = io_open_read(path)
  if fd < 0 {
    ""
  } else {
    let data = io_read_fd_all(fd)
    IO.close(fd)
    data
  }
}

pub(package) fn io_write_file(path: str, data: str) -[IO]> i64 {
  let fd = io_open_write(path)
  if fd < 0 {
    fd
  } else {
    let written = IO.write(fd, runtime_str_ptr(data), runtime_str_len(data))
    IO.close(fd)
    written
  }
}

-- Raw syscall wrappers (for the default IO handler)
pub(package) fn raw_read(fd: i64, buf: i64, len: i64) -> i64 {
  sys_read(fd, buf, len)
}

pub(package) fn raw_write(fd: i64, buf: i64, len: i64) -> i64 {
  sys_write(fd, buf, len)
}

pub(package) fn raw_open_read(path: str) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open_read(raw_path))
}

pub(package) fn raw_open_write_create_new(path: str, mode: i64) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open_write_create_new(raw_path, mode))
}

pub(package) fn raw_open_write_create_truncate(path: str, mode: i64) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open_write_create_truncate(raw_path, mode))
}

pub(package) fn raw_open_write_append(path: str, mode: i64) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open_write_append(raw_path, mode))
}

pub(package) fn raw_open_read_write_create_truncate(path: str, mode: i64) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_open_read_write_create_truncate(raw_path, mode))
}

pub(package) fn raw_close(fd: i64) -> i64 {
  sys_close(fd)
}

pub(package) fn raw_remove(path: str) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_remove(raw_path))
}

pub(package) fn raw_rename(from: str, to: str) -> i64 {
  runtime_str_with_cstring_i64(from, (raw_from) =>
    runtime_str_with_cstring_i64(to, (raw_to) => sys_rename(raw_from, raw_to)))
}

pub(package) fn raw_seek_start(fd: i64, offset: i64) -> i64 {
  sys_seek_start(fd, offset)
}

pub(package) fn raw_seek_current(fd: i64, offset: i64) -> i64 {
  sys_seek_current(fd, offset)
}

pub(package) fn raw_seek_end(fd: i64, offset: i64) -> i64 {
  sys_seek_end(fd, offset)
}

pub(package) fn raw_flush(fd: i64) -> i64 {
  sys_file_flush(fd)
}

pub(package) fn with_raw_io_i64(f: () -[IO]> i64) -> i64 {
  handle f() {
    IO.read(fd, buf, len) -> resume(raw_read(fd, buf, len))
    IO.write(fd, buf, len) -> resume(raw_write(fd, buf, len))
    IO.open_read(path) -> resume(raw_open_read(path))
    IO.open_write(path) -> resume(raw_open_write_create_truncate(path, io_mode_user_rw()))
    IO.open_read_write(path) -> resume(raw_open_read_write_create_truncate(path, io_mode_user_rw()))
    IO.open_append(path) -> resume(raw_open_write_append(path, io_mode_user_rw()))
    IO.close(fd) -> resume(raw_close(fd))
    IO.seek_start(fd, offset) -> resume(raw_seek_start(fd, offset))
    IO.seek_current(fd, offset) -> resume(raw_seek_current(fd, offset))
    IO.seek_end(fd, offset) -> resume(raw_seek_end(fd, offset))
    IO.flush(fd) -> resume(raw_flush(fd))
  }
}

pub(package) fn with_raw_io_str(f: () -[IO]> str) -> str {
  handle f() {
    IO.read(fd, buf, len) -> resume(raw_read(fd, buf, len))
    IO.write(fd, buf, len) -> resume(raw_write(fd, buf, len))
    IO.open_read(path) -> resume(raw_open_read(path))
    IO.open_write(path) -> resume(raw_open_write_create_truncate(path, io_mode_user_rw()))
    IO.open_read_write(path) -> resume(raw_open_read_write_create_truncate(path, io_mode_user_rw()))
    IO.open_append(path) -> resume(raw_open_write_append(path, io_mode_user_rw()))
    IO.close(fd) -> resume(raw_close(fd))
    IO.seek_start(fd, offset) -> resume(raw_seek_start(fd, offset))
    IO.seek_current(fd, offset) -> resume(raw_seek_current(fd, offset))
    IO.seek_end(fd, offset) -> resume(raw_seek_end(fd, offset))
    IO.flush(fd) -> resume(raw_flush(fd))
  }
}

pub(package) fn io_write_file_raw(path: str, data: str) -> i64 {
  with_raw_io_i64(() => io_write_file(path, data))
}

pub(package) fn io_read_file_raw(path: str) -> str {
  with_raw_io_str(() => io_read_file(path))
}
