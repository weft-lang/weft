-- stdlib/io.weft — Basic IO operations
--
-- Provides print/println and file descriptor operations.
-- Uses syscalls directly (macOS aarch64).

fn io_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

fn io_read(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(3, fd, buf, len, 0, 0, 0)
}
