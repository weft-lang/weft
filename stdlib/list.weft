-- stdlib/list.weft — List<T> with basic operations
--
-- Singly-linked cons list. Nil terminates. Cons(head, tail) links.

use stdlib/option.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}

--- A persistent singly linked sequence, represented by `Nil` or `Cons`.
pub type List<T> {
  --- The empty list.
  Nil,
  --- One value followed by the remainder of the list.
  Cons(T, List<T>)
}

--- Construct an empty list.
pub fn list_nil<T>() -> List<T> {
  Nil<T>()
}

--- Prepend `item` to `tail`.
pub fn list_cons<T>(item: T, tail: List<T>) -> List<T> {
  Cons<T>(item, tail)
}

impl<T> List<T> {
  --- Return the number of values in the list.
  pub fn len(self) -> i64 {
    let mut n: i64 = 0
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          n = n + 1
          cur = rest
        }
      }
    }
    n
  }

  --- Return whether this list contains no values.
  pub fn is_empty(self) -> bool {
    match self {
      Nil -> true
      Cons(value, rest) -> false
    }
  }

  --- Return the first value, or `None` when this list is empty.
  pub fn first(self) -> Option<T> {
    match self {
      Nil -> None<T>()
      Cons(value, rest) -> Some<T>(value)
    }
  }

  --- Return the list after its first value, or `None` when empty.
  pub fn rest(self) -> Option<List<T>> {
    match self {
      Nil -> None<List<T>>()
      Cons(value, rest) -> Some<List<T>>(rest)
    }
  }

  --- Return a list with `item` prepended.
  pub fn prepend(self, item: T) -> List<T> {
    Cons<T>(item, self)
  }

  --- Return the value at `index`, or `None` when out of bounds.
  pub fn get(self, index: i64) -> Option<T> {
    if index < 0 {
      None<T>()
    } else {
      let mut cur = self
      let mut i = 0
      let mut result = None<T>()
      let mut done = false
      while not done {
        match cur {
          Nil -> { done = true }
          Cons(value, rest) -> {
            if i == index {
              result = Some<T>(value)
              done = true
            } else {
              cur = rest
              i = i + 1
            }
          }
        }
      }
      result
    }
  }

  --- Fold values from left to right, beginning with `init`.
  pub fn fold<A>(self, init: A, f: (A, T) -> A) -> A {
    let mut acc = init
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          acc = f(acc, value)
          cur = rest
        }
      }
    }
    acc
  }

  --- Transform every value while preserving list order.
  pub fn map<U>(self, f: (T) -> U) -> List<U> {
    let mut result = Nil<U>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<U>(f(value), result)
          cur = rest
        }
      }
    }
    result.reverse()
  }

  --- Reverse the order of this list.
  pub fn reverse(self) -> List<T> {
    let mut result = Nil<T>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<T>(value, result)
          cur = rest
        }
      }
    }
    result
  }

  --- Concatenate this list with `right` without mutating either input.
  pub fn concat(self, right: List<T>) -> List<T> {
    let mut result = right
    let mut cur = self.reverse()
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<T>(value, result)
          cur = rest
        }
      }
    }
    result
  }

  --- Append one value to the end of this list.
  pub fn append(self, item: T) -> List<T> {
    self.concat(Cons<T>(item, Nil<T>()))
  }

  --- Keep values for which `pred` returns true, preserving order.
  pub fn filter(self, pred: (T) -> bool) -> List<T> {
    let mut result = Nil<T>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          if pred(value) { result = Cons<T>(value, result) } else { nil }
          cur = rest
        }
      }
    }
    result.reverse()
  }
}

pub(package) fn list_into_iter<T>(list: List<T>) -> Iterator<T> {
  let producer = () => {
    let mut current = list
    let mut done = false
    while not done {
      match current {
        Cons(value, rest) -> {
          generator_yield<T>(value)
          current = rest
          nil
        }
        Nil -> {
          done = true
          nil
        }
      }
    }
    0
  }
  iter_from_generator<T>(generator_new<T, i64>(producer))
}

impl<T> IntoIterator for List<T> {
  type Item = T

  fn into_iter(self) -> Iterator<T> {
    list_into_iter<T>(self)
  }
}

impl<T> Collect for List<T> {
  type Item = T

  fn empty() -> Self {
    Nil<T>()
  }

  fn collect_from(self, source: Iterator<T>) -> Self {
    let mut reversed = Nil<T>()
    let mut done = false
    while not done {
      match iter_next<T>(source) {
        Some(value) -> {
          reversed = Cons<T>(value, reversed)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    self.concat(reversed.reverse())
  }
}

--- Fold values from left to right, beginning with `init`.
pub fn list_fold<T, A>(list: List<T>, init: A, f: (A, T) -> A) -> A {
  list.fold<A>(init, f)
}

--- Return whether the list is empty.
pub fn list_empty<T>(list: List<T>) -> bool {
  list.is_empty()
}

--- Return the first value, or `default` when the list is empty.
pub fn list_first_or<T>(list: List<T>, default: T) -> T {
  match list {
    Nil -> default
    Cons(head, rest) -> head
  }
}

--- Return the list after its first value, or an empty list when absent.
pub fn list_rest_or_nil<T>(list: List<T>) -> List<T> {
  match list {
    Nil -> Nil<T>()
    Cons(head, rest) -> rest
  }
}

--- Return the number of values in the list.
pub fn list_len<T>(list: List<T>) -> i64 {
  list.len()
}

--- Return the value at `index`, or `None` when the index is out of bounds.
pub fn list_nth<T>(list: List<T>, index: i64) -> Option<T> {
  list.get(index)
}

--- Transform every value while preserving list order.
pub fn list_map<T, U>(list: List<T>, f: (T) -> U) -> List<U> {
  list.map<U>(f)
}

--- Reverse the order of the list.
pub fn list_reverse<T>(list: List<T>) -> List<T> {
  list.reverse()
}

--- Concatenate two lists without mutating either input.
pub fn list_concat<T>(left: List<T>, right: List<T>) -> List<T> {
  left.concat(right)
}

--- Append one value to the end of the list.
pub fn list_append<T>(list: List<T>, item: T) -> List<T> {
  list.append(item)
}

--- Keep values for which `pred` returns true, preserving their order.
pub fn list_filter<T>(list: List<T>, pred: (T) -> bool) -> List<T> {
  list.filter(pred)
}

-- Fused i64 traversal helpers used by the optimiser to remove intermediate
-- map/filter lists while preserving left-to-right callback order.
--- Map and left-fold `i64` values in one traversal.
pub fn list_map_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  let mut done = false
  while not done {
    match cur {
      Nil -> { done = true }
      Cons(value, rest) -> {
        acc = fold_fn(acc, map_fn(value))
        cur = rest
      }
    }
  }
  acc
}

--- Filter and left-fold `i64` values in one traversal.
pub fn list_filter_fold_i64(list: List<i64>, init: i64, pred: (i64) -> bool, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  let mut done = false
  while not done {
    match cur {
      Nil -> { done = true }
      Cons(value, rest) -> {
        if pred(value) { acc = fold_fn(acc, value) } else { nil }
        cur = rest
      }
    }
  }
  acc
}

--- Map, filter, and left-fold `i64` values in one traversal.
pub fn list_map_filter_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, pred: (i64) -> bool, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  let mut done = false
  while not done {
    match cur {
      Nil -> { done = true }
      Cons(value, rest) -> {
        let mapped = map_fn(value)
        if pred(mapped) { acc = fold_fn(acc, mapped) } else { nil }
        cur = rest
      }
    }
  }
  acc
}

--- Build the half-open integer range `[start, end)`.
pub fn list_range(start: i64, end: i64) -> List<i64> {
  range(start, end)
}

--- Build the half-open integer range `[start, end)`.
pub fn range(start: i64, end: i64) -> List<i64> {
  let mut result: List<i64> = Nil<i64>()
  let mut i = end - 1
  while i >= start {
    result = Cons<i64>(i, result)
    i = i - 1
  }
  result
}
