-- stdlib/list.weft — List<T> with basic operations
--
-- Singly-linked cons list. Nil terminates. Cons(head, tail) links.

use stdlib/option.{*}

pub type List<T> {
  Nil,
  Cons(T, List<T>)
}

pub fn list_nil<T>() -> List<T> {
  Nil<T>()
}

pub fn list_cons<T>(item: T, tail: List<T>) -> List<T> {
  Cons<T>(item, tail)
}

impl<T> List<T> {
  -- Length of the list
  pub fn len(self) -> i64 {
    let mut n: i64 = 0
    let mut cur = self
    while list_empty<T>(cur) == 0 {
      n = n + 1
      cur = list_rest_or_nil<T>(cur)
    }
    n
  }

  -- Get the tail (rest of list)
  pub fn tail(self) -> List<T> {
    list_rest_or_nil<T>(self)
  }

  -- Prepend an element to the front
  pub fn prepend(self, item: T) -> List<T> {
    list_cons<T>(item, self)
  }
}

-- Fold a list from the left: fold(list, init, f) = f(f(f(init, x1), x2), x3)
pub fn list_fold<T, A>(list: List<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        acc = f(acc, head)
        cur = rest
        0
      }
    }
  }
  acc
}

pub fn list_empty<T>(list: List<T>) -> i64 {
  match list {
    Nil -> 1
    Cons(head, rest) -> 0
  }
}

pub fn list_first_or<T>(list: List<T>, default: T) -> T {
  match list {
    Nil -> default
    Cons(head, rest) -> head
  }
}

pub fn list_rest_or_nil<T>(list: List<T>) -> List<T> {
  match list {
    Nil -> Nil<T>()
    Cons(head, rest) -> rest
  }
}

pub fn list_len<T>(list: List<T>) -> i64 {
  list.len()
}

-- Return the element at index, or None when the index is negative or beyond
-- the end of the list.
pub fn list_nth<T>(list: List<T>, index: i64) -> Option<T> {
  if index < 0 {
    option_none<T>()
  } else {
    let mut cur = list
    let mut i = 0
    while i < index and list_empty<T>(cur) == 0 {
      cur = list_rest_or_nil<T>(cur)
      i = i + 1
    }
    match cur {
      Nil -> option_none<T>()
      Cons(head, rest) -> option_some<T>(head)
    }
  }
}

-- Map a function over a list: map([1,2,3], f) = [f(1), f(2), f(3)]
-- Builds result in reverse, then reverses
pub fn list_map<T, U>(list: List<T>, f: (T) -> U) -> List<U> {
  let mut result: List<U> = Nil<U>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<U>(f(head), result)
        cur = rest
        0
      }
    }
  }
  list_reverse<U>(result)
}

-- Reverse a list
pub fn list_reverse<T>(list: List<T>) -> List<T> {
  let mut result: List<T> = Nil<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<T>(head, result)
        cur = rest
        0
      }
    }
  }
  result
}

-- Concatenate without mutating either input. The left list is reversed once,
-- then rebuilt in front of right, preserving source order in O(n).
pub fn list_concat<T>(left: List<T>, right: List<T>) -> List<T> {
  let mut result = right
  let mut cur = list_reverse<T>(left)
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<T>(head, result)
        cur = rest
        0
      }
    }
  }
  result
}

pub fn list_append<T>(list: List<T>, item: T) -> List<T> {
  list_concat<T>(list, list_cons<T>(item, list_nil<T>()))
}

-- Filter a list keeping only elements where predicate returns true
pub fn list_filter<T>(list: List<T>, pred: (T) -> i64) -> List<T> {
  let mut result: List<T> = Nil<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        if pred(head) == 1 {
          result = list_cons<T>(head, result)
        } else { 0 }
        cur = rest
        0
      }
    }
  }
  list_reverse<T>(result)
}

-- Fused i64 traversal helpers used by the optimiser to remove intermediate
-- map/filter lists while preserving left-to-right callback order.
pub fn list_map_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while list_empty<i64>(cur) == 0 {
    let head = list_first_or<i64>(cur, 0)
    let mapped = map_fn(head)
    acc = fold_fn(acc, mapped)
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

pub fn list_filter_fold_i64(list: List<i64>, init: i64, pred: (i64) -> i64, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while list_empty<i64>(cur) == 0 {
    let head = list_first_or<i64>(cur, 0)
    if pred(head) == 1 {
      acc = fold_fn(acc, head)
    } else { 0 }
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

pub fn list_map_filter_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, pred: (i64) -> i64, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while list_empty<i64>(cur) == 0 {
    let head = list_first_or<i64>(cur, 0)
    let mapped = map_fn(head)
    if pred(mapped) == 1 {
      acc = fold_fn(acc, mapped)
    } else { 0 }
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

-- Create a list from a range: list_range(0, 5) = [0, 1, 2, 3, 4]
pub fn list_range(start: i64, end: i64) -> List<i64> {
  let mut result: List<i64> = Nil<i64>()
  let mut i = end - 1
  while i >= start {
    result = list_cons<i64>(i, result)
    i = i - 1
  }
  result
}
