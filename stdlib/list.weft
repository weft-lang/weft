-- stdlib/list.weft — List<T> with basic operations
--
-- Singly-linked cons list. Nil terminates. Cons(head, tail) links.
-- The tail is a pointer (i64) to the next list node.

type List<T> {
  Nil,
  Cons(T, i64)
}

impl List {
  -- Length of the list
  fn len(self: i64) -> i64 {
    let mut n: i64 = 0
    let mut cur = self
    let mut done = 0
    while done == 0 {
      let tag = __mem_load64(cur)
      if tag == __mem_load64(Nil) {
        done = 1
      } else {
        n = n + 1
        cur = __mem_load64(cur + 16)
      }
    }
    n
  }

  -- Get the head element (first value)
  fn head(self: i64) -> i64 {
    match self {
      Cons(x, rest) -> x
      Nil -> 0 - 1
    }
  }

  -- Get the tail (rest of list)
  fn tail(self: i64) -> i64 {
    match self {
      Cons(x, rest) -> rest
      Nil -> Nil
    }
  }

  -- Prepend an element to the front
  fn prepend(self: i64, item: i64) -> i64 {
    Cons<i64>(item, self)
  }
}

-- Fold a list from the left: fold(list, init, f) = f(f(f(init, x1), x2), x3)
fn list_fold<T, A>(list: i64, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let mut cur = list
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      let head = __mem_load64(cur + 8)
      acc = f(acc, head)
      cur = __mem_load64(cur + 16)
    }
  }
  acc
}

-- Map a function over a list: map([1,2,3], f) = [f(1), f(2), f(3)]
-- Builds result in reverse, then reverses
fn list_map<T, U>(list: i64, f: (T) -> U) -> i64 {
  let mut result = Nil
  let mut cur = list
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      let head = __mem_load64(cur + 8)
      result = Cons<U>(f(head), result)
      cur = __mem_load64(cur + 16)
    }
  }
  list_reverse<U>(result)
}

-- Reverse a list
fn list_reverse<T>(list: i64) -> i64 {
  let mut result = Nil
  let mut cur = list
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      let head = __mem_load64(cur + 8)
      result = Cons<T>(head, result)
      cur = __mem_load64(cur + 16)
    }
  }
  result
}

-- Filter a list keeping only elements where predicate returns true
fn list_filter<T>(list: i64, pred: (T) -> i64) -> i64 {
  let mut result = Nil
  let mut cur = list
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      let head = __mem_load64(cur + 8)
      if pred(head) == 1 {
        result = Cons<T>(head, result)
      } else { 0 }
      cur = __mem_load64(cur + 16)
    }
  }
  list_reverse<T>(result)
}

-- Create a list from a range: list_range(0, 5) = [0, 1, 2, 3, 4]
fn list_range(start: i64, end: i64) -> i64 {
  let mut result = Nil
  let mut i = end - 1
  while i >= start {
    result = Cons<i64>(i, result)
    i = i - 1
  }
  result
}
