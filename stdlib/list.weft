-- stdlib/list.weft — List<T> with basic operations
--
-- Singly-linked cons list. Nil terminates. Cons(head, tail) links.

use stdlib/option.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}

--- A persistent singly linked sequence, represented by `Nil` or `Cons`.
pub type List<T> {
  --- The empty list.
  Nil,
  --- One value followed by the remainder of the list.
  Cons(T, List<T>)
}

--- Construct an empty list.
pub fn list_nil<T>() -> List<T> {
  Nil<T>()
}

--- Prepend `item` to `tail`.
pub fn list_cons<T>(item: T, tail: List<T>) -> List<T> {
  Cons<T>(item, tail)
}

impl<T> List<T> {
  --- Return the number of values in the list.
  pub fn len(self) -> i64 {
    let mut n: i64 = 0
    let mut cur = self
    while not list_empty<T>(cur) {
      n = n + 1
      cur = list_rest_or_nil<T>(cur)
    }
    n
  }

  --- Return the list after its first value, or `Nil` when empty.
  pub fn tail(self) -> List<T> {
    list_rest_or_nil<T>(self)
  }

  --- Return a list with `item` prepended.
  pub fn prepend(self, item: T) -> List<T> {
    list_cons<T>(item, self)
  }
}

pub(package) fn list_into_iter<T>(list: List<T>) -> Iterator<T> {
  let producer = () => {
    let mut current = list
    let mut done = false
    while not done {
      match current {
        Cons(value, rest) -> {
          generator_yield<T>(value)
          current = rest
          nil
        }
        Nil -> {
          done = true
          nil
        }
      }
    }
    0
  }
  iter_from_generator<T>(generator_new<T, i64>(producer))
}

impl<T> IntoIterator for List<T> {
  type Item = T

  fn into_iter(self) -> Iterator<T> {
    list_into_iter<T>(self)
  }
}

impl<T> Collect for List<T> {
  type Item = T

  fn empty() -> Self {
    Nil<T>()
  }

  fn collect_from(self, source: Iterator<T>) -> Self {
    let mut reversed = Nil<T>()
    let mut done = false
    while not done {
      match iter_next<T>(source) {
        Some(value) -> {
          reversed = Cons<T>(value, reversed)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    list_concat<T>(self, list_reverse<T>(reversed))
  }
}

--- Fold values from left to right, beginning with `init`.
pub fn list_fold<T, A>(list: List<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        acc = f(acc, head)
        cur = rest
        0
      }
    }
  }
  acc
}

--- Return whether the list is empty.
pub fn list_empty<T>(list: List<T>) -> bool {
  match list {
    Nil -> true
    Cons(head, rest) -> false
  }
}

--- Return the first value, or `default` when the list is empty.
pub fn list_first_or<T>(list: List<T>, default: T) -> T {
  match list {
    Nil -> default
    Cons(head, rest) -> head
  }
}

--- Return the list after its first value, or an empty list when absent.
pub fn list_rest_or_nil<T>(list: List<T>) -> List<T> {
  match list {
    Nil -> Nil<T>()
    Cons(head, rest) -> rest
  }
}

--- Return the number of values in the list.
pub fn list_len<T>(list: List<T>) -> i64 {
  list.len()
}

--- Return the value at `index`, or `None` when the index is out of bounds.
pub fn list_nth<T>(list: List<T>, index: i64) -> Option<T> {
  if index < 0 {
    None<T>()
  } else {
    let mut cur = list
    let mut i = 0
    while i < index and not list_empty<T>(cur) {
      cur = list_rest_or_nil<T>(cur)
      i = i + 1
    }
    match cur {
      Nil -> None<T>()
      Cons(head, rest) -> Some<T>(head)
    }
  }
}

--- Transform every value while preserving list order.
pub fn list_map<T, U>(list: List<T>, f: (T) -> U) -> List<U> {
  let mut result: List<U> = Nil<U>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<U>(f(head), result)
        cur = rest
        0
      }
    }
  }
  list_reverse<U>(result)
}

--- Reverse the order of the list.
pub fn list_reverse<T>(list: List<T>) -> List<T> {
  let mut result: List<T> = Nil<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<T>(head, result)
        cur = rest
        0
      }
    }
  }
  result
}

--- Concatenate two lists without mutating either input.
pub fn list_concat<T>(left: List<T>, right: List<T>) -> List<T> {
  let mut result = right
  let mut cur = list_reverse<T>(left)
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        result = list_cons<T>(head, result)
        cur = rest
        0
      }
    }
  }
  result
}

--- Append one value to the end of the list.
pub fn list_append<T>(list: List<T>, item: T) -> List<T> {
  list_concat<T>(list, list_cons<T>(item, list_nil<T>()))
}

--- Keep values for which `pred` returns true, preserving their order.
pub fn list_filter<T>(list: List<T>, pred: (T) -> bool) -> List<T> {
  let mut result: List<T> = Nil<T>()
  let mut cur = list
  let mut done = 0
  while done == 0 {
    match cur {
      Nil -> {
        done = 1
        0
      }
      Cons(head, rest) -> {
        if pred(head) {
          result = list_cons<T>(head, result)
        } else { 0 }
        cur = rest
        0
      }
    }
  }
  list_reverse<T>(result)
}

-- Fused i64 traversal helpers used by the optimiser to remove intermediate
-- map/filter lists while preserving left-to-right callback order.
--- Map and left-fold `i64` values in one traversal.
pub fn list_map_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while not list_empty<i64>(cur) {
    let head = list_first_or<i64>(cur, 0)
    let mapped = map_fn(head)
    acc = fold_fn(acc, mapped)
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

--- Filter and left-fold `i64` values in one traversal.
pub fn list_filter_fold_i64(list: List<i64>, init: i64, pred: (i64) -> bool, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while not list_empty<i64>(cur) {
    let head = list_first_or<i64>(cur, 0)
    if pred(head) {
      acc = fold_fn(acc, head)
    } else { 0 }
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

--- Map, filter, and left-fold `i64` values in one traversal.
pub fn list_map_filter_fold_i64(list: List<i64>, init: i64, map_fn: (i64) -> i64, pred: (i64) -> bool, fold_fn: (i64, i64) -> i64) -> i64 {
  let mut acc = init
  let mut cur = list
  while not list_empty<i64>(cur) {
    let head = list_first_or<i64>(cur, 0)
    let mapped = map_fn(head)
    if pred(mapped) {
      acc = fold_fn(acc, mapped)
    } else { 0 }
    cur = list_rest_or_nil<i64>(cur)
  }
  acc
}

--- Build the half-open integer range `[start, end)`.
pub fn list_range(start: i64, end: i64) -> List<i64> {
  let mut result: List<i64> = Nil<i64>()
  let mut i = end - 1
  while i >= start {
    result = list_cons<i64>(i, result)
    i = i - 1
  }
  result
}
