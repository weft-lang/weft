-- stdlib/list.weft — List<T> with basic operations
--
-- Singly-linked cons list. Nil terminates. Cons(head, tail) links.

use stdlib/option.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/iter/core.{from_generator, iter_next}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}

--- A persistent singly linked sequence, represented by `Nil` or `Cons`.
pub type List<T> {
  --- The empty list.
  Nil,
  --- One value followed by the remainder of the list.
  Cons(T, List<T>)
}

impl<T> List<T> {
  --- Return the number of values in the list.
  pub fn len(self) -> i64 {
    let mut n: i64 = 0
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          n = n + 1
          cur = rest
        }
      }
    }
    n
  }

  --- Return whether this list contains no values.
  pub fn is_empty(self) -> bool {
    match self {
      Nil -> true
      Cons(value, rest) -> false
    }
  }

  --- Return the first value, or `None` when this list is empty.
  pub fn first(self) -> Option<T> {
    match self {
      Nil -> None<T>()
      Cons(value, rest) -> Some<T>(value)
    }
  }

  --- Return the list after its first value, or `None` when empty.
  pub fn rest(self) -> Option<List<T>> {
    match self {
      Nil -> None<List<T>>()
      Cons(value, rest) -> Some<List<T>>(rest)
    }
  }

  --- Return a list with `item` prepended.
  pub fn prepend(self, item: T) -> List<T> {
    Cons<T>(item, self)
  }

  --- Return the value at `index`, or `None` when out of bounds.
  pub fn get(self, index: i64) -> Option<T> {
    if index < 0 {
      None<T>()
    } else {
      let mut cur = self
      let mut i = 0
      let mut result = None<T>()
      let mut done = false
      while not done {
        match cur {
          Nil -> { done = true }
          Cons(value, rest) -> {
            if i == index {
              result = Some<T>(value)
              done = true
            } else {
              cur = rest
              i = i + 1
            }
          }
        }
      }
      result
    }
  }

  --- Fold values from left to right, beginning with `init`.
  pub fn fold<A>(self, init: A, f: (A, T) -> A) -> A {
    let mut acc = init
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          acc = f(acc, value)
          cur = rest
        }
      }
    }
    acc
  }

  --- Transform every value while preserving list order.
  pub fn map<U>(self, f: (T) -> U) -> List<U> {
    let mut result = Nil<U>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<U>(f(value), result)
          cur = rest
        }
      }
    }
    result.reverse()
  }

  --- Reverse the order of this list.
  pub fn reverse(self) -> List<T> {
    let mut result = Nil<T>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<T>(value, result)
          cur = rest
        }
      }
    }
    result
  }

  --- Concatenate this list with `right` without mutating either input.
  pub fn concat(self, right: List<T>) -> List<T> {
    let mut result = right
    let mut cur = self.reverse()
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          result = Cons<T>(value, result)
          cur = rest
        }
      }
    }
    result
  }

  --- Append one value to the end of this list.
  pub fn append(self, item: T) -> List<T> {
    self.concat(Cons<T>(item, Nil<T>()))
  }

  --- Keep values for which `pred` returns true, preserving order.
  pub fn filter(self, pred: (T) -> bool) -> List<T> {
    let mut result = Nil<T>()
    let mut cur = self
    let mut done = false
    while not done {
      match cur {
        Nil -> { done = true }
        Cons(value, rest) -> {
          if pred(value) { result = Cons<T>(value, result) } else { nil }
          cur = rest
        }
      }
    }
    result.reverse()
  }
}

pub(package) fn list_into_iter<T>(list: List<T>) -> owned Iterator<T> {
  let producer = () => {
    let mut current = list
    let mut done = false
    while not done {
      match current {
        Cons(value, rest) -> {
          generator.yield<T>(value)
          current = rest
          nil
        }
        Nil -> {
          done = true
          nil
        }
      }
    }
    0
  }
  from_generator<T, i64>(generator.start<T, i64>(producer))
}

impl<T> IntoIterator for List<T> {
  type Item = T

  fn into_iter(self) -> owned Iterator<T> {
    list_into_iter<T>(self)
  }
}

impl<T> Collect for List<T> {
  type Item = T

  fn from_iter(source: owned Iterator<T>) -> Self {
    let mut values = source
    let mut reversed = Nil<T>()
    let mut done = false
    while not done {
      match iter_next<T>(values) {
        Some(value) -> {
          reversed = Cons<T>(value, reversed)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    reversed.reverse()
  }
}

--- Build the half-open integer range `[start, end)`.
pub fn range(start: i64, end: i64) -> List<i64> {
  let mut result: List<i64> = Nil<i64>()
  let mut i = end - 1
  while i >= start {
    result = Cons<i64>(i, result)
    i = i - 1
  }
  result
}
