-- stdlib/display.weft — Display trait for human-readable string conversion
--
-- Display provides a standard way to convert values to strings.
-- Used by string interpolation (when implemented) and print functions.

use "stdlib/string.weft"

trait Display {
  fn display(self: i64) -> i64
}

impl Display for i64 {
  fn display(self: i64) -> i64 {
    int_to_str(self)
  }
}

impl Display for bool {
  fn display(self: i64) -> i64 {
    if self == 1 { "true" } else { "false" }
  }
}

impl Display for str {
  fn display(self: i64) -> i64 {
    self
  }
}

-- Print any Display value to stdout
fn print_val(x: i64) -> i64 {
  print(x)
}

-- Print any Display value followed by newline
fn println_val(x: i64) -> i64 {
  println(x)
}
