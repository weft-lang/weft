-- stdlib/display.weft — Display trait for human-readable string conversion
--
-- Display provides a standard way to convert values to strings.
-- Used by string interpolation and presentation effects such as ConsoleWrite.

use stdlib/num.{num_render_f32, num_render_f64, num_render_i64, num_render_u64}

--- Conversion to deterministic human-readable text.
pub trait Display {
  --- Render this value as text.
  fn display(self) -> str
}

impl Display for i64 {
  fn display(self: i64) -> str {
    num_render_i64(self)
  }
}

impl Display for i8 {
  fn display(self: i8) -> str { num_render_i64(__i8_to_i64(self)) }
}

impl Display for i16 {
  fn display(self: i16) -> str { num_render_i64(__i16_to_i64(self)) }
}

impl Display for i32 {
  fn display(self: i32) -> str { num_render_i64(__i32_to_i64(self)) }
}

impl Display for isize {
  fn display(self: isize) -> str { num_render_i64(__isize_to_i64(self)) }
}

impl Display for u8 {
  fn display(self: u8) -> str { num_render_u64(__u8_to_u64(self)) }
}

impl Display for u16 {
  fn display(self: u16) -> str { num_render_u64(__u16_to_u64(self)) }
}

impl Display for u32 {
  fn display(self: u32) -> str { num_render_u64(__u32_to_u64(self)) }
}

impl Display for u64 {
  fn display(self: u64) -> str { num_render_u64(self) }
}

impl Display for usize {
  fn display(self: usize) -> str { num_render_u64(__usize_to_u64(self)) }
}

impl Display for bool {
  fn display(self: bool) -> str {
    if self == 1 { "true" } else { "false" }
  }
}

impl Display for str {
  fn display(self: str) -> str {
    self
  }
}

impl Display for f64 {
  fn display(self: f64) -> str {
    num_render_f64(self)
  }
}

impl Display for f32 {
  fn display(self: f32) -> str {
    num_render_f32(self)
  }
}
