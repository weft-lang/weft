-- stdlib/tensor.weft -- checked dense row-major tensors

use stdlib/list as list
use stdlib/list.{List, Cons, Nil}
use stdlib/num
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/vector as vector
use stdlib/vector.{Vector}

--- Ordered axis extents, from the outermost axis to the innermost axis.
pub type TensorDimensions = List<usize>

--- One coordinate per tensor axis, in the same order as its dimensions.
pub type TensorCoordinates = List<usize>

--- A tensor shape cannot be represented by the platform element-count domain.
pub type TensorShapeError {
  --- Multiplying the accumulated size by this axis extent overflowed `usize`.
  TensorShapeOverflow(usize, usize)
}

--- Values supplied for a tensor disagree with its checked shape.
pub type TensorDataError {
  --- The checked shape requires the first count but the source supplied the second.
  TensorElementCountMismatch(usize, usize)
}

pub(package) type TensorShapeParts {
  dimensions: TensorDimensions,
  elements: usize
}

--- A finite row-major shape with a representable total element count.
pub type TensorShape = opaque TensorShapeParts

pub(package) type TensorParts<T> {
  storage: Vector<T>,
  shape: TensorShape
}

--- A mutable dense row-major tensor whose storage exactly fills its shape.
pub type Tensor<T> = opaque TensorParts<T>

fn tensor_shape_size(dimensions: TensorDimensions, accumulated: usize) -> Result<usize, TensorShapeError> {
  match dimensions {
    Nil -> Ok<usize, TensorShapeError>(accumulated)
    Cons(dimension, rest) -> match accumulated.checked_mul(dimension) {
      Some(next) -> tensor_shape_size(rest, next)
      None -> Err<usize, TensorShapeError>(TensorShapeOverflow(accumulated, dimension))
    }
  }
}

--- Check an ordered dimension sequence and retain its exact element count.
--- The empty sequence is the scalar shape and therefore contains one value.
pub fn shape(dimensions: TensorDimensions) -> Result<TensorShape, TensorShapeError> {
  match tensor_shape_size(dimensions, 1) {
    Ok(elements) -> Ok<TensorShape, TensorShapeError>(TensorShape(TensorShapeParts {
      dimensions: dimensions,
      elements: elements
    }))
    Err(error) -> Err<TensorShape, TensorShapeError>(error)
  }
}

--- Copy axis extents from a slice and check the resulting shape.
pub fn shape_from_slice(dimensions: [usize]) -> Result<TensorShape, TensorShapeError> {
  shape(list.from_slice(dimensions))
}

fn tensor_storage_from_slice<T>(values: [T]) -> Vector<T> {
  let mut storage = vector.with_capacity<T>(values.len)
  for value in values { storage.push(value) }
  storage
}

fn tensor_storage_filled<T>(count: usize, value: T) -> Vector<T> {
  let mut storage = vector.with_capacity<T>(count)
  let mut position: usize = 0
  while position < count {
    storage.push(value)
    position = position + 1
  }
  storage
}

--- Copy values into a checked shape, rejecting an incomplete or overfull source.
pub fn from_slice<T>(tensor_shape: TensorShape, values: [T]) -> Result<Tensor<T>, TensorDataError> {
  if values.len != tensor_shape.len() {
    Err<Tensor<T>, TensorDataError>(TensorElementCountMismatch(tensor_shape.len(), values.len))
  } else {
    Ok<Tensor<T>, TensorDataError>(Tensor<T>(TensorParts<T> {
      storage: tensor_storage_from_slice<T>(values),
      shape: tensor_shape
    }))
  }
}

--- Fill every position in a checked shape with one value.
pub fn filled<T>(tensor_shape: TensorShape, value: T) -> Tensor<T> {
  Tensor<T>(TensorParts<T> {
    storage: tensor_storage_filled<T>(tensor_shape.len(), value),
    shape: tensor_shape
  })
}

fn tensor_offset(dimensions: TensorDimensions, coordinates: TensorCoordinates, accumulated: usize) -> Option<usize> {
  match (dimensions, coordinates) {
    (Nil, Nil) -> Some(accumulated)
    (Cons(dimension, dimension_rest), Cons(coordinate, coordinate_rest)) -> {
      if coordinate >= dimension { None<usize>() }
      else { match accumulated.checked_mul(dimension) {
        Some(prefix) -> match prefix.checked_add(coordinate) {
          Some(next) -> tensor_offset(dimension_rest, coordinate_rest, next)
          None -> None<usize>()
        }
        None -> None<usize>()
      } }
    }
    _ -> None<usize>()
  }
}

impl TensorShape {
  --- Return the ordered axis extents retained by this shape.
  pub fn dimensions(self) -> TensorDimensions {
    match self { TensorShape(parts) -> parts.dimensions }
  }

  --- Return the number of axes. A scalar has rank zero.
  pub fn rank(self) -> usize { self.dimensions().len() }

  --- Return the exact number of elements required by this shape.
  pub fn len(self) -> usize {
    match self { TensorShape(parts) -> parts.elements }
  }

  --- Return whether this shape contains no element positions.
  pub fn is_empty(self) -> bool { self.len() == 0 }

  --- Return one axis extent, or `None` beyond the shape's rank.
  pub fn dimension(self, axis: usize) -> Option<usize> { self.dimensions().get(axis) }

  --- Convert a complete in-bounds coordinate to its row-major storage position.
  pub fn offset(self, coordinates: TensorCoordinates) -> Option<usize> {
    tensor_offset(self.dimensions(), coordinates, 0)
  }
}

impl<T> Tensor<T> {
  --- Return this tensor's checked shape.
  pub fn shape(self) -> TensorShape { match self { Tensor(parts) -> parts.shape } }

  --- Return the number of tensor axes.
  pub fn rank(self) -> usize { self.shape().rank() }

  --- Return the number of initialized values.
  pub fn len(self) -> usize { self.shape().len() }

  --- Return whether this tensor contains no values.
  pub fn is_empty(self) -> bool { self.len() == 0 }

  --- Read a value by its complete coordinate sequence.
  pub fn get(self, coordinates: TensorCoordinates) -> Option<T> {
    match self.shape().offset(coordinates) {
      Some(position) -> match self {
        Tensor(parts) -> {
          let storage = parts.storage
          storage.get(position)
        }
      }
      None -> None<T>()
    }
  }

  --- Replace a value by its complete coordinate sequence.
  pub fn set(self, coordinates: TensorCoordinates, value: T) -> bool {
    match self.shape().offset(coordinates) {
      Some(position) -> self.set_flat(position, value)
      None -> false
    }
  }

  --- Read a value by its row-major storage position.
  pub fn get_flat(self, position: usize) -> Option<T> {
    match self {
      Tensor(parts) -> {
        let storage = parts.storage
        storage.get(position)
      }
    }
  }

  --- Replace a value by its row-major storage position.
  pub fn set_flat(self, position: usize, value: T) -> bool {
    match self {
      Tensor(parts) -> {
        let storage = parts.storage
        match position.to_u64().to_i64_checked() {
          Ok(storage_position) -> vector.vector_set<T>(storage, storage_position, value)
          Err(_) -> false
        }
      }
    }
  }
}
