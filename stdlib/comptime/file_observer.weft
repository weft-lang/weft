-- FileRead observation handler used by compile-time evaluation.

use stdlib/comptime/types.{ComptimeFileObservation, ComptimeFileObservations}
use stdlib/file.{FileRead}
use stdlib/list as list
use stdlib/list.{Cons, Nil}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len, vector_push}

--- Mutable observation state installed around one compile-time evaluation.
--- Every vector contents is a valid state, so this is an ordinary named type.
pub type FileObserver {
  --- Mutable program-ordered observation storage.
  values: Vector<ComptimeFileObservation>
}

--- Construct empty file-observation state.
pub fn observer() -> FileObserver {
  FileObserver {
    values: vector.new<ComptimeFileObservation>()
  }
}

fn record(observer: FileObserver, observation: ComptimeFileObservation) -> nil {
  let values = observer.values
  vector_push<ComptimeFileObservation>(values, observation)
  nil
}

--- Snapshot observations in the order their file operations occurred.
pub fn observations(observer: FileObserver) -> ComptimeFileObservations {
  let values = observer.values
  let mut reversed = Nil<ComptimeFileObservation>()
  let mut index = 0
  while index < vector_len<ComptimeFileObservation>(values) {
    reversed = Cons(vector_get_in_bounds<ComptimeFileObservation>(values, index), reversed)
    index = index + 1
  }
  reversed.reverse()
}

--- Observe `FileRead` while delegating authority to the enclosing handler.
pub implements FileRead(observer: FileObserver) {
  FileRead.read_all(path, limit) -> {
    let outcome = FileRead.read_all(path, limit)
    record(observer, ComptimeFileObservation {
      path: path,
      limit: limit,
      outcome: outcome
    })
    resume(outcome)
  }
}
