-- Typed observations produced by compile-time evaluation.

use stdlib/bytes.{Bytes}
use stdlib/io/types.{IoError}
use stdlib/list.{List}
use stdlib/path.{Path}
use stdlib/result.{Result}

--- One bounded file operation observed during compile-time evaluation.
---
--- The complete typed outcome is retained: successful content contributes to
--- the build identity, while a failed observation cannot be mistaken for an
--- evaluation that performed no read.
pub type ComptimeFileObservation {
  --- The exact native-byte path presented to `FileRead`.
  path: Path,
  --- The caller's finite read bound.
  limit: usize,
  --- The exact value returned by the enclosing file handler.
  outcome: Result<Bytes, IoError>
}

--- File observations in program order.
pub type ComptimeFileObservations = List<ComptimeFileObservation>

--- A compile-time value paired with every file operation that produced it.
pub type ComptimeEvaluation<T> {
  --- The ordinary value returned by the evaluated function.
  value: T,
  --- File operations in deterministic observation order.
  file_observations: ComptimeFileObservations
}
