-- stdlib/sorted_set.weft — vector-backed sorted sets
--
-- Sets are implemented as sorted maps from element to unit marker, sharing
-- canonical `Ord` ordering and deterministic iteration behavior.

use stdlib/sorted_map as sorted_map
use stdlib/sorted_map.{SortedMap, sorted_map_contains, sorted_map_is_empty, sorted_map_key_at, sorted_map_keys, sorted_map_len, sorted_map_put, sorted_map_remove}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/iter/core.{from_generator, iter_next}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}
use stdlib/option.{*}
use stdlib/ord.{Ord}
use stdlib/vector.{Vector, vector_get_in_bounds}

--- A mutable vector-backed set kept in ascending element order.
pub type SortedSet<T> = opaque SortedMap<T, i64>

--- Construct an empty mutable ordered set.
pub fn new<T: Ord>() -> SortedSet<T> {
  SortedSet<T>(sorted_map.new<T, i64>())
}

pub(package) fn sorted_set_map<T>(set: SortedSet<T>) -> SortedMap<T, i64> {
  match set {
    SortedSet(values) -> values
  }
}

--- Return the number of distinct elements in an ordered set.
pub(package) fn sorted_set_len<T>(set: SortedSet<T>) -> i64 {
  sorted_map_len<T, i64>(sorted_set_map<T>(set))
}

--- Iterate values in ascending order.
pub(package) fn sorted_set_into_iter<T>(set: SortedSet<T>) -> owned Iterator<T> {
  let producer = () => {
    let mut index = 0
    let mut done = 0
    while done == 0 {
      if index < sorted_set_len<T>(set) {
        generator.yield<T>(sorted_map_key_at<T, i64>(sorted_set_map<T>(set), index))
        index = index + 1
      } else {
        done = 1
      }
    }
    0
  }
  from_generator<T, i64>(generator.start<T, i64>(producer))
}

impl<T> IntoIterator for SortedSet<T> {
  type Item = T

  fn into_iter(self: SortedSet<T>) -> owned Iterator<T> {
    sorted_set_into_iter<T>(self)
  }
}

--- Return whether the ordered set has no elements.
pub(package) fn sorted_set_is_empty<T>(set: SortedSet<T>) -> bool {
  sorted_map_is_empty<T, i64>(sorted_set_map<T>(set))
}

pub(package) fn sorted_set_insert<T: Ord>(set: SortedSet<T>, value: T) -> bool {
  sorted_map_put<T, i64>(sorted_set_map<T>(set), value, 1)
}

pub(package) fn sorted_set_remove<T: Ord>(set: SortedSet<T>, value: T) -> bool {
  sorted_map_remove<T, i64>(sorted_set_map<T>(set), value).is_some()
}

pub(package) fn sorted_set_contains<T: Ord>(set: SortedSet<T>, value: T) -> bool {
  sorted_map_contains<T, i64>(sorted_set_map<T>(set), value)
}

--- Copy elements into a new vector in ascending order.
pub(package) fn sorted_set_values<T>(set: SortedSet<T>) -> Vector<T> {
  sorted_map_keys<T, i64>(sorted_set_map<T>(set))
}

pub(package) fn sorted_set_vector_value_at<T>(values: Vector<T>, index: i64) -> T {
  vector_get_in_bounds<T>(values, index)
}

pub(package) fn sorted_set_union<T: Ord>(left: SortedSet<T>, right: SortedSet<T>) -> SortedSet<T> {
  let out = new<T>()
  let left_values = sorted_set_values<T>(left)
  let right_values = sorted_set_values<T>(right)
  for i in 0..left_values.len() {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(left_values, i))
  }
  for i in 0..right_values.len() {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(right_values, i))
  }
  out
}

pub(package) fn sorted_set_intersection<T: Ord>(left: SortedSet<T>, right: SortedSet<T>) -> SortedSet<T> {
  let out = new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..left_values.len() {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value) {
      sorted_set_insert<T>(out, value)
    } else { 0 }
  }
  out
}

pub(package) fn sorted_set_difference<T: Ord>(left: SortedSet<T>, right: SortedSet<T>) -> SortedSet<T> {
  let out = new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..left_values.len() {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if not sorted_set_contains<T>(right, value) {
      sorted_set_insert<T>(out, value)
    } else { 0 }
  }
  out
}

impl<T> SortedSet<T> {
  --- Return the number of distinct elements.
  pub fn len(self) -> i64 {
    sorted_set_len<T>(self)
  }

  --- Return whether this set has no elements.
  pub fn is_empty(self) -> bool {
    sorted_set_is_empty<T>(self)
  }

  --- Copy elements into a new vector in ascending order.
  pub fn values(self) -> Vector<T> {
    sorted_set_values<T>(self)
  }
}

impl<T: Ord> SortedSet<T> {
  --- Insert in place, returning whether the value was newly added.
  pub fn insert(self, value: T) -> bool {
    sorted_set_insert<T>(self, value)
  }

  --- Remove in place, returning whether the value was present.
  pub fn remove(self, value: T) -> bool {
    sorted_set_remove<T>(self, value)
  }

  --- Return whether `value` is present.
  pub fn contains(self, value: T) -> bool {
    sorted_set_contains<T>(self, value)
  }

  --- Return a new set containing every element from either input.
  pub fn union(self, other: SortedSet<T>) -> SortedSet<T> {
    sorted_set_union<T>(self, other)
  }

  --- Return a new set containing elements present in both inputs.
  pub fn intersection(self, other: SortedSet<T>) -> SortedSet<T> {
    sorted_set_intersection<T>(self, other)
  }

  --- Return a new set containing elements absent from `other`.
  pub fn difference(self, other: SortedSet<T>) -> SortedSet<T> {
    sorted_set_difference<T>(self, other)
  }
}

impl<T: Ord> Collect for SortedSet<T> {
  type Item = T
  type Output = SortedSet<T>

  fn from_iter(source: owned Iterator<T>) -> Self {
    let result = new<T>()
    let mut values = source
    let mut done = false
    while not done {
      match iter_next<T>(values) {
        Some(value) -> {
          result.insert(value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    result
  }
}
