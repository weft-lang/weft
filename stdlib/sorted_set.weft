-- stdlib/sorted_set.weft — vector-backed sorted sets
--
-- Sets are implemented as sorted maps from element to unit marker, sharing the
-- same comparator-driven ordering and deterministic iteration behavior.

use stdlib/sorted_map.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use stdlib/ord.{Ordering}
use stdlib/vector.{*}

--- A mutable vector-backed set kept in caller-defined element order.
pub type SortedSet<T> {
  --- Wrap an ordered unit-valued map; prefer `sorted_set_new` for construction.
  SortedSet(SortedMap<T, i64>)
}

--- Construct an empty mutable ordered set.
pub fn sorted_set_new<T>() -> SortedSet<T> {
  SortedSet<T>(sorted_map_new<T, i64>())
}

pub(package) fn sorted_set_map<T>(set: SortedSet<T>) -> SortedMap<T, i64> {
  match set {
    SortedSet(values) -> values
  }
}

--- Return the number of distinct elements in an ordered set.
pub fn sorted_set_len<T>(set: SortedSet<T>) -> i64 {
  sorted_map_len<T, i64>(sorted_set_map<T>(set))
}

--- Iterate values in ascending comparator order.
pub fn sorted_set_into_iter<T>(set: SortedSet<T>) -> Iterator<T> {
  let producer = () => {
    let mut index = 0
    let mut done = 0
    while done == 0 {
      if index < sorted_set_len<T>(set) {
        generator_yield<T>(sorted_map_key_at<T, i64>(sorted_set_map<T>(set), index))
        index = index + 1
      } else {
        done = 1
      }
    }
    0
  }
  iter_from_generator<T>(generator_new<T, i64>(producer))
}

impl<T> IntoIterator for SortedSet<T> {
  type Item = T

  fn into_iter(self: SortedSet<T>) -> Iterator<T> {
    sorted_set_into_iter<T>(self)
  }
}

--- Return `1` when the ordered set has no elements and `0` otherwise.
pub fn sorted_set_is_empty<T>(set: SortedSet<T>) -> i64 {
  sorted_map_is_empty<T, i64>(sorted_set_map<T>(set))
}

--- Insert in place, returning `1` if added and `0` if already present.
--- Use the same pure total-order comparator for every operation on `set`.
pub fn sorted_set_insert<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> Ordering) -> i64 {
  sorted_map_put<T, i64>(sorted_set_map<T>(set), value, 1, cmp)
}

--- Remove in place, returning `1` if removed and `0` if absent.
--- The comparator must match the one used to populate `set`.
pub fn sorted_set_remove<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> Ordering) -> i64 {
  sorted_map_remove<T, i64>(sorted_set_map<T>(set), value, cmp)
}

--- Return `1` when a value is present and `0` otherwise.
--- The comparator must match the one used to populate `set`.
pub fn sorted_set_contains<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> Ordering) -> i64 {
  sorted_map_contains<T, i64>(sorted_set_map<T>(set), value, cmp)
}

--- Copy elements into a new vector in ascending comparator order.
pub fn sorted_set_values<T>(set: SortedSet<T>) -> Vector<T> {
  sorted_map_keys<T, i64>(sorted_set_map<T>(set))
}

pub(package) fn sorted_set_vector_value_at<T>(values: Vector<T>, index: i64) -> T {
  vector_get_in_bounds<T>(values, index)
}

--- Return a new ordered set containing every element from either input.
--- Both inputs must have been populated with the supplied comparator.
pub fn sorted_set_union<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> Ordering) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  let right_values = sorted_set_values<T>(right)
  for i in 0..vector_len<T>(left_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(left_values, i), cmp)
  }
  for i in 0..vector_len<T>(right_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(right_values, i), cmp)
  }
  out
}

--- Return a new ordered set containing elements present in both inputs.
--- Both inputs must have been populated with the supplied comparator.
pub fn sorted_set_intersection<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> Ordering) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len<T>(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 1 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}

--- Return a new ordered set containing elements in `left` but not `right`.
--- Both inputs must have been populated with the supplied comparator.
pub fn sorted_set_difference<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> Ordering) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len<T>(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 0 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}
