-- stdlib/sorted_set.weft — vector-backed sorted sets
--
-- Sets are implemented as sorted maps from element to unit marker, sharing the
-- same comparator-driven ordering and deterministic iteration behavior.

use "stdlib/sorted_map.weft"
use "stdlib/vector.weft"

type SortedSet<T> {
  SortedSet(SortedMap<T, i64>)
}

fn sorted_set_new<T>() -> SortedSet<T> {
  SortedSet<T>(sorted_map_new<T, i64>())
}

fn sorted_set_map<T>(set: SortedSet<T>) -> SortedMap<T, i64> {
  match set {
    SortedSet(values) -> values
  }
}

fn sorted_set_len<T>(set: SortedSet<T>) -> i64 {
  sorted_map_len<T, i64>(sorted_set_map<T>(set))
}

fn sorted_set_is_empty<T>(set: SortedSet<T>) -> i64 {
  sorted_map_is_empty<T, i64>(sorted_set_map<T>(set))
}

fn sorted_set_insert<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_put<T, i64>(sorted_set_map<T>(set), value, 1, cmp)
}

fn sorted_set_remove<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_remove<T, i64>(sorted_set_map<T>(set), value, cmp)
}

fn sorted_set_contains<T>(set: SortedSet<T>, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_contains<T, i64>(sorted_set_map<T>(set), value, cmp)
}

fn sorted_set_values<T>(set: SortedSet<T>) -> Vector<T> {
  sorted_map_keys<T, i64>(sorted_set_map<T>(set))
}

fn sorted_set_vector_value_at<T>(values: Vector<T>, index: i64) -> T {
  vector_get_in_bounds<T>(values, index)
}

fn sorted_set_union<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> i64) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  let right_values = sorted_set_values<T>(right)
  for i in 0..vector_len<T>(left_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(left_values, i), cmp)
  }
  for i in 0..vector_len<T>(right_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(right_values, i), cmp)
  }
  out
}

fn sorted_set_intersection<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> i64) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len<T>(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 1 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}

fn sorted_set_difference<T>(left: SortedSet<T>, right: SortedSet<T>, cmp: (T, T) -> i64) -> SortedSet<T> {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len<T>(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 0 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}
