-- stdlib/sorted_set.weft — vector-backed sorted sets
--
-- Sets are implemented as sorted maps from element to unit marker, sharing the
-- same comparator-driven ordering and deterministic iteration behavior.

use "stdlib/sorted_map.weft"
use "stdlib/vector.weft"

fn sorted_set_new<T>() -> i64 {
  sorted_map_new<T, i64>()
}

fn sorted_set_len(set: i64) -> i64 { sorted_map_len(set) }
fn sorted_set_is_empty(set: i64) -> i64 { sorted_map_is_empty(set) }

fn sorted_set_insert<T>(set: i64, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_put<T, i64>(set, value, 1, cmp)
}

fn sorted_set_remove<T>(set: i64, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_remove<T, i64>(set, value, cmp)
}

fn sorted_set_contains<T>(set: i64, value: T, cmp: (T, T) -> i64) -> i64 {
  sorted_map_contains<T, i64>(set, value, cmp)
}

fn sorted_set_values<T>(set: i64) -> i64 {
  sorted_map_keys<T, i64>(set)
}

fn sorted_set_vector_value_at<T>(values: i64, index: i64) -> T {
  vector_get_in_bounds<T>(values, index)
}

fn sorted_set_union<T>(left: i64, right: i64, cmp: (T, T) -> i64) -> i64 {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  let right_values = sorted_set_values<T>(right)
  for i in 0..vector_len(left_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(left_values, i), cmp)
  }
  for i in 0..vector_len(right_values) {
    sorted_set_insert<T>(out, sorted_set_vector_value_at<T>(right_values, i), cmp)
  }
  out
}

fn sorted_set_intersection<T>(left: i64, right: i64, cmp: (T, T) -> i64) -> i64 {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 1 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}

fn sorted_set_difference<T>(left: i64, right: i64, cmp: (T, T) -> i64) -> i64 {
  let out = sorted_set_new<T>()
  let left_values = sorted_set_values<T>(left)
  for i in 0..vector_len(left_values) {
    let value = sorted_set_vector_value_at<T>(left_values, i)
    if sorted_set_contains<T>(right, value, cmp) == 0 {
      sorted_set_insert<T>(out, value, cmp)
    } else { 0 }
  }
  out
}
