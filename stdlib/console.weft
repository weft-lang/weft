-- stdlib/console.weft — non-owning standard-stream capabilities

use stdlib/bytes.{Bytes, bytes_from_str, bytes_to_utf8}
use stdlib/io/types.{IoError, IoTextError, IoTextInvalidUtf8, IoTextIo}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/string.{str_concat}

--- A non-owning standard output stream.
pub type ConsoleStream {
  --- Process standard output.
  ConsoleStdout,
  --- Process standard error.
  ConsoleStderr
}

--- Capability for bounded reads from standard input.
pub effect ConsoleRead {
  --- Read at most `limit` bytes from standard input.
  fn read(limit: usize) -> Result<Bytes, IoError>
}

--- Capability for complete writes and flushing of standard output streams.
pub effect ConsoleWrite {
  --- Write all bytes to `stream`.
  fn write_all(stream: ConsoleStream, values: Bytes) -> Result<usize, IoError>
  --- Flush buffered bytes for `stream`.
  fn flush(stream: ConsoleStream) -> Result<nil, IoError>
}

--- Read at most `limit` raw bytes from standard input.
pub fn read_bytes(limit: usize) -[ConsoleRead]> Result<Bytes, IoError> {
  ConsoleRead.read(limit)
}

--- Write all raw bytes to a selected standard output stream.
pub fn write_bytes(stream: ConsoleStream, values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(stream, values)
}

--- Write all raw bytes to standard output.
pub fn write_stdout(values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(ConsoleStdout, values)
}

--- Write all raw bytes to standard error.
pub fn write_stderr(values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(ConsoleStderr, values)
}

--- Flush a selected standard output stream.
pub fn flush(stream: ConsoleStream) -[ConsoleWrite]> Result<nil, IoError> {
  ConsoleWrite.flush(stream)
}

--- Read and validate at most `limit` bytes as UTF-8 text.
pub fn read(limit: usize) -[ConsoleRead]> Result<str, IoTextError> {
  match read_bytes(limit) {
    Err(error) -> result_err<str, IoTextError>(IoTextIo(error))
    Ok(values) -> match bytes_to_utf8(values) {
      Err(error) -> result_err<str, IoTextError>(IoTextInvalidUtf8(error))
      Ok(text) -> result_ok<str, IoTextError>(text)
    }
  }
}

--- Encode UTF-8 text and write it to a selected standard output stream.
pub fn write(stream: ConsoleStream, text: str) -[ConsoleWrite]> Result<usize, IoError> {
  write_bytes(stream, bytes_from_str(text))
}

--- Try to write text to standard output, preserving transport failure.
pub fn try_print(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  write(ConsoleStdout, text)
}

--- Try to write text to standard error, preserving transport failure.
pub fn try_eprint(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  write(ConsoleStderr, text)
}

--- Try to write text followed by a newline to standard output.
pub fn try_println(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  write(ConsoleStdout, str_concat(text, "\n"))
}

--- Try to write text followed by a newline to standard error.
pub fn try_eprintln(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  write(ConsoleStderr, str_concat(text, "\n"))
}

fn console_output_or_panic(result: Result<usize, IoError>) -> nil {
  match result {
    Ok(count) -> nil
    Err(error) -> panic("console output failed")
  }
}

--- Write text to standard output; panic if the terminal rejects the write.
pub fn print(text: str) -[ConsoleWrite]> nil {
  console_output_or_panic(try_print(text))
}

--- Write text to standard error; panic if the terminal rejects the write.
pub fn eprint(text: str) -[ConsoleWrite]> nil {
  console_output_or_panic(try_eprint(text))
}

--- Write text followed by a newline; panic if the terminal rejects the write.
pub fn println(text: str) -[ConsoleWrite]> nil {
  console_output_or_panic(try_println(text))
}

--- Write text plus a newline to stderr; panic if the terminal rejects the write.
pub fn eprintln(text: str) -[ConsoleWrite]> nil {
  console_output_or_panic(try_eprintln(text))
}
