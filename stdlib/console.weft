-- stdlib/console.weft — non-owning standard-stream capabilities

use stdlib/bytes.{Bytes, bytes_from_str, bytes_to_utf8}
use stdlib/io_types.{IoError, IoTextError, IoTextInvalidUtf8, IoTextIo}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}

pub type ConsoleStream {
  ConsoleStdout,
  ConsoleStderr
}

pub effect ConsoleRead {
  fn read(limit: usize) -> Result<Bytes, IoError>
}

pub effect ConsoleWrite {
  fn write_all(stream: ConsoleStream, values: Bytes) -> Result<usize, IoError>
  fn flush(stream: ConsoleStream) -> Result<nil, IoError>
}

pub fn console_read(limit: usize) -[ConsoleRead]> Result<Bytes, IoError> {
  ConsoleRead.read(limit)
}

pub fn console_write(stream: ConsoleStream, values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(stream, values)
}

pub fn console_print(values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(ConsoleStdout, values)
}

pub fn console_eprint(values: Bytes) -[ConsoleWrite]> Result<usize, IoError> {
  ConsoleWrite.write_all(ConsoleStderr, values)
}

pub fn console_flush(stream: ConsoleStream) -[ConsoleWrite]> Result<nil, IoError> {
  ConsoleWrite.flush(stream)
}

pub fn console_read_text(limit: usize) -[ConsoleRead]> Result<str, IoTextError> {
  match console_read(limit) {
    Err(error) -> result_err<str, IoTextError>(IoTextIo(error))
    Ok(values) -> match bytes_to_utf8(values) {
      Err(error) -> result_err<str, IoTextError>(IoTextInvalidUtf8(error))
      Ok(text) -> result_ok<str, IoTextError>(text)
    }
  }
}

pub fn console_write_text(stream: ConsoleStream, text: str) -[ConsoleWrite]> Result<usize, IoError> {
  console_write(stream, bytes_from_str(text))
}

pub fn console_print_text(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  console_print(bytes_from_str(text))
}

pub fn console_eprint_text(text: str) -[ConsoleWrite]> Result<usize, IoError> {
  console_eprint(bytes_from_str(text))
}

pub fn console_stream_kind(stream: ConsoleStream) -> i64 {
  match stream {
    ConsoleStdout -> 1
    ConsoleStderr -> 2
  }
}
