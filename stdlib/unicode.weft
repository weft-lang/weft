  let mut i = 1
  while scalar_count >= 0 and i <= scalar_count {
    if unicode_word_break_at_scalars(scalars, scalar_count, i) == 1 { count = count + 1 } else { 0 }
    i = i + 1
  }
  let result = if scalar_count < 0 { 0 - 1 } else { count }
  alloc_bump_restore_same_segment(mark)
  result
}

--- Return whether a byte offset is a default UAX #29 sentence boundary.
pub fn unicode_is_sentence_boundary(text: str, byte_offset: i64) -> i64 {
  let n = runtime_str_len(text)
  if byte_offset < 0 or byte_offset > n { 0 }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let offsets = alloc_words(n + 2)
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { 0 - 1 } else { unicode_segmentation_scalar_index_at_offset(offsets, count, byte_offset) }
    let result = if index < 0 { 0 } else { unicode_sentence_break_at_scalars(scalars, count, index) }
    alloc_bump_restore_same_segment(mark)
    result
