-- stdlib/unicode.weft — deterministic Unicode text algorithms
--
-- `str` is already an immutable UTF-8 text value. This module adds the
-- table-driven semantics that sit above byte/scalar transport. All data is
-- pinned to one Unicode version; the default algorithms are locale-neutral.

use compiler/unicode_normalization_data.{unicode_canonical_combining_class, unicode_canonical_compose, unicode_canonical_decompose_into, unicode_canonical_order, unicode_normalization_data_version}
use compiler/unicode_identifier_data.{unicode_default_ignorable, unicode_xid_continue, unicode_xid_start}
use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment, alloc_words}
use runtime/memory.{mem_load64_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_byte_at, runtime_str_eq, runtime_str_len, runtime_str_ptr}
use stdlib/unicode_compatibility_data.{unicode_compatibility_decompose_into, unicode_compatibility_max_expansion}
use stdlib/unicode_property_data.{*}
use stdlib/utf8.{utf8_decode_is_ok, utf8_decode_next, utf8_decode_next_pos, utf8_decode_scalar, utf8_encode_scalar_into, utf8_encode_scalar_len}

pub fn unicode_version() -> str {
  unicode_normalization_data_version()
}

pub fn unicode_general_category(scalar: i64) -> str {
  unicode_general_category_name(unicode_general_category_code(scalar))
}

pub fn unicode_script(scalar: i64) -> str {
  unicode_script_name(unicode_script_code(scalar))
}

pub fn unicode_combining_class(scalar: i64) -> i64 {
  unicode_canonical_combining_class(scalar)
}

pub(package) fn unicode_has_binary_property(scalar: i64, bit: i64) -> i64 {
  if (unicode_binary_property_mask(scalar) band bit) != 0 { 1 } else { 0 }
}

pub fn unicode_is_alphabetic(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_alphabetic_bit())
}

pub fn unicode_is_lowercase(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_lowercase_bit())
}

pub fn unicode_is_uppercase(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_uppercase_bit())
}

pub fn unicode_is_cased(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_cased_bit())
}

pub fn unicode_is_case_ignorable(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_case_ignorable_bit())
}

pub fn unicode_is_grapheme_base(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_grapheme_base_bit())
}

pub fn unicode_is_grapheme_extend(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_grapheme_extend_bit())
}

pub fn unicode_is_grapheme_link(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_grapheme_link_bit())
}

pub fn unicode_is_white_space(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_white_space_bit())
}

pub fn unicode_is_pattern_white_space(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_pattern_white_space_bit())
}

pub fn unicode_is_pattern_syntax(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_pattern_syntax_bit())
}

pub fn unicode_is_join_control(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_join_control_bit())
}

pub fn unicode_is_regional_indicator(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_regional_indicator_bit())
}

pub fn unicode_is_prepended_concatenation_mark(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_prepended_concatenation_mark_bit())
}

pub fn unicode_is_variation_selector(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_variation_selector_bit())
}

pub fn unicode_is_noncharacter(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_noncharacter_code_point_bit())
}

pub fn unicode_is_bidi_control(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_bidi_control_bit())
}

pub fn unicode_is_soft_dotted(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_soft_dotted_bit())
}

pub fn unicode_is_extended_pictographic(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_extended_pictographic_bit())
}

pub fn unicode_is_xid_start(scalar: i64) -> i64 {
  unicode_xid_start(scalar)
}

pub fn unicode_is_xid_continue(scalar: i64) -> i64 {
  unicode_xid_continue(scalar)
}

pub fn unicode_is_default_ignorable(scalar: i64) -> i64 {
  unicode_default_ignorable(scalar)
}

pub fn unicode_text_is_ascii(text: str) -> i64 {
  let n = runtime_str_len(text)
  let mut i = 0
  let mut ascii = 1
  while i < n and ascii == 1 {
    if runtime_str_byte_at(text, i) > 127 { ascii = 0 } else { i = i + 1 }
  }
  ascii
}

-- `compatibility` selects NFKD/NFKC decomposition; `compose` selects the C
-- forms. A forged malformed `str` produces the empty string defensively;
-- ordinary safe code cannot construct one because `str` is valid UTF-8.
pub(package) fn unicode_normalize_impl(text: str, compatibility: i64, compose: i64) -> str {
  if unicode_text_is_ascii(text) == 1 { text }
  else {
    let mark = alloc_bump_mark()
    let n = runtime_str_len(text)
    let decomposed = alloc_words(n * unicode_compatibility_max_expansion() + 4)
    let mut count = 0
    let mut pos = 0
    let mut valid = 1
    while pos < n and valid == 1 {
      let decoded = utf8_decode_next(text, pos)
      if utf8_decode_is_ok(decoded) == 0 {
        valid = 0
      } else {
        let scalar = utf8_decode_scalar(decoded)
        count = if compatibility == 1 {
          unicode_compatibility_decompose_into(scalar, decomposed, count)
        } else {
          unicode_canonical_decompose_into(scalar, decomposed, count)
        }
        pos = utf8_decode_next_pos(decoded)
      }
    }
    if valid == 0 or pos != n {
      alloc_bump_restore_same_segment(mark)
      ""
    } else {
      unicode_canonical_order(decomposed, count)
      let composed = alloc_words(count + 1)
      let mut normalized = decomposed
      let mut normalized_count = count
      if compose == 1 {
        normalized_count = unicode_canonical_compose(decomposed, count, composed)
        normalized = composed
      } else { 0 }

      let mut out_len = 0
      let mut i = 0
      while i < normalized_count {
        out_len = out_len + utf8_encode_scalar_len(mem_load64_at(normalized, i * 8))
        i = i + 1
      }
      let out = runtime_str_alloc_uninit(out_len)
      let out_ptr = runtime_str_ptr(out)
      let mut out_pos = 0
      i = 0
      while i < normalized_count {
        out_pos = utf8_encode_scalar_into(out_ptr, out_pos, mem_load64_at(normalized, i * 8))
        i = i + 1
      }
      alloc_bump_restore_same_segment(mark)
      out
    }
  }
}

pub fn unicode_normalize_nfc(text: str) -> str {
  unicode_normalize_impl(text, 0, 1)
}

pub fn unicode_normalize_nfd(text: str) -> str {
  unicode_normalize_impl(text, 0, 0)
}

pub fn unicode_normalize_nfkc(text: str) -> str {
  unicode_normalize_impl(text, 1, 1)
}

pub fn unicode_normalize_nfkd(text: str) -> str {
  unicode_normalize_impl(text, 1, 0)
}

pub fn unicode_is_normalized_nfc(text: str) -> i64 {
  runtime_str_eq(text, unicode_normalize_nfc(text))
}

pub fn unicode_is_normalized_nfd(text: str) -> i64 {
  runtime_str_eq(text, unicode_normalize_nfd(text))
}

pub fn unicode_is_normalized_nfkc(text: str) -> i64 {
  runtime_str_eq(text, unicode_normalize_nfkc(text))
}

pub fn unicode_is_normalized_nfkd(text: str) -> i64 {
  runtime_str_eq(text, unicode_normalize_nfkd(text))
}
