}

--- Return whether two identifiers have the same UTS #39 skeleton.
pub fn unicode_identifiers_are_confusable(a: str, b: str) -> i64 {
  unicode_security_are_confusable(a, b)
}

pub(package) fn unicode_case_mode_upper() -> i64 { 1 }
pub(package) fn unicode_case_mode_lower() -> i64 { 2 }
pub(package) fn unicode_case_mode_title() -> i64 { 3 }
pub(package) fn unicode_case_mode_fold() -> i64 { 4 }

pub(package) fn unicode_case_map_into(scalar: i64, out: i64, mode: i64, final_sigma: i64) -> i64 {
  if final_sigma == 1 {
    mem_store64_at(out, 0, 962)
    1
  } else {
    let next = if mode == unicode_case_mode_upper() { unicode_full_uppercase_map_into(scalar, out, 0) }
      else { if mode == unicode_case_mode_lower() { unicode_full_lowercase_map_into(scalar, out, 0) }
      else { if mode == unicode_case_mode_title() { unicode_full_titlecase_map_into(scalar, out, 0) }
      else { unicode_full_casefold_map_into(scalar, out, 0) } } }
    if next < 0 {
      mem_store64_at(out, 0, scalar)
      1
    } else { next }
  }
}

pub(package) fn unicode_case_encode_mapping(scalar: i64, mode: i64) -> str {
  if utf8_scalar_is_valid(scalar) == 0 { "" }
  else {
    let mark = alloc_bump_mark()
    let mapped = alloc_words(unicode_case_max_expansion() + 1)
    let count = unicode_case_map_into(scalar, mapped, mode, 0)
    let mut out_len = 0
    let mut i = 0
    while i < count {
      out_len = out_len + utf8_encode_scalar_len(mem_load64_at(mapped, i * 8))
      i = i + 1
    }
    let out = runtime_str_alloc_uninit(out_len)
    let out_ptr = runtime_str_ptr(out)
    let mut out_pos = 0
    i = 0
    while i < count {
      out_pos = utf8_encode_scalar_into(out_ptr, out_pos, mem_load64_at(mapped, i * 8))
      i = i + 1
    }
    alloc_bump_restore_same_segment(mark)
    out
  }
}

--- Return the full default uppercase mapping for one scalar.
pub fn unicode_uppercase_mapping(scalar: i64) -> str {
  unicode_case_encode_mapping(scalar, unicode_case_mode_upper())
}

--- Return the full default lowercase mapping for one scalar.
pub fn unicode_lowercase_mapping(scalar: i64) -> str {
  unicode_case_encode_mapping(scalar, unicode_case_mode_lower())
}

--- Return the full default titlecase mapping for one scalar.
pub fn unicode_titlecase_mapping(scalar: i64) -> str {
  unicode_case_encode_mapping(scalar, unicode_case_mode_title())
}

--- Return the full default case-fold mapping for one scalar.
pub fn unicode_casefold_mapping(scalar: i64) -> str {
  unicode_case_encode_mapping(scalar, unicode_case_mode_fold())
}

pub(package) fn unicode_case_decode_scalars(text: str, scalars: i64) -> i64 {
  let n = runtime_str_len(text)
  let mut count = 0
  let mut pos = 0
  let mut valid = 1
  while pos < n and valid == 1 {
    let decoded = utf8_decode_next(text, pos)
    if utf8_decode_is_ok(decoded) == 0 { valid = 0 }
    else {
      mem_store64_at(scalars, count * 8, utf8_decode_scalar(decoded))
      count = count + 1
      pos = utf8_decode_next_pos(decoded)
    }
  }
  if valid == 1 and pos == n { count } else { 0 - 1 }
}

-- The only locale-neutral contextual SpecialCasing rule in Unicode 17 is
-- Final_Sigma: cased before and no cased after, skipping Case_Ignorable.
pub(package) fn unicode_case_following_cased(scalars: i64, count: i64, following: i64) -> i64 {
  let mut next_cased = 0
  let mut i = count - 1
  while i >= 0 {
    mem_store64_at(following, i * 8, next_cased)
    let scalar = mem_load64_at(scalars, i * 8)
    if unicode_is_case_ignorable(scalar) == 0 { next_cased = unicode_is_cased(scalar) } else { 0 }
    i = i - 1
  }
  0
}

pub(package) fn unicode_case_mapping_is_final_sigma(scalar: i64, mode: i64, preceding_cased: i64, following_cased: i64) -> i64 {
  if mode == unicode_case_mode_lower() and scalar == 931 and preceding_cased == 1 and following_cased == 0 { 1 } else { 0 }
}

pub(package) fn unicode_titlecase_modes(scalars: i64, count: i64, modes: i64) -> i64 {
  let mut saw_cased = 0
  let mut i = 0
  while i < count {
    if unicode_word_break_at_scalars(scalars, count, i) == 1 { saw_cased = 0 } else { 0 }
    let scalar = mem_load64_at(scalars, i * 8)
    let mut mode = 0
    if saw_cased == 0 {
      if unicode_is_cased(scalar) == 1 {
        mode = unicode_case_mode_title()
        saw_cased = 1
      } else { 0 }
    } else { mode = unicode_case_mode_lower() }
    mem_store64_at(modes, i * 8, mode)
    i = i + 1
  }
  0
}

pub(package) fn unicode_titlecase_map_into(scalar: i64, mode: i64, out: i64, preceding_cased: i64, following_cased: i64) -> i64 {
  if mode == 0 {
    mem_store64_at(out, 0, scalar)
    1
  } else {
    let final_sigma = unicode_case_mapping_is_final_sigma(scalar, mode, preceding_cased, following_cased)
    unicode_case_map_into(scalar, out, mode, final_sigma)
  }
}

pub(package) fn unicode_case_map_text(text: str, mode: i64) -> str {
  let n = runtime_str_len(text)
  if n == 0 { text }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let count = unicode_case_decode_scalars(text, scalars)
    if count < 0 {
      alloc_bump_restore_same_segment(mark)
      ""
    } else {
      let following = alloc_words(count + 1)
      unicode_case_following_cased(scalars, count, following)
      let mapped = alloc_words(unicode_case_max_expansion() + 1)
      let mut preceding_cased = 0
      let mut out_len = 0
      let mut i = 0
      while i < count {
        let scalar = mem_load64_at(scalars, i * 8)
        let final_sigma = unicode_case_mapping_is_final_sigma(scalar, mode, preceding_cased, mem_load64_at(following, i * 8))
        let mapped_count = unicode_case_map_into(scalar, mapped, mode, final_sigma)
        let mut j = 0
        while j < mapped_count {
          out_len = out_len + utf8_encode_scalar_len(mem_load64_at(mapped, j * 8))
          j = j + 1
        }
        if unicode_is_case_ignorable(scalar) == 0 { preceding_cased = unicode_is_cased(scalar) } else { 0 }
        i = i + 1
      }

      let out = runtime_str_alloc_uninit(out_len)
      let out_ptr = runtime_str_ptr(out)
      let mut out_pos = 0
      preceding_cased = 0
      i = 0
      while i < count {
        let scalar = mem_load64_at(scalars, i * 8)
        let final_sigma = unicode_case_mapping_is_final_sigma(scalar, mode, preceding_cased, mem_load64_at(following, i * 8))
        let mapped_count = unicode_case_map_into(scalar, mapped, mode, final_sigma)
        let mut j = 0
        while j < mapped_count {
          out_pos = utf8_encode_scalar_into(out_ptr, out_pos, mem_load64_at(mapped, j * 8))
          j = j + 1
        }
        if unicode_is_case_ignorable(scalar) == 0 { preceding_cased = unicode_is_cased(scalar) } else { 0 }
        i = i + 1
      }
      alloc_bump_restore_same_segment(mark)
      out
    }
  }
}

--- Apply locale-neutral full uppercase mapping to complete text.
pub fn unicode_to_uppercase(text: str) -> str {
  unicode_case_map_text(text, unicode_case_mode_upper())
}

--- Apply locale-neutral full lowercase mapping to complete text.
pub fn unicode_to_lowercase(text: str) -> str {
  unicode_case_map_text(text, unicode_case_mode_lower())
}

-- Unicode 17 default toTitlecase (Core Specification R3): segment with the
-- default UAX #29 word rules, titlecase the first cased scalar in each segment,
-- and lowercase the remainder. Locale/CLDR tailoring is deliberately absent.
--- Apply locale-neutral default titlecasing using UAX #29 word boundaries.
pub fn unicode_to_titlecase(text: str) -> str {
  let n = runtime_str_len(text)
  if n == 0 { text }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let offsets = alloc_words(n + 2)
    let count = unicode_segmentation_decode(text, scalars, offsets)
    if count < 0 {
      alloc_bump_restore_same_segment(mark)
      ""
    } else {
      let modes = alloc_words(count + 1)
      let following = alloc_words(count + 1)
      let mapped = alloc_words(unicode_case_max_expansion() + 1)
      unicode_titlecase_modes(scalars, count, modes)
      unicode_case_following_cased(scalars, count, following)

      let mut preceding_cased = 0
      let mut out_len = 0
      let mut i = 0
      while i < count {
        let scalar = mem_load64_at(scalars, i * 8)
        let mode = mem_load64_at(modes, i * 8)
        let mapped_count = unicode_titlecase_map_into(scalar, mode, mapped, preceding_cased, mem_load64_at(following, i * 8))
        let mut j = 0
        while j < mapped_count {
          out_len = out_len + utf8_encode_scalar_len(mem_load64_at(mapped, j * 8))
          j = j + 1
        }
        if unicode_is_case_ignorable(scalar) == 0 { preceding_cased = unicode_is_cased(scalar) } else { 0 }
        i = i + 1
      }

      let out = runtime_str_alloc_uninit(out_len)
      let out_ptr = runtime_str_ptr(out)
      let mut out_pos = 0
      preceding_cased = 0
      i = 0
      while i < count {
        let scalar = mem_load64_at(scalars, i * 8)
        let mode = mem_load64_at(modes, i * 8)
        let mapped_count = unicode_titlecase_map_into(scalar, mode, mapped, preceding_cased, mem_load64_at(following, i * 8))
        let mut j = 0
        while j < mapped_count {
          out_pos = utf8_encode_scalar_into(out_ptr, out_pos, mem_load64_at(mapped, j * 8))
          j = j + 1
        }
        if unicode_is_case_ignorable(scalar) == 0 { preceding_cased = unicode_is_cased(scalar) } else { 0 }
        i = i + 1
      }
      alloc_bump_restore_same_segment(mark)
      out
    }
  }
}

--- Apply full default case folding to complete text.
pub fn unicode_casefold(text: str) -> str {
  unicode_case_map_text(text, unicode_case_mode_fold())
}

--- Compare text using Unicode canonical caseless matching.
pub fn unicode_caseless_equal(a: str, b: str) -> i64 {
  if utf8_validate(a) == 0 or utf8_validate(b) == 0 { 0 }
  else {
    let folded_a = unicode_normalize_nfd(unicode_casefold(unicode_normalize_nfd(a)))
    let folded_b = unicode_normalize_nfd(unicode_casefold(unicode_normalize_nfd(b)))
    runtime_str_eq(folded_a, folded_b)
  }
}

--- Return whether a byte offset is an extended grapheme-cluster boundary.
pub fn unicode_is_grapheme_boundary(text: str, byte_offset: i64) -> i64 {
  let n = runtime_str_len(text)
  if byte_offset < 0 or byte_offset > n { 0 }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let offsets = alloc_words(n + 2)
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { 0 - 1 } else { unicode_segmentation_scalar_index_at_offset(offsets, count, byte_offset) }
    let result = if index < 0 { 0 } else { unicode_grapheme_break_at_scalars(scalars, count, index) }
    alloc_bump_restore_same_segment(mark)
    result
  }
}

-- Return the first extended grapheme boundary strictly after `byte_offset`.
-- The end offset is stable at end-of-text; invalid UTF-8 or a non-scalar input
-- offset returns -1.
--- Return the next extended grapheme boundary byte offset, or `-1` if invalid.
pub fn unicode_next_grapheme_boundary(text: str, byte_offset: i64) -> i64 {
  let n = runtime_str_len(text)
  if byte_offset < 0 or byte_offset > n { 0 - 1 }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let offsets = alloc_words(n + 2)
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { 0 - 1 } else { unicode_segmentation_scalar_index_at_offset(offsets, count, byte_offset) }
    let mut next = index + 1
    while index >= 0 and next <= count and unicode_grapheme_break_at_scalars(scalars, count, next) == 0 { next = next + 1 }
    let result = if index < 0 { 0 - 1 }
      else { if index == count { n }
      else { mem_load64_at(offsets, next * 8) } }
    alloc_bump_restore_same_segment(mark)
    result
  }
}

--- Count extended grapheme clusters, or return `-1` for invalid text.
pub fn unicode_grapheme_count(text: str) -> i64 {
  let n = runtime_str_len(text)
  let mark = alloc_bump_mark()
  let scalars = alloc_words(n + 1)
  let offsets = alloc_words(n + 2)
  let scalar_count = unicode_segmentation_decode(text, scalars, offsets)
  let mut count = 0
  let mut i = 1
  while scalar_count >= 0 and i <= scalar_count {
    if unicode_grapheme_break_at_scalars(scalars, scalar_count, i) == 1 { count = count + 1 } else { 0 }
    i = i + 1
  }
  let result = if scalar_count < 0 { 0 - 1 } else { count }
  alloc_bump_restore_same_segment(mark)
  result
}

--- Return whether a byte offset is a default UAX #29 word boundary.
pub fn unicode_is_word_boundary(text: str, byte_offset: i64) -> i64 {
  let n = runtime_str_len(text)
  if byte_offset < 0 or byte_offset > n { 0 }
  else {
    let mark = alloc_bump_mark()
    let scalars = alloc_words(n + 1)
    let offsets = alloc_words(n + 2)
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { 0 - 1 } else { unicode_segmentation_scalar_index_at_offset(offsets, count, byte_offset) }
    let result = if index < 0 { 0 } else { unicode_word_break_at_scalars(scalars, count, index) }
    alloc_bump_restore_same_segment(mark)
    result
  }
}

--- Return the next default word-boundary byte offset, or `-1` if invalid.
pub fn unicode_next_word_boundary(text: str, byte_offset: i64) -> i64 {
  let n = runtime_str_len(text)
