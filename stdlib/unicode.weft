-- stdlib/unicode.weft — deterministic Unicode text algorithms
--
-- `str` is already an immutable UTF-8 text value. This module adds the
-- table-driven semantics that sit above byte/scalar transport. All data is
-- pinned to one Unicode version; the default algorithms are locale-neutral.

use compiler/weft/unicode/normalization_data.{
  unicode_canonical_combining_class,
  unicode_canonical_compose,
  unicode_canonical_decompose_push,
  unicode_canonical_order,
  unicode_normalization_data_version
}
use compiler/weft/unicode/identifier_data.{
  unicode_default_ignorable,
  unicode_xid_continue,
  unicode_xid_start
}
use runtime/string.{
  runtime_str_byte_at,
  runtime_str_eq,
  runtime_str_len,
  runtime_str_utf8_decode
}
use runtime/utf8.{Utf8StorageMalformed, Utf8StorageScalar}
use stdlib/unicode/data/compatibility.{unicode_compatibility_decompose_push}
use stdlib/unicode/data/case.{
  unicode_full_casefold_push,
  unicode_full_lowercase_push,
  unicode_full_titlecase_push,
  unicode_full_uppercase_push
}
use stdlib/unicode/data/property.{*}
use stdlib/unicode/security.{
  unicode_security_are_confusable,
  unicode_security_is_mixed_script,
  unicode_security_skeleton
}
use stdlib/unicode/segmentation.{
  unicode_grapheme_break_at_scalars,
  unicode_segmentation_decode,
  unicode_segmentation_scalar_index_at_offset,
  unicode_sentence_break_at_scalars,
  unicode_word_break_at_scalars
}
use stdlib/option.{None, Option, Some}
use stdlib/num/scalar.{num_scalar_i64_to_usize}
use stdlib/panic.{panic}
use stdlib/utf8 as utf8
use stdlib/utf8.{utf8_scalar_vector_text}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_set}
use stdlib/vector/handles.{Vector}

--- Return the pinned Unicode data version used by every algorithm.
pub fn version() -> str {
  unicode_normalization_data_version()
}

--- Return the Unicode General_Category name for `scalar`.
pub fn general_category(scalar: i64) -> str {
  unicode_general_category_name(unicode_general_category_code(scalar))
}

--- Return the Unicode Script name for `scalar`.
pub fn script(scalar: i64) -> str {
  unicode_script_name(unicode_script_code(scalar))
}

--- Return the canonical combining class for `scalar`.
pub fn combining_class(scalar: i64) -> i64 {
  unicode_canonical_combining_class(scalar)
}

pub(package) fn unicode_has_binary_property(scalar: i64, bit: i64) -> bool {
  (unicode_binary_property_mask(scalar) band bit) != 0
}

--- Return whether `scalar` has the Alphabetic property.
pub fn is_alphabetic(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_alphabetic_bit())
}

--- Return whether `scalar` has the Lowercase property.
pub fn is_lowercase(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_lowercase_bit())
}

--- Return whether `scalar` has the Uppercase property.
pub fn is_uppercase(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_uppercase_bit())
}

--- Return whether `scalar` has the Cased property.
pub fn is_cased(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_cased_bit())
}

--- Return whether `scalar` has the Case_Ignorable property.
pub fn is_case_ignorable(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_case_ignorable_bit())
}

--- Return whether `scalar` has the Grapheme_Base property.
pub fn is_grapheme_base(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_grapheme_base_bit())
}

--- Return whether `scalar` has the Grapheme_Extend property.
pub fn is_grapheme_extend(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_grapheme_extend_bit())
}

--- Return whether `scalar` has the Grapheme_Link property.
pub fn is_grapheme_link(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_grapheme_link_bit())
}

--- Return whether `scalar` has the White_Space property.
pub fn is_white_space(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_white_space_bit())
}

--- Return whether `scalar` has the Pattern_White_Space property.
pub fn is_pattern_white_space(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_pattern_white_space_bit())
}

--- Return whether `scalar` has the Pattern_Syntax property.
pub fn is_pattern_syntax(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_pattern_syntax_bit())
}

--- Return whether `scalar` has the Join_Control property.
pub fn is_join_control(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_join_control_bit())
}

--- Return whether `scalar` has the Regional_Indicator property.
pub fn is_regional_indicator(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_regional_indicator_bit())
}

--- Return whether `scalar` is a prepended concatenation mark.
pub fn is_prepended_concatenation_mark(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_prepended_concatenation_mark_bit())
}

--- Return whether `scalar` has the Variation_Selector property.
pub fn is_variation_selector(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_variation_selector_bit())
}

--- Return whether `scalar` is a Unicode noncharacter code point.
pub fn is_noncharacter(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_noncharacter_code_point_bit())
}

--- Return whether `scalar` has the Bidi_Control property.
pub fn is_bidi_control(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_bidi_control_bit())
}

--- Return whether `scalar` has the Soft_Dotted property.
pub fn is_soft_dotted(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_soft_dotted_bit())
}

--- Return whether `scalar` has the Extended_Pictographic property.
pub fn is_extended_pictographic(scalar: i64) -> bool {
  unicode_has_binary_property(scalar, unicode_property_extended_pictographic_bit())
}

--- Return whether `scalar` may begin a Weft Unicode identifier.
pub fn is_xid_start(scalar: i64) -> bool {
  unicode_xid_start(scalar) == 1
}

--- Return whether `scalar` may continue a Weft Unicode identifier.
pub fn is_xid_continue(scalar: i64) -> bool {
  unicode_xid_continue(scalar) == 1
}

--- Return whether `scalar` is default-ignorable under the security profile.
pub fn is_default_ignorable(scalar: i64) -> bool {
  unicode_default_ignorable(scalar) == 1
}

--- Return whether identifier text mixes scripts under the UTS #39 policy.
pub fn identifier_is_mixed_script(text: str) -> bool {
  unicode_security_is_mixed_script(text) == 1
}

--- Compute the pinned UTS #39 confusable skeleton for identifier text.
pub fn identifier_skeleton(text: str) -> str {
  unicode_security_skeleton(text)
}

--- Return whether two identifiers have the same UTS #39 skeleton.
pub fn identifiers_are_confusable(a: str, b: str) -> bool {
  unicode_security_are_confusable(a, b) == 1
}

-- The default full mappings. Titlecasing chooses per scalar between the
-- titlecase and lowercase mappings, or leaves a scalar unmapped.
type UnicodeCaseMode {
  UnicodeUpper,
  UnicodeLower,
  UnicodeTitle,
  UnicodeFold
}

-- Push the full `mode` mapping of `scalar` onto `out`. Final_Sigma
-- lowercases a capital sigma to its word-final form instead.
fn unicode_case_push(
  scalar: i64,
  mode: UnicodeCaseMode,
  final_sigma: bool,
  out: borrow mut Vector<i64>
) -> nil {
  if final_sigma { out.push(962) }
  else {
    let mapped = match mode {
      UnicodeUpper -> unicode_full_uppercase_push(scalar, out)
      UnicodeLower -> unicode_full_lowercase_push(scalar, out)
      UnicodeTitle -> unicode_full_titlecase_push(scalar, out)
      UnicodeFold -> unicode_full_casefold_push(scalar, out)
    }
    if mapped { nil } else { out.push(scalar) }
  }
}

fn unicode_case_encode_mapping(scalar: i64, mode: UnicodeCaseMode) -> str {
  let mut mapped = vector.new<i64>()
  unicode_case_push(scalar, mode, false, mapped)
  utf8_scalar_vector_text(mapped)
}

--- Return the full default uppercase mapping for one scalar.
pub fn uppercase_mapping(scalar: i64) -> Option<str> {
  if utf8.is_scalar(scalar) { Some<str>(unicode_case_encode_mapping(scalar, UnicodeUpper)) }
  else { None<str>() }
}

--- Return the full default lowercase mapping for one scalar.
pub fn lowercase_mapping(scalar: i64) -> Option<str> {
  if utf8.is_scalar(scalar) { Some<str>(unicode_case_encode_mapping(scalar, UnicodeLower)) }
  else { None<str>() }
}

--- Return the full default titlecase mapping for one scalar.
pub fn titlecase_mapping(scalar: i64) -> Option<str> {
  if utf8.is_scalar(scalar) { Some<str>(unicode_case_encode_mapping(scalar, UnicodeTitle)) }
  else { None<str>() }
}

--- Return the full default case-fold mapping for one scalar.
pub fn casefold_mapping(scalar: i64) -> Option<str> {
  if utf8.is_scalar(scalar) { Some<str>(unicode_case_encode_mapping(scalar, UnicodeFold)) }
  else { None<str>() }
}

-- Decode `text` into `scalars`, reporting whether it was well-formed.
fn unicode_case_decode_scalars(text: str, scalars: borrow mut Vector<i64>) -> bool {
  let n = runtime_str_len(text)
  let mut pos = 0
  let mut valid = true
  while pos < n and valid {
    match runtime_str_utf8_decode(text, pos) {
      Utf8StorageMalformed(offset) -> { valid = false }
      Utf8StorageScalar(next, scalar) -> {
        scalars.push(scalar)
        pos = next
      }
    }
  }
  valid and pos == n
}

-- The only locale-neutral contextual SpecialCasing rule in Unicode 17 is
-- Final_Sigma: cased before and no cased after, skipping Case_Ignorable.
-- Entry `i` records whether the next non-ignorable scalar after `i` is cased.
fn unicode_case_following_cased(scalars: borrow Vector<i64>) -> Vector<bool> {
  let count = vector_len<i64>(scalars)
  let mut following = vector.with_capacity<bool>(__i64_to_usize(count))
  for index in 0..count { following.push(false) }
  let mut next_cased = false
  let mut i = count - 1
  while i >= 0 {
    vector_set<bool>(following, i, next_cased)
    let scalar = vector_get_in_bounds<i64>(scalars, i)
    if not is_case_ignorable(scalar) { next_cased = is_cased(scalar) } else { nil }
    i = i - 1
  }
  following
}

fn unicode_case_is_final_sigma(
  scalar: i64,
  mode: UnicodeCaseMode,
  preceding_cased: bool,
  following_cased: bool
) -> bool {
  match mode {
    UnicodeLower -> scalar == 931 and preceding_cased and not following_cased
    _ -> false
  }
}

fn unicode_case_map_text(text: str, mode: UnicodeCaseMode) -> str {
  if runtime_str_len(text) == 0 { text }
  else {
    let mut scalars = vector.new<i64>()
    if not unicode_case_decode_scalars(text, scalars) { "" }
    else {
      let following = unicode_case_following_cased(scalars)
      let mut mapped = vector.new<i64>()
      let mut preceding_cased = false
      for i in 0..vector_len<i64>(scalars) {
        let scalar = vector_get_in_bounds<i64>(scalars, i)
        let final_sigma = unicode_case_is_final_sigma(
          scalar,
          mode,
          preceding_cased,
          vector_get_in_bounds<bool>(following, i)
        )
        unicode_case_push(scalar, mode, final_sigma, mapped)
        if not is_case_ignorable(scalar) { preceding_cased = is_cased(scalar) } else { nil }
      }
      utf8_scalar_vector_text(mapped)
    }
  }
}

--- Apply locale-neutral full uppercase mapping to complete text.
fn unicode_to_uppercase_impl(text: str) -> str {
  unicode_case_map_text(text, UnicodeUpper)
}

--- Apply locale-neutral full lowercase mapping to complete text.
fn unicode_to_lowercase_impl(text: str) -> str {
  unicode_case_map_text(text, UnicodeLower)
}

-- Unicode 17 default toTitlecase (Core Specification R3): segment with the
-- default UAX #29 word rules, titlecase the first cased scalar in each segment,
-- and lowercase the remainder. Locale/CLDR tailoring is deliberately absent.
--- Apply locale-neutral default titlecasing using UAX #29 word boundaries.
fn unicode_to_titlecase_impl(text: str) -> str {
  if runtime_str_len(text) == 0 { text }
  else {
    let mut scalars = vector.new<i64>()
    let mut offsets = vector.new<i64>()
    let count = unicode_segmentation_decode(text, scalars, offsets)
    if count < 0 { "" }
    else {
      let following = unicode_case_following_cased(scalars)
      let mut mapped = vector.new<i64>()
      let mut preceding_cased = false
      let mut saw_cased = false
      for i in 0..count {
        if unicode_word_break_at_scalars(scalars, count, i) == 1 { saw_cased = false } else {
          nil
        }
        let scalar = vector_get_in_bounds<i64>(scalars, i)
        if saw_cased {
          let final_sigma = unicode_case_is_final_sigma(
            scalar,
            UnicodeLower,
            preceding_cased,
            vector_get_in_bounds<bool>(following, i)
          )
          unicode_case_push(scalar, UnicodeLower, final_sigma, mapped)
        } else if is_cased(scalar) {
          saw_cased = true
          unicode_case_push(scalar, UnicodeTitle, false, mapped)
        } else { mapped.push(scalar) }
        if not is_case_ignorable(scalar) { preceding_cased = is_cased(scalar) } else { nil }
      }
      utf8_scalar_vector_text(mapped)
    }
  }
}

--- Apply full default case folding to complete text.
fn unicode_casefold_impl(text: str) -> str {
  unicode_case_map_text(text, UnicodeFold)
}

--- Compare text using Unicode canonical caseless matching.
fn unicode_caseless_equal_impl(a: str, b: str) -> bool {
  if not utf8.validate(a) or not utf8.validate(b) { false }
  else {
    let folded_a = unicode_normalize_nfd_impl(
      unicode_casefold_impl(unicode_normalize_nfd_impl(a))
    )
    let folded_b = unicode_normalize_nfd_impl(
      unicode_casefold_impl(unicode_normalize_nfd_impl(b))
    )
    runtime_str_eq(folded_a, folded_b) == 1
  }
}

-- Boundary policy is a scalar tag, not a callback or a second decoded buffer.
-- Every public boundary family shares bounds, decoding, and scratch lifetime.
type UnicodeBoundaryKind {
  GraphemeBoundary,
  WordBoundary,
  SentenceBoundary
}

fn unicode_break_at(
  kind: UnicodeBoundaryKind,
  scalars: borrow Vector<i64>,
  count: i64,
  index: i64
) -> bool {
  match kind {
    GraphemeBoundary -> unicode_grapheme_break_at_scalars(scalars, count, index) == 1
    WordBoundary -> unicode_word_break_at_scalars(scalars, count, index) == 1
    SentenceBoundary -> unicode_sentence_break_at_scalars(scalars, count, index) == 1
  }
}

fn unicode_finite_count(value: i64) -> usize {
  if value < 0 { panic("String UTF-8 invariant violated") }
  else { __i64_to_usize(value) }
}

fn unicode_is_boundary_impl(text: str, byte_offset: usize, kind: UnicodeBoundaryKind) -> bool {
  let n = runtime_str_len(text)
  if byte_offset > __i64_to_usize(n) { false }
  else {
    let offset = __u64_to_i64(__usize_to_u64(byte_offset))
    let mut scalars = vector.new<i64>()
    let mut offsets = vector.new<i64>()
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { - 1 } else {
      unicode_segmentation_scalar_index_at_offset(offsets, count, offset)
    }
    index >= 0 and unicode_break_at(kind, scalars, count, index)
  }
}

-- End-of-text is a stable boundary. Any other valid scalar offset advances
-- strictly; an out-of-range or mid-scalar offset has no next boundary.
fn unicode_next_boundary_impl(
  text: str,
  byte_offset: usize,
  kind: UnicodeBoundaryKind
) -> Option<usize> {
  let n = runtime_str_len(text)
  if byte_offset > __i64_to_usize(n) { None<usize>() }
  else {
    let offset = __u64_to_i64(__usize_to_u64(byte_offset))
    let mut scalars = vector.new<i64>()
    let mut offsets = vector.new<i64>()
    let count = unicode_segmentation_decode(text, scalars, offsets)
    let index = if count < 0 { - 1 } else {
      unicode_segmentation_scalar_index_at_offset(offsets, count, offset)
    }
    let mut next = index + 1
    while index >= 0 and next <= count and not unicode_break_at(kind, scalars, count, next) {
      next = next + 1
    }
    let result = match index {
      invalid if invalid < 0 -> - 1
      last if last == count -> n
      _ -> vector_get_in_bounds<i64>(offsets, next)
    }
    num_scalar_i64_to_usize(result)
  }
}

fn unicode_segment_count_impl(text: str, kind: UnicodeBoundaryKind) -> usize {
  let mut scalars = vector.new<i64>()
  let mut offsets = vector.new<i64>()
  let scalar_count = unicode_segmentation_decode(text, scalars, offsets)
  let mut count = 0
  for index in 1..(scalar_count + 1) {
    if unicode_break_at(kind, scalars, scalar_count, index) { count = count + 1 } else { nil }
  }
  unicode_finite_count(if scalar_count < 0 { - 1 } else { count })
}

--- Return whether every byte in valid text is ASCII.
fn unicode_text_is_ascii_impl(text: str) -> bool {
  let n = runtime_str_len(text)
  let mut i = 0
  let mut ascii = true
  while i < n and ascii {
    if runtime_str_byte_at(text, i) > 127 { ascii = false } else { i = i + 1 }
  }
  ascii
}

-- The four normalization forms: canonical or compatibility decomposition,
-- optionally followed by canonical composition.
type UnicodeNormalForm {
  UnicodeNfc,
  UnicodeNfd,
  UnicodeNfkc,
  UnicodeNfkd
}

-- A forged malformed `str` produces the empty string defensively; ordinary
-- safe code cannot construct one because `str` is valid UTF-8.
fn unicode_normalize_impl(text: str, form: UnicodeNormalForm) -> str {
  if unicode_text_is_ascii_impl(text) { text }
  else {
    let n = runtime_str_len(text)
    let mut decomposed = vector.new<i64>()
    let mut pos = 0
    let mut valid = true
    while pos < n and valid {
      match runtime_str_utf8_decode(text, pos) {
        Utf8StorageMalformed(offset) -> { valid = false }
        Utf8StorageScalar(next, scalar) -> {
          match form {
            UnicodeNfkc -> unicode_compatibility_decompose_push(scalar, decomposed)
            UnicodeNfkd -> unicode_compatibility_decompose_push(scalar, decomposed)
            _ -> unicode_canonical_decompose_push(scalar, decomposed)
          }
          pos = next
        }
      }
    }
    if not valid { "" }
    else {
      unicode_canonical_order(decomposed)
      match form {
        UnicodeNfc -> unicode_normalize_composed(decomposed)
        UnicodeNfkc -> unicode_normalize_composed(decomposed)
        _ -> utf8_scalar_vector_text(decomposed)
      }
    }
  }
}

fn unicode_normalize_composed(decomposed: borrow Vector<i64>) -> str {
  let mut composed = vector.new<i64>()
  unicode_canonical_compose(decomposed, composed)
  utf8_scalar_vector_text(composed)
}

--- Normalize text to canonical composition form NFC.
fn unicode_normalize_nfc_impl(text: str) -> str {
  unicode_normalize_impl(text, UnicodeNfc)
}

--- Normalize text to canonical decomposition form NFD.
fn unicode_normalize_nfd_impl(text: str) -> str {
  unicode_normalize_impl(text, UnicodeNfd)
}

--- Normalize text to compatibility composition form NFKC.
fn unicode_normalize_nfkc_impl(text: str) -> str {
  unicode_normalize_impl(text, UnicodeNfkc)
}

--- Normalize text to compatibility decomposition form NFKD.
fn unicode_normalize_nfkd_impl(text: str) -> str {
  unicode_normalize_impl(text, UnicodeNfkd)
}

--- Return whether text is already normalized to NFC.
fn unicode_is_normalized_nfc_impl(text: str) -> bool {
  runtime_str_eq(text, unicode_normalize_nfc_impl(text)) == 1
}

--- Return whether text is already normalized to NFD.
fn unicode_is_normalized_nfd_impl(text: str) -> bool {
  runtime_str_eq(text, unicode_normalize_nfd_impl(text)) == 1
}

--- Return whether text is already normalized to NFKC.
fn unicode_is_normalized_nfkc_impl(text: str) -> bool {
  runtime_str_eq(text, unicode_normalize_nfkc_impl(text)) == 1
}

--- Return whether text is already normalized to NFKD.
fn unicode_is_normalized_nfkd_impl(text: str) -> bool {
  runtime_str_eq(text, unicode_normalize_nfkd_impl(text)) == 1
}

impl str {
  --- Apply locale-neutral full uppercase mapping.
  pub fn to_uppercase(self: str) -> str { unicode_to_uppercase_impl(self) }

  --- Apply locale-neutral full lowercase mapping.
  pub fn to_lowercase(self: str) -> str { unicode_to_lowercase_impl(self) }

  --- Apply locale-neutral default titlecasing using UAX #29 word boundaries.
  pub fn to_titlecase(self: str) -> str { unicode_to_titlecase_impl(self) }

  --- Apply full default Unicode case folding.
  pub fn casefold(self: str) -> str { unicode_casefold_impl(self) }

  --- Compare with `other` using Unicode canonical caseless matching.
  pub fn caseless_eq(self: str, other: str) -> bool { unicode_caseless_equal_impl(self, other) }

  --- Return whether `byte_offset` is an extended grapheme-cluster boundary.
  pub fn is_grapheme_boundary(self: str, byte_offset: usize) -> bool {
    unicode_is_boundary_impl(self, byte_offset, GraphemeBoundary)
  }

  --- Return the next extended grapheme boundary after `byte_offset`.
  --- End-of-text stays at end; out-of-range and mid-scalar offsets return `None`.
  pub fn next_grapheme_boundary(self: str, byte_offset: usize) -> Option<usize> {
    unicode_next_boundary_impl(self, byte_offset, GraphemeBoundary)
  }

  --- Count extended grapheme clusters.
  pub fn grapheme_count(self: str) -> usize { unicode_segment_count_impl(self, GraphemeBoundary) }

  --- Return whether `byte_offset` is a default UAX #29 word boundary.
  pub fn is_word_boundary(self: str, byte_offset: usize) -> bool {
    unicode_is_boundary_impl(self, byte_offset, WordBoundary)
  }

  --- Return the next default word boundary after `byte_offset`.
  --- End-of-text stays at end; out-of-range and mid-scalar offsets return `None`.
  pub fn next_word_boundary(self: str, byte_offset: usize) -> Option<usize> {
    unicode_next_boundary_impl(self, byte_offset, WordBoundary)
  }

  --- Count default UAX #29 word segments.
  pub fn word_segment_count(self: str) -> usize { unicode_segment_count_impl(self, WordBoundary) }

  --- Return whether `byte_offset` is a default UAX #29 sentence boundary.
  pub fn is_sentence_boundary(self: str, byte_offset: usize) -> bool {
    unicode_is_boundary_impl(self, byte_offset, SentenceBoundary)
  }

  --- Return the next default sentence boundary after `byte_offset`.
  --- End-of-text stays at end; out-of-range and mid-scalar offsets return `None`.
  pub fn next_sentence_boundary(self: str, byte_offset: usize) -> Option<usize> {
    unicode_next_boundary_impl(self, byte_offset, SentenceBoundary)
  }

  --- Count default UAX #29 sentence segments.
  pub fn sentence_segment_count(self: str) -> usize {
    unicode_segment_count_impl(self, SentenceBoundary)
  }

  --- Return whether every byte is ASCII.
  pub fn is_ascii(self: str) -> bool { unicode_text_is_ascii_impl(self) }

  --- Normalize to canonical composition form NFC.
  pub fn normalize_nfc(self: str) -> str { unicode_normalize_nfc_impl(self) }

  --- Normalize to canonical decomposition form NFD.
  pub fn normalize_nfd(self: str) -> str { unicode_normalize_nfd_impl(self) }

  --- Normalize to compatibility composition form NFKC.
  pub fn normalize_nfkc(self: str) -> str { unicode_normalize_nfkc_impl(self) }

  --- Normalize to compatibility decomposition form NFKD.
  pub fn normalize_nfkd(self: str) -> str { unicode_normalize_nfkd_impl(self) }

  --- Return whether this text is normalized to NFC.
  pub fn is_normalized_nfc(self: str) -> bool { unicode_is_normalized_nfc_impl(self) }

  --- Return whether this text is normalized to NFD.
  pub fn is_normalized_nfd(self: str) -> bool { unicode_is_normalized_nfd_impl(self) }

  --- Return whether this text is normalized to NFKC.
  pub fn is_normalized_nfkc(self: str) -> bool { unicode_is_normalized_nfkc_impl(self) }

  --- Return whether this text is normalized to NFKD.
  pub fn is_normalized_nfkd(self: str) -> bool { unicode_is_normalized_nfkd_impl(self) }
}
