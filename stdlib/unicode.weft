-- stdlib/unicode.weft — deterministic Unicode text algorithms
--
-- `str` is already an immutable UTF-8 text value. This module adds the
-- table-driven semantics that sit above byte/scalar transport. All data is
-- pinned to one Unicode version; the default algorithms are locale-neutral.

use compiler/unicode_normalization_data.{unicode_canonical_combining_class, unicode_canonical_compose, unicode_canonical_decompose_into, unicode_canonical_order, unicode_normalization_data_version}
use compiler/unicode_identifier_data.{unicode_default_ignorable, unicode_xid_continue, unicode_xid_start}
use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment, alloc_words}
use runtime/memory.{mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_byte_at, runtime_str_eq, runtime_str_len, runtime_str_ptr}
use stdlib/unicode/data/compatibility.{unicode_compatibility_decompose_into, unicode_compatibility_max_expansion}
use stdlib/unicode/data/case.{unicode_case_max_expansion, unicode_full_casefold_map_into, unicode_full_lowercase_map_into, unicode_full_titlecase_map_into, unicode_full_uppercase_map_into}
use stdlib/unicode/data/property.{*}
use stdlib/unicode/security.{unicode_security_are_confusable, unicode_security_is_mixed_script, unicode_security_skeleton}
use stdlib/unicode/segmentation.{unicode_grapheme_break_at_scalars, unicode_segmentation_decode, unicode_segmentation_scalar_index_at_offset, unicode_sentence_break_at_scalars, unicode_word_break_at_scalars}
use stdlib/utf8.{utf8_decode_is_ok, utf8_decode_next, utf8_decode_next_pos, utf8_decode_scalar, utf8_encode_scalar_into, utf8_encode_scalar_len, utf8_scalar_is_valid, utf8_validate}

--- Return the pinned Unicode data version used by every algorithm.
pub fn unicode_version() -> str {
  unicode_normalization_data_version()
}

--- Return the Unicode General_Category name for `scalar`.
pub fn unicode_general_category(scalar: i64) -> str {
  unicode_general_category_name(unicode_general_category_code(scalar))
}

--- Return the Unicode Script name for `scalar`.
pub fn unicode_script(scalar: i64) -> str {
  unicode_script_name(unicode_script_code(scalar))
}

--- Return the canonical combining class for `scalar`.
pub fn unicode_combining_class(scalar: i64) -> i64 {
  unicode_canonical_combining_class(scalar)
}

pub(package) fn unicode_has_binary_property(scalar: i64, bit: i64) -> i64 {
  if (unicode_binary_property_mask(scalar) band bit) != 0 { 1 } else { 0 }
}

--- Return whether `scalar` has the Alphabetic property.
pub fn unicode_is_alphabetic(scalar: i64) -> i64 {
  unicode_has_binary_property(scalar, unicode_property_alphabetic_bit())
}

--- Return whether `scalar` has the Lowercase property.
pub fn unicode_is_lowercase(scalar: i64) -> i64 {
