-- stdlib/semantic_type_render.weft -- canonical source-language type rendering

use runtime/buffer.{*}
use runtime/string.{runtime_int_to_str, runtime_str_from_bytes_copy}
use stdlib/semantic_type.{*}

pub fn semantic_type_append_list(b: i64, list: SemanticTypeFactList) -> i64 {
  let mut current = list
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticTypeFactListNil -> { done = true }
      SemanticTypeFactListCons(ty, rest) -> {
        if not first { bstr(b, ", ") } else { first = false }
        semantic_type_append(b, ty)
        current = rest
      }
      SemanticTypeFactListOther(name) -> { if not first { bstr(b, ", ") } else { 0 } bstr(b, name) done = true }
    }
  }
  buf_len(b)
}

pub fn semantic_type_append_effect_atom(b: i64, atom: SemanticEffectAtomFact) -> i64 {
  match atom {
    SemanticEffectAtom(name, args) -> {
      bstr(b, name)
      match args {
        SemanticTypeFactListNil -> 0
        _ -> { bstr(b, "<") semantic_type_append_list(b, args) bstr(b, ">") }
      }
    }
    SemanticEffectAtomOther(name) -> bstr(b, name)
  }
  buf_len(b)
}

pub fn semantic_type_append_effect_atoms(b: i64, atoms: SemanticEffectAtomFactList) -> i64 {
  let mut current = atoms
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticEffectAtomFactListNil -> { done = true }
      SemanticEffectAtomFactListCons(atom, rest) -> {
        if not first { bstr(b, ", ") } else { first = false }
        semantic_type_append_effect_atom(b, atom)
        current = rest
      }
      SemanticEffectAtomFactListOther(name) -> { if not first { bstr(b, ", ") } else { 0 } bstr(b, name) done = true }
    }
  }
  if first { 0 } else { 1 }
}

pub fn semantic_type_append_effects(b: i64, effects: SemanticEffectSetFact) -> i64 {
  match effects {
    SemanticEffectsClosed(SemanticEffectAtomFactListNil) -> bstr(b, " -> ")
    SemanticEffectsClosed(atoms) -> { bstr(b, " -[") semantic_type_append_effect_atoms(b, atoms) bstr(b, "]> ") }
    SemanticEffectsOpen(atoms, tail) -> {
      bstr(b, " -[")
      let had_atoms = semantic_type_append_effect_atoms(b, atoms)
      if had_atoms == 1 { bstr(b, ", ") } else { 0 }
      bstr(b, tail)
      bstr(b, "]> ")
    }
    SemanticEffectsOther(name) -> { bstr(b, " -[") bstr(b, name) bstr(b, "]> ") }
  }
  buf_len(b)
}

pub fn semantic_type_append_record_fields(b: i64, fields: SemanticRecordFieldFactList, tuple: bool) -> i64 {
  let mut current = fields
  let mut first = true
  let mut done = false
  while not done {
    match current {
      SemanticRecordFieldFactListNil -> { done = true }
      SemanticRecordFieldFactListCons(field, rest) -> {
        if not first { bstr(b, ", ") } else { first = false }
        match field {
          SemanticRecordField(name, index, ty) -> {
            if not tuple { bstr(b, name) bstr(b, ": ") } else { 0 }
            semantic_type_append(b, ty)
          }
          SemanticRecordFieldOther(name) -> bstr(b, name)
        }
        current = rest
      }
      SemanticRecordFieldFactListOther(name) -> { if not first { bstr(b, ", ") } else { 0 } bstr(b, name) done = true }
    }
  }
  buf_len(b)
}

pub fn semantic_type_record_field_count(fields: SemanticRecordFieldFactList) -> i64 {
  let mut current = fields
  let mut count = 0
  let mut done = false
  while not done {
    match current {
      SemanticRecordFieldFactListNil -> { done = true }
      SemanticRecordFieldFactListCons(field, rest) -> { count = count + 1 current = rest }
      SemanticRecordFieldFactListOther(name) -> { count = count + 1 done = true }
    }
  }
  count
}

-- Mirrors the source grammar: union < intersection < prefix < atom. Rendering
-- through this table preserves the fact's set meaning instead of relying on a
-- consumer to guess where parentheses belonged.
pub fn semantic_type_precedence(ty: SemanticTypeFact) -> i64 {
  match ty {
    SemanticTypeUnion(left, right) -> 1
    SemanticTypeIntersection(left, right) -> 2
    SemanticTypeComplement(inner) -> 3
    SemanticTypePointer(inner, mutable) -> 3
    SemanticTypeWeak(inner) -> 3
    SemanticTypeUnique(inner) -> 3
    SemanticTypeOwned(inner) -> 3
    SemanticTypeBorrow(inner, mutable) -> 3
    _ -> 4
  }
}

pub fn semantic_type_append_at(b: i64, ty: SemanticTypeFact, minimum_precedence: i64) -> i64 {
  let grouped = semantic_type_precedence(ty) < minimum_precedence
  if grouped { bstr(b, "(") } else { 0 }
  match ty {
    SemanticTypeBottom -> bstr(b, "never")
    SemanticTypeTop -> bstr(b, "any")
    SemanticTypePrimitive(name) -> bstr(b, name)
    SemanticTypeNamed(name, args) -> {
      bstr(b, name)
      match args { SemanticTypeFactListNil -> 0 _ -> { bstr(b, "<") semantic_type_append_list(b, args) bstr(b, ">") } }
    }
    SemanticTypeQualifiedNamed(module_name, name, args) -> {
      bstr(b, module_name)
      bstr(b, ".")
      bstr(b, name)
      match args { SemanticTypeFactListNil -> 0 _ -> { bstr(b, "<") semantic_type_append_list(b, args) bstr(b, ">") } }
    }
    SemanticTypeVariable(name) -> bstr(b, name)
    SemanticTypeUnion(left, right) -> { semantic_type_append_at(b, left, 1) bstr(b, " | ") semantic_type_append_at(b, right, 1) }
    SemanticTypeIntersection(left, right) -> { semantic_type_append_at(b, left, 2) bstr(b, " & ") semantic_type_append_at(b, right, 2) }
    SemanticTypeComplement(inner) -> { bstr(b, "~") semantic_type_append_at(b, inner, 3) }
    SemanticTypeFunction(params, result, effects) -> { bstr(b, "(") semantic_type_append_list(b, params) bstr(b, ")") semantic_type_append_effects(b, effects) semantic_type_append(b, result) }
    SemanticTypeRecord(fields, open, tuple) -> {
      if tuple { bstr(b, "(") } else { bstr(b, "{") }
      semantic_type_append_record_fields(b, fields, tuple)
      let field_count = semantic_type_record_field_count(fields)
      if open { if field_count > 0 { bstr(b, ", ..") } else { bstr(b, "..") } }
      else { if tuple and field_count == 1 { bstr(b, ",") } else { 0 } }
      if tuple { bstr(b, ")") } else { bstr(b, "}") }
    }
    SemanticTypeContinuation(input, output) -> { bstr(b, "continuation<") semantic_type_append(b, input) bstr(b, ", ") semantic_type_append(b, output) bstr(b, ">") }
    SemanticTypePointer(inner, mutable) -> { if mutable { bstr(b, "*mut ") } else { bstr(b, "*") } semantic_type_append_at(b, inner, 3) }
    SemanticTypeWeak(inner) -> { bstr(b, "weak ") semantic_type_append_at(b, inner, 3) }
    SemanticTypeUnique(inner) -> { bstr(b, "unique ") semantic_type_append_at(b, inner, 3) }
    SemanticTypeOwned(inner) -> { bstr(b, "owned ") semantic_type_append_at(b, inner, 3) }
    SemanticTypeBorrow(inner, mutable) -> { if mutable { bstr(b, "borrow mut ") } else { bstr(b, "borrow ") } semantic_type_append_at(b, inner, 3) }
    SemanticTypeTrait(name) -> bstr(b, name)
    SemanticTypeArray(inner, length) -> { bstr(b, "[") semantic_type_append(b, inner) bstr(b, "; ") bstr(b, runtime_int_to_str(length)) bstr(b, "]") }
    SemanticTypeSlice(inner, mutable) -> { if mutable { bstr(b, "[mut ") } else { bstr(b, "[") } semantic_type_append(b, inner) bstr(b, "]") }
    SemanticTypeAssociated(owner, name) -> { semantic_type_append_at(b, owner, 4) bstr(b, ".") bstr(b, name) }
    SemanticTypeOther(name) -> bstr(b, name)
  }
  if grouped { bstr(b, ")") } else { 0 }
  buf_len(b)
}

pub fn semantic_type_append(b: i64, ty: SemanticTypeFact) -> i64 {
  semantic_type_append_at(b, ty, 0)
}

pub fn semantic_type_render(ty: SemanticTypeFact) -> str {
  let b = buf_new(64)
  semantic_type_append(b, ty)
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}
