-- stdlib/console/terminal.weft — host terminal interpretation

use runtime/console_write.{runtime_safe_console_flush_result, runtime_safe_console_write_result}
use stdlib/console.{ConsoleWrite}

--- Install the host terminal as the interpretation of `ConsoleWrite`.
pub implements ConsoleWrite() {
  ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_console_write_result(stream, values))
  ConsoleWrite.flush(stream) -> resume(runtime_safe_console_flush_result(stream))
}
