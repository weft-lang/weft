-- stdlib/num/scalar.weft -- acyclic scalar arithmetic for stdlib foundations

use stdlib/option.{None, Option, Some}

pub(package) fn num_scalar_usize_checked_add(left: usize, right: usize) -> Option<usize> {
  let sum = left + right
  if sum < left { None<usize>() } else { Some<usize>(sum) }
}

pub(package) fn num_scalar_usize_checked_sub(left: usize, right: usize) -> Option<usize> {
  if right > left { None<usize>() } else { Some<usize>(left - right) }
}

pub(package) fn num_scalar_usize_checked_mul(left: usize, right: usize) -> Option<usize> {
  let maximum: usize = 18446744073709551615
  match right {
    0 -> Some<usize>(0)
    value if left > maximum / value -> None<usize>()
    value -> Some<usize>(left * value)
  }
}

pub(package) fn num_scalar_usize_to_i64(value: usize) -> Option<i64> {
  if value > 9223372036854775807 { None<i64>() }
  else { Some<i64>(__u64_to_i64(__usize_to_u64(value))) }
}

pub(package) fn num_scalar_i64_to_usize(value: i64) -> Option<usize> {
  if value < 0 { None<usize>() }
  else { Some<usize>(__i64_to_usize(value)) }
}
