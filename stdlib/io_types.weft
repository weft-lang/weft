-- stdlib/io_types.weft — portable typed I/O outcomes

use stdlib/bytes.{Utf8Error, utf8_error_offset_or}
use stdlib/num.{num_i64_to_usize_checked, num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/result.{Result, result_err, result_ok}

--- A portable I/O failure family independent of platform errno values.
pub type IoError {
  --- The operation was interrupted and may be retried by policy.
  IoInterrupted,
  --- Progress would block on the current non-blocking resource.
  IoWouldBlock,
  --- The requested filesystem entry does not exist.
  IoNotFound,
  --- The process lacks authority for the operation.
  IoPermissionDenied,
  --- Creation required an absent destination but one already exists.
  IoAlreadyExists,
  --- The resource has the wrong kind for the operation.
  IoWrongKind,
  --- The supplied native path is invalid for the target.
  IoInvalidPath,
  --- An otherwise unmapped positive platform error code.
  IoPlatform(i64),
  --- A configured byte or entry limit was exceeded.
  IoLimitExceeded(usize),
  --- Input ended after the reported number of bytes.
  IoUnexpectedEof(usize),
  --- A backend reported progress outside the requested range.
  IoInvalidProgress
}

--- Progress from one streaming read.
pub type IoReadProgress {
  --- The read produced this many bytes.
  IoReadBytes(usize),
  --- The resource reached end of input.
  IoEndOfFile
}

--- Progress from one streaming write.
pub type IoWriteProgress {
  --- The write consumed this many bytes.
  IoWroteBytes(usize)
}

--- A text I/O failure preserving either transport or UTF-8 detail.
pub type IoTextError {
  --- The underlying I/O operation failed.
  IoTextIo(IoError),
  --- The received bytes were not valid UTF-8.
  IoTextInvalidUtf8(Utf8Error)
}

--- Translate a signed platform status into a portable I/O error.
pub fn io_error_from_errno(errno: i64) -> IoError {
  let code = if errno < 0 { 0 - errno } else { errno }
  if code == 4 { IoInterrupted }
  else { if code == 11 or code == 35 { IoWouldBlock }
  else { if code == 2 { IoNotFound }
  else { if code == 1 or code == 13 { IoPermissionDenied }
  else { if code == 17 { IoAlreadyExists }
  else { if code == 20 or code == 21 { IoWrongKind }
  -- EINVAL is 22 on both targets; ENAMETOOLONG is 63 on Darwin and 36
  -- on Linux. Portable callers observe the family, not the host number.
  else { if code == 22 or code == 36 or code == 63 { IoInvalidPath }
  else { IoPlatform(code) } } } } } } }
}

--- Return a stable discriminator for a portable I/O error.
pub fn io_error_kind(error: IoError) -> i64 {
  match error {
    IoInterrupted -> 1
    IoWouldBlock -> 2
    IoNotFound -> 3
    IoPermissionDenied -> 4
    IoAlreadyExists -> 5
    IoWrongKind -> 6
    IoInvalidPath -> 7
    IoPlatform(code) -> 8
    IoLimitExceeded(limit) -> 9
    IoUnexpectedEof(received) -> 10
    IoInvalidProgress -> 11
  }
}

--- Return an unmapped platform code, or `default` for other errors.
pub fn io_error_platform_code_or(error: IoError, default: i64) -> i64 {
  match error {
    IoPlatform(code) -> code
    _ -> default
  }
}

--- Return the count carried by a limit or EOF error, or `default`.
pub fn io_error_count_or(error: IoError, default: i64) -> i64 {
  match error {
    IoLimitExceeded(limit) -> io_usize_to_i64(limit)
    IoUnexpectedEof(received) -> io_usize_to_i64(received)
    _ -> default
  }
}

--- Return a stable discriminator for a text I/O error.
pub fn io_text_error_kind(error: IoTextError) -> i64 {
  match error {
    IoTextIo(io) -> 1
    IoTextInvalidUtf8(utf8) -> 2
  }
}

--- Return an invalid UTF-8 byte offset, or `default` for I/O errors.
pub fn io_text_utf8_offset_or(error: IoTextError, default: i64) -> i64 {
  match error {
    IoTextIo(io) -> default
    IoTextInvalidUtf8(utf8) -> utf8_error_offset_or(utf8, default)
  }
}

--- Convert a signed platform read status into typed progress or failure.
pub fn io_read_progress_from_status(status: i64) -> Result<IoReadProgress, IoError> {
  if status < 0 {
    result_err<IoReadProgress, IoError>(io_error_from_errno(status))
  } else { if status == 0 {
    result_ok<IoReadProgress, IoError>(IoEndOfFile)
  } else {
    result_ok<IoReadProgress, IoError>(IoReadBytes(num_int_cast_value_or<usize>(num_i64_to_usize_checked(status), 0)))
  } }
}

--- Convert a signed platform write status into typed progress or failure.
pub fn io_write_progress_from_status(status: i64) -> Result<IoWriteProgress, IoError> {
  if status < 0 {
    result_err<IoWriteProgress, IoError>(io_error_from_errno(status))
  } else {
    result_ok<IoWriteProgress, IoError>(IoWroteBytes(num_int_cast_value_or<usize>(num_i64_to_usize_checked(status), 0)))
  }
}

fn io_usize_to_i64(value: usize) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(value)), 0)
}

--- Return a stable discriminator for streaming read progress.
pub fn io_read_progress_kind(progress: IoReadProgress) -> i64 {
  match progress {
    IoReadBytes(count) -> 1
    IoEndOfFile -> 2
  }
}

--- Return bytes read, or `default` at end of input.
pub fn io_read_progress_count_or(progress: IoReadProgress, default: i64) -> i64 {
  match progress {
    IoReadBytes(count) -> io_usize_to_i64(count)
    IoEndOfFile -> default
  }
}

--- Return bytes consumed by a streaming write.
pub fn io_write_progress_count(progress: IoWriteProgress) -> i64 {
  match progress {
    IoWroteBytes(count) -> io_usize_to_i64(count)
  }
}
