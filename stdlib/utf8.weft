-- stdlib/utf8.weft — scalar-aware UTF-8 helpers
--
-- `str` remains byte-oriented. This module validates byte sequences, decodes
-- Unicode scalar values, checks scalar boundaries, and encodes scalar values
-- back to UTF-8 bytes. Full Unicode semantics live above this layer.

use runtime/memory.{*}
use runtime/string.{*}

--- The result of decoding one Unicode scalar from a UTF-8 byte offset.
pub type Utf8Decode {
  --- A decoded scalar and the first unconsumed byte offset.
  Utf8Decoded(i64, i64)
  --- The byte offset at which decoding failed.
  Utf8Malformed(i64)
}

pub(package) fn utf8_decode_ok(next: i64, scalar: i64) -> Utf8Decode {
  Utf8Decoded(next, scalar)
}

pub(package) fn utf8_decode_bad(pos: i64) -> Utf8Decode {
  Utf8Malformed(pos)
}

pub(package) fn utf8_is_cont(byte: i64) -> bool {
  byte >= 128 and byte <= 191
}

--- Return whether `scalar` is a Unicode scalar value.
pub fn utf8_scalar_is_valid(scalar: i64) -> bool {
  scalar >= 0 and scalar <= 1114111 and not (scalar >= 55296 and scalar <= 57343)
}

--- Return a scalar's one-to-four-byte UTF-8 width, or zero when invalid.
pub fn utf8_encode_scalar_len(scalar: i64) -> i64 {
  if not utf8_scalar_is_valid(scalar) { 0 }
  else { if scalar <= 127 { 1 }
  else { if scalar <= 2047 { 2 }
  else { if scalar <= 65535 { 3 } else { 4 } } } }
}

pub(package) fn utf8_encode_scalar_into(dst: i64, pos: i64, scalar: i64) -> i64 {
  if not utf8_scalar_is_valid(scalar) { 0 - 1 }
  else { if scalar <= 127 {
    mem_store8_at(dst, pos, scalar)
    pos + 1
  } else { if scalar <= 2047 {
    mem_store8_at(dst, pos, 192 + scalar / 64)
    mem_store8_at(dst, pos + 1, 128 + (scalar - scalar / 64 * 64))
    pos + 2
  } else { if scalar <= 65535 {
    let b1 = scalar / 4096
    let rem1 = scalar - b1 * 4096
    let b2 = rem1 / 64
    mem_store8_at(dst, pos, 224 + b1)
    mem_store8_at(dst, pos + 1, 128 + b2)
    mem_store8_at(dst, pos + 2, 128 + (rem1 - b2 * 64))
    pos + 3
  } else {
    let b1 = scalar / 262144
    let rem1 = scalar - b1 * 262144
    let b2 = rem1 / 4096
    let rem2 = rem1 - b2 * 4096
    let b3 = rem2 / 64
    mem_store8_at(dst, pos, 240 + b1)
    mem_store8_at(dst, pos + 1, 128 + b2)
    mem_store8_at(dst, pos + 2, 128 + b3)
    mem_store8_at(dst, pos + 3, 128 + (rem2 - b3 * 64))
    pos + 4
  } } } }
}

--- Encode one Unicode scalar as a string, returning empty text when invalid.
pub fn utf8_string_from_scalar(scalar: i64) -> str {
  let len = utf8_encode_scalar_len(scalar)
  if len == 0 {
    ""
  } else {
    let value = runtime_str_alloc_uninit(len)
    let data = runtime_str_ptr(value)
    utf8_encode_scalar_into(data, 0, scalar)
    value
  }
}

pub(package) fn utf8_decode_next_bytes(src: i64, n: i64, pos: i64) -> Utf8Decode {
  if pos < 0 or pos >= n { utf8_decode_bad(pos) }
  else {
    let b1 = mem_load8_at(src, pos)
    if b1 <= 127 {
      utf8_decode_ok(pos + 1, b1)
    } else { if b1 >= 194 and b1 <= 223 {
      if pos + 1 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = mem_load8_at(src, pos + 1)
        if not utf8_is_cont(b2) { utf8_decode_bad(pos) }
        else { utf8_decode_ok(pos + 2, (b1 - 192) * 64 + (b2 - 128)) }
      }
    } else { if b1 >= 224 and b1 <= 239 {
      if pos + 2 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = mem_load8_at(src, pos + 1)
        let b3 = mem_load8_at(src, pos + 2)
        let b2_ok = if b1 == 224 { b2 >= 160 and b2 <= 191 }
        else { if b1 == 237 { b2 >= 128 and b2 <= 159 }
        else { utf8_is_cont(b2) } }
        if not b2_ok or not utf8_is_cont(b3) {
          utf8_decode_bad(pos)
        } else {
          utf8_decode_ok(pos + 3, (b1 - 224) * 4096 + (b2 - 128) * 64 + (b3 - 128))
        }
      }
    } else { if b1 >= 240 and b1 <= 244 {
      if pos + 3 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = mem_load8_at(src, pos + 1)
        let b3 = mem_load8_at(src, pos + 2)
        let b4 = mem_load8_at(src, pos + 3)
        let b2_ok = if b1 == 240 { b2 >= 144 and b2 <= 191 }
        else { if b1 == 244 { b2 >= 128 and b2 <= 143 }
        else { utf8_is_cont(b2) } }
        if not b2_ok or not utf8_is_cont(b3) or not utf8_is_cont(b4) {
          utf8_decode_bad(pos)
        } else {
          utf8_decode_ok(pos + 4, (b1 - 240) * 262144 + (b2 - 128) * 4096 + (b3 - 128) * 64 + (b4 - 128))
        }
      }
    } else {
      utf8_decode_bad(pos)
    } } } }
  }
}

--- Decode one scalar beginning at UTF-8 byte offset `pos`.
---
--- Malformed, truncated, continuation, overlong, surrogate, and out-of-range
--- sequences fail at `pos` rather than consuming bytes.
pub fn utf8_decode_next(s: str, pos: i64) -> Utf8Decode {
  utf8_decode_next_bytes(runtime_str_ptr(s), runtime_str_len(s), pos)
}

pub(package) fn utf8_validate_bytes(src: i64, n: i64) -> bool {
  let mut p = 0
  let mut valid = true
  while valid and p < n {
    match utf8_decode_next_bytes(src, n, p) {
      Utf8Decoded(next, scalar) -> { p = next }
      Utf8Malformed(offset) -> { valid = false }
    }
  }
  valid
}

--- Return whether every byte forms canonical UTF-8.
pub fn utf8_validate(s: str) -> bool {
  utf8_validate_bytes(runtime_str_ptr(s), runtime_str_len(s))
}

--- Count Unicode scalars, returning `-1` for malformed UTF-8.
pub fn utf8_codepoint_count(s: str) -> i64 {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  let mut p = 0
  let mut count = 0
  let mut valid = true
  while valid and p < n {
    match utf8_decode_next_bytes(src, n, p) {
      Utf8Decoded(next, scalar) -> {
        count = count + 1
        p = next
      }
      Utf8Malformed(offset) -> { valid = false }
    }
  }
  if valid { count } else { 0 - 1 }
}

--- Return whether `pos` is a decoded scalar boundary from zero through end.
pub fn utf8_is_boundary(s: str, pos: i64) -> bool {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  if pos < 0 or pos > n { false }
  else {
    let mut p = 0
    let mut valid = true
    while valid and p < pos {
      match utf8_decode_next_bytes(src, n, p) {
        Utf8Decoded(next, scalar) -> {
          if next > pos { valid = false } else { p = next }
        }
        Utf8Malformed(offset) -> { valid = false }
      }
    }
    valid and p == pos
  }
}
