-- stdlib/utf8.weft — scalar-aware UTF-8 helpers
--
-- `str` remains byte-oriented. This module validates byte sequences, decodes
-- Unicode scalar values, checks scalar boundaries, and encodes scalar values
-- back to UTF-8 bytes. Full Unicode semantics live above this layer.

use runtime/memory.{*}
use runtime/string.{*}
use runtime/utf8.{Utf8StorageMalformed, Utf8StorageScalar, utf8_storage_decode}
use stdlib/iter/core.{iter_next, iter_remaining_lower}
use stdlib/iter/protocol.{IntoIterator}
use stdlib/num/scalar.{num_scalar_i64_to_usize, num_scalar_usize_to_i64}
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{vector_data}
use stdlib/vector/handles.{Vector}

--- The result of decoding one Unicode scalar from a UTF-8 byte offset.
pub type Utf8Decode {
  --- A decoded scalar and the first unconsumed byte offset.
  Utf8Decoded(i64, i64)
  --- The byte offset at which decoding failed.
  Utf8Malformed(i64)
}

--- A failure to encode a traversal of purported Unicode scalar values.
pub type Utf8EncodeError {
  --- The value at the scalar ordinal is negative, surrogate, or too large.
  InvalidScalar(usize, i64)
}

type Utf8ScalarWidth {
  Utf8OneByte,
  Utf8TwoBytes,
  Utf8ThreeBytes,
  Utf8FourBytes
}

pub(package) fn utf8_decode_ok(next: i64, scalar: i64) -> Utf8Decode {
  Utf8Decoded(next, scalar)
}

pub(package) fn utf8_decode_bad(pos: i64) -> Utf8Decode {
  Utf8Malformed(pos)
}

pub(package) fn utf8_is_cont(byte: i64) -> bool {
  byte >= 128 and byte <= 191
}

fn utf8_byte(value: i64) -> u8 {
  __i64_to_u8(value)
}

fn utf8_scalar_width(scalar: i64) -> Option<Utf8ScalarWidth> {
  match scalar {
    value if value < 0 -> None<Utf8ScalarWidth>()
    value if value <= 127 -> Some<Utf8ScalarWidth>(Utf8OneByte)
    value if value <= 2047 -> Some<Utf8ScalarWidth>(Utf8TwoBytes)
    value if value >= 55296 and value <= 57343 -> None<Utf8ScalarWidth>()
    value if value <= 65535 -> Some<Utf8ScalarWidth>(Utf8ThreeBytes)
    value if value <= 1114111 -> Some<Utf8ScalarWidth>(Utf8FourBytes)
    _ -> None<Utf8ScalarWidth>()
  }
}

fn utf8_width_len(width: Utf8ScalarWidth) -> i64 {
  match width {
    Utf8OneByte -> 1
    Utf8TwoBytes -> 2
    Utf8ThreeBytes -> 3
    Utf8FourBytes -> 4
  }
}

pub(package) fn utf8_scalar_valid(scalar: i64) -> bool {
  utf8_scalar_width(scalar).is_some()
}

pub(package) fn utf8_scalar_encoded_len(scalar: i64) -> i64 {
  match utf8_scalar_width(scalar) {
    None -> 0
    Some(width) -> utf8_width_len(width)
  }
}

--- Return whether `scalar` is a Unicode scalar value.
pub fn is_scalar(scalar: i64) -> bool {
  utf8_scalar_valid(scalar)
}

--- Return a scalar's one-to-four-byte UTF-8 width.
pub fn encoded_len(scalar: i64) -> Option<i64> {
  let len = utf8_scalar_encoded_len(scalar)
  if len == 0 { None<i64>() } else { Some<i64>(len) }
}

fn utf8_write_scalar(dst: i64, pos: i64, scalar: i64, width: Utf8ScalarWidth) -> i64 {
  match width {
    Utf8OneByte -> {
      mem_store8_at(dst, pos, scalar)
      pos + 1
    }
    Utf8TwoBytes -> {
      let first = scalar / 64
      mem_store8_at(dst, pos, 192 + first)
      mem_store8_at(dst, pos + 1, 128 + (scalar - first * 64))
      pos + 2
    }
    Utf8ThreeBytes -> {
      let first = scalar / 4096
      let remainder = scalar - first * 4096
      let second = remainder / 64
      mem_store8_at(dst, pos, 224 + first)
      mem_store8_at(dst, pos + 1, 128 + second)
      mem_store8_at(dst, pos + 2, 128 + (remainder - second * 64))
      pos + 3
    }
    Utf8FourBytes -> {
      let first = scalar / 262144
      let first_remainder = scalar - first * 262144
      let second = first_remainder / 4096
      let second_remainder = first_remainder - second * 4096
      let third = second_remainder / 64
      mem_store8_at(dst, pos, 240 + first)
      mem_store8_at(dst, pos + 1, 128 + second)
      mem_store8_at(dst, pos + 2, 128 + third)
      mem_store8_at(dst, pos + 3, 128 + (second_remainder - third * 64))
      pos + 4
    }
  }
}

pub(package) fn utf8_encode_scalar_into(dst: i64, pos: i64, scalar: i64) -> i64 {
  match utf8_scalar_width(scalar) {
    None -> 0 - 1
    Some(width) -> utf8_write_scalar(dst, pos, scalar, width)
  }
}

--- Encode one Unicode scalar as a string.
pub fn from_scalar(scalar: i64) -> Option<str> {
  match utf8_scalar_width(scalar) {
    None -> None<str>()
    Some(width) -> {
      let value = runtime_str_alloc_uninit(utf8_width_len(width))
      utf8_write_scalar(runtime_str_ptr(value), 0, scalar, width)
      Some<str>(value)
    }
  }
}

fn utf8_push_scalar(output: borrow mut Vector<u8>, scalar: i64, width: Utf8ScalarWidth) -> nil {
  match width {
    Utf8OneByte -> output.push(utf8_byte(scalar))
    Utf8TwoBytes -> {
      let first = scalar / 64
      output.push(utf8_byte(192 + first))
      output.push(utf8_byte(128 + (scalar - first * 64)))
    }
    Utf8ThreeBytes -> {
      let first = scalar / 4096
      let remainder = scalar - first * 4096
      let second = remainder / 64
      output.push(utf8_byte(224 + first))
      output.push(utf8_byte(128 + second))
      output.push(utf8_byte(128 + (remainder - second * 64)))
    }
    Utf8FourBytes -> {
      let first = scalar / 262144
      let first_remainder = scalar - first * 262144
      let second = first_remainder / 4096
      let second_remainder = first_remainder - second * 4096
      let third = second_remainder / 64
      output.push(utf8_byte(240 + first))
      output.push(utf8_byte(128 + second))
      output.push(utf8_byte(128 + third))
      output.push(utf8_byte(128 + (second_remainder - third * 64)))
    }
  }
}

--- Encode a finite scalar traversal as one canonical UTF-8 string.
---
--- The source is consumed once. Invalid values report their scalar ordinal,
--- and an early failure closes the remaining iterator deterministically.
pub fn from_scalars<S: IntoIterator & {type Item = i64}>(scalars: S) -> Result<str, Utf8EncodeError> {
  let mut input = scalars.into_iter()
  let minimum_bytes = num_scalar_i64_to_usize(iter_remaining_lower<i64>(input)).unwrap_or(0)
  let mut output = vector.with_capacity<u8>(minimum_bytes)
  let mut index: usize = 0
  loop {
    match iter_next<i64>(input) {
      None -> break
      Some(scalar) -> {
        match utf8_scalar_width(scalar) {
          None -> return Err<str, Utf8EncodeError>(InvalidScalar(index, scalar))
          Some(width) -> utf8_push_scalar(output, scalar, width)
        }
        index = index + 1
      }
    }
  }
  let length = num_scalar_usize_to_i64(output.len()).expect("UTF-8 output is too large")
  Ok<str, Utf8EncodeError>(runtime_str_from_bytes_copy(vector_data<u8>(output), length))
}

pub(package) fn utf8_decode_next_bytes(src: i64, n: i64, pos: i64) -> Utf8Decode {
  match utf8_storage_decode(src, n, pos) {
    Utf8StorageScalar(next, scalar) -> Utf8Decoded(next, scalar)
    Utf8StorageMalformed(offset) -> Utf8Malformed(offset)
  }
}

--- Decode one scalar beginning at UTF-8 byte offset `pos`.
---
--- Malformed, truncated, continuation, overlong, surrogate, and out-of-range
--- sequences fail at `pos` rather than consuming bytes.
pub fn decode_next(s: str, pos: i64) -> Utf8Decode {
  utf8_decode_next_bytes(runtime_str_ptr(s), runtime_str_len(s), pos)
}

pub(package) fn utf8_validate_bytes(src: i64, n: i64) -> bool {
  let mut p = 0
  let mut valid = true
  while valid and p < n {
    match utf8_decode_next_bytes(src, n, p) {
      Utf8Decoded(next, scalar) -> { p = next }
      Utf8Malformed(offset) -> { valid = false }
    }
  }
  valid
}

--- Return whether every byte forms canonical UTF-8.
pub fn validate(s: str) -> bool {
  utf8_validate_bytes(runtime_str_ptr(s), runtime_str_len(s))
}

--- Count Unicode scalars, returning `-1` for malformed UTF-8.
pub(package) fn utf8_count_scalars(s: str) -> i64 {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  let mut p = 0
  let mut count = 0
  let mut valid = true
  while valid and p < n {
    match utf8_decode_next_bytes(src, n, p) {
      Utf8Decoded(next, scalar) -> {
        count = count + 1
        p = next
      }
      Utf8Malformed(offset) -> { valid = false }
    }
  }
  if valid { count } else { 0 - 1 }
}

--- Return whether `pos` is a decoded scalar boundary from zero through end.
pub(package) fn utf8_scalar_boundary(s: str, pos: i64) -> bool {
  let src = runtime_str_ptr(s)
  let n = runtime_str_len(s)
  if pos < 0 or pos > n { false }
  else {
    let mut p = 0
    let mut valid = true
    while valid and p < pos {
      match utf8_decode_next_bytes(src, n, p) {
        Utf8Decoded(next, scalar) -> {
          if next > pos { valid = false } else { p = next }
        }
        Utf8Malformed(offset) -> { valid = false }
      }
    }
    valid and p == pos
  }
}
