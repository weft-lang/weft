-- stdlib/utf8.weft — scalar-aware UTF-8 helpers
--
-- `str` remains byte-oriented. This module validates byte sequences, decodes
-- Unicode scalar values, checks scalar boundaries, and encodes scalar values
-- back to UTF-8 bytes. Full Unicode semantics live above this layer.

use "runtime/alloc.weft"

type Utf8Decode {
  Utf8Decode(i64, i64, i64)
}

fn utf8_decode_result(ok: i64, next: i64, scalar: i64) -> Utf8Decode {
  Utf8Decode(ok, next, scalar)
}

fn utf8_decode_ok(next: i64, scalar: i64) -> Utf8Decode {
  utf8_decode_result(1, next, scalar)
}

fn utf8_decode_bad(pos: i64) -> Utf8Decode {
  utf8_decode_result(0, pos, 0)
}

fn utf8_decode_is_ok(result: Utf8Decode) -> i64 {
  match result {
    Utf8Decode(ok, next, scalar) -> ok
  }
}

fn utf8_decode_next_pos(result: Utf8Decode) -> i64 {
  match result {
    Utf8Decode(ok, next, scalar) -> next
  }
}

fn utf8_decode_scalar(result: Utf8Decode) -> i64 {
  match result {
    Utf8Decode(ok, next, scalar) -> scalar
  }
}

fn utf8_is_cont(byte: i64) -> i64 {
  if byte >= 128 and byte <= 191 { 1 } else { 0 }
}

fn utf8_scalar_is_valid(scalar: i64) -> i64 {
  if scalar < 0 { 0 }
  else { if scalar > 1114111 { 0 }
  else { if scalar >= 55296 and scalar <= 57343 { 0 } else { 1 } } }
}

fn utf8_encode_scalar_len(scalar: i64) -> i64 {
  if utf8_scalar_is_valid(scalar) == 0 { 0 }
  else { if scalar <= 127 { 1 }
  else { if scalar <= 2047 { 2 }
  else { if scalar <= 65535 { 3 } else { 4 } } } }
}

fn utf8_encode_scalar_into(dst: i64, pos: i64, scalar: i64) -> i64 {
  if utf8_scalar_is_valid(scalar) == 0 { 0 - 1 }
  else { if scalar <= 127 {
    __mem_store8(dst + pos, scalar)
    pos + 1
  } else { if scalar <= 2047 {
    __mem_store8(dst + pos, 192 + scalar / 64)
    __mem_store8(dst + pos + 1, 128 + (scalar - scalar / 64 * 64))
    pos + 2
  } else { if scalar <= 65535 {
    let b1 = scalar / 4096
    let rem1 = scalar - b1 * 4096
    let b2 = rem1 / 64
    __mem_store8(dst + pos, 224 + b1)
    __mem_store8(dst + pos + 1, 128 + b2)
    __mem_store8(dst + pos + 2, 128 + (rem1 - b2 * 64))
    pos + 3
  } else {
    let b1 = scalar / 262144
    let rem1 = scalar - b1 * 262144
    let b2 = rem1 / 4096
    let rem2 = rem1 - b2 * 4096
    let b3 = rem2 / 64
    __mem_store8(dst + pos, 240 + b1)
    __mem_store8(dst + pos + 1, 128 + b2)
    __mem_store8(dst + pos + 2, 128 + b3)
    __mem_store8(dst + pos + 3, 128 + (rem2 - b3 * 64))
    pos + 4
  } } } }
}

fn utf8_string_from_scalar(scalar: i64) -> str {
  let len = utf8_encode_scalar_len(scalar)
  if len == 0 {
    ""
  } else {
    let data = alloc_bump_rounded(len, 8)
    utf8_encode_scalar_into(data, 0, scalar)
    let desc = alloc_words(2)
    __mem_store64(desc, data)
    __mem_store64(desc + 8, len)
    desc
  }
}

fn utf8_decode_next_bytes(src: i64, n: i64, pos: i64) -> Utf8Decode {
  if pos < 0 or pos >= n { utf8_decode_bad(pos) }
  else {
    let b1 = __mem_load8(src + pos)
    if b1 <= 127 {
      utf8_decode_ok(pos + 1, b1)
    } else { if b1 >= 194 and b1 <= 223 {
      if pos + 1 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = __mem_load8(src + pos + 1)
        if utf8_is_cont(b2) == 0 { utf8_decode_bad(pos) }
        else { utf8_decode_ok(pos + 2, (b1 - 192) * 64 + (b2 - 128)) }
      }
    } else { if b1 >= 224 and b1 <= 239 {
      if pos + 2 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = __mem_load8(src + pos + 1)
        let b3 = __mem_load8(src + pos + 2)
        let b2_ok = if b1 == 224 { if b2 >= 160 and b2 <= 191 { 1 } else { 0 } }
        else { if b1 == 237 { if b2 >= 128 and b2 <= 159 { 1 } else { 0 } }
        else { utf8_is_cont(b2) } }
        if b2_ok == 0 or utf8_is_cont(b3) == 0 {
          utf8_decode_bad(pos)
        } else {
          utf8_decode_ok(pos + 3, (b1 - 224) * 4096 + (b2 - 128) * 64 + (b3 - 128))
        }
      }
    } else { if b1 >= 240 and b1 <= 244 {
      if pos + 3 >= n { utf8_decode_bad(pos) }
      else {
        let b2 = __mem_load8(src + pos + 1)
        let b3 = __mem_load8(src + pos + 2)
        let b4 = __mem_load8(src + pos + 3)
        let b2_ok = if b1 == 240 { if b2 >= 144 and b2 <= 191 { 1 } else { 0 } }
        else { if b1 == 244 { if b2 >= 128 and b2 <= 143 { 1 } else { 0 } }
        else { utf8_is_cont(b2) } }
        if b2_ok == 0 or utf8_is_cont(b3) == 0 or utf8_is_cont(b4) == 0 {
          utf8_decode_bad(pos)
        } else {
          utf8_decode_ok(pos + 4, (b1 - 240) * 262144 + (b2 - 128) * 4096 + (b3 - 128) * 64 + (b4 - 128))
        }
      }
    } else {
      utf8_decode_bad(pos)
    } } } }
  }
}

fn utf8_decode_next(s: str, pos: i64) -> Utf8Decode {
  utf8_decode_next_bytes(__str_ptr(s), __str_len(s), pos)
}

fn utf8_validate_bytes(src: i64, n: i64) -> i64 {
  let mut p = 0
  let mut ok = 1
  while ok == 1 and p < n {
    let decoded = utf8_decode_next_bytes(src, n, p)
    if utf8_decode_is_ok(decoded) == 0 {
      ok = 0
    } else {
      p = utf8_decode_next_pos(decoded)
    }
  }
  ok
}

fn utf8_validate(s: str) -> i64 {
  utf8_validate_bytes(__str_ptr(s), __str_len(s))
}

fn utf8_codepoint_count(s: str) -> i64 {
  let src = __str_ptr(s)
  let n = __str_len(s)
  let mut p = 0
  let mut count = 0
  let mut ok = 1
  while ok == 1 and p < n {
    let decoded = utf8_decode_next_bytes(src, n, p)
    if utf8_decode_is_ok(decoded) == 0 {
      ok = 0
    } else {
      count = count + 1
      p = utf8_decode_next_pos(decoded)
    }
  }
  if ok == 1 { count } else { 0 - 1 }
}

fn utf8_is_boundary(s: str, pos: i64) -> i64 {
  let src = __str_ptr(s)
  let n = __str_len(s)
  if pos < 0 or pos > n { 0 }
  else {
    let mut p = 0
    let mut ok = 1
    while ok == 1 and p < pos {
      let decoded = utf8_decode_next_bytes(src, n, p)
      if utf8_decode_is_ok(decoded) == 0 or utf8_decode_next_pos(decoded) > pos {
        ok = 0
      } else {
        p = utf8_decode_next_pos(decoded)
      }
    }
    if ok == 1 and p == pos { 1 } else { 0 }
  }
}
