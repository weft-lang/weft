-- stdlib/sorted_map.weft — vector-backed sorted maps
--
-- This first ordered collection surface is mutable and deterministic. The map
-- is a vector of entries sorted by a caller-supplied pure comparator:
--   cmp(a, b) < 0 when a < b, 0 when equal, > 0 when a > b.

use "stdlib/option.weft"
use "stdlib/string.weft"
use "stdlib/vector.weft"

type SortedEntry<K, V> {
  SortedEntry(K, V)
}

type SortedSearch {
  SortedFound(i64),
  SortedMissing(i64)
}

fn sorted_entry<K, V>(key: K, value: V) -> SortedEntry<K, V> {
  SortedEntry<K, V>(key, value)
}

fn sorted_entry_key<K, V>(entry: SortedEntry<K, V>) -> K {
  match entry {
    SortedEntry(key, value) -> key
  }
}

fn sorted_entry_value<K, V>(entry: SortedEntry<K, V>) -> V {
  match entry {
    SortedEntry(key, value) -> value
  }
}

fn sorted_search_index(search: SortedSearch) -> i64 {
  match search {
    SortedFound(index) -> index
    SortedMissing(index) -> index
  }
}

fn sorted_search_found(search: SortedSearch) -> i64 {
  match search {
    SortedFound(index) -> 1
    SortedMissing(index) -> 0
  }
}

fn sorted_cmp_i64(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

fn sorted_cmp_str(a: str, b: str) -> i64 {
  let al = str_len(a)
  let bl = str_len(b)
  let n = if al < bl { al } else { bl }
  let mut result = 0
  let mut done = 0
  let mut i = 0
  while done == 0 and i < n {
    let ac = str_byte_at(a, i)
    let bc = str_byte_at(b, i)
    if ac < bc {
      result = 0 - 1
      done = 1
    } else { if ac > bc {
      result = 1
      done = 1
    } else {
      i = i + 1
    } }
  }
  if result != 0 {
    result
  } else {
    if al < bl { 0 - 1 } else { if al > bl { 1 } else { 0 } }
  }
}

fn sorted_map_new<K, V>() -> i64 {
  vector_new<SortedEntry<K, V>>()
}

fn sorted_map_len(m: i64) -> i64 { vector_len(m) }
fn sorted_map_is_empty(m: i64) -> i64 { vector_is_empty(m) }

fn sorted_map_entry_at<K, V>(m: i64, index: i64) -> SortedEntry<K, V> {
  vector_get_in_bounds<SortedEntry<K, V>>(m, index)
}

fn sorted_map_find<K, V>(m: i64, key: K, cmp: (K, K) -> i64) -> SortedSearch {
  let mut lo = 0
  let mut hi = sorted_map_len(m)
  let mut found = 0 - 1
  while found < 0 and lo < hi {
    let mid = lo + (hi - lo) / 2
    let entry = sorted_map_entry_at<K, V>(m, mid)
    let c = cmp(key, sorted_entry_key<K, V>(entry))
    if c == 0 {
      found = mid
    } else {
      if c < 0 { hi = mid } else { lo = mid + 1 }
    }
  }
  if found >= 0 { SortedFound(found) } else { SortedMissing(lo) }
}

fn sorted_map_insert_entry_at<K, V>(m: i64, index: i64, entry: SortedEntry<K, V>) -> i64 {
  let old_len = sorted_map_len(m)
  vector_push<SortedEntry<K, V>>(m, entry)
  let mut i = old_len
  while i > index {
    vector_set<SortedEntry<K, V>>(m, i, sorted_map_entry_at<K, V>(m, i - 1))
    i = i - 1
  }
  vector_set<SortedEntry<K, V>>(m, index, entry)
  1
}

fn sorted_map_remove_entry_at<K, V>(m: i64, index: i64) -> i64 {
  let len = sorted_map_len(m)
  if index < 0 or index >= len {
    0
  } else {
    let mut i = index
    while i + 1 < len {
      vector_set<SortedEntry<K, V>>(m, i, sorted_map_entry_at<K, V>(m, i + 1))
      i = i + 1
    }
    vector_pop<SortedEntry<K, V>>(m)
    1
  }
}

fn sorted_map_put<K, V>(m: i64, key: K, value: V, cmp: (K, K) -> i64) -> i64 {
  let search = sorted_map_find<K, V>(m, key, cmp)
  let index = sorted_search_index(search)
  let entry = sorted_entry<K, V>(key, value)
  if sorted_search_found(search) == 1 {
    vector_set<SortedEntry<K, V>>(m, index, entry)
    0
  } else {
    sorted_map_insert_entry_at<K, V>(m, index, entry)
  }
}

fn sorted_map_get_option<K, V>(m: i64, key: K, cmp: (K, K) -> i64) -> i64 {
  let search = sorted_map_find<K, V>(m, key, cmp)
  if sorted_search_found(search) == 1 {
    let entry = sorted_map_entry_at<K, V>(m, sorted_search_index(search))
    Some<V>(sorted_entry_value<K, V>(entry))
  } else {
    None
  }
}

fn sorted_map_get<K, V>(m: i64, key: K, default: V, cmp: (K, K) -> i64) -> V {
  let opt = sorted_map_get_option<K, V>(m, key, cmp)
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn sorted_map_contains<K, V>(m: i64, key: K, cmp: (K, K) -> i64) -> i64 {
  sorted_search_found(sorted_map_find<K, V>(m, key, cmp))
}

fn sorted_map_remove<K, V>(m: i64, key: K, cmp: (K, K) -> i64) -> i64 {
  let search = sorted_map_find<K, V>(m, key, cmp)
  if sorted_search_found(search) == 1 {
    sorted_map_remove_entry_at<K, V>(m, sorted_search_index(search))
  } else {
    0
  }
}

fn sorted_map_entries<K, V>(m: i64) -> i64 {
  let len = sorted_map_len(m)
  let out = vector_with_capacity<SortedEntry<K, V>>(len)
  for i in 0..len {
    vector_push<SortedEntry<K, V>>(out, sorted_map_entry_at<K, V>(m, i))
  }
  out
}

fn sorted_map_keys<K, V>(m: i64) -> i64 {
  let len = sorted_map_len(m)
  let out = vector_with_capacity<K>(len)
  for i in 0..len {
    vector_push<K>(out, sorted_entry_key<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

fn sorted_map_values<K, V>(m: i64) -> i64 {
  let len = sorted_map_len(m)
  let out = vector_with_capacity<V>(len)
  for i in 0..len {
    vector_push<V>(out, sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

fn sorted_map_fold<K, V, A>(m: i64, init: A, f: (A, K, V) -> A) -> A {
  let mut acc = init
  for i in 0..sorted_map_len(m) {
    let entry = sorted_map_entry_at<K, V>(m, i)
    acc = f(acc, sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry))
  }
  acc
}
