-- stdlib/sorted_map.weft — vector-backed sorted maps
--
-- This ordered collection surface is mutable and deterministic. Keys use their
-- canonical `Ord` implementation, so one map cannot accidentally mix orders.

use stdlib/option.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/iter/core.{from_generator, iter_next}
use stdlib/iter/protocol.{Collect, IntoIterator, Iterator}
use stdlib/ord.{*}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_field_in_bounds, vector_get_in_bounds}

pub(package) type SortedEntry<K, V> {
  SortedEntry(K, V)
}

--- A mutable vector-backed map kept in ascending key order.
pub type SortedMap<K, V> = opaque Vector<SortedEntry<K, V>>

pub(package) type SortedSearch {
  SortedFound(i64),
  SortedMissing(i64)
}

pub(package) fn sorted_entry<K, V>(key: K, value: V) -> SortedEntry<K, V> {
  SortedEntry<K, V>(key, value)
}

pub(package) fn sorted_entry_key<K, V>(entry: SortedEntry<K, V>) -> K {
  match entry {
    SortedEntry(key, value) -> key
  }
}

pub(package) fn sorted_entry_value<K, V>(entry: SortedEntry<K, V>) -> V {
  match entry {
    SortedEntry(key, value) -> value
  }
}

--- Construct an empty mutable ordered map.
pub fn new<K: Ord, V>() -> SortedMap<K, V> {
  SortedMap<K, V>(vector.new<SortedEntry<K, V>>())
}

pub(package) fn sorted_map_vector<K, V>(m: SortedMap<K, V>) -> Vector<SortedEntry<K, V>> {
  match m {
    SortedMap(entries) -> entries
  }
}

--- Return the number of entries in an ordered map.
pub(package) fn sorted_map_len<K, V>(m: SortedMap<K, V>) -> i64 {
  sorted_map_vector<K, V>(m).len()
}

--- Iterate key-value tuples in ascending key order.
pub(package) fn sorted_map_into_iter<K, V>(m: SortedMap<K, V>) -> owned Iterator<(K, V)> {
  let producer = () => {
    let mut index = 0
    let mut done = 0
    while done == 0 {
      if index < sorted_map_len<K, V>(m) {
        let entry = sorted_map_entry_at<K, V>(m, index)
        generator.yield<(K, V)>((sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry)))
        index = index + 1
      } else {
        done = 1
      }
    }
    0
  }
  from_generator<(K, V)>(generator.start<(K, V), i64>(producer))
}

impl<K, V> IntoIterator for SortedMap<K, V> {
  type Item = (K, V)

  fn into_iter(self: SortedMap<K, V>) -> owned Iterator<(K, V)> {
    sorted_map_into_iter<K, V>(self)
  }
}

--- Return whether the ordered map has no entries.
pub(package) fn sorted_map_is_empty<K, V>(m: SortedMap<K, V>) -> bool {
  sorted_map_vector<K, V>(m).is_empty()
}

pub(package) fn sorted_map_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> SortedEntry<K, V> {
  vector_get_in_bounds<SortedEntry<K, V>>(sorted_map_vector<K, V>(m), index)
}

-- Key of the entry at `index` without materialising an owned entry
-- reference: the map keeps the entry alive for the read, and the key
-- follows K's own ownership class (scalar keys copy, managed keys are
-- retained). Caller maintains bounds, like sorted_map_entry_at.
pub(package) fn sorted_map_key_at<K, V>(m: SortedMap<K, V>, index: i64) -> K {
  vector_get_field_in_bounds<SortedEntry<K, V>, K>(sorted_map_vector<K, V>(m), index, 0)
}

pub(package) fn sorted_map_find<K: Ord, V>(m: SortedMap<K, V>, key: K) -> SortedSearch {
  -- Keep the backing vector as a scoped payload borrow from `m`: returning it
  -- through sorted_map_vector would manufacture an owned view only to release
  -- it after this search. Aliased mutation still reaches the same live vector
  -- and is observed by every length check.
  match m {
    SortedMap(entries) -> {
      let mut lo = 0
      let mut hi = entries.len()
      let mut found = 0 - 1
      while found < 0 and lo < hi {
        -- A key's pure comparison may still mutate aliased in-memory state.
        -- Re-check the window against the current length before every entry
        -- load so a shrink resolves honestly instead of reading a stale slot.
        let len_now = entries.len()
        if hi > len_now { hi = len_now } else { 0 }
        if lo > len_now { lo = len_now } else { 0 }
        if lo < hi {
          let mid = lo + (hi - lo) / 2
          match key.compare(vector_get_field_in_bounds<SortedEntry<K, V>, K>(entries, mid, 0)) {
            Equal -> { found = mid }
            Less -> { hi = mid }
            Greater -> { lo = mid + 1 }
          }
        } else { 0 }
      }
      -- The matching comparison may itself have shrunk the map after the
      -- entry load; a stale index must not report Found on a smaller map.
      let final_len = entries.len()
      if found >= 0 and found < final_len {
        SortedFound(found)
      } else {
        if lo > final_len { SortedMissing(final_len) } else { SortedMissing(lo) }
      }
    }
  }
}

pub(package) fn sorted_map_insert_entry_at<K, V>(m: SortedMap<K, V>, index: i64, entry: SortedEntry<K, V>) -> bool {
  let entries = sorted_map_vector<K, V>(m)
  let old_len = sorted_map_len<K, V>(m)
  if not entries.push(entry) {
    false
  } else {
    let mut i = old_len
    while i > index {
      entries.set(i, sorted_map_entry_at<K, V>(m, i - 1))
      i = i - 1
    }
    entries.set(index, entry)
  }
}

pub(package) fn sorted_map_remove_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> bool {
  let entries = sorted_map_vector<K, V>(m)
  let len = sorted_map_len<K, V>(m)
  if index < 0 or index >= len {
    false
  } else {
    let mut i = index
    while i + 1 < len {
      entries.set(i, sorted_map_entry_at<K, V>(m, i + 1))
      i = i + 1
    }
    entries.pop()
    true
  }
}

pub(package) fn sorted_map_put<K: Ord, V>(m: SortedMap<K, V>, key: K, value: V) -> bool {
  let entry = sorted_entry<K, V>(key, value)
  match sorted_map_find<K, V>(m, key) {
    SortedFound(index) -> {
      sorted_map_vector<K, V>(m).set(index, entry)
      false
    }
    SortedMissing(index) -> sorted_map_insert_entry_at<K, V>(m, index, entry)
  }
}

pub(package) fn sorted_map_get_option<K: Ord, V>(m: SortedMap<K, V>, key: K) -> Option<V> {
  match sorted_map_find<K, V>(m, key) {
    SortedFound(index) -> Some<V>(sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, index)))
    SortedMissing(index) -> None<V>()
  }
}

pub(package) fn sorted_map_contains<K: Ord, V>(m: SortedMap<K, V>, key: K) -> bool {
  match sorted_map_find<K, V>(m, key) {
    SortedFound(index) -> true
    SortedMissing(index) -> false
  }
}

pub(package) fn sorted_map_remove<K: Ord, V>(m: SortedMap<K, V>, key: K) -> Option<V> {
  match sorted_map_find<K, V>(m, key) {
    SortedFound(index) -> {
      let value = sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, index))
      if sorted_map_remove_entry_at<K, V>(m, index) { Some<V>(value) } else { None<V>() }
    }
    SortedMissing(index) -> None<V>()
  }
}

--- Copy keys into a new vector in ascending order.
pub(package) fn sorted_map_keys<K, V>(m: SortedMap<K, V>) -> Vector<K> {
  let len = sorted_map_len<K, V>(m)
  let out = vector.with_capacity<K>(len)
  for i in 0..len {
    out.push(sorted_entry_key<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

--- Copy values into a new vector ordered by their corresponding keys.
pub(package) fn sorted_map_values<K, V>(m: SortedMap<K, V>) -> Vector<V> {
  let len = sorted_map_len<K, V>(m)
  let out = vector.with_capacity<V>(len)
  for i in 0..len {
    out.push(sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

--- Fold entries in ascending key order with a pure callback.
pub(package) fn sorted_map_fold<K, V, A>(m: SortedMap<K, V>, init: A, f: (A, K, V) -> A) -> A {
  let mut acc = init
  for i in 0..sorted_map_len<K, V>(m) {
    let entry = sorted_map_entry_at<K, V>(m, i)
    acc = f(acc, sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry))
  }
  acc
}

impl<K, V> SortedMap<K, V> {
  --- Return the number of entries.
  pub fn len(self) -> i64 {
    sorted_map_len<K, V>(self)
  }

  --- Return whether this map has no entries.
  pub fn is_empty(self) -> bool {
    sorted_map_is_empty<K, V>(self)
  }

  --- Copy entries into a new vector in ascending key order.
  pub fn entries(self) -> Vector<(K, V)> {
    let out = vector.with_capacity<(K, V)>(self.len())
    for index in 0..self.len() {
      let entry = sorted_map_entry_at<K, V>(self, index)
      out.push((sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry)))
    }
    out
  }

  --- Copy keys into a new vector in ascending order.
  pub fn keys(self) -> Vector<K> {
    sorted_map_keys<K, V>(self)
  }

  --- Copy values into a new vector ordered by their keys.
  pub fn values(self) -> Vector<V> {
    sorted_map_values<K, V>(self)
  }

  --- Fold entries in ascending key order with a pure callback.
  pub fn fold<A>(self, init: A, f: (A, K, V) -> A) -> A {
    sorted_map_fold<K, V, A>(self, init, f)
  }
}

impl<K: Ord, V> SortedMap<K, V> {
  --- Insert or replace a key in place, returning whether it was newly inserted.
  pub fn insert(self, key: K, value: V) -> bool {
    sorted_map_put<K, V>(self, key, value)
  }

  --- Return the value for `key` when present.
  pub fn get(self, key: K) -> Option<V> {
    sorted_map_get_option<K, V>(self, key)
  }

  --- Return whether `key` is present.
  pub fn contains_key(self, key: K) -> bool {
    sorted_map_contains<K, V>(self, key)
  }

  --- Remove `key` in place and return its value when present.
  pub fn remove(self, key: K) -> Option<V> {
    sorted_map_remove<K, V>(self, key)
  }
}

impl<K: Ord, V> Collect for SortedMap<K, V> {
  type Item = (K, V)

  fn empty() -> Self {
    new<K, V>()
  }

  fn collect_from(self, source: owned Iterator<(K, V)>) -> Self {
    let mut values = source
    let mut done = false
    while not done {
      match iter_next<(K, V)>(values) {
        Some((key, value)) -> {
          self.insert(key, value)
          nil
        }
        None -> {
          done = true
          nil
        }
      }
    }
    self
  }
}
