-- stdlib/sorted_map.weft — vector-backed sorted maps
--
-- This first ordered collection surface is mutable and deterministic. The map
-- is a vector of entries sorted by a caller-supplied pure comparator:
--   cmp(a, b) < 0 when a < b, 0 when equal, > 0 when a > b.

use "stdlib/option.weft"
use "stdlib/ord.weft"
use "stdlib/string.weft"
use "stdlib/vector.weft"

type SortedEntry<K, V> {
  SortedEntry(K, V)
}

type SortedMap<K, V> {
  SortedMap(Vector<SortedEntry<K, V>>)
}

type SortedSearch {
  SortedFound(i64),
  SortedMissing(i64)
}

fn sorted_entry<K, V>(key: K, value: V) -> SortedEntry<K, V> {
  SortedEntry<K, V>(key, value)
}

fn sorted_entry_key<K, V>(entry: SortedEntry<K, V>) -> K {
  match entry {
    SortedEntry(key, value) -> key
  }
}

fn sorted_entry_value<K, V>(entry: SortedEntry<K, V>) -> V {
  match entry {
    SortedEntry(key, value) -> value
  }
}

fn sorted_search_index(search: SortedSearch) -> i64 {
  match search {
    SortedFound(index) -> index
    SortedMissing(index) -> index
  }
}

fn sorted_search_found(search: SortedSearch) -> i64 {
  match search {
    SortedFound(index) -> 1
    SortedMissing(index) -> 0
  }
}

fn sorted_cmp_i64(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

fn sorted_cmp_str(a: str, b: str) -> i64 {
  ord_compare<str>(a, b)
}

fn sorted_map_new<K, V>() -> SortedMap<K, V> {
  SortedMap<K, V>(vector_new<SortedEntry<K, V>>())
}

fn sorted_map_vector<K, V>(m: SortedMap<K, V>) -> Vector<SortedEntry<K, V>> {
  match m {
    SortedMap(entries) -> entries
  }
}

fn sorted_map_len<K, V>(m: SortedMap<K, V>) -> i64 {
  vector_len<SortedEntry<K, V>>(sorted_map_vector<K, V>(m))
}

fn sorted_map_is_empty<K, V>(m: SortedMap<K, V>) -> i64 {
  vector_is_empty<SortedEntry<K, V>>(sorted_map_vector<K, V>(m))
}

fn sorted_map_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> SortedEntry<K, V> {
  vector_get_in_bounds<SortedEntry<K, V>>(sorted_map_vector<K, V>(m), index)
}

-- Key of the entry at `index` without materialising an owned entry
-- reference: the map keeps the entry alive for the read, and the key
-- follows K's own ownership class (scalar keys copy, managed keys are
-- retained). Caller maintains bounds, like sorted_map_entry_at.
fn sorted_map_key_at<K, V>(m: SortedMap<K, V>, index: i64) -> K {
  vector_get_field_in_bounds<SortedEntry<K, V>, K>(sorted_map_vector<K, V>(m), index, 0)
}

fn sorted_map_find<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> i64) -> SortedSearch {
  -- Keep the backing vector as a scoped payload borrow from `m`: returning it
  -- through sorted_map_vector would manufacture an owned view only to release
  -- it after this search. Comparator-side mutation still reaches the same live
  -- vector and is observed by every length check.
  match m {
    SortedMap(entries) -> {
      let mut lo = 0
      let mut hi = vector_len<SortedEntry<K, V>>(entries)
      let mut found = 0 - 1
      while found < 0 and lo < hi {
        -- The caller-supplied comparator may mutate the map. Re-check the
        -- window against the current length before every entry load: a
        -- shrink clamps and resolves honestly instead of reading stale
        -- slots past len (use-after-free once element release is real).
        let len_now = vector_len<SortedEntry<K, V>>(entries)
        if hi > len_now { hi = len_now } else { 0 }
        if lo > len_now { lo = len_now } else { 0 }
        if lo < hi {
          let mid = lo + (hi - lo) / 2
          let c = cmp(key, vector_get_field_in_bounds<SortedEntry<K, V>, K>(entries, mid, 0))
          if c == 0 {
            found = mid
          } else {
            if c < 0 { hi = mid } else { lo = mid + 1 }
          }
        } else { 0 }
      }
      -- The matching comparator call itself may have shrunk the map after
      -- the entry load; a stale found index must not report Found on a
      -- smaller (or empty) map.
      let final_len = vector_len<SortedEntry<K, V>>(entries)
      if found >= 0 and found < final_len {
        SortedFound(found)
      } else {
        if lo > final_len { SortedMissing(final_len) } else { SortedMissing(lo) }
      }
    }
  }
}

fn sorted_map_insert_entry_at<K, V>(m: SortedMap<K, V>, index: i64, entry: SortedEntry<K, V>) -> i64 {
  let entries = sorted_map_vector<K, V>(m)
  let old_len = sorted_map_len<K, V>(m)
  vector_push<SortedEntry<K, V>>(entries, entry)
  let mut i = old_len
  while i > index {
    vector_set<SortedEntry<K, V>>(entries, i, sorted_map_entry_at<K, V>(m, i - 1))
    i = i - 1
  }
  vector_set<SortedEntry<K, V>>(entries, index, entry)
  1
}

fn sorted_map_remove_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> i64 {
  let entries = sorted_map_vector<K, V>(m)
  let len = sorted_map_len<K, V>(m)
  if index < 0 or index >= len {
    0
  } else {
    let mut i = index
    while i + 1 < len {
      vector_set<SortedEntry<K, V>>(entries, i, sorted_map_entry_at<K, V>(m, i + 1))
      i = i + 1
    }
    vector_pop<SortedEntry<K, V>>(entries)
    1
  }
}

fn sorted_map_put<K, V>(m: SortedMap<K, V>, key: K, value: V, cmp: (K, K) -> i64) -> i64 {
  let search = sorted_map_find<K, V>(m, key, cmp)
  let index = sorted_search_index(search)
  let entry = sorted_entry<K, V>(key, value)
  if sorted_search_found(search) == 1 {
    vector_set<SortedEntry<K, V>>(sorted_map_vector<K, V>(m), index, entry)
    0
  } else {
    sorted_map_insert_entry_at<K, V>(m, index, entry)
  }
}

fn sorted_map_get_option<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> i64) -> Option<V> {
  let search = sorted_map_find<K, V>(m, key, cmp)
  if sorted_search_found(search) == 1 {
    let entry = sorted_map_entry_at<K, V>(m, sorted_search_index(search))
    option_some<V>(sorted_entry_value<K, V>(entry))
  } else {
    option_none<V>()
  }
}

fn sorted_map_get<K, V>(m: SortedMap<K, V>, key: K, default: V, cmp: (K, K) -> i64) -> V {
  let opt = sorted_map_get_option<K, V>(m, key, cmp)
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn sorted_map_contains<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> i64) -> i64 {
  sorted_search_found(sorted_map_find<K, V>(m, key, cmp))
}

fn sorted_map_remove<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> i64) -> i64 {
  let search = sorted_map_find<K, V>(m, key, cmp)
  if sorted_search_found(search) == 1 {
    sorted_map_remove_entry_at<K, V>(m, sorted_search_index(search))
  } else {
    0
  }
}

fn sorted_map_entries<K, V>(m: SortedMap<K, V>) -> Vector<SortedEntry<K, V>> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<SortedEntry<K, V>>(len)
  for i in 0..len {
    vector_push<SortedEntry<K, V>>(out, sorted_map_entry_at<K, V>(m, i))
  }
  out
}

fn sorted_map_keys<K, V>(m: SortedMap<K, V>) -> Vector<K> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<K>(len)
  for i in 0..len {
    vector_push<K>(out, sorted_entry_key<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

fn sorted_map_values<K, V>(m: SortedMap<K, V>) -> Vector<V> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<V>(len)
  for i in 0..len {
    vector_push<V>(out, sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

fn sorted_map_fold<K, V, A>(m: SortedMap<K, V>, init: A, f: (A, K, V) -> A) -> A {
  let mut acc = init
  for i in 0..sorted_map_len<K, V>(m) {
    let entry = sorted_map_entry_at<K, V>(m, i)
    acc = f(acc, sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry))
  }
  acc
}
