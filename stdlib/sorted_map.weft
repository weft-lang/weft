-- stdlib/sorted_map.weft — vector-backed sorted maps
--
-- This first ordered collection surface is mutable and deterministic. The map
-- is a vector of entries sorted by a caller-supplied pure comparator.

use stdlib/option.{*}
use stdlib/generator.{*}
use stdlib/iter/core.{*}
use stdlib/ord.{*}
use stdlib/string.{*}
use stdlib/vector.{*}

--- A key-value entry returned by an ordered map snapshot.
pub type SortedEntry<K, V> {
  --- Pair one ordered-map key with its value.
  SortedEntry(K, V)
}

--- A mutable vector-backed map kept in caller-defined key order.
pub type SortedMap<K, V> {
  --- Wrap ordered entry storage; prefer `sorted_map_new` for construction.
  SortedMap(Vector<SortedEntry<K, V>>)
}

pub(package) type SortedSearch {
  SortedFound(i64),
  SortedMissing(i64)
}

--- Construct an ordered-map entry.
pub fn sorted_entry<K, V>(key: K, value: V) -> SortedEntry<K, V> {
  SortedEntry<K, V>(key, value)
}

--- Return an ordered-map entry's key.
pub fn sorted_entry_key<K, V>(entry: SortedEntry<K, V>) -> K {
  match entry {
    SortedEntry(key, value) -> key
  }
}

--- Return an ordered-map entry's value.
pub fn sorted_entry_value<K, V>(entry: SortedEntry<K, V>) -> V {
  match entry {
    SortedEntry(key, value) -> value
  }
}

--- Compare two `i64` values.
pub fn sorted_cmp_i64(a: i64, b: i64) -> Ordering {
  ord_compare<i64>(a, b)
}

--- Compare strings using their `Ord` implementation.
pub fn sorted_cmp_str(a: str, b: str) -> Ordering {
  ord_compare<str>(a, b)
}

--- Construct an empty mutable ordered map.
pub fn sorted_map_new<K, V>() -> SortedMap<K, V> {
  SortedMap<K, V>(vector_new<SortedEntry<K, V>>())
}

pub(package) fn sorted_map_vector<K, V>(m: SortedMap<K, V>) -> Vector<SortedEntry<K, V>> {
  match m {
    SortedMap(entries) -> entries
  }
}

--- Return the number of entries in an ordered map.
pub fn sorted_map_len<K, V>(m: SortedMap<K, V>) -> i64 {
  vector_len<SortedEntry<K, V>>(sorted_map_vector<K, V>(m))
}

--- Iterate key-value tuples in ascending comparator order.
pub fn sorted_map_into_iter<K, V>(m: SortedMap<K, V>) -> Iterator<(K, V)> {
  let producer = () => {
    let mut index = 0
    let mut done = 0
    while done == 0 {
      if index < sorted_map_len<K, V>(m) {
        let entry = sorted_map_entry_at<K, V>(m, index)
        generator_yield<(K, V)>((sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry)))
        index = index + 1
      } else {
        done = 1
      }
    }
    0
  }
  iter_from_generator<(K, V)>(generator_new<(K, V), i64>(producer))
}

impl<K, V> IntoIterator for SortedMap<K, V> {
  type Item = (K, V)

  fn into_iter(self: SortedMap<K, V>) -> Iterator<(K, V)> {
    sorted_map_into_iter<K, V>(self)
  }
}

--- Return whether the ordered map has no entries.
pub fn sorted_map_is_empty<K, V>(m: SortedMap<K, V>) -> bool {
  vector_is_empty<SortedEntry<K, V>>(sorted_map_vector<K, V>(m))
}

pub(package) fn sorted_map_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> SortedEntry<K, V> {
  vector_get_in_bounds<SortedEntry<K, V>>(sorted_map_vector<K, V>(m), index)
}

-- Key of the entry at `index` without materialising an owned entry
-- reference: the map keeps the entry alive for the read, and the key
-- follows K's own ownership class (scalar keys copy, managed keys are
-- retained). Caller maintains bounds, like sorted_map_entry_at.
pub(package) fn sorted_map_key_at<K, V>(m: SortedMap<K, V>, index: i64) -> K {
  vector_get_field_in_bounds<SortedEntry<K, V>, K>(sorted_map_vector<K, V>(m), index, 0)
}

pub(package) fn sorted_map_find<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> Ordering) -> SortedSearch {
  -- Keep the backing vector as a scoped payload borrow from `m`: returning it
  -- through sorted_map_vector would manufacture an owned view only to release
  -- it after this search. Comparator-side mutation still reaches the same live
  -- vector and is observed by every length check.
  match m {
    SortedMap(entries) -> {
      let mut lo = 0
      let mut hi = vector_len<SortedEntry<K, V>>(entries)
      let mut found = 0 - 1
      while found < 0 and lo < hi {
        -- The caller-supplied comparator may mutate the map. Re-check the
        -- window against the current length before every entry load: a
        -- shrink clamps and resolves honestly instead of reading stale
        -- slots past len (use-after-free once element release is real).
        let len_now = vector_len<SortedEntry<K, V>>(entries)
        if hi > len_now { hi = len_now } else { 0 }
        if lo > len_now { lo = len_now } else { 0 }
        if lo < hi {
          let mid = lo + (hi - lo) / 2
          match cmp(key, vector_get_field_in_bounds<SortedEntry<K, V>, K>(entries, mid, 0)) {
            Equal -> { found = mid }
            Less -> { hi = mid }
            Greater -> { lo = mid + 1 }
          }
        } else { 0 }
      }
      -- The matching comparator call itself may have shrunk the map after
      -- the entry load; a stale found index must not report Found on a
      -- smaller (or empty) map.
      let final_len = vector_len<SortedEntry<K, V>>(entries)
      if found >= 0 and found < final_len {
        SortedFound(found)
      } else {
        if lo > final_len { SortedMissing(final_len) } else { SortedMissing(lo) }
      }
    }
  }
}

pub(package) fn sorted_map_insert_entry_at<K, V>(m: SortedMap<K, V>, index: i64, entry: SortedEntry<K, V>) -> bool {
  let entries = sorted_map_vector<K, V>(m)
  let old_len = sorted_map_len<K, V>(m)
  if not vector_push<SortedEntry<K, V>>(entries, entry) {
    false
  } else {
    let mut i = old_len
    while i > index {
      vector_set<SortedEntry<K, V>>(entries, i, sorted_map_entry_at<K, V>(m, i - 1))
      i = i - 1
    }
    vector_set<SortedEntry<K, V>>(entries, index, entry)
  }
}

pub(package) fn sorted_map_remove_entry_at<K, V>(m: SortedMap<K, V>, index: i64) -> bool {
  let entries = sorted_map_vector<K, V>(m)
  let len = sorted_map_len<K, V>(m)
  if index < 0 or index >= len {
    false
  } else {
    let mut i = index
    while i + 1 < len {
      vector_set<SortedEntry<K, V>>(entries, i, sorted_map_entry_at<K, V>(m, i + 1))
      i = i + 1
    }
    vector_pop<SortedEntry<K, V>>(entries)
    true
  }
}

--- Insert or replace a key in place, returning whether a new key was inserted.
--- Use the same pure total-order comparator for every operation on `m`.
pub fn sorted_map_put<K, V>(m: SortedMap<K, V>, key: K, value: V, cmp: (K, K) -> Ordering) -> bool {
  let entry = sorted_entry<K, V>(key, value)
  match sorted_map_find<K, V>(m, key, cmp) {
    SortedFound(index) -> {
      vector_set<SortedEntry<K, V>>(sorted_map_vector<K, V>(m), index, entry)
      false
    }
    SortedMissing(index) -> sorted_map_insert_entry_at<K, V>(m, index, entry)
  }
}

--- Look up a key, returning `Some(value)` when present and `None` otherwise.
--- The comparator must match the one used to populate `m`.
pub fn sorted_map_get_option<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> Ordering) -> Option<V> {
  match sorted_map_find<K, V>(m, key, cmp) {
    SortedFound(index) -> Some<V>(sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, index)))
    SortedMissing(index) -> None<V>()
  }
}

--- Return the value for a key, or `default` when absent.
--- The comparator must match the one used to populate `m`.
pub fn sorted_map_get<K, V>(m: SortedMap<K, V>, key: K, default: V, cmp: (K, K) -> Ordering) -> V {
  let opt = sorted_map_get_option<K, V>(m, key, cmp)
  match opt {
    Some(value) -> value
    None -> default
  }
}

--- Return whether a key is present.
--- The comparator must match the one used to populate `m`.
pub fn sorted_map_contains<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> Ordering) -> bool {
  match sorted_map_find<K, V>(m, key, cmp) {
    SortedFound(index) -> true
    SortedMissing(index) -> false
  }
}

--- Remove a key in place, returning whether it was present.
--- The comparator must match the one used to populate `m`.
pub fn sorted_map_remove<K, V>(m: SortedMap<K, V>, key: K, cmp: (K, K) -> Ordering) -> bool {
  match sorted_map_find<K, V>(m, key, cmp) {
    SortedFound(index) -> sorted_map_remove_entry_at<K, V>(m, index)
    SortedMissing(index) -> false
  }
}

--- Copy entries into a new vector in ascending comparator order.
pub fn sorted_map_entries<K, V>(m: SortedMap<K, V>) -> Vector<SortedEntry<K, V>> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<SortedEntry<K, V>>(len)
  for i in 0..len {
    vector_push<SortedEntry<K, V>>(out, sorted_map_entry_at<K, V>(m, i))
  }
  out
}

--- Copy keys into a new vector in ascending comparator order.
pub fn sorted_map_keys<K, V>(m: SortedMap<K, V>) -> Vector<K> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<K>(len)
  for i in 0..len {
    vector_push<K>(out, sorted_entry_key<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

--- Copy values into a new vector ordered by their corresponding keys.
pub fn sorted_map_values<K, V>(m: SortedMap<K, V>) -> Vector<V> {
  let len = sorted_map_len<K, V>(m)
  let out = vector_with_capacity<V>(len)
  for i in 0..len {
    vector_push<V>(out, sorted_entry_value<K, V>(sorted_map_entry_at<K, V>(m, i)))
  }
  out
}

--- Fold entries in ascending comparator order with a pure callback.
pub fn sorted_map_fold<K, V, A>(m: SortedMap<K, V>, init: A, f: (A, K, V) -> A) -> A {
  let mut acc = init
  for i in 0..sorted_map_len<K, V>(m) {
    let entry = sorted_map_entry_at<K, V>(m, i)
    acc = f(acc, sorted_entry_key<K, V>(entry), sorted_entry_value<K, V>(entry))
  }
  acc
}
