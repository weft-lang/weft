-- stdlib/path.weft — target-native path byte identity
--
-- Path is not a str alias. It preserves arbitrary non-NUL native bytes while
-- offering fallible UTF-8 construction/display for ordinary text paths.

use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/bytes.{Bytes, InvalidUtf8, Utf8Error, bytes_equal, bytes_find, bytes_from_str, bytes_from_vector, bytes_get, bytes_is_empty, bytes_len, bytes_to_utf8, bytes_to_vector}
use stdlib/num.{num_i64_to_u8_checked, num_int_cast_value_or}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/vector_type.{Vector}
use stdlib/vector.{vector_data, vector_len}

pub type Path = opaque Bytes

pub type PathError {
  PathContainsNul(i64),
  PathInvalidUtf8(i64)
}

fn path_byte(value: i64) -> u8 {
  num_int_cast_value_or<u8>(num_i64_to_u8_checked(value), 0)
}

pub fn path_from_bytes(bytes: Bytes) -> Result<Path, PathError> {
  let nul = bytes_find(bytes, path_byte(0))
  if nul >= 0 {
    result_err<Path, PathError>(PathContainsNul(nul))
  } else {
    result_ok<Path, PathError>(Path(bytes))
  }
}

pub fn path_from_vector(bytes: Vector<u8>) -> Result<Path, PathError> {
  path_from_bytes(bytes_from_vector(bytes))
}

pub fn path_from_utf8(text: str) -> Result<Path, PathError> {
  let bytes = bytes_from_str(text)
  match bytes_to_utf8(bytes) {
    Ok(valid) -> path_from_bytes(bytes)
    Err(error) -> result_err<Path, PathError>(PathInvalidUtf8(utf8_error_offset(error)))
  }
}

fn utf8_error_offset(error: Utf8Error) -> i64 {
  match error {
    InvalidUtf8(offset) -> offset
  }
}

pub fn path_bytes(path: Path) -> Bytes {
  match path {
    Path(bytes) -> bytes
  }
}

-- Native path marshalling is package plumbing, never a public text coercion.
pub(package) fn path_runtime_string(path: Path) -> str {
  let values = bytes_to_vector(path_bytes(path))
  runtime_str_from_bytes_copy(vector_data<u8>(values), vector_len<u8>(values))
}

pub fn path_len(path: Path) -> i64 {
  bytes_len(path_bytes(path))
}

pub fn path_is_empty(path: Path) -> bool {
  bytes_is_empty(path_bytes(path))
}

pub fn path_is_absolute(path: Path) -> bool {
  match bytes_get(path_bytes(path), 0) {
    Some(first) -> first == path_byte(47)
    None -> false
  }
}

pub fn path_is_root(path: Path) -> bool {
  path_len(path) == 1 and path_is_absolute(path)
}

pub fn path_equal(left: Path, right: Path) -> bool {
  bytes_equal(path_bytes(left), path_bytes(right))
}

pub fn path_to_utf8(path: Path) -> Result<str, PathError> {
  match bytes_to_utf8(path_bytes(path)) {
    Ok(text) -> result_ok<str, PathError>(text)
    Err(error) -> result_err<str, PathError>(PathInvalidUtf8(utf8_error_offset(error)))
  }
}

pub fn path_error_kind(error: PathError) -> i64 {
  match error {
    PathContainsNul(offset) -> 1
    PathInvalidUtf8(offset) -> 2
  }
}

pub fn path_error_offset_or(error: PathError, default: i64) -> i64 {
  match error {
    PathContainsNul(offset) -> offset
    PathInvalidUtf8(offset) -> offset
  }
}
