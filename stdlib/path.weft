-- stdlib/path.weft — target-native path byte identity
--
-- Path is not a str alias. It preserves arbitrary non-NUL native bytes while
-- offering fallible UTF-8 construction/display for ordinary text paths.

use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, InvalidUtf8, Utf8Error}
use stdlib/num.{num_i64_to_u8_checked}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector/handles.{Vector}
use stdlib/vector.{vector_data}

--- A target-native path preserving arbitrary non-NUL bytes.
pub type Path = opaque Bytes

--- A path construction or text-conversion failure.
pub type PathError {
  --- A NUL byte at the reported offset, which native paths cannot contain.
  PathContainsNul(i64),
  --- Invalid UTF-8 beginning at the reported byte offset.
  PathInvalidUtf8(i64)
}

fn path_byte(value: i64) -> u8 {
  num_i64_to_u8_checked(value).unwrap_or(0)
}

--- Validate native bytes and construct a path without text coercion.
pub fn path_from_bytes(values: Bytes) -> Result<Path, PathError> {
  match values.find(path_byte(0)) {
    Some(nul) -> Err<Path, PathError>(PathContainsNul(nul))
    None -> Ok<Path, PathError>(Path(values))
  }
}

--- Copy and validate a mutable vector of native path bytes.
pub fn path_from_vector(values: Vector<u8>) -> Result<Path, PathError> {
  path_from_bytes(bytes.from_vector(values))
}

--- Construct a native path from UTF-8 text.
pub fn path_from_utf8(text: str) -> Result<Path, PathError> {
  let bytes = bytes.from_str(text)
  match bytes.to_utf8() {
    Ok(valid) -> path_from_bytes(bytes)
    Err(error) -> Err<Path, PathError>(PathInvalidUtf8(utf8_error_offset(error)))
  }
}

fn utf8_error_offset(error: Utf8Error) -> i64 {
  match error {
    InvalidUtf8(offset) -> offset
  }
}

--- Return the path's native bytes.
pub fn path_bytes(path: Path) -> Bytes {
  match path {
    Path(bytes) -> bytes
  }
}

-- Native path marshalling is package plumbing, never a public text coercion.
pub(package) fn path_runtime_string(path: Path) -> str {
  let values = path_bytes(path).to_vector()
  runtime_str_from_bytes_copy(vector_data<u8>(values), values.len())
}

--- Return the number of native path bytes.
pub fn path_len(path: Path) -> i64 {
  path_bytes(path).len()
}

--- Return whether the path contains no bytes.
pub fn path_is_empty(path: Path) -> bool {
  path_bytes(path).is_empty()
}

--- Return whether the path begins at the target's filesystem root.
pub fn path_is_absolute(path: Path) -> bool {
  match path_bytes(path).get(0) {
    Some(first) -> first == path_byte(47)
    None -> false
  }
}

--- Return whether the path names only the filesystem root.
pub fn path_is_root(path: Path) -> bool {
  path_len(path) == 1 and path_is_absolute(path)
}

--- Compare paths by their exact native bytes.
pub fn path_equal(left: Path, right: Path) -> bool {
  path_bytes(left).eq(path_bytes(right))
}

--- Decode the path as UTF-8 text, preserving invalid-text failure.
pub fn path_to_utf8(path: Path) -> Result<str, PathError> {
  match path_bytes(path).to_utf8() {
    Ok(text) -> Ok<str, PathError>(text)
    Err(error) -> Err<str, PathError>(PathInvalidUtf8(utf8_error_offset(error)))
  }
}

--- Return a stable discriminator for a path error.
pub fn path_error_kind(error: PathError) -> i64 {
  match error {
    PathContainsNul(offset) -> 1
    PathInvalidUtf8(offset) -> 2
  }
}

--- Return a path error's byte offset, or `default` for future error forms.
pub fn path_error_offset_or(error: PathError, default: i64) -> i64 {
  match error {
    PathContainsNul(offset) -> offset
    PathInvalidUtf8(offset) -> offset
  }
}
