-- stdlib/f64_table.weft — dense rectangular f64 tables
--
-- The opaque value owns its column count and a completely initialized
-- row-major storage vector. Callers cannot create partial rows, mutate the
-- storage length, repeat a mismatched width, or hide an invalid lookup behind
-- a default value.

use stdlib/option.{None, Option, Some}
use stdlib/num
use stdlib/result
use stdlib/vector as vector
use stdlib/vector.{*}

type F64TableParts {
  storage: Vector<f64>,
  columns: i64
}

--- A mutable, rectangular, row-major table of `f64` values.
pub type F64Table = opaque F64TableParts

-- These storage operations are the private optimizer contract. The
-- public API carries shape in F64Table and validates coordinates before it
-- reaches them; keeping this vocabulary private prevents callers from
-- manufacturing a mismatched shape.
fn f64_table_row_count(storage: Vector<f64>, columns: i64) -> i64 {
  vector_len<f64>(storage) / columns
}

fn f64_table_get(storage: Vector<f64>, row: i64, columns: i64, column: i64, fallback: f64) -> f64 {
  let index = row * columns + column
  if index < 0 or index >= vector_len<f64>(storage) { fallback }
  else { vector_get_in_bounds<f64>(storage, index) }
}

fn f64_table_set(storage: Vector<f64>, row: i64, columns: i64, column: i64, value: f64) -> bool {
  vector_set<f64>(storage, row * columns + column, value)
}

fn f64_table_size_valid(rows: i64, columns: i64) -> bool {
  rows >= 0 and columns > 0 and (rows == 0 or rows <= 1152921504606846975 / columns)
}

fn f64_table_coordinate_valid(parts: F64TableParts, row: i64, column: i64) -> bool {
  row >= 0 and row < f64_table_row_count(parts.storage, parts.columns) and column >= 0 and column < parts.columns
}

fn f64_table_filled(rows: i64, columns: i64, value: f64) -> Option<F64Table> {
  if not f64_table_size_valid(rows, columns) { None } else {
    let size = rows * columns
    let mut storage = vector.with_capacity<f64>(size.to_usize_checked().expect("table size is validated"))
    let mut index = 0
    while index < size {
      storage.push(value)
      index = index + 1
    }
    Some<F64Table>(F64Table(F64TableParts { storage: storage, columns: columns }))
  }
}

--- Construct a fully initialized rectangular table.
---
--- Zero rows are valid. A non-positive column count, a negative row count, or
--- a shape whose element count cannot fit in `i64` returns `None`.
pub fn filled(rows: i64, columns: i64, value: f64) -> Option<F64Table> {
  f64_table_filled(rows, columns, value)
}

--- Construct a zero-filled rectangular table.
pub fn zeros(rows: i64, columns: i64) -> Option<F64Table> {
  f64_table_filled(rows, columns, 0.0)
}

impl F64Table {
  --- Return the number of complete rows.
  pub fn rows(self) -> i64 {
    match self {
      F64Table(parts) -> f64_table_row_count(parts.storage, parts.columns)
    }
  }

  --- Return the number of columns in every row.
  pub fn columns(self) -> i64 {
    match self {
      F64Table(parts) -> parts.columns
    }
  }

  --- Return whether the table contains no rows.
  pub fn is_empty(self) -> bool {
    self.rows() == 0
  }

  --- Return the value at `(row, column)` when both coordinates are valid.
  pub fn get(self, row: i64, column: i64) -> Option<f64> {
    match self {
      F64Table(parts) -> {
        if f64_table_coordinate_valid(parts, row, column) {
          Some<f64>(f64_table_get(parts.storage, row, parts.columns, column, 0.0))
        } else {
          None
        }
      }
    }
  }

  --- Replace the value at `(row, column)`, returning whether it existed.
  pub fn set(self, row: i64, column: i64, value: f64) -> bool {
    match self {
      F64Table(parts) -> {
        if f64_table_coordinate_valid(parts, row, column) {
          f64_table_set(parts.storage, row, parts.columns, column, value)
        } else {
          false
        }
      }
    }
  }
}
