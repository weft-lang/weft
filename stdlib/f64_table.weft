-- stdlib/f64_table.weft — dense row-major f64 tables over Vector<f64>
--
-- Tables are ordinary f64 vectors with a caller-supplied row width. Literal
-- widths and fields give codegen enough evidence to lower hot loops like fixed
-- vector-record access while dynamic fields remain checked.

use stdlib/vector.{*}

--- Allocate an empty f64 vector reserved for `rows` rows of the given width.
---
--- Callers append row-major field values with `vector_push`; non-positive
--- dimensions produce an empty vector with no reserved table capacity.
pub fn f64_table_new(width: i64, rows: i64) -> Vector<f64> {
  if width <= 0 { vector_with_capacity<f64>(0) }
  else { if rows <= 0 { vector_with_capacity<f64>(0) }
  else { vector_with_capacity<f64>(width * rows) } }
}

--- Return the number of complete rows, or zero for a non-positive width.
pub fn f64_table_row_count(table: Vector<f64>, width: i64) -> i64 {
  if width <= 0 { 0 } else { vector_len<f64>(table) / width }
}

pub(package) fn f64_table_field_valid(width: i64, field: i64) -> bool {
  width > 0 and field >= 0 and field < width
}

pub(package) fn f64_table_slot(row: i64, width: i64, field: i64) -> i64 {
  row * width + field
}

--- Return a row-major field, or `default` when its field or slot is invalid.
pub fn f64_table_get(table: Vector<f64>, row: i64, width: i64, field: i64, default: f64) -> f64 {
  if not f64_table_field_valid(width, field) {
    default
  } else {
    vector_get<f64>(table, f64_table_slot(row, width, field), default)
  }
}

--- Set a row-major field, returning whether its field and slot were valid.
pub fn f64_table_set(table: Vector<f64>, row: i64, width: i64, field: i64, value: f64) -> bool {
  if not f64_table_field_valid(width, field) {
    false
  } else {
    vector_set<f64>(table, f64_table_slot(row, width, field), value)
  }
}
