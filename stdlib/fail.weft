-- stdlib/fail.weft — Fail effect for recoverable errors
--
-- The Fail effect represents recoverable failure. Functions that can fail
-- declare -[Fail]> in their effect signature. Handlers decide recovery:
--
--   handle risky_fn() {
--     Fail.fail(e) -> Err(e)
--     return v -> Ok(v)
--   }
--
-- The ? operator (when implemented) desugars to Fail.fail(e).

use "stdlib/result.weft"

effect Fail {
  fn fail(error: i64) -> i64
}

-- try_result (Fail -> Result conversion) was REMOVED 2026-08-03: it was
-- a latent miscompile. Tier 2 has no abort edge — a non-resuming clause's
-- value returns to the PERFORM SITE, so `handle Ok(f()) { Fail.fail(e) ->
-- Err(e) }` produced Ok(Err(e)) whenever the perform inside f was not in
-- tail position of the handle body. The generic replacement lands with
-- brief 4j (abort edge) + 4c phase F:
--   fn try_result<T, E>(f: () -[Fail<E>]> T) -> Result<T, E> {
--     handle f() {
--       Fail.fail(e) -> Err(e)
--       return v -> Ok(v)
--     }
--   }
