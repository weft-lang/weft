-- stdlib/fail.weft — Fail effect for recoverable errors
--
-- The Fail effect represents recoverable failure. Functions that can fail
-- declare -[Fail<E>]> in their effect signature. Handlers decide recovery:
--
--   handle risky_fn() {
--     Fail.fail(e) -> Err(e)
--     return v -> Ok(v)
--   }
--
-- The ? operator desugars to Fail.fail(e).

use "stdlib/result.weft"

effect Fail<E> {
  fn fail(error: E) -> never
}

fn try_result<T, E>(f: () -[Fail<E>]> T) -> Result<T, E> {
  handle f() {
    Fail.fail(error) -> Err<T, E>(error)
    return value -> Ok<T, E>(value)
  }
}
