-- stdlib/iter.weft -- pull iterators over generic generators

use "runtime/iter_state.weft"
use "runtime/rc.weft"
use "stdlib/generator.weft"
use "stdlib/option.weft"
use "stdlib/vector.weft"

type Iterator<T> {
  Iterator(i64, () -> i64)
}

fn iter_noop_drop() -> i64 { 0 }

fn iter_keep_generator_producer(producer: () -[GeneratorYield]> i64) -> i64 { 0 }

fn iter_make<T>(state: i64, dropper: () -> i64) -> Iterator<T> {
  Iterator<T>(state, dropper)
}

fn iter_from_generator<T>(g: Generator<T, i64>) -> Iterator<T> {
  iter_from_generator_with_dropper<T>(g, iter_noop_drop)
}

fn iter_from_generator_with_dropper<T>(g: Generator<T, i64>, dropper: () -> i64) -> Iterator<T> {
  let state = runtime_iter_state_new(runtime_iter_kind_generator(), g, 0, dropper)
  iter_make<T>(state, dropper)
}

fn iter_state<T>(it: Iterator<T>) -> i64 {
  match it {
    Iterator(state, dropper) -> state
  }
}

fn iter_dropper<T>(it: Iterator<T>) -> () -> i64 {
  match it {
    Iterator(state, dropper) -> dropper
  }
}

fn iter_range(start: i64, end: i64) -> Iterator<i64> {
  let state = runtime_iter_state_new(runtime_iter_kind_range_i64(), start, end, iter_noop_drop)
  iter_make<i64>(state, iter_noop_drop)
}

fn iter_close<T>(it: Iterator<T>) -> i64 {
  let state = iter_state<T>(it)
  if state == 0 { 0 } else {
    if runtime_iter_state_closed(state) == 1 {
      0
    } else {
      runtime_iter_state_set_closed(state, 1)
      let dropper = iter_dropper<T>(it)
      let dropped = dropper()
      runtime_iter_state_release_dropper(state)
      dropped
    }
  }
}

fn iter_next<T>(it: Iterator<T>) -> Option<T> {
  let state = iter_state<T>(it)
  let kind = runtime_iter_state_kind(state)
  if kind == runtime_iter_kind_generator() {
    if runtime_iter_state_closed(state) == 1 {
      None
    } else {
      let g = runtime_generator_state_word_as<Generator<T, i64>>(runtime_iter_state_first(state))
      let next = generator_next<T, i64>(g)
      match next {
        GeneratorNextDone -> {
          iter_close<T>(it)
          None
        }
        GeneratorNextValue(value) -> Some<T>(value)
      }
    }
  } else {
    if kind == runtime_iter_kind_range_i64() {
      let current = runtime_iter_state_first(state)
      let end = runtime_iter_state_second(state)
      if current >= end {
        iter_close<T>(it)
        None
      } else {
        runtime_iter_state_set_first(state, current + 1)
        Some<T>(runtime_generator_state_word_as<T>(current))
      }
    } else {
      None
    }
  }
}

fn iter_drop<T>(it: Iterator<T>) -> i64 {
  let state = iter_state<T>(it)
  let kind = runtime_iter_state_kind(state)
  if state == 0 {
    0
  } else {
    if runtime_iter_state_closed(state) == 1 {
      0
    } else {
      if kind == runtime_iter_kind_generator() {
        let g = runtime_generator_state_word_as<Generator<T, i64>>(runtime_iter_state_first(state))
        let dropped = generator_drop<T, i64>(g)
        iter_close<T>(it)
        dropped
      } else {
        if kind == runtime_iter_kind_range_i64() {
          runtime_iter_state_set_first(state, runtime_iter_state_second(state))
          iter_close<T>(it)
        } else {
          iter_close<T>(it)
        }
      }
    }
  }
}

fn iter_map<T, U>(it: Iterator<T>, f: (T) -> U) -> Iterator<U> {
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          generator_yield<U>(f(value))
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<U>(generator_new<U, i64>(producer), dropper)
}

fn iter_filter<T>(it: Iterator<T>, pred: (T) -> i64) -> Iterator<T> {
  let producer = () => {
    let mut done = 0
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          if pred(value) == 1 {
            generator_yield<T>(value)
          } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<T>(generator_new<T, i64>(producer), dropper)
}

fn iter_take<T>(it: Iterator<T>, limit: i64) -> Iterator<T> {
  let producer = () => {
    let mut remaining = limit
    let mut done = if limit <= 0 { 1 } else { 0 }
    while done == 0 {
      let next = iter_next<T>(it)
      match next {
        Some(value) -> {
          generator_yield<T>(value)
          remaining = remaining - 1
          if remaining <= 0 { done = 1 } else { 0 }
          0
        }
        None -> {
          done = 1
          0
        }
      }
    }
    0
  }
  let dropper = () => {
    iter_keep_generator_producer(producer)
    iter_drop<T>(it)
  }
  iter_from_generator_with_dropper<T>(generator_new<T, i64>(producer), dropper)
}

fn iter_fold<T, A>(it: Iterator<T>, init: A, f: (A, T) -> A) -> A {
  let mut acc = init
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        acc = f(acc, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  acc
}

fn iter_count<T>(it: Iterator<T>) -> i64 {
  let mut count = 0
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        count = count + 1
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  count
}

fn iter_collect_vector<T>(it: Iterator<T>) -> i64 {
  let result = vector_new<T>()
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        vector_push<T>(result, value)
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

fn iter_map_collect_vector<T, U>(it: Iterator<T>, f: (T) -> U) -> i64 {
  let result = vector_new<U>()
  let mut done = 0
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        vector_push<U>(result, f(value))
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

fn iter_filter_collect_i64(it: Iterator<i64>, pred: (i64) -> i64) -> i64 {
  let result = vector_new<i64>()
  let mut done = 0
  while done == 0 {
    let next = iter_next<i64>(it)
    match next {
      Some(value) -> {
        if pred(value) == 1 {
          vector_push<i64>(result, value)
        } else { 0 }
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  result
}

fn iter_take_collect_vector<T>(it: Iterator<T>, limit: i64) -> i64 {
  let result = vector_new<T>()
  let mut remaining = limit
  let mut done = if limit <= 0 { 1 } else { 0 }
  while done == 0 {
    let next = iter_next<T>(it)
    match next {
      Some(value) -> {
        vector_push<T>(result, value)
        remaining = remaining - 1
        if remaining <= 0 { done = 1 } else { 0 }
        0
      }
      None -> {
        done = 1
        0
      }
    }
  }
  iter_drop<T>(it)
  result
}
