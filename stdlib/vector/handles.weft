-- stdlib/vector/handles.weft -- sealed vector handle identities
-- The implementation lives in stdlib/vector.weft. Keeping the nominal handle
-- surface separate lets signatures name vectors without importing the full
-- collection implementation into parse/check/analysis-only consumers.

--- An opaque mutable growable contiguous sequence of `T` values.
pub type Vector<T> { }

--- An opaque immutable sequence whose updates return structurally shared versions.
pub type PersistentVector<T> { }

--- An immutable sequence holding a vector's own storage. Only a uniquely owned
--- vector freezes into one, so nothing can change it afterwards.
pub(package) type FrozenVector<T> { }

pub(package) type PersistentVectorStorageRegion { }
