-- stdlib/test/property/protocol.weft -- shared generation semantics

use stdlib/fail.{Fail}
use stdlib/bytes as immutable_bytes
use stdlib/bytes.{Bytes}
use stdlib/list.{Cons, List, Nil}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/persistent_vector as persistent_values
use stdlib/result.{Err, Ok, Result}
use stdlib/utf8 as utf8
use stdlib/vector as mutable_vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}
use stdlib/vector/handles.{Vector}
use stdlib/vector/handles.{PersistentVector}

--- A validated nonempty domain for one generator choice.
pub type ChoiceBound = opaque usize

--- One validated bounded choice, suitable for exact replay.
pub type Choice = opaque (ChoiceBound, usize)

type ChoiceData {
  bound: ChoiceBound,
  selected: usize
}

--- An immutable ordered program of generator choices.
pub type ChoiceLog = opaque PersistentVector<ChoiceData>

--- A violation of the bounded-choice handler contract.
pub type DrawContractFailure {
  --- The handler returned `selected` outside `[0, bound)`.
  ChoiceOutOfRange(usize, ChoiceBound)
}

--- A generator domain which cannot produce a value.
pub type BoundError {
  --- An exclusive upper bound of zero contains no value.
  EmptyChoiceDomain
}

--- A requested scalar interval contains no values.
pub type RangeError {
  --- The half-open interval has `start >= end`.
  EmptyRange
}

--- A requested alternative family contains no generators.
pub type AlternativeError {
  --- At least one alternative is required.
  NoAlternatives
}

--- An invalid weighted alternative family.
pub type FrequencyError {
  --- At least one weighted alternative is required.
  NoWeightedAlternatives,
  --- Every alternative must have a positive weight.
  ZeroWeight(usize),
  --- The total weight cannot be represented as `usize`.
  WeightTotalOverflow
}

--- An invalid inclusive collection-length domain.
pub type LengthError {
  --- The minimum length is greater than the maximum length.
  InvertedLengthRange,
  --- The inclusive domain contains more lengths than `usize` can count.
  LengthDomainTooWide
}

--- A validated inclusive finite domain of collection lengths.
pub type LengthRange = opaque LengthRangeData

type LengthRangeData {
  minimum: usize,
  maximum: usize
}

--- Bounded choice authority shared by random, replay, and enumeration.
pub effect Draw {
  --- Select one index from `[0, bound)`.
  fn choose(bound: ChoiceBound) -> usize
}

--- A sized typed computation whose choices are interpreted by `Draw`.
pub type Gen<T> = opaque ((usize, GenerationBudget) -[Draw, Fail<DrawContractFailure>]> Generation<T>)

--- Structural limits which make one generation exactly replayable.
pub type Limits = opaque LimitsData

type LimitsData {
  size: usize,
  discards: usize
}

type GenerationBudget {
  GenerationBudget(usize, usize)
}

type Generation<T> {
  Generated(T, GenerationBudget),
  GenerationRejected(GenerationBudget)
}

--- The exhaustive result of one generation under an explicit `Draw` handler.
pub type SampleResult<T> {
  --- One value was generated within the supplied limits.
  Sampled(T),
  --- Bounded refinement rejected every permitted specimen.
  SampleExhausted(usize),
  --- The active handler returned a choice outside its promised domain.
  SampleHandlerContractViolated(DrawContractFailure)
}

type DiscardStep {
  DiscardRemaining(GenerationBudget),
  DiscardExhausted(GenerationBudget)
}

--- Typed evidence that a default generator exists for `Self`.
pub trait Arbitrary {
  --- Construct a generator for the implementing type.
  fn arbitrary() -> Gen<Self>
}

fn choice_bound_value(bound: ChoiceBound) -> usize {
  match bound { ChoiceBound(value) -> value }
}

fn choice_log_values(log: ChoiceLog) -> PersistentVector<ChoiceData> {
  match log { ChoiceLog(values) -> values }
}

fn gen_body<T>(generator: Gen<T>) -> (usize, GenerationBudget) -[Draw, Fail<DrawContractFailure>]> Generation<T> {
  match generator { Gen(body) -> body }
}

fn limits_data(limits: Limits) -> LimitsData {
  match limits { Limits(data) -> data }
}

fn length_range_data(lengths: LengthRange) -> LengthRangeData {
  match lengths { LengthRange(data) -> data }
}

fn generated_length(lengths: LengthRange, size: usize) -[Draw, Fail<DrawContractFailure>]> usize {
  let minimum = lengths.minimum()
  let requested_maximum = lengths.maximum()
  let maximum = if requested_maximum < size {
    requested_maximum
  } else { if size < minimum { minimum } else { size } }
  if minimum == maximum {
    minimum
  } else {
    let bound = choice_bound_new(maximum - minimum + 1)
    minimum + choose_checked(bound)
  }
}

fn generation_budget(limit: usize) -> GenerationBudget {
  GenerationBudget(limit, 0)
}

fn budget_discard(budget: GenerationBudget) -> DiscardStep {
  match budget {
    GenerationBudget(remaining, discarded) -> {
      let next_discarded = match discarded.checked_add(1) {
        Some(value) -> value
        None -> discarded
      }
      if remaining == 0 {
        DiscardExhausted(GenerationBudget(0, next_discarded))
      } else {
        DiscardRemaining(GenerationBudget(remaining - 1, next_discarded))
      }
    }
  }
}

pub(package) fn choice_bound_new(upper: usize) -> ChoiceBound {
  ChoiceBound(upper)
}

pub(package) fn choice_new(bound: ChoiceBound, selected: usize) -> Choice {
  Choice((bound, selected))
}

pub(package) fn choice_log_empty() -> ChoiceLog {
  ChoiceLog(persistent_values.new<ChoiceData>())
}

pub(package) fn choice_worklist_push(
  bounds: borrow Vector<ChoiceBound>,
  selected_values: borrow Vector<usize>,
  bound: ChoiceBound,
  selected: usize
) -> nil {
  vector_push<ChoiceBound>(bounds, bound)
  vector_push<usize>(selected_values, selected)
  nil
}

pub(package) fn choice_log_snapshot(
  bounds: borrow Vector<ChoiceBound>,
  selected_values: borrow Vector<usize>
) -> ChoiceLog {
  let mut log = choice_log_empty()
  let mut index: i64 = 0
  let length = vector_len<ChoiceBound>(bounds)
  while index < length {
    let bound = vector_get_in_bounds<ChoiceBound>(bounds, index)
    let selected = vector_get_in_bounds<usize>(selected_values, index)
    log = ChoiceLog(choice_log_values(log).push(ChoiceData { bound: bound, selected: selected }))
    index = index + 1
  }
  log
}

pub(package) fn choice_log_set_selected(log: ChoiceLog, index: usize, selected: usize) -> Option<ChoiceLog> {
  match choice_log_values(log).get(index) {
    Some(data) -> if selected < choice_bound_value(data.bound) {
      match choice_log_values(log).set(index, ChoiceData { bound: data.bound, selected: selected }) {
        Some(values) -> Some<ChoiceLog>(ChoiceLog(values))
        None -> None<ChoiceLog>()
      }
    } else {
      None<ChoiceLog>()
    }
    None -> None<ChoiceLog>()
  }
}

pub(package) fn choice_log_remove_range(log: ChoiceLog, start: usize, count: usize) -> ChoiceLog {
  let values = choice_log_values(log)
  let end = match start.checked_add(count) {
    Some(value) -> value
    None -> values.len()
  }
  let mut next = persistent_values.new<ChoiceData>()
  let zero: usize = 0
  let one: usize = 1
  let mut index = zero
  while index < values.len() {
    if index < start or index >= end {
      match values.get(index) {
        Some(data) -> { next = next.push(data) }
        None -> nil
      }
    } else { nil }
    index = index + one
  }
  ChoiceLog(next)
}

fn generate_with_budget<T>(
  generator: Gen<T>,
  size: usize,
  budget: GenerationBudget
) -[Draw, Fail<DrawContractFailure>]> Generation<T> {
  let body = gen_body<T>(generator)
  body(size, budget)
}

fn generate<T>(generator: Gen<T>, limits: Limits) -[Draw, Fail<DrawContractFailure>]> Generation<T> {
  generate_with_budget<T>(generator, limits.size(), generation_budget(limits.discards()))
}

fn generation_discard_count(budget: GenerationBudget) -> usize {
  match budget { GenerationBudget(_, discarded) -> discarded }
}

--- Generate one value under the caller's explicit `Draw` interpretation.
---
--- The generator remains pure apart from bounded choice; exhaustion and a
--- faulty custom handler are returned as distinct typed outcomes.
pub fn sample<T>(generator: Gen<T>, limits: Limits) -[Draw]> SampleResult<T> {
  handle generate<T>(generator, limits) {
    Fail<DrawContractFailure>.fail(failure) -> SampleHandlerContractViolated<T>(failure)
    return outcome -> match outcome {
      Generated(value, _) -> Sampled<T>(value)
      GenerationRejected(budget) -> SampleExhausted<T>(generation_discard_count(budget))
    }
  }
}

fn choose_checked(bound: ChoiceBound) -[Draw, Fail<DrawContractFailure>]> usize {
  let selected = Draw.choose(bound)
  if selected < choice_bound_value(bound) {
    selected
  } else {
    Fail<DrawContractFailure>.fail(ChoiceOutOfRange(selected, bound))
  }
}

fn draw_u64_word(word: ChoiceBound) -[Draw, Fail<DrawContractFailure>]> u64 {
  let high = __usize_to_u64(choose_checked(word))
  let low = __usize_to_u64(choose_checked(word))
  (high bshl 32) bor low
}

--- Construct a generator which always returns `value` without drawing.
pub fn constant<T>(value: T) -> Gen<T> {
  Gen<T>((size, budget) => Generated<T>(value, budget))
}

--- Construct a generator over both boolean values.
pub fn boolean() -> Gen<bool> {
  let bound = choice_bound_new(2)
  Gen<bool>((size, budget) => Generated<bool>(choose_checked(bound) == 1, budget))
}

--- Construct a generator over the complete `u8` value set.
pub fn u8() -> Gen<u8> {
  let bound = choice_bound_new(256)
  Gen<u8>((size, budget) =>
    Generated<u8>(__u64_to_u8(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `u16` value set.
pub fn u16() -> Gen<u16> {
  let bound = choice_bound_new(65536)
  Gen<u16>((size, budget) =>
    Generated<u16>(__u64_to_u16(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `u32` value set.
pub fn u32() -> Gen<u32> {
  let bound = choice_bound_new(4294967296)
  Gen<u32>((size, budget) =>
    Generated<u32>(__u64_to_u32(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `u64` value set.
pub fn u64() -> Gen<u64> {
  let word = choice_bound_new(4294967296)
  Gen<u64>((size, budget) => Generated<u64>(draw_u64_word(word), budget))
}

--- Construct a generator over the complete `usize` value set.
pub fn usize() -> Gen<usize> {
  let word = choice_bound_new(4294967296)
  Gen<usize>((size, budget) => Generated<usize>(__u64_to_usize(draw_u64_word(word)), budget))
}

--- Construct a generator over the complete `i8` value set.
pub fn i8() -> Gen<i8> {
  let bound = choice_bound_new(256)
  Gen<i8>((size, budget) =>
    Generated<i8>(__u64_to_i8(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `i16` value set.
pub fn i16() -> Gen<i16> {
  let bound = choice_bound_new(65536)
  Gen<i16>((size, budget) =>
    Generated<i16>(__u64_to_i16(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `i32` value set.
pub fn i32() -> Gen<i32> {
  let bound = choice_bound_new(4294967296)
  Gen<i32>((size, budget) =>
    Generated<i32>(__u64_to_i32(__usize_to_u64(choose_checked(bound))), budget)
  )
}

--- Construct a generator over the complete `i64` value set.
pub fn i64() -> Gen<i64> {
  let word = choice_bound_new(4294967296)
  Gen<i64>((size, budget) => Generated<i64>(__u64_to_i64(draw_u64_word(word)), budget))
}

--- Construct a generator over the complete `isize` value set.
pub fn isize() -> Gen<isize> {
  let word = choice_bound_new(4294967296)
  Gen<isize>((size, budget) => Generated<isize>(__u64_to_isize(draw_u64_word(word)), budget))
}

--- Construct a generator over every `f32` bit pattern.
---
--- Signed zeros, subnormals, infinities, and NaN payloads are all retained.
pub fn f32() -> Gen<f32> {
  let word = choice_bound_new(4294967296)
  Gen<f32>((size, budget) => {
    let bits = __u64_to_u32(__usize_to_u64(choose_checked(word)))
    Generated<f32>(num.f32_from_bits(bits), budget)
  })
}

--- Construct a generator over every `f64` bit pattern.
---
--- Signed zeros, subnormals, infinities, and NaN payloads are all retained.
pub fn f64() -> Gen<f64> {
  let word = choice_bound_new(4294967296)
  Gen<f64>((size, budget) => Generated<f64>(num.f64_from_bits(draw_u64_word(word)), budget))
}

--- Construct a uniform generator over every finite `f32` bit pattern.
---
--- The contiguous choice domain maps around both non-finite exponent bands;
--- generation never rejects and preserves signed zeros and subnormals.
pub fn finite_f32() -> Gen<f32> {
  let patterns = choice_bound_new(4278190080)
  let sign_lane: usize = 2139095040
  Gen<f32>((size, budget) => {
    let selected = choose_checked(patterns)
    let magnitude = if selected < sign_lane { selected } else { selected - sign_lane }
    let sign: u64 = if selected < sign_lane { 0 } else { 2147483648 }
    let bits = __u64_to_u32(__usize_to_u64(magnitude) bor sign)
    Generated<f32>(num.f32_from_bits(bits), budget)
  })
}

--- Construct a uniform generator over every finite `f64` bit pattern.
---
--- The contiguous choice domain maps around both non-finite exponent bands;
--- generation never rejects and preserves signed zeros and subnormals.
pub fn finite_f64() -> Gen<f64> {
  let patterns = choice_bound_new(18437736874454810624)
  let sign_lane: usize = 9218868437227405312
  Gen<f64>((size, budget) => {
    let selected = choose_checked(patterns)
    let magnitude = if selected < sign_lane { selected } else { selected - sign_lane }
    let sign: u64 = if selected < sign_lane { 0 } else { 9223372036854775808 }
    Generated<f64>(num.f64_from_bits(__usize_to_u64(magnitude) bor sign), budget)
  })
}

--- Construct a generator over all Unicode scalar values.
---
--- Surrogate code points are excluded without rejection or bias.
pub fn unicode_scalar() -> Gen<i64> {
  let bound = choice_bound_new(1112064)
  Gen<i64>((size, budget) => {
    let selected = choose_checked(bound)
    let scalar = if selected < 55296 { selected } else { selected + 2048 }
    Generated<i64>(__u64_to_i64(__usize_to_u64(scalar)), budget)
  })
}

--- Construct a generator over `[0, exclusive_upper)`.
pub fn usize_below(exclusive_upper: usize) -> Result<Gen<usize>, BoundError> {
  if exclusive_upper == 0 {
    Err<Gen<usize>, BoundError>(EmptyChoiceDomain)
  } else {
    let bound = choice_bound_new(exclusive_upper)
    Ok<Gen<usize>, BoundError>(Gen<usize>((size, budget) => Generated<usize>(choose_checked(bound), budget)))
  }
}

--- Transform every generated value through one pure function.
pub fn map<T, U>(generator: Gen<T>, transform: (T) -> U) -> Gen<U> {
  Gen<U>((size, budget) => match generate_with_budget<T>(generator, size, budget) {
    Generated(value, next) -> Generated<U>(transform(value), next)
    GenerationRejected(final_budget) -> GenerationRejected<U>(final_budget)
  })
}

--- Select a subsequent generator from each generated value.
pub fn bind<T, U>(generator: Gen<T>, select: (T) -> Gen<U>) -> Gen<U> {
  Gen<U>((size, budget) => match generate_with_budget<T>(generator, size, budget) {
    Generated(value, next_budget) -> {
      let next = select(value)
      generate_with_budget<U>(next, size, next_budget)
    }
    GenerationRejected(final_budget) -> GenerationRejected<U>(final_budget)
  })
}

--- Construct a generator from the active structural size budget.
pub fn sized<T>(make: (usize) -> Gen<T>) -> Gen<T> {
  Gen<T>((size, budget) => generate_with_budget<T>(make(size), size, budget))
}

--- Run `generator` with an exact structural size budget.
pub fn resize<T>(generator: Gen<T>, size: usize) -> Gen<T> {
  Gen<T>((outer_size, budget) => generate_with_budget<T>(generator, size, budget))
}

--- Construct a generator over the half-open interval `[start, end)`.
pub fn usize_range(start: usize, end: usize) -> Result<Gen<usize>, RangeError> {
  if start >= end {
    Err<Gen<usize>, RangeError>(EmptyRange)
  } else {
    let bound = choice_bound_new(end - start)
    Ok<Gen<usize>, RangeError>(Gen<usize>((size, budget) =>
      Generated<usize>(start + choose_checked(bound), budget)
    ))
  }
}

--- Construct a generator over the half-open signed interval `[start, end)`.
pub fn i64_range(start: i64, end: i64) -> Result<Gen<i64>, RangeError> {
  if start >= end {
    Err<Gen<i64>, RangeError>(EmptyRange)
  } else {
    let sign: u64 = 9223372036854775808
    let first = __i64_to_u64(start) bxor sign
    let limit = __i64_to_u64(end) bxor sign
    let width = __u64_to_usize(limit - first)
    let bound = choice_bound_new(width)
    Ok<Gen<i64>, RangeError>(Gen<i64>((size, budget) => {
      let offset = __usize_to_u64(choose_checked(bound))
      Generated<i64>(__u64_to_i64((first + offset) bxor sign), budget)
    }))
  }
}

--- Generate `None` or a generated `Some` value as typed alternatives.
pub fn option<T>(generator: Gen<T>) -> Gen<Option<T>> {
  let bound = choice_bound_new(2)
  Gen<Option<T>>((size, budget) => match choose_checked(bound) {
    0 -> Generated<Option<T>>(None<T>(), budget)
    _ -> match generate_with_budget<T>(generator, size, budget) {
      Generated(value, next) -> Generated<Option<T>>(Some<T>(value), next)
      GenerationRejected(final_budget) -> GenerationRejected<Option<T>>(final_budget)
    }
  })
}

--- Generate either the declared error or success alternative.
pub fn result<T, E>(ok: Gen<T>, error: Gen<E>) -> Gen<Result<T, E>> {
  let bound = choice_bound_new(2)
  Gen<Result<T, E>>((size, budget) => match choose_checked(bound) {
    0 -> match generate_with_budget<E>(error, size, budget) {
      Generated(value, next) -> Generated<Result<T, E>>(Err<T, E>(value), next)
      GenerationRejected(final_budget) -> GenerationRejected<Result<T, E>>(final_budget)
    }
    _ -> match generate_with_budget<T>(ok, size, budget) {
      Generated(value, next) -> Generated<Result<T, E>>(Ok<T, E>(value), next)
      GenerationRejected(final_budget) -> GenerationRejected<Result<T, E>>(final_budget)
    }
  })
}

--- Generate both elements of a heterogeneous pair in source order.
pub fn pair<A, B>(first: Gen<A>, second: Gen<B>) -> Gen<(A, B)> {
  Gen<(A, B)>((size, budget) => match generate_with_budget<A>(first, size, budget) {
    GenerationRejected(final_budget) -> GenerationRejected<(A, B)>(final_budget)
    Generated(left, next_budget) -> match generate_with_budget<B>(second, size, next_budget) {
      GenerationRejected(final_budget) -> GenerationRejected<(A, B)>(final_budget)
      Generated(right, final_budget) -> Generated<(A, B)>((left, right), final_budget)
    }
  })
}

--- Select uniformly from a nonempty immutable family of generators.
pub fn one_of<T>(alternatives: List<Gen<T>>) -> Result<Gen<T>, AlternativeError> {
  if alternatives.is_empty() {
    Err<Gen<T>, AlternativeError>(NoAlternatives)
  } else {
    let bound = choice_bound_new(alternatives.len())
    Ok<Gen<T>, AlternativeError>(Gen<T>((size, budget) => {
      let index = choose_checked(bound)
      match alternatives.get(index) {
        Some(generator) -> generate_with_budget<T>(generator, size, budget)
        None -> Fail<DrawContractFailure>.fail(ChoiceOutOfRange(index, bound))
      }
    }))
  }
}

--- Select uniformly between two generators.
pub fn either<T>(left: Gen<T>, right: Gen<T>) -> Gen<T> {
  let bound = choice_bound_new(2)
  Gen<T>((size, budget) => match choose_checked(bound) {
    0 -> generate_with_budget<T>(left, size, budget)
    _ -> generate_with_budget<T>(right, size, budget)
  })
}

fn frequency_total<T>(alternatives: List<(usize, Gen<T>)>) -> Result<usize, FrequencyError> {
  let mut total: usize = 0
  let mut index: usize = 0
  let mut remaining = alternatives
  while not remaining.is_empty() {
    match remaining.first() {
      None -> nil
      Some((weight, _)) -> if weight == 0 {
        return Err<usize, FrequencyError>(ZeroWeight(index))
      } else {
        match total.checked_add(weight) {
          None -> return Err<usize, FrequencyError>(WeightTotalOverflow)
          Some(next) -> { total = next }
        }
      }
    }
    remaining = remaining.rest().unwrap_or(Nil<(usize, Gen<T>)>())
    index = index + 1
  }
  if total == 0 {
    Err<usize, FrequencyError>(NoWeightedAlternatives)
  } else {
    Ok<usize, FrequencyError>(total)
  }
}

fn frequency_select<T>(alternatives: List<(usize, Gen<T>)>, selected: usize) -> Option<Gen<T>> {
  match alternatives {
    Nil -> None<Gen<T>>()
    Cons((weight, generator), rest) -> if selected < weight {
      Some<Gen<T>>(generator)
    } else {
      frequency_select<T>(rest, selected - weight)
    }
  }
}

--- Select from a nonempty family in proportion to checked positive weights.
pub fn frequency<T>(alternatives: List<(usize, Gen<T>)>) -> Result<Gen<T>, FrequencyError> {
  match frequency_total<T>(alternatives) {
    Err(failure) -> Err<Gen<T>, FrequencyError>(failure)
    Ok(total) -> {
      let bound = choice_bound_new(total)
      Ok<Gen<T>, FrequencyError>(Gen<T>((size, budget) => {
        let selected = choose_checked(bound)
        match frequency_select<T>(alternatives, selected) {
          Some(generator) -> generate_with_budget<T>(generator, size, budget)
          None -> Fail<DrawContractFailure>.fail(ChoiceOutOfRange(total, bound))
        }
      }))
    }
  }
}

--- Consume generated values until `select` returns an accepted value.
---
--- Each rejected value spends one discard and is released exactly once.
--- `max_attempts` and the active replay limits are both hard bounds.
pub fn filter_map<T, U>(
  generator: Gen<T>,
  max_attempts: usize,
  select: (T) -> Option<U>
) -> Gen<U> {
  Gen<U>((size, initial_budget) => {
    let mut budget = initial_budget
    let mut attempts: usize = 0
    while attempts < max_attempts {
      match generate_with_budget<T>(generator, size, budget) {
        GenerationRejected(final_budget) -> return GenerationRejected<U>(final_budget)
        Generated(value, next_budget) -> match select(value) {
          Some(selected) -> return Generated<U>(selected, next_budget)
          None -> match budget_discard(next_budget) {
            DiscardExhausted(final_budget) -> return GenerationRejected<U>(final_budget)
            DiscardRemaining(remaining) -> { budget = remaining }
          }
        }
      }
      attempts = attempts + 1
    }
    GenerationRejected<U>(budget)
  })
}

--- Validate an inclusive collection-length domain.
---
--- The active structural size caps the generated maximum but never violates
--- an explicit minimum.
pub fn lengths(minimum: usize, maximum: usize) -> Result<LengthRange, LengthError> {
  if minimum > maximum {
    Err<LengthRange, LengthError>(InvertedLengthRange)
  } else {
    match (maximum - minimum).checked_add(1) {
      None -> Err<LengthRange, LengthError>(LengthDomainTooWide)
      Some(_) -> Ok<LengthRange, LengthError>(LengthRange(LengthRangeData {
        minimum: minimum,
        maximum: maximum
      }))
    }
  }
}

--- Construct a bounded immutable list generator in source order.
pub fn list<T>(items: Gen<T>, lengths: LengthRange) -> Gen<List<T>> {
  Gen<List<T>>((size, initial_budget) => {
    let length = generated_length(lengths, size)
    let mut budget = initial_budget
    let mut reversed = Nil<T>()
    let mut index: usize = 0
    while index < length {
      match generate_with_budget<T>(items, size, budget) {
        GenerationRejected(final_budget) -> return GenerationRejected<List<T>>(final_budget)
        Generated(value, next_budget) -> {
          reversed = Cons<T>(value, reversed)
          budget = next_budget
        }
      }
      index = index + 1
    }
    Generated<List<T>>(reversed.reverse(), budget)
  })
}

--- Construct a bounded uniquely owned mutable vector generator.
pub fn vector<T>(items: Gen<T>, lengths: LengthRange) -> Gen<owned Vector<T>> {
  Gen<owned Vector<T>>((size, initial_budget) => {
    let length = generated_length(lengths, size)
    let mut budget = initial_budget
    let mut values = mutable_vector.with_capacity<T>(length)
    let mut index: usize = 0
    while index < length {
      match generate_with_budget<T>(items, size, budget) {
        GenerationRejected(final_budget) -> return GenerationRejected<owned Vector<T>>(final_budget)
        Generated(value, next_budget) -> {
          values.push(value)
          budget = next_budget
        }
      }
      index = index + 1
    }
    Generated<owned Vector<T>>(values, budget)
  })
}

--- Construct a bounded immutable persistent-vector generator.
pub fn persistent_vector<T>(items: Gen<T>, lengths: LengthRange) -> Gen<PersistentVector<T>> {
  Gen<PersistentVector<T>>((size, initial_budget) => {
    let length = generated_length(lengths, size)
    let mut budget = initial_budget
    let mut values = persistent_values.new<T>()
    let mut index: usize = 0
    while index < length {
      match generate_with_budget<T>(items, size, budget) {
        GenerationRejected(final_budget) -> return GenerationRejected<PersistentVector<T>>(final_budget)
        Generated(value, next_budget) -> {
          values = values.push(value)
          budget = next_budget
        }
      }
      index = index + 1
    }
    Generated<PersistentVector<T>>(values, budget)
  })
}

fn vector_to_bytes(values: owned Vector<u8>) -> Bytes {
  immutable_bytes.from_vector(values)
}

--- Construct a bounded immutable arbitrary-byte sequence generator.
pub fn bytes(lengths: LengthRange) -> Gen<Bytes> {
  map<owned Vector<u8>, Bytes>(vector<u8>(u8(), lengths), vector_to_bytes)
}

fn scalar_list_to_str(values: List<i64>) -> str {
  utf8.from_scalars(values).expect("unicode_scalar produced an invalid scalar")
}

--- Construct a bounded canonical Unicode string generator.
---
--- Lengths count Unicode scalars, not encoded bytes. Every generated value is
--- valid UTF-8; surrogate values never enter the generated domain.
pub fn str(lengths: LengthRange) -> Gen<str> {
  map<List<i64>, str>(list<i64>(unicode_scalar(), lengths), scalar_list_to_str)
}

--- Construct the stable structural limits used by generation and replay.
pub fn limits(size: usize, discards: usize) -> Limits {
  Limits(LimitsData { size: size, discards: discards })
}

--- Resolve the default generator for `T` through typed evidence.
pub fn gen<T: Arbitrary>() -> Gen<T> {
  T.arbitrary()
}

impl Limits {
  --- Return the structural recursion size budget.
  pub fn size(self) -> usize { limits_data(self).size }

  --- Return the maximum rejected specimens permitted per generated case.
  pub fn discards(self) -> usize { limits_data(self).discards }
}

impl LengthRange {
  --- Return the inclusive minimum generated collection length.
  pub fn minimum(self) -> usize { length_range_data(self).minimum }

  --- Return the inclusive maximum before applying the active size cap.
  pub fn maximum(self) -> usize { length_range_data(self).maximum }
}

impl ChoiceBound {
  --- Return the exclusive upper limit.
  pub fn exclusive_upper(self) -> usize { choice_bound_value(self) }
}

impl Choice {
  --- Return the nonempty domain used by this choice.
  pub fn bound(self) -> ChoiceBound {
    match self { Choice((bound, selected)) -> bound }
  }

  --- Return the selected value, which is strictly below `bound`.
  pub fn selected(self) -> usize {
    match self { Choice((bound, selected)) -> selected }
  }
}

impl ChoiceLog {
  --- Return the number of choices in this replay program.
  pub fn len(self) -> usize { choice_log_values(self).len() }

  --- Return the choice at `index`, when present.
  pub fn get(self, index: usize) -> Option<Choice> {
    match choice_log_values(self).get(index) {
      Some(data) -> Some<Choice>(choice_new(data.bound, data.selected))
      None -> None<Choice>()
    }
  }
}
