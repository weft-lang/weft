-- stdlib/test/property/random.weft -- deterministic random Draw handler

use stdlib/persistent_vector as persistent_vector
use stdlib/random as deterministic
use stdlib/random.{Algorithm, Seed, State}
use stdlib/test/property/protocol.{ChoiceBound, ChoiceLog, Draw, choice_log_snapshot, choice_worklist_push}
use stdlib/vector as vector
use stdlib/vector.{vector_clear, vector_get_in_bounds, vector_push, vector_set}
use stdlib/vector/handles.{Vector}

type SessionData {
  state: Vector<State>,
  choice_bounds: Vector<ChoiceBound>,
  selected_values: Vector<usize>
}

--- Mutable handler-local state for one deterministic random campaign.
pub type Session = opaque SessionData

fn session_data(session: Session) -> SessionData {
  match session { Session(data) -> data }
}

fn session_states(session: Session) -> Vector<State> {
  session_data(session).state
}

fn session_choice_bounds(session: Session) -> Vector<ChoiceBound> {
  session_data(session).choice_bounds
}

fn session_selected_values(session: Session) -> Vector<usize> {
  session_data(session).selected_values
}

fn session_state(session: Session) -> State {
  let states = session_states(session)
  vector_get_in_bounds<State>(states, 0)
}

fn session_set_state(session: Session, state: State) -> nil {
  let states = session_states(session)
  vector_set<State>(states, 0, state)
  nil
}

--- Prepare a deterministic random interpretation from `seed`.
pub fn session(seed: Seed) -> Session {
  let states = vector.with_capacity<State>(1)
  vector_push<State>(states, deterministic.from_seed(seed))
  Session(SessionData {
    state: states,
    choice_bounds: vector.new<ChoiceBound>(),
    selected_values: vector.new<usize>()
  })
}

pub(package) fn begin_case(session: Session) -> nil {
  let bounds = session_choice_bounds(session)
  let selected = session_selected_values(session)
  vector_clear<ChoiceBound>(bounds)
  vector_clear<usize>(selected)
}

--- Return the stable algorithm interpreting this session.
pub fn algorithm(session: Session) -> Algorithm {
  session_state(session).algorithm()
}

--- Snapshot the choices made since the current case began.
pub fn choices(session: Session) -> ChoiceLog {
  let bounds = session_choice_bounds(session)
  let selected = session_selected_values(session)
  choice_log_snapshot(bounds, selected)
}

--- Interpret `Draw` with deterministic unbiased bounded selection.
pub implements Draw(session: Session) {
  Draw.choose(bound) -> {
    let random_bound = deterministic.bound(bound.exclusive_upper()).expect("Draw bounds are nonempty")
    let (next, selected) = session_state(session).next_below(random_bound)
    session_set_state(session, next)
    let bounds = session_choice_bounds(session)
    let selected_values = session_selected_values(session)
    choice_worklist_push(bounds, selected_values, bound, selected)
    resume(selected)
  }
}
