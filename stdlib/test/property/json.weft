-- stdlib/test/property/json.weft -- bounded JSON value generation

use stdlib/json.{Json, JsonArray, JsonBool, JsonEntry, JsonFloat, JsonNull, JsonNumber, JsonObject, JsonString}
use stdlib/list.{Cons, List, Nil}
use stdlib/result.{*}
use stdlib/test/property as prop
use stdlib/test/property.{Gen}

fn as_bool(value: bool) -> Json { JsonBool(value) }

fn as_integer(value: i64) -> Json { JsonNumber(value) }

fn as_float(value: f64) -> Json { JsonFloat(value) }

fn as_string(value: str) -> Json { JsonString(value) }

fn as_array(items: List<Json>) -> Json { JsonArray(items) }

fn as_entry(pair: (str, Json)) -> JsonEntry {
  match pair { (key, value) -> JsonEntry(key, value) }
}

fn as_object(entries: List<JsonEntry>) -> Json { JsonObject(entries) }

fn increment(value: usize) -> usize { value + 1 }

fn scalar_generator() -> Gen<Json> {
  let text_lengths = prop.lengths(0, 8).expect("ordered JSON string lengths")
  prop.one_of<Json>(Cons<Gen<Json>>(
    prop.constant<Json>(JsonNull),
    Cons<Gen<Json>>(
      prop.map<bool, Json>(prop.boolean(), as_bool),
      Cons<Gen<Json>>(
        prop.map<i64, Json>(prop.i64(), as_integer),
        Cons<Gen<Json>>(
          prop.map<f64, Json>(prop.finite_f64(), as_float),
          Cons<Gen<Json>>(
            prop.map<str, Json>(prop.str(text_lengths), as_string),
            Nil<Gen<Json>>()
          )
        )
      )
    )
  )).expect("JSON has scalar alternatives")
}

fn aggregate_length(size: usize) -> Gen<usize> {
  let nonempty = prop.usize_below(size).expect("positive JSON aggregate budget")
  prop.either<usize>(
    prop.constant<usize>(0),
    prop.map<usize, usize>(nonempty, increment)
  )
}

fn child_size(size: usize, length: usize) -> usize {
  let zero: usize = 0
  let one: usize = 1
  if length == zero { zero } else { size / length - one }
}

fn array_at_size(size: usize) -> Gen<Json> {
  prop.bind<usize, Json>(aggregate_length(size), (length) => {
    let exact = prop.lengths(length, length).expect("exact JSON array length")
    let child = prop.resize<Json>(value(), child_size(size, length))
    prop.map<List<Json>, Json>(prop.list<Json>(child, exact), as_array)
  })
}

fn entry_at_size(size: usize) -> Gen<JsonEntry> {
  let key_lengths = prop.lengths(0, 8).expect("ordered JSON object key lengths")
  let key = prop.resize<str>(prop.str(key_lengths), size)
  let item = prop.resize<Json>(value(), size)
  prop.map<(str, Json), JsonEntry>(prop.pair<str, Json>(key, item), as_entry)
}

fn object_at_size(size: usize) -> Gen<Json> {
  prop.bind<usize, Json>(aggregate_length(size), (length) => {
    let exact = prop.lengths(length, length).expect("exact JSON object length")
    let child = entry_at_size(child_size(size, length))
    prop.map<List<JsonEntry>, Json>(prop.list<JsonEntry>(child, exact), as_object)
  })
}

fn value_at_size(size: usize) -> Gen<Json> {
  if size == 0 {
    scalar_generator()
  } else {
    prop.one_of<Json>(Cons<Gen<Json>>(
      scalar_generator(),
      Cons<Gen<Json>>(
        array_at_size(size),
        Cons<Gen<Json>>(object_at_size(size), Nil<Gen<Json>>())
      )
    )).expect("JSON has value alternatives")
  }
}

--- Construct a bounded generator over non-recursive JSON values.
---
--- Floating numbers are finite and strings contain canonical Unicode text.
pub fn scalar() -> Gen<Json> {
  scalar_generator()
}

--- Construct a bounded generator over serializable JSON values.
---
--- The active property size is a structural-node budget distributed across
--- recursive children, so generated trees grow linearly rather than
--- exponentially. Floating numbers are always finite; strings and object keys
--- are canonical Unicode text; object order and duplicate keys are preserved.
pub fn value() -> Gen<Json> {
  prop.sized<Json>(value_at_size)
}
