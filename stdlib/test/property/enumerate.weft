-- stdlib/test/property/enumerate.weft -- bounded exhaustive Draw interpretation

use stdlib/option.{*}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/panic.{panic}
use stdlib/test/property/protocol.{ChoiceBound, ChoiceLog, Draw, Gen, Limits, Sampled, SampleExhausted, SampleHandlerContractViolated, choice_log_snapshot, sample}
use stdlib/test/property/protocol.{ChoiceOutOfRange}
use stdlib/vector as vector
use stdlib/vector.{vector_clear, vector_get_in_bounds, vector_push, vector_set}
use stdlib/vector/handles.{Vector}

--- Explicit total bounds for one deterministic enumeration.
pub type Budget = opaque BudgetData

type BudgetData {
  paths: usize,
  choice_depth: usize
}

--- Whether an enumeration visitor needs another generated value.
pub type Visit {
  --- Continue with the next choice program.
  VisitNext,
  --- Stop after recording the current choice program.
  VisitStop
}

--- The exhaustive outcome of bounded choice-program enumeration.
pub type Outcome {
  --- Every reachable choice program completed within the bounds.
  EnumerationComplete(usize, usize),
  --- The visitor stopped after `paths` programs and `values` specimens.
  EnumerationStopped(usize, usize, ChoiceLog),
  --- More choice programs exist beyond the total path budget.
  EnumerationPathLimitReached(usize, usize),
  --- A generator requested a choice beyond the configured depth.
  EnumerationDepthLimitReached(usize, usize, usize, ChoiceBound)
}

type SessionData {
  selected: Vector<usize>,
  bounds: Vector<ChoiceBound>,
  cursor: Vector<EnumerationCursor>
}

type EnumerationCursor {
  position: usize,
  plan_length: usize,
  maximum_depth: usize
}

type Session = opaque SessionData

type Advance {
  EnumerationAdvanced,
  EnumerationFinished
}

fn budget_data(budget: Budget) -> BudgetData {
  match budget { Budget(data) -> data }
}

fn session_data(session: Session) -> SessionData {
  match session { Session(data) -> data }
}

fn session_selected(session: Session) -> Vector<usize> {
  session_data(session).selected
}

fn session_bounds(session: Session) -> Vector<ChoiceBound> {
  session_data(session).bounds
}

fn session_cursors(session: Session) -> Vector<EnumerationCursor> {
  session_data(session).cursor
}

fn session_cursor(session: Session) -> EnumerationCursor {
  let cursors = session_cursors(session)
  vector_get_in_bounds<EnumerationCursor>(cursors, 0)
}

fn session_set_cursor(session: Session, cursor: EnumerationCursor) -> nil {
  let cursors = session_cursors(session)
  vector_set<EnumerationCursor>(cursors, 0, cursor)
  nil
}

fn session_position(session: Session) -> usize {
  session_cursor(session).position
}

fn session_plan_length(session: Session) -> usize {
  session_cursor(session).plan_length
}

fn session_maximum_depth(session: Session) -> usize {
  session_cursor(session).maximum_depth
}

fn session_set_position(session: Session, position: usize) -> nil {
  let cursor = session_cursor(session)
  session_set_cursor(session, EnumerationCursor {
    position: position,
    plan_length: cursor.plan_length,
    maximum_depth: cursor.maximum_depth
  })
}

fn session_set_plan_length(session: Session, length: usize) -> nil {
  let cursor = session_cursor(session)
  session_set_cursor(session, EnumerationCursor {
    position: cursor.position,
    plan_length: length,
    maximum_depth: cursor.maximum_depth
  })
}

fn session(maximum_depth: usize) -> Session {
  let mut cursors = vector.with_capacity<EnumerationCursor>(1)
  cursors.push(EnumerationCursor {
    position: 0,
    plan_length: 0,
    maximum_depth: maximum_depth
  })
  Session(SessionData {
    selected: vector.new<usize>(),
    bounds: vector.new<ChoiceBound>(),
    cursor: cursors
  })
}

fn session_begin_path(session: Session) -> nil {
  let bounds = session_bounds(session)
  vector_clear<ChoiceBound>(bounds)
  session_set_position(session, 0)
}

fn session_choose(session: Session, bound: ChoiceBound) -> usize {
  let position = session_position(session)
  if position >= session_maximum_depth(session) {
    bound.exclusive_upper()
  } else {
    let selected_values = session_selected(session)
    let storage_position = num_scalar_usize_to_i64(position).expect("enumeration choice index fits storage")
    let selected = if position < session_plan_length(session) {
      vector_get_in_bounds<usize>(selected_values, storage_position)
    } else {
      let zero: usize = 0
      if position < selected_values.len() {
        vector_set<usize>(selected_values, storage_position, zero)
      } else {
        vector_push<usize>(selected_values, zero)
      }
      session_set_plan_length(session, position + 1)
      zero
    }
    if selected >= bound.exclusive_upper() {
      panic("enumeration choice plan changed its bound")
    } else {
      let bounds = session_bounds(session)
      vector_push<ChoiceBound>(bounds, bound)
      session_set_position(session, position + 1)
      selected
    }
  }
}

fn session_choices(session: Session) -> ChoiceLog {
  let bounds = session_bounds(session)
  let selected = session_selected(session)
  choice_log_snapshot(bounds, selected)
}

fn session_advance(session: Session) -> Advance {
  let bounds = session_bounds(session)
  let selected = session_selected(session)
  let mut remaining = bounds.len()
  while remaining > 0 {
    let position = remaining - 1
    let storage_position = num_scalar_usize_to_i64(position).expect("enumeration choice index fits storage")
    let current = vector_get_in_bounds<usize>(selected, storage_position)
    let upper = vector_get_in_bounds<ChoiceBound>(bounds, storage_position).exclusive_upper()
    if current + 1 < upper {
      vector_set<usize>(selected, storage_position, current + 1)
      session_set_plan_length(session, position + 1)
      return EnumerationAdvanced
    }
    remaining = position
  }
  EnumerationFinished
}

--- Construct explicit path-count and per-path choice-depth bounds.
---
--- A zero path budget performs no generation. A zero choice depth can still
--- enumerate generators which make no choices.
pub fn budget(paths: usize, choice_depth: usize) -> Budget {
  Budget(BudgetData { paths: paths, choice_depth: choice_depth })
}

--- Enumerate finite choice programs in stable lexicographic order.
---
--- Each generated value is consumed exactly once by `visit`. Rejected
--- generation paths count toward the path budget but do not call `visit`.
--- Unrelated visitor effects remain explicit and unhandled.
pub fn run<T, E>(
  generator: Gen<T>,
  limits: Limits,
  enumeration_budget: Budget,
  visit: (T) -[E]> Visit
) -[E]> Outcome {
  let maximum_paths = enumeration_budget.paths()
  let active = session(enumeration_budget.choice_depth())
  let mut paths: usize = 0
  let mut values: usize = 0
  while paths < maximum_paths {
    session_begin_path(active)
    let generated = handle sample<T>(generator, limits) {
      Draw.choose(bound) -> resume(session_choose(active, bound))
    }
    paths = paths + 1
    match generated {
      SampleHandlerContractViolated(ChoiceOutOfRange(_, bound)) ->
        return EnumerationDepthLimitReached(paths, values, session_position(active), bound)
      SampleExhausted(_) -> nil
      Sampled(value) -> {
        values = values + 1
        match visit(value) {
          VisitNext -> nil
          VisitStop -> return EnumerationStopped(paths, values, session_choices(active))
        }
      }
    }
    match session_advance(active) {
      EnumerationAdvanced -> nil
      EnumerationFinished -> return EnumerationComplete(paths, values)
    }
  }
  EnumerationPathLimitReached(paths, values)
}

impl Budget {
  --- Return the maximum number of choice programs to execute.
  pub fn paths(self) -> usize { budget_data(self).paths }

  --- Return the maximum choices permitted in one program.
  pub fn choice_depth(self) -> usize { budget_data(self).choice_depth }
}
