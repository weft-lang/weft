-- stdlib/test/report.weft -- native Test failure values and human rendering
--
-- This is compiler-generated Test harness support. Applications use the
-- public stdlib/test assertions; report construction, rendering, and raw
-- stderr transport remain package-private implementation details.

use runtime/syscall.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/num.{num_render_f64}
use stdlib/string.{*}
use stdlib/vector.{*}

pub(package) fn test_report_fields(test_name: str, assertion: str, details: DiagnosticFieldList) -> DiagnosticFieldList {
  DiagnosticFieldCons(
    DiagnosticFieldText("test", test_name),
    DiagnosticFieldCons(DiagnosticFieldText("assertion", assertion), details)
  )
}

pub(package) fn test_report_diagnostic(test_name: str, assertion: str, details: DiagnosticFieldList) -> Diagnostic {
  diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassTest,
    DiagnosticCodeUnassigned,
    "assertion failed",
    DiagnosticLocationNone,
    DiagnosticRelatedLocationNil,
    test_report_fields(test_name, assertion, details)
  )
}

pub(package) fn test_report_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> {
      match field {
        DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { test_report_text_field(rest, key, fallback) }
        _ -> test_report_text_field(rest, key, fallback)
      }
    }
  }
}

pub(package) fn test_report_i64_field(fields: DiagnosticFieldList, key: str, fallback: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> {
      match field {
        DiagnosticFieldI64(name, value) -> if str_eq(name, key) == 1 { value } else { test_report_i64_field(rest, key, fallback) }
        _ -> test_report_i64_field(rest, key, fallback)
      }
    }
  }
}

pub(package) fn test_report_bool_field(fields: DiagnosticFieldList, key: str, fallback: bool) -> bool {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> {
      match field {
        DiagnosticFieldBool(name, value) -> if str_eq(name, key) == 1 { value } else { test_report_bool_field(rest, key, fallback) }
        _ -> test_report_bool_field(rest, key, fallback)
      }
    }
  }
}

pub(package) fn test_report_write(text: str) -> i64 {
  sys_write(2, __str_ptr(text), __str_len(text))
}

pub(package) fn test_report_write_i64(value: i64) -> i64 {
  test_report_write(int_to_str(value))
}

pub(package) fn test_report_render_header(diagnostic: Diagnostic) -> i64 {
  let fields = diagnostic.fields()
  test_report_write("test failure: ")
  test_report_write(test_report_text_field(fields, "test", "<unknown>"))
  test_report_write("\n")
  test_report_write("test assertion failed: ")
  test_report_write(test_report_text_field(fields, "assertion", "<unknown>"))
  test_report_write("\n")
}

pub(package) fn test_report_write_bool(value: bool) -> i64 {
  test_report_write(if value { "true" } else { "false" })
}

pub(package) fn test_report_write_hex_byte(value: i64) -> i64 {
  let digits = "0123456789abcdef"
  sys_write(2, __str_ptr(digits) + (value / 16) % 16, 1)
  sys_write(2, __str_ptr(digits) + value % 16, 1)
}

-- Render a string on one unambiguous line. Printable UTF-8 bytes survive
-- unchanged; ASCII controls and syntax bytes use stable escapes.
pub(package) fn test_report_write_quoted(value: str) -> i64 {
  test_report_write("\"")
  let n = str_len(value)
  let mut i = 0
  while i < n {
    let byte = str_byte_at(value, i)
    if byte == 34 { test_report_write("\\\"") }
    else { if byte == 92 { test_report_write("\\\\") }
    else { if byte == 10 { test_report_write("\\n") }
    else { if byte == 13 { test_report_write("\\r") }
    else { if byte == 9 { test_report_write("\\t") }
    else { if byte < 32 or byte == 127 {
      test_report_write("\\x")
      test_report_write_hex_byte(byte)
    } else {
      sys_write(2, __str_ptr(value) + i, 1)
    } } } } } }
    i = i + 1
  }
  test_report_write("\"")
}

pub(package) fn test_report_simple(test_name: str, assertion: str) -> i64 {
  test_report_render_header(test_report_diagnostic(test_name, assertion, DiagnosticFieldNil))
}

pub(package) fn test_report_i64(test_name: str, assertion: str, actual: i64, expected: i64) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldI64("actual", actual),
      DiagnosticFieldCons(DiagnosticFieldI64("expected", expected), DiagnosticFieldNil)
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  expected: ")
  test_report_write_i64(test_report_i64_field(fields, "expected", 0))
  test_report_write("\n  actual:   ")
  test_report_write_i64(test_report_i64_field(fields, "actual", 0))
  test_report_write("\n")
}

pub(package) fn test_report_i64_unexpected(test_name: str, assertion: str, actual: i64, unexpected: i64) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldI64("actual", actual),
      DiagnosticFieldCons(DiagnosticFieldI64("unexpected", unexpected), DiagnosticFieldNil)
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  unexpected: ")
  test_report_write_i64(test_report_i64_field(fields, "unexpected", 0))
  test_report_write("\n  actual:     ")
  test_report_write_i64(test_report_i64_field(fields, "actual", 0))
  test_report_write("\n")
}

pub(package) fn test_report_bool(test_name: str, assertion: str, actual: bool, expected: bool) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldBool("actual", actual),
      DiagnosticFieldCons(DiagnosticFieldBool("expected", expected), DiagnosticFieldNil)
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  expected: ")
  test_report_write_bool(test_report_bool_field(fields, "expected", false))
  test_report_write("\n  actual:   ")
  test_report_write_bool(test_report_bool_field(fields, "actual", false))
  test_report_write("\n")
}

pub(package) fn test_report_f64(test_name: str, assertion: str, actual: f64, expected: f64) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldText("actual", num_render_f64(actual)),
      DiagnosticFieldCons(DiagnosticFieldText("expected", num_render_f64(expected)), DiagnosticFieldNil)
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  expected: ")
  test_report_write(test_report_text_field(fields, "expected", "<unavailable>"))
  test_report_write("\n  actual:   ")
  test_report_write(test_report_text_field(fields, "actual", "<unavailable>"))
  test_report_write("\n")
}

pub(package) fn test_report_f64_near(test_name: str, assertion: str, actual: f64, expected: f64, epsilon: f64) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldText("actual", num_render_f64(actual)),
      DiagnosticFieldCons(
        DiagnosticFieldText("expected", num_render_f64(expected)),
        DiagnosticFieldCons(DiagnosticFieldText("epsilon", num_render_f64(epsilon)), DiagnosticFieldNil)
      )
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  expected: ")
  test_report_write(test_report_text_field(fields, "expected", "<unavailable>"))
  test_report_write("\n  actual:   ")
  test_report_write(test_report_text_field(fields, "actual", "<unavailable>"))
  test_report_write("\n  epsilon:  ")
  test_report_write(test_report_text_field(fields, "epsilon", "<unavailable>"))
  test_report_write("\n")
}

pub(package) fn test_report_first_string_mismatch(actual: str, expected: str) -> i64 {
  let actual_n = str_len(actual)
  let expected_n = str_len(expected)
  let limit = if actual_n < expected_n { actual_n } else { expected_n }
  let mut i = 0
  while i < limit and str_byte_at(actual, i) == str_byte_at(expected, i) {
    i = i + 1
  }
  if i < limit or actual_n != expected_n { i } else { 0 - 1 }
}

pub(package) fn test_report_string(test_name: str, assertion: str, actual: str, expected: str) -> i64 {
  let mismatch = test_report_first_string_mismatch(actual, expected)
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldText("actual", actual),
      DiagnosticFieldCons(
        DiagnosticFieldText("expected", expected),
        DiagnosticFieldCons(DiagnosticFieldI64("first_mismatch_byte", mismatch), DiagnosticFieldNil)
      )
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  diff at byte ")
  test_report_write_i64(test_report_i64_field(fields, "first_mismatch_byte", 0 - 1))
  test_report_write(":\n    - expected ")
  test_report_write_quoted(test_report_text_field(fields, "expected", ""))
  test_report_write("\n    + actual   ")
  test_report_write_quoted(test_report_text_field(fields, "actual", ""))
  test_report_write("\n")
}

pub(package) fn test_report_string_unexpected(test_name: str, assertion: str, actual: str) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(DiagnosticFieldText("actual", actual), DiagnosticFieldNil)
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  value was unexpectedly equal: ")
  test_report_write_quoted(test_report_text_field(fields, "actual", ""))
  test_report_write("\n")
}

pub(package) fn test_report_i64_detail(test_name: str, assertion: str, label: str, value: i64) -> i64 {
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(DiagnosticFieldI64(label, value), DiagnosticFieldNil)
  )
  test_report_render_header(diagnostic)
  test_report_write("  ")
  test_report_write(label)
  test_report_write(": ")
  test_report_write_i64(value)
  test_report_write("\n")
}

pub(package) fn test_report_i64_vector_equal(actual: Vector<i64>, expected: Vector<i64>) -> bool {
  let actual_n = actual.len()
  let expected_n = expected.len()
  if actual_n != expected_n { false }
  else {
    let mut equal = true
    let mut i = 0
    while i < actual_n {
      if vector_get_in_bounds<i64>(actual, i) != vector_get_in_bounds<i64>(expected, i) { equal = false } else { 0 }
      i = i + 1
    }
    equal
  }
}

pub(package) fn test_report_first_i64_vector_mismatch(actual: Vector<i64>, expected: Vector<i64>) -> i64 {
  let actual_n = actual.len()
  let expected_n = expected.len()
  let limit = if actual_n < expected_n { actual_n } else { expected_n }
  let mut i = 0
  while i < limit and vector_get_in_bounds<i64>(actual, i) == vector_get_in_bounds<i64>(expected, i) {
    i = i + 1
  }
  if i < limit or actual_n != expected_n { i } else { 0 - 1 }
}

pub(package) fn test_report_i64_vector_text(values: Vector<i64>) -> str {
  let limit = 16
  let n = values.len()
  let shown = if n < limit { n } else { limit }
  let mut out = "["
  let mut i = 0
  while i < shown {
    if i > 0 { out = str_concat(out, ", ") } else { 0 }
    out = str_concat(out, int_to_str(vector_get_in_bounds<i64>(values, i)))
    i = i + 1
  }
  if n > shown {
    str_concat(out, str_concat(", … (", str_concat(int_to_str(n), " items)]")))
  } else {
    str_concat(out, "]")
  }
}

pub(package) fn test_report_i64_vector(test_name: str, assertion: str, actual: Vector<i64>, expected: Vector<i64>) -> i64 {
  let mismatch = test_report_first_i64_vector_mismatch(actual, expected)
  let actual_n = actual.len()
  let expected_n = expected.len()
  let diagnostic = test_report_diagnostic(
    test_name,
    assertion,
    DiagnosticFieldCons(
      DiagnosticFieldText("actual", test_report_i64_vector_text(actual)),
      DiagnosticFieldCons(
        DiagnosticFieldText("expected", test_report_i64_vector_text(expected)),
        DiagnosticFieldCons(
          DiagnosticFieldI64("first_mismatch_index", mismatch),
          DiagnosticFieldCons(
            DiagnosticFieldI64("actual_length", actual_n),
            DiagnosticFieldCons(DiagnosticFieldI64("expected_length", expected_n), DiagnosticFieldNil)
          )
        )
      )
    )
  )
  let fields = diagnostic.fields()
  test_report_render_header(diagnostic)
  test_report_write("  collection diff at index ")
  test_report_write_i64(test_report_i64_field(fields, "first_mismatch_index", 0 - 1))
  test_report_write(" (expected length ")
  test_report_write_i64(test_report_i64_field(fields, "expected_length", 0))
  test_report_write(", actual length ")
  test_report_write_i64(test_report_i64_field(fields, "actual_length", 0))
  test_report_write("):\n    - expected ")
  test_report_write(test_report_text_field(fields, "expected", "[]"))
  test_report_write("\n    + actual   ")
  test_report_write(test_report_text_field(fields, "actual", "[]"))
  test_report_write("\n")
}
