  test_report_write("  expected: ")
  test_report_write_u64(test_report_u64_field(fields, "expected", 0))
  test_report_write("\n  actual:   ")
  test_report_write_u64(test_report_u64_field(fields, "actual", 0))
  test_report_write("\n")
}

