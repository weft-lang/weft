-- stdlib/io/transfer.weft — loop-correct safe transfer combinators
--
-- These helpers know nothing about descriptors or sockets. File, console and
-- network handlers provide one typed transfer callback; interruption, short
-- progress, EOF and caller bounds have one implementation everywhere.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/io/types.{IoEndOfFile, IoError, IoInterrupted, IoInvalidProgress, IoLimitExceeded, IoReadBytes, IoReadProgress, IoUnexpectedEof, IoWriteProgress, IoWroteBytes}
use stdlib/num
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds}
use stdlib/vector/handles.{Vector}

pub(package) fn io_transfer_chunk_size() -> i64 { 4096 }

fn io_helper_usize_to_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

fn io_helper_i64_to_usize(value: i64) -> usize {
  value.to_usize_checked().unwrap_or(0)
}

fn io_helper_scratch(size: i64) -> Vector<u8> {
  let mut scratch = vector.with_capacity<u8>(io_helper_i64_to_usize(size))
  for i in 0..size {
    scratch.push(0)
  }
  scratch
}

fn io_helper_copy_slice(values: [mut u8], count: i64) -> Vector<u8> {
  let mut copied = vector.with_capacity<u8>(io_helper_i64_to_usize(count))
  for i in 0..count {
    copied.push(values[io_helper_i64_to_usize(i)])
  }
  copied
}

fn io_helper_append_vector(out: borrow mut Vector<u8>, values: Vector<u8>) -> i64 {
  let count = io_helper_usize_to_i64(values.len())
  for i in 0..count {
    out.push(vector_get_in_bounds<u8>(values, i))
  }
  count
}

--- Read through `read` until EOF, returning at most `limit` owned bytes.
---
--- Interrupted reads retry. A one-byte probe distinguishes exact-limit EOF
--- from excess input; zero/over-reported progress is `IoInvalidProgress` and
--- input beyond the bound is `IoLimitExceeded`. The callback effect `E` is
--- preserved in the helper's signature.
pub fn read_all<E>(
  limit: usize,
  read: ([mut u8]) -[E]> Result<IoReadProgress, IoError>
) -[E]> Result<Bytes, IoError> {
  let limit_i64 = io_helper_usize_to_i64(limit)
  if limit_i64 < 0 {
    Err<Bytes, IoError>(IoLimitExceeded(limit))
  } else {
    let chunk = io_transfer_chunk_size()
    let mut scratch = io_helper_scratch(chunk)
    let mut out = vector.with_capacity<u8>(io_helper_i64_to_usize(if limit_i64 < chunk { limit_i64 } else { chunk }))
    let mut done = false
    let mut failed = false
    let mut failure = IoInvalidProgress
    while not done and not failed {
      let out_len = io_helper_usize_to_i64(out.len())
      let remaining = limit_i64 - out_len
      -- The one-byte probe distinguishes exact-limit EOF from truncation.
      let request = if remaining < chunk { remaining + 1 } else { chunk }
      let writable: [mut u8] = scratch[..io_helper_i64_to_usize(request)]
      match read(writable) {
        Err(error) -> {
          match error {
            IoInterrupted -> 0
            _ -> {
              failure = error
              failed = true
              0
            }
          }
        }
        Ok(progress) -> match progress {
          IoEndOfFile -> {
            done = true
            0
          }
          IoReadBytes(count) -> {
            let n = io_helper_usize_to_i64(count)
            if n <= 0 or n > request {
              failure = IoInvalidProgress
              failed = true
            } else { if out_len + n > limit_i64 {
              failure = IoLimitExceeded(limit)
              failed = true
            } else {
              let copied = io_helper_copy_slice(writable, n)
              io_helper_append_vector(out, copied)
            } }
            0
          }
        }
      }
    }
    if failed {
      Err<Bytes, IoError>(failure)
    } else {
      Ok<Bytes, IoError>(bytes.from_vector(out))
    }
  }
}

--- Read exactly `expected` bytes through `read`.
---
--- Interrupted reads retry; early EOF reports `IoUnexpectedEof` with the
--- completed byte count, and zero/over-reported progress is invalid. The
--- callback effect `E` is preserved.
pub fn read_exact<E>(
  expected: usize,
  read: ([mut u8]) -[E]> Result<IoReadProgress, IoError>
) -[E]> Result<Bytes, IoError> {
  let expected_i64 = io_helper_usize_to_i64(expected)
  if expected_i64 < 0 {
    Err<Bytes, IoError>(IoLimitExceeded(expected))
  } else {
    let chunk = io_transfer_chunk_size()
    let mut scratch = io_helper_scratch(chunk)
    let mut out = vector.with_capacity<u8>(io_helper_i64_to_usize(if expected_i64 < chunk { expected_i64 } else { chunk }))
    let mut failed = false
    let mut failure = IoInvalidProgress
    while io_helper_usize_to_i64(out.len()) < expected_i64 and not failed {
      let remaining = expected_i64 - io_helper_usize_to_i64(out.len())
      let request = if remaining < chunk { remaining } else { chunk }
      let writable: [mut u8] = scratch[..io_helper_i64_to_usize(request)]
      match read(writable) {
        Err(error) -> {
          match error {
            IoInterrupted -> 0
            _ -> {
              failure = error
              failed = true
              0
            }
          }
        }
        Ok(progress) -> match progress {
          IoEndOfFile -> {
            failure = IoUnexpectedEof(out.len())
            failed = true
            0
          }
          IoReadBytes(count) -> {
            let n = io_helper_usize_to_i64(count)
            if n <= 0 or n > request {
              failure = IoInvalidProgress
              failed = true
            } else {
              let copied = io_helper_copy_slice(writable, n)
              io_helper_append_vector(out, copied)
            }
            0
          }
        }
      }
    }
    if failed {
      Err<Bytes, IoError>(failure)
    } else {
      Ok<Bytes, IoError>(bytes.from_vector(out))
    }
  }
}

--- Write every byte through `write` and return the completed byte count.
---
--- Interrupted writes retry. Zero progress or a count beyond the supplied
--- slice reports `IoInvalidProgress`; other typed errors are preserved along
--- with the callback effect `E`.
pub fn write_all<E>(
  values: Bytes,
  write: ([u8]) -[E]> Result<IoWriteProgress, IoError>
) -[E]> Result<usize, IoError> {
  let contiguous = values.to_vector()
  let total = io_helper_usize_to_i64(contiguous.len())
  let mut offset = 0
  let mut failed = false
  let mut failure = IoInvalidProgress
  while offset < total and not failed {
    let remaining: [u8] = contiguous[io_helper_i64_to_usize(offset)..]
    match write(remaining) {
      Err(error) -> {
        match error {
          IoInterrupted -> 0
          _ -> {
            failure = error
            failed = true
            0
          }
        }
      }
      Ok(progress) -> match progress {
        IoWroteBytes(count) -> {
          let n = io_helper_usize_to_i64(count)
          if n <= 0 or n > total - offset {
            failure = IoInvalidProgress
            failed = true
          } else {
            offset = offset + n
          }
          0
        }
      }
    }
  }
  if failed {
    Err<usize, IoError>(failure)
  } else {
    Ok<usize, IoError>(io_helper_i64_to_usize(offset))
  }
}
