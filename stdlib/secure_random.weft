-- stdlib/secure_random.weft — capability-scoped cryptographic randomness
--
-- SecureRandom is deliberately distinct from deterministic pseudo-random
-- generators. Production handlers draw operating-system entropy; the
-- explicitly named deterministic handler exists for tests and reproducible
-- evaluation only.

use stdlib/bytes.{Bytes, bytes_empty, bytes_from_vector, bytes_get, bytes_len}
use stdlib/num.{num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/option.{None, Some}
use stdlib/result.{Result, result_err, result_ok}
use stdlib/vector.{vector_get_in_bounds, vector_new, vector_push, vector_set}
use stdlib/vector/handles.{Vector}

--- A recoverable failure to produce cryptographically secure bytes.
pub type SecureRandomError {
  --- A deterministic test handler did not contain enough remaining bytes.
  SecureRandomExhausted(usize, usize),
  --- The requested count cannot be represented by the current target.
  SecureRandomLimitExceeded(usize),
  --- The production entropy source returned an unmapped platform error.
  SecureRandomPlatform(i64)
}

--- Authority to obtain cryptographically secure random bytes.
pub effect SecureRandom {
  --- Produce exactly `count` fresh bytes or return a typed failure.
  fn bytes(count: usize) -> Result<Bytes, SecureRandomError>
}

--- Obtain exactly `count` cryptographically secure bytes.
pub fn secure_random_bytes(count: usize) -[SecureRandom]> Result<Bytes, SecureRandomError> {
  SecureRandom.bytes(count)
}

fn secure_random_count_i64(count: usize) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(count)), 0 - 1)
}

fn secure_random_deterministic_bytes(source: Bytes, start: i64, raw_count: i64) -> Bytes {
  if raw_count == 0 {
    bytes_empty()
  } else {
    let out = vector_new<u8>()
    for i in 0..raw_count {
      match bytes_get(source, start + i) {
        Some(value) -> vector_push<u8>(out, value)
        None -> 0
      }
    }
    bytes_from_vector(out)
  }
}

-- This handler is intentionally explicit in both module and function name.
-- It consumes the seed without wrapping: a request succeeds only when the
-- complete next range exists, and a failed request consumes nothing.
--- Run a computation with an exact deterministic test byte stream.
pub fn secure_random_with_deterministic<T, E>(source: Bytes, body: () -[SecureRandom, E]> T) -[E]> T {
  let cursor: Vector<i64> = vector_new<i64>()
  vector_push<i64>(cursor, 0)
  handle body() {
    SecureRandom.bytes(count) -> {
      let start = vector_get_in_bounds<i64>(cursor, 0)
      let raw_count = secure_random_count_i64(count)
      let available = bytes_len(source) - start
      if raw_count < 0 {
        resume(result_err<Bytes, SecureRandomError>(SecureRandomLimitExceeded(count)))
      } else { if raw_count > available {
        resume(result_err<Bytes, SecureRandomError>(SecureRandomExhausted(count, __i64_to_usize(if available < 0 { 0 } else { available }))))
      } else {
        let values = secure_random_deterministic_bytes(source, start, raw_count)
        vector_set<i64>(cursor, 0, start + raw_count)
        resume(result_ok<Bytes, SecureRandomError>(values))
      } }
    }
  }
}
