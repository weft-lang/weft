-- stdlib/time/wall.weft -- civil wall-clock observation

use stdlib/ord.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/time as time
use stdlib/time.{Duration}

--- A Unix-epoch wall-clock timestamp with millisecond precision.
pub type Timestamp = opaque i64

--- Why a wall-clock reading could not be supplied.
pub type WallClockError {
  --- The selected handler could not read its wall clock.
  WallClockUnavailable
}

fn timestamp_value(value: Timestamp) -> i64 {
  match value { Timestamp(milliseconds) -> milliseconds }
}

impl Ord for Timestamp {
  fn compare(self: Self, other: Self) -> Ordering {
    timestamp_value(self).compare(timestamp_value(other))
  }
}

--- Authority to observe Unix-epoch wall-clock time.
pub effect WallClock {
  --- Read the current Unix-epoch timestamp or a typed clock failure.
  fn now() -> Result<Timestamp, WallClockError>
}

--- Construct a Unix-epoch timestamp for conversion, policy, or testing.
pub fn milliseconds_since_unix_epoch(value: i64) -> Timestamp {
  Timestamp(value)
}

--- Read the current wall-clock timestamp.
pub fn now() -[WallClock]> Result<Timestamp, WallClockError> {
  WallClock.now()
}

--- Convert a platform millisecond result into the public typed boundary.
pub(package) fn from_platform_milliseconds(value: i64) -> Result<Timestamp, WallClockError> {
  match value {
    failed if failed < 0 -> Err<Timestamp, WallClockError>(WallClockUnavailable)
    milliseconds -> Ok<Timestamp, WallClockError>(milliseconds_since_unix_epoch(milliseconds))
  }
}

impl Timestamp {
  --- Return milliseconds since the Unix epoch.
  pub fn milliseconds_since_unix_epoch(self) -> i64 { timestamp_value(self) }

  --- Move the timestamp forward by a signed duration.
  pub fn add(self, duration: Duration) -> Timestamp {
    milliseconds_since_unix_epoch(
      self.milliseconds_since_unix_epoch() + duration.milliseconds()
    )
  }

  --- Move the timestamp backward by a signed duration.
  pub fn subtract(self, duration: Duration) -> Timestamp {
    milliseconds_since_unix_epoch(
      self.milliseconds_since_unix_epoch() - duration.milliseconds()
    )
  }

  --- Return the signed duration from `earlier` to this timestamp.
  pub fn duration_since(self, earlier: Timestamp) -> Duration {
    time.milliseconds(
      self.milliseconds_since_unix_epoch() - earlier.milliseconds_since_unix_epoch()
    )
  }
}
