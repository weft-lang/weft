-- stdlib/time/sleep.weft -- explicit suspension authority

use stdlib/result.{Err, Ok, Result}
use stdlib/time.{Duration}

--- Why a requested sleep could not complete.
pub type SleepError {
  --- A negative duration cannot be used for sleeping.
  InvalidSleepDuration
  --- The duration cannot be represented by the selected scheduler.
  SleepDurationOutOfRange
  --- The selected sleep was interrupted before the duration elapsed.
  SleepInterrupted
  --- The selected handler could not provide suspension.
  SleepUnavailable
}

--- Authority to suspend the current computation for a duration.
pub effect Sleep {
  --- Interpret one sleep request and return a typed rejection or failure.
  fn wait(duration: Duration) -> Result<nil, SleepError>
}

--- Sleep for a non-negative duration under the selected handler.
pub fn wait(duration: Duration) -[Sleep]> Result<nil, SleepError> {
  if duration.milliseconds() < 0 {
    Err<nil, SleepError>(InvalidSleepDuration)
  } else {
    Sleep.wait(duration)
  }
}

--- Convert a platform sleep status into the public typed boundary.
pub(package) fn result_from_platform_status(status: i64) -> Result<nil, SleepError> {
  match status {
    0 -> Ok<nil, SleepError>(nil)
    interrupted if interrupted == 0 - 4 -> Err<nil, SleepError>(SleepInterrupted)
    _ -> Err<nil, SleepError>(SleepUnavailable)
  }
}
