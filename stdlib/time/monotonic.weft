-- stdlib/time/monotonic.weft -- monotonic observation and instant arithmetic

use stdlib/ord.{*}
use stdlib/time as time
use stdlib/time.{Duration}

--- A point on one monotonic clock timeline, represented at nanosecond precision.
---
--- Arithmetic and comparison are meaningful only for instants from the same
--- handler timeline. Calendar meaning belongs to `time/wall.Timestamp`.
pub type Instant = opaque i64

fn instant_value(value: Instant) -> i64 {
  match value { Instant(nanoseconds) -> nanoseconds }
}

impl Ord for Instant {
  fn compare(self: Self, other: Self) -> Ordering {
    instant_value(self).compare(instant_value(other))
  }
}

--- Authority to observe one monotonic clock timeline.
pub effect MonotonicClock {
  --- Read the current point on this handler's monotonic timeline.
  fn now() -> Instant
}

--- Construct an instant on a handler-defined timeline for policy or testing.
pub fn nanoseconds(value: i64) -> Instant { Instant(value) }

--- Read the current monotonic instant.
pub fn now() -[MonotonicClock]> Instant {
  MonotonicClock.now()
}

impl Instant {
  --- Return this handler-local instant's nanosecond coordinate.
  pub fn nanoseconds(self) -> i64 { instant_value(self) }

  --- Move the instant forward by a signed duration.
  pub fn add(self, duration: Duration) -> Instant {
    nanoseconds(self.nanoseconds() + duration.milliseconds() * 1000000)
  }

  --- Move the instant backward by a signed duration.
  pub fn subtract(self, duration: Duration) -> Instant {
    nanoseconds(self.nanoseconds() - duration.milliseconds() * 1000000)
  }

  --- Return the whole-millisecond duration from `earlier` to this instant.
  pub fn duration_since(self, earlier: Instant) -> Duration {
    time.milliseconds((self.nanoseconds() - earlier.nanoseconds()) / 1000000)
  }
}
