-- stdlib/time/calendar.weft -- pure proleptic Gregorian calendar values

use stdlib/option.{None, Option, Some}

type DateParts {
  year: i64,
  month: i64,
  day: i64
}

--- A valid proleptic Gregorian date with a representable signed epoch day.
pub type Date = opaque DateParts

--- A day in the seven-day calendar week.
pub type Weekday {
  --- Sunday.
  Sunday
  --- Monday.
  Monday
  --- Tuesday.
  Tuesday
  --- Wednesday.
  Wednesday
  --- Thursday.
  Thursday
  --- Friday.
  Friday
  --- Saturday.
  Saturday
}

fn floor_div(value: i64, divisor: i64) -> i64 {
  let quotient = value / divisor
  let remainder = value - quotient * divisor
  if remainder < 0 { quotient - 1 } else { quotient }
}

fn floor_mod(value: i64, divisor: i64) -> i64 {
  let quotient = value / divisor
  let remainder = value - quotient * divisor
  if remainder < 0 { remainder + divisor } else { remainder }
}

fn epoch_parts(year: i64, month: i64, day: i64) -> (i64, i64) {
  let adjusted_year = year - if month <= 2 { 1 } else { 0 }
  let civil_era = floor_div(adjusted_year, 400)
  let year_of_era = adjusted_year - civil_era * 400
  let march_month = if month > 2 { month - 3 } else { month + 9 }
  let day_of_year = (153 * march_month + 2) / 5 + day - 1
  let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
  let epoch_era = civil_era - 4
  let shifted_day = day_of_era - 135080
  if shifted_day < 0 {
    (epoch_era - 1, shifted_day + 146097)
  } else {
    (epoch_era, shifted_day)
  }
}

fn epoch_parts_representable(era: i64, day: i64) -> bool {
  let minimum = 0 - 9223372036854775808
  let maximum = 9223372036854775807
  let minimum_era = floor_div(minimum, 146097)
  let maximum_era = maximum / 146097
  match era {
    value if value < minimum_era -> false
    value if value > maximum_era -> false
    value if value == minimum_era -> day >= floor_mod(minimum, 146097)
    value if value == maximum_era -> day <= maximum - maximum_era * 146097
    _ -> true
  }
}

fn epoch_day_from_parts(era: i64, day: i64) -> i64 {
  if era < 0 {
    (era + 1) * 146097 - (146097 - day)
  } else {
    era * 146097 + day
  }
}

fn date_unchecked(year: i64, month: i64, day: i64) -> Date {
  Date(DateParts { year: year, month: month, day: day })
}

--- Return whether a proleptic Gregorian year is a leap year.
pub fn is_leap_year(year: i64) -> bool {
  let divisible_by_four = floor_mod(year, 4) == 0
  let divisible_by_hundred = floor_mod(year, 100) == 0
  let divisible_by_four_hundred = floor_mod(year, 400) == 0
  divisible_by_four and (not divisible_by_hundred or divisible_by_four_hundred)
}

fn month_length(year: i64, month: i64) -> i64 {
  match month {
    1 -> 31
    2 -> if is_leap_year(year) { 29 } else { 28 }
    3 -> 31
    4 -> 30
    5 -> 31
    6 -> 30
    7 -> 31
    8 -> 31
    9 -> 30
    10 -> 31
    11 -> 30
    12 -> 31
    _ -> 0
  }
}

--- Return the number of days in a valid one-based month.
pub fn days_in_month(year: i64, month: i64) -> Option<i64> {
  let days = month_length(year, month)
  if days == 0 { None } else { Some<i64>(days) }
}

--- Return 365 or 366 days for a year.
pub fn days_in_year(year: i64) -> i64 {
  if is_leap_year(year) { 366 } else { 365 }
}

fn date_fields_valid(year: i64, month: i64, day: i64) -> bool {
  match month_length(year, month) {
    0 -> false
    maximum -> day >= 1 and day <= maximum
  }
}

fn date_representable(year: i64, month: i64, day: i64) -> bool {
  -- Years outside this conservative prefilter cannot map to an i64 epoch day;
  -- it also keeps the March-based year adjustment inside i64 arithmetic.
  if year < 0 - 26000000000000000 or year > 26000000000000000 {
    false
  } else {
    let (era, day_in_era) = epoch_parts(year, month, day)
    epoch_parts_representable(era, day_in_era)
  }
}

--- Construct a date only when the calendar triple is valid.
pub fn date(year: i64, month: i64, day: i64) -> Option<Date> {
  if date_fields_valid(year, month, day) and date_representable(year, month, day) {
    Some<Date>(date_unchecked(year, month, day))
  } else {
    None
  }
}

--- Convert signed days since 1970-01-01 to a date in constant time.
pub fn from_epoch_day(epoch_day: i64) -> Date {
  -- Align the Unix epoch to the Gregorian 400-year era beginning 1600-03-01.
  -- Splitting before adding the offset keeps the intermediate bounded even
  -- for very distant epoch-day inputs.
  let epoch_era = floor_div(epoch_day, 146097)
  let epoch_day_in_era = epoch_day - epoch_era * 146097
  let shifted = epoch_day_in_era + 135080
  let carry = shifted / 146097
  let era = epoch_era + 4 + carry
  let day_of_era = shifted - carry * 146097
  let year_numerator = day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096
  let year_of_era = year_numerator / 365
  let elapsed_year_days = 365 * year_of_era + year_of_era / 4 - year_of_era / 100
  let day_of_year = day_of_era - elapsed_year_days
  let march_month = (5 * day_of_year + 2) / 153
  let day = day_of_year - (153 * march_month + 2) / 5 + 1
  let month = if march_month < 10 { march_month + 3 } else { march_month - 9 }
  let year = year_of_era + era * 400 + if month <= 2 { 1 } else { 0 }
  date_unchecked(year, month, day)
}

impl Date {
  --- Return the date's year.
  pub fn year(self) -> i64 {
    match self { Date(parts) -> parts.year }
  }

  --- Return the date's one-based month.
  pub fn month(self) -> i64 {
    match self { Date(parts) -> parts.month }
  }

  --- Return the date's one-based day.
  pub fn day(self) -> i64 {
    match self { Date(parts) -> parts.day }
  }

  --- Convert the date to signed days since 1970-01-01.
  pub fn to_epoch_day(self) -> i64 {
    let (era, day) = epoch_parts(self.year(), self.month(), self.day())
    epoch_day_from_parts(era, day)
  }

  --- Add signed calendar days to the date.
  pub fn add_days(self, days: i64) -> Date {
    from_epoch_day(self.to_epoch_day() + days)
  }

  --- Return the date's day in the seven-day calendar week.
  pub fn weekday(self) -> Weekday {
    match floor_mod(floor_mod(self.to_epoch_day(), 7) + 4, 7) {
      0 -> Sunday
      1 -> Monday
      2 -> Tuesday
      3 -> Wednesday
      4 -> Thursday
      5 -> Friday
      _ -> Saturday
    }
  }
}
