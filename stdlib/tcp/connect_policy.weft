-- stdlib/tcp/connect_policy.weft — lexical outbound TCP authority narrowing

use stdlib/eq.{Eq}
use stdlib/net_address.{SocketAddress}
use stdlib/result.{Err}
use stdlib/tcp.{TcpConnect, TcpError, TcpPolicyDenied, TcpStream}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds}
use stdlib/vector/handles.{Vector}

--- A snapshotted endpoint policy that can narrow, but never grant, outbound
--- TCP authority.
pub type Policy = opaque Vector<SocketAddress>

--- Snapshot an allowlist of exact numeric endpoints.
pub fn allow_only(addresses: Vector<SocketAddress>) -> Policy {
  let snapshot = vector.with_capacity<SocketAddress>(addresses.len())
  for index in 0..addresses.len() {
    snapshot.push(vector_get_in_bounds<SocketAddress>(addresses, index))
  }
  Policy(snapshot)
}

fn allows(policy: Policy, address: SocketAddress) -> bool {
  match policy {
    Policy(addresses) -> {
      let mut allowed = false
      let mut index = 0
      while index < addresses.len() and not allowed {
        if vector_get_in_bounds<SocketAddress>(addresses, index).eq(address) {
          allowed = true
        } else { 0 }
        index = index + 1
      }
      allowed
    }
  }
}

--- Narrow outbound TCP authority to an exact snapshotted allowlist.
--- Allowed requests delegate outward; denied requests do not perform.
pub implements TcpConnect(policy: Policy) {
  TcpConnect.connect(address, options) -> {
    if allows(policy, address) {
      resume(TcpConnect.connect(address, options))
    } else {
      resume(Err<owned TcpStream, TcpError>(TcpPolicyDenied))
    }
  }
}
