-- stdlib/tcp/listen_policy.weft — lexical inbound TCP authority narrowing

use stdlib/eq.{Eq}
use stdlib/net_address.{SocketAddress}
use stdlib/option
use stdlib/result.{Err}
use stdlib/tcp.{TcpError, TcpListen, TcpListener, TcpPolicyDenied}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds}
use stdlib/vector/handles.{Vector}

--- A snapshotted endpoint policy that can narrow, but never grant, inbound
--- TCP authority.
pub type Policy = opaque Vector<SocketAddress>

--- Snapshot an allowlist of exact numeric local endpoints.
pub fn allow_only(addresses: Vector<SocketAddress>) -> Policy {
  let mut snapshot = vector.with_capacity<SocketAddress>(addresses.len())
  let zero: usize = 0
  for index in zero..addresses.len() {
    snapshot.push(addresses.get(index).expect("TCP policy index is in bounds"))
  }
  Policy(snapshot)
}

fn allows(policy: Policy, address: SocketAddress) -> bool {
  match policy {
    Policy(addresses) -> {
      let mut allowed = false
      let zero: usize = 0
      let one: usize = 1
      let mut index = zero
      while index < addresses.len() and not allowed {
        if addresses.get(index).expect("TCP policy index is in bounds").eq(address) {
          allowed = true
        } else { 0 }
        index = index + one
      }
      allowed
    }
  }
}

--- Narrow inbound TCP authority to an exact snapshotted allowlist.
--- Allowed requests delegate outward; denied requests do not perform.
pub implements TcpListen(policy: Policy) {
  TcpListen.listen(address, options) -> {
    if allows(policy, address) {
      resume(TcpListen.listen(address, options))
    } else {
      resume(Err<owned TcpListener, TcpError>(TcpPolicyDenied))
    }
  }
}
