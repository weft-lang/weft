-- stdlib/env.weft — process argument and environment capability

--- Read-only access to the process startup environment selected by a handler.
---
--- Production handlers interpret the operating system's startup vector;
--- deterministic tests can provide the same operations without a process.
pub effect Env {
  --- Return the number of process arguments, including argument zero.
  fn arg_count() -> i64
  --- Return argument `index`, or `nil` when the index is outside the vector.
  fn arg(index: i64) -> str?
  --- Return the exact value of environment variable `name`, or `nil` when
  --- the name is invalid or absent. An empty present value remains `""`.
  fn var(name: str) -> str?
}
