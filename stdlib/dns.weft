-- stdlib/dns.weft — capability-scoped DNS resolution
--
-- DomainName owns Unicode/IDNA identity. DNS owns only interpretation of that
-- identity into ordered numeric candidates; operating-system resolver state
-- remains behind a separate trusted handler.

use stdlib/eq.{Eq}
use stdlib/idna.{DomainName}
use stdlib/net_address.{IpAddress, IpV4, IpV6, SocketAddress, SocketV4, SocketV6}
use stdlib/result.{Result, Err, Ok}
use stdlib/vector.{vector_get_in_bounds, vector_new, vector_with_capacity}
use stdlib/vector/handles.{Vector}

--- The address families a resolution request may return.
pub type DnsFamily {
  --- Permit both IPv4 and IPv6 candidates.
  DnsAnyFamily,
    --- Permit only IPv4 candidates.
    DnsIpv4Only,
    --- Permit only IPv6 candidates.
    DnsIpv6Only
}

--- A recoverable DNS resolution failure.
pub type DnsError {
  --- The resolver has no record for the requested canonical name.
  DnsNameNotFound,
    --- The resolver reported a temporary failure that may succeed on retry.
    DnsTemporaryFailure,
    --- The resolver reported a non-temporary failure for this request.
    DnsPermanentFailure,
    --- No candidate satisfied the requested address-family policy.
    DnsFamilyUnavailable,
    --- A local DNS policy rejected the exact host and port before resolution.
    DnsPolicyDenied,
    --- The resolver could not allocate the resources needed for the request.
    DnsResourceExhausted,
    --- The platform reported an unmapped resolver or system error code.
    DnsPlatform(i64)
}

--- One exact answer in a deterministic fake resolver configuration.
pub type DnsFakeRecord {
  --- Resolve this name to the listed IP addresses in observation order.
  --- IPv6 fake answers have scope id zero; the request port is applied later.
  DnsFakeAddresses(DomainName, Vector<IpAddress>),
    --- Resolve this name to the supplied typed failure.
    DnsFakeFailure(DomainName, DnsError)
}

--- One canonical host and port admitted by a DNS policy allowlist.
pub type DnsPolicyTarget {
  --- Permit resolution of this exact `DomainName` identity and port.
  DnsPolicyTarget(DomainName, u16)
}

--- A value policy that can narrow, but never grant, DNS authority.
pub type DnsPolicy {
  --- Delegate only exact canonical host-and-port targets in the snapshot.
  DnsPolicyAllowOnly(Vector<DnsPolicyTarget>)
}

--- Authority to resolve canonical DNS names into numeric socket candidates.
pub effect DnsResolve {
  --- Resolve `host` for `port` under the explicit address-family policy.
  fn resolve(host: DomainName, port: u16, family: DnsFamily) -> Result<Vector<SocketAddress>, DnsError>
}

--- Resolve a canonical DNS name through the installed resolver policy.
pub fn dns_resolve(host: DomainName, port: u16, family: DnsFamily) -[DnsResolve]> Result<Vector<SocketAddress>, DnsError> {
  DnsResolve.resolve(host, port, family)
}

fn dns_policy_targets_snapshot(targets: Vector<DnsPolicyTarget>) -> Vector<DnsPolicyTarget> {
  let snapshot = vector_with_capacity<DnsPolicyTarget>(targets.len())
  for index in 0..targets.len() {
    snapshot.push(vector_get_in_bounds<DnsPolicyTarget>(targets, index))
  }
  snapshot
}

fn dns_policy_snapshot(policy: DnsPolicy) -> DnsPolicy {
  match policy {
    DnsPolicyAllowOnly(targets) -> DnsPolicyAllowOnly(dns_policy_targets_snapshot(targets))
  }
}

fn dns_policy_allows(policy: DnsPolicy, host: DomainName, port: u16) -> bool {
  match policy {
    DnsPolicyAllowOnly(targets) -> {
      let mut allowed = false
      let mut index = 0
      while index < targets.len() and not allowed {
        match vector_get_in_bounds<DnsPolicyTarget>(targets, index) {
          DnsPolicyTarget(target_host, target_port) -> {
            if target_host.eq(host) and target_port == port { allowed = true }
            else { 0 }
          }
        }
        index = index + 1
      }
      allowed
    }
  }
}

--- Narrow DNS authority to a snapshotted value policy for `body`.
--- Allowed requests delegate to the enclosing resolver; denied requests do
--- not perform outward and return `DnsPolicyDenied`.
pub fn dns_with_policy<T, E>(
  policy: DnsPolicy,
  body: () -[DnsResolve, E]> T
) -[DnsResolve, E]> T {
  let snapshot = dns_policy_snapshot(policy)
  handle body() {
    DnsResolve.resolve(host, port, family) -> {
      if dns_policy_allows(snapshot, host, port) {
        resume(DnsResolve.resolve(host, port, family))
      } else {
        resume(Err<Vector<SocketAddress>, DnsError>(DnsPolicyDenied))
      }
    }
  }
}

fn dns_family_accepts(family: DnsFamily, address: IpAddress) -> bool {
  match family {
    DnsAnyFamily -> true
    DnsIpv4Only -> match address {
      IpV4(_) -> true
      _ -> false
    }
    DnsIpv6Only -> match address {
      IpV6(_) -> true
      _ -> false
    }
  }
}

fn dns_socket_candidate(address: IpAddress, port: u16) -> SocketAddress {
  match address {
    IpV4(value) -> SocketV4(value, port)
    IpV6(value) -> SocketV6(value, port, 0)
  }
}

pub(package) fn dns_candidates_from_addresses(
  addresses: Vector<IpAddress>,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  let count = addresses.len()
  let candidates = vector_with_capacity<SocketAddress>(count)
  for index in 0..count {
    let address = vector_get_in_bounds<IpAddress>(addresses, index)
    if dns_family_accepts(family, address) {
      candidates.push(dns_socket_candidate(address, port))
    } else { 0 }
  }
  if not candidates.is_empty() {
    Ok<Vector<SocketAddress>, DnsError>(candidates)
  } else { if count == 0 {
      Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
    } else {
      Err<Vector<SocketAddress>, DnsError>(DnsFamilyUnavailable)
    } }
}

--- Construct the single numeric candidate for an already parsed IP address.
--- This helper is pure: numeric addresses never require resolver authority.
pub fn dns_numeric_candidates(
  address: IpAddress,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  let addresses = vector_with_capacity<IpAddress>(1)
  addresses.push(address)
  dns_candidates_from_addresses(addresses, port, family)
}

fn dns_clone_addresses(addresses: Vector<IpAddress>) -> Vector<IpAddress> {
  let count = addresses.len()
  let copy = vector_with_capacity<IpAddress>(count)
  for index in 0..count {
    copy.push(vector_get_in_bounds<IpAddress>(addresses, index))
  }
  copy
}

fn dns_snapshot_fake(records: Vector<DnsFakeRecord>) -> Vector<DnsFakeRecord> {
  let count = records.len()
  let snapshot = vector_with_capacity<DnsFakeRecord>(count)
  for index in 0..count {
    match vector_get_in_bounds<DnsFakeRecord>(records, index) {
      DnsFakeAddresses(host, addresses) ->
        snapshot.push(DnsFakeAddresses(host, dns_clone_addresses(addresses)))
      DnsFakeFailure(host, error) ->
        snapshot.push(DnsFakeFailure(host, error))
    }
  }
  snapshot
}

fn dns_fake_lookup(
  records: Vector<DnsFakeRecord>,
  host: DomainName,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  -- Later records deliberately override earlier ones. This makes local test
  -- fixtures composable while leaving lookup order completely deterministic.
  let mut index = records.len() - 1
  while index >= 0 {
    match vector_get_in_bounds<DnsFakeRecord>(records, index) {
      DnsFakeAddresses(record_host, addresses) -> {
        if record_host.eq(host) {
          return dns_candidates_from_addresses(addresses, port, family)
        } else { 0 }
      }
      DnsFakeFailure(record_host, error) -> {
        if record_host.eq(host) {
          return Err<Vector<SocketAddress>, DnsError>(error)
        } else { 0 }
      }
    }
    index = index - 1
  }
  Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
}

--- Run a computation with a deterministic, fully local DNS interpretation.
--- Configuration and address lists are snapshotted before `body` begins;
--- each successful query receives a fresh candidate vector. Later duplicate
--- records override earlier records for the same exact `DomainName` identity.
pub fn dns_with_fake<T, E>(
  records: Vector<DnsFakeRecord>,
  body: () -[DnsResolve, E]> T
) -[E]> T {
  let snapshot = dns_snapshot_fake(records)
  handle body() {
    DnsResolve.resolve(host, port, family) ->
      resume(dns_fake_lookup(snapshot, host, port, family))
  }
}
