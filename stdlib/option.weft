-- stdlib/option.weft — Option<T> for nullable values
--
-- Option represents a value that may or may not be present.
-- Some(value) wraps a present value. None represents absence.

use stdlib/panic.{*}

--- A value that is either present or absent.
pub type Option<T> {
  --- A present value.
  Some(T),
  --- The absence of a value.
  None
}

impl<T> Option<T> {
  --- Return whether this option contains a value.
  pub fn is_some(self) -> bool {
    match self {
      Some(v) -> true
      None -> false
    }
  }

  --- Return whether this option is empty.
  pub fn is_none(self) -> bool {
    match self {
      Some(v) -> false
      None -> true
    }
  }

  --- Return the contained value, or `default` when absent.
  pub fn unwrap_or(self, default: T) -> T {
    match self {
      Some(v) -> v
      None -> default
    }
  }

  --- Return the contained value, panicking when absent.
  pub fn unwrap(self) -> T {
    match self {
      Some(v) -> v
      None -> panic("Option.unwrap called on None")
    }
  }

  --- Return the contained value, panicking with `msg` when absent.
  pub fn expect(self, msg: str) -> T {
    match self {
      Some(v) -> v
      None -> panic(msg)
    }
  }
}

--- Transform a present value while preserving absence.
pub fn option_map<T, U>(opt: Option<T>, f: (T) -> U) -> Option<U> {
  match opt {
    Some(v) -> Some<U>(f(v))
    None -> None<U>()
  }
}
