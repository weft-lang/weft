-- stdlib/option.weft — Option<T> for nullable values
--
-- Option represents a value that may or may not be present.
-- Some(value) wraps a present value. None represents absence.

type Option<T> {
  Some(T),
  None
}

fn option_some<T>(value: T) -> Option<T> {
  Some<T>(value)
}

fn option_none<T>() -> Option<T> {
  None<T>()
}

-- Check if the option contains a value
impl Option {
  fn is_some(self: Option<i64>) -> i64 {
    match self {
      Some(v) -> 1
      None -> 0
    }
  }

  fn is_none(self: Option<i64>) -> i64 {
    match self {
      Some(v) -> 0
      None -> 1
    }
  }

  -- Extract the value or return a default
  fn unwrap_or(self: Option<i64>, default: i64) -> i64 {
    match self {
      Some(v) -> v
      None -> default
    }
  }

  -- Extract the value (crashes if None — use unwrap_or for safety)
  fn unwrap(self: Option<i64>) -> i64 {
    match self {
      Some(v) -> v
      None -> 0 - 1
    }
  }
}

-- Map a function over an Option: Some(x) → Some(f(x)), None → None
fn option_map<T, U>(opt: Option<T>, f: (T) -> U) -> Option<U> {
  match opt {
    Some(v) -> option_some<U>(f(v))
    None -> option_none<U>()
  }
}
