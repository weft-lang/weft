-- stdlib/io_helpers.weft — loop-correct safe transfer combinators
--
-- These helpers know nothing about descriptors or sockets. File, console and
-- network handlers provide one typed transfer callback; interruption, short
-- progress, EOF and caller bounds have one implementation everywhere.

use stdlib/bytes.{Bytes, bytes_from_vector, bytes_to_vector}
use stdlib/io_types.{IoEndOfFile, IoError, IoInterrupted, IoInvalidProgress, IoLimitExceeded, IoReadBytes, IoReadProgress, IoUnexpectedEof, IoWriteProgress, IoWroteBytes}
use stdlib/num.{num_i64_to_usize_checked, num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

pub fn io_transfer_chunk_size() -> i64 { 4096 }

fn io_helper_usize_to_i64(value: usize) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(value)), 0 - 1)
}

fn io_helper_i64_to_usize(value: i64) -> usize {
  num_int_cast_value_or<usize>(num_i64_to_usize_checked(value), 0)
}

fn io_helper_scratch(size: i64) -> Vector<u8> {
  let scratch = vector_with_capacity<u8>(size)
  for i in 0..size {
    vector_push<u8>(scratch, 0)
  }
  scratch
}

fn io_helper_copy_slice(values: [mut u8], count: i64) -> Vector<u8> {
  let copied = vector_with_capacity<u8>(count)
  for i in 0..count {
    vector_push<u8>(copied, values[io_helper_i64_to_usize(i)])
  }
  copied
}

fn io_helper_append_vector(out: Vector<u8>, values: Vector<u8>) -> i64 {
  let count = vector_len<u8>(values)
  for i in 0..count {
    vector_push<u8>(out, vector_get_in_bounds<u8>(values, i))
  }
  count
}

pub fn io_read_all_with<E>(
  limit: usize,
  read: ([mut u8]) -[E]> Result<IoReadProgress, IoError>
) -[E]> Result<Bytes, IoError> {
  let limit_i64 = io_helper_usize_to_i64(limit)
  if limit_i64 < 0 {
    result_err<Bytes, IoError>(IoLimitExceeded(limit))
  } else {
    let chunk = io_transfer_chunk_size()
    let scratch = io_helper_scratch(chunk)
    let out = vector_with_capacity<u8>(if limit_i64 < chunk { limit_i64 } else { chunk })
    let mut done = false
    let mut failed = false
    let mut failure = IoInvalidProgress
    while not done and not failed {
      let out_len = vector_len<u8>(out)
      let remaining = limit_i64 - out_len
      -- The one-byte probe distinguishes exact-limit EOF from truncation.
      let request = if remaining < chunk { remaining + 1 } else { chunk }
      let writable: [mut u8] = scratch[..io_helper_i64_to_usize(request)]
      match read(writable) {
        Err(error) -> {
          match error {
            IoInterrupted -> 0
            _ -> {
              failure = error
              failed = true
              0
            }
          }
        }
        Ok(progress) -> match progress {
          IoEndOfFile -> {
            done = true
            0
          }
          IoReadBytes(count) -> {
            let n = io_helper_usize_to_i64(count)
            if n <= 0 or n > request {
              failure = IoInvalidProgress
              failed = true
            } else { if out_len + n > limit_i64 {
              failure = IoLimitExceeded(limit)
              failed = true
            } else {
              let copied = io_helper_copy_slice(writable, n)
              io_helper_append_vector(out, copied)
            } }
            0
          }
        }
      }
    }
    if failed {
      result_err<Bytes, IoError>(failure)
    } else {
      result_ok<Bytes, IoError>(bytes_from_vector(out))
    }
  }
}

pub fn io_read_exact_with<E>(
  expected: usize,
  read: ([mut u8]) -[E]> Result<IoReadProgress, IoError>
) -[E]> Result<Bytes, IoError> {
  let expected_i64 = io_helper_usize_to_i64(expected)
  if expected_i64 < 0 {
    result_err<Bytes, IoError>(IoLimitExceeded(expected))
  } else {
    let chunk = io_transfer_chunk_size()
    let scratch = io_helper_scratch(chunk)
    let out = vector_with_capacity<u8>(if expected_i64 < chunk { expected_i64 } else { chunk })
    let mut failed = false
    let mut failure = IoInvalidProgress
    while vector_len<u8>(out) < expected_i64 and not failed {
      let remaining = expected_i64 - vector_len<u8>(out)
      let request = if remaining < chunk { remaining } else { chunk }
      let writable: [mut u8] = scratch[..io_helper_i64_to_usize(request)]
      match read(writable) {
        Err(error) -> {
          match error {
            IoInterrupted -> 0
            _ -> {
              failure = error
              failed = true
              0
            }
          }
        }
        Ok(progress) -> match progress {
          IoEndOfFile -> {
            failure = IoUnexpectedEof(io_helper_i64_to_usize(vector_len<u8>(out)))
            failed = true
            0
          }
          IoReadBytes(count) -> {
            let n = io_helper_usize_to_i64(count)
            if n <= 0 or n > request {
              failure = IoInvalidProgress
              failed = true
            } else {
              let copied = io_helper_copy_slice(writable, n)
              io_helper_append_vector(out, copied)
            }
            0
          }
        }
      }
    }
    if failed {
      result_err<Bytes, IoError>(failure)
    } else {
      result_ok<Bytes, IoError>(bytes_from_vector(out))
    }
  }
}

pub fn io_write_all_with<E>(
  values: Bytes,
  write: ([u8]) -[E]> Result<IoWriteProgress, IoError>
) -[E]> Result<usize, IoError> {
  let contiguous = bytes_to_vector(values)
  let total = vector_len<u8>(contiguous)
  let mut offset = 0
  let mut failed = false
  let mut failure = IoInvalidProgress
  while offset < total and not failed {
    let remaining: [u8] = contiguous[io_helper_i64_to_usize(offset)..]
    match write(remaining) {
      Err(error) -> {
        match error {
          IoInterrupted -> 0
          _ -> {
            failure = error
            failed = true
            0
          }
        }
      }
      Ok(progress) -> match progress {
        IoWroteBytes(count) -> {
          let n = io_helper_usize_to_i64(count)
          if n <= 0 or n > total - offset {
            failure = IoInvalidProgress
            failed = true
          } else {
            offset = offset + n
          }
          0
        }
      }
    }
  }
  if failed {
    result_err<usize, IoError>(failure)
  } else {
    result_ok<usize, IoError>(io_helper_i64_to_usize(offset))
  }
}
