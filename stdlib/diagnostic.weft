-- stdlib/diagnostic.weft -- stable L8 diagnostic helpers

use stdlib/diagnostic/schema
use stdlib/eq.{Eq}
pub use stdlib/diagnostic/schema.{*}

--- Return the structured diagnostic schema version, currently `1`.
pub fn schema_version() -> i64 { 1 }

--- Construct a legacy unassigned diagnostic without related locations or fields.
pub fn uncoded(
  severity: DiagnosticSeverity,
  class: DiagnosticClass,
  message: str,
  primary: DiagnosticLocation
) -> Diagnostic {
  schema.Diagnostic(
    severity,
    class,
    DiagnosticCodeUnassigned,
    message,
    primary,
    DiagnosticRelatedLocationNil,
    DiagnosticFieldNil
  )
}

impl Diagnostic {
  --- Return this diagnostic's severity.
  pub fn severity(self) -> DiagnosticSeverity {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> severity
    }
  }

  --- Return this diagnostic's subsystem class.
  pub fn class(self) -> DiagnosticClass {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> class
    }
  }

  --- Return this diagnostic's assigned-or-unassigned code.
  pub fn code(self) -> DiagnosticCode {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> code
    }
  }

  --- Return this diagnostic's primary human-readable message.
  pub fn message(self) -> str {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> message
    }
  }

  --- Return this diagnostic's primary source location.
  pub fn primary(self) -> DiagnosticLocation {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> primary
    }
  }

  --- Return this diagnostic's ordered related locations.
  pub fn related(self) -> DiagnosticRelatedLocationList {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> related
    }
  }

  --- Return this diagnostic's ordered machine-actionable fields.
  pub fn fields(self) -> DiagnosticFieldList {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> fields
    }
  }
}

impl DiagnosticSeverity {
  --- Return this severity's stable lowercase name.
  pub fn name(self) -> str {
    match self {
      DiagnosticSeverityError -> "error"
      DiagnosticSeverityWarning -> "warning"
      DiagnosticSeverityNote -> "note"
    }
  }

  --- Return the wire tag `1` error, `2` warning, or `3` note.
  pub fn wire_tag(self) -> i64 {
    match self {
      DiagnosticSeverityError -> 1
      DiagnosticSeverityWarning -> 2
      DiagnosticSeverityNote -> 3
    }
  }
}

impl DiagnosticClass {
  --- Return this built-in class name or an additive class's supplied name.
  pub fn name(self) -> str {
    match self {
      DiagnosticClassParse -> "parse"
      DiagnosticClassType -> "type"
      DiagnosticClassEffect -> "effect"
      DiagnosticClassOwnership -> "ownership"
      DiagnosticClassModule -> "module"
      DiagnosticClassLink -> "link"
      DiagnosticClassGrammar -> "grammar"
      DiagnosticClassTool -> "tool"
      DiagnosticClassRuntime -> "runtime"
      DiagnosticClassTest -> "test"
      DiagnosticClassOther(name) -> name
    }
  }
}

impl Eq for DiagnosticCode {
  --- Compare code states and assigned text without erasing absence.
  fn eq(self: Self, other: Self) -> bool {
    match self {
      DiagnosticCodeUnassigned -> match other {
        DiagnosticCodeUnassigned -> true
        DiagnosticCodeAssigned(_) -> false
      }
      DiagnosticCodeAssigned(left) -> match other {
        DiagnosticCodeUnassigned -> false
        DiagnosticCodeAssigned(right) -> left == right
      }
    }
  }
}

impl DiagnosticRelatedLocationList {
  --- Count these related locations.
  pub fn len(self) -> usize {
    let empty: usize = 0
    match self {
      DiagnosticRelatedLocationNil -> empty
      DiagnosticRelatedLocationCons(item, rest) -> 1 + rest.len()
    }
  }
}

impl DiagnosticFieldList {
  --- Count these machine-actionable diagnostic fields.
  pub fn len(self) -> usize {
    let empty: usize = 0
    match self {
      DiagnosticFieldNil -> empty
      DiagnosticFieldCons(field, rest) -> 1 + rest.len()
    }
  }

  --- Count suggestion fields in this diagnostic payload.
  pub fn suggestion_count(self) -> usize {
    let empty: usize = 0
    match self {
      DiagnosticFieldNil -> empty
      DiagnosticFieldCons(field, rest) -> match field {
        DiagnosticFieldSuggestion(suggestion) -> 1 + rest.suggestion_count()
        _ -> rest.suggestion_count()
      }
    }
  }
}

impl DiagnosticSuggestionApplicability {
  --- Return this applicability's stable kebab-case name.
  pub fn name(self) -> str {
    match self {
      DiagnosticSuggestionUnspecified -> "unspecified"
      DiagnosticSuggestionMachineApplicable -> "machine-applicable"
      DiagnosticSuggestionMaybeIncorrect -> "maybe-incorrect"
    }
  }
}

impl DiagnosticTextEditList {
  --- Count these source edits.
  pub fn len(self) -> usize {
    let empty: usize = 0
    match self {
      DiagnosticTextEditNil -> empty
      DiagnosticTextEditCons(edit, rest) -> 1 + rest.len()
    }
  }
}


impl Diagnostic {
  --- Transform every source location, preserving all other diagnostic data.
  --- Visit the primary location first, then related locations, then fields and
  --- suggestion edits in their stored order. Absent locations are visited too.
  pub fn map_locations<E>(self, transform: (DiagnosticLocation) -[E]> DiagnosticLocation) -[E]> Diagnostic {
    match self {
      Diagnostic(severity, class, code, message, primary, related, fields) -> {
        let mapped_primary = transform(primary)
        let mapped_related = map_related_locations(related, transform)
        let mapped_fields = map_field_locations(fields, transform)
        Diagnostic(severity, class, code, message, mapped_primary, mapped_related, mapped_fields)
      }
    }
  }
}

fn map_related_locations<E>(locations: DiagnosticRelatedLocationList, transform: (DiagnosticLocation) -[E]> DiagnosticLocation) -[E]> DiagnosticRelatedLocationList {
  let mut remaining = locations
  let mut reversed = DiagnosticRelatedLocationNil
  loop {
    match remaining {
      DiagnosticRelatedLocationNil -> break
      DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
        reversed = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, transform(location)), reversed)
        remaining = rest
      }
    }
  }
  let mut result = DiagnosticRelatedLocationNil
  loop {
    match reversed {
      DiagnosticRelatedLocationNil -> break
      DiagnosticRelatedLocationCons(item, rest) -> {
        result = DiagnosticRelatedLocationCons(item, result)
        reversed = rest
      }
    }
  }
  result
}

fn map_edit_locations<E>(edits: DiagnosticTextEditList, transform: (DiagnosticLocation) -[E]> DiagnosticLocation) -[E]> DiagnosticTextEditList {
  let mut remaining = edits
  let mut reversed = DiagnosticTextEditNil
  loop {
    match remaining {
      DiagnosticTextEditNil -> break
      DiagnosticTextEditCons(DiagnosticTextEdit(location, replacement), rest) -> {
        reversed = DiagnosticTextEditCons(DiagnosticTextEdit(transform(location), replacement), reversed)
        remaining = rest
      }
    }
  }
  let mut result = DiagnosticTextEditNil
  loop {
    match reversed {
      DiagnosticTextEditNil -> break
      DiagnosticTextEditCons(item, rest) -> {
        result = DiagnosticTextEditCons(item, result)
        reversed = rest
      }
    }
  }
  result
}

fn map_field_locations<E>(fields: DiagnosticFieldList, transform: (DiagnosticLocation) -[E]> DiagnosticLocation) -[E]> DiagnosticFieldList {
  let mut remaining = fields
  let mut reversed = DiagnosticFieldNil
  loop {
    match remaining {
      DiagnosticFieldNil -> break
      DiagnosticFieldCons(field, rest) -> {
        let mapped = match field {
          DiagnosticFieldLocation(name, location) -> DiagnosticFieldLocation(name, transform(location))
          DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, edits)) ->
            DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, map_edit_locations(edits, transform)))
          other -> other
        }
        reversed = DiagnosticFieldCons(mapped, reversed)
        remaining = rest
      }
    }
  }
  let mut result = DiagnosticFieldNil
  loop {
    match reversed {
      DiagnosticFieldNil -> break
      DiagnosticFieldCons(item, rest) -> {
        result = DiagnosticFieldCons(item, result)
        reversed = rest
      }
    }
  }
  result
}
