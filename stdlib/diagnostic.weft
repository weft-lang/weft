-- stdlib/diagnostic.weft -- stable L8 diagnostic helpers

use stdlib/diagnostic_type
use stdlib/diagnostic_type.{*}

pub fn diagnostic_schema_version() -> i64 { 1 }

pub fn diagnostic_related_empty() -> DiagnosticRelatedLocationList {
  DiagnosticRelatedLocationNil
}

pub fn diagnostic_fields_empty() -> DiagnosticFieldList {
  DiagnosticFieldNil
}

pub fn diagnostic_new(
  severity: DiagnosticSeverity,
  class: DiagnosticClass,
  code: DiagnosticCode,
  message: str,
  primary: DiagnosticLocation,
  related: DiagnosticRelatedLocationList,
  fields: DiagnosticFieldList
) -> Diagnostic {
  diagnostic_type.Diagnostic(severity, class, code, message, primary, related, fields)
}

pub fn diagnostic_uncoded(
  severity: DiagnosticSeverity,
  class: DiagnosticClass,
  message: str,
  primary: DiagnosticLocation
) -> Diagnostic {
  diagnostic_new(
    severity,
    class,
    DiagnosticCodeUnassigned,
    message,
    primary,
    diagnostic_related_empty(),
    diagnostic_fields_empty()
  )
}

pub fn diagnostic_report(diagnostic: Diagnostic) -[Diagnose]> i64 {
  Diagnose.report(diagnostic)
}

pub fn diagnostic_severity(diagnostic: Diagnostic) -> DiagnosticSeverity {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> severity
  }
}

pub fn diagnostic_class(diagnostic: Diagnostic) -> DiagnosticClass {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> class
  }
}

pub fn diagnostic_code(diagnostic: Diagnostic) -> DiagnosticCode {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> code
  }
}

pub fn diagnostic_message(diagnostic: Diagnostic) -> str {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> message
  }
}

pub fn diagnostic_primary(diagnostic: Diagnostic) -> DiagnosticLocation {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> primary
  }
}

pub fn diagnostic_related(diagnostic: Diagnostic) -> DiagnosticRelatedLocationList {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> related
  }
}

pub fn diagnostic_fields(diagnostic: Diagnostic) -> DiagnosticFieldList {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> fields
  }
}

pub fn diagnostic_severity_name(severity: DiagnosticSeverity) -> str {
  match severity {
    DiagnosticSeverityError -> "error"
    DiagnosticSeverityWarning -> "warning"
    DiagnosticSeverityNote -> "note"
  }
}

pub fn diagnostic_class_name(class: DiagnosticClass) -> str {
  match class {
    DiagnosticClassParse -> "parse"
    DiagnosticClassType -> "type"
    DiagnosticClassEffect -> "effect"
    DiagnosticClassOwnership -> "ownership"
    DiagnosticClassModule -> "module"
    DiagnosticClassLink -> "link"
    DiagnosticClassGrammar -> "grammar"
    DiagnosticClassTool -> "tool"
    DiagnosticClassRuntime -> "runtime"
    DiagnosticClassTest -> "test"
    DiagnosticClassOther(name) -> name
  }
}

pub fn diagnostic_code_is_assigned(code: DiagnosticCode) -> bool {
  match code {
    DiagnosticCodeUnassigned -> false
    DiagnosticCodeAssigned(value) -> true
  }
}

pub fn diagnostic_code_text(code: DiagnosticCode) -> str {
  match code {
    DiagnosticCodeUnassigned -> ""
    DiagnosticCodeAssigned(value) -> value
  }
}

pub fn diagnostic_location_source(location: DiagnosticLocation) -> DiagnosticSource {
  match location {
    DiagnosticLocationNone -> DiagnosticSourceUnknown
    DiagnosticSourceRange(source, start, end) -> source
  }
}

pub fn diagnostic_location_start(location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> start
  }
}

pub fn diagnostic_location_end(location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> end
  }
}

pub fn diagnostic_related_count(related: DiagnosticRelatedLocationList) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(item, rest) -> 1 + diagnostic_related_count(rest)
  }
}

pub fn diagnostic_field_count(fields: DiagnosticFieldList) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> 1 + diagnostic_field_count(rest)
  }
}

pub fn diagnostic_suggestion_applicability_name(applicability: DiagnosticSuggestionApplicability) -> str {
  match applicability {
    DiagnosticSuggestionUnspecified -> "unspecified"
    DiagnosticSuggestionMachineApplicable -> "machine-applicable"
    DiagnosticSuggestionMaybeIncorrect -> "maybe-incorrect"
  }
}

pub fn diagnostic_text_edit_count(edits: DiagnosticTextEditList) -> i64 {
  match edits {
    DiagnosticTextEditNil -> 0
    DiagnosticTextEditCons(edit, rest) -> 1 + diagnostic_text_edit_count(rest)
  }
}

pub fn diagnostic_suggestion_count(fields: DiagnosticFieldList) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(suggestion) -> 1 + diagnostic_suggestion_count(rest)
      _ -> diagnostic_suggestion_count(rest)
    }
  }
}

pub fn diagnostic_severity_tag(severity: DiagnosticSeverity) -> i64 {
  match severity {
    DiagnosticSeverityError -> 1
    DiagnosticSeverityWarning -> 2
    DiagnosticSeverityNote -> 3
  }
}
