-- stdlib/result.weft — Result<T, E> for error handling
--
-- Result represents either success (Ok) or failure (Err).
-- Use with the Fail effect: handle f() { Fail.fail(e) -> Err(e), return v -> Ok(v) }

use stdlib/panic.{*}

--- The result of a computation that may succeed or fail.
pub type Result<T, E> {
  --- A successful value.
  Ok(T),
  --- A recoverable error.
  Err(E)
}

impl<T, E> Result<T, E> {
  --- Return whether this result is successful.
  pub fn is_ok(self) -> bool {
    match self {
      Ok(v) -> true
      Err(e) -> false
    }
  }

  --- Return whether this result is an error.
  pub fn is_err(self) -> bool {
    match self {
      Ok(v) -> false
      Err(e) -> true
    }
  }

  --- Return the successful value, or `default` after failure.
  pub fn unwrap_or(self, default: T) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> default
    }
  }

  --- Return the successful value, panicking after failure.
  pub fn unwrap(self) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> panic("Result.unwrap called on Err")
    }
  }

  --- Return the successful value, panicking with `msg` after failure.
  pub fn expect(self, msg: str) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> panic(msg)
    }
  }

  --- Transform a successful value while preserving an error.
  pub fn map<U>(self, f: (T) -> U) -> Result<U, E> {
    match self {
      Ok(v) -> Ok<U, E>(f(v))
      Err(e) -> Err<U, E>(e)
    }
  }

  --- Transform an error while preserving a successful value.
  pub fn map_err<F>(self, f: (E) -> F) -> Result<T, F> {
    match self {
      Ok(v) -> Ok<T, F>(v)
      Err(e) -> Err<T, F>(f(e))
    }
  }

  --- Continue a successful value through another fallible computation.
  pub fn and_then<U>(self, f: (T) -> Result<U, E>) -> Result<U, E> {
    match self {
      Ok(v) -> f(v)
      Err(e) -> Err<U, E>(e)
    }
  }

  --- Recover from an error, with an independently typed residual error.
  pub fn or_else<F>(self, f: (E) -> Result<T, F>) -> Result<T, F> {
    match self {
      Ok(v) -> Ok<T, F>(v)
      Err(e) -> f(e)
    }
  }
}
