-- stdlib/result.weft — Result<T, E> for error handling
--
-- Result represents either success (Ok) or failure (Err).
-- Use with the Fail effect: handle f() { Fail.fail(e) -> Err(e), return v -> Ok(v) }

type Result<T, E> {
  Ok(T),
  Err(E)
}

fn result_ok<T, E>(value: T) -> Result<T, E> {
  Ok<T, E>(value)
}

fn result_err<T, E>(error: E) -> Result<T, E> {
  Err<T, E>(error)
}

impl<T, E> Result<T, E> {
  fn is_ok(self) -> i64 {
    match self {
      Ok(v) -> 1
      Err(e) -> 0
    }
  }

  fn is_err(self) -> i64 {
    match self {
      Ok(v) -> 0
      Err(e) -> 1
    }
  }

  fn unwrap_or(self, default: T) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> default
    }
  }
}

-- Map a function over the Ok value: Ok(x) → Ok(f(x)), Err(e) → Err(e)
fn result_map<T, U, E>(res: Result<T, E>, f: (T) -> U) -> Result<U, E> {
  match res {
    Ok(v) -> result_ok<U, E>(f(v))
    Err(e) -> result_err<U, E>(e)
  }
}
