-- stdlib/result.weft — Result<T, E> for error handling
--
-- Result represents either success (Ok) or failure (Err).
-- Use with the Fail effect: handle f() { Fail.fail(e) -> Err(e), return v -> Ok(v) }

type Result<T, E> {
  Ok(T),
  Err(E)
}

impl Result {
  fn is_ok(self: i64) -> i64 {
    match self {
      Ok(v) -> true
      Err(e) -> false
    }
  }

  fn is_err(self: i64) -> i64 {
    match self {
      Ok(v) -> false
      Err(e) -> true
    }
  }

  fn unwrap_or(self: i64, default: i64) -> i64 {
    match self {
      Ok(v) -> v
      Err(e) -> default
    }
  }

  fn unwrap(self: i64) -> i64 {
    match self {
      Ok(v) -> v
      Err(e) -> 0 - 1
    }
  }
}

-- Map a function over the Ok value: Ok(x) → Ok(f(x)), Err(e) → Err(e)
fn result_map<T, U, E>(res: i64, f: (i64) -> i64) -> i64 {
  match res {
    Ok(v) -> Ok<U>(f(v))
    Err(e) -> Err<E>(e)
  }
}
