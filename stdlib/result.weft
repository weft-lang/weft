-- stdlib/result.weft — Result<T, E> for error handling
--
-- Result represents either success (Ok) or failure (Err).
-- Use with the Fail effect: handle f() { Fail.fail(e) -> Err(e), return v -> Ok(v) }

use stdlib/panic.{*}

--- The result of a computation that may succeed or fail.
pub type Result<T, E> {
  --- A successful value.
  Ok(T),
  --- A recoverable error.
  Err(E)
}

--- Construct a successful result.
pub fn result_ok<T, E>(value: T) -> Result<T, E> {
  Ok<T, E>(value)
}

--- Construct a failed result.
pub fn result_err<T, E>(error: E) -> Result<T, E> {
  Err<T, E>(error)
}

impl<T, E> Result<T, E> {
  --- Return `1` for `Ok` and `0` for `Err`.
  pub fn is_ok(self) -> i64 {
    match self {
      Ok(v) -> 1
      Err(e) -> 0
    }
  }

  --- Return `1` for `Err` and `0` for `Ok`.
  pub fn is_err(self) -> i64 {
    match self {
      Ok(v) -> 0
      Err(e) -> 1
    }
  }

  --- Return the successful value, or `default` after failure.
  pub fn unwrap_or(self, default: T) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> default
    }
  }

  --- Return the successful value, panicking after failure.
  pub fn unwrap(self) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> panic("Result.unwrap called on Err")
    }
  }

  --- Return the successful value, panicking with `msg` after failure.
  pub fn expect(self, msg: str) -> T {
    match self {
      Ok(v) -> v
      Err(e) -> panic(msg)
    }
  }
}

--- Transform a successful value while preserving an error.
pub fn result_map<T, U, E>(res: Result<T, E>, f: (T) -> U) -> Result<U, E> {
  match res {
    Ok(v) -> result_ok<U, E>(f(v))
    Err(e) -> result_err<U, E>(e)
  }
}
