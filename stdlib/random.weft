-- stdlib/random.weft -- pure deterministic pseudo-random values
--
-- This module is for reproducible simulation and testing. Cryptographic
-- entropy is the separate `stdlib/secure_random` capability.

use stdlib/result.{Err, Ok, Result}

--- The stable identity of a deterministic pseudo-random algorithm.
pub type Algorithm {
  --- SplitMix64 with its specified one-word transition and mixing function.
  SplitMix64V1
}

--- A full-width deterministic seed.
pub type Seed = opaque u64

--- One immutable point in a deterministic pseudo-random sequence.
---
--- Stepping returns a new state and leaves the input reusable, so callers may
--- branch a reproducible sequence explicitly. State is a scalar value; it
--- owns no allocation or ambient process state.
pub type State = opaque u64

--- A validated nonzero exclusive upper bound for bounded selection.
pub type Bound = opaque usize

--- The exact failure to construct a bounded-selection domain.
pub type BoundError {
  --- An exclusive upper bound of zero contains no selectable value.
  ZeroBound
}

fn seed_value(seed: Seed) -> u64 {
  match seed { Seed(value) -> value }
}

fn state_value(state: State) -> u64 {
  match state { State(value) -> value }
}

fn bound_value(bound: Bound) -> usize {
  match bound { Bound(value) -> value }
}

fn mix_splitmix64(value: u64) -> u64 {
  let mixed30 = (value bxor (value bshr 30)) * 13787848793156543929
  let mixed27 = (mixed30 bxor (mixed30 bshr 27)) * 10723151780598845931
  mixed27 bxor (mixed27 bshr 31)
}

--- Construct a full-width deterministic seed.
pub fn seed(value: u64) -> Seed { Seed(value) }

--- Construct the initial deterministic state for `seed`.
pub fn from_seed(seed: Seed) -> State { State(seed_value(seed)) }

--- Validate a nonempty half-open bounded-selection domain `[0, upper)`.
pub fn bound(upper: usize) -> Result<Bound, BoundError> {
  if upper == 0 {
    Err<Bound, BoundError>(ZeroBound)
  } else {
    Ok<Bound, BoundError>(Bound(upper))
  }
}

impl Seed {
  --- Return the exact full-width seed value for recording and replay.
  pub fn value(self) -> u64 { seed_value(self) }
}

impl Bound {
  --- Return this bound's exclusive upper limit.
  pub fn exclusive_upper(self) -> usize { bound_value(self) }
}

impl State {
  --- Return the algorithm which interprets this state.
  pub fn algorithm(self) -> Algorithm { SplitMix64V1 }

  --- Advance once and return the successor state with one uniform word.
  pub fn next_u64(self) -> (State, u64) {
    let next = state_value(self) + 11400714819323198485
    (State(next), mix_splitmix64(next))
  }

  --- Select uniformly from `[0, bound)` and return the consumed successor.
  ---
  --- Rejection sampling removes modulo bias. A rejection advances the state,
  --- so the returned successor always identifies the exact consumed prefix.
  pub fn next_below(self, bound: Bound) -> (State, usize) {
    let limit = __usize_to_u64(bound_value(bound))
    let zero: u64 = 0
    let threshold = (zero - limit) % limit
    let (first_state, first_word) = self.next_u64()
    let mut current = first_state
    let mut word = first_word
    while word < threshold {
      let (next, candidate) = current.next_u64()
      current = next
      word = candidate
    }
    (current, __u64_to_usize(word % limit))
  }
}
