-- stdlib/test.weft -- reusable Test effect surface
--
-- `weft test` installs the native assertion handler for this effect. Ordinary
-- programs and external runners may import the same declarations and install
-- their own handler configuration.

use stdlib/diagnostic_type.{*}
pub use stdlib/fail.{Fail}
pub use stdlib/io.{IO}
use stdlib/vector_type.{*}

--- Integer state used by tests that exercise custom `TestState` handlers.
pub effect TestState {
  --- Read the current test state.
  fn get() -> i64
  --- Replace the current test state.
  fn put(v: i64) -> nil
}

--- Assertions and capability helpers installed by `weft test`.
pub effect Test {
  --- Require two integers to be equal.
  fn assert_eq(got: i64, expected: i64) -> i64
  --- Require two integers to differ.
  fn assert_ne(got: i64, unexpected: i64) -> i64
  --- Require a boolean value to be true.
  fn assert_true(value: bool) -> i64
  --- Require a boolean value to be false.
  fn assert_false(value: bool) -> i64
  --- Require `left` to be less than `right`.
  fn assert_lt(left: i64, right: i64) -> i64
  --- Require `left` to be less than or equal to `right`.
  fn assert_le(left: i64, right: i64) -> i64
  --- Require `left` to be greater than `right`.
  fn assert_gt(left: i64, right: i64) -> i64
  --- Require `left` to be greater than or equal to `right`.
  fn assert_ge(left: i64, right: i64) -> i64
  --- Require two strings to be byte-for-byte equal.
  fn assert_str_eq(got: str, expected: str) -> i64
  --- Require two strings to differ.
  fn assert_str_ne(got: str, unexpected: str) -> i64
  --- Compare rendered output with an inline snapshot.
  fn assert_snapshot(got: str, expected: str) -> i64
  --- Require two integer vectors to have identical values in order.
  fn assert_i64_vector_eq(got: Vector<i64>, expected: Vector<i64>) -> i64
  --- Require two floating-point values to compare exactly equal.
  fn assert_eq_f64(got: f64, expected: f64) -> i64
  --- Require two floating-point values to differ by at most `epsilon`.
  fn assert_near_f64(got: f64, expected: f64, epsilon: f64) -> i64
  --- Check `property` for every integer in the half-open range.
  fn forall_i64_range(start: i64, end: i64, property: (i64) -> bool) -> i64
  --- Run `body` with an isolated integer state initialized to `initial`.
  fn with_state_i64(initial: i64, body: () -[TestState]> i64) -> i64
  --- Require `body` to abort with the expected integer failure.
  fn expect_fail_i64(expected: i64, body: () -[Fail<i64>]> i64) -> i64
  --- Run `body` with the test runner's deterministic `IO` handler.
  fn with_io_i64(body: () -[IO]> i64) -> i64
  --- Run `body` while capturing structured diagnostics for assertions.
  fn with_diagnose_i64(body: () -[Diagnose]> i64) -> i64
}
