-- stdlib/test.weft -- reusable Test effect surface
--
-- `weft test` installs the native assertion handler for this effect. Ordinary
-- programs and external runners may import the same declarations and install
-- their own handler configuration.

use stdlib/diagnostic_type.{*}
use stdlib/vector_type.{*}

pub effect TestState {
  fn get() -> i64
  fn put(v: i64) -> nil
}

pub effect Fail<E> {
  fn fail(error: E) -> never
}

pub effect IO {
  fn read(fd: i64, buf: i64, len: i64) -> i64
  fn write(fd: i64, buf: i64, len: i64) -> i64
  fn open(path: str, flags: i64, mode: i64) -> i64
  fn close(fd: i64) -> i64
}

pub effect Test {
  fn assert_eq(got: i64, expected: i64) -> i64
  fn assert_ne(got: i64, unexpected: i64) -> i64
  fn assert_true(value: bool) -> i64
  fn assert_false(value: bool) -> i64
  fn assert_lt(left: i64, right: i64) -> i64
  fn assert_le(left: i64, right: i64) -> i64
  fn assert_gt(left: i64, right: i64) -> i64
  fn assert_ge(left: i64, right: i64) -> i64
  fn assert_str_eq(got: str, expected: str) -> i64
  fn assert_str_ne(got: str, unexpected: str) -> i64
  fn assert_snapshot(got: str, expected: str) -> i64
  fn assert_i64_vector_eq(got: Vector<i64>, expected: Vector<i64>) -> i64
  fn assert_eq_f64(got: f64, expected: f64) -> i64
  fn assert_near_f64(got: f64, expected: f64, epsilon: f64) -> i64
  fn forall_i64_range(start: i64, end: i64, property: (i64) -> bool) -> i64
  fn with_state_i64(initial: i64, body: () -[TestState]> i64) -> i64
  fn expect_fail_i64(expected: i64, body: () -[Fail<i64>]> i64) -> i64
  fn with_io_i64(body: () -[IO]> i64) -> i64
  fn with_diagnose_i64(body: () -[Diagnose]> i64) -> i64
}
