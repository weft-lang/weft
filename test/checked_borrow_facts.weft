-- Checked slice provenance uses semantic binding identities, not source names.

use compiler/project/identity.{ModuleFunctionIdentity, named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI64,
  SemanticImmutable,
  semantic_type_graph_builder,
  semantic_type_id_from_ordinal,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{semantic_type_catalog_single}
use compiler/weft/check/body/borrow.{*}
use compiler/weft/check/body/borrow/facts.{checked_borrow_facts_empty}
use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedImmutableBinding,
  CheckedSourceRange,
  checked_binding_id_eq,
  checked_binding_id_from_ordinal,
  checked_expr_graph_builder,
  checked_expr_id_from_ordinal,
  checked_expr_segment_id
}
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{None, Some}
use stdlib/random as random
use stdlib/result.{*}
use stdlib/test/property as prop
use stdlib/test.{Test}

fn caller(ordinal: usize) -> CheckedBorrowOrigin {
  let module = named_module_identity("fixture/borrow", 71)
  CheckedBorrowOrigin {
    storage: CheckedCallerStorage(
      checked_binding_id_from_ordinal(checked_expr_segment_id(module), ordinal)
    ),
    access: CheckedSharedAccess
  }
}

fn local(ordinal: usize) -> CheckedBorrowOrigin {
  let module = named_module_identity("fixture/borrow", 71)
  CheckedBorrowOrigin {
    storage: CheckedLocalStorage(
      checked_binding_id_from_ordinal(checked_expr_segment_id(module), ordinal)
    ),
    access: CheckedExclusiveAccess
  }
}

fn unknown() -> CheckedBorrowOrigin {
  CheckedBorrowOrigin { storage: CheckedUnknownStorage, access: CheckedSharedAccess }
}

fn caller_for(binding: CheckedBindingId) -> CheckedBorrowOrigin {
  CheckedBorrowOrigin { storage: CheckedCallerStorage(binding), access: CheckedSharedAccess }
}

fn local_for(binding: CheckedBindingId) -> CheckedBorrowOrigin {
  CheckedBorrowOrigin { storage: CheckedLocalStorage(binding), access: CheckedSharedAccess }
}

test "checked storage provenance distinguishes parameters from locals by identity" {
  let module = named_module_identity("fixture/borrow_bindings", 71)
  let owner = ModuleFunctionIdentity(module, 0)
  let segment = semantic_type_segment_id(module)
  let (types, _) = semantic_type_graph_builder(segment).primitive(SemanticI64)
  let value_type = semantic_type_id_from_ordinal(segment, 0)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("parameter local"),
    semantic_type_catalog_single(types.freeze()),
    1
  )
  let parameter_range = CheckedSourceRange { start: 0, end: 9 }
  let local_range = CheckedSourceRange { start: 10, end: 15 }
  let (builder, parameter) = builder.binding(
    owner,
    value_type,
    parameter_range,
    CheckedImmutableBinding
  )
  let builder = builder.function_parameter(parameter)
  let (builder, local) = builder.binding(
    owner,
    value_type,
    local_range,
    CheckedImmutableBinding
  )
  let (builder, root) = builder.local_reference(local, value_type, local_range)
  let graph = builder.function(owner, root).freeze()
  match checked_borrow_binding_storage(graph, parameter) {
    CheckedCallerStorage(found) -> Test.assert_true(checked_binding_id_eq(found, parameter))
    _ -> Test.assert_true(false)
  }
  match checked_borrow_binding_storage(graph, local) {
    CheckedLocalStorage(found) -> Test.assert_true(checked_binding_id_eq(found, local))
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(
    checked_borrow_origins_single(
      CheckedBorrowOrigin {
        storage: checked_borrow_binding_storage(graph, parameter),
        access: CheckedSharedAccess
      }
    )
  ) {
    CheckedBorrowEscapes -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(
    checked_borrow_origins_single(
      CheckedBorrowOrigin {
        storage: checked_borrow_binding_storage(graph, local),
        access: CheckedSharedAccess
      }
    )
  ) {
    CheckedBorrowLocalCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let foreign = named_module_identity("fixture/borrow_bindings", 72)
  match checked_borrow_binding_storage(
    graph,
    checked_binding_id_from_ordinal(checked_expr_segment_id(foreign), 0)
  ) {
    CheckedUnknownStorage -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_binding_storage(
    graph,
    checked_binding_id_from_ordinal(checked_expr_segment_id(module), 2)
  ) {
    CheckedUnknownStorage -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    checked_borrow_origins_valid_for_function(
      graph,
      owner,
      checked_borrow_origins_union(
        checked_borrow_origins_single(caller_for(parameter)),
        checked_borrow_origins_single(local_for(local))
      )
    )
  )
  Test.assert_false(
    checked_borrow_origins_valid_for_function(
      graph,
      owner,
      checked_borrow_origins_single(local_for(parameter))
    )
  )
  Test.assert_false(
    checked_borrow_origins_valid_for_function(
      graph,
      ModuleFunctionIdentity(module, 1),
      checked_borrow_origins_single(caller_for(parameter))
    )
  )
  Test.assert_false(
    checked_borrow_origins_valid_for_function(
      graph,
      owner,
      checked_borrow_origins_single(
        caller_for(checked_binding_id_from_ordinal(checked_expr_segment_id(foreign), 0))
      )
    )
  )
  Test.assert_true(
    checked_borrow_origins_valid_for_function(
      graph,
      owner,
      checked_borrow_origins_single(unknown())
    )
  )
  Test.assert_false(
    checked_borrow_origins_valid_for_function(graph, owner, checked_borrow_origins_empty())
  )
}

test "borrow-qualified slice parameters never acquire an escape origin" {
  let module = named_module_identity("fixture/borrowed_slice_parameter", 71)
  let owner = ModuleFunctionIdentity(module, 0)
  let segment = semantic_type_segment_id(module)
  let (types, integer) = semantic_type_graph_builder(segment).primitive(SemanticI64)
  let (types, slice) = types.slice(integer, SemanticImmutable)
  let (types, borrowed_slice) = types.borrow(slice, SemanticImmutable)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("values"),
    semantic_type_catalog_single(types.freeze()),
    1
  )
  let location = CheckedSourceRange { start: 0, end: 6 }
  let (builder, parameter) = builder.binding(
    owner,
    borrowed_slice,
    location,
    CheckedImmutableBinding
  )
  let builder = builder.function_parameter(parameter)
  let (builder, root) = builder.local_reference(parameter, borrowed_slice, location)
  let graph = builder.function(owner, root).freeze()
  match checked_borrow_binding_storage(graph, parameter) {
    CheckedUnknownStorage -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let origins = checked_borrow_origins_single(
    CheckedBorrowOrigin {
      storage: checked_borrow_binding_storage(graph, parameter),
      access: CheckedSharedAccess
    }
  )
  match checked_borrow_origins_escape(origins) {
    CheckedBorrowUnknownCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "checked borrow joins preserve distinct exact owners" {
  let first = checked_borrow_origins_single(caller(0))
  let second = checked_borrow_origins_single(caller(1))
  let joined = checked_borrow_origins_union(first, second)
  Test.assert_eq_usize(checked_borrow_origins_count(joined), 2)
  Test.assert_false(checked_borrow_origins_overlap(first, second))
  Test.assert_true(checked_borrow_origins_overlap(joined, first))
  Test.assert_eq_usize(
    checked_borrow_origins_count(checked_borrow_origins_union(joined, first)),
    2
  )
}

test "checked borrow identity includes the module segment" {
  let first = checked_borrow_origins_single(caller(0))
  let other_module = named_module_identity("fixture/borrow", 72)
  let other = checked_borrow_origins_single(
    CheckedBorrowOrigin {
      storage: CheckedCallerStorage(
        checked_binding_id_from_ordinal(checked_expr_segment_id(other_module), 0)
      ),
      access: CheckedSharedAccess
    }
  )
  Test.assert_false(checked_borrow_origins_overlap(first, other))
  Test.assert_eq_usize(
    checked_borrow_origins_count(checked_borrow_origins_union(first, other)),
    2
  )
}

test "unknown storage overlaps all nonempty sets but not an empty set" {
  let unknown_set = checked_borrow_origins_single(unknown())
  let empty = checked_borrow_origins_empty()
  Test.assert_true(
    checked_borrow_origins_overlap(unknown_set, checked_borrow_origins_single(local(2)))
  )
  Test.assert_true(
    checked_borrow_origins_overlap(checked_borrow_origins_single(caller(0)), unknown_set)
  )
  Test.assert_false(checked_borrow_origins_overlap(unknown_set, empty))
}

test "only caller-owned origins may escape" {
  let caller_only = checked_borrow_origins_single(caller(0))
  let local_only = checked_borrow_origins_single(local(1))
  let unknown_only = checked_borrow_origins_single(unknown())
  match checked_borrow_origins_escape(caller_only) {
    CheckedBorrowEscapes -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_union(caller_only, local_only)) {
    CheckedBorrowLocalCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(unknown_only) {
    CheckedBorrowUnknownCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_empty()) {
    CheckedBorrowUnknownCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_union(unknown_only, local_only)) {
    CheckedBorrowLocalCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "reborrows may weaken but never strengthen access" {
  let exclusive = checked_borrow_origins_single(local(0))
  let shared = match checked_borrow_origins_reborrow(exclusive, CheckedSharedAccess) {
    Some(value) -> value
    None -> checked_borrow_origins_empty()
  }
  Test.assert_true(checked_borrow_origins_overlap(exclusive, shared))
  match checked_borrow_origins_reborrow(shared, CheckedExclusiveAccess) {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_reborrow(exclusive, CheckedExclusiveAccess) {
    Some(value) -> Test.assert_eq_usize(checked_borrow_origins_count(value), 1)
    None -> Test.assert_true(false)
  }
  match checked_borrow_origins_reborrow(
    checked_borrow_origins_empty(),
    CheckedSharedAccess
  ) {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "shared loans coexist but exclusive loans conflict with overlapping storage" {
  let origin = caller(0)
  let shared = checked_borrow_origins_single(origin)
  let other = checked_borrow_origins_single(caller(1))
  let exclusive = checked_borrow_origins_single(
    CheckedBorrowOrigin {
      storage: origin.storage,
      access: CheckedExclusiveAccess
    }
  )
  let unknown_exclusive = checked_borrow_origins_single(
    CheckedBorrowOrigin { storage: CheckedUnknownStorage, access: CheckedExclusiveAccess }
  )
  Test.assert_true(checked_borrow_origins_overlap(shared, shared))
  Test.assert_false(checked_borrow_origins_exclusive(shared))
  Test.assert_true(checked_borrow_origins_exclusive(exclusive))
  Test.assert_false(
    checked_borrow_origins_exclusive(checked_borrow_origins_union(shared, exclusive))
  )
  Test.assert_false(checked_borrow_origins_exclusive(checked_borrow_origins_empty()))
  Test.assert_false(checked_borrow_origins_conflict(shared, shared))
  Test.assert_true(checked_borrow_origins_conflict(shared, exclusive))
  Test.assert_true(checked_borrow_origins_conflict(exclusive, exclusive))
  Test.assert_false(checked_borrow_origins_conflict(exclusive, other))
  Test.assert_true(checked_borrow_origins_conflict(other, unknown_exclusive))
  Test.assert_false(
    checked_borrow_origins_conflict(checked_borrow_origins_empty(), unknown_exclusive)
  )
}

fn generated_origin(code: usize) -> CheckedBorrowOrigin {
  let binding = checked_binding_id_from_ordinal(
    checked_expr_segment_id(named_module_identity("fixture/borrow_property", 71)),
    code % 5
  )
  let storage = match code % 3 {
    0 -> CheckedCallerStorage(binding)
    1 -> CheckedLocalStorage(binding)
    _ -> CheckedUnknownStorage
  }
  CheckedBorrowOrigin {
    storage: storage,
    access: if code % 2 == 0 { CheckedSharedAccess } else { CheckedExclusiveAccess }
  }
}

fn generated_origins(codes: List<usize>) -> CheckedBorrowOrigins {
  match codes {
    Nil -> checked_borrow_origins_empty()
    Cons(code, rest) -> checked_borrow_origins_union(
      checked_borrow_origins_single(generated_origin(code)),
      generated_origins(rest)
    )
  }
}

fn shifted_codes(codes: List<usize>) -> List<usize> {
  match codes {
    Nil -> Nil<usize>()
    Cons(code, rest) -> shifted_codes(rest).prepend(code + 1)
  }
}

fn borrow_set_laws(codes: List<usize>) -> bool {
  let left = generated_origins(codes)
  let right = generated_origins(shifted_codes(codes))
  let joined = checked_borrow_origins_union(left, right)
  let reverse = checked_borrow_origins_union(right, left)
  checked_borrow_origins_count(joined) == checked_borrow_origins_count(reverse) and
    checked_borrow_origins_count(checked_borrow_origins_union(joined, joined)) ==
    checked_borrow_origins_count(joined) and
    checked_borrow_origins_overlap(left, right) ==
    checked_borrow_origins_overlap(right, left) and
    checked_borrow_origins_conflict(left, right) ==
    checked_borrow_origins_conflict(right, left) and
    (
      not checked_borrow_origins_conflict(left, right) or
        checked_borrow_origins_overlap(left, right)
    ) and
    checked_borrow_origins_overlap(joined, left) ==
    (
      checked_borrow_origins_overlap(left, left) or
        checked_borrow_origins_overlap(right, left)
    )
}

test "checked borrow origin joins obey bounded set laws" {
  let operation = prop.usize_below(32).expect("the origin domain is nonempty")
  let lengths = prop.lengths(0, 10).expect("the origin program length is valid")
  let programs = prop.list<usize>(operation, lengths)
  let config = prop.config(random.seed(0x424f52524f57), 96, 16, 16, 96).expect(
    "the origin campaign is valid"
  )
  prop.check(config, programs, borrow_set_laws)
}

test "borrow facts retain separate view and contained origins by exact expression" {
  let module = named_module_identity("fixture/borrow_fact_plane", 71)
  let segment = checked_expr_segment_id(module)
  let expression = checked_expr_id_from_ordinal(segment, 2)
  let origins = checked_borrow_origins_single(caller(0))
  let empty = checked_borrow_facts_empty(segment)
  let views = match empty.with_view(expression, origins) {
    Some(facts) -> facts
    None -> checked_borrow_facts_empty(segment)
  }
  let both = match views.with_contained(expression, origins) {
    Some(facts) -> facts
    None -> checked_borrow_facts_empty(segment)
  }
  let no_origins: usize = 0
  Test.assert_eq_usize(
    match both.view(expression) {
      Some(found) -> checked_borrow_origins_count(found)
      None -> no_origins
    },
    1
  )
  Test.assert_eq_usize(
    match both.contained(expression) {
      Some(found) -> checked_borrow_origins_count(found)
      None -> no_origins
    },
    1
  )
  Test.assert_true(
    match both.with_view(expression, origins) {
      None -> true
      _ -> false
    }
  )
  Test.assert_true(
    match both.with_contained(expression, origins) {
      None -> true
      _ -> false
    }
  )
  Test.assert_true(
    match both.with_view(expression, checked_borrow_origins_empty()) {
      None -> true
      _ -> false
    }
  )
  let foreign = checked_expr_id_from_ordinal(
    checked_expr_segment_id(named_module_identity("fixture/borrow_fact_plane", 72)),
    2
  )
  Test.assert_true(match both.view(foreign) { None -> true, _ -> false })
  Test.assert_true(match both.with_view(foreign, origins) { None -> true, _ -> false })
}
