-- Checked slice provenance uses semantic binding identities, not source names.

use compiler/project/identity.{named_module_identity}
use compiler/weft/check/body/borrow.{*}
use compiler/weft/check/body/graph.{
  checked_binding_id_from_ordinal,
  checked_expr_segment_id
}
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{None, Some}
use stdlib/random as random
use stdlib/result.{*}
use stdlib/test/property as prop
use stdlib/test.{Test}

fn caller(ordinal: usize) -> CheckedBorrowOrigin {
  let module = named_module_identity("fixture/borrow", 71)
  CheckedBorrowOrigin {
    storage: CheckedCallerStorage(
      checked_binding_id_from_ordinal(checked_expr_segment_id(module), ordinal)
    ),
    access: CheckedSharedAccess
  }
}

fn local(ordinal: usize) -> CheckedBorrowOrigin {
  let module = named_module_identity("fixture/borrow", 71)
  CheckedBorrowOrigin {
    storage: CheckedLocalStorage(
      checked_binding_id_from_ordinal(checked_expr_segment_id(module), ordinal)
    ),
    access: CheckedExclusiveAccess
  }
}

fn unknown() -> CheckedBorrowOrigin {
  CheckedBorrowOrigin { storage: CheckedUnknownStorage, access: CheckedSharedAccess }
}

test "checked borrow joins preserve distinct exact owners" {
  let first = checked_borrow_origins_single(caller(0))
  let second = checked_borrow_origins_single(caller(1))
  let joined = checked_borrow_origins_union(first, second)
  Test.assert_eq_usize(checked_borrow_origins_count(joined), 2)
  Test.assert_false(checked_borrow_origins_overlap(first, second))
  Test.assert_true(checked_borrow_origins_overlap(joined, first))
  Test.assert_eq_usize(
    checked_borrow_origins_count(checked_borrow_origins_union(joined, first)),
    2
  )
}

test "checked borrow identity includes the module segment" {
  let first = checked_borrow_origins_single(caller(0))
  let other_module = named_module_identity("fixture/borrow", 72)
  let other = checked_borrow_origins_single(
    CheckedBorrowOrigin {
      storage: CheckedCallerStorage(
        checked_binding_id_from_ordinal(checked_expr_segment_id(other_module), 0)
      ),
      access: CheckedSharedAccess
    }
  )
  Test.assert_false(checked_borrow_origins_overlap(first, other))
  Test.assert_eq_usize(
    checked_borrow_origins_count(checked_borrow_origins_union(first, other)),
    2
  )
}

test "unknown storage overlaps all nonempty sets but not an empty set" {
  let unknown_set = checked_borrow_origins_single(unknown())
  let empty = checked_borrow_origins_empty()
  Test.assert_true(
    checked_borrow_origins_overlap(unknown_set, checked_borrow_origins_single(local(2)))
  )
  Test.assert_true(
    checked_borrow_origins_overlap(checked_borrow_origins_single(caller(0)), unknown_set)
  )
  Test.assert_false(checked_borrow_origins_overlap(unknown_set, empty))
}

test "only caller-owned origins may escape" {
  let caller_only = checked_borrow_origins_single(caller(0))
  let local_only = checked_borrow_origins_single(local(1))
  let unknown_only = checked_borrow_origins_single(unknown())
  match checked_borrow_origins_escape(caller_only) {
    CheckedBorrowEscapes -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_union(caller_only, local_only)) {
    CheckedBorrowLocalCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(unknown_only) {
    CheckedBorrowUnknownCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_empty()) {
    CheckedBorrowUnknownCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_escape(checked_borrow_origins_union(unknown_only, local_only)) {
    CheckedBorrowLocalCannotEscape -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "reborrows may weaken but never strengthen access" {
  let exclusive = checked_borrow_origins_single(local(0))
  let shared = match checked_borrow_origins_reborrow(exclusive, CheckedSharedAccess) {
    Some(value) -> value
    None -> checked_borrow_origins_empty()
  }
  Test.assert_true(checked_borrow_origins_overlap(exclusive, shared))
  match checked_borrow_origins_reborrow(shared, CheckedExclusiveAccess) {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match checked_borrow_origins_reborrow(exclusive, CheckedExclusiveAccess) {
    Some(value) -> Test.assert_eq_usize(checked_borrow_origins_count(value), 1)
    None -> Test.assert_true(false)
  }
  match checked_borrow_origins_reborrow(
    checked_borrow_origins_empty(),
    CheckedSharedAccess
  ) {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

fn generated_origin(code: usize) -> CheckedBorrowOrigin {
  let binding = checked_binding_id_from_ordinal(
    checked_expr_segment_id(named_module_identity("fixture/borrow_property", 71)),
    code % 5
  )
  let storage = match code % 3 {
    0 -> CheckedCallerStorage(binding)
    1 -> CheckedLocalStorage(binding)
    _ -> CheckedUnknownStorage
  }
  CheckedBorrowOrigin {
    storage: storage,
    access: if code % 2 == 0 { CheckedSharedAccess } else { CheckedExclusiveAccess }
  }
}

fn generated_origins(codes: List<usize>) -> CheckedBorrowOrigins {
  match codes {
    Nil -> checked_borrow_origins_empty()
    Cons(code, rest) -> checked_borrow_origins_union(
      checked_borrow_origins_single(generated_origin(code)),
      generated_origins(rest)
    )
  }
}

fn shifted_codes(codes: List<usize>) -> List<usize> {
  match codes {
    Nil -> Nil<usize>()
    Cons(code, rest) -> shifted_codes(rest).prepend(code + 1)
  }
}

fn borrow_set_laws(codes: List<usize>) -> bool {
  let left = generated_origins(codes)
  let right = generated_origins(shifted_codes(codes))
  let joined = checked_borrow_origins_union(left, right)
  let reverse = checked_borrow_origins_union(right, left)
  checked_borrow_origins_count(joined) == checked_borrow_origins_count(reverse) and
    checked_borrow_origins_count(checked_borrow_origins_union(joined, joined)) ==
    checked_borrow_origins_count(joined) and
    checked_borrow_origins_overlap(left, right) ==
    checked_borrow_origins_overlap(right, left) and
    checked_borrow_origins_overlap(joined, left) ==
    (
      checked_borrow_origins_overlap(left, left) or
        checked_borrow_origins_overlap(right, left)
    )
}

test "checked borrow origin joins obey bounded set laws" {
  let operation = prop.usize_below(32).expect("the origin domain is nonempty")
  let lengths = prop.lengths(0, 10).expect("the origin program length is valid")
  let programs = prop.list<usize>(operation, lengths)
  let config = prop.config(random.seed(0x424f52524f57), 96, 16, 16, 96).expect(
    "the origin campaign is valid"
  )
  prop.check(config, programs, borrow_set_laws)
}
