use stdlib/diagnostic/schema.{*}
use stdlib/grammar.{Grammar, CheckedGrammar, ParseResult, Parsed, Recovered, Rejected, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/source.{Source}
use stdlib/state as state
use stdlib/typecheck.{*}
use compiler/grammar_registry.{*}

fn sql_test_resolved(identity: str, description: SemanticTypeFact) -> ResolvedType<str> {
  ResolvedType { identity: identity, description: description }
}

fn sql_test_primitive(name: str) -> ResolvedType<str> {
  sql_test_resolved(name, SemanticTypePrimitive(name))
}

fn sql_test_named(name: str) -> ResolvedType<str> {
  sql_test_resolved(name, SemanticTypeNamed(name, SemanticTypeFactListNil))
}

fn sql_test_field(name: str, value: str) -> ResolvedField<str> {
  ResolvedField { selector: NamedTypeField(name), value: sql_test_primitive(value) }
}

fn sql_test_nullable_field(name: str) -> ResolvedField<str> {
  ResolvedField {
    selector: NamedTypeField(name),
    value: sql_test_resolved(
      "nullable_i64",
      SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("nil"))
    )
  }
}

fn sql_test_fields(identity: str) -> Result<List<ResolvedField<str>>, TypeQueryError> {
  if identity == "users" {
    Ok(Cons(sql_test_field("id", "i64"), Cons(
      sql_test_field("name", "str"),
      Cons(sql_test_field("active", "bool"), Nil<ResolvedField<str>>())
    )))
  } else { if identity == "orders" {
    Ok(Cons(sql_test_field("id", "i64"), Cons(
      sql_test_field("user_id", "i64"),
      Cons(sql_test_field("total", "i64"), Nil<ResolvedField<str>>())
    )))
  } else { if identity == "nullable_rows" {
    Ok(Cons(sql_test_nullable_field("id"), Nil<ResolvedField<str>>()))
  } else {
    Err<List<ResolvedField<str>>, TypeQueryError>(TypeFieldsUnavailable)
  } } }
}

fn sql_test_find_field(fields: List<ResolvedField<str>>, name: str) -> Result<ResolvedType<str>, TypeQueryError> {
  match fields {
    Nil -> Err<ResolvedType<str>, TypeQueryError>(TypeFieldNotFound)
    Cons(field, rest) -> match field.selector {
      NamedTypeField(candidate) -> if candidate == name { Ok<ResolvedType<str>, TypeQueryError>(field.value) }
        else { sql_test_find_field(rest, name) }
      _ -> sql_test_find_field(rest, name)
    }
  }
}

fn sql_test_resolve(name: str) -> Result<ResolvedType<str>, TypeQueryError> {
  if name == "i64" or name == "str" or name == "bool" {
    Ok<ResolvedType<str>, TypeQueryError>(sql_test_primitive(name))
  } else { if name == "users" or name == "orders" or name == "nullable_rows" {
    Ok<ResolvedType<str>, TypeQueryError>(sql_test_named(name))
  } else {
    Err<ResolvedType<str>, TypeQueryError>(TypeNotFound)
  } }
}

fn sql_test_run_catalog<R, E>(body: () -[TypeCheck<str>, E]> R) -[E]> R {
  handle body() {
    TypeCheck<str>.resolve(request) -> resume(sql_test_resolve(request.name))
    TypeCheck<str>.field(base, field) -> resume(match field {
      NamedTypeField(name) -> match sql_test_fields(base) {
        Ok(fields) -> sql_test_find_field(fields, name)
        Err(error) -> Err<ResolvedType<str>, TypeQueryError>(error)
      }
      PositionalTypeField(position) -> Err<ResolvedType<str>, TypeQueryError>(TypeFieldNotFound)
    })
    TypeCheck<str>.fields(base) -> resume(sql_test_fields(base))
    TypeCheck<str>.subtype(actual, expected) -> resume(Ok<bool, TypeQueryError>(actual == expected))
  }
}

fn sql_test_check(source_text: str) -> (CheckResult<SqlPlan<str>>, i64) {
  let source = Source { text: source_text, identity: DiagnosticSourceNamed("checked.sql") }
  state.run(0, () => handle sql_test_run_catalog(() => match sql.grammar().parse(source.all()) {
    Parsed(syntax) -> sql_check.checker<str>().check(syntax)
    Recovered(syntax) -> CheckRejected<SqlPlan<str>>()
    Rejected -> CheckRejected<SqlPlan<str>>()
  }) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

fn sql_test_registry_check(source_text: str) -> (CheckResult<GrammarModulePlan<str>>, i64) {
  let source = Source { text: source_text, identity: DiagnosticSourceNamed("registry.sql") }
  state.run(0, () => handle sql_test_run_catalog(() => match grammar_module_parse_syntax(grammar_module_mini_sql(), source.all()) {
    Parsed(syntax) -> grammar_module_check_plan<str>(grammar_module_mini_sql(), syntax)
    Recovered(syntax) -> CheckRejected<GrammarModulePlan<str>>()
    Rejected -> CheckRejected<GrammarModulePlan<str>>()
  }) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

test "SQL checking binds source fields and describes projected output" {
  let (result, errors) = sql_test_check("select id, name as label from users where active order by label limit 5")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> plan.source.row.identity == "users" and match plan.selection {
      SqlPlanSelect(Cons(first, Cons(second, Nil))) ->
        match first.expression { SqlPlanColumn(binding) -> binding.field.text == "id" and binding.value.identity == "i64", _ -> false } and
        match second.expression { SqlPlanColumn(binding) -> binding.field.text == "name" and binding.value.identity == "str", _ -> false } and
        match second.alias { Some(alias) -> alias.text == "label", None -> false }
      _ -> false
    } and match plan.output {
      SqlOutputRecord(Cons(id, Cons(label, Nil))) ->
        match id.name { Some(name) -> name == "id", None -> false } and
        match label.name { Some(name) -> name == "label", None -> false }
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking retains star as the primary host row" {
  let (result, errors) = sql_test_check("select * from users")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> match (plan.selection, plan.output) {
      (SqlPlanSelectAll(source), SqlOutputSource(SemanticTypeNamed(name, _))) -> source.row.identity == "users" and name == "users"
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking produces joins groups aggregates ordering and paging" {
  let (result, errors) = sql_test_check("select u.name as label, count(*) as n from users u join orders o on u.id = o.user_id group by u.name having count(*) > 1 order by label desc limit 5 offset 2")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) ->
      match plan.joins { Cons(join, Nil) -> join.source.row.identity == "orders", _ -> false } and
      match plan.groups { Cons(SqlPlanColumn(binding), Nil) -> binding.field.text == "name", _ -> false } and
      match plan.selection {
        SqlPlanSelect(Cons(_, Cons(second, Nil))) -> match second.expression {
          SqlPlanAggregateExpression(_, None, value, _) -> value.identity == "i64"
          _ -> false
        }
        _ -> false
      } and
      match plan.order { Cons(order, Nil) -> match order.direction { SqlDescending -> true, _ -> false }, _ -> false } and
      match plan.limit { Some(SqlPlanIntegerLiteral(5, _, _)) -> true, _ -> false } and
      match plan.offset { Some(SqlPlanIntegerLiteral(2, _, _)) -> true, _ -> false }
    CheckRejected -> false
  })
}

test "SQL checking preserves multiple ordering expressions" {
  let (result, errors) = sql_test_check("select name from users order by id + 5 desc, name")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> match plan.order {
      Cons(first, Cons(second, Nil)) ->
        match first.direction { SqlDescending -> true, _ -> false } and
        match second.expression { SqlPlanColumn(binding) -> binding.field.text == "name", _ -> false }
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking rejects ambiguous unqualified columns" {
  let (result, errors) = sql_test_check("select id from users u join orders o on u.id = o.user_id")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects unknown host columns" {
  let (result, errors) = sql_test_check("select missing from users")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects non-boolean predicates" {
  let (result, errors) = sql_test_check("select id from users where name")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects nullable rows until null semantics are explicit" {
  let (result, errors) = sql_test_check("select * from nullable_rows")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "first-party grammar registry carries SQL syntax into its checked plan" {
  let (result, errors) = sql_test_registry_check("select name from users where active")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(GrammarModuleSqlPlan(plan)) ->
      grammar_module_execution_model(grammar_module_mini_sql()) == grammar_module_execution_typed_plan() and
      match plan.selection {
        SqlPlanSelect(Cons(item, Nil)) -> match item.expression {
          SqlPlanColumn(binding) -> binding.source.row.identity == "users" and binding.field.text == "name"
          _ -> false
        }
        _ -> false
      }
    CheckRejected -> false
  })
}
