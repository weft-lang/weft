use stdlib/diagnostic/schema.{*}
use stdlib/grammar.{Grammar, CheckedGrammar, ParseResult, Parsed, Recovered, Rejected, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/execute as sql_execute
use stdlib/grammar/sql/execute.{*}
use stdlib/grammar/sql/plan.{*}
use stdlib/list as list
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/source.{Source}
use stdlib/state as state
use stdlib/typecheck.{*}
use compiler/grammar_registry.{*}

type SqlExpectedRows = List<SqlValues>
type SqlTestFields = List<ResolvedField<str>>

fn sql_test_resolved(identity: str, description: SemanticTypeFact) -> ResolvedType<str> {
  ResolvedType { identity: identity, description: description }
}

fn sql_test_primitive(name: str) -> ResolvedType<str> {
  sql_test_resolved(name, SemanticTypePrimitive(name))
}

fn sql_test_named(name: str) -> ResolvedType<str> {
  sql_test_resolved(name, SemanticTypeNamed(name, SemanticTypeFactListNil))
}

fn sql_test_field(name: str, value: str) -> ResolvedField<str> {
  ResolvedField { selector: NamedTypeField(name), value: sql_test_primitive(value) }
}

fn sql_test_nullable_field(name: str) -> ResolvedField<str> {
  ResolvedField {
    selector: NamedTypeField(name),
    value: sql_test_resolved(
      "nullable_i64",
      SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("nil"))
    )
  }
}

fn sql_test_fields(identity: str) -> Result<SqlTestFields, TypeQueryError> {
  if identity == "users" {
    let fields = [sql_test_field("id", "i64"), sql_test_field("name", "str"), sql_test_field("active", "bool")]
    Ok(list.from_slice(fields[..]))
  } else { if identity == "orders" {
    let fields = [sql_test_field("id", "i64"), sql_test_field("user_id", "i64"), sql_test_field("total", "i64")]
    Ok(list.from_slice(fields[..]))
  } else { if identity == "nullable_rows" {
    let fields = [sql_test_nullable_field("id")]
    Ok(list.from_slice(fields[..]))
  } else {
    Err<SqlTestFields, TypeQueryError>(TypeFieldsUnavailable)
  } } }
}

fn sql_test_find_field(fields: SqlTestFields, name: str) -> Result<ResolvedType<str>, TypeQueryError> {
  match fields {
    Nil -> Err<ResolvedType<str>, TypeQueryError>(TypeFieldNotFound)
    Cons(field, rest) -> match field.selector {
      NamedTypeField(candidate) -> if candidate == name { Ok<ResolvedType<str>, TypeQueryError>(field.value) }
        else { sql_test_find_field(rest, name) }
      _ -> sql_test_find_field(rest, name)
    }
  }
}

fn sql_test_resolve(name: str) -> Result<ResolvedType<str>, TypeQueryError> {
  if name == "i64" or name == "str" or name == "bool" {
    Ok<ResolvedType<str>, TypeQueryError>(sql_test_primitive(name))
  } else { if name == "users" or name == "orders" or name == "nullable_rows" {
    Ok<ResolvedType<str>, TypeQueryError>(sql_test_named(name))
  } else {
    Err<ResolvedType<str>, TypeQueryError>(TypeNotFound)
  } }
}

fn sql_test_run_catalog<R, E>(body: () -[TypeCheck<str>, E]> R) -[E]> R {
  handle body() {
    TypeCheck<str>.resolve(request) -> resume(sql_test_resolve(request.name))
    TypeCheck<str>.field(base, field) -> resume(match field {
      NamedTypeField(name) -> match sql_test_fields(base) {
        Ok(fields) -> sql_test_find_field(fields, name)
        Err(error) -> Err<ResolvedType<str>, TypeQueryError>(error)
      }
      PositionalTypeField(position) -> Err<ResolvedType<str>, TypeQueryError>(TypeFieldNotFound)
    })
    TypeCheck<str>.fields(base) -> resume(sql_test_fields(base))
    TypeCheck<str>.subtype(actual, expected) -> resume(Ok<bool, TypeQueryError>(actual == expected))
  }
}

fn sql_test_check(source_text: str) -> (CheckResult<SqlPlan<str>>, i64) {
  let source = Source { text: source_text, identity: DiagnosticSourceNamed("checked.sql") }
  state.run(0, () => handle sql_test_run_catalog(() => match sql.grammar().parse(source.all()) {
    Parsed(syntax) -> sql_check.checker<str>().check(syntax)
    Recovered(syntax) -> CheckRejected<SqlPlan<str>>()
    Rejected -> CheckRejected<SqlPlan<str>>()
  }) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

fn sql_test_registry_check(source_text: str) -> (CheckResult<GrammarModulePlan<str>>, i64) {
  let source = Source { text: source_text, identity: DiagnosticSourceNamed("registry.sql") }
  state.run(0, () => handle sql_test_run_catalog(() => match grammar_module_parse_syntax(grammar_module_mini_sql(), source.all()) {
    Parsed(syntax) -> grammar_module_check_plan<str>(grammar_module_mini_sql(), syntax)
    Recovered(syntax) -> CheckRejected<GrammarModulePlan<str>>()
    Rejected -> CheckRejected<GrammarModulePlan<str>>()
  }) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

fn sql_test_values1(a: SqlValue) -> SqlValues {
  let values = [a]
  list.from_slice(values[..])
}

fn sql_test_values2(a: SqlValue, b: SqlValue) -> SqlValues {
  let values = [a, b]
  list.from_slice(values[..])
}

fn sql_test_values3(a: SqlValue, b: SqlValue, c: SqlValue) -> SqlValues {
  let values = [a, b, c]
  list.from_slice(values[..])
}

fn sql_test_values4(a: SqlValue, b: SqlValue, c: SqlValue, d: SqlValue) -> SqlValues {
  let values = [a, b, c, d]
  list.from_slice(values[..])
}

fn sql_test_values5(a: SqlValue, b: SqlValue, c: SqlValue, d: SqlValue, e: SqlValue) -> SqlValues {
  let values = [a, b, c, d, e]
  list.from_slice(values[..])
}

fn sql_test_values6(a: SqlValue, b: SqlValue, c: SqlValue, d: SqlValue, e: SqlValue, f: SqlValue) -> SqlValues {
  let values = [a, b, c, d, e, f]
  list.from_slice(values[..])
}

fn sql_test_user(id: i64, name: str, active: bool) -> SqlInputRow {
  SqlInputRow { values: sql_test_values3(SqlIntegerValue(id), SqlStringValue(name), SqlBooleanValue(active)) }
}

fn sql_test_order(id: i64, user_id: i64, total: i64) -> SqlInputRow {
  SqlInputRow { values: sql_test_values3(SqlIntegerValue(id), SqlIntegerValue(user_id), SqlIntegerValue(total)) }
}

fn sql_test_users() -> SqlInputRows {
  let rows = [
    sql_test_user(1, "Ada", true),
    sql_test_user(2, "Bob", false),
    sql_test_user(3, "Ada", true),
    sql_test_user(4, "Cy", true),
  ]
  list.from_slice(rows[..])
}

fn sql_test_orders() -> SqlInputRows {
  let rows = [
    sql_test_order(10, 1, 60),
    sql_test_order(11, 1, 50),
    sql_test_order(12, 2, 200),
    sql_test_order(13, 3, 70),
    sql_test_order(14, 3, 40),
  ]
  list.from_slice(rows[..])
}

fn sql_test_source_rows<I>(source: SqlPlanSource<I>) -> SqlInputRows {
  if source.table.text == "users" { sql_test_users() }
  else { if source.table.text == "orders" { sql_test_orders() }
  else { Nil<SqlInputRow>() } }
}

fn sql_test_inputs<I>(plan: SqlPlan<I>) -> SqlInputs<I> {
  let source = plan.source()
  let first = [sql_execute.input(source, sql_test_source_rows(source))]
  let mut inputs = list.from_slice(first[..])
  let joins = plan.joins()
  for join in joins {
    let joined_source = join.source
    inputs = inputs.append(sql_execute.input(joined_source, sql_test_source_rows(joined_source)))
  }
  inputs
}

fn sql_test_execute(source_text: str) -> Option<SqlExecutionResult<str>> {
  let (result, errors) = sql_test_check(source_text)
  if errors > 0 { None<SqlExecutionResult<str>>() }
  else { match result {
    Checked(plan) -> Some(sql_execute.run(plan, sql_test_inputs(plan)))
    CheckRejected -> None<SqlExecutionResult<str>>()
  } }
}

fn sql_test_plan(source_text: str) -> Option<SqlPlan<str>> {
  let (result, errors) = sql_test_check(source_text)
  if errors > 0 { None<SqlPlan<str>>() }
  else { match result { Checked(plan) -> Some(plan), CheckRejected -> None<SqlPlan<str>>() } }
}

fn sql_test_value_same(left: SqlValue, right: SqlValue) -> bool {
  match (left, right) {
    (SqlIntegerValue(a), SqlIntegerValue(b)) -> a == b
    (SqlStringValue(a), SqlStringValue(b)) -> a == b
    (SqlBooleanValue(a), SqlBooleanValue(b)) -> a == b
    _ -> false
  }
}

fn sql_test_values_same(left: SqlValues, right: SqlValues) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(a, ar), Cons(b, br)) -> sql_test_value_same(a, b) and sql_test_values_same(ar, br)
    _ -> false
  }
}

fn sql_test_record_rows_same(rows: SqlOutputRows, expected: SqlExpectedRows) -> bool {
  match (rows, expected) {
    (Nil, Nil) -> true
    (Cons(SqlOutputRecordRow(actual), row_rest), Cons(wanted, wanted_rest)) ->
      sql_test_values_same(actual, wanted) and sql_test_record_rows_same(row_rest, wanted_rest)
    _ -> false
  }
}

fn sql_test_expected(rows: [SqlValues]) -> SqlExpectedRows {
  list.from_slice(rows)
}

fn sql_test_input_rows(rows: [SqlInputRow]) -> SqlInputRows {
  list.from_slice(rows)
}

fn sql_test_input_sources<I>(inputs: [SqlInputSource<I>]) -> SqlInputs<I> {
  list.from_slice(inputs)
}

test "SQL checking binds source fields and describes projected output" {
  let (result, errors) = sql_test_check("select id, name as label from users where active order by label limit 5")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> plan.source().row.identity == "users" and plan.source().fields.len() == 3 and match plan.selection() {
      SqlPlanSelect(Cons(first, Cons(second, Nil))) ->
        match first.expression { SqlPlanColumn(binding) -> binding.field.text == "id" and binding.position == 0 and binding.value.identity == "i64", _ -> false } and
        match second.expression { SqlPlanColumn(binding) -> binding.field.text == "name" and binding.position == 1 and binding.value.identity == "str", _ -> false } and
        match second.alias { Some(alias) -> alias.text == "label", None -> false }
      _ -> false
    } and match plan.output() {
      SqlOutputRecord(Cons(id, Cons(label, Nil))) ->
        match id.name { Some(name) -> name == "id", None -> false } and
        match label.name { Some(name) -> name == "label", None -> false }
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking retains star as the primary host row" {
  let (result, errors) = sql_test_check("select * from users")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> match (plan.selection(), plan.output()) {
      (SqlPlanSelectAll(source), SqlOutputSource(SemanticTypeNamed(name, _))) -> source.row.identity == "users" and name == "users"
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking produces joins groups aggregates ordering and paging" {
  let (result, errors) = sql_test_check("select u.name as label, count(*) as n from users u join orders o on u.id = o.user_id group by u.name having count(*) > 1 order by label desc limit 5 offset 2")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) ->
      match plan.joins() { Cons(join, Nil) -> join.source.row.identity == "orders", _ -> false } and
      match plan.groups() { Cons(SqlPlanColumn(binding), Nil) -> binding.field.text == "name", _ -> false } and
      match plan.selection() {
        SqlPlanSelect(Cons(_, Cons(second, Nil))) -> match second.expression {
          SqlPlanAggregateExpression(_, None, value, _) -> value.identity == "i64"
          _ -> false
        }
        _ -> false
      } and
      match plan.order() { Cons(order, Nil) -> match order.direction { SqlDescending -> true, _ -> false }, _ -> false } and
      match plan.limit() { Some(SqlPlanIntegerLiteral(5, _, _)) -> true, _ -> false } and
      match plan.offset() { Some(SqlPlanIntegerLiteral(2, _, _)) -> true, _ -> false }
    CheckRejected -> false
  })
}

test "SQL checking preserves multiple ordering expressions" {
  let (result, errors) = sql_test_check("select name from users order by id + 5 desc, name")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(plan) -> match plan.order() {
      Cons(first, Cons(second, Nil)) ->
        match first.direction { SqlDescending -> true, _ -> false } and
        match second.expression { SqlPlanColumn(binding) -> binding.field.text == "name", _ -> false }
      _ -> false
    }
    CheckRejected -> false
  })
}

test "SQL checking rejects ambiguous unqualified columns" {
  let (result, errors) = sql_test_check("select id from users u join orders o on u.id = o.user_id")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects unknown host columns" {
  let (result, errors) = sql_test_check("select missing from users")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects non-boolean predicates" {
  let (result, errors) = sql_test_check("select id from users where name")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects nullable rows until null semantics are explicit" {
  let (result, errors) = sql_test_check("select * from nullable_rows")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects join predicates that reference later sources" {
  let (result, errors) = sql_test_check("select u.name from users u join orders o on later.id = o.user_id join users later on o.user_id = later.id")
  Test.assert_true(errors > 0)
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking rejects row-dependent paging expressions" {
  let (limit_result, limit_errors) = sql_test_check("select name from users limit id")
  let (offset_result, offset_errors) = sql_test_check("select name from users offset id")
  Test.assert_true(limit_errors > 0)
  Test.assert_true(offset_errors > 0)
  Test.assert_true(match limit_result { CheckRejected -> true, Checked(_) -> false })
  Test.assert_true(match offset_result { CheckRejected -> true, Checked(_) -> false })
}

test "SQL checking requires DISTINCT ordering expressions in the projection" {
  let (accepted, accepted_errors) = sql_test_check("select distinct name from users order by name")
  let (rejected, rejected_errors) = sql_test_check("select distinct name from users order by id")
  Test.assert_eq(accepted_errors, 0)
  Test.assert_true(match accepted { Checked(_) -> true, CheckRejected -> false })
  Test.assert_true(rejected_errors > 0)
  Test.assert_true(match rejected { CheckRejected -> true, Checked(_) -> false })
}

test "first-party grammar registry carries SQL syntax into its checked plan" {
  let (result, errors) = sql_test_registry_check("select name from users where active")
  Test.assert_eq(errors, 0)
  Test.assert_true(match result {
    Checked(GrammarModuleSqlPlan(plan)) ->
      grammar_module_execution_model(grammar_module_mini_sql()) == grammar_module_execution_runtime() and
      match plan.selection() {
        SqlPlanSelect(Cons(item, Nil)) -> match item.expression {
          SqlPlanColumn(binding) -> binding.source.row.identity == "users" and binding.field.text == "name"
          _ -> false
        }
        _ -> false
      }
    Checked(GrammarModuleEinsumPlan(_)) -> false
    CheckRejected -> false
  })
}

test "SQL reference handler interprets the shared Lower request" {
  let plan = sql_test_plan("select id from users where active order by id limit 1").unwrap()
  let inputs = sql_test_inputs(plan)
  let result = sql_execute.with_reference(() => {
    sql_execute.lower(plan, inputs)
  })
  let rows = [sql_test_values1(SqlIntegerValue(1))]
  let expected = sql_test_expected(rows[..])
  Test.assert_true(match result {
    Ok(execution) -> sql_test_record_rows_same(execution.rows, expected)
    Err(_) -> false
  })
}

test "SQL reference execution filters projects orders and pages deterministically" {
  let result = sql_test_execute("select id + 1 as next, name || '!' as label from users where active order by id desc limit 2 offset 1")
  let rows = [
    sql_test_values2(SqlIntegerValue(4), SqlStringValue("Ada!")),
    sql_test_values2(SqlIntegerValue(2), SqlStringValue("Ada!")),
  ]
  let expected = sql_test_expected(rows[..])
  Test.assert_true(match result {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, expected)
    _ -> false
  })
}

test "SQL reference execution joins groups filters aggregates and orders" {
  let result = sql_test_execute("select u.name, count(*) as n, sum(o.total) as total_due from users u join orders o on u.id = o.user_id group by u.name having sum(o.total) > 150 order by total_due desc")
  let rows = [
    sql_test_values3(SqlStringValue("Ada"), SqlIntegerValue(4), SqlIntegerValue(220)),
    sql_test_values3(SqlStringValue("Bob"), SqlIntegerValue(1), SqlIntegerValue(200)),
  ]
  let expected = sql_test_expected(rows[..])
  Test.assert_true(match result {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, expected)
    _ -> false
  })
}

test "SQL reference execution covers scalar and comparison operators" {
  let scalar = sql_test_execute("select 10 + 2, 10 - 2, 10 * 2, 10 / 2, 'a' || 'b' from users limit 1")
  let comparison = sql_test_execute("select id from users where 1 = 1 and 1 != 2 and 1 < 2 and 1 <= 1 and 2 > 1 and 2 >= 2 order by id limit 1")
  let scalar_rows = [sql_test_values5(
    SqlIntegerValue(12), SqlIntegerValue(8), SqlIntegerValue(20), SqlIntegerValue(5), SqlStringValue("ab")
  )]
  let comparison_rows = [sql_test_values1(SqlIntegerValue(1))]
  let scalar_expected = sql_test_expected(scalar_rows[..])
  let comparison_expected = sql_test_expected(comparison_rows[..])
  Test.assert_true(match scalar {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, scalar_expected)
    _ -> false
  })
  Test.assert_true(match comparison {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, comparison_expected)
    _ -> false
  })
}

test "SQL reference execution evaluates all aggregate variants" {
  let result = sql_test_execute("select count(*) as n, count(total) as values, sum(total) as total, min(total) as low, max(total) as high from orders")
  let rows = [sql_test_values5(
    SqlIntegerValue(5), SqlIntegerValue(5), SqlIntegerValue(420), SqlIntegerValue(40), SqlIntegerValue(200)
  )]
  let expected = sql_test_expected(rows[..])
  Test.assert_true(match result {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, expected)
    _ -> false
  })
}

test "SQL reference execution preserves source rows and removes projected duplicates" {
  let star = sql_test_execute("select * from users where active order by id")
  let distinct = sql_test_execute("select distinct name from users order by name")
  Test.assert_true(match star {
    Some(Ok(execution)) -> match execution.rows {
      Cons(SqlOutputSourceRow(first), Cons(SqlOutputSourceRow(second), Cons(SqlOutputSourceRow(third), Nil))) ->
        sql_test_values_same(first.values, sql_test_values3(SqlIntegerValue(1), SqlStringValue("Ada"), SqlBooleanValue(true))) and
        sql_test_values_same(second.values, sql_test_values3(SqlIntegerValue(3), SqlStringValue("Ada"), SqlBooleanValue(true))) and
        sql_test_values_same(third.values, sql_test_values3(SqlIntegerValue(4), SqlStringValue("Cy"), SqlBooleanValue(true)))
      _ -> false
    }
    _ -> false
  })
  let distinct_rows = [
    sql_test_values1(SqlStringValue("Ada")),
    sql_test_values1(SqlStringValue("Bob")),
    sql_test_values1(SqlStringValue("Cy")),
  ]
  let distinct_expected = sql_test_expected(distinct_rows[..])
  Test.assert_true(match distinct {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, distinct_expected)
    _ -> false
  })
}

test "SQL reference execution orders booleans with stable secondary keys" {
  let result = sql_test_execute("select active, id from users order by active, id desc")
  let rows = [
    sql_test_values2(SqlBooleanValue(false), SqlIntegerValue(2)),
    sql_test_values2(SqlBooleanValue(true), SqlIntegerValue(4)),
    sql_test_values2(SqlBooleanValue(true), SqlIntegerValue(3)),
    sql_test_values2(SqlBooleanValue(true), SqlIntegerValue(1)),
  ]
  let expected = sql_test_expected(rows[..])
  Test.assert_true(match result {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, expected)
    _ -> false
  })
}

test "SQL reference execution short-circuits logical expressions" {
  let conjunction = sql_test_execute("select id from users where false and (1 / 0 = 0)")
  let disjunction = sql_test_execute("select id from users where true or (1 / 0 = 0) order by id limit 1")
  let none: [SqlValues; 0] = []
  let one = [sql_test_values1(SqlIntegerValue(1))]
  Test.assert_true(match conjunction {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, sql_test_expected(none[..]))
    _ -> false
  })
  Test.assert_true(match disjunction {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, sql_test_expected(one[..]))
    _ -> false
  })
}

test "SQL reference execution reports every input contract failure" {
  Test.assert_true(match sql_test_plan("select name from users") {
    Some(plan) -> {
      let none: [SqlInputSource<str>; 0] = []
      let result = sql_execute.run(plan, sql_test_input_sources(none[..]))
      match result {
        Err(SqlInputSourceMissing(source)) -> source.position == 0
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select name from users") {
    Some(plan) -> {
      let supplied = sql_execute.input(plan.source(), sql_test_users())
      let repeated = [supplied, supplied]
      let result = sql_execute.run(plan, sql_test_input_sources(repeated[..]))
      match result {
        Err(SqlInputSourceRepeated(source)) -> source.position == 0
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select name from users") {
    Some(plan) -> {
      let unexpected = sql_execute.input(plan.source().{position: 99}, Nil<SqlInputRow>())
      let inputs = [sql_execute.input(plan.source(), sql_test_users()), unexpected]
      let result = sql_execute.run(plan, sql_test_input_sources(inputs[..]))
      match result {
        Err(SqlInputSourceUnexpected(position)) -> position == 99
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select name from users") {
    Some(plan) -> {
      let bad_rows = [SqlInputRow { values: sql_test_values1(SqlIntegerValue(1)) }]
      let inputs = [sql_execute.input(plan.source(), sql_test_input_rows(bad_rows[..]))]
      let result = sql_execute.run(plan, sql_test_input_sources(inputs[..]))
      match result {
        Err(SqlInputRowWidth(source, row, expected, actual)) -> source.position == 0 and row == 0 and expected == 3 and actual == 1
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select name from users") {
    Some(plan) -> {
      let rows = [
        SqlInputRow { values: sql_test_values3(SqlIntegerValue(1), SqlStringValue("Ada"), SqlBooleanValue(true)) },
        SqlInputRow { values: sql_test_values3(SqlIntegerValue(2), SqlIntegerValue(99), SqlBooleanValue(false)) },
      ]
      let inputs = [sql_execute.input(plan.source(), sql_test_input_rows(rows[..]))]
      let result = sql_execute.run(plan, sql_test_input_sources(inputs[..]))
      match result {
        Err(SqlInputValueType(source, row, field, expected, SqlIntegerValue(actual))) ->
          source.position == 0 and row == 1 and field == 1 and
            match expected { SemanticTypePrimitive(name) -> name == "str", _ -> false } and actual == 99
        _ -> false
      }
    }
    None -> false
  })
}

test "SQL reference execution reports finite evaluation failures" {
  let empty_count = sql_test_execute("select count(*) from users where id > 100")
  let count_rows = [sql_test_values1(SqlIntegerValue(0))]
  Test.assert_true(match empty_count {
    Some(Ok(execution)) -> sql_test_record_rows_same(execution.rows, sql_test_expected(count_rows[..]))
    _ -> false
  })
  Test.assert_true(match sql_test_execute("select 1 / 0 from users limit 1") {
    Some(Err(SqlDivisionByZero(_))) -> true
    _ -> false
  })
  Test.assert_true(match sql_test_plan("select sum(id) from users where id > 100") {
    Some(plan) -> {
      let inputs = [sql_execute.input(plan.source(), sql_test_users())]
      match sql_execute.run(plan, sql_test_input_sources(inputs[..])) {
        Err(SqlAggregateEmpty(SqlSum, _)) -> true
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select min(id) from users where id > 100") {
    Some(plan) -> {
      let inputs = [sql_execute.input(plan.source(), sql_test_users())]
      match sql_execute.run(plan, sql_test_input_sources(inputs[..])) {
        Err(SqlAggregateEmpty(SqlMin, _)) -> true
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_plan("select max(id) from users where id > 100") {
    Some(plan) -> {
      let inputs = [sql_execute.input(plan.source(), sql_test_users())]
      match sql_execute.run(plan, sql_test_input_sources(inputs[..])) {
        Err(SqlAggregateEmpty(SqlMax, _)) -> true
        _ -> false
      }
    }
    None -> false
  })
  Test.assert_true(match sql_test_execute("select id from users limit 1 - 2") {
    Some(Err(SqlPagingNegative(SqlLimitPage, count))) -> count == -1
    _ -> false
  })
  Test.assert_true(match sql_test_execute("select id from users offset 2 - 3") {
    Some(Err(SqlPagingNegative(SqlOffsetPage, count))) -> count == -1
    _ -> false
  })
}
