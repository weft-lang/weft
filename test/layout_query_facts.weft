use compiler/weft/facts/layout.{*}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/types/algebra.{*}
use compiler/weft/check/table.{ttable_new, str_hash}
use compiler/project/module.{*}
use stdlib/option.{Some, None}
use stdlib/test.{Test}

fn query_expect(query: LayoutQuery, ty: i64, tt: i64, expected: i64) -[Test]> nil {
  match layout_query_resolve(query, type_expr_list_one_node(ty), IrValueNil, tt) {
    LayoutQueryResolved(actual_query, source_type, value) -> {
      Test.assert_eq(layout_query_native_key(actual_query), layout_query_native_key(query))
      Test.assert_eq(value, expected)
      Test.assert_eq(type_expr_tag_or(source_type, 0 - 1), ty_tag(ty))
    }
    LayoutQueryUnavailable -> Test.assert_true(false)
  }
  nil
}

test "resolved layout facts preserve primitive widths and managed storage modes" {
  let tt = ttable_new()
  for (ty, size, mode, cleanup) in [
    (ty_nil(), 0, 0, 0), (ty_bool(), 1, 1, 0),
    (ty_i8(), 1, 2, 0), (ty_u8(), 1, 1, 0),
    (ty_i16(), 2, 4, 0), (ty_u16(), 2, 3, 0),
    (ty_i32(), 4, 6, 0), (ty_u32(), 4, 5, 0),
    (ty_i64(), 8, 0, 0), (ty_u64(), 8, 0, 0),
    (ty_isize(), 8, 0, 0), (ty_usize(), 8, 0, 0),
    (ty_f32(), 4, 5, 0), (ty_f64(), 8, 0, 0), (ty_str(), 8, 8, 1)
  ] {
    query_expect(VectorElementSize, ty, tt, size)
    query_expect(VectorElementMode, ty, tt, mode)
    query_expect(MapCleanupKind, ty, tt, cleanup)
    query_expect(VectorLeafCount, ty, tt, 0 - 1)
    query_expect(VectorLeafStride, ty, tt, 0)
    query_expect(VectorLeafKind, ty, tt, 0)
  }
}

test "layout facts distinguish empty arrays from unknown layouts and flatten nested leaves" {
  let tt = ttable_new()
  for (ty, size, count, stride, kind) in [
    (ty_array(ty_i64(), 0), 0, 0, 0, 0),
    (ty_array(ty_u8(), 3), 3, 3, 1, 0),
    (ty_array(ty_i64(), 2), 16, 2, 8, 0),
    (ty_array(ty_array(ty_i64(), 2), 2), 32, 4, 8, 0),
    (ty_array(ty_array(ty_i64(), 0), 3), 0, 0, 0, 0),
    (ty_array(ty_str(), 2), 16, 2, 8, 1)
  ] {
    query_expect(VectorElementSize, ty, tt, size)
    query_expect(VectorLeafCount, ty, tt, count)
    query_expect(VectorLeafStride, ty, tt, stride)
    query_expect(VectorLeafKind, ty, tt, kind)
  }
}

test "unresolved types and malformed query arities never publish constants" {
  let tt = ttable_new()
  let word = type_expr_from_node(ty_i64())
  let one = TypeExprListCons(word, TypeExprListNil)
  let two = TypeExprListCons(word, one)
  for query in [VectorElementSize, VectorElementMode, VectorLeafCount, VectorLeafStride, VectorLeafKind, MapCleanupKind] {
    for args in [TypeExprListNil, two,
      TypeExprListCons(MissingTypeExpr, TypeExprListNil),
      type_expr_list_one_node(ty_var(91)), type_expr_list_one_node(ty_array(ty_var(91), 2)),
      type_expr_list_one_node(ty_any()), TypeExprListCons(UnknownTypeExpr(999), TypeExprListNil)] {
      Test.assert_true(match layout_query_resolve(query, args, IrValueNil, tt) { LayoutQueryUnavailable -> true, _ -> false })
    }
    Test.assert_true(match layout_query_resolve(query, one, IrValueNil, 0) { LayoutQueryUnavailable -> true, _ -> false })
    Test.assert_true(match layout_query_resolve(query, one, IrValueCons(0, IrValueNil), tt) { LayoutQueryUnavailable -> true, _ -> false })
  }
}

test "only the canonical declaration receives each layout intrinsic identity" {
  for query in [VectorElementSize, VectorElementMode, VectorLeafCount, VectorLeafStride, VectorLeafKind, MapCleanupKind] {
    for canonical in [true, false] {
      let tt = ttable_new()
      let name = layout_query_name(query)
      let path = if canonical { layout_query_module(query) } else { "user/library" }
      let source = __str_ptr(name)
      module_fact_register_source(tt, source, __str_ptr(path), __str_len(path), 0)
      let declaration = module_decl_fact_register(tt, source, 0, module_decl_namespace_value(), 0, __str_len(name), module_visibility_package())
      let result = layout_query_from_declaration(declaration, layout_query_name_hash(query))
      Test.assert_true(match result { Some(actual) -> canonical and layout_query_native_key(actual) == layout_query_native_key(query), None -> not canonical })
    }
    Test.assert_true(match layout_query_from_declaration(0, layout_query_name_hash(query)) { None -> true, _ -> false })
    Test.assert_true(match layout_query_from_native_key(layout_query_name_hash(query)) { None -> true, _ -> false })
  }
}

test "layout facts replace only resolved calls and preserve SSA and unrelated calls" {
  let types = type_expr_list_one_node(ty_u16())
  let ordinary = layout_query_name_hash(VectorElementMode)
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrGenericCallI64(0, layout_query_native_key(VectorElementSize), types, IrValueNil),
    IrInstCons(IrGenericCallI64(1, layout_query_native_key(VectorElementMode), types, IrValueNil),
    IrInstCons(IrGenericCallI64(2, layout_query_native_key(MapCleanupKind), types, IrValueNil),
    IrInstCons(IrGenericCallI64(3, ordinary, types, IrValueNil), IrInstNil)))), IrTermReturn(3)), IrBlockListNil)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(12345, 0, blocks, 0)), 0)
  let facts = pipeline_ir_layout_query_facts(blocks, layout_query_native_keys(), ttable_new())
  let result = match facts {
    PipelineIrLayoutQueriesResolved(entries) -> {
      Test.assert_eq_usize(entries.len(), 3)
      pipeline_ir_layout_query_apply_blocks(blocks, entries)
    }
    PipelineIrLayoutQueriesAbsent -> { Test.assert_true(false) blocks }
  }
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(12345, 0, result, 0)), 0)
  Test.assert_true(match result {
    IrBlockListCons(IrBlock(_, _,
      IrInstCons(IrConstI64(0, 2), IrInstCons(IrConstI64(1, 3), IrInstCons(IrConstI64(2, 0),
      IrInstCons(IrGenericCallI64(3, hash, _, IrValueNil), IrInstNil)))), IrTermReturn(3)), IrBlockListNil) -> hash == ordinary
    _ -> false
  })
  -- A second pass sees only constants and an unrelated user call. No query
  -- facts or per-function map are needed on this path.
  Test.assert_true(match pipeline_ir_layout_query_facts(result, layout_query_native_keys(), ttable_new()) {
    PipelineIrLayoutQueriesAbsent -> true
    PipelineIrLayoutQueriesResolved(_) -> false
  })
}
