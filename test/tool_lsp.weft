-- The compiler's LSP surface: request classification, encoding negotiation,
-- workspace paths, the document store, and ranges in each encoding.

use compiler/source/position.{*}
use compiler/tool/jsonrpc.{jsonrpc_render}
use compiler/tool/lsp.{*}
use compiler/weft/facts/semantic.{*}
use stdlib/json as json
use stdlib/json.{Json, JsonNull, JsonString}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok}
use stdlib/string.{str_concat}

fn parsed(text: str) -> Json {
  match json.parse(text) {
    Ok(value) -> value
    Err(_) -> JsonString("<unparsable fixture>")
  }
}

fn describe_position(position: LspPosition) -> str {
  position.line.to_str() |> str_concat(":") |> str_concat(position.character.to_str())
}

fn describe_text(value: str?) -> str {
  match value {
    text: str -> text
    nil -> "<none>"
  }
}

fn describe_version(version: Option<i64>) -> str {
  match version {
    Some(value) -> value.to_str()
    None -> "<none>"
  }
}

fn describe_options(options: Option<Json>) -> str {
  match options {
    Some(value) -> jsonrpc_render(value)
    None -> "<none>"
  }
}

fn describe_request(request: LspRequest) -> str {
  match request {
    LspInitialize(root, encoding) -> "initialize "
      |> str_concat(describe_text(root))
      |> str_concat(" ")
      |> str_concat(lsp_encoding_name(encoding))
    LspInitialized -> "initialized"
    LspShutdown -> "shutdown"
    LspExit -> "exit"
    LspDidOpen(uri, text, version) -> "open "
      |> str_concat(uri)
      |> str_concat(" [")
      |> str_concat(text)
      |> str_concat("] ")
      |> str_concat(version.to_str())
    LspDidChange(uri, version, text) -> "change "
      |> str_concat(uri)
      |> str_concat(" ")
      |> str_concat(describe_version(version))
      |> str_concat(" [")
      |> str_concat(text)
      |> str_concat("]")
    LspDidClose(uri) -> str_concat("close ", uri)
    LspHover(uri, position) -> "hover [" |> str_concat(uri) |> str_concat("] ") |>
      str_concat(describe_position(position))
    LspDefinition(uri, position) -> "definition [" |> str_concat(uri) |> str_concat("] ") |>
      str_concat(describe_position(position))
    LspCompletion(uri, position) -> "completion [" |> str_concat(uri) |> str_concat("] ") |>
      str_concat(describe_position(position))
    LspCodeAction -> "code action"
    LspFormatting(uri, options) -> "formatting [" |> str_concat(uri) |> str_concat("] ") |>
      str_concat(describe_options(options))
    LspMissingDocument -> "missing document"
    LspUnknown -> "unknown"
  }
}

fn classify(method: str, params: str) -> str {
  describe_request(lsp_request(method, parsed(params)))
}

fn document(uri: str, text: str, version: i64) -> LspDocument {
  LspDocument { uri: uri, text: text, version: version }
}

fn open_uris(server: LspServer) -> str {
  let mut out = ""
  let mut remaining = lsp_open_documents(server)
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(open, rest) -> {
        out = out |> str_concat(open.uri) |> str_concat("@") |> str_concat(open.version.to_str()) |>
          str_concat(" ")
        remaining = rest
      }
    }
  }
  out
}

fn range(text: str, start: i64, end: i64, encoding: SourcePositionEncoding) -> str {
  jsonrpc_render(lsp_range(text, start, end, encoding))
}

test "lifecycle_and_document_requests_are_classified" {
  Test.assert_str_eq(
    classify("initialize", "{\"rootUri\":\"file:///w\"}"),
    "initialize file:///w utf-16"
  )
  Test.assert_str_eq(classify("initialize", "{}"), "initialize <none> utf-16")
  Test.assert_str_eq(classify("initialized", "{}"), "initialized")
  Test.assert_str_eq(classify("shutdown", "null"), "shutdown")
  Test.assert_str_eq(classify("exit", "null"), "exit")
  Test.assert_str_eq(
    classify(
      "textDocument/didOpen",
      "{\"textDocument\":{\"uri\":\"file:///a.weft\",\"text\":\"fn\",\"version\":4}}"
    ),
    "open file:///a.weft [fn] 4"
  )
  Test.assert_str_eq(
    classify("textDocument/didOpen", "{\"textDocument\":{\"uri\":\"u\"}}"),
    "open u [] 1"
  )
  Test.assert_str_eq(
    classify("textDocument/didOpen", "{\"textDocument\":{\"text\":\"x\"}}"),
    "missing document"
  )
  Test.assert_str_eq(
    classify(
      "textDocument/didChange",
      "{\"textDocument\":{\"uri\":\"u\",\"version\":3},\"contentChanges\":[{\"text\":\"new\"},{\"text\":\"later\"}]}"
    ),
    "change u 3 [new]"
  )
  Test.assert_str_eq(
    classify("textDocument/didChange", "{\"textDocument\":{\"uri\":\"u\"},\"contentChanges\":[]}"),
    "change u <none> []"
  )
  Test.assert_str_eq(
    classify("textDocument/didChange", "{\"contentChanges\":[{\"text\":\"t\"}]}"),
    "missing document"
  )
  Test.assert_str_eq(
    classify("textDocument/didClose", "{\"textDocument\":{\"uri\":\"u\"}}"),
    "close u"
  )
  Test.assert_str_eq(classify("textDocument/didClose", "{}"), "close ")
  Test.assert_str_eq(classify("textDocument/codeAction", "{}"), "code action")
  Test.assert_str_eq(classify("workspace/symbol", "{}"), "unknown")
}

test "position_requests_default_missing_members" {
  Test.assert_str_eq(
    classify(
      "textDocument/hover",
      "{\"textDocument\":{\"uri\":\"u\"},\"position\":{\"line\":2,\"character\":5}}"
    ),
    "hover [u] 2:5"
  )
  Test.assert_str_eq(
    classify("textDocument/definition", "{\"textDocument\":{\"uri\":\"u\"}}"),
    "definition [u] 0:0"
  )
  Test.assert_str_eq(
    classify("textDocument/completion", "{\"position\":{\"line\":1.5,\"character\":\"3\"}}"),
    "completion [] 0:0"
  )
}

test "formatting_keeps_whether_options_were_given" {
  Test.assert_str_eq(
    classify("textDocument/formatting", "{\"textDocument\":{\"uri\":\"u\"}}"),
    "formatting [u] <none>"
  )
  Test.assert_str_eq(
    classify("textDocument/formatting", "{\"textDocument\":{\"uri\":\"u\"},\"options\":null}"),
    "formatting [u] null"
  )
  Test.assert_str_eq(
    classify(
      "textDocument/formatting",
      "{\"textDocument\":{\"uri\":\"u\"},\"options\":{\"maxLineLength\":80}}"
    ),
    "formatting [u] {\"maxLineLength\":80}"
  )
}

test "the_preferred_offered_encoding_is_negotiated" {
  let cases = [
    "{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-16\",\"utf-8\"]}}}",
    "{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-32\",\"utf-16\"]}}}",
    "{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-32\"]}}}",
    "{\"capabilities\":{\"general\":{\"positionEncodings\":[]}}}",
    "{\"capabilities\":{\"general\":{\"positionEncodings\":\"utf-8\"}}}",
    "{\"capabilities\":{\"general\":{\"positionEncodings\":[8,\"latin-1\"]}}}",
    "{}"
  ]
  let expected = ["utf-8", "utf-16", "utf-32", "utf-16", "utf-16", "utf-16", "utf-16"]
  let mut index: usize = 0
  for params in cases {
    Test.assert_str_eq(
      lsp_encoding_name(lsp_negotiated_encoding(parsed(params))),
      expected[index]
    )
    index = index + 1
  }
}

test "workspaces_come_from_the_root_uri_or_the_first_document" {
  Test.assert_str_eq(lsp_workspace_from_root_uri("file:///work/space///"), "/work/space")
  Test.assert_str_eq(lsp_workspace_from_root_uri("file:///"), "/")
  Test.assert_str_eq(lsp_workspace_from_root_uri("file://"), "")
  Test.assert_str_eq(lsp_workspace_from_root_uri("https://host/x"), "")
  Test.assert_str_eq(lsp_workspace_from_document("file:///a/b/c.weft"), "/a/b")
  Test.assert_str_eq(lsp_workspace_from_document("file:///c.weft"), "/")
  Test.assert_str_eq(lsp_workspace_from_document("untitled:1"), "")
  Test.assert_str_eq(lsp_workspace_from_document("file://"), "")
}

test "documents_are_loaded_under_workspace_relative_paths" {
  Test.assert_str_eq(lsp_document_path("file:///w/app/m.weft", "/w", false), "app/m.weft")
  Test.assert_str_eq(lsp_document_path("file:///w/app/m.weft", "/w", true), "/w/app/m.weft")
  Test.assert_str_eq(lsp_document_path("file:///wide/m.weft", "/w", false), "/wide/m.weft")
  Test.assert_str_eq(lsp_document_path("file:///w", "/w", false), "/w")
  Test.assert_str_eq(lsp_document_path("file:///m.weft", "/", false), "m.weft")
  Test.assert_str_eq(lsp_document_path("file:///m.weft", "", false), "/m.weft")
  Test.assert_str_eq(lsp_document_path("untitled:1", "/w", false), "")
}

test "definitions_resolve_to_file_uris" {
  Test.assert_str_eq(lsp_definition_uri("", "/w", "file:///w/a.weft"), "file:///w/a.weft")
  Test.assert_str_eq(lsp_definition_uri("/abs/b.weft", "/w", "x"), "file:///abs/b.weft")
  Test.assert_str_eq(lsp_definition_uri("lib/c.weft", "/w", "x"), "file:///w/lib/c.weft")
  Test.assert_str_eq(lsp_definition_uri("lib/c.weft", "/", "x"), "file:///lib/c.weft")
  Test.assert_str_eq(lsp_definition_uri("lib/c.weft", "", "x"), "file://lib/c.weft")
}

test "the_document_store_keeps_opening_order_across_edits_and_closes" {
  let server = lsp_server_new()
  Test.assert_str_eq(lsp_encoding_name(lsp_server_encoding(server)), "utf-16")
  Test.assert_str_eq(lsp_server_workspace(server), "")
  lsp_server_store(server, document("a", "1", 1))
  lsp_server_store(server, document("b", "2", 1))
  lsp_server_store(server, document("a", "3", 2))
  Test.assert_str_eq(open_uris(server), "a@2 b@1 ")
  match lsp_document(server, "a") {
    Some(open) -> Test.assert_str_eq(open.text, "3")
    None -> Test.assert_str_eq("a", "<closed>")
  }
  Test.assert_true(lsp_server_close(server, "a"))
  Test.assert_false(lsp_server_close(server, "a"))
  Test.assert_false(lsp_server_close(server, "zzz"))
  Test.assert_str_eq(open_uris(server), "b@1 ")
  match lsp_document(server, "a") {
    Some(open) -> Test.assert_str_eq(open.uri, "<open>")
    None -> 0
  }
  -- A reopened document is published after those already open.
  lsp_server_store(server, document("a", "4", 1))
  Test.assert_str_eq(open_uris(server), "b@1 a@1 ")
  lsp_server_set_workspace(server, "/w")
  lsp_server_set_encoding(server, SourceUtf8Units)
  Test.assert_str_eq(lsp_server_workspace(server), "/w")
  Test.assert_str_eq(lsp_encoding_name(lsp_server_encoding(server)), "utf-8")
}

test "ranges_count_the_negotiated_units" {
  let text = "aΩ😀z\nq"
  Test.assert_str_eq(
    range(text, 3, 7, SourceUtf16Units),
    "{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":4}}"
  )
  Test.assert_str_eq(
    range(text, 3, 7, SourceUtf8Units),
    "{\"start\":{\"line\":0,\"character\":3},\"end\":{\"line\":0,\"character\":7}}"
  )
  Test.assert_str_eq(
    range(text, 3, 7, SourceUtf32Units),
    "{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":3}}"
  )
  -- An empty or inverted range covers the next scalar; a negative start
  -- clamps to the beginning.
  Test.assert_str_eq(
    range(text, 3, 3, SourceUtf16Units),
    "{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":4}}"
  )
  Test.assert_str_eq(
    range(text, 0 - 5, 0 - 9, SourceUtf16Units),
    "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}"
  )
  Test.assert_str_eq(
    range(text, 9, 99, SourceUtf16Units),
    "{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":1}}"
  )
  Test.assert_str_eq(
    jsonrpc_render(lsp_full_range(text, SourceUtf16Units)),
    "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1,\"character\":1}}"
  )
  Test.assert_str_eq(
    jsonrpc_render(lsp_full_range("", SourceUtf8Units)),
    "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}"
  )
}

test "protocol_positions_become_clamped_offsets" {
  let text = "aΩ😀z\nq"
  Test.assert_eq(lsp_offset(text, LspPosition { line: 0, character: 4 }, SourceUtf16Units), 7)
  Test.assert_eq(lsp_offset(text, LspPosition { line: 0, character: 3 }, SourceUtf16Units), 3)
  Test.assert_eq(lsp_offset(text, LspPosition { line: 1, character: 9 }, SourceUtf16Units), 10)
  Test.assert_eq(lsp_offset(text, LspPosition { line: 7, character: 0 }, SourceUtf16Units), 10)
  Test.assert_eq(
    lsp_offset(text, LspPosition { line: 0 - 1, character: 0 - 1 }, SourceUtf8Units),
    0
  )
}

test "initialize_advertises_the_negotiated_encoding" {
  Test.assert_str_eq(
    lsp_initialize_result(SourceUtf8Units),
    "{\"capabilities\":{\"positionEncoding\":\"utf-8\",\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":true,\"documentFormattingProvider\":true}}"
  )
  Test.assert_true(json.json_kind(parsed(lsp_initialize_result(SourceUtf32Units))) == 5)
}

test "symbol_kinds_have_hover_labels_and_completion_kinds" {
  let kinds = [
    SemanticSymbolFunction,
    SemanticSymbolConstructor,
    SemanticSymbolLocal,
    SemanticSymbolParameter,
    SemanticSymbolPattern,
    SemanticSymbolLoopBinding,
    SemanticSymbolModule,
    SemanticSymbolType,
    SemanticSymbolEffect,
    SemanticSymbolTrait,
    SemanticSymbolField,
    SemanticSymbolTuplePosition,
    SemanticSymbolEffectOperation,
    SemanticSymbolConstant,
    SemanticSymbolKindOther("macro")
  ]
  let labels = [
    "function",
    "constructor",
    "local",
    "parameter",
    "pattern binding",
    "loop binding",
    "module",
    "type",
    "effect",
    "trait",
    "field",
    "tuple position",
    "effect operation",
    "constant",
    "macro"
  ]
  let completion = [3, 4, 6, 6, 6, 6, 9, 7, 7, 8, 5, 5, 3, 21, 7]
  let mut index: usize = 0
  for kind in kinds {
    Test.assert_str_eq(lsp_symbol_kind_label(kind), labels[index])
    Test.assert_eq(lsp_completion_kind(kind), completion[index])
    index = index + 1
  }
}
