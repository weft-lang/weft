use stdlib/assert.{*}
use stdlib/option.{*}
use stdlib/result.{*}

type PanicEqRecord {
  value: i64
}

impl Eq for PanicEqRecord {
  fn eq(self: Self, other: Self) -> bool {
    self.value == other.value
  }
}

test "ordinary_assertions_accept_successes" {
  assert(true)
  assert_msg(1 < 2, "unreachable")
  assert_eq(42, 42)
  assert_eq(true, true)
  assert_eq("weft", "weft")
  assert_eq(PanicEqRecord { value: 7 }, PanicEqRecord { value: 7 })
  Test.assert_eq(1, 1)
}

test "option_unwrap_and_expect_return_present_generic_values" {
  Test.assert_eq(Some<i64>(42).unwrap(), 42)
  Test.assert_str_eq(Some<str>("weft").expect("missing option"), "weft")
}

test "result_unwrap_and_expect_return_ok_generic_values" {
  Test.assert_eq(result_ok<i64, str>(42).unwrap(), 42)
  Test.assert_str_eq(result_ok<str, i64>("weft").expect("broken result"), "weft")
}
