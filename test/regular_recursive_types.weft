-- Regular recursion passes a declaration's own parameters, possibly permuted,
-- or closed types: every instantiation reaches finitely many others, so these
-- declarations check, lower and run.

type Links<T> { Link(T, Links<T>), Done }

type Swap<A, B> { first: A, second: B, flipped: Swap<B, A>? }

type Ground<T> { value: T, fixed: Ground<i64>? }

type Forest<T> { Tree(T, Grove<T>), Clearing }

type Grove<T> { Grove(Forest<T>, Forest<T>) }

fn links_len<T>(links: Links<T>) -> i64 {
  match links {
    Link(head, rest) -> 1 + links_len<T>(rest)
    Done -> 0
  }
}

fn forest_size<T>(forest: Forest<T>) -> i64 {
  match forest {
    Tree(value, grove) -> match grove {
      Grove(left, right) -> 1 + forest_size<T>(left) + forest_size<T>(right)
    }
    Clearing -> 0
  }
}

test "recursion at the declaration's own parameters" {
  let links = Link<str>("a", Link<str>("b", Done<str>()))
  Test.assert_eq(links_len<str>(links), 2)
}

test "recursion may permute parameters" {
  let inner = Swap<str, i64> { first: "one", second: 1, flipped: nil }
  let outer = Swap<i64, str> { first: 2, second: "two", flipped: inner }
  let back = match outer.flipped {
    nil -> 0
    swapped: Swap<str, i64> -> swapped.second
  }
  Test.assert_eq(outer.first + back, 3)
}

test "recursion may use a closed instantiation" {
  let ground = Ground<str> { value: "top", fixed: Ground<i64> { value: 5, fixed: nil } }
  let fixed = match ground.fixed {
    nil -> 0
    inner: Ground<i64> -> inner.value
  }
  Test.assert_eq(fixed, 5)
}

test "mutual regular recursion" {
  let leaf = Tree<i64>(1, Grove<i64>(Clearing<i64>(), Clearing<i64>()))
  let root = Tree<i64>(2, Grove<i64>(leaf, leaf))
  Test.assert_eq(forest_size<i64>(root), 3)
}

-- A declaration may instantiate another at a type built from its parameters
-- when that instantiation never leads back to the same parameter: Outer<T>
-- holds Inner<Links<T>>, whose recursion returns only at the closed Outer<i64>.
type Outer<T> { label: T, inner: Inner<Links<T>> }

type Inner<U> { held: U, back: Outer<i64>? }

test "growth that never returns to its parameter" {
  let closed = Outer<i64> { label: 7, inner: Inner<Links<i64>> { held: Done<i64>(), back: nil } }
  let outer = Outer<str> {
    label: "top",
    inner: Inner<Links<str>> { held: Link<str>("a", Done<str>()), back: closed }
  }
  let back_label = match outer.inner.back {
    nil -> 0
    found: Outer<i64> -> found.label
  }
  Test.assert_eq(links_len<str>(outer.inner.held) + back_label, 8)
}
