use "runtime/alloc.weft"

fn alloc_effect_pair_sum() -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  let q = alloc_effect(8, 8)
  if p == 0 { 0 }
  else { if q == 0 { 0 }
  else {
    __mem_store64(p, 20)
    __mem_store64(q, 22)
    __mem_load64(p) + __mem_load64(q)
  } }
}

fn alloc_effect_alignment_result() -[Alloc]> i64 {
  let p1 = alloc_effect(1, 1)
  let p2 = alloc_effect(8, 8)
  let p3 = alloc_effect(4, 4)
  if p1 == 0 { 0 - 1 }
  else { if p2 == 0 { 0 - 1 }
  else { if p3 == 0 { 0 - 1 }
  else {
    (p2 % 8) + (p3 % 4) + (p3 - p1)
  } } }
}

fn alloc_effect_words_delta() -[Alloc]> i64 {
  let p = alloc_effect_words(3)
  let q = alloc_effect(1, 1)
  if p == 0 { 0 }
  else { if q == 0 { 0 } else { q - p } }
}

fn alloc_effect_oversized() -[Alloc]> i64 {
  alloc_effect(40, 8)
}

fn alloc_effect_reuse_zero_program() -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  __mem_store64(p, 77)
  let freed = alloc_effect_free(p, 8)
  let q = alloc_effect_zeroed(8, 8)
  if freed != 0 { 0 - 2 }
  else { if q != p { 0 - 1 } else { __mem_load64(q) } }
}

fn alloc_effect_noop_value() -[Alloc]> i64 {
  17
}

test "runtime_alloc_effect_arena_pair" {
  let arena = arena_new(64)
  let got = handle alloc_effect_pair_sum() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_remaining(arena), 48)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_alignment_matrix" {
  let arena = arena_new(64)
  let got = handle alloc_effect_alignment_result() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 16)
  Test.assert_eq(arena_offset(arena), 20)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_zeroed_handler_memory" {
  let slot = alloc_bump(8)
  __mem_store64(slot, 99)
  let got = handle alloc_effect_zeroed(8, 8) {
    Alloc.alloc(size, align) -> resume(slot)
  }
  Test.assert_eq(got, slot)
  Test.assert_eq(__mem_load64(slot), 0)
}

test "runtime_alloc_effect_words" {
  let arena = arena_new(48)
  let got = handle alloc_effect_words_delta() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 24)
  Test.assert_eq(arena_offset(arena), 25)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_free_handler" {
  let count = alloc_bump(8)
  __mem_store64(count, 0)
  let got = handle alloc_effect_free(1234, 16) {
    Alloc.free(ptr, size) -> {
      __mem_store64(count, __mem_load64(count) + 1)
      resume(size)
    }
  }
  Test.assert_eq(got, 16)
  Test.assert_eq(__mem_load64(count), 1)
}

test "runtime_alloc_effect_overflow_returns_zero" {
  let arena = arena_new(32)
  let got = handle alloc_effect_oversized() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 0)
  Test.assert_eq(arena_remaining(arena), 32)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_with_arena_helper" {
  let arena = arena_new(64)
  let got = with_arena_alloc(arena, () => alloc_effect_pair_sum())
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_remaining(arena), 48)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_with_scoped_arena_helper_batch_frees" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => alloc_effect_pair_sum())
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_remaining(arena), 64)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_scoped_arena_restores_outer_mark" {
  let arena = arena_new(64)
  let outer = arena_alloc(arena, 8, 8)
  __mem_store64(outer, 99)
  let got = with_scoped_arena_alloc(arena, () => alloc_effect_pair_sum())
  let again = arena_alloc(arena, 8, 8)
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 16)
  Test.assert_eq(__mem_load64(outer), 99)
  Test.assert_eq(again, outer + 8)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_scoped_region_pointer_store_local" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let slot = Alloc.alloc(8, 8)
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 66)
    __mem_store64(slot, p)
    __mem_load64(__mem_load64(slot))
  })
  Test.assert_eq(got, 66)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_scoped_region_sized_pointer_store_local" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let slot = Alloc.alloc(8, 8)
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 67)
    __mem_store_sized(slot, 8, 0, p)
    __mem_load64(__mem_load64(slot))
  })
  Test.assert_eq(got, 67)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_scoped_arena_null_still_runs_body" {
  Test.assert_eq(with_scoped_arena_alloc(0, () => alloc_effect_noop_value()), 17)
}

test "runtime_alloc_effect_with_heap_helper" {
  let heap = heap_new(64)
  let got = with_heap_alloc(heap, () => alloc_effect_reuse_zero_program())
  Test.assert_eq(got, 0)
  Test.assert_eq(heap_free_head(heap), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}
