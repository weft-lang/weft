use "runtime/alloc.weft"

fn alloc_effect_pair_sum() -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  let q = alloc_effect(8, 8)
  if p == 0 { 0 }
  else { if q == 0 { 0 }
  else {
    __mem_store64(p, 20)
    __mem_store64(q, 22)
    __mem_load64(p) + __mem_load64(q)
  } }
}

fn alloc_effect_alignment_result() -[Alloc]> i64 {
  let p1 = alloc_effect(1, 1)
  let p2 = alloc_effect(8, 8)
  let p3 = alloc_effect(4, 4)
  if p1 == 0 { 0 - 1 }
  else { if p2 == 0 { 0 - 1 }
  else { if p3 == 0 { 0 - 1 }
  else {
    (p2 % 8) + (p3 % 4) + (p3 - p1)
  } } }
}

fn alloc_effect_words_delta() -[Alloc]> i64 {
  let p = alloc_effect_words(3)
  let q = alloc_effect(1, 1)
  if p == 0 { 0 }
  else { if q == 0 { 0 } else { q - p } }
}

fn alloc_effect_oversized() -[Alloc]> i64 {
  alloc_effect(40, 8)
}

test "runtime_alloc_effect_arena_pair" {
  let arena = arena_new(64)
  let got = handle alloc_effect_pair_sum() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_remaining(arena), 48)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_alignment_matrix" {
  let arena = arena_new(64)
  let got = handle alloc_effect_alignment_result() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 16)
  Test.assert_eq(arena_offset(arena), 20)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_zeroed_handler_memory" {
  let slot = alloc_bump(8)
  __mem_store64(slot, 99)
  let got = handle alloc_effect_zeroed(8, 8) {
    Alloc.alloc(size, align) -> resume(slot)
  }
  Test.assert_eq(got, slot)
  Test.assert_eq(__mem_load64(slot), 0)
}

test "runtime_alloc_effect_words" {
  let arena = arena_new(48)
  let got = handle alloc_effect_words_delta() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 24)
  Test.assert_eq(arena_offset(arena), 25)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_alloc_effect_free_handler" {
  let count = alloc_bump(8)
  __mem_store64(count, 0)
  let got = handle alloc_effect_free(1234, 16) {
    Alloc.free(ptr, size) -> {
      __mem_store64(count, __mem_load64(count) + 1)
      resume(size)
    }
  }
  Test.assert_eq(got, 16)
  Test.assert_eq(__mem_load64(count), 1)
}

test "runtime_alloc_effect_overflow_returns_zero" {
  let arena = arena_new(32)
  let got = handle alloc_effect_oversized() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
  }
  Test.assert_eq(got, 0)
  Test.assert_eq(arena_remaining(arena), 32)
  Test.assert_eq(arena_free(arena), 0)
}
