use stdlib/test.{*}
use stdlib/unicode.{*}

test "unicode_mixed_script_detection_uses_resolved_script_sets" {
  Test.assert_eq(unicode_identifier_is_mixed_script("Circle"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("СігсӀе"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("Сirсlе"), 1)
}

test "unicode_mixed_script_detection_treats_common_as_all" {
  Test.assert_eq(unicode_identifier_is_mixed_script("Circ1e"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("weft_17"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script(""), 0)
}

test "unicode_mixed_script_detection_augments_cjk_writing_systems" {
  Test.assert_eq(unicode_identifier_is_mixed_script("ねガ"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("〆切"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("漢한"), 0)
  Test.assert_eq(unicode_identifier_is_mixed_script("A한"), 1)
}

test "unicode_confusable_skeleton_matches_uts39_examples" {
  Test.assert_eq(unicode_identifiers_are_confusable("paypal", "pаypаl"), 1)
  Test.assert_eq(unicode_identifiers_are_confusable("scope", "ѕсоре"), 1)
  Test.assert_eq(unicode_identifiers_are_confusable("weft", "warp"), 0)
}

test "unicode_confusable_skeleton_is_canonically_decomposed" {
  Test.assert_str_eq(unicode_identifier_skeleton("Å"), unicode_identifier_skeleton("Å"))
  Test.assert_eq(unicode_identifiers_are_confusable("Å", "Å"), 1)
}

test "unicode_confusable_skeleton_removes_default_ignorables" {
  Test.assert_str_eq(unicode_identifier_skeleton("ab‍cd"), unicode_identifier_skeleton("abcd"))
}

test "unicode_confusable_skeleton_handles_supplementary_prototypes" {
  Test.assert_eq(unicode_identifiers_are_confusable("𝐀", "A"), 1)
}

test "unicode_confusable_skeleton_transform_is_idempotent" {
  let skeleton = unicode_identifier_skeleton("pаypаl")
  Test.assert_str_eq(unicode_identifier_skeleton(skeleton), skeleton)
}
