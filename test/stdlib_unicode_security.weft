use stdlib/test.{*}
use stdlib/unicode.{*}

test "unicode_mixed_script_detection_uses_resolved_script_sets" {
  Test.assert_false(unicode_identifier_is_mixed_script("Circle"))
  Test.assert_false(unicode_identifier_is_mixed_script("СігсӀе"))
  Test.assert_true(unicode_identifier_is_mixed_script("Сirсlе"))
}

test "unicode_mixed_script_detection_treats_common_as_all" {
  Test.assert_false(unicode_identifier_is_mixed_script("Circ1e"))
  Test.assert_false(unicode_identifier_is_mixed_script("weft_17"))
  Test.assert_false(unicode_identifier_is_mixed_script(""))
}

test "unicode_mixed_script_detection_augments_cjk_writing_systems" {
  Test.assert_false(unicode_identifier_is_mixed_script("ねガ"))
  Test.assert_false(unicode_identifier_is_mixed_script("〆切"))
  Test.assert_false(unicode_identifier_is_mixed_script("漢한"))
  Test.assert_true(unicode_identifier_is_mixed_script("A한"))
}

test "unicode_confusable_skeleton_matches_uts39_examples" {
  Test.assert_true(unicode_identifiers_are_confusable("paypal", "pаypаl"))
  Test.assert_true(unicode_identifiers_are_confusable("scope", "ѕсоре"))
  Test.assert_false(unicode_identifiers_are_confusable("weft", "warp"))
}

test "unicode_confusable_skeleton_is_canonically_decomposed" {
  Test.assert_str_eq(unicode_identifier_skeleton("Å"), unicode_identifier_skeleton("Å"))
  Test.assert_true(unicode_identifiers_are_confusable("Å", "Å"))
}

test "unicode_confusable_skeleton_removes_default_ignorables" {
  Test.assert_str_eq(unicode_identifier_skeleton("ab‍cd"), unicode_identifier_skeleton("abcd"))
}

test "unicode_confusable_skeleton_handles_supplementary_prototypes" {
  Test.assert_true(unicode_identifiers_are_confusable("𝐀", "A"))
}

test "unicode_confusable_skeleton_transform_is_idempotent" {
  let skeleton = unicode_identifier_skeleton("pаypаl")
  Test.assert_str_eq(unicode_identifier_skeleton(skeleton), skeleton)
}
