type StructuralShapePerson {
  lead: (i64, i64),
  name: str,
  answer: i64,
}

type StructuralShapeCompact {
  answer: i64,
}

type StructuralShapeReordered {
  answer: i64,
  name: str,
}

fn structural_shape_answer(value: {answer: i64, ..}) -> i64 {
  value.answer
}

fn structural_shape_name_len(value: {name: str, ..}) -> i64 {
  __str_len(value.name)
}

fn structural_shape_nested(value: {answer: i64, ..}) -> i64 {
  structural_shape_answer(value)
}

fn structural_shape_cfg(value: {answer: i64, ..}, take: bool) -> i64 {
  if take { value.answer } else { 0 }
}

fn structural_shape_closure(value: {answer: i64, ..}) -> i64 {
  let read = () => value.answer
  read()
}

fn structural_shape_closed(value: {answer: i64}) -> i64 {
  value.answer
}

fn structural_shape_generic<T>(value: {answer: T, ..}, fallback: T) -> T {
  value.answer
}

test "nominal records project to open structural parameters" {
  let value = StructuralShapePerson { lead: (1, 2), name: "weft", answer: 42 }
  Test.assert_eq(structural_shape_answer(value), 42)
  Test.assert_eq(structural_shape_name_len(value), 4)
}

test "nominal projection offsets include widened inline fields" {
  let value = StructuralShapePerson { lead: (20, 22), name: "weft", answer: 38 }
  Test.assert_eq(structural_shape_answer(value) + structural_shape_name_len(value), 42)
}

test "one structural helper composes through another" {
  let value = StructuralShapePerson { lead: (0, 0), name: "nested", answer: 42 }
  Test.assert_eq(structural_shape_nested(value), 42)
}

test "shape specialisations preserve CFG and closure transport" {
  let value = StructuralShapePerson { lead: (0, 0), name: "cfg", answer: 21 }
  Test.assert_eq(structural_shape_cfg(value, true) + structural_shape_closure(value), 42)
}

test "the same helper specialises independently for distinct nominal layouts" {
  let compact = StructuralShapeCompact { answer: 20 }
  let reordered = StructuralShapeReordered { answer: 22, name: "weft" }
  Test.assert_eq(structural_shape_answer(compact) + structural_shape_answer(reordered), 42)
}

test "closed anonymous values refine open structural parameters" {
  Test.assert_eq(structural_shape_answer({label: "weft", answer: 42}), 42)
}

test "nominal records with an exact domain adapt to closed structural parameters" {
  let value = StructuralShapeCompact { answer: 42 }
  Test.assert_eq(structural_shape_closed(value), 42)
}

test "generic inference consumes the nominal structural projection" {
  let value = StructuralShapePerson { lead: (0, 0), name: "generic", answer: 42 }
  Test.assert_eq(structural_shape_generic(value, 0), 42)
  Test.assert_eq(structural_shape_generic<i64>(value, 0), 42)
}

test "closed structural functions retain a concrete function-value ABI" {
  let read = structural_shape_closed
  Test.assert_eq(read({answer: 42}), 42)
}
