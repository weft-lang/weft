use runtime/alloc.{alloc_bump_mark}
use stdlib/option.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

type StaticLiteralPayload { StaticLiteralPayload(i64) }

fn static_literal_payload_value(value: StaticLiteralPayload) -> i64 {
  match value { StaticLiteralPayload(payload) -> payload }
}

fn static_literal_ignore(message: str) -> i64 { 7 }

fn static_literal_argument_round(count: i64) -> i64 {
  let mut total = 0
  let mut index = 0
  while index < count {
    total = total + static_literal_ignore("fixture contains one value")
    index = index + 1
  }
  total
}

fn static_literal_checked_lookup_round(values: borrow Vector<StaticLiteralPayload>, count: i64) -> i64 {
  let mut total = 0
  let mut index = 0
  while index < count {
    total = total + static_literal_payload_value(values.get(0).expect("fixture contains one value"))
    index = index + 1
  }
  total
}

test "literal message arguments retain no bump storage" {
  static_literal_argument_round(100)
  let before = alloc_bump_mark()
  Test.assert_eq(static_literal_argument_round(1000), 7000)
  let after = alloc_bump_mark()
  Test.assert_eq(after - before, 0)
}

test "Option expect with a literal message reclaims its managed payload" {
  let mut owner = vector.new<StaticLiteralPayload>()
  owner.push(StaticLiteralPayload(7))
  let values: Vector<StaticLiteralPayload> = owner
  static_literal_checked_lookup_round(values, 100)
  let before = alloc_bump_mark()
  Test.assert_eq(static_literal_checked_lookup_round(values, 1000), 7000)
  let after = alloc_bump_mark()
  Test.assert_eq(after - before, 0)
}
