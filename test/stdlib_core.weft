use stdlib/list as list
use stdlib/list.{*}
use stdlib/map.{*}
use stdlib/hash.{*}
use stdlib/string.{*}
use stdlib/result.{*}
use stdlib/option.{*}
use stdlib/io.{*}
use stdlib/state.{*}

fn sum_i64(acc: i64, x: i64) -> i64 { acc + x }
fn count_i64(acc: i64, x: i64) -> i64 { acc + 1 }
fn add_one(x: i64) -> i64 { x + 1 }
fn optional_add_one(x: i64) -> Option<i64> {
  if x >= 0 { Some<i64>(x + 1) } else { None<i64>() }
}
fn optional_fallback() -> Option<i64> { Some<i64>(42) }
fn result_add_one(x: i64) -> Result<i64, i64> { Ok<i64, i64>(x + 1) }
fn result_reject(x: i64) -> Result<i64, i64> { Err<i64, i64>(x) }
fn result_recover(error: i64) -> Result<i64, str> { Ok<i64, str>(error + 40) }
fn result_error_text(error: i64) -> str { int_to_str(error) }
fn double_i64(x: i64) -> i64 { x * 2 }
fn generic_hash<T: Hash>(value: T) -> i64 { value.hash() }
fn keep_even(x: i64) -> bool { x % 2 == 0 }
fn option_has_value(opt: Option<i64>) -> i64 {
  match opt {
    Some(v) -> 1
    None -> 0
  }
}
fn option_value_or(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(v) -> v
    None -> default
  }
}
fn option_none_has_value() -> i64 {
  let none = None<i64>()
  option_has_value(none)
}
fn option_none_value_or(default: i64) -> i64 {
  let none = None<i64>()
  option_value_or(none, default)
}
fn result_is_ok_value(res: Result<i64, i64>) -> i64 {
  match res {
    Ok(v) -> 1
    Err(e) -> 0
  }
}
fn result_value_or(res: Result<i64, i64>, default: i64) -> i64 {
  match res {
    Ok(v) -> v
    Err(e) -> default
  }
}

fn io_core_program() -[IO]> i64 {
  let w = IO.write(1, 100, 4)
  let r = IO.read(0, 200, 2)
  let o = IO.open_write("path")
  let c = IO.close(9)
  w + r + o + c
}

fn state_core_program() -[State<i64>]> i64 {
  state_put<i64>(10)
  let next = state_modify<i64>(add_one)
  let final = state_get<i64>()
  next + final
}

test "stdlib_list_methods" {
  let empty = list.range(0, 0)
  let xs = Cons<i64>(10, Cons<i64>(20, empty))
  let tail = xs.rest().unwrap()
  Test.assert_eq(xs.fold<i64>(0, count_i64), 2)
  Test.assert_eq(xs.first().unwrap_or(0 - 1), 10)
  Test.assert_eq(tail.first().unwrap_or(0 - 1), 20)
  Test.assert_eq(empty.fold<i64>(0, count_i64), 0)
  Test.assert_eq(empty.first().unwrap_or(0 - 1), 0 - 1)
  Test.assert_true(empty.is_empty())
  Test.assert_true(empty.rest().is_none())
}

test "stdlib_list_transforms" {
  let xs = list.range(1, 5)
  let doubled = xs.map<i64>(double_i64)
  let evens = list.range(0, 6).filter(keep_even)
  let reversed = xs.reverse()
  Test.assert_eq(xs.fold<i64>(0, sum_i64), 10)
  Test.assert_eq(doubled.fold<i64>(0, sum_i64), 20)
  Test.assert_eq(evens.fold<i64>(0, count_i64), 3)
  Test.assert_eq(evens.fold<i64>(0, sum_i64), 6)
  Test.assert_eq(reversed.first().unwrap_or(0 - 1), 4)
}

test "stdlib_list_index_concat_append" {
  let empty = Nil<i64>()
  let xs = list.range(10, 13)
  Test.assert_eq(empty.len(), 0)
  Test.assert_eq(xs.len(), 3)
  Test.assert_eq(xs.get(0).unwrap_or(0 - 1), 10)
  Test.assert_eq(xs.get(1).unwrap_or(0 - 1), 11)
  Test.assert_eq(xs.get(2).unwrap_or(0 - 1), 12)
  Test.assert_true(xs.get(0 - 1).is_none())
  Test.assert_true(xs.get(3).is_none())

  let suffix = Cons<i64>(13, Cons<i64>(14, empty))
  let joined = xs.concat(suffix)
  Test.assert_eq(joined.len(), 5)
  Test.assert_eq(joined.get(0).unwrap_or(0 - 1), 10)
  Test.assert_eq(joined.get(3).unwrap_or(0 - 1), 13)
  Test.assert_eq(joined.get(4).unwrap_or(0 - 1), 14)
  Test.assert_eq(empty.concat(xs).len(), 3)
  Test.assert_eq(xs.concat(empty).len(), 3)

  let appended = xs.append(13)
  Test.assert_eq(appended.len(), 4)
  Test.assert_eq(appended.get(2).unwrap_or(0 - 1), 12)
  Test.assert_eq(appended.get(3).unwrap_or(0 - 1), 13)
}

test "stdlib_map_persistent_put_get" {
  let empty = map_new<i64, i64>()
  let one = empty.insert(7, 20)
  let two = one.insert(9, 22)
  let updated = two.insert(7, 30)
  Test.assert_eq(empty.len(), 0)
  Test.assert_eq(option_has_value(empty.get(7)), 0)
  Test.assert_eq(option_value_or(two.get(7), 0 - 1) + option_value_or(two.get(9), 0 - 1), 42)
  Test.assert_eq(option_value_or(updated.get(7), 0 - 1), 30)
  Test.assert_eq(option_value_or(two.get(7), 0 - 1), 20)
  Test.assert_eq(two.len(), 2)
  Test.assert_true(two.contains_key(9))
}

test "stdlib_map_fold_keys_values" {
  let m = map_new<i64, i64>().insert(10, 15).insert(20, 27)
  let keys = m.keys()
  let vals = m.values()
  Test.assert_eq(m.fold<i64>(0, (acc: i64, key: i64, val: i64) => acc + val), 42)
  Test.assert_eq(keys.fold<i64>(0, count_i64), 2)
  Test.assert_eq(vals.fold<i64>(0, count_i64), 2)
}

test "stdlib_option_helpers" {
  let some = Some<i64>(10)
  let mapped = some.map<i64>(add_one)
  let mapped_none = None<i64>().map<i64>(add_one)
  Test.assert_eq(option_has_value(some), 1)
  Test.assert_eq(option_none_has_value(), 0)
  Test.assert_eq(option_value_or(some, 0), 10)
  Test.assert_eq(option_none_value_or(42), 42)
  Test.assert_eq(option_value_or(mapped, 0), 11)
  Test.assert_true(mapped_none.is_none())
  Test.assert_eq(some.and_then<i64>(optional_add_one).unwrap_or(0), 11)
  Test.assert_true(None<i64>().and_then<i64>(optional_add_one).is_none())
  Test.assert_eq(some.or_else(optional_fallback).unwrap_or(0), 10)
  Test.assert_eq(None<i64>().or_else(optional_fallback).unwrap_or(0), 42)
}

test "stdlib_result_helpers" {
  let ok = Ok<i64, i64>(10)
  let err = Err<i64, i64>(7)
  let mapped = ok.map<i64>(add_one)
  let mapped_err = err.map<i64>(add_one)
  Test.assert_eq(result_is_ok_value(ok), 1)
  Test.assert_eq(result_is_ok_value(err), 0)
  Test.assert_eq(result_value_or(ok, 0), 10)
  Test.assert_eq(result_value_or(err, 42), 42)
  Test.assert_eq(result_value_or(mapped, 0), 11)
  Test.assert_eq(result_value_or(mapped_err, 42), 42)
  Test.assert_eq(ok.and_then<i64>(result_add_one).unwrap_or(0), 11)
  Test.assert_true(err.and_then<i64>(result_add_one).is_err())
  Test.assert_true(ok.and_then<i64>(result_reject).is_err())
  Test.assert_eq(err.or_else<str>(result_recover).unwrap_or(0), 47)
  Test.assert_eq(ok.or_else<str>(result_recover).unwrap_or(0), 10)
  match err.map_err<str>(result_error_text) {
    Err(text) -> Test.assert_str_eq(text, "7")
    Ok(value) -> Test.assert_true(false)
  }
  match ok.map_err<str>(result_error_text) {
    Ok(value) -> Test.assert_eq(value, 10)
    Err(text) -> Test.assert_true(false)
  }
}

test "stdlib_string_core" {
  let joined = str_concat("we", "ft")
  let empty_left = str_concat("", "x")
  Test.assert_eq(str_len(joined), 4)
  Test.assert_eq(str_byte_at(joined, 0), 119)
  Test.assert_eq(str_byte_at(joined, 3), 116)
  Test.assert_eq(str_byte_at(joined, 4), 0)
  Test.assert_eq(str_eq(joined, "weft"), 1)
  Test.assert_eq(str_eq(joined, "weft!"), 0)
  Test.assert_eq(joined.hash(), "weft".hash())
  Test.assert_ne(joined.hash(), "left".hash())
  Test.assert_eq(str_eq(empty_left, "x"), 1)
  Test.assert_eq(str_eq(int_to_str(0), "0"), 1)
  Test.assert_eq(str_eq(int_to_str(0 - 42), "-42"), 1)
}

test "stdlib_hash_generic_self_dispatch" {
  Test.assert_eq(generic_hash<i64>(42), 42.hash())
  Test.assert_eq(generic_hash<str>("λ-weft"), "λ-weft".hash())
}

test "stdlib_io_mock_handler" {
  let got = handle io_core_program() {
    IO.write(fd, buf, len) -> resume(fd + len)
    IO.read(fd, buf, len) -> resume(buf + len)
    IO.open_write(path) -> resume(31)
    IO.close(fd) -> resume(fd * 2)
  }
  Test.assert_eq(got, 256)
}

test "stdlib_state_handler" {
  let got = handle state_core_program() {
    State.get() -> resume(10)
    State.put(v) -> {
      resume(nil)
    }
  }
  Test.assert_eq(got, 21)
}
