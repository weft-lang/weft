use "stdlib/list.weft"
use "stdlib/map.weft"
use "stdlib/hash.weft"
use "stdlib/string.weft"
use "stdlib/result.weft"
use "stdlib/option.weft"
use "stdlib/io.weft"
use "stdlib/state.weft"

fn sum_i64(acc: i64, x: i64) -> i64 { acc + x }
fn count_i64(acc: i64, x: i64) -> i64 { acc + 1 }
fn add_one(x: i64) -> i64 { x + 1 }
fn double_i64(x: i64) -> i64 { x * 2 }
fn keep_even(x: i64) -> i64 {
  if x % 2 == 0 { 1 } else { 0 }
}
fn list_head_or(xs: List<i64>, default: i64) -> i64 {
  list_first_or<i64>(xs, default)
}
fn list_tail_or_nil(xs: List<i64>) -> List<i64> {
  list_rest_or_nil<i64>(xs)
}
fn option_has_value(opt: Option<i64>) -> i64 {
  match opt {
    Some(v) -> 1
    None -> 0
  }
}
fn option_value_or(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(v) -> v
    None -> default
  }
}
fn option_none_has_value() -> i64 {
  let none = option_none<i64>()
  option_has_value(none)
}
fn option_none_value_or(default: i64) -> i64 {
  let none = option_none<i64>()
  option_value_or(none, default)
}
fn result_is_ok_value(res: Result<i64, i64>) -> i64 {
  match res {
    Ok(v) -> 1
    Err(e) -> 0
  }
}
fn result_value_or(res: Result<i64, i64>, default: i64) -> i64 {
  match res {
    Ok(v) -> v
    Err(e) -> default
  }
}

fn io_core_program() -[IO]> i64 {
  let w = IO.write(1, 100, 4)
  let r = IO.read(0, 200, 2)
  let o = IO.open("path", 1, 0)
  let c = IO.close(9)
  w + r + o + c
}

fn state_core_program() -[State]> i64 {
  state_put(10)
  let next = state_modify(add_one)
  let final = state_get()
  next + final
}

test "stdlib_list_methods" {
  let empty = list_range(0, 0)
  let xs = list_cons<i64>(10, list_cons<i64>(20, empty))
  let tail = list_tail_or_nil(xs)
  Test.assert_eq(list_fold<i64, i64>(xs, 0, count_i64), 2)
  Test.assert_eq(list_head_or(xs, 0 - 1), 10)
  Test.assert_eq(list_head_or(tail, 0 - 1), 20)
  Test.assert_eq(list_fold<i64, i64>(empty, 0, count_i64), 0)
  Test.assert_eq(list_head_or(empty, 0 - 1), 0 - 1)
}

test "stdlib_list_transforms" {
  let xs = list_range(1, 5)
  let doubled = list_map<i64, i64>(xs, double_i64)
  let evens = list_filter<i64>(list_range(0, 6), keep_even)
  let reversed = list_reverse<i64>(xs)
  Test.assert_eq(list_fold<i64, i64>(xs, 0, sum_i64), 10)
  Test.assert_eq(list_fold<i64, i64>(doubled, 0, sum_i64), 20)
  Test.assert_eq(list_fold<i64, i64>(evens, 0, count_i64), 3)
  Test.assert_eq(list_fold<i64, i64>(evens, 0, sum_i64), 6)
  Test.assert_eq(list_head_or(reversed, 0 - 1), 4)
}

test "stdlib_map_persistent_put_get" {
  let empty = map_new()
  let one = map_put(empty, 7, 20)
  let two = map_put(one, 9, 22)
  let updated = map_put(two, 7, 30)
  Test.assert_eq(map_size(empty), 0)
  Test.assert_eq(map_get(empty, 7, 0 - 1), 0 - 1)
  Test.assert_eq(map_get(two, 7, 0 - 1) + map_get(two, 9, 0 - 1), 42)
  Test.assert_eq(map_get(updated, 7, 0 - 1), 30)
  Test.assert_eq(map_get(two, 7, 0 - 1), 20)
  Test.assert_eq(map_size(two), 2)
  Test.assert_eq(map_contains(two, 9), 1)
}

test "stdlib_map_fold_keys_values" {
  let m = map_put(map_put(map_new(), 10, 15), 20, 27)
  let keys = map_keys(m)
  let vals = map_values(m)
  Test.assert_eq(map_fold<i64>(m, 0, (acc: i64, key: i64, val: i64) => acc + val), 42)
  Test.assert_eq(list_fold<i64, i64>(keys, 0, count_i64), 2)
  Test.assert_eq(list_fold<i64, i64>(vals, 0, count_i64), 2)
}

test "stdlib_option_helpers" {
  let some = option_some<i64>(10)
  let mapped = option_map<i64, i64>(some, add_one)
  Test.assert_eq(option_has_value(some), 1)
  Test.assert_eq(option_none_has_value(), 0)
  Test.assert_eq(option_value_or(some, 0), 10)
  Test.assert_eq(option_none_value_or(42), 42)
  Test.assert_eq(option_value_or(mapped, 0), 11)
}

test "stdlib_result_helpers" {
  let ok = result_ok<i64, i64>(10)
  let err = result_err<i64, i64>(7)
  let mapped = result_map<i64, i64, i64>(ok, add_one)
  let mapped_err = result_map<i64, i64, i64>(err, add_one)
  Test.assert_eq(result_is_ok_value(ok), 1)
  Test.assert_eq(result_is_ok_value(err), 0)
  Test.assert_eq(result_value_or(ok, 0), 10)
  Test.assert_eq(result_value_or(err, 42), 42)
  Test.assert_eq(result_value_or(mapped, 0), 11)
  Test.assert_eq(result_value_or(mapped_err, 42), 42)
}

test "stdlib_string_core" {
  let joined = str_concat("we", "ft")
  let empty_left = str_concat("", "x")
  Test.assert_eq(str_len(joined), 4)
  Test.assert_eq(str_byte_at(joined, 0), 119)
  Test.assert_eq(str_byte_at(joined, 3), 116)
  Test.assert_eq(str_byte_at(joined, 4), 0)
  Test.assert_eq(str_eq(joined, "weft"), 1)
  Test.assert_eq(str_eq(joined, "weft!"), 0)
  Test.assert_eq(joined.hash(), "weft".hash())
  Test.assert_ne(joined.hash(), "left".hash())
  Test.assert_eq(str_eq(empty_left, "x"), 1)
  Test.assert_eq(str_eq(int_to_str(0), "0"), 1)
  Test.assert_eq(str_eq(int_to_str(0 - 42), "-42"), 1)
}

test "stdlib_io_mock_handler" {
  let got = handle io_core_program() {
    IO.write(fd, buf, len) -> resume(fd + len)
    IO.read(fd, buf, len) -> resume(buf + len)
    IO.open(path, flags, mode) -> resume(flags + 30)
    IO.close(fd) -> resume(fd * 2)
  }
  Test.assert_eq(got, 256)
}

test "stdlib_state_handler" {
  let got = handle state_core_program() {
    State.get() -> resume(10)
    State.put(v) -> {
      resume(0)
    }
  }
  Test.assert_eq(got, 21)
}
