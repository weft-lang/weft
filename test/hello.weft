-- A simple test module for the seed parser

type Bool {
  True,
  False
}

trait Eq {
  fn eq(a: Int, b: Int) -> Bool
}

effect Console {
  fn print(msg: String) -> Nil
}

fn add(x: Int, y: Int) -> Int {
  x + y
}

fn main() {
  let result = add(1, 2)
  if result == 3 {
    true
  } else {
    false
  }
}
