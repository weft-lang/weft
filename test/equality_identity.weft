use stdlib/eq.{Eq}

trait AlternateRelation { fn eq(self, other: Self) -> bool }

type EqualityFirst { value: i64 }

type EqualityLast { value: i64 }

impl Eq for EqualityFirst {
  fn eq(self, other: Self) -> bool { self.value % 10 == other.value % 10 }
}

impl AlternateRelation for EqualityFirst {
  fn eq(self, other: Self) -> bool { false }
}

impl EqualityFirst {
  pub fn eq(self, other: Self) -> bool { false }
}

impl EqualityLast {
  pub fn eq(self, other: Self) -> bool { false }
}

impl AlternateRelation for EqualityLast {
  fn eq(self, other: Self) -> bool { false }
}

impl Eq for EqualityLast {
  fn eq(self, other: Self) -> bool { self.value % 10 == other.value % 10 }
}

fn canonical_relation<T: AlternateRelation & Eq>(left: T, right: T) -> bool { left == right }

fn reversed_bounds<T: Eq & AlternateRelation>(left: T, right: T) -> bool { left == right }

fn alternate_relation<T: AlternateRelation>(left: T, right: T) -> bool { left.eq(right) }

test "equality selection is independent of implementation declaration order" {
  let first = EqualityFirst { value: 1 }
  let first_equal = EqualityFirst { value: 11 }
  let last = EqualityLast { value: 1 }
  let last_equal = EqualityLast { value: 11 }
  Test.assert_true(first == first_equal)
  Test.assert_true(last == last_equal)
  Test.assert_true(first != EqualityFirst { value: 2 })
  Test.assert_true(last != EqualityLast { value: 2 })
}

test "generic dispatch retains the trait that owns the selected operation" {
  let first = EqualityFirst { value: 1 }
  let last = EqualityLast { value: 1 }
  Test.assert_true(canonical_relation(first, first))
  Test.assert_true(reversed_bounds(first, first))
  Test.assert_true(canonical_relation(last, last))
  Test.assert_true(reversed_bounds(last, last))
  Test.assert_true(not alternate_relation(first, first))
  Test.assert_true(not alternate_relation(last, last))
}
