-- Test: string equality and inequality comprehensive
-- Expected exit code: 3

fn main() -> Int {
  let same = if "hello" == "hello" { 1 } else { 0 }
  let diff = if "hello" == "world" { 1 } else { 0 }
  let diff_len = if "hi" == "hello" { 1 } else { 0 }
  let empty = if "" == "" { 1 } else { 0 }
  let ne_diff = if "abc" != "def" { 1 } else { 0 }
  let ne_same = if "abc" != "abc" { 1 } else { 0 }
  -- same=1, diff=0, diff_len=0, empty=1, ne_diff=1, ne_same=0
  same + diff + diff_len + empty + ne_diff + ne_same
}
