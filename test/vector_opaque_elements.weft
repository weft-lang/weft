-- Indexed storage of opaque wrappers. An opaque constructor is a nominal
-- wrapper over its representation, so a `Vector` of opaque records, tuples
-- or scalars must store and load exactly what a `Vector` of the bare type
-- would; every field must survive push, get and set in every lane.

use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len, vector_push, vector_set}

type Triple { a: i64, b: i64, c: i64 }

type Sealed = opaque Triple

type SealedTuple = opaque(i64, i64, i64)

type Tag = opaque i64

type Pair { left: i64, right: str }

type SealedPair = opaque Pair

fn sealed(a: i64, b: i64, c: i64) -> Sealed { Sealed(Triple { a: a, b: b, c: c }) }

fn sealed_sum(value: Sealed) -> i64 {
  match value { Sealed(triple) -> triple.a * 100 + triple.b * 10 + triple.c }
}

fn tuple_sum(value: SealedTuple) -> i64 {
  match value { SealedTuple((x, y, z)) -> x * 100 + y * 10 + z }
}

test "vectors of opaque records keep every field in every lane" {
  let items = vector.new<Sealed>()
  for index in 0..8 {
    vector_push<Sealed>(items, sealed(index, index + 1, index + 2))
  }
  Test.assert_eq(vector_len<Sealed>(items), 8)
  for index in 0..8 {
    Test.assert_eq(
      sealed_sum(vector_get_in_bounds<Sealed>(items, index)),
      index * 100 + (index + 1) * 10 + index + 2
    )
  }
}

test "vectors of opaque records overwrite one lane without touching its neighbours" {
  let items = vector.new<Sealed>()
  vector_push<Sealed>(items, sealed(1, 2, 3))
  vector_push<Sealed>(items, sealed(4, 5, 6))
  vector_push<Sealed>(items, sealed(7, 8, 9))
  vector_set<Sealed>(items, 1, sealed(40, 50, 60))
  Test.assert_eq(sealed_sum(vector_get_in_bounds<Sealed>(items, 0)), 123)
  Test.assert_eq(sealed_sum(vector_get_in_bounds<Sealed>(items, 1)), 4560)
  Test.assert_eq(sealed_sum(vector_get_in_bounds<Sealed>(items, 2)), 789)
}

test "vectors of opaque tuples keep every component" {
  let items = vector.new<SealedTuple>()
  vector_push<SealedTuple>(items, SealedTuple((1, 2, 3)))
  vector_push<SealedTuple>(items, SealedTuple((4, 5, 6)))
  Test.assert_eq(tuple_sum(vector_get_in_bounds<SealedTuple>(items, 0)), 123)
  Test.assert_eq(tuple_sum(vector_get_in_bounds<SealedTuple>(items, 1)), 456)
  vector_set<SealedTuple>(items, 0, SealedTuple((7, 8, 9)))
  Test.assert_eq(tuple_sum(vector_get_in_bounds<SealedTuple>(items, 0)), 789)
  Test.assert_eq(tuple_sum(vector_get_in_bounds<SealedTuple>(items, 1)), 456)
}

test "vectors of opaque scalars behave like vectors of the scalar" {
  let items = vector.new<Tag>()
  vector_push<Tag>(items, Tag(11))
  vector_push<Tag>(items, Tag(22))
  vector_set<Tag>(items, 0, Tag(33))
  Test.assert_eq(match vector_get_in_bounds<Tag>(items, 0) { Tag(value) -> value }, 33)
  Test.assert_eq(match vector_get_in_bounds<Tag>(items, 1) { Tag(value) -> value }, 22)
}

test "vectors of opaque records with managed fields keep both fields" {
  let items = vector.new<SealedPair>()
  vector_push<SealedPair>(items, SealedPair(Pair { left: 1, right: "one" }))
  vector_push<SealedPair>(items, SealedPair(Pair { left: 2, right: "two" }))
  match vector_get_in_bounds<SealedPair>(items, 1) {
    SealedPair(pair) -> {
      Test.assert_eq(pair.left, 2)
      Test.assert_str_eq(pair.right, "two")
    }
  }
  match vector_get_in_bounds<SealedPair>(items, 0) {
    SealedPair(pair) -> {
      Test.assert_eq(pair.left, 1)
      Test.assert_str_eq(pair.right, "one")
    }
  }
}

test "the bare record and its opaque wrapper agree lane for lane" {
  let bare = vector.new<Triple>()
  let wrapped = vector.new<Sealed>()
  for index in 0..5 {
    vector_push<Triple>(bare, Triple { a: index, b: index * 2, c: index * 3 })
    vector_push<Sealed>(wrapped, sealed(index, index * 2, index * 3))
  }
  for index in 0..5 {
    let plain = vector_get_in_bounds<Triple>(bare, index)
    Test.assert_eq(
      sealed_sum(vector_get_in_bounds<Sealed>(wrapped, index)),
      plain.a * 100 + plain.b * 10 + plain.c
    )
  }
}

test "arrays of opaque records index and iterate like arrays of the record" {
  let items = [sealed(1, 2, 3), sealed(4, 5, 6), sealed(7, 8, 9)]
  Test.assert_eq(sealed_sum(items[0]), 123)
  Test.assert_eq(sealed_sum(items[1]), 456)
  Test.assert_eq(sealed_sum(items[2]), 789)
  let mut total = 0
  for item in items[..] { total = total + sealed_sum(item) }
  Test.assert_eq(total, 1368)
}

test "arrays of opaque tuples keep every component" {
  let items = [SealedTuple((1, 2, 3)), SealedTuple((4, 5, 6))]
  Test.assert_eq(tuple_sum(items[0]), 123)
  Test.assert_eq(tuple_sum(items[1]), 456)
}
