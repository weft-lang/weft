use compiler/ir.{*}
use compiler/pipeline.{*}
use compiler/types.{*}

fn application_checked(source: str) -> TypedModule {
  pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0)
}

fn application_tail(expr: Expr) -> Expr {
  match expr {
    Let(_, _, _, body) -> application_tail(body)
    LetTyped(inner, _) -> application_tail(inner)
    Block(_, rest) -> application_tail(rest)
    _ -> expr
  }
}

fn application_failure_count(source: str) -> i64 {
  let typed = application_checked(source)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_native_typed_lowering_failure_count(pipeline_lower_native_module(typed, optimised))
}

test "a checked application retains its callee signature and source site" {
  let source = "fn main() -> i64 { let pair = ((value: i64) => value + 10, 0); (pair.0)(1) }"
  let body = source |> application_checked() |> pipeline_typed_first_decl() |> decl_body_expr() |> application_tail()
  match body {
    Apply(FieldAccess(_, _, _, _), ExprListCons(IntLit(1, _, _), ExprListNil), signature, site) -> {
      Test.assert_eq(ty_tag(pipeline_apply_result_type(signature, 0)), 2)
      Test.assert_eq(ty_f1(pipeline_apply_result_type(signature, 0)), PRIM_I64())
      Test.assert_eq(pipeline_apply_effect_flags(signature), 0)
      Test.assert_true(site > 0)
      match expr_from_node(expr_to_node(body)) {
        Apply(FieldAccess(_, _, _, _), ExprListCons(IntLit(1, _, _), ExprListNil), restored, restored_site) -> {
          Test.assert_eq(restored_site, site)
          Test.assert_eq(pipeline_apply_effect_flags(restored), 0)
          Test.assert_eq(ty_f1(pipeline_apply_result_type(restored, 0)), PRIM_I64())
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "effectful application facts preserve the callable contract" {
  let source = "effect Read { fn get() -> i64 } fn main() -> i64 { handle ((() => Read.get(), 0).0)() { Read.get() -> resume(42) } }"
  let body = source |> application_checked() |> pipeline_typed_first_decl() |> decl_body_expr()
  match body {
    Handle(Apply(_, ExprListNil, signature, _), _, _) -> Test.assert_eq(pipeline_apply_effect_flags(signature), 4)
    _ -> Test.assert_true(false)
  }
}

test "record and tuple applications lower without fallback instructions" {
  Test.assert_eq(application_failure_count("type Op { run: (i64) -> i64 } fn main() -> i64 { let op = Op { run: value => value + 10 }; (op.run)(1) }"), 0)
  Test.assert_eq(application_failure_count("fn main() -> i64 { let pair = ((value: i64) => value + 10, 0); (pair.0)(1) }"), 0)
}

test "callee control flow lowers without fallback instructions" {
  Test.assert_eq(application_failure_count("fn main() -> i64 { (if true { (value: i64) => value + 10 } else { (value: i64) => value + 20 })(1) }"), 0)
  Test.assert_eq(application_failure_count("fn main() -> i64 { ((value: i64) => value + 10)(if true { 1 } else { 2 }) }"), 0)
}

test "argument loop exits lower without fallback instructions" {
  Test.assert_eq(application_failure_count("fn id(value: i64) -> i64 { value } fn main() -> i64 { loop { id({ break(42) }) } }"), 0)
  Test.assert_eq(application_failure_count("fn make() -> (i64) -> i64 { value => value + 10 } fn main() -> i64 { loop { make()({ break(42) }) } }"), 0)
}
