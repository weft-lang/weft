-- Contextual Self in trait and impl method signatures, including the
-- annotation-free receiver shorthand.
-- Expected exit code: 42

trait SelfChoice {
  fn choose(self, _ other: Self) -> Self
  fn keep(self) -> Self
}

type SelfChoiceBox {
  value: i64
}

impl SelfChoice for SelfChoiceBox {
  fn choose(self, _ other: Self) -> Self {
    other
  }

  fn keep(self) -> Self {
    self
  }
}

fn main() -> i64 {
  let left = SelfChoiceBox { value: 7 }
  let right = SelfChoiceBox { value: 42 }
  let chosen = left.choose(right)
  let kept = chosen.keep()
  kept.value
}
