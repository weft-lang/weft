-- Gate program: tests pattern matching, effects, and closures
-- Expected exit code: 42

fn abs(x: Int) -> Int {
  if x < 0 {
    0 - x
  } else {
    x
  }
}

fn classify(n: Int) -> Int {
  match n {
    0 -> 0,
    1 -> 1,
    _ -> 2
  }
}

effect Env {
  fn lookup(key: Int) -> Int
}

fn use_env() -> Int {
  let base = Env.lookup(4)
  let scale = Env.lookup(5)
  base + scale
}

fn apply(f: fn(Int) -> Int, x: Int) -> Int {
  f(x)
}

fn double(n: Int) -> Int {
  n * 2
}

fn main() -> Int {
  let a = abs(0 - 10)
  let b = classify(1)
  let d = match a {
    10 -> 1,
    _ -> 0
  }
  let pattern_result = a + b + d
  let effect_result = handle use_env() {
    Env.lookup(key) -> resume(key)
  }
  let closure_result = apply(double, 5)
  pattern_result + effect_result + closure_result + 11
}
