-- Gate program: tests pattern matching, effects, closures, assignment, defer
-- Expected exit code: 42

fn abs(x: i64) -> i64 {
  if x < 0 {
    0 - x
  } else {
    x
  }
}

fn classify(n: i64) -> i64 {
  match n {
    0 -> 0,
    1 -> 1,
    _ -> 2
  }
}

effect Env {
  fn lookup(key: i64) -> i64
}

fn use_env() -> i64 {
  let base = Env.lookup(4)
  let scale = Env.lookup(5)
  base + scale
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
  f(x)
}

fn double(n: i64) -> i64 {
  n * 2
}

fn test_assign() -> i64 {
  let mut x = 0
  x = 3
  x
}

fn test_defer() -> i64 {
  defer 0
  7
}

fn main() -> i64 {
  let a = abs(0 - 10)
  let b = classify(1)
  let d = match a {
    10 -> 1,
    _ -> 0
  }
  let pattern_result = a + b + d
  let effect_result = handle use_env() {
    Env.lookup(key) -> resume(key)
  }
  let closure_result = apply(double, 5)
  let assign_result = test_assign()
  let defer_result = test_defer()
  pattern_result + effect_result + closure_result + assign_result + defer_result + 1
}
