-- A managed value whose declared type is an associated projection has the
-- ownership contract of the projection's implementation binding at every site.
-- Callers, specialised callees, closure captures and generic layouts must all
-- see that concrete type: a caller that left `C.Held` unresolved would borrow
-- an argument the specialised callee consumes, releasing the caller's stake.

use runtime/rc.{rc_count}
use runtime/rc_implicit_test.{
  RuntimeRcProbe,
  runtime_rc_probe_count,
  runtime_rc_probe_load,
  runtime_rc_probe_new
}
use stdlib/test.{Test}

effect Probe { fn ask(n: i64) -> i64 }

effect Stop { fn stop() -> i64 }

trait Carrier {
  type Held
  fn enabled(self) -> bool
}

type ProbeCarrier { ProbeCarrier }

impl Carrier for ProbeCarrier {
  type Held = RuntimeRcProbe
  fn enabled(self) -> bool { false }
}

type TextCarrier { TextCarrier }

impl Carrier for TextCarrier {
  type Held = str
  fn enabled(self) -> bool { true }
}

type CountCarrier { CountCarrier }

impl Carrier for CountCarrier {
  type Held = i64
  fn enabled(self) -> bool { true }
}

type Holder<C: Carrier> { held: C.Held, tag: i64 }

type Slot<C: Carrier> { Filled(C.Held), Vacant }

fn capture_in_closure<C: Carrier>(carrier: C, held: C.Held) -> i64 {
  let observe = () => {
    held
    3
  }
  observe()
}

fn capture_in_handler<C: Carrier>(carrier: C, held: C.Held) -> i64 {
  handle {
    let kept = held
    Probe.ask(4)
  } { Probe.ask(n) -> resume(n) }
}

-- The shape of a tooling entry point that refuses before reaching the syntax.
fn guarded_capture<C: Carrier>(carrier: C, held: C.Held) -> i64 {
  if carrier.enabled() {
    handle {
      let kept = held
      Probe.ask(5)
    } { Probe.ask(n) -> resume(n) }
  } else { 7 }
}

fn forward<C: Carrier>(carrier: C, held: C.Held) -> i64 {
  capture_in_closure(carrier, held) + capture_in_handler(carrier, held)
}

fn abort_captured<C: Carrier>(carrier: C, held: C.Held) -[Stop]> i64 {
  let observe = () => {
    held
    3
  }
  Stop.stop() + observe()
}

fn hold<C: Carrier>(held: C.Held) -> Holder<C> { Holder { held: held, tag: 1 } }

fn pass<C: Carrier>(held: C.Held) -> C.Held { held }

fn held_count(probe: RuntimeRcProbe) -> i64 {
  let holder = hold<ProbeCarrier>(probe)
  runtime_rc_probe_count(holder.held) * holder.tag
}

fn passed_count(probe: RuntimeRcProbe) -> i64 {
  let copy = pass<ProbeCarrier>(probe)
  runtime_rc_probe_count(copy)
}

fn fill<C: Carrier>(held: C.Held) -> Slot<C> { Filled(held) }

fn slot_count(probe: RuntimeRcProbe) -> i64 {
  match fill<ProbeCarrier>(probe) {
    Filled(inner) -> runtime_rc_probe_count(inner)
    Vacant -> 0
  }
}

fn text_count(text: str) -> i64 { rc_count(__str_ptr(text) - 16) }

test "a projection argument captured by a closure keeps the caller's stake" {
  let probe = runtime_rc_probe_new(9)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(capture_in_closure(ProbeCarrier(), probe), 3)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
  Test.assert_eq(runtime_rc_probe_load(probe), 9)
}

test "a projection argument captured by a handler body keeps the caller's stake" {
  let probe = runtime_rc_probe_new(11)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(capture_in_handler(ProbeCarrier(), probe), 4)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
  Test.assert_eq(runtime_rc_probe_load(probe), 11)
}

test "a projection argument on an untaken path keeps the caller's stake" {
  let probe = runtime_rc_probe_new(13)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(guarded_capture(ProbeCarrier(), probe), 7)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
  Test.assert_eq(runtime_rc_probe_load(probe), 13)
}

test "a generic caller forwards its projection arguments exactly" {
  let probe = runtime_rc_probe_new(15)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(forward(ProbeCarrier(), probe), 7)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
}

test "aborting past a projection capture releases only the closure's stake" {
  let probe = runtime_rc_probe_new(17)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(handle abort_captured(ProbeCarrier(), probe) { Stop.stop() -> 42 }, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
  Test.assert_eq(runtime_rc_probe_load(probe), 17)
}

test "a generic layout with a projection field owns one stake of its payload" {
  let probe = runtime_rc_probe_new(19)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(held_count(probe), before + 1)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
}

test "a variant payload typed by a projection binds its implementation type" {
  let probe = runtime_rc_probe_new(23)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(slot_count(probe), before + 1)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
  Test.assert_eq(runtime_rc_probe_load(probe), 23)
}

test "a returned projection transfers exactly one stake" {
  let probe = runtime_rc_probe_new(21)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(passed_count(probe), before + 1)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
}

test "projections bound to strings and scalars follow their bindings" {
  let text = "held".repeat(3)
  let before = text_count(text)
  Test.assert_eq(capture_in_closure(TextCarrier(), text), 3)
  Test.assert_eq(capture_in_handler(TextCarrier(), text), 4)
  Test.assert_eq(guarded_capture(TextCarrier(), text), 5)
  Test.assert_eq(text_count(text), before)
  Test.assert_str_eq(text, "heldheldheld")
  Test.assert_eq(capture_in_closure(CountCarrier(), 8), 3)
  Test.assert_eq(guarded_capture(CountCarrier(), 8), 5)
  Test.assert_eq(pass<CountCarrier>(8), 8)
}
