-- Effect arguments transfer one managed stake into the selected clause.
-- Result transfer is normalised first; the clause then releases every
-- managed operation parameter on resume, abort, and deferred paths.

use runtime/rc_implicit_test.{*}
use stdlib/display.{*}

effect ManagedTransportResume {
  fn echo(value: str) -> str
}

effect ManagedTransportAbort {
  fn stop(value: str) -> str
}

effect ManagedTransportDeferred {
  @deferred fn echo(value: str) -> str
}

effect ManagedTransportDeferredProbe {
  @deferred fn echo(value: RuntimeRcProbe) -> RuntimeRcProbe
}

effect ManagedTransportProbe {
  fn echo(value: RuntimeRcProbe) -> RuntimeRcProbe
  fn stop(value: RuntimeRcProbe) -> RuntimeRcProbe
}

effect ManagedTransportArray<T> {
  fn echo(value: T) -> T
  fn stop(value: T) -> T
  @deferred fn deferred(value: T) -> T
}

fn managed_transport_array_from_probe(probe: RuntimeRcProbe) -> [RuntimeRcProbe; 1] {
  let storage = rc_array_storage_new(8, 8, 1, 8, continuation_cleanup_kind_rc())
  let raw = runtime_rc_probe_word(probe)
  rc_default_retain(raw)
  runtime_rc_test_store64(rc_array_storage_data(storage), raw)
  runtime_generator_state_word_as<[RuntimeRcProbe; 1]>(storage)
}

fn managed_transport_array_first_probe_word(values: [RuntimeRcProbe; 1]) -> i64 {
  let storage = runtime_generator_state_word_from<[RuntimeRcProbe; 1]>(values)
  runtime_rc_test_load64(rc_array_storage_data(storage))
}

fn managed_transport_array_resume(values: [RuntimeRcProbe; 1]) -> [RuntimeRcProbe; 1] {
  handle ManagedTransportArray<[RuntimeRcProbe; 1]>.echo(values) {
    ManagedTransportArray<[RuntimeRcProbe; 1]>.echo(arg) -> resume(arg)
  }
}

fn managed_transport_array_abort(values: [RuntimeRcProbe; 1]) -> [RuntimeRcProbe; 1] {
  handle ManagedTransportArray<[RuntimeRcProbe; 1]>.stop(values) {
    ManagedTransportArray<[RuntimeRcProbe; 1]>.stop(arg) -> arg
  }
}

fn managed_transport_array_deferred_resume(values: [RuntimeRcProbe; 1]) -> [RuntimeRcProbe; 1] {
  handle ManagedTransportArray<[RuntimeRcProbe; 1]>.deferred(values) {
    ManagedTransportArray<[RuntimeRcProbe; 1]>.deferred(arg) with k -> k(arg)
  }
}

fn managed_transport_array_deferred_drop(values: [RuntimeRcProbe; 1]) -> [RuntimeRcProbe; 1] {
  handle {
    let resumed = ManagedTransportArray<[RuntimeRcProbe; 1]>.deferred(values)
    resumed
  } {
    ManagedTransportArray<[RuntimeRcProbe; 1]>.deferred(arg) with k -> arg
  }
}

fn managed_transport_array_round(kind: i64, probe: RuntimeRcProbe) -> i64 {
  let values = managed_transport_array_from_probe(probe)
  let result = match kind {
    0 -> managed_transport_array_resume(values)
    1 -> managed_transport_array_abort(values)
    2 -> managed_transport_array_deferred_resume(values)
    _ -> managed_transport_array_deferred_drop(values)
  }
  runtime_rc_test_load64(managed_transport_array_first_probe_word(result))
}

fn managed_transport_resume(value: str) -> str {
  handle ManagedTransportResume.echo(value) {
    ManagedTransportResume.echo(arg) -> resume(arg)
  }
}

fn managed_transport_abort(value: str) -> str {
  handle {
    let resumed = ManagedTransportAbort.stop(value)
    str_concat(resumed, "unreachable")
  } {
    ManagedTransportAbort.stop(arg) -> arg
  }
}

fn managed_transport_deferred_resume(value: i64) -> str {
  handle ManagedTransportDeferred.echo(runtime_int_to_str(value)) {
    ManagedTransportDeferred.echo(arg) with k -> k(arg)
  }
}

fn managed_transport_deferred_drop(value: i64) -> str {
  handle {
    let resumed = ManagedTransportDeferred.echo(runtime_int_to_str(value))
    str_concat(resumed, "unreachable")
  } {
    ManagedTransportDeferred.echo(arg) with k -> arg
  }
}

fn managed_transport_deferred_probe_resume(value: RuntimeRcProbe) -> RuntimeRcProbe {
  handle ManagedTransportDeferredProbe.echo(value) {
    ManagedTransportDeferredProbe.echo(arg) with k -> k(arg)
  }
}

fn managed_transport_deferred_probe_drop(value: RuntimeRcProbe) -> RuntimeRcProbe {
  handle {
    let resumed = ManagedTransportDeferredProbe.echo(value)
    resumed
  } {
    ManagedTransportDeferredProbe.echo(arg) with k -> arg
  }
}

fn managed_transport_probe_resume(value: RuntimeRcProbe) -> RuntimeRcProbe {
  handle ManagedTransportProbe.echo(value) {
    ManagedTransportProbe.echo(arg) -> resume(arg)
  }
}

fn managed_transport_probe_abort(value: RuntimeRcProbe) -> RuntimeRcProbe {
  handle ManagedTransportProbe.stop(value) {
    ManagedTransportProbe.stop(arg) -> arg
  }
}

fn managed_transport_probe_abort_fresh(value: RuntimeRcProbe) -> RuntimeRcProbe {
  handle ManagedTransportProbe.stop(value) {
    ManagedTransportProbe.stop(arg) -> runtime_rc_probe_new(0)
  }
}

fn managed_transport_round(kind: i64, value: i64) -> str {
  match kind {
    0 -> managed_transport_resume(runtime_int_to_str(value))
    1 -> managed_transport_abort(runtime_int_to_str(value))
    2 -> managed_transport_deferred_resume(value)
    _ -> managed_transport_deferred_drop(value)
  }
}

fn managed_transport_heap_delta(kind: i64, count: i64) -> i64 {
  let mut warm = 0
  while warm < 50 {
    str_len(managed_transport_round(kind, warm))
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < count {
    str_len(managed_transport_round(kind, i))
    i = i + 1
  }
  runtime_rc_test_heap_arena_offset() - before
}

test "managed effect parameter aliases survive every handler path" {
  Test.assert_eq(str_eq(managed_transport_round(0, 1234567), "1234567"), 1)
  Test.assert_eq(str_eq(managed_transport_round(1, 2345678), "2345678"), 1)
  Test.assert_eq(str_eq(managed_transport_round(2, 3456789), "3456789"), 1)
  Test.assert_eq(str_eq(managed_transport_round(3, 4567890), "4567890"), 1)
}

test "managed effect parameter stakes reuse heap blocks" {
  Test.assert_eq(managed_transport_heap_delta(0, 100) + 0, 0)
  Test.assert_eq(managed_transport_heap_delta(1, 100) + 1, 1)
}

test "deferred managed effect parameter stakes balance exactly" {
  let resume_payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let resumed = managed_transport_deferred_probe_resume(resume_payload)
  Test.assert_eq(runtime_rc_probe_count(resume_payload), 2)
  Test.assert_eq(runtime_rc_probe_count(resumed), 2)
  let drop_payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let dropped = managed_transport_deferred_probe_drop(drop_payload)
  Test.assert_eq(runtime_rc_probe_count(drop_payload), 2)
  Test.assert_eq(runtime_rc_probe_count(dropped), 2)
}

test "immediate managed effect parameter stakes balance exactly" {
  let resume_payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let resumed = managed_transport_probe_resume(resume_payload)
  Test.assert_eq(runtime_rc_probe_count(resume_payload), 2)
  Test.assert_eq(runtime_rc_probe_count(resumed), 2)
  let abort_payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let aborted = managed_transport_probe_abort(abort_payload)
  Test.assert_eq(runtime_rc_probe_count(abort_payload), 2)
  Test.assert_eq(runtime_rc_probe_count(aborted), 2)
  let fresh_input: RuntimeRcProbe = runtime_rc_probe_new(0)
  let fresh = managed_transport_probe_abort_fresh(fresh_input)
  Test.assert_eq(runtime_rc_probe_count(fresh_input), 1)
  Test.assert_eq(runtime_rc_probe_count(fresh), 1)
}

test "fixed array effect carriers preserve payloads on every handler path" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(managed_transport_array_round(0, probe), 42)
  Test.assert_eq(managed_transport_array_round(1, probe), 42)
  Test.assert_eq(managed_transport_array_round(2, probe), 42)
  Test.assert_eq(managed_transport_array_round(3, probe), 42)
}

test "fixed array effect carriers balance managed leaves" {
  let probe = runtime_rc_probe_new(7)
  let mut i = 0
  while i < 128 {
    Test.assert_eq(managed_transport_array_round(i % 4, probe), 7)
    i = i + 1
  }
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}
