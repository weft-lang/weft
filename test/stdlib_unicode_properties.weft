use stdlib/test.{*}
use stdlib/unicode.{*}

test "unicode_general_categories_cover_major_and_special_classes" {
  Test.assert_str_eq(unicode_general_category(65), "Lu")
  Test.assert_str_eq(unicode_general_category(97), "Ll")
  Test.assert_str_eq(unicode_general_category(49), "Nd")
  Test.assert_str_eq(unicode_general_category(769), "Mn")
  Test.assert_str_eq(unicode_general_category(32), "Zs")
  Test.assert_str_eq(unicode_general_category(128512), "So")
  Test.assert_str_eq(unicode_general_category(0), "Cc")
  Test.assert_str_eq(unicode_general_category(57344), "Co")
  Test.assert_str_eq(unicode_general_category(55296), "Cs")
}

test "unicode_general_category_defaults_unassigned_and_invalid_to_cn" {
  Test.assert_str_eq(unicode_general_category(888), "Cn") -- U+0378
  Test.assert_str_eq(unicode_general_category(0 - 1), "Cn")
  Test.assert_str_eq(unicode_general_category(1114112), "Cn")
}

test "unicode_scripts_cover_common_inherited_and_supplementary" {
  Test.assert_str_eq(unicode_script(65), "Latin")
  Test.assert_str_eq(unicode_script(945), "Greek")
  Test.assert_str_eq(unicode_script(20013), "Han")
  Test.assert_str_eq(unicode_script(49), "Common")
  Test.assert_str_eq(unicode_script(769), "Inherited")
  Test.assert_str_eq(unicode_script(66560), "Deseret")
  Test.assert_str_eq(unicode_script(888), "Unknown")
}

test "unicode_combining_classes_are_canonical_numeric_values" {
  Test.assert_eq(unicode_combining_class(65), 0)
  Test.assert_eq(unicode_combining_class(769), 230)
  Test.assert_eq(unicode_combining_class(803), 220)
  Test.assert_eq(unicode_combining_class(0 - 1), 0)
}

test "unicode_casing_properties_cover_letters_and_ignorables" {
  Test.assert_true(unicode_is_alphabetic(65))
  Test.assert_true(unicode_is_uppercase(65))
  Test.assert_false(unicode_is_lowercase(65))
  Test.assert_true(unicode_is_lowercase(945))
  Test.assert_true(unicode_is_cased(945))
  Test.assert_true(unicode_is_case_ignorable(769))
  Test.assert_true(unicode_is_soft_dotted(105))
  Test.assert_false(unicode_is_alphabetic(49))
}

test "unicode_space_and_pattern_properties_are_not_ascii_shortcuts" {
  Test.assert_true(unicode_is_white_space(32))
  Test.assert_true(unicode_is_white_space(160))
  Test.assert_false(unicode_is_white_space(8203))
  Test.assert_true(unicode_is_pattern_white_space(8206))
  Test.assert_true(unicode_is_pattern_syntax(36))
  Test.assert_false(unicode_is_pattern_syntax(65))
}

test "unicode_grapheme_properties_cover_marks_prepend_and_emoji" {
  Test.assert_true(unicode_is_grapheme_base(65))
  Test.assert_true(unicode_is_grapheme_extend(769))
  Test.assert_true(unicode_is_grapheme_link(2381)) -- DEVANAGARI SIGN VIRAMA
  Test.assert_true(unicode_is_prepended_concatenation_mark(1536))
  Test.assert_true(unicode_is_regional_indicator(127462))
  Test.assert_true(unicode_is_extended_pictographic(128512))
}

test "unicode_security_properties_cover_controls_and_noncharacters" {
  Test.assert_true(unicode_is_join_control(8205))
  Test.assert_true(unicode_is_variation_selector(65039))
  Test.assert_true(unicode_is_bidi_control(8238))
  Test.assert_true(unicode_is_noncharacter(64976))
  Test.assert_true(unicode_is_default_ignorable(8205))
  Test.assert_false(unicode_is_bidi_control(65))
}

test "unicode_public_identifier_properties_share_the_compiler_tables" {
  Test.assert_true(unicode_is_xid_start(945))
  Test.assert_true(unicode_is_xid_continue(769))
  Test.assert_false(unicode_is_xid_start(769))
  Test.assert_false(unicode_is_xid_continue(128512))
}

test "unicode_binary_properties_reject_out_of_range_scalars" {
  Test.assert_false(unicode_is_alphabetic(0 - 1))
  Test.assert_false(unicode_is_white_space(1114112))
  Test.assert_false(unicode_is_extended_pictographic(0 - 1))
}
