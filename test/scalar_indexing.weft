  Test.assert_true(dynamic[..][0] == high and dynamic[..][1] == low and dynamic[..][2] == high)
}

test "f32 indexed storage preserves signed zero infinities and NaN payloads" {
  let patterns: [u32; 7] = [0, 2147483648, 1, 1065353216, 2139095040, 4286578688, 2143363909]
  let mut fixed: [f32; 2] = [1.0, 2.0]
  let mut dynamic = vector.new<f32>()
  dynamic.push(1.0)
  dynamic.push(2.0)
  for bits in patterns {
    let value = num.f32_from_bits(bits)
    Test.assert_true(replace<f32>(fixed[..], 0, value).to_bits() == bits)
    Test.assert_true(replace<f32>(dynamic[..], 0, value).to_bits() == bits)
    Test.assert_true(fixed[0].to_bits() == bits and dynamic[..][0].to_bits() == bits)
    Test.assert_true(fixed[1] == 2.0 and dynamic[..][1] == 2.0)
  }
}

test "f64 indexed storage preserves signed zero infinities and NaN payloads" {
  let patterns: [u64; 7] = [0, 9223372036854775808, 1, 4607182418800017408, 9218868437227405312, 18442240474082181120, 9221120237041095221]
  let mut fixed: [f64; 2] = [1.0, 2.0]
  let mut dynamic = vector.new<f64>()
  dynamic.push(1.0)
  dynamic.push(2.0)
  for bits in patterns {
    let value = num.f64_from_bits(bits)
    Test.assert_true(replace<f64>(fixed[..], 0, value).to_bits() == bits)
    Test.assert_true(replace<f64>(dynamic[..], 0, value).to_bits() == bits)
    Test.assert_true(fixed[0].to_bits() == bits and dynamic[..][0].to_bits() == bits)
    Test.assert_true(fixed[1] == 2.0 and dynamic[..][1] == 2.0)
  }
}

test "boolean and empty element storage preserve indexing semantics" {
  let mut flags = [false, true, false]
  Test.assert_true(replace<bool>(flags[..], 0, true))
  Test.assert_true(flags[1] and not flags[2])
  let mut units = [nil, nil]
  replace<nil>(units[..], 1, nil)
  Test.assert_true(units[0] == nil and units[1] == nil)
}
