  dynamic.push(high)
  dynamic.push(high)
  dynamic.push(high)
  Test.assert_true(replace<i64>(dynamic[..], 1, low) == low)
  Test.assert_true(dynamic[..][0] == high and dynamic[..][1] == low and dynamic[..][2] == high)
}

test "u64 indexed storage preserves boundaries and adjacent elements" {
  let low: u64 = 0
  let high: u64 = 18446744073709551615
  let mut fixed: [u64; 3] = [high, low, high]
  Test.assert_true(replace<u64>(fixed[..], 1, high) == high)
  Test.assert_true(replace<u64>(fixed[..], 0, low) == low)
  Test.assert_true(fixed[0] == low and fixed[1] == high and fixed[2] == high)
  let mut dynamic = vector.new<u64>()
