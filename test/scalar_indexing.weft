use stdlib/num as num
use stdlib/num.{*}
use stdlib/vector as vector
use stdlib/test.{Test}

fn replace<T>(values: [mut T], index: usize, value: T) -> T {
  values[index] = value
  values[index]
}

test "i8 indexed storage preserves boundaries and adjacent elements" {
  let low: i8 = 0 - 128
  let high: i8 = 127
  let mut fixed: [i8; 3] = [high, low, high]
  Test.assert_true(replace<i8>(fixed[..], 1, high) == high)
  Test.assert_true(replace<i8>(fixed[..], 0, low) == low)
  Test.assert_true(fixed[0] == low and fixed[1] == high and fixed[2] == high)
  let mut dynamic = vector.new<i8>()
  dynamic.push(high)
  dynamic.push(high)
  dynamic.push(high)
  Test.assert_true(replace<i8>(dynamic[..], 1, low) == low)
  Test.assert_true(dynamic[..][0] == high and dynamic[..][1] == low and dynamic[..][2] == high)
}

