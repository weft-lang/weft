test "i64 indexed storage preserves boundaries and adjacent elements" {
  let low: i64 = 0 - 9223372036854775807 - 1
  let high: i64 = 9223372036854775807
  let mut fixed: [i64; 3] = [high, low, high]
  Test.assert_true(replace<i64>(fixed[..], 1, high) == high)
