-- The raw-memory boundary classifies raw modules and members, and decides
-- which strict modules may bind or re-export them.

use compiler/project/identity.{ValueDeclaration, named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/source/raw_boundary.{*}
use compiler/source/trust.{SourceAuthority, StrictSourceAuthority, TrustedSourceAuthority}
use compiler/weft/check/registration/catalog as registration_catalog
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/handler.{
  RegisteredHandlerImplementationSealed,
  RegisteredHandlerSelected,
  registration_scope_select_handler
}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/registration/scope.{
  RegistrationScope,
  ResolvedImport,
  ScopeImportPlatformAuthority,
  ScopeImportRawMemory
}
use compiler/weft/grammar.{WeftParser, ParsedWeftSource}
use runtime/descriptor_io as descriptors
use runtime/dir_inspect as platform_dir_inspect
use runtime/dns as platform_dns
use runtime/env as platform_env
use runtime/rc as runtime_rc
use runtime/string as runtime_string
use runtime/string.{runtime_str_byte_at, runtime_str_len}
use runtime/syscall.{sys_socket_af_inet}
use runtime/terminal.{terminal_color_mode_always, terminal_color_policy}
use stdlib/diagnostic.{Diagnose}
use stdlib/dir as dir
use stdlib/env.{Env}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/list as list
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}
use stdlib/random as random
use stdlib/result.{Result}
use stdlib/string.{str_concat, str_ends_with, str_len, str_starts_with}
use stdlib/test/property as prop

test "only trusted modules under runtime form the raw ring" {
  Test.assert_true(raw_boundary_trusted_runtime(true, "runtime/memory"))
  Test.assert_true(raw_boundary_trusted_runtime(true, "runtime/tls_mbedtls"))
  Test.assert_false(raw_boundary_trusted_runtime(false, "runtime/memory"))
  Test.assert_false(raw_boundary_trusted_runtime(true, "native/raw"))
  Test.assert_false(raw_boundary_trusted_runtime(true, "stdlib/runtime/memory"))
  Test.assert_false(raw_boundary_trusted_runtime(true, "runtimes/memory"))
  Test.assert_false(raw_boundary_trusted_runtime(true, "runtime"))
}

test "only paths under runtime can hold ring code" {
  Test.assert_true(raw_boundary_ring_path("runtime/env"))
  Test.assert_true(raw_boundary_ring_path("runtime/"))
  Test.assert_false(raw_boundary_ring_path("runtime"))
  Test.assert_false(raw_boundary_ring_path("runtimes/env"))
  Test.assert_false(raw_boundary_ring_path("stdlib/runtime/env"))
  Test.assert_false(raw_boundary_ring_path(""))
}

test "strict code installs only audited runtime handlers" {
  Test.assert_true(raw_boundary_safe_handler("runtime/dns"))
  Test.assert_true(raw_boundary_safe_handler("runtime/env"))
  Test.assert_true(raw_boundary_safe_handler("runtime/process"))
  Test.assert_true(raw_boundary_safe_handler("runtime/process_environment"))
  -- Unaudited handlers and near neighbours of audited paths are not safe.
  Test.assert_false(raw_boundary_safe_handler("runtime/raw_boundary_probe_test"))
  Test.assert_false(raw_boundary_safe_handler("runtime/proc"))
  Test.assert_false(raw_boundary_safe_handler("runtime/processes"))
  Test.assert_false(raw_boundary_safe_handler("runtime/env.Env"))
  Test.assert_false(raw_boundary_safe_handler("runtime/dn"))
  Test.assert_false(raw_boundary_safe_handler("runtime/process_environments"))
  Test.assert_false(raw_boundary_safe_handler(""))
}

test "only audited runtime exports carry platform authority" {
  Test.assert_true(raw_boundary_platform_export("runtime/dir", "runtime_dir_list"))
  Test.assert_true(raw_boundary_platform_export("runtime/descriptor_io", "descriptor_close"))
  Test.assert_true(raw_boundary_platform_export("runtime/tcp", "runtime_tcp_read_safe"))
  Test.assert_true(raw_boundary_platform_export("runtime/time", "runtime_platform_now_nanos"))
  Test.assert_true(raw_boundary_platform_export("runtime/terminal", "terminal_fd_is_tty"))
  Test.assert_true(raw_boundary_platform_export("runtime/syscall", "sys_write_text"))
  -- Authority is no longer part of the safe surface.
  Test.assert_false(raw_boundary_safe_export("runtime/dir", "runtime_dir_list"))
  Test.assert_false(raw_boundary_safe_export("runtime/tcp", "runtime_tcp_read_safe"))
  -- Installers, pure computation, constants and presentation state stay safe.
  Test.assert_true(raw_boundary_safe_export("runtime/dir", "runtime_platform_dir"))
  Test.assert_true(raw_boundary_safe_export("runtime/time", "with_platform"))
  Test.assert_true(raw_boundary_safe_export("runtime/terminal", "terminal_color_policy"))
  Test.assert_true(raw_boundary_safe_export("runtime/terminal", "terminal_stderr_color_mode"))
  Test.assert_true(raw_boundary_safe_export("runtime/syscall", "sys_socket_af_inet"))
  Test.assert_false(raw_boundary_platform_export("runtime/terminal", "terminal_color_policy"))
  -- Raw exports are neither safe nor authority; neighbours are neither.
  Test.assert_false(raw_boundary_platform_export("runtime/memory", "mem_load8_at"))
  Test.assert_false(raw_boundary_platform_export("runtime/dir", "runtime_dir_lis"))
  Test.assert_false(raw_boundary_platform_export("runtime/dirs", "runtime_dir_list"))
  Test.assert_false(raw_boundary_platform_export("", ""))
}

test "only named platform interpreters may bind platform authority" {
  Test.assert_true(raw_boundary_platform_interpreter("runtime/dir_inspect"))
  Test.assert_true(raw_boundary_platform_interpreter("runtime/tcp_stream_io"))
  Test.assert_true(raw_boundary_platform_interpreter("runtime/safe_file_core"))
  Test.assert_true(raw_boundary_platform_interpreter("stdlib/console/terminal"))
  Test.assert_true(raw_boundary_platform_interpreter("stdlib/console/input"))
  -- Pure parsers, the ring itself and ordinary modules are not interpreters.
  Test.assert_false(raw_boundary_platform_interpreter("runtime/dns_static"))
  Test.assert_false(raw_boundary_platform_interpreter("runtime/dir"))
  Test.assert_false(raw_boundary_platform_interpreter("stdlib/console"))
  Test.assert_false(raw_boundary_platform_interpreter("stdlib/io"))
  Test.assert_false(raw_boundary_platform_interpreter("runtime/dir_inspect_extra"))
  Test.assert_false(raw_boundary_platform_interpreter(""))
}

test "trusted exports are raw unless they belong to the audited safe surface" {
  Test.assert_true(raw_boundary_platform_export("runtime/tcp", "runtime_tcp_connect_safe"))
  Test.assert_true(raw_boundary_safe_export("runtime/string", "runtime_str_len"))
  Test.assert_true(raw_boundary_platform_export("runtime/descriptor_io", "descriptor_read_into"))
  Test.assert_true(raw_boundary_safe_export("runtime/descriptor_io", "DescriptorOpenRead"))
  Test.assert_true(raw_boundary_platform_export("runtime/syscall", "sys_close"))
  Test.assert_true(raw_boundary_safe_export("runtime/unsafe", "Unsafe"))
  -- Raw families, raw string members and raw-address syscalls stay raw.
  Test.assert_false(raw_boundary_safe_export("runtime/memory", "mem_load8_at"))
  Test.assert_false(raw_boundary_safe_export("runtime/alloc", "alloc_words"))
  Test.assert_false(raw_boundary_safe_export("runtime/string", "runtime_str_ptr"))
  Test.assert_false(raw_boundary_safe_export("runtime/syscall", "sys_read"))
  Test.assert_false(raw_boundary_safe_export("runtime/syscall", "sys_write"))
  Test.assert_false(raw_boundary_safe_export("runtime/tcp", "runtime_tcp_connect_raw"))
  Test.assert_false(raw_boundary_safe_export("runtime/vector_storage", "vector_storage_data"))
  -- A safe name is safe only in the module that declares it.
  Test.assert_false(raw_boundary_safe_export("runtime/memory", "runtime_str_len"))
  Test.assert_false(raw_boundary_safe_export("runtime", "tcp.runtime_tcp_connect_safe"))
  Test.assert_false(raw_boundary_platform_export("runtime", "tcp.runtime_tcp_connect_safe"))
  Test.assert_false(raw_boundary_platform_export("runtime/tcp.runtime_tcp", "connect_safe"))
  Test.assert_false(raw_boundary_safe_export("runtime/tcp.runtime_tcp", "connect_safe"))
  Test.assert_false(raw_boundary_safe_export("", ""))
}

test "strict modules bind raw memory only while listed and re-export it only while trusted" {
  -- A listed strict module may bind privately, but never re-export.
  Test.assert_false(raw_boundary_import_refused(false, "compiler/pipeline", false))
  Test.assert_true(raw_boundary_import_refused(false, "compiler/pipeline", true))
  -- A trusted module, including compiler-generated trusted source with no
  -- path of its own, may do both.
  Test.assert_false(raw_boundary_import_refused(true, "runtime/rc", false))
  Test.assert_false(raw_boundary_import_refused(true, "runtime/rc", true))
  Test.assert_false(raw_boundary_import_refused(true, "", true))
  -- Migrated and new strict modules may do neither.
  Test.assert_true(raw_boundary_import_refused(false, "stdlib/utf8", false))
  Test.assert_true(raw_boundary_import_refused(false, "runtime/dns_static_resolver", false))
  Test.assert_true(raw_boundary_import_refused(false, "compiler/backend/binary", false))
  Test.assert_true(raw_boundary_import_refused(false, "test/raw_boundary_policy", false))
  Test.assert_true(raw_boundary_import_refused(false, "", false))
  -- Paths match exactly: neighbours of listed entries are not listed.
  Test.assert_true(raw_boundary_import_refused(false, "compiler/pipelin", false))
  Test.assert_true(raw_boundary_import_refused(false, "compiler/pipeline/child", false))
  Test.assert_true(raw_boundary_import_refused(false, "compiler/pipeline.weft", false))
  -- The first and last listed paths bound the search.
  Test.assert_true(raw_boundary_transitional("compiler/backend/aarch64/codegen"))
  Test.assert_true(raw_boundary_transitional("tools/typed_differential"))
  Test.assert_true(raw_boundary_transitional("stdlib/vector"))
  Test.assert_false(raw_boundary_transitional("a"))
  Test.assert_false(raw_boundary_transitional("zzz"))
  Test.assert_str_eq(raw_boundary_logical_path("test/example.weft"), "test/example")
  Test.assert_str_eq(raw_boundary_logical_path("test/example"), "test/example")
  Test.assert_str_eq(raw_boundary_logical_path("./test/example.weft"), "test/example")
  Test.assert_str_eq(raw_boundary_logical_path("././test/example.weft"), "test/example")
  Test.assert_str_eq(raw_boundary_logical_path(".weft"), "")
  Test.assert_str_eq(raw_boundary_logical_path("./example.weft.weft"), "example.weft")
}

-- Fragments that collide with the prefix and suffix a logical path drops, so
-- generated paths repeat, nest and split them.
fn generated_path(fragments: List<usize>) -> str {
  let pieces = ["./", ".weft", ".", "/", "weft", "runtime/memory", "é"]
  match fragments {
    Nil -> ""
    Cons(index, rest) -> str_concat(pieces[index], generated_path(rest))
  }
}

fn logical_path_laws(fragments: List<usize>) -> bool {
  let path = generated_path(fragments)
  let logical = raw_boundary_logical_path(path)
  let prefixed = raw_boundary_logical_path(str_concat("./", path)) == logical
  if str_starts_with(path, "./") == 1 { return prefixed }
  let suffixed = raw_boundary_logical_path(str_concat(path, ".weft")) == path
  let settled = str_ends_with(path, ".weft") == 1 or logical == path
  prefixed and suffixed and settled
}

test "logical paths ignore leading ./ and drop exactly one .weft suffix" {
  let fragment = prop.usize_below(7).expect("the fragment table is nonempty")
  let lengths = prop.lengths(0, 8).expect("the path length range is valid")
  let config = prop.config(random.seed(0x5241574c4f474943), 400, 8, 0, 200).expect(
    "the path campaign is valid"
  )
  prop.check(config, prop.list<usize>(fragment, lengths), logical_path_laws)
}

-- One generated import: who imports, from where, how visibly, from which
-- target and with what authority, in which form, and which of the eight
-- members it selects or renames.
type BoundaryCase {
  trusted: bool,
  listed: bool,
  target_trusted: bool,
  visibility: usize,
  target: usize,
  form: usize,
  selected: usize,
  renamed: usize
}

-- Even members are raw exports of runtime/string; odd members belong to its
-- audited safe surface. No member is safe in any other module.
fn boundary_member(index: usize) -> str {
  let members = [
    "runtime_str_ptr",
    "runtime_str_len",
    "runtime_str_set_len",
    "runtime_str_byte_at",
    "runtime_str_from_bytes_copy",
    "runtime_str_concat",
    "runtime_str_word_as_str",
    "runtime_str_eq"
  ]
  members[index]
}

fn boundary_bit(mask: usize, index: usize) -> bool {
  let mut value = mask
  let mut remaining = index
  while remaining > 0 {
    value = value / 2
    remaining = remaining - 1
  }
  value % 2 == 1
}

fn boundary_draw(draws: List<usize>, index: usize) -> usize {
  let zero: usize = 0
  match draws.get(index) {
    Some(value) -> value
    None -> zero
  }
}

fn boundary_case(draws: List<usize>) -> BoundaryCase {
  BoundaryCase {
    trusted: boundary_draw(draws, 0) % 2 == 1,
    listed: boundary_draw(draws, 1) % 2 == 1,
    target_trusted: boundary_draw(draws, 7) % 2 == 1,
    visibility: boundary_draw(draws, 2) % 3,
    target: boundary_draw(draws, 3) % 3,
    form: boundary_draw(draws, 4) % 3,
    selected: boundary_draw(draws, 5) % 255 + 1,
    renamed: boundary_draw(draws, 6)
  }
}

fn boundary_target_path(target: usize) -> str {
  if target == 0 {
    "runtime/string"
  } else if target == 1 { "runtime/memory" } else { "stdlib/boundary_probe" }
}

fn boundary_selection(case: BoundaryCase) -> str {
  let mut names = ""
  let mut index: usize = 0
  while index < 8 {
    if boundary_bit(case.selected, index) {
      let member = boundary_member(index)
      let spelled = if boundary_bit(case.renamed, index) {
        str_concat(member, str_concat(" as renamed_", member))
      } else { member }
      names = if str_len(names) == 0 { spelled } else {
        str_concat(names, str_concat(", ", spelled))
      }
    }
    index = index + 1
  }
  str_concat(".{", str_concat(names, "}"))
}

fn boundary_import(case: BoundaryCase) -> str {
  let visibility = if case.visibility == 0 { "" } else if case.visibility == 1 {
    "pub(package) "
  } else { "pub " }
  let binding = if case.form == 1 { ".{*}" } else if case.form == 2 {
    " as boundary_module"
  } else { boundary_selection(case) }
  str_concat(
    visibility,
    str_concat("use ", str_concat(boundary_target_path(case.target), binding))
  )
}

fn boundary_parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected a complete generated boundary module")
  }
}

fn boundary_module(text: str, path: str, authority: SourceAuthority) -[Test]> RegisteredModule {
  let syntax = boundary_parse(text)
  registration_catalog.register_with_authority(
    syntax.declarations,
    syntax.source.source(),
    named_module_identity(path, 1),
    authority
  )
}

fn boundary_target(target: usize, trusted: bool) -[Test]> RegisteredModule {
  let mut text = ""
  let mut index: usize = 0
  while index < 8 {
    text = str_concat(
      text,
      str_concat("pub fn ", str_concat(boundary_member(index), "() -> i64 { 0 } "))
    )
    index = index + 1
  }
  boundary_module(
    text,
    boundary_target_path(target),
    if trusted { TrustedSourceAuthority } else { StrictSourceAuthority }
  )
}

-- The oracle states the policy independently of the implementation's tables:
-- only a trusted runtime target's exports can be raw; a trusted importer is never
-- refused, a strict re-export always is, and a strict private import is
-- refused unless its path is listed. A refused selection reports each raw
-- member it names and a refused wildcard reports once. A module alias binds
-- no member, so it is never refused itself.
fn boundary_expected_issues(case: BoundaryCase) -> usize {
  let zero: usize = 0
  let one: usize = 1
  let refused = if case.trusted { false } else if case.visibility > 0 { true } else {
    not case.listed
  }
  if not refused or not case.target_trusted or case.target == 2 or case.form == 2 { return zero }
  if case.form == 1 { return one }
  let mut count: usize = 0
  let mut index: usize = 0
  while index < 8 {
    if boundary_bit(case.selected, index) and (case.target != 0 or index % 2 == 0) {
      count = count + 1
    }
    index = index + 1
  }
  count
}

-- A use through a module alias is decided in the module that makes it, whatever
-- the alias's own visibility: only trusted and listed importers may reach raw
-- members.
fn boundary_expected_sealed(case: BoundaryCase, index: usize) -> bool {
  not case.trusted and not case.listed and case.target_trusted and case.target != 2 and
    (case.target != 0 or index % 2 == 0)
}

fn boundary_qualified_uses_follow_policy(
  case: BoundaryCase,
  scope: RegistrationScope,
  importer: RegisteredModule
) -> bool {
  if case.form != 2 { return true }
  let mut index: usize = 0
  while index < 8 {
    let found = registration_scope.registration_scope_lookup_qualified_declaration(
      scope,
      importer.identity,
      "boundary_module",
      ValueDeclaration,
      boundary_member(index)
    )
    let sealed = match found {
      Some(_) -> false
      None -> true
    }
    if sealed != boundary_expected_sealed(case, index) { return false }
    index = index + 1
  }
  true
}

fn boundary_raw_issues(scope: RegistrationScope) -> usize {
  let mut count: usize = 0
  let mut seen: usize = 0
  let mut index = 0
  while seen < registration_scope.registration_scope_issue_count(scope) {
    match registration_scope.registration_scope_issue_at(scope, index).status {
      ScopeImportRawMemory -> { count = count + 1 }
      _ -> nil
    }
    seen = seen + 1
    index = index + 1
  }
  count
}

fn boundary_refusals_follow_policy(draws: List<usize>) -[Test]> bool {
  let case = boundary_case(draws)
  let target = boundary_target(case.target, case.target_trusted)
  let importer = boundary_module(
    str_concat(boundary_import(case), " fn main() -> i64 { 0 }"),
    if case.listed { "compiler/pipeline" } else { "test/boundary_probe" },
    if case.trusted { TrustedSourceAuthority } else { StrictSourceAuthority }
  )
  let edges = importer.syntax.imports.map<ResolvedImport>(
    declaration => registration_scope.resolved_import(
      importer,
      declaration,
      target.identity,
      false
    )
  )
  let modules = [importer, target]
  let scope = registration_scope.registration_scope_build(list.from_slice(modules[..]), edges)
  let raw = boundary_raw_issues(scope)
  raw == boundary_expected_issues(case) and
    registration_scope.registration_scope_issue_count(scope) == raw and
    boundary_qualified_uses_follow_policy(case, scope, importer)
}

test "generated imports and qualified uses are refused exactly where the policy says" {
  let draw = prop.usize_below(256).expect("the draw domain is nonempty")
  let lengths = prop.lengths(8, 8).expect("a case takes eight draws")
  let config = prop.config(random.seed(0x5241574252445259), 300, 16, 0, 200).expect(
    "the boundary campaign is valid"
  )
  prop.check(config, prop.list<usize>(draw, lengths), boundary_refusals_follow_policy)
}

test "unlisted strict code keeps the safe runtime string members" {
  Test.assert_eq(runtime_str_len("boundary"), 8)
  Test.assert_eq(runtime_str_byte_at("boundary", 0), 98)
}

test "unlisted strict code binds audited safe exports of trusted modules" {
  Test.assert_eq(terminal_color_policy(0, terminal_color_mode_always()), 1)
  Test.assert_eq(sys_socket_af_inet(), 2)
}

-- A handler module at `path`, trusted or strict, and a module that installs its
-- handler through an alias.
fn handler_seal_case(
  importer_authority: SourceAuthority,
  importer_path: str,
  target_trusted: bool,
  path: str
) -[Test]> bool {
  let target = boundary_module(
    "pub effect Probe { fn value() -> i64 } pub implements Probe() { Probe.value() -> resume(1) }",
    path,
    if target_trusted { TrustedSourceAuthority } else { StrictSourceAuthority }
  )
  let text = str_concat("use ", str_concat(path, " as probe fn main() -> i64 { 0 }"))
  let importer = boundary_module(text, importer_path, importer_authority)
  let edges = importer.syntax.imports.map<ResolvedImport>(
    declaration => registration_scope.resolved_import(
      importer,
      declaration,
      target.identity,
      false
    )
  )
  let modules = [importer, target]
  let scope = registration_scope.registration_scope_build(list.from_slice(modules[..]), edges)
  -- The alias follows "use <path> as ".
  let alias_start = str_len(path) + 8
  let alias = match importer.source.span(
    __i64_to_usize(alias_start),
    __i64_to_usize(alias_start + 5)
  ) {
    Some(span) -> span
    None -> panic("the generated alias span is in bounds")
  }
  let sealed = registration_scope.registration_scope_handler_sealed(
    scope,
    importer.identity,
    target.identity
  )
  let selected = match registration_scope_select_handler(scope, importer.identity, alias) {
    RegisteredHandlerSelected(_, _) -> 1
    RegisteredHandlerImplementationSealed -> 2
    _ -> 3
  }
  Test.assert_eq(
    registration_scope.registration_scope_issue_count(scope).to_u64().to_i64_checked().unwrap(),
    0
  )
  Test.assert_eq(selected, if sealed { 2 } else { 1 })
  sealed
}

test "handler installations through aliases are sealed exactly where the policy says" {
  let paths = ["runtime/dns", "runtime/raw_boundary_probe_test", "stdlib/handler_probe"]
  let importers = [
    (TrustedSourceAuthority, "runtime/rc"),
    (StrictSourceAuthority, "compiler/pipeline"),
    (StrictSourceAuthority, "test/handler_probe")
  ]
  let mut path_index: usize = 0
  while path_index < paths.len {
    let mut importer_index: usize = 0
    while importer_index < importers.len {
      match importers[importer_index] {
        (authority, importer_path) -> {
          for target_trusted in [false, true] {
            -- Only an unlisted strict importer installing an unaudited handler
            -- of a trusted runtime module is sealed.
            let expected = importer_index == 2 and target_trusted and path_index == 1
            Test.assert_eq(
              if handler_seal_case(authority, importer_path, target_trusted, paths[path_index]) {
                1
              } else { 0 },
              if expected { 1 } else { 0 }
            )
          }
        }
      }
      importer_index = importer_index + 1
    }
    path_index = path_index + 1
  }
}

test "unlisted strict code uses audited safe members through module aliases" {
  Test.assert_eq(runtime_string.runtime_str_len("boundary"), 8)
  let mode: descriptors.DescriptorOpen = descriptors.DescriptorOpenRead
  Test.assert_true(
    match mode {
      descriptors.DescriptorOpenRead -> true
      _ -> false
    }
  )
  let identity: runtime_rc.RuntimeIdentity = runtime_rc.rc_identity_new()
  Test.assert_true(runtime_rc.rc_identity_equal(identity, identity))
}

test "unlisted strict code installs audited runtime handlers through module aliases" {
  Test.assert_ge(with platform_env() { Env.arg_count() }, 1)
  Test.assert_eq(with platform_dns() { 7 }, 7)
}

-- The boundary's verdict for one selected import: 0 admitted, 1 raw memory,
-- 2 platform authority.
fn authority_case(
  importer_authority: SourceAuthority,
  importer_path: str,
  visibility: str,
  target_path: str,
  target_trusted: bool,
  member: str
) -[Test]> i64 {
  let target = boundary_module(
    "pub fn runtime_dir_list() -> i64 { 0 } pub fn runtime_platform_dir() -> i64 { 0 } pub fn runtime_dir_raw() -> i64 { 0 } pub fn interpreter_helper() -> i64 { 0 }",
    target_path,
    if target_trusted { TrustedSourceAuthority } else { StrictSourceAuthority }
  )
  let text = str_concat(
    visibility,
    str_concat(
      "use ",
      str_concat(target_path, str_concat(".{", str_concat(member, "} fn main() -> i64 { 0 }")))
    )
  )
  let importer = boundary_module(text, importer_path, importer_authority)
  let edges = importer.syntax.imports.map<ResolvedImport>(
    declaration => registration_scope.resolved_import(
      importer,
      declaration,
      target.identity,
      false
    )
  )
  let modules = [importer, target]
  let scope = registration_scope.registration_scope_build(list.from_slice(modules[..]), edges)
  let mut verdict = 0
  let mut seen: usize = 0
  let mut index = 0
  while seen < registration_scope.registration_scope_issue_count(scope) {
    match registration_scope.registration_scope_issue_at(scope, index).status {
      ScopeImportRawMemory -> { verdict = 1 }
      ScopeImportPlatformAuthority -> { verdict = 2 }
      _ -> { verdict = 9 }
    }
    seen = seen + 1
    index = index + 1
  }
  verdict
}

test "the boundary separates raw memory from platform authority for every importer" {
  let importers = [
    (TrustedSourceAuthority, "runtime/rc"),
    (StrictSourceAuthority, "compiler/pipeline"),
    (StrictSourceAuthority, "runtime/dir_mutate"),
    (StrictSourceAuthority, "test/authority_probe")
  ]
  let mut index: usize = 0
  while index < importers.len {
    match importers[index] {
      (authority, path) -> {
        for visibility in ["", "pub "] {
          let reexported = visibility == "pub "
          let trusted = index == 0
          let listed = index == 1
          let interpreter = index == 2
          -- Only trusted code re-exports; a listed file binds anything
          -- privately; an interpreter binds authority privately but not raw
          -- memory; ordinary code binds only the safe surface.
          let refused = not trusted and (reexported or not listed)
          let authority_admitted = interpreter and not reexported
          let ring = "runtime/dir"
          Test.assert_eq(
            authority_case(authority, path, visibility, ring, true, "runtime_platform_dir"),
            0
          )
          Test.assert_eq(
            authority_case(authority, path, visibility, ring, true, "runtime_dir_list"),
            if not refused or authority_admitted { 0 } else { 2 }
          )
          Test.assert_eq(
            authority_case(authority, path, visibility, ring, true, "runtime_dir_raw"),
            if not refused { 0 } else { 1 }
          )
          Test.assert_eq(
            authority_case(
              authority,
              path,
              visibility,
              "runtime/dir_inspect",
              false,
              "interpreter_helper"
            ),
            if not refused or authority_admitted { 0 } else { 2 }
          )
          -- The same module strict and off the ring is ordinary code.
          Test.assert_eq(
            authority_case(authority, path, visibility, ring, false, "runtime_dir_raw"),
            0
          )
        }
      }
    }
    index = index + 1
  }
}

test "unlisted strict code installs a platform interpreter's handler" {
  let found = with platform_dir_inspect() {
    match dir.current() {
      Ok(_) -> 1
      Err(_) -> 0
    }
  }
  Test.assert_eq(found, 1)
}
