test "audit_accepts_clean_window" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(13, 1, 0))      -- gpos 0: tenant def in x13
  bu32(code, encode_movz(15, 2, 0))      -- gpos 1: scratch write, fine
  bu32(code, encode_add_reg(0, 13, 15))  -- gpos 2: tenant last use
  bu32(code, encode_ret())               -- gpos 3
  audit_probe_arm(fm, 13, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 778)
  Test.assert_eq(fmap_audit_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_skew_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 1)
  Test.assert_eq(fmap_audit_first_offset(fm), 0)
}

test "audit_flags_call_inside_volatile_window" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(14, 1, 0))      -- gpos 0: tenant def in x14
  bu32(code, encode_bl(64))              -- gpos 1: call clobbers the pool
  bu32(code, encode_add_reg(0, 14, 14))  -- gpos 2: tenant last use
  bu32(code, encode_ret())               -- gpos 3
  audit_probe_arm(fm, 14, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 779)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_first_offset(fm), 4)
  Test.assert_eq(fmap_audit_first_word(fm), encode_bl(64))
}

test "audit_flags_placeholder_word_inside_volatile_window" {
  -- An unpatched forward-call placeholder is a future BL: call clobber.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))
  bu32(code, 0)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  audit_probe_arm(fm, 12, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 780)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
}

test "audit_callee_saved_fp_window_survives_calls_but_not_writes" {
  -- d8 tenant: a call inside the window is transparent (callee-saved),
  -- a direct write to d8 is a violation counted in the cs bucket.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_fmov_d_from_x(8, 15))  -- gpos 0: tenant def d8
  bu32(code, encode_bl(64))                -- gpos 1: call, transparent
  bu32(code, encode_fadd_d(0, 8, 8))       -- gpos 2: tenant last use
  bu32(code, encode_ret())                 -- gpos 3
  audit_probe_arm(fm, 1008, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 781)
  Test.assert_eq(fmap_audit_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
  let fm2 = audit_probe_fm()
  let code2 = buf_new(4096)
  bu32(code2, encode_fmov_d_from_x(8, 15))
  bu32(code2, encode_fmov_d_from_d(8, 3))  -- foreign write to d8
  bu32(code2, encode_fadd_d(0, 8, 8))
  bu32(code2, encode_ret())
  audit_probe_arm(fm2, 1008, 0, 2)
  pipeline_ir_native_residency_audit_function(code2, fm2, 782)
  Test.assert_eq(fmap_audit_violation_count(fm2), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm2), 1)
  Test.assert_eq(fmap_audit_first_phys(fm2), 1008)
}

test "audit_flags_volatile_fp_pool_write_and_call" {
  -- d2 tenant (volatile FP pool): both a direct write and a call violate.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_fadd_d(2, 3, 4))     -- gpos 0: tenant def d2
  bu32(code, encode_fmov_d_from_x(2, 15)) -- gpos 1: foreign write to d2
  bu32(code, encode_fadd_d(0, 2, 2))     -- gpos 2: tenant last use
  bu32(code, encode_ret())               -- gpos 3
  audit_probe_arm(fm, 1002, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 783)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_first_phys(fm), 1002)
}

test "audit_unknown_word_violates_even_callee_saved_windows" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_fmov_d_from_x(9, 15))  -- gpos 0: tenant def d9
  bu32(code, 3)                            -- gpos 1: garbage word
  bu32(code, encode_fadd_d(0, 9, 9))       -- gpos 2: tenant last use
  bu32(code, encode_ret())                 -- gpos 3
  audit_probe_arm(fm, 1009, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 784)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 1)
}

test "audit_nested_emission_range_clobbers_volatile_preserves_cs" {
  -- A nested inline function body (recorded by the lambda guard) behaves
  -- like a call: volatile windows spanning it are violations, callee-saved
  -- FP windows are not, and its words are never decoded directly.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))      -- gpos 0: tenant def
  bu32(code, encode_movz(15, 2, 0))      -- gpos 1: nested body sits here
  bu32(code, encode_add_reg(0, 12, 12))  -- gpos 2: tenant last use
  bu32(code, encode_ret())               -- gpos 3
  audit_probe_arm(fm, 12, 0, 2)
  nlist_add(fmap_audit_nested(fm), node_new(0, 4, 8, 0, 0))
  pipeline_ir_native_residency_audit_function(code, fm, 785)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  let fm2 = audit_probe_fm()
  let code2 = buf_new(4096)
  bu32(code2, encode_fmov_d_from_x(10, 15))
  bu32(code2, 3)                           -- nested body word, never decoded
  bu32(code2, encode_fadd_d(0, 10, 10))
  bu32(code2, encode_ret())
  audit_probe_arm(fm2, 1010, 0, 2)
  nlist_add(fmap_audit_nested(fm2), node_new(0, 4, 8, 0, 0))
  pipeline_ir_native_residency_audit_function(code2, fm2, 786)
  Test.assert_eq(fmap_audit_violation_count(fm2), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm2), 0)
}

test "audit_numbering_skew_is_counted_not_trusted" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))
  bu32(code, encode_movz(12, 2, 0))
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  audit_probe_arm(fm, 12, 0, 2)
  fmap_set_audit_expected_gpos(fm, 9)  -- ledger disagrees with the scan
  pipeline_ir_native_residency_audit_function(code, fm, 787)
  Test.assert_eq(fmap_audit_skew_count(fm), 1)
  Test.assert_eq(fmap_audit_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 0)
}

test "audit_param_window_exempts_writer_terminator_writes" {
  -- A block-param tenant in x12: the predecessor jump's edge move at
  -- gpos 2 writes x12 legally; the same write outside a writer window
  -- is a violation.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(15, 1, 0))       -- gpos 0
  bu32(code, encode_add_reg(0, 12, 15))   -- gpos 1: tenant use
  bu32(code, encode_add_imm(12, 15, 0))   -- gpos 2: writer terminator edge move
  bu32(code, encode_ret())                -- gpos 3
  let writers = nlist_new()
  nlist_add(writers, 2)
  audit_probe_arm_writers(fm, 12, 0, 3, writers)
  pipeline_ir_native_residency_audit_function(code, fm, 790)
  Test.assert_eq(fmap_audit_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 1)
}

test "audit_param_window_flags_write_outside_writer_windows" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(15, 1, 0))       -- gpos 0
  bu32(code, encode_add_imm(12, 15, 0))   -- gpos 1: foreign write, NOT a writer
  bu32(code, encode_add_reg(0, 12, 12))   -- gpos 2: tenant use
  bu32(code, encode_ret())                -- gpos 3: the only legal writer
  let writers = nlist_new()
  nlist_add(writers, 3)
  audit_probe_arm_writers(fm, 12, 0, 3, writers)
  pipeline_ir_native_residency_audit_function(code, fm, 791)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_first_offset(fm), 4)
  Test.assert_eq(fmap_audit_first_word(fm), encode_add_imm(12, 15, 0))
}

test "audit_param_window_includes_its_first_gpos" {
  -- Param windows start AT lo (no def instruction): a foreign write in
  -- the very first covered instruction is caught.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(13, 9, 0))       -- gpos 0: foreign write at window start
  bu32(code, encode_add_reg(0, 13, 13))   -- gpos 1: tenant use
  bu32(code, encode_add_imm(13, 15, 0))   -- gpos 2: writer terminator
  bu32(code, encode_ret())                -- gpos 3
  let writers = nlist_new()
  nlist_add(writers, 2)
  audit_probe_arm_writers(fm, 13, 0, 2, writers)
  pipeline_ir_native_residency_audit_function(code, fm, 792)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_first_offset(fm), 0)
}

test "audit_state_clears_after_each_function" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))
  bu32(code, encode_movz(15, 2, 0))
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  audit_probe_arm(fm, 12, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 788)
  Test.assert_eq(fmap_audit_ranges(fm), 0)
  Test.assert_eq(fmap_audit_offsets(fm), 0)
  Test.assert_eq(fmap_audit_nested(fm), 0)
}

-- Probe programs through the full audited pipeline: the campaign's loop,
-- guard-chain, sort, and f64 shapes, emitted with the audit armed. Every
-- probe must check at least one tenant window and find zero violations.

fn audit_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module_with_audit(typed, optimised, 1)
}

fn audit_positive(count: i64) -> i64 {
  if count > 0 { 1 } else { 0 }
}

fn audit_assert_clean(native: NativeModule) -[Test]> i64 {
  Test.assert_eq(pipeline_native_residency_audit_violation_count(native), 0)
  Test.assert_eq(pipeline_native_residency_audit_cs_violation_count(native), 0)
  Test.assert_eq(pipeline_native_residency_audit_skew_count(native), 0)
  -- On failure these carry the diagnosis: function hash, byte offset,
  -- the clobbering word, and the tenant register.
  Test.assert_eq(pipeline_native_residency_audit_first_fn_hash(native), 0)
  Test.assert_eq(pipeline_native_residency_audit_first_offset(native), 0)
  Test.assert_eq(pipeline_native_residency_audit_first_word(native), 0)
  Test.assert_eq(pipeline_native_residency_audit_first_phys(native), 0)
  0
}

test "audit_pressure_program_clean_with_tenants_checked" {
  let src = "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; a + b + c + d + e + f + g + h + i + j + k + l } fn main() -> i64 { work(1, 2) }"
  let native = audit_native(src)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_residency_audit_checked_count(native)), 1)
}

test "audit_loop_program_clean" {
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let len = vector_len(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let native = audit_native(src)
  audit_assert_clean(native)
}

test "audit_sort_program_clean" {
  let src = "use \"stdlib/vector.weft\" fn sortit(items: i64) -> i64 { let len = vector_len(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  let native = audit_native(src)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_residency_audit_checked_count(native)), 1)
}

test "audit_f64_program_clean" {
  let src = "fn f(a: f64, b: f64, n: i64) -> f64 { let mut s = 0.0 let mut i = 0 while i < n { let x = a * b + s let y = x * x - a s = s + y / (x + 1.0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let native = audit_native(src)
  audit_assert_clean(native)
}

test "audit_block_param_tenants_pinned_and_clean" {
  -- A pure if/else merge feeding pure arithmetic across a second
  -- branch: the merge param's window is barrier-free and spans blocks
  -- (jump-chain merging cannot fuse the branch), so it must join the
  -- x12-x14 pool (2o step 1) and its windows must audit clean.
  let src = "fn pick(a: i64, b: i64, flag: i64) -> i64 { let c = if flag == 1 { a + b } else { a - b } let d = if flag == 2 { c + a } else { c + b } d + c } fn main() -> i64 { pick(1, 2, 1) }"
  let native = audit_native(src)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_ir_param_resident_count(native)), 1)
}

-- Regression lock for the loop-rounding bug (2o step 1): a min-merge
-- param feeding a loop bound, with a real call in the loop body. Without
-- loop rounding the param's window ended AT the loop condition, the call
-- result inside the body took the same pool register, and the second
-- iteration compared against garbage (the check_handler_clause
-- miscompile). This test executes the shape in the suite-compiled binary.
fn audit_helper_tri(x: i64) -> i64 {
  if x <= 0 { 0 } else { x + audit_helper_tri(x - 1) }
}

fn audit_loop_bound_shape(nparams: i64, noparams: i64) -> i64 {
  let nbind = if nparams < noparams { nparams } else { noparams }
  let mut acc = 0
  for pi in 0..nbind {
    acc = acc + audit_helper_tri(pi)
  }
  acc * 1000 + nbind
}

test "audit_loop_bound_merge_param_survives_loop_body" {
  Test.assert_eq(audit_loop_bound_shape(3, 5), 4003)
  Test.assert_eq(audit_loop_bound_shape(7, 2), 1002)
  Test.assert_eq(audit_loop_bound_shape(0, 9), 0)
  Test.assert_eq(audit_loop_bound_shape(9, 0), 0)
}

fn audit_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "audit_whole_compiler_emission_clean" {
  -- The permanent tripwire: the compiler's own emitted code, with every
  -- pool tenancy checked at the byte level. Any pass or emission change
  -- that writes a residency register across a tenant window fails here.
  let file = read_file(audit_path_pair("compiler/main.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let native = pipeline_lower_native_module_with_audit(typed, optimised, 1)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_residency_audit_checked_count(native) - 100), 1)
  Test.assert_eq(audit_positive(pipeline_native_ir_param_resident_count(native)), 1)
}

test "audit_callee_saved_gpr_window_survives_calls_but_not_writes" {
  -- x23 tenant (2l stage 3 home reuse): a call inside the window is
  -- transparent (every emitted callee saves the pairs it touches), a
  -- direct write to x23 is a violation counted in the cs bucket.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(23, 1, 0))       -- gpos 0: tenant def x23
  bu32(code, encode_bl(64))               -- gpos 1: call, transparent
  bu32(code, encode_add_reg(0, 23, 23))   -- gpos 2: tenant last use
  bu32(code, encode_ret())                -- gpos 3
  audit_probe_arm(fm, 23, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 783)
  Test.assert_eq(fmap_audit_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 1)
  let fm2 = audit_probe_fm()
  let code2 = buf_new(4096)
  bu32(code2, encode_movz(23, 1, 0))
  bu32(code2, encode_movz(23, 2, 0))      -- foreign write to x23
  bu32(code2, encode_add_reg(0, 23, 23))
  bu32(code2, encode_ret())
  audit_probe_arm(fm2, 23, 0, 2)
  pipeline_ir_native_residency_audit_function(code2, fm2, 784)
  Test.assert_eq(fmap_audit_violation_count(fm2), 0)
  Test.assert_eq(fmap_audit_cs_violation_count(fm2), 1)
  Test.assert_eq(fmap_audit_first_phys(fm2), 23)
}

test "audit_volatile_pool_still_flags_calls_after_cs_gpr_arm" {
  -- The x19-x26 exemption must not leak into the caller-saved pools:
  -- a BL inside an x12 window stays a violation.
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))
  bu32(code, encode_bl(64))
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  audit_probe_arm(fm, 12, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 785)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
}

test "audit_cs_home_reuse_shape_clean_end_to_end" {
  -- The cs cross-call shape through the full audited pipeline: the
  -- callee-saved tenancy's window is byte-decoded and must be clean.
  let src = "fn csh(x: i64) -> i64 { if x > 100 { x - 1 } else { if x < 0 - 1000000 { csh(x + 1) } else { x + 1 } } } fn work(a: i64, b: i64) -> i64 { let t1 = a + b; let t2 = t1 + a; let t3 = t2 + b; let t4 = t3 + t1; let t5 = t4 + t2; let t6 = t5 + t3; let keep = t6 + a; let c1 = csh(a); let c2 = csh(b); keep + c1 + c2 } fn main() -> i64 { work(6, 7) }"
  let native = audit_native(src)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_ir_cs_resident_count(native)), 1)
}

test "audit_cs_param_tenant_crosses_call_clean" {
  -- A merge param used after a call: the volatile param path rejects
  -- the barrier-crossing window, the callee-saved pool takes it, and
  -- the audited window must be clean end-to-end.
  let src = "fn csh2(x: i64) -> i64 { if x > 100 { x - 1 } else { if x < 0 - 1000000 { csh2(x + 1) } else { x + 1 } } } fn pick2(a: i64, b: i64, flag: i64) -> i64 { let t1 = a + b; let t2 = t1 + a; let t3 = t2 + b; let t4 = t3 + t1; let t5 = t4 + t2; let t6 = t5 + t3; let c = if flag == 1 { t6 + a } else { t6 - b }; let d = csh2(a); let e = csh2(b); c + d + e } fn main() -> i64 { pick2(6, 7, 1) }"
  let native = audit_native(src)
  audit_assert_clean(native)
  Test.assert_eq(audit_positive(pipeline_native_ir_param_resident_count(native)), 1)
}
