  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(8, 1, 0))      -- gpos 0: tenant def
  bu32(code, encode_movz(8, 2, 0))      -- gpos 1: foreign write to x8
  bu32(code, encode_add_reg(0, 8, 8))   -- gpos 2: tenant last use
  bu32(code, encode_ret())              -- gpos 3: terminator
  audit_probe_arm(fm, 8, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 776)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_skew_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 1)
  Test.assert_eq(fmap_audit_first_fn_hash(fm), 776)
  Test.assert_eq(fmap_audit_first_offset(fm), 4)
  Test.assert_eq(fmap_audit_first_word(fm), encode_movz(8, 2, 0))
  Test.assert_eq(fmap_audit_first_phys(fm), 8)
}

