-- test/emission_audit_metrics.weft -- the emission-level residency audit
-- (2o step 1 prerequisite). The IR verifier validates structure one layer
-- up; this validates the layer the 2o experiments died in: the emitted
-- code buffer against the pinned residency map. Coverage:
--   1. decoder round-trips for every encoder the emission vocabulary has
--   2. hand-built windows pinning each checker verdict (foreign write,
--      clean window, call clobber, callee-saved transparency, unknown
--      word, nested-emission ranges, numbering skew)
--   3. probe programs through the full audited pipeline
--   4. THE WHOLE COMPILER emitted under audit: zero violations, zero skew

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/unsafe.weft"

test "audit_decoder_gpr_writes" {
  Test.assert_eq(decode_writes_aarch64(encode_movz(13, 7, 0)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_movk(12, 65535, 48)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_movn(14, 0)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_add_imm(12, 31, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_sub_imm(13, 13, 1)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_add_reg(14, 15, 16)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_sub_reg(12, 13, 14)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_mul(13, 12, 14)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_sdiv(12, 15, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_udiv(14, 15, 16)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_msub(13, 15, 16, 17)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_and_reg(12, 15, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_orr_reg(13, 31, 15)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_eor_reg(14, 15, 16)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_lsl_reg(12, 15, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_asr_reg(13, 15, 16)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_lsr_reg(14, 15, 16)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_ldaxr(12, 15)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_stlxr(12, 15, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_stlr(12, 15)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_cmp(12, 13)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_cset(13, 0)), 8192)
}

test "audit_decoder_fp_and_convert_writes" {
  Test.assert_eq(decode_writes_aarch64(encode_fmov_d_from_x(2, 15)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_fmov_x_from_d(12, 2)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_fmov_d_from_d(3, 4)), 34359738368)
  Test.assert_eq(decode_writes_aarch64(encode_fmov_s_from_w(5, 15)), 137438953472)
  Test.assert_eq(decode_writes_aarch64(encode_fmov_w_from_s(13, 5)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_fmov_s_from_s(6, 7)), 274877906944)
  Test.assert_eq(decode_writes_aarch64(encode_sxtw(12, 15)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_sxtb(13, 15)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_sxth(14, 15)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_uxtb(12, 15)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_uxth(13, 15)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_uxtw(14, 15)), 16384)
  Test.assert_eq(decode_writes_aarch64(encode_scvtf_d_from_x(2, 15)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_ucvtf_d_from_x(3, 15)), 34359738368)
  Test.assert_eq(decode_writes_aarch64(encode_fcvtzs_x_from_d(12, 2)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_scvtf_s_from_x(4, 15)), 68719476736)
  Test.assert_eq(decode_writes_aarch64(encode_ucvtf_s_from_x(5, 15)), 137438953472)
  Test.assert_eq(decode_writes_aarch64(encode_fcvtzs_x_from_s(13, 4)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_fcvt_d_from_s(2, 5)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_fcvt_s_from_d(5, 2)), 137438953472)
  Test.assert_eq(decode_writes_aarch64(encode_fadd_d(2, 3, 4)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_fsub_d(3, 4, 5)), 34359738368)
  Test.assert_eq(decode_writes_aarch64(encode_fmul_d(4, 5, 6)), 68719476736)
  Test.assert_eq(decode_writes_aarch64(encode_fdiv_d(5, 6, 7)), 137438953472)
  Test.assert_eq(decode_writes_aarch64(encode_fcmp_d(2, 3)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_fsqrt_d(6, 7)), 274877906944)
  Test.assert_eq(decode_writes_aarch64(encode_fadd_s(2, 3, 4)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_fsub_s(3, 4, 5)), 34359738368)
  Test.assert_eq(decode_writes_aarch64(encode_fmul_s(4, 5, 6)), 68719476736)
  Test.assert_eq(decode_writes_aarch64(encode_fdiv_s(5, 6, 7)), 137438953472)
  Test.assert_eq(decode_writes_aarch64(encode_fcmp_s(2, 3)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_fsqrt_s(7, 8)), 549755813888)
}

test "audit_decoder_branch_mem_and_special_writes" {
  Test.assert_eq(decode_writes_aarch64(encode_b(1024)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_b(0 - 1024)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_b_cond(0 - 64, 1)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_bl(2048)), 281476050452480)
  Test.assert_eq(decode_writes_aarch64(encode_bl(0 - 2048)), 281476050452480)
  Test.assert_eq(decode_writes_aarch64(encode_ret()), 0)
  Test.assert_eq(decode_writes_aarch64(encode_stp_pre(19, 20, 31, 0 - 16)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_stp_d_pre(8, 9, 31, 0 - 16)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_ldp_post(29, 30, 31, 16)), 1610612736)
  Test.assert_eq(decode_writes_aarch64(encode_ldp_post(12, 13, 31, 16)), 12288)
  Test.assert_eq(decode_writes_aarch64(encode_ldp_d_post(8, 9, 31, 16)), 3298534883328)
  Test.assert_eq(decode_writes_aarch64(encode_str(12, 31, 8)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_ldr(12, 31, 8)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_strb(12, 15, 3)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_ldrb(13, 15, 3)), 8192)
  Test.assert_eq(decode_writes_aarch64(encode_adrp(12, 0 - 2)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_adr(17, 0 - 8)), 131072)
  Test.assert_eq(decode_writes_aarch64(encode_svc()), 281474976710659)
  Test.assert_eq(decode_writes_aarch64(encode_brk(20)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_ldr_reg_lsl3(12, 15, 16)), 4096)
  Test.assert_eq(decode_writes_aarch64(encode_ldr_d_reg_lsl3(2, 15, 16)), 17179869184)
  Test.assert_eq(decode_writes_aarch64(encode_str_reg_lsl3(12, 15, 16)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_str_d_reg_lsl3(2, 15, 16)), 0)
  Test.assert_eq(decode_writes_aarch64(encode_blr(16)), 281476050452480)
  Test.assert_eq(decode_writes_aarch64(3019898880 + 32 + 14), 0)
  -- unpatched placeholder and garbage words
  Test.assert_eq(decode_writes_aarch64(0), decode_writes_call_clobber_bit())
  Test.assert_eq(decode_writes_aarch64(3), decode_writes_unknown_bit())
}

-- Hand-built checker windows. Each builds a tiny code buffer plus the
-- ledger the emission hooks would have produced, runs the checker, and
-- pins the verdict counters and first-violation detail.

fn audit_probe_fm() -> i64 {
  let fm = fmap_new()
  fmap_set_audit_mode(fm, 1)
  fm
}

fn audit_probe_offsets_5() -> i64 {
  -- Four gpos entries (three insts + terminator) and the end sentinel.
  let offsets = nlist_new()
  nlist_add(offsets, 0)
  nlist_add(offsets, 4)
  nlist_add(offsets, 8)
  nlist_add(offsets, 12)
  nlist_add(offsets, 16)
  offsets
}

fn audit_probe_arm_writers(fm: i64, phys: i64, dp: i64, lu: i64, writers: i64) -> i64 {
  let ranges = nlist_new()
  nlist_add(ranges, node_new(0, phys, dp, lu, writers))
  fmap_set_audit_ranges(fm, ranges)
  fmap_set_audit_offsets(fm, audit_probe_offsets_5())
  fmap_set_audit_nested(fm, nlist_new())
  fmap_set_audit_expected_gpos(fm, 4)
  0
}

fn audit_probe_arm(fm: i64, phys: i64, dp: i64, lu: i64) -> i64 {
  audit_probe_arm_writers(fm, phys, dp, lu, 0)
}

test "audit_flags_foreign_write_to_pool_register_in_window" {
  let fm = audit_probe_fm()
  let code = buf_new(4096)
  bu32(code, encode_movz(12, 1, 0))      -- gpos 0: tenant def
  bu32(code, encode_movz(12, 2, 0))      -- gpos 1: foreign write to x12
  bu32(code, encode_add_reg(0, 12, 12))  -- gpos 2: tenant last use
  bu32(code, encode_ret())               -- gpos 3: terminator
  audit_probe_arm(fm, 12, 0, 2)
  pipeline_ir_native_residency_audit_function(code, fm, 777)
  Test.assert_eq(fmap_audit_violation_count(fm), 1)
  Test.assert_eq(fmap_audit_cs_violation_count(fm), 0)
  Test.assert_eq(fmap_audit_skew_count(fm), 0)
  Test.assert_eq(fmap_audit_checked_count(fm), 1)
  Test.assert_eq(fmap_audit_first_fn_hash(fm), 777)
  Test.assert_eq(fmap_audit_first_offset(fm), 4)
  Test.assert_eq(fmap_audit_first_word(fm), encode_movz(12, 2, 0))
  Test.assert_eq(fmap_audit_first_phys(fm), 12)
}

