use compiler/backend/aarch64/encode.{*}
use stdlib/test.{Test}

test "scalar memory words agree with the independent AArch64 assembler" {
  Test.assert_eq(encode_ldrb(13, 14, 7), 960503245)
  Test.assert_eq(encode_ldrh(13, 14, 14), 2034245069)
  Test.assert_eq(encode_ldr_w(13, 14, 28), 3107986893)
  Test.assert_eq(encode_ldr(13, 14, 56), 4181728717)
  Test.assert_eq(encode_strb(13, 14, 7), 956308941)
  Test.assert_eq(encode_strh(13, 14, 14), 2030050765)
  Test.assert_eq(encode_str_w(13, 14, 28), 3103792589)
  Test.assert_eq(encode_str(13, 14, 56), 4177534413)
}

test "scalar memory loads expose exact source and destination registers at every width" {
  for destination in 0..32 {
    for base in 0..32 {
      for word in [encode_ldrb(destination, base, 0), encode_ldrb(destination, base, 4095),
        encode_ldrh(destination, base, 0), encode_ldrh(destination, base, 8190),
        encode_ldr_w(destination, base, 0), encode_ldr_w(destination, base, 16380),
        encode_ldr(destination, base, 0), encode_ldr(destination, base, 32760)] {
        Test.assert_eq(decode_writes_aarch64(word), decode_writes_gpr_bit(destination))
        Test.assert_eq(decode_reads_aarch64(word), decode_writes_gpr_bit(base))
      }
    }
  }
}

test "scalar memory stores expose both read operands without writing either register" {
  for source in 0..32 {
    for base in 0..32 {
      for word in [encode_strb(source, base, 0), encode_strb(source, base, 4095),
        encode_strh(source, base, 0), encode_strh(source, base, 8190),
        encode_str_w(source, base, 0), encode_str_w(source, base, 16380),
        encode_str(source, base, 0), encode_str(source, base, 32760)] {
        Test.assert_eq(decode_writes_aarch64(word), 0)
        Test.assert_eq(decode_reads_aarch64(word), decode_writes_gpr_bit(source) bor decode_writes_gpr_bit(base))
      }
    }
  }
}

test "unsigned-offset scalar decoding does not admit SIMD or signed-extending load encodings" {
  for word in [1027604514, 2101346338, 3175088162, 4248829986, 964689954, 2038431778, 3112173602] {
    Test.assert_eq(decode_writes_aarch64(word), decode_writes_unknown_bit())
    Test.assert_eq(decode_reads_aarch64(word), decode_writes_unknown_bit())
  }
}
