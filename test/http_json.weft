use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpMethod, HttpPost, HttpRequestHead}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady}
use stdlib/http/json as http_json
use stdlib/http/json.{HttpJsonBodyStopped, HttpJsonInvalidDocument, HttpJsonInvalidLimit, HttpJsonNonFiniteNumber, HttpJsonReadFailed, HttpJsonReaderReady, HttpJsonReaderRejected, HttpJsonReady, HttpJsonStopped, HttpJsonTooLarge, HttpJsonWriteRejected, HttpJsonWriteStopped, HttpJsonWritten}
use stdlib/http/replay as http_replay
use stdlib/http/replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay}
use stdlib/http/stream as http_stream
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/json as json
use stdlib/json.{JsonFloat}
use stdlib/num.{num_f64_from_bits}
use stdlib/option.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url

fn http_json_test_request(method: HttpMethod, length: str) -> HttpRequestHead {
  let headers = http.headers().append(
    http.header(http.parse_field_name("Host").unwrap(), bytes.from_str("example.com")).unwrap()
  ).append(
    http.header(http.parse_field_name("Content-Length").unwrap(), bytes.from_str(length)).unwrap()
  )
  http.request(
    method,
    http.parse_request_target("/json").unwrap(),
    Http11,
    headers,
    http.default_limits()
  ).unwrap()
}

fn http_json_test_fixture(input: Bytes, expected: Bytes) -> HttpReplayFixture {
  http_replay.fixture(
    input,
    expected,
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

fn http_json_test_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpPost, "4"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match body.write_json(JsonFloat(1.25)) {
      HttpJsonWriteRejected(returned, error) -> 2
      HttpJsonWriteStopped(returned, error) -> 3
      HttpJsonWritten(writer) -> match writer.finish(http.headers()) {
        HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
          connection,
          HttpPost,
          http.default_limits()
        ) {
          HttpClientResponseFailed(error) -> 4
          HttpClientResponseReady(head, response_body) -> match http_json.reader(response_body, 32) {
            HttpJsonReaderReady(reader) -> match reader.read() {
              HttpJsonReady(returned, document) -> {
                let exact = document.value().as_f64().unwrap_or(0.0) == 1.5 and
                  document.trailers().len() == 0
                match returned.close() {
                  Ok(done) -> if exact { 0 } else { 5 }
                  Err(error) -> 6
                }
              }
              _ -> 7
            }
            _ -> 8
          }
        }
        _ -> 9
      }
    }
  }
}

fn http_json_test_invalid_limit(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestReady(body) -> match http_json.reader(body, 0) {
      HttpJsonReaderRejected(returned, HttpJsonInvalidLimit(0)) -> match returned.cancel() {
        Ok(done) -> 0
        Err(error) -> 1
      }
      _ -> 2
    }
    _ -> 3
  }
}

fn http_json_test_invalid_document(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseReady(head, body) -> match http_json.reader(body, 16) {
          HttpJsonReaderReady(reader) -> match reader.read() {
            HttpJsonStopped(returned, failure) -> match failure.error() {
              HttpJsonInvalidDocument(position) -> match returned.close() {
                Ok(done) -> if failure.trailers().len() == 0 { position } else { 12 }
                Err(error) -> 9
              }
              _ -> match returned.close() {
                Ok(done) -> 10
                Err(error) -> 11
              }
            }
            _ -> 8
          }
          _ -> 7
        }
        _ -> 6
      }
      _ -> 5
    }
    _ -> 4
  }
}

fn http_json_test_too_large(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseReady(head, body) -> match http_json.reader(body, 3) {
          HttpJsonReaderReady(reader) -> match reader.read() {
            HttpJsonBodyStopped(returned, HttpJsonTooLarge(size)) -> match returned.cancel() {
              Ok(done) -> size
              Err(error) -> 9
            }
            _ -> 8
          }
          _ -> 7
        }
        _ -> 6
      }
      _ -> 5
    }
    _ -> 4
  }
}

fn http_json_test_nonfinite_write(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpPost, "0"),
    http.default_limits()
  ) {
    HttpClientRequestReady(body) -> match body.write_json(
      JsonFloat(num_f64_from_bits(9218868437227405312))
    ) {
      HttpJsonWriteRejected(returned, HttpJsonNonFiniteNumber) -> match returned.cancel() {
        Ok(done) -> 0
        Err(error) -> 1
      }
      _ -> 2
    }
    _ -> 3
  }
}

test "bounded HTTP JSON writes and reads complete finite numbers" {
  let fixture = http_json_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\n1.5"),
    bytes.from_str("POST /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 4\r\n\r\n1.25")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_exchange), 0)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "HTTP JSON rejects a non-positive bound without consuming the body" {
  let fixture = http_json_test_fixture(
    bytes.from_str(""),
    bytes.from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_invalid_limit), 0)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "invalid HTTP JSON preserves the completed reusable connection" {
  let fixture = http_json_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\n[1,"),
    bytes.from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_invalid_document), 3)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "HTTP JSON size failure returns the exact unfinished body for cancellation" {
  let fixture = http_json_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 4\r\n\r\nnull"),
    bytes.from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_too_large), 4)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "HTTP JSON rejects non-finite output before consuming its body" {
  let fixture = http_json_test_fixture(
    bytes.from_str(""),
    bytes.from_str("POST /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_nonfinite_write), 0)
  Test.assert_eq(fixture.stats().closes, 1)
}
