use stdlib/bytes.{Bytes, bytes_from_str}
use stdlib/http.{Http11, HttpGet, HttpMethod, HttpPost, HttpRequestHead, http_default_limits, http_field_name_parse, http_header, http_headers_append, http_headers_empty, http_request_head_new, http_request_target_parse}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady}
use stdlib/http/json.{HttpJsonBodyStopped, HttpJsonInvalidDocument, HttpJsonInvalidLimit, HttpJsonNonFiniteNumber, HttpJsonReadFailed, HttpJsonReaderReady, HttpJsonReaderRejected, HttpJsonReady, HttpJsonStopped, HttpJsonTooLarge, HttpJsonWriteRejected, HttpJsonWriteStopped, HttpJsonWritten, http_json_document_value, http_json_failure_error, http_json_read, http_json_reader, http_json_write}
use stdlib/http/replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay, http_replay_fixture, http_replay_stats}
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO, http_body_cancel, http_body_finish, http_connection_close}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/json.{json_float, json_float_value}
use stdlib/num.{num_f64_from_bits}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url

fn http_json_test_request(method: HttpMethod, length: str) -> HttpRequestHead {
  let headers = http_headers_append(
    http_headers_append(
      http_headers_empty(),
      http_header(http_field_name_parse("Host").unwrap(), bytes_from_str("example.com")).unwrap()
    ),
    http_header(http_field_name_parse("Content-Length").unwrap(), bytes_from_str(length)).unwrap()
  )
  http_request_head_new(
    method,
    http_request_target_parse("/json").unwrap(),
    Http11,
    headers,
    http_default_limits()
  ).unwrap()
}

fn http_json_test_fixture(input: Bytes, expected: Bytes) -> HttpReplayFixture {
  http_replay_fixture(
    input,
    expected,
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

fn http_json_test_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpPost, "4"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match http_json_write(body, json_float(1.25)) {
      HttpJsonWriteRejected(returned, error) -> 2
      HttpJsonWriteStopped(returned, error) -> 3
      HttpJsonWritten(writer) -> match http_body_finish(writer, http_headers_empty()) {
        HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
          connection,
          HttpPost,
          http_default_limits()
        ) {
          HttpClientResponseFailed(error) -> 4
          HttpClientResponseReady(head, response_body) -> match http_json_reader(response_body, 32) {
            HttpJsonReaderReady(reader) -> match http_json_read(reader) {
              HttpJsonReady(returned, document) -> {
                let exact = json_float_value(http_json_document_value(document), 0.0) == 1.5
                match http_connection_close(returned) {
                  Ok(done) -> if exact { 0 } else { 5 }
                  Err(error) -> 6
                }
              }
              _ -> 7
            }
            _ -> 8
          }
        }
        _ -> 9
      }
    }
  }
}

fn http_json_test_invalid_limit(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestReady(body) -> match http_json_reader(body, 0) {
      HttpJsonReaderRejected(returned, HttpJsonInvalidLimit(0)) -> match http_body_cancel(returned) {
        Ok(done) -> 0
        Err(error) -> 1
      }
      _ -> 2
    }
    _ -> 3
  }
}

fn http_json_test_invalid_document(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientResponseReady(head, body) -> match http_json_reader(body, 16) {
          HttpJsonReaderReady(reader) -> match http_json_read(reader) {
            HttpJsonStopped(returned, failure) -> match http_json_failure_error(failure) {
              HttpJsonInvalidDocument(position) -> match http_connection_close(returned) {
                Ok(done) -> position
                Err(error) -> 9
              }
              _ -> match http_connection_close(returned) {
                Ok(done) -> 10
                Err(error) -> 11
              }
            }
            _ -> 8
          }
          _ -> 7
        }
        _ -> 6
      }
      _ -> 5
    }
    _ -> 4
  }
}

fn http_json_test_too_large(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientResponseReady(head, body) -> match http_json_reader(body, 3) {
          HttpJsonReaderReady(reader) -> match http_json_read(reader) {
            HttpJsonBodyStopped(returned, HttpJsonTooLarge(size)) -> match http_body_cancel(returned) {
              Ok(done) -> size
              Err(error) -> 9
            }
            _ -> 8
          }
          _ -> 7
        }
        _ -> 6
      }
      _ -> 5
    }
    _ -> 4
  }
}

fn http_json_test_nonfinite_write(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/json").unwrap(),
    http_json_test_request(HttpPost, "0"),
    http_default_limits()
  ) {
    HttpClientRequestReady(body) -> match http_json_write(
      body,
      json_float(num_f64_from_bits(9218868437227405312))
    ) {
      HttpJsonWriteRejected(returned, HttpJsonNonFiniteNumber) -> match http_body_cancel(returned) {
        Ok(done) -> 0
        Err(error) -> 1
      }
      _ -> 2
    }
    _ -> 3
  }
}

test "bounded HTTP JSON writes and reads complete finite numbers" {
  let fixture = http_json_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\n1.5"),
    bytes_from_str("POST /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 4\r\n\r\n1.25")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_exchange), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "HTTP JSON rejects a non-positive bound without consuming the body" {
  let fixture = http_json_test_fixture(
    bytes_from_str(""),
    bytes_from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_invalid_limit), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "invalid HTTP JSON preserves the completed reusable connection" {
  let fixture = http_json_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\n[1,"),
    bytes_from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_invalid_document), 3)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "HTTP JSON size failure returns the exact unfinished body for cancellation" {
  let fixture = http_json_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 4\r\n\r\nnull"),
    bytes_from_str("GET /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_too_large), 4)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "HTTP JSON rejects non-finite output before consuming its body" {
  let fixture = http_json_test_fixture(
    bytes_from_str(""),
    bytes_from_str("POST /json HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, http_json_test_nonfinite_write), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}
