use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/comptime as comptime
use stdlib/diagnostic/schema.{*}
use stdlib/file.{FileRead}
use stdlib/grammar.{Grammar, CheckedGrammar, Parsed, Recovered, Rejected, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/schema as sql_schema
use stdlib/grammar/sql/schema.{*}
use stdlib/grammar/sql/schema_typecheck as schema_types
use stdlib/io/types.{IoError, IoNotFound}
use stdlib/list.{Cons, Nil}
use stdlib/option.{None}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/source.{Source}
use stdlib/state as state
use stdlib/typecheck.{TypeCheck, TypeName, ForeignTypeIdentity}

fn sql_schema_test_path() -> Path {
  path.from_utf8("schema/database.json").unwrap()
}

fn sql_schema_test_load(source: str) -> comptime.ComptimeEvaluation<Result<SqlSchema, SqlSchemaError>> {
  handle comptime.observe_file_reads(() => sql_schema.load(sql_schema_test_path(), 4096)) {
    FileRead.read_all(actual, limit) -> resume(Ok<Bytes, IoError>(bytes.from_str(source)))
  }
}

fn sql_schema_test_check(schema: SqlSchema, query: str) -> (CheckResult<SqlPlan<schema_types.SqlSchemaIdentity>>, i64) {
  let source = Source { text: query, identity: DiagnosticSourceNamed("schema-query.sql") }
  state.run(0, () => handle with schema_types(schema) {
    match sql.grammar().parse(source.all()) {
      Parsed(syntax) -> sql_check.checker<schema_types.SqlSchemaIdentity>().check(syntax)
      Recovered(_) -> CheckRejected<SqlPlan<schema_types.SqlSchemaIdentity>>()
      Rejected -> CheckRejected<SqlPlan<schema_types.SqlSchemaIdentity>>()
    }
  } {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

fn sql_schema_error_kind(error: SqlSchemaError) -> i64 {
  match error {
    SqlSchemaReadFailed(_) -> 1
    SqlSchemaJsonInvalid(_) -> 2
    SqlSchemaRootObjectRequired -> 3
    SqlSchemaRootMemberRequired(_) -> 4
    SqlSchemaVersionUnsupported -> 5
    SqlSchemaTablesObjectRequired -> 6
    SqlSchemaTableNameEmpty -> 7
    SqlSchemaTableRepeated(_) -> 8
    SqlSchemaTableObjectRequired(_) -> 9
    SqlSchemaTableEmpty(_) -> 10
    SqlSchemaFieldNameEmpty(_) -> 11
    SqlSchemaFieldRepeated(_, _) -> 12
    SqlSchemaFieldTypeUnsupported(_, _) -> 13
  }
}

fn sql_schema_parse_error_kind(source: str) -> i64 {
  match sql_schema.parse(source) {
    Ok(_) -> 0
    Err(error) -> sql_schema_error_kind(error)
  }
}

test "compile-time schema loading records exact source and preserves declaration order" {
  let document = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"name\":\"str\",\"active\":\"bool\"},\"orders\":{\"id\":\"i64\"}}}"
  let evaluation = sql_schema_test_load(document)
  match evaluation.value {
    Err(_) -> Test.assert_true(false)
    Ok(schema) -> match schema.tables {
      Cons({ name: first, fields: Cons({ name: first_field, value: SqlSchemaInteger }, Cons({ name: second_field, value: SqlSchemaText }, Cons({ name: third_field, value: SqlSchemaBoolean }, Nil))) }, Cons({ name: second, fields: _ }, Nil)) -> {
        Test.assert_str_eq(first, "users")
        Test.assert_str_eq(first_field, "id")
        Test.assert_str_eq(second_field, "name")
        Test.assert_str_eq(third_field, "active")
        Test.assert_str_eq(second, "orders")
      }
      _ -> Test.assert_true(false)
    }
  }
  match evaluation.file_observations {
    Cons({ path: observed, limit: bound, outcome: Ok(content) }, Nil) -> {
      Test.assert_true(observed.eq(sql_schema_test_path()))
      Test.assert_eq_usize(bound, 4096)
      Test.assert_str_eq(content.to_utf8().unwrap(), document)
    }
    _ -> Test.assert_true(false)
  }
}

test "schema TypeCheck handler checks SQL through the ordinary generic checker" {
  let document = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"name\":\"str\",\"active\":\"bool\"}}}"
  match sql_schema_test_load(document).value {
    Err(_) -> Test.assert_true(false)
    Ok(schema) -> {
      let (plan, errors) = sql_schema_test_check(schema, "select id, name from users where active order by id")
      Test.assert_eq(errors, 0)
      Test.assert_true(match plan { Checked(_) -> true, CheckRejected -> false })
    }
  }
}

test "changed schema content changes the checked SQL result" {
  let before = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"active\":\"bool\"}}}"
  let after = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"}}}"
  let before_evaluation = sql_schema_test_load(before)
  let after_evaluation = sql_schema_test_load(after)
  match (before_evaluation.value, after_evaluation.value) {
    (Ok(before_schema), Ok(after_schema)) -> {
      let (before_plan, before_errors) = sql_schema_test_check(before_schema, "select active from users")
      let (after_plan, after_errors) = sql_schema_test_check(after_schema, "select active from users")
      Test.assert_true(match before_plan { Checked(_) -> true, CheckRejected -> false })
      Test.assert_eq(before_errors, 0)
      Test.assert_true(match after_plan { Checked(_) -> false, CheckRejected -> true })
      Test.assert_eq(after_errors, 1)
    }
    _ -> Test.assert_true(false)
  }
  let before_content = match before_evaluation.file_observations {
    Cons({ path: _, limit: _, outcome: Ok(content) }, Nil) -> content.to_utf8().unwrap()
    _ -> ""
  }
  let after_content = match after_evaluation.file_observations {
    Cons({ path: _, limit: _, outcome: Ok(content) }, Nil) -> content.to_utf8().unwrap()
    _ -> ""
  }
  Test.assert_str_eq(before_content, before)
  Test.assert_str_eq(after_content, after)
  Test.assert_true(before_content != after_content)
}

test "schema validation rejects every structural failure family" {
  Test.assert_eq(sql_schema_parse_error_kind("{"), 2)
  Test.assert_eq(sql_schema_parse_error_kind("[]"), 3)
  Test.assert_eq(sql_schema_parse_error_kind("{}"), 4)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"schema_version\":1,\"tables\":{}}"), 4)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":2,\"tables\":{}}"), 5)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":[]}"), 6)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"\":{\"id\":\"i64\"}}}"), 7)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"},\"users\":{\"id\":\"i64\"}}}"), 8)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":[]}}"), 9)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":{}}}"), 10)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":{\"\":\"i64\"}}}"), 11)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"id\":\"i64\"}}}"), 12)
  Test.assert_eq(sql_schema_parse_error_kind("{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"f64\"}}}"), 13)
}

test "schema loading retains typed file failures" {
  let evaluation = handle comptime.observe_file_reads(() => sql_schema.load(sql_schema_test_path(), 32)) {
    FileRead.read_all(actual, limit) -> resume(Err<Bytes, IoError>(IoNotFound))
  }
  Test.assert_true(match evaluation.value {
    Err(error) -> sql_schema_error_kind(error) == 1
    Ok(_) -> false
  })
  Test.assert_true(match evaluation.file_observations {
    Cons({ path: _, limit: _, outcome: Err(IoNotFound) }, Nil) -> true
    _ -> false
  })
}

test "schema TypeCheck handler rejects unknown tables and fields" {
  let document = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"}}}"
  match sql_schema_test_load(document).value {
    Err(_) -> Test.assert_true(false)
    Ok(schema) -> {
      let (missing_table, table_errors) = sql_schema_test_check(schema, "select id from orders")
      let (missing_field, field_errors) = sql_schema_test_check(schema, "select name from users")
      Test.assert_true(match missing_table { Checked(_) -> false, CheckRejected -> true })
      Test.assert_true(match missing_field { Checked(_) -> false, CheckRejected -> true })
      Test.assert_eq(table_errors, 1)
      Test.assert_eq(field_errors, 1)
    }
  }
}

test "schema TypeCheck handler rejects a foreign table identity" {
  let first = sql_schema.parse("{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"}}}").unwrap()
  let second = sql_schema.parse("{\"schema_version\":1,\"tables\":{\"users\":{\"name\":\"str\"}}}").unwrap()
  let identity = with schema_types(first) {
    let resolved = TypeCheck<schema_types.SqlSchemaIdentity>.resolve(TypeName {
      qualifier: None<str>(),
      name: "users",
      arguments: Nil<schema_types.SqlSchemaIdentity>()
    }).unwrap()
    resolved.identity
  }
  let result = with schema_types(second) {
    TypeCheck<schema_types.SqlSchemaIdentity>.fields(identity)
  }
  Test.assert_true(match result {
    Err(ForeignTypeIdentity) -> true
    _ -> false
  })
}
