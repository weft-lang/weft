-- Typed descriptor transfers keep storage addresses inside the trusted leaf.

use runtime/descriptor_io.{
  DescriptorAppend,
  DescriptorCreateNew,
  DescriptorCreateOrTruncate,
  DescriptorOpen,
  DescriptorOpenRead,
  DescriptorReadWriteTruncate,
  DescriptorSeekCurrent,
  DescriptorSeekEnd,
  DescriptorSeekStart,
  descriptor_close,
  descriptor_flush,
  descriptor_open,
  descriptor_read_append,
  descriptor_read_into,
  descriptor_remove,
  descriptor_rename,
  descriptor_seek,
  descriptor_write_from,
  descriptor_write_suffix
}
use runtime/file_stream as file_stream_handler
use runtime/test_fixtures.{test_fixture_with_io_i64}
use stdlib/io.{IO}
use stdlib/bytes as bytes
use stdlib/io/types.{IoAlreadyExists, IoNotFound, io_error_from_errno}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len}
use stdlib/vector/handles.{Vector}

fn descriptor_test_path(name: str) -> str {
  "/tmp/weft-descriptor-io-".concat(name)
}

fn descriptor_test_file(name: str, contents: [u8]) -[Test]> str {
  let path = descriptor_test_path(name)
  descriptor_remove(path)
  let fd = descriptor_open(path, DescriptorCreateOrTruncate)
  Test.assert_true(fd >= 0)
  Test.assert_eq(descriptor_write_from(fd, contents), __u64_to_i64(__usize_to_u64(contents.len)))
  descriptor_close(fd)
  path
}

test "descriptor views write and read exact byte ranges" {
  let mut source: [u8; 5] = [104, 101, 108, 108, 111]
  let path = descriptor_test_file("views", source[..])
  let fd = descriptor_open(path, DescriptorOpenRead)
  let mut target: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
  let view: [mut u8] = target[1..4]
  Test.assert_eq(descriptor_read_into(fd, view), 3)
  Test.assert_true(target[0] == __i64_to_u8(0))
  Test.assert_true(target[1] == __i64_to_u8(104))
  Test.assert_true(target[3] == __i64_to_u8(108))
  Test.assert_true(target[4] == __i64_to_u8(0))
  let rest: [mut u8] = target[4..8]
  Test.assert_eq(descriptor_read_into(fd, rest), 2)
  Test.assert_eq(descriptor_read_into(fd, rest), 0)
  let empty: [mut u8] = target[0..0]
  Test.assert_eq(descriptor_read_into(fd, empty), 0)
  descriptor_close(fd)
  descriptor_remove(path)
}

test "descriptor platform failures are reported verbatim and touch no storage" {
  let mut target: [u8; 2] = [7, 9]
  let failure = descriptor_read_into(0 - 1, target[..])
  Test.assert_true(failure < 0)
  Test.assert_true(target[0] == __i64_to_u8(7))
  Test.assert_true(target[1] == __i64_to_u8(9))
  let mut source: [u8; 1] = [1]
  Test.assert_eq(descriptor_write_from(0 - 1, source[..]), failure)
  let mut values = vector.new<u8>()
  values.push(__i64_to_u8(5))
  Test.assert_eq(descriptor_read_append(0 - 1, values, __i64_to_usize(4)), failure)
  Test.assert_eq(vector_len<u8>(values), 1)
  Test.assert_true(vector_get_in_bounds<u8>(values, 0) == __i64_to_u8(5))
  Test.assert_eq(descriptor_write_suffix(0 - 1, values, __i64_to_usize(0)), failure)
}

test "descriptor vector reads reserve and append after initialized bytes" {
  let mut source: [u8; 5] = [97, 98, 99, 100, 101]
  let path = descriptor_test_file("append", source[..])
  let fd = descriptor_open(path, DescriptorOpenRead)
  let mut values = vector.new<u8>()
  values.push(__i64_to_u8(35))
  Test.assert_eq(descriptor_read_append(fd, values, __i64_to_usize(0)), 0)
  Test.assert_eq(vector_len<u8>(values), 1)
  Test.assert_eq(descriptor_read_append(fd, values, __i64_to_usize(3)), 3)
  Test.assert_eq(vector_len<u8>(values), 4)
  Test.assert_eq(descriptor_read_append(fd, values, __i64_to_usize(64)), 2)
  Test.assert_eq(descriptor_read_append(fd, values, __i64_to_usize(8)), 0)
  Test.assert_eq(vector_len<u8>(values), 6)
  Test.assert_true(vector_get_in_bounds<u8>(values, 0) == __i64_to_u8(35))
  Test.assert_true(vector_get_in_bounds<u8>(values, 1) == __i64_to_u8(97))
  Test.assert_true(vector_get_in_bounds<u8>(values, 5) == __i64_to_u8(101))
  descriptor_close(fd)
  descriptor_remove(path)
}

test "descriptor vector writes send the suffix after an offset" {
  let path = descriptor_test_path("suffix")
  descriptor_remove(path)
  let fd = descriptor_open(path, DescriptorCreateOrTruncate)
  let mut values = vector.new<u8>()
  values.push(__i64_to_u8(120))
  values.push(__i64_to_u8(121))
  values.push(__i64_to_u8(122))
  Test.assert_eq(descriptor_write_suffix(fd, values, __i64_to_usize(1)), 2)
  Test.assert_eq(descriptor_write_suffix(fd, values, __i64_to_usize(3)), 0)
  Test.assert_eq(descriptor_write_suffix(fd, values, __i64_to_usize(0)), 3)
  descriptor_close(fd)
  let reader = descriptor_open(path, DescriptorOpenRead)
  let mut back: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
  Test.assert_eq(descriptor_read_into(reader, back[..]), 5)
  Test.assert_true(back[0] == __i64_to_u8(121))
  Test.assert_true(back[1] == __i64_to_u8(122))
  Test.assert_true(back[2] == __i64_to_u8(120))
  Test.assert_true(back[4] == __i64_to_u8(122))
  descriptor_close(reader)
  descriptor_remove(path)
}

fn descriptor_io_read(fd: i64, buffer: [mut u8]) -[IO]> i64 {
  IO.read_into(fd, buffer)
}

fn descriptor_io_write(fd: i64, buffer: [u8]) -[IO]> i64 {
  IO.write_from(fd, buffer)
}

fn descriptor_io_typed_roundtrip(path: str) -[IO]> i64 {
  let mut source: [u8; 3] = [111, 107, 33]
  let writer = IO.open_write(path)
  let wrote = descriptor_io_write(writer, source[..])
  IO.close(writer)
  let reader = IO.open_read(path)
  let mut target: [u8; 4] = [0, 0, 0, 0]
  let read = descriptor_io_read(reader, target[..])
  IO.close(reader)
  if target[0] == __i64_to_u8(111) and target[2] == __i64_to_u8(33) and target[3] == __i64_to_u8(
    0
  ) {
    wrote * 10 + read
  } else { 0 - 1 }
}

test "the production IO handler transfers through typed views" {
  let path = descriptor_test_path("typed-io")
  descriptor_remove(path)
  let got = with file_stream_handler() { descriptor_io_typed_roundtrip(path) }
  descriptor_remove(path)
  Test.assert_eq(got, 33)
}

fn descriptor_io_fixture_program() -[IO]> i64 {
  let mut target: [u8; 2] = [0, 0]
  let mut empty: [u8; 0] = []
  let mut payload: [u8; 3] = [1, 2, 3]
  let read = descriptor_io_read(IO.open_read("fixture"), target[..])
  let none = descriptor_io_read(0, empty[..])
  let wrote = descriptor_io_write(IO.open_append("fixture"), payload[..])
  if target[0] == __i64_to_u8(65) and target[1] == __i64_to_u8(0) {
    read * 100 + none * 10 + wrote
  } else { 0 - 1 }
}

test "the IO test fixture interprets typed transfers deterministically" {
  Test.assert_eq(test_fixture_with_io_i64(descriptor_io_fixture_program), 103)
}

fn descriptor_test_not_found(status: i64) -> bool {
  status < 0 and match io_error_from_errno(status) {
    IoNotFound -> true
    _ -> false
  }
}

fn descriptor_test_already_exists(status: i64) -> bool {
  status < 0 and match io_error_from_errno(status) {
    IoAlreadyExists -> true
    _ -> false
  }
}

-- Open `path` as `mode` and write all of `text`, returning the written count
-- or the failing open status.
fn descriptor_test_put(path: str, mode: DescriptorOpen, text: str) -> i64 {
  let fd = descriptor_open(path, mode)
  if fd < 0 { fd }
  else {
    let values = bytes.from_str(text).to_vector()
    let written = descriptor_write_suffix(fd, values, __i64_to_usize(0))
    descriptor_close(fd)
    written
  }
}

fn descriptor_test_append_all(fd: i64, values: borrow mut Vector<u8>) -> i64 {
  let mut total = 0
  let mut reading = true
  while reading {
    let status = descriptor_read_append(fd, values, __i64_to_usize(64))
    if status > 0 { total = total + status } else { reading = false }
  }
  total
}

fn descriptor_test_contents(path: str) -> str {
  let fd = descriptor_open(path, DescriptorOpenRead)
  if fd < 0 { "<missing>" }
  else {
    let mut values = vector.new<u8>()
    descriptor_test_append_all(fd, values)
    descriptor_close(fd)
    match bytes.from_vector(values).to_utf8() {
      Ok(text) -> text
      Err(_) -> "<malformed>"
    }
  }
}

fn descriptor_test_read_text(fd: i64, count: usize) -> str {
  let mut values = vector.new<u8>()
  descriptor_read_append(fd, values, count)
  match bytes.from_vector(values).to_utf8() {
    Ok(text) -> text
    Err(_) -> "<malformed>"
  }
}

test "descriptor opens create, truncate and append by mode" {
  let path = descriptor_test_path("modes")
  descriptor_remove(path)
  Test.assert_eq(descriptor_test_put(path, DescriptorCreateNew, "one"), 3)
  Test.assert_str_eq(descriptor_test_contents(path), "one")
  Test.assert_true(
    descriptor_test_already_exists(descriptor_test_put(path, DescriptorCreateNew, "two"))
  )
  Test.assert_str_eq(descriptor_test_contents(path), "one")
  Test.assert_eq(descriptor_test_put(path, DescriptorCreateOrTruncate, "xy"), 2)
  Test.assert_str_eq(descriptor_test_contents(path), "xy")
  Test.assert_eq(descriptor_test_put(path, DescriptorAppend, "z"), 1)
  Test.assert_str_eq(descriptor_test_contents(path), "xyz")
  Test.assert_eq(descriptor_remove(path), 0)
  Test.assert_eq(descriptor_test_put(path, DescriptorAppend, "new"), 3)
  Test.assert_str_eq(descriptor_test_contents(path), "new")
  descriptor_remove(path)
}

test "descriptor read-write opens truncate and seek from each origin" {
  let path = descriptor_test_path("seek")
  Test.assert_eq(descriptor_test_put(path, DescriptorCreateOrTruncate, "0123456789"), 10)
  let fd = descriptor_open(path, DescriptorReadWriteTruncate)
  Test.assert_true(fd >= 0)
  let values = bytes.from_str("hello").to_vector()
  Test.assert_eq(descriptor_write_suffix(fd, values, __i64_to_usize(0)), 5)
  Test.assert_eq(descriptor_seek(fd, 0, DescriptorSeekStart), 0)
  Test.assert_str_eq(descriptor_test_read_text(fd, __i64_to_usize(2)), "he")
  Test.assert_eq(descriptor_seek(fd, 1, DescriptorSeekCurrent), 3)
  Test.assert_str_eq(descriptor_test_read_text(fd, __i64_to_usize(8)), "lo")
  Test.assert_eq(descriptor_seek(fd, 0 - 1, DescriptorSeekEnd), 4)
  Test.assert_str_eq(descriptor_test_read_text(fd, __i64_to_usize(8)), "o")
  Test.assert_eq(descriptor_flush(fd), 0)
  Test.assert_eq(descriptor_close(fd), 0)
  Test.assert_str_eq(descriptor_test_contents(path), "hello")
  descriptor_remove(path)
}

test "descriptor rename replaces its destination" {
  let from = descriptor_test_path("rename-from")
  let to = descriptor_test_path("rename-to")
  Test.assert_eq(descriptor_test_put(from, DescriptorCreateOrTruncate, "first"), 5)
  Test.assert_eq(descriptor_test_put(to, DescriptorCreateOrTruncate, "second"), 6)
  Test.assert_eq(descriptor_rename(from, to), 0)
  Test.assert_true(descriptor_test_not_found(descriptor_open(from, DescriptorOpenRead)))
  Test.assert_str_eq(descriptor_test_contents(to), "first")
  descriptor_remove(to)
}

test "descriptor path and handle failures are platform statuses" {
  let missing = descriptor_test_path("missing")
  descriptor_remove(missing)
  Test.assert_true(descriptor_test_not_found(descriptor_open(missing, DescriptorOpenRead)))
  Test.assert_true(descriptor_test_not_found(descriptor_remove(missing)))
  Test.assert_true(
    descriptor_test_not_found(descriptor_rename(missing, descriptor_test_path("x")))
  )
  Test.assert_true(descriptor_test_not_found(descriptor_open("", DescriptorOpenRead)))
  Test.assert_true(descriptor_close(0 - 1) < 0)
  Test.assert_true(descriptor_seek(0 - 1, 0, DescriptorSeekStart) < 0)
  Test.assert_true(descriptor_flush(0 - 1) < 0)
}
