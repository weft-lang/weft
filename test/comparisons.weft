-- Expected exit code: 63
-- Comparison operators: 6 comparisons encoded as bit flags
fn bool_to_int(b: Bool) -> Int {
  if b { 1 } else { 0 }
}

fn main() {
  -- Encode 6 boolean results as bit flags:
  -- eq(5,5)=1, lt(3,5)=1, gt(5,3)=1, le(5,5)=1, ge(5,5)=1, ne(3,5)=1
  -- 1 + 2 + 4 + 8 + 16 + 32 = 63
  let a = bool_to_int(5 == 5)
  let b = bool_to_int(3 < 5) * 2
  let c = bool_to_int(5 > 3) * 4
  let d = bool_to_int(5 <= 5) * 8
  let e = bool_to_int(5 >= 5) * 16
  let f = bool_to_int(3 != 5) * 32
  a + b + c + d + e + f
}
