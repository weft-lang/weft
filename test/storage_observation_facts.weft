use compiler/pipeline.{*}
use compiler/ir.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{Option, Some, None}
use stdlib/panic.{panic}

fn test_storage_states(blocks: IrBlockList) -> Map<i64, i64> {
  let entry = match blocks { IrBlockListCons(IrBlock(id, _, _, _), _) -> id, _ -> 0 - 1 }
  let maximum = pipeline_ir_native_resident_max_block_id(blocks)
  match pipeline_ir_storage_version_build(blocks, entry, maximum + 2, map.new<i64, i64>(), Nil<PipelineIrStorageReadVersion>(), PipelineIrWholeStorage) {
    PipelineIrStorageVersionBuild(_, outputs, reads) -> {
      let parents = pipeline_ir_storage_version_parents(blocks, entry, pipeline_ir_flow_predecessor_index(blocks, map.new<i64, List<i64>>()), outputs)
      let mut result = map.new<i64, i64>()
      let mut current = reads
      let mut walking = true
      while walking {
        match current {
          Nil -> { walking = false }
          Cons(PipelineIrStorageReadVersion(inst, _, _, version), rest) -> {
            result = result.insert(pipeline_ir_inst_def_or(inst, 0 - 1), pipeline_ir_storage_version_root(version, parents))
            current = rest
          }
        }
      }
      result
    }
  }
}

fn test_state(states: Map<i64, i64>, read: i64) -> i64 {
  match states.get(read) { Some(value) -> value, None -> panic("missing observed read") }
}

fn test_read(dst: i64) -> IrInst { IrFieldLoadI64(dst, 0, 5, 0) }

test "storage state follows sparse block identities and actual entry" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermJump(7, IrValueNil)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(test_read(3), IrInstNil), IrTermReturn(3)), IrBlockListNil))
  let states = test_storage_states(blocks)
  Test.assert_eq(test_state(states, 2), test_state(states, 3))
}

fn test_diamond(clobber: bool) -> IrBlockList {
  let left = if clobber { IrInstCons(IrCallI64(10, 99, IrValueNil), IrInstNil) } else { IrInstNil }
  IrBlockListCons(IrBlock(42, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermBranch(1, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, left, IrTermJump(200, IrValueNil)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermJump(200, IrValueNil)),
    IrBlockListCons(IrBlock(200, IrValueNil, IrInstCons(test_read(3), IrInstNil), IrTermReturn(3)), IrBlockListNil))))
}

test "a clobber on either possible path prevents reuse after a join" {
  let unchanged = test_storage_states(test_diamond(false))
  Test.assert_eq(test_state(unchanged, 2), test_state(unchanged, 3))
  let changed = test_storage_states(test_diamond(true))
  Test.assert_true(test_state(changed, 2) != test_state(changed, 3))
}

fn test_storage_loop(clobber: bool) -> IrBlockList {
  let back = if clobber { IrInstCons(IrCallI64(10, 99, IrValueNil), IrInstNil) } else { IrInstNil }
  IrBlockListCons(IrBlock(100, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermJump(7, IrValueNil)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(test_read(3), IrInstNil), IrTermBranch(1, 9, 90)),
    IrBlockListCons(IrBlock(9, IrValueNil, back, IrTermJump(7, IrValueNil)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstCons(test_read(4), IrInstNil), IrTermReturn(4)), IrBlockListNil))))
}

test "loop state distinguishes first entry and later iterations after a write" {
  let unchanged = test_storage_states(test_storage_loop(false))
  Test.assert_eq(test_state(unchanged, 2), test_state(unchanged, 3))
  Test.assert_eq(test_state(unchanged, 3), test_state(unchanged, 4))
  let changed = test_storage_states(test_storage_loop(true))
  Test.assert_true(test_state(changed, 2) != test_state(changed, 3))
  Test.assert_eq(test_state(changed, 3), test_state(changed, 4))
}

test "each possible mutation creates a distinct state inside one block" {
  let body = IrInstCons(test_read(2), IrInstCons(IrCallI64(10, 99, IrValueNil),
    IrInstCons(test_read(3), IrInstCons(IrCallI64(11, 99, IrValueNil),
    IrInstCons(test_read(4), IrInstCons(test_read(5), IrInstNil))))))
  let states = test_storage_states(IrBlockListCons(IrBlock(0, IrValueNil, body, IrTermReturn(5)), IrBlockListNil))
  Test.assert_true(test_state(states, 2) != test_state(states, 3))
  Test.assert_true(test_state(states, 3) != test_state(states, 4))
  Test.assert_eq(test_state(states, 4), test_state(states, 5))
}

test "long reverse layout chains preserve incoming storage state" {
  let mut blocks = IrBlockListNil
  let mut index = 1
  while index <= 500 {
    let body = if index == 500 { IrInstCons(test_read(3), IrInstNil) } else { IrInstNil }
    let term = if index == 500 { IrTermReturn(3) } else { IrTermJump(index + 1, IrValueNil) }
    blocks = IrBlockListCons(IrBlock(index, IrValueNil, body, term), blocks)
    index = index + 1
  }
  blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermJump(1, IrValueNil)), blocks)
  let states = test_storage_states(blocks)
  Test.assert_eq(test_state(states, 2), test_state(states, 3))
}

test "read hash collisions retain exact field and offset identity" {
  let first = IrFieldLoadI64(2, 0, 1, 0)
  let second = IrFieldLoadI64(3, 0, 0, 33)
  Test.assert_eq(pipeline_ir_storage_read_hash(first), pipeline_ir_storage_read_hash(second))
  Test.assert_true(not pipeline_ir_storage_reads_equal(first, second))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(first, IrInstCons(second, IrInstNil)), IrTermReturn(3)), IrBlockListNil)
  let rewritten = pipeline_ir_flow_apply_storage_read_reuse(pipeline_ir_storage_read_reuse_facts(blocks))
  Test.assert_eq(ir_block_list_inst_count(rewritten), 2)
}

test "dead cycles cannot create mutually recursive read aliases" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermReturn(1)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermJump(90, IrValueNil)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstCons(test_read(3), IrInstNil), IrTermJump(7, IrValueNil)), IrBlockListNil)))
  let rewritten = pipeline_ir_flow_apply_storage_read_reuse(pipeline_ir_storage_read_reuse_facts(blocks))
  Test.assert_eq(ir_block_list_inst_count(rewritten), 2)
}

test "discarded observations cannot erase unrelated instructions without results" {
  let args = IrValueCons(0, IrValueNil)
  let ignored = IrCallI64(0 - 1, pipeline_ir_vector_len_hash(), args)
  let unknown = IrCallI64(0 - 1, 12345, args)
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(ignored, IrInstCons(ignored, IrInstCons(unknown, IrInstNil))), IrTermReturn(0)), IrBlockListNil)
  let facts = pipeline_ir_storage_read_reuse_facts(blocks)
  Test.assert_eq(pipeline_ir_storage_read_reuse_count(facts), 0)
  Test.assert_eq(ir_block_list_inst_count(pipeline_ir_flow_apply_storage_read_reuse(facts)), 3)
}

test "a discarded observation is not a definition for a later live read" {
  let args = IrValueCons(0, IrValueNil)
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(0 - 1, pipeline_ir_vector_len_hash(), args),
    IrInstCons(IrCallI64(2, pipeline_ir_vector_len_hash(), args), IrInstNil)), IrTermReturn(2)), IrBlockListNil)
  Test.assert_eq(pipeline_ir_storage_read_reuse_count(pipeline_ir_storage_read_reuse_facts(blocks)), 0)
}

fn assert_repeated_read(first: IrInst, second: IrInst) -[Test]> nil {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(first, IrInstNil), IrTermJump(7, IrValueNil)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(second, IrInstNil), IrTermReturn(3)), IrBlockListNil))
  let facts = pipeline_ir_storage_read_reuse_facts(blocks)
  Test.assert_eq(pipeline_ir_storage_read_reuse_count(facts), 1)
  let result = pipeline_ir_flow_apply_storage_read_reuse(facts)
  Test.assert_eq(ir_block_list_inst_count(result), 1)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 1, result, 0)), 0)
  Test.assert_true(match pipeline_ir_merge_find_body(result, 7) {
    IrBlockListCons(IrBlock(_, _, IrInstNil, IrTermReturn(2)), _) -> true
    _ -> false
  })
  nil
}

test "equivalent dominated observations reuse each supported storage recipe" {
  assert_repeated_read(test_read(2), test_read(3))
  assert_repeated_read(IrRecordLayoutWordLoadI64(2, 0, 24, 5, 8), IrRecordLayoutWordLoadI64(3, 0, 24, 5, 8))
  assert_repeated_read(IrVariantTagI64(2, 0), IrVariantTagI64(3, 0))
  assert_repeated_read(IrVariantPayloadI64(2, 0, 1), IrVariantPayloadI64(3, 0, 1))
  let args = IrValueCons(0, IrValueNil)
  assert_repeated_read(IrCallI64(2, pipeline_ir_vector_len_hash(), args), IrCallI64(3, pipeline_ir_vector_len_hash(), args))
}

test "unknown writes effects ownership and calls invalidate object observations" {
  let barriers = [IrStoreI64(0, 1), IrPtrStoreI64(4, 0, 1, IrStorageWord64),
    IrCallI64(4, 99, IrValueNil),
    IrPerformI64(4, 10, 11, IrValueNil), IrOwnedDropI64(0, 10),
    IrStructuralDropI64(0, 0), IrManagedStakeI64(4, 0, 0, 0 - 1, 0),
    IrManagedTransferI64(4, 10, 0, 0, 0)]
  for barrier in barriers {
    let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
      IrInstCons(test_read(2), IrInstCons(barrier, IrInstCons(test_read(3), IrInstNil))), IrTermReturn(3)), IrBlockListNil)
    Test.assert_eq(pipeline_ir_storage_read_reuse_count(pipeline_ir_storage_read_reuse_facts(blocks)), 0)
  }
}

test "a read in one branch cannot replace a read after reconvergence" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(1, 7, 9)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(test_read(2), IrInstNil), IrTermJump(40, IrValueNil)),
    IrBlockListCons(IrBlock(9, IrValueNil, IrInstNil, IrTermJump(40, IrValueNil)),
    IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(test_read(3), IrInstNil), IrTermReturn(3)), IrBlockListNil))))
  Test.assert_eq(pipeline_ir_storage_read_reuse_count(pipeline_ir_storage_read_reuse_facts(blocks)), 0)
}

test "read aliases resolve beyond the generic operand walk limit" {
  let mut insts = IrInstNil
  let mut value = 200
  while value >= 2 {
    insts = IrInstCons(test_read(value), insts)
    value = value - 1
  }
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(200)), IrBlockListNil)
  let facts = pipeline_ir_storage_read_reuse_facts(blocks)
  Test.assert_eq(pipeline_ir_storage_read_reuse_count(facts), 198)
  let result = pipeline_ir_flow_apply_storage_read_reuse(facts)
  Test.assert_eq(ir_block_list_inst_count(result), 1)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 1, result, 0)), 0)
  Test.assert_true(match result {
    IrBlockListCons(IrBlock(_, _, _, IrTermReturn(2)), _) -> true
    _ -> false
  })
}

test "nested handler control keeps its observations outside the flat storage proof" {
  let body = IrInstCons(test_read(2),
    IrInstCons(IrHandleI64(4, 0, 10, IrHandlerClauseBodyNil, 0, 7),
    IrInstCons(test_read(3), IrInstNil)))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, body, IrTermReturn(3)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(test_read(5), IrInstNil), IrTermReturn(5)), IrBlockListNil))
  Test.assert_true(match pipeline_ir_storage_read_reuse_facts(blocks) {
    PipelineIrStorageReadReuseUnchanged(_) -> true
    PipelineIrStorageReadReuseReady(_, _) -> false
  })
}
