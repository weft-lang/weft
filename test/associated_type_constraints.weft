use test/module_fixtures/associated_constraint_trait as fixture

trait AssociatedConstraintLocal {
  type Item
  fn append(self, item: Self.Item) -> Self
}

type AssociatedConstraintTotal {
  value: i64
}

type AssociatedConstraintText {
  value: str
}

type AssociatedConstraintWrapper<T> {
  AssociatedConstraintWrapped(T)
}

type AssociatedReturnValue {
  value: i64
}

trait AssociatedConstraintConditional { }

impl AssociatedConstraintLocal for AssociatedConstraintTotal {
  type Item = i64
  fn append(self, item: i64) -> Self {
    AssociatedConstraintTotal { value: self.value + item }
  }
}

impl AssociatedConstraintLocal for AssociatedConstraintText {
  type Item = str
  fn append(self, item: str) -> Self {
    AssociatedConstraintText { value: "{self.value}{item}" }
  }
}

impl fixture.AssociatedConstraintSource for AssociatedConstraintTotal {
  type Item = i64
  fn append(self, item: i64) -> Self {
    AssociatedConstraintTotal { value: self.value + item }
  }
}

impl fixture.AssociatedReturnSource for AssociatedReturnValue {
  type Item = i64

  fn item(self) -> i64 { self.value }
}

fn associated_return_inferred<S: fixture.AssociatedReturnSource>(source: S) -> S.Item {
  source.item()
}

impl<T: AssociatedConstraintLocal & {type Item = i64}> AssociatedConstraintConditional for AssociatedConstraintWrapper<T> { }

fn associated_constraint_append<T, C: AssociatedConstraintLocal & {type Item = T}>(collector: C, item: T) -> C {
  collector.append(item)
}

fn associated_constraint_append_where<T, C>(collector: C, item: T) -> C where C: AssociatedConstraintLocal & {type Item = T} {
  collector.append(item)
}

fn associated_constraint_append_qualified<T, C: fixture.AssociatedConstraintSource & {type Item = T}>(collector: C, item: T) -> C {
  collector.append(item)
}

fn associated_constraint_conditional<T: AssociatedConstraintConditional>(value: T) -> i64 {
  42
}

type AssociatedConstraintStream<T> {
  AssociatedConstraintValue(T)
}

impl<T> AssociatedConstraintStream<T> {
  fn append_to<C: AssociatedConstraintLocal & {type Item = T}>(self, collector: C) -> C {
    match self {
      AssociatedConstraintValue(value) -> collector.append(value)
    }
  }
}

test "associated type equality constrains generic method arguments and results" {
  let total = associated_constraint_append<i64, AssociatedConstraintTotal>(AssociatedConstraintTotal { value: 40 }, 2)
  let text = associated_constraint_append<str, AssociatedConstraintText>(AssociatedConstraintText { value: "we" }, "ft")
  Test.assert_eq(total.value, 42)
  Test.assert_str_eq(text.value, "weft")
}

test "associated type equality works in where clauses" {
  let total = associated_constraint_append_where<i64, AssociatedConstraintTotal>(AssociatedConstraintTotal { value: 41 }, 1)
  Test.assert_eq(total.value, 42)
}

test "associated type equality preserves qualified trait identity" {
  let total = associated_constraint_append_qualified<i64, AssociatedConstraintTotal>(AssociatedConstraintTotal { value: 39 }, 3)
  Test.assert_eq(total.value, 42)
}

test "associated type equality controls conditional implementation evidence" {
  let wrapped = AssociatedConstraintWrapped<AssociatedConstraintTotal>(AssociatedConstraintTotal { value: 0 })
  Test.assert_eq(associated_constraint_conditional<AssociatedConstraintWrapper<AssociatedConstraintTotal>>(wrapped), 42)
}

test "method-local equality constraints can name outer impl parameters" {
  let stream = AssociatedConstraintValue<i64>(2)
  let total = stream.append_to<AssociatedConstraintTotal>(AssociatedConstraintTotal { value: 40 })
  Test.assert_eq(total.value, 42)
}

test "inferred generic calls resolve associated return types" {
  let local = associated_return_inferred(AssociatedReturnValue { value: 20 })
  let qualified = fixture.inferred_item(AssociatedReturnValue { value: 22 })
  Test.assert_eq(local + qualified, 42)
}
