-- test/alloc_elision_metrics.weft -- native evidence for scoped allocation elision

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/alloc.weft"

fn alloc_metric_u32_at(p: i64) -> i64 {
  __mem_load8(p) +
  __mem_load8(p + 1) * 256 +
  __mem_load8(p + 2) * 65536 +
  __mem_load8(p + 3) * 16777216
}

fn alloc_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = __mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn alloc_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if alloc_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn alloc_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn alloc_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = alloc_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = alloc_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  alloc_metric_count_bl_to_target(code, off, end, target)
}

fn alloc_metric_elisions(src: str) -> i64 {
  pipeline_native_alloc_elision_count(alloc_metric_native(src))
}

fn alloc_elision_temp_value() -> i64 {
  let p = alloc_bump(8)
  __mem_store64(p, 42)
  __mem_load64(p)
}

fn alloc_elision_temp_branch(flag: bool) -> i64 {
  let p = alloc_bump(8)
  __mem_store64(p, 43)
  if flag { __mem_load64(p) } else { 0 }
}

fn alloc_elision_loop_temp_sum() -> i64 {
  let mut i = 0
  let mut sum = 0
  while i < 3 {
    let p = alloc_bump(8)
    __mem_store64(p, i + 1)
    sum = sum + __mem_load64(p)
    i = i + 1
  }
  sum
}

fn alloc_elision_pure_helper_value() -> i64 {
  let p = alloc_bump(8)
  __mem_store64(p, 56)
  __mem_load64(p)
}

fn alloc_elision_pure_helper_branch(flag: bool) -> i64 {
  let p = alloc_bump(8)
  __mem_store64(p, 57)
  if flag { __mem_load64(p) } else { 0 }
}

fn alloc_elision_pure_helper_total() -> i64 {
  alloc_elision_pure_helper_value() + alloc_elision_pure_helper_branch(false)
}

fn alloc_elision_scoped_arena_direct_sum() -> i64 {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 49)
    let value = __mem_load64(p)
    let freed = Alloc.free(p, 8)
    value + freed
  })
  let off = arena_offset(arena)
  arena_free(arena)
  got + off
}

fn alloc_elision_scoped_arena_loop_break_sum() -> i64 {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    loop {
      let p = Alloc.alloc(8, 8)
      __mem_store64(p, 50)
      break(__mem_load64(p))
    }
  })
  let off = arena_offset(arena)
  arena_free(arena)
  got + off
}

test "alloc_elision_local_temp_removes_alloc_bump_call" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) __mem_store64(p, 42) __mem_load64(p) }"
  Test.assert_eq(alloc_metric_elisions(src), 1)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 0)
}

test "alloc_elision_local_temp_control_flow_matrix" {
  let in_if = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) __mem_store64(p, 43) if true { __mem_load64(p) } else { 0 } }"
  Test.assert_eq(alloc_metric_elisions(in_if), 1)
  Test.assert_eq(alloc_metric_call_sites(in_if, "main", "alloc_bump"), 0)

  let in_match = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) __mem_store64(p, 44) match 1 { 1 -> __mem_load64(p) _ -> 0 } }"
  Test.assert_eq(alloc_metric_elisions(in_match), 1)
  Test.assert_eq(alloc_metric_call_sites(in_match, "main", "alloc_bump"), 0)
}

test "alloc_elision_loop_local_temp_removes_repeated_alloc_site" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let mut i = 0 let mut sum = 0 while i < 3 { let p = alloc_bump(8) __mem_store64(p, i + 1) sum = sum + __mem_load64(p) i = i + 1 } sum }"
  Test.assert_eq(alloc_metric_elisions(src), 1)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 0)
}

test "alloc_elision_boundary_size_matrix" {
  let max_ok = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(512) __mem_store64(p, 58) __mem_load64(p) }"
  Test.assert_eq(alloc_metric_elisions(max_ok), 1)
  Test.assert_eq(alloc_metric_call_sites(max_ok, "main", "alloc_bump"), 0)

  let too_large = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(513) __mem_store64(p, 59) __mem_load64(p) }"
  Test.assert_eq(alloc_metric_elisions(too_large), 0)
  Test.assert_eq(alloc_metric_call_sites(too_large, "main", "alloc_bump"), 1)
}

test "alloc_elision_pure_helper_local_temp_matrix" {
  let simple = "use \"runtime/alloc.weft\" fn helper() -> i64 { let p = alloc_bump(8) __mem_store64(p, 56) __mem_load64(p) } fn main() -> i64 { helper() }"
  Test.assert_eq(alloc_metric_elisions(simple), 1)
  Test.assert_eq(alloc_metric_call_sites(simple, "helper", "alloc_bump"), 0)
  Test.assert_eq(alloc_metric_call_sites(simple, "main", "helper"), 1)

  let branch = "use \"runtime/alloc.weft\" fn helper(flag: bool) -> i64 { let p = alloc_bump(8) __mem_store64(p, 57) if flag { __mem_load64(p) } else { 0 } } fn main() -> i64 { helper(true) + helper(false) }"
  Test.assert_eq(alloc_metric_elisions(branch), 1)
  Test.assert_eq(alloc_metric_call_sites(branch, "helper", "alloc_bump"), 0)
  Test.assert_eq(alloc_metric_call_sites(branch, "main", "helper"), 2)
}

test "alloc_elision_pure_helper_rejects_escape_matrix" {
  let returned = "use \"runtime/alloc.weft\" fn helper() -> i64 { let p = alloc_bump(8) p } fn main() -> i64 { helper() }"
  Test.assert_eq(alloc_metric_elisions(returned), 0)
  Test.assert_eq(alloc_metric_call_sites(returned, "helper", "alloc_bump"), 1)

  let stored = "use \"runtime/alloc.weft\" fn helper(slot: i64) -> i64 { let p = alloc_bump(8) __mem_store64(slot, p) 0 } fn main() -> i64 { let slot = alloc_bump(8) helper(slot) }"
  Test.assert_eq(alloc_metric_elisions(stored), 0)
  Test.assert_eq(alloc_metric_call_sites(stored, "helper", "alloc_bump"), 1)

  let captured = "use \"runtime/alloc.weft\" fn helper() -> i64 { let p = alloc_bump(8) let f = () => p f() } fn main() -> i64 { helper() }"
  Test.assert_eq(alloc_metric_elisions(captured), 0)
  Test.assert_eq(alloc_metric_call_sites(captured, "helper", "alloc_bump"), 1)

  let deferred = "use \"runtime/alloc.weft\" fn helper() -> i64 { let p = alloc_bump(8) defer __mem_store64(p, 1) 0 } fn main() -> i64 { helper() }"
  Test.assert_eq(alloc_metric_elisions(deferred), 0)
  Test.assert_eq(alloc_metric_call_sites(deferred, "helper", "alloc_bump"), 1)
}

test "alloc_elision_control_transfer_matrix" {
  let early_return = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) __mem_store64(p, 45) return __mem_load64(p) }"
  Test.assert_eq(alloc_metric_elisions(early_return), 1)
  Test.assert_eq(alloc_metric_call_sites(early_return, "main", "alloc_bump"), 0)

  let break_value = "use \"runtime/alloc.weft\" fn main() -> i64 { loop { let p = alloc_bump(8) __mem_store64(p, 46) break(__mem_load64(p)) } }"
  Test.assert_eq(alloc_metric_elisions(break_value), 1)
  Test.assert_eq(alloc_metric_call_sites(break_value, "main", "alloc_bump"), 0)

  let continue_value = "use \"runtime/alloc.weft\" fn main() -> i64 { let mut i = 0 while i < 3 { let p = alloc_bump(8) __mem_store64(p, i) i = i + 1 continue } i }"
  Test.assert_eq(alloc_metric_elisions(continue_value), 1)
  Test.assert_eq(alloc_metric_call_sites(continue_value, "main", "alloc_bump"), 0)
}

test "alloc_elision_rejects_returned_allocation" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) p }"
  Test.assert_eq(alloc_metric_elisions(src), 0)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 1)
}

test "alloc_elision_rejects_stored_allocation" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let slot = alloc_bump(8) let p = alloc_bump(8) __mem_store64(slot, p) 0 }"
  Test.assert_eq(alloc_metric_elisions(src), 0)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 2)
}

test "alloc_elision_rejects_captured_allocation" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) let f = () => p f() }"
  Test.assert_eq(alloc_metric_elisions(src), 0)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 1)
}

test "alloc_elision_rejects_defer_boundary" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) defer __mem_store64(p, 1) 0 }"
  Test.assert_eq(alloc_metric_elisions(src), 0)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 1)
}

test "alloc_elision_rejects_nested_handler_boundaries" {
  let local = "use \"runtime/alloc.weft\" effect H { fn get() -> i64 } fn main() -> i64 { let p = alloc_bump(8) handle __mem_load64(p) { H.get() -> resume(0) } }"
  Test.assert_eq(alloc_metric_elisions(local), 0)
  Test.assert_eq(alloc_metric_call_sites(local, "main", "alloc_bump"), 1)

  let scoped = "use \"runtime/alloc.weft\" effect H { fn get() -> i64 } fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { handle { let p = Alloc.alloc(8, 8) __mem_store64(p, 60) __mem_load64(p) } { H.get() -> resume(0) } }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(scoped), 0)
  Test.assert_eq(alloc_metric_call_sites(scoped, "main", "with_scoped_arena_alloc"), 1)
}

test "alloc_elision_preserves_observable_alloc_handler" {
  let src = "use \"runtime/alloc.weft\" fn work() -[Alloc]> i64 { let p = alloc_effect(8, 8) __mem_store64(p, 47) __mem_load64(p) } fn main() -> i64 { let arena = arena_new(64) let seen = alloc_bump(8) __mem_store64(seen, 0) let got = handle work() { Alloc.alloc(size, align) -> { __mem_store64(seen, __mem_load64(seen) + 1) resume(arena_alloc(arena, size, align)) } } let count = __mem_load64(seen) arena_free(arena) got + count }"
  Test.assert_eq(alloc_metric_elisions(src), 0)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "arena_alloc"), 1)
}

test "alloc_elision_scoped_arena_helper_direct_perform_matrix" {
  let direct = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { let p = Alloc.alloc(8, 8) __mem_store64(p, 48) let value = __mem_load64(p) let freed = Alloc.free(p, 8) value + freed }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(direct), 1)
  Test.assert_eq(alloc_metric_call_sites(direct, "main", "with_scoped_arena_alloc"), 0)
  Test.assert_eq(alloc_metric_call_sites(direct, "main", "arena_mark"), 1)
  Test.assert_eq(alloc_metric_call_sites(direct, "main", "arena_alloc"), 1)
  Test.assert_eq(alloc_metric_call_sites(direct, "main", "arena_restore"), 1)

  let dynamic = "use \"runtime/alloc.weft\" fn work() -[Alloc]> i64 { let p = alloc_effect(8, 8) __mem_store64(p, 48) __mem_load64(p) } fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => work()) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(dynamic), 0)
  Test.assert_eq(alloc_metric_call_sites(dynamic, "main", "with_scoped_arena_alloc"), 1)
}

test "alloc_elision_scoped_arena_helper_control_flow_matrix" {
  let branch = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { if true { let p = Alloc.alloc(8, 8) __mem_store64(p, 51) __mem_load64(p) } else { 0 } }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(branch), 1)
  Test.assert_eq(alloc_metric_call_sites(branch, "main", "with_scoped_arena_alloc"), 0)
  Test.assert_eq(alloc_metric_call_sites(branch, "main", "arena_alloc"), 1)

  let match_case = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { match 1 { 1 -> { let p = Alloc.alloc(8, 8) __mem_store64(p, 52) __mem_load64(p) } _ -> 0 } }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(match_case), 1)
  Test.assert_eq(alloc_metric_call_sites(match_case, "main", "with_scoped_arena_alloc"), 0)
  Test.assert_eq(alloc_metric_call_sites(match_case, "main", "arena_alloc"), 1)

  let loop_break = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { loop { let p = Alloc.alloc(8, 8) __mem_store64(p, 53) break(__mem_load64(p)) } }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(loop_break), 1)
  Test.assert_eq(alloc_metric_call_sites(loop_break, "main", "with_scoped_arena_alloc"), 0)
  Test.assert_eq(alloc_metric_call_sites(loop_break, "main", "arena_alloc"), 1)
}

test "alloc_elision_scoped_arena_helper_rejects_control_escape_boundaries" {
  let returns = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { let p = Alloc.alloc(8, 8) __mem_store64(p, 54) return __mem_load64(p) }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(returns), 0)
  Test.assert_eq(alloc_metric_call_sites(returns, "main", "with_scoped_arena_alloc"), 1)

  let deferred = "use \"runtime/alloc.weft\" fn main() -> i64 { let arena = arena_new(64) let got = with_scoped_arena_alloc(arena, () => { let p = Alloc.alloc(8, 8) __mem_store64(p, 55) defer Alloc.free(p, 8) __mem_load64(p) }) let off = arena_offset(arena) arena_free(arena) got + off }"
  Test.assert_eq(alloc_metric_elisions(deferred), 0)
  Test.assert_eq(alloc_metric_call_sites(deferred, "main", "with_scoped_arena_alloc"), 1)
}

test "alloc_elision_rejects_nested_candidate_to_avoid_stack_slot_overlap" {
  let src = "use \"runtime/alloc.weft\" fn main() -> i64 { let p = alloc_bump(8) __mem_store64(p, 1) let q = alloc_bump(8) __mem_store64(q, 2) __mem_load64(p) + __mem_load64(q) }"
  Test.assert_eq(alloc_metric_elisions(src), 1)
  Test.assert_eq(alloc_metric_call_sites(src, "main", "alloc_bump"), 1)
}

test "alloc_elision_e2e_preserves_temp_value" {
  Test.assert_eq(alloc_elision_temp_value(), 42)
}

test "alloc_elision_e2e_preserves_branch_value" {
  Test.assert_eq(alloc_elision_temp_branch(true), 43)
  Test.assert_eq(alloc_elision_temp_branch(false), 0)
}

test "alloc_elision_e2e_preserves_loop_temp_sum" {
  Test.assert_eq(alloc_elision_loop_temp_sum(), 6)
}

test "alloc_elision_e2e_preserves_pure_helper_value" {
  Test.assert_eq(alloc_elision_pure_helper_total(), 56)
}

test "alloc_elision_e2e_scoped_arena_direct_helper_restores" {
  Test.assert_eq(alloc_elision_scoped_arena_direct_sum(), 49)
}

test "alloc_elision_e2e_scoped_arena_loop_break_restores" {
  Test.assert_eq(alloc_elision_scoped_arena_loop_break_sum(), 50)
}
