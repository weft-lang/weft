use "runtime/memory.weft"
-- test/alloc_elision_metrics.weft -- scoped allocation facade regression coverage

use "runtime/alloc.weft"

fn alloc_elision_temp_value() -> i64 {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 42)
  let result = mem_load64(p)
  arena_free(arena)
  result
}

fn alloc_elision_temp_branch(flag: bool) -> i64 {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 43)
  let result = if flag { mem_load64(p) } else { 0 }
  arena_free(arena)
  result
}

fn alloc_elision_loop_temp_sum() -> i64 {
  let arena = arena_new(64)
  let mut i = 0
  let mut sum = 0
  while i < 3 {
    let p = arena_alloc(arena, 8, 8)
    mem_store64(p, i + 1)
    sum = sum + mem_load64(p)
    i = i + 1
  }
  arena_free(arena)
  sum
}

fn alloc_elision_pure_helper_value() -> i64 {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 56)
  let result = mem_load64(p)
  arena_free(arena)
  result
}

fn alloc_elision_pure_helper_branch(flag: bool) -> i64 {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 57)
  let result = if flag { mem_load64(p) } else { 0 }
  arena_free(arena)
  result
}

fn alloc_elision_pure_helper_total() -> i64 {
  alloc_elision_pure_helper_value() + alloc_elision_pure_helper_branch(false)
}

fn alloc_elision_scoped_arena_direct_sum() -> i64 {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 49)
    let value = mem_load64(p)
    let freed = Alloc.free(p, 8)
    value + freed
  })
  let off = arena_offset(arena)
  arena_free(arena)
  got + off
}

fn alloc_elision_scoped_arena_loop_break_sum() -> i64 {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    loop {
      let p = Alloc.alloc(8, 8)
      mem_store64(p, 50)
      break(mem_load64(p))
    }
  })
  let off = arena_offset(arena)
  arena_free(arena)
  got + off
}

test "alloc_elision_e2e_preserves_temp_value" {
  Test.assert_eq(alloc_elision_temp_value(), 42)
}

test "alloc_elision_e2e_preserves_branch_value" {
  Test.assert_eq(alloc_elision_temp_branch(true), 43)
  Test.assert_eq(alloc_elision_temp_branch(false), 0)
}

test "alloc_elision_e2e_preserves_loop_temp_sum" {
  Test.assert_eq(alloc_elision_loop_temp_sum(), 6)
}

test "alloc_elision_e2e_preserves_pure_helper_value" {
  Test.assert_eq(alloc_elision_pure_helper_total(), 56)
}

test "alloc_elision_e2e_scoped_arena_direct_helper_restores" {
  Test.assert_eq(alloc_elision_scoped_arena_direct_sum(), 49)
}

test "alloc_elision_e2e_scoped_arena_loop_break_restores" {
  Test.assert_eq(alloc_elision_scoped_arena_loop_break_sum(), 50)
}
