-- Expected exit code: 102
-- Releasing a freed block names a stake that no longer exists. The runtime
-- traps rather than insert the block into its free list a second time.

use runtime/rc.{rc_default_alloc, rc_default_release}

fn main() -> i64 {
  let block: i64 = rc_default_alloc(8, 8)
  rc_default_release(block)
  rc_default_release(block)
  0
}
