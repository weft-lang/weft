-- Runtime semantics for static callback identity specialisation.

fn ids_apply<T>(f: (T) -> T, value: T) -> T {
  f(value)
}

fn ids_outer<T>(f: (T) -> T, value: T) -> T {
  ids_apply<T>(f, value)
}

fn ids_combine<T>(first: (T) -> T, second: (T) -> T, value: T) -> T {
  first(second(value))
}

fn ids_repeat<T>(f: (T) -> T, count: i64, value: T) -> T {
  if count <= 0 {
    value
  } else {
    ids_repeat<T>(f, count - 1, f(value))
  }
}

fn ids_inc(value: i64) -> i64 {
  value + 1
}

fn ids_dec(value: i64) -> i64 {
  value - 1
}

fn ids_twice(value: i64) -> i64 {
  value * 2
}

fn ids_str_identity(value: str) -> str {
  value
}

fn ids_choose(flag: bool, yes: (i64) -> i64, no: (i64) -> i64) -> (i64) -> i64 {
  if flag { yes } else { no }
}

fn ids_make_adder(offset: i64) -> (i64) -> i64 {
  value => value + offset
}

test "identity_specialisation_runtime_named_callback" {
  Test.assert_eq(ids_apply<i64>(ids_inc, 41), 42)
  Test.assert_eq(ids_apply<i64>(ids_dec, 41), 40)
}

test "identity_specialisation_runtime_transitive_generic_callback" {
  Test.assert_eq(ids_outer<i64>(ids_twice, 21), 42)
}

test "identity_specialisation_runtime_multiple_callback_recipe" {
  Test.assert_eq(ids_combine<i64>(ids_inc, ids_twice, 20), 41)
  Test.assert_eq(ids_combine<i64>(ids_twice, ids_inc, 20), 42)
}

test "identity_specialisation_runtime_recursive_recipe_reuses_clone" {
  Test.assert_eq(ids_repeat<i64>(ids_inc, 0, 10), 10)
  Test.assert_eq(ids_repeat<i64>(ids_inc, 32, 10), 42)
}

test "identity_specialisation_runtime_managed_generic_value" {
  Test.assert_str_eq(ids_apply<str>(ids_str_identity, "λ-weft"), "λ-weft")
}

test "identity_specialisation_runtime_dynamic_callback_fallback" {
  Test.assert_eq(ids_apply<i64>(ids_choose(true, ids_inc, ids_dec), 41), 42)
  Test.assert_eq(ids_apply<i64>(ids_choose(false, ids_inc, ids_dec), 41), 40)
}

test "identity_specialisation_runtime_capturing_lambda_recipe" {
  let offset = 7
  Test.assert_eq(ids_apply<i64>(value => value + offset, 35), 42)
}

test "identity_specialisation_runtime_noncapturing_lambda_recipe" {
  Test.assert_eq(ids_apply<i64>(value => value * 3, 14), 42)
}

test "identity_specialisation_runtime_factory_closure_dynamic_fallback" {
  Test.assert_eq(ids_apply<i64>(ids_make_adder(7), 35), 42)
}

test "identity_specialisation_runtime_local_lambda_direct_call" {
  let offset = 7
  let add = value => value + offset
  Test.assert_eq(add(35), 42)
}
