use compiler/lib.{*}
use "compiler/codegen.weft"
use compiler/types.{*}
use compiler/typeck.{*}

fn runtime_typeck_is_empty_with_ct(ty: i64, ct: i64) -> i64 {
  handle ty_is_empty(ty) {
    Conformance.conforms(concrete, trait_atom) -> resume(ctable_conforms_type_atom(ct, concrete, trait_atom))
  }
}

test "runtime_typeck_alloc_tenv_lookup_and_missing" {
  let src = __str_ptr("alpha beta")
  let env = tenv_bind(tenv_new(), src, 0, 5, ty_i64())
  Test.assert_eq(ty_tag(tenv_lookup(env, src, 0, 5)), 2)
  Test.assert_eq(ty_f1(tenv_lookup(env, src, 0, 5)), PRIM_I64())
  Test.assert_eq(tenv_lookup_mutable(env, src, 0, 5), 0)
  Test.assert_eq(tenv_lookup(env, src, 6, 4), 0)
}

test "runtime_typeck_alloc_tenv_shadowing_and_mutability" {
  let src = __str_ptr("alpha")
  let env1 = tenv_bind(tenv_new(), src, 0, 5, ty_i64())
  let env2 = tenv_bind_mut(env1, src, 0, 5, ty_bool())
  Test.assert_eq(ty_tag(tenv_lookup(env2, src, 0, 5)), 2)
  Test.assert_eq(ty_f1(tenv_lookup(env2, src, 0, 5)), PRIM_BOOL())
  Test.assert_eq(tenv_lookup_mutable(env2, src, 0, 5), 1)
  Test.assert_eq(tenv_lookup_mutable(env1, src, 0, 5), 0)
}

test "runtime_typeck_alloc_ftypes_lookup_metadata" {
  let src = __str_ptr("foo bar")
  let ft = ftypes_new()
  let params = nlist_new()
  let effects = ty_effect_pure()
  let tparams = nlist_new()
  nlist_add(params, node_new(0, 0, 3, ty_i64(), 0))
  ftypes_add(ft, src, 0, 3, ty_bool(), params, effects, tparams)
  Test.assert_eq(ty_f1(ftypes_lookup(ft, src, 0, 3)), PRIM_BOOL())
  Test.assert_eq(nlist_len(ftypes_lookup_params(ft, src, 0, 3)), 1)
  Test.assert_eq(ftypes_lookup_effects(ft, src, 0, 3), effects)
  Test.assert_eq(ftypes_lookup_tparams(ft, src, 0, 3), tparams)
  Test.assert_eq(ftypes_lookup(ft, src, 4, 3), 0)
}

test "runtime_typeck_alloc_ftypes_function_type" {
  let src = __str_ptr("foo")
  let ft = ftypes_new()
  let params = nlist_new()
  nlist_add(params, node_new(0, 0, 3, ty_i64(), 0))
  nlist_add(params, node_new(0, 0, 3, ty_str(), 0))
  ftypes_add(ft, src, 0, 3, ty_nil(), params, ty_effect_pure(), nlist_new())
  let fn_ty = ftypes_lookup_fn_type(ft, src, 0, 3)
  Test.assert_eq(ty_tag(fn_ty), 6)
  Test.assert_eq(nlist_len(ty_f1(fn_ty)), 2)
  Test.assert_eq(ty_f1(ty_f2(fn_ty)), PRIM_NIL())
}

test "runtime_typeck_alloc_ctable_conformance_matrix" {
  let ct = ctable_new()
  ctable_add(ct, 10, 20, nlist_new())
  ctable_add_full(ct, 11, 21, nlist_new(), nlist_new())
  Test.assert_eq(ctable_conforms(ct, 10, 20), 1)
  Test.assert_eq(ctable_conforms(ct, 11, 21), 1)
  Test.assert_eq(ctable_conforms(ct, 10, 21), 0)
  Test.assert_eq(ctable_conforms(ct, 12, 20), 0)
  Test.assert_eq(ctable_conforms(0, 10, 20), 0)
}

test "runtime_typeck_alloc_conformance_growth_is_monotone" {
  let ct = ctable_new()
  let trait_hash = 424242
  let intersection = ty_inter(ty_i64(), ty_trait(trait_hash))
  -- Adding positive evidence may make an intersection newly inhabited.
  Test.assert_eq(runtime_typeck_is_empty_with_ct(intersection, ct), 1)
  ctable_add_pattern(ct, 0 - 1, trait_hash, nlist_new(), 0, ty_i64())
  Test.assert_eq(runtime_typeck_is_empty_with_ct(intersection, ct), 0)
  -- Growing the table with unrelated evidence cannot retract that fact.
  ctable_add_pattern(ct, 0 - 2, 313131, nlist_new(), 0, ty_str())
  Test.assert_eq(runtime_typeck_is_empty_with_ct(intersection, ct), 0)
}
