-- test/par_emission_metrics.weft -- native evidence for generic scoped Par lowering

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}

fn par_metric_lowerings(src: str) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_native_par_lowering_count(pipeline_lower_native_module(typed, optimised))
}

test "par_emission_metric_sequential_fork_join_lowers" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn main() -> i64 {
  par.with_sequential(() => {
    let task = par.fork<i64>(() => 42)
    task.join()
  })
}
"
  Test.assert_eq(par_metric_lowerings(src), 1)
}

test "par_emission_metric_pool_fork_join_lowers_with_fallback" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn main() -> i64 {
  par.with_pool(2, 4, () => {
    let task = par.fork<i64>(() => 42)
    task.join()
  })
}
"
  Test.assert_eq(par_metric_lowerings(src), 1)
}

test "par_emission_metric_sequential_map_lowers" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn main() -> i64 {
  let values = [20, 22]
  par.with_sequential(() => {
    let mapped = par.map<i64, i64>(values[..], x => x + 1)
    mapped.len()
  })
}
"
  Test.assert_eq(par_metric_lowerings(src), 1)
}

test "par_emission_metric_pool_map_lowers" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn main() -> i64 {
  let values = [20, 22]
  par.with_pool(2, 4, () => {
    let mapped = par.map<i64, i64>(values[..], x => x + 1)
    mapped.len()
  })
}
"
  Test.assert_eq(par_metric_lowerings(src), 1)
}

test "par_emission_metric_named_scope_body_stays_on_handler_path" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn body() -[Par]> i64 {
  let task = par.fork<i64>(() => 42)
  task.join()
}
fn main() -> i64 { par.with_sequential(body) }
"
  Test.assert_eq(par_metric_lowerings(src), 0)
}

test "par_emission_metric_control_escape_stays_on_defer_aware_path" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
fn main() -> i64 {
  par.with_sequential(() => {
    let task = par.fork<i64>(() => 42)
    return task.join()
  })
}
"
  Test.assert_eq(par_metric_lowerings(src), 0)
}
