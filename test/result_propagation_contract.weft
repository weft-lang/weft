use stdlib/result as result
use stdlib/fail as fail

type Outcome<T, E> = result.Result<T, E>

fn propagate<T, E>(value: Outcome<T, E>) -[fail.Fail<E>]> T { value? }
fn constructed() -[fail.Fail<str>]> i64 { result.Ok<i64, str>(42)? }
fn nested(value: Result<Result<i64, str>, i64>) -[fail.Fail<i64>, fail.Fail<str>]> i64 { value?? }

effect Stop { fn stop() -> never }
fn stop_before_propagation() -[Stop]> i64 { Stop.stop()? }

test "transparent result names propagate the declared success and error types" {
  let success = handle propagate<i64, i64>(result.Ok<i64, i64>(42)) {
    fail.Fail<i64>.fail(error) -> error
  }
  let failure = handle propagate<i64, i64>(result.Err<i64, i64>(7)) {
    fail.Fail<i64>.fail(error) -> error + 35
  }
  Test.assert_eq(success, 42)
  Test.assert_eq(failure, 42)
}

test "direct result constructors retain their canonical operand identity" {
  let value = handle constructed() { fail.Fail<str>.fail(error) -> -1 }
  Test.assert_eq(value, 42)
}

test "nested propagation preserves each parameterized Fail atom" {
  for value in [
    result.Ok<Result<i64, str>, i64>(result.Ok<i64, str>(42)),
    result.Ok<Result<i64, str>, i64>(result.Err<i64, str>("failed")),
    result.Err<Result<i64, str>, i64>(40),
  ] {
    let answer = handle {
      handle nested(value) { fail.Fail<str>.fail(error) -> 42 }
    } { fail.Fail<i64>.fail(error) -> error + 2 }
    Test.assert_eq(answer, 42)
  }
}

test "wide managed payloads preserve their success and failure representation" {
  let success = handle propagate<(str, i64, i64), str>(result.Ok<(str, i64, i64), str>(("value", 20, 22))) {
    fail.Fail<str>.fail(error) -> (error, 0, 0)
  }
  Test.assert_str_eq(success.0, "value")
  Test.assert_eq(success.1 + success.2, 42)
  let failure = handle propagate<i64, (str, i64, i64)>(result.Err<i64, (str, i64, i64)>(("failure", 20, 22))) {
    fail.Fail<(str, i64, i64)>.fail(error) -> {
      Test.assert_str_eq(error.0, "failure")
      error.1 + error.2
    }
  }
  Test.assert_eq(failure, 42)
}

test "diverging operands preserve their effects without acquiring Fail" {
  let value = handle stop_before_propagation() { Stop.stop() -> 42 }
  Test.assert_eq(value, 42)
}
