use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/http as http
use stdlib/http.{Http11, HttpContentLength, HttpGet, HttpRequestHead}
use stdlib/http/client.{HttpConnectionPool, HttpPoolAtCapacity, http_connection_pool, http_pool_release}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady, HttpClientUpgradeFailed, HttpClientUpgradeReady, HttpExchangeBody, HttpExchangeExpectedProtocolSwitch, HttpExchangeProtocol}
use stdlib/http/replay.{HttpReplayConfigError, HttpReplayFixture, HttpReplayReadComplete, HttpReplayReadFault, HttpReplayReadFragmentLimit, HttpReplayReadTimeoutAt, HttpReplayStats, HttpReplayWriteComplete, HttpReplayWriteFault, HttpReplayWriteFragmentLimit, http_client_with_replay, http_replay_fixture, http_replay_stats}
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyIO, HttpBodyReadData, HttpBodyReadEnd, HttpBodyReadEndClosed, HttpBodyReadFailed, HttpBodyTransport, HttpBodyUnexpectedEof, HttpBodyFinished, HttpBodyFinishedClosed, http_body_cancel, http_body_finish, http_body_read, http_connection_close}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportReadTimeout, HttpTransportRelease, HttpTransportReplayConsumed, HttpTransportWriteMismatch}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url

fn replay_request() -> HttpRequestHead {
  http.request(
    HttpGet,
    http.parse_request_target("/alpha").unwrap(),
    Http11,
    http.headers().append(
      http.header(
        http.parse_field_name("Host").unwrap(),
        bytes.from_str("example.com")
      ).unwrap()
    ),
    http.default_limits()
  ).unwrap()
}

fn replay_request_wire() -> Bytes {
  bytes.from_str("GET /alpha HTTP/1.1\r\nhost: example.com\r\n\r\n")
}

fn replay_successful_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 5
        HttpClientResponseReady(head, reader) -> match http_body_read(reader, __i64_to_usize(2)) {
          HttpBodyReadData(second, first) -> match http_body_read(second, __i64_to_usize(3)) {
            HttpBodyReadData(last, rest) -> if first.to_utf8().unwrap() != "he" or
              rest.to_utf8().unwrap() != "llo" { 6 }
            else { match http_body_read(last, __i64_to_usize(3)) {
                HttpBodyReadEndClosed(trailers) -> 0
                _ -> 7
              } }
            _ -> 8
          }
          _ -> 9
        }
      }
    }
  }
}

fn replay_response_timeout(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportReadTimeout(offset)))) ->
          __u64_to_i64(__usize_to_u64(offset))
        _ -> 2
      }
      _ -> 3
    }
  }
}

fn replay_truncated_body(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, reader) -> match http_body_read(reader, __i64_to_usize(8)) {
          HttpBodyReadData(returned, data) -> match http_body_read(returned, __i64_to_usize(8)) {
            HttpBodyReadFailed(failed, HttpBodyUnexpectedEof(remaining)) ->
              __u64_to_i64(__usize_to_u64(remaining))
            _ -> 3
          }
          _ -> 4
        }
      }
      _ -> 5
    }
  }
}

fn replay_malformed_head(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(HttpExchangeProtocol(error)) -> 0
        _ -> 2
      }
      _ -> 3
    }
  }
}

fn replay_write_mismatch(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportWriteMismatch(offset)))) ->
      __u64_to_i64(__usize_to_u64(offset))
    HttpClientRequestReady(writer) -> {
      let cancelled = http_body_cancel(writer)
      0 - 1
    }
    _ -> 0 - 2
  }
}

fn replay_repeated_begin(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  let first = HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  )
  match first {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> {
      let closed = http_body_cancel(writer)
      match HttpClient<HttpReplayTransportState>.begin(
        url.parse("https://example.com/alpha").unwrap(),
        replay_request(),
        http.default_limits()
      ) {
        HttpClientRequestFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportReplayConsumed))) -> 0
        _ -> 2
      }
    }
  }
}

fn replay_pool_refusal_round_trip(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, reader) -> match http_body_read(reader, __i64_to_usize(1)) {
          HttpBodyReadEnd(connection, trailers) -> {
            let zero: owned HttpConnectionPool<HttpReplayTransportState> = http_connection_pool<HttpReplayTransportState>(0).unwrap()
            match http_pool_release(zero, connection) {
              HttpPoolAtCapacity(returned, rejected) -> {
                let dropped = returned.drop()
                match http_connection_close(rejected) {
                  Ok(done) -> dropped
                  Err(error) -> 3
                }
              }
              _ -> 4
            }
          }
          _ -> 5
        }
      }
      _ -> 6
    }
  }
}

fn replay_rejects_ordinary_upgrade(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientUpgradeFailed(HttpExchangeExpectedProtocolSwitch(HttpContentLength(count))) ->
          __u64_to_i64(__usize_to_u64(count))
        HttpClientUpgradeReady(head, returned) -> {
          let dropped = returned.drop()
          2
        }
        _ -> 3
      }
      _ -> 4
    }
  }
}

fn replay_fixture_ok(input: Bytes, expected: Bytes) -> HttpReplayFixture {
  http_replay_fixture(
    input,
    expected,
    __i64_to_usize(3),
    __i64_to_usize(3),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

test "replay validates fragments before creating a session" {
  match http_replay_fixture(
    bytes.from_str(""),
    bytes.from_str(""),
    __i64_to_usize(0),
    __i64_to_usize(1),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ) {
    Err(HttpReplayReadFragmentLimit(limit)) -> Test.assert_eq(__u64_to_i64(__usize_to_u64(limit)), 0)
    _ -> Test.assert_true(false)
  }
  match http_replay_fixture(
    bytes.from_str(""),
    bytes.from_str(""),
    __i64_to_usize(1),
    __i64_to_usize(16385),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ) {
    Err(HttpReplayWriteFragmentLimit(limit)) -> Test.assert_eq(__u64_to_i64(__usize_to_u64(limit)), 16385)
    _ -> Test.assert_true(false)
  }
}

test "successful replay uses the same bounded client and body owners without authority" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 5\r\nconnection: close\r\n\r\nhello"),
    replay_request_wire()
  )
  Test.assert_eq(http_client_with_replay(fixture, replay_successful_exchange), 0)
  let stats = http_replay_stats(fixture)
  Test.assert_eq(stats.read_bytes, 62)
  Test.assert_eq(stats.write_bytes, 42)
  Test.assert_eq(stats.closes, 1)
  Test.assert_eq(stats.releases, 0)
  Test.assert_eq(stats.errors, 0)
  Test.assert_eq(stats.begins, 1)
}

test "replay injects an exact read timeout without network authority" {
  let fixture = http_replay_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire(),
    __i64_to_usize(4),
    __i64_to_usize(4),
    HttpReplayReadTimeoutAt(__i64_to_usize(12)),
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(http_client_with_replay(fixture, replay_response_timeout), 12)
  Test.assert_eq(http_replay_stats(fixture).errors, 1)
}

test "replay reports truncated and malformed responses through ordinary HTTP errors" {
  let truncated = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhe"),
    replay_request_wire()
  )
  Test.assert_eq(http_client_with_replay(truncated, replay_truncated_body), 3)

  let malformed = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 xyz Broken\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_client_with_replay(malformed, replay_malformed_head), 0)
}

test "replay rejects mismatched output at the exact byte" {
  let fixture = replay_fixture_ok(
    bytes.from_str(""),
    bytes.from_str("XET /alpha HTTP/1.1\r\nhost: example.com\r\n\r\n")
  )
  Test.assert_eq(http_client_with_replay(fixture, replay_write_mismatch), 0)
  Test.assert_eq(http_replay_stats(fixture).errors, 1)
}

test "one replay fixture cannot fabricate a second initial connection" {
  let fixture = replay_fixture_ok(bytes.from_str(""), replay_request_wire())
  Test.assert_eq(http_client_with_replay(fixture, replay_repeated_begin), 0)
  let stats = http_replay_stats(fixture)
  Test.assert_eq(stats.begins, 1)
  Test.assert_eq(stats.repeated_begins, 1)
}

test "zero-capacity pool refusal preserves the exact replay connection owner" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_client_with_replay(fixture, replay_pool_refusal_round_trip), 0)
  let stats = http_replay_stats(fixture)
  Test.assert_eq(stats.closes, 1)
  Test.assert_eq(stats.releases, 0)
}

test "protocol upgrade rejects an ordinary response and releases its owner" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_client_with_replay(fixture, replay_rejects_ordinary_upgrade), 0)
  let stats = http_replay_stats(fixture)
  Test.assert_eq(stats.closes, 0)
  Test.assert_eq(stats.releases, 1)
}
