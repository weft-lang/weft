use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/string.{*}
use stdlib/http as http
use stdlib/http.{HttpBodyTooLarge, Http11, HttpContentLength, HttpGet, HttpLimits, HttpRequestHead}
use stdlib/http/client as http_client
use stdlib/http/client.{HttpConnectionPool, HttpPoolAtCapacity}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady, HttpClientUpgradeFailed, HttpClientUpgradeReady, HttpExchangeBody, HttpExchangeExpectedProtocolSwitch, HttpExchangeProtocol}
use stdlib/http/replay as http_replay
use stdlib/http/replay.{HttpReplayConfigError, HttpReplayFixture, HttpReplayReadComplete, HttpReplayReadFault, HttpReplayReadFragmentLimit, HttpReplayReadTimeoutAt, HttpReplayStats, HttpReplayWriteComplete, HttpReplayWriteTimeoutAt, HttpReplayWriteFault, HttpReplayWriteFragmentLimit}
use stdlib/http/stream as http_stream
use stdlib/http/stream.{HttpBodyProtocol, HttpBodyStream, HttpBodyFragmentLimit, HttpBodyWrote, HttpBodyWriteIncomplete, HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyIO, HttpBodyReadData, HttpBodyReadEnd, HttpBodyReadEndClosed, HttpBodyReadFailed, HttpBodyTransport, HttpBodyUnexpectedEof, HttpBodyFinished, HttpBodyFinishedClosed}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportReadTimeout, HttpTransportRelease, HttpTransportReplayConsumed, HttpTransportWriteMismatch}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url

fn replay_request() -> HttpRequestHead {
  http.request(
    HttpGet,
    http.parse_request_target("/alpha").unwrap(),
    Http11,
    http.headers().append(
    http.header(
    http.parse_field_name("Host").unwrap(),
    bytes.from_str("example.com")
  ).unwrap()
  ),
    http.default_limits()
  ).unwrap()
}

fn replay_request_wire() -> Bytes {
  bytes.from_str("GET /alpha HTTP/1.1\r\nhost: example.com\r\n\r\n")
}

fn replay_successful_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 5
        HttpClientResponseReady(head, reader) -> match reader.read(2) {
          HttpBodyReadData(second, first) -> match second.read(3) {
            HttpBodyReadData(last, rest) -> if first.to_utf8().unwrap() != "he" or
              rest.to_utf8().unwrap() != "llo" { 6 }
            else { match last.read(3) {
                HttpBodyReadEndClosed(trailers) -> 0
                _ -> 7
              } }
            _ -> 8
          }
          _ -> 9
        }
      }
    }
  }
}

fn replay_response_timeout(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportReadTimeout(offset)))) ->
          if offset == 12 { 0 } else { 4 }
        _ -> 2
      }
      _ -> 3
    }
  }
}

fn replay_truncated_body(
  expected: usize, limits: HttpLimits
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    limits
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        limits
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, reader) -> {
          let mut current: owned HttpBodyStream<HttpReplayTransportState> = reader
          let mut received = ""
          loop {
            match current.read(8) {
              HttpBodyReadData(returned, data) -> { received = received.concat(data.to_utf8().unwrap()); current = returned }
              HttpBodyReadFailed(failed, HttpBodyUnexpectedEof(remaining)) -> {
                return if remaining == expected and received == "he" { 0 } else { 6 }
              }
              _ -> return 3
            }
          }
        }
      }
      _ -> 5
    }
  }
}

fn replay_malformed_head(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(HttpExchangeProtocol(error)) -> 0
        _ -> 2
      }
      _ -> 3
    }
  }
}

fn replay_write_mismatch(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportWriteMismatch(offset)))) ->
      if offset == 0 { 0 } else { 1 }
    HttpClientRequestReady(writer) -> {
      let cancelled = writer.cancel()
      0 - 1
    }
    _ -> 0 - 2
  }
}

fn replay_repeated_begin(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  let first = HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  )
  match first {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> {
      let closed = writer.cancel()
      match HttpClient<HttpReplayTransportState>.begin(
        url.parse("https://example.com/alpha").unwrap(),
        replay_request(),
        http.default_limits()
      ) {
        HttpClientRequestFailed(HttpExchangeBody(HttpBodyTransport(HttpTransportReplayConsumed))) -> 0
        _ -> 2
      }
    }
  }
}

fn replay_pool_refusal_round_trip(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, reader) -> match reader.read(1) {
          HttpBodyReadEnd(connection, trailers) -> {
            let zero: owned HttpConnectionPool<HttpReplayTransportState> = http_client.pool<HttpReplayTransportState>(0).unwrap()
            match zero.release(connection) {
              HttpPoolAtCapacity(returned, rejected) -> {
                let dropped = returned.drop()
                match rejected.close() {
                  Ok(done) -> dropped
                  Err(error) -> 3
                }
              }
              _ -> 4
            }
          }
          _ -> 5
        }
      }
      _ -> 6
    }
  }
}

fn replay_rejects_ordinary_upgrade(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/alpha").unwrap(),
    replay_request(),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientUpgradeFailed(HttpExchangeExpectedProtocolSwitch(HttpContentLength(count))) ->
          if count == 0 { 0 } else { 1 }
        HttpClientUpgradeReady(head, returned) -> {
          let dropped = returned.drop()
          2
        }
        _ -> 3
      }
      _ -> 4
    }
  }
}

fn replay_fixture_ok(input: Bytes, expected: Bytes) -> HttpReplayFixture {
  http_replay.fixture(
    input,
    expected,
    3,
    3,
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

test "replay validates fragments before creating a session" {
  match http_replay.fixture(
    bytes.from_str(""),
    bytes.from_str(""),
    0,
    1,
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ) {
    Err(HttpReplayReadFragmentLimit(limit)) -> Test.assert_true(limit == 0)
    _ -> Test.assert_true(false)
  }
  match http_replay.fixture(
    bytes.from_str(""),
    bytes.from_str(""),
    1,
    16385,
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ) {
    Err(HttpReplayWriteFragmentLimit(limit)) -> Test.assert_true(limit == 16385)
    _ -> Test.assert_true(false)
  }
}

test "successful replay uses the same bounded client and body owners without authority" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 5\r\nconnection: close\r\n\r\nhello"),
    replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(fixture, replay_successful_exchange), 0)
  let stats = fixture.stats()
  Test.assert_true(stats.read_bytes == 62)
  Test.assert_true(stats.write_bytes == 42)
  Test.assert_true(stats.closes == 1)
  Test.assert_true(stats.releases == 0)
  Test.assert_true(stats.errors == 0)
  Test.assert_true(stats.begins == 1)
}

test "replay injects an exact read timeout without network authority" {
  let fixture = http_replay.fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire(),
    4,
    4,
    HttpReplayReadTimeoutAt(12),
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(http_replay.with_client(fixture, replay_response_timeout), 0)
  Test.assert_true(fixture.stats().errors == 1)
}

test "replay reports truncated and malformed responses through ordinary HTTP errors" {
  let truncated = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhe"),
    replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(truncated, () => replay_truncated_body(3, http.default_limits())), 0)

  let malformed = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 xyz Broken\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(malformed, replay_malformed_head), 0)
}

test "replay rejects mismatched output at the exact byte" {
  let fixture = replay_fixture_ok(
    bytes.from_str(""),
    bytes.from_str("XET /alpha HTTP/1.1\r\nhost: example.com\r\n\r\n")
  )
  Test.assert_eq(http_replay.with_client(fixture, replay_write_mismatch), 0)
  Test.assert_true(fixture.stats().errors == 1)
}

test "one replay fixture cannot fabricate a second initial connection" {
  let fixture = replay_fixture_ok(bytes.from_str(""), replay_request_wire())
  Test.assert_eq(http_replay.with_client(fixture, replay_repeated_begin), 0)
  let stats = fixture.stats()
  Test.assert_true(stats.begins == 1)
  Test.assert_true(stats.repeated_begins == 1)
}

test "zero-capacity pool refusal preserves the exact replay connection owner" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(fixture, replay_pool_refusal_round_trip), 0)
  let stats = fixture.stats()
  Test.assert_true(stats.closes == 1)
  Test.assert_true(stats.releases == 0)
}

test "protocol upgrade rejects an ordinary response and releases its owner" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n"),
    replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(fixture, replay_rejects_ordinary_upgrade), 0)
  let stats = fixture.stats()
  Test.assert_true(stats.closes == 0)
  Test.assert_true(stats.releases == 1)
}

fn replay_full_limits() -> HttpLimits {
  http.limits(8192, 8192, 65536, 128, 18446744073709551615, 8192, 65536, 128).unwrap()
}

test "replay timeout positions beyond the signed domain remain future faults" {
  let maximum: usize = 18446744073709551615
  for offset in [maximum / 2 + 1, maximum] {
    let fixture = http_replay.fixture(
      bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 5\r\nconnection: close\r\n\r\nhello"),
      replay_request_wire(), 16384, 16384,
      HttpReplayReadTimeoutAt(offset), HttpReplayWriteTimeoutAt(offset)
    ).unwrap()
    Test.assert_eq(http_replay.with_client(fixture, replay_successful_exchange), 0)
    Test.assert_eq_usize(fixture.stats().read_bytes, 62)
    Test.assert_eq_usize(fixture.stats().write_bytes, 42)
    Test.assert_eq_usize(fixture.stats().closes, 1)
    Test.assert_eq_usize(fixture.stats().releases, 0)
    Test.assert_eq_usize(fixture.stats().errors, 0)
  }
}

test "oversized replay fragments retain the exact full-width request" {
  let maximum: usize = 18446744073709551615
  let empty = bytes.from_str("")
  match http_replay.fixture(empty, empty, maximum, 1, HttpReplayReadComplete, HttpReplayWriteComplete) {
    Err(HttpReplayReadFragmentLimit(requested)) -> Test.assert_eq_usize(requested, maximum)
    _ -> Test.assert_true(false)
  }
  match http_replay.fixture(empty, empty, 1, maximum, HttpReplayReadComplete, HttpReplayWriteComplete) {
    Err(HttpReplayWriteFragmentLimit(requested)) -> Test.assert_eq_usize(requested, maximum)
    _ -> Test.assert_true(false)
  }
}

test "fixed and chunked reads report full-width remaining bytes at EOF" {
  for response in [
  "HTTP/1.1 200 OK\r\ncontent-length: 18446744073709551615\r\n\r\nhe",
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\nFFFFFFFFFFFFFFFF\r\nhe"
  ] {
    let fixture = replay_fixture_ok(bytes.from_str(response), replay_request_wire())
    Test.assert_eq(http_replay.with_client(fixture, () => replay_truncated_body(18446744073709551613, replay_full_limits())), 0)
    Test.assert_eq_usize(fixture.stats().releases, 1)
    Test.assert_eq_usize(fixture.stats().closes, 0)
    Test.assert_eq_usize(fixture.stats().errors, 0)
  }
}

fn replay_recover_oversized_read(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(url.parse("https://example.com/alpha").unwrap(), replay_request(), http.default_limits()) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(connection, HttpGet, http.default_limits()) {
        HttpClientResponseReady(head, reader) -> match reader.read(18446744073709551615) {
          HttpBodyReadFailed(returned, HttpBodyFragmentLimit(requested)) -> {
            if requested != 18446744073709551615 { return 1 }
            match returned.read(1) {
              HttpBodyReadData(last, data) -> {
                if data.to_utf8().unwrap() != "z" { return 2 }
                match last.read(1) { HttpBodyReadEndClosed(trailers) -> 0 _ -> 3 }
              }
              _ -> 4
            }
          }
          _ -> 5
        }
        _ -> 6
      }
      _ -> 7
    }
    _ -> 8
  }
}

test "an oversized body read preserves its request and reusable successor" {
  let fixture = replay_fixture_ok(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 1\r\nconnection: close\r\n\r\nz"), replay_request_wire()
  )
  Test.assert_eq(http_replay.with_client(fixture, replay_recover_oversized_read), 0)
  Test.assert_eq_usize(fixture.stats().closes, 1)
  Test.assert_eq_usize(fixture.stats().releases, 0)
}

fn replay_full_width_write(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  let request = http.request(HttpGet, http.parse_request_target("/alpha").unwrap(), Http11,
    replay_request().headers().append(http.header(http.parse_field_name("Content-Length").unwrap(), bytes.from_str("18446744073709551615")).unwrap()),
    replay_full_limits()).unwrap()
  match HttpClient<HttpReplayTransportState>.begin(url.parse("https://example.com/alpha").unwrap(), request, replay_full_limits()) {
    HttpClientRequestReady(writer) -> match writer.write(bytes.from_str("x")) {
      HttpBodyWrote(returned, count) -> {
        if count != 1 { return 1 }
        match returned.finish(http.headers()) {
          HttpBodyFinishFailed(unfinished, HttpBodyWriteIncomplete(remaining)) -> {
            if remaining != 18446744073709551614 { return 2 }
            match unfinished.cancel() { Ok(done) -> 0 Err(error) -> 3 }
          }
          _ -> 4
        }
      }
      _ -> 5
    }
    _ -> 6
  }
}

test "fixed writers preserve a full-width remaining count after progress" {
  let fixture = replay_fixture_ok(bytes.from_str(""), bytes.from_str(
    "GET /alpha HTTP/1.1\r\nhost: example.com\r\ncontent-length: 18446744073709551615\r\n\r\nx"
  ))
  Test.assert_eq(http_replay.with_client(fixture, replay_full_width_write), 0)
  Test.assert_eq_usize(fixture.stats().closes, 1)
  Test.assert_eq_usize(fixture.stats().releases, 0)
  Test.assert_eq_usize(fixture.stats().errors, 0)
}

fn replay_cumulative_budget(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  let limits = http.limits(8192, 8192, 65536, 128, 5, 8192, 65536, 128).unwrap()
  match HttpClient<HttpReplayTransportState>.begin(url.parse("https://example.com/alpha").unwrap(), replay_request(), limits) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(connection, HttpGet, limits) {
        HttpClientResponseReady(head, reader) -> {
          let mut current: owned HttpBodyStream<HttpReplayTransportState> = reader
          let mut received = ""
          loop {
            match current.read(3) {
              HttpBodyReadData(returned, data) -> { received = received.concat(data.to_utf8().unwrap()); current = returned }
              HttpBodyReadFailed(returned, HttpBodyProtocol(HttpBodyTooLarge(total))) -> {
                if total != 3 or received != "abc" { return 1 }
                return match returned.cancel() { Ok(done) -> 0 Err(error) -> 2 }
              }
              _ -> return 3
            }
          }
        }
        _ -> 4
      }
      _ -> 5
    }
    _ -> 6
  }
}

test "chunked and close-delimited streams enforce cumulative finite budgets" {
  for response in [
  "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n0\r\n\r\n",
    "HTTP/1.1 200 OK\r\nconnection: close\r\n\r\nabcdef"
  ] {
    let fixture = http_replay.fixture(bytes.from_str(response), replay_request_wire(), 16384, 16384, HttpReplayReadComplete, HttpReplayWriteComplete).unwrap()
    Test.assert_eq(http_replay.with_client(fixture, replay_cumulative_budget), 0)
    Test.assert_eq_usize(fixture.stats().closes, 1)
    Test.assert_eq_usize(fixture.stats().releases, 0)
  }
}
