use stdlib/eq.{Eq}
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result, Ok, Err}
use stdlib/list.{List, Cons, Nil}
use stdlib/list as list
use stdlib/string.{*}
use stdlib/num as num
use stdlib/num.{NumParseEmpty, NumParseInvalid, NumParseOverflow, NumParseUnderflow, NumParseTrailing, NumCastOutOfRange, NumExactIntNaN, NumExactIntNotExact}
use stdlib/persistent_vector as persistent_vector
use stdlib/ord.{Ordering, Less, Equal, Greater}

fn same_value<T: Eq>(left: T, right: T) -> bool { left == right }

test "ordering equality distinguishes every comparison result" {
  let values = [Less, Equal, Greater]
  let origin: usize = 0
  for left in origin..3 {
    for right in origin..3 {
      Test.assert_true(same_value(values[left], values[right]) == (left == right))
      Test.assert_true((values[left] != values[right]) == (left != right))
    }
  }
}

test "all integer widths expose the same Eq relation as their operators" {
  Test.assert_true(same_value<i8>(- 128, - 128))
  Test.assert_true(not same_value<i16>(- 32768, 32767))
  Test.assert_true(same_value<i32>(2147483647, 2147483647))
  Test.assert_true(same_value<i64>(- 9223372036854775808, - 9223372036854775808))
  Test.assert_true(same_value<isize>(- 1, - 1))
  Test.assert_true(same_value<u8>(255, 255))
  Test.assert_true(not same_value<u16>(65535, 0))
  Test.assert_true(same_value<u32>(4294967295, 4294967295))
  Test.assert_true(same_value<u64>(18446744073709551615, 18446744073709551615))
  Test.assert_true(same_value<usize>(0, 0))
  Test.assert_true(same_value<bool>(false, false))
  Test.assert_true(not same_value<bool>(false, true))
  Test.assert_true(same_value<nil>(nil, nil))
}

test "floating Eq preserves signed zero and unequal NaNs" {
  Test.assert_true(same_value<f64>(0.0, num.f64_from_bits(9223372036854775808)))
  Test.assert_true(same_value<f32>(0.0, num.f32_from_bits(2147483648)))
  let nan64 = num.f64_from_bits(9221120237041095221)
  let nan32 = num.f32_from_bits(2143289349)
  Test.assert_true(not same_value(nan64, nan64))
  Test.assert_true(not same_value(nan32, nan32))
  Test.assert_true(same_value<f64>(1.5, 1.5))
  Test.assert_true(not same_value<f32>(1.5, 2.5))
}

test "option equality distinguishes absence and every payload case" {
  Test.assert_true(None<i64>() == None<i64>())
  Test.assert_true(Some(0) == Some(0))
  Test.assert_true(Some(0) != None<i64>())
  Test.assert_true(None<i64>() != Some(0))
  Test.assert_true(Some(1) != Some(2))
  Test.assert_true(Some("ab") == Some("a".concat("b")))
  Test.assert_true(Some(Some(0)) != Some(None<i64>()))
  Test.assert_true(Some(None<i64>()) != None<Option<i64>>())
  Test.assert_true(Some(nil) == Some(nil))
  Test.assert_true(Some(nil) != None<nil>())
}

test "result equality checks both constructors and their payloads" {
  let ok: Result<i64, str> = Ok<i64, str>(1)
  let bad: Result<i64, str> = Err<i64, str>("ab")
  Test.assert_true(ok == Ok<i64, str>(1))
  Test.assert_true(ok != Ok<i64, str>(2))
  Test.assert_true(bad == Err<i64, str>("a".concat("b")))
  Test.assert_true(bad != Err<i64, str>("ac"))
  Test.assert_true(ok != bad)
  Test.assert_true(bad != ok)
  Test.assert_true(Ok<nil, str>(nil) == Ok<nil, str>(nil))
  Test.assert_true(Err<str, nil>(nil) == Err<str, nil>(nil))
}

test "list equality checks every element and length in order" {
  let input = [1, 2, 3]
  let changed = [1, 2, 4]
  let reversed = [3, 2, 1]
  let prefix = [1, 2]
  let values = list.from_slice(input[..])
  Test.assert_true(values == list.from_slice(input[..]))
  Test.assert_true(values != list.from_slice(changed[..]))
  Test.assert_true(values != list.from_slice(reversed[..]))
  Test.assert_true(values != list.from_slice(prefix[..]))
  Test.assert_true(list.from_slice(prefix[..]) != values)
  Test.assert_true(Nil<i64>() == Nil<i64>())
  Test.assert_true(Nil<i64>() != values)
  Test.assert_true(values != Nil<i64>())
  let text = ["ab", "cd"]
  let dynamic_text = ["a".concat("b"), "c".concat("d")]
  Test.assert_true(list.from_slice(text[..]) == list.from_slice(dynamic_text[..]))
  Test.assert_true(Cons(nil, Nil<nil>()) == Cons(nil, Nil<nil>()))
  Test.assert_true(Cons(nil, Nil<nil>()) != Nil<nil>())
}

test "list comparison handles long equal prefixes without recursion" {
  let values = list.range(0, 10000)
  Test.assert_true(values == list.range(0, 10000))
  Test.assert_true(values != list.range(0, 10001))
  Test.assert_eq_usize(values.len(), 10000)
}

test "persistent vector equality compares contents across tree boundaries" {
  let mut left = persistent_vector.new<i64>()
  let mut right = persistent_vector.new<i64>()
  Test.assert_true(left == right)
  for value in 0..1025 {
    left = left.push(value)
    right = right.push(value)
    if value == 0 or value == 30 or value == 31 or value == 32 or value == 1024 {
      Test.assert_true(left == right)
    }
  }
  Test.assert_true(left != right.push(1025))
  let changed = right.set(1024, - 1).unwrap()
  Test.assert_true(left != changed)
  Test.assert_true(changed != left)
  Test.assert_true(left == right)
  Test.assert_true(left == changed.set(1024, 1024).unwrap())
}

test "numeric error equality preserves variants and byte offsets" {
  Test.assert_true(same_value(NumCastOutOfRange, NumCastOutOfRange))
  let exact = [NumExactIntNaN, NumExactIntNotExact]
  let exact_count: usize = 2
  let exact_count_start: usize = 0
  for i in exact_count_start..exact_count {
    for j in exact_count_start..exact_count { Test.assert_true(same_value(exact[i], exact[j]) == (i == j)) }
  }
  let first = [NumParseEmpty(0), NumParseInvalid(0), NumParseOverflow(0), NumParseUnderflow(0), NumParseTrailing(0)]
  let next = [NumParseEmpty(1), NumParseInvalid(1), NumParseOverflow(1), NumParseUnderflow(1), NumParseTrailing(1)]
  let parse_count: usize = 5
  let parse_count_start: usize = 0
  for i in parse_count_start..parse_count {
    for j in parse_count_start..parse_count {
      Test.assert_true(same_value(first[i], first[j]) == (i == j))
      Test.assert_true(first[i] != next[j])
      Test.assert_true(next[i] != first[j])
    }
  }
}
