use compiler/ir.{*}
use compiler/lib.{nlist_get, nlist_len, node_f1, node_f2, src_eq}
use compiler/pipeline.{*}
use compiler/test_prepare.{*}
use stdlib/string.{str_eq}

test "test preparation preserves the exact no-wrapper source" {
  let raw = "fn helper() -> i64 { 1 }"
  let prepared = test_prepare_source(raw, 0)
  Test.assert_str_eq(test_prepare_source_content(prepared), "use stdlib/test.{*} fn helper() -> i64 { 1 }")
  Test.assert_eq(test_prepare_source_wrapper_bank_start(prepared), __str_len("use stdlib/test.{*} ") + __str_len(raw))
}

test "test preparation builds deterministic wrapper names and offsets" {
  let prepared = test_prepare_source("test \"a\" { 0 }", 12)
  let content = test_prepare_source_content(prepared)
  Test.assert_eq(if str_eq(test_prepare_wrapper_name(0), "t_0") == 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if str_eq(test_prepare_wrapper_name(10), "t_10") == 1 { 1 } else { 0 }, 1)
  Test.assert_eq(test_prepare_wrapper_name_len(9), 3)
  Test.assert_eq(test_prepare_wrapper_name_len(10), 4)
  let bank = test_prepare_source_wrapper_bank_start(prepared)
  Test.assert_eq(test_prepare_wrapper_name_offset_from_bank(bank, 0), bank + 4)
  Test.assert_eq(test_prepare_wrapper_name_offset_from_bank(bank, 1), bank + 8)
  Test.assert_eq(test_prepare_wrapper_name_offset_from_bank(bank, 10), bank + 44)
  Test.assert_eq(if __str_len(content) > bank + 4 { 1 } else { 0 }, 1)
}

test "shared preparation discovers and replaces every test declaration" {
  let raw = "test \"first\" { Test.assert_eq(1, 1) } test \"second\" { Test.assert_true(true) } fn helper() -> i64 { 3 }"
  let ast = pipeline_parse_source(__str_ptr(raw), __str_len(raw))
  let raw_fns = pipeline_ast_fns(ast)
  Test.assert_eq(test_prepare_fns_have_tests(raw_fns), 1)
  Test.assert_eq(test_prepare_fns_test_count(raw_fns), 2)

  let prepared = test_prepare_source(raw, 2)
  let content = test_prepare_source_content(prepared)
  let prepared_ast = pipeline_parse_source(__str_ptr(content), __str_len(content))
  match prepared_ast {
    AstModule(fns, src, tt) -> {
      let wrapped = test_prepare_wrap_fns(fns, test_prepare_source_wrapper_bank_start(prepared), tt)
      Test.assert_eq(test_prepare_fns_have_tests(wrapped), 0)
      Test.assert_eq(nlist_len(wrapped), nlist_len(fns))
      let mut wrappers = 0
      for i in 0..nlist_len(wrapped) {
        let pair = nlist_get(wrapped, i)
        match decl_from_node(node_f1(pair)) {
          FnDecl(ns, nl, params, body) -> {
            if src_eq(node_f2(pair), ns, nl, "t_0") == 1 or src_eq(node_f2(pair), ns, nl, "t_1") == 1 {
              wrappers = wrappers + 1
            } else { 0 }
          }
          FnDeclWrapped(FnDecl(ns, nl, params, body), ret_type, eff_sig, tparams) -> {
            if src_eq(node_f2(pair), ns, nl, "t_0") == 1 or src_eq(node_f2(pair), ns, nl, "t_1") == 1 {
              wrappers = wrappers + 1
            } else { 0 }
          }
          _ -> 0
        }
      }
      Test.assert_eq(wrappers, 2)
    }
  }
}
