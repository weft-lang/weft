use runtime/alloc.{*}
use runtime/rc_implicit_test.{*}
use runtime/string.{*}
use stdlib/string.{*}
use stdlib/vector.{*}

type StringMetricBox {
  value: str
}

fn string_metric_concat_bump(count: i64) -> i64 {
  let left = "weft"
  let right = "string"
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    let value = str_concat(left, right)
    checksum = checksum + str_len(value) + str_byte_at(value, 0)
  }
  let after = alloc_bump_mark()
  if checksum == count * 129 { after - before } else { 0 - 1 }
}

fn string_metric_from_bytes_copy_bump(count: i64) -> i64 {
  let source = "bytes"
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    let value = str_from_bytes_copy(runtime_str_ptr(source), 5)
    checksum = checksum + str_len(value) + str_byte_at(value, 4)
  }
  let after = alloc_bump_mark()
  if checksum == count * 120 { after - before } else { 0 - 1 }
}

fn string_metric_int_bump(count: i64) -> i64 {
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    let value = int_to_str(123456789)
    checksum = checksum + str_len(value) + str_byte_at(value, 8)
  }
  let after = alloc_bump_mark()
  if checksum == count * 66 { after - before } else { 0 - 1 }
}

fn string_metric_borrowed_bytes_bump(count: i64) -> i64 {
  let source = "view"
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    let value = runtime_str_from_bytes(runtime_str_ptr(source), 4)
    checksum = checksum + str_len(value) + str_byte_at(value, 0)
  }
  let after = alloc_bump_mark()
  if checksum == count * 122 { after - before } else { 0 - 1 }
}

fn string_metric_empty_concat_bump(count: i64) -> i64 {
  let empty = ""
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    checksum = checksum + str_len(str_concat(empty, empty))
  }
  let after = alloc_bump_mark()
  if checksum == 0 { after - before } else { 0 - 1 }
}

fn string_metric_empty_from_bytes_bump(count: i64) -> i64 {
  let source = ""
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    checksum = checksum + str_len(runtime_str_from_bytes(runtime_str_ptr(source), 0))
  }
  let after = alloc_bump_mark()
  if checksum == 0 { after - before } else { 0 - 1 }
}

fn string_metric_zero_int_bump(count: i64) -> i64 {
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    checksum = checksum + str_len(int_to_str(0))
  }
  let after = alloc_bump_mark()
  if checksum == count { after - before } else { 0 - 1 }
}

fn string_metric_managed_graph_round() -> i64 {
  let value = str_concat("managed-", int_to_str(42))
  let alias = value
  let box = StringMetricBox { value: alias }
  let values = vector_new<str>()
  vector_push<str>(values, box.value)
  let loaded = vector_get<str>(values, 0, "")
  str_len(value) + str_len(loaded) + str_byte_at(loaded, 8)
}

fn string_metric_int_round() -> i64 {
  str_len(int_to_str(42))
}

fn string_metric_static_concat_round() -> i64 {
  str_len(str_concat("static", "-concat"))
}

fn string_metric_dynamic_arg_round() -> i64 {
  str_len(str_concat("dynamic-", int_to_str(42)))
}

fn string_metric_alias_round() -> i64 {
  let value = str_concat("alias", "-value")
  let alias = value
  str_len(value) + str_len(alias)
}

fn string_metric_record_round() -> i64 {
  let value = str_concat("record", "-value")
  let box = StringMetricBox { value: value }
  str_len(box.value)
}

fn string_metric_vector_round() -> i64 {
  let value = str_concat("vector", "-value")
  let values = vector_new<str>()
  vector_push<str>(values, value)
  str_len(vector_get<str>(values, 0, ""))
}

fn string_metric_heap_delta(kind: i64, count: i64) -> i64 {
  let mut warm = 0
  while warm < 50 {
    match kind {
      0 -> string_metric_int_round()
      1 -> string_metric_static_concat_round()
      2 -> string_metric_dynamic_arg_round()
      3 -> string_metric_alias_round()
      4 -> string_metric_record_round()
      _ -> string_metric_vector_round()
    }
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < count {
    match kind {
      0 -> string_metric_int_round()
      1 -> string_metric_static_concat_round()
      2 -> string_metric_dynamic_arg_round()
      3 -> string_metric_alias_round()
      4 -> string_metric_record_round()
      _ -> string_metric_vector_round()
    }
    i = i + 1
  }
  runtime_rc_test_heap_arena_offset() - before
}

fn string_metric_returned_value() -> str {
  str_concat("return", "-value")
}

fn string_metric_dead_weak() -> weak str {
  let value = str_concat("weak", "-value")
  weak_ref(value)
}

fn string_metric_promoted_round() -> i64 {
  let value = str_concat("promoted", "-value")
  runtime_str_promote(value)
  str_len(value)
}

fn string_metric_empty_round() -> i64 {
  let empty = runtime_str_from_bytes(0, 0)
  let negative = runtime_str_from_bytes(0, 0 - 1)
  let joined = str_concat(empty, negative)
  str_len(joined) + str_len(int_to_str(0))
}

test "dynamic string producers leave the bump arena flat" {
  -- Item 2s.6 mechanism ledger (100 lifetimes): concat 3200 -> 0,
  -- from-bytes copy 2400 -> 0, int conversion 3200 -> 0, borrowed
  -- bytes 1600 -> 0. Each old result owned a separate rounded byte
  -- buffer plus bump descriptor (or just the descriptor for borrowed
  -- bytes); each now owns one RC payload [ptr, len, inline bytes].
  Test.assert_eq(string_metric_concat_bump(100), 0)
  Test.assert_eq(string_metric_from_bytes_copy_bump(100), 0)
  Test.assert_eq(string_metric_int_bump(100), 0)
  Test.assert_eq(string_metric_borrowed_bytes_bump(100), 0)
}

test "empty dynamic string producers leave the bump arena flat" {
  -- Item 2s.6 boundary mechanism ledger (100 lifetimes): empty concat
  -- 1600 -> 0, zero-length from-bytes 1600 -> 0, zero int conversion
  -- 2400 -> 0. The builders now allocate even a zero-byte result's
  -- descriptor in its RC payload; zero int writes byte 48 inline.
  Test.assert_eq(string_metric_empty_concat_bump(100), 0)
  Test.assert_eq(string_metric_empty_from_bytes_bump(100), 0)
  Test.assert_eq(string_metric_zero_int_bump(100), 0)
}

test "managed strings and containing graphs reuse heap blocks" {
  let mut warm = 0
  while warm < 50 {
    string_metric_managed_graph_round()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 100 {
    string_metric_managed_graph_round()
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "managed string ownership cases each reuse heap blocks" {
  Test.assert_eq(string_metric_heap_delta(0, 100), 0)
  Test.assert_eq(string_metric_heap_delta(1, 100), 0)
  Test.assert_eq(string_metric_heap_delta(2, 100), 0)
  Test.assert_eq(string_metric_heap_delta(3, 100), 0)
  Test.assert_eq(string_metric_heap_delta(4, 100), 0)
  Test.assert_eq(string_metric_heap_delta(5, 100), 0)
}

test "managed string aliases aggregates vectors and returns stay live" {
  Test.assert_str_eq(string_metric_returned_value(), "return-value")
  Test.assert_eq(string_metric_managed_graph_round(), 72)
}

test "managed strings support weak and promoted lifetimes" {
  let dead = string_metric_dead_weak()
  let loaded: str | nil = weak_load(dead)
  Test.assert_eq(if loaded == nil { 1 } else { 0 }, 1)
  Test.assert_eq(string_metric_promoted_round(), 14)
}

test "empty managed string results reuse heap blocks" {
  let mut warm = 0
  while warm < 50 {
    string_metric_empty_round()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 100 {
    string_metric_empty_round()
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
  Test.assert_eq(string_metric_empty_round(), 1)
}
