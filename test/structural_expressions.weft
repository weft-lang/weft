use "runtime/rc_implicit_test.weft"

fn structural_expr_sum(value: {x: i64, y: i64}) -> i64 {
  value.x + value.y
}

fn structural_expr_make() -> {x: i64, y: i64} {
  {y: 22, x: 20}
}

fn structural_expr_choose(left: {x: i64, y: i64}, right: {x: i64, y: i64}, first: bool) -> {x: i64, y: i64} {
  if first { left } else { right }
}

fn structural_expr_generic_id<T>(value: T) -> T {
  value
}

fn structural_expr_tuple_id(value: (str, i64)) -> (str, i64) {
  value
}

fn structural_expr_tuple_make() -> (str, i64) {
  structural_expr_tuple_id(("weft", 38))
}

fn structural_expr_tuple_consume(value: (str, i64)) -> i64 {
  42
}

fn structural_expr_unit() -> () {
  ()
}

fn structural_expr_empty_record() -> {} {
  {}
}

fn structural_expr_managed_count(value: {probe: RuntimeRcProbe, n: i64}) -> i64 {
  runtime_rc_probe_count(value.probe) * 10 + value.n
}

effect StructuralExprRound {
  fn round(value: {x: i64, y: i64}) -> {x: i64, y: i64}
}

fn structural_expr_perform(value: {x: i64, y: i64}) -[StructuralExprRound]> {x: i64, y: i64} {
  StructuralExprRound.round(value)
}

fn structural_expr_handle(value: {x: i64, y: i64}) -> i64 {
  let result = handle structural_expr_perform(value) {
    StructuralExprRound.round(seen) -> resume(seen)
  }
  result.x + result.y
}

test "anonymous record literals use canonical field order" {
  Test.assert_eq(structural_expr_sum({y: 22, x: 20}), 42)
  Test.assert_eq(structural_expr_sum(structural_expr_make()), 42)
}

test "anonymous record fields evaluate in source order" {
  let mut state = 0
  let value = {
    b: { state = state * 10 + 2 state },
    a: { state = state + 1 state },
  }
  Test.assert_eq(value.a * 10 + value.b, 32)
}

test "anonymous records cross CFG joins with every lane" {
  let first = structural_expr_choose({y: 1, x: 41}, {x: 1, y: 2}, true)
  let second = structural_expr_choose({x: 1, y: 2}, {y: 1, x: 41}, false)
  Test.assert_eq(first.x + first.y, 42)
  Test.assert_eq(second.x + second.y, 42)
}

test "generic calls preserve anonymous structural shapes" {
  let value = structural_expr_generic_id<{x: i64, y: i64} >({y: 2, x: 40})
  Test.assert_eq(value.x + value.y, 42)
}

test "tuple literals cross calls and returns" {
  Test.assert_eq(structural_expr_tuple_consume(structural_expr_tuple_make()), 42)
  Test.assert_eq(structural_expr_tuple_consume(("ignored", 0)), 42)
}

test "empty tuple and record literals cross call boundaries" {
  let unit = structural_expr_unit()
  let record = structural_expr_empty_record()
  Test.assert_eq(42, 42)
}

test "managed anonymous fields balance call ownership" {
  let probe = runtime_rc_probe_new(2)
  Test.assert_eq(structural_expr_managed_count({n: 2, probe: probe}), 22)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "effect transport preserves anonymous structural values" {
  Test.assert_eq(structural_expr_handle({y: 20, x: 22}), 42)
}

test "closures capture anonymous structural values" {
  let value = {name: "weft", n: 38}
  let read = () => __str_len(value.name) + value.n
  Test.assert_eq(read(), 42)
}
