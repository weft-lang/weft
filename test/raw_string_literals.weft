-- Raw string literals: `r`, one or more `#`, a quote, any bytes, a quote
-- followed by the same number of `#`. The value is exactly the source bytes
-- between the delimiters: no escapes, no interpolation, any line count.

use stdlib/string.{str_concat}

test "a raw string keeps backslashes and quotes literally" {
  Test.assert_str_eq(r#"a\nb"#, "a\\nb")
  Test.assert_str_eq(r#"say "hi""#, "say \"hi\"")
  Test.assert_str_eq(r#"\"#, "\\")
  Test.assert_eq_usize(r#"\n"#.len(), __i64_to_usize(2))
}

test "a raw string may span lines and is the same value as its escaped spelling" {
  let raw = r#"select id
from users"#
  Test.assert_str_eq(raw, "select id\nfrom users")
  Test.assert_true(raw == "select id\nfrom users")
}

test "more hashes let a quote-hash pair appear in the text" {
  Test.assert_str_eq(r##"one "# inside"##, "one \"# inside")
  Test.assert_str_eq(r###"two "## inside"###, "two \"## inside")
  Test.assert_str_eq(r##""##, "")
  Test.assert_str_eq(r#""#, "")
}

test "braces and interpolation markers in a raw string are ordinary text" {
  Test.assert_str_eq(r#"{name} and {{x}}"#, "{name} and {{x}}")
  let name = "weft"
  Test.assert_str_eq(i"{r#"{"#}{name}{r#"}"#}", "{weft}")
}

test "a raw string is a plain str value" {
  let text = r#"raw"#
  Test.assert_str_eq(str_concat(text, "!"), "raw!")
  Test.assert_true(text.starts_with("ra"))
  Test.assert_str_eq(i"[{text}]", "[raw]")
}
