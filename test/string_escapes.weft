-- test/string_escapes.weft — string literal escape decoding
--
-- The lexer's escape table is a language surface: a wrong byte here is a
-- silent miscompile in every consumer, not a parse error. `\r` was decoded as
-- the letter `r` until the trust root that introduced these tests, which made
-- the formatter's carriage-return branch dead.

use stdlib/string.{str_byte_at, str_len}

fn escape_bytes(value: str) -> i64 {
  let mut packed = 0
  for index in 0..str_len(value) {
    packed = packed * 256 + str_byte_at(value, index)
  }
  packed
}

test "every decoded escape produces its exact byte" {
  Test.assert_eq(str_byte_at("\n", 0), 10)
  Test.assert_eq(str_byte_at("\r", 0), 13)
  Test.assert_eq(str_byte_at("\t", 0), 9)
  Test.assert_eq(str_byte_at("\\", 0), 92)
  Test.assert_eq(str_byte_at("\"", 0), 34)
  Test.assert_eq(str_byte_at("\0", 0), 0)
  Test.assert_eq(str_len("\n\r\t\\\"\0"), 6)
}

test "escapes compose with ordinary bytes and keep source order" {
  Test.assert_eq(escape_bytes("\r\n"), 13 * 256 + 10)
  Test.assert_eq(escape_bytes("a\r\nb"), ((97 * 256 + 13) * 256 + 10) * 256 + 98)
  Test.assert_eq(str_len("line\r\n"), 6)

  -- A carriage return is one byte, so a CRLF document is not shortened or
  -- normalized on the way through the lexer.
  let document = "first\r\nsecond\r\n"
  Test.assert_eq(str_len(document), 15)
  Test.assert_eq(str_byte_at(document, 5), 13)
  Test.assert_eq(str_byte_at(document, 6), 10)
  Test.assert_eq(str_byte_at(document, 13), 13)
  Test.assert_eq(str_byte_at(document, 14), 10)
}

test "a backslash escape never consumes more than its own pair" {
  -- `\\` is a literal backslash: the following character stays ordinary.
  Test.assert_eq(escape_bytes("\\n"), 92 * 256 + 110)
  Test.assert_eq(escape_bytes("\\r"), 92 * 256 + 114)
  Test.assert_eq(str_len("\\\\"), 2)

  -- A NUL escape is a real interior byte, not a terminator.
  Test.assert_eq(str_len("a\0b"), 3)
  Test.assert_eq(str_byte_at("a\0b", 2), 98)
}

test "an unrecognized escape currently yields its bare character" {
  -- Recorded, not endorsed: the lexer has no diagnostic for an escape outside
  -- the decoded set, so `\q` and `\u` silently lose the backslash. Closing
  -- this belongs with the surface-honesty owner; pinning it here keeps the
  -- hole visible instead of silent.
  Test.assert_eq(str_len("\q"), 1)
  Test.assert_eq(str_byte_at("\q", 0), 113)
  Test.assert_eq(str_len("\u0041"), 5)
  Test.assert_eq(escape_bytes("\u0041"), (((117 * 256 + 48) * 256 + 48) * 256 + 52) * 256 + 49)
}
