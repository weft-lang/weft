-- Owned temporaries moved into owned call parameters, effect parameters and
-- owned slots transfer as one resource: each runs Drop once and releases the
-- storage it holds, so shared managed data returns to its baseline count.

use runtime/rc.{rc_count}
use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

type Token { log: F64Table, text: str, value: i64 }

impl Drop for Token {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    nil
  }
}

effect Take { fn take(token: owned Token) -> i64 }

fn consume(token: owned Token) -> i64 { token.value }

type Holder { held: owned Token }

fn hold(log: F64Table, text: str) -> i64 {
  let holder = Holder { held: Token { log: log, text: text, value: 1 } }
  let { held } = holder
  consume(held)
}

test "owned temporaries passed to calls, effects and slots are all released" {
  let log = table.filled(1, 1, 0.0).unwrap()
  let text = "shared ".concat("text")
  let mut total = 0
  for i in 0..200 {
    total = total + consume(Token { log: log, text: text, value: i })
    total = total + handle Take.take(Token { log: log, text: text, value: 1 }) {
      Take.take(token) -> resume(token.value)
    }
    total = total + hold(log, text)
  }
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 600.0)
  Test.assert_eq(rc_count(__str_ptr(text) - 16), 1)
}
