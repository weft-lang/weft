use compiler/source_input.{source_from_text}
use compiler/pipeline.{pipeline_check_loaded_declarations, pipeline_parse_local, pipeline_ast_fns}
use compiler/type_registry.{ttable_new, ttable_register_source}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/diagnostic/registry
use stdlib/list.{List, Cons, Nil}
use stdlib/state as state
use stdlib/panic.{panic}

fn record_diagnostics(source: str) -> (i64, List<Diagnostic>) {
  let table = ttable_new()
  let buffer = __str_ptr(source)
  ttable_register_source(table, buffer, __str_len(source), 0, 0)
  state.run(Nil<Diagnostic>(), () => handle {
    let ast = pipeline_parse_local(source_from_text(source), table)
    let functions = pipeline_ast_fns(ast)
    pipeline_check_loaded_declarations(functions, buffer, table)
  } {
    Diagnose.report(diagnostic) -> {
      state.modify((reports: List<Diagnostic>) => Cons(diagnostic, reports))
      resume(0)
    }
    Diagnose.error(message, position) -> panic(message)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

fn record_reason(fields: DiagnosticFieldList) -> str {
  match fields {
    DiagnosticFieldNil -> ""
    DiagnosticFieldCons(DiagnosticFieldText(name, value), rest) -> if name == "reason" { value } else { record_reason(rest) }
    DiagnosticFieldCons(_, rest) -> record_reason(rest)
  }
}

fn record_count(fields: DiagnosticFieldList, name: str) -> Option<i64> {
  match fields {
    DiagnosticFieldNil -> None<i64>()
    DiagnosticFieldCons(DiagnosticFieldI64(key, value), rest) -> if key == name { Some(value) } else { record_count(rest, name) }
    DiagnosticFieldCons(_, rest) -> record_count(rest, name)
  }
}

test "record arity diagnostics preserve counts and both source locations" {
  let source = "type Box<T> { value: T } fn bad() -> i64 { let box = Box<i64, str> { value: 1 } 0 }"
  let (errors, reports) = record_diagnostics(source)
  Test.assert_eq(errors, 1)
  match reports {
    Cons(diagnostic, Nil) -> {
      Test.assert_true(diagnostic.code().eq(registry.invalid_record_arguments()))
      Test.assert_str_eq(record_reason(diagnostic.fields()), "argument_count")
      Test.assert_true(match record_count(diagnostic.fields(), "expected") { Some(value) -> value == 1, None -> false })
      Test.assert_true(match record_count(diagnostic.fields(), "actual") { Some(value) -> value == 2, None -> false })
      Test.assert_true(match diagnostic.primary() {
        DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end) -> buffer == __str_ptr(source) and start == 53 and end == 56
        _ -> false
      })
      Test.assert_true(match diagnostic.related() {
        DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end)), DiagnosticRelatedLocationNil) ->
          label == "record declared here" and buffer == __str_ptr(source) and start == 5 and end == 8
        _ -> false
      })
    }
    _ -> Test.assert_true(false)
  }
}

test "unresolved phantom arguments do not cascade unknown field diagnostics" {
  let source = "type Marker<T> { tag: i64 } fn bad() -> i64 { let marker = Marker { tag: 1 } 0 }"
  let (errors, reports) = record_diagnostics(source)
  Test.assert_eq(errors, 1)
  match reports {
    Cons(diagnostic, Nil) -> {
      Test.assert_true(diagnostic.code().eq(registry.invalid_record_arguments()))
      Test.assert_str_eq(record_reason(diagnostic.fields()), "unresolved_arguments")
      Test.assert_true(match record_count(diagnostic.fields(), "expected") { Some(value) -> value == 1, None -> false })
      Test.assert_true(match record_count(diagnostic.fields(), "actual") { None -> true, _ -> false })
    }
    _ -> Test.assert_true(false)
  }
}
