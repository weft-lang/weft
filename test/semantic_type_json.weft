use stdlib/json as json
use stdlib/json.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/semantic_type/json as codec
use stdlib/string.{str_eq}

fn primitive(name: str) -> SemanticTypeFact { SemanticTypePrimitive(name) }

fn types2(first: SemanticTypeFact, second: SemanticTypeFact) -> SemanticTypeFactList {
  SemanticTypeFactListCons(first, SemanticTypeFactListCons(second, SemanticTypeFactListNil))
}

fn closed_effects(name: str) -> SemanticEffectSetFact {
  SemanticEffectsClosed(
    SemanticEffectAtomFactListCons(
      SemanticEffectAtom(
        name,
        SemanticTypeFactListCons(primitive("i64"), SemanticTypeFactListNil)
      ),
      SemanticEffectAtomFactListNil
    )
  )
}

fn sample_record() -> SemanticTypeFact {
  SemanticTypeRecord(
    SemanticRecordFieldFactListCons(
      SemanticRecordField("id", 0, primitive("i64")),
      SemanticRecordFieldFactListCons(
        SemanticRecordField("name", 1, SemanticTypeOwned(primitive("str"))),
        SemanticRecordFieldFactListNil
      )
    ),
    false,
    false
  )
}

fn sample_function() -> SemanticTypeFact {
  SemanticTypeFunction(
    types2(sample_record(), SemanticTypeBorrow(primitive("bool"), true)),
    SemanticTypeUnion(
      primitive("i64"),
      SemanticTypeNamed("Option", types2(primitive("str"), SemanticTypeVariable("T")))
    ),
    SemanticEffectsOpen(
      SemanticEffectAtomFactListCons(
        SemanticQualifiedEffectAtom("stdlib/file", "FileRead", SemanticTypeFactListNil),
        SemanticEffectAtomFactListNil
      ),
      "e"
    )
  )
}

-- Structural equality over the encoded text: two facts are the same when
-- their canonical documents match byte for byte.
fn same(left: SemanticTypeFact, right: SemanticTypeFact) -> bool {
  match (json_stringify(codec.encode_type(left)), json_stringify(codec.encode_type(right))) {
    (Ok(a), Ok(b)) -> str_eq(a, b) == 1
    _ -> false
  }
}

fn round_trip(fact: SemanticTypeFact) -> bool {
  match json_stringify(codec.encode_type(fact)) {
    Err(_) -> false
    Ok(text) -> match json.parse(text) {
      Err(_) -> false
      Ok(parsed) -> match codec.decode_type(parsed) {
        Err(_) -> false
        Ok(decoded) -> same(decoded, fact)
      }
    }
  }
}

fn decode_text(text: str) -> Result<SemanticTypeFact, codec.SemanticJsonError> {
  match json.parse(text) {
    Err(_) -> Err<SemanticTypeFact, codec.SemanticJsonError>(
      codec.SemanticJsonShape("document", "json")
    )
    Ok(parsed) -> codec.decode_type(parsed)
  }
}

test "every leaf type fact survives a text round trip" {
  Test.assert_true(round_trip(SemanticTypeBottom))
  Test.assert_true(round_trip(SemanticTypeTop))
  Test.assert_true(round_trip(primitive("i64")))
  Test.assert_true(round_trip(SemanticTypeVariable("T")))
  Test.assert_true(round_trip(SemanticTypeTrait("Display")))
  Test.assert_true(round_trip(SemanticTypeQualifiedTrait("stdlib/eq", "Eq")))
  Test.assert_true(round_trip(SemanticTypeOther("opaque-ish")))
}

test "every composite type fact survives a text round trip" {
  Test.assert_true(
    round_trip(SemanticTypeNamed("List", types2(primitive("i64"), SemanticTypeTop)))
  )
  Test.assert_true(
    round_trip(SemanticTypeQualifiedNamed("stdlib/list", "List", SemanticTypeFactListNil))
  )
  Test.assert_true(round_trip(SemanticTypeUnion(primitive("i64"), primitive("str"))))
  Test.assert_true(
    round_trip(SemanticTypeIntersection(SemanticTypeTrait("A"), SemanticTypeTrait("B")))
  )
  Test.assert_true(round_trip(SemanticTypeComplement(primitive("nil"))))
  Test.assert_true(round_trip(sample_function()))
  Test.assert_true(round_trip(sample_record()))
  Test.assert_true(round_trip(SemanticTypeRecord(SemanticRecordFieldFactListNil, true, true)))
  Test.assert_true(round_trip(SemanticTypeContinuation(primitive("i64"), primitive("nil"))))
  Test.assert_true(round_trip(SemanticTypePointer(primitive("u8"), true)))
  Test.assert_true(
    round_trip(SemanticTypeWeak(SemanticTypeNamed("Node", SemanticTypeFactListNil)))
  )
  Test.assert_true(
    round_trip(
      SemanticTypeUnique(SemanticTypeNamed("Vector", types2(primitive("u8"), primitive("u8"))))
    )
  )
  Test.assert_true(
    round_trip(SemanticTypeOwned(SemanticTypeNamed("FileHandle", SemanticTypeFactListNil)))
  )
  Test.assert_true(round_trip(SemanticTypeBorrow(primitive("str"), false)))
  Test.assert_true(round_trip(SemanticTypeArray(primitive("u8"), 32)))
  Test.assert_true(round_trip(SemanticTypeSlice(primitive("u8"), true)))
  Test.assert_true(round_trip(SemanticTypeAssociated(SemanticTypeVariable("G"), "Syntax")))
}

test "list terminators and open families survive a text round trip" {
  Test.assert_true(round_trip(SemanticTypeNamed("Weird", SemanticTypeFactListOther("truncated"))))
  Test.assert_true(
    round_trip(
      SemanticTypeNamed(
        "Mixed",
        SemanticTypeFactListCons(SemanticTypeOther("x"), SemanticTypeFactListOther("rest"))
      )
    )
  )
  Test.assert_true(
    round_trip(
      SemanticTypeRecord(
        SemanticRecordFieldFactListCons(
          SemanticRecordFieldOther("hidden"),
          SemanticRecordFieldFactListOther("more")
        ),
        false,
        false
      )
    )
  )
  Test.assert_true(
    round_trip(
      SemanticTypeFunction(
        SemanticTypeFactListNil,
        primitive("nil"),
        SemanticEffectsOther("unknown")
      )
    )
  )
  Test.assert_true(
    round_trip(
      SemanticTypeFunction(
        SemanticTypeFactListNil,
        primitive("nil"),
        SemanticEffectsClosed(
          SemanticEffectAtomFactListCons(
            SemanticEffectAtomOther("?"),
            SemanticEffectAtomFactListOther("...")
          )
        )
      )
    )
  )
  Test.assert_true(
    round_trip(
      SemanticTypeFunction(SemanticTypeFactListNil, primitive("nil"), closed_effects("State"))
    )
  )
}

test "the encoding is the tool vocabulary" {
  match json_stringify(
    codec.encode_type(SemanticTypeNamed("List", types2(primitive("i64"), SemanticTypeTop)))
  ) {
    Ok(text) -> Test.assert_str_eq(
      text,
      "{\"kind\":\"named\",\"name\":\"List\",\"arguments\":[{\"kind\":\"primitive\",\"name\":\"i64\"},{\"kind\":\"top\"}]}"
    )
    Err(_) -> Test.assert_true(false)
  }
  match json_stringify(
    codec.encode_type(SemanticTypeNamed("Weird", SemanticTypeFactListOther("truncated")))
  ) {
    Ok(text) -> Test.assert_str_eq(
      text,
      "{\"kind\":\"named\",\"name\":\"Weird\",\"arguments\":[{\"kind\":\"list_other\",\"name\":\"truncated\"}]}"
    )
    Err(_) -> Test.assert_true(false)
  }
  match json_stringify(codec.encode_effect_set(closed_effects("State"))) {
    Ok(text) -> Test.assert_str_eq(
      text,
      "{\"kind\":\"closed\",\"atoms\":[{\"name\":\"State\",\"arguments\":[{\"kind\":\"primitive\",\"name\":\"i64\"}]}]}"
    )
    Err(_) -> Test.assert_true(false)
  }
}

test "decoding rejects unknown kinds and missing or misshapen members" {
  Test.assert_true(
    match decode_text("{\"kind\":\"galaxy\"}") {
      Err(codec.SemanticJsonUnknownKind(kind)) -> kind == "galaxy",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"primitive\"}") {
      Err(codec.SemanticJsonShape(kind, what)) -> kind == "primitive" and what == "name",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"named\",\"name\":\"List\",\"arguments\":{}}") {
      Err(codec.SemanticJsonShape(_, what)) -> what == "arguments",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"record\",\"fields\":[],\"open\":1,\"tuple\":false}") {
      Err(codec.SemanticJsonShape(_, what)) -> what == "open",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"array\",\"element\":{\"kind\":\"top\"},\"length\":\"3\"}") {
      Err(codec.SemanticJsonShape(_, what)) -> what == "length",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"union\",\"left\":{\"kind\":\"top\"}}") {
      Err(codec.SemanticJsonShape(_, what)) -> what == "right",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text("[]") {
      Err(codec.SemanticJsonShape(kind, _)) -> kind == "type",
      _ -> false
    }
  )
  Test.assert_true(
    match decode_text(
      "{\"kind\":\"function\",\"parameters\":[],\"return_type\":{\"kind\":\"top\"},\"effects\":{\"kind\":\"wide\"}}"
    ) { Err(codec.SemanticJsonUnknownKind(kind)) -> kind == "wide", _ -> false }
  )
  Test.assert_true(
    match decode_text("{\"kind\":\"named\",\"name\":\"X\",\"arguments\":[{\"kind\":\"nope\"}]}") {
      Err(codec.SemanticJsonUnknownKind(kind)) -> kind == "nope",
      _ -> false
    }
  )
}
