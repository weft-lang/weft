use stdlib/fail.{Fail}
use stdlib/eq.{Eq}
use stdlib/io/types.{IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes}
use stdlib/net_address as net
use stdlib/net_address.{SocketAddress, SocketV4}
use stdlib/result.{Err, Ok, Result}
use stdlib/tcp as tcp
use stdlib/tcp.{*}
use stdlib/tcp/connect_policy as connect_policy
use stdlib/tcp/listen_policy as listen_policy
use stdlib/test.{Test}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}
use stdlib/vector/handles.{Vector}

effect TcpPolicyResidual {
  fn tick() -> i64
}

fn tcp_contract_address() -> SocketAddress {
  SocketV4(net.ipv4(127, 0, 0, 1), 8080)
}

fn tcp_contract_other_address() -> SocketAddress {
  SocketV4(net.ipv4(127, 0, 0, 1), 8081)
}

fn tcp_contract_byte(value: i64) -> u8 {
  __u64_to_u8(__i64_to_u64(value))
}

fn tcp_contract_error_code(error: TcpError) -> i64 {
  match error {
    TcpInterrupted -> 1
    TcpWouldBlock -> 2
    TcpConnectionRefused -> 3
    TcpConnectionReset -> 4
    TcpConnectionAborted -> 5
    TcpBrokenPipe -> 6
    TcpNotConnected -> 7
    TcpAddressInUse -> 8
    TcpAddressUnavailable -> 9
    TcpNetworkUnreachable -> 10
    TcpTimedOut -> 11
    TcpPermissionDenied -> 12
    TcpPolicyDenied -> 15
    TcpResourceExhausted -> 13
    TcpInvalidProgress -> 14
    TcpPlatform(code) -> 1000 + code
  }
}

fn tcp_contract_readiness_error_code(error: TcpReadinessError) -> i64 {
  match error {
    TcpReadinessInterrupted -> 1
    TcpReadinessResourceExhausted -> 2
    TcpReadinessInvalidated -> 3
    TcpReadinessPlatform(code) -> 1000 + code
  }
}

fn tcp_contract_stream_readiness_code(
  readiness: TcpStreamReadiness
) -[TcpStreamIO]> i64 {
  match readiness {
    TcpStreamReady(stream) -> {
      let closed = stream.close()
      100
    }
    TcpStreamReadinessFailed(stream, error) -> {
      let closed = stream.close()
      tcp_contract_readiness_error_code(error)
    }
  }
}

fn tcp_contract_listener_readiness_code(
  readiness: TcpListenerReadiness
) -[TcpListenerIO]> i64 {
  match readiness {
    TcpListenerReady(listener) -> {
      let closed = listener.close()
      100
    }
    TcpListenerReadinessFailed(listener, error) -> {
      let closed = listener.close()
      tcp_contract_readiness_error_code(error)
    }
  }
}

fn tcp_contract_connect_and_close() -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let stream: owned TcpStream = tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  )?
  stream.close()?
  41
}

fn tcp_contract_connect_failure() -[TcpConnect, TcpStreamIO]> i64 {
  match tcp.connect(tcp_contract_address(), tcp.connect_options()) {
    Err(error) -> tcp_contract_error_code(error)
    Ok(stream) -> {
      stream.close()
      0
    }
  }
}

fn tcp_contract_discard_connect_result() -[TcpConnect, TcpStreamIO]> i64 {
  let acquisition: Result<owned TcpStream, TcpError> = tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  )
  42
}

fn tcp_contract_listen_accept_close() -[TcpListen, TcpListenerIO, TcpStreamIO, Fail<TcpError>]> i64 {
  let mut listener: owned TcpListener = tcp.listen(
    tcp_contract_address(),
    tcp.listen_options(16)
  )?
  let stream: owned TcpStream = listener.accept()?
  stream.close()?
  listener.close()?
  43
}

fn tcp_contract_partial_io(
  source: borrow Vector<u8>,
  destination: borrow Vector<u8>
) -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let mut stream: owned TcpStream = tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  )?
  let source_view: [u8] = source[..]
  let wrote = match stream.write(source_view)? {
    IoWroteBytes(count) -> __u64_to_i64(__usize_to_u64(count))
  }
  let destination_view: [mut u8] = destination[..]
  let read = match stream.read(destination_view)? {
    IoReadBytes(count) -> __u64_to_i64(__usize_to_u64(count))
    _ -> 0
  }
  stream.close()?
  wrote * 100 + read
}

fn tcp_contract_return_with_stream() -[TcpConnect, TcpStreamIO]> i64 {
  let stream: owned TcpStream = match tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  ) {
    Err(error) -> return 0 - tcp_contract_error_code(error)
    Ok(acquired) -> acquired
  }
  return 47
}

fn tcp_contract_abort_with_stream(
) -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let stream: owned TcpStream = tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  )?
  Fail<TcpError>.fail(TcpTimedOut)
}

test "TCP option constructors preserve explicit policy" {
  let connect = tcp.connect_options()
  let listen = tcp.listen_options(32)
  Test.assert_eq(if connect.no_delay { 1 } else { 0 }, 1)
  Test.assert_eq(if connect.keep_alive { 1 } else { 0 }, 0)
  Test.assert_eq(__u64_to_i64(__usize_to_u64(listen.backlog)), 32)
  Test.assert_eq(if listen.reuse_address { 1 } else { 0 }, 0)
}

test "TCP errors remain typed alternatives with preserved platform detail" {
  Test.assert_eq(tcp_contract_error_code(TcpInterrupted), 1)
  Test.assert_eq(tcp_contract_error_code(TcpWouldBlock), 2)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionRefused), 3)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionReset), 4)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionAborted), 5)
  Test.assert_eq(tcp_contract_error_code(TcpBrokenPipe), 6)
  Test.assert_eq(tcp_contract_error_code(TcpNotConnected), 7)
  Test.assert_eq(tcp_contract_error_code(TcpAddressInUse), 8)
  Test.assert_eq(tcp_contract_error_code(TcpAddressUnavailable), 9)
  Test.assert_eq(tcp_contract_error_code(TcpNetworkUnreachable), 10)
  Test.assert_eq(tcp_contract_error_code(TcpTimedOut), 11)
  Test.assert_eq(tcp_contract_error_code(TcpPermissionDenied), 12)
  Test.assert_eq(tcp_contract_error_code(TcpPolicyDenied), 15)
  Test.assert_eq(tcp_contract_error_code(TcpResourceExhausted), 13)
  Test.assert_eq(tcp_contract_error_code(TcpInvalidProgress), 14)
  Test.assert_eq(tcp_contract_error_code(TcpPlatform(991)), 1991)
}

test "readiness failures preserve typed detail and return every resource owner" {
  let released_streams = vector.with_capacity<i64>(3)
  let released_listeners = vector.with_capacity<i64>(1)
  let readable = handle {
    handle tcp_contract_stream_readiness_code(
      tcp_stream_from_token(91).wait_readable()
    ) {
      TcpReadiness.readable(stream) ->
        resume(TcpStreamReadinessFailed(stream, TcpReadinessInvalidated))
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released_streams, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  let writable = handle {
    handle tcp_contract_stream_readiness_code(
      tcp_stream_from_token(93).wait_writable()
    ) {
      TcpReadiness.writable(stream) ->
        resume(TcpStreamReadinessFailed(stream, TcpReadinessResourceExhausted))
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released_streams, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  let ready = handle {
    handle tcp_contract_stream_readiness_code(
      tcp_stream_from_token(97).wait_readable()
    ) {
      TcpReadiness.readable(stream) -> resume(TcpStreamReady(stream))
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released_streams, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  let acceptable = handle {
    handle tcp_contract_listener_readiness_code(
      tcp_listener_from_token(95).wait_acceptable()
    ) {
      TcpReadiness.acceptable(listener) ->
        resume(TcpListenerReadinessFailed(listener, TcpReadinessPlatform(77)))
    }
  } {
    TcpListenerIO.release(listener) -> {
      vector_push<i64>(released_listeners, tcp_listener_release_token(listener))
      resume(0)
    }
  }
  Test.assert_eq(tcp_contract_readiness_error_code(TcpReadinessInterrupted), 1)
  Test.assert_eq(readable, 3)
  Test.assert_eq(writable, 2)
  Test.assert_eq(ready, 100)
  Test.assert_eq(acceptable, 1077)
  Test.assert_eq(vector_len<i64>(released_streams), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(released_streams, 0), 91)
  Test.assert_eq(vector_get_in_bounds<i64>(released_streams, 1), 93)
  Test.assert_eq(vector_get_in_bounds<i64>(released_streams, 2), 97)
  Test.assert_eq(vector_len<i64>(released_listeners), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released_listeners, 0), 95)
}

test "single-operation connect transports and closes one owned stream" {
  let released = vector.with_capacity<i64>(1)
  let got = handle {
    handle {
      handle tcp_contract_connect_and_close() {
        Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
      }
    } {
      TcpConnect.connect(address, options) -> {
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(17)))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 41)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 17)
}

test "connect failure returns Err without fabricating a stream owner" {
  let released = vector.with_capacity<i64>(1)
  let got = handle {
    handle tcp_contract_connect_failure() {
      TcpConnect.connect(address, options) -> {
        resume(Err<owned TcpStream, TcpError>(TcpConnectionRefused))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 3)
  Test.assert_eq(vector_len<i64>(released), 0)
}

test "discarding a successful connect result structurally drops its stream" {
  let released = vector.with_capacity<i64>(1)
  let got = handle {
    handle tcp_contract_discard_connect_result() {
      TcpConnect.connect(address, options) -> {
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(19)))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 19)
}

test "listen and accept use the same one-operation owned result contract" {
  let released = vector.with_capacity<i64>(2)
  let got = handle {
    handle {
      handle {
        handle tcp_contract_listen_accept_close() {
          Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
        }
      } {
        TcpListen.listen(address, options) -> {
          resume(Ok<owned TcpListener, TcpError>(tcp_listener_from_token(23)))
        }
      }
    } {
      TcpListenerIO.accept(listener) -> {
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(29)))
      }
      TcpListenerIO.release(listener) -> {
        vector_push<i64>(released, 200 + tcp_listener_release_token(listener))
        resume(0)
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, 100 + tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 43)
  Test.assert_eq(vector_len<i64>(released), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 129)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 1), 223)
}

test "fake stream handler preserves partial write and read progress" {
  let source = vector.with_capacity<u8>(3)
  vector_push<u8>(source, tcp_contract_byte(7))
  vector_push<u8>(source, tcp_contract_byte(8))
  vector_push<u8>(source, tcp_contract_byte(9))
  let destination = vector.with_capacity<u8>(2)
  vector_push<u8>(destination, tcp_contract_byte(0))
  vector_push<u8>(destination, tcp_contract_byte(0))
  let got = handle {
    handle {
      handle tcp_contract_partial_io(source, destination) {
        Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
      }
    } {
      TcpConnect.connect(address, options) -> {
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(31)))
      }
    }
  } {
    TcpStreamIO.write(stream, buffer) -> {
      resume(Ok<IoWriteProgress, TcpError>(IoWroteBytes(__i64_to_usize(2))))
    }
    TcpStreamIO.read(stream, buffer) -> {
      buffer[__i64_to_usize(0)] = tcp_contract_byte(55)
      resume(Ok<IoReadProgress, TcpError>(IoReadBytes(__i64_to_usize(1))))
    }
    TcpStreamIO.release(stream) -> resume(0)
  }
  Test.assert_eq(got, 201)
  Test.assert_eq(__u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(destination, 0))), 55)
}

test "owned TCP streams drop exactly once on explicit return and effect abort" {
  let released = vector.with_capacity<i64>(2)
  let returned = handle {
    handle tcp_contract_return_with_stream() {
      TcpConnect.connect(address, options) ->
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(81)))
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  let aborted = handle {
    handle {
      handle tcp_contract_abort_with_stream() {
        Fail<TcpError>.fail(error) -> tcp_contract_error_code(error)
      }
    } {
      TcpConnect.connect(address, options) ->
        resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(83)))
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(returned, 47)
  Test.assert_eq(aborted, 11)
  Test.assert_eq(vector_len<i64>(released), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 81)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 1), 83)
}

fn tcp_contract_connect_policy_probe(
  source: Vector<SocketAddress>
) -[TcpConnect, TcpStreamIO, TcpPolicyResidual]> i64 {
  -- Mutation after handler entry must not widen the snapshotted policy.
  vector_push<SocketAddress>(source, tcp_contract_other_address())
  let denied = match tcp.connect(
    tcp_contract_other_address(),
    tcp.connect_options()
  ) {
    Err(TcpPolicyDenied) -> 1
    Err(error) -> 0
    Ok(stream) -> { stream.close() 0 }
  }
  let allowed = match tcp.connect(
    tcp_contract_address(),
    tcp.connect_options()
  ) {
    Err(error) -> 0
    Ok(stream) -> match stream.close() {
      Ok(nil) -> 1
      Err(error) -> 0
    }
  }
  denied + allowed + TcpPolicyResidual.tick()
}

test "outbound TCP policy snapshots exact endpoints and delegates allowed work" {
  let policy_addresses = vector.with_capacity<SocketAddress>(1)
  vector_push<SocketAddress>(policy_addresses, tcp_contract_address())
  let delegated = vector.with_capacity<SocketAddress>(1)
  let released = vector.with_capacity<i64>(1)
  let got = handle {
    handle {
      handle with connect_policy(connect_policy.allow_only(policy_addresses)) {
        tcp_contract_connect_policy_probe(policy_addresses)
      } {
        TcpConnect.connect(address, options) -> {
          vector_push<SocketAddress>(delegated, address)
          resume(Ok<owned TcpStream, TcpError>(tcp_stream_from_token(71)))
        }
      }
    } {
      TcpStreamIO.release(stream) -> {
        vector_push<i64>(released, tcp_stream_release_token(stream))
        resume(0)
      }
    }
  } {
    TcpPolicyResidual.tick() -> resume(40)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(vector_len<SocketAddress>(delegated), 1)
  Test.assert_eq(vector_get_in_bounds<SocketAddress>(delegated, 0).eq(tcp_contract_address()), true)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 71)
}

fn tcp_contract_listen_policy_probe() -[TcpListen, TcpListenerIO]> i64 {
  let denied = match tcp.listen(
    tcp_contract_address(),
    tcp.listen_options(1)
  ) {
    Err(TcpPolicyDenied) -> 1
    Err(error) -> 0
    Ok(listener) -> { listener.close() 0 }
  }
  let allowed = match tcp.listen(
    tcp_contract_other_address(),
    tcp.listen_options(2)
  ) {
    Err(error) -> 0
    Ok(listener) -> match listener.close() {
      Ok(nil) -> 1
      Err(error) -> 0
    }
  }
  denied + allowed
}

test "inbound TCP policy is distinct and delegates only its local allowlist" {
  let policy_addresses = vector.with_capacity<SocketAddress>(1)
  vector_push<SocketAddress>(policy_addresses, tcp_contract_other_address())
  let delegated = vector.with_capacity<SocketAddress>(1)
  let released = vector.with_capacity<i64>(1)
  let got = handle {
    handle with listen_policy(listen_policy.allow_only(policy_addresses)) {
      tcp_contract_listen_policy_probe()
    } {
      TcpListen.listen(address, options) -> {
        vector_push<SocketAddress>(delegated, address)
        resume(Ok<owned TcpListener, TcpError>(tcp_listener_from_token(73)))
      }
    }
  } {
    TcpListenerIO.release(listener) -> {
      vector_push<i64>(released, tcp_listener_release_token(listener))
      resume(0)
    }
  }
  Test.assert_eq(got, 2)
  Test.assert_eq(vector_len<SocketAddress>(delegated), 1)
  Test.assert_eq(vector_get_in_bounds<SocketAddress>(delegated, 0).eq(tcp_contract_other_address()), true)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 73)
}
