use stdlib/fail.{Fail}
use stdlib/io_types.{IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes}
use stdlib/net_address.{SocketAddress, SocketV4, ipv4_address}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/tcp.{*}
use stdlib/test.{Test}
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

fn tcp_contract_address() -> SocketAddress {
  SocketV4(ipv4_address(127, 0, 0, 1), 8080)
}

fn tcp_contract_byte(value: i64) -> u8 {
  __u64_to_u8(__i64_to_u64(value))
}

fn tcp_contract_error_code(error: TcpError) -> i64 {
  match error {
    TcpInterrupted -> 1
    TcpWouldBlock -> 2
    TcpConnectionRefused -> 3
    TcpConnectionReset -> 4
    TcpConnectionAborted -> 5
    TcpBrokenPipe -> 6
    TcpNotConnected -> 7
    TcpAddressInUse -> 8
    TcpAddressUnavailable -> 9
    TcpNetworkUnreachable -> 10
    TcpTimedOut -> 11
    TcpPermissionDenied -> 12
    TcpResourceExhausted -> 13
    TcpInvalidProgress -> 14
    TcpPlatform(code) -> 1000 + code
  }
}

fn tcp_contract_connect_and_close() -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let stream: owned TcpStream = tcp_connect(
    tcp_contract_address(),
    tcp_connect_options_default()
  )?
  tcp_stream_close(stream)?
  41
}

fn tcp_contract_connect_failure() -[TcpConnect, TcpStreamIO]> i64 {
  match tcp_connect(tcp_contract_address(), tcp_connect_options_default()) {
    Err(error) -> tcp_contract_error_code(error)
    Ok(stream) -> {
      tcp_stream_close(stream)
      0
    }
  }
}

fn tcp_contract_discard_connect_result() -[TcpConnect, TcpStreamIO]> i64 {
  let acquisition: Result<owned TcpStream, TcpError> = tcp_connect(
    tcp_contract_address(),
    tcp_connect_options_default()
  )
  42
}

fn tcp_contract_listen_accept_close() -[TcpListen, TcpListenerIO, TcpStreamIO, Fail<TcpError>]> i64 {
  let mut listener: owned TcpListener = tcp_listen(
    tcp_contract_address(),
    tcp_listen_options(16)
  )?
  let stream: owned TcpStream = tcp_accept(listener)?
  tcp_stream_close(stream)?
  tcp_listener_close(listener)?
  43
}

fn tcp_contract_partial_io(
  source: Vector<u8>,
  destination: Vector<u8>
) -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let mut stream: owned TcpStream = tcp_connect(
    tcp_contract_address(),
    tcp_connect_options_default()
  )?
  let source_view: [u8] = source[..]
  let wrote = match tcp_write(stream, source_view)? {
    IoWroteBytes(count) -> __u64_to_i64(__usize_to_u64(count))
  }
  let destination_view: [mut u8] = destination[..]
  let read = match tcp_read(stream, destination_view)? {
    IoReadBytes(count) -> __u64_to_i64(__usize_to_u64(count))
    _ -> 0
  }
  tcp_stream_close(stream)?
  wrote * 100 + read
}

test "TCP option constructors preserve explicit policy" {
  let connect = tcp_connect_options_default()
  let listen = tcp_listen_options(32)
  Test.assert_eq(if connect.no_delay { 1 } else { 0 }, 1)
  Test.assert_eq(if connect.keep_alive { 1 } else { 0 }, 0)
  Test.assert_eq(__u64_to_i64(__usize_to_u64(listen.backlog)), 32)
  Test.assert_eq(if listen.reuse_address { 1 } else { 0 }, 0)
}

test "TCP errors remain typed alternatives with preserved platform detail" {
  Test.assert_eq(tcp_contract_error_code(TcpInterrupted), 1)
  Test.assert_eq(tcp_contract_error_code(TcpWouldBlock), 2)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionRefused), 3)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionReset), 4)
  Test.assert_eq(tcp_contract_error_code(TcpConnectionAborted), 5)
  Test.assert_eq(tcp_contract_error_code(TcpBrokenPipe), 6)
  Test.assert_eq(tcp_contract_error_code(TcpNotConnected), 7)
  Test.assert_eq(tcp_contract_error_code(TcpAddressInUse), 8)
  Test.assert_eq(tcp_contract_error_code(TcpAddressUnavailable), 9)
  Test.assert_eq(tcp_contract_error_code(TcpNetworkUnreachable), 10)
  Test.assert_eq(tcp_contract_error_code(TcpTimedOut), 11)
  Test.assert_eq(tcp_contract_error_code(TcpPermissionDenied), 12)
  Test.assert_eq(tcp_contract_error_code(TcpResourceExhausted), 13)
  Test.assert_eq(tcp_contract_error_code(TcpInvalidProgress), 14)
  Test.assert_eq(tcp_contract_error_code(TcpPlatform(991)), 1991)
}

test "single-operation connect transports and closes one owned stream" {
  let released = vector_with_capacity<i64>(1)
  let got = handle {
    handle {
      handle tcp_contract_connect_and_close() {
        Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
      }
    } {
      TcpConnect.connect(address, options) -> {
        resume(result_ok<owned TcpStream, TcpError>(tcp_stream_from_token(17)))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 41)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 17)
}

test "connect failure returns Err without fabricating a stream owner" {
  let released = vector_with_capacity<i64>(1)
  let got = handle {
    handle tcp_contract_connect_failure() {
      TcpConnect.connect(address, options) -> {
        resume(result_err<owned TcpStream, TcpError>(TcpConnectionRefused))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 3)
  Test.assert_eq(vector_len<i64>(released), 0)
}

test "discarding a successful connect result structurally drops its stream" {
  let released = vector_with_capacity<i64>(1)
  let got = handle {
    handle tcp_contract_discard_connect_result() {
      TcpConnect.connect(address, options) -> {
        resume(result_ok<owned TcpStream, TcpError>(tcp_stream_from_token(19)))
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(vector_len<i64>(released), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 19)
}

test "listen and accept use the same one-operation owned result contract" {
  let released = vector_with_capacity<i64>(2)
  let got = handle {
    handle {
      handle {
        handle tcp_contract_listen_accept_close() {
          Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
        }
      } {
        TcpListen.listen(address, options) -> {
          resume(result_ok<owned TcpListener, TcpError>(tcp_listener_from_token(23)))
        }
      }
    } {
      TcpListenerIO.accept(listener) -> {
        resume(result_ok<owned TcpStream, TcpError>(tcp_stream_from_token(29)))
      }
      TcpListenerIO.release(listener) -> {
        vector_push<i64>(released, 200 + tcp_listener_release_token(listener))
        resume(0)
      }
    }
  } {
    TcpStreamIO.release(stream) -> {
      vector_push<i64>(released, 100 + tcp_stream_release_token(stream))
      resume(0)
    }
  }
  Test.assert_eq(got, 43)
  Test.assert_eq(vector_len<i64>(released), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 0), 129)
  Test.assert_eq(vector_get_in_bounds<i64>(released, 1), 223)
}

test "fake stream handler preserves partial write and read progress" {
  let source = vector_with_capacity<u8>(3)
  vector_push<u8>(source, tcp_contract_byte(7))
  vector_push<u8>(source, tcp_contract_byte(8))
  vector_push<u8>(source, tcp_contract_byte(9))
  let destination = vector_with_capacity<u8>(2)
  vector_push<u8>(destination, tcp_contract_byte(0))
  vector_push<u8>(destination, tcp_contract_byte(0))
  let got = handle {
    handle {
      handle tcp_contract_partial_io(source, destination) {
        Fail<TcpError>.fail(error) -> 0 - tcp_contract_error_code(error)
      }
    } {
      TcpConnect.connect(address, options) -> {
        resume(result_ok<owned TcpStream, TcpError>(tcp_stream_from_token(31)))
      }
    }
  } {
    TcpStreamIO.write(stream, buffer) -> {
      resume(result_ok<IoWriteProgress, TcpError>(IoWroteBytes(__i64_to_usize(2))))
    }
    TcpStreamIO.read(stream, buffer) -> {
      buffer[__i64_to_usize(0)] = tcp_contract_byte(55)
      resume(result_ok<IoReadProgress, TcpError>(IoReadBytes(__i64_to_usize(1))))
    }
    TcpStreamIO.release(stream) -> resume(0)
  }
  Test.assert_eq(got, 201)
  Test.assert_eq(__u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(destination, 0))), 55)
}
