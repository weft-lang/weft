use stdlib/fail.{Fail}
use stdlib/net_address.{SocketV4, ipv4_address}
use stdlib/tcp.{*}
use stdlib/test.{Test}

fn tcp_contract_address() -> SocketAddress {
  SocketV4(ipv4_address(127, 0, 0, 1), 8080)
}

fn tcp_contract_connect_failure() -[TcpConnect, TcpStreamIO, Fail<TcpError>]> i64 {
  let stream = tcp_connect(tcp_contract_address(), tcp_connect_options_default())
  0
}

fn tcp_contract_listen_failure() -[TcpListen, TcpListenerIO, Fail<TcpError>]> i64 {
  let listener = tcp_listen(tcp_contract_address(), tcp_listen_options(16))
  0
}

test "TCP option constructors preserve explicit policy" {
  let connect = tcp_connect_options_default()
  let listen = tcp_listen_options(32)
  Test.assert_eq(if connect.no_delay { 1 } else { 0 }, 1)
  Test.assert_eq(if connect.keep_alive { 1 } else { 0 }, 0)
  Test.assert_eq(__u64_to_i64(__usize_to_u64(listen.backlog)), 32)
  Test.assert_eq(if listen.reuse_address { 1 } else { 0 }, 0)
}

test "TCP error discriminators are stable and preserve platform detail" {
  Test.assert_eq(tcp_error_kind(TcpInterrupted), 1)
  Test.assert_eq(tcp_error_kind(TcpWouldBlock), 2)
  Test.assert_eq(tcp_error_kind(TcpConnectionRefused), 3)
  Test.assert_eq(tcp_error_kind(TcpConnectionReset), 4)
  Test.assert_eq(tcp_error_kind(TcpConnectionAborted), 5)
  Test.assert_eq(tcp_error_kind(TcpBrokenPipe), 6)
  Test.assert_eq(tcp_error_kind(TcpNotConnected), 7)
  Test.assert_eq(tcp_error_kind(TcpAddressInUse), 8)
  Test.assert_eq(tcp_error_kind(TcpAddressUnavailable), 9)
  Test.assert_eq(tcp_error_kind(TcpNetworkUnreachable), 10)
  Test.assert_eq(tcp_error_kind(TcpTimedOut), 11)
  Test.assert_eq(tcp_error_kind(TcpPermissionDenied), 12)
  Test.assert_eq(tcp_error_kind(TcpResourceExhausted), 13)
  Test.assert_eq(tcp_error_kind(TcpInvalidProgress), 14)
  Test.assert_eq(tcp_error_kind(TcpPlatform(991)), 15)
  Test.assert_eq(tcp_error_platform_code_or(TcpPlatform(991), 0), 991)
  Test.assert_eq(tcp_error_platform_code_or(TcpTimedOut, 77), 77)
}

test "connect failure is a typed abort and never fabricates a stream" {
  let result = handle {
    handle {
      handle tcp_contract_connect_failure() {
        TcpConnect.connect(address, options, on_error) -> on_error(TcpConnectionRefused)
      }
    } {
      TcpStreamIO.release(stream) -> resume(0)
    }
  } {
    Fail<TcpError>.fail(error) -> tcp_error_kind(error)
  }
  Test.assert_eq(result, 3)
}

test "listen failure is a typed abort and keeps authority distinct" {
  let result = handle {
    handle {
      handle tcp_contract_listen_failure() {
        TcpListen.listen(address, options, on_error) -> on_error(TcpAddressInUse)
      }
    } {
      TcpListenerIO.release(listener) -> resume(0)
    }
  } {
    Fail<TcpError>.fail(error) -> tcp_error_kind(error)
  }
  Test.assert_eq(result, 8)
}
