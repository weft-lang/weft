use stdlib/bytes.{*}
use stdlib/console.{*}
use stdlib/dir.{*}
use stdlib/file.{*}
use stdlib/io/types.{*}
use stdlib/num.{*}
use stdlib/path.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

fn path_or(result: Result<Path, PathError>) -> Path {
  match result {
    Ok(path) -> path
    Err(error) -> match path_from_utf8("") {
      Ok(empty) -> empty
      Err(other) -> path_or(path_from_bytes(bytes_empty()))
    }
  }
}

fn result_usize_or(result: Result<usize, IoError>, default: i64) -> i64 {
  match result {
    Ok(value) -> num_u64_to_i64_checked(num_usize_to_u64(value)).unwrap_or(default)
    Err(error) -> default
  }
}

fn result_bytes_or(result: Result<Bytes, IoError>) -> Bytes {
  match result {
    Ok(values) -> values
    Err(error) -> bytes_empty()
  }
}

fn result_nil_ok(result: Result<nil, IoError>) -> i64 {
  match result {
    Ok(value) -> 1
    Err(error) -> 0
  }
}

fn result_paths_len(result: Result<Vector<Path>, IoError>) -> i64 {
  match result {
    Ok(paths) -> vector_len<Path>(paths)
    Err(error) -> 0 - 1
  }
}

fn result_metadata_size(result: Result<DirMetadata, IoError>) -> i64 {
  match result {
    Ok(metadata) -> metadata.size
    Err(error) -> 0 - 1
  }
}

fn result_path_or(result: Result<Path, IoError>) -> Path {
  match result {
    Ok(path) -> path
    Err(error) -> path_or(path_from_utf8(""))
  }
}

fn exercise_file_write_modes(path: Path) -[FileWrite]> i64 {
  let values = bytes_from_str("abc")
  result_usize_or(file_create_new(path, values), 0) +
    result_usize_or(file_write_all(path, values), 0) +
    result_usize_or(file_append_all(path, values), 0) +
    result_usize_or(file_atomic_replace(path, values), 0)
}

fn exercise_console() -[ConsoleRead, ConsoleWrite]> i64 {
  let input = result_bytes_or(read_bytes(4))
  let out = result_usize_or(write_stdout(bytes_from_str("o")), 0)
  let err = result_usize_or(write_stderr(bytes_from_str("e")), 0)
  let flushed_out = result_nil_ok(flush(ConsoleStdout))
  let flushed_err = result_nil_ok(flush(ConsoleStderr))
  bytes_len(input) + out + err + flushed_out + flushed_err
}

fn exercise_dir_inspect(path: Path) -[DirInspect]> i64 {
  let listed = result_paths_len(dir_list(path))
  let followed = result_metadata_size(dir_metadata(path))
  let link = result_metadata_size(dir_symlink_metadata(path))
  let current = result_path_or(dir_current())
  listed + followed + link + path_len(current)
}

fn exercise_dir_mutate(first: Path, second: Path) -[DirMutate]> i64 {
  result_nil_ok(dir_create(first)) +
    result_nil_ok(dir_rename(first, second)) +
    result_nil_ok(dir_remove(second))
}

test "file read authority transports native path limit and bytes" {
  let expected = path_or(path_from_utf8("tmp/input.bin"))
  let log = vector_new<i64>()
  let result = handle file_read_all(expected, 64) {
    FileRead.read_all(path, limit) -> {
      vector_push<i64>(log, if path_equal(path, expected) { 1 } else { 0 })
      vector_push<i64>(log, num_u64_to_i64_checked(num_usize_to_u64(limit)).unwrap_or(0))
      resume(Ok<Bytes, IoError>(bytes_from_str("payload")))
    }
  }
  Test.assert_str_eq(match bytes_to_utf8(result_bytes_or(result)) { Ok(text) -> text Err(error) -> "bad" }, "payload")
  Test.assert_eq(vector_get_in_bounds<i64>(log, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(log, 1), 64)
}

test "file write authority preserves every declared mode" {
  let expected = path_or(path_from_utf8("tmp/output.bin"))
  let modes = vector_new<i64>()
  let path_matches = vector_new<i64>()
  let lengths = vector_new<i64>()
  let total = handle exercise_file_write_modes(expected) {
    FileWrite.write_all(path, values, mode) -> {
      vector_push<i64>(modes, file_write_mode_kind(mode))
      vector_push<i64>(path_matches, if path_equal(path, expected) { 1 } else { 0 })
      vector_push<i64>(lengths, bytes_len(values))
      resume(Ok<usize, IoError>(3))
    }
  }
  Test.assert_eq(total, 12)
  for i in 0..4 {
    Test.assert_eq(vector_get_in_bounds<i64>(modes, i), i + 1)
    Test.assert_eq(vector_get_in_bounds<i64>(path_matches, i), 1)
    Test.assert_eq(vector_get_in_bounds<i64>(lengths, i), 3)
  }
}

test "console authority keeps stdin stdout stderr and flush non-owning" {
  let events = vector_new<i64>()
  let total = handle {
    handle exercise_console() {
      ConsoleRead.read(limit) -> {
        vector_push<i64>(events, 10 + num_u64_to_i64_checked(num_usize_to_u64(limit)).unwrap_or(0))
        resume(Ok<Bytes, IoError>(bytes_from_str("in")))
      }
    }
  } {
    ConsoleWrite.write_all(stream, values) -> {
      vector_push<i64>(events, match stream { ConsoleStdout -> 1 ConsoleStderr -> 2 })
      resume(Ok<usize, IoError>(1))
    }
    ConsoleWrite.flush(stream) -> {
      vector_push<i64>(events, 20 + match stream { ConsoleStdout -> 1 ConsoleStderr -> 2 })
      resume(Ok<nil, IoError>(nil))
    }
  }
  Test.assert_eq(total, 6)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 0), 14)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 1), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 2), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 3), 21)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 4), 22)
}

test "directory inspection authority uses Path and typed results" {
  let expected = path_or(path_from_utf8("tmp"))
  let child = path_or(path_from_utf8("child"))
  let current = path_or(path_from_utf8("/work"))
  let events = vector_new<i64>()
  let total = handle exercise_dir_inspect(expected) {
    DirInspect.list(path) -> {
      vector_push<i64>(events, if path_equal(path, expected) { 1 } else { 0 })
      let paths = vector_new<Path>()
      vector_push<Path>(paths, child)
      resume(Ok<Vector<Path>, IoError>(paths))
    }
    DirInspect.stat(path) -> {
      vector_push<i64>(events, 2)
      resume(Ok<DirMetadata, IoError>(DirMetadata { exists: true, kind: DirFile, size: 20, modified_millis: 0, device: 1, inode: 2 }))
    }
    DirInspect.lstat(path) -> {
      vector_push<i64>(events, 3)
      resume(Ok<DirMetadata, IoError>(DirMetadata { exists: true, kind: DirOther, size: 21, modified_millis: 0, device: 1, inode: 3 }))
    }
    DirInspect.current() -> {
      vector_push<i64>(events, 4)
      resume(Ok<Path, IoError>(current))
    }
  }
  Test.assert_eq(total, 47)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 3), 4)
}

test "directory mutation authority distinguishes create rename and remove" {
  let first = path_or(path_from_utf8("first"))
  let second = path_or(path_from_utf8("second"))
  let events = vector_new<i64>()
  let total = handle exercise_dir_mutate(first, second) {
    DirMutate.mkdir(path) -> {
      vector_push<i64>(events, if path_equal(path, first) { 1 } else { 0 })
      resume(Ok<nil, IoError>(nil))
    }
    DirMutate.remove(path) -> {
      vector_push<i64>(events, if path_equal(path, second) { 3 } else { 0 })
      resume(Ok<nil, IoError>(nil))
    }
    DirMutate.rename(from, to) -> {
      vector_push<i64>(events, if path_equal(from, first) and path_equal(to, second) { 2 } else { 0 })
      resume(Ok<nil, IoError>(nil))
    }
  }
  Test.assert_eq(total, 3)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 2), 3)
}
