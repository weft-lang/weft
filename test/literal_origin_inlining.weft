use module_fixtures/literal_origin as origin
use module_fixtures/compiler_probe.{probe_check_source}
use compiler/ir.{*}
use compiler/pipeline.{*}
use stdlib/test.{Test}
use runtime/string.{runtime_str_from_bytes}

fn literal_message(code: i64) -> str { origin.message(code) }

test "inlined literals preserve bytes across module boundaries" {
  for i in 0..20 {
    Test.assert_str_eq(literal_message(0), "")
    Test.assert_str_eq(literal_message(1), "café λ\n")
    Test.assert_str_eq(literal_message(2), "value is unavailable")
  }
}

fn literal_origin_count(insts: IrInstList, expected: str) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrStringLit(dst, src, start, len) -> if runtime_str_from_bytes(src + start, len) == expected { 1 } else { 0 }
        _ -> 0
      }
      one + literal_origin_count(rest, expected)
    }
  }
}

fn literal_block_count(blocks: IrBlockList, expected: str) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> literal_origin_count(insts, expected) + literal_block_count(rest, expected)
  }
}

test "literal provenance survives repeated inlining into another source" {
  let source = "use module_fixtures/literal_origin as origin
fn wrap(code: i64) -> str { origin.message(code) }
fn main() -> i64 { 0 }"
  let typed = probe_check_source(__str_ptr(source), __str_len(source))
  let result = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(result), pipeline_ir_native_hash_name("wrap")) {
    IrFunctionCons(IrFunction(hash, count, blocks, src), IrFunctionNil) -> {
      Test.assert_eq(literal_block_count(blocks, "value is unavailable"), 1)
      Test.assert_eq(literal_block_count(blocks, "café λ\n"), 1)
      Test.assert_eq(literal_block_count(blocks, ""), 1)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(pipeline_ir_verify_module(result), 0)
}
