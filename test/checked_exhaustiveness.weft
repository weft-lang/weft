-- Exhaustiveness over structured pattern spaces: nested cases, products,
-- booleans, nil halves, and the rule that an imprecise arm covers nothing.

use compiler/project/identity.{
  ConstructorDeclaration,
  DeclarationIdentity,
  ModuleDeclarationIdentity,
  NamedModuleIdentity
}
use compiler/source/input.{source_from_text}
use compiler/weft/check/body/exhaustiveness.{
  CheckedPatternSpace,
  CheckedSpaceAll,
  CheckedSpaceBoolean,
  CheckedSpaceCase,
  CheckedSpaceNil,
  CheckedSpaceNonNil,
  CheckedSpaceNothing,
  CheckedSpaceProduct,
  CheckedSpaceUnion,
  checked_pattern_spaces_exhaustive
}
use stdlib/list.{List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/test.{Test}

-- Case declarations named by their offsets in one source: Circle, Square,
-- Triangle of a three-case family and Inner/Other of a two-case family.
fn case(start: usize, end: usize) -> DeclarationIdentity {
  let source = source_from_text("Circle Square Triangle Inner Other")
  ModuleDeclarationIdentity(
    NamedModuleIdentity("fixture/exhaustiveness", 1),
    ConstructorDeclaration,
    source.span(start, end).unwrap()
  )
}

fn circle() -> DeclarationIdentity { case(__i64_to_usize(0), __i64_to_usize(6)) }

fn square() -> DeclarationIdentity { case(__i64_to_usize(7), __i64_to_usize(13)) }

fn triangle() -> DeclarationIdentity { case(__i64_to_usize(14), __i64_to_usize(22)) }

fn inner() -> DeclarationIdentity { case(__i64_to_usize(23), __i64_to_usize(28)) }

fn other() -> DeclarationIdentity { case(__i64_to_usize(29), __i64_to_usize(34)) }

fn one(a: CheckedPatternSpace) -> List<CheckedPatternSpace> {
  Nil<CheckedPatternSpace>().prepend(a)
}

fn two(a: CheckedPatternSpace, b: CheckedPatternSpace) -> List<CheckedPatternSpace> {
  one(b).prepend(a)
}

fn three(
  a: CheckedPatternSpace,
  b: CheckedPatternSpace,
  c: CheckedPatternSpace
) -> List<CheckedPatternSpace> {
  two(b, c).prepend(a)
}

fn four(
  a: CheckedPatternSpace,
  b: CheckedPatternSpace,
  c: CheckedPatternSpace,
  d: CheckedPatternSpace
) -> List<CheckedPatternSpace> {
  three(b, c, d).prepend(a)
}

fn shape(declaration: DeclarationIdentity, payload: CheckedPatternSpace) -> CheckedPatternSpace {
  CheckedSpaceCase(declaration, __i64_to_usize(3), Some(one(payload)))
}

fn whole(declaration: DeclarationIdentity, total: i64) -> CheckedPatternSpace {
  CheckedSpaceCase(declaration, __i64_to_usize(total), None<List<CheckedPatternSpace>>())
}

fn pair(a: CheckedPatternSpace, b: CheckedPatternSpace) -> CheckedPatternSpace {
  CheckedSpaceProduct(two(a, b))
}

fn exhaustive(arms: List<CheckedPatternSpace>) -> bool { checked_pattern_spaces_exhaustive(arms) }

test "every case of a family, with irrefutable payloads, is exhaustive" {
  Test.assert_true(
    exhaustive(
      three(
        shape(circle(), CheckedSpaceAll),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceAll)
      )
    )
  )
  -- A wildcard arm alone, or after any refutable arm, covers everything.
  Test.assert_true(exhaustive(one(CheckedSpaceAll)))
  Test.assert_true(exhaustive(two(shape(circle(), CheckedSpaceAll), CheckedSpaceAll)))
}

test "a missing case leaves the match inexhaustive" {
  Test.assert_true(
    not exhaustive(two(shape(circle(), CheckedSpaceAll), shape(square(), CheckedSpaceAll)))
  )
  Test.assert_true(not exhaustive(Nil<CheckedPatternSpace>()))
}

test "nested cases are exhaustive when every payload combination is covered" {
  -- Circle(Inner), Circle(Other), Square(_), Triangle(_)
  Test.assert_true(
    exhaustive(
      four(
        shape(circle(), whole(inner(), 2)),
        shape(circle(), whole(other(), 2)),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceAll)
      )
    )
  )
  -- Circle(Other) is uncovered.
  Test.assert_true(
    not exhaustive(
      three(
        shape(circle(), whole(inner(), 2)),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceAll)
      )
    )
  )
}

test "a case named without payloads covers the whole case" {
  Test.assert_true(
    exhaustive(
      four(
        shape(circle(), whole(inner(), 2)),
        whole(circle(), 3),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceAll)
      )
    )
  )
}

test "products need every combination of their items" {
  Test.assert_true(
    exhaustive(
      three(
        pair(CheckedSpaceBoolean(true), CheckedSpaceBoolean(true)),
        pair(CheckedSpaceBoolean(true), CheckedSpaceBoolean(false)),
        pair(CheckedSpaceBoolean(false), CheckedSpaceAll)
      )
    )
  )
  -- (true, false) is uncovered.
  Test.assert_true(
    not exhaustive(
      two(
        pair(CheckedSpaceBoolean(true), CheckedSpaceBoolean(true)),
        pair(CheckedSpaceBoolean(false), CheckedSpaceBoolean(true))
      )
    )
  )
}

test "booleans and nil halves complete only with both values" {
  Test.assert_true(exhaustive(two(CheckedSpaceBoolean(true), CheckedSpaceBoolean(false))))
  Test.assert_true(not exhaustive(two(CheckedSpaceBoolean(true), CheckedSpaceBoolean(true))))
  Test.assert_true(exhaustive(two(CheckedSpaceNil, CheckedSpaceNonNil(CheckedSpaceAll))))
  Test.assert_true(not exhaustive(one(CheckedSpaceNonNil(CheckedSpaceAll))))
  -- The non-nil half's own value must be covered too.
  Test.assert_true(
    not exhaustive(two(CheckedSpaceNil, CheckedSpaceNonNil(CheckedSpaceBoolean(true))))
  )
  Test.assert_true(
    exhaustive(
      three(
        CheckedSpaceNil,
        CheckedSpaceNonNil(CheckedSpaceBoolean(true)),
        CheckedSpaceNonNil(CheckedSpaceBoolean(false))
      )
    )
  )
}

test "an imprecise arm covers nothing" {
  Test.assert_true(not exhaustive(one(CheckedSpaceNothing)))
  -- Triangle's only arm is imprecise, so Triangle stays uncovered.
  Test.assert_true(
    not exhaustive(
      three(
        shape(circle(), CheckedSpaceAll),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceNothing)
      )
    )
  )
  -- Cases of different family sizes never complete one column.
  Test.assert_true(
    not exhaustive(three(shape(circle(), CheckedSpaceAll), whole(inner(), 2), whole(other(), 2)))
  )
}

test "an arm covering several cases counts as each of them" {
  -- One arm names Circle and Square whole; another names Triangle.
  let both = CheckedSpaceUnion(two(whole(circle(), 3), whole(square(), 3)))
  Test.assert_true(exhaustive(two(both, shape(triangle(), CheckedSpaceAll))))
  Test.assert_true(not exhaustive(one(both)))
  -- Alternatives nested in a payload expand when they reach the first column.
  let inner_or_other = CheckedSpaceUnion(two(whole(inner(), 2), whole(other(), 2)))
  Test.assert_true(
    exhaustive(
      three(
        shape(circle(), inner_or_other),
        shape(square(), CheckedSpaceAll),
        shape(triangle(), CheckedSpaceAll)
      )
    )
  )
}
