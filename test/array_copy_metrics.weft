-- Array value transport copies the complete inline byte representation and
-- then acquires one ownership count for every managed leaf in the copy.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use runtime/unsafe.{*}

fn array_copy_word_count(code: i64, target: i64) -> i64 {
  let mut count = 0
  let mut pos = 0
  while pos + 4 <= buf_len(code) {
    if pipeline_native_code_word(code, pos) == target { count = count + 1 } else { 0 }
    pos = pos + 4
  }
  count
}

fn array_copy_register_runtime(fm: i64, name: str, offset: i64) -> i64 {
  fmap_add(fm, __str_ptr(name), 0, __str_len(name), offset)
  0
}

fn array_copy_test_function(dst_data: i64, src_data: i64) -> IrFunction {
  let insts = ir_inst_list_prepend(
    ir_inst_array_copy_i64(dst_data, src_data, 24, 3, 8, continuation_cleanup_kind_rc()),
    ir_inst_list_empty()
  )
  ir_function_new_src(74201, 2, ir_block_new_term(0, insts, ir_term_return(0)), 0)
}

test "array_copy_ir_publishes_two_uses_and_no_definition" {
  let inst = ir_inst_array_copy_i64(7, 9, 24, 3, 8, continuation_cleanup_kind_rc())
  Test.assert_eq(ir_inst_tag(inst), 45)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 0 - 1)
  Test.assert_eq(pipeline_ir_inst_def_or(inst, 99), 99)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 1)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 9)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 2)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 9), 1)
  Test.assert_eq(pipeline_ir_live_inst_is_call(ir_inst_array_copy_i64(7, 9, 24, 0, 0, continuation_cleanup_kind_none())), 0)
}

test "array_copy_alias_rewrite_preserves_layout_plan" {
  let aliases = pipeline_ir_alias_env_bind(
    pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3),
    9,
    4
  )
  match pipeline_ir_rewrite_inst_uses(ir_inst_array_copy_i64(7, 9, 24, 3, 8, continuation_cleanup_kind_weak()), aliases) {
    IrArrayCopyI64(dst_data, src_data, byte_size, count, stride, kind) -> {
      Test.assert_eq(dst_data, 3)
      Test.assert_eq(src_data, 4)
      Test.assert_eq(byte_size, 24)
      Test.assert_eq(count, 3)
      Test.assert_eq(stride, 8)
      Test.assert_eq(kind, continuation_cleanup_kind_weak())
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "array_copy_verifier_tracks_both_data_uses" {
  Test.assert_eq(pipeline_ir_verify_function(array_copy_test_function(0, 1)), 0)
  -- kind 2, block 0, undefined value 9.
  Test.assert_eq(pipeline_ir_verify_function(array_copy_test_function(0, 9)), 2000000009)
}

test "array_copy_plan_checks_leaf_extent_and_domain_separates_glue" {
  let rc = continuation_cleanup_kind_rc()
  Test.assert_eq(pipeline_array_copy_plan_is_valid(0, 0, 0, continuation_cleanup_kind_none()), 1)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(24, 0, 0, continuation_cleanup_kind_none()), 1)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(24, 3, 8, rc), 1)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(23, 3, 8, rc), 0)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(0 - 1, 0, 0, continuation_cleanup_kind_none()), 0)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(24, 3, 0, rc), 0)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(24, 3, 8, 99), 0)
  Test.assert_eq(pipeline_array_copy_plan_is_valid(9223372036854775807, 9223372036854775807, 8, rc), 0)
  let retain_key = pipeline_array_copy_retain_glue_hash(3, 8, rc)
  Test.assert_eq(if retain_key == pipeline_array_drop_glue_hash(3, 8, rc) { 1 } else { 0 }, 0)
  Test.assert_eq(if retain_key == pipeline_array_copy_retain_glue_hash(4, 8, rc) { 1 } else { 0 }, 0)
}

test "array_copy_native_emits_byte_loop_and_one_retain_helper_per_plan" {
  let code = buf_new(4096)
  let fm = fmap_new()
  array_copy_register_runtime(fm, "rc_default_retain", 4096)
  let homes = pipeline_ir_native_identity_home_facts(2)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 24, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  let first_len = buf_len(code)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(array_copy_word_count(code, cg_ldrb(12, 13, 0)), 1)
  Test.assert_eq(array_copy_word_count(code, cg_strb(12, 14, 0)), 1)
  Test.assert_eq(array_copy_word_count(code, encode_sub_imm(31, 31, 32)), 1)
  Test.assert_eq(array_copy_word_count(code, encode_ret()), 1)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), pipeline_array_copy_retain_glue_hash(3, 8, continuation_cleanup_kind_rc())) > 1 { 1 } else { 0 }, 1)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 24, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(if buf_len(code) > first_len { 1 } else { 0 }, 1)
  Test.assert_eq(array_copy_word_count(code, encode_ret()), 1)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 32, 4, 8, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(array_copy_word_count(code, encode_ret()), 2)
}

test "array_copy_drop_and_retain_helpers_coexist" {
  let code = buf_new(4096)
  let fm = fmap_new()
  array_copy_register_runtime(fm, "rc_default_retain", 4096)
  array_copy_register_runtime(fm, "rc_default_release", 8192)
  let homes = pipeline_ir_native_identity_home_facts(2)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 24, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  pipeline_ir_native_emit_array_drop(code, 0, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(array_copy_word_count(code, encode_ret()), 2)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), pipeline_array_copy_retain_glue_hash(3, 8, continuation_cleanup_kind_rc())) > 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), pipeline_array_drop_glue_hash(3, 8, continuation_cleanup_kind_rc())) > 1 { 1 } else { 0 }, 1)
}

test "array_copy_unmanaged_and_zero_values_need_no_retain_helper" {
  let code = buf_new(512)
  let fm = fmap_new()
  let homes = pipeline_ir_native_identity_home_facts(2)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 24, 0, 0, continuation_cleanup_kind_none(), fm, homes)
  Test.assert_eq(array_copy_word_count(code, cg_ldrb(12, 13, 0)), 1)
  Test.assert_eq(array_copy_word_count(code, encode_ret()), 0)
  let after_bytes = buf_len(code)
  pipeline_ir_native_emit_array_copy(code, 0, 1, 0, 0, 0, continuation_cleanup_kind_none(), fm, homes)
  Test.assert_eq(buf_len(code), after_bytes)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
}

test "array_copy_invalid_plan_traps_before_touching_memory" {
  let code = buf_new(64)
  let fm = fmap_new()
  pipeline_ir_native_emit_array_copy(code, 0, 1, 16, 3, 8, continuation_cleanup_kind_rc(), fm, pipeline_ir_native_identity_home_facts(2))
  Test.assert_eq(buf_len(code), 4)
  Test.assert_eq(pipeline_native_code_word(code, 0), encode_brk(30))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}
