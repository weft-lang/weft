use "runtime/rc_implicit_test.weft"
use "runtime/buffer.weft"
use "stdlib/json.weft"
use "stdlib/vector.weft"

type ManagedHandleBox {
  ManagedHandleBox(i64, i64)
}

fn managed_handle_vector_round(n: i64) -> i64 {
  let values = vector_new<i64>()
  let mut i = 0
  while i < n {
    vector_push<i64>(values, i)
    i = i + 1
  }
  vector_len<i64>(values)
}

fn managed_handle_buffer_round(n: i64) -> i64 {
  let bytes = buf_new(1)
  let mut i = 0
  while i < n {
    bu8(bytes, i)
    i = i + 1
  }
  buf_len(bytes)
}

fn managed_handle_element_vector_round(n: i64) -> i64 {
  let values = vector_new<ManagedHandleBox>()
  let mut i = 0
  while i < n {
    vector_push<ManagedHandleBox>(values, ManagedHandleBox(i, i + 1))
    i = i + 1
  }
  vector_len<ManagedHandleBox>(values)
}

fn managed_handle_alias_round() -> i64 {
  let values = vector_new<i64>()
  vector_push<i64>(values, 41)
  let alias = values
  vector_push<i64>(alias, 42)
  vector_get<i64>(values, 0, 0) + vector_get<i64>(alias, 1, 0)
}

fn managed_handle_json_round() -> i64 {
  let entries = list_cons<JsonEntry>(json_entry("answer", json_number(42)), list_nil<JsonEntry>())
  let value = json_object(entries)
  json_object_len(value)
}

fn managed_handle_promoted_vector_round(n: i64) -> i64 {
  let values = vector_new<ManagedHandleBox>()
  let mut i = 0
  while i < n {
    vector_push<ManagedHandleBox>(values, ManagedHandleBox(i, i + 1))
    i = i + 1
  }
  vector_storage_promote<ManagedHandleBox>(values)
  vector_len<ManagedHandleBox>(values)
}

fn managed_handle_promoted_buffer_round(n: i64) -> i64 {
  let bytes = buf_new(1)
  let mut i = 0
  while i < n {
    bu8(bytes, i)
    i = i + 1
  }
  rc_default_promote_maybe(bytes)
  buf_len(bytes)
}

fn managed_handle_dead_vector_weak() -> weak Vector<ManagedHandleBox> {
  let values = vector_new<ManagedHandleBox>()
  vector_push<ManagedHandleBox>(values, ManagedHandleBox(1, 2))
  weak_ref(values)
}

fn managed_handle_weak_round() -> i64 {
  let weak_values = managed_handle_dead_vector_weak()
  let loaded: Vector<ManagedHandleBox> | nil = weak_load(weak_values)
  if loaded == nil { 1 } else { 0 }
}

fn managed_handle_detach_round() -> i64 {
  let bytes = buf_new(8)
  bu8(bytes, 17)
  bu8(bytes, 34)
  let cap = buf_cap(bytes)
  let data = buf_take_data(bytes)
  let valid = if buf_ptr(bytes) == 0 and buf_len(bytes) == 0 and buf_cap(bytes) == 0 {
    if runtime_rc_test_load64(data) band 65535 == 8721 { 1 } else { 0 }
  } else { 0 }
  heap_free(rc_default_heap(), data, cap)
  valid
}

test "vector_handle_final_storage_churn_stays_flat" {
  let mut warm = 0
  while warm < 50 {
    managed_handle_vector_round(1000)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 100 {
    managed_handle_vector_round(1000)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "vector_handle_drops_all_managed_elements_and_final_storage" {
  let mut warm = 0
  while warm < 50 {
    managed_handle_element_vector_round(32)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    managed_handle_element_vector_round(32)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "copied_vector_handles_share_and_finalize_once" {
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq(managed_handle_alias_round(), 83)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    Test.assert_eq(managed_handle_alias_round(), 83)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "json_owns_nested_list_until_value_death" {
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq(managed_handle_json_round(), 1)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    Test.assert_eq(managed_handle_json_round(), 1)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "promoted_vector_finalizer_drops_managed_elements_and_storage" {
  let mut warm = 0
  while warm < 50 {
    managed_handle_promoted_vector_round(32)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    managed_handle_promoted_vector_round(32)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "promoted_buffer_finalizer_drops_final_storage" {
  let mut warm = 0
  while warm < 50 {
    managed_handle_promoted_buffer_round(1000)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    managed_handle_promoted_buffer_round(1000)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "weak_vector_handle_observes_death_and_recycles_header" {
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq(managed_handle_weak_round(), 1)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    Test.assert_eq(managed_handle_weak_round(), 1)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "buffer_handle_final_storage_churn_stays_flat" {
  let mut warm = 0
  while warm < 50 {
    managed_handle_buffer_round(1000)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 100 {
    managed_handle_buffer_round(1000)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "empty_vector_and_buffer_headers_leave_no_bump_drift" {
  let mut warm = 0
  while warm < 50 {
    vector_new<i64>()
    buf_new(0)
    warm = warm + 1
  }
  let heap_before = runtime_rc_test_heap_arena_offset()
  let before = alloc_bump_mark()
  let mut i = 0
  while i < 1000 {
    vector_new<i64>()
    buf_new(0)
    i = i + 1
  }
  let after = alloc_bump_mark()
  let heap_after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
  Test.assert_eq(heap_after - heap_before, 0)
}

test "buffer_take_data_transfers_bytes_without_double_free" {
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq(managed_handle_detach_round(), 1)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 500 {
    Test.assert_eq(managed_handle_detach_round(), 1)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}
