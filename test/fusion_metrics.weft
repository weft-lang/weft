use runtime/memory.{*}
--
-- Rebaselined 2026-07-09: the legacy fusion pass was deleted with the AST
-- backend; nothing increments the fusion counters on the typed path yet.
-- Counts pinned as tripwires until the typed fusion port (see shared inlining design).
-- test/fusion_metrics.weft -- native evidence for pure list fusion

use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/typeck.{*}
use compiler/type_registry.{ttable_get_checked_functions}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/rc_implicit_test.{*}
use stdlib/list as list
use stdlib/list.{*}
use stdlib/iter as iter

fn fusion_metric_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn fusion_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = mem_load64(fm + 8)
  let d = mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn fusion_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if fusion_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn fusion_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn fusion_metric_count(src: str) -> i64 {
  pipeline_native_fusion_count(fusion_metric_native(src))
}

fn fusion_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = fusion_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = fusion_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  fusion_metric_count_bl_to_target(code, off, end, target)
}

fn fusion_metric_traversal_role(src: str, fn_name: str) -> PipelineIrTraversalRole {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  match typed {
    TypedModule(fns, caller_src, tt) -> {
      let entry = ftypes_find(ttable_get_checked_functions(tt), __str_ptr(fn_name), 0, __str_len(fn_name))
      pipeline_ir_semantic_traversal_role_for_entry(fns, tt, entry)
    }
  }
}

fn fusion_metric_current_traversal_name(row: i64) -> str {
  match row {
    0 -> "from_generator"
    1 -> "range"
    2 -> "map"
    3 -> "filter"
    4 -> "take"
    5 -> "fold"
    6 -> "count"
    7 -> "first"
    8 -> "last"
    9 -> "nth"
    10 -> "position"
    11 -> "find"
    12 -> "find_map"
    13 -> "any"
    14 -> "all"
    15 -> "reduce"
    16 -> "empty"
    17 -> "once"
    18 -> "chain"
    19 -> "skip"
    20 -> "take_while"
    21 -> "skip_while"
    22 -> "enumerate"
    23 -> "zip"
    24 -> "filter_map"
    25 -> "flat_map"
    26 -> "scan"
    27 -> "min"
    28 -> "max"
    29 -> "flatten"
    30 -> "partition"
    31 -> "each_chunk"
    32 -> "each_window"
    _ -> "each"
  }
}

fn fusion_metric_current_traversal_role(row: i64) -> PipelineIrTraversalRole {
  match row {
    0 -> PipelineIrTraversalFromGenerator
    1 -> PipelineIrTraversalRangeI64
    2 -> PipelineIrTraversalMap
    3 -> PipelineIrTraversalFilter
    4 -> PipelineIrTraversalTake
    5 -> PipelineIrTraversalFold
    6 -> PipelineIrTraversalCount
    7 -> PipelineIrTraversalFirst
    8 -> PipelineIrTraversalLast
    9 -> PipelineIrTraversalNth
    10 -> PipelineIrTraversalPosition
    11 -> PipelineIrTraversalFind
    12 -> PipelineIrTraversalFindMap
    13 -> PipelineIrTraversalAny
    14 -> PipelineIrTraversalAll
    15 -> PipelineIrTraversalReduce
    16 -> PipelineIrTraversalEmpty
    17 -> PipelineIrTraversalOnce
    18 -> PipelineIrTraversalChain
    19 -> PipelineIrTraversalSkip
    20 -> PipelineIrTraversalTakeWhile
    21 -> PipelineIrTraversalSkipWhile
    22 -> PipelineIrTraversalEnumerate
    23 -> PipelineIrTraversalZip
    24 -> PipelineIrTraversalFilterMap
    25 -> PipelineIrTraversalFlatMap
    26 -> PipelineIrTraversalScan
    27 -> PipelineIrTraversalMin
    28 -> PipelineIrTraversalMax
    29 -> PipelineIrTraversalFlatten
    30 -> PipelineIrTraversalPartition
    31 -> PipelineIrTraversalEachChunk
    32 -> PipelineIrTraversalEachWindow
    _ -> PipelineIrTraversalEach
  }
}

fn fusion_metric_traversal_call_count_insts(insts: IrInstList, facts: PipelineIrSemanticFactList, role: PipelineIrTraversalRole) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_traversal_role_same(pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash), role)
        IrGenericCallI64(dst, callee_hash, type_args, args) -> pipeline_ir_traversal_role_same(pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash), role)
        _ -> 0
      }
      add + fusion_metric_traversal_call_count_insts(rest, facts, role)
    }
  }
}

fn fusion_metric_traversal_call_count_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList, role: PipelineIrTraversalRole) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      fusion_metric_traversal_call_count_insts(insts, facts, role) + fusion_metric_traversal_call_count_blocks(rest, facts, role)
    }
  }
}

fn fusion_metric_traversal_call_count_functions(functions: IrFunctionList, facts: PipelineIrSemanticFactList, source: i64, role: PipelineIrTraversalRole) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(IrFunction(hash, params, blocks, fn_source), rest) -> {
      let add = if fn_source == source { fusion_metric_traversal_call_count_blocks(blocks, facts, role) } else { 0 }
      add + fusion_metric_traversal_call_count_functions(rest, facts, source, role)
    }
  }
}

fn fusion_metric_traversal_call_count(src: str, role: PipelineIrTraversalRole) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
  fusion_metric_traversal_call_count_functions(
    pipeline_typed_optimisation_prefix_functions(prefix),
    pipeline_typed_optimisation_prefix_facts(prefix),
    __str_ptr(src),
    role
  )
}

fn fusion_metric_traversal_bounds_insts(
  insts: IrInstList,
  all_insts: IrInstList,
  facts: PipelineIrSemanticFactList,
  wanted: PipelineIrTraversalRole
) -> PipelineIrTraversalBounds {
  match insts {
    IrInstNil -> pipeline_ir_traversal_bounds_unknown()
    IrInstCons(inst, rest) -> match pipeline_ir_traversal_inst_call(inst, facts) {
      PipelineIrTraversalCallMissing -> fusion_metric_traversal_bounds_insts(rest, all_insts, facts, wanted)
      PipelineIrTraversalCallFound(found, dst, role, args) -> {
        if pipeline_ir_traversal_role_same(role, wanted) == 1 {
          pipeline_ir_traversal_bounds_for_value(all_insts, dst, facts)
        } else {
          fusion_metric_traversal_bounds_insts(rest, all_insts, facts, wanted)
        }
      }
    }
  }
}

fn fusion_metric_traversal_bounds_blocks(
  blocks: IrBlockList,
  facts: PipelineIrSemanticFactList,
  wanted: PipelineIrTraversalRole
) -> PipelineIrTraversalBounds {
  match blocks {
    IrBlockListNil -> pipeline_ir_traversal_bounds_unknown()
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      let found = fusion_metric_traversal_bounds_insts(insts, insts, facts, wanted)
      match found {
        PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountUnknown) -> {
          fusion_metric_traversal_bounds_blocks(rest, facts, wanted)
        }
        _ -> found
      }
    }
  }
}

fn fusion_metric_traversal_bounds_functions(
  functions: IrFunctionList,
  facts: PipelineIrSemanticFactList,
  source: i64,
  wanted: PipelineIrTraversalRole
) -> PipelineIrTraversalBounds {
  match functions {
    IrFunctionNil -> pipeline_ir_traversal_bounds_unknown()
    IrFunctionCons(IrFunction(hash, params, blocks, fn_source), rest) -> {
      if fn_source == source {
        let found = fusion_metric_traversal_bounds_blocks(blocks, facts, wanted)
        match found {
          PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountUnknown) -> {
            fusion_metric_traversal_bounds_functions(rest, facts, source, wanted)
          }
          _ -> found
        }
      } else {
        fusion_metric_traversal_bounds_functions(rest, facts, source, wanted)
      }
    }
  }
}

fn fusion_metric_traversal_bounds(src: str, wanted: PipelineIrTraversalRole) -> PipelineIrTraversalBounds {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
  fusion_metric_traversal_bounds_functions(
    pipeline_typed_optimisation_prefix_functions(prefix),
    pipeline_typed_optimisation_prefix_facts(prefix),
    __str_ptr(src),
    wanted
  )
}

fn fusion_double(x: i64) -> i64 { x * 2 }
fn fusion_inc(x: i64) -> i64 { x + 1 }
fn fusion_sum(acc: i64, x: i64) -> i64 { acc + x }
fn fusion_count(acc: i64, x: i64) -> i64 { acc + 1 }
fn fusion_even(x: i64) -> bool { x % 2 == 0 }
fn fusion_branchy(x: i64) -> bool {
  if x < 3 { false }
  else { x % 2 == 0 }
}

fn fusion_map_fold_value() -> i64 {
  let mapped = list.range(0, 5).map<i64>(fusion_double)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_filter_fold_value() -> i64 {
  let filtered = list.range(0, 7).filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_map_filter_fold_value() -> i64 {
  let mapped = list.range(0, 6).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_empty_value() -> i64 {
  let mapped = list.range(0, 0).map<i64>(fusion_double)
  mapped.fold<i64>(11, fusion_sum)
}

fn fusion_singleton_value() -> i64 {
  let mapped = Cons<i64>(3, Nil<i64>()).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_branchy)
  filtered.fold<i64>(0, fusion_count)
}

fn fusion_large_value() -> i64 {
  let mapped = list.range(0, 100).map<i64>(fusion_double)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_captured_value() -> i64 {
  let bias = 3
  let mapped = list.range(0, 4).map<i64>(x => x + bias)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_nested_pipeline_value() -> i64 {
  let first = list.range(0, 4).map<i64>(fusion_inc)
  let mapped = first.map<i64>(fusion_double)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_receiver_chain_value() -> i64 {
  let mapped = list.range(0, 6).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_iterator_pipeline_value(start: i64, end: i64, limit: usize, init: i64) -> i64 {
  let mapped = iter.map(iter.range(start, end), (value: i64) => value * 3 + 1)
  let filtered = iter.filter(mapped, (value: i64) => value % 2 == 0)
  let limited = iter.take(filtered, limit)
  iter.fold(limited, init, (acc: i64, value: i64) => acc + value)
}

fn fusion_iterator_captured_cleanup_value(probe: RuntimeRcProbe) -> i64 {
  let mapped = iter.map(iter.range(0, 4), (value: i64) => value + runtime_rc_probe_load(probe))
  let filtered = iter.filter(mapped, (value: i64) => value % 2 == 0)
  let limited = iter.take(filtered, 2)
  iter.fold(limited, 0, (acc: i64, value: i64) => acc + value)
}

fn fusion_ir_sample_functions() -> IrFunctionList {
  let first_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 10),
    ir_inst_list_prepend(ir_inst_const_i64(1, 20), ir_inst_list_empty())
  )
  let first = ir_function_new(101, 0, ir_block_new_term(0, first_insts, ir_term_return(1)))
  let empty = ir_function_new(102, 0, ir_block_new_term(1, ir_inst_list_empty(), ir_term_return(0)))
  let third_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 30),
    ir_inst_list_prepend(
      ir_inst_const_i64(1, 40),
      ir_inst_list_prepend(ir_inst_const_i64(2, 50), ir_inst_list_empty())
    )
  )
  let third = ir_function_new(103, 0, ir_block_new_term(2, third_insts, ir_term_return(2)))
  ir_function_list_prepend(first, ir_function_list_prepend(empty, ir_function_list_prepend(third, ir_function_list_empty())))
}

test "fusion_metric_happy_pipeline_matrix" {
  let map_fold = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 5).map<i64>(dbl) mapped.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(map_fold), 0)

  let filter_fold = "use stdlib/list as list use stdlib/list.{*} fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let filtered = list.range(0, 7).filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(filter_fold), 0)

  let map_filter_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 6).map<i64>(inc) let filtered = mapped.filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(map_filter_fold), 0)
}

test "fusion_semantic_traversal_roles_follow_resolved_sdk_declarations" {
  let src = "use stdlib/iter.{*} fn main() -> i64 { 0 }"
  for row in 0..34 {
    Test.assert_eq(
      pipeline_ir_traversal_role_same(
        fusion_metric_traversal_role(src, fusion_metric_current_traversal_name(row)),
        fusion_metric_current_traversal_role(row)
      ),
      1
    )
  }
}

test "fusion_semantic_traversal_roles_roundtrip_compact_storage" {
  for code in 0..36 {
    Test.assert_eq(pipeline_ir_traversal_role_code(pipeline_ir_traversal_role_from_code(code)), code)
  }
  Test.assert_eq(pipeline_ir_traversal_role_same(pipeline_ir_traversal_role_from_code(99), PipelineIrTraversalNone), 1)
}

test "fusion_semantic_traversal_properties_are_typed" {
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalRangeI64) { PipelineIrTraversalCardinalityRangeArguments(0, 1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalEmpty) { PipelineIrTraversalCardinalityExactZero -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalOnce) { PipelineIrTraversalCardinalityExactOne -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalMap) { PipelineIrTraversalCardinalityPreservesInput -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalFilter) { PipelineIrTraversalCardinalityAtMostInput -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalFilterMap) { PipelineIrTraversalCardinalityAtMostInput -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalTake) { PipelineIrTraversalCardinalityCapByArgument(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalSkip) { PipelineIrTraversalCardinalitySkipByArgument(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalChain) { PipelineIrTraversalCardinalitySumInputs -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalZip) { PipelineIrTraversalCardinalityMinInputs -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalReduce) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalPosition) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalMin) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalMax) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalFlatten) { PipelineIrTraversalCardinalityFlatMapInput -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalPartition) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalEachChunk) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalEachWindow) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_cardinality(PipelineIrTraversalEach) { PipelineIrTraversalCardinalityNoIteratorResult -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalChain) { PipelineIrTraversalOrderLeftThenRight -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalZip) { PipelineIrTraversalOrderPairByPosition -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalMap) { PipelineIrTraversalOrderSource -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalFlatten) { PipelineIrTraversalOrderNestedSource -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalPartition) { PipelineIrTraversalOrderStablePartition -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalEachChunk) { PipelineIrTraversalOrderChunkedSource(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_order(PipelineIrTraversalEachWindow) { PipelineIrTraversalOrderWindowedSource(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_buffering(PipelineIrTraversalPartition) { PipelineIrTraversalBufferingGrowingOutputs(2) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_buffering(PipelineIrTraversalEachChunk) { PipelineIrTraversalBufferingBoundedByArgument(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_buffering(PipelineIrTraversalEachWindow) { PipelineIrTraversalBufferingRollingWindow(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalMap) { PipelineIrTraversalPullLazy -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalTake) { PipelineIrTraversalPullLazyMayStopSource -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalFind) { PipelineIrTraversalPullConsumerMayStopEarly -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalPosition) { PipelineIrTraversalPullConsumerMayStopEarly -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalMin) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalMax) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalFlatten) { PipelineIrTraversalPullLazyMayExpandInput -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalPartition) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalEachChunk) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalEachWindow) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalReduce) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_pull(PipelineIrTraversalEach) { PipelineIrTraversalPullConsumerExhausts -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalMap) { PipelineIrTraversalCallbackPure(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalFilterMap) { PipelineIrTraversalCallbackPure(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalEach) { PipelineIrTraversalCallbackEffectful(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalFold) { PipelineIrTraversalCallbackPure(2) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalReduce) { PipelineIrTraversalCallbackPure(2) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalPosition) { PipelineIrTraversalCallbackPure(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalMin) { PipelineIrTraversalCallbackNone -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalMax) { PipelineIrTraversalCallbackNone -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalFlatten) { PipelineIrTraversalCallbackNone -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalPartition) { PipelineIrTraversalCallbackPure(1) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalEachChunk) { PipelineIrTraversalCallbackEffectful(2) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalEachWindow) { PipelineIrTraversalCallbackEffectfulScopedView(2) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalRangeMapFilterTakeFoldI64) { PipelineIrTraversalCallbackPure3(2, 3, 6) -> 1 _ -> 0 }, 1)
  Test.assert_eq(match pipeline_ir_traversal_callback(PipelineIrTraversalCount) { PipelineIrTraversalCallbackNone -> 1 _ -> 0 }, 1)
}

test "fusion_semantic_cardinality_composes_through_real_iterator_calls" {
  let preserved = "use stdlib/iter as iter fn double(value: i64) -> i64 { value * 2 } fn main() -> i64 { let values = iter.map(iter.range(2, 10), double) values.close() 0 }"
  Test.assert_eq(match fusion_metric_traversal_bounds(preserved, PipelineIrTraversalMap) {
    PipelineIrTraversalBounds(PipelineIrTraversalCountRange(start, end), PipelineIrTraversalCountRange(upper_start, upper_end)) -> 1
    _ -> 0
  }, 1)

  let selected = "use stdlib/iter as iter fn even(value: i64) -> bool { value % 2 == 0 } fn main() -> i64 { let values = iter.filter(iter.range(2, 10), even) values.close() 0 }"
  let selected_bounds = fusion_metric_traversal_bounds(selected, PipelineIrTraversalFilter)
  Test.assert_eq(match selected_bounds {
    PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountRange(start, end)) -> 1
    _ -> 0
  }, 1)
  Test.assert_eq(match pipeline_ir_traversal_allocation(selected_bounds) {
    PipelineIrTraversalAllocationNone -> 1
    _ -> 0
  }, 1)

  let capped = "use stdlib/iter as iter fn main() -> i64 { let values = iter.take(iter.range(2, 10), 3) values.close() 0 }"
  let capped_bounds = fusion_metric_traversal_bounds(capped, PipelineIrTraversalTake)
  Test.assert_eq(match capped_bounds {
    PipelineIrTraversalBounds(PipelineIrTraversalCountMin(PipelineIrTraversalCountRange(start, end), PipelineIrTraversalCountArgument(limit)), PipelineIrTraversalCountMin(PipelineIrTraversalCountRange(upper_start, upper_end), PipelineIrTraversalCountArgument(upper_limit))) -> 1
    _ -> 0
  }, 1)
  Test.assert_eq(match pipeline_ir_traversal_allocation(capped_bounds) {
    PipelineIrTraversalAllocationExact(PipelineIrTraversalCountMin(left, right)) -> 1
    _ -> 0
  }, 1)

  let skipped = "use stdlib/iter as iter fn main() -> i64 { let values = iter.skip(iter.range(2, 10), 3) values.close() 0 }"
  Test.assert_eq(match fusion_metric_traversal_bounds(skipped, PipelineIrTraversalSkip) {
    PipelineIrTraversalBounds(PipelineIrTraversalCountSaturatingSubtract(PipelineIrTraversalCountRange(start, end), PipelineIrTraversalCountArgument(count)), PipelineIrTraversalCountSaturatingSubtract(PipelineIrTraversalCountRange(upper_start, upper_end), PipelineIrTraversalCountArgument(upper_count))) -> 1
    _ -> 0
  }, 1)

  let chained = "use stdlib/iter as iter fn main() -> i64 { let values = iter.chain(iter.range(0, 3), iter.range(8, 10)) values.close() 0 }"
  Test.assert_eq(match fusion_metric_traversal_bounds(chained, PipelineIrTraversalChain) {
    PipelineIrTraversalBounds(PipelineIrTraversalCountSum(PipelineIrTraversalCountRange(a, b), PipelineIrTraversalCountRange(c, d)), PipelineIrTraversalCountSum(PipelineIrTraversalCountRange(e, f), PipelineIrTraversalCountRange(g, h))) -> 1
    _ -> 0
  }, 1)

  let zipped = "use stdlib/iter as iter fn main() -> i64 { let values = iter.zip(iter.range(0, 3), iter.range(8, 10)) values.close() 0 }"
  Test.assert_eq(match fusion_metric_traversal_bounds(zipped, PipelineIrTraversalZip) {
    PipelineIrTraversalBounds(PipelineIrTraversalCountMin(PipelineIrTraversalCountRange(a, b), PipelineIrTraversalCountRange(c, d)), PipelineIrTraversalCountMin(PipelineIrTraversalCountRange(e, f), PipelineIrTraversalCountRange(g, h))) -> 1
    _ -> 0
  }, 1)
}

test "fusion_semantic_cardinality_covers_zero_one_and_unknown_sources" {
  let empty_source = "use stdlib/iter as iter fn main() -> i64 { let values = iter.empty<i64>() values.close() 0 }"
  let empty_bounds = fusion_metric_traversal_bounds(empty_source, PipelineIrTraversalEmpty)
  Test.assert_eq(match empty_bounds {
    PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountZero) -> 1
    _ -> 0
  }, 1)
  Test.assert_eq(match pipeline_ir_traversal_allocation(empty_bounds) {
    PipelineIrTraversalAllocationExact(PipelineIrTraversalCountZero) -> 1
    _ -> 0
  }, 1)

  let once_source = "use stdlib/iter as iter fn main() -> i64 { let values = iter.once(9) values.close() 0 }"
  Test.assert_eq(match fusion_metric_traversal_bounds(once_source, PipelineIrTraversalOnce) {
    PipelineIrTraversalBounds(PipelineIrTraversalCountOne, PipelineIrTraversalCountOne) -> 1
    _ -> 0
  }, 1)

  let unknown = pipeline_ir_traversal_bounds_unknown()
  Test.assert_eq(match unknown {
    PipelineIrTraversalBounds(PipelineIrTraversalCountZero, PipelineIrTraversalCountUnknown) -> 1
    _ -> 0
  }, 1)
  Test.assert_eq(match pipeline_ir_traversal_allocation(
    PipelineIrTraversalBounds(PipelineIrTraversalCountOne, PipelineIrTraversalCountUnknown)
  ) {
    PipelineIrTraversalAllocationReserveLower(PipelineIrTraversalCountOne) -> 1
    _ -> 0
  }, 1)
}

test "fusion_semantic_cardinality_arithmetic_fails_closed_on_overflow" {
  Test.assert_eq(pipeline_ir_traversal_range_count(8, 3), 0)
  Test.assert_eq(pipeline_ir_traversal_range_count(0 - 5, 5), 10)
  Test.assert_eq(pipeline_ir_traversal_range_count_fits(0 - 5, 5), 1)
  Test.assert_eq(pipeline_ir_traversal_range_count_fits(0 - 9223372036854775807 - 1, 9223372036854775807), 0)
  Test.assert_eq(pipeline_ir_traversal_count_sum_fits(20, 22), 1)
  Test.assert_eq(pipeline_ir_traversal_count_sum_fits(9223372036854775807, 1), 0)
}

test "fusion_semantic_traversal_roles_reject_spelling_only_matches" {
  let src = "fn range(start: i64, end: i64) -> i64 { end - start } fn main() -> i64 { range(0, 2) }"
  Test.assert_eq(pipeline_ir_traversal_role_same(fusion_metric_traversal_role(src, "range"), PipelineIrTraversalNone), 1)
}

test "fusion_metric_iterator_pipeline_consumes_resolved_traversal_roles" {
  let src = "use stdlib/iter as iter use stdlib/num.{*} use stdlib/result.{*} fn work(n: i64) -> i64 { let mapped = iter.map(iter.range(0, n), (value: i64) => value * 3 + 1) let filtered = iter.filter(mapped, (value: i64) => value % 2 == 0) let limit = (n / 3).to_usize_checked().unwrap_or(0) let limited = iter.take(filtered, limit) iter.fold(limited, 0, (acc: i64, value: i64) => acc + value) } fn main() -> i64 { work(100) }"
  Test.assert_eq(fusion_metric_traversal_call_count(src, PipelineIrTraversalRangeMapFilterTakeFoldI64), 1)
}

test "fusion_metric_iterator_pipeline_rejects_escape_and_non_i64_shapes" {
  let escaped = "use stdlib/iter as iter use stdlib/num.{*} use stdlib/result.{*} fn add(acc: i64, value: i64) -> i64 { acc + value } fn work(n: i64) -> i64 { let source = iter.range(0, n) let mapped = iter.map(source, value => value + 1) let filtered = iter.filter(mapped, value => true) let limited = iter.take(filtered, n.to_usize_checked().unwrap_or(0)) iter.fold(limited, 0, add) } fn main() -> i64 { work(4) }"
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalRangeMapFilterTakeFoldI64), 0)
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalRangeI64), 1)
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalMap), 1)
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalFilter), 1)
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalTake), 1)
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, PipelineIrTraversalFold), 1)

  let non_i64 = "use stdlib/iter as iter use stdlib/num.{*} use stdlib/result.{*} fn work(n: i64) -> i64 { let mapped = iter.map(iter.range(0, n), value => value % 2 == 0) let filtered = iter.filter(mapped, value => value) let limited = iter.take(filtered, n.to_usize_checked().unwrap_or(0)) iter.fold(limited, 0, (acc: i64, value: bool) => if value { acc + 1 } else { acc }) } fn main() -> i64 { work(4) }"
  Test.assert_eq(fusion_metric_traversal_call_count(non_i64, PipelineIrTraversalRangeMapFilterTakeFoldI64), 0)
}

test "fusion_metric_receiver_pipeline_matrix" {
  let receiver_map_fold = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 5).map<i64>(dbl) mapped.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(receiver_map_fold), 0)

  let receiver_map_filter_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 6).map<i64>(inc) let filtered = mapped.filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(receiver_map_filter_fold), 0)
}

test "fusion_metric_rejects_unknown_collection_helper" {
  let src = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn my_map(xs: List<i64>, f: (i64) -> i64) -> List<i64> { xs.map<i64>(f) } fn main() -> i64 { my_map(list.range(0, 5), dbl).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(src), 0)
}

test "fusion_metric_rejects_non_i64_type_args" {
  let src = "use stdlib/list.{*} fn keep(x: bool) -> bool { x } fn count(acc: i64, x: bool) -> i64 { if x { acc + 1 } else { acc } } fn main() -> i64 { Cons<bool>(true, Nil<bool>()).map<bool>(keep).fold<i64>(0, count) }"
  Test.assert_eq(fusion_metric_count(src), 0)
}

test "fusion_metric_rejects_raw_effect_callbacks" {
  let raw_map = "use stdlib/list as list use stdlib/list.{*} fn raw_map(x: i64) -> i64 { mem_load64(x) } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list.range(0, 3).map<i64>(raw_map).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(raw_map), 0)

  let raw_filter = "use stdlib/list as list use stdlib/list.{*} fn keep(x: i64) -> bool { mem_load64(x) != 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list.range(0, 3).filter(keep).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(raw_filter), 0)

  let raw_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn raw_add(acc: i64, x: i64) -> i64 { mem_store64(acc, x) acc + x } fn main() -> i64 { list.range(0, 3).map<i64>(inc).fold<i64>(0, raw_add) }"
  Test.assert_eq(fusion_metric_count(raw_fold), 0)
}

test "fusion_e2e_preserves_pipeline_values" {
  Test.assert_eq(fusion_map_fold_value(), 20)
  Test.assert_eq(fusion_filter_fold_value(), 12)
  Test.assert_eq(fusion_map_filter_fold_value(), 12)
  Test.assert_eq(fusion_receiver_chain_value(), 12)
}

test "fusion_e2e_iterator_pipeline_preserves_boundaries_and_cleanup" {
  Test.assert_eq(fusion_iterator_pipeline_value(0, 10, 3, 5), 35)
  Test.assert_eq(fusion_iterator_pipeline_value(0, 10, 0, 5), 5)
  Test.assert_eq(fusion_iterator_pipeline_value(5, 3, 4, 5), 5)
  Test.assert_eq(fusion_iterator_pipeline_value(0, 4, 20, 0), 14)
  let probe: RuntimeRcProbe = runtime_rc_probe_new(5)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(fusion_iterator_captured_cleanup_value(probe), 14)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
}

