use runtime/memory.{*}
--
-- Rebaselined 2026-07-09: the legacy fusion pass was deleted with the AST
-- backend; nothing increments the fusion counters on the typed path yet.
-- Counts pinned as tripwires until the typed fusion port (see 2k brief).
-- test/fusion_metrics.weft -- native evidence for pure list fusion

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use runtime/alloc.{*}
use stdlib/list.{*}

fn fusion_metric_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn fusion_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = mem_load64(fm + 8)
  let d = mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn fusion_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if fusion_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn fusion_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn fusion_metric_count(src: str) -> i64 {
  pipeline_native_fusion_count(fusion_metric_native(src))
}

fn fusion_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = fusion_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = fusion_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  fusion_metric_count_bl_to_target(code, off, end, target)
}

fn fusion_double(x: i64) -> i64 { x * 2 }
fn fusion_inc(x: i64) -> i64 { x + 1 }
fn fusion_sum(acc: i64, x: i64) -> i64 { acc + x }
fn fusion_count(acc: i64, x: i64) -> i64 { acc + 1 }
fn fusion_even(x: i64) -> i64 { if x % 2 == 0 { 1 } else { 0 } }
fn fusion_branchy(x: i64) -> i64 {
  if x < 3 { 0 }
  else { if x % 2 == 0 { 1 } else { 0 } }
}

fn fusion_map_fold_value() -> i64 {
  list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 5), fusion_double), 0, fusion_sum)
}

fn fusion_filter_fold_value() -> i64 {
  list_fold<i64, i64>(list_filter<i64>(list_range(0, 7), fusion_even), 0, fusion_sum)
}

fn fusion_map_filter_fold_value() -> i64 {
  list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(list_range(0, 6), fusion_inc), fusion_even), 0, fusion_sum)
}

fn fusion_empty_value() -> i64 {
  list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 0), fusion_double), 11, fusion_sum)
}

fn fusion_singleton_value() -> i64 {
  list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(list_cons<i64>(3, list_nil<i64>()), fusion_inc), fusion_branchy), 0, fusion_count)
}

fn fusion_large_value() -> i64 {
  list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 100), fusion_double), 0, fusion_sum)
}

fn fusion_captured_value() -> i64 {
  let bias = 3
  list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 4), x => x + bias), 0, fusion_sum)
}

fn fusion_nested_pipeline_value() -> i64 {
  let first = list_map<i64, i64>(list_range(0, 4), fusion_inc)
  list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(first, fusion_double), fusion_even), 0, fusion_sum)
}

fn fusion_pipe_chain_value() -> i64 {
  list_range(0, 6) |> list_map<i64, i64>(fusion_inc) |> list_filter<i64>(fusion_even) |> list_fold<i64, i64>(0, fusion_sum)
}

fn fusion_ir_sample_functions() -> IrFunctionList {
  let first_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 10),
    ir_inst_list_prepend(ir_inst_const_i64(1, 20), ir_inst_list_empty())
  )
  let first = ir_function_new(101, 0, ir_block_new_term(0, first_insts, ir_term_return(1)))
  let empty = ir_function_new(102, 0, ir_block_new_term(1, ir_inst_list_empty(), ir_term_return(0)))
  let third_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 30),
    ir_inst_list_prepend(
      ir_inst_const_i64(1, 40),
      ir_inst_list_prepend(ir_inst_const_i64(2, 50), ir_inst_list_empty())
    )
  )
  let third = ir_function_new(103, 0, ir_block_new_term(2, third_insts, ir_term_return(2)))
  ir_function_list_prepend(first, ir_function_list_prepend(empty, ir_function_list_prepend(third, ir_function_list_empty())))
}

test "fusion_metric_happy_pipeline_matrix" {
  let map_fold = "use \"stdlib/list.weft\" fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 5), dbl), 0, add) }"
  Test.assert_eq(fusion_metric_count(map_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(map_fold, "main", "list_map_fold_i64"), 0)

  let filter_fold = "use \"stdlib/list.weft\" fn even(x: i64) -> i64 { if x % 2 == 0 { 1 } else { 0 } } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_filter<i64>(list_range(0, 7), even), 0, add) }"
  Test.assert_eq(fusion_metric_count(filter_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(filter_fold, "main", "list_filter_fold_i64"), 0)

  let map_filter_fold = "use \"stdlib/list.weft\" fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> i64 { if x % 2 == 0 { 1 } else { 0 } } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(list_range(0, 6), inc), even), 0, add) }"
  Test.assert_eq(fusion_metric_count(map_filter_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(map_filter_fold, "main", "list_map_filter_fold_i64"), 0)
}

test "fusion_metric_pipe_pipeline_matrix" {
  let pipe_map_fold = "use \"stdlib/list.weft\" fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_range(0, 5) |> list_map<i64, i64>(dbl) |> list_fold<i64, i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(pipe_map_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(pipe_map_fold, "main", "list_map_fold_i64"), 0)

  let pipe_map_filter_fold = "use \"stdlib/list.weft\" fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> i64 { if x % 2 == 0 { 1 } else { 0 } } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_range(0, 6) |> list_map<i64, i64>(inc) |> list_filter<i64>(even) |> list_fold<i64, i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(pipe_map_filter_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(pipe_map_filter_fold, "main", "list_map_filter_fold_i64"), 0)
}

test "fusion_metric_compiler_ir_traversal_helper" {
  let src = "use \"compiler/ir.weft\" fn main() -> i64 { 0 }"
  Test.assert_eq(fusion_metric_call_sites(src, "ir_function_list_pipeline_inst_count", "list_map_filter_fold_i64"), 0)
}

test "fusion_metric_rejects_unknown_collection_helper" {
  let src = "use \"stdlib/list.weft\" fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn my_map(xs: List<i64>, f: (i64) -> i64) -> List<i64> { list_map<i64, i64>(xs, f) } fn main() -> i64 { list_fold<i64, i64>(my_map(list_range(0, 5), dbl), 0, add) }"
  Test.assert_eq(fusion_metric_count(src), 0)
  Test.assert_eq(fusion_metric_call_sites(src, "main", "list_map_fold_i64"), 0)
}

test "fusion_metric_rejects_non_i64_type_args" {
  let src = "use \"stdlib/list.weft\" fn keep(x: bool) -> bool { x } fn count(acc: i64, x: bool) -> i64 { if x { acc + 1 } else { acc } } fn main() -> i64 { list_fold<bool, i64>(list_map<bool, bool>(list_cons<bool>(true, list_nil<bool>()), keep), 0, count) }"
  Test.assert_eq(fusion_metric_count(src), 0)
}

test "fusion_metric_rejects_raw_effect_callbacks" {
  let raw_map = "use \"stdlib/list.weft\" fn raw_map(x: i64) -> i64 { mem_load64(x) } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 3), raw_map), 0, add) }"
  Test.assert_eq(fusion_metric_count(raw_map), 0)
  Test.assert_eq(fusion_metric_call_sites(raw_map, "main", "list_map_fold_i64"), 0)

  let raw_filter = "use \"stdlib/list.weft\" fn keep(x: i64) -> i64 { mem_load64(x) } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_filter<i64>(list_range(0, 3), keep), 0, add) }"
  Test.assert_eq(fusion_metric_count(raw_filter), 0)
  Test.assert_eq(fusion_metric_call_sites(raw_filter, "main", "list_filter_fold_i64"), 0)

  let raw_fold = "use \"stdlib/list.weft\" fn inc(x: i64) -> i64 { x + 1 } fn raw_add(acc: i64, x: i64) -> i64 { mem_store64(acc, x) acc + x } fn main() -> i64 { list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 3), inc), 0, raw_add) }"
  Test.assert_eq(fusion_metric_count(raw_fold), 0)
  Test.assert_eq(fusion_metric_call_sites(raw_fold, "main", "list_map_fold_i64"), 0)
}

test "fusion_e2e_preserves_pipeline_values" {
  Test.assert_eq(fusion_map_fold_value(), 20)
  Test.assert_eq(fusion_filter_fold_value(), 12)
  Test.assert_eq(fusion_map_filter_fold_value(), 12)
  Test.assert_eq(fusion_pipe_chain_value(), 12)
}

test "fusion_e2e_compiler_ir_traversal_helper" {
  let functions = fusion_ir_sample_functions()
  Test.assert_eq(ir_function_list_pipeline_inst_count(functions), ir_function_list_inst_count(functions))
  Test.assert_eq(ir_function_list_pipeline_inst_count(functions), 5)
}

test "fusion_adversarial_collection_shapes" {
  Test.assert_eq(fusion_empty_value(), 11)
  Test.assert_eq(fusion_singleton_value(), 1)
  Test.assert_eq(fusion_large_value(), 9900)
  Test.assert_eq(fusion_captured_value(), 18)
  Test.assert_eq(fusion_nested_pipeline_value(), 20)
}

test "fusion_property_helpers_match_unfused_matrix" {
  let empty = list_range(0, 0)
  let xs = list_range(0, 10)
  let branchy = list_range(0, 8)

  Test.assert_eq(
    list_map_fold_i64(xs, 7, fusion_double, fusion_sum),
    list_fold<i64, i64>(list_map<i64, i64>(xs, fusion_double), 7, fusion_sum)
  )
  Test.assert_eq(
    list_filter_fold_i64(branchy, 0, fusion_branchy, fusion_sum),
    list_fold<i64, i64>(list_filter<i64>(branchy, fusion_branchy), 0, fusion_sum)
  )
  Test.assert_eq(
    list_map_filter_fold_i64(xs, 0, fusion_inc, fusion_even, fusion_sum),
    list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(xs, fusion_inc), fusion_even), 0, fusion_sum)
  )
  Test.assert_eq(
    list_map_filter_fold_i64(empty, 5, fusion_inc, fusion_even, fusion_sum),
    list_fold<i64, i64>(list_filter<i64>(list_map<i64, i64>(empty, fusion_inc), fusion_even), 5, fusion_sum)
  )
}
