use runtime/memory.{*}
--
-- Rebaselined 2026-07-09: the legacy fusion pass was deleted with the AST
-- backend; nothing increments the fusion counters on the typed path yet.
-- Counts pinned as tripwires until the typed fusion port (see shared inlining design).
-- test/fusion_metrics.weft -- native evidence for pure list fusion

use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/typeck.{*}
use compiler/type_registry.{ttable_get_checked_functions}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/rc_implicit_test.{*}
use stdlib/list as list
use stdlib/list.{*}
use stdlib/iter.{*}

fn fusion_metric_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn fusion_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = mem_load64(fm + 8)
  let d = mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn fusion_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if fusion_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn fusion_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn fusion_metric_count(src: str) -> i64 {
  pipeline_native_fusion_count(fusion_metric_native(src))
}

fn fusion_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = fusion_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = fusion_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  fusion_metric_count_bl_to_target(code, off, end, target)
}

fn fusion_metric_traversal_role(src: str, fn_name: str) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  match typed {
    TypedModule(fns, caller_src, tt) -> {
      let entry = ftypes_find(ttable_get_checked_functions(tt), __str_ptr(fn_name), 0, __str_len(fn_name))
      pipeline_ir_semantic_traversal_role_for_entry(fns, tt, entry)
    }
  }
}

fn fusion_metric_traversal_call_count_insts(insts: IrInstList, facts: PipelineIrSemanticFactList, role: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrCallI64(dst, callee_hash, args) -> if pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash) == role { 1 } else { 0 }
        IrGenericCallI64(dst, callee_hash, type_args, args) -> if pipeline_ir_semantic_fact_lookup_traversal_role(facts, callee_hash) == role { 1 } else { 0 }
        _ -> 0
      }
      add + fusion_metric_traversal_call_count_insts(rest, facts, role)
    }
  }
}

fn fusion_metric_traversal_call_count_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList, role: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      fusion_metric_traversal_call_count_insts(insts, facts, role) + fusion_metric_traversal_call_count_blocks(rest, facts, role)
    }
  }
}

fn fusion_metric_traversal_call_count_functions(functions: IrFunctionList, facts: PipelineIrSemanticFactList, source: i64, role: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(IrFunction(hash, params, blocks, fn_source), rest) -> {
      let add = if fn_source == source { fusion_metric_traversal_call_count_blocks(blocks, facts, role) } else { 0 }
      add + fusion_metric_traversal_call_count_functions(rest, facts, source, role)
    }
  }
}

fn fusion_metric_traversal_call_count(src: str, role: i64) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
  fusion_metric_traversal_call_count_functions(
    pipeline_typed_optimisation_prefix_functions(prefix),
    pipeline_typed_optimisation_prefix_facts(prefix),
    __str_ptr(src),
    role
  )
}

fn fusion_double(x: i64) -> i64 { x * 2 }
fn fusion_inc(x: i64) -> i64 { x + 1 }
fn fusion_sum(acc: i64, x: i64) -> i64 { acc + x }
fn fusion_count(acc: i64, x: i64) -> i64 { acc + 1 }
fn fusion_even(x: i64) -> bool { x % 2 == 0 }
fn fusion_branchy(x: i64) -> bool {
  if x < 3 { false }
  else { x % 2 == 0 }
}

fn fusion_map_fold_value() -> i64 {
  let mapped = list.range(0, 5).map<i64>(fusion_double)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_filter_fold_value() -> i64 {
  let filtered = list.range(0, 7).filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_map_filter_fold_value() -> i64 {
  let mapped = list.range(0, 6).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_empty_value() -> i64 {
  let mapped = list.range(0, 0).map<i64>(fusion_double)
  mapped.fold<i64>(11, fusion_sum)
}

fn fusion_singleton_value() -> i64 {
  let mapped = Cons<i64>(3, Nil<i64>()).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_branchy)
  filtered.fold<i64>(0, fusion_count)
}

fn fusion_large_value() -> i64 {
  let mapped = list.range(0, 100).map<i64>(fusion_double)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_captured_value() -> i64 {
  let bias = 3
  let mapped = list.range(0, 4).map<i64>(x => x + bias)
  mapped.fold<i64>(0, fusion_sum)
}

fn fusion_nested_pipeline_value() -> i64 {
  let first = list.range(0, 4).map<i64>(fusion_inc)
  let mapped = first.map<i64>(fusion_double)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_receiver_chain_value() -> i64 {
  let mapped = list.range(0, 6).map<i64>(fusion_inc)
  let filtered = mapped.filter(fusion_even)
  filtered.fold<i64>(0, fusion_sum)
}

fn fusion_iterator_pipeline_value(start: i64, end: i64, limit: i64, init: i64) -> i64 {
  let mapped = iter_map<i64, i64>(iter_range(start, end), (value: i64) => value * 3 + 1)
  let filtered = iter_filter<i64>(mapped, (value: i64) => value % 2 == 0)
  let limited = iter_take<i64>(filtered, limit)
  iter_fold<i64, i64>(limited, init, (acc: i64, value: i64) => acc + value)
}

fn fusion_iterator_captured_cleanup_value(probe: RuntimeRcProbe) -> i64 {
  let mapped = iter_map<i64, i64>(iter_range(0, 4), (value: i64) => value + runtime_rc_probe_load(probe))
  let filtered = iter_filter<i64>(mapped, (value: i64) => value % 2 == 0)
  let limited = iter_take<i64>(filtered, 2)
  iter_fold<i64, i64>(limited, 0, (acc: i64, value: i64) => acc + value)
}

fn fusion_ir_sample_functions() -> IrFunctionList {
  let first_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 10),
    ir_inst_list_prepend(ir_inst_const_i64(1, 20), ir_inst_list_empty())
  )
  let first = ir_function_new(101, 0, ir_block_new_term(0, first_insts, ir_term_return(1)))
  let empty = ir_function_new(102, 0, ir_block_new_term(1, ir_inst_list_empty(), ir_term_return(0)))
  let third_insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 30),
    ir_inst_list_prepend(
      ir_inst_const_i64(1, 40),
      ir_inst_list_prepend(ir_inst_const_i64(2, 50), ir_inst_list_empty())
    )
  )
  let third = ir_function_new(103, 0, ir_block_new_term(2, third_insts, ir_term_return(2)))
  ir_function_list_prepend(first, ir_function_list_prepend(empty, ir_function_list_prepend(third, ir_function_list_empty())))
}

test "fusion_metric_happy_pipeline_matrix" {
  let map_fold = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 5).map<i64>(dbl) mapped.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(map_fold), 0)

  let filter_fold = "use stdlib/list as list use stdlib/list.{*} fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let filtered = list.range(0, 7).filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(filter_fold), 0)

  let map_filter_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 6).map<i64>(inc) let filtered = mapped.filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(map_filter_fold), 0)
}

test "fusion_semantic_traversal_roles_follow_resolved_sdk_declarations" {
  let src = "use stdlib/iter.{*} fn main() -> i64 { 0 }"
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_range"), cg_semantic_traversal_role_range_i64())
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_map"), cg_semantic_traversal_role_map())
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_filter"), cg_semantic_traversal_role_filter())
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_take"), cg_semantic_traversal_role_take())
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_fold"), cg_semantic_traversal_role_fold())
}

test "fusion_semantic_traversal_roles_reject_spelling_only_matches" {
  let src = "fn iter_range(start: i64, end: i64) -> i64 { end - start } fn main() -> i64 { iter_range(0, 2) }"
  Test.assert_eq(fusion_metric_traversal_role(src, "iter_range"), cg_semantic_traversal_role_none())
}

test "fusion_metric_iterator_pipeline_consumes_resolved_traversal_roles" {
  let src = "use stdlib/iter.{*} fn work(n: i64) -> i64 { let mapped = iter_map<i64, i64>(iter_range(0, n), (value: i64) => value * 3 + 1) let filtered = iter_filter<i64>(mapped, (value: i64) => value % 2 == 0) let limited = iter_take<i64>(filtered, n / 3) iter_fold<i64, i64>(limited, 0, (acc: i64, value: i64) => acc + value) } fn main() -> i64 { work(100) }"
  Test.assert_eq(fusion_metric_traversal_call_count(src, cg_semantic_traversal_role_range_map_filter_take_fold_i64()), 1)
}

test "fusion_metric_iterator_pipeline_rejects_escape_and_non_i64_shapes" {
  let escaped = "use stdlib/iter.{*} fn add(acc: i64, value: i64) -> i64 { acc + value } fn work(n: i64) -> i64 { let source = iter_range(0, n) let mapped = iter_map<i64, i64>(source, value => value + 1) let filtered = iter_filter<i64>(mapped, value => true) let limited = iter_take<i64>(filtered, n) iter_fold<i64, i64>(limited, 0, add) } fn main() -> i64 { work(4) }"
  Test.assert_eq(fusion_metric_traversal_call_count(escaped, cg_semantic_traversal_role_range_map_filter_take_fold_i64()), 0)

  let non_i64 = "use stdlib/iter.{*} fn work(n: i64) -> i64 { let mapped = iter_map<i64, bool>(iter_range(0, n), value => value % 2 == 0) let filtered = iter_filter<bool>(mapped, value => value) let limited = iter_take<bool>(filtered, n) iter_fold<bool, i64>(limited, 0, (acc: i64, value: bool) => if value { acc + 1 } else { acc }) } fn main() -> i64 { work(4) }"
  Test.assert_eq(fusion_metric_traversal_call_count(non_i64, cg_semantic_traversal_role_range_map_filter_take_fold_i64()), 0)
}

test "fusion_metric_receiver_pipeline_matrix" {
  let receiver_map_fold = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 5).map<i64>(dbl) mapped.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(receiver_map_fold), 0)

  let receiver_map_filter_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn even(x: i64) -> bool { x % 2 == 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { let mapped = list.range(0, 6).map<i64>(inc) let filtered = mapped.filter(even) filtered.fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(receiver_map_filter_fold), 0)
}

test "fusion_metric_rejects_unknown_collection_helper" {
  let src = "use stdlib/list as list use stdlib/list.{*} fn dbl(x: i64) -> i64 { x * 2 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn my_map(xs: List<i64>, f: (i64) -> i64) -> List<i64> { xs.map<i64>(f) } fn main() -> i64 { my_map(list.range(0, 5), dbl).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(src), 0)
}

test "fusion_metric_rejects_non_i64_type_args" {
  let src = "use stdlib/list.{*} fn keep(x: bool) -> bool { x } fn count(acc: i64, x: bool) -> i64 { if x { acc + 1 } else { acc } } fn main() -> i64 { Cons<bool>(true, Nil<bool>()).map<bool>(keep).fold<i64>(0, count) }"
  Test.assert_eq(fusion_metric_count(src), 0)
}

test "fusion_metric_rejects_raw_effect_callbacks" {
  let raw_map = "use stdlib/list as list use stdlib/list.{*} fn raw_map(x: i64) -> i64 { mem_load64(x) } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list.range(0, 3).map<i64>(raw_map).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(raw_map), 0)

  let raw_filter = "use stdlib/list as list use stdlib/list.{*} fn keep(x: i64) -> bool { mem_load64(x) != 0 } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list.range(0, 3).filter(keep).fold<i64>(0, add) }"
  Test.assert_eq(fusion_metric_count(raw_filter), 0)

  let raw_fold = "use stdlib/list as list use stdlib/list.{*} fn inc(x: i64) -> i64 { x + 1 } fn raw_add(acc: i64, x: i64) -> i64 { mem_store64(acc, x) acc + x } fn main() -> i64 { list.range(0, 3).map<i64>(inc).fold<i64>(0, raw_add) }"
  Test.assert_eq(fusion_metric_count(raw_fold), 0)
}

test "fusion_e2e_preserves_pipeline_values" {
  Test.assert_eq(fusion_map_fold_value(), 20)
  Test.assert_eq(fusion_filter_fold_value(), 12)
  Test.assert_eq(fusion_map_filter_fold_value(), 12)
  Test.assert_eq(fusion_receiver_chain_value(), 12)
}

test "fusion_e2e_iterator_pipeline_preserves_boundaries_and_cleanup" {
  Test.assert_eq(fusion_iterator_pipeline_value(0, 10, 3, 5), 35)
  Test.assert_eq(fusion_iterator_pipeline_value(0, 10, 0, 5), 5)
  Test.assert_eq(fusion_iterator_pipeline_value(5, 3, 4, 5), 5)
  Test.assert_eq(fusion_iterator_pipeline_value(0, 4, 20, 0), 14)
  let probe: RuntimeRcProbe = runtime_rc_probe_new(5)
  let before = runtime_rc_probe_count(probe)
  Test.assert_eq(fusion_iterator_captured_cleanup_value(probe), 14)
  Test.assert_eq(runtime_rc_probe_count(probe), before)
}

test "fusion_e2e_compiler_ir_traversal_helper" {
  let functions = fusion_ir_sample_functions()
  Test.assert_eq(ir_function_list_pipeline_inst_count(functions), ir_function_list_inst_count(functions))
  Test.assert_eq(ir_function_list_pipeline_inst_count(functions), 5)
}

test "fusion_adversarial_collection_shapes" {
  Test.assert_eq(fusion_empty_value(), 11)
  Test.assert_eq(fusion_singleton_value(), 1)
  Test.assert_eq(fusion_large_value(), 9900)
  Test.assert_eq(fusion_captured_value(), 18)
  Test.assert_eq(fusion_nested_pipeline_value(), 20)
}

test "fusion_receiver_pipeline_value_matrix" {
  let empty = list.range(0, 0)
  let xs = list.range(0, 10)
  let branchy = list.range(0, 8)

  Test.assert_eq(xs.map<i64>(fusion_double).fold<i64>(7, fusion_sum), 97)
  Test.assert_eq(branchy.filter(fusion_branchy).fold<i64>(0, fusion_sum), 10)
  Test.assert_eq(xs.map<i64>(fusion_inc).filter(fusion_even).fold<i64>(0, fusion_sum), 30)
  Test.assert_eq(empty.map<i64>(fusion_inc).filter(fusion_even).fold<i64>(5, fusion_sum), 5)
}
