use module_fixtures/test_helpers.{assert_close, assert_distinct_text, assert_ordered}

-- The root spells no assertion operation itself; every operation reaches the
-- generated Test handler through imported helpers.
test "imported helpers perform numeric assertions on the root's behalf" {
  assert_close(0.1 + 0.2, 0.3)
  assert_ordered(1, 2)
}

test "imported helpers perform text assertions on the root's behalf" {
  assert_distinct_text("weft", "loom")
}

test "a helper-only body still records passes through the shared handler" {
  let mut index = 0
  while index < 3 {
    assert_ordered(index, index + 1)
    index = index + 1
  }
}
