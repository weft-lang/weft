  let next_value = pipeline_ir_function_next_value(0, blocks)
  Test.assert_eq(pipeline_ir_native_value_home_count_for_blocks(0, blocks), next_value + 10)
}

fn residency_home_fact_handler_blocks() -> IrBlockList {
  let pop_outer = ir_inst_list_prepend(ir_inst_handler_pop_i64(201), ir_inst_list_empty())
  let pop_inner = ir_inst_list_prepend(ir_inst_handler_pop_i64(203), pop_outer)
  let push_inner = ir_inst_list_prepend(ir_inst_handle_i64(1, 0, 12, IrHandlerClauseBodyNil, 0), pop_inner)
  let push_outer = ir_inst_list_prepend(ir_inst_handle_i64(0, 0, 11, IrHandlerClauseBodyNil, 0), push_inner)
  ir_block_list_prepend(ir_block_new_term(0, push_outer, ir_term_return(0)), ir_block_list_empty())
}

test "residency_value_home_facts_include_nested_handler_scratch" {
  let blocks = residency_home_fact_handler_blocks()
  Test.assert_eq(pipeline_ir_native_value_home_count_include_handler_scratch(4, blocks, 0), 204)
  Test.assert_eq(pipeline_ir_native_value_home_count_include_handler_scratch(4, blocks, 2), 208)
}

fn residency_u32_at(p: i64) -> i64 {
  mem_load8_at(p, 0) + mem_load8_at(p, 1) * 256 + mem_load8_at(p, 2) * 65536 + mem_load8_at(p, 3) * 16777216
}

test "residency_value_home_emission_fails_loud_outside_facts" {
  let code = buf_new(64)
  pipeline_ir_native_emit_const(code, 2, 7, pipeline_ir_native_identity_home_facts(1))
  Test.assert_eq(buf_len(code), 8)
  Test.assert_eq(residency_u32_at(buf_ptr(code) + 4), encode_brk(20))
}

fn residency_chain_result() -> i64 {
  -- The same shape as the pressure snippet, executed in this test binary:
  -- when the suite compiles this file with the candidate compiler, this
  -- exercises the resident path at runtime.
  let a = 1
  let b = 2
  let c = a + b
  let d = c + a
  let e = d + b
  let f = e + c
  let g = f + d
  let h = g + e
  let i = h + f
  let j = i + g
  let k = j + h
  let l = k + i
  a + b + c + d + e + f + g + h + i + j + k + l
}

test "residency_chain_computes_correctly_at_runtime" {
  Test.assert_eq(residency_chain_result(), 274)
}

fn residency_src_fp_chain() -> str {
  "fn fwork(a: f64, b: f64) -> f64 { let c = a * b; let d = c + a; let e = d * c; let g = e - d; let h = g / b; h + e } fn main() -> i64 { let r = fwork(2.0, 1.5); if r > 0.0 { 0 } else { 1 } }"
}

test "residency_fp_pool_holds_f64_chain_values" {
  -- 2l stage 3 FP: block-local barrier-free f64 arithmetic values live in
  -- d2-d7 instead of round-tripping through fmov/x17/spill slots.
  let native = residency_native(residency_src_fp_chain())
  Test.assert_eq(residency_positive(pipeline_native_fp_resident_count(native) - 1), 1)
}

fn residency_fp_chain_result() -> f64 {
  -- Exact-representable f64 chain, executed in this test binary: when the
  -- suite compiles this file with the candidate compiler, the FP-resident
  -- path runs at runtime.
  let a = 2.0
  let b = 1.5
  let c = a * b
  let d = c + a
  let e = d * c
  let g = e - d
  let h = g / b
  h + e
}

test "residency_fp_chain_computes_correctly_at_runtime" {
  -- c=3, d=5, e=15, g=10, h=6.666..; guard with exact-representable parts:
  -- recompute with integer checks on exact steps instead.
  let a = 2.0
  let b = 1.5
  let c = a * b
  let d = c + a
  let e = d * c
  let g = e - d
  Test.assert_eq(if c == 3.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if d == 5.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if e == 15.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if g == 10.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if g / 2.0 == 5.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if residency_fp_chain_result() > 21.5 { 1 } else { 0 }, 1)
}

fn residency_src_fp_loop() -> str {
  "fn kernel(cr: f64, ci: f64) -> i64 { let mut zr = 0.0; let mut zi = 0.0; let mut n = 0; while n < 100 { let zr2 = zr * zr; let zi2 = zi * zi; let t = zr2 - zi2; let m = zr * zi; zi = m + m + ci; zr = t + cr; n = n + 1 } if zr < 4.0 { n } else { 0 } } fn main() -> i64 { if kernel(0.1, 0.1) == 100 { 0 } else { 1 } }"
}

test "residency_fp_pool_covers_loop_slot_loads" {
  -- Slot loads from d8-d15-resident f64 slots are FP defs: the kernel's
  -- zr/zi reads copy straight into the d2-d7 pool.
  let native = residency_native(residency_src_fp_loop())
  Test.assert_eq(residency_positive(pipeline_native_fp_resident_count(native) - 3), 1)
}

fn residency_fp_stale_alias_probe(x: f64, t: f64) -> f64 {
  -- Regression shape for the fp_env slot-alias hazard: a loaded value must
  -- keep its load-time contents even after the slot is overwritten.
  let mut s = x
  let a = s + t
  s = s * 4.0
  a + s
}

test "residency_fp_slot_store_does_not_corrupt_loaded_values" {
  -- a = 2.0 + 1.0 = 3.0 captured BEFORE s is rewritten to 8.0; total 11.0.
  Test.assert_eq(if residency_fp_stale_alias_probe(2.0, 1.0) == 11.0 { 1 } else { 0 }, 1)
}

fn residency_fp_loop_result() -> i64 {
  let mut zr = 0.5
  let mut zi = 0.25
  let mut n = 0
  while n < 8 {
    let zr2 = zr * zr
    let zi2 = zi * zi
    let t = zr2 - zi2
    let m = zr * zi
    zi = m + m
    zr = t
    n = n + 1
  }
  if zr < 1.0 and zr > 0.0 - 1.0 { 1 } else { 0 }
}

test "residency_fp_loop_computes_at_runtime" {
  Test.assert_eq(residency_fp_loop_result(), 1)
}

test "residency_vector_f64_roundtrip_at_runtime" {
  -- vector lanes as FP defs/uses: get feeds arithmetic feeds set, all
  -- through the d2-d7 pool when compiled by the resident backend.
  let v = vector_with_capacity<f64>(4)
  vector_push<f64>(v, 1.5)
  vector_push<f64>(v, 2.5)
  let a = vector_get<f64>(v, 0, 0.0)
  let b = vector_get<f64>(v, 1, 0.0)
  let c = a * b
  vector_set<f64>(v, 0, c)
  let d = vector_get<f64>(v, 0, 0.0)
  Test.assert_eq(if d == 3.75 { 1 } else { 0 }, 1)
}

fn residency_src_fp_cross_call() -> str {
  "fn fhelper(x: f64) -> f64 { x + 1.0 } fn fcross(a: f64, b: f64) -> f64 { let mut acc = 0.0; let p = a * b; let q = p + a; acc = q; let t = fhelper(b); let r = p * q; acc = acc + r + t; acc } fn main() -> i64 { if fcross(2.0, 3.0) > 0.0 { 0 } else { 1 } }"
}

test "residency_fp_values_survive_calls_in_callee_saved_pool" {
  -- p and q are defined before the fhelper call and used after it: the
  -- volatile d2-d7 pool cannot hold them, but the free d8-d15 capacity
  -- (already preserved for the acc slot) can.
  let native = residency_native(residency_src_fp_cross_call())
  Test.assert_eq(residency_positive(pipeline_native_fp_resident_count(native) - 1), 1)
}

fn residency_fp_cross_helper(x: f64) -> f64 {
  x + 1.0
}

fn residency_fp_cross_result() -> f64 {
  let mut acc = 0.0
  let p = 2.0 * 3.0
  let q = p + 2.0
  acc = q
  let t = residency_fp_cross_helper(3.0)
  let r = p * q
  acc = acc + r + t
  acc
}

test "residency_fp_cross_call_computes_at_runtime" {
  -- p=6, q=8, acc=8, t=4, r=48, acc=8+48+4=60 — all exact in f64.
  Test.assert_eq(if residency_fp_cross_result() == 60.0 { 1 } else { 0 }, 1)
}

fn residency_src_loop_with_calls() -> str {
  "fn getf(a: f64, i: i64) -> f64 { a * 1.5 } fn setf(a: f64) -> i64 { if a > 0.0 { 1 } else { 0 } } fn adv(a: f64, n: i64) -> i64 { let mut j = 0; let mut hits = 0; while j < n { let xi = getf(a, j); let xj = getf(a, j + 1); let dx = xi - xj; let d2 = dx * dx; let mag = 1.0 / d2; hits = hits + setf(dx * mag); j = j + 1 } hits } fn main() -> i64 { adv(1.25, 3) }"
}

test "residency_regions_unlock_loop_bodies_with_calls" {
  -- CFG call lowering splits loop bodies into jump-linked block chains;
  -- straight-line regions restore residency across the splits.
  let native = residency_native(residency_src_loop_with_calls())
  Test.assert_eq(residency_positive(pipeline_native_fp_resident_count(native) - 2), 1)
}

fn residency_loop_calls_helper(a: f64, i: i64) -> f64 {
  a * 1.5
}

fn residency_loop_calls_result() -> f64 {
  let mut j = 0
  let mut acc = 0.0
  while j < 4 {
    let xi = residency_loop_calls_helper(2.0, j)
    let xj = residency_loop_calls_helper(4.0, j)
    let dx = xj - xi
    let d2 = dx * dx
    acc = acc + d2
    j = j + 1
  }
  acc
}

test "residency_loop_with_calls_computes_at_runtime" {
  -- xi=3, xj=6, dx=3, d2=9, four iterations: acc=36 — exact in f64.
  Test.assert_eq(if residency_loop_calls_result() == 36.0 { 1 } else { 0 }, 1)
}

fn residency_src_bank_swap() -> str {
  -- bump carries a recursion guard to defeat the inliner (same pattern
  -- as the pressure snippets): the loop must contain a REAL call so
  -- acc/i stay barrier-crossing — a call-free loop's params live in
  -- the volatile pool since C3 and leave nothing for the permutation.
  "fn bump(x: i64) -> i64 { if x > 100 { x - 1 } else { if x < 0 - 1000000 { bump(x + 1) } else { x + 1 } } } fn hot(n: i64) -> i64 { let a = 1; let b = 2; let c = 3; let d = 4; let e = 5; let f = 6; let g = a + b + c + d + e + f; let mut i = 0; let mut acc = g; while i < n { let t = bump(acc); if t > 10 { acc = acc + t } else { acc = acc + 1 } i = i + 1 } acc + a } fn main() -> i64 { hot(4) }"
}

fn residency_src_call_free_loop() -> str {
  -- The pre-C3 bank-swap source: bump is inlinable, so the loop is
  -- barrier-free after inlining and the block params seat directly in
  -- caller-saved registers.
  "fn bump(x: i64) -> i64 { if x > 100 { x - 1 } else { x + 1 } } fn hot(n: i64) -> i64 { let a = 1; let b = 2; let c = 3; let d = 4; let e = 5; let f = 6; let g = a + b + c + d + e + f; let mut i = 0; let mut acc = g; while i < n { let t = bump(acc); if t > 10 { acc = acc + t } else { acc = acc + 1 } i = i + 1 } acc + a } fn main() -> i64 { hot(4) }"
}

test "residency_bank_swaps_promote_loop_slots" {
  -- The (non-inlinable) call disables leaf pinning and the branch
  -- splits regions, so acc/i are hot spilled slots that only the bank
  -- permutation can hold; a..f are cold entry-only bank values to
  -- displace.
  let native = residency_native(residency_src_bank_swap())
  Test.assert_eq(residency_positive(pipeline_native_bank_swap_count(native)), 1)
}

test "residency_call_free_loop_params_live_in_pool" {
  -- 2v Stage 2 C3: with the call inlined away the loop is
  -- barrier-free, its rounded block-param windows seat in the volatile
  -- pool as interval tenants, and the bank permutation has no hot
  -- spilled slot left to promote.
  let native = residency_native(residency_src_call_free_loop())
  Test.assert_eq(residency_positive(pipeline_native_ir_param_resident_count(native)), 1)
  Test.assert_eq(residency_positive(pipeline_native_crossblock_pool_counter(native, 0)), 1)
  Test.assert_eq(pipeline_native_bank_swap_count(native), 0)
}

fn residency_swap_bump(x: i64) -> i64 {
  -- Same recursion guard as the compiled snippet's bump: this file is
  -- itself compiled by the candidate compiler, so the runtime
  -- companion exercises the same barrier-crossing shape.
  if x > 100 { x - 1 } else { if x < 0 - 1000000 { residency_swap_bump(x + 1) } else { x + 1 } }
}

fn residency_bank_swap_result() -> i64 {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = a + b + c + d + e + f
  let mut i = 0
  let mut acc = g
  while i < 4 {
    let t = residency_swap_bump(acc)
    if t > 10 {
      acc = acc + t
    } else {
      acc = acc + 1
    }
    i = i + 1
  }
  acc + a
}

test "residency_bank_swap_computes_at_runtime" {
  -- g=21: bump crosses 100 mid-loop; verified against the same
  -- computation done inline.
  let mut i = 0
  let mut acc = 21
  while i < 4 {
    let t = if acc > 100 { acc - 1 } else { acc + 1 }
    if t > 10 {
      acc = acc + t
    } else {
      acc = acc + 1
    }
    i = i + 1
  }
  Test.assert_eq(residency_bank_swap_result(), acc + 1)
}

fn residency_src_swap_with_lambda() -> str {
  "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn bump2(x: i64) -> i64 { if x > 100 { x - 1 } else { x + 1 } } fn hotl(n: i64) -> i64 { let a = 1; let b = 2; let c = 3; let d = 4; let e = 5; let f = 6; let g = a + b + c + d + e + f; let mut i = 0; let mut acc = g; let addg = (x: i64) => x + g; while i < n { let t = bump2(acc); if t > 10 { acc = acc + apply(addg, t) } else { acc = acc + 1 } i = i + 1 } acc + a } fn main() -> i64 { hotl(4) }"
}

test "residency_bank_swaps_survive_lambdas" {
  -- The lambda dst/env ids keep identity homes and its capture reads go
  -- through the pinned map, so lambda-containing functions swap too.
  let native = residency_native(residency_src_swap_with_lambda())
  Test.assert_eq(residency_positive(pipeline_native_bank_swap_count(native)), 1)
}

fn residency_swap_lambda_result() -> i64 {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = a + b + c + d + e + f
  let mut i = 0
  let mut acc = g
  let addg = (x: i64) => x + g
  while i < 4 {
    let t = residency_swap_bump(acc)
    if t > 10 {
      acc = acc + addg(t)
    } else {
      acc = acc + 1
    }
    i = i + 1
  }
  acc + a
}

test "residency_swap_lambda_computes_at_runtime" {
  -- Same computation done inline: capture g through the closure while
  -- acc/i live in swapped bank homes.
  let g = 21
  let mut i = 0
  let mut acc = 21
  while i < 4 {
    let t = if acc > 100 { acc - 1 } else { acc + 1 }
    if t > 10 {
      acc = acc + t + g
    } else {
      acc = acc + 1
    }
    i = i + 1
  }
  Test.assert_eq(residency_swap_lambda_result(), acc + 1)
}

fn residency_ref_str_hash(src: i64, start: i64, len: i64) -> i64 {
  -- Reference byte-at-a-time djb2, the shape str_hash had before the
  -- eight-wide rewrite; the two must agree on every input.
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = h * 33 + mem_load8_at(src + start + i, 0)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}

test "residency_wide_str_hash_matches_reference" {
  let s = "pipeline_ir_native_volatile_residents_and_high_bytes_\u00ff\u00fe"
  let p = __str_ptr(s)
  let n = __str_len(s)
  let mut l = 0
  let mut mismatches = 0
  while l <= n {
    if str_hash(p, 0, l) != residency_ref_str_hash(p, 0, l) { mismatches = mismatches + 1 } else { 0 }
    if l < n {
      if str_hash(p, n - l, l) != residency_ref_str_hash(p, n - l, l) { mismatches = mismatches + 1 } else { 0 }
    } else { 0 }
    l = l + 1
  }
  Test.assert_eq(mismatches, 0)
}

test "residency_got_hash_literals_match_hash_name" {
  -- The baked GOT dispatch literals must track str_hash exactly.
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_posix_spawn")), 0)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_waitpid")), 1)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_mmap")), 5)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_write")), 6)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_pthread_cond_destroy")), 18)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_opendir")), 22)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_readdir")), 23)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_closedir")), 24)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_stat")), 25)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_mkdir")), 26)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_remove")), 27)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_rename")), 28)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got_getcwd")), 29)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(pipeline_ir_native_hash_name("__got___error")), 30)
  Test.assert_eq(pipeline_ir_native_got_index_for_hash(12345), 0 - 1)
}

fn residency_src_cs_cross_call() -> str {
  -- keep (value id 8) is defined by simple arithmetic before two calls
  -- and used by simple arithmetic after them: the volatile pool rejects
  -- it (call barriers), but t1-t5's bank homes are dead by then and the
  -- callee-saved linear scan reuses one (2l stage 3).
  "fn csh(x: i64) -> i64 { if x > 100 { x - 1 } else { if x < 0 - 1000000 { csh(x + 1) } else { x + 1 } } } fn work(a: i64, b: i64) -> i64 { let t1 = a + b; let t2 = t1 + a; let t3 = t2 + b; let t4 = t3 + t1; let t5 = t4 + t2; let t6 = t5 + t3; let keep = t6 + a; let c1 = csh(a); let c2 = csh(b); keep + c1 + c2 } fn main() -> i64 { work(6, 7) }"
}

test "residency_cs_pool_holds_call_crossing_values" {
  let native = residency_native(residency_src_cs_cross_call())
  Test.assert_eq(residency_positive(pipeline_native_ir_cs_resident_count(native)), 1)
}

fn residency_src_cs_reusable_param_homes() -> str {
  -- Eight parameters occupy every identity-bank home. All are scalar and
  -- dead before keep crosses the call, so Stage 3 may reuse one home.
  "fn cshp(x: i64) -> i64 { if x > 100 { x - 1 } else { if x < 0 - 1000000 { cshp(x + 1) } else { x + 1 } } } fn workp(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let seed = a + b + c + d + e + f + g + h; let keep = seed * 3; let called = cshp(seed); keep + called } fn main() -> i64 { workp(1, 2, 3, 4, 5, 6, 7, 8) }"
}

test "residency_cs_pool_reuses_dead_scalar_param_homes" {
  let native = residency_native(residency_src_cs_reusable_param_homes())
  -- With eight params the old non-param-only pool had zero homes. The
  -- scalar-param lifetime rule supplies at least one without changing a
  -- metric pin elsewhere.
  Test.assert_eq(residency_positive(pipeline_native_ir_cs_resident_count(native)), 1)
}

test "residency_param_home_reuse_respects_cleanup_ownership" {
  let managed = ty_named(991337, ty_i64())
  let marker = ir_inst_slot_i64(pipeline_ir_borrowed_param_mask_slot(4))
  let insts = ir_inst_list_prepend(
    ir_inst_bind_typed_i64(0, 0, 0, ty_i64()),
    ir_inst_list_prepend(
      ir_inst_bind_typed_i64(0, 0, 1, managed),
      ir_inst_list_prepend(
        ir_inst_bind_typed_i64(0, 0, 2, managed),
        ir_inst_list_prepend(marker, ir_inst_list_empty())
      )
    )
  )
  let blocks = ir_block_list_prepend(ir_block_new(0, insts), ir_block_list_empty())
  let reusable = pipeline_ir_native_reusable_param_homes(blocks, 3)
  Test.assert_eq(nlist_get(reusable, 0), 1) -- scalar: no cleanup
  Test.assert_eq(nlist_get(reusable, 1), 0) -- owned managed: cleanup reads home
  Test.assert_eq(nlist_get(reusable, 2), 1) -- borrowed managed: caller-owned
}

fn residency_param_home_helper(x: i64) -> i64 {
  if x > 100 { x - 1 }
  else { if x < 0 - 1000000 { residency_param_home_helper(x + 1) } else { x + 1 } }
}

fn residency_reusable_param_home_result(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
  let seed = a + b + c + d + e + f + g + h
  let keep = seed * 3
  let called = residency_param_home_helper(seed)
  keep + called
}

test "residency_reused_param_home_computes_at_runtime" {
  -- seed=36, keep=108, called=37.
  Test.assert_eq(residency_reusable_param_home_result(1, 2, 3, 4, 5, 6, 7, 8), 145)
}

fn residency_cs_helper(x: i64) -> i64 {
  if x > 100 { x - 1 } else { x + 1 }
}

fn residency_cs_cross_result() -> i64 {
  let t1 = 6 + 7
  let t2 = t1 + 6
  let t3 = t2 + 7
  let t4 = t3 + t1
  let t5 = t4 + t2
  let t6 = t5 + t3
  let keep = t6 + 6
  let c1 = residency_cs_helper(6)
  let c2 = residency_cs_helper(7)
  keep + c1 + c2
}

test "residency_cs_cross_call_computes_at_runtime" {
  -- t1=13 t2=19 t3=26 t4=39 t5=58 t6=84 keep=90 c1=7 c2=8 -> 105.
  Test.assert_eq(residency_cs_cross_result(), 105)
}

fn residency_cs_loop_result(n: i64) -> i64 {
  -- Padding values keep the loop-body candidate above the bank range;
  -- base crosses the call each iteration and must reload correctly
  -- whether it is spilled or callee-saved resident.
  let p1 = n + 1
  let p2 = p1 + n
  let p3 = p2 + p1
  let p4 = p3 + p2
  let p5 = p4 + p3
  let p6 = p5 + p4
  let p7 = p6 + p5
  let mut i = 0
  let mut acc = p7
  while i < n {
    let base = i * 3 + n
    let c = residency_cs_helper(i)
    acc = acc + base + c
    i = i + 1
  }
  acc
}

test "residency_cs_loop_computes_at_runtime" {
  -- n=4: p7=steps to 47; iterations add (base=i*3+4)+(c=i+1) for i=0..3:
  -- (4+1)+(7+2)+(10+3)+(13+4) = 44; 47+44 = 91.
  let mut expect = 0
  let n = 4
  let p1 = n + 1
  let p2 = p1 + n
  let p3 = p2 + p1
  let p4 = p3 + p2
  let p5 = p4 + p3
  let p6 = p5 + p4
  expect = p6 + p5
  let mut i = 0
  while i < n {
    expect = expect + (i * 3 + n) + (i + 1)
    i = i + 1
  }
  Test.assert_eq(residency_cs_loop_result(4), expect)
}

fn residency_cs_param_result(flag: i64) -> i64 {
  -- Mirror of the audited cs-param shape: the merge value must survive
  -- two calls whether it is frame-homed or callee-saved resident.
  let t1 = 6 + 7
  let t2 = t1 + 6
  let t3 = t2 + 7
  let t4 = t3 + t1
  let t5 = t4 + t2
  let t6 = t5 + t3
  let c = if flag == 1 { t6 + 6 } else { t6 - 7 }
  let d = residency_cs_helper(6)
  let e = residency_cs_helper(7)
  c + d + e
}

test "residency_cs_param_computes_at_runtime" {
  -- t6=84: flag path c=90, else c=77; d=7, e=8.
  Test.assert_eq(residency_cs_param_result(1), 105)
  Test.assert_eq(residency_cs_param_result(0), 92)
}
