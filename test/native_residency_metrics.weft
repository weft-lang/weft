  Test.assert_eq(pipeline_ir_native_vector_data_fact_reload_for(entries, 4, 0), 1)
}

test "residency_vector_cache_fact_lookup_rejects_missing_or_wrong_vector" {
  let facts = pipeline_ir_native_vector_data_facts_for_blocks(residency_vector_fact_blocks_same_vec())
  let entries = pipeline_ir_native_vector_data_facts_entries(facts)
  Test.assert_eq(pipeline_ir_native_vector_data_fact_reload_for(entries, 99, 0), 0 - 1)
  Test.assert_eq(pipeline_ir_native_vector_data_fact_reload_for(entries, 3, 9), 0 - 1)
}

fn residency_f64_slot_fact_blocks(address_taken: i64) -> IrBlockList {
  let mut insts = ir_inst_list_empty()
  insts = ir_inst_list_prepend(ir_inst_float_binary_i64(12, PRIM_F64(), ir_binary_op_add(), 11, 10), insts)
  insts = ir_inst_list_prepend(ir_inst_load_i64(11, 8), insts)
  if address_taken == 1 { insts = ir_inst_list_prepend(ir_inst_address_of_slot_i64(13, 8), insts) } else { 0 }
  insts = ir_inst_list_prepend(ir_inst_store_i64(8, 10), insts)
  insts = ir_inst_list_prepend(ir_inst_float_binary_i64(10, PRIM_F64(), ir_binary_op_add(), 0, 1), insts)
  insts = ir_inst_list_prepend(ir_inst_slot_i64(8), insts)
  ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(12)), ir_block_list_empty())
}

test "residency_f64_slot_facts_are_typed_then_allocator_assigned" {
  let blocks = residency_f64_slot_fact_blocks(0)
  let raw = pipeline_ir_native_f64_facts_for_blocks(blocks)
  Test.assert_eq(pipeline_ir_native_int_list_contains(pipeline_ir_native_f64_facts_slot_candidates(raw), 8), 1)
  Test.assert_eq(pipeline_ir_native_f64_slot_home_count(raw), 0)
  let assigned = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, raw)
  Test.assert_eq(pipeline_ir_native_f64_slot_home_count(assigned), 1)
  Test.assert_eq(pipeline_ir_native_f64_slot_home_lookup(assigned, 8), 8)
}

test "residency_f64_slot_fact_assignment_rejects_address_taken_slot" {
  let blocks = residency_f64_slot_fact_blocks(1)
  let raw = pipeline_ir_native_f64_facts_for_blocks(blocks)
  Test.assert_eq(pipeline_ir_native_int_list_contains(pipeline_ir_native_f64_facts_slot_candidates(raw), 8), 1)
  let assigned = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, raw)
  Test.assert_eq(pipeline_ir_native_f64_slot_home_count(assigned), 0)
  Test.assert_eq(pipeline_ir_native_f64_slot_home_lookup(assigned, 8), 0 - 1)
}

test "residency_value_home_facts_materialise_identity_and_allocator_homes" {
  let older = pipeline_ir_native_pinned_slot_new(8, 13, pipeline_ir_native_pinned_slot_kind_resident(), pipeline_ir_native_pinned_slot_none())
  let assignments = pipeline_ir_native_pinned_slot_new(8, 12, pipeline_ir_native_pinned_slot_kind_resident(), older)
  let facts = pipeline_ir_native_value_home_facts(11, assignments)
  Test.assert_eq(pipeline_ir_native_value_home_fact_count(facts), 11)
  Test.assert_eq(pipeline_ir_native_value_home_lookup(facts, 0), 19)
  Test.assert_eq(pipeline_ir_native_value_home_lookup(facts, 8), 12)
  Test.assert_eq(pipeline_ir_native_value_home_lookup(facts, 10), 0 - 3)
  Test.assert_eq(pipeline_ir_native_value_home_lookup(facts, 11), 0)
  let identity = pipeline_ir_native_identity_home_facts_like(facts)
  Test.assert_eq(pipeline_ir_native_value_home_lookup(identity, 8), 0 - 1)
}

