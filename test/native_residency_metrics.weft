fn residency_vector_fact_blocks_two_blocks() -> IrBlockList {
  let second_insts = ir_inst_list_prepend(ir_inst_vector_get_i64(4, 0, 1, 2, 0), ir_inst_list_empty())
  let second = ir_block_list_prepend(ir_block_new_term(1, second_insts, ir_term_return(4)), ir_block_list_empty())
  let first_insts = ir_inst_list_prepend(ir_inst_vector_get_i64(3, 0, 1, 2, 0), ir_inst_list_empty())
  ir_block_list_prepend(ir_block_new_term(0, first_insts, ir_term_jump(1)), second)
}

test "residency_vector_cache_facts_reset_at_block_boundary" {
  let facts = pipeline_ir_native_vector_data_facts_for_blocks(residency_vector_fact_blocks_two_blocks())
  let entries = pipeline_ir_native_vector_data_facts_entries(facts)
