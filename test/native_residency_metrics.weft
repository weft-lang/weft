  let clobber = ir_inst_list_prepend(ir_inst_call_i64(4, 123, ir_value_list_empty()), after)
  let insts = ir_inst_list_prepend(ir_inst_vector_get_i64(3, 0, 1, 2, 0), clobber)
  ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(5)), ir_block_list_empty())
}

test "residency_vector_cache_facts_reload_after_call_clobber" {
