-- test/native_residency_metrics.weft -- typed SSA register residency ledger (2l)
--
-- Measures sp-based memory traffic in the emitted code buffer itself.
-- Stage 0 records current reality; each 2l stage must move these numbers
-- down and flip the structural asserts that encode its deletion condition.

use "stdlib/vector.weft"
use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn residency_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn residency_src_answer() -> str {
  "fn main() -> i64 { 42 }"
}

fn residency_src_pressure() -> str {
  -- Widened past the full caller-saved pool (2v Stage 1: x1-x7 +
  -- x12-x14 + idle x8/x9/x10/x11 = 13 homes, plus the 8 bank homes)
  -- so overlapping windows still force sp spill traffic.
  "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; let m = l + j; let n = m + k; let o = n + l; let p = o + m; let q = p + n; let r = q + o; let s = r + p; let t = s + q; let u = t + r; let v = u + s; let w = v + t; let x = w + u; let y = x + v; let z = y + w; a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r + s + t + u + v + w + x + y + z } fn main() -> i64 { work(1, 2) }"
}

fn residency_positive(count: i64) -> i64 {
  if count > 0 { 1 } else { 0 }
}

test "residency_sp_pair_traffic_exists_for_trivial_module" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(residency_positive(pipeline_native_sp_pair_store_count(native)), 1)
  Test.assert_eq(residency_positive(pipeline_native_sp_pair_load_count(native)), 1)
}

test "residency_integer_only_module_has_no_fp_pair_traffic" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_sp_fp_pair_store_count(native), 0)
  Test.assert_eq(pipeline_native_sp_fp_pair_load_count(native), 0)
}

test "residency_no_prologue_saves_volatile_x8_x15_bank" {
  -- 2l stage 1 landed: x8-x15 are volatile scratch and never live across a
  -- call, so no prologue/epilogue may touch the bank anywhere in the module.
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(8, 9, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(10, 11, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(12, 13, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(14, 15, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(8, 9, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(10, 11, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(12, 13, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(14, 15, 31, 16)), 0)
}

test "residency_pressure_pair_saves_are_value_bank_and_frame_only" {
  -- Every prologue is now at most x19-x26 + fp/lr (5 GPR pairs) plus the
  -- FP bank when f64 slots are resident: pair stores == pair loads shape
  -- is covered by the balance test; here we pin the volatile bank at zero
  -- under spill pressure too.
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(8, 9, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(8, 9, 31, 16)), 0)
}

test "residency_value_bank_saves_are_monotone_by_pair" {
  -- Prologues save pairs from x19/x20 upward, so lower pairs are always at
  -- least as frequent as higher ones. Uniform saving gives equality; the
  -- per-function value-bank mask makes the inequality strict for small
  -- functions (2l stage 1 slice 2).
  let native = residency_native(residency_src_pressure())
  let s1920 = pipeline_native_code_word_count(native, encode_stp_pre(19, 20, 31, 0 - 16))
  let s2122 = pipeline_native_code_word_count(native, encode_stp_pre(21, 22, 31, 0 - 16))
  let s2324 = pipeline_native_code_word_count(native, encode_stp_pre(23, 24, 31, 0 - 16))
  let s2526 = pipeline_native_code_word_count(native, encode_stp_pre(25, 26, 31, 0 - 16))
  Test.assert_eq(residency_positive(s1920), 1)
  Test.assert_eq(residency_positive(s1920 - s2122 + 1), 1)
  Test.assert_eq(residency_positive(s2122 - s2324 + 1), 1)
  Test.assert_eq(residency_positive(s2324 - s2526 + 1), 1)
}

test "residency_pressure_function_keeps_full_value_bank" {
  -- work() allocates 12+ values, so its prologue must still save x25/x26.
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(residency_positive(pipeline_native_code_word_count(native, encode_stp_pre(25, 26, 31, 0 - 16))), 1)
}

test "residency_small_functions_skip_the_top_value_bank_pair" {
  -- The trivial module's functions never reach x25/x26, so the mask leaves
  -- the top pair unsaved everywhere.
  let trivial = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_code_word_count(trivial, encode_stp_pre(25, 26, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(trivial, encode_ldp_post(25, 26, 31, 16)), 0)
}

test "residency_spill_pressure_produces_sp_scalar_traffic" {
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(residency_positive(pipeline_native_sp_load_count(native)), 1)
  Test.assert_eq(residency_positive(pipeline_native_sp_store_count(native)), 1)
}

test "residency_volatile_pool_holds_block_local_values" {
  -- Stage 3 + 2v Stage 1: barrier-free block-local SSA values live in the
  -- full caller-saved pool (x1-x7 preferred, then x12-x14 and idle
  -- x8/x9/x10/x11).
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(residency_positive(pipeline_native_volatile_resident_count(native) - 2), 1)
}

fn residency_x8_pressure_insts() -> IrInstList {
  -- Six simultaneously live spill values consume the first six homes in
  -- allocation order: x1-x6 (2v Stage 1 pool order).
  let mut insts = ir_inst_list_empty()
  insts = ir_inst_list_prepend(ir_inst_binary_i64(18, ir_binary_op_add(), 17, 16), insts)
  insts = ir_inst_list_prepend(ir_inst_binary_i64(17, ir_binary_op_add(), 14, 15), insts)
  insts = ir_inst_list_prepend(ir_inst_binary_i64(16, ir_binary_op_add(), 12, 13), insts)
  insts = ir_inst_list_prepend(ir_inst_binary_i64(15, ir_binary_op_add(), 10, 11), insts)
  insts = ir_inst_list_prepend(ir_inst_binary_i64(14, ir_binary_op_add(), 8, 9), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(13, 6), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(12, 5), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(11, 4), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(10, 3), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(9, 2), insts)
  insts = ir_inst_list_prepend(ir_inst_const_i64(8, 1), insts)
  insts
}

fn residency_x8_pressure_blocks() -> IrBlockList {
  ir_block_list_prepend(ir_block_new_term(0, residency_x8_pressure_insts(), ir_term_return(18)), ir_block_list_empty())
}

fn residency_vector_data_facts(blocks: IrBlockList) -> PipelineIrNativeVectorDataFacts {
  pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
}

fn residency_f64_facts(blocks: IrBlockList) -> PipelineIrNativeF64Facts {
  pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
}

-- nconsts simultaneously-live consts (values 8..8+nconsts-1) followed by a
-- pairwise add reduction; every const stays live until its consuming add,
-- so the first nconsts pool homes fill in allocation order
-- x1-x7, x12-x14, x8, x10, x11, x9. Final value id is 8 + 2*nconsts - 2.
fn residency_wide_pressure_insts(nconsts: i64) -> IrInstList {
  let mut insts = ir_inst_list_empty()
  let queue = nlist_new()
  let mut i = 0
  while i < nconsts {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(8 + i, i + 1), ir_inst_list_empty()))
    nlist_add(queue, 8 + i)
    i = i + 1
  }
  let mut next = 8 + nconsts
  let mut qi = 0
  while qi + 1 < nlist_len(queue) {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), nlist_get(queue, qi), nlist_get(queue, qi + 1)), ir_inst_list_empty()))
    nlist_add(queue, next)
    next = next + 1
    qi = qi + 2
  }
  insts
}

fn residency_wide_pressure_final(nconsts: i64) -> i64 { 8 + nconsts * 2 - 2 }

fn residency_wide_pressure_blocks(nconsts: i64) -> IrBlockList {
  ir_block_list_prepend(ir_block_new_term(0, residency_wide_pressure_insts(nconsts), ir_term_return(residency_wide_pressure_final(nconsts))), ir_block_list_empty())
}

test "residency_volatile_pool_prefers_x1_x7" {
  -- 2v Stage 1: the low caller-saved registers head the pool order.
  let fm = fmap_new()
  let blocks = residency_x8_pressure_blocks()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), 1)
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 13), 6)
}

test "residency_volatile_pool_borrows_unclaimed_x8" {
  -- The 11th simultaneously-live value reaches x8 (after x1-x7 and
  -- x12-x14) when the slot-pin pass has not claimed it.
  let fm = fmap_new()
  let blocks = residency_wide_pressure_blocks(11)
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 18), 8)
}

test "residency_slot_tenant_keeps_x8_from_volatile_pool" {
  let fm = fmap_new()
  let blocks = residency_wide_pressure_blocks(11)
  let slot_homes = pipeline_ir_native_pinned_slot_new(99, 8, pipeline_ir_native_pinned_slot_kind_loop(), pipeline_ir_native_pinned_slot_none())
  let homes = pipeline_ir_native_volatile_residents(0, blocks, slot_homes, fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 99), 8)
  Test.assert_eq(if pipeline_ir_native_pinned_slot_lookup(homes, 18) == 8 { 1 } else { 0 }, 0)
}

test "residency_volatile_pool_borrows_idle_vector_cache_x9" {
  -- x9 is the last pool member; the 14th simultaneously-live value
  -- reaches it only when no vector lane access claims the cache.
  let fm = fmap_new()
  let blocks = residency_wide_pressure_blocks(14)
  let vector_data_facts = residency_vector_data_facts(blocks)
  Test.assert_eq(pipeline_ir_native_vector_data_facts_have_access(vector_data_facts), 0)
  Test.assert_eq(pipeline_ir_native_vector_data_facts_home(vector_data_facts), 0)
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), vector_data_facts)
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 21), 9)
}

test "residency_vector_access_reserves_cache_x9" {
  let vector_tail = ir_inst_list_prepend(ir_inst_vector_get_i64(40, 0, 1, 2, 0), ir_inst_list_empty())
  let insts = ir_inst_list_append(residency_wide_pressure_insts(14), vector_tail)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(40)), ir_block_list_empty())
  let vector_data_facts = residency_vector_data_facts(blocks)
  Test.assert_eq(pipeline_ir_native_vector_data_facts_have_access(vector_data_facts), 1)
  Test.assert_eq(pipeline_ir_native_vector_data_facts_home(vector_data_facts), 9)
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(3, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), vector_data_facts)
  Test.assert_eq(if pipeline_ir_native_pinned_slot_lookup(homes, 21) == 9 { 1 } else { 0 }, 0)
}

-- 2v Stage 1 call-window tenancy: a value whose FINAL use is a
-- pinned-aware call lives in the arg-safe segment (x12 first) up to the
-- call itself.

test "residency_call_final_use_lives_in_arg_safe_register" {
  let call = ir_inst_list_prepend(ir_inst_call_i64(9, 123, ir_value_list_prepend(8, ir_value_list_empty())), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_const_i64(8, 41), call)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), 12)
}

test "residency_call_result_feeding_call_lives_in_arg_safe_register" {
  -- g(f()) — the inner call's result is defined after its own clobber
  -- and read before the outer call's, so the window is clobber-free.
  let outer = ir_inst_list_prepend(ir_inst_call_i64(9, 456, ir_value_list_prepend(8, ir_value_list_empty())), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_call_i64(8, 123, ir_value_list_empty()), outer)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), 12)
}

-- The negative cases must never land in the caller-saved pool (x1-x14);
-- a callee-saved x19-x26 home from the cs home-reuse scan (which calls
-- preserve) or no assignment at all are both correct outcomes.
fn residency_in_caller_saved_pool(homes: i64, value: i64) -> i64 {
  let phys = pipeline_ir_native_pinned_slot_lookup(homes, value)
  if phys >= 1 and phys <= 14 { 1 } else { 0 }
}

test "residency_value_reused_after_call_avoids_call_window" {
  -- A non-final call use would leave a caller-saved register clobbered
  -- while the value is still needed: no caller-saved tenancy.
  let tail = ir_inst_list_prepend(ir_inst_binary_i64(10, ir_binary_op_add(), 8, 9), ir_inst_list_empty())
  let call = ir_inst_list_prepend(ir_inst_call_i64(9, 123, ir_value_list_prepend(8, ir_value_list_empty())), tail)
  let insts = ir_inst_list_prepend(ir_inst_const_i64(8, 41), call)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(10)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(residency_in_caller_saved_pool(homes, 8), 0)
}

test "residency_call_final_use_with_prior_barrier_avoids_call_window" {
  -- An intervening call between def and final use clobbers any
  -- caller-saved home: no caller-saved tenancy.
  let outer = ir_inst_list_prepend(ir_inst_call_i64(10, 456, ir_value_list_prepend(8, ir_value_list_empty())), ir_inst_list_empty())
  let mid = ir_inst_list_prepend(ir_inst_call_i64(9, 123, ir_value_list_empty()), outer)
  let insts = ir_inst_list_prepend(ir_inst_const_i64(8, 41), mid)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(10)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(residency_in_caller_saved_pool(homes, 8), 0)
}

-- 2v Stage 3 constant remat: barrier-crossing movz-range constants the
-- cs home-reuse scan could not seat re-materialize at each use; the
-- pinned phys carries the constant (remat_base + k). Ten constants
-- cross one call: the first eight take x19-x26, the ninth (small)
-- remats, the tenth (out of movz range) keeps its slot.

fn residency_remat_pressure_blocks() -> IrBlockList {
  let mut insts = ir_inst_list_empty()
  let mut i = 0
  while i < 9 {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(8 + i, i + 1), ir_inst_list_empty()))
    i = i + 1
  }
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(17, 100000), ir_inst_list_empty()))
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(18, 123, ir_value_list_empty()), ir_inst_list_empty()))
  let mut acc = 8
  let mut next = 19
  let mut j = 9
  while j < 18 {
    let operand = if next == 19 { 9 } else { j }
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), acc, operand), ir_inst_list_empty()))
    acc = next
    next = next + 1
    j = j + 1
  }
  ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(acc)), ir_block_list_empty())
}

-- Stage 4 def-segment split tenancy: a value with uses both inside
-- and beyond its def's barrier-free segment takes a pool register for
-- the segment only (deleting the segment reloads); later uses read
-- the slot the walker persisted.

test "residency_segment_and_later_uses_get_split_home" {
  -- Eight constants with four post-call uses each (benefit 5) saturate
  -- the cs homes; v16 (call result, benefit 5 but later start loses
  -- the tie) has two segment uses, a call-arg use, and a post-call
  -- use — no whole-range pass can take it, so the split pass gives it
  -- a pool register for the def segment only.
  let mut insts = ir_inst_list_empty()
  let mut i = 0
  while i < 8 {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(8 + i, i + 1), ir_inst_list_empty()))
    i = i + 1
  }
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(16, 111, ir_value_list_empty()), ir_inst_list_empty()))
  -- Four distinct use SITES per const: add_inst_uses is a live SET,
  -- so a same-value double operand (c + c) records only one use.
  let mut next = 17
  let mut c = 8
  while c < 16 {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), c, c), ir_inst_list_empty()))
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next + 1, ir_binary_op_add(), c, c), ir_inst_list_empty()))
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next + 2, ir_binary_op_add(), c, c), ir_inst_list_empty()))
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next + 3, ir_binary_op_add(), c, c), ir_inst_list_empty()))
    next = next + 4
    c = c + 1
  }
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), 16, 16), ir_inst_list_empty()))
  let seg_add = next
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(next + 1, 222, ir_value_list_prepend(16, ir_value_list_empty())), ir_inst_list_empty()))
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next + 2, ir_binary_op_add(), 16, next + 1), ir_inst_list_empty()))
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(next + 2)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), 19)
  let phys = pipeline_ir_native_pinned_slot_lookup(homes, 16)
  Test.assert_eq(if phys >= 1 and phys <= 14 { 1 } else { 0 }, 1)
  Test.assert_eq(nlist_get(fmap_current_split_map(fm), 16), phys)
  Test.assert_eq(fmap_ir_native_split_resident_count(fm), 1)
}

-- Stage 5 weight-aware seating: nine barrier-crossing constants
-- compete for eight homes; the one with the FEWEST post-call uses
-- loses its seat regardless of definition order (the old greedy gave
-- homes first-come-first-served by def gpos).

fn residency_weighted_pressure_blocks() -> IrBlockList {
  let mut insts = ir_inst_list_empty()
  let mut i = 0
  while i < 9 {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_const_i64(8 + i, i + 1), ir_inst_list_empty()))
    i = i + 1
  }
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_i64(17, 123, ir_value_list_empty()), ir_inst_list_empty()))
  -- v8 used once; v9..v16 used twice each.
  let mut next = 18
  let mut j = 8
  while j < 16 {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), j, j + 1), ir_inst_list_empty()))
    next = next + 1
    j = j + 1
  }
  insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next, ir_binary_op_add(), 16, 16), ir_inst_list_empty()))
  let mut acc = 18
  let mut k = 19
  while k <= next {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_binary_i64(next + (k - 18), ir_binary_op_add(), acc, k), ir_inst_list_empty()))
    acc = next + (k - 18)
    k = k + 1
  }
  ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(acc)), ir_block_list_empty())
}

test "residency_low_use_value_loses_seat_to_heavier_tenants" {
  let fm = fmap_new()
  let blocks = residency_weighted_pressure_blocks()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  -- v9 (two uses, earliest among the heavy) takes the first home;
  -- v8 (one use, defined FIRST) is displaced and, being a movz-range
  -- const, rematerializes.
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 9), 19)
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 16), 26)
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), pipeline_ir_native_remat_base() + 1)
}

test "residency_barrier_crossing_small_const_rematerializes" {
  let fm = fmap_new()
  let blocks = residency_remat_pressure_blocks()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), 19)
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 16), pipeline_ir_native_remat_base() + 9)
  Test.assert_eq(fmap_ir_native_remat_small_def_count(fm), 1)
}

test "residency_large_const_is_not_rematerialized" {
  let fm = fmap_new()
  let blocks = residency_remat_pressure_blocks()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 17), 0)
  Test.assert_eq(fmap_ir_native_remat_large_def_count(fm), 1)
}

-- 2v Stage 2 dead spill-store deletion: an effectful call whose result
-- is never used keeps the call but loses the result store (discard
-- pseudo-home). Pure dead defs never reach here — IR DCE deletes them.

test "residency_dead_call_result_store_is_discarded" {
  let tail = ir_inst_list_prepend(ir_inst_const_i64(9, 7), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_call_i64(8, 123, ir_value_list_empty()), tail)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), pipeline_ir_native_discard_home())
  Test.assert_eq(fmap_ir_native_dead_store_elision_count(fm), 1)
}

test "residency_used_call_result_is_never_discarded" {
  let tail = ir_inst_list_prepend(ir_inst_binary_i64(9, ir_binary_op_add(), 8, 8), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_call_i64(8, 123, ir_value_list_empty()), tail)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(0, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(if pipeline_ir_native_pinned_slot_lookup(homes, 8) == pipeline_ir_native_discard_home() { 1 } else { 0 }, 0)
  Test.assert_eq(fmap_ir_native_dead_store_elision_count(fm), 0)
}

test "residency_dead_vector_set_result_store_is_discarded" {
  -- Statement-position element writes (v[i] = x) leave a dead status
  -- dst; the set executes, the result store is deleted.
  let tail = ir_inst_list_prepend(ir_inst_const_i64(9, 7), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_vector_set_i64(8, 0, 1, 2, 0), tail)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(3, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(pipeline_ir_native_pinned_slot_lookup(homes, 8), pipeline_ir_native_discard_home())
  Test.assert_eq(fmap_ir_native_dead_store_elision_count(fm), 1)
}

test "residency_dead_vector_lane_result_is_not_discarded" {
  -- Get emitters are outside the dead_store_safe def whitelist; their
  -- dead dsts keep the canonical store (and IR DCE handles the pure
  -- get shape upstream anyway).
  let tail = ir_inst_list_prepend(ir_inst_const_i64(9, 7), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_vector_get_i64(8, 0, 1, 2, 0), tail)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(3, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(if pipeline_ir_native_pinned_slot_lookup(homes, 8) == pipeline_ir_native_discard_home() { 1 } else { 0 }, 0)
  Test.assert_eq(fmap_ir_native_dead_store_elision_count(fm), 0)
}

test "residency_vector_lane_final_use_stays_out_of_call_window" {
  -- Lane emitters stage operands through x12-x17 scratch before their
  -- reads complete, so a vector get/set final use grants no
  -- caller-saved tenancy.
  let get = ir_inst_list_prepend(ir_inst_vector_get_i64(9, 0, 1, 8, 0), ir_inst_list_empty())
  let insts = ir_inst_list_prepend(ir_inst_const_i64(8, 41), get)
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(9)), ir_block_list_empty())
  let fm = fmap_new()
  let homes = pipeline_ir_native_volatile_residents(2, blocks, pipeline_ir_native_pinned_slot_none(), fm, residency_f64_facts(blocks), residency_vector_data_facts(blocks))
  Test.assert_eq(residency_in_caller_saved_pool(homes, 8), 0)
}

fn residency_vector_fact_insts_same_vec() -> IrInstList {
  let tail = ir_inst_list_prepend(ir_inst_vector_set_i64(5, 0, 1, 2, 0), ir_inst_list_empty())
  let preserved = ir_inst_list_prepend(ir_inst_const_i64(4, 7), tail)
  ir_inst_list_prepend(ir_inst_vector_get_i64(3, 0, 1, 2, 0), preserved)
}

fn residency_vector_fact_blocks_same_vec() -> IrBlockList {
  ir_block_list_prepend(ir_block_new_term(0, residency_vector_fact_insts_same_vec(), ir_term_return(5)), ir_block_list_empty())
}

test "residency_vector_cache_facts_mark_reload_then_reuse" {
  let facts = pipeline_ir_native_vector_data_facts_for_blocks(residency_vector_fact_blocks_same_vec())
  let entries = pipeline_ir_native_vector_data_facts_entries(facts)
  Test.assert_eq(pipeline_ir_native_vector_data_facts_home(facts), 0)
  Test.assert_eq(pipeline_ir_native_vector_data_fact_reload_for(entries, 3, 0), 1)
  Test.assert_eq(pipeline_ir_native_vector_data_fact_reload_for(entries, 5, 0), 0)
}

test "residency_vector_cache_emission_consumes_reload_and_reuse_facts" {
  let code = buf_new(4096)
  let fm = fmap_new()
  match residency_vector_fact_blocks_same_vec() {
    IrBlockListNil -> Test.assert_eq(0, 1)
    IrBlockListCons(block, rest) -> {
      pipeline_ir_native_emit_block(block, code, scope_new(), 0, fm)
      Test.assert_eq(fmap_vector_data_hoist_count(fm), 1)
      Test.assert_eq(fmap_vector_data_hoist_use_count(fm), 1)
    }
  }
}

fn residency_vector_fact_blocks_clobbered() -> IrBlockList {
