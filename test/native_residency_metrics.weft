-- test/native_residency_metrics.weft -- typed SSA register residency ledger (2l)
--
-- Measures sp-based memory traffic in the emitted code buffer itself.
-- Stage 0 records current reality; each 2l stage must move these numbers
-- down and flip the structural asserts that encode its deletion condition.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn residency_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn residency_src_answer() -> str {
  "fn main() -> i64 { 42 }"
}

fn residency_src_pressure() -> str {
  "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; a + b + c + d + e + f + g + h + i + j + k + l } fn main() -> i64 { work(1, 2) }"
}

test "residency_sp_pair_traffic_exists_for_trivial_module" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_sp_pair_store_count(native) > 0, true)
  Test.assert_eq(pipeline_native_sp_pair_load_count(native) > 0, true)
}

test "residency_integer_only_module_has_no_fp_pair_traffic" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_sp_fp_pair_store_count(native), 0)
  Test.assert_eq(pipeline_native_sp_fp_pair_load_count(native), 0)
}

test "residency_every_prologue_saves_volatile_x8_x15_bank_uniformly" {
  -- Stage 1 deletion condition: these four words disappear entirely.
  let native = residency_native(residency_src_answer())
  let s89 = pipeline_native_code_word_count(native, encode_stp_pre(8, 9, 31, 0 - 16))
  let s1011 = pipeline_native_code_word_count(native, encode_stp_pre(10, 11, 31, 0 - 16))
  let s1213 = pipeline_native_code_word_count(native, encode_stp_pre(12, 13, 31, 0 - 16))
  let s1415 = pipeline_native_code_word_count(native, encode_stp_pre(14, 15, 31, 0 - 16))
  Test.assert_eq(s89 > 0, true)
  Test.assert_eq(s1011, s89)
  Test.assert_eq(s1213, s89)
  Test.assert_eq(s1415, s89)
  let l89 = pipeline_native_code_word_count(native, encode_ldp_post(8, 9, 31, 16))
  let l1011 = pipeline_native_code_word_count(native, encode_ldp_post(10, 11, 31, 16))
  Test.assert_eq(l89 > 0, true)
  Test.assert_eq(l1011, l89)
}

test "residency_value_bank_pair_saves_present_and_balanced" {
  let native = residency_native(residency_src_answer())
  let s1920 = pipeline_native_code_word_count(native, encode_stp_pre(19, 20, 31, 0 - 16))
  let s2526 = pipeline_native_code_word_count(native, encode_stp_pre(25, 26, 31, 0 - 16))
  Test.assert_eq(s1920 > 0, true)
  Test.assert_eq(s2526, s1920)
}

test "residency_spill_pressure_produces_sp_scalar_traffic" {
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(pipeline_native_sp_load_count(native) > 0, true)
  Test.assert_eq(pipeline_native_sp_store_count(native) > 0, true)
}
