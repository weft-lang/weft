-- test/native_residency_metrics.weft -- typed SSA register residency ledger (2l)
--
-- Measures sp-based memory traffic in the emitted code buffer itself.
-- Stage 0 records current reality; each 2l stage must move these numbers
-- down and flip the structural asserts that encode its deletion condition.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn residency_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn residency_src_answer() -> str {
  "fn main() -> i64 { 42 }"
}

fn residency_src_pressure() -> str {
  "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; a + b + c + d + e + f + g + h + i + j + k + l } fn main() -> i64 { work(1, 2) }"
}

fn residency_positive(count: i64) -> i64 {
  if count > 0 { 1 } else { 0 }
}

test "residency_sp_pair_traffic_exists_for_trivial_module" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(residency_positive(pipeline_native_sp_pair_store_count(native)), 1)
  Test.assert_eq(residency_positive(pipeline_native_sp_pair_load_count(native)), 1)
}

test "residency_integer_only_module_has_no_fp_pair_traffic" {
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_sp_fp_pair_store_count(native), 0)
  Test.assert_eq(pipeline_native_sp_fp_pair_load_count(native), 0)
}

test "residency_no_prologue_saves_volatile_x8_x15_bank" {
  -- 2l stage 1 landed: x8-x15 are volatile scratch and never live across a
  -- call, so no prologue/epilogue may touch the bank anywhere in the module.
  let native = residency_native(residency_src_answer())
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(8, 9, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(10, 11, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(12, 13, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(14, 15, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(8, 9, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(10, 11, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(12, 13, 31, 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(14, 15, 31, 16)), 0)
}

test "residency_pressure_pair_saves_are_value_bank_and_frame_only" {
  -- Every prologue is now at most x19-x26 + fp/lr (5 GPR pairs) plus the
  -- FP bank when f64 slots are resident: pair stores == pair loads shape
  -- is covered by the balance test; here we pin the volatile bank at zero
  -- under spill pressure too.
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(pipeline_native_code_word_count(native, encode_stp_pre(8, 9, 31, 0 - 16)), 0)
  Test.assert_eq(pipeline_native_code_word_count(native, encode_ldp_post(8, 9, 31, 16)), 0)
}

test "residency_value_bank_pair_saves_present_and_balanced" {
  let native = residency_native(residency_src_answer())
  let s1920 = pipeline_native_code_word_count(native, encode_stp_pre(19, 20, 31, 0 - 16))
  let s2526 = pipeline_native_code_word_count(native, encode_stp_pre(25, 26, 31, 0 - 16))
  Test.assert_eq(residency_positive(s1920), 1)
  Test.assert_eq(s2526, s1920)
}

test "residency_spill_pressure_produces_sp_scalar_traffic" {
  let native = residency_native(residency_src_pressure())
  Test.assert_eq(residency_positive(pipeline_native_sp_load_count(native)), 1)
  Test.assert_eq(residency_positive(pipeline_native_sp_store_count(native)), 1)
}
