-- B2.2: signature-side proofs for consuming same-layout specialisations.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/encode.{*}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/buffer.{*}
use runtime/effects.{*}

fn consuming_summary_param(ty: i64) -> i64 {
  node_new(0, 0, 0, ty, 0)
}

test "consuming_summary_separates_effect_contract_from_memory_purity" {
  let params = nlist_new()
  nlist_add(params, consuming_summary_param(ty_str()))
  let closed_pure = cg_semantic_effect_summary_new(1, 0, 0, 0)
  let memory_fact = cg_semantic_fact_new_with_effect_summary(0, closed_pure, params, ty_str(), 0, 8)
  Test.assert_eq(cg_semantic_fact_pure(memory_fact), 0)
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(memory_fact), 1)

  let effectful = cg_semantic_fact_new_with_effect_summary(0, cg_semantic_effect_summary_new(1, 1, 0, 0), params, ty_str(), 0, 0)
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(effectful), 0)

  let open = cg_semantic_fact_new_with_effect_summary(0, cg_semantic_effect_summary_new(0, 0, 0, 0), params, ty_str(), 0, 0)
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(open), 0)

  let raw = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 1, 1, 0)
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(raw), 0)
  Test.assert_eq(cg_semantic_fact_same_managed_return_param_mask(raw), 0)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(raw), 0)
  Test.assert_eq(cg_semantic_fact_return_alias_param_mask(raw), 0)
}

test "consuming_summary_uses_exact_types_and_physical_lanes" {
  let params = nlist_new()
  -- The two-lane slice shifts the exact str parameter to physical lane 2.
  nlist_add(params, consuming_summary_param(ty_slice(ty_i64())))
  nlist_add(params, consuming_summary_param(ty_str()))
  nlist_add(params, consuming_summary_param(ty_i64()))
  let fact = cg_semantic_fact_new_with_effect_summary(0, cg_semantic_effect_summary_new(1, 0, 0, 0), params, ty_str(), 0, 0)
  Test.assert_eq(cg_semantic_fact_param_lane_count(fact), 4)
  Test.assert_eq(cg_semantic_fact_same_managed_return_param_mask(fact), cg_bit(2))

  let scalar_return = cg_semantic_fact_new_with_effect_summary(0, cg_semantic_effect_summary_new(1, 0, 0, 0), params, ty_i64(), 0, 0)
  Test.assert_eq(cg_semantic_fact_same_managed_return_param_mask(scalar_return), 0)
}

test "consuming_summary_fresh_roots_cover_managed_constructors_only" {
  -- Reuse may return its input token; it is represented by IrReuseInitI64
  -- after local provenance proves that token, never as an unconditional root.
  Test.assert_eq(pipeline_ir_fresh_return_allocator_hash(pipeline_ir_native_hash_name("rc_default_alloc_masked_reuse")), 0)
  let mut fresh = pipeline_ir_live_set_dense(16)
  fresh = pipeline_ir_fresh_return_add_inst(IrStringLit(1, 0, 1), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrStringConcatI64(2, 1, 1), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrClosureI64(3, IrFunction(9001, 0, ir_block_list_empty(), 0), 0, ir_lambda_semantic_facts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrVariantInitI64(4, 9002, ir_value_list_empty(), 0), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrRecordInitI64(5, 9003, ir_record_field_list_empty()), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrRecordLayoutInitI64(6, 9004, 8, 8, ir_record_layout_field_list_empty()), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrReuseInitI64(99, IrVariantInitI64(7, 9005, ir_value_list_empty(), 0)), pipeline_ir_semantic_facts_empty(), fresh)
  -- Lowered tail-resume is an exact SSA copy.
  fresh = pipeline_ir_fresh_return_add_inst(IrResumeI64(8, 1), pipeline_ir_semantic_facts_empty(), fresh)
  fresh = pipeline_ir_fresh_return_add_inst(IrConstI64(9, 0), pipeline_ir_semantic_facts_empty(), fresh)
  for value in 1..9 {
    Test.assert_eq(pipeline_ir_live_set_contains(fresh, value), 1)
  }
  Test.assert_eq(pipeline_ir_live_set_contains(fresh, 9), 0)
}

test "consuming_summary_raw_allocator_reuse_lowering_is_exact" {
  let exact_code = buf_new(128)
  let exact_fm = fmap_new()
  fmap_add(exact_fm, __str_ptr("rc_default_alloc_masked_reuse"), 0, __str_len("rc_default_alloc_masked_reuse"), 96)
  pipeline_ir_native_emit_raw_call_reuse_init(
    exact_code,
    0,
    3,
    pipeline_ir_native_hash_name("rc_default_alloc"),
    ir_value_list_prepend(1, ir_value_list_prepend(2, ir_value_list_empty())),
    exact_fm,
    pipeline_ir_native_identity_home_facts(4)
  )
  Test.assert_eq(fmap_emit_error_count(exact_fm), 0)
  Test.assert_eq(fmap_managed_reuse_lowering_count(exact_fm), 1)
  Test.assert_eq(fmap_rc_reuse_lowering_count(exact_fm), 1)

  let wrong_head_code = buf_new(32)
  let wrong_head_fm = fmap_new()
  pipeline_ir_native_emit_raw_call_reuse_init(
    wrong_head_code,
    0,
    3,
    pipeline_ir_native_hash_name("alloc_bump"),
    ir_value_list_prepend(1, ir_value_list_prepend(2, ir_value_list_empty())),
    wrong_head_fm,
    pipeline_ir_native_identity_home_facts(4)
  )
  Test.assert_eq(fmap_emit_error_count(wrong_head_fm), 1)
  Test.assert_eq(pipeline_native_code_word(wrong_head_code, 0), encode_brk(63))

  let wrong_arity_code = buf_new(32)
  let wrong_arity_fm = fmap_new()
  pipeline_ir_native_emit_raw_call_reuse_init(
    wrong_arity_code,
    0,
    3,
    pipeline_ir_native_hash_name("rc_default_alloc"),
    ir_value_list_prepend(1, ir_value_list_empty()),
    wrong_arity_fm,
    pipeline_ir_native_identity_home_facts(4)
  )
  Test.assert_eq(fmap_emit_error_count(wrong_arity_fm), 1)
  Test.assert_eq(pipeline_native_code_word(wrong_arity_code, 0), encode_brk(63))
}

fn consuming_summary_managed_fact() -> i64 {
  cg_semantic_fact_new_raw(0, 1, 0, 1, 1, 0, 1, 0)
}

fn consuming_summary_function(hash: i64, param_count: i64, blocks: IrBlockList) -> IrFunction {
  IrFunction(hash, param_count, blocks, 0)
}

fn consuming_summary_module_function_key(tt: i64, path: str, name: str) -> i64 {
  let module_entry = module_fact_find_path(tt, __str_ptr(path), __str_len(path), 0)
  let decl = if module_entry == 0 { 0 } else {
    module_decl_fact_find(tt, module_fact_entry_source(module_entry), module_decl_namespace_value(), __str_ptr(name), 0, __str_len(name))
  }
  module_decl_fact_native_key_or(decl, str_hash(__str_ptr(name), 0, __str_len(name)))
}

test "consuming_summary_fresh_call_graph_closes_without_name_recognition" {
  let box_hash = 9101
  let wrapper_hash = 9102
  let unknown_hash = 9103
  let box_insts = ir_inst_list_prepend(
    IrCallI64(0, pipeline_ir_native_hash_name("rc_default_alloc"), ir_value_list_empty()),
    ir_inst_list_prepend(IrCallI64(1, pipeline_ir_native_intrinsic_transmute_hash(), ir_value_list_prepend(0, ir_value_list_empty())), ir_inst_list_empty())
  )
  let box_fn = consuming_summary_function(box_hash, 0, ir_block_list_prepend(ir_block_new_term(0, box_insts, IrTermReturn(1)), ir_block_list_empty()))
  let wrapper_insts = ir_inst_list_prepend(IrCallI64(0, box_hash, ir_value_list_empty()), ir_inst_list_empty())
  let wrapper_fn = consuming_summary_function(wrapper_hash, 0, ir_block_list_prepend(ir_block_new_term(0, wrapper_insts, IrTermReturn(0)), ir_block_list_empty()))
  let unknown_insts = ir_inst_list_prepend(IrCallI64(0, 999999, ir_value_list_empty()), ir_inst_list_empty())
  let unknown_fn = consuming_summary_function(unknown_hash, 0, ir_block_list_prepend(ir_block_new_term(0, unknown_insts, IrTermReturn(0)), ir_block_list_empty()))
  let functions = ir_function_list_prepend(wrapper_fn, ir_function_list_prepend(unknown_fn, ir_function_list_prepend(box_fn, ir_function_list_empty())))
  let facts = pipeline_ir_semantic_facts_prepend(
    wrapper_hash,
    consuming_summary_managed_fact(),
    pipeline_ir_semantic_facts_prepend(unknown_hash, consuming_summary_managed_fact(), pipeline_ir_semantic_facts_prepend(box_hash, consuming_summary_managed_fact(), pipeline_ir_semantic_facts_empty()))
  )
  pipeline_ir_fresh_return_enrich(functions, facts)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, box_hash)), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, wrapper_hash)), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, unknown_hash)), 0)
}

fn consuming_summary_join_function(hash: i64, bad_else: i64) -> IrFunction {
  let entry = ir_block_new_term(0, ir_inst_list_empty(), IrTermBranch(0, 1, 2))
  let then_block = ir_block_new_term(1, ir_inst_list_prepend(IrStringLit(1, 0, 1), ir_inst_list_empty()), IrTermJump(3, ir_value_list_prepend(1, ir_value_list_empty())))
  let else_insts = if bad_else == 1 { ir_inst_list_empty() } else { ir_inst_list_prepend(IrStringLit(2, 0, 1), ir_inst_list_empty()) }
  let else_value = if bad_else == 1 { 0 } else { 2 }
  let else_block = ir_block_new_term(2, else_insts, IrTermJump(3, ir_value_list_prepend(else_value, ir_value_list_empty())))
  let join = ir_block_new_params(3, ir_value_list_prepend(3, ir_value_list_empty()), ir_inst_list_empty(), IrTermReturn(3))
  consuming_summary_function(hash, 1, ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_prepend(join, ir_block_list_empty())))))
}

test "consuming_summary_requires_every_reachable_join_input_fresh" {
  let good_hash = 9201
  let bad_hash = 9202
  let good = consuming_summary_join_function(good_hash, 0)
  let bad = consuming_summary_join_function(bad_hash, 1)
  let facts = pipeline_ir_semantic_facts_prepend(good_hash, consuming_summary_managed_fact(), pipeline_ir_semantic_facts_prepend(bad_hash, consuming_summary_managed_fact(), pipeline_ir_semantic_facts_empty()))
  let functions = ir_function_list_prepend(good, ir_function_list_prepend(bad, ir_function_list_empty()))
  pipeline_ir_fresh_return_enrich(functions, facts)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, good_hash)), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, bad_hash)), 0)
}

test "consuming_summary_survives_concrete_generic_specialisation" {
  let src = "fn echo<T>(value: T) -> T { value } fn factory() -> str { echo<str>(\"x\") } fn main() -> i64 { let text = factory() let number = echo<i64>(1) number }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let facts = pipeline_ir_semantic_facts(optimised)
  let base_hash = str_hash(__str_ptr("echo"), 0, 4)
  let str_args = nlist_new()
  nlist_add(str_args, ty_str())
  let i64_args = nlist_new()
  nlist_add(i64_args, ty_i64())
  let str_fact = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(base_hash, str_args))
  let i64_fact = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(base_hash, i64_args))
  Test.assert_eq(if str_fact != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if i64_fact != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(str_fact), 1)
  Test.assert_eq(cg_semantic_fact_same_managed_return_param_mask(str_fact), 1)
  Test.assert_eq(cg_semantic_fact_same_managed_return_param_mask(i64_fact), 0)
  Test.assert_eq(cg_semantic_fact_return_alias_param_mask(str_fact), 1)
  Test.assert_eq(cg_semantic_fact_return_alias_param_mask(i64_fact), 1)
  -- An identity aliases its input, so it is not itself a fresh factory. A
  -- caller that feeds it a local allocation retains that exact provenance.
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(str_fact), 0)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, str_hash(__str_ptr("factory"), 0, 7))), 1)
}

test "consuming_summary_reaches_real_map_and_vector_factories" {
  let src = "use stdlib/map.{*} use stdlib/vector.{*} fn main() -> i64 { let m = map_put<i64, i64>(map_new<i64, i64>(), 1, 2) let v = persistent_vector_push<i64>(persistent_vector_new<i64>(), 3) map_get_or<i64, i64>(m, 1, 0) + persistent_vector_get<i64>(v, 0, 0) }"
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let facts = pipeline_ir_semantic_facts(optimised)
  let tt = match typed { TypedModule(fns, typed_src, typed_tt) -> typed_tt }
  let map_args = nlist_new()
  nlist_add(map_args, ty_i64())
  nlist_add(map_args, ty_i64())
  let vector_args = nlist_new()
  nlist_add(vector_args, ty_i64())
  let map_box = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "stdlib/map.weft", "map_storage_persistent_box"), map_args))
  let map_put_fact = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "stdlib/map.weft", "map_put"), map_args))
  let vector_box = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "stdlib/vector.weft", "persistent_vector_box"), vector_args))
  let vector_push = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "stdlib/vector.weft", "persistent_vector_push"), vector_args))
  let runtime_map_box = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "runtime/map_storage.weft", "map_storage_persistent_box"), map_args))
  let runtime_vector_box = pipeline_ir_semantic_fact_find(facts, mono_spec_hash(consuming_summary_module_function_key(tt, "runtime/vector_storage.weft", "persistent_vector_storage_box"), vector_args))
  let map_handle_hash = mono_spec_hash(consuming_summary_module_function_key(tt, "runtime/map_storage.weft", "map_storage_handle_from_owned_word"), map_args)
  let vector_handle_hash = mono_spec_hash(consuming_summary_module_function_key(tt, "runtime/vector_storage.weft", "persistent_vector_storage_handle_from_owned_word"), vector_args)
  Test.assert_eq(if map_box != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if map_put_fact != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_box != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_push != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if runtime_map_box != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if runtime_vector_box != 0 { 1 } else { 0 }, 1)
  let alloc_hash = consuming_summary_module_function_key(tt, "runtime/rc.weft", "rc_default_alloc")
  Test.assert_eq(alloc_hash, pipeline_ir_native_hash_name("rc_default_alloc"))
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(pipeline_ir_semantic_fact_find(facts, alloc_hash)), 1)
  Test.assert_eq(cg_semantic_fact_return_alias_param_mask(pipeline_ir_semantic_fact_find(facts, map_handle_hash)), 1)
  Test.assert_eq(cg_semantic_fact_return_alias_param_mask(pipeline_ir_semantic_fact_find(facts, vector_handle_hash)), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(runtime_map_box), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(runtime_vector_box), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(map_box), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(map_put_fact), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(vector_box), 1)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(vector_push), 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_facts_valid(optimised), 1)
}
