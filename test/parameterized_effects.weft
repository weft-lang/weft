-- 4c: parameterized effects (kernel §7.1, law L2). Distinct
-- instantiations are distinct atoms; op signatures instantiate from the
-- atom's args at perform sites, handler clauses, and generic calls.

effect Box<T> {
  fn get() -> T
  fn put(v: T) -> nil
}

effect Pair<A, B> {
  fn first() -> A
  fn second() -> B
}

effect L2State<S> {
  fn get() -> S
  fn put(value: S) -> nil
}

effect L2Trace {
  fn hit() -> nil
}

-- Kernel §7.1/L2 acceptance shape: discharge one parameterized atom while
-- preserving and inferring the callback's open remainder.
fn l2_with_state<S, T, E>(initial: S, f: () -[L2State<S>, E]> T) -[E]> T {
  handle f() {
    L2State.get() -> resume(initial)
    L2State.put(next) -> resume(nil)
  }
}

fn l2_i64_body() -[L2State<i64>, L2Trace]> i64 {
  L2Trace.hit()
  L2State.put(0)
  L2State.get() + 1
}

fn l2_str_body() -[L2State<str>, L2Trace]> str {
  L2Trace.hit()
  L2State.get()
}

fn l2_i64_open() -[L2Trace]> i64 {
  l2_with_state(41, l2_i64_body)
}

fn l2_str_open() -[L2Trace]> str {
  l2_with_state("weft", l2_str_body)
}

fn use_box_str() -[Box<str>]> i64 {
  Box.put("hello")
  __str_len(Box.get())
}

fn use_box_i64() -[Box<i64>]> i64 {
  Box.put(40)
  Box.get() + 2
}

fn use_box_str_qualified() -[Box<str>]> i64 {
  Box<str>.put("qualified")
  __str_len(Box<str>.get())
}

fn helper_qualified<T>() -[Box<T>]> T {
  Box<T>.get()
}

fn helper<T>() -[Box<T>]> T {
  Box.get()
}

fn use_helper_str() -[Box<str>]> str {
  helper<str>()
}

fn use_pair() -[Pair<i64, str>]> i64 {
  Pair.first() + __str_len(Pair.second())
}

fn nested_inner() -[Box<i64>]> i64 {
  Box.get() + 1
}

fn nested_outer() -[Box<str>]> i64 {
  let inner = handle nested_inner() {
    Box.get() -> resume(10)
  }
  inner + __str_len(Box.get())
}

test "param_eff_str_instantiation" {
  let got = handle use_box_str() {
    Box.get() -> resume("world")
    Box.put(v) -> resume(nil)
  }
  Test.assert_eq(got, 5)
}

test "param_eff_i64_instantiation" {
  let got = handle use_box_i64() {
    Box.get() -> resume(40)
    Box.put(v) -> resume(nil)
  }
  Test.assert_eq(got, 42)
}

test "param_eff_qualified_perform_and_clause" {
  let got = handle use_box_str_qualified() {
    Box<str>.get() -> resume("atom")
    Box<str>.put(v) -> resume(nil)
  }
  Test.assert_eq(got, 4)
}

test "param_eff_qualified_generic_atom_substitutes" {
  let got = handle helper_qualified<str>() {
    Box<str>.get() -> resume("typed")
  }
  Test.assert_str_eq(got, "typed")
}

test "param_eff_clause_binds_instantiated_payload" {
  let got = handle use_box_str() {
    Box.get() -> resume("xy")
    Box.put(v) -> resume(nil)
  }
  Test.assert_eq(got, 2)
}

test "param_eff_generic_helper_instantiates" {
  let got = handle use_helper_str() {
    Box.get() -> resume("abcd")
  }
  Test.assert_eq(__str_len(got), 4)
}

test "param_eff_two_params" {
  let got = handle use_pair() {
    Pair.first() -> resume(30)
    Pair.second() -> resume("hello worldo")
  }
  Test.assert_eq(got, 42)
}

test "param_eff_nested_distinct_instantiations" {
  let got = handle nested_outer() {
    Box.get() -> resume("abc")
  }
  Test.assert_eq(got, 14)
}

test "param_eff_identical_repeat_is_set_notation" {
  let got = handle use_box_i64() {
    Box.get() -> resume(0)
    Box.put(v) -> resume(nil)
  }
  Test.assert_eq(got, 2)
}

test "param_eff_l2_open_tail_discharges_i64_instantiation" {
  let got = handle l2_i64_open() {
    L2Trace.hit() -> resume(nil)
  }
  Test.assert_eq(got, 42)
}

test "param_eff_l2_open_tail_discharges_str_instantiation" {
  let got = handle l2_str_open() {
    L2Trace.hit() -> resume(nil)
  }
  Test.assert_str_eq(got, "weft")
}
