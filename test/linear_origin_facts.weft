use compiler/ir/data.{*}
use compiler/weft/facts/linear_flow.{*}
use compiler/pipeline.{pipeline_ir_verify_function}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{Option}

fn origin_test_insts(insts: IrInstList, env: Map<i64, i64>) -> Map<i64, i64> {
  match insts {
    IrInstNil -> env
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrConstI64(dst, value) -> env.insert(dst, value)
        IrBinaryI64(dst, op, lhs, rhs) -> {
          let left = env.get(lhs).unwrap()
          let right = env.get(rhs).unwrap()
          let result = match op {
            IrSub -> left - right
            IrGt -> if left > right { 1 } else { 0 }
            IrOr -> if left != 0 or right != 0 { 1 } else { 0 }
            _ -> 0 - 999
          }
          env.insert(dst, result)
        }
        _ -> env
      }
      origin_test_insts(rest, next)
    }
  }
}

fn origin_test_bind(params: IrValueList, args: IrValueList, previous: Map<i64, i64>, next: Map<i64, i64>) -> Map<i64, i64> {
  match (params, args) {
    (IrValueCons(param, rest_params), IrValueCons(arg, rest_args)) -> origin_test_bind(rest_params, rest_args, previous, next.insert(param, previous.get(arg).unwrap()))
    _ -> next
  }
}

fn origin_test_run(current: IrBlockList, all: IrBlockList, target: i64, args: IrValueList, env: Map<i64, i64>, remaining: i64) -> i64 {
  if remaining == 0 { 0 - 998 }
  else { match current {
    IrBlockListNil -> 0 - 997
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      if id != target { origin_test_run(rest, all, target, args, env, remaining) }
      else {
        let bound = origin_test_bind(params, args, env, env)
        let values = origin_test_insts(insts, bound)
        match term {
          IrTermReturn(value) -> values.get(value).unwrap()
          IrTermJump(dest, next_args) -> origin_test_run(all, all, dest, next_args, values, remaining - 1)
          IrTermBranch(cond, yes, no) -> origin_test_run(all, all, if values.get(cond).unwrap() != 0 { yes } else { no }, IrValueNil, values, remaining - 1)
          _ -> 0 - 996
        }
      }
    }
  } }
}

fn origin_test_return_flag(blocks: IrBlockList, flag: i64, zero: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> blocks
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      let prefix = if id == 0 { IrInstCons(ir_inst_const_i64(zero, 0), IrInstCons(ir_inst_const_i64(zero + 1, 1), IrInstNil)) } else { IrInstNil }
      let next_term = match term { IrTermReturn(_) -> IrTermReturn(flag), _ -> term }
      IrBlockListCons(IrBlock(id, params, ir_inst_list_append(prefix, insts), next_term), origin_test_return_flag(rest, flag, zero))
    }
  }
}

fn origin_test_materialise(blocks: IrBlockList, value: i64, zero: i64, params: i64) -[Test]> IrBlockList {
  let facts = ir_linear_origin_request(blocks, 0, value, zero, ir_linear_origin_build(zero))
  let result = origin_test_return_flag(ir_linear_origin_materialise(blocks, facts, zero), facts.value, zero)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, params, result, 0)), 0)
  result
}

fn origin_test_choice(wrap: bool) -> IrBlockList {
  let constructed = if wrap { IrInstCons(IrVariantInitI64(4, 1, IrValueCons(3, IrValueNil), 0), IrInstNil) } else { IrInstNil }
  IrBlockListCons(ir_block_new_term(0, IrInstNil, IrTermBranch(2, 1, 2)),
    IrBlockListCons(ir_block_new_term(1, IrInstNil, IrTermJump(3, IrValueCons(0, IrValueNil))),
      IrBlockListCons(ir_block_new_term(2, IrInstNil, IrTermJump(3, IrValueCons(1, IrValueNil))),
        IrBlockListCons(IrBlock(3, IrValueCons(3, IrValueNil), constructed, IrTermReturn(if wrap { 4 } else { 3 })), IrBlockListNil))))
}

test "origin predicates distinguish both paths through a join and a constructor" {
  for wrap in [false, true] {
    let blocks = origin_test_choice(wrap)
    let materialised = origin_test_materialise(blocks, if wrap { 4 } else { 3 }, 5, 3)
    for choose in [0, 1] {
      let env = map.new<i64, i64>().insert(0, 100).insert(1, 200).insert(2, choose)
      Test.assert_eq(origin_test_run(materialised, materialised, 0, IrValueNil, env, 20), choose)
    }
  }
}

fn origin_test_loop(replace: bool) -> IrBlockList {
  let condition = IrInstCons(ir_inst_const_i64(6, 0), IrInstCons(ir_inst_binary_i64(7, IrGt, 5, 6), IrInstNil))
  let step = IrInstCons(ir_inst_const_i64(8, 1), IrInstCons(ir_inst_binary_i64(9, IrSub, 5, 8), IrInstNil))
  IrBlockListCons(ir_block_new_term(0, IrInstNil, IrTermJump(1, IrValueCons(0, IrValueCons(3, IrValueNil)))),
    IrBlockListCons(IrBlock(1, IrValueCons(4, IrValueCons(5, IrValueNil)), condition, IrTermBranch(7, 2, 3)),
      IrBlockListCons(ir_block_new_term(2, step, IrTermJump(1, IrValueCons(if replace { 1 } else { 4 }, IrValueCons(9, IrValueNil)))),
        IrBlockListCons(ir_block_new_term(3, IrInstNil, IrTermReturn(4)), IrBlockListNil))))
}

test "origin predicates follow loop-carried identity and replacement" {
  for replace in [false, true] {
    let blocks = origin_test_materialise(origin_test_loop(replace), 4, 10, 4)
    for count in [0, 1, 2, 8] {
      let env = map.new<i64, i64>().insert(0, 100).insert(1, 200).insert(2, 0).insert(3, count)
      Test.assert_eq(origin_test_run(blocks, blocks, 0, IrValueNil, env, 50), if replace and count > 0 { 0 } else { 1 })
    }
  }
}

test "copied fields do not carry their container's ownership" {
  let blocks = IrBlockListCons(ir_block_new_term(0, IrInstCons(IrFieldLoadI64(1, 0, 1, 1), IrInstNil), IrTermReturn(1)), IrBlockListNil)
  Test.assert_false(ir_linear_origin_may_transfer(blocks, 1, 0, IrValueNil))
  let facts = ir_linear_origin_request(blocks, 0, 1, 2, ir_linear_origin_build(2))
  Test.assert_eq(facts.value, 2)
}
