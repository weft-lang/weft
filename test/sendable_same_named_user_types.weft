-- Mutable containers and runtime tokens are rejected by exact declaration
-- identity, so user types that reuse their short names are ordinary data
-- whose fields decide the Sendable fact.

type Iterator { position: i64 }

type Generator { remaining: i64 }

type ParTask { slot: i64 }

type Vector { length: i64 }

fn send_back<T: Sendable>(value: T) -> T { value }

test "same-named immutable user types are Sendable by their fields" {
  let cursor = send_back<Iterator>(Iterator { position: 4 })
  let source = send_back<Generator>(Generator { remaining: 5 })
  let task = send_back<ParTask>(ParTask { slot: 6 })
  let size = send_back<Vector>(Vector { length: 3 })
  Test.assert_eq(cursor.position + source.remaining + task.slot + size.length, 18)
}
