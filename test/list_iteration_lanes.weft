-- `for` over a list reads each cell as a `Cons(head, tail)` pattern would:
-- an element of several value lanes occupies that many payload words, and
-- the tail follows them.

use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/test.{Test}

type Pair = opaque(i64, usize)

type Triple = opaque(i64, i64, i64)

fn pairs() -> List<Pair> {
  Nil<Pair>().prepend(Pair((5, 6))).prepend(Pair((3, 4))).prepend(Pair((1, 2)))
}

fn triples() -> List<Triple> {
  Nil<Triple>().prepend(Triple((7, 8, 9))).prepend(Triple((1, 2, 3)))
}

fn first_above(values: List<Pair>, limit: i64) -> Option<usize> {
  for pair in values {
    match pair {
      Pair((key, value)) -> if key > limit { return Some(value) } else { nil }
    }
  }
  None<usize>()
}

test "for reads every lane of a two-word element and follows its tail" {
  let mut keys = 0
  let mut values: usize = 0
  for pair in pairs() {
    match pair {
      Pair((key, value)) -> {
        keys = keys + key
        values = values + value
      }
    }
  }
  Test.assert_eq(keys, 9)
  Test.assert_eq_usize(values, 12)
}

test "for reads three-word elements in order" {
  let mut digits = 0
  for triple in triples() {
    match triple {
      Triple((first, second, third)) -> {
        digits = digits * 1000 + first * 100 + second * 10 + third
      }
    }
  }
  Test.assert_eq(digits, 123789)
}

test "for over multi-word elements returns, breaks and continues exactly" {
  Test.assert_true(
    match first_above(pairs(), 2) {
      Some(value) -> value == 4
      None -> false
    }
  )
  Test.assert_true(
    match first_above(pairs(), 9) {
      Some(_) -> false
      None -> true
    }
  )
  let mut seen = 0
  for pair in pairs() {
    match pair {
      Pair((key, _)) -> {
        if key == 1 { continue }
        seen = seen * 10 + key
        if key == 3 { break }
      }
    }
  }
  Test.assert_eq(seen, 3)
}

test "nested and empty iterations over multi-word elements" {
  let mut products = 0
  for outer in pairs() {
    for inner in triples() {
      match (outer, inner) {
        (Pair((key, _)), Triple((first, _, _))) -> { products = products + key * first }
      }
    }
  }
  Test.assert_eq(products, 72)
  let mut count = 0
  for pair in Nil<Pair>() {
    match pair { Pair((key, _)) -> { count = count + key } }
  }
  Test.assert_eq(count, 0)
}
