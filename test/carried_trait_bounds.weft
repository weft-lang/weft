-- A type parameter that carries a bound satisfies it wherever conformance is
-- decided, including the bounds of an implementation selected for a type
-- built from that parameter: Box<T> implements Deep when T: Deep is in scope.

trait Deep {
  fn deep(self, n: i64) -> i64
}

type Box<T> { value: T }

impl Deep for i64 {
  fn deep(self, n: i64) -> i64 { self + n }
}

impl<T: Deep> Deep for Box<T> {
  fn deep(self, n: i64) -> i64 { self.value.deep(n + 1) }
}

fn measure<U: Deep>(value: U) -> i64 { value.deep(0) }

fn boxed<T: Deep>(value: T) -> i64 { measure(Box<T> { value: value }) }

fn boxed_explicit<T: Deep>(value: T) -> i64 { measure<Box<T>>(Box<T> { value: value }) }

fn double_boxed<T: Deep>(value: T) -> i64 {
  measure(Box<Box<T>> { value: Box<T> { value: value } })
}

test "a bounded implementation applies to a parameter carrying the bound" {
  Test.assert_eq(boxed<i64>(5), 6)
  Test.assert_eq(boxed_explicit<i64>(5), 6)
}

test "nested bounded implementations apply through the carried bound" {
  Test.assert_eq(double_boxed<i64>(5), 7)
  Test.assert_eq(boxed<Box<i64>>(Box<i64> { value: 1 }), 3)
}
