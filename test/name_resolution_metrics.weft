use test/fixtures/name_resolution_shadow_support.{*}

-- The module-wide name indexes preserve the pre-index resolution contract:
-- a declaration in the caller's source shadows an imported declaration with
-- the same name/hash. Keep both plain and generic lookup paths locked.
fn name_resolution_shadowed_value() -> i64 { 21 }

fn name_resolution_shadowed_generic<T>(value: T) -> i64 { 22 }

test "name_resolution_local_function_shadows_imported_hash_peer" {
  Test.assert_eq(name_resolution_shadowed_value(), 21)
}

test "name_resolution_local_generic_shadows_imported_hash_peer" {
  Test.assert_eq(name_resolution_shadowed_generic<i64>(0), 22)
}
