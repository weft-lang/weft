use compiler/ir.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/types.{*}
use stdlib/test.{Test}

test "floating literal bridges retain resolved width and the original source span" {
  for ty in [0, ty_f32(), ty_f64()] {
    let literal = node_new(54, 17, 4, ty, 0)
    let typed = expr_from_node(literal)
    let roundtrip = expr_to_node(typed)
    Test.assert_eq(node_tag(roundtrip), 54)
    Test.assert_eq(node_f1(roundtrip), 17)
    Test.assert_eq(node_f2(roundtrip), 4)
    Test.assert_true(if ty == 0 { node_f3(roundtrip) == 0 } else { ty_eq(node_f3(roundtrip), ty) })
    let expected = if ty == 0 { PRIM_F64() } else { ty_f1(ty) }
    Test.assert_eq(pipeline_expr_float_prim_typed(typed, 0, pipeline_value_env_empty(), 0, 0, 0, 0), expected)
    Test.assert_eq(pipeline_expr_float_prim_node(roundtrip, 0, pipeline_value_env_empty(), 0, 0, 0), expected)
    Test.assert_true(ty_eq(pipeline_expr_type_node_typed(typed), if ty == 0 { ty_f64() } else { ty }))
  }
}

test "checking publishes result literal width independently of a local binding type" {
  let source = "fn narrow() -> f32 { let ordinary = 16777217.0; 1.25 }"
  match pipeline_check_source_standalone(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, _, _) -> {
      let pair = pipeline_fns_lookup_pair_by_hash(fns, pipeline_ir_native_hash_name("narrow"))
      Test.assert_true(pair != 0)
      let body = node_f4(pipeline_fn_inner(node_f1(pair)))
      Test.assert_true(match expr_from_node(body) {
        Let(_, _, FloatLit(_, _, MissingTypeExpr), FloatLit(_, _, result_ty)) -> type_expr_prim_id_or(result_ty, 0 - 1) == PRIM_F32()
        _ -> false
      })
    }
  }
}
