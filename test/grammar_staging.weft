-- Build-time staging of a grammar's checked plan: the conformance over the
-- module-fixture grammar, the budgeted sink in both interpretations, the
-- compiler-side verification of a sink directory, two-session byte identity
-- of the persisted plan, and the process sink end to end through a child
-- driver under the process session API.

use module_fixtures/toy_grammar.{AssignmentGrammar, AssignmentSyntax, LeakyAssignmentGrammar}
use compiler/backend/target.{native_link_target_host, native_link_target_name}
use compiler/pipeline.{
  PipelineNativeDebugInformationStripped,
  PipelineNativeProductFailed,
  PipelineNativeProductReady,
  pipeline_binary_buf,
  pipeline_check_source_with_diagnostics,
  pipeline_checked_native_product,
  pipeline_lower_native_ir_for_target_closed
}
use runtime/alloc.{alloc_zeroed}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/dir_inspect as dir_inspect_handler
use runtime/dir_mutate as dir_mutate_handler
use runtime/file_read as file_read_handler
use runtime/file_write as file_write_handler
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/process as process_handler
use runtime/source_acquire.{SourceAcquire, source_acquire_with_checkout}
use runtime/string.{runtime_str_cstring}
use runtime/syscall.{
  sys_close,
  sys_dir_mkdir,
  sys_dir_remove_directory,
  sys_open_write_create_truncate,
  sys_remove,
  sys_write
}
use runtime/time as platform_time
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/diagnostic/schema.{*}
use stdlib/dir.{DirInspect, DirMutate}
