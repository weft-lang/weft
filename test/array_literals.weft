-- Array literals allocate one managed backing, initialise left-to-right, and
-- use the resolved element layout rather than widening every slot to i64.

use "runtime/rc_implicit_test.weft"

effect ArrayLiteralRead {
  fn get(value: i64) -> i64
}

fn array_literal_storage_i64_3(values: [i64; 3]) -> i64 {
  runtime_generator_state_word_from<[i64; 3]>(values)
}

fn array_literal_storage_i64_2(values: [i64; 2]) -> i64 {
  runtime_generator_state_word_from<[i64; 2]>(values)
}

fn array_literal_storage_u8_3(values: [u8; 3]) -> i64 {
  runtime_generator_state_word_from<[u8; 3]>(values)
}

fn array_literal_storage_f32_2(values: [f32; 2]) -> i64 {
  runtime_generator_state_word_from<[f32; 2]>(values)
}

fn array_literal_storage_scalar_union(values: [i64 | bool; 2]) -> i64 {
  runtime_generator_state_word_from<[i64 | bool; 2]>(values)
}

fn array_literal_storage_nested_i64(values: [[i64; 2]; 2]) -> i64 {
  runtime_generator_state_word_from<[[i64; 2]; 2]>(values)
}

fn array_literal_pair<T>(value: T) -> [T; 2] {
  [value, value]
}

fn array_literal_cfg_values(flag: bool) -> i64 {
  let mut order = 0
  let values: [i64; 3] = [
    if flag { order = order * 10 + 1; 11 } else { order = 99; 0 },
    if flag { order = order * 10 + 2; 22 } else { order = 99; 0 },
    if flag { order = order * 10 + 3; 33 } else { order = 99; 0 },
  ]
  let data = rc_array_storage_data(array_literal_storage_i64_3(values))
  order * 1000000 + runtime_rc_test_load64(data) * 10000 + runtime_rc_test_load64(data + 8) * 100 + runtime_rc_test_load64(data + 16)
}

fn array_literal_managed_borrowed_counts(probe: RuntimeRcProbe) -> i64 {
  let values: [RuntimeRcProbe; 2] = [probe, probe]
  let storage = runtime_generator_state_word_from<[RuntimeRcProbe; 2]>(values)
  let data = rc_array_storage_data(storage)
  runtime_rc_probe_count(probe) * 100 + rc_count(runtime_rc_test_load64(data)) * 10 + rc_count(runtime_rc_test_load64(data + 8))
}

fn array_literal_managed_owned_counts() -> i64 {
  let values: [RuntimeRcProbe; 2] = [runtime_rc_probe_new(4), runtime_rc_probe_new(5)]
  let storage = runtime_generator_state_word_from<[RuntimeRcProbe; 2]>(values)
  let data = rc_array_storage_data(storage)
  rc_count(runtime_rc_test_load64(data)) * 10 + rc_count(runtime_rc_test_load64(data + 8))
}

fn array_literal_nested_managed_counts(probe: RuntimeRcProbe) -> i64 {
  let values: [[RuntimeRcProbe; 1]; 2] = [[probe], [probe]]
  let storage = runtime_generator_state_word_from<[[RuntimeRcProbe; 1]; 2]>(values)
  let data = rc_array_storage_data(storage)
  runtime_rc_probe_count(probe) * 100 + rc_count(runtime_rc_test_load64(data)) * 10 + rc_count(runtime_rc_test_load64(data + 8))
}

fn array_literal_generic_managed_counts(probe: RuntimeRcProbe) -> i64 {
  let values = array_literal_pair<RuntimeRcProbe>(probe)
  let storage = runtime_generator_state_word_from<[RuntimeRcProbe; 2]>(values)
  let data = rc_array_storage_data(storage)
  runtime_rc_probe_count(probe) * 100 + rc_count(runtime_rc_test_load64(data)) * 10 + rc_count(runtime_rc_test_load64(data + 8))
}

fn array_literal_make_capturing_reader(base: i64) -> () -> [i64; 2] {
  () => [base, base + 1]
}

fn array_literal_increment(value: i64) -> i64 {
  value + 1
}

fn array_literal_effect_values() -[ArrayLiteralRead]> [i64; 2] {
  [ArrayLiteralRead.get(20), ArrayLiteralRead.get(21) + 1]
}

test "array_literal_straight_i64_values" {
  let values: [i64; 3] = [11, 22, 33]
  let data = rc_array_storage_data(array_literal_storage_i64_3(values))
  Test.assert_eq(runtime_rc_test_load64(data), 11)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 22)
  Test.assert_eq(runtime_rc_test_load64(data + 16), 33)
}

test "array_literal_contextual_u8_uses_exact_width" {
  let values: [u8; 3] = [1, 2, 255]
  let data = rc_array_storage_data(array_literal_storage_u8_3(values))
  Test.assert_eq(runtime_rc_test_load8(data), 1)
  Test.assert_eq(runtime_rc_test_load8(data + 1), 2)
  Test.assert_eq(runtime_rc_test_load8(data + 2), 255)
}

test "array_literal_contextual_f32_flows_through_control_results" {
  let values: [f32; 2] = [
    if true { 1.5 } else { 9.0 },
    match true { true -> 2.5 false -> 9.0 },
  ]
  let data = rc_array_storage_data(array_literal_storage_f32_2(values))
  Test.assert_eq(runtime_rc_test_load64(data), 4620693218751676416)
}

test "array_literal_context_free_union_uses_canonical_word_storage" {
  let values = [42, true]
  let data = rc_array_storage_data(array_literal_storage_scalar_union(values))
  Test.assert_eq(runtime_rc_test_load64(data), 42)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 1)
}

test "array_literal_cfg_elements_evaluate_left_to_right" {
  Test.assert_eq(array_literal_cfg_values(true), 123112233)
}

test "array_literal_nested_values_copy_inline_backing" {
  let values: [[i64; 2]; 2] = [[1, 2], [3, 4]]
  let data = rc_array_storage_data(array_literal_storage_nested_i64(values))
  Test.assert_eq(runtime_rc_test_load64(data), 1)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 2)
  Test.assert_eq(runtime_rc_test_load64(data + 16), 3)
  Test.assert_eq(runtime_rc_test_load64(data + 24), 4)
}

test "array_literal_empty_has_live_zero_byte_owner" {
  let values: [i64; 0] = []
  let storage = runtime_generator_state_word_from<[i64; 0]>(values)
  Test.assert_eq(if storage != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_array_storage_data(storage), 0)
  Test.assert_eq(rc_count(storage), 1)
}

test "array_literal_generic_body_substitutes_layout" {
  let values = array_literal_pair<i64>(17)
  let storage = runtime_generator_state_word_from<[i64; 2]>(values)
  let data = rc_array_storage_data(storage)
  Test.assert_eq(runtime_rc_test_load64(data), 17)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 17)
}

test "array_literal_generic_managed_layout_balances_stakes" {
  let probe = runtime_rc_probe_new(18)
  Test.assert_eq(array_literal_generic_managed_counts(probe), 333)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "array_literal_borrowed_managed_elements_balance_stakes" {
  let probe = runtime_rc_probe_new(9)
  Test.assert_eq(array_literal_managed_borrowed_counts(probe), 333)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "array_literal_owned_managed_elements_transfer_stakes" {
  Test.assert_eq(array_literal_managed_owned_counts(), 11)
}

test "array_literal_nested_managed_copy_balances_sources" {
  let probe = runtime_rc_probe_new(12)
  Test.assert_eq(array_literal_nested_managed_counts(probe), 333)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "array_literal_inside_closure_captures_element_names" {
  let reader = array_literal_make_capturing_reader(40)
  let values = reader()
  let data = rc_array_storage_data(array_literal_storage_i64_2(values))
  Test.assert_eq(runtime_rc_test_load64(data), 40)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 41)
}

test "array_literal_function_value_element_keeps_closure_runtime" {
  let values: [(i64) -> i64; 1] = [array_literal_increment]
  let storage = runtime_generator_state_word_from<[(i64) -> i64; 1]>(values)
  Test.assert_eq(if runtime_rc_test_load64(rc_array_storage_data(storage)) != 0 { 1 } else { 0 }, 1)
}

test "array_literal_effect_elements_preserve_order_and_transport" {
  let values = handle array_literal_effect_values() {
    ArrayLiteralRead.get(value) -> resume(value)
  }
  let data = rc_array_storage_data(runtime_generator_state_word_from<[i64; 2]>(values))
  Test.assert_eq(runtime_rc_test_load64(data), 20)
  Test.assert_eq(runtime_rc_test_load64(data + 8), 22)
}
