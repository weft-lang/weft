use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/weft/check/body.{*}
use compiler/types/algebra.{*}
use compiler/storage.{*}

fn routing_block_replace(blocks: IrBlockList, replacement: IrBlock) -> IrBlockList {
  let wanted = match replacement { IrBlock(id, _, _, _) -> id }
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> {
      if id == wanted { IrBlockListCons(replacement, rest) }
      else { IrBlockListCons(IrBlock(id, params, insts, term), routing_block_replace(rest, replacement)) }
    }
  }
}

fn routing_blocks(first: i64, second: i64, dispatch: IrInstList, condition: i64) -> IrBlockList {
  let yes_args = IrValueCons(10, IrValueCons(11, IrValueCons(12, IrValueNil)))
  let no_args = IrValueCons(20, IrValueCons(21, IrValueCons(22, IrValueNil)))
  let params = IrValueCons(30, IrValueCons(31, IrValueCons(32, IrValueNil)))
  IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(0, 10, 20)),
    IrBlockListCons(IrBlock(10, IrValueNil,
      IrInstCons(IrConstI64(10, first), IrInstCons(IrConstI64(11, 101), IrInstCons(IrConstI64(12, 0), IrInstNil))),
      IrTermJump(40, yes_args)),
    IrBlockListCons(IrBlock(20, IrValueNil,
      IrInstCons(IrConstI64(20, second), IrInstCons(IrConstI64(21, 0), IrInstCons(IrConstI64(22, 202), IrInstNil))),
      IrTermJump(40, no_args)),
    IrBlockListCons(IrBlock(40, params, dispatch, IrTermBranch(condition, 60, 70)),
    IrBlockListCons(IrBlock(60, IrValueNil, IrInstNil, IrTermReturn(31)),
    IrBlockListCons(IrBlock(70, IrValueNil, IrInstNil, IrTermReturn(32)), IrBlockListNil))))))
}

fn tagged_routing_blocks() -> IrBlockList {
  routing_blocks(123, 456, IrInstCons(IrConstI64(33, 123),
    IrInstCons(IrBinaryI64(34, IrEq, 30, 33), IrInstNil)), 34)
}

fn routing_stays(blocks: IrBlockList) -> bool {
  match pipeline_ir_flow_conditional_routing_facts(blocks) {
    PipelineIrConditionalRoutingUnchanged(_) -> true
    PipelineIrConditionalRoutingReady(_, _) -> false
  }
}

fn assert_routed(blocks: IrBlockList) -[Test]> nil {
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(1234, 1, blocks, 0)), 0)
  let facts = pipeline_ir_flow_conditional_routing_facts(blocks)
  Test.assert_true(pipeline_ir_flow_conditional_routing_changed(facts))
  let result = pipeline_ir_flow_apply_conditional_routing(facts)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(1234, 1, result, 0)), 0)
  Test.assert_eq(pipeline_ir_verify_block_exists(result, 40), 0)
  Test.assert_true(match pipeline_ir_merge_find_body(result, 10) {
    IrBlockListCons(IrBlock(_, _, _, IrTermJump(60, IrValueCons(11, IrValueNil))), _) -> true
    _ -> false
  })
  Test.assert_true(match pipeline_ir_merge_find_body(result, 20) {
    IrBlockListCons(IrBlock(_, _, _, IrTermJump(70, IrValueCons(22, IrValueNil))), _) -> true
    _ -> false
  })
  Test.assert_true(match pipeline_ir_merge_find_body(result, 60) {
    IrBlockListCons(IrBlock(_, IrValueCons(31, IrValueNil), _, _), _) -> true
    _ -> false
  })
  Test.assert_true(match pipeline_ir_merge_find_body(result, 70) {
    IrBlockListCons(IrBlock(_, IrValueCons(32, IrValueNil), _, _), _) -> true
    _ -> false
  })
  nil
}

test "known word predicates transport only the live payload of each successor" {
  assert_routed(tagged_routing_blocks())
  assert_routed(routing_blocks(0 - 1, 0,
    IrInstCons(IrConstI64(33, 0), IrInstCons(IrBinaryI64(34, IrNe, 30, 33), IrInstNil)), 34))
}

test "Boolean dispatch carries live payloads without a materialized comparison" {
  assert_routed(routing_blocks(1, 0, IrInstNil, 30))
}

test "routing respects the actual entry with sparse unordered block identities" {
  let original = tagged_routing_blocks()
  let renamed = match original {
    IrBlockListCons(IrBlock(_, params, insts, term), rest) -> IrBlockListCons(IrBlock(100, params, insts, term), rest)
    _ -> original
  }
  assert_routed(renamed)
}

test "an unknown incoming predicate retains the complete merge" {
  let blocks = routing_block_replace(tagged_routing_blocks(), IrBlock(20, IrValueNil,
    IrInstCons(IrUnaryI64(20, IrNot, 0), IrInstCons(IrConstI64(21, 0), IrInstCons(IrConstI64(22, 202), IrInstNil))),
    IrTermJump(40, IrValueCons(20, IrValueCons(21, IrValueCons(22, IrValueNil))))))
  Test.assert_true(routing_stays(blocks))
}

test "payloads used by both arms retain their common definition" {
  let blocks = routing_block_replace(tagged_routing_blocks(), IrBlock(70, IrValueNil, IrInstNil, IrTermReturn(31)))
  Test.assert_true(routing_stays(blocks))
}

test "payloads used after reconvergence retain their common definition" {
  let yes = routing_block_replace(tagged_routing_blocks(), IrBlock(60, IrValueNil, IrInstNil, IrTermJump(90, IrValueNil)))
  let both = routing_block_replace(yes, IrBlock(70, IrValueNil, IrInstNil, IrTermJump(90, IrValueNil)))
  let blocks = ir_block_list_append(both, IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(31)), IrBlockListNil))
  Test.assert_true(routing_stays(blocks))
}

test "escaping dispatch constants and comparison values remain defined" {
  for value in [33, 34] {
    let blocks = routing_block_replace(tagged_routing_blocks(), IrBlock(60, IrValueNil, IrInstNil, IrTermReturn(value)))
    Test.assert_true(routing_stays(blocks))
  }
}

test "an additional successor predecessor prevents moving definitions" {
  let entry = routing_block_replace(tagged_routing_blocks(), IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(0, 10, 50)))
  let target = routing_block_replace(entry, IrBlock(60, IrValueNil, IrInstNil, IrTermReturn(0)))
  let blocks = ir_block_list_append(target, IrBlockListCons(IrBlock(50, IrValueNil, IrInstNil, IrTermBranch(0, 20, 60)), IrBlockListNil))
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(1234, 1, blocks, 0)), 0)
  Test.assert_true(routing_stays(blocks))
}

test "dispatch effects and unsupported numeric domains are retained" {
  let params = IrValueCons(30, IrValueCons(31, IrValueCons(32, IrValueNil)))
  for extra in [IrCallI64(35, 9876, IrValueNil), IrFloatBinaryI64(35, PRIM_F64(), IrEq, 31, 32),
    IrFloatBinaryI64(35, PRIM_U8(), IrEq, 31, 32)] {
    let insts = IrInstCons(extra, IrInstCons(IrConstI64(33, 123), IrInstCons(IrBinaryI64(34, IrEq, 30, 33), IrInstNil)))
    let blocks = routing_block_replace(tagged_routing_blocks(), IrBlock(40, params, insts, IrTermBranch(34, 60, 70)))
    Test.assert_true(routing_stays(blocks))
  }
}

test "flat structural cleanup retains its contiguous payload boundary" {
  let first = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let second = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(1, 8101, 0, 0, first))
  nlist_add(children, typeck_linear_layout_component(1, 8102, 1, 1, second))
  let plan = typeck_linear_layout_plan(2, ty_i64(), children, 2, 9301)
  let yes = routing_block_replace(tagged_routing_blocks(), IrBlock(60, IrValueNil,
    IrInstCons(IrStructuralDropI64(31, plan), IrInstNil), IrTermReturn(0)))
  let blocks = routing_block_replace(yes, IrBlock(70, IrValueNil, IrInstNil, IrTermReturn(0)))
  Test.assert_eq(pipeline_ir_value_list_feeds_multi_lane_capture(IrValueCons(31, IrValueNil), blocks), 1)
  Test.assert_true(routing_stays(blocks))
}
