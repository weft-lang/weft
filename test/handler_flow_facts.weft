use compiler/weft/facts/handler_flow.{*}
use compiler/ir/data.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/map.{Map}
use stdlib/option.{Option, Some, None}

fn flow_handle(abort: i64) -> IrInstList {
  IrInstCons(IrHandleI64(10, 0, 42, IrHandlerClauseBodyNil, 1, abort), IrInstNil)
}

fn flow_pop() -> IrInstList { IrInstCons(IrHandlerPopI64(10), IrInstNil) }

fn flow_blocks(values: List<IrBlock>) -> IrBlockList {
  match values {
    Nil -> IrBlockListNil
    Cons(block, rest) -> IrBlockListCons(block, flow_blocks(rest))
  }
}

fn flow_depth(stack: List<i64>) -> i64 {
  match stack { Nil -> 0 Cons(_, rest) -> 1 + flow_depth(rest) }
}

fn assert_flow_depth(flow: IrHandlerFlow, block: i64, expected: i64) -[Test]> nil {
  match flow {
    IrHandlerFlowFacts(entries, _, _, _, _, _) -> match entries.get(block) {
      Some(stack) -> Test.assert_eq(flow_depth(stack), expected)
      None -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  nil
}

test "handler entry stacks follow both branches independently" {
  let entry = ir_block_new_term(0, flow_handle(3), ir_term_branch(0, 1, 2))
  let early = ir_block_new_term(1, flow_pop(), ir_term_return(0))
  let later = ir_block_new_term(2, flow_pop(), ir_term_return(0))
  let abort = ir_block_new_term(3, IrInstNil, ir_term_return(0))
  let flow = ir_handler_flow(flow_blocks(Cons(entry, Cons(early, Cons(later, Cons(abort, Nil<IrBlock>()))))))
  assert_flow_depth(flow, 0, 0)
  assert_flow_depth(flow, 1, 1)
  assert_flow_depth(flow, 2, 1)
  assert_flow_depth(flow, 3, 0)
}

test "handler facts are independent of non-entry block layout" {
  let entry = ir_block_new_term(0, flow_handle(3), ir_term_jump(2))
  let inner = ir_block_new_term(2, flow_handle(4), ir_term_jump(1))
  let exit = ir_block_new_term(1, IrInstCons(IrHandlerPopI64(11), flow_pop()), ir_term_return(0))
  let outer_abort = ir_block_new_term(3, IrInstNil, ir_term_return(0))
  let inner_abort = ir_block_new_term(4, flow_pop(), ir_term_return(0))
  let flow = ir_handler_flow(flow_blocks(Cons(entry, Cons(exit, Cons(inner_abort, Cons(inner, Cons(outer_abort, Nil<IrBlock>())))))))
  assert_flow_depth(flow, 1, 2)
  assert_flow_depth(flow, 2, 1)
  assert_flow_depth(flow, 3, 0)
  assert_flow_depth(flow, 4, 1)
  Test.assert_eq(ir_handler_flow_max_depth(flow), 2)
}

test "loop backedges preserve an enclosing handler stack" {
  let entry = ir_block_new_term(0, flow_handle(3), ir_term_jump(1))
  let backedge = ir_block_new_term(1, IrInstNil, ir_term_branch(0, 1, 2))
  let exit = ir_block_new_term(2, flow_pop(), ir_term_return(0))
  let abort = ir_block_new_term(3, IrInstNil, ir_term_return(0))
  let flow = ir_handler_flow(flow_blocks(Cons(entry, Cons(backedge, Cons(exit, Cons(abort, Nil<IrBlock>()))))))
  assert_flow_depth(flow, 1, 1)
  assert_flow_depth(flow, 2, 1)
}

test "repeated handler entry after a pop has a stable parent" {
  let entry = ir_block_new_term(0, IrInstNil, ir_term_jump(1))
  let body = ir_block_new_term(1, IrInstCons(IrHandleI64(10, 0, 42, IrHandlerClauseBodyNil, 1, 2), flow_pop()), ir_term_jump(2))
  let next = ir_block_new_term(2, IrInstNil, ir_term_branch(0, 1, 3))
  let exit = ir_block_new_term(3, IrInstNil, ir_term_return(0))
  let flow = ir_handler_flow(flow_blocks(Cons(entry, Cons(body, Cons(next, Cons(exit, Nil<IrBlock>()))))))
  assert_flow_depth(flow, 1, 0)
  assert_flow_depth(flow, 2, 0)
}

test "incompatible handler stacks at a merge are rejected" {
  let entry = ir_block_new_term(0, flow_handle(0 - 1), ir_term_branch(0, 1, 2))
  let popped = ir_block_new_term(1, flow_pop(), ir_term_jump(2))
  let merge = ir_block_new_term(2, IrInstNil, ir_term_return(0))
  match ir_handler_flow(flow_blocks(Cons(entry, Cons(popped, Cons(merge, Nil<IrBlock>()))))) {
    IrHandlerFlowInvalid -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "unbalanced handler pops and missing targets are rejected" {
  let pop = IrBlockListCons(ir_block_new_term(0, flow_pop(), ir_term_return(0)), IrBlockListNil)
  let missing = IrBlockListCons(ir_block_new_term(0, flow_handle(9), ir_term_return(0)), IrBlockListNil)
  for blocks in [pop, missing] {
    match ir_handler_flow(blocks) {
      IrHandlerFlowInvalid -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
}

test "unreachable handler blocks do not acquire entry stacks" {
  let entry = ir_block_new_term(0, IrInstNil, ir_term_return(0))
  let dead = ir_block_new_term(1, flow_handle(2), ir_term_jump(2))
  let invalid = ir_block_new_term(2, flow_pop(), ir_term_jump(99))
  match ir_handler_flow(flow_blocks(Cons(entry, Cons(dead, Cons(invalid, Nil<IrBlock>()))))) {
    IrHandlerFlowFacts(entries, parents, _, _, _, depth) -> {
      Test.assert_eq(depth, 0)
      Test.assert_true(entries.get(1).is_none())
      Test.assert_true(parents.get(0).is_none())
    }
    _ -> Test.assert_true(false)
  }
}
