-- test/handler_inlining.weft -- static handler direct-call coverage

effect InlineSingle {
  fn get() -> i64
}

effect InlineChoice {
  fn first() -> i64
  fn second() -> i64
}

effect InlineLoop {
  fn one() -> i64
}

effect InlineOuter {
  fn get() -> i64
}

effect InlineInner {
  fn get() -> i64
}

effect InlineCapture {
  fn get() -> i64
}

effect InlineGeneric {
  fn get() -> i64
}

effect InlineEvidenceChain {
  fn add(v: i64) -> i64
}

effect InlineEvidenceCallback {
  fn get() -> i64
}

effect InlineEvidenceCallbackArg {
  fn add(v: i64) -> i64
}

fn handler_inline_dynamic_choice() -[InlineChoice]> i64 {
  InlineChoice.second()
}

fn handler_inline_generic_get<T>(x: T) -[InlineGeneric]> i64 {
  InlineGeneric.get()
}

fn handler_evidence_leaf(x: i64) -[InlineEvidenceChain]> i64 {
  InlineEvidenceChain.add(x)
}

fn handler_evidence_middle(y: i64) -[InlineEvidenceChain]> i64 {
  handler_evidence_leaf(y + 1)
}

fn handler_evidence_top(z: i64) -[InlineEvidenceChain]> i64 {
  handler_evidence_middle(z + 1)
}

fn handler_evidence_callback_leaf() -[InlineEvidenceCallback]> i64 {
  InlineEvidenceCallback.get()
}

fn handler_evidence_callback_leaf_plus_one() -[InlineEvidenceCallback]> i64 {
  InlineEvidenceCallback.get() + 1
}

fn handler_evidence_callback_apply(f: () -[InlineEvidenceCallback]> i64) -[InlineEvidenceCallback]> i64 {
  f()
}

fn handler_evidence_callback_forward(f: () -[InlineEvidenceCallback]> i64) -[InlineEvidenceCallback]> i64 {
  handler_evidence_callback_apply(f)
}

fn handler_evidence_callback_arg_leaf(x: i64) -[InlineEvidenceCallbackArg]> i64 {
  InlineEvidenceCallbackArg.add(x)
}

fn handler_evidence_callback_arg_apply(f: (i64) -[InlineEvidenceCallbackArg]> i64, x: i64) -[InlineEvidenceCallbackArg]> i64 {
  f(x + 1)
}

test "handler_inline_single_known_op" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_selects_matching_clause" {
  let got = handle InlineChoice.second() {
    InlineChoice.first() -> resume(10)
    InlineChoice.second() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_repeated_hot_loop_performs" {
  let mut i = 0
  let got = handle {
    let mut total = 0
    while i < 10 {
      total = total + InlineLoop.one()
      i = i + 1
    }
    total
  } {
    InlineLoop.one() -> resume(1)
  }
  Test.assert_eq(got, 10)
}

test "handler_inline_nested_same_effect_uses_nearest_handler" {
  let got = handle {
    let inner = handle InlineOuter.get() {
      InlineOuter.get() -> resume(20)
    }
    inner + InlineOuter.get()
  } {
    InlineOuter.get() -> resume(22)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_stack_finds_outer_matching_handler" {
  let got = handle {
    handle InlineOuter.get() + InlineInner.get() {
      InlineInner.get() -> resume(10)
    }
  } {
    InlineOuter.get() -> resume(32)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_captured_clause_env" {
  let base = 40
  let got = handle InlineCapture.get() {
    InlineCapture.get() -> resume(base + 2)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_effectful_callee_uses_runtime_dispatch" {
  let got = handle handler_inline_dynamic_choice() {
    InlineChoice.first() -> resume(10)
    InlineChoice.second() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_generic_helper_specialisation" {
  let got = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_direct_call_chain_runtime" {
  let got = handle handler_evidence_top(40) {
    InlineEvidenceChain.add(v) -> resume(v)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_runtime" {
  let got = handle handler_evidence_callback_apply(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_forwards_through_helper" {
  let got = handle handler_evidence_callback_forward(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_keeps_distinct_callbacks" {
  let first = handle handler_evidence_callback_apply(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(20)
  }
  let second = handle handler_evidence_callback_apply(handler_evidence_callback_leaf_plus_one) {
    InlineEvidenceCallback.get() -> resume(21)
  }
  Test.assert_eq(first + second, 42)
}

test "handler_evidence_callback_parameter_with_args_runtime" {
  let got = handle handler_evidence_callback_arg_apply(handler_evidence_callback_arg_leaf, 41) {
    InlineEvidenceCallbackArg.add(v) -> resume(v)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_generic_helper_distinct_captures" {
  let first_base = 1
  let first = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(first_base)
  }
  let second_base = 41
  let second = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(second_base)
  }
  Test.assert_eq(first + second, 42)
}
