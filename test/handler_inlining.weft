-- test/handler_inlining.weft -- static handler direct-call coverage

use "stdlib/display.weft"
use "runtime/defer_order_test.weft"

effect InlineSingle {
  fn get() -> i64
}

effect InlineBool {
  fn get() -> bool
}

effect InlineString {
  fn get() -> str
}

effect Maybe {
  fn none() -> i64
}

effect InlineChoice {
  fn first() -> i64
  fn second() -> i64
}

effect InlineLoop {
  fn one() -> i64
}

effect InlineOuter {
  fn get() -> i64
}

effect InlineInner {
  fn get() -> i64
}

effect InlineCapture {
  fn get() -> i64
}

effect InlineGeneric {
  fn get() -> i64
}

effect InlineManaged {
  fn get() -> i64
}

effect InlineEvidenceChain {
  fn add(v: i64) -> i64
}

effect InlineEvidenceCallback {
  fn get() -> i64
}

effect InlineEvidenceCallbackArg {
  fn add(v: i64) -> i64
}

effect InlineEvidenceClosure {
  fn get() -> i64
}

effect InlineEvidenceClosureOther {
  fn get() -> i64
}

effect InlineEvidenceMulti {
  fn put(v: i64) -> i64
  fn get() -> i64
}

type InlineMatchChoice {
  InlineMatchLeft(i64),
  InlineMatchRight(i64)
}

fn handler_inline_direct_call_accum(x: i64, y: i64) -> i64 {
  let mut z = x
  z = z + y
  z
}

fn handler_inline_generic_call_accum<T>(y: i64) -> i64 {
  let mut z = y
  z = z + 2
  z
}

type InlineFieldRecord {
  inline_field_value: i64
}

type InlineOptBox {
  inline_opt_value: i64
}

type InlineTryResult<T> {
  Ok(T),
  Err(i64)
}

type InlineRecordInitPair {
  inline_record_left: i64,
  inline_record_right: i64
}

type InlinePackedGenericRecord {
  inline_packed_tiny: i8,
  inline_packed_mid: i32
}

impl InlineRecordInitPair {
  fn add_inline(self: InlineRecordInitPair, extra: i64) -> i64 {
    self.inline_record_left + self.inline_record_right + extra
  }
}

impl InlinePackedGenericRecord {
  fn score_inline(self: InlinePackedGenericRecord, extra: i64) -> i64 {
    if self.inline_packed_mid == 42 { extra + 40 } else { 0 }
  }
}

fn handler_inline_match_pick(flag: bool) -> InlineMatchChoice {
  if flag { InlineMatchLeft(4) } else { InlineMatchRight(5) }
}

fn handler_inline_field_record() -> InlineFieldRecord {
  InlineFieldRecord { inline_field_value: 41 }
}

fn handler_inline_try_ok(v: i64) -> InlineTryResult<i64> {
  Ok<i64>(v)
}

fn handler_inline_packed_generic_record<T>() -> InlinePackedGenericRecord {
  let tiny: i8 = 7
  let mid: i32 = 42
  InlinePackedGenericRecord { inline_packed_tiny: tiny, inline_packed_mid: mid }
}

fn handler_inline_fp_mut_f64_start() -> f64 { 1.5 }
fn handler_inline_fp_mut_f64_next() -> f64 { 2.5 }
fn handler_inline_fp_mut_f32_start() -> f32 { 1.25 }
fn handler_inline_fp_mut_f32_next() -> f32 { 3.5 }
fn handler_inline_same_f64(a: f64, b: f64) -> i64 { if a == b { 1 } else { 0 } }
fn handler_inline_same_f32(a: f32, b: f32) -> i64 { if a == b { 1 } else { 0 } }

fn handler_inline_dynamic_choice() -[InlineChoice]> i64 {
  InlineChoice.second()
}

fn handler_inline_generic_get<T>(x: T) -[InlineGeneric]> i64 {
  InlineGeneric.get()
}

fn handler_evidence_leaf(x: i64) -[InlineEvidenceChain]> i64 {
  InlineEvidenceChain.add(x)
}

fn handler_evidence_middle(y: i64) -[InlineEvidenceChain]> i64 {
  handler_evidence_leaf(y + 1)
}

fn handler_evidence_top(z: i64) -[InlineEvidenceChain]> i64 {
  handler_evidence_middle(z + 1)
}

fn handler_evidence_callback_leaf() -[InlineEvidenceCallback]> i64 {
  InlineEvidenceCallback.get()
}

fn handler_evidence_callback_leaf_plus_one() -[InlineEvidenceCallback]> i64 {
  InlineEvidenceCallback.get() + 1
}

fn handler_evidence_callback_apply(f: () -[InlineEvidenceCallback]> i64) -[InlineEvidenceCallback]> i64 {
  f()
}

fn handler_evidence_callback_shadowed_global() -[InlineEvidenceCallback]> i64 {
  InlineEvidenceCallback.get() + 1
}

fn handler_evidence_callback_shadowed_apply(handler_evidence_callback_shadowed_global: () -[InlineEvidenceCallback]> i64) -[InlineEvidenceCallback]> i64 {
  handler_evidence_callback_shadowed_global()
}

fn handler_evidence_callback_forward(f: () -[InlineEvidenceCallback]> i64) -[InlineEvidenceCallback]> i64 {
  handler_evidence_callback_apply(f)
}

fn handler_evidence_callback_arg_leaf(x: i64) -[InlineEvidenceCallbackArg]> i64 {
  InlineEvidenceCallbackArg.add(x)
}

fn handler_evidence_callback_arg_apply(f: (i64) -[InlineEvidenceCallbackArg]> i64, x: i64) -[InlineEvidenceCallbackArg]> i64 {
  f(x + 1)
}

fn handler_evidence_make_closure() -[InlineEvidenceClosure]> () -[InlineEvidenceClosure]> i64 {
  () => InlineEvidenceClosure.get()
}

fn handler_evidence_make_pure_closure() -> () -[InlineEvidenceClosure]> i64 {
  () => InlineEvidenceClosure.get()
}

fn handler_evidence_multi_helper(x: i64) -[InlineEvidenceMulti]> i64 {
  InlineEvidenceMulti.put(x) + InlineEvidenceMulti.get()
}

fn handler_evidence_multi_leaf(x: i64) -[InlineEvidenceMulti]> i64 {
  InlineEvidenceMulti.put(x) + InlineEvidenceMulti.get()
}

fn handler_evidence_multi_top(x: i64) -[InlineEvidenceMulti]> i64 {
  handler_evidence_multi_leaf(x + 1)
}

fn handler_evidence_make_multi_closure() -[InlineEvidenceMulti]> () -[InlineEvidenceMulti]> i64 {
  () => InlineEvidenceMulti.put(40) + InlineEvidenceMulti.get()
}

test "handler_inline_single_known_op" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_selects_matching_clause" {
  let got = handle InlineChoice.second() {
    InlineChoice.first() -> resume(10)
    InlineChoice.second() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_repeated_hot_loop_performs" {
  let mut i = 0
  let got = handle {
    let mut total = 0
    while i < 10 {
      total = total + InlineLoop.one()
      i = i + 1
    }
    total
  } {
    InlineLoop.one() -> resume(1)
  }
  Test.assert_eq(got, 10)
}

test "handler_inline_nested_same_effect_uses_nearest_handler" {
  let got = handle {
    let inner = handle InlineOuter.get() {
      InlineOuter.get() -> resume(20)
    }
    inner + InlineOuter.get()
  } {
    InlineOuter.get() -> resume(22)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_stack_finds_outer_matching_handler" {
  let got = handle {
    handle InlineOuter.get() + InlineInner.get() {
      InlineInner.get() -> resume(10)
    }
  } {
    InlineOuter.get() -> resume(32)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_captured_clause_env" {
  let base = 40
  let got = handle InlineCapture.get() {
    InlineCapture.get() -> resume(base + 2)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_effectful_callee_uses_runtime_dispatch" {
  let got = handle handler_inline_dynamic_choice() {
    InlineChoice.first() -> resume(10)
    InlineChoice.second() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_generic_helper_specialisation" {
  let got = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_managed_let_in_resume_value" {
  let got = handle InlineManaged.get() {
    InlineManaged.get() -> resume({
      let s = "hi"
      let f: f64 = 1.5
      __str_len(s) + 40
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_if_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(if true { 42 } else { 0 })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_not_in_resume_value" {
  let got = handle InlineBool.get() {
    InlineBool.get() -> resume(not false)
  }
  Test.assert_eq(if got { 42 } else { 0 }, 42)
}

test "handler_inline_field_access_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(handler_inline_field_record().inline_field_value + 1)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_record_init_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let r = InlineRecordInitPair { inline_record_right: 1, inline_record_left: 41 }
      r.inline_record_left + r.inline_record_right
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_method_call_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let r = InlineRecordInitPair { inline_record_right: 1, inline_record_left: 40 }
      r.add_inline(1)
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_method_call_generic_receiver_packed_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(handler_inline_packed_generic_record<i64>().score_inline(2))
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_interp_concat_in_resume_value" {
  let got = handle InlineString.get() {
    InlineString.get() -> resume({
      let answer = 42
      "answer {answer}"
    })
  }
  Test.assert_eq(str_eq(got, "answer 42"), 1)
}

test "handler_inline_opt_chain_in_resume_value" {
  let got = handle {
    handle InlineSingle.get() {
      InlineSingle.get() -> resume({
        let box = InlineOptBox { inline_opt_value: 42 }
        box?.inline_opt_value
      })
    }
  } {
    Maybe.none() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_try_in_resume_value" {
  let got = handle {
    handle InlineSingle.get() {
      InlineSingle.get() -> resume(handler_inline_try_ok(42)?)
    }
  } {
    Fail.fail(e) -> resume(e)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_mut_update_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let mut x = 40
      x = x + 2
      x
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_defer_in_resume_value" {
  let log = defer_order_log_new()
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      defer defer_order_log_write(log, 1)
      42
    })
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "handler_inline_defer_before_clause_return" {
  let log = defer_order_log_new()
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> {
      defer defer_order_log_write(log, 2)
      return 42
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "handler_inline_defer_before_loop_break_in_resume_value" {
  let log = defer_order_log_new()
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(loop {
      defer defer_order_log_write(log, 3)
      break(42)
    })
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "handler_inline_defer_before_continue_in_resume_value" {
  let log = defer_order_log_new()
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let mut i = 0
      while i < 3 {
        i = i + 1
        defer defer_order_log_write(log, defer_order_log_read(log) + 1)
        if i < 3 { continue } else { 0 }
      }
      42
    })
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "handler_inline_match_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(match 1 { 0 -> 0 _ -> 42 })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_match_ctor_in_resume_value" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(match handler_inline_match_pick(true) { InlineMatchLeft(extra) -> extra + 38 _ -> 0 })
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_direct_call_chain_runtime" {
  let got = handle handler_evidence_top(40) {
    InlineEvidenceChain.add(v) -> resume(v)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_runtime" {
  let got = handle handler_evidence_callback_apply(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_local_callable_shadows_global_function" {
  let handler_evidence_callback_shadowed_global = (() => InlineEvidenceCallback.get())
  let got = handle handler_evidence_callback_shadowed_apply(handler_evidence_callback_shadowed_global) {
    InlineEvidenceCallback.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_forwards_through_helper" {
  let got = handle handler_evidence_callback_forward(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_callback_parameter_keeps_distinct_callbacks" {
  let first = handle handler_evidence_callback_apply(handler_evidence_callback_leaf) {
    InlineEvidenceCallback.get() -> resume(20)
  }
  let second = handle handler_evidence_callback_apply(handler_evidence_callback_leaf_plus_one) {
    InlineEvidenceCallback.get() -> resume(21)
  }
  Test.assert_eq(first + second, 42)
}

test "handler_evidence_callback_parameter_with_args_runtime" {
  let got = handle handler_evidence_callback_arg_apply(handler_evidence_callback_arg_leaf, 41) {
    InlineEvidenceCallbackArg.add(v) -> resume(v)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_closure_created_under_handler_captures_evidence" {
  let got = handle {
    let f = () => InlineEvidenceClosure.get()
    f()
  } {
    InlineEvidenceClosure.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_returned_closure_keeps_captured_evidence" {
  let f = handle handler_evidence_make_closure() {
    InlineEvidenceClosure.get() -> resume(42)
  }
  let got = handle f() {
    InlineEvidenceClosure.get() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_pure_factory_closure_uses_invocation_handler" {
  let f = handler_evidence_make_pure_closure()
  let got = handle f() {
    InlineEvidenceClosure.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_closure_uses_nearest_creation_handler" {
  let got = handle {
    let f = handle {
      () => InlineEvidenceClosure.get()
    } {
      InlineEvidenceClosure.get() -> resume(42)
    }
    handle f() {
      InlineEvidenceClosure.get() -> resume(0)
    }
  } {
    InlineEvidenceClosure.get() -> resume(99)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_closure_keeps_effect_identity_with_same_op_name" {
  let got = handle {
    let f = () => InlineEvidenceClosure.get()
    handle f() {
      InlineEvidenceClosureOther.get() -> resume(0)
    }
  } {
    InlineEvidenceClosure.get() -> resume(42)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_multi_op_direct_helper_runtime" {
  let got = handle handler_evidence_multi_helper(40) {
    InlineEvidenceMulti.put(v) -> resume(v)
    InlineEvidenceMulti.get() -> resume(2)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_multi_op_chain_runtime" {
  let got = handle handler_evidence_multi_top(39) {
    InlineEvidenceMulti.put(v) -> resume(v)
    InlineEvidenceMulti.get() -> resume(2)
  }
  Test.assert_eq(got, 42)
}

test "handler_evidence_multi_op_returned_closure_keeps_creation_handler" {
  let f = handle handler_evidence_make_multi_closure() {
    InlineEvidenceMulti.put(v) -> resume(v)
    InlineEvidenceMulti.get() -> resume(2)
  }
  let got = handle f() {
    InlineEvidenceMulti.put(v) -> resume(0)
    InlineEvidenceMulti.get() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_generic_helper_distinct_captures" {
  let first_base = 1
  let first = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(first_base)
  }
  let second_base = 41
  let second = handle handler_inline_generic_get<i64>(0) {
    InlineGeneric.get() -> resume(second_base)
  }
  Test.assert_eq(first + second, 42)
}

test "handler_inline_direct_call_typed_args_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume(handler_inline_direct_call_accum(if true { 40 } else { 0 }, 2))
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_generic_call_typed_args_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({ defer { 0 } handler_inline_generic_call_accum<i64>(if true { 40 } else { 0 }) })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_let_mut_generic_call_typed_args_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let mut z = handler_inline_generic_call_accum<i64>(if true { 40 } else { 0 })
      z
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_let_mut_generic_record_field_typed_base_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let mut z = handler_inline_packed_generic_record<i64>().inline_packed_mid
      if z == 42 { 42 } else { 0 }
    })
  }
  Test.assert_eq(got, 42)
}

test "handler_inline_typed_fp_let_mut_runtime" {
  let got = handle InlineSingle.get() {
    InlineSingle.get() -> resume({
      let mut a: f64 = handler_inline_fp_mut_f64_start()
      a = handler_inline_fp_mut_f64_next()
      let mut b: f32 = handler_inline_fp_mut_f32_start()
      b = handler_inline_fp_mut_f32_next()
      if handler_inline_same_f64(a, handler_inline_fp_mut_f64_next()) == 1 {
        if handler_inline_same_f32(b, handler_inline_fp_mut_f32_next()) == 1 { 42 } else { 0 }
      } else { 0 }
    })
  }
  Test.assert_eq(got, 42)
}
