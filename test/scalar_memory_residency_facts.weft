use compiler/backend/aarch64/codegen.{*}
use compiler/backend/aarch64/encode.{*}
use compiler/ir/data.{*}
use compiler/storage.{*}
use compiler/pipeline.{*}
use runtime/buffer.{*}
use stdlib/test.{Test}

fn scalar_memory_storages() -> [IrScalarStorage; 8] {
  [IrStorageEmpty, IrStorageU8, IrStorageI8, IrStorageU16, IrStorageI16, IrStorageU32, IrStorageI32, IrStorageWord64]
}

test "direct scalar memory operations preserve unrelated live integer registers" {
  for storage in scalar_memory_storages() {
    for access in [IrPtrLoadI64(4, 2, storage), IrPtrStoreI64(4, 2, 0, storage)] {
      let insts = IrInstCons(IrBinaryI64(3, IrAdd, 0, 1),
        IrInstCons(access, IrInstCons(IrBinaryI64(5, IrAdd, 3, 1), IrInstNil)))
      let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(5)), IrBlockListNil)
      let f64_facts = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
      let vector_facts = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
      let homes = pipeline_ir_native_volatile_residents(3, blocks, 0, fmap_new(), f64_facts, vector_facts)
      let home = pipeline_ir_native_pinned_slot_lookup(homes, 3)
      Test.assert_true(home > 0 and home < 15)
    }
  }
}

test "scalar memory emitters write only their result and reserved scratch registers" {
  for storage in scalar_memory_storages() {
    for write in [false, true] {
      for spilled in [false, true] {
        let destination = pipeline_ir_native_pinned_slot_new(20, 3, pipeline_ir_native_pinned_slot_kind_resident(), 0)
        let assignments = if spilled { destination } else {
          pipeline_ir_native_pinned_slot_new(18, 1, pipeline_ir_native_pinned_slot_kind_resident(),
            pipeline_ir_native_pinned_slot_new(19, 2, pipeline_ir_native_pinned_slot_kind_resident(), destination))
        }
        let homes = pipeline_ir_native_value_home_facts(21, assignments)
        let code = buf_new(64)
        if write { pipeline_ir_native_emit_ptr_store(code, 20, 18, 19, storage, fmap_new(), homes) }
        else { pipeline_ir_native_emit_ptr_load(code, 20, 18, storage, fmap_new(), homes) }
        for offset in 0..(buf_len(code) / 4) {
          let writes = decode_writes_aarch64(pipeline_native_code_word(code, offset * 4))
          Test.assert_eq(writes band decode_writes_unknown_bit(), 0)
          Test.assert_eq(writes band decode_writes_call_clobber_bit(), 0)
          for phys in 0..31 {
            if phys != 3 and phys != 15 and phys != 16 and phys != 17 {
              Test.assert_eq(writes band decode_writes_gpr_bit(phys), 0)
            } else { nil }
          }
          for phys in 0..16 { Test.assert_eq(writes band decode_writes_fp_bit(phys), 0) }
        }
      }
    }
  }
}

test "unknown scalar storage does not acquire an ordinary register contract" {
  Test.assert_eq(pipeline_ir_native_resident_inst_simple(IrPtrLoadI64(3, 0, IrStorageInvalid), 0), 0)
  Test.assert_eq(pipeline_ir_native_resident_inst_simple(IrPtrStoreI64(3, 0, 1, IrStorageInvalid), 0), 0)
}
