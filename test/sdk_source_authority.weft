use compiler/weft/imports.{parse_source_loader_for_table, parse_read_registered_or_load}
use compiler/source/input.{SourceRequest, SourceLoadResult, SourceLoaded, SourceUnavailable}
use compiler/source/loading.{source_loader, source_loader_load, source_loader_register}
use compiler/source/owners as source_owners
use compiler/weft/check/table.{ttable_new, ttable_set_sdk_package_id}
use runtime/source_acquire.{EmbeddedSdk, SdkSourceFound, SdkSourceMissing, SourceAcquire}
use stdlib/bytes as bytes
use stdlib/source.{Source}
use stdlib/diagnostic/schema.{*}

fn request(physical: str, logical: str, package_id: i64) -> SourceRequest {
  SourceRequest { physical_path: physical, logical_path: logical, package_id: package_id }
}

fn loaded_text(result: SourceLoadResult) -> str {
  match result { SourceLoaded(source) -> source.text, SourceUnavailable -> "unavailable" }
}

fn load_fixture(input: SourceRequest, sdk: bool) -[Test]> SourceLoadResult {
  let tt = ttable_new()
  ttable_set_sdk_package_id(tt, 73)
  let loader = parse_source_loader_for_table(tt)
  let content = if sdk { "SDK source" } else { "dependency source" }
  handle {
    handle source_loader_load(loader, input) {
      SourceAcquire.sdk_origin() -> resume(EmbeddedSdk("fixture"))
      SourceAcquire.load_sdk(path) -> {
        Test.assert_true(sdk)
        Test.assert_str_eq(path, input.logical_path.concat(".weft"))
        resume(SdkSourceFound(bytes.from_str(content)))
      }
      SourceAcquire.load(physical, logical, package_id) -> {
        Test.assert_false(sdk)
        Test.assert_eq(package_id, input.package_id)
        Test.assert_str_eq(physical, input.physical_path)
        Test.assert_str_eq(logical, input.logical_path)
        resume(bytes.from_str(content))
      }
    }
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false); resume(0) }
  }
}

test "source loader uses resolved SDK package authority" {
  Test.assert_str_eq(
    loaded_text(load_fixture(request("runtime/alloc.weft", "runtime/alloc", 73), true)),
    "SDK source"
  )
}

test "source loader preserves dependency authority at an SDK-shaped physical path" {
  Test.assert_str_eq(
    loaded_text(load_fixture(request("runtime/alloc.weft", "runtime/alloc", 91), false)),
    "dependency source"
  )
}

test "SDK module lookup uses canonical logical identity rather than physical spelling" {
  let input = request(
    "./test/module_fixtures/inherent_extension_types.weft",
    "test/module_fixtures/inherent_extension_types",
    73
  )
  Test.assert_str_eq(loaded_text(load_fixture(input, true)), "SDK source")
}

test "registered source overlays are isolated by package identity" {
  let path = "runtime/alloc.weft"
  let fallback = Source { text: "fallback", identity: DiagnosticSourceNamed(path) }
  let loader = source_loader(
    (input: SourceRequest) => SourceLoaded(fallback),
    source_owners.new()
  )
  source_loader_register(
    loader,
    request(path, "runtime/alloc", 73),
    Source { text: "SDK overlay", identity: DiagnosticSourceNamed(path) }
  )
  source_loader_register(
    loader,
    request(path, "runtime/alloc", 91),
    Source { text: "dependency overlay", identity: DiagnosticSourceNamed(path) }
  )
  handle {
    Test.assert_str_eq(
      loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 73), loader)),
      "SDK overlay"
    )
    Test.assert_str_eq(
      loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 91), loader)),
      "dependency overlay"
    )
    Test.assert_str_eq(
      loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 0), loader)),
      "fallback"
    )
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false); resume(0) }
  }
}
