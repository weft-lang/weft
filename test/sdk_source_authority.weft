use compiler/parse.{parse_read_registered_or_load, parse_source_loader_for_table}
use compiler/type_registry.{ttable_find_source_path_entry_in_package, ttable_new, ttable_register_source_in_package, ttable_set_sdk_package_id}
use runtime/memory.{mem_load64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use runtime/source_acquire.{EmbeddedSdk, SdkSourcePresent, SdkSourceMissing, SourceAcquire}
use stdlib/diagnostic/schema.{*}

test "source loader uses resolved SDK package authority" {
  let tt = ttable_new()
  ttable_set_sdk_package_id(tt, 73)
  let loader = parse_source_loader_for_table(tt)
  let path = "runtime/alloc.weft"
  let loaded = handle {
    handle loader(__str_ptr(path), __str_len(path), __str_ptr(path), __str_len(path), 73) {
      SourceAcquire.sdk_origin() -> resume(EmbeddedSdk("fixture"))
      SourceAcquire.load_sdk(path, len) -> resume(SdkSourcePresent(42, 1))
      SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> resume(0)
    }
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false) resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false) resume(0) }
  }
  Test.assert_eq(mem_load64_at(loaded, 0), 42)
}

test "source loader preserves dependency authority at an SDK-shaped physical path" {
  let tt = ttable_new()
  ttable_set_sdk_package_id(tt, 73)
  let loader = parse_source_loader_for_table(tt)
  let path = "runtime/alloc.weft"
  let loaded = handle {
    handle loader(__str_ptr(path), __str_len(path), __str_ptr(path), __str_len(path), 91) {
      SourceAcquire.sdk_origin() -> resume(EmbeddedSdk("fixture"))
      SourceAcquire.load_sdk(path, len) -> resume(SdkSourceMissing)
      SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> resume(package_id)
    }
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false) resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false) resume(0) }
  }
  Test.assert_eq(loaded, 91)
}

test "SDK module lookup uses canonical logical identity rather than physical spelling" {
  let tt = ttable_new()
  ttable_set_sdk_package_id(tt, 73)
  let loader = parse_source_loader_for_table(tt)
  let physical = "./test/module_fixtures/inherent_extension_types.weft"
  let logical = "test/module_fixtures/inherent_extension_types"
  let loaded = handle {
    handle loader(__str_ptr(physical), __str_len(physical), __str_ptr(logical), __str_len(logical), 73) {
      SourceAcquire.sdk_origin() -> resume(EmbeddedSdk("fixture"))
      SourceAcquire.load_sdk(path, len) -> {
        Test.assert_str_eq(runtime_str_from_bytes_copy(path, len), "test/module_fixtures/inherent_extension_types.weft")
        resume(SdkSourcePresent(42, 1))
      }
      SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> { Test.assert_true(false) resume(0) }
    }
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false) resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false) resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false) resume(0) }
  }
  Test.assert_eq(mem_load64_at(loaded, 0), 42)
}

test "registered source overlays are isolated by package identity" {
  let tt = ttable_new()
  let path = "runtime/alloc.weft"
  let sdk_source = "pub fn sdk_value() -> i64 { 73 }"
  let package_source = "pub fn package_value() -> i64 { 91 }"
  let sdk_entry = ttable_register_source_in_package(tt, __str_ptr(sdk_source), __str_len(sdk_source), __str_ptr(path), __str_len(path), 73)
  let package_entry = ttable_register_source_in_package(tt, __str_ptr(package_source), __str_len(package_source), __str_ptr(path), __str_len(path), 91)
  Test.assert_eq(ttable_find_source_path_entry_in_package(tt, __str_ptr(path), __str_len(path), 73), sdk_entry)
  Test.assert_eq(ttable_find_source_path_entry_in_package(tt, __str_ptr(path), __str_len(path), 91), package_entry)
  Test.assert_eq(ttable_find_source_path_entry_in_package(tt, __str_ptr(path), __str_len(path), 0), 0)
  let loader = (physical: i64, physical_len: i64, logical: i64, logical_len: i64, package_id: i64) => 42
  let overlaid = parse_read_registered_or_load(tt, __str_ptr(path), __str_len(path), __str_ptr(path), __str_len(path), 91, loader)
  Test.assert_eq(mem_load64_at(overlaid, 0), __str_ptr(package_source))
  Test.assert_eq(parse_read_registered_or_load(tt, __str_ptr(path), __str_len(path), __str_ptr(path), __str_len(path), 0, loader), 42)
}
