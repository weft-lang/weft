use compiler/grammar_host.{parse_source_loader_for_table, parse_read_registered_or_load}
use compiler/source_input.{SourceRequest, SourceLoadResult, SourceLoaded, SourceUnavailable}
use compiler/source_loading.{source_loader, source_loader_load, source_loader_register}
use compiler/source_owners as source_owners
use compiler/type_registry.{ttable_new, ttable_set_sdk_package_id}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_store64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use runtime/source_acquire.{EmbeddedSdk, SdkSourcePresent, SdkSourceMissing, SourceAcquire}
use stdlib/source.{Source}
use stdlib/diagnostic/schema.{*}

fn request(physical: str, logical: str, package_id: i64) -> SourceRequest {
  SourceRequest { physical_path: physical, logical_path: logical, package_id: package_id }
}

fn loaded_text(result: SourceLoadResult) -> str {
  match result { SourceLoaded(source) -> source.text, SourceUnavailable -> "unavailable" }
}

fn load_fixture(input: SourceRequest, sdk: bool) -[Test]> SourceLoadResult {
  let tt = ttable_new()
  ttable_set_sdk_package_id(tt, 73)
  let loader = parse_source_loader_for_table(tt)
  let content = if sdk { "SDK source" } else { "dependency source" }
  handle {
    handle source_loader_load(loader, input) {
      SourceAcquire.sdk_origin() -> resume(EmbeddedSdk("fixture"))
      SourceAcquire.load_sdk(path, len) -> {
        Test.assert_true(sdk)
        Test.assert_str_eq(runtime_str_from_bytes_copy(path, len), input.logical_path.concat(".weft"))
        resume(SdkSourcePresent(__str_ptr(content), __str_len(content)))
      }
      SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> {
        Test.assert_false(sdk)
        Test.assert_eq(package_id, input.package_id)
        Test.assert_str_eq(runtime_str_from_bytes_copy(physical, physical_len), input.physical_path)
        Test.assert_str_eq(runtime_str_from_bytes_copy(logical, logical_len), input.logical_path)
        let descriptor = alloc_words(2)
        mem_store64_at(descriptor, 0, __str_ptr(content))
        mem_store64_at(descriptor, 8, __str_len(content))
        resume(descriptor)
      }
    }
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false); resume(0) }
  }
}

test "source loader uses resolved SDK package authority" {
  Test.assert_str_eq(loaded_text(load_fixture(request("runtime/alloc.weft", "runtime/alloc", 73), true)), "SDK source")
}

test "source loader preserves dependency authority at an SDK-shaped physical path" {
  Test.assert_str_eq(loaded_text(load_fixture(request("runtime/alloc.weft", "runtime/alloc", 91), false)), "dependency source")
}

test "SDK module lookup uses canonical logical identity rather than physical spelling" {
  let input = request("./test/module_fixtures/inherent_extension_types.weft", "test/module_fixtures/inherent_extension_types", 73)
  Test.assert_str_eq(loaded_text(load_fixture(input, true)), "SDK source")
}

test "registered source overlays are isolated by package identity" {
  let path = "runtime/alloc.weft"
  let fallback = Source { text: "fallback", identity: DiagnosticSourceNamed(path) }
  let loader = source_loader((input: SourceRequest) => SourceLoaded(fallback), source_owners.new())
  source_loader_register(loader, request(path, "runtime/alloc", 73), Source { text: "SDK overlay", identity: DiagnosticSourceNamed(path) })
  source_loader_register(loader, request(path, "runtime/alloc", 91), Source { text: "dependency overlay", identity: DiagnosticSourceNamed(path) })
  handle {
    Test.assert_str_eq(loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 73), loader)), "SDK overlay")
    Test.assert_str_eq(loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 91), loader)), "dependency overlay")
    Test.assert_str_eq(loaded_text(parse_read_registered_or_load(request(path, "runtime/alloc", 0), loader)), "fallback")
  } {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, span) -> { Test.assert_true(false); resume(0) }
    Diagnose.note(message, span) -> { Test.assert_true(false); resume(0) }
  }
}
