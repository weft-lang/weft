use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/option.{*}
use stdlib/test.{Test}

fn vector_element_size_of<T>() -> i64 { 73 }
fn vector_element_mode_of<T>() -> i64 { 74 }
fn vector_element_leaf_count_of<T>() -> i64 { 75 }
fn vector_element_leaf_stride_of<T>() -> i64 { 76 }
fn vector_element_leaf_kind_of<T>() -> i64 { 77 }
fn map_storage_cleanup_kind_of<T>() -> i64 { 78 }

fn forwarded_mode<T>() -> i64 { vector_element_mode_of<T>() }

test "ordinary generic functions with layout-helper names keep their declared behavior" {
  Test.assert_eq(vector_element_size_of<i64>(), 73)
  Test.assert_eq(vector_element_mode_of<str>(), 74)
  Test.assert_eq(vector_element_leaf_count_of<[i64; 0]>(), 75)
  Test.assert_eq(vector_element_leaf_stride_of<[str; 2]>(), 76)
  Test.assert_eq(vector_element_leaf_kind_of<bool>(), 77)
  Test.assert_eq(map_storage_cleanup_kind_of<u16>(), 78)
  Test.assert_eq(forwarded_mode<str>(), 74)
}

test "canonical vector queries remain distinct from same-named local functions" {
  let mut names = vector.with_capacity<str>(1)
  names.push("first")
  names.push("second")
  Test.assert_str_eq(names.get(0).unwrap(), "first")
  Test.assert_str_eq(names.get(1).unwrap(), "second")
  let values: [u8; 3] = [0, 127, 255]
  let mut bytes = vector.with_capacity<u8>(1)
  for value in values { bytes.push(value) }
  Test.assert_true(bytes.get(0).unwrap() == 0)
  Test.assert_true(bytes.get(1).unwrap() == 127)
  Test.assert_true(bytes.get(2).unwrap() == 255)
}

type QueryPacket { tag: u8, delta: i8, valid: bool }
type QueryWord = opaque u16

test "resolved queries preserve packed record and opaque scalar storage" {
  let mut packets = vector.with_capacity<QueryPacket>(1)
  packets.push(QueryPacket { tag: 255, delta: 0 - 128, valid: true })
  packets.push(QueryPacket { tag: 7, delta: 127, valid: false })
  let first = packets.get(0).unwrap()
  let second = packets.get(1).unwrap()
  Test.assert_true(first.tag == 255 and first.delta == 0 - 128 and first.valid)
  Test.assert_true(second.tag == 7 and second.delta == 127 and not second.valid)
  let mut words = vector.with_capacity<QueryWord>(1)
  words.push(QueryWord(513))
  words.push(QueryWord(65535))
  Test.assert_true(match words.get(0).unwrap() { QueryWord(value) -> value == 513 })
  Test.assert_true(match words.get(1).unwrap() { QueryWord(value) -> value == 65535 })
}

test "zero-sized and managed array elements preserve cardinality and contents" {
  let mut empty_values = vector.with_capacity<[u8; 0]>(1)
  let first: [u8; 0] = []
  let second: [u8; 0] = []
  empty_values.push(first)
  empty_values.push(second)
  Test.assert_eq_usize(empty_values.len(), 2)
  Test.assert_true(empty_values.get(0).is_some() and empty_values.get(1).is_some())
  Test.assert_true(empty_values.get(2).is_none())
  let mut pairs = vector.with_capacity<[str; 2]>(1)
  let first_pair: [str; 2] = ["one", "two"]
  let second_pair: [str; 2] = ["three", "four"]
  pairs.push(first_pair)
  pairs.push(second_pair)
  let kept = pairs.get(1).unwrap()
  Test.assert_str_eq(kept[0], "three")
  Test.assert_str_eq(kept[1], "four")
}
