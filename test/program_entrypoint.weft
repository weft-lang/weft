use test/module_fixtures/entry_callable as dep
use stdlib/state as state
use stdlib/state.{State}

type App { App }
impl App {
  fn main(self) -[dep.EntryDependencyRead]> i64 { dep.main() }
}
fn run<T>(value: T) -[State<T>]> T { State.put(value); State.get() }
fn main() -> i64 {
  let supplied = handle App().main() { dep.EntryDependencyRead.get() -> resume(21) }
  let result = state.run(0, () => run<i64>(supplied + 21))
  if result.0 == 42 and result.1 == 42 { 0 } else { 1 }
}

test "generated startup preserves the callable root entry" {
  Test.assert_eq(main(), 0)
}
