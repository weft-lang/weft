use stdlib/display.{*}
use stdlib/num as num
use stdlib/num.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/test.{*}

fn display_value<T: Display>(value: T) -> str { value.display() }

fn f64_display_roundtrip_bits(bits: u64) -> bool {
  let value = num.f64_from_bits(bits)
  match num.parse_f64(value.to_str()) {
    Ok(parsed) -> parsed.to_bits() == bits
    Err(error) -> false
  }
}

fn f32_display_roundtrip_bits(bits: u32) -> bool {
  let value = num.f32_from_bits(bits)
  match num.parse_f32(value.to_str()) {
    Ok(parsed) -> parsed.to_bits() == bits
    Err(error) -> false
  }
}

test "generic method float results retain IEEE comparison semantics" {
  let nan64 = num.parse_f64("NaN").unwrap_or(0.0)
  let nan32 = num.parse_f32("NaN").unwrap_or(0.0)
  Test.assert_true(nan64 != nan64)
  Test.assert_true(nan32 != nan32)
  Test.assert_true(num.parse_f64("NaN").unwrap_or(0.0) != num.parse_f64("NaN").unwrap_or(0.0))
  Test.assert_true(num.parse_f32("NaN").unwrap_or(0.0) != num.parse_f32("NaN").unwrap_or(0.0))
}

fn f64_display_property(i: i64) -> bool {
  let exponent = (i * 37) % 2047
  let fraction = (i * 1000003 + 17) % 4503599627370496
  let magnitude: u64 = __i64_to_u64(exponent * 4503599627370496 + fraction)
  let bits = if i % 2 == 0 { magnitude } else { magnitude bor 9223372036854775808 }
  f64_display_roundtrip_bits(bits)
}

fn f32_display_property(i: i64) -> bool {
  let exponent = (i * 37) % 255
  let fraction = (i * 1009 + 17) % 8388608
  let magnitude: u32 = __i64_to_u32(exponent * 8388608 + fraction)
  let bits = if i % 2 == 0 { magnitude } else { magnitude bor 2147483648 }
  f32_display_roundtrip_bits(bits)
}

test "f64 display uses canonical shortest ordinary spellings" {
  Test.assert_str_eq(0.0.to_str(), "0")
  Test.assert_str_eq(1.0.to_str(), "1")
  Test.assert_str_eq((0.0 - 1.0).to_str(), "-1")
  Test.assert_str_eq(1.5.to_str(), "1.5")
  Test.assert_str_eq(0.1.to_str(), "0.1")
  Test.assert_str_eq(1.2345678901234567.to_str(), "1.2345678901234567")
}

test "f64 display has deterministic plain and scientific thresholds" {
  Test.assert_str_eq(1e-6.to_str(), "0.000001")
  Test.assert_str_eq(1e-7.to_str(), "1e-7")
  Test.assert_str_eq(1e20.to_str(), "100000000000000000000")
  Test.assert_str_eq(1e21.to_str(), "1e21")
}

test "f64 display covers subnormal normal and finite boundaries" {
  Test.assert_str_eq(num.f64_from_bits(1).to_str(), "5e-324")
  Test.assert_str_eq(num.f64_from_bits(4503599627370495).to_str(), "2.225073858507201e-308")
  Test.assert_str_eq(num.f64_from_bits(4503599627370496).to_str(), "2.2250738585072014e-308")
  Test.assert_str_eq(num.f64_from_bits(9218868437227405311).to_str(), "1.7976931348623157e308")
}

test "f32 display covers shortest and IEEE boundaries" {
  Test.assert_str_eq(num.f32_from_bits(1056964608).to_str(), "0.5")
  Test.assert_str_eq(num.f32_from_bits(1069547520).to_str(), "1.5")
  Test.assert_str_eq(num.f32_from_bits(1).to_str(), "1e-45")
  Test.assert_str_eq(num.f32_from_bits(8388607).to_str(), "1.1754942e-38")
  Test.assert_str_eq(num.f32_from_bits(8388608).to_str(), "1.1754944e-38")
  Test.assert_str_eq(num.f32_from_bits(2139095039).to_str(), "3.4028235e38")
}

test "float display preserves signed zero and names nonfinite values" {
  Test.assert_str_eq(num.f64_from_bits(9223372036854775808).to_str(), "-0")
  Test.assert_str_eq(num.f64_from_bits(9218868437227405312).to_str(), "inf")
  Test.assert_str_eq(num.f64_from_bits(18442240474082181120).to_str(), "-inf")
  Test.assert_str_eq(num.f64_from_bits(9221120237041095221).to_str(), "NaN")
  Test.assert_str_eq(num.f32_from_bits(2147483648).to_str(), "-0")
  Test.assert_str_eq(num.f32_from_bits(2139095040).to_str(), "inf")
  Test.assert_str_eq(num.f32_from_bits(4286578688).to_str(), "-inf")
  Test.assert_str_eq(num.f32_from_bits(2143289349).to_str(), "NaN")
}

test "float methods and Display share one canonical implementation" {
  let x: f64 = 12.5
  let y: f32 = num.f32_from_bits(1078984704)
  Test.assert_str_eq(x.to_str(), "12.5")
  Test.assert_str_eq(display_value<f64>(x), x.to_str())
  Test.assert_str_eq(display_value<f32>(y), y.to_str())
  Test.assert_str_eq("value: {x}", "value: 12.5")
}

test "float display roundtrips adversarial fixed payloads" {
  Test.assert_true(f64_display_roundtrip_bits(1))
  Test.assert_true(f64_display_roundtrip_bits(2))
  Test.assert_true(f64_display_roundtrip_bits(4503599627370495))
  Test.assert_true(f64_display_roundtrip_bits(4503599627370496))
  Test.assert_true(f64_display_roundtrip_bits(4607182418800017409))
  Test.assert_true(f64_display_roundtrip_bits(9218868437227405311))
  Test.assert_true(f32_display_roundtrip_bits(1))
  Test.assert_true(f32_display_roundtrip_bits(8388607))
  Test.assert_true(f32_display_roundtrip_bits(8388608))
  Test.assert_true(f32_display_roundtrip_bits(1065353217))
  Test.assert_true(f32_display_roundtrip_bits(2139095039))
}

test "property float display roundtrips deterministic payload matrices" {
  Test.forall_i64_range(0, 257, f64_display_property)
  Test.forall_i64_range(0, 257, f32_display_property)
}
