use stdlib/display.{*}
use stdlib/num.{*}
use stdlib/result.{Err, Ok}
use stdlib/test.{*}

fn display_value<T: Display>(value: T) -> str { value.display() }

fn f64_display_roundtrip_bits(bits: u64) -> bool {
  let value = num_f64_from_bits(bits)
  match num_parse_f64(num_f64_to_str(value)) {
    Ok(parsed) -> num_f64_to_bits(parsed) == bits
    Err(error) -> false
  }
}

fn f32_display_roundtrip_bits(bits: u32) -> bool {
  let value = num_f32_from_bits(bits)
  match num_parse_f32(num_f32_to_str(value)) {
    Ok(parsed) -> num_f32_to_bits(parsed) == bits
    Err(error) -> false
  }
}

fn f64_display_property(i: i64) -> bool {
  let exponent = (i * 37) % 2047
  let fraction = (i * 1000003 + 17) % 4503599627370496
  let magnitude: u64 = __i64_to_u64(exponent * 4503599627370496 + fraction)
  let bits = if i % 2 == 0 { magnitude } else { magnitude bor 9223372036854775808 }
  f64_display_roundtrip_bits(bits)
}

fn f32_display_property(i: i64) -> bool {
  let exponent = (i * 37) % 255
  let fraction = (i * 1009 + 17) % 8388608
  let magnitude: u32 = __i64_to_u32(exponent * 8388608 + fraction)
  let bits = if i % 2 == 0 { magnitude } else { magnitude bor 2147483648 }
  f32_display_roundtrip_bits(bits)
}

test "f64 display uses canonical shortest ordinary spellings" {
  Test.assert_str_eq(num_f64_to_str(0.0), "0")
  Test.assert_str_eq(num_f64_to_str(1.0), "1")
  Test.assert_str_eq(num_f64_to_str(0.0 - 1.0), "-1")
  Test.assert_str_eq(num_f64_to_str(1.5), "1.5")
  Test.assert_str_eq(num_f64_to_str(0.1), "0.1")
  Test.assert_str_eq(num_f64_to_str(1.2345678901234567), "1.2345678901234567")
}

test "f64 display has deterministic plain and scientific thresholds" {
  Test.assert_str_eq(num_f64_to_str(1e-6), "0.000001")
  Test.assert_str_eq(num_f64_to_str(1e-7), "1e-7")
  Test.assert_str_eq(num_f64_to_str(1e20), "100000000000000000000")
  Test.assert_str_eq(num_f64_to_str(1e21), "1e21")
}

test "f64 display covers subnormal normal and finite boundaries" {
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(1)), "5e-324")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(4503599627370495)), "2.225073858507201e-308")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(4503599627370496)), "2.2250738585072014e-308")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(9218868437227405311)), "1.7976931348623157e308")
}

test "f32 display covers shortest and IEEE boundaries" {
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(1056964608)), "0.5")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(1069547520)), "1.5")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(1)), "1e-45")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(8388607)), "1.1754942e-38")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(8388608)), "1.1754944e-38")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(2139095039)), "3.4028235e38")
}

test "float display preserves signed zero and names nonfinite values" {
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(9223372036854775808)), "-0")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(9218868437227405312)), "inf")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(18442240474082181120)), "-inf")
  Test.assert_str_eq(num_f64_to_str(num_f64_from_bits(9221120237041095221)), "NaN")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(2147483648)), "-0")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(2139095040)), "inf")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(4286578688)), "-inf")
  Test.assert_str_eq(num_f32_to_str(num_f32_from_bits(2143289349)), "NaN")
}

test "float methods and Display share one canonical implementation" {
  let x: f64 = 12.5
  let y: f32 = num_f32_from_bits(1078984704)
  Test.assert_str_eq(x.to_str(), "12.5")
  Test.assert_str_eq(display_value<f64>(x), x.to_str())
  Test.assert_str_eq(display_value<f32>(y), y.to_str())
  Test.assert_str_eq("value: {x}", "value: 12.5")
}

test "float display roundtrips adversarial fixed payloads" {
  Test.assert_true(f64_display_roundtrip_bits(1))
  Test.assert_true(f64_display_roundtrip_bits(2))
  Test.assert_true(f64_display_roundtrip_bits(4503599627370495))
  Test.assert_true(f64_display_roundtrip_bits(4503599627370496))
  Test.assert_true(f64_display_roundtrip_bits(4607182418800017409))
  Test.assert_true(f64_display_roundtrip_bits(9218868437227405311))
  Test.assert_true(f32_display_roundtrip_bits(1))
  Test.assert_true(f32_display_roundtrip_bits(8388607))
  Test.assert_true(f32_display_roundtrip_bits(8388608))
  Test.assert_true(f32_display_roundtrip_bits(1065353217))
  Test.assert_true(f32_display_roundtrip_bits(2139095039))
}

test "property float display roundtrips deterministic payload matrices" {
  Test.forall_i64_range(0, 257, f64_display_property)
  Test.forall_i64_range(0, 257, f32_display_property)
}
