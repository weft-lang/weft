-- Checked bodies publish only after their signature and companion graphs agree.

use compiler/project/identity.{
  ModuleFunctionIdentity,
  ModuleIdentity,
  named_module_identity
}
use compiler/project/identity/equality.{function_identity_eq}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticFunctionNode,
  SemanticTypeId,
  semantic_type_graph_node,
  semantic_type_id_eq
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/weft/check/body/closure.{checked_closure_builder}
use compiler/weft/check/body/effects.{checked_effect_builder}
use compiler/weft/check/body/graph.{
  CheckedImmutableBinding,
  CheckedSourceRange,
  checked_expr_graph_builder,
  checked_expr_id_eq
}
use compiler/weft/check/body/pattern.{checked_pattern_graph_builder}
use compiler/weft/check/body/product.{*}
use compiler/weft/check/body/propagation.{checked_propagation_builder}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/signatures.{
  SemanticFunctionSignature,
  SemanticSignatureProduct,
  SemanticSignaturesResolved,
  resolve_module_signatures
}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/source.{Source}
use stdlib/test.{Test}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

fn scope_for(module: RegisteredModule) -> RegistrationScope {
  let builder = registration_scope.registration_builder()
  registration_scope.registration_builder_add(builder, module)
  registration_scope.registration_builder_freeze(builder)
}

fn signatures(module: RegisteredModule) -> SemanticSignatureProduct {
  match resolve_module_signatures(module, scope_for(module)) {
    SemanticSignaturesResolved(product) -> product
    _ -> panic("expected module signatures")
  }
}

fn signature_result(
  catalog: borrow SemanticTypeCatalog,
  signature: SemanticFunctionSignature
) -> SemanticTypeId {
  match catalog.graph_for(signature.type_id) {
    Some(graph) -> match semantic_type_graph_node(graph, signature.type_id) {
      SemanticFunctionNode(_, result, _) -> result
      _ -> panic("expected function signature")
    }
    _ -> panic("expected signature graph")
  }
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn complete_body(
  module: RegisteredModule,
  product: SemanticSignatureProduct,
  publish_function: bool
) -> CheckedBodyProductResult {
  let signature = product.at(0)
  let catalog = product.catalog()
  let result_type = signature_result(catalog, signature)
  let expressions = checked_expr_graph_builder(
    module.identity,
    module.source,
    catalog,
    1
  )
  let patterns = checked_pattern_graph_builder(
    expressions.segment(),
    module.source,
    catalog
  )
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let (expressions, root) = expressions.integer(7, result_type, range(0, 1))
  let expressions = if publish_function {
    expressions.function(signature.identity, root)
  } else { expressions }
  checked_body_product(
    product,
    expressions.freeze(),
    patterns.freeze(),
    closures.freeze(),
    effects.freeze(),
    propagation.freeze()
  )
}

test "checked body freeze joins exact signatures functions and companion graphs" {
  let identity = named_module_identity("fixture/checked_body_product", 81)
  let module = registered("fn value() -> i64 { 7 }", identity)
  match complete_body(module, signatures(module), true) {
    CheckedBodyProductAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 1)
      let function = product.function(0)
      let product_signatures = product.signatures()
      let signature = product_signatures.at(0)
      let expressions = product.expressions()
      let stored_function = expressions.function(0)
      let catalog = product_signatures.catalog()
      Test.assert_true(function_identity_eq(function.signature.identity, signature.identity))
      Test.assert_true(checked_expr_id_eq(function.body, stored_function.root))
      Test.assert_true(
        match product.expression_owner(function.body) {
          Some(owner) -> function_identity_eq(owner, function.signature.identity)
          _ -> false
        }
      )
      Test.assert_true(
        semantic_type_id_eq(
          expressions.result_type(function.body),
          signature_result(catalog, signature)
        )
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body freeze rejects expressions after the final function root" {
  let identity = named_module_identity("fixture/checked_body_trailing", 85)
  let module = registered("fn value() -> i64 { 7 }", identity)
  let product = signatures(module)
  let signature = product.at(0)
  let catalog = product.catalog()
  let result_type = signature_result(catalog, signature)
  let expressions = checked_expr_graph_builder(module.identity, module.source, catalog, 1)
  let patterns = checked_pattern_graph_builder(expressions.segment(), module.source, catalog)
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let (expressions, root) = expressions.integer(7, result_type, range(0, 1))
  let expressions = expressions.function(signature.identity, root)
  let (expressions, _) = expressions.integer(8, result_type, range(0, 1))
  Test.assert_true(
    match checked_body_product(
      product,
      expressions.freeze(),
      patterns.freeze(),
      closures.freeze(),
      effects.freeze(),
      propagation.freeze()
    ) {
      CheckedBodyProductRejected(CheckedBodyUnownedExpression(1)) -> true
      _ -> false
    }
  )
}

test "checked body freeze rejects reused or reversed function roots" {
  let identity = named_module_identity("fixture/checked_body_root_order", 86)
  let module = registered("fn first() -> i64 { 7 }\nfn second() -> i64 { 7 }", identity)
  let product = signatures(module)
  let first = product.at(0)
  let second = product.at(1)
  let catalog = product.catalog()
  let result_type = signature_result(catalog, first)
  let expressions = checked_expr_graph_builder(module.identity, module.source, catalog, 2)
  let patterns = checked_pattern_graph_builder(expressions.segment(), module.source, catalog)
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let (expressions, root) = expressions.integer(7, result_type, range(0, 1))
  let expressions = expressions.function(first.identity, root).function(second.identity, root)
  Test.assert_true(
    match checked_body_product(
      product,
      expressions.freeze(),
      patterns.freeze(),
      closures.freeze(),
      effects.freeze(),
      propagation.freeze()
    ) {
      CheckedBodyProductRejected(CheckedBodyFunctionRootOutOfOrder(1)) -> true
      _ -> false
    }
  )
}

test "checked expression owners follow distinct function root ranges" {
  let identity = named_module_identity("fixture/checked_body_owner_ranges", 87)
  let module = registered("fn first() -> i64 { 7 }\nfn second() -> i64 { 8 }", identity)
  let product = signatures(module)
  let first = product.at(0)
  let second = product.at(1)
  let catalog = product.catalog()
  let result_type = signature_result(catalog, first)
  let expressions = checked_expr_graph_builder(module.identity, module.source, catalog, 2)
  let patterns = checked_pattern_graph_builder(expressions.segment(), module.source, catalog)
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let (expressions, first_root) = expressions.integer(7, result_type, range(0, 1))
  let expressions = expressions.function(first.identity, first_root)
  let (expressions, second_root) = expressions.integer(8, result_type, range(1, 2))
  let expressions = expressions.function(second.identity, second_root)
  match checked_body_product(
    product,
    expressions.freeze(),
    patterns.freeze(),
    closures.freeze(),
    effects.freeze(),
    propagation.freeze()
  ) {
    CheckedBodyProductAccepted(body) -> {
      Test.assert_true(
        match body.expression_owner(first_root) {
          Some(owner) -> function_identity_eq(owner, first.identity)
          _ -> false
        }
      )
      Test.assert_true(
        match body.expression_owner(second_root) {
          Some(owner) -> function_identity_eq(owner, second.identity)
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body freeze rejects an unpublished function root" {
  let identity = named_module_identity("fixture/checked_body_missing_root", 82)
  let module = registered("fn value() -> i64 { 7 }", identity)
  Test.assert_true(
    match complete_body(module, signatures(module), false) {
      CheckedBodyProductRejected(CheckedBodyFunctionCountMismatch(1, 0)) -> true
      _ -> false
    }
  )
}

test "checked body freeze rejects a parameter owned by another function" {
  let identity = named_module_identity("fixture/checked_body_parameter_owner", 83)
  let module = registered("fn value(input: i64) -> i64 { 7 }", identity)
  let product = signatures(module)
  let signature = product.at(0)
  let catalog = product.catalog()
  let result_type = signature_result(catalog, signature)
  let expressions = checked_expr_graph_builder(
    module.identity,
    module.source,
    catalog,
    1
  )
  let patterns = checked_pattern_graph_builder(
    expressions.segment(),
    module.source,
    catalog
  )
  let closures = checked_closure_builder(expressions, 0)
  let effects = checked_effect_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let (expressions, parameter) = expressions.binding(
    ModuleFunctionIdentity(identity, 99),
    result_type,
    range(0, 0),
    CheckedImmutableBinding
  )
  let expressions = expressions.function_parameter(parameter)
  let (expressions, root) = expressions.integer(7, result_type, range(0, 1))
  let expressions = expressions.function(signature.identity, root)

  Test.assert_true(
    match checked_body_product(
      product,
      expressions.freeze(),
      patterns.freeze(),
      closures.freeze(),
      effects.freeze(),
      propagation.freeze()
    ) {
      CheckedBodyProductRejected(CheckedBodyFunctionParameterMismatch(0, 0)) -> true
      _ -> false
    }
  )
}

test "checked body freeze requires every semantic function parameter" {
  let identity = named_module_identity("fixture/checked_body_parameter_count", 84)
  let module = registered("fn value(input: i64) -> i64 { 7 }", identity)
  Test.assert_true(
    match complete_body(module, signatures(module), true) {
      CheckedBodyProductRejected(CheckedBodyFunctionParameterCountMismatch(0, 1, 0)) -> true
      _ -> false
    }
  )
}
