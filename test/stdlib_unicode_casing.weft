use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/option.{Option}
use stdlib/test.{*}
use stdlib/unicode as unicode

test "unicode_scalar_case_mappings_cover_ascii_and_identity" {
  Test.assert_str_eq(unicode.uppercase_mapping(97).unwrap_or(""), "A")
  Test.assert_str_eq(unicode.lowercase_mapping(65).unwrap_or(""), "a")
  Test.assert_str_eq(unicode.titlecase_mapping(97).unwrap_or(""), "A")
  Test.assert_str_eq(unicode.casefold_mapping(65).unwrap_or(""), "a")
  Test.assert_str_eq(unicode.uppercase_mapping(49).unwrap_or(""), "1")
}

test "unicode_scalar_case_mappings_support full expansions" {
  Test.assert_str_eq(unicode.uppercase_mapping(223).unwrap_or(""), "SS")
  Test.assert_str_eq(unicode.titlecase_mapping(223).unwrap_or(""), "Ss")
  Test.assert_str_eq(unicode.casefold_mapping(223).unwrap_or(""), "ss")
  Test.assert_str_eq(unicode.lowercase_mapping(304).unwrap_or(""), "i̇")
  Test.assert_str_eq(unicode.casefold_mapping(304).unwrap_or(""), "i̇")
}

test "unicode_titlecase_mapping_preserves titlecase distinctions" {
  Test.assert_str_eq(unicode.uppercase_mapping(499).unwrap_or(""), "Ǳ")
  Test.assert_str_eq(unicode.titlecase_mapping(499).unwrap_or(""), "ǲ")
  Test.assert_str_eq(unicode.lowercase_mapping(497).unwrap_or(""), "ǳ")
}

test "unicode_string_case_conversion_uses full default mappings" {
  Test.assert_str_eq("Straße ﬃ".to_uppercase(), "STRASSE FFI")
  Test.assert_str_eq("WEFT İ".to_lowercase(), "weft i̇")
  Test.assert_str_eq("".to_uppercase(), "")
  Test.assert_str_eq("123".to_lowercase(), "123")
}

test "unicode_titlecase_uses default word boundaries" {
  Test.assert_str_eq("hELLO wORLD".to_titlecase(), "Hello World")
  Test.assert_str_eq("can't 32abc".to_titlecase(), "Can't 32Abc")
  Test.assert_str_eq("́hELLO".to_titlecase(), "́Hello")
  Test.assert_str_eq("".to_titlecase(), "")
}

test "unicode_titlecase_uses full mappings and lowercase context" {
  Test.assert_str_eq("ǳUNGLE".to_titlecase(), "ǲungle")
  Test.assert_str_eq("ßTRAßE".to_titlecase(), "Sstraße")
  Test.assert_str_eq("ΟΣ ΟΣΑ".to_titlecase(), "Ος Οσα")
  Test.assert_str_eq("👩‍💻wEFT".to_titlecase(), "👩‍💻Weft")
}

test "unicode_titlecase_is idempotent" {
  let text = "ǳUNGLE Straße ΟΣ 32abc".to_titlecase()
  Test.assert_str_eq(text.to_titlecase(), text)
}

test "unicode_lowercase_applies the final sigma context" {
  Test.assert_str_eq("ΟΣ".to_lowercase(), "ος")
  Test.assert_str_eq("ΟΣΑ".to_lowercase(), "οσα")
  Test.assert_str_eq("Σ".to_lowercase(), "σ")
  Test.assert_str_eq("1Σ".to_lowercase(), "1σ")
}

test "unicode_final_sigma skips case-ignorable scalars on both sides" {
  Test.assert_str_eq("ÁΣ".to_lowercase(), "áς")
  Test.assert_str_eq("AΣ́".to_lowercase(), "aς́")
  Test.assert_str_eq("AΣ́B".to_lowercase(), "aσ́b")
}

test "unicode_casefold_unifies compatibility spellings without locale tailoring" {
  Test.assert_str_eq("Straße".casefold(), "strasse")
  Test.assert_str_eq("ΟΣ ςσ".casefold(), "οσ σσ")
  Test.assert_str_eq("Iİıi".casefold(), "ii̇ıi")
}

test "unicode_caseless_equality includes canonical equivalence" {
  Test.assert_true("Straße".caseless_eq("STRASSE"))
  Test.assert_true("Å".caseless_eq("å"))
  Test.assert_true("café".caseless_eq("CAFÉ"))
  Test.assert_false("weft".caseless_eq("warp"))
}

test "unicode_default casing is explicitly non-Turkic" {
  Test.assert_str_eq("Iİıi".to_lowercase(), "ii̇ıi")
  Test.assert_str_eq("Iİıi".to_uppercase(), "IİII")
}

test "unicode_case_conversion covers supplementary scalars" {
  Test.assert_str_eq("𐐨".to_uppercase(), "𐐀")
  Test.assert_str_eq("𐐀".to_lowercase(), "𐐨")
  Test.assert_str_eq("𐐀".casefold(), "𐐨")
}

test "unicode_case_conversion_is_idempotent" {
  let text = "Straße İ ΟΣ 𐐨"
  let upper = text.to_uppercase()
  let lower = text.to_lowercase()
  let folded = text.casefold()
  Test.assert_str_eq(upper.to_uppercase(), upper)
  Test.assert_str_eq(lower.to_lowercase(), lower)
  Test.assert_str_eq(folded.casefold(), folded)
}

test "unicode_case_mappings_reject invalid scalars and malformed text" {
  Test.assert_true(unicode.uppercase_mapping(0 - 1).is_none())
  Test.assert_true(unicode.lowercase_mapping(55296).is_none())
  Test.assert_true(unicode.casefold_mapping(1114112).is_none())
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_str_eq(text.to_uppercase(), "")
  Test.assert_str_eq(text.to_lowercase(), "")
  Test.assert_str_eq(text.to_titlecase(), "")
  Test.assert_str_eq(text.casefold(), "")
  Test.assert_false(text.caseless_eq(""))
}
