use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}
use stdlib/unicode.{*}

test "unicode_scalar_case_mappings_cover_ascii_and_identity" {
  Test.assert_str_eq(unicode_uppercase_mapping(97), "A")
  Test.assert_str_eq(unicode_lowercase_mapping(65), "a")
  Test.assert_str_eq(unicode_titlecase_mapping(97), "A")
  Test.assert_str_eq(unicode_casefold_mapping(65), "a")
  Test.assert_str_eq(unicode_uppercase_mapping(49), "1")
}

test "unicode_scalar_case_mappings_support full expansions" {
  Test.assert_str_eq(unicode_uppercase_mapping(223), "SS")
  Test.assert_str_eq(unicode_titlecase_mapping(223), "Ss")
  Test.assert_str_eq(unicode_casefold_mapping(223), "ss")
  Test.assert_str_eq(unicode_lowercase_mapping(304), "i̇")
  Test.assert_str_eq(unicode_casefold_mapping(304), "i̇")
}

test "unicode_titlecase_mapping_preserves titlecase distinctions" {
  Test.assert_str_eq(unicode_uppercase_mapping(499), "Ǳ")
  Test.assert_str_eq(unicode_titlecase_mapping(499), "ǲ")
  Test.assert_str_eq(unicode_lowercase_mapping(497), "ǳ")
}

test "unicode_string_case_conversion_uses full default mappings" {
  Test.assert_str_eq(unicode_to_uppercase("Straße ﬃ"), "STRASSE FFI")
  Test.assert_str_eq(unicode_to_lowercase("WEFT İ"), "weft i̇")
  Test.assert_str_eq(unicode_to_uppercase(""), "")
  Test.assert_str_eq(unicode_to_lowercase("123"), "123")
}

test "unicode_lowercase_applies the final sigma context" {
  Test.assert_str_eq(unicode_to_lowercase("ΟΣ"), "ος")
  Test.assert_str_eq(unicode_to_lowercase("ΟΣΑ"), "οσα")
  Test.assert_str_eq(unicode_to_lowercase("Σ"), "σ")
  Test.assert_str_eq(unicode_to_lowercase("1Σ"), "1σ")
}

test "unicode_final_sigma skips case-ignorable scalars on both sides" {
  Test.assert_str_eq(unicode_to_lowercase("ÁΣ"), "áς")
  Test.assert_str_eq(unicode_to_lowercase("AΣ́"), "aς́")
  Test.assert_str_eq(unicode_to_lowercase("AΣ́B"), "aσ́b")
}

test "unicode_casefold_unifies compatibility spellings without locale tailoring" {
  Test.assert_str_eq(unicode_casefold("Straße"), "strasse")
  Test.assert_str_eq(unicode_casefold("ΟΣ ςσ"), "οσ σσ")
  Test.assert_str_eq(unicode_casefold("Iİıi"), "ii̇ıi")
}

test "unicode_caseless_equality includes canonical equivalence" {
  Test.assert_eq(unicode_caseless_equal("Straße", "STRASSE"), 1)
  Test.assert_eq(unicode_caseless_equal("Å", "å"), 1)
  Test.assert_eq(unicode_caseless_equal("café", "CAFÉ"), 1)
  Test.assert_eq(unicode_caseless_equal("weft", "warp"), 0)
}

test "unicode_default casing is explicitly non-Turkic" {
  Test.assert_str_eq(unicode_to_lowercase("Iİıi"), "ii̇ıi")
  Test.assert_str_eq(unicode_to_uppercase("Iİıi"), "IİII")
}

test "unicode_case_conversion covers supplementary scalars" {
  Test.assert_str_eq(unicode_to_uppercase("𐐨"), "𐐀")
  Test.assert_str_eq(unicode_to_lowercase("𐐀"), "𐐨")
  Test.assert_str_eq(unicode_casefold("𐐀"), "𐐨")
}

test "unicode_case_conversion_is_idempotent" {
  let text = "Straße İ ΟΣ 𐐨"
  let upper = unicode_to_uppercase(text)
  let lower = unicode_to_lowercase(text)
  let folded = unicode_casefold(text)
  Test.assert_str_eq(unicode_to_uppercase(upper), upper)
  Test.assert_str_eq(unicode_to_lowercase(lower), lower)
  Test.assert_str_eq(unicode_casefold(folded), folded)
}

test "unicode_case_mappings_reject invalid scalars and malformed text" {
  Test.assert_str_eq(unicode_uppercase_mapping(0 - 1), "")
  Test.assert_str_eq(unicode_lowercase_mapping(55296), "")
  Test.assert_str_eq(unicode_casefold_mapping(1114112), "")
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_str_eq(unicode_to_uppercase(text), "")
  Test.assert_str_eq(unicode_to_lowercase(text), "")
  Test.assert_str_eq(unicode_casefold(text), "")
  Test.assert_eq(unicode_caseless_equal(text, ""), 0)
}
