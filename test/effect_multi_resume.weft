-- Effect with multiple performs: handler is called twice
-- Expected exit code: 7
effect State {
  fn get() -> Int
  fn put(val: Int) -> Int
}

fn stateful() -> Int {
  let a = State.get()
  let _ = State.put(a + 10)
  State.get()
}

fn main() {
  handle stateful() {
    State.get() -> resume(7)
    State.put(val) -> resume(0)
  }
}
