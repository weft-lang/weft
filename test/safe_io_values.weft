use stdlib/bytes.{*}
use stdlib/io/types.{*}
use stdlib/num.{*}
use stdlib/option.{*}
use stdlib/path.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

fn byte(value: i64) -> u8 {
  num_int_cast_value_or<u8>(num_i64_to_u8_checked(value), 0)
}

fn byte_or(values: Bytes, index: i64, default: i64) -> i64 {
  match bytes_get(values, index) {
    Some(value) -> num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_u8_to_u64(value)), default)
    None -> default
  }
}

fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn path_or(result: Result<Path, PathError>) -> Path {
  match result {
    Ok(path) -> path
    Err(error) -> match path_from_utf8("") { Ok(empty) -> empty Err(other) -> empty_path_fallback() }
  }
}

fn empty_path_fallback() -> Path {
  match path_from_bytes(bytes_empty()) {
    Ok(path) -> path
    Err(error) -> empty_path_fallback()
  }
}

fn path_error_or(result: Result<Path, PathError>) -> PathError {
  match result {
    Ok(path) -> PathInvalidUtf8(0 - 1)
    Err(error) -> error
  }
}

fn text_or(result: Result<str, Utf8Error>, default: str) -> str {
  match result {
    Ok(text) -> text
    Err(error) -> default
  }
}

fn path_text_or(result: Result<str, PathError>, default: str) -> str {
  match result {
    Ok(text) -> text
    Err(error) -> default
  }
}

fn read_kind_or(result: Result<IoReadProgress, IoError>, default: i64) -> i64 {
  match result {
    Ok(progress) -> io_read_progress_kind(progress)
    Err(error) -> default
  }
}

fn read_count_or(result: Result<IoReadProgress, IoError>, default: i64) -> i64 {
  match result {
    Ok(progress) -> io_read_progress_count_or(progress, default)
    Err(error) -> default
  }
}

fn write_count_or(result: Result<IoWriteProgress, IoError>, default: i64) -> i64 {
  match result {
    Ok(progress) -> io_write_progress_count(progress)
    Err(error) -> default
  }
}

fn io_error_or<T>(result: Result<T, IoError>) -> IoError {
  match result {
    Ok(value) -> IoPlatform(0 - 1)
    Err(error) -> error
  }
}

test "bytes_preserve_nul_high_bytes_and_bounds" {
  let source = vector_new<u8>()
  vector_push<u8>(source, byte(0))
  vector_push<u8>(source, byte(127))
  vector_push<u8>(source, byte(255))
  let values = bytes_from_vector(source)
  Test.assert_eq(bytes_len(values), 3)
  Test.assert_eq(byte_or(values, 0, 999), 0)
  Test.assert_eq(byte_or(values, 1, 999), 127)
  Test.assert_eq(byte_or(values, 2, 999), 255)
  Test.assert_eq(byte_or(values, -1, 999), 999)
  Test.assert_eq(byte_or(values, 3, 999), 999)
}

test "bytes_copy_seals_mutable_source_and_result" {
  let source = vector_new<u8>()
  vector_push<u8>(source, byte(10))
  vector_push<u8>(source, byte(20))
  let values = bytes_from_vector(source)
  vector_set<u8>(source, 0, byte(99))
  let copy = bytes_to_vector(values)
  vector_set<u8>(copy, 1, byte(88))
  Test.assert_eq(byte_or(values, 0, 0), 10)
  Test.assert_eq(byte_or(values, 1, 0), 20)
}

test "bytes_utf8_roundtrips_unicode_text" {
  let values = bytes_from_str("héλlo")
  Test.assert_eq(bytes_utf8_error_offset(values), 0 - 1)
  Test.assert_str_eq(text_or(bytes_to_utf8(values), "bad"), "héλlo")
}

test "bytes_utf8_rejects_malformed_sequence_at_exact_offset" {
  let raw = vector_new<u8>()
  vector_push<u8>(raw, byte(65))
  vector_push<u8>(raw, byte(195))
  vector_push<u8>(raw, byte(40))
  let values = bytes_from_vector(raw)
  Test.assert_eq(bytes_utf8_error_offset(values), 1)
  match bytes_to_utf8(values) {
    Ok(text) -> Test.assert_eq(0, 1)
    Err(error) -> Test.assert_eq(utf8_error_offset_or(error, 99), 1)
  }
}

test "bytes_empty_and_equality_are_structural" {
  let empty = bytes_empty()
  let same = bytes_from_str("")
  let other = bytes_from_str("x")
  Test.assert_true(bytes_is_empty(empty))
  Test.assert_true(bytes_equal(empty, same))
  Test.assert_false(bytes_equal(empty, other))
}

test "bytes_from_slice_copies_fixed_array_and_remains_sendable" {
  let mut source = [byte(1), byte(2), byte(3)]
  let values = require_sendable<Bytes>(bytes_from_slice(source[..]))
  source[0] = byte(9)
  Test.assert_eq(byte_or(values, 0, 0), 1)
  Test.assert_eq(bytes_len(values), 3)
}

test "path_accepts_empty_root_relative_and_unicode_forms" {
  let empty = path_or(path_from_utf8(""))
  let root = path_or(path_from_utf8("/"))
  let relative = path_or(path_from_utf8("tmp/δ"))
  let absolute = path_or(path_from_utf8("/tmp/δ"))
  Test.assert_true(path_is_empty(empty))
  Test.assert_true(path_is_root(root))
  Test.assert_false(path_is_absolute(relative))
  Test.assert_true(path_is_absolute(absolute))
  Test.assert_str_eq(path_text_or(path_to_utf8(absolute), "bad"), "/tmp/δ")
}

test "path_rejects_embedded_nul_with_exact_offset" {
  let raw = vector_new<u8>()
  vector_push<u8>(raw, byte(97))
  vector_push<u8>(raw, byte(0))
  vector_push<u8>(raw, byte(98))
  let error = path_error_or(path_from_vector(raw))
  Test.assert_eq(path_error_kind(error), 1)
  Test.assert_eq(path_error_offset_or(error, 99), 1)
}

test "path_preserves_non_utf8_identity_but_display_is_fallible" {
  let raw = vector_new<u8>()
  vector_push<u8>(raw, byte(102))
  vector_push<u8>(raw, byte(255))
  let path = path_or(path_from_vector(raw))
  Test.assert_eq(path_len(path), 2)
  match path_to_utf8(path) {
    Ok(text) -> Test.assert_eq(0, 1)
    Err(error) -> {
      Test.assert_eq(path_error_kind(error), 2)
      Test.assert_eq(path_error_offset_or(error, 99), 1)
    }
  }
}

test "path_equality_uses_native_bytes" {
  let left = path_or(path_from_utf8("a/b"))
  let same = path_or(path_from_utf8("a/b"))
  let other = path_or(path_from_utf8("a//b"))
  let dot = path_or(path_from_utf8("a/./b"))
  let sendable = require_sendable<Path>(left)
  Test.assert_true(path_equal(sendable, same))
  Test.assert_false(path_equal(left, other))
  Test.assert_false(path_equal(left, dot))
}

test "io_error_classifies_portable_errno_families" {
  Test.assert_eq(io_error_kind(io_error_from_errno(4)), 1)
  Test.assert_eq(io_error_kind(io_error_from_errno(-11)), 2)
  Test.assert_eq(io_error_kind(io_error_from_errno(2)), 3)
  Test.assert_eq(io_error_kind(io_error_from_errno(13)), 4)
  Test.assert_eq(io_error_kind(io_error_from_errno(17)), 5)
  Test.assert_eq(io_error_kind(io_error_from_errno(21)), 6)
  Test.assert_eq(io_error_kind(io_error_from_errno(22)), 7)
  let unknown = io_error_from_errno(-777)
  Test.assert_eq(io_error_kind(unknown), 8)
  Test.assert_eq(io_error_platform_code_or(unknown, 0), 777)
  let normalized_unknown = io_error_from_errno(0 - 8192 - 35)
  Test.assert_eq(io_error_kind(normalized_unknown), 8)
  Test.assert_eq(io_error_platform_code_or(normalized_unknown, 0), 35)
}

test "io_read_progress_distinguishes_partial_eof_and_errors" {
  let partial = io_read_progress_from_status(3)
  let eof = io_read_progress_from_status(0)
  let interrupted = io_read_progress_from_status(-4)
  Test.assert_eq(read_kind_or(partial, 0), 1)
  Test.assert_eq(read_count_or(partial, 0), 3)
  Test.assert_eq(read_kind_or(eof, 0), 2)
  Test.assert_eq(io_error_kind(io_error_or<IoReadProgress>(interrupted)), 1)
}

test "io_write_progress_preserves_zero_partial_and_errors" {
  Test.assert_eq(write_count_or(io_write_progress_from_status(0), 99), 0)
  Test.assert_eq(write_count_or(io_write_progress_from_status(7), 0), 7)
  Test.assert_eq(io_error_kind(io_error_or<IoWriteProgress>(io_write_progress_from_status(-13))), 4)
}
