fn prelude_fail() -[Fail<str>]> i64 {
  Fail.fail("failed")
}

fn prelude_maybe() -[Maybe]> i64 {
  Maybe.none()
}

test "implicit prelude exposes exact core data shapes" {
  let option: Option<i64> = Some<i64>(40)
  let result: Result<i64, str> = Ok<i64, str>(2)
  let list: List<i64> = Cons<i64>(1, Nil<i64>())
  match option {
    Some(value) -> match result {
      Ok(extra) -> match list {
        Cons(head, rest) -> Test.assert_eq(value + extra + head, 43)
        Nil -> Test.assert_true(false)
      }
      Err(message) -> Test.assert_true(false)
    }
    None -> Test.assert_true(false)
  }
}

test "implicit prelude exposes Fail and Maybe effects" {
  let failed = handle prelude_fail() {
    Fail.fail(message) -> 7
    return value -> value
  }
  let absent = handle prelude_maybe() {
    Maybe.none() -> 9
    return value -> value
  }
  Test.assert_eq(failed, 7)
  Test.assert_eq(absent, 9)
}
