-- Managed rvalue receivers remain caller-owned when `self` is borrowed.

use runtime/rc_implicit_test.{*}
use runtime/rc.{rc_count}
use runtime/string as runtime_string
use runtime/vector_storage.{vector_storage_handle_word}
use stdlib/option.{*}
use stdlib/test.{Test}
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn borrowed_vector_len_method_rc_delta(values: borrow Vector<i64>) -> i64 {
  let before = rc_count(vector_storage_handle_word<i64>(values))
  values.len()
  rc_count(vector_storage_handle_word<i64>(values)) - before
}

fn borrowed_vector_get_method_rc_delta(values: borrow Vector<i64>) -> i64 {
  let before = rc_count(vector_storage_handle_word<i64>(values))
  values.get(0)
  rc_count(vector_storage_handle_word<i64>(values)) - before
}

fn qualified_managed_result_round() -> i64 {
  runtime_string.runtime_int_to_str(123456).len()
}

fn qualified_managed_result_reclaim_delta() -> i64 {
  for iteration in 0..50 { qualified_managed_result_round() }
  let before = runtime_rc_test_heap_arena_offset()
  for iteration in 0..200 { qualified_managed_result_round() }
  runtime_rc_test_heap_arena_offset() - before
}

fn method_receiver_direct_match(value: RuntimeRcProbe) -> RuntimeRcProbe {
  match Some<RuntimeRcProbe>(value) {
    Some(item) -> item
    None -> value
  }
}

fn method_receiver_unwrap(value: RuntimeRcProbe) -> RuntimeRcProbe {
  Some<RuntimeRcProbe>(value).unwrap()
}

fn method_receiver_cfg_unwrap(value: RuntimeRcProbe, first: bool) -> RuntimeRcProbe {
  (if first { Some<RuntimeRcProbe>(value) } else { Some<RuntimeRcProbe>(value) }).unwrap()
}

fn method_receiver_scalar_unwrap_many() -> i64 {
  let mut total = 0
  for i in 0..32 {
    total = total + Some<i64>(i).unwrap_or(0)
  }
  total
}

type NestedMethodReceiverBox { value: RuntimeRcProbe }

impl NestedMethodReceiverBox {
  fn value_option(self) -> Option<RuntimeRcProbe> {
    Some<RuntimeRcProbe>(self.value)
  }

  fn has_value(self) -> bool {
    match self.value_option() {
      Some(value) -> true
      None -> false
    }
  }
}

test "direct managed option match returns one owned stake" {
  let value = runtime_rc_probe_new(1)
  let result = method_receiver_direct_match(value)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
}

test "managed rvalue method receiver releases its temporary" {
  let value = runtime_rc_probe_new(2)
  let result = method_receiver_unwrap(value)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
}

test "managed cfg method receiver releases either temporary" {
  let left = runtime_rc_probe_new(3)
  let left_result = method_receiver_cfg_unwrap(left, true)
  Test.assert_eq(runtime_rc_probe_count(left_result), 2)

  let right = runtime_rc_probe_new(4)
  let right_result = method_receiver_cfg_unwrap(right, false)
  Test.assert_eq(runtime_rc_probe_count(right_result), 2)
}

test "managed method receivers returning scalars reclaim their storage" {
  Test.assert_eq(method_receiver_scalar_unwrap_many(), 496)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(method_receiver_scalar_unwrap_many(), 496)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "nested methods receive an owned transport stake for borrowed receivers" {
  let value = runtime_rc_probe_new(5)
  let box = NestedMethodReceiverBox { value: value }
  let before = runtime_rc_probe_count(value)
  for i in 0..8 {
    Test.assert_true(box.has_value())
  }
  Test.assert_eq(runtime_rc_probe_count(value), before)
}

test "nested methods retain borrowed receivers selected by control flow" {
  let left = runtime_rc_probe_new(6)
  let right = runtime_rc_probe_new(7)
  let left_box = NestedMethodReceiverBox { value: left }
  let right_box = NestedMethodReceiverBox { value: right }
  let left_before = runtime_rc_probe_count(left)
  let right_before = runtime_rc_probe_count(right)
  Test.assert_true((if true { left_box } else { right_box }).has_value())
  Test.assert_true((if false { left_box } else { right_box }).has_value())
  Test.assert_eq(runtime_rc_probe_count(left), left_before)
  Test.assert_eq(runtime_rc_probe_count(right), right_before)
}

test "forwarded borrowed method receivers create no managed stake" {
  let mut values = vector.new<i64>()
  values.push(42)

  Test.assert_eq(borrowed_vector_len_method_rc_delta(values), 0)
  Test.assert_eq(borrowed_vector_get_method_rc_delta(values), 0)
}

test "qualified managed results used as method receivers are reclaimed" {
  Test.assert_eq(qualified_managed_result_reclaim_delta(), 0)
}
