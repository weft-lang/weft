-- Managed rvalue receivers remain caller-owned when `self` is borrowed.

use runtime/rc_implicit_test.{*}
use stdlib/option.{*}
use stdlib/test.{Test}

fn method_receiver_direct_match(value: RuntimeRcProbe) -> RuntimeRcProbe {
  match Some<RuntimeRcProbe>(value) {
    Some(item) -> item
    None -> value
  }
}

fn method_receiver_unwrap(value: RuntimeRcProbe) -> RuntimeRcProbe {
  Some<RuntimeRcProbe>(value).unwrap()
}

fn method_receiver_cfg_unwrap(value: RuntimeRcProbe, first: bool) -> RuntimeRcProbe {
  (if first { Some<RuntimeRcProbe>(value) } else { Some<RuntimeRcProbe>(value) }).unwrap()
}

test "direct managed option match returns one owned stake" {
  let value = runtime_rc_probe_new(1)
  let result = method_receiver_direct_match(value)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
}

test "managed rvalue method receiver releases its temporary" {
  let value = runtime_rc_probe_new(2)
  let result = method_receiver_unwrap(value)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
}

test "managed cfg method receiver releases either temporary" {
  let left = runtime_rc_probe_new(3)
  let left_result = method_receiver_cfg_unwrap(left, true)
  Test.assert_eq(runtime_rc_probe_count(left_result), 2)

  let right = runtime_rc_probe_new(4)
  let right_result = method_receiver_cfg_unwrap(right, false)
  Test.assert_eq(runtime_rc_probe_count(right_result), 2)
}
