use stdlib/eq.{Eq}
use stdlib/list.{List, Cons, Nil}
use stdlib/drop.{Drop}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}
use stdlib/option.{Option, Some, None}

type Value = i64 | str
type Id = i64
type Pair<T> = (T, T)
type Nested<T> = Option<Pair<T>>
type Comparable<T: Eq> = T
type BoundedPair<T: Eq> = Pair<Comparable<T>>
type UnusedBound<T: Eq> = i64
type Flag = i64 & bool
type NotText = ~str
type Triple = [i64; 3]
type Numbers = [i64]
type NumberList = List<i64>
type Callback<E> = (i64) -[E]> i64
type LocalRecord { value: i64 }
type RecordName = LocalRecord
type Secret = opaque i64
type SecretName = Secret
type ResourceToken = opaque(i64, i64)
type Resource = owned ResourceToken

impl Drop for ResourceToken {
  fn drop(self) -> nil {
    match self {
      ResourceToken((log, digit)) -> {
        defer_order_log_write(log, defer_order_log_read(log) * 10 + digit)
        nil
      }
    }
  }
}

trait AliasReading { fn read_alias(self) -> i64 }
impl AliasReading for RecordName {
  fn read_alias(self) -> i64 { self.value }
}

impl LocalRecord { fn answer() -> i64 { 42 } }

impl Eq for LocalRecord {
  fn eq(self, other: Self) -> bool { self.value == other.value }
}

fn alias_id(value: Id) -> Id { value }
fn alias_value(value: Value) -> Value { value }
fn accepts_value(value: Value) -> i64 { 42 }
fn alias_first<T>(pair: Pair<T>) -> T { pair.0 }
fn bounded_first<T: Eq>(pair: BoundedPair<T>) -> T { pair.0 }
fn alias_flag(value: Flag) -> bool { not value }
fn accepts_non_text(value: NotText) -> i64 { 7 }
fn alias_record(value: RecordName) -> RecordName { value }
fn alias_secret(value: SecretName) -> Secret { value }
fn make_secret(value: i64) -> Secret { Secret(value) }
fn secret_value(value: Secret) -> i64 { match value { Secret(inner) -> inner } }
fn alias_length(values: Numbers) -> usize { values.len }
fn alias_resource(value: Resource) -> Resource { value }
fn consume_alias_resource(value: Resource) -> i64 { 42 }
fn early_alias_resource(log: i64) -> i64 {
  let value: Resource = ResourceToken((log, 7))
  return 42
}

effect ReadNumber { fn read() -> i64 }
type FixedCallback = (i64) -[ReadNumber]> i64
fn read_number(value: i64) -[ReadNumber]> i64 { ReadNumber.read() + value }
fn add_one(value: i64) -> i64 { value + 1 }
fn apply_alias<A, E>(ignored: A, callback: Callback<E>) -[E]> i64 { callback(1) }
fn apply_fixed(callback: FixedCallback) -[ReadNumber]> i64 { callback(2) }
fn forward_alias<E, A>(callback: Callback<E>, ignored: A) -[E]> i64 { apply_alias(ignored, callback) }

test "primitive names are transparent in parameters results and local annotations" {
  let value: Id = 42
  Test.assert_eq(alias_id(value), 42)
  Test.assert_eq(alias_id(0), 0)
  Test.assert_eq(alias_id(-7), -7)
}

test "union names accept every member and preserve the union in results" {
  Test.assert_eq(accepts_value(alias_value(7)), 42)
  Test.assert_eq(accepts_value(alias_value("text")), 42)
}

test "intersection and complement names preserve their existing value sets" {
  Test.assert_false(alias_flag(true))
  Test.assert_true(alias_flag(false))
  Test.assert_eq(accepts_non_text(42), 7)
}

test "generic tuple names substitute all component types" {
  Test.assert_eq(alias_first((42, 8)), 42)
  Test.assert_str_eq(alias_first(("first", "second")), "first")
  Test.assert_false(alias_first((false, true)))
}

test "nested generic names preserve tagged payloads including zero" {
  let present: Nested<i64> = Some<Pair<i64>>((0, 9))
  match present {
    Some(pair) -> { Test.assert_eq(pair.0, 0) Test.assert_eq(pair.1, 9) }
    None -> Test.assert_true(false)
  }
  let absent: Nested<str> = None<Pair<str>>()
  match absent { Some(pair) -> Test.assert_true(false), None -> Test.assert_true(true) }
}

test "bounded aliases carry caller constraints through nested substitution" {
  Test.assert_eq(bounded_first((42, 8)), 42)
  Test.assert_str_eq(bounded_first(("a", "b")), "a")
  let unused: UnusedBound<i64> = 9
  Test.assert_eq(unused, 9)
}

test "nominal names preserve fields and canonical trait implementations" {
  let value: RecordName = LocalRecord { value: 42 }
  Test.assert_eq(alias_record(value).value, 42)
  Test.assert_true(value == LocalRecord { value: 42 })
  Test.assert_false(value == LocalRecord { value: 7 })
  Test.assert_eq(value.read_alias(), 42)
  Test.assert_eq(RecordName.answer(), 42)
}

test "aliases of opaque values preserve the existing opaque identity" {
  Test.assert_eq(secret_value(alias_secret(make_secret(42))), 42)
  Test.assert_eq(secret_value(alias_secret(make_secret(0))), 0)
}

test "array slice and recursive collection names retain their representations" {
  let values: Triple = [4, 5, 6]
  let slice: Numbers = values[0..3]
  Test.assert_eq_usize(alias_length(slice), 3)
  Test.assert_eq(values[1], 5)
  let list: NumberList = Cons<i64>(0, Nil<i64>())
  match list { Cons(head, tail) -> Test.assert_eq(head, 0), Nil -> Test.assert_true(false) }
}

test "callback names preserve purity and renamed effect parameters" {
  Test.assert_eq(apply_alias("ignored", add_one), 2)
  let value = handle apply_alias(0, read_number) { ReadNumber.read() -> resume(41) }
  Test.assert_eq(value, 42)
  let forwarded = handle forward_alias(read_number, "ignored") { ReadNumber.read() -> resume(8) }
  Test.assert_eq(forwarded, 9)
}

test "fixed callback names preserve exact handler requirements" {
  let value = handle apply_fixed(read_number) { ReadNumber.read() -> resume(40) }
  Test.assert_eq(value, 42)
}

test "owned aliases preserve moves and exactly one drop" {
  let log = defer_order_log_new()
  let value: Resource = ResourceToken((log, 3))
  let moved = alias_resource(value)
  Test.assert_eq(defer_order_log_read(log), 0)
  Test.assert_eq(consume_alias_resource(moved), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "owned aliases preserve cleanup on early return" {
  let log = defer_order_log_new()
  Test.assert_eq(early_alias_resource(log), 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

impl RecordName { fn double(self) -> i64 { self.value * 2 } }

test "inherent methods declared through aliases belong to the underlying type" {
  let value = LocalRecord { value: 21 }
  let named: RecordName = value
  Test.assert_eq(value.double(), 42)
  Test.assert_eq(named.double(), 42)
}

type Compact<T>=(T,T)

test "type argument closes separate from assignments without changing comparisons" {
  let pair: Compact<i64>=(20,22)
  Test.assert_eq(pair.0 + pair.1, 42)
  Test.assert_true(pair.1>=pair.0)
  Test.assert_false(pair.0>=pair.1)
}
