use compiler/ir.{*}
use stdlib/test.{Test}

fn completion_of(body: Expr) -> HandlerClauseCompletion {
  handler_clause_completion(HandlerClause(UnknownHandlerClauseName, ParamListNil, body, HandlerClauseNoContinuation))
}

test "completion facts distinguish abort resume and mixed conditional exits" {
  let value = IntLit(4, 0, 0)
  Test.assert_true(match completion_of(value) { HandlerClauseAborts -> true, _ -> false })
  Test.assert_true(match completion_of(Resume(value)) { HandlerClauseResumes -> true, _ -> false })
  Test.assert_true(match completion_of(If(Ident(0, 1), Resume(value), value)) { HandlerClauseMixed -> true, _ -> false })
  Test.assert_true(match completion_of(If(Ident(0, 1), value, Resume(value))) { HandlerClauseMixed -> true, _ -> false })
  Test.assert_true(match completion_of(If(Ident(0, 1), Resume(value), Resume(value))) { HandlerClauseResumes -> true, _ -> false })
}

test "completion sequencing retains earlier exits and excludes unreachable tails" {
  let value = IntLit(4, 0, 0)
  Test.assert_true(match completion_of(Block(Return(value), Resume(value))) { HandlerClauseAborts -> true, _ -> false })
  Test.assert_true(match completion_of(Block(Resume(value), Return(value))) { HandlerClauseResumes -> true, _ -> false })
  Test.assert_true(match completion_of(Block(If(Ident(0, 1), Return(value), NilExpr), Resume(value))) { HandlerClauseMixed -> true, _ -> false })
  Test.assert_true(match completion_of(Resume(Return(value))) { HandlerClauseAborts -> true, _ -> false })
}

test "completion facts keep loop and nested prompt outcomes conservative" {
  let value = IntLit(4, 0, 0)
  Test.assert_true(match completion_of(While(Ident(0, 1), Resume(value))) { HandlerClauseMixed -> true, _ -> false })
  Test.assert_true(match completion_of(Block(While(Ident(0, 1), NilExpr), Resume(value))) { HandlerClauseResumes -> true, _ -> false })
  Test.assert_true(match completion_of(UnknownExpr(999)) { HandlerClauseMixed -> true, _ -> false })
  let flow = handler_body_flow(Lambda(ParamListNil, Return(value), 0))
  Test.assert_true(flow.continues and not flow.returns and not flow.resumes)
}
