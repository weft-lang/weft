-- deferred continuations ground-truth pins for the typed-IR cleanup facts consumed by dynamic-wind cleanup.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/module.{module_decl_fact_find, module_decl_fact_native_key_or, module_decl_namespace_value}
use compiler/pipeline.{*}
use compiler/lib.{*}
use compiler/type_registry.{*}

fn suspended_cleanup_metric_fact_summary(facts: i64) -> i64 {
  let mut rc = 0
  let mut closures = 0
  let mut owned = 0
  let mut i = 0
  while i < nlist_len(facts) {
    let fact = nlist_get(facts, i)
    if node_f2(fact) == pipeline_rc_default_release_hash() { rc = rc + 1 }
    else { if node_f2(fact) == pipeline_closure_default_release_hash() { closures = closures + 1 }
    else { if node_f3(fact) == pipeline_ir_abort_cleanup_owned_kind() { owned = owned + 1 } else { 0 } } }
    i = i + 1
  }
  nlist_len(facts) * 10000 + rc * 100 + closures * 10 + owned
}

fn suspended_cleanup_metric_fact_word(fact: i64) -> i64 {
  let action = if node_f2(fact) == pipeline_rc_default_release_hash() { 1 }
  else { if node_f2(fact) == pipeline_closure_default_release_hash() { 2 } else { 9 } }
  node_tag(fact) * 1000000 + node_f1(fact) * 1000 + action * 10 + node_f3(fact)
}

fn suspended_cleanup_metric_defer_calls_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrCallI64(dst, callee_hash, args) -> if callee_hash == pipeline_runtime_defer_abort_cleanup_hash() { 1 } else { 0 }
        IrIndirectCallI64(dst, callee, args) -> 100
        _ -> 0
      }
      here + suspended_cleanup_metric_defer_calls_insts(rest)
    }
  }
}

fn suspended_cleanup_metric_defer_calls_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> suspended_cleanup_metric_defer_calls_insts(insts) + suspended_cleanup_metric_defer_calls_blocks(rest)
    }
  }
}

fn suspended_cleanup_metric_defer_calls(ir: IrModule, fn_name: str) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> suspended_cleanup_metric_defer_calls_blocks(pipeline_ir_function_blocks(fn_ir))
  }
}

fn suspended_cleanup_metric_effect_transfers_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrStructuralSlotI64(value, slot, plan, mode) -> if mode == 3 { 1 } else { 0 }
        _ -> 0
      }
      here + suspended_cleanup_metric_effect_transfers_insts(rest)
    }
  }
}

fn suspended_cleanup_metric_effect_transfers_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> suspended_cleanup_metric_effect_transfers_insts(insts) +
        suspended_cleanup_metric_effect_transfers_blocks(rest)
    }
  }
}

fn suspended_cleanup_metric_effect_transfers(ir: IrModule, fn_name: str) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> suspended_cleanup_metric_effect_transfers_blocks(pipeline_ir_function_blocks(fn_ir))
  }
}

fn suspended_cleanup_metric_owned_drops_clauses(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let here = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> suspended_cleanup_metric_owned_drops_blocks(blocks)
        IrHandlerClauseBodyInvalid(reason) -> 1000
      }
      here + suspended_cleanup_metric_owned_drops_clauses(rest)
    }
  }
}

fn suspended_cleanup_metric_owned_drops_deferred(body: IrDeferredHandlerBody) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> suspended_cleanup_metric_owned_drops_blocks(blocks)
    IrDeferredHandlerBodyInvalid(reason) -> 1000
  }
}

fn suspended_cleanup_metric_owned_drops_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrOwnedDropI64(value, type_hash) -> 1
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> suspended_cleanup_metric_owned_drops_clauses(clauses)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> suspended_cleanup_metric_owned_drops_deferred(body) + suspended_cleanup_metric_owned_drops_clauses(clauses)
        _ -> 0
      }
      here + suspended_cleanup_metric_owned_drops_insts(rest)
    }
  }
}

fn suspended_cleanup_metric_owned_drops_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> suspended_cleanup_metric_owned_drops_insts(insts) +
        suspended_cleanup_metric_owned_drops_blocks(rest)
    }
  }
}

fn suspended_cleanup_metric_owned_drops(ir: IrModule, fn_name: str) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> suspended_cleanup_metric_owned_drops_blocks(pipeline_ir_function_blocks(fn_ir))
  }
}

fn suspended_cleanup_metric_abort_owned_facts_clauses(
  clauses: IrHandlerClauseBodyList,
  fns: i64,
  tt: i64
) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let here = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> suspended_cleanup_metric_abort_owned_facts_blocks(blocks, fns, tt)
        IrHandlerClauseBodyInvalid(reason) -> 1000
      }
      here + suspended_cleanup_metric_abort_owned_facts_clauses(rest, fns, tt)
    }
  }
}

fn suspended_cleanup_metric_abort_owned_facts_deferred(
  body: IrDeferredHandlerBody,
  fns: i64,
  tt: i64
) -> i64 {
  match body {
    IrDeferredHandlerBody(body_src, captures, ops_value, result_lanes, first_value, blocks, completion) -> suspended_cleanup_metric_abort_owned_facts_blocks(blocks, fns, tt)
    IrDeferredHandlerBodyInvalid(reason) -> 1000
  }
}

fn suspended_cleanup_metric_abort_owned_facts_insts(
  insts: IrInstList,
  fns: i64,
  tt: i64
) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> suspended_cleanup_metric_abort_owned_facts_clauses(clauses, fns, tt)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> suspended_cleanup_metric_abort_owned_facts_deferred(body, fns, tt) + suspended_cleanup_metric_abort_owned_facts_clauses(clauses, fns, tt)
        _ -> 0
      }
      here + suspended_cleanup_metric_abort_owned_facts_insts(rest, fns, tt)
    }
  }
}

fn suspended_cleanup_metric_abort_owned_facts_blocks(
  blocks: IrBlockList,
  fns: i64,
  tt: i64
) -> i64 {
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns, tt)
  let mut owned = 0
  let mut i = 0
  while i < nlist_len(facts) {
    if node_f3(nlist_get(facts, i)) == pipeline_ir_abort_cleanup_owned_kind() {
      owned = owned + 1
    } else { 0 }
    i = i + 1
  }
  owned + suspended_cleanup_metric_abort_owned_facts_nested_blocks(blocks, fns, tt)
}

fn suspended_cleanup_metric_abort_owned_facts_nested_blocks(
  blocks: IrBlockList,
  fns: i64,
  tt: i64
) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) ->
        suspended_cleanup_metric_abort_owned_facts_insts(insts, fns, tt) +
        suspended_cleanup_metric_abort_owned_facts_nested_blocks(rest, fns, tt)
    }
  }
}

fn suspended_cleanup_metric_abort_owned_facts(ir: IrModule, fns: i64, fn_name: str, tt: i64) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> suspended_cleanup_metric_abort_owned_facts_blocks(
      pipeline_ir_function_blocks(fn_ir), fns, tt
    )
  }
}

-- Snapshot one already-compiled embedded specimen as [summary, fact...,
-- missing-home bitset]. Fact assertions are intentionally dense, but repeated
-- full pipeline runs would make this semantic pin dominate suite latency.
fn suspended_cleanup_metric_snapshot(ir: IrModule, fns: i64, tt: i64, fn_name: str, source: i64) -> i64 {
  let out = nlist_new()
  let name_hash = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  let declaration = if source == 0 { 0 }
    else { module_decl_fact_find(tt, source, module_decl_namespace_value(), __str_ptr(fn_name), 0, __str_len(fn_name)) }
  let wanted = module_decl_fact_native_key_or(declaration, name_hash)
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> { nlist_add(out, 0 - 1) nlist_add(out, 0 - 1) }
    IrFunctionCons(fn_ir, rest) -> match fn_ir {
      IrFunction(hash, param_count, blocks, fn_src) -> {
        let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns, 0)
        nlist_add(out, suspended_cleanup_metric_fact_summary(facts))
        let mut i = 0
        while i < nlist_len(facts) {
          nlist_add(out, suspended_cleanup_metric_fact_word(nlist_get(facts, i)))
          i = i + 1
        }
        let fm = fmap_new()
        fmap_set_tt(fm, tt)
        fmap_set_current_abort_cleanup_facts(fm, facts)
        let f64 = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
        let vector = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
        let resident = pipeline_ir_native_volatile_residents(param_count, blocks, pipeline_ir_native_pinned_slot_for_function(fn_ir), fm, f64, vector)
        let homes = pipeline_ir_native_value_home_facts(pipeline_ir_native_value_home_count_for_blocks(param_count, blocks), resident)
        let mut missing = 0
        let mut j = 0
        while j < nlist_len(facts) {
          let home = pipeline_ir_native_value_home_lookup(homes, node_f1(nlist_get(facts, j)))
          if home == 0 or home == pipeline_ir_native_discard_home() or home >= 1000 { missing = missing + cg_bit(j) } else { 0 }
          j = j + 1
        }
        nlist_add(out, missing)
      }
    }
  }
  out
}

fn suspended_cleanup_metric_action_count(ir: IrModule, fns: i64, fn_name: str, action: i64) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> match fn_ir {
      IrFunction(hash, param_count, blocks, fn_src) -> {
        let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns, 0)
        let mut count = 0
        let mut i = 0
        while i < nlist_len(facts) {
          if node_f2(nlist_get(facts, i)) == action { count = count + 1 } else { 0 }
          i = i + 1
        }
        count
      }
    }
  }
}

fn suspended_cleanup_metric_flow_alias_summary(ir: IrModule, fns: i64, fn_name: str) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> match fn_ir {
      IrFunction(hash, param_count, blocks, fn_src) -> {
        let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns, 0)
        let mut aliases = 0
        let mut invalid = 0
        let mut i = 0
        while i < nlist_len(facts) {
          let alias = nlist_get(facts, i)
          if node_f3(alias) == pipeline_ir_abort_cleanup_flow_alias_kind() {
            aliases = aliases + 1
            let source_index = node_f4(alias)
            if source_index < 0 or source_index >= nlist_len(facts) {
              invalid = invalid + 1
            } else {
              let source = nlist_get(facts, source_index)
              if node_f3(source) != pipeline_ir_abort_cleanup_owned_kind() or
                node_f2(source) != node_f2(alias) or node_f1(source) == node_f1(alias) {
                invalid = invalid + 1
              } else { 0 }
            }
          } else { 0 }
          i = i + 1
        }
        aliases * 10 + invalid
      }
    }
  }
}

fn suspended_cleanup_metric_binding_value_insts(insts: IrInstList, src: i64, name: str) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrBindI64(ns, nl, value, ty) -> {
        if src_eq(src, ns, nl, name) == 1 { value }
        else { suspended_cleanup_metric_binding_value_insts(rest, src, name) }
      }
      _ -> suspended_cleanup_metric_binding_value_insts(rest, src, name)
    }
  }
}

fn suspended_cleanup_metric_binding_value_blocks(blocks: IrBlockList, src: i64, name: str) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let found = suspended_cleanup_metric_binding_value_insts(insts, src, name)
        if found >= 0 { found } else { suspended_cleanup_metric_binding_value_blocks(rest, src, name) }
      }
    }
  }
}

fn suspended_cleanup_metric_generic_call_dst_insts(insts: IrInstList, callee_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrGenericCallI64(dst, callee, type_args, args) -> {
        if callee == callee_hash { dst }
        else { suspended_cleanup_metric_generic_call_dst_insts(rest, callee_hash) }
      }
      _ -> suspended_cleanup_metric_generic_call_dst_insts(rest, callee_hash)
    }
  }
}

fn suspended_cleanup_metric_generic_call_dst_blocks(blocks: IrBlockList, callee_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let found = suspended_cleanup_metric_generic_call_dst_insts(insts, callee_hash)
        if found >= 0 { found } else { suspended_cleanup_metric_generic_call_dst_blocks(rest, callee_hash) }
      }
    }
  }
}

fn suspended_cleanup_metric_ignored_result_window(source: str) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0)
  let fns = match typed { TypedModule(entries, src, tt) -> entries }
  let tt = match typed { TypedModule(entries, src, table) -> table }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let main_hash = str_hash(__str_ptr("main"), 0, 4)
  let iter_next_hash = str_hash(__str_ptr("iter_next"), 0, 9)
  let mut bad_homes = 1
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), main_hash) {
    IrFunctionNil -> 0
    IrFunctionCons(fn_ir, rest) -> match fn_ir {
      IrFunction(hash, param_count, blocks, fn_src) -> {
        let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, fns, tt)
        let fm = fmap_new()
        fmap_set_tt(fm, tt)
        fmap_set_current_abort_cleanup_facts(fm, facts)
        let f64 = pipeline_ir_native_f64_facts_assign_slot_homes(blocks, pipeline_ir_native_f64_facts_for_blocks(blocks))
        let vector = pipeline_ir_native_vector_data_facts_assign_home(pipeline_ir_native_vector_data_facts_for_blocks(blocks))
        let resident = pipeline_ir_native_volatile_residents(param_count, blocks, pipeline_ir_native_pinned_slot_for_function(fn_ir), fm, f64, vector)
        let homes = pipeline_ir_native_value_home_facts(pipeline_ir_native_value_home_count_for_blocks(param_count, blocks), resident)
        let iterator = suspended_cleanup_metric_binding_value_blocks(blocks, fn_src, "it")
        let ignored = suspended_cleanup_metric_generic_call_dst_blocks(blocks, iter_next_hash)
        if iterator >= 0 and ignored >= 0 {
          let iterator_home = pipeline_ir_native_value_home_lookup(homes, iterator)
          let ignored_home = pipeline_ir_native_value_home_lookup(homes, ignored)
          bad_homes = if iterator_home == 0 or ignored_home == 0 or
            iterator_home == pipeline_ir_native_discard_home() or ignored_home == pipeline_ir_native_discard_home() or
            iterator_home >= 1000 or ignored_home >= 1000 or iterator_home == ignored_home { 1 } else { 0 }
        } else { 0 }
      }
    }
  }
  let native = pipeline_lower_native_module_with_audit(typed, ir, 1)
  bad_homes * 1000 + pipeline_native_residency_audit_cs_violation_count(native)
}

test "abort_cleanup_facts_pin_closure_and_handle_boundary_owners" {
  let src = "use runtime/rc_implicit_test.{*}
effect E { fn stop(value: i64) -> i64 }
fn f(payload: RuntimeRcProbe) -[E]> i64 {
  let reader = () => runtime_rc_probe_load(payload)
  let observed = reader()
  E.stop(observed) + 1000
}
fn run(payload: RuntimeRcProbe) -> i64 { handle f(payload) { E.stop(value) -> value } }
fn main() -> i64 { run(runtime_rc_probe_new(17)) }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let fns = match typed { TypedModule(entries, source, tt) -> entries }
  let tt = match typed { TypedModule(entries, source, table) -> table }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let snapshot = suspended_cleanup_metric_snapshot(ir, fns, tt, "f", __str_ptr(src))
  -- One closure object and one explicit retain stake. The borrowed PtrLoad
  -- feeding that retain is not a third acquisition.
  Test.assert_eq(nlist_get(snapshot, 0), 20110)
  Test.assert_eq(nlist_get(snapshot, 1), 1001021)
  Test.assert_eq(nlist_get(snapshot, 2), 17014011)
  Test.assert_eq(nlist_get(snapshot, 3), 0)
  -- `run` is inlined into `main`; select the root declaration by its native
  -- identity because stdlib modules also define functions named `main`/`run`.
  let main_snapshot = suspended_cleanup_metric_snapshot(ir, fns, tt, "main", __str_ptr(src))
  Test.assert_eq(nlist_get(main_snapshot, 0), 10100)
  Test.assert_eq(nlist_get(main_snapshot, 1), 1001011)
  Test.assert_eq(nlist_get(main_snapshot, 2), 0)
}

test "defer_cleanup_fact_survives_optimisation" {
  let src = "use runtime/rc_implicit_test.{*}
effect E { fn stop(value: i64) -> i64 }
fn f(payload: RuntimeRcProbe) -[E]> i64 {
  defer runtime_rc_probe_load(payload)
  E.stop(42) + 1000
}
fn run(payload: RuntimeRcProbe) -> i64 { handle f(payload) { E.stop(value) -> value } }
fn main() -> i64 { run(runtime_rc_probe_new(17)) }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let fns = match typed { TypedModule(entries, source, tt) -> entries }
  let tt = match typed { TypedModule(entries, source, table) -> table }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let defer_snapshot = suspended_cleanup_metric_snapshot(ir, fns, tt, "f", __str_ptr(src))
  Test.assert_eq(nlist_get(defer_snapshot, 0), 20010)
  Test.assert_eq(nlist_get(defer_snapshot, 3), 0)
  let pre_promotion = pipeline_optimise_typed_ir_pre_promotion(typed, pipeline_lower_ir(typed))
  Test.assert_eq(suspended_cleanup_metric_defer_calls(pre_promotion, "f"), 1)
  let semantic_facts = pipeline_ir_semantic_facts_from_fns(fns, 0)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure(semantic_facts, pipeline_runtime_defer_abort_cleanup_hash()), 0)
  let runtime_snapshot = suspended_cleanup_metric_snapshot(ir, fns, tt, "runtime_generator_state_drop", 0)
  Test.assert_eq(nlist_get(runtime_snapshot, 0), 20200)
  Test.assert_eq(nlist_get(runtime_snapshot, 1), 11011011)
  Test.assert_eq(nlist_get(runtime_snapshot, 2), 23023011)
  Test.assert_eq(nlist_get(runtime_snapshot, 3), 0)
}

test "ignored_managed_results_keep_abort_cleanup_homes" {
  let src = "use runtime/rc_implicit_test.{*}
use stdlib/generator as generator
effect E { fn stop(value: i64) -> i64 }
fn f(payload: RuntimeRcProbe) -[E]> i64 {
  let producer = () => {
    generator.yield<i64>(7)
    payload
  }
  let mut g = generator.start<i64, RuntimeRcProbe>(producer)
  g.next()
  g.next()
  E.stop(42) + 1000
}
fn run(payload: RuntimeRcProbe) -> i64 { handle f(payload) { E.stop(value) -> value } }
fn main() -> i64 { run(runtime_rc_probe_new(23)) }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let fns = match typed { TypedModule(entries, source, tt) -> entries }
  let tt = match typed { TypedModule(entries, source, table) -> table }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let snapshot = suspended_cleanup_metric_snapshot(ir, fns, tt, "f", __str_ptr(src))
  -- The scalar owned Generator drop is specialized into its runtime cleanup
  -- before this fact pass. Nine remaining cleanup facts protect two managed
  -- values, two closure environments, and both ignored Option results; every
  -- fact receives a real native home across the abort edge.
  Test.assert_eq(nlist_len(snapshot), 11)
  Test.assert_eq(nlist_get(snapshot, 0), 90220)
  Test.assert_eq(nlist_get(snapshot, nlist_len(snapshot) - 1), 0)
  Test.assert_eq(suspended_cleanup_metric_owned_drops(ir, "f"), 0)
  Test.assert_eq(suspended_cleanup_metric_abort_owned_facts(ir, fns, "f", tt), 0)
}

test "ignored_managed_result_cleanup_use_has_a_positional_interval" {
  let src = "use stdlib/iter as iter
use runtime/rc_implicit_test.{*}
fn capture(payload: RuntimeRcProbe, value: i64) -> i64 { runtime_rc_probe_load(payload) + value }
fn main() -> i64 {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(30)
  let add = value => capture(payload, value)
  let it = iter.map<i64, i64>(iter.range(0, 3), add)
  it.next()
  it.close()
  0
}
"
  -- The ignored Option<i64> is still owned until its synthetic cleanup
  -- registration. Its same-position use must neither be discarded nor share
  -- the iterator's still-live callee-saved home. The native audit caught the
  -- original overlap as one interval-seating violation.
  Test.assert_eq(suspended_cleanup_metric_ignored_result_window(src), 0)
}

test "static_par_scopes_produce_direct_abort_cleanup_facts" {
  let src = "use stdlib/par as par
use stdlib/par.{*}
effect E { fn stop(value: i64) -> i64 }
fn worker(value: i64) -> i64 { value + 1 }
fn f() -[E]> i64 {
  par.with_sequential(() => {
    let task = par.fork<i64>(() => worker(41))
    E.stop(42)
  })
}
fn g() -[E]> i64 {
  par.with_pool(2, 4, () => {
    let task = par.fork<i64>(() => worker(41))
    E.stop(42)
  })
}
fn run() -> i64 { handle f() { E.stop(value) -> value } }
fn main() -> i64 { run() }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let fns = match typed { TypedModule(entries, source, tt) -> entries }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  Test.assert_eq(suspended_cleanup_metric_action_count(ir, fns, "f", pipeline_runtime_par_work_scope_cleanup_hash()), 1)
  Test.assert_eq(suspended_cleanup_metric_action_count(ir, fns, "g", pipeline_runtime_defer_abort_cleanup_hash()), 1)
}

test "owned mutable merge carries exact branch cleanup provenance" {
  let src = "use stdlib/drop.{*}
use stdlib/result.{*}
type Token = opaque i64
impl Drop for Token { fn drop(self: i64) -> i64 { 0 } }
fn open(value: i64) -> Result<owned Token, i64> {
  Ok<owned Token, i64>(Token(value))
}
fn fallback(value: i64) -> owned Token { Token(value) }
fn f(value: i64) -> i64 {
  let opened = open(value)
  let mut token: owned Token = match opened {
    Ok(current) -> current
    Err(error) -> fallback(value)
  }
  token.drop()
}
fn main() -> i64 { f(1) }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let fns = match typed { TypedModule(entries, source, tt) -> entries }
  let ir = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  -- The successful Result extraction owns a branch-local record while the
  -- fallback is acquired at the merge. The former maps to the merge SSA by
  -- exact record index; neither path relies on equal opaque runtime bits.
  Test.assert_eq(suspended_cleanup_metric_flow_alias_summary(ir, fns, "f"), 10)
}

test "owned effect arguments carry an explicit transfer fact" {
  let src = "use stdlib/drop.{*}
type Token = opaque i64
impl Drop for Token { fn drop(self: i64) -> i64 { 0 } }
effect MoveOwned { fn move(token: owned Token) -> owned Token }
fn f(token: owned Token) -[MoveOwned]> owned Token { MoveOwned.move(token) }
fn main() -> i64 { 0 }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  Test.assert_eq(suspended_cleanup_metric_effect_transfers(ir, "f"), 1)
  Test.assert_eq(suspended_cleanup_metric_effect_transfers(optimised, "f"), 1)
}

test "owned handler parameter returned after deferred suspension is not dropped" {
  let src = "use stdlib/drop.{*}
type Token = opaque i64
impl Drop for Token { fn drop(self: i64) -> i64 { 0 } }
effect MoveOwned { fn move(token: owned Token) -> owned Token }
effect PauseOwned { @deferred fn pause() -> i64 }
fn transfer(token: owned Token) -[MoveOwned]> owned Token { MoveOwned.move(token) }
fn roundtrip_immediate(token: owned Token) -> owned Token {
  handle transfer(token) {
    MoveOwned.move(value) -> resume(value)
  }
}
fn roundtrip(token: owned Token) -> owned Token {
  handle {
    handle transfer(token) {
      MoveOwned.move(value) -> { PauseOwned.pause() resume(value) }
    }
  } {
    PauseOwned.pause() with k -> k(0)
  }
}
fn main() -> i64 { 0 }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  Test.assert_eq(suspended_cleanup_metric_owned_drops(ir, "transfer"), 0)
  Test.assert_eq(suspended_cleanup_metric_owned_drops(ir, "roundtrip_immediate"), 0)
  Test.assert_eq(suspended_cleanup_metric_owned_drops(ir, "roundtrip"), 0)
  let fns = match typed { TypedModule(entries, source, table) -> entries }
  let tt = match typed { TypedModule(entries, source, table) -> table }
  -- One record protects roundtrip's function parameter and one protects the
  -- handler clause's transferred parameter while PauseOwned is suspended.
  Test.assert_eq(suspended_cleanup_metric_abort_owned_facts(ir, fns, "roundtrip", tt), 2)
}
