use runtime/rc_implicit_test.{*}
use runtime/rc.{*}
use stdlib/eq.{Eq}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/hash.{Hash}
use stdlib/iter as iter
use stdlib/list.{List, Cons, Nil}
use stdlib/map as map
use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_get_option, vector_push}

effect IteratorOwnershipStop {
  fn stop(value: i64) -> i64
}

type IteratorOwnershipRanked {
  rank: i64,
  value: RuntimeRcProbe
}

type IteratorOwnershipKey {
  IteratorOwnershipKey(i64, RuntimeRcProbe)
}

impl Ord for IteratorOwnershipRanked {
  fn compare(self: Self, other: Self) -> Ordering {
    self.rank.compare(other.rank)
  }
}

impl Hash for IteratorOwnershipKey {
  fn hash(self: IteratorOwnershipKey) -> i64 {
    match self {
      IteratorOwnershipKey(value, probe) -> value.hash()
    }
  }
}

impl Eq for IteratorOwnershipKey {
  fn eq(self: IteratorOwnershipKey, other: IteratorOwnershipKey) -> bool {
    match self {
      IteratorOwnershipKey(left, left_probe) -> match other {
        IteratorOwnershipKey(right, right_probe) -> left == right
      }
    }
  }
}

fn iterator_ownership_ranked_values(
  high: RuntimeRcProbe,
  low: RuntimeRcProbe
) -> owned Vector<IteratorOwnershipRanked> {
  let mut values = vector.new<IteratorOwnershipRanked>()
  values.push(IteratorOwnershipRanked { rank: 9, value: high })
  values.push(IteratorOwnershipRanked { rank: 4, value: low })
  values
}

fn iterator_ownership_match_break(value: RuntimeRcProbe) -> i64 {
  loop {
    match Some<RuntimeRcProbe>(value) {
      Some(item) -> {
        runtime_rc_probe_load(item)
        break
      }
      None -> break
    }
  }
  0
}

fn iterator_ownership_match_return(value: RuntimeRcProbe) -> i64 {
  loop {
    match Some<RuntimeRcProbe>(value) {
      Some(item) -> return runtime_rc_probe_load(item)
      None -> break
    }
  }
  0
}

fn iterator_ownership_match_abort(value: RuntimeRcProbe) -[IteratorOwnershipStop]> i64 {
  loop {
    match Some<RuntimeRcProbe>(value) {
      Some(item) -> IteratorOwnershipStop.stop(runtime_rc_probe_load(item))
      None -> break
    }
  }
  0
}

fn iterator_ownership_run_match_abort(value: RuntimeRcProbe) -> i64 {
  handle iterator_ownership_match_abort(value) {
    IteratorOwnershipStop.stop(observed) -> observed
  }
}

fn iterator_ownership_match_generator(values: Vector<RuntimeRcProbe>) -> owned Generator<RuntimeRcProbe, i64> {
  let producer = () => {
    match vector_get_option<RuntimeRcProbe>(values, 0) {
      Some(value) -> generator.yield<RuntimeRcProbe>(value)
      None -> nil
    }
    0
  }
  generator.start<RuntimeRcProbe, i64>(producer)
}

fn iterator_ownership_direct_generator(values: Vector<RuntimeRcProbe>) -> owned Generator<RuntimeRcProbe, i64> {
  let producer = () => {
    generator.yield<RuntimeRcProbe>(vector_get_in_bounds<RuntimeRcProbe>(values, 0))
    0
  }
  generator.start<RuntimeRcProbe, i64>(producer)
}

fn iterator_ownership_transformed_match_generator(values: Vector<RuntimeRcProbe>) -> owned Generator<RuntimeRcProbe, i64> {
  let producer = () => {
    let next = vector_get_option<RuntimeRcProbe>(values, 0)
    match next {
      Some(value) -> generator.yield<RuntimeRcProbe>(iterator_ownership_return_probe(value))
      None -> nil
    }
    0
  }
  generator.start<RuntimeRcProbe, i64>(producer)
}

fn iterator_ownership_indirect_match_generator(values: Vector<RuntimeRcProbe>, f: (RuntimeRcProbe) -> RuntimeRcProbe) -> owned Generator<RuntimeRcProbe, i64> {
  let producer = () => {
    let next = vector_get_option<RuntimeRcProbe>(values, 0)
    match next {
      Some(value) -> generator.yield<RuntimeRcProbe>(f(value))
      None -> nil
    }
    0
  }
  generator.start<RuntimeRcProbe, i64>(producer)
}

fn iterator_ownership_generic_apply<A, U>(state: A, f: (A) -> U) -> U {
  f(state)
}

fn iterator_ownership_indirect_apply_and_reuse(state: RuntimeRcProbe, f: (RuntimeRcProbe) -> i64) -> i64 {
  let observed = f(state)
  observed + runtime_rc_probe_load(state)
}

fn iterator_ownership_indirect_apply_reuse_abort(state: RuntimeRcProbe, f: (RuntimeRcProbe) -> i64) -[IteratorOwnershipStop]> i64 {
  let observed = f(state)
  IteratorOwnershipStop.stop(observed + runtime_rc_probe_load(state))
}

fn iterator_ownership_run_indirect_apply_reuse_abort(state: RuntimeRcProbe) -> i64 {
  handle iterator_ownership_indirect_apply_reuse_abort(state, runtime_rc_probe_load) {
    IteratorOwnershipStop.stop(observed) -> observed
  }
}

fn iterator_ownership_generic_apply_tuple<A, U>(state: A, f: (A) -> (A, U)) -> U {
  let (next_state, output) = f(state)
  output
}

fn iterator_ownership_generic_indirect_generator<A>(state: A, f: (A) -> i64) -> owned Generator<i64, i64> {
  let producer = () => {
    let current = state
    let output = f(current)
    generator.yield<i64>(output)
    0
  }
  generator.start<i64, i64>(producer)
}

fn iterator_ownership_extract_structural_carrier(value: RuntimeRcProbe) -> RuntimeRcProbe {
  let carrier: [(i64, RuntimeRcProbe); 1] = [(10, value)]
  let item = carrier[0]
  item.1
}

fn iterator_ownership_match_structural_payload(value: RuntimeRcProbe) -> i64 {
  match Some<(i64, RuntimeRcProbe)>((10, value)) {
    Some((key, item)) -> key + runtime_rc_probe_load(item)
    None -> 0
  }
}

fn iterator_ownership_map_scope(value: RuntimeRcProbe, iterate: bool) -> i64 {
  let empty = map.new<i64, RuntimeRcProbe>()
  let one = empty.insert(10, value)
  let values = one.insert(20, value)
  if iterate {
    for (key, item) in values { runtime_rc_probe_load(item) + key }
  } else { 0 }
  0
}

fn iterator_ownership_map_drop_scope(value: RuntimeRcProbe) -> i64 {
  let empty = map.new<i64, RuntimeRcProbe>()
  let one = empty.insert(10, value)
  let values = one.insert(20, value)
  let iterator = values.into_iter()
  iterator.close()
  0
}

fn iterator_ownership_map_key_drop_scope(value: RuntimeRcProbe) -> i64 {
  let values = map.new<IteratorOwnershipKey, i64>().insert(IteratorOwnershipKey(10, value), 9)
  let iterator = values.into_iter()
  iterator.close()
  0
}

fn iterator_ownership_map_get_scope(value: RuntimeRcProbe) -> i64 {
  let values = map.new<i64, RuntimeRcProbe>().insert(10, value)
  match values.get(10) {
    Some(item) -> runtime_rc_probe_load(item)
    None -> 0
  }
}

fn iterator_ownership_tuple_producer(value: RuntimeRcProbe) -[GeneratorYield]> i64 {
  generator.yield<(i64, RuntimeRcProbe)>((10, value))
  generator.yield<(i64, RuntimeRcProbe)>((20, value))
  0
}

fn iterator_ownership_return_probe(value: RuntimeRcProbe) -> RuntimeRcProbe {
  value
}

fn iterator_ownership_managed_tuple_local_producer(
  value: RuntimeRcProbe
) -[GeneratorYield]> i64 {
  let item = iterator_ownership_return_probe(value)
  generator.yield<(i64, RuntimeRcProbe)>((10, item))
  0
}

fn iterator_ownership_owned_tuple_producer(value: RuntimeRcProbe) -[GeneratorYield]> i64 {
  for i in 0..2 {
    generator.yield<(i64, RuntimeRcProbe)>((i, iterator_ownership_return_probe(value)))
  }
  0
}

fn iterator_ownership_tuple_exhaust(value: RuntimeRcProbe) -> i64 {
  let producer = () => iterator_ownership_tuple_producer(value)
  let iterator = iter.from_generator(generator.start<(i64, RuntimeRcProbe), i64>(producer))
  for (key, item) in iterator { runtime_rc_probe_load(item) + key }
  0
}

fn iterator_ownership_tuple_close(value: RuntimeRcProbe) -> i64 {
  let producer = () => iterator_ownership_tuple_producer(value)
  let iterator = iter.from_generator(generator.start<(i64, RuntimeRcProbe), i64>(producer))
  iterator.close()
  0
}

fn iterator_ownership_managed_tuple_local_close(value: RuntimeRcProbe) -> i64 {
  let producer = () => iterator_ownership_managed_tuple_local_producer(value)
  let iterator = iter.from_generator(generator.start<(i64, RuntimeRcProbe), i64>(producer))
  iterator.close()
  0
}

fn iterator_ownership_owned_tuple_exhaust(value: RuntimeRcProbe) -> i64 {
  let producer = () => iterator_ownership_owned_tuple_producer(value)
  let iterator = iter.from_generator(generator.start<(i64, RuntimeRcProbe), i64>(producer))
  for (key, item) in iterator { runtime_rc_probe_load(item) + key }
  0
}

fn iterator_ownership_position_closes_remainder(value: RuntimeRcProbe) -> Option<usize> {
  let producer = () => {
    generator.yield<i64>(1)
    generator.yield<i64>(2)
    generator.yield<i64>(runtime_rc_probe_load(value))
    0
  }
  let source = iter.from_generator(generator.start<i64, i64>(producer))
  iter.position(source, item => item % 2 == 0)
}

fn iterator_ownership_first_closes_remainder(value: RuntimeRcProbe) -> Option<i64> {
  let producer = () => {
    generator.yield<i64>(1)
    generator.yield<i64>(runtime_rc_probe_load(value))
    0
  }
  let source = iter.from_generator(generator.start<i64, i64>(producer))
  iter.first(source)
}

fn iterator_ownership_unused_iterator_closes(value: RuntimeRcProbe) -> i64 {
  let producer = () => {
    generator.yield<i64>(1)
    generator.yield<i64>(runtime_rc_probe_load(value))
    0
  }
  let source = iter.from_generator(generator.start<i64, i64>(producer))
  0
}

fn iterator_ownership_concrete_first(input: owned Iterator<i64>) -> Option<i64> {
  let mut source = input
  source.next()
}

fn iterator_ownership_concrete_first_closes_remainder(value: RuntimeRcProbe) -> Option<i64> {
  let producer = () => {
    generator.yield<i64>(1)
    generator.yield<i64>(runtime_rc_probe_load(value))
    0
  }
  iterator_ownership_concrete_first(
    iter.from_generator(generator.start<i64, i64>(producer))
  )
}

fn iterator_ownership_flatten_closes_nested_sources(value: RuntimeRcProbe) -> i64 {
  let first = Cons<RuntimeRcProbe>(value, Cons<RuntimeRcProbe>(value, Nil<RuntimeRcProbe>()))
  let second = Cons<RuntimeRcProbe>(value, Nil<RuntimeRcProbe>())
  let nested = Cons<List<RuntimeRcProbe>>(first, Cons<List<RuntimeRcProbe>>(second, Nil<List<RuntimeRcProbe>>()))
  let mut flattened = iter.flatten(nested)
  match flattened.next() {
    Some(observed) -> runtime_rc_probe_load(observed)
    None -> 0
  }
  flattened.close()
  0
}

fn iterator_ownership_partition_releases_outputs(
  low: RuntimeRcProbe,
  high: RuntimeRcProbe
) -> i64 {
  let mut values = vector.new<RuntimeRcProbe>()
  values.push(low)
  values.push(high)
  values.push(low)
  let (accepted, rejected) = iter.partition(
    values,
    value => runtime_rc_probe_load(value) > 5
  )
  let accepted_total = iter.fold(
    accepted,
    0,
    (total: i64, value: RuntimeRcProbe) => total + runtime_rc_probe_load(value)
  )
  let rejected_total = iter.fold(
    rejected,
    0,
    (total: i64, value: RuntimeRcProbe) => total + runtime_rc_probe_load(value)
  )
  accepted_total * 10 + rejected_total
}

test "managed match payload suspended in a generator drops exactly once" {
  let value = runtime_rc_probe_new(7)
  let mut values = vector.new<RuntimeRcProbe>()
  values.push(value)
  values.push(value)
  let generator = iterator_ownership_match_generator(values)
  Test.assert_eq(runtime_rc_probe_count(value), 5)
  Test.assert_eq(runtime_generator_state_cleanup_count(generator_state<RuntimeRcProbe, i64>(generator)), 2)
  generator.close()
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "managed rvalue suspended in a generator drops exactly once" {
  let value = runtime_rc_probe_new(7)
  let mut values = vector.new<RuntimeRcProbe>()
  values.push(value)
  values.push(value)
  let generator = iterator_ownership_direct_generator(values)
  Test.assert_eq(runtime_rc_probe_count(value), 5)
  Test.assert_eq(runtime_generator_state_cleanup_count(generator_state<RuntimeRcProbe, i64>(generator)), 2)
  generator.close()
  Test.assert_eq(runtime_rc_probe_count(value), 1)

  let transformed_value = runtime_rc_probe_new(8)
  let mut transformed_values = vector.new<RuntimeRcProbe>()
  transformed_values.push(transformed_value)
  transformed_values.push(transformed_value)
  let transformed = iterator_ownership_transformed_match_generator(transformed_values)
  transformed.close()
  Test.assert_eq(runtime_rc_probe_count(transformed_value), 1)

  let indirect_value = runtime_rc_probe_new(9)
  let mut indirect_values = vector.new<RuntimeRcProbe>()
  indirect_values.push(indirect_value)
  indirect_values.push(indirect_value)
  let indirect = iterator_ownership_indirect_match_generator(indirect_values, iterator_ownership_return_probe)
  indirect.close()
  Test.assert_eq(runtime_rc_probe_count(indirect_value), 1)
}

test "generic callbacks preserve managed parameters and aggregate results" {
  let scalar = runtime_rc_probe_new(41)
  Test.assert_eq(iterator_ownership_generic_apply<RuntimeRcProbe, i64>(scalar, value => runtime_rc_probe_load(value)), 41)
  Test.assert_eq(runtime_rc_probe_count(scalar), 1)

  let aggregate = runtime_rc_probe_new(42)
  Test.assert_eq(iterator_ownership_generic_apply_tuple<RuntimeRcProbe, i64>(aggregate, value => (value, runtime_rc_probe_load(value))), 42)
  Test.assert_eq(runtime_rc_probe_count(aggregate), 1)

  let reused = runtime_rc_probe_new(21)
  Test.assert_eq(iterator_ownership_indirect_apply_and_reuse(reused, runtime_rc_probe_load), 42)
  Test.assert_eq(runtime_rc_probe_count(reused), 1)

  let aborted = runtime_rc_probe_new(22)
  Test.assert_eq(iterator_ownership_run_indirect_apply_reuse_abort(aborted), 44)
  Test.assert_eq(runtime_rc_probe_count(aborted), 1)
}

test "indirect callback transport remains armed across suspension" {
  let value = runtime_rc_probe_new(43)
  let suspended = iterator_ownership_generic_indirect_generator<RuntimeRcProbe>(value, runtime_rc_probe_load)
  Test.assert_eq(runtime_generator_state_cleanup_count(generator_state<i64, i64>(suspended)), 2)
  Test.assert_eq(runtime_rc_probe_count(value), 3)
  suspended.close()
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "managed structural carrier extraction releases its owner" {
  let value = runtime_rc_probe_new(7)
  let extracted = iterator_ownership_extract_structural_carrier(value)
  Test.assert_eq(runtime_rc_probe_load(extracted), 7)
  Test.assert_eq(runtime_rc_probe_count(value), 2)

  let matched = runtime_rc_probe_new(8)
  Test.assert_eq(iterator_ownership_match_structural_payload(matched), 18)
  Test.assert_eq(runtime_rc_probe_count(matched), 1)
}

test "qualified generic call receivers release after method chaining" {
  let looked_up = runtime_rc_probe_new(6)
  Test.assert_eq(iterator_ownership_map_get_scope(looked_up), 6)
  Test.assert_eq(runtime_rc_probe_count(looked_up), 1)
}

test "uniterated map releases persistent construction intermediates" {
  let scoped = runtime_rc_probe_new(7)
  Test.assert_eq(iterator_ownership_map_scope(scoped, false), 0)
  Test.assert_eq(runtime_rc_probe_count(scoped), 1)
}

test "closed map iterator releases its captured collection" {
  let dropped = runtime_rc_probe_new(9)
  Test.assert_eq(iterator_ownership_map_drop_scope(dropped), 0)
  Test.assert_eq(runtime_rc_probe_count(dropped), 1)
}

test "closed map iterator releases a managed key in its buffered entry" {
  let key = runtime_rc_probe_new(10)
  Test.assert_eq(iterator_ownership_map_key_drop_scope(key), 0)
  Test.assert_eq(runtime_rc_probe_count(key), 1)
}

test "exhausted map iterator releases structural yields and its collection" {
  let iterated = runtime_rc_probe_new(8)
  Test.assert_eq(iterator_ownership_map_scope(iterated, true), 0)
  Test.assert_eq(runtime_rc_probe_count(iterated), 1)
}

test "structural generator exhaustion releases every yielded carrier" {
  let value = runtime_rc_probe_new(7)
  Test.assert_eq(iterator_ownership_tuple_exhaust(value), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 1)

  let owned = runtime_rc_probe_new(8)
  Test.assert_eq(iterator_ownership_owned_tuple_exhaust(owned), 0)
  Test.assert_eq(runtime_rc_probe_count(owned), 1)
}

test "closing a structural generator releases its buffered carrier" {
  let value = runtime_rc_probe_new(11)
  Test.assert_eq(iterator_ownership_tuple_close(value), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "closing a structural generator releases a managed local moved into its carrier" {
  let value = runtime_rc_probe_new(12)
  Test.assert_eq(iterator_ownership_managed_tuple_local_close(value), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "position closes unconsumed generator state after its first match" {
  let unused = runtime_rc_probe_new(5)
  Test.assert_eq(iterator_ownership_unused_iterator_closes(unused), 0)
  Test.assert_eq(runtime_rc_probe_count(unused), 1)

  let concrete = runtime_rc_probe_new(4)
  match iterator_ownership_concrete_first_closes_remainder(concrete) {
    Some(observed) -> Test.assert_eq(observed, 1)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(runtime_rc_probe_count(concrete), 1)

  let first_value = runtime_rc_probe_new(6)
  match iterator_ownership_first_closes_remainder(first_value) {
    Some(observed) -> Test.assert_eq(observed, 1)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(runtime_rc_probe_count(first_value), 1)

  let value = runtime_rc_probe_new(7)
  match iterator_ownership_position_closes_remainder(value) {
    Some(index) -> Test.assert_eq(__u64_to_i64(__usize_to_u64(index)), 1)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "ordered iterator consumers release discarded managed values" {
  let high = runtime_rc_probe_new(9)
  let low = runtime_rc_probe_new(4)
  match iter.min(iterator_ownership_ranked_values(high, low)) {
    Some(item) -> Test.assert_eq(runtime_rc_probe_load(item.value), 4)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(runtime_rc_probe_count(high), 1)
  Test.assert_eq(runtime_rc_probe_count(low), 1)
}

test "flatten closes active inner and unvisited outer sources" {
  let value = runtime_rc_probe_new(8)
  Test.assert_eq(iterator_ownership_flatten_closes_nested_sources(value), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "partition transfers managed values into two owned outputs" {
  let low = runtime_rc_probe_new(4)
  let high = runtime_rc_probe_new(9)
  Test.assert_eq(iterator_ownership_partition_releases_outputs(low, high), 98)
  Test.assert_eq(runtime_rc_probe_count(low), 1)
  Test.assert_eq(runtime_rc_probe_count(high), 1)
}

test "owned match scrutinee cleans up on loop control and return" {
  let break_value = runtime_rc_probe_new(7)
  Test.assert_eq(iterator_ownership_match_break(break_value), 0)
  Test.assert_eq(runtime_rc_probe_count(break_value), 1)

  let return_value = runtime_rc_probe_new(8)
  Test.assert_eq(iterator_ownership_match_return(return_value), 8)
  Test.assert_eq(runtime_rc_probe_count(return_value), 1)

  let abort_value = runtime_rc_probe_new(9)
  Test.assert_eq(iterator_ownership_run_match_abort(abort_value), 9)
  Test.assert_eq(runtime_rc_probe_count(abort_value), 1)
}
