use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_store64_at}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_new}
use runtime/process as process_handler
use runtime/shutdown.{runtime_shutdown_set_disposition}
use runtime/string.{runtime_str_cstring}
use stdlib/task/channel as channel
use stdlib/task/channel.{Channel, ChannelCapacity, ChannelSendAccepted, ChannelSendClosed}
use stdlib/task/cancellation as cancellation
use stdlib/task/cancellation.{CancellationOutcome}
use stdlib/list.{Cons, List, Nil}
use stdlib/process.{Proc, ProcCompleted, ProcExited, ProcHandle, ProcOutput}
use stdlib/result.{Result}
use stdlib/task/shutdown as shutdown
use stdlib/task as task
use stdlib/time as time
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}
use stdlib/vector/handles.{Vector}

fn shutdown_args(command: str) -> List<str> {
  Cons<str>("-c", Cons<str>(command, Nil<str>()))
}

fn shutdown_platform(body: () -[Proc]> i64) -> i64 {
  let argv = alloc_zeroed(24)
  mem_store64_at(argv, 0, 0)
  mem_store64_at(argv, 8, runtime_str_cstring("PATH=/usr/bin:/bin"))
  mem_store64_at(argv, 16, 0)
  with process_handler(0, argv) { body() }
}

fn shutdown_wait_body(trace: Vector<i64>, command: str) -[Proc, time.Time]> i64 {
  defer vector_push<i64>(trace, 1)
  {
    defer vector_push<i64>(trace, 2)
    let child: owned ProcHandle = Proc.spawn("/bin/sh", shutdown_args(command))
    time.sleep(time.milliseconds(10000))
    let output = Proc.wait(child)
    if shutdown_process_ok(output) { 99 } else { 0 }
  }
}

fn shutdown_outcome_signal_code(
  outcome: CancellationOutcome<i64>
) -> i64 {
  match outcome {
    cancellation.CancellationCompleted(value) -> 1000 + value
    cancellation.CancellationCancelled(reason) -> match reason {
      cancellation.CancellationRequested() -> 0 - 1
      cancellation.CancellationDeadlineExceeded(deadline) -> 0 - 2
      cancellation.CancellationShutdown(signal) -> match signal {
        shutdown.ShutdownInterrupt() -> 2
        shutdown.ShutdownTerminate() -> 15
      }
    }
  }
}

fn shutdown_trace_code(trace: Vector<i64>) -> i64 {
  if vector_len<i64>(trace) != 2 { 0 }
  else {
    vector_get_in_bounds<i64>(trace, 0) * 10 +
      vector_get_in_bounds<i64>(trace, 1)
  }
}

fn shutdown_process_ok(output: ProcOutput) -> bool {
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) -> status == 0
    _ -> false
  }
}

fn shutdown_signal_probe(command: str) -[Proc]> i64 {
  let trace = vector.new<i64>()
  -- TaskScope only after the event loop has installed its signal dispositions.
  -- A fixed delay before installation is not synchronization under load.
  let outcome = task.with_event_loop_shutdown(
    () => shutdown_wait_body(trace, command)
  )
  shutdown_outcome_signal_code(outcome) * 100 + shutdown_trace_code(trace)
}

fn shutdown_channel_send(value: RuntimeRcProbe) -[Channel<RuntimeRcProbe>]> i64 {
  match Channel<RuntimeRcProbe>.send(value) {
    ChannelSendAccepted -> 1
    ChannelSendClosed(returned) -> runtime_rc_probe_count(returned)
  }
}

fn shutdown_channel_body(
  first: RuntimeRcProbe,
  second: RuntimeRcProbe
) -[Proc, task.TaskScope, time.Time, Channel<RuntimeRcProbe>]> i64 {
  let child: owned ProcHandle = Proc.spawn(
    "/bin/sh",
    shutdown_args("kill -TERM $PPID")
  )
  let filling = task.spawn(() => shutdown_channel_send(first))
  let blocked = task.spawn(() => shutdown_channel_send(second))
  time.sleep(time.milliseconds(10000))
  let output = Proc.wait(child)
  if shutdown_process_ok(output) {
    task.join(filling) + task.join(blocked)
  } else { 0 }
}

fn shutdown_channel_probe() -[Proc]> i64 {
  let first = runtime_rc_probe_new(11)
  let second = runtime_rc_probe_new(22)
  let capacity: ChannelCapacity<RuntimeRcProbe> = channel.capacity<RuntimeRcProbe>(1).expect("valid managed channel capacity")
  let outcome = task.with_event_loop_channel_shutdown(
    capacity,
    () => shutdown_channel_body(first, second)
  )
  if shutdown_outcome_signal_code(outcome) == 15 and
    runtime_rc_probe_count(first) == 1 and
    runtime_rc_probe_count(second) == 1 { 1 }
  else { 0 }
}

fn shutdown_disposition_restoration_probe() -> i64 {
  let original = runtime_shutdown_set_disposition(15, 1)
  if original == 0 - 1 { 0 }
  else {
    let outcome = task.with_event_loop_shutdown(() => 42)
    let after = runtime_shutdown_set_disposition(15, 1)
    let restored = runtime_shutdown_set_disposition(15, original)
    let completed = match outcome {
      cancellation.CancellationCompleted(value) -> value == 42
      cancellation.CancellationCancelled(reason) -> false
    }
    if after == 1 and restored != 0 - 1 and completed { 1 } else { 0 }
  }
}

test "SIGINT wakes a blocked event loop and runs LIFO cleanup" {
  Test.assert_eq(
    shutdown_platform(() => shutdown_signal_probe(
    "sleep 0.05; kill -INT $PPID"
  )),
    221
  )
}

test "repeated SIGTERM notifications coalesce to one typed reason" {
  Test.assert_eq(
    shutdown_platform(() => shutdown_signal_probe(
    "sleep 0.05; kill -TERM $PPID $PPID $PPID"
  )),
    1521
  )
}

test "normal scope exit restores the prior process disposition" {
  Test.assert_eq(shutdown_disposition_restoration_probe(), 1)
}

test "signal abort drops bounded buffered and suspended channel values" {
  Test.assert_eq(shutdown_platform(shutdown_channel_probe), 1)
}
