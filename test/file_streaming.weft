use runtime/alloc.{*}
use runtime/memory.{*}
use stdlib/fail.{*}
use stdlib/file.{*}
use stdlib/io.{*}
use stdlib/io_types.{*}
use stdlib/num.{*}
use stdlib/path.{*}
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/vector.{*}
use stdlib/vector_type.{Vector}

effect StreamAbort {
  fn stop(value: i64) -> never
}

fn stream_path(text: str) -> Path {
  match path_from_utf8(text) {
    Ok(path) -> path
    Err(error) -> stream_path("")
  }
}

fn stream_byte(value: i64) -> u8 {
  num_int_cast_value_or<u8>(num_i64_to_u8_checked(value), 0)
}

fn stream_byte_i64(value: u8) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_u8_to_u64(value)), 0)
}

fn stream_buffer(len: i64) -> Vector<u8> {
  let values = vector_with_capacity<u8>(len)
  for i in 0..len { vector_push<u8>(values, stream_byte(0)) }
  values
}

fn stream_read_count(result: Result<IoReadProgress, IoError>) -> i64 {
  match result {
    Ok(progress) -> io_read_progress_count_or(progress, 0)
    Err(error) -> 0 - io_error_kind(error)
  }
}

fn stream_write_count(result: Result<IoWriteProgress, IoError>) -> i64 {
  match result {
    Ok(progress) -> io_write_progress_count(progress)
    Err(error) -> 0 - io_error_kind(error)
  }
}

fn stream_seek_position(result: Result<i64, IoError>) -> i64 {
  match result { Ok(position) -> position Err(error) -> 0 - io_error_kind(error) }
}

fn stream_nil_code(result: Result<nil, IoError>) -> i64 {
  match result { Ok(value) -> 1 Err(error) -> 0 - io_error_kind(error) }
}

fn stream_error_kind<T>(result: Result<T, IoError>) -> i64 {
  match result { Ok(value) -> 0 Err(error) -> io_error_kind(error) }
}

fn stream_sequence(out: Vector<u8>) -[IO, Fail<IoError>]> i64 {
  let mut file: owned FileHandle = file_open_read_write(stream_path("stream-path"))
  let source = vector_new<u8>()
  vector_push<u8>(source, stream_byte(120))
  vector_push<u8>(source, stream_byte(121))
  vector_push<u8>(source, stream_byte(122))
  let source_view: [u8] = source[..]
  let wrote = stream_write_count(file_write(file, source_view))
  let first_view: [mut u8] = out[..2]
  let first = stream_read_count(file_read(file, first_view))
  let second_view: [mut u8] = out[2..]
  let second = stream_read_count(file_read(file, second_view))
  let sought = stream_seek_position(file_seek(file, 0, FileSeekStart))
  let flushed = stream_nil_code(file_flush(file))
  wrote + first + second + sought + flushed
}

fn stream_failure_sequence() -[IO, Fail<IoError>]> i64 {
  let mut file: owned FileHandle = file_open_read_write(stream_path("stream-fail"))
  let buffer = stream_buffer(1)
  let read_view: [mut u8] = buffer[..]
  let read_error = stream_error_kind<IoReadProgress>(file_read(file, read_view))
  let write_view: [u8] = buffer[..]
  let write_error = stream_error_kind<IoWriteProgress>(file_write(file, write_view))
  let seek_error = stream_error_kind<i64>(file_seek(file, 0, FileSeekStart))
  let flush_error = stream_error_kind<nil>(file_flush(file))
  read_error + write_error + seek_error + flush_error
}

fn stream_over_progress() -[IO, Fail<IoError>]> i64 {
  let mut file: owned FileHandle = file_open_read_write(stream_path("stream-over"))
  let buffer = stream_buffer(1)
  let read_view: [mut u8] = buffer[..]
  let read_error = stream_error_kind<IoReadProgress>(file_read(file, read_view))
  let write_view: [u8] = buffer[..]
  let write_error = stream_error_kind<IoWriteProgress>(file_write(file, write_view))
  read_error * 100 + write_error
}

fn stream_abort_after_read(log: i64) -[IO, Fail<IoError>, StreamAbort]> i64 {
  let mut file: owned FileHandle = file_open_read(stream_path("stream-abort"))
  let buffer = stream_buffer(1)
  let view: [mut u8] = buffer[..]
  file_read(file, view)
  mem_store64(log, mem_load64(log) * 10 + 1)
  StreamAbort.stop(42)
}

fn stream_explicit_close() -[IO, Fail<IoError>]> i64 {
  let file: owned FileHandle = file_open_read(stream_path("stream-close"))
  stream_nil_code(file_close(file))
}

fn stream_open_failure() -[IO]> i64 {
  handle {
    let file: owned FileHandle = file_open_read(stream_path("stream-missing"))
    0
  } {
    Fail.fail(error) -> io_error_kind(error)
  }
}

fn stream_native_roundtrip(path: Path) -[IO, Fail<IoError>]> i64 {
  let mut file: owned FileHandle = file_open_read_write(path)
  let source = vector_new<u8>()
  vector_push<u8>(source, stream_byte(0))
  vector_push<u8>(source, stream_byte(255))
  vector_push<u8>(source, stream_byte(65))
  let source_view: [u8] = source[..]
  let wrote = stream_write_count(file_write(file, source_view))
  let flushed = stream_nil_code(file_flush(file))
  let sought = stream_seek_position(file_seek(file, 0, FileSeekStart))
  let out = stream_buffer(3)
  let out_view: [mut u8] = out[..]
  let read = stream_read_count(file_read(file, out_view))
  wrote * 1000000 + flushed * 100000 + sought * 10000 + read * 1000 +
    stream_byte_i64(vector_get_in_bounds<u8>(out, 0)) * 100 +
    stream_byte_i64(vector_get_in_bounds<u8>(out, 1)) +
    stream_byte_i64(vector_get_in_bounds<u8>(out, 2))
}

fn stream_open_modes() -[IO, Fail<IoError>]> i64 {
  let read_file: owned FileHandle = file_open_read(stream_path("stream-read"))
  let read_closed = stream_nil_code(file_close(read_file))
  let write_file: owned FileHandle = file_open_write(stream_path("stream-write"))
  let write_closed = stream_nil_code(file_close(write_file))
  let read_write_file: owned FileHandle = file_open_read_write(stream_path("stream-read-write"))
  let read_write_closed = stream_nil_code(file_close(read_write_file))
  let append_file: owned FileHandle = file_open_append(stream_path("stream-append"))
  let append_closed = stream_nil_code(file_close(append_file))
  read_closed + write_closed + read_write_closed + append_closed
}

fn stream_seek_origins() -[IO, Fail<IoError>]> i64 {
  let mut file: owned FileHandle = file_open_read_write(stream_path("stream-seek"))
  let start = stream_seek_position(file_seek(file, 1, FileSeekStart))
  let current = stream_seek_position(file_seek(file, 2, FileSeekCurrent))
  let end = stream_seek_position(file_seek(file, 3, FileSeekEnd))
  file_close(file)
  start + current + end
}

test "file stream open variants select semantic handler operations" {
  let arena = arena_new(64)
  let state = arena_alloc(arena, 40, 8)
  for offset in 0..5 { mem_store64(state + offset * 8, 0) }
  let got = handle {
    handle stream_open_modes() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read(path) -> { mem_store64(state, 1) resume(7) }
    IO.open_write(path) -> { mem_store64(state + 8, 1) resume(8) }
    IO.open_read_write(path) -> { mem_store64(state + 16, 1) resume(9) }
    IO.open_append(path) -> { mem_store64(state + 24, 1) resume(10) }
    IO.close(fd) -> { mem_store64(state + 32, mem_load64(state + 32) + 1) resume(0) }
  }
  Test.assert_eq(got, 4)
  Test.assert_eq(mem_load64(state), 1)
  Test.assert_eq(mem_load64(state + 8), 1)
  Test.assert_eq(mem_load64(state + 16), 1)
  Test.assert_eq(mem_load64(state + 24), 1)
  Test.assert_eq(mem_load64(state + 32), 4)
  arena_free(arena)
}

test "file stream seek variants select semantic handler operations" {
  let arena = arena_new(64)
  let state = arena_alloc(arena, 32, 8)
  for offset in 0..4 { mem_store64(state + offset * 8, 0) }
  let got = handle {
    handle stream_seek_origins() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read_write(path) -> resume(7)
    IO.seek_start(fd, offset) -> { mem_store64(state, offset) resume(10 + offset) }
    IO.seek_current(fd, offset) -> { mem_store64(state + 8, offset) resume(20 + offset) }
    IO.seek_end(fd, offset) -> { mem_store64(state + 16, offset) resume(30 + offset) }
    IO.close(fd) -> { mem_store64(state + 24, mem_load64(state + 24) + 1) resume(0) }
  }
  Test.assert_eq(got, 66)
  Test.assert_eq(mem_load64(state), 1)
  Test.assert_eq(mem_load64(state + 8), 2)
  Test.assert_eq(mem_load64(state + 16), 3)
  Test.assert_eq(mem_load64(state + 24), 1)
  arena_free(arena)
}

test "file stream reuses one owner across write read read seek and flush" {
  let arena = arena_new(128)
  let state = arena_alloc(arena, 24, 8)
  mem_store64(state, 0)
  mem_store64(state + 8, 0)
  mem_store64(state + 16, 0)
  let out = stream_buffer(4)
  let got = handle {
    handle stream_sequence(out) { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read_write(path) -> {
      mem_store64(state, mem_load64(state) * 10 + 1)
      mem_store64(state + 16, 3)
      resume(7)
    }
    IO.write(fd, buf, len) -> {
      mem_store64(state, mem_load64(state) * 10 + 2)
      mem_store64(state + 8, mem_load8(buf) + mem_load8(buf + 1) + mem_load8(buf + 2))
      resume(len)
    }
    IO.read(fd, buf, len) -> {
      let call = if mem_load64(state) == 12 { 0 } else { 1 }
      mem_store64(state, mem_load64(state) * 10 + 3 + call)
      mem_store8(buf, if call == 0 { 65 } else { 67 })
      mem_store8(buf + 1, if call == 0 { 66 } else { 68 })
      resume(2)
    }
    IO.seek_start(fd, offset) -> {
      mem_store64(state, mem_load64(state) * 10 + 5)
      resume(offset)
    }
    IO.flush(fd) -> {
      mem_store64(state, mem_load64(state) * 10 + 6)
      resume(0)
    }
    IO.close(fd) -> {
      mem_store64(state, mem_load64(state) * 10 + 7)
      resume(0)
    }
  }
  Test.assert_eq(got, 8)
  Test.assert_eq(mem_load64(state), 1234567)
  Test.assert_eq(mem_load64(state + 8), 363)
  Test.assert_eq(mem_load64(state + 16), 3)
  Test.assert_eq(stream_byte_i64(vector_get_in_bounds<u8>(out, 0)), 65)
  Test.assert_eq(stream_byte_i64(vector_get_in_bounds<u8>(out, 3)), 68)
  arena_free(arena)
}

test "file stream failures preserve the owner for one final close" {
  let arena = arena_new(64)
  let closes = arena_alloc(arena, 8, 8)
  mem_store64(closes, 0)
  let got = handle {
    handle stream_failure_sequence() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read_write(path) -> resume(8)
    IO.read(fd, buf, len) -> resume(0 - 13)
    IO.write(fd, buf, len) -> resume(0 - 13)
    IO.seek_start(fd, offset) -> resume(0 - 22)
    IO.flush(fd) -> resume(0 - 13)
    IO.close(fd) -> { mem_store64(closes, mem_load64(closes) + 1) resume(0) }
  }
  Test.assert_eq(got, 19)
  Test.assert_eq(mem_load64(closes), 1)
  arena_free(arena)
}

test "file stream rejects impossible platform progress and closes once" {
  let arena = arena_new(64)
  let closes = arena_alloc(arena, 8, 8)
  mem_store64(closes, 0)
  let got = handle {
    handle stream_over_progress() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read_write(path) -> resume(9)
    IO.read(fd, buf, len) -> resume(len + 1)
    IO.write(fd, buf, len) -> resume(len + 1)
    IO.close(fd) -> { mem_store64(closes, mem_load64(closes) + 1) resume(0) }
  }
  Test.assert_eq(got, 1111)
  Test.assert_eq(mem_load64(closes), 1)
  arena_free(arena)
}

test "file stream abort after a borrowed read closes exactly once" {
  let arena = arena_new(64)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(log, 0)
  let got = handle {
    handle {
      handle stream_abort_after_read(log) { Fail.fail(error) -> 0 - io_error_kind(error) }
    } {
      StreamAbort.stop(value) -> value
    }
  } {
    IO.open_read(path) -> resume(7)
    IO.read(fd, buf, len) -> { mem_store8(buf, 65) resume(1) }
    IO.close(fd) -> { mem_store64(log, mem_load64(log) * 10 + 7) resume(0) }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(mem_load64(log), 17)
  arena_free(arena)
}

test "explicit file close consumes the owner without a second Drop" {
  let arena = arena_new(64)
  let closes = arena_alloc(arena, 8, 8)
  mem_store64(closes, 0)
  let got = handle {
    handle stream_explicit_close() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read(path) -> resume(7)
    IO.close(fd) -> { mem_store64(closes, mem_load64(closes) + 1) resume(0) }
  }
  Test.assert_eq(got, 1)
  Test.assert_eq(mem_load64(closes), 1)
  arena_free(arena)
}

test "explicit file close failure still consumes the owner once" {
  let arena = arena_new(64)
  let closes = arena_alloc(arena, 8, 8)
  mem_store64(closes, 0)
  let got = handle {
    handle stream_explicit_close() { Fail.fail(error) -> 0 - io_error_kind(error) }
  } {
    IO.open_read(path) -> resume(7)
    IO.close(fd) -> { mem_store64(closes, mem_load64(closes) + 1) resume(0 - 13) }
  }
  Test.assert_eq(got, 0 - 4)
  Test.assert_eq(mem_load64(closes), 1)
  arena_free(arena)
}

test "file open failure is typed and creates no close obligation" {
  let arena = arena_new(64)
  let closes = arena_alloc(arena, 8, 8)
  mem_store64(closes, 0)
  let got = handle stream_open_failure() {
    IO.open_read(path) -> resume(0 - 2)
    IO.close(fd) -> { mem_store64(closes, mem_load64(closes) + 1) resume(0) }
  }
  Test.assert_eq(got, 3)
  Test.assert_eq(mem_load64(closes), 0)
  arena_free(arena)
}

test "native file stream roundtrip includes NUL seek and flush" {
  let raw_path = "/tmp/weft-file-streaming.bin"
  raw_remove(raw_path)
  let path = stream_path(raw_path)
  let got = with_raw_io_i64(() => handle stream_native_roundtrip(path) {
    Fail.fail(error) -> 0 - io_error_kind(error)
  })
  let removed = raw_remove(raw_path)
  Test.assert_eq(got, 3103320)
  Test.assert_eq(removed, 0)
}
