use stdlib/num as num
use stdlib/num.{*}
use stdlib/test.{Test}
use stdlib/state as state
use stdlib/state.{State}

type Temperature = opaque f32
type Reading { value: Temperature }

fn negate32(value: f32) -> f32 { -value }
fn negate64(value: f64) -> f64 { -value }
fn contextual_negative32() -> f32 { -3.5 }
fn negate_branch32(value: f32, first: bool) -> f32 {
  -(if first { value } else { return value })
}

effect Sample { fn read() -> f32 }

fn negative_sample() -[Sample]> f32 { -Sample.read() }

test "floating negation reverses the sign of literal zero" {
  let narrow: f32 = -0.0
  let wide = -0.0
  Test.assert_true(narrow.to_bits() == 2147483648)
  Test.assert_true(wide.to_bits() == 9223372036854775808)
  Test.assert_eq_f64(contextual_negative32().to_f64(), -3.5)
}

test "f32 negation preserves every non-sign bit across IEEE classes" {
  let patterns: [u32; 12] = [0, 2147483648, 1, 2147483649, 8388607, 8388608,
    1065353216, 2139095040, 4286578688, 2143363909, 2139169605, 4286653253]
  for bits in patterns {
    let value = num.f32_from_bits(bits)
    Test.assert_true(negate32(value).to_bits() == (bits bxor 2147483648))
    Test.assert_true(negate32(negate32(value)).to_bits() == bits)
  }
}

test "f64 negation preserves every non-sign bit across IEEE classes" {
  let patterns: [u64; 12] = [0, 9223372036854775808, 1, 9223372036854775809,
    4503599627370495, 4503599627370496, 4607182418800017408,
    9218868437227405312, 18442240474082181120, 9221140253039434428,
    9218899782287415996, 18442271819142191804]
  for bits in patterns {
    let value = num.f64_from_bits(bits)
    Test.assert_true(negate64(value).to_bits() == (bits bxor 9223372036854775808))
    Test.assert_true(negate64(negate64(value)).to_bits() == bits)
  }
}

test "explicit floating subtraction retains IEEE zero semantics" {
  let zero32: f32 = 0.0
  let zero64: f64 = 0.0
  Test.assert_true((zero32 - zero32).to_bits() == 0)
  Test.assert_true((zero64 - zero64).to_bits() == 0)
  Test.assert_true((-zero32).to_bits() == 2147483648)
  Test.assert_true((-zero64).to_bits() == 9223372036854775808)
}

test "opaque floating construction and indexed snapshots preserve negation" {
  let mut values = [Reading { value: Temperature(-0.0) }]
  let snapshot = values[0]
  values[0] = snapshot.{value: Temperature(3.5)}
  match snapshot.value {
    Temperature(value) -> Test.assert_true(value.to_bits() == 2147483648)
  }
  match values[0].value {
    Temperature(value) -> Test.assert_eq_f64(value.to_f64(), 3.5)
  }
}

test "numeric negation follows branch completion and early return" {
  let zero: f32 = 0.0
  Test.assert_true(negate_branch32(zero, true).to_bits() == 2147483648)
  Test.assert_true(negate_branch32(zero, false).to_bits() == 0)
  let selected: f32 = -(match true { true -> 0.0 false -> 3.5 })
  Test.assert_true(selected.to_bits() == 2147483648)
}

test "negated effect operands execute once and preserve handler abort" {
  let (resumed, reads) = state.run(0, () => handle negative_sample() {
    Sample.read() -> { State.put(State.get() + 1); resume(0.0) }
  })
  Test.assert_true(resumed.to_bits() == 2147483648)
  Test.assert_eq(reads, 1)
  let (aborted, total) = state.run(reads, () => handle negative_sample() {
    Sample.read() -> { State.put(State.get() + 1); let result: f32 = 2.5; result }
  })
  Test.assert_eq_f64(aborted.to_f64(), 2.5)
  Test.assert_eq(total, 2)
}

test "closures retain values read beneath numeric negation" {
  let reading = Reading { value: Temperature(0.0) }
  let captured = () => match reading.value { Temperature(value) -> -value }
  Test.assert_true(captured().to_bits() == 2147483648)
  let from_block: f64 = -{ let value = 3.5; value }
  Test.assert_eq_f64(from_block, -3.5)
}

test "integer negation wraps at the operand width" {
  let small: i8 = -128
  let medium: i16 = -32768
  let large: i32 = -2147483648
  let wide: i64 = -9223372036854775808
  let unsigned: u8 = 1
  Test.assert_true(-small == small)
  Test.assert_true(-medium == medium)
  Test.assert_true(-large == large)
  Test.assert_eq(-wide, wide)
  Test.assert_true(-unsigned == 255)
  let ordinary: i16 = 42
  Test.assert_true(-ordinary == -42)
}
