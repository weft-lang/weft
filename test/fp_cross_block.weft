use stdlib/test.{Test}
use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/drop.{Drop}
use stdlib/num.{*}
use stdlib/math
use stdlib/vector as vector
use stdlib/vector.{Vector}

fn fp_branch_table() -> F64Table {
  let table = f64_table.zeros(1, 3).unwrap()
  table.set(0, 0, 1.5)
  table.set(0, 1, 2.5)
  table.set(0, 2, 4.5)
  table
}

fn fp_branch_join(table: F64Table, choose: bool) -> f64 {
  let first = table.get(0, 0).unwrap()
  let middle = if choose { table.get(0, 1).unwrap() } else { table.get(0, 2).unwrap() }
  let last = table.get(0, 2).unwrap()
  (first + middle) * (last - first)
}

test "floating values survive either branch of a checked join" {
  let table = fp_branch_table()
  Test.assert_true(fp_branch_join(table, true) == 12.0)
  Test.assert_true(fp_branch_join(table, false) == 18.0)
}

fn fp_nested_windows(table: F64Table, outer: i64, inner: i64) -> f64 {
  let mut total = 0.0
  for i in 0..outer {
    let anchor = table.get(0, 0).unwrap() + i.to_f64()
    for j in 0..inner {
      let other = table.get(0, if j % 2 == 0 { 1 } else { 2 }).unwrap()
      total = total + anchor * other
    }
    let last = table.get(0, 2).unwrap()
    total = total + anchor * last
  }
  total
}

test "floating occupancy includes enclosing loops and their zero-trip paths" {
  let table = fp_branch_table()
  Test.assert_true(fp_nested_windows(table, 0, 4) == 0.0)
  Test.assert_true(fp_nested_windows(table, 1, 0) == 6.75)
  Test.assert_true(fp_nested_windows(table, 3, 4) == 138.75)
}

fn fp_pressure_table() -> F64Table {
  let table = f64_table.zeros(1, 20).unwrap()
  for column in 0..20 { table.set(0, column, (column.to_f64() + 1.0) * 0.5) }
  table
}

fn fp_pressure(table: F64Table) -> f64 {
  let a = table.get(0, 0).unwrap()
  let b = table.get(0, 1).unwrap()
  let c = table.get(0, 2).unwrap()
  let d = table.get(0, 3).unwrap()
  let e = table.get(0, 4).unwrap()
  let f = table.get(0, 5).unwrap()
  let g = table.get(0, 6).unwrap()
  let h = table.get(0, 7).unwrap()
  let i = table.get(0, 8).unwrap()
  let j = table.get(0, 9).unwrap()
  let k = table.get(0, 10).unwrap()
  let l = table.get(0, 11).unwrap()
  let m = table.get(0, 12).unwrap()
  let n = table.get(0, 13).unwrap()
  let o = table.get(0, 14).unwrap()
  let p = table.get(0, 15).unwrap()
  let q = table.get(0, 16).unwrap()
  let r = table.get(0, 17).unwrap()
  let s = table.get(0, 18).unwrap()
  let t = table.get(0, 19).unwrap()
  a * b + c * d + e * f + g * h + i * j + k * l + m * n + o * p + q * r + s * t
}

test "overlapping floating lifetimes remain correct under register pressure" {
  Test.assert_true(fp_pressure(fp_pressure_table()) == 357.5)
}

fn fp_mutating_call(table: F64Table, count: i64) -> i64 {
  for i in 0..count { table.set(0, 11, table.get(0, 11).unwrap() + 1.0) }
  count
}

fn fp_across_call(table: F64Table, count: i64) -> f64 {
  let before = table.get(0, 0).unwrap() * 2.0
  let changed = fp_mutating_call(table, count)
  let after = table.get(0, 11).unwrap()
  if changed == count { before + after } else { 0.0 }
}

test "preserved floating registers survive ordinary calls and later checks" {
  Test.assert_true(fp_across_call(fp_pressure_table(), 0) == 7.0)
  Test.assert_true(fp_across_call(fp_pressure_table(), 5) == 12.0)
}

fn fp_mixed_use(table: F64Table, choose: bool) -> (f64, u64) {
  let value = table.get(0, 0).unwrap()
  let extra = table.get(0, if choose { 1 } else { 2 }).unwrap()
  let product = value * extra
  (product, value.to_bits())
}

test "mixed floating and integer representation uses preserve exact bits" {
  let table = fp_branch_table()
  let patterns: [u64; 5] = [0, 9223372036854775808, 4607182418800017408, 9218868437227405312, 9221120237041090626]
  for bits in patterns {
    table.set(0, 0, f64_from_bits(bits))
    for choose in [true, false] {
      let (product, original) = fp_mixed_use(table, choose)
      Test.assert_true(original == bits)
      let expected = f64_from_bits(bits) * (if choose { 2.5 } else { 4.5 })
      if expected.is_nan() { Test.assert_true(product.is_nan()) }
      else { Test.assert_true(product.to_bits() == expected.to_bits()) }
    }
  }
}

type FpDropProbe { log: F64Table }

impl Drop for FpDropProbe {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    nil
  }
}

fn fp_early_cleanup(table: F64Table, log: F64Table, early: bool) -> f64 {
  let guard: owned FpDropProbe = FpDropProbe { log: log }
  let first = table.get(0, 0).unwrap() * 2.0
  let middle = table.get(0, 1).unwrap()
  if early { return first + middle } else { nil }
  let last = table.get(0, 2).unwrap()
  first * last + middle
}

test "floating branch lifetimes preserve owned cleanup on early and normal return" {
  let table = fp_branch_table()
  for early in [true, false] {
    let log = f64_table.zeros(1, 1).unwrap()
    Test.assert_true(fp_early_cleanup(table, log, early) == (if early { 5.5 } else { 16.0 }))
    Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  }
}

effect FpPause { fn step() -> i64 }

fn fp_effect_body(table: F64Table, log: F64Table) -[FpPause]> f64 {
  let guard: owned FpDropProbe = FpDropProbe { log: log }
  let first = table.get(0, 0).unwrap() * 2.0
  let step = FpPause.step()
  let last = table.get(0, 2).unwrap()
  first * last + step.to_f64()
}

test "effect boundaries retain floating results and exact abort cleanup" {
  let table = fp_branch_table()
  let resumed_log = f64_table.zeros(1, 1).unwrap()
  let aborted_log = f64_table.zeros(1, 1).unwrap()
  let resumed = handle fp_effect_body(table, resumed_log) { FpPause.step() -> resume(2) }
  let aborted = handle fp_effect_body(table, aborted_log) { FpPause.step() -> 42.0 }
  Test.assert_eq_f64(resumed, 15.5)
  Test.assert_eq_f64(aborted, 42.0)
  Test.assert_eq_f64(resumed_log.get(0, 0).unwrap(), 1.0)
  Test.assert_eq_f64(aborted_log.get(0, 0).unwrap(), 1.0)
}

fn fp_captured(table: F64Table) -> f64 {
  let first = table.get(0, 0).unwrap() * 2.0
  let read = () => first + 1.0
  let last = table.get(0, 2).unwrap()
  read() + first * last
}

test "closure capture retains its floating representation across later checks" {
  Test.assert_true(fp_captured(fp_branch_table()) == 17.5)
}

fn fp_vector_index_use(indices: borrow Vector<usize>, values: borrow mut Vector<usize>, choose: bool) -> nil {
  let index = indices.get(0).unwrap()
  if choose { values.set(index, index).unwrap() }
  else { values.set(index, index + 1).unwrap() }
  nil
}

test "vector loaded indexes remain valid addresses when reused as stored payloads across branches" {
  let mut indices = vector.new<usize>()
  indices.push(2)
  for choose in [true, false] {
    let mut values = vector.new<usize>()
    values.push(10)
    values.push(20)
    values.push(30)
    fp_vector_index_use(indices, values, choose)
    Test.assert_eq_usize(values.get(0).unwrap(), 10)
    Test.assert_eq_usize(values.get(1).unwrap(), 20)
    Test.assert_eq_usize(values.get(2).unwrap(), if choose { 2 } else { 3 })
  }
}
