use stdlib/eq.{Eq as ValueEq}

trait Eq { fn eq(self, other: Self) -> bool }

type EqualityFirst { value: i64 }

type EqualityLast { value: i64 }

impl ValueEq for EqualityFirst {
  fn eq(self, other: Self) -> bool { self.value % 10 == other.value % 10 }
}

impl Eq for EqualityFirst {
  fn eq(self, other: Self) -> bool { false }
}

impl EqualityFirst {
  pub fn eq(self, other: Self) -> bool { false }
}

impl EqualityLast {
  pub fn eq(self, other: Self) -> bool { false }
}

impl Eq for EqualityLast {
  fn eq(self, other: Self) -> bool { false }
}

impl ValueEq for EqualityLast {
  fn eq(self, other: Self) -> bool { self.value % 10 == other.value % 10 }
}

fn canonical_relation<T: ValueEq>(left: T, right: T) -> bool { left.eq(right) }

fn alternate_relation<T: Eq>(left: T, right: T) -> bool { left.eq(right) }

test "method specialization keeps the selected trait across implementation orders" {
  let first = EqualityFirst { value: 1 }
  let last = EqualityLast { value: 1 }
  Test.assert_true(canonical_relation(first, EqualityFirst { value: 11 }))
  Test.assert_true(canonical_relation(last, EqualityLast { value: 11 }))
  Test.assert_false(canonical_relation(first, EqualityFirst { value: 2 }))
  Test.assert_false(canonical_relation(last, EqualityLast { value: 2 }))
}

test "same-spelling trait methods retain separate native targets" {
  let first = EqualityFirst { value: 1 }
  let last = EqualityLast { value: 1 }
  Test.assert_false(alternate_relation(first, first))
  Test.assert_false(alternate_relation(last, last))
  Test.assert_true(canonical_relation(first, first))
  Test.assert_true(canonical_relation(last, last))
}
