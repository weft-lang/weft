use runtime/panic.{*}

test "compiler trap reason registry is complete" {
  Test.assert_str_eq(runtime_trap_reason(2), "unhandled effect or incomplete control flow")
  Test.assert_str_eq(runtime_trap_reason(3), "unresolved runtime or function reference")
  Test.assert_str_eq(runtime_trap_reason(5), "bump allocator could not grow")
  Test.assert_str_eq(runtime_trap_reason(8), "missing function specialization")
  Test.assert_str_eq(runtime_trap_reason(9), "missing method implementation")
  Test.assert_str_eq(runtime_trap_reason(16), "unknown native intrinsic")
  Test.assert_str_eq(runtime_trap_reason(18), "invalid handler or deferred function")
  Test.assert_str_eq(runtime_trap_reason(19), "invalid stack slot or closure target")
  Test.assert_str_eq(runtime_trap_reason(20), "invalid native value home")
  Test.assert_str_eq(runtime_trap_reason(21), "invalid instruction encoding or unsupported lowering")
  Test.assert_str_eq(runtime_trap_reason(22), "invalid control-flow lowering")
  Test.assert_str_eq(runtime_trap_reason(23), "invalid generic specialization lowering")
  Test.assert_str_eq(runtime_trap_reason(24), "missing handler abort landing")
  Test.assert_str_eq(runtime_trap_reason(25), "invalid call result lane")
  Test.assert_str_eq(runtime_trap_reason(26), "invalid return lane or abort cleanup chain")
  Test.assert_str_eq(runtime_trap_reason(27), "missing abort cleanup function")
  Test.assert_str_eq(runtime_trap_reason(28), "invalid array drop plan")
  Test.assert_str_eq(runtime_trap_reason(29), "invalid array storage plan")
  Test.assert_str_eq(runtime_trap_reason(30), "invalid array copy plan")
  Test.assert_str_eq(runtime_trap_reason(31), "missing entry point or invalid record-array layout")
  Test.assert_str_eq(runtime_trap_reason(32), "unmatched value or invalid record-array load")
  Test.assert_str_eq(runtime_trap_reason(33), "invalid lambda or record-array store lowering")
  Test.assert_str_eq(runtime_trap_reason(34), "invalid record-field layout or drop target")
  Test.assert_str_eq(runtime_trap_reason(35), "invalid optional-projection layout")
  Test.assert_str_eq(runtime_trap_reason(62), "native call argument window overflow")
  Test.assert_str_eq(runtime_trap_reason(999), "internal compiler invariant")
}
