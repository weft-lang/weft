use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/num.{*}
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/utf8.{utf8_string_from_scalar}

fn parse_json_value(src: str) -> Json {
  match json_parse(src) {
    Ok(value) -> value
    Err(error) -> json_null()
  }
}

fn json_parse_fails(src: str) -> bool {
  match json_parse(src) {
    Ok(value) -> false
    Err(error) -> true
  }
}

fn stringify_json(value: Json) -> str {
  json_stringify(value).expect("test JSON is finite")
}

fn json_stringify_rejects_nonfinite(value: Json) -> bool {
  match json_stringify(value) {
    Err(JsonNonFiniteNumber) -> true
    Ok(text) -> false
  }
}

fn json_option_value_kind(opt: Option<Json>) -> i64 {
  json_kind(opt.unwrap_or(json_null()))
}

fn json_roundtrip_i64_property(i: i64) -> bool {
  let n = i - 8
  let first = json_number(n)
  let text = stringify_json(first)
  match json_parse(text) {
    Ok(value) -> json_number_value(value, 999) == n
    Err(error) -> false
  }
}

fn json_float_bits(source: str) -> u64 {
  num_f64_to_bits(json_float_value(parse_json_value(source), 0.0))
}

fn json_float_roundtrips(bits: u64) -> bool {
  let rendered = stringify_json(json_float(num_f64_from_bits(bits)))
  match json_parse(rendered) {
    Ok(value) -> num_f64_to_bits(json_float_value(value, 0.0)) == bits
    Err(error) -> false
  }
}

test "json_parse_scalar_happy_paths" {
  let n = parse_json_value("-42")
  let max = parse_json_value("9223372036854775807")
  let t = parse_json_value(" true ")
  let f = parse_json_value("false")
  let s = parse_json_value("\"weft\"")
  let z = parse_json_value("null")
  Test.assert_eq(json_kind(n), 2)
  Test.assert_eq(json_number_value(n, 0), 0 - 42)
  Test.assert_str_eq(stringify_json(max), "9223372036854775807")
  Test.assert_eq(json_bool_value(t, 0), 1)
  Test.assert_eq(json_bool_value(f, 1), 0)
  Test.assert_str_eq(json_string_value(s, ""), "weft")
  Test.assert_eq(json_kind(z), 0)
}

test "json parses fractional exponent and signed-zero numbers" {
  Test.assert_true(json_float_bits("1.5") == 4609434218613702656)
  Test.assert_true(json_float_bits("1e-3") == 4562254508917369340)
  Test.assert_true(json_float_bits("5e-324") == 1)
  Test.assert_true(json_float_bits("-0") == 9223372036854775808)
  Test.assert_true(json_float_bits("9223372036854775808") == 4890909195324358656)
}

test "json float stringify is deterministic and roundtrips values" {
  Test.assert_str_eq(stringify_json(json_float(1.5)), "1.5")
  Test.assert_str_eq(stringify_json(json_float(1e-7)), "1e-7")
  Test.assert_str_eq(stringify_json(json_float(num_f64_from_bits(1))), "5e-324")
  Test.assert_str_eq(stringify_json(json_float(num_f64_from_bits(9218868437227405311))), "1.7976931348623157e308")
  Test.assert_true(json_float_roundtrips(1))
  Test.assert_true(json_float_roundtrips(4503599627370495))
  Test.assert_true(json_float_roundtrips(4503599627370496))
  Test.assert_true(json_float_roundtrips(4607182418800017409))
  Test.assert_true(json_float_roundtrips(9218868437227405311))
  Test.assert_true(json_float_roundtrips(9223372036854775808))
}

test "json_parse_array_happy_paths" {
  let arr = parse_json_value("[1, 2, 3]")
  let first = json_array_get(arr, 0).unwrap_or(json_null())
  let third = json_array_get(arr, 2).unwrap_or(json_null())
  Test.assert_eq(json_kind(arr), 4)
  Test.assert_eq(json_array_len(arr), 3)
  Test.assert_eq(json_number_value(first, 0), 1)
  Test.assert_eq(json_number_value(third, 0), 3)
}

test "json_parse_object_happy_paths" {
  let obj = parse_json_value("{\"name\":\"weft\",\"count\":42,\"ok\":true,\"items\":[1,2]}")
  let items = json_object_get(obj, "items").unwrap_or(json_null())
  Test.assert_eq(json_kind(obj), 5)
  Test.assert_eq(json_object_len(obj), 4)
  Test.assert_str_eq(json_object_get_str(obj, "name", ""), "weft")
  Test.assert_eq(json_object_get_i64(obj, "count", 0), 42)
  Test.assert_eq(json_object_get_bool(obj, "ok", 0), 1)
  Test.assert_eq(json_array_len(items), 2)
}

test "json_string_escapes_and_raw_unicode" {
  let escaped = parse_json_value("\"a\\nb\\\"c\\\\d\\t\"")
  let unicode = parse_json_value("\"Ω\"")
  let unicode_escape = parse_json_value("\"\\u03A9 \\u20AC \\u007A\"")
  let control_escape = parse_json_value("\"\\u0001\\b\\f\"")
  Test.assert_str_eq(json_string_value(escaped, ""), "a\nb\"c\\d\t")
  Test.assert_str_eq(stringify_json(escaped), "\"a\\nb\\\"c\\\\d\\t\"")
  Test.assert_str_eq(json_string_value(unicode, ""), "Ω")
  Test.assert_str_eq(stringify_json(unicode), "\"Ω\"")
  Test.assert_str_eq(json_string_value(unicode_escape, ""), "Ω € z")
  Test.assert_str_eq(stringify_json(unicode_escape), "\"Ω € z\"")
  Test.assert_str_eq(stringify_json(control_escape), "\"\\u0001\\b\\f\"")
}

test "json_surrogate_pairs_decode every supplementary boundary" {
  let first = parse_json_value("\"\\uD800\\uDC00\"")
  let clef = parse_json_value("\"\\uD834\\uDD1E\"")
  let emoji = parse_json_value("\"\\uD83D\\uDC69\"")
  let last = parse_json_value("\"\\uDBFF\\uDFFF\"")
  Test.assert_str_eq(json_string_value(first, ""), "𐀀")
  Test.assert_str_eq(json_string_value(clef, ""), "𝄞")
  Test.assert_str_eq(json_string_value(emoji, ""), "👩")
  Test.assert_str_eq(json_string_value(last, ""), utf8_string_from_scalar(1114111))
}

test "json escaped and raw Unicode strings share scalar identity" {
  let escaped = parse_json_value("\"A\\u03A9\\uD83D\\uDC69\\u2028Z\"")
  let raw = json_string("AΩ👩 Z")
  Test.assert_str_eq(json_string_value(escaped, ""), json_string_value(raw, ""))
  Test.assert_str_eq(stringify_json(escaped), "\"AΩ👩 Z\"")
  Test.assert_str_eq(json_string_value(parse_json_value(stringify_json(raw)), ""), "AΩ👩 Z")
}

test "json escaped object keys compare after decoding" {
  let obj = parse_json_value("{\"\\u006E\\u0061me\":\"\\uD83D\\uDC69\"}")
  Test.assert_str_eq(json_object_get_str(obj, "name", ""), "👩")
}

test "json_access_missing_and_wrong_type_sad_paths" {
  let obj = parse_json_value("{\"n\":1,\"s\":\"one\"}")
  let arr = parse_json_value("[10]")
  Test.assert_true(json_object_get(obj, "missing").is_none())
  Test.assert_eq(json_object_get_i64(obj, "s", 99), 99)
  Test.assert_str_eq(json_object_get_str(obj, "n", "fallback"), "fallback")
  Test.assert_true(json_array_get(arr, 1).is_none())
  Test.assert_true(json_array_get(arr, 0 - 1).is_none())
}

test "json_parse_malformed_sad_paths" {
  Test.assert_true(json_parse_fails(""))
  Test.assert_true(json_parse_fails("{"))
  Test.assert_true(json_parse_fails("{\"a\" 1}"))
  Test.assert_true(json_parse_fails("[1,]"))
  Test.assert_true(json_parse_fails("\"unterminated"))
  Test.assert_true(json_parse_fails("\"\\q\""))
  Test.assert_true(json_parse_fails("01"))
  Test.assert_true(json_parse_fails("+1"))
  Test.assert_true(json_parse_fails(".5"))
  Test.assert_true(json_parse_fails("1."))
  Test.assert_true(json_parse_fails("1e"))
  Test.assert_true(json_parse_fails("1e+"))
  Test.assert_true(json_parse_fails("1e309"))
  Test.assert_true(json_parse_fails("\"\\u12X4\""))
  Test.assert_true(json_parse_fails("\"\\uD800\""))
  Test.assert_true(json_parse_fails("\"\\uDC00\""))
  Test.assert_true(json_parse_fails("\"\\uD800x\""))
  Test.assert_true(json_parse_fails("\"\\uD800\\u0041\""))
  Test.assert_true(json_parse_fails("\"\\uD800\\uD800\""))
  Test.assert_true(json_parse_fails("\"\\uDC00\\uD800\""))
  Test.assert_true(json_parse_fails("\"\\uDBFF\\uE000\""))
}

test "json_parse_reports_failure_offsets" {
  match json_parse("{") {
    Err(JsonInvalidSyntax(offset)) -> Test.assert_eq(offset, 1)
    Ok(value) -> Test.assert_true(false)
  }
  match json_parse("true false") {
    Err(JsonInvalidSyntax(offset)) -> Test.assert_eq(offset, 5)
    Ok(value) -> Test.assert_true(false)
  }
}

test "json stringify rejects nonfinite values recursively" {
  let infinity = json_float(num_f64_from_bits(9218868437227405312))
  let nan = json_float(num_f64_from_bits(9221120237041090560))
  let nested = json_array(list_cons<Json>(json_number(1), list_cons<Json>(infinity, list_nil<Json>())))
  Test.assert_true(json_stringify_rejects_nonfinite(infinity))
  Test.assert_true(json_stringify_rejects_nonfinite(nan))
  Test.assert_true(json_stringify_rejects_nonfinite(nested))
  Test.assert_str_eq(stringify_json(json_float(1.25)), "1.25")
}

test "json rejects malformed raw UTF-8" {
  let text = runtime_str_alloc_uninit(4)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 34)
  mem_store8_at(data, 1, 195)
  mem_store8_at(data, 2, 40)
  mem_store8_at(data, 3, 34)
  Test.assert_true(json_parse_fails(text))
}

test "json_stringify_nested_values" {
  let arr = parse_json_value("[1,\"two\"]")
  let obj = parse_json_value("{\"items\":[1,\"two\"],\"ok\":true}")
  Test.assert_str_eq(stringify_json(arr), "[1,\"two\"]")
  Test.assert_str_eq(stringify_json(obj), "{\"items\":[1,\"two\"],\"ok\":true}")
}

test "property_json_i64_roundtrips_through_stringify" {
  Test.forall_i64_range(0, 17, json_roundtrip_i64_property)
}
