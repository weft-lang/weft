use "stdlib/json.weft"

fn parse_json_value(src: str) -> Json {
  let result = json_parse(src)
  if json_result_ok(result) == 1 { json_result_value(result) } else { json_null() }
}

fn json_option_value_kind(opt: i64) -> i64 {
  json_kind(json_option_value_or(opt, json_null()))
}

fn json_roundtrip_i64_property(i: i64) -> bool {
  let n = i - 8
  let first = json_number(n)
  let text = json_stringify(first)
  let parsed = json_parse(text)
  json_result_ok(parsed) == 1 and json_number_value(json_result_value(parsed), 999) == n
}

test "json_parse_scalar_happy_paths" {
  let n = parse_json_value("-42")
  let t = parse_json_value(" true ")
  let f = parse_json_value("false")
  let s = parse_json_value("\"weft\"")
  let z = parse_json_value("null")
  Test.assert_eq(json_kind(n), 2)
  Test.assert_eq(json_number_value(n, 0), 0 - 42)
  Test.assert_eq(json_bool_value(t, 0), 1)
  Test.assert_eq(json_bool_value(f, 1), 0)
  Test.assert_str_eq(json_string_value(s, ""), "weft")
  Test.assert_eq(json_kind(z), 0)
}

test "json_parse_array_happy_paths" {
  let arr = parse_json_value("[1, 2, 3]")
  let first = json_option_value_or(json_array_get(arr, 0), json_null())
  let third = json_option_value_or(json_array_get(arr, 2), json_null())
  Test.assert_eq(json_kind(arr), 4)
  Test.assert_eq(json_array_len(arr), 3)
  Test.assert_eq(json_number_value(first, 0), 1)
  Test.assert_eq(json_number_value(third, 0), 3)
}

test "json_parse_object_happy_paths" {
  let obj = parse_json_value("{\"name\":\"weft\",\"count\":42,\"ok\":true,\"items\":[1,2]}")
  let items = json_option_value_or(json_object_get(obj, "items"), json_null())
  Test.assert_eq(json_kind(obj), 5)
  Test.assert_eq(json_object_len(obj), 4)
  Test.assert_str_eq(json_object_get_str(obj, "name", ""), "weft")
  Test.assert_eq(json_object_get_i64(obj, "count", 0), 42)
  Test.assert_eq(json_object_get_bool(obj, "ok", 0), 1)
  Test.assert_eq(json_array_len(items), 2)
}

test "json_string_escapes_and_raw_unicode" {
  let escaped = parse_json_value("\"a\\nb\\\"c\\\\d\\t\"")
  let unicode = parse_json_value("\"Ω\"")
  Test.assert_str_eq(json_string_value(escaped, ""), "a\nb\"c\\d\t")
  Test.assert_str_eq(json_stringify(escaped), "\"a\\nb\\\"c\\\\d\\t\"")
  Test.assert_str_eq(json_string_value(unicode, ""), "Ω")
  Test.assert_str_eq(json_stringify(unicode), "\"Ω\"")
}

test "json_access_missing_and_wrong_type_sad_paths" {
  let obj = parse_json_value("{\"n\":1,\"s\":\"one\"}")
  let arr = parse_json_value("[10]")
  Test.assert_eq(json_option_is_some(json_object_get(obj, "missing")), 0)
  Test.assert_eq(json_object_get_i64(obj, "s", 99), 99)
  Test.assert_str_eq(json_object_get_str(obj, "n", "fallback"), "fallback")
  Test.assert_eq(json_option_is_some(json_array_get(arr, 1)), 0)
  Test.assert_eq(json_option_is_some(json_array_get(arr, 0 - 1)), 0)
}

test "json_parse_malformed_sad_paths" {
  Test.assert_eq(json_result_ok(json_parse("")), 0)
  Test.assert_eq(json_result_ok(json_parse("{")), 0)
  Test.assert_eq(json_result_ok(json_parse("{\"a\" 1}")), 0)
  Test.assert_eq(json_result_ok(json_parse("[1,]")), 0)
  Test.assert_eq(json_result_ok(json_parse("\"unterminated")), 0)
  Test.assert_eq(json_result_ok(json_parse("\"\\q\"")), 0)
  Test.assert_eq(json_result_ok(json_parse("01")), 0)
  Test.assert_eq(json_result_ok(json_parse("1.5")), 0)
  Test.assert_eq(json_result_ok(json_parse("\"\\u03A9\"")), 0)
}

test "json_stringify_constructed_values" {
  let items = vector_new<Json>()
  vector_push<Json>(items, json_number(1))
  vector_push<Json>(items, json_string("two"))
  let entries = vector_new<JsonEntry>()
  vector_push<JsonEntry>(entries, json_entry("items", json_array(items)))
  vector_push<JsonEntry>(entries, json_entry("ok", json_bool(1)))
  Test.assert_str_eq(json_stringify(json_array(items)), "[1,\"two\"]")
  Test.assert_str_eq(json_stringify(json_object(entries)), "{\"items\":[1,\"two\"],\"ok\":true}")
}

test "property_json_i64_roundtrips_through_stringify" {
  Test.forall_i64_range(0, 17, json_roundtrip_i64_property)
}
