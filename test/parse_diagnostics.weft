-- Stable parser diagnostics, exact source facts, and bounded recovery.

use stdlib/num
use stdlib/result.{Result}
use compiler/diagnostic/render.{*}
use compiler/storage.{*}
use compiler/weft/check/table.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/string.{str_eq, str_find, str_find_from, str_concat}

fn parse_diag_text(fields: DiagnosticFieldList, key: str) -> str {
  match fields {
    DiagnosticFieldNil -> ""
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { parse_diag_text(rest, key) }
      _ -> parse_diag_text(rest, key)
    }
  }
}

fn parse_diag_i64(fields: DiagnosticFieldList, key: str, fallback: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldI64(name, value) -> if str_eq(name, key) == 1 { value } else { parse_diag_i64(rest, key, fallback) }
      _ -> parse_diag_i64(rest, key, fallback)
    }
  }
}

fn parse_diag_open_matches(related: DiagnosticRelatedLocationList, src: i64, start: i64) -> i64 {
  match related {
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), DiagnosticRelatedLocationNil) -> match location {
      DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> {
        if str_eq(label, "construct opened here") == 1 and source == src and actual_start == (start).to_usize_checked().unwrap() and actual_end == (start + 1).to_usize_checked().unwrap() { 1 } else { 0 }
      }
      _ -> 0
    }
    _ -> 0
  }
}

fn parse_diag_edit_matches(fields: DiagnosticFieldList, src: i64, start: i64, replacement: str) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, edits)) -> {
        let applicable = match applicability { DiagnosticSuggestionMachineApplicable -> 1 _ -> 0 }
        let edit = match edits {
          DiagnosticTextEditCons(DiagnosticTextEdit(location, actual_replacement), DiagnosticTextEditNil) -> match location {
            DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> {
              if source == src and actual_start == (start).to_usize_checked().unwrap() and actual_end == (start).to_usize_checked().unwrap() and str_eq(actual_replacement, replacement) == 1 { 1 } else { 0 }
            }
            _ -> 0
          }
          _ -> 0
        }
        if str_eq(message, "insert the missing closing delimiter") == 1 and applicable == 1 and edit == 1 { 1 } else { 0 }
      }
      _ -> parse_diag_edit_matches(rest, src, start, replacement)
    }
  }
}

fn parse_diag_matches(
  diagnostic: Diagnostic,
  src: i64,
  code: str,
  message: str,
  start: i64,
  end: i64,
  reason: str,
  context: str,
  expectation: str,
  found: str,
  recovery: str,
  open_start: i64,
  replacement: str
) -> i64 {
  let fields = diagnostic.fields()
  let primary = match diagnostic.primary() {
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> if source == src and actual_start == (start).to_usize_checked().unwrap() and actual_end == (end).to_usize_checked().unwrap() { 1 } else { 0 }
    _ -> 0
  }
  let related = if open_start >= 0 { parse_diag_open_matches(diagnostic.related(), src, open_start) }
    else { if diagnostic.related().len() == 0 { 1 } else { 0 } }
  let suggestion = if __str_len(replacement) > 0 { parse_diag_edit_matches(fields, src, start, replacement) }
    else { if fields.suggestion_count() == 0 { 1 } else { 0 } }
  if diagnostic.code().eq(DiagnosticCodeAssigned(code)) and
    str_eq(diagnostic.class().name(), "parse") == 1 and
    str_eq(diagnostic.severity().name(), "error") == 1 and
    str_eq(diagnostic.message(), message) == 1 and
    primary == 1 and
    str_eq(parse_diag_text(fields, "reason"), reason) == 1 and
    str_eq(parse_diag_text(fields, "context"), context) == 1 and
    str_eq(parse_diag_text(fields, "expectation"), expectation) == 1 and
    str_eq(parse_diag_text(fields, "found"), found) == 1 and
    str_eq(parse_diag_text(fields, "recovery"), recovery) == 1 and
    related == 1 and
    suggestion == 1 { 1 } else { 0 }
}

fn parse_diag_case(
  source: str,
  code: str,
  message: str,
  start: i64,
  end: i64,
  reason: str,
  context: str,
  expectation: str,
  found: str,
  recovery: str,
  open_start: i64,
  replacement: str
) -> i64 {
  let src = __str_ptr(source)
  let observation = alloc_zeroed(24)
  let tt = ttable_new()
  let fns = handle pipeline_ast_fns(pipeline_parse_local(source_from_text(source), tt)) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic.severity().name(), "error") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        if parse_diag_matches(diagnostic, src, code, message, start, end, reason, context, expectation, found, recovery, open_start, replacement) == 1 {
          mem_store64_at(observation, 8, mem_load64_at(observation, 8) + 1)
        } else { 0 }
      } else { 0 }
      resume(0)
    }
    Diagnose.error(legacy_message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(legacy_message, span) -> resume(0)
    Diagnose.note(legacy_message, span) -> resume(0)
  }
  mem_load64_at(observation, 0) * 1000 + mem_load64_at(observation, 8) * 100 + mem_load64_at(observation, 16) * 10 + nlist_len(fns)
}

fn parse_diag_count_and_fns(source: str) -> i64 {
  let count = alloc_zeroed(8)
  let tt = ttable_new()
  let fns = handle pipeline_ast_fns(pipeline_parse_local(source_from_text(source), tt)) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic.severity().name(), "error") == 1 { mem_store64(count, mem_load64(count) + 1) } else { 0 }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  mem_load64(count) * 100 + nlist_len(fns)
}

fn parse_invalid_bytes_case(bytes: i64, len: i64, message: str, reason: str, start: i64, end: i64, byte_length: i64) -> i64 {
  let source = source_from_bytes(bytes, len)
  let src = __str_ptr(source.text)
  let observation = alloc_zeroed(16)
  let tt = ttable_new()
  let ast = handle pipeline_parse_local(source, tt) {
    Diagnose.report(diagnostic) -> {
      mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
      let primary = match diagnostic.primary() {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> if source == src and actual_start == (start).to_usize_checked().unwrap() and actual_end == (end).to_usize_checked().unwrap() { 1 } else { 0 }
        _ -> 0
      }
      if diagnostic.code().eq(DiagnosticCodeAssigned("E0001")) and
        str_eq(diagnostic.class().name(), "parse") == 1 and
        str_eq(diagnostic.message(), message) == 1 and
        primary == 1 and
        str_eq(parse_diag_text(diagnostic.fields(), "reason"), reason) == 1 and
        parse_diag_i64(diagnostic.fields(), "invalid_byte_length", 0 - 1) == byte_length {
        mem_store64_at(observation, 8, mem_load64_at(observation, 8) + 1)
      } else { 0 }
      resume(0)
    }
    Diagnose.error(legacy_message, span) -> resume(0)
    Diagnose.warn(legacy_message, span) -> resume(0)
    Diagnose.note(legacy_message, span) -> resume(0)
  }
  mem_load64_at(observation, 0) * 100 + mem_load64_at(observation, 8) * 10 + nlist_len(pipeline_ast_fns(ast))
}

test "parse diagnostic carries exact missing-delimiter edit and opener" {
  let source = "fn broken() -> i64 { 1"
  let eof = __str_len(source)
  Test.assert_eq(parse_diag_case(
    source, "E0002", "expected '}' before end of file", eof, eof,
    "missing_delimiter", "block", "}", "end of file", "resume_at_end_of_file",
    str_find(source, "{"), "}"
  ), 1101)
}

test "parse diagnostic identifies the causal match-arm token" {
  let source = "fn broken(value: i64) -> i64 { match value { _ 1 } } fn retained() -> i64 { 2 }"
  let start = str_find_from(source, "1", str_find(source, "_"))
  Test.assert_eq(parse_diag_case(
    source, "E0002", "expected '->' after match pattern", start, start + 1,
    "syntax_error", "match arm", "expected '->' after match pattern", "1", "skip_match_arm",
    0 - 1, ""
  ), 1102)
}

test "parse diagnostic ranges count Unicode bytes exactly" {
  let source = "fn join(a: i64, b: i64) -> i64 { a + b } fn broken() -> i64 { join(1 β) }"
  let start = str_find(source, "β")
  Test.assert_eq(parse_diag_case(
    source, "E0002", "expected ',' or ')' after call argument", start, start + __str_len("β"),
    "syntax_error", "argument list", "expected ',' or ')' after call argument", "β", "continue_arguments",
    0 - 1, ""
  ), 1102)
}

test "unsupported syntax is a distinct stable parse family" {
  let source = "fn target(value: i64) -> i64 { value } fn broken() -> i64 { target(value: 1) }"
  let start = str_find_from(source, "value", str_find(source, "broken"))
  Test.assert_eq(parse_diag_case(
    source, "E0003", "call-site argument labels are not supported yet", start, start + 5,
    "unsupported_syntax", "call argument", "call-site argument labels are not supported yet", "value", "continue_after_argument",
    0 - 1, ""
  ), 1102)
}

test "invalid source bytes never enter grammar recovery" {
  let invalid = alloc_zeroed(1)
  mem_store8_at(invalid, 0, 255)
  Test.assert_eq(parse_invalid_bytes_case(invalid, 1, "source is not valid UTF-8", "invalid_utf8", 0, 1, 1), 110)
  let source = "fn broken() -> i64 { $ }"
  let start = str_find(source, "$")
  Test.assert_eq(parse_invalid_bytes_case(__str_ptr(source), __str_len(source), "character is not valid Weft syntax", "invalid_character", start, start + 1, 1), 110)
  let unterminated = "fn broken() -> str { \"open"
  let quote = str_find(unterminated, "\"")
  Test.assert_eq(parse_invalid_bytes_case(__str_ptr(unterminated), __str_len(unterminated), "string literal is not terminated before end of file", "unterminated_string", quote, __str_len(unterminated), __str_len(unterminated) - quote), 110)

  let interpolation = "fn broken() -> str { i\"value {40\" }"
  let interpolation_open = str_find_from(interpolation, "{", str_find(interpolation, "value"))
  Test.assert_eq(parse_invalid_bytes_case(
    __str_ptr(interpolation), __str_len(interpolation),
    "interpolation expression is not terminated before end of string", "unterminated_interpolation",
    interpolation_open, __str_len(interpolation), __str_len(interpolation) - interpolation_open
  ), 110)

  let unmatched = "fn broken() -> str { i\"value }\" }"
  let unmatched_close = str_find(unmatched, "}")
  Test.assert_eq(parse_invalid_bytes_case(
    __str_ptr(unmatched), __str_len(unmatched),
    "single '}' is not valid in an interpolated string; write '}}' for a literal brace",
    "unmatched_interpolation_close", unmatched_close, unmatched_close + 1, 1
  ), 110)

  let backslash_brace = "fn broken() -> str { i\"value \\{literal}\" }"
  let backslash = str_find(backslash_brace, "\\")
  Test.assert_eq(parse_invalid_bytes_case(
    __str_ptr(backslash_brace), __str_len(backslash_brace),
    "backslash does not escape interpolation braces; write doubled braces instead",
    "invalid_interpolation_brace_escape", backslash, backslash + 2, 2
  ), 110)

  let backslash_close_brace = "fn broken() -> str { i\"value \\}\" }"
  let backslash_close = str_find(backslash_close_brace, "\\")
  Test.assert_eq(parse_invalid_bytes_case(
    __str_ptr(backslash_close_brace), __str_len(backslash_close_brace),
    "backslash does not escape interpolation braces; write doubled braces instead",
    "invalid_interpolation_brace_escape", backslash_close, backslash_close + 2, 2
  ), 110)
}

test "control-flow recovery reports one root and retains later functions" {
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -> i64 { if true 1 } fn retained() -> i64 { 2 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -> i64 { while true 1 } fn retained() -> i64 { 2 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken(xs: List<i64>) -> i64 { for x xs { x } 0 } fn retained() -> i64 { 2 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken(x: i64) -> i64 { match x _ -> 1 } 0 } fn retained() -> i64 { 2 }"), 102)
}

test "nested delimiter recovery suppresses causal cascades" {
  Test.assert_eq(parse_diag_count_and_fns("fn broken(x: i64) -> i64 { match x { _ -> 1"), 101)
  Test.assert_eq(parse_diag_count_and_fns("effect E { fn op() -> i64 } fn broken() -> i64 { handle E.op() { E.op() -> 1"), 101)
  Test.assert_eq(parse_diag_count_and_fns("type Pair { left: i64 } fn broken() -> Pair { Pair { left: 1"), 101)
}

test "declaration-body recovery is bounded across all member grammars" {
  Test.assert_eq(parse_diag_count_and_fns("effect Signal { fn () -> i64 } fn retained() -> i64 { 2 }"), 101)
  Test.assert_eq(parse_diag_count_and_fns("trait Measure { fn () -> i64 } fn retained() -> i64 { 2 }"), 101)
  Test.assert_eq(parse_diag_count_and_fns("type Box { value: i64 } impl Box { fn (self) -> i64 { 1 } } fn retained() -> i64 { 2 }"), 101)
}

test "generic and effect delimiter recovery retains declarations" {
  Test.assert_eq(parse_diag_count_and_fns("fn broken<T() -> i64 { 1 } fn retained() -> i64 { 2 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -[IO> i64 { 1 } fn retained() -> i64 { 2 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -> { 1 } fn retained() -> i64 { 2 }"), 102)
}

test "an invalid else alternative explains both accepted forms at its token" {
  let source = "fn broken() -> i64 { if true { 1 } else 42 } fn retained() -> i64 { 2 }"
  let start = str_find(source, "42")
  let message = "expected '{' or 'if' after 'else'"
  Test.assert_eq(parse_diag_case(
    source, "E0002", message, start, start + 2,
    "syntax_error", "else clause", message, "42", "continue_expression", -1, ""
  ), 1102)
}

test "conditional chain recovery keeps the next function after a malformed branch" {
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -> i64 { if true { 1 } else if false 2 } fn retained() -> i64 { 3 }"), 102)
  Test.assert_eq(parse_diag_count_and_fns("fn broken() -> i64 { if true { 1 } else if let Some(x) None<i64>() { x } } fn retained() -> i64 { 3 }"), 102)
}

test "numeric syntax diagnostics preserve precise issue positions and typed reasons" {
  for (literal, offset, message, reason) in [
    ("0x", 2, "numeric literal requires digits", "numeric_missing_digits"),
    ("0b102", 4, "digit is not valid in this numeric literal", "numeric_invalid_digit"),
    ("1e+_2", 3, "digit separators must occur singly between digits", "numeric_invalid_separator")
  ] {
    let source = "-- é\nfn main() -> i64 { " |> str_concat(literal) |> str_concat(" }")
    let first = str_find(source, literal)
    let at = first + offset
    let end = at + if offset < __str_len(literal) { 1 } else { 0 }
    Test.assert_eq(parse_diag_case(source, "E0002", message, at, end,
      reason, "numeric literal", message, literal, "stop_invalid_source", -1, ""), 1100)
  }
}


test "unsupported nested patterns report exact spans and retain later declarations" {
  for source in [
    "fn broken() -> i64 { match value { Box(\"é\") -> 42 } } fn retained() -> i64 { 0 }",
    "fn broken() -> i64 { match value { (_, \"é\") -> 42 } } fn retained() -> i64 { 0 }",
    "fn broken() -> i64 { match value { { field: \"é\" } -> 42 } } fn retained() -> i64 { 0 }"
  ] {
    let token = "\"é\""
    let start = str_find(source, token)
    let message = "unsupported pattern syntax"
    Test.assert_eq(parse_diag_case(source, "E0002", message, start, start + __str_len(token),
      "syntax_error", "pattern", message, token, "skip_pattern_token", -1, ""), 1102)
  }
}
use compiler/pipeline.{pipeline_parse_local, pipeline_ast_fns}
use compiler/source/input.{source_from_text, source_from_bytes}
