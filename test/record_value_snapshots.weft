use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/option.{Some, None}
use stdlib/result.{Ok, Err}
use stdlib/string.{*}
use stdlib/num as num
use stdlib/num.{*}

type Point { x: f64, y: f64 }
type PackedFlags { high: u8, signed: i8, enabled: bool }
type PackedReading { code: u8, temperature: f32, delta: i16, serial: u64 }
type NamedPoint { label: str, point: Point }
type FloatPair { wide: f64, narrow: f32 }
type Temperature = opaque f32
type Serial = opaque u64
type TypedReading { serial: Serial, temperature: Temperature }

fn replace_points(values: [mut Point]) -> f64 {
  let first = values[0]
  let second = values[1]
  values[0] = second.{x: second.x + 1.0}
  values[1] = first.{y: first.y + 2.0}
  first.x + second.y
}

fn packed_snapshot(values: [mut PackedReading]) -> PackedReading {
  let snapshot = values[0]
  values[0] = snapshot.{code: 9, temperature: 8.5, delta: -12}
  snapshot
}

fn packed_valid(value: PackedReading) -> bool {
  value.code == 250 and value.temperature == 3.5 and value.delta == -300 and value.serial == 18446744073709551615
}

fn escape_point(values: [Point]) -> Point { values[0] }
fn point_reader(value: Point) -> () -> f64 { () => value.x + value.y }

fn point_has_live_weak_reference(point: Point) -> bool {
  let reference = weak_ref(point)
  match weak_load(reference) {
    loaded: Point -> loaded == point and loaded.x == 1.0 and loaded.y == 2.0
    nil -> false
  }
}

fn expired_indexed_point() -> weak Point {
  let values = [Point { x: 1.0, y: 2.0 }]
  let point = escape_point(values[..])
  weak_ref(point)
}

effect SnapshotRead { fn read() -> Point }
effect SnapshotStop { fn stop() -> never }

test "record snapshots survive writes through the source slice" {
  let mut values = [Point { x: 1.0, y: 2.0 }, Point { x: 3.0, y: 4.0 }]
  Test.assert_true(replace_points(values[..]) == 5.0)
  Test.assert_true(values[0].x == 4.0)
  Test.assert_true(values[0].y == 4.0)
  Test.assert_true(values[1].x == 1.0)
  Test.assert_true(values[1].y == 4.0)
}

test "record array copies retain independent values after replacement" {
  let mut values = [Point { x: 1.0, y: 2.0 }]
  let original = values
  values[0] = values[0].{x: 9.0}
  Test.assert_true(original[0].x == 1.0)
  Test.assert_true(values[0].x == 9.0)
}

test "packed record snapshots preserve widths signs and field alignment" {
  let mut values = [PackedReading { code: 250, temperature: 3.5, delta: -300, serial: 18446744073709551615 }]
  let snapshot = packed_snapshot(values[..])
  Test.assert_true(packed_valid(snapshot))
  Test.assert_true(values[0].code == 9)
  Test.assert_true(values[0].temperature == 8.5)
  Test.assert_true(values[0].delta == -12)
  Test.assert_true(values[0].serial == 18446744073709551615)
}

test "vector records use the same packed value transport as arrays" {
  let mut values = vector.new<PackedReading>()
  values.push(PackedReading { code: 250, temperature: 3.5, delta: -300, serial: 18446744073709551615 })
  match values.get(0) {
    Some(snapshot) -> {
      match values.set(0, snapshot.{code: 9}) {
        Ok(previous) -> Test.assert_true(packed_valid(previous))
        Err(_) -> Test.assert_true(false)
      }
      Test.assert_true(packed_valid(snapshot))
    }
    None -> Test.assert_true(false)
  }
  match values.get(0) {
    Some(current) -> Test.assert_true(current.code == 9 and current.temperature == 3.5 and current.delta == -300)
    None -> Test.assert_true(false)
  }
}

test "packed byte and boolean fields survive vector transport" {
  let mut values = vector.new<PackedFlags>()
  values.push(PackedFlags { high: 250, signed: -8, enabled: true })
  values.push(PackedFlags { high: 9, signed: -128, enabled: false })
  match values.get(0) {
    Some(value) -> Test.assert_true(value.high == 250 and value.signed == -8 and value.enabled)
    None -> Test.assert_true(false)
  }
  match values.get(1) {
    Some(value) -> Test.assert_true(value.high == 9 and value.signed == -128 and not value.enabled)
    None -> Test.assert_true(false)
  }
}

test "record self assignment preserves every field" {
  let mut values = [PackedReading { code: 250, temperature: 3.5, delta: -300, serial: 18446744073709551615 }]
  values[0] = values[0]
  Test.assert_true(packed_valid(values[0]))
}

test "escaping record values outlive indexed storage" {
  let point = {
    let values = [Point { x: 1.0, y: 2.0 }]
    escape_point(values[..])
  }
  Test.assert_true(point.x == 1.0 and point.y == 2.0)
  let read = point_reader(point)
  Test.assert_true(read() == 3.0)
}

test "record updates compose with loop control and branches" {
  let mut values = [Point { x: 1.0, y: 2.0 }]
  for step in 0..20 {
    let snapshot = values[0]
    if step % 2 == 0 { continue }
    values[0] = snapshot.{x: snapshot.x + snapshot.y}
  }
  Test.assert_true(values[0].x == 21.0)
}

test "handler results preserve record values across resumption" {
  let result = handle {
    let point = SnapshotRead.read()
    point.x + point.y
  } {
    SnapshotRead.read() -> resume(Point { x: 4.0, y: 5.0 })
  }
  Test.assert_true(result == 9.0)
}

test "aborting a record update leaves the original source intact" {
  let mut values = [Point { x: 1.0, y: 2.0 }]
  let result = handle {
    let snapshot = values[0]
    values[0] = snapshot.{x: { SnapshotStop.stop() 9.0 }}
    0
  } {
    SnapshotStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_true(values[0].x == 1.0 and values[0].y == 2.0)
}

test "managed record fields retain their existing ownership" {
  let mut values = [NamedPoint { label: "old".concat("!"), point: Point { x: 1.0, y: 2.0 } }]
  let snapshot = values[0]
  values[0] = snapshot.{label: "new".concat("!")}
  Test.assert_str_eq(snapshot.label, "old!")
  Test.assert_str_eq(values[0].label, "new!")
  Test.assert_true(snapshot.point.x == 1.0)
}

test "weak publication preserves record identity and lifetime" {
  let point = Point { x: 1.0, y: 2.0 }
  let reference = weak_ref(point)
  match weak_load(reference) {
    nil -> Test.assert_true(false)
    loaded: Point -> {
      Test.assert_true(loaded == point)
      Test.assert_true(loaded.x == 1.0 and loaded.y == 2.0)
    }
  }
  Test.assert_true(point.x == 1.0)
}

test "weak references observe array snapshots independently of later writes" {
  let mut values = [Point { x: 1.0, y: 2.0 }]
  let point = values[0]
  values[0] = Point { x: 9.0, y: 10.0 }
  Test.assert_true(point_has_live_weak_reference(point))
  Test.assert_true(values[0].x == 9.0)
}

test "weak references observe records returned from expired slice storage" {
  let point = {
    let values = [Point { x: 1.0, y: 2.0 }]
    escape_point(values[..])
  }
  Test.assert_true(point_has_live_weak_reference(point))
}

test "weak references observe records returned from consumed vector storage" {
  let point = {
    let mut values = vector.new<Point>()
    values.push(Point { x: 1.0, y: 2.0 })
    values.get(0)
  }
  match point {
    Some(value) -> Test.assert_true(point_has_live_weak_reference(value))
    None -> Test.assert_true(false)
  }
}

test "weak references expire when the final indexed record snapshot is released" {
  let reference = expired_indexed_point()
  Test.assert_true(weak_load(reference) == nil)
}

test "record snapshots preserve signed zero infinities and NaN payload bits" {
  let wide_patterns: [u64; 5] = [0, 1, 9223372036854775808, 9218868437227405312, 9221120237041095221]
  for bits in wide_patterns {
    let mut values = [FloatPair { wide: num.f64_from_bits(bits), narrow: num.f32_from_bits(2143289349) }]
    let snapshot = values[0]
    values[0] = snapshot.{wide: 1.0}
    Test.assert_true(snapshot.wide.to_bits() == bits)
    Test.assert_true(values[0].wide == 1.0)
    Test.assert_true(values[0].narrow.to_bits() == 2143289349)
  }
  let narrow_patterns: [u32; 5] = [0, 1, 2147483648, 2139095040, 2143289349]
  for bits in narrow_patterns {
    let mut values = [FloatPair { wide: num.f64_from_bits(9221120237041095221), narrow: num.f32_from_bits(bits) }]
    let snapshot = values[0]
    values[0] = snapshot.{narrow: 1.0}
    Test.assert_true(snapshot.narrow.to_bits() == bits)
    Test.assert_true(values[0].narrow == 1.0)
    Test.assert_true(values[0].wide.to_bits() == 9221120237041095221)
  }
}

test "opaque scalar fields preserve their nominal values through indexed updates" {
  let mut values = [TypedReading { serial: Serial(18446744073709551615), temperature: Temperature(-0.0) }]
  let snapshot = values[0]
  values[0] = snapshot.{temperature: Temperature(3.5)}
  match snapshot.serial { Serial(value) -> Test.assert_true(value == 18446744073709551615) }
  match snapshot.temperature { Temperature(value) -> Test.assert_true(value.to_bits() == 2147483648) }
  match values[0].temperature { Temperature(value) -> Test.assert_true(value == 3.5) }
}
