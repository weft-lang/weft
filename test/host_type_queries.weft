use compiler/source/owners as source_owners
use compiler/weft/syntax/declarations.{SourceDeclaration}
use compiler/weft/products.{AstModule}
use compiler/weft/check as weft_check
use compiler/weft/check.{CheckDeclarations}
use compiler/source/input.{source_from_text}
use compiler/pipeline.{pipeline_parse_local, pipeline_ast_fns}
use compiler/weft/check/body.{typecheck_resolve_type_in_source, typecheck_resolve_field_type, typecheck_subtype}
use compiler/weft/check/table.{ttable_new, ttable_register_source}
use compiler/weft/check/type_projection.{semantic_type_fact_from_checker}
use compiler/types/algebra.{ty_i64, ty_str, ty_tag, ty_named_declaration}
use stdlib/semantic_type.{*}
use stdlib/diagnostic.{*}
use stdlib/state as state

fn query_table(source: str) -> (i64, i64) {
  let table = ttable_new()
  let buffer = __str_ptr(source)
  ttable_register_source(table, buffer, __str_len(source), 0, 0)
  let (_, errors) = state.run(0, () => handle {
    let ast = pipeline_parse_local(source_from_text(source), table)
    let functions = pipeline_ast_fns(ast)
    weft_check.report(CheckDeclarations, AstModule(functions, buffer, table, source_owners.new(), Nil<SourceDeclaration>())).errors
  } {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
  (table, errors)
}

fn resolve(table: i64, source: str, name: str) -> i64 {
  typecheck_resolve_type_in_source(table, __str_ptr(source), __str_ptr(name), 0, __str_len(name))
}

fn field(table: i64, base: i64, name: str) -> i64 {
  typecheck_resolve_field_type(table, base, __str_ptr(name), 0, __str_len(name))
}

test "host queries resolve the language primitive type vocabulary" {
  let source = "fn value() -> i64 { 0 }"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  for name in ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "isize", "usize", "f32", "f64", "bool", "str", "nil"] {
    let found = resolve(table, source, name)
    Test.assert_true(found != 0)
    Test.assert_true(match semantic_type_fact_from_checker(found, table, __str_ptr(source)) {
      SemanticTypePrimitive(spelling) -> spelling == name
      _ -> false
    })
  }
  Test.assert_true(match semantic_type_fact_from_checker(resolve(table, source, "any"), table, __str_ptr(source)) { SemanticTypeTop -> true, _ -> false })
  Test.assert_true(match semantic_type_fact_from_checker(resolve(table, source, "never"), table, __str_ptr(source)) { SemanticTypeBottom -> true, _ -> false })
}

test "host queries preserve identity for record variant and opaque declarations" {
  let source = "type Row { value: i64 } type Choice { First, Second } type Identifier = opaque i64"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  for name in ["Row", "Choice", "Identifier"] {
    let found = resolve(table, source, name)
    Test.assert_true(found != 0)
    if found != 0 {
      Test.assert_eq(ty_tag(found), 9)
      Test.assert_true(ty_named_declaration(found) != 0)
    }
  }
}

test "host queries inspect structural record aliases without losing field types" {
  let source = "type Row = { value: i64, label: str }"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  let row = resolve(table, source, "Row")
  Test.assert_true(row != 0)
  Test.assert_eq(typecheck_subtype(table, field(table, row, "value"), ty_i64()), 1)
  Test.assert_eq(typecheck_subtype(table, field(table, row, "label"), ty_str()), 1)
  Test.assert_eq(field(table, row, "missing"), 0)
}

test "host field queries can continue through a nested structural value" {
  let source = "type Outer { inner: { value: i64 } }"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  let outer = resolve(table, source, "Outer")
  let inner = field(table, outer, "inner")
  Test.assert_true(inner != 0)
  Test.assert_eq(typecheck_subtype(table, field(table, inner, "value"), ty_i64()), 1)
}

test "host field queries preserve generic substitutions through aliases" {
  let source = "type Box<T> { value: T } type NumberBox = Box<i64> type TextBox = Box<str>"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  let numbers = resolve(table, source, "NumberBox")
  let text = resolve(table, source, "TextBox")
  Test.assert_eq(typecheck_subtype(table, field(table, numbers, "value"), ty_i64()), 1)
  Test.assert_eq(typecheck_subtype(table, field(table, text, "value"), ty_str()), 1)
  Test.assert_eq(typecheck_subtype(table, numbers, text), 0)
}

test "unknown names and fields remain unresolved values" {
  let source = "type Empty { }"
  let (table, errors) = query_table(source)
  Test.assert_eq(errors, 0)
  Test.assert_eq(resolve(table, source, "Missing"), 0)
  Test.assert_eq(field(table, resolve(table, source, "Empty"), "absent"), 0)
  Test.assert_eq(field(table, ty_i64(), "absent"), 0)
  Test.assert_eq(field(table, 0, "absent"), 0)
}
