use runtime/rc_implicit_test.{*}
use runtime/defer_order_test.{OwnedAbortToken, defer_order_log_new, defer_order_log_read, owned_abort_token_new}

effect DeferredReturnScalar {
  @deferred fn value() -> i64
}

effect DeferredReturnWide {
  @deferred fn pair() -> (RuntimeRcProbe, i64)
}

effect DeferredReturnOwned {
  @deferred fn token() -> owned OwnedAbortToken
}

fn deferred_return_resumed_non_tail() -> i64 {
  handle DeferredReturnScalar.value() + 1 {
    DeferredReturnScalar.value() with k -> {
      let transformed = k(42)
      transformed + 10
    }
    return value -> value * 2
  }
}

fn deferred_return_nested_order() -> i64 {
  handle (handle DeferredReturnScalar.value() {
    DeferredReturnScalar.value() with k -> k(2)
    return inner -> inner + 1
  }) {
    DeferredReturnScalar.value() with k -> k(0)
    return outer -> outer * 10
  }
}

fn deferred_return_transform_performs_to_outer() -> i64 {
  handle (handle 5 {
    DeferredReturnScalar.value() with k -> k(0)
    return value -> value + DeferredReturnScalar.value()
  }) {
    DeferredReturnScalar.value() with k -> k(7)
  }
}

fn deferred_return_wide_count(probe: RuntimeRcProbe) -> i64 {
  let transformed = handle DeferredReturnWide.pair() {
    DeferredReturnWide.pair() with k -> k((probe, 41))
    return pair -> {
      let (value, number): (RuntimeRcProbe, i64) = pair
      (value, number + 1)
    }
  }
  let (value, number): (RuntimeRcProbe, i64) = transformed
  if number == 42 { runtime_rc_probe_count(value) } else { 0 }
}

test "deferred return transforms resumed completion once before non-tail clause work" {
  Test.assert_eq(deferred_return_resumed_non_tail(), 96)
}

test "deferred return transforms natural completion once" {
  let got = handle 7 {
    DeferredReturnScalar.value() with k -> k(0)
    return value -> value + 1
  }
  Test.assert_eq(got, 8)
}

test "deferred return bypasses an unresumed continuation and releases captures" {
  let probe = runtime_rc_probe_new(0)
  let seen = handle DeferredReturnScalar.value() {
    DeferredReturnScalar.value() with k -> runtime_rc_probe_count(probe)
    return value -> value + runtime_rc_probe_count(probe) * 100
  }
  Test.assert_eq(seen, 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "deferred return preserves managed multi-lane completion ownership" {
  let probe = runtime_rc_probe_new(0)
  Test.assert_eq(deferred_return_wide_count(probe), 4)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "deferred return captures live through resume and release after completion" {
  let probe = runtime_rc_probe_new(0)
  let got = handle DeferredReturnScalar.value() {
    DeferredReturnScalar.value() with k -> k(41)
    return value -> value + runtime_rc_probe_count(probe) * 100
  }
  Test.assert_eq(got, 241)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "nested deferred return transforms run inner then outer" {
  Test.assert_eq(deferred_return_nested_order(), 30)
}

test "deferred return transform performs under the enclosing prompt" {
  Test.assert_eq(deferred_return_transform_performs_to_outer(), 12)
}

test "deferred return owned input and temporary drop in source order" {
  let log = defer_order_log_new()
  let got = handle DeferredReturnOwned.token() {
    DeferredReturnOwned.token() with k -> k(owned_abort_token_new(log, 4))
    return token -> {
      let later: owned OwnedAbortToken = owned_abort_token_new(log, 5)
      token.drop()
    }
  }
  Test.assert_eq(got, 0)
  Test.assert_eq(defer_order_log_read(log), 45)
}
