use compiler/ir/data.{*}
use compiler/pipeline.{*}
use compiler/weft/check/body.{synth_branch_value_union}
use compiler/types/algebra.{*}
use compiler/storage.{*}
use stdlib/test.{Test}

test "resume exits preserve their value use and outcome through alias rewriting" {
  let term = IrTermHandlerResume(1)
  let aliases = pipeline_ir_alias_env_empty() |> pipeline_ir_alias_env_bind(1, 2) |> pipeline_ir_alias_env_bind(2, 3)
  Test.assert_true(match pipeline_ir_rewrite_term(term, aliases) { IrTermHandlerResume(3) -> true, _ -> false })
  Test.assert_eq(pipeline_ir_live_set_contains(pipeline_ir_native_resident_term_uses(term), 1), 1)
  Test.assert_eq(ir_term_return_value_or(term, 0 - 1), 1)
  Test.assert_eq(pipeline_ir_multi_inline_term_ok(term), 0)
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, term), IrBlockListNil)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(1, 2, blocks, 0)), 0)
  Test.assert_true(pipeline_ir_verify_function(IrFunction(1, 1, blocks, 0)) != 0)
}

fn handler_exit_fixture() -> IrBlockList {
  IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(1, 1, 2)),
  IrBlockListCons(IrBlock(1, IrValueNil, IrInstNil, IrTermReturn(0)),
  IrBlockListCons(IrBlock(2, IrValueNil, IrInstNil, IrTermBranch(1, 3, 4)),
  IrBlockListCons(IrBlock(3, IrValueNil, IrInstNil, IrTermHandlerResume(0)),
  IrBlockListCons(IrBlock(4, IrValueNil, IrInstNil, IrTermHandlerResume(0)), IrBlockListNil)))))
}

test "handler cleanup creates distinct SSA definitions only on locally returning paths" {
  let params = nlist_new()
  nlist_add(params, node_new(2, 0, 1, ty_str(), 0))
  let cleanup = PipelineHandlerExitCleanup(params, 0, 0, 0, IrInstNil, IrInstNil)
  let blocks = pipeline_ir_handler_clause_exit_blocks(handler_exit_fixture(), cleanup, 2, 0, ty_str(), ty_str())
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(1, 2, blocks, 0)), 0)
  Test.assert_eq(ir_block_list_inst_count(blocks), 2)
  Test.assert_true(match blocks {
    IrBlockListCons(_, IrBlockListCons(IrBlock(1, _, IrInstNil, IrTermReturn(0)), _)) -> true
    _ -> false
  })
  Test.assert_eq(pipeline_ir_function_next_value(2, blocks), 4)
}

test "lowered completion facts determine whether a prompt needs an abort landing" {
  for completion in [HandlerClauseResumes, HandlerClauseAborts, HandlerClauseMixed, HandlerClauseDeferred, HandlerClauseUnknown] {
    let clause = IrHandlerClauseBody(1, 0, 0, 0, completion, 0, 0, 1, 1, 0, IrBlockListNil)
    let clauses = IrHandlerClauseBodyCons(clause, IrHandlerClauseBodyNil)
    Test.assert_true(ir_handler_clause_bodies_may_abort(clauses) == handler_completion_may_abort(completion))
  }
  Test.assert_false(ir_handler_clause_bodies_may_abort(IrHandlerClauseBodyNil))
  Test.assert_true(ir_handler_clause_bodies_may_abort(IrHandlerClauseBodyCons(IrHandlerClauseBodyInvalid(1), IrHandlerClauseBodyNil)))
}

test "branch result joins exclude terminal control exits in either order" {
  Test.assert_true(ty_eq(synth_branch_value_union(ty_never(), ty_str()), ty_str()))
  Test.assert_true(ty_eq(synth_branch_value_union(ty_str(), ty_never()), ty_str()))
  Test.assert_true(ty_eq(synth_branch_value_union(ty_never(), ty_never()), ty_never()))
  Test.assert_true(ty_eq(synth_branch_value_union(ty_str(), ty_str()), ty_str()))
  Test.assert_true(ty_eq(synth_branch_value_union(ty_str(), ty_i64()), ty_union(ty_str(), ty_i64())))
}
