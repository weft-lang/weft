fn unique_consume_i64(x: unique i64) -> i64 {
  x
}

fn unique_id_i64(x: unique i64) -> unique i64 {
  x
}

fn unique_make_i64() -> unique i64 {
  41
}

fn unique_apply_i64(f: (unique i64) -> i64, x: unique i64) -> i64 {
  f(x)
}

type UniqueBorrowBox { value: i64 }

fn unique_borrow_box_read(value: borrow UniqueBorrowBox) -> i64 {
  value.value
}

fn unique_borrow_box_write(value: borrow mut UniqueBorrowBox) -> i64 {
  value.value
}

fn unique_borrow_box_consume(value: unique UniqueBorrowBox) -> i64 {
  value.value
}

impl UniqueBorrowBox {
  fn observe(self: borrow Self) -> i64 {
    self.value
  }

  fn mutate(self: borrow mut Self) -> i64 {
    self.value
  }

  fn finish(self: unique Self) -> i64 {
    self.value
  }
}

test "unique_literal_constructs_and_consumes_once" {
  Test.assert_eq(unique_consume_i64(42), 42)
}

test "unique_value_moves_through_let_once" {
  let x: unique i64 = unique_make_i64()
  let y: unique i64 = x
  Test.assert_eq(unique_consume_i64(y), 41)
}

test "unique_value_moves_through_let_mut_once" {
  let mut x: unique i64 = unique_make_i64()
  Test.assert_eq(unique_consume_i64(x), 41)
}

test "unique_value_can_roundtrip_as_unique" {
  let x: unique i64 = 7
  Test.assert_eq(unique_consume_i64(unique_id_i64(x)), 7)
}

test "unique_contextual_lambda_consumes_param_once" {
  Test.assert_eq(unique_apply_i64(x => x, 11), 11)
}

test "fresh managed construction enters unique context" {
  Test.assert_eq(unique_borrow_box_consume(UniqueBorrowBox { value: 41 }), 41)
}

test "unique managed value supports shared and exclusive borrows before move" {
  let mut value: unique UniqueBorrowBox = UniqueBorrowBox { value: 41 }
  let free_read = unique_borrow_box_read(value)
  let free_write = unique_borrow_box_write(value)
  let method_read = value.observe()
  let method_write = value.mutate()
  Test.assert_eq(free_read + free_write + method_read + method_write + value.finish(), 205)
}
