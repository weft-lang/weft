use stdlib/display.{Display}
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url
use stdlib/url.{Url, UrlComponentError, UrlComponentInvalidPercent, UrlComponentInvalidUtf8, UrlDomain, UrlHost, UrlHttp, UrlHttps, UrlInvalidHost, UrlInvalidPercentEncoding, UrlInvalidPort, UrlIpv4, UrlIpv6, UrlMissingAuthority, UrlMissingScheme, UrlParseError, UrlUnsupportedScheme, UrlUserInfoNotAllowed, UrlWs, UrlWss, UrlControlCharacter}

fn url_test_parse(source: str) -> Url {
  url.parse(source).expect("URL test fixture must parse")
}

fn url_test_error(result: Result<Url, UrlParseError>, kind: i64, offset: i64) -> bool {
  match result {
    Err(UrlMissingScheme(actual)) -> kind == 1 and actual == offset
    Err(UrlUnsupportedScheme(actual)) -> kind == 2 and actual == offset
    Err(UrlMissingAuthority(actual)) -> kind == 3 and actual == offset
    Err(UrlUserInfoNotAllowed(actual)) -> kind == 4 and actual == offset
    Err(UrlInvalidHost(actual)) -> kind == 5 and actual == offset
    Err(UrlInvalidPort(actual)) -> kind == 6 and actual == offset
    Err(UrlInvalidPercentEncoding(actual)) -> kind == 7 and actual == offset
    Err(UrlControlCharacter(actual)) -> kind == 8 and actual == offset
    Ok(_) -> false
  }
}

fn url_test_option_text(value: Option<str>, absent: str) -> str {
  match value {
    Some(text) -> text
    None -> absent
  }
}

fn url_test_component_error(result: Result<str, UrlComponentError>, kind: i64, offset: i64) -> bool {
  match result {
    Err(UrlComponentInvalidPercent(actual)) -> kind == 1 and actual == offset
    Err(UrlComponentInvalidUtf8(actual)) -> kind == 2 and actual == offset
    Ok(_) -> false
  }
}

test "URL schemes normalize case default ports and security policy" {
  let http = url_test_parse("HTTP://Example.COM:80")
  let https = url_test_parse("https://example.com:443/")
  let ws = url_test_parse("WS://example.com")
  let wss = url_test_parse("wss://example.com")
  Test.assert_str_eq(http.display(), "http://example.com/")
  Test.assert_str_eq(https.display(), "https://example.com/")
  Test.assert_str_eq(ws.display(), "ws://example.com/")
  Test.assert_str_eq(wss.display(), "wss://example.com/")
  Test.assert_true(http.scheme().eq(UrlHttp))
  Test.assert_true(https.scheme().eq(UrlHttps))
  Test.assert_true(ws.scheme().eq(UrlWs))
  Test.assert_true(wss.scheme().eq(UrlWss))
  Test.assert_false(http.scheme().is_secure())
  Test.assert_true(https.scheme().is_secure())
  Test.assert_false(ws.scheme().is_secure())
  Test.assert_true(wss.scheme().is_secure())
  Test.assert_eq(__u64_to_i64(__u16_to_u64(http.effective_port())), 80)
  Test.assert_eq(__u64_to_i64(__u16_to_u64(https.effective_port())), 443)
  match http.port() { None -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "URL domains share canonical IDNA and certificate identity" {
  let composed = url_test_parse("https://BÜCHER.example./café")
  let decomposed = url_test_parse("https://bücher.example./café")
  Test.assert_str_eq(composed.display(), "https://xn--bcher-kva.example./caf%C3%A9")
  Test.assert_str_eq(composed.tls_identity(), "xn--bcher-kva.example")
  Test.assert_true(composed.eq(decomposed))
  match composed.host() {
    UrlDomain(name) -> {
      Test.assert_str_eq(name.ascii(), "xn--bcher-kva.example")
      Test.assert_true(name.is_absolute())
    }
    _ -> Test.assert_true(false)
  }
}

test "URL numeric hosts retain family and non-default ports" {
  let ipv4 = url_test_parse("http://192.0.2.1:8080/a")
  let ipv6 = url_test_parse("https://[2001:0DB8::1]:444/x")
  Test.assert_str_eq(ipv4.display(), "http://192.0.2.1:8080/a")
  Test.assert_str_eq(ipv6.display(), "https://[2001:db8::1]:444/x")
  Test.assert_str_eq(ipv4.tls_identity(), "192.0.2.1")
  Test.assert_str_eq(ipv6.tls_identity(), "2001:db8::1")
  Test.assert_eq(__u64_to_i64(__u16_to_u64(ipv4.effective_port())), 8080)
  Test.assert_eq(__u64_to_i64(__u16_to_u64(ipv6.effective_port())), 444)
  match ipv4.host() { UrlIpv4(_) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match ipv6.host() { UrlIpv6(_) -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "URL components canonicalize Unicode escapes and reserved bytes" {
  let value = url_test_parse("https://example.com/a b/%7e/%2f/例?q=café&x=%2f#résumé?")
  Test.assert_str_eq(value.path(), "/a%20b/~/%2F/%E4%BE%8B")
  Test.assert_str_eq(url_test_option_text(value.query(), "<absent>"), "q=caf%C3%A9&x=%2F")
  Test.assert_str_eq(url_test_option_text(value.fragment(), "<absent>"), "r%C3%A9sum%C3%A9?")
  Test.assert_str_eq(value.display(), "https://example.com/a%20b/~/%2F/%E4%BE%8B?q=caf%C3%A9&x=%2F#r%C3%A9sum%C3%A9?")
}

test "URL query and fragment preserve absent versus present empty" {
  let absent = url_test_parse("https://example.com")
  let empty_query = url_test_parse("https://example.com?")
  let empty_both = url_test_parse("https://example.com?#")
  match absent.query() { None -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match absent.fragment() { None -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match empty_query.query() { Some(text) -> Test.assert_str_eq(text, "") _ -> Test.assert_true(false) }
  match empty_query.fragment() { None -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match empty_both.query() { Some(text) -> Test.assert_str_eq(text, "") _ -> Test.assert_true(false) }
  match empty_both.fragment() { Some(text) -> Test.assert_str_eq(text, "") _ -> Test.assert_true(false) }
  Test.assert_false(absent.eq(empty_query))
  Test.assert_false(empty_query.eq(empty_both))
  Test.assert_str_eq(empty_both.display(), "https://example.com/?#")
}

test "URL parsing reports every typed failure with an exact byte offset" {
  Test.assert_true(url_test_error(url.parse("example.com"), 1, 0))
  Test.assert_true(url_test_error(url.parse("ftp://example.com"), 2, 0))
  Test.assert_true(url_test_error(url.parse("https:/example.com"), 3, 6))
  Test.assert_true(url_test_error(url.parse("https:///x"), 3, 8))
  Test.assert_true(url_test_error(url.parse("https://u@example.com"), 4, 9))
  Test.assert_true(url_test_error(url.parse("https://[::1%2]/"), 5, 12))
  Test.assert_true(url_test_error(url.parse("https://127.1/"), 5, 13))
  Test.assert_true(url_test_error(url.parse("https://example.com:65536/"), 6, 24))
  Test.assert_true(url_test_error(url.parse("https://example.com:x/"), 6, 20))
  Test.assert_true(url_test_error(url.parse("https://example.com/a%2"), 7, 21))
  Test.assert_true(url_test_error(url.parse("https://example.com/a%XZ"), 7, 21))
  Test.assert_true(url_test_error(url.parse("https://example.com/a\n"), 8, 21))
}

test "canonical URL display reparses idempotently across host alternatives" {
  let domain = url_test_parse("HTTPS://EXAMPLE.com:0443/%41?x=%7e")
  let ipv4 = url_test_parse("http://203.0.113.9:81")
  let ipv6 = url_test_parse("wss://[::ffff:192.0.2.1]/socket")
  Test.assert_true(domain.eq(url_test_parse(domain.display())))
  Test.assert_true(ipv4.eq(url_test_parse(ipv4.display())))
  Test.assert_true(ipv6.eq(url_test_parse(ipv6.display())))
  Test.assert_str_eq(domain.display(), "https://example.com/A?x=~")
}

test "URL resolution follows RFC path query fragment and authority rules" {
  let base = url_test_parse("http://a/b/c/d;p?q")
  Test.assert_str_eq(base.resolve("g").unwrap().display(), "http://a/b/c/g")
  Test.assert_str_eq(base.resolve("./g").unwrap().display(), "http://a/b/c/g")
  Test.assert_str_eq(base.resolve("g/").unwrap().display(), "http://a/b/c/g/")
  Test.assert_str_eq(base.resolve("/g").unwrap().display(), "http://a/g")
  Test.assert_str_eq(base.resolve("//g").unwrap().display(), "http://g/")
  Test.assert_str_eq(base.resolve("?y").unwrap().display(), "http://a/b/c/d;p?y")
  Test.assert_str_eq(base.resolve("g?y").unwrap().display(), "http://a/b/c/g?y")
  Test.assert_str_eq(base.resolve("#s").unwrap().display(), "http://a/b/c/d;p?q#s")
  Test.assert_str_eq(base.resolve("g#s").unwrap().display(), "http://a/b/c/g#s")
  Test.assert_str_eq(base.resolve("").unwrap().display(), "http://a/b/c/d;p?q")
  Test.assert_str_eq(base.resolve("..").unwrap().display(), "http://a/b/")
  Test.assert_str_eq(base.resolve("../g").unwrap().display(), "http://a/b/g")
  Test.assert_str_eq(base.resolve("../../g").unwrap().display(), "http://a/g")
  Test.assert_str_eq(base.resolve("../../../g").unwrap().display(), "http://a/g")
  Test.assert_str_eq(base.resolve("/a//b").unwrap().display(), "http://a/a//b")
  Test.assert_str_eq(base.resolve("../例?q=é").unwrap().display(), "http://a/b/%E4%BE%8B?q=%C3%A9")
  Test.assert_str_eq(base.resolve("HTTPS://Example.com/x").unwrap().display(), "https://example.com/x")
}

test "query and form components use distinct canonical percent policies" {
  let text = "a b&c/é~+"
  let query = url.query_component_encode(text)
  let form = url.form_component_encode(text)
  Test.assert_str_eq(query, "a%20b%26c%2F%C3%A9~%2B")
  Test.assert_str_eq(form, "a+b%26c%2F%C3%A9%7E%2B")
  Test.assert_str_eq(url.query_component_decode(query).unwrap(), text)
  Test.assert_str_eq(url.form_component_decode(form).unwrap(), text)
  Test.assert_str_eq(url.query_component_decode("a+b").unwrap(), "a+b")
  Test.assert_str_eq(url.form_component_decode("a+b").unwrap(), "a b")
  Test.assert_true(url_test_component_error(url.query_component_decode("%2"), 1, 0))
  Test.assert_true(url_test_component_error(url.form_component_decode("a%XZ"), 1, 1))
  Test.assert_true(url_test_component_error(url.query_component_decode("%FF"), 2, 0))
}
