  Test.assert_eq(pipeline_native_rc_reuse_lowering_count(native), 2)
  Test.assert_eq(handler_metric_optimised_dynamic_dispatch_sites(src, "main"), 0)
}

test "handler_inline_native_bridge_typed_match_ctor_reuse_keeps_ir_function" {
  let src = "type HINBRMChoice { HINBRMLeft(i64), HINBRMRight(i64) } effect HINBRMC { fn get() -> i64 } fn hinbrm_pick(flag: bool) -> HINBRMChoice { if flag { HINBRMLeft(4) } else { HINBRMRight(5) } } fn main() -[Unsafe]> i64 { handle HINBRMC.get() { HINBRMC.get() -> resume({ let choice = hinbrm_pick(true) let p: rc i64 = rc_default_alloc(8, 8) match choice { HINBRMLeft(extra) -> { let marker = __mem_load64(p) let adjusted = marker + extra let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 1 } else { 0 } } _ -> { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }) } }"
  let native = handler_metric_optimised_native(src)
  Test.assert_eq(pipeline_native_ir_emit_count(native), 1)
  Test.assert_eq(pipeline_native_rc_reuse_lowering_count(native), 2)
  Test.assert_eq(handler_metric_optimised_dynamic_dispatch_sites(src, "main"), 0)
}

