test "handler_inline_optimizer_records_lexical_binds_for_captures" {
  let captured = handler_metric_optimised_functions(
    "effect HIRB { fn get() -> i64 } fn main() -> i64 { let base = 40 handle HIRB.get() { HIRB.get() -> resume(base + 2) } }"
  )
  -- 523 -> 527: heap_alloc gained the arena-chaining exhaustion arm
  -- (2q slice 0), which adds four lexical binds in the runtime module.
  -- 527 -> 538: the binned heap free lists and generator producer-stash
  -- ownership (2q slice 2) add lexical binds in the runtime module.
  -- 538 -> 567: deep release (2q slice 2 stage B) — the worklist walk,
  -- field-mask helpers, and promoted-field recursion add lexical binds
  -- in the runtime module.
  -- 567 -> 574: heap-backed vector/buffer data with growth frees and
  -- the best-fit overflow scan (2q slice 2 runtime-owned frees) add
  -- lexical binds in the runtime module.
  -- 574 -> 573: generic handle-body inlining (2r slice 0) collapses a
  -- runtime discharge helper's bind.
  -- 573 -> 586: rc fast-path flattening (2r slice 1a) — self-contained
  -- retain/release bodies, the bounds updater, and the alloc-core
  -- split add lexical binds in the runtime module.
  -- 586 -> 594: fused ctor-alloc and deep-walk free fast paths (2r)
  -- add lexical binds in the runtime module.
  -- 594 -> 596: inlining the deep-release child guard (2r) trades three
  -- helper calls for two extra binds in rc_deep_release_child — the
  -- cached runtime-state pointer and the arena base.
  -- 596 -> 598: word-unrolled mem_zero (2s scratch reclaim) binds its
  -- cursor and remaining-count muts in the runtime module.
  -- 598 -> 596: the bump-restore segment fix binds the live-segment
  -- base in alloc_bump_restore_same_segment, while the self-contained
  -- arena/heap descriptor rework (descriptors at the head of their own
  -- mappings) drops the arena_free field-zeroing locals and the
  -- heap_destroy result local in the runtime module.
  -- 596 -> 627: compiler-managed vector/buffer headers (2s item 5)
  -- add 24 finalizer decode/walk locals, two raw-header aliases, one
  -- detach local, and four saved-length locals at explicit raw-data
  -- ownership transfers. The ledger counts lexical binds, so all 31
  -- intentional lifetime-state names appear even when calls inline.
  -- 627 -> 655: persistent collection family regions (2s item 8) add
  -- the segment-growth/finalizer cursors, locked allocation results,
  -- cleanup-ledger cells, and managed-element aliases in runtime/rc.
  -- These 28 binds are lifetime state for last-version reclamation.
  -- 655 -> 660: lazy family-region promotion keeps the single-thread
  -- allocator lock-free; the root promotion hook names its result,
  -- size word, region, and region descriptor, while the conditional
  -- allocation path names its locked result.
  -- 660 -> 674: dynamic-dispatch masking (2t) — handler_find_entry
  -- records the found frame's prev in runtime state so a clause
  -- performing its own label dispatches outward — and A13.3 reclaimed-
  -- span release name their state pointers, page bounds, and mmap
  -- results as lifetime binds.
  -- 674 -> 679: abort cleanup chain splicing (4j J3) names the runtime
  -- state, chain head/current/next records, and removal state. These five
  -- binds are the trusted primitive's explicit lifetime bookkeeping.
  -- 679 -> 692: persistent payload-kind cleanup (4h) records typed ledger
  -- cells and names the concrete word/kind values used to retain and release
  -- managed or closure payloads without guessing from their bit patterns.
  -- 692 -> 733: fixed-array managed backing (4e C) names the descriptor
  -- layout constituents, flattened leaf cursors, pending/promoted cleanup
  -- state, allocation ownership handoff, and transitive-promotion results.
  -- These 41 binds are the explicit lifetime state behind counted element
  -- destruction; arrays never fall back to the 16-word compact field mask.
  -- 733 -> 783: managed aggregate layout descriptors (4e C) name validated
  -- entry shapes, arbitrary-offset leaf walks, described-allocation state,
  -- and the pending/promoted cleanup cursors. These 50 binds make nested
  -- aggregate ownership explicit instead of truncating it to a word mask.
  -- 783 -> 784: managed deferred captures add the prompt capture-owner
  -- accessor parameter. The owner keeps the complete capture bundle alive
  -- until the fiber completes or its continuation is dropped.
  -- 784 -> 797: suspended-generator cleanup contexts add the prompt cleanup
  -- walker and its explicit saved/current record state.
  -- 797 -> 798: the abort-cleanup native-use producer names each acquisition
  -- fact before recording its same-position allocator use.
  -- 798 -> 835: generic Par work carriers (4l) add the descriptor, result,
  -- promotion, and scoped-cleanup state needed to transport arbitrary T.
  -- These 37 binds are explicit runtime/par_task ownership state.
  Test.assert_eq(ir_function_list_count_tag(captured, 26), 835)
  Test.assert_eq(ir_function_list_count_tag(captured, 24), 4)
  Test.assert_eq(ir_function_list_count_tag(captured, 25), 10)
}

