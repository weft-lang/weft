test "handler_inline_optimizer_rewrites_direct_performs_to_ir" {
  let single = handler_metric_optimised_functions(
    "effect HIRD { fn get() -> i64 } fn main() -> i64 { handle HIRD.get() { HIRD.get() -> resume(42) } }"
  )
  let multi = handler_metric_optimised_functions(
    "effect HIRD { fn get() -> i64 fn put(v: i64) -> i64 } fn main() -> i64 { handle { HIRD.put(1); HIRD.get() } { HIRD.get() -> resume(42) HIRD.put(v) -> resume(0) } }"
  )
  Test.assert_eq(ir_function_list_count_tag(single, 24), 1)
  Test.assert_eq(ir_function_list_count_tag(single, 18), 0)
  Test.assert_eq(ir_function_list_count_tag(single, 19), 1)
  Test.assert_eq(ir_function_list_count_tag(single, 25), 1)
  Test.assert_eq(ir_function_list_first_handler_direct_arg_count_or(single, 0 - 1), 0)
  Test.assert_eq(ir_function_list_first_handler_direct_depth_or(single, 0 - 1), 0)
  Test.assert_eq(ir_function_list_first_handler_direct_clause_index_or(single, 0 - 1), 0)
  Test.assert_eq(ir_function_list_count_tag(multi, 24), 2)
  Test.assert_eq(ir_function_list_count_tag(multi, 18), 0)
  Test.assert_eq(ir_function_list_count_tag(multi, 19), 1)
  Test.assert_eq(ir_function_list_count_tag(multi, 25), 1)
  Test.assert_eq(ir_function_list_first_handler_direct_arg_count_or(multi, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_handler_direct_clause_index_or(multi, 0 - 1), 1)
}

test "handler_inline_optimizer_metrics_follow_lowered_ir_tags" {
  let direct = handler_metric_optimised_ir(
    "effect HIRM { fn get() -> i64 } fn main() -> i64 { handle HIRM.get() { HIRM.get() -> resume(42) } }"
  )
  let boundary = handler_metric_optimised_ir(
    "effect HIRM { fn get() -> i64 } fn go() -[HIRM]> i64 { HIRM.get() } fn main() -> i64 { handle go() { HIRM.get() -> resume(42) } }"
  )
  let generic_boundary = handler_metric_optimised_ir(
    "effect HIRM { fn get() -> i64 } fn go<T>(x: T) -[HIRM]> i64 { HIRM.get() } fn main() -[HIRM]> i64 { go<i64>(0) }"
  )
  let direct_fns = pipeline_ir_functions(direct)
  let boundary_fns = pipeline_ir_functions(boundary)
  let generic_boundary_fns = pipeline_ir_functions(generic_boundary)
  Test.assert_eq(pipeline_ir_handler_inline_sites(direct), ir_function_list_count_tag(direct_fns, 24))
  Test.assert_eq(pipeline_ir_handler_residual_sites(direct), ir_function_list_count_tag(direct_fns, 18))
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(direct), ir_function_list_count_tag(direct_fns, 18))
  Test.assert_eq(pipeline_ir_handler_inline_sites(boundary), ir_function_list_count_tag(boundary_fns, 24))
  Test.assert_eq(pipeline_ir_handler_residual_sites(boundary), ir_function_list_count_tag(boundary_fns, 18))
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(boundary), ir_function_list_count_tag(boundary_fns, 18))
  Test.assert_eq(pipeline_ir_handler_inline_sites(generic_boundary), ir_function_list_count_tag(generic_boundary_fns, 24))
  Test.assert_eq(pipeline_ir_handler_residual_sites(generic_boundary), ir_function_list_count_tag(generic_boundary_fns, 18))
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(generic_boundary), ir_function_list_count_tag(generic_boundary_fns, 18))
  Test.assert_eq(pipeline_ir_handler_inline_sites(direct), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(boundary), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(generic_boundary), 1)
}

