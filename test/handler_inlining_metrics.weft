  Test.assert_eq(handler_metric_effect_evidence_count(src), 2)
}

test "handler_evidence_native_direct_local_closure_call_specialises_immediate_body" {
  let src = "effect HIEVC { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn go() -[HIEVC]> i64 { let f = () => HIEVC.get() f() } fn main() -> i64 { handle go() { HIEVC.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 1)
  Test.assert_eq(handler_metric_runtime_lookup_sites(src, "go"), 1)
}

test "handler_evidence_native_local_closure_immediate_call_elides_dispatch" {
  let src = "fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn main() -> i64 { let f = () => 42 f() }"
  Test.assert_eq(handler_metric_dynamic_dispatch_sites(src, "main"), 0)
}

test "handler_evidence_native_local_closure_immediate_arg_call_elides_dispatch" {
