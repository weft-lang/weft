  Test.assert_eq(handler_metric_dynamic_dispatch_sites(src, "main"), 0)
}

test "handler_evidence_native_captured_local_closure_keeps_dispatch" {
  let src = "fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn main() -> i64 { let y = 41 let f = () => y + 1 f() }"
  Test.assert_eq(handler_metric_dynamic_dispatch_sites(src, "main"), 1)
}

test "handler_evidence_native_non_immediate_local_closure_keeps_dispatch" {
  let src = "fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn main() -> i64 { let f = () => 42 let z = 0 f() }"
  Test.assert_eq(handler_metric_dynamic_dispatch_sites(src, "main"), 1)
}

test "handler_evidence_native_dead_local_closure_body_does_not_specialise" {
  let src = "effect HIEVCDL { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn go() -[HIEVCDL]> i64 { let f = () => HIEVCDL.get() 0 } fn main() -> i64 { handle go() { HIEVCDL.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 0)
}

test "handler_evidence_native_returned_closure_captures_evidence" {
  let src = "effect HIEVCR { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn make() -[HIEVCR]> () -[HIEVCR]> i64 { () => HIEVCR.get() } fn main() -> i64 { let f = handle make() { HIEVCR.get() -> resume(42) } handle f() { HIEVCR.get() -> resume(0) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 1)
}

test "handler_evidence_native_pure_returned_closure_remains_residual" {
  let src = "effect HIEVCP { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn make() -> () -[HIEVCP]> i64 { () => HIEVCP.get() } fn main() -> i64 { let f = make() handle f() { HIEVCP.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 0)
}

test "handler_evidence_native_multi_op_returned_closure_captures_evidence" {
