test "handler_inline_optimizer_marks_untyped_ir_without_sites" {
  let optimised = pipeline_optimise_ir(pipeline_ir_empty())
  Test.assert_eq(pipeline_ir_is_optimised(optimised), 1)
  Test.assert_eq(pipeline_ir_handler_inline_sites(optimised), 0)
  Test.assert_eq(pipeline_ir_handler_residual_sites(optimised), 0)
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(optimised), 0)
}
