  let src = "effect HINBRM { fn get() -> i64 } fn main() -[Unsafe]> i64 { handle HINBRM.get() { HINBRM.get() -> resume({ let tag = 1 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 -> { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }) } }"
