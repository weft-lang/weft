test "handler_inline_native_bridge_raw_sidecar_invariant_canary" {
  let src = "type HINBCanaryBox { value: i64 } impl HINBCanaryBox { fn add(self: HINBCanaryBox, extra: i64) -> i64 { self.value + extra } } type HINBCanaryList<T> { Nil, Cons(T, HINBCanaryList<T>) } effect HINBCanaryOuter { fn get() -> i64 } effect HINBCanaryInner { fn get() -> i64 } fn hinb_canary_id(x: i64) -> i64 { x } fn hinb_canary_gid<T>(x: T) -> T { x } fn hinb_canary_apply(f: (i64) -> i64) -> i64 { f(2) } fn main() -[Unsafe]> i64 { handle HINBCanaryOuter.get() { HINBCanaryOuter.get() -> resume({ let box = HINBCanaryBox { value: hinb_canary_id(3) } let mut total = box.add(4) let xs: HINBCanaryList<i64> = Cons<i64>(5, Cons<i64>(6, Nil<i64>())) for x in xs { total = total + x } let mut cell = hinb_canary_gid<i64>(10) let p = &mut cell p.* = p.* + 1 let captured = total let f = (z: i64) => z + captured let inner = handle HINBCanaryInner.get() { HINBCanaryInner.get() -> resume(hinb_canary_gid<i64>(7)) } hinb_canary_apply(f) + inner + p.* }) } }"
  let native = handler_metric_optimised_native(src)
  Test.assert_eq(pipeline_native_ir_emit_count(native), 1)
  Test.assert_eq(if pipeline_native_typed_generic_call_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_method_call_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_lambda_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_for_iter_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_handle_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_perform_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_address_of_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_deref_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_ptr_assign_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_native_typed_raw_fallback_count(native), 0)
  Test.assert_eq(pipeline_native_typed_fiber_perform_raw_count(native), 0)
  Test.assert_eq(pipeline_native_typed_scoped_alloc_perform_raw_count(native), 0)
  Test.assert_eq(pipeline_native_typed_direct_par_perform_raw_count(native), 0)
  Test.assert_eq(pipeline_native_typed_empty_handle_emit_count(native), 0)
  Test.assert_eq(pipeline_native_typed_continuation_handle_raw_count(native), 0)
  Test.assert_eq(pipeline_native_typed_non_ident_perform_raw_count(native), 0)
  Test.assert_eq(handler_metric_optimised_runtime_lookup_sites(src, "main"), 0)
}

