test "handler_evidence_native_forwards_known_callback_parameter" {
  let src = "effect HIEVCB { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[HIEVCB]> i64 { HIEVCB.get() } fn apply(f: () -[HIEVCB]> i64) -[HIEVCB]> i64 { f() } fn main() -> i64 { handle apply(leaf) { HIEVCB.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_observed(src, 2), 0)
}

test "handler_evidence_native_forwards_callback_parameter_with_args" {
  let src = "effect HIEVCBA { fn add(v: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf(x: i64) -[HIEVCBA]> i64 { HIEVCBA.add(x) } fn apply(f: (i64) -[HIEVCBA]> i64, x: i64) -[HIEVCBA]> i64 { f(x + 1) } fn main() -> i64 { handle apply(leaf, 41) { HIEVCBA.add(v) -> resume(v) } }"
  Test.assert_eq(handler_metric_effect_evidence_observed(src, 2), 0)
}

test "handler_evidence_native_forwards_callback_through_helper_parameter" {
  let src = "effect HIEVCBF { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[HIEVCBF]> i64 { HIEVCBF.get() } fn invoke(f: () -[HIEVCBF]> i64) -[HIEVCBF]> i64 { f() } fn outer(f: () -[HIEVCBF]> i64) -[HIEVCBF]> i64 { invoke(f) } fn main() -> i64 { handle outer(leaf) { HIEVCBF.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_observed(src, 3), 0)
}

test "handler_evidence_native_separates_callback_specialisation_cache" {
