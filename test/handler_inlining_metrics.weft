test "handler_inline_native_bridge_typed_managed_let_mut_stays_typed" {
  let src = "effect HINBLMM { fn get() -> i64 } fn main() -[Unsafe]> i64 { handle HINBLMM.get() { HINBLMM.get() -> resume({ let mut p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 40) let q: rc i64 = rc_default_alloc(8, 8) __mem_store64(q, 42) p = q __mem_load64(p) }) } }"
  let native = handler_metric_optimised_native(src)
  Test.assert_eq(pipeline_native_ir_emit_count(native), 1)
  Test.assert_eq(pipeline_native_typed_let_mut_managed_emit_count(native), 1)
  Test.assert_eq(handler_metric_optimised_dynamic_dispatch_sites(src, "main"), 0)
}

