-- test/handler_inlining_metrics.weft -- instruction evidence for handler inlining

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn handler_metric_u32_at(p: i64) -> i64 {
  __mem_load8(p) +
  __mem_load8(p + 1) * 256 +
  __mem_load8(p + 2) * 65536 +
  __mem_load8(p + 3) * 16777216
}

fn handler_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = __mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn handler_metric_count_word_range(code: i64, start: i64, end: i64, word: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if handler_metric_u32_at(p + i) == word {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn handler_metric_count_bl_to_range(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if handler_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn handler_metric_dynamic_dispatch_sites(src: str, name: str) -> i64 {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let native = pipeline_lower_native_ir(typed)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = handler_metric_next_offset(fm, off, buf_len(code))
  handler_metric_count_word_range(code, off, end, encode_blr(9))
}

fn handler_metric_runtime_lookup_sites(src: str, name: str) -> i64 {
  let native = handler_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = handler_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr("handler_find_entry"), 0, 18)
  if off == 0 or target == 0 {
    0 - 1
  } else {
    handler_metric_count_bl_to_range(code, off, end, target)
  }
}

fn handler_metric_optimised_runtime_lookup_sites(src: str, name: str) -> i64 {
  let native = handler_metric_optimised_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = handler_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr("handler_find_entry"), 0, 18)
  if off == 0 or target == 0 {
    0 - 1
  } else {
    handler_metric_count_bl_to_range(code, off, end, target)
  }
}

fn handler_metric_optimised_ir(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn handler_metric_optimised_functions(src: str) -> IrFunctionList {
  pipeline_ir_functions(handler_metric_optimised_ir(src))
}

fn handler_metric_optimised_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn handler_metric_optimised_native_buf(b: i64) -> NativeModule {
  let typed = pipeline_check_source_with_origin(buf_ptr(b), buf_len(b), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn handler_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  pipeline_lower_native_ir(typed)
}

fn handler_metric_effect_evidence_count(src: str) -> i64 {
  pipeline_native_effect_evidence_count(handler_metric_native(src))
}

fn handler_metric_optimised_dynamic_dispatch_sites(src: str, name: str) -> i64 {
  let native = handler_metric_optimised_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = handler_metric_next_offset(fm, off, buf_len(code))
  handler_metric_count_word_range(code, off, end, encode_blr(9))
}

fn handler_metric_optimised_dynamic_dispatch_sites_buf(b: i64, name: str) -> i64 {
  let native = handler_metric_optimised_native_buf(b)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = handler_metric_next_offset(fm, off, buf_len(code))
  handler_metric_count_word_range(code, off, end, encode_blr(9))
}

fn handler_metric_optimised_native_ir_emit_count(src: str) -> i64 {
  pipeline_native_ir_emit_count(handler_metric_optimised_native(src))
}

fn handler_metric_optimised_native_ir_emit_count_buf(b: i64) -> i64 {
  pipeline_native_ir_emit_count(handler_metric_optimised_native_buf(b))
}

test "handler_inline_instruction_count_removes_lexical_dispatch" {
  let no_perform = handler_metric_dynamic_dispatch_sites(
    "effect HIC { fn get() -> i64 } fn main() -> i64 { handle 42 { HIC.get() -> resume(0) } }",
    "main"
  )
  let inlined = handler_metric_dynamic_dispatch_sites(
    "effect HIC { fn get() -> i64 } fn main() -> i64 { handle HIC.get() { HIC.get() -> resume(42) } }",
    "main"
  )
  let captured = handler_metric_dynamic_dispatch_sites(
    "effect HIC { fn get() -> i64 } fn main() -> i64 { let base = 42 handle HIC.get() { HIC.get() -> resume(base) } }",
    "main"
  )
  let dynamic_callee = handler_metric_dynamic_dispatch_sites(
    "effect HIC { fn get() -> i64 } fn go() -[HIC]> i64 { HIC.get() } fn main() -> i64 { handle go() { HIC.get() -> resume(42) } }",
    "go"
  )
  Test.assert_eq(no_perform, 0)
  Test.assert_eq(inlined, 0)
  Test.assert_eq(captured, 0)
  Test.assert_eq(dynamic_callee, 1)
}

test "handler_inline_instruction_count_removes_generic_helper_dispatch" {
  let generic_helper = handler_metric_runtime_lookup_sites(
    "effect HICG { fn get() -> i64 } fn go<T>(x: T) -[HICG]> i64 { HICG.get() } fn main() -> i64 { handle go<i64>(0) { HICG.get() -> resume(42) } }",
    "main"
  )
  let distinct_captures = handler_metric_runtime_lookup_sites(
    "effect HICG { fn get() -> i64 } fn go<T>(x: T) -[HICG]> i64 { HICG.get() } fn main() -> i64 { let a = 1 let first = handle go<i64>(0) { HICG.get() -> resume(a) } let b = 41 let second = handle go<i64>(0) { HICG.get() -> resume(b) } first + second }",
    "main"
  )
  Test.assert_eq(generic_helper, 0)
  Test.assert_eq(distinct_captures, 0)
}

test "handler_inline_optimizer_counts_direct_and_empty_handlers" {
  let no_perform = handler_metric_optimised_ir(
    "effect HIO { fn get() -> i64 } fn main() -> i64 { handle 42 { HIO.get() -> resume(0) } }"
  )
  let single = handler_metric_optimised_ir(
    "effect HIO { fn get() -> i64 } fn main() -> i64 { handle HIO.get() { HIO.get() -> resume(42) } }"
  )
  let multi = handler_metric_optimised_ir(
    "effect HIO { fn get() -> i64 fn put(v: i64) -> i64 } fn main() -> i64 { handle { HIO.put(1); HIO.get() } { HIO.get() -> resume(42) HIO.put(v) -> resume(0) } }"
  )
  Test.assert_eq(pipeline_ir_is_optimised(no_perform), 1)
  Test.assert_eq(pipeline_ir_handler_inline_sites(no_perform), 0)
  Test.assert_eq(pipeline_ir_handler_residual_sites(no_perform), 0)
  Test.assert_eq(pipeline_ir_handler_inline_sites(single), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(single), 0)
  Test.assert_eq(pipeline_ir_handler_inline_sites(multi), 2)
  Test.assert_eq(pipeline_ir_handler_residual_sites(multi), 0)
}

test "handler_inline_optimizer_counts_nested_handler_stack" {
  let nested_body = handler_metric_optimised_ir(
    "effect HOuter { fn get() -> i64 } effect HInner { fn get() -> i64 } fn main() -> i64 { handle { handle HOuter.get() { HInner.get() -> resume(1) } } { HOuter.get() -> resume(2) } }"
  )
  let nested_clause = handler_metric_optimised_ir(
    "effect HOuter { fn get() -> i64 } effect HInner { fn get() -> i64 } fn main() -> i64 { handle { handle HInner.get() { HInner.get() -> resume(HOuter.get()) } } { HOuter.get() -> resume(2) } }"
  )
  Test.assert_eq(pipeline_ir_handler_inline_sites(nested_body), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(nested_body), 0)
  Test.assert_eq(pipeline_ir_handler_inline_sites(nested_clause), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(nested_clause), 0)
}

test "handler_inline_optimizer_counts_residual_dynamic_boundary" {
  let dynamic_callee = handler_metric_optimised_ir(
    "effect HIR { fn get() -> i64 } fn go() -[HIR]> i64 { HIR.get() } fn main() -> i64 { handle go() { HIR.get() -> resume(42) } }"
  )
  Test.assert_eq(pipeline_ir_handler_inline_sites(dynamic_callee), 0)
  Test.assert_eq(pipeline_ir_handler_residual_sites(dynamic_callee), 1)
}

test "handler_evidence_candidates_classify_direct_effect_boundary" {
  let direct = handler_metric_optimised_ir(
    "effect HIE { fn get() -> i64 } fn main() -> i64 { handle HIE.get() { HIE.get() -> resume(42) } }"
  )
  let boundary = handler_metric_optimised_ir(
    "effect HIE { fn get() -> i64 } fn go() -[HIE]> i64 { HIE.get() } fn main() -> i64 { handle go() { HIE.get() -> resume(42) } }"
  )
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(direct), 0)
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(boundary), 1)
  Test.assert_eq(pipeline_ir_handler_residual_sites(boundary), 1)
}

test "handler_evidence_candidates_track_applied_ir_not_unlowered_closure_body" {
  let closure_boundary = handler_metric_optimised_ir(
    "effect HIEC { fn get() -> i64 } fn go() -[HIEC]> i64 { let f = () => HIEC.get() f() } fn main() -> i64 { handle go() { HIEC.get() -> resume(42) } }"
  )
  Test.assert_eq(pipeline_ir_handler_evidence_candidate_sites(closure_boundary), 0)
  Test.assert_eq(pipeline_ir_handler_residual_sites(closure_boundary), 0)
}

test "handler_evidence_native_threads_single_direct_call" {
  let src = "effect HIEV { fn get() -> i64 } fn go() -[HIEV]> i64 { HIEV.get() } fn main() -> i64 { handle go() { HIEV.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 1)
}

test "handler_evidence_native_threads_multiple_direct_calls" {
  let src = "effect HIEVM { fn get() -> i64 } fn go() -[HIEVM]> i64 { HIEVM.get() } fn main() -> i64 { handle go() + go() { HIEVM.get() -> resume(21) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 2)
}

test "handler_evidence_native_threads_direct_call_with_args" {
  let src = "effect HIEVA { fn add(v: i64) -> i64 } fn go(x: i64) -[HIEVA]> i64 { HIEVA.add(x) } fn main() -> i64 { handle go(41) { HIEVA.add(v) -> resume(v + 1) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 1)
}

test "handler_evidence_native_threads_capability_style_effect" {
  let src = "effect HIEVIO { fn read() -> i64 } fn read_config() -[HIEVIO]> i64 { HIEVIO.read() } fn main() -> i64 { handle read_config() { HIEVIO.read() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 1)
  Test.assert_eq(handler_metric_runtime_lookup_sites(src, "main"), 0)
}

test "handler_evidence_native_forwards_three_deep_call_chain" {
  let src = "effect HIEVF { fn get() -> i64 } fn leaf() -[HIEVF]> i64 { HIEVF.get() } fn middle() -[HIEVF]> i64 { leaf() } fn top() -[HIEVF]> i64 { middle() } fn main() -> i64 { handle top() { HIEVF.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 3)
}

test "handler_evidence_native_forwards_chain_with_args" {
  let src = "effect HIEVFA { fn add(v: i64) -> i64 } fn leaf(x: i64) -[HIEVFA]> i64 { HIEVFA.add(x) } fn middle(y: i64) -[HIEVFA]> i64 { leaf(y + 1) } fn top(z: i64) -[HIEVFA]> i64 { middle(z + 1) } fn main() -> i64 { handle top(40) { HIEVFA.add(v) -> resume(v) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 3)
}

test "handler_evidence_native_forwards_known_callback_parameter" {
  let src = "effect HIEVCB { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[HIEVCB]> i64 { HIEVCB.get() } fn apply(f: () -[HIEVCB]> i64) -[HIEVCB]> i64 { f() } fn main() -> i64 { handle apply(leaf) { HIEVCB.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 2)
}

test "handler_evidence_native_forwards_callback_parameter_with_args" {
  let src = "effect HIEVCBA { fn add(v: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf(x: i64) -[HIEVCBA]> i64 { HIEVCBA.add(x) } fn apply(f: (i64) -[HIEVCBA]> i64, x: i64) -[HIEVCBA]> i64 { f(x + 1) } fn main() -> i64 { handle apply(leaf, 41) { HIEVCBA.add(v) -> resume(v) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 2)
}

test "handler_evidence_native_forwards_callback_through_helper_parameter" {
  let src = "effect HIEVCBF { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[HIEVCBF]> i64 { HIEVCBF.get() } fn invoke(f: () -[HIEVCBF]> i64) -[HIEVCBF]> i64 { f() } fn outer(f: () -[HIEVCBF]> i64) -[HIEVCBF]> i64 { invoke(f) } fn main() -> i64 { handle outer(leaf) { HIEVCBF.get() -> resume(42) } }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 3)
}

test "handler_evidence_native_separates_callback_specialisation_cache" {
  let src = "effect HIEVCBC { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn one() -[HIEVCBC]> i64 { HIEVCBC.get() } fn two() -[HIEVCBC]> i64 { HIEVCBC.get() + 1 } fn apply(f: () -[HIEVCBC]> i64) -[HIEVCBC]> i64 { f() } fn main() -> i64 { let a = handle apply(one) { HIEVCBC.get() -> resume(20) } let b = handle apply(two) { HIEVCBC.get() -> resume(21) } a + b }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 4)
}

test "handler_evidence_native_rejects_unhandled_boundary" {
  let src = "effect HIEVU { fn get() -> i64 } fn go() -[HIEVU]> i64 { HIEVU.get() } fn main() -[HIEVU]> i64 { go() }"
  Test.assert_eq(handler_metric_effect_evidence_count(src), 0)
}

