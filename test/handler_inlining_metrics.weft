}

test "handler_inline_native_bridge_typed_after_prefix_reuse_emits_from_ir" {
  let src = "effect HINBR { fn get() -> i64 } fn main() -[Unsafe]> i64 { handle HINBR.get() { HINBR.get() -> resume({ let p: rc i64 = rc_default_alloc(8, 8) let marker = mem_load64(p) let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted } else { 0 } }) } }"
  let native = handler_metric_optimised_native(src)
  Test.assert_eq(if pipeline_native_ir_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_ir_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(handler_metric_optimised_runtime_lookup_sites(src, "main"), -1)
}

test "handler_inline_native_bridge_typed_branch_reuse_emits_from_ir" {
  let src = "effect HINBRB { fn get() -> i64 } fn main() -[Unsafe]> i64 { handle HINBRB.get() { HINBRB.get() -> resume({ let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } }) } }"
  let native = handler_metric_optimised_native(src)
  Test.assert_eq(if pipeline_native_ir_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_ir_emit_count(native) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(handler_metric_optimised_runtime_lookup_sites(src, "main"), -1)
}

