use "runtime/memory.weft"
-- test/rc_reuse_candidate_metrics.weft -- native evidence for same-layout RC reuse candidates
use "runtime/rc_implicit_test.weft"

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

type RcReuseMatchCtorChoice { RcReuseMatchCtorA(i64), RcReuseMatchCtorB(i64) }
type RcReuseExhaustiveChoice { RcReuseExhaustiveA(i64), RcReuseExhaustiveB(i64) }

fn rc_reuse_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn rc_reuse_metric_managed(native: NativeModule) -> i64 {
  pipeline_native_managed_reuse_candidate_count(native)
}

fn rc_reuse_metric_rc(native: NativeModule) -> i64 {
  pipeline_native_rc_reuse_candidate_count(native)
}

fn rc_reuse_metric_closure(native: NativeModule) -> i64 {
  pipeline_native_closure_reuse_candidate_count(native)
}

fn rc_reuse_metric_managed_lowered(native: NativeModule) -> i64 {
  pipeline_native_managed_reuse_lowering_count(native)
}

fn rc_reuse_metric_rc_lowered(native: NativeModule) -> i64 {
  pipeline_native_rc_reuse_lowering_count(native)
}

fn rc_reuse_metric_closure_lowered(native: NativeModule) -> i64 {
  pipeline_native_closure_reuse_lowering_count(native)
}

fn rc_reuse_reallocs_same_zeroed(addr: i64, payload_size: i64) -> i64 {
  let again: rc i64 = rc_default_alloc(payload_size, 8)
  if again == addr {
    if mem_load64(again) == 0 { 1 } else { 0 }
  } else { 0 }
}

fn rc_reuse_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 77)
  let addr = runtime_rc_test_addr(p)
  if mem_load64(p) == 77 { addr } else { 0 }
}

fn rc_reuse_lowering_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(1048000, 8)
  let q: rc i64 = rc_default_alloc(1048000, 8)
  if q != 0 { 1 } else { 0 }
}

fn rc_reuse_lowering_after_last_use_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  let marker = mem_load64(p)
  let q: rc i64 = rc_default_alloc(600000, 8)
  if q != 0 { marker + 1 } else { 0 }
}

fn rc_reuse_lowering_after_prefix_chain_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  let marker = mem_load64(p)
  let adjusted = marker + 1
  let q: rc i64 = rc_default_alloc(600000, 8)
  if q != 0 { adjusted } else { 0 }
}

fn rc_reuse_lowering_branch_large_same_scope(flag: bool) -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  if flag {
    let marker = mem_load64(p)
    let q: rc i64 = rc_default_alloc(600000, 8)
    if q != 0 { marker + 1 } else { 0 }
  } else {
    let marker = mem_load64(p)
    let q: rc i64 = rc_default_alloc(600000, 8)
    if q != 0 { marker + 2 } else { 0 }
  }
}

fn rc_reuse_lowering_match_same_scope(tag: i64) -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  match tag {
    0 -> {
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q != 0 { 1 } else { marker }
    }
    _ -> {
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q != 0 { 2 } else { marker }
    }
  }
}

fn rc_reuse_lowering_match_guarded_same_scope(tag: i64, gate: bool) -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  match tag {
    0 if gate -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { marker + 1 } else { 0 }
    }
    _ -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { marker + 2 } else { 0 }
    }
  }
}

fn rc_reuse_lowering_match_ctor_same_scope(choice: RcReuseMatchCtorChoice) -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  match choice {
    RcReuseMatchCtorA(extra) -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let adjusted = marker + extra
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { adjusted + 1 } else { 0 }
    }
    _ -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { marker + 2 } else { 0 }
    }
  }
}

fn rc_reuse_lowering_match_ctor_exhaustive_same_scope(choice: RcReuseExhaustiveChoice) -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  match choice {
    RcReuseExhaustiveA(extra) -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let adjusted = marker + extra
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { adjusted + 1 } else { 0 }
    }
    RcReuseExhaustiveB(extra) -> {
      let addr = runtime_rc_test_addr(p)
      let marker = mem_load64(p)
      let adjusted = marker + extra
      let q: rc i64 = rc_default_alloc(8, 8)
      if q == addr { adjusted + 2 } else { 0 }
    }
  }
}

fn rc_reuse_lowering_match_three_same_scope(tag: i64) -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  match tag {
    0 -> {
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q != 0 { 1 } else { marker }
    }
    1 -> {
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q != 0 { 2 } else { marker }
    }
    _ -> {
      let marker = mem_load64(p)
      let q: rc i64 = rc_default_alloc(8, 8)
      if q != 0 { 3 } else { marker }
    }
  }
}

test "rc_reuse_candidate_happy_matrix" {
  let same_size = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  let same_native = rc_reuse_metric_native(same_size)
  Test.assert_eq(rc_reuse_metric_rc(same_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(same_native), 1)
  Test.assert_eq(rc_reuse_metric_managed(same_native), rc_reuse_metric_rc(same_native) + rc_reuse_metric_closure(same_native))
  Test.assert_eq(rc_reuse_metric_managed_lowered(same_native), rc_reuse_metric_rc_lowered(same_native) + rc_reuse_metric_closure_lowered(same_native))

  let after_last_use = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } }"
  let after_last_native = rc_reuse_metric_native(after_last_use)
  Test.assert_eq(rc_reuse_metric_rc(after_last_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(after_last_native), 1)

  let prefix_chain = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = mem_load64(p) let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted } else { 0 } }"
  let prefix_chain_native = rc_reuse_metric_native(prefix_chain)
  Test.assert_eq(rc_reuse_metric_rc(prefix_chain_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(prefix_chain_native), 1)

  let branch_reuse = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } }"
  let branch_reuse_native = rc_reuse_metric_native(branch_reuse)
  Test.assert_eq(rc_reuse_metric_rc(branch_reuse_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(branch_reuse_native), 2)

  let match_reuse = "fn main() -> i64 { let tag = 1 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }"
  let match_reuse_native = rc_reuse_metric_native(match_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_reuse_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_reuse_native), 2)

  let match_three_reuse = "fn main() -> i64 { let tag = 2 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } 1 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 3 } else { 0 } } } }"
  let match_three_native = rc_reuse_metric_native(match_three_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_three_native), 3)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_three_native), 3)

  let match_many_reuse = "fn main() -> i64 { let tag = 4 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } 1 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } 2 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 3 } else { 0 } } 3 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 4 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 5 } else { 0 } } } }"
  let match_many_native = rc_reuse_metric_native(match_many_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_many_native), 5)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_many_native), 5)

  let match_guard_reuse = "fn main() -> i64 { let tag = 0 let flag = true let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 if flag -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }"
  let match_guard_native = rc_reuse_metric_native(match_guard_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_guard_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_guard_native), 2)

  let match_ctor_reuse = "type ReuseCtorMetric { ReuseCtorA(i64), ReuseCtorB(i64) } fn reuse_ctor_pick(flag: bool) -> ReuseCtorMetric { if flag { ReuseCtorA(4) } else { ReuseCtorB(5) } } fn main() -> i64 { let x = reuse_ctor_pick(true) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseCtorA(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 1 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }"
  let match_ctor_native = rc_reuse_metric_native(match_ctor_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_ctor_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_ctor_native), 2)

  let match_ctor_exhaustive_reuse = "type ReuseExhaustiveMetric { ReuseExhaustiveA(i64), ReuseExhaustiveB(i64) } fn reuse_exhaustive_pick(flag: bool) -> ReuseExhaustiveMetric { if flag { ReuseExhaustiveA(4) } else { ReuseExhaustiveB(5) } } fn main() -> i64 { let x = reuse_exhaustive_pick(true) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseExhaustiveA(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 1 } else { 0 } } ReuseExhaustiveB(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 2 } else { 0 } } } }"
  let match_ctor_exhaustive_native = rc_reuse_metric_native(match_ctor_exhaustive_reuse)
  Test.assert_eq(rc_reuse_metric_rc(match_ctor_exhaustive_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_ctor_exhaustive_native), 2)

  let match_ctor_exhaustive_three = "type ReuseExhaustive3Metric { ReuseExhaustive3A(i64), ReuseExhaustive3B(i64), ReuseExhaustive3C(i64) } fn reuse_exhaustive3_pick(flag: bool) -> ReuseExhaustive3Metric { if flag { ReuseExhaustive3A(4) } else { ReuseExhaustive3C(6) } } fn main() -> i64 { let x = reuse_exhaustive3_pick(false) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseExhaustive3A(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 1 } else { 0 } } ReuseExhaustive3B(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 2 } else { 0 } } ReuseExhaustive3C(v) -> { let marker = mem_load64(p) let adjusted = marker + v let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted + 3 } else { 0 } } } }"
  let match_ctor_exhaustive_three_native = rc_reuse_metric_native(match_ctor_exhaustive_three)
  Test.assert_eq(rc_reuse_metric_rc(match_ctor_exhaustive_three_native), 3)
  Test.assert_eq(rc_reuse_metric_rc_lowered(match_ctor_exhaustive_three_native), 3)

  let branch_alloc = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) if true { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 2 } else { 0 } } else { 0 } }"
  let branch_native = rc_reuse_metric_native(branch_alloc)
  Test.assert_eq(rc_reuse_metric_rc(branch_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(branch_native), 0)
  Test.assert_eq(rc_reuse_metric_closure(branch_native), 0)
}

test "rc_reuse_candidate_sad_matrix" {
  let size_mismatch = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(16, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(size_mismatch)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(size_mismatch)), 0)

  let dynamic_size = "fn main() -> i64 { let sz = 8 let p: rc i64 = rc_default_alloc(sz, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(dynamic_size)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(dynamic_size)), 0)

  let used_after_alloc = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = rc_default_alloc(8, 8) mem_load64(p) }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(used_after_alloc)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(used_after_alloc)), 0)

  let prefix_store = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = mem_store64(p, 1) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_store)), 0)

  let prefix_chain_rest_uses_released = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = mem_load64(p) let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) mem_load64(p) }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_chain_rest_uses_released)), 0)

  let prefix_chain_no_released_use = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = 1 let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_chain_no_released_use)), 0)

  let branch_one_sided = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_one_sided)), 0)

  let branch_condition_uses_released = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) if mem_load64(p) == 0 { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_condition_uses_released)), 0)

  let branch_size_mismatch = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(16, 8) if q != 0 { marker + 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_size_mismatch)), 0)

  let match_one_sided = "fn main() -> i64 { let tag = 1 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 2 } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_one_sided)), 0)

  let match_scrutinee_uses_released = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) match mem_load64(p) { 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_scrutinee_uses_released)), 0)

  let match_guard_uses_released = "fn main() -> i64 { let tag = 1 let p: rc i64 = rc_default_alloc(8, 8) match tag { 0 if mem_load64(p) == 0 -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } _ -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_guard_uses_released)), 0)

  let match_ctor_guard_no_wildcard = "type ReuseGuardNoWildcardMetric { ReuseGuardNoWildcardA(i64), ReuseGuardNoWildcardB(i64) } fn reuse_guard_no_wildcard_pick(flag: bool) -> ReuseGuardNoWildcardMetric { if flag { ReuseGuardNoWildcardA(1) } else { ReuseGuardNoWildcardB(2) } } fn main() -> i64 { let flag = true let x = reuse_guard_no_wildcard_pick(flag) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseGuardNoWildcardA(v) if flag -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + v } else { 0 } } ReuseGuardNoWildcardA(v) -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + v } else { 0 } } ReuseGuardNoWildcardB(v) -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + v } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_ctor_guard_no_wildcard)), 0)

  let match_ctor_exhaustive_one_sided = "type ReuseOneSidedExhaustiveMetric { ReuseOneSidedExhaustiveA(i64), ReuseOneSidedExhaustiveB(i64) } fn reuse_one_sided_exhaustive_pick(flag: bool) -> ReuseOneSidedExhaustiveMetric { if flag { ReuseOneSidedExhaustiveA(1) } else { ReuseOneSidedExhaustiveB(2) } } fn main() -> i64 { let x = reuse_one_sided_exhaustive_pick(true) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseOneSidedExhaustiveA(v) -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + v } else { 0 } } ReuseOneSidedExhaustiveB(v) -> { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { v } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_ctor_exhaustive_one_sided)), 0)

  let match_ctor_exhaustive_size_mismatch = "type ReuseSizeMismatchExhaustiveMetric { ReuseSizeMismatchExhaustiveA(i64), ReuseSizeMismatchExhaustiveB(i64) } fn reuse_size_mismatch_exhaustive_pick(flag: bool) -> ReuseSizeMismatchExhaustiveMetric { if flag { ReuseSizeMismatchExhaustiveA(1) } else { ReuseSizeMismatchExhaustiveB(2) } } fn main() -> i64 { let x = reuse_size_mismatch_exhaustive_pick(true) let p: rc i64 = rc_default_alloc(8, 8) match x { ReuseSizeMismatchExhaustiveA(v) -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + v } else { 0 } } ReuseSizeMismatchExhaustiveB(v) -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(16, 8) if q != 0 { marker + v } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_ctor_exhaustive_size_mismatch)), 0)

  let match_binding_pattern = "fn main() -> i64 { let tag = 1 let p: rc i64 = rc_default_alloc(8, 8) match tag { n -> { let marker = mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + n } else { 0 } } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(match_binding_pattern)), 0)
}

test "rc_reuse_candidate_e2e_preserves_zeroed_reuse" {
  Test.assert_eq(rc_reuse_reallocs_same_zeroed(rc_reuse_scope_addr(), 8), 1)
}

test "rc_reuse_lowering_e2e_reuses_same_scope_block" {
  Test.assert_eq(rc_reuse_lowering_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_after_last_use" {
  Test.assert_eq(rc_reuse_lowering_after_last_use_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_after_prefix_chain" {
  Test.assert_eq(rc_reuse_lowering_after_prefix_chain_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_branch_then" {
  Test.assert_eq(rc_reuse_lowering_branch_large_same_scope(true), 1)
}

test "rc_reuse_lowering_e2e_reuses_branch_else" {
  Test.assert_eq(rc_reuse_lowering_branch_large_same_scope(false), 2)
}

test "rc_reuse_lowering_e2e_reuses_match_first_arm" {
  Test.assert_eq(rc_reuse_lowering_match_same_scope(0), 1)
}

test "rc_reuse_lowering_e2e_reuses_match_wildcard_arm" {
  Test.assert_eq(rc_reuse_lowering_match_same_scope(1), 2)
}

test "rc_reuse_lowering_e2e_reuses_match_three_arm_fallback" {
  Test.assert_eq(rc_reuse_lowering_match_three_same_scope(2), 3)
}

test "rc_reuse_lowering_e2e_reuses_match_guarded_hit" {
  Test.assert_eq(rc_reuse_lowering_match_guarded_same_scope(0, true), 1)
}

test "rc_reuse_lowering_e2e_reuses_match_guarded_fallthrough" {
  Test.assert_eq(rc_reuse_lowering_match_guarded_same_scope(0, false), 2)
}

test "rc_reuse_lowering_e2e_reuses_match_constructor_hit" {
  Test.assert_eq(rc_reuse_lowering_match_ctor_same_scope(RcReuseMatchCtorA(4)), 5)
}

test "rc_reuse_lowering_e2e_reuses_match_constructor_wildcard" {
  Test.assert_eq(rc_reuse_lowering_match_ctor_same_scope(RcReuseMatchCtorB(9)), 2)
}

test "rc_reuse_lowering_e2e_reuses_match_constructor_exhaustive_first" {
  Test.assert_eq(rc_reuse_lowering_match_ctor_exhaustive_same_scope(RcReuseExhaustiveA(4)), 5)
}

test "rc_reuse_lowering_e2e_reuses_match_constructor_exhaustive_second" {
  Test.assert_eq(rc_reuse_lowering_match_ctor_exhaustive_same_scope(RcReuseExhaustiveB(9)), 11)
}
