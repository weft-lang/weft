fn rc_reuse_typed_record_block(source_hash: i64, target_hash: i64, barrier: i64, release_result_is_returned: i64) -> IrBlock {
  let source = IrRecordInitI64(0, source_hash, ir_record_field_list_empty())
  let release = pipeline_managed_release_inst(1, 0, continuation_cleanup_kind_rc())
  let target = IrRecordInitI64(2, target_hash, ir_record_field_list_empty())
  let middle = if barrier == 1 {
    ir_inst_list_prepend(IrCallI64(3, 987654321, ir_value_list_empty()), ir_inst_list_prepend(target, ir_inst_list_empty()))
  } else {
    ir_inst_list_prepend(IrBindI64(0, 0, 0, ty_i64()), ir_inst_list_prepend(target, ir_inst_list_empty()))
  }
  IrBlock(0, ir_value_list_empty(), ir_inst_list_prepend(source, ir_inst_list_prepend(release, middle)), if release_result_is_returned == 1 { IrTermReturn(1) } else { IrTermReturn(2) })
}

fn rc_reuse_typed_block_wrapper_count(block: IrBlock) -> i64 {
  match pipeline_ir_reuse_block(block) {
    IrBlock(id, params, insts, term) -> ir_inst_list_count_tag(insts, 49)
  }
}

test "rc_reuse_typed_ir_drop_guided_happy_matrix" {
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(rc_reuse_typed_record_block(77, 77, 0, 0)), 1)

  let variant_source = IrVariantInitI64(0, 88, ir_value_list_prepend(4, ir_value_list_empty()), 0)
  let release = pipeline_managed_release_inst(1, 0, continuation_cleanup_kind_rc())
  let variant_target = IrVariantInitI64(2, 88, ir_value_list_prepend(5, ir_value_list_empty()), 0)
  let block = IrBlock(0, ir_value_list_empty(), ir_inst_list_prepend(variant_source, ir_inst_list_prepend(release, ir_inst_list_prepend(variant_target, ir_inst_list_empty()))), IrTermReturn(2))
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(block), 1)
}

test "rc_reuse_typed_ir_keeps_trusted_raw_release_fallback" {
  let source = IrRecordInitI64(0, 77, ir_record_field_list_empty())
  let release = IrCallI64(1, pipeline_rc_default_release_hash(), ir_value_list_prepend(0, ir_value_list_empty()))
  let target = IrRecordInitI64(2, 77, ir_record_field_list_empty())
  let block = IrBlock(0, ir_value_list_empty(), ir_inst_list_prepend(source, ir_inst_list_prepend(release, ir_inst_list_prepend(target, ir_inst_list_empty()))), IrTermReturn(2))
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(block), 1)
}

test "rc_reuse_typed_ir_drop_guided_sad_matrix" {
  -- Exact constructor identity and width are producer facts. Calls and
  -- observable release results are hard token-lifetime barriers.
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(rc_reuse_typed_record_block(77, 78, 0, 0)), 0)
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(rc_reuse_typed_record_block(77, 77, 1, 0)), 0)
  Test.assert_eq(rc_reuse_typed_block_wrapper_count(rc_reuse_typed_record_block(77, 77, 0, 1)), 0)
}

test "rc_reuse_runtime_unique_token_releases_children" {
  let child = rc_default_alloc_masked(8, 8, 0)
  rc_default_retain(child)
  let parent = rc_default_alloc_masked(8, 8, 1)
  mem_store64(parent, child)
  let token = rc_default_drop_reuse(parent)
  Test.assert_eq(token, parent)
  Test.assert_eq(rc_count(child), 1)
  let reused = rc_default_alloc_masked_reuse(token, 8, 8, 0)
  Test.assert_eq(reused, parent)
  rc_default_release(reused)
  rc_default_release(child)
}

test "rc_reuse_runtime_shared_promoted_and_weak_fallbacks" {
  let shared = rc_default_alloc_masked(8, 8, 0)
  rc_default_retain(shared)
  Test.assert_eq(rc_default_drop_reuse(shared), 0)
  Test.assert_eq(rc_count(shared), 1)
  rc_default_release(shared)

  let promoted = rc_default_alloc_masked(8, 8, 0)
  rc_default_promote(promoted)
  Test.assert_eq(rc_default_drop_reuse(promoted), 0)

  let observed = rc_default_alloc_masked(8, 8, 0)
  rc_default_weak_retain(observed)
  Test.assert_eq(rc_default_drop_reuse(observed), 0)
  Test.assert_eq(rc_default_weak_load(observed), 0)
  rc_default_weak_release(observed)
}

test "rc_reuse_runtime_size_mismatch_abandons_token" {
  let source = rc_default_alloc_masked(8, 8, 0)
  let token = rc_default_drop_reuse(source)
  let target = rc_default_alloc_masked_reuse(token, 16, 8, 0)
  Test.assert_eq(rc_size_word_size(mem_load64(rc_header_from_payload(target) + rc_payload_size_offset())), 16)
  rc_default_release(target)
}
