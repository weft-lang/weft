-- test/rc_reuse_candidate_metrics.weft -- native evidence for same-layout RC reuse candidates

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn rc_reuse_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn rc_reuse_metric_managed(native: NativeModule) -> i64 {
  pipeline_native_managed_reuse_candidate_count(native)
}

fn rc_reuse_metric_rc(native: NativeModule) -> i64 {
  pipeline_native_rc_reuse_candidate_count(native)
}

fn rc_reuse_metric_closure(native: NativeModule) -> i64 {
  pipeline_native_closure_reuse_candidate_count(native)
}

fn rc_reuse_metric_managed_lowered(native: NativeModule) -> i64 {
  pipeline_native_managed_reuse_lowering_count(native)
}

fn rc_reuse_metric_rc_lowered(native: NativeModule) -> i64 {
  pipeline_native_rc_reuse_lowering_count(native)
}

fn rc_reuse_metric_closure_lowered(native: NativeModule) -> i64 {
  pipeline_native_closure_reuse_lowering_count(native)
}

fn rc_reuse_reallocs_same_zeroed(addr: i64, payload_size: i64) -> i64 {
  let again: rc i64 = rc_default_alloc(payload_size, 8)
  if again == addr {
    if __mem_load64(again) == 0 { 1 } else { 0 }
  } else { 0 }
}

fn rc_reuse_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 77)
  let addr = p + 0
  if __mem_load64(p) == 77 { addr } else { 0 }
}

fn rc_reuse_lowering_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(1048000, 8)
  let q: rc i64 = rc_default_alloc(1048000, 8)
  if q != 0 { 1 } else { 0 }
}

fn rc_reuse_lowering_after_last_use_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  let marker = __mem_load64(p)
  let q: rc i64 = rc_default_alloc(600000, 8)
  if q != 0 { marker + 1 } else { 0 }
}

fn rc_reuse_lowering_after_prefix_chain_large_same_scope() -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  let marker = __mem_load64(p)
  let adjusted = marker + 1
  let q: rc i64 = rc_default_alloc(600000, 8)
  if q != 0 { adjusted } else { 0 }
}

fn rc_reuse_lowering_branch_large_same_scope(flag: bool) -> i64 {
  let p: rc i64 = rc_default_alloc(600000, 8)
  if flag {
    let marker = __mem_load64(p)
    let q: rc i64 = rc_default_alloc(600000, 8)
    if q != 0 { marker + 1 } else { 0 }
  } else {
    let marker = __mem_load64(p)
    let q: rc i64 = rc_default_alloc(600000, 8)
    if q != 0 { marker + 2 } else { 0 }
  }
}

test "rc_reuse_candidate_happy_matrix" {
  let same_size = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  let same_native = rc_reuse_metric_native(same_size)
  Test.assert_eq(rc_reuse_metric_rc(same_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(same_native), 1)
  Test.assert_eq(rc_reuse_metric_managed(same_native), rc_reuse_metric_rc(same_native) + rc_reuse_metric_closure(same_native))
  Test.assert_eq(rc_reuse_metric_managed_lowered(same_native), rc_reuse_metric_rc_lowered(same_native) + rc_reuse_metric_closure_lowered(same_native))

  let after_last_use = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } }"
  let after_last_native = rc_reuse_metric_native(after_last_use)
  Test.assert_eq(rc_reuse_metric_rc(after_last_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(after_last_native), 1)

  let prefix_chain = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = __mem_load64(p) let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted } else { 0 } }"
  let prefix_chain_native = rc_reuse_metric_native(prefix_chain)
  Test.assert_eq(rc_reuse_metric_rc(prefix_chain_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(prefix_chain_native), 1)

  let branch_reuse = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } }"
  let branch_reuse_native = rc_reuse_metric_native(branch_reuse)
  Test.assert_eq(rc_reuse_metric_rc(branch_reuse_native), 2)
  Test.assert_eq(rc_reuse_metric_rc_lowered(branch_reuse_native), 2)

  let branch_alloc = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) if true { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 2 } else { 0 } } else { 0 } }"
  let branch_native = rc_reuse_metric_native(branch_alloc)
  Test.assert_eq(rc_reuse_metric_rc(branch_native), 1)
  Test.assert_eq(rc_reuse_metric_rc_lowered(branch_native), 0)
  Test.assert_eq(rc_reuse_metric_closure(branch_native), 0)
}

test "rc_reuse_candidate_sad_matrix" {
  let size_mismatch = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(16, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(size_mismatch)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(size_mismatch)), 0)

  let dynamic_size = "fn main() -> i64 { let sz = 8 let p: rc i64 = rc_default_alloc(sz, 8) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(dynamic_size)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(dynamic_size)), 0)

  let used_after_alloc = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = rc_default_alloc(8, 8) __mem_load64(p) }"
  Test.assert_eq(rc_reuse_metric_rc(rc_reuse_metric_native(used_after_alloc)), 0)
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(used_after_alloc)), 0)

  let prefix_store = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = __mem_store64(p, 1) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_store)), 0)

  let prefix_chain_rest_uses_released = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = __mem_load64(p) let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) __mem_load64(p) }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_chain_rest_uses_released)), 0)

  let prefix_chain_no_released_use = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let marker = 1 let adjusted = marker + 1 let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { adjusted } else { 0 } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(prefix_chain_no_released_use)), 0)

  let branch_one_sided = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_one_sided)), 0)

  let branch_condition_uses_released = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) if __mem_load64(p) == 0 { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_condition_uses_released)), 0)

  let branch_size_mismatch = "fn main() -> i64 { let flag = true let p: rc i64 = rc_default_alloc(8, 8) if flag { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(8, 8) if q != 0 { marker + 1 } else { 0 } } else { let marker = __mem_load64(p) let q: rc i64 = rc_default_alloc(16, 8) if q != 0 { marker + 2 } else { 0 } } }"
  Test.assert_eq(rc_reuse_metric_rc_lowered(rc_reuse_metric_native(branch_size_mismatch)), 0)
}

test "rc_reuse_candidate_e2e_preserves_zeroed_reuse" {
  Test.assert_eq(rc_reuse_reallocs_same_zeroed(rc_reuse_scope_addr(), 8), 1)
}

test "rc_reuse_lowering_e2e_reuses_same_scope_block" {
  Test.assert_eq(rc_reuse_lowering_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_after_last_use" {
  Test.assert_eq(rc_reuse_lowering_after_last_use_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_after_prefix_chain" {
  Test.assert_eq(rc_reuse_lowering_after_prefix_chain_large_same_scope(), 1)
}

test "rc_reuse_lowering_e2e_reuses_branch_then" {
  Test.assert_eq(rc_reuse_lowering_branch_large_same_scope(true), 1)
}

test "rc_reuse_lowering_e2e_reuses_branch_else" {
  Test.assert_eq(rc_reuse_lowering_branch_large_same_scope(false), 2)
}
