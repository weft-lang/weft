use stdlib/grammar.{Grammar, ParseResult, Parsed, Recovered, Rejected}
use stdlib/source.{Source, Span}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/option.{Option, Some, None}
use stdlib/list.{List, Cons, Nil}
use stdlib/state as state

-- Two independent syntax products exercise the public associated-type seam.
type TextGrammar { TextGrammar }

type TextSyntax { source: Span, text: str }

type ByteCountGrammar { ByteCountGrammar }

impl Grammar for TextGrammar {
  type Syntax = TextSyntax
  fn parse(self, source: Span) -[Diagnose]> ParseResult<TextSyntax> {
    match source.text() {
      None -> {
        Diagnose.report(uncoded(DiagnosticSeverityError, DiagnosticClassParse, "incomplete UTF-8 scalar", source.location()))
        Rejected<TextSyntax>()
      }
      Some(text) -> {
        let syntax = TextSyntax { source: source, text: text }
        if text == "?" {
          Diagnose.report(uncoded(DiagnosticSeverityError, DiagnosticClassParse, "unfinished text", source.location()))
          Recovered(syntax)
        } else { Parsed(syntax) }
      }
    }
  }
}

impl Grammar for ByteCountGrammar {
  type Syntax = usize
  fn parse(self, source: Span) -[Diagnose]> ParseResult<usize> { Parsed(source.len()) }
}

fn parse_with<G: Grammar>(grammar: G, source: Span) -[Diagnose]> ParseResult<G.Syntax> {
  grammar.parse(source)
}

fn collect<G: Grammar>(grammar: G, source: Span) -> (ParseResult<G.Syntax>, List<Diagnostic>) {
  state.run(Nil<Diagnostic>(), () => handle parse_with(grammar, source) {
    Diagnose.report(diagnostic) -> {
      state.modify((items: List<Diagnostic>) => Cons(diagnostic, items))
      resume(0)
    }
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
}

test "a generic grammar caller preserves independent associated syntax types" {
  let source = Source { text: "prefix é suffix", identity: DiagnosticSourceNamed("host") }
  let span = source.span(7, 9).unwrap()
  let (text, text_diagnostics) = collect(TextGrammar(), span)
  let (size, size_diagnostics) = collect(ByteCountGrammar(), span)
  Test.assert_true(match text {
    Parsed(syntax) -> syntax.text == "é" and syntax.source.start() == 7 and syntax.source.end() == 9
    _ -> false
  })
  Test.assert_true(match size { Parsed(count) -> count == 2, _ -> false })
  Test.assert_eq_usize(text_diagnostics.len(), 0)
  Test.assert_eq_usize(size_diagnostics.len(), 0)
}

test "a grammar can retain partial syntax with its original error location" {
  let source = Source { text: "é ? end", identity: DiagnosticSourceNamed("host") }
  let (result, diagnostics) = collect(TextGrammar(), source.span(3, 4).unwrap())
  Test.assert_true(match result { Recovered(syntax) -> syntax.text == "?", _ -> false })
  Test.assert_eq_usize(diagnostics.len(), 1)
  Test.assert_true(match diagnostics.first().unwrap().primary() {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) -> name == "host" and start == 3 and end == 4
    _ -> false
  })
}

test "grammar rejection is distinct from a valid empty syntax product" {
  let source = Source { text: "é", identity: DiagnosticSourceUnknown }
  let (empty, empty_diagnostics) = collect(TextGrammar(), source.span(0, 0).unwrap())
  Test.assert_true(match empty { Parsed(syntax) -> syntax.text == "" and syntax.source.is_empty(), _ -> false })
  Test.assert_eq_usize(empty_diagnostics.len(), 0)
  let (rejected, errors) = collect(TextGrammar(), source.span(0, 1).unwrap())
  Test.assert_true(match rejected { Rejected -> true, _ -> false })
  Test.assert_eq_usize(errors.len(), 1)
}

fn retained_text_syntax() -> ParseResult<TextSyntax> {
  let source = Source { text: "retained".concat(" text"), identity: DiagnosticSourceNamed("owned".concat(".txt")) }
  let (result, _) = collect(TextGrammar(), source.all())
  result
}

test "ordinary grammar syntax retains source text beyond the caller scope" {
  let result = retained_text_syntax()
  for _ in 0..64 {
    let other = "overwrite".repeat(32)
    Test.assert_eq_usize(other.len(), 288)
    Test.assert_true(match result {
      Parsed(syntax) -> syntax.text == "retained text" and syntax.source.source().text == "retained text"
      _ -> false
    })
  }
}
