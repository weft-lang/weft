use runtime/alloc.{*}
use runtime/string.{*}
use stdlib/io.{*}

fn cstring_scoped_growth(count: i64) -> i64 {
  let source = "abc"
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..count {
    checksum = checksum + runtime_str_with_cstring_i64(source, (raw) => {
      mem_load8(raw) + mem_load8(raw + 3)
    })
  }
  let after = alloc_bump_mark()
  if checksum == count * 97 { after - before } else { 0 - 1 }
}

fn cstring_raw_open_growth(count: i64) -> i64 {
  let path = "/tmp/weft-cstring-scope-missing"
  let before = alloc_bump_mark()
  let mut failures = 0
  for i in 0..count {
    if raw_open(path, io_o_rdonly(), 0) < 0 {
      failures = failures + 1
    } else { 0 }
  }
  let after = alloc_bump_mark()
  if failures == count { after - before } else { 0 - 1 }
}

test "C string callback reclaims synchronous marshalling bytes" {
  -- Item 2s.7 mechanism ledger (100 calls): the old raw helper
  -- abandoned 400 bytes (len + NUL per call) on the bump arena.
  -- The scoped callback restores the exact same-segment mark after
  -- the trusted consumer returns.
  Test.assert_eq(cstring_scoped_growth(100), 0)
}

test "raw IO path reclaims C string marshalling bytes" {
  Test.assert_eq(cstring_raw_open_growth(100), 0)
}
