use stdlib/test.{Test}
use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}
use stdlib/drop.{Drop}
use stdlib/num.{*}

type NumericToken { log: F64Table, digit: f64 }

impl Drop for NumericToken {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() * 10.0 + self.digit)
    nil
  }
}

effect NumericStep { fn next() -> i64 }

fn numeric_owned_f64(log: F64Table) -> f64 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 1.0 }
  7.5
}

fn numeric_owned_f32(log: F64Table) -> f32 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 1.0 }
  7.5
}

test "straight floating returns preserve owned binding cleanup at both widths" {
  let log64 = f64_table.zeros(1, 1).unwrap()
  let log32 = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_owned_f64(log64), 7.5)
  Test.assert_eq_f64(numeric_owned_f32(log32).to_f64(), 7.5)
  Test.assert_eq_f64(log64.get(0, 0).unwrap(), 1.0)
  Test.assert_eq_f64(log32.get(0, 0).unwrap(), 1.0)
}

fn numeric_effect_f64(log: F64Table) -[NumericStep]> f64 {
  let first: owned NumericToken = NumericToken { log: log, digit: 1.0 }
  let second: owned NumericToken = NumericToken { log: log, digit: 2.0 }
  NumericStep.next().to_f64()
}

fn numeric_effect_f32(log: F64Table) -[NumericStep]> f32 {
  let first: owned NumericToken = NumericToken { log: log, digit: 1.0 }
  let second: owned NumericToken = NumericToken { log: log, digit: 2.0 }
  NumericStep.next().to_f32_round()
}

test "resumed floating functions drop all resources once in scope order" {
  let log64 = f64_table.zeros(1, 1).unwrap()
  let log32 = f64_table.zeros(1, 1).unwrap()
  let result64 = handle numeric_effect_f64(log64) { NumericStep.next() -> resume(7) }
  let result32 = handle numeric_effect_f32(log32) { NumericStep.next() -> resume(7) }
  Test.assert_eq_f64(result64, 7.0)
  Test.assert_eq_f64(result32.to_f64(), 7.0)
  Test.assert_eq_f64(log64.get(0, 0).unwrap(), 21.0)
  Test.assert_eq_f64(log32.get(0, 0).unwrap(), 21.0)
}

test "aborted floating functions unwind all resources once in scope order" {
  let log64 = f64_table.zeros(1, 1).unwrap()
  let log32 = f64_table.zeros(1, 1).unwrap()
  let result64 = handle numeric_effect_f64(log64) { NumericStep.next() -> 8.5 }
  let result32 = handle numeric_effect_f32(log32) { NumericStep.next() -> 8.5.to_f32_round() }
  Test.assert_eq_f64(result64, 8.5)
  Test.assert_eq_f64(result32.to_f64(), 8.5)
  Test.assert_eq_f64(log64.get(0, 0).unwrap(), 21.0)
  Test.assert_eq_f64(log32.get(0, 0).unwrap(), 21.0)
}

fn numeric_generic_f64<T>(log: F64Table, value: T) -> f64 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 3.0 }
  2.5
}

test "numeric generic specializations preserve local ownership annotations" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_generic_f64<str>(log, "payload"), 2.5)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 3.0)
}

fn numeric_owned_operand(log: F64Table) -> f64 {
  0.5 + {
    let guard: owned NumericToken = NumericToken { log: log, digit: 4.0 }
    3.0
  }
}

test "a contextual numeric operand preserves nested owned cleanup" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_owned_operand(log), 3.5)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 4.0)
}

fn numeric_consume(guard: owned NumericToken) -> f64 { 9.5 }

fn numeric_transfer(log: F64Table) -> f64 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 5.0 }
  numeric_consume(guard)
}

test "ownership transferred from a numeric body is dropped only by the callee" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_transfer(log), 9.5)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 5.0)
}

fn numeric_branch_f32(log: F64Table, choose: bool) -> f32 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 6.0 }
  if choose { 16777216.0 + 1.0 } else { 0.0 - 1.5 }
}

test "checked single precision result paths retain width and cleanup through joins" {
  for choose in [true, false] {
    let log = f64_table.zeros(1, 1).unwrap()
    Test.assert_eq_f64(numeric_branch_f32(log, choose).to_f64(), if choose { 16777216.0 } else { 0.0 - 1.5 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 6.0)
  }
}

fn numeric_operand_f32(log: F64Table, first: f32) -> f32 {
  first + {
    let guard: owned NumericToken = NumericToken { log: log, digit: 7.0 }
    0.5
  }
}

test "single precision operands carry their checked width through owned scopes" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_operand_f32(log, 1.25).to_f64(), 1.75)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 7.0)
}

fn numeric_separate_initializer(log: F64Table) -> f32 {
  let ordinary = 16777217.0
  log.set(0, 0, ordinary)
  let mut count = 1
  count = count + 1
  match count { 2 -> 2.5, _ -> 0.0 }
}

test "result width follows sequences and matches without changing binding initializer types" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_separate_initializer(log).to_f64(), 2.5)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 16777217.0)
}

fn numeric_explicit_return(log: F64Table) -> f32 {
  let guard: owned NumericToken = NumericToken { log: log, digit: 8.0 }
  return 1.25 + 0.5
}

test "explicit numeric returns preserve checked width and resource cleanup" {
  let log = f64_table.zeros(1, 1).unwrap()
  Test.assert_eq_f64(numeric_explicit_return(log).to_f64(), 1.75)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 8.0)
}
