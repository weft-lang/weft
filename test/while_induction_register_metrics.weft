-- test/while_induction_register_metrics.weft -- native evidence for register-held while induction loops

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn while_induction_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn while_induction_metric_register(src: str) -> i64 {
  pipeline_native_while_induction_register_count(while_induction_metric_native(src))
}

test "while_induction_register_metric_lowers_increment_loop" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i i = i + 1 } total }"
  Test.assert_eq(while_induction_metric_register(src), 1)
}

test "while_induction_register_metric_lowers_variable_step_loop" {
  let src = "fn main(n: i64, step: i64) -> i64 { let mut j = 0 let mut total = 0 while j < n { total = total + j j = j + step } total }"
  Test.assert_eq(while_induction_metric_register(src), 1)
}

test "while_induction_register_metric_lowers_decrement_loop" {
  let src = "fn main(n: i64) -> i64 { let mut i = n while i >= 0 { i = i - 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 1)
}

test "while_induction_register_metric_lowers_nested_loops" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { { let mut j = 0 while j < i { total = total + j j = j + 1 } } i = i + 1 } total }"
  Test.assert_eq(while_induction_metric_register(src), 2)
}

test "while_induction_register_metric_keeps_missing_update_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i } total }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_complex_update_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { i = i + n + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_body_write_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { i = i + 1 i = i + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_break_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { if i == 3 { break } else { 0 } i = i + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_runtime_sums_increment_loop" {
  let mut i = 0
  let mut total = 0
  while i < 5 {
    total = total + i
    i = i + 1
  }
  Test.assert_eq(total, 10)
}

test "while_induction_register_runtime_variable_step_loop" {
  let mut j = 0
  let mut total = 0
  let step = 3
  while j < 10 {
    total = total + j
    j = j + step
  }
  Test.assert_eq(total, 18)
}

test "while_induction_register_runtime_decrement_loop" {
  let mut i = 4
  let mut total = 0
  while i >= 0 {
    total = total + i
    i = i - 1
  }
  Test.assert_eq(total, 10)
}

test "while_induction_register_runtime_writes_back_final_value" {
  let mut i = 0
  while i < 5 {
    i = i + 1
  }
  Test.assert_eq(i, 5)
}

test "while_induction_register_runtime_rechecks_mutated_bound" {
  let mut i = 0
  let mut end = 3
  let mut total = 0
  while i < end {
    total = total + i
    end = end - 1
    i = i + 1
  }
  Test.assert_eq(total, 1)
}
