-- test/while_induction_register_metrics.weft -- native evidence for register-held while induction loops

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"

fn while_induction_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  -- This suite measures the legacy AST while-induction register optimiser.
  -- Typed-IR native loop CFG emission has separate cutover coverage; keep this
  -- pinned until typed IR consumes equivalent while-induction facts.
  pipeline_lower_native_ir(typed)
}

fn while_induction_metric_register(src: str) -> i64 {
  pipeline_native_while_induction_register_count(while_induction_metric_native(src))
}

fn while_induction_metric_pinned(src: str) -> i64 {
  pipeline_native_register_pinned_count(while_induction_metric_native(src))
}

fn while_induction_metric_spill_counter(src: str) -> i64 {
  pipeline_native_register_spill_counter_count(while_induction_metric_native(src))
}

fn while_induction_metric_no_free(src: str) -> i64 {
  pipeline_native_register_no_free_count(while_induction_metric_native(src))
}

test "while_induction_register_metric_lowers_increment_loop" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i i = i + 1 } total }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_lowers_variable_step_loop" {
  let src = "fn main(n: i64, step: i64) -> i64 { let mut j = 0 let mut total = 0 while j < n { total = total + j j = j + step } total }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_lowers_decrement_loop" {
  let src = "fn main(n: i64) -> i64 { let mut i = n while i >= 0 { i = i - 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_lowers_nested_loops" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { { let mut j = 0 while j < i { total = total + j j = j + 1 } } i = i + 1 } total }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_reuses_natural_register_after_mutable_spills" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i i = i + 1 } total + a + b + c + d + e + f }"
  Test.assert_eq(while_induction_metric_register(src), 0)
  Test.assert_eq(while_induction_metric_pinned(src), 0)
  Test.assert_eq(while_induction_metric_spill_counter(src), 0)
}

test "while_induction_register_metric_reuses_natural_register_through_immutable_let" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, n: i64) -> i64 { let mut total = 0 let x = 1 let mut i = 0 while i < n { total = total + i + x i = i + 1 } total + a + b + c + d + e + f }"
  Test.assert_eq(while_induction_metric_register(src), 0)
  Test.assert_eq(while_induction_metric_pinned(src), 0)
  Test.assert_eq(while_induction_metric_spill_counter(src), 0)
}

test "while_induction_register_metric_keeps_no_free_physical_register_generic" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i i = i + 1 } total + a + b + c + d + e + f + g }"
  Test.assert_eq(while_induction_metric_register(src), 0)
  Test.assert_eq(while_induction_metric_pinned(src), 0)
  Test.assert_eq(while_induction_metric_no_free(src), 0)
}

test "while_induction_register_metric_keeps_missing_update_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + i } total }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_complex_update_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { i = i + n + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_body_write_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { i = i + 1 i = i + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_metric_keeps_break_generic" {
  let src = "fn main(n: i64) -> i64 { let mut i = 0 while i < n { if i == 3 { break } else { 0 } i = i + 1 } i }"
  Test.assert_eq(while_induction_metric_register(src), 0)
}

test "while_induction_register_runtime_sums_increment_loop" {
  let mut i = 0
  let mut total = 0
  while i < 5 {
    total = total + i
    i = i + 1
  }
  Test.assert_eq(total, 10)
}

test "while_induction_register_runtime_variable_step_loop" {
  let mut j = 0
  let mut total = 0
  let step = 3
  while j < 10 {
    total = total + j
    j = j + step
  }
  Test.assert_eq(total, 18)
}

test "while_induction_register_runtime_decrement_loop" {
  let mut i = 4
  let mut total = 0
  while i >= 0 {
    total = total + i
    i = i - 1
  }
  Test.assert_eq(total, 10)
}

test "while_induction_register_runtime_writes_back_final_value" {
  let mut i = 0
  while i < 5 {
    i = i + 1
  }
  Test.assert_eq(i, 5)
}

test "while_induction_register_runtime_mutable_body_preserves_outer_expression_temp" {
  let y = 7 + { let mut i = 0 while i < 3 { i = i + 1 } i }
  Test.assert_eq(y, 10)
}

fn while_induction_register_pressure(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + i
    i = i + 1
  }
  total + a + b + c + d + e + f
}

test "while_induction_register_runtime_spill_pressure_preserves_params" {
  Test.assert_eq(while_induction_register_pressure(1, 2, 3, 4, 5, 6, 4), 27)
}

test "while_induction_register_runtime_rechecks_mutated_bound" {
  let mut i = 0
  let mut end = 3
  let mut total = 0
  while i < end {
    total = total + i
    end = end - 1
    i = i + 1
  }
  Test.assert_eq(total, 1)
}
