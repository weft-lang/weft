-- String builder: combines string interpolation, for-in, List, Display, pipes
-- Expected exit code: 42
use "stdlib/display.weft"
use "stdlib/list.weft"

fn join_strings(parts: i64, sep: i64) -> i64 {
  let mut result = ""
  let mut first = 1
  for part in parts {
    if first == 1 {
      result = part
      first = 0
    } else {
      result = str_concat(str_concat(result, sep), part)
    }
  }
  result
}

fn main() -> i64 {
  let words = list_cons<str>("hello", list_cons<str>("beautiful", list_cons<str>("world", list_nil<str>())))
  let sentence = join_strings(words, " ")
  -- "hello beautiful world" = 21 chars, * 2 = 42
  str_len(sentence) * 2
}
