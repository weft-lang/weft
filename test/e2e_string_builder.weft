-- String builder: for-in over List<str>, str concat, content equality
-- Expected exit code: 42
use stdlib/string.{*}
use stdlib/list.{*}

fn join_strings(parts: List<str>, sep: str) -> str {
  let mut result = ""
  let mut first = 1
  for part in parts {
    if first == 1 {
      result = part
      first = 0
    } else {
      result = str_concat(str_concat(result, sep), part)
    }
  }
  result
}

fn main() -> i64 {
  let words = Cons<str>("hello", Cons<str>("beautiful", Cons<str>("world", Nil<str>())))
  let sentence = join_strings(words, " ")
  -- "hello beautiful world" = 21 chars, * 2 = 42
  __str_len(sentence) * 2
}
