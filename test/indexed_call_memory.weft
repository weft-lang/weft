use stdlib/vector as vector
use stdlib/test.{ Test }

fn cell_index(width: usize, row: usize, column: usize) -> usize {
  row * width + column
}

fn write_cell(view: [mut i64], width: usize, row: usize, column: usize) -> nil {
  view[cell_index(width, row, column)] = 42
}

fn forward_write(view: [mut i64], width: usize, row: usize, column: usize) -> nil {
  write_cell(view, width, row, column)
}

fn read_cell(view: [i64], width: usize, row: usize, column: usize) -> i64 {
  view[cell_index(width, row, column)]
}

fn increment(view: [mut i64], index: usize) -> i64 {
  let next = view[index] + 1
  view[index] = next
  next
}

fn generic_write<T>(view: [mut T], index: usize, value: T) -> nil {
  view[index] = value
}

test "slice writer calls preserve changes to array storage" {
  let mut values = [0, 0, 0, 0, 0, 0]
  write_cell(values[..], 3, 1, 2)
  Test.assert_eq(values[5], 42)
  Test.assert_eq(values[0], 0)
}

test "slice memory dependencies propagate through forwarding calls" {
  let mut values = [0, 0, 0]
  let before = read_cell(values[..], 3, 0, 2)
  forward_write(values[..], 3, 0, 2)
  let after = read_cell(values[..], 3, 0, 2)
  Test.assert_eq(before, 0)
  Test.assert_eq(after, 42)
}

test "slice writer calls preserve changes to owned vector storage" {
  let mut values = vector.new<i64>()
  values.push(0)
  values.push(0)
  write_cell(values[..], 2, 0, 1)
  Test.assert_eq(values[..][1], 42)
}

test "repeated calls with the same mutable view are not common subexpressions" {
  let mut values = [0, 0]
  let first = increment(values[..], 1)
  let second = increment(values[..], 1)
  increment(values[..], 1)
  Test.assert_eq(first, 1)
  Test.assert_eq(second, 2)
  Test.assert_eq(values[1], 3)
}

test "generic slice writes preserve scalar and managed replacements" {
  let mut numbers = [0, 0]
  generic_write<i64>(numbers[..], 1, 42)
  Test.assert_eq(numbers[1], 42)
  let mut names = ["old", "untouched"]
  generic_write<str>(names[..], 0, "replacement")
  Test.assert_str_eq(names[0], "replacement")
  Test.assert_str_eq(names[1], "untouched")
}

test "slice writers remain observable on every loop iteration" {
  let mut values = [0, 0, 0, 0]
  let first: usize = 0
  for column in first..values.len {
    forward_write(values[..], 4, 0, column)
  }
  Test.assert_eq(values[0] + values[1] + values[2] + values[3], 168)
}
