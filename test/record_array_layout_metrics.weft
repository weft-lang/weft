  Test.assert_eq(pipeline_lowered_args_next_value(borrowed), 10)
  Test.assert_eq(record_array_layout_call_count_insts(pipeline_lowered_args_insts(borrowed), pipeline_rc_default_release_hash()), 0)
}

test "record_array_layout_pipeline_preserves_compact_records_and_rejects_unknown_arrays" {
  let compact_src = __str_ptr("CompactBoxvalue")
  let compact_tt = ttable_new()
  let compact_fields = alloc_words(3)
  record_array_layout_store_decl_field(compact_fields, 0, 10, 5, ty_owned(ty_i64()))
  ttable_add(compact_tt, compact_src, 0, 10, 0, 1, compact_fields, 0)
  match pipeline_record_storage_layout_for_entry(compact_tt, ttable_lookup(compact_tt, compact_src, 0, 10), 0) {
    PipelineRecordStorageLayoutCompact -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  let invalid_src = __str_ptr("InvalidBoxitems")
  let invalid_tt = ttable_new()
  let invalid_fields = alloc_words(3)
  record_array_layout_store_decl_field(invalid_fields, 0, 10, 5, ty_array(ty_var(0), 1))
  ttable_add(invalid_tt, invalid_src, 0, 10, 0, 1, invalid_fields, 0)
  Test.assert_eq(pipeline_record_storage_layout_is_invalid(pipeline_record_storage_layout_for_entry(invalid_tt, ttable_lookup(invalid_tt, invalid_src, 0, 10), 0)), 1)
}

test "record_array_layout_pipeline_routes_scalar_and_owned_array_loads" {
  let src = __str_ptr("LayoutBoxheaditemsviewfoot")
  let tt = ttable_new()
  let layout = pipeline_record_storage_layout_for_entry(tt, record_array_layout_mixed_entry(tt, src), 0)
  let head = pipeline_ir_field_load_lane_insts_for_storage_layout(10, 2, str_hash(src, 9, 4), 0, ty_i64(), layout)
  Test.assert_eq(ir_inst_list_count_tag(head, 48), 1)
  Test.assert_eq(ir_inst_list_count_tag(head, 11), 0)
  let view = pipeline_ir_field_load_lane_insts_for_storage_layout(20, 2, str_hash(src, 18, 4), 2, ty_slice(ty_i64()), layout)
  Test.assert_eq(ir_inst_list_count_tag(view, 48), 2)
  let items = pipeline_lower_field_load_for_storage_layout(30, 2, str_hash(src, 13, 5), 1, ty_array(ty_str(), 3), layout)
  Test.assert_eq(ir_lowered_expr_value(items), 30)
  Test.assert_eq(ir_lowered_expr_next_value(items), 37)
  Test.assert_eq(ir_inst_list_count_tag(ir_lowered_expr_insts(items), 1), 5)
  Test.assert_eq(ir_inst_list_count_tag(ir_lowered_expr_insts(items), 4), 2)
  Test.assert_eq(ir_inst_list_count_tag(ir_lowered_expr_insts(items), 47), 1)
  Test.assert_eq(ir_inst_list_count_tag(ir_lowered_expr_insts(items), 44), 0)
  Test.assert_eq(ir_inst_list_count_tag(ir_lowered_expr_insts(items), 36), 0)
  Test.assert_eq(record_array_layout_call_count_insts(ir_lowered_expr_insts(items), pipeline_rc_array_storage_new_hash()), 1)
  Test.assert_eq(record_array_layout_call_count_insts(ir_lowered_expr_insts(items), pipeline_rc_array_storage_data_hash()), 1)
  let opt = pipeline_ir_opt_chain_insts_for_storage_layout(40, 2, str_hash(src, 9, 4), 0, 99, layout)
  Test.assert_eq(ir_inst_list_count_tag(opt, 23), 0)
  Test.assert_eq(ir_inst_list_count_tag(opt, 36), 1)
}

test "record_array_layout_surface_lowering_shares_construction_and_projection_ownership_facts" {
  let src = "type SurfaceArrayBox { head: i64, items: [i64; 3], foot: i64 } fn pack(items: [i64; 3]) -> SurfaceArrayBox { SurfaceArrayBox { foot: 9, items: items, head: 7 } } fn head_of(box: SurfaceArrayBox) -> i64 { box.head } fn items_of(box: SurfaceArrayBox) -> [i64; 3] { box.items } fn main() -> i64 { 0 }"
  let functions = pipeline_ir_functions(pipeline_lower_ir(pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)))
  Test.assert_eq(ir_function_list_count_tag(functions, 46), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 10), 0)
  Test.assert_eq(ir_function_list_count_tag(functions, 48), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 11), 0)
  Test.assert_eq(ir_function_list_count_tag(functions, 47), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 44), 0)
  Test.assert_eq(ir_function_list_count_tag(functions, 36), 0)
  let pack_hash = record_array_layout_name_hash("pack")
  let items_hash = record_array_layout_name_hash("items_of")
  Test.assert_eq(record_array_layout_call_count_function(functions, pack_hash, pipeline_rc_default_retain_hash()), 1)
  -- One release consumes the retained record-field source after the copy;
  -- the second is the function's ordinary owned-parameter cleanup.
  Test.assert_eq(record_array_layout_call_count_function(functions, pack_hash, pipeline_rc_default_release_hash()), 2)
  Test.assert_eq(record_array_layout_call_count_function(functions, items_hash, pipeline_rc_array_storage_new_hash()), 1)
  Test.assert_eq(record_array_layout_call_count_function(functions, items_hash, pipeline_rc_array_storage_data_hash()), 1)
  Test.assert_eq(record_array_layout_call_count_function(functions, items_hash, pipeline_rc_default_release_hash()), 0)
}

test "record_array_layout_surface_lowering_keeps_ordinary_record_ir_compact" {
  let src = "type SurfaceCompactBox { head: i64, foot: i64 } fn pack() -> SurfaceCompactBox { SurfaceCompactBox { foot: 9, head: 7 } } fn head_of(box: SurfaceCompactBox) -> i64 { box.head } fn main() -> i64 { 0 }"
  let functions = pipeline_ir_functions(pipeline_lower_ir(pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)))
  Test.assert_eq(ir_function_list_count_tag(functions, 10), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 46), 0)
  Test.assert_eq(ir_function_list_count_tag(functions, 11), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 48), 0)
}

