-- Array-bearing records use byte-accurate typed IR facts and one immutable
-- runtime layout descriptor. Ordinary word-layout records stay on their
-- existing byte-identical compact-mask path.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/unsafe.weft"

fn record_array_layout_word_count(code: i64, target: i64) -> i64 {
  let mut count = 0
  let mut pos = 0
  while pos + 4 <= buf_len(code) {
    if pipeline_native_code_word(code, pos) == target { count = count + 1 } else { 0 }
    pos = pos + 4
  }
  count
}

fn record_array_layout_register_runtime(fm: i64, name: str, offset: i64) -> i64 {
  fmap_add(fm, __str_ptr(name), 0, __str_len(name), offset)
  0
}

fn record_array_layout_fields(word_value: i64, array_data: i64, word_kind: i64, array_kind: i64) -> IrRecordLayoutFieldList {
  ir_record_layout_field_list_prepend_word(
    101,
    0,
    word_value,
    word_kind,
    ir_record_layout_field_list_prepend_array(
      202,
      8,
      array_data,
      24,
      if array_kind == continuation_cleanup_kind_none() { 0 } else { 3 },
      if array_kind == continuation_cleanup_kind_none() { 0 } else { 8 },
      array_kind,
      ir_record_layout_field_list_empty()
    )
  )
}

fn record_array_layout_function(array_data: i64) -> IrFunction {
  let fields = record_array_layout_fields(0, array_data, continuation_cleanup_kind_none(), continuation_cleanup_kind_rc())
  let insts = ir_inst_list_prepend(
    ir_inst_record_layout_init_i64(2, 303, 32, 8, fields),
    ir_inst_list_empty()
  )
  ir_function_new_src(74301, 2, ir_block_new_term(0, insts, ir_term_return(2)), 0)
}

test "record_array_layout_ir_tracks_definition_and_field_uses" {
  let fields = record_array_layout_fields(7, 9, continuation_cleanup_kind_none(), continuation_cleanup_kind_rc())
  let inst = ir_inst_record_layout_init_i64(11, 303, 32, 8, fields)
  Test.assert_eq(ir_inst_tag(inst), 46)
  Test.assert_eq(ir_inst_record_field_count_or(inst, 0), 2)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 11)
  Test.assert_eq(pipeline_ir_inst_def_or(inst, 0 - 1), 11)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 11)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 2)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 9), 1)
}

test "record_array_layout_alias_rewrite_preserves_layout_facts" {
  let aliases = pipeline_ir_alias_env_bind(
    pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3),
    9,
    4
  )
  let inst = ir_inst_record_layout_init_i64(11, 303, 32, 8, record_array_layout_fields(7, 9, continuation_cleanup_kind_weak(), continuation_cleanup_kind_rc()))
  match pipeline_ir_rewrite_inst_uses(inst, aliases) {
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> {
      Test.assert_eq(dst, 11)
      Test.assert_eq(type_hash, 303)
      Test.assert_eq(data_size, 32)
      Test.assert_eq(align, 8)
      match fields {
        IrRecordLayoutFieldWord(field_hash, byte_offset, value, managed_kind, rest) -> {
          Test.assert_eq(byte_offset, 0)
          Test.assert_eq(value, 3)
          Test.assert_eq(managed_kind, continuation_cleanup_kind_weak())
          match rest {
            IrRecordLayoutFieldArray(array_hash, array_offset, data, byte_size, leaf_count, leaf_stride, leaf_kind, tail) -> {
              Test.assert_eq(array_offset, 8)
              Test.assert_eq(data, 4)
              Test.assert_eq(byte_size, 24)
              Test.assert_eq(leaf_count, 3)
              Test.assert_eq(leaf_stride, 8)
              Test.assert_eq(leaf_kind, continuation_cleanup_kind_rc())
            }
            _ -> Test.assert_eq(0, 1)
          }
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "record_array_layout_verifier_tracks_both_field_inputs" {
  Test.assert_eq(pipeline_ir_verify_function(record_array_layout_function(1)), 0)
  -- kind 2, block 0, undefined value 9.
  Test.assert_eq(pipeline_ir_verify_function(record_array_layout_function(9)), 2000000009)
}

test "record_array_layout_validation_rejects_overlap_extent_and_kind_errors" {
  let none = continuation_cleanup_kind_none()
  let rc = continuation_cleanup_kind_rc()
  let empty = ir_record_layout_field_list_empty()
  Test.assert_eq(pipeline_record_layout_fields_are_valid(0, 1, empty), 1)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 8, record_array_layout_fields(0, 1, none, rc)), 1)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 0, record_array_layout_fields(0, 1, none, rc)), 0)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 3, record_array_layout_fields(0, 1, none, rc)), 0)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 16, record_array_layout_fields(0, 1, none, rc)), 0)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(2147483640, 8, empty), 0)
  let overlap = ir_record_layout_field_list_prepend_word(1, 0, 0, none, ir_record_layout_field_list_prepend_array(2, 4, 1, 24, 3, 8, rc, empty))
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 8, overlap), 0)
  let too_wide = ir_record_layout_field_list_prepend_array(2, 8, 1, 25, 3, 8, rc, empty)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(32, 8, too_wide), 0)
  let bad_kind = ir_record_layout_field_list_prepend_word(1, 0, 0, 99, empty)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(8, 8, bad_kind), 0)
  let bad_plan = ir_record_layout_field_list_prepend_array(2, 0, 1, 16, 3, 8, rc, empty)
  Test.assert_eq(pipeline_record_layout_fields_are_valid(16, 8, bad_plan), 0)
}

test "record_array_layout_descriptor_counts_only_managed_leaf_runs" {
  let none_fields = record_array_layout_fields(7, 9, continuation_cleanup_kind_none(), continuation_cleanup_kind_none())
  let managed_fields = record_array_layout_fields(7, 9, continuation_cleanup_kind_weak(), continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_record_layout_descriptor_entry_count(none_fields), 0)
  Test.assert_eq(pipeline_record_layout_descriptor_entry_count(managed_fields), 2)
  Test.assert_eq(pipeline_record_layout_descriptor_hash(32, managed_fields), pipeline_record_layout_descriptor_hash(32, record_array_layout_fields(70, 90, continuation_cleanup_kind_weak(), continuation_cleanup_kind_rc())))
  Test.assert_eq(if pipeline_record_layout_descriptor_hash(32, managed_fields) == pipeline_record_layout_descriptor_hash(32, none_fields) { 1 } else { 0 }, 0)
  Test.assert_eq(if pipeline_record_layout_descriptor_hash(32, managed_fields) == pipeline_record_layout_descriptor_hash(40, managed_fields) { 1 } else { 0 }, 0)
}

test "record_array_layout_native_emits_cached_descriptor_copy_and_retain" {
  let code = buf_new(4096)
  let fm = fmap_new()
  record_array_layout_register_runtime(fm, "rc_default_alloc_described", 32768)
  record_array_layout_register_runtime(fm, "rc_default_retain", 65536)
  let fields = record_array_layout_fields(0, 1, continuation_cleanup_kind_weak(), continuation_cleanup_kind_rc())
  let homes = pipeline_ir_native_identity_home_facts(3)
  pipeline_ir_native_emit_record_layout_init(code, 2, 303, 32, 8, fields, fm, homes)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  let descriptor = mono_cache_lookup(fmap_mono_cache(fm), pipeline_record_layout_descriptor_hash(32, fields))
  Test.assert_eq(if descriptor > 1 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor), pipeline_record_layout_descriptor_magic())
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 8), 32)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 16), 2)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 24), 0)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 32), 1)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 40), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 48), continuation_cleanup_kind_weak())
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 56), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 64), 3)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 72), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 80), continuation_cleanup_kind_rc())
  Test.assert_eq(record_array_layout_word_count(code, cg_ldrb(12, 13, 0)), 1)
  Test.assert_eq(record_array_layout_word_count(code, cg_strb(12, 14, 0)), 1)
  Test.assert_eq(record_array_layout_word_count(code, encode_ret()), 1)
  let first_descriptor = descriptor
  pipeline_ir_native_emit_record_layout_init(code, 2, 303, 32, 8, fields, fm, homes)
  Test.assert_eq(mono_cache_lookup(fmap_mono_cache(fm), pipeline_record_layout_descriptor_hash(32, fields)), first_descriptor)
  Test.assert_eq(record_array_layout_word_count(code, encode_ret()), 1)
}

test "record_array_layout_unmanaged_f64_bytes_need_no_retain_entry" {
  let code = buf_new(2048)
  let fm = fmap_new()
  record_array_layout_register_runtime(fm, "rc_default_alloc_described", 32768)
  let fields = record_array_layout_fields(0, 1, continuation_cleanup_kind_none(), continuation_cleanup_kind_none())
  pipeline_ir_native_emit_record_layout_init(code, 2, 303, 32, 8, fields, fm, pipeline_ir_native_identity_home_facts(3))
  let descriptor = mono_cache_lookup(fmap_mono_cache(fm), pipeline_record_layout_descriptor_hash(32, fields))
  Test.assert_eq(mem_load64_at(buf_ptr(code), descriptor + 16), 0)
  Test.assert_eq(record_array_layout_word_count(code, cg_ldrb(12, 13, 0)), 1)
  Test.assert_eq(record_array_layout_word_count(code, encode_ret()), 0)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
}

test "record_array_layout_invalid_facts_trap_before_emission" {
  let code = buf_new(64)
  let fm = fmap_new()
  let fields = record_array_layout_fields(0, 1, continuation_cleanup_kind_none(), continuation_cleanup_kind_rc())
  pipeline_ir_native_emit_record_layout_init(code, 2, 303, 31, 8, fields, fm, pipeline_ir_native_identity_home_facts(3))
  Test.assert_eq(buf_len(code), 4)
  Test.assert_eq(pipeline_native_code_word(code, 0), encode_brk(31))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}

test "record_array_layout_is_an_abort_cleanup_acquisition" {
  let fields = record_array_layout_fields(0, 1, continuation_cleanup_kind_none(), continuation_cleanup_kind_rc())
  let release_args = ir_value_list_prepend(2, ir_value_list_empty())
  let insts = ir_inst_list_prepend(
    ir_inst_record_layout_init_i64(2, 303, 32, 8, fields),
    ir_inst_list_prepend(ir_inst_call_i64(3, pipeline_rc_default_release_hash(), release_args), ir_inst_list_empty())
  )
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(3)), ir_block_list_empty())
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0)
  Test.assert_eq(nlist_len(facts), 1)
  let fact = nlist_get(facts, 0)
  Test.assert_eq(node_f1(fact), 2)
  Test.assert_eq(node_f2(fact), pipeline_rc_default_release_hash())
  Test.assert_eq(node_f3(fact), pipeline_ir_abort_cleanup_managed_kind())
}
