  Test.assert_eq(ir_inst_tag(inst), 48)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 7)
  Test.assert_eq(pipeline_ir_inst_def_or(inst, 99), 7)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 9)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 0)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 0)
  Test.assert_eq(pipeline_ir_native_resident_inst_simple(inst), 1)
  Test.assert_eq(pipeline_ir_native_resident_def_shape(inst, 0), 4)
  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 9), 1)
}

