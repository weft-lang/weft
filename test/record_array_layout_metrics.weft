test "record_array_layout_word_load_validation_checks_visible_extent" {
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(8, 0), 1)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(32, 24), 1)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(0, 0), 0)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(7, 0), 0)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(32, 25), 0)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(0 - 1, 0), 0)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(2147483640, 0), 0)
  Test.assert_eq(pipeline_record_layout_word_load_is_valid(32, 0 - 1), 0)
}

test "record_array_layout_word_load_native_skips_hidden_descriptor_word" {
  let code = buf_new(64)
  let fm = fmap_new()
  pipeline_ir_native_emit_record_layout_word_load(code, 0, 1, 32, 16, fm, pipeline_ir_native_identity_home_facts(2))
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  -- Visible offset 16 resides at physical offset 24 after the descriptor.
  Test.assert_eq(record_array_layout_word_count(code, encode_add_imm(16, 20, 24)), 1)
  Test.assert_eq(record_array_layout_word_count(code, cg_ldr(19, 16, 0)), 1)
  let bad = buf_new(16)
  pipeline_ir_native_emit_record_layout_word_load(bad, 0, 1, 32, 25, fm, pipeline_ir_native_identity_home_facts(2))
  Test.assert_eq(buf_len(bad), 4)
  Test.assert_eq(pipeline_native_code_word(bad, 0), encode_brk(33))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}

test "record_array_layout_word_load_preserves_slice_borrow_origin" {
  let initial = ir_borrow_value_facts_set(ir_borrow_value_facts_empty(), 0, pipeline_ir_borrow_unknown_origins(0, 0))
  let fields = ir_record_layout_field_list_prepend_word(
    404,
    8,
    0,
    continuation_cleanup_kind_none(),
    ir_record_layout_field_list_prepend_word(404, 16, 1, continuation_cleanup_kind_none(), ir_record_layout_field_list_empty())
  )
  let insts = ir_inst_list_prepend(
    ir_inst_record_layout_init_i64(2, 303, 24, 8, fields),
    ir_inst_list_prepend(
      ir_inst_record_layout_word_load_i64(3, 2, 24, 404, 8),
      ir_inst_list_prepend(ir_inst_record_layout_word_load_i64(4, 2, 24, 404, 16), ir_inst_list_empty())
    )
  )
  let pass = pipeline_ir_borrow_pass_insts(insts, pipeline_ir_borrow_pass_new(initial), PipelineIrSemanticFactNil)
  let projected = ir_borrow_value_facts_find(pipeline_ir_borrow_pass_values(pass), 3)
  Test.assert_eq(ir_borrow_origin_list_len(projected), 1)
  Test.assert_eq(ir_borrow_origin_list_contains_unknown(projected), 1)
  Test.assert_eq(pipeline_ir_borrow_values_complete_insts(insts, pipeline_ir_borrow_pass_values(pass)), 1)
}

fn record_array_layout_store_decl_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  mem_store64_at(fields, index * 24, ns)
  mem_store64_at(fields, index * 24 + 8, nl)
  mem_store64_at(fields, index * 24 + 16, ty)
  0
}

fn record_array_layout_mixed_entry(tt: i64, src: i64) -> i64 {
  let fields = alloc_words(12)
  record_array_layout_store_decl_field(fields, 0, 9, 4, ty_i64())
  record_array_layout_store_decl_field(fields, 1, 13, 5, ty_array(ty_str(), 3))
  record_array_layout_store_decl_field(fields, 2, 18, 4, ty_slice(ty_i64()))
  record_array_layout_store_decl_field(fields, 3, 22, 4, ty_f64())
  ttable_add(tt, src, 0, 9, 0, 4, fields, 0)
  ttable_lookup(tt, src, 0, 9)
}

test "record_array_layout_pipeline_producer_preserves_logical_lanes_and_byte_offsets" {
  let src = __str_ptr("LayoutBoxheaditemsviewfoot")
  let tt = ttable_new()
  let entry = record_array_layout_mixed_entry(tt, src)
  match pipeline_record_storage_layout_for_entry(tt, entry, 0) {
    PipelineRecordStorageLayoutDescribed(data_size, align, facts) -> {
      Test.assert_eq(data_size, 56)
      Test.assert_eq(align, 8)
      match facts {
        PipelineRecordStorageFieldFactWord(head_hash, head_word, head_byte, head_ty, head_lanes, tail1) -> {
          Test.assert_eq(head_hash, str_hash(src, 9, 4))
          Test.assert_eq(head_word, 0)
          Test.assert_eq(head_byte, 0)
          Test.assert_eq(head_lanes, 1)
          match tail1 {
            PipelineRecordStorageFieldFactArray(items_hash, items_word, items_byte, items_ty, byte_size, item_align, leaf_count, leaf_stride, leaf_kind, tail2) -> {
              Test.assert_eq(items_hash, str_hash(src, 13, 5))
              Test.assert_eq(items_word, 1)
              Test.assert_eq(items_byte, 8)
              Test.assert_eq(byte_size, 24)
              Test.assert_eq(item_align, 8)
              Test.assert_eq(leaf_count, 3)
              Test.assert_eq(leaf_stride, 8)
              Test.assert_eq(leaf_kind, continuation_cleanup_kind_rc())
              match tail2 {
                PipelineRecordStorageFieldFactWord(view_hash, view_word, view_byte, view_ty, view_lanes, tail3) -> {
                  Test.assert_eq(view_word, 2)
                  Test.assert_eq(view_byte, 32)
                  Test.assert_eq(view_lanes, 2)
                  match tail3 {
                    PipelineRecordStorageFieldFactWord(foot_hash, foot_word, foot_byte, foot_ty, foot_lanes, tail4) -> {
                      Test.assert_eq(foot_word, 4)
                      Test.assert_eq(foot_byte, 48)
                      Test.assert_eq(foot_lanes, 1)
                      match tail4 { PipelineRecordStorageFieldFactNil -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
                    }
                    _ -> Test.assert_eq(0, 1)
                  }
                }
                _ -> Test.assert_eq(0, 1)
              }
            }
            _ -> Test.assert_eq(0, 1)
          }
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "record_array_layout_pipeline_materializes_declaration_order_from_source_order_values" {
  let src = __str_ptr("LayoutBoxheaditemsviewfoot")
  let tt = ttable_new()
  let entry = record_array_layout_mixed_entry(tt, src)
  let values = ir_record_field_list_prepend(
    str_hash(src, 22, 4), 4, 44,
    ir_record_field_list_prepend(
      str_hash(src, 13, 5), 1, 22,
      ir_record_field_list_prepend(
        str_hash(src, 18, 4), 2, 33,
        ir_record_field_list_prepend(
          str_hash(src, 9, 4), 0, 11,
          ir_record_field_list_prepend(str_hash(src, 18, 4), 3, 34, ir_record_field_list_empty())
        )
      )
    )
  )
  match pipeline_record_init_inst_for_storage_layout(tt, entry, 0, 50, type_name_hash(src, 0, 9), values) {
    IrRecordLayoutInitI64(dst, type_hash, data_size, align, fields) -> {
      Test.assert_eq(dst, 50)
      Test.assert_eq(data_size, 56)
      match fields {
        IrRecordLayoutFieldWord(head_hash, head_byte, head_value, head_kind, tail1) -> {
          Test.assert_eq(head_byte, 0)
          Test.assert_eq(head_value, 11)
          match tail1 {
            IrRecordLayoutFieldArray(items_hash, items_byte, items_value, byte_size, leaf_count, leaf_stride, leaf_kind, tail2) -> {
              Test.assert_eq(items_byte, 8)
              Test.assert_eq(items_value, 22)
              Test.assert_eq(byte_size, 24)
              Test.assert_eq(leaf_kind, continuation_cleanup_kind_rc())
              match tail2 {
                IrRecordLayoutFieldWord(view_hash1, view_byte1, view_value1, view_kind1, tail3) -> {
                  Test.assert_eq(view_byte1, 32)
                  Test.assert_eq(view_value1, 33)
                  match tail3 {
                    IrRecordLayoutFieldWord(view_hash2, view_byte2, view_value2, view_kind2, tail4) -> {
                      Test.assert_eq(view_byte2, 40)
                      Test.assert_eq(view_value2, 34)
                      match tail4 {
                        IrRecordLayoutFieldWord(foot_hash, foot_byte, foot_value, foot_kind, tail5) -> {
                          Test.assert_eq(foot_byte, 48)
                          Test.assert_eq(foot_value, 44)
                          match tail5 { IrRecordLayoutFieldNil -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
                        }
                        _ -> Test.assert_eq(0, 1)
                      }
                    }
                    _ -> Test.assert_eq(0, 1)
                  }
                }
                _ -> Test.assert_eq(0, 1)
              }
            }
            _ -> Test.assert_eq(0, 1)
          }
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "record_array_layout_pipeline_consumes_array_source_handles_after_copy" {
  let src = __str_ptr("LayoutBoxheaditemsviewfoot")
  let tt = ttable_new()
  let entry = record_array_layout_mixed_entry(tt, src)
  let values = ir_record_field_list_prepend(
    str_hash(src, 9, 4), 0, 11,
    ir_record_field_list_prepend(
      str_hash(src, 13, 5), 1, 22,
      ir_record_field_list_prepend(
        str_hash(src, 18, 4), 2, 33,
        ir_record_field_list_prepend(
          str_hash(src, 18, 4), 3, 34,
          ir_record_field_list_prepend(str_hash(src, 22, 4), 4, 44, ir_record_field_list_empty())
        )
      )
    )
  )
  let cleanup = pipeline_record_array_source_releases_for_storage_layout(tt, entry, 0, values, 60)
  Test.assert_eq(pipeline_lowered_args_is_valid(cleanup), 1)
  Test.assert_eq(pipeline_lowered_args_next_value(cleanup), 61)
  Test.assert_eq(record_array_layout_call_count_insts(pipeline_lowered_args_insts(cleanup), pipeline_rc_default_release_hash()), 1)
  match pipeline_lowered_args_insts(cleanup) {
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          Test.assert_eq(dst, 60)
          Test.assert_eq(callee_hash, pipeline_rc_default_release_hash())
          Test.assert_eq(pipeline_ir_value_list_get_or(args, 0, 0 - 1), 22)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "record_array_layout_array_placement_fact_distinguishes_owned_projection" {
  let src = __str_ptr("boxitems")
  let tt = ttable_new()
  let array_ty = ty_array(ty_i64(), 3)
  let ident = Ident(0, 3)
  let projection = FieldAccess(ident, 3, 5, UnknownFieldAccessFact)
  Test.assert_eq(pipeline_expr_result_is_borrowed_for_ty_typed(ident, array_ty, src, 0, 0, tt), 1)
  Test.assert_eq(pipeline_expr_result_is_borrowed_for_ty_typed(projection, array_ty, src, 0, 0, tt), 0)
  Test.assert_eq(pipeline_expr_owned_array_value_typed(ident, array_ty, src, 0, 0, tt), 0)
  Test.assert_eq(pipeline_expr_owned_array_value_typed(projection, array_ty, src, 0, 0, tt), 1)
  -- Scalar field loads retain the established interior-borrow semantics.
  Test.assert_eq(pipeline_expr_result_is_borrowed_for_ty_typed(projection, ty_i64(), src, 0, 0, tt), 1)
  Test.assert_eq(cg_managed_drop_kind_for_ty(array_ty), continuation_cleanup_kind_rc())
  Test.assert_eq(if pipeline_ty_needs_rc_runtime(array_ty) { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_expr_needs_rc_runtime_typed(projection, src, tt) { 1 } else { 0 }, 1)
}

test "record_array_layout_borrowed_call_releases_owned_projection_temp" {
  let src = __str_ptr("boxitems")
  let tt = ttable_new()
  let expected_types = nlist_new()
  nlist_add(expected_types, ty_array(ty_i64(), 3))
  let projection = FieldAccess(Ident(0, 3), 3, 5, UnknownFieldAccessFact)
  let cleanup = pipeline_managed_lambda_temp_release_args_masked_typed(
    expr_list_prepend(projection, expr_list_empty()),
    ir_value_list_prepend(7, ir_value_list_empty()),
    0,
    10,
    1,
    0,
    0,
    expected_types,
    0,
    src,
    tt
  )
  Test.assert_eq(pipeline_lowered_args_next_value(cleanup), 11)
  Test.assert_eq(record_array_layout_call_count_insts(pipeline_lowered_args_insts(cleanup), pipeline_rc_default_release_hash()), 1)
  let borrowed = pipeline_managed_lambda_temp_release_args_masked_typed(
    expr_list_prepend(Ident(0, 3), expr_list_empty()),
    ir_value_list_prepend(7, ir_value_list_empty()),
    0,
    10,
    1,
    0,
    0,
    expected_types,
    0,
    src,
    tt
