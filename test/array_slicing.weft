use stdlib/num.{*}

type SliceCarrier {
  view: [i64],
}

effect SliceImmediate {
  fn read() -> i64
}

effect SliceAbort {
  fn read() -> i64
}

effect SliceDeferred {
  @deferred fn read() -> i64
}

fn slice_middle<T>(xs: [T], start: usize, end: usize) -> [T] {
  xs[start..end]
}

fn slice_immediate_clause() -> i64 {
  handle SliceImmediate.read() {
    SliceImmediate.read() -> {
      let values = [10, 20, 30]
      let view = values[1..]
      resume(view[0])
    }
  }
}

fn slice_abortive_clause() -> i64 {
  handle SliceAbort.read() {
    SliceAbort.read() -> {
      let values = [11, 22, 33]
      let view = values[..2]
      view[1]
    }
  }
}

fn slice_deferred_clause() -> i64 {
  handle SliceDeferred.read() {
    SliceDeferred.read() with k -> {
      let values = [13, 26, 39]
      let view = values[1..2]
      k(view[0])
    }
  }
}

test "half_open_slice_supports_every_endpoint_form" {
  let values = [10, 20, 30, 40]
  let all = values[..]
  let prefix = values[..2]
  let suffix = values[2..]
  let middle = values[1..3]
  Test.assert_eq(if all.len == 4 { 1 } else { 0 }, 1)
  Test.assert_eq(if prefix.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if suffix.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if middle.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(all[0] + prefix[1] + suffix[0] + middle[1], 90)
}

test "half_open_slice_accepts_empty_boundaries" {
  let empty: [i64; 0] = []
  let empty_view = empty[..]
  let values = [7, 9, 11]
  let at_start = values[..0]
  let at_middle = values[2..2]
  let at_end = values[3..]
  Test.assert_eq(if empty_view.len + at_start.len + at_middle.len + at_end.len == 0 { 1 } else { 0 }, 1)
}

test "slice_of_slice_composes_offsets_and_lengths" {
  let values = [2, 3, 5, 7, 11]
  let outer = values[1..5]
  let inner = outer[1..3]
  let tail = inner[1..]
  Test.assert_eq(if inner.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(inner[0], 5)
  Test.assert_eq(if tail.len == 1 { 1 } else { 0 }, 1)
  Test.assert_eq(tail[0], 7)
}

test "slice_specialises_generic_element_layout" {
  let ints = [10, 20, 30, 40]
  let words = ["alpha", "beta", "gamma"]
  let int_view = slice_middle<i64>(ints[..], 1, 3)
  let word_view = slice_middle<str>(words[..], 0, 2)
  Test.assert_eq(int_view[0] + int_view[1], 50)
  Test.assert_str_eq(word_view[1], "beta")
}

test "slice_preserves_exact_scalar_widths" {
  let bytes: [u8; 3] = [1, 2, 255]
  let wide: [f64; 3] = [1.25, 2.5, 3.75]
  let narrow: [f32; 3] = [1.5, 2.5, 3.5]
  let byte_view = bytes[1..]
  let wide_view = wide[..2]
  let narrow_view = narrow[1..2]
  Test.assert_eq(if byte_view[1] == 255 { 1 } else { 0 }, 1)
  Test.assert_eq_f64(wide_view[1], 2.5)
  Test.assert_eq_f64(num_f32_to_f64(narrow_view[0]), 2.5)
}

test "slice_evaluates_start_then_end_once" {
  let values = [10, 20, 30, 40]
  let mut order = 0
  let view = values[{ order = order * 10 + 1; 1 }..{ order = order * 10 + 2; 3 }]
  Test.assert_eq(order, 12)
  Test.assert_eq(view[0] + view[1], 50)
}

test "slice_lowers_cfg_endpoints" {
  let values = [3, 5, 7, 11]
  let view = values[if true { 1 } else { 0 }..if false { 4 } else { 3 }]
  Test.assert_eq(if view.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(view[0] * 10 + view[1], 57)
}

test "local_aggregate_may_hold_non_escaping_slice" {
  let values = [17, 19, 23]
  let carrier = SliceCarrier { view: values[1..] }
  Test.assert_eq(if carrier.view.len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(carrier.view[0] + carrier.view[1], 42)
}

test "mutable_slice_copies_shared_array_before_borrow" {
  let original = [10, 20, 30]
  let mut copy = original
  let writable: [mut i64] = copy[1..]
  writable[0] = 42
  Test.assert_eq(original[1], 20)
  Test.assert_eq(copy[1], 42)
}

test "mutable_slice_reborrow_freezes_then_restores_parent" {
  let mut values = [10, 20, 30, 40]
  let whole: [mut i64] = values[..]
  let part: [mut i64] = whole[1..3]
  part[0] = 7
  let observed = part[0]
  whole[0] = 5
  Test.assert_eq(observed, 7)
  Test.assert_eq(whole[0], 5)
  Test.assert_eq(values[1], 7)
}

test "immutable_reborrow_temporarily_freezes_mutable_slice" {
  let mut values = [4, 6, 8]
  let writable: [mut i64] = values[..]
  let readable: [i64] = writable[1..]
  let observed = readable[0]
  writable[0] = 36
  Test.assert_eq(observed, 6)
  Test.assert_eq(writable[0] + writable[1], 42)
}

test "slice_lowering_runs_in_all_handler_tiers" {
  Test.assert_eq(slice_immediate_clause(), 20)
  Test.assert_eq(slice_abortive_clause(), 22)
  Test.assert_eq(slice_deferred_clause(), 26)
}
