type RuntimePatternShape {
  RuntimePoint,
  RuntimeCircle(i64),
  RuntimeRect(i64, i64)
}

fn runtime_classify_shape(s: RuntimePatternShape) -> i64 {
  match s {
    RuntimePoint -> 1
    RuntimeCircle(_) -> 2
    RuntimeRect(w, h) -> w + h
  }
}

fn runtime_guard_shape(s: RuntimePatternShape) -> i64 {
  match s {
    RuntimeCircle(r) if r > 10 -> r
    RuntimeCircle(_) -> 0
    RuntimeRect(_, h) -> h
    RuntimePoint -> 1
  }
}

test "pattern_zero_single_and_multi_payloads" {
  let a = runtime_classify_shape(RuntimePoint())
  let b = runtime_classify_shape(RuntimeCircle(99)) * 10
  let c = runtime_classify_shape(RuntimeRect(7, 8)) * 100
  Test.assert_eq(a + b + c, 1521)
}

test "pattern_guards_and_wildcards" {
  let a = runtime_guard_shape(RuntimeCircle(12))
  let b = runtime_guard_shape(RuntimeCircle(3)) * 10
  let c = runtime_guard_shape(RuntimeRect(4, 5)) * 100
  Test.assert_eq(a + b + c, 512)
}
