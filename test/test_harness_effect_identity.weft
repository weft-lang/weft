use stdlib/fail.{Fail}
use stdlib/io.{IO}
use stdlib/test.{Test}

fn test_harness_fail() -[Fail<i64>]> i64 {
  Fail.fail(7)
}

fn test_harness_write() -[IO]> i64 {
  IO.write(1, 0, 3)
}

test "test harness Fail is the canonical stdlib effect" {
  Test.assert_eq(Test.expect_fail_i64(7, test_harness_fail), 7)
}

test "test harness IO is the canonical stdlib effect" {
  Test.assert_eq(Test.with_io_i64(test_harness_write), 3)
}
