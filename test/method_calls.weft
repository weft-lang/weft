type RuntimeMethodBox {
  v: i64
}

impl RuntimeMethodBox {
  fn add(self: RuntimeMethodBox, n: i64) -> i64 {
    self.v + n
  }

  fn add3(self: RuntimeMethodBox, a: i64, b: i64, c: i64) -> i64 {
    self.v + a + b + c
  }
}

test "method_call_one_arg" {
  let b = RuntimeMethodBox { v: 20 }
  Test.assert_eq(b.add(22), 42)
}

test "method_call_three_args" {
  let b = RuntimeMethodBox { v: 9 }
  Test.assert_eq(b.add3(10, 11, 12), 42)
}
