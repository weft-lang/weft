-- test/numeric_integer_family.weft -- scalar fixed-width integer family coverage

fn i8_id(x: i8) -> i8 { x }
fn i16_id(x: i16) -> i16 { x }
fn u8_id(x: u8) -> u8 { x }
fn u16_id(x: u16) -> u16 { x }
fn u32_id(x: u32) -> u32 { x }
fn u64_id(x: u64) -> u64 { x }
fn isize_id(x: isize) -> isize { x }
fn usize_id(x: usize) -> usize { x }

fn i8_min() -> i8 { 0 - 128 }
fn i64_min_literal() -> i64 { 0 - 9223372036854775808 }
fn u8_max() -> u8 {
  let zero: u8 = 0
  zero - 1
}
fn u64_max_literal() -> u64 { 18446744073709551615 }
fn usize_max_literal() -> usize { 18446744073709551615 }

test "integer_family_contextual_literals_in_let_call_and_return" {
  let a: i8 = 127
  let b: i16 = 32767
  let c: u8 = 255
  let d: u16 = 65535
  let e: u32 = 4294967295
  let f: u64 = 42
  let g: isize = 0 - 7
  let h: usize = 9
  Test.assert_eq(if i8_id(a) == 127 { 1 } else { 0 }, 1)
  Test.assert_eq(if i16_id(b) == 32767 { 1 } else { 0 }, 1)
  Test.assert_eq(if u8_id(c) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_id(d) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_id(e) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_id(f) == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(if isize_id(g) < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_id(h) == 9 { 1 } else { 0 }, 1)
}

test "integer_family_signed_widths_wrap_and_compare_signed" {
  let i8_hi: i8 = 127
  let i16_hi: i16 = 32767
  let i32_hi: i32 = 2147483647
  let i8_wrapped = i8_hi + 1
  let i16_wrapped = i16_hi + 1
  let i32_wrapped = i32_hi + 1
  Test.assert_eq(if i8_wrapped == 0 - 128 { 1 } else { 0 }, 1)
  Test.assert_eq(if i16_wrapped == 0 - 32768 { 1 } else { 0 }, 1)
  Test.assert_eq(if i32_wrapped == 0 - 2147483648 { 1 } else { 0 }, 1)
  Test.assert_eq(if i8_wrapped < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if i8_min() < i8_id(1) { 1 } else { 0 }, 1)
}

test "integer_family_unsigned_widths_wrap_and_compare_unsigned" {
  let u8_hi: u8 = 255
  let u16_hi: u16 = 65535
  let u32_hi: u32 = 4294967295
  let u64_zero: u64 = 0
  let u8_wrapped = u8_hi + 1
  let u16_wrapped = u16_hi + 1
  let u32_wrapped = u32_hi + 1
  let u64_max = u64_zero - 1
  Test.assert_eq(if u8_wrapped == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_wrapped == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_wrapped == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_max > u64_zero { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_zero < u64_max { 1 } else { 0 }, 1)
}

test "integer_family_full_width_unsigned_literals" {
  let zero: u64 = 0
  let sign_bit: u64 = 9223372036854775808
  let top: u64 = 18446744073709551615
  let usize_top: usize = 18446744073709551615
  Test.assert_eq(if top == zero - 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if top > sign_bit { 1 } else { 0 }, 1)
  Test.assert_eq(if sign_bit > zero { 1 } else { 0 }, 1)
  Test.assert_eq(if (top bshr 63) == 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_top > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_id(18446744073709551615) == top { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_max_literal() == top { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_max_literal() == usize_top { 1 } else { 0 }, 1)
}

test "integer_family_signed_min_literals_use_contextual_width" {
  let min8: i8 = 0 - 128
  let min32: i32 = 0 - 2147483648
  let min64: i64 = 0 - 9223372036854775808
  let min_isize: isize = 0 - 9223372036854775808
  Test.assert_eq(if min8 < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if min32 < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if min64 < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if min_isize < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if i64_min_literal() == min64 { 1 } else { 0 }, 1)
}

test "integer_family_full_width_unsigned_literal_patterns" {
  let top: u64 = 18446744073709551615
  let got = match top {
    18446744073709551615 -> 1
    _ -> 0
  }
  Test.assert_eq(got, 1)
}

test "integer_family_unsigned_division_modulo_and_logical_shift" {
  let x: u8 = 250
  let q = x / 10
  let r = x % 10
  let zero: u64 = 0
  let max = zero - 1
  let half = max / 2
  let top = max bshr 63
  Test.assert_eq(if q == 25 { 1 } else { 0 }, 1)
  Test.assert_eq(if r == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if half == 9223372036854775807 { 1 } else { 0 }, 1)
  Test.assert_eq(if top == 1 { 1 } else { 0 }, 1)
}

test "integer_family_bitwise_matrix_and_signed_shift" {
  let bits: u16 = 240
  let low: u16 = 15
  let neg: i8 = 0 - 8
  let both = bits band low
  let either = bits bor low
  let flipped = either bxor low
  let left = low bshl 2
  let right = neg bshr 1
  Test.assert_eq(if both == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if either == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if flipped == 240 { 1 } else { 0 }, 1)
  Test.assert_eq(if left == 60 { 1 } else { 0 }, 1)
  Test.assert_eq(if right == 0 - 4 { 1 } else { 0 }, 1)
}

test "integer_family_assignment_loop_and_pattern_e2e" {
  let mut i: usize = 0
  let mut total: usize = 0
  while i < 5 {
    total = total + i
    i = i + 1
  }
  let tag: u8 = 2
  let matched = match tag {
    1 -> 10
    2 -> 20
    _ -> 30
  }
  Test.assert_eq(if total == 10 { 1 } else { 0 }, 1)
  Test.assert_eq(if i == 5 { 1 } else { 0 }, 1)
  Test.assert_eq(matched, 20)
  Test.assert_eq(if u8_max() > u8_id(0) { 1 } else { 0 }, 1)
}
