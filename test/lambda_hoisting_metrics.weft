-- test/lambda_hoisting_metrics.weft -- lambda body hoisting (lambda hoisting)
--
-- Lambda bodies used to be lowered AND emitted at emission time: no
-- optimiser, no mem2reg, no register residency, every value through a
-- spill slot. Hoisting lowers the body into a standalone ordinary
-- IrFunction (env as param 0 — the closure ABI is exactly a direct call
-- with the env pointer first), so it flows through the whole pipeline
-- like any named function. These tests assert on the emitted-module
-- counters and on observable semantics: captures (scalar and managed),
-- nesting, escaping, arity, generics, lowering-time handler evidence,
-- and pre-optimisation lowering from handler/deferred bodies.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/types.{*}

fn lh_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn lh_hoisted(src: str) -> i64 {
  pipeline_native_hoisted_closure_emit_count(lh_native(src))
}

fn lh_legacy(src: str) -> i64 {
  pipeline_native_typed_lambda_emit_count(lh_native(src))
}

fn lh_at_least(count: i64, expected: i64) -> i64 {
  if count >= expected { 1 } else { 0 }
}

-- Count IrClosureI64 insts in the optimised module: the hoisted shape.
fn lh_closure_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrClosureI64(dst, f, captures, eff) -> 1
        IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> lh_handler_clause_closures(clauses)
        IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> lh_deferred_body_closures(body) + lh_handler_clause_closures(clauses)
        _ -> 0
      }
      one + lh_closure_insts(rest)
    }
  }
}

fn lh_lambda_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      -- Tag 17 belonged to the deleted AST-bearing IrLambdaI64 variant.
      let one = match inst {
        IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> lh_handler_clause_lambdas(clauses)
        IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> lh_deferred_body_lambdas(body) + lh_handler_clause_lambdas(clauses)
        _ -> if ir_inst_tag(inst) == 17 { 1 } else { 0 }
      }
      one + lh_lambda_insts(rest)
    }
  }
}

fn lh_bound_evidence_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrClosureI64(dst, f, captures, evidence) -> {
          match ir_lambda_semantic_facts_evidence(evidence) {
            IrLambdaEvidenceNone -> 0
            IrLambdaEvidenceBound(eff_hash, op_hashes, value, frame_value) -> 1
          }
        }
        IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> lh_handler_clause_bound_evidence(clauses)
        IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> lh_deferred_body_bound_evidence(body) + lh_handler_clause_bound_evidence(clauses)
        _ -> 0
      }
      one + lh_bound_evidence_insts(rest)
    }
  }
}

fn lh_closure_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> lh_closure_insts(insts)
      }
      one + lh_closure_blocks(rest)
    }
  }
}

fn lh_lambda_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> lh_lambda_insts(insts)
      }
      one + lh_lambda_blocks(rest)
    }
  }
}

fn lh_bound_evidence_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> lh_bound_evidence_insts(insts)
      }
      one + lh_bound_evidence_blocks(rest)
    }
  }
}

fn lh_handler_clause_closures(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let one = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> lh_closure_blocks(blocks)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      one + lh_handler_clause_closures(rest)
    }
  }
}

fn lh_handler_clause_lambdas(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let one = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> lh_lambda_blocks(blocks)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      one + lh_handler_clause_lambdas(rest)
    }
  }
}

fn lh_handler_clause_bound_evidence(clauses: IrHandlerClauseBodyList) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> {
      let one = match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> lh_bound_evidence_blocks(blocks)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      one + lh_handler_clause_bound_evidence(rest)
    }
  }
}

fn lh_deferred_body_closures(body: IrDeferredHandlerBody) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> lh_closure_blocks(blocks)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn lh_deferred_body_lambdas(body: IrDeferredHandlerBody) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> lh_lambda_blocks(blocks)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn lh_deferred_body_bound_evidence(body: IrDeferredHandlerBody) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> lh_bound_evidence_blocks(blocks)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn lh_module_closures(fns_list: IrFunctionList) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> lh_closure_blocks(blocks)
      }
      one + lh_module_closures(rest)
    }
  }
}

fn lh_module_lambdas(fns_list: IrFunctionList) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> lh_lambda_blocks(blocks)
      }
      one + lh_module_lambdas(rest)
    }
  }
}

fn lh_module_bound_evidence(fns_list: IrFunctionList) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> lh_bound_evidence_blocks(blocks)
      }
      one + lh_module_bound_evidence(rest)
    }
  }
}

fn lh_registered_evidence_count(src: str) -> i64 {
  let fm = fmap_new()
  pipeline_ir_lambda_evidence_register_functions(pipeline_ir_functions(lh_optimised(src)), fm)
  let facts = fmap_lambda_evidence_facts(fm)
  if facts == 0 { 0 } else { nlist_len(facts) }
}

fn lh_optimised(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn lh_fn_count(fns_list: IrFunctionList) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> 1 + lh_fn_count(rest)
  }
}

test "lambda_capture_alias_rewrite_is_immutable" {
  let captures = nlist_new_capacity(1)
  nlist_add(captures, pipeline_lambda_capture_entry(0, 1, 7, ty_i64()))
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 9)
  let f = IrFunction(123, 1, ir_block_list_empty(), 0)
  let facts = ir_lambda_semantic_facts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())
  let rewritten = pipeline_ir_rewrite_inst_uses(ir_inst_closure_i64(10, f, captures, facts), aliases)
  let result = match rewritten {
    IrClosureI64(dst, body_fn, next_captures, lambda_facts) -> node_f3(nlist_get(next_captures, 0))
    _ -> 0
  }
  Test.assert_eq(result, 9)
  Test.assert_eq(node_f3(nlist_get(captures, 0)), 7)
}

test "lambda_optimizer_preserves_rewritten_capture_payload" {
  let src = "fn tmp_id(x: i64) -> i64 { x } fn main() -> i64 { let value = tmp_id(41) let f = () => value f() }"
  let functions = pipeline_ir_functions(lh_optimised(src))
  Test.assert_eq(lh_module_closures(functions), 1)
  Test.assert_eq(lh_at_least(lh_fn_count(functions), 3), 1)
}

-- ---------------------------------------------------------------------
-- Hoisting happens, and the body becomes a real module function
-- ---------------------------------------------------------------------

test "lambda_hoist_plain_lambda_becomes_module_function" {
  let src = "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn main() -> i64 { apply((x: i64) => x + 1, 41) }"
  let functions = pipeline_ir_functions(lh_optimised(src))
  -- the lambda site is a closure construction, not a carried body
  Test.assert_eq(lh_module_closures(functions), 1)
  Test.assert_eq(lh_module_lambdas(functions), 0)
  Test.assert_eq(lh_at_least(lh_hoisted(src), 1), 1)
  Test.assert_eq(lh_legacy(src), 0)
}

test "lambda_hoist_body_flows_through_the_optimiser" {
  -- The hoisted body is an ordinary function, so the module function
  -- count includes it: two source fns plus main plus the lambda body.
  let src = "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn main() -> i64 { apply((x: i64) => x + 1, 41) }"
  let base = "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn helper(x: i64) -> i64 { x + 1 } fn main() -> i64 { apply(helper, 41) }"
  let with_lambda = lh_fn_count(pipeline_ir_functions(lh_optimised(src)))
  let with_named = lh_fn_count(pipeline_ir_functions(lh_optimised(base)))
  -- a lambda contributes exactly what a named helper contributes
  Test.assert_eq(with_lambda, with_named)
}

test "lambda_hoist_multiple_sites_each_get_a_function" {
  let src = "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn main() -> i64 { apply((x: i64) => x + 1, 1) + apply((x: i64) => x * 2, 2) + apply((x: i64) => x - 3, 3) }"
  let functions = pipeline_ir_functions(lh_optimised(src))
  Test.assert_eq(lh_module_closures(functions), 3)
  Test.assert_eq(lh_module_lambdas(functions), 0)
  Test.assert_eq(lh_at_least(lh_hoisted(src), 3), 1)
}

test "lambda_hoist_identical_bodies_at_distinct_sites_remain_distinct" {
  -- Distinct sites never collide, even when their bodies are identical;
  -- the collector dedups only identical specialisations of one site.
  let src = "fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) } fn main() -> i64 { apply((x: i64) => x + 1, 1) + apply((x: i64) => x + 1, 2) }"
  let functions = pipeline_ir_functions(lh_optimised(src))
  Test.assert_eq(lh_module_closures(functions), 2)
  Test.assert_eq(lh_at_least(lh_fn_count(functions), 4), 1)
}

-- ---------------------------------------------------------------------
-- Evidence and handler/deferred lowering contexts use ordinary functions
-- ---------------------------------------------------------------------

test "lambda_hoist_handler_clause_body_is_visible_before_emission" {
  -- The clause CFG and its closure site are present in typed IR before
  -- native emission; the collector promotes the carried function normally.
  let src = "effect LhClause { fn get() -> i64 } fn main() -> i64 { handle LhClause.get() { LhClause.get() -> { let base = 40; let f = (x: i64) => x + base; f(2) } } }"
  Test.assert_eq(lh_module_closures(pipeline_ir_functions(lh_optimised(src))), 1)
  Test.assert_eq(lh_legacy(src), 0)
  Test.assert_eq(lh_at_least(lh_hoisted(src), 1), 1)
}

test "lambda_hoist_perform_body_carries_lowering_evidence" {
  let src = "effect LhPerf { fn get() -> i64 } fn lh_apply(f: (i64) -[LhPerf]> i64) -[LhPerf]> i64 { f(1) } fn main() -> i64 { handle lh_apply((x: i64) => x + LhPerf.get()) { LhPerf.get() -> resume(41) } }"
  let functions = pipeline_ir_functions(lh_optimised(src))
  Test.assert_eq(lh_at_least(lh_module_bound_evidence(functions), 1), 1)
  Test.assert_eq(lh_legacy(src), 0)
  Test.assert_eq(lh_at_least(lh_hoisted(src), 1), 1)
}

test "lambda_hoist_perform_free_body_under_a_handler_still_hoists" {
  -- A perform-free closure needs no evidence even when created under a
  -- handler, but it still follows the same ordinary-function path.
  let src = "effect LhAmb { fn get() -> i64 } fn lh_apply2(f: (i64) -> i64) -> i64 { f(1) } fn main() -> i64 { handle LhAmb.get() { LhAmb.get() -> resume(41) } + lh_apply2((x: i64) => x + 1) }"
  Test.assert_eq(lh_at_least(lh_hoisted(src), 1), 1)
  Test.assert_eq(lh_legacy(src), 0)
}

test "lambda_hoist_deferred_body_is_visible_before_emission" {
  let src = "effect LhDeferred { @deferred fn get() -> i64 } fn main() -> i64 { handle { let f = (x: i64) => x + 1 f(40) + LhDeferred.get() } { LhDeferred.get() with k -> k(1) } }"
  Test.assert_eq(lh_module_closures(pipeline_ir_functions(lh_optimised(src))), 1)
  Test.assert_eq(lh_legacy(src), 0)
  Test.assert_eq(lh_at_least(lh_hoisted(src), 1), 1)
}

test "lambda_evidence_preregistration_descends_handler_clause_cfgs" {
  let src = "effect LhOuter { fn run() -> i64 } effect LhInner { fn get() -> i64 } fn lh_apply_inner(f: (i64) -[LhInner]> i64) -[LhInner]> i64 { f(1) } fn main() -> i64 { handle LhOuter.run() { LhOuter.run() -> handle lh_apply_inner((x: i64) => x + LhInner.get()) { LhInner.get() -> resume(40) } } }"
  Test.assert_eq(lh_at_least(lh_registered_evidence_count(src), 1), 1)
}

test "lambda_evidence_preregistration_descends_deferred_body_cfgs" {
  let src = "effect LhFiber { @deferred fn get() -> i64 } effect LhFiberInner { fn get() -> i64 } fn lh_apply_fiber_inner(f: (i64) -[LhFiberInner]> i64) -[LhFiberInner]> i64 { f(1) } fn main() -> i64 { handle { let value = handle lh_apply_fiber_inner((x: i64) => x + LhFiberInner.get()) { LhFiberInner.get() -> resume(40) } value + LhFiber.get() } { LhFiber.get() with k -> k(1) } }"
  Test.assert_eq(lh_at_least(lh_registered_evidence_count(src), 1), 1)
}

