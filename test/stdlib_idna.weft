use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment}
use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/display.{Display}
use stdlib/eq.{Eq}
use stdlib/idna.{DomainName, IdnaBidi, IdnaDisallowed, IdnaEmptyLabel, IdnaError, IdnaHyphen, IdnaInvalidPunycode, IdnaInvalidUtf8, IdnaJoinerContext, IdnaLabelTooLong, IdnaLeadingCombiningMark, IdnaNameTooLong, domain_name_parse}
use stdlib/result.{Err, Ok, Result}
use stdlib/test.{*}
use test/unicode_idna_conformance_data.{*}

fn idna_test_ascii(value: Result<DomainName, IdnaError>) -> str {
  match value {
    Ok(name) -> name.ascii()
    Err(_) -> "<error>"
  }
}

fn idna_test_display(value: Result<DomainName, IdnaError>) -> str {
  match value {
    Ok(name) -> name.display()
    Err(_) -> "<error>"
  }
}

fn idna_test_error(value: Result<DomainName, IdnaError>, kind: i64, offset: i64, label: i64) -> bool {
  match value {
    Err(IdnaEmptyLabel(actual_offset, actual_label)) -> kind == 1 and actual_offset == offset and actual_label == label
    Err(IdnaInvalidUtf8(actual_offset, actual_label)) -> kind == 2 and actual_offset == offset and actual_label == label
    Err(IdnaDisallowed(actual_offset, actual_label)) -> kind == 3 and actual_offset == offset and actual_label == label
    Err(IdnaHyphen(actual_offset, actual_label)) -> kind == 4 and actual_offset == offset and actual_label == label
    Err(IdnaInvalidPunycode(actual_offset, actual_label)) -> kind == 5 and actual_offset == offset and actual_label == label
    Err(IdnaLeadingCombiningMark(actual_offset, actual_label)) -> kind == 6 and actual_offset == offset and actual_label == label
    Err(IdnaJoinerContext(actual_offset, actual_label)) -> kind == 7 and actual_offset == offset and actual_label == label
    Err(IdnaBidi(actual_offset, actual_label)) -> kind == 8 and actual_offset == offset and actual_label == label
    Err(IdnaLabelTooLong(actual_offset, actual_label)) -> kind == 9 and actual_offset == offset and actual_label == label
    Err(IdnaNameTooLong(actual_offset, actual_label)) -> kind == 10 and actual_offset == offset and actual_label == label
    _ -> false
  }
}

test "IDNA maps Unicode 17 text to canonical nontransitional A-labels" {
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("fass.de")), "fass.de")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("Faß.de")), "xn--fa-hia.de")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("BÜCHER.example")), "xn--bcher-kva.example")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("例え.テスト")), "xn--r8jz45g.xn--zckzah")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("café.example")), "xn--caf-dma.example")
}

test "IDNA accepts canonical A-label input and rejects invalid or noncanonical Punycode" {
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("xn--fa-hia.de")), "xn--fa-hia.de")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("XN--BCHER-KVA.EXAMPLE")), "xn--bcher-kva.example")
  Test.assert_true(idna_test_error(domain_name_parse("xn--"), 5, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("xn--abc-"), 5, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("xn--a.pt"), 3, 0, 0))
}

test "IDNA maps dot equivalents and retains explicit absolute-root state" {
  match domain_name_parse("A．B。C｡") {
    Ok(name) -> {
      Test.assert_str_eq(name.ascii(), "a.b.c")
      Test.assert_true(name.is_absolute())
      Test.assert_str_eq(name.display(), "a.b.c.")
    }
    Err(_) -> Test.assert_eq(0, 1)
  }
  match domain_name_parse("a.b.c") {
    Ok(name) -> Test.assert_false(name.is_absolute())
    Err(_) -> Test.assert_eq(0, 1)
  }
}

test "domain identity includes canonical labels and absolute-root state" {
  match domain_name_parse("BÜCHER.example") {
    Ok(left) -> match domain_name_parse("xn--bcher-kva.example") {
      Ok(right) -> Test.assert_true(left.eq(right))
      Err(_) -> Test.assert_eq(0, 1)
    }
    Err(_) -> Test.assert_eq(0, 1)
  }
  match domain_name_parse("example") {
    Ok(relative) -> match domain_name_parse("example.") {
      Ok(absolute) -> Test.assert_false(relative.eq(absolute))
      Err(_) -> Test.assert_eq(0, 1)
    }
    Err(_) -> Test.assert_eq(0, 1)
  }
}

test "IDNA rejects empty leading repeated and root-only labels with source positions" {
  Test.assert_true(idna_test_error(domain_name_parse(""), 1, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("."), 1, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse(".example"), 1, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("a..b"), 1, 2, 1))
  Test.assert_true(idna_test_error(domain_name_parse("a。。b"), 1, 4, 1))
}

test "IDNA strict STD3 and hyphen rules reject residual ASCII punctuation" {
  Test.assert_true(idna_test_error(domain_name_parse("$"), 3, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("under_score"), 3, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("-example"), 4, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("example-"), 4, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("ab--cd"), 4, 0, 0))
}

test "IDNA accepts valid symbols and reports leading-combining labels" {
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("a😀b")), "xn--ab-no82a")
  Test.assert_true(idna_test_error(domain_name_parse("̈example"), 6, 0, 0))
}

test "IDNA enforces ContextJ while accepting virama and joining contexts" {
  Test.assert_true(idna_test_error(domain_name_parse("a‌b"), 7, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("a‍b"), 7, 0, 0))
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("क्‍ष.example")), "xn--11b2ezcw70k.example")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("نامه‌ای.example")), "xn--mgba3gch31f060k.example")
}

test "IDNA applies Bidi rules domain-wide" {
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("مثال.إختبار")), "xn--mgbh0fb.xn--kgbechtv")
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("שלום.example")), "xn--9dbne9b.example")
  Test.assert_true(idna_test_error(domain_name_parse("0à.א"), 8, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("א0٠"), 8, 0, 0))
}

test "IDNA enforces label and full-name DNS wire limits" {
  Test.assert_str_eq(idna_test_ascii(domain_name_parse("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk")), "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk")
  Test.assert_true(idna_test_error(domain_name_parse("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl"), 9, 0, 0))
  Test.assert_true(idna_test_error(domain_name_parse("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), 10, 255, 3))
}

test "IDNA rejects forged malformed UTF-8 at the exact label position" {
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_true(idna_test_error(domain_name_parse(text), 2, 0, 0))

  let later = runtime_str_alloc_uninit(4)
  let later_data = runtime_str_ptr(later)
  mem_store8_at(later_data, 0, 97)
  mem_store8_at(later_data, 1, 46)
  mem_store8_at(later_data, 2, 195)
  mem_store8_at(later_data, 3, 40)
  Test.assert_true(idna_test_error(domain_name_parse(later), 2, 2, 1))
}

test "Unicode 17 UTS 46 ToASCII passes every well-formed upstream case" {
  let mut failures = 0
  let mut first_failure = 0
  let mut case_index = 0
  while case_index < unicode_idna_test_case_count() {
    let mark = alloc_bump_mark()
    let value = unicode_idna_test_case(case_index)
    let source = unicode_idna_test_case_source(value)
    let result = domain_name_parse(source)
    if unicode_idna_test_case_success(value) == 1 {
      match result {
        Ok(name) -> {
          if name.ascii() != unicode_idna_test_case_expected(value) or
            (if name.is_absolute() { 1 } else { 0 }) != unicode_idna_test_case_absolute(value) {
            failures = failures + 1
            if first_failure == 0 { first_failure = case_index + 1 } else { 0 }
          } else { 0 }
        }
        Err(_) -> {
          failures = failures + 1
          if first_failure == 0 { first_failure = case_index + 1 } else { 0 }
        }
      }
    } else {
      match result {
        Ok(_) -> {
          failures = failures + 1
          if first_failure == 0 { first_failure = case_index + 1 } else { 0 }
        }
        Err(_) -> 0
      }
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(unicode_idna_ill_formed_test_count(), 2)
  Test.assert_eq(failures, 0)
  Test.assert_eq(first_failure, 0)
}
