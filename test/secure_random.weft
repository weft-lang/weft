-- test/secure_random.weft — public SecureRandom semantics and test handler

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/result.{Err, Ok}
use stdlib/secure_random as secure_random
use stdlib/secure_random.{SecureRandom, SecureRandomError, SecureRandomExhausted, SecureRandomLimitExceeded, SecureRandomPlatform}
use stdlib/secure_random/deterministic as deterministic_random

effect RandomResidual {
  fn tick() -> i64
}

fn secure_random_text_is(values: Bytes, expected: str) -> i64 {
  match values.to_utf8() {
    Ok(text) -> if text == expected { 1 } else { 0 }
    Err(error) -> 0
  }
}

fn secure_random_deterministic_probe() -[SecureRandom]> i64 {
  let mut score = 0
  match secure_random.bytes(__i64_to_usize(0)) {
    Ok(values) -> {
      if values.len() == 0 { score = score + 1 }
      else { score = score + 0 }
    }
    Err(error) -> { score = score + 0 }
  }
  match secure_random.bytes(__i64_to_usize(2)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "ab") }
    Err(error) -> { score = score + 0 }
  }
  match secure_random.bytes(__i64_to_usize(3)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "cde") }
    Err(error) -> { score = score + 0 }
  }
  -- A failed request consumes no bytes.
  match secure_random.bytes(__i64_to_usize(2)) {
    Ok(values) -> { score = score + 0 }
    Err(error) -> {
      match error {
        SecureRandomExhausted(requested, remaining) -> {
          if __u64_to_i64(__usize_to_u64(requested)) == 2 and
            __u64_to_i64(__usize_to_u64(remaining)) == 1 {
            score = score + 1
          } else { score = score + 0 }
        }
        _ -> { score = score + 0 }
      }
    }
  }
  match secure_random.bytes(__i64_to_usize(1)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "f") }
    Err(error) -> { score = score + 0 }
  }
  score
}

test "deterministic SecureRandom is exact sequential and non-wrapping" {
  Test.assert_eq(
    with deterministic_random(deterministic_random.stream(bytes.from_str("abcdef"))) {
      secure_random_deterministic_probe()
    },
    5
  )
}

fn secure_random_residual_probe() -[SecureRandom, RandomResidual]> i64 {
  let random_score = match secure_random.bytes(__i64_to_usize(2)) {
    Ok(values) -> secure_random_text_is(values, "xy")
    Err(error) -> 0
  }
  random_score + RandomResidual.tick()
}

test "deterministic SecureRandom preserves an unrelated residual effect" {
  let got = handle with deterministic_random(
    deterministic_random.stream(bytes.from_str("xy"))
  ) {
    secure_random_residual_probe()
  } {
    RandomResidual.tick() -> resume(41)
  }
  Test.assert_eq(got, 42)
}

fn secure_random_limit_probe() -[SecureRandom]> i64 {
  match secure_random.bytes(__i64_to_usize(0 - 1)) {
    Ok(values) -> 0
    Err(SecureRandomLimitExceeded(requested)) -> 1
    Err(error) -> 0
  }
}

test "deterministic SecureRandom rejects target-unrepresentable counts" {
  Test.assert_eq(
    with deterministic_random(deterministic_random.stream(bytes.from_str("seed"))) {
      secure_random_limit_probe()
    },
    1
  )
}

fn secure_random_text_result() -[SecureRandom]> str {
  match secure_random.bytes(__i64_to_usize(2)) {
    Ok(values) -> match values.to_utf8() {
      Ok(text) -> text
      Err(error) -> "invalid"
    }
    Err(error) -> "missing"
  }
}

test "deterministic SecureRandom preserves an arbitrary managed result" {
  Test.assert_str_eq(
    with deterministic_random(deterministic_random.stream(bytes.from_str("weft"))) {
      secure_random_text_result()
    },
    "we"
  )
}

test "SecureRandom effect can be replaced by an exact application handler" {
  let got = handle secure_random.bytes(__i64_to_usize(3)) {
    SecureRandom.bytes(count) -> resume(Ok<Bytes, SecureRandomError>(bytes.from_str("mock")))
  }
  match got {
    Ok(values) -> Test.assert_eq(secure_random_text_is(values, "mock"), 1)
    Err(error) -> Test.assert_eq(0, 1)
  }
}

test "secure random errors retain typed payloads" {
  let error = SecureRandomPlatform(77)
  match error {
    SecureRandomPlatform(code) -> Test.assert_eq(code, 77)
    _ -> Test.assert_eq(0, 1)
  }
}
