-- test/secure_random.weft — public SecureRandom semantics and test handler

use stdlib/bytes.{Bytes, bytes_from_str, bytes_len, bytes_to_utf8}
use stdlib/result.{Err, Ok}
use stdlib/secure_random.{*}

effect RandomResidual {
  fn tick() -> i64
}

fn secure_random_text_is(values: Bytes, expected: str) -> i64 {
  match bytes_to_utf8(values) {
    Ok(text) -> if text == expected { 1 } else { 0 }
    Err(error) -> 0
  }
}

fn secure_random_deterministic_probe() -[SecureRandom]> i64 {
  let mut score = 0
  match secure_random_bytes(__i64_to_usize(0)) {
    Ok(values) -> {
      if bytes_len(values) == 0 { score = score + 1 }
      else { score = score + 0 }
    }
    Err(error) -> { score = score + 0 }
  }
  match secure_random_bytes(__i64_to_usize(2)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "ab") }
    Err(error) -> { score = score + 0 }
  }
  match secure_random_bytes(__i64_to_usize(3)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "cde") }
    Err(error) -> { score = score + 0 }
  }
  -- A failed request consumes no bytes.
  match secure_random_bytes(__i64_to_usize(2)) {
    Ok(values) -> { score = score + 0 }
    Err(error) -> {
      if secure_random_error_kind(error) == 1 and
        __u64_to_i64(__usize_to_u64(secure_random_error_requested_or(error, __i64_to_usize(0)))) == 2 and
        __u64_to_i64(__usize_to_u64(secure_random_error_remaining_or(error, __i64_to_usize(0)))) == 1 {
        score = score + 1
      } else { score = score + 0 }
    }
  }
  match secure_random_bytes(__i64_to_usize(1)) {
    Ok(values) -> { score = score + secure_random_text_is(values, "f") }
    Err(error) -> { score = score + 0 }
  }
  score
}

test "deterministic SecureRandom is exact sequential and non-wrapping" {
  Test.assert_eq(
    secure_random_with_deterministic_i64(bytes_from_str("abcdef"), secure_random_deterministic_probe),
    5
  )
}

fn secure_random_residual_probe() -[SecureRandom, RandomResidual]> i64 {
  let random_score = match secure_random_bytes(__i64_to_usize(2)) {
    Ok(values) -> secure_random_text_is(values, "xy")
    Err(error) -> 0
  }
  random_score + RandomResidual.tick()
}

test "deterministic SecureRandom preserves an unrelated residual effect" {
  let got = handle secure_random_with_deterministic_i64(
    bytes_from_str("xy"),
    secure_random_residual_probe
  ) {
    RandomResidual.tick() -> resume(41)
  }
  Test.assert_eq(got, 42)
}

fn secure_random_limit_probe() -[SecureRandom]> i64 {
  match secure_random_bytes(__i64_to_usize(0 - 1)) {
    Ok(values) -> 0
    Err(error) -> if secure_random_error_kind(error) == 2 { 1 } else { 0 }
  }
}

test "deterministic SecureRandom rejects target-unrepresentable counts" {
  Test.assert_eq(
    secure_random_with_deterministic_i64(bytes_from_str("seed"), secure_random_limit_probe),
    1
  )
}

test "SecureRandom effect can be replaced by an exact application handler" {
  let got = handle secure_random_bytes(__i64_to_usize(3)) {
    SecureRandom.bytes(count) -> resume(Ok<Bytes, SecureRandomError>(bytes_from_str("mock")))
  }
  match got {
    Ok(values) -> Test.assert_eq(secure_random_text_is(values, "mock"), 1)
    Err(error) -> Test.assert_eq(0, 1)
  }
}

test "secure random errors retain stable kinds and platform detail" {
  let platform = SecureRandomPlatform(77)
  Test.assert_eq(secure_random_error_kind(platform), 3)
  Test.assert_eq(secure_random_error_platform_or(platform, 0), 77)
  Test.assert_eq(secure_random_error_platform_or(SecureRandomExhausted(__i64_to_usize(1), __i64_to_usize(0)), 9), 9)
}
