use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count, runtime_rc_probe_weak_count}

effect Stop { fn stop() -> never }

test "aborting before array replacement preserves the outer owner" {
  let mut values = [1, 2]
  let result = handle {
    values[0] = { Stop.stop() 9 }
    0
  } { Stop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(values[0], 1)
  Test.assert_eq(values[1], 2)
}

test "aborting after array replacement preserves the committed outer owner" {
  let mut values = [1, 2]
  let result = handle {
    values[0] = 9
    Stop.stop()
    0
  } { Stop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(values[0], 9)
  Test.assert_eq(values[1], 2)
}

test "array replacement inside a nested handler preserves the enclosing owner" {
  let result = handle {
    let mut values = [1, 2]
    let stopped = handle {
      values[0] = 9
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(stopped, 42)
    Test.assert_eq(values[0], 9)
    Test.assert_eq(values[1], 2)
    17
  } { Stop.stop() -> 23 }
  Test.assert_eq(result, 17)
}

test "repeated array replacement commits survive a later abort" {
  let mut values = [1, 2]
  let result = handle {
    values[0] = 9
    values[0] = 17
    Stop.stop()
    0
  } { Stop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(values[0], 17)
  Test.assert_eq(values[1], 2)
}

test "self assignment preserves distinct stakes with equal pointer values" {
  let input = runtime_rc_probe_new(7)
  let scoped = {
    let mut current = input
    let result = handle {
      current = current
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    Test.assert_eq(runtime_rc_probe_load(current), 7)
    Test.assert_eq(runtime_rc_probe_count(input), 2)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_count(input), 1)
}

test "replacement transfers one borrowed stake into the enclosing binding" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  let scoped = {
    let mut current = first
    let result = handle {
      current = second
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    Test.assert_eq(runtime_rc_probe_load(current), 9)
    Test.assert_eq(runtime_rc_probe_count(first), 1)
    Test.assert_eq(runtime_rc_probe_count(second), 2)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(second), 1)
}

test "aborting a binding scope releases its current value exactly once" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  let result = handle {
    let mut current = first
    current = second
    Test.assert_eq(runtime_rc_probe_load(current), 9)
    Stop.stop()
    0
  } { Stop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(second), 1)
}

test "failed right hand side evaluation leaves the binding stake intact" {
  let input = runtime_rc_probe_new(7)
  let scoped = {
    let mut current = input
    let result = handle {
      current = { Stop.stop() runtime_rc_probe_new(9) }
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    Test.assert_eq(runtime_rc_probe_load(current), 7)
    Test.assert_eq(runtime_rc_probe_count(input), 2)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_count(input), 1)
}

test "managed closure replacement preserves captures through abort and scope exit" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  let scoped = {
    let mut read = () => runtime_rc_probe_load(first)
    let result = handle {
      read = () => runtime_rc_probe_load(second)
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    Test.assert_eq(read(), 9)
    Test.assert_eq(runtime_rc_probe_count(first), 1)
    Test.assert_eq(runtime_rc_probe_count(second), 2)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(second), 1)
}

fn return_mutable_probe(input: RuntimeRcProbe, replace: bool) -> RuntimeRcProbe {
  let mut current = input
  if replace { current = runtime_rc_probe_new(42) } else { nil }
  current
}

test "returning a mutable binding transfers its current value" {
  let input = runtime_rc_probe_new(7)
  let original = return_mutable_probe(input, false)
  let changed = return_mutable_probe(input, true)
  Test.assert_eq(runtime_rc_probe_load(original), 7)
  Test.assert_eq(runtime_rc_probe_load(changed), 42)
  Test.assert_eq(runtime_rc_probe_count(changed), 1)
  Test.assert_eq(runtime_rc_probe_count(input), 2)
}

test "weak binding replacement releases each weak stake at its own boundary" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  let first_weak = runtime_rc_probe_weak_count(first)
  let second_weak = runtime_rc_probe_weak_count(second)
  let scoped = {
    let mut reference = weak_ref(first)
    let result = handle {
      reference = weak_ref(second)
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    match weak_load(reference) {
      nil -> Test.assert_true(false)
      live: RuntimeRcProbe -> Test.assert_eq(runtime_rc_probe_load(live), 9)
    }
    Test.assert_eq(runtime_rc_probe_weak_count(first), first_weak)
    Test.assert_eq(runtime_rc_probe_weak_count(second), second_weak + 1)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_weak_count(first), first_weak)
  Test.assert_eq(runtime_rc_probe_weak_count(second), second_weak)
}

test "multiword replacement preserves both stakes through swapped aliases" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  let scoped = {
    let mut current = (first, second)
    let result = handle {
      current = (second, first)
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    Test.assert_eq(result, 42)
    Test.assert_eq(runtime_rc_probe_load(current.0), 9)
    Test.assert_eq(runtime_rc_probe_load(current.1), 7)
    Test.assert_eq(runtime_rc_probe_count(first), 2)
    Test.assert_eq(runtime_rc_probe_count(second), 2)
    0
  }
  Test.assert_eq(scoped, 0)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(second), 1)
}

test "each loop iteration closes its own binding after a handled abort" {
  let input = runtime_rc_probe_new(7)
  let mut total = 0
  for i in 0..8 {
    let mut current = input
    let result = handle {
      current = runtime_rc_probe_new(i)
      Stop.stop()
      0
    } { Stop.stop() -> 42 }
    total = total + runtime_rc_probe_load(current)
    Test.assert_eq(result, 42)
    if i < 4 { continue } else { nil }
  }
  Test.assert_eq(total, 28)
  Test.assert_eq(runtime_rc_probe_count(input), 1)
}

type FloatingPair { x: f64, y: f64 }

test "aborting a record field update leaves its array snapshot intact" {
  let mut points = [FloatingPair { x: 1.5, y: 2.5 }]
  let result = handle {
    let point = points[0]
    points[0] = point.{x: { Stop.stop() 3.5 }}
    0
  } { Stop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(points[0].x, 1.5)
  Test.assert_eq_f64(points[0].y, 2.5)
}

test "floating observations stay valid across managed replacement cleanup" {
  let source = FloatingPair { x: 1.5, y: 2.5 }
  let mut current = source
  let before = current.x + current.y
  current = FloatingPair { x: 3.5, y: 4.5 }
  Test.assert_eq_f64(before + current.x + current.y, 12.0)
}

effect Pause { @deferred fn pause() -> i64 }

fn suspended_binding(first: RuntimeRcProbe, second: RuntimeRcProbe, continue_body: bool) -> i64 {
  handle {
    let mut current = first
    current = second
    Pause.pause()
    runtime_rc_probe_load(current)
  } {
    Pause.pause() with k -> if continue_body { k(0) } else { 42 }
  }
}

test "resumption and continuation drop each clean the current mutable value" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  for continue_body in [false, true] {
    Test.assert_eq(suspended_binding(first, second, continue_body), if continue_body { 9 } else { 42 })
    Test.assert_eq(runtime_rc_probe_count(first), 1)
    Test.assert_eq(runtime_rc_probe_count(second), 1)
  }
}

test "a conditional right hand side commits only its selected managed value" {
  let first = runtime_rc_probe_new(7)
  let second = runtime_rc_probe_new(9)
  for choose_first in [false, true] {
    let scoped = {
      let mut current = runtime_rc_probe_new(42)
      let result = handle {
        current = if choose_first { first } else { second }
        Stop.stop()
        0
      } { Stop.stop() -> 42 }
      Test.assert_eq(result, 42)
      Test.assert_eq(runtime_rc_probe_load(current), if choose_first { 7 } else { 9 })
      0
    }
    Test.assert_eq(scoped, 0)
    Test.assert_eq(runtime_rc_probe_count(first), 1)
    Test.assert_eq(runtime_rc_probe_count(second), 1)
  }
}
