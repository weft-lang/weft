-- Expected exit code: 102
-- A stale release traps in every build. Built with `--rc-quarantine`, the
-- trap also names the release that freed the object and its calling chain.
-- Recursion keeps each role in its own frame, so the two traces differ.

use runtime/rc.{rc_default_alloc, rc_default_release}

fn free_after(block: i64, depth: i64) -> i64 {
  if depth == 0 { rc_default_release(block) } else { free_after(block, depth - 1) }
}

fn release_after(block: i64, depth: i64) -> i64 {
  if depth == 0 { rc_default_release(block) } else { release_after(block, depth - 1) }
}

fn main() -> i64 {
  let block: i64 = rc_default_alloc(8, 8)
  free_after(block, 1)
  release_after(block, 1)
  0
}
