-- Checked closures retain bindings and concurrency facts without raw nodes.

use compiler/project/identity.{ModuleFunctionIdentity, ModuleIdentity, named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI64,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_id_from_ordinal,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{SemanticTypeCatalog, semantic_type_catalog_single}
use compiler/weft/check/body/closure.{*}
use compiler/weft/check/body/graph.{*}
use stdlib/test.{Test}

fn types(module: ModuleIdentity) -> SemanticTypeCatalog {
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (builder, _) = builder.primitive(SemanticI64)
  semantic_type_catalog_single(builder.freeze())
}

fn integer_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 0)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

test "checked closures retain exact parameter capture and body bindings" {
  let module = named_module_identity("fixture/closures", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let integer = integer_type(module)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    types(module),
    4
  )
  let (expressions, parameter) = expressions.binding(
    function,
    integer,
    range(0, 1),
    CheckedImmutableBinding
  )
  let (expressions, capture) = expressions.binding(
    function,
    integer,
    range(1, 2),
    CheckedMutableBinding
  )
  let (expressions, body) = expressions.local_reference(
    capture,
    integer,
    range(2, 3)
  )
  let closures = checked_closure_builder(expressions, 1)
  let (closures, parameters) = closures.binding_list()
  let (closures, parameters) = closures.binding_list_push(
    expressions,
    parameters,
    parameter
  )
  let (closures, parameters) = closures.finish_binding_list(parameters)
  let (closures, captures) = closures.binding_list()
  let (closures, captures) = closures.binding_list_push(expressions, captures, capture)
  let (closures, captures) = closures.finish_binding_list(captures)
  let (closures, detail) = closures.lambda(
    expressions,
    parameters,
    captures,
    body,
    41,
    CheckedOrdinaryLambda,
    false
  )
  let (expressions, lambda) = expressions.lambda(detail, integer, range(0, 7))
  let closure_graph = closures.freeze()
  let expression_graph = expressions.freeze()
  let checked = closure_graph.inspect(detail)

  Test.assert_eq_usize(closure_graph.binding_list_len(checked.parameters), 1)
  Test.assert_eq_usize(closure_graph.binding_list_len(checked.captures), 1)
  Test.assert_true(
    checked_binding_id_eq(
      closure_graph.binding_list_at(checked.parameters, 0),
      parameter
    )
  )
  Test.assert_true(
    checked_binding_id_eq(closure_graph.binding_list_at(checked.captures, 0), capture)
  )
  Test.assert_true(checked_expr_id_eq(checked.body, body))
  Test.assert_eq_usize(checked.source_site, 41)
  Test.assert_true(not checked.generator_producer)
  Test.assert_true(match checked.role { CheckedOrdinaryLambda -> true, _ -> false })
  Test.assert_true(match expression_graph.kind(lambda) { CheckedLambdaKind -> true, _ -> false })
  Test.assert_eq_usize(
    checked_lambda_id_ordinal(expression_graph.lambda_detail(lambda)),
    checked_lambda_id_ordinal(detail)
  )
  Test.assert_true(
    match expression_graph.inspect(lambda).node {
      CheckedLambdaNode(found) -> checked_lambda_id_ordinal(found) ==
        checked_lambda_id_ordinal(detail)
      _ -> false
    }
  )
}

test "checked closures distinguish every structured concurrency role" {
  let module = named_module_identity("fixture/closure_roles", 71)
  let integer = integer_type(module)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    types(module),
    1
  )
  let (expressions, body) = expressions.integer(1, integer, range(0, 1))
  let closures = checked_closure_builder(expressions, 4)
  let (closures, empty) = closures.binding_list()
  let (closures, empty) = closures.finish_binding_list(empty)
  let (closures, ordinary) = closures.lambda(
    expressions,
    empty,
    empty,
    body,
    1,
    CheckedOrdinaryLambda,
    false
  )
  let (closures, scope) = closures.lambda(
    expressions,
    empty,
    empty,
    body,
    2,
    CheckedParallelScopeLambda,
    false
  )
  let (closures, parallel_worker) = closures.lambda(
    expressions,
    empty,
    empty,
    body,
    3,
    CheckedParallelWorkerLambda,
    true
  )
  let (closures, task_worker) = closures.lambda(
    expressions,
    empty,
    empty,
    body,
    4,
    CheckedTaskWorkerLambda,
    false
  )
  let graph = closures.freeze()

  Test.assert_true(
    match graph.inspect(ordinary).role { CheckedOrdinaryLambda -> true, _ -> false }
  )
  Test.assert_true(
    match graph.inspect(scope).role { CheckedParallelScopeLambda -> true, _ -> false }
  )
  Test.assert_true(
    match graph.inspect(parallel_worker).role { CheckedParallelWorkerLambda -> true, _ -> false }
  )
  Test.assert_true(graph.inspect(parallel_worker).generator_producer)
  Test.assert_true(
    match graph.inspect(task_worker).role { CheckedTaskWorkerLambda -> true, _ -> false }
  )
}
