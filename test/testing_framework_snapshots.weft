use compiler/pipeline.{*}
use compiler/lib.{*}
use compiler/ir.{*}
use module_fixtures/compiler_probe.{probe_check_source}
use stdlib/string.{*}

-- Snapshot tests over stable compiler-as-data surfaces.

fn snapshot_append_i64(base: str, label: str, value: i64) -> str {
  str_concat(str_concat(base, label), int_to_str(value))
}

fn snapshot_ast_surface(src: str) -> str {
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  let fns = pipeline_ast_fns(ast)
  let body = pipeline_ast_first_body_expr(ast)
  let s0 = snapshot_append_i64("ast:fns=", "", nlist_len(fns))
  snapshot_append_i64(s0, ";body=", expr_tag(body))
}

fn snapshot_ir_surface(src: str) -> str {
  let typed = probe_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  let s0 = snapshot_append_i64("ir:functions=", "", ir_function_list_len(functions))
  let s1 = snapshot_append_i64(s0, ";blocks=", ir_function_list_block_count(functions))
  snapshot_append_i64(s1, ";insts=", ir_function_list_inst_count(functions))
}

test "snapshot_ast_surface_summary" {
  Test.assert_snapshot(snapshot_ast_surface("fn main() -> i64 { 42 }"), "ast:fns=1;body=1")
}

test "snapshot_ast_surface_pointer_assignment" {
  Test.assert_snapshot(snapshot_ast_surface("fn main(p: *mut i64) -> i64 { p.* = 1 }"), "ast:fns=1;body=57")
}

test "snapshot_ir_surface_summary" {
  Test.assert_snapshot(snapshot_ir_surface("fn main() -> i64 { 42 }"), "ir:functions=1;blocks=1;insts=1")
}
