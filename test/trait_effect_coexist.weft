-- Effects and methods coexist: effect perform and method call in same program
-- Expected exit code: 42
effect Counter {
  fn inc() -> i64
}

impl i64 {
  fn plus_ten(self: i64) -> i64 {
    self + 10
  }
}

fn use_both() -> i64 {
  let base = Counter.inc()
  base.plus_ten()
}

fn main() -> i64 {
  handle use_both() {
    Counter.inc() -> resume(32)
  }
}
