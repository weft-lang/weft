type MethodPair<A, B> {
  MethodPair(A, B)
}

type MethodBox<T> {
  MethodBox(T)
}

impl<T> MethodBox<T> {
  fn replace(self, value: T) -> T {
    value
  }

  fn transform<U>(self, value: T, f: (T) -> U) -> U {
    f(value)
  }
}

fn generic_replace<K, V>(box: MethodBox<MethodPair<K, V>>, value: MethodPair<K, V>) -> MethodPair<K, V> {
  box.replace(value)
}

fn generic_transform<K, V, U>(box: MethodBox<MethodPair<K, V>>, value: MethodPair<K, V>, f: (MethodPair<K, V>) -> U) -> U {
  box.transform<U>(value, f)
}

fn method_pair_score(pair: MethodPair<i64, str>) -> i64 {
  match pair {
    MethodPair(number, text) -> number + if text == "weft" { 2 } else { 0 }
  }
}

test "generic method receiver substitution avoids caller variable capture" {
  let box = MethodBox<MethodPair<i64, str>>(MethodPair<i64, str>(0, "old"))
  let value = MethodPair<i64, str>(40, "weft")
  Test.assert_eq(method_pair_score(generic_replace<i64, str>(box, value)), 42)
  Test.assert_eq(generic_transform<i64, str, i64>(box, value, method_pair_score), 42)
}
