-- The compiler's MCP surface: its tool table and listings, request
-- classification, arguments, envelopes and the semantic-fact projection.

use compiler/tool/jsonrpc.{*}
use compiler/tool/mcp.{*}
use compiler/weft/facts/semantic.{*}
use stdlib/json as json
use stdlib/json.{Json, JsonBool, JsonEntry, JsonNull, JsonNumber, JsonString}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok}
use stdlib/semantic_type.{*}
use stdlib/string.{str_concat, str_contains}

fn parsed(text: str) -> Json {
  match json.parse(text) {
    Ok(value) -> value
    Err(_) -> JsonString("<unparsable fixture>")
  }
}

fn describe_request(request: McpRequest) -> str {
  match request {
    McpInitialize(params) -> str_concat("initialize ", jsonrpc_render(params))
    McpPing -> "ping"
    McpListTools -> "list"
    McpCallTool(tool, arguments) -> "call "
      |> str_concat(mcp_tool_name(tool))
      |> str_concat(" ")
      |> str_concat(jsonrpc_render(arguments))
    McpToolNameMissing -> "missing tool name"
    McpToolUnknown -> "unknown tool"
    McpMethodUnknown -> "unknown method"
  }
}

fn classify(method: str, params: str) -> str {
  describe_request(mcp_request(method, parsed(params)))
}

fn text_argument(arguments: str, key: str) -> str {
  match mcp_argument_text(parsed(arguments), key) {
    value: str -> str_concat("text ", value)
    nil -> "absent"
  }
}

fn integer_argument(arguments: str, key: str) -> str {
  match mcp_argument_integer(parsed(arguments), key) {
    Some(value) -> str_concat("integer ", value.to_str())
    None -> "absent"
  }
}

fn fact(value: SemanticFact) -> str { jsonrpc_render(mcp_fact(value)) }

fn i64_type() -> SemanticTypeFact { SemanticTypePrimitive("i64") }

fn here(start: i64) -> SemanticSourceLocationFact { SemanticSourceLocation("", start, 1) }

test "every_tool_is_named_and_found_by_its_name" {
  let mut count = 0
  let mut remaining = mcp_tools()
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(tool, rest) -> {
        match mcp_tool_named(mcp_tool_name(tool)) {
          Some(found) -> Test.assert_str_eq(mcp_tool_name(found), mcp_tool_name(tool))
          None -> Test.assert_str_eq(mcp_tool_name(tool), "<not found>")
        }
        count = count + 1
        remaining = rest
      }
    }
  }
  Test.assert_eq(count, 12)
}

test "only_exact_tool_names_are_tools" {
  let names = ["", "parse", "Parse_summary", "parse_summary ", "tools/list", "format"]
  for name in names {
    match mcp_tool_named(name) {
      Some(tool) -> Test.assert_str_eq(mcp_tool_name(tool), "<unexpected>")
      None -> 0
    }
  }
}

test "telemetry_tools_are_internal_and_the_rest_stable" {
  let internal = ["parse_summary", "check_summary", "ir_summary", "opt_counters"]
  for name in internal {
    match mcp_tool_named(name) {
      Some(tool) -> Test.assert_str_eq(mcp_stability_name(mcp_tool_stability(tool)), "internal")
      None -> Test.assert_str_eq(name, "<not a tool>")
    }
  }
  let stable = [
    "type_lookup",
    "effect_lookup",
    "diagnostics",
    "grammar_diagnostics",
    "fact_at_position",
    "visible_bindings",
    "conformance_at_position",
    "format_source"
  ]
  for name in stable {
    match mcp_tool_named(name) {
      Some(tool) -> Test.assert_str_eq(mcp_stability_name(mcp_tool_stability(tool)), "stable")
      None -> Test.assert_str_eq(name, "<not a tool>")
    }
  }
}

test "the_one_shot_listing_names_every_tool_in_order" {
  Test.assert_str_eq(
    mcp_tools_list_payload(),
    "{\"schema_version\":1,\"tools\":[{\"name\":\"parse_summary\",\"stability\":\"internal\"},{\"name\":\"check_summary\",\"stability\":\"internal\"},{\"name\":\"ir_summary\",\"stability\":\"internal\"},{\"name\":\"type_lookup\",\"stability\":\"stable\"},{\"name\":\"effect_lookup\",\"stability\":\"stable\"},{\"name\":\"diagnostics\",\"stability\":\"stable\"},{\"name\":\"grammar_diagnostics\",\"stability\":\"stable\"},{\"name\":\"opt_counters\",\"stability\":\"internal\"},{\"name\":\"fact_at_position\",\"stability\":\"stable\"},{\"name\":\"visible_bindings\",\"stability\":\"stable\"},{\"name\":\"conformance_at_position\",\"stability\":\"stable\"},{\"name\":\"format_source\",\"stability\":\"stable\"}]}"
  )
}

test "the_server_listing_is_json_with_a_schema_for_every_tool" {
  let listing = parsed(mcp_serve_tools_list_payload())
  let tools = match listing.get("tools") {
    Some(value) -> value
    None -> JsonNull
  }
  Test.assert_eq(json.json_array_len(tools), 12)
  let mut remaining = json.json_array_items(tools)
  while not remaining.is_empty() {
    match remaining {
      Nil -> nil
      Cons(tool, rest) -> {
        let schema = match tool.get("inputSchema") {
          Some(value) -> value
          None -> JsonNull
        }
        Test.assert_str_eq(json.json_object_get_str(schema, "type", ""), "object")
        Test.assert_true(str_contains(jsonrpc_render(schema), "\"source\"") == 1)
        Test.assert_true(json.json_object_get_str(tool, "description", "") != "")
        remaining = rest
      }
    }
  }
  Test.assert_true(
    str_contains(
      mcp_serve_tools_list_payload(),
      "\"required\":[\"source\",\"offset\",\"trait\"]"
    ) == 1
  )
}

test "requests_are_classified_by_method_and_tool" {
  Test.assert_str_eq(classify("tools/list", "{}"), "list")
  Test.assert_str_eq(
    classify("tools/call", "{\"name\":\"diagnostics\",\"arguments\":{\"source\":\"x\"}}"),
    "call diagnostics {\"source\":\"x\"}"
  )
  Test.assert_str_eq(classify("tools/call", "{\"name\":\"ir_summary\"}"), "call ir_summary null")
  Test.assert_str_eq(classify("tools/call", "{}"), "missing tool name")
  Test.assert_str_eq(classify("tools/call", "null"), "missing tool name")
  Test.assert_str_eq(classify("tools/call", "{\"name\":7}"), "unknown tool")
  Test.assert_str_eq(classify("tools/call", "{\"name\":\"nope\"}"), "unknown tool")
  Test.assert_str_eq(
    classify("initialize", "{\"protocolVersion\":\"x\"}"),
    "initialize {\"protocolVersion\":\"x\"}"
  )
  Test.assert_str_eq(classify("ping", "null"), "ping")
  Test.assert_str_eq(classify("tools/list/extra", "{}"), "unknown method")
  Test.assert_str_eq(classify("", "{}"), "unknown method")
}

test "arguments_are_read_by_kind" {
  let arguments = "{\"source\":\"fn\",\"offset\":4,\"float\":1.5,\"text\":\"4\",\"none\":null}"
  Test.assert_str_eq(text_argument(arguments, "source"), "text fn")
  Test.assert_str_eq(text_argument(arguments, "offset"), "absent")
  Test.assert_str_eq(text_argument(arguments, "none"), "absent")
  Test.assert_str_eq(text_argument(arguments, "missing"), "absent")
  Test.assert_str_eq(text_argument("null", "source"), "absent")
  Test.assert_str_eq(integer_argument(arguments, "offset"), "integer 4")
  Test.assert_str_eq(integer_argument(arguments, "float"), "absent")
  Test.assert_str_eq(integer_argument(arguments, "text"), "absent")
  Test.assert_str_eq(integer_argument(arguments, "missing"), "absent")
  Test.assert_str_eq(integer_argument("[1]", "offset"), "absent")
}

test "initialize_echoes_the_requested_protocol_version" {
  Test.assert_str_eq(
    mcp_initialize_payload(parsed("{\"protocolVersion\":\"2024-11-05\"}"), "0.1"),
    "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"weft\",\"version\":\"0.1\"}}"
  )
  Test.assert_str_eq(
    mcp_initialize_payload(parsed("{\"protocolVersion\":3}"), "0.1"),
    "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"weft\",\"version\":\"0.1\"}}"
  )
  Test.assert_str_eq(
    mcp_initialize_payload(JsonNull, "v\"q"),
    "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"weft\",\"version\":\"v\\\"q\"}}"
  )
}

test "results_carry_the_tool_header_and_content_escapes_the_payload" {
  let members = Cons(jsonrpc_member("offset", JsonNumber(3)), Nil<JsonEntry>())
  Test.assert_str_eq(
    mcp_result(McpFactAtPosition, members),
    "{\"tool\":\"fact_at_position\",\"ok\":true,\"schema_version\":1,\"stability\":\"stable\",\"offset\":3}"
  )
  Test.assert_str_eq(
    mcp_result(McpOptCounters, Nil<JsonEntry>()),
    "{\"tool\":\"opt_counters\",\"ok\":true,\"schema_version\":1,\"stability\":\"internal\"}"
  )
  Test.assert_str_eq(
    mcp_content("{\"a\":\"b\"}\n"),
    "{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"a\\\":\\\"b\\\"}\\n\"}],\"isError\":false}"
  )
  Test.assert_str_eq(
    jsonrpc_render(mcp_position_units()),
    "{\"span\":\"utf-8-byte-offset\",\"line_base\":1,\"col\":\"utf-8-byte-column\",\"scalar_col\":\"unicode-scalar-column\",\"utf16_col\":\"utf-16-code-unit-column\"}"
  )
}

test "symbol_and_use_facts_project_their_locations" {
  Test.assert_str_eq(
    fact(
      SemanticFactSymbol(
        SemanticSymbol(
          "total",
          SemanticSymbolLocal,
          i64_type(),
          here(12),
          SemanticSourceLocation("lib.weft", 4, 5)
        )
      )
    ),
    "{\"kind\":\"symbol\",\"name\":\"total\",\"symbol_kind\":\"local\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"occurrence\":{\"path\":\"\",\"start\":12,\"length\":1},\"definition\":{\"path\":\"lib.weft\",\"start\":4,\"length\":5}}"
  )
  let atom = SemanticEffectAtom("Log", SemanticTypeFactListNil)
  Test.assert_str_eq(
    fact(
      SemanticFactEffectAtomUse(
        SemanticEffectAtomUse(atom, here(1), SemanticSourceLocationOther("builtin"))
      )
    ),
    "{\"kind\":\"effect_atom_use\",\"atom\":{\"name\":\"Log\",\"arguments\":[]},\"occurrence\":{\"path\":\"\",\"start\":1,\"length\":1},\"definition\":{\"kind\":\"other\",\"name\":\"builtin\"}}"
  )
  Test.assert_str_eq(
    fact(
      SemanticFactEffectOperationUse(
        SemanticEffectOperationUse(atom, "hit", i64_type(), here(2), here(3))
      )
    ),
    "{\"kind\":\"effect_operation_use\",\"atom\":{\"name\":\"Log\",\"arguments\":[]},\"name\":\"hit\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"occurrence\":{\"path\":\"\",\"start\":2,\"length\":1},\"definition\":{\"path\":\"\",\"start\":3,\"length\":1}}"
  )
  Test.assert_str_eq(
    fact(
      SemanticFactAssociatedTypeUse(
        SemanticAssociatedTypeUse(SemanticTypeVariable("T"), "Item", i64_type(), here(0), here(9))
      )
    ),
    "{\"kind\":\"associated_type_use\",\"base\":{\"kind\":\"variable\",\"name\":\"T\"},\"name\":\"Item\",\"resolved_type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"occurrence\":{\"path\":\"\",\"start\":0,\"length\":1},\"definition\":{\"path\":\"\",\"start\":9,\"length\":1}}"
  )
  Test.assert_str_eq(
    fact(SemanticFactMatchArm(SemanticMatchArm(i64_type(), SemanticTypeBottom, true, here(5)))),
    "{\"kind\":\"match_arm\",\"narrowed_type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"residual_type\":{\"kind\":\"bottom\"},\"guarded\":true,\"occurrence\":{\"path\":\"\",\"start\":5,\"length\":1}}"
  )
}

test "function_facts_project_every_member" {
  let params = SemanticParameterFactListCons(
    SemanticParameter("x", i64_type()),
    SemanticParameterFactListCons(SemanticParameterOther("hidden"), SemanticParameterFactListNil)
  )
  let effects = SemanticEffectsOpen(
    SemanticEffectAtomFactListCons(
      SemanticEffectAtom("Log", SemanticTypeFactListNil),
      SemanticEffectAtomFactListNil
    ),
    "e"
  )
  let lanes = SemanticValueLaneFactListCons(
    SemanticValueLaneGpr,
    SemanticValueLaneFactListCons(SemanticValueLaneF64, SemanticValueLaneFactListOther("simd"))
  )
  let bounds = SemanticBoundsTraits(
    SemanticTraitBoundFactListCons(
      SemanticTraitBound("Eq"),
      SemanticTraitBoundFactListCons(
        SemanticTraitBoundWithAssociated(
          "Iterator",
          SemanticAssociatedTypeConstraintFactListCons(
            SemanticAssociatedTypeConstraint("Item", i64_type()),
            SemanticAssociatedTypeConstraintFactListNil
          )
        ),
        SemanticTraitBoundFactListNil
      )
    )
  )
  let function = SemanticFunction(
    "step",
    params,
    i64_type(),
    effects,
    SemanticPurityEffectful,
    SemanticOwnershipBorrowedParameters(
      SemanticIndexFactListCons(
        0,
        SemanticIndexFactListCons(2, SemanticIndexFactListOther("rest"))
      )
    ),
    SemanticValueShapeExactWords(2, lanes),
    bounds
  )
  Test.assert_str_eq(
    fact(SemanticFactFunction(function)),
    "{\"kind\":\"function\",\"name\":\"step\",\"parameters\":[{\"name\":\"x\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"}},{\"kind\":\"other\",\"name\":\"hidden\"}],\"return_type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"effects\":{\"kind\":\"open\",\"atoms\":[{\"name\":\"Log\",\"arguments\":[]}],\"tail\":\"e\"},\"purity\":\"effectful\",\"ownership\":{\"kind\":\"borrowed_parameters\",\"indices\":[0,2]},\"return_shape\":{\"kind\":\"words\",\"count\":2,\"lanes\":[\"gpr\",\"f64\",{\"kind\":\"other\",\"name\":\"simd\"}]},\"bounds\":{\"kind\":\"traits\",\"traits\":[\"Eq\",{\"name\":\"Iterator\",\"associated\":[{\"name\":\"Item\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"}}]}]}}"
  )
  let plain = SemanticFunction(
    "pure",
    SemanticParameterFactListNil,
    SemanticTypeTop,
    SemanticEffectsClosed(SemanticEffectAtomFactListNil),
    SemanticPurityPure,
    SemanticOwnershipUnknown,
    SemanticValueShapeWords(1),
    SemanticBoundsUnknown
  )
  Test.assert_str_eq(
    fact(SemanticFactFunction(plain)),
    "{\"kind\":\"function\",\"name\":\"pure\",\"parameters\":[],\"return_type\":{\"kind\":\"top\"},\"effects\":{\"kind\":\"closed\",\"atoms\":[]},\"purity\":\"pure\",\"ownership\":{\"kind\":\"unknown\"},\"return_shape\":{\"kind\":\"words\",\"count\":1},\"bounds\":{\"kind\":\"unknown\"}}"
  )
  Test.assert_str_eq(
    fact(SemanticFactFunction(SemanticFunctionOther("f"))),
    "{\"kind\":\"other\",\"name\":\"f\"}"
  )
}

test "declaration_facts_project_their_kinds_and_parameters" {
  let params = SemanticTypeParameterFactListCons(
    SemanticTypeParameter(
      "T",
      SemanticBoundsTypeParameters(
        SemanticTypeParameterFactListCons(
          SemanticTypeParameter("U", SemanticBoundsOther("x")),
          SemanticTypeParameterFactListNil
        )
      )
    ),
    SemanticTypeParameterFactListOther("more")
  )
  Test.assert_str_eq(
    fact(
      SemanticFactTypeDeclaration(
        SemanticTypeDeclaration("Pair", SemanticTypeDeclarationAlias(i64_type()), params, 2)
      )
    ),
    "{\"kind\":\"type_declaration\",\"name\":\"Pair\",\"declaration_kind\":\"alias\",\"target\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"type_parameters\":[{\"name\":\"T\",\"bounds\":{\"kind\":\"type_parameters\",\"parameters\":[{\"name\":\"U\",\"bounds\":{\"kind\":\"other\",\"name\":\"x\"}}]}},{\"kind\":\"other\",\"name\":\"more\"}],\"items\":2}"
  )
  let kinds = [
    SemanticTypeDeclarationRecord,
    SemanticTypeDeclarationVariant,
    SemanticTypeDeclarationOpaque,
    SemanticTypeDeclarationTrait,
    SemanticTypeDeclarationKindOther("union")
  ]
  let names = ["record", "variant", "opaque", "trait", "union"]
  let mut index: usize = 0
  for kind in kinds {
    Test.assert_str_eq(
      fact(
        SemanticFactTypeDeclaration(
          SemanticTypeDeclaration("T", kind, SemanticTypeParameterFactListNil, 0)
        )
      ),
      "{\"kind\":\"type_declaration\",\"name\":\"T\",\"declaration_kind\":\""
        |> str_concat(names[index])
        |> str_concat("\",\"type_parameters\":[],\"items\":0}")
    )
    index = index + 1
  }
  let operations = SemanticEffectOperationFactListCons(
    SemanticEffectOperation("get", SemanticParameterFactListNil, i64_type(), true),
    SemanticEffectOperationFactListOther("later")
  )
  Test.assert_str_eq(
    fact(
      SemanticFactEffectDeclaration(
        SemanticEffectDeclaration("State", SemanticTypeParameterFactListNil, operations)
      )
    ),
    "{\"kind\":\"effect_declaration\",\"name\":\"State\",\"type_parameters\":[],\"operations\":[{\"name\":\"get\",\"parameters\":[],\"return_type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"deferred\":true},{\"kind\":\"other\",\"name\":\"later\"}]}"
  )
}

test "conformance_facts_project_each_decision" {
  let decisions = [
    SemanticConformanceYes,
    SemanticConformanceNo,
    SemanticConformanceUnknown("generic"),
    SemanticConformanceDecisionOther("maybe")
  ]
  let expected = [
    "\"yes\"",
    "\"no\"",
    "{\"kind\":\"unknown\",\"reason\":\"generic\"}",
    "{\"kind\":\"other\",\"name\":\"maybe\"}"
  ]
  let mut index: usize = 0
  for decision in decisions {
    Test.assert_str_eq(
      fact(SemanticFactConformance(SemanticConformance(i64_type(), "Eq", decision))),
      "{\"kind\":\"conformance\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"},\"trait\":\"Eq\",\"decision\":"
        |> str_concat(expected[index])
        |> str_concat("}")
    )
    index = index + 1
  }
  Test.assert_str_eq(
    fact(SemanticFactOther("future")),
    "{\"kind\":\"other\",\"name\":\"future\"}"
  )
}

test "lookup_envelopes_report_found_missing_and_other" {
  let found = SemanticFactEnvelope(
    SemanticFactSchemaV1,
    SemanticFactFound(SemanticFactOther("x"))
  )
  let key = jsonrpc_member("name", JsonString("n"))
  Test.assert_str_eq(
    mcp_result(McpTypeLookup, Cons(key, mcp_found_members(found))),
    "{\"tool\":\"type_lookup\",\"ok\":true,\"schema_version\":1,\"stability\":\"stable\",\"name\":\"n\",\"found\":true,\"fact\":{\"kind\":\"other\",\"name\":\"x\"}}"
  )
  Test.assert_str_eq(
    mcp_result(
      McpTypeLookup,
      mcp_found_members(SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing))
    ),
    "{\"tool\":\"type_lookup\",\"ok\":true,\"schema_version\":1,\"stability\":\"stable\",\"found\":false}"
  )
  Test.assert_str_eq(
    mcp_result(
      McpTypeLookup,
      mcp_found_members(SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactResultOther("r")))
    ),
    "{\"tool\":\"type_lookup\",\"ok\":true,\"schema_version\":1,\"stability\":\"stable\",\"found\":false,\"other\":\"r\"}"
  )
  Test.assert_str_eq(
    mcp_result(McpTypeLookup, mcp_found_members(SemanticFactEnvelopeOther("v9"))),
    "{\"tool\":\"type_lookup\",\"ok\":true,\"schema_version\":1,\"stability\":\"stable\",\"found\":false,\"other\":\"v9\"}"
  )
}

test "bindings_project_in_order_and_stop_at_their_terminator" {
  let bindings = SemanticBindingFactListCons(
    SemanticBinding("a", SemanticSymbolParameter, i64_type()),
    SemanticBindingFactListCons(
      SemanticBindingOther("b"),
      SemanticBindingFactListOther("rest")
    )
  )
  Test.assert_str_eq(
    jsonrpc_render(mcp_bindings(bindings)),
    "[{\"name\":\"a\",\"symbol_kind\":\"parameter\",\"type\":{\"kind\":\"primitive\",\"name\":\"i64\"}},{\"kind\":\"other\",\"name\":\"b\"},{\"kind\":\"other\",\"name\":\"rest\"}]"
  )
  Test.assert_str_eq(jsonrpc_render(mcp_bindings(SemanticBindingFactListNil)), "[]")
}

test "symbol_kinds_have_their_wire_names" {
  let kinds = [
    SemanticSymbolFunction,
    SemanticSymbolConstructor,
    SemanticSymbolLocal,
    SemanticSymbolParameter,
    SemanticSymbolPattern,
    SemanticSymbolLoopBinding,
    SemanticSymbolModule,
    SemanticSymbolType,
    SemanticSymbolEffect,
    SemanticSymbolTrait,
    SemanticSymbolField,
    SemanticSymbolTuplePosition,
    SemanticSymbolEffectOperation,
    SemanticSymbolConstant,
    SemanticSymbolKindOther("macro")
  ]
  let names = [
    "\"function\"",
    "\"constructor\"",
    "\"local\"",
    "\"parameter\"",
    "\"pattern\"",
    "\"loop_binding\"",
    "\"module\"",
    "\"type\"",
    "\"effect\"",
    "\"trait\"",
    "\"field\"",
    "\"tuple_position\"",
    "\"effect_operation\"",
    "\"constant\"",
    "\"macro\""
  ]
  let mut index: usize = 0
  for kind in kinds {
    Test.assert_str_eq(jsonrpc_render(mcp_symbol_kind(kind)), names[index])
    index = index + 1
  }
}
