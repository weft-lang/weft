use compiler/typeck.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use compiler/lib.{*}

test "weak primitive roles are exact and exhaustive" {
  let names = "weak_ref weak_load ordinary weak_reference"
  let src = __str_ptr(names)
  Test.assert_true(match typeck_weak_call_role(src, 0, 8) {
    WeakRefCall -> true
    WeakLoadCall -> false
    NotWeakCall -> false
  })
  Test.assert_true(match typeck_weak_call_role(src, 9, 9) {
    WeakRefCall -> false
    WeakLoadCall -> true
    NotWeakCall -> false
  })
  Test.assert_true(match typeck_weak_call_role(src, 19, 8) {
    WeakRefCall -> false
    WeakLoadCall -> false
    NotWeakCall -> true
  })
  Test.assert_true(match typeck_weak_call_role(src, 28, 14) {
    WeakRefCall -> false
    WeakLoadCall -> false
    NotWeakCall -> true
  })
}

test "weak signatures preserve weak versus nullable strong cleanup" {
  let target = ty_rc(ty_i64())
  let reference = typeck_weak_call_result_type(WeakRefCall, target)
  let loaded = typeck_weak_call_result_type(WeakLoadCall, reference)
  Test.assert_eq(ty_is_weak(reference), 1)
  Test.assert_eq(ty_weak_inner(reference), target)
  Test.assert_eq(ty_narrow_drop_nil(loaded), target)
  Test.assert_eq(ty_value_has_release_lane(reference), 1)
  Test.assert_eq(ty_value_has_release_lane(loaded), 1)
  Test.assert_eq(typeck_weak_call_result_type(NotWeakCall, target), 0)
  Test.assert_eq(typeck_weak_call_result_type(WeakRefCall, 0), 0)
  Test.assert_eq(typeck_weak_call_result_type(WeakLoadCall, 0), 0)
  Test.assert_eq(typeck_weak_call_result_type(WeakLoadCall, target), 0)
}

test "lowered weak call results consume the shared signature" {
  let source = "weak_ref weak_load value reference"
  let src = __str_ptr(source)
  let tt = ttable_new()
  let target = ty_rc(ty_i64())
  let reference = ty_weak(target)
  let locals = pipeline_value_env_empty()
    |> pipeline_value_env_push_float_typed_node(19, 5, 0, 0, type_hash_of(target), target)
    |> pipeline_value_env_push_float_typed_node(25, 9, 1, 0, type_hash_of(reference), reference)
  let module = pipeline_lower_module(src, tt)
  let created = Call(0, 8, ExprListCons(Ident(19, 5), ExprListNil))
  let loaded = Call(9, 9, ExprListCons(Ident(25, 9), ExprListNil))
  let created_ty = pipeline_return_expr_type_node_typed(created, 0, locals, module)
  let loaded_ty = pipeline_return_expr_type_node_typed(loaded, 0, locals, module)
  Test.assert_eq(ty_is_weak(created_ty), 1)
  Test.assert_eq(ty_weak_inner(created_ty), target)
  Test.assert_eq(ty_narrow_drop_nil(loaded_ty), target)
  let nested = Call(9, 9, ExprListCons(created, ExprListNil))
  Test.assert_eq(ty_narrow_drop_nil(pipeline_return_expr_type_node_typed(nested, 0, locals, module)), target)
  Test.assert_eq(pipeline_return_expr_type_node_typed(Call(0, 8, ExprListNil), 0, locals, module), 0)
}

test "weak operations borrow existing handles and release owned operands after acquisition" {
  let source = "weak_ref value"
  let src = __str_ptr(source)
  let tt = ttable_new()
  let target = ty_rc(ty_i64())
  let locals = pipeline_value_env_push_float_typed_node(pipeline_value_env_empty(), 9, 5, 0, 0, type_hash_of(target), target)
  let module = pipeline_lower_module(src, tt)
  let borrowed = pipeline_lower_weak_operation(WeakRefCall, Ident(9, 5), 0, 1, 0, locals, module)
  Test.assert_eq(ir_inst_list_len(ir_lowered_expr_insts(borrowed)), 1)
  Test.assert_eq(ir_lowered_expr_value(borrowed), 0)
  Test.assert_eq(ir_lowered_expr_next_value(borrowed), 2)
  let operand = Call(0, 8, ExprListCons(Ident(9, 5), ExprListNil))
  let owned = pipeline_lower_weak_operation(WeakLoadCall, operand, 0, 1, 0, locals, module)
  Test.assert_eq(ir_lowered_expr_value(owned), 1)
  Test.assert_eq(ir_lowered_expr_next_value(owned), 3)
  Test.assert_true(match ir_lowered_expr_insts(owned) {
    IrInstCons(IrCallI64(dst, hash, args), IrInstCons(IrManagedStakeI64(cleanup_dst, value, kind, delta, origin), IrInstNil)) -> {
      let acquired_first = dst == 1 and hash == pipeline_rc_default_weak_load_hash()
      let released_weak = cleanup_dst == 2 and value == 0 and delta == -1 and pipeline_managed_release_hash_for_kind(kind) == pipeline_rc_default_weak_release_hash()
      acquired_first and released_weak and origin == ir_managed_stake_origin_call_transport()
    }
    _ -> false
  })
  Test.assert_eq(ir_lowered_expr_is_valid(pipeline_lower_weak_operation(NotWeakCall, Ident(9, 5), 0, 1, 0, locals, module)), 0)
}
