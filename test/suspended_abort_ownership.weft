test "owned Result merge survives borrowed resumed prompt and outward abort" {
  let ok_log = defer_order_log_new()
  let ok_got = handle suspended_owned_abort(ok_log, true) {
    SuspendedAbort.stop(value) -> value
  }
  let err_log = defer_order_log_new()
  let err_got = handle suspended_owned_abort(err_log, false) {
    SuspendedAbort.stop(value) -> value
  }
  Test.assert_eq(ok_got, 42)
  Test.assert_eq(err_got, 42)
  Test.assert_eq(defer_order_log_read(ok_log), 1)
  Test.assert_eq(defer_order_log_read(err_log), 1)
}

