test "abort_drops_looping_generator_live_stack_locals" {
  let mut warm = 0
  while warm < 20 {
    Test.assert_eq(suspended_abort_looping_generator_once(), 183)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 200 {
    Test.assert_eq(suspended_abort_looping_generator_once(), 183)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "plain_drop_walks_generator_suspended_cleanup_records" {
  Test.assert_eq(suspended_plain_looping_generator_once(), 1)
  let mut warm = 0
  while warm < 20 {
    suspended_plain_looping_generator_once()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 200 {
    suspended_plain_looping_generator_once()
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

