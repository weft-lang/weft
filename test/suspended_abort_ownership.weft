-- deferred continuations: suspended ownership under the abort edge.
--
-- Every resource-owning wrapper installs its explicit close/drop action with
-- `defer`; the abort edge must interleave that action with cleanup records for
-- live suspended frames without leaking or releasing either stake twice.
-- Generator construction runs eagerly to the first yield, so "before first
-- next" and "value suspended at yield" are one runtime state, not two timing
-- cells. The tests below pin that equivalence explicitly for both plain and
-- generic generators, then cover mid-iteration and exhausted states.

use runtime/rc_implicit_test.{*}
use runtime/rc.{*}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}
use stdlib/continuation.{*}
use stdlib/drop.{Drop}
use stdlib/fail.{Fail}
use stdlib/generator.{*}
use stdlib/iter.{*}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}

effect SuspendedAbort {
  fn stop(value: i64) -> i64
}

effect SuspendedStoredYield {
  @deferred fn yield(value: i64) -> i64
}

effect SuspendedOutwardYield {
  @deferred fn yield(value: i64) -> i64
}

effect SuspendedOutwardOuter {
  @deferred fn yield(value: i64) -> i64
}

effect SuspendedOutwardInner {
  @deferred fn yield(value: i64) -> i64
}

effect SuspendedOwnedRead {
  fn read() -> i64
}

effect SuspendedOwnedPrompt {
  @deferred fn suspend() -> i64
}

effect SuspendedOwnedMove {
  fn move(token: owned SuspendedOwnedToken) -> owned SuspendedOwnedToken
}

effect SuspendedOwnedPause {
  @deferred fn pause() -> i64
}

type SuspendedOwnedToken = opaque i64

type SuspendedOwnedOutcome {
  SuspendedOwnedReady(owned SuspendedOwnedToken),
    SuspendedOwnedFailed(i64)
}

type SuspendedOwnedBox = opaque(owned SuspendedOwnedToken, i64, bool)

type SuspendedOwnedWideBox = opaque(
  owned SuspendedOwnedToken,
  i64,
  bool,
  i64,
  bool,
  i64,
  bool,
  i64
)

impl Drop for SuspendedOwnedBox {
  fn drop(self) -> i64 {
    match self {
      SuspendedOwnedBox((token, code, flag)) -> token.drop()
    }
  }
}

impl Drop for SuspendedOwnedWideBox {
  fn drop(self) -> i64 {
    match self {
      SuspendedOwnedWideBox((token, first, first_flag, second, second_flag, third, third_flag, fourth)) -> token.drop()
    }
  }
}

effect SuspendedOwnedVariantMove {
  fn move(token: owned SuspendedOwnedToken) -> SuspendedOwnedOutcome
}

effect SuspendedOwnedWideMove {
  fn move(box: owned SuspendedOwnedWideBox, step: i64) -> owned SuspendedOwnedWideBox
}

type SuspendedOwnedWideOutcome {
  SuspendedOwnedWideReady(owned SuspendedOwnedWideBox),
    SuspendedOwnedWideFailed(owned SuspendedOwnedWideBox, i64)
}

effect SuspendedOwnedWideVariantMove {
  fn move(box: owned SuspendedOwnedWideBox, step: i64) -> SuspendedOwnedWideOutcome
}

impl Drop for SuspendedOwnedToken {
  fn drop(self: i64) -> i64 {
    defer_order_log_write(self, defer_order_log_read(self) + 1)
    0
  }
}

fn suspended_owned_open(log: i64, succeed: bool) -> Result<owned SuspendedOwnedToken, i64> {
  if succeed {
    result_ok<owned SuspendedOwnedToken, i64>(SuspendedOwnedToken(log))
  } else {
    result_err<owned SuspendedOwnedToken, i64>(1)
  }
}

fn suspended_owned_fallback(log: i64) -> owned SuspendedOwnedToken {
  SuspendedOwnedToken(log)
}

fn suspended_owned_transfer(
  token: owned SuspendedOwnedToken
) -[SuspendedOwnedMove]> owned SuspendedOwnedToken {
  SuspendedOwnedMove.move(token)
}

fn suspended_owned_transfer_variant(
  token: owned SuspendedOwnedToken
) -[SuspendedOwnedVariantMove]> SuspendedOwnedOutcome {
  SuspendedOwnedVariantMove.move(token)
}

fn suspended_owned_box_ok(log: i64) -> Result<owned SuspendedOwnedBox, i64> {
  result_ok<owned SuspendedOwnedBox, i64>(
    SuspendedOwnedBox((suspended_owned_fallback(log), 41, false))
  )
}

fn suspended_owned_wide_box_ok(log: i64) -> Result<owned SuspendedOwnedWideBox, i64> {
  result_ok<owned SuspendedOwnedWideBox, i64>(
    SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  )
}

fn suspended_owned_wide_box_forward(
  box: owned SuspendedOwnedWideBox
) -> Result<owned SuspendedOwnedWideBox, i64> {
  result_ok<owned SuspendedOwnedWideBox, i64>(box)
}

fn suspended_owned_wide_error(
  log: i64
) -> Result<owned SuspendedOwnedToken, (i64, i64, bool)> {
  result_err<owned SuspendedOwnedToken, (i64, i64, bool)>((43, log, true))
}

fn suspended_owned_box_try(log: i64) -[Fail<i64>]> i64 {
  let box: owned SuspendedOwnedBox = suspended_owned_box_ok(log)?
  match box {
    SuspendedOwnedBox((token, code, flag)) -> {
      token.drop()
      if flag { 0 } else { code }
    }
  }
}

fn suspended_owned_box_try_run(log: i64) -> i64 {
  handle suspended_owned_box_try(log) {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_box_try(log: i64) -[Fail<i64>]> i64 {
  let opened: owned SuspendedOwnedWideBox = suspended_owned_wide_box_ok(log)?
  let first: owned SuspendedOwnedWideBox = suspended_owned_wide_box_forward(opened)?
  let second: owned SuspendedOwnedWideBox = suspended_owned_wide_box_forward(first)?
  let final: owned SuspendedOwnedWideBox = suspended_owned_wide_box_forward(second)?
  match final {
    SuspendedOwnedWideBox((token, a, a_flag, b, b_flag, c, c_flag, d)) -> {
      token.drop()
      if a_flag and not b_flag and c_flag { a + b + c + d } else { 0 }
    }
  }
}

fn suspended_owned_wide_box_try_run(log: i64) -> i64 {
  handle suspended_owned_wide_box_try(log) {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_move(
  box: owned SuspendedOwnedWideBox,
  step: i64
) -[SuspendedOwnedWideMove]> owned SuspendedOwnedWideBox {
  SuspendedOwnedWideMove.move(box, step)
}

fn suspended_owned_wide_effect_chain(log: i64) -[SuspendedOwnedWideMove]> i64 {
  let opened = SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  let first = suspended_owned_wide_move(opened, 1)
  let second = suspended_owned_wide_move(first, 2)
  let final = suspended_owned_wide_move(second, 3)
  match final {
    SuspendedOwnedWideBox((token, a, a_flag, b, b_flag, c, c_flag, d)) -> {
      token.drop()
      if a_flag and not b_flag and c_flag { a + b + c + d } else { 0 }
    }
  }
}

fn suspended_owned_wide_effect_chain_run(log: i64) -> i64 {
  handle suspended_owned_wide_effect_chain(log) {
    SuspendedOwnedWideMove.move(box, step) -> resume(box)
  }
}

fn suspended_owned_wide_variant_move(
  box: owned SuspendedOwnedWideBox,
  step: i64
) -[SuspendedOwnedWideVariantMove]> SuspendedOwnedWideOutcome {
  SuspendedOwnedWideVariantMove.move(box, step)
}

fn suspended_owned_wide_variant_chain(log: i64) -[SuspendedOwnedWideVariantMove]> i64 {
  let opened = SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  let first: owned SuspendedOwnedWideBox = match suspended_owned_wide_variant_move(opened, 1) {
    SuspendedOwnedWideReady(box) -> box
    SuspendedOwnedWideFailed(box, code) -> box
  }
  let second: owned SuspendedOwnedWideBox = match suspended_owned_wide_variant_move(first, 2) {
    SuspendedOwnedWideReady(box) -> box
    SuspendedOwnedWideFailed(box, code) -> box
  }
  match suspended_owned_wide_variant_move(second, 3) {
    SuspendedOwnedWideReady(box) -> box.drop()
    SuspendedOwnedWideFailed(box, code) -> box.drop()
  }
}

fn suspended_owned_wide_variant_chain_run(log: i64) -> i64 {
  handle suspended_owned_wide_variant_chain(log) {
    SuspendedOwnedWideVariantMove.move(box, step) -> resume(SuspendedOwnedWideFailed(box, step))
  }
}

fn suspended_owned_wide_variant_preflight(
  box: owned SuspendedOwnedWideBox,
  step: i64
) -[SuspendedOwnedWideVariantMove, Fail<i64>]> owned SuspendedOwnedWideBox {
  match suspended_owned_wide_variant_move(box, step) {
    SuspendedOwnedWideReady(returned) -> result_err<owned SuspendedOwnedWideBox, i64>(91)
    SuspendedOwnedWideFailed(returned, code) -> result_ok<owned SuspendedOwnedWideBox, i64>(returned)
  }?
}

fn suspended_owned_wide_variant_try_chain(log: i64) -[SuspendedOwnedWideVariantMove, Fail<i64>]> i64 {
  let opened = SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  let first: owned SuspendedOwnedWideBox = suspended_owned_wide_variant_preflight(opened, 1)
  let second: owned SuspendedOwnedWideBox = suspended_owned_wide_variant_preflight(first, 2)
  let final: owned SuspendedOwnedWideBox = suspended_owned_wide_variant_preflight(second, 3)
  final.drop()
}

fn suspended_owned_wide_variant_try_chain_run(log: i64) -> i64 {
  handle {
    handle suspended_owned_wide_variant_try_chain(log) {
      SuspendedOwnedWideVariantMove.move(box, step) -> resume(SuspendedOwnedWideFailed(box, step))
    }
  } {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_variant_then_abort(
  log: i64
) -[SuspendedOwnedWideVariantMove, Fail<i64>]> i64 {
  let opened = SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  let returned: owned SuspendedOwnedWideBox = match suspended_owned_wide_variant_move(opened, 1) {
    SuspendedOwnedWideReady(box) -> box
    SuspendedOwnedWideFailed(box, code) -> box
  }
  Fail<i64>.fail(73)
}

fn suspended_owned_wide_variant_then_abort_run(log: i64) -> i64 {
  handle {
    handle suspended_owned_wide_variant_then_abort(log) {
      SuspendedOwnedWideVariantMove.move(box, step) -> resume(SuspendedOwnedWideFailed(box, step))
    }
  } {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_effect_then_abort(
  log: i64
) -[SuspendedOwnedWideMove, Fail<i64>]> i64 {
  let opened = SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19))
  let returned: owned SuspendedOwnedWideBox = suspended_owned_wide_move(opened, 1)
  Fail<i64>.fail(72)
}

fn suspended_owned_wide_effect_then_abort_run(log: i64) -> i64 {
  handle {
    handle suspended_owned_wide_effect_then_abort(log) {
      SuspendedOwnedWideMove.move(box, step) -> resume(box)
    }
  } {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_local_variant_then_abort(log: i64) -[Fail<i64>]> i64 {
  let outcome = SuspendedOwnedWideFailed(
    SuspendedOwnedWideBox((suspended_owned_fallback(log), 11, true, 13, false, 17, true, 19)),
    1
  )
  let returned: owned SuspendedOwnedWideBox = match outcome {
    SuspendedOwnedWideReady(box) -> box
    SuspendedOwnedWideFailed(box, code) -> box
  }
  Fail<i64>.fail(74)
}

fn suspended_owned_wide_local_variant_then_abort_run(log: i64) -> i64 {
  handle suspended_owned_wide_local_variant_then_abort(log) {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_scalar_effect_then_abort(log: i64) -[SuspendedOwnedMove, Fail<i64>]> i64 {
  let returned: owned SuspendedOwnedToken = suspended_owned_transfer(suspended_owned_fallback(log))
  Fail<i64>.fail(71)
}

fn suspended_owned_scalar_effect_then_abort_run(log: i64) -> i64 {
  handle {
    handle suspended_owned_scalar_effect_then_abort(log) {
      SuspendedOwnedMove.move(token) -> resume(token)
    }
  } {
    Fail<i64>.fail(code) -> code
  }
}

fn suspended_owned_wide_error_try(log: i64) -[Fail<(i64, i64, bool)>]> i64 {
  let token: owned SuspendedOwnedToken = suspended_owned_wide_error(log)?
  token.drop()
}

fn suspended_owned_wide_error_try_run(log: i64) -> i64 {
  handle suspended_owned_wide_error_try(log) {
    Fail<(i64, i64, bool)>.fail(error) -> match error {
      (code, observed_log, flag) -> {
        if flag and observed_log == log { code } else { 0 }
      }
    }
  }
}

fn suspended_owned_clause_resume(log: i64) -> i64 {
  let returned: owned SuspendedOwnedToken = handle {
    handle suspended_owned_transfer(suspended_owned_fallback(log)) {
      SuspendedOwnedMove.move(value) -> {
        SuspendedOwnedPause.pause()
        resume(value)
      }
    }
  } {
    SuspendedOwnedPause.pause() with k -> k(0)
  }
  returned.drop()
  defer_order_log_read(log)
}

fn suspended_owned_variant_clause_resume(log: i64) -> i64 {
  let returned = handle {
    handle suspended_owned_transfer_variant(suspended_owned_fallback(log)) {
      SuspendedOwnedVariantMove.move(value) -> {
        SuspendedOwnedPause.pause()
        resume(SuspendedOwnedReady(value))
      }
    }
  } {
    SuspendedOwnedPause.pause() with k -> k(0)
  }
  match returned {
    SuspendedOwnedReady(value) -> value.drop()
    SuspendedOwnedFailed(code) -> code
  }
  defer_order_log_read(log)
}

fn suspended_owned_clause_drop(log: i64) -> i64 {
  let cell = continuation_cell_new()
  let returned: owned SuspendedOwnedToken = handle {
    handle suspended_owned_transfer(suspended_owned_fallback(log)) {
      SuspendedOwnedMove.move(value) -> {
        SuspendedOwnedPause.pause()
        resume(value)
      }
    }
  } {
    SuspendedOwnedPause.pause() with k -> {
      continuation_cell_store_i64(cell, k)
      suspended_owned_fallback(log)
    }
  }
  returned.drop()
  continuation_cell_drop_i64(cell)
  defer_order_log_read(log)
}

fn suspended_owned_read(token: borrow mut SuspendedOwnedToken) -> i64 { 41 }

fn suspended_owned_with_borrow(
  token: borrow mut SuspendedOwnedToken,
  body: () -[SuspendedOwnedRead, SuspendedOwnedPrompt, SuspendedAbort]> i64
) -[SuspendedAbort]> i64 {
  handle {
    handle body() {
      SuspendedOwnedPrompt.suspend() with k -> k(0)
    }
  } {
    SuspendedOwnedRead.read() -> resume(suspended_owned_read(token))
  }
}

fn suspended_owned_abort(log: i64, succeed: bool) -[SuspendedAbort]> i64 {
  let opened = suspended_owned_open(log, succeed)
  let mut token: owned SuspendedOwnedToken = match opened {
    Ok(value) -> value
    Err(error) -> suspended_owned_fallback(log)
  }
  suspended_owned_with_borrow(token, () => {
    let observed = SuspendedOwnedRead.read()
    SuspendedOwnedPrompt.suspend()
    SuspendedAbort.stop(observed + 1)
  })
}

fn suspended_abort_generic_current(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let producer = () => {
    generator_yield<RuntimeRcProbe>(payload)
    runtime_rc_probe_load(payload)
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  defer generator_drop<RuntimeRcProbe, i64>(g)
  SuspendedAbort.stop(41 + generator_has_current<RuntimeRcProbe, i64>(g)) + 1000
}

fn suspended_abort_generic_current_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_generic_current(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_closure_only(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let reader = () => runtime_rc_probe_load(payload)
  let observed = reader()
  SuspendedAbort.stop(observed) + 1000
}

fn suspended_abort_closure_only_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_closure_only(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_generic_mid(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let producer = () => {
    generator_yield<RuntimeRcProbe>(payload)
    generator_yield<RuntimeRcProbe>(payload)
    runtime_rc_probe_load(payload)
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  defer generator_drop<RuntimeRcProbe, i64>(g)
  let first = generator_next<RuntimeRcProbe, i64>(g)
  let second = generator_next<RuntimeRcProbe, i64>(g)
  let first_value = match first {
    GeneratorNextDone -> 0
    GeneratorNextValue(value) -> runtime_rc_probe_load(value)
  }
  let second_value = match second {
    GeneratorNextDone -> 0
    GeneratorNextValue(value) -> runtime_rc_probe_load(value)
  }
  SuspendedAbort.stop(first_value + second_value) + 1000
}

fn suspended_abort_generic_mid_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_generic_mid(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_generator_closed_before_abort(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let producer = () => {
    generator_yield<RuntimeRcProbe>(payload)
    0
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  generator_drop<RuntimeRcProbe, i64>(g)
  SuspendedAbort.stop(42) + 1000
}

fn suspended_abort_generator_closed_before_abort_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_generator_closed_before_abort(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_looping_generator_once() -> i64 {
  handle {
    let producer = () => {
      let local: RuntimeRcProbe = runtime_rc_probe_new(91)
      let mut i = 0
      while i < 3 {
        generator_yield_i64(runtime_rc_probe_load(local) + i)
        i = i + 1
      }
      runtime_rc_probe_load(local)
    }
    let g = generator_i64_new(producer)
    defer generator_i64_drop(g)
    let first = generator_i64_next(g)
    let second = generator_i64_next(g)
    SuspendedAbort.stop(generator_next_value_or(first, 0) + generator_next_value_or(second, 0))
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_plain_looping_generator_once() -> i64 {
  let producer = () => {
    let local: RuntimeRcProbe = runtime_rc_probe_new(61)
    generator_yield_i64(runtime_rc_probe_load(local))
    runtime_rc_probe_load(local)
  }
  let g = generator_i64_new(producer)
  let pending = runtime_generator_state_cleanup_count(generator_i64_state(g))
  generator_i64_drop(g)
  pending
}

fn suspended_abort_plain_before_first_next_once() -> i64 {
  handle {
    let producer = () => {
      let local: RuntimeRcProbe = runtime_rc_probe_new(64)
      generator_yield_i64(runtime_rc_probe_load(local))
      runtime_rc_probe_load(local)
    }
    let g = generator_i64_new(producer)
    defer generator_i64_drop(g)
    SuspendedAbort.stop(41 + generator_i64_has_current(g)) + 1000
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_plain_after_exhaustion_once() -> i64 {
  handle {
    let producer = () => {
      let local: RuntimeRcProbe = runtime_rc_probe_new(67)
      generator_yield_i64(runtime_rc_probe_load(local))
      runtime_rc_probe_load(local)
    }
    let g = generator_i64_new(producer)
    defer generator_i64_drop(g)
    generator_i64_next(g)
    generator_i64_next(g)
    SuspendedAbort.stop(41 + generator_i64_is_done(g)) + 1000
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_after_exhaustion(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let producer = () => {
    generator_yield<i64>(7)
    payload
  }
  let g = generator_new<i64, RuntimeRcProbe>(producer)
  defer generator_drop<i64, RuntimeRcProbe>(g)
  generator_next<i64, RuntimeRcProbe>(g)
  generator_next<i64, RuntimeRcProbe>(g)
  SuspendedAbort.stop(42) + 1000
}

fn suspended_abort_after_exhaustion_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_after_exhaustion(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_nested_fibers_once() -> i64 {
  handle {
    let outer_producer = () => {
      let inner_producer = () => {
        let local: RuntimeRcProbe = runtime_rc_probe_new(73)
        generator_yield_i64(runtime_rc_probe_load(local))
        runtime_rc_probe_load(local)
      }
      let inner = generator_i64_new(inner_producer)
      defer generator_i64_drop(inner)
      let first = generator_i64_next(inner)
      generator_yield_i64(generator_next_value_or(first, 0))
      0
    }
    let outer = generator_i64_new(outer_producer)
    defer generator_i64_drop(outer)
    SuspendedAbort.stop(42) + 1000
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_nested_fibers_after_outer_next_once(exhaust: i64) -> i64 {
  handle {
    let outer_producer = () => {
      let inner_producer = () => {
        let local: RuntimeRcProbe = runtime_rc_probe_new(74)
        generator_yield_i64(runtime_rc_probe_load(local))
        runtime_rc_probe_load(local)
      }
      let inner = generator_i64_new(inner_producer)
      defer generator_i64_drop(inner)
      let first = generator_i64_next(inner)
      generator_yield_i64(generator_next_value_or(first, 0))
      0
    }
    let outer = generator_i64_new(outer_producer)
    defer generator_i64_drop(outer)
    generator_i64_next(outer)
    if exhaust == 1 { generator_i64_next(outer) } else { GeneratorDone }
    let timing_ok = if exhaust == 1 { generator_i64_is_done(outer) }
    else { 1 - generator_i64_is_done(outer) }
    SuspendedAbort.stop(41 + timing_ok) + 1000
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_iter_capture(payload: RuntimeRcProbe, value: i64) -> i64 {
  runtime_rc_probe_load(payload) + value
}

fn suspended_abort_lazy_depth_two(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let add_payload = value => suspended_iter_capture(payload, value)
  let first = iter_map<i64, i64>(iter_range(0, 4), add_payload)
  let second = iter_take<i64>(iter_map<i64, i64>(first, value => value + 1), 3)
  defer iter_drop<i64>(second)
  let value = iter_next<i64>(second)
  let observed = match value { Some(v) -> v None -> 0 }
  SuspendedAbort.stop(observed) + 1000
}

fn suspended_abort_lazy_depth_two_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_lazy_depth_two(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_lazy_depth_two_before_next(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let add_payload = value => suspended_iter_capture(payload, value)
  let first = iter_map<i64, i64>(iter_range(0, 4), add_payload)
  let second = iter_take<i64>(iter_map<i64, i64>(first, value => value + 1), 3)
  defer iter_drop<i64>(second)
  SuspendedAbort.stop(42) + 1000
}

fn suspended_abort_lazy_depth_two_before_next_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_lazy_depth_two_before_next(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_abort_lazy_depth_two_after_exhaustion(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let add_payload = value => suspended_iter_capture(payload, value)
  let first = iter_map<i64, i64>(iter_range(0, 4), add_payload)
  let second = iter_take<i64>(iter_map<i64, i64>(first, value => value + 1), 3)
  defer iter_drop<i64>(second)
  iter_next<i64>(second)
  iter_next<i64>(second)
  iter_next<i64>(second)
  iter_next<i64>(second)
  SuspendedAbort.stop(42) + 1000
}

fn suspended_abort_lazy_depth_two_after_exhaustion_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_lazy_depth_two_after_exhaustion(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_stored_body(payload: RuntimeRcProbe) -[SuspendedStoredYield]> i64 {
  let resumed = SuspendedStoredYield.yield(10)
  resumed + runtime_rc_probe_load(payload)
}

fn suspended_abort_stored_continuation(payload: RuntimeRcProbe) -[SuspendedAbort]> i64 {
  let cell = continuation_cell_new()
  defer continuation_cell_drop_i64(cell)
  handle suspended_stored_body(payload) {
    SuspendedStoredYield.yield(value) with k -> {
      continuation_cell_store_i64(cell, k)
      value
    }
  }
  SuspendedAbort.stop(42) + 1000
}

fn suspended_abort_stored_continuation_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_abort_stored_continuation(payload) {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_outward_abort_body(payload: RuntimeRcProbe) -[SuspendedOutwardYield, SuspendedAbort]> i64 {
  let reader = () => runtime_rc_probe_load(payload)
  let resumed = SuspendedOutwardYield.yield(1)
  SuspendedAbort.stop(reader() + resumed) + 1000
}

fn suspended_outward_abort_run(payload: RuntimeRcProbe) -> i64 {
  handle {
    handle suspended_outward_abort_body(payload) {
      SuspendedOutwardYield.yield(value) with k -> k(value + 1)
    }
  } {
    SuspendedAbort.stop(value) -> value
  }
}

fn suspended_nested_outward_abort_body(payload: RuntimeRcProbe) -[SuspendedOutwardOuter, SuspendedOutwardInner, SuspendedAbort]> i64 {
  let reader = () => runtime_rc_probe_load(payload)
  let outer = SuspendedOutwardOuter.yield(1)
  let inner = SuspendedOutwardInner.yield(2)
  SuspendedAbort.stop(reader() + outer + inner) + 1000
}

fn suspended_nested_outward_abort_run(payload: RuntimeRcProbe) -> i64 {
  handle {
    handle {
      handle suspended_nested_outward_abort_body(payload) {
        SuspendedOutwardInner.yield(value) with k -> k(value + 1)
      }
    } {
      SuspendedOutwardOuter.yield(value) with k -> k(value + 1)
    }
  } {
    SuspendedAbort.stop(value) -> value
  }
}

