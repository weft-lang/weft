use stdlib/iter as iter
use stdlib/state as state
use stdlib/state.{State}
use stdlib/vector as vector
use stdlib/vector.{Vector}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_count}
use module_fixtures/callback_context as contextual
use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/string
use stdlib/diagnostic/registry as registry
use stdlib/option.{Option, Some}

type Entry { text: str }

type Host { value: Entry }

impl Host {
  fn text(self, f: (Entry) -> str) -> str { f(self.value) }
  fn project<U>(self, f: (Entry) -> U) -> U { f(self.value) }
  fn interpret<U, e>(self, f: (Entry) -[e]> U) -[e]> U { f(self.value) }
  fn combine<U>(self, initial: usize, f: (usize, Entry) -> U) -> U { f(initial, self.value) }
  fn build<T, U>(value: T, f: (T) -> U) -> U { f(value) }
  fn move(self, f: (unique i64) -> i64) -> i64 { f(21) }
}

fn first<T, U>(value: T, f: (T) -> U) -> U { f(value) }

fn last<T, U>(f: (T) -> U, value: T) -> U { f(value) }

test "method callback receives its concrete record context before field checking" {
  let host = Host { value: Entry { text: "record" } }
  Test.assert_str_eq(host.text(entry => entry.text), "record")
  Test.assert_str_eq(host.project<str>(entry => entry.text), "record")
  Test.assert_str_eq(host.project(entry => entry.text), "record")
}

test "receiver types contextualize optional record projection and infer its output" {
  let value = Some(Entry { text: "optional" })
  Test.assert_str_eq(value.map(entry => entry.text).unwrap(), "optional")
  let summary = registry.get(0).map(entry => entry.summary).unwrap()
  Test.assert_str_eq(summary, "module import graph contains a cycle")
}

test "generic arguments supply callback parameter context in either argument order" {
  Test.assert_str_eq(first(Entry { text: "first" }, entry => entry.text), "first")
  Test.assert_str_eq(last(entry => entry.text, Entry { text: "last" }), "last")
}

test "qualified and associated generic calls use the same callback context" {
  let entry = Entry { text: "qualified" }
  Test.assert_str_eq(contextual.apply(value => value.text, entry), "qualified")
  Test.assert_str_eq(Host.build(entry, value => value.text), "qualified")
}

test "callback results unlock earlier callback inputs in a finite dependency chain" {
  let result = contextual.chain(value => value.text, text => Entry { text: text }, "dependency")
  Test.assert_str_eq(result, "dependency")
}

test "contextual callbacks preserve mixed annotations and full width scalar values" {
  let host = Host { value: Entry { text: "🧶" } }
  Test.assert_eq_usize(host.combine(4, (count: usize, entry) => count + entry.text.len()), 8)
  let maximum: usize = 18446744073709551615
  Test.assert_eq_usize(Some(maximum).map(value => value).unwrap(), maximum)
  let fraction: f64 = 0.25
  Test.assert_eq_f64(Some(fraction).map(value => value + 0.5).unwrap(), 0.75)
}

effect CallbackObserve { fn length(value: str) -> usize }

test "contextual method callbacks retain their inferred residual effects" {
  let host = Host { value: Entry { text: "effect" } }
  let length = handle host.interpret(entry => CallbackObserve.length(entry.text)) {
    CallbackObserve.length(text) -> resume(text.len())
  }
  Test.assert_eq_usize(length, 6)
}

fn contextual_projection_churn() -> bool {
  let suffix = "managed".repeat(3)
  let value = Some(Entry { text: "context".concat(suffix) })
  let projected = value.map(entry => entry.text.concat(suffix)).unwrap()
  projected == "context".concat(suffix).concat(suffix)
}

test "contextual managed parameters results and captures release their stakes" {
  for _ in 0..40 { Test.assert_true(contextual_projection_churn()) }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { Test.assert_true(contextual_projection_churn()) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}

fn template_projection<T>(value: T) -> T { Some<T>(value).map<T>(item => item).unwrap() }

test "explicit callback specialization preserves enclosing template identities" {
  Test.assert_str_eq(template_projection("template"), "template")
  Test.assert_str_eq(template_projection(Entry { text: "record template" }).text, "record template")
  let maximum: usize = 18446744073709551615
  Test.assert_eq_usize(template_projection(maximum), maximum)
}

fn contextual_owned_round(probe: RuntimeRcProbe) -> usize {
  let host = Host { value: Entry { text: "owned" } }
  let values = host.project(entry => {
    let mut result = vector.new<RuntimeRcProbe>()
    if entry.text == "owned" { result.push(probe) }
    result
  })
  values.len()
}

test "contextual callbacks infer owned results and retain exactly their managed elements" {
  let probe = runtime_rc_probe_new(73)
  for _ in 0..32 {
    Test.assert_eq_usize(contextual_owned_round(probe), 1)
    Test.assert_eq(runtime_rc_probe_count(probe), 1)
  }
}

fn consume_contextual_unique(value: unique i64) -> i64 { 42 }

test "contextual callback parameters retain unique move obligations" {
  let host = Host { value: Entry { text: "unique" } }
  Test.assert_eq(host.move(value => consume_contextual_unique(value)), 42)
}

fn contextual_argument_order() -[State<i64>]> str {
  contextual.apply({
    State.put(State.get() * 10 + 1)
    (entry: Entry) => entry.text
  }, {
    State.put(State.get() * 10 + 2)
    Entry { text: "source order" }
  })
}

test "callback inference preserves runtime argument evaluation order" {
  let (value, order) = state.run(0, contextual_argument_order)
  Test.assert_str_eq(value, "source order")
  Test.assert_eq(order, 12)
}

test "callback record updates retain nominal types before checked layout facts" {
  let host = Host { value: Entry { text: "before" } }
  let updated = host.project(entry => entry.{ text: "after" })
  Test.assert_str_eq(updated.text, "after")
  for keep in [false, true] {
    let selected = host.project(entry => match keep {
      false -> entry.{ text: "changed" }
      true -> entry
    })
    Test.assert_str_eq(selected.text, if keep { "before" } else { "changed" })
  }
}

fn contextual_entries() -> owned Vector<Entry> {
  let mut entries = vector.new<Entry>()
  entries.push(Entry { text: "first" })
  entries.push(Entry { text: "second" })
  entries
}

test "owned iterator associated types supply callback field context" {
  Test.assert_eq_usize(iter.position(contextual_entries(), entry => entry.text == "second").unwrap(), 1)
  let (accepted, rejected) = iter.partition(contextual_entries(), entry => entry.text == "second")
  Test.assert_eq_usize(accepted.len(), 1)
  Test.assert_eq_usize(rejected.len(), 1)
  Test.assert_str_eq(accepted.get(0).unwrap().text, "second")
  Test.assert_str_eq(rejected.get(0).unwrap().text, "first")
}
