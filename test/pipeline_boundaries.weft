test "decl_reifier_types_impl_members" {
  let lhs = node_new(1, 1, 0, 0, 0)
  let rhs = node_new(1, 2, 0, 0, 0)
  let body = node_new(3, 1, lhs, rhs, 0)
  let inner = node_new(8, 0, 3, nlist_new(), body)
  let wrapped = node_new(23, inner, 0, 0, 0)
  let members = nlist_new()
  nlist_add(members, wrapped)
  let decl = decl_from_node(node_new(40, 0, 5, members, 123))
  Test.assert_eq(decl_tag(decl), 40)
  Test.assert_eq(decl_raw_bridge_slot_count(decl), 0)
  Test.assert_eq(decl_tree_raw_bridge_slot_count(decl), 0)
  Test.assert_eq(decl_impl_member_count_or(decl, 0 - 1), 1)
  Test.assert_eq(type_impl_member_list_nth_kind_or(decl_impl_members(decl), 0, 0 - 1), 1)
  Test.assert_eq(type_impl_member_list_nth_method_body_tag_or(decl_impl_members(decl), 0, 0 - 1), 3)
}

