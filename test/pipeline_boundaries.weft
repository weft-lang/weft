test "pipeline_lower_for_iter_continue_advances_to_ir_sidecar" {
  let src = "type PipelineList { Nil, Cons(i64, PipelineList) } fn sum(xs: PipelineList) -> i64 { let mut s = 0 for x in xs { if x == 1 { continue } else { s = s + x } } s }"
