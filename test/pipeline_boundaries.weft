  Test.assert_eq(ir_borrow_summary_is_known(scalar_borrow), 1)
  Test.assert_eq(ir_borrow_summary_param_count_or(scalar_borrow, 0 - 1), 0)

  let array_program = "fn fixed_at(xs: [str; 7], index: usize) -> str { xs[index] } fn main() -> i64 { 0 }"
  let array_typed = pipeline_check_source_standalone(__str_ptr(array_program), __str_len(array_program))
  let array_node = expr_to_node(pipeline_typed_first_body_expr(array_typed))
  Test.assert_eq(type_hash_of(node_f3(array_node)), type_hash_of(ty_str()))
  Test.assert_eq(node_f4(array_node), 7)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_lower_ir(array_typed)), 0)

  let nested_slice_program = "fn nested_view_at(xs: [[i64]], index: usize) -> [i64] { xs[index] } fn main() -> i64 { 0 }"
  let nested_slice_typed = pipeline_check_source_standalone(__str_ptr(nested_slice_program), __str_len(nested_slice_program))
  let nested_slice_ir = pipeline_lower_ir(nested_slice_typed)
  Test.assert_eq(pipeline_ir_verify_module(nested_slice_ir), 0)
  let nested_slice_optimised = pipeline_optimise_typed_ir(nested_slice_typed, nested_slice_ir)
  Test.assert_eq(pipeline_ir_verify_module(nested_slice_optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(nested_slice_typed, nested_slice_optimised)), 0)
  let nested_hash = str_hash(__str_ptr("nested_view_at"), 0, __str_len("nested_view_at"))
  let nested_borrow = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(pipeline_ir_semantic_facts(nested_slice_optimised), nested_hash))
  Test.assert_eq(ir_borrow_summary_is_known(nested_borrow), 0)
}

test "checker_and_lowering_publish_checked_index_mutation_facts" {
  let array_program = "fn replace() -> i64 { let mut xs = [10, 20] xs[1] = 42 xs[1] } fn main() -> i64 { 0 }"
  let array_typed = pipeline_check_source_standalone(__str_ptr(array_program), __str_len(array_program))
