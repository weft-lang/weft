test "pipeline_semantic_facts_publish_slice_signature_shapes" {
  let program = "fn keep_view(xs: [i64]) -> [i64] { xs } fn main() -> i64 { 0 }"
  let src = __str_ptr(program)
  let typed = pipeline_check_source_standalone(src, __str_len(program))
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let fact = pipeline_ir_semantic_fact_find(pipeline_ir_semantic_facts(optimised), str_hash(src, 3, 9))
  Test.assert_eq(if fact != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_value_shape_lane_count(cg_semantic_fact_param_shape_at(fact, 0)), 2)
  Test.assert_eq(ir_value_shape_lane_count(cg_semantic_fact_return_shape(fact)), 2)
  Test.assert_eq(cg_semantic_fact_param_lane_count(fact), 2)
  Test.assert_eq(cg_semantic_fact_word_abi(fact), 0)
  let borrow = pipeline_ir_semantic_borrow_fact_find(pipeline_ir_semantic_facts(optimised), str_hash(src, 3, 9))
  let params = ir_borrow_facts_params(borrow)
  let origins = ir_borrow_value_facts_find(ir_borrow_facts_values(borrow), 0)
  Test.assert_eq(ir_borrow_param_fact_count(params), 1)
  Test.assert_eq(ir_borrow_param_fact_head_or(params, 0, 0 - 1), 0)
  Test.assert_eq(ir_borrow_param_fact_mutable_or(params, 0, 0 - 1), 0)
  Test.assert_eq(ir_borrow_origin_list_len(origins), 1)
  Test.assert_eq(ir_borrow_facts_return_mutability(borrow), 0)
  Test.assert_eq(ir_borrow_summary_is_known(ir_borrow_facts_summary(borrow)), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(ir_borrow_facts_summary(borrow)), 0), 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_facts_valid(optimised), 1)
}

test "borrow_fact_set_equality_is_idempotent_for_multiple_origins" {
  let values = ir_value_list_prepend(4, ir_value_list_prepend(9, ir_value_list_empty()))
  let reordered_values = ir_value_list_prepend(9, ir_value_list_prepend(4, ir_value_list_empty()))
  Test.assert_eq(ir_value_list_set_eq(values, values), 1)
  Test.assert_eq(ir_value_list_set_eq(values, reordered_values), 1)
  Test.assert_eq(ir_value_list_set_eq(values, ir_value_list_prepend(4, ir_value_list_empty())), 0)

  let first = ir_borrow_origin(ir_borrow_owner_parameter(0), 10, 11, 0)
  let second = ir_borrow_origin(ir_borrow_owner_parameter(1), 10, 11, 0)
  let origins = ir_borrow_origin_list_prepend(first, ir_borrow_origin_list_prepend(second, ir_borrow_origin_list_empty()))
  let reordered = ir_borrow_origin_list_prepend(second, ir_borrow_origin_list_prepend(first, ir_borrow_origin_list_empty()))
  Test.assert_eq(ir_borrow_origin_list_set_eq(origins, origins), 1)
  Test.assert_eq(ir_borrow_origin_list_set_eq(origins, reordered), 1)
  Test.assert_eq(ir_borrow_origin_list_set_eq(origins, ir_borrow_origin_list_prepend(first, ir_borrow_origin_list_empty())), 0)
}

test "pipeline_borrow_summaries_track_exact_parameter_origins" {
  let program = "fn pick_view(xs: [i64], ys: [i64], pick: bool) -> [i64] { if pick { xs } else { ys } } fn alias_view(xs: [i64]) -> [i64] { let saved = xs saved } fn wrap_view(xs: [i64], ys: [i64], pick: bool) -> [i64] { pick_view(xs, ys, pick) } fn mixed_view(marker: i64, xs: [mut i64]) -> [mut i64] { xs } fn generic_view<T>(xs: [T]) -> [T] { xs } fn call_generic_view(xs: [i64]) -> [i64] { generic_view<i64>(xs) } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let facts = pipeline_ir_semantic_facts(optimised)

  let pick = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("pick_view"), 0, 9)))
  Test.assert_eq(ir_borrow_summary_is_known(pick), 1)
  Test.assert_eq(ir_borrow_summary_param_count_or(pick, 0 - 1), 2)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(pick), 0), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(pick), 1), 1)

  let alias = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("alias_view"), 0, 10)))
  Test.assert_eq(ir_borrow_summary_param_count_or(alias, 0 - 1), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(alias), 0), 1)

  let wrap = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("wrap_view"), 0, 9)))
  Test.assert_eq(ir_borrow_summary_param_count_or(wrap, 0 - 1), 2)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(wrap), 0), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(wrap), 1), 1)

  let mixed_facts = pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("mixed_view"), 0, 10))
  let mixed = ir_borrow_facts_summary(mixed_facts)
  Test.assert_eq(ir_borrow_param_fact_head_or(ir_borrow_facts_params(mixed_facts), 1, 0 - 1), 1)
  Test.assert_eq(ir_borrow_param_fact_mutable_or(ir_borrow_facts_params(mixed_facts), 1, 0 - 1), 1)
  Test.assert_eq(ir_borrow_summary_param_count_or(mixed, 0 - 1), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(mixed), 1), 1)

  let generic_hash = str_hash(__str_ptr("generic_view"), 0, 12)
  let generic = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, generic_hash))
  Test.assert_eq(ir_borrow_summary_param_count_or(generic, 0 - 1), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(generic), 0), 1)
  let type_args = nlist_new()
  nlist_add(type_args, ty_i64())
  let spec = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(facts, mono_spec_hash(generic_hash, type_args)))
  Test.assert_eq(ir_borrow_summary_param_count_or(spec, 0 - 1), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(spec), 0), 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_first_invalid_hash_or(facts, 0), 0)
  Test.assert_eq(pipeline_ir_semantic_borrow_facts_valid(optimised), 1)

  let opaque = "fn opaque_view(f: ([i64]) -> [i64], xs: [i64]) -> [i64] { f(xs) } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_test_check_diag_count(opaque), 1)
}

test "pipeline_borrow_origins_flow_through_calls_and_joins" {
  let program = "effect BorrowTick { fn tick() -> nil } type BorrowViewBox { view: [i64] } type BorrowMethodBox { value: i64 } impl BorrowMethodBox { fn select(self: BorrowMethodBox, xs: [i64]) -[BorrowTick]> [i64] { xs } } fn exact_view(xs: [i64]) -[BorrowTick]> [i64] { xs } fn via_view(xs: [i64]) -[BorrowTick]> [i64] { exact_view(xs) } fn choose_view(xs: [i64], ys: [i64], pick: bool) -> [i64] { if pick { xs } else { ys } } fn generic_view<T>(xs: [T]) -[BorrowTick]> [T] { xs } fn via_generic_view(xs: [i64]) -[BorrowTick]> [i64] { generic_view<i64>(xs) } fn via_method_view(box: BorrowMethodBox, xs: [i64]) -[BorrowTick]> [i64] { box.select(xs) } fn local_record_view(xs: [i64]) -> [i64] { let box = BorrowViewBox { view: xs } box.view } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let facts = pipeline_ir_semantic_facts(optimised)

  let via_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("via_view"), 0, 8)))
  Test.assert_eq(if ir_borrow_value_facts_count_parameter_owner(via_values, 0) >= 2 { 1 } else { 0 }, 1)

  let choose_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("choose_view"), 0, 11)))
  Test.assert_eq(if ir_borrow_value_facts_max_origin_count(choose_values, 0) >= 2 { 1 } else { 0 }, 1)

  let generic_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("via_generic_view"), 0, 16)))
  Test.assert_eq(if ir_borrow_value_facts_count_parameter_owner(generic_values, 0) >= 2 { 1 } else { 0 }, 1)

  let method_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("via_method_view"), 0, 15)))
  Test.assert_eq(if ir_borrow_value_facts_count_parameter_owner(method_values, 1) >= 2 { 1 } else { 0 }, 1)

  let record_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(facts, str_hash(__str_ptr("local_record_view"), 0, 17)))
  Test.assert_eq(if ir_borrow_value_facts_count_parameter_owner(record_values, 0) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_values_complete(optimised), 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_facts_valid(optimised), 1)

  let mutable_program = "fn mutable_local_view(xs: [i64]) -> [i64] { let mut saved = xs saved } fn main() -> i64 { 0 }"
  let mutable_typed = pipeline_check_source_standalone(__str_ptr(mutable_program), __str_len(mutable_program))
  let pre_promotion = pipeline_optimise_typed_ir_pre_promotion(mutable_typed, pipeline_lower_ir(mutable_typed))
  let mutable_values = ir_borrow_facts_values(pipeline_ir_semantic_borrow_fact_find(pipeline_ir_semantic_facts(pre_promotion), str_hash(__str_ptr("mutable_local_view"), 0, 18)))
  Test.assert_eq(if ir_borrow_value_facts_count_parameter_owner(mutable_values, 0) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_values_complete(pre_promotion), 1)
}

