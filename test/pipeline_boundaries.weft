test "pipeline_ir_binary_op_mapping" {
  let plus = ir_binary_op_from_parser(1)
  let unsupported = ir_binary_op_from_parser(20)
  Test.assert_eq(ir_binary_op_tag(plus), ir_binary_op_tag(ir_binary_op_add()))
  Test.assert_eq(ir_binary_op_is_supported(unsupported), 0)
}

test "pipeline_binary_object_wraps_buffer" {
  let buf = buf_new(8)
  let binary = pipeline_binary_object(buf)
  Test.assert_eq(pipeline_binary_buf(binary), buf)
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_unknown())
}

test "pipeline_binary_object_preserves_kind" {
  let buf = buf_new(8)
  let binary = pipeline_binary_object_with_kind(buf, pipeline_binary_kind_macho_object())
  Test.assert_eq(pipeline_binary_buf(binary), buf)
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_macho_object())
}

test "pipeline_emit_native_binary_marks_executable" {
  let src = "fn main() -> i64 { 42 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let binary = pipeline_emit_native_binary(native, __str_ptr(src))
  Test.assert_eq(pipeline_native_binary_format_kind(native), pipeline_binary_kind_macho_executable())
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_macho_executable())
}

test "pipeline_emit_native_binary_marks_object" {
  let fm = fmap_new()
  fmap_add_got_patch(fm, 0, 0)
  let native = pipeline_native_module(buf_new(8), fm, ir_function_list_empty())
  let binary = pipeline_emit_native_binary(native, __str_ptr(""))
  Test.assert_eq(pipeline_native_binary_format_kind(native), pipeline_binary_kind_macho_object())
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_macho_object())
  Test.assert_eq(if buf_len(pipeline_binary_buf(binary)) > 0 { 1 } else { 0 }, 1)
}

test "pipeline_emit_native_binary_rejects_unsupported_format" {
  let fm = fmap_new()
  let native = pipeline_native_module(buf_new(8), fm, ir_function_list_empty())
  let binary = pipeline_emit_native_binary_as(binary_format_unsupported(), native, __str_ptr(""))
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_unknown())
  Test.assert_eq(buf_len(pipeline_binary_buf(binary)), 0)
}

test "pipeline_emit_native_binary_preserves_elf_placeholder_kind" {
  let fm = fmap_new()
  let native = pipeline_native_module(buf_new(8), fm, ir_function_list_empty())
  let exe = pipeline_emit_native_binary_as(binary_format_elf_executable(), native, __str_ptr(""))
  let obj = pipeline_emit_native_binary_as(binary_format_elf_object(), native, __str_ptr(""))
  Test.assert_eq(pipeline_binary_kind(exe), pipeline_binary_kind_elf_executable())
  Test.assert_eq(pipeline_binary_kind(obj), pipeline_binary_kind_elf_object())
  Test.assert_eq(buf_len(pipeline_binary_buf(exe)), 0)
  Test.assert_eq(buf_len(pipeline_binary_buf(obj)), 0)
}
