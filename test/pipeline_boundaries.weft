test "pipeline_ast_type_entries_reifies_side_table_declarations" {
  let src = "type PipelineSideRecord<T> { value: T } type PipelineSideOption { None, Some(i64) } effect PipelineSideLog { fn ping() -> i64 fn put(v: i64) -> i64 } trait PipelineSideTrait { type Item fn value(self: i64) -> i64 } type PipelineSideBox { v: i64 } impl PipelineSideTrait for PipelineSideBox { type Item = i64 fn value(self: i64) -> i64 { self } } fn main() -> i64 { 1 }"
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  Test.assert_eq(type_entry_list_len(entries), 6)
  Test.assert_eq(type_entry_list_raw_bridge_slot_count(entries), 0)
  Test.assert_eq(type_entry_list_tree_raw_bridge_slot_count(entries), 0)
  Test.assert_eq(type_entry_list_count_kind(entries, 0), 2)
  Test.assert_eq(type_entry_list_count_kind(entries, 1), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 2), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 3), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 4), 1)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 0, 0 - 1), 0)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 1, 0 - 1), 1)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 2, 0 - 1), 2)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 3, 0 - 1), 3)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 5, 0 - 1), 4)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 0, 0 - 1), 1)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 1, 0 - 1), 2)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 2, 0 - 1), 2)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 3, 0 - 1), 2)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 5, 0 - 1), 2)
  Test.assert_eq(type_entry_list_nth_type_param_count_or(entries, 0, 0 - 1), 1)
  Test.assert_eq(type_entry_list_nth_type_param_count_or(entries, 5, 0 - 1), 0)
}

