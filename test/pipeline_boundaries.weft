    IrInstNil -> default
    IrInstCons(inst, rest) -> {
      match inst {
        IrClosureI64(dst, f, captures, facts) -> pipeline_ir_function_hash(f)
        _ -> pipeline_test_first_closure_hash_insts(rest, default)
