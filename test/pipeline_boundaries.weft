test "pipeline_ast_migration_metrics_gate_parsed_module" {
  let src = "type PipelineAstGateBox<T> { value: T } type PipelineAstGateOption { None, Some(i64) } effect PipelineAstGateEff { fn get() -> i64 } trait PipelineAstGateTrait { fn value(self: i64) -> i64 } impl PipelineAstGateTrait for PipelineAstGateBox { fn value(self: i64) -> i64 { self } } fn main() -> i64 { let x = 1 x + 41 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let metrics = pipeline_ast_migration_metrics(ast)
  Test.assert_eq(pipeline_ast_migration_decl_count(metrics), 2)
  Test.assert_eq(pipeline_ast_migration_type_entry_count(metrics), 5)
  Test.assert_eq(pipeline_ast_migration_unknown_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_raw_bridge_slot_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_ready(metrics), 1)
}

test "pipeline_ast_migration_metrics_gate_typed_module" {
  let src = "type PipelineTypedGateBox { value: i64 } effect PipelineTypedGateEff { fn get() -> i64 } fn main() -> i64 { handle PipelineTypedGateEff.get() { PipelineTypedGateEff.get() -> resume(40 + 2) } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let metrics = pipeline_typed_ast_migration_metrics(typed)
  Test.assert_gt(pipeline_ast_migration_decl_count(metrics), 0)
  Test.assert_gt(pipeline_ast_migration_type_entry_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_unknown_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_raw_bridge_slot_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_ready(metrics), 1)
}

test "pipeline_ast_migration_metrics_rejects_unknown_facade_shapes" {
  let decls = decl_list_prepend(decl_from_node(0), decl_list_empty())
