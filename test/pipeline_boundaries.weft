test "array_and_slice_type_exprs_round_trip_without_raw_bridges" {
  let fixed = type_expr_from_node(ty_array(ty_i64(), 4))
  let view = type_expr_from_node(ty_slice(ty_str()))
  let mutable_view = type_expr_from_node(ty_mut_slice(ty_bool()))
  let fixed_node = type_expr_to_node(fixed)
  let view_node = type_expr_to_node(view)
  let mutable_node = type_expr_to_node(mutable_view)
  Test.assert_eq(type_expr_tag_or(fixed, 0 - 1), 22)
  Test.assert_eq(type_expr_child_count_or(fixed, 0 - 1), 1)
  Test.assert_eq(type_expr_nth_child_prim_id_or(fixed, 0, 0 - 1), PRIM_I64())
  Test.assert_eq(ty_array_length(fixed_node), 4)
  Test.assert_eq(type_expr_tag_or(view, 0 - 1), 23)
  Test.assert_eq(ty_slice_mutable(view_node), 0)
  Test.assert_eq(ty_f1(ty_slice_inner(view_node)), PRIM_STR())
  Test.assert_eq(ty_slice_mutable(mutable_node), 1)
  Test.assert_eq(ty_f1(ty_slice_inner(mutable_node)), PRIM_BOOL())
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(fixed), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(view), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(mutable_view), 0)
}

test "structural_type_exprs_round_trip_without_raw_bridges" {
  let fields = nlist_new()
  nlist_add(fields, ty_record_field(101, ty_i64(), 7, 5))
  nlist_add(fields, ty_record_field(202, ty_slice(ty_str()), 19, 5))
  let exact = type_expr_from_node(ty_record(fields, 0))
  let open = type_expr_from_node(ty_record(fields, 1))
  let tuple_items = nlist_new()
  nlist_add(tuple_items, ty_bool())
  nlist_add(tuple_items, ty_str())
  let tuple = type_expr_from_node(ty_tuple(tuple_items))
  let exact_node = type_expr_to_node(exact)
  let open_node = type_expr_to_node(open)
  let tuple_node = type_expr_to_node(tuple)

  Test.assert_eq(type_expr_tag_or(exact, 0 - 1), 7)
  Test.assert_eq(type_expr_child_count_or(exact, 0 - 1), 2)
  Test.assert_eq(type_expr_nth_child_tag_or(exact, 0, 0 - 1), 24)
  Test.assert_eq(type_expr_nth_child_tag_or(exact, 1, 0 - 1), 24)
  Test.assert_eq(ty_record_open(exact_node), 0)
  Test.assert_eq(ty_record_open(open_node), 1)
  Test.assert_eq(ty_record_tuple_kind(tuple_node), 1)
  Test.assert_eq(ty_record_field_hash(nlist_get(ty_record_fields(exact_node), 0)), 101)
  Test.assert_eq(ty_f1(ty_record_field_type(nlist_get(ty_record_fields(exact_node), 0))), PRIM_I64())
  Test.assert_eq(ty_slice_mutable(ty_record_field_type(nlist_get(ty_record_fields(exact_node), 1))), 0)
  Test.assert_eq(ty_f1(ty_slice_inner(ty_record_field_type(nlist_get(ty_record_fields(exact_node), 1)))), PRIM_STR())
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(exact), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(open), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(tuple), 0)
}

