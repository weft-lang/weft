fn pipeline_test_parse_count(src: str) -> i64 {
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_ast_fns(ast))
}

fn pipeline_test_check_count(src: str) -> i64 {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_typed_fns(typed))
}

fn pipeline_test_check_diag_count(src: str) -> i64 {
  let diags = nlist_new()
  handle pipeline_check_source_with_diagnostics_standalone(__str_ptr(src), __str_len(src)) {
    Diagnose.report(diagnostic) -> { nlist_add(diags, 1) resume(0) }
    Diagnose.error(msg, span) -> { nlist_add(diags, 1) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, 1) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, 1) resume(0) }
  }
  nlist_len(diags)
}

fn pipeline_test_check_report_code(src: str, expected: str) -> i64 {
  let matched = alloc_zeroed(8)
  handle pipeline_check_source_with_diagnostics_standalone(__str_ptr(src), __str_len(src)) {
    Diagnose.report(diagnostic) -> {
      let code = diagnose_report_code(diagnostic)
      if __str_len(code) == __str_len(expected) and src_eq(__str_ptr(code), 0, __str_len(code), expected) == 1 {
        mem_store64_at(matched, 0, mem_load64_at(matched, 0) + 1)
      } else { 0 }
      resume(0)
    }
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  mem_load64_at(matched, 0)
}

fn pipeline_test_handler_clause(src: str, index: i64) -> HandlerClause {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  handler_clause_list_nth(expr_handle_clauses(expr), index)
}

fn pipeline_test_handler_clause_node(src: str, index: i64) -> i64 {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  match typed {
    TypedModule(fns, checked_src, tt) -> {
      let body = pipeline_first_fn_body_node(fns)
      if node_tag(body) == 33 { nlist_get(node_f2(body), index) } else { 0 }
    }
  }
}

fn pipeline_test_lower_clause_body(src: str, index: i64) -> IrLoweredExpr {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  match typed {
    TypedModule(fns, checked_src, tt) -> {
      let body = pipeline_first_fn_body_node(fns)
      let clause = if node_tag(body) == 33 { nlist_get(node_f2(body), index) } else { 0 }
      let params = node_f2(clause)
      let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), checked_src, tt, pipeline_handler_inline_ctx_empty(), fns, 0)
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(node_f3(clause), nlist_len(params), lower_ctx)
    }
  }
}

fn pipeline_test_append_interp_piece(b: i64, expr: str) -> i64 {
  bstr(b, "{")
  bstr(b, expr)
  bstr(b, "}")
  0
}

fn pipeline_test_append_display_prelude(b: i64) -> i64 {
  bstr(b, "trait DisplayStr { fn display(self: str) -> str } ")
  bstr(b, "impl DisplayStr for str { fn display(self: str) -> str { self } } ")
  bstr(b, "trait DisplayI64 { fn display(self: i64) -> str } ")
  bstr(b, "impl DisplayI64 for i64 { fn display(self: i64) -> str { \"\" } } ")
  0
}

fn pipeline_test_interp_single_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn main() -> str { let name = \"weft\" \"hello ")
  pipeline_test_append_interp_piece(b, "name")
  bstr(b, "\" }")
  b
}

fn pipeline_test_interp_many_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn main() -> str { let a = \"a\" let b = 40 \"")
  pipeline_test_append_interp_piece(b, "a")
  bstr(b, ":")
  pipeline_test_append_interp_piece(b, "b + 2")
  bstr(b, ":ok\" }")
  b
}

fn pipeline_test_interp_arg_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn id_str(s: str) -> str { s } fn main() -> str { let name = \"weft\" id_str(\"hello ")
  pipeline_test_append_interp_piece(b, "name")
  bstr(b, "\") }")
  b
}

fn pipeline_test_lower_buf_functions(b: i64) -> IrFunctionList {
  let typed = pipeline_check_source_standalone(buf_ptr(b), buf_len(b))
  pipeline_ir_functions(pipeline_lower_ir(typed))
}

fn pipeline_test_lower_functions(src: str) -> IrFunctionList {
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  pipeline_ir_functions(pipeline_lower_ir(typed))
}

fn pipeline_test_call_hash_count_insts(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee, args) -> if callee == target { 1 } else { 0 }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> if pipeline_ir_materialise_managed_stake_hash(cleanup_kind, delta) == target { 1 } else { 0 }
        _ -> 0
      }
      one + pipeline_test_call_hash_count_insts(rest, target)
    }
  }
}

fn pipeline_test_call_hash_count_blocks(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> pipeline_test_call_hash_count_insts(insts, target)
      }
      one + pipeline_test_call_hash_count_blocks(rest, target)
    }
  }
}

fn pipeline_test_named_call_hash_count(functions: IrFunctionList, name: str, target: i64) -> i64 {
  let wanted = str_hash(__str_ptr(name), 0, __str_len(name))
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == wanted { pipeline_test_call_hash_count_blocks(blocks, target) }
        else { pipeline_test_named_call_hash_count(rest, name, target) }
      }
    }
  }
}

fn pipeline_test_call_hash_index(insts: IrInstList, target: i64, index: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, callee, args) -> {
        if callee == target { index } else { pipeline_test_call_hash_index(rest, target, index + 1) }
      }
      IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> {
        if pipeline_ir_materialise_managed_stake_hash(cleanup_kind, delta) == target { index } else { pipeline_test_call_hash_index(rest, target, index + 1) }
      }
      _ -> pipeline_test_call_hash_index(rest, target, index + 1)
    }
  }
}

fn pipeline_test_cleanup_closure_call_index(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrClosureI64(dst, f, captures, facts) -> match f {
        IrFunction(hash, nparams, blocks, src) -> match blocks {
          IrBlockListNil -> 0 - 1
          IrBlockListCons(block, remaining) -> match block {
            IrBlock(id, params, body, term) -> pipeline_test_call_hash_index(body, target, 0)
          }
        }
      }
      _ -> pipeline_test_cleanup_closure_call_index(rest, target)
    }
  }
}

fn pipeline_test_provenance_named_location_matches(facts: PipelineNativeProvenanceFactList, name: str, line: i64, col: i64) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          match location {
            PipelineNativeSourceUnknown -> pipeline_test_provenance_named_location_matches(rest, name, line, col)
            PipelineNativeSourceKnown(name_src, name_start, name_len, path_ptr, path_len, actual_line, actual_col) -> {
              if src_eq(name_src, name_start, name_len, name) == 1 and actual_line == line and actual_col == col { 1 }
              else { pipeline_test_provenance_named_location_matches(rest, name, line, col) }
            }
          }
        }
      }
    }
  }
}

fn pipeline_test_provenance_lookup_roundtrips(all: PipelineNativeProvenanceFactList, remaining: PipelineNativeProvenanceFactList) -> i64 {
  match remaining {
    PipelineNativeProvenanceFactNil -> 1
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          if pipeline_native_provenance_lookup_hash_or(all, start + (end - start) / 2, 0) != hash { 0 }
          else { pipeline_test_provenance_lookup_roundtrips(all, rest) }
        }
      }
    }
  }
}

fn pipeline_test_provenance_unframed_count(facts: PipelineNativeProvenanceFactList) -> i64 {
  match facts {
    PipelineNativeProvenanceFactNil -> 0
    PipelineNativeProvenanceFactCons(fact, rest) -> {
      match fact {
        PipelineNativeProvenanceFact(start, end, hash, framed, src, location) -> {
          (if framed == 0 { 1 } else { 0 }) + pipeline_test_provenance_unframed_count(rest)
        }
      }
    }
  }
}

fn pipeline_test_handler_lane_clause_matches(clause: IrHandlerClauseBody, params: i64, continuation: i64, abortive: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  match clause {
    IrHandlerClauseBody(op_hash, actual_params, captures, actual_continuation, actual_abortive, result_cleanup_kind, transferred_param_value_fact, actual_resume_lanes, actual_result_lanes, first_value, blocks) -> {
      if actual_params == params and actual_continuation == continuation and actual_abortive == abortive and actual_resume_lanes == resume_lanes and actual_result_lanes == result_lanes { 1 } else { 0 }
    }
    IrHandlerClauseBodyInvalid(reason) -> 0
  }
}

fn pipeline_test_handler_lane_clause_list_count(clauses: IrHandlerClauseBodyList, params: i64, continuation: i64, abortive: i64, resume_lanes: i64, result_lanes: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(clause, rest) -> {
      pipeline_test_handler_lane_clause_matches(clause, params, continuation, abortive, resume_lanes, result_lanes) +
        pipeline_test_handler_lane_clause_list_count(rest, params, continuation, abortive, resume_lanes, result_lanes)
    }
  }
}

fn pipeline_test_handler_lane_inst_count(insts: IrInstList, params: i64, continuation: i64, abortive: i64, resume_lanes: i64, result_lanes: i64, deferred_result_lanes: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrHandleI64(dst, src, effect_hash, clauses, nclauses, reserved) -> pipeline_test_handler_lane_clause_list_count(clauses, params, continuation, abortive, resume_lanes, result_lanes)
        IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          let body_matches = match body {
            IrDeferredHandlerBody(captures, ops_value, actual_result_lanes, first_value, blocks) -> if actual_result_lanes == deferred_result_lanes { 1 } else { 0 }
            IrDeferredHandlerBodyInvalid(reason) -> 0
          }
          body_matches * pipeline_test_handler_lane_clause_list_count(clauses, params, continuation, abortive, resume_lanes, result_lanes)
        }
        _ -> 0
      }
      add + pipeline_test_handler_lane_inst_count(rest, params, continuation, abortive, resume_lanes, result_lanes, deferred_result_lanes)
    }
  }
}

fn pipeline_test_handler_lane_block_count(blocks: IrBlockList, params: i64, continuation: i64, abortive: i64, resume_lanes: i64, result_lanes: i64, deferred_result_lanes: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let add = match block {
        IrBlock(id, block_params, insts, term) -> pipeline_test_handler_lane_inst_count(insts, params, continuation, abortive, resume_lanes, result_lanes, deferred_result_lanes)
      }
      add + pipeline_test_handler_lane_block_count(rest, params, continuation, abortive, resume_lanes, result_lanes, deferred_result_lanes)
    }
  }
}

fn pipeline_test_handler_lane_count(functions: IrFunctionList, params: i64, continuation: i64, abortive: i64, resume_lanes: i64, result_lanes: i64, deferred_result_lanes: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(name_hash, nparams, blocks, return_float) -> pipeline_test_handler_lane_block_count(blocks, params, continuation, abortive, resume_lanes, result_lanes, deferred_result_lanes) + pipeline_test_handler_lane_count(rest, params, continuation, abortive, resume_lanes, result_lanes, deferred_result_lanes)
      }
    }
  }
}

