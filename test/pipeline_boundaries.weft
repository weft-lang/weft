}

fn pipeline_test_variant_init_payload_count(functions: IrFunctionList, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> match f {
      IrFunction(name_hash, param_count, blocks, src) -> pipeline_test_variant_init_payload_count_blocks(blocks, target) + pipeline_test_variant_init_payload_count(rest, target)
    }
  }
}

fn pipeline_test_variant_init_mask_count_insts(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let add = match inst {
        IrVariantInitI64(dst, tag_hash, payloads, field_mask) -> if field_mask == target { 1 } else { 0 }
        _ -> 0
      }
      add + pipeline_test_variant_init_mask_count_insts(rest, target)
    }
  }
}

fn pipeline_test_variant_init_mask_count_blocks(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> pipeline_test_variant_init_mask_count_insts(insts, target) + pipeline_test_variant_init_mask_count_blocks(rest, target)
    }
  }
}

fn pipeline_test_variant_init_mask_count(functions: IrFunctionList, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> match f {
      IrFunction(name_hash, param_count, blocks, src) -> pipeline_test_variant_init_mask_count_blocks(blocks, target) + pipeline_test_variant_init_mask_count(rest, target)
    }
  }
}

fn pipeline_test_tiny_ir() -> IrModule {
  let insts = ir_inst_list_prepend(ir_inst_const_i64(0, 42), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new(1, 0, block)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_two_block_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 7), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new(0, entry_insts)
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(2, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_branch_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(1))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty()))
  )
  let f = ir_function_new_blocks(3, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_jump_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 9), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new_term(0, entry_insts, ir_term_jump(1))
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(4, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_merge_block_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let then_args = ir_value_list_prepend(1, ir_value_list_empty())
  let else_args = ir_value_list_prepend(2, ir_value_list_empty())
  let merge_params = ir_value_list_prepend(3, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_jump_args(3, then_args))
  let else_block = ir_block_new_term(2, else_insts, ir_term_jump_args(3, else_args))
  let merge = ir_block_new_params(3, merge_params, ir_inst_list_empty(), ir_term_return(3))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(
    then_block,
    ir_block_list_prepend(else_block, ir_block_list_prepend(merge, ir_block_list_empty()))
  )
  )
  let f = ir_function_new_blocks(5, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_variant_read_ir() -> IrModule {
  let insts = ir_inst_list_prepend(
    ir_inst_variant_tag_i64(1, 0),
    ir_inst_list_prepend(ir_inst_variant_payload_i64(2, 0, 0), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(2))
  let f = ir_function_new(6, 1, block)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

