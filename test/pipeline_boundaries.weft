test "checker_and_lowering_publish_checked_index_facts" {
  let slice_program = "fn view_at(xs: [i64], index: usize) -> i64 { xs[index] } fn main() -> i64 { 0 }"
  let slice_typed = pipeline_check_source_standalone(__str_ptr(slice_program), __str_len(slice_program))
