test "pipeline_native_provenance_joins_offsets_names_and_locations" {
  let src = "fn helper() -> i64 { 42 }\nfn main() -> i64 { helper() }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let facts = pipeline_native_provenance_facts(native)
  Test.assert_eq(pipeline_native_provenance_fact_count(facts), pipeline_native_function_count(native))
  Test.assert_eq(pipeline_native_provenance_named_count(facts), 2)
  Test.assert_eq(pipeline_native_provenance_ranges_valid(facts, 0), 1)
  Test.assert_eq(pipeline_test_provenance_lookup_roundtrips(facts, facts), 1)
  Test.assert_eq(pipeline_test_provenance_named_location_matches(facts, "helper", 1, 4), 1)
  Test.assert_eq(pipeline_test_provenance_named_location_matches(facts, "main", 2, 4), 1)
  Test.assert_eq(if pipeline_test_provenance_unframed_count(facts) > 0 { 1 } else { 0 }, 1)
}

test "pipeline_native_provenance_keeps_specialisations_hash_named" {
  let src = "fn id<T>(x: T) -> T { x }\nfn main() -> i64 { id<i64>(42) }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let facts = pipeline_native_provenance_facts(native)
  Test.assert_eq(pipeline_native_provenance_fact_count(facts), 2)
  Test.assert_eq(pipeline_native_provenance_named_count(facts), 1)
  Test.assert_eq(pipeline_native_provenance_ranges_valid(facts, 0), 1)
  Test.assert_eq(pipeline_test_provenance_lookup_roundtrips(facts, facts), 1)
}

test "pipeline_frame_pointer_intrinsic_is_audited" {
  let hash = pipeline_ir_native_hash_name("__frame_pointer")
  Test.assert_eq(hash, 3194462632258943058)
  Test.assert_eq(pipeline_ir_native_intrinsic_kind(hash), 45)
  Test.assert_eq(pipeline_ir_native_intrinsic_arity(45), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(45), 131072)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(45), 1)
}

fn pipeline_test_platform_intrinsic_fact(name: str, expected_kind: i64, expected_arity: i64) -> i64 {
  let kind = pipeline_ir_native_intrinsic_kind(str_hash(__str_ptr(name), 0, __str_len(name)))
  if kind == expected_kind and
    pipeline_ir_native_intrinsic_arity(kind) == expected_arity and
    pipeline_ir_native_intrinsic_clobber_mask(kind) == 0 - 1 and
    pipeline_ir_native_intrinsic_clobbers_pinned(kind) == 1 { 1 } else { 0 }
}

