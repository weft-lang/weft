  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_try_inner_tag_or(expr, 0 - 1), 4)
}

