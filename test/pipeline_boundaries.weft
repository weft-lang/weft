use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"

fn find_main_in_fmap(fm: i64) -> i64 { 0 }
fn compile_object(code: i64, fm: i64, src: i64, ngot: i64) -> i64 { buf_new(0) }

use "compiler/pipeline.weft"

fn pipeline_test_parse_count(src: str) -> i64 {
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_ast_fns(ast))
}

fn pipeline_test_check_count(src: str) -> i64 {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_typed_fns(typed))
}

fn pipeline_test_tiny_ir(code: i64, fm: i64) -> IrModule {
  let insts = ir_inst_list_prepend(ir_inst_const_i64(0, 42), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new(1, 0, block)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_result_with_functions(code, fm, functions)
}

fn pipeline_test_two_block_ir(code: i64, fm: i64) -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 7), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new(0, entry_insts)
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(2, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_result_with_functions(code, fm, functions)
}

fn pipeline_test_branch_ir(code: i64, fm: i64) -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(1))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty()))
  )
  let f = ir_function_new_blocks(3, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_result_with_functions(code, fm, functions)
}

fn pipeline_test_jump_ir(code: i64, fm: i64) -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 9), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new_term(0, entry_insts, ir_term_jump(1))
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(4, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_result_with_functions(code, fm, functions)
}

fn pipeline_test_merge_block_ir(code: i64, fm: i64) -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let then_args = ir_value_list_prepend(1, ir_value_list_empty())
  let else_args = ir_value_list_prepend(2, ir_value_list_empty())
  let merge_params = ir_value_list_prepend(3, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_jump_args(3, then_args))
  let else_block = ir_block_new_term(2, else_insts, ir_term_jump_args(3, else_args))
  let merge = ir_block_new_params(3, merge_params, ir_inst_list_empty(), ir_term_return(3))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(
      then_block,
      ir_block_list_prepend(else_block, ir_block_list_prepend(merge, ir_block_list_empty()))
    )
  )
  let f = ir_function_new_blocks(5, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_result_with_functions(code, fm, functions)
}

test "pipeline_parse_source_single" {
  Test.assert_eq(pipeline_test_parse_count("fn alpha() -> i64 { 1 }"), 1)
}

test "pipeline_parse_source_multiple" {
  Test.assert_eq(pipeline_test_parse_count("fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }"), 2)
}

test "pipeline_check_source_single" {
  Test.assert_eq(pipeline_test_check_count("fn alpha() -> i64 { 1 + 2 }"), 1)
}

test "pipeline_check_variant_decl_with_if_expression" {
  let src = "type PipelineBox { Boxed(i64) } fn inner() -> i64 { if true { 1 } else { 2 } }"
  Test.assert_eq(pipeline_test_check_count(src), 1)
}

test "pipeline_check_module_preserves_functions" {
  let src = "fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let typed = pipeline_check_module(ast)
  Test.assert_eq(nlist_len(pipeline_typed_fns(typed)), 2)
}

test "pipeline_optimise_ir_identity" {
  let ir = pipeline_test_tiny_ir(44, 55)
  let optimised = pipeline_optimise_ir(ir)
  Test.assert_eq(pipeline_ir_code(optimised), pipeline_ir_code(ir))
  Test.assert_eq(pipeline_ir_fmap(optimised), pipeline_ir_fmap(ir))
  Test.assert_eq(pipeline_ir_function_count(optimised), 1)
  Test.assert_eq(pipeline_ir_inst_count(optimised), 1)
}

test "pipeline_ir_empty_sidecar" {
  let ir = pipeline_ir_result(44, 55)
  Test.assert_eq(pipeline_ir_function_count(ir), 0)
  Test.assert_eq(pipeline_ir_inst_count(ir), 0)
}

test "pipeline_ir_tiny_sidecar" {
  let ir = pipeline_test_tiny_ir(44, 55)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(pipeline_ir_inst_count(ir), 1)
  Test.assert_eq(ir_function_list_block_count(pipeline_ir_functions(ir)), 1)
  Test.assert_eq(ir_function_list_count_term_tag(pipeline_ir_functions(ir), 1), 1)
  Test.assert_eq(ir_function_list_first_inst_tag(pipeline_ir_functions(ir)), 1)
  Test.assert_eq(ir_function_list_first_term_tag(pipeline_ir_functions(ir)), 1)
  Test.assert_eq(ir_function_list_first_param_count(pipeline_ir_functions(ir)), 0)
  Test.assert_eq(ir_function_list_first_block_id(pipeline_ir_functions(ir)), 0)
  Test.assert_eq(ir_function_list_first_const_value_or(pipeline_ir_functions(ir), 0), 42)
  Test.assert_eq(ir_function_list_first_term_return_value_or(pipeline_ir_functions(ir), 0 - 1), 0)
}

test "pipeline_ir_multi_block_sidecar" {
  let ir = pipeline_test_two_block_ir(44, 55)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(ir_function_list_block_count(pipeline_ir_functions(ir)), 2)
  Test.assert_eq(ir_function_list_block_param_count(pipeline_ir_functions(ir)), 0)
  Test.assert_eq(pipeline_ir_inst_count(ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(ir), 1), 1)
  Test.assert_eq(ir_function_list_count_term_tag(pipeline_ir_functions(ir), 1), 1)
  Test.assert_eq(ir_function_list_first_block_id(pipeline_ir_functions(ir)), 0)
  Test.assert_eq(ir_function_list_first_const_value_or(pipeline_ir_functions(ir), 0), 7)
}

test "pipeline_ir_branch_terminator_sidecar" {
  let ir = pipeline_test_branch_ir(44, 55)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 3)
  Test.assert_eq(pipeline_ir_inst_count(ir), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 2)
  Test.assert_eq(ir_function_list_first_term_tag(functions), 3)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 1)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 2)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 1)
}

test "pipeline_ir_jump_terminator_empty_args_sidecar" {
  let ir = pipeline_test_jump_ir(44, 55)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 2)
  Test.assert_eq(ir_function_list_block_param_count(functions), 0)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 0)
}

test "pipeline_ir_merge_block_params_sidecar" {
  let ir = pipeline_test_merge_block_ir(44, 55)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 4)
  Test.assert_eq(ir_function_list_block_param_count(functions), 1)
  Test.assert_eq(pipeline_ir_inst_count(ir), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 1)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 2)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 3)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 3)
}

test "pipeline_lower_if_bool_to_ir_sidecar" {
  let src = "fn main() -> i64 { if true { 42 } else { 0 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_first_param_count(functions), 0)
  Test.assert_eq(ir_function_list_block_count(functions), 4)
  Test.assert_eq(ir_function_list_block_param_count(functions), 1)
  Test.assert_eq(ir_function_list_inst_count(functions), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_const_value_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 2)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 3)
}

test "pipeline_lower_if_comparison_to_ir_sidecar" {
  let src = "fn choose(x: i64) -> i64 { if x > 10 { x + 1 } else { 0 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_first_param_count(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 4)
  Test.assert_eq(ir_function_list_block_param_count(functions), 1)
  Test.assert_eq(ir_function_list_inst_count(functions), 5)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 2), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_add()), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_from_parser(8)), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 2)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 6)
}

test "pipeline_lower_nested_if_to_ir_sidecar" {
  let src = "fn main() -> i64 { if true { if true { 1 } else { 2 } } else { 3 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 6)
  Test.assert_eq(ir_function_list_block_param_count(functions), 1)
  Test.assert_eq(ir_function_list_inst_count(functions), 5)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 5)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 3)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 2)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 5)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 5)
}

test "pipeline_lower_let_initializer_if_to_ir_sidecar" {
  let src = "fn main() -> i64 { let x = if true { 1 } else { 2 } x + 1 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 6)
  Test.assert_eq(ir_function_list_block_param_count(functions), 2)
  Test.assert_eq(ir_function_list_inst_count(functions), 5)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 4)
  Test.assert_eq(ir_function_list_count_tag(functions, 2), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 4)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_add()), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 4)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 6)
}

test "pipeline_lower_let_body_if_to_ir_sidecar" {
