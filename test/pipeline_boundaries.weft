  Test.assert_eq(if ir_borrow_value_facts_count_unknown_owner(ir_borrow_facts_values(capture_borrow)) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_ir_semantic_borrow_unknown_owner_count(captured) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_values_complete(captured), 1)
  Test.assert_eq(pipeline_ir_semantic_borrow_facts_valid(captured), 1)
}

