test "typed_lambda_preserves_stable_source_site" {
  let params = nlist_new()
  let raw = node_new(29, params, node_new(1, 7, 0, 0, 0), 0, lambda_ast_metadata(41, 0))
  let roundtrip = expr_to_node(expr_from_node(raw))
  Test.assert_eq(lambda_ast_source_site(node_f4(roundtrip)), 41)
  Test.assert_eq(lambda_ast_par_kind(node_f4(roundtrip)), 0)
  let marked = lambda_ast_metadata_with_par_kind(node_f4(roundtrip), 2)
  Test.assert_eq(lambda_ast_source_site(marked), 41)
  Test.assert_eq(lambda_ast_par_kind(marked), 2)
}

test "parser_records_lambda_arrow_source_site" {
  let src = "fn main() -> i64 { () => 1 }"
  match pipeline_ast_first_body_expr(pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))) {
    Lambda(params, body, source_site) -> Test.assert_eq(source_site, 22)
    _ -> Test.assert_eq(0, 1)
  }
  let single = "fn main() -> i64 { x => x }"
  match pipeline_ast_first_body_expr(pipeline_parse_source_standalone(__str_ptr(single), __str_len(single))) {
    Lambda(params, body, source_site) -> Test.assert_eq(source_site, 21)
    _ -> Test.assert_eq(0, 1)
  }
}

test "lambda_hoist_hash_ignores_allocation_layout" {
  let contents = "fn main() -> i64 { () => 1 }"
  let len = __str_len(contents)
  let first = cg_alloc_bytes(len)
  mem_copy(first, __str_ptr(contents), len)
  let first_tt = ttable_new()
  ttable_register_source(first_tt, first, len, 0, 0)

  -- Force a different allocation address for the otherwise identical source.
  let noise = cg_alloc_bytes(257)
  let second = cg_alloc_bytes(len)
  mem_copy(second, __str_ptr(contents), len)
  let second_tt = ttable_new()
  ttable_register_source(second_tt, second, len, 0, 0)

  let first_hash = pipeline_lambda_hoist_hash(first, first_tt, 22, 0, IrLambdaEvidenceNone)
  let second_hash = pipeline_lambda_hoist_hash(second, second_tt, 22, 0, IrLambdaEvidenceNone)
  Test.assert_eq(first_hash, second_hash)
  Test.assert_eq(if first_hash != pipeline_lambda_hoist_hash(first, first_tt, 23, 0, IrLambdaEvidenceNone) { 1 } else { 0 }, 1)
}

test "source_registry_upgrades_root_path_without_duplicate" {
  let source = "fn main() -> i64 { 0 }"
  let path = "test/source_registry_root.weft"
  let tt = ttable_new()
  let first = ttable_register_source(tt, __str_ptr(source), __str_len(source), 0, 0)
  let upgraded = ttable_register_source(tt, __str_ptr(source), __str_len(source), __str_ptr(path), __str_len(path))
  Test.assert_eq(first, upgraded)
  Test.assert_eq(nlist_len(ttable_sources(tt)), 1)
  Test.assert_eq(mem_load64_at(upgraded + 16, 0), __str_ptr(path))
  Test.assert_eq(mem_load64_at(upgraded + 24, 0), __str_len(path))
  let duplicate = ttable_register_source(tt, __str_ptr(source), __str_len(source), 0, 0)
  Test.assert_eq(duplicate, first)
  Test.assert_eq(nlist_len(ttable_sources(tt)), 1)
}

