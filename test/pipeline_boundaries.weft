test "pipeline generic Par pthread branch enqueues typed work" {
  let functions = pipeline_test_lower_functions("use stdlib/par.{*}
fn main() -> i64 {
  par_with_pthread_pool_i64(2, 8, () => {
    let task = par_spawn<i64>(() => 42)
    par_await<i64>(task)
  })
}")
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "main", pipeline_par_work_pthread_submit_hash()), 1)
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "main", pipeline_par_work_sequential_submit_hash()), 1)
}

test "pipeline preserves generic Par bookkeeping when observation right is dropped" {
  let src = "use stdlib/par.{*}
fn main() -> i64 {
  par_with_sequential_i64(() => {
    let task = par_spawn<i64>(() => 42)
    7
  })
}"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let facts = pipeline_ir_semantic_facts_from_fns(pipeline_typed_fns(typed), 0)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure(facts, pipeline_runtime_par_work_scope_track_hash()), 0)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure(facts, pipeline_runtime_par_work_scope_cleanup_hash()), 0)
  let functions = pipeline_ir_functions(pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed)))
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "main", pipeline_runtime_par_work_scope_track_hash()), 1)
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "main", pipeline_runtime_par_work_scope_cleanup_hash()), 1)
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "main", pipeline_closure_default_release_hash()), 1)
}

test "pipeline preserves managed generic Par cleanup when observation right is dropped" {
  let src = "use runtime/rc_implicit_test.{*}
use stdlib/par.{*}
fn dropped(payload: RuntimeRcProbe) -> i64 {
  par_with_sequential_i64(() => {
    let task = par_spawn<RuntimeRcProbe>(() => payload)
    7
  })
}
fn main() -> i64 { dropped(runtime_rc_probe_new(42)) }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let functions = pipeline_ir_functions(pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed)))
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "dropped", pipeline_runtime_par_work_scope_track_hash()), 1)
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "dropped", pipeline_runtime_par_work_scope_cleanup_hash()), 1)
  Test.assert_eq(pipeline_test_named_call_hash_count(functions, "dropped", pipeline_closure_default_release_hash()), 1)
}

test "pipeline pthread cleanup joins workers before dropping carriers" {
  let cleanup = pipeline_par_pthread_pool_cleanup_closure(10, 11, 12, 0)
  let stop = pipeline_test_cleanup_closure_call_index(cleanup, pipeline_par_pthread_pool_stop_and_join_hash())
  let discard = pipeline_test_cleanup_closure_call_index(cleanup, pipeline_runtime_par_work_scope_cleanup_hash())
  let destroy = pipeline_test_cleanup_closure_call_index(cleanup, pipeline_par_pthread_pool_destroy_hash())
  Test.assert_eq(if stop >= 0 and discard > stop and destroy > discard { 1 } else { 0 }, 1)
}

test "ir_inst_generic_call_i64_reifies_type_arg_payloads" {
  let type_args = nlist_new()
  nlist_add(type_args, ty_i64())
  nlist_add(type_args, ty_bool())
  let inst = ir_inst_generic_call_i64(0, 123, type_args, ir_value_list_empty())
  Test.assert_eq(ir_inst_generic_type_arg_count_or(inst, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_tag_or(inst, 0, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_tag_or(inst, 1, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_prim_id_or(inst, 0, 0 - 1), 0)
  Test.assert_eq(ir_inst_generic_type_arg_prim_id_or(inst, 1, 0 - 1), 2)
}

test "ir_inst_closure_i64_reifies_ordinary_function_without_ast_payload" {
  let f = IrFunction(123, 2, ir_block_list_empty(), 0)
  let facts = ir_lambda_semantic_facts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())
  let inst = ir_inst_closure_i64(0, f, nlist_new(), facts)
  Test.assert_eq(ir_inst_tag(inst), 38)
  Test.assert_eq(ir_inst_lambda_param_count_or(inst, 0 - 1), 1)
  let has_no_evidence = match inst {
    IrClosureI64(dst, body_fn, captures, lambda_facts) -> {
      match ir_lambda_semantic_facts_evidence(lambda_facts) {
        IrLambdaEvidenceNone -> 1
        IrLambdaEvidenceBound(eff_hash, op_hashes, value, frame_value) -> 0
      }
    }
    _ -> 0
  }
  Test.assert_eq(has_no_evidence, 1)
}

test "ir_inst_handle_i64_reifies_lowered_clause_cfg_without_ast_payload" {
  let effect_hash = 42
  let body_block = ir_block_new_term(0, ir_inst_list_empty(), ir_term_return(0))
  let body_blocks = ir_block_list_prepend(body_block, ir_block_list_empty())
  let clause = IrHandlerClauseBody(7, 0, nlist_new(), 1, 0, 0, 0, 1, 1, 0, body_blocks)
  let clauses = IrHandlerClauseBodyCons(clause, IrHandlerClauseBodyNil)
  let inst = ir_inst_handle_i64(0, __str_ptr(""), effect_hash, clauses, 1)
  Test.assert_eq(ir_inst_handle_effect_hash_or(inst, 0 - 1), effect_hash)
  Test.assert_eq(ir_inst_handle_clause_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_list_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_block_count_or(inst, 0, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_has_continuation_or(inst, 0, 0 - 1), 1)
}

