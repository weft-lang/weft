  let item = node_new(2, __str_ptr("item"), __str_len("item"), 0, 0)
  let collection = node_new(2, __str_ptr("items"), __str_len("items"), 0, 0)
  let body = node_new(3, 0, item, node_new(1, 1, 0, 0, 0), 0)
  let for_expr = expr_from_node(node_new(47, __str_ptr("item"), __str_len("item"), collection, body))

  Test.assert_eq(expr_tag(interp_expr), 46)
  Test.assert_eq(expr_interp_left_tag_or(interp_expr, 0 - 1), 9)
  Test.assert_eq(expr_interp_right_tag_or(interp_expr, 0 - 1), 2)
  Test.assert_eq(expr_tree_unknown_count(interp_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(interp_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(interp_expr), 0)

  Test.assert_eq(expr_tag(for_expr), 47)
  Test.assert_eq(expr_for_iter_var_name_len_or(for_expr, 0 - 1), __str_len("item"))
  Test.assert_eq(expr_for_iter_collection_tag_or(for_expr, 0 - 1), 2)
  Test.assert_eq(expr_for_iter_body_tag_or(for_expr, 0 - 1), 3)
  Test.assert_eq(expr_tree_unknown_count(for_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(for_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(for_expr), 0)
}

test "expr_call_args_reifies_direct_call_arguments" {
  let src = "fn main() -> i64 { add(1, 2 + 3) } fn add(x: i64, y: i64) -> i64 { x + y }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  let args = expr_call_args(expr)
  Test.assert_eq(expr_tag(expr), 4)
  Test.assert_eq(expr_call_arg_count_or(expr, 0 - 1), 2)
  Test.assert_eq(expr_list_len(args), 2)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_list_unknown_count(args), 0)
  Test.assert_eq(expr_list_raw_bridge_slot_count(args), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_list_tree_raw_bridge_slot_count(args), 0)
  Test.assert_eq(expr_list_count_tag(args, 1), 1)
  Test.assert_eq(expr_list_count_tag(args, 3), 1)
  Test.assert_eq(expr_list_nth_tag_or(args, 0, 0 - 1), 1)
  Test.assert_eq(expr_list_nth_tag_or(args, 1, 0 - 1), 3)
}

