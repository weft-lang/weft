  let generic_program = "fn replace<T>(initial: T, replacement: T) -> T { let mut xs = [initial, initial] xs[1] = replacement xs[1] } fn use_replace() -> str { replace<str>(\"before\", \"after\") } fn main() -> i64 { 0 }"
