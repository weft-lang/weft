test "checker_and_lowering_publish_indexed_slice_facts" {
  let program = "fn subview(xs: [i64], start: usize, end: usize) -> [i64] { xs[start..end] } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_test_check_diag_count(program), 0)
