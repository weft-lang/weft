test "ir_inst_generic_call_i64_reifies_type_arg_payloads" {
  let type_args = nlist_new()
  nlist_add(type_args, ty_i64())
  nlist_add(type_args, ty_bool())
  let inst = ir_inst_generic_call_i64(0, 123, type_args, ir_value_list_empty())
  Test.assert_eq(ir_inst_generic_type_arg_count_or(inst, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_tag_or(inst, 0, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_tag_or(inst, 1, 0 - 1), 2)
  Test.assert_eq(ir_inst_generic_type_arg_prim_id_or(inst, 0, 0 - 1), 0)
  Test.assert_eq(ir_inst_generic_type_arg_prim_id_or(inst, 1, 0 - 1), 2)
}

test "ir_inst_lambda_i64_reifies_params_and_body_payload" {
  let params = nlist_new()
  nlist_add(params, node_new(2, __str_ptr("x"), __str_len("x"), ty_i64(), 0))
  let body = node_new(2, __str_ptr("x"), __str_len("x"), 0, 0)
  let inst = ir_inst_lambda_i64(0, params, body, 1)
  Test.assert_eq(ir_inst_lambda_param_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_lambda_param_list_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_lambda_body_tag_or(inst, 0 - 1), 2)
}

test "ir_inst_handle_i64_reifies_body_clauses_and_continuation" {
  let clauses = nlist_new()
  let params = nlist_new()
  let name = node_new(0, __str_ptr("PipelineHandleIr"), __str_len("PipelineHandleIr"), __str_ptr("get"), __str_len("get"))
  let cont = node_new(0, __str_ptr("k"), __str_len("k"), 0, 0)
  let clause = node_new(34, name, params, node_new(1, 7, 0, 0, 0), cont)
  nlist_add(clauses, clause)
  let inst = ir_inst_handle_i64(0, __str_ptr(""), node_new(1, 42, 0, 0, 0), clauses, 1)
  Test.assert_eq(ir_inst_handle_body_tag_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_list_count_or(inst, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_body_tag_or(inst, 0, 0 - 1), 1)
  Test.assert_eq(ir_inst_handle_clause_continuation_name_len_or(inst, 0, 0 - 1), __str_len("k"))
}

