  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_param_count(functions), 0)
  Test.assert_eq(ir_function_list_first_block_id(functions), 0)
  Test.assert_eq(ir_function_list_first_inst_tag(functions), 1)
  Test.assert_eq(ir_function_list_first_const_value_or(functions, 0), 42)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 0)
}

test "pipeline_lower_binop_main_to_ir_sidecar" {
  let src = "fn main() -> i64 { 1 + 2 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_inst_count(functions), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 2)
  Test.assert_eq(ir_function_list_count_tag(functions, 2), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_binary_op_or(functions, 0), ir_binary_op_tag(ir_binary_op_add()))
  Test.assert_eq(ir_function_list_first_const_value_or(functions, 0), 1)
}

test "pipeline_lower_nested_binop_main_to_ir_sidecar" {
  let src = "fn main() -> i64 { 1 + 2 * 3 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_inst_count(functions), 5)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 2), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_mul()), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_add()), 1)
  Test.assert_eq(ir_function_list_first_binary_op_or(functions, 0), ir_binary_op_tag(ir_binary_op_mul()))
}

