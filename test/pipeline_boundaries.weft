  Test.assert_eq(type_param_list_nth_var_id_or(type_params, 1, 0 - 1), 1)
  Test.assert_eq(type_param_list_nth_bound_count_or(type_params, 0, 0 - 1), 1)
  Test.assert_eq(type_param_list_nth_bound_count_or(type_params, 1, 0 - 1), 0)
  Test.assert_eq(type_param_list_nth_bound_hash_or(type_params, 0, 0, 0 - 1), expected_bound)
