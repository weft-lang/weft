}

test "pipeline_parse_source_multiple" {
  Test.assert_eq(pipeline_test_parse_count("fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }"), 2)
}

test "pipeline_check_source_single" {
  Test.assert_eq(pipeline_test_check_count("fn alpha() -> i64 { 1 + 2 }"), 1)
}

test "pipeline_check_source_default_rejects_root_raw_memory" {
  let src = "fn main() -> i64 { mem_load64(0) }"
  Test.assert_eq(if pipeline_test_check_diag_count(src) > 0 { 1 } else { 0 }, 1)
}

test "pipeline_check_source_transports_structured_unknown_name" {
  let src = "fn main() -> i64 { misspelled() }"
  Test.assert_eq(pipeline_test_check_diag_count(src), 1)
  Test.assert_eq(pipeline_test_check_report_code(src, "E1001"), 1)
}

test "pipeline_check_variant_decl_with_if_expression" {
  let src = "type PipelineBox { Boxed(i64) } fn inner() -> i64 { if true { 1 } else { 2 } }"
  Test.assert_eq(pipeline_test_check_count(src), 1)
}

test "pipeline_ast_first_body_expr_reifies_literal" {
  let src = "fn main() -> i64 { 42 }"
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  let expr = pipeline_ast_first_body_expr(ast)
  Test.assert_eq(expr_tag(expr), 1)
  Test.assert_eq(expr_int_value_or(expr, 0 - 1), 42)
}

test "pipeline_ast_reifies_array_literal_elements" {
  let src = "fn main() -> [i64; 3] { [1, 2 + 3, 4] }"
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  let expr = pipeline_ast_first_body_expr(ast)
  Test.assert_eq(expr_tag(expr), 58)
  Test.assert_eq(expr_array_element_count_or(expr, 0 - 1), 3)
  Test.assert_eq(expr_array_element_tag_or(expr, 0, 0 - 1), 1)
  Test.assert_eq(expr_array_element_tag_or(expr, 1, 0 - 1), 3)
  Test.assert_eq(expr_array_element_tag_or(expr, 2, 0 - 1), 1)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
}

test "pipeline_ast_array_literal_accepts_newlines_and_trailing_comma" {
  let src = "fn main() -> [i64; 2] { [1,\n2,\n] }"
  let expr = pipeline_ast_first_body_expr(pipeline_parse_source_standalone(__str_ptr(src), __str_len(src)))
  Test.assert_eq(expr_tag(expr), 58)
  Test.assert_eq(expr_array_element_count_or(expr, 0 - 1), 2)
}

test "pipeline_typed_array_literal_infers_homogeneous_type" {
  let src = "fn main() -> i64 { let values = [1, 2, 3] 0 }"
  let body = pipeline_typed_first_body_expr(pipeline_check_source_standalone(__str_ptr(src), __str_len(src)))
  let literal = expr_let_value_or(body, expr_from_node(0))
  let resolved = expr_array_resolved_type_node_or(literal, 0)
  Test.assert_eq(expr_tag(literal), 58)
  Test.assert_true(ty_is_array(resolved))
  Test.assert_eq(ty_array_length(resolved), 3)
  Test.assert_true(ty_eq(ty_array_inner(resolved), ty_i64()))
}

test "pipeline_typed_array_literal_infers_union_type" {
