test "expr_reifier_types_loop_control_children" {
  let cond = node_new(24, 1, 0, 0, 0)
  let lit = node_new(1, 42, 0, 0, 0)
  let body = node_new(3, 0, lit, node_new(1, 2, 0, 0, 0), 0)
  let break_body = node_new(26, lit, 0, 0, 0)
  let while_expr = expr_from_node(node_new(10, cond, body, 0, 0))
  let loop_expr = expr_from_node(node_new(49, break_body, 0, 0, 0))
  let defer_expr = expr_from_node(node_new(52, lit, body, 0, 0))
  Test.assert_eq(expr_tag(while_expr), 10)
  Test.assert_eq(expr_tag(loop_expr), 49)
  Test.assert_eq(expr_tag(defer_expr), 52)
  Test.assert_eq(expr_while_cond_tag_or(while_expr, 0 - 1), 24)
  Test.assert_eq(expr_while_body_tag_or(while_expr, 0 - 1), 3)
  Test.assert_eq(expr_loop_body_tag_or(loop_expr, 0 - 1), 26)
  Test.assert_eq(expr_defer_cleanup_tag_or(defer_expr, 0 - 1), 1)
  Test.assert_eq(expr_defer_body_tag_or(defer_expr, 0 - 1), 3)
  Test.assert_eq(expr_tree_unknown_count(while_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(loop_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(defer_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(while_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(loop_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(defer_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(while_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(loop_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(defer_expr), 0)
}

test "expr_reifier_types_pointer_children" {
  let ptr = node_new(2, __str_ptr("p"), __str_len("p"), 0, 0)
  let value = node_new(3, 0, node_new(1, 1, 0, 0, 0), node_new(1, 2, 0, 0, 0), 0)
  let address_expr = expr_from_node(node_new(55, 1, ptr, 0, 0))
  let deref_expr = expr_from_node(node_new(56, ptr, 0, 0, 0))
  let assign_expr = expr_from_node(node_new(57, ptr, value, 0, 0))
  Test.assert_eq(expr_tag(address_expr), 55)
  Test.assert_eq(expr_tag(deref_expr), 56)
  Test.assert_eq(expr_tag(assign_expr), 57)
  Test.assert_eq(expr_address_target_tag_or(address_expr, 0 - 1), 2)
  Test.assert_eq(expr_deref_ptr_tag_or(deref_expr, 0 - 1), 2)
  Test.assert_eq(expr_ptr_assign_ptr_tag_or(assign_expr, 0 - 1), 2)
  Test.assert_eq(expr_ptr_assign_value_tag_or(assign_expr, 0 - 1), 3)
  Test.assert_eq(expr_tree_unknown_count(address_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(deref_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(assign_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(address_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(deref_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(assign_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(address_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(deref_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(assign_expr), 0)
}

test "expr_reifier_types_sugar_children" {
  let lit = node_new(9, __str_ptr("a"), __str_len("a"), 0, 0)
  let name = node_new(2, __str_ptr("name"), __str_len("name"), 0, 0)
  let interp_expr = expr_from_node(node_new(46, lit, name, 0, 0))

  let item = node_new(2, __str_ptr("item"), __str_len("item"), 0, 0)
  let collection = node_new(2, __str_ptr("items"), __str_len("items"), 0, 0)
  let body = node_new(3, 0, item, node_new(1, 1, 0, 0, 0), 0)
  let for_expr = expr_from_node(node_new(47, __str_ptr("item"), __str_len("item"), collection, body))

  Test.assert_eq(expr_tag(interp_expr), 46)
  Test.assert_eq(expr_interp_left_tag_or(interp_expr, 0 - 1), 9)
  Test.assert_eq(expr_interp_right_tag_or(interp_expr, 0 - 1), 2)
  Test.assert_eq(expr_tree_unknown_count(interp_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(interp_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(interp_expr), 0)

  Test.assert_eq(expr_tag(for_expr), 47)
  Test.assert_eq(expr_for_iter_var_name_len_or(for_expr, 0 - 1), __str_len("item"))
  Test.assert_eq(expr_for_iter_collection_tag_or(for_expr, 0 - 1), 2)
  Test.assert_eq(expr_for_iter_body_tag_or(for_expr, 0 - 1), 3)
  Test.assert_eq(expr_tree_unknown_count(for_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(for_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(for_expr), 0)
}

test "expr_call_args_reifies_direct_call_arguments" {
  let src = "fn main() -> i64 { add(1, 2 + 3) } fn add(x: i64, y: i64) -> i64 { x + y }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  let args = expr_call_args(expr)
  Test.assert_eq(expr_tag(expr), 4)
  Test.assert_eq(expr_call_arg_count_or(expr, 0 - 1), 2)
  Test.assert_eq(expr_list_len(args), 2)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_list_unknown_count(args), 0)
  Test.assert_eq(expr_list_raw_bridge_slot_count(args), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_list_tree_raw_bridge_slot_count(args), 0)
  Test.assert_eq(expr_list_count_tag(args, 1), 1)
  Test.assert_eq(expr_list_count_tag(args, 3), 1)
  Test.assert_eq(expr_list_nth_tag_or(args, 0, 0 - 1), 1)
  Test.assert_eq(expr_list_nth_tag_or(args, 1, 0 - 1), 3)
}

