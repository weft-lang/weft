test "type_entry_type_params_reify_type_and_impl_params" {
  let src = "trait PipelineParamBound { } type PipelineParamRecord<T: PipelineParamBound, U> { left: T, right: U } type PipelineParamBox { value: i64 } impl<V: PipelineParamBound> PipelineParamBox { } fn main() -> i64 { 1 }"
  let expected_bound = effect_name_hash(__str_ptr(src), __str_len("trait "), __str_len("PipelineParamBound"))
  let ast = pipeline_parse_source_standalone(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  let type_params = type_entry_type_params(type_entry_list_nth(entries, 1))
  let impl_params = type_entry_type_params(type_entry_list_nth(entries, 3))
  Test.assert_eq(type_param_list_len(type_params), 2)
  Test.assert_eq(type_param_list_raw_bridge_slot_count(type_params), 0)
  Test.assert_eq(type_param_list_nth_name_len_or(type_params, 0, 0 - 1), __str_len("T"))
  Test.assert_eq(type_param_list_nth_name_len_or(type_params, 1, 0 - 1), __str_len("U"))
  Test.assert_eq(type_param_list_nth_var_id_or(type_params, 0, 0 - 1), 0)
  Test.assert_eq(type_param_list_nth_var_id_or(type_params, 1, 0 - 1), 1)
  Test.assert_eq(type_param_list_nth_bound_count_or(type_params, 0, 0 - 1), 1)
  Test.assert_eq(type_param_list_nth_bound_count_or(type_params, 1, 0 - 1), 0)
  Test.assert_eq(type_param_list_nth_bound_hash_or(type_params, 0, 0, 0 - 1), expected_bound)
  Test.assert_eq(type_param_list_nth_bound_hash_or(type_params, 1, 0, 0 - 1), 0 - 1)
  Test.assert_eq(type_param_list_count_bound_count(type_params, 0), 1)
  Test.assert_eq(type_param_list_count_bound_count(type_params, 1), 1)
  Test.assert_eq(type_param_list_len(impl_params), 1)
  Test.assert_eq(type_param_list_raw_bridge_slot_count(impl_params), 0)
  Test.assert_eq(type_param_list_nth_name_len_or(impl_params, 0, 0 - 1), __str_len("V"))
  Test.assert_eq(type_param_list_nth_bound_count_or(impl_params, 0, 0 - 1), 1)
  Test.assert_eq(type_param_list_nth_bound_hash_or(impl_params, 0, 0, 0 - 1), expected_bound)
}

