test "pipeline_ir_binary_op_mapping" {
  let plus = ir_binary_op_from_parser(1)
  let unsupported = ir_binary_op_from_parser(20)
  Test.assert_eq(ir_binary_op_tag(plus), ir_binary_op_tag(ir_binary_op_add()))
  Test.assert_eq(ir_binary_op_is_supported(unsupported), 0)
}

test "pipeline_binary_object_wraps_buffer" {
  let buf = buf_new(8)
  let binary = pipeline_binary_object(buf)
  Test.assert_eq(pipeline_binary_buf(binary), buf)
}
