test "pipeline_typed_first_body_expr_reifies_try_inner" {
  let src = "effect Fail { fn fail(error: i64) -> i64 } type PipelineFacadeTryResult<T> { Ok(T), Err(i64) } fn main() -[Fail]> i64 { ok(42)? } fn ok(v: i64) -> PipelineFacadeTryResult<i64> { Ok<i64>(v) }"
