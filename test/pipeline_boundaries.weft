use "runtime/memory.weft"
use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/diagnose.weft"

use "compiler/pipeline.weft"

fn pipeline_test_parse_count(src: str) -> i64 {
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_ast_fns(ast))
}

fn pipeline_test_check_count(src: str) -> i64 {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_typed_fns(typed))
}

fn pipeline_test_check_diag_count(src: str) -> i64 {
  let diags = nlist_new()
  handle pipeline_check_source_with_diagnostics(__str_ptr(src), __str_len(src)) {
    Diagnose.error(msg, span) -> { nlist_add(diags, 1) resume(0) }
    Diagnose.warn(msg, span) -> { nlist_add(diags, 1) resume(0) }
    Diagnose.note(msg, span) -> { nlist_add(diags, 1) resume(0) }
  }
  nlist_len(diags)
}

fn pipeline_test_handler_clause(src: str, index: i64) -> HandlerClause {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  handler_clause_list_nth(expr_handle_clauses(expr), index)
}

fn pipeline_test_handler_clause_node(src: str, index: i64) -> i64 {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  match typed {
    TypedModule(fns, checked_src, tt) -> {
      let body = pipeline_first_fn_body_node(fns)
      if node_tag(body) == 33 { nlist_get(node_f2(body), index) } else { 0 }
    }
  }
}

fn pipeline_test_lower_clause_body(src: str, index: i64) -> IrLoweredExpr {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  match typed {
    TypedModule(fns, checked_src, tt) -> {
      let body = pipeline_first_fn_body_node(fns)
      let clause = if node_tag(body) == 33 { nlist_get(node_f2(body), index) } else { 0 }
      let params = node_f2(clause)
      let lower_ctx = pipeline_handler_lower_ctx_with_fns_subst(params, pipeline_value_env_empty(), checked_src, tt, pipeline_handler_inline_ctx_empty(), fns, 0)
      pipeline_lower_expr_node_typed_sidecar_handler_ctx(node_f3(clause), nlist_len(params), lower_ctx)
    }
  }
}

fn pipeline_test_append_interp_piece(b: i64, expr: str) -> i64 {
  bstr(b, "{")
  bstr(b, expr)
  bstr(b, "}")
  0
}

fn pipeline_test_append_display_prelude(b: i64) -> i64 {
  bstr(b, "trait DisplayStr { fn display(self: str) -> str } ")
  bstr(b, "impl DisplayStr for str { fn display(self: str) -> str { self } } ")
  bstr(b, "trait DisplayI64 { fn display(self: i64) -> str } ")
  bstr(b, "impl DisplayI64 for i64 { fn display(self: i64) -> str { \"\" } } ")
  0
}

fn pipeline_test_interp_single_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn main() -> str { let name = \"weft\" \"hello ")
  pipeline_test_append_interp_piece(b, "name")
  bstr(b, "\" }")
  b
}

fn pipeline_test_interp_many_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn main() -> str { let a = \"a\" let b = 40 \"")
  pipeline_test_append_interp_piece(b, "a")
  bstr(b, ":")
  pipeline_test_append_interp_piece(b, "b + 2")
  bstr(b, ":ok\" }")
  b
}

fn pipeline_test_interp_arg_source() -> i64 {
  let b = buf_new(768)
  pipeline_test_append_display_prelude(b)
  bstr(b, "fn id_str(s: str) -> str { s } fn main() -> str { let name = \"weft\" id_str(\"hello ")
  pipeline_test_append_interp_piece(b, "name")
  bstr(b, "\") }")
  b
}

fn pipeline_test_lower_buf_functions(b: i64) -> IrFunctionList {
  let typed = pipeline_check_source(buf_ptr(b), buf_len(b))
  pipeline_ir_functions(pipeline_lower_ir(typed))
}

fn pipeline_test_lower_functions(src: str) -> IrFunctionList {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  pipeline_ir_functions(pipeline_lower_ir(typed))
}

fn pipeline_test_tiny_ir() -> IrModule {
  let insts = ir_inst_list_prepend(ir_inst_const_i64(0, 42), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new(1, 0, block)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_two_block_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 7), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new(0, entry_insts)
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(2, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_branch_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(1))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty()))
  )
  let f = ir_function_new_blocks(3, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_jump_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 9), ir_inst_list_empty())
  let exit_insts = ir_inst_list_empty()
  let entry = ir_block_new_term(0, entry_insts, ir_term_jump(1))
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(0))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(4, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_merge_block_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_const_i64(2, 0), ir_inst_list_empty())
  let then_args = ir_value_list_prepend(1, ir_value_list_empty())
  let else_args = ir_value_list_prepend(2, ir_value_list_empty())
  let merge_params = ir_value_list_prepend(3, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_jump_args(3, then_args))
  let else_block = ir_block_new_term(2, else_insts, ir_term_jump_args(3, else_args))
  let merge = ir_block_new_params(3, merge_params, ir_inst_list_empty(), ir_term_return(3))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(
      then_block,
      ir_block_list_prepend(else_block, ir_block_list_prepend(merge, ir_block_list_empty()))
    )
  )
  let f = ir_function_new_blocks(5, 0, blocks)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

fn pipeline_test_variant_read_ir() -> IrModule {
  let insts = ir_inst_list_prepend(
    ir_inst_variant_tag_i64(1, 0),
    ir_inst_list_prepend(ir_inst_variant_payload_i64(2, 0, 0), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(2))
  let f = ir_function_new(6, 1, block)
  let functions = ir_function_list_prepend(f, ir_function_list_empty())
  pipeline_ir_module(functions)
}

test "pipeline_parse_source_single" {
  Test.assert_eq(pipeline_test_parse_count("fn alpha() -> i64 { 1 }"), 1)
}

test "pipeline_parse_source_multiple" {
  Test.assert_eq(pipeline_test_parse_count("fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }"), 2)
}

test "pipeline_check_source_single" {
  Test.assert_eq(pipeline_test_check_count("fn alpha() -> i64 { 1 + 2 }"), 1)
}

test "pipeline_check_source_default_rejects_root_raw_memory" {
  let src = "fn main() -> i64 { mem_load64(0) }"
  Test.assert_eq(if pipeline_test_check_diag_count(src) > 0 { 1 } else { 0 }, 1)
}

test "pipeline_check_variant_decl_with_if_expression" {
  let src = "type PipelineBox { Boxed(i64) } fn inner() -> i64 { if true { 1 } else { 2 } }"
  Test.assert_eq(pipeline_test_check_count(src), 1)
}

test "pipeline_ast_first_body_expr_reifies_literal" {
  let src = "fn main() -> i64 { 42 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let expr = pipeline_ast_first_body_expr(ast)
  Test.assert_eq(expr_tag(expr), 1)
  Test.assert_eq(expr_int_value_or(expr, 0 - 1), 42)
}

test "pipeline_typed_first_body_expr_reifies_if" {
  let src = "fn main() -> i64 { if true { 1 } else { 2 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  Test.assert_eq(expr_tag(expr), 5)
  Test.assert_eq(expr_unknown_count(expr), 0)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_if_cond_tag_or(expr, 0), 24)
  Test.assert_eq(expr_if_then_tag_or(expr, 0), 1)
  Test.assert_eq(expr_if_else_tag_or(expr, 0), 1)
}

test "pipeline_typed_first_body_expr_reifies_binop_children" {
  let src = "fn main() -> i64 { 1 + 2 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let expr = pipeline_typed_first_body_expr(typed)
  Test.assert_eq(expr_tag(expr), 3)
  Test.assert_eq(expr_unknown_count(expr), 0)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_bin_left_tag_or(expr, 0 - 1), 1)
  Test.assert_eq(expr_bin_right_tag_or(expr, 0 - 1), 1)
}

test "pipeline_typed_first_body_expr_reifies_not_operand" {
