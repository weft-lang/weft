test "expr_reifier_handles_missing_node" {
  let expr = expr_from_node(0)
  Test.assert_eq(expr_tag(expr), 0)
}

test "expr_reifier_types_break_value" {
  let lit = node_new(1, 42, 0, 0, 0)
  let expr = expr_from_node(node_new(26, lit, 0, 0, 0))
  Test.assert_eq(expr_tag(expr), 26)
  Test.assert_eq(expr_tree_unknown_count(expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
  Test.assert_eq(expr_break_value_tag_or(expr, 0 - 1), 1)
}

