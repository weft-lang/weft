  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  -- Dynamic defer now selects the RC runtime for its compiler-generated
  -- cleanup closure. Keep these shape pins scoped to the three user
  -- functions rather than counting the imported runtime module.
  let view = pipeline_ir_function_list_find_hash(functions, str_hash(__str_ptr("defer_view"), 0, 10))
  let returned = pipeline_ir_function_list_find_hash(functions, str_hash(__str_ptr("defer_return"), 0, 12))
  let local = pipeline_ir_function_list_find_hash(functions, str_hash(__str_ptr("defer_local"), 0, 11))
  Test.assert_eq(ir_function_list_block_param_count(view) + ir_function_list_block_param_count(returned) + ir_function_list_block_param_count(local), 12)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(view, 0 - 1), 2)
  Test.assert_eq(ir_function_list_edges_match_block_params(functions), 1)
  Test.assert_eq(ir_function_list_count_tag(view, 42) + ir_function_list_count_tag(returned, 42) + ir_function_list_count_tag(local, 42), 3)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
}

