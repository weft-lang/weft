test "expr_handle_clause_reifies_interp_concat_resume_value" {
  let b = buf_new(1024)
  bstr(b, "effect PipelineClauseInterp { fn put(n: i64) -> str } fn main() -> str { handle PipelineClauseInterp.put(42) { PipelineClauseInterp.put(n) -> resume(\"answer ")
  pipeline_test_append_interp_piece(b, "n")
  bstr(b, "\") } }")
  pipeline_test_append_display_prelude(b)
  let typed = pipeline_check_source(buf_ptr(b), buf_len(b))
  let expr = pipeline_typed_first_body_expr(typed)
  let clauses = expr_handle_clauses(expr)
  let body = handler_clause_body_expr(handler_clause_list_nth(clauses, 0))
  Test.assert_eq(expr_tag(expr), 33)
  Test.assert_eq(handler_clause_list_nth_body_tag_or(clauses, 0, 0 - 1), 35)
  Test.assert_eq(expr_resume_value_tag_or(body, 0 - 1), 46)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(expr), 0)
}

test "expr_handle_clauses_reifies_multiple_clauses_with_params" {
  let src = "effect PipelineClauseState { fn get() -> i64 fn put(v: i64) -> i64 } fn main() -> i64 { handle { PipelineClauseState.put(1); PipelineClauseState.get() } { PipelineClauseState.get() -> resume(2) PipelineClauseState.put(v) -> resume(v) } }"
