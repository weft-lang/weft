  Test.assert_eq(ir_function_list_inst_count(functions), 5)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 4)
  Test.assert_eq(ir_function_list_count_tag(functions, 4), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 3)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 2)
  Test.assert_eq(ir_function_list_first_call_arg_count_or(functions, 0 - 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 4)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(functions, 0 - 1), 0)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 5)
}

test "pipeline_lower_call_then_value_block_to_ir_sidecar" {
  let src = "fn touch(x: i64) -> i64 { x } fn main() -> i64 { touch(1); 42 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 2)
  Test.assert_eq(ir_function_list_inst_count(functions), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 2)
  Test.assert_eq(ir_function_list_count_tag(functions, 4), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 2)
  Test.assert_eq(ir_function_list_first_call_arg_count_or(functions, 0 - 1), 1)
}

test "pipeline_lower_block_with_function_value_call_stays_out_of_ir_sidecar" {
  let src = "fn apply(f: (i64) -> i64) -> i64 { f(1); 2 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 0)
  Test.assert_eq(ir_function_list_inst_count(functions), 0)
}

test "pipeline_lower_block_function_value_call_with_if_arg_stays_out_of_ir_sidecar" {
  let src = "fn apply(f: (i64) -> i64) -> i64 { f(if true { 1 } else { 2 }); 3 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 0)
  Test.assert_eq(ir_function_list_inst_count(functions), 0)
}

test "pipeline_lower_block_if_then_function_value_call_stays_out_of_ir_sidecar" {
  let src = "fn apply(f: (i64) -> i64) -> i64 { if true { 1 } else { 2 }; f(3) }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 0)
  Test.assert_eq(ir_function_list_inst_count(functions), 0)
}

test "pipeline_ir_binary_op_mapping" {
  let plus = ir_binary_op_from_parser(1)
  let unsupported = ir_binary_op_from_parser(20)
  Test.assert_eq(ir_binary_op_tag(plus), ir_binary_op_tag(ir_binary_op_add()))
  Test.assert_eq(ir_binary_op_is_supported(unsupported), 0)
}

test "pipeline_binary_object_wraps_buffer" {
  let buf = buf_new(8)
  let binary = pipeline_binary_object(buf)
  Test.assert_eq(pipeline_binary_buf(binary), buf)
}
