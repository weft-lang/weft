  Test.assert_eq(pipeline_ir_verify_module(array_optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(array_typed, array_optimised)), 0)

  let slice_program = "fn write_view(xs: [mut i64], index: usize, value: i64) -> nil { xs[index] = value } fn main() -> i64 { 0 }"
  let slice_typed = pipeline_check_source_standalone(__str_ptr(slice_program), __str_len(slice_program))
  let slice_set = expr_to_node(pipeline_typed_first_body_expr(slice_typed))
  let slice_fact = node_f4(slice_set)
  Test.assert_eq(node_tag(slice_set), 61)
  Test.assert_eq(type_hash_of(node_f1(slice_fact)), type_hash_of(ty_i64()))
  Test.assert_eq(node_f2(slice_fact), 0 - 1)
  Test.assert_eq(type_hash_of(node_f3(slice_fact)), type_hash_of(ty_mut_slice(ty_i64())))
