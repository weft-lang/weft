  let ir = pipeline_lower_ir(typed)
  Test.assert_eq(pipeline_ir_function_count(ir), 1)
  Test.assert_eq(pipeline_ir_inst_count(ir), 1)
  Test.assert_eq(ir_function_list_first_term_return_value_or(pipeline_ir_functions(ir), 0 - 1), 0)
}

