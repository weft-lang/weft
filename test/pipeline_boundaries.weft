}

test "pipeline_lowers_generic_slice_calls_to_explicit_abi_lanes" {
  let program = "fn keep_view<T>(xs: [T]) -> [T] { xs } fn forward_view(xs: [i64]) -> [i64] { keep_view<i64>(xs) } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  match typed {
    TypedModule(fns, src, tt) -> {
      let pair = pipeline_generic_template_find(fns, src, str_hash(__str_ptr("keep_view"), 0, __str_len("keep_view")))
      let type_args = nlist_new()
      nlist_add(type_args, ty_i64())
      let concrete_params = cg_params_subst(node_f3(pipeline_fn_inner(node_f1(pair))), cg_build_subst(fn_tparams(node_f1(pair)), type_args))
      Test.assert_eq(pipeline_params_value_lane_count(concrete_params), 2)
    }
  }
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(ir_function_list_first_call_arg_count_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_count_tag(functions, 41), 1)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let optimised_functions = pipeline_ir_functions(optimised)
  Test.assert_eq(pipeline_test_function_param_count_matches(optimised_functions, 2), 2)
  Test.assert_eq(ir_function_list_count_tag(optimised_functions, 41), 1)
  Test.assert_eq(ir_function_list_count_tag(optimised_functions, 42), 2)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
}

test "pipeline_carries_slice_values_through_closure_boundaries" {
  let program = "fn capture_view(xs: [i64]) -> [i64] { let f = () => xs f() } fn apply_view(xs: [i64]) -> [i64] { let f = (ys: [i64]) => ys f(xs) } fn choose_captured_view(xs: [i64], ys: [i64], marker: i64, first: bool) -> [i64] { let f = (pick: bool) => if pick { xs } else { if marker > 0 { ys } else { xs } } f(first) } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(pipeline_test_closure_capture_lane_count(functions, 2), 1)
  Test.assert_eq(pipeline_test_closure_capture_lane_count(functions, 5), 1)
  Test.assert_eq(pipeline_test_closure_param_count(functions, 3), 1)
  Test.assert_eq(pipeline_test_indirect_arg_arity_count(functions, 0), 1)
  Test.assert_eq(pipeline_test_indirect_arg_arity_count(functions, 1), 1)
  Test.assert_eq(pipeline_test_indirect_arg_arity_count(functions, 2), 1)
  Test.assert_eq(ir_function_list_count_tag(functions, 41), 3)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)

  let opaque = "fn apply_view_param(f: ([i64]) -> [i64], xs: [i64]) -> [i64] { f(xs) } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_test_check_diag_count(opaque), 1)
}

test "pipeline_carries_fixed_array_handles_through_closure_boundaries" {
  let program = "fn capture_array(xs: [i64; 3]) -> [i64; 3] { let f = () => xs f() } fn escape_array(xs: [i64; 3]) -> () -> [i64; 3] { () => xs } fn generic_array_capture<T>(value: T) -> () -> T { () => value } fn escape_generic_array(xs: [i64; 3]) -> () -> [i64; 3] { generic_array_capture<[i64; 3]>(xs) } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_test_check_diag_count(program), 0)
  let typed = pipeline_check_source_standalone(__str_ptr(program), __str_len(program))
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  Test.assert_eq(cg_managed_drop_kind_for_ty(ty_array(ty_i64(), 3)), continuation_cleanup_kind_rc())
  -- The generic instance and one concrete site share an identical hoisted
  -- body, so the collector deduplicates the three surface lambdas to two.
  Test.assert_eq(pipeline_test_closure_capture_lane_count(functions, 1), 2)
  Test.assert_eq(pipeline_test_closure_param_count(functions, 1), 2)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
}

