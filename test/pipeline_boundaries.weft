  let generic = "type PipelineGenericArrayVariant<T> { PipelineGenericArrayValue(T) } fn pipeline_generic_array_value(xs: [i64; 2]) -> PipelineGenericArrayVariant<[i64; 2] > { PipelineGenericArrayValue<[i64; 2]>(xs) } fn main() -> i64 { 0 }"
  let concrete_typed = pipeline_check_source_standalone(__str_ptr(concrete), __str_len(concrete))
  let generic_typed = pipeline_check_source_standalone(__str_ptr(generic), __str_len(generic))
  let concrete_ir = pipeline_lower_ir(concrete_typed)
  let generic_ir = pipeline_lower_ir(generic_typed)
  Test.assert_eq(pipeline_test_variant_init_mask_count(pipeline_ir_functions(concrete_ir), 4), 1)
  Test.assert_eq(pipeline_test_variant_init_mask_count(pipeline_ir_functions(generic_ir), 4), 1)
  Test.assert_eq(pipeline_ir_verify_module(concrete_ir), 0)
  Test.assert_eq(pipeline_ir_verify_module(generic_ir), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(concrete_typed, pipeline_optimise_typed_ir(concrete_typed, concrete_ir))), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(generic_typed, pipeline_optimise_typed_ir(generic_typed, generic_ir))), 0)
}

