  Test.assert_eq(node_f4(slice_node), 0 - 1)
  Test.assert_eq(pipeline_fns_contains_hash(pipeline_typed_fns(slice_typed), pipeline_runtime_index_address_hash()), 1)
  let slice_ir = pipeline_lower_ir(slice_typed)
  Test.assert_eq(pipeline_ir_verify_module(slice_ir), 0)
  let slice_optimised = pipeline_optimise_typed_ir(slice_typed, slice_ir)
  Test.assert_eq(pipeline_ir_verify_module(slice_optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(slice_typed, slice_optimised)), 0)
  let view_at_hash = str_hash(__str_ptr("view_at"), 0, __str_len("view_at"))
