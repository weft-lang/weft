  nlist_add(type_args, ty_i64())
  let identity_hash = str_hash(__str_ptr("pipeline_nested_identity"), 0, __str_len("pipeline_nested_identity"))
  let identity_spec = mono_spec_hash(identity_hash, type_args)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  Test.assert_eq(if ir_function_list_len(pipeline_ir_function_list_find_hash(pipeline_ir_functions(optimised), identity_spec)) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
}

