  let fixed_typed = pipeline_check_source_standalone(__str_ptr(fixed_program), __str_len(fixed_program))
  let fixed_fact = node_f4(expr_to_node(pipeline_typed_first_body_expr(fixed_typed)))
  Test.assert_eq(type_hash_of(node_f1(fixed_fact)), type_hash_of(ty_str()))
  Test.assert_eq(node_f2(fixed_fact), 4)
  Test.assert_eq(type_hash_of(node_f3(fixed_fact)), type_hash_of(ty_array(ty_str(), 4)))
  Test.assert_eq(pipeline_ir_verify_module(pipeline_lower_ir(fixed_typed)), 0)

  let mutable_program = "fn mutable_subview(xs: [mut i64], start: usize, end: usize) -> [mut i64] { xs[start..end] } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_test_check_diag_count(mutable_program), 0)
  let mutable_typed = pipeline_check_source_standalone(__str_ptr(mutable_program), __str_len(mutable_program))
