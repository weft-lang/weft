}

fn pipeline_test_first_closure_hash_blocks(blocks: IrBlockList, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> {
      let found = match block {
        IrBlock(id, params, insts, term) -> pipeline_test_first_closure_hash_insts(insts, default)
      }
      if found != default { found } else { pipeline_test_first_closure_hash_blocks(rest, default) }
    }
  }
}

