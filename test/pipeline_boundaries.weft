test "expr_reifier_preserves checker-produced resource borrow facts" {
  let owner = node_new(0, 1, 2, 3, 4)
  let fact = node_new(68, owner, 1, ty_borrow_mut(ty_i64()), 0)
  let raw = node_new(2, __str_ptr("token"), __str_len("token"), fact, 0)
  let expr = expr_from_node(raw)
  match expr {
    BorrowIdent(ns, nl, exact_owner, mutable) -> {
      Test.assert_eq(nl, __str_len("token"))
      Test.assert_eq(exact_owner, owner)
      Test.assert_eq(mutable, 1)
    }
    _ -> Test.assert_true(false)
  }
  let roundtrip = expr_to_node(expr)
  Test.assert_eq(node_tag(roundtrip), 2)
  Test.assert_eq(node_tag(node_f3(roundtrip)), 68)
  Test.assert_eq(node_f1(node_f3(roundtrip)), owner)
  Test.assert_eq(node_f2(node_f3(roundtrip)), 1)
}

test "effect_perform_and_handler_forwarding_preserve_exact_resource_borrow_origins" {
  let src = "fn main() -> i64 { let token = make_token() handle BorrowOriginEffect.inspect(token) { BorrowOriginEffect.inspect(value) -> resume(read_token(value)) } } type BorrowOriginToken = opaque i64 effect BorrowOriginEffect { fn inspect(value: borrow BorrowOriginToken) -> i64 } impl Drop for BorrowOriginToken { fn drop(self) -> nil { nil } } fn make_token() -> owned BorrowOriginToken { BorrowOriginToken(1) } fn read_token(value: borrow BorrowOriginToken) -> i64 { 42 }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let root = expr_to_node(pipeline_typed_first_body_expr(typed))
  let handle_node = node_f4(root)
  let perform_node = node_f1(handle_node)
  let perform_arg = nlist_get(node_f4(perform_node), 0)
  let perform_fact = node_f3(perform_arg)
  let clause = nlist_get(node_f2(handle_node), 0)
  let resume_node = node_f3(clause)
  let forward_call = node_f1(resume_node)
  let forward_arg = nlist_get(node_f3(forward_call), 0)
  let forward_fact = node_f3(forward_arg)
  Test.assert_eq(node_tag(root), 6)
  Test.assert_eq(node_tag(handle_node), 33)
  Test.assert_eq(node_tag(perform_node), 32)
  Test.assert_eq(node_tag(perform_fact), 68)
  Test.assert_eq(if node_f1(perform_fact) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(node_f2(perform_fact), 0)
  Test.assert_eq(node_tag(forward_fact), 68)
  Test.assert_eq(if node_f1(forward_fact) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(node_f2(forward_fact), 0)
  Test.assert_eq(ir_function_list_edges_match_block_params(pipeline_test_lower_functions(src)), 1)
}

