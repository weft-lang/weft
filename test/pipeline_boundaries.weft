test "pipeline_ast_decl_list_preserves_multiple_functions" {
  let src = "fn alpha() -> i64 { 1 } fn beta(x: i64) -> i64 { x }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let decls = pipeline_ast_decls(ast)
  Test.assert_eq(decl_list_len(decls), 2)
  Test.assert_eq(decl_list_unknown_count(decls), 0)
  Test.assert_eq(decl_list_tree_unknown_count(decls), 0)
  Test.assert_eq(decl_list_raw_bridge_slot_count(decls), 0)
  Test.assert_eq(decl_list_tree_raw_bridge_slot_count(decls), 0)
  Test.assert_eq(decl_list_count_tag(decls, 23), 2)
  Test.assert_eq(decl_list_nth_tag_or(decls, 0, 0 - 1), 23)
  Test.assert_eq(decl_list_nth_tag_or(decls, 1, 0 - 1), 23)
  Test.assert_eq(decl_list_nth_param_count_or(decls, 0, 0 - 1), 0)
  Test.assert_eq(decl_list_nth_param_count_or(decls, 1, 0 - 1), 1)
  Test.assert_eq(expr_tag(decl_list_nth_body_expr(decls, 0)), 1)
  Test.assert_eq(expr_tag(decl_list_nth_body_expr(decls, 1)), 2)
}

