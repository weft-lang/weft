test "pipeline_newest_platform_leaf_sits_inside_every_sealed_kind_range" {
  -- The sealed `kind >= 47 and kind <= N` ranges have been widened late twice,
  -- at 125 and at 130. A leaf outside them keeps its ABI facts but is treated as
  -- a plain call by residency, which is a miscompile the bootstrap gate cannot
  -- see. Pin all three ranges against the newest leaf directly.
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(143), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobbers_pinned(143), 1)
  let call = IrCallI64(1, pipeline_ir_native_intrinsic_platform_file_chmod_hash(), ir_value_list_prepend(2, ir_value_list_prepend(3, ir_value_list_empty())))
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_cs_simple(call), 0)
}

test "pipeline_native_brk_decoder_is_exact" {
  Test.assert_eq(pipeline_native_brk_reason(encode_brk(0)), 0)
  Test.assert_eq(pipeline_native_brk_reason(encode_brk(20)), 20)
  Test.assert_eq(pipeline_native_brk_reason(encode_brk(65535)), 65535)
  Test.assert_eq(pipeline_native_brk_reason(encode_brk(0) - 1), 0 - 1)
  Test.assert_eq(pipeline_native_brk_reason(encode_brk(65535) + 32), 0 - 1)
  Test.assert_eq(pipeline_native_brk_reason(encode_add_imm(0, 0, 0)), 0 - 1)
}

test "pipeline_native_brks_become_site_specific_fatal_islands" {
  let code = buf_new(64)
  bu32(code, encode_brk(20))
  bu32(code, encode_add_imm(9, 9, 0))
  bu32(code, encode_brk(5))
  Test.assert_eq(pipeline_native_code_brk_count(code, buf_len(code)), 2)
  Test.assert_eq(pipeline_native_materialize_traps(code, 256), 2)
  Test.assert_eq(pipeline_native_code_brk_count(code, buf_len(code)), 0)
  Test.assert_eq(pipeline_native_code_word(code, 0), encode_b(12))
  Test.assert_eq(pipeline_native_code_word(code, 8), encode_b(16))
  Test.assert_eq(pipeline_native_code_word(code, 12), encode_movz(0, 20, 0))
  Test.assert_eq(pipeline_native_code_word(code, 16), encode_movz(1, 0, 0))
  Test.assert_eq(pipeline_native_code_word(code, 20), encode_b(236))
  Test.assert_eq(pipeline_native_code_word(code, 24), encode_movz(0, 5, 0))
  Test.assert_eq(pipeline_native_code_word(code, 28), encode_movz(1, 8, 0))
  Test.assert_eq(pipeline_native_code_word(code, 32), encode_b(224))
}

test "pipeline_native_module_contains_no_signal_only_traps" {
  -- Indexed access selects runtime/panic through the ordinary conditional
  -- prelude binder, giving this compiler-as-data probe the same trap target
  -- a native-producing frontend binds unconditionally.
  let src = "fn main() -> i64 { let values = [42]; values[0] }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  Test.assert_eq(pipeline_native_unmaterialized_trap_count(native), 0)
}

test "pipeline_native_provenance_embeds_versioned_table" {
  let src = "fn helper() -> i64 { 42 }\nfn main() -> i64 { helper() }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let code = pipeline_native_code(native)
  let offset = pipeline_native_provenance_table_offset(native)
  let size = pipeline_native_provenance_table_size(native)
  let table = buf_ptr(code) + offset
  Test.assert_eq(offset % 8, 0)
  Test.assert_eq(offset + size, buf_len(code))
  Test.assert_eq(mem_load64_at(table, 0), pipeline_native_provenance_table_magic())
  Test.assert_eq(mem_load64_at(table, 8), pipeline_native_provenance_table_version())
  Test.assert_eq(mem_load64_at(table, 16), pipeline_native_provenance_fact_count(pipeline_native_provenance_facts(native)))
  Test.assert_eq(mem_load64_at(table, 24), pipeline_native_provenance_table_entry_size())
  Test.assert_eq(mem_load64_at(table, 32), 0)
  Test.assert_eq(mem_load64_at(table, 40), pipeline_native_provenance_table_file_entry_size())
  Test.assert_eq(mem_load64_at(table, 48), offset)
  Test.assert_eq(mem_load64_at(table, 56), size)
}

test "pipeline_native_provenance_object_reset_is_emission_order_safe" {
  let src = "fn main() -> i64 { 0 }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let pos = fmap_native_provenance_adrp_pos(fm)
  pipeline_emit_native_binary_as(binary_format_macho_executable(), native, __str_ptr(src))
  Test.assert_eq(if pipeline_native_code_word(code, pos + 4) != encode_add_imm(17, 17, 0) { 1 } else { 0 }, 1)
  let object = pipeline_emit_native_binary_as(binary_format_macho_object(), native, __str_ptr(src))
  Test.assert_eq(pipeline_binary_kind(object), pipeline_binary_kind_macho_object())
  Test.assert_eq(pipeline_native_code_word(code, pos), encode_adrp(17, 0))
  Test.assert_eq(pipeline_native_code_word(code, pos + 4), encode_add_imm(17, 17, 0))
}

test "pipeline_emit_native_binary_marks_executable" {
  let src = "fn main() -> i64 { 42 }"
  let typed = pipeline_check_source_standalone(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  let binary = pipeline_emit_native_binary(native, __str_ptr(src))
  Test.assert_eq(pipeline_native_binary_format_kind(native), pipeline_binary_kind_macho_executable())
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_macho_executable())
}

test "pipeline_emit_native_binary_marks_object" {
  let fm = fmap_new()
  fmap_add_got_patch(fm, 0, 0)
  let native = pipeline_native_module(buf_new(8), fm, ir_function_list_empty())
  let binary = pipeline_emit_native_binary(native, __str_ptr(""))
  Test.assert_eq(pipeline_native_binary_format_kind(native), pipeline_binary_kind_macho_object())
  Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_macho_object())
