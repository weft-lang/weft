  let slice_node = expr_to_node(pipeline_typed_first_body_expr(typed))
  let fact = node_f4(slice_node)
  Test.assert_eq(node_tag(slice_node), 62)
  Test.assert_eq(type_hash_of(node_f1(fact)), type_hash_of(ty_i64()))
  Test.assert_eq(node_f2(fact), 0 - 1)
  Test.assert_eq(type_hash_of(node_f3(fact)), type_hash_of(ty_slice(ty_i64())))
  Test.assert_eq(node_f4(fact), 0)
