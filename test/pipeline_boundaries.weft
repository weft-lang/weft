  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
  let subview_hash = str_hash(__str_ptr("subview"), 0, __str_len("subview"))
  let borrow = ir_borrow_facts_summary(pipeline_ir_semantic_borrow_fact_find(pipeline_ir_semantic_facts(optimised), subview_hash))
  Test.assert_eq(ir_borrow_summary_is_known(borrow), 1)
  Test.assert_eq(ir_borrow_summary_param_count_or(borrow, 0 - 1), 1)
  Test.assert_eq(ir_value_list_contains(ir_borrow_summary_params(borrow), 0), 1)

  let fixed_program = "fn fixed_subview(xs: [str; 4]) -> [str] { xs[1..3] } fn forward_fixed_subview(xs: [str; 4]) -> [str] { fixed_subview(xs) } fn main() -> i64 { 0 }"
