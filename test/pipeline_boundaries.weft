}

test "pipeline_typed_empty_and_nested_array_literal_facts" {
  let empty_src = "fn main() -> i64 { let values = [] 0 }"
  let empty_body = pipeline_typed_first_body_expr(pipeline_check_source_standalone(__str_ptr(empty_src), __str_len(empty_src)))
  let empty_literal = expr_let_value_or(empty_body, expr_from_node(0))
  let empty_ty = expr_array_resolved_type_node_or(empty_literal, 0)
  Test.assert_eq(ty_array_length(empty_ty), 0)
  Test.assert_true(ty_eq(ty_array_inner(empty_ty), ty_never()))

  let nested_src = "fn main() -> [[u8; 1]; 2] { [[1], [255]] }"
  let nested = pipeline_typed_first_body_expr(pipeline_check_source_standalone(__str_ptr(nested_src), __str_len(nested_src)))
  let nested_ty = expr_array_resolved_type_node_or(nested, 0)
  Test.assert_eq(expr_array_element_count_or(nested, 0 - 1), 2)
  Test.assert_true(ty_is_array(ty_array_inner(nested_ty)))
  Test.assert_eq(ty_array_length(ty_array_inner(nested_ty)), 1)
  Test.assert_true(ty_eq(ty_array_inner(ty_array_inner(nested_ty)), ty_u8()))
}

test "pipeline_typed_array_context_flows_through_control_results" {
  let src = "fn main(flag: bool) -> [[u8; 1]; 2] { [[1], if flag { [2] } else { match flag { true -> [3] false -> [4] } }] }"
