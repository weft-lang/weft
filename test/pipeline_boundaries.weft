  Test.assert_eq(expr_defer_body_tag_or(defer_expr, 0 - 1), 3)
  Test.assert_eq(expr_tree_unknown_count(while_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(loop_expr), 0)
  Test.assert_eq(expr_tree_unknown_count(defer_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(while_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(loop_expr), 0)
  Test.assert_eq(expr_raw_bridge_slot_count(defer_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(while_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(loop_expr), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(defer_expr), 0)
}

