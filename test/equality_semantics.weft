use module_fixtures/compiler_probe.{require_checked}
use compiler/pipeline.{*}
use compiler/backend/aarch64/codegen.{cg_semantic_fact_has_unsafe, cg_semantic_fact_pure, cg_semantic_fact_effect_contract_pure}
use compiler/ir/data.{*}
use compiler/types/algebra.{*}
use compiler/weft/check/body.{typeck_decl_identity_is}

fn equality_semantic_tail(expr: Expr) -> Expr {
  match expr {
    Let(_, _, _, body) -> equality_semantic_tail(body)
    LetTyped(inner, _) -> equality_semantic_tail(inner)
    Block(_, rest) -> equality_semantic_tail(rest)
    _ -> expr
  }
}

test "equality carries its exact canonical method declaration in checked syntax" {
  let source = "use stdlib/eq.{ Eq } type P { value: i64 } fn compare(a: P, b: P) -> bool { a != b } impl Eq for P { fn eq(self, other: Self) -> bool { self.value == other.value } }"
  let checked = require_checked(pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0))
  let body = checked |> pipeline_typed_first_body_expr() |> equality_semantic_tail()
  match body {
    Not(MethodCall(receiver, method, ExprListCons(argument, ExprListNil), reference)) -> {
      Test.assert_true(method_ref_declaration(reference) != 0)
      Test.assert_eq(typeck_decl_identity_is(method_ref_declaration(reference), "stdlib/eq", "eq"), 1)
      match expr_from_node(expr_to_node(body)) {
        Not(MethodCall(_, _, _, restored)) -> Test.assert_eq(method_ref_declaration(restored), method_ref_declaration(reference))
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "private identity generation retains storage dependencies through a pure facade" {
  let source = "use runtime/identity.{ RuntimeIdentity, runtime_identity_new } fn identity_factory() -> RuntimeIdentity { runtime_identity_new() }"
  let checked = require_checked(pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0))
  let lowered = pipeline_lower_ir(checked)
  let ir = pipeline_optimise_typed_ir(checked, lowered)
  let facts = pipeline_ir_semantic_facts(ir)
  let fact = pipeline_ir_semantic_fact_find(facts, pipeline_ir_native_hash_name("identity_factory"))
  Test.assert_true(fact != 0)
  Test.assert_true(cg_semantic_fact_effect_contract_pure(fact) == 1)
  Test.assert_eq(cg_semantic_fact_has_unsafe(fact), 1)
  Test.assert_eq(cg_semantic_fact_pure(fact), 0)
}
