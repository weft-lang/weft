-- A contextual handler body is owned by its implementation source, not by
-- the module that installs it.

use compiler/project/identity.{
  EffectDeclaration,
  EffectOperationDeclaration,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleFunctionIdentity,
  handler_implementation_identity,
  named_module_identity
}
use compiler/project/identity/equality.{handler_implementation_identity_eq, module_identity_eq}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI64,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_id_eq,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{semantic_type_catalog_single}
use compiler/weft/check/body/borrow/facts.{checked_borrow_facts_empty}
use compiler/weft/check/body/closure.{checked_closure_builder}
use compiler/weft/check/body/effects.{
  CheckedHandlerAborts,
  CheckedHandlerClause,
  CheckedHandlerInstall,
  CheckedPerform,
  CheckedDeferredHandlerClause,
  CheckedImmediateHandlerClause,
  checked_effect_builder
}
use compiler/weft/check/body/graph.{
  CheckedBindingId,
  CheckedExprGraphBuilder,
  CheckedImmutableBinding,
  CheckedSourceRange,
  checked_expr_graph_builder,
  checked_expr_graph_builder_in_segment,
  checked_expr_id_from_ordinal,
  checked_expr_segment_id,
  checked_expr_specialization_segment_id
}
use compiler/weft/check/body/handler_product.{*}
use compiler/weft/check/body/pattern.{checked_pattern_graph_builder}
use compiler/weft/check/body/program.{*}
use compiler/weft/check/body/propagation.{checked_propagation_builder}
use compiler/weft/check/resolution/handler_contract.{SemanticHandlerClauseRequirement}
use stdlib/list as list
use stdlib/list.{Cons, List, Nil}
use stdlib/test.{Test}

type HandlerProductCase {
  ValidHandlerProduct,
  ValidCapturedHandlerProduct,
  OrdinaryHandlerSegment,
  ForeignHandlerModule,
  ForeignHandlerSource,
  ForeignHandlerResultType,
  WrongProductAtom,
  MissingRequirement,
  WrongRequiredEffect,
  WrongRequiredOperation,
  WrongRequiredAtom,
  WrongRequiredArity,
  DeferredNotAllowed,
  MissingOperationFormal,
  WrongConstructorFormalType,
  WrongOperationFormal,
  WrongDeferredFormal,
  MissingHandlerRoot,
  WrongHandlerRoot,
  ForeignHandlerParameter,
  ForeignHandlerBorrowFacts
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn publish_parameters(
  graph: owned CheckedExprGraphBuilder,
  parameters: List<CheckedBindingId>
) -> owned CheckedExprGraphBuilder {
  match parameters {
    Nil -> graph
    Cons(binding, rest) -> publish_parameters(graph.function_parameter(binding), rest)
  }
}

fn fixture(case: HandlerProductCase) -> CheckedHandlerBodyResult {
  let module = named_module_identity("fixture/handler_body_owner", 71)
  let caller = named_module_identity("fixture/handler_body_caller", 71)
  let other = named_module_identity("fixture/handler_body_other", 72)
  let source = source_from_text("clause")
  let effect_identity = ModuleDeclarationIdentity(
    module,
    EffectDeclaration,
    source_from_text("E").all()
  )
  let semantic = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (semantic, integer) = semantic.primitive(SemanticI64)
  let (semantic, empty_arguments) = semantic.type_list(Nil<SemanticTypeId>())
  let (semantic, atom) = semantic.effect_atom(effect_identity, empty_arguments)
  let catalog = semantic_type_catalog_single(semantic.freeze())
  let other_semantic = semantic_type_graph_builder(semantic_type_segment_id(other))
  let (other_semantic, foreign_integer) = other_semantic.primitive(SemanticI64)
  let segment = match case {
    OrdinaryHandlerSegment -> checked_expr_segment_id(module)
    _ -> checked_expr_specialization_segment_id(module, 1)
  }
  let expressions = checked_expr_graph_builder_in_segment(segment, source, catalog, 2)
  let patterns = checked_pattern_graph_builder(segment, source, catalog)
  let closures = checked_closure_builder(expressions, 0)
  let propagation = checked_propagation_builder(expressions, 0)
  let function = ModuleFunctionIdentity(module, 0)
  let (expressions, parameter) = match case {
    ForeignHandlerParameter -> expressions.binding(
      ModuleFunctionIdentity(module, 1),
      integer,
      range(0, 1),
      CheckedImmutableBinding
    )
    _ -> expressions.binding(function, integer, range(0, 1), CheckedImmutableBinding)
  }
  let capture_type = match case { WrongConstructorFormalType -> atom, _ -> integer }
  let (expressions, capture) = expressions.binding(
    function,
    capture_type,
    range(0, 1),
    CheckedImmutableBinding
  )
  let (expressions, alternate) = expressions.binding(
    function,
    integer,
    range(0, 1),
    CheckedImmutableBinding
  )
  let (expressions, root) = expressions.integer(1, integer, range(0, 1))
  let (expressions, clause_body) = match case {
    WrongHandlerRoot -> expressions.integer(2, integer, range(1, 2))
    _ -> (expressions, root)
  }
  let operation = MemberDeclarationIdentity(
    effect_identity,
    EffectOperationDeclaration,
    source_from_text("get").all()
  )
  let effects = checked_effect_builder(expressions, 1)
  let requirement_operation = match case {
    WrongRequiredEffect -> MemberDeclarationIdentity(
      ModuleDeclarationIdentity(other, EffectDeclaration, source_from_text("Other").all()),
      EffectOperationDeclaration,
      source_from_text("get").all()
    )
    WrongRequiredOperation -> MemberDeclarationIdentity(
      effect_identity,
      EffectOperationDeclaration,
      source_from_text("put").all()
    )
    _ -> operation
  }
  let required = SemanticHandlerClauseRequirement {
    operation: requirement_operation,
    atom: match case { WrongRequiredAtom -> integer, _ -> atom },
    parameter_count: match case { WrongRequiredArity -> 0, _ -> 1 },
    allows_deferred: match case { WrongDeferredFormal -> true, _ -> false }
  }
  let required_values = [required]
  let requirements = match case {
    MissingRequirement -> Nil<SemanticHandlerClauseRequirement>()
    _ -> list.from_slice(required_values[..])
  }
  let (effects, parameters) = effects.parameter_list()
  let (effects, parameters) = effects.parameter_list_push(expressions, parameters, parameter)
  let (effects, parameters) = effects.finish_parameter_list(parameters)
  let (effects, captures) = effects.parameter_list()
  let (effects, captures) = effects.finish_parameter_list(captures)
  let (effects, clauses) = effects.clause_list()
  let (effects, clauses) = effects.clause_list_push(
    expressions,
    clauses,
    CheckedHandlerClause {
      effect_declaration: effect_identity,
      operation: operation,
      atom: atom,
      parameters: parameters,
      captures: captures,
      continuation: match case {
        DeferredNotAllowed -> CheckedDeferredHandlerClause(parameter)
        WrongDeferredFormal -> CheckedDeferredHandlerClause(parameter)
        _ -> CheckedImmediateHandlerClause
      },
      body: clause_body,
      completion: CheckedHandlerAborts,
      range: range(0, 2)
    }
  )
  let (effects, clauses) = effects.finish_clause_list(clauses)
  let captured_formals = [capture, parameter]
  let operation_formals = [parameter]
  let alternate_formals = [alternate]
  let deferred_formals = [parameter, alternate]
  let formals = match case {
    ValidCapturedHandlerProduct -> list.from_slice(captured_formals[..])
    WrongConstructorFormalType -> list.from_slice(captured_formals[..])
    MissingOperationFormal -> Nil<CheckedBindingId>()
    MissingHandlerRoot -> Nil<CheckedBindingId>()
    WrongOperationFormal -> list.from_slice(alternate_formals[..])
    WrongDeferredFormal -> list.from_slice(deferred_formals[..])
    _ -> list.from_slice(operation_formals[..])
  }
  let expressions = publish_parameters(expressions, formals)
  let expressions = match case {
    MissingHandlerRoot -> expressions
    _ -> expressions.function(function, root)
  }
  let implementation = handler_implementation_identity(
    match case {
      ForeignHandlerModule -> other
      _ -> module
    }
  )
  let constructor_values = [integer]
  checked_handler_body_product(
    CheckedHandlerBodyOrigin {
      implementation: implementation,
      caller: caller,
      source_site: 29,
      source: match case { ForeignHandlerSource -> source_from_text("different"), _ -> source }
    },
    CheckedHandlerBodyContract {
      atom: match case { WrongProductAtom -> integer, _ -> atom },
      constructor_types: match case {
        ValidCapturedHandlerProduct -> list.from_slice(constructor_values[..])
        WrongConstructorFormalType -> list.from_slice(constructor_values[..])
        _ -> Nil<SemanticTypeId>()
      },
      result_type: match case { ForeignHandlerResultType -> foreign_integer, _ -> integer },
      clauses: clauses
    },
    requirements,
    CheckedHandlerBodyGraphs {
      expressions: expressions.freeze(),
      patterns: patterns.freeze(),
      closures: closures.freeze(),
      effects: effects.freeze(),
      propagation: propagation.freeze(),
      borrows: checked_borrow_facts_empty(
        match case {
          ForeignHandlerBorrowFacts -> checked_expr_segment_id(other)
          _ -> segment
        }
      )
    }
  )
}

test "contextual handler product retains the implementation source and caller site" {
  let module = named_module_identity("fixture/handler_body_owner", 71)
  let caller = named_module_identity("fixture/handler_body_caller", 71)
  Test.assert_true(
    match fixture(ValidHandlerProduct) {
      CheckedHandlerBodyAccepted(product) -> {
        let effects = product.effects()
        let expressions = product.expressions()
        let clauses = product.clauses()
        let function = expressions.function(0)
        handler_implementation_identity_eq(
          product.implementation(),
          handler_implementation_identity(module)
        ) and
          module_identity_eq(product.caller(), caller) and
          product.source_site() == 29 and
          product.source().text == "clause" and
          effects.clause_list_len(clauses) == 1 and
          semantic_type_id_eq(
            product.result_type(),
            expressions.result_type(function.root)
          )
      }
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ValidCapturedHandlerProduct) {
      CheckedHandlerBodyAccepted(product) -> product.constructor_types().len() == 1
      _ -> false
    }
  )
}

test "contextual handler product rejects wrong identity source and root ownership" {
  Test.assert_true(
    match fixture(OrdinaryHandlerSegment) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyOrdinarySegment) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ForeignHandlerModule) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyModuleMismatch) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ForeignHandlerSource) {
      CheckedHandlerBodyRejected(CheckedHandlerBodySourceMismatch) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ForeignHandlerResultType) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyResultTypeMissing) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongProductAtom) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyAtomRequired) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(MissingRequirement) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyRequirementCountMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongRequiredEffect) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseEffectMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongRequiredOperation) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseOperationMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongRequiredAtom) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseAtomMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongRequiredArity) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseParameterCountMismatch(0, 0, 1)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(DeferredNotAllowed) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseDeferredMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(MissingOperationFormal) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseFormalCountMismatch(0, 1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongConstructorFormalType) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyConstructorFormalTypeMismatch(0, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongOperationFormal) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseFormalMismatch(0, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongDeferredFormal) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyContinuationFormalMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(MissingHandlerRoot) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseCountMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(WrongHandlerRoot) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseRootMismatch(0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ForeignHandlerParameter) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyClauseParameterOwnerMismatch(0, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match fixture(ForeignHandlerBorrowFacts) {
      CheckedHandlerBodyRejected(CheckedHandlerBodyBorrowRejected(_)) -> true
      _ -> false
    }
  )
}

test "named installation links to one implementation-owned clause segment" {
  let module = named_module_identity("fixture/handler_body_owner", 71)
  let caller = named_module_identity("fixture/handler_body_caller", 71)
  let other = named_module_identity("fixture/handler_body_other", 72)
  match fixture(ValidHandlerProduct) {
    CheckedHandlerBodyAccepted(product) -> {
      let clauses = product.expressions()
      let effects = product.effects()
      let atom = effects.clause_list_at(product.clauses(), 0).atom
      let caller_builder = checked_expr_graph_builder(
        caller,
        source_from_text("with handler"),
        clauses.types(),
        1
      )
      let (caller_builder, body) = caller_builder.integer(1, product.result_type(), range(0, 1))
      let (caller_builder, arguments) = caller_builder.expression_list()
      let (caller_builder, arguments) = caller_builder.finish_expression_list(arguments)
      let (caller_builder, supplied) = caller_builder.expression_list()
      let (caller_builder, supplied) = caller_builder.expression_list_push(supplied, body)
      let (caller_builder, supplied) = caller_builder.finish_expression_list(supplied)
      let (caller_builder, type_arguments) = caller_builder.type_list()
      let (caller_builder, type_arguments) = caller_builder.finish_type_list(type_arguments)
      let caller_graph = caller_builder.freeze()
      let install = CheckedHandlerInstall {
        implementation: product.implementation(),
        clause_segment: clauses.segment(),
        type_arguments: type_arguments,
        arguments: arguments,
        atom: atom,
        caller_function_type: product.result_type(),
        caller_result_type: product.result_type(),
        body: body,
        source_site: product.source_site()
      }
      Test.assert_true(
        match checked_handler_body_link_issue(product, caller_graph, install) {
          nil -> true
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ arguments: supplied }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkConstructorCountMismatch(0, 1) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ implementation: handler_implementation_identity(other) }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkImplementationMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ clause_segment: checked_expr_specialization_segment_id(module, 2) }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkSegmentMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ source_site: 30 }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkSiteMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ atom: product.result_type() }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkAtomMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_handler_body_link_issue(
          product,
          caller_graph,
          install.{ body: checked_expr_id_from_ordinal(checked_expr_segment_id(other), 0) }
        ) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkBodyMissing -> true
            _ -> false
          }
          _ -> false
        }
      )
      let other_builder = checked_expr_graph_builder(
        other,
        source_from_text("elsewhere"),
        clauses.types(),
        1
      )
      let other_graph = other_builder.freeze()
      Test.assert_true(
        match checked_handler_body_link_issue(product, other_graph, install) {
          issue: CheckedHandlerBodyLinkIssue -> match issue {
            CheckedHandlerBodyLinkCallerMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked module composition requires one contextual body per installation" {
  let caller = named_module_identity("fixture/handler_body_caller", 71)
  match fixture(ValidHandlerProduct) {
    CheckedHandlerBodyAccepted(product) -> {
      let clause_graph = product.expressions()
      let source = source_from_text("with handler")
      let builder = checked_expr_graph_builder(caller, source, clause_graph.types(), 1)
      let (builder, body) = builder.integer(1, product.result_type(), range(0, 1))
      let (builder, arguments) = builder.expression_list()
      let (builder, arguments) = builder.finish_expression_list(arguments)
      let (builder, type_arguments) = builder.type_list()
      let (builder, type_arguments) = builder.finish_type_list(type_arguments)
      let effects = checked_effect_builder(builder, 0)
      let install = CheckedHandlerInstall {
        implementation: product.implementation(),
        clause_segment: clause_graph.segment(),
        type_arguments: type_arguments,
        arguments: arguments,
        atom: product.atom(),
        caller_function_type: product.result_type(),
        caller_result_type: product.result_type(),
        body: body,
        source_site: product.source_site()
      }
      let (effects, detail) = effects.handler_install(builder, install)
      let (builder, _) = builder.handler_install(detail, product.result_type(), range(0, 1))
      let expressions = builder.freeze()
      let effects = effects.freeze()
      let one = [product]
      let two = [product, product]
      Test.assert_true(
        match checked_module_handler_links_issue(
          expressions,
          effects,
          list.from_slice(one[..])
        ) {
          nil -> true
          _ -> false
        }
      )
      Test.assert_true(
        match checked_module_handler_links_issue(
          expressions,
          effects,
          Nil<CheckedHandlerBodyProduct>()
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerMissing(1) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match checked_module_handler_links_issue(
          expressions,
          effects,
          list.from_slice(two[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerDuplicate(1) -> true
            _ -> false
          }
          _ -> false
        }
      )
      let empty_builder = checked_expr_graph_builder(caller, source, clause_graph.types(), 0)
      let empty_effect_builder = checked_effect_builder(empty_builder, 0)
      let empty_effects = empty_effect_builder.freeze()
      let empty_graph = empty_builder.freeze()
      Test.assert_true(
        match checked_module_handler_links_issue(
          empty_graph,
          empty_effects,
          list.from_slice(one[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerCountMismatch(0, 1) -> true
            _ -> false
          }
          _ -> false
        }
      )
      let foreign = named_module_identity("fixture/handler_body_foreign", 71)
      let foreign_builder = checked_expr_graph_builder(
        foreign,
        source,
        clause_graph.types(),
        0
      )
      let foreign_effect_builder = checked_effect_builder(foreign_builder, 0)
      let foreign_effects = foreign_effect_builder.freeze()
      Test.assert_true(
        match checked_module_handler_links_issue(
          expressions,
          foreign_effects,
          list.from_slice(one[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleCompanionSegmentMismatch -> true
            _ -> false
          }
          _ -> false
        }
      )
      let malformed_builder = checked_expr_graph_builder(caller, source, clause_graph.types(), 1)
      let (malformed_builder, arguments) = malformed_builder.expression_list()
      let (malformed_builder, arguments) = malformed_builder.finish_expression_list(arguments)
      let clause_effects = product.effects()
      let clause = clause_effects.clause_list_at(product.clauses(), 0)
      let malformed_effects = checked_effect_builder(malformed_builder, 0)
      let (malformed_effects, detail) = malformed_effects.perform(
        malformed_builder,
        CheckedPerform {
          effect_declaration: clause.effect_declaration,
          operation: clause.operation,
          atom: clause.atom,
          arguments: arguments
        }
      )
      let (malformed_builder, _) = malformed_builder.handler_install(
        detail,
        product.result_type(),
        range(0, 1)
      )
      let malformed_graph = malformed_builder.freeze()
      let malformed_effect_graph = malformed_effects.freeze()
      Test.assert_true(
        match checked_module_handler_links_issue(
          malformed_graph,
          malformed_effect_graph,
          list.from_slice(one[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerDetailMismatch(0) -> true
            _ -> false
          }
          _ -> false
        }
      )
      let result_builder = checked_expr_graph_builder(caller, source, clause_graph.types(), 1)
      let (result_builder, result_body) = result_builder.integer(
        1,
        product.result_type(),
        range(0, 1)
      )
      let (result_builder, result_arguments) = result_builder.expression_list()
      let (result_builder, result_arguments) = result_builder.finish_expression_list(
        result_arguments
      )
      let (result_builder, result_types) = result_builder.type_list()
      let (result_builder, result_types) = result_builder.finish_type_list(result_types)
      let result_effects = checked_effect_builder(result_builder, 0)
      let (result_effects, result_detail) = result_effects.handler_install(
        result_builder,
        CheckedHandlerInstall {
          implementation: product.implementation(),
          clause_segment: clause_graph.segment(),
          type_arguments: result_types,
          arguments: result_arguments,
          atom: product.atom(),
          caller_function_type: product.result_type(),
          caller_result_type: product.result_type(),
          body: result_body,
          source_site: product.source_site()
        }
      )
      let (result_builder, _) = result_builder.handler_install(
        result_detail,
        product.atom(),
        range(0, 1)
      )
      let result_graph = result_builder.freeze()
      let result_effect_graph = result_effects.freeze()
      Test.assert_true(
        match checked_module_handler_links_issue(
          result_graph,
          result_effect_graph,
          list.from_slice(one[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerResultMismatch(1) -> true
            _ -> false
          }
          _ -> false
        }
      )
      let wrong_builder = checked_expr_graph_builder(caller, source, clause_graph.types(), 1)
      let (wrong_builder, wrong_body) = wrong_builder.integer(
        1,
        product.result_type(),
        range(0, 1)
      )
      let (wrong_builder, wrong_arguments) = wrong_builder.expression_list()
      let (wrong_builder, wrong_arguments) = wrong_builder.finish_expression_list(
        wrong_arguments
      )
      let (wrong_builder, wrong_types) = wrong_builder.type_list()
      let (wrong_builder, wrong_types) = wrong_builder.finish_type_list(wrong_types)
      let wrong_effects = checked_effect_builder(wrong_builder, 0)
      let (wrong_effects, wrong_detail) = wrong_effects.handler_install(
        wrong_builder,
        CheckedHandlerInstall {
          implementation: product.implementation(),
          clause_segment: clause_graph.segment(),
          type_arguments: wrong_types,
          arguments: wrong_arguments,
          atom: product.atom(),
          caller_function_type: product.result_type(),
          caller_result_type: product.result_type(),
          body: wrong_body,
          source_site: product.source_site() + 1
        }
      )
      let (wrong_builder, _) = wrong_builder.handler_install(
        wrong_detail,
        product.result_type(),
        range(0, 1)
      )
      let wrong_graph = wrong_builder.freeze()
      let wrong_effect_graph = wrong_effects.freeze()
      Test.assert_true(
        match checked_module_handler_links_issue(
          wrong_graph,
          wrong_effect_graph,
          list.from_slice(one[..])
        ) {
          issue: CheckedModuleBodyIssue -> match issue {
            CheckedModuleHandlerLinkRejected(1, CheckedHandlerBodyLinkSiteMismatch) -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}
