-- test/ir_verifier_metrics.weft -- the IR verifier (2o step 0):
-- structural validity of lowered and optimised IR. Positive probes
-- cover the shapes the optimiser campaign exercises; the whole
-- compiler's own optimised IR must verify; hand-built invalid
-- functions pin the error codes.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"
use runtime/unsafe.{*}

fn verifier_probe_lowered(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  pipeline_lower_ir(typed)
}

fn verifier_probe_optimised(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

test "verifier_loop_program_valid" {
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_lowered(src)), 0)
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_optimised(src)), 0)
}

test "verifier_guard_chain_program_valid" {
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, j: i64, key: i64) -> i64 { if j >= 0 and vector_get<i64>(v, j, 0) > key { 1 } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_lowered(src)), 0)
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_optimised(src)), 0)
}

test "verifier_match_program_valid" {
  let src = "use \"stdlib/option.weft\" fn f(flag: i64) -> i64 { let x = option_some<i64>(flag) match x { Some(v) -> v None -> 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_lowered(src)), 0)
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_optimised(src)), 0)
}

test "verifier_sort_program_valid" {
  let src = "use \"stdlib/vector.weft\" fn sortit(items: Vector<i64>) -> Vector<i64> { let len = vector_len<i64>(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  Test.assert_eq(pipeline_ir_verify_module(verifier_probe_optimised(src)), 0)
}

fn verifier_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "verifier_whole_compiler_optimised_ir_valid" {
  -- The strongest tripwire: every function of the compiler itself,
  -- through lowering and the full optimiser, verifies structurally.
  let file = read_file(verifier_path_pair("compiler/main.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_optimise_typed_ir(typed, ir)), 0)
}

test "verifier_catches_undefined_use" {
  -- fn: single block, add uses value 99 which is never defined.
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 5),
    ir_inst_list_prepend(ir_inst_binary_i64(2, ir_binary_op_add(), 1, 99), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(2))
  let f = ir_function_new_src(12345, 1, block, 0)
  -- kind 2, block 0, value 99
  Test.assert_eq(pipeline_ir_verify_function(f), 2000000099)
}

test "verifier_catches_duplicate_definition" {
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 5),
    ir_inst_list_prepend(ir_inst_const_i64(1, 6), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(1))
  let f = ir_function_new_src(12346, 1, block, 0)
  -- kind 1, block 0, value 1
  Test.assert_eq(pipeline_ir_verify_function(f), 1000000001)
}

test "verifier_accepts_explicit_multiword_abi_lanes" {
  let insts = ir_inst_list_prepend(
    ir_inst_call_result_lane_i64(1, 1),
    ir_inst_list_prepend(ir_inst_return_lane_i64(1, 1), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new_src(12355, 1, block, 0)
  Test.assert_eq(pipeline_ir_verify_function(f), 0)
  Test.assert_eq(ir_inst_tag(ir_inst_call_result_lane_i64(1, 1)), 41)
  Test.assert_eq(ir_inst_tag(ir_inst_return_lane_i64(1, 1)), 42)
}

test "verifier_rejects_call_result_lane_without_its_head_definition" {
  let insts = ir_inst_list_prepend(
    ir_inst_call_result_lane_i64(1, 1),
    ir_inst_list_prepend(ir_inst_return_lane_i64(1, 1), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(1))
  let f = ir_function_new_src(12358, 0, block, 0)
  -- A secondary lane is a projection of value dst - lane.  Here value zero,
  -- the call-shaped head, is missing: kind 2, block 0, value 0.
  Test.assert_eq(pipeline_ir_verify_function(f), 2000000000)
}

test "verifier_catches_undefined_multiword_return_lane" {
  let insts = ir_inst_list_prepend(
    ir_inst_return_lane_i64(1, 99),
    ir_inst_list_empty()
  )
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new_src(12356, 1, block, 0)
  -- kind 2, block 0, value 99
  Test.assert_eq(pipeline_ir_verify_function(f), 2000000099)
}

test "verifier_catches_duplicate_multiword_call_result_lane" {
  let insts = ir_inst_list_prepend(
    ir_inst_call_result_lane_i64(1, 1),
    ir_inst_list_empty()
  )
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new_src(12357, 2, block, 0)
  -- kind 1, block 0, value 1
  Test.assert_eq(pipeline_ir_verify_function(f), 1000000001)
}

test "verifier_catches_jump_arg_mismatch" {
  -- block 0 jumps to block 1 with one arg; block 1 declares no params.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 7), ir_inst_list_empty()), ir_term_jump_args(1, ir_value_list_prepend(1, ir_value_list_empty())))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_return(1))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_empty()))
  let f = ir_function_new_blocks_src(12347, 1, blocks, 0)
  -- kind 5, block 0, target 1
  Test.assert_eq(pipeline_ir_verify_function(f), 5000000001)
}

test "verifier_catches_intra_block_use_before_def" {
  -- Same block, add at index 0 uses value 2 which is defined at index 1.
  let insts = ir_inst_list_prepend(
    ir_inst_binary_i64(3, ir_binary_op_add(), 2, 2),
    ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(3))
  let f = ir_function_new_src(12349, 1, block, 0)
  -- kind 6, block 0, value 2
  Test.assert_eq(pipeline_ir_verify_function(f), 6000000002)
}

test "verifier_catches_branch_local_def_used_in_merge" {
  -- b0 branches to b1/b2; b1 defines v2; both jump to b3 which uses v2.
  -- b1 does not dominate b3: kind 7. This is the exact shape of the LICM
  -- chain-hoist miscompile that the verifier previously could not see.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 1), ir_inst_list_empty()), ir_term_branch(1, 1, 2))
  let b1 = ir_block_new_term(1, ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty()), ir_term_jump(3))
  let b2 = ir_block_new_term(2, ir_inst_list_empty(), ir_term_jump(3))
  let b3 = ir_block_new_term(3, ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 2, 2), ir_inst_list_empty()), ir_term_return(3))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let f = ir_function_new_blocks_src(12350, 1, blocks, 0)
  -- kind 7, block 3, value 2
  Test.assert_eq(pipeline_ir_verify_function(f), 7003000002)
}

test "verifier_catches_undominated_jump_arg" {
  -- Same diamond, but the undominated value flows as a jump ARGUMENT
  -- from b2 (which never defined it): kind 7 at the jump source.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 1), ir_inst_list_empty()), ir_term_branch(1, 1, 2))
  let b1 = ir_block_new_term(1, ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty()), ir_term_jump_args(3, ir_value_list_prepend(2, ir_value_list_empty())))
  let b2 = ir_block_new_term(2, ir_inst_list_empty(), ir_term_jump_args(3, ir_value_list_prepend(2, ir_value_list_empty())))
  let b3 = ir_block_new_params(3, ir_value_list_prepend(3, ir_value_list_empty()), ir_inst_list_empty(), ir_term_return(3))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let f = ir_function_new_blocks_src(12351, 1, blocks, 0)
  -- kind 7, block 2, value 2
  Test.assert_eq(pipeline_ir_verify_function(f), 7002000002)
}

test "verifier_accepts_dominating_def_through_diamond" {
  -- v2 defined in the entry dominates both arms and the merge: valid.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 1), ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty())), ir_term_branch(1, 1, 2))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_jump(3))
  let b2 = ir_block_new_term(2, ir_inst_list_empty(), ir_term_jump(3))
  let b3 = ir_block_new_term(3, ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 2, 2), ir_inst_list_empty()), ir_term_return(3))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let f = ir_function_new_blocks_src(12352, 1, blocks, 0)
  Test.assert_eq(pipeline_ir_verify_function(f), 0)
}

test "verifier_accepts_entry_def_used_in_loop_body" {
  -- Loop: b0 -> b1 (header) -> b2 (body, uses entry def, back to b1) / b3.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 4), ir_inst_list_prepend(ir_inst_const_i64(2, 1), ir_inst_list_empty())), ir_term_jump(1))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_branch(2, 2, 3))
  let b2 = ir_block_new_term(2, ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 1, 1), ir_inst_list_empty()), ir_term_jump(1))
  let b3 = ir_block_new_term(3, ir_inst_list_empty(), ir_term_return(1))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let f = ir_function_new_blocks_src(12353, 1, blocks, 0)
  Test.assert_eq(pipeline_ir_verify_function(f), 0)
}

test "verifier_catches_loop_body_def_used_in_exit" {
  -- The body's def does not dominate the exit (the header can leave
  -- without entering the body on iteration zero): kind 7.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 4), ir_inst_list_empty()), ir_term_jump(1))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_branch(1, 2, 3))
  let b2 = ir_block_new_term(2, ir_inst_list_prepend(ir_inst_const_i64(2, 9), ir_inst_list_empty()), ir_term_jump(1))
  let b3 = ir_block_new_term(3, ir_inst_list_empty(), ir_term_return(2))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let f = ir_function_new_blocks_src(12354, 1, blocks, 0)
  -- kind 7, block 3, value 2 (the return use)
  Test.assert_eq(pipeline_ir_verify_function(f), 7003000002)
}

test "verifier_catches_missing_target" {
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 7), ir_inst_list_empty()), ir_term_jump(9))
  let blocks = ir_block_list_prepend(b0, ir_block_list_empty())
  let f = ir_function_new_blocks_src(12348, 1, blocks, 0)
  -- kind 4, block 0, target 9
  Test.assert_eq(pipeline_ir_verify_function(f), 4000000009)
}
