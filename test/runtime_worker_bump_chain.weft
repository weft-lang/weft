use stdlib/result
use runtime/alloc_test.{runtime_alloc_worker_one_growth_links, runtime_alloc_worker_two_growth_links}
use stdlib/par as par

test "worker scratch growth retains its initial segment bounds" {
  let result = par.with_pool(par.pool_config(1, 1).unwrap(), () => {
    let worker = par.fork(runtime_alloc_worker_one_growth_links)
    worker.join()
  })
  Test.assert_eq(result, 42)
}

test "successive worker scratch mappings retain an ordered ownership chain" {
  let result = par.with_pool(par.pool_config(1, 1).unwrap(), () => {
    let worker = par.fork(runtime_alloc_worker_two_growth_links)
    worker.join()
  })
  Test.assert_eq(result, 42)
}
