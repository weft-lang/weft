use "runtime/alloc.weft"
--
-- Rebaselined to the typed-IR backend (2026-07-09). Elision counts moved with
-- the typed managed-reference lowering; zeroed entries mark elisions the typed
-- path does not perform yet (see 2k brief).
use "runtime/memory.weft"
-- test/rc_elision_metrics.weft -- native evidence for local RC retain/release elision

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn rc_metric_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn rc_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = mem_load64(fm + 8)
  let d = mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn rc_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if rc_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn rc_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn rc_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = rc_metric_native(src)
  rc_metric_native_call_sites(native, fn_name, target_name)
}

fn rc_metric_native_call_sites(native: NativeModule, fn_name: str, target_name: str) -> i64 {
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = rc_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  rc_metric_count_bl_to_target(code, off, end, target)
}

fn rc_metric_main_retains(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "rc_default_retain")
}

fn rc_metric_native_main_retains(native: NativeModule) -> i64 {
  rc_metric_native_call_sites(native, "main", "rc_default_retain")
}

fn rc_metric_main_releases(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "rc_default_release")
}

fn rc_metric_native_main_releases(native: NativeModule) -> i64 {
  rc_metric_native_call_sites(native, "main", "rc_default_release")
}

fn rc_metric_main_closure_retains(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "closure_default_retain")
}

fn rc_metric_native_main_closure_retains(native: NativeModule) -> i64 {
  rc_metric_native_call_sites(native, "main", "closure_default_retain")
}

fn rc_metric_main_closure_releases(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "closure_default_release")
}

fn rc_metric_native_main_closure_releases(native: NativeModule) -> i64 {
  rc_metric_native_call_sites(native, "main", "closure_default_release")
}

fn rc_metric_elisions(src: str) -> i64 {
  pipeline_native_rc_elision_count(rc_metric_native(src))
}

fn rc_metric_elision_enabled(src: str) -> i64 {
  pipeline_native_rc_elision_enabled(rc_metric_native(src))
}

fn rc_metric_native_elision_enabled(native: NativeModule) -> i64 {
  pipeline_native_rc_elision_enabled(native)
}

fn rc_metric_borrowable_param_facts(src: str) -> i64 {
  pipeline_native_rc_borrowable_param_fact_count(rc_metric_native(src))
}

fn rc_metric_native_borrowable_param_facts(native: NativeModule) -> i64 {
  pipeline_native_rc_borrowable_param_fact_count(native)
}

fn rc_metric_native_managed_drop_specializations(native: NativeModule) -> i64 {
  pipeline_native_managed_drop_specialization_count(native)
}

fn rc_metric_native_rc_drop_specializations(native: NativeModule) -> i64 {
  pipeline_native_rc_drop_specialization_count(native)
}

fn rc_metric_native_closure_drop_specializations(native: NativeModule) -> i64 {
  pipeline_native_closure_drop_specialization_count(native)
}

fn rc_metric_native_elisions(native: NativeModule) -> i64 {
  pipeline_native_rc_elision_count(native)
}

fn rc_elision_alias_value() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 55)
  let q: rc i64 = p
  mem_load64(q)
}

fn rc_elision_alias_closure() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 56)
  let q: rc i64 = p
  () => mem_load64(q)
}

fn rc_elision_borrowed_call_value(p: rc i64) -> i64 {
  mem_load64(p)
}

fn rc_elision_borrowed_call_sum(a: rc i64, b: rc i64) -> i64 {
  mem_load64(a) + mem_load64(b)
}

fn rc_elision_borrowed_closure_call(f: () -> i64) -> i64 {
  f()
}

fn rc_elision_borrowed_managed_call(p: rc i64, f: () -> i64) -> i64 {
  mem_load64(p) + f()
}

fn rc_elision_reallocs_same_zeroed(addr: i64, payload_size: i64) -> i64 {
  let again: rc i64 = rc_default_alloc(payload_size, 8)
  if again == addr {
    if mem_load64(again) == 0 { 1 } else { 0 }
  } else { 0 }
}

fn rc_elision_addr(p: rc i64) -> i64 {
  p
}

fn rc_elision_alias_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 61)
  let addr = rc_elision_addr(p)
  let q: rc i64 = p
  if mem_load64(q) == 61 { addr } else { 0 }
}

fn rc_elision_alias_defer_scope_addr() -> i64 {
  let arena = arena_new(64)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(log, 0)
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 62)
  let addr = rc_elision_addr(p)
  let q: rc i64 = p
  defer mem_store64(log, mem_load64(q))
  if mem_load64(q) == 62 { addr } else { 0 }
}

fn rc_elision_borrowed_call_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 63)
  let addr = rc_elision_addr(p)
  if rc_elision_borrowed_call_value(p) == 63 { addr } else { 0 }
}

fn rc_elision_borrowed_call_twice_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 64)
  let addr = rc_elision_addr(p)
  let first = rc_elision_borrowed_call_value(p)
  let second = rc_elision_borrowed_call_value(p)
  if first + second == 128 { addr } else { 0 }
}

fn rc_elision_captured_alias_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 65)
  let addr = rc_elision_addr(p)
  let q: rc i64 = p
  let f = () => mem_load64(q)
  if f() == 65 { addr } else { 0 }
}

fn rc_elision_closure_alias_value() -> i64 {
  let f = () => 66
  let g = f
  g()
}

fn rc_elision_closure_alias_returned() -> () -> i64 {
  let f = () => 67
  let g = f
  g
}

test "rc_elision_local_alias_removes_retain_release_pair" {
  let src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 42) let q: rc i64 = p mem_load64(q) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elision_enabled(native), 1)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_releases(native), 0)
}

test "rc_elision_returned_alias_keeps_return_ownership" {
  let src = "fn make() -> rc i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = p q } fn main() -> i64 { let r: rc i64 = make() if r != 0 { 1 } else { 0 } }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_call_sites(native, "make", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_native_call_sites(native, "make", "rc_default_release"), 0)
}

test "rc_elision_closure_capture_keeps_capture_retain" {
  let src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 51) let q: rc i64 = p let f = () => mem_load64(q) f() }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_releases(native), 0)
}

test "rc_elision_closure_alias_removes_retain_release_pair" {
  let src = "fn main() -> i64 { let f = () => 66 let g = f g() }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elision_enabled(native), 1)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_releases(native), 0)
}

test "rc_elision_returned_closure_alias_keeps_return_ownership" {
  let src = "fn make() -> () -> i64 { let f = () => 67 let g = f g } fn main() -> i64 { let h = make() h() }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_call_sites(native, "make", "closure_default_retain"), 0)
  Test.assert_eq(rc_metric_native_call_sites(native, "make", "closure_default_release"), 0)
}

test "rc_elision_local_alias_static_pair_invariant" {
  let optimised = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 42) let q: rc i64 = p mem_load64(q) }"
  let baseline = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 42) let q: rc i64 = p mem_load64(q) } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  let opt_native = rc_metric_native(optimised)
  let base_native = rc_metric_native(baseline)
  Test.assert_eq(rc_metric_native_elision_enabled(opt_native), 1)
  Test.assert_eq(rc_metric_native_elision_enabled(base_native), 0)
  Test.assert_eq(rc_metric_native_elisions(opt_native), rc_metric_native_main_retains(base_native) - rc_metric_native_main_retains(opt_native))
  Test.assert_eq(rc_metric_native_elisions(opt_native), rc_metric_native_main_releases(base_native) - rc_metric_native_main_releases(opt_native))
}

test "rc_elision_local_alias_static_control_flow_pair_matrix" {
  let opt_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 44) let q: rc i64 = p if true { mem_load64(q) } else { 0 } }"
  let base_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 44) let q: rc i64 = p if true { mem_load64(q) } else { 0 } } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  let opt_if_native = rc_metric_native(opt_if)
  let base_if_native = rc_metric_native(base_if)
  Test.assert_eq(rc_metric_native_elisions(opt_if_native), rc_metric_native_main_retains(base_if_native) - rc_metric_native_main_retains(opt_if_native))
  Test.assert_eq(rc_metric_native_elisions(opt_if_native), rc_metric_native_main_releases(base_if_native) - rc_metric_native_main_releases(opt_if_native))

  let opt_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> mem_load64(q) _ -> 0 } }"
  let base_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> mem_load64(q) _ -> 0 } } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  let opt_match_native = rc_metric_native(opt_match)
  let base_match_native = rc_metric_native(base_match)
  Test.assert_eq(rc_metric_native_elisions(opt_match_native), rc_metric_native_main_retains(base_match_native) - rc_metric_native_main_retains(opt_match_native))
  Test.assert_eq(rc_metric_native_elisions(opt_match_native), rc_metric_native_main_releases(base_match_native) - rc_metric_native_main_releases(opt_match_native))

  let opt_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = mem_load64(q) } n }"
  let base_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = mem_load64(q) } n } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  let opt_loop_native = rc_metric_native(opt_loop)
  let base_loop_native = rc_metric_native(base_loop)
  Test.assert_eq(rc_metric_native_elisions(opt_loop_native), rc_metric_native_main_retains(base_loop_native) - rc_metric_native_main_retains(opt_loop_native))
  Test.assert_eq(rc_metric_native_elisions(opt_loop_native), rc_metric_native_main_releases(base_loop_native) - rc_metric_native_main_releases(opt_loop_native))
}

test "rc_elision_direct_call_borrows_single_param" {
  let src = "fn borrow_read(p: rc i64) -> i64 { mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 43) borrow_read(p) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_releases(native), 0)
}

test "rc_elision_direct_call_borrows_multiple_params" {
  let src = "fn borrow_sum(a: rc i64, b: rc i64) -> i64 { mem_load64(a) + mem_load64(b) } fn main() -> i64 { let a: rc i64 = rc_default_alloc(8, 8) let b: rc i64 = rc_default_alloc(8, 8) borrow_sum(a, b) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_releases(native), 0)
}

test "rc_elision_direct_call_borrows_closure_param" {
  let src = "fn call_closure(f: () -> i64) -> i64 { f() } fn main() -> i64 { let f = () => 68 call_closure(f) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_releases(native), 0)
}

test "rc_elision_direct_call_borrows_mixed_managed_params" {
  let src = "fn call_managed(p: rc i64, f: () -> i64) -> i64 { mem_load64(p) + f() } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 60) let f = () => 9 call_managed(p, f) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_retains(native), 0)
  Test.assert_eq(rc_metric_native_main_releases(native), 0)
  Test.assert_eq(rc_metric_native_main_closure_releases(native), 0)
}

test "rc_drop_specialization_happy_matrix" {
  let rc_src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) if p != 0 { 1 } else { 0 } }"
  let rc_native = rc_metric_native(rc_src)
  Test.assert_eq(if rc_metric_native_managed_drop_specializations(rc_native) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(if rc_metric_native_rc_drop_specializations(rc_native) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(rc_metric_native_managed_drop_specializations(rc_native), rc_metric_native_rc_drop_specializations(rc_native) + rc_metric_native_closure_drop_specializations(rc_native))
  Test.assert_eq(rc_metric_native_call_sites(rc_native, "main", "rc_default_release"), 0)

  let closure_src = "fn main() -> i64 { let f = () => 71 let g = f g() }"
  let closure_native = rc_metric_native(closure_src)
  Test.assert_eq(if rc_metric_native_managed_drop_specializations(closure_native) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(rc_metric_native_call_sites(closure_native, "main", "rc_default_release"), 0)
  Test.assert_eq(if rc_metric_native_closure_drop_specializations(closure_native) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(rc_metric_native_call_sites(closure_native, "main", "closure_default_release"), 0)
}

test "rc_drop_specialization_sad_matrix" {
  let unmanaged = rc_metric_native("fn main() -> i64 { let x = 1 x }")
  Test.assert_eq(rc_metric_native_managed_drop_specializations(unmanaged), 0)
  Test.assert_eq(rc_metric_native_rc_drop_specializations(unmanaged), 0)
  Test.assert_eq(rc_metric_native_closure_drop_specializations(unmanaged), 0)

  let manual = rc_metric_native("fn main() -> i64 { let p: i64 = rc_default_alloc(8, 8) rc_default_release(p) 0 }")
  Test.assert_eq(rc_metric_native_main_retains(manual), 0)
  Test.assert_eq(rc_metric_native_call_sites(manual, "main", "rc_default_release"), 0)
}

test "rc_drop_specialization_e2e_releases_owned_value_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_borrowed_call_scope_addr(), 8), 0)
}

test "rc_elision_alias_control_flow_matrix" {
  let in_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 44) let q: rc i64 = p if true { mem_load64(q) } else { 0 } }"
  let if_native = rc_metric_native(in_if)
  Test.assert_eq(rc_metric_native_elisions(if_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(if_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(if_native), 0)

  let in_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> mem_load64(q) _ -> 0 } }"
  let match_native = rc_metric_native(in_match)
  Test.assert_eq(rc_metric_native_elisions(match_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(match_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(match_native), 0)

  let in_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = mem_load64(q) } n }"
  let loop_native = rc_metric_native(in_loop)
  Test.assert_eq(rc_metric_native_elisions(loop_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(loop_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(loop_native), 0)
}

test "rc_elision_alias_control_transfer_matrix" {
  let early_return = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 47) let q: rc i64 = p return mem_load64(q) }"
  let early_native = rc_metric_native(early_return)
  Test.assert_eq(rc_metric_native_elisions(early_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(early_native), 0)
  Test.assert_eq(if rc_metric_native_main_releases(early_native) >= 1 { 1 } else { 0 }, 0)

  let with_defer = "fn main() -> i64 { let log = 1024 mem_store64(log, 0) let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 48) let q: rc i64 = p defer mem_store64(log, mem_load64(q)) mem_load64(q) }"
  let defer_native = rc_metric_native(with_defer)
  Test.assert_eq(rc_metric_native_elisions(defer_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(defer_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(defer_native), 0)
}

test "rc_elision_borrowed_call_happy_matrix" {
  let mixed = "fn borrow_mix(p: rc i64, extra: i64) -> i64 { mem_load64(p) + extra } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 49) borrow_mix(p, 3) }"
  let mixed_native = rc_metric_native(mixed)
  Test.assert_eq(rc_metric_native_elisions(mixed_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(mixed_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(mixed_native), 0)

  let repeated = "fn borrow_read(p: rc i64) -> i64 { mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) mem_store64(p, 50) borrow_read(p) + borrow_read(p) }"
  let repeated_native = rc_metric_native(repeated)
  Test.assert_eq(rc_metric_native_elisions(repeated_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(repeated_native), 0)
  Test.assert_eq(rc_metric_native_main_releases(repeated_native), 0)
}

test "rc_elision_borrowed_call_infers_per_param_happy_matrix" {
  let peer_store = "fn borrow_even_when_peer_mutates(a: rc i64, b: rc i64) -> i64 { mem_store64(b, 7) mem_load64(a) } fn main() -> i64 { let a: rc i64 = rc_default_alloc(8, 8) let b: rc i64 = rc_default_alloc(8, 8) borrow_even_when_peer_mutates(a, b) }"
  let peer_native = rc_metric_native(peer_store)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(peer_native), 4)
  Test.assert_eq(rc_metric_native_elisions(peer_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(peer_native, "main", "rc_default_retain"), 0)

  let unrelated_record = "type RcElisionSideRecord { value: i64 } fn borrow_with_record(p: rc i64) -> i64 { let r = RcElisionSideRecord { value: 1 } mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_with_record(p) }"
  let record_native = rc_metric_native(unrelated_record)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(record_native), 4)
  Test.assert_eq(rc_metric_native_elisions(record_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(record_native, "main", "rc_default_retain"), 0)

  let unrelated_lambda = "fn borrow_with_lambda(p: rc i64) -> i64 { let f = () => 2 mem_load64(p) + f() } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_with_lambda(p) }"
  let lambda_native = rc_metric_native(unrelated_lambda)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(lambda_native), 4)
  Test.assert_eq(rc_metric_native_elisions(lambda_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(lambda_native, "main", "rc_default_retain"), 0)
}

test "rc_elision_borrowed_call_infers_per_param_sad_matrix" {
  let store_same_param = "fn borrow_store_self(p: rc i64) -> i64 { mem_store64(p, 1) 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_store_self(p) }"
  let store_native = rc_metric_native(store_same_param)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(store_native), 4)
  Test.assert_eq(rc_metric_native_elisions(store_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(store_native, "main", "rc_default_retain"), 0)

  let record_capture = "type RcElisionParamRecord { p: rc i64 } fn borrow_record_capture(p: rc i64) -> i64 { let r = RcElisionParamRecord { p: p } 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_record_capture(p) }"
  let record_capture_native = rc_metric_native(record_capture)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(record_capture_native), 3)
  Test.assert_eq(rc_metric_native_elisions(record_capture_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(record_capture_native, "main", "rc_default_retain"), 0)

  let lambda_capture = "fn borrow_lambda_capture(p: rc i64) -> i64 { let f = () => mem_load64(p) f() } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_lambda_capture(p) }"
  let lambda_capture_native = rc_metric_native(lambda_capture)
  Test.assert_eq(rc_metric_native_borrowable_param_facts(lambda_capture_native), 3)
  Test.assert_eq(rc_metric_native_elisions(lambda_capture_native), 0)
  Test.assert_eq(rc_metric_native_call_sites(lambda_capture_native, "main", "rc_default_retain"), 0)
}

test "rc_elision_rejects_alias_when_source_is_reassigned" {
  let src = "fn main() -> i64 { let first: rc i64 = rc_default_alloc(8, 8) let second: rc i64 = rc_default_alloc(8, 8) let mut cur: rc i64 = first let q: rc i64 = cur cur = second if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_metric_elisions(src), 0)
}

test "rc_elision_rejects_closure_alias_when_source_is_reassigned" {
  let src = "fn main() -> i64 { let f = () => 1 let h = () => 2 let mut cur = f let g = cur cur = h g() }"
  Test.assert_eq(rc_metric_elisions(src), 0)
  Test.assert_eq(rc_metric_main_closure_retains(src), 0)
}

test "rc_elision_disables_when_rc_count_is_observed" {
  let src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = p rc_count(q) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elision_enabled(native), 0)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
}

test "rc_elision_direct_call_rejects_managed_return" {
  let src = "fn borrow_id(p: rc i64) -> rc i64 { p } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = borrow_id(p) if q == p { 1 } else { 0 } }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elision_enabled(native), 1)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
}

test "rc_elision_direct_call_rejects_closure_body" {
  let src = "fn borrow_closure_body(p: rc i64) -> i64 { let f = () => mem_load64(p) f() } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_closure_body(p) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)

  let closure_param = "fn borrow_closure_body(f: () -> i64) -> i64 { let g = () => f() g() } fn main() -> i64 { let f = () => 1 borrow_closure_body(f) }"
  let closure_native = rc_metric_native(closure_param)
  Test.assert_eq(rc_metric_native_elisions(closure_native), 0)
  Test.assert_eq(rc_metric_native_main_closure_retains(closure_native), 0)
}

test "rc_elision_direct_call_rejects_store_body" {
  let src = "fn borrow_store_body(p: rc i64) -> i64 { mem_store64(p, 1) 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_store_body(p) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
}

test "rc_elision_direct_call_rejects_boundary_matrix" {
  let generic_call = "fn borrow_generic<T>(x: T, p: rc i64) -> i64 { mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_generic<i64>(0, p) }"
  let generic_native = rc_metric_native(generic_call)
  Test.assert_eq(rc_metric_native_elisions(generic_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(generic_native), 0)

  let method_call = "type RcElisionMethodBox { value: i64 } impl RcElisionMethodBox { fn touch(self: RcElisionMethodBox, p: rc i64) -> i64 { mem_load64(p) } } fn main() -> i64 { let box = RcElisionMethodBox { value: 1 } let p: rc i64 = rc_default_alloc(8, 8) box.touch(p) }"
  let method_native = rc_metric_native(method_call)
  Test.assert_eq(rc_metric_native_elisions(method_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(method_native), 0)

  let closure_call = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let f = (x: rc i64) => mem_load64(x) f(p) }"
  let closure_native = rc_metric_native(closure_call)
  Test.assert_eq(rc_metric_native_elisions(closure_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(closure_native), 0)
}

test "rc_elision_direct_call_rejects_unsafe_lifetime_matrix" {
  let record_init = "type RcElisionRecordBox { p: rc i64 } fn borrow_record_body(p: rc i64) -> i64 { let r = RcElisionRecordBox { p: p } 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_record_body(p) }"
  let record_native = rc_metric_native(record_init)
  Test.assert_eq(rc_metric_native_elisions(record_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(record_native), 0)

  let defer_body = "fn borrow_defer_body(p: rc i64) -> i64 { defer 0 mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_defer_body(p) }"
  let defer_native = rc_metric_native(defer_body)
  Test.assert_eq(rc_metric_native_elisions(defer_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(defer_native), 0)

  let explicit_release = "fn borrow_release_body(p: rc i64) -> i64 { rc_default_release(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_release_body(p) }"
  let release_native = rc_metric_native(explicit_release)
  Test.assert_eq(rc_metric_native_elisions(release_native), 0)
  Test.assert_eq(rc_metric_native_main_retains(release_native), 0)
}

test "rc_elision_direct_call_rejects_handler_boundary" {
  let src = "effect RcElisionProbe { fn get() -> i64 } fn borrow_handler_body(p: rc i64) -> i64 { handle RcElisionProbe.get() { RcElisionProbe.get() -> resume(mem_load64(p)) } } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_handler_body(p) }"
  let native = rc_metric_native(src)
  Test.assert_eq(rc_metric_native_elisions(native), 0)
  Test.assert_eq(rc_metric_native_main_retains(native), 0)
}

test "rc_elision_e2e_preserves_alias_value" {
  Test.assert_eq(rc_elision_alias_value(), 55)
}

test "rc_elision_e2e_preserves_captured_alias_value" {
  let f = rc_elision_alias_closure()
  Test.assert_eq(f(), 56)
}

test "rc_elision_e2e_preserves_closure_alias_value" {
  Test.assert_eq(rc_elision_closure_alias_value(), 66)
}

test "rc_elision_e2e_preserves_returned_closure_alias_value" {
  let f = rc_elision_closure_alias_returned()
  Test.assert_eq(f(), 67)
}

test "rc_elision_e2e_preserves_borrowed_call_value" {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 58)
  Test.assert_eq(rc_elision_borrowed_call_value(p), 58)
}

test "rc_elision_e2e_preserves_borrowed_call_multiple_values" {
  let a: rc i64 = rc_default_alloc(8, 8)
  let b: rc i64 = rc_default_alloc(8, 8)
  mem_store64(a, 20)
  mem_store64(b, 39)
  Test.assert_eq(rc_elision_borrowed_call_sum(a, b), 59)
}

test "rc_elision_e2e_preserves_borrowed_closure_call_value" {
  let f = () => 68
  Test.assert_eq(rc_elision_borrowed_closure_call(f), 68)
}

test "rc_elision_e2e_preserves_borrowed_mixed_managed_call_value" {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 60)
  let f = () => 9
  Test.assert_eq(rc_elision_borrowed_managed_call(p, f), 69)
}

test "rc_elision_e2e_releases_elided_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_alias_scope_addr(), 8), 0)
}

test "rc_elision_e2e_releases_deferred_elided_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_alias_defer_scope_addr(), 8), 0)
}

test "rc_elision_e2e_releases_borrowed_call_value_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_borrowed_call_scope_addr(), 8), 0)
}

test "rc_elision_e2e_releases_repeated_borrowed_call_value_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_borrowed_call_twice_scope_addr(), 8), 0)
}

test "rc_elision_e2e_releases_captured_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_captured_alias_scope_addr(), 8), 0)
}
