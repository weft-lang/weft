-- test/rc_elision_metrics.weft -- native evidence for local RC retain/release elision

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn rc_metric_u32_at(p: i64) -> i64 {
  __mem_load8(p) +
  __mem_load8(p + 1) * 256 +
  __mem_load8(p + 2) * 65536 +
  __mem_load8(p + 3) * 16777216
}

fn rc_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = __mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn rc_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if rc_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn rc_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn rc_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = rc_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = rc_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  rc_metric_count_bl_to_target(code, off, end, target)
}

fn rc_metric_main_retains(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "rc_default_retain")
}

fn rc_metric_main_releases(src: str) -> i64 {
  rc_metric_call_sites(src, "main", "rc_default_release")
}

fn rc_metric_elisions(src: str) -> i64 {
  pipeline_native_rc_elision_count(rc_metric_native(src))
}

fn rc_metric_elision_enabled(src: str) -> i64 {
  pipeline_native_rc_elision_enabled(rc_metric_native(src))
}

fn rc_elision_alias_value() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 55)
  let q: rc i64 = p
  __mem_load64(q)
}

fn rc_elision_alias_closure() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 56)
  let q: rc i64 = p
  () => __mem_load64(q)
}

fn rc_elision_borrowed_call_value(p: rc i64) -> i64 {
  __mem_load64(p)
}

fn rc_elision_borrowed_call_sum(a: rc i64, b: rc i64) -> i64 {
  __mem_load64(a) + __mem_load64(b)
}

fn rc_elision_reallocs_same_zeroed(addr: i64, payload_size: i64) -> i64 {
  let again: rc i64 = rc_default_alloc(payload_size, 8)
  if again == addr {
    if __mem_load64(again) == 0 { 1 } else { 0 }
  } else { 0 }
}

fn rc_elision_alias_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 61)
  let addr = p + 0
  let q: rc i64 = p
  if __mem_load64(q) == 61 { addr } else { 0 }
}

fn rc_elision_alias_defer_scope_addr() -> i64 {
  let log = __bump_alloc(8)
  __mem_store64(log, 0)
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 62)
  let addr = p + 0
  let q: rc i64 = p
  defer __mem_store64(log, __mem_load64(q))
  if __mem_load64(q) == 62 { addr } else { 0 }
}

fn rc_elision_borrowed_call_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 63)
  let addr = p + 0
  if rc_elision_borrowed_call_value(p) == 63 { addr } else { 0 }
}

fn rc_elision_borrowed_call_twice_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 64)
  let addr = p + 0
  let first = rc_elision_borrowed_call_value(p)
  let second = rc_elision_borrowed_call_value(p)
  if first + second == 128 { addr } else { 0 }
}

fn rc_elision_captured_alias_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 65)
  let addr = p + 0
  let q: rc i64 = p
  let f = () => __mem_load64(q)
  if f() == 65 { addr } else { 0 }
}

test "rc_elision_local_alias_removes_retain_release_pair" {
  let src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 42) let q: rc i64 = p __mem_load64(q) }"
  Test.assert_eq(rc_metric_elision_enabled(src), 1)
  Test.assert_eq(rc_metric_elisions(src), 1)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_release"), 1)
}

test "rc_elision_returned_alias_keeps_return_ownership" {
  let src = "fn make() -> rc i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = p q } fn main() -> i64 { let r: rc i64 = make() if r != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_metric_elisions(src), 1)
  Test.assert_eq(rc_metric_call_sites(src, "make", "rc_default_retain"), 1)
  Test.assert_eq(rc_metric_call_sites(src, "make", "rc_default_release"), 1)
}

test "rc_elision_local_alias_static_pair_invariant" {
  let optimised = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 42) let q: rc i64 = p __mem_load64(q) }"
  let baseline = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 42) let q: rc i64 = p __mem_load64(q) } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  Test.assert_eq(rc_metric_elision_enabled(optimised), 1)
  Test.assert_eq(rc_metric_elision_enabled(baseline), 0)
  Test.assert_eq(rc_metric_elisions(optimised), rc_metric_main_retains(baseline) - rc_metric_main_retains(optimised))
  Test.assert_eq(rc_metric_elisions(optimised), rc_metric_main_releases(baseline) - rc_metric_main_releases(optimised))
}

test "rc_elision_local_alias_static_control_flow_pair_matrix" {
  let opt_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 44) let q: rc i64 = p if true { __mem_load64(q) } else { 0 } }"
  let base_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 44) let q: rc i64 = p if true { __mem_load64(q) } else { 0 } } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  Test.assert_eq(rc_metric_elisions(opt_if), rc_metric_main_retains(base_if) - rc_metric_main_retains(opt_if))
  Test.assert_eq(rc_metric_elisions(opt_if), rc_metric_main_releases(base_if) - rc_metric_main_releases(opt_if))

  let opt_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> __mem_load64(q) _ -> 0 } }"
  let base_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> __mem_load64(q) _ -> 0 } } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  Test.assert_eq(rc_metric_elisions(opt_match), rc_metric_main_retains(base_match) - rc_metric_main_retains(opt_match))
  Test.assert_eq(rc_metric_elisions(opt_match), rc_metric_main_releases(base_match) - rc_metric_main_releases(opt_match))

  let opt_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = __mem_load64(q) } n }"
  let base_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = __mem_load64(q) } n } fn disable_elision(p: rc i64) -> i64 { rc_count(p) }"
  Test.assert_eq(rc_metric_elisions(opt_loop), rc_metric_main_retains(base_loop) - rc_metric_main_retains(opt_loop))
  Test.assert_eq(rc_metric_elisions(opt_loop), rc_metric_main_releases(base_loop) - rc_metric_main_releases(opt_loop))
}

test "rc_elision_direct_call_borrows_single_param" {
  let src = "fn borrow_read(p: rc i64) -> i64 { __mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 43) borrow_read(p) }"
  Test.assert_eq(rc_metric_elisions(src), 1)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_release"), 1)
}

test "rc_elision_direct_call_borrows_multiple_params" {
  let src = "fn borrow_sum(a: rc i64, b: rc i64) -> i64 { __mem_load64(a) + __mem_load64(b) } fn main() -> i64 { let a: rc i64 = rc_default_alloc(8, 8) let b: rc i64 = rc_default_alloc(8, 8) borrow_sum(a, b) }"
  Test.assert_eq(rc_metric_elisions(src), 2)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_release"), 2)
}

test "rc_elision_alias_control_flow_matrix" {
  let in_if = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 44) let q: rc i64 = p if true { __mem_load64(q) } else { 0 } }"
  Test.assert_eq(rc_metric_elisions(in_if), 1)
  Test.assert_eq(rc_metric_call_sites(in_if, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(in_if, "main", "rc_default_release"), 1)

  let in_match = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 45) let q: rc i64 = p match 1 { 1 -> __mem_load64(q) _ -> 0 } }"
  Test.assert_eq(rc_metric_elisions(in_match), 1)
  Test.assert_eq(rc_metric_call_sites(in_match, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(in_match, "main", "rc_default_release"), 1)

  let in_loop = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 46) let q: rc i64 = p let mut n = 0 while n < 1 { n = __mem_load64(q) } n }"
  Test.assert_eq(rc_metric_elisions(in_loop), 1)
  Test.assert_eq(rc_metric_call_sites(in_loop, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(in_loop, "main", "rc_default_release"), 1)
}

test "rc_elision_alias_control_transfer_matrix" {
  let early_return = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 47) let q: rc i64 = p return __mem_load64(q) }"
  Test.assert_eq(rc_metric_elisions(early_return), 1)
  Test.assert_eq(rc_metric_call_sites(early_return, "main", "rc_default_retain"), 0)
  Test.assert_eq(if rc_metric_call_sites(early_return, "main", "rc_default_release") >= 1 { 1 } else { 0 }, 1)

  let with_defer = "fn main() -> i64 { let log = __bump_alloc(8) __mem_store64(log, 0) let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 48) let q: rc i64 = p defer __mem_store64(log, __mem_load64(q)) __mem_load64(q) }"
  Test.assert_eq(rc_metric_elisions(with_defer), 1)
  Test.assert_eq(rc_metric_call_sites(with_defer, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(with_defer, "main", "rc_default_release"), 1)
}

test "rc_elision_borrowed_call_happy_matrix" {
  let mixed = "fn borrow_mix(p: rc i64, extra: i64) -> i64 { __mem_load64(p) + extra } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 49) borrow_mix(p, 3) }"
  Test.assert_eq(rc_metric_elisions(mixed), 1)
  Test.assert_eq(rc_metric_call_sites(mixed, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(mixed, "main", "rc_default_release"), 1)

  let repeated = "fn borrow_read(p: rc i64) -> i64 { __mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) __mem_store64(p, 50) borrow_read(p) + borrow_read(p) }"
  Test.assert_eq(rc_metric_elisions(repeated), 2)
  Test.assert_eq(rc_metric_call_sites(repeated, "main", "rc_default_retain"), 0)
  Test.assert_eq(rc_metric_call_sites(repeated, "main", "rc_default_release"), 1)
}

test "rc_elision_rejects_alias_when_source_is_reassigned" {
  let src = "fn main() -> i64 { let first: rc i64 = rc_default_alloc(8, 8) let second: rc i64 = rc_default_alloc(8, 8) let mut cur: rc i64 = first let q: rc i64 = cur cur = second if q != 0 { 1 } else { 0 } }"
  Test.assert_eq(rc_metric_elisions(src), 0)
}

test "rc_elision_disables_when_rc_count_is_observed" {
  let src = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = p rc_count(q) }"
  Test.assert_eq(rc_metric_elision_enabled(src), 0)
  Test.assert_eq(rc_metric_elisions(src), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 1)
}

test "rc_elision_direct_call_rejects_managed_return" {
  let src = "fn borrow_id(p: rc i64) -> rc i64 { p } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q: rc i64 = borrow_id(p) if q == p { 1 } else { 0 } }"
  Test.assert_eq(rc_metric_elision_enabled(src), 1)
  Test.assert_eq(rc_metric_elisions(src), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 1)
}

test "rc_elision_direct_call_rejects_closure_body" {
  let src = "fn borrow_closure_body(p: rc i64) -> i64 { let f = () => __mem_load64(p) f() } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_closure_body(p) }"
  Test.assert_eq(rc_metric_elisions(src), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 1)
}

test "rc_elision_direct_call_rejects_store_body" {
  let src = "fn borrow_store_body(p: rc i64) -> i64 { __mem_store64(p, 1) 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_store_body(p) }"
  Test.assert_eq(rc_metric_elisions(src), 0)
  Test.assert_eq(rc_metric_call_sites(src, "main", "rc_default_retain"), 1)
}

test "rc_elision_direct_call_rejects_boundary_matrix" {
  let generic_call = "fn borrow_generic<T>(x: T, p: rc i64) -> i64 { __mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_generic<i64>(0, p) }"
  Test.assert_eq(rc_metric_elisions(generic_call), 0)
  Test.assert_eq(rc_metric_call_sites(generic_call, "main", "rc_default_retain"), 1)

  let method_call = "type RcElisionMethodBox { value: i64 } impl RcElisionMethodBox { fn touch(self: RcElisionMethodBox, p: rc i64) -> i64 { __mem_load64(p) } } fn main() -> i64 { let box = RcElisionMethodBox { value: 1 } let p: rc i64 = rc_default_alloc(8, 8) box.touch(p) }"
  Test.assert_eq(rc_metric_elisions(method_call), 0)
  Test.assert_eq(rc_metric_call_sites(method_call, "main", "rc_default_retain"), 1)

  let closure_call = "fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let f = (x: rc i64) => __mem_load64(x) f(p) }"
  Test.assert_eq(rc_metric_elisions(closure_call), 0)
  Test.assert_eq(rc_metric_call_sites(closure_call, "main", "rc_default_retain"), 1)
}

test "rc_elision_direct_call_rejects_unsafe_lifetime_matrix" {
  let record_init = "type RcElisionRecordBox { p: rc i64 } fn borrow_record_body(p: rc i64) -> i64 { let r = RcElisionRecordBox { p: p } 0 } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_record_body(p) }"
  Test.assert_eq(rc_metric_elisions(record_init), 0)
  Test.assert_eq(rc_metric_call_sites(record_init, "main", "rc_default_retain"), 1)

  let defer_body = "fn borrow_defer_body(p: rc i64) -> i64 { defer 0 __mem_load64(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_defer_body(p) }"
  Test.assert_eq(rc_metric_elisions(defer_body), 0)
  Test.assert_eq(rc_metric_call_sites(defer_body, "main", "rc_default_retain"), 1)

  let explicit_release = "fn borrow_release_body(p: rc i64) -> i64 { rc_default_release(p) } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) borrow_release_body(p) }"
  Test.assert_eq(rc_metric_elisions(explicit_release), 0)
  Test.assert_eq(rc_metric_call_sites(explicit_release, "main", "rc_default_retain"), 1)
}

test "rc_elision_e2e_preserves_alias_value" {
  Test.assert_eq(rc_elision_alias_value(), 55)
}

test "rc_elision_e2e_preserves_captured_alias_value" {
  let f = rc_elision_alias_closure()
  Test.assert_eq(f(), 56)
}

test "rc_elision_e2e_preserves_borrowed_call_value" {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 58)
  Test.assert_eq(rc_elision_borrowed_call_value(p), 58)
}

test "rc_elision_e2e_preserves_borrowed_call_multiple_values" {
  let a: rc i64 = rc_default_alloc(8, 8)
  let b: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(a, 20)
  __mem_store64(b, 39)
  Test.assert_eq(rc_elision_borrowed_call_sum(a, b), 59)
}

test "rc_elision_e2e_releases_elided_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_alias_scope_addr(), 8), 1)
}

test "rc_elision_e2e_releases_deferred_elided_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_alias_defer_scope_addr(), 8), 1)
}

test "rc_elision_e2e_releases_borrowed_call_value_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_borrowed_call_scope_addr(), 8), 1)
}

test "rc_elision_e2e_releases_repeated_borrowed_call_value_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_borrowed_call_twice_scope_addr(), 8), 1)
}

test "rc_elision_e2e_releases_captured_alias_once" {
  Test.assert_eq(rc_elision_reallocs_same_zeroed(rc_elision_captured_alias_scope_addr(), 8), 1)
}
