-- Structural types: executable kernel conformance and compiler-sized generic
-- structural transport. The outer State result is four lanes when both T and
-- S are pairs, so it pins specialization-time field offsets rather than the
-- generic template's unresolved layout.

use stdlib/state.{*}

type StructuralConformancePerson {
  name: str,
  age: i64,
}

effect StructuralConformanceTrace {
  fn hit() -> nil
}

fn structural_conformance_name(value: {name: str, ..}) -> str {
  value.name
}

fn structural_conformance_birthday(value: {name: str, age: i64}) -> {name: str, age: i64} {
  value.{age: value.age + 1}
}

fn structural_conformance_without_email(value: {..} & ~{email: any, ..}) -> i64 {
  42
}

fn structural_conformance_state_body() -[State<(str, i64)>, StructuralConformanceTrace]> (i64, str) {
  StructuralConformanceTrace.hit()
  State.put(("final", 42))
  let (label, value) = State.get()
  (value, label)
}

fn structural_conformance_state_open() -[StructuralConformanceTrace]> ((i64, str), (str, i64)) {
  with_state(
    ("initial", 0),
    structural_conformance_state_body,
  )
}

test "kernel open records and functional update compile as set operations" {
  let person = StructuralConformancePerson { name: "weft", age: 41 }
  let updated = structural_conformance_birthday({name: "weft", age: 41})
  Test.assert_eq(__str_len(structural_conformance_name(person)), 4)
  Test.assert_eq(updated.age, 42)
  Test.assert_eq(structural_conformance_without_email({name: "weft"}), 42)
}

test "generic state handler returns tuple value and final tuple state" {
  let result = handle structural_conformance_state_open() {
    StructuralConformanceTrace.hit() -> resume(nil)
  }
  let ((value, label), (state_label, state_value)) = result
  Test.assert_eq(value, 42)
  Test.assert_eq(__str_len(label), 5)
  Test.assert_eq(state_value, 42)
  Test.assert_eq(__str_len(state_label), 5)
}
