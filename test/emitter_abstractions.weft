  Test.assert_eq(native_link_pageoff12_is_valid(ldr_q0_x2, 16), 1)
  Test.assert_eq(native_link_pageoff12_is_valid(ldr_q0_x2, 8), 0)
  Test.assert_eq(native_link_pageoff12_word(ldr_q0_x2, 32), 1035995200)
}

test "native_link_applies_call_jump_and_absolute_address_semantics" {
  let code = buf_new(16)
  bpad(code, 16)
  let archive_data = buf_new(16)
  bpad(archive_data, 16)
  let relocations = list_cons<NativeLinkRelocation>(
    NativeLinkDirectBranch26(0, 8),
    list_cons<NativeLinkRelocation>(
      NativeLinkDirectJump26(4, 12),
      list_cons<NativeLinkRelocation>(
        NativeLinkArchiveDataAbsolute64(0, NativeLinkArchiveCodeAddress(4), 8),
        list_cons<NativeLinkRelocation>(
          NativeLinkArchiveDataAbsolute64(8, NativeLinkArchiveDataAddress(0), 4),
          list_nil<NativeLinkRelocation>()
        )
      )
    )
  )
  native_link_apply_relocations_at(code, archive_data, relocations, 16384, 32768, 16, 0, 32)
  Test.assert_eq(mem_load64_at(buf_ptr(code), 0) band 4294967295, encode_bl(8))
  Test.assert_eq(mem_load64_at(buf_ptr(code), 4) band 4294967295, encode_b(8))
  Test.assert_eq(mem_load64_at(buf_ptr(archive_data), 0), 16396)
  Test.assert_eq(mem_load64_at(buf_ptr(archive_data), 8), 32804)
}

test "mach_native_link_emits_rebases_for_archive_pointers" {
  let relocations = list_cons<NativeLinkRelocation>(
    NativeLinkArchiveDataAbsolute64(8, NativeLinkArchiveCodeAddress(4), 0),
    list_nil<NativeLinkRelocation>()
  )
  let rebase = native_link_emit_rebase_data(relocations, 32)
  Test.assert_eq(buf_len(rebase), 5)
  Test.assert_eq(mem_load8_at(buf_ptr(rebase), 0), 17)
  Test.assert_eq(mem_load8_at(buf_ptr(rebase), 1), 34)
  Test.assert_eq(mem_load8_at(buf_ptr(rebase), 2), 40)
  Test.assert_eq(mem_load8_at(buf_ptr(rebase), 3), 81)
  Test.assert_eq(mem_load8_at(buf_ptr(rebase), 4), 0)
}

test "linux_elf_finalizer_admits_static_archive_graph_and_direct_branch" {
  let code = buf_new(20)
  bu32(code, encode_bl(0))
  bu32(code, encode_movz(8, 93, 0))
  bu32(code, 3556769793)
  bu32(code, encode_movz(0, 42, 0))
  bu32(code, encode_ret())
  let library = NativeLinkStaticArchive("fixture", "libfixture.a", "sha256:fixture", NativeLibraryLicenseUnspecified, 1, 1)
  let graph = NativeLinkGraph(
    NativeLinkLinuxAarch64,
    NativeArtifactLinuxKernelAbi(3, 7, 0),
    NativeLinkDebugInformationAbsent,
    NativeArtifactUnsigned,
    list_nil<NativeArtifactTrustGrant>(),
    code,
    buf_new(0),
    native_link_image_layout(code, buf_new(0), 0, 0, 0),
    list_cons<NativeLinkLibrary>(library, list_nil<NativeLinkLibrary>()),
    list_nil<NativeLinkPlacedMember>(),
    list_nil<NativeLinkSymbol>(),
    list_cons<NativeLinkRelocation>(NativeLinkDirectBranch26(0, 12), list_nil<NativeLinkRelocation>()),
    0
  )
  match emit_native_link_elf(graph) {
    ElfNativeLinkEmitted(image) -> {
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), encode_bl(12))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4108), encode_movz(0, 42, 0))
    }
    _ -> Test.assert_eq(0, 1)
  }
}

