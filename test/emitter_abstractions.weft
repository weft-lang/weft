fn encoder_expect_immediate_tripwire(word: i64) -[Test]> i64 {
  Test.assert_eq(word, 3560891040)
}

fn native_link_test_dylib_command(output: i64, command: i64, identity: str) -> i64 {
  let start = buf_len(output)
  let size = native_link_dylib_command_size(identity)
  bu32(output, command)
  bu32(output, size)
  bu32(output, 24)
  bu32(output, 0)
  bu32(output, 0)
  bu32(output, 0)
  bstr(output, identity)
  bu8(output, 0)
  bpad(output, start + size)
  0
}

fn native_link_test_dynamic_image() -> i64 {
  let commands = buf_new(512)
  native_link_test_dylib_command(commands, 13, "/fixture/libowner.dylib")
  native_link_test_dylib_command(commands, 12, "/fixture/librequired.dylib")
  native_link_test_dylib_command(commands, 2147483672, "/fixture/libweak.dylib")
  native_link_test_dylib_command(commands, 2147483679, "/fixture/libreexport.dylib")
  native_link_test_dylib_command(commands, 2147483683, "/fixture/libupward.dylib")
  native_link_test_dylib_command(commands, 32, "/fixture/liblazy.dylib")
  let image = buf_new(544)
  bu32(image, 4277009103)
  bu32(image, 16777228)
  bu32(image, 0)
  bu32(image, 6)
  bu32(image, 6)
  bu32(image, buf_len(commands))
  bu32(image, 0)
  bu32(image, 0)
  bscopy(image, buf_ptr(commands), buf_len(commands), 0)
  image
}

fn native_link_test_view_str(view: NativeLinkByteView) -> str {
  pkg_str_view(native_link_byte_view_ptr(view), native_link_byte_view_len(view))
}

test "manifest library indices account for only the target platform contract" {
  Test.assert_eq(native_link_manifest_library_base(NativeLinkMacosAarch64), 1)
  Test.assert_eq(native_link_manifest_library_base(NativeLinkLinuxAarch64), 0)
}

fn native_link_test_append_u16(output: i64, value: i64) -> i64 {
  bu8(output, value - value / 256 * 256)
  bu8(output, value / 256 - value / 65536 * 256)
  0
}

fn native_link_test_elf_section(output: i64, kind: i64, flags: i64, address: i64, offset: i64, size: i64, link: i64, info: i64, align: i64, entry_size: i64) -> i64 {
  bu32(output, 0)
  bu32(output, kind)
  bu64(output, flags)
  bu64(output, address)
  bu64(output, offset)
  bu64(output, size)
  bu32(output, link)
  bu32(output, info)
  bu64(output, align)
  bu64(output, entry_size)
  0
}

fn native_link_test_elf_code_object(alloc_data_size: i64) -> i64 {
  let symbol_name = "weft_linux_archive_value"
  let output = buf_new(576)
  bu32(output, 1179403647)
  bu8(output, 2) bu8(output, 1) bu8(output, 1)
  bfill(output, 9)
  native_link_test_append_u16(output, 1)
  native_link_test_append_u16(output, 183)
  bu32(output, 1)
  bu64(output, 0)
  bu64(output, 0)
  bu64(output, 256)
  bu32(output, 0)
  native_link_test_append_u16(output, 64)
  native_link_test_append_u16(output, 0)
  native_link_test_append_u16(output, 0)
  native_link_test_append_u16(output, 64)
  native_link_test_append_u16(output, 5)
  native_link_test_append_u16(output, 0)
  bu32(output, encode_movz(0, 42, 0))
  bu32(output, encode_ret())
  bu8(output, 0)
  bstr(output, symbol_name)
  bu8(output, 0)
  bpad(output, 128)
  bfill(output, 24)
  bu32(output, 1)
  bu8(output, 18)
  bu8(output, 0)
  native_link_test_append_u16(output, 1)
  bu64(output, 0)
  bu64(output, 8)
  bpad(output, 176 + alloc_data_size)
  bpad(output, 256)
  native_link_test_elf_section(output, 0, 0, 0, 0, 0, 0, 0, 0, 0)
  native_link_test_elf_section(output, 1, 6, 0, 64, 8, 0, 0, 4, 0)
  native_link_test_elf_section(output, 3, 0, 0, 72, __str_len(symbol_name) + 2, 0, 0, 1, 0)
  native_link_test_elf_section(output, 2, 0, 0, 128, 48, 2, 1, 8, 24)
  native_link_test_elf_section(output, 1, 2, 0, 176, alloc_data_size, 0, 0, 1, 0)
  output
}

fn native_link_test_elf_relocation(kind: i64, addend: i64) -> NativeLinkObjectRelocation {
  let bytes = buf_new(64)
  bpad(bytes, 64)
  let raw = buf_ptr(bytes)
  mem_store64_at(raw, 0, 0)
  mem_store64_at(raw, 8, kind)
  mem_store64_at(raw, 16, addend)
  mem_store64_at(raw, 24, 1)
  mem_store8_at(raw, 48, 0)
  mem_copy(raw + 49, __str_ptr("data"), 4)
  mem_store8_at(raw, 53, 0)
  native_link_elf_object_relocation(
    NativeLinkElfObject(raw, 64, 0, 0, 4, 2, 0, 1, 1, 24, 1, 48, 6, list_nil<NativeLinkObjectDataSection>()),
    0
  )
}

fn native_link_test_store_u32(raw: i64, offset: i64, value: i64) -> i64 {
  mem_store8_at(raw, offset, value band 255)
  mem_store8_at(raw, offset + 1, value bshr 8 band 255)
  mem_store8_at(raw, offset + 2, value bshr 16 band 255)
  mem_store8_at(raw, offset + 3, value bshr 24 band 255)
}

fn native_link_test_mach_relocation(instruction: i64, first_info: i64, second_info: i64, count: i64, index: i64) -> NativeLinkObjectRelocation {
  let bytes = buf_new(96)
  bpad(bytes, 96)
  let raw = buf_ptr(bytes)
  native_link_test_store_u32(raw, 0, instruction)
  native_link_test_store_u32(raw, 8, 0)
  native_link_test_store_u32(raw, 12, first_info)
  native_link_test_store_u32(raw, 16, 0)
  native_link_test_store_u32(raw, 20, second_info)
  native_link_test_store_u32(raw, 32, 1)
  mem_store8_at(raw, 36, 15)
  mem_store8_at(raw, 37, 1)
  mem_store8_at(raw, 48, 0)
  mem_copy(raw + 49, __str_ptr("target"), 6)
  mem_store8_at(raw, 55, 0)
  native_link_mach_object_relocation(
    NativeLinkMachObject(raw, 96, 0, 0, 4, 2, 8, count, 1, 32, 1, 48, 8, list_nil<NativeLinkObjectDataSection>()),
    index
  )
}

fn native_link_test_elf_program(output: i64, kind: i64, flags: i64, offset: i64, address: i64, file_size: i64, memory_size: i64, align: i64) -> i64 {
  bu32(output, kind)
  bu32(output, flags)
  bu64(output, offset)
  bu64(output, address)
  bu64(output, address)
  bu64(output, file_size)
  bu64(output, memory_size)
  bu64(output, align)
  0
}

fn native_link_test_elf_dynamic_entry(output: i64, tag: i64, value: i64) -> i64 {
  bu64(output, tag)
  bu64(output, value)
  0
}

fn native_link_test_elf_dynamic_image(identity_tag: i64, needed_index: i64) -> i64 {
  let output = buf_new(288)
  bu32(output, 1179403647)
  bu8(output, 2) bu8(output, 1) bu8(output, 1)
  bfill(output, 9)
  native_link_test_append_u16(output, 3)
  native_link_test_append_u16(output, 183)
  bu32(output, 1)
  bu64(output, 0)
  bu64(output, 64)
  bu64(output, 0)
  bu32(output, 0)
  native_link_test_append_u16(output, 64)
  native_link_test_append_u16(output, 56)
  native_link_test_append_u16(output, 2)
  native_link_test_append_u16(output, 0)
  native_link_test_append_u16(output, 0)
  native_link_test_append_u16(output, 0)
  native_link_test_elf_program(output, 1, 4, 0, 0, 288, 288, 4096)
  native_link_test_elf_program(output, 2, 4, 208, 208, 80, 80, 8)
  bu8(output, 0)
  bstr(output, "libowner.so") bu8(output, 0)
  bstr(output, "libdep.so") bu8(output, 0)
  bpad(output, 208)
  native_link_test_elf_dynamic_entry(output, 5, 176)
  native_link_test_elf_dynamic_entry(output, 10, 23)
  native_link_test_elf_dynamic_entry(output, identity_tag, 1)
  native_link_test_elf_dynamic_entry(output, 1, needed_index)
  native_link_test_elf_dynamic_entry(output, 0, 0)
  output
}

fn emitter_test_append_u32(output: Vector<u8>, value: i64) -> i64 {
  vector_push<u8>(output, num_i64_to_u8_checked(value - value / 256 * 256).unwrap_or(0))
  vector_push<u8>(output, num_i64_to_u8_checked(value / 256 - value / 65536 * 256).unwrap_or(0))
  vector_push<u8>(output, num_i64_to_u8_checked(value / 65536 - value / 16777216 * 256).unwrap_or(0))
  vector_push<u8>(output, num_i64_to_u8_checked(value / 16777216 - value / 4294967296 * 256).unwrap_or(0))
}

fn emitter_test_bytes_byte_at(values: Bytes, offset: i64) -> i64 {
  match values.get(offset) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0 - 1
  }
}

fn emitter_test_bytes_u16_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_byte_at(values, offset) + emitter_test_bytes_byte_at(values, offset + 1) * 256
}

fn emitter_test_bytes_u32_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_u16_at(values, offset) + emitter_test_bytes_u16_at(values, offset + 2) * 65536
}

fn emitter_test_bytes_u64_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_u32_at(values, offset) + emitter_test_bytes_u32_at(values, offset + 4) * 4294967296
}

fn emitter_test_buf_word_count(values: i64, word: i64) -> i64 {
  let mut count = 0
  for offset in 0..(buf_len(values) / 4) {
    if (mem_load64_at(buf_ptr(values), offset * 4) band 4294967295) == word {
      count = count + 1
    } else { 0 }
  }
  count
}

test "arch_aarch64_encodes_core_instruction_matrix" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_is_supported(arch), 1)
  Test.assert_eq(arch_name_len_or(arch, 0 - 1), __str_len("aarch64"))
  Test.assert_eq(arch_encode_movz(arch, 0, 42, 0), 3531603968 + 42 * 32)
  Test.assert_eq(arch_encode_movk(arch, 1, 7, 16), 4068474880 + 2097152 + 7 * 32 + 1)
  Test.assert_eq(arch_encode_add_imm(arch, 2, 3, 4), 2432696320 + 4 * 1024 + 3 * 32 + 2)
  Test.assert_eq(arch_encode_str(arch, 4, 5, 16), 4177526784 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_ldr(arch, 4, 5, 16), 4181721088 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_stp_d_pre(arch, 8, 9, 31, 0 - 16), 1841244136)
  Test.assert_eq(arch_encode_ldp_d_post(arch, 8, 9, 31, 16), 1824597992)
}

test "arch_aarch64_svc_immediate_is_validated_and_target_selected" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_encode_svc_immediate(arch, 0), 3556769793)
  Test.assert_eq(arch_encode_svc_immediate(arch, 65535), 3556769793 + 65535 * 32)
  Test.assert_eq(arch_encode_svc_immediate(arch, 0 - 1), arch_encode_brk(arch, 21))
  Test.assert_eq(arch_encode_svc_immediate(arch, 65536), arch_encode_brk(arch, 21))
  Test.assert_eq(arch_encode_svc(arch), 3556773889)
  Test.assert_eq(arch_encode_svc_immediate(arch_x8664(), 0), 0)
}

test "semantic anonymous mapping selects exact target ABI" {
  Test.assert_eq(cg_target_mmap_flags(NativeLinkMacosAarch64), 4098)
  Test.assert_eq(cg_target_mmap_flags(NativeLinkLinuxAarch64), 34)

  let mapped = buf_new(32)
  cg_emit_platform_map_rw_anonymous(mapped, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(mapped), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 0) band 4294967295, encode_movz(2, 3, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 4) band 4294967295, encode_movz(3, 34, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 8) band 4294967295, encode_movn(4, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 12) band 4294967295, encode_movz(5, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 16) band 4294967295, encode_movz(8, 222, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 20) band 4294967295, arch_encode_svc_immediate(arch_aarch64(), 0))

  let remapped = buf_new(32)
  cg_emit_platform_remap_rw_anonymous_fixed(remapped, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(remapped), 4) band 4294967295, encode_movz(3, 50, 0))

  let unmapped = buf_new(16)
  cg_emit_platform_unmap(unmapped, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(unmapped), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(unmapped), 0) band 4294967295, encode_movz(8, 215, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(unmapped), 4) band 4294967295, arch_encode_svc_immediate(arch_aarch64(), 0))
}

test "semantic file operations select exact target ABI" {
  let read_open = buf_new(32)
  cg_emit_platform_open_read(read_open, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(read_open), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 0) band 4294967295, encode_add_imm(1, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 4) band 4294967295, encode_movn(0, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 8) band 4294967295, encode_movz(2, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 12) band 4294967295, encode_movz(3, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 16) band 4294967295, encode_movz(8, 56, 0))

  let create_new = buf_new(32)
  cg_emit_platform_open_write_create_new(create_new, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(create_new), 12) band 4294967295, encode_movz(2, 193, 0))

  let truncate = buf_new(32)
  cg_emit_platform_open_write_create_truncate(truncate, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(truncate), 12) band 4294967295, encode_movz(2, 577, 0))

  let append = buf_new(32)
  cg_emit_platform_open_write_append(append, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(append), 12) band 4294967295, encode_movz(2, 1089, 0))

  let closed = buf_new(16)
  cg_emit_platform_close(closed, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(closed), 0) band 4294967295, encode_movz(8, 57, 0))

  let removed = buf_new(32)
  cg_emit_platform_remove(removed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(removed), 20)
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 0) band 4294967295, encode_add_imm(1, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 4) band 4294967295, encode_movn(0, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 12) band 4294967295, encode_movz(8, 35, 0))

  let renamed = buf_new(32)
  cg_emit_platform_rename(renamed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(renamed), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 0) band 4294967295, encode_add_imm(3, 1, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 12) band 4294967295, encode_movn(2, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 16) band 4294967295, encode_movz(8, 38, 0))

  let darwin_create_new = buf_new(48)
  cg_emit_platform_open_write_create_new(darwin_create_new, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_create_new), 4) band 4294967295, encode_movz(1, 2561, 0))
  Test.assert_eq(emitter_test_buf_word_count(darwin_create_new, encode_movz(16, 5, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_create_new, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)
}

test "semantic I/O error normalization keeps target errno meanings disjoint" {
  let darwin = buf_new(512)
  cg_emit_platform_io_error(darwin, NativeLinkMacosAarch64)
  let linux = buf_new(512)
  cg_emit_platform_io_error(linux, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movn(16, 34)), 1) -- Darwin EAGAIN = 35
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movn(16, 10)), 1) -- Linux EAGAIN = 11
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movn(16, 62)), 1) -- Darwin ENAMETOOLONG = 63
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movn(16, 35)), 1) -- Linux ENAMETOOLONG = 36
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movz(16, 8192, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movz(16, 8192, 0)), 1)
}

test "semantic native host target folds to the emitting target" {
  let darwin = buf_new(16)
  cg_emit_platform_native_host_target(darwin, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin), 0) band 4294967295, encode_movz(0, 1, 0))
  let linux = buf_new(16)
  cg_emit_platform_native_host_target(linux, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux), 0) band 4294967295, encode_movz(0, 2, 0))
  -- The leaf reports storage kinds, so the two targets must stay disjoint or a
  -- cross-built compiler would silently claim the wrong host.
  Test.assert_eq(native_link_target_storage_kind(NativeLinkMacosAarch64), 1)
  Test.assert_eq(native_link_target_storage_kind(NativeLinkLinuxAarch64), 2)
}

test "semantic terminal probe selects exact target ioctl ABI" {
  let darwin = buf_new(128)
  cg_emit_platform_terminal_is_tty(darwin, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movz(1, 29715, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movk(1, 16456, 16)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movz(16, 54, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)

  let linux = buf_new(128)
  cg_emit_platform_terminal_is_tty(linux, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movz(1, 21505, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movz(8, 29, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux, arch_encode_svc_immediate(arch_aarch64(), 0)), 1)
}

test "Linux process entry provisions the shared guarded main stack contract" {
  Test.assert_eq(runtime_main_stack_size(), 67108864)
  Test.assert_eq(runtime_main_stack_guard_size(), 65536)
  let code = buf_new(256)
  emit_linux_main_stack_init(code)
  Test.assert_eq(emitter_test_buf_word_count(code, encode_movz(8, 222, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(code, encode_movz(8, 226, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(code, encode_movz(2, 3, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(code, encode_movz(2, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(code, encode_add_imm(31, 17, 0)), 1)
}

test "native host target decodes the leaf it was emitted from" {
  -- Host-agnostic on purpose: a Darwin-hosted compiler must answer 1 and a
  -- Linux-hosted one 2, so pin the decode rather than either literal.
  let host_kind = sys_native_host_target()
  Test.assert_eq(if host_kind == 1 or host_kind == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(native_link_target_storage_kind(native_link_target_host()), host_kind)
  Test.assert_eq(native_link_target_storage_kind(native_link_target_from_storage_kind(1)), 1)
  Test.assert_eq(native_link_target_storage_kind(native_link_target_from_storage_kind(2)), 2)
}

test "semantic TCP operations select exact target ABI" {
  let darwin_family = buf_new(16)
  cg_emit_platform_tcp_af_inet6(darwin_family, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_family), 0) band 4294967295, encode_movz(0, 30, 0))
  let linux_family = buf_new(16)
  cg_emit_platform_tcp_af_inet6(linux_family, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux_family), 0) band 4294967295, encode_movz(0, 10, 0))

  let darwin_prefix = buf_new(32)
  cg_emit_platform_tcp_sockaddr_prefix(darwin_prefix, NativeLinkMacosAarch64)
  Test.assert_eq(buf_len(darwin_prefix), 12)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_prefix), 0) band 4294967295, encode_movz(16, 8, 0))
  let linux_prefix = buf_new(8)
  cg_emit_platform_tcp_sockaddr_prefix(linux_prefix, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(linux_prefix), 0)

  let socket = buf_new(32)
  cg_emit_platform_tcp_socket(socket, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(socket, encode_movz(8, 198, 0)), 1)
  let connect = buf_new(16)
  cg_emit_platform_tcp_connect(connect, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(connect, encode_movz(8, 203, 0)), 1)
  let bound = buf_new(16)
  cg_emit_platform_tcp_bind(bound, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(bound, encode_movz(8, 200, 0)), 1)
  let listen = buf_new(16)
  cg_emit_platform_tcp_listen(listen, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(listen, encode_movz(8, 201, 0)), 1)
  let accept = buf_new(32)
  cg_emit_platform_tcp_accept(accept, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(accept, encode_movz(8, 202, 0)), 1)
  let shutdown = buf_new(16)
  cg_emit_platform_tcp_shutdown(shutdown, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(shutdown, encode_movz(8, 210, 0)), 1)
  let local = buf_new(16)
  cg_emit_platform_tcp_getsockname(local, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(local, encode_movz(8, 204, 0)), 1)
  let peer = buf_new(16)
  cg_emit_platform_tcp_getpeername(peer, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(peer, encode_movz(8, 205, 0)), 1)

  let linux_keep_alive = buf_new(48)
  cg_emit_platform_tcp_set_keep_alive(linux_keep_alive, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_keep_alive, encode_movz(1, 1, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_keep_alive, encode_movz(2, 9, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_keep_alive, encode_movz(8, 208, 0)), 1)
  let darwin_keep_alive = buf_new(64)
  cg_emit_platform_tcp_set_keep_alive(darwin_keep_alive, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_keep_alive, encode_movz(2, 8, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_keep_alive, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)
}

test "semantic readiness operations select exact kqueue and epoll ABI" {
  let linux_open = buf_new(32)
  cg_emit_platform_net_poller_open(linux_open, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_open, encode_movz(8, 20, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_open, arch_encode_svc_immediate(arch_aarch64(), 0)), 1)

  let darwin_open = buf_new(64)
  cg_emit_platform_net_poller_open(darwin_open, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_open, encode_movz(16, 362, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_open, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)

  let linux_change = buf_new(512)
  cg_emit_platform_net_poller_change(linux_change, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_change, encode_movz(8, 21, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_change, encode_movz(1, 1, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_change, encode_movz(1, 2, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_change, encode_movz(1, 3, 0)), 1)

  let darwin_change = buf_new(512)
  cg_emit_platform_net_poller_change(darwin_change, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_change, encode_movz(16, 363, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_change, encode_movz(17, 277, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_change, encode_movz(17, 258, 0)), 1)

  let linux_wait = buf_new(64)
  cg_emit_platform_net_poller_wait(linux_wait, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_wait, encode_movz(8, 22, 0)), 1)
  let darwin_wait = buf_new(256)
  cg_emit_platform_net_poller_wait(darwin_wait, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_wait, encode_movz(16, 363, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_wait, encode_movz(13, 1000, 0)), 1)

  let linux_error = buf_new(192)
  cg_emit_platform_net_poller_event_error(linux_error, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_error, encode_movz(8, 209, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_error, encode_movz(2, 4, 0)), 1)

  let linux_signal = buf_new(256)
  cg_emit_platform_net_poller_event_signal(linux_signal, NativeLinkLinuxAarch64)
  -- Positive readiness tokens are not signals. The leaf must replace the
  -- incoming event pointer in x0 with semantic zero before its ordinary path.
  Test.assert_eq(
    mem_load64_at(buf_ptr(linux_signal), 4) band 4294967295,
    encode_movz(0, 0, 0)
  )
  Test.assert_eq(emitter_test_buf_word_count(linux_signal, encode_movz(8, 63, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_signal, encode_movz(2, 128, 0)), 1)

  let linux_shutdown = buf_new(1024)
  let linux_shutdown_fm = fmap_new()
  cg_emit_platform_net_poller_enable_shutdown(linux_shutdown, NativeLinkLinuxAarch64, linux_shutdown_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown, encode_movz(8, 74, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown, encode_movz(8, 21, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown, encode_movz(8, 135, 0)), 2)
  Test.assert_eq(fmap_got_patch_count(linux_shutdown_fm), 0)

  let linux_shutdown_disable = buf_new(256)
  cg_emit_platform_net_poller_disable_shutdown(linux_shutdown_disable, NativeLinkLinuxAarch64, linux_shutdown_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown_disable, encode_movz(8, 63, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown_disable, encode_movz(8, 57, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_shutdown_disable, encode_movz(8, 135, 0)), 1)

  let darwin_shutdown = buf_new(2048)
  let darwin_shutdown_fm = fmap_new()
  cg_emit_platform_net_poller_enable_shutdown(darwin_shutdown, NativeLinkMacosAarch64, darwin_shutdown_fm)
  Test.assert_eq(emitter_test_buf_word_count(darwin_shutdown, encode_movz(16, 363, 0)), 3)
  Test.assert_eq(fmap_got_patch_count(darwin_shutdown_fm), 5)
  let darwin_shutdown_disable = buf_new(256)
  cg_emit_platform_net_poller_disable_shutdown(darwin_shutdown_disable, NativeLinkMacosAarch64, darwin_shutdown_fm)
  Test.assert_eq(fmap_got_patch_count(darwin_shutdown_fm), 7)

  let linux_disposition = buf_new(256)
  let linux_fm = fmap_new()
  cg_emit_platform_shutdown_set_disposition(linux_disposition, NativeLinkLinuxAarch64, linux_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_disposition, encode_movz(8, 134, 0)), 1)
  Test.assert_eq(fmap_got_patch_count(linux_fm), 0)
  let darwin_disposition = buf_new(32)
  let darwin_fm = fmap_new()
  cg_emit_platform_shutdown_set_disposition(darwin_disposition, NativeLinkMacosAarch64, darwin_fm)
  Test.assert_eq(fmap_got_patch_count(darwin_fm), 1)
  Test.assert_eq(fmap_got_patch_index(darwin_fm, 0), 39)
}

test "semantic streaming file operations select exact target ABI" {
  let read_write = buf_new(32)
  cg_emit_platform_open_read_write_create_truncate(read_write, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(read_write), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(read_write), 12) band 4294967295, encode_movz(2, 578, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_write), 16) band 4294967295, encode_movz(8, 56, 0))

  let start = buf_new(16)
  cg_emit_platform_seek_start(start, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(start), 12)
  Test.assert_eq(mem_load64_at(buf_ptr(start), 0) band 4294967295, encode_movz(2, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(start), 4) band 4294967295, encode_movz(8, 62, 0))

  let current = buf_new(16)
  cg_emit_platform_seek_current(current, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(current), 0) band 4294967295, encode_movz(2, 1, 0))

  let ended = buf_new(16)
  cg_emit_platform_seek_end(ended, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(ended), 0) band 4294967295, encode_movz(2, 2, 0))

  let flushed = buf_new(16)
  cg_emit_platform_file_flush(flushed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(flushed), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(flushed), 0) band 4294967295, encode_movz(8, 82, 0))

  let darwin_read_write = buf_new(32)
  cg_emit_platform_open_read_write_create_truncate(darwin_read_write, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_read_write), 4) band 4294967295, encode_movz(1, 1538, 0))
}

test "semantic directory operations own target syscalls and layouts" {
  let opened = buf_new(48)
  cg_emit_platform_dir_open(opened, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(opened), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(opened), 8) band 4294967295, encode_movz(2, 16384, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(opened), 16) band 4294967295, encode_movz(8, 56, 0))

  let read = buf_new(16)
  cg_emit_platform_dir_read(read, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(read), 0) band 4294967295, encode_movz(8, 61, 0))

  let record = buf_new(32)
  cg_emit_platform_dir_entry_record_len(record)
  Test.assert_eq(mem_load64_at(buf_ptr(record), 0) band 4294967295, encode_ldrb(16, 0, 16))
  Test.assert_eq(mem_load64_at(buf_ptr(record), 4) band 4294967295, encode_ldrb(17, 0, 17))

  let linux_name = buf_new(8)
  cg_emit_platform_dir_entry_name(linux_name, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux_name), 0) band 4294967295, encode_add_imm(0, 0, 19))
  let darwin_name = buf_new(8)
  cg_emit_platform_dir_entry_name(darwin_name, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_name), 0) band 4294967295, encode_add_imm(0, 0, 21))

  let linux_kind = buf_new(32)
  cg_emit_platform_dir_entry_is_directory(linux_kind, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux_kind), 0) band 4294967295, encode_ldrb(16, 0, 18))
  let darwin_kind = buf_new(32)
  cg_emit_platform_dir_entry_is_directory(darwin_kind, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_kind), 0) band 4294967295, encode_ldrb(16, 0, 20))

  let follow = buf_new(512)
  cg_emit_platform_stat_follow(follow, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_movz(8, 79, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_ldr(10, 15, 48)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_ldr(11, 15, 88)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_str(14, 15, 40)), 1)
  let nofollow = buf_new(512)
  cg_emit_platform_stat_nofollow(nofollow, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(nofollow, encode_movz(3, 256, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(nofollow, encode_movz(8, 79, 0)), 1)

  let mkdir = buf_new(32)
  cg_emit_platform_dir_mkdir(mkdir, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(mkdir, encode_movz(8, 34, 0)), 1)
  let remove_directory = buf_new(32)
  cg_emit_platform_dir_remove_directory(remove_directory, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(remove_directory, encode_movz(2, 512, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(remove_directory, encode_movz(8, 35, 0)), 1)
  let darwin_remove_directory = buf_new(48)
  cg_emit_platform_dir_remove_directory(darwin_remove_directory, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movn(0, 1)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movz(2, 128, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movz(16, 472, 0)), 1)
  let cwd = buf_new(32)
  cg_emit_platform_dir_current(cwd, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(cwd, encode_movz(8, 17, 0)), 1)
  let darwin_cwd = buf_new(256)
  cg_emit_platform_dir_current(darwin_cwd, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(1, 50, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 5, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 92, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 6, 0)), 1)
}

test "semantic time operations select target clocks and boundaries" {
  let linux_realtime = buf_new(64)
  let linux_realtime_fm = fmap_new()
  cg_emit_platform_time_realtime(linux_realtime, NativeLinkLinuxAarch64, linux_realtime_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_realtime, encode_movz(0, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_realtime, encode_movz(8, 113, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_realtime, arch_encode_svc_immediate(arch_aarch64(), 0)), 1)
  Test.assert_eq(fmap_got_patch_count(linux_realtime_fm), 0)

  let linux_monotonic = buf_new(64)
  let linux_monotonic_fm = fmap_new()
  cg_emit_platform_time_monotonic(linux_monotonic, NativeLinkLinuxAarch64, linux_monotonic_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_monotonic, encode_movz(0, 1, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_monotonic, encode_movz(8, 113, 0)), 1)
  Test.assert_eq(fmap_got_patch_count(linux_monotonic_fm), 0)

  let linux_sleep = buf_new(64)
  let linux_sleep_fm = fmap_new()
  cg_emit_platform_time_sleep(linux_sleep, NativeLinkLinuxAarch64, linux_sleep_fm)
  Test.assert_eq(emitter_test_buf_word_count(linux_sleep, encode_movz(8, 101, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_sleep, arch_encode_svc_immediate(arch_aarch64(), 0)), 1)
  Test.assert_eq(fmap_got_patch_count(linux_sleep_fm), 0)

  let darwin_realtime = buf_new(128)
  let darwin_realtime_fm = fmap_new()
  cg_emit_platform_time_realtime(darwin_realtime, NativeLinkMacosAarch64, darwin_realtime_fm)
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, encode_movz(16, 116, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, encode_movk(16, 512, 16)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)
  -- XNU's third gettimeofday argument is an optional mach-absolute-time
  -- output. The semantic leaf must pass NULL rather than an ambient x2.
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, encode_movz(2, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, encode_movz(17, 1000, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_realtime, encode_mul(16, 16, 17)), 1)
  Test.assert_eq(fmap_got_patch_count(darwin_realtime_fm), 0)

  let darwin_monotonic = buf_new(64)
  let darwin_monotonic_fm = fmap_new()
  cg_emit_platform_time_monotonic(darwin_monotonic, NativeLinkMacosAarch64, darwin_monotonic_fm)
  Test.assert_eq(emitter_test_buf_word_count(darwin_monotonic, encode_movz(0, 6, 0)), 1)
  Test.assert_eq(fmap_got_patch_count(darwin_monotonic_fm), 1)
  Test.assert_eq(fmap_got_patch_index(darwin_monotonic_fm, 0), 19)

  let darwin_sleep = buf_new(128)
  let darwin_sleep_fm = fmap_new()
  cg_emit_platform_time_sleep(darwin_sleep, NativeLinkMacosAarch64, darwin_sleep_fm)
  Test.assert_eq(emitter_test_buf_word_count(darwin_sleep, encode_add_imm(4, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_sleep, encode_movz(16, 394, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_sleep, encode_movk(16, 512, 16)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_sleep, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)
  Test.assert_eq(fmap_got_patch_count(darwin_sleep_fm), 0)
}

test "compiler host process and file leaves select target ABI and normalize results" {
  let darwin_id = buf_new(64)
  cg_emit_platform_proc_id(darwin_id, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_id, encode_movz(16, 20, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_id, encode_movk(16, 512, 16)), 1)
  let linux_id = buf_new(32)
  cg_emit_platform_proc_id(linux_id, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_id, encode_movz(8, 172, 0)), 1)

  let darwin_fork = buf_new(128)
  cg_emit_platform_proc_fork(darwin_fork, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_fork, encode_movz(16, 2, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_fork, encode_movz(0, 0, 0)), 1)
  let linux_fork = buf_new(128)
  cg_emit_platform_proc_fork(linux_fork, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_fork, encode_movz(0, 17, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_fork, encode_movz(8, 220, 0)), 1)

  let darwin_group = buf_new(64)
  cg_emit_platform_proc_set_group(darwin_group, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_group, encode_movz(16, 82, 0)), 1)
  let linux_group = buf_new(32)
  cg_emit_platform_proc_set_group(linux_group, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_group, encode_movz(8, 154, 0)), 1)

  let darwin_dup = buf_new(64)
  cg_emit_platform_proc_dup_to(darwin_dup, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_dup, encode_cmp(0, 1)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_dup, encode_movz(16, 90, 0)), 1)
  let linux_dup = buf_new(64)
  cg_emit_platform_proc_dup_to(linux_dup, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_dup, encode_cmp(0, 1)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_dup, encode_movz(8, 24, 0)), 1)

  let darwin_exec = buf_new(64)
  cg_emit_platform_proc_exec(darwin_exec, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_exec, encode_movz(16, 59, 0)), 1)
  let linux_exec = buf_new(32)
  cg_emit_platform_proc_exec(linux_exec, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_exec, encode_movz(8, 221, 0)), 1)

  let darwin_wait = buf_new(64)
  cg_emit_platform_proc_wait_usage(darwin_wait, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_wait, encode_movz(16, 7, 0)), 1)
  let linux_wait = buf_new(128)
  cg_emit_platform_proc_wait_usage(linux_wait, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_wait, encode_movz(8, 260, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_wait, encode_movz(17, 10, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux_wait, encode_lsl_reg(16, 16, 17)), 1)

  let darwin_chmod = buf_new(64)
  cg_emit_platform_file_chmod(darwin_chmod, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_chmod, encode_movz(16, 124, 0)), 1)
  let linux_chmod = buf_new(32)
  cg_emit_platform_file_chmod(linux_chmod, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(linux_chmod, encode_movz(8, 52, 0)), 1)
}

test "semantic thread stacks are target-selected and guarded on Linux" {
  let stack_size = buf_new(32)
  cg_emit_platform_thread_stack_size(stack_size, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(stack_size, encode_movz(0, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(stack_size, encode_movk(0, 129, 16)), 1)

  let guard = buf_new(64)
  cg_emit_platform_thread_stack_guard(guard, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(guard, encode_movz(8, 226, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(guard, arch_encode_svc_immediate(arch_aarch64(), 0)), 1)
}

test "semantic Linux thread create uses clone and a terminal child trampoline" {
  let create = buf_new(512)
  let create_fm = fmap_new()
  cg_emit_platform_thread_create(create, NativeLinkLinuxAarch64, create_fm)
  Test.assert_eq(emitter_test_buf_word_count(create, encode_movz(8, 220, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(create, encode_blr(16)), 1)
  Test.assert_eq(emitter_test_buf_word_count(create, encode_stlr(0, 15)), 1)
  Test.assert_eq(emitter_test_buf_word_count(create, encode_movz(8, 93, 0)), 1)
}

test "semantic Linux join and mutex use acquire release futex policy" {
  let joined = buf_new(256)
  let joined_fm = fmap_new()
  cg_emit_platform_thread_join(joined, NativeLinkLinuxAarch64, joined_fm)
  Test.assert_eq(emitter_test_buf_word_count(joined, encode_movz(8, 98, 0)), 1)
  -- Kernel clear-child-tid wakes the ordinary key, unlike user-space locks.
  Test.assert_eq(emitter_test_buf_word_count(joined, encode_movz(1, 0, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(joined, encode_ldaxr(16, 14)), 1)

  let locked = buf_new(512)
  let locked_fm = fmap_new()
  cg_emit_platform_thread_mutex_lock(locked, NativeLinkLinuxAarch64, locked_fm)
  Test.assert_eq(emitter_test_buf_word_count(locked, encode_movz(8, 98, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(locked, encode_movz(1, 128, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(locked, encode_ldaxr(14, 13)), 2)
}

test "semantic condition wake and Darwin thread policy remain exact" {
  let signaled = buf_new(256)
  let signaled_fm = fmap_new()
  cg_emit_platform_thread_cond_signal(signaled, NativeLinkLinuxAarch64, signaled_fm)
  Test.assert_eq(emitter_test_buf_word_count(signaled, encode_movz(8, 98, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(signaled, encode_movz(1, 129, 0)), 1)

  let darwin_create = buf_new(64)
  let darwin_fm = fmap_new()
  cg_emit_platform_thread_create(darwin_create, NativeLinkMacosAarch64, darwin_fm)
  Test.assert_eq(fmap_got_patch_count(darwin_fm), 1)
  Test.assert_eq(fmap_got_patch_index(darwin_fm, 0), 3)
}

test "elf_aarch64_standalone_executable_has_exact_static_layout" {
  let code = vector_with_capacity<u8>(12)
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  emitter_test_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable(bytes.from_vector(code), 0) {
    ElfExecutableEmitted(image) -> {
      Test.assert_eq(image.len(), 4108)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 0), 127)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 1), 69)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 2), 76)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 3), 70)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 4), 2)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 5), 1)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 16), 2)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 18), 183)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 24), 4198400)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 32), 64)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 52), 64)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 54), 56)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 56), 2)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 64), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 68), 5)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 80), 4194304)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 96), 4108)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 112), 65536)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 120), 1685382481)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 124), 6)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 168), 16)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), arch_encode_movz(arch_aarch64(), 0, 42, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4100), arch_encode_movz(arch_aarch64(), 8, 93, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4104), arch_encode_svc_immediate(arch_aarch64(), 0))
    }
    ElfExecutableInvalidEntryOffset(_, _) -> Test.assert_eq(0, 1)
  }
}

test "elf_aarch64_standalone_executable_returns_typed_entry_residual" {
  let code = vector_with_capacity<u8>(4)
  emitter_test_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable(bytes.from_vector(code), 4) {
    ElfExecutableEmitted(_) -> Test.assert_eq(0, 1)
    ElfExecutableInvalidEntryOffset(offset, code_size) -> {
      Test.assert_eq(offset, 4)
      Test.assert_eq(code_size, 4)
    }
  }
}

test "elf_aarch64_dwarf_sections_are_non_loaded_and_named" {
  let code = vector_with_capacity<u8>(12)
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  emitter_test_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable_with_zero_fill_and_dwarf(
    bytes.from_vector(code),
    0,
    0,
    bytes.from_str("A"),
    bytes.from_str("BC"),
    bytes.from_str("DEF")
  ) {
    ElfExecutableEmitted(image) -> {
      let section_headers = emitter_test_bytes_u64_at(image, 40)
      Test.assert_eq(image.len(), 4488)
      Test.assert_eq(section_headers, 4168)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 58), 64)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 60), 5)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 62), 4)
      Test.assert_eq(emitter_test_bytes_u32_at(image, section_headers + 64), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, section_headers + 68), 1)
      Test.assert_eq(emitter_test_bytes_u64_at(image, section_headers + 88), 4108)
      Test.assert_eq(emitter_test_bytes_u64_at(image, section_headers + 96), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, section_headers + 256), 39)
      Test.assert_eq(emitter_test_bytes_u32_at(image, section_headers + 260), 3)
      Test.assert_eq(emitter_test_bytes_u64_at(image, section_headers + 280), 4114)
      Test.assert_eq(emitter_test_bytes_u64_at(image, section_headers + 288), 49)
    }
    ElfExecutableInvalidEntryOffset(_, _) -> Test.assert_eq(0, 1)
  }
}

test "elf_native_link_finalizer_consumes_closed_linux_graph" {
  let code = buf_new(12)
  bu32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  bu32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  bu32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  let graph = NativeLinkGraph(
    NativeLinkLinuxAarch64,
    NativeArtifactLinuxKernelAbi(3, 7, 0),
    NativeLinkDebugInformationAbsent,
    NativeArtifactUnsigned,
    list_nil<NativeArtifactTrustGrant>(),
    code,
    buf_new(0),
    NativeLinkImageLayout(0, 0, 0, 0, 0, 0, 0, 0, 0),
    list_nil<NativeLinkLibrary>(),
    list_nil<NativeLinkPlacedMember>(),
    list_nil<NativeLinkSymbol>(),
    list_nil<NativeLinkRelocation>(),
    0
  )
  match emit_native_link_elf(graph) {
    ElfNativeLinkEmitted(image) -> {
      Test.assert_eq(image.len(), 4108)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 24), 4198400)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), arch_encode_movz(arch_aarch64(), 0, 42, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4104), arch_encode_svc_immediate(arch_aarch64(), 0))
    }
    _ -> Test.assert_eq(0, 1)
  }

  let static_code = buf_new(12)
  bu32(static_code, encode_adrp(17, 0))
  bu32(static_code, encode_add_imm(17, 17, 0))
  bu32(static_code, arch_encode_svc_immediate(arch_aarch64(), 0))
  let static_graph = NativeLinkGraph(
    NativeLinkLinuxAarch64,
    NativeArtifactLinuxKernelAbi(3, 7, 0),
    NativeLinkDebugInformationAbsent,
    NativeArtifactUnsigned,
    list_nil<NativeArtifactTrustGrant>(),
    static_code,
    buf_new(0),
    native_link_image_layout(static_code, buf_new(0), 0, 0, 1),
    list_nil<NativeLinkLibrary>(),
    list_nil<NativeLinkPlacedMember>(),
    list_nil<NativeLinkSymbol>(),
    list_cons<NativeLinkRelocation>(
    NativeLinkPageAddress(0, NativeLinkStaticAddress(0)),
    list_nil<NativeLinkRelocation>()
  ),
    1
  )
  match emit_native_link_elf(static_graph) {
    ElfNativeLinkEmitted(image) -> {
      Test.assert_eq(image.len(), 65536)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 56), 3)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 120), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 124), 6)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 128), 65536)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 136), 4259840)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 152), 0)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 160), 16)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 168), 65536)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 176), 1685382481)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), encode_adrp(17, 15))
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "linux_native_link_policy_rejects_darwin_library_before_graph_closure" {
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_nil<NativeLinkLibrary>()
  )
  match native_link_resolve(NativeLinkPlan(NativeLinkLinuxAarch64, buf_new(4), libraries, list_nil<NativeLinkImport>(), list_nil<NativeLinkPlanRelocation>(), 0, NativeLinkDebugInformationAbsent, list_nil<NativeArtifactTrustGrant>())) {
    NativeLinkSucceeded(_, _) -> Test.assert_eq(0, 1)
    NativeLinkRejected(errors) -> match errors {
      Cons(NativeLinkUnsupportedTargetLibrary(NativeLinkLinuxAarch64, name), Nil) -> Test.assert_str_eq(name, "System")
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "linux_native_link_parses_typed_elf_code_object_facts" {
  let bytes = native_link_test_elf_code_object(0)
  match native_link_elf_object_parse(buf_ptr(bytes), buf_len(bytes)) {
    NativeLinkElfObjectMalformed -> Test.assert_eq(0, 1)
    NativeLinkElfObjectParsed(elf) -> {
      let object = NativeLinkElfRelocatableObject(elf)
      Test.assert_eq(native_link_object_text_offset(object), 64)
      Test.assert_eq(native_link_object_text_size(object), 8)
      Test.assert_eq(native_link_object_text_align(object), 2)
      Test.assert_eq(native_link_object_symbol_count(object), 2)
      Test.assert_str_eq(native_link_test_view_str(native_link_object_symbol_view(object, 1)), "weft_linux_archive_value")
      match native_link_object_symbol_definition(object, 1) {
        NativeLinkStrongObjectDefinition(index) -> {
          Test.assert_eq(index, 1)
          Test.assert_eq(native_link_object_symbol_is_text_definition(object, index), 1)
          Test.assert_eq(native_link_object_code_address(object, NativeLinkStrongObjectDefinition(index), 12), 12)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
  }
}

test "linux_native_link_does_not_guess_elf_object_format_for_macos" {
  let bytes = native_link_test_elf_code_object(0)
  match native_link_object_parse_for_target(buf_ptr(bytes), buf_len(bytes), NativeLinkMacosAarch64) {
    NativeLinkObjectMalformed -> Test.assert_eq(1, 1)
    NativeLinkObjectParsed(object) -> Test.assert_eq(0, 1)
  }
}

test "linux_native_link_preserves_leading_underscore_as_symbol_identity" {
  let bytes = native_link_test_elf_code_object(0)
  mem_store8_at(buf_ptr(bytes), 73, 95)
  match native_link_elf_object_parse(buf_ptr(bytes), buf_len(bytes)) {
    NativeLinkElfObjectMalformed -> Test.assert_eq(0, 1)
    NativeLinkElfObjectParsed(elf) -> {
      let object = NativeLinkElfRelocatableObject(elf)
      Test.assert_eq(native_link_object_symbol_matches_name(object, 1, "_eft_linux_archive_value"), 1)
      Test.assert_eq(native_link_object_symbol_matches_name(object, 1, "eft_linux_archive_value"), 0)
      Test.assert_str_eq(native_link_object_symbol_name(object, 1), "_eft_linux_archive_value")
    }
  }
}

test "linux_native_link_preserves_initialized_elf_data_section_facts" {
  let bytes = native_link_test_elf_code_object(1)
  match native_link_elf_object_parse(buf_ptr(bytes), buf_len(bytes)) {
    NativeLinkElfObjectMalformed -> Test.assert_eq(0, 1)
    NativeLinkElfObjectParsed(elf) -> match native_link_object_data(NativeLinkElfRelocatableObject(elf)) {
      Cons(NativeLinkElfDataBytes(address, size, offset, align, section, relaoff, nrela), Nil) -> {
        Test.assert_eq(address, 0)
        Test.assert_eq(size, 1)
        Test.assert_eq(offset, 176)
        Test.assert_eq(align, 0)
        Test.assert_eq(section, 4)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "linux_native_link_preserves_zero_fill_elf_data_section_facts" {
