use stdlib/vector.{*}

fn encoder_expect_immediate_tripwire(word: i64) -[Test]> i64 {
  Test.assert_eq(word, 3560891040)
}

fn native_link_test_dylib_command(output: i64, command: i64, identity: str) -> i64 {
  let start = buf_len(output)
  let size = native_link_dylib_command_size(identity)
  bu32(output, command)
  bu32(output, size)
  bu32(output, 24)
  bu32(output, 0)
  bu32(output, 0)
  bu32(output, 0)
  bstr(output, identity)
  bu8(output, 0)
  bpad(output, start + size)
  0
}

fn native_link_test_dynamic_image() -> i64 {
  let commands = buf_new(512)
  native_link_test_dylib_command(commands, 13, "/fixture/libowner.dylib")
  native_link_test_dylib_command(commands, 12, "/fixture/librequired.dylib")
  native_link_test_dylib_command(commands, 2147483672, "/fixture/libweak.dylib")
  native_link_test_dylib_command(commands, 2147483679, "/fixture/libreexport.dylib")
  native_link_test_dylib_command(commands, 2147483683, "/fixture/libupward.dylib")
  native_link_test_dylib_command(commands, 32, "/fixture/liblazy.dylib")
  let image = buf_new(544)
  bu32(image, 4277009103)
  bu32(image, 16777228)
  bu32(image, 0)
  bu32(image, 6)
  bu32(image, 6)
  bu32(image, buf_len(commands))
  bu32(image, 0)
  bu32(image, 0)
  bscopy(image, buf_ptr(commands), buf_len(commands), 0)
  image
}

fn native_link_test_view_str(view: NativeLinkByteView) -> str {
  pkg_str_view(native_link_byte_view_ptr(view), native_link_byte_view_len(view))
}

fn emitter_test_append_u32(output: Vector<u8>, value: i64) -> i64 {
  vector_push<u8>(output, num_int_cast_value_or<u8>(num_i64_to_u8_checked(value - value / 256 * 256), 0))
  vector_push<u8>(output, num_int_cast_value_or<u8>(num_i64_to_u8_checked(value / 256 - value / 65536 * 256), 0))
  vector_push<u8>(output, num_int_cast_value_or<u8>(num_i64_to_u8_checked(value / 65536 - value / 16777216 * 256), 0))
  vector_push<u8>(output, num_int_cast_value_or<u8>(num_i64_to_u8_checked(value / 16777216 - value / 4294967296 * 256), 0))
}

fn emitter_test_bytes_byte_at(values: Bytes, offset: i64) -> i64 {
  match bytes_get(values, offset) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0 - 1
  }
}

fn emitter_test_bytes_u16_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_byte_at(values, offset) + emitter_test_bytes_byte_at(values, offset + 1) * 256
}

fn emitter_test_bytes_u32_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_u16_at(values, offset) + emitter_test_bytes_u16_at(values, offset + 2) * 65536
}

fn emitter_test_bytes_u64_at(values: Bytes, offset: i64) -> i64 {
  emitter_test_bytes_u32_at(values, offset) + emitter_test_bytes_u32_at(values, offset + 4) * 4294967296
}

fn emitter_test_buf_word_count(values: i64, word: i64) -> i64 {
  let mut count = 0
  for offset in 0..(buf_len(values) / 4) {
    if (mem_load64_at(buf_ptr(values), offset * 4) band 4294967295) == word {
      count = count + 1
    } else { 0 }
  }
  count
}

test "arch_aarch64_encodes_core_instruction_matrix" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_is_supported(arch), 1)
  Test.assert_eq(arch_name_len_or(arch, 0 - 1), __str_len("aarch64"))
  Test.assert_eq(arch_encode_movz(arch, 0, 42, 0), 3531603968 + 42 * 32)
  Test.assert_eq(arch_encode_movk(arch, 1, 7, 16), 4068474880 + 2097152 + 7 * 32 + 1)
  Test.assert_eq(arch_encode_add_imm(arch, 2, 3, 4), 2432696320 + 4 * 1024 + 3 * 32 + 2)
  Test.assert_eq(arch_encode_str(arch, 4, 5, 16), 4177526784 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_ldr(arch, 4, 5, 16), 4181721088 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_stp_d_pre(arch, 8, 9, 31, 0 - 16), 1841244136)
  Test.assert_eq(arch_encode_ldp_d_post(arch, 8, 9, 31, 16), 1824597992)
}

test "arch_aarch64_svc_immediate_is_validated_and_target_selected" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_encode_svc_immediate(arch, 0), 3556769793)
  Test.assert_eq(arch_encode_svc_immediate(arch, 65535), 3556769793 + 65535 * 32)
  Test.assert_eq(arch_encode_svc_immediate(arch, 0 - 1), arch_encode_brk(arch, 21))
  Test.assert_eq(arch_encode_svc_immediate(arch, 65536), arch_encode_brk(arch, 21))
  Test.assert_eq(arch_encode_svc(arch), 3556773889)
  Test.assert_eq(arch_encode_svc_immediate(arch_x8664(), 0), 0)
}

test "semantic anonymous mapping selects exact target ABI" {
  Test.assert_eq(cg_target_mmap_flags(NativeLinkMacosAarch64), 4098)
  Test.assert_eq(cg_target_mmap_flags(NativeLinkLinuxAarch64), 34)

  let mapped = buf_new(32)
  cg_emit_platform_map_rw_anonymous(mapped, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(mapped), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 0) band 4294967295, encode_movz(2, 3, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 4) band 4294967295, encode_movz(3, 34, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 8) band 4294967295, encode_movn(4, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 12) band 4294967295, encode_movz(5, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 16) band 4294967295, encode_movz(8, 222, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(mapped), 20) band 4294967295, arch_encode_svc_immediate(arch_aarch64(), 0))

  let remapped = buf_new(32)
  cg_emit_platform_remap_rw_anonymous_fixed(remapped, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(remapped), 4) band 4294967295, encode_movz(3, 50, 0))

  let unmapped = buf_new(16)
  cg_emit_platform_unmap(unmapped, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(unmapped), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(unmapped), 0) band 4294967295, encode_movz(8, 215, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(unmapped), 4) band 4294967295, arch_encode_svc_immediate(arch_aarch64(), 0))
}

test "semantic file operations select exact target ABI" {
  let read_open = buf_new(32)
  cg_emit_platform_open_read(read_open, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(read_open), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 0) band 4294967295, encode_add_imm(1, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 4) band 4294967295, encode_movn(0, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 8) band 4294967295, encode_movz(2, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 12) band 4294967295, encode_movz(3, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_open), 16) band 4294967295, encode_movz(8, 56, 0))

  let create_new = buf_new(32)
  cg_emit_platform_open_write_create_new(create_new, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(create_new), 12) band 4294967295, encode_movz(2, 193, 0))

  let truncate = buf_new(32)
  cg_emit_platform_open_write_create_truncate(truncate, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(truncate), 12) band 4294967295, encode_movz(2, 577, 0))

  let append = buf_new(32)
  cg_emit_platform_open_write_append(append, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(append), 12) band 4294967295, encode_movz(2, 1089, 0))

  let closed = buf_new(16)
  cg_emit_platform_close(closed, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(closed), 0) band 4294967295, encode_movz(8, 57, 0))

  let removed = buf_new(32)
  cg_emit_platform_remove(removed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(removed), 20)
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 0) band 4294967295, encode_add_imm(1, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 4) band 4294967295, encode_movn(0, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(removed), 12) band 4294967295, encode_movz(8, 35, 0))

  let renamed = buf_new(32)
  cg_emit_platform_rename(renamed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(renamed), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 0) band 4294967295, encode_add_imm(3, 1, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 12) band 4294967295, encode_movn(2, 99))
  Test.assert_eq(mem_load64_at(buf_ptr(renamed), 16) band 4294967295, encode_movz(8, 38, 0))

  let darwin_create_new = buf_new(48)
  cg_emit_platform_open_write_create_new(darwin_create_new, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_create_new), 4) band 4294967295, encode_movz(1, 2561, 0))
  Test.assert_eq(emitter_test_buf_word_count(darwin_create_new, encode_movz(16, 5, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_create_new, arch_encode_svc_immediate(arch_aarch64(), 128)), 1)
}

test "semantic I/O error normalization keeps target errno meanings disjoint" {
  let darwin = buf_new(512)
  cg_emit_platform_io_error(darwin, NativeLinkMacosAarch64)
  let linux = buf_new(512)
  cg_emit_platform_io_error(linux, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movn(16, 34)), 1) -- Darwin EAGAIN = 35
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movn(16, 10)), 1) -- Linux EAGAIN = 11
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movn(16, 62)), 1) -- Darwin ENAMETOOLONG = 63
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movn(16, 35)), 1) -- Linux ENAMETOOLONG = 36
  Test.assert_eq(emitter_test_buf_word_count(darwin, encode_movz(16, 8192, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(linux, encode_movz(16, 8192, 0)), 1)
}

test "semantic streaming file operations select exact target ABI" {
  let read_write = buf_new(32)
  cg_emit_platform_open_read_write_create_truncate(read_write, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(read_write), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(read_write), 12) band 4294967295, encode_movz(2, 578, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(read_write), 16) band 4294967295, encode_movz(8, 56, 0))

  let start = buf_new(16)
  cg_emit_platform_seek_start(start, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(start), 12)
  Test.assert_eq(mem_load64_at(buf_ptr(start), 0) band 4294967295, encode_movz(2, 0, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(start), 4) band 4294967295, encode_movz(8, 62, 0))

  let current = buf_new(16)
  cg_emit_platform_seek_current(current, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(current), 0) band 4294967295, encode_movz(2, 1, 0))

  let ended = buf_new(16)
  cg_emit_platform_seek_end(ended, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(ended), 0) band 4294967295, encode_movz(2, 2, 0))

  let flushed = buf_new(16)
  cg_emit_platform_file_flush(flushed, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(flushed), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(flushed), 0) band 4294967295, encode_movz(8, 82, 0))

  let darwin_read_write = buf_new(32)
  cg_emit_platform_open_read_write_create_truncate(darwin_read_write, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_read_write), 4) band 4294967295, encode_movz(1, 1538, 0))
}

test "semantic directory operations own target syscalls and layouts" {
  let opened = buf_new(48)
  cg_emit_platform_dir_open(opened, NativeLinkLinuxAarch64)
  Test.assert_eq(buf_len(opened), 24)
  Test.assert_eq(mem_load64_at(buf_ptr(opened), 8) band 4294967295, encode_movz(2, 16384, 0))
  Test.assert_eq(mem_load64_at(buf_ptr(opened), 16) band 4294967295, encode_movz(8, 56, 0))

  let read = buf_new(16)
  cg_emit_platform_dir_read(read, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(read), 0) band 4294967295, encode_movz(8, 61, 0))

  let record = buf_new(32)
  cg_emit_platform_dir_entry_record_len(record)
  Test.assert_eq(mem_load64_at(buf_ptr(record), 0) band 4294967295, encode_ldrb(16, 0, 16))
  Test.assert_eq(mem_load64_at(buf_ptr(record), 4) band 4294967295, encode_ldrb(17, 0, 17))

  let linux_name = buf_new(8)
  cg_emit_platform_dir_entry_name(linux_name, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux_name), 0) band 4294967295, encode_add_imm(0, 0, 19))
  let darwin_name = buf_new(8)
  cg_emit_platform_dir_entry_name(darwin_name, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_name), 0) band 4294967295, encode_add_imm(0, 0, 21))

  let linux_kind = buf_new(32)
  cg_emit_platform_dir_entry_is_directory(linux_kind, NativeLinkLinuxAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(linux_kind), 0) band 4294967295, encode_ldrb(16, 0, 18))
  let darwin_kind = buf_new(32)
  cg_emit_platform_dir_entry_is_directory(darwin_kind, NativeLinkMacosAarch64)
  Test.assert_eq(mem_load64_at(buf_ptr(darwin_kind), 0) band 4294967295, encode_ldrb(16, 0, 20))

  let follow = buf_new(512)
  cg_emit_platform_stat_follow(follow, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_movz(8, 79, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_ldr(10, 15, 48)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_ldr(11, 15, 88)), 1)
  Test.assert_eq(emitter_test_buf_word_count(follow, encode_str(14, 15, 40)), 1)
  let nofollow = buf_new(512)
  cg_emit_platform_stat_nofollow(nofollow, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(nofollow, encode_movz(3, 256, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(nofollow, encode_movz(8, 79, 0)), 1)

  let mkdir = buf_new(32)
  cg_emit_platform_dir_mkdir(mkdir, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(mkdir, encode_movz(8, 34, 0)), 1)
  let remove_directory = buf_new(32)
  cg_emit_platform_dir_remove_directory(remove_directory, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(remove_directory, encode_movz(2, 512, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(remove_directory, encode_movz(8, 35, 0)), 1)
  let darwin_remove_directory = buf_new(48)
  cg_emit_platform_dir_remove_directory(darwin_remove_directory, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movn(0, 1)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movz(2, 128, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_remove_directory, encode_movz(16, 472, 0)), 1)
  let cwd = buf_new(32)
  cg_emit_platform_dir_current(cwd, NativeLinkLinuxAarch64)
  Test.assert_eq(emitter_test_buf_word_count(cwd, encode_movz(8, 17, 0)), 1)
  let darwin_cwd = buf_new(256)
  cg_emit_platform_dir_current(darwin_cwd, NativeLinkMacosAarch64)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(1, 50, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 5, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 92, 0)), 1)
  Test.assert_eq(emitter_test_buf_word_count(darwin_cwd, encode_movz(16, 6, 0)), 1)
}

test "elf_aarch64_standalone_executable_has_exact_static_layout" {
  let code = vector_with_capacity<u8>(12)
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  emitter_test_append_u32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  emitter_test_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable(bytes_from_vector(code), 0) {
    ElfExecutableEmitted(image) -> {
      Test.assert_eq(bytes_len(image), 4108)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 0), 127)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 1), 69)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 2), 76)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 3), 70)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 4), 2)
      Test.assert_eq(emitter_test_bytes_byte_at(image, 5), 1)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 16), 2)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 18), 183)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 24), 4198400)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 32), 64)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 52), 64)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 54), 56)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 56), 2)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 64), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 68), 5)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 80), 4194304)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 96), 4108)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 112), 65536)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 120), 1685382481)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 124), 6)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 168), 16)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), arch_encode_movz(arch_aarch64(), 0, 42, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4100), arch_encode_movz(arch_aarch64(), 8, 93, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4104), arch_encode_svc_immediate(arch_aarch64(), 0))
    }
    ElfExecutableInvalidEntryOffset(_, _) -> Test.assert_eq(0, 1)
  }
}

test "elf_aarch64_standalone_executable_returns_typed_entry_residual" {
  let code = vector_with_capacity<u8>(4)
  emitter_test_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable(bytes_from_vector(code), 4) {
    ElfExecutableEmitted(_) -> Test.assert_eq(0, 1)
    ElfExecutableInvalidEntryOffset(offset, code_size) -> {
      Test.assert_eq(offset, 4)
      Test.assert_eq(code_size, 4)
    }
  }
}

test "elf_native_link_finalizer_consumes_closed_linux_graph" {
  let code = buf_new(12)
  bu32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  bu32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  bu32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  let graph = NativeLinkGraph(
    NativeLinkLinuxAarch64,
    NativeArtifactLinuxKernelAbi(3, 7, 0),
    NativeLinkDebugInformationAbsent,
    NativeArtifactUnsigned,
    list_nil<NativeArtifactTrustGrant>(),
    code,
    buf_new(0),
    NativeLinkImageLayout(0, 0, 0, 0, 0, 0, 0, 0, 0),
    list_nil<NativeLinkLibrary>(),
    list_nil<NativeLinkPlacedMember>(),
    list_nil<NativeLinkSymbol>(),
    list_nil<NativeLinkRelocation>(),
    0
  )
  match emit_native_link_elf(graph) {
    ElfNativeLinkEmitted(image) -> {
      Test.assert_eq(bytes_len(image), 4108)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 24), 4198400)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), arch_encode_movz(arch_aarch64(), 0, 42, 0))
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4104), arch_encode_svc_immediate(arch_aarch64(), 0))
    }
    _ -> Test.assert_eq(0, 1)
  }

  let static_code = buf_new(12)
  bu32(static_code, encode_adrp(17, 0))
  bu32(static_code, encode_add_imm(17, 17, 0))
  bu32(static_code, arch_encode_svc_immediate(arch_aarch64(), 0))
  let static_graph = NativeLinkGraph(
    NativeLinkLinuxAarch64,
    NativeArtifactLinuxKernelAbi(3, 7, 0),
    NativeLinkDebugInformationAbsent,
    NativeArtifactUnsigned,
    list_nil<NativeArtifactTrustGrant>(),
    static_code,
    buf_new(0),
    native_link_image_layout(static_code, buf_new(0), 0, 0, 1),
    list_nil<NativeLinkLibrary>(),
    list_nil<NativeLinkPlacedMember>(),
    list_nil<NativeLinkSymbol>(),
    list_cons<NativeLinkRelocation>(
      NativeLinkPageAddress(0, NativeLinkStaticAddress(0)),
      list_nil<NativeLinkRelocation>()
    ),
    1
  )
  match emit_native_link_elf(static_graph) {
    ElfNativeLinkEmitted(image) -> {
      Test.assert_eq(bytes_len(image), 65536)
      Test.assert_eq(emitter_test_bytes_u16_at(image, 56), 3)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 120), 1)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 124), 6)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 128), 65536)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 136), 4259840)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 152), 0)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 160), 16)
      Test.assert_eq(emitter_test_bytes_u64_at(image, 168), 65536)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 176), 1685382481)
      Test.assert_eq(emitter_test_bytes_u32_at(image, 4096), encode_adrp(17, 15))
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "linux_native_link_policy_rejects_darwin_library_before_graph_closure" {
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_nil<NativeLinkLibrary>()
  )
  match native_link_resolve(NativeLinkPlan(NativeLinkLinuxAarch64, buf_new(4), libraries, list_nil<NativeLinkImport>(), list_nil<NativeLinkPlanRelocation>(), 0, NativeLinkDebugInformationAbsent, list_nil<NativeArtifactTrustGrant>())) {
    NativeLinkSucceeded(_, _) -> Test.assert_eq(0, 1)
    NativeLinkRejected(errors) -> match errors {
      Cons(NativeLinkUnsupportedTargetLibrary(NativeLinkLinuxAarch64, name), Nil) -> Test.assert_str_eq(name, "System")
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "arch_aarch64_encodes_arithmetic_and_branch_matrix" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_encode_add_reg(arch, 1, 2, 3), 2332033024 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_sub_reg(arch, 1, 2, 3), 3405774848 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_mul(arch, 1, 2, 3), 2600500224 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_sdiv(arch, 1, 2, 3), 2596277248 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_udiv(arch, 1, 2, 3), 2596276224 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_cmp(arch, 2, 3), 3942645791 + 3 * 65536 + 2 * 32)
  Test.assert_eq(arch_encode_fmov_d_from_d(arch, 3, 1), 509624320 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_s_from_w(arch, 3, 1), 505872384 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_w_from_s(arch, 3, 1), 505806848 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_s_from_s(arch, 3, 1), 505430016 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_scvtf_s_from_x(arch, 3, 1), 2653028352 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_ucvtf_s_from_x(arch, 3, 1), 2653093888 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvtzs_x_from_s(arch, 3, 1), 2654470144 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_ucvtf_d_from_x(arch, 3, 1), 2657288192 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvt_d_from_s(arch, 3, 1), 505593856 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvt_s_from_d(arch, 3, 1), 509755392 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fadd_s(arch, 1, 2, 3), 505423872 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fsub_s(arch, 1, 2, 3), 505427968 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fmul_s(arch, 1, 2, 3), 505415680 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fdiv_s(arch, 1, 2, 3), 505419776 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fcmp_s(arch, 2, 3), 505421824 + 3 * 65536 + 2 * 32)
  Test.assert_eq(arch_encode_fsqrt_d(arch, 3, 1), 509722624 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fsqrt_s(arch, 3, 1), 505528320 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxtb(arch, 3, 1), 2470452224 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxth(arch, 3, 1), 2470460416 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxtw(arch, 3, 1), 2470476800 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxtb(arch, 3, 1), 1392516096 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxth(arch, 3, 1), 1392524288 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxtw(arch, 3, 1), 3544218624 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_lsr_reg(arch, 1, 2, 3), 2596283392 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_b(arch, 8), 335544320 + 2)
  Test.assert_eq(arch_encode_b_cond(arch, 8, 0), 1409286144 + 2 * 32)
  Test.assert_eq(arch_encode_blr(arch, 9), 3594452992 + 9 * 32)
}

test "arch_aarch64_encodes_link_stub_branch_without_replacing_lr" {
  Test.assert_eq(arch_encode_br(arch_aarch64(), 16), 3592356352)
  Test.assert_eq(arch_encode_br(arch_x8664(), 16), 0)
}

test "native_link_resolves_reachable_import_once_and_preserves_relocations" {
  let code = buf_new(16)
  bu32(code, encode_bl(0))
  bu32(code, encode_bl(0))
  bu32(code, encode_adrp(17, 0))
  bu32(code, encode_add_imm(17, 17, 0))
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_nil<NativeLinkLibrary>()
  )
  let imports = list_cons<NativeLinkImport>(
    NativeLinkImport("write", 0, NativeLinkRuntimeImport),
    list_nil<NativeLinkImport>()
  )
  let relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(0, 0),
    list_cons<NativeLinkPlanRelocation>(
      NativeLinkPlanBranch26(4, 0),
      list_cons<NativeLinkPlanRelocation>(NativeLinkPlanPageAddress(8, NativeLinkCodeAddress(0)), list_nil<NativeLinkPlanRelocation>())
    )
  )
  let trust_grants = list_cons<NativeArtifactTrustGrant>(
    NativeArtifactTrustGrant("fixture", "1.0.0", "path:fixture", "sha256:fixture", "native/raw"),
    list_nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(NativeLinkPlan(NativeLinkMacosAarch64, code, libraries, imports, relocations, 0, NativeLinkDebugInformationAbsent, trust_grants)) {
    NativeLinkSucceeded(graph, facts) -> {
      Test.assert_eq(native_link_graph_symbol_count(graph), 1)
      Test.assert_eq(native_link_graph_relocation_count(graph), 3)
      Test.assert_eq(native_link_artifact_is_standalone(facts), true)
      match native_link_artifact_platform_abi(facts) {
        NativeArtifactMacosPlatformAbi(major, minor, patch) -> {
          Test.assert_eq(major, 11)
          Test.assert_eq(minor, 0)
          Test.assert_eq(patch, 0)
        }
        NativeArtifactLinuxKernelAbi(major, minor, patch) -> Test.assert_eq(1, 0)
        NativeArtifactPlatformAbiUnspecified -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_trust_grants(facts) {
        Cons(NativeArtifactTrustGrant(package_name, version, source, content, module), Nil) -> {
          Test.assert_str_eq(package_name, "fixture")
          Test.assert_str_eq(version, "1.0.0")
          Test.assert_str_eq(source, "path:fixture")
          Test.assert_str_eq(content, "sha256:fixture")
          Test.assert_str_eq(module, "native/raw")
        }
        _ -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_debug_information(facts) {
        NativeArtifactDebugInformationAbsent -> Test.assert_eq(1, 1)
        NativeArtifactDwarfInformation(version) -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_signing(facts) {
        NativeArtifactAdHocSigning(identity, digest) -> {
          Test.assert_str_eq(identity, "weft")
          Test.assert_str_eq(digest, "sha256")
        }
        NativeArtifactUnsigned -> Test.assert_eq(1, 0)
      }
      Test.assert_eq(if buf_len(emit_native_link_macho(graph)) > 0 { 1 } else { 0 }, 1)
    }
    NativeLinkRejected(errors) -> Test.assert_eq(list_len<NativeLinkError>(errors), 0)
  }
}

test "native_link_debug_facts_emit_versioned_function_file_line_sections" {
  let functions = list_cons<NativeLinkDebugFunction>(
    NativeLinkDebugFunction(96, 112, "leaf", "src/leaf.weft", 7, 2, false),
    list_cons<NativeLinkDebugFunction>(
      NativeLinkDebugFunction(64, 96, "framed", "src/main.weft", 130, 4, true),
      list_nil<NativeLinkDebugFunction>()
    )
  )
  let debug_information = NativeLinkDwarfFunctionLineInformation(functions)
  match native_link_debug_artifact_information(debug_information) {
    NativeArtifactDwarfInformation(version) -> Test.assert_str_eq(version, "dwarf-v4-function-file-line")
    NativeArtifactDebugInformationAbsent -> Test.assert_eq(1, 0)
  }
  let files = native_dwarf_collect_files(functions)
  Test.assert_eq(list_len<str>(files), 2)
  Test.assert_eq(native_dwarf_file_index(files, "src/leaf.weft", 1), 1)
  Test.assert_eq(native_dwarf_file_index(files, "src/main.weft", 1), 2)
  Test.assert_eq(native_dwarf_low_pc(functions), 64)
  Test.assert_eq(native_dwarf_high_pc(functions), 112)
  let sections = native_dwarf_sections(debug_information, 4294983680)
  let abbrev = native_dwarf_abbrev(sections)
  let info = native_dwarf_info(sections)
  let line = native_dwarf_line(sections)
  Test.assert_eq(if buf_len(abbrev) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64_at(buf_ptr(info), 0) band 4294967295, buf_len(info) - 4)
  Test.assert_eq(mem_load8_at(buf_ptr(info), 4) + mem_load8_at(buf_ptr(info), 5) * 256, 4)
  Test.assert_eq(mem_load64_at(buf_ptr(line), 0) band 4294967295, buf_len(line) - 4)
  Test.assert_eq(mem_load8_at(buf_ptr(line), 4) + mem_load8_at(buf_ptr(line), 5) * 256, 4)
}

test "native_link_parses_dynamic_identity_and_all_load_command_variants" {
  let bytes = native_link_test_dynamic_image()
  match native_link_macho_dynamic_image(buf_ptr(bytes), buf_len(bytes)) {
    NativeLinkDynamicImageParsed(image) -> {
      Test.assert_eq(str_eq(native_link_test_view_str(native_link_dynamic_image_identity(image)), "/fixture/libowner.dylib"), 1)
      match native_link_dynamic_image_loads(image) {
        Cons(NativeLinkRequiredDynamicLoad(required), Cons(NativeLinkWeakDynamicLoad(weak), Cons(NativeLinkReexportDynamicLoad(reexport), Cons(NativeLinkUpwardDynamicLoad(upward), Cons(NativeLinkLazyDynamicLoad(lazy), Nil))))) -> {
          Test.assert_eq(str_eq(native_link_test_view_str(required), "/fixture/librequired.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(weak), "/fixture/libweak.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(reexport), "/fixture/libreexport.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(upward), "/fixture/libupward.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(lazy), "/fixture/liblazy.dylib"), 1)
        }
        _ -> Test.assert_eq(1, 0)
      }
    }
    _ -> Test.assert_eq(1, 0)
  }
}

test "native_link_rejects_undeclared_dynamic_image_dependency" {
  let dependency_identity = "/fixture/libdependency.dylib"
  let loads = list_cons<NativeLinkDynamicLoad>(
    NativeLinkRequiredDynamicLoad(NativeLinkByteView(__str_ptr(dependency_identity), __str_len(dependency_identity))),
    list_nil<NativeLinkDynamicLoad>()
  )
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_cons<NativeLinkLibrary>(
      NativeLinkDynamicLibrary("owner", "/fixture/libowner.dylib", "/fixture/libowner.dylib", "sha256:owner", NativeLibraryLicenseUnspecified, loads),
      list_nil<NativeLinkLibrary>()
    )
  )
  match native_link_resolve(NativeLinkPlan(NativeLinkMacosAarch64, buf_new(0), libraries, list_nil<NativeLinkImport>(), list_nil<NativeLinkPlanRelocation>(), 0, NativeLinkDebugInformationAbsent, list_nil<NativeArtifactTrustGrant>())) {
    NativeLinkSucceeded(graph, facts) -> Test.assert_eq(1, 0)
    NativeLinkRejected(errors) -> match errors {
      Cons(NativeLinkUndeclaredDynamicDependency(owner, dependency), Nil) -> {
        Test.assert_eq(str_eq(owner, "/fixture/libowner.dylib"), 1)
        Test.assert_eq(str_eq(dependency, "/fixture/libdependency.dylib"), 1)
      }
      _ -> Test.assert_eq(1, 0)
    }
  }
}

test "native_link_reports_archive_member_resolution_as_typed_residual" {
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_cons<NativeLinkLibrary>(
      NativeLinkStaticArchive("fixture", "/tmp/libfixture.a", "sha256:fixture", NativeLibraryLicenseUnspecified, 0, 0),
      list_nil<NativeLinkLibrary>()
    )
  )
  let plan = NativeLinkPlan(NativeLinkMacosAarch64, buf_new(0), libraries, list_nil<NativeLinkImport>(), list_nil<NativeLinkPlanRelocation>(), 0, NativeLinkDebugInformationAbsent, list_nil<NativeArtifactTrustGrant>())
  match native_link_resolve(plan) {
    NativeLinkSucceeded(graph, facts) -> Test.assert_eq(1, 0)
    NativeLinkRejected(errors) -> {
      Test.assert_eq(list_len<NativeLinkError>(errors), 1)
      match list_first_or<NativeLinkError>(errors, NativeLinkInvalidImportIndex(0)) {
        NativeLinkMissingArchiveArtifact(name, path) -> {
          Test.assert_eq(__str_len(name), __str_len("fixture"))
          Test.assert_eq(__str_len(path), __str_len("/tmp/libfixture.a"))
        }
        _ -> Test.assert_eq(1, 0)
      }
    }
  }
}

test "native_link_dynamic_dependency_prevents_standalone_claim" {
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_cons<NativeLinkLibrary>(
      NativeLinkDynamicLibrary("fixture", "/tmp/libfixture.dylib", "/tmp/libfixture.dylib", "sha256:fixture", NativeLibraryLicenseUnspecified, list_nil<NativeLinkDynamicLoad>()),
      list_nil<NativeLinkLibrary>()
    )
