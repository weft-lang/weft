use compiler/encode.{*}
use compiler/binary_format.{*}
use compiler/object.{*}

fn encoder_expect_immediate_tripwire(word: i64) -[Test]> i64 {
  Test.assert_eq(word, 3560891040)
}

test "arch_aarch64_encodes_core_instruction_matrix" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_is_supported(arch), 1)
  Test.assert_eq(arch_name_len_or(arch, 0 - 1), __str_len("aarch64"))
  Test.assert_eq(arch_encode_movz(arch, 0, 42, 0), 3531603968 + 42 * 32)
  Test.assert_eq(arch_encode_movk(arch, 1, 7, 16), 4068474880 + 2097152 + 7 * 32 + 1)
  Test.assert_eq(arch_encode_add_imm(arch, 2, 3, 4), 2432696320 + 4 * 1024 + 3 * 32 + 2)
  Test.assert_eq(arch_encode_str(arch, 4, 5, 16), 4177526784 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_ldr(arch, 4, 5, 16), 4181721088 + 2 * 1024 + 5 * 32 + 4)
  Test.assert_eq(arch_encode_stp_d_pre(arch, 8, 9, 31, 0 - 16), 1841244136)
  Test.assert_eq(arch_encode_ldp_d_post(arch, 8, 9, 31, 16), 1824597992)
}

test "arch_aarch64_encodes_arithmetic_and_branch_matrix" {
  let arch = arch_aarch64()
  Test.assert_eq(arch_encode_add_reg(arch, 1, 2, 3), 2332033024 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_sub_reg(arch, 1, 2, 3), 3405774848 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_mul(arch, 1, 2, 3), 2600500224 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_sdiv(arch, 1, 2, 3), 2596277248 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_udiv(arch, 1, 2, 3), 2596276224 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_cmp(arch, 2, 3), 3942645791 + 3 * 65536 + 2 * 32)
  Test.assert_eq(arch_encode_fmov_d_from_d(arch, 3, 1), 509624320 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_s_from_w(arch, 3, 1), 505872384 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_w_from_s(arch, 3, 1), 505806848 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fmov_s_from_s(arch, 3, 1), 505430016 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_scvtf_s_from_x(arch, 3, 1), 2653028352 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_ucvtf_s_from_x(arch, 3, 1), 2653093888 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvtzs_x_from_s(arch, 3, 1), 2654470144 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_ucvtf_d_from_x(arch, 3, 1), 2657288192 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvt_d_from_s(arch, 3, 1), 505593856 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fcvt_s_from_d(arch, 3, 1), 509755392 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fadd_s(arch, 1, 2, 3), 505423872 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fsub_s(arch, 1, 2, 3), 505427968 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fmul_s(arch, 1, 2, 3), 505415680 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fdiv_s(arch, 1, 2, 3), 505419776 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_fcmp_s(arch, 2, 3), 505421824 + 3 * 65536 + 2 * 32)
  Test.assert_eq(arch_encode_fsqrt_d(arch, 3, 1), 509722624 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_fsqrt_s(arch, 3, 1), 505528320 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxtb(arch, 3, 1), 2470452224 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxth(arch, 3, 1), 2470460416 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_sxtw(arch, 3, 1), 2470476800 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxtb(arch, 3, 1), 1392516096 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxth(arch, 3, 1), 1392524288 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_uxtw(arch, 3, 1), 3544218624 + 1 * 32 + 3)
  Test.assert_eq(arch_encode_lsr_reg(arch, 1, 2, 3), 2596283392 + 3 * 65536 + 2 * 32 + 1)
  Test.assert_eq(arch_encode_b(arch, 8), 335544320 + 2)
  Test.assert_eq(arch_encode_b_cond(arch, 8, 0), 1409286144 + 2 * 32)
  Test.assert_eq(arch_encode_blr(arch, 9), 3594452992 + 9 * 32)
}

test "aarch64 immediate encoders accept every field boundary" {
  let arch = arch_aarch64()
  let trap = 3560891040
  Test.assert_ne(arch_encode_movz(arch, 0, 65535, 48), trap)
  Test.assert_ne(arch_encode_movk(arch, 0, 65535, 48), trap)
  Test.assert_ne(arch_encode_add_imm(arch, 0, 0, 4095), trap)
  Test.assert_ne(arch_encode_sub_imm(arch, 0, 0, 4095), trap)
  Test.assert_ne(arch_encode_cset(arch, 0, 15), trap)
  Test.assert_ne(arch_encode_b_cond(arch, 0 - 1048576, 15), trap)
  Test.assert_ne(arch_encode_b_cond(arch, 1048572, 15), trap)
  Test.assert_ne(arch_encode_cbnz(arch, 0, 0 - 1048576), trap)
  Test.assert_ne(arch_encode_cbnz(arch, 0, 1048572), trap)
  Test.assert_ne(arch_encode_b(arch, 0 - 134217728), trap)
  Test.assert_ne(arch_encode_b(arch, 134217724), trap)
  Test.assert_ne(arch_encode_bl(arch, 0 - 134217728), trap)
  Test.assert_ne(arch_encode_bl(arch, 134217724), trap)
  Test.assert_ne(arch_encode_stp_pre(arch, 0, 1, 31, 0 - 512), trap)
  Test.assert_ne(arch_encode_stp_pre(arch, 0, 1, 31, 504), trap)
  Test.assert_ne(arch_encode_stp_d_pre(arch, 0, 1, 31, 0 - 512), trap)
  Test.assert_ne(arch_encode_stp_d_pre(arch, 0, 1, 31, 504), trap)
  Test.assert_ne(arch_encode_ldp_post(arch, 0, 1, 31, 0 - 512), trap)
  Test.assert_ne(arch_encode_ldp_post(arch, 0, 1, 31, 504), trap)
  Test.assert_ne(arch_encode_ldp_d_post(arch, 0, 1, 31, 0 - 512), trap)
  Test.assert_ne(arch_encode_ldp_d_post(arch, 0, 1, 31, 504), trap)
  Test.assert_ne(arch_encode_str(arch, 0, 0, 32760), trap)
  Test.assert_ne(arch_encode_ldr(arch, 0, 0, 32760), trap)
  Test.assert_ne(arch_encode_strb(arch, 0, 0, 4095), trap)
  Test.assert_ne(arch_encode_ldrb(arch, 0, 0, 4095), trap)
  Test.assert_ne(arch_encode_adr(arch, 0, 0 - 1048576), trap)
  Test.assert_ne(arch_encode_adr(arch, 0, 1048575), trap)
  Test.assert_ne(arch_encode_adrp(arch, 0, 0 - 1048576), trap)
  Test.assert_ne(arch_encode_adrp(arch, 0, 1048575), trap)
  Test.assert_ne(arch_encode_movn(arch, 0, 65535), trap)
  Test.assert_ne(arch_encode_brk(arch, 65535), trap)
}

test "aarch64 immediate encoders trip at every field boundary" {
  let arch = arch_aarch64()
  encoder_expect_immediate_tripwire(arch_encode_movz(arch, 0, 0 - 1, 0))
  encoder_expect_immediate_tripwire(arch_encode_movz(arch, 0, 65536, 0))
  encoder_expect_immediate_tripwire(arch_encode_movz(arch, 0, 0, 0 - 16))
  encoder_expect_immediate_tripwire(arch_encode_movz(arch, 0, 0, 1))
  encoder_expect_immediate_tripwire(arch_encode_movz(arch, 0, 0, 64))
  encoder_expect_immediate_tripwire(arch_encode_movk(arch, 0, 0 - 1, 0))
  encoder_expect_immediate_tripwire(arch_encode_movk(arch, 0, 65536, 0))
  encoder_expect_immediate_tripwire(arch_encode_movk(arch, 0, 0, 0 - 16))
  encoder_expect_immediate_tripwire(arch_encode_movk(arch, 0, 0, 1))
  encoder_expect_immediate_tripwire(arch_encode_movk(arch, 0, 0, 64))
  encoder_expect_immediate_tripwire(arch_encode_add_imm(arch, 0, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_add_imm(arch, 0, 0, 4096))
  encoder_expect_immediate_tripwire(arch_encode_sub_imm(arch, 0, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_sub_imm(arch, 0, 0, 4096))
  encoder_expect_immediate_tripwire(arch_encode_cset(arch, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_cset(arch, 0, 16))
  encoder_expect_immediate_tripwire(arch_encode_b_cond(arch, 0 - 1048580, 0))
  encoder_expect_immediate_tripwire(arch_encode_b_cond(arch, 1048576, 0))
  encoder_expect_immediate_tripwire(arch_encode_b_cond(arch, 2, 0))
  encoder_expect_immediate_tripwire(arch_encode_b_cond(arch, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_b_cond(arch, 0, 16))
  encoder_expect_immediate_tripwire(arch_encode_cbnz(arch, 0, 0 - 1048580))
  encoder_expect_immediate_tripwire(arch_encode_cbnz(arch, 0, 1048576))
  encoder_expect_immediate_tripwire(arch_encode_cbnz(arch, 0, 2))
  encoder_expect_immediate_tripwire(arch_encode_b(arch, 0 - 134217732))
  encoder_expect_immediate_tripwire(arch_encode_b(arch, 134217728))
  encoder_expect_immediate_tripwire(arch_encode_b(arch, 2))
  encoder_expect_immediate_tripwire(arch_encode_bl(arch, 0 - 134217732))
  encoder_expect_immediate_tripwire(arch_encode_bl(arch, 134217728))
  encoder_expect_immediate_tripwire(arch_encode_bl(arch, 2))
  encoder_expect_immediate_tripwire(arch_encode_stp_pre(arch, 0, 1, 31, 0 - 520))
  encoder_expect_immediate_tripwire(arch_encode_stp_pre(arch, 0, 1, 31, 512))
  encoder_expect_immediate_tripwire(arch_encode_stp_pre(arch, 0, 1, 31, 1))
  encoder_expect_immediate_tripwire(arch_encode_stp_d_pre(arch, 0, 1, 31, 0 - 520))
  encoder_expect_immediate_tripwire(arch_encode_stp_d_pre(arch, 0, 1, 31, 512))
  encoder_expect_immediate_tripwire(arch_encode_stp_d_pre(arch, 0, 1, 31, 1))
  encoder_expect_immediate_tripwire(arch_encode_ldp_post(arch, 0, 1, 31, 0 - 520))
  encoder_expect_immediate_tripwire(arch_encode_ldp_post(arch, 0, 1, 31, 512))
  encoder_expect_immediate_tripwire(arch_encode_ldp_post(arch, 0, 1, 31, 1))
  encoder_expect_immediate_tripwire(arch_encode_ldp_d_post(arch, 0, 1, 31, 0 - 520))
  encoder_expect_immediate_tripwire(arch_encode_ldp_d_post(arch, 0, 1, 31, 512))
  encoder_expect_immediate_tripwire(arch_encode_ldp_d_post(arch, 0, 1, 31, 1))
  encoder_expect_immediate_tripwire(arch_encode_str(arch, 0, 0, 0 - 8))
  encoder_expect_immediate_tripwire(arch_encode_str(arch, 0, 0, 32768))
  encoder_expect_immediate_tripwire(arch_encode_str(arch, 0, 0, 1))
  encoder_expect_immediate_tripwire(arch_encode_ldr(arch, 0, 0, 0 - 8))
  encoder_expect_immediate_tripwire(arch_encode_ldr(arch, 0, 0, 32768))
  encoder_expect_immediate_tripwire(arch_encode_ldr(arch, 0, 0, 1))
  encoder_expect_immediate_tripwire(arch_encode_strb(arch, 0, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_strb(arch, 0, 0, 4096))
  encoder_expect_immediate_tripwire(arch_encode_ldrb(arch, 0, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_ldrb(arch, 0, 0, 4096))
  encoder_expect_immediate_tripwire(arch_encode_adr(arch, 0, 0 - 1048577))
  encoder_expect_immediate_tripwire(arch_encode_adr(arch, 0, 1048576))
  encoder_expect_immediate_tripwire(arch_encode_adrp(arch, 0, 0 - 1048577))
  encoder_expect_immediate_tripwire(arch_encode_adrp(arch, 0, 1048576))
  encoder_expect_immediate_tripwire(arch_encode_movn(arch, 0, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_movn(arch, 0, 65536))
  encoder_expect_immediate_tripwire(arch_encode_brk(arch, 0 - 1))
  encoder_expect_immediate_tripwire(arch_encode_brk(arch, 65536))
}

test "arch_default_encode_helpers_route_to_aarch64" {
  Test.assert_eq(encode_movz(0, 42, 0), arch_encode_movz(arch_aarch64(), 0, 42, 0))
  Test.assert_eq(encode_movk(1, 7, 16), arch_encode_movk(arch_aarch64(), 1, 7, 16))
  Test.assert_eq(encode_add_imm(2, 3, 4), arch_encode_add_imm(arch_aarch64(), 2, 3, 4))
  Test.assert_eq(encode_add_reg(1, 2, 3), arch_encode_add_reg(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_sub_reg(1, 2, 3), arch_encode_sub_reg(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_str(4, 5, 16), arch_encode_str(arch_aarch64(), 4, 5, 16))
  Test.assert_eq(encode_ldr(4, 5, 16), arch_encode_ldr(arch_aarch64(), 4, 5, 16))
  Test.assert_eq(encode_stp_d_pre(8, 9, 31, 0 - 16), arch_encode_stp_d_pre(arch_aarch64(), 8, 9, 31, 0 - 16))
  Test.assert_eq(encode_ldp_d_post(8, 9, 31, 16), arch_encode_ldp_d_post(arch_aarch64(), 8, 9, 31, 16))
  Test.assert_eq(encode_b(8), arch_encode_b(arch_aarch64(), 8))
  Test.assert_eq(encode_b_cond(8, 0), arch_encode_b_cond(arch_aarch64(), 8, 0))
  Test.assert_eq(encode_bl(8), arch_encode_bl(arch_aarch64(), 8))
  Test.assert_eq(encode_ret(), arch_encode_ret(arch_aarch64()))
  Test.assert_eq(encode_svc(), arch_encode_svc(arch_aarch64()))
  Test.assert_eq(encode_adr(2, 16), arch_encode_adr(arch_aarch64(), 2, 16))
  Test.assert_eq(encode_adrp(2, 16), arch_encode_adrp(arch_aarch64(), 2, 16))
  Test.assert_eq(encode_fmov_d_from_d(3, 1), arch_encode_fmov_d_from_d(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fmov_s_from_w(3, 1), arch_encode_fmov_s_from_w(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fmov_w_from_s(3, 1), arch_encode_fmov_w_from_s(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fmov_s_from_s(3, 1), arch_encode_fmov_s_from_s(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_scvtf_s_from_x(3, 1), arch_encode_scvtf_s_from_x(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_ucvtf_s_from_x(3, 1), arch_encode_ucvtf_s_from_x(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fcvtzs_x_from_s(3, 1), arch_encode_fcvtzs_x_from_s(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_ucvtf_d_from_x(3, 1), arch_encode_ucvtf_d_from_x(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fcvt_d_from_s(3, 1), arch_encode_fcvt_d_from_s(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fcvt_s_from_d(3, 1), arch_encode_fcvt_s_from_d(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fadd_s(1, 2, 3), arch_encode_fadd_s(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_fsub_s(1, 2, 3), arch_encode_fsub_s(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_fmul_s(1, 2, 3), arch_encode_fmul_s(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_fdiv_s(1, 2, 3), arch_encode_fdiv_s(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_fcmp_s(2, 3), arch_encode_fcmp_s(arch_aarch64(), 2, 3))
  Test.assert_eq(encode_fsqrt_d(3, 1), arch_encode_fsqrt_d(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_fsqrt_s(3, 1), arch_encode_fsqrt_s(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_sxtb(3, 1), arch_encode_sxtb(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_sxth(3, 1), arch_encode_sxth(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_sxtw(3, 1), arch_encode_sxtw(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_uxtb(3, 1), arch_encode_uxtb(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_uxth(3, 1), arch_encode_uxth(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_uxtw(3, 1), arch_encode_uxtw(arch_aarch64(), 3, 1))
  Test.assert_eq(encode_udiv(1, 2, 3), arch_encode_udiv(arch_aarch64(), 1, 2, 3))
  Test.assert_eq(encode_lsr_reg(1, 2, 3), arch_encode_lsr_reg(arch_aarch64(), 1, 2, 3))
}

test "arch_unsupported_rejects_core_encoding" {
  let arch = arch_unsupported()
  Test.assert_eq(arch_is_supported(arch), 0)
  Test.assert_eq(arch_name_len_or(arch, 0 - 1), 0 - 1)
  Test.assert_eq(arch_encode_movz(arch, 0, 42, 0), 0)
  Test.assert_eq(arch_encode_add_imm(arch, 2, 3, 4), 0)
  Test.assert_eq(arch_encode_add_reg(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_b_cond(arch, 8, 0), 0)
  Test.assert_eq(arch_encode_bl(arch, 8), 0)
  Test.assert_eq(arch_encode_ret(arch), 0)
  Test.assert_eq(arch_encode_svc(arch), 0)
  Test.assert_eq(arch_encode_fmov_d_from_d(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_s_from_w(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_w_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_s_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_scvtf_s_from_x(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_ucvtf_s_from_x(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fcvtzs_x_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_ucvtf_d_from_x(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fcvt_d_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fcvt_s_from_d(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fadd_s(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_fsub_s(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_fmul_s(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_fdiv_s(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_fcmp_s(arch, 2, 3), 0)
  Test.assert_eq(arch_encode_fsqrt_d(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fsqrt_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxtb(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxth(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxtw(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxtb(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxth(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxtw(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_udiv(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_lsr_reg(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_adr(arch, 2, 16), 0)
  Test.assert_eq(arch_encode_adrp(arch, 2, 16), 0)
  Test.assert_eq(arch_encode_stp_d_pre(arch, 8, 9, 31, 0 - 16), 0)
  Test.assert_eq(arch_encode_ldp_d_post(arch, 8, 9, 31, 16), 0)
}

test "arch_x8664_placeholder_is_named_but_unsupported" {
  let arch = arch_x8664()
  Test.assert_eq(arch_is_supported(arch), 0)
  Test.assert_eq(arch_name_len_or(arch, 0 - 1), __str_len("x86_64"))
  Test.assert_eq(arch_encode_movz(arch, 0, 42, 0), 0)
  Test.assert_eq(arch_encode_add_reg(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_b(arch, 8), 0)
  Test.assert_eq(arch_encode_blr(arch, 9), 0)
  Test.assert_eq(arch_encode_fmov_d_from_d(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_s_from_w(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_w_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fmov_s_from_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_ucvtf_s_from_x(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_ucvtf_d_from_x(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fadd_s(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_fcmp_s(arch, 2, 3), 0)
  Test.assert_eq(arch_encode_fsqrt_d(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_fsqrt_s(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxtb(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxth(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_sxtw(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxtb(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxth(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_uxtw(arch, 3, 1), 0)
  Test.assert_eq(arch_encode_udiv(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_lsr_reg(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_adrp(arch, 2, 16), 0)
}

test "binary_format_macho_matrix" {
  let exe = binary_format_macho_executable()
  let obj = binary_format_macho_object()
  Test.assert_eq(binary_format_is_supported(exe), 1)
  Test.assert_eq(binary_format_is_supported(obj), 1)
  Test.assert_eq(binary_format_kind(exe), 1)
  Test.assert_eq(binary_format_kind(obj), 2)
  Test.assert_eq(binary_format_name_len_or(exe, 0 - 1), __str_len("macho-executable"))
  Test.assert_eq(binary_format_name_len_or(obj, 0 - 1), __str_len("macho-object"))
}

test "binary_format_backend_routes_macho_matrix" {
  let exe = binary_format_macho_executable()
  let obj = binary_format_macho_object()
  Test.assert_eq(binary_format_backend_id(binary_format_backend(exe)), binary_format_backend_id(binary_format_backend_macho_executable()))
  Test.assert_eq(binary_format_backend_id(binary_format_backend(obj)), binary_format_backend_id(binary_format_backend_macho_object()))
}

test "object_got_symbol_name_matrix" {
  Test.assert_eq(got_sym_count(), 37)
  Test.assert_eq(__str_len(got_sym_name(0)), __str_len("posix_spawn"))
  Test.assert_eq(__str_len(got_sym_name(4)), __str_len("pthread_join"))
  Test.assert_eq(__str_len(got_sym_name(9)), __str_len("close"))
  Test.assert_eq(__str_len(got_sym_name(13)), __str_len("pthread_mutex_destroy"))
  Test.assert_eq(__str_len(got_sym_name(18)), __str_len("pthread_cond_destroy"))
  Test.assert_eq(__str_len(got_sym_name(19)), __str_len("clock_gettime"))
  Test.assert_eq(__str_len(got_sym_name(20)), __str_len("nanosleep"))
  Test.assert_eq(__str_len(got_sym_name(21)), __str_len("getenv"))
  Test.assert_eq(__str_len(got_sym_name(22)), __str_len("opendir"))
  Test.assert_eq(__str_len(got_sym_name(23)), __str_len("readdir"))
  Test.assert_eq(__str_len(got_sym_name(24)), __str_len("closedir"))
  Test.assert_eq(__str_len(got_sym_name(25)), __str_len("stat"))
  Test.assert_eq(__str_len(got_sym_name(26)), __str_len("mkdir"))
  Test.assert_eq(__str_len(got_sym_name(27)), __str_len("remove"))
  Test.assert_eq(__str_len(got_sym_name(28)), __str_len("rename"))
  Test.assert_eq(__str_len(got_sym_name(29)), __str_len("getcwd"))
  Test.assert_eq(__str_len(got_sym_name(30)), __str_len("__error"))
  Test.assert_eq(__str_len(got_sym_name(31)), __str_len("pipe"))
  Test.assert_eq(__str_len(got_sym_name(32)), __str_len("posix_spawn_file_actions_init"))
  Test.assert_eq(__str_len(got_sym_name(33)), __str_len("posix_spawn_file_actions_adddup2"))
  Test.assert_eq(__str_len(got_sym_name(34)), __str_len("posix_spawn_file_actions_addclose"))
  Test.assert_eq(__str_len(got_sym_name(35)), __str_len("posix_spawn_file_actions_destroy"))
  Test.assert_eq(__str_len(got_sym_name(36)), __str_len("kill"))
  Test.assert_eq(__str_len(got_sym_name(37)), __str_len("unknown"))
  Test.assert_eq(__str_len(got_sym_name(99)), __str_len("unknown"))
}

test "binary_format_elf_placeholders_are_named_but_unsupported" {
  let exe = binary_format_elf_executable()
  let obj = binary_format_elf_object()
  Test.assert_eq(binary_format_is_supported(exe), 0)
  Test.assert_eq(binary_format_is_supported(obj), 0)
  Test.assert_eq(binary_format_kind(exe), 3)
  Test.assert_eq(binary_format_kind(obj), 4)
  Test.assert_eq(binary_format_name_len_or(exe, 0 - 1), __str_len("elf-executable"))
  Test.assert_eq(binary_format_name_len_or(obj, 0 - 1), __str_len("elf-object"))
  Test.assert_eq(binary_format_backend_id(binary_format_backend(exe)), binary_format_backend_id(binary_format_backend_unsupported()))
  Test.assert_eq(binary_format_backend_id(binary_format_backend(obj)), binary_format_backend_id(binary_format_backend_unsupported()))
}

test "binary_format_unsupported_is_rejected" {
  let format = binary_format_unsupported()
  Test.assert_eq(binary_format_is_supported(format), 0)
  Test.assert_eq(binary_format_kind(format), 0)
  Test.assert_eq(binary_format_name_len_or(format, 0 - 1), 0 - 1)
  Test.assert_eq(binary_format_backend_id(binary_format_backend(format)), binary_format_backend_id(binary_format_backend_unsupported()))
}

test "binary_format_default_for_relocations_selects_current_macho_format" {
  Test.assert_eq(binary_format_kind(binary_format_default_for_relocations(0)), binary_format_kind(binary_format_macho_executable()))
  Test.assert_eq(binary_format_kind(binary_format_default_for_relocations(1)), binary_format_kind(binary_format_macho_object()))
  Test.assert_eq(binary_format_kind(binary_format_default_for_relocations(42)), binary_format_kind(binary_format_macho_object()))
}
