  Test.assert_eq(__str_len(got_sym_name(27)), __str_len("remove"))
  Test.assert_eq(__str_len(got_sym_name(28)), __str_len("rename"))
  Test.assert_eq(__str_len(got_sym_name(29)), __str_len("getcwd"))
  Test.assert_eq(__str_len(got_sym_name(30)), __str_len("__error"))
  Test.assert_eq(__str_len(got_sym_name(31)), __str_len("pipe"))
