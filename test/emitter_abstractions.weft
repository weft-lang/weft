  Test.assert_eq(arch_encode_add_reg(arch, 1, 2, 3), 0)
  Test.assert_eq(arch_encode_b_cond(arch, 8, 0), 0)
  Test.assert_eq(arch_encode_bl(arch, 8), 0)
  Test.assert_eq(arch_encode_ret(arch), 0)
  Test.assert_eq(arch_encode_svc(arch), 0)
  Test.assert_eq(arch_encode_fmov_d_from_d(arch, 3, 1), 0)
