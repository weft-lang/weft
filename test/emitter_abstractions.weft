}

test "native_link_resolves_reachable_import_once_and_preserves_relocations" {
  let code = buf_new(16)
  bu32(code, encode_bl(0))
  bu32(code, encode_bl(0))
  bu32(code, encode_adrp(17, 0))
  bu32(code, encode_add_imm(17, 17, 0))
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"),
    list_nil<NativeLinkLibrary>()
  )
  let imports = list_cons<NativeLinkImport>(
    NativeLinkImport("write", 0, NativeLinkRuntimeImport),
    list_nil<NativeLinkImport>()
  )
  let relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(0, 0),
    list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(4, 0),
    list_cons<NativeLinkPlanRelocation>(NativeLinkPlanPageAddress(8, NativeLinkCodeAddress(0)), list_nil<NativeLinkPlanRelocation>())
  )
  )
  let trust_grants = list_cons<NativeArtifactTrustGrant>(
    NativeArtifactTrustGrant("fixture", "1.0.0", "path:fixture", "sha256:fixture", "native/raw"),
    list_nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(NativeLinkPlan(NativeLinkMacosAarch64, code, libraries, imports, relocations, 0, NativeLinkDebugInformationAbsent, trust_grants)) {
    NativeLinkSucceeded(graph, facts) -> {
      Test.assert_eq(native_link_graph_symbol_count(graph), 1)
      Test.assert_eq(native_link_graph_relocation_count(graph), 3)
      Test.assert_eq(native_link_artifact_is_standalone(facts), true)
      match native_link_artifact_platform_abi(facts) {
        NativeArtifactMacosPlatformAbi(major, minor, patch) -> {
          Test.assert_eq(major, 11)
          Test.assert_eq(minor, 0)
          Test.assert_eq(patch, 0)
        }
        NativeArtifactLinuxKernelAbi(major, minor, patch) -> Test.assert_eq(1, 0)
        NativeArtifactLinuxDynamicAbi(major, minor, patch, libc, loader) -> Test.assert_eq(1, 0)
        NativeArtifactPlatformAbiUnspecified -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_trust_grants(facts) {
        Cons(NativeArtifactTrustGrant(package_name, version, source, content, module), Nil) -> {
          Test.assert_str_eq(package_name, "fixture")
          Test.assert_str_eq(version, "1.0.0")
          Test.assert_str_eq(source, "path:fixture")
          Test.assert_str_eq(content, "sha256:fixture")
          Test.assert_str_eq(module, "native/raw")
        }
        _ -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_debug_information(facts) {
        NativeArtifactDebugInformationAbsent -> Test.assert_eq(1, 1)
        NativeArtifactDwarfInformation(version) -> Test.assert_eq(1, 0)
      }
      match native_link_artifact_signing(facts) {
        NativeArtifactAdHocSigning(identity, digest) -> {
          Test.assert_str_eq(identity, "weft")
          Test.assert_str_eq(digest, "sha256")
        }
        NativeArtifactUnsigned -> Test.assert_eq(1, 0)
      }
      Test.assert_eq(if buf_len(emit_native_link_macho(graph)) > 0 { 1 } else { 0 }, 1)
    }
    NativeLinkRejected(errors) -> Test.assert_eq(list_len<NativeLinkError>(errors), 0)
  }
}

test "native_link_debug_facts_emit_versioned_function_file_line_sections" {
  let functions = list_cons<NativeLinkDebugFunction>(
    NativeLinkDebugFunction(96, 112, "leaf", "src/leaf.weft", 7, 2, false),
    list_cons<NativeLinkDebugFunction>(
    NativeLinkDebugFunction(64, 96, "framed", "src/main.weft", 130, 4, true),
    list_nil<NativeLinkDebugFunction>()
  )
  )
  let debug_information = NativeLinkDwarfFunctionLineInformation(functions)
  match native_link_debug_artifact_information(debug_information) {
    NativeArtifactDwarfInformation(version) -> Test.assert_str_eq(version, "dwarf-v4-function-file-line")
    NativeArtifactDebugInformationAbsent -> Test.assert_eq(1, 0)
  }
  let files = native_dwarf_collect_files(functions)
  Test.assert_eq(list_len<str>(files), 2)
  Test.assert_eq(native_dwarf_file_index(files, "src/leaf.weft", 1), 1)
  Test.assert_eq(native_dwarf_file_index(files, "src/main.weft", 1), 2)
  Test.assert_eq(native_dwarf_low_pc(functions), 64)
  Test.assert_eq(native_dwarf_high_pc(functions), 112)
  let sections = native_dwarf_sections(debug_information, 4294983680)
  let abbrev = native_dwarf_abbrev(sections)
  let info = native_dwarf_info(sections)
  let line = native_dwarf_line(sections)
  Test.assert_eq(if buf_len(abbrev) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64_at(buf_ptr(info), 0) band 4294967295, buf_len(info) - 4)
  Test.assert_eq(mem_load8_at(buf_ptr(info), 4) + mem_load8_at(buf_ptr(info), 5) * 256, 4)
  Test.assert_eq(mem_load64_at(buf_ptr(line), 0) band 4294967295, buf_len(line) - 4)
  Test.assert_eq(mem_load8_at(buf_ptr(line), 4) + mem_load8_at(buf_ptr(line), 5) * 256, 4)
}

test "native_link_parses_dynamic_identity_and_all_load_command_variants" {
  let bytes = native_link_test_dynamic_image()
  match native_link_macho_dynamic_image(buf_ptr(bytes), buf_len(bytes)) {
    NativeLinkDynamicImageParsed(image) -> {
      Test.assert_eq(str_eq(native_link_test_view_str(native_link_dynamic_image_identity(image)), "/fixture/libowner.dylib"), 1)
      match native_link_dynamic_image_loads(image) {
        Cons(NativeLinkRequiredDynamicLoad(required), Cons(NativeLinkWeakDynamicLoad(weak), Cons(NativeLinkReexportDynamicLoad(reexport), Cons(NativeLinkUpwardDynamicLoad(upward), Cons(NativeLinkLazyDynamicLoad(lazy), Nil))))) -> {
          Test.assert_eq(str_eq(native_link_test_view_str(required), "/fixture/librequired.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(weak), "/fixture/libweak.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(reexport), "/fixture/libreexport.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(upward), "/fixture/libupward.dylib"), 1)
          Test.assert_eq(str_eq(native_link_test_view_str(lazy), "/fixture/liblazy.dylib"), 1)
        }
        _ -> Test.assert_eq(1, 0)
      }
    }
    _ -> Test.assert_eq(1, 0)
  }
}

test "native_link_elf_dynamic_image_preserves_soname_and_needed_closure" {
