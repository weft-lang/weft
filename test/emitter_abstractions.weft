  let code = buf_new(4)
  bu32(code, encode_bl(0))
  match native_link_resolve(NativeLinkPlan(NativeLinkMacosAarch64, code, libraries, imports, relocations, 0, NativeLinkDebugInformationAbsent, list_nil<NativeArtifactTrustGrant>())) {
