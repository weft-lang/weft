test "linux_native_link_interprets_aarch64_elf_relocation_matrix" {
  match native_link_test_elf_relocation(275, 0) {
    NativeLinkObjectPage21(address, symbol, addend) -> Test.assert_eq(address, 0)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_elf_relocation(277, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(278, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(282, 0) { NativeLinkObjectJump26(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(283, 0) { NativeLinkObjectCall26(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(284, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(285, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(286, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(299, 0) { NativeLinkObjectPageOff12(address, symbol, addend) -> Test.assert_eq(address, 0) _ -> Test.assert_eq(0, 1) }
  match native_link_test_elf_relocation(275, 1) {
    NativeLinkObjectPage21(address, symbol, addend) -> Test.assert_eq(addend, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_elf_relocation(999, 0) {
    NativeLinkObjectRelocationUnsupported(symbol, kind) -> Test.assert_eq(kind, 999)
    _ -> Test.assert_eq(0, 1)
  }
}

test "mach_native_link_distinguishes_tail_jumps_and_calls" {
  let branch_info = 754974720
  match native_link_test_mach_relocation(encode_bl(0), branch_info, 0, 1, 0) {
    NativeLinkObjectCall26(address, symbol, addend) -> Test.assert_eq(addend, 0)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_mach_relocation(encode_b(0), branch_info, 0, 1, 0) {
    NativeLinkObjectJump26(address, symbol, addend) -> Test.assert_eq(addend, 0)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_mach_relocation(encode_ret(), branch_info, 0, 1, 0) {
    NativeLinkObjectRelocationUnsupported(symbol, kind) -> Test.assert_eq(kind, 2)
    _ -> Test.assert_eq(0, 1)
  }
}

test "mach_native_link_requires_and_applies_paired_addends" {
  let addend_info = 2751463431
  let page_info = 1023410176
  match native_link_test_mach_relocation(encode_adrp(0, 0), addend_info, page_info, 2, 0) {
    NativeLinkObjectPairedAddend(address) -> Test.assert_eq(address, 0)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_mach_relocation(encode_adrp(0, 0), addend_info, page_info, 2, 1) {
    NativeLinkObjectPage21(address, symbol, addend) -> Test.assert_eq(addend, 7)
    _ -> Test.assert_eq(0, 1)
  }
  match native_link_test_mach_relocation(encode_adrp(0, 0), addend_info, 0, 1, 0) {
    NativeLinkObjectRelocationUnsupported(symbol, kind) -> Test.assert_eq(kind, 10)
    _ -> Test.assert_eq(0, 1)
  }
}

test "native_link_interprets_absolute_data_relocations_and_addends" {
  let mach_bytes = buf_new(96)
  bpad(mach_bytes, 96)
  let mach_raw = buf_ptr(mach_bytes)
  mem_store64_at(mach_raw, 0, 9)
  native_link_test_store_u32(mach_raw, 8, 0)
  native_link_test_store_u32(mach_raw, 12, 234881024)
  native_link_test_store_u32(mach_raw, 32, 1)
  mem_store8_at(mach_raw, 36, 15)
  mem_store8_at(mach_raw, 37, 1)
  mem_store8_at(mach_raw, 48, 0)
  mem_copy(mach_raw + 49, __str_ptr("target"), 6)
  mem_store8_at(mach_raw, 55, 0)
  let mach_data = list_cons<NativeLinkObjectDataSection>(
    NativeLinkMachDataBytes(0, 8, 0, 3, 2, 8, 1),
    list_nil<NativeLinkObjectDataSection>()
  )
  let mach_object = NativeLinkMachRelocatableObject(
    NativeLinkMachObject(mach_raw, 96, 24, 0, 4, 2, 0, 0, 1, 32, 1, 48, 8, mach_data)
  )
  match native_link_object_data_relocation(mach_object, 0) {
    NativeLinkObjectDataAbsolute64(section, site, symbol, addend) -> {
      Test.assert_eq(section, 2)
      Test.assert_eq(site, 0)
      Test.assert_eq(addend, 9)
    }
    _ -> Test.assert_eq(0, 1)
  }

  let elf_bytes = buf_new(96)
  bpad(elf_bytes, 96)
  let elf_raw = buf_ptr(elf_bytes)
  mem_store64_at(elf_raw, 0, 16)
  mem_store64_at(elf_raw, 8, 257)
  mem_store64_at(elf_raw, 16, 11)
  native_link_test_store_u32(elf_raw, 32, 1)
  mem_store8_at(elf_raw, 36, 16)
  mem_store8_at(elf_raw, 38, 2)
  mem_store8_at(elf_raw, 48, 0)
  mem_copy(elf_raw + 49, __str_ptr("target"), 6)
  mem_store8_at(elf_raw, 55, 0)
  let elf_data = list_cons<NativeLinkObjectDataSection>(
    NativeLinkElfDataBytes(16, 8, 64, 3, 2, 0, 1),
    list_nil<NativeLinkObjectDataSection>()
  )
  let elf_object = NativeLinkElfRelocatableObject(
    NativeLinkElfObject(elf_raw, 96, 24, 0, 4, 2, 0, 0, 1, 32, 1, 48, 8, elf_data)
  )
  match native_link_object_data_relocation(elf_object, 0) {
    NativeLinkObjectDataAbsolute64(section, site, symbol, addend) -> {
      Test.assert_eq(section, 2)
      Test.assert_eq(site, 0)
      Test.assert_eq(addend, 11)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "native_link_encodes_scaled_128_bit_page offsets" {
