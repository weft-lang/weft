-- Expected exit code: 102
-- A dying parent releases each managed field. A field whose block was already
-- freed means the parent's stake was lost, so the deep release traps.

use runtime/rc.{rc_default_alloc, rc_default_alloc_masked, rc_default_release}
use runtime/rc_implicit_test.{runtime_rc_test_store64}

fn main() -> i64 {
  let parent = rc_default_alloc_masked(8, 8, 1)
  let child: i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(parent, child)
  rc_default_release(child)
  rc_default_release(parent)
  0
}
