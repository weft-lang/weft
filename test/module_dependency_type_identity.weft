use module_fixtures/g4_type_dep_left.{LeftFirst, LeftSecond, SameError, SameRecord, make, make_record}
use stdlib/task/channel as channel
use stdlib/vector as vector

fn read(value: SameError) -> i64 {
  match value {
    LeftFirst -> 1
    LeftSecond -> 2
  }
}

test "selected type retains identity over same-spelled dependency type" {
  Test.assert_eq(read(make()), 1)
}

fn read_record(value: SameRecord) -> i64 {
  value.left
}

test "selected record retains layout over same-spelled dependency type" {
  Test.assert_eq(read_record(make_record(42)), 42)
}

fn vector_capacity_error_code(error: vector.CapacityError) -> i64 {
  match error {
    vector.CapacityUnrepresentable(_) -> 1
    vector.CapacityAdditionOverflow(_, _) -> 2
  }
}

fn channel_capacity_error_code(error: channel.CapacityError) -> i64 {
  match error {
    channel.CapacityZero -> 0
    channel.CapacityTooLarge -> 1
  }
}

fn qualified_vector() -> owned vector.Vector<i64> {
  vector.new<i64>()
}

test "same-spelled stdlib errors remain namespaced types" {
  let requested: usize = 17
  let values = qualified_vector()
  Test.assert_eq(vector_capacity_error_code(vector.CapacityUnrepresentable(requested)), 1)
  Test.assert_eq(channel_capacity_error_code(channel.CapacityZero), 0)
  Test.assert_true(values.len() == 0)
}
