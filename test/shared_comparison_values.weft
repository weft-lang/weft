-- The first branch cannot consume the only materialization of flag: the
-- merged continuation uses that same Boolean value a second time.
fn check(a: i64, b: i64) -> i64 {
  let flag = a < b
  let selected = if flag { 100 } else { 200 }
  if flag { selected + 1 } else { selected + 2 }
}

fn main(argc: i64, argv: i64) -> i64 {
  if check(argc, argc + 1) == 101 and check(argc + 1, argc) == 202 { 0 } else { 1 }
}
