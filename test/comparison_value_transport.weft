-- Branch lowering must preserve a comparison's Boolean value when it is
-- observed again after control flow, returned, or captured by a closure.

fn reused_less(left: i64, right: i64) -> i64 {
  let flag = left < right
  let selected = if flag { 100 } else { 200 }
  if flag { selected + 1 } else { selected + 2 }
}

fn reused_equal(left: i64, right: i64) -> i64 {
  let flag = left == right
  let selected = if flag { 10 } else { 20 }
  if flag { selected + 1 } else { selected + 2 }
}

fn returned_comparison(left: i64, right: i64) -> (bool, i64) {
  let flag = left <= right
  let selected = if flag { 3 } else { 7 }
  (flag, selected)
}

fn captured_comparison(left: i64, right: i64) -> i64 {
  let flag = left != right
  let selected = if flag { 30 } else { 40 }
  let observe = () => if flag { selected + 1 } else { selected + 2 }
  observe()
}

fn main(argc: i64, argv: i64) -> i64 {
  let (yes, small) = returned_comparison(argc, argc + 1)
  let (no, large) = returned_comparison(argc + 1, argc)
  if reused_less(argc, argc + 1) == 101 and reused_less(argc + 1, argc) == 202 and
    reused_equal(argc, argc) == 11 and reused_equal(argc, argc + 1) == 22 and
    yes and not no and small == 3 and large == 7 and
    captured_comparison(argc, argc + 1) == 31 and captured_comparison(argc, argc) == 42 { 0 } else { 1 }
}
