use stdlib/num.{*}
use stdlib/ord.{Ord}
use stdlib/string.{*}

type Coordinate { x: f64, y: f64 }
type NarrowPair { x: f32, y: f32 }
type UnsignedPair { x: u64, y: u64 }
type BytePair { x: u8, y: u8 }
type Label { text: str }

fn coordinate_delta(a: Coordinate, b: Coordinate) -> bool {
  let delta = a.x - b.x
  delta == -4.0
}

fn indexed_delta(values: [Coordinate]) -> bool {
  let a = values[0]
  let b = values[1]
  let delta = a.x - b.x
  delta == -4.0
}

fn coordinate_deltas(values: [Coordinate]) -> bool {
  let first: usize = 0
  let mut valid = true
  for i in first..values.len {
    let a = values[i]
    let delta = a.x - a.y
    valid = valid and delta == -4.0
  }
  valid
}

fn generic_readings<T: Ord>(first: {value: T}, second: {value: T}) -> bool {
  first.value < second.value
}

fn rounded_sum(pair: NarrowPair) -> bool {
  let sum = pair.x + pair.y
  let expected: f32 = 16777216.0
  sum == expected
}

fn unsigned_order(pair: UnsignedPair) -> bool { pair.x > pair.y }

fn byte_sum(pair: BytePair) -> bool {
  let sum = pair.x + pair.y
  let expected: u8 = 4
  sum == expected
}

effect ReadCoordinate { fn read() -> Coordinate }

fn handled_delta() -> bool {
  handle {
    let value = ReadCoordinate.read()
    let delta = value.x - value.y
    delta == -4.0
  } {
    ReadCoordinate.read() -> resume(Coordinate { x: 1.0, y: 5.0 })
  }
}

test "nominal field arithmetic preserves floating point semantics" {
  Test.assert_true(coordinate_delta(Coordinate { x: 1.0, y: 0.0 }, Coordinate { x: 5.0, y: 0.0 }))
  let a = Coordinate { x: 6.0, y: 2.0 }
  let sum = a.x + a.y
  let product = a.x * a.y
  let quotient = a.x / a.y
  Test.assert_true(sum == 8.0)
  Test.assert_true(product == 12.0)
  Test.assert_true(quotient == 3.0)
  Test.assert_true(a.x > a.y)
}

test "indexed records retain field types through local bindings" {
  let samples = [Coordinate { x: 1.0, y: 0.0 }, Coordinate { x: 5.0, y: 0.0 }]
  Test.assert_true(indexed_delta(samples[..]))
}

test "field arithmetic inside loops preserves its checked numeric type" {
  let samples = [Coordinate { x: 1.0, y: 5.0 }, Coordinate { x: 2.0, y: 6.0 }]
  Test.assert_true(coordinate_deltas(samples[..]))
}

test "structural fields and tuple projections preserve float arithmetic" {
  let sample = { x: 1.0, y: 5.0 }
  let pair = (1.0, 5.0)
  let structural = sample.x - sample.y
  let positional = pair.0 - pair.1
  Test.assert_true(structural == -4.0)
  Test.assert_true(positional == -4.0)
}

test "generic record projections preserve concrete floating point types" {
  let first = {value: 1.0}
  let second = {value: 5.0}
  let delta = first.value - second.value
  Test.assert_true(delta == -4.0)
  Test.assert_true(generic_readings<f64>(first, second))
}

test "single precision field operations round at single precision" {
  Test.assert_true(rounded_sum(NarrowPair { x: 16777216.0, y: 1.0 }))
  let values = [NarrowPair { x: 16777216.0, y: 1.0 }]
  for pair in values {
    let sum = pair.x + pair.y
    let expected: f32 = 16777216.0
    Test.assert_true(sum == expected)
  }
}

test "unsigned field comparisons preserve the full integer domain" {
  let pair = UnsignedPair { x: 18446744073709551615, y: 1 }
  Test.assert_true(unsigned_order(pair))
  for value in [pair] { Test.assert_true(value.x > value.y) }
}

test "narrow integer field arithmetic preserves wrapping width" {
  Test.assert_true(byte_sum(BytePair { x: 250, y: 10 }))
  for value in [BytePair { x: 250, y: 10 }] {
    let sum = value.x + value.y
    let expected: u8 = 4
    Test.assert_true(sum == expected)
  }
}

test "floating point field comparisons preserve NaN and signed zero" {
  let nan = f64_from_bits(9221120237041090560)
  let value = Coordinate { x: nan, y: -0.0 }
  Test.assert_false(value.x == value.x)
  Test.assert_false(value.x < value.y)
  Test.assert_false(value.x >= value.y)
  let zero = Coordinate { x: 0.0, y: -0.0 }
  Test.assert_true(zero.x == zero.y)
}

test "closure and handler field arithmetic uses the same numeric facts" {
  let value = Coordinate { x: 1.0, y: 5.0 }
  let calculate = () => {
    let delta = value.x - value.y
    delta == -4.0
  }
  Test.assert_true(calculate())
  Test.assert_true(handled_delta())
}

fn label_equal(first: Label, second: Label) -> bool { first.text == second.text }

test "string field equality compares content across distinct allocations" {
  let first = Label { text: "we".concat("ft") }
  let second = Label { text: "wef".concat("t") }
  let different = Label { text: "we".concat("ave") }
  Test.assert_true(label_equal(first, second))
  Test.assert_false(label_equal(first, different))
  Test.assert_true(first.text != different.text)
  for value in [second] { Test.assert_true(first.text == value.text) }
}
