use runtime/alloc.{*}
use runtime/memory.{*}
-- test/f64_lowering_metrics.weft -- native evidence for direct f64 literal lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use stdlib/f64_table.{*}

fn f64_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn f64_metric_optimised(src: str) -> IrModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn f64_metric_float_binaries(src: str) -> i64 {
  let functions = pipeline_ir_functions(f64_metric_optimised(src))
  let main_hash = str_hash(__str_ptr("main"), 0, __str_len("main"))
  match pipeline_ir_function_list_find_hash(functions, main_hash) {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> ir_function_count_tag(f, 30)
  }
}

fn f64_metric_native_ir_emits(src: str) -> i64 {
  pipeline_native_ir_emit_count(f64_metric_native(src))
}

fn f64_metric_direct_literals(src: str) -> i64 {
  pipeline_native_f64_literal_direct_count(f64_metric_native(src))
}

fn f64_metric_expr_trees(src: str) -> i64 {
  pipeline_native_f64_expr_tree_count(f64_metric_native(src))
}

fn f64_metric_local_registers(src: str) -> i64 {
  pipeline_native_f64_local_register_count(f64_metric_native(src))
}

fn f64_metric_fp_preserved(src: str) -> i64 {
  pipeline_native_fp_register_preserved_count(f64_metric_native(src))
}

fn f64_metric_fp_preserve_functions(src: str) -> i64 {
  pipeline_native_fp_preserve_function_count(f64_metric_native(src))
}

fn f64_literal_bits(src: str) -> i64 {
  let bits = cg_decimal_f64_bits(__str_ptr(src), 0, __str_len(src))
  node_f1(bits)
}

fn f64_literal_bits_ok(src: str) -> i64 {
  let bits = cg_decimal_f64_bits(__str_ptr(src), 0, __str_len(src))
  node_f2(bits)
}

fn f32_literal_bits(src: str) -> i64 {
  let bits = cg_decimal_f32_bits(__str_ptr(src), 0, __str_len(src))
  node_f1(bits)
}

fn f32_literal_bits_ok(src: str) -> i64 {
  let bits = cg_decimal_f32_bits(__str_ptr(src), 0, __str_len(src))
  node_f2(bits)
}

fn f64_literal_fast_bits(src: str) -> i64 {
  let bits = cg_decimal_ieee_bits_small(__str_ptr(src), 0, __str_len(src), 52, 1023)
  node_f1(bits)
}

fn f64_literal_fast_bits_ok(src: str) -> i64 {
  let bits = cg_decimal_ieee_bits_small(__str_ptr(src), 0, __str_len(src), 52, 1023)
  node_f2(bits)
}

fn f32_literal_fast_bits(src: str) -> i64 {
  let bits = cg_decimal_ieee_bits_small(__str_ptr(src), 0, __str_len(src), 23, 127)
  node_f1(bits)
}

fn f32_literal_fast_bits_ok(src: str) -> i64 {
  let bits = cg_decimal_ieee_bits_small(__str_ptr(src), 0, __str_len(src), 23, 127)
  node_f2(bits)
}

fn f64_lowering_bump(p: i64) -> f64 {
  mem_store64(p, mem_load64(p) + 1)
  2.0
}

fn f64_lowering_left_call() -> f64 {
  20.0
}

fn f64_lowering_right_call() -> f64 {
  22.0
}

fn f64_lowering_sqrt(value: f64) -> f64 {
  __f64_sqrt(value)
}

test "f64_lowering_metric_directs_binop_literal_operands" {
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { 1.0 + 2.0 }"), 1)
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { let x: f64 = 4.0 x * 3.0 }"), 1)
  Test.assert_eq(f64_metric_native_ir_emits("fn main() -> f64 { 1.0 + 2.0 }"), 1)
}

test "f64_lowering_metric_lowers_arithmetic_trees" {
  let nested = "fn main() -> f64 { let z: f64 = 2.0 let w: f64 = 3.0 2.0 * z * w }"
  let branch = "fn main() -> i64 { let z: f64 = 2.0 let w: f64 = 3.0 if z * z + w * w < 20.0 { 1 } else { 0 } }"
  Test.assert_eq(f64_metric_float_binaries(nested), 2)
  Test.assert_eq(f64_metric_float_binaries(branch), 4)
}

test "f64_lowering_metric_keeps_immutable_f64_locals_in_registers" {
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { let a: f64 = 2.0 a + 3.0 }"), 1)
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { let a: f64 = 2.0 let b: f64 = a * 3.0 b + a }"), 2)
  Test.assert_eq(f64_metric_local_registers("fn main() -> f64 { let a: f64 = 2.0 a + 3.0 }"), 0)
}

test "f64_lowering_metric_keeps_loop_temporaries_in_registers" {
  let src = "fn main() -> f64 { let mut x: f64 = 1.0 let mut i = 0 while i < 2 { let a: f64 = x * 2.0 let b: f64 = a + 1.0 x = b i = i + 1 } x }"
  Test.assert_eq(f64_metric_local_registers(src), 1)
  Test.assert_eq(f64_metric_fp_preserved(src), 1)
  Test.assert_eq(f64_metric_fp_preserve_functions(src), 1)
}

test "f64_lowering_metric_keeps_f64_locals_across_nonclobbering_calls" {
  let sqrt_src = "fn mysqrt(x: f64) -> f64 { __f64_sqrt(x) } fn main() -> f64 { let a: f64 = 9.0 mysqrt(a) + a }"
  let table_src = "use \"stdlib/f64_table.weft\" fn getx(t: Vector<f64>, i: i64) -> f64 { f64_table_get(t, i, 2, 0, 0.0) } fn setx(t: Vector<f64>, i: i64, v: f64) -> i64 { f64_table_set(t, i, 2, 0, v) } fn main() -> f64 { let t = f64_table_new(2, 1) let i = 0 setx(t, i, 4.0); let a: f64 = getx(t, i) setx(t, i, a + 1.0); getx(t, i) + a }"
  Test.assert_eq(f64_metric_float_binaries(sqrt_src), 1)
  Test.assert_eq(f64_metric_float_binaries(table_src), 2)
  Test.assert_eq(f64_metric_local_registers(sqrt_src), 0)
  Test.assert_eq(f64_metric_local_registers(table_src), 0)
}

test "f64_lowering_metric_treats_f64_table_get_wrappers_as_tree_leaves" {
  let src = "use \"stdlib/f64_table.weft\" fn getx(t: Vector<f64>, i: i64) -> f64 { f64_table_get(t, i, 2, 0, 0.0) } fn main() -> f64 { let t = f64_table_new(2, 1) let i = 0 f64_table_set(t, i, 2, 0, 3.0); getx(t, i) * 2.0 + 1.0 }"
  Test.assert_eq(f64_metric_float_binaries(src), 2)
}

test "f64_lowering_metric_local_register_sad_paths" {
  Test.assert_eq(f64_metric_local_registers("fn main() -> i64 { let a = 2  a + 3 }"), 0)
  Test.assert_eq(f64_metric_local_registers("fn helper(x: f64) -> f64 { x } fn main() -> f64 { let a: f64 = 2.0 helper(a) }"), 0)
  Test.assert_eq(f64_metric_local_registers("effect F64LR { fn tick() -> i64 } fn main() -> f64 { handle { let a: f64 = 2.0 F64LR.tick(); a } { F64LR.tick() -> resume(0) } }"), 0)
  Test.assert_eq(f64_metric_local_registers("fn main() -> f64 { let a: f64 = 2.0 let a: i64 = 3 4.0 }"), 0)
}

test "f64_lowering_metric_local_register_exhausts_available_fp_regs" {
  let src = "fn main(n: i64) -> f64 { let mut a0: f64 = 0.0 let mut a1: f64 = 0.0 let mut a2: f64 = 0.0 let mut a3: f64 = 0.0 let mut a4: f64 = 0.0 let mut a5: f64 = 0.0 let mut a6: f64 = 0.0 let mut a7: f64 = 0.0 let mut a8: f64 = 0.0 while n > 0 { a0 = a0 + 1.0 a1 = a1 + 1.0 a2 = a2 + 1.0 a3 = a3 + 1.0 a4 = a4 + 1.0 a5 = a5 + 1.0 a6 = a6 + 1.0 a7 = a7 + 1.0 a8 = a8 + 1.0 break } a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 }"
  Test.assert_eq(f64_metric_local_registers(src), 8)
}

test "f64_lowering_metric_directs_branch_comparison_literals" {
  let src = "fn main() -> i64 { let x: f64 = 1.0 if x <= 4.0 { 1 } else { 0 } }"
  Test.assert_eq(f64_metric_float_binaries(src), 1)
}

test "f64_lowering_metric_directs_zero_literal_bits" {
  let src = "fn main() -> f64 { let x: f64 = 0.0 x }"
  Test.assert_eq(f64_metric_direct_literals(src), 0)
}

test "f64_lowering_ieee_bits_happy_decimal_matrix" {
  Test.assert_eq(f64_literal_bits_ok("0.0"), 1)
  Test.assert_eq(f64_literal_bits("0.0"), 0)
  Test.assert_eq(f64_literal_bits("0.5"), 4602678819172646912)
  Test.assert_eq(f64_literal_bits("1.0"), 4607182418800017408)
  Test.assert_eq(f64_literal_bits("1.5"), 4609434218613702656)
  Test.assert_eq(f64_literal_bits("2.5"), 4612811918334230528)
  Test.assert_eq(f64_literal_bits("20.0"), 4626322717216342016)
}

test "f64_lowering_ieee_bits_round_nearest_even_boundaries" {
  Test.assert_eq(f64_literal_bits("16777217.0"), 4715268810125344768)
  Test.assert_eq(f64_literal_bits("9007199254740993.0"), 4845873199050653696)
}

test "f64_lowering_ieee_bits_long_fractional_literal" {
  Test.assert_eq(f64_literal_bits("0.0000690460016972063023"), 4544723120079945088)
}

test "f64_lowering_ieee_bits_exponent_notation_matrix" {
  Test.assert_eq(f64_literal_bits_ok("1e3"), 1)
  Test.assert_eq(f64_literal_bits("1e3"), 4652007308841189376)
  Test.assert_eq(f64_literal_bits("1.25e2"), 4638496509959077888)
  Test.assert_eq(f64_literal_bits("1e-3"), 4562254508917369340)
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { 1e3 + 2.0e1 }"), 1)
}

test "f64_lowering_ieee_bits_small_fast_path_matrix" {
  Test.assert_eq(f64_literal_fast_bits_ok("1.0"), 1)
  Test.assert_eq(f64_literal_fast_bits("1.0"), 4607182418800017408)
  Test.assert_eq(f64_literal_fast_bits("1e3"), 4652007308841189376)
  Test.assert_eq(f64_literal_fast_bits("1.25e2"), 4638496509959077888)
  Test.assert_eq(f64_literal_fast_bits("1e-3"), 4562254508917369340)
  Test.assert_eq(f64_literal_fast_bits("9007199254740993.0"), 4845873199050653696)
}

test "f64_lowering_ieee_bits_small_fast_path_falls_back_for_big_edges" {
  Test.assert_eq(f64_literal_fast_bits_ok("0.123456789012345678901234567890123456789"), 0)
  Test.assert_eq(f64_literal_fast_bits_ok("5e-324"), 0)
  Test.assert_eq(f64_literal_fast_bits_ok("1e309"), 0)
  Test.assert_eq(f64_literal_bits_ok("0.123456789012345678901234567890123456789"), 1)
  Test.assert_eq(f64_literal_bits_ok("5e-324"), 1)
  Test.assert_eq(f64_literal_bits_ok("1e309"), 1)
}

test "f64_lowering_ieee_bits_arbitrary_length_literals" {
  Test.assert_eq(f64_literal_bits("123456789012345678901234567890.0"), 5042042089369253694)
  Test.assert_eq(f64_literal_bits("0.123456789012345678901234567890123456789"), 4593560419847042655)
}

test "f64_lowering_ieee_bits_subnormal_and_overflow_boundaries" {
  Test.assert_eq(f64_literal_bits("5e-324"), 1)
  Test.assert_eq(f64_literal_bits("1e-324"), 0)
  Test.assert_eq(f64_literal_bits("2.2250738585072014e-308"), 4503599627370496)
  Test.assert_eq(f64_literal_bits("1.7976931348623157e308"), 9218868437227405311)
  Test.assert_eq(f64_literal_bits("1e309"), 9218868437227405312)
}

test "f64_lowering_ieee_bits_f32_contextual_matrix" {
  Test.assert_eq(f32_literal_bits_ok("1.0"), 1)
  Test.assert_eq(f32_literal_bits("1.0"), 1065353216)
  Test.assert_eq(f32_literal_bits("1.5"), 1069547520)
  Test.assert_eq(f32_literal_bits("2.5"), 1075838976)
  Test.assert_eq(f32_literal_bits("20.0"), 1101004800)
  Test.assert_eq(f32_literal_bits("16777217.0"), 1266679808)
  Test.assert_eq(f32_literal_bits("0.0000690460016972063023"), 949013706)
}

test "f64_lowering_ieee_bits_f32_exponent_subnormal_and_overflow" {
  Test.assert_eq(f32_literal_bits("1e3"), 1148846080)
  Test.assert_eq(f32_literal_bits("0.123456789012345678901234567890123456789"), 1039980266)
  Test.assert_eq(f32_literal_bits("1e-45"), 1)
  Test.assert_eq(f32_literal_bits("1e-46"), 0)
  Test.assert_eq(f32_literal_bits("3.4028234663852886e38"), 2139095039)
  Test.assert_eq(f32_literal_bits("1e39"), 2139095040)
}

test "f64_lowering_ieee_bits_f32_small_fast_path_matrix" {
  Test.assert_eq(f32_literal_fast_bits_ok("1.0"), 1)
  Test.assert_eq(f32_literal_fast_bits("1.0"), 1065353216)
  Test.assert_eq(f32_literal_fast_bits("1e3"), 1148846080)
  Test.assert_eq(f32_literal_fast_bits("1e-3"), 981668463)
  Test.assert_eq(f32_literal_fast_bits("16777217.0"), 1266679808)
  Test.assert_eq(f32_literal_fast_bits_ok("1e-45"), 0)
  Test.assert_eq(f32_literal_bits_ok("1e-45"), 1)
}

test "f64_lowering_metric_keeps_integer_generic_and_directs_standalone_literals" {
  Test.assert_eq(f64_metric_direct_literals("fn main() -> i64 { 1 + 2 }"), 0)
  Test.assert_eq(f64_metric_float_binaries("fn main() -> f64 { 1.5 }"), 0)
  Test.assert_eq(f64_metric_float_binaries("fn helper() -> f64 { 2.0 } fn main() -> f64 { helper() * 3.0 }"), 1)
}

test "f64_lowering_runtime_direct_literal_arithmetic_and_branch" {
  let x = 6.0 * 7.0
  if x == 42.0 {
    Test.assert_eq(1, 1)
  } else {
    Test.assert_eq(0, 1)
  }
}

test "f64_lowering_runtime_lhs_literal_evaluates_rhs_once" {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 0)
  if 1.0 < f64_lowering_bump(p) {
    Test.assert_eq(mem_load64(p), 1)
  } else {
    Test.assert_eq(0, 1)
  }
  arena_free(arena)
}

test "f64_lowering_runtime_nonliteral_operands_survive_rhs_call" {
  if f64_lowering_left_call() + f64_lowering_right_call() == 42.0 {
    Test.assert_eq(1, 1)
  } else {
    Test.assert_eq(0, 1)
  }
}

test "f64_lowering_runtime_local_register_loop_temporaries" {
  let mut x: f64 = 1.0
  let mut i = 0
  while i < 5 {
    let a: f64 = x * 2.0
    let b: f64 = a + 1.0
    x = b
    i = i + 1
  }
  if x == 63.0 {
    Test.assert_eq(1, 1)
  } else {
    Test.assert_eq(0, 1)
  }
}

test "f64_lowering_runtime_local_register_survives_inlined_sqrt" {
  let a: f64 = 9.0
  let got = f64_lowering_sqrt(a) + a
  if got == 12.0 {
    Test.assert_eq(1, 1)
  } else {
    Test.assert_eq(0, 1)
  }
}

test "f64_lowering_runtime_f64_table_leaf_stays_in_fp_tree" {
  let t = f64_table_new(2, 1)
  vector_push<f64>(t, 3.0)
  vector_push<f64>(t, 0.0)
  let i = 0
  let a: f64 = f64_table_get(t, i, 2, 0, 0.0)
  let got = (a + 1.0) * a
  if got == 12.0 {
    Test.assert_eq(1, 1)
  } else {
    Test.assert_eq(0, 1)
  }
}
