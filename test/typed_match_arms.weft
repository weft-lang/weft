-- test/typed_match_arms.weft — typed match arms (kernel §6.1/§6.2)
--
-- `x: T ->` narrows by set difference; `nil ->` is a real zero test
-- (not a catch-all binding named nil); exhaustiveness is residual-set
-- emptiness. Option-1 discipline (2026-08-03): typed arms require a
-- runtime-discriminable union — nil-sentinel or variant family; the
-- rejection cases live in test/negative/typed_match_*.weft.

use stdlib/string.{*}

type TmShape { TmCircle(i64), TmSquare(i64) }

fn tm_process(input: TmShape | nil) -> i64 {
  match input {
    s: TmShape -> match s { TmCircle(r) -> r * 3, TmSquare(w) -> w * 4 }
    nil        -> 0 - 1
  }
}

fn tm_pick(x: str | nil) -> i64 {
  match x {
    s: str -> __str_len(s)
    nil    -> 0 - 1
  }
}

fn tm_nil_first(x: str | nil) -> i64 {
  match x {
    nil    -> 0 - 1
    s: str -> __str_len(s)
  }
}

fn tm_guarded(x: str | nil) -> i64 {
  match x {
    s: str if __str_len(s) > 3 -> 100
    s: str -> 200
    nil    -> 300
  }
}

fn tm_typed_catch_all(n: i64) -> i64 {
  match n {
    v: i64 -> v + 1
  }
}

fn tm_capture(x: str | nil) -> i64 {
  match x {
    s: str -> {
      let f = () => __str_len(s)
      f()
    }
    nil -> 0
  }
}

fn tm_narrowed_flows_to_callee(x: str | nil) -> i64 {
  -- The bound name is str inside the arm: passing it to a str-typed
  -- callee must check (this is the narrowing payoff).
  match x {
    s: str -> tm_want_str(s)
    nil    -> 0
  }
}

fn tm_want_str(s: str) -> i64 { __str_len(s) }

test "typed_arm_variant_family_circle" {
  Test.assert_eq(tm_process(TmCircle(5)), 15)
}

test "typed_arm_variant_family_square" {
  Test.assert_eq(tm_process(TmSquare(5)), 20)
}

test "typed_arm_variant_family_nil" {
  Test.assert_eq(tm_process(nil), 0 - 1)
}

test "typed_arm_str_nil_union" {
  Test.assert_eq(tm_pick("abcd"), 4)
  Test.assert_eq(tm_pick(""), 0)
  Test.assert_eq(tm_pick(nil), 0 - 1)
}

test "nil_arm_first_is_a_real_test" {
  -- Regression guard: nil used to parse as a BINDING pattern, so a
  -- leading nil arm swallowed every scrutinee.
  Test.assert_eq(tm_nil_first(nil), 0 - 1)
  Test.assert_eq(tm_nil_first("xy"), 2)
}

test "typed_arm_guards_fall_through" {
  Test.assert_eq(tm_guarded("abcdef"), 100)
  Test.assert_eq(tm_guarded("ab"), 200)
  Test.assert_eq(tm_guarded(nil), 300)
}

test "typed_arm_full_coverage_catch_all" {
  Test.assert_eq(tm_typed_catch_all(41), 42)
  Test.assert_eq(tm_typed_catch_all(0 - 1), 0)
}

test "typed_arm_binding_captured_by_lambda" {
  Test.assert_eq(tm_capture("hello"), 5)
  Test.assert_eq(tm_capture(nil), 0)
}

test "typed_arm_narrowed_type_flows_to_callee" {
  Test.assert_eq(tm_narrowed_flows_to_callee("weft"), 4)
  Test.assert_eq(tm_narrowed_flows_to_callee(nil), 0)
}
