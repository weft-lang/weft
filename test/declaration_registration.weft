test "typed module body links a named handler through checked installation facts" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T @deferred fn later(value: T) -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) E<T>.later(value) with k -> k(value) }",
    "fixture/typed_link_target",
    68
  )
  let caller = registered_module(
    "use fixture/typed_link_target as h fn run() -> i64 { with h<i64>(42) { h.E<i64>.get() } }",
    "fixture/typed_link_caller",
    68
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match resolve_module_semantics(caller, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_module_bodies(
      caller,
      scope,
      resolution,
      68
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedModuleInstalled(program) -> Test.assert_eq_usize(program.handler_count(), 1)
      CheckedModuleInstallRejected(issue) -> Test.assert_eq_usize(
        0,
        match issue {
          CheckedModuleOrdinaryRejected(_, _) -> 1
          CheckedModuleInstallSelectionRejected(_) -> 2
          CheckedModuleInstallTemplateRejected(_, _) -> 3
          CheckedModuleInstallContractRejected(_, _) -> 4
          CheckedModuleInstallSpecializationRejected(_, _) -> 5
          CheckedModuleInstallBodyRejected(_, _) -> 6
          CheckedModuleInstallBodyInvalid(_, _) -> 7
          CheckedModuleInstallCompositionRejected(composition_issue) -> match composition_issue {
            CheckedModuleCompanionSegmentMismatch -> 81
            CheckedModuleHandlerMissing(_) -> 82
            CheckedModuleHandlerDuplicate(_) -> 83
            CheckedModuleHandlerDetailMismatch(_) -> 84
            CheckedModuleHandlerResultMismatch(_) -> 85
            CheckedModuleHandlerCountMismatch(_, _) -> 86
            CheckedModuleHandlerLinkRejected(_, link_issue) -> match link_issue {
              CheckedHandlerBodyLinkImplementationMismatch -> 91
              CheckedHandlerBodyLinkCallerMismatch -> 92
              CheckedHandlerBodyLinkSegmentMismatch -> 93
              CheckedHandlerBodyLinkSiteMismatch -> 94
              CheckedHandlerBodyLinkAtomMismatch -> 95
              CheckedHandlerBodyLinkConstructorCountMismatch(_, _) -> 96
              CheckedHandlerBodyLinkBodyMissing -> 97
            }
          }
          _ -> 99
        }
      )
    }
    _ -> Test.assert_eq(true, false)
  }
}

