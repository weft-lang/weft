      Test.assert_eq_usize(program.module_count(), 2)
      Test.assert_true(match program.module_at(0) { Some(_) -> true, _ -> false })
      Test.assert_true(match program.module_at(2) { None -> true, _ -> false })
    }
    CheckRejected -> Test.assert_true(false)
  }
}

