test "typed named handler installation checks caller values and records its boundary" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) }",
    "fixture/typed_install_target",
    68
  )
  let caller = registered_module(
    "use fixture/typed_install_target as h fn run() -> i64 { with h<i64>(42) { h.E<i64>.get() } }",
    "fixture/typed_install_caller",
    68
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match resolve_module_semantics(caller, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      caller,
      scope,
      resolution,
      68
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        Test.assert_eq_usize(product.function_count(), 1)
        let expressions = product.expressions()
        let effects = product.effects()
        let mut found = false
        let mut ordinal: usize = 0
        while ordinal < expressions.len() {
          let expression = checked_expr_id_from_ordinal(expressions.segment(), ordinal)
          match expressions.kind(expression) {
            CheckedHandlerInstallKind -> match effects.inspect(
              expressions.handler_install_detail(expression)
            ) {
              CheckedHandlerInstallDetail(install) -> {
                found = true
                Test.assert_eq(install.source_site > 0, true)
                Test.assert_eq_usize(expressions.expression_list_len(install.arguments), 1)
                Test.assert_eq_usize(expressions.type_list_len(install.type_arguments), 1)
                Test.assert_eq(
                  module_identity_eq(
                    checked_expr_segment_module(install.clause_segment),
                    target.identity
                  ),
                  true
                )
                Test.assert_eq(checked_expr_segment_ordinal(install.clause_segment) > 0, true)
                nil
              }
              _ -> {
                Test.assert_eq(true, false)
                nil
              }
            }
            _ -> nil
          }
          ordinal = ordinal + 1
        }
        Test.assert_eq(found, true)
      }
      _ -> Test.assert_eq(true, false)
    }
    _ -> Test.assert_eq(true, false)
  }
}

