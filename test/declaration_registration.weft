test "named handler templates keep generic effect and constructor variables" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) }",
    "fixture/handler_generic_template",
    28
  )
  let consumer = registered_module(
    "use fixture/handler_generic_template as h",
    "fixture/handler_generic_consumer",
    28
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, consumer),
    resolved_imports(consumer, target, false)
  )
  let length = consumer.source.text.len()
  Test.assert_true(
    match registration_scope_select_handler(
      scope,
      consumer.identity,
      consumer.source.span(length - 1, length).unwrap()
    ) {
      RegisteredHandlerSelected(module, handler) -> match resolve_semantic_handler_template(
        semantic_type_product_builder(consumer.identity, 8),
        scope,
        module,
        handler
      ) {
        SemanticHandlerTemplateResolved(product, template) -> match resolve_type_product_in_scope(
          product,
          consumer,
          scope,
          TypeParamListNil,
          PrimitiveTypeExpr(0)
        ) {
          (product, SemanticTypeResolved(integer)) -> {
            let arguments = [integer]
            let specialized = handle specialize_semantic_handler_template(
              product,
              scope,
              template,
              list.from_slice(arguments[..])
            ) {
              SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
            }
            Test.assert_true(
              match specialized {
                SemanticHandlerSpecialized(product, result) -> {
                  let catalog = semantic_type_product_catalog(product)
                  let atom_argument = match catalog.graph_for(result.atom) {
                    Some(graph) -> match semantic_type_graph_node(graph, result.atom) {
                      SemanticEffectAtomNode(_, arguments) -> {
                        let lists = semantic_type_graph_type_lists_local(graph)
                        if semantic_type_list_len(lists, arguments) == 1 {
                          semantic_type_graph_list_type_id(
                            graph,
                            semantic_type_list_edge(lists, arguments, 0)
                          )
                        } else { result.atom }
                      }
                      _ -> result.atom
                    }
                    None -> result.atom
                  }
                  result.constructor_parameters.len() == 1 and
                    semantic_type_catalog_equal(catalog, atom_argument, integer) and
                    semantic_type_catalog_equal(
                      catalog,
                      result.constructor_parameters.get(0).unwrap(),
                      integer
                    )
                }
                _ -> false
              }
            )
            let wrong_arity = handle specialize_semantic_handler_template(
              product,
              scope,
              template,
              Nil<SemanticTypeId>()
            ) {
              SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
            }
            match wrong_arity {
              SemanticHandlerSpecializationRejected(_, SemanticHandlerTypeArgumentCountMismatch) ->
                true
              _ -> false
            }
          }
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
}

test "named handler templates resolve a qualified dependency effect" {
  let effect_module = registered_module(
