    (TypeDeclaration, "Item"),
    (ConstructorDeclaration, "Item")
  ] {
    Test.assert_true(
      match scope_declaration_module(scope, consumer.identity, sample.0, sample.1) {
        Some(identity) -> module_identity_eq(identity, target.identity)
