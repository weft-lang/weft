test "named handler contract cannot implement a hidden dependency operation" {
  let effect_module = registered_module(
    "pub effect E { pub(package) fn hidden() -> i64 pub fn visible() -> i64 }",
    "foreign/handler_contract_effect",
    43
  )
  let handler_module = registered_module(
    "use foreign/handler_contract_effect as e pub implements e.E() { e.E.hidden() -> resume(1) e.E.visible() -> resume(2) }",
    "fixture/handler_contract_hidden",
    42
  )
  let declarations = effect_module.declarations
  match declarations.at(dense_index(0)).kind {
    RegisteredEffectDeclaration(value) -> {
      Test.assert_true(
        match value.operations.get(0).unwrap().name.visibility {
          PackageVisibility -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  let scope = registration_scope.registration_scope_build(
    registered_modules2(effect_module, handler_module),
    resolved_imports(handler_module, effect_module, false)
  )
  let result = match resolve_semantic_handler_template(
    semantic_type_product_builder(handler_module.identity, 8),
    scope,
    handler_module,
    first_registered_handler(handler_module)
  ) {
    SemanticHandlerTemplateResolved(product, template) ->
      resolve_semantic_handler_contract(product, scope, template)
    _ -> panic("expected qualified handler template")
  }
  Test.assert_true(
    match result {
      SemanticHandlerContractRejected(_, SemanticHandlerOperationInvisible(_)) -> true
      _ -> false
    }
  )
}

