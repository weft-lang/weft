test "typed program rejections name the failing declaration and its module" {
  let target_text = "pub type Carrier { Carrier(rc i64) } pub fn value() -> i64 { 1 }"
  let target = registered_module(target_text, "fixture/rejected_declaration_target", 68)
  let caller = registered_module(
    "use fixture/rejected_declaration_target as dep fn caller() -> i64 { dep.value() }",
    "fixture/rejected_declaration_caller",
    68
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match typed_check_program_rejection(
    check_registered_program(caller.identity, scope, 68),
    scope
  ) {
    Some(rejection) -> {
      Test.assert_str_eq(typed_check_stage_name(rejection.stage), "resolution")
      Test.assert_str_eq(rejection.module, "fixture/rejected_declaration_target")
      Test.assert_str_eq(rejection.function, "Carrier")
      Test.assert_str_eq(
        rejection.category,
        "declaration/internal_ownership_requires_authority"
      )
      let start = target_text.find("Carrier").unwrap()
      Test.assert_true(
        match rejection.location {
          DiagnosticSourceRange(_, found_start, found_end) ->
            found_start == start and found_end == start + 7
          _ -> false
        }
      )
    }
    None -> Test.assert_true(false)
  }
}

