    handler_module,
    handler_module.syntax.imports.get(0).unwrap(),
    effect_module.identity,
    false
  )
  let handler_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    handler_module.identity,
    false
  )
  let imports = [effect_edge, handler_edge]
  let scope = registration_scope.registration_scope_build(
    registered_modules3(effect_module, handler_module, consumer),
    registered_imports(imports[..])
  )
  let length = consumer.source.text.len()
  Test.assert_true(
    match registration_scope_select_handler(
      scope,
      consumer.identity,
      consumer.source.span(length - 1, length).unwrap()
    ) {
      RegisteredHandlerSelected(module, handler) -> match resolve_semantic_handler_template(
        semantic_type_product_builder(consumer.identity, 8),
        scope,
        module,
        handler
      ) {
        SemanticHandlerTemplateResolved(product, template) -> {
          let catalog = semantic_type_product_catalog(product)
          module_identity_eq(template.module.identity, handler_module.identity) and
            match catalog.graph_for(template.atom) {
              Some(graph) -> match semantic_type_graph_node(graph, template.atom) {
                SemanticEffectAtomNode(declaration, _) -> module_identity_eq(
                  declaration_identity_module(declaration),
                  effect_module.identity
                )
                _ -> false
              }
              None -> false
            }
        }
        _ -> false
      }
      _ -> false
    }
  )
}

