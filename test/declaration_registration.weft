            let accepted = handle specialize_semantic_handler_template(
              product,
              scope,
              template,
              list.from_slice(arguments[..])
            ) {
              SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(true)
            }
            match (rejected, accepted) {
              (
                SemanticHandlerSpecializationRejected(_, SemanticHandlerBoundUnsatisfied(_, _)),
                SemanticHandlerSpecialized(_, _)
              ) -> true
              _ -> false
            }
          }
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
}

test "authored named handler call resolves its module and concrete effect atom" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) }",
    "fixture/handler_call_target",
    31
  )
  let caller = registered_module(
    "use fixture/handler_call_target as h fn run() -> i64 { with h<i64>(42) { h.E<i64>.get() } }",
    "fixture/handler_call_consumer",
    31
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  let result = handle resolve_semantic_handler_call(
    semantic_type_product_builder(caller.identity, 8),
    scope,
    caller,
    TypeParamListNil,
    authored_handler_configuration(caller)
  ) {
    SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
  }
  Test.assert_true(
    match result {
      SemanticHandlerCallResolved(product, template, selected, arguments, clauses) -> {
        let catalog = semantic_type_product_catalog(product)
        let requirements = semantic_handler_clause_requirements(selected, clauses)
        let requirement = requirements.get(0).unwrap()
        let argument = arguments.get(0).unwrap()
        let substitution = selected.substitution
        let mapped = match template.handler.syntax.type_params {
          TypeParamListCons(TypeParam(_, _, identity, _), _) -> if identity >= 0 {
            semantic_type_substitution_get(
              substitution,
              SemanticParameterVariable(__i64_to_usize(identity))
            )
          } else { None<SemanticTypeId>() }
          _ -> None<SemanticTypeId>()
        }
        let atom_argument = match catalog.graph_for(selected.atom) {
          Some(graph) -> match semantic_type_graph_node(graph, selected.atom) {
            SemanticEffectAtomNode(_, values) -> {
              let lists = semantic_type_graph_type_lists_local(graph)
              semantic_type_graph_list_type_id(
                graph,
                semantic_type_list_edge(lists, values, 0)
              )
            }
            _ -> selected.atom
          }
          None -> selected.atom
        }
        let annotation = match template.handler.syntax.params {
          ParamListCons(Param(_, _, declared, _), _) -> declared
          _ -> MissingTypeExpr
        }
        let context = CheckedLexicalRoot(
          scope,
          target.identity,
          template.handler.syntax.type_params,
          selected.atom,
          Some(substitution)
        )
        let (resolved_product, resolved_annotation) = checked_body_resolve_type_in_environment(
          product,
          target,
          context,
          annotation
        )
        let resolved_catalog = semantic_type_product_catalog(resolved_product)
        module_identity_eq(template.module.identity, target.identity) and
          arguments.len() == 1 and
          clauses.len() == 1 and
          requirements.len() == 1 and
          requirement.parameter_count == 0 and
          not requirement.allows_deferred and
          semantic_type_catalog_equal(catalog, requirement.atom, selected.atom) and
          semantic_type_catalog_equal(catalog, argument, atom_argument) and
          match mapped {
            Some(value) -> semantic_type_catalog_equal(catalog, value, argument)
            None -> false
          } and
          match resolved_annotation {
            SemanticTypeResolved(value) -> semantic_type_catalog_equal(
              resolved_catalog,
              value,
              argument
            )
            _ -> false
          } and
          semantic_type_catalog_equal(
            catalog,
            selected.constructor_parameters.get(0).unwrap(),
            argument
          )
      }
      _ -> false
    }
  )
}

test "contextual named handler clauses check in their implementation scope" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T @deferred fn later(value: T) -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) E<T>.later(value) with k -> k(value) }",
    "fixture/contextual_handler_target",
    68
  )
  let caller = registered_module(
    "use fixture/contextual_handler_target as h fn run() -> i64 { with h<i64>(42) { h.E<i64>.get() } }",
    "fixture/contextual_handler_caller",
    68
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match resolve_module_semantics(caller, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let signatures = resolution.signatures()
      let caller_function_type = signatures.at(0).type_id
      match handle resolve_semantic_handler_call(
        resolution.continue_types(),
        scope,
        caller,
        TypeParamListNil,
        authored_handler_configuration(caller)
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      } {
        SemanticHandlerCallResolved(product, template, selected, _, clauses) -> {
          let result_type = selected.constructor_parameters.get(0).unwrap()
          let request = CheckedContextualHandlerRequest {
            template: template,
            specialization: selected,
            clauses: clauses,
            caller: caller.identity,
            source_site: 1,
            segment_ordinal: 1,
            caller_function_type: caller_function_type,
            caller_result_type: result_type,
            handle_result_type: result_type
          }
          match handle check_contextual_handler_body(request, scope, resolution, product, 68) {
            SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
          } {
            CheckedContextualHandlerAccepted(checked) -> {
              let expressions = checked.expressions()
              let effects = checked.effects()
              Test.assert_eq_usize(expressions.function_len(), 2)
              Test.assert_eq_usize(effects.clause_list_len(checked.clauses()), 2)
              Test.assert_eq_usize(
                expressions.function_parameter_count(expressions.function(0).parameters),
                1
              )
            }
            CheckedContextualHandlerRejected(issue) -> Test.assert_eq_usize(
              0,
              match issue {
                CheckedBodyProducerEffectApplicationUnavailable -> 11
                CheckedBodyProducerBodyLocalTypeUnavailable(missing) ->
                  if semantic_type_id_eq(missing, result_type) { 12 } else { 18 }
                CheckedBodyProducerTypeRejected(_) -> 13
                CheckedBodyProducerHandlerClauseRequired -> 14
                CheckedBodyProducerUnknownIdentifier(_) -> 15
                CheckedBodyProducerTypeMismatch(_, _) -> 16
                CheckedBodyProducerUnsupportedExpression -> 17
                _ -> 99
              }
            )
            CheckedContextualHandlerInvalid(_) -> Test.assert_eq_usize(0, 2)
          }
        }
        _ -> Test.assert_eq_usize(0, 3)
      }
    }
    _ -> Test.assert_eq_usize(0, 4)
  }
}

