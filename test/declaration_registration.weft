  let main = functions.at(dense_index(0))
  let rejected = match check_registered_program(module.identity, scope, 68) {
    CheckedProgramEntrypointRejected(checked_root, issue) -> match issue {
      CheckedProgramMainEffectful(identity, effects) -> {
        let resolution = checked_root.resolution()
        let signatures = resolution.signatures()
        let catalog = signatures.catalog()
        function_identity_eq(identity, main.identity) and match catalog.graph_for(effects) {
          Some(_) -> true
          None -> false
        }
      }
      _ -> false
    }
    _ -> false
  }
  Test.assert_true(rejected)
}

