fn typed_function() -> FunctionParse {
  let function = FunctionSyntax {
    name: TypeNameRange { start: 7, length: 4 },
    params: ParamListCons(Param(1, 1, MissingTypeExpr, ImplicitParamLabel), ParamListNil),
    result: MissingTypeExpr,
    effects: effect_sig_from_node(0),
    type_params: TypeParamListNil,
    body: IntLit(42, 0, 0)
  }
  FunctionParse { syntax: function, next: 17 }
}

fn typed_members() -> List<ImplMemberSyntax> {
  let mut members: List<ImplMemberSyntax> = Nil
  let parsed = typed_function()
  members = Cons(ImplMethod(parsed.syntax, PrivateVisibility), members)
  members = Cons(
    ImplTypeBinding(
      TypeNameRange { start: 1, length: 2 },
      MissingTypeExpr,
      TypeNameRange { start: 3, length: 4 }
    ),
    members
  )
  members.reverse()
}

test "constructed heterogeneous impl members retain function signatures" {
  for member in typed_members() {
    match member {
      ImplMethod(function, _) -> { Test.assert_eq(param_list_len(function.params), 1); nil }
      ImplTypeBinding(_, _, _) -> nil
    }
  }
}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registration_catalog_source() -> str {
  r#"use missing/dep as dep
pub const answer: i64 = 42
pub(package) type Entry { value: i64, label: str }
type Choice { Off, On(i64) }
type Token = opaque str
type Pair = (i64, i64)
pub effect Read { fn value() -> i64 pub(package) @deferred fn later() -> i64 }
pub trait Show { type Item fn show(self) -> str }
impl Entry { pub fn copy(self) -> Entry { self } }
impl Show for Entry { type Item = i64 fn show(self) -> str { self.label } }
pub fn run() -> i64 { answer }
const clash: i64 = 1
fn clash() -> i64 { 2 }
test "registered" { 42 }
implements Read() { Read.value() -> resume(1) Read.later() -> resume(2) }
default handler dep()"#
}

fn registered_name_text(name: RegisteredName) -> str {
  declaration_identity_name(name.identity).text().unwrap()
}

fn registered_identity_module(identity: DeclarationIdentity) -> ModuleIdentity {
  match identity {
    ModuleDeclarationIdentity(module, _, _) -> module
    MemberDeclarationIdentity(owner, _, _) -> registered_identity_module(owner)
  }
}

fn visibility_same(left: DeclVisibility, right: DeclVisibility) -> bool {
  match (left, right) {
    (PrivateVisibility, PrivateVisibility) -> true
    (PackageVisibility, PackageVisibility) -> true
    (PublicVisibility, PublicVisibility) -> true
    _ -> false
  }
}

fn assert_registration_catalog_matches_legacy(
  registered: RegisteredModule,
  table: i64
) -[Test]> nil {
  let names = registration_catalog.declaration_names(registered)
  Test.assert_eq_usize(names.len(), __i64_to_usize(module_fact_decl_count(table)))
  let mut index: i64 = 0
  while index < module_fact_decl_count(table) {
    let typed = names.get(__i64_to_usize(index)).unwrap()
    let raw = module_fact_decl_at(table, index)
    Test.assert_str_eq(
      registered_name_text(typed),
      runtime_str_from_bytes_copy(
        module_decl_fact_name_ptr(raw),
        module_decl_fact_name_len(raw)
      )
    )
    Test.assert_eq(
      declaration_namespace_code(declaration_identity_namespace(typed.identity)),
      module_decl_fact_namespace(raw)
    )
    Test.assert_true(visibility_same(typed.visibility, module_decl_fact_visibility(raw)))
    Test.assert_true(
      match (declaration_identity_owner(typed.identity), module_decl_fact_owner(raw)) {
        (nil, 0) -> true
        (identity: DeclarationIdentity, owner) -> owner != 0
        _ -> false
      }
    )
    Test.assert_true(
      module_identity_eq(
        registered_identity_module(typed.identity),
        named_module_identity("fixture/catalog", 47)
      )
    )
    index = index + 1
  }
  nil
}

test "typed registration catalogs every declaration and agrees with the bounded raw oracle" {
  let syntax = parse(registration_catalog_source())
  let source = syntax.source.source()
  let identity = named_module_identity("fixture/catalog", 47)
  let registered = registration_catalog.register(syntax.declarations, source, identity)
  let summary = registration_catalog.summary(registered)
  Test.assert_eq_usize(summary.declarations, 16)
  Test.assert_eq_usize(summary.named_declarations, 19)
  Test.assert_eq_usize(summary.functions, 4)
  Test.assert_eq_usize(summary.types, 4)
  Test.assert_eq_usize(summary.effects, 1)
  Test.assert_eq_usize(summary.traits, 1)
  Test.assert_eq_usize(summary.implementations, 2)
  Test.assert_eq_usize(summary.constants, 2)
  Test.assert_eq_usize(summary.handlers, 1)
  Test.assert_eq_usize(summary.default_handlers, 1)
  Test.assert_eq_usize(summary.imports, 1)
  Test.assert_eq_usize(summary.tests, 1)
  Test.assert_eq_usize(summary.invalid, 0)

  let table = ttable_new()
  ttable_register_source_in_package(
    table,
    __str_ptr(source.text),
    __str_len(source.text),
    __str_ptr("fixture/catalog.weft"),
    __str_len("fixture/catalog.weft"),
    47
  )
  let legacy_functions = declarations.register(syntax.declarations, source, table)
  Test.assert_eq(nlist_len(legacy_functions), 4)
  Test.assert_eq(ttable_entry_count(table), 8)
  let module = module_fact_find_source(table, __str_ptr(source.text))
  Test.assert_true(module_fact_entry_handler_implementation(module) != 0)
  Test.assert_eq(nlist_len(module_fact_entry_default_handlers(module)), 1)
  assert_registration_catalog_matches_legacy(registered, table)
}

test "typed registration identity is content-based across retained sources and package-aware" {
  let first = parse("fn same() -> i64 { 1 }")
  let second = parse("fn same() -> i64 { 2 }")
  let first_name = registration_catalog.declaration_names(
    registration_catalog.register(
      first.declarations,
      first.source.source(),
      named_module_identity("same/path", 3)
    )
  ).first().unwrap()
  let second_name = registration_catalog.declaration_names(
    registration_catalog.register(
      second.declarations,
      second.source.source(),
      named_module_identity("same/path", 3)
    )
  ).first().unwrap()
  let foreign_name = registration_catalog.declaration_names(
    registration_catalog.register(
      second.declarations,
      second.source.source(),
      named_module_identity("same/path", 4)
    )
  ).first().unwrap()
  Test.assert_true(declaration_identity_eq(first_name.identity, second_name.identity))
  Test.assert_true(not declaration_identity_eq(first_name.identity, foreign_name.identity))
}

test "typed registration assigns a forward inherent method to its declared type" {
  let syntax = parse(
    "impl Future { fn ready(self) -> i64 { self.value } } type Future { value: i64 }"
  )
  let registered = registration_catalog.register(
    syntax.declarations,
    syntax.source.source(),
    anonymous_module_identity(9)
  )
  let names = registration_catalog.declaration_names(registered)
  Test.assert_eq_usize(names.len(), 3)
  let method = names.first().unwrap()
  Test.assert_str_eq(registered_name_text(method), "ready")
  match declaration_identity_owner(method.identity) {
    owner: DeclarationIdentity -> {
      Test.assert_str_eq(declaration_identity_name(owner).text().unwrap(), "Future")
      Test.assert_true(
        match declaration_identity_namespace(owner) { TypeDeclaration -> true, _ -> false }
      )
    }
    nil -> Test.assert_true(false)
  }
}

test "typed registration gives primitive inherent methods distinct target owners" {
  let syntax = parse(
    "impl i64 { fn keep(self: i64) -> i64 { self } } "
    |> str_concat("impl str { fn keep(self: str) -> str { self } }")
  )
  let registered = registration_catalog.register(
    syntax.declarations,
    syntax.source.source(),
    anonymous_module_identity(1230)
  )
  let names = registration_catalog.declaration_names(registered)
  Test.assert_eq_usize(names.len(), 2)
  let first = names.get(0).unwrap().identity
  let second = names.get(1).unwrap().identity
  Test.assert_true(not declaration_identity_eq(first, second))
  match (declaration_identity_owner(first), declaration_identity_owner(second)) {
    (left: DeclarationIdentity, right: DeclarationIdentity) -> {
      Test.assert_true(
        match declaration_identity_namespace(left) {
          ImplementationTargetDeclaration -> true
          _ -> false
        }
      )
      Test.assert_true(
        match declaration_identity_namespace(right) {
          ImplementationTargetDeclaration -> true
          _ -> false
        }
      )
      Test.assert_true(not declaration_identity_eq(left, right))
    }
    _ -> Test.assert_true(false)
  }
}

test "typed registration keeps colliding value declarations distinct but identically named" {
  let syntax = parse("const clash: i64 = 1 fn clash() -> i64 { 2 }")
  let names = registration_catalog.declaration_names(
    registration_catalog.register(
      syntax.declarations,
      syntax.source.source(),
      named_module_identity("collision", 0)
    )
  )
  Test.assert_eq_usize(names.len(), 2)
  Test.assert_true(
    declaration_identity_eq(names.get(0).unwrap().identity, names.get(1).unwrap().identity)
  )
}

fn registered_module(text: str, path: str, package_id: i64) -[Test]> RegisteredModule {
  let syntax = parse(text)
  registration_catalog.register(
    syntax.declarations,
    syntax.source.source(),
    named_module_identity(path, package_id)
  )
}

fn resolved_imports(
  importer: RegisteredModule,
  target: RegisteredModule,
  weak: bool
) -> List<ResolvedImport> {
  importer.syntax.imports.map<ResolvedImport>(
    declaration => registration_scope.resolved_import(
      importer,
      declaration,
      target.identity,
      weak
    )
  )
}

fn scope_declaration_module(
  scope: RegistrationScope,
  module: ModuleIdentity,
  namespace: DeclarationNamespace,
  spelling: str
) -> Option<ModuleIdentity> {
  match registration_scope.registration_scope_lookup_declaration(
    scope,
    module,
    namespace,
    spelling
  ) {
    Some(name) -> Some(registered_identity_module(name.identity))
    None -> None<ModuleIdentity>()
  }
}

fn candidate_declaration_module(candidate: ScopeCandidate) -> Option<ModuleIdentity> {
  match candidate.target {
    ScopeDeclarationTarget(name) -> Some(registered_identity_module(name.identity))
    _ -> None<ModuleIdentity>()
  }
}

fn registered_modules(values: [RegisteredModule]) -> List<RegisteredModule> {
  list.from_slice(values)
}

fn registered_imports(values: [ResolvedImport]) -> List<ResolvedImport> {
  list.from_slice(values)
}

fn registered_modules1(first: RegisteredModule) -> List<RegisteredModule> {
  let values = [first]
  registered_modules(values[..])
}

fn registered_modules2(
  first: RegisteredModule,
  second: RegisteredModule
) -> List<RegisteredModule> {
  let values = [first, second]
  registered_modules(values[..])
}

fn registered_modules3(
  first: RegisteredModule,
  second: RegisteredModule,
  third: RegisteredModule
) -> List<RegisteredModule> {
  let values = [first, second, third]
  registered_modules(values[..])
}

fn registered_modules4(
  first: RegisteredModule,
  second: RegisteredModule,
  third: RegisteredModule,
  fourth: RegisteredModule
) -> List<RegisteredModule> {
  let values = [first, second, third, fourth]
  registered_modules(values[..])
}

fn registered_imports1(edge: ResolvedImport) -> List<ResolvedImport> {
  let values = [edge]
  registered_imports(values[..])
}

test "typed scopes retain distinct type and constructor namespaces" {
  let local = registered_module(
    "type Same { Same } fn value() -> i64 { 1 }",
    "fixture/local",
    1
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules1(local),
    Nil<ResolvedImport>()
  )
  Test.assert_true(
    match scope_declaration_module(scope, local.identity, TypeDeclaration, "Same") {
      Some(identity) -> module_identity_eq(identity, local.identity)
      None -> false
    }
  )
  Test.assert_true(
    match scope_declaration_module(scope, local.identity, ConstructorDeclaration, "Same") {
      Some(identity) -> module_identity_eq(identity, local.identity)
      None -> false
    }
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup(scope, local.identity, "Same") {
      ScopeNameAmbiguous(_, _) -> true
      _ -> false
    }
  )
}

test "typed scopes distinguish duplicate authored declarations from convergent imports" {
  let duplicate = registered_module(
    "const clash: i64 = 1 fn clash() -> i64 { 2 }",
    "fixture/duplicate",
    1
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules1(duplicate),
    Nil<ResolvedImport>()
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup(scope, duplicate.identity, "clash") {
      ScopeNameAmbiguous(_, _) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup_declaration(
      scope,
      duplicate.identity,
      ValueDeclaration,
      "clash"
    ) {
      None -> true
      Some(_) -> false
    }
  )
  let raw = ttable_new()
  raw_register_module(raw, duplicate)
  module_scope_build_all(raw)
  Test.assert_eq(
    module_scope_entry_status(
      module_scope_lookup(
        raw,
        __str_ptr(duplicate.source.text),
        __str_ptr("clash"),
        0,
        5
      )
    ),
    module_scope_status_ambiguous()
  )
}

test "typed declaration lookup joins retained spans to semantic storage" {
  let module = registered_module(
    "fn value() -> i64 { 1 }",
    "fixture/storage_join",
    1
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules1(module),
    Nil<ResolvedImport>()
  )
  let raw = ttable_new()
  raw_register_module(raw, module)
  let storage = registration_storage(raw, scope)
  let declaration = registration_storage_lookup_declaration(
    storage,
    __str_ptr(module.source.text),
    ValueDeclaration,
    __str_ptr(module.source.text),
    3,
    5
  )
  Test.assert_true(declaration != 0)
  Test.assert_true(
    declaration_identity_eq(
      module_decl_fact_id(declaration),
      match registration_scope_find_declaration(
        scope,
        module.identity,
        ValueDeclaration,
        "value"
      ) {
        Some(registered) -> registered.identity
        None -> panic("typed declaration was not retained")
      }
    )
  )
}

test "local declaration lookup keeps colliding opaque constructors distinct" {
  let module = registered_module(
    "type First = opaque i64 type Second = opaque str",
    "fixture/local_storage_join",
    1
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules1(module),
    Nil<ResolvedImport>()
  )
  let raw = ttable_new()
  raw_register_module(raw, module)
  let storage = registration_storage(raw, scope)
  let declaration = registration_storage_lookup_local_declaration(
    storage,
    __str_ptr(module.source.text),
    TypeDeclaration,
    __str_ptr(module.source.text),
    29,
    6
  )
  Test.assert_true(declaration != 0)
  Test.assert_str_eq(
    runtime_str_from_bytes_copy(
      module_decl_fact_name_ptr(declaration),
      module_decl_fact_name_len(declaration)
    ),
    "Second"
  )
}

test "qualified storage lookup selects a constructor from its paired type spelling" {
  let target = registered_module(
    "pub type Same { Same }",
    "fixture/qualified_storage_target",
    1
  )
  let consumer = registered_module(
    "use fixture/qualified_storage_target as target fn make() -> target.Same { target.Same() }",
    "fixture/qualified_storage_consumer",
    1
  )
  let imports = resolved_imports(consumer, target, false)
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, consumer),
    imports
  )
  let raw = ttable_new()
  raw_register_module(raw, target)
  raw_register_module(raw, consumer)
  raw_register_import(raw, consumer, target, 0)
  module_scope_build_all(raw)
  let storage = registration_storage(raw, scope)
  let source = __str_ptr(consumer.source.text)
  let typed = registration_storage_lookup_qualified_declaration(
    storage,
    source,
    source,
    74,
    6,
    ConstructorDeclaration,
    source,
    81,
    4
  )
  let legacy = module_scope_lookup_qualified_declaration(
    raw,
    source,
    source,
    74,
    6,
    module_decl_namespace_constructor(),
    source,
    81,
    4
  )
  Test.assert_true(typed != 0)
  Test.assert_eq(typed, legacy)
  Test.assert_eq(module_decl_fact_namespace(typed), module_decl_namespace_constructor())
  Test.assert_true(module_decl_fact_owner(typed) != 0)
}

test "typed scope diagnostics report retained declaration collisions" {
  let source = "const same: i64 = 1 fn same() -> i64 { 2 }"
  let duplicate = registered_module(source, "fixture/diagnostic", 1)
  let scope = registration_scope.registration_scope_build(
    registered_modules1(duplicate),
    Nil<ResolvedImport>()
  )
  let errors = handle registration_diagnostics.diagnose(scope) {
    Diagnose.report(diagnostic) -> {
      Test.assert_true(diagnostic.code().eq(DiagnosticCodeAssigned("E4003")))
      Test.assert_str_eq(
        diagnostic.message(),
        "module item 'same' is ambiguous in this scope"
      )
      Test.assert_true(
        match diagnostic.primary() {
          DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end) ->
            buffer == __str_ptr(source) and start == 23 and end == 27
          _ -> false
        }
      )
      Test.assert_eq_usize(diagnostic.related().len(), 2)
      Test.assert_eq_usize(diagnostic.fields().len(), 2)
      resume(0)
    }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  Test.assert_eq(errors, 1)
}

test "typed scopes resolve module selected renamed and wildcard imports" {
  let target = registered_module(
    "pub fn work() -> i64 { 1 } pub type Item { Item }",
    "fixture/target",
    2
  )
  let consumer = registered_module(
    "use fixture/target as target use fixture/target.{work as run, Item, *}",
    "fixture/consumer",
    2
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, consumer),
    resolved_imports(consumer, target, false)
  )
  for sample in [
    (ValueDeclaration, "run"),
    (ValueDeclaration, "work"),
    (TypeDeclaration, "Item"),
    (ConstructorDeclaration, "Item")
  ] {
    Test.assert_true(
      match scope_declaration_module(scope, consumer.identity, sample.0, sample.1) {
        Some(identity) -> module_identity_eq(identity, target.identity)
        None -> false
      }
    )
  }
  Test.assert_true(
    match registration_scope.registration_scope_lookup_qualified_declaration(
      scope,
      consumer.identity,
      "target",
      ValueDeclaration,
      "work"
    ) {
      Some(name) -> module_identity_eq(registered_identity_module(name.identity), target.identity)
      None -> false
    }
  )
}

test "named handler selection retains the imported module implementation identity" {
  let target = registered_module(
    "pub effect E { fn get() -> i64 } pub implements E() { E.get() -> resume(1) }",
    "fixture/handler_target",
    21
  )
  let consumer = registered_module(
    "use fixture/handler_target as h",
    "fixture/handler_consumer",
    21
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, consumer),
    resolved_imports(consumer, target, false)
  )
  let length = consumer.source.text.len()
  let alias = consumer.source.span(length - 1, length).unwrap()
  Test.assert_true(
    match registration_scope_select_handler(scope, consumer.identity, alias) {
      RegisteredHandlerSelected(module, handler) -> module_identity_eq(
        module.identity,
        target.identity
      ) and module_identity_eq(
        handler_implementation_module(handler.identity),
        target.identity
      )
      _ -> false
    }
  )
}

test "named handler selection enforces implementation visibility" {
  let target = registered_module(
    "pub effect E { fn get() -> i64 } pub(package) implements E() { E.get() -> resume(1) }",
    "fixture/handler_visible",
    22
  )
  let same_package = registered_module(
    "use fixture/handler_visible as h",
    "fixture/handler_same_package",
    22
  )
  let foreign = registered_module(
    "use fixture/handler_visible as h",
    "foreign/handler_consumer",
    23
  )
  let same_scope = registration_scope.registration_scope_build(
    registered_modules2(target, same_package),
    resolved_imports(same_package, target, false)
  )
  let same_length = same_package.source.text.len()
  Test.assert_true(
    match registration_scope_select_handler(
      same_scope,
      same_package.identity,
      same_package.source.span(same_length - 1, same_length).unwrap()
    ) {
      RegisteredHandlerSelected(_, _) -> true
      _ -> false
    }
  )
  let foreign_scope = registration_scope.registration_scope_build(
    registered_modules2(target, foreign),
    resolved_imports(foreign, target, false)
  )
  let foreign_length = foreign.source.text.len()
  Test.assert_true(
    match registration_scope_select_handler(
      foreign_scope,
      foreign.identity,
      foreign.source.span(foreign_length - 1, foreign_length).unwrap()
    ) {
      RegisteredHandlerImplementationInvisible -> true
      _ -> false
    }
  )
}

test "named handler selection rejects a plain module and a value alias" {
  let target = registered_module("pub fn work() -> i64 { 1 }", "fixture/no_handler", 24)
  let consumer = registered_module(
