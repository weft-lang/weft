test "specialized named handler constructor checks caller value types" {
  let target = registered_module(
    "pub effect E<T> { fn get() -> T } pub implements<T> E<T>(seed: T) { E<T>.get() -> resume(seed) }",
    "fixture/handler_constructor_types_target",
    67
  )
  let caller = registered_module(
    "use fixture/handler_constructor_types_target as h fn run() -> i64 { with h<i64>(42) { h.E<i64>.get() } }",
    "fixture/handler_constructor_types_caller",
    67
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match handle resolve_semantic_handler_call(
    semantic_type_product_builder(caller.identity, 8),
    scope,
    caller,
    TypeParamListNil,
    authored_handler_configuration(caller)
  ) {
    SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
  } {
    SemanticHandlerCallResolved(product, _, selected, _, _) -> {
      let catalog = semantic_type_product_catalog(product)
      let expected = selected.constructor_parameters.get(0).unwrap()
      let matching = [expected]
      let wrong = [selected.atom]
      let extra = [expected, expected]
      let accepted = handle validate_semantic_handler_constructor(
        catalog,
        selected,
        list.from_slice(matching[..])
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      let rejected = handle validate_semantic_handler_constructor(
        catalog,
        selected,
        list.from_slice(wrong[..])
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      let missing = handle validate_semantic_handler_constructor(
        catalog,
        selected,
        Nil<SemanticTypeId>()
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      let excessive = handle validate_semantic_handler_constructor(
        catalog,
        selected,
        list.from_slice(extra[..])
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      Test.assert_true(
        match accepted {
          SemanticHandlerConstructorValuesAccepted -> true
          _ -> false
        }
      )
      Test.assert_true(
        match rejected {
          SemanticHandlerConstructorValuesRejected(issue) -> match issue {
            SemanticHandlerConstructorValueTypeMismatch(0, required, actual) ->
              semantic_type_catalog_equal(catalog, required, expected) and
              semantic_type_catalog_equal(catalog, actual, selected.atom)
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match missing {
          SemanticHandlerConstructorValuesRejected(issue) -> match issue {
            SemanticHandlerConstructorValueCountMismatch(1, 0) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match excessive {
          SemanticHandlerConstructorValuesRejected(issue) -> match issue {
            SemanticHandlerConstructorValueCountMismatch(1, 2) -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

