test "qualified storage lookup selects a constructor from its paired type spelling" {
  let target = registered_module(
    "pub type Same { Same }",
    "fixture/qualified_storage_target",
    1
  )
  let consumer = registered_module(
    "use fixture/qualified_storage_target as target fn make() -> target.Same { target.Same() }",
    "fixture/qualified_storage_consumer",
    1
  )
  let imports = resolved_imports(consumer, target, false)
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, consumer),
    imports
  )
  let raw = ttable_new()
  raw_register_module(raw, target)
  raw_register_module(raw, consumer)
  raw_register_import(raw, consumer, target, 0)
  module_scope_build_all(raw)
  let storage = registration_storage(raw, scope)
  let source = __str_ptr(consumer.source.text)
  let typed = registration_storage_lookup_qualified_declaration(
    storage,
    source,
    source,
    74,
    6,
    ConstructorDeclaration,
    source,
    81,
    4
  )
  let legacy = module_scope_lookup_qualified_declaration(
    raw,
    source,
    source,
    74,
    6,
    module_decl_namespace_constructor(),
    source,
    81,
    4
  )
  Test.assert_true(typed != 0)
  Test.assert_eq(typed, legacy)
  Test.assert_eq(module_decl_fact_namespace(typed), module_decl_namespace_constructor())
  Test.assert_true(module_decl_fact_owner(typed) != 0)
}

test "typed scope diagnostics report retained declaration collisions" {
  let source = "const same: i64 = 1 fn same() -> i64 { 2 }"
  let duplicate = registered_module(source, "fixture/diagnostic", 1)
  let scope = registration_scope.registration_scope_build(
    registered_modules1(duplicate),
    Nil<ResolvedImport>()
  )
  let errors = handle registration_diagnostics.diagnose(scope) {
    Diagnose.report(diagnostic) -> {
      Test.assert_true(diagnostic.code().eq(DiagnosticCodeAssigned("E4003")))
      Test.assert_str_eq(
        diagnostic.message(),
        "module item 'same' is ambiguous in this scope"
      )
      Test.assert_true(
        match diagnostic.primary() {
          DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end) ->
            buffer == __str_ptr(source) and start == 23 and end == 27
          _ -> false
        }
      )
      Test.assert_eq_usize(diagnostic.related().len(), 2)
      Test.assert_eq_usize(diagnostic.fields().len(), 2)
      resume(0)
    }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  Test.assert_eq(errors, 1)
}

test "typed scopes resolve module selected renamed and wildcard imports" {
