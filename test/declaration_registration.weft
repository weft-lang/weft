test "typed scopes apply visibility and reexport constraints" {
  let target = registered_module(
    "pub fn public_value() -> i64 { 1 } pub(package) fn package_value() -> i64 { 2 } fn private_value() -> i64 { 3 }",
    "fixture/visibility",
    7
  )
  let same_package = registered_module(
    "use fixture/visibility.{public_value, package_value, private_value}",
    "fixture/same_package",
    7
  )
  let foreign = registered_module(
    "use fixture/visibility.{public_value, package_value, private_value}",
    "foreign/consumer",
    8
  )
  let facade = registered_module(
    "pub use fixture/visibility.{package_value}",
    "fixture/facade",
    7
  )
  let same_scope = registration_scope.registration_scope_build(
    registered_modules2(target, same_package),
    resolved_imports(same_package, target, false)
  )
  Test.assert_true(
    match scope_declaration_module(
      same_scope,
      same_package.identity,
      ValueDeclaration,
      "package_value"
    ) {
      Some(identity) -> module_identity_eq(identity, target.identity)
      None -> false
    }
  )
  Test.assert_eq_usize(registration_scope.registration_scope_issue_count(same_scope), 1)
  Test.assert_true(
    match registration_scope.registration_scope_issue_at(same_scope, 0).status {
      ScopeImportInvisible -> true
      _ -> false
    }
  )

  let foreign_scope = registration_scope.registration_scope_build(
    registered_modules2(target, foreign),
    resolved_imports(foreign, target, false)
  )
  Test.assert_eq_usize(registration_scope.registration_scope_issue_count(foreign_scope), 2)
  Test.assert_true(
    match scope_declaration_module(
      foreign_scope,
      foreign.identity,
      ValueDeclaration,
      "public_value"
    ) {
      Some(identity) -> module_identity_eq(identity, target.identity)
      None -> false
    }
  )
  let qualified = registered_module(
    "use fixture/visibility as visible",
    "foreign/qualified",
    8
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup_qualified_declaration(
      registration_scope.registration_scope_build(
        registered_modules2(target, qualified),
        resolved_imports(qualified, target, false)
      ),
      named_module_identity("foreign/qualified", 8),
      "visible",
      ValueDeclaration,
      "package_value"
    ) {
      None -> true
      Some(_) -> false
    }
  )

  let facade_scope = registration_scope.registration_scope_build(
    registered_modules2(target, facade),
    resolved_imports(facade, target, false)
  )
  Test.assert_eq_usize(registration_scope.registration_scope_issue_count(facade_scope), 1)
  Test.assert_true(
    match registration_scope.registration_scope_issue_at(facade_scope, 0).status {
      ScopeImportWidenedReexport -> true
      _ -> false
    }
  )
}

test "typed wildcard scopes silently omit declarations below the requested visibility" {
  let target = registered_module(
    "pub fn public_value() -> i64 { 1 } pub(package) fn package_value() -> i64 { 2 } fn private_value() -> i64 { 3 }",
    "fixture/wildcard",
    11
  )
