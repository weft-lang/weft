test "typed named handler clauses retain distinct annotated parameter types" {
  let target = registered_module(
    "pub effect E<T> { fn first(f: (T) -> T) -> T fn second(g: (str) -> T) -> T } pub implements<T> E<T>() { E<T>.first(f: (T) -> T) -> resume(f(1)) E<T>.second(g: (str) -> T) -> resume(g(\"x\")) }",
    "fixture/typed_install_clause_catalog_target",
    68
  )
  let caller = registered_module(
    "use fixture/typed_install_clause_catalog_target as h fn run() -> i64 { with h<i64>() { 1 } }",
    "fixture/typed_install_clause_catalog_caller",
    68
  )
  let scope = registration_scope.registration_scope_build(
    registered_modules2(target, caller),
    resolved_imports(caller, target, false)
  )
  match resolve_module_semantics(caller, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_module_bodies(
      caller,
      scope,
      resolution,
      68
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedModuleInstalled(program) -> {
        Test.assert_eq_usize(program.handler_count(), 1)
        let handler = program.handlers().get(0).unwrap()
        let expressions = handler.expressions()
        let first = expressions.function(0).parameters
        let second = expressions.function(1).parameters
        let first_type = expressions.binding(expressions.function_parameter(first, 0)).value_type
        let second_type = expressions.binding(expressions.function_parameter(second, 0)).value_type
        Test.assert_eq(semantic_type_id_eq(first_type, second_type), false)
      }
      _ -> Test.assert_eq(true, false)
    }
    _ -> Test.assert_eq(true, false)
  }
}

