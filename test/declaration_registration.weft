fn typed_function() -> FunctionParse {
  let function = FunctionSyntax {
    name: TypeNameRange { start: 7, length: 4 },
    params: ParamListCons(Param(1, 1, MissingTypeExpr, ImplicitParamLabel), ParamListNil),
    result: MissingTypeExpr,
    effects: effect_sig_from_node(0),
    type_params: TypeParamListNil,
    body: IntLit(42, 0, 0)
  }
  FunctionParse { syntax: function, next: 17 }
}

fn typed_members() -> List<ImplMemberSyntax> {
  let mut members: List<ImplMemberSyntax> = Nil
  let parsed = typed_function()
  members = Cons(ImplMethod(parsed.syntax, PrivateVisibility), members)
  members = Cons(
    ImplTypeBinding(
      TypeNameRange { start: 1, length: 2 },
      MissingTypeExpr,
      TypeNameRange { start: 3, length: 4 }
    ),
    members
  )
  members.reverse()
}

test "constructed heterogeneous impl members retain function signatures" {
  for member in typed_members() {
    match member {
      ImplMethod(function, _) -> { Test.assert_eq(param_list_len(function.params), 1); nil }
      ImplTypeBinding(_, _, _) -> nil
    }
  }
}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registration_catalog_source() -> str {
  r#"use missing/dep as dep
pub const answer: i64 = 42
pub(package) type Entry { value: i64, label: str }
type Choice { Off, On(i64) }
type Token = opaque str
type Pair = (i64, i64)
pub effect Read { fn value() -> i64 pub(package) @deferred fn later() -> i64 }
pub trait Show { type Item fn show(self) -> str }
impl Entry { pub fn copy(self) -> Entry { self } }
impl Show for Entry { type Item = i64 fn show(self) -> str { self.label } }
pub fn run() -> i64 { answer }
const clash: i64 = 1
fn clash() -> i64 { 2 }
test "registered" { 42 }
implements Read() { Read.value() -> resume(1) Read.later() -> resume(2) }
default handler dep()"#
}

fn registered_name_text(name: RegisteredName) -> str {
  declaration_identity_name(name.identity).text().unwrap()
}

fn registered_identity_module(identity: DeclarationIdentity) -> ModuleIdentity {
  match identity {
    ModuleDeclarationIdentity(module, _, _) -> module
    MemberDeclarationIdentity(owner, _, _) -> registered_identity_module(owner)
  }
}

fn visibility_same(left: DeclVisibility, right: DeclVisibility) -> bool {
  match (left, right) {
    (PrivateVisibility, PrivateVisibility) -> true
    (PackageVisibility, PackageVisibility) -> true
    (PublicVisibility, PublicVisibility) -> true
    _ -> false
  }
}

fn assert_registration_catalog_matches_legacy(
  registered: RegisteredModule,
  table: i64
) -[Test]> nil {
  let names = registration_catalog.declaration_names(registered)
  Test.assert_eq_usize(names.len(), __i64_to_usize(module_fact_decl_count(table)))
  let mut index: i64 = 0
  while index < module_fact_decl_count(table) {
    let typed = names.get(__i64_to_usize(index)).unwrap()
    let raw = module_fact_decl_at(table, index)
    Test.assert_str_eq(
      registered_name_text(typed),
      runtime_str_from_bytes_copy(
        module_decl_fact_name_ptr(raw),
        module_decl_fact_name_len(raw)
      )
    )
    Test.assert_eq(
      declaration_namespace_code(declaration_identity_namespace(typed.identity)),
      module_decl_fact_namespace(raw)
    )
    Test.assert_true(visibility_same(typed.visibility, module_decl_fact_visibility(raw)))
    Test.assert_true(
      match (declaration_identity_owner(typed.identity), module_decl_fact_owner(raw)) {
        (nil, 0) -> true
        (identity: DeclarationIdentity, owner) -> owner != 0
        _ -> false
      }
    )
    Test.assert_true(
      module_identity_eq(
        registered_identity_module(typed.identity),
        named_module_identity("fixture/catalog", 47)
      )
    )
    index = index + 1
  }
  nil
}

test "typed registration catalogs every declaration and agrees with the bounded raw oracle" {
  let syntax = parse(registration_catalog_source())
  let source = syntax.source.source()
  let identity = named_module_identity("fixture/catalog", 47)
  let registered = registration_catalog.register(syntax.declarations, source, identity)
  let summary = registration_catalog.summary(registered)
  Test.assert_eq_usize(summary.declarations, 16)
  Test.assert_eq_usize(summary.named_declarations, 19)
  Test.assert_eq_usize(summary.functions, 4)
  Test.assert_eq_usize(summary.types, 4)
  Test.assert_eq_usize(summary.effects, 1)
  Test.assert_eq_usize(summary.traits, 1)
  Test.assert_eq_usize(summary.implementations, 2)
  Test.assert_eq_usize(summary.constants, 2)
  Test.assert_eq_usize(summary.handlers, 1)
  Test.assert_eq_usize(summary.default_handlers, 1)
  Test.assert_eq_usize(summary.imports, 1)
  Test.assert_eq_usize(summary.tests, 1)
  Test.assert_eq_usize(summary.invalid, 0)

  let table = ttable_new()
  ttable_register_source_in_package(
    table,
    __str_ptr(source.text),
    __str_len(source.text),
    __str_ptr("fixture/catalog.weft"),
    __str_len("fixture/catalog.weft"),
    47
  )
  let legacy_functions = declarations.register(syntax.declarations, source, table)
  Test.assert_eq(nlist_len(legacy_functions), 4)
  Test.assert_eq(ttable_entry_count(table), 8)
  let module = module_fact_find_source(table, __str_ptr(source.text))
  Test.assert_true(module_fact_entry_handler_implementation(module) != 0)
  Test.assert_eq(nlist_len(module_fact_entry_default_handlers(module)), 1)
  assert_registration_catalog_matches_legacy(registered, table)
}

test "typed registration identity is content-based across retained sources and package-aware" {
  let first = parse("fn same() -> i64 { 1 }")
  let second = parse("fn same() -> i64 { 2 }")
  let first_name = registration_catalog.declaration_names(
    registration_catalog.register(
      first.declarations,
      first.source.source(),
      named_module_identity("same/path", 3)
    )
  ).first().unwrap()
  let second_name = registration_catalog.declaration_names(
    registration_catalog.register(
      second.declarations,
      second.source.source(),
      named_module_identity("same/path", 3)
    )
  ).first().unwrap()
  let foreign_name = registration_catalog.declaration_names(
    registration_catalog.register(
      second.declarations,
      second.source.source(),
      named_module_identity("same/path", 4)
    )
  ).first().unwrap()
  Test.assert_true(declaration_identity_eq(first_name.identity, second_name.identity))
  Test.assert_true(not declaration_identity_eq(first_name.identity, foreign_name.identity))
}

test "typed registration assigns a forward inherent method to its declared type" {
  let syntax = parse(
    "impl Future { fn ready(self) -> i64 { self.value } } type Future { value: i64 }"
  )
  let registered = registration_catalog.register(
    syntax.declarations,
    syntax.source.source(),
    anonymous_module_identity(9)
  )
  let names = registration_catalog.declaration_names(registered)
  Test.assert_eq_usize(names.len(), 3)
  let method = names.first().unwrap()
  Test.assert_str_eq(registered_name_text(method), "ready")
  match declaration_identity_owner(method.identity) {
    owner: DeclarationIdentity -> {
      Test.assert_str_eq(declaration_identity_name(owner).text().unwrap(), "Future")
      Test.assert_true(
        match declaration_identity_namespace(owner) { TypeDeclaration -> true, _ -> false }
      )
    }
    nil -> Test.assert_true(false)
  }
}

test "typed registration keeps colliding value declarations distinct but identically named" {
  let syntax = parse("const clash: i64 = 1 fn clash() -> i64 { 2 }")
  let names = registration_catalog.declaration_names(
    registration_catalog.register(
      syntax.declarations,
      syntax.source.source(),
      named_module_identity("collision", 0)
    )
  )
  Test.assert_eq_usize(names.len(), 2)
  Test.assert_true(
    declaration_identity_eq(names.get(0).unwrap().identity, names.get(1).unwrap().identity)
  )
}

fn manifest_export(manifest: i64, kind: i64, name: str) -> i64 {
  pkg_manifest_find_export(manifest, kind, __str_ptr(name), __str_len(name))
}

test "frozen registration scopes retain package-qualified declaration catalogs" {
  let app = parse("pub type Value { value: i64 } pub fn run() -> i64 { 1 }")
  let dependency = parse("pub type Value { value: str }")
  let builder = registration_builder()
  registration_builder_add(
    builder,
    registration_catalog.register(
      app.declarations,
      app.source.source(),
      named_module_identity("grammar/value", 1)
    )
  )
  registration_builder_add(
    builder,
    registration_catalog.register(
      dependency.declarations,
      dependency.source.source(),
      named_module_identity("grammar/value", 2)
    )
  )
  let scope = registration_builder_freeze(builder)

  Test.assert_eq_usize(registration_scope_len(scope), 2)
  match registration_scope_find(scope, named_module_identity("grammar/value", 2)) {
    Some(module) -> Test.assert_eq_usize(registration_catalog.summary(module).functions, 0)
    None -> Test.assert_true(false)
  }
  match registration_scope_find_declaration(
    scope,
    named_module_identity("grammar/value", 1),
    TypeDeclaration,
    "Value"
  ) {
    Some(name) -> Test.assert_str_eq(registered_name_text(name), "Value")
    None -> Test.assert_true(false)
  }
  Test.assert_true(
    registration_scope_has_other_declaration(
      scope,
      named_module_identity("grammar/value", 1),
      TypeDeclaration,
      "run"
    )
  )
}

test "typed package export resolution reports every structural outcome" {
  let syntax = parse(
    "pub type Grammar { Grammar } pub fn public_tool() -> i64 { 1 } fn private_tool() -> i64 { 2 }"
  )
  let builder = registration_builder()
  let module = named_module_identity("grammar/exported", 9)
  registration_builder_add(
    builder,
    registration_catalog.register(syntax.declarations, syntax.source.source(), module)
  )
  let scope = registration_builder_freeze(builder)
  let manifest = pkg_manifest_parse_str(
    r#"{"package":"fixture","exports":{"grammars":{"grammar":{"module":"grammar/exported","declaration":"Grammar","execution":"validate_only"}},"tools":{"public":{"module":"grammar/exported","declaration":"public_tool"},"private":{"module":"grammar/exported","declaration":"private_tool"},"wrong":{"module":"grammar/exported","declaration":"Grammar"},"missing":{"module":"grammar/exported","declaration":"absent"},"pending":{"module":"grammar/unloaded","declaration":"run"}}}}"#
  )

  match package_export_resolve_loaded(
    scope,
    9,
    manifest_export(manifest, pkg_export_kind_grammar(), "grammar")
  ) {
    PackageExportResolved(identity) -> Test.assert_true(
      match declaration_identity_namespace(identity) { TypeDeclaration -> true, _ -> false }
    )
    _ -> Test.assert_true(false)
  }
  match package_export_resolve_loaded(
    scope,
    9,
    manifest_export(manifest, pkg_export_kind_tool(), "public")
  ) {
    PackageExportResolved(identity) -> Test.assert_str_eq(
      declaration_identity_name(identity).text().unwrap(),
      "public_tool"
    )
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "private")
    ) { PackageExportNotPublic -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "wrong")
    ) { PackageExportWrongKind -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "missing")
    ) { PackageExportMissingDeclaration -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "pending")
    ) { PackageExportPending -> true, _ -> false }
  )
}

test "combining frozen registration scopes preserves both module sets" {
  let left_syntax = parse("pub fn left() -> i64 { 1 }")
  let right_syntax = parse("pub fn right() -> i64 { 2 }")
  let left = registration_builder()
  let right = registration_builder()
  registration_builder_add(
    left,
    registration_catalog.register(
      left_syntax.declarations,
      left_syntax.source.source(),
      named_module_identity("left", 0)
    )
  )
  registration_builder_add(
    right,
    registration_catalog.register(
      right_syntax.declarations,
      right_syntax.source.source(),
      named_module_identity("right", 0)
    )
  )
  let combined = registration_scope_combined(
    registration_builder_freeze(left),
    registration_builder_freeze(right)
  )
  Test.assert_eq_usize(registration_scope_len(combined), 2)
  Test.assert_true(
    match registration_scope_find(combined, named_module_identity("left", 0)) {
      Some(_) -> true
      None -> false
    }
  )
  Test.assert_true(
    match registration_scope_find(combined, named_module_identity("right", 0)) {
      Some(_) -> true
      None -> false
    }
  )
}

fn assert_method_params(text: str, expected: i64) -[Test]> nil {
  let syntax = parse(text)
  let mut methods = 0
  for declaration in syntax.declarations.declarations {
    match declaration.syntax {
      ImplDefinition(implementation) -> {
        for member in implementation.members {
          match member {
            ImplMethod(function, _) -> {
              Test.assert_eq(param_list_len(function.params), expected)
              methods = methods + 1
            }
            ImplTypeBinding(_, _, _) -> nil
          }
        }
      }
      _ -> nil
    }
  }
  Test.assert_eq(methods, 1)
  nil
}

fn assert_authored_receiver(syntax: ParsedWeftSource) -[Test]> nil {
  let mut methods = 0
  for declaration in syntax.declarations.declarations {
    match declaration.syntax {
      ImplDefinition(implementation) -> for member in implementation.members {
        match member {
          ImplMethod(function, _) -> {
            Test.assert_true(
              match function.params {
                ParamListCons(Param(_, _, VariableTypeExpr(identity), _), ParamListNil) ->
                  identity == - 1
                _ -> false
              }
            )
            Test.assert_true(
              match function.result { VariableTypeExpr(identity) -> identity == - 1, _ -> false }
            )
            methods = methods + 1
          }
          _ -> nil
        }
      }
      _ -> nil
    }
  }
  Test.assert_eq(methods, 1)
  nil
}

test "independent host registration does not resolve authored Self syntax in place" {
  let syntax = parse("type Box { value: i64 } impl Box { fn copy(self) -> Self { self } }")
  assert_authored_receiver(syntax)
  let first = declarations.register(syntax.declarations, syntax.source.source(), ttable_new())
  assert_authored_receiver(syntax)
  let second = declarations.register(syntax.declarations, syntax.source.source(), ttable_new())
  assert_authored_receiver(syntax)
  Test.assert_eq(nlist_len(first), 1)
  Test.assert_eq(nlist_len(second), 1)
  let first_method = node_f1(nlist_get(first, 0))
  let second_method = node_f1(nlist_get(second, 0))
  Test.assert_true(first_method != second_method)
  Test.assert_true(ty_eq(node_f2(first_method), node_f2(second_method)))
  Test.assert_true(
    ty_eq(
      node_f3(nlist_get(node_f3(node_f1(first_method)), 0)),
      node_f2(first_method)
    )
  )
}

fn literal(expr: Expr) -> Expr {
  match expr {
    Block(first, rest) -> literal(expr_block_result(first, rest))
    _ -> expr
  }
}

test "match transport retains ordinary let and for binding contexts" {
  for sample in [(ExplicitMatch, 0), (LetDestructuring, 1), (ForDestructuring, 2)] {
    let arms = MatchArmListCons(Arm(Wildcard, IntLit(7, 0, 0), NilExpr, 0), MatchArmListNil)
    let raw = expr_to_node(Match(IntLit(1, 0, 0), arms, sample.0))
    let metadata = node_f4(raw)
    Test.assert_eq(if metadata == 0 { 0 } else { node_f1(metadata) }, sample.1)
    Test.assert_true(
      match expr_from_node(raw) {
        Match(_, _, origin) -> match origin {
          ExplicitMatch -> sample.1 == 0
          LetDestructuring -> sample.1 == 1
          ForDestructuring -> sample.1 == 2
        }
        _ -> false
      }
    )
  }
}

test "constructor transport preserves qualifiers independently of resolved identity" {
  for declaration in [0, 123] {
    for qualifier in [nil, TypeNameRange { start: 0, length: 3 }] {
      let children = PatternListCons(Binding(30, 1), PatternListNil)
      let raw = pattern_to_node(CtorPattern(4, 5, children, declaration, qualifier))
      Test.assert_eq(
        node_tag(raw),
        match qualifier {
          nil -> if declaration == 0 { 20 } else { 67 }
          range: TypeNameRange -> 67
        }
      )
      Test.assert_true(
        match pattern_from_node(raw) {
          CtorPattern(4, 5, PatternListCons(Binding(30, 1), PatternListNil), identity, restored) ->
            identity == declaration and match (qualifier, restored) {
              (nil, nil) -> true
              (expected: TypeNameRange, actual: TypeNameRange) ->
                expected.start == actual.start and expected.length == actual.length
              _ -> false
            }
          _ -> false
        }
      )
    }
  }
}

fn authored_trait_result(syntax: ParsedWeftSource) -> TypeExpr {
  for declaration in syntax.declarations.declarations {
    match declaration.syntax {
      TraitDefinition(trait_syntax) -> {
        let mut members = trait_syntax.members
        loop {
          match members {
            TypeTraitMemberListNil -> break
            TypeTraitMemberListCons(member, rest) -> {
              match member {
                TypeTraitMethod(_, _, _, result, _) -> return result
                _ -> nil
              }
              members = rest
            }
          }
        }
      }
      _ -> nil
    }
  }
  panic("expected a trait method")
}

test "associated type interpretation leaves authored trait names unchanged" {
  let syntax = parse("trait Cursor { type Item fn next(self) -> Item }")
  let before = authored_trait_result(syntax)
  let table = ttable_new()
  declarations.register(syntax.declarations, syntax.source.source(), table)
  let after = authored_trait_result(syntax)
  for result in [before, after] {
    Test.assert_true(
      match result {
        NamedTypeExpr(_, _, TypeExprListNil, SourceTypeOrigin(range)) ->
          syntax.source.source().text.slice(
            __i64_to_usize(range.start),
            __i64_to_usize(range.start + range.length)
          ).unwrap() == "Item"
        _ -> false
      }
    )
  }
  Test.assert_true(
    match type_entry_from_ptr(ttable_entry_at(table, 0)) {
      TypeTraitEntry(_, _, TypeTraitMemberListCons(_,
      TypeTraitMemberListCons(TypeTraitMethod(_, _, _, AssociatedTypeExpr(VariableTypeExpr(identity), _), _),
      TypeTraitMemberListNil))) -> identity == - 1
      _ -> false
    }
  )
}

test "effect operation visibility and suspension survive host registration" {
  let syntax = parse(
    "pub effect Await<T> { fn visible() -> T pub(package) @deferred fn suspend(value: T) -> T }"
  )
  let table = ttable_new()
  let source = syntax.source.source()
  let buffer = __str_ptr(source.text)
  declarations.register(syntax.declarations, source, table)
  let mut effects = 0
  for declaration in syntax.declarations.declarations {
    match declaration.syntax {
      EffectDefinition(effect_syntax) -> {
        effects = effects + 1
        Test.assert_eq(type_param_list_len(effect_syntax.type_params), 1)
        Test.assert_eq_usize(effect_syntax.operations.len(), 2)
        let owner = module_decl_fact_find(
          table,
          buffer,
          module_decl_namespace_effect(),
          buffer,
          effect_syntax.name.start,
          effect_syntax.name.length
        )
        let mut operations = 0
        for member in effect_syntax.operations {
          let (start, length, deferred) = match member.operation {
            TypeEffectOp(start, length, _, VariableTypeExpr(_)) -> (start, length, false)
            DeferredTypeEffectOp(start, length, _, VariableTypeExpr(_)) -> (start, length, true)
            _ -> panic("expected a generic operation result")
          }
          let identity = module_decl_fact_find_member(
            table,
            owner,
            module_decl_namespace_effect_operation(),
            buffer,
            start,
            length
          )
          Test.assert_true(identity != 0)
          Test.assert_true(
            match (member.visibility, module_decl_fact_visibility(identity)) {
              (PublicVisibility, PublicVisibility) -> not deferred and operations == 0
              (PackageVisibility, PackageVisibility) -> deferred and operations == 1
              _ -> false
            }
          )
          operations = operations + 1
        }
        Test.assert_eq(operations, 2)
        nil
      }
      _ -> nil
    }
  }
  Test.assert_eq(effects, 1)
}

test "authored literal ranges survive declaration registration" {
  for sample in [("true", "bool"), ("false", "bool"), ("\"café\\n\"", "str"), ("\"\"", "str")] {
    let prefix = "-- 🧶\nfn value() -> ".concat(sample.1).concat(" { ")
    let text = prefix.concat(sample.0).concat(" }")
    let syntax = parse(text)
    let mut literals = 0
    for declaration in syntax.declarations.declarations {
      match declaration.syntax {
        FunctionDefinition(function) -> {
          let range = match literal(function.body) {
            BoolLit(_, start, length) -> TypeNameRange { start: start, length: length }
            StringLit(_, _, start, length) -> TypeNameRange { start: start, length: length }
            _ -> panic("expected authored literal")
          }
          Test.assert_eq_usize(__i64_to_usize(range.start), prefix.len())
          Test.assert_eq_usize(__i64_to_usize(range.length), sample.0.len())
          literals = literals + 1
        }
        _ -> nil
      }
    }
    Test.assert_eq(literals, 1)
    let functions = declarations.register(
      syntax.declarations,
      syntax.source.source(),
      ttable_new()
    )
    let body = literal(expr_from_node(node_f4(node_f1(node_f1(nlist_get(functions, 0))))))
    Test.assert_true(
      match body {
        BoolLit(_, start, length) -> __i64_to_usize(start) == prefix.len() and __i64_to_usize(
          length
        ) == sample.0.len()
        StringLit(_, _, start, length) -> __i64_to_usize(start) == prefix.len() and
          __i64_to_usize(length) == sample.0.len()
        _ -> false
      }
    )
  }
}

test "impl syntax retains plain method parameters" {
  assert_method_params("impl Box { fn cast(self, value: i64) -> i64 { value } }", 2)
}

test "impl syntax retains method parameters before associated bindings" {
  assert_method_params(
    "impl Box { fn cast(self, value: i64) -> i64 { value } type Item = i64 }",
    2
  )
}

test "impl syntax retains method generics without associated bindings" {
  assert_method_params(
    "impl<T: api.Show> Box<T> { fn cast<U: api.Match>(self, value: U) -> U { value } }",
    2
  )
}

test "impl syntax retains method generics before associated bindings" {
  assert_method_params(
    "impl<T: api.Show> Box<T> { fn cast<U: api.Match>(self, value: U) -> U { value } type Item = [i64; 3] }",
    2
  )
}
