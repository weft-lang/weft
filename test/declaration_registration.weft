}

test "named handler selection does not guess between colliding aliases" {
  let first = registered_module(
    "pub effect E { fn get() -> i64 } pub implements E() { E.get() -> resume(1) }",
    "fixture/handler_first",
    25
  )
  let second = registered_module(
