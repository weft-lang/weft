  )
  let imported = registered_module(
    "use fixture/explicit.{value}",
    "fixture/import_precedence",
    21
  )
  let local_scope = registration_scope.registration_scope_build(
    registered_modules2(prelude, local),
    registered_imports1(
      registration_scope.resolved_implicit_wildcard_import(local.identity, prelude.identity)
    )
  )
  Test.assert_true(
    match scope_declaration_module(local_scope, local.identity, ValueDeclaration, "value") {
      Some(identity) -> module_identity_eq(identity, local.identity)
      None -> false
    }
  )
  let import_scope = registration_scope.registration_scope_build(
    registered_modules3(prelude, explicit, imported),
    registered_imports1(
      registration_scope.resolved_implicit_wildcard_import(
        imported.identity,
        prelude.identity
      )
    ).concat(
      resolved_imports(imported, explicit, false)
    )
  )
  Test.assert_true(
    match scope_declaration_module(import_scope, imported.identity, ValueDeclaration, "value") {
      Some(identity) -> module_identity_eq(identity, explicit.identity)
      None -> false
    }
  )
}

test "typed scopes distinguish weak prelude methods from explicit facade authority" {
  let prelude = registered_module(
    "pub type PreludeValue { PreludeValue(i64) }",
    "stdlib/prelude_methods",
    22
  )
  let facade = registered_module(
    "pub use stdlib/prelude_methods.{PreludeValue}",
    "fixture/prelude_facade",
    22
  )
  let consumer = registered_module(
    "use fixture/prelude_facade as facade",
    "fixture/prelude_consumer",
    22
  )
  let declaration = match registration_scope_find_declaration(
    registration_scope.registration_scope_build(
      registered_modules1(prelude),
      Nil<ResolvedImport>()
    ),
    prelude.identity,
    TypeDeclaration,
    "PreludeValue"
  ) {
    Some(registered) -> registered.identity
    None -> panic("prelude type declaration was not retained")
  }
  let weak_scope = registration_scope.registration_scope_build(
    registered_modules2(prelude, consumer),
    registered_imports1(
      registration_scope.resolved_implicit_wildcard_import(
        consumer.identity,
        prelude.identity
      )
    )
  )
  Test.assert_true(
    registration_scope.registration_scope_declaration_is_weak_only(
      weak_scope,
      consumer.identity,
      declaration
    )
  )

  let mut facade_imports = resolved_imports(facade, prelude, false)
  facade_imports = facade_imports.concat(
    Nil<ResolvedImport>().prepend(
      registration_scope.resolved_implicit_wildcard_import(
        consumer.identity,
        prelude.identity
      )
    )
  )
  facade_imports = facade_imports.concat(resolved_imports(consumer, facade, false))
  let explicit_scope = registration_scope.registration_scope_build(
    registered_modules3(prelude, facade, consumer),
    facade_imports
  )
  Test.assert_true(
    not registration_scope.registration_scope_declaration_is_weak_only(
      explicit_scope,
      consumer.identity,
      declaration
    )
  )
}

test "typed scopes distinguish convergent reexports from real ambiguity" {
  let base = registered_module("pub fn work() -> i64 { 1 }", "fixture/base", 30)
  let left = registered_module(
    "pub use fixture/base.{work}",
    "fixture/left",
    30
  )
  let right = registered_module(
    "pub use fixture/base.{work}",
    "fixture/right",
    30
  )
  let diamond = registered_module(
    "use fixture/left.{*} use fixture/right.{*}",
    "fixture/diamond",
    30
  )
  let mut convergent_imports = resolved_imports(left, base, false)
  convergent_imports = convergent_imports.concat(resolved_imports(right, base, false))
  convergent_imports = convergent_imports.concat(resolved_imports(diamond, left, false))
  convergent_imports = convergent_imports.concat(resolved_imports(diamond, right, false))
  let convergent = registration_scope.registration_scope_build(
    registered_modules4(base, left, right, diamond),
    convergent_imports
  )
  Test.assert_true(
    match scope_declaration_module(convergent, diamond.identity, ValueDeclaration, "work") {
      Some(identity) -> module_identity_eq(identity, base.identity)
      None -> false
    }
  )

  let other = registered_module("pub fn work() -> i64 { 2 }", "fixture/other", 30)
  let collision = registered_module(
    "use fixture/base.{*} use fixture/other.{*}",
    "fixture/collision",
    30
  )
  let ambiguous = registration_scope.registration_scope_build(
    registered_modules3(base, other, collision),
    resolved_imports(collision, base, false).concat(
      resolved_imports(collision, other, false)
    )
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup(
      ambiguous,
      collision.identity,
      "work"
    ) {
      ScopeNameAmbiguous(first, Some(second)) -> match (
        candidate_declaration_module(first),
        candidate_declaration_module(second)
      ) {
        (Some(left_identity), Some(right_identity)) ->
          not module_identity_eq(left_identity, right_identity)
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match registration_scope.registration_scope_lookup_declaration(
      ambiguous,
      collision.identity,
      ValueDeclaration,
      "work"
    ) {
      None -> true
      Some(_) -> false
    }
  )
}

test "typed scopes retain missing and ambiguous import issues" {
  let left = registered_module("pub fn work() -> i64 { 1 }", "fixture/issue_left", 40)
  let right = registered_module("pub fn work() -> i64 { 2 }", "fixture/issue_right", 40)
  let facade = registered_module(
    "pub use fixture/issue_left.{*} pub use fixture/issue_right.{*}",
    "fixture/issue_facade",
    40
  )
  let consumer = registered_module(
    "use fixture/issue_facade.{work, absent}",
    "fixture/issue_consumer",
    40
  )
  let mut issue_imports = resolved_imports(facade, left, false)
  issue_imports = issue_imports.concat(resolved_imports(facade, right, false))
  issue_imports = issue_imports.concat(resolved_imports(consumer, facade, false))
  let scope = registration_scope.registration_scope_build(
    registered_modules4(left, right, facade, consumer),
    issue_imports
  )
  Test.assert_eq_usize(registration_scope.registration_scope_issue_count(scope), 2)
  let mut ambiguous = 0
  let mut missing = 0
  for index in 0..2 {
    match registration_scope.registration_scope_issue_at(scope, index).status {
      ScopeImportAmbiguous -> { ambiguous = ambiguous + 1 }
      ScopeImportMissing -> { missing = missing + 1 }
      _ -> nil
    }
  }
  Test.assert_eq(ambiguous, 1)
  Test.assert_eq(missing, 1)
}

fn raw_visibility(visibility: DeclVisibility) -> i64 {
  match visibility {
    PrivateVisibility -> 0
    PackageVisibility -> 1
    PublicVisibility -> 2
  }
}

fn raw_register_module(table: i64, module: RegisteredModule) -> i64 {
  match module.identity {
    NamedModuleIdentity(path, package_id) -> {
      ttable_register_source_in_package(
        table,
        __str_ptr(module.source.text),
        __str_len(module.source.text),
        __str_ptr(path),
        __str_len(path),
        package_id
      )
      declarations.register(module.syntax, module.source, table)
      module_fact_find_source(table, __str_ptr(module.source.text))
    }
    AnonymousModuleIdentity(_, _) -> panic("scope parity fixtures require named modules")
  }
}

fn import_declaration_at(module: RegisteredModule, index: usize) -> ImportDeclaration {
  module.syntax.imports.get(index).expect("scope parity import index")
}

fn raw_register_import(
  table: i64,
  importer: RegisteredModule,
  target: RegisteredModule,
  index: usize
) -> nil {
  let declaration = import_declaration_at(importer, index)
  let target_entry = match target.identity {
    NamedModuleIdentity(path, package_id) -> module_fact_find_path(
      table,
      __str_ptr(path),
      __str_len(path),
      package_id
    )
    AnonymousModuleIdentity(_, _) -> 0
  }
  parse_use_register_fact(
    table,
    __str_ptr(importer.source.text),
    target_entry,
    declaration.syntax,
    raw_visibility(declaration.visibility),
    __u64_to_i64(__usize_to_u64(declaration.module_start))
  )
  nil
}

fn raw_register_weak_wildcard(
  table: i64,
  importer: RegisteredModule,
  target: RegisteredModule
) -> nil {
  let target_entry = match target.identity {
    NamedModuleIdentity(path, package_id) -> module_fact_find_path(
      table,
      __str_ptr(path),
      __str_len(path),
      package_id
    )
    AnonymousModuleIdentity(_, _) -> 0
  }
  let selections = nlist_new()
  nlist_add(selections, node_new(0, 0, 0 - 1, 0, 0))
  module_import_fact_register(
    table,
    __str_ptr(importer.source.text),
    target_entry,
    selections,
    0,
    0,
    module_visibility_private(),
    1
  )
  nil
}

fn raw_scope_declaration_module(
  table: i64,
  module: RegisteredModule,
  namespace: DeclarationNamespace,
  spelling: str
) -> Option<ModuleIdentity> {
  let declaration = module_scope_lookup_declaration(
    table,
    __str_ptr(module.source.text),
    declaration_namespace_code(namespace),
    __str_ptr(spelling),
    0,
    __str_len(spelling)
  )
  if declaration == 0 { None<ModuleIdentity>() }
  else { Some(registered_identity_module(module_decl_fact_id(declaration))) }
}

fn assert_scope_lookup_parity(
  typed: RegistrationScope,
  raw: i64,
  module: RegisteredModule,
  namespace: DeclarationNamespace,
  spelling: str
) -[Test]> nil {
  match (
    scope_declaration_module(typed, module.identity, namespace, spelling),
    raw_scope_declaration_module(raw, module, namespace, spelling)
  ) {
    (Some(left), Some(right)) -> Test.assert_true(module_identity_eq(left, right))
    (None, None) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  nil
}

test "typed scope resolution agrees with the bounded raw oracle" {
  let base = registered_module(
    "pub fn work() -> i64 { 1 } pub(package) fn shared() -> i64 { 2 } fn hidden() -> i64 { 3 } pub type Same { Same }",
    "parity/base",
    47
  )
  let other = registered_module("pub fn work() -> i64 { 4 }", "parity/other", 47)
  let consumer = registered_module(
    "use parity/base as base use parity/base.{work as run, Same}",
    "parity/consumer",
    47
  )
  let facade = registered_module(
    "pub use parity/base.{work, shared}",
    "parity/facade",
    47
  )
  let collision = registered_module(
    "use parity/base.{*} use parity/other.{*}",
    "parity/collision",
    47
  )
  let missing = registered_module(
    "use parity/base.{absent}",
    "parity/missing",
    47
  )
  let local = registered_module("fn work() -> i64 { 5 }", "parity/local", 47)

  let mut typed_imports = resolved_imports(consumer, base, false)
  typed_imports = typed_imports.concat(resolved_imports(facade, base, false))
  typed_imports = typed_imports.concat(resolved_imports(collision, base, false))
  typed_imports = typed_imports.concat(resolved_imports(collision, other, false))
  typed_imports = typed_imports.concat(resolved_imports(missing, base, false))
  typed_imports = typed_imports.prepend(
    registration_scope.resolved_implicit_wildcard_import(local.identity, base.identity)
  )
  let all_modules = registered_modules4(base, other, consumer, facade).concat(
    registered_modules3(collision, missing, local)
  )
  let typed = registration_scope.registration_scope_build(
    all_modules,
    typed_imports
  )

  let raw = ttable_new()
  for module in all_modules {
    raw_register_module(raw, module)
  }
  raw_register_import(raw, consumer, base, 0)
  raw_register_import(raw, consumer, base, 1)
  raw_register_import(raw, facade, base, 0)
  raw_register_import(raw, collision, base, 0)
  raw_register_import(raw, collision, other, 1)
  raw_register_import(raw, missing, base, 0)
  raw_register_weak_wildcard(raw, local, base)
  module_scope_build_all(raw)

  for query in [
    (consumer, ValueDeclaration, "run"),
    (consumer, TypeDeclaration, "Same"),
    (consumer, ConstructorDeclaration, "Same"),
    (consumer, ValueDeclaration, "hidden"),
    (facade, ValueDeclaration, "work"),
    (facade, ValueDeclaration, "shared"),
    (local, ValueDeclaration, "work")
  ] {
    assert_scope_lookup_parity(typed, raw, query.0, query.1, query.2)
  }

  Test.assert_true(
    match registration_scope.registration_scope_lookup(typed, collision.identity, "work") {
      ScopeNameAmbiguous(_, _) -> true
      _ -> false
    }
  )
  Test.assert_eq(
    module_scope_entry_status(
      module_scope_lookup(
        raw,
        __str_ptr(collision.source.text),
        __str_ptr("work"),
        0,
        4
      )
    ),
    module_scope_status_ambiguous()
  )
  Test.assert_true(
    module_scope_find_issue(
      raw,
      module_fact_find_source(raw, __str_ptr(missing.source.text)),
      __str_ptr("absent"),
      6,
      module_scope_status_missing()
    ) != 0
  )
  let mut saw_missing = false
  let mut saw_widened = false
  for index in 0..__u64_to_i64(
    __usize_to_u64(registration_scope.registration_scope_issue_count(typed))
  ) {
    match registration_scope.registration_scope_issue_at(typed, index).status {
      ScopeImportMissing -> { saw_missing = true }
      ScopeImportWidenedReexport -> { saw_widened = true }
      _ -> nil
    }
  }
  Test.assert_true(saw_missing)
  Test.assert_true(saw_widened)
}

fn manifest_export(manifest: i64, kind: i64, name: str) -> i64 {
  pkg_manifest_find_export(manifest, kind, __str_ptr(name), __str_len(name))
}

test "frozen registration scopes retain package-qualified declaration catalogs" {
  let app = parse("pub type Value { value: i64 } pub fn run() -> i64 { 1 }")
  let dependency = parse("pub type Value { value: str }")
  let builder = registration_builder()
  registration_builder_add(
    builder,
    registration_catalog.register(
      app.declarations,
      app.source.source(),
      named_module_identity("grammar/value", 1)
    )
  )
  registration_builder_add(
    builder,
    registration_catalog.register(
      dependency.declarations,
      dependency.source.source(),
      named_module_identity("grammar/value", 2)
    )
  )
  let scope = registration_builder_freeze(builder)

  Test.assert_eq_usize(registration_scope_len(scope), 2)
  match registration_scope_find(scope, named_module_identity("grammar/value", 2)) {
    Some(module) -> Test.assert_eq_usize(registration_catalog.summary(module).functions, 0)
    None -> Test.assert_true(false)
  }
  match registration_scope_find_declaration(
    scope,
    named_module_identity("grammar/value", 1),
    TypeDeclaration,
    "Value"
  ) {
    Some(name) -> Test.assert_str_eq(registered_name_text(name), "Value")
    None -> Test.assert_true(false)
  }
  Test.assert_true(
    registration_scope_has_other_declaration(
      scope,
      named_module_identity("grammar/value", 1),
      TypeDeclaration,
      "run"
    )
  )
}

test "typed package export resolution reports every structural outcome" {
  let syntax = parse(
    "pub type Grammar { Grammar } pub fn public_tool() -> i64 { 1 } fn private_tool() -> i64 { 2 }"
  )
  let builder = registration_builder()
  let module = named_module_identity("grammar/exported", 9)
  registration_builder_add(
    builder,
    registration_catalog.register(syntax.declarations, syntax.source.source(), module)
  )
  let scope = registration_builder_freeze(builder)
  let manifest = pkg_manifest_parse_str(
    r#"{"package":"fixture","exports":{"grammars":{"grammar":{"module":"grammar/exported","declaration":"Grammar","execution":"validate_only"}},"tools":{"public":{"module":"grammar/exported","declaration":"public_tool"},"private":{"module":"grammar/exported","declaration":"private_tool"},"wrong":{"module":"grammar/exported","declaration":"Grammar"},"missing":{"module":"grammar/exported","declaration":"absent"},"pending":{"module":"grammar/unloaded","declaration":"run"}}}}"#
  )

  match package_export_resolve_loaded(
    scope,
    9,
    manifest_export(manifest, pkg_export_kind_grammar(), "grammar")
  ) {
    PackageExportResolved(identity) -> Test.assert_true(
      match declaration_identity_namespace(identity) { TypeDeclaration -> true, _ -> false }
    )
    _ -> Test.assert_true(false)
  }
  match package_export_resolve_loaded(
    scope,
    9,
    manifest_export(manifest, pkg_export_kind_tool(), "public")
  ) {
    PackageExportResolved(identity) -> Test.assert_str_eq(
      declaration_identity_name(identity).text().unwrap(),
      "public_tool"
    )
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "private")
    ) { PackageExportNotPublic -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "wrong")
    ) { PackageExportWrongKind -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "missing")
    ) { PackageExportMissingDeclaration -> true, _ -> false }
  )
  Test.assert_true(
    match package_export_resolve_loaded(
      scope,
      9,
      manifest_export(manifest, pkg_export_kind_tool(), "pending")
    ) { PackageExportPending -> true, _ -> false }
  )
}

test "combining frozen registration scopes preserves both module sets" {
  let left_syntax = parse("pub fn left() -> i64 { 1 }")
  let right_syntax = parse("pub fn right() -> i64 { 2 }")
  let left = registration_builder()
  let right = registration_builder()
  registration_builder_add(
    left,
    registration_catalog.register(
      left_syntax.declarations,
      left_syntax.source.source(),
      named_module_identity("left", 0)
    )
  )
  registration_builder_add(
    right,
    registration_catalog.register(
      right_syntax.declarations,
      right_syntax.source.source(),
      named_module_identity("right", 0)
    )
  )
  let combined = registration_scope_combined(
    registration_builder_freeze(left),
