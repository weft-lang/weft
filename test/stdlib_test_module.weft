-- The explicit import must diamond-dedupe with `weft test`'s injected import.
use stdlib/test.{*}

test "stdlib_test_module_is_the_runner_surface" {
  Test.assert_eq(20 + 22, 42)
  let largest: usize = 18446744073709551615
  Test.assert_eq_usize(0, 0)
  Test.assert_eq_usize(largest, largest)
  Test.assert_true(true)
  Test.assert_str_eq("weft", "weft")
}
