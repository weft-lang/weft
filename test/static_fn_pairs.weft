-- test/static_fn_pairs.weft -- named-fn values through static closure pairs
-- (static closure ownership). Named fns used as values share a lazily-initialised
-- static pair; these tests lock the semantics: correct dispatch, repeat
-- passes, multiple sites, distinct callees, mixing with lambdas, and
-- retain/release no-op safety across helper boundaries.

fn sfp_inc(x: i64) -> i64 { x + 1 }
fn sfp_double(x: i64) -> i64 { x * 2 }
fn sfp_neg(x: i64) -> i64 { 0 - x }

fn sfp_apply(f: (i64) -> i64, v: i64) -> i64 { f(v) }

fn sfp_apply_twice(f: (i64) -> i64, v: i64) -> i64 { f(f(v)) }

fn sfp_pass_through(f: (i64) -> i64, v: i64) -> i64 {
  sfp_apply(f, v)
}

test "static_fn_pair_basic_dispatch" {
  Test.assert_eq(sfp_apply(sfp_inc, 41), 42)
}

test "static_fn_pair_repeat_passes_same_site" {
  let mut acc = 0
  let mut i = 0
  while i < 1000 {
    acc = acc + sfp_apply(sfp_inc, i)
    i = i + 1
  }
  -- sum of (i + 1) for i in 0..999
  Test.assert_eq(acc, 500500)
}

test "static_fn_pair_two_sites_same_callee" {
  let a = sfp_apply(sfp_double, 10)
  let b = sfp_apply_twice(sfp_double, 10)
  Test.assert_eq(a, 20)
  Test.assert_eq(b, 40)
}

test "static_fn_pair_distinct_callees_distinct_behavior" {
  Test.assert_eq(sfp_apply(sfp_inc, 5), 6)
  Test.assert_eq(sfp_apply(sfp_double, 5), 10)
  Test.assert_eq(sfp_apply(sfp_neg, 5), 0 - 5)
}

test "static_fn_pair_let_bound_then_called" {
  let f = sfp_inc
  Test.assert_eq(f(7), 8)
  let g = sfp_double
  Test.assert_eq(g(7), 14)
  Test.assert_eq(f(9), 10)
}

test "static_fn_pair_through_helper_boundary" {
  Test.assert_eq(sfp_pass_through(sfp_neg, 3), 0 - 3)
}

test "static_fn_pair_mixed_with_lambda" {
  let lam = x => x + 100
  Test.assert_eq(sfp_apply(lam, 1), 101)
  Test.assert_eq(sfp_apply(sfp_inc, 1), 2)
  Test.assert_eq(sfp_apply(lam, 2), 102)
  Test.assert_eq(sfp_apply(sfp_inc, 2), 3)
}

test "static_fn_pair_inside_lambda_body" {
  let lam = x => sfp_apply(sfp_double, x)
  Test.assert_eq(lam(6), 12)
  Test.assert_eq(lam(7), 14)
}

test "static_fn_pair_interleaved_alternating_callees" {
  let mut acc = 0
  for i in 0..100 {
    if i - i / 2 * 2 == 0 {
      acc = acc + sfp_apply(sfp_inc, i)
    } else {
      acc = acc + sfp_apply(sfp_neg, i)
    }
  }
  -- evens contribute i+1 (sum 2500), odds contribute -i (sum -2500)
  Test.assert_eq(acc, 0)
}
