use stdlib/num as num
use stdlib/num.{*}
use stdlib/test.{*}

test "f64 bit bridge preserves ordinary and boundary values" {
  Test.assert_true(0.0.to_bits() == 0)
  Test.assert_true(1.0.to_bits() == 4607182418800017408)
  Test.assert_true(num.f64_from_bits(1).to_bits() == 1)
  Test.assert_true(num.f64_from_bits(9218868437227405311).to_bits() == 9218868437227405311)
}

test "f64 bit bridge preserves sign and NaN payloads" {
  Test.assert_true(num.f64_from_bits(9223372036854775808).to_bits() == 9223372036854775808)
  Test.assert_true(num.f64_from_bits(9218868437227405312).to_bits() == 9218868437227405312)
  Test.assert_true(num.f64_from_bits(9221120237041095221).to_bits() == 9221120237041095221)
}

test "f64 method surface returns the exact word" {
  let value: f64 = 1.5
  Test.assert_true(value.to_bits() == 4609434218613702656)
}

test "f32 bit bridge preserves ordinary and boundary values" {
  Test.assert_true(num.f32_from_bits(0).to_bits() == 0)
  Test.assert_true(num.f32_from_bits(1).to_bits() == 1)
  Test.assert_true(num.f32_from_bits(1065353216).to_bits() == 1065353216)
  Test.assert_true(num.f32_from_bits(2139095039).to_bits() == 2139095039)
}

test "f32 bit bridge preserves sign and NaN payloads" {
  Test.assert_true(num.f32_from_bits(2147483648).to_bits() == 2147483648)
  Test.assert_true(num.f32_from_bits(2139095040).to_bits() == 2139095040)
  Test.assert_true(num.f32_from_bits(2143289349).to_bits() == 2143289349)
}

test "f32 method surface returns the exact word" {
  let value: f32 = 1.5
  Test.assert_true(value.to_bits() == 1069547520)
}
