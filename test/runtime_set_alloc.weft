use "stdlib/list.weft"
use "stdlib/set.weft"
use "runtime/rc.weft"

test "runtime_persistent_set_managed_root_promotes_without_touching_trie" {
  let s: rc i64 = persistent_set_add(persistent_set_new(), 5)
  Test.assert_eq(persistent_set_size(s), 1)
  Test.assert_eq(persistent_set_contains(s, 5), 1)
  Test.assert_eq(persistent_set_contains(s, 6), 0)
  Test.assert_eq(rc_is_promoted(s), 0)
  rc_default_promote_maybe(s)
  Test.assert_eq(rc_is_promoted(s), 1)
  Test.assert_eq(persistent_set_contains(s, 5), 1)
}

test "runtime_persistent_set_versions_share_structure_but_not_roots" {
  let empty: rc i64 = persistent_set_new()
  let one: rc i64 = persistent_set_add(empty, 1)
  let two: rc i64 = persistent_set_add(one, 2)
  let duplicate: rc i64 = persistent_set_add(two, 1)
  Test.assert_eq(persistent_set_size(empty), 0)
  Test.assert_eq(persistent_set_size(one), 1)
  Test.assert_eq(persistent_set_size(two), 2)
  Test.assert_eq(persistent_set_size(duplicate), 2)
  Test.assert_eq(persistent_set_contains(empty, 1), 0)
  Test.assert_eq(persistent_set_contains(one, 1), 1)
  Test.assert_eq(persistent_set_contains(one, 2), 0)
  Test.assert_eq(persistent_set_contains(two, 1), 1)
  Test.assert_eq(persistent_set_contains(two, 2), 1)
  Test.assert_eq(persistent_set_contains(duplicate, 2), 1)
  Test.assert_eq(if persistent_set_root(one) != persistent_set_root(two) { 1 } else { 0 }, 1)
}

test "runtime_persistent_set_from_list_and_range_count" {
  let s: rc i64 = persistent_set_from_list(list_cons<i64>(2, list_cons<i64>(4, list_cons<i64>(2, list_nil<i64>()))))
  Test.assert_eq(persistent_set_size(s), 2)
  Test.assert_eq(persistent_set_count_in_range(s, 0, 5), 2)
  Test.assert_eq(persistent_set_contains(s, 2), 1)
  Test.assert_eq(persistent_set_contains(s, 3), 0)
  Test.assert_eq(persistent_set_contains(s, 4), 1)
}
