use stdlib/list.{*}
use stdlib/iter.{*}
use stdlib/set.{*}
use stdlib/string.{*}

test "runtime_persistent_set_managed_root_promotes_without_touching_trie" {
  let s: Set<i64> = persistent_set_add(persistent_set_new<i64>(), 5)
  Test.assert_eq(persistent_set_size(s), 1)
  Test.assert_true(persistent_set_contains(s, 5))
  Test.assert_false(persistent_set_contains(s, 6))
  Test.assert_eq(persistent_set_is_promoted(s), 0)
  persistent_set_promote(s)
  Test.assert_eq(persistent_set_is_promoted(s), 1)
  Test.assert_true(persistent_set_contains(s, 5))
}

test "runtime_persistent_set_versions_share_structure_but_not_roots" {
  let empty: Set<i64> = persistent_set_new<i64>()
  let one: Set<i64> = persistent_set_add(empty, 1)
  let two: Set<i64> = persistent_set_add(one, 2)
  let duplicate: Set<i64> = persistent_set_add(two, 1)
  Test.assert_eq(persistent_set_size(empty), 0)
  Test.assert_eq(persistent_set_size(one), 1)
  Test.assert_eq(persistent_set_size(two), 2)
  Test.assert_eq(persistent_set_size(duplicate), 2)
  Test.assert_false(persistent_set_contains(empty, 1))
  Test.assert_true(persistent_set_contains(one, 1))
  Test.assert_false(persistent_set_contains(one, 2))
  Test.assert_true(persistent_set_contains(two, 1))
  Test.assert_true(persistent_set_contains(two, 2))
  Test.assert_true(persistent_set_contains(duplicate, 2))
  Test.assert_eq(if persistent_set_root(one) != persistent_set_root(two) { 1 } else { 0 }, 1)
}

test "runtime_persistent_set_from_list_and_range_count" {
  let values = Cons<i64>(2, Cons<i64>(4, Cons<i64>(2, Nil<i64>())))
  let s = values.into_iter().collect<Set<i64>>()
  Test.assert_eq(persistent_set_size(s), 2)
  Test.assert_eq(persistent_set_count_in_range(s, 0, 5), 2)
  Test.assert_true(persistent_set_contains(s, 2))
  Test.assert_false(persistent_set_contains(s, 3))
  Test.assert_true(persistent_set_contains(s, 4))
}

test "runtime_persistent_set_supports_managed_elements" {
  let alpha = str_concat("alpha-", "κ")
  let beta = str_concat("beta-", "雪")
  let empty = persistent_set_new<str>()
  let one = persistent_set_add<str>(empty, alpha)
  let two = persistent_set_add<str>(one, beta)
  let duplicate = persistent_set_add<str>(two, str_concat("alpha-", "κ"))

  Test.assert_eq(persistent_set_size<str>(empty), 0)
  Test.assert_eq(persistent_set_size<str>(one), 1)
  Test.assert_eq(persistent_set_size<str>(two), 2)
  Test.assert_eq(persistent_set_size<str>(duplicate), 2)
  Test.assert_true(persistent_set_contains<str>(one, str_concat("alpha-", "κ")))
  Test.assert_false(persistent_set_contains<str>(one, str_concat("beta-", "雪")))
  Test.assert_true(persistent_set_contains<str>(duplicate, str_concat("beta-", "雪")))
}

test "runtime_persistent_set_builds_managed_elements_from_list" {
  let values = Cons<str>(str_concat("first-", "value"), Cons<str>(str_concat("second-", "value"), Cons<str>(str_concat("first-", "value"), Nil<str>())))
  let set = values.into_iter().collect<Set<str>>()
  Test.assert_eq(persistent_set_size<str>(set), 2)
  Test.assert_true(persistent_set_contains<str>(set, str_concat("first-", "value")))
  Test.assert_false(persistent_set_contains<str>(set, str_concat("missing-", "value")))
}
