use stdlib/state as state
use stdlib/state.{State}
use stdlib/drop.{Drop}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count}

fn classify(value: i64) -> i64 {
  if value < 0 { 1 } else if value == 0 { 2 } else if value < 10 { 3 } else { 4 }
}

test "conditional chains select every branch and final alternative" {
  for (value, expected) in [(-1, 1), (0, 2), (1, 3), (9, 3), (10, 4)] {
    Test.assert_eq(classify(value), expected)
  }
}

fn choose_mixed(first: Option<i64>, second: Option<i64>, flag: bool) -> i64 {
  if let Some(value) = first { value }
  else if flag { 20 }
  else if let Some(value) = second { value + 1 }
  else { 40 }
}

test "ordinary and pattern conditions share one alternative chain" {
  Test.assert_eq(choose_mixed(Some<i64>(10), Some<i64>(29), true), 10)
  Test.assert_eq(choose_mixed(None<i64>(), Some<i64>(29), true), 20)
  Test.assert_eq(choose_mixed(None<i64>(), Some<i64>(29), false), 30)
  Test.assert_eq(choose_mixed(None<i64>(), None<i64>(), false), 40)
}

fn record_condition(index: i64, selected: i64) -[State<i64>]> bool {
  State<i64>.put(State<i64>.get() * 10 + index)
  index == selected
}

fn record_option(index: i64, selected: i64) -[State<i64>]> Option<i64> {
  if record_condition(index, selected) { Some<i64>(index) } else { None<i64>() }
}

fn ordered_choice(selected: i64) -[State<i64>]> i64 {
  if record_condition(1, selected) { 10 }
  else if let Some(value) = record_option(2, selected) { value * 10 }
  else if record_condition(3, selected) { 30 }
  else { 40 }
}

test "conditions and scrutinees run once in order until the chosen branch" {
  for (selected, expected, trace) in [(1, 10, 1), (2, 20, 12), (3, 30, 123), (4, 40, 123)] {
    let (answer, observed) = state.run(0, () => ordered_choice(selected))
    Test.assert_eq(answer, expected)
    Test.assert_eq(observed, trace)
  }
}

fn statement_choice(selected: i64) -[State<i64>]> nil {
  if record_condition(1, selected) { 10 }
  else if let Some(value) = record_option(2, selected) { "discarded" }
  else if record_condition(3, selected) { (30, "discarded") }
}

test "a chain without final else discards every branch and yields nil" {
  for (selected, trace) in [(1, 1), (2, 12), (3, 123), (4, 123)] {
    let (answer, observed) = state.run(0, () => statement_choice(selected))
    let nil_value: nil = answer
    Test.assert_eq(observed, trace)
  }
}

fn joined_values(selected: i64) -> str | nil {
  if selected == 1 { "first" } else if selected == 2 { "second" } else { nil }
}

test "value chains retain their branch result sets" {
  match joined_values(1) { value: str -> Test.assert_str_eq(value, "first"), nil -> Test.assert_true(false) }
  match joined_values(2) { value: str -> Test.assert_str_eq(value, "second"), nil -> Test.assert_true(false) }
  match joined_values(3) { value: str -> Test.assert_true(false), nil -> Test.assert_true(true) }
}

fn explicit_else_block(selected: bool) -> str | nil {
  if selected { "retained" } else { if false { 99 } }
}

test "an explicit else block retains its own value boundary" {
  match explicit_else_block(true) { value: str -> Test.assert_str_eq(value, "retained"), nil -> Test.assert_true(false) }
  match explicit_else_block(false) { value: str -> Test.assert_true(false), nil -> Test.assert_true(true) }
}

test "pattern bindings are confined to the selected branch" {
  let value = 42
  let result = if let Some(value) = None<i64>() { value }
    else if value == 42 { value }
    else if let Some(value) = Some<i64>(7) { value }
    else { 0 }
  Test.assert_eq(result, 42)
  Test.assert_eq(value, 42)
}

fn nested_choice(outer: bool, inner: i64) -> i64 {
  if outer {
    if inner == 1 { 11 } else if inner == 2 { 12 } else { 13 }
  } else if inner == 1 { 21 } else { 22 }
}

test "nested chains associate alternatives with their own conditional" {
  for (outer, inner, expected) in [(true, 1, 11), (true, 2, 12), (true, 3, 13), (false, 1, 21), (false, 2, 22)] {
    Test.assert_eq(nested_choice(outer, inner), expected)
  }
}

fn chain_resource(selected: i64, log: i64) -> owned OwnedAbortToken {
  if selected == 1 { owned_abort_token_new(log, 1) }
  else if selected == 2 { owned_abort_token_new(log, 2) }
  else { owned_abort_token_new(log, 3) }
}

fn use_chain_resource(selected: i64, log: i64) -> nil {
  let token = chain_resource(selected, log)
  nil
}

test "only the selected owned result is constructed and dropped once" {
  for selected in [1, 2, 3] {
    let log = defer_order_log_new()
    use_chain_resource(selected, log)
    Test.assert_eq(defer_order_log_read(log), selected)
  }
}

fn discard_chain_resource(selected: i64, log: i64) -> nil {
  if selected == 1 { chain_resource(1, log) }
  else if selected == 2 { chain_resource(2, log) }
  else if selected == 3 { chain_resource(3, log) }
}

test "statement chains drop selected owned values and skip other branches" {
  for selected in [1, 2, 3, 4] {
    let log = defer_order_log_new()
    discard_chain_resource(selected, log)
    Test.assert_eq(defer_order_log_read(log), if selected == 4 { 0 } else { selected })
  }
}

fn select_managed(selected: i64, value: RuntimeRcProbe) -> RuntimeRcProbe {
  if selected == 1 { value } else if selected == 2 { value } else { value }
}

test "managed chain results preserve one escaping stake" {
  for selected in [1, 2, 3] {
    let value = runtime_rc_probe_new(42)
    let result = select_managed(selected, value)
    Test.assert_eq(runtime_rc_probe_load(result), 42)
    Test.assert_eq(runtime_rc_probe_count(value), 2)
  }
}

effect ChainRead { fn read() -> i64 }
effect ChainPause { @deferred fn pause() -> i64 }

fn immediate_chain(selected: i64, log: i64) -> i64 {
  handle {
    let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
    ChainRead.read() + 10
  } {
    ChainRead.read() -> {
      let local: owned OwnedAbortToken = owned_abort_token_new(log, 2)
      if selected == 1 { resume(1) } else if selected == 2 { 22 } else { resume(3) }
    }
  }
}

test "handler chains select one abort or resume and preserve drop order" {
  for (selected, expected) in [(1, 11), (2, 22), (3, 13)] {
    let log = defer_order_log_new()
    Test.assert_eq(immediate_chain(selected, log), expected)
    Test.assert_eq(defer_order_log_read(log), 21)
  }
}

fn deferred_chain(selected: i64, log: i64) -> i64 {
  handle {
    let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
    ChainPause.pause() + 10
  } {
    ChainPause.pause() with k ->
      if selected == 1 { k(1) } else if selected == 2 { 22 } else { k(3) }
  }
}

test "deferred chains resume once or drop the unselected continuation" {
  for (selected, expected) in [(1, 11), (2, 22), (3, 13)] {
    let log = defer_order_log_new()
    Test.assert_eq(deferred_chain(selected, log), expected)
    Test.assert_eq(defer_order_log_read(log), 1)
  }
}
