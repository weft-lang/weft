use "runtime/alloc.weft"
use "runtime/memory.weft"
use "compiler/codegen.weft"

fn sendable_test_named(name: str, args: i64) -> i64 {
  ty_named_app(str_hash(__str_ptr(name), 0, __str_len(name)), ty_i64(), args)
}

fn sendable_test_args1(arg: i64) -> i64 {
  let args = nlist_new()
  nlist_add(args, arg)
  args
}

fn sendable_test_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  mem_store64(fields + index * 24, ns)
  mem_store64(fields + index * 24 + 8, nl)
  mem_store64(fields + index * 24 + 16, ty)
  0
}

fn sendable_test_variant(src: i64, variants: i64, index: i64, ns: i64, nl: i64, payloads: i64) -> i64 {
  mem_store64(variants + index * 40, ns)
  mem_store64(variants + index * 40 + 8, nl)
  mem_store64(variants + index * 40 + 16, str_hash(src, ns, nl))
  mem_store64(variants + index * 40 + 24, if payloads == 0 { 0 } else { nlist_len(payloads) })
  mem_store64(variants + index * 40 + 32, payloads)
  0
}

test "sendable_fact_classifies_primitives_and_managed_strings" {
  let scalar = typeck_sendability_type(0, ty_i64())
  Test.assert_eq(typeck_sendability_fact_decision(scalar), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(scalar), 0)

  let text = typeck_sendability_type(0, ty_str())
  Test.assert_eq(typeck_sendability_fact_decision(text), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(text), typeck_sendability_needs_promotion())

  let top = typeck_sendability_type(0, ty_any())
  Test.assert_eq(typeck_sendability_fact_decision(top), typeck_sendability_decision_no())
  Test.assert_eq(typeck_sendability_fact_reason(top), typeck_sendability_reason_any())
  Test.assert_eq(ty_tag(typeck_sendability_fact_offender(top)), 1)
}

test "sendable_fact_requires_value_proof_for_pure_closures" {
  let pure = typeck_sendability_type(0, ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))
  Test.assert_eq(typeck_sendability_fact_decision(pure), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(pure), typeck_sendability_needs_capture_proof())

  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(77))
  let effectful = typeck_sendability_type(0, ty_fn(nlist_new(), ty_i64(), ty_effect_sig(effects)))
  Test.assert_eq(typeck_sendability_fact_decision(effectful), typeck_sendability_decision_no())
  Test.assert_eq(typeck_sendability_fact_reason(effectful), typeck_sendability_reason_effectful_function())
}

test "sendable_fact_pins_slice_array_and_move_only_policies" {
  let slice = typeck_sendability_type(0, ty_slice(ty_i64()))
  Test.assert_eq(typeck_sendability_fact_decision(slice), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(slice), typeck_sendability_needs_scoped_borrow())

  let text_slice = typeck_sendability_type(0, ty_slice(ty_str()))
  Test.assert_eq(typeck_sendability_fact_needs(text_slice), typeck_sendability_needs_promotion() bor typeck_sendability_needs_scoped_borrow())

  let mutable = typeck_sendability_type(0, ty_mut_slice(ty_i64()))
  Test.assert_eq(typeck_sendability_fact_decision(mutable), typeck_sendability_decision_no())
  Test.assert_eq(typeck_sendability_fact_reason(mutable), typeck_sendability_reason_mutable_slice())

  let array = typeck_sendability_type(0, ty_array(ty_i64(), 4))
  Test.assert_eq(typeck_sendability_fact_needs(array), typeck_sendability_needs_promotion())
  Test.assert_eq(typeck_sendability_fact_decision(typeck_sendability_type(0, ty_unique(ty_i64()))), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_reason(typeck_sendability_type(0, ty_owned(ty_i64()))), typeck_sendability_reason_owned_resource())
}

test "sendable_fact_reports_nested_structural_component_path" {
  let fields = nlist_new()
  nlist_add(fields, ty_record_field(101, ty_i64(), 0, 0))
  nlist_add(fields, ty_record_field(202, ty_mut_ptr(ty_i64()), 0, 0))
  let fact = typeck_sendability_type(0, ty_record(fields, 0))
  let path = typeck_sendability_fact_path(fact)
  Test.assert_eq(typeck_sendability_fact_decision(fact), typeck_sendability_decision_no())
  Test.assert_eq(typeck_sendability_fact_reason(fact), typeck_sendability_reason_raw_pointer())
  Test.assert_eq(typeck_sendability_path_kind(path), 1)
  Test.assert_eq(typeck_sendability_path_key(path), 202)
  Test.assert_eq(typeck_sendability_path_index(path), 1)
  Test.assert_eq(typeck_sendability_path_rest(path), 0)
}

test "sendable_fact_reports_tuple_position_and_generic_evidence" {
  let elems = nlist_new()
  nlist_add(elems, ty_i64())
  nlist_add(elems, ty_continuation(ty_i64(), ty_i64()))
  let tuple_fact = typeck_sendability_type(0, ty_tuple(elems))
  let path = typeck_sendability_fact_path(tuple_fact)
  Test.assert_eq(typeck_sendability_fact_reason(tuple_fact), typeck_sendability_reason_continuation())
  Test.assert_eq(typeck_sendability_path_kind(path), 2)
  Test.assert_eq(typeck_sendability_path_index(path), 1)

  let generic = typeck_sendability_type(0, ty_var(4))
  Test.assert_eq(typeck_sendability_fact_decision(generic), typeck_sendability_decision_unknown())
  Test.assert_eq(typeck_sendability_fact_reason(generic), typeck_sendability_reason_type_evidence())
}

test "sendable_fact_resolves_named_plain_and_managed_records" {
  let src = __str_ptr("PlainxyManagedname")
  let tt = ttable_new()
  let arena = arena_new(128)

  let plain_fields = arena_alloc(arena, 48, 8)
  sendable_test_field(plain_fields, 0, 5, 1, ty_i64())
  sendable_test_field(plain_fields, 1, 6, 1, ty_f64())
  ttable_add(tt, src, 0, 5, 0, 2, plain_fields, 0)
  let plain = ty_named(type_name_hash(src, 0, 5), ty_i64())
  let plain_fact = typeck_sendability_type(tt, plain)
  Test.assert_eq(typeck_sendability_fact_decision(plain_fact), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(plain_fact), typeck_sendability_needs_promotion() bor typeck_sendability_inline_scalar_record())
  Test.assert_eq(typeck_sendability_fact_scoped_slice_transport_ready(plain_fact), 1)

  let managed_fields = arena_alloc(arena, 24, 8)
  sendable_test_field(managed_fields, 0, 14, 4, ty_str())
  ttable_add(tt, src, 7, 7, 0, 1, managed_fields, 0)
  let managed = ty_named(type_name_hash(src, 7, 7), ty_i64())
  let managed_fact = typeck_sendability_type(tt, managed)
  Test.assert_eq(typeck_sendability_fact_decision(managed_fact), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(managed_fact), typeck_sendability_needs_promotion())
  Test.assert_eq(typeck_sendability_fact_scoped_slice_transport_ready(managed_fact), 0)
  arena_free(arena)
}

test "sendable_fact_uses_greatest_fixed_point_for_recursive_nominals" {
  let src = __str_ptr("ChainEndMore")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  let chain_hash = type_name_hash(src, 0, 5)
  let recursive_args = sendable_test_args1(ty_var(0))
  let recursive_ty = ty_named_app(chain_hash, ty_i64(), recursive_args)
  let end_payloads = nlist_new()
  let more_payloads = nlist_new()
  nlist_add(more_payloads, ty_var(0))
  nlist_add(more_payloads, recursive_ty)
  let variants = arena_alloc(arena, 80, 8)
  sendable_test_variant(src, variants, 0, 5, 3, end_payloads)
  sendable_test_variant(src, variants, 1, 8, 4, more_payloads)
  ttable_add(tt, src, 0, 5, 1, 2, variants, tparams)

  let scalar_chain = ty_named_app(chain_hash, ty_i64(), sendable_test_args1(ty_i64()))
  let scalar_fact = typeck_sendability_type(tt, scalar_chain)
  Test.assert_eq(typeck_sendability_fact_decision(scalar_fact), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(scalar_fact), typeck_sendability_needs_promotion())

  let pointer_chain = ty_named_app(chain_hash, ty_i64(), sendable_test_args1(ty_mut_ptr(ty_i64())))
  let pointer_fact = typeck_sendability_type(tt, pointer_chain)
  let path = typeck_sendability_fact_path(pointer_fact)
  Test.assert_eq(typeck_sendability_fact_decision(pointer_fact), typeck_sendability_decision_no())
  Test.assert_eq(typeck_sendability_fact_reason(pointer_fact), typeck_sendability_reason_raw_pointer())
  Test.assert_eq(typeck_sendability_path_kind(path), 3)
  Test.assert_eq(typeck_sendability_path_key(path), 1)
  Test.assert_eq(typeck_sendability_path_index(path), 0)
  arena_free(arena)
}

test "sendable_fact_classifies_sealed_collection_and_runtime_handles" {
  let persistent = typeck_sendability_type(0, sendable_test_named("Map", sendable_test_args1(ty_str())))
  Test.assert_eq(typeck_sendability_fact_decision(persistent), typeck_sendability_decision_yes())
  Test.assert_eq(typeck_sendability_fact_needs(persistent), typeck_sendability_needs_promotion())

  let bad_persistent = typeck_sendability_type(0, sendable_test_named("PersistentVector", sendable_test_args1(ty_mut_ptr(ty_i64()))))
  let path = typeck_sendability_fact_path(bad_persistent)
  Test.assert_eq(typeck_sendability_fact_reason(bad_persistent), typeck_sendability_reason_raw_pointer())
  Test.assert_eq(typeck_sendability_path_kind(path), 4)
  Test.assert_eq(typeck_sendability_path_index(path), 0)

  Test.assert_eq(typeck_sendability_fact_reason(typeck_sendability_type(0, sendable_test_named("Vector", sendable_test_args1(ty_i64())))), typeck_sendability_reason_mutable_state())
  Test.assert_eq(typeck_sendability_fact_reason(typeck_sendability_type(0, sendable_test_named("Iterator", sendable_test_args1(ty_i64())))), typeck_sendability_reason_runtime_token())
}

test "scoped_par_slice_transport_consumes_shared_sendable_fact" {
  let scalar_union = ty_union(ty_i64(), ty_bool())
  Test.assert_eq(slice_borrow_scoped_par_element_shareable(0, scalar_union), 1)
  Test.assert_eq(slice_borrow_scoped_par_element_shareable(0, ty_str()), 0)
  Test.assert_eq(slice_borrow_scoped_par_element_shareable(0, ty_mut_ptr(ty_i64())), 0)
}
