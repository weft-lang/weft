  Test.assert_true(
    match checked(
      "effect Box<T> { fn put(value: T) -> nil } "
    |> str_concat("fn bad() -[Box<i64>]> nil { Box.put(\"wrong\") }"),
      "fixture/checked_body_perform_type",
      149
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Box<T> { fn put(value: T) -> nil } "
    |> str_concat("fn bad() -[Box<i64>]> nil { Box.put() }"),
      "fixture/checked_body_perform_arity",
      150
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
}

