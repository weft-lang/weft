test "checked Vector slicing resolves its nominal owner by declaration" {
  Test.assert_true(
    match checked_with_vector(
      "use stdlib/vector/handles.{Vector} "
    |> str_concat("fn view<T>(values: Vector<T>) -> [T] { values[..] } ")
    |> str_concat("fn writable(values: Vector<i64>) -> [mut i64] { values[..] }"),
      "fixture/checked_body_vector_slice",
      950
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.indexed_slice_parts(product.function(0).body) {
          CheckedIndexedMutation(_, _, _, _) -> Test.assert_true(true)
        }
        match expressions.indexed_slice_parts(product.function(1).body) {
          CheckedIndexedMutation(_, _, _, _) -> Test.assert_true(true)
        }
        true
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Vector<T> { } fn bad(values: Vector<i64>) -> [i64] { values[..] }",
      "fixture/checked_body_vector_lookalike",
      955
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIndexedBaseRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_vector(
      "use stdlib/vector/handles.{Vector} "
    |> str_concat("fn identity(value: Vector<i64>) -> Vector<i64> { value } ")
    |> str_concat("fn bad(value: Vector<i64>) -> [i64] { identity(value)[..] }"),
      "fixture/checked_body_vector_temporary",
      951
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIndexedNamedBindingRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer binds function parameters to local references" {
  match checked(
    "fn identity(input: i64) -> i64 { input }",
    "fixture/checked_body_parameter",
    95
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let function = product.function(0)
      Test.assert_eq_usize(
        expressions.function_parameter_count(function.parameters),
        1
      )
      let parameter = expressions.function_parameter(function.parameters, 0)
      Test.assert_true(
        match expressions.kind(function.body) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        checked_binding_id_eq(expressions.local_binding(function.body), parameter)
      )
    }
    _ -> Test.assert_true(false)
  }
}

