      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, Continuation<i64, i64>>) -> i64 { "
    |> str_concat("let next = k(1) next(2) + next(3) }"),
      "fixture/checked_body_continuation_result_chain_twice",
      190
    ) {
