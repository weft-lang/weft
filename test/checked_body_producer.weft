  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn consume(k: Continuation<i64, i64>) -> i64 { k(3) } "
    )
    |> str_concat(
      "fn okay() -> i64 { handle read() { Pause.get() with k -> consume(k) } }"
    ),
      "fixture/checked_body_explicit_continuation_consumer",
      176
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
