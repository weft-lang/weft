}

test "checked body producer publishes sealed intrinsic identities" {
  match checked_trusted(
    "fn address(value: str) -> i64 { __str_ptr(value) }",
    "runtime/fixture_intrinsic_identity",
    1141
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (function, arguments) = expressions.direct_call_parts(root)
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      match function {
        IntrinsicFunctionIdentity(module, identity) -> {
          Test.assert_true(module_identity_eq(module, function_identity_module(function)))
          Test.assert_eq_usize(intrinsic_identity_code(identity), 1)
          Test.assert_eq(intrinsic_identity_native_key(identity), 249878008334981745)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes trusted ownership reclassification" {
  match checked_trusted(
    "fn own(value: i64) -> rc i64 { __rc_from_word(value) }",
    "runtime/fixture_intrinsic_rc_from_word",
    1151
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (function, arguments) = expressions.direct_call_parts(root)
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match function {
          IntrinsicFunctionIdentity(_, identity) -> intrinsic_identity_code(identity) == 27
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn steal(value: i64) -> any { __rc_from_word(value) }",
      "fixture/intrinsic_rc_from_word_sealed",
      1152
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsafeIntrinsicSealed(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer enforces intrinsic contracts and source trust" {
  Test.assert_true(
    match checked_trusted(
      "fn length(value: i64) -> i64 { __str_len(value) }",
      "runtime/fixture_intrinsic_any",
      1140
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn cast(value: i64) -> u8 { __i64_to_u8(value) }",
      "stdlib/fixture_intrinsic_cast",
      1142
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn bad(value: str) -> u8 { __i64_to_u8(value) }",
      "stdlib/fixture_intrinsic_type",
      1143
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn bad() -> i64 { __mem_store64(0) }",
      "runtime/fixture_intrinsic_arity",
      1144
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(2, 1)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn sealed(value: str) -> i64 { __str_ptr(value) }",
      "fixture/intrinsic_sealed",
      1145
    ) {
      CheckedBodiesRejected(CheckedBodyProducerStringAddressSealed(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn unknown() -> i64 { __not_an_intrinsic() }",
      "runtime/fixture_intrinsic_unknown",
      1146
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownIdentifier(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn word(k: Continuation<i64, i64>) -> i64 { __transmute(k) }",
      "runtime/fixture_intrinsic_continuation_word",
      1147
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked string address intrinsics follow the raw boundary's transitional list" {
  -- Both members of the pair are sealed in strict code the list omits.
  Test.assert_true(
    match checked(
      "fn sealed(value: str) -> i64 { __str_len(value) }",
      "fixture/intrinsic_length_sealed",
      1912
    ) {
      CheckedBodiesRejected(CheckedBodyProducerStringAddressSealed(_)) -> true
      _ -> false
    }
  )
  -- A strict file the list still names keeps them while it migrates.
  Test.assert_true(
    match checked(
      "fn listed(value: str) -> i64 { __str_ptr(value) + __str_len(value) }",
      "compiler/backend/link",
      1913
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  -- The list admits only the string pair: raw memory stays sealed there.
  Test.assert_true(
    match checked(
      "fn raw(address: i64) -> i64 { __mem_load64(address) }",
      "compiler/backend/link",
      1914
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsafeIntrinsicSealed(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn raw(address: i64) -> i64 { __mem_load64(address) }",
      "fixture/intrinsic_memory_sealed",
      1915
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsafeIntrinsicSealed(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn trusted(value: str) -> i64 { __str_ptr(value) }",
      "runtime/fixture_intrinsic_string_address",
      1916
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer borrows owned opaque representations" {
  Test.assert_true(
    match checked_with_vector(
      "use stdlib/vector/handles.{Vector} "
        |> str_concat("type Builder = opaque owned Vector<u8> ")
        |> str_concat("fn consume<T>(value: borrow Vector<T>) -> nil { nil } ")
        |> str_concat("fn append(self: borrow mut Builder) -> nil { ")
        |> str_concat("match self { Builder(values) -> consume<u8>(values) } }"),
      "stdlib/fixture_owned_opaque_borrow",
      1153
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

fn unsafe_outcome(text: str, name: str, discriminator: i64, trusted: bool) -[Test]> str {
  match checked_with_unsafe(
    str_concat("use runtime/unsafe.{Unsafe} ", text),
    name,
    discriminator,
    trusted
  ) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    _ -> "other"
  }
}

-- Clauses execute outside the handler they implement. Trusted source still
-- needs an honest effect row or an enclosing handler for their raw work.
test "checked trusted Unsafe handler clauses require outer authority" {
  let raw = "fn raw_work(x: i64) -[Unsafe]> i64 { Unsafe.raw() + x } "
    |> str_concat("fn discharge() -[Unsafe]> i64 { Unsafe.raw() } ")
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "fn safe(x: i64) -> i64 { handle discharge() { Unsafe.raw() -> resume(raw_work(x)) } }"
      ),
      "runtime/fixture_discharge_call",
      2320,
      true
    ),
    "effect_unavailable"
  )
  -- A directly performed operation needs the same outer authority.
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "fn safe(x: any) -> i64 { handle discharge() { Unsafe.raw() -> { let _ = Unsafe.transmute(x) resume(1) } } }"
      ),
      "runtime/fixture_discharge_operation",
      2321,
      true
    ),
    "effect_unavailable"
  )
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "fn honest(x: i64) -[Unsafe]> i64 { handle discharge() { Unsafe.raw() -> resume(raw_work(x)) } }"
      ),
      "runtime/fixture_clause_authority_row",
      2327,
      true
    ),
    "accepted"
  )
  -- The handled body and the code after it stay as pure as the signature.
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "fn leak(x: i64) -> i64 { handle discharge() { Unsafe.raw() -> resume(1) } + raw_work(x) }"
      ),
      "runtime/fixture_discharge_outside",
      2322,
      true
    ),
    "effect_unavailable"
  )
  -- An operation a clause performs is still handled by whatever encloses it:
  -- inside a handler covering only `raw`, `transmute` has no clause.
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "fn nested(x: any) -> i64 { handle (handle discharge() { Unsafe.raw() -> { let _ = Unsafe.transmute(x) resume(1) } }) { Unsafe.raw() -> resume(2) } }"
      ),
      "runtime/fixture_discharge_nested",
      2325,
      true
    ),
    "missing_handler_clause"
  )
  -- A clause of a handler for another effect gains nothing, not even the
  -- effect it handles.
  Test.assert_str_eq(
    unsafe_outcome(
      "effect Tick { fn tick() -> i64 } fn ticking() -[Tick]> i64 { Tick.tick() } "
        |> str_concat(
          "fn again() -> i64 { handle ticking() { Tick.tick() -> resume(Tick.tick()) } }"
        ),
      "runtime/fixture_discharge_own_effect",
      2326,
      true
    ),
    "effect_unavailable"
  )
  -- A handler for another effect discharges nothing.
  Test.assert_str_eq(
    unsafe_outcome(
      str_concat(
        raw,
        "effect Tick { fn tick() -> i64 } fn ticking() -[Tick]> i64 { Tick.tick() } "
      )
        |> str_concat(
          "fn leak(x: i64) -> i64 { handle ticking() { Tick.tick() -> resume(raw_work(x)) } }"
        ),
      "runtime/fixture_discharge_other",
      2323,
      true
    ),
    "effect_unavailable"
  )
  -- Strict code cannot use the discharge.
  Test.assert_true(
    unsafe_outcome(
      str_concat(
        raw,
        "fn safe(x: i64) -> i64 { handle discharge() { Unsafe.raw() -> resume(raw_work(x)) } }"
      ),
      "fixture/discharge_strict",
      2324,
      false
    ) != "accepted"
  )
}

test "checked body producer contextualizes trusted Unsafe cast results" {
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} fn cast(value: any) -[Unsafe]> *i64 { Unsafe.transmute(value) }",
      "runtime/fixture_contextual_unsafe",
      1148,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
        |> str_concat(
          "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
        )
        |> str_concat(
          "fn cast(value: i64) -> rc i64 { handle unsafe_transmute<i64, rc i64>(value) { "
        )
        |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_rc_handle",
      1149,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
        |> str_concat(
          "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
        )
        |> str_concat("fn cast(k: Continuation<i64, i64>) -> i64 { ")
        |> str_concat(
          "handle unsafe_transmute<Continuation<i64, i64>, i64>(k) { "
        )
        |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_continuation_handle",
      1150,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
        |> str_concat(
          "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
        )
        |> str_concat(
          "fn cast(value: i64) -> str { handle unsafe_transmute<i64, str>(value) { "
        )
        |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_str_handle",
      1151,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer publishes nested call arguments after their children" {
  match checked(
    "fn pair(left: i64, right: i64) -> i64 { left * 10 + right } "
      |> str_concat("fn caller() -> i64 { pair(pair(1, 2), pair(3, 4)) }"),
    "fixture/checked_body_nested_calls",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, outer) = expressions.direct_call_parts(product.function(1).body)
      Test.assert_eq_usize(expressions.expression_list_len(outer), 2)
      let left = expressions.expression_list_at(outer, 0)
      let right = expressions.expression_list_at(outer, 1)
      Test.assert_true(match expressions.kind(left) { CheckedDirectCallKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(right) { CheckedDirectCallKind -> true, _ -> false }
      )
      let (_, left_arguments) = expressions.direct_call_parts(left)
      let (_, right_arguments) = expressions.direct_call_parts(right)
      Test.assert_eq_usize(expressions.expression_list_len(left_arguments), 2)
      Test.assert_eq_usize(expressions.expression_list_len(right_arguments), 2)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes specialized trait method calls" {
  match checked(
    "trait Same { fn same(self, other: Self) -> bool } "
      |> str_concat("type Box<T> { value: T } ")
      |> str_concat(
        "impl<T> Same for Box<T> { fn same(self, other: Self) -> bool { true } } "
      )
      |> str_concat(
        "fn compare(left: Box<i64>, right: Box<i64>) -> bool { left.same(right) }"
      ),
    "fixture/checked_body_trait_method",
    172
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments, _) = expressions.method_call_parts(root)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "trait Source { type Item fn get(self) -> Self.Item } "
      |> str_concat("type Box { value: i64 } ")
      |> str_concat("impl Source for Box { type Item = i64 ")
      |> str_concat("fn get(self) -> Self.Item { self.value } } ")
      |> str_concat("fn read(box: Box) -> i64 { box.get() }"),
    "fixture/checked_body_associated_method",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      let (declaration, _, arguments, _) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "get"
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "type Box<T> { value: T } impl<T> Box<T> { "
      |> str_concat("fn keep(self) -> Self { self } ")
      |> str_concat("fn value(self) -> T { self.value } ")
      |> str_concat("fn retained(self) -> T { self.keep().value() } }"),
    "fixture/checked_body_inherent_self",
    182
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (declaration, receiver, arguments, _) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "value"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer resolves methods through generic signature bounds" {
  match checked(
    "trait Show { type Label fn show(self) -> str } "
      |> str_concat(
        "fn render<T: Show & { type Label = str }>(value: T) -> str { value.show() }"
      ),
    "fixture/checked_body_bound_method",
    173
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (declaration, receiver, arguments, _) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "show"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes associated calls without a value receiver" {
  match checked(
    "trait Build { type Output fn make(value: i64) -> Self.Output } "
      |> str_concat("type Marker = opaque i64 ")
      |> str_concat("impl Build for Marker { type Output = i64 ")
      |> str_concat("fn make(value: i64) -> Self.Output { value } } ")
      |> str_concat(
        "fn generic<C: Build & { type Output = i64 }>(value: i64) -> i64 { C.make(value) } "
      )
      |> str_concat("fn concrete(value: i64) -> i64 { Marker.make(value) }"),
    "fixture/checked_body_associated_call",
    1255
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let generic = product.function(1).body
      let concrete = product.function(2).body
      Test.assert_true(
        match expressions.kind(generic) {
          CheckedAssociatedCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(concrete) {
          CheckedAssociatedCallKind -> true
          _ -> false
        }
      )
      let (declaration, _, arguments, signature) = expressions.associated_call_parts(generic)
      Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), "make")
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      let catalog = expressions.types()
      Test.assert_true(
        match catalog.graph_for(signature) {
          None -> false
          Some(graph) -> match semantic_type_graph_node(graph, signature) {
            SemanticFunctionNode(_, result, _) -> semantic_type_catalog_equal(
              catalog,
              expressions.result_type(generic),
              result
            )
            _ -> false
          }
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer specializes associated results through generic calls" {
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output fn make(value: i64) -> Self.Output } "
        |> str_concat("type Marker { Marker(i64) } ")
        |> str_concat("impl Build for Marker { type Output = Marker ")
        |> str_concat("fn make(value: i64) -> Self.Output { Marker(value) } } ")
        |> str_concat("fn build_as<C: Build>(value: i64) -> C.Output { C.make(value) } ")
        |> str_concat("fn concrete(value: i64) -> Marker { build_as<Marker>(value) }"),
      "fixture/checked_body_associated_result_specialization",
      1256,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      _ -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } "
        |> str_concat(
          "fn map<T: Build, R>(value: T, output: T.Output, f: (T.Output) -> R) -> R { "
        )
        |> str_concat("f(output) } ")
        |> str_concat(
          "fn identity<U, T: Build & { type Output = U }>(value: T, output: U) -> U { "
        )
        |> str_concat("map<T, U>(value, output, inner => inner) }"),
      "fixture/checked_body_forwarded_associated_lambda",
      1263,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
}

fn associated_parameter_outcome(calls: str, discriminator: i64, conforms: bool) -[Test]> str {
  match checked_with_conformance(
    "trait Read { type Syntax fn first(self, syntax: Self.Syntax) -> i64 } "
      |> str_concat("type Reader { Reader } type Holder { Holder } ")
      |> str_concat("impl Read for Reader { type Syntax = i64 ")
      |> str_concat("fn first(self, syntax: i64) -> i64 { syntax } } ")
      |> str_concat("fn through<G: Read>(grammar: G, syntax: G.Syntax) -> i64 { ")
      |> str_concat("grammar.first(syntax) } ")
      |> str_concat("fn before<G: Read>(syntax: G.Syntax, grammar: G) -> i64 { ")
      |> str_concat("grammar.first(syntax) } ")
      |> str_concat("fn both<G: Read>(grammar: G, pair: (G.Syntax, G.Syntax)) -> i64 { 0 } ")
      |> str_concat("type Wrap<T> { Wrap(T) } ")
      |> str_concat("fn wrapped<G: Read>(grammar: G, item: Wrap<G.Syntax>) -> i64 { 0 } ")
      |> str_concat("fn beside<G: Read, T>(grammar: G, pair: (G.Syntax, T)) -> T { pair.1 } ")
      |> str_concat("fn apply<G: Read>(grammar: G, f: (G.Syntax) -> i64, syntax: G.Syntax) ")
      |> str_concat("-> i64 { f(syntax) } ")
      |> str_concat(
        "impl Holder { fn held<G: Read>(self, grammar: G, syntax: G.Syntax) -> i64 { "
      )
      |> str_concat("grammar.first(syntax) } } ")
      |> str_concat(calls),
    "fixture/checked_body_associated_parameter",
    discriminator,
    conforms
  ) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
    CheckedBodiesRejected(_) -> "other"
  }
}

test "an inferred call checks an associated parameter once its bound has chosen the type" {
  -- `G.Syntax` is `i64` only through `Reader`'s implementation, which the
  -- bound selects after every argument has been read.
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { through(grammar, syntax) }",
      2316,
      true
    ),
    "accepted"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { before(syntax, grammar) }",
      2317,
      true
    ),
    "accepted"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { both(grammar, (syntax, syntax)) }",
      2318,
      true
    ),
    "accepted"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(holder: Holder, grammar: Reader, syntax: i64) -> i64 { "
        |> str_concat("holder.held(grammar, syntax) }"),
      2319,
      true
    ),
    "accepted"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { wrapped(grammar, Wrap<i64>(syntax)) }",
      2325,
      true
    ),
    "accepted"
  )
  -- A type argument decided by an earlier argument has its associated types
  -- chosen at once, so they infer what stands beside them and type a lambda.
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> Holder { beside(grammar, (syntax, Holder)) }",
      2326,
      true
    ),
    "accepted"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { "
        |> str_concat("apply(grammar, value => value + 1, syntax) }"),
      2327,
      true
    ),
    "accepted"
  )
  -- The chosen type still decides the argument.
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader) -> i64 { wrapped(grammar, Wrap<Reader>(grammar)) }",
      2328,
      true
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { beside(grammar, (grammar, syntax)) }",
      2329,
      true
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { "
        |> str_concat("apply(grammar, value => grammar, syntax) }"),
      2330,
      true
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader) -> i64 { through(grammar, grammar) }",
      2320,
      true
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(grammar: Reader, syntax: i64) -> i64 { both(grammar, (syntax, grammar)) }",
      2321,
      true
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(holder: Holder, grammar: Reader) -> i64 { holder.held(grammar, grammar) }",
      2322,
      true
    ),
    "type mismatch"
  )
  -- A type without the implementation fails its bound, not the argument.
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn call(holder: Holder, syntax: i64) -> i64 { through(holder, syntax) }",
      2323,
      false
    ),
    "generic bound"
  )
  -- A parameter that names no associated type is still decided where it is
  -- read: the mismatch is reported, not the type argument it left undecided.
  Test.assert_str_eq(
    associated_parameter_outcome(
      "fn pick<T, U>(left: T, right: (U, U)) -> T { left } "
        |> str_concat("fn call(grammar: Reader) -> Reader { pick(grammar, grammar) }"),
      2324,
      true
    ),
    "type mismatch"
  )
}

-- The conformance oracle here refuses everything, so only the module's own
-- evidence, with the checking function's bounds assumed, can accept a call.
fn carried_bound_outcome(calls: str, discriminator: i64) -[Test]> str {
  match checked(
    "trait Deep { fn deep(self, n: i64) -> i64 } trait Shallow { } "
      |> str_concat("type Box<T> { value: T } ")
      |> str_concat("impl Deep for i64 { fn deep(self, n: i64) -> i64 { self + n } } ")
      |> str_concat("impl<T: Deep> Deep for Box<T> { ")
      |> str_concat("fn deep(self, n: i64) -> i64 { self.value.deep(n + 1) } } ")
      |> str_concat("fn measure<U: Deep>(value: U) -> i64 { value.deep(0) } ")
      |> str_concat("trait Open { type Inner fn open(self) -> Self.Inner } ")
      |> str_concat("impl<T: Deep> Open for Box<T> { type Inner = T ")
      |> str_concat("fn open(self) -> T { self.value } } ")
      |> str_concat("fn opened<O: Open>(value: O) -> O.Inner { value.open() } ")
      |> str_concat(calls),
    "fixture/checked_body_carried_bound",
    discriminator
  ) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
    CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> "unknown method"
    CheckedBodiesRejected(_) -> "other"
  }
}

test "a type parameter's bound satisfies an implementation's requirement" {
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Deep>(value: T) -> i64 { measure(Box<T> { value: value }) }",
      2331
    ),
    "accepted"
  )
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Deep>(value: T) -> i64 { measure<Box<T>>(Box<T> { value: value }) }",
      2332
    ),
    "accepted"
  )
  -- The requirement of `Box<Box<T>>` is `Box<T>: Deep`, whose own requirement
  -- is the assumed `T: Deep`.
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Deep>(value: T) -> i64 { "
        |> str_concat("measure(Box<Box<T>> { value: Box<T> { value: value } }) }"),
      2333
    ),
    "accepted"
  )
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Deep>(value: T) -> i64 { "
        |> str_concat("let held = Box<Box<T>> { value: Box<T> { value: value } }; held.deep(0) }"),
      2334
    ),
    "accepted"
  )
  -- The implementation the assumption selects also chooses the call's
  -- associated types: `Box<T>.Inner` is `T`.
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn unboxed<T: Deep>(value: T) -> T { opened(Box<T> { value: value }) }",
      2339
    ),
    "accepted"
  )
  -- Without the bound, or with another one, nothing satisfies the requirement.
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T>(value: T) -> i64 { measure(Box<T> { value: value }) }",
      2335
    ),
    "generic bound"
  )
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Shallow>(value: T) -> i64 { measure(Box<T> { value: value }) }",
      2336
    ),
    "generic bound"
  )
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Shallow>(value: T) -> i64 { "
        |> str_concat("let held = Box<Box<T>> { value: Box<T> { value: value } }; held.deep(0) }"),
      2337
    ),
    "unknown method"
  )
  -- An assumption covers its own variable only, not another parameter.
  Test.assert_str_eq(
    carried_bound_outcome(
      "fn boxed<T: Deep, V>(value: T, other: V) -> i64 { "
        |> str_concat("measure(Box<V> { value: other }) }"),
      2338
    ),
    "generic bound"
  )
}

test "checked body producer forwards lexical generic bounds" {
  Test.assert_true(
    match checked(
      "trait Marker { } fn first<T: Marker>(value: T) -> T { value } "
        |> str_concat("fn second<T: Marker>(value: T) -> T { first<T>(value) }"),
      "fixture/checked_body_forwarded_bound",
      1257
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer forwards lexical associated bindings" {
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } fn identity<T>(value: T) -> T { value } "
        |> str_concat(
          "fn select<L: Build, R: Build & { type Output = L.Output }>(right: R.Output) "
        )
        |> str_concat("-> L.Output { identity<R.Output>(right) }"),
      "fixture/checked_body_owner_associated_annotation",
      1267,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } "
        |> str_concat(
          "fn select<L: Build, R: Build & { type Output = L.Output }>("
        )
        |> str_concat("left: L.Output, right: R.Output) -> L.Output { right }"),
      "fixture/checked_body_owner_associated_bound",
      1266,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } "
        |> str_concat(
          "fn first<T: Build>(value: T, output: T.Output) -> T.Output { output }"
        ),
      "fixture/checked_body_associated_identity",
      1262,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } "
        |> str_concat(
          "fn first<T: Build>(value: T, output: T.Output) -> T.Output { output } "
        )
        |> str_concat(
          "fn second<U, T: Build & { type Output = U }>(value: T, output: U) -> U { "
        )
        |> str_concat("first<T>(value, output) }"),
      "fixture/checked_body_forwarded_associated_bound",
      1261,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_drop_conformance(
      "trait Build { type Output } type Box<T> = opaque i64 impl<T> Drop for Box<T> { } "
        |> str_concat(
          "fn first<S: Build, R: Build>(value: S) -> owned Box<R.Output> { "
        )
        |> str_concat("Box<R.Output>(0) } ")
        |> str_concat(
          "fn second<U: Build, T: Build & { type Output = U }>(value: T) "
        )
        |> str_concat("-> owned Box<U.Output> { first<T, U>(value) }"),
      "fixture/checked_body_forwarded_nested_associated",
      1264,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_drop_conformance(
      "trait Build { type Output } type Box<T> = opaque i64 impl<T> Drop for Box<T> { } "
        |> str_concat(
          "fn first<S: Build, R: Build>(value: S) -> owned Box<R.Output> { "
        )
        |> str_concat("Box<R.Output>(0) }"),
      "fixture/checked_body_nested_associated_identity",
      1265,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
      CheckedBodiesRejected(_) -> "other"
    },
    "accepted"
  )
}

