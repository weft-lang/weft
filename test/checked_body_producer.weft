    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      match expressions.record_init_parts(root) {
        (CheckedDeclaredRecordConstruction(_), fields) -> {
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(match first.kind { CheckedDeclaredRecordField -> true, _ -> false })
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(1) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

