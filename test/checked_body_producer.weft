    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Box { value: i64 } ")
    |> str_concat(
      "impl Box { fn consume(self, k: Continuation<i64, i64>) -> i64 { k(4) } } "
    )
    |> str_concat(
      "fn okay(box: Box) -> i64 { handle read() { Pause.get() with k -> box.consume(k) } }"
