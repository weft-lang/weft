  Test.assert_true(
    match checked(
      "fn bad(row: { target: str, .. }) -> i64 { row.target }",
      "fixture/checked_body_open_field_context",
      1391
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

