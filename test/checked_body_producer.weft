-- Authored bodies enter the immutable checked representation through one
-- semantic producer, with unsupported syntax rejected instead of retained.

use compiler/project/identity.{ModuleIdentity, named_module_identity}
use compiler/project/identity/equality.{function_identity_eq}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI8,
  SemanticPrimitiveNode,
  semantic_type_graph_node
}
use compiler/weft/check/body/graph.{
  CheckedAssignKind,
  CheckedApplyKind,
  CheckedBlockKind,
  CheckedBooleanKind,
  CheckedBreakKind,
  CheckedBreakNoValueKind,
  CheckedContinueKind,
  CheckedDeferKind,
  CheckedDirectCallKind,
  CheckedExprKind,
  CheckedIfKind,
  CheckedIntegerKind,
  CheckedLetKind,
  CheckedLetMutKind,
  CheckedLocalReferenceKind,
  CheckedLoopKind,
  CheckedNegateKind,
  CheckedNilKind,
  CheckedNotKind,
  CheckedReturnKind,
  CheckedWhileKind,
  checked_binding_id_eq
}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/weft/check/body/producer.{*}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/registration/scope.{RegistrationScope}
use compiler/weft/check/signatures.{
  SemanticSignaturesResolved,
  resolve_module_signatures
}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn control_kind_code(kind: CheckedExprKind) -> i64 {
  match kind {
    CheckedLoopKind -> 1
    CheckedIfKind -> 2
    CheckedBreakKind -> 3
    CheckedBreakNoValueKind -> 4
    CheckedContinueKind -> 5
    _ -> 0
  }
}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

fn scope_for(module: RegisteredModule) -> RegistrationScope {
  let builder = registration_scope.registration_builder()
  registration_scope.registration_builder_add(builder, module)
  registration_scope.registration_builder_freeze(builder)
}

fn checked(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  let module = registered(text, named_module_identity(name, discriminator))
  let scope = scope_for(module)
  match resolve_module_signatures(module, scope) {
    SemanticSignaturesResolved(signatures) -> handle check_registered_bodies(
      module,
      scope,
      signatures
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved signatures")
  }
}

test "checked body producer publishes literal functions in declaration order" {
  match checked(
    "fn integer() -> i64 { 7 } fn flag() -> bool { true } fn empty() -> nil { nil }",
    "fixture/checked_body_literals",
    91
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let integer = product.function(0).body
      let boolean = product.function(1).body
      let nil_value = product.function(2).body
      Test.assert_true(
        match expressions.kind(integer) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
      Test.assert_eq(expressions.integer_value(integer), 7)
      Test.assert_true(
        match expressions.kind(boolean) {
          CheckedBooleanKind -> true
          _ -> false
        }
      )
      Test.assert_true(expressions.boolean_value(boolean))
      Test.assert_true(
        match expressions.kind(nil_value) {
          CheckedNilKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked integer literals retain their contextual primitive type" {
  match checked(
    "fn small() -> i8 { 7 }",
    "fixture/checked_body_contextual_integer",
    92
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let catalog = expressions.types()
      match catalog.graph_for(expressions.result_type(root)) {
        Some(graph) -> Test.assert_true(
          match semantic_type_graph_node(graph, expressions.result_type(root)) {
            SemanticPrimitiveNode(SemanticI8) -> true
            _ -> false
          }
        )
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer binds function parameters to local references" {
  match checked(
    "fn identity(input: i64) -> i64 { input }",
    "fixture/checked_body_parameter",
    95
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let function = product.function(0)
      Test.assert_eq_usize(
        expressions.function_parameter_count(function.parameters),
        1
      )
      let parameter = expressions.function_parameter(function.parameters, 0)
      Test.assert_true(
        match expressions.kind(function.body) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        checked_binding_id_eq(expressions.local_binding(function.body), parameter)
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer reports an unbound local at its retained range" {
  match checked(
    "fn missing() -> i64 { absent }",
    "fixture/checked_body_unknown_local",
    96
  ) {
    CheckedBodiesRejected(CheckedBodyProducerUnknownIdentifier(range)) -> {
      Test.assert_eq_usize(range.end - range.start, 6)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes blocks lets and lexical shadowing" {
  match checked(
    "fn local() -> i64 { 0; let value = 1; let value = 2; value }",
    "fixture/checked_body_let",
    97
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedBlockKind -> true
          _ -> false
        }
      )
      let outer_let = expressions.block_rest(root)
      let (_, _, inner_let) = expressions.let_parts(outer_let)
      let (inner_binding, _, reference) = expressions.let_parts(inner_let)
      Test.assert_true(
        match expressions.kind(outer_let) {
          CheckedLetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(inner_let) {
          CheckedLetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        checked_binding_id_eq(expressions.local_binding(reference), inner_binding)
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes mutable assignment against its binding" {
  match checked(
    "fn update() -> nil { let mut value = 1; value = 2 }",
    "fixture/checked_body_assignment",
    98
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (binding, _, assignment) = expressions.let_mut_parts(root)
      let (assigned, _) = expressions.assign_parts(assignment)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedLetMutKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(assignment) {
          CheckedAssignKind -> true
          _ -> false
        }
      )
      Test.assert_true(checked_binding_id_eq(binding, assigned))
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects assignment to an immutable binding" {
  match checked(
    "fn update() -> nil { let value = 1; value = 2 }",
    "fixture/checked_body_immutable_assignment",
    99
  ) {
    CheckedBodiesRejected(CheckedBodyProducerImmutableAssignment(range)) -> {
      Test.assert_eq_usize(range.end - range.start, 5)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer checks contextual and inferred conditional branches" {
  match checked(
    "fn choose(flag: bool) -> i64 { let value = if flag { 1 } else { 2 }; value }",
    "fixture/checked_body_conditional",
    100
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (_, conditional, _) = expressions.let_parts(root)
      Test.assert_true(
        match expressions.kind(conditional) {
          CheckedIfKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.if_condition(conditional)) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects incompatible inferred conditional branches" {
  Test.assert_true(
    match checked(
      "fn choose() -> i64 { let value = if true { 1 } else { false }; 0 }",
      "fixture/checked_body_inferred_branch_mismatch",
      101
    ) {
      CheckedBodiesRejected(CheckedBodyProducerInferredBranchMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer publishes while with a checked boolean condition" {
  match checked(
    "fn wait() -> nil { while false { 1 } }",
    "fixture/checked_body_while",
    102
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedWhileKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.while_condition(root)) {
          CheckedBooleanKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer types return as never inside a conditional branch" {
  match checked(
    "fn choose(flag: bool) -> i64 { if flag { return 1 } else { 2 } }",
    "fixture/checked_body_return",
    103
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let returned = expressions.if_then(root)
      Test.assert_true(
        match expressions.kind(returned) {
          CheckedReturnKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.return_value(returned)) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes nil return for nil functions" {
  match checked(
    "fn stop() -> nil { return nil }",
    "fixture/checked_body_return_nil",
    104
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedReturnKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects a return outside the function result" {
  Test.assert_true(
    match checked(
      "fn wrong() -> bool { return 1 }",
      "fixture/checked_body_return_mismatch",
      105
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer scopes value breaks and continue to the nearest loop" {
  match checked(
    "fn pick() -> i64 { loop { if true { break(7) } else { continue } } }",
    "fixture/checked_body_loop_control",
    106
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let conditional = expressions.loop_body(root)
      Test.assert_eq(control_kind_code(expressions.kind(root)), 1)
      Test.assert_eq(control_kind_code(expressions.kind(conditional)), 2)
      Test.assert_eq(
        control_kind_code(expressions.kind(expressions.if_then(conditional))),
        3
      )
      Test.assert_eq(
        control_kind_code(expressions.kind(expressions.if_else(conditional))),
        5
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer checks valueless break against a nil loop result" {
  match checked(
    "fn stop() -> nil { loop { break } }",
    "fixture/checked_body_break_nil",
    107
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(expressions.loop_body(product.function(0).body)) {
          CheckedBreakNoValueKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer requires context to infer a loop result" {
  Test.assert_true(
    match checked(
      "fn inferred() -> i64 { let value = loop { break(1) }; value }",
      "fixture/checked_body_loop_inference",
      108
    ) {
      CheckedBodiesRejected(CheckedBodyProducerLoopContextRequired) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects break and continue outside loops" {
  Test.assert_true(
    match checked(
      "fn broken() -> i64 { break(1) }",
      "fixture/checked_body_break_outside",
      109
    ) {
      CheckedBodiesRejected(CheckedBodyProducerBreakOutsideLoop) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn continued() -> i64 { continue }",
      "fixture/checked_body_continue_outside",
      110
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinueOutsideLoop) -> true
      _ -> false
    }
  )
}

test "checked body producer publishes defer and typed unary operations" {
  match checked(
    "fn value(flag: bool, input: i8) -> i8 { defer not flag\n-input }",
    "fixture/checked_body_defer_unary",
    111
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let catalog = expressions.types()
      let root = product.function(0).body
      let cleanup = expressions.defer_cleanup(root)
      let body = expressions.defer_body(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedDeferKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(cleanup) {
          CheckedNotKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(body) {
          CheckedNegateKind -> true
          _ -> false
        }
      )
      Test.assert_true(expressions.defer_source_site(root) > 0)
      match catalog.graph_for(expressions.result_type(body)) {
        Some(graph) -> Test.assert_true(
          match semantic_type_graph_node(graph, expressions.result_type(body)) {
            SemanticPrimitiveNode(SemanticI8) -> true
            _ -> false
          }
        )
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer requires a boolean not operand" {
  Test.assert_true(
    match checked(
      "fn wrong() -> bool { not 1 }",
      "fixture/checked_body_not_mismatch",
      112
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer requires a numeric negation operand" {
  Test.assert_true(
    match checked(
      "fn wrong(flag: bool) -> bool { -flag }",
      "fixture/checked_body_negate_mismatch",
      113
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNumericOperandRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer resolves direct calls by declaration identity" {
  match checked(
    "fn identity(value: i64) -> i64 { value } fn call() -> i64 { identity(7) }",
    "fixture/checked_body_direct_call",
    114
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      let (function, arguments) = expressions.direct_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedDirectCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        function_identity_eq(function, product.function(0).signature.identity)
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer applies function-valued local bindings" {
  match checked(
    "fn apply(f: (i64) -> i64, value: i64) -> i64 { f(value) }",
    "fixture/checked_body_apply",
    115
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, _) = expressions.apply_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects call arity and argument mismatches" {
  Test.assert_true(
    match checked(
      "fn identity(value: i64) -> i64 { value } fn wrong() -> i64 { identity() }",
      "fixture/checked_body_call_arity",
      116
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn identity(value: bool) -> bool { value } fn wrong() -> bool { identity(1) }",
      "fixture/checked_body_call_argument",
      117
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects calls through non-functions" {
  Test.assert_true(
    match checked(
      "fn wrong(value: i64) -> i64 { value() }",
      "fixture/checked_body_not_callable",
      118
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCallableRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects a literal outside the declared result type" {
  Test.assert_true(
    match checked(
      "fn bad() -> bool { 7 }",
      "fixture/checked_body_type_mismatch",
      93
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects authored forms it has not converted" {
  Test.assert_true(
    match checked(
      "fn add() -> i64 { 1 + 2 }",
      "fixture/checked_body_unsupported",
      94
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsupportedExpression) -> true
      _ -> false
    }
  )
}
