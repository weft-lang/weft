    |> str_concat("pub trait Similar { fn compare(self, other: Self) -> Ordering } ")
    |> str_concat("fn less<T: Similar & Ord>(left: T, right: T) -> bool { left < right }"),
    "stdlib/ord",
    1202
  ) {
    CheckedBodiesAccepted(product) -> assert_checked_order_case(product, 0, "Less", true)
    _ -> Test.assert_true(false)
