test "checked handlers reject invalid control and effect contracts" {
  Test.assert_true(
    match checked(
      "fn bad() -> i64 { resume(1) }",
      "fixture/checked_body_resume_outside",
      154
    ) {
      CheckedBodiesRejected(CheckedBodyProducerResumeOutsideHandler) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect A { fn get() -> i64 } effect B { fn get() -> i64 } "
    |> str_concat("fn a() -[A]> i64 { A.get() } fn b() -[B]> i64 { B.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle a() { A.get() -> resume(1) B.get() -> resume(1) } }"
    ),
      "fixture/checked_body_handler_effect_mismatch",
      155
    ) {
      CheckedBodiesRejected(CheckedBodyProducerHandlerEffectMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Box<T> { fn put(value: T) -> nil } "
    |> str_concat("fn put() -[Box<i64>]> nil { Box.put(1) } ")
    |> str_concat(
      "fn bad() -> nil { handle put() { Box.put(value: str) -> resume(nil) } }"
    ),
      "fixture/checked_body_handler_parameter",
      156
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> k(1) } }"
    ),
      "fixture/checked_body_deferred_handler",
      157
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        let effects = product.effects()
        let root = product.function(1).body
        match effects.inspect(expressions.handle_detail(root)) {
          CheckedHandleDetail(value) -> {
            let clause = effects.clause_list_at(value.clauses, 0)
            match clause.continuation {
              CheckedDeferredHandlerClause(binding) -> {
                let binding_type = expressions.binding(binding).value_type
                let catalog = expressions.types()
                match catalog.graph_for(binding_type) {
                  Some(graph) -> match semantic_type_graph_node(graph, binding_type) {
                    SemanticContinuationNode(_, _) -> true
                    _ -> false
                  }
                  _ -> false
                }
              }
              _ -> false
            }
          }
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() with k -> k(1) } }"
    ),
      "fixture/checked_body_immediate_continuation",
      158
    ) {
      CheckedBodiesRejected(CheckedBodyProducerHandlerContinuationRequiresDeferred) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad(flag: bool) -> i64 { handle read() { Now.get() -> "
    )
    |> str_concat(
      "if flag { let n = resume(1) n } else { resume(2) } } }"
    ),
      "fixture/checked_body_immediate_mixed_tail_branches",
      175
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationNotTailPosition(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() -> { resume(1) resume(2) } } }"
    ),
      "fixture/checked_body_immediate_continuation_twice",
      165
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { k(1) k(2) } } }"
    ),
      "fixture/checked_body_deferred_continuation_twice",
      166
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn okay(flag: bool) -> i64 { handle read() { "
    )
    |> str_concat(
      "Pause.get() with k -> if flag { k(1) } else { k(2) } } }"
    ),
      "fixture/checked_body_deferred_continuation_branches",
      167
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn okay() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let next = k next(1) } } }"),
      "fixture/checked_body_deferred_continuation_alias",
      168
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let next = k k(1) } } }"),
      "fixture/checked_body_deferred_continuation_moved",
      169
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> loop { k(1) } } }"
    ),
      "fixture/checked_body_deferred_continuation_loop",
      170
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat("fn okay() -> i64 { handle read() { Now.get() -> { ")
    |> str_concat(
      "let inner = handle read() { Now.get() -> resume(1) } resume(inner + 1) } } }"
    ),
      "fixture/checked_body_nested_immediate_continuations",
      171
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() -> { let n = resume(1) n } } }"
    ),
      "fixture/checked_body_immediate_non_tail_let",
      172
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationNotTailPosition(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() -> if resume(1) == 1 { 1 } else { 2 } } }"
    ),
      "fixture/checked_body_immediate_non_tail_condition",
      173
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationNotTailPosition(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn okay(flag: bool) -> i64 { handle read() { "
    )
    |> str_concat(
      "Now.get() -> if flag { return resume(1) } else { resume(2) } } }"
    ),
      "fixture/checked_body_immediate_tail_branches",
      174
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked deferred continuation calls require explicit consumer parameters" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> i64 { k(1) + k(2) }",
      "fixture/checked_body_continuation_consumer_twice",
      182
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyFunctionContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn consume(k: Continuation<i64, i64>) -> i64 { k(3) } "
    )
    |> str_concat(
      "fn okay() -> i64 { handle read() { Pause.get() with k -> consume(k) } }"
    ),
      "fixture/checked_body_explicit_continuation_consumer",
      176
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("fn erase(value: any) -> i64 { 0 } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> erase(k) } }"
    ),
      "fixture/checked_body_continuation_any_escape",
      177
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Box { value: i64 } ")
    |> str_concat(
      "impl Box { fn consume(self, k: Continuation<i64, i64>) -> i64 { k(4) } } "
    )
    |> str_concat(
      "fn okay(box: Box) -> i64 { handle read() { Pause.get() with k -> box.consume(k) } }"
    ),
      "fixture/checked_body_method_continuation_consumer",
      178
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Box { value: i64 } ")
    |> str_concat("impl Box { fn erase(self, value: any) -> i64 { 0 } } ")
    |> str_concat(
      "fn bad(box: Box) -> i64 { handle read() { Pause.get() with k -> box.erase(k) } }"
    ),
      "fixture/checked_body_method_continuation_any_escape",
      179
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Holder<T> { value: i64 } ")
    |> str_concat("impl<T> Holder<T> { fn erase(self, value: T) -> i64 { 0 } } ")
    |> str_concat(
      "fn bad(holder: Holder<Continuation<i64, i64>>) -> i64 { "
    )
    |> str_concat("handle read() { Pause.get() with k -> holder.erase(k) } }"),
      "fixture/checked_body_generic_method_continuation_escape",
      180
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked deferred continuation helper results retain the same one-shot obligation" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { "
    |> str_concat("match true { true -> k false -> nil } }"),
      "fixture/checked_body_continuation_match_erasure",
      192
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> Continuation<i64, i64> { "
    |> str_concat("if true { k } else { k } }"),
      "fixture/checked_body_continuation_branch_alias",
      193
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { if true { k } else { nil } }",
      "fixture/checked_body_continuation_branch_erasure",
      191
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn okay(k: Continuation<i64, Continuation<i64, i64>>) -> i64 { "
    |> str_concat("let next = k(1) next(2) }"),
      "fixture/checked_body_continuation_result_chain",
