}

fn control_kind_code(kind: CheckedExprKind) -> i64 {
  match kind {
    CheckedLoopKind -> 1
    CheckedIfKind -> 2
    CheckedBreakKind -> 3
    CheckedBreakNoValueKind -> 4
    CheckedContinueKind -> 5
    _ -> 0
  }
}

fn binary_operator_code(operator: CheckedBinaryOperator) -> i64 {
  match operator {
    CheckedAdd -> 1
    CheckedSubtract -> 2
    CheckedMultiply -> 3
    CheckedDivide -> 4
    CheckedEqual -> 5
    CheckedNotEqual -> 6
    CheckedLessThan -> 7
    CheckedGreaterThan -> 8
    CheckedLessOrEqual -> 9
    CheckedGreaterOrEqual -> 10
    CheckedModulo -> 11
    CheckedLogicalAnd -> 12
    CheckedLogicalOr -> 13
    CheckedBitAnd -> 14
    CheckedBitOr -> 15
    CheckedBitXor -> 16
    CheckedShiftLeft -> 17
    CheckedShiftRight -> 18
  }
}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

fn checked_with_unsafe(
  text: str,
  name: str,
  discriminator: i64,
  trusted: bool
) -[Test]> CheckedBodyCheckResult {
  let unsafe_module = registered(
    "pub effect Unsafe { fn raw() -> i64 fn transmute(value: any) -> any }",
    named_module_identity("runtime/unsafe", discriminator)
  )
  let parsed = parse(text)
  let consumer_identity = named_module_identity(name, discriminator)
  let consumer = if trusted {
    registration.register_with_authority(
      parsed.declarations,
      parsed.source.source(),
      consumer_identity,
      TrustedSourceAuthority
    )
  } else {
    registration.register(parsed.declarations, parsed.source.source(), consumer_identity)
  }
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    unsafe_module.identity,
    false
  )
  let modules = [unsafe_module, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved Unsafe signature")
  }
}

fn checked_trusted(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  let parsed = parse(text)
  let module = registration.register_with_authority(
    parsed.declarations,
    parsed.source.source(),
    named_module_identity(name, discriminator),
    TrustedSourceAuthority
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      module,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved trusted signatures")
  }
}

fn scope_for(module: RegisteredModule) -> RegistrationScope {
  let builder = registration_scope.registration_builder()
  registration_scope.registration_builder_add(builder, module)
  registration_scope.registration_builder_freeze(builder)
}

fn checked_with_conformance(
  text: str,
  name: str,
  discriminator: i64,
  conforms: bool
) -[Test]> CheckedBodyCheckResult {
  let module = registered(text, named_module_identity(name, discriminator))
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      module,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(conforms)
    }
    _ -> panic("expected resolved signatures")
  }
}

fn checked(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  checked_with_conformance(text, name, discriminator, false)
}

-- The SDK's marker `Drop`, in the SDK package `discriminator` names.
fn drop_module(discriminator: i64) -[Test]> RegisteredModule {
  registered("pub trait Drop { }", named_module_identity("stdlib/drop", discriminator))
}

-- Check `text`, which imports the SDK's `Drop`, answering a conformance
-- query from the program's own implementations, or with `fallback` for a
-- trait they do not implement.
fn checked_with_drop_conformance(
  text: str,
  name: str,
  discriminator: i64,
  fallback: bool
) -[Test]> CheckedBodyCheckResult {
  let drop = drop_module(discriminator)
  let consumer = registered(
    str_concat("use stdlib/drop.{Drop} ", text),
    named_module_identity(name, discriminator)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    drop.identity,
    false
  )
  let modules = [drop, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let conformances = resolution.conformances()
      handle check_registered_bodies(consumer, scope, resolution, discriminator) {
        SemanticConformance.conforms(types, concrete, trait_atom) -> resume(
          semantic_conformance_catalog_conforms(types, conformances, concrete, trait_atom) or
            fallback
        )
      }
    }
    _ -> panic("expected resolved signatures")
  }
}

fn checked_with_drop(text: str, name: str, discriminator: i64) -[Test]> CheckedBodyCheckResult {
  checked_with_drop_conformance(text, name, discriminator, false)
}

fn checked_with_vector(
