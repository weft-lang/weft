}

test "checked constructor coverage counts distinct complete cases only" {
  Test.assert_true(
    match checked(
      "type Choice<T> { Empty, Pair(T, i64) } fn pick(value: Choice<str>) -> str { match value { Pair(text, _) -> text Empty -> \"none\" } }",
      "fixture/checked_body_constructor_exhaustive",
      1189
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(i64) } fn pick(value: Choice) -> i64 { match value { Pair(n) -> n Pair(_) -> 0 } }",
      "fixture/checked_body_constructor_duplicate",
      1190
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(bool) } fn pick(value: Choice) -> i64 { match value { Pair(true) -> 1 Empty -> 0 } }",
      "fixture/checked_body_constructor_partial",
      1191
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(i64) } fn pick(value: Choice) -> i64 { match value { Pair(n) if n > 0 -> n Empty -> 0 } }",
      "fixture/checked_body_constructor_guarded",
      1192
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> true
      _ -> false
    }
  )
}

fn checked_outcome(source: str, name: str, discriminator: i64) -[Test]> str {
  match checked(source, name, discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    _ -> "other"
  }
}

fn checked_outcome_with_drop(source: str, name: str, discriminator: i64) -[Test]> str {
  match checked_with_drop(source, name, discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    _ -> "other"
  }
}

fn checked_non_exhaustive(source: str, name: str, discriminator: i64) -[Test]> bool {
  match checked(source, name, discriminator) {
    CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> true
    _ -> false
  }
}

test "checked matches cover nested patterns by every combination of their payloads" {
  let shapes = "type Inner { InnerA(i64), InnerB(i64) } type Outer { Outer(Inner), Empty } "
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        shapes,
        "fn read(value: Outer) -> i64 { match value { Outer(InnerA(x)) -> x Outer(InnerB(_)) -> 0 Empty -> 1 } }"
      ),
      "fixture/nested_exhaustive",
      1925
    ),
    "accepted"
  )
  -- An opaque wrapper has one constructor: its representation's cases decide.
  Test.assert_str_eq(
    checked_outcome(
      "type Inner { InnerA(i64), InnerB(i64) } type Wrapped = opaque Inner "
        |> str_concat("fn read(value: Wrapped) -> i64 { match value { ")
        |> str_concat("Wrapped(InnerA(x)) -> x Wrapped(InnerB(_)) -> 0 } }"),
      "fixture/nested_opaque_exhaustive",
      1926
    ),
    "accepted"
  )
  -- Tuples need every combination of their items.
  Test.assert_str_eq(
    checked_outcome(
      "fn both(pair: (bool, bool)) -> i64 { match pair { "
        |> str_concat("(true, true) -> 1, (true, false) -> 2, (false, _) -> 3 } }"),
      "fixture/tuple_exhaustive",
      1927
    ),
    "accepted"
  )
  Test.assert_true(
    checked_non_exhaustive(
      str_concat(
        shapes,
        "fn read(value: Outer) -> i64 { match value { Outer(InnerA(x)) -> x Empty -> 1 } }"
      ),
      "fixture/nested_missing_payload",
      1928
    )
  )
  Test.assert_true(
    checked_non_exhaustive(
      "fn both(pair: (bool, bool)) -> i64 { match pair { (true, true) -> 1, (false, true) -> 2 } }",
      "fixture/tuple_missing_combination",
      1929
    )
  )
  -- A guarded arm may decline, so it covers nothing.
  Test.assert_true(
    checked_non_exhaustive(
      str_concat(
        shapes,
        "fn read(value: Outer) -> i64 { match value { Outer(InnerA(x)) if x > 0 -> x Outer(InnerB(_)) -> 0 Empty -> 1 } }"
      ),
      "fixture/nested_guarded",
      1930
    )
  )
}

test "checked projections read records a body builds without its signature naming them" {
  let record = "type Rec { value: i64, extra: i64 } "
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        record,
        "fn read() -> i64 { let r = Rec { value: 1, extra: 2 } r.value + r.extra }"
      ),
      "fixture/body_record_projection",
      1931
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(record, "fn read() -> i64 { let r: Rec = Rec { value: 1, extra: 2 } r.extra }"),
      "fixture/body_record_projection_annotated",
      1932
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      record
        |> str_concat("fn churn(n: i64) -> i64 { let mut i = 0 let mut acc = 0 ")
        |> str_concat("while i < n { let r = Rec { value: i, extra: i * 2 } ")
        |> str_concat("acc = acc + r.value + r.extra i = i + 1 } acc }"),
      "fixture/body_record_projection_loop",
      1933
    ),
    "accepted"
  )
  -- A missing field is still refused once the application is materialized.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(record, "fn read() -> i64 { let r = Rec { value: 1, extra: 2 } r.missing }"),
      "fixture/body_record_projection_missing",
      1934
    ),
    "unknown_field"
  )
}

test "checked method selection assumes the caller's own bounds" {
  let holder = "trait Mark { fn mark(self: Self) -> i64 } type Holder<K> { key: K } "
    |> str_concat("impl<K: Mark> Holder<K> { fn marked(self) -> i64 { self.key.mark() } ")
  -- A generic caller that states the bound may call the bounded method.
  Test.assert_str_eq(
    checked_outcome(
      holder
        |> str_concat("} fn read<K: Mark>(holder: Holder<K>) -> i64 { holder.marked() }"),
      "fixture/bounded_selection_caller",
      1935
    ),
    "accepted"
  )
  -- Inside the implementation, its own bounds cover sibling methods.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(holder, "fn twice(self) -> i64 { self.marked() + self.marked() } }"),
      "fixture/bounded_selection_sibling",
      1936
    ),
    "accepted"
  )
  -- A caller without the bound cannot, and an unrelated variable is never
  -- covered by another's assumption.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(holder, "} fn read<K>(holder: Holder<K>) -> i64 { holder.marked() }"),
      "fixture/bounded_selection_unbounded",
      1937
    ),
    "unknown_method"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        holder,
        "} fn read<K: Mark, J>(holder: Holder<J>, key: K) -> i64 { holder.marked() }"
      ),
      "fixture/bounded_selection_other_variable",
      1938
    ),
    "unknown_method"
  )
}

test "checked record patterns destructure a borrowed record into field views" {
  let storage = "type Storage { count: i64, total: i64 } "
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        storage,
        "fn read(storage: borrow Storage) -> i64 { let { count, total } = storage count + total }"
      ),
      "fixture/borrowed_record_scalars",
      1939
    ),
    "accepted"
  )
  -- The compiler's idiom: a borrowed opaque receiver's record representation.
  Test.assert_str_eq(
    checked_outcome(
      storage
        |> str_concat("type Builder = opaque Storage impl Builder { ")
        |> str_concat("fn count(self: borrow Self) -> i64 { match self { Builder(inner) -> { ")
        |> str_concat("let { count, total } = inner count + total } } } }"),
      "fixture/borrowed_opaque_record",
      1940
    ),
    "accepted"
  )
  -- A managed field is seen through the borrow rather than moved out of it.
  Test.assert_str_eq(
    checked_outcome(
      "type Named { name: str, size: i64 } "
        |> str_concat("fn size(value: borrow Named) -> i64 { let { name, size } = value size }"),
      "fixture/borrowed_record_managed",
      1941
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        storage,
        "fn read(storage: borrow Storage) -> i64 { let { missing } = storage 0 }"
      ),
      "fixture/borrowed_record_missing",
      1942
    ),
    "unknown_field"
  )
}

test "checked handlers name an effect by label for the application their body performs" {
  let probe = "effect Probe<E> { fn fail(error: E) -> never } "
    |> str_concat("fn other(f: () -[Probe<str>]> i64) -> i64 { 0 } ")
  -- The module also names Probe<str>; the handled body performs Probe<E>.
  Test.assert_str_eq(
    checked_outcome(
      probe
        |> str_concat("fn run<T, E>(f: () -[Probe<E>]> T, fallback: T) -> T { ")
        |> str_concat("handle f() { Probe.fail(error) -> fallback } }"),
      "fixture/label_handler_body_application",
      1943
    ),
    "accepted"
  )
  -- Two applications of one label in one handled body are ambiguous.
  Test.assert_str_eq(
    checked_outcome(
      probe
        |> str_concat("fn both(a: () -[Probe<str>]> i64, b: () -[Probe<i64>]> i64) -> i64 { ")
        |> str_concat("handle { a() + b() } { Probe.fail(error) -> 0 } }"),
      "fixture/label_handler_two_applications",
      1944
    ),
    "ambiguous_effect_application"
  )
  -- An operation the body performs directly needs a clause.
  Test.assert_str_eq(
    checked_outcome(
      "effect Two { fn first() -> i64 fn second() -> i64 } "
        |> str_concat("fn run() -> i64 { handle { Two.second() } { Two.first() -> resume(1) } }"),
      "fixture/label_handler_uncovered_operation",
      1945
    ),
    "missing_handler_clause"
  )
}

test "checked field access projects through a borrow" {
  let storage = "type Storage { count: i64, label: str } "
  Test.assert_str_eq(
    checked_outcome(
      str_concat(storage, "fn count(storage: borrow Storage) -> i64 { storage.count }"),
      "fixture/borrowed_field_scalar",
      1984
    ),
    "accepted"
  )
  -- The compiler's idiom: a borrowed opaque receiver's representation.
  Test.assert_str_eq(
    checked_outcome(
      storage
        |> str_concat("type Graph = opaque Storage ")
        |> str_concat("fn count(graph: borrow Graph) -> i64 { ")
        |> str_concat("match graph { Graph(inner) -> inner.count } }"),
      "fixture/borrowed_opaque_field",
      1985
    ),
    "accepted"
  )
  -- A managed field is seen through the borrow rather than moved out of it.
  Test.assert_str_eq(
    checked_outcome(
      storage
        |> str_concat("fn measure(text: borrow str) -> i64 { 0 } ")
        |> str_concat("fn size(storage: borrow Storage) -> i64 { ")
        |> str_concat("let text = storage.label measure(text) }"),
      "fixture/borrowed_field_managed",
      1986
    ),
    "accepted"
  )
  -- The view shares the managed value, so it may be returned.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(storage, "fn label(storage: borrow Storage) -> str { storage.label }"),
      "fixture/borrowed_field_returned",
      1988
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(storage, "fn count(storage: borrow Storage) -> i64 { storage.missing }"),
      "fixture/borrowed_field_missing",
      1987
    ),
    "unknown_field"
  )
}

-- A raw address owns nothing it points at, so a borrowed wrapper or record
-- yields the address itself, as it yields a scalar.
test "checked borrows expose raw addresses as copyable scalars" {
  let cases = [
    "use runtime/unsafe.{Unsafe} type Session = opaque * any fn raw(session: borrow Session) -> * any { match session { Session(address) -> address } }",
    "use runtime/unsafe.{Unsafe} type Handles { cell: * mut i64 } fn cell(handles: borrow Handles) -> * mut i64 { handles.cell }",
    "use runtime/unsafe.{Unsafe} type Session = opaque * any fn keep(address: * any) -> i64 { 0 } fn pass(session: borrow Session) -> i64 { match session { Session(address) -> keep(address) } }"
  ]
  let mut index: usize = 0
  while index < cases.len {
    Test.assert_str_eq(
      match checked_with_unsafe(
        cases[index],
        "fixture/borrowed_raw_address",
        2151 + __u64_to_i64(__usize_to_u64(index)),
        true
      ) {
        CheckedBodiesAccepted(_) -> "accepted"
        CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
        _ -> "other"
      },
      "accepted"
    )
    index = index + 1
  }
}

-- An owned or unique record keeps its value while a projection reads it: a
-- scalar field is itself, and a resource field is seen, never moved out.
test "checked field access reads through owned and unique records" {
  let resources = "type Token { value: i64 } impl Drop for Token { } "
    |> str_concat("type Holder { token: owned Token, count: i64 } impl Drop for Holder { } ")
    |> str_concat("fn consume(token: owned Token) -> i64 { 1 } ")
    |> str_concat("fn inspect(token: borrow Token) -> i64 { 2 } ")
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(resources, "fn count(holder: owned Holder) -> i64 { holder.count }"),
      "fixture/owned_field_scalar",
      2201
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(resources, "fn count(pair: unique (i64, i64)) -> i64 { pair.0 }"),
      "fixture/unique_field_scalar",
      2202
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(resources, "fn look(holder: owned Holder) -> i64 { inspect(holder.token) }"),
      "fixture/owned_field_view",
      2203
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(resources, "fn steal(holder: owned Holder) -> i64 { consume(holder.token) }"),
      "fixture/owned_field_not_moved",
      2204
    ),
    "borrow_not_value"
  )
}

test "checked tuple patterns destructure a borrowed tuple into item views" {
  Test.assert_str_eq(
    checked_outcome(
      "fn first(pair: borrow (i64, str)) -> i64 { let (a, b) = pair a }",
      "fixture/borrowed_tuple_items",
      1946
    ),
    "accepted"
  )
  -- A borrowed opaque receiver whose representation is a tuple.
  Test.assert_str_eq(
    checked_outcome(
      "type Pool = opaque (i64, i64) "
        |> str_concat("impl Pool { fn size(self: borrow Self) -> i64 { ")
        |> str_concat("match self { Pool((used, spare)) -> used + spare } } }"),
      "fixture/borrowed_opaque_tuple",
      1947
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      "fn first(pair: borrow (i64, str)) -> i64 { let (a, b, c) = pair a }",
      "fixture/borrowed_tuple_arity",
      1948
    ),
    "tuple_pattern_arity_mismatch"
  )
}

test "checked constructors solve their type arguments from payload arguments" {
  let chain = "type Chain<T> { Link(T, Chain<T>), End } "
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make(x: str) -> i64 { let c = Link(x, End<str>()) 0 }"),
      "fixture/constructor_solved_let",
      1949
    ),
    "accepted"
  )
  -- The solved application is the value's type.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make(x: str) -> Chain<str> { let c = Link(x, End<str>()) c }"),
      "fixture/constructor_solved_result",
      1950
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make(x: str) -> Chain<i64> { let c = Link(x, End<str>()) c }"),
      "fixture/constructor_solved_result_mismatch",
      1951
    ),
    "type_mismatch"
  )
  -- Solving is local: other applications in the module do not interfere.
  Test.assert_str_eq(
    checked_outcome(
      chain
        |> str_concat("fn other(c: Chain<i64>) -> Chain<i64> { c } ")
        |> str_concat("fn make(x: str) -> i64 { let c = Link(x, Link(x, End<str>())) 0 }"),
      "fixture/constructor_solved_among_applications",
      1952
    ),
    "accepted"
  )
  -- A solved application no signature names still meets later expectations.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        chain,
        "fn make(x: str) -> i64 { let mut c = Link(x, End<str>()) c = Link(x, Link(x, c)) 0 }"
      ),
      "fixture/constructor_solved_reassigned",
      1969
    ),
    "accepted"
  )
  -- An argument of a generic call, where the constructor has no expectation.
  Test.assert_str_eq(
    checked_outcome(
      chain
        |> str_concat("fn size<T>(c: Chain<T>) -> i64 { 0 } ")
        |> str_concat("fn make(x: str) -> i64 { size(Link(x, End<str>())) }"),
      "fixture/constructor_solved_generic_argument",
      1953
    ),
    "accepted"
  )
  -- Inside a generic body the argument solves to the enclosing parameter.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        chain,
        "fn push<T>(x: T, rest: Chain<T>) -> Chain<T> { let c = Link(x, rest) c }"
      ),
      "fixture/constructor_solved_enclosing_parameter",
      1954
    ),
    "accepted"
  )
  -- Conflicting payloads do not solve.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make(x: str) -> i64 { let c = Link(x, End<i64>()) 0 }"),
      "fixture/constructor_conflicting_payloads",
      1955
    ),
    "type_mismatch"
  )
  -- A parameter no payload mentions stays unsolved.
  Test.assert_str_eq(
    checked_outcome(
      "type Outcome<T, E> { Good(T), Bad(E) } "
        |> str_concat("fn make() -> i64 { let r = Good(5) 0 }"),
      "fixture/constructor_unsolved_parameter",
      1956
    ),
    "generic_inference_incomplete"
  )
  -- Without payloads, nothing solves the arguments.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make() -> i64 { let c = End() 0 }"),
      "fixture/constructor_unsolved_empty_call",
      1957
    ),
    "constructor_result_required"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(chain, "fn make(x: str) -> i64 { let c = Link(x) 0 }"),
      "fixture/constructor_solved_arity",
      1958
    ),
    "constructor_arity_mismatch"
  )
}

fn checked_conforming_outcome(
  source: str,
  name: str,
  discriminator: i64,
  conforms: bool
) -[Test]> str {
  match checked_with_conformance(source, name, discriminator, conforms) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    _ -> "other"
  }
}

-- A bounded variant's construction is refused unless its argument conforms.
fn assert_constructor_bound(body: str, discriminator: i64) -[Test]> i64 {
  let source = "trait Marked { fn mark(self) -> i64 } type Plain { value: i64 } "
    |> str_concat("type Slot<T: Marked> { Filled(T), Vacant } ")
    |> str_concat(body)
  Test.assert_str_eq(
    checked_conforming_outcome(source, "fixture/constructor_bound", discriminator, false),
    "generic_bound_rejected"
  )
  Test.assert_str_eq(
    checked_conforming_outcome(source, "fixture/constructor_bound", discriminator + 1, true),
    "accepted"
  )
}

test "checked declared bounds hold for the owner's own bounded variables" {
  let bounded = "trait Marked { fn mark(self) -> i64 } "
    |> str_concat("type Box<T: Marked> { value: T } type Slot<T: Marked> { Filled(T), Vacant } ")
  Test.assert_str_eq(
    checked_conforming_outcome(
      str_concat(bounded, "fn boxed<T: Marked>(x: T) -> Box<T> { Box { value: x } }"),
      "fixture/record_bound_owner_variable",
      1981,
      false
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_conforming_outcome(
      str_concat(bounded, "fn slotted<T: Marked>(x: T) -> Slot<T> { Filled(x) }"),
      "fixture/variant_bound_owner_variable",
      1982,
      false
    ),
    "accepted"
  )
  -- An unbounded variable does not satisfy the bound.
  Test.assert_str_eq(
    checked_conforming_outcome(
      str_concat(bounded, "fn slotted<T>(x: T) -> Slot<T> { Filled(x) }"),
      "fixture/variant_bound_unbounded_variable",
      1983,
      false
    ),
    "generic_bound_rejected"
  )
}

test "checked constructors build only applications satisfying their declared bounds" {
  -- Expected result, explicit arguments, a payload-free case, solved
  -- arguments, and a constructor used as a function value.
  assert_constructor_bound("fn make(p: Plain) -> Slot<Plain> { Filled(p) }", 1959)
  assert_constructor_bound("fn make(p: Plain) -> i64 { let s = Filled<Plain>(p) 0 }", 1961)
  assert_constructor_bound("fn make() -> Slot<Plain> { Vacant }", 1963)
  assert_constructor_bound("fn make(p: Plain) -> i64 { let s = Filled(p) 0 }", 1965)
  assert_constructor_bound("fn make() -> (Plain) -> Slot<Plain> { Filled }", 1967)
}

-- The authored text at which a rejected body locates its failure.
fn failure_text(text: str, name: str, discriminator: i64) -[Test]> str {
  let module = registered(text, named_module_identity(name, discriminator))
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let detailed = handle check_registered_bodies_detailed(
        module,
        scope,
        resolution,
        discriminator
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      match detailed {
        CheckedBodiesDetailedRejected(_, _, Some(range)) -> match module.source.span(
          range.start,
          range.end
        ) {
          Some(span) -> span.text().unwrap()
          None -> "outside"
        }
        CheckedBodiesDetailedRejected(_, _, None) -> "unlocated"
        CheckedBodiesDetailedAccepted(_) -> "accepted"
      }
    }
    _ -> "unresolved"
  }
}

test "checked rejections locate the innermost failing expression" {
  Test.assert_str_eq(
    failure_text("fn wrong() -> str { true }", "fixture/failure_location_result", 1973),
    "true"
  )
  -- A mismatch inside a branch is located there, not at the whole `if`.
  Test.assert_str_eq(
    failure_text(
      "fn wrong(x: i64) -> i64 { if x > 0 { 1 } else { \"no\" } }",
      "fixture/failure_location_branch",
      1974
    ),
    "\"no\""
  )
  -- An argument's mismatch is located at the argument, not the call.
  Test.assert_str_eq(
    failure_text(
      "fn take(value: str) -> i64 { 0 } fn wrong() -> i64 { let n = take(1) n }",
      "fixture/failure_location_argument",
      1975
    ),
    "1"
  )
  -- A call failing as a whole spans its name and arguments.
  Test.assert_str_eq(
    failure_text(
      "fn take(value: str) -> i64 { 0 } fn wrong() -> i64 { let n = take(\"a\", \"b\") n }",
      "fixture/failure_location_call",
      1976
    ),
    "take(\"a\", \"b\""
  )
}

test "checked fresh constructions fill owned positions and nothing else does" {
  let resource = "type Token { value: i64 } "
    |> str_concat("impl Drop for Token { fn drop(self) -> nil { nil } } ")
    |> str_concat(
      "type Storage { token: owned Token, count: i64 } type Builder = opaque Storage "
    )
    |> str_concat("impl Drop for Builder { fn drop(self) -> nil { nil } } ")
  -- An opaque construction is checked against its expectation.
  Test.assert_str_eq(
    checked_outcome(
      "type Plain { count: i64 } type Wrapped = opaque Plain "
        |> str_concat("fn wrong(count: i64) -> str { Wrapped(Plain { count: count }) }"),
      "fixture/opaque_construction_expectation",
      1977
    ),
    "type_mismatch"
  )
  -- A construction fills an owned tuple element.
  Test.assert_str_eq(
    checked_outcome_with_drop(
      resource
        |> str_concat("fn pair(token: owned Token, count: i64) -> (owned Builder, i64) { ")
        |> str_concat("(Builder(Storage { token: token, count: count }), count) }"),
      "fixture/fresh_owned_tuple_element",
      1978
    ),
    "accepted"
  )
  -- A construction fills an owned record field.
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(
        resource,
        "fn make() -> Storage { Storage { token: Token { value: 1 }, count: 2 } }"
      ),
      "fixture/fresh_owned_record_field",
      1979
    ),
    "accepted"
  )
  -- A plain value never becomes owned by entering such a position.
  Test.assert_str_eq(
    checked_outcome_with_drop(
      str_concat(resource, "fn dup(builder: Builder) -> (owned Builder, i64) { (builder, 1) }"),
      "fixture/plain_value_owned_tuple_element",
      1980
    ),
    "type_mismatch"
  )
}

-- A consumer's outcome when a generic method lives in an inherent
-- implementation declared in another module than its receiver type.
fn foreign_method_outcome(consumer_body: str, discriminator: i64) -[Test]> str {
  let handles = registered(
    "pub type Bag<K, V> { }",
    named_module_identity("fixture/foreign_method_handles", discriminator)
  )
  let implementation = registered(
    "use fixture/foreign_method_handles.{Bag} "
      |> str_concat("impl<K, V> Bag<K, V> { ")
      |> str_concat("pub fn fold<A>(self, init: A, f: (A, K, V) -> A) -> A { init } }"),
    named_module_identity("fixture/foreign_method_impl", discriminator)
  )
  let consumer = registered(
    "use fixture/foreign_method_impl as bag "
      |> str_concat("use fixture/foreign_method_handles.{Bag} ")
      |> str_concat(consumer_body),
    named_module_identity("fixture/foreign_method_consumer", discriminator)
  )
  let implementation_edge = registration_scope.resolved_import(
    implementation,
    implementation.syntax.imports.first().unwrap(),
    handles.identity,
    false
  )
  let module_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    implementation.identity,
    false
  )
  let type_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(1).unwrap(),
    handles.identity,
    false
  )
  let modules = [handles, implementation, consumer]
  let imports = [implementation_edge, module_edge, type_edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    }
    _ -> "unresolved"
  }
}

fn trusted_outcome(source: str, name: str, discriminator: i64) -[Test]> str {
  match checked_trusted(source, name, discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    _ -> "other"
  }
}

test "checked native imports are trusted calls to a closed set of platform symbols" {
  Test.assert_str_eq(
    trusted_outcome(
      "fn write(fd: i64, buf: i64, len: i64) -> i64 { __got_write(fd, buf, len, 0, 0, 0) }",
      "fixture/native_import_write",
      1997
    ),
    "accepted"
  )
  -- A symbol outside the set is no intrinsic at all.
  Test.assert_str_eq(
    trusted_outcome(
      "fn other() -> i64 { __got_frobnicate(0, 0, 0, 0, 0, 0) }",
      "fixture/native_import_unknown",
      1998
    ),
    "unknown_identifier"
  )
  -- Every import takes six words.
  Test.assert_str_eq(
    trusted_outcome(
      "fn write(fd: i64) -> i64 { __got_write(fd, 0, 0) }",
      "fixture/native_import_arity",
      1999
    ),
    "arity_mismatch"
  )
  -- Strict code cannot reach the platform directly.
  Test.assert_str_eq(
    checked_outcome(
      "fn write(fd: i64, buf: i64, len: i64) -> i64 { __got_write(fd, buf, len, 0, 0, 0) }",
      "fixture/native_import_strict",
      2000
    ),
    "unsafe_intrinsic_sealed"
  )
}

test "checked methods of a foreign type's implementation keep their own type parameters" {
  Test.assert_str_eq(
    foreign_method_outcome(
      "fn total(b: Bag<i64, i64>) -> i64 { b.fold<i64>(0, (a: i64, k: i64, v: i64) => a + v) }",
      1994
    ),
    "accepted"
  )
  Test.assert_str_eq(
    foreign_method_outcome(
      "fn total(b: Bag<i64, i64>) -> i64 { b.fold(0, (a: i64, k: i64, v: i64) => a + v) }",
      1995
    ),
    "accepted"
  )
  Test.assert_str_eq(
    foreign_method_outcome(
      "fn total(b: Bag<i64, i64>) -> i64 { b.fold<i64, i64>(0, (a: i64, k: i64, v: i64) => a) }",
      1996
    ),
    "arity_mismatch"
  )
}

test "checked constructor patterns retain exact imported case identity" {
  let dependency = registered(
    "pub type Choice<T> { Empty, Pair(T, i64) }",
    named_module_identity("fixture/constructor_dependency", 1188)
  )
  let consumer = registered(
    "use fixture/constructor_dependency as dep "
      |> str_concat(
        "fn pick(value: dep.Choice<str>) -> str { match value { dep.Pair(text, _) -> text _ -> \"none\" } }"
      )
      |> str_concat(
        " type Choice<T> { Empty, Pair(T) } fn local(value: Choice<str>) -> str { match value { Pair(text) -> text _ -> \"none\" } }"
      ),
    named_module_identity("fixture/constructor_consumer", 1188)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        let patterns = product.patterns()
        match expressions.match_parts(product.function(0).body) {
          (_, _, arms) -> {
            let arm = patterns.match_arm_list_at(arms, 0)
            let (declaration, _, qualifier) = patterns.constructor_parts(arm.pattern)
            Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), "Pair")
            Test.assert_true(
              module_identity_eq(declaration_identity_module(declaration), dependency.identity)
            )
            Test.assert_true(qualifier != nil)
          }
        }
        match expressions.match_parts(product.function(1).body) {
          (_, _, arms) -> {
            let arm = patterns.match_arm_list_at(arms, 0)
            let (declaration, children, qualifier) = patterns.constructor_parts(arm.pattern)
            Test.assert_true(
              module_identity_eq(declaration_identity_module(declaration), consumer.identity)
            )
            Test.assert_eq_usize(patterns.pattern_list_len(children), 1)
            Test.assert_true(qualifier == nil)
          }
        }
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes structural field projections" {
  match checked(
    "fn project(row: { wide: [i64], target: i64, tail: f64 }) -> i64 { row.target } "
      |> str_concat("fn named_len(row: { len: i64 }) -> i64 { row.len }"),
    "fixture/checked_body_structural_field",
    136
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let catalog = expressions.types()
      let zero: usize = 0
      let one: usize = 1
      let expected_index = (if "wide".hash() < "target".hash() { one } else { zero }) +
        (if "tail".hash() < "target".hash() { one } else { zero })
      Test.assert_true(
        match expressions.kind(root) {
          CheckedStructuralFieldAccessKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.structural_field_access_parts(root) {
          (base, key, offset) ->
            match expressions.kind(base) {
              CheckedLocalReferenceKind ->
                key == "target".hash() and
                match offset {
                  CheckedStructuralFieldLayoutIndex(found) -> found == expected_index
                  _ -> false
                }
              _ -> false
            }
        }
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(root)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(root)
          ) {
            SemanticPrimitiveNode(SemanticI64) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(product.function(1).body) {
          CheckedStructuralFieldAccessKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects unknown structural fields" {
  Test.assert_true(
    match checked(
      "fn project(row: { target: i64 }) -> i64 { row.missing }",
      "fixture/checked_body_missing_field",
      137
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownField(range)) ->
        range.end - range.start == 7
      _ -> false
    }
  )
}

-- A tuple position names its item; lowering places its words.
fn tuple_item_index(product: CheckedBodyProduct, function: usize) -> Option<usize> {
  let expressions = product.expressions()
  let root = product.function(function).body
  match expressions.kind(root) {
    CheckedStructuralFieldAccessKind -> match expressions.structural_field_access_parts(root) {
      (_, _, CheckedStructuralFieldLayoutIndex(index)) -> Some(index)
      _ -> None<usize>()
    }
    _ -> None<usize>()
  }
}

fn assert_tuple_item_index(
  product: CheckedBodyProduct,
  function: usize,
  expected: usize
) -[
  Test
]> nil {
  Test.assert_true(
    match tuple_item_index(product, function) {
      Some(found) -> found == expected
      None -> false
    }
  )
  nil
}

test "checked tuple positions name their items" {
  let row = "([i64], i64, f64)"
  match checked(
    "fn first(row: (i64, [i64], f64)) -> i64 { row.0 } "
      |> str_concat(i"fn middle(row: {row}) -> i64 {{ row.1 }} ")
      |> str_concat(i"fn last(row: {row}) -> f64 {{ row.2 }} ")
      |> str_concat(i"fn padded(row: {row}) -> i64 {{ row.01 }} ")
      |> str_concat("fn nested(row: ((i64, i64), i64)) -> i64 { row.0.1 }"),
    "fixture/checked_tuple_positions",
    2210
  ) {
    CheckedBodiesAccepted(product) -> {
      let zero: usize = 0
      let one: usize = 1
      let two: usize = 2
      assert_tuple_item_index(product, 0, zero)
      assert_tuple_item_index(product, 1, one)
      assert_tuple_item_index(product, 2, two)
      -- Leading zeroes stay decimal.
      assert_tuple_item_index(product, 3, one)
      assert_tuple_item_index(product, 4, one)
      let expressions = product.expressions()
      let last = product.function(2).body
      let catalog = expressions.types()
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(last)) {
          Some(graph) -> match semantic_type_graph_node(graph, expressions.result_type(last)) {
            SemanticPrimitiveNode(SemanticF64) -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_str_eq(
    checked_outcome(
      "fn wrong(row: (i64, f64)) -> i64 { row.1 }",
      "fixture/checked_tuple_position_type",
      2211
    ),
    "type_mismatch"
  )
}

test "checked tuple positions read through borrowed and unique tuples" {
  let accepted = [
    "fn read(pair: borrow (i64, i64)) -> i64 { pair.1 }",
    "fn read(pair: unique (i64, i64)) -> i64 { pair.0 + pair.1 }",
    "fn read(pair: borrow mut (i64, i64)) -> i64 { pair.0 }"
  ]
  let mut index: usize = 0
  let mut discriminator = 2220
  while index < accepted.len {
    Test.assert_str_eq(
      checked_outcome(accepted[index], "fixture/checked_tuple_view", discriminator),
      "accepted"
    )
    index = index + 1
    discriminator = discriminator + 1
  }
}

test "checked tuple positions refuse positions a tuple lacks and non-tuples" {
  Test.assert_true(
    match checked(
      "fn past(pair: (i64, i64)) -> i64 { pair.2 }",
      "fixture/checked_tuple_position_past",
      2230
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownTuplePosition(position, range)) ->
        position == 2 and range.end - range.start == 1
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn far(pair: (i64, i64)) -> i64 { pair.9223372036854775807 }",
      "fixture/checked_tuple_position_far",
      2231
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownTuplePosition(position, range)) ->
        position == 9223372036854775807 and range.end - range.start == 19
      _ -> false
    }
  )
  let non_tuples = [
    "type Point { x: i64 } fn first(point: Point) -> i64 { point.0 }",
    "fn first(row: { x: i64 }) -> i64 { row.0 }",
    "fn first(value: i64) -> i64 { value.0 }",
    "type Pair = opaque (i64, i64) fn first(pair: Pair) -> i64 { pair.0 }"
  ]
  let mut index: usize = 0
  let mut discriminator = 2232
  while index < non_tuples.len {
    Test.assert_true(
      match checked(non_tuples[index], "fixture/checked_tuple_position_non_tuple", discriminator) {
        CheckedBodiesRejected(CheckedBodyProducerTuplePositionRequiresTuple(_, range)) ->
          range.end - range.start == 1
        _ -> false
      }
    )
    index = index + 1
    discriminator = discriminator + 1
  }
  Test.assert_true(
    match checked(
      "fn named(pair: (i64, i64)) -> i64 { pair.first }",
      "fixture/checked_tuple_named_field",
      2240
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTupleNamedField(range)) ->
        range.end - range.start == 5
      _ -> false
    }
  )
}

fn rendered(function: IrFunction) -> str {
  ir_render.render_functions(
    IrFunctionCons(function, IrFunctionNil),
    IrRenderContext {
      names: map.new<i64, str>(),
      plan_text: (plan: i64) => "",
      cleanup: ir_render.no_cleanup
    },
    ""
  )
}

-- Lower function `index` of `product`, binding its first type parameter when
-- `argument` names one, and render it so a test can name the lane it returns.
fn lowered_text(
  product: CheckedBodyProduct,
  index: usize,
  argument: Option<SemanticTypeId>
) -> str {
  let symbols = checked_native_function_symbols()
    |> checked_native_function_symbols_bind(product.function(index).signature.identity, 141)
  let substitution = match argument {
    Some(concrete) -> {
      let signatures = product.signatures()
      semantic_type_substitution_bind(
        semantic_type_substitution_empty(),
        signatures.type_parameter_at(product.function(index).signature, 0),
        concrete
      )
    }
    None -> semantic_type_substitution_empty()
  }
  match lower_checked_straight_function_with_substitution(product, symbols, index, substitution) {
    CheckedStraightFunctionLowered(function) -> rendered(function)
    CheckedStraightFunctionRejected(CheckedStraightValueShapeUnavailable) -> "shape unavailable"
    _ -> "rejected"
  }
}

-- The type of parameter `parameter` of function `index`, to instantiate a
-- generic function with a type the fixture already names.
fn parameter_type(product: CheckedBodyProduct, index: usize, parameter: usize) -> SemanticTypeId {
  let expressions = product.expressions()
  let binding = expressions.function_parameter(product.function(index).parameters, parameter)
  expressions.binding(binding).value_type
}

-- A tuple item or structural field starts after the words of the fields laid
-- out before it. Those widths are fixed only once a generic function is
-- instantiated, so lowering places a projection under its substitution.
test "checked lowering places projected fields after the widths laid out before them" {
  match checked(
    "fn slice(values: [i64]) -> i64 { 0 } "
      |> str_concat("fn scalar(value: i64) -> i64 { value } ")
      |> str_concat("fn middle(row: ([i64], i64, f64)) -> i64 { row.1 } ")
      |> str_concat("fn second<A>(pair: (A, i64)) -> i64 { pair.1 } ")
      |> str_concat("fn target<T>(row: { wide: T, target: i64 }) -> i64 { row.target } ")
      |> str_concat("fn viewed<A>(pair: borrow (A, i64)) -> i64 { pair.1 } ")
      |> str_concat(
        "fn bound<T>(row: { wide: T, target: i64 }) -> i64 { match row { { wide: _, target: found } -> found } }"
      ),
    "fixture/checked_projection_placement",
    2250
  ) {
    CheckedBodiesAccepted(product) -> {
      let slice = parameter_type(product, 0, 0)
      let scalar = parameter_type(product, 1, 0)
      -- A slice spans two words.
      Test.assert_true(lowered_text(product, 2, None<SemanticTypeId>()).contains("return %2\n"))
      Test.assert_true(lowered_text(product, 3, Some(slice)).contains("return %2\n"))
      Test.assert_true(lowered_text(product, 3, Some(scalar)).contains("return %1\n"))
      -- An uninstantiated width leaves the item unplaced.
      Test.assert_str_eq(lowered_text(product, 3, None<SemanticTypeId>()), "shape unavailable")
      Test.assert_true(lowered_text(product, 5, Some(slice)).contains("return %2\n"))
      -- Structural fields are laid out by name hash, not source order.
      let target_last = "wide".hash() < "target".hash()
      let wide_target = if target_last { "return %2\n" } else { "return %0\n" }
      let narrow_target = if target_last { "return %1\n" } else { "return %0\n" }
      Test.assert_true(lowered_text(product, 4, Some(slice)).contains(wide_target))
      Test.assert_true(lowered_text(product, 4, Some(scalar)).contains(narrow_target))
      -- A record pattern's field reaches the match join from the same lane.
      let wide_join = if target_last { "jump b1(%2)\n" } else { "jump b1(%0)\n" }
      let narrow_join = if target_last { "jump b1(%1)\n" } else { "jump b1(%0)\n" }
      Test.assert_true(lowered_text(product, 6, Some(slice)).contains(wide_join))
      Test.assert_true(lowered_text(product, 6, Some(scalar)).contains(narrow_join))
    }
    _ -> Test.assert_true(false)
  }
}

fn lowered_program_text(product: CheckedBodyProduct, index: usize) -> str {
  let symbols = checked_native_function_symbols()
    |> checked_native_function_symbols_bind(product.function(0).signature.identity, 151)
    |> checked_native_function_symbols_bind(product.function(1).signature.identity, 152)
  match lower_checked_straight_function(product, symbols, index) {
    CheckedStraightFunctionLowered(function) -> rendered(function)
    _ -> "rejected"
  }
}

-- Whether the first argument of the call `function`'s body makes is published
-- with a Sendable refinement.
fn first_argument_refined(product: CheckedBodyProduct, function: usize) -> bool {
  let expressions = product.expressions()
  let root = product.function(function).body
  let catalog = expressions.types()
  let (_, arguments) = expressions.direct_call_parts(root)
  let value_type = expressions.result_type(expressions.expression_list_at(arguments, 0))
  match catalog.graph_for(value_type) {
    Some(graph) -> match semantic_type_graph_node(graph, value_type) {
      SemanticIntersectionNode(left, right) -> semantic_type_is_sendable_atom(catalog, right) or
        semantic_type_is_sendable_atom(catalog, left)
      _ -> false
    }
    None -> false
  }
}

-- A named function captures nothing, so where a Sendable function is
-- expected its reference is published refined: the value's type satisfies
-- the parameter's, generic references included.
test "checked named function values are published Sendable where required" {
  match checked(
    "fn run_i64(f: (() -> i64) & Sendable) -> i64 { f() } "
      |> str_concat("fn apply(f: ((i64) -> i64) & Sendable) -> i64 { f(1) } ")
      |> str_concat("fn one() -> i64 { 1 } fn same<T>(value: T) -> T { value } ")
      |> str_concat("fn plain(f: () -> i64) -> i64 { f() } ")
      |> str_concat("fn named() -> i64 { run_i64(one) } fn generic() -> i64 { apply(same) } ")
      |> str_concat("fn unrefined() -> i64 { plain(one) }"),
    "fixture/checked_sendable_references",
    2270
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_true(first_argument_refined(product, 5))
      Test.assert_true(first_argument_refined(product, 6))
      Test.assert_false(first_argument_refined(product, 7))
    }
    _ -> Test.assert_true(false)
  }
}

-- The rendering without semantic type labels, which name a value's type
-- rather than how it is represented.
fn without_type_labels(text: str) -> str {
  match text.find(" : t") {
    None -> text
    Some(start) -> match text.find_from("\n", start) {
      Some(end) -> without_type_labels(
        text.slice(0, start).unwrap().concat(text.slice(end, text.len()).unwrap())
      )
      None -> text.slice(0, start).unwrap()
    }
  }
}

-- `F & Sendable` narrows which function values may flow, never how one is
-- represented, called or captured: both programs lower identically. The
-- plain callee is padded so each lambda keeps the same source site.
test "checked lowering represents a Sendable function value as its function" {
  let refined_callee = "fn run(f: (() -> i64) & Sendable) -> i64 { f() } "
  let plain_callee = "fn run(f: () -> i64) -> i64 { f() } "
  let caller = "fn main() -> i64 { let base = 41 run(() => base + 1) }"
  let padding = " ".repeat(refined_callee.len() - plain_callee.len())
  match (
    checked(str_concat(refined_callee, caller), "fixture/checked_sendable_lowering", 2260),
    checked(
      plain_callee |> str_concat(padding) |> str_concat(caller),
      "fixture/checked_plain_function_lowering",
      2261
    ),
  ) {
    (CheckedBodiesAccepted(refined_product), CheckedBodiesAccepted(plain_product)) -> {
      let callee = lowered_program_text(refined_product, 0)
      let calling = lowered_program_text(refined_product, 1)
      Test.assert_true(callee != "rejected" and calling != "rejected")
      Test.assert_true(calling.contains("closure"))
      Test.assert_str_eq(
        without_type_labels(callee),
        without_type_labels(lowered_program_text(plain_product, 0))
      )
      Test.assert_str_eq(
        without_type_labels(calling),
        without_type_labels(lowered_program_text(plain_product, 1))
      )
    }
    _ -> Test.assert_true(false)
  }
}

-- A destructuring `let` binds its pattern's parts and continues with the
-- rest of the block, as a one-arm match; the parts are the value's lanes.
test "checked lowering destructures let bindings into the value's lanes" {
  match checked(
    "fn slice(values: [i64]) -> i64 { 0 } "
      |> str_concat("fn scalar(value: i64) -> i64 { value } ")
      |> str_concat(
        "fn pair(values: (i64, i64)) -> i64 { let (left, right) = values left + right } "
      )
      |> str_concat("fn second<A>(values: (A, i64)) -> i64 { let (_, right) = values right } ")
      |> str_concat(
        "fn target<T>(row: { wide: T, target: i64 }) -> i64 { let { target, wide: _ } = row target }"
      ),
    "fixture/checked_let_destructuring",
    2280
  ) {
    CheckedBodiesAccepted(product) -> {
      let slice = parameter_type(product, 0, 0)
      let scalar = parameter_type(product, 1, 0)
      Test.assert_true(
        lowered_text(product, 2, None<SemanticTypeId>()).contains("add %0, %1\n    jump b1(%3)")
      )
      -- A slice spans two words, so the item after it is lane two.
      Test.assert_true(lowered_text(product, 3, Some(slice)).contains("jump b1(%2)\n"))
      Test.assert_true(lowered_text(product, 3, Some(scalar)).contains("jump b1(%1)\n"))
      -- Structural fields are laid out by name hash, not source order.
      let target_last = "wide".hash() < "target".hash()
      let wide_join = if target_last { "jump b1(%2)\n" } else { "jump b1(%0)\n" }
      let narrow_join = if target_last { "jump b1(%1)\n" } else { "jump b1(%0)\n" }
      Test.assert_true(lowered_text(product, 4, Some(slice)).contains(wide_join))
      Test.assert_true(lowered_text(product, 4, Some(scalar)).contains(narrow_join))
    }
    _ -> Test.assert_true(false)
  }
}

-- A destructuring `for` binds each element's parts inside the loop body.
test "checked lowering destructures for bindings" {
  match checked(
    "fn total(values: [(i64, i64); 3]) -> i64 { let mut sum = 0 for (left, right) in values { sum = sum + left + right } sum }",
    "fixture/checked_for_destructuring",
    2281
  ) {
    CheckedBodiesAccepted(product) -> {
      let text = lowered_text(product, 0, None<SemanticTypeId>())
      -- Each element is read once, and its second lane is taken from it.
      Test.assert_true(text.contains("semantic index"))
      Test.assert_true(text.contains("semantic_lane"))
    }
    _ -> Test.assert_true(false)
  }
}

-- A borrowed view has its value's lanes, so `nil` and a typed arm decide
-- through it by the same sentinel; the arm binds a view of its type, which
-- stays a borrow and cannot escape as the value.
test "checked nil and typed arms discriminate through a borrow" {
  let boxes = "type Box { value: i64 } type Column { segments: Box? } "
    |> str_concat("fn size(box: borrow Box) -> i64 { box.value } ")
  let accepted = [
    "fn find(column: borrow Column) -> i64 { let { segments } = column match segments { nil -> 0 known: Box -> size(known) } }",
    "fn view(segments: borrow (Box | nil)) -> i64 { match segments { nil -> 0 known: Box -> size(known) } }",
    "fn empty(segments: borrow (Box | nil)) -> bool { match segments { nil -> true _ -> false } }"
  ]
  let mut index: usize = 0
  let mut discriminator = 2290
  while index < accepted.len {
    Test.assert_str_eq(
      checked_outcome(
        str_concat(boxes, accepted[index]),
        "fixture/checked_borrow_arms",
        discriminator
      ),
      "accepted"
    )
    index = index + 1
    discriminator = discriminator + 1
  }
  -- A shareable field is shared out of the borrowed record, so its arm is a
  -- value that may be returned.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        boxes,
        "fn share(column: borrow Column) -> Box { let { segments } = column match segments { nil -> Box { value: 0 } known: Box -> known } }"
      ),
      "fixture/checked_borrow_arm_shared",
      2295
    ),
    "accepted"
  )
  -- An arm of the borrowed parameter itself narrows the borrow and stays a
  -- view: the parameter never becomes its value.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(
        boxes,
        "fn leak(segments: borrow (Box | nil)) -> Box { match segments { nil -> Box { value: 0 } known: Box -> known } }"
      ),
      "fixture/checked_borrow_arm_escape",
      2296
    ),
    "borrow_not_value"
  )
}

-- An observer borrows its receiver. A temporary receiver is borrowed for
-- exactly its call, through a binding the call's `let` releases; a view can
-- call an observer but never a method that takes the value itself.
test "checked observers borrow named, viewed and temporary receivers" {
  let bags = "type Bag { items: i64 } type Holder { bag: Bag } "
    |> str_concat("impl Bag { fn count(self: borrow Self) -> i64 { self.items } ")
    |> str_concat("fn take(self) -> i64 { self.items } ")
    |> str_concat("fn grow(self: borrow mut Self) -> i64 { 0 } } ")
    |> str_concat("fn make() -> Bag { Bag { items: 3 } } ")
  let accepted = [
    "fn temporary() -> i64 { make().count() }",
    "fn twice() -> i64 { make().count() + make().count() }",
    "fn named() -> i64 { let bag = make() bag.count() }",
    "fn viewed(holder: borrow Holder) -> i64 { holder.bag.count() }",
    "fn passed(bag: borrow Bag) -> i64 { bag.count() }",
    "fn consumed() -> i64 { make().take() }"
  ]
  let mut index: usize = 0
  let mut discriminator = 2300
  while index < accepted.len {
    Test.assert_str_eq(
      checked_outcome(
        str_concat(bags, accepted[index]),
        "fixture/checked_receivers",
        discriminator
      ),
      "accepted"
    )
    index = index + 1
    discriminator = discriminator + 1
  }
  -- An owned temporary is owned by the binding and dropped after the call.
  Test.assert_str_eq(
    checked_outcome_with_drop(
      "type Token { value: i64 } impl Drop for Token { } "
        |> str_concat("impl Token { fn peek(self: borrow Self) -> i64 { self.value } } ")
        |> str_concat("fn open() -> owned Token { Token { value: 1 } } ")
        |> str_concat("fn look() -> i64 { open().peek() }"),
      "fixture/checked_receiver_owned_temporary",
      2309
    ),
    "accepted"
  )
  -- A shareable part is shared into a plain `self`; the borrowed parameter
  -- itself never becomes the value a plain `self` receives.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(bags, "fn viewed(holder: borrow Holder) -> i64 { holder.bag.take() }"),
      "fixture/checked_receiver_part_value",
      2310
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(bags, "fn passed(bag: borrow Bag) -> i64 { bag.take() }"),
      "fixture/checked_receiver_view_value",
      2312
    ),
    "borrow_not_value"
  )
  -- Only a shared borrow may take a temporary; `borrow mut` needs an owner.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(bags, "fn mutated() -> i64 { make().grow() }"),
      "fixture/checked_receiver_temporary_mut",
      2311
    ),
    "type_mismatch"
  )
}

-- The temporary a borrowing call observes lowers exactly as a named binding
-- would: bound, observed by the call, and released only after it.
fn lowered_calling_text(program: str, discriminator: i64) -[Test]> str {
  match checked(program, "fixture/checked_temporary_receiver_lowering", discriminator) {
    CheckedBodiesAccepted(product) -> {
      let mut symbols = checked_native_function_symbols()
      let mut index: usize = 0
      let mut symbol: i64 = 161
      while index < product.function_count() {
        symbols = checked_native_function_symbols_bind(
          symbols,
          product.function(index).signature.identity,
          symbol
        )
        index = index + 1
        symbol = symbol + 1
      }
      let mut found = "missing"
      index = 0
      while index < product.function_count() {
        let text = match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> rendered(function)
          _ -> "rejected"
        }
        if text.contains("semantic_call") { found = text }
        index = index + 1
      }
      found
    }
    _ -> "unchecked"
  }
}

test "checked lowering binds a temporary receiver as a named one" {
  let bag = "type Bag { items: i64 } impl Bag { fn count(self: borrow Self) -> i64 { self.items } } "
    |> str_concat("fn make() -> Bag { Bag { items: 3 } } ")
  let temporary = lowered_calling_text(
    str_concat(bag, "fn observe() -> i64 { make().count() }"),
    2312
  )
  let named = lowered_calling_text(
    str_concat(bag, "fn observe() -> i64 { let bag = make() bag.count() }"),
    2313
  )
  Test.assert_str_eq(temporary, named)
  let call = temporary.find("semantic_call Bag.count")
  let release = temporary.find("release.rc")
  Test.assert_true(
    match (call, release) {
      (Some(at), Some(after)) -> at < after
      _ -> false
    }
  )
}

test "checked body producer publishes generic declared field projections" {
  match checked(
    "type Box<T> { wide: [T], target: T } "
      |> str_concat(
        "fn project(row: Box<i64>) -> i64 { row.target } "
      )
      |> str_concat("fn view(row: Box<i64>) -> i64 { row.wide[0] }"),
    "fixture/checked_body_nominal_field",
    138
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let target = product.function(0).body
      let view = product.function(1).body
      Test.assert_true(
        match expressions.kind(target) {
          CheckedDeclaredFieldAccessKind -> match expressions.declared_field_access_parts(
            target
          ) {
            (base, declaration, field_index) ->
              field_index == 1 and
              declaration_identity_name(declaration).text().unwrap() == "target" and
              match expressions.kind(base) {
                CheckedLocalReferenceKind -> true
                _ -> false
              }
          }
          _ -> false
        }
      )
      let field = match expressions.indexed_get_parts(view) {
        CheckedIndexedGet(base, _, _, _) -> base
      }
      Test.assert_true(
        match expressions.kind(field) {
          CheckedDeclaredFieldAccessKind -> match expressions.declared_field_access_parts(field) {
            (_, _, field_index) -> field_index == 0
          }
          _ -> false
        }
      )
      let catalog = expressions.types()
      let declarations = product.declarations()
      let parameter = expressions.function_parameter(product.function(0).parameters, 0)
      let row_type = expressions.binding(parameter).value_type
      Test.assert_true(
        match semantic_type_slice_containment(catalog, declarations, row_type) {
          SemanticContainsSlice -> true
          _ -> false
        }
      )
      let empty_substitution = semantic_type_substitution_empty()
      Test.assert_true(
        match semantic_type_declaration_catalog_resolve(
          catalog,
          declarations,
          row_type,
          empty_substitution
        ) {
          SemanticRecordDeclarationLayoutMatched(layout, _) ->
            match
            semantic_type_declared_record_field_count(declarations, layout) {
              Some(count) -> count == 2
              _ -> false
            }
          _ -> false
        }
      )
      let result = expressions.result_type(field)
      Test.assert_true(
        match catalog.graph_for(result) {
          Some(graph) -> match semantic_type_graph_node(graph, result) {
            SemanticSliceNode(element, _) -> match catalog.graph_for(element) {
              Some(element_graph) -> match semantic_type_graph_node(element_graph, element) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic containment instantiates generic nominal field types" {
  match checked(
    "type Box<T> { value: T } fn read_slice(row: Box<[i64]>) -> i64 { row.value[0] } "
      |> str_concat("fn read_i64(row: Box<i64>) -> i64 { row.value }"),
    "fixture/checked_body_generic_slice_containment",
    1197
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let catalog = expressions.types()
      let declarations = product.declarations()
      let slice_parameter = expressions.function_parameter(product.function(0).parameters, 0)
      let scalar_parameter = expressions.function_parameter(product.function(1).parameters, 0)
      Test.assert_true(
        match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(slice_parameter).value_type
