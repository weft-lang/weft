-- The containment of each function's first parameter, in declaration order.
fn parameter_containments(source: str, name: str, discriminator: i64) -[Test]> List<str> {
  match checked(source, name, discriminator) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let catalog = expressions.types()
      let declarations = product.declarations()
      let mut found = Nil<str>()
      let mut index = product.function_count()
      while index > 0 {
        index = index - 1
        let parameter = expressions.function_parameter(product.function(index).parameters, 0)
        let label = match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(parameter).value_type
        ) {
          SemanticContainsSlice -> "contains"
          SemanticDoesNotContainSlice -> "none"
          SemanticSliceContainmentUnknown -> "unknown"
        }
        found = found.prepend(label)
      }
      found
    }
    _ -> Nil<str>().prepend("rejected")
  }
}

fn containment_label(containment: SemanticSliceContainment) -> str {
  match containment {
    SemanticContainsSlice -> "contains"
    SemanticDoesNotContainSlice -> "none"
    SemanticSliceContainmentUnknown -> "unknown"
  }
}

-- The containment of each function's first parameter through one set of
-- declaration summaries, visiting the functions forwards or backwards, and
-- listed in declaration order.
fn shared_parameter_containments(
  source: str,
  name: str,
  discriminator: i64,
  backwards: bool
) -[Test]> List<str> {
  match checked(source, name, discriminator) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let catalog = expressions.types()
      let declarations = product.declarations()
      let count = product.function_count()
      let mut labels = Nil<str>()
      let mut shapes = semantic_slice_shapes()
      let mut step: usize = 0
      while step < count {
        let index = if backwards { count - 1 - step } else { step }
        let parameter = expressions.function_parameter(product.function(index).parameters, 0)
        let (next, containment) = semantic_slice_shapes_containment(
          shapes,
          catalog,
          declarations,
          expressions.binding(parameter).value_type
        )
        shapes = next
        labels = labels.prepend(containment_label(containment))
        step = step + 1
      }
      -- Visiting backwards prepends in declaration order.
      if backwards { labels } else { labels.reverse() }
    }
    _ -> Nil<str>().prepend("rejected")
  }
}

fn joined(values: List<str>) -> str {
  match values {
    Nil -> ""
    Cons(value, Nil) -> value
    Cons(value, rest) -> value |> str_concat(",") |> str_concat(joined(rest))
  }
}

test "semantic containment closes mutually recursive declarations" {
  Test.assert_str_eq(
    joined(
      parameter_containments(
        "type Tree<T> { Node(T, Forest<T>) } "
          |> str_concat("type Forest<T> { Bare, Grove(Tree<T>, Forest<T>) } ")
          |> str_concat("fn scalar(x: Tree<i64>) -> i64 { 0 } ")
          |> str_concat("fn view(x: Forest<[i64]>) -> i64 { 0 }"),
        "fixture/checked_body_mutual_slice_containment",
        1971
      )
    ),
    "none,contains"
  )
  -- An argument no field reaches cannot carry a slice in.
  Test.assert_str_eq(
    joined(
      parameter_containments(
        "type Tag<T> { Marked(i64) } type Slot<T> { held: T } "
          |> str_concat("fn phantom(x: Tag<[i64]>) -> i64 { 0 } ")
          |> str_concat("fn held(x: Slot<Tag<[i64]>>) -> i64 { 0 }"),
        "fixture/checked_body_phantom_slice_containment",
        1972
      )
    ),
    "none,none"
  )
}

-- Each refused function of a module as `name:category`, in survey order.
fn surveyed(text: str, discriminator: i64) -[Test]> List<str> {
  let parsed = parse(text)
  let module = registration.register(
    parsed.declarations,
    parsed.source.source(),
    named_module_identity("fixture/checked_body_survey", discriminator)
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let refused = handle check_registered_bodies_survey(
        module,
        scope,
        resolution,
        discriminator
      ) {
        SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
      }
      refused.map<str>(
        (rejection: CheckedBodyRejection) => {
          let name = match rejection.function {
            DeclaredFunctionIdentity(declaration) ->
              declaration_identity_name(declaration).text().unwrap()
            _ -> "<module>"
          }
          -- The innermost failing expression's text, when the survey kept it.
          let failing = match rejection.location {
            Some(range) -> match parsed.source.source().span(range.start, range.end) {
              Some(span) -> span.text().unwrap_or("?")
              None -> "?"
            }
            None -> "-"
          }
          name
            |> str_concat(":")
            |> str_concat(checked_body_producer_issue_category(rejection.issue))
            |> str_concat("@")
            |> str_concat(failing)
        }
      )
    }
    _ -> panic("expected resolved signatures")
  }
}

test "a survey reports every refused function and agrees with the first rejection" {
  -- Refused functions do not stop the survey, and accepted functions between
  -- and after them are not reported.
  let mixed = "fn first() -> i64 { missing_name } "
    |> str_concat("fn fine(value: i64) -> i64 { value + 1 } ")
    |> str_concat("fn second() -> i64 { \"text\" } ")
    |> str_concat("fn also_fine() -> bool { true } ")
    |> str_concat("fn third(flag: bool) -> i64 { flag + 1 }")
  Test.assert_str_eq(
    joined(surveyed(mixed, 1991)),
    r#"first:unknown_identifier@missing_name,second:type_mismatch@"text",third:numeric_operand_required@flag + 1"#
  )
  -- The single-rejection check reports the survey's first entry.
  Test.assert_str_eq(producer_outcome(mixed, 1992), "unknown_identifier")
  -- A later function is checked as if it stood alone: a name bound only in a
  -- refused function is not in scope, and its own failure is its own.
  Test.assert_str_eq(
    joined(
      surveyed(
        "fn broken() -> i64 { let local = 1 local + missing } fn after() -> i64 { local }",
        1993
      )
    ),
    "broken:unknown_identifier@missing,after:unknown_identifier@local"
  )
  -- An accepted module surveys empty, and so does an empty module.
  Test.assert_str_eq(joined(surveyed("fn only() -> i64 { 1 }", 1994)), "")
  Test.assert_str_eq(joined(surveyed("type Lonely { value: i64 }", 1995)), "")
  -- A module whose every function is refused reports each once.
  Test.assert_str_eq(
    joined(surveyed("fn a() -> i64 { x } fn b() -> i64 { y } fn c() -> i64 { z }", 1996)),
    "a:unknown_identifier@x,b:unknown_identifier@y,c:unknown_identifier@z"
  )
}

test "a shareable part read through a borrow may be used as the value" {
  let prelude = "type Inner { value: i64 } type Label { text: str, inner: Inner } "
    |> str_concat("type Box { inner: Inner, label: Label, count: i64, pair: (Inner, i64) } ")
    |> str_concat("type Held { Holding(Inner), Empty } ")
    |> str_concat("type Maybe { present: Inner? } ")
    |> str_concat("fn keep(inner: Inner) -> i64 { 0 } ")
    |> str_concat("fn look(inner: borrow Inner) -> i64 { inner.value } ")
  -- Ordinary immutable data is shared: returned, passed, bound or matched.
  let accepted = [
    "fn run(box: borrow Box) -> Inner { box.inner }",
    "fn run(box: borrow Box) -> i64 { keep(box.inner) }",
    "fn run(box: borrow Box) -> i64 { let inner: Inner = box.inner inner.value }",
    "fn run(box: borrow Box) -> Label { box.label }",
    "fn run(box: borrow Box) -> Inner { box.label.inner }",
    "fn run(box: borrow Box) -> str { box.label.text }",
    "fn run(box: borrow Box) -> Inner { box.pair.0 }",
    "fn run(box: borrow Box) -> Inner { let { inner } = box inner }",
    "fn run(held: borrow Held) -> Inner { match held { Holding(inner) -> inner, Empty -> Inner { value: 0 } } }",
    "fn run(maybe: borrow Maybe) -> Inner { let { present } = maybe match present { nil -> Inner { value: 0 } found: Inner -> found } }",
    -- A scalar part reads as itself, and a part may still be only observed.
    "fn run(box: borrow Box) -> i64 { box.count }",
    "fn run(box: borrow Box) -> i64 { box.inner.value }",
    "fn run(box: borrow Box) -> i64 { look(box.inner) }",
    "fn run(box: borrow Box) -> i64 { let inner = box.inner look(inner) + keep(inner) }"
  ]
  let mut discriminator = 2021
  for program in list.from_slice(accepted[..]) {
    Test.assert_str_eq(producer_outcome(str_concat(prelude, program), discriminator), "accepted")
    discriminator = discriminator + 1
  }
  -- A generic declaration is as shareable as its arguments: its own type
  -- parameters stand for them.
  let chains = "type Chain<T> { Link(T, Chain<T>), End } type Shelf { items: Chain<Inner> } "
  Test.assert_str_eq(
    producer_outcome(
      prelude
        |> str_concat(chains)
        |> str_concat("fn run(shelf: borrow Shelf) -> Chain<Inner> { shelf.items }"),
      2039
    ),
    "accepted"
  )
  -- The borrowed parameter itself never becomes its value.
  Test.assert_str_eq(
    producer_outcome(str_concat(prelude, "fn run(box: borrow Box) -> Box { box }"), 2040),
    "borrow_not_value"
  )
  -- A part whose type could be anything is not known to be shareable.
  Test.assert_str_eq(
    producer_outcome(
      "type Slot<T> { held: T } fn run<T>(slot: borrow Slot<T>) -> T { slot.held }",
      2041
    ),
    "borrow_not_value"
  )
  -- A view of some other type is an ordinary mismatch.
  Test.assert_str_eq(
    producer_outcome(str_concat(prelude, "fn run(box: borrow Box) -> i64 { box.inner }"), 2042),
    "type_mismatch"
  )
}

test "a part holding a resource or a mutable container stays a view" {
  let prelude = "type Token { value: i64 } impl Drop for Token { fn drop(self) -> nil { nil } } "
    |> str_concat("type Plain { value: i64 } ")
    |> str_concat("type Keeper { token: owned Token, plain: Plain } ")
    |> str_concat("type Outer { keeper: Keeper, plain: Plain } ")
    |> str_concat("type Carry { Carrying(owned Token), Idle } ")
    |> str_concat("fn peek(token: borrow Token) -> i64 { token.value } ")
  -- An owned part, and any part that holds one however deep, is never shared.
  let refused = [
    "fn run(keeper: borrow Keeper) -> owned Token { keeper.token }",
    "fn run(outer: borrow Outer) -> Keeper { outer.keeper }",
    "fn run(outer: borrow Outer) -> i64 { let kept: Keeper = outer.keeper 0 }",
    "fn run(carry: borrow Carry) -> owned Token { match carry { Carrying(token) -> token, Idle -> Token { value: 0 } } }"
  ]
  let mut discriminator = 2051
  for program in list.from_slice(refused[..]) {
    Test.assert_str_eq(
      producer_outcome_with_drop(str_concat(prelude, program), discriminator),
      "borrow_not_value"
    )
    discriminator = discriminator + 1
  }
  -- A generic declaration applied to a type that holds a resource is not
  -- shareable either.
  Test.assert_str_eq(
    producer_outcome_with_drop(
      prelude
        |> str_concat(
          "type Chain<T> { Link(T, Chain<T>), End } type Shelf { items: Chain<Keeper> } "
        )
        |> str_concat("fn run(shelf: borrow Shelf) -> Chain<Keeper> { shelf.items }"),
      2069
    ),
    "borrow_not_value"
  )
  -- The shareable parts beside a resource are shared, and the resource is
  -- still observed through the borrow.
  let accepted = [
    "fn run(keeper: borrow Keeper) -> Plain { keeper.plain }",
    "fn run(outer: borrow Outer) -> Plain { outer.keeper.plain }",
    "fn run(keeper: borrow Keeper) -> i64 { peek(keeper.token) }",
    "fn run(carry: borrow Carry) -> i64 { match carry { Carrying(token) -> peek(token), Idle -> 0 } }"
  ]
  for program in list.from_slice(accepted[..]) {
    Test.assert_str_eq(
      producer_outcome_with_drop(str_concat(prelude, program), discriminator),
      "accepted"
    )
    discriminator = discriminator + 1
  }
  -- A mutable container is not shared out of a borrowed record.
  Test.assert_str_eq(
    match checked_with_vector(
      "use stdlib/vector/handles.{Vector} "
        |> str_concat("type Rows { values: Vector<i64>, count: i64 } ")
        |> str_concat("fn run(rows: borrow Rows) -> Vector<i64> { rows.values }"),
      "fixture/checked_body_borrowed_container",
      2071
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
    },
    "borrow_not_value"
  )
}

test "an array literal of equal element types has that element type" {
  let prelude = "type Chain<T> { Link(T, Chain<T>), End } "
    |> str_concat("fn from_slice<T>(values: [T]) -> Chain<T> { End } ")
    |> str_concat("type Entry { Entry(str, i64) } ")
    |> str_concat("fn make(key: str, value: i64) -> Entry { Entry(key, value) } ")
    |> str_concat("fn take(entries: Chain<Entry>) -> i64 { 0 } ")
    |> str_concat("fn take_scalars(values: Chain<i64>) -> i64 { 0 } ")
  -- Equal element types are one type, however many elements there are, so
  -- the element type instantiates a generic parameter exactly.
  let accepted = [
    "fn run() -> i64 { let fields = [make(\"a\", 1)] take(from_slice(fields[..])) }",
    "fn run() -> i64 { let fields = [make(\"a\", 1), make(\"b\", 2)] take(from_slice(fields[..])) }",
    "fn run() -> i64 { let fields = [make(\"a\", 1), make(\"b\", 2), make(\"c\", 3)] take(from_slice(fields[..])) }",
    "fn run() -> i64 { let values = [1, 2, 3] take_scalars(from_slice(values[..])) }",
    "fn run() -> i64 { let values = [1, 2] let same: [i64; 2] = values same[0] }",
    -- A diverging element contributes nothing to the element type.
    "fn stop() -> never { loop { } } fn run() -> i64 { let values = [1, stop()] take_scalars(from_slice(values[..])) }"
  ]
  let mut discriminator = 2001
  for program in list.from_slice(accepted[..]) {
    Test.assert_str_eq(producer_outcome(str_concat(prelude, program), discriminator), "accepted")
    discriminator = discriminator + 1
  }
  -- Different element types still join to their union, which is not either.
  Test.assert_str_eq(
    producer_outcome(
      str_concat(
        prelude,
        "fn run() -> i64 { let mixed = [1, \"one\"] take_scalars(from_slice(mixed[..])) }"
      ),
      2011
    ),
    "type_mismatch"
  )
}

test "a nominal record literal checks each field against its declaration" {
  let census = "type Census { scalar: usize, wide: f64 } "
  -- A field's type is declared, so a literal adopts it with or without a
  -- contextual record type.
  let accepted = [
    "fn run() -> usize { let empty = Census { scalar: 0, wide: 1.5 } empty.scalar }",
    "fn run() -> Census { Census { scalar: 0, wide: 1.5 } }",
    "fn run() -> usize { let annotated: Census = Census { scalar: 7, wide: 0.5 } annotated.scalar }"
  ]
  let mut discriminator = 1981
  for program in list.from_slice(accepted[..]) {
    Test.assert_str_eq(producer_outcome(str_concat(census, program), discriminator), "accepted")
    discriminator = discriminator + 1
  }
  -- A value of another type is refused in either position.
  let refused = [
    "fn run() -> usize { let bad = Census { scalar: \"no\", wide: 1.5 } bad.scalar }",
    "fn run() -> Census { Census { scalar: 0, wide: true } }"
  ]
  for program in list.from_slice(refused[..]) {
    Test.assert_str_eq(
      producer_outcome(str_concat(census, program), discriminator),
      "type_mismatch"
    )
    discriminator = discriminator + 1
  }
  -- A generic record still infers its argument from its fields.
  Test.assert_str_eq(
    producer_outcome(
      "type Slot<T> { held: T } fn run() -> i64 { let slot = Slot { held: 1 } slot.held }",
      1990
    ),
    "accepted"
  )
}

test "shared declaration summaries answer every later query exactly" {
  -- Each query settles every declaration it reaches, including those that
  -- hold no slice; a later query reusing them must agree with a fresh one.
  let source = "type Tree<T> { Node(T, Forest<T>) } "
    |> str_concat("type Forest<T> { Bare, Grove(Tree<T>, Forest<T>) } ")
    |> str_concat("type Tag<T> { Marked(i64) } type Slot<T> { held: T } ")
    |> str_concat("type Pair<A, B> { first: A, second: B } ")
    |> str_concat("fn scalar(x: Tree<i64>) -> i64 { 0 } ")
    |> str_concat("fn view(x: Forest<[i64]>) -> i64 { 0 } ")
    |> str_concat("fn tree_view(x: Tree<[i64]>) -> i64 { 0 } ")
    |> str_concat("fn phantom(x: Slot<Tag<[i64]>>) -> i64 { 0 } ")
    |> str_concat("fn late(x: Pair<Tag<i64>, Slot<[i64]>>) -> i64 { 0 } ")
    |> str_concat("fn early(x: Pair<Forest<i64>, Tag<[i64]>>) -> i64 { 0 }")
  let expected = "none,contains,contains,none,contains,none"
  let name = "fixture/checked_body_shared_slice_containment"
  Test.assert_str_eq(joined(parameter_containments(source, name, 1973)), expected)
  Test.assert_str_eq(joined(shared_parameter_containments(source, name, 1974, false)), expected)
  Test.assert_str_eq(joined(shared_parameter_containments(source, name, 1975, true)), expected)
}

test "semantic containment follows structural record fields" {
  match checked(
    "fn scalar(x: { value: i64 }) -> i64 { x.value } "
      |> str_concat("fn view(x: { value: [i64] }) -> i64 { x.value[0] }"),
    "fixture/checked_body_structural_slice_containment",
    1199
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let catalog = expressions.types()
      let declarations = product.declarations()
      let scalar = expressions.function_parameter(product.function(0).parameters, 0)
      let view = expressions.function_parameter(product.function(1).parameters, 0)
      Test.assert_true(
        match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(scalar).value_type
        ) {
          SemanticDoesNotContainSlice -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(view).value_type
        ) {
          SemanticContainsSlice -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

