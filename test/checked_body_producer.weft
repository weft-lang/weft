test "checked body producer owns decoded string literal values" {
  match checked(
    "fn escaped() -> str { \"line\\nnext\" } fn empty() -> str { \"\" }",
    "fixture/checked_body_strings",
    127
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let escaped = product.function(0).body
      let empty = product.function(1).body
      Test.assert_true(
        match expressions.kind(escaped) {
          CheckedStringKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(expressions.string_value(escaped), "line\nnext")
      Test.assert_str_eq(expressions.string_value(empty), "")
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer owns exact float literal lanes" {
  match checked(
    "fn wide() -> f64 { 1.25 } fn narrow() -> f32 { 0.1 } fn sum() -> f32 { 1.25 + 2.5 }",
    "fixture/checked_body_floats",
    128
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let wide = product.function(0).body
      let narrow = product.function(1).body
      let sum = product.function(2).body
      let catalog = expressions.types()
      Test.assert_true(
        match expressions.kind(wide) {
          CheckedFloatKind -> true
          _ -> false
        }
      )
      Test.assert_eq_f64(expressions.float_value(wide), 1.25)
      Test.assert_eq_f64(
        expressions.float_value(narrow),
        __f32_to_f64(__f64_to_f32(0.1))
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(wide)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(wide)
          ) {
            SemanticPrimitiveNode(SemanticF64) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(narrow)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(narrow)
          ) {
            SemanticPrimitiveNode(SemanticF32) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_left(sum)),
          expressions.result_type(narrow)
        ) and semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_right(sum)),
          expressions.result_type(narrow)
        )
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes exhaustive scalar matches" {
  match checked(
    "fn choose(value: bool) -> i64 { match value { true -> 1 false -> 2 } } fn numeric(value: i64) -> i64 { match value { 0 -> 3 _ -> 4 } } fn nothing(value: nil) -> nil { match value { nil -> nil } }",
    "fixture/checked_body_scalar_matches",
    129
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      let boolean_root = product.function(0).body
      let numeric_root = product.function(1).body
      let nil_root = product.function(2).body
      Test.assert_true(
        match expressions.kind(boolean_root) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      )
      match expressions.match_parts(boolean_root) {
        (CheckedExplicitMatch, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
          let first = patterns.match_arm_list_at(arms, 0)
          let second = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.kind(first.pattern) {
              CheckedIntegerPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(first.pattern) {
              (1, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(second.pattern) {
              (0, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
      match expressions.match_parts(numeric_root) {
        (_, _, arms) -> {
          let literal = patterns.match_arm_list_at(arms, 0)
          let fallback = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.integer_parts(literal.pattern) {
              (0, CheckedNumericPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.kind(fallback.pattern) {
              CheckedWildcardPatternKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(nil_root) {
        (_, _, arms) -> Test.assert_true(
          match patterns.kind(patterns.match_arm_list_at(arms, 0).pattern) {
            CheckedNilPatternKind -> true
            _ -> false
          }
        )
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked match arms retain bindings guards and lexical scope" {
  match checked(
    "fn choose(value: bool, enabled: bool) -> i64 { match value { true if enabled -> 1 true -> 2 false -> 3 } } fn identity(value: i64) -> i64 { match value { captured -> captured } }",
    "fixture/checked_body_match_arms",
    130
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 3)
          let guarded = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match guarded.guard {
              CheckedGuarded(guard) -> match expressions.kind(guard) {
                CheckedLocalReferenceKind -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.match_arm_list_at(arms, 1).guard {
              CheckedUnguarded -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedBindingPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(arm.pattern),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

