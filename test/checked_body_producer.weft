}

test "checked body producer retains structural and tuple literal fields" {
  match checked(
    "fn make() -> { x: i64, y: bool } { { x: 1, y: true } }",
    "fixture/checked_body_structural_literal",
    1201
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(match expressions.kind(root) { CheckedRecordInitKind -> true, _ -> false })
      match expressions.record_init_parts(root) {
        (CheckedStructuralRecordConstruction, fields) -> {
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(1) -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(first.value) { CheckedIntegerKind -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(second.value) { CheckedBooleanKind -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
      let range = expressions.range(root)
      Test.assert_eq_usize(range.end - range.start, 17)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "fn make() -> (i64, bool) { (1, true) }",
    "fixture/checked_body_tuple_literal",
    1202
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      match expressions.record_init_parts(root) {
        (CheckedTupleRecordConstruction, fields) -> {
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(1) -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn make() -> () { () }",
      "fixture/checked_body_empty_tuple_literal",
      1203
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_init_parts(product.function(0).body) {
          (CheckedTupleRecordConstruction, fields) -> expressions.record_field_list_len(fields) ==
            0
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn make() -> { } { { } }",
      "fixture/checked_body_empty_structural_literal",
      1204
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_init_parts(product.function(0).body) {
          (CheckedStructuralRecordConstruction, fields) ->
            expressions.record_field_list_len(fields) == 0
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn pair<T>(left: T, right: i64) -> { first: T, second: i64 } { "
    |> str_concat("{ first: left, second: right } }"),
      "fixture/checked_body_generic_structural_literal",
      1205
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn make() -> { x: i64, y: bool } { { y: true, x: 1 } }",
      "fixture/checked_body_reordered_structural_literal",
      1208
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_init_parts(product.function(0).body) {
          (CheckedStructuralRecordConstruction, fields) ->
            match expressions.kind(expressions.record_field_list_at(fields, 0).value) {
              CheckedBooleanKind -> true
              _ -> false
            }
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn make() -> { outer: { x: i64 } } { { outer: { x: 1 } } }",
      "fixture/checked_body_nested_structural_literal",
      1209
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer retains declared record construction" {
  match checked(
    "type Point { x: i64, y: bool } fn make() -> Point { Point { y: true, x: 1 } }",
    "fixture/checked_body_declared_record",
    1210
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      match expressions.record_init_parts(root) {
        (CheckedDeclaredRecordConstruction(_), fields) -> {
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(match first.kind { CheckedDeclaredRecordField -> true, _ -> false })
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(1) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer resolves explicit and inferred generic record arguments" {
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn make() -> Box<str> { Box<str> { value: \"hello\" } }",
      "fixture/checked_body_explicit_record",
      1211
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_init_parts(product.function(0).body) {
          (CheckedDeclaredRecordConstruction(_), _) -> true
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn make() -> Box<str> { let box = Box { value: \"hello\" }; box }",
      "fixture/checked_body_inferred_record",
      1212
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn make() -> Box<str> { Box { value: \"hello\" } }",
      "fixture/checked_body_contextual_record",
      1213
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: { item: T } } fn make() -> Box<i64> { "
    |> str_concat("let box = Box { value: { item: 1 } }; box }"),
      "fixture/checked_body_nested_record_inference",
      1226
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer retains structural update fields and result shape" {
  match checked(
    "fn make(base: { z: i64, a: bool }) -> { z: str, a: bool, extra: i64 } { "
    |> str_concat("base.{ z: \"new\", extra: 3 } }"),
    "fixture/checked_body_structural_update",
    1230
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) { CheckedRecordUpdateKind -> true, _ -> false }
      )
      match expressions.record_update_parts(root) {
        (base, fields) -> {
          Test.assert_true(
            match expressions.kind(base) { CheckedLocalReferenceKind -> true, _ -> false }
          )
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(match first.kind { CheckedStructuralRecordField -> true, _ -> false })
          Test.assert_eq(first.stable_key, "z".hash())
          Test.assert_eq(second.stable_key, "extra".hash())
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(2) -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(first.value) { CheckedStringKind -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(second.value) { CheckedIntegerKind -> true, _ -> false }
          )
        }
      }
      let range = expressions.range(root)
      Test.assert_eq_usize(range.end - range.start, 27)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn make(base: { x: i64 }) -> { x: i64 } { base.{} }",
      "fixture/checked_body_empty_structural_update",
      1231
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_update_parts(product.function(0).body) {
          (_, fields) -> expressions.record_field_list_len(fields) == 0
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn make(base: {}) -> { x: i64 } { base.{ x: 1 } }",
      "fixture/checked_body_update_empty_base",
      1242
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_update_parts(product.function(0).body) {
          (_, fields) -> expressions.record_field_list_len(fields) == 1
        }
      }
      _ -> false
    }
  )
}

test "checked body producer retains nominal generic updates" {
  match checked(
    "type Box<T> { value: T, flag: bool } "
    |> str_concat("fn make(base: Box<str>) -> Box<str> { base.{ value: \"new\" } }"),
