  Test.assert_true(
    match checked(
      "fn bad() -> i64 { (1)(2) }",
      "fixture/checked_body_apply_nonfunction",
      1152
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCallableRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked expression application checks arity" {
  Test.assert_true(
    match checked(
      "fn bad(f: (i64) -> i64) -> i64 { (f)() }",
      "fixture/checked_body_apply_arity",
      1153
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
