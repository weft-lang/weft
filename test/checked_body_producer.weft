test "checked generic calls retain ordered type arguments and specialized result" {
  match checked(
    "fn identity<T>(value: T) -> T { value } fn caller() -> i64 { identity<i64>(5) }",
    "fixture/checked_body_generic_call",
    1161
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedGenericCallKind -> true
          _ -> false
        }
      )
      match expressions.generic_call_parts(root) {
        (call, arguments) -> {
          Test.assert_true(
            match expressions.kind(call) {
              CheckedDirectCallKind -> true
              _ -> false
            }
          )
          Test.assert_eq_usize(expressions.type_list_len(arguments), 1)
          let catalog = expressions.types()
          let argument = expressions.type_list_at(arguments, 0)
          Test.assert_true(
            semantic_type_catalog_equal(catalog, argument, expressions.result_type(root))
          )
          Test.assert_true(
            match catalog.graph_for(argument) {
              Some(graph) -> match semantic_type_graph_node(graph, argument) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked generic calls preserve two argument identities in declaration order" {
  match checked(
    "fn choose<A, B>(left: A, right: B) -> B { right } fn caller() -> bool { choose<i64, bool>(5, true) }",
    "fixture/checked_body_generic_order",
    1167
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      match expressions.generic_call_parts(root) {
        (_, arguments) -> {
          Test.assert_eq_usize(expressions.type_list_len(arguments), 2)
          let catalog = expressions.types()
          let first = expressions.type_list_at(arguments, 0)
          let second = expressions.type_list_at(arguments, 1)
          Test.assert_true(
            match catalog.graph_for(first) {
              Some(graph) -> match semantic_type_graph_node(graph, first) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            semantic_type_catalog_equal(catalog, second, expressions.result_type(root))
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn identity<T>(value: T) -> T { value } fn forward<U>(value: U) -> U { identity<U>(value) }",
      "fixture/checked_body_generic_owner_argument",
      1170
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

