}

test "checked deferred continuation calls require explicit consumer parameters" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> i64 { k(1) + k(2) }",
      "fixture/checked_body_continuation_consumer_twice",
      182
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyFunctionContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
        |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
        |> str_concat(
          "fn consume(k: Continuation<i64, i64>) -> i64 { k(3) } "
        )
        |> str_concat(
          "fn okay() -> i64 { handle read() { Pause.get() with k -> consume(k) } }"
        ),
      "fixture/checked_body_explicit_continuation_consumer",
      176
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
        |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
        |> str_concat("fn erase(value: any) -> i64 { 0 } ")
        |> str_concat(
          "fn bad() -> i64 { handle read() { Pause.get() with k -> erase(k) } }"
        ),
      "fixture/checked_body_continuation_any_escape",
      177
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
        |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
        |> str_concat("type Box { value: i64 } ")
        |> str_concat(
          "impl Box { fn consume(self, k: Continuation<i64, i64>) -> i64 { k(4) } } "
        )
        |> str_concat(
          "fn okay(box: Box) -> i64 { handle read() { Pause.get() with k -> box.consume(k) } }"
        ),
      "fixture/checked_body_method_continuation_consumer",
      178
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
        |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
        |> str_concat("type Box { value: i64 } ")
        |> str_concat("impl Box { fn erase(self, value: any) -> i64 { 0 } } ")
        |> str_concat(
          "fn bad(box: Box) -> i64 { handle read() { Pause.get() with k -> box.erase(k) } }"
        ),
      "fixture/checked_body_method_continuation_any_escape",
      179
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
        |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
        |> str_concat("type Holder<T> { value: i64 } ")
        |> str_concat("impl<T> Holder<T> { fn erase(self, value: T) -> i64 { 0 } } ")
        |> str_concat(
          "fn bad(holder: Holder<Continuation<i64, i64>>) -> i64 { "
        )
        |> str_concat("handle read() { Pause.get() with k -> holder.erase(k) } }"),
      "fixture/checked_body_generic_method_continuation_escape",
      180
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked deferred continuation helper results retain the same one-shot obligation" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { "
        |> str_concat("match true { true -> k false -> nil } }"),
      "fixture/checked_body_continuation_match_erasure",
