      |> str_concat("fn plain() -> i64 { add_one(4) } ")
      |> str_concat("fn generic() -> str { identity<str>(\"ok\") } ")
      |> str_concat("fn inferred() -> i64 { identity(7) } ")
      |> str_concat("fn reference() -> (i64) -> i64 { add_one }"),
    named_module_identity("fixture/imported_functions_consumer", 1241)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
