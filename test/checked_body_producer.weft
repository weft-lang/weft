test "checked equality resolves an imported Eq trait" {
  let eq_module = registered(
    "pub trait Eq { fn eq(self, other: Self) -> bool }",
    named_module_identity("stdlib/eq", 1197)
  )
  let lookalike = registered(
    "pub trait Eq { fn eq(self, other: Self) -> bool }",
    named_module_identity("stdlib/eq", 1199)
  )
  let consumer = registered(
    "use stdlib/eq.{Eq} type Token { value: i64 } "
    |> str_concat("impl Eq for Token { fn eq(self: Self, other: Self) -> bool { true } } ")
    |> str_concat("fn equal(left: Token, right: Token) -> bool { left == right }"),
    named_module_identity("fixture/eq_consumer", 1198)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    eq_module.identity,
    false
  )
  let modules = [eq_module, lookalike, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      1197
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        Test.assert_true(
          match expressions.kind(product.function(1).body) {
            CheckedMethodCallKind -> true
            _ -> false
          }
        )
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked equality refuses a foreign package with the standard module path" {
  let lookalike = registered(
