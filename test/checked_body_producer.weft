  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn make(base: Box<str>) -> Box<str> { base.{} }",
      "fixture/checked_body_empty_nominal_update",
      1239
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_update_parts(product.function(0).body) {
          (_, fields) -> expressions.record_field_list_len(fields) == 0
        }
      }
      _ -> false
    }
  )
}

test "checked body producer rejects invalid functional record updates" {
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> i64 { value.{ x: 1 } }",
      "fixture/checked_body_update_non_record",
      1234
    ) {
      CheckedBodiesRejected(CheckedBodyProducerRecordUpdateRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(value: (i64, bool)) -> (i64, bool) { value.{} }",
      "fixture/checked_body_update_tuple",
      1235
    ) {
      CheckedBodiesRejected(CheckedBodyProducerRecordUpdateRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(base: { x: i64,..}) -> { x: i64,..} { base.{} }",
      "fixture/checked_body_update_open_record",
      1240
    ) {
      CheckedBodiesRejected(CheckedBodyProducerRecordUpdateRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { A(i64), B } fn bad(base: Choice) -> Choice { base.{} }",
      "fixture/checked_body_update_variant",
      1241
    ) {
      CheckedBodiesRejected(CheckedBodyProducerRecordUpdateRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn bad(base: Box<str>) -> Box<str> { "
    |> str_concat("base.{ other: \"new\" } }"),
      "fixture/checked_body_update_unknown_field",
      1236
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownField(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } fn bad(base: Box<str>) -> Box<str> { "
    |> str_concat("base.{ value: 42 } }"),
      "fixture/checked_body_update_wrong_type",
      1237
    ) {
