  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(i64, bool) } fn bad(value: Choice) -> i64 { match value { Pair(_, 1) -> 1 _ -> 0 } }",
      "fixture/checked_body_constructor_payload",
