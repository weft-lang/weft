test "trusted checked bodies publish typed pointer read and write nodes" {
  match checked_with_unsafe(
    "use runtime/unsafe.{Unsafe} fn pointer() -[Unsafe]> i64 { let mut value = 1 let address = &mut value address.* = 2 address.* }",
    "fixture/checked_body_pointer_trusted",
    1300,
    true
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let mut addresses: usize = 0
      let mut dereferences: usize = 0
      let mut writes: usize = 0
      let count = __u64_to_i64(__usize_to_u64(expressions.len()))
      for index in 0..count {
        let expression = checked_expr_id_from_ordinal(
          expressions.segment(),
          __i64_to_usize(index)
        )
        match expressions.kind(expression) {
          CheckedAddressOfKind -> { addresses = addresses + 1 }
          CheckedDerefKind -> { dereferences = dereferences + 1 }
          CheckedPointerAssignKind -> { writes = writes + 1 }
          _ -> nil
        }
      }
      Test.assert_eq_usize(addresses, 1)
      Test.assert_eq_usize(dereferences, 1)
      Test.assert_eq_usize(writes, 1)
    }
    _ -> Test.assert_true(false)
  }
}

