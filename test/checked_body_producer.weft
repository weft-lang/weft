}

test "checked body producer rejects invalid primitive binary operands" {
  Test.assert_true(
    match checked(
      "fn wrong(a: bool, b: bool) -> bool { a + b }",
      "fixture/checked_body_binary_numeric",
      123
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNumericOperandRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: bool, b: bool) -> bool { a band b }",
      "fixture/checked_body_binary_integer",
      124
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIntegerOperandRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: i64, b: i64) -> bool { a and b }",
      "fixture/checked_body_binary_boolean",
      125
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: (i64) -> i64) -> bool { a == a }",
      "fixture/checked_body_binary_dispatch",
      126
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalEqUnavailable) -> true
      _ -> false
    }
  )
}

test "checked body producer owns decoded string literal values" {
  match checked(
    "fn escaped() -> str { \"line\\nnext\" } fn empty() -> str { \"\" }",
    "fixture/checked_body_strings",
    127
  ) {
