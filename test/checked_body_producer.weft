test "checked body producer keeps raw pointers sealed without host source authority" {
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} fn strict(value: i64) -[Unsafe]> *i64 { &value }",
      "fixture/checked_body_pointer_strict",
