test "checked slices retain bounds and caller storage provenance" {
  match checked(
    "fn tail(values: [i64], start: usize) -> [i64] { values[start..] } "
    |> str_concat("fn exclusive(values: [mut i64]) -> [mut i64] { values[..] } ")
    |> str_concat("fn shared(values: [mut i64]) -> [i64] { values[..] }"),
    "fixture/checked_body_indexed_slices",
    943
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let borrows = product.borrows()
      let tail = product.function(0).body
      let exclusive = product.function(1).body
      let shared = product.function(2).body
      Test.assert_true(
        match expressions.kind(tail) {
          CheckedIndexedSliceKind -> true
          _ -> false
        }
      )
      match expressions.indexed_slice_parts(tail) {
        CheckedIndexedMutation(base, start, end, _) -> {
          Test.assert_true(
            match expressions.kind(base) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(start) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(end) {
              CheckedNilKind -> true
              _ -> false
            }
          )
        }
      }
      Test.assert_true(
        match borrows.view(tail) {
          Some(origins) -> match checked_borrow_origins_escape(origins) {
            CheckedBorrowEscapes -> true
            _ -> false
          }
          None -> false
        }
      )
      Test.assert_true(
        match borrows.view(exclusive) {
          Some(origins) -> match checked_borrow_origins_escape(origins) {
            CheckedBorrowEscapes -> true
            _ -> false
          }
          None -> false
        }
      )
      Test.assert_true(
        match borrows.view(exclusive) {
          Some(origins) -> checked_borrow_origins_exclusive(origins)
          None -> false
        }
      )
      Test.assert_true(
        match borrows.view(shared) {
          Some(origins) -> not checked_borrow_origins_exclusive(origins)
          None -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked local slices can be used but cannot escape their owner" {
  Test.assert_true(
    match checked(
      "fn read() -> i64 { let values: [i64; 3] = [1, 2, 3]; "
    |> str_concat("let view: [i64] = values[1..3]; view[0] }"),
      "fixture/checked_body_local_slice",
      944
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn read() -> i64 { let mut values: [i64; 2] = [1, 2]; "
    |> str_concat("let view: [mut i64] = values[..]; view[0] }"),
      "fixture/checked_body_local_mutable_slice",
      952
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn escape() -> [i64] { let values: [i64; 2] = [1, 2]; values[..] }",
      "fixture/checked_body_escaping_local_slice",
      945
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(CheckedBodyBorrowCannotEscape(_))) ->
        true
      _ -> false
    }
  )
}

