test "checked body producer publishes immediate handlers and resume" {
  match checked(
    "effect Box<T> { fn put(value: T) -> nil fn get() -> T } "
    |> str_concat("fn read() -[Box<i64>]> i64 { Box.get() } ")
    |> str_concat(
      "fn handled(value: i64) -> str { "
    )
    |> str_concat(
      "handle { Box.put(value) Box.get() } { "
    )
    |> str_concat(
      "Box.put(seen: i64) -> resume(nil) Box.get() -> \"stopped\" "
    )
    |> str_concat(
      "return result -> if result == 42 { \"ok\" } else { \"bad\" } } }"
    ),
    "fixture/checked_body_handle",
    153
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let effects = product.effects()
      let root = product.function(1).body
      Test.assert_true(match expressions.kind(root) { CheckedHandleKind -> true, _ -> false })
      match effects.inspect(expressions.handle_detail(root)) {
        CheckedHandleDetail(value) -> {
          Test.assert_true(
            match expressions.kind(value.body) { CheckedBlockKind -> true, _ -> false }
          )
          Test.assert_eq_usize(effects.clause_list_len(value.clauses), 2)
          let put = effects.clause_list_at(value.clauses, 0)
          let get = effects.clause_list_at(value.clauses, 1)
          Test.assert_eq_usize(effects.parameter_list_len(put.parameters), 1)
          Test.assert_true(
            match expressions.kind(put.body) { CheckedResumeKind -> true, _ -> false }
          )
          Test.assert_true(
            match put.completion { CheckedHandlerResumes -> true, _ -> false }
          )
          Test.assert_true(
            match get.completion { CheckedHandlerAborts -> true, _ -> false }
          )
          Test.assert_true(
            match value.return_clause { CheckedHandleReturnClause(_, _) -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

