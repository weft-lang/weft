test "checked body producer retains structural update fields and result shape" {
  match checked(
    "fn make(base: { z: i64, a: bool }) -> { z: str, a: bool, extra: i64 } { "
    |> str_concat("base.{ z: \"new\", extra: 3 } }"),
    "fixture/checked_body_structural_update",
    1230
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) { CheckedRecordUpdateKind -> true, _ -> false }
      )
      match expressions.record_update_parts(root) {
        (base, fields) -> {
          Test.assert_true(
            match expressions.kind(base) { CheckedLocalReferenceKind -> true, _ -> false }
          )
          Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          let first = expressions.record_field_list_at(fields, 0)
          let second = expressions.record_field_list_at(fields, 1)
          Test.assert_true(match first.kind { CheckedStructuralRecordField -> true, _ -> false })
          Test.assert_eq(first.stable_key, "z".hash())
          Test.assert_eq(second.stable_key, "extra".hash())
          Test.assert_true(
            match first.position { CheckedRecordFieldOrdinal(0) -> true, _ -> false }
          )
          Test.assert_true(
            match second.position { CheckedRecordFieldOrdinal(2) -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(first.value) { CheckedStringKind -> true, _ -> false }
          )
          Test.assert_true(
            match expressions.kind(second.value) { CheckedIntegerKind -> true, _ -> false }
          )
        }
      }
      let range = expressions.range(root)
      Test.assert_eq_usize(range.end - range.start, 27)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn make(base: { x: i64 }) -> { x: i64 } { base.{} }",
      "fixture/checked_body_empty_structural_update",
      1231
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_update_parts(product.function(0).body) {
          (_, fields) -> expressions.record_field_list_len(fields) == 0
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn make(base: {}) -> { x: i64 } { base.{ x: 1 } }",
      "fixture/checked_body_update_empty_base",
      1242
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_update_parts(product.function(0).body) {
          (_, fields) -> expressions.record_field_list_len(fields) == 1
        }
      }
      _ -> false
    }
  )
}

