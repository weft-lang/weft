test "checked question-mark retains the exact Result and Fail propagation" {
  match checked_with_result_and_fail(
    r#"use stdlib/result.{Result}
use stdlib/fail.{Fail}
fn project(value: Result<i64, str>) -[Fail<str>]> i64 { value? }"#,
    "fixture/checked_try",
    1281
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedFailurePropagationKind -> true
          _ -> false
        }
      )
      let propagation = product.propagation()
      let detail = propagation.failure(expressions.failure_propagation_detail(root))
      Test.assert_true(detail.operator_range.start > 0)
      Test.assert_eq_usize(detail.operator_range.end, detail.operator_range.start + 1)
      Test.assert_eq_usize(expressions.range(root).end, detail.operator_range.end)
      Test.assert_true(expressions.range(detail.value).start < detail.operator_range.start)
    }
    _ -> Test.assert_true(false)
  }
  match checked_with_result_and_fail(
    r#"use stdlib/result.{Result}
use stdlib/fail.{Fail}
fn project<T, E>(value: Result<T, E>) -[Fail<E>]> T { value? }"#,
    "fixture/checked_try_generic",
    1285
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedFailurePropagationKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match checked_with_result_and_fail(
    r#"use stdlib/result.{Result}
use stdlib/fail.{Fail}
fn project(value: Result<i64, str>) -> i64 {
  handle value? { Fail<str>.fail(error) -> 0 }
}"#,
    "fixture/checked_try_handled",
    1287
  ) {
    CheckedBodiesAccepted(product) -> Test.assert_eq_usize(product.function_count(), 1)
    _ -> Test.assert_true(false)
  }
}

