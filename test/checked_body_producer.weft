test "checked equality resolves an imported Eq trait" {
  let eq_module = registered(
    "pub trait Eq { fn eq(self, other: Self) -> bool }",
    named_module_identity("stdlib/eq", 1197)
  )
  let lookalike = registered(
    "pub trait Eq { fn eq(self, other: Self) -> bool }",
    named_module_identity("stdlib/eq", 1199)
  )
  let consumer = registered(
    "use stdlib/eq.{Eq} type Token { value: i64 } "
      |> str_concat("impl Eq for Token { fn eq(self: Self, other: Self) -> bool { true } } ")
      |> str_concat("fn equal(left: Token, right: Token) -> bool { left == right }"),
    named_module_identity("fixture/eq_consumer", 1198)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    eq_module.identity,
    false
  )
  let modules = [eq_module, lookalike, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      1197
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        Test.assert_true(
          match expressions.kind(product.function(1).body) {
            CheckedMethodCallKind -> true
            _ -> false
          }
        )
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked equality refuses a foreign package with the standard module path" {
  let lookalike = registered(
    "pub trait Eq { fn eq(self, other: Self) -> bool }",
    named_module_identity("stdlib/eq", 1199)
  )
  let consumer = registered(
    "use stdlib/eq.{Eq} type Token { value: i64 } "
      |> str_concat("impl Eq for Token { fn eq(self: Self, other: Self) -> bool { true } } ")
      |> str_concat("fn equal(left: Token, right: Token) -> bool { left == right }"),
    named_module_identity("fixture/foreign_eq_consumer", 1200)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    lookalike.identity,
    false
  )
  let modules = [lookalike, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      1197
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalEqUnavailable) -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked equality retains delayed dispatch through an exact Eq bound" {
  match checked(
    "pub trait Eq { fn eq(self, other: Self) -> bool } "
      |> str_concat("pub trait Similar { fn eq(self, other: Self) -> bool } ")
      |> str_concat("fn equal<T: Similar & Eq>(left: T, right: T) -> bool { left == right } ")
      |> str_concat("fn different<T: Eq>(left: T, right: T) -> bool { left != right }"),
    "stdlib/eq",
    1199
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(product.function(1).body) {
          CheckedNotKind -> match expressions.kind(
            expressions.not_operand(product.function(1).body)
          ) {
            CheckedMethodCallKind -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

fn assert_checked_order_case(
  product: CheckedBodyProduct,
  index: usize,
  constructor: str,
  selected_value: bool
) -[Test]> i64 {
  let expressions = product.expressions()
  let patterns = product.patterns()
  let root = product.function(index).body
  Test.assert_true(
    match expressions.kind(root) {
      CheckedExplicitMatchKind -> true
      _ -> false
    }
  )
  let (_, call, arms) = expressions.match_parts(root)
  Test.assert_true(
    match expressions.kind(call) {
      CheckedMethodCallKind -> true
      _ -> false
    }
  )
  Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
  let selected = patterns.match_arm_list_at(arms, 0)
  let fallback = patterns.match_arm_list_at(arms, 1)
  let (declaration, children, _) = patterns.constructor_parts(selected.pattern)
  Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), constructor)
  Test.assert_eq_usize(patterns.pattern_list_len(children), 0)
  Test.assert_true(expressions.boolean_value(selected.body) == selected_value)
  Test.assert_true(expressions.boolean_value(fallback.body) == not selected_value)
}

test "checked ordering dispatches through canonical Ord" {
  match checked(
    "pub type Ordering { Less, Equal, Greater } "
      |> str_concat("pub trait Ord { fn compare(self, other: Self) -> Ordering } ")
      |> str_concat(
        "impl Ord for Ordering { fn compare(self: Self, other: Self) -> Ordering { Less } } "
      )
      |> str_concat("fn less(left: Ordering, right: Ordering) -> bool { left < right } ")
      |> str_concat("fn greater(left: Ordering, right: Ordering) -> bool { left > right } ")
      |> str_concat("fn at_most(left: Ordering, right: Ordering) -> bool { left <= right } ")
      |> str_concat("fn at_least(left: Ordering, right: Ordering) -> bool { left >= right }"),
    "stdlib/ord",
    1201
  ) {
    CheckedBodiesAccepted(product) -> {
      assert_checked_order_case(product, 1, "Less", true)
      assert_checked_order_case(product, 2, "Greater", true)
      assert_checked_order_case(product, 3, "Greater", false)
      assert_checked_order_case(product, 4, "Less", false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked contextual variant constructors retain exact cases and payloads" {
  match checked(
    "type Choice { Empty, Value(i64) } "
      |> str_concat("fn empty() -> Choice { Empty } ")
      |> str_concat("fn value() -> Choice { Value(3) }"),
    "fixture/checked_constructor_values",
    1210
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let empty = product.function(0).body
      let value = product.function(1).body
      Test.assert_true(
        match expressions.kind(empty) {
          CheckedConstructorCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(value) {
          CheckedConstructorCallKind -> true
          _ -> false
        }
      )
      let (empty_case, empty_arguments) = expressions.constructor_call_parts(empty)
      let (value_case, value_arguments) = expressions.constructor_call_parts(value)
      Test.assert_str_eq(declaration_identity_name(empty_case).text().unwrap(), "Empty")
      Test.assert_str_eq(declaration_identity_name(value_case).text().unwrap(), "Value")
      Test.assert_eq_usize(expressions.expression_list_len(empty_arguments), 0)
      Test.assert_eq_usize(expressions.expression_list_len(value_arguments), 1)
      Test.assert_eq(
        expressions.integer_value(expressions.expression_list_at(value_arguments, 0)),
        3
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "type Choice { Empty, Value(i64) } "
        |> str_concat("fn inferred() -> Choice { let result = Value(4); result }"),
      "fixture/checked_constructor_inferred",
      1215
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty, Value(i64) } "
        |> str_concat("fn cold() -> i64 { let result = Value(4); 1 }"),
      "fixture/checked_constructor_cold",
      1217
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked contextual variant constructors reject missing context and invalid payloads" {
  Test.assert_true(
