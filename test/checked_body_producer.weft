}

test "checked expression application checks argument types" {
  Test.assert_true(
    match checked(
      "fn bad(f: (i64) -> i64) -> i64 { (f)(\"text\") }",
      "fixture/checked_body_apply_argument",
      1156
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
