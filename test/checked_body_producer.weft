test "checked generic calls enforce trait bounds after substitution" {
  let source = "trait Mark { fn mark(self: Self) -> i64 } "
    |> str_concat("fn identity<T: Mark>(value: T) -> T { value } ")
    |> str_concat("fn caller() -> i64 { identity<i64>(5) }")
  Test.assert_true(
    match checked(source, "fixture/checked_body_generic_bound_refused", 1165) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_conformance(
      source,
      "fixture/checked_body_generic_bound_accepted",
      1166,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  let inferred = "trait Mark { fn mark(self: Self) -> i64 } "
    |> str_concat("fn identity<T: Mark>(value: T) -> T { value } ")
    |> str_concat("fn caller() -> i64 { identity(5) }")
  Test.assert_true(
    match checked(inferred, "fixture/checked_body_inferred_bound_refused", 1221) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_conformance(
      inferred,
      "fixture/checked_body_inferred_bound_accepted",
      1222,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

fn checked_with_imported_bound(text: str, discriminator: i64) -[Test]> CheckedBodyCheckResult {
  let order = registered(
    "pub trait Order { fn compare(self, other: Self) -> i64 }",
    named_module_identity("fixture/imported_bound_order", discriminator)
  )
  let callee = registered(
    "use fixture/imported_bound_order.{Order} "
      |> str_concat("pub fn map_new<K: Order, V>() -> i64 { 0 }"),
    named_module_identity("fixture/imported_bound_callee", discriminator)
  )
  let consumer = registered(
    "use fixture/imported_bound_order.{Order} "
      |> str_concat("use fixture/imported_bound_callee.{map_new} ")
      |> str_concat(text),
    named_module_identity("fixture/imported_bound_consumer", discriminator)
  )
  let callee_order = registration_scope.resolved_import(
    callee,
    callee.syntax.imports.get(0).unwrap(),
    order.identity,
    false
  )
  let consumer_order = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    order.identity,
    false
  )
  let consumer_callee = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(1).unwrap(),
    callee.identity,
    false
  )
  let modules = [order, callee, consumer]
  let imports = [callee_order, consumer_order, consumer_callee]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved imported bound signatures")
  }
}

test "checked generic calls forward a lexical bound to an imported callee" {
  Test.assert_true(
    match checked_with_imported_bound(
      "fn set_new<T: Order>() -> i64 { map_new<T, i64>() }",
      1400
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_imported_bound(
      "fn set_new<T: Order>() -> i64 { map_new<T, T>() }",
      1401
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_imported_bound(
      "fn set_new<T>() -> i64 { map_new<T, i64>() }",
      1402
    ) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_imported_bound(
      "fn set_new<T: Order, U>() -> i64 { map_new<U, T>() }",
      1403
    ) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
}

test "checked bare effects select atoms interned in an earlier type segment" {
  -- The opaque application places the signature's effect set in a later
  -- segment than the atom it lists.
  let source = "type Conn<S> = opaque (S, i64) effect Client { fn begin() -> i64 } "
    |> str_concat("effect Server { fn request(value: i64) -> i64 } ")
  Test.assert_true(
    match checked(
      str_concat(source, "fn read(connection: Conn<i64>) -[Client]> i64 { Client.begin() }"),
      "fixture/checked_body_segmented_effect_available",
      1404
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      str_concat(
        source,
        "fn read(connection: Conn<i64>) -[Client]> i64 { match 1 { _ -> { Client.begin() } } }"
      ),
      "fixture/checked_body_segmented_effect_nested",
      1405
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      str_concat(source, "fn read(connection: Conn<i64>) -[Client]> i64 { Server.request(1) }"),
      "fixture/checked_body_segmented_effect_missing",
      1406
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
}

