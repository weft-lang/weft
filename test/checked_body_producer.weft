test "checked bodies resolve module-qualified dependency functions" {
  let dependency = registered(
    "pub fn add_one(value: i64) -> i64 { value + 1 } "
      |> str_concat("pub fn identity<T>(value: T) -> T { value } ")
      |> str_concat("pub fn value() -> i64 { 41 } ")
      |> str_concat("pub fn flag() -> bool { true } ")
      |> str_concat("pub fn pair(first: i64, second: i64) -> i64 { first + second }"),
    named_module_identity("fixture/qualified_functions_dependency", 1246)
  )
  let consumer = registered(
    "use fixture/qualified_functions_dependency as dep "
      |> str_concat("fn plain() -> i64 { dep.add_one(4) } ")
      |> str_concat("fn generic() -> str { dep.identity<str>(\"ok\") } ")
      |> str_concat("fn reference() -> (i64) -> i64 { dep.add_one } ")
      |> str_concat("fn composed() -> i64 { dep.value() + 1 } ")
      |> str_concat("fn equals() -> bool { dep.value() == 41 } ")
      |> str_concat("fn negated() -> i64 { -dep.value() } ")
      |> str_concat("fn inverted() -> bool { not dep.flag() } ")
      |> str_concat("fn called() -> i64 { dep.pair(dep.value(), 1) } ")
      |> str_concat("fn looped() -> nil { while dep.flag() { break } }"),
    named_module_identity("fixture/qualified_functions_consumer", 1247)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  let reason = match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        Test.assert_eq_usize(product.function_count(), 9)
        let expressions = product.expressions()
        let plain = product.function(0).body
        Test.assert_true(
          match expressions.kind(plain) {
            CheckedDirectCallKind -> true
            _ -> false
          }
        )
        let (plain_target, plain_arguments) = expressions.direct_call_parts(plain)
        Test.assert_eq_usize(expressions.expression_list_len(plain_arguments), 1)
        Test.assert_true(
          module_identity_eq(
            function_identity_module(plain_target),
            dependency.identity
          )
        )
        let generic = product.function(1).body
        Test.assert_true(
          match expressions.kind(generic) {
            CheckedGenericCallKind -> true
            _ -> false
          }
        )
        let (generic_call, _) = expressions.generic_call_parts(generic)
        let (generic_target, _) = expressions.direct_call_parts(generic_call)
        Test.assert_true(
          module_identity_eq(
            function_identity_module(generic_target),
            dependency.identity
          )
        )
        let reference = product.function(2).body
        Test.assert_true(
          match expressions.kind(reference) {
            CheckedDeclarationReferenceKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          module_identity_eq(
            declaration_identity_module(expressions.declaration(reference)),
            dependency.identity
          )
        )
        let composed = product.function(3).body
        Test.assert_true(
          match expressions.kind(composed) {
            CheckedBinaryKind -> true
            _ -> false
          }
        )
        let equals = product.function(4).body
        Test.assert_true(
          match expressions.kind(equals) {
            CheckedBinaryKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          match expressions.kind(product.function(5).body) {
            CheckedNegateKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          match expressions.kind(product.function(6).body) {
            CheckedNotKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          match expressions.kind(product.function(7).body) {
            CheckedDirectCallKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          match expressions.kind(product.function(8).body) {
            CheckedWhileKind -> true
            _ -> false
          }
        )
        "accepted"
      }
      CheckedBodiesRejected(CheckedBodyProducerUnsupportedExpression) -> "unsupported"
      CheckedBodiesRejected(CheckedBodyProducerUnknownIdentifier(_)) -> "unknown"
      CheckedBodiesRejected(CheckedBodyProducerSignatureUnavailable(_)) -> "signature"
      CheckedBodiesRejected(CheckedBodyProducerUnknownField(_)) -> "field"
      _ -> "other"
    }
    _ -> "semantic"
  }
  Test.assert_str_eq(reason, "accepted")
}

test "checked binary operands use the catalog extended by an imported call" {
  let dependency = registered(
    "pub fn text() -> str { \"no\" }",
    named_module_identity("fixture/qualified_string_dependency", 1250)
  )
  let consumer = registered(
    "use fixture/qualified_string_dependency as dep fn invalid() -> str { dep.text() + 1 }",
    named_module_identity("fixture/qualified_string_consumer", 1251)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  let rejected = match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesRejected(CheckedBodyProducerNumericOperandRequired(_)) -> true
      _ -> false
    }
    _ -> false
  }
  Test.assert_true(rejected)
}

test "checked match patterns use the catalog extended by an imported scrutinee" {
  let dependency = registered(
    "pub fn flag() -> bool { true } pub fn value() -> i64 { 42 } "
      |> str_concat("pub fn values() -> [i64; 2] { [1, 2] }"),
    named_module_identity("fixture/qualified_match_dependency", 1252)
  )
  let consumer = registered(
    "use fixture/qualified_match_dependency as dep "
      |> str_concat("fn classify() -> i64 { match dep.flag() { true -> 1, false -> 0 } } ")
      |> str_concat(
        "fn choose() -> i64 { let selected = match true { true -> dep.value() false -> dep.value() }; selected } "
      )
      |> str_concat("fn walk() -> nil { for item in dep.values() { item } }"),
    named_module_identity("fixture/qualified_match_consumer", 1253)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  let accepted = match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(types, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        Test.assert_eq_usize(product.function_count(), 3)
        let expressions = product.expressions()
        match expressions.kind(product.function(0).body) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      }
      _ -> false
    }
    _ -> false
  }
  Test.assert_true(accepted)
}

