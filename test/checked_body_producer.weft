test "checked body producer publishes contextual lambdas with typed parameters" {
  match checked(
    "fn apply(value: i64, callback: (i64) -> i64) -> i64 { callback(value) } "
      |> str_concat("fn caller() -> i64 { apply(1, (x: i64) => x + 1) }"),
    "fixture/checked_body_lambda",
    1231
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let closures = product.closures()
      let (_, arguments) = expressions.direct_call_parts(product.function(1).body)
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 2)
      let value = expressions.expression_list_at(arguments, 1)
      Test.assert_true(match expressions.kind(value) { CheckedLambdaKind -> true, _ -> false })
      let closure = closures.inspect(expressions.lambda_detail(value))
      Test.assert_eq_usize(closures.binding_list_len(closure.parameters), 1)
      Test.assert_eq_usize(closures.binding_list_len(closure.captures), 0)
      Test.assert_true(match closure.role { CheckedOrdinaryLambda -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(closure.body) { CheckedBinaryKind -> true, _ -> false }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer binds inferred and multiple lambda parameters" {
  match checked(
    "fn unary(value: i64, callback: (i64) -> i64) -> i64 { callback(value) } "
      |> str_concat("fn pair(callback: (i64, i64) -> i64) -> i64 { callback(2, 3) } ")
      |> str_concat("fn first() -> i64 { unary(1, x => x + 1) } ")
      |> str_concat("fn second() -> i64 { pair((left, right) => left + right) }"),
    "fixture/checked_body_lambda_parameters",
    1236
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let closures = product.closures()
      let (_, unary_arguments) = expressions.direct_call_parts(product.function(2).body)
      let unary = expressions.expression_list_at(unary_arguments, 1)
      let unary_closure = closures.inspect(expressions.lambda_detail(unary))
      Test.assert_eq_usize(closures.binding_list_len(unary_closure.parameters), 1)
      let (_, pair_arguments) = expressions.direct_call_parts(product.function(3).body)
      let pair = expressions.expression_list_at(pair_arguments, 0)
      let pair_closure = closures.inspect(expressions.lambda_detail(pair))
      Test.assert_eq_usize(closures.binding_list_len(pair_closure.parameters), 2)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer contextually checks inferred generic callbacks" {
  match checked(
    "fn apply<T>(value: T, callback: (T) -> T) -> T { callback(value) } "
      |> str_concat("fn caller() -> i64 { apply(1, x => x + 1) }"),
    "fixture/checked_body_generic_callback",
    1241
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let generic = product.function(1).body
      Test.assert_true(
        match expressions.kind(generic) { CheckedGenericCallKind -> true, _ -> false }
      )
      let (call, _) = expressions.generic_call_parts(generic)
      let (_, arguments) = expressions.direct_call_parts(call)
      let callback = expressions.expression_list_at(arguments, 1)
      Test.assert_true(match expressions.kind(callback) { CheckedLambdaKind -> true, _ -> false })
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn apply<T>(value: T, callback: (T) -> T) -> T { callback(value) } "
        |> str_concat("fn caller() -> i64 { apply(1, x => \"wrong\") }"),
      "fixture/checked_body_generic_callback_mismatch",
      1242
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer infers callback parameters from later arguments" {
  match checked(
    "fn apply<T>(callback: (T) -> T, value: T) -> T { callback(value) } "
      |> str_concat("fn caller() -> i64 { apply(x => x + 1, 1) }"),
    "fixture/checked_body_callback_first",
    1248
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (call, _) = expressions.generic_call_parts(product.function(1).body)
      let (_, arguments) = expressions.direct_call_parts(call)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedLambdaKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 1)) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn chain<T, U>(first: (T) -> U, second: (U) -> U, value: T) -> U { second(first(value)) } "
        |> str_concat("fn caller() -> i64 { chain(x => x + 1, y => y + 1, 1) }"),
      "fixture/checked_body_callback_chain",
      1249
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn chain<T, U>(first: (T) -> U, second: (U) -> U, value: T) -> U { second(first(value)) } "
        |> str_concat("fn caller() -> i64 { chain(x => x + 1, y => \"wrong\", 1) }"),
      "fixture/checked_body_callback_chain_mismatch",
      1250
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer infers generic parameters from lambda annotations" {
  Test.assert_true(
    match checked(
      "fn invoke<T>(callback: (T) -> T) -> i64 { 0 } "
        |> str_concat("fn caller() -> i64 { invoke((x: i64) => x + 1) }"),
      "fixture/checked_body_callback_annotation",
      1251
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn invoke<T, U>(callback: (T, U) -> T) -> i64 { 0 } "
        |> str_concat("fn caller() -> i64 { invoke((left: i64, right: str) => left) }"),
      "fixture/checked_body_callback_two_annotations",
      1252
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn invoke<T>(callback: (T) -> i64, value: T) -> i64 { callback(value) } "
        |> str_concat("fn caller() -> i64 { invoke((x: i64 | str) => 1, 1) }"),
      "fixture/checked_body_callback_wide_annotation",
      1253
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn invoke<T>(callback: (T) -> T) -> i64 { 0 } "
        |> str_concat("fn caller() -> i64 { invoke((x: i64) => \"wrong\") }"),
      "fixture/checked_body_callback_annotation_mismatch",
      1254
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer infers a generic result from a lambda body" {
  Test.assert_true(
    match checked(
      "fn map<T, U>(value: T, callback: (T) -> U) -> U { callback(value) } "
        |> str_concat("fn caller() -> i64 { map(1, x => x + 1) }"),
      "fixture/checked_body_generic_callback_result",
      1243
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn map<T, U>(value: T, callback: (T) -> U) -> U { callback(value) } "
        |> str_concat("fn caller() -> str { map(1, x => \"ready\") }"),
      "fixture/checked_body_generic_callback_distinct_result",
      1244
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn map<T, U>(value: T, callback: (T) -> U) -> U { callback(value) } "
        |> str_concat("fn caller() -> i64 { map(1, x => \"wrong\") }"),
      "fixture/checked_body_generic_callback_bad_result",
      1245
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer needs a contextual type for inferred lambdas" {
  Test.assert_true(
    match checked(
      "fn caller() -> i64 { let callback = x => x; 0 }",
      "fixture/checked_body_lambda_missing_context",
      1237
    ) {
      CheckedBodiesRejected(CheckedBodyProducerLambdaContextRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer infers standalone annotated lambda results" {
  match checked(
    "fn caller() -> i64 { let callback = (x: i64) => x + 1; callback(2) }",
    "fixture/checked_body_standalone_lambda",
    1246
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let closures = product.closures()
      let (_, callback, _) = expressions.let_parts(product.function(0).body)
      Test.assert_true(match expressions.kind(callback) { CheckedLambdaKind -> true, _ -> false })
      let closure = closures.inspect(expressions.lambda_detail(callback))
      Test.assert_eq_usize(closures.binding_list_len(closure.parameters), 1)
      Test.assert_true(
        match expressions.kind(closure.body) { CheckedBinaryKind -> true, _ -> false }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn zero() -> i64 { let callback = () => 5; callback() } "
        |> str_concat(
          "fn identity<T>(value: T) -> T { let callback = (x: T) => x; callback(value) }"
        ),
      "fixture/checked_body_standalone_lambda_generic",
      1247
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects a lambda annotation narrower than its context" {
  Test.assert_true(
    match checked(
      "fn apply(callback: (i64) -> i64) -> i64 { callback(1) } "
        |> str_concat("fn caller() -> i64 { apply((x: bool) => 1) }"),
      "fixture/checked_body_lambda_annotation",
      1232
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer keeps lambda effects separate from the caller" {
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } "
        |> str_concat("fn apply(callback: () -> i64) -> i64 { callback() } ")
        |> str_concat("fn caller() -[Read]> i64 { apply(() => Read.get()) }"),
      "fixture/checked_body_lambda_effect",
      1233
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer identifies unavailable declared effects" {
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn bad() -> i64 { Read.get() }",
      "fixture/checked_body_unavailable_declared_effect",
      1239
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer allows a lambda's declared effect" {
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } "
        |> str_concat("fn apply(callback: () -[Read]> i64) -[Read]> i64 { callback() } ")
        |> str_concat("fn caller() -[Read]> i64 { apply(() => Read.get()) }"),
      "fixture/checked_body_lambda_declared_effect",
      1240
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer retains immutable primitive captures" {
  match checked(
    "fn apply(callback: () -> i64) -> i64 { callback() } "
      |> str_concat("fn caller() -> i64 { let base = 2; apply(() => base) }"),
    "fixture/checked_body_lambda_capture",
    1234
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let closures = product.closures()
      let (base, _, call) = expressions.let_parts(product.function(1).body)
      let (_, arguments) = expressions.direct_call_parts(call)
      let value = expressions.expression_list_at(arguments, 0)
      let closure = closures.inspect(expressions.lambda_detail(value))
      Test.assert_eq_usize(closures.binding_list_len(closure.captures), 1)
      Test.assert_true(checked_binding_id_eq(closures.binding_list_at(closure.captures, 0), base))
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer retains immutable callable, nominal and generic captures" {
  Test.assert_true(
    match checked(
      "type Box<T> { Box(T) } "
        |> str_concat("fn apply<T>(callback: () -> T) -> T { callback() } ")
        |> str_concat("fn callable(callback: () -> i64) -> i64 { apply(() => callback()) } ")
        |> str_concat("fn nominal(value: Box<i64>) -> Box<i64> { apply(() => value) } ")
        |> str_concat("fn generic<T>(value: T) -> T { apply<T>(() => value) }"),
      "fixture/checked_body_rich_lambda_capture",
      1241
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer refuses mutable captures" {
  Test.assert_true(
    match checked(
      "fn apply(callback: () -> i64) -> i64 { callback() } "
        |> str_concat("fn caller() -> i64 { let mut base = 2; apply(() => base) }"),
      "fixture/checked_body_mutable_lambda_capture",
      1235
    ) {
      CheckedBodiesRejected(CheckedBodyProducerLambdaCaptureUnsupported(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer refuses aggregate captures without ownership proof" {
  Test.assert_true(
    match checked(
      "fn apply(callback: () -> i64) -> i64 { callback() } "
        |> str_concat("fn caller() -> i64 { let values = [1, 2]; apply(() => values[0]) }"),
      "fixture/checked_body_aggregate_lambda_capture",
      1238
    ) {
      CheckedBodiesRejected(CheckedBodyProducerLambdaCaptureUnsupported(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer covers piped arguments that precede their callee" {
  let chain = "fn step(value: i64) -> i64 { value } "
    |> str_concat("fn chain(value: i64) -> i64 { value |> step() |> step() }")
  match checked(chain, "fixture/checked_pipe_call", 1394) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let range = expressions.range(product.function(1).body)
      -- The parser does not yet retain call closing delimiters, so the piped
      -- call ends at its final callee name rather than its closing parenthesis.
      Test.assert_true(
        match chain.slice(range.start, range.end) {
          Some(text) -> text == "value |> step() |> step"
          None -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  let forms = [
    "type Box { Box(i64) } fn step(value: i64) -> i64 { value } "
      |> str_concat("fn wrap(value: i64) -> Box { value |> step() |> Box() }"),
    "type Box { Box(i64) } impl Box { fn add(self, amount: i64) -> i64 { amount } } "
      |> str_concat("fn step(value: i64) -> i64 { value } ")
      |> str_concat("fn total(boxed: Box, value: i64) -> i64 { value |> step() |> boxed.add() }"),
    "effect Log { fn put(value: i64) -> i64 } fn step(value: i64) -> i64 { value } "
      |> str_concat("fn emit(value: i64) -[Log]> i64 { value |> step() |> Log.put() }"),
    "fn step(value: i64) -> i64 { value } "
      |> str_concat("fn narrow(value: i64) -> u8 { value |> step() |> __i64_to_u8() }")
  ]
  let names = [
    "fixture/checked_pipe_constructor",
    "fixture/checked_pipe_method",
    "fixture/checked_pipe_perform",
    "stdlib/fixture_pipe_intrinsic"
  ]
  let zero: usize = 0
  for index in zero..forms.len {
    Test.assert_true(
      match checked(forms[index], names[index], 1395 + __u64_to_i64(__usize_to_u64(index))) {
        CheckedBodiesAccepted(_) -> true
        CheckedBodiesRejected(_) -> false
      }
    )
  }
}
