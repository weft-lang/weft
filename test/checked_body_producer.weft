  Test.assert_true(
    match checked(
      "fn sealed(value: str) -> i64 { __str_ptr(value) }",
      "fixture/intrinsic_sealed",
      1145
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownIdentifier(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn unknown() -> i64 { __not_an_intrinsic() }",
      "runtime/fixture_intrinsic_unknown",
      1146
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownIdentifier(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_trusted(
      "fn word(k: Continuation<i64, i64>) -> i64 { __transmute(k) }",
      "runtime/fixture_intrinsic_continuation_word",
      1147
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

