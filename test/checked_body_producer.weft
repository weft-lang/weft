test "checked straight lowering consumes typed bodies without raw storage" {
  match checked(
    "fn twice_sum(left: i64, right: i64) -> i64 { let sum = left + right; sum * 2 } "
      |> str_concat("fn main() -> i64 { twice_sum(20, 1) }"),
    "fixture/checked_straight_lowering",
    1268
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 101)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 102)
      match lower_checked_straight_function(product, symbols, 0) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 2)
          Test.assert_eq(ir_function_count_binary_op(function, ir_binary_op_add()), 1)
          Test.assert_eq(ir_function_count_binary_op(function, ir_binary_op_mul()), 1)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 1) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 0)
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 2)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering represents mutable scalar storage with slots" {
  match checked(
    "fn mutable_value() -> i64 { let mut value = 41; value }",
    "fixture/checked_straight_mutable_storage",
    1269
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols_bind(
        checked_native_function_symbols(),
        product.function(0).signature.identity,
        103
      )
      Test.assert_true(
        match lower_checked_straight_function(product, symbols, 0) {
          CheckedStraightFunctionLowered(function) -> {
            Test.assert_eq(ir_function_count_tag(function, 5), 1)
            Test.assert_eq(ir_function_count_tag(function, 6), 1)
            Test.assert_eq(ir_function_count_tag(function, 7), 1)
            true
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering preserves shared and exclusive borrows as runtime aliases" {
  match checked(
    "type Token = opaque i64 "
      |> str_concat("fn observe(token: borrow Token) -> i64 { 1 } ")
      |> str_concat("fn mutate(token: borrow mut Token) -> i64 { 2 } ")
      |> str_concat("fn shared(token: borrow Token) -> i64 { observe(token) } ")
      |> str_concat("fn exclusive(token: borrow mut Token) -> i64 { mutate(token) }"),
    "fixture/checked_borrow_lowering",
    1270
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 104)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 105)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 106)
        |> checked_native_function_symbols_bind(product.function(3).signature.identity, 107)
      match lower_checked_straight_function(product, symbols, 2) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 1)
          Test.assert_eq(ir_function_count_tag(function, 6), 0)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 3) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 1)
          Test.assert_eq(ir_function_count_tag(function, 6), 0)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering retains variants and erases opaque constructors" {
  match checked(
    "type Choice { Empty, Value(i64) } type Token = opaque i64 "
      |> str_concat("fn empty() -> Choice { Empty } ")
      |> str_concat("fn value() -> Choice { Value(3) } ")
      |> str_concat("fn wrap() -> Token { Token(7) }"),
    "fixture/checked_semantic_constructor_lowering",
    1271
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 108)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 109)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 110)
      match lower_checked_straight_function(product, symbols, 0) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_count_tag(function, 63), 1)
          Test.assert_eq(ir_function_first_variant_payload_count_or(function, 0 - 1), 0)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 1) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_count_tag(function, 63), 1)
          Test.assert_eq(ir_function_first_variant_payload_count_or(function, 0 - 1), 1)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 2) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_count_tag(function, 63), 0)
          Test.assert_eq(ir_function_first_variant_payload_count_or(function, 0 - 1), 0 - 1)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering retains one semantic contract for unresolved calls" {
  match checked(
    "impl i64 { fn bump(self: i64) -> i64 { self + 1 } } "
      |> str_concat("type Marker = opaque i64 ")
      |> str_concat("impl Marker { fn make(value: i64) -> i64 { value } } ")
      |> str_concat("fn applied(callback: (i64) -> i64) -> i64 { callback(1) } ")
      |> str_concat("fn method() -> i64 { 1.bump() } ")
      |> str_concat("fn associated() -> i64 { Marker.make(3) }"),
    "fixture/checked_semantic_call_lowering",
    1272
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 111)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 112)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 113)
        |> checked_native_function_symbols_bind(product.function(3).signature.identity, 114)
        |> checked_native_function_symbols_bind(product.function(4).signature.identity, 115)
      let mut index: usize = 2
      while index < 5 {
        match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> {
            Test.assert_eq(ir_function_count_tag(function, 62), 1)
            nil
          }
          _ -> {
            Test.assert_true(false)
            nil
          }
        }
        index = index + 1
        nil
      }
      nil
    }
    _ -> {
      Test.assert_true(false)
      nil
    }
  }
}

