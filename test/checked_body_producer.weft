test "checked expression application respects effect authority" {
  let source = "effect Read { fn get() -> i64 } "
  Test.assert_true(
    match checked(
      str_concat(source, "fn bad(f: () -[Read]> i64) -> i64 { (f)() }"),
      "fixture/checked_body_apply_effect_denied",
      1154
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
  match checked(
    str_concat(source, "fn ok(f: () -[Read]> i64) -[Read]> i64 { (f)() }"),
    "fixture/checked_body_apply_effect_allowed",
    1155
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "parenthesized continuation applications remain one-shot" {
  Test.assert_true(
    match checked(
      "fn okay(k: Continuation<i64, i64>) -> i64 { (k)(1) }",
      "fixture/checked_body_parenthesized_continuation_once",
      1157
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> i64 { (k)(1) + (k)(2) }",
      "fixture/checked_body_parenthesized_continuation_twice",
      1158
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyFunctionContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
}

test "checked calls require every dependency effect from their environment" {
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
        |> str_concat("fn bad() -> i64 { read() }"),
      "fixture/checked_body_call_effect_missing",
      159
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
        |> str_concat("fn caller() -[Read]> i64 { read() }"),
      "fixture/checked_body_call_effect_available",
      160
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn apply<e>(f: () -[e]> i64) -[e]> i64 { f() }",
      "fixture/checked_body_call_effect_tail",
      161
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad<e>(f: () -[e]> i64) -> i64 { f() }",
      "fixture/checked_body_call_effect_tail_missing",
      162
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectTailUnavailable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
        |> str_concat(
          "fn bad() -> i64 { handle read() { Read.get() -> read() } }"
        ),
      "fixture/checked_body_clause_call_effect_missing",
      163
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
        |> str_concat(
          "fn outer() -[Read]> i64 { handle read() { Read.get() -> read() } }"
        ),
      "fixture/checked_body_clause_call_effect_outer",
      164
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects call arity and argument mismatches" {
  Test.assert_true(
    match checked(
      "fn identity(value: i64) -> i64 { value } fn wrong() -> i64 { identity() }",
      "fixture/checked_body_call_arity",
      116
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn identity(value: bool) -> bool { value } fn wrong() -> bool { identity(1) }",
      "fixture/checked_body_call_argument",
      117
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked generic calls retain ordered type arguments and specialized result" {
  match checked(
    "fn identity<T>(value: T) -> T { value } fn caller() -> i64 { identity<i64>(5) }",
    "fixture/checked_body_generic_call",
    1161
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedGenericCallKind -> true
          _ -> false
        }
      )
      match expressions.generic_call_parts(root) {
        (call, arguments) -> {
          Test.assert_true(
            match expressions.kind(call) {
              CheckedDirectCallKind -> true
              _ -> false
            }
          )
          Test.assert_eq_usize(expressions.type_list_len(arguments), 1)
          let catalog = expressions.types()
          let argument = expressions.type_list_at(arguments, 0)
          Test.assert_true(
            semantic_type_catalog_equal(catalog, argument, expressions.result_type(root))
          )
          Test.assert_true(
            match catalog.graph_for(argument) {
              Some(graph) -> match semantic_type_graph_node(graph, argument) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

fn checked_specialization_issue_name(issue: CheckedSpecializationIssue) -> str {
  match issue {
    CheckedSpecializationFunctionMissing(_) -> "function missing"
    CheckedSpecializationTypeArgumentCount(_, expected, found) -> {
      let wanted = num_scalar_usize_to_i64(expected).unwrap()
      let given = num_scalar_usize_to_i64(found).unwrap()
      "type argument count {wanted} != {given}"
    }
    CheckedSpecializationLoweringRejected(_, _) -> "lowering rejected"
    CheckedSpecializationCallSignatureMismatch(identity) -> match identity {
      DeclaredFunctionIdentity(declaration) -> match declaration_identity_name(declaration).text() {
        Some(name) -> str_concat("call signature mismatch in ", name)
        None -> "call signature mismatch"
      }
      _ -> "call signature mismatch"
    }
    CheckedSpecializationLayoutUnavailable(_) -> "layout unavailable"
    CheckedSpecializationRewriteMismatch -> "rewrite mismatch"
  }
}

-- The method's own type arguments of a call rooted at `root`, when the call is
-- published as a generic wrapper around a method call; `None` otherwise.
fn checked_method_type_arguments(
  expressions: borrow CheckedExprGraph,
  root: CheckedExprId
) -> Option<CheckedTypeListId> {
  match expressions.kind(root) {
    CheckedGenericCallKind -> match expressions.generic_call_parts(root) {
      (call, arguments) -> match expressions.kind(call) {
        CheckedMethodCallKind -> Some(arguments)
        _ -> None<CheckedTypeListId>()
      }
    }
    _ -> None<CheckedTypeListId>()
  }
}

fn checked_primitive_name(value: SemanticPrimitive) -> str {
  match value {
    SemanticI64 -> "i64"
    SemanticStr -> "str"
    SemanticBool -> "bool"
    _ -> "other"
  }
}

fn checked_type_is_primitive(
  catalog: borrow SemanticTypeCatalog,
  value: SemanticTypeId,
  wanted: SemanticPrimitive
) -> bool {
  match catalog.graph_for(value) {
    Some(graph) -> match semantic_type_graph_node(graph, value) {
      SemanticPrimitiveNode(found) -> checked_primitive_name(found) == checked_primitive_name(
        wanted
      )
      _ -> false
    }
    None -> false
  }
}

-- A method with type parameters of its own is instantiated at each call, the
-- way a generic function is: the checker infers or reads the arguments, and
-- publishes them beside the method call for specialization.
fn checked_single_method_type_argument(
  source: str,
  name: str,
  discriminator: i64,
  function: usize,
  wanted: SemanticPrimitive
) -[Test]> bool {
  match checked(source, name, discriminator) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match checked_method_type_arguments(expressions, product.function(function).body) {
        Some(arguments) -> {
          let catalog = expressions.types()
          expressions.type_list_len(arguments) == __i64_to_usize(1) and checked_type_is_primitive(
            catalog,
            expressions.type_list_at(arguments, 0),
            wanted
          )
        }
        None -> false
      }
    }
    _ -> false
  }
}

test "checked method calls instantiate the method's own type parameters" {
  let pick = "type Box { value: i64 } impl Box { fn pick<A>(self, chosen: A) -> A { chosen } } "
  -- Inferred from a value argument.
  Test.assert_true(
    checked_single_method_type_argument(
      str_concat(pick, "fn caller(box: Box) -> i64 { box.pick(5) }"),
      "fixture/checked_method_generic_inferred",
      1901,
      1,
      SemanticI64
    )
  )
  -- Written explicitly.
  Test.assert_true(
    checked_single_method_type_argument(
      str_concat(pick, "fn caller(box: Box) -> str { box.pick<str>(\"a\") }"),
      "fixture/checked_method_generic_explicit",
      1902,
      1,
      SemanticStr
    )
  )
  -- Inferred through a callback whose parameter types depend on it.
  Test.assert_true(
    checked_single_method_type_argument(
      "type Box { value: i64 } "
        |> str_concat("impl Box { fn fold<A>(self, init: A, f: (A, i64) -> A) -> A { ")
        |> str_concat("f(init, self.value) } } ")
        |> str_concat("fn caller(box: Box) -> i64 { box.fold(0, (sum, value) => sum + value) }"),
      "fixture/checked_method_generic_callback",
      1903,
      1,
      SemanticI64
    )
  )
  -- A generic implementation's method adds a parameter of its own; only that
  -- parameter is published, since the receiver fixes the implementation's.
  Test.assert_true(
    checked_single_method_type_argument(
      "type Holder<T> { value: T } "
        |> str_concat(
          "impl<T> Holder<T> { fn map<U>(self, f: (T) -> U) -> U { f(self.value) } } "
        )
        |> str_concat("fn caller(holder: Holder<i64>) -> bool { holder.map(value => value > 0) }"),
      "fixture/checked_method_generic_impl",
      1904,
      1,
      SemanticBool
    )
  )
}

test "checked method calls reject invalid instantiations of their own type parameters" {
  let pick = "type Box { value: i64 } impl Box { fn pick<A>(self, chosen: A) -> A { chosen } } "
  Test.assert_true(
    match checked(
      str_concat(pick, "fn caller(box: Box) -> str { box.pick(5) }"),
      "fixture/checked_method_generic_result_mismatch",
      1905
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      str_concat(pick, "fn caller(box: Box) -> bool { box.pick<bool>(5) }"),
      "fixture/checked_method_generic_explicit_mismatch",
      1906
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      str_concat(pick, "fn caller(box: Box) -> i64 { box.pick<i64, bool>(5) }"),
      "fixture/checked_method_generic_explicit_arity",
      1907
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 2)) -> true
      _ -> false
    }
  )
  -- Nothing determines the parameter of a method that only returns it.
  Test.assert_true(
    match checked(
      "type Box { value: i64 } impl Box { fn make<A>(self) -> A? { nil } } "
        |> str_concat("fn caller(box: Box) -> i64? { box.make() }"),
      "fixture/checked_method_generic_uninferable",
      1908
    ) {
      CheckedBodiesRejected(CheckedBodyProducerGenericInferenceIncomplete(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "trait Mark { fn mark(self: Self) -> i64 } type Box { value: i64 } "
        |> str_concat("impl Box { fn marked<A: Mark>(self, value: A) -> i64 { value.mark() } } ")
        |> str_concat("fn caller(box: Box) -> i64 { box.marked(5) }"),
      "fixture/checked_method_generic_bound",
      1909
    ) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
}

test "checked specialization instantiates a method once per type argument" {
  match checked(
    "type Box { value: i64 } impl Box { fn pick<A>(self, chosen: A) -> A { chosen } } "
      |> str_concat("fn main() -> i64 { let box = Box { value: 1 } ")
      |> str_concat("if box.pick(true) { box.pick(41) + box.pick(1) } else { 0 } }"),
    "fixture/checked_method_generic_plan",
    1910
  ) {
    CheckedBodiesAccepted(product) -> match plan_checked_body_specializations(product) {
      CheckedSpecializationAccepted(plan) -> {
        -- `main`, `pick<bool>` and `pick<i64>`.
        Test.assert_eq(num_scalar_usize_to_i64(plan.instance_count()).unwrap(), 3)
        Test.assert_eq(plan.instruction_count(62), 0)
      }
      CheckedSpecializationRejected(issue) -> Test.assert_str_eq(
        checked_specialization_issue_name(issue),
        "specialization accepted"
      )
    }
    _ -> Test.assert_str_eq("checking rejected", "specialization accepted")
  }
}

test "checked specialization combines an implementation's and a method's type arguments" {
  match checked(
    "type Holder<T> { value: T } "
      |> str_concat(
        "impl<T> Holder<T> { fn apply<U>(self, f: (T) -> U) -> U { f(self.value) } } "
      )
      |> str_concat("fn main() -> i64 { let holder = Holder { value: 4 } ")
      |> str_concat("if holder.apply(value => value > 3) { holder.apply(value => value + 1) } ")
      |> str_concat("else { 0 } }"),
    "fixture/checked_method_generic_impl_plan",
    1911
  ) {
    CheckedBodiesAccepted(product) -> match plan_checked_body_specializations(product) {
      CheckedSpecializationAccepted(plan) -> {
        -- `main`, and `apply` at `(i64, bool)` and at `(i64, i64)`.
        Test.assert_eq(num_scalar_usize_to_i64(plan.instance_count()).unwrap(), 3)
        -- Both method calls became direct calls. Each `apply` keeps its one
        -- closure application, which closure lowering resolves.
        Test.assert_eq(plan.instruction_count(62), 2)
      }
      CheckedSpecializationRejected(issue) -> Test.assert_str_eq(
        checked_specialization_issue_name(issue),
        "specialization accepted"
      )
    }
    _ -> Test.assert_str_eq("checking rejected", "specialization accepted")
  }
}

test "checked generic calls preserve two argument identities in declaration order" {
  match checked(
    "fn choose<A, B>(left: A, right: B) -> B { right } fn caller() -> bool { choose<i64, bool>(5, true) }",
    "fixture/checked_body_generic_order",
    1167
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      match expressions.generic_call_parts(root) {
        (_, arguments) -> {
          Test.assert_eq_usize(expressions.type_list_len(arguments), 2)
          let catalog = expressions.types()
          let first = expressions.type_list_at(arguments, 0)
          let second = expressions.type_list_at(arguments, 1)
          Test.assert_true(
            match catalog.graph_for(first) {
              Some(graph) -> match semantic_type_graph_node(graph, first) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            semantic_type_catalog_equal(catalog, second, expressions.result_type(root))
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn identity<T>(value: T) -> T { value } fn forward<U>(value: U) -> U { identity<U>(value) }",
      "fixture/checked_body_generic_owner_argument",
      1170
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

