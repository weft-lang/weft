test "checked constructor patterns retain generic payloads and bindings" {
  match checked(
    "type Choice<T> { Empty, Pair(T, i64) } "
    |> str_concat(
      "fn pick(value: Choice<str>) -> str { match value { Pair(text, _) -> text _ -> \"none\" } } "
    )
    |> str_concat(
      "type Wrap<T> { Wrap(T) } fn unwrap(value: Wrap<i64>) -> i64 { match value { Wrap(n) -> n } }"
    )
    |> str_concat(
      " type Chain<T> { End, Link(T, Chain<T>) } "
    )
    |> str_concat(
      "fn tail(value: Chain<i64>) -> Chain<i64> { match value { Link(_, rest) -> rest _ -> value } }"
    ),
    "fixture/checked_body_constructor_patterns",
    1184
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedConstructorPatternKind -> true
              _ -> false
            }
          )
          let (declaration, children, qualifier) = patterns.constructor_parts(arm.pattern)
          Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), "Pair")
          Test.assert_true(qualifier == nil)
          Test.assert_eq_usize(patterns.pattern_list_len(children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 0)),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedConstructorPatternKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(product.function(2).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          let (_, children, _) = patterns.constructor_parts(arm.pattern)
          Test.assert_eq_usize(patterns.pattern_list_len(children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 1)),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

