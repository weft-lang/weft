test "checked body producer resolves direct calls by declaration identity" {
  match checked(
    "fn identity(value: i64) -> i64 { value } fn call() -> i64 { identity(7) }",
    "fixture/checked_body_direct_call",
    114
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      let (function, arguments) = expressions.direct_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedDirectCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        function_identity_eq(function, product.function(0).signature.identity)
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes nested call arguments after their children" {
  match checked(
    "fn pair(left: i64, right: i64) -> i64 { left * 10 + right } "
    |> str_concat("fn caller() -> i64 { pair(pair(1, 2), pair(3, 4)) }"),
    "fixture/checked_body_nested_calls",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, outer) = expressions.direct_call_parts(product.function(1).body)
      Test.assert_eq_usize(expressions.expression_list_len(outer), 2)
      let left = expressions.expression_list_at(outer, 0)
      let right = expressions.expression_list_at(outer, 1)
      Test.assert_true(match expressions.kind(left) { CheckedDirectCallKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(right) { CheckedDirectCallKind -> true, _ -> false }
      )
      let (_, left_arguments) = expressions.direct_call_parts(left)
      let (_, right_arguments) = expressions.direct_call_parts(right)
      Test.assert_eq_usize(expressions.expression_list_len(left_arguments), 2)
      Test.assert_eq_usize(expressions.expression_list_len(right_arguments), 2)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes specialized trait method calls" {
  match checked(
    "trait Same { fn same(self, other: Self) -> bool } "
    |> str_concat("type Box<T> { value: T } ")
    |> str_concat(
      "impl<T> Same for Box<T> { fn same(self, other: Self) -> bool { true } } "
    )
    |> str_concat(
      "fn compare(left: Box<i64>, right: Box<i64>) -> bool { left.same(right) }"
    ),
    "fixture/checked_body_trait_method",
    172
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments) = expressions.method_call_parts(root)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "trait Source { type Item fn get(self) -> Self.Item } "
    |> str_concat("type Box { value: i64 } ")
    |> str_concat("impl Source for Box { type Item = i64 ")
    |> str_concat("fn get(self) -> Self.Item { self.value } } ")
    |> str_concat("fn read(box: Box) -> i64 { box.get() }"),
    "fixture/checked_body_associated_method",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      let (declaration, _, arguments) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "get"
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "type Box<T> { value: T } impl<T> Box<T> { "
    |> str_concat("fn keep(self) -> Self { self } ")
    |> str_concat("fn value(self) -> T { self.value } ")
    |> str_concat("fn retained(self) -> T { self.keep().value() } }"),
    "fixture/checked_body_inherent_self",
    182
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (declaration, receiver, arguments) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "value"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer resolves methods through generic signature bounds" {
  match checked(
    "trait Show { type Label fn show(self) -> str } "
    |> str_concat(
      "fn render<T: Show & { type Label = str }>(value: T) -> str { value.show() }"
    ),
    "fixture/checked_body_bound_method",
    173
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (declaration, receiver, arguments) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "show"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer retains specialized method results across a block" {
  match checked(
    "trait Chain { fn keep(self) -> Self fn same(self, other: Self) -> bool } "
    |> str_concat("type Box<T> { value: T } ")
    |> str_concat(
      "impl<T> Chain for Box<T> { fn keep(self) -> Self { self } "
    )
    |> str_concat("fn same(self, other: Self) -> bool { true } } ")
    |> str_concat(
      "fn compare(left: Box<i64>, right: Box<i64>) -> bool { "
    )
    |> str_concat("let kept = left.keep() kept.same(right) }"),
    "fixture/checked_body_method_result",
    177
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (_, _, result) = expressions.let_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedLetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(result) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments) = expressions.method_call_parts(result)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects invalid method selections" {
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> i64 { value.missing() }",
      "fixture/checked_body_method_missing",
      174
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } impl Box { fn read(self) -> i64 { 1 } } "
    |> str_concat("impl Box { fn read(self) -> i64 { 2 } } ")
    |> str_concat("fn bad(value: Box) -> i64 { value.read() }"),
      "fixture/checked_body_method_ambiguous",
      175
    ) {
      CheckedBodiesRejected(CheckedBodyProducerAmbiguousMethod(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } "
    |> str_concat("impl Box { fn same(self, other: Box) -> bool { true } } ")
    |> str_concat("fn bad(value: Box) -> bool { value.same() }"),
      "fixture/checked_body_method_arity",
      176
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } "
    |> str_concat("impl Box { fn same(self, other: Box) -> bool { true } } ")
    |> str_concat("fn bad(value: Box) -> bool { value.same(1) }"),
      "fixture/checked_body_method_argument",
      178
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } type Box { value: i64 } "
    |> str_concat(
      "impl Box { fn read(self) -[Read]> i64 { Read.get() } } "
    )
    |> str_concat("fn bad(value: Box) -> i64 { value.read() }"),
      "fixture/checked_body_method_effect",
      179
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "trait Show { fn show(self) -> str } type Wrap<T> { value: T } "
    |> str_concat("impl Show for i64 { fn show(self) -> str { \"i64\" } } ")
    |> str_concat(
      "impl<T: Show> Show for Wrap<T> { fn show(self) -> str { \"wrap\" } } "
    )
    |> str_concat("fn bad(value: Wrap<bool>) -> str { value.show() }"),
      "fixture/checked_body_method_bound",
      180
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer applies function-valued local bindings" {
  match checked(
    "fn apply(f: (i64) -> i64, value: i64) -> i64 { f(value) }",
    "fixture/checked_body_apply",
    115
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, _) = expressions.apply_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer applies a parenthesized function projection" {
  match checked(
    "type FunctionBox { f: (i64) -> i64 } fn run(box: FunctionBox) -> i64 { (box.f)(5) }",
    "fixture/checked_body_projected_apply",
    1151
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, call_site) = expressions.apply_parts(root)
      Test.assert_true(match expressions.kind(root) { CheckedApplyKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedDeclaredFieldAccessKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(call_site > expressions.range(callee).end)
      Test.assert_eq(
        expressions.integer_value(expressions.expression_list_at(arguments, 0)),
        5
      )
    }
    _ -> Test.assert_true(false)
  }
}

