      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(i64, bool) } fn bad(value: Choice) -> i64 { match value { Pair(n) -> n _ -> 0 } }",
      "fixture/checked_body_constructor_arity",
      1186
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorPatternArityMismatch(2, 1)) -> true
      _ -> false
    }
