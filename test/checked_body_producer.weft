}

test "checked interpolation retains concat and canonical Display selection" {
  match checked(
    r#"pub trait Display { fn display(self) -> str }
impl Display for i64 { fn display(self: i64) -> str { "number" } }
fn render(value: i64) -> str { i"n={value}" }
fn render_many(value: i64) -> str { i"{{n}}={value}:end" }"#,
    "stdlib/display",
    1271
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_eq(
        match expressions.kind(root) {
          CheckedInterpolationConcatKind -> 1
          CheckedMethodCallKind -> 2
          CheckedStringKind -> 3
          CheckedBlockKind -> 4
          _ -> 0
        },
        1
      )
      match expressions.interpolation_concat_parts(root) {
        (left, right) -> {
          Test.assert_true(
            match expressions.kind(left) {
              CheckedStringKind -> true
              _ -> false
            }
          )
          Test.assert_str_eq(expressions.string_value(left), "n=")
          Test.assert_true(
            match expressions.kind(right) {
              CheckedMethodCallKind -> true
              _ -> false
            }
          )
          match expressions.method_call_parts(right) {
            (method, receiver, arguments) -> {
              Test.assert_str_eq(declaration_identity_name(method).text().unwrap(), "display")
              Test.assert_true(
                match expressions.kind(receiver) {
                  CheckedLocalReferenceKind -> true
                  _ -> false
                }
              )
              Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
              Test.assert_true(expressions.range(root).start < expressions.range(receiver).start)
              Test.assert_eq_usize(
                expressions.range(right).start,
                expressions.range(receiver).start
              )
              Test.assert_eq_usize(expressions.range(right).end, expressions.range(receiver).end)
            }
          }
        }
      }
      let many = product.function(2).body
      match expressions.interpolation_concat_parts(many) {
        (prefix, suffix) -> {
          Test.assert_str_eq(expressions.string_value(suffix), ":end")
          match expressions.interpolation_concat_parts(prefix) {
            (literal, _) -> Test.assert_str_eq(expressions.string_value(literal), "{n}=")
          }
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

