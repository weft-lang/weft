test "checked body producer publishes inferred and explicit effect performs" {
  match checked(
    "effect Box<T> { fn put(value: T) -> nil fn get() -> T } "
      |> str_concat(
        "fn exchange(value: i64) -[Box<i64>]> i64 { Box.put(value) Box<i64>.get() } "
      )
      |> str_concat("fn nested() -[Box<i64>]> nil { Box.put(Box.get()) } ")
      |> str_concat(
        "fn generic<T>(value: T) -[Box<T>]> T { Box.put(value) Box<T>.get() }"
      ),
    "fixture/checked_body_perform",
    147
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let effects = product.effects()
      let root = product.function(0).body
      let put = expressions.block_first(root)
      let get = expressions.block_rest(root)
      Test.assert_true(
        match (expressions.kind(put), expressions.kind(get)) {
          (CheckedPerformKind, CheckedPerformKind) -> true
          _ -> false
        }
      )
      match effects.inspect(expressions.perform_detail(put)) {
        CheckedPerformDetail(value) -> {
          Test.assert_str_eq(
            declaration_identity_name(value.effect_declaration).text().unwrap(),
            "Box"
          )
          Test.assert_str_eq(
            declaration_identity_name(value.operation).text().unwrap(),
            "put"
          )
          Test.assert_eq_usize(expressions.expression_list_len(value.arguments), 1)
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(value.arguments, 0)) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
      match effects.inspect(expressions.perform_detail(get)) {
        CheckedPerformDetail(value) -> {
          Test.assert_str_eq(
            declaration_identity_name(value.operation).text().unwrap(),
            "get"
          )
          Test.assert_eq_usize(expressions.expression_list_len(value.arguments), 0)
        }
        _ -> Test.assert_true(false)
      }
      let types = expressions.types()
      Test.assert_true(
        semantic_type_catalog_equal(
          types,
          expressions.result_type(get),
          expressions.result_type(root)
        )
      )
      let nested = product.function(1).body
      match effects.inspect(expressions.perform_detail(nested)) {
        CheckedPerformDetail(value) -> {
          let argument = expressions.expression_list_at(value.arguments, 0)
          Test.assert_true(
            match expressions.kind(argument) {
              CheckedPerformKind -> true
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
      let generic = product.function(2).body
      Test.assert_true(
        match (
          expressions.kind(expressions.block_first(generic)),
          expressions.kind(expressions.block_rest(generic)),
        ) {
          (CheckedPerformKind, CheckedPerformKind) -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

