fn control_kind_code(kind: CheckedExprKind) -> i64 {
  match kind {
    CheckedLoopKind -> 1
    CheckedIfKind -> 2
    CheckedBreakKind -> 3
    CheckedBreakNoValueKind -> 4
    CheckedContinueKind -> 5
    _ -> 0
  }
}

fn binary_operator_code(operator: CheckedBinaryOperator) -> i64 {
  match operator {
    CheckedAdd -> 1
    CheckedSubtract -> 2
    CheckedMultiply -> 3
    CheckedDivide -> 4
    CheckedEqual -> 5
    CheckedNotEqual -> 6
    CheckedLessThan -> 7
    CheckedGreaterThan -> 8
    CheckedLessOrEqual -> 9
    CheckedGreaterOrEqual -> 10
    CheckedModulo -> 11
    CheckedLogicalAnd -> 12
    CheckedLogicalOr -> 13
    CheckedBitAnd -> 14
    CheckedBitOr -> 15
    CheckedBitXor -> 16
    CheckedShiftLeft -> 17
    CheckedShiftRight -> 18
  }
}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

fn scope_for(module: RegisteredModule) -> RegistrationScope {
  let builder = registration_scope.registration_builder()
  registration_scope.registration_builder_add(builder, module)
  registration_scope.registration_builder_freeze(builder)
}

fn checked_with_conformance(
  text: str,
  name: str,
  discriminator: i64,
  conforms: bool
) -[Test]> CheckedBodyCheckResult {
  let module = registered(text, named_module_identity(name, discriminator))
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      module,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(conforms)
    }
    _ -> panic("expected resolved signatures")
  }
}

fn checked(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  checked_with_conformance(text, name, discriminator, false)
}

fn checked_with_result_and_fail(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  let result_module = registered(
    "pub type Result<T, E> { Ok(T), Err(E) }",
    named_module_identity("stdlib/result", discriminator)
  )
  let fail_module = registered(
    "pub effect Fail<E> { fn fail(error: E) -> never }",
    named_module_identity("stdlib/fail", discriminator)
  )
  let consumer = registered(text, named_module_identity(name, discriminator))
  let result_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    result_module.identity,
    false
  )
  let fail_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(1).unwrap(),
    fail_module.identity,
    false
  )
  let modules = [result_module, fail_module, consumer]
  let imports = [result_edge, fail_edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved Result and Fail signatures")
  }
}

fn checked_with_maybe(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  let maybe_module = registered(
    "pub effect Maybe { fn none() -> never }",
    named_module_identity("stdlib/maybe", discriminator)
  )
  let consumer = registered(text, named_module_identity(name, discriminator))
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    maybe_module.identity,
    false
  )
  let modules = [maybe_module, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved Maybe signatures")
  }
}

test "checked body producer publishes literal functions in declaration order" {
  match checked(
    "fn integer() -> i64 { 7 } fn flag() -> bool { true } fn empty() -> nil { nil }",
    "fixture/checked_body_literals",
    91
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let integer = product.function(0).body
      let boolean = product.function(1).body
      let nil_value = product.function(2).body
      Test.assert_true(
        match expressions.kind(integer) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
      Test.assert_eq(expressions.integer_value(integer), 7)
      Test.assert_true(
        match expressions.kind(boolean) {
          CheckedBooleanKind -> true
          _ -> false
        }
      )
      Test.assert_true(expressions.boolean_value(boolean))
      Test.assert_true(
        match expressions.kind(nil_value) {
          CheckedNilKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked integer literals retain their contextual primitive type" {
  match checked(
    "fn small() -> i8 { 7 }",
    "fixture/checked_body_contextual_integer",
    92
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let catalog = expressions.types()
      match catalog.graph_for(expressions.result_type(root)) {
        Some(graph) -> Test.assert_true(
          match semantic_type_graph_node(graph, expressions.result_type(root)) {
            SemanticPrimitiveNode(SemanticI8) -> true
            _ -> false
          }
        )
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked arrays retain contextual elements and authored order" {
  match checked(
    "fn values() -> [i8; 3] { [1, 2, 3] }",
    "fixture/checked_body_array_context",
    921
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let array = product.function(0).body
      Test.assert_true(
        match expressions.kind(array) {
          CheckedArrayLiteralKind -> true
          _ -> false
        }
      )
      match expressions.array_literal_parts(array) {
        (elements, element_type) -> {
          Test.assert_eq_usize(expressions.expression_list_len(elements), 3)
          Test.assert_eq(
            expressions.integer_value(expressions.expression_list_at(elements, 0)),
            1
          )
          Test.assert_eq(
            expressions.integer_value(expressions.expression_list_at(elements, 1)),
            2
          )
          Test.assert_eq(
            expressions.integer_value(expressions.expression_list_at(elements, 2)),
            3
          )
          let catalog = expressions.types()
          match catalog.graph_for(element_type) {
            Some(graph) -> Test.assert_true(
              match semantic_type_graph_node(graph, element_type) {
                SemanticPrimitiveNode(SemanticI8) -> true
                _ -> false
              }
            )
            None -> Test.assert_true(false)
          }
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked arrays support empty and nested contextual values" {
  match checked(
    "fn empty() -> [i64; 0] { [] } fn nested() -> [[i64; 1]; 2] { [[1], [2]] }",
    "fixture/checked_body_array_nested",
    922
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.array_literal_parts(product.function(0).body) {
        (elements, _) -> Test.assert_eq_usize(expressions.expression_list_len(elements), 0)
      }
      match expressions.array_literal_parts(product.function(1).body) {
        (elements, _) -> {
          Test.assert_eq_usize(expressions.expression_list_len(elements), 2)
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(elements, 0)) {
              CheckedArrayLiteralKind -> true
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked arrays infer nested element types without a declared result" {
  match checked(
    "fn values() -> any { [[1], [2]] }",
    "fixture/checked_body_array_nested_inferred",
    928
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.array_literal_parts(product.function(0).body) {
        (elements, _) -> Test.assert_eq_usize(expressions.expression_list_len(elements), 2)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked inferred arrays retain heterogeneous element types" {
  match checked(
    "fn values() -> any { [1, \"x\"] }",
    "fixture/checked_body_array_inferred",
    923
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.array_literal_parts(product.function(0).body) {
        (elements, _) -> {
          Test.assert_eq_usize(expressions.expression_list_len(elements), 2)
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(elements, 0)) {
              CheckedIntegerKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(elements, 1)) {
              CheckedStringKind -> true
              _ -> false
            }
          )
          let result_type = expressions.result_type(product.function(0).body)
          let catalog = expressions.types()
          match catalog.graph_for(result_type) {
            Some(graph) -> Test.assert_true(
              match semantic_type_graph_node(graph, result_type) {
                SemanticArrayNode(_, 2) -> true
                _ -> false
              }
            )
            None -> Test.assert_true(false)
          }
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked arrays reject mismatched lengths and elements" {
  Test.assert_true(
    match checked(
      "fn values() -> [i64; 2] { [1] }",
      "fixture/checked_body_array_length",
      924
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn values() -> [i64; 2] { [1, \"x\"] }",
      "fixture/checked_body_array_element",
      925
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked arrays publish nested call results without interleaving list edges" {
  match checked(
    "fn twice(value: i64) -> i64 { value + value } "
    |> str_concat("fn values() -> [i64; 2] { [twice(1), twice(2)] }"),
    "fixture/checked_body_array_calls",
    926
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.array_literal_parts(product.function(1).body) {
        (elements, _) -> {
          Test.assert_eq_usize(expressions.expression_list_len(elements), 2)
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(elements, 0)) {
              CheckedDirectCallKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(expressions.expression_list_at(elements, 1)) {
              CheckedDirectCallKind -> true
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked arrays cannot store a one-shot continuation" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { [k] }",
      "fixture/checked_body_array_continuation_escape",
      927
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked indexing retains fixed length and element types" {
  match checked(
    "fn length(values: [i64; 3]) -> usize { values.len } "
    |> str_concat("fn item(values: [i64; 3], at: usize) -> i64 { values[at] }"),
    "fixture/checked_body_fixed_indexing",
    929
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let length = product.function(0).body
      let item = product.function(1).body
      Test.assert_true(
        match expressions.kind(length) {
          CheckedIndexedLengthKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(item) {
          CheckedIndexedGetKind -> true
          _ -> false
        }
      )
      match expressions.indexed_length_parts(length) {
        (base, element_type, size) -> {
          Test.assert_true(size == 3)
          Test.assert_true(
            match expressions.kind(base) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
          let catalog = expressions.types()
          Test.assert_true(
            match catalog.graph_for(element_type) {
              Some(graph) -> match semantic_type_graph_node(graph, element_type) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
        }
      }
      match expressions.indexed_get_parts(item) {
        CheckedIndexedGet(base, index, _, size) -> {
          Test.assert_true(size == 3)
          Test.assert_true(
            match expressions.kind(base) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(index) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
        }
      }
      let catalog = expressions.types()
      let result = expressions.result_type(length)
      Test.assert_true(
        match catalog.graph_for(result) {
          Some(graph) -> match semantic_type_graph_node(graph, result) {
            SemanticPrimitiveNode(SemanticUsize) -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked indexing supports borrowed slices" {
  match checked(
    "fn length(values: borrow [i64]) -> usize { values.len } "
    |> str_concat("fn item(values: borrow [i64], at: usize) -> i64 { values[at] }"),
    "fixture/checked_body_slice_indexing",
    930
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.indexed_length_parts(product.function(0).body) {
        (_, _, size) -> Test.assert_true(size == - 1)
      }
      match expressions.indexed_get_parts(product.function(1).body) {
        CheckedIndexedGet(_, _, _, size) -> Test.assert_true(size == - 1)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked indexing supports body-local arrays" {
  match checked(
    "fn local() -> i64 { let values: [i64; 2] = [1, 2]; values[0] } "
    |> str_concat("fn direct() -> i64 { [3, 4][1] }"),
    "fixture/checked_body_local_indexing",
    934
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, array, indexed) = expressions.let_parts(product.function(0).body)
      Test.assert_true(
        match expressions.kind(array) {
          CheckedArrayLiteralKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(indexed) {
          CheckedIndexedGetKind -> true
          _ -> false
        }
      )
      match expressions.indexed_get_parts(product.function(1).body) {
        CheckedIndexedGet(base, _, _, size) -> {
          Test.assert_true(size == 2)
          Test.assert_true(
            match expressions.kind(base) {
              CheckedArrayLiteralKind -> true
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked indexing rejects invalid bases indexes and results" {
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> i64 { value[0] }",
      "fixture/checked_body_index_base",
      931
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIndexedBaseRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(values: [i64; 2]) -> i64 { values[\"wrong\"] }",
      "fixture/checked_body_index_argument",
      932
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(values: [i64; 2]) -> str { values[0] }",
      "fixture/checked_body_index_result",
      933
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(values: [Continuation<i64, i64>; 1]) -> Continuation<i64, i64> { values[0] }",
      "fixture/checked_body_index_continuation",
      935
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked indexed writes retain fixed and dynamic bounds facts" {
  match checked(
    "fn fixed() -> nil { let mut values: [i64; 2] = [1, 2]; values[0] = 3 } "
    |> str_concat("fn view(values: [mut i64], at: usize) -> nil { values[at] = 4 }"),
    "fixture/checked_body_indexed_writes",
    936
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, _, fixed) = expressions.let_mut_parts(product.function(0).body)
      let dynamic = product.function(1).body
      Test.assert_true(
        match expressions.kind(fixed) {
          CheckedIndexedSetKind -> true
          _ -> false
        }
      )
      match expressions.indexed_set_parts(fixed) {
        CheckedIndexedSet(base, index, value, _, size) -> {
          Test.assert_true(size == 2)
          Test.assert_true(
            match expressions.kind(base) {
              CheckedLocalReferenceKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(index) {
              CheckedIntegerKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match expressions.kind(value) {
              CheckedIntegerKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.indexed_set_parts(dynamic) {
        CheckedIndexedSet(_, _, _, _, size) -> Test.assert_true(size == - 1)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked indexed writes require a named writable container" {
  Test.assert_true(
    match checked(
      "fn bad() -> nil { let values: [i64; 1] = [0]; values[0] = 1 }",
      "fixture/checked_body_indexed_immutable_array",
      937
    ) {
      CheckedBodiesRejected(CheckedBodyProducerImmutableAssignment(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(values: [i64]) -> nil { values[0] = 1 }",
      "fixture/checked_body_indexed_immutable_slice",
      938
    ) {
      CheckedBodiesRejected(CheckedBodyProducerImmutableAssignment(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad() -> nil { [1, 2][0] = 3 }",
      "fixture/checked_body_indexed_temporary",
      939
    ) {
