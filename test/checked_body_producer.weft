test "checked body producer contextualizes trusted Unsafe cast results" {
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} fn cast(value: any) -[Unsafe]> *i64 { Unsafe.transmute(value) }",
      "runtime/fixture_contextual_unsafe",
