test "checked generic calls enforce trait bounds after substitution" {
  let source = "trait Mark { fn mark(self: Self) -> i64 } "
    |> str_concat("fn identity<T: Mark>(value: T) -> T { value } ")
    |> str_concat("fn caller() -> i64 { identity<i64>(5) }")
  Test.assert_true(
    match checked(source, "fixture/checked_body_generic_bound_refused", 1165) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_conformance(
      source,
      "fixture/checked_body_generic_bound_accepted",
      1166,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  let inferred = "trait Mark { fn mark(self: Self) -> i64 } "
    |> str_concat("fn identity<T: Mark>(value: T) -> T { value } ")
    |> str_concat("fn caller() -> i64 { identity(5) }")
  Test.assert_true(
    match checked(inferred, "fixture/checked_body_inferred_bound_refused", 1221) {
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_conformance(
      inferred,
      "fixture/checked_body_inferred_bound_accepted",
      1222,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

