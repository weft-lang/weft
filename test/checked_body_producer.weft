    },
    "accepted"
  )
  Test.assert_str_eq(
    match checked_with_conformance(
      "trait Build { type Output } type Box<T> = opaque i64 "
    |> str_concat(
      "fn first<S: Build, R: Build>(value: S) -> owned Box<R.Output> { "
    )
    |> str_concat("Box<R.Output>(0) }"),
