test "checked body producer checks contextual and inferred conditional branches" {
  match checked(
    "fn choose(flag: bool) -> i64 { let value = if flag { 1 } else { 2 }; value }",
    "fixture/checked_body_conditional",
    100
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (_, conditional, _) = expressions.let_parts(root)
      Test.assert_true(
        match expressions.kind(conditional) {
          CheckedIfKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.if_condition(conditional)) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn choose(flag: bool) -> i64 { let values = if flag { [1] } else { [2] }; values[0] }",
      "fixture/checked_body_equivalent_array_branches",
      1236
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn choose(flag: bool) -> i64 { let value = if flag { 3 } else { return 4 }; value }",
      "fixture/checked_body_never_conditional_branch",
      1237
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn choose(flag: bool) -> i64 { "
        |> str_concat("let value = match flag { true -> return 4, false -> 3 }; value }"),
      "fixture/checked_body_never_first_match_arm",
      1238
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn choose(flag: bool) -> i64 { "
        |> str_concat("let value = match flag { true -> 3, false -> return 4 }; value }"),
      "fixture/checked_body_never_last_match_arm",
      1239
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer joins unlike inferred conditional branches" {
  Test.assert_true(
    match checked(
      "fn choose() -> i64 { let value = if true { 1 } else { \"other\" }; 0 }",
      "fixture/checked_body_inferred_branch_union",
      101
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn choose() -> i64 { if true { 1 } else { \"other\" } }",
      "fixture/checked_body_contextual_branch_mismatch",
      102
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked match-arm publication permits nested matches" {
  Test.assert_true(
    match checked(
      "fn choose(flag: bool, other: bool) -> i64 { "
        |> str_concat("match flag { true -> match other { true -> 1, false -> 2 }, ")
        |> str_concat("false -> 3 } }"),
      "fixture/checked_body_nested_match_arms",
      1240
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked generic calls infer callback effect tails" {
  Test.assert_true(
    match checked(
      "fn call<F>(callback: (i64) -[F]> i64) -[F]> i64 { callback(1) } "
        |> str_concat("fn pass<E>(callback: (i64) -[E]> i64) -[E]> i64 { call(callback) } ")
        |> str_concat("fn pure(value: i64) -> i64 { value } ")
        |> str_concat("fn value() -> i64 { call(pure) }"),
      "fixture/checked_generic_callback_effect_inference",
      1241
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Alarm { fn ring() -> i64 } "
        |> str_concat("fn call<F>(callback: (i64) -[F]> i64) -[F]> i64 { callback(1) } ")
        |> str_concat("fn ringing(value: i64) -[Alarm]> i64 { Alarm.ring() } ")
        |> str_concat("fn bad() -> i64 { call(ringing) }"),
      "fixture/checked_generic_callback_effect_unavailable",
      1242
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
}

-- A lambda's effects are what its body does: a callee's effect tail binds to
-- them, beyond the atoms the callee's parameter already names.
fn checked_accepts(source: str, name: str, discriminator: i64) -[Test]> bool {
  match checked(source, name, discriminator) {
    CheckedBodiesAccepted(_) -> true
    _ -> false
  }
}

test "checked stored lambdas carry the effects their bodies perform" {
  let log = "effect Log { fn note(value: i64) -> nil } "
    |> str_concat("fn note_twice(value: i64) -[Log]> nil { Log.note(value) Log.note(value) } ")
  -- A pure function may build a closure that performs an effect it lacks.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(log, "fn build() -> i64 { let f = () => note_twice(1) 0 }"),
      "fixture/stored_lambda_effect",
      1989
    ),
    "accepted"
  )
  -- A direct perform of an effect the enclosing function lacks.
  Test.assert_str_eq(
    checked_outcome(
      str_concat(log, "fn build() -> i64 { let f = () => Log.note(1) 0 }"),
      "fixture/stored_lambda_perform",
      1993
    ),
    "accepted"
  )
  -- Its type carries the effect, so a caller that needs it must provide it.
  Test.assert_str_eq(
    checked_outcome(
      log
        |> str_concat("fn run(f: () -[Log]> nil) -[Log]> nil { f() } ")
        |> str_concat("fn relay() -[Log]> nil { let f = () => note_twice(1) run(f) }"),
      "fixture/stored_lambda_effect_passed",
      1990
    ),
    "accepted"
  )
  Test.assert_str_eq(
    checked_outcome(
      str_concat(log, "fn build() -> i64 { let f = () => note_twice(1) f() 0 }"),
      "fixture/stored_lambda_effect_called",
      1991
    ),
    "effect_unavailable"
  )
  Test.assert_str_eq(
    checked_outcome(
      log
        |> str_concat("fn quiet(f: () -> nil) -> nil { f() } ")
        |> str_concat("fn build() -> nil { let f = () => note_twice(1) quiet(f) }"),
      "fixture/stored_lambda_effect_into_pure",
      1992
    ),
    "type_mismatch"
  )
}

test "checked lambdas bind a callee's effect tail from their bodies" {
  let apply = "effect Log { fn note(value: i64) -> nil } "
    |> str_concat("fn apply<T, E>(f: () -[E]> T) -[E]> T { f() } ")
  -- A pure body binds the tail to no effects.
  Test.assert_true(
    checked_accepts(
      str_concat(apply, "fn quiet() -> i64 { apply(() => 7) }"),
      "fixture/lambda_effects_pure",
      1917
    )
  )
  -- An effect the body performs flows into the call's own effects.
  Test.assert_true(
    checked_accepts(
      str_concat(apply, "fn noted() -[Log]> i64 { apply(() => { Log.note(1) 7 }) }"),
      "fixture/lambda_effects_performed",
      1918
    )
  )
  -- A handler inside the lambda keeps the effect inside it.
  Test.assert_true(
    checked_accepts(
      apply
        |> str_concat("fn noisy() -[Log]> i64 { Log.note(1) 5 } ")
        |> str_concat("fn quiet() -> i64 { apply(() => handle noisy() { ")
        |> str_concat("Log.note(value) -> resume(nil) }) }"),
      "fixture/lambda_effects_handled_inside",
      1919
    )
  )
  -- A handler around the call provides what the lambda performs.
  Test.assert_true(
    checked_accepts(
      apply
        |> str_concat("fn quiet() -> i64 { handle apply(() => { Log.note(1) 7 }) { ")
        |> str_concat("Log.note(value) -> resume(nil) } }"),
      "fixture/lambda_effects_handled_around",
      1920
    )
  )
  -- The callee's own atoms stay its own; only the rest binds its tail.
  let run = "effect Counter { fn next() -> i64 } effect Log { fn note(value: i64) -> nil } "
    |> str_concat("fn run<T, E>(f: () -[Counter, E]> T) -[E]> T { ")
    |> str_concat("handle f() { Counter.next() -> resume(1) } } ")
  Test.assert_true(
    checked_accepts(
      str_concat(run, "fn counted() -> i64 { run(() => Counter.next() + 1) }"),
      "fixture/lambda_effects_fixed_atoms",
      1921
    )
  )
  Test.assert_true(
    checked_accepts(
      str_concat(run, "fn counted() -[Log]> i64 { run(() => { Log.note(Counter.next()) 3 }) }"),
      "fixture/lambda_effects_fixed_and_performed",
      1922
    )
  )
}

-- Any function value, not only a lambda written in place, binds a callee's
-- effect tail to what it performs beyond the parameter's own atoms.
fn checked_row_outcome(program: str, discriminator: i64) -[Test]> str {
  checked_outcome(
    "effect Report { fn report(value: i64) -> i64 } "
      |> str_concat("effect Other { fn other() -> i64 } ")
      |> str_concat("fn collect<T, E>(body: () -[Report, E]> T) -[E]> T { ")
      |> str_concat("handle body() { Report.report(value) -> resume(0) } } ")
      |> str_concat("fn both() -[Report, Other]> i64 { Other.other() } ")
      |> str_concat("fn reports() -[Report]> i64 { Report.report(1) } ")
      |> str_concat("fn pure_value() -> i64 { 1 } ")
      |> str_concat(program),
    "fixture/function_value_rows",
    discriminator
  )
}

test "checked function values bind a callee's effect tail from their rows" {
  let accepted = [
    -- A stored lambda, a named function and an annotated binding.
    "fn run() -> i64 { let wired = () => reports() collect(wired) }",
    "fn run() -> i64 { collect(reports) }",
    "fn run() -> i64 { let wired: () -[Report]> i64 = () => reports() collect(wired) }",
    -- The tail binds to the remainder, which the caller must provide.
    "fn run() -[Other]> i64 { collect(both) }",
    "fn run() -[Other]> i64 { let wired = () => Other.other() collect(wired) }",
    -- A pure value binds the tail to no effects.
    "fn run() -> i64 { collect(pure_value) }",
    "fn run() -> i64 { let wired = () => 1 collect(wired) }",
    -- A tail variable alone, or beside other parameters, in either order.
    "fn relay<E>(f: () -[Report, E]> i64) -[E]> i64 { 1 } fn run() -[Other]> i64 { relay(both) }",
    "fn relay<E, X>(x: X, f: () -[Report, E]> i64) -[E]> i64 { 1 } fn run() -[Other]> i64 { relay(0, both) }",
    "fn relay<E>(f: () -[Report, E]> i64) -> i64 { 1 } fn run() -> i64 { relay(both) }",
    -- An open row passed on binds the callee's tail to the enclosing one.
    "fn relay<E>(f: () -[Report, E]> i64) -[E]> i64 { collect(f) }",
    "fn relay<T, E>(f: () -[Report, E]> T) -[E]> T { collect(f) } fn run() -[Other]> i64 { relay(both) }",
    "fn pass<E>(f: () -[E]> i64) -[E]> i64 { f() } fn relay<E>(f: () -[E]> i64) -[E]> i64 { pass(f) }",
    -- Parameters bind from the value's own parameters, even when nothing
    -- else determines them.
    "fn keep<A, E>(f: (A) -[Report, E]> i64) -> i64 { 1 } fn g(x: str) -[Report]> i64 { 1 } fn run() -> i64 { keep(g) }",
    "fn map1<A, B, E>(f: (A) -[E]> B, a: A) -[E]> B { f(a) } fn g(x: str) -[Report]> i64 { 1 } fn run() -[Report]> i64 { map1(g, \"x\") }"
  ]
  let mut index: usize = 0
  while index < accepted.len {
    Test.assert_str_eq(
      checked_row_outcome(accepted[index], 2101 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
}

test "checked function values keep their rows, parameters and results honest" {
  let refused = [
    -- The remainder is the caller's to provide.
    ("fn run() -> i64 { collect(both) }", "effect_unavailable"),
    ("fn run() -> i64 { let wired = () => Other.other() collect(wired) }", "effect_unavailable"),
    (
      "fn relay<E>(f: () -[Report, E]> i64) -[E]> i64 { 1 } fn run() -> i64 { relay(both) }",
      "effect_unavailable"
    ),
    -- A parameter bound from the value refuses a later argument.
    (
      "fn map1<A, B, E>(f: (A) -[E]> B, a: A) -[E]> B { f(a) } fn g(x: str) -[Report]> i64 { 1 } fn run() -[Report]> i64 { map1(g, 1) }",
      "type_mismatch"
    ),
    -- Results and arity still decide.
    (
      "fn need<E>(f: () -[E]> i64) -[E]> i64 { f() } fn s() -> str { \"x\" } fn run() -> i64 { need(s) }",
      "type_mismatch"
    ),
    (
      "fn need<E>(f: () -[Report, E]> i64) -[E]> i64 { 1 } fn two(a: i64, b: i64) -> i64 { a } fn run() -> i64 { need(two) }",
      "type_mismatch"
    ),
    (
      "fn need<T, E>(f: () -[Report, E]> T) -[E]> T { collect(f) } fn run() -[Other]> str { need(both) }",
      "type_mismatch"
    )
  ]
  let mut index: usize = 0
  while index < refused.len {
    let (program, expected) = refused[index]
    Test.assert_str_eq(
      checked_row_outcome(program, 2131 + __u64_to_i64(__usize_to_u64(index))),
      expected
    )
    index = index + 1
  }
}

test "checked lambdas refuse effects their call site cannot provide" {
  let apply = "effect Log { fn note(value: i64) -> nil } "
    |> str_concat("fn apply<T, E>(f: () -[E]> T) -[E]> T { f() } ")
  Test.assert_true(
    match checked(
      str_concat(apply, "fn quiet() -> i64 { apply(() => { Log.note(1) 7 }) }"),
      "fixture/lambda_effects_unavailable",
      1923
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
  -- An effect named by the callee's parameter is not the call site's to give.
  Test.assert_true(
    match checked(
      "effect Counter { fn next() -> i64 } effect Log { fn note(value: i64) -> nil } "
        |> str_concat("fn run<T, E>(f: () -[Counter, E]> T) -[E]> T { ")
        |> str_concat("handle f() { Counter.next() -> resume(1) } } ")
        |> str_concat("fn counted() -[Counter]> i64 { run(() => { Log.note(1) 3 }) }"),
      "fixture/lambda_effects_not_the_callee_atoms",
      1924
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer publishes while with a checked boolean condition" {
  match checked(
    "fn wait() -> nil { while false { 1 } }",
    "fixture/checked_body_while",
    102
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedWhileKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.while_condition(root)) {
          CheckedBooleanKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked while bodies install their own nil loop-control scope" {
  Test.assert_true(
    match checked(
      "fn stop() -> nil { while true { break } } "
        |> str_concat("fn next() -> nil { while true { continue } }"),
      "fixture/checked_body_while_control",
      956
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        Test.assert_true(
          match expressions.kind(expressions.while_body(product.function(0).body)) {
            CheckedBreakNoValueKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          match expressions.kind(expressions.while_body(product.function(1).body)) {
            CheckedContinueKind -> true
            _ -> false
          }
        )
        true
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn nested() -> i64 { loop { while true { break }; break(1) } }",
      "fixture/checked_body_nested_while_control",
      957
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad() -> nil { while true { break(1) } }",
      "fixture/checked_body_while_break_value",
      958
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked indexed for loops elaborate to bindings and advance before their body" {
  match checked(
    "fn fixed(values: [i64; 2]) -> nil { for item in values { item } } "
      |> str_concat("fn dynamic(values: [i64]) -> nil { ")
      |> str_concat("for item in values { if item == 0 { continue } else { break } } }"),
    "fixture/checked_body_for_indexed",
    959
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, _, initialized) = expressions.let_parts(product.function(0).body)
      let (_, _, iteration) = expressions.let_mut_parts(initialized)
      Test.assert_true(
        match expressions.kind(iteration) {
          CheckedWhileKind -> true
          _ -> false
        }
      )
      let (_, fetched, body) = expressions.let_parts(expressions.while_body(iteration))
      Test.assert_true(
        match expressions.kind(fetched) {
          CheckedIndexedGetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(expressions.block_first(body)) {
          CheckedAssignKind -> true
          _ -> false
        }
      )
      let (_, _, dynamic_initialized) = expressions.let_parts(product.function(1).body)
      let (_, _, dynamic_iteration) = expressions.let_mut_parts(dynamic_initialized)
      Test.assert_true(
        match expressions.kind(dynamic_iteration) {
          CheckedWhileKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn direct() -> nil { for item in [1, 2] { item } } "
        |> str_concat("fn view(values: [i64]) -> nil { for item in values[1..] { item } }"),
      "fixture/checked_body_for_temporary_inputs",
      963
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn shadow(item: i64, values: [i64; 2]) -> i64 { for item in values { item }; item }",
      "fixture/checked_body_for_shadow",
      960
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> nil { for item in value { item } }",
      "fixture/checked_body_for_noniterable",
      961
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(values: [i64; 2]) -> i64 { for item in values { item } }",
      "fixture/checked_body_for_result",
      962
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

fn nil_guard_outcome(body: str, discriminator: i64) -[Test]> str {
  match checked(
    "type Box { value: i64 } fn len(text: str) -> i64 { 0 } "
      |> str_concat("fn take(value: str | Box) -> i64 { 0 } ")
      |> str_concat(body),
    "fixture/checked_body_nil_guard",
    discriminator
  ) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(_) -> "other"
  }
}

fn operand_outcome(body: str, discriminator: i64) -[Test]> str {
  match checked(body, "fixture/checked_body_operands", discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerBinaryOperandMismatch(_, _)) -> "operand mismatch"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(_) -> "other"
  }
}

test "a numeric literal takes its type from the operand it meets" {
  let accepted = [
    "fn f(a: f32) -> bool { a == 1.5 }",
    "fn f(a: f32) -> bool { 1.5 == a }",
    "fn f(a: f32) -> bool { a > 1.0 and a <= 2.0 }",
    "fn f(a: f32) -> bool { 1.0 < a }",
    "fn f(a: f32) -> f32 { a + 1.0 }",
    "fn f(a: f32) -> f32 { 1.0 + a }",
    "fn f(a: f64) -> bool { 1.5 == a }",
    -- The parser represents a negative literal as exactly `0 - N`.
    "fn f(x: i16) -> bool { x == -300 }",
    "fn f(x: i16) -> bool { -300 < x }",
    "fn f(x: i16) -> i16 { x + -300 }"
  ]
  let mut index: usize = 0
  while index < accepted.len {
    Test.assert_str_eq(
      operand_outcome(accepted[index], 2370 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
  -- Two operands still have to agree.
  Test.assert_str_eq(
    operand_outcome("fn f(a: f32, b: f64) -> bool { a == b }", 2396),
    "operand mismatch"
  )
  Test.assert_str_eq(
    operand_outcome("fn f(a: f32, b: f64) -> f32 { a + b }", 2397),
    "type mismatch"
  )
  let refused = [
    "fn f(x: i16) -> bool { x == 200 * 200 }",
    "fn f(x: i16) -> bool { 200 * 200 == x }",
    "fn f(x: i16) -> bool { x == 0 + 300 }",
    "fn f(x: i16) -> bool { x == 1 - 300 }",
    "fn f(x: i16) -> bool { x == 0 - (2 * 150) }"
  ]
  index = 0
  while index < refused.len {
    Test.assert_str_eq(
      operand_outcome(refused[index], 2400 + __u64_to_i64(__usize_to_u64(index))),
      "operand mismatch"
    )
    index = index + 1
  }
}

test "an operand that never completes meets any other" {
  let accepted = [
    "fn f(x: i64) -> bool { x == { return true } }",
    "fn f(x: i64) -> bool { { return true } == x }",
    "fn f(x: i64) -> bool { x < { return false } }",
    "fn f(x: i64) -> i64 { x + { return 1 } }",
    "fn f(x: i64) -> i64 { loop { x != { break (1) } } }"
  ]
  let mut index: usize = 0
  while index < accepted.len {
    Test.assert_str_eq(
      operand_outcome(accepted[index], 2380 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
}

test "nil comparisons preserve binding types until an explicit pattern narrows them" {
  let guarded = [
    "fn f(x: str | nil) -> i64 { if x != nil { len(x) } else { 0 } }",
    "fn f(x: str | nil) -> i64 { if x == nil { 0 } else { len(x) } }",
    "fn f(x: str | nil) -> i64 { if nil != x { len(x) } else { 0 } }",
    "fn f(x: str | nil) -> bool { x != nil and len(x) > 2 }",
    "fn f(x: str | nil) -> bool { x == nil or len(x) > 2 }",
    "fn f(x: str | nil, y: str | nil) -> i64 { "
      |> str_concat(
        "if x != nil { if y != nil { len(x) + len(y) } else { len(x) } } else { 0 } }"
      ),
    "fn f(x: str | nil, y: str | nil) -> i64 { "
      |> str_concat("if x != nil and y != nil { len(x) + len(y) } else { 0 } }"),
    "fn f(x: str | nil, y: str | nil) -> i64 { "
      |> str_concat("if x == nil or y == nil { 0 } else { len(x) + len(y) } }"),
    "fn f() -> i64 { let x: str | nil = \"seven\" if x != nil { len(x) } else { 0 } }",
    -- Only `nil` leaves the union.
    "fn f(x: str | Box | nil) -> i64 { if x != nil { take(x) } else { 0 } }"
  ]
  let mut index: usize = 0
  while index < guarded.len {
    Test.assert_str_eq(
      nil_guard_outcome(guarded[index], 2340 + __u64_to_i64(__usize_to_u64(index))),
      "type mismatch"
    )
    index = index + 1
  }
  let refused = [
    "fn f(x: str | nil) -> i64 { len(x) }",
    "fn f(x: str | nil) -> i64 { if x != nil { 0 } else { len(x) } }",
    "fn f(x: str | nil) -> i64 { if x == nil { len(x) } else { 0 } }",
    "fn f(x: str | nil) -> bool { x == nil and len(x) > 2 }",
    "fn f(x: str | nil) -> bool { x != nil or len(x) > 2 }",
    "fn f(x: str | nil, y: str | nil) -> i64 { if x != nil or y != nil { len(x) } else { 0 } }",
    -- A mutable binding may change between the guard and the use.
    "fn f(x: str | nil) -> i64 { let mut y = x if y != nil { len(y) } else { 0 } }",
    -- The narrowing ends with the branch it holds in.
    "fn f(x: str | nil) -> i64 { let n = if x != nil { len(x) } else { 0 } len(x) + n }"
  ]
  index = 0
  while index < refused.len {
    Test.assert_str_eq(
      nil_guard_outcome(refused[index], 2360 + __u64_to_i64(__usize_to_u64(index))),
      "type mismatch"
    )
    index = index + 1
  }
  let accepted = [
    "fn f(x: str | nil) -> i64 { if let text: str = x { len(text) } else { 0 } }",
    "fn f(x: str | nil) -> i64 { match x { nil -> 0 text: str -> len(text) } }",
    "fn f(x: str | nil) -> bool { if let text: str = x { len(text) > 2 } else { false } }"
  ]
  index = 0
  while index < accepted.len {
    Test.assert_str_eq(
      nil_guard_outcome(accepted[index], 2405 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
}

test "checked list for loops use the exact List declaration and advance before their body" {
  match checked_with_list(
    "use stdlib/list.{List} fn walk(values: List<i64>) -> nil { "
      |> str_concat("for item in values { if item == 0 { continue } else { break } } } ")
      |> str_concat("fn plain(values: List<i64>) -> nil { for item in values { item } }"),
    "fixture/checked_body_for_list",
    965
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, _, iteration) = expressions.let_mut_parts(product.function(0).body)
      Test.assert_true(
        match expressions.kind(iteration) {
          CheckedLoopKind -> true
          _ -> false
        }
      )
      let matched = expressions.loop_body(iteration)
      Test.assert_true(
        match expressions.kind(matched) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      )
      let (_, _, arms) = expressions.match_parts(matched)
      let patterns = product.patterns()
      Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
      let cons = patterns.match_arm_list_at(arms, 0)
      let empty_arm = patterns.match_arm_list_at(arms, 1)
      Test.assert_str_eq(
        declaration_identity_name(patterns.constructor_parts(cons.pattern).0).text().unwrap(),
        "Cons"
      )
      Test.assert_str_eq(
        declaration_identity_name(
          patterns.constructor_parts(empty_arm.pattern).0
        ).text().unwrap(),
        "Nil"
      )
      Test.assert_true(
        match expressions.kind(expressions.block_first(cons.body)) {
          CheckedAssignKind -> true
          _ -> false
        }
      )
      let (_, _, plain_loop) = expressions.let_mut_parts(product.function(1).body)
      let (_, _, plain_arms) = expressions.match_parts(expressions.loop_body(plain_loop))
      let plain_cons = patterns.match_arm_list_at(plain_arms, 0)
      let (_, children, _) = patterns.constructor_parts(plain_cons.pattern)
      let head_binding = patterns.binding(patterns.pattern_list_at(children, 0))
      let tail_binding = patterns.binding(patterns.pattern_list_at(children, 1))
      let (current_binding, advanced_tail) = expressions.assign_parts(
        expressions.block_first(plain_cons.body)
      )
      let (outer_binding, _, _) = expressions.let_mut_parts(product.function(1).body)
      Test.assert_true(checked_binding_id_eq(current_binding, outer_binding))
      Test.assert_true(
        checked_binding_id_eq(expressions.local_binding(advanced_tail), tail_binding)
      )
      let authored_body = expressions.block_first(expressions.block_rest(plain_cons.body))
      Test.assert_true(
        checked_binding_id_eq(expressions.local_binding(authored_body), head_binding)
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked_with_list(
      "use stdlib/list.{List} fn managed(values: List<str>) -> nil { "
        |> str_concat("for item in values { item } }"),
      "fixture/checked_body_for_managed_list",
      967
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type List<T> { Nil, Cons(T, List<T>) } "
        |> str_concat("fn spoof(values: List<i64>) -> nil { for item in values { item } }"),
      "fixture/checked_body_for_list_lookalike",
      966
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> true
      _ -> false
    }
  )
}

test "a list loop walks a list the module never writes out" {
  -- `List<Thing>` arises only by instantiating `one`; no signature names it.
  let walked = checked_with_list(
    "use stdlib/list.{List, Nil, Cons} type Thing { Small(i64) } "
      |> str_concat("fn one<T>(value: T) -> List<T> { Cons<T>(value, Nil<T>()) } ")
      |> str_concat("fn walk() -> nil { for item in one(Small(1)) { item } }"),
    "fixture/checked_body_for_instantiated_list",
    2314
  )
  match walked {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, _, iteration) = expressions.let_mut_parts(product.function(1).body)
      let (_, _, arms) = expressions.match_parts(expressions.loop_body(iteration))
      let patterns = product.patterns()
      Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
      Test.assert_str_eq(
        declaration_identity_name(
          patterns.constructor_parts(patterns.match_arm_list_at(arms, 0).pattern).0
        ).text().unwrap(),
        "Cons"
      )
    }
    _ -> Test.assert_true(false)
  }
  -- The instantiated item type still decides what the body may do with it.
  Test.assert_true(
    match checked_with_list(
      "use stdlib/list.{List, Nil, Cons} type Thing { Small(i64) } "
        |> str_concat("fn one<T>(value: T) -> List<T> { Cons<T>(value, Nil<T>()) } ")
        |> str_concat("fn walk() -> i64 { let mut sum = 0 ")
        |> str_concat("for item in one(Small(1)) { sum = sum + item }; sum }"),
      "fixture/checked_body_for_instantiated_list_item",
      2315
    ) {
      CheckedBodiesRejected(_) -> true
      _ -> false
    }
  )
}

test "checked iterator protocol fixture resolves explicit conversion and next calls" {
  let outcome = checked_with_iterator_protocol(
    "use stdlib/iter/protocol.{Iterator, IntoIterator} "
      |> str_concat("fn explicit(values: owned Iterator<i64>) -> nil { ")
      |> str_concat("let mut cursor = values.into_iter(); cursor.next(); nil }"),
    "fixture/checked_body_iterator_explicit",
    968
  )
  let reason = match outcome {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, into_call, after_binding) = expressions.let_mut_parts(product.function(0).body)
      let next_call = expressions.block_first(after_binding)
      let result = expressions.result_type(next_call)
      let catalog = expressions.types()
      match catalog.graph_for(result) {
        None -> "result absent"
        Some(graph) -> match semantic_type_graph_node(graph, result) {
          SemanticNamedNode(_, _, _, arguments) -> {
            let lists = semantic_type_graph_type_lists_local(graph)
            let item = semantic_type_graph_list_type_id(
              graph,
              semantic_type_list_edge(lists, arguments, 0)
            )
            let next_item_is_integer = match catalog.graph_for(item) {
              None -> false
              Some(item_graph) -> match semantic_type_graph_node(item_graph, item) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
            }
            let iterator_type = expressions.result_type(into_call)
            if not next_item_is_integer { "non-integer next item" }
            else {
              match catalog.graph_for(iterator_type) {
                None -> "iterator absent"
                Some(iterator_graph) -> match semantic_type_graph_node(
                  iterator_graph,
                  iterator_type
                ) {
                  SemanticOwnedNode(inner) -> match catalog.graph_for(inner) {
                    None -> "inner absent"
                    Some(inner_graph) -> match semantic_type_graph_node(inner_graph, inner) {
                      SemanticNamedNode(_, _, _, iterator_arguments) -> {
                        let iterator_lists = semantic_type_graph_type_lists_local(inner_graph)
                        let iterator_item = semantic_type_graph_list_type_id(
                          inner_graph,
                          semantic_type_list_edge(iterator_lists, iterator_arguments, 0)
                        )
                        match catalog.graph_for(iterator_item) {
                          None -> "iterator item absent"
                          Some(item_graph) -> if not semantic_type_graph_contains(
                            item_graph,
                            iterator_item
                          ) { "iterator item invalid" }
                          else if semantic_type_catalog_equal(catalog, iterator_item, item) {
                            "same item"
                          } else { "different item" }
                        }
                      }
                      _ -> "inner not named"
                    }
                  }
                  _ -> "iterator not owned"
                }
              }
            }
          }
          SemanticOwnedNode(_) -> "owned result"
          _ -> "other result"
        }
      }
    }
    CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> "unknown method"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> "iterable required"
    CheckedBodiesRejected(CheckedBodyProducerIteratorResultRequired(_)) -> "iterator result"
    CheckedBodiesRejected(CheckedBodyProducerIteratorItemInvalid(_)) -> "iterator item invalid"
    CheckedBodiesRejected(CheckedBodyProducerIteratorItemUnresolved(_)) -> "iterator unresolved"
    CheckedBodiesRejected(CheckedBodyProducerIteratorNextRequired(_)) -> "iterator next"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionRequired(_)) -> "iterator option"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionCaseRequired(_)) -> "iterator cases"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionItemMismatch(_)) -> "iterator item"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionPayloadMismatch(_)) ->
      "iterator payload"
    CheckedBodiesRejected(_) -> "other rejection"
  }
  Test.assert_str_eq(reason, "same item")
}

test "checked protocol for loops select exact methods and bind iterator results" {
  let outcome = checked_with_iterator_protocol(
    "use stdlib/iter/protocol.{Iterator, IntoIterator} "
      |> str_concat("fn walk(values: owned Iterator<i64>) -> nil { ")
      |> str_concat("for item in values { if item == 0 { continue } else { break } } }"),
    "fixture/checked_body_for_protocol",
    969
  )
  let reason = match outcome {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      let (iterator_binding, conversion, iteration) = expressions.let_mut_parts(
        product.function(0).body
      )
      let (conversion_declaration, _, conversion_arguments, _) = expressions.method_call_parts(
        conversion
      )
      Test.assert_str_eq(
        declaration_identity_name(conversion_declaration).text().unwrap(),
        "into_iter"
      )
      Test.assert_eq_usize(expressions.expression_list_len(conversion_arguments), 0)
      let (_, next_call, arms) = expressions.match_parts(expressions.loop_body(iteration))
      let (next_declaration, next_receiver, next_arguments, _) = expressions.method_call_parts(
        next_call
      )
      Test.assert_str_eq(declaration_identity_name(next_declaration).text().unwrap(), "next")
      Test.assert_eq_usize(expressions.expression_list_len(next_arguments), 0)
      Test.assert_true(
        match expressions.kind(next_receiver) {
          CheckedExclusiveBorrowKind -> true
          _ -> false
        }
      )
      let (borrowed_binding, exclusive) = expressions.borrow_parts(next_receiver)
      Test.assert_true(exclusive)
      Test.assert_true(checked_binding_id_eq(borrowed_binding, iterator_binding))
      Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
      let some_arm = patterns.match_arm_list_at(arms, 0)
      let none_arm = patterns.match_arm_list_at(arms, 1)
      Test.assert_str_eq(
        declaration_identity_name(patterns.constructor_parts(some_arm.pattern).0).text().unwrap(),
        "Some"
      )
      Test.assert_str_eq(
        declaration_identity_name(patterns.constructor_parts(none_arm.pattern).0).text().unwrap(),
        "None"
      )
      "accepted"
    }
    CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> "unknown method"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> "iterable required"
    CheckedBodiesRejected(CheckedBodyProducerIteratorResultRequired(_)) -> "iterator result"
    CheckedBodiesRejected(CheckedBodyProducerIteratorItemInvalid(_)) -> "iterator item invalid"
    CheckedBodiesRejected(CheckedBodyProducerIteratorItemUnresolved(_)) -> "iterator unresolved"
    CheckedBodiesRejected(CheckedBodyProducerIteratorNextRequired(_)) -> "iterator next"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionRequired(_)) -> "iterator option"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionCaseRequired(_)) -> "iterator cases"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionItemMismatch(_)) -> "iterator item"
    CheckedBodiesRejected(CheckedBodyProducerIteratorOptionPayloadMismatch(_)) ->
      "iterator payload"
    CheckedBodiesRejected(_) -> "other rejection"
  }
  Test.assert_str_eq(reason, "accepted")
  let custom = checked_with_iterator_protocol(
    "use stdlib/iter/protocol.{Iterator, IntoIterator} "
      |> str_concat("type Numbers { Numbers(owned Iterator<i64>) } ")
      |> str_concat("impl IntoIterator for Numbers { type Item = i64 ")
      |> str_concat("fn into_iter(self: Numbers) -> owned Iterator<i64> { ")
      |> str_concat("match self { Numbers(iterator) -> iterator } } } ")
      |> str_concat("fn walk(values: Numbers) -> nil { for item in values { item } }"),
    "fixture/checked_body_for_custom_protocol",
    970
  )
  let custom_reason = match custom {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> "iterable required"
    CheckedBodiesRejected(CheckedBodyProducerSignatureUnavailable(_)) -> "signature unavailable"
    CheckedBodiesRejected(_) -> "other rejection"
  }
  Test.assert_str_eq(custom_reason, "accepted")
  Test.assert_true(
    match checked_with_iterator_protocol(
      "use stdlib/iter/protocol.{Iterator, IntoIterator} "
        |> str_concat("fn bad(value: i64) -> nil { for item in value { item } }"),
      "fixture/checked_body_for_protocol_missing_impl",
      971
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIterableRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_iterator_protocol(
      "use stdlib/iter/protocol.{Iterator, IntoIterator} "
        |> str_concat("fn bad(values: owned Iterator<i64>) -> nil { ")
        |> str_concat("let cursor = values.into_iter(); cursor.next(); nil }"),
      "fixture/checked_body_iterator_immutable_next",
      972
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer types return as never inside a conditional branch" {
