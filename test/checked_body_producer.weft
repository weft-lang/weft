test "checked direct calls conservatively retain caller slice arguments" {
  match checked(
    "fn id(values: [i64]) -> [i64] { values } "
    |> str_concat("fn wrap(values: [i64]) -> [i64] { id(values) }"),
    "fixture/checked_body_direct_slice_call",
