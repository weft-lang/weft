test "checked body producer applies function-valued local bindings" {
  match checked(
    "fn apply(f: (i64) -> i64, value: i64) -> i64 { f(value) }",
    "fixture/checked_body_apply",
    115
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, _) = expressions.apply_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer applies a parenthesized function projection" {
  match checked(
    "type FunctionBox { f: (i64) -> i64 } fn run(box: FunctionBox) -> i64 { (box.f)(5) }",
    "fixture/checked_body_projected_apply",
    1151
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, call_site) = expressions.apply_parts(root)
      Test.assert_true(match expressions.kind(root) { CheckedApplyKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedDeclaredFieldAccessKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(call_site > expressions.range(callee).end)
      Test.assert_eq(
        expressions.integer_value(expressions.expression_list_at(arguments, 0)),
        5
      )
    }
    _ -> Test.assert_true(false)
  }
}

