      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
    |> str_concat(
      "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
    )
    |> str_concat(
      "fn cast(value: i64) -> rc i64 { handle unsafe_transmute<i64, rc i64>(value) { "
    )
    |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_rc_handle",
      1149,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
    |> str_concat(
      "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
    )
    |> str_concat("fn cast(k: Continuation<i64, i64>) -> i64 { ")
    |> str_concat(
      "handle unsafe_transmute<Continuation<i64, i64>, i64>(k) { "
    )
    |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_continuation_handle",
      1150,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_unsafe(
      "use runtime/unsafe.{Unsafe} "
    |> str_concat(
      "fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U { Unsafe.transmute(value) } "
    )
    |> str_concat(
      "fn cast(value: i64) -> str { handle unsafe_transmute<i64, str>(value) { "
    )
    |> str_concat("Unsafe.transmute(raw) -> resume(__transmute(raw)) } }"),
      "runtime/fixture_contextual_str_handle",
      1151,
      true
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer publishes nested call arguments after their children" {
  match checked(
    "fn pair(left: i64, right: i64) -> i64 { left * 10 + right } "
    |> str_concat("fn caller() -> i64 { pair(pair(1, 2), pair(3, 4)) }"),
    "fixture/checked_body_nested_calls",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (_, outer) = expressions.direct_call_parts(product.function(1).body)
      Test.assert_eq_usize(expressions.expression_list_len(outer), 2)
      let left = expressions.expression_list_at(outer, 0)
      let right = expressions.expression_list_at(outer, 1)
      Test.assert_true(match expressions.kind(left) { CheckedDirectCallKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(right) { CheckedDirectCallKind -> true, _ -> false }
      )
      let (_, left_arguments) = expressions.direct_call_parts(left)
      let (_, right_arguments) = expressions.direct_call_parts(right)
      Test.assert_eq_usize(expressions.expression_list_len(left_arguments), 2)
      Test.assert_eq_usize(expressions.expression_list_len(right_arguments), 2)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes specialized trait method calls" {
  match checked(
    "trait Same { fn same(self, other: Self) -> bool } "
    |> str_concat("type Box<T> { value: T } ")
    |> str_concat(
      "impl<T> Same for Box<T> { fn same(self, other: Self) -> bool { true } } "
    )
    |> str_concat(
      "fn compare(left: Box<i64>, right: Box<i64>) -> bool { left.same(right) }"
    ),
    "fixture/checked_body_trait_method",
    172
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments) = expressions.method_call_parts(root)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "trait Source { type Item fn get(self) -> Self.Item } "
    |> str_concat("type Box { value: i64 } ")
    |> str_concat("impl Source for Box { type Item = i64 ")
    |> str_concat("fn get(self) -> Self.Item { self.value } } ")
    |> str_concat("fn read(box: Box) -> i64 { box.get() }"),
    "fixture/checked_body_associated_method",
    181
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 2)
      let expressions = product.expressions()
      let root = product.function(1).body
      let (declaration, _, arguments) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "get"
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "type Box<T> { value: T } impl<T> Box<T> { "
    |> str_concat("fn keep(self) -> Self { self } ")
    |> str_concat("fn value(self) -> T { self.value } ")
    |> str_concat("fn retained(self) -> T { self.keep().value() } }"),
    "fixture/checked_body_inherent_self",
    182
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (declaration, receiver, arguments) = expressions.method_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "value"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 0)
    }
    _ -> Test.assert_true(false)
  }
}

