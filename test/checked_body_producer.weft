  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.structural_field_access_parts(root) {
          (_, key, position) -> key == "target".hash() and
            match position {
              CheckedStructuralFieldUnplaced(name) -> name == "target"
              _ -> false
            }
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn bad(row: { target: i64, .. }) -> i64 { row.other }",
      "fixture/checked_body_open_field_missing",
