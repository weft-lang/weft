test "checked method selection sees through borrowed nominal receivers" {
  Test.assert_true(
    match checked(
      "type Value { item: i64 } impl Value { "
        |> str_concat("fn read(self: borrow Self) -> i64 { 7 } ")
        |> str_concat("fn touch(self: borrow mut Self) -> i64 { 8 } } ")
        |> str_concat("fn inspect(value: borrow Value) -> i64 { value.read() } ")
        |> str_concat("fn modify(value: borrow mut Value) -> i64 { value.touch() }"),
      "fixture/checked_borrowed_method_receiver",
      1246
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer retains specialized method results across a block" {
  match checked(
    "trait Chain { fn keep(self) -> Self fn same(self, other: Self) -> bool } "
      |> str_concat("type Box<T> { value: T } ")
      |> str_concat(
        "impl<T> Chain for Box<T> { fn keep(self) -> Self { self } "
      )
      |> str_concat("fn same(self, other: Self) -> bool { true } } ")
      |> str_concat(
        "fn compare(left: Box<i64>, right: Box<i64>) -> bool { "
      )
      |> str_concat("let kept = left.keep() kept.same(right) }"),
    "fixture/checked_body_method_result",
    177
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (_, _, result) = expressions.let_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedLetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(result) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments, _) = expressions.method_call_parts(result)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects invalid method selections" {
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> i64 { value.missing() }",
      "fixture/checked_body_method_missing",
      174
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } impl Box { fn read(self) -> i64 { 1 } } "
        |> str_concat("impl Box { fn read(self) -> i64 { 2 } } ")
        |> str_concat("fn bad(value: Box) -> i64 { value.read() }"),
      "fixture/checked_body_method_ambiguous",
      175
    ) {
      CheckedBodiesRejected(CheckedBodyProducerAmbiguousMethod(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } "
        |> str_concat("impl Box { fn same(self, other: Box) -> bool { true } } ")
        |> str_concat("fn bad(value: Box) -> bool { value.same() }"),
      "fixture/checked_body_method_arity",
      176
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box { value: i64 } "
        |> str_concat("impl Box { fn same(self, other: Box) -> bool { true } } ")
        |> str_concat("fn bad(value: Box) -> bool { value.same(1) }"),
      "fixture/checked_body_method_argument",
      178
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } type Box { value: i64 } "
        |> str_concat(
          "impl Box { fn read(self) -[Read]> i64 { Read.get() } } "
        )
        |> str_concat("fn bad(value: Box) -> i64 { value.read() }"),
      "fixture/checked_body_method_effect",
      179
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "trait Show { fn show(self) -> str } type Wrap<T> { value: T } "
        |> str_concat("impl Show for i64 { fn show(self) -> str { \"i64\" } } ")
        |> str_concat(
          "impl<T: Show> Show for Wrap<T> { fn show(self) -> str { \"wrap\" } } "
        )
        |> str_concat("fn bad(value: Wrap<bool>) -> str { value.show() }"),
      "fixture/checked_body_method_bound",
      180
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownMethod(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer applies function-valued local bindings" {
  match checked(
    "fn apply(f: (i64) -> i64, value: i64) -> i64 { f(value) }",
    "fixture/checked_body_apply",
    115
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, _) = expressions.apply_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer applies a parenthesized function projection" {
  match checked(
    "type FunctionBox { f: (i64) -> i64 } fn run(box: FunctionBox) -> i64 { (box.f)(5) }",
    "fixture/checked_body_projected_apply",
    1151
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, call_site) = expressions.apply_parts(root)
      Test.assert_true(match expressions.kind(root) { CheckedApplyKind -> true, _ -> false })
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedDeclaredFieldAccessKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(call_site > expressions.range(callee).end)
      Test.assert_eq(
        expressions.integer_value(expressions.expression_list_at(arguments, 0)),
        5
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked expression application requires a callable" {
