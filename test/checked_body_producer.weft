  match checked(
    "effect Pair { fn combine(left: i64, right: i64) -> i64 } "
      |> str_concat(
        "fn combined() -[Pair]> i64 { Pair.combine(20, 22) }"
      ),
    "fixture/checked_semantic_perform_lowering",
    12721
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols_bind(
        checked_native_function_symbols(),
        product.function(0).signature.identity,
        116
      )
      match lower_checked_straight_function(product, symbols, 0) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_count_tag(function, 62), 1)
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 2)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering retains typed handler bodies captures and resume" {
  match checked(
    "effect Box { fn put(value: i64) -> nil fn get() -> i64 } "
      |> str_concat(
        "fn handled(base: i64) -> str { handle { Box.put(base) Box.get() } { "
      )
      |> str_concat(
        "Box.put(seen: i64) -> resume(nil) Box.get() -> \"stopped\" "
      )
      |> str_concat(
        "return result -> if result == 42 { \"ok\" } else { \"bad\" } } }"
      ),
    "fixture/checked_semantic_handler_lowering",
    12723
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols_bind(
        checked_native_function_symbols(),
        product.function(0).signature.identity,
        119
      )
      match lower_checked_straight_function(product, symbols, 0) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_count_tag(function, 62), 1)
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 1)
          Test.assert_eq(
            ir_function_first_handle_clause_count_or(function, 0 - 1),
            2
          )
          Test.assert_eq(ir_function_semantic_handler_resume_count(function), 1)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering hoists typed lambda parameters and captures" {
  match checked(
    "fn apply(callback: () -> i64) -> i64 { callback() } "
      |> str_concat(
        "fn caller() -> i64 { let base = 2; apply(() => base) }"
      ),
    "fixture/checked_semantic_lambda_lowering",
    12722
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 117)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 118)
      let mut index: usize = 1
      while index < 2 {
        match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> {
            Test.assert_eq(ir_function_count_tag(function, 64), 1)
            nil
          }
          _ -> {
            Test.assert_true(false)
            nil
          }
        }
        index = index + 1
      }
      nil
    }
    _ -> {
      Test.assert_true(false)
      nil
    }
  }
}

test "checked lowering routes typed loop control through CFG targets" {
  match checked(
    "fn valued(flag: bool) -> i64 { loop { if flag { break(7) } else { continue } } } "
      |> str_concat("fn stopped() -> nil { while true { break } } ")
      |> str_concat("fn nested() -> i64 { loop { while true { break }; break(9) } } ")
      |> str_concat("fn diverging() -> never { loop { continue } } ")
      |> str_concat("fn calls_never() -> never { diverging() }"),
    "fixture/checked_loop_lowering",
    1273
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 116)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 117)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 118)
        |> checked_native_function_symbols_bind(product.function(3).signature.identity, 119)
        |> checked_native_function_symbols_bind(product.function(4).signature.identity, 120)
      let mut index: usize = 0
      while index < 5 {
        match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> {
            if index < 4 {
              Test.assert_true(ir_function_block_count(function) >= 2)
              Test.assert_true(ir_function_count_term_tag(function, 2) >= 1)
            } else {
              Test.assert_eq(ir_function_block_count(function), 1)
              Test.assert_eq(ir_function_count_term_tag(function, 4), 1)
            }
            Test.assert_eq(ir_function_edges_match_block_params(function), 1)
            if index == 0 or index == 2 {
              Test.assert_eq(ir_function_block_param_count(function), 1)
            } else {
              Test.assert_eq(ir_function_block_param_count(function), 0)
            }
            nil
          }
          _ -> {
            Test.assert_true(false)
            nil
          }
        }
        index = index + 1
        nil
      }
      nil
    }
    _ -> {
      Test.assert_true(false)
      nil
    }
  }
}

test "checked lowering transports every immutable wide value lane" {
  match checked(
    "fn choose(first: [i64], second: [i64], flag: bool) -> [i64] { "
      |> str_concat("if flag { first } else { second } } ")
      |> str_concat(
        "fn forward(first: [i64], second: [i64], flag: bool) -> [i64] { "
      )
      |> str_concat("choose(first, second, flag) } ")
      |> str_concat("fn explicit(value: [i64]) -> [i64] { return value }"),
    "fixture/checked_wide_value_lowering",
    1274
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 120)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 121)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 122)
      match lower_checked_straight_function(product, symbols, 0) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 5)
          Test.assert_eq(ir_function_block_param_count(function), 2)
          Test.assert_eq(ir_function_count_tag(function, 42), 1)
          Test.assert_eq(ir_function_edges_match_block_params(function), 1)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 1) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 5)
          Test.assert_eq(ir_function_first_call_arg_count_or(function, 0 - 1), 5)
          Test.assert_eq(ir_function_count_tag(function, 41), 1)
          Test.assert_eq(ir_function_count_tag(function, 42), 1)
        }
        _ -> Test.assert_true(false)
      }
      match lower_checked_straight_function(product, symbols, 2) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 2)
          Test.assert_eq(ir_function_count_tag(function, 42), 1)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering retains semantic data operations until layout specialization" {
  match checked(
    "type Pair { left: i64, right: i64 } type Box { values: [i64] } "
      |> str_concat("fn declared(row: Pair) -> i64 { row.right } ")
      |> str_concat("fn structural(row: { target: i64 }) -> i64 { row.target } ")
      |> str_concat("fn length(values: [i64; 3]) -> usize { values.len } ")
      |> str_concat("fn indexed(values: [i64; 3], at: usize) -> i64 { values[at] } ")
      |> str_concat("fn record() -> Pair { Pair { left: 1, right: 2 } } ")
      |> str_concat("fn tuple() -> (i64, bool) { (1, true) } ")
      |> str_concat("fn array() -> [i64; 2] { [1, 2] } ")
      |> str_concat("fn wide_field(row: Box) -> i64 { row.values[0] }"),
    "fixture/checked_semantic_data_lowering",
    1275
  ) {
    CheckedBodiesAccepted(product) -> {
      let mut symbols = checked_native_function_symbols()
      let mut symbol: i64 = 123
      let mut index: usize = 0
      while index < 8 {
        symbols = checked_native_function_symbols_bind(
          symbols,
          product.function(index).signature.identity,
          symbol
        )
        symbol = symbol + 1
        index = index + 1
        nil
      }
      index = 0
      while index < 8 {
        match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> {
            if index == 7 {
              Test.assert_eq(ir_function_count_tag(function, 64), 2)
              Test.assert_eq(ir_function_count_tag(function, 65), 1)
            } else if index == 1 or index == 2 or index == 5 {
              Test.assert_eq(ir_function_count_tag(function, 64), 0)
              Test.assert_eq(ir_function_count_tag(function, 65), 0)
            } else {
              Test.assert_eq(ir_function_count_tag(function, 64), 1)
              Test.assert_eq(ir_function_count_tag(function, 65), 0)
            }
            nil
          }
          _ -> {
            Test.assert_true(false)
            nil
          }
        }
        index = index + 1
        nil
      }
      nil
    }
    _ -> {
      Test.assert_true(false)
      nil
    }
  }
}

test "checked lowering resolves concrete generic value shapes" {
  match checked(
    "fn identity<T>(value: T) -> T { value } "
      |> str_concat("fn pair<T>(value: T) -> (T, i64) { (value, 1) } ")
      |> str_concat("fn concrete(value: [i64]) -> [i64] { value }"),
    "fixture/checked_generic_shape_lowering",
    1276
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 131)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 132)
        |> checked_native_function_symbols_bind(product.function(2).signature.identity, 133)
      Test.assert_true(
        match lower_checked_straight_function(product, symbols, 0) {
          CheckedStraightFunctionRejected(CheckedStraightValueShapeUnavailable) -> true
          _ -> false
        }
      )
      let expressions = product.expressions()
      let concrete = product.function(2)
      let concrete_binding = expressions.function_parameter(concrete.parameters, 0)
      let concrete_type = expressions.binding(concrete_binding).value_type
      let signatures = product.signatures()
      let substitution = semantic_type_substitution_bind(
        semantic_type_substitution_empty(),
        signatures.type_parameter_at(product.function(0).signature, 0),
        concrete_type
      )
      match lower_checked_straight_function_with_substitution(
        product,
        symbols,
        0,
        substitution
      ) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 2)
          Test.assert_eq(ir_function_count_tag(function, 42), 1)
        }
        _ -> Test.assert_true(false)
      }
      let pair_substitution = semantic_type_substitution_bind(
        semantic_type_substitution_empty(),
        signatures.type_parameter_at(product.function(1).signature, 0),
        concrete_type
      )
      match lower_checked_straight_function_with_substitution(
        product,
        symbols,
        1,
        pair_substitution
      ) {
        CheckedStraightFunctionLowered(function) -> {
          Test.assert_eq(ir_function_param_count(function), 2)
          Test.assert_eq(ir_function_count_tag(function, 64), 0)
          Test.assert_eq(ir_function_count_tag(function, 65), 0)
          Test.assert_eq(ir_function_count_tag(function, 42), 2)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked specialization discovers and rewrites reachable generic calls" {
  match checked(
    "fn identity<T>(value: T) -> T { value } "
      |> str_concat("fn forward<T>(value: T) -> T { identity<T>(value) } ")
      |> str_concat("fn main() -> i64 { forward<i64>(41) + forward<i64>(1) }"),
    "fixture/checked_specialization_plan",
    1277
  ) {
    CheckedBodiesAccepted(product) -> match plan_checked_body_specializations(product) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(num_scalar_usize_to_i64(plan.instance_count()).unwrap(), 3)
        Test.assert_eq(num_scalar_usize_to_i64(plan.function_count()).unwrap(), 3)
        Test.assert_eq(plan.instruction_count(62), 0)
        Test.assert_eq(plan.instruction_count(4), 3)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked specialization traverses nested semantic functions" {
  match checked(
    "fn identity<T>(value: T) -> T { value } effect Read { fn get() -> i64 } "
      |> str_concat(
        "fn main(base: i64) -> i64 { handle identity<i64>(Read.get()) { "
      )
      |> str_concat(
        "Read.get() -> resume(identity<i64>(base)) } }"
      ),
    "fixture/checked_handler_specialization_plan",
    1315
  ) {
    CheckedBodiesAccepted(product) -> match plan_checked_body_specializations(product) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(num_scalar_usize_to_i64(plan.instance_count()).unwrap(), 2)
        Test.assert_eq(num_scalar_usize_to_i64(plan.function_count()).unwrap(), 2)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "fn identity<T>(value: T) -> T { value } "
      |> str_concat("fn apply(callback: () -> i64) -> i64 { callback() } ")
      |> str_concat("fn main() -> i64 { apply(() => identity<i64>(42)) }"),
    "fixture/checked_closure_specialization_plan",
    1316
  ) {
    CheckedBodiesAccepted(product) -> match plan_checked_body_specializations(product) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(num_scalar_usize_to_i64(plan.instance_count()).unwrap(), 3)
        Test.assert_eq(num_scalar_usize_to_i64(plan.function_count()).unwrap(), 3)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering compiles ordered scalar matches and guarded bindings" {
  match checked(
    "fn select(value: i64) -> i64 { match value { 0 -> 10, n if n < 0 -> 20, n -> n + 1 } } "
      |> str_concat(
        "fn optional(value: str?) -> i64 { match value { nil -> 0, _ -> 1 } }"
      ),
    "fixture/checked_match_lowering",
    1278
  ) {
    CheckedBodiesAccepted(product) -> {
      let symbols = checked_native_function_symbols()
        |> checked_native_function_symbols_bind(product.function(0).signature.identity, 134)
        |> checked_native_function_symbols_bind(product.function(1).signature.identity, 135)
      let mut index: usize = 0
      while index < 2 {
        match lower_checked_straight_function(product, symbols, index) {
          CheckedStraightFunctionLowered(function) -> {
            Test.assert_eq(
              ir_function_count_term_tag(function, 3),
              if index == 0 { 2 } else { 1 }
            )
            Test.assert_eq(
              ir_function_count_term_tag(function, 2),
              if index == 0 { 3 } else { 2 }
            )
            Test.assert_eq(ir_function_edges_match_block_params(function), 1)
          }
          _ -> Test.assert_true(false)
        }
        index = index + 1
      }
      nil
    }
    _ -> {
      Test.assert_true(false)
      nil
    }
  }
}

-- Conditional branch terminators in one lowered function.
fn lowered_branch_count(product: CheckedBodyProduct, index: usize) -[Test]> i64 {
  let mut symbols = checked_native_function_symbols()
  let mut bound: usize = 0
  while bound < 4 {
    symbols = checked_native_function_symbols_bind(
      symbols,
      product.function(bound).signature.identity,
      140 + __u64_to_i64(__usize_to_u64(bound))
    )
    bound = bound + 1
  }
  match lower_checked_straight_function(product, symbols, index) {
    CheckedStraightFunctionLowered(function) -> ir_function_count_term_tag(function, 3)
    _ -> 0 - 1
  }
}

test "checked lowering tests the nil sentinel only for narrowing typed arms" {
  match checked(
    "fn wild(x: str?) -> i64 { match x { nil -> 0, _ -> 1 } } "
      |> str_concat("fn typed(x: str?) -> i64 { match x { nil -> 0, text: str -> 1 } } ")
      |> str_concat("fn whole(x: str) -> i64 { match x { all: str -> 1 } } ")
      |> str_concat("fn plain(x: str) -> i64 { match x { _ -> 1 } }"),
    "fixture/checked_typed_arm_lowering",
    1452
  ) {
    CheckedBodiesAccepted(product) -> {
      let wild = lowered_branch_count(product, 0)
      Test.assert_true(wild >= 0)
      Test.assert_eq(lowered_branch_count(product, 1), wild + 1)
      Test.assert_eq(lowered_branch_count(product, 2), lowered_branch_count(product, 3))
    }
    _ -> Test.assert_true(false)
  }
}

test "checked lowering compiles exact constructor and tuple patterns" {
  match checked(
    "type Choice { Empty, Packed(i64, (i64, i64)) } "
      |> str_concat(
        "fn unpack(value: Choice) -> i64 { match value { Empty -> 0, Packed(a, (b, c)) -> a + b + c } }"
      ),
