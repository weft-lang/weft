test "checked body producer resolves an imported qualified record" {
  let dependency = registered(
    "pub type Point { x: i64, y: bool }",
    named_module_identity("fixture/record_dependency", 1221)
  )
  let consumer = registered(
    "use fixture/record_dependency as dep "
    |> str_concat("fn make() -> dep.Point { dep.Point { y: true, x: 1 } } ")
    |> str_concat("fn revise(base: dep.Point) -> dep.Point { base.{ x: 2 } } ")
    |> str_concat("fn unpack(base: dep.Point) -> i64 { match base { { x: n } -> n } }"),
    named_module_identity("fixture/record_consumer", 1222)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.record_init_parts(product.function(0).body) {
          (CheckedDeclaredRecordConstruction(declaration), fields) -> {
            Test.assert_true(
              module_identity_eq(declaration_identity_module(declaration), dependency.identity)
            )
            Test.assert_eq_usize(expressions.record_field_list_len(fields), 2)
          }
          _ -> Test.assert_true(false)
        }
        match expressions.record_update_parts(product.function(1).body) {
          (_, fields) -> {
            Test.assert_eq_usize(expressions.record_field_list_len(fields), 1)
            let field = expressions.record_field_list_at(fields, 0)
            Test.assert_true(match field.kind { CheckedDeclaredRecordField -> true, _ -> false })
            Test.assert_true(
              match field.declaration {
                declaration: DeclarationIdentity -> module_identity_eq(
                  declaration_identity_module(declaration),
                  dependency.identity
                )
                nil -> false
              }
            )
          }
        }
        let patterns = product.patterns()
        match expressions.match_parts(product.function(2).body) {
          (_, _, arms) -> {
            let arm = patterns.match_arm_list_at(arms, 0)
            let fields = patterns.record_fields(arm.pattern)
            let field = patterns.pattern_field_list_at(fields, 0)
            Test.assert_true(
              match field.declaration {
                declaration: DeclarationIdentity -> module_identity_eq(
                  declaration_identity_module(declaration),
                  dependency.identity
                )
                nil -> false
              }
            )
          }
        }
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects duplicate record fields" {
  Test.assert_true(
    match checked(
      "fn bad() -> { x: i64 } { { x: 1, x: 2 } }",
      "fixture/checked_body_duplicate_record_field",
      1206
    ) {
      CheckedBodiesRejected(CheckedBodyProducerDuplicateRecordField(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects mismatched record fields" {
  Test.assert_true(
    match checked(
      "fn bad() -> { x: i64 } { { x: \"text\" } }",
      "fixture/checked_body_mismatched_record_field",
      1207
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects authored forms it has not converted" {
  Test.assert_true(
    match checked(
      "fn unsupported(value: i64) -> i64 { &value }",
      "fixture/checked_body_unsupported",
      94
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsupportedExpression) -> true
      _ -> false
    }
  )
}
