          CheckedBreakNoValueKind -> true
          _ -> false
        }
      )
      let stopped = expressions.loop_body(product.function(0).body)
      let range = expressions.range(stopped)
      Test.assert_str_eq(
        expressions.source().span(range.start, range.end).unwrap().text().unwrap(),
        "break"
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer infers loop results from checked breaks" {
  match checked(
    "fn inferred() -> i64 { let value = loop { break(1) }; value }",
    "fixture/checked_body_loop_inference",
    108
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let mut found = false
      let mut index: usize = 0
      while index < expressions.len() {
        let expression = checked_expr_id_from_ordinal(expressions.segment(), index)
        match expressions.kind(expression) {
          CheckedLoopKind -> {
            let result = expressions.result_type(expression)
            let catalog = expressions.types()
            match catalog.graph_for(result) {
              Some(graph) -> match semantic_type_graph_node(graph, result) {
                SemanticPrimitiveNode(SemanticI64) -> { found = true nil }
                _ -> { Test.assert_true(false) nil }
              }
              None -> { Test.assert_true(false) nil }
            }
            nil
          }
          _ -> nil
        }
        index = index + 1
      }
      Test.assert_true(found)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked inferred loops join unlike break types and keep nested breaks separate" {
  match checked(
    "fn choose() -> any { let value = loop { if true { break(1) } else { break(\"x\") } }; value }",
    "fixture/checked_body_loop_union",
    1081
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let mut found_union = false
      let mut index: usize = 0
      while index < expressions.len() {
        let expression = checked_expr_id_from_ordinal(expressions.segment(), index)
        match expressions.kind(expression) {
          CheckedLoopKind -> {
            let result = expressions.result_type(expression)
            let catalog = expressions.types()
            match catalog.graph_for(result) {
              Some(graph) -> match semantic_type_graph_node(graph, result) {
                SemanticUnionNode(_, _) -> { found_union = true nil }
                _ -> nil
              }
              None -> { Test.assert_true(false) nil }
            }
            nil
          }
          _ -> nil
        }
        index = index + 1
      }
      Test.assert_true(found_union)
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "fn nested() -> i64 { let outer = loop { let inner = loop { break(\"x\") }; break(7) }; outer }",
    "fixture/checked_body_loop_nested",
    1082
  ) {
    CheckedBodiesAccepted(_) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

