test "checked record patterns retain structural fields and nested bindings" {
  match checked(
    "fn pick(value: { x: i64, y: bool }) -> i64 { match value { { x: left, y: _ } -> left } } "
    |> str_concat(
      "fn nested(value: { outer: (i64, bool), tail: i64 }) -> i64 { match value { { outer: (n, _), tail: _ } -> n } } "
    )
    |> str_concat(
      "fn empty(value: { x: i64 }) -> i64 { match value { {} -> 1 } } "
    )
    |> str_concat(
      "fn reverse(value: { x: i64, y: bool }) -> i64 { match value { { y: _, x: n } -> n } } "
    )
    |> str_concat(
      "type Row = { x: i64, y: bool } fn alias(value: Row) -> i64 { match value { { x: n } -> n } }"
    ),
    "fixture/checked_body_record_patterns",
    1178
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 5)
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedRecordPatternKind -> true
              _ -> false
            }
          )
          let fields = patterns.record_fields(arm.pattern)
          Test.assert_eq_usize(patterns.pattern_field_list_len(fields), 2)
          let first = patterns.pattern_field_list_at(fields, 0)
          Test.assert_true(
            match first.kind {
              CheckedStructuralPatternField -> true
              _ -> false
            }
          )
          Test.assert_true(
            match first.position { CheckedPatternFieldWordOffset(_) -> true, _ -> false }
          )
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(first.pattern),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          let fields = patterns.record_fields(arm.pattern)
          let outer = patterns.pattern_field_list_at(fields, 0)
          Test.assert_true(
            match patterns.kind(outer.pattern) {
              CheckedTuplePatternKind -> true
              _ -> false
            }
          )
          let children = patterns.tuple_items(outer.pattern)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 0)),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

fn assert_nominal_record_pattern_function(
  product: CheckedBodyProduct,
  index: usize,
  expected_field: usize
) -[Test]> nil {
  let expressions = product.expressions()
  let patterns = product.patterns()
  match expressions.match_parts(product.function(index).body) {
    (_, _, arms) -> {
      let arm = patterns.match_arm_list_at(arms, 0)
      let fields = patterns.record_fields(arm.pattern)
      Test.assert_eq_usize(patterns.pattern_field_list_len(fields), 1)
      let field = patterns.pattern_field_list_at(fields, 0)
      Test.assert_true(match field.kind { CheckedDeclaredPatternField -> true, _ -> false })
      Test.assert_true(
        match field.position {
          CheckedPatternFieldOrdinal(found) -> found == expected_field
          _ -> false
        }
      )
      Test.assert_true(
        checked_binding_id_eq(
          patterns.binding(field.pattern),
          expressions.local_binding(arm.body)
        )
      )
    }
  }
  nil
}

test "checked nominal record patterns retain declaration field ordinals" {
  match checked(
    "type Point { x: i64, y: bool } "
    |> str_concat("fn pick(value: Point) -> i64 { match value { { x: n } -> n } } ")
    |> str_concat("fn pick_y(value: Point) -> bool { match value { { y: b } -> b } } ")
    |> str_concat("type Box<T> { value: T } ")
    |> str_concat("fn unbox(value: Box<str>) -> str { match value { { value: text } -> text } }"),
    "fixture/checked_body_nominal_record_patterns",
    1243
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      assert_nominal_record_pattern_function(product, 0, 0)
      assert_nominal_record_pattern_function(product, 1, 1)
      assert_nominal_record_pattern_function(product, 2, 0)
    }
    _ -> { Test.assert_true(false); nil }
  }
  Test.assert_true(
    match checked(
      "type Point { x: i64 } fn all(value: Point) -> i64 { match value { {} -> 1 } }",
      "fixture/checked_body_nominal_empty_pattern",
      1247
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        let patterns = product.patterns()
        match expressions.match_parts(product.function(0).body) {
          (_, _, arms) -> {
            let arm = patterns.match_arm_list_at(arms, 0)
            patterns.pattern_field_list_len(patterns.record_fields(arm.pattern)) == 0
          }
        }
      }
      _ -> false
    }
  )
}

