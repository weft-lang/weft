test "checked body producer resolves direct calls by declaration identity" {
  match checked(
    "fn identity(value: i64) -> i64 { value } fn call() -> i64 { identity(7) }",
    "fixture/checked_body_direct_call",
    114
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      let (function, arguments) = expressions.direct_call_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedDirectCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        function_identity_eq(function, product.function(0).signature.identity)
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      Test.assert_true(
        match expressions.kind(expressions.expression_list_at(arguments, 0)) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer applies function-valued local bindings" {
  match checked(
    "fn apply(f: (i64) -> i64, value: i64) -> i64 { f(value) }",
    "fixture/checked_body_apply",
    115
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let (callee, arguments, _, _) = expressions.apply_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(callee) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects call arity and argument mismatches" {
  Test.assert_true(
    match checked(
      "fn identity(value: i64) -> i64 { value } fn wrong() -> i64 { identity() }",
      "fixture/checked_body_call_arity",
      116
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn identity(value: bool) -> bool { value } fn wrong() -> bool { identity(1) }",
      "fixture/checked_body_call_argument",
      117
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects calls through non-functions" {
  Test.assert_true(
    match checked(
      "fn wrong(value: i64) -> i64 { value() }",
      "fixture/checked_body_not_callable",
      118
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCallableRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked body producer retains declaration-valued function references" {
  match checked(
    "fn identity(value: i64) -> i64 { value } fn reference() -> (i64) -> i64 { identity }",
    "fixture/checked_body_declaration_reference",
    119
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedDeclarationReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match product.function(0).signature.identity {
          DeclaredFunctionIdentity(declaration) -> declaration_identity_eq(
            expressions.declaration(root),
            declaration
          )
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer maps every primitive binary operator" {
  match checked(
    "fn add(a: i64, b: i64) -> i64 { a + b } fn sub(a: i64, b: i64) -> i64 { a - b } fn mul(a: i64, b: i64) -> i64 { a * b } fn div(a: i64, b: i64) -> i64 { a / b } fn eq(a: i64, b: i64) -> bool { a == b } fn ne(a: i64, b: i64) -> bool { a != b } fn lt(a: i64, b: i64) -> bool { a < b } fn gt(a: i64, b: i64) -> bool { a > b } fn le(a: i64, b: i64) -> bool { a <= b } fn ge(a: i64, b: i64) -> bool { a >= b } fn modulo(a: i64, b: i64) -> i64 { a % b } fn logical_and(a: bool, b: bool) -> bool { a and b } fn logical_or(a: bool, b: bool) -> bool { a or b } fn bit_and(a: i64, b: i64) -> i64 { a band b } fn bit_or(a: i64, b: i64) -> i64 { a bor b } fn bit_xor(a: i64, b: i64) -> i64 { a bxor b } fn shift_left(a: i64, b: i64) -> i64 { a bshl b } fn shift_right(a: i64, b: i64) -> i64 { a bshr b }",
    "fixture/checked_body_binary_operators",
    120
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_eq_usize(product.function_count(), 18)
      for index in 0..18 {
        let root = product.function(__i64_to_usize(index)).body
        Test.assert_true(
          match expressions.kind(root) {
            CheckedBinaryKind -> true
            _ -> false
          }
        )
        Test.assert_eq(binary_operator_code(expressions.binary_operator(root)), index + 1)
      }
      Test.assert_true(true)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer contextualizes a leading integer binary operand" {
  match checked(
    "fn add(value: i8) -> i8 { 1 + value }",
    "fixture/checked_body_binary_context",
    121
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let left = expressions.binary_left(root)
      let catalog = expressions.types()
      Test.assert_true(
        match expressions.kind(left) {
          CheckedIntegerKind -> true
          _ -> false
        }
      )
      match catalog.graph_for(expressions.result_type(left)) {
        Some(graph) -> Test.assert_true(
          match semantic_type_graph_node(graph, expressions.result_type(left)) {
            SemanticPrimitiveNode(SemanticI8) -> true
            _ -> false
          }
        )
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer preserves boolean integer equality" {
  match checked(
    "fn same() -> bool { true == 1 }",
    "fixture/checked_body_boolean_integer_equality",
    122
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      Test.assert_true(
        match expressions.binary_operator(root) {
          CheckedEqual -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects invalid primitive binary operands" {
  Test.assert_true(
    match checked(
      "fn wrong(a: bool, b: bool) -> bool { a + b }",
      "fixture/checked_body_binary_numeric",
      123
    ) {
      CheckedBodiesRejected(CheckedBodyProducerNumericOperandRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: bool, b: bool) -> bool { a band b }",
      "fixture/checked_body_binary_integer",
      124
    ) {
      CheckedBodiesRejected(CheckedBodyProducerIntegerOperandRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: i64, b: i64) -> bool { a and b }",
      "fixture/checked_body_binary_boolean",
      125
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn wrong(a: (i64) -> i64) -> bool { a == a }",
      "fixture/checked_body_binary_dispatch",
      126
    ) {
      CheckedBodiesRejected(CheckedBodyProducerOperatorDispatchRequired(5, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer owns decoded string literal values" {
  match checked(
    "fn escaped() -> str { \"line\\nnext\" } fn empty() -> str { \"\" }",
    "fixture/checked_body_strings",
    127
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let escaped = product.function(0).body
      let empty = product.function(1).body
      Test.assert_true(
        match expressions.kind(escaped) {
          CheckedStringKind -> true
          _ -> false
        }
      )
      Test.assert_str_eq(expressions.string_value(escaped), "line\nnext")
      Test.assert_str_eq(expressions.string_value(empty), "")
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer owns exact float literal lanes" {
  match checked(
    "fn wide() -> f64 { 1.25 } fn narrow() -> f32 { 0.1 } fn sum() -> f32 { 1.25 + 2.5 }",
    "fixture/checked_body_floats",
    128
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let wide = product.function(0).body
      let narrow = product.function(1).body
      let sum = product.function(2).body
      let catalog = expressions.types()
      Test.assert_true(
        match expressions.kind(wide) {
          CheckedFloatKind -> true
          _ -> false
        }
      )
      Test.assert_eq_f64(expressions.float_value(wide), 1.25)
      Test.assert_eq_f64(
        expressions.float_value(narrow),
        __f32_to_f64(__f64_to_f32(0.1))
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(wide)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(wide)
          ) {
            SemanticPrimitiveNode(SemanticF64) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(narrow)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(narrow)
          ) {
            SemanticPrimitiveNode(SemanticF32) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_left(sum)),
          expressions.result_type(narrow)
        ) and semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_right(sum)),
          expressions.result_type(narrow)
        )
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes exhaustive scalar matches" {
  match checked(
    "fn choose(value: bool) -> i64 { match value { true -> 1 false -> 2 } } fn numeric(value: i64) -> i64 { match value { 0 -> 3 _ -> 4 } } fn nothing(value: nil) -> nil { match value { nil -> nil } }",
    "fixture/checked_body_scalar_matches",
    129
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      let boolean_root = product.function(0).body
      let numeric_root = product.function(1).body
      let nil_root = product.function(2).body
      Test.assert_true(
        match expressions.kind(boolean_root) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      )
      match expressions.match_parts(boolean_root) {
        (CheckedExplicitMatch, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
          let first = patterns.match_arm_list_at(arms, 0)
          let second = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.kind(first.pattern) {
              CheckedIntegerPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(first.pattern) {
              (1, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(second.pattern) {
              (0, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
      match expressions.match_parts(numeric_root) {
        (_, _, arms) -> {
          let literal = patterns.match_arm_list_at(arms, 0)
          let fallback = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.integer_parts(literal.pattern) {
              (0, CheckedNumericPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.kind(fallback.pattern) {
              CheckedWildcardPatternKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(nil_root) {
        (_, _, arms) -> Test.assert_true(
          match patterns.kind(patterns.match_arm_list_at(arms, 0).pattern) {
            CheckedNilPatternKind -> true
            _ -> false
          }
        )
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked match arms retain bindings guards and lexical scope" {
  match checked(
    "fn choose(value: bool, enabled: bool) -> i64 { match value { true if enabled -> 1 true -> 2 false -> 3 } } fn identity(value: i64) -> i64 { match value { captured -> captured } }",
    "fixture/checked_body_match_arms",
    130
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 3)
          let guarded = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match guarded.guard {
              CheckedGuarded(guard) -> match expressions.kind(guard) {
                CheckedLocalReferenceKind -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.match_arm_list_at(arms, 1).guard {
              CheckedUnguarded -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedBindingPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(arm.pattern),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

