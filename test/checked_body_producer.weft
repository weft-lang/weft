test "checked body producer publishes immediate handlers and resume" {
  match checked(
    "effect Box<T> { fn put(value: T) -> nil fn get() -> T } "
    |> str_concat("fn read() -[Box<i64>]> i64 { Box.get() } ")
    |> str_concat(
      "fn handled(value: i64) -> str { "
    )
    |> str_concat(
      "handle { Box.put(value) Box.get() } { "
    )
    |> str_concat(
      "Box.put(seen: i64) -> resume(nil) Box.get() -> \"stopped\" "
    )
    |> str_concat(
      "return result -> if result == 42 { \"ok\" } else { \"bad\" } } }"
    ),
    "fixture/checked_body_handle",
    153
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let effects = product.effects()
      let root = product.function(1).body
      Test.assert_true(match expressions.kind(root) { CheckedHandleKind -> true, _ -> false })
      match effects.inspect(expressions.handle_detail(root)) {
        CheckedHandleDetail(value) -> {
          Test.assert_true(
            match expressions.kind(value.body) { CheckedBlockKind -> true, _ -> false }
          )
          Test.assert_eq_usize(effects.clause_list_len(value.clauses), 2)
          let put = effects.clause_list_at(value.clauses, 0)
          let get = effects.clause_list_at(value.clauses, 1)
          Test.assert_eq_usize(effects.parameter_list_len(put.parameters), 1)
          Test.assert_true(
            match expressions.kind(put.body) { CheckedResumeKind -> true, _ -> false }
          )
          Test.assert_true(
            match put.completion { CheckedHandlerResumes -> true, _ -> false }
          )
          Test.assert_true(
            match get.completion { CheckedHandlerAborts -> true, _ -> false }
          )
          Test.assert_true(
            match value.return_clause { CheckedHandleReturnClause(_, _) -> true, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked handlers reject invalid control and effect contracts" {
  Test.assert_true(
    match checked(
      "fn bad() -> i64 { resume(1) }",
      "fixture/checked_body_resume_outside",
      154
    ) {
      CheckedBodiesRejected(CheckedBodyProducerResumeOutsideHandler) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect A { fn get() -> i64 } effect B { fn get() -> i64 } "
    |> str_concat("fn a() -[A]> i64 { A.get() } fn b() -[B]> i64 { B.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle a() { A.get() -> resume(1) B.get() -> resume(1) } }"
    ),
      "fixture/checked_body_handler_effect_mismatch",
      155
    ) {
      CheckedBodiesRejected(CheckedBodyProducerHandlerEffectMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Box<T> { fn put(value: T) -> nil } "
    |> str_concat("fn put() -[Box<i64>]> nil { Box.put(1) } ")
    |> str_concat(
      "fn bad() -> nil { handle put() { Box.put(value: str) -> resume(nil) } }"
    ),
      "fixture/checked_body_handler_parameter",
      156
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> k(1) } }"
    ),
      "fixture/checked_body_deferred_handler",
      157
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        let effects = product.effects()
        let root = product.function(1).body
        match effects.inspect(expressions.handle_detail(root)) {
          CheckedHandleDetail(value) -> {
            let clause = effects.clause_list_at(value.clauses, 0)
            match clause.continuation {
              CheckedDeferredHandlerClause(binding) -> {
                let binding_type = expressions.binding(binding).value_type
                let catalog = expressions.types()
                match catalog.graph_for(binding_type) {
                  Some(graph) -> match semantic_type_graph_node(graph, binding_type) {
                    SemanticContinuationNode(_, _) -> true
                    _ -> false
                  }
                  _ -> false
                }
              }
              _ -> false
            }
          }
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() with k -> k(1) } }"
    ),
      "fixture/checked_body_immediate_continuation",
      158
    ) {
      CheckedBodiesRejected(CheckedBodyProducerHandlerContinuationRequiresDeferred) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad(flag: bool) -> i64 { handle read() { Now.get() -> "
    )
    |> str_concat(
      "if flag { let n = resume(1) n } else { resume(2) } } }"
    ),
      "fixture/checked_body_immediate_mixed_tail_branches",
      175
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationNotTailPosition(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Now { fn get() -> i64 } fn read() -[Now]> i64 { Now.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Now.get() -> { resume(1) resume(2) } } }"
    ),
      "fixture/checked_body_immediate_continuation_twice",
      165
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyImmediateContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { k(1) k(2) } } }"
    ),
      "fixture/checked_body_deferred_continuation_twice",
      166
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn okay(flag: bool) -> i64 { handle read() { "
    )
    |> str_concat(
      "Pause.get() with k -> if flag { k(1) } else { k(2) } } }"
    ),
      "fixture/checked_body_deferred_continuation_branches",
      167
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn okay() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let next = k next(1) } } }"),
      "fixture/checked_body_deferred_continuation_alias",
      168
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let next = k k(1) } } }"),
      "fixture/checked_body_deferred_continuation_moved",
      169
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
