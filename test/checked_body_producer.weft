      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked constructor callbacks validate payload types and arity" {
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } fn callback() -> (i64) -> Choice { Pair }",
      "fixture/constructor_callback_local",
      1220
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.kind(product.function(0).body) {
          CheckedDeclarationReferenceKind -> true
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } fn wrong() -> (str) -> Choice { Pair }",
      "fixture/constructor_callback_payload",
      1221
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCallableRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } fn wrong() -> (i64, i64) -> Choice { Pair }",
      "fixture/constructor_callback_arity",
      1222
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorArityMismatch(1, 2)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { Box(T) } fn callback() -> (i64) -> Box<i64> { Box }",
      "fixture/constructor_callback_generic",
      1223
    ) {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        match expressions.kind(product.function(0).body) {
          CheckedDeclarationReferenceKind -> true
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } "
        |> str_concat("fn apply(build: (i64) -> Choice) -> Choice { build(3) } ")
        |> str_concat("fn make() -> Choice { apply(Pair) }"),
      "fixture/constructor_callback_argument",
      1225
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Empty } fn wrong() -> () -> Choice { Empty }",
      "fixture/constructor_callback_nullary",
      1224
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCallableRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } fn wrong() -> (i64) -> Choice { Pair() }",
      "fixture/constructor_callback_invoked",
      1226
    ) {
      CheckedBodiesAccepted(_) -> false
      _ -> true
    }
  )
}

test "checked constructor callbacks infer an unannotated local function value" {
  Test.assert_true(
    match checked(
      "type Choice { Pair(i64) } "
        |> str_concat("fn make() -> Choice { let build = Pair; build(3) }"),
      "fixture/constructor_callback_inferred",
      1227
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  -- A let-bound generic constructor acquires no context from its later call.
  Test.assert_true(
    match checked(
      "type Box<T> { Box(T) } "
        |> str_concat("fn make() -> Box<i64> { let build = Box; build(3) }"),
      "fixture/constructor_callback_generic_unsolved",
      1228
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorResultRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { Box(T) } fn make() -> i64 { let build = Box; 1 }",
      "fixture/constructor_callback_missing_type",
      1229
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorResultRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { Box(T) } "
        |> str_concat("fn integer(value: Box<i64>) -> i64 { 1 } ")
        |> str_concat("fn text(value: Box<str>) -> i64 { 2 } ")
        |> str_concat("fn make() -> i64 { let build = Box; 3 }"),
      "fixture/constructor_callback_unsolved_elsewhere",
      1230
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorResultRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked ordering keeps generic Ord dispatch separate from a same-named trait" {
  match checked(
    "pub type Ordering { Less, Equal, Greater } "
      |> str_concat("pub trait Ord { fn compare(self, other: Self) -> Ordering } ")
      |> str_concat("pub trait Similar { fn compare(self, other: Self) -> Ordering } ")
      |> str_concat("fn less<T: Similar & Ord>(left: T, right: T) -> bool { left < right }"),
    "stdlib/ord",
    1202
  ) {
    CheckedBodiesAccepted(product) -> assert_checked_order_case(product, 0, "Less", true)
    _ -> Test.assert_true(false)
  }
}

test "checked ordering refuses absent or malformed canonical Ord contracts" {
  Test.assert_true(
    match checked(
      "fn earlier(left: str, right: str) -> bool { left < right }",
      "fixture/ordering_without_ord",
      1203
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalOrdUnavailable) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub type Ordering { Less, Equal, Greater } "
        |> str_concat("pub trait Ord { fn compare(self, other: Self) -> bool } ")
        |> str_concat("fn earlier<T: Ord>(left: T, right: T) -> bool { left < right }"),
      "stdlib/ord",
      1204
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalOrdInvalid(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub type Ordering { Less, Equal, Greater } "
        |> str_concat("pub trait Ord { fn compare(self, other: Self) -> Ordering } ")
        |> str_concat("type Token { value: i64 } ")
        |> str_concat("fn earlier(left: Token, right: Token) -> bool { left < right }"),
      "stdlib/ord",
      1205
    ) {
      CheckedBodiesRejected(CheckedBodyProducerOrdImplementationRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub type Ordering { Equal, Greater } "
        |> str_concat("pub trait Ord { fn compare(self, other: Self) -> Ordering } ")
        |> str_concat(
          "impl Ord for Ordering { fn compare(self: Self, other: Self) -> Ordering { self } } "
        )
        |> str_concat("fn earlier(left: Ordering, right: Ordering) -> bool { left < right }"),
      "stdlib/ord",
      1206
    ) {
      CheckedBodiesRejected(CheckedBodyProducerOrderingCaseUnavailable(name)) -> name == "Less"
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub effect Tick { fn now() -> i64 } "
        |> str_concat("pub type Ordering { Less, Equal, Greater } ")
        |> str_concat("pub trait Ord { fn compare(self, other: Self) -[Tick]> Ordering } ")
        |> str_concat("fn earlier<T: Ord>(left: T, right: T) -> bool { left < right }"),
      "stdlib/ord",
      1208
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalOrdInvalid(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub type Ordering { Less, Equal, Greater } "
        |> str_concat("pub trait Ord { fn compare(self, other: Self) -> Ordering } ")
        |> str_concat("pub trait Similar { fn compare(self, other: Self) -> Ordering } ")
        |> str_concat(
          "impl Similar for Ordering { fn compare(self: Self, other: Self) -> Ordering { self } } "
        )
        |> str_concat("fn earlier(left: Ordering, right: Ordering) -> bool { left < right }"),
      "stdlib/ord",
      1209
    ) {
      CheckedBodiesRejected(CheckedBodyProducerOrdImplementationRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked numeric ordering remains a direct binary operator" {
  match checked(
    "fn earlier(left: i64, right: i64) -> bool { left < right }",
    "fixture/checked_numeric_order",
    1207
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedBinaryKind -> match expressions.binary_operator(product.function(0).body) {
            CheckedLessThan -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked constructor patterns retain generic payloads and bindings" {
  match checked(
    "type Choice<T> { Empty, Pair(T, i64) } "
      |> str_concat(
        "fn pick(value: Choice<str>) -> str { match value { Pair(text, _) -> text _ -> \"none\" } } "
      )
      |> str_concat(
        "type Wrap<T> { Wrap(T) } fn unwrap(value: Wrap<i64>) -> i64 { match value { Wrap(n) -> n } }"
      )
      |> str_concat(
        " type Chain<T> { End, Link(T, Chain<T>) } "
      )
      |> str_concat(
        "fn tail(value: Chain<i64>) -> Chain<i64> { match value { Link(_, rest) -> rest _ -> value } }"
      ),
    "fixture/checked_body_constructor_patterns",
    1184
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedConstructorPatternKind -> true
              _ -> false
            }
          )
          let (declaration, children, qualifier) = patterns.constructor_parts(arm.pattern)
          Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), "Pair")
          Test.assert_true(qualifier == nil)
          Test.assert_eq_usize(patterns.pattern_list_len(children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 0)),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedConstructorPatternKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(product.function(2).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          let (_, children, _) = patterns.constructor_parts(arm.pattern)
          Test.assert_eq_usize(patterns.pattern_list_len(children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 1)),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked constructor patterns reject wrong cases arities and payloads" {
  Test.assert_true(
    match checked(
      "type Choice { Empty, Pair(i64, bool) } fn bad(value: Choice) -> i64 { match value { Missing -> 1 _ -> 0 } }",
      "fixture/checked_body_constructor_missing",
