    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "type Choice<T> { Empty } fn bad() -> Choice<i64> { Empty<i64, str>() }",
      "fixture/checked_explicit_constructor_type_arity",
      1231
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeRejected(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice<T> { Value(T) } fn bad() -> Choice<i64> { Value<i64>(\"bad\") }",
      "fixture/checked_explicit_constructor_payload",
      1232
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked opaque constructors preserve representation and nominal result" {
  match checked(
    "type Id = opaque i64 fn make() -> Id { Id(3) } "
      |> str_concat("fn unwrap(value: Id) -> i64 { match value { Id(number) -> number } }"),
    "fixture/checked_opaque_constructor",
    1233
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let body = product.function(0).body
      Test.assert_true(
        match expressions.kind(body) {
          CheckedConstructorCallKind -> true
          _ -> false
        }
      )
      let (_, arguments) = expressions.constructor_call_parts(body)
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
      let match_body = product.function(1).body
      Test.assert_true(
        match expressions.kind(match_body) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "type Id = opaque i64 fn bad() -> Id { Id(1, 2) }",
      "fixture/checked_opaque_constructor_arity",
      1234
    ) {
      CheckedBodiesRejected(CheckedBodyProducerConstructorArityMismatch(1, 2)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Id = opaque i64 fn bad() -> Id { Id(\"wrong\") }",
      "fixture/checked_opaque_constructor_representation",
      1235
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_drop(
      "type Handle = opaque i64 impl Drop for Handle { } "
        |> str_concat("fn consume(value: owned Handle) -> i64 { ")
        |> str_concat("match value { Handle(number) -> number } }"),
      "fixture/checked_owned_opaque_pattern",
      1243
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Handle = opaque i64 "
        |> str_concat("fn inspect(value: borrow Handle) -> i64 { ")
        |> str_concat("match value { Handle(number) -> number } }"),
      "fixture/checked_borrowed_opaque_pattern",
      1244
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked_with_drop(
      "type Resource = opaque i64 "
        |> str_concat("impl Drop for Resource { fn drop(self) -> nil { nil } } ")
        |> str_concat("type Box = opaque owned Resource ")
        |> str_concat("fn take(value: owned Resource) -> nil { nil } ")
        |> str_concat("fn bad(value: borrow Box) -> nil { ")
        |> str_concat("match value { Box(inner) -> take(inner) } }"),
      "fixture/checked_borrowed_opaque_move_refused",
      1245
    ) {
      CheckedBodiesRejected(CheckedBodyProducerBorrowNotValue(_, _)) -> true
      _ -> false
    }
  )
}

fn opaque_consumer_prefix() -> str {
  "use fixture/opaque_owner.{Box, Token, token, token_value} "
    |> str_concat("use fixture/opaque_owner as owner ")
}

fn checked_opaque_consumer(text: str, discriminator: i64) -[Test]> CheckedBodyCheckResult {
  let declaring = registered(
    "pub type Token = opaque i64 pub type Box<T> = opaque (T, i64) "
      |> str_concat("pub fn token(value: i64) -> Token { Token(value) } ")
      |> str_concat(
        "pub fn token_value(token: Token) -> i64 { match token { Token(value) -> value } }"
      ),
    named_module_identity("fixture/opaque_owner", discriminator)
  )
  let consumer = registered(
    str_concat(opaque_consumer_prefix(), text),
    named_module_identity("fixture/opaque_consumer", discriminator)
  )
  let selected = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    declaring.identity,
    false
  )
  let aliased = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(1).unwrap(),
    declaring.identity,
    false
  )
  let modules = [declaring, consumer]
  let imports = [selected, aliased]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved opaque consumer signatures")
  }
}

fn opaque_privacy_outcome(text: str, discriminator: i64) -[Test]> str {
  let full = str_concat(opaque_consumer_prefix(), text)
  let located = (kind: str, range: CheckedSourceRange) => match full.slice(range.start, range.end) {
    Some(name) -> i"{kind} {name}@{range.start}"
    None -> i"{kind} invalid range"
  }
  match checked_opaque_consumer(text, discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerOpaqueConstructorPrivate(range)) ->
      located("constructor", range)
    CheckedBodiesRejected(CheckedBodyProducerOpaqueProjectionPrivate(range)) ->
      located("projection", range)
    CheckedBodiesRejected(_) -> "other rejection"
  }
}

fn opaque_privacy_expected(kind: str, text: str, marker: str, name: str) -> str {
  match str_concat(opaque_consumer_prefix(), text).find(marker) {
    Some(start) -> i"{kind} {name}@{start}"
    None -> "marker missing"
  }
}

test "checked opaque construction and projection are private to the declaring module" {
  let constructed = [
    "fn bad() -> Token { Token(1) }",
    "fn bad() -> Token { owner.Token(1) }",
    "fn bad() -> Box<i64> { Box<i64>((1, 2)) }",
    "fn bad() -> Box<i64> { owner.Box<i64>((1, 2)) }",
    "type Alias = Token fn bad() -> Token { Alias(1) }",
    "fn bad() -> i64 { let value = Token(\"wrong\") 0 }",
    "fn bad() -> Box<i64> { Box((1, 2)) }",
    "fn bad() -> Box<i64> { owner.Box((1, 2)) }"
  ]
  let constructed_markers = [
    "Token(1)",
    "Token(1)",
    "Box<i64>((",
    "Box<i64>((",
    "Alias(1)",
    "Token(\"wrong\")",
    "Box((",
    "Box(("
  ]
  let constructed_names = ["Token", "Token", "Box", "Box", "Alias", "Token", "Box", "Box"]
  let zero: usize = 0
  for index in zero..constructed.len {
    Test.assert_str_eq(
      opaque_privacy_outcome(
        constructed[index],
        1407 + __u64_to_i64(__usize_to_u64(index))
      ),
      opaque_privacy_expected(
        "constructor",
        constructed[index],
        constructed_markers[index],
        constructed_names[index]
      )
    )
  }
  let projected = [
    "fn bad(value: Token) -> i64 { match value { Token(number) -> number } }",
    "fn bad(value: Token) -> i64 { match value { owner.Token(number) -> number } }",
    "fn bad(value: Box<i64>) -> i64 { match value { Box((number, _)) -> number } }"
  ]
  let projected_markers = ["Token(number)", "Token(number)", "Box(("]
  let projected_names = ["Token", "Token", "Box"]
  for index in zero..projected.len {
    Test.assert_str_eq(
      opaque_privacy_outcome(projected[index], 1415 + __u64_to_i64(__usize_to_u64(index))),
      opaque_privacy_expected(
        "projection",
        projected[index],
        projected_markers[index],
        projected_names[index]
      )
    )
  }
  -- Exported factories, accessors and non-projecting patterns keep the
  -- abstraction usable without granting wrap or projection authority.
  let permitted = [
    "fn good() -> Token { token(1) }",
    "fn good(value: Token) -> i64 { token_value(value) }",
    "fn good() -> i64 { owner.token_value(owner.token(2)) }",
    "fn good(value: Token) -> i64 { match value { _ -> 0 } }",
    "fn good(value: Token) -> Token { match value { other -> other } }"
  ]
  for index in zero..permitted.len {
    Test.assert_str_eq(
      opaque_privacy_outcome(permitted[index], 1418 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
  }
}

