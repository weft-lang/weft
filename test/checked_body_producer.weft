  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("fn erase(value: any) -> i64 { 0 } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> erase(k) } }"
    ),
      "fixture/checked_body_continuation_any_escape",
      177
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Box { value: i64 } ")
    |> str_concat(
      "impl Box { fn consume(self, k: Continuation<i64, i64>) -> i64 { k(4) } } "
    )
    |> str_concat(
      "fn okay(box: Box) -> i64 { handle read() { Pause.get() with k -> box.consume(k) } }"
    ),
      "fixture/checked_body_method_continuation_consumer",
      178
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Box { value: i64 } ")
    |> str_concat("impl Box { fn erase(self, value: any) -> i64 { 0 } } ")
    |> str_concat(
      "fn bad(box: Box) -> i64 { handle read() { Pause.get() with k -> box.erase(k) } }"
    ),
      "fixture/checked_body_method_continuation_any_escape",
      179
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Holder<T> { value: i64 } ")
    |> str_concat("impl<T> Holder<T> { fn erase(self, value: T) -> i64 { 0 } } ")
    |> str_concat(
      "fn bad(holder: Holder<Continuation<i64, i64>>) -> i64 { "
    )
    |> str_concat("handle read() { Pause.get() with k -> holder.erase(k) } }"),
      "fixture/checked_body_generic_method_continuation_escape",
      180
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationConsumerRequired(_)) -> true
      _ -> false
    }
  )
}

test "checked deferred continuation helper results retain the same one-shot obligation" {
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { "
    |> str_concat("match true { true -> k false -> nil } }"),
      "fixture/checked_body_continuation_match_erasure",
      192
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> Continuation<i64, i64> { "
    |> str_concat("if true { k } else { k } }"),
      "fixture/checked_body_continuation_branch_alias",
      193
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { if true { k } else { nil } }",
      "fixture/checked_body_continuation_branch_erasure",
      191
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationBranchEscape(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn okay(k: Continuation<i64, Continuation<i64, i64>>) -> i64 { "
    |> str_concat("let next = k(1) next(2) }"),
      "fixture/checked_body_continuation_result_chain",
      189
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, Continuation<i64, i64>>) -> i64 { "
    |> str_concat("let next = k(1) next(2) + next(3) }"),
      "fixture/checked_body_continuation_result_chain_twice",
      190
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyFunctionContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let mut saved = k saved(1) } } }"),
      "fixture/checked_body_continuation_mutable_alias",
      188
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationMutableBinding(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { k }",
      "fixture/checked_body_continuation_result_erasure",
      186
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationResultRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> any { return k }",
      "fixture/checked_body_continuation_return_erasure",
      187
    ) {
      CheckedBodiesRejected(CheckedBodyProducerContinuationResultRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn pass(k: Continuation<i64, i64>) -> Continuation<i64, i64> { k } "
    )
    |> str_concat(
      "fn okay() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let saved = pass(k) saved(1) } } }"),
      "fixture/checked_body_continuation_helper_result",
      183
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn pass(k: Continuation<i64, i64>) -> Continuation<i64, i64> { k } "
    )
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let saved = pass(k) saved(1) + saved(2) } } }"),
      "fixture/checked_body_continuation_helper_result_twice",
      184
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat(
      "fn pass(k: Continuation<i64, i64>) -> Continuation<i64, i64> { k } "
    )
    |> str_concat(
      "fn bad() -> i64 { handle read() { Pause.get() with k -> { "
    )
    |> str_concat("let saved = pass(k) k(1) } } }"),
      "fixture/checked_body_continuation_helper_original_moved",
      185
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyDeferredContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
}

test "checked body producer rejects a literal outside the declared result type" {
  Test.assert_true(
    match checked(
      "fn bad() -> bool { 7 }",
      "fixture/checked_body_type_mismatch",
      93
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects authored forms it has not converted" {
  Test.assert_true(
    match checked(
      "fn unsupported(value: i64) -> i64 { &value }",
      "fixture/checked_body_unsupported",
      94
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnsupportedExpression) -> true
      _ -> false
    }
  )
}
