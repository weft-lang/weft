    |> str_concat("Box<R.Output>(0) } ")
    |> str_concat(
      "fn second<U: Build, T: Build & { type Output = U }>(value: T) "
    )
    |> str_concat("-> owned Box<U.Output> { first<T, U>(value) }"),
      "fixture/checked_body_forwarded_nested_associated",
      1264,
      true
    ) {
      CheckedBodiesAccepted(_) -> "accepted"
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
      CheckedBodiesRejected(CheckedBodyProducerGenericBoundRejected(_, _)) -> "generic bound"
