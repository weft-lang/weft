      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Choice<T> { Empty, Value(T) } "
        |> str_concat("fn first(value: Choice<i64>) -> Choice<i64> { value } ")
        |> str_concat("fn second(value: Choice<str>) -> Choice<str> { value } ")
        |> str_concat("fn unsolved() -> i64 { let value = Empty; 1 }"),
