      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(base: { x: i64 }) -> { x: i64 } { base.{ x: 1, x: 2 } }",
      "fixture/checked_body_update_duplicate_field",
      1238
    ) {
      CheckedBodiesRejected(CheckedBodyProducerDuplicateRecordField(_)) -> true
      _ -> false
    }
  )
}

