test "checked expression application respects effect authority" {
  let source = "effect Read { fn get() -> i64 } "
  Test.assert_true(
    match checked(
      str_concat(source, "fn bad(f: () -[Read]> i64) -> i64 { (f)() }"),
      "fixture/checked_body_apply_effect_denied",
      1154
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_)) -> true
      _ -> false
    }
  )
  match checked(
    str_concat(source, "fn ok(f: () -[Read]> i64) -[Read]> i64 { (f)() }"),
    "fixture/checked_body_apply_effect_allowed",
    1155
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedApplyKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "parenthesized continuation applications remain one-shot" {
  Test.assert_true(
    match checked(
      "fn okay(k: Continuation<i64, i64>) -> i64 { (k)(1) }",
      "fixture/checked_body_parenthesized_continuation_once",
      1157
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad(k: Continuation<i64, i64>) -> i64 { (k)(1) + (k)(2) }",
      "fixture/checked_body_parenthesized_continuation_twice",
      1158
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyFunctionContinuationUsedMoreThanOnce(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
}

test "checked calls require every dependency effect from their environment" {
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
    |> str_concat("fn bad() -> i64 { read() }"),
      "fixture/checked_body_call_effect_missing",
      159
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
    |> str_concat("fn caller() -[Read]> i64 { read() }"),
      "fixture/checked_body_call_effect_available",
      160
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn apply<e>(f: () -[e]> i64) -[e]> i64 { f() }",
      "fixture/checked_body_call_effect_tail",
      161
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn bad<e>(f: () -[e]> i64) -> i64 { f() }",
      "fixture/checked_body_call_effect_tail_missing",
      162
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectTailUnavailable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
    |> str_concat(
      "fn bad() -> i64 { handle read() { Read.get() -> read() } }"
    ),
      "fixture/checked_body_clause_call_effect_missing",
      163
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEffectUnavailable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "effect Read { fn get() -> i64 } fn read() -[Read]> i64 { Read.get() } "
    |> str_concat(
      "fn outer() -[Read]> i64 { handle read() { Read.get() -> read() } }"
    ),
      "fixture/checked_body_clause_call_effect_outer",
      164
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

test "checked body producer rejects call arity and argument mismatches" {
  Test.assert_true(
    match checked(
      "fn identity(value: i64) -> i64 { value } fn wrong() -> i64 { identity() }",
      "fixture/checked_body_call_arity",
      116
    ) {
      CheckedBodiesRejected(CheckedBodyProducerArityMismatch(1, 0)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn identity(value: bool) -> bool { value } fn wrong() -> bool { identity(1) }",
      "fixture/checked_body_call_argument",
      117
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
}

test "checked generic calls retain ordered type arguments and specialized result" {
  match checked(
    "fn identity<T>(value: T) -> T { value } fn caller() -> i64 { identity<i64>(5) }",
    "fixture/checked_body_generic_call",
    1161
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      Test.assert_true(
        match expressions.kind(root) {
          CheckedGenericCallKind -> true
          _ -> false
        }
      )
      match expressions.generic_call_parts(root) {
        (call, arguments) -> {
          Test.assert_true(
            match expressions.kind(call) {
              CheckedDirectCallKind -> true
              _ -> false
            }
          )
          Test.assert_eq_usize(expressions.type_list_len(arguments), 1)
          let catalog = expressions.types()
          let argument = expressions.type_list_at(arguments, 0)
          Test.assert_true(
            semantic_type_catalog_equal(catalog, argument, expressions.result_type(root))
          )
          Test.assert_true(
            match catalog.graph_for(argument) {
              Some(graph) -> match semantic_type_graph_node(graph, argument) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked generic calls preserve two argument identities in declaration order" {
  match checked(
    "fn choose<A, B>(left: A, right: B) -> B { right } fn caller() -> bool { choose<i64, bool>(5, true) }",
    "fixture/checked_body_generic_order",
    1167
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(1).body
      match expressions.generic_call_parts(root) {
        (_, arguments) -> {
          Test.assert_eq_usize(expressions.type_list_len(arguments), 2)
          let catalog = expressions.types()
          let first = expressions.type_list_at(arguments, 0)
          let second = expressions.type_list_at(arguments, 1)
          Test.assert_true(
            match catalog.graph_for(first) {
              Some(graph) -> match semantic_type_graph_node(graph, first) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            semantic_type_catalog_equal(catalog, second, expressions.result_type(root))
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "fn identity<T>(value: T) -> T { value } fn forward<U>(value: U) -> U { identity<U>(value) }",
      "fixture/checked_body_generic_owner_argument",
      1170
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
}

