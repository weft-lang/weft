    |> str_concat("fn bad(row: Box) -> [i64] { id(row.wide) }"),
      "fixture/checked_body_unknown_slice_call",
      1214
    ) {
      CheckedBodiesRejected(CheckedBodyProducerFreezeRejected(issue)) -> match issue {
        CheckedBodyBorrowCannotEscape(_) -> true
        _ -> false
      }
      _ -> false
    }
  )
  match checked(
    "fn id<T>(values: [T]) -> [T] { values } "
    |> str_concat("fn wrap(values: [i64]) -> [i64] { id<i64>(values) }"),
    "fixture/checked_body_generic_slice_call",
    1215
  ) {
    CheckedBodiesAccepted(product) -> {
      let call = product.function(1).body
      let expressions = product.expressions()
      let borrows = product.borrows()
      Test.assert_true(
        match expressions.kind(call) {
          CheckedGenericCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match borrows.view(call) {
          Some(origins) -> match checked_borrow_origins_escape(origins) {
            CheckedBorrowEscapes -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match checked(
    "fn id<T>(values: [T]) -> [T] { values } "
    |> str_concat("fn wrap(values: [i64]) -> [i64] { id(values) }"),
    "fixture/checked_body_inferred_generic_slice_call",
    1217
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let borrows = product.borrows()
      let call = product.function(1).body
      Test.assert_true(
        match expressions.kind(call) {
          CheckedGenericCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match borrows.view(call) {
          Some(origins) -> match checked_borrow_origins_escape(origins) {
            CheckedBorrowEscapes -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked method calls retain slice arguments" {
  match checked(
    "type Box { value: i64 } "
    |> str_concat("impl Box { fn keep(self, values: [i64]) -> [i64] { values } } ")
    |> str_concat("fn wrap(values: [i64]) -> [i64] { Box{value:1}.keep(values) }"),
    "fixture/checked_body_method_slice_call",
    1216
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let borrows = product.borrows()
      let call = product.function(1).body
      Test.assert_true(
        match expressions.kind(call) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match borrows.view(call) {
          Some(origins) -> match checked_borrow_origins_escape(origins) {
            CheckedBorrowEscapes -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match checked(
      "impl i64 { fn keep(self: i64, values: [i64]) -> [i64] { values } } "
    |> str_concat("fn wrap(values: [i64]) -> [i64] { 1.keep(values) }"),
      "fixture/checked_body_primitive_method_slice_call",
      1229
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  match checked(
    "impl i64 { fn keep(self: i64) -> i64 { self } } "
    |> str_concat("impl str { fn keep(self: str) -> str { self } } ")
    |> str_concat("fn first() -> i64 { 1.keep() } ")
    |> str_concat("fn second() -> str { \"a\".keep() }"),
    "fixture/checked_body_primitive_method_identities",
    1230
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let (first, _, _) = expressions.method_call_parts(product.function(2).body)
      let (second, _, _) = expressions.method_call_parts(product.function(3).body)
      Test.assert_true(not declaration_identity_eq(first, second))
    }
    _ -> Test.assert_true(false)
  }
}

test "checked generic calls infer multiple type arguments and refuse missing witnesses" {
  Test.assert_true(
    match checked(
      "fn second<T, U>(first: T, second: U) -> U { second } "
    |> str_concat(
      "fn wrap(values: [i64]) -> [i64] { second(1, values) }"
    ),
      "fixture/checked_body_inferred_multiple_generic_arguments",
      1218
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "type Box<T> { value: T } "
    |> str_concat("fn unbox<T>(box: Box<T>) -> T { box.value } ")
    |> str_concat("fn caller() -> i64 { unbox(Box<i64>{value:5}) }"),
      "fixture/checked_body_inferred_nominal_generic_argument",
      1223
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn pick<T>(anchor: T, compatible: i64) -> T { anchor } "
    |> str_concat("fn caller() -> i64 { pick(1, true) }"),
      "fixture/checked_body_inferred_subtype_argument",
      1224
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn identity<T>(value: T) -> T { value } "
    |> str_concat("fn caller<U>(value: U) -> U { identity(value) }"),
      "fixture/checked_body_inferred_lexical_type_variable",
      1225
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn same<T>(left: T, right: T) -> T { left } "
    |> str_concat("fn caller() -> i64 { same(1, true) }"),
      "fixture/checked_body_inferred_repeated_subtype_argument",
      1226
    ) {
      CheckedBodiesAccepted(_) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn same<T>(left: T, right: T) -> T { left } "
    |> str_concat("fn wrong() -> i64 { same(1, \"text\") }"),
      "fixture/checked_body_inferred_conflicting_arguments",
      1219
    ) {
      CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "fn ignore<T>(value: i64) -> i64 { value } "
    |> str_concat("fn wrong() -> i64 { ignore(1) }"),
      "fixture/checked_body_inferred_missing_witness",
      1220
    ) {
      CheckedBodiesRejected(CheckedBodyProducerGenericInferenceIncomplete(_)) -> true
      _ -> false
    }
  )
}

test "checked indexing supports body-local arrays" {
  match checked(
    "fn local() -> i64 { let values: [i64; 2] = [1, 2]; values[0] } "
    |> str_concat("fn direct() -> i64 { [3, 4][1] }"),
    "fixture/checked_body_local_indexing",
    934
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
