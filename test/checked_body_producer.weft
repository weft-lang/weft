test "checked variant construction preserves a module-qualified imported case" {
  let dependency = registered(
    "pub type Choice { Empty, Pair(i64) }",
    named_module_identity("fixture/constructor_values_dependency", 1218)
  )
  let consumer = registered(
    "use fixture/constructor_values_dependency as dep "
      |> str_concat("fn make() -> dep.Choice { dep.Pair(3) } ")
      |> str_concat("fn empty() -> dep.Choice { dep.Empty } ")
      |> str_concat("fn callback() -> (i64) -> dep.Choice { dep.Pair }"),
    named_module_identity("fixture/constructor_values_consumer", 1219)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let modules = [dependency, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      0
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    } {
      CheckedBodiesAccepted(product) -> {
        let expressions = product.expressions()
        let root = product.function(0).body
        Test.assert_true(
          match expressions.kind(root) {
            CheckedConstructorCallKind -> true
            _ -> false
          }
        )
        let (declaration, _) = expressions.constructor_call_parts(root)
        Test.assert_true(
          module_identity_eq(declaration_identity_module(declaration), dependency.identity)
        )
        let empty = product.function(1).body
        Test.assert_true(
          match expressions.kind(empty) {
            CheckedConstructorCallKind -> true
            _ -> false
          }
        )
        let (empty_declaration, empty_arguments) = expressions.constructor_call_parts(empty)
        Test.assert_str_eq(declaration_identity_name(empty_declaration).text().unwrap(), "Empty")
        Test.assert_eq_usize(expressions.expression_list_len(empty_arguments), 0)
        let callback = product.function(2).body
        Test.assert_true(
          match expressions.kind(callback) {
            CheckedDeclarationReferenceKind -> true
            _ -> false
          }
        )
        Test.assert_true(
          declaration_identity_eq(expressions.declaration(callback), declaration)
        )
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "checked bodies resolve imported free function signatures" {
  let dependency = registered(
