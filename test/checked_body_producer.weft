      let expressions = product.expressions()
      let catalog = expressions.types()
      let declarations = product.declarations()
      let slice_parameter = expressions.function_parameter(product.function(0).parameters, 0)
      let scalar_parameter = expressions.function_parameter(product.function(1).parameters, 0)
      Test.assert_true(
        match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(slice_parameter).value_type
        ) {
          SemanticContainsSlice -> true
          _ -> false
