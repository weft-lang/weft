      Test.assert_true(
        match semantic_type_slice_containment(
          catalog,
          declarations,
          expressions.binding(scalar_parameter).value_type
        ) {
          SemanticDoesNotContainSlice -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

