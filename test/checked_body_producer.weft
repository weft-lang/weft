test "checked equality dispatches through the canonical Eq implementation" {
  match checked(
    "pub trait Eq { fn eq(self, other: Self) -> bool } "
      |> str_concat("type Token { value: i64 } ")
      |> str_concat(
        "impl Eq for Token { fn eq(self: Self, other: Self) -> bool { true } } "
      )
      |> str_concat("fn equal(left: Token, right: Token) -> bool { left == right } ")
      |> str_concat("fn different(left: Token, right: Token) -> bool { left != right }"),
    "stdlib/eq",
    1193
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_true(
        match expressions.kind(product.function(1).body) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(product.function(2).body) {
          CheckedNotKind -> match expressions.kind(
            expressions.not_operand(product.function(2).body)
          ) {
            CheckedMethodCallKind -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

