test "checked body producer owns exact float literal lanes" {
  match checked(
    "fn wide() -> f64 { 1.25 } fn narrow() -> f32 { 0.1 } fn sum() -> f32 { 1.25 + 2.5 }",
    "fixture/checked_body_floats",
    128
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let wide = product.function(0).body
      let narrow = product.function(1).body
      let sum = product.function(2).body
      let catalog = expressions.types()
      Test.assert_true(
        match expressions.kind(wide) {
          CheckedFloatKind -> true
          _ -> false
        }
      )
      Test.assert_eq_f64(expressions.float_value(wide), 1.25)
      Test.assert_eq_f64(
        expressions.float_value(narrow),
        __f32_to_f64(__f64_to_f32(0.1))
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(wide)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(wide)
          ) {
            SemanticPrimitiveNode(SemanticF64) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(narrow)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(narrow)
          ) {
            SemanticPrimitiveNode(SemanticF32) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_left(sum)),
          expressions.result_type(narrow)
        ) and semantic_type_catalog_equal(
          catalog,
          expressions.result_type(expressions.binary_right(sum)),
          expressions.result_type(narrow)
        )
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer publishes exhaustive scalar matches" {
  match checked(
    "fn choose(value: bool) -> i64 { match value { true -> 1 false -> 2 } } fn numeric(value: i64) -> i64 { match value { 0 -> 3 _ -> 4 } } fn nothing(value: nil) -> nil { match value { nil -> nil } }",
    "fixture/checked_body_scalar_matches",
    129
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      let boolean_root = product.function(0).body
      let numeric_root = product.function(1).body
      let nil_root = product.function(2).body
      Test.assert_true(
        match expressions.kind(boolean_root) {
          CheckedExplicitMatchKind -> true
          _ -> false
        }
      )
      match expressions.match_parts(boolean_root) {
        (CheckedExplicitMatch, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 2)
          let first = patterns.match_arm_list_at(arms, 0)
          let second = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.kind(first.pattern) {
              CheckedIntegerPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(first.pattern) {
              (1, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(second.pattern) {
              (0, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
      match expressions.match_parts(numeric_root) {
        (_, _, arms) -> {
          let literal = patterns.match_arm_list_at(arms, 0)
          let fallback = patterns.match_arm_list_at(arms, 1)
          Test.assert_true(
            match patterns.integer_parts(literal.pattern) {
              (0, CheckedNumericPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.kind(fallback.pattern) {
              CheckedWildcardPatternKind -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(nil_root) {
        (_, _, arms) -> Test.assert_true(
          match patterns.kind(patterns.match_arm_list_at(arms, 0).pattern) {
            CheckedNilPatternKind -> true
            _ -> false
          }
        )
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "a literal fills a unique position, as any fresh value does" {
  let accepted = [
    "fn take(value: unique i64) -> i64 { 0 } fn call() -> i64 { take(21) }",
    "fn call(f: (unique i64) -> i64) -> i64 { f(21) }",
    "fn take(value: unique bool) -> i64 { 0 } fn call() -> i64 { take(true) }",
    "fn take(value: unique f64) -> i64 { 0 } fn call() -> i64 { take(2.5) }"
  ]
  let mut index: usize = 0
  while index < accepted.len {
    Test.assert_str_eq(
      operand_outcome(accepted[index], 2420 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
  -- A binding may have other readers, so it is not unique without a move.
  Test.assert_str_eq(
    operand_outcome(
      "fn take(value: unique i64) -> i64 { 0 } fn call(x: i64) -> i64 { take(x) }",
      2425
    ),
    "type mismatch"
  )
}

fn record_matrix_outcome(arms: str, discriminator: i64) -[Test]> str {
  boolean_pattern_outcome(
    "type Bit { Zero, One } type Pair { left: Bit, right: Bit } "
      |> str_concat(arms),
    discriminator
  )
}

test "record patterns cover their fields as a product, in any field order" {
  let exhaustive = [
    "fn f(value: { left: Bit, right: Bit }) -> i64 { match value { "
      |> str_concat("{ left: Zero, right: Zero } -> 0, { right: One, left: Zero } -> 1, ")
      |> str_concat("{ left: One, right: Zero } -> 2, { right: One, left: One } -> 3 } }"),
    "fn f(value: Pair) -> i64 { match value { "
      |> str_concat("{ left: Zero, right: Zero } -> 0, { right: One, left: Zero } -> 1, ")
      |> str_concat("{ left: One, right: Zero } -> 2, { right: One, left: One } -> 3 } }"),
    -- An omitted field matches every value.
    "fn f(value: Pair) -> i64 { match value { { left: Zero } -> 0, { left: One } -> 1 } }",
    "fn f(value: { left: Bit, right: Bit }) -> i64 { match value { "
      |> str_concat(
        "{ right: Zero } -> 0, { left: Zero, right: One } -> 1, { left: One } -> 2 } }"
      )
  ]
  let mut index: usize = 0
  while index < exhaustive.len {
    Test.assert_str_eq(
      record_matrix_outcome(exhaustive[index], 2400 + __u64_to_i64(__usize_to_u64(index))),
      "accepted"
    )
    index = index + 1
  }
  let incomplete = [
    "fn f(value: Pair) -> i64 { match value { "
      |> str_concat("{ left: Zero, right: Zero } -> 0, { right: One, left: One } -> 1 } }"),
    "fn f(value: { left: Bit, right: Bit }) -> i64 { match value { "
      |> str_concat("{ left: Zero } -> 0, { right: Zero } -> 1 } }")
  ]
  index = 0
  while index < incomplete.len {
    Test.assert_str_eq(
      record_matrix_outcome(incomplete[index], 2410 + __u64_to_i64(__usize_to_u64(index))),
      "non_exhaustive"
    )
    index = index + 1
  }
}

fn boolean_pattern_outcome(text: str, discriminator: i64) -[Test]> str {
  match checked(text, "fixture/checked_boolean_pattern", discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> "non_exhaustive"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "type mismatch"
    CheckedBodiesRejected(_) -> "other"
  }
}

test "a boolean pattern matches its value wherever the scrutinee holds booleans" {
  -- `bool` is `{0, 1}` within `i64`, so `true` matches the integer 1 there.
  match checked(
    "fn choose(value: i64) -> i64 { match value { true -> 10, false -> 20, _ -> 30 } }",
    "fixture/checked_boolean_pattern_integer",
    2391
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let patterns = product.patterns()
          Test.assert_true(
            match patterns.integer_parts(patterns.match_arm_list_at(arms, 0).pattern) {
              (1, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.integer_parts(patterns.match_arm_list_at(arms, 1).pattern) {
              (0, CheckedBooleanPattern) -> true
              _ -> false
            }
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_str_eq(
    boolean_pattern_outcome(
      "fn choose(value: (i64, bool)) -> i64 { match value { (true, false) -> 1, _ -> 2 } }",
      2392
    ),
    "accepted"
  )
  -- Over the integers the two booleans do not cover the scrutinee.
  Test.assert_str_eq(
    boolean_pattern_outcome(
      "fn choose(value: i64) -> i64 { match value { true -> 10, false -> 20 } }",
      2393
    ),
    "non_exhaustive"
  )
  -- A scrutinee without booleans has nothing for them to match.
  Test.assert_str_eq(
    boolean_pattern_outcome(
      "fn choose(value: str) -> i64 { match value { true -> 1, _ -> 2 } }",
      2394
    ),
    "type mismatch"
  )
  Test.assert_str_eq(
    boolean_pattern_outcome(
      "fn choose(value: u8) -> i64 { match value { true -> 1, _ -> 2 } }",
      2395
    ),
    "type mismatch"
  )
}

fn typed_arm_outcome(text: str, discriminator: i64) -[Test]> str {
  match checked(text, "fixture/checked_typed_arm", discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(CheckedBodyProducerNonExhaustiveMatch) -> "non_exhaustive"
    CheckedBodiesRejected(CheckedBodyProducerTypedArmOutsideScrutinee(_)) -> "outside"
    CheckedBodiesRejected(CheckedBodyProducerRuntimeDiscriminationUnavailable(_, _)) ->
      "discrimination"
    CheckedBodiesRejected(CheckedBodyProducerTypeMismatch(_, _)) -> "mismatch"
    CheckedBodiesRejected(_) -> "other"
  }
}

test "checked typed match arms narrow nil-sentinel unions by set difference" {
  let cases = [
    "fn f(x: str?) -> str { match x { nil -> \"none\" text: str -> text } }",
    "fn f(x: str?) -> str { match x { text: str -> text nil -> \"none\" } }",
    "fn f(x: str) -> str { match x { text: str -> text } }",
    "fn f(x: str?) -> str? { match x { all: str? -> all } }",
    "type Shape { Circle(i64) } fn f(x: Shape?) -> i64 { match x { nil -> 0 s: Shape -> 1 } }",
    "type Color { Red, Green } fn f(x: Color?) -> i64 { match x { c: Color -> 1 nil -> 0 } }",
    "type Name = opaque str fn f(x: Name?) -> i64 { match x { n: Name -> 1 nil -> 0 } }",
    "fn f(x: str?) -> i64 { match x { text: str -> 1 } }",
    "fn f(x: str?) -> i64 { match x { nil -> 0 } }",
    "fn f(x: str?) -> i64 { match x { text: str if text == \"a\" -> 1 nil -> 0 } }",
    "fn f(x: str?) -> i64 { match x { n: i64 -> n _ -> 0 } }",
    "fn f(x: i64?) -> i64 { match x { n: i64 -> n nil -> 0 } }",
    "fn f(x: i64?) -> i64 { match x { nil -> 0 _ -> 1 } }",
    "fn f(x: bool?) -> i64 { match x { nil -> 0 _ -> 1 } }",
    "fn f(x: str | i64) -> i64 { match x { s: str -> 1 _ -> 0 } }",
    "type Id = opaque i64 fn f(x: Id?) -> i64 { match x { i: Id -> 1 nil -> 0 } }",
    "fn f(x: str) -> i64 { match x { nil -> 0 _ -> 1 } }"
  ]
  let expected = [
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "non_exhaustive",
    "non_exhaustive",
    "non_exhaustive",
    "outside",
    "discrimination",
    "discrimination",
    "discrimination",
    "discrimination",
    "discrimination",
    "mismatch"
  ]
  let first: usize = 0
  for index in first..cases.len {
    Test.assert_str_eq(
      typed_arm_outcome(cases[index], 1430 + __u64_to_i64(__usize_to_u64(index))),
      expected[index]
    )
  }
}

test "checked nil comparisons need a zero compare that separates nil" {
  let cases = [
    "type E { Bad(i64) } fn f(x: E?) -> bool { x == nil }",
    "type E { Bad(i64) } fn f(x: E?) -> bool { nil == x }",
    "type E { Bad(i64) } fn f(x: E?) -> bool { x != nil }",
    "fn f(x: str?) -> bool { x == nil }",
    "fn f(x: nil) -> bool { x == nil }",
    "fn f() -> bool { nil == nil }",
    "type Name = opaque str fn f(x: Name?) -> bool { x != nil }",
    "fn f(x: i64?) -> bool { x == nil }",
    "fn f(x: bool?) -> bool { nil != x }",
    "type Id = opaque i64 fn f(x: Id?) -> bool { x == nil }",
    "fn f(x: str) -> bool { x == nil }",
    "fn f(x: str | i64 | nil) -> bool { x == nil }"
  ]
  let expected = [
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "discrimination",
    "discrimination",
    "discrimination",
    "discrimination",
    "discrimination"
  ]
  let first: usize = 0
  for index in first..cases.len {
    Test.assert_str_eq(
      typed_arm_outcome(cases[index], 1480 + __u64_to_i64(__usize_to_u64(index))),
      expected[index]
    )
  }
}

test "checked nil comparisons publish one primitive compare, not Eq" {
  match checked(
    "type E { Bad(i64) } "
      |> str_concat("fn is_none(x: E?) -> bool { x == nil } ")
      |> str_concat("fn is_some(x: E?) -> bool { nil != x } ")
      |> str_concat("fn count() -> i64 { let mut failure: E | nil = nil let mut n = 0 ")
      |> str_concat("while failure == nil { n = n + 1 if n > 3 { failure = Bad(n) } } n }"),
    "fixture/checked_nil_comparison",
    1500
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq(root_binary_operator(product, 0), 5)
      Test.assert_eq(root_binary_operator(product, 1), 6)
    }
    _ -> Test.assert_true(false)
  }
}

-- The operator of a function whose body is one binary expression, or 0.
fn root_binary_operator(product: CheckedBodyProduct, index: usize) -> i64 {
  let expressions = product.expressions()
  let root = product.function(index).body
  match expressions.kind(root) {
    CheckedBinaryKind -> binary_operator_code(expressions.binary_operator(root))
    _ -> 0
  }
}

-- "accepted", or the category of the producer's rejection.
fn producer_outcome(text: str, discriminator: i64) -[Test]> str {
  match checked(text, "fixture/checked_producer_outcome", discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
  }
}

fn producer_outcome_with_drop(text: str, discriminator: i64) -[Test]> str {
  match checked_with_drop(text, "fixture/checked_producer_outcome", discriminator) {
    CheckedBodiesAccepted(_) -> "accepted"
    CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
  }
}

test "checked constructors build their own member of an expected union" {
  let cases = [
    "type E { Bad(i64) } fn f() -> E | nil { Bad(1) }",
    "type E { Bad(i64) } fn f() -> i64 { let mut failure: E | nil = nil failure = Bad(1) 0 }",
    "type E { Bad(i64) } fn f() -> E | str | nil { Bad(2) }",
    "type Box<T> { Full(T), Empty } fn f() -> Box<i64> | nil { Full(3) }",
    "type E { Bad(i64), Worse } fn f() -> E | nil { Worse }",
    "type E { Bad(i64) } type F { Worse(i64) } fn f() -> F | nil { Bad(4) }",
    "type E { Bad(i64) } fn f() -> str | nil { Bad(5) }"
  ]
  let expected = [
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "unknown_constructor",
    "unknown_constructor"
  ]
  let first: usize = 0
  for index in first..cases.len {
    Test.assert_str_eq(
      producer_outcome(cases[index], 1520 + __u64_to_i64(__usize_to_u64(index))),
      expected[index]
    )
  }
}

test "checked fresh constructions introduce owned and unique values" {
  let cases = [
    "type T { log: i64 } impl Drop for T { } fn f(log: i64) -> owned T { T { log: log } }",
    "type R { Open(i64) } impl Drop for R { } fn f() -> owned R { Open(1) }",
    "type P { x: i64 } fn f() -> unique P { P { x: 1 } }",
    "type T { log: i64 } impl Drop for T { } fn f() -> owned T { let t: owned T = T { log: 1 } t }",
    "type T { log: i64 } impl Drop for T { } fn f(t: T) -> owned T { t }",
    "type T { log: i64 } impl Drop for T { } type U { log: i64 } fn f() -> owned T { U { log: 1 } }"
  ]
  let expected = [
    "accepted",
    "accepted",
    "accepted",
    "accepted",
    "type_mismatch",
    "type_mismatch"
  ]
  let first: usize = 0
  for index in first..cases.len {
    Test.assert_str_eq(
      producer_outcome_with_drop(cases[index], 1540 + __u64_to_i64(__usize_to_u64(index))),
      expected[index]
    )
  }
}

test "checked typed match arms publish their binding annotation and nil test" {
  Test.assert_str_eq(
    typed_arm_outcome(
      "fn f(x: str?) -> str { match x { nil -> \"none\" text: str -> text } } "
        |> str_concat("fn g(x: str) -> str { match x { all: str -> all } }"),
      1451
    ),
    "accepted"
  )
  match checked(
    "fn f(x: str?) -> str { match x { nil -> \"none\" text: str -> text } } "
      |> str_concat("fn g(x: str) -> str { match x { all: str -> all } }"),
    "fixture/checked_typed_arm_graph",
    1450
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let typed = patterns.match_arm_list_at(arms, 1).pattern
          Test.assert_str_eq(
            match patterns.kind(typed) {
              CheckedTypedBindingPatternKind -> "typed"
              CheckedNilPatternKind -> "nil"
              _ -> "other"
            },
            "typed"
          )
          Test.assert_str_eq(
            if patterns.typed_binding_tests_nil(typed) { "tested" } else { "untested" },
            "tested"
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> Test.assert_false(
          patterns.typed_binding_tests_nil(patterns.match_arm_list_at(arms, 0).pattern)
        )
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked match arms retain bindings guards and lexical scope" {
  match checked(
    "fn choose(value: bool, enabled: bool) -> i64 { match value { true if enabled -> 1 true -> 2 false -> 3 } } fn identity(value: i64) -> i64 { match value { captured -> captured } }",
    "fixture/checked_body_match_arms",
    130
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          Test.assert_eq_usize(patterns.match_arm_list_len(arms), 3)
          let guarded = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match guarded.guard {
              CheckedGuarded(guard) -> match expressions.kind(guard) {
                CheckedLocalReferenceKind -> true
                _ -> false
              }
              _ -> false
            }
          )
          Test.assert_true(
            match patterns.match_arm_list_at(arms, 1).guard {
              CheckedUnguarded -> true
              _ -> false
            }
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let arm = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(arm.pattern) {
              CheckedBindingPatternKind -> true
              _ -> false
            }
          )
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(arm.pattern),
              expressions.local_binding(arm.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked tuple patterns retain nested positional children and bindings" {
  match checked(
    "fn first(pair: (i64, bool)) -> i64 { match pair { (left, _) -> left } } "
      |> str_concat(
        "fn nested(pair: (i64, (bool, i64))) -> i64 { match pair { (_, (_, value)) -> value } } "
      )
      |> str_concat(
        "type Pair = (i64, bool) fn alias(pair: Pair) -> i64 { match pair { (left, _) -> left } }"
      ),
    "fixture/checked_body_tuple_patterns",
    1173
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let patterns = product.patterns()
      match expressions.match_parts(product.function(0).body) {
        (_, _, arms) -> {
          let first = patterns.match_arm_list_at(arms, 0)
          Test.assert_true(
            match patterns.kind(first.pattern) {
              CheckedTuplePatternKind -> true
              _ -> false
            }
          )
          let children = patterns.tuple_items(first.pattern)
          Test.assert_eq_usize(patterns.pattern_list_len(children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(children, 0)),
              expressions.local_binding(first.body)
            )
          )
        }
      }
      match expressions.match_parts(product.function(1).body) {
        (_, _, arms) -> {
          let nested = patterns.match_arm_list_at(arms, 0)
          let children = patterns.tuple_items(nested.pattern)
          let inner = patterns.pattern_list_at(children, 1)
          Test.assert_true(
            match patterns.kind(inner) {
              CheckedTuplePatternKind -> true
              _ -> false
            }
          )
          let inner_children = patterns.tuple_items(inner)
          Test.assert_eq_usize(patterns.pattern_list_len(inner_children), 2)
          Test.assert_true(
            checked_binding_id_eq(
              patterns.binding(patterns.pattern_list_at(inner_children, 1)),
              expressions.local_binding(nested.body)
            )
          )
        }
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "checked tuple patterns reject wrong shapes and child types" {
  Test.assert_true(
    match checked(
      "fn bad(value: i64) -> i64 { match value { (left, right) -> left } }",
      "fixture/checked_body_tuple_non_tuple",
      1174
    ) {
