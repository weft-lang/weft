fn checked_with_iterator_protocol(
  text: str,
  name: str,
  discriminator: i64
) -[Test]> CheckedBodyCheckResult {
  let option_module = registered(
    "pub type Option<T> { None, Some(T) }",
    named_module_identity("stdlib/option", discriminator)
  )
  let protocol_module = registered(
    "use stdlib/option.{Option, None} "
    |> str_concat("pub type Iterator<T> = opaque i64 ")
    |> str_concat("pub trait IntoIterator { type Item ")
    |> str_concat("fn into_iter(self: Self) -> owned Iterator<Self.Item> } ")
    |> str_concat("impl<T> IntoIterator for owned Iterator<T> { type Item = T ")
    |> str_concat("fn into_iter(self: owned Iterator<T>) -> owned Iterator<T> { self } } ")
    |> str_concat(
      "impl<T> Iterator<T> { pub fn next(self: borrow mut Self) -> Option<T> { None<T>() } }"
    ),
    named_module_identity("stdlib/iter/protocol", discriminator)
  )
  let consumer = registered(text, named_module_identity(name, discriminator))
  let option_edge = registration_scope.resolved_import(
    protocol_module,
    protocol_module.syntax.imports.get(0).unwrap(),
    option_module.identity,
    false
  )
  let protocol_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    protocol_module.identity,
    false
  )
  let modules = [option_module, protocol_module, consumer]
  let imports = [option_edge, protocol_edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> handle check_registered_bodies(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      SemanticConformance.conforms(_, concrete, trait_declaration) -> resume(false)
    }
    _ -> panic("expected resolved iterator protocol signatures")
  }
}

