      "stdlib/eq",
      1195
    ) {
      CheckedBodiesRejected(CheckedBodyProducerEqImplementationRequired(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match checked(
      "pub effect Tick { fn now() -> i64 } "
        |> str_concat("pub trait Eq { fn eq(self, other: Self) -[Tick]> bool } ")
        |> str_concat("type Token { value: i64 } ")
        |> str_concat("fn equal(left: Token, right: Token) -> bool { left == right }"),
      "stdlib/eq",
      1200
    ) {
      CheckedBodiesRejected(CheckedBodyProducerCanonicalEqInvalid(_)) -> true
      _ -> false
    }
  )
}

