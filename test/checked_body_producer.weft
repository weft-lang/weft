  )
  Test.assert_true(
    match checked(
      "effect Pause { @deferred fn get() -> i64 } "
    |> str_concat("fn read() -[Pause]> i64 { Pause.get() } ")
    |> str_concat("type Holder<T> { value: i64 } ")
    |> str_concat("impl<T> Holder<T> { fn erase(self, value: T) -> i64 { 0 } } ")
    |> str_concat(
      "fn bad(holder: Holder<Continuation<i64, i64>>) -> i64 { "
    )
    |> str_concat("handle read() { Pause.get() with k -> holder.erase(k) } }"),
      "fixture/checked_body_generic_method_continuation_escape",
