test "checked optional chaining retains Maybe and exact field projections" {
  match checked_with_maybe(
    r#"use stdlib/maybe.{Maybe}
type Address { city: str }
type Person { age: i64, address: Address? }
fn nominal(person: Person?) -[Maybe]> i64 { person?.age }
fn structural(person: {age: i64}?) -[Maybe]> i64 { person?.age }
fn open(person: {age: i64, ..}?) -[Maybe]> i64 { person?.age }
fn nested(person: Person?) -[Maybe]> str { person?.address?.city }
fn reversed(person: nil | Person) -[Maybe]> i64 { person?.age }"#,
    "fixture/checked_optional_chain",
    1291
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      Test.assert_eq_usize(product.function_count(), 5)
      Test.assert_true(
        match expressions.kind(product.function(0).body) {
          CheckedDeclaredOptionalProjectionKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(product.function(1).body) {
          CheckedStructuralOptionalProjectionKind -> true
          _ -> false
        }
      )
      let propagation = product.propagation()
      let nominal = propagation.optional_projection(
        expressions.declared_optional_projection_detail(product.function(0).body)
      )
      let structural = propagation.optional_projection(
        expressions.structural_optional_projection_detail(product.function(1).body)
      )
      let open = propagation.optional_projection(
        expressions.structural_optional_projection_detail(product.function(2).body)
      )
      let nested = propagation.optional_projection(
        expressions.declared_optional_projection_detail(product.function(3).body)
      )
      Test.assert_true(
        match open.projection {
          CheckedStructuralProjection(_, CheckedStructuralFieldUnplaced(name)) -> name == "age"
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(nested.base) {
          CheckedDeclaredOptionalProjectionKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(product.function(4).body) {
          CheckedDeclaredOptionalProjectionKind -> true
          _ -> false
        }
      )
      Test.assert_true(nominal.field_range.start > 0)
      Test.assert_true(structural.field_range.start > nominal.field_range.start)
    }
    _ -> Test.assert_true(false)
  }
}

