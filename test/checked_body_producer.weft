test "checked body producer publishes structural field projections" {
  match checked(
    "fn project(row: { wide: [i64], target: i64, tail: f64 }) -> i64 { row.target }",
    "fixture/checked_body_structural_field",
    136
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let root = product.function(0).body
      let catalog = expressions.types()
      let zero: usize = 0
      let one: usize = 1
      let two: usize = 2
      let expected_offset = (if "wide".hash() < "target".hash() { two } else { zero }) +
        (if "tail".hash() < "target".hash() { one } else { zero })
      Test.assert_true(
        match expressions.kind(root) {
          CheckedStructuralFieldAccessKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.structural_field_access_parts(root) {
          (base, key, offset) ->
            match expressions.kind(base) {
              CheckedLocalReferenceKind ->
                key == "target".hash() and offset == expected_offset
              _ -> false
            }
        }
      )
      Test.assert_true(
        match catalog.graph_for(expressions.result_type(root)) {
          Some(graph) -> match semantic_type_graph_node(
            graph,
            expressions.result_type(root)
          ) {
            SemanticPrimitiveNode(SemanticI64) -> true
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "checked body producer rejects unknown structural fields" {
  Test.assert_true(
    match checked(
      "fn project(row: { target: i64 }) -> i64 { row.missing }",
      "fixture/checked_body_missing_field",
      137
    ) {
      CheckedBodiesRejected(CheckedBodyProducerUnknownField(range)) ->
        range.end - range.start == 7
      _ -> false
    }
  )
}

test "checked body producer publishes generic declared field projections" {
  match checked(
    "type Box<T> { wide: [T], target: T } "
    |> str_concat(
      "fn project(row: Box<i64>) -> i64 { row.target } "
    )
    |> str_concat("fn view(row: Box<i64>) -> [i64] { row.wide }"),
    "fixture/checked_body_nominal_field",
    138
  ) {
    CheckedBodiesAccepted(product) -> {
      let expressions = product.expressions()
      let target = product.function(0).body
      let view = product.function(1).body
      Test.assert_true(
        match expressions.kind(target) {
          CheckedDeclaredFieldAccessKind -> match expressions.declared_field_access_parts(
            target
          ) {
            (base, declaration, field_index) ->
              field_index == 1 and
              declaration_identity_name(declaration).text().unwrap() == "target" and
              match expressions.kind(base) {
                CheckedLocalReferenceKind -> true
                _ -> false
              }
          }
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(view) {
          CheckedDeclaredFieldAccessKind -> match expressions.declared_field_access_parts(view) {
            (_, _, field_index) -> field_index == 0
          }
          _ -> false
        }
      )
      let catalog = expressions.types()
      let result = expressions.result_type(view)
      Test.assert_true(
        match catalog.graph_for(result) {
          Some(graph) -> match semantic_type_graph_node(graph, result) {
            SemanticSliceNode(element, _) -> match catalog.graph_for(element) {
              Some(element_graph) -> match semantic_type_graph_node(element_graph, element) {
                SemanticPrimitiveNode(SemanticI64) -> true
                _ -> false
              }
              _ -> false
            }
            _ -> false
          }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

