test "checked body producer retains specialized method results across a block" {
  match checked(
    "trait Chain { fn keep(self) -> Self fn same(self, other: Self) -> bool } "
    |> str_concat("type Box<T> { value: T } ")
    |> str_concat(
      "impl<T> Chain for Box<T> { fn keep(self) -> Self { self } "
    )
    |> str_concat("fn same(self, other: Self) -> bool { true } } ")
    |> str_concat(
      "fn compare(left: Box<i64>, right: Box<i64>) -> bool { "
    )
    |> str_concat("let kept = left.keep() kept.same(right) }"),
    "fixture/checked_body_method_result",
    177
  ) {
    CheckedBodiesAccepted(product) -> {
      Test.assert_eq_usize(product.function_count(), 3)
      let expressions = product.expressions()
      let root = product.function(2).body
      let (_, _, result) = expressions.let_parts(root)
      Test.assert_true(
        match expressions.kind(root) {
          CheckedLetKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match expressions.kind(result) {
          CheckedMethodCallKind -> true
          _ -> false
        }
      )
      let (declaration, receiver, arguments) = expressions.method_call_parts(result)
      Test.assert_str_eq(
        declaration_identity_name(declaration).text().unwrap(),
        "same"
      )
      Test.assert_true(
        match expressions.kind(receiver) {
          CheckedLocalReferenceKind -> true
          _ -> false
        }
      )
      Test.assert_eq_usize(expressions.expression_list_len(arguments), 1)
    }
    _ -> Test.assert_true(false)
  }
}

