use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}

use "compiler/pipeline.weft"

fn pipeline_test_lower_functions(src: str) -> IrFunctionList {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  pipeline_ir_functions(pipeline_lower_ir(typed))
}

test "pipeline_lower_single_arm_match_binding_to_ir_sidecar" {
  let src = "fn main() -> i64 { match 21 { x -> x + 1 } }"
  let functions = pipeline_test_lower_functions(src)
  Test.assert_eq(if ir_function_list_len(functions) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_function_list_edges_match_block_params(functions), 1)
}

test "pipeline_lower_single_ctor_match_payload_to_ir_sidecar" {
  let src = "type PipelineOne { One(i64) } fn main(x: PipelineOne) -> i64 { match x { One(v) -> v } }"
  let functions = pipeline_test_lower_functions(src)
  Test.assert_eq(if ir_function_list_len(functions) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_function_list_edges_match_block_params(functions), 1)
}

