test "pipeline_lower_match_cfg_scrutinee_wildcard_to_ir_sidecar" {
  let src = "fn main() -> i64 { match if true { 1 } else { 2 } { _ -> 3 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 6)
  Test.assert_eq(ir_function_list_block_param_count(functions), 2)
  Test.assert_eq(ir_function_list_inst_count(functions), 4)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 4)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 4)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 4)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 5)
}

test "pipeline_lower_match_cfg_scrutinee_int_dispatch_to_ir_sidecar" {
  let src = "fn main() -> i64 { match if true { 1 } else { 2 } { 1 -> 10 _ -> 20 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 8)
  Test.assert_eq(ir_function_list_block_param_count(functions), 2)
  Test.assert_eq(ir_function_list_inst_count(functions), 7)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 6)
  Test.assert_eq(ir_function_list_count_tag(functions, 2), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 2)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 5)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_count_binary_op(functions, ir_binary_op_eq()), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 4)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 9)
}

test "pipeline_lower_match_cfg_scrutinee_ctor_payload_to_ir_sidecar" {
  let src = "type PipelineCfgScrutineeOne { CfgScrutineeOne(i64) } fn main() -> i64 { match if true { CfgScrutineeOne(1) } else { CfgScrutineeOne(2) } { CfgScrutineeOne(v) -> v } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 1)
  Test.assert_eq(ir_function_list_block_count(functions), 6)
  Test.assert_eq(ir_function_list_block_param_count(functions), 2)
  Test.assert_eq(ir_function_list_inst_count(functions), 6)
  Test.assert_eq(ir_function_list_count_tag(functions, 1), 3)
  Test.assert_eq(ir_function_list_count_tag(functions, 13), 2)
  Test.assert_eq(ir_function_list_count_tag(functions, 15), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 3), 1)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 2), 4)
  Test.assert_eq(ir_function_list_count_term_tag(functions, 1), 1)
  Test.assert_eq(ir_function_list_first_branch_then_or(functions, 0), 3)
  Test.assert_eq(ir_function_list_first_branch_else_or(functions, 0), 4)
  Test.assert_eq(ir_function_list_first_jump_target_or(functions, 0 - 1), 2)
  Test.assert_eq(ir_function_list_first_term_return_value_or(functions, 0 - 1), 7)
}

test "pipeline_lower_match_cfg_scrutinee_function_value_call_stays_out_of_ir_sidecar" {
  let src = "fn main(f: (i64) -> i64) -> i64 { match if true { f(1) } else { 2 } { _ -> 3 } }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let functions = pipeline_lower_typed_sidecar(typed)
  Test.assert_eq(ir_function_list_len(functions), 0)
  Test.assert_eq(ir_function_list_inst_count(functions), 0)
}
