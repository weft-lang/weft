use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count, runtime_rc_test_heap_arena_offset}
use stdlib/string.{*}

fn check_reclaimed(expected: i64, sample: () -> i64) -[Test]> nil {
  Test.assert_eq(sample(), expected)
  for _ in 0..50 { sample() }
  let before = runtime_rc_test_heap_arena_offset()
  let mut total = 0
  for _ in 0..200 { total = total + sample() }
  Test.assert_eq(total, expected * 200)
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
  nil
}

fn select_text(first: bool) -> str {
  let left = 7.to_str()
  let right = 11.to_str()
  if first { left } else { right }
}

fn select_match(choice: i64) -> str {
  let left = 7.to_str()
  let right = 11.to_str()
  match choice {
    n if n < 0 -> left
    0 -> right
    _ -> left
  }
}

fn text_number(text: str) -> i64 {
  match text { item if item == "7" -> 7 item if item == "11" -> 11 _ -> -1000 }
}

fn select_alias(value: RuntimeRcProbe, first: bool) -> RuntimeRcProbe {
  let left = value
  let right = value
  if first { left } else { right }
}

fn alias_counts(first: bool) -> i64 {
  let original = runtime_rc_probe_new(7)
  let selected = select_alias(original, first)
  if runtime_rc_probe_load(selected) == 7 and runtime_rc_probe_load(original) == 7 {
    runtime_rc_probe_count(original)
  } else { -1000 }
}

fn select_parameter(value: str, first: bool) -> str {
  let local = 11.to_str()
  if first { value } else { local }
}

fn parameter_selection(first: bool) -> str {
  let source = 7.to_str()
  select_parameter(source, first)
}

fn select_mutable(first: bool) -> str {
  let mut left = 3.to_str()
  let mut right = 5.to_str()
  left = 7.to_str()
  right = 11.to_str()
  if first { left } else { right }
}

fn select_nested(first: bool, second: bool) -> str {
  let left = 3.to_str()
  let right = 11.to_str()
  if first {
    let left = 7.to_str()
    if second { left } else { right }
  } else {
    let left = 7.to_str()
    match second { true -> left false -> right }
  }
}

fn select_array(first: bool) -> [str; 2] {
  let left = [7.to_str(), 11.to_str()]
  let right = [11.to_str(), 11.to_str()]
  if first { left } else { right }
}

fn array_sum(first: bool) -> i64 {
  let selected = select_array(first)
  text_number(selected[0]) + text_number(selected[1])
}

fn select_tuple(first: bool) -> (str, str, i64) {
  let left = (7.to_str(), 11.to_str(), 3)
  let right = (11.to_str(), 11.to_str(), 5)
  match first { true -> left false -> right }
}

fn tuple_sum(first: bool) -> i64 {
  let (left, right, extra) = select_tuple(first)
  text_number(left) + text_number(right) + extra
}

fn select_closure(first: bool) -> () -> i64 {
  let left_value = 7.to_str()
  let right_value = 11.to_str()
  let left = () => text_number(left_value)
  let right = () => text_number(right_value)
  if first { left } else { right }
}

fn selected_argument(first: bool) -> i64 {
  let left = 7.to_str()
  let right = 11.to_str()
  text_number(if first { left } else { right })
}

fn selected_binding(first: bool) -> i64 {
  let left = 7.to_str()
  let right = 11.to_str()
  let selected = if first { left } else { right }
  text_number(selected) + text_number(left) + text_number(right)
}

fn discard_selection(first: bool) -> i64 {
  let left = 7.to_str()
  let right = 11.to_str()
  if first { left } else { right }
  match first { true -> right false -> left }
  text_number(left) + text_number(right)
}

fn select_arm_local(value: str, first: bool) -> str {
  if first {
    let copy = value
    copy
  } else {
    let mut copy = 11.to_str()
    copy = value
    copy
  }
}

fn arm_local_selection(first: bool) -> i64 {
  let value = 7.to_str()
  text_number(select_arm_local(value, first))
}

fn explicit_selection(first: bool) -> str {
  let left = 7.to_str()
  let right = 11.to_str()
  if first { return left } else { return right }
}

fn explicit_probe(first: bool) -> RuntimeRcProbe {
  let left = runtime_rc_probe_new(7)
  let right = runtime_rc_probe_new(11)
  if first { return left } else { return right }
}

fn explicit_mutable_probe(first: bool) -> RuntimeRcProbe {
  let mut left = runtime_rc_probe_new(3)
  let mut right = runtime_rc_probe_new(5)
  left = runtime_rc_probe_new(7)
  right = runtime_rc_probe_new(11)
  if first { return left } else { return right }
}

fn early_probe(first: bool) -> RuntimeRcProbe {
  let left = runtime_rc_probe_new(7)
  let right = runtime_rc_probe_new(11)
  if first { return left } else { nil }
  right
}

fn early_mutable_probe(first: bool) -> RuntimeRcProbe {
  let mut left = runtime_rc_probe_new(7)
  let mut right = runtime_rc_probe_new(11)
  if first { return left } else { nil }
  right
}

fn probe_stake(value: RuntimeRcProbe) -> i64 {
  if runtime_rc_probe_load(value) == 7 or runtime_rc_probe_load(value) == 11 {
    runtime_rc_probe_count(value)
  } else { -1000 }
}

effect BranchText { fn text(first: bool) -> str }
effect BranchProbe { fn read(value: RuntimeRcProbe) -> RuntimeRcProbe }

fn parameter_handler(first: bool) -> RuntimeRcProbe {
  let original = runtime_rc_probe_new(7)
  handle BranchProbe.read(original) {
    BranchProbe.read(value) -> if first { value } else { resume(value) }
  }
}

fn captured_handler(first: bool) -> RuntimeRcProbe {
  let original = runtime_rc_probe_new(7)
  handle BranchProbe.read(runtime_rc_probe_new(11)) {
    BranchProbe.read(unused) -> if first { original } else { resume(original) }
  }
}

fn handled_selection(first: bool) -> str {
  handle BranchText.text(first) {
    BranchText.text(choice) -> {
      let left = 7.to_str()
      let right = 11.to_str()
      resume(if choice { left } else { right })
    }
  }
}

effect StopBranch { fn stop() -> never }
fn aborted_selection(first: bool) -> i64 {
  handle {
    let left = 7.to_str()
    let right = 11.to_str()
    let selected = if first { left } else { right }
    if text_number(selected) > 0 { StopBranch.stop() } else { 0 }
  } {
    StopBranch.stop() -> 19
  }
}

test "borrowed if alternatives reclaim both local stakes" {
  check_reclaimed(7, () => text_number(select_text(true)))
  check_reclaimed(11, () => text_number(select_text(false)))
}

test "borrowed match alternatives reclaim guarded and fallback locals" {
  check_reclaimed(7, () => text_number(select_match(-1)))
  check_reclaimed(11, () => text_number(select_match(0)))
  check_reclaimed(7, () => text_number(select_match(1)))
}

test "aliasing alternatives transfer exactly one result stake" {
  check_reclaimed(2, () => alias_counts(true))
  check_reclaimed(2, () => alias_counts(false))
}

test "borrowed parameter choices survive their source scope" {
  check_reclaimed(7, () => text_number(parameter_selection(true)))
  check_reclaimed(11, () => text_number(parameter_selection(false)))
}

test "borrowed mutable choices release the replaced slot values" {
  check_reclaimed(7, () => text_number(select_mutable(true)))
  check_reclaimed(11, () => text_number(select_mutable(false)))
}

test "nested borrowed choices respect local shadowing" {
  check_reclaimed(7, () => text_number(select_nested(true, true)))
  check_reclaimed(11, () => text_number(select_nested(true, false)))
  check_reclaimed(7, () => text_number(select_nested(false, true)))
  check_reclaimed(11, () => text_number(select_nested(false, false)))
}

test "borrowed array choices preserve and reclaim managed elements" {
  check_reclaimed(18, () => array_sum(true))
  check_reclaimed(22, () => array_sum(false))
}

test "borrowed tuple choices carry every managed lane" {
  check_reclaimed(21, () => tuple_sum(true))
  check_reclaimed(27, () => tuple_sum(false))
}

test "borrowed closure choices preserve and reclaim captures" {
  check_reclaimed(7, () => { let selected = select_closure(true); selected() })
  check_reclaimed(11, () => { let selected = select_closure(false); selected() })
}

test "borrowed choices passed to borrowing calls reclaim their results" {
  check_reclaimed(7, () => selected_argument(true))
  check_reclaimed(11, () => selected_argument(false))
}

test "bound choices preserve both source locals" {
  check_reclaimed(25, () => selected_binding(true))
  check_reclaimed(29, () => selected_binding(false))
}

test "discarded borrowed choices reclaim their result stakes" {
  check_reclaimed(18, () => discard_selection(true))
  check_reclaimed(18, () => discard_selection(false))
}

test "branch local aliases transfer their binding stake" {
  check_reclaimed(7, () => arm_local_selection(true))
  check_reclaimed(7, () => arm_local_selection(false))
}

test "explicit branch returns release both surrounding local stakes" {
  check_reclaimed(7, () => text_number(explicit_selection(true)))
  check_reclaimed(11, () => text_number(explicit_selection(false)))
}

test "explicit branch returns own exactly one live result stake" {
  check_reclaimed(1, () => probe_stake(explicit_probe(true)))
  check_reclaimed(1, () => probe_stake(explicit_probe(false)))
  check_reclaimed(1, () => probe_stake(explicit_mutable_probe(true)))
  check_reclaimed(1, () => probe_stake(explicit_mutable_probe(false)))
}

test "early returns clean up locals transferred only on fallthrough" {
  check_reclaimed(1, () => probe_stake(early_probe(true)))
  check_reclaimed(1, () => probe_stake(early_probe(false)))
  check_reclaimed(1, () => probe_stake(early_mutable_probe(true)))
  check_reclaimed(1, () => probe_stake(early_mutable_probe(false)))
}

test "resumed borrowed choices survive handler local cleanup" {
  check_reclaimed(7, () => text_number(handled_selection(true)))
  check_reclaimed(11, () => text_number(handled_selection(false)))
}

test "conditional handler exits transfer parameter ownership once" {
  check_reclaimed(1, () => probe_stake(parameter_handler(true)))
  check_reclaimed(1, () => probe_stake(parameter_handler(false)))
}

test "conditional handler exits retain borrowed captures" {
  check_reclaimed(1, () => probe_stake(captured_handler(true)))
  check_reclaimed(1, () => probe_stake(captured_handler(false)))
}

test "aborting after a borrowed choice releases result and local stakes" {
  check_reclaimed(19, () => aborted_selection(true))
  check_reclaimed(19, () => aborted_selection(false))
}
