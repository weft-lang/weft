use "runtime/defer_order_test.weft"

test "defer_runs_after_body_and_preserves_result" {
  Test.assert_eq(defer_order_body_result(), 42)
  Test.assert_eq(defer_order_body_log(), 7)
}

test "defer_lifo_order" {
  Test.assert_eq(defer_order_lifo_result(), 99)
  Test.assert_eq(defer_order_lifo_log(), 321)
}

test "defer_at_scope_tail_runs_and_yields_nil" {
  Test.assert_eq(defer_order_tail_scope_log(), 5)
}

test "defer_runs_before_return" {
  Test.assert_eq(defer_order_return_result(), 88)
  Test.assert_eq(defer_order_return_log(), 4)
}

test "defer_runs_before_break_without_outer_scope_exit" {
  Test.assert_eq(defer_order_break_result(), 1)
  Test.assert_eq(defer_order_break_log(), 19)
}

test "defer_runs_before_continue_each_iteration" {
  Test.assert_eq(defer_order_continue_log(), 3)
}
