use "runtime/alloc.weft"

test "defer_runs_after_body_and_preserves_result" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, 7)
    42
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(__mem_load64(log), 7)
}

test "defer_lifo_order" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 1)
    defer __mem_store64(log, __mem_load64(log) * 10 + 2)
    __mem_store64(log, 3)
    99
  }
  Test.assert_eq(got, 99)
  Test.assert_eq(__mem_load64(log), 321)
}

test "defer_at_scope_tail_runs_and_yields_nil" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let ignored = {
    defer __mem_store64(log, 5)
  }
  Test.assert_eq(__mem_load64(log), 5)
}

fn defer_return_helper(log: i64) -> i64 {
  defer __mem_store64(log, __mem_load64(log) * 10 + 4)
  return 88
}

test "defer_runs_before_return" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = defer_return_helper(log)
  Test.assert_eq(got, 88)
  Test.assert_eq(__mem_load64(log), 4)
}

test "defer_runs_before_break_without_outer_scope_exit" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 9)
    while true {
      defer __mem_store64(log, __mem_load64(log) * 10 + 1)
      break
    }
    __mem_load64(log)
  }
  Test.assert_eq(got, 1)
  Test.assert_eq(__mem_load64(log), 19)
}

test "defer_runs_before_continue_each_iteration" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let mut i = 0
  while i < 3 {
    i = i + 1
    defer __mem_store64(log, __mem_load64(log) + 1)
    if i < 3 { continue } else { 0 }
  }
  Test.assert_eq(__mem_load64(log), 3)
}
