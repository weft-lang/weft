-- Test defer execution at scope exit with LIFO ordering
-- Expected exit code: 42
-- Defers modify the return value because x is returned by reference
-- (in bootstrap, all values are register-based, so defer modifying x
-- AFTER the return value is computed doesn't change the return)
-- This test just verifies defers don't crash and compile correctly.

fn helper() -> i64 {
  defer 0
  42
}

fn main() -> i64 {
  helper()
}
