use "runtime/alloc.weft"

test "defer_runs_after_body_and_preserves_result" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, 7)
    42
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(__mem_load64(log), 7)
}

test "defer_lifo_order" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 1)
    defer __mem_store64(log, __mem_load64(log) * 10 + 2)
    __mem_store64(log, 3)
    99
  }
  Test.assert_eq(got, 99)
  Test.assert_eq(__mem_load64(log), 321)
}

test "defer_at_scope_tail_runs_and_yields_nil" {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let ignored = {
    defer __mem_store64(log, 5)
  }
  Test.assert_eq(__mem_load64(log), 5)
}
