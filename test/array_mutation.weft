use runtime/rc_implicit_test.{*}
use runtime/rc.{*}

effect MutationStop { fn stop() -> never }

fn increment(values: [mut i64]) -> nil {
  let first: usize = 0
  for index in first..values.len { values[index] = values[index] + 1 }
}

fn array_owner<T>(value: T) -> i64 { runtime_generator_state_word_from<T>(value) }

test "repeated mutable slices preserve unique array storage" {
  let mut values = [1, 2, 3]
  let owner = array_owner<[i64; 3]>(values)
  for _ in 0..3 {
    increment(values[..])
    Test.assert_eq(array_owner<[i64; 3]>(values), owner)
  }
  Test.assert_eq(values[0], 4)
  Test.assert_eq(values[2], 6)
  Test.assert_eq(array_owner<[i64; 3]>(values), owner)
  Test.assert_eq(rc_count(owner), 1)
}

test "indexed updates preserve unique array storage" {
  let mut values = [1, 2]
  let owner = array_owner<[i64; 2]>(values)
  for _ in 0..3 {
    values[0] = values[0] + values[1]
    Test.assert_eq(array_owner<[i64; 2]>(values), owner)
  }
  Test.assert_eq(values[0], 7)
  Test.assert_eq(array_owner<[i64; 2]>(values), owner)
  Test.assert_eq(rc_count(owner), 1)
}

test "mutable slicing detaches a live immutable array alias" {
  let mut values = [1, 2]
  let snapshot = values
  let owner = array_owner<[i64; 2]>(values)
  increment(values[..])
  Test.assert_eq(snapshot[0], 1)
  Test.assert_eq(snapshot[1], 2)
  Test.assert_eq(values[0], 2)
  Test.assert_true(array_owner<[i64; 2]>(values) != owner)
  Test.assert_eq(rc_count(owner), 1)
}

test "indexed assignment detaches a live immutable array alias" {
  let mut values = [1, 2]
  let snapshot = values
  let owner = array_owner<[i64; 2]>(values)
  values[0] = 42
  Test.assert_eq(snapshot[0], 1)
  Test.assert_eq(values[0], 42)
  Test.assert_true(array_owner<[i64; 2]>(values) != owner)
}

test "weak observations prevent array storage reuse" {
  let mut values = [1, 2]
  let owner = array_owner<[i64; 2]>(values)
  let reference = owner
  rc_default_weak_retain(reference)
  Test.assert_true(not rc_array_storage_can_reuse(owner))
  increment(values[..])
  Test.assert_true(array_owner<[i64; 2]>(values) != owner)
  Test.assert_eq(rc_default_weak_load(reference), 0)
  rc_default_weak_release(reference)
  Test.assert_eq(values[1], 3)
}

test "promoted array owners detach even after strong aliases are gone" {
  let mut values = [1, 2]
  let owner = array_owner<[i64; 2]>(values)
  rc_default_promote_maybe(owner)
  Test.assert_eq(rc_is_promoted(owner), 1)
  Test.assert_true(not rc_array_storage_can_reuse(owner))
  values[0] = 42
  Test.assert_true(array_owner<[i64; 2]>(values) != owner)
  Test.assert_eq(values[0], 42)
}

fn replace_managed(probe: RuntimeRcProbe, alias: bool) -[Test]> i64 {
  let mut values = [(1, probe), (2, probe)]
  if alias {
    let original = values
    values[0] = (3, probe)
    let (first, _) = original[0]
    Test.assert_eq(first, 1)
  } else { values[0] = (3, probe) }
  values[1] = values[0]
  let (first, strong) = values[1]
  Test.assert_eq(runtime_rc_probe_load(strong), 7)
  first
}

test "managed field copies and self overlap retain exact child stakes" {
  let probe = runtime_rc_probe_new(7)
  for alias in [false, true] {
    Test.assert_eq(replace_managed(probe, alias), 3)
    Test.assert_eq(runtime_rc_probe_count(probe), 1)
  }
}

fn abort_mutation(probe: RuntimeRcProbe, after: bool) -> i64 {
  handle {
    let mut values = [probe, probe]
    if after { values[0] = values[1] } else { nil }
    MutationStop.stop()
    0
  } { MutationStop.stop() -> 42 }
}

test "array owner cleanup remains exact before mutation and handler abandonment" {
  let probe = runtime_rc_probe_new(7)
  Test.assert_eq(abort_mutation(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "array mutation cleanup remains exact after mutation and handler abandonment" {
  let probe = runtime_rc_probe_new(7)
  Test.assert_eq(abort_mutation(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "outer owner survives abort after mutable slice writes" {
  let mut values = [1, 2]
  let owner = array_owner<[i64; 2]>(values)
  let result = handle {
    increment(values[..])
    MutationStop.stop()
    0
  } { MutationStop.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(values[1], 3)
  Test.assert_eq(array_owner<[i64; 2]>(values), owner)
  Test.assert_eq(rc_count(owner), 1)
}

test "packed and nested array updates preserve values" {
  let mut packed: [u8; 3] = [250, 17, 9]
  let owner = array_owner<[u8; 3]>(packed)
  packed[0] = packed[2]
  Test.assert_true(packed[0] == 9 and packed[1] == 17)
  Test.assert_eq(array_owner<[u8; 3]>(packed), owner)
  let mut nested = [[1, 2], [3, 4]]
  let snapshot = nested
  nested[0] = nested[1]
  Test.assert_eq(nested[0][1], 4)
  Test.assert_eq(snapshot[0][1], 2)
}

test "empty mutable array views preserve their owner" {
  let mut values: [i64; 0] = []
  let owner = array_owner<[i64; 0]>(values)
  increment(values[..])
  increment(values[0..0])
  Test.assert_eq(array_owner<[i64; 0]>(values), owner)
}

fn detach_mixed_fields(probe: RuntimeRcProbe, reference: weak RuntimeRcProbe) -> i64 {
  let reader = () => runtime_rc_probe_load(probe)
  let mut values = [(reference, reader, probe), (reference, reader, probe)]
  let snapshot = values
  values[0] = values[1]
  let (_, old_read, old_probe) = snapshot[0]
  let (_, new_read, new_probe) = values[0]
  old_read() + new_read() + runtime_rc_probe_load(old_probe) + runtime_rc_probe_load(new_probe)
}

test "detached descriptor copies retain strong closure and weak fields" {
  let probe = runtime_rc_probe_new(7)
  let reference = weak_ref(probe)
  Test.assert_eq(detach_mixed_fields(probe, reference), 28)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 1)
}

fn detach_nested_fields(probe: RuntimeRcProbe) -> i64 {
  let mut values = [[probe], [probe]]
  let snapshot = values
  values[0] = values[1]
  runtime_rc_probe_load(snapshot[0][0]) + runtime_rc_probe_load(values[0][0])
}

test "detached nested arrays retain each managed leaf" {
  let probe = runtime_rc_probe_new(7)
  Test.assert_eq(detach_nested_fields(probe), 14)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}
