use "runtime/memory.weft"
use runtime/alloc.{*}

test "runtime_arena_alloc_write_and_free" {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 42)
  Test.assert_eq(if arena != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64(p), 42)
  Test.assert_eq(arena_capacity(arena), 64)
  Test.assert_eq(arena_mapped_len(arena), 4096)
  Test.assert_eq(arena_remaining(arena), 56)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_alignment_matrix" {
  let arena = arena_new(64)
  let p1 = arena_alloc(arena, 1, 1)
  let p2 = arena_alloc(arena, 8, 8)
  let p3 = arena_alloc(arena, 4, 4)
  Test.assert_eq(if p1 != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(p2 % 8, 0)
  Test.assert_eq(p3 % 4, 0)
  Test.assert_eq(arena_offset(arena), 20)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_zeroed_and_reset" {
  let arena = arena_new(32)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 99)
  arena_reset(arena)
  let z = arena_alloc_zeroed(arena, 8, 8)
  Test.assert_eq(z, p)
  Test.assert_eq(mem_load64(z), 0)
  Test.assert_eq(arena_offset(arena), 8)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_mark_restore" {
  let arena = arena_new(64)
  let first = arena_alloc(arena, 8, 8)
  let mark = arena_mark(arena)
  let second = arena_alloc(arena, 16, 8)
  Test.assert_eq(if first != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if second != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(arena_offset(arena), 24)
  Test.assert_eq(arena_restore(arena, mark), arena)
  Test.assert_eq(arena_offset(arena), 8)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_words" {
  let arena = arena_new(48)
  let p = arena_alloc_words(arena, 3)
  let q = arena_alloc(arena, 1, 1)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(q - p, 24)
  Test.assert_eq(arena_offset(arena), 25)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_overflow_and_invalid" {
  let arena = arena_new(32)
  let p = arena_alloc(arena, 24, 8)
  let q = arena_alloc(arena, 16, 8)
  let r = arena_alloc(arena, 0 - 1, 8)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(q, 0)
  Test.assert_eq(r, 0)
  Test.assert_eq(arena_remaining(arena), 8)
  Test.assert_eq(arena_alloc(0, 8, 8), 0)
  Test.assert_eq(arena_mark(0), 0 - 1)
  Test.assert_eq(arena_restore(arena, 40), 0 - 1)
  Test.assert_eq(arena_free(0), 0 - 1)
  Test.assert_eq(arena_free(arena), 0)
}
