use runtime/memory.{*}
use runtime/alloc.{*}

test "runtime_arena_alloc_write_and_free" {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 42)
  Test.assert_eq(if arena != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64(p), 42)
  Test.assert_eq(arena_capacity(arena), 64)
  Test.assert_eq(arena_mapped_len(arena), 4096)
  Test.assert_eq(arena_remaining(arena), 56)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_alignment_matrix" {
  let arena = arena_new(64)
  let p1 = arena_alloc(arena, 1, 1)
  let p2 = arena_alloc(arena, 8, 8)
  let p3 = arena_alloc(arena, 4, 4)
  Test.assert_eq(if p1 != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(p2 % 8, 0)
  Test.assert_eq(p3 % 4, 0)
  Test.assert_eq(arena_offset(arena), 20)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_zeroed_and_reset" {
  let arena = arena_new(32)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 99)
  arena_reset(arena)
  let z = arena_alloc_zeroed(arena, 8, 8)
  Test.assert_eq(z, p)
  Test.assert_eq(mem_load64(z), 0)
  Test.assert_eq(arena_offset(arena), 8)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_mark_restore" {
  let arena = arena_new(64)
  let first = arena_alloc(arena, 8, 8)
  let mark = arena_mark(arena)
  let second = arena_alloc(arena, 16, 8)
  Test.assert_eq(if first != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if second != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(arena_offset(arena), 24)
  Test.assert_eq(arena_restore(arena, mark), arena)
  Test.assert_eq(arena_offset(arena), 8)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_words" {
  let arena = arena_new(48)
  let p = arena_alloc_words(arena, 3)
  let q = arena_alloc(arena, 1, 1)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(q - p, 24)
  Test.assert_eq(arena_offset(arena), 25)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alloc_overflow_and_invalid" {
  let arena = arena_new(32)
  let p = arena_alloc(arena, 24, 8)
  let q = arena_alloc(arena, 16, 8)
  let r = arena_alloc(arena, 0 - 1, 8)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(q, 0)
  Test.assert_eq(r, 0)
  Test.assert_eq(arena_remaining(arena), 8)
  Test.assert_eq(arena_alloc(0, 8, 8), 0)
  Test.assert_eq(arena_mark(0), 0 - 1)
  Test.assert_eq(arena_restore(arena, 40), 0 - 1)
  Test.assert_eq(arena_free(0), 0 - 1)
  Test.assert_eq(arena_free(arena), 0)
}


test "runtime_arena_size_overflow_preserves_cursor_and_live_bytes" {
  let arena = arena_new(64)
  let first = arena_alloc(arena, 16, 8)
  mem_store64(first, 42)
  let sizes = [9223372036854775807, 9223372036854775800, 9223372036854775792, -1, -9223372036854775808]
  for size in sizes {
    Test.assert_eq(arena_alloc(arena, size, 8), 0)
    Test.assert_eq(arena_offset(arena), 16)
    Test.assert_eq(mem_load64(first), 42)
  }
  Test.assert_eq(arena_alloc(arena, 8, 9223372036854775807), 0)
  Test.assert_eq(arena_offset(arena), 16)
  Test.assert_eq(arena_alloc(arena, 48, 1), first + 16)
  Test.assert_eq(arena_alloc(arena, 0, 1), first + 64)
  Test.assert_eq(arena_alloc(arena, 1, 1), 0)
  Test.assert_eq(arena_offset(arena), 64)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_alignment_uses_absolute_addresses" {
  let alignments = [1, 2, 3, 4, 7, 8, 16, 32, 64, 128, 4096, 65536]
  let arena = arena_new(131072)
  for alignment in alignments {
    let pointer = arena_alloc(arena, 8, alignment)
    Test.assert_true(pointer != 0)
    Test.assert_eq(pointer % alignment, 0)
    mem_store64(pointer, alignment)
    Test.assert_eq(mem_load64(pointer), alignment)
  }
  Test.assert_true(arena_offset(arena) <= arena_capacity(arena))
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_constructor_rejects_descriptor_and_page_rounding_overflow" {
  Test.assert_eq(arena_new(9223372036854775807), 0)
  Test.assert_eq(arena_new(9223372036854775743), 0)
  Test.assert_eq(arena_new(arena_capacity_limit() + 1), 0)
  let default_arena = arena_new(0)
  Test.assert_eq(arena_capacity(default_arena), 4096)
  Test.assert_eq(arena_free(default_arena), 0)
}

test "runtime_arena_word_counts_cannot_wrap_into_small_allocations" {
  let arena = arena_new(64)
  let counts = [-1, -9223372036854775808, 1152921504606846976, 2305843009213693952, 9223372036854775807]
  for count in counts {
    Test.assert_eq(arena_alloc_words(arena, count), 0)
    Test.assert_eq(arena_offset(arena), 0)
  }
  Test.assert_true(arena_alloc_words(arena, 8) != 0)
  Test.assert_eq(arena_offset(arena), 64)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_arena_growth_capacity_saturates_without_wrapping" {
  let limit = arena_capacity_limit()
  Test.assert_eq(arena_growth_capacity(64, 128, 8), 256)
  Test.assert_eq(arena_growth_capacity(128, 16, 8), 256)
  Test.assert_eq(arena_growth_capacity(64, 16, 4096), 4111)
  Test.assert_eq(arena_growth_capacity(limit - 1, 16, 8), limit)
  Test.assert_eq(arena_growth_capacity(64, limit - 7, 8), limit)
  Test.assert_eq(arena_growth_capacity(64, limit - 6, 8), 0)
  Test.assert_eq(arena_growth_capacity(64, 9223372036854775807, 8), 0)
  Test.assert_eq(arena_growth_capacity(64, 16, 9223372036854775807), 0)
  Test.assert_eq(arena_growth_capacity(64, -1, 8), 0)
}


test "runtime_allocation_size_arithmetic_covers_exact_boundaries" {
  Test.assert_eq(alloc_word_bytes(0), 0)
  Test.assert_eq(alloc_word_bytes(1), 8)
  Test.assert_eq(alloc_word_bytes(1152921504606846975), 9223372036854775800)
  Test.assert_eq(alloc_word_bytes(1152921504606846976), -1)
  Test.assert_eq(alloc_word_bytes(-1), -1)
  Test.assert_eq(alloc_checked_round_up(5, 0), 5)
  Test.assert_eq(alloc_checked_round_up(5, 1), 5)
  Test.assert_eq(alloc_checked_round_up(-1, 8), -1)
  Test.assert_eq(alloc_checked_round_up(9223372036854775807, 1), 9223372036854775807)
  Test.assert_eq(alloc_checked_round_up(9223372036854775800, 8), 9223372036854775800)
  Test.assert_eq(alloc_checked_round_up(9223372036854775800, 16), -1)
  Test.assert_eq(alloc_checked_round_up(1, 9223372036854775807), 9223372036854775807)
}
