use stdlib/iter as iter
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}
use stdlib/list.{*}
use stdlib/map.{Map}
use stdlib/num.{*}
use stdlib/panic.{panic}
use stdlib/result.{*}
use stdlib/set.{Set}
use stdlib/state as state
use stdlib/state.{State}
use stdlib/vector as vector
use stdlib/vector.{PersistentVector, Vector, vector_fold, vector_get, vector_len}
use runtime/memory.{*}
use runtime/rc_implicit_test.{*}

fn iter_option_has_value<T>(opt: Option<T>) -> i64 {
  match opt {
    Some(value) -> 1
    None -> 0
  }
}

fn iter_option_value_or_i64(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn iter_option_value_or<T>(opt: Option<T>, default: T) -> T {
  match opt {
    Some(value) -> value
    None -> default
  }
}

type IterBox {
  IterBox(i64)
}

fn iter_sum_i64(acc: i64, value: i64) -> i64 { acc + value }
fn iter_count_i64(acc: i64, value: i64) -> i64 { acc + 1 }
fn iter_double_i64(value: i64) -> i64 { value * 2 }
fn iter_inc_i64(value: i64) -> i64 { value + 1 }
fn iter_entry_total(entry: (i64, i64)) -> i64 { entry.0 + entry.1 }
fn iter_box_i64(value: i64) -> IterBox { IterBox(value + 3) }
fn iter_keep_even_i64(value: i64) -> bool { value % 2 == 0 }
fn iter_less_than_two_i64(value: i64) -> bool { value < 2 }
fn iter_less_than_four_i64(value: i64) -> bool { value < 4 }

fn iter_each_append_i64(value: i64) -[State<i64>]> nil {
  state.modify<i64>(current => current * 10 + value)
  nil
}

fn iter_each_range_body() -[State<i64>]> nil {
  iter.each(iter.range(1, 4), iter_each_append_i64)
}

fn iter_each_empty_body() -[State<i64>]> nil {
  iter.each(iter.empty<i64>(), iter_each_append_i64)
}

fn iter_skip_initial_i64(value: i64) -> bool {
  match value {
    1 -> true
    2 -> false
    _ -> panic("skip_while retested after its first rejection")
  }
}

fn iter_find_box_at_three(value: i64) -> Option<IterBox> {
  if value == 3 { Some<IterBox>(IterBox(value + 10)) }
  else { None<IterBox>() }
}

fn iter_filter_map_even_box(value: i64) -> Option<IterBox> {
  if value % 2 == 0 { Some<IterBox>(IterBox(value + 20)) }
  else { None<IterBox>() }
}

fn iter_find_box_at_two(value: i64) -> Option<IterBox> {
  if value == 2 { Some<IterBox>(IterBox(value + 10)) }
  else { None<IterBox>() }
}

fn iter_traps_after_two() -[GeneratorYield]> i64 {
  generator.yield<i64>(1)
  generator.yield<i64>(2)
  panic("iterator consumer read past its result")
}

fn iter_trapping_source() -> owned Iterator<i64> {
  iter.from_generator<i64, i64>(generator.start<i64, i64>(iter_traps_after_two))
}

fn iter_usize_to_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0)
}

fn iter_box_value_or(opt: Option<IterBox>, default: i64) -> i64 {
  match opt {
    Some(boxed) -> {
      match boxed {
        IterBox(value) -> value
      }
    }
    None -> default
  }
}

fn iter_lazy_map_can_change_type_case() -> i64 {
  let mut it = iter.map(iter.range(0, 2), iter_box_i64)
  let a = it.next()
  let b = it.next()
  let done = it.next()
  iter_box_value_or(a, 0) * 100 +
    iter_box_value_or(b, 0) * 10 +
    iter_option_has_value<IterBox>(done)
}

fn iter_range_close_once() -> nil {
  let values = iter.range(0, 3)
  values.close()
}

fn iter_empty_close_once() -> nil {
  iter.empty<i64>().close()
}

fn iter_two_source_adapters_close_once() -> nil {
  iter.chain(iter.range(0, 3), iter.range(3, 6)).close()
  iter.zip(iter.range(0, 3), iter.range(3, 6)).close()
}

fn iter_range_matrix_case(row: i64) -> i64 {
  match row {
    0 -> iter_usize_to_i64(iter.count(iter.range(4, 4))) * 100 + iter.fold(iter.range(4, 4), 0, iter_sum_i64)
    1 -> {
      let mut it = iter.range(7, 8)
      iter_option_value_or_i64(it.next(), 0)
    }
    _ -> iter.fold(iter.range(1, 5), 0, iter_sum_i64)
  }
}

fn iter_range_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 0
    1 -> 7
    _ -> 10
  }
}

fn iter_range_count_property(n: i64) -> bool {
  iter.count(iter.range(0, n)) == n.to_usize_checked().unwrap_or(0)
}

fn iter_lazy_map_count_property(n: i64) -> bool {
  iter.count(iter.map(iter.range(0, n), iter_double_i64)) == n.to_usize_checked().unwrap_or(0)
}

fn iter_lazy_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let mut it = iter.map(iter.range(1, 4), iter_double_i64)
      iter_option_value_or_i64(it.next(), 0) * 100 +
        iter_option_value_or_i64(it.next(), 0) * 10 +
        iter_option_value_or_i64(it.next(), 0)
    }
    1 -> {
      let mut it = iter.filter(iter.range(0, 6), iter_keep_even_i64)
      iter_option_value_or_i64(it.next(), 9) * 100 +
        iter_option_value_or_i64(it.next(), 9) * 10 +
        iter_option_value_or_i64(it.next(), 9)
    }
    _ -> {
      let mut it = iter.take(iter.range(5, 9), 2)
      iter_option_value_or_i64(it.next(), 0) * 10 +
        iter_option_value_or_i64(it.next(), 0)
    }
  }
}

fn iter_lazy_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 246
    1 -> 24
    _ -> 56
  }
}

fn iter_rc_owned_yield_once() -[GeneratorYield]> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(44)
  generator.yield<RuntimeRcProbe>(p)
  0
}

fn iter_pair_yield_once() -[GeneratorYield]> i64 {
  generator.yield<(i64, i64)>((10, 32))
  0
}

fn iter_str_completion() -[GeneratorYield]> str {
  generator.yield<i64>(20)
  generator.yield<i64>(22)
  "complete"
}

fn iter_pair_result() -[GeneratorYield]> (i64, i64) {
  if false { generator.yield<i64>(0) } else { 0 }
  (20, 22)
}

test "iter_range_empty_single_many_matrix" {
  for row in 0..3 {
    Test.assert_eq(iter_range_matrix_case(row), iter_range_matrix_expected(row))
  }
}

test "iter_next_preserves_order_and_repeats_done" {
  let mut it = iter.range(2, 5)
  let a = it.next()
  let b = it.next()
  let c = it.next()
  let done = it.next()
  let again = it.next()
  Test.assert_eq(iter_option_value_or_i64(a, 0), 2)
  Test.assert_eq(iter_option_value_or_i64(b, 0), 3)
  Test.assert_eq(iter_option_value_or_i64(c, 0), 4)
  Test.assert_eq(iter_option_has_value<i64>(done), 0)
  Test.assert_eq(iter_option_has_value<i64>(again), 0)
}

test "iter_range_state_is_reclaimed_after_close" {
  let mut warm = 0
  while warm < 20 {
    iter_range_close_once()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 200 {
    iter_range_close_once()
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "iter_new_source_and_adapter_states_are_reclaimed_after_close" {
  let mut warm = 0
  while warm < 20 {
    iter_empty_close_once()
    iter_two_source_adapters_close_once()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 100 {
    iter_empty_close_once()
    iter_two_source_adapters_close_once()
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "iter_fold_count_and_collect_vector" {
  let sum = iter.fold(iter.range(1, 6), 0, iter_sum_i64)
  let count = iter.count(iter.range(10, 14))
  let collected = iter.range(3, 7).collect<Vector<i64>>()
  Test.assert_eq(sum, 15)
  Test.assert_eq(iter_usize_to_i64(count), 4)
  Test.assert_eq(vector_len<i64>(collected), 4)
  Test.assert_eq(vector_get<i64>(collected, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(collected, 3, 0), 6)
}

test "iter operations normalize every collection source once" {
  let list = Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil<i64>())))
  Test.assert_eq(iter.fold(iter.map(list, iter_double_i64), 0, iter_sum_i64), 12)

  let mut mutable = vector.new<i64>()
  mutable.push(4)
  mutable.push(5)
  Test.assert_eq(iter.fold(mutable, 0, iter_sum_i64), 9)

  let persistent = iter.range(6, 9).collect<PersistentVector<i64>>()
  Test.assert_eq(iter_option_value_or_i64(iter.last(persistent), 0), 8)

  let entries = Cons<(i64, i64)>((1, 10), Cons<(i64, i64)>((2, 20), Nil<(i64, i64)>()))
  let values = entries.into_iter().collect<Map<i64, i64>>()
  Test.assert_eq(iter.fold(iter.map(values, iter_entry_total), 0, iter_sum_i64), 33)
}

test "iter_positional_consumers_cover_empty_single_and_many" {
  Test.assert_eq(iter_option_has_value<i64>(iter.first(iter.range(0, 0))), 0)
  Test.assert_eq(iter_option_value_or_i64(iter.first(iter.range(7, 8)), 0), 7)
  Test.assert_eq(iter_option_value_or_i64(iter.first(iter.range(7, 11)), 0), 7)

  Test.assert_eq(iter_option_has_value<i64>(iter.last(iter.range(0, 0))), 0)
  Test.assert_eq(iter_option_value_or_i64(iter.last(iter.range(7, 8)), 0), 7)
  Test.assert_eq(iter_option_value_or_i64(iter.last(iter.range(7, 11)), 0), 10)

  Test.assert_eq(iter_option_value_or_i64(iter.nth(iter.range(7, 11), 0), 0), 7)
  Test.assert_eq(iter_option_value_or_i64(iter.nth(iter.range(7, 11), 2), 0), 9)
  Test.assert_eq(iter_option_has_value<i64>(iter.nth(iter.range(7, 11), 4)), 0)
}

test "iter_search_consumers_cover_hits_misses_and_type_changes" {
  Test.assert_eq(iter_option_has_value<i64>(iter.find(iter.range(0, 0), iter_keep_even_i64)), 0)
  Test.assert_eq(iter_option_value_or_i64(iter.find(iter.range(1, 7), iter_keep_even_i64), 0), 2)
  Test.assert_eq(iter_option_has_value<i64>(iter.find(iter.range(1, 2), iter_keep_even_i64)), 0)

  let found = iter.find_map(iter.range(1, 6), iter_find_box_at_three)
  let missing = iter.find_map(iter.range(4, 7), iter_find_box_at_three)
  Test.assert_eq(iter_box_value_or(found, 0), 13)
  Test.assert_eq(iter_option_has_value<IterBox>(missing), 0)
}

test "iter_predicate_consumers_obey_empty_and_short_circuit_laws" {
  Test.assert_false(iter.any(iter.range(0, 0), iter_keep_even_i64))
  Test.assert_true(iter.any(iter.range(1, 5), iter_keep_even_i64))
  Test.assert_false(iter.any(iter.range(1, 2), iter_keep_even_i64))

  Test.assert_true(iter.all(iter.range(0, 0), iter_keep_even_i64))
  Test.assert_true(iter.all(iter.filter(iter.range(0, 7), iter_keep_even_i64), iter_keep_even_i64))
  Test.assert_false(iter.all(iter.range(0, 4), iter_keep_even_i64))
}

test "iter_reduce_is_empty_aware_and_left_associative" {
  Test.assert_eq(iter_option_has_value<i64>(iter.reduce(iter.range(0, 0), iter_sum_i64)), 0)
  Test.assert_eq(iter_option_value_or_i64(iter.reduce(iter.range(7, 8), iter_sum_i64), 0), 7)
  Test.assert_eq(iter_option_value_or_i64(iter.reduce(iter.range(1, 5), iter_sum_i64), 0), 10)
}

test "iter_short_circuit_consumers_do_not_pull_later_values" {
  Test.assert_eq(iter_option_value_or_i64(iter.first(iter_trapping_source()), 0), 1)
  Test.assert_eq(iter_option_value_or_i64(iter.nth(iter_trapping_source(), 1), 0), 2)
  Test.assert_eq(iter_option_value_or_i64(iter.find(iter_trapping_source(), iter_keep_even_i64), 0), 2)
  Test.assert_eq(iter_box_value_or(iter.find_map(iter_trapping_source(), iter_find_box_at_two), 0), 12)
  Test.assert_true(iter.any(iter_trapping_source(), iter_keep_even_i64))
  Test.assert_false(iter.all(iter_trapping_source(), iter_less_than_two_i64))
}

test "iter_empty_once_and_chain_preserve_cardinality_and_order" {
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.empty<i64>())), 0)
  Test.assert_eq(iter_option_value_or_i64(iter.first(iter.once<i64>(42)), 0), 42)

  match iter.first(iter.once<IterBox>(IterBox(17))) {
    Some(IterBox(value)) -> Test.assert_eq(value, 17)
    None -> Test.assert_eq(0, 1)
  }

  let empty = iter.chain(iter.empty<i64>(), iter.empty<i64>())
  let left = iter.chain(iter.range(1, 3), iter.empty<i64>())
  let right = iter.chain(iter.empty<i64>(), iter.range(3, 5))
  let both = iter.chain(iter.range(1, 3), iter.range(3, 5))
  Test.assert_eq(iter_usize_to_i64(iter.count(empty)), 0)
  Test.assert_eq(iter.fold(left, 0, iter_sum_i64), 3)
  Test.assert_eq(iter.fold(right, 0, iter_sum_i64), 7)
  Test.assert_eq(iter.fold(both, 0, (acc: i64, value: i64) => acc * 10 + value), 1234)
}

test "iter_skip_handles_zero_partial_and_excess_counts" {
  Test.assert_eq(iter.fold(iter.skip(iter.range(1, 5), 0), 0, (acc: i64, value: i64) => acc * 10 + value), 1234)
  Test.assert_eq(iter.fold(iter.skip(iter.range(1, 5), 2), 0, (acc: i64, value: i64) => acc * 10 + value), 34)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.skip(iter.range(1, 5), 4))), 0)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.skip(iter.range(1, 5), 8))), 0)
}

test "iter_filter_map_combines_selection_and_type_change_lazily" {
  let empty = iter.filter_map(iter.empty<i64>(), iter_filter_map_even_box)
  Test.assert_eq(iter_usize_to_i64(iter.count(empty)), 0)

  let none = iter.filter_map(iter.range(1, 2), iter_filter_map_even_box)
  Test.assert_eq(iter_usize_to_i64(iter.count(none)), 0)

  let mut selected = iter.filter_map(iter.range(1, 6), iter_filter_map_even_box)
  Test.assert_eq(iter_box_value_or(selected.next(), 0), 22)
  Test.assert_eq(iter_box_value_or(selected.next(), 0), 24)
  Test.assert_eq(iter_option_has_value<IterBox>(selected.next()), 0)

  let first_only = iter.take(
    iter.filter_map(iter_trapping_source(), value => Some<i64>(value * 10)),
    1
  )
  Test.assert_eq(iter.fold(first_only, 0, iter_sum_i64), 10)
}

test "iter_each_preserves_order_and_propagates_callback_effects" {
  let (_, total) = state.run(0, iter_each_range_body)
  let (_, empty_total) = state.run(0, iter_each_empty_body)
  Test.assert_eq(total, 123)
  Test.assert_eq(empty_total, 0)
}

test "iter_take_while_stops_at_the_first_rejection" {
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.take_while(iter.empty<i64>(), iter_less_than_four_i64))), 0)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.take_while(iter.range(4, 7), iter_less_than_four_i64))), 0)
  Test.assert_eq(iter.fold(iter.take_while(iter.range(1, 7), iter_less_than_four_i64), 0, iter_sum_i64), 6)
  Test.assert_eq(iter.fold(iter.take_while(iter.range(1, 4), iter_less_than_four_i64), 0, iter_sum_i64), 6)
  Test.assert_eq(iter.fold(iter.take_while(iter_trapping_source(), iter_less_than_two_i64), 0, iter_sum_i64), 1)
}

test "iter_skip_while_tests_only_the_leading_run" {
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.skip_while(iter.empty<i64>(), iter_less_than_four_i64))), 0)
  Test.assert_eq(iter.fold(iter.skip_while(iter.range(4, 7), iter_less_than_four_i64), 0, iter_sum_i64), 15)
  Test.assert_eq(iter.fold(iter.skip_while(iter.range(1, 6), iter_less_than_four_i64), 0, iter_sum_i64), 9)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.skip_while(iter.range(1, 4), iter_less_than_four_i64))), 0)
  Test.assert_eq(iter.fold(iter.skip_while(iter.range(1, 5), iter_skip_initial_i64), 0, iter_sum_i64), 9)
}

test "iter_enumerate_pairs_zero_based_positions_with_values" {
  let mut indexed = iter.enumerate(iter.range(7, 10))
  match indexed.next() {
    Some((index, value)) -> Test.assert_eq(iter_usize_to_i64(index) * 100 + value, 7)
    None -> Test.assert_eq(0, 1)
  }
  match indexed.next() {
    Some((index, value)) -> Test.assert_eq(iter_usize_to_i64(index) * 100 + value, 108)
    None -> Test.assert_eq(0, 1)
  }
  match indexed.next() {
    Some((index, value)) -> Test.assert_eq(iter_usize_to_i64(index) * 100 + value, 209)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(iter_option_has_value<(usize, i64)>(indexed.next()), 0)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.enumerate(iter.empty<i64>()))), 0)
}

test "iter_zip_stops_at_the_shorter_source_and_keeps_types" {
  let left_empty = iter.zip(iter.empty<i64>(), iter.range(1, 4))
  let right_empty = iter.zip(iter.range(1, 4), iter.empty<i64>())
  Test.assert_eq(iter_usize_to_i64(iter.count(left_empty)), 0)
  Test.assert_eq(iter_usize_to_i64(iter.count(right_empty)), 0)

  let mut pairs = iter.zip(iter.range(1, 5), iter.map(iter.range(7, 9), iter_box_i64))
  match pairs.next() {
    Some((left, IterBox(right))) -> Test.assert_eq(left * 100 + right, 110)
    None -> Test.assert_eq(0, 1)
  }
  match pairs.next() {
    Some((left, IterBox(right))) -> Test.assert_eq(left * 100 + right, 211)
    None -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(iter_option_has_value<(i64, IterBox)>(pairs.next()), 0)
}

test "iterator_combinators_specialize_result_types" {
  let mut mapped = iter.map(iter.range(1, 5), iter_box_i64)
  Test.assert_eq(iter_box_value_or(mapped.next(), 0), 4)
  mapped.close()

  let filtered = iter.take(iter.filter(iter.range(0, 7), iter_keep_even_i64), 3)
  Test.assert_eq(iter.fold(filtered, 0, iter_sum_i64), 6)
  Test.assert_eq(iter_usize_to_i64(iter.count(iter.range(4, 9))), 5)
}

test "generic_generator_preserves_structural_yield_and_result_lanes" {
  let mut yielded = generator.start<(i64, i64), i64>(iter_pair_yield_once)
  match yielded.next() {
    Some((left, right)) -> Test.assert_eq(left + right, 42)
    None -> Test.assert_eq(0, 1)
  }
  let completed = generator.start<i64, (i64, i64)>(iter_pair_result)
  let (left, right) = completed.result().unwrap()
  Test.assert_eq(left + right, 42)
}

test "iterator_collect_composes_with_lazy_adapters" {
  let mapped = iter.map(iter.range(1, 5), iter_double_i64).collect<Vector<i64>>()
  let filtered = iter.filter(iter.range(0, 7), iter_keep_even_i64).collect<Vector<i64>>()
  let taken = iter.take(iter.range(5, 10), 2).collect<Vector<i64>>()
  let none = iter.take(iter.range(5, 10), 0).collect<Vector<i64>>()
  Test.assert_eq(vector_len<i64>(mapped), 4)
  Test.assert_eq(vector_get<i64>(mapped, 0, 0), 2)
  Test.assert_eq(vector_get<i64>(mapped, 3, 0), 8)
  Test.assert_eq(vector_len<i64>(filtered), 4)
  Test.assert_eq(vector_fold<i64, i64>(filtered, 0, iter_sum_i64), 12)
  Test.assert_eq(vector_len<i64>(taken), 2)
  Test.assert_eq(vector_get<i64>(taken, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(taken, 1, 0), 6)
  Test.assert_eq(vector_len<i64>(none), 0)
}

test "iterator collection reserves only proven remaining values" {
  let range_values = iter.range(2, 10).collect<Vector<i64>>()
  let mapped = iter.map(iter.range(2, 10), iter_double_i64).collect<Vector<i64>>()
  let taken = iter.take(iter.range(2, 10), 3).collect<Vector<i64>>()
  let skipped = iter.skip(iter.range(2, 10), 3).collect<Vector<i64>>()
  let chained = iter.chain(iter.range(0, 3), iter.range(8, 10)).collect<Vector<i64>>()
  let zipped = iter.zip(iter.range(0, 3), iter.range(8, 10)).collect<Vector<(i64, i64)>>()
  let selected = iter.filter(iter.range(0, 100), iter_less_than_two_i64).collect<Vector<i64>>()

  Test.assert_eq(range_values.capacity(), 8)
  Test.assert_eq(mapped.capacity(), 8)
  Test.assert_eq(taken.capacity(), 3)
  Test.assert_eq(skipped.capacity(), 5)
  Test.assert_eq(chained.capacity(), 5)
  Test.assert_eq(zipped.capacity(), 2)
  Test.assert_eq(selected.capacity(), 2)

  let mut partially_consumed = iter.map(iter.range(0, 5), iter_double_i64)
  Test.assert_eq(partially_consumed.next().unwrap_or(99), 0)
  let remaining = partially_consumed.collect<Vector<i64>>()
  Test.assert_eq(remaining.capacity(), 4)
  Test.assert_eq(remaining.len(), 4)
}

test "iterator_collect_targets_core_collection_types" {
  let vector = iter.range(3, 6).collect<Vector<i64>>()
  let list = iter.range(3, 6).collect<List<i64>>()
  let set_source = Cons<i64>(2, Cons<i64>(4, Cons<i64>(2, Nil<i64>())))
  let set = set_source.into_iter().collect<Set<i64>>()
  let entries = Cons<(i64, i64)>((1, 10), Cons<(i64, i64)>((2, 20), Cons<(i64, i64)>((1, 30), Nil<(i64, i64)>())))
  let map = entries.into_iter().collect<Map<i64, i64>>()

  Test.assert_eq(vector_len<i64>(vector), 3)
  Test.assert_eq(vector_get<i64>(vector, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(vector, 2, 0), 5)
  Test.assert_eq(list.len(), 3)
  Test.assert_eq(list.get(0).unwrap_or(0), 3)
  Test.assert_eq(list.get(2).unwrap_or(0), 5)
  Test.assert_eq(set.len(), 2)
  Test.assert_true(set.contains(2))
  Test.assert_true(set.contains(4))
  Test.assert_eq(map.len(), 2)
  Test.assert_eq(map.get(1).unwrap_or(0), 30)
  Test.assert_eq(map.get(2).unwrap_or(0), 20)
}

test "iterator_collect_empty_sources" {
  let vector = iter.range(0, 0).collect<Vector<i64>>()
  let list = iter.range(0, 0).collect<List<i64>>()
  let set = iter.range(0, 0).collect<Set<i64>>()
  Test.assert_eq(vector_len<i64>(vector), 0)
  Test.assert_eq(list.len(), 0)
  Test.assert_eq(set.len(), 0)
}

test "iter_lazy_map_filter_take_matrix" {
  for row in 0..3 {
    Test.assert_eq(iter_lazy_matrix_case(row), iter_lazy_matrix_expected(row))
  }
}

test "iter_lazy_composes_map_filter_take" {
  let mut it = iter.range(1, 6)
    |> iter.map(iter_double_i64)
    |> iter.filter(iter_keep_even_i64)
    |> iter.take(3)
  let a = it.next()
  let b = it.next()
  let c = it.next()
  let done = it.next()
  let again = it.next()
  Test.assert_eq(iter_option_value_or_i64(a, 0), 2)
  Test.assert_eq(iter_option_value_or_i64(b, 0), 4)
  Test.assert_eq(iter_option_value_or_i64(c, 0), 6)
  Test.assert_eq(iter_option_has_value<i64>(done), 0)
  Test.assert_eq(iter_option_has_value<i64>(again), 0)
}

test "iter_lazy_map_can_change_type" {
  Test.assert_eq(iter_lazy_map_can_change_type_case(), 340)
}

test "iter_lazy_early_close_drops_upstream" {
  let source = iter.range(1, 5)
  let mut mapped = iter.map(source, iter_inc_i64)
  let first = mapped.next()
  Test.assert_eq(iter_option_value_or_i64(first, 0), 2)
  mapped.close()
}

test "iter_lazy_take_zero_closes_upstream" {
  let source = iter.range(1, 5)
  let mut taken = iter.take(source, 0)
  Test.assert_eq(iter_option_has_value<i64>(taken.next()), 0)
}

test "iter_close_consumes_range" {
  let mut it = iter.range(0, 4)
  let first = it.next()
  Test.assert_eq(iter_option_value_or_i64(first, 99), 0)
  it.close()
}

test "iter_drop_generator_backed_pending_current" {
  let g = generator.start<i64, i64>(() => {
    generator.yield<i64>(9)
    0
  })
  let it = iter.from_generator(g)
  it.close()
}

test "iter_from_generator_discards_any_completion_type" {
  let g = generator.start<i64, str>(iter_str_completion)
  let values = iter.from_generator(g)
  Test.assert_eq(iter.fold(values, 0, iter_sum_i64), 42)
}

test "iter_from_generator_rc_next_ownership" {
  let g = generator.start<RuntimeRcProbe, i64>(iter_rc_owned_yield_once)
  let mut it = iter.from_generator(g)
  let first = it.next()
  let fallback: RuntimeRcProbe = runtime_rc_probe_new(0)
  let value: RuntimeRcProbe = iter_option_value_or<RuntimeRcProbe>(first, fallback)
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  -- The suspended producer, managed one-element lane carrier, option payload,
  -- and extracted result each hold one live stake at this point. Resumption
  -- releases the suspended carrier; final balance remains unchanged.
  Test.assert_eq(runtime_rc_probe_count(value), 4)
  let done = it.next()
  Test.assert_eq(iter_option_has_value<RuntimeRcProbe>(done), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  it.close()
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "iter_lazy_take_preserves_rc_payload" {
  let g = generator.start<RuntimeRcProbe, i64>(iter_rc_owned_yield_once)
  let mut it = iter.take(iter.from_generator(g), 1)
  let first = it.next()
  let fallback: RuntimeRcProbe = runtime_rc_probe_new(0)
  let value: RuntimeRcProbe = iter_option_value_or<RuntimeRcProbe>(first, fallback)
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  let done = it.next()
  Test.assert_eq(iter_option_has_value<RuntimeRcProbe>(done), 0)
  it.close()
}

test "property_iter_range_count" {
  Test.forall_i64_range(0, 16, iter_range_count_property)
}

test "property_iter_lazy_map_preserves_count" {
  Test.forall_i64_range(0, 16, iter_lazy_map_count_property)
}
