use stdlib/iter.{*}
use stdlib/generator.{*}
use stdlib/option.{*}
use stdlib/vector.{*}
use "runtime/memory.weft"
use runtime/rc_implicit_test.{*}

fn iter_option_has_value<T>(opt: Option<T>) -> i64 {
  match opt {
    Some(value) -> 1
    None -> 0
  }
}

fn iter_option_value_or_i64(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn iter_option_value_or<T>(opt: Option<T>, default: T) -> T {
  match opt {
    Some(value) -> value
    None -> default
  }
}

type IterBox {
  IterBox(i64)
}

fn iter_sum_i64(acc: i64, value: i64) -> i64 { acc + value }
fn iter_count_i64(acc: i64, value: i64) -> i64 { acc + 1 }
fn iter_double_i64(value: i64) -> i64 { value * 2 }
fn iter_inc_i64(value: i64) -> i64 { value + 1 }
fn iter_box_i64(value: i64) -> IterBox { IterBox(value + 3) }
fn iter_keep_even_i64(value: i64) -> i64 {
  if value % 2 == 0 { 1 } else { 0 }
}

fn iter_box_value_or(opt: Option<IterBox>, default: i64) -> i64 {
  match opt {
    Some(boxed) -> {
      match boxed {
        IterBox(value) -> value
      }
    }
    None -> default
  }
}

fn iter_lazy_map_can_change_type_case() -> i64 {
  let it = iter_map<i64, IterBox>(iter_range(0, 2), iter_box_i64)
  let a = iter_next<IterBox>(it)
  let b = iter_next<IterBox>(it)
  let done = iter_next<IterBox>(it)
  iter_box_value_or(a, 0) * 100 +
    iter_box_value_or(b, 0) * 10 +
    iter_option_has_value<IterBox>(done)
}

fn iter_range_matrix_case(row: i64) -> i64 {
  match row {
    0 -> iter_count<i64>(iter_range(4, 4)) * 100 + iter_fold<i64, i64>(iter_range(4, 4), 0, iter_sum_i64)
    1 -> {
      let it = iter_range(7, 8)
      iter_option_value_or_i64(iter_next<i64>(it), 0)
    }
    _ -> iter_fold<i64, i64>(iter_range(1, 5), 0, iter_sum_i64)
  }
}

fn iter_range_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 0
    1 -> 7
    _ -> 10
  }
}

fn iter_range_count_property(n: i64) -> bool {
  iter_count<i64>(iter_range(0, n)) == n
}

fn iter_lazy_map_count_property(n: i64) -> bool {
  iter_count<i64>(iter_map<i64, i64>(iter_range(0, n), iter_double_i64)) == n
}

fn iter_lazy_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let it = iter_map<i64, i64>(iter_range(1, 4), iter_double_i64)
      iter_option_value_or_i64(iter_next<i64>(it), 0) * 100 +
        iter_option_value_or_i64(iter_next<i64>(it), 0) * 10 +
        iter_option_value_or_i64(iter_next<i64>(it), 0)
    }
    1 -> {
      let it = iter_filter<i64>(iter_range(0, 6), iter_keep_even_i64)
      iter_option_value_or_i64(iter_next<i64>(it), 9) * 100 +
        iter_option_value_or_i64(iter_next<i64>(it), 9) * 10 +
        iter_option_value_or_i64(iter_next<i64>(it), 9)
    }
    _ -> {
      let it = iter_take<i64>(iter_range(5, 9), 2)
      iter_option_value_or_i64(iter_next<i64>(it), 0) * 10 +
        iter_option_value_or_i64(iter_next<i64>(it), 0)
    }
  }
}

fn iter_lazy_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 246
    1 -> 24
    _ -> 56
  }
}

fn iter_rc_owned_yield_once() -[GeneratorYield]> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(44)
  generator_yield<RuntimeRcProbe>(p)
  0
}

test "iter_range_empty_single_many_matrix" {
  for row in 0..3 {
    Test.assert_eq(iter_range_matrix_case(row), iter_range_matrix_expected(row))
  }
}

test "iter_next_preserves_order_and_repeats_done" {
  let it = iter_range(2, 5)
  let a = iter_next<i64>(it)
  let b = iter_next<i64>(it)
  let c = iter_next<i64>(it)
  let done = iter_next<i64>(it)
  let again = iter_next<i64>(it)
  Test.assert_eq(iter_option_value_or_i64(a, 0), 2)
  Test.assert_eq(iter_option_value_or_i64(b, 0), 3)
  Test.assert_eq(iter_option_value_or_i64(c, 0), 4)
  Test.assert_eq(iter_option_has_value<i64>(done), 0)
  Test.assert_eq(iter_option_has_value<i64>(again), 0)
}

test "iter_fold_count_and_collect_vector" {
  let sum = iter_fold<i64, i64>(iter_range(1, 6), 0, iter_sum_i64)
  let count = iter_count<i64>(iter_range(10, 14))
  let collected = iter_collect_vector<i64>(iter_range(3, 7))
  Test.assert_eq(sum, 15)
  Test.assert_eq(count, 4)
  Test.assert_eq(vector_len<i64>(collected), 4)
  Test.assert_eq(vector_get<i64>(collected, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(collected, 3, 0), 6)
}

test "iter_map_filter_take_collect_helpers" {
  let mapped = iter_map_collect_vector<i64, i64>(iter_range(1, 5), iter_double_i64)
  let filtered = iter_filter_collect_i64(iter_range(0, 7), iter_keep_even_i64)
  let taken = iter_take_collect_vector<i64>(iter_range(5, 10), 2)
  let none = iter_take_collect_vector<i64>(iter_range(5, 10), 0)
  Test.assert_eq(vector_len<i64>(mapped), 4)
  Test.assert_eq(vector_get<i64>(mapped, 0, 0), 2)
  Test.assert_eq(vector_get<i64>(mapped, 3, 0), 8)
  Test.assert_eq(vector_len<i64>(filtered), 4)
  Test.assert_eq(vector_fold<i64, i64>(filtered, 0, iter_sum_i64), 12)
  Test.assert_eq(vector_len<i64>(taken), 2)
  Test.assert_eq(vector_get<i64>(taken, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(taken, 1, 0), 6)
  Test.assert_eq(vector_len<i64>(none), 0)
}

test "iter_lazy_map_filter_take_matrix" {
  for row in 0..3 {
    Test.assert_eq(iter_lazy_matrix_case(row), iter_lazy_matrix_expected(row))
  }
}

test "iter_lazy_composes_map_filter_take" {
  let it = iter_take<i64>(
    iter_filter<i64>(
      iter_map<i64, i64>(iter_range(1, 6), iter_double_i64),
      iter_keep_even_i64
    ),
    3
  )
  let a = iter_next<i64>(it)
  let b = iter_next<i64>(it)
  let c = iter_next<i64>(it)
  let done = iter_next<i64>(it)
  let again = iter_next<i64>(it)
  Test.assert_eq(iter_option_value_or_i64(a, 0), 2)
  Test.assert_eq(iter_option_value_or_i64(b, 0), 4)
  Test.assert_eq(iter_option_value_or_i64(c, 0), 6)
  Test.assert_eq(iter_option_has_value<i64>(done), 0)
  Test.assert_eq(iter_option_has_value<i64>(again), 0)
}

test "iter_lazy_map_can_change_type" {
  Test.assert_eq(iter_lazy_map_can_change_type_case(), 340)
}

test "iter_lazy_early_drop_drops_upstream" {
  let source = iter_range(1, 5)
  let mapped = iter_map<i64, i64>(source, iter_inc_i64)
  let first = iter_next<i64>(mapped)
  Test.assert_eq(iter_option_value_or_i64(first, 0), 2)
  Test.assert_eq(iter_drop<i64>(mapped), 1)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(source)), 0)
  Test.assert_eq(iter_drop<i64>(mapped), 0)
}

test "iter_lazy_take_zero_closes_upstream" {
  let source = iter_range(1, 5)
  let taken = iter_take<i64>(source, 0)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(taken)), 0)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(source)), 0)
}

test "iter_drop_early_exhausts_range" {
  let it = iter_range(0, 4)
  let first = iter_next<i64>(it)
  Test.assert_eq(iter_option_value_or_i64(first, 99), 0)
  Test.assert_eq(iter_drop<i64>(it), 0)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(it)), 0)
}

test "iter_drop_generator_backed_pending_current" {
  let g = generator_new<i64, i64>(() => {
    generator_yield<i64>(9)
    0
  })
  let it = iter_from_generator<i64>(g)
  Test.assert_eq(iter_drop<i64>(it), 1)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(it)), 0)
}

test "iter_from_generator_rc_next_ownership" {
  let g = generator_new<RuntimeRcProbe, i64>(iter_rc_owned_yield_once)
  let it = iter_from_generator<RuntimeRcProbe>(g)
  let first = iter_next<RuntimeRcProbe>(it)
  let fallback: RuntimeRcProbe = runtime_rc_probe_new(0)
  let value: RuntimeRcProbe = iter_option_value_or<RuntimeRcProbe>(first, fallback)
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  -- 2q slice 2 count contract: call results are owned, so the extractor
  -- returns value with its own count on top of the option's payload
  -- stake. The end-to-end churn shape is arena-flat (gen_flat probe).
  Test.assert_eq(runtime_rc_probe_count(value), 3)
  let done = iter_next<RuntimeRcProbe>(it)
  Test.assert_eq(iter_option_has_value<RuntimeRcProbe>(done), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  Test.assert_eq(iter_drop<RuntimeRcProbe>(it), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "iter_lazy_take_preserves_rc_payload" {
  let g = generator_new<RuntimeRcProbe, i64>(iter_rc_owned_yield_once)
  let it = iter_take<RuntimeRcProbe>(iter_from_generator<RuntimeRcProbe>(g), 1)
  let first = iter_next<RuntimeRcProbe>(it)
  let fallback: RuntimeRcProbe = runtime_rc_probe_new(0)
  let value: RuntimeRcProbe = iter_option_value_or<RuntimeRcProbe>(first, fallback)
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  let done = iter_next<RuntimeRcProbe>(it)
  Test.assert_eq(iter_option_has_value<RuntimeRcProbe>(done), 0)
  Test.assert_eq(iter_drop<RuntimeRcProbe>(it), 0)
}

test "property_iter_range_count" {
  Test.forall_i64_range(0, 16, iter_range_count_property)
}

test "property_iter_lazy_map_preserves_count" {
  Test.forall_i64_range(0, 16, iter_lazy_map_count_property)
}
