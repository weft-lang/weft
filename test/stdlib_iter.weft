use "stdlib/iter.weft"
use "stdlib/generator.weft"
use "stdlib/option.weft"
use "stdlib/vector.weft"
use "runtime/rc.weft"

fn iter_option_has_value<T>(opt: Option<T>) -> i64 {
  match opt {
    Some(value) -> 1
    None -> 0
  }
}

fn iter_option_value_or_i64(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn iter_option_value_or<T>(opt: Option<T>, default: T) -> T {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn iter_sum_i64(acc: i64, value: i64) -> i64 { acc + value }
fn iter_count_i64(acc: i64, value: i64) -> i64 { acc + 1 }
fn iter_double_i64(value: i64) -> i64 { value * 2 }
fn iter_keep_even_i64(value: i64) -> i64 {
  if value % 2 == 0 { 1 } else { 0 }
}

fn iter_range_matrix_case(row: i64) -> i64 {
  match row {
    0 -> iter_count<i64>(iter_range(4, 4)) * 100 + iter_fold<i64, i64>(iter_range(4, 4), 0, iter_sum_i64)
    1 -> {
      let it = iter_range(7, 8)
      iter_option_value_or_i64(iter_next<i64>(it), 0)
    }
    _ -> iter_fold<i64, i64>(iter_range(1, 5), 0, iter_sum_i64)
  }
}

fn iter_range_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 0
    1 -> 7
    _ -> 10
  }
}

fn iter_range_count_property(n: i64) -> bool {
  iter_count<i64>(iter_range(0, n)) == n
}

fn iter_rc_owned_yield_once() -[GeneratorYield]> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 44)
  generator_yield<rc i64>(p)
  0
}

test "iter_range_empty_single_many_matrix" {
  for row in 0..3 {
    Test.assert_eq(iter_range_matrix_case(row), iter_range_matrix_expected(row))
  }
}

test "iter_next_preserves_order_and_repeats_done" {
  let it = iter_range(2, 5)
  let a = iter_next<i64>(it)
  let b = iter_next<i64>(it)
  let c = iter_next<i64>(it)
  let done = iter_next<i64>(it)
  let again = iter_next<i64>(it)
  Test.assert_eq(iter_option_value_or_i64(a, 0), 2)
  Test.assert_eq(iter_option_value_or_i64(b, 0), 3)
  Test.assert_eq(iter_option_value_or_i64(c, 0), 4)
  Test.assert_eq(iter_option_has_value<i64>(done), 0)
  Test.assert_eq(iter_option_has_value<i64>(again), 0)
}

test "iter_fold_count_and_collect_vector" {
  let sum = iter_fold<i64, i64>(iter_range(1, 6), 0, iter_sum_i64)
  let count = iter_count<i64>(iter_range(10, 14))
  let collected = iter_collect_vector<i64>(iter_range(3, 7))
  Test.assert_eq(sum, 15)
  Test.assert_eq(count, 4)
  Test.assert_eq(vector_len(collected), 4)
  Test.assert_eq(vector_get<i64>(collected, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(collected, 3, 0), 6)
}

test "iter_map_filter_take_collect_helpers" {
  let mapped = iter_map_collect_vector<i64, i64>(iter_range(1, 5), iter_double_i64)
  let filtered = iter_filter_collect_i64(iter_range(0, 7), iter_keep_even_i64)
  let taken = iter_take_collect_vector<i64>(iter_range(5, 10), 2)
  let none = iter_take_collect_vector<i64>(iter_range(5, 10), 0)
  Test.assert_eq(vector_len(mapped), 4)
  Test.assert_eq(vector_get<i64>(mapped, 0, 0), 2)
  Test.assert_eq(vector_get<i64>(mapped, 3, 0), 8)
  Test.assert_eq(vector_len(filtered), 4)
  Test.assert_eq(vector_fold<i64, i64>(filtered, 0, iter_sum_i64), 12)
  Test.assert_eq(vector_len(taken), 2)
  Test.assert_eq(vector_get<i64>(taken, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(taken, 1, 0), 6)
  Test.assert_eq(vector_len(none), 0)
}

test "iter_drop_early_exhausts_range" {
  let it = iter_range(0, 4)
  let first = iter_next<i64>(it)
  Test.assert_eq(iter_option_value_or_i64(first, 99), 0)
  Test.assert_eq(iter_drop<i64>(it), 0)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(it)), 0)
}

test "iter_drop_generator_backed_pending_current" {
  let g = generator_new<i64, i64>(() => {
    generator_yield<i64>(9)
    0
  })
  let it = iter_from_generator<i64>(g)
  Test.assert_eq(iter_drop<i64>(it), 1)
  Test.assert_eq(iter_option_has_value<i64>(iter_next<i64>(it)), 0)
}

test "iter_from_generator_rc_next_ownership" {
  let g = generator_new<rc i64, i64>(iter_rc_owned_yield_once)
  let it = iter_from_generator<rc i64>(g)
  let first = iter_next<rc i64>(it)
  let fallback: rc i64 = rc_default_alloc(8, 8)
  let value: rc i64 = iter_option_value_or<rc i64>(first, fallback)
  Test.assert_eq(__mem_load64(value), 44)
  Test.assert_eq(rc_count(value), 2)
  let done = iter_next<rc i64>(it)
  Test.assert_eq(iter_option_has_value<rc i64>(done), 0)
  Test.assert_eq(rc_count(value), 1)
  Test.assert_eq(iter_drop<rc i64>(it), 0)
  Test.assert_eq(rc_count(value), 1)
}

test "property_iter_range_count" {
  Test.forall_i64_range(0, 16, iter_range_count_property)
}
