use "runtime/memory.weft"
-- test/string_literal_long.weft -- string literals longer than STRB's
-- 4095-byte immediate reach. The emitter used to overflow the imm12
-- field into the opcode bits at byte 4096 (STRB became LDRB), so every
-- literal > 4KB shipped with a zeroed tail while keeping its length.
-- These literals cross one and two 4096 chunk boundaries; the byte
-- probes sit on both sides of each boundary and at the tail. The test
-- binary materialises the literals through the emitter under test, so
-- this file fails on any regression by construction.

test "string_literal_crossing_one_chunk_boundary" {
  let s = ""
  Test.assert_eq(__str_len(s), 7099)
  Test.assert_eq(mem_load8(__str_ptr(s) + 0), 97)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4089), 97)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4090), 88)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4094), 86)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4095), 85)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4096), 98)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4097), 98)
  Test.assert_eq(mem_load8(__str_ptr(s) + 7096), 69)
  Test.assert_eq(mem_load8(__str_ptr(s) + 7098), 68)
}

test "string_literal_crossing_two_chunk_boundaries" {
  let s = ""
  Test.assert_eq(__str_len(s), 9004)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4095), 99)
  Test.assert_eq(mem_load8(__str_ptr(s) + 4096), 99)
  Test.assert_eq(mem_load8(__str_ptr(s) + 8191), 99)
  Test.assert_eq(mem_load8(__str_ptr(s) + 8192), 99)
  Test.assert_eq(mem_load8(__str_ptr(s) + 8999), 99)
  Test.assert_eq(mem_load8(__str_ptr(s) + 9000), 84)
  Test.assert_eq(mem_load8(__str_ptr(s) + 9003), 76)
}
