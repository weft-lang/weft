-- Native in-image addresses must not inherit ADR's ±1 MiB reach ceiling.

use compiler/encode.{encode_add_reg, encode_adr, encode_brk, encode_sub_reg}
use compiler/pipeline.{pipeline_ir_native_emit_image_address, pipeline_native_code_word}
use runtime/buffer.{buf_len, buf_new}

fn native_image_address_contains(code: i64, instruction: i64) -> bool {
  let mut found = false
  let mut offset = 0
  while offset < buf_len(code) and not found {
    if pipeline_native_code_word(code, offset) == instruction { found = true }
    else { offset = offset + 4 }
  }
  found
}

test "native image address materialization exceeds ADR reach in both directions" {
  let forward = buf_new(32)
  pipeline_ir_native_emit_image_address(forward, 0, 2097152)
  Test.assert_eq(pipeline_native_code_word(forward, 0), encode_adr(0, 0))
  Test.assert_eq(
    pipeline_native_code_word(forward, buf_len(forward) - 4),
    encode_add_reg(0, 0, 17)
  )
  Test.assert_false(native_image_address_contains(forward, encode_brk(21)))

  let backward = buf_new(32)
  pipeline_ir_native_emit_image_address(backward, 2, 0 - 2097152)
  Test.assert_eq(pipeline_native_code_word(backward, 0), encode_adr(2, 0))
  Test.assert_eq(
    pipeline_native_code_word(backward, buf_len(backward) - 4),
    encode_sub_reg(2, 2, 17)
  )
  Test.assert_false(native_image_address_contains(backward, encode_brk(21)))
}
