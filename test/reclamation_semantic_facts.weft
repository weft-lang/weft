use module_fixtures/compiler_probe.{require_checked}
use compiler/backend/aarch64/codegen.{cg_semantic_fact_effect_contract_pure, cg_semantic_fact_consuming_param_mask, cg_semantic_fact_observes_cleanup, mono_spec_hash}
use compiler/backend/aarch64/codegen.{cg_semantic_fact_new_raw}
use compiler/ir/data.{*}
use compiler/storage.{*}
use compiler/pipeline.{*}
use compiler/weft/check/table.{*}
use compiler/types/algebra.{ty_i64}

test "cleanup facts preserve declared purity while fencing dead and repeated calls" {
  let source = "use stdlib/drop as drop
type Token { value: i64 }
impl drop.Drop for Token { fn drop(self) -> nil { nil } }
fn make(value: i64) -> owned Token { Token { value: value } }
fn dispose(value: i64) -> nil { let token = make(value); nil }
fn wrapper(value: i64) -> nil { dispose(value) }
fn generic<T>(value: i64, result: T) -> T { let token = make(value); result }
fn add_one(value: i64) -> i64 { value + 1 }
fn main() -> i64 { wrapper(0); generic<i64>(0, 42) }
"
  let typed = require_checked(pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0))
  let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
  let facts = pipeline_typed_optimisation_prefix_facts(prefix)
  for name in ["dispose", "wrapper"] {
    let hash = str_hash(__str_ptr(name), 0, __str_len(name))
    let fact = pipeline_ir_semantic_fact_find(facts, hash)
    Test.assert_eq(cg_semantic_fact_effect_contract_pure(fact), 1)
    Test.assert_eq(cg_semantic_fact_consuming_param_mask(fact), 0)
    Test.assert_true(cg_semantic_fact_observes_cleanup(fact))
    Test.assert_eq(pipeline_ir_inst_is_dead_pure_candidate(IrCallI64(0, hash, IrValueNil), facts), 0)
    Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure_nonconsuming_scalar_result(facts, hash), 0)
  }
  let args = nlist_new()
  nlist_add(args, ty_i64())
  let generic = mono_spec_hash(str_hash(__str_ptr("generic"), 0, 7), args)
  let generic_fact = pipeline_ir_semantic_fact_find(facts, generic)
  Test.assert_true(cg_semantic_fact_observes_cleanup(generic_fact))
  Test.assert_eq(cg_semantic_fact_effect_contract_pure(generic_fact), 1)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure_nonconsuming_scalar_result(facts, generic), 0)
  let pure = str_hash(__str_ptr("add_one"), 0, 7)
  Test.assert_false(cg_semantic_fact_observes_cleanup(pipeline_ir_semantic_fact_find(facts, pure)))
  Test.assert_eq(pipeline_ir_inst_is_dead_pure_candidate(IrCallI64(0, pure, IrValueNil), facts), 1)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure_nonconsuming_scalar_result(facts, pure), 1)
}

test "body observations belong to each callback identity specialization" {
  let base_fact = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 0, 2, 0)
  let base = pipeline_ir_semantic_facts_prepend(1, base_fact, pipeline_ir_semantic_facts_empty())
  let requests = nlist_new()
  nlist_add(requests, node_new(0, 1, 2, 0, 0))
  let facts = pipeline_ir_identity_facts_extend(requests, base)
  let dynamic = IrFunction(1, 0,
    IrBlockListCons(IrBlock(0, IrValueNil,
      IrInstCons(IrIndirectCallI64(0, 1, IrValueNil, UnknownTypeExpr(0)), IrInstNil), IrTermReturn(0)), IrBlockListNil), 0)
  let resolved = IrFunction(2, 0,
    IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(IrConstI64(0, 42), IrInstNil), IrTermReturn(0)), IrBlockListNil), 0)
  let enriched = pipeline_ir_reclamation_facts_enrich(IrFunctionCons(dynamic, IrFunctionCons(resolved, IrFunctionNil)), facts)
  Test.assert_true(cg_semantic_fact_observes_cleanup(pipeline_ir_semantic_fact_find(enriched, 1)))
  Test.assert_false(cg_semantic_fact_observes_cleanup(pipeline_ir_semantic_fact_find(enriched, 2)))
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure(enriched, 1), 0)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_pure(enriched, 2), 1)
}
