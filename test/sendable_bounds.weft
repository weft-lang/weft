type SendableBox<T> {
  SendableBox(T)
}

fn sendable_identity<T: Sendable>(value: T) -> T {
  value
}

fn sendable_forward<T: Sendable>(value: T) -> T {
  sendable_identity<T>(value)
}

test "sendable_bound_accepts_scalar" {
  Test.assert_eq(sendable_identity<i64>(42), 42)
}

test "sendable_bound_accepts_managed_immutable_value" {
  Test.assert_str_eq(sendable_identity<str>("weft"), "weft")
}

test "sendable_bound_is_forwarded_by_generic_evidence" {
  Test.assert_eq(sendable_forward<i64>(41) + 1, 42)
}

test "sendable_bound_recurses_through_generic_nominal_fields" {
  let box = sendable_identity<SendableBox<i64>>(SendableBox<i64>(42))
  match box {
    SendableBox(value) -> Test.assert_eq(value, 42)
  }
}
