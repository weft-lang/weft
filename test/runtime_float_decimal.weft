use runtime/float.{*}
use stdlib/test.{*}

fn runtime_decimal_f64_bits(source: str) -> i64 {
  let result = runtime_float_decimal_f64_bits(__str_ptr(source), 0, __str_len(source))
  runtime_float_bits_result_bits(result)
}

fn runtime_decimal_f64_ok(source: str) -> i64 {
  let result = runtime_float_decimal_f64_bits(__str_ptr(source), 0, __str_len(source))
  runtime_float_bits_result_ok(result)
}

fn runtime_decimal_f32_bits(source: str) -> i64 {
  let result = runtime_float_decimal_f32_bits(__str_ptr(source), 0, __str_len(source))
  runtime_float_bits_result_bits(result)
}

fn runtime_decimal_f64_fast_ok(source: str) -> i64 {
  let result = runtime_float_decimal_ieee_bits_small(__str_ptr(source), 0, __str_len(source), 52, 1023)
  runtime_float_bits_result_ok(result)
}

test "runtime decimal conversion covers ordinary f64 values" {
  Test.assert_eq(runtime_decimal_f64_ok("0.0"), 1)
  Test.assert_eq(runtime_decimal_f64_bits("0.0"), 0)
  Test.assert_eq(runtime_decimal_f64_bits("0.5"), 4602678819172646912)
  Test.assert_eq(runtime_decimal_f64_bits("1.0"), 4607182418800017408)
  Test.assert_eq(runtime_decimal_f64_bits("1.5"), 4609434218613702656)
  Test.assert_eq(runtime_decimal_f64_bits("20.0"), 4626322717216342016)
}

test "runtime decimal conversion rounds f64 ties to even" {
  Test.assert_eq(runtime_decimal_f64_bits("16777217.0"), 4715268810125344768)
  Test.assert_eq(runtime_decimal_f64_bits("9007199254740993.0"), 4845873199050653696)
}

test "runtime decimal conversion accepts exponent notation" {
  Test.assert_eq(runtime_decimal_f64_bits("1e3"), 4652007308841189376)
  Test.assert_eq(runtime_decimal_f64_bits("1.25e2"), 4638496509959077888)
  Test.assert_eq(runtime_decimal_f64_bits("1e-3"), 4562254508917369340)
}

test "runtime decimal conversion handles arbitrary precision mantissas" {
  Test.assert_eq(runtime_decimal_f64_bits("123456789012345678901234567890.0"), 5042042089369253694)
  Test.assert_eq(runtime_decimal_f64_bits("0.123456789012345678901234567890123456789"), 4593560419847042655)
  Test.assert_eq(runtime_decimal_f64_bits("0.0000690460016972063023"), 4544723120079945088)
}

test "runtime decimal conversion covers f64 subnormal boundaries" {
  Test.assert_eq(runtime_decimal_f64_bits("5e-324"), 1)
  Test.assert_eq(runtime_decimal_f64_bits("1e-324"), 0)
  Test.assert_eq(runtime_decimal_f64_bits("2.2250738585072014e-308"), 4503599627370496)
}

test "runtime decimal conversion covers f64 finite and overflow boundaries" {
  Test.assert_eq(runtime_decimal_f64_bits("1.7976931348623157e308"), 9218868437227405311)
  Test.assert_eq(runtime_decimal_f64_bits("1e309"), 9218868437227405312)
}

test "runtime decimal conversion covers ordinary f32 values" {
  Test.assert_eq(runtime_decimal_f32_bits("1.0"), 1065353216)
  Test.assert_eq(runtime_decimal_f32_bits("1.5"), 1069547520)
  Test.assert_eq(runtime_decimal_f32_bits("20.0"), 1101004800)
  Test.assert_eq(runtime_decimal_f32_bits("16777217.0"), 1266679808)
}

test "runtime decimal conversion covers f32 subnormal and overflow boundaries" {
  Test.assert_eq(runtime_decimal_f32_bits("1e-45"), 1)
  Test.assert_eq(runtime_decimal_f32_bits("1e-46"), 0)
  Test.assert_eq(runtime_decimal_f32_bits("3.4028234663852886e38"), 2139095039)
  Test.assert_eq(runtime_decimal_f32_bits("1e39"), 2139095040)
}

test "runtime decimal fast path is used only where exact" {
  Test.assert_eq(runtime_decimal_f64_fast_ok("1.0"), 1)
  Test.assert_eq(runtime_decimal_f64_fast_ok("9007199254740993.0"), 1)
  Test.assert_eq(runtime_decimal_f64_fast_ok("0.123456789012345678901234567890123456789"), 0)
  Test.assert_eq(runtime_decimal_f64_fast_ok("5e-324"), 0)
  Test.assert_eq(runtime_decimal_f64_fast_ok("1e309"), 0)
}
