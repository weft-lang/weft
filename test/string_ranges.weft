use stdlib/option.{Option, Some, None}
use stdlib/string
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr, runtime_str_builder_set_byte}

test "string byte access preserves UTF-8 storage and rejects every invalid position" {
  let text = "Aé水🧶"
  let expected: [u8; 10] = [65, 195, 169, 230, 176, 180, 240, 159, 167, 182]
  let mut position: usize = 0
  for byte in expected {
    match text.byte_at(position) {
      Some(actual) -> Test.assert_true(actual == byte)
      None -> Test.assert_true(false)
    }
    position = position + 1
  }
  let invalid: [usize; 5] = [10, 11, 9223372036854775807, 9223372036854775808, 18446744073709551615]
  for position in invalid {
    Test.assert_true(text.byte_at(position).is_none())
  }
  Test.assert_true("".byte_at(0).is_none())
}

test "string byte access distinguishes every byte including zero from absence" {
  let text = runtime_str_alloc_uninit(256)
  for value in 0..256 {
    runtime_str_builder_set_byte(runtime_str_ptr(text), 256, value, value)
  }
  let mut position: usize = 0
  for value in 0..256 {
    match text.byte_at(position) {
      Some(actual) -> Test.assert_true(actual == __i64_to_u8(value))
      None -> Test.assert_true(false)
    }
    position = position + 1
  }
  Test.assert_true(text.byte_at(256).is_none())
}

test "string slices preserve scalar text and empty ranges" {
  let text = "Aé水🧶"
  let cases: [(usize, usize, str); 10] = [
    (0, 0, ""), (0, 1, "A"), (1, 3, "é"), (3, 6, "水"),
    (6, 10, "🧶"), (1, 10, "é水🧶"), (0, 10, "Aé水🧶"),
    (3, 3, ""), (6, 6, ""), (10, 10, "")
  ]
  for (start, end, expected) in cases {
    Test.assert_str_eq(text.slice(start, end).unwrap(), expected)
  }
  Test.assert_str_eq("".slice(0, 0).unwrap(), "")
}

test "string slices reject reversed overflowing and split-scalar ranges" {
  let text = "Aé水🧶"
  let cases: [(usize, usize); 13] = [
    (2, 3), (1, 2), (4, 6), (3, 5), (7, 10), (6, 9),
    (2, 2), (10, 6), (11, 11), (0, 11),
    (0, 9223372036854775808), (0, 18446744073709551615),
    (18446744073709551615, 18446744073709551615)
  ]
  for (start, end) in cases { Test.assert_true(text.slice(start, end).is_none()) }
}

fn detached_string_slice() -> str {
  let text = "discard ".concat("retained suffix")
  text.slice(8, 16).unwrap()
}

test "a copied string slice outlives its source storage" {
  let selected = detached_string_slice()
  for iteration in 0..64 {
    let noise = "replacement".repeat(32)
    Test.assert_true(noise.len() == 352)
    Test.assert_str_eq(selected, "retained")
  }
}


test "string slices validate the selected bytes without requiring valid surrounding bytes" {
  let storage = runtime_str_alloc_uninit(4)
  runtime_str_builder_set_byte(runtime_str_ptr(storage), 4, 0, 255)
  runtime_str_builder_set_byte(runtime_str_ptr(storage), 4, 1, 65)
  runtime_str_builder_set_byte(runtime_str_ptr(storage), 4, 2, 66)
  runtime_str_builder_set_byte(runtime_str_ptr(storage), 4, 3, 255)
  Test.assert_str_eq(storage.slice(1, 3).unwrap(), "AB")
  Test.assert_true(storage.slice(0, 3).is_none())
  Test.assert_true(storage.slice(1, 4).is_none())
}

test "string slices compose into an exact partition of mixed-width text" {
  let text = "aé水🧶".repeat(512)
  let mut position: usize = 0
  for part in 0..512 {
    Test.assert_str_eq(text.slice(position, position + 10).unwrap(), "aé水🧶")
    position = position + 10
  }
  Test.assert_true(position == text.len())
}
