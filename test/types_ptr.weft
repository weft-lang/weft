fn types_ptr_identity(p: *i64) -> i64 {
  p.*
}

fn types_ptr_choose(flag: bool, p: *i64, q: *i64) -> *i64 {
  if flag { p } else { q }
}

test "types_ptr_signature_annotation" {
  let x = 10
  Test.assert_eq(types_ptr_identity(&x), 10)
}

test "types_ptr_return_pointer_value" {
  let x = 11
  let y = 12
  let p = types_ptr_choose(false, &x, &y)
  Test.assert_eq(p.*, 12)
}
