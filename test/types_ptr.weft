-- Test pointer type annotations in function signatures
-- Expected exit code: 10

fn identity(x: i64) -> i64 {
  x
}

fn ptr_param(p: *i64) -> i64 {
  10
}

fn rc_param(r: rc i64) -> i64 {
  10
}

fn mut_ptr_param(p: *mut i64) -> i64 {
  20
}

fn main() -> i64 {
  let x = identity(5)
  let a = ptr_param(x)
  let b = rc_param(x)
  a
}
