use "stdlib/unsafe.weft"

fn types_ptr_identity(p: *i64) -[Unsafe]> i64 {
  p.*
}

fn types_ptr_choose(flag: bool, p: *i64, q: *i64) -> *i64 {
  if flag { p } else { q }
}

fn types_ptr_write(p: *mut i64, value: i64) -[Unsafe]> i64 {
  p.* = value
  p.*
}

fn types_ptr_signature_annotation_impl() -[Unsafe]> i64 {
  let x = 10
  types_ptr_identity(&x)
}

fn types_ptr_return_pointer_value_impl() -[Unsafe]> i64 {
  let x = 11
  let y = 12
  let p = types_ptr_choose(false, &x, &y)
  p.*
}

fn types_ptr_mut_pointer_write_signature_impl() -[Unsafe]> i64 {
  let mut x = 1
  let wrote = types_ptr_write(&mut x, 23)
  wrote * 100 + x
}

fn types_ptr_run_unsafe(f: () -[Unsafe]> i64) -> i64 {
  handle f() {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

test "types_ptr_signature_annotation" {
  Test.assert_eq(types_ptr_run_unsafe(types_ptr_signature_annotation_impl), 10)
}

test "types_ptr_return_pointer_value" {
  Test.assert_eq(types_ptr_run_unsafe(types_ptr_return_pointer_value_impl), 12)
}

test "types_ptr_mut_pointer_write_signature" {
  Test.assert_eq(types_ptr_run_unsafe(types_ptr_mut_pointer_write_signature_impl), 2323)
}
