fn ir_opt_metric_managed_param_inline_ir() -> IrModule {
  let callee_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 42), ir_inst_list_empty())
  let callee_block = ir_block_new_term(0, callee_insts, ir_term_return(1))
  let callee = ir_function_new(910, 1, callee_block)
  let args = ir_value_list_prepend(0, ir_value_list_empty())
  let caller_insts = ir_inst_list_prepend(ir_inst_call_i64(1, 910, args), ir_inst_list_empty())
  let caller_block = ir_block_new_term(0, caller_insts, ir_term_return(1))
  let caller = ir_function_new(911, 1, caller_block)
  pipeline_ir_module(ir_function_list_prepend(callee, ir_function_list_prepend(caller, ir_function_list_empty())))
}

