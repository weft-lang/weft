  let merge_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 5),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_add(), 10, 3), ir_inst_list_empty())
  )
  let merge = ir_block_new_params(3, merge_params, merge_insts, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(left, ir_block_list_prepend(right, ir_block_list_prepend(merge, ir_block_list_empty()))))
  let f = ir_function_new_blocks(16, 1, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_sccp_repeated_prune_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let left_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 4), ir_inst_list_empty())
  let right_insts = ir_inst_list_prepend(
    ir_inst_const_i64(2, 6),
    ir_inst_list_prepend(ir_inst_call_i64(12, 999, ir_value_list_empty()), ir_inst_list_empty())
  )
  let left_args = ir_value_list_prepend(1, ir_value_list_empty())
  let right_args = ir_value_list_prepend(2, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let left = ir_block_new_term(1, left_insts, ir_term_jump_args(3, left_args))
  let right = ir_block_new_term(2, right_insts, ir_term_jump_args(3, right_args))
  let merge_params = ir_value_list_prepend(10, ir_value_list_empty())
  let merge_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 4),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_from_parser(5), 10, 3), ir_inst_list_empty())
  )
  let merge = ir_block_new_params(3, merge_params, merge_insts, ir_term_branch(4, 4, 5))
  let use_insts = ir_inst_list_prepend(ir_inst_const_i64(5, 9), ir_inst_list_empty())
  let dud_insts = ir_inst_list_prepend(ir_inst_const_i64(6, 12), ir_inst_list_empty())
  let use_args = ir_value_list_prepend(5, ir_value_list_empty())
  let dud_args = ir_value_list_prepend(6, ir_value_list_empty())
  let use_block = ir_block_new_term(4, use_insts, ir_term_jump_args(6, use_args))
  let dud_block = ir_block_new_term(5, dud_insts, ir_term_jump_args(6, dud_args))
  let final_params = ir_value_list_prepend(11, ir_value_list_empty())
  let final_insts = ir_inst_list_prepend(
    ir_inst_const_i64(7, 1),
    ir_inst_list_prepend(ir_inst_binary_i64(8, ir_binary_op_add(), 11, 7), ir_inst_list_empty())
  )
  let final_block = ir_block_new_params(6, final_params, final_insts, ir_term_return(8))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(left, ir_block_list_prepend(right, ir_block_list_prepend(merge, ir_block_list_prepend(use_block, ir_block_list_prepend(dud_block, ir_block_list_prepend(final_block, ir_block_list_empty()))))))
  )
  let f = ir_function_new_blocks(17, 0, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_block_param_dynamic_arg_ir() -> IrModule {
  let jump_args = ir_value_list_prepend(0, ir_value_list_empty())
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_jump_args(1, jump_args))
  let exit_params = ir_value_list_prepend(10, ir_value_list_empty())
  let exit_insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 3),
    ir_inst_list_prepend(ir_inst_binary_i64(2, ir_binary_op_add(), 10, 1), ir_inst_list_empty())
  )
  let exit = ir_block_new_params(1, exit_params, exit_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(11, 1, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_block_param_branch_target_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let jump_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 4), ir_inst_list_empty())
  let jump_args = ir_value_list_prepend(1, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 2, 1))
  let jump = ir_block_new_term(1, jump_insts, ir_term_jump_args(2, jump_args))
  let merge_params = ir_value_list_prepend(10, ir_value_list_empty())
  let merge_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 5),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_add(), 10, 3), ir_inst_list_empty())
  )
  let merge = ir_block_new_params(2, merge_params, merge_insts, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(jump, ir_block_list_prepend(merge, ir_block_list_empty())))
  let f = ir_function_new_blocks(12, 0, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

test "ir_optimizer_const_folds_happy_arithmetic_table" {
  let add = "fn main() -> i64 { 2 + 3 }"
  let sub = "fn main() -> i64 { 7 - 4 }"
  let mul = "fn main() -> i64 { 6 * 7 }"
  Test.assert_eq(ir_opt_metric_const_folds(add), 1)
  Test.assert_eq(ir_opt_metric_binary_count(add), 0)
  Test.assert_eq(ir_opt_metric_const_folds(sub), 1)
  Test.assert_eq(ir_opt_metric_binary_count(sub), 0)
  Test.assert_eq(ir_opt_metric_const_folds(mul), 1)
  Test.assert_eq(ir_opt_metric_binary_count(mul), 0)
}

test "ir_optimizer_const_folds_nested_expression" {
  let src = "fn main() -> i64 { 1 + 2 * 3 }"
  -- 2*3 folds to 6, then 1+6 folds to 7; the literal consts and the
  -- intermediate 6 are swept, leaving only the folded 7.
  Test.assert_eq(ir_opt_metric_const_folds(src), 2)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
  Test.assert_eq(ir_opt_metric_const_count(src), 1)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 4 { 1 } else { 0 }, 1)
}

test "ir_optimizer_const_folds_comparison_for_branch_condition" {
  let src = "fn main() -> i64 { if 2 < 3 { 11 } else { 13 } }"
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
}

test "ir_optimizer_folds_constant_branch_from_source" {
  let src = "fn main() -> i64 { if 2 < 3 { 11 } else { 13 } }"
  -- The folded condition constant-folds the branch and jump-chain
  -- merging collapses the function to a single straight-line block.
  Test.assert_eq(ir_opt_metric_branch_term_count(src), 0)
  Test.assert_eq(ir_opt_metric_jump_term_count(src), 0)
}

test "ir_optimizer_inlines_then_folds_literal_call_operand" {
  let src = "fn add_one(x: i64) -> i64 { x + 1 } fn main() -> i64 { add_one(41) }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 1)
  -- The inlined 41+1 folds to 42; the argument const and the cloned
  -- literal 1 die. add_one's own body keeps its binary (param operand).
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(ir_opt_metric_binary_count(src), 1)
  Test.assert_eq(ir_opt_metric_dead_insts(src), 2)
}

test "ir_optimizer_algebraic_folds_zero_mul_and_self_comparison" {
  let src = "fn zero(x: i64) -> i64 { x * 0 + 7 } fn cmp(x: i64) -> i64 { if x == x { 1 } else { 0 } } fn main() -> i64 { zero(9) + cmp(9) }"
  -- cmp's self-comparison folds its branch and jump-chain merging leaves
  -- a single block, so the second candidate pass inlines it too.
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 2)
  Test.assert_eq(if ir_opt_metric_algebraic_folds(src) >= 2 { 1 } else { 0 }, 1)
  -- Multi-block inlining splices cmp before the fold, exposing the
  -- literal argument to the self-comparison; arithmetic folding then
  -- cascades through the 0+7 and the final sum.
  Test.assert_eq(ir_opt_metric_const_folds(src), 5)
  Test.assert_eq(if ir_opt_metric_binary_count(src) <= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_algebraic_folds_sub_self_mod_one_and_bitwise_zero" {
  let sub_ir = pipeline_optimise_ir(ir_opt_metric_same_value_ir(ir_binary_op_from_parser(2)))
  let mod_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(11), 1))
  let band_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(14), 0))
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(sub_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(sub_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(mod_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(mod_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(band_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(band_ir), 2), 0)
}

test "ir_optimizer_rewrites_identity_ops_to_copy_table" {
  let add_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_add(), 0))
  let sub_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(2), 0))
  let mul_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_mul(), 1))
  let div_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(4), 1))
  let shl_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(17), 0))
  let band_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(14), 0 - 1))
  let bor_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(15), 0))
  let bxor_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(16), 0))
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(add_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(add_ir), 2), 0)
  Test.assert_eq(ir_function_list_first_term_return_value_or(pipeline_ir_functions(add_ir), 0 - 1), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(sub_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(sub_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(mul_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(mul_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(div_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(div_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(shl_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(shl_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(band_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(band_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(bor_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(bor_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(bxor_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(bxor_ir), 2), 0)
}

test "ir_optimizer_rewrites_copy_into_call_args" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_copy_into_call_ir())
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(optimised), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 4), 1)
}

test "ir_optimizer_strength_reduces_mul_by_power_of_two" {
  let right_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_mul(), 8))
  let left_ir = pipeline_optimise_ir(ir_opt_metric_const_lhs_param_rhs_ir(ir_binary_op_mul(), 8))
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(right_ir), 1)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(right_ir), ir_binary_op_mul()), 0)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(right_ir), ir_binary_op_from_parser(17)), 1)
  Test.assert_eq(ir_function_list_first_const_value_or(pipeline_ir_functions(right_ir), 0 - 1), 3)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(left_ir), 1)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(left_ir), ir_binary_op_mul()), 0)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(left_ir), ir_binary_op_from_parser(17)), 1)
}

test "ir_optimizer_keeps_non_power_strength_sad_paths" {
  let mul_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_mul(), 3))
  let div_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(4), 8))
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(mul_ir), 0)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(mul_ir), ir_binary_op_mul()), 1)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(mul_ir), ir_binary_op_from_parser(17)), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(div_ir), 0)
  Test.assert_eq(ir_function_list_count_binary_op(pipeline_ir_functions(div_ir), ir_binary_op_from_parser(4)), 1)
}

test "ir_optimizer_identity_and_strength_e2e_semantics" {
  Test.assert_eq(ir_opt_metric_identity_strength_value(5), 45)
  Test.assert_eq(ir_opt_metric_identity_strength_value(0 - 3), 0 - 27)
}

test "ir_optimizer_folds_constant_branch_and_prunes_unreachable_call" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_const_branch_with_call_ir(1))
  let fns = pipeline_ir_functions(optimised)
  Test.assert_eq(ir_function_list_count_term_tag(fns, 3), 0)
  -- jump-chain merging fuses the surviving chain into the entry block
  Test.assert_eq(ir_function_list_count_term_tag(fns, 2), 0)
  Test.assert_eq(ir_function_list_block_count(fns), 1)
  Test.assert_eq(ir_function_list_count_tag(fns, 4), 0)
}

test "ir_optimizer_keeps_chosen_call_after_false_constant_branch" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_const_branch_with_call_ir(0))
  let fns = pipeline_ir_functions(optimised)
  Test.assert_eq(ir_function_list_count_term_tag(fns, 3), 0)
  Test.assert_eq(ir_function_list_block_count(fns), 1)
  Test.assert_eq(ir_function_list_count_tag(fns, 4), 1)
}

test "ir_optimizer_keeps_dynamic_branch_and_reachable_call" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_dynamic_branch_with_call_ir())
  let fns = pipeline_ir_functions(optimised)
  Test.assert_eq(ir_function_list_count_term_tag(fns, 3), 1)
  Test.assert_eq(ir_function_list_block_count(fns), 3)
  Test.assert_eq(ir_function_list_count_tag(fns, 4), 1)
}

test "ir_optimizer_dce_removes_unused_pure_chain" {
  let src = "fn main() -> i64 { let unused = 1 + 2 42 }"
  -- 1+2 folds to 3; the let-bind keeps the folded const live while the
  -- two literal operands die.
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
  Test.assert_eq(ir_opt_metric_const_count(src), 2)
}

test "ir_optimizer_dce_removes_multi_block_unused_pure_chain" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_multi_block_dead_chain_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 3)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
}

test "ir_optimizer_dce_removes_multi_block_unused_pure_call" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main(flag: bool) -> i64 { if flag { let unused = pure_value(41) 11 } else { 13 } }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 0)
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  -- pure_value is a leaf pure call, now inlined at lowering, so no direct
  -- call inst survives to the optimiser (0, was 1 under the old call path).
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_dce_keeps_multi_block_unknown_call" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_multi_block_unknown_call_ir())
  Test.assert_eq(pipeline_ir_pure_call_dce_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 4), 1)
}

test "ir_optimizer_folds_single_predecessor_block_param_constant" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_const_ir())
  -- The single-predecessor const param fact now feeds arithmetic
  -- folding: 2+3 folds, the operand consts die with the trimmed arg,
  -- and only the folded const survives.
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 0)
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 2)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
}

test "ir_optimizer_folds_same_constant_from_multiple_reachable_predecessors" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_two_reachable_pred_ir(4))
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 0)
}

test "ir_optimizer_sccp_repeats_after_reachability_prunes_predecessor" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_two_pred_ir(4))
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 0)
  -- jump-chain merging fuses the surviving predecessor chain
  Test.assert_eq(ir_function_list_block_count(pipeline_ir_functions(optimised)), 1)
}

test "ir_optimizer_keeps_different_reachable_predecessor_constants_dynamic" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_two_reachable_pred_ir(6))
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 1)
}

test "ir_optimizer_sccp_repeated_prune_chain" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_sccp_repeated_prune_ir())
  let fns = pipeline_ir_functions(optimised)
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 2)
  Test.assert_eq(ir_function_list_count_tag(fns, 2), 0)
  Test.assert_eq(ir_function_list_count_term_tag(fns, 3), 0)
  Test.assert_eq(ir_function_list_count_tag(fns, 4), 0)
  -- jump-chain merging collapses the pruned chain to the entry block
  Test.assert_eq(ir_function_list_block_count(fns), 1)
}

test "ir_optimizer_keeps_dynamic_jump_arg_unfolded" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_dynamic_arg_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 1)
}

test "ir_optimizer_rejects_branch_into_param_block_for_const_fact" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_block_param_branch_target_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 1)
  Test.assert_eq(ir_function_list_count_term_tag(pipeline_ir_functions(optimised), 3), 0)
}

test "ir_optimizer_transports_semantic_facts_to_ir" {
  let src = "effect IrOptFactFx { fn get() -> i64 } fn pure_value(x: i64) -> i64 { x + 1 } fn effect_value() -[IrOptFactFx]> i64 { IrOptFactFx.get() } fn main() -> i64 { pure_value(41) }"
  Test.assert_eq(if ir_opt_metric_semantic_facts(src) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(if ir_opt_metric_pure_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if ir_opt_metric_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_match_fact_single_variant_final_ctor" {
  let src = "type IrOptOne { One(i64) } fn main(x: IrOptOne) -> i64 { match x { One(v) -> v } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 1)
}

test "ir_optimizer_match_fact_two_variant_final_remaining_ctor" {
  let src = "type IrOptChoice { Left(i64), Right(i64) } fn main(x: IrOptChoice) -> i64 { match x { Left(v) -> v Right(v) -> v + 1 } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 2)
}

test "ir_optimizer_match_fact_three_variant_table" {
  let src = "type IrOptTriple { First(i64), Second(i64), Third(i64) } fn main(x: IrOptTriple) -> i64 { match x { First(v) -> v Second(v) -> v + 1 Third(v) -> v + 2 } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 3)
}

test "ir_optimizer_match_fact_counts_nested_residual_matches" {
  let src = "type IrOptOuter { OuterA(i64), OuterB(i64) } type IrOptInner { InnerA(i64), InnerB(i64) } fn main(x: IrOptOuter, y: IrOptInner) -> i64 { match x { OuterA(v) -> match y { InnerA(w) -> v + w InnerB(w) -> v - w } OuterB(v) -> v } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 4)
}

test "ir_optimizer_match_fact_ignores_wildcard_residual" {
  let src = "type IrOptWild { WildA(i64), WildB(i64) } fn main(x: IrOptWild) -> i64 { match x { WildA(v) -> v _ -> 0 } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 1)
}

test "ir_optimizer_match_fact_ignores_guarded_fallback_shape" {
  let src = "type IrOptGuard { GuardA(i64), GuardB(i64) } fn main(x: IrOptGuard, flag: bool) -> i64 { match x { GuardA(v) -> v GuardB(v) if flag -> v _ -> 0 } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 2)
}

test "ir_optimizer_match_fact_ignores_int_matches" {
  let src = "fn main(x: i64) -> i64 { match x { 0 -> 1 _ -> 2 } }"
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 0)
}

test "ir_optimizer_inlines_then_dce_removes_unused_pure_direct_call" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main() -> i64 { let unused = pure_value(41) 42 }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 1)
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 2 { 1 } else { 0 }, 1)
}

test "ir_optimizer_inlines_then_dce_removes_multiple_unused_pure_direct_calls" {
  let src = "fn inc(x: i64) -> i64 { x + 1 } fn dec(x: i64) -> i64 { x - 1 } fn main() -> i64 { let a = inc(1) let b = dec(2) 7 }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 2)
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_inlines_duplicate_pure_direct_calls" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main(x: i64) -> i64 { let a = pure_value(x) let b = pure_value(x) a + b }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 2)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
}

test "ir_optimizer_inlines_multiple_duplicate_pure_direct_calls" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main(x: i64) -> i64 { let a = pure_value(x) let b = pure_value(x) let c = pure_value(x) a + b + c }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 3)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_inlines_calls_with_alias_normalized_args" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main(x: i64) -> i64 { let y = x + 0 let a = pure_value(x) let b = pure_value(y) a + b }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 2)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_inlines_pure_direct_calls_with_different_args" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main(x: i64, y: i64) -> i64 { let a = pure_value(x) let b = pure_value(y) a + b }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 2)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_second_pass_inlines_newly_leaf_vector_helper" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn graph_index(nodes: i64, from: i64, to: i64) -> i64 { from * nodes + to } fn graph_has_edge(graph: i64, nodes: i64, from: i64, to: i64) -> i64 { vector_get<i64>(graph, graph_index(nodes, from, to), 0) } fn main(graph: i64, nodes: i64, from: i64, to: i64) -> i64 { graph_has_edge(graph, nodes, from, to) }"
  Test.assert_eq(if ir_opt_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
  Test.assert_eq(ir_opt_metric_vector_get_count(src), 2)
}

test "ir_optimizer_keeps_managed_parameter_cleanup_behind_call_boundary" {
  let fact = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 1, 2, 0)
  let facts = pipeline_ir_semantic_facts_prepend(910, fact, pipeline_ir_semantic_facts_empty())
  let functions = pipeline_ir_functions(ir_opt_metric_managed_param_inline_ir())
  let opt = pipeline_optimise_ir_function_list(functions, functions, facts, 0, 0)
  Test.assert_eq(pipeline_optimised_functions_direct_call_inline_sites(opt), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_optimised_functions_functions(opt), 4), 1)
}

test "ir_optimizer_inlines_pure_intrinsic_float_wrapper" {
  -- Formerly pinned as a limitation (float signatures stayed behind the
  -- call boundary); the pure-intrinsic bridge now inlines the wrapper.
  let src = "fn root(x: f64) -> f64 { __f64_sqrt(x) } fn main(x: f64) -> f64 { root(x) }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 1)
}

test "ir_optimizer_keeps_duplicate_effectful_direct_calls" {
  let src = "effect IrOptCseFx { fn get() -> i64 } fn effect_value(x: i64) -[IrOptCseFx]> i64 { IrOptCseFx.get() + x } fn main(x: i64) -[IrOptCseFx]> i64 { let a = effect_value(x) let b = effect_value(x) a + b }"
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_call_count(src), 2), 1)
  Test.assert_eq(if ir_opt_metric_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_keeps_duplicate_pure_call_with_managed_return_fact" {
  let fact = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 0, 1, 0)
  let facts = pipeline_ir_semantic_facts_prepend(999, fact, pipeline_ir_semantic_facts_empty())
  let functions = pipeline_ir_functions(ir_opt_metric_duplicate_unknown_call_ir())
  let opt = pipeline_optimise_ir_function_list(functions, functions, facts, 0, 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_optimised_functions_functions(opt), 4), 2)
}

test "ir_optimizer_keeps_duplicate_pure_call_across_effectful_barrier" {
  let src = "effect IrOptBarrierFx { fn get() -> i64 } fn pure_value(x: i64) -> i64 { x + 1 } fn effect_value(x: i64) -[IrOptBarrierFx]> i64 { IrOptBarrierFx.get() + x } fn main(x: i64) -[IrOptBarrierFx]> i64 { let a = pure_value(x) let z = effect_value(x) let b = pure_value(x) a + b + z }"
  Test.assert_eq(if ir_opt_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_call_count(src), 1), 1)
}

test "ir_optimizer_inlines_used_pure_direct_call" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main() -> i64 { pure_value(41) }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 1)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_keeps_unused_effectful_direct_call" {
  let src = "effect IrOptKeepFx { fn get() -> i64 } fn effect_value() -[IrOptKeepFx]> i64 { IrOptKeepFx.get() } fn main() -[IrOptKeepFx]> i64 { let unused = effect_value() 42 }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_call_count(src), 1), 1)
  Test.assert_eq(if ir_opt_metric_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_keeps_unknown_call_without_semantic_fact" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_unknown_call_ir())
  Test.assert_eq(pipeline_ir_pure_call_dce_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 4), 1)
}

test "ir_native_emitter_lowers_surviving_scalar_direct_call" {
  -- The recursive arm keeps slow out of both inline candidate sets
  -- (multi-block inlining now takes plain branchy bodies), so a real
  -- scalar call survives to the emitter.
  let src = "fn main() -> i64 { slow(41) } fn slow(x: i64) -> i64 { if x > 0 { x + 1 } else { slow(x + 1) } }"
  Test.assert_eq(ir_opt_metric_direct_call_inlines(src), 0)
  Test.assert_eq(ir_opt_metric_call_count(src), 2)
  Test.assert_eq(if ir_opt_metric_native_ir_emits(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_native_cutover_counts_zero_fallback_scalar_function" {
  let src = "fn main() -> i64 { 42 }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
}

test "ir_native_cutover_emits_simple_if_cfg_without_terminator_fallback" {
  let src = "fn main(x: i64) -> i64 { if x > 0 { x } else { 0 } }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_direct_branches(src), 1)
}

test "ir_native_cutover_lowers_dynamic_cmp_branch_directly" {
  let src = "fn main(x: i64, y: i64) -> i64 { if x < y { x } else { y } }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_direct_branches(src), 1)
}

test "ir_native_cutover_constant_branch_folds_before_direct_branch" {
  let src = "fn main() -> i64 { if 1 == 1 { 11 } else { 13 } }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_direct_branches(src), 0)
}

test "ir_native_cutover_emits_while_loop_cfg" {
  let src = "fn main() -> i64 { let mut i = 0 while i < 3 { i = i + 1 } i }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_direct_branches(src), 1)
}

test "ir_native_cutover_pins_spilled_mutable_slot" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let mut i = 0 while i < 3 { i = i + 1 } i + a + b + c + d + e + f + g + h }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_ir_pinned_slots(src), 1)
  Test.assert_eq(ir_opt_metric_native_ir_loop_pinned_slots(src), 1)
}

test "ir_native_cutover_pins_multiple_spilled_mutable_slots" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let mut i = 0 let mut j = 10 while i < 3 { i = i + 1 j = j + 2 } i + j + a + b + c + d + e + f + g + h }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_ir_pinned_slots(src), 2)
  Test.assert_eq(ir_opt_metric_native_ir_loop_pinned_slots(src), 1)
}

test "ir_native_loop_pin_prioritizes_condition_slot_over_generic_fill" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let mut x = 0 let mut y = 0 let mut z = 0 let mut i = 0 while i < 3 { x = x + 1 y = y + 1 z = z + 1 i = i + 1 } x + y + z + i + a + b + c + d + e + f + g + h }"
  Test.assert_eq(ir_opt_metric_native_ir_candidates(src), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 1), 1)
  Test.assert_eq(ir_opt_metric_native_ir_pinned_slots(src), 3)
  Test.assert_eq(ir_opt_metric_native_ir_loop_pinned_slots(src), 1)
}

fn ir_native_pinned_slot_pressure(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
  let mut i = 0
  while i < 3 {
    i = i + 1
  }
  i + a + b + c + d + e + f + g + h
}

test "ir_native_pinned_slot_runtime_pressure" {
  Test.assert_eq(ir_native_pinned_slot_pressure(1, 2, 3, 4, 5, 6, 7, 8), 39)
}

fn ir_native_multi_pinned_slot_pressure(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
  let mut i = 0
  let mut j = 10
  while i < 3 {
    i = i + 1
    j = j + 2
  }
  i + j + a + b + c + d + e + f + g + h
}

test "ir_native_multi_pinned_slot_runtime_pressure" {
  Test.assert_eq(ir_native_multi_pinned_slot_pressure(1, 2, 3, 4, 5, 6, 7, 8), 55)
}

test "ir_native_cutover_emits_effectful_function_from_ir" {
  let src = "effect IrOptEmitFx { fn get() -> i64 } fn poke() -[IrOptEmitFx]> i64 { IrOptEmitFx.get() } fn main() -> i64 { 42 }"
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_candidates(src), 2), 1)
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 2), 1)
}

test "ir_native_emitter_uses_owner_qualified_method_keys" {
  let src = "type IrOptKeyA { x: i64 } type IrOptKeyB { y: i64 } impl IrOptKeyA { fn same(self: i64) -> i64 { 11 } } impl IrOptKeyB { fn same(self: i64) -> i64 { 31 } } fn main() -> i64 { 42 }"
  Test.assert_eq(ir_opt_metric_count_at_least(ir_opt_metric_native_ir_emits(src), 3), 1)
}

test "ir_optimizer_keeps_duplicate_unknown_call_without_semantic_fact" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_duplicate_unknown_call_ir())
  Test.assert_eq(pipeline_ir_pure_call_dce_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 4), 2)
}

test "ir_optimizer_keeps_division_and_modulo_by_zero_unfolded" {
  let div_ir = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_from_parser(4), 0))
  let mod_ir = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_from_parser(11), 0))
  Test.assert_eq(pipeline_ir_const_fold_sites(div_ir), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(div_ir), 2), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(div_ir), 0)
  Test.assert_eq(pipeline_ir_const_fold_sites(mod_ir), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(mod_ir), 2), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(mod_ir), 0)
}

test "ir_optimizer_sccp_folds_across_basic_block_boundary" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_cross_block_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 2)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 0)
}

test "ir_optimizer_trims_unused_jump_arg_and_block_param" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_jump_arg_conservative_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 3)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_block_param_count(pipeline_ir_functions(optimised)), 0)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(pipeline_ir_functions(optimised), 0 - 1), 0)
}

test "ir_optimizer_keeps_used_jump_arg_and_block_param" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_jump_arg_used_ir())
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 0)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_block_param_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(pipeline_ir_functions(optimised), 0 - 1), 1)
}

test "ir_optimizer_trims_only_dead_params_from_mixed_jump_args" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_jump_arg_mixed_live_ir())
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 1)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_block_param_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(pipeline_ir_functions(optimised), 0 - 1), 1)
}

test "ir_optimizer_keeps_unknown_jump_target_args_conservative" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_jump_arg_unknown_target_ir())
  Test.assert_eq(pipeline_ir_dead_inst_sites(optimised), 0)
  Test.assert_eq(ir_function_list_inst_count(pipeline_ir_functions(optimised)), 1)
  Test.assert_eq(ir_function_list_first_jump_arg_count_or(pipeline_ir_functions(optimised), 0 - 1), 1)
}

test "ir_optimizer_pipeline_optimise_ir_is_idempotent_for_fold_metrics" {
  let once = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_add(), 2))
  let twice = pipeline_optimise_ir(once)
  Test.assert_eq(pipeline_ir_const_fold_sites(once), 1)
  Test.assert_eq(pipeline_ir_const_fold_sites(twice), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(twice), 2), 0)
  Test.assert_eq(pipeline_ir_dead_inst_sites(twice), pipeline_ir_dead_inst_sites(once))
}

test "ir_optimizer_e2e_semantics_stay_visible_to_test_runner" {
  Test.assert_eq(1 + 2 * 3, 7)
  Test.assert_eq(if 2 < 3 { 11 } else { 13 }, 11)
}

test "ir_optimizer_folded_negative_and_wrap_semantics" {
  -- Compile-time folds must match the emitted wrapping arithmetic
  -- exactly: negatives, the i64 boundary, and folded comparisons on
  -- negative operands.
  Test.assert_eq(0 - 1 + 1, 0)
  Test.assert_eq((0 - 65536) * 2, 0 - 131072)
  Test.assert_eq(9223372036854775807 + 1, 0 - 9223372036854775807 - 1)
  Test.assert_eq(if 2 - 3 < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if 0 - 5 >= 0 - 5 { 1 } else { 0 }, 1)
}

type IrOptRuntimeChoice {
  IrOptRuntimeLeft(i64),
  IrOptRuntimeRight(i64)
}

fn ir_opt_runtime_match_final_arm(x: IrOptRuntimeChoice) -> i64 {
  match x {
    IrOptRuntimeLeft(v) -> v
    IrOptRuntimeRight(v) -> v + 10
  }
}

test "ir_optimizer_match_final_arm_e2e_semantics" {
  Test.assert_eq(ir_opt_runtime_match_final_arm(IrOptRuntimeLeft(3)), 3)
  Test.assert_eq(ir_opt_runtime_match_final_arm(IrOptRuntimeRight(3)), 13)
}

