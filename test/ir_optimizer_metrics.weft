fn ir_opt_metric_copy_into_call_ir() -> IrModule {
  let args = ir_value_list_prepend(2, ir_value_list_empty())
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 0),
    ir_inst_list_prepend(
      ir_inst_binary_i64(2, ir_binary_op_add(), 0, 1),
      ir_inst_list_prepend(ir_inst_call_i64(3, 999, args), ir_inst_list_empty())
    )
  )
  let block = ir_block_new_term(0, insts, ir_term_return(3))
  let f = ir_function_new(31, 1, block)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_const_branch_with_call_ir(cond_value: i64) -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, cond_value), ir_inst_list_empty())
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 11), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_call_i64(2, 999, ir_value_list_empty()), ir_inst_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(1))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty())))
  let f = ir_function_new_blocks(32, 0, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_dynamic_branch_with_call_ir() -> IrModule {
  let then_insts = ir_inst_list_prepend(ir_inst_const_i64(1, 11), ir_inst_list_empty())
  let else_insts = ir_inst_list_prepend(ir_inst_call_i64(2, 999, ir_value_list_empty()), ir_inst_list_empty())
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(1))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty())))
  let f = ir_function_new_blocks(33, 1, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_identity_strength_value(x: i64) -> i64 {
  ((x + 0) * 8) + ((x band (0 - 1)) bxor 0)
}

