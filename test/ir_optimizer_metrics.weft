-- test/ir_optimizer_metrics.weft -- metrics for the typed IR optimizer spine

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn ir_opt_metric_optimised(src: str) -> IrModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn ir_opt_metric_functions(src: str) -> IrFunctionList {
  pipeline_ir_functions(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_const_folds(src: str) -> i64 {
  pipeline_ir_const_fold_sites(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_algebraic_folds(src: str) -> i64 {
  pipeline_ir_algebraic_fold_sites(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_dead_insts(src: str) -> i64 {
  pipeline_ir_dead_inst_sites(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_pure_call_dce(src: str) -> i64 {
  pipeline_ir_pure_call_dce_sites(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_match_final_elisions(src: str) -> i64 {
  pipeline_ir_match_final_arm_elision_sites(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_semantic_facts(src: str) -> i64 {
  pipeline_ir_semantic_fact_count(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_pure_facts(src: str) -> i64 {
  pipeline_ir_semantic_pure_fact_count(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_effectful_facts(src: str) -> i64 {
  pipeline_ir_semantic_effectful_fact_count(ir_opt_metric_optimised(src))
}

fn ir_opt_metric_binary_count(src: str) -> i64 {
  ir_function_list_count_tag(ir_opt_metric_functions(src), 2)
}

fn ir_opt_metric_const_count(src: str) -> i64 {
  ir_function_list_count_tag(ir_opt_metric_functions(src), 1)
}

fn ir_opt_metric_call_count(src: str) -> i64 {
  ir_function_list_count_tag(ir_opt_metric_functions(src), 4)
}

fn ir_opt_metric_variant_tag_count(src: str) -> i64 {
  ir_function_list_count_tag(ir_opt_metric_functions(src), 14)
}

fn ir_opt_metric_cross_block_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(ir_inst_const_i64(0, 1), ir_inst_list_empty())
  let exit_insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 2),
    ir_inst_list_prepend(ir_inst_binary_i64(2, ir_binary_op_add(), 0, 1), ir_inst_list_empty())
  )
  let entry = ir_block_new_term(0, entry_insts, ir_term_jump(1))
  let exit = ir_block_new_term(1, exit_insts, ir_term_return(2))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let f = ir_function_new_blocks(1, 0, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_direct_ir(op: IrBinaryOp, rhs: i64) -> IrModule {
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 8),
    ir_inst_list_prepend(
      ir_inst_const_i64(1, rhs),
      ir_inst_list_prepend(ir_inst_binary_i64(2, op, 0, 1), ir_inst_list_empty())
    )
  )
  let block = ir_block_new_term(0, insts, ir_term_return(2))
  let f = ir_function_new(2, 0, block)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_param_rhs_ir(op: IrBinaryOp, rhs: i64) -> IrModule {
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, rhs),
    ir_inst_list_prepend(ir_inst_binary_i64(2, op, 0, 1), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(2))
  let f = ir_function_new(3, 1, block)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_same_value_ir(op: IrBinaryOp) -> IrModule {
  let insts = ir_inst_list_prepend(ir_inst_binary_i64(1, op, 0, 0), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(1))
  let f = ir_function_new(4, 1, block)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

fn ir_opt_metric_unknown_call_ir() -> IrModule {
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(0, 42),
    ir_inst_list_prepend(ir_inst_call_i64(1, 999, ir_value_list_empty()), ir_inst_list_empty())
  )
  let block = ir_block_new_term(0, insts, ir_term_return(0))
  let f = ir_function_new(5, 0, block)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

test "ir_optimizer_const_folds_happy_arithmetic_table" {
  let add = "fn main() -> i64 { 2 + 3 }"
  let sub = "fn main() -> i64 { 7 - 4 }"
  let mul = "fn main() -> i64 { 6 * 7 }"
  Test.assert_eq(ir_opt_metric_const_folds(add), 1)
  Test.assert_eq(ir_opt_metric_binary_count(add), 0)
  Test.assert_eq(ir_opt_metric_const_folds(sub), 1)
  Test.assert_eq(ir_opt_metric_binary_count(sub), 0)
  Test.assert_eq(ir_opt_metric_const_folds(mul), 1)
  Test.assert_eq(ir_opt_metric_binary_count(mul), 0)
}

test "ir_optimizer_const_folds_nested_expression" {
  let src = "fn main() -> i64 { 1 + 2 * 3 }"
  Test.assert_eq(ir_opt_metric_const_folds(src), 2)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
  Test.assert_eq(ir_opt_metric_const_count(src), 1)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 4 { 1 } else { 0 }, 1)
}

test "ir_optimizer_const_folds_comparison_for_branch_condition" {
  let src = "fn main() -> i64 { if 2 < 3 { 11 } else { 13 } }"
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
}

test "ir_optimizer_keeps_dynamic_operand_unfolded" {
  let src = "fn add_one(x: i64) -> i64 { x + 1 } fn main() -> i64 { add_one(41) }"
  Test.assert_eq(ir_opt_metric_const_folds(src), 0)
  Test.assert_eq(ir_opt_metric_binary_count(src), 1)
  Test.assert_eq(ir_opt_metric_dead_insts(src), 0)
}

test "ir_optimizer_algebraic_folds_zero_mul_and_self_comparison" {
  let src = "fn zero(x: i64) -> i64 { x * 0 + 7 } fn cmp(x: i64) -> i64 { if x == x { 1 } else { 0 } } fn main() -> i64 { zero(9) + cmp(9) }"
  Test.assert_eq(if ir_opt_metric_algebraic_folds(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(if ir_opt_metric_binary_count(src) <= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_algebraic_folds_sub_self_mod_one_and_bitwise_zero" {
  let sub_ir = pipeline_optimise_ir(ir_opt_metric_same_value_ir(ir_binary_op_from_parser(2)))
  let mod_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(11), 1))
  let band_ir = pipeline_optimise_ir(ir_opt_metric_param_rhs_ir(ir_binary_op_from_parser(14), 0))
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(sub_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(sub_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(mod_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(mod_ir), 2), 0)
  Test.assert_eq(pipeline_ir_algebraic_fold_sites(band_ir), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(band_ir), 2), 0)
}

test "ir_optimizer_dce_removes_unused_pure_chain" {
  let src = "fn main() -> i64 { let unused = 1 + 2 42 }"
  Test.assert_eq(ir_opt_metric_const_folds(src), 1)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_opt_metric_binary_count(src), 0)
  Test.assert_eq(ir_opt_metric_const_count(src), 2)
}

test "ir_optimizer_transports_semantic_facts_to_ir" {
  let src = "effect IrOptFactFx { fn get() -> i64 } fn pure_value(x: i64) -> i64 { x + 1 } fn effect_value() -[IrOptFactFx]> i64 { IrOptFactFx.get() } fn main() -> i64 { pure_value(41) }"
  Test.assert_eq(if ir_opt_metric_semantic_facts(src) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(if ir_opt_metric_pure_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if ir_opt_metric_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_match_fact_single_variant_final_ctor" {
  let src = "type IrOptOne { One(i64) } fn main(x: IrOptOne) -> i64 { match x { One(v) -> v } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 1)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 0)
}

test "ir_optimizer_match_fact_two_variant_final_remaining_ctor" {
  let src = "type IrOptChoice { Left(i64), Right(i64) } fn main(x: IrOptChoice) -> i64 { match x { Left(v) -> v Right(v) -> v + 1 } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 1)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 1)
}

test "ir_optimizer_match_fact_three_variant_table" {
  let src = "type IrOptTriple { First(i64), Second(i64), Third(i64) } fn main(x: IrOptTriple) -> i64 { match x { First(v) -> v Second(v) -> v + 1 Third(v) -> v + 2 } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 1)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 2)
}

test "ir_optimizer_match_fact_counts_nested_residual_matches" {
  let src = "type IrOptOuter { OuterA(i64), OuterB(i64) } type IrOptInner { InnerA(i64), InnerB(i64) } fn main(x: IrOptOuter, y: IrOptInner) -> i64 { match x { OuterA(v) -> match y { InnerA(w) -> v + w InnerB(w) -> v - w } OuterB(v) -> v } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 2)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 2)
}

test "ir_optimizer_match_fact_ignores_wildcard_residual" {
  let src = "type IrOptWild { WildA(i64), WildB(i64) } fn main(x: IrOptWild) -> i64 { match x { WildA(v) -> v _ -> 0 } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 0)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 1)
}

test "ir_optimizer_match_fact_ignores_guarded_fallback_shape" {
  let src = "type IrOptGuard { GuardA(i64), GuardB(i64) } fn main(x: IrOptGuard, flag: bool) -> i64 { match x { GuardA(v) -> v GuardB(v) if flag -> v _ -> 0 } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 0)
  Test.assert_eq(ir_opt_metric_variant_tag_count(src), 2)
}

test "ir_optimizer_match_fact_ignores_int_matches" {
  let src = "fn main(x: i64) -> i64 { match x { 0 -> 1 _ -> 2 } }"
  Test.assert_eq(ir_opt_metric_match_final_elisions(src), 0)
}

test "ir_optimizer_dce_removes_unused_pure_direct_call" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main() -> i64 { let unused = pure_value(41) 42 }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 1)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
  Test.assert_eq(if ir_opt_metric_dead_insts(src) >= 2 { 1 } else { 0 }, 1)
}

test "ir_optimizer_dce_removes_multiple_unused_pure_direct_calls" {
  let src = "fn inc(x: i64) -> i64 { x + 1 } fn dec(x: i64) -> i64 { x - 1 } fn main() -> i64 { let a = inc(1) let b = dec(2) 7 }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 2)
  Test.assert_eq(ir_opt_metric_call_count(src), 0)
}

test "ir_optimizer_keeps_used_pure_direct_call" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn main() -> i64 { pure_value(41) }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_call_count(src), 1)
}

test "ir_optimizer_keeps_unused_effectful_direct_call" {
  let src = "effect IrOptKeepFx { fn get() -> i64 } fn effect_value() -[IrOptKeepFx]> i64 { IrOptKeepFx.get() } fn main() -[IrOptKeepFx]> i64 { let unused = effect_value() 42 }"
  Test.assert_eq(ir_opt_metric_pure_call_dce(src), 0)
  Test.assert_eq(ir_opt_metric_call_count(src), 1)
  Test.assert_eq(if ir_opt_metric_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "ir_optimizer_keeps_unknown_call_without_semantic_fact" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_unknown_call_ir())
  Test.assert_eq(pipeline_ir_pure_call_dce_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 4), 1)
}

test "ir_optimizer_keeps_division_and_modulo_by_zero_unfolded" {
  let div_ir = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_from_parser(4), 0))
  let mod_ir = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_from_parser(11), 0))
  Test.assert_eq(pipeline_ir_const_fold_sites(div_ir), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(div_ir), 2), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(div_ir), 0)
  Test.assert_eq(pipeline_ir_const_fold_sites(mod_ir), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(mod_ir), 2), 1)
  Test.assert_eq(pipeline_ir_dead_inst_sites(mod_ir), 0)
}

test "ir_optimizer_does_not_fold_across_basic_block_boundary_yet" {
  let optimised = pipeline_optimise_ir(ir_opt_metric_cross_block_ir())
  Test.assert_eq(pipeline_ir_const_fold_sites(optimised), 0)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(optimised), 2), 1)
}

test "ir_optimizer_pipeline_optimise_ir_is_idempotent_for_fold_metrics" {
  let once = pipeline_optimise_ir(ir_opt_metric_direct_ir(ir_binary_op_add(), 2))
  let twice = pipeline_optimise_ir(once)
  Test.assert_eq(pipeline_ir_const_fold_sites(once), 1)
  Test.assert_eq(pipeline_ir_const_fold_sites(twice), 1)
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(twice), 2), 0)
  Test.assert_eq(pipeline_ir_dead_inst_sites(twice), pipeline_ir_dead_inst_sites(once))
}

test "ir_optimizer_e2e_semantics_stay_visible_to_test_runner" {
  Test.assert_eq(1 + 2 * 3, 7)
  Test.assert_eq(if 2 < 3 { 11 } else { 13 }, 11)
}

type IrOptRuntimeChoice {
  IrOptRuntimeLeft(i64),
  IrOptRuntimeRight(i64)
}

fn ir_opt_runtime_match_final_arm(x: IrOptRuntimeChoice) -> i64 {
  match x {
    IrOptRuntimeLeft(v) -> v
    IrOptRuntimeRight(v) -> v + 10
  }
}

test "ir_optimizer_match_final_arm_e2e_semantics" {
  Test.assert_eq(ir_opt_runtime_match_final_arm(IrOptRuntimeLeft(3)), 3)
  Test.assert_eq(ir_opt_runtime_match_final_arm(IrOptRuntimeRight(3)), 13)
}
