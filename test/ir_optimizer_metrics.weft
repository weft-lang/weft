-- Two-pred shapes: jump-chain merging substitutes single-pred params
-- away entirely, so the trimmer probes route both branch arms through
-- the param block (function param 0 is the dynamic condition).
fn ir_opt_metric_jump_arg_conservative_ir() -> IrModule {
  let entry_insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 1),
    ir_inst_list_prepend(
      ir_inst_const_i64(2, 2),
      ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 1, 2), ir_inst_list_empty())
    )
  )
  let exit_params = ir_value_list_prepend(9, ir_value_list_empty())
  let exit_insts = ir_inst_list_prepend(ir_inst_const_i64(4, 7), ir_inst_list_empty())
  let jump_args = ir_value_list_prepend(3, ir_value_list_empty())
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(0, 1, 2))
  let left = ir_block_new_term(1, ir_inst_list_empty(), ir_term_jump_args(3, jump_args))
  let right = ir_block_new_term(2, ir_inst_list_empty(), ir_term_jump_args(3, jump_args))
  let exit = ir_block_new_params(3, exit_params, exit_insts, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(left, ir_block_list_prepend(right, ir_block_list_prepend(exit, ir_block_list_empty()))))
  let f = ir_function_new_blocks(8, 1, blocks)
  pipeline_ir_module(ir_function_list_prepend(f, ir_function_list_empty()))
}

