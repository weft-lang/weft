use compiler/ir/data.{*}
use stdlib/diagnostic/schema.{Diagnose}
use compiler/storage.{*}
use compiler/weft/lex.{lex}
use compiler/weft/parse.{parse_pattern}
use stdlib/string

fn pattern_origin_matches(left: IntegerPatternOrigin, right: IntegerPatternOrigin) -> bool {
  match (left, right) {
    (NumericPatternOrigin, NumericPatternOrigin) -> true
    (BooleanPatternOrigin, BooleanPatternOrigin) -> true
    _ -> false
  }
}

test "literal pattern transport retains spelling origin and source range" {
  for origin in [NumericPatternOrigin, BooleanPatternOrigin] {
    let transported = IntPattern(1, 12, 4, origin) |> pattern_to_node() |> pattern_from_node()
    match transported {
      IntPattern(value, start, len, actual) -> {
        Test.assert_eq(value, 1)
        Test.assert_eq(start, 12)
        Test.assert_eq(len, 4)
        Test.assert_true(pattern_origin_matches(actual, origin))
      }
      _ -> Test.assert_true(false)
    }
  }
}

test "parsing distinguishes booleans from context-polymorphic numeric patterns" {
  for (text, expected, origin) in [
    ("true", 1, BooleanPatternOrigin), ("false", 0, BooleanPatternOrigin),
    ("1", 1, NumericPatternOrigin), ("0x01", 1, NumericPatternOrigin),
    ("0b00", 0, NumericPatternOrigin), ("0_0", 0, NumericPatternOrigin)
  ] {
    let src = __str_ptr(text)
    let tokens = lex(src, __str_len(text))
    let raw = handle parse_pattern(tokens, src, 0) {
      Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
      Diagnose.error(message, span) -> { Test.assert_true(false); resume(0) }
      Diagnose.warn(message, span) -> resume(0)
      Diagnose.note(message, span) -> resume(0)
    }
    match raw |> unpack_node() |> pattern_from_node() {
      IntPattern(value, start, len, actual) -> {
        Test.assert_eq(value, expected)
        Test.assert_eq(start, 0)
        Test.assert_eq(len, __str_len(text))
        Test.assert_true(pattern_origin_matches(actual, origin))
      }
      _ -> Test.assert_true(false)
    }
  }
}

fn match_boolean_integer(value: i64) -> i64 {
  match value { true -> 10, false -> 20, _ -> 30 }
}

fn match_nested_boolean_integer(value: (i64, bool)) -> i64 {
  match value {
    (true, false) -> 10
    (false, true) if true -> 20
    _ -> 30
  }
}

test "boolean patterns match exactly their values within bool and i64" {
  Test.assert_eq(match_boolean_integer(1), 10)
  Test.assert_eq(match_boolean_integer(0), 20)
  Test.assert_eq(match_boolean_integer(2), 30)
  Test.assert_eq(match_nested_boolean_integer((1, false)), 10)
  Test.assert_eq(match_nested_boolean_integer((0, true)), 20)
  Test.assert_eq(match_nested_boolean_integer((1, true)), 30)
  for value in [false, true] {
    Test.assert_eq(match value { false -> 0, true -> 1 }, if value { 1 } else { 0 })
  }
}
