use runtime/rc.{rc_count}
use stdlib/string
use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}
effect CompletionTick { fn tick() -> nil }

type CompletionTextResource { text: str, log: F64Table }
impl Drop for CompletionTextResource {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    nil
  }
}
fn completion_text_resource(log: F64Table) -> owned CompletionTextResource {
  CompletionTextResource { text: "resource ".concat("field"), log: log }
}
fn completion_owned_field(log: F64Table) -> str {
  handle completion_text_resource(log) {
    CompletionTick.tick() -> resume(nil)
    return resource -> resource.text
  }
}

test "a completion preserves a resource field before running its owner's Drop" {
  let log = table.filled(1, 1, 0.0).unwrap()
  let value = completion_owned_field(log)
  Test.assert_str_eq(value, "resource field")
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_discard_owned(original: str, log: F64Table) -> nil {
  let resource: owned CompletionTextResource = CompletionTextResource { text: original, log: log }
  nil
}

test "dropping an ordinary owned binding releases its managed fields" {
  let original = "unreturned ".concat("resource field")
  let log = table.filled(1, 1, 0.0).unwrap()
  completion_discard_owned(original, log)
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn drop(value: CompletionTextResource) -> usize { value.text.len() }

test "an ordinary function named drop leaves resource destruction at its owning scope" {
  let original = "ordinary ".concat("function")
  let log = table.filled(1, 1, 0.0).unwrap()
  {
    let resource = CompletionTextResource { text: original, log: log }
    Test.assert_true(drop(resource) == 17)
    Test.assert_true(log.get(0, 0).unwrap() == 0.0)
  }
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

type GenericBacking<T> { GenericBacking(T, F64Table) }
impl<T> Drop for GenericBacking<T> {
  fn drop(self) -> nil {
    match self {
      GenericBacking(payload, log) -> { log.set(0, 0, log.get(0, 0).unwrap() + 1.0) nil }
    }
  }
}
fn generic_backing<T>(value: T, log: F64Table) -> owned GenericBacking<T> {
  GenericBacking<T>(value, log)
}
fn discard_generic_backing<T>(value: T, log: F64Table) -> nil {
  let resource = generic_backing(value, log)
  nil
}

test "generic destructors release the backing selected by their concrete self type" {
  let original = "generic ".concat("resource")
  let log = table.filled(1, 1, 0.0).unwrap()
  discard_generic_backing(original, log)
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

type BackingPair { first: owned CompletionTextResource, second: owned CompletionTextResource }
fn discard_backing_pair(value: str, log: F64Table) -> nil {
  let pair = BackingPair {
    first: CompletionTextResource { text: value, log: log },
    second: CompletionTextResource { text: value, log: log }
  }
  nil
}

test "structural resource cleanup releases each leaf's managed backing" {
  let original = "shared ".concat("fields")
  let log = table.filled(1, 1, 0.0).unwrap()
  discard_backing_pair(original, log)
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

effect BackingStop { fn stop() -> never }
effect BackingPause { @deferred fn pause() -> nil }

fn abort_backing(original: str, log: F64Table) -[BackingStop]> nil {
  let resource: owned CompletionTextResource = CompletionTextResource { text: original, log: log }
  BackingStop.stop()
}

test "abort cleanup consumes a resource backing after invoking Drop" {
  let original = "aborted ".concat("resource")
  let log = table.filled(1, 1, 0.0).unwrap()
  handle abort_backing(original, log) { BackingStop.stop() -> nil }
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn paused_backing(original: str, log: F64Table) -[BackingPause]> nil {
  let resource: owned CompletionTextResource = CompletionTextResource { text: original, log: log }
  BackingPause.pause()
}

test "resumption and continuation drop consume the same resource backing" {
  let original = "suspended ".concat("resource")
  let log = table.filled(1, 1, 0.0).unwrap()
  for should_resume in [false, true] {
    handle paused_backing(original, log) {
      BackingPause.pause() with k -> if should_resume { k(nil) } else { nil }
    }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}

type AbortingBacking { text: str, log: F64Table }
impl Drop for AbortingBacking {
  fn drop(self) -[BackingStop]> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    BackingStop.stop()
  }
}
fn abort_during_drop(original: str, log: F64Table) -[BackingStop]> nil {
  let resource: owned AbortingBacking = AbortingBacking { text: original, log: log }
  nil
}

test "a destructor that aborts still releases its consumed managed receiver" {
  let original = "aborting ".concat("destructor")
  let log = table.filled(1, 1, 0.0).unwrap()
  handle abort_during_drop(original, log) { BackingStop.stop() -> nil }
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn explicit_aborting_drop(original: str, log: F64Table) -[BackingStop]> nil {
  let resource = AbortingBacking { text: original, log: log }
  resource.drop()
}

test "an explicit destructor call transfers only its managed argument stake before abort" {
  let original = "explicit ".concat("destructor")
  let log = table.filled(1, 1, 0.0).unwrap()
  handle explicit_aborting_drop(original, log) { BackingStop.stop() -> nil }
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}


type WideBacking = opaque(str, str, F64Table)
impl Drop for WideBacking {
  fn drop(self) -[BackingStop]> nil {
    match self { WideBacking((first, second, log)) -> {
      log.set(0, 0, log.get(0, 0).unwrap() + 1.0)
      BackingStop.stop()
    } }
  }
}
fn discard_wide_backing(first: str, second: str, log: F64Table) -[BackingStop]> nil {
  let resource: owned WideBacking = WideBacking((first, second, log))
  nil
}
fn explicit_wide_backing(first: str, second: str, log: F64Table) -[BackingStop]> nil {
  let resource = WideBacking((first, second, log))
  resource.drop()
}

test "an aborting destructor owns every managed lane of an inline receiver" {
  let first = "first ".concat("lane")
  let second = "second ".concat("lane")
  let log = table.filled(1, 1, 0.0).unwrap()
  handle discard_wide_backing(first, second, log) { BackingStop.stop() -> nil }
  Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
  Test.assert_eq(rc_count(__str_ptr(second) - 16), 1)
  handle explicit_wide_backing(first, second, log) { BackingStop.stop() -> nil }
  Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
  Test.assert_eq(rc_count(__str_ptr(second) - 16), 1)
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}

type SuspendingBacking { text: str, log: F64Table }
impl Drop for SuspendingBacking {
  fn drop(self) -[BackingPause]> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    BackingPause.pause()
  }
}
fn suspend_during_drop(original: str, log: F64Table) -[BackingPause]> nil {
  let resource: owned SuspendingBacking = SuspendingBacking { text: original, log: log }
  nil
}

test "suspension within Drop preserves backing cleanup through resume and discard" {
  let original = "destructor ".concat("suspension")
  let log = table.filled(1, 1, 0.0).unwrap()
  for should_resume in [false, true] {
    handle suspend_during_drop(original, log) {
      BackingPause.pause() with k -> if should_resume { k(nil) } else { nil }
    }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}


type NormalWideBacking = opaque(str, str, F64Table)
impl Drop for NormalWideBacking {
  fn drop(self) -> nil {
    match self { NormalWideBacking((first, second, log)) -> {
      log.set(0, 0, log.get(0, 0).unwrap() + 1.0)
      nil
    } }
  }
}
fn wide_backing_exit(first: str, second: str, log: F64Table, stop: bool) -[BackingStop]> nil {
  let resource: owned NormalWideBacking = NormalWideBacking((first, second, log))
  if stop { BackingStop.stop() } else { nil }
}
fn wide_backing_pause(first: str, second: str, log: F64Table) -[BackingPause]> nil {
  let resource: owned NormalWideBacking = NormalWideBacking((first, second, log))
  BackingPause.pause()
}

test "wide resource cleanup keeps all lanes through normal and aborted scopes" {
  let first = "wide ".concat("first")
  let second = "wide ".concat("second")
  let log = table.filled(1, 1, 0.0).unwrap()
  for stop in [false, true] {
    handle wide_backing_exit(first, second, log, stop) { BackingStop.stop() -> nil }
    Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
    Test.assert_eq(rc_count(__str_ptr(second) - 16), 1)
  }
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}

test "continuations snapshot and release every wide resource lane" {
  let first = "suspended ".concat("first")
  let second = "suspended ".concat("second")
  let log = table.filled(1, 1, 0.0).unwrap()
  for should_resume in [false, true] {
    handle wide_backing_pause(first, second, log) {
      BackingPause.pause() with k -> if should_resume { k(nil) } else { nil }
    }
    Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
    Test.assert_eq(rc_count(__str_ptr(second) - 16), 1)
  }
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}

type NestedWideBacking { resource: owned NormalWideBacking }
fn replace_wide_backing(first: str, second: str, log: F64Table) -> nil {
  let mut resource: owned NormalWideBacking = NormalWideBacking((first, second, log))
  resource = NormalWideBacking((second, first, log))
  let nested = NestedWideBacking { resource: resource }
  nil
}

test "mutable and nested resources preserve the full destructor receiver" {
  let first = "nested ".concat("first")
  let second = "nested ".concat("second")
  let log = table.filled(1, 1, 0.0).unwrap()
  replace_wide_backing(first, second, log)
  Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
  Test.assert_eq(rc_count(__str_ptr(second) - 16), 1)
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}


test "equal pointers in a wide resource remain separate ownership stakes" {
  let original = "aliased ".concat("lanes")
  let log = table.filled(1, 1, 0.0).unwrap()
  for stop in [false, true] {
    handle wide_backing_exit(original, original, log, stop) { BackingStop.stop() -> nil }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
  Test.assert_true(log.get(0, 0).unwrap() == 2.0)
}

type TextBacking = opaque str
impl Drop for TextBacking { fn drop(self) -> nil { nil } }
fn text_backing_exit(original: str, stop: bool) -[BackingStop]> nil {
  let resource: owned TextBacking = TextBacking(original)
  if stop { BackingStop.stop() } else { nil }
}

test "single-lane opaque resources consume their managed representation exactly once" {
  let original = "opaque ".concat("text")
  for stop in [false, true] {
    handle text_backing_exit(original, stop) { BackingStop.stop() -> nil }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
}
