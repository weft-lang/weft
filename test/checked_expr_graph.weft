-- Immutable checked-expression products retain exact semantic identities.

use compiler/project/identity.{
  DeclarationIdentity,
  ModuleIdentity,
  ModuleDeclarationIdentity,
  ModuleFunctionIdentity,
  TypeDeclaration,
  anonymous_module_identity_in_package,
  named_module_identity
}
use compiler/project/identity/equality.{
  declaration_identity_eq,
  function_identity_eq,
  module_identity_eq
}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticBool,
  SemanticI64,
  SemanticNil,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_graph_contains,
  semantic_type_id_eq,
  semantic_type_id_from_ordinal,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  SemanticTypeCatalogInserted,
  semantic_type_catalog_builder,
  semantic_type_catalog_single
}
use compiler/weft/check/body/graph.{*}
use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn checked_types(module: ModuleIdentity) -> SemanticTypeCatalog {
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (builder, _) = builder.primitive(SemanticI64)
  let (builder, _) = builder.primitive(SemanticBool)
  let (builder, _) = builder.primitive(SemanticNil)
  semantic_type_catalog_single(builder.freeze())
}

fn integer_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 0)
}

fn boolean_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 1)
}

fn nil_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 2)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn declaration(module: ModuleIdentity) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    module,
    TypeDeclaration,
    source_from_text("Number").all()
  )
}

fn kind_code(kind: CheckedExprKind) -> i64 {
  match kind {
    CheckedIntegerKind -> 1
    CheckedBooleanKind -> 2
    CheckedNilKind -> 3
    CheckedLocalReferenceKind -> 4
    CheckedDeclarationReferenceKind -> 5
    CheckedNotKind -> 6
    CheckedNegateKind -> 7
    CheckedBinaryKind -> 8
    CheckedIfKind -> 9
    CheckedBlockKind -> 10
    CheckedLetKind -> 11
    CheckedLetMutKind -> 12
    CheckedAssignKind -> 13
    CheckedWhileKind -> 14
    CheckedLoopKind -> 15
    CheckedBreakKind -> 16
    CheckedBreakNoValueKind -> 17
    CheckedContinueKind -> 18
    CheckedReturnKind -> 19
    CheckedReturnNoValueKind -> 20
    CheckedDeferKind -> 21
  }
}

test "checked scalar nodes retain exact types ranges and values" {
  let module = named_module_identity("fixture/checked", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("12 true nil"),
    catalog,
    3
  )
  let (builder, integer) = builder.integer(12, integer_type, range(0, 2))
  let (builder, boolean) = builder.boolean(true, boolean_type, range(3, 7))
  let (builder, nil_value) = builder.nil(nil_type, range(8, 11))
  let graph = builder.freeze()

  Test.assert_eq_usize(graph.len(), 3)
  Test.assert_eq(graph.integer_value(integer), 12)
  Test.assert_true(graph.boolean_value(boolean))
  Test.assert_true(semantic_type_id_eq(graph.result_type(integer), integer_type))
  Test.assert_true(semantic_type_id_eq(graph.result_type(boolean), boolean_type))
  Test.assert_true(semantic_type_id_eq(graph.result_type(nil_value), nil_type))
  Test.assert_eq_usize(graph.range(integer).start, 0)
  Test.assert_eq_usize(graph.range(integer).end, 2)
  Test.assert_true(match graph.inspect(nil_value).node { CheckedNilNode -> true, _ -> false })
}

test "checked expression topology points only to preceding nodes" {
  let module = named_module_identity("fixture/topology", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1 + 2"),
    catalog,
    3
  )
  let (builder, left) = builder.integer(1, integer_type, range(0, 1))
  let (builder, right) = builder.integer(2, integer_type, range(4, 5))
  let (builder, sum) = builder.binary(
    CheckedAdd,
    left,
    right,
    integer_type,
    range(0, 5)
  )
  let graph = builder.freeze()

  Test.assert_true(checked_expr_id_eq(graph.binary_left(sum), left))
  Test.assert_true(checked_expr_id_eq(graph.binary_right(sum), right))
  Test.assert_true(match graph.binary_operator(sum) { CheckedAdd -> true, _ -> false })
  Test.assert_true(
    match graph.inspect(sum).node {
      CheckedBinaryNode(CheckedAdd, inspected_left, inspected_right) ->
        checked_expr_id_eq(inspected_left, left) and checked_expr_id_eq(inspected_right, right)
      _ -> false
    }
  )
}

test "checked bindings retain owner type range and mutability" {
  let module = named_module_identity("fixture/bindings", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("let mut x = 1; x"),
    catalog,
    3
  )
  let (builder, binding) = builder.binding(
    function,
    integer_type,
    range(8, 9),
    CheckedMutableBinding
  )
  let (builder, value) = builder.integer(1, integer_type, range(12, 13))
  let (builder, reference) = builder.local_reference(binding, integer_type, range(15, 16))
  let (builder, let_expr) = builder.let_mut_expr(
    binding,
    value,
    reference,
    integer_type,
    range(0, 16)
  )
  let graph = builder.function(function, let_expr).freeze()
  let checked_binding = graph.binding(binding)
  let checked_function = graph.function(0)

  Test.assert_eq_usize(graph.binding_len(), 1)
  Test.assert_eq_usize(graph.function_len(), 1)
  Test.assert_true(function_identity_eq(checked_binding.owner, function))
  Test.assert_true(semantic_type_id_eq(checked_binding.value_type, integer_type))
  Test.assert_true(
    match checked_binding.mutability { CheckedMutableBinding -> true, _ -> false }
  )
  Test.assert_true(checked_binding_id_eq(graph.local_binding(reference), binding))
  Test.assert_true(function_identity_eq(checked_function.identity, function))
  Test.assert_true(checked_expr_id_eq(checked_function.root, let_expr))
  Test.assert_true(
    match graph.let_mut_parts(let_expr) {
      (found_binding, found_value, found_body) ->
        checked_binding_id_eq(found_binding, binding) and
        checked_expr_id_eq(found_value, value) and checked_expr_id_eq(found_body, reference)
    }
  )
}

test "checked control nodes preserve complete child structure" {
  let module = named_module_identity("fixture/control", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("if true { 1 } else { 2 }"),
    catalog,
    8
  )
  let (builder, condition) = builder.boolean(true, boolean_type, range(3, 7))
  let (builder, then_branch) = builder.integer(1, integer_type, range(10, 11))
  let (builder, else_branch) = builder.integer(2, integer_type, range(21, 22))
  let (builder, conditional) = builder.if_expr(
    condition,
    then_branch,
    else_branch,
    integer_type,
    range(0, 24)
  )
  let (builder, returned) = builder.return_expr(
    conditional,
    nil_type,
    range(0, 24)
  )
  let (builder, cleanup) = builder.nil(nil_type, range(24, 24))
  let (builder, deferred) = builder.defer_expr(
    cleanup,
    returned,
    nil_type,
    range(0, 24)
  )
  let graph = builder.freeze()

  Test.assert_true(checked_expr_id_eq(graph.if_condition(conditional), condition))
  Test.assert_true(checked_expr_id_eq(graph.if_then(conditional), then_branch))
  Test.assert_true(checked_expr_id_eq(graph.if_else(conditional), else_branch))
  Test.assert_true(checked_expr_id_eq(graph.return_value(returned), conditional))
  Test.assert_true(checked_expr_id_eq(graph.defer_cleanup(deferred), cleanup))
  Test.assert_true(checked_expr_id_eq(graph.defer_body(deferred), returned))
}

test "checked expression segments retain nominal module identity" {
  let first_module = named_module_identity("fixture/same", 71)
  let second_module = named_module_identity("fixture/same", 72)
  let first_types = checked_types(first_module)
  let second_types = checked_types(second_module)
  let first_builder = checked_expr_graph_builder(
    first_module,
    source_from_text("nil"),
    first_types,
    1
  )
  let second_builder = checked_expr_graph_builder(
    second_module,
    source_from_text("nil"),
    second_types,
    1
  )
  let (first_builder, first) = first_builder.nil(nil_type(first_module), range(0, 3))
  let (second_builder, second) = second_builder.nil(nil_type(second_module), range(0, 3))
  let first_graph = first_builder.freeze()
  let second_graph = second_builder.freeze()

  Test.assert_true(not checked_expr_id_eq(first, second))
  Test.assert_true(first_graph.contains(first))
  Test.assert_true(not first_graph.contains(second))
  Test.assert_true(second_graph.contains(second))
  Test.assert_true(
    not module_identity_eq(
      checked_expr_segment_module(first_graph.segment()),
      checked_expr_segment_module(second_graph.segment())
    )
  )
}

test "checked declaration references retain imported declaration identity" {
  let module = named_module_identity("fixture/references", 71)
  let imported_module = named_module_identity("dependency/types", 44)
  let imported = declaration(imported_module)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("Number"),
    catalog,
    1
  )
  let (builder, reference) = builder.declaration_reference(
    imported,
    integer_type,
    range(0, 6)
  )
  let graph = builder.freeze()

  Test.assert_true(declaration_identity_eq(graph.declaration(reference), imported))
  Test.assert_true(
    match graph.inspect(reference).node {
      CheckedDeclarationReferenceNode(found) -> declaration_identity_eq(found, imported)
      _ -> false
    }
  )
}

test "checked graph owns the semantic catalog used by result ids" {
  let module = anonymous_module_identity_in_package(8, 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1"),
    catalog,
    1
  )
  let (builder, value) = builder.integer(1, integer_type, range(0, 1))
  let graph = builder.freeze()
  let types = graph.types()

  Test.assert_true(
    match types.graph_for(graph.result_type(value)) {
      Some(type_graph) -> semantic_type_graph_contains(type_graph, integer_type)
      _ -> false
    }
  )
}

test "checked scalar control and binding kinds are structurally complete" {
  let module = named_module_identity("fixture/all_checked_kinds", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    21
  )
  let (builder, immutable) = builder.binding(
    function,
    integer_type,
    range(0, 0),
    CheckedImmutableBinding
  )
  let (builder, mutable) = builder.binding(
    function,
    integer_type,
    range(0, 0),
    CheckedMutableBinding
  )
  let (builder, integer) = builder.integer(1, integer_type, range(0, 0))
  let (builder, boolean) = builder.boolean(true, boolean_type, range(0, 0))
  let (builder, nil_value) = builder.nil(nil_type, range(0, 0))
  let (builder, local) = builder.local_reference(immutable, integer_type, range(0, 0))
  let (builder, declared) = builder.declaration_reference(
    declaration(module),
    integer_type,
    range(0, 0)
  )
  let (builder, not_value) = builder.not_expr(boolean, boolean_type, range(0, 0))
  let (builder, negated) = builder.negate(integer, integer_type, range(0, 0))
  let (builder, binary) = builder.binary(
    CheckedAdd,
    integer,
    negated,
    integer_type,
    range(0, 0)
  )
  let (builder, conditional) = builder.if_expr(
    boolean,
    integer,
    binary,
    integer_type,
    range(0, 0)
  )
  let (builder, block) = builder.block(integer, conditional, integer_type, range(0, 0))
  let (builder, let_value) = builder.let_expr(
    immutable,
    integer,
    local,
    integer_type,
    range(0, 0)
  )
  let (builder, let_mut_value) = builder.let_mut_expr(
    mutable,
    integer,
    local,
    integer_type,
    range(0, 0)
  )
  let (builder, assigned) = builder.assign(mutable, integer, nil_type, range(0, 0))
  let (builder, while_value) = builder.while_expr(
    boolean,
    assigned,
    nil_type,
    range(0, 0)
  )
  let (builder, loop_value) = builder.loop_expr(while_value, nil_type, range(0, 0))
  let (builder, break_value) = builder.break_expr(integer, nil_type, range(0, 0))
  let (builder, break_none) = builder.break_no_value(nil_type, range(0, 0))
  let (builder, continue_value) = builder.continue_expr(nil_type, range(0, 0))
  let (builder, returned) = builder.return_expr(integer, nil_type, range(0, 0))
  let (builder, return_none) = builder.return_no_value(nil_type, range(0, 0))
  let (builder, deferred) = builder.defer_expr(nil_value, returned, nil_type, range(0, 0))
  let graph = builder.function(function, deferred).freeze()

  Test.assert_eq(kind_code(graph.kind(integer)), 1)
  Test.assert_eq(kind_code(graph.kind(boolean)), 2)
  Test.assert_eq(kind_code(graph.kind(nil_value)), 3)
  Test.assert_eq(kind_code(graph.kind(local)), 4)
  Test.assert_eq(kind_code(graph.kind(declared)), 5)
  Test.assert_eq(kind_code(graph.kind(not_value)), 6)
  Test.assert_eq(kind_code(graph.kind(negated)), 7)
  Test.assert_eq(kind_code(graph.kind(binary)), 8)
  Test.assert_eq(kind_code(graph.kind(conditional)), 9)
  Test.assert_eq(kind_code(graph.kind(block)), 10)
  Test.assert_eq(kind_code(graph.kind(let_value)), 11)
  Test.assert_eq(kind_code(graph.kind(let_mut_value)), 12)
  Test.assert_eq(kind_code(graph.kind(assigned)), 13)
  Test.assert_eq(kind_code(graph.kind(while_value)), 14)
  Test.assert_eq(kind_code(graph.kind(loop_value)), 15)
  Test.assert_eq(kind_code(graph.kind(break_value)), 16)
  Test.assert_eq(kind_code(graph.kind(break_none)), 17)
  Test.assert_eq(kind_code(graph.kind(continue_value)), 18)
  Test.assert_eq(kind_code(graph.kind(returned)), 19)
  Test.assert_eq(kind_code(graph.kind(return_none)), 20)
  Test.assert_eq(kind_code(graph.kind(deferred)), 21)
  Test.assert_eq_usize(graph.len(), 21)
}

test "checked result references retain imported semantic segments" {
  let module = named_module_identity("fixture/importing", 71)
  let dependency = named_module_identity("dependency/types", 44)
  let dependency_builder = semantic_type_graph_builder(semantic_type_segment_id(dependency))
  let (dependency_builder, imported_integer) = dependency_builder.primitive(SemanticI64)
  let dependency_graph = dependency_builder.freeze()
  let local_builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (local_builder, _) = local_builder.primitive(SemanticNil)
  let local_graph = local_builder.freeze()
  let catalog_builder = semantic_type_catalog_builder(2)
  let catalog_builder = match catalog_builder.insert(dependency_graph) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected dependency semantic segment")
  }
  let catalog_builder = match catalog_builder.insert(local_graph) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected local semantic segment")
  }
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1"),
    catalog_builder.freeze(),
    1
  )
  let (builder, value) = builder.integer(1, imported_integer, range(0, 1))
  let graph = builder.freeze()

  Test.assert_true(semantic_type_id_eq(graph.result_type(value), imported_integer))
}
