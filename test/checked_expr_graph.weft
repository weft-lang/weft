-- Immutable checked-expression products retain exact semantic identities.

use compiler/project/identity.{
  DeclarationIdentity,
  DeclaredFunctionIdentity,
  ConstructorDeclaration,
  InherentMethodDeclaration,
  MemberDeclarationIdentity,
  ModuleIdentity,
  ModuleDeclarationIdentity,
  ModuleFunctionIdentity,
  RecordFieldDeclaration,
  TypeDeclaration,
  ValueDeclaration,
  anonymous_module_identity_in_package,
  named_module_identity
}
use compiler/project/identity/equality.{
  declaration_identity_eq,
  function_identity_eq,
  module_identity_eq
}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticBool,
  SemanticF64,
  SemanticI64,
  SemanticNil,
  SemanticStr,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_graph_contains,
  semantic_type_id_eq,
  semantic_type_id_from_ordinal,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  SemanticTypeCatalogInserted,
  semantic_type_catalog_builder,
  semantic_type_catalog_single
}
use compiler/weft/check/body/graph.{*}
use stdlib/list as list
use stdlib/option as option
use stdlib/option.{Some}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn checked_types(module: ModuleIdentity) -> SemanticTypeCatalog {
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (builder, _) = builder.primitive(SemanticI64)
  let (builder, _) = builder.primitive(SemanticBool)
  let (builder, _) = builder.primitive(SemanticNil)
  let (builder, _) = builder.primitive(SemanticStr)
  let (builder, _) = builder.primitive(SemanticF64)
  semantic_type_catalog_single(builder.freeze())
}

fn integer_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 0)
}

fn boolean_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 1)
}

fn nil_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 2)
}

fn string_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 3)
}

fn float_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 4)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn declaration(module: ModuleIdentity) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    module,
    TypeDeclaration,
    source_from_text("Number").all()
  )
}

fn kind_code(kind: CheckedExprKind) -> i64 {
  match kind {
    CheckedIntegerKind -> 1
    CheckedBooleanKind -> 2
    CheckedNilKind -> 3
    CheckedStringKind -> 22
    CheckedFloatKind -> 23
    CheckedLocalReferenceKind -> 4
    CheckedSharedBorrowKind -> 49
    CheckedExclusiveBorrowKind -> 50
    CheckedDeclarationReferenceKind -> 5
    CheckedNotKind -> 6
    CheckedNegateKind -> 7
    CheckedBinaryKind -> 8
    CheckedIfKind -> 9
    CheckedBlockKind -> 10
    CheckedLetKind -> 11
    CheckedLetMutKind -> 12
    CheckedAssignKind -> 13
    CheckedWhileKind -> 14
    CheckedLoopKind -> 15
    CheckedBreakKind -> 16
    CheckedBreakNoValueKind -> 17
    CheckedContinueKind -> 18
    CheckedReturnKind -> 19
    CheckedDeferKind -> 21
    CheckedDirectCallKind -> 24
    CheckedConstructorCallKind -> 25
    CheckedApplyKind -> 26
    CheckedGenericCallKind -> 27
    CheckedMethodCallKind -> 28
    CheckedAssociatedCallKind -> 55
    CheckedAddressOfKind -> 29
    CheckedDerefKind -> 30
    CheckedPointerAssignKind -> 31
    CheckedInterpolationConcatKind -> 54
    CheckedDeclaredFieldAccessKind -> 32
    CheckedStructuralFieldAccessKind -> 33
    CheckedIndexedLengthKind -> 34
    CheckedIndexedGetKind -> 35
    CheckedIndexedSetKind -> 36
    CheckedIndexedSliceKind -> 37
    CheckedRecordInitKind -> 38
    CheckedRecordUpdateKind -> 39
    CheckedArrayLiteralKind -> 40
    CheckedLambdaKind -> 44
    CheckedPerformKind -> 45
    CheckedHandleKind -> 46
    CheckedResumeKind -> 47
    CheckedHandlerInstallKind -> 48
    CheckedFailurePropagationKind -> 51
    CheckedDeclaredOptionalProjectionKind -> 52
    CheckedStructuralOptionalProjectionKind -> 53
    CheckedExplicitMatchKind -> 41
    CheckedLetDestructuringKind -> 42
    CheckedForDestructuringKind -> 43
  }
}

test "checked scalar nodes retain exact types ranges and values" {
  let module = named_module_identity("fixture/checked", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("12 true nil"),
    catalog,
    3
  )
  let (builder, integer) = builder.integer(12, integer_type, range(0, 2))
  let (builder, boolean) = builder.boolean(true, boolean_type, range(3, 7))
  let (builder, nil_value) = builder.nil(nil_type, range(8, 11))
  let graph = builder.freeze()

  Test.assert_eq_usize(graph.len(), 3)
  Test.assert_eq(graph.integer_value(integer), 12)
  Test.assert_true(graph.boolean_value(boolean))
  Test.assert_true(semantic_type_id_eq(graph.result_type(integer), integer_type))
  Test.assert_true(semantic_type_id_eq(graph.result_type(boolean), boolean_type))
  Test.assert_true(semantic_type_id_eq(graph.result_type(nil_value), nil_type))
  Test.assert_eq_usize(graph.range(integer).start, 0)
  Test.assert_eq_usize(graph.range(integer).end, 2)
  Test.assert_true(match graph.inspect(nil_value).node { CheckedNilNode -> true, _ -> false })
}

test "checked expression topology points only to preceding nodes" {
  let module = named_module_identity("fixture/topology", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1 + 2"),
    catalog,
    3
  )
  let (builder, left) = builder.integer(1, integer_type, range(0, 1))
  let (builder, right) = builder.integer(2, integer_type, range(4, 5))
  let (builder, sum) = builder.binary(
    CheckedAdd,
    left,
    right,
    integer_type,
    range(0, 5)
  )
  let graph = builder.freeze()

  Test.assert_true(checked_expr_id_eq(graph.binary_left(sum), left))
  Test.assert_true(checked_expr_id_eq(graph.binary_right(sum), right))
  Test.assert_true(match graph.binary_operator(sum) { CheckedAdd -> true, _ -> false })
  Test.assert_true(
    match graph.inspect(sum).node {
      CheckedBinaryNode(CheckedAdd, inspected_left, inspected_right) ->
        checked_expr_id_eq(inspected_left, left) and checked_expr_id_eq(inspected_right, right)
      _ -> false
    }
  )
}

test "checked interpolation concat retains ordered string children" {
  let module = named_module_identity("fixture/interpolation_graph", 71)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("i\"a{value}b\""),
    checked_types(module),
    3
  )
  let (builder, left) = builder.string("a", string_type(module), range(2, 3))
  let (builder, right) = builder.string("b", string_type(module), range(10, 11))
  let (builder, combined) = builder.interpolation_concat(
    left,
    right,
    string_type(module),
    range(2, 11)
  )
  let graph = builder.freeze()

  Test.assert_eq(kind_code(graph.kind(combined)), 54)
  match graph.interpolation_concat_parts(combined) {
    (first, second) -> {
      Test.assert_true(checked_expr_id_eq(first, left))
      Test.assert_true(checked_expr_id_eq(second, right))
    }
  }
  Test.assert_true(
    match graph.inspect(combined).node {
      CheckedInterpolationConcatNode(first, second) ->
        checked_expr_id_eq(first, left) and checked_expr_id_eq(second, right)
      _ -> false
    }
  )
  Test.assert_eq_usize(graph.range(combined).start, 2)
  Test.assert_eq_usize(graph.range(combined).end, 11)
}

test "checked binary and pair payloads remain independent when interleaved" {
  let module = named_module_identity("fixture/interleaved_branches", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    6
  )
  let (builder, first) = builder.integer(1, integer_type, range(0, 0))
  let (builder, rest) = builder.integer(2, integer_type, range(0, 0))
  let (builder, block) = builder.block(first, rest, integer_type, range(0, 0))
  let (builder, left) = builder.integer(3, integer_type, range(0, 0))
  let (builder, right) = builder.integer(4, integer_type, range(0, 0))
  let (builder, sum) = builder.binary(
    CheckedAdd,
    left,
    right,
    integer_type,
    range(0, 0)
  )
  let graph = builder.freeze()

  Test.assert_true(checked_expr_id_eq(graph.block_first(block), first))
  Test.assert_true(checked_expr_id_eq(graph.block_rest(block), rest))
  Test.assert_true(checked_expr_id_eq(graph.binary_left(sum), left))
  Test.assert_true(checked_expr_id_eq(graph.binary_right(sum), right))
}

test "checked bindings retain owner type range and mutability" {
  let module = named_module_identity("fixture/bindings", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("let mut x = 1; x"),
    catalog,
    3
  )
  let (builder, binding) = builder.binding(
    function,
    integer_type,
    range(8, 9),
    CheckedMutableBinding
  )
  let (builder, value) = builder.integer(1, integer_type, range(12, 13))
  let (builder, reference) = builder.local_reference(binding, integer_type, range(15, 16))
  let (builder, shared_borrow) = builder.borrow_reference(
    binding,
    false,
    integer_type,
    range(15, 16)
  )
  let (builder, exclusive_borrow) = builder.borrow_reference(
    binding,
    true,
    integer_type,
    range(15, 16)
  )
  let (builder, let_expr) = builder.let_mut_expr(
    binding,
    value,
    reference,
    integer_type,
    range(0, 16)
  )
  let graph = builder.function(function, let_expr).freeze()
  let checked_binding = graph.binding(binding)
  let checked_function = graph.function(0)

  Test.assert_eq_usize(graph.binding_len(), 1)
  Test.assert_eq_usize(graph.function_len(), 1)
  Test.assert_true(function_identity_eq(checked_binding.owner, function))
  Test.assert_true(semantic_type_id_eq(checked_binding.value_type, integer_type))
  Test.assert_true(
    match checked_binding.mutability { CheckedMutableBinding -> true, _ -> false }
  )
  Test.assert_true(checked_binding_id_eq(graph.local_binding(reference), binding))
  Test.assert_true(
    match graph.borrow_parts(shared_borrow) {
      (found, exclusive) -> checked_binding_id_eq(found, binding) and not exclusive
    }
  )
  Test.assert_true(
    match graph.borrow_parts(exclusive_borrow) {
      (found, exclusive) -> checked_binding_id_eq(found, binding) and exclusive
    }
  )
  Test.assert_true(
    match graph.inspect(shared_borrow).node {
      CheckedBorrowNode(found, false) -> checked_binding_id_eq(found, binding)
      _ -> false
    }
  )
  Test.assert_true(function_identity_eq(checked_function.identity, function))
  Test.assert_true(checked_expr_id_eq(checked_function.root, let_expr))
  Test.assert_true(
    match graph.let_mut_parts(let_expr) {
      (found_binding, found_value, found_body) ->
        checked_binding_id_eq(found_binding, binding) and
        checked_expr_id_eq(found_value, value) and checked_expr_id_eq(found_body, reference)
    }
  )
}

test "checked graph capture marks collect exact outer binding references" {
  let module = named_module_identity("fixture/capture_marks", 1231)
  let function = ModuleFunctionIdentity(module, 0)
  let integer = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("abcdefghijklmnop"),
    checked_types(module),
    8
  )
  let (builder, first) = builder.binding(function, integer, range(0, 1), CheckedMutableBinding)
  let (builder, second) = builder.binding(function, integer, range(1, 2), CheckedImmutableBinding)
  let (builder, prior_only) = builder.binding(
    function,
    integer,
    range(2, 3),
    CheckedImmutableBinding
  )
  let (builder, _) = builder.local_reference(prior_only, integer, range(2, 3))
  let expression_mark = builder.len()
  let binding_mark = builder.binding_len()
  let (builder, local) = builder.binding(function, integer, range(3, 4), CheckedImmutableBinding)
  let (builder, reference) = builder.local_reference(first, integer, range(4, 5))
  let (builder, _) = builder.local_reference(local, integer, range(5, 6))
  let (builder, _) = builder.borrow_reference(second, false, integer, range(6, 7))
  let (builder, _) = builder.assign(first, reference, integer, range(7, 8))
  let captures = builder.outer_references_since(expression_mark, binding_mark)
  Test.assert_eq_usize(captures.len(), 2)
  Test.assert_true(checked_binding_id_eq(captures.get(0).unwrap(), first))
  Test.assert_true(checked_binding_id_eq(captures.get(1).unwrap(), second))
}

test "checked functions retain ordered parameter binding identities" {
  let module = named_module_identity("fixture/function_parameters", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("left right"),
    catalog,
    1
  )
  let (builder, left) = builder.binding(
    function,
    integer_type,
    range(0, 4),
    CheckedImmutableBinding
  )
  let (builder, right) = builder.binding(
    function,
    integer_type,
    range(5, 10),
    CheckedImmutableBinding
  )
  let builder = builder.function_parameter(left).function_parameter(right)
  let (builder, root) = builder.local_reference(right, integer_type, range(5, 10))
  let graph = builder.function(function, root).freeze()
  let checked_function = graph.function(0)

  Test.assert_eq_usize(
    graph.function_parameter_count(checked_function.parameters),
    2
  )
  Test.assert_true(
    checked_binding_id_eq(
      graph.function_parameter(checked_function.parameters, 0),
      left
    )
  )
  Test.assert_true(
    checked_binding_id_eq(
      graph.function_parameter(checked_function.parameters, 1),
      right
    )
  )
}

test "checked control nodes preserve complete child structure" {
  let module = named_module_identity("fixture/control", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("if true { 1 } else { 2 }"),
    catalog,
    8
  )
  let (builder, condition) = builder.boolean(true, boolean_type, range(3, 7))
  let (builder, then_branch) = builder.integer(1, integer_type, range(10, 11))
  let (builder, else_branch) = builder.integer(2, integer_type, range(21, 22))
  let (builder, conditional) = builder.if_expr(
    condition,
    then_branch,
    else_branch,
    integer_type,
    range(0, 24)
  )
  let (builder, returned) = builder.return_expr(
    conditional,
    nil_type,
    range(0, 24)
  )
  let (builder, cleanup) = builder.nil(nil_type, range(24, 24))
  let (builder, deferred) = builder.defer_expr(
    cleanup,
    returned,
    0,
    nil_type,
    range(0, 24)
  )
  let graph = builder.freeze()

  Test.assert_true(checked_expr_id_eq(graph.if_condition(conditional), condition))
  Test.assert_true(checked_expr_id_eq(graph.if_then(conditional), then_branch))
  Test.assert_true(checked_expr_id_eq(graph.if_else(conditional), else_branch))
  Test.assert_true(checked_expr_id_eq(graph.return_value(returned), conditional))
  Test.assert_true(checked_expr_id_eq(graph.defer_cleanup(deferred), cleanup))
  Test.assert_true(checked_expr_id_eq(graph.defer_body(deferred), returned))
}

test "checked expression segments retain nominal module identity" {
  let first_module = named_module_identity("fixture/same", 71)
  let second_module = named_module_identity("fixture/same", 72)
  let first_types = checked_types(first_module)
  let second_types = checked_types(second_module)
  let first_builder = checked_expr_graph_builder(
    first_module,
    source_from_text("nil"),
    first_types,
    1
  )
  let second_builder = checked_expr_graph_builder(
    second_module,
    source_from_text("nil"),
    second_types,
    1
  )
  let (first_builder, first) = first_builder.nil(nil_type(first_module), range(0, 3))
  let (second_builder, second) = second_builder.nil(nil_type(second_module), range(0, 3))
  let first_graph = first_builder.freeze()
  let second_graph = second_builder.freeze()

  Test.assert_true(not checked_expr_id_eq(first, second))
  Test.assert_true(first_graph.contains(first))
  Test.assert_true(not first_graph.contains(second))
  Test.assert_true(second_graph.contains(second))
  Test.assert_true(
    not module_identity_eq(
      checked_expr_segment_module(first_graph.segment()),
      checked_expr_segment_module(second_graph.segment())
    )
  )
}

test "checked expression specializations of one module retain distinct identities" {
  let module = named_module_identity("fixture/specialized_handler", 71)
  let authored = checked_expr_segment_id(module)
  let first_segment = checked_expr_specialization_segment_id(module, 1)
  let second_segment = checked_expr_specialization_segment_id(module, 2)
  let source = source_from_text("nil")
  let types = checked_types(module)
  let first_builder = checked_expr_graph_builder_in_segment(first_segment, source, types, 1)
  let second_builder = checked_expr_graph_builder_in_segment(second_segment, source, types, 1)
  let (first_builder, first) = first_builder.nil(nil_type(module), range(0, 3))
  let (second_builder, second) = second_builder.nil(nil_type(module), range(0, 3))
  let first_graph = first_builder.freeze()
  let second_graph = second_builder.freeze()

  Test.assert_true(not checked_expr_segment_id_eq(authored, first_segment))
  Test.assert_true(not checked_expr_segment_id_eq(first_segment, second_segment))
  Test.assert_true(
    module_identity_eq(checked_expr_segment_module(first_segment), module)
  )
  Test.assert_true(first_graph.contains(first))
  Test.assert_true(not first_graph.contains(second))
  Test.assert_true(second_graph.contains(second))
  Test.assert_true(not second_graph.contains(first))
}

test "checked declaration references retain imported declaration identity" {
  let module = named_module_identity("fixture/references", 71)
  let imported_module = named_module_identity("dependency/types", 44)
  let imported = declaration(imported_module)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("Number"),
    catalog,
    1
  )
  let (builder, reference) = builder.declaration_reference(
    imported,
    integer_type,
    range(0, 6)
  )
  let graph = builder.freeze()

  Test.assert_true(declaration_identity_eq(graph.declaration(reference), imported))
  Test.assert_true(
    match graph.inspect(reference).node {
      CheckedDeclarationReferenceNode(found) -> declaration_identity_eq(found, imported)
      _ -> false
    }
  )
}

test "checked graph owns the semantic catalog used by result ids" {
  let module = anonymous_module_identity_in_package(8, 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1"),
    catalog,
    1
  )
  let (builder, value) = builder.integer(1, integer_type, range(0, 1))
  let graph = builder.freeze()
  let types = graph.types()

  Test.assert_true(
    match types.graph_for(graph.result_type(value)) {
      Some(type_graph) -> semantic_type_graph_contains(type_graph, integer_type)
      _ -> false
    }
  )
}

test "checked scalar control and binding kinds are structurally complete" {
  let module = named_module_identity("fixture/all_checked_kinds", 71)
  let function = ModuleFunctionIdentity(module, 0)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let boolean_type = boolean_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    21
  )
  let (builder, immutable) = builder.binding(
    function,
    integer_type,
    range(0, 0),
    CheckedImmutableBinding
  )
  let (builder, mutable) = builder.binding(
    function,
    integer_type,
    range(0, 0),
    CheckedMutableBinding
  )
  let (builder, integer) = builder.integer(1, integer_type, range(0, 0))
  let (builder, boolean) = builder.boolean(true, boolean_type, range(0, 0))
  let (builder, nil_value) = builder.nil(nil_type, range(0, 0))
  let (builder, local) = builder.local_reference(immutable, integer_type, range(0, 0))
  let (builder, declared) = builder.declaration_reference(
    declaration(module),
    integer_type,
    range(0, 0)
  )
  let (builder, not_value) = builder.not_expr(boolean, boolean_type, range(0, 0))
  let (builder, negated) = builder.negate(integer, integer_type, range(0, 0))
  let (builder, binary) = builder.binary(
    CheckedAdd,
    integer,
    negated,
    integer_type,
    range(0, 0)
  )
  let (builder, conditional) = builder.if_expr(
    boolean,
    integer,
    binary,
    integer_type,
    range(0, 0)
  )
  let (builder, block) = builder.block(integer, conditional, integer_type, range(0, 0))
  let (builder, let_value) = builder.let_expr(
    immutable,
    integer,
    local,
    integer_type,
    range(0, 0)
  )
  let (builder, let_mut_value) = builder.let_mut_expr(
    mutable,
    integer,
    local,
    integer_type,
    range(0, 0)
  )
  let (builder, assigned) = builder.assign(mutable, integer, nil_type, range(0, 0))
  let (builder, while_value) = builder.while_expr(
    boolean,
    assigned,
    nil_type,
    range(0, 0)
  )
  let (builder, loop_value) = builder.loop_expr(while_value, nil_type, range(0, 0))
  let (builder, break_value) = builder.break_expr(integer, nil_type, range(0, 0))
  let (builder, break_none) = builder.break_no_value(nil_type, range(0, 0))
  let (builder, continue_value) = builder.continue_expr(nil_type, range(0, 0))
  let (builder, returned) = builder.return_expr(integer, nil_type, range(0, 0))
  let (builder, deferred) = builder.defer_expr(
    nil_value,
    returned,
    9,
    nil_type,
    range(0, 0)
  )
  let graph = builder.function(function, deferred).freeze()

  Test.assert_eq(kind_code(graph.kind(integer)), 1)
  Test.assert_eq(kind_code(graph.kind(boolean)), 2)
  Test.assert_eq(kind_code(graph.kind(nil_value)), 3)
  Test.assert_eq(kind_code(graph.kind(local)), 4)
  Test.assert_eq(kind_code(graph.kind(declared)), 5)
  Test.assert_eq(kind_code(graph.kind(not_value)), 6)
  Test.assert_eq(kind_code(graph.kind(negated)), 7)
  Test.assert_eq(kind_code(graph.kind(binary)), 8)
  Test.assert_eq(kind_code(graph.kind(conditional)), 9)
  Test.assert_eq(kind_code(graph.kind(block)), 10)
  Test.assert_eq(kind_code(graph.kind(let_value)), 11)
  Test.assert_eq(kind_code(graph.kind(let_mut_value)), 12)
  Test.assert_eq(kind_code(graph.kind(assigned)), 13)
  Test.assert_eq(kind_code(graph.kind(while_value)), 14)
  Test.assert_eq(kind_code(graph.kind(loop_value)), 15)
  Test.assert_eq(kind_code(graph.kind(break_value)), 16)
  Test.assert_eq(kind_code(graph.kind(break_none)), 17)
  Test.assert_eq(kind_code(graph.kind(continue_value)), 18)
  Test.assert_eq(kind_code(graph.kind(returned)), 19)
  Test.assert_eq(kind_code(graph.kind(deferred)), 21)
  Test.assert_eq_usize(graph.defer_source_site(deferred), 9)
  Test.assert_true(
    match graph.inspect(deferred).node {
      CheckedDeferNode(cleanup, body, source_site) ->
        checked_expr_id_eq(cleanup, nil_value) and
        checked_expr_id_eq(body, returned) and source_site == 9
      _ -> false
    }
  )
  Test.assert_eq_usize(graph.len(), 20)
}

test "checked result references retain imported semantic segments" {
  let module = named_module_identity("fixture/importing", 71)
  let dependency = named_module_identity("dependency/types", 44)
  let dependency_builder = semantic_type_graph_builder(semantic_type_segment_id(dependency))
  let (dependency_builder, imported_integer) = dependency_builder.primitive(SemanticI64)
  let dependency_graph = dependency_builder.freeze()
  let local_builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (local_builder, _) = local_builder.primitive(SemanticNil)
  let local_graph = local_builder.freeze()
  let catalog_builder = semantic_type_catalog_builder(2)
  let catalog_builder = match catalog_builder.insert(dependency_graph) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected dependency semantic segment")
  }
  let catalog_builder = match catalog_builder.insert(local_graph) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected local semantic segment")
  }
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("1"),
    catalog_builder.freeze(),
    1
  )
  let (builder, value) = builder.integer(1, imported_integer, range(0, 1))
  let graph = builder.freeze()

  Test.assert_true(semantic_type_id_eq(graph.result_type(value), imported_integer))
}

test "checked calls retain flattened arguments and exact callee identities" {
  let module = named_module_identity("fixture/calls", 71)
  let dependency = named_module_identity("dependency/calls", 44)
  let function_declaration = ModuleDeclarationIdentity(
    dependency,
    ValueDeclaration,
    source_from_text("compute").all()
  )
  let function = DeclaredFunctionIdentity(function_declaration)
  let owner = declaration(dependency)
  let constructor = MemberDeclarationIdentity(
    owner,
    ConstructorDeclaration,
    source_from_text("Number").all()
  )
  let method = MemberDeclarationIdentity(
    owner,
    InherentMethodDeclaration,
    source_from_text("increment").all()
  )
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let string_type = string_type(module)
  let float_type = float_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    9
  )
  let (builder, integer) = builder.integer(7, integer_type, range(0, 0))
  let (builder, string) = builder.string("seven", string_type, range(0, 0))
  let (builder, float) = builder.float(7.5, float_type, range(0, 0))
  let (builder, arguments) = builder.expression_list()
  let (builder, arguments) = builder.expression_list_push(arguments, integer)
  let (builder, arguments) = builder.expression_list_push(arguments, string)
  let (builder, arguments) = builder.finish_expression_list(arguments)
  let (builder, types) = builder.type_list()
  let (builder, types) = builder.type_list_push(types, integer_type)
  let (builder, types) = builder.type_list_push(types, string_type)
  let (builder, types) = builder.finish_type_list(types)
  let (builder, direct) = builder.direct_call(
    function,
    arguments,
    integer_type,
    range(0, 0)
  )
  let (builder, constructed) = builder.constructor_call(
    constructor,
    arguments,
    integer_type,
    range(0, 0)
  )
  let (builder, callee) = builder.declaration_reference(
    function_declaration,
    integer_type,
    range(0, 0)
  )
  let (builder, applied) = builder.apply(
    callee,
    arguments,
    float_type,
    77,
    integer_type,
    range(0, 0)
  )
  let (builder, generic) = builder.generic_call(applied, types, integer_type, range(0, 0))
  let (builder, method_call) = builder.method_call(
    method,
    integer,
    arguments,
    float_type,
    integer_type,
    range(0, 0)
  )
  let graph = builder.freeze()

  Test.assert_str_eq(graph.string_value(string), "seven")
  Test.assert_true(graph.float_value(float) == 7.5)
  Test.assert_eq_usize(graph.expression_list_len(arguments), 2)
  Test.assert_true(checked_expr_id_eq(graph.expression_list_at(arguments, 0), integer))
  Test.assert_true(checked_expr_id_eq(graph.expression_list_at(arguments, 1), string))
  Test.assert_eq_usize(graph.type_list_len(types), 2)
  Test.assert_true(semantic_type_id_eq(graph.type_list_at(types, 0), integer_type))
  Test.assert_true(semantic_type_id_eq(graph.type_list_at(types, 1), string_type))
  Test.assert_true(
    match graph.direct_call_parts(direct) {
      (found, found_arguments) -> function_identity_eq(found, function) and
        graph.expression_list_len(found_arguments) == 2
    }
  )
  Test.assert_true(
    match graph.constructor_call_parts(constructed) {
      (found, _) -> declaration_identity_eq(found, constructor)
    }
  )
  Test.assert_true(
    match graph.apply_parts(applied) {
      (found, _, signature, source_site) ->
        checked_expr_id_eq(found, callee) and
        semantic_type_id_eq(signature, float_type) and source_site == 77
    }
  )
  Test.assert_true(
    match graph.inspect(applied).node {
      CheckedApplyNode(found, _, signature, 77) ->
        checked_expr_id_eq(found, callee) and semantic_type_id_eq(signature, float_type)
      _ -> false
    }
  )
  Test.assert_true(
    match graph.generic_call_parts(generic) {
      (found, found_types) -> checked_expr_id_eq(found, applied) and
        graph.type_list_len(found_types) == 2
    }
  )
  Test.assert_true(
    match graph.method_call_parts(method_call) {
      (found, receiver, _, signature) -> declaration_identity_eq(found, method) and
        checked_expr_id_eq(receiver, integer) and
        semantic_type_id_eq(signature, float_type)
    }
  )
  Test.assert_eq(kind_code(graph.kind(direct)), 24)
  Test.assert_eq(kind_code(graph.kind(method_call)), 28)
}

test "checked aggregates retain field layouts and semantic element types" {
  let module = named_module_identity("fixture/aggregates", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let owner = declaration(module)
  let field = MemberDeclarationIdentity(
    owner,
    RecordFieldDeclaration,
    source_from_text("value").all()
  )
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    9
  )
  let (builder, first) = builder.integer(1, integer_type, range(0, 0))
  let (builder, second) = builder.integer(2, integer_type, range(0, 0))
  let (builder, fields) = builder.record_field_list()
  let (builder, fields) = builder.declared_record_field(
    fields,
    field,
    first,
    0,
    integer_type
  )
  let (builder, fields) = builder.finish_record_field_list(fields)
  let (builder, structural_fields) = builder.record_field_list()
  let (builder, structural_fields) = builder.structural_record_field(
    structural_fields,
    99,
    second,
    CheckedRecordFieldWordOffset(1),
    integer_type
  )
  let (builder, structural_fields) = builder.structural_record_field(
    structural_fields,
    100,
    first,
    CheckedRecordFieldOrdinal(1),
    integer_type
  )
  let (builder, structural_fields) = builder.finish_record_field_list(structural_fields)
  let (builder, tuple_fields) = builder.record_field_list()
  let (builder, tuple_fields) = builder.positional_record_field(
    tuple_fields,
    0,
    first,
    integer_type
  )
  let (builder, tuple_fields) = builder.finish_record_field_list(tuple_fields)
  let (builder, record) = builder.record_init(
    CheckedDeclaredRecordConstruction(owner),
    fields,
    integer_type,
    range(0, 0)
  )
  let (builder, structural_record) = builder.record_init(
    CheckedStructuralRecordConstruction,
    structural_fields,
    integer_type,
    range(0, 0)
  )
  let (builder, tuple_record) = builder.record_init(
    CheckedTupleRecordConstruction,
    tuple_fields,
    integer_type,
    range(0, 0)
  )
  let (builder, updated) = builder.record_update(
    record,
    fields,
    integer_type,
    range(0, 0)
  )
  let (builder, elements) = builder.expression_list()
  let (builder, elements) = builder.expression_list_push(elements, first)
  let (builder, elements) = builder.expression_list_push(elements, second)
  let (builder, elements) = builder.finish_expression_list(elements)
  let (builder, array) = builder.array_literal(
    elements,
    integer_type,
    integer_type,
    range(0, 0)
  )
  let graph = builder.freeze()
  let declared = graph.record_field_list_at(fields, 0)
  let structural = graph.record_field_list_at(structural_fields, 0)
  let deferred_structural = graph.record_field_list_at(structural_fields, 1)
  let positional = graph.record_field_list_at(tuple_fields, 0)

  Test.assert_eq_usize(graph.record_field_list_len(fields), 1)
  Test.assert_true(
    match declared.declaration {
      found: DeclarationIdentity -> declaration_identity_eq(found, field)
      nil -> false
    }
  )
  Test.assert_true(
    match declared.position {
      CheckedRecordFieldOrdinal(0) -> true
      _ -> false
    }
  )
  Test.assert_true(checked_expr_id_eq(declared.value, first))
  Test.assert_eq(structural.stable_key, 99)
  Test.assert_true(
    match structural.position {
      CheckedRecordFieldWordOffset(1) -> true
      _ -> false
    }
  )
  Test.assert_true(semantic_type_id_eq(structural.value_type, integer_type))
  Test.assert_true(
    match deferred_structural.position {
      CheckedRecordFieldOrdinal(1) -> deferred_structural.stable_key == 100
      _ -> false
    }
  )
  Test.assert_true(
    match positional.kind {
      CheckedPositionalRecordField -> match positional.position {
        CheckedRecordFieldOrdinal(0) -> positional.stable_key == 0
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match graph.record_init_parts(record) {
      (CheckedDeclaredRecordConstruction(found), found_fields) ->
        declaration_identity_eq(found, owner) and graph.record_field_list_len(found_fields) == 1
      _ -> false
    }
  )
  Test.assert_true(
    match graph.record_init_parts(structural_record) {
      (CheckedStructuralRecordConstruction, found_fields) ->
        graph.record_field_list_len(found_fields) == 2
      _ -> false
    }
  )
  Test.assert_true(
    match graph.record_init_parts(tuple_record) {
      (CheckedTupleRecordConstruction, found_fields) ->
        graph.record_field_list_len(found_fields) == 1
      _ -> false
    }
  )
  Test.assert_true(
    match graph.inspect(structural_record).node {
      CheckedRecordInitNode(CheckedStructuralRecordConstruction, _) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match graph.inspect(tuple_record).node {
      CheckedRecordInitNode(CheckedTupleRecordConstruction, _) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match graph.record_update_parts(updated) {
      (base, found_fields) -> checked_expr_id_eq(base, record) and
        graph.record_field_list_len(found_fields) == 1
    }
  )
  Test.assert_true(
    match graph.array_literal_parts(array) {
      (found_elements, element_type) -> graph.expression_list_len(found_elements) == 2 and
        semantic_type_id_eq(element_type, integer_type)
    }
  )
}

test "checked pointer and field access nodes retain exact facts" {
  let module = named_module_identity("fixture/pointer_access", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let nil_type = nil_type(module)
  let field = MemberDeclarationIdentity(
    declaration(module),
    RecordFieldDeclaration,
    source_from_text("value").all()
  )
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    12
  )
  let (builder, base) = builder.integer(1, integer_type, range(0, 0))
  let (builder, value) = builder.integer(2, integer_type, range(0, 0))
  let (builder, address) = builder.address_of(true, base, integer_type, range(0, 0))
  let (builder, dereferenced) = builder.dereference(address, integer_type, range(0, 0))
  let (builder, assigned) = builder.pointer_assign(
    address,
    value,
    nil_type,
    range(0, 0)
  )
  let (builder, declared) = builder.declared_field_access(
    base,
    field,
    3,
    integer_type,
    range(0, 0)
  )
  let (builder, structural) = builder.structural_field_access(
    base,
    77,
    CheckedStructuralFieldWordOffset(4),
    integer_type,
    range(0, 0)
  )
  let (builder, unplaced) = builder.structural_field_access(
    base,
    78,
    CheckedStructuralFieldUnplaced("target"),
    integer_type,
    range(0, 0)
  )
  let graph = builder.freeze()

  Test.assert_true(
    match graph.address_parts(address) {
      (mutable, target) -> mutable and checked_expr_id_eq(target, base)
    }
  )
  Test.assert_true(checked_expr_id_eq(graph.dereference_pointer(dereferenced), address))
  Test.assert_true(
    match graph.pointer_assign_parts(assigned) {
      (pointer, replacement) -> checked_expr_id_eq(pointer, address) and
        checked_expr_id_eq(replacement, value)
    }
  )
  Test.assert_true(
    match graph.declared_field_access_parts(declared) {
      (found_base, found_field, offset) -> checked_expr_id_eq(found_base, base) and
        declaration_identity_eq(found_field, field) and offset == 3
    }
  )
  Test.assert_true(
    match graph.structural_field_access_parts(structural) {
      (found_base, key, offset) -> checked_expr_id_eq(found_base, base) and
        key == 77 and
        match offset { CheckedStructuralFieldWordOffset(4) -> true, _ -> false }
    }
  )
  Test.assert_true(
    match graph.structural_field_access_parts(unplaced) {
      (found_base, key, offset) -> checked_expr_id_eq(found_base, base) and
        key == 78 and
        match offset { CheckedStructuralFieldUnplaced(name) -> name == "target", _ -> false }
    }
  )
  Test.assert_true(
    match graph.inspect(unplaced).node {
      CheckedStructuralFieldAccessNode(_, 78, CheckedStructuralFieldUnplaced(name)) ->
        name == "target"
      _ -> false
    }
  )
}

test "checked indexed nodes retain element types lengths and operands" {
  let module = named_module_identity("fixture/indexed_access", 71)
  let catalog = checked_types(module)
  let integer_type = integer_type(module)
  let nil_type = nil_type(module)
  let builder = checked_expr_graph_builder(
    module,
    source_from_text("fixture"),
    catalog,
    7
  )
  let (builder, base) = builder.integer(1, integer_type, range(0, 0))
  let (builder, index) = builder.integer(0, integer_type, range(0, 0))
  let (builder, value) = builder.integer(2, integer_type, range(0, 0))
  let (builder, length) = builder.indexed_length(
    base,
    integer_type,
    8,
    integer_type,
    range(0, 0)
  )
  let (builder, get) = builder.indexed_get(
    base,
    index,
    integer_type,
    8,
    integer_type,
    range(0, 0)
  )
  let (builder, set) = builder.indexed_set(
    base,
    index,
    value,
    integer_type,
    8,
    nil_type,
    range(0, 0)
  )
  let (builder, slice) = builder.indexed_slice(
    base,
    index,
    value,
    integer_type,
    integer_type,
    range(0, 0)
  )
  let graph = builder.freeze()

  Test.assert_true(
    match graph.indexed_length_parts(length) {
      (found_base, element_type, found_length) -> checked_expr_id_eq(found_base, base) and
        semantic_type_id_eq(element_type, integer_type) and found_length == 8
    }
  )
  Test.assert_true(
    match graph.indexed_get_parts(get) {
      CheckedIndexedGet(found_base, found_index, element_type, found_length) ->
        checked_expr_id_eq(found_base, base) and checked_expr_id_eq(found_index, index) and
        semantic_type_id_eq(element_type, integer_type) and found_length == 8
    }
  )
  Test.assert_true(
    match graph.indexed_set_parts(set) {
      CheckedIndexedSet(found_base, found_index, replacement, element_type, found_length) ->
        checked_expr_id_eq(found_base, base) and checked_expr_id_eq(found_index, index) and
        checked_expr_id_eq(replacement, value) and
        semantic_type_id_eq(element_type, integer_type) and found_length == 8
    }
  )
  Test.assert_true(
    match graph.indexed_slice_parts(slice) {
      CheckedIndexedMutation(found_base, start, end, element_type) ->
        checked_expr_id_eq(found_base, base) and checked_expr_id_eq(start, index) and
        checked_expr_id_eq(end, value) and semantic_type_id_eq(element_type, integer_type)
    }
  )
}
