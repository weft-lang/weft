use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpHeaders, HttpMethod, HttpPost, HttpRequestHead}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady}
use stdlib/http/replay as http_replay
use stdlib/http/replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay}
use stdlib/http/stream as http_stream
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/result.{Err, Ok, Result}
use stdlib/sse as sse
use stdlib/sse.{SseInvalidComment, SseLineTooLong}
use stdlib/sse/stream as sse_stream
use stdlib/sse/stream.{SseStreamDecode, SseStreamEnd, SseStreamEndClosed, SseStreamEvent, SseStreamReadFailed, SseStreamStopped, SseStreamWriteRejected, SseStreamWriteStopped, SseStreamWritten}
use stdlib/url as url

fn sse_test_headers(content_length: str) -> HttpHeaders {
  http.headers().append(
    http.header(http.parse_field_name("Host").unwrap(), bytes.from_str("example.com")).unwrap()
  ).append(
    http.header(http.parse_field_name("Content-Length").unwrap(), bytes.from_str(content_length)).unwrap()
  )
}

fn sse_test_request(method: HttpMethod, content_length: str) -> HttpRequestHead {
  http.request(
    method,
    http.parse_request_target("/events").unwrap(),
    Http11,
    sse_test_headers(content_length),
    http.default_limits()
  ).unwrap()
}

fn sse_test_fixture(input: Bytes, expected: Bytes, fragment: i64) -> HttpReplayFixture {
  http_replay.fixture(
    input,
    expected,
    __i64_to_usize(fragment),
    __i64_to_usize(fragment),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

fn sse_test_get_wire() -> Bytes {
  bytes.from_str("GET /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
}

fn sse_test_read_event(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 5
        HttpClientResponseReady(head, body) -> match sse_stream.reader(
          body, sse.default_limits()
        ).next() {
          SseStreamEvent(reader, event) -> if event.data() != "hello" or
            event.last_event_id() != "7" { 6 }
          else { match reader.next() {
              SseStreamEndClosed(reconnect, trailers) -> 0
              _ -> 7
            } }
          _ -> 8
        }
      }
    }
  }
}

fn sse_test_decode_failure(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, body) -> match sse_stream.reader(
          body, sse.limits(3, 100).unwrap()
        ).next() {
          SseStreamStopped(returned, SseStreamDecode(SseLineTooLong(offset))) ->
            match returned.cancel() {
              Ok(done) -> 0
              Err(error) -> 3
            }
          _ -> 4
        }
      }
      _ -> 5
    }
  }
}

fn sse_test_write_event(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpPost, "17"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match sse_stream.writer(body).write(
      sse.event("message", "hello", "7").unwrap()
    ) {
      SseStreamWriteRejected(returned, error) -> 2
      SseStreamWriteStopped(returned, error) -> 3
      SseStreamWritten(writer) -> match writer.finish(http.headers()) {
        HttpBodyFinished(connection) -> match connection.close() {
          Ok(done) -> 0
          Err(error) -> 4
        }
        HttpBodyFinishedClosed -> 5
        HttpBodyFinishFailed(returned, error) -> 6
        HttpBodyFinishCloseFailed(error) -> 7
      }
    }
  }
}

fn sse_test_rejected_comment(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpPost, "0"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match sse_stream.writer(body).write_comment("bad\ncomment") {
      SseStreamWriteRejected(writer, SseInvalidComment) -> match writer.finish(
        http.headers()
      ) {
        HttpBodyFinished(connection) -> match connection.close() {
          Ok(done) -> 0
          Err(error) -> 2
        }
        _ -> 3
      }
      _ -> 4
    }
  }
}

fn sse_test_drop_reader(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, body) -> {
          let reader = sse_stream.reader(body, sse.default_limits())
          0
        }
      }
      _ -> 3
    }
  }
}

test "owned SSE reader delivers one event and the exact HTTP end" {
  let fixture = sse_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 17\r\nconnection: close\r\n\r\nid:7\ndata:hello\n\n"),
    sse_test_get_wire(),
    2
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_read_event), 0)
  Test.assert_eq(fixture.stats().closes, 1)
  Test.assert_eq(fixture.stats().releases, 0)
}

test "SSE decode failure returns the exact raw body for cancellation" {
  let fixture = sse_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 14\r\nconnection: close\r\n\r\ndata:toolong\n\n"),
    sse_test_get_wire(),
    3
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_decode_failure), 0)
  Test.assert_eq(fixture.stats().closes, 1)
  Test.assert_eq(fixture.stats().releases, 0)
}

test "owned SSE writer emits a validated event through the HTTP body" {
  let fixture = sse_test_fixture(
    bytes.from_str(""),
    bytes.from_str("POST /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 17\r\n\r\nid:7\ndata:hello\n\n"),
    3
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_write_event), 0)
  Test.assert_eq(fixture.stats().write_bytes, 81)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "SSE writer rejection preserves the unconsumed writer owner" {
  let fixture = sse_test_fixture(
    bytes.from_str(""),
    bytes.from_str("POST /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n"),
    4
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_rejected_comment), 0)
  Test.assert_eq(fixture.stats().errors, 0)
  Test.assert_eq(fixture.stats().closes, 1)
}

test "dropping an unfinished SSE reader releases its exact replay owner" {
  let fixture = sse_test_fixture(
    bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 17\r\n\r\nid:7\ndata:hello\n\n"),
    sse_test_get_wire(),
    5
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_drop_reader), 0)
  Test.assert_eq(fixture.stats().closes, 0)
  Test.assert_eq(fixture.stats().releases, 1)
}
