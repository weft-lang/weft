use stdlib/bytes.{Bytes, bytes_from_str}
use stdlib/http.{Http11, HttpGet, HttpHeaders, HttpMethod, HttpPost, HttpRequestHead, http_default_limits, http_field_name_parse, http_header, http_headers_append, http_headers_empty, http_request_head_new, http_request_target_parse}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientResponseFailed, HttpClientResponseReady}
use stdlib/http/replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay, http_replay_fixture, http_replay_stats}
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO, http_body_cancel, http_body_finish, http_connection_close}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/result.{Err, Ok, Result}
use stdlib/sse.{SseInvalidComment, SseLineTooLong, sse_default_limits, sse_event, sse_event_data, sse_event_last_event_id, sse_limits}
use stdlib/sse/stream.{SseStreamDecode, SseStreamEnd, SseStreamEndClosed, SseStreamEvent, SseStreamReadFailed, SseStreamStopped, SseStreamWriteRejected, SseStreamWriteStopped, SseStreamWritten, sse_reader, sse_reader_cancel, sse_reader_next, sse_writer, sse_writer_cancel, sse_writer_finish, sse_writer_write_comment, sse_writer_write_event}
use stdlib/url as url

fn sse_test_headers(content_length: str) -> HttpHeaders {
  http_headers_append(
    http_headers_append(
      http_headers_empty(),
      http_header(http_field_name_parse("Host").unwrap(), bytes_from_str("example.com")).unwrap()
    ),
    http_header(http_field_name_parse("Content-Length").unwrap(), bytes_from_str(content_length)).unwrap()
  )
}

fn sse_test_request(method: HttpMethod, content_length: str) -> HttpRequestHead {
  http_request_head_new(
    method,
    http_request_target_parse("/events").unwrap(),
    Http11,
    sse_test_headers(content_length),
    http_default_limits()
  ).unwrap()
}

fn sse_test_fixture(input: Bytes, expected: Bytes, fragment: i64) -> HttpReplayFixture {
  http_replay_fixture(
    input,
    expected,
    __i64_to_usize(fragment),
    __i64_to_usize(fragment),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
}

fn sse_test_get_wire() -> Bytes {
  bytes_from_str("GET /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n")
}

fn sse_test_read_event(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientResponseFailed(error) -> 5
        HttpClientResponseReady(head, body) -> match sse_reader_next(
          sse_reader(body, sse_default_limits())
        ) {
          SseStreamEvent(reader, event) -> if sse_event_data(event) != "hello" or
            sse_event_last_event_id(event) != "7" { 6 }
          else { match sse_reader_next(reader) {
              SseStreamEndClosed(reconnect, trailers) -> 0
              _ -> 7
            } }
          _ -> 8
        }
      }
    }
  }
}

fn sse_test_decode_failure(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, body) -> match sse_reader_next(
          sse_reader(body, sse_limits(3, 100).unwrap())
        ) {
          SseStreamStopped(returned, SseStreamDecode(SseLineTooLong(offset))) ->
            match http_body_cancel(returned) {
              Ok(done) -> 0
              Err(error) -> 3
            }
          _ -> 4
        }
      }
      _ -> 5
    }
  }
}

fn sse_test_write_event(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpPost, "17"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match sse_writer_write_event(
      sse_writer(body),
      sse_event("message", "hello", "7").unwrap()
    ) {
      SseStreamWriteRejected(returned, error) -> 2
      SseStreamWriteStopped(returned, error) -> 3
      SseStreamWritten(writer) -> match sse_writer_finish(writer, http_headers_empty()) {
        HttpBodyFinished(connection) -> match http_connection_close(connection) {
          Ok(done) -> 0
          Err(error) -> 4
        }
        HttpBodyFinishedClosed -> 5
        HttpBodyFinishFailed(returned, error) -> 6
        HttpBodyFinishCloseFailed(error) -> 7
      }
    }
  }
}

fn sse_test_rejected_comment(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpPost, "0"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(body) -> match sse_writer_write_comment(sse_writer(body), "bad\ncomment") {
      SseStreamWriteRejected(writer, SseInvalidComment) -> match sse_writer_finish(
        writer,
        http_headers_empty()
      ) {
        HttpBodyFinished(connection) -> match http_connection_close(connection) {
          Ok(done) -> 0
          Err(error) -> 2
        }
        _ -> 3
      }
      _ -> 4
    }
  }
}

fn sse_test_drop_reader(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/events").unwrap(),
    sse_test_request(HttpGet, "0"),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientResponseFailed(error) -> 2
        HttpClientResponseReady(head, body) -> {
          let reader = sse_reader(body, sse_default_limits())
          0
        }
      }
      _ -> 3
    }
  }
}

test "owned SSE reader delivers one event and the exact HTTP end" {
  let fixture = sse_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 17\r\nconnection: close\r\n\r\nid:7\ndata:hello\n\n"),
    sse_test_get_wire(),
    2
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_read_event), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
  Test.assert_eq(http_replay_stats(fixture).releases, 0)
}

test "SSE decode failure returns the exact raw body for cancellation" {
  let fixture = sse_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 14\r\nconnection: close\r\n\r\ndata:toolong\n\n"),
    sse_test_get_wire(),
    3
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_decode_failure), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
  Test.assert_eq(http_replay_stats(fixture).releases, 0)
}

test "owned SSE writer emits a validated event through the HTTP body" {
  let fixture = sse_test_fixture(
    bytes_from_str(""),
    bytes_from_str("POST /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 17\r\n\r\nid:7\ndata:hello\n\n"),
    3
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_write_event), 0)
  Test.assert_eq(http_replay_stats(fixture).write_bytes, 81)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "SSE writer rejection preserves the unconsumed writer owner" {
  let fixture = sse_test_fixture(
    bytes_from_str(""),
    bytes_from_str("POST /events HTTP/1.1\r\nhost: example.com\r\ncontent-length: 0\r\n\r\n"),
    4
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_rejected_comment), 0)
  Test.assert_eq(http_replay_stats(fixture).errors, 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
}

test "dropping an unfinished SSE reader releases its exact replay owner" {
  let fixture = sse_test_fixture(
    bytes_from_str("HTTP/1.1 200 OK\r\ncontent-length: 17\r\n\r\nid:7\ndata:hello\n\n"),
    sse_test_get_wire(),
    5
  )
  Test.assert_eq(http_client_with_replay(fixture, sse_test_drop_reader), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 0)
  Test.assert_eq(http_replay_stats(fixture).releases, 1)
}
