use runtime/rc.{rc_count}
use stdlib/state as state
use stdlib/string
use stdlib/state.{State}
use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

fn state_returned_text() -> str {
  let (value, final) = state.run(0, () => "retained ".concat("text"))
  value
}

test "state handlers transfer managed results without retaining a completed body" {
  let value = state_returned_text()
  Test.assert_str_eq(value, "retained text")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

effect CompletionTick { fn tick() -> nil }
effect CompletionStop { fn stop() -> never }
effect CompletionPause { @deferred fn pause() -> nil }

type CompletionRecord { text: str, number: i64 }
type CompletionResource { log: F64Table }
impl Drop for CompletionResource {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() + 1.0)
    nil
  }
}
fn completion_resource(log: F64Table) -> owned CompletionResource {
  CompletionResource { log: log }
}
fn completion_consume(resource: owned CompletionResource) -> nil { nil }

fn state_managed_pair() -> (str, str) {
  state.run("initial ".concat("state"), () => {
    State.put("final ".concat("state"))
    "completed ".concat("value")
  })
}

test "state observation and replacement preserve independent managed result and state stakes" {
  let (value, final) = state_managed_pair()
  Test.assert_str_eq(value, "completed value")
  Test.assert_str_eq(final, "final state")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
  Test.assert_eq(rc_count(__str_ptr(final) - 16), 1)
}

fn completion_identity() -> str {
  handle "owned ".concat("completion") {
    CompletionTick.tick() -> resume(nil)
    return value -> value
  }
}

test "an identity completion clause transfers its binding stake" {
  let value = completion_identity()
  Test.assert_str_eq(value, "owned completion")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

test "a borrowed completion acquires only the returned value stake" {
  let original = "caller ".concat("text")
  {
    let returned = handle original {
      CompletionTick.tick() -> resume(nil)
      return value -> value
    }
    Test.assert_str_eq(returned, original)
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 2)
  }
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

test "completion observation releases its binding after changing the result type" {
  let original = "caller ".concat("text")
  let length = handle { CompletionTick.tick() original } {
    CompletionTick.tick() -> resume(nil)
    return value -> value.len()
  }
  Test.assert_true(length == 11)
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn completion_record_field() -> str {
  handle CompletionRecord { text: "record ".concat("field"), number: 42 } {
    CompletionTick.tick() -> resume(nil)
    return record -> record.text
  }
}

test "projecting a managed completion field preserves it while releasing its container" {
  let value = completion_record_field()
  Test.assert_str_eq(value, "record field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_wide() -> (str, str) {
  handle ("first ".concat("lane"), 4.5, "last ".concat("lane")) {
    CompletionTick.tick() -> resume(nil)
    return value -> {
      let (first, number, last) = value
      (last, first)
    }
  }
}

test "completion transforms retain every managed lane of a wide result" {
  let (last, first) = completion_wide()
  Test.assert_str_eq(first, "first lane")
  Test.assert_str_eq(last, "last lane")
  Test.assert_eq(rc_count(__str_ptr(first) - 16), 1)
  Test.assert_eq(rc_count(__str_ptr(last) - 16), 1)
}

fn completion_branch(original: str, preserve: bool) -> str {
  handle { CompletionTick.tick() original } {
    CompletionTick.tick() -> resume(nil)
    return value -> if preserve { value } else { "new ".concat("value") }
  }
}

test "completion branch normalization releases the original binding on both paths" {
  let original = "caller ".concat("text")
  for preserve in [false, true] {
    {
      let value = completion_branch(original, preserve)
      Test.assert_str_eq(value, if preserve { original } else { "new value" })
      Test.assert_eq(rc_count(__str_ptr(original) - 16), if preserve { 2 } else { 1 })
    }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
}

fn completion_early(original: str) -> str {
  handle { CompletionTick.tick() original } {
    CompletionTick.tick() -> resume(nil)
    return value -> { return value }
  }
}

test "early return from a completion releases its binding after transferring the result" {
  let original = "caller ".concat("text")
  {
    let value = completion_early(original)
    Test.assert_str_eq(value, original)
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 2)
  }
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn completion_abort(original: str) -[CompletionStop]> nil {
  handle { CompletionTick.tick() original } {
    CompletionTick.tick() -> resume(nil)
    return value -> { CompletionStop.stop() nil }
  }
}

test "aborting from a completion releases the completed body's managed stake" {
  let original = "caller ".concat("text")
  handle completion_abort(original) { CompletionStop.stop() -> nil }
  Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
}

fn completion_suspend(original: str) -[CompletionPause]> nil {
  handle { CompletionTick.tick() original } {
    CompletionTick.tick() -> resume(nil)
    return value -> { CompletionPause.pause() nil }
  }
}

test "a suspended completion releases its binding on resume and continuation drop" {
  let original = "caller ".concat("text")
  for should_resume in [false, true] {
    handle completion_suspend(original) {
      CompletionPause.pause() with k -> if should_resume { k(nil) } else { nil }
    }
    Test.assert_eq(rc_count(__str_ptr(original) - 16), 1)
  }
}

test "an unused owned completion runs Drop once" {
  let log = table.filled(1, 1, 0.0).unwrap()
  let result = handle completion_resource(log) {
    CompletionTick.tick() -> resume(nil)
    return resource -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
}

test "an owned identity completion transfers cleanup to its caller" {
  let log = table.filled(1, 1, 0.0).unwrap()
  let resource = handle completion_resource(log) {
    CompletionTick.tick() -> resume(nil)
    return value -> value
  }
  Test.assert_true(log.get(0, 0).unwrap() == 0.0)
  completion_consume(resource)
  Test.assert_true(log.get(0, 0).unwrap() == 1.0)
}

fn completion_ordinary_field() -> str {
  let record = CompletionRecord { text: "ordinary ".concat("field"), number: 42 }
  record.text
}

test "returning a field preserves it after its ordinary binding is released" {
  let value = completion_ordinary_field()
  Test.assert_str_eq(value, "ordinary field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_cfg_field(flag: bool) -> str {
  handle {
    if flag { CompletionTick.tick() }
    CompletionRecord { text: "control ".concat("field"), number: 42 }
  } {
    CompletionTick.tick() -> resume(nil)
    return record -> { defer { nil } record.text }
  }
}

test "completion projections survive control flow in both initializer and cleanup scope" {
  for flag in [false, true] {
    let value = completion_cfg_field(flag)
    Test.assert_str_eq(value, "control field")
    Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
  }
}

fn completion_mutable_field(flag: bool) -> str {
  let mut record = if flag {
    CompletionRecord { text: "first ".concat("field"), number: 1 }
  } else {
    CompletionRecord { text: "other ".concat("field"), number: 2 }
  }
  record = CompletionRecord { text: "final ".concat("field"), number: 3 }
  defer { nil }
  record.text
}

test "mutable binding projection preserves the final value across replacement and cleanup" {
  for flag in [false, true] {
    let value = completion_mutable_field(flag)
    Test.assert_str_eq(value, "final field")
    Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
  }
}

fn completion_mutable_straight_field() -> str {
  let mut record = CompletionRecord { text: "mutable ".concat("field"), number: 1 }
  record.text
}

test "straight mutable binding projection transfers an independent field stake" {
  let value = completion_mutable_straight_field()
  Test.assert_str_eq(value, "mutable field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

type CompletionOuter { inner: CompletionRecord, other: str }

fn completion_nested_field() -> str {
  let outer = CompletionOuter {
    inner: CompletionRecord { text: "nested ".concat("field"), number: 42 },
    other: "unreturned ".concat("sibling")
  }
  let marker = 7
  outer.inner.text
}

test "nested projections retain the leaf before every enclosing record is released" {
  let value = completion_nested_field()
  Test.assert_str_eq(value, "nested field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_shadowed_field() -> str {
  let record = CompletionRecord { text: "outer ".concat("field"), number: 1 }
  let record = CompletionRecord { text: "inner ".concat("field"), number: 2 }
  record.text
}

test "projection provenance follows the innermost lexical binding" {
  let value = completion_shadowed_field()
  Test.assert_str_eq(value, "inner field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_external_field(original: CompletionRecord) -> str {
  let unrelated = CompletionRecord { text: "unrelated ".concat("field"), number: 1 }
  handle unrelated {
    CompletionTick.tick() -> resume(nil)
    return completed -> original.text
  }
}

test "a completion borrowing an external record acquires exactly one caller result stake" {
  let original = CompletionRecord { text: "external ".concat("field"), number: 2 }
  {
    let value = completion_external_field(original)
    Test.assert_str_eq(value, "external field")
    Test.assert_eq(rc_count(__str_ptr(value) - 16), 2)
  }
  Test.assert_eq(rc_count(__str_ptr(original.text) - 16), 1)
}

fn completion_early_field() -> str {
  handle CompletionRecord { text: "early ".concat("field"), number: 42 } {
    CompletionTick.tick() -> resume(nil)
    return record -> { return record.text }
  }
}

test "early projection return preserves the field before completion cleanup" {
  let value = completion_early_field()
  Test.assert_str_eq(value, "early field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_paused_field() -[CompletionPause]> str {
  handle CompletionRecord { text: "resumed ".concat("field"), number: 42 } {
    CompletionTick.tick() -> resume(nil)
    return record -> { CompletionPause.pause() record.text }
  }
}

test "resuming a suspended completion preserves a projected result" {
  let value = handle completion_paused_field() {
    CompletionPause.pause() with k -> k(nil)
  }
  Test.assert_str_eq(value, "resumed field")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}

fn completion_branch_field(flag: bool) -> str {
  handle CompletionRecord { text: "branch ".concat("field"), number: 42 } {
    CompletionTick.tick() -> resume(nil)
    return record -> if flag { record.text } else { "other ".concat("result") }
  }
}

test "branch projection normalization does not acquire a second result stake" {
  for flag in [false, true] {
    let value = completion_branch_field(flag)
    Test.assert_str_eq(value, if flag { "branch field" } else { "other result" })
    Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
  }
}

fn state_closure_text() -> str {
  let (read, final) = state.run(0, () => {
    let text = "closure ".concat("capture")
    () => text
  })
  read()
}

test "state completion transfers a closure and releases its managed captures" {
  let value = state_closure_text()
  Test.assert_str_eq(value, "closure capture")
  Test.assert_eq(rc_count(__str_ptr(value) - 16), 1)
}
