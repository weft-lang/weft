use compiler/weft/products.{TypedModule}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/backend/aarch64/codegen.{*}
use compiler/weft/check/table.{str_hash}
use compiler/storage.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}
use stdlib/option.{Some, None}

fn checked_test_hash(name: str) -> i64 { str_hash(__str_ptr(name), 0, __str_len(name)) }

fn checked_test_typed(source: str) -> TypedModule {
  probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0)
}

fn checked_test_blocks(functions: IrFunctionList, name: str) -> IrBlockList {
  match pipeline_ir_function_list_find_hash(functions, checked_test_hash(name)) {
    IrFunctionCons(IrFunction(_, _, blocks, _), IrFunctionNil) -> blocks
    _ -> IrBlockListNil
  }
}

fn checked_test_calls(blocks: IrBlockList, hash: i64) -> i64 {
  let mut total = 0
  let mut current = blocks
  let mut walking = true
  while walking {
    match current {
      IrBlockListNil -> { walking = false }
      IrBlockListCons(IrBlock(_, _, insts, _), rest) -> {
        let mut instructions = insts
        let mut scanning = true
        while scanning {
          match instructions {
            IrInstNil -> { scanning = false }
            IrInstCons(inst, tail) -> {
              match inst { IrCallI64(_, callee, _) if callee == hash -> { total = total + 1 }, _ -> nil }
              instructions = tail
            }
          }
        }
        current = rest
      }
    }
  }
  total
}

fn checked_test_unsigned_comparisons(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> {
      let mut total = 0
      let mut instructions = insts
      let mut scanning = true
      while scanning {
        match instructions {
          IrInstNil -> { scanning = false }
          IrInstCons(inst, tail) -> {
            match ir_comparison_fact(inst) { IrComparison(_, _, _, _, IrComparisonUnsigned) -> { total = total + 1 }, _ -> nil }
            instructions = tail
          }
        }
      }
      total + checked_test_unsigned_comparisons(rest)
    }
  }
}

test "index contracts remain sealed until their bounds consumer" {
  for hash in [10, 20, 30, 40, 50] {
    for stage in [PipelineIrInlineEarly, PipelineIrInlineAfterLayout, PipelineIrInlineAfterBounds] {
      let expected = match stage {
        PipelineIrInlineEarly -> hash == 50
        PipelineIrInlineAfterLayout -> hash == 50
        PipelineIrInlineAfterBounds -> hash == 10 or hash == 20 or hash == 30
      }
      Test.assert_true(pipeline_ir_multi_inline_stage_admits_contract(stage, hash, 10, 20, 30, 40) == expected)
    }
  }
}

test "checked native preparation requires the ordinary scalar ABI fact" {
  let hash = pipeline_runtime_index_address_lower_proven_hash()
  let function = IrFunction(hash, 4, IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil), 0)
  let prepared = pipeline_ir_prepare_checked_calls(IrFunctionCons(function, IrFunctionNil), PipelineIrSemanticFactNil, 0)
  Test.assert_eq(pipeline_ir_checked_call_preparation_sites(prepared), 0)
  Test.assert_eq_usize(pipeline_ir_checked_call_preparation_proofs(prepared).len(), 0)
}

test "checked native preparation preserves the unsigned guard failure path and proof view" {
  let typed = checked_test_typed("fn f(xs: [i64], i: usize) -> i64 { xs[i] } fn main() -> i64 { 0 }")
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let functions = pipeline_ir_functions(optimized)
  let facts = pipeline_ir_semantic_facts(optimized)
  let table = match typed { TypedModule(_, _, tt, owners) -> tt }
  let lower = pipeline_runtime_index_address_lower_proven_hash()
  Test.assert_eq(checked_test_calls(checked_test_blocks(functions, "f"), lower), 1)
  let prepared = pipeline_ir_prepare_checked_calls(functions, facts, table)
  let after = checked_test_blocks(pipeline_ir_checked_call_preparation_functions(prepared), "f")
  Test.assert_eq(checked_test_calls(after, lower), 0)
  Test.assert_eq(checked_test_unsigned_comparisons(after), 1)
  Test.assert_eq(checked_test_calls(after, checked_test_hash("runtime_panic")), 1)
  Test.assert_eq(checked_test_calls(checked_test_blocks(functions, "f"), lower), 1)
  Test.assert_true(match pipeline_ir_checked_call_preparation_proofs(prepared).get(checked_test_hash("f")) { Some(count) -> count == 1, None -> false })
  match pipeline_ir_function_list_find_hash(pipeline_ir_checked_call_preparation_functions(prepared), checked_test_hash("f")) {
    IrFunctionCons(function, IrFunctionNil) -> Test.assert_eq(pipeline_ir_verify_function(function), 0)
    _ -> Test.assert_true(false)
  }
}

test "complete bounds proofs retain direct indexed address preparation" {
  let typed = checked_test_typed("fn f(xs: [i64], i: usize) -> i64 { if i < xs.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }")
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let table = match typed { TypedModule(_, _, tt, owners) -> tt }
  let prepared = pipeline_ir_prepare_checked_calls(pipeline_ir_functions(optimized), pipeline_ir_semantic_facts(optimized), table)
  let after = checked_test_blocks(pipeline_ir_checked_call_preparation_functions(prepared), "f")
  Test.assert_eq(checked_test_calls(after, pipeline_runtime_index_address_full_proven_hash()), 1)
  Test.assert_true(not pipeline_ir_checked_call_preparation_proofs(prepared).contains_key(checked_test_hash("f")))
  let native = pipeline_lower_native_module_with_audit(typed, optimized, 1)
  Test.assert_eq(fmap_emit_error_count(pipeline_native_fmap(native)), 0)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(native), 1)
}

test "a different slice length retains both unsigned checks after preparation" {
  let typed = checked_test_typed("fn f(xs: [i64], other: [i64], i: usize) -> i64 { if i < other.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }")
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let table = match typed { TypedModule(_, _, tt, owners) -> tt }
  let prepared = pipeline_ir_prepare_checked_calls(pipeline_ir_functions(optimized), pipeline_ir_semantic_facts(optimized), table)
  let after = checked_test_blocks(pipeline_ir_checked_call_preparation_functions(prepared), "f")
  Test.assert_eq(checked_test_unsigned_comparisons(after), 2)
  Test.assert_eq(checked_test_calls(after, checked_test_hash("runtime_panic")), 1)
}

test "prepared proof counters count emitted functions and preserve module analysis" {
  let typed = checked_test_typed("fn unused(xs: [i64], i: usize) -> i64 { xs[i] } fn main() -> i64 { 0 }")
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let complete = pipeline_lower_native_module(typed, optimized)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(complete), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(complete), 0)
  let closed = pipeline_lower_native_module_closed(typed, optimized)
  Test.assert_eq(fmap_emit_error_count(pipeline_native_fmap(closed)), 0)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(closed), 0)
}

test "proof counting accepts only exact partial indexed address contracts" {
  let lower = pipeline_runtime_index_address_lower_proven_hash()
  let upper = pipeline_runtime_index_address_upper_proven_hash()
  let args = IrValueCons(0, IrValueCons(1, IrValueCons(2, IrValueCons(3, IrValueNil))))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(4, lower, args),
    IrInstCons(IrCallI64(5, upper, args),
    IrInstCons(IrCallI64(6, pipeline_runtime_index_address_hash(), args),
    IrInstCons(IrCallI64(7, pipeline_runtime_index_address_full_proven_hash(), args),
    IrInstCons(IrCallI64(8, pipeline_runtime_slice_address_hash(), args),
    IrInstCons(IrCallI64(9, lower, IrValueNil), IrInstNil)))))), IrTermReturn(9)), IrBlockListNil)
  Test.assert_eq(pipeline_ir_checked_partial_proof_count(blocks, lower, upper), 2)
}
