use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/backend/aarch64/codegen.{*}
use compiler/weft/check/table.{str_hash}
use compiler/storage.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}
use stdlib/test.{Test}

fn address_args() -> IrValueList {
  IrValueCons(0, IrValueCons(1, IrValueCons(2, IrValueCons(3, IrValueNil))))
}

fn address_is_proven(inst: IrInst) -> bool {
  match pipeline_ir_indexed_address_fact(inst, pipeline_runtime_index_address_full_proven_hash()) {
    PipelineIrIndexedAddressProven(_, _, _, _) -> true
    PipelineIrIndexedAddressUnproved -> false
  }
}

test "address preparation requires the complete indexed storage proof" {
  let full = pipeline_runtime_index_address_full_proven_hash()
  Test.assert_true(address_is_proven(IrCallI64(4, full, address_args())))
  let unproved = [pipeline_runtime_index_address_hash(), pipeline_runtime_index_address_lower_proven_hash(),
    pipeline_runtime_index_address_upper_proven_hash(), pipeline_runtime_slice_address_hash(), 17]
  for hash in unproved {
    Test.assert_true(not address_is_proven(IrCallI64(4, hash, address_args())))
  }
  Test.assert_true(not address_is_proven(IrCallI64(4, full, IrValueNil)))
  Test.assert_true(not address_is_proven(IrCallI64(4, full, IrValueCons(0, address_args()))))
  Test.assert_true(not address_is_proven(IrBinaryI64(4, IrAdd, 0, 2)))
}

test "indexed address facts preserve storage and bound identities" {
  let call = IrCallI64(4, pipeline_runtime_index_address_full_proven_hash(), address_args())
  match pipeline_ir_indexed_address_fact(call, pipeline_runtime_index_address_full_proven_hash()) {
    PipelineIrIndexedAddressProven(data, len, index, stride) -> {
      Test.assert_eq(data, 0)
      Test.assert_eq(len, 1)
      Test.assert_eq(index, 2)
      Test.assert_eq(stride, 3)
    }
    PipelineIrIndexedAddressUnproved -> Test.assert_true(false)
  }
}

test "address preparation preserves SSA transport and unproved accesses" {
  let full = pipeline_runtime_index_address_full_proven_hash()
  let checked = pipeline_runtime_index_address_hash()
  let body = IrInstCons(IrCallI64(4000, full, address_args()),
    IrInstCons(IrPtrLoadI64(4001, 4000, IrStorageI16),
    IrInstCons(IrCallI64(4002, checked, address_args()),
    IrInstCons(IrPtrStoreI64(4003, 4002, 4001, IrStorageI16), IrInstNil))))
  let original = ir_function_new_src(19, 4, ir_block_new_term(0, body, IrTermReturn(4001)), 0)
  match original {
    IrFunction(_, _, blocks, _) -> {
      let facts = pipeline_ir_indexed_address_facts(blocks, full)
      Test.assert_eq_usize(facts.len(), 1)
      let prepared = pipeline_ir_prepare_indexed_addresses(original, facts)
      Test.assert_eq(pipeline_ir_verify_function(prepared), 0)
      match prepared {
        IrFunction(_, count, lowered, _) -> {
          Test.assert_eq(count, 4)
          Test.assert_eq_usize(pipeline_ir_indexed_address_facts(lowered, full).len(), 0)
          Test.assert_eq_usize(pipeline_ir_indexed_address_facts(lowered, checked).len(), 1)
          Test.assert_true(pipeline_ir_function_next_value(count, lowered) > 4003)
        }
      }
    }
  }
}

test "public slice loop proofs survive native preparation and metric reporting" {
  let source = "fn sum(values: [i64]) -> i64 { let mut result = 0 let start: usize = 0 for index in start..values.len { result = result + values[index] } result } fn main() -> i64 { let values = [1, 2, 3] sum(values[..]) - 6 }"
  let typed = probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0)
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let full = pipeline_runtime_index_address_full_proven_hash()
  let sum_hash = str_hash(__str_ptr("sum"), 0, 3)
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(optimized), sum_hash) {
    IrFunctionCons(function, IrFunctionNil) -> match function {
      IrFunction(_, _, blocks, _) -> {
        let facts = pipeline_ir_indexed_address_facts(blocks, full)
        Test.assert_true(facts.len() > 0)
        let prepared = pipeline_ir_prepare_indexed_addresses(function, facts)
        Test.assert_eq(pipeline_ir_verify_function(prepared), 0)
      }
    }
    _ -> Test.assert_true(false)
  }
  let native = pipeline_lower_native_module_with_audit(typed, optimized, 1)
  Test.assert_eq(fmap_emit_error_count(pipeline_native_fmap(native)), 0)
  Test.assert_true(pipeline_native_indexed_full_bounds_elision_count(native) > 0)
}
