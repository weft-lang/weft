use stdlib/map as map
use stdlib/map.{Map}
use stdlib/list.{List, Nil, Cons}
use stdlib/string.{*}
use stdlib/iter.{IntoIterator}
use stdlib/option.{Some, None}
use stdlib/vector as vector
use stdlib/vector.{Vector}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_count}

type InferenceHost<T> { InferenceHost(T) }

impl<T> InferenceHost<T> {
  fn choose<A>(self, value: A) -> A { value }

  fn transform<A>(self, value: T, f: (T) -> A) -> A { f(value) }

  fn combine<A, B>(self, first: A, second: B) -> (A, B) { (first, second) }

  fn observe<A, e>(self, value: A, f: (A) -[e]> T) -[e]> T { f(value) }

  fn item<A, S: IntoIterator & {type Item = A}>(self, source: S) -> A? {
    for value in source { return value }
    nil
  }
}

type InferenceFactory { value: i64 }

impl InferenceFactory {
  fn make<T>(value: T) -> T { value }
}

fn copy_entry(result: Map<i64, bool>, key: i64, value: bool) -> Map<i64, bool> {
  result.insert(key, value)
}

fn copy_map(values: Map<i64, bool>) -> Map<i64, bool> {
  values.fold(map.new<i64, bool>(), copy_entry)
}

fn generic_receiver<K, V>(host: InferenceHost<Map<K, V>>) -> str {
  host.choose("weft")
}

effect InferenceRead {
  fn read(value: str) -> i64
}

fn read_length(value: str) -[InferenceRead]> i64 { InferenceRead.read(value) }

test "map fold infers a managed accumulator and preserves every entry" {
  let values = map.new<i64, bool>().insert(7, true).insert(11, false)
  let copied = values.fold(map.new<i64, bool>(),
    (result: Map<i64, bool>, key: i64, value: bool) => result.insert(key, value))
  Test.assert_eq_usize(copied.len(), 2)
  Test.assert_true(match copied.get(7) { Some(value) -> value, None -> false })
  Test.assert_false(match copied.get(11) { Some(value) -> value, None -> true })
  Test.assert_eq_usize(values.len(), 2)
}

test "map fold infers empty results and named callback accumulators" {
  Test.assert_eq_usize(copy_map(map.new<i64, bool>()).len(), 0)
  Test.assert_true(copy_map(map.new<i64, bool>().insert(42, true)).contains_key(42))
}

test "map fold keeps distinct accumulator specializations" {
  let values = map.new<i64, bool>().insert(7, true)
  Test.assert_eq(values.fold(0, (sum: i64, key: i64, value: bool) => sum + key), 7)
  Test.assert_str_eq(values.fold("", (text: str, key: i64, value: bool) => text.concat("weft")), "weft")
  Test.assert_true(values.fold(false, (found: bool, key: i64, value: bool) => found or value))
}

test "list transformations infer method local input and output types" {
  let words = Cons<str>("a", Cons<str>("weft", Nil<str>()))
  let lengths = words.map((word: str) => word.len())
  let zero: usize = 0
  Test.assert_eq_usize(lengths.fold(zero, (sum: usize, length: usize) => sum + length), 5)
}

test "generic receiver bindings do not capture inferred local arguments" {
  let host = InferenceHost<Map<i64, bool>>(map.new<i64, bool>())
  Test.assert_str_eq(generic_receiver<i64, bool>(host), "weft")
  Test.assert_eq(host.choose(42), 42)
}

test "callback results and multiple method parameters infer independently" {
  let host = InferenceHost<str>("weft")
  Test.assert_true(host.transform("weft", (value: str) => value == "weft"))
  let (number, text) = host.combine(42, "weft")
  Test.assert_eq(number, 42)
  Test.assert_str_eq(text, "weft")
}

test "method inference uses associated type equality evidence" {
  let host = InferenceHost<i64>(0)
  Test.assert_eq(match host.item(Cons<i64>(42, Nil<i64>())) { value: i64 -> value, nil -> 0 }, 42)
  Test.assert_eq(match host.item(Nil<i64>()) { value: i64 -> value, nil -> 7 }, 7)
}

test "associated methods preserve call mode for inferred and explicit arguments" {
  Test.assert_str_eq(InferenceFactory.make("weft"), "weft")
  Test.assert_eq(InferenceFactory.make<i64>(42), 42)
}

test "method inference preserves callback effects and handler results" {
  let result = handle InferenceHost<i64>(0).observe("weft", read_length) {
    InferenceRead.read(value) -> resume(if value == "weft" { 42 } else { 0 })
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(InferenceHost<i64>(0).observe(21, (value: i64) => value * 2), 42)
}

test "explicit union method arguments remain authoritative" {
  let value = InferenceHost<i64>(0).choose<str | nil>("weft")
  Test.assert_str_eq(match value { text: str -> text, nil -> "missing" }, "weft")
}

fn inferred_owned_method_round(probe: RuntimeRcProbe) -> usize {
  let mut values = InferenceHost<i64>(0).choose(vector.new<RuntimeRcProbe>())
  values.push(probe)
  values.len()
}

test "inferred method arguments preserve owned resource transfer and cleanup" {
  let probe = runtime_rc_probe_new(42)
  for iteration in 0..32 {
    Test.assert_eq_usize(inferred_owned_method_round(probe), 1)
    Test.assert_eq(runtime_rc_probe_count(probe), 1)
  }
}
