use "stdlib/string.weft"

test "runtime_string_concat_alloc_boundaries" {
  let both_empty = str_concat("", "")
  let right_empty = str_concat("weft", "")
  let left_empty = str_concat("", "runtime")
  Test.assert_eq(str_len(both_empty), 0)
  Test.assert_eq(str_eq(both_empty, ""), 1)
  Test.assert_eq(str_eq(right_empty, "weft"), 1)
  Test.assert_eq(str_eq(left_empty, "runtime"), 1)
}

test "runtime_string_concat_chained_allocations" {
  let a = str_concat("run", "time")
  let b = str_concat(a, "-")
  let c = str_concat(b, "alloc")
  Test.assert_eq(str_len(c), 13)
  Test.assert_eq(str_eq(c, "runtime-alloc"), 1)
}

test "runtime_int_to_str_alloc_matrix" {
  Test.assert_eq(str_eq(int_to_str(7), "7"), 1)
  Test.assert_eq(str_eq(int_to_str(123456789), "123456789"), 1)
  Test.assert_eq(str_eq(int_to_str(0 - 987654321), "-987654321"), 1)
}
