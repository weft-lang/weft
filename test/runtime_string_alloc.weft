use stdlib/string.{*}
use stdlib/num as num
use stdlib/num.{*}
use stdlib/result.{Ok, Err}

test "runtime_string_concat_alloc_boundaries" {
  let both_empty = str_concat("", "")
  let right_empty = str_concat("weft", "")
  let left_empty = str_concat("", "runtime")
  Test.assert_eq(str_len(both_empty), 0)
  Test.assert_eq(str_eq(both_empty, ""), 1)
  Test.assert_eq(str_eq(right_empty, "weft"), 1)
  Test.assert_eq(str_eq(left_empty, "runtime"), 1)
}

test "runtime_string_concat_chained_allocations" {
  let a = str_concat("run", "time")
  let b = str_concat(a, "-")
  let c = str_concat(b, "alloc")
  Test.assert_eq(str_len(c), 13)
  Test.assert_eq(str_eq(c, "runtime-alloc"), 1)
}

test "runtime_int_to_str_alloc_matrix" {
  Test.assert_eq(str_eq(int_to_str(7), "7"), 1)
  Test.assert_eq(str_eq(int_to_str(123456789), "123456789"), 1)
  Test.assert_eq(str_eq(int_to_str(0 - 987654321), "-987654321"), 1)
  Test.assert_eq(str_eq(int_to_str(0), "0"), 1)
  Test.assert_eq(str_eq(int_to_str(0 - 1), "-1"), 1)
  Test.assert_eq(str_eq(int_to_str(10), "10"), 1)
  Test.assert_eq(str_eq(int_to_str(1000000), "1000000"), 1)
  Test.assert_eq(str_eq(int_to_str(9223372036854775807), "9223372036854775807"), 1)
}

test "signed decimal rendering preserves the complete i64 domain" {
  for (value, expected) in [
    (-9223372036854775808, "-9223372036854775808"),
    (-9223372036854775807, "-9223372036854775807"),
    (-1000000000000000000, "-1000000000000000000"),
    (-100, "-100"), (-99, "-99"), (-10, "-10"), (-9, "-9"), (-1, "-1"),
    (0, "0"), (1, "1"), (9, "9"), (10, "10"), (99, "99"), (100, "100"),
    (1000000000000000000, "1000000000000000000"),
    (9223372036854775807, "9223372036854775807")
  ] {
    Test.assert_str_eq(int_to_str(value), expected)
    Test.assert_str_eq(value.display(), expected)
    Test.assert_str_eq(value.to_str(), expected)
  }
}

test "signed decimal rendering round trips around every decimal width" {
  let mut power = 1
  for width in 0..19 {
    for value in [power - 1, power, power + 1, 0 - power - 1, 0 - power, 1 - power] {
      match num.parse_i64(value.display()) {
        Ok(parsed) -> Test.assert_eq(parsed, value)
        Err(_) -> Test.assert_true(false)
      }
    }
    if width < 18 { power = power * 10 } else { nil }
  }
}
