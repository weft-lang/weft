    ir_inst_const_i64(3, 0),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_eq(), 0, 3), ir_inst_list_empty())
  )
  let else_insts = ir_inst_list_prepend(
    ir_inst_const_i64(5, 0),
    ir_inst_list_prepend(ir_inst_binary_i64(6, ne, 0, 5), ir_inst_list_empty())
  )
  let entry = ir_block_new_term(0, entry_insts, ir_term_branch(2, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(4))
