test "semantic_spine_inline_closure_reaches_imported_accessors" {
  -- The two-level closure: mem_load64_at inlines into node_f1 (pseudo
  -- rewrite), and node_f1 — now a pseudo-shaped bridge — inlines into
  -- its callers. Zero BL instructions remain at any of these sites.
  let src = "use compiler/lib.{*} fn walkp(n: i64) -> i64 { node_f1(n) + node_f2(n) } fn main() -> i64 { walkp(0) }"
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "walkp", "node_f1"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "node_f1", "mem_load64_at"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "nlist_get", "mem_load64_at"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "pack", "mem_store64_at"), 0)
}
