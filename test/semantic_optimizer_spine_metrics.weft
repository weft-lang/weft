test "semantic_spine_eligibility_matrix_records_call_shapes" {
  let direct = "effect H2HMatrixDirect { fn get() -> i64 } fn go() -[H2HMatrixDirect]> i64 { H2HMatrixDirect.get() } fn main() -> i64 { handle go() { H2HMatrixDirect.get() -> resume(42) } }"
  let generic = "effect H2HMatrixGeneric { fn get() -> i64 } fn go<T>(x: T) -[H2HMatrixGeneric]> i64 { H2HMatrixGeneric.get() } fn main() -> i64 { handle go<i64>(0) { H2HMatrixGeneric.get() -> resume(42) } }"
  let callback = "effect H2HMatrixCallback { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HMatrixCallback]> i64 { H2HMatrixCallback.get() } fn apply(f: () -[H2HMatrixCallback]> i64) -[H2HMatrixCallback]> i64 { f() } fn main() -> i64 { handle apply(leaf) { H2HMatrixCallback.get() -> resume(42) } }"
  let closure_return = "effect H2HMatrixClosure { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn make() -[H2HMatrixClosure]> () -[H2HMatrixClosure]> i64 { () => H2HMatrixClosure.get() } fn main() -> i64 { let f = handle make() { H2HMatrixClosure.get() -> resume(42) } handle f() { H2HMatrixClosure.get() -> resume(0) } }"
  let dynamic = "effect H2HMatrixDynamic { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HMatrixDynamic]> i64 { H2HMatrixDynamic.get() } fn other() -[H2HMatrixDynamic]> i64 { H2HMatrixDynamic.get() + 1 } fn choose(flag: bool) -> () -[H2HMatrixDynamic]> i64 { if flag { leaf } else { other } } fn apply(f: () -[H2HMatrixDynamic]> i64) -[H2HMatrixDynamic]> i64 { f() } fn main() -> i64 { handle apply(choose(true)) { H2HMatrixDynamic.get() -> resume(42) } }"
  Test.assert_eq(semantic_metric_context_entries(direct), 0)
  Test.assert_eq(semantic_metric_effect_evidence_inlines(direct), 0)
  Test.assert_eq(semantic_metric_context_entries(generic), 0)
  Test.assert_eq(if semantic_metric_context_entries(callback) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_effect_evidence_inlines(callback) > 0 { 1 } else { 0 }, 0)
  Test.assert_eq(semantic_metric_context_entries(closure_return), 0)
  Test.assert_eq(semantic_metric_context_entries(dynamic), 0)
  Test.assert_eq(if semantic_metric_residual_callbacks(dynamic) > 0 { 1 } else { 0 }, 0)
}

test "semantic_spine_microbenchmark_generic_context_removes_hot_path_runtime_lookup" {
  let optimized = "effect H2HBenchOpt { fn get() -> i64 } fn go<T>(x: T) -[H2HBenchOpt]> i64 { H2HBenchOpt.get() } fn main() -> i64 { let mut sum = 0 for i in 0..100 { sum = sum + handle go<i64>(i) { H2HBenchOpt.get() -> resume(1) } } sum }"
  let residual = "effect H2HBenchDyn { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HBenchDyn]> i64 { H2HBenchDyn.get() } fn other() -[H2HBenchDyn]> i64 { H2HBenchDyn.get() } fn choose(flag: bool) -> () -[H2HBenchDyn]> i64 { if flag { leaf } else { other } } fn apply(f: () -[H2HBenchDyn]> i64) -[H2HBenchDyn]> i64 { f() } fn main() -> i64 { let f = choose(true) let mut sum = 0 for i in 0..100 { sum = sum + handle apply(f) { H2HBenchDyn.get() -> resume(1) } } sum }"
  let optimized_lookups = semantic_metric_runtime_lookup_sites_in_fn(optimized, "main")
  let residual_lookups = semantic_metric_runtime_lookup_sites_in_fn(residual, "leaf")
  Test.assert_eq(optimized_lookups, -1)
  Test.assert_eq(if residual_lookups > optimized_lookups { 1 } else { 0 }, 0)
}

test "semantic_spine_distinct_callback_contexts_emit_distinct_entries" {
  let src = "effect H2HCallback { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HCallback]> i64 { H2HCallback.get() } fn leaf2() -[H2HCallback]> i64 { H2HCallback.get() + 1 } fn apply(f: () -[H2HCallback]> i64) -[H2HCallback]> i64 { f() } fn main() -> i64 { handle apply(leaf) + apply(leaf2) { H2HCallback.get() -> resume(40) } }"
  Test.assert_eq(if semantic_metric_context_entries(src) >= 2 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_context_calls(src) >= 2 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_effect_evidence_inlines(src) >= 2 { 1 } else { 0 }, 0)
}

