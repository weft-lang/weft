use runtime/alloc.{*}
--
-- Rebaselined to the typed-IR spine (2026-07-09). Pinned values are behavior
-- tripwires; residual/evidence classifications changed with lowering-time
-- handler inlining (see 2k brief).
use runtime/memory.{*}
-- test/semantic_optimizer_spine_metrics.weft -- native evidence for 2h semantic specialization spine

use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/lib.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use runtime/buffer.{*}
use runtime/unsafe.{*}

fn semantic_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  pipeline_lower_native_ir(typed)
}

fn semantic_metric_ir(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn semantic_metric_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn semantic_metric_count_bl_to_range(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if semantic_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn semantic_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  -- Function extents come from the mono cache (hash, offset) entries on
  -- the typed path; the legacy fmap entry table is unpopulated.
  let mc = fmap_mono_cache(fm)
  let d = mem_load64(mc)
  let n = mem_load64(mc + 8)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = mem_load64(d + i * 16 + 8)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn semantic_metric_runtime_lookup_sites_in_fn(src: str, name: str) -> i64 {
  let native = semantic_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(name), 0, __str_len(name))
  let end = semantic_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr("handler_find_entry"), 0, 18)
  if target == 0 or off == 0 { 0 - 1 }
  else { semantic_metric_count_bl_to_range(code, off, end, target) }
}

fn semantic_metric_call_sites_to_fn(src: str, caller: str, callee: str) -> i64 {
  -- The typed path registers function offsets in the hash-keyed mono
  -- cache, not the legacy name-keyed fmap table; the old fmap_lookup
  -- form resolved nothing and returned -1 vacuously.
  let native = semantic_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = mono_cache_lookup(fmap_mono_cache(fm), str_hash(__str_ptr(caller), 0, __str_len(caller)))
  let end = semantic_metric_next_offset(fm, off, buf_len(code))
  let target = mono_cache_lookup(fmap_mono_cache(fm), str_hash(__str_ptr(callee), 0, __str_len(callee)))
  if target <= 1 or off <= 1 { 0 - 1 }
  else { semantic_metric_count_bl_to_range(code, off, end, target) }
}

