effect SemCtxMetricRuntime {
  fn get() -> i64
}

fn sem_ctx_metric_go() -[SemCtxMetricRuntime]> i64 {
  SemCtxMetricRuntime.get()
}

effect SemCtxMetricGeneric {
  fn get() -> i64
}

fn sem_ctx_metric_generic<T>(x: T) -[SemCtxMetricGeneric]> i64 {
  SemCtxMetricGeneric.get()
}

effect SemCtxMetricNestedGeneric {
  fn get() -> i64
}

fn sem_ctx_metric_nested_inner<T>(x: T) -[SemCtxMetricNestedGeneric]> i64 {
  SemCtxMetricNestedGeneric.get()
}

fn sem_ctx_metric_nested_outer<T>(x: T) -[SemCtxMetricNestedGeneric]> i64 {
  sem_ctx_metric_nested_inner<T>(x)
}

fn sem_ctx_metric_raw_store(slot: i64, value: i64) -> i64 {
  __mem_store64(slot, value)
  0
}

fn sem_ctx_metric_raw_load_dynamic(slot: i64, offset: i64) -> i64 {
  __mem_load64(slot + offset)
}

fn sem_ctx_metric_alloc_cell() -> i64 {
  __bump_alloc(8)
}

test "semantic_spine_e2e_repeated_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_go() + sem_ctx_metric_go() {
    SemCtxMetricRuntime.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_nested_generic_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_nested_outer<i64>(0) + sem_ctx_metric_nested_outer<bool>(true) {
    SemCtxMetricNestedGeneric.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_generic_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_generic<i64>(0) + sem_ctx_metric_generic<i64>(1) {
    SemCtxMetricGeneric.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_compiler_data_field_helpers_keep_runtime_semantics" {
  let n = node_new(7, 11, 13, 17, 19)
  Test.assert_eq(node_tag(n) + node_f1(n) + node_f2(n) + node_f3(n) + node_f4(n), 67)
}

test "semantic_spine_e2e_keeps_dead_raw_store_wrapper_call" {
  let slot = __bump_alloc(8)
  sem_ctx_metric_raw_store(slot, 42)
  Test.assert_eq(__mem_load64(slot), 42)
}

test "semantic_spine_e2e_flushes_load_cse_across_raw_store_wrapper_call" {
  let slot = __bump_alloc(8)
  __mem_store64(slot, 1)
  let first = sem_ctx_metric_raw_load_dynamic(slot, 0)
  sem_ctx_metric_raw_store(slot, 2)
  let second = sem_ctx_metric_raw_load_dynamic(slot, 0)
  Test.assert_eq(first * 10 + second, 12)
}

test "semantic_spine_e2e_keeps_repeated_raw_alloc_wrapper_calls_distinct" {
  let first = sem_ctx_metric_alloc_cell()
  let second = sem_ctx_metric_alloc_cell()
  Test.assert_eq(if first == second { 0 } else { 1 }, 1)
}

test "semantic_spine_inlines_imported_ast_field_load_helpers" {
  let src = "use \"compiler/lib.weft\" fn inspect_node(n: i64) -> i64 { node_tag(n) + node_f1(n) + node_f2(n) } fn main() -> i64 { inspect_node(node_new(7, 11, 13, 17, 19)) }"
  Test.assert_eq(if semantic_metric_direct_call_inlines(src) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_tag"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_f1"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_f2"), 0)
}

test "semantic_spine_inlines_imported_type_field_load_helpers" {
  let src = "use \"compiler/types.weft\" fn inspect_type(t: i64) -> i64 { ty_tag(t) + ty_f1(t) } fn main() -> i64 { inspect_type(ty_i64()) }"
  Test.assert_eq(if semantic_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_type", "ty_tag"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_type", "ty_f1"), 0)
}

test "semantic_spine_inlines_same_source_constant_offset_load_helper" {
  let src = "fn field1(p: i64) -> i64 { __mem_load64(p + 8) } fn inspect(p: i64) -> i64 { field1(p) } fn main() -> i64 { inspect(0) }"
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "field1"), 0)
}

test "semantic_spine_keeps_effectful_load_wrapper_as_call" {
  let src = "effect H2HLoadEffect { fn get() -> i64 } fn loady(p: i64) -[H2HLoadEffect]> i64 { __mem_load64(p) } fn inspect(p: i64) -[H2HLoadEffect]> i64 { loady(p) } fn main() -[H2HLoadEffect]> i64 { inspect(0) }"
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "loady"), 1)
}

test "semantic_spine_keeps_non_whitelisted_load_width_as_call" {
  let src = "fn load8y(p: i64) -> i64 { __mem_load8(p) } fn inspect(p: i64) -> i64 { load8y(p) } fn main() -> i64 { inspect(0) }"
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load8y"), 1)
}

test "semantic_spine_keeps_dynamic_offset_load_wrapper_as_call" {
  let src = "fn load_dynamic(p: i64, off: i64) -> i64 { __mem_load64(p + off) } fn inspect(p: i64, off: i64) -> i64 { load_dynamic(p, off) } fn main() -> i64 { inspect(0, 8) }"
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load_dynamic"), 1)
}

test "semantic_spine_keeps_unaligned_constant_offset_load_wrapper_as_call" {
  let src = "fn load_unaligned(p: i64) -> i64 { __mem_load64(p + 1) } fn inspect(p: i64) -> i64 { load_unaligned(p) } fn main() -> i64 { inspect(0) }"
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load_unaligned"), 1)
}

test "semantic_spine_records_summary_entry_and_call_for_direct_helper" {
  let src = "effect H2HOne { fn get() -> i64 } fn go() -[H2HOne]> i64 { H2HOne.get() } fn main() -> i64 { handle go() { H2HOne.get() -> resume(42) } }"
  Test.assert_eq(if semantic_metric_fact_count(src) >= semantic_metric_summary_count(src) { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_summary_count(src), 1)
  Test.assert_eq(semantic_metric_context_entries(src), 1)
  Test.assert_eq(semantic_metric_context_calls(src), 1)
  Test.assert_eq(semantic_metric_effect_evidence_calls(src), 1)
}

test "semantic_spine_fact_summary_records_closed_pure_and_effectful_functions" {
  let pure = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let effectful = "effect H2HFactEffect { fn get() -> i64 } fn go() -[H2HFactEffect]> i64 { H2HFactEffect.get() } fn main() -> i64 { handle go() { H2HFactEffect.get() -> resume(42) } }"
  Test.assert_eq(if semantic_metric_fact_count(pure) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_closed_effect_facts(pure) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_pure_facts(pure) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_effectful_facts(effectful) > semantic_metric_effectful_facts(pure) { 1 } else { 0 }, 1)
}

test "semantic_spine_fact_summary_records_alloc_unsafe_and_managed_shapes" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let effects = "effect Alloc { fn alloc(size: i64, align: i64) -> i64 } effect Unsafe { fn touch() -> i64 } fn allocy() -[Alloc]> i64 { 1 } fn unsafey() -[Unsafe]> i64 { 2 } fn main() -[Alloc, Unsafe]> i64 { allocy() + unsafey() }"
  let managed = "fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn go(p: rc i64) -> rc i64 { p } fn main() -> i64 { let p: rc i64 = rc_default_alloc(8, 8) let q = go(p) rc_default_release(q) }"
  Test.assert_eq(if semantic_metric_alloc_facts(effects) > semantic_metric_alloc_facts(baseline) { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_unsafe_facts(effects) > semantic_metric_unsafe_facts(baseline) { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_managed_param_facts(managed) > semantic_metric_managed_param_facts(baseline) { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_managed_return_facts(managed) > semantic_metric_managed_return_facts(baseline) { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_managed_capture_facts(managed), 0)
}

test "semantic_spine_ir_facts_treat_raw_memory_wrappers_as_effectful" {
  let src = "fn loady(p: i64, off: i64) -> i64 { __mem_load64(p + off) } fn storey(p: i64, value: i64) -> i64 { __mem_store64(p, value) 0 } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 2 { 1 } else { 0 }, 1)
}

test "semantic_spine_ir_facts_propagate_raw_memory_effects_through_wrappers" {
  let src = "fn loady(p: i64, off: i64) -> i64 { __mem_load64(p + off) } fn wrap(p: i64, off: i64) -> i64 { loady(p, off) } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 2 { 1 } else { 0 }, 1)
}

test "semantic_spine_ir_facts_treat_raw_allocation_wrappers_as_effectful" {
  let src = "fn cell() -> i64 { __bump_alloc(8) } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_alloc_facts(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites("fn cell() -> i64 { __bump_alloc(8) } fn main() -> i64 { cell() 0 }"), 0)
}

test "semantic_spine_reuses_context_specialized_entry_for_repeated_sites" {
  let src = "effect H2HRepeat { fn get() -> i64 } fn go() -[H2HRepeat]> i64 { H2HRepeat.get() } fn main() -> i64 { handle go() + go() { H2HRepeat.get() -> resume(21) } }"
  Test.assert_eq(semantic_metric_summary_count(src), 2)
  Test.assert_eq(semantic_metric_context_entries(src), 1)
  Test.assert_eq(semantic_metric_context_cache_hits(src), 1)
  Test.assert_eq(semantic_metric_context_calls(src), 2)
}

test "semantic_spine_generic_helper_specializes_context" {
  let src = "effect H2HGeneric { fn get() -> i64 } fn go<T>(x: T) -[H2HGeneric]> i64 { H2HGeneric.get() } fn main() -> i64 { handle go<i64>(0) { H2HGeneric.get() -> resume(42) } }"
  Test.assert_eq(semantic_metric_context_entries(src), 1)
  Test.assert_eq(semantic_metric_context_calls(src), 1)
  Test.assert_eq(semantic_metric_effect_evidence_calls(src), 1)
}

test "semantic_spine_reuses_generic_context_specialized_entry_for_repeated_sites" {
  let src = "effect H2HGenericRepeat { fn get() -> i64 } fn go<T>(x: T) -[H2HGenericRepeat]> i64 { H2HGenericRepeat.get() } fn main() -> i64 { handle go<i64>(0) + go<i64>(1) { H2HGenericRepeat.get() -> resume(21) } }"
  Test.assert_eq(semantic_metric_context_entries(src), 1)
  Test.assert_eq(semantic_metric_context_cache_hits(src), 1)
  Test.assert_eq(semantic_metric_context_calls(src), 2)
}

test "semantic_spine_distinct_generic_type_args_emit_distinct_contexts" {
  let src = "effect H2HGenericType { fn get() -> i64 } fn go<T>(x: T) -[H2HGenericType]> i64 { H2HGenericType.get() } fn main() -> i64 { handle go<i64>(0) + go<bool>(true) { H2HGenericType.get() -> resume(21) } }"
  Test.assert_eq(semantic_metric_context_entries(src), 2)
  Test.assert_eq(semantic_metric_context_calls(src), 2)
}

test "semantic_spine_generic_callback_specializes_context" {
  let src = "effect H2HGenericCallback { fn add(v: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf(x: i64) -[H2HGenericCallback]> i64 { H2HGenericCallback.add(x) } fn apply<T>(f: (T) -[H2HGenericCallback]> i64, x: T) -[H2HGenericCallback]> i64 { f(x) } fn main() -> i64 { handle apply<i64>(leaf, 41) { H2HGenericCallback.add(v) -> resume(v + 1) } }"
  Test.assert_eq(if semantic_metric_context_entries(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_context_calls(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_residual_callbacks(src), 0)
}

test "semantic_spine_nested_generic_context_specializes_outer_and_inner" {
  let src = "effect H2HNestedGeneric { fn get() -> i64 } fn inner<T>(x: T) -[H2HNestedGeneric]> i64 { H2HNestedGeneric.get() } fn outer<T>(x: T) -[H2HNestedGeneric]> i64 { inner<i64>(0) + H2HNestedGeneric.get() } fn main() -> i64 { handle outer<i64>(1) { H2HNestedGeneric.get() -> resume(21) } }"
  Test.assert_eq(semantic_metric_context_entries(src), 2)
  Test.assert_eq(semantic_metric_context_calls(src), 2)
}

test "semantic_spine_nested_generic_context_substitutes_type_args" {
  let src = "effect H2HNestedType { fn get() -> i64 } fn inner<T>(x: T) -[H2HNestedType]> i64 { H2HNestedType.get() } fn outer<T>(x: T) -[H2HNestedType]> i64 { inner<T>(x) } fn main() -> i64 { handle outer<i64>(0) + outer<bool>(true) { H2HNestedType.get() -> resume(21) } }"
  Test.assert_eq(semantic_metric_context_entries(src), 4)
  Test.assert_eq(semantic_metric_context_calls(src), 4)
}

test "semantic_spine_eligibility_matrix_records_call_shapes" {
  let direct = "effect H2HMatrixDirect { fn get() -> i64 } fn go() -[H2HMatrixDirect]> i64 { H2HMatrixDirect.get() } fn main() -> i64 { handle go() { H2HMatrixDirect.get() -> resume(42) } }"
  let generic = "effect H2HMatrixGeneric { fn get() -> i64 } fn go<T>(x: T) -[H2HMatrixGeneric]> i64 { H2HMatrixGeneric.get() } fn main() -> i64 { handle go<i64>(0) { H2HMatrixGeneric.get() -> resume(42) } }"
  let callback = "effect H2HMatrixCallback { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HMatrixCallback]> i64 { H2HMatrixCallback.get() } fn apply(f: () -[H2HMatrixCallback]> i64) -[H2HMatrixCallback]> i64 { f() } fn main() -> i64 { handle apply(leaf) { H2HMatrixCallback.get() -> resume(42) } }"
  let closure_return = "effect H2HMatrixClosure { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn make() -[H2HMatrixClosure]> () -[H2HMatrixClosure]> i64 { () => H2HMatrixClosure.get() } fn main() -> i64 { let f = handle make() { H2HMatrixClosure.get() -> resume(42) } handle f() { H2HMatrixClosure.get() -> resume(0) } }"
  let dynamic = "effect H2HMatrixDynamic { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HMatrixDynamic]> i64 { H2HMatrixDynamic.get() } fn other() -[H2HMatrixDynamic]> i64 { H2HMatrixDynamic.get() + 1 } fn choose(flag: bool) -> () -[H2HMatrixDynamic]> i64 { if flag { leaf } else { other } } fn apply(f: () -[H2HMatrixDynamic]> i64) -[H2HMatrixDynamic]> i64 { f() } fn main() -> i64 { handle apply(choose(true)) { H2HMatrixDynamic.get() -> resume(42) } }"
  Test.assert_eq(semantic_metric_context_entries(direct), 1)
  Test.assert_eq(semantic_metric_context_entries(generic), 1)
  Test.assert_eq(if semantic_metric_context_entries(callback) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_context_entries(closure_return), 1)
  Test.assert_eq(semantic_metric_context_entries(dynamic), 0)
  Test.assert_eq(if semantic_metric_residual_callbacks(dynamic) > 0 { 1 } else { 0 }, 1)
}

test "semantic_spine_microbenchmark_generic_context_removes_hot_path_runtime_lookup" {
  let optimized = "effect H2HBenchOpt { fn get() -> i64 } fn go<T>(x: T) -[H2HBenchOpt]> i64 { H2HBenchOpt.get() } fn main() -> i64 { let mut sum = 0 for i in 0..100 { sum = sum + handle go<i64>(i) { H2HBenchOpt.get() -> resume(1) } } sum }"
  let residual = "effect H2HBenchDyn { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HBenchDyn]> i64 { H2HBenchDyn.get() } fn other() -[H2HBenchDyn]> i64 { H2HBenchDyn.get() } fn choose(flag: bool) -> () -[H2HBenchDyn]> i64 { if flag { leaf } else { other } } fn apply(f: () -[H2HBenchDyn]> i64) -[H2HBenchDyn]> i64 { f() } fn main() -> i64 { let f = choose(true) let mut sum = 0 for i in 0..100 { sum = sum + handle apply(f) { H2HBenchDyn.get() -> resume(1) } } sum }"
  let optimized_lookups = semantic_metric_runtime_lookup_sites_in_fn(optimized, "main")
  let residual_lookups = semantic_metric_runtime_lookup_sites_in_fn(residual, "leaf")
  Test.assert_eq(optimized_lookups, 0)
  Test.assert_eq(if residual_lookups > optimized_lookups { 1 } else { 0 }, 1)
}

test "semantic_spine_distinct_callback_contexts_emit_distinct_entries" {
  let src = "effect H2HCallback { fn get() -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -[H2HCallback]> i64 { H2HCallback.get() } fn leaf2() -[H2HCallback]> i64 { H2HCallback.get() + 1 } fn apply(f: () -[H2HCallback]> i64) -[H2HCallback]> i64 { f() } fn main() -> i64 { handle apply(leaf) + apply(leaf2) { H2HCallback.get() -> resume(40) } }"
  Test.assert_eq(if semantic_metric_context_entries(src) >= 4 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_context_calls(src) >= 4 { 1 } else { 0 }, 1)
}

test "semantic_spine_same_op_name_different_effects_keep_distinct_contexts" {
