test "semantic_spine_generic_callback_specializes_context" {
  let src = "effect H2HGenericCallback { fn add(v: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { size + align } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf(x: i64) -[H2HGenericCallback]> i64 { H2HGenericCallback.add(x) } fn apply<T>(f: (T) -[H2HGenericCallback]> i64, x: T) -[H2HGenericCallback]> i64 { f(x) } fn main() -> i64 { handle apply<i64>(leaf, 41) { H2HGenericCallback.add(v) -> resume(v + 1) } }"
  Test.assert_eq(if semantic_metric_context_entries(src) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_context_calls(src) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_effect_evidence_inlines(src) > 0 { 1 } else { 0 }, 0)
  Test.assert_eq(semantic_metric_residual_callbacks(src), 0)
}

