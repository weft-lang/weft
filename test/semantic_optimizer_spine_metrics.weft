fn semantic_metric_multi_pred_zero_join_ir() -> IrModule {
  let ne = ir_binary_op_from_parser(6)
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let left_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 0),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ne, 1, 3), ir_inst_list_empty())
  )
  let right_insts = ir_inst_list_prepend(
    ir_inst_const_i64(7, 0),
    ir_inst_list_prepend(ir_inst_binary_i64(8, ne, 1, 7), ir_inst_list_empty())
  )
  let left_split = ir_block_new_term(1, left_insts, ir_term_branch(4, 5, 6))
  let right_split = ir_block_new_term(2, right_insts, ir_term_branch(8, 9, 10))
  let left_true = ir_block_new_term(5, ir_inst_list_empty(), ir_term_jump_args(11, ir_value_list_prepend(1, ir_value_list_empty())))
  let left_false = ir_block_new_term(6, ir_inst_list_prepend(ir_inst_const_i64(12, 0), ir_inst_list_empty()), ir_term_return(12))
  let right_true = ir_block_new_term(9, ir_inst_list_empty(), ir_term_jump_args(11, ir_value_list_prepend(1, ir_value_list_empty())))
  let right_false = ir_block_new_term(10, ir_inst_list_prepend(ir_inst_const_i64(13, 0), ir_inst_list_empty()), ir_term_return(13))
  let merge_params = ir_value_list_prepend(20, ir_value_list_empty())
