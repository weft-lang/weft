effect SemCtxMetricRuntime {
  fn get() -> i64
}

fn sem_ctx_metric_go() -[SemCtxMetricRuntime]> i64 {
  SemCtxMetricRuntime.get()
}

effect SemCtxMetricGeneric {
  fn get() -> i64
}

fn sem_ctx_metric_generic<T>(x: T) -[SemCtxMetricGeneric]> i64 {
  SemCtxMetricGeneric.get()
}

effect SemCtxMetricNestedGeneric {
  fn get() -> i64
}

fn sem_ctx_metric_nested_inner<T>(x: T) -[SemCtxMetricNestedGeneric]> i64 {
  SemCtxMetricNestedGeneric.get()
}

fn sem_ctx_metric_nested_outer<T>(x: T) -[SemCtxMetricNestedGeneric]> i64 {
  sem_ctx_metric_nested_inner<T>(x)
}

fn sem_ctx_metric_raw_store(slot: i64, value: i64) -> i64 {
  mem_store64(slot, value)
  0
}

fn sem_ctx_metric_raw_load_dynamic(slot: i64, offset: i64) -> i64 {
  mem_load64(slot + offset)
}

fn sem_ctx_metric_ptr_store(slot: *mut i64, value: i64) -[Unsafe]> i64 {
  slot.* = value
  0
}

fn sem_ctx_metric_ptr_load(slot: *i64) -[Unsafe]> i64 {
  slot.*
}

fn sem_ctx_metric_ptr_load_store_scenario() -[Unsafe]> i64 {
  let mut slot = 1
  let first = sem_ctx_metric_ptr_load(&slot)
  sem_ctx_metric_ptr_store(&mut slot, 2)
  let second = sem_ctx_metric_ptr_load(&slot)
  first * 10 + second
}

fn sem_ctx_metric_alloc_cell() -> i64 {
  let arena = arena_new(64)
  arena_alloc(arena, 8, 8)
}

test "semantic_spine_e2e_repeated_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_go() + sem_ctx_metric_go() {
    SemCtxMetricRuntime.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_nested_generic_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_nested_outer<i64>(0) + sem_ctx_metric_nested_outer<bool>(true) {
    SemCtxMetricNestedGeneric.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_generic_context_specialized_helper_matches_fallback" {
  let got = handle sem_ctx_metric_generic<i64>(0) + sem_ctx_metric_generic<i64>(1) {
    SemCtxMetricGeneric.get() -> resume(21)
  }
  Test.assert_eq(got, 42)
}

test "semantic_spine_e2e_compiler_data_field_helpers_keep_runtime_semantics" {
  let n = node_new(7, 11, 13, 17, 19)
  Test.assert_eq(node_tag(n) + node_f1(n) + node_f2(n) + node_f3(n) + node_f4(n), 67)
}

test "semantic_spine_e2e_keeps_dead_raw_store_wrapper_call" {
  let arena = arena_new(64)
  let slot = arena_alloc(arena, 8, 8)
  sem_ctx_metric_raw_store(slot, 42)
  Test.assert_eq(mem_load64(slot), 42)
  arena_free(arena)
}

test "semantic_spine_e2e_flushes_load_cse_across_raw_store_wrapper_call" {
  let arena = arena_new(64)
  let slot = arena_alloc(arena, 8, 8)
  mem_store64(slot, 1)
  let first = sem_ctx_metric_raw_load_dynamic(slot, 0)
  sem_ctx_metric_raw_store(slot, 2)
  let second = sem_ctx_metric_raw_load_dynamic(slot, 0)
  Test.assert_eq(first * 10 + second, 12)
  arena_free(arena)
}

test "semantic_spine_e2e_keeps_repeated_raw_alloc_wrapper_calls_distinct" {
  let first = sem_ctx_metric_alloc_cell()
  let second = sem_ctx_metric_alloc_cell()
  Test.assert_eq(if first == second { 0 } else { 1 }, 1)
}

test "semantic_spine_e2e_flushes_pointer_load_cse_across_pointer_store_wrapper_call" {
  let got = handle sem_ctx_metric_ptr_load_store_scenario() {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
  Test.assert_eq(got, 12)
}

test "semantic_spine_inlines_imported_ast_field_load_helpers" {
  let src = "use compiler/lib.{*} fn inspect_node(n: i64) -> i64 { node_tag(n) + node_f1(n) + node_f2(n) } fn main() -> i64 { inspect_node(node_new(7, 11, 13, 17, 19)) }"
  Test.assert_eq(if semantic_metric_direct_call_inlines(src) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_tag"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_f1"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_node", "node_f2"), 0)
}

test "semantic_spine_inlines_imported_type_field_load_helpers" {
  -- The IR candidate closure now admits imported bridge-shaped helpers
  -- (2l): ty_tag/ty_f1 inline like root-source accessors.
  let src = "use compiler/types.{*} fn inspect_type(t: i64) -> i64 { ty_tag(t) + ty_f1(t) } fn main() -> i64 { inspect_type(ty_i64()) }"
  Test.assert_eq(if semantic_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_type", "ty_tag"), 0)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect_type", "ty_f1"), 0)
}

test "semantic_spine_inlines_same_source_constant_offset_load_helper" {
  let src = "fn field1(p: i64) -> i64 { mem_load64(p + 8) } fn inspect(p: i64) -> i64 { field1(p) } fn main() -> i64 { inspect(0) }"
  Test.assert_eq(if semantic_metric_direct_call_inlines(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "field1"), 0)
}

test "semantic_spine_inlines_effect_declared_perform_free_wrapper" {
  -- The declared effect row over-approximates: the body carries no
  -- performs (IrPerformI64 is unsupported in tiny bodies, so any body
  -- with one is structurally rejected), and evidence dispatch happens at
  -- perform sites, so inlining a perform-free wrapper is
  -- effect-transparent. Previously pinned as a call by the accidental
  -- non-support of pseudo bridge hashes.
  let src = "effect H2HLoadEffect { fn get() -> i64 } fn loady(p: i64) -[H2HLoadEffect]> i64 { mem_load64(p) } fn inspect(p: i64) -[H2HLoadEffect]> i64 { loady(p) } fn main() -[H2HLoadEffect]> i64 { inspect(0) }"
  -- 5 -> 6: single-block multi-inline admission (2k) takes one more
  -- wrapper site per program.
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 6)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "loady"), 0)
}

test "semantic_spine_inlines_byte_load_wrapper" {
  -- The pseudo bridge port landed: ldrb through a register address has
  -- identical semantics to the wrapper call.
  let src = "fn load8y(p: i64) -> i64 { mem_load8(p) } fn inspect(p: i64) -> i64 { load8y(p) } fn main() -> i64 { inspect(0) }"
  -- 5 -> 6: single-block multi-inline admission (2k) takes one more
  -- wrapper site per program.
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 6)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load8y"), 0)
}

test "semantic_spine_inlines_dynamic_offset_load_wrapper" {
  -- Pseudo one-address forms compute the address in a register, so a
  -- dynamic offset is the same add + ldr the wrapper performed.
  let src = "fn load_dynamic(p: i64, off: i64) -> i64 { mem_load64(p + off) } fn inspect(p: i64, off: i64) -> i64 { load_dynamic(p, off) } fn main() -> i64 { inspect(0, 8) }"
  -- 5 -> 6: single-block multi-inline admission (2k) takes one more
  -- wrapper site per program.
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 6)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load_dynamic"), 0)
}

test "semantic_spine_inlines_unaligned_constant_offset_load_wrapper" {
  -- aarch64 register-address loads permit unaligned access with the same
  -- semantics the wrapper call had.
  let src = "fn load_unaligned(p: i64) -> i64 { mem_load64(p + 1) } fn inspect(p: i64) -> i64 { load_unaligned(p) } fn main() -> i64 { inspect(0) }"
  -- 5 -> 6: single-block multi-inline admission (2k) takes one more
  -- wrapper site per program.
  Test.assert_eq(semantic_metric_direct_call_inlines(src), 6)
  Test.assert_eq(semantic_metric_call_sites_to_fn(src, "inspect", "load_unaligned"), 0)
}

test "semantic_spine_records_summary_entry_and_call_for_direct_helper" {
  let src = "effect H2HOne { fn get() -> i64 } fn go() -[H2HOne]> i64 { H2HOne.get() } fn main() -> i64 { handle go() { H2HOne.get() -> resume(42) } }"
  Test.assert_eq(if semantic_metric_fact_count(src) >= semantic_metric_summary_count(src) { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_summary_count(src), 0)
  Test.assert_eq(semantic_metric_context_entries(src), 0)
  Test.assert_eq(semantic_metric_context_calls(src), 0)
  Test.assert_eq(semantic_metric_effect_evidence_calls(src), 0)
  Test.assert_eq(semantic_metric_effect_evidence_inlines(src), 0)
}

test "semantic_spine_fact_summary_records_closed_pure_and_effectful_functions" {
  let pure = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let effectful = "effect H2HFactEffect { fn get() -> i64 } fn go() -[H2HFactEffect]> i64 { H2HFactEffect.get() } fn main() -> i64 { handle go() { H2HFactEffect.get() -> resume(42) } }"
  Test.assert_eq(if semantic_metric_fact_count(pure) > 0 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_closed_effect_facts(pure) > 0 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_pure_facts(pure) > 0 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_effectful_facts(effectful) > semantic_metric_effectful_facts(pure) { 1 } else { 0 }, 0)
}

test "semantic_spine_fact_summary_records_alloc_unsafe_and_managed_shapes" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let effects = "effect Alloc { fn alloc(size: i64, align: i64) -> i64 } effect Unsafe { fn touch() -> i64 } fn allocy() -[Alloc]> i64 { 1 } fn unsafey() -[Unsafe]> i64 { 2 } fn main() -[Alloc, Unsafe]> i64 { allocy() + unsafey() }"
  let managed = "fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn leaf() -> i64 { 1 } fn go(f: () -> i64) -> () -> i64 { f } fn main() -> i64 { let f = go(leaf) f() }"
  Test.assert_eq(if semantic_metric_alloc_facts(effects) > semantic_metric_alloc_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_unsafe_facts(effects) > semantic_metric_unsafe_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_managed_param_facts(managed) > semantic_metric_managed_param_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_managed_return_facts(managed) > semantic_metric_managed_return_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(semantic_metric_managed_capture_facts(managed), 0)
}

test "semantic_spine_native_facts_treat_raw_memory_wrappers_as_effectful" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let raw = "fn loady(p: i64, off: i64) -> i64 { mem_load64(p + off) } fn storey(p: i64, value: i64) -> i64 { mem_store64(p, value) 0 } fn main(p: i64) -> i64 { let a = loady(p, 0) storey(p, a + 1) }"
  Test.assert_eq(if semantic_metric_effectful_facts(raw) > semantic_metric_effectful_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_unsafe_facts(raw) > semantic_metric_unsafe_facts(baseline) { 1 } else { 0 }, 0)
}

test "semantic_spine_native_facts_count_raw_callee_in_wrapper_program" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let raw = "fn loady(p: i64, off: i64) -> i64 { mem_load64(p + off) } fn wrap(p: i64, off: i64) -> i64 { loady(p, off) } fn main(p: i64) -> i64 { wrap(p, 0) }"
  Test.assert_eq(if semantic_metric_effectful_facts(raw) > semantic_metric_effectful_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_unsafe_facts(raw) > semantic_metric_unsafe_facts(baseline) { 1 } else { 0 }, 0)
}

test "semantic_spine_native_facts_treat_raw_allocation_wrappers_as_effectful" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let raw = "use runtime/alloc.{*} fn cell() -> i64 { let arena = arena_new(64) arena_alloc(arena, 8, 8) } fn main() -> i64 { let a = cell() if a == 0 { 0 } else { 1 } }"
  Test.assert_eq(if semantic_metric_effectful_facts(raw) > semantic_metric_effectful_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_alloc_facts(raw) > semantic_metric_alloc_facts(baseline) { 1 } else { 0 }, 0)
}

test "semantic_spine_native_facts_treat_pointer_deref_and_store_wrappers_as_effectful" {
  let baseline = "fn go(x: i64) -> i64 { x + 1 } fn main() -> i64 { go(41) }"
  let raw = "fn loadp(p: *i64) -[Unsafe]> i64 { p.* } fn storep(p: *mut i64, value: i64) -[Unsafe]> i64 { p.* = value 0 } fn main(p: *mut i64) -[Unsafe]> i64 { let a = loadp(p) storep(p, a + 1) }"
  Test.assert_eq(if semantic_metric_effectful_facts(raw) > semantic_metric_effectful_facts(baseline) { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_unsafe_facts(raw) > semantic_metric_unsafe_facts(baseline) { 1 } else { 0 }, 0)
}

test "semantic_spine_ir_facts_treat_raw_memory_wrappers_as_effectful" {
  let src = "fn loady(p: i64, off: i64) -> i64 { mem_load64(p + off) } fn storey(p: i64, value: i64) -> i64 { mem_store64(p, value) 0 } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 2 { 1 } else { 0 }, 0)
}

test "semantic_spine_ir_facts_treat_pointer_deref_and_store_wrappers_as_effectful" {
  let src = "fn addr() -[Unsafe]> i64 { let x = 1 let p = &x p.* } fn loadp(p: *i64) -[Unsafe]> i64 { p.* } fn storep(p: *mut i64, value: i64) -[Unsafe]> i64 { p.* = value 0 } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 2 { 1 } else { 0 }, 1)
}

test "semantic_spine_ir_keeps_dead_pointer_store_wrapper_call" {
  let src = "fn storep(p: *mut i64, value: i64) -[Unsafe]> i64 { p.* = value 0 } fn main(p: *mut i64) -[Unsafe]> i64 { storep(p, 1) 0 }"
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites(src), 0)
}

test "semantic_spine_ir_facts_propagate_raw_memory_effects_through_wrappers" {
  let src = "fn loady(p: i64, off: i64) -> i64 { mem_load64(p + off) } fn wrap(p: i64, off: i64) -> i64 { loady(p, off) } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 2 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 2 { 1 } else { 0 }, 0)
}

test "semantic_spine_ir_facts_treat_imported_mutator_wrapper_as_effectful" {
  let src = "use stdlib/vector.{*} fn mutates(vec: Vector<i64>) -> i64 { vector_set<i64>(vec, 0, 1) 0 } fn main(vec: Vector<i64>) -> i64 { mutates(vec) 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites(src), 0)
}

test "semantic_spine_ir_facts_treat_lowered_vector_ops_as_safe_memory" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn read(vec: i64) -> i64 { vector_get<i64>(vec, 0, 0) } fn mutates(vec: i64) -> i64 { vector_set<i64>(vec, 0, 1) 0 } fn main(vec: i64) -> i64 { let a = read(vec) mutates(vec) let b = read(vec) a + b }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_ir_unsafe_facts(src), 0)
  Test.assert_eq(semantic_metric_ir_call_count(src), 0)
  Test.assert_eq(semantic_metric_ir_vector_get_count(src), 3)
  Test.assert_eq(semantic_metric_ir_vector_set_count(src), 2)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites(src), 0)
}

test "semantic_spine_ir_facts_treat_vector_len_as_safe_memory" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn leny(vec: i64) -> i64 { vector_len(vec) } fn main(vec: i64) -> i64 { leny(vec) }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_ir_unsafe_facts(src), 0)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites(src), 0)
}

test "semantic_spine_function_facts_propagate_raw_memory_effects_through_deep_wrappers" {
  let src = "fn loady(p: i64) -> i64 { mem_load64(p) } fn wrap1(p: i64) -> i64 { loady(p) } fn wrap2(p: i64) -> i64 { wrap1(p) } fn wrap3(p: i64) -> i64 { wrap2(p) } fn main(p: i64) -> i64 { wrap3(p) }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 4 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_unsafe_facts(src) >= 4 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_effectful_facts(src) >= 4 { 1 } else { 0 }, 0)
  Test.assert_eq(if semantic_metric_unsafe_facts(src) >= 4 { 1 } else { 0 }, 0)
}

test "semantic_spine_callback_effect_facts_consume_transitive_function_facts" {
  let src = "use stdlib/list.{*} fn loady(p: i64) -> i64 { mem_load64(p) } fn raw_map(x: i64) -> i64 { loady(x) } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { list_fold<i64, i64>(list_map<i64, i64>(list_range(0, 3), raw_map), 0, add) }"
  Test.assert_eq(if semantic_metric_callback_effect_facts(src) >= 1 { 1 } else { 0 }, 0)
  Test.assert_eq(semantic_metric_fusion_count(src), 0)
}

test "semantic_spine_ir_facts_treat_raw_allocation_wrappers_as_effectful" {
  let src = "use runtime/alloc.{*} fn cell() -> i64 { let arena = arena_new(64) arena_alloc(arena, 8, 8) } fn main() -> i64 { 0 }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(src) >= 1 { 1 } else { 0 }, 1)
  -- All-module semantic facts: the imported runtime/alloc.weft functions
  -- now carry facts and are honestly flagged as allocating.
  Test.assert_eq(if semantic_metric_ir_alloc_facts(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites("use runtime/alloc.{*} fn cell() -> i64 { let arena = arena_new(64) arena_alloc(arena, 8, 8) } fn main() -> i64 { cell() 0 }"), 0)
}

test "semantic_spine_ir_facts_treat_effect_sugar_as_effectful" {
  let try_src = "effect Fail { fn fail(error: i64) -> i64 } type SemanticTryResult<T> { Ok(T), Err(i64) } fn semantic_ok(v: i64) -> SemanticTryResult<i64> { Ok<i64>(v) } fn main() -[Fail]> i64 { semantic_ok(1)? }"
  let maybe_src = "effect Maybe { fn none() -> i64 } type SemanticMaybeBox { value: i64 } fn main(box: SemanticMaybeBox) -[Maybe]> i64 { box?.value }"
  Test.assert_eq(if semantic_metric_ir_effectful_facts(try_src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_effectful_facts(maybe_src) >= 1 { 1 } else { 0 }, 1)
}

test "semantic_spine_ir_cse_keeps_duplicate_raw_memory_wrapper_calls" {
  let src = "fn loady(p: i64) -> i64 { mem_load64(p) } fn main(p: i64) -> i64 { let a = loady(p) let b = loady(p) a + b }"
  Test.assert_eq(semantic_metric_ir_call_count(src), 3)
}

test "semantic_spine_ir_cse_flushes_pure_calls_across_raw_store_wrapper" {
  let src = "fn pure_value(x: i64) -> i64 { x + 1 } fn storey(p: i64, value: i64) -> i64 { mem_store64(p, value) 0 } fn main(p: i64, x: i64) -> i64 { let a = pure_value(x) storey(p, a) let b = pure_value(x) a + b }"
  Test.assert_eq(semantic_metric_ir_call_count(src), 2)
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites(src), 0)
}

test "semantic_spine_ir_cse_keeps_repeated_raw_alloc_wrapper_calls" {
  let src = "use runtime/alloc.{*} fn cell() -> i64 { let arena = arena_new(64) arena_alloc(arena, 8, 8) } fn main() -> i64 { let a = cell() let b = cell() if a == b { 0 } else { 1 } }"
  -- Lowering-time leaf inlining drops the original 541 calls to 430,
  -- opening the IR candidate closure to imported modules (2l) takes the
  -- imported accessor/bridge wrappers too (409), all-module semantic
  -- facts open the fact-gated pure path for imported helpers (305), and
  -- tiny-pure chain closure collapses helper-calling helpers: 294.
  -- 294 -> 300: heap_alloc's arena-chaining exhaustion arm (2q slice
  -- 0) adds arena/diagnostic calls in the runtime module.
  -- 300 -> 308: the binned heap free lists (2q slice 2) add bin
  -- push/pop calls in the runtime module.
  -- 308 -> 328: deep release (2q slice 2 stage B) adds the worklist
  -- walk, pending-list push, and promoted-field recursion calls in the
  -- runtime module.
  -- 328 -> 331: runtime-owned buffer frees (2q) add heap calls; the
  -- 2r slice-0 generic handle-body inline removes discharge-helper
  -- calls — net +3 in the runtime module.
  -- 331 -> 333: rc fast-path flattening (2r slice 1a) adds the
  -- promoted-slow helper and bounds-update calls.
  -- 333 -> 335: fused ctor-alloc and deep-walk free fast paths (2r)
  -- add slow-path fallback calls.
  -- 335 -> 334: inlining the deep-release child guard (2r) drops the
  -- has_magic / promoted-raw / header helper calls from the walk's
  -- inner loop. Pins move DOWN when calls are removed.
  -- 334 -> 335: word-unrolled mem_zero is multi-block, so it stops
  -- qualifying for tiny-pure chain collapse — callers that previously
  -- spliced the byte loop inline now emit a real call, and its own
  -- mem_fill8 call is gone; net +1.
  -- 335 -> 328: multi-block tiny-fn inlining (2k slice B') splices
  -- small pure unmanaged branchy helpers (guarded accessors,
  -- arithmetic pickers) into their runtime-module callers. The alloc
  -- path itself is untouched: arena_new/arena_alloc/heap_alloc/
  -- alloc_words/mem_zero/mem_copy all contain raw stores, which the
  -- splice whitelist rejects. Pins move DOWN when calls are removed.
  -- 328 -> 327: the bump-restore segment fix adds base-slot reads while
  -- the self-contained descriptor rework (arena/heap headers at the
  -- head of their own mappings) removes the descriptor bump-alloc and
  -- field-zeroing calls from arena_new/arena_free/heap_destroy; net -1
  -- in the runtime module.
  -- 327 -> 328: stage 2 (managed multi-block inlining + materialised
  -- copy insts) shifts which runtime helper sites collapse; one
  -- previously chain-collapsed call survives as a real call. The alloc
  -- path remains store-gated out of the candidate set.
  -- 328 -> 327: the trap-arm unlock under loop-gated splicing takes
  -- one match-bodied runtime helper site back inline.
  -- 327 -> 336: single-block candidate admission (2k, post intrinsic-
  -- site guard). Splicing a wrapper whose body itself contains k > 1
  -- calls duplicates those inner calls at every splice site — the
  -- wrapper call disappears but its inner calls multiply, so a module
  -- ledger that counts remaining calls moves UP even as call depth
  -- (and wall time) drops.
  -- 336 -> 350: compiler-managed vector/buffer headers (2s item 5)
  -- add finalizer descriptor decode, non-promoted/promoted container
  -- walks, and explicit raw-buffer ownership-transfer helpers. After
  -- single-block admission folds their tiny wrappers, fourteen new
  -- runtime-module call sites remain in the all-module IR ledger.
  -- 350 -> 384: persistent collection family regions (2s item 8) add
  -- segment allocation/growth/destruction, promoted owner locking,
  -- managed-element cleanup registration, and the region finalizer's
  -- release walk. The all-module ledger therefore sees 34 honest
  -- runtime calls even though the metric source itself is unchanged.
  -- 384 -> 388: lazy family-region promotion adds the O(1) descriptor
  -- recognition hook plus promoted/unpromoted allocator selection.
  -- Four helper calls survive the all-module optimiser after their
  -- single-block wrappers splice.
  -- 388 -> 399: dynamic-dispatch masking (2t) threads the runtime-state
  -- pointer and frame-prev reads through handler_find_entry, and A13.3
  -- reclaimed-span release adds the page-bound/mmap/memset helper calls
  -- on the restore paths.
  -- 399 -> 400: the 4j J3 trusted cleanup-chain splice helper reads the
  -- runtime-state pointer through one explicit call.
  -- 400 -> 401: the trusted panic boundary's impossible syscall-return path
  -- recurses through sys_exit, keeping its `never` signature honest.
  -- 401 -> 418: persistent payload-kind cleanup (4h) adds the typed
  -- retain/release dispatch, family-ledger registration, and raw-word
  -- conversion helpers required before CHAMP can own generic payloads.
  -- 418 -> 415: generic-call borrowed-parameter propagation removes
  -- three wrapper-layer ownership calls while preserving the owned
  -- stake at each capturing leaf.
  -- 415 -> 445: fixed-array managed backing (4e C) adds descriptor
  -- allocation/finalization, flattened leaf release and promotion dispatch,
  -- and exact-size backing-store reclamation. After tiny wrappers splice,
  -- thirty honest trusted-runtime calls remain in the all-module ledger.
  -- 445 -> 477: managed aggregate layout descriptors add shape validation,
  -- arbitrary-offset leaf release/promotion, and described allocation. After
  -- tiny wrappers splice, thirty-two honest trusted-runtime calls remain.
  -- 477 -> 484: suspended-generator cleanup contexts add the prompt cleanup
  -- enable/count/drop calls and the raw cleanup invocation boundary.
  -- 484 -> 486: positional abort-cleanup native uses add the fact scan and
  -- shared allocator-use producer calls; both are live compiler work.
  -- 486 -> 531: generic Par work carriers (4l) add descriptor validation,
  -- typed result publication/take, promotion, and scoped cleanup calls. The
  -- 45 surviving calls are the trusted runtime cost of arbitrary-T transport.
  -- 531 -> 532: package-lock symlink containment adds the sealed lstat
  -- wrapper call; its syscall-number helper is pure and adds no call site.
  -- 532 -> 534: typed file streaming adds the sealed fsync and lseek wrappers;
  -- their syscall-number helpers inline, leaving one sys_raw call apiece.
  -- 534 -> 535: terminal TTY detection adds the sealed ioctl wrapper; its
  -- syscall-number helper inlines, leaving one honest sys_raw call.
  -- 535 -> 564: old-arena RC validation, shared root-manifest loading, and
  -- the typed diagnostic transport add 29 honest runtime/compiler calls to
  -- the all-module ledger. The unchanged source still calls cell twice.
  -- 564 -> 565: exactly-once transitive promotion replaces the opaque mark
  -- helper with an explicit lock/check/unlock first-visit claim; after helper
  -- splicing, one additional lock boundary remains in the runtime ledger.
  -- 565 -> 578: drop-guided reuse adds the token producer/consumer runtime
  -- paths and the measurement-only success hook. Thirteen honest helper calls
  -- survive the all-module optimiser; the source still calls cell twice.
  -- 578 -> 571: compiler-generated ownership transport becomes the semantic
  -- IrManagedStakeI64 fact until the native boundary. Seven retain/release
  -- operations therefore leave this deliberately raw-call-only ledger; the
  -- managed-stake matrix pins their identity, polarity, and ABI materialisation.
  -- 571 -> 563: scalar-lane ABI facts admit ordinary f32/f64 helpers to the
  -- multi-block splice. Eight surviving wrapper calls disappear from the
  -- unchanged all-module corpus; the two allocation calls in this probe
  -- remain effectful and distinct.
  -- 563 -> 580: evidence-aware closure environment cloning and heap-owned
  -- Spawn carriers add seventeen honest clone/release/publication calls to
  -- the trusted runtime graph. The probe's two allocations remain distinct.
  -- 580 -> 583: the event-loop clock leaves each install the canonical
  -- platform Time policy. Their three calls remain honestly effectful in the
  -- all-module ledger; the probe's allocations are still distinct.
  -- 583 -> 585: exact suspended-owned cleanup separates prompt-only drop from
  -- capture-owner drop; the two trusted cleanup calls remain effectful.
  -- 585 -> 586: target-semantic anonymous map and fixed-remap bridges replace
  -- the single six-operand raw mmap wrapper. The split preserves one honest
  -- additional platform call site while removing Darwin policy from runtime.
  -- 586 -> 603: target-semantic file open modes, close, namespace operations,
  -- and normalized errors add seventeen honest calls across the trusted
  -- runtime graph. The probe's two allocations remain effectful and distinct.
  -- 603 -> 611: direct and residual production streaming handlers each call
  -- the four target-neutral open adapters. Those eight calls are effectful
  -- policy leaves and must remain visible to the all-module fact fixpoint.
  -- 611 -> 634: target-neutral directory inspection, normalized metadata,
  -- current-directory discovery, and namespace mutation add twenty-three
  -- honest calls across the trusted runtime graph. The optimizer consumes
  -- their effect facts instead of treating the semantic wrappers as pure.
  -- 634 -> 642: the sealed entropy and DNS transport ABI adds eight honest
  -- calls -- one CSPRNG read plus the two address-family queries, the
  -- sockaddr-prefix bridge, the UDP and TCP socket kinds, connect, and the
  -- receive-deadline option. The optimizer consumes their effect facts
  -- instead of treating the semantic wrappers as pure.
  -- 642 -> 641: deleting the raw Darwin-numbered `open` removes its `sys_raw`
  -- call site; its callers reach the platform through the semantic open leaves,
  -- whose own calls were already in this ledger.
  -- 641 -> 642: `sys_native_host_target` adds one sealed wrapper call site, so
  -- the default lowering target can read the host instead of assuming Darwin.
  Test.assert_eq(semantic_metric_ir_call_count(src), 642)
}

test "semantic_spine_all_module_facts_keep_dead_runtime_calls" {
  -- All-module facts must not make trusted-ring functions look pure:
  -- the body-flag fixpoint marks raw memory/syscall bodies effectful,
  -- so a dead call into the runtime ring is never pure-call DCE'd.
  Test.assert_eq(semantic_metric_ir_pure_call_dce_sites("use runtime/alloc.{*} fn main() -> i64 { arena_new(64) 0 }"), 0)
}

test "semantic_spine_all_module_facts_cover_imported_pure_helpers" {
  -- Imported pure helpers now carry facts (the fact plane is built with
  -- user_src == 0), which is what opens the fact-gated tiny-inline and
  -- pure-DCE paths for them.
  let src = "use compiler/sha256.{*} fn main(x: i64) -> i64 { u32(x) }"
  Test.assert_eq(if semantic_metric_ir_pure_facts(src) >= 1 { 1 } else { 0 }, 1)
}

test "semantic_spine_block_entry_narrowing_folds_nested_variant_tag" {
  let src = "use stdlib/option.{*} fn main(flag: i64) -> i64 { let x = option_some<i64>(flag) match x { Some(v) -> match x { Some(w) -> w None -> 0 } None -> 0 } }"
  Test.assert_eq(if semantic_metric_ir_block_entry_narrowing_sites(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_const_fold_sites(src) >= semantic_metric_ir_block_entry_narrowing_sites(src) { 1 } else { 0 }, 1)
}

test "semantic_spine_block_entry_negative_narrowing_folds_impossible_nested_variant_tag" {
  let src = "use stdlib/option.{*} fn main(flag: i64) -> i64 { let x = option_none<i64>() match x { Some(v) -> 0 None -> match x { Some(w) -> w None -> 7 } } }"
  Test.assert_eq(if semantic_metric_ir_block_entry_narrowing_sites(src) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if semantic_metric_ir_const_fold_sites(src) >= semantic_metric_ir_block_entry_narrowing_sites(src) { 1 } else { 0 }, 1)
}

test "semantic_spine_block_entry_payload_origin_aliases_known_constructor_payload" {
  let src = "type PayloadOriginOpt { PayloadSome(i64), PayloadNone } fn main(flag: i64) -> i64 { let x = PayloadSome(flag) match x { PayloadSome(v) -> v PayloadNone -> 0 } }"
  -- The surviving payload extraction (count 1) is the tripwire for the
  -- disabled payload-origin fold. Narrowing sites are no longer a clean
  -- proxy: multi-block inlining (2k slice B') splices branchy runtime
  -- guard helpers module-wide and their entry facts count here — 19 once
  -- match-bodied helpers qualify (trap-arm unlock) and the aggregate
  -- descriptor validator adds one branchy shape guard,
  -- none of them payload-origin (the fold would have consumed the
  -- extraction above).
  -- Generic Par carrier validation and state transitions (4l) add twelve
  -- further imported-runtime narrowing sites; none inspect this payload.
  -- Typed diagnostic union projection adds twenty imported compiler entry
  -- facts; none inspect or fold this program's constructor payload.
  -- Evidence-aware closure environment sizing adds four imported runtime
  -- branch facts; none inspect this constructor payload either.
  Test.assert_eq(semantic_metric_ir_variant_payload_count(src), 1)
  Test.assert_eq(semantic_metric_ir_block_entry_narrowing_sites(src), 55)
}

test "semantic_spine_block_entry_payload_origin_translates_block_params" {
  let opt = pipeline_optimise_ir(semantic_metric_block_param_payload_origin_ir())
  -- Variant-payload const-folding is disabled pending the dominance fix
  -- (unsound across blocks), so payload-origin block-param translation no
  -- longer folds the nested match: the Match inst (tag 15) survives (1) and
  -- the payload-origin narrowing does not fire (0). Restore to 0 / 1 when the
  -- variant-payload fold is re-enabled with dominance-keyed origin facts.
  Test.assert_eq(ir_function_list_count_tag(pipeline_ir_functions(opt), 15), 1)
  Test.assert_eq(if pipeline_ir_block_entry_narrowing_sites(opt) >= 1 { 1 } else { 0 }, 0)
}

