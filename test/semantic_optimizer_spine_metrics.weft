fn semantic_metric_ir_vector_get_check_mode_inst(inst: IrInst, mode: i64) -> i64 {
  match inst {
    IrVectorGetI64(dst, vec, index, fallback, check_mode) -> if check_mode == mode { 1 } else { 0 }
    _ -> 0
  }
}

fn semantic_metric_ir_vector_set_check_mode_inst(inst: IrInst, mode: i64) -> i64 {
  match inst {
    IrVectorSetI64(dst, vec, index, value, check_mode) -> if check_mode == mode { 1 } else { 0 }
    _ -> 0
  }
}

fn semantic_metric_ir_vector_get_check_mode_insts(insts: IrInstList, mode: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> semantic_metric_ir_vector_get_check_mode_inst(inst, mode) + semantic_metric_ir_vector_get_check_mode_insts(rest, mode)
  }
}

fn semantic_metric_ir_vector_set_check_mode_insts(insts: IrInstList, mode: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> semantic_metric_ir_vector_set_check_mode_inst(inst, mode) + semantic_metric_ir_vector_set_check_mode_insts(rest, mode)
  }
}

fn semantic_metric_ir_vector_get_check_mode_blocks(blocks: IrBlockList, mode: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> semantic_metric_ir_vector_get_check_mode_insts(insts, mode) + semantic_metric_ir_vector_get_check_mode_blocks(rest, mode)
      }
    }
  }
}

fn semantic_metric_ir_vector_set_check_mode_blocks(blocks: IrBlockList, mode: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> semantic_metric_ir_vector_set_check_mode_insts(insts, mode) + semantic_metric_ir_vector_set_check_mode_blocks(rest, mode)
      }
    }
  }
}

fn semantic_metric_ir_vector_get_check_mode_functions(fns: IrFunctionList, mode: i64) -> i64 {
  match fns {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, param_count, blocks, src) -> semantic_metric_ir_vector_get_check_mode_blocks(blocks, mode) + semantic_metric_ir_vector_get_check_mode_functions(rest, mode)
      }
    }
  }
}

fn semantic_metric_ir_vector_set_check_mode_functions(fns: IrFunctionList, mode: i64) -> i64 {
  match fns {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, param_count, blocks, src) -> semantic_metric_ir_vector_set_check_mode_blocks(blocks, mode) + semantic_metric_ir_vector_set_check_mode_functions(rest, mode)
      }
    }
  }
}

fn semantic_metric_block_param_payload_origin_ir() -> IrModule {
  let payloads = ir_value_list_prepend(0, ir_value_list_empty())
  let init = ir_inst_list_prepend(ir_inst_variant_init_i64(1, 424242, payloads, 0), ir_inst_list_empty())
  let jump_args = ir_value_list_prepend(1, ir_value_list_prepend(0, ir_value_list_empty()))
  let entry = ir_block_new_term(0, init, ir_term_jump_args(1, jump_args))
  let target_params = ir_value_list_prepend(2, ir_value_list_prepend(3, ir_value_list_empty()))
  let payload = ir_inst_list_prepend(ir_inst_variant_payload_i64(4, 2, 0), ir_inst_list_empty())
  let target = ir_block_new_params(1, target_params, payload, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(target, ir_block_list_empty()))
  pipeline_ir_module(ir_function_list_prepend(ir_function_new_blocks(777777, 1, blocks), ir_function_list_empty()))
}

fn semantic_metric_multi_pred_ctor_join_ir() -> IrModule {
  let payload_a = ir_value_list_prepend(0, ir_value_list_empty())
  let payload_b = ir_value_list_prepend(1, ir_value_list_empty())
  let then_init = ir_inst_list_prepend(ir_inst_variant_init_i64(2, 515151, payload_a, 0), ir_inst_list_empty())
  let else_init = ir_inst_list_prepend(ir_inst_variant_init_i64(3, 515151, payload_b, 0), ir_inst_list_empty())
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_init, ir_term_jump_args(3, ir_value_list_prepend(2, ir_value_list_empty())))
  let else_block = ir_block_new_term(2, else_init, ir_term_jump_args(3, ir_value_list_prepend(3, ir_value_list_empty())))
  let merge_params = ir_value_list_prepend(4, ir_value_list_empty())
  let merge_insts = ir_inst_list_prepend(ir_inst_variant_tag_i64(5, 4), ir_inst_list_empty())
  let merge_block = ir_block_new_params(3, merge_params, merge_insts, ir_term_return(5))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_prepend(merge_block, ir_block_list_empty()))))
  pipeline_ir_module(ir_function_list_prepend(ir_function_new_blocks(888888, 2, blocks), ir_function_list_empty()))
}

fn semantic_metric_branch_bool_fact_ir() -> IrModule {
  let then_insts = ir_inst_list_prepend(
    ir_inst_const_i64(1, 1),
    ir_inst_list_prepend(ir_inst_binary_i64(2, ir_binary_op_eq(), 0, 1), ir_inst_list_empty())
  )
  let else_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 0),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_eq(), 0, 3), ir_inst_list_empty())
  )
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let then_block = ir_block_new_term(1, then_insts, ir_term_return(2))
  let else_block = ir_block_new_term(2, else_insts, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_block, ir_block_list_prepend(else_block, ir_block_list_empty())))
  pipeline_ir_module(ir_function_list_prepend(ir_function_new_blocks(888889, 1, blocks), ir_function_list_empty()))
}

fn semantic_metric_multi_pred_bool_join_ir() -> IrModule {
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let left_split = ir_block_new_term(1, ir_inst_list_empty(), ir_term_branch(1, 3, 4))
  let right_split = ir_block_new_term(2, ir_inst_list_empty(), ir_term_branch(1, 5, 6))
  let left_true = ir_block_new_term(3, ir_inst_list_empty(), ir_term_jump_args(7, ir_value_list_prepend(1, ir_value_list_empty())))
  let left_false = ir_block_new_term(4, ir_inst_list_prepend(ir_inst_const_i64(5, 0), ir_inst_list_empty()), ir_term_return(5))
  let right_true = ir_block_new_term(5, ir_inst_list_empty(), ir_term_jump_args(7, ir_value_list_prepend(1, ir_value_list_empty())))
  let right_false = ir_block_new_term(6, ir_inst_list_prepend(ir_inst_const_i64(6, 0), ir_inst_list_empty()), ir_term_return(6))
  let merge_params = ir_value_list_prepend(2, ir_value_list_empty())
  let merge_insts = ir_inst_list_prepend(
    ir_inst_const_i64(3, 1),
    ir_inst_list_prepend(ir_inst_binary_i64(4, ir_binary_op_eq(), 2, 3), ir_inst_list_empty())
  )
  let merge_block = ir_block_new_params(7, merge_params, merge_insts, ir_term_return(4))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(left_split, ir_block_list_prepend(right_split, ir_block_list_prepend(left_true, ir_block_list_prepend(left_false, ir_block_list_prepend(right_true, ir_block_list_prepend(right_false, ir_block_list_prepend(merge_block, ir_block_list_empty()))))))))
  pipeline_ir_module(ir_function_list_prepend(ir_function_new_blocks(888890, 2, blocks), ir_function_list_empty()))
}

fn semantic_metric_branch_bool_term_prune_ir() -> IrModule {
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_branch(0, 1, 2))
  let then_branch = ir_block_new_term(1, ir_inst_list_empty(), ir_term_branch(0, 3, 4))
  let else_block = ir_block_new_term(2, ir_inst_list_prepend(ir_inst_const_i64(1, 20), ir_inst_list_empty()), ir_term_return(1))
  let live_then = ir_block_new_term(3, ir_inst_list_prepend(ir_inst_const_i64(2, 30), ir_inst_list_empty()), ir_term_return(2))
  let dead_else = ir_block_new_term(4, ir_inst_list_prepend(ir_inst_call_i64(3, 999999, ir_value_list_empty()), ir_inst_list_empty()), ir_term_return(3))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(then_branch, ir_block_list_prepend(else_block, ir_block_list_prepend(live_then, ir_block_list_prepend(dead_else, ir_block_list_empty())))))
  pipeline_ir_module(ir_function_list_prepend(ir_function_new_blocks(888891, 1, blocks), ir_function_list_empty()))
}

