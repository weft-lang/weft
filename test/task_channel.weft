use runtime/alloc.{arena_alloc, arena_free, arena_new}
use runtime/memory.{mem_load64, mem_store64}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_new}
use stdlib/task/channel as channel
use stdlib/task/channel.{Channel, ChannelAlreadyClosed, ChannelCapacity, ChannelCapacityError, ChannelCapacityTooLarge, ChannelCapacityZero, ChannelClose, ChannelClosedNow, ChannelDrained, ChannelReceive, ChannelReceived, ChannelSend, ChannelSendAccepted, ChannelSendClosed}
use stdlib/result.{Err, Ok, Result}
use stdlib/task as task

effect ChannelTrace {
  fn mark(digit: i64) -> nil
}

effect ChannelAbort {
  fn stop() -> i64
}

fn channel_capacity_i64(value: usize) -> ChannelCapacity<i64> {
  channel.capacity<i64>(value).expect("valid i64 channel capacity")
}

fn channel_capacity_probe(value: usize) -> i64 {
  match channel.capacity<i64>(value) {
    Ok(capacity) -> 0
    Err(error) -> match error {
      ChannelCapacityZero -> 1
      ChannelCapacityTooLarge -> 2
    }
  }
}

fn channel_send_marked(value: i64) -[Channel<i64>, ChannelTrace]> i64 {
  match Channel<i64>.send(value) {
    ChannelSendAccepted -> {
      ChannelTrace.mark(value)
      value
    }
    ChannelSendClosed(returned) -> {
      ChannelTrace.mark(9)
      0 - returned
    }
  }
}

fn channel_receive_pair() -[Channel<i64>, ChannelTrace]> i64 {
  let first = match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 0
  }
  ChannelTrace.mark(3)
  let second = match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 0
  }
  ChannelTrace.mark(4)
  first * 100 + second
}

fn channel_backpressure_body() -[task.TaskScope, Channel<i64>, ChannelTrace]> i64 {
  let one = task.spawn(() => channel_send_marked(1))
  let two = task.spawn(() => channel_send_marked(2))
  let reader = task.spawn(channel_receive_pair)
  let sent = task.join(one) + task.join(two)
  let received = task.join(reader)
  let closed = match Channel<i64>.close() {
    ChannelClosedNow -> 1
    ChannelAlreadyClosed -> 0
  }
  sent * 10000 + received * 10 + closed
}

fn channel_trace_write(cell: i64, digit: i64) -> i64 {
  mem_store64(cell, mem_load64(cell) * 10 + digit)
}

fn channel_run_sequential_trace(cell: i64) -> i64 {
  handle task.with_sequential_channel(channel_capacity_i64(1), channel_backpressure_body) {
    ChannelTrace.mark(digit) -> {
      channel_trace_write(cell, digit)
      resume(nil)
    }
  }
}

fn channel_run_event_loop_trace(cell: i64) -> i64 {
  handle task.with_event_loop_channel(channel_capacity_i64(1), channel_backpressure_body) {
    ChannelTrace.mark(digit) -> {
      channel_trace_write(cell, digit)
      resume(nil)
    }
  }
}

fn channel_wait_for_close() -[Channel<i64>]> i64 {
  match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 1
  }
}

fn channel_close_once() -[Channel<i64>]> i64 {
  match Channel<i64>.close() {
    ChannelClosedNow -> 1
    ChannelAlreadyClosed -> 0
  }
}

fn channel_receiver_close_body() -[task.TaskScope, Channel<i64>]> i64 {
  let receiver = task.spawn(channel_wait_for_close)
  let closer = task.spawn(channel_close_once)
  task.join(receiver) * 10 + task.join(closer)
}

fn channel_send_status(value: i64) -[Channel<i64>]> i64 {
  match Channel<i64>.send(value) {
    ChannelSendAccepted -> value
    ChannelSendClosed(returned) -> returned * 10
  }
}

fn channel_sender_close_body() -[task.TaskScope, Channel<i64>]> i64 {
  let first = task.spawn(() => channel_send_status(1))
  let blocked = task.spawn(() => channel_send_status(2))
  let closer = task.spawn(channel_close_once)
  task.join(first) * 100 + task.join(blocked) + task.join(closer)
}

fn channel_drain_body() -[task.TaskScope, Channel<i64>]> i64 {
  let sent = channel_send_status(7)
  let closed = channel_close_once()
  let first = match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 0
  }
  let second = match Channel<i64>.receive() {
    ChannelReceived(value) -> 0 - value
    ChannelDrained -> 1
  }
  let closed_again = match Channel<i64>.close() {
    ChannelClosedNow -> 0
    ChannelAlreadyClosed -> 1
  }
  sent * 1000 + closed * 100 + first * 10 + second + closed_again
}

fn channel_inner_body() -[task.TaskScope, Channel<i64>]> i64 {
  let sent = channel_send_status(9)
  let received = match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 0
  }
  channel_close_once()
  sent * 10 + received
}

fn channel_nested_body() -[task.TaskScope, Channel<i64>]> i64 {
  let outer_sent = channel_send_status(4)
  let inner = task.with_sequential_channel(channel_capacity_i64(1), channel_inner_body)
  let outer_received = match Channel<i64>.receive() {
    ChannelReceived(value) -> value
    ChannelDrained -> 0
  }
  channel_close_once()
  outer_sent * 1000 + inner * 10 + outer_received
}

fn channel_probe_send(value: RuntimeRcProbe) -[Channel<RuntimeRcProbe>]> i64 {
  match Channel<RuntimeRcProbe>.send(value) {
    ChannelSendAccepted -> 1
    ChannelSendClosed(returned) -> runtime_rc_probe_count(returned)
  }
}

fn channel_abort_body(
  first: RuntimeRcProbe,
  second: RuntimeRcProbe
) -[task.TaskScope, Channel<RuntimeRcProbe>, ChannelAbort]> i64 {
  let filling = task.spawn(() => channel_probe_send(first))
  let blocked = task.spawn(() => channel_probe_send(second))
  let aborting = task.spawn(() => ChannelAbort.stop())
  let accepted = task.join(filling)
  accepted + task.join(blocked) + task.join(aborting)
}

test "channel capacity rejects zero and runtime-index overflow" {
  let huge: usize = 9223372036854775808
  Test.assert_eq(channel_capacity_probe(0), 1)
  Test.assert_eq(channel_capacity_probe(huge), 2)
  Test.assert_eq(channel_capacity_probe(1), 0)
}

test "sequential bounded channel suspends a full producer in FIFO order" {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  Test.assert_eq(channel_run_sequential_trace(cell), 31021)
  Test.assert_eq(mem_load64(cell), 1324)
  arena_free(arena)
}

test "event loop bounded channel matches sequential backpressure semantics" {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  Test.assert_eq(channel_run_event_loop_trace(cell), 31021)
  Test.assert_eq(mem_load64(cell), 1324)
  arena_free(arena)
}

test "close wakes an empty-channel receiver exactly once" {
  Test.assert_eq(
    task.with_sequential_channel(channel_capacity_i64(1), channel_receiver_close_body),
    11
  )
}

test "close wakes a full-channel sender and returns its value" {
  Test.assert_eq(
    task.with_sequential_channel(channel_capacity_i64(1), channel_sender_close_body),
    121
  )
}

test "close drains accepted values and remains idempotent" {
  Test.assert_eq(
    task.with_sequential_channel(channel_capacity_i64(1), channel_drain_body),
    7172
  )
}

test "nested same-type channel handlers keep nearest scope identity" {
  Test.assert_eq(
    task.with_sequential_channel(channel_capacity_i64(1), channel_nested_body),
    4994
  )
}

test "outward abort drops buffered and suspended managed values" {
  let first = runtime_rc_probe_new(11)
  let second = runtime_rc_probe_new(22)
  let capacity = channel.capacity<RuntimeRcProbe>(1).expect("valid managed channel capacity")
  let got = handle task.with_sequential_channel(capacity, () => channel_abort_body(first, second)) {
    ChannelAbort.stop() -> 7
  }
  Test.assert_eq(got, 7)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(second), 1)
}
