use runtime/panic.{*}

test "checked index address uses explicit storage facts" {
  Test.assert_eq(runtime_index_address(100, 3, 0, 8), 100)
  Test.assert_eq(runtime_index_address(100, 3, 2, 8), 116)
}

test "checked index address accepts the last usize value only for a larger length" {
  Test.assert_eq(runtime_index_address(7, 4294967296, 4294967295, 1), 4294967302)
}

fn guarded_address(data: i64, len: usize, index: usize, stride: usize) -> i64 {
  if index < len { runtime_index_address(data, len, index, stride) } else { 0 - 999 }
}

test "proved address arithmetic preserves full width unsigned inputs" {
  let maximum: usize = 18446744073709551615
  Test.assert_eq(guarded_address(7, maximum, maximum - 1, 8), 0 - 9)
  Test.assert_eq(guarded_address(7, 9223372036854775810, 9223372036854775809, 1), 0 - 9223372036854775800)
  Test.assert_eq(guarded_address(7, maximum, maximum - 1, 0), 7)
  Test.assert_eq(guarded_address(7, maximum, maximum, 8), 0 - 999)
  Test.assert_eq(guarded_address(7, 0, 0, 8), 0 - 999)
}
