use module_fixtures/g2_trait_left as left
use module_fixtures/g2_trait_right as right

type QualifiedBoundBox { value: i64 }

impl left.Gauge for QualifiedBoundBox {
  fn left(self) -> i64 { self.value }
}

impl right.Gauge for QualifiedBoundBox {
  fn right(self) -> i64 { self.value + 1 }
}

fn read_left<T: left.Gauge>(value: T) -> i64 { value.left() }
fn read_right<T>(value: T) -> i64 where T: right.Gauge { value.right() }

fn read_both<T: left.Gauge & right.Gauge>(value: T) -> i64 {
  value.left() + value.right()
}

fn read_both_reversed<T>(value: T) -> i64 where T: right.Gauge & left.Gauge {
  value.right() + value.left()
}

trait QualifiedBoundCarrier {
  type Item: left.Gauge
  fn value(self) -> Self.Item
}

impl QualifiedBoundCarrier for QualifiedBoundBox {
  type Item = QualifiedBoundBox
  fn value(self) -> QualifiedBoundBox { self }
}

test "qualified trait bounds retain exact declarations" {
  let box = QualifiedBoundBox { value: 41 }
  Test.assert_eq(read_left<QualifiedBoundBox>(box), 41)
  Test.assert_eq(read_right<QualifiedBoundBox>(box), 42)
}

test "qualified receiver signatures preserve identity in either bound order" {
  let box = QualifiedBoundBox { value: 41 }
  Test.assert_eq(read_both<QualifiedBoundBox>(box), 83)
  Test.assert_eq(read_both_reversed<QualifiedBoundBox>(box), 83)
}
