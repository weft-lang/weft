use stdlib/list as list
use stdlib/list.{List}
use stdlib/option
use stdlib/result
use stdlib/string
use stdlib/tensor as tensor
use stdlib/tensor.{Tensor, TensorCoordinates, TensorDimensions, TensorElementCountMismatch, TensorShapeOverflow}

fn tensor_dimensions(values: [usize]) -> TensorDimensions { list.from_slice(values) }

fn tensor_coordinates(values: [usize]) -> TensorCoordinates { list.from_slice(values) }

fn tensor_f64_same(left: f64, right: f64) -> bool { left == right }

test "tensor_shape_retains_rank_dimensions_and_size" {
  let dimensions: [usize; 3] = [2, 3, 4]
  let shape = tensor.shape_from_slice(dimensions[..]).unwrap()
  Test.assert_eq_usize(shape.rank(), 3)
  Test.assert_eq_usize(shape.len(), 24)
  Test.assert_eq_usize(shape.dimension(0).unwrap(), 2)
  Test.assert_eq_usize(shape.dimension(1).unwrap(), 3)
  Test.assert_eq_usize(shape.dimension(2).unwrap(), 4)
  Test.assert_true(shape.dimension(3).is_none())
  Test.assert_false(shape.is_empty())
}

test "tensor_scalar_and_zero_extent_shapes_have_exact_cardinality" {
  let scalar_dimensions: [usize; 0] = []
  let scalar = tensor.shape_from_slice(scalar_dimensions[..]).unwrap()
  Test.assert_eq_usize(scalar.rank(), 0)
  Test.assert_eq_usize(scalar.len(), 1)

  let empty_dimensions: [usize; 3] = [4, 0, 9]
  let empty = tensor.shape(tensor_dimensions(empty_dimensions[..])).unwrap()
  Test.assert_eq_usize(empty.rank(), 3)
  Test.assert_eq_usize(empty.len(), 0)
  Test.assert_true(empty.is_empty())
}

test "tensor_shape_overflow_is_typed" {
  let dimensions: [usize; 2] = [18446744073709551615, 2]
  match tensor.shape_from_slice(dimensions[..]) {
    Err(TensorShapeOverflow(accumulated, dimension)) -> {
      Test.assert_eq_usize(accumulated, 18446744073709551615)
      Test.assert_eq_usize(dimension, 2)
    }
    _ -> Test.assert_true(false)
  }
}

test "tensor_from_slice_preserves_row_major_values" {
  let dimensions: [usize; 2] = [2, 3]
  let values: [i64; 6] = [10, 11, 12, 20, 21, 22]
  let value = tensor.from_slice<i64>(tensor.shape_from_slice(dimensions[..]).unwrap(), values[..]).unwrap()
  Test.assert_eq_usize(value.rank(), 2)
  Test.assert_eq_usize(value.len(), 6)
  let first: [usize; 2] = [0, 0]
  let middle: [usize; 2] = [1, 1]
  let last: [usize; 2] = [1, 2]
  Test.assert_eq(value.get(tensor_coordinates(first[..])).unwrap(), 10)
  Test.assert_eq(value.get(tensor_coordinates(middle[..])).unwrap(), 21)
  Test.assert_eq(value.get(tensor_coordinates(last[..])).unwrap(), 22)
  Test.assert_eq(value.get_flat(4).unwrap(), 21)
}

test "tensor_rejects_every_coordinate_shape_mismatch" {
  let dimensions: [usize; 2] = [2, 3]
  let value = tensor.filled<i64>(tensor.shape_from_slice(dimensions[..]).unwrap(), 7)
  let too_few: [usize; 1] = [1]
  let too_many: [usize; 3] = [1, 2, 0]
  let outer_high: [usize; 2] = [2, 0]
  let inner_high: [usize; 2] = [0, 3]
  Test.assert_true(value.get(tensor_coordinates(too_few[..])).is_none())
  Test.assert_true(value.get(tensor_coordinates(too_many[..])).is_none())
  Test.assert_true(value.get(tensor_coordinates(outer_high[..])).is_none())
  Test.assert_true(value.get(tensor_coordinates(inner_high[..])).is_none())
  Test.assert_false(value.set(tensor_coordinates(too_few[..]), 1))
  Test.assert_false(value.set(tensor_coordinates(inner_high[..]), 1))
  Test.assert_true(value.get_flat(6).is_none())
  Test.assert_false(value.set_flat(6, 1))
}

test "tensor_mutation_updates_only_the_selected_position" {
  let dimensions: [usize; 2] = [2, 2]
  let value = tensor.filled<f64>(tensor.shape_from_slice(dimensions[..]).unwrap(), 1.5)
  let selected: [usize; 2] = [1, 0]
  Test.assert_true(value.set(tensor_coordinates(selected[..]), 9.25))
  Test.assert_true(tensor_f64_same(value.get_flat(0).unwrap(), 1.5))
  Test.assert_true(tensor_f64_same(value.get_flat(1).unwrap(), 1.5))
  Test.assert_true(tensor_f64_same(value.get_flat(2).unwrap(), 9.25))
  Test.assert_true(tensor_f64_same(value.get_flat(3).unwrap(), 1.5))
}

test "tensor_data_length_mismatch_is_typed" {
  let dimensions: [usize; 2] = [2, 2]
  let values: [i64; 3] = [1, 2, 3]
  match tensor.from_slice<i64>(tensor.shape_from_slice(dimensions[..]).unwrap(), values[..]) {
    Err(TensorElementCountMismatch(expected, actual)) -> {
      Test.assert_eq_usize(expected, 4)
      Test.assert_eq_usize(actual, 3)
    }
    _ -> Test.assert_true(false)
  }
}

test "generic_tensor_preserves_managed_values" {
  let dimensions: [usize; 1] = [2]
  let values = ["alpha".concat("!"), "beta".repeat(2)]
  let tensor_value = tensor.from_slice<str>(tensor.shape_from_slice(dimensions[..]).unwrap(), values[..]).unwrap()
  let first: [usize; 1] = [0]
  let second: [usize; 1] = [1]
  Test.assert_str_eq(tensor_value.get(tensor_coordinates(first[..])).unwrap(), "alpha!")
  Test.assert_str_eq(tensor_value.get(tensor_coordinates(second[..])).unwrap(), "betabeta")
  Test.assert_true(tensor_value.set(tensor_coordinates(first[..]), "updated".repeat(2)))
  Test.assert_str_eq(tensor_value.get_flat(0).unwrap(), "updatedupdated")
  Test.assert_str_eq(tensor_value.get_flat(1).unwrap(), "betabeta")
}
