}

test "ckg_combined_family_checker_clean" {
  let b = buf_new(16384)
  ckg_prelude(b)
  ckg_combined_fn(b, 8)
  ckg_combined_fn(b, 16)
  ckg_main(b)
  let native = ckg_native(b)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ckg_floor(pipeline_native_ck_checked_count(native), 60), 1)
}
