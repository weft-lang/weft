use compiler/pipeline.{*}
use compiler/ir.{*}
use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/lib.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}
use runtime/buffer.{*}

fn following_block(id: i64) -> IrBlockList {
  IrBlockListCons(IrBlock(id, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)
}

test "fallthrough follows emission order rather than numeric block identity" {
  let layout = IrBlockListCons(IrBlock(100, IrValueNil, IrInstNil, IrTermJump(7, IrValueNil)), following_block(7))
  Test.assert_true(pipeline_ir_native_block_follows(layout, 100))
  Test.assert_true(not pipeline_ir_native_block_follows(layout, 7))
  Test.assert_true(not pipeline_ir_native_block_follows(layout, 101))
  Test.assert_true(not pipeline_ir_native_block_follows(IrBlockListNil, 0))
}

test "conditional edges keep the correct predicate when either successor follows" {
  -- Every AArch64 comparison condition used by integer and IEEE domains.
  for condition in [0, 1, 2, 3, 4, 5, 8, 9, 10, 11, 12, 13] {
    let true_next = buf_new(0)
    let true_patch = pipeline_ir_native_emit_conditional_edges(true_next, 0, 0, 100, 7, condition, following_block(100))
    Test.assert_eq(buf_len(true_next), 4)
    Test.assert_eq(node_f2(true_patch), condition)
    Test.assert_eq(node_f3(true_patch), 7)
    Test.assert_eq(node_f4(true_patch), 0)
    let false_next = buf_new(0)
    let false_patch = pipeline_ir_native_emit_conditional_edges(false_next, 0, 0, 100, 7, condition, following_block(7))
    Test.assert_eq(buf_len(false_next), 4)
    Test.assert_eq(node_f2(false_patch), condition bxor 1)
    Test.assert_eq(node_f3(false_patch), 100)
    Test.assert_eq(node_f4(false_patch), 0)
  }
}

test "nonadjacent and final edges retain explicit branch targets" {
  for layout in [following_block(33), IrBlockListNil] {
    let code = buf_new(0)
    let patches = pipeline_ir_native_emit_conditional_edges(code, 0, 0, 100, 7, 10, layout)
    Test.assert_eq(buf_len(code), 8)
    Test.assert_eq(node_f3(patches), 100)
    Test.assert_eq(node_f2(patches), pipeline_ir_native_patch_uncond())
    let conditional = node_f4(patches)
    Test.assert_eq(node_f3(conditional), 7)
    Test.assert_eq(node_f2(conditional), 10)
    Test.assert_eq(node_f4(conditional), 0)
  }
}

test "fallthrough preserves value transport under the residency audit" {
  let source = "fn choose(flag: bool, a: i64, b: i64) -> i64 { let first = if flag { a } else { b } let second = if flag { b } else { a } first * 10 + second } fn main() -> i64 { choose(true, 2, 3) + choose(false, 2, 3) - 55 }"
  let typed = probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0)
  let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let native = pipeline_lower_native_module_with_audit(typed, optimized, 1)
  Test.assert_eq(fmap_emit_error_count(pipeline_native_fmap(native)), 0)
}

fn choose_values(flag: bool, a: i64, b: i64) -> i64 {
  let first = if flag { a } else { b }
  let second = if flag { b } else { a }
  first * 10 + second
}

fn rotate_values(count: i64) -> i64 {
  let mut first = 1
  let mut second = 2
  for index in 0..count {
    let previous = first
    first = second
    second = previous
  }
  first * 10 + second
}

test "forward merges preserve the selected values on both paths" {
  Test.assert_eq(choose_values(true, 2, 3), 23)
  Test.assert_eq(choose_values(false, 2, 3), 32)
  Test.assert_eq(choose_values(true, 0 - 2, 3), 0 - 17)
  Test.assert_eq(choose_values(false, 0 - 2, 3), 28)
}

test "backedges preserve cyclic value transfers and zero iterations" {
  Test.assert_eq(rotate_values(0), 12)
  Test.assert_eq(rotate_values(1), 21)
  Test.assert_eq(rotate_values(2), 12)
  Test.assert_eq(rotate_values(9), 21)
  Test.assert_eq(rotate_values(10), 12)
}
