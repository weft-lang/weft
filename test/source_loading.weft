use compiler/source/input.{SourceRequest, SourceLoadResult, SourceLoaded, SourceUnavailable}
use compiler/source/loading.{source_loader, source_loader_load, source_loader_register, source_loader_owners}
use compiler/source/owners as source_owners
use compiler/source/owners.{SourceOwners}
use runtime/string.{runtime_str_from_bytes_copy}
use runtime/rc.{rc_count}
use stdlib/source.{Source}
use stdlib/panic.{panic}
use stdlib/diagnostic/schema.{DiagnosticSourceNamed, DiagnosticSourceBuffer}
use stdlib/state as state
use stdlib/state.{State}

fn request(path: str, package_id: i64) -> SourceRequest {
  SourceRequest { physical_path: path, logical_path: path, package_id: package_id }
}

fn loaded(result: SourceLoadResult) -> Source {
  match result { SourceLoaded(source) -> source, SourceUnavailable -> panic("expected a loaded source") }
}

fn missing(result: SourceLoadResult) -> bool {
  match result { SourceUnavailable -> true, SourceLoaded(_) -> false }
}

fn detached_sources() -> SourceOwners {
  let loader = source_loader((input: SourceRequest) => {
    let text = runtime_str_from_bytes_copy(__str_ptr("retained source"), 15)
    SourceLoaded(Source { text: text, identity: DiagnosticSourceNamed(input.physical_path) })
  }, source_owners.new())
  source_loader_load(loader, request("detached.weft", 7))
  source_loader_owners(loader)
}

test "source snapshots retain text after the acquisition scope is destroyed" {
  let owners = detached_sources()
  for index in 0..256 {
    let churn = runtime_str_from_bytes_copy(__str_ptr("xxxxxxxxxxxxxxx"), 15)
    Test.assert_eq_usize(churn.len(), 15)
  }
  let source = loaded(source_owners.lookup(owners, request("detached.weft", 7)))
  Test.assert_str_eq(source.text, "retained source")
  Test.assert_eq(rc_count(__str_ptr(source.text) - 16), 1)
}

test "combining source snapshots shares the retained string stake" {
  let original = detached_sources()
  let combined = source_owners.combined(original, source_owners.combined(original, original))
  let source = loaded(source_owners.lookup(combined, request("detached.weft", 7)))
  Test.assert_eq(rc_count(__str_ptr(source.text) - 16), 1)
  Test.assert_str_eq(source.text, "retained source")
}

test "inherited sources require no acquisition authority" {
  let acquire = (input: SourceRequest) => { State<i64>.put(99); SourceUnavailable }
  let loader = source_loader(acquire, detached_sources())
  let (result, observed) = state.run(0, () => source_loader_load(loader, request("detached.weft", 7)))
  Test.assert_eq(observed, 0)
  Test.assert_str_eq(loaded(result).text, "retained source")
}

test "repeated module requests acquire once and retain the same source instance" {
  let acquire = (input: SourceRequest) => {
    state.modify((count: i64) => count + 1)
    SourceLoaded(Source { text: "", identity: DiagnosticSourceNamed(input.physical_path) })
  }
  let loader = source_loader(acquire, source_owners.new())
  let ((first, second), observed) = state.run(0, () => {
    let first = loaded(source_loader_load(loader, request("empty.weft", 7)))
    let second = loaded(source_loader_load(loader, request("empty.weft", 7)))
    (first, second)
  })
  Test.assert_eq(observed, 1)
  Test.assert_eq(__str_ptr(first.text), __str_ptr(second.text))
  Test.assert_eq_usize(first.text.len(), 0)
}

test "missing sources are explicit and do not become cached empty modules" {
  let acquire = (input: SourceRequest) => { state.modify((count: i64) => count + 1); SourceUnavailable }
  let loader = source_loader(acquire, source_owners.new())
  let ((first, second), observed) = state.run(0, () => {
    let first = source_loader_load(loader, request("missing.weft", 7))
    let second = source_loader_load(loader, request("missing.weft", 7))
    (first, second)
  })
  Test.assert_true(missing(first) and missing(second))
  Test.assert_eq(observed, 2)
  Test.assert_true(missing(source_owners.lookup(source_loader_owners(loader), request("missing.weft", 7))))
}

test "source snapshots do not observe later acquisition" {
  let loader = source_loader((input: SourceRequest) => SourceLoaded(Source { text: input.logical_path, identity: DiagnosticSourceNamed(input.physical_path) }), source_owners.new())
  source_loader_load(loader, request("first.weft", 0))
  let first = source_loader_owners(loader)
  source_loader_load(loader, request("second.weft", 0))
  let second = source_loader_owners(loader)
  Test.assert_true(missing(source_owners.lookup(first, request("second.weft", 0))))
  Test.assert_str_eq(loaded(source_owners.lookup(second, request("second.weft", 0))).text, "second.weft")
  Test.assert_str_eq(loaded(source_owners.lookup(first, request("first.weft", 0))).text, "first.weft")
}

test "shared immutable text does not merge distinct module instances" {
  for text in ["", "pub type Value { value: i64 }"] {
    let source = Source { text: text, identity: DiagnosticSourceNamed("provided.weft") }
    let loader = source_loader((input: SourceRequest) => SourceLoaded(source), source_owners.new())
    let first = loaded(source_loader_load(loader, request("first.weft", 0)))
    let second = loaded(source_loader_load(loader, request("second.weft", 0)))
    Test.assert_true(__str_ptr(first.text) != __str_ptr(second.text))
    Test.assert_str_eq(first.text, second.text)
    Test.assert_true(match second.identity { DiagnosticSourceNamed(path) -> path == "provided.weft", _ -> false })
  }
}

test "registered overlays also separate shared source storage" {
  let text = ""
  let source = Source { text: text, identity: DiagnosticSourceBuffer(__str_ptr(text)) }
  let loader = source_loader((input: SourceRequest) => SourceUnavailable, source_owners.new())
  source_loader_register(loader, request("shared.weft", 1), source)
  source_loader_register(loader, request("shared.weft", 2), source)
  let first = loaded(source_loader_load(loader, request("shared.weft", 1)))
  let second = loaded(source_loader_load(loader, request("shared.weft", 2)))
  Test.assert_true(__str_ptr(first.text) != __str_ptr(second.text))
  Test.assert_true(match second.identity { DiagnosticSourceBuffer(buffer) -> buffer == __str_ptr(second.text), _ -> false })
}

test "source lookup traverses deep shared ownership without recursive calls" {
  let retained = detached_sources()
  let mut owners = source_owners.new()
  for index in 0..10000 { owners = source_owners.combined(owners, source_owners.with_text(source_owners.new(), "padding")) }
  owners = source_owners.combined(owners, retained)
  Test.assert_str_eq(loaded(source_owners.lookup(owners, request("detached.weft", 7))).text, "retained source")
  Test.assert_true(missing(source_owners.lookup(owners, request("absent.weft", 7))))
}
