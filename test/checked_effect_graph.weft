-- Checked effects retain exact semantic identities without raw checker nodes.

use compiler/project/identity.{
  DeclarationIdentity,
  EffectDeclaration,
  EffectOperationDeclaration,
  HandlerImplementationIdentity,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleFunctionIdentity,
  ModuleIdentity,
  handler_implementation_identity,
  named_module_identity
}
use compiler/project/identity/equality.{
  declaration_identity_eq,
  handler_implementation_identity_eq
}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI64,
  SemanticNil,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_id_eq,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  SemanticTypeCatalogInserted,
  semantic_type_catalog_builder
}
use compiler/weft/check/body/effects.{*}
use compiler/weft/check/body/graph.{*}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn types(
  module: ModuleIdentity,
  dependency: ModuleIdentity
) -> (SemanticTypeCatalog, SemanticTypeId, SemanticTypeId) {
  let local_builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (local_builder, local) = local_builder.primitive(SemanticNil)
  let dependency_builder = semantic_type_graph_builder(semantic_type_segment_id(dependency))
  let (dependency_builder, imported) = dependency_builder.primitive(SemanticI64)
  let catalog = semantic_type_catalog_builder(2)
  let catalog = match catalog.insert(local_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected local semantic type segment")
  }
  let catalog = match catalog.insert(dependency_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected imported semantic type segment")
  }
  (catalog.freeze(), local, imported)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn effect_declaration(module: ModuleIdentity) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    module,
    EffectDeclaration,
    source_from_text("State").all()
  )
}

fn operation(
  owner: DeclarationIdentity,
  name: str
) -> DeclarationIdentity {
  MemberDeclarationIdentity(
    owner,
    EffectOperationDeclaration,
    source_from_text(name).all()
  )
}

fn completion_code(completion: CheckedHandlerCompletion) -> i64 {
  match completion {
    CheckedHandlerAborts -> 1
    CheckedHandlerResumes -> 2
    CheckedHandlerMixed -> 3
    CheckedHandlerDeferred -> 4
  }
}

test "checked performs retain declarations imported atoms and arguments" {
  let module = named_module_identity("fixture/effect_perform", 71)
  let dependency = named_module_identity("dependency/effect_atom", 44)
  let (catalog, local, imported) = types(module, dependency)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("perform"),
    catalog,
    3
  )
  let (expressions, argument) = expressions.integer(7, imported, range(0, 1))
  let (expressions, arguments) = expressions.expression_list()
  let (expressions, arguments) = expressions.expression_list_push(arguments, argument)
  let (expressions, arguments) = expressions.finish_expression_list(arguments)
  let owner = effect_declaration(dependency)
  let member = operation(owner, "get")
  let effects = checked_effect_builder(expressions, 1)
  let (effects, detail) = effects.perform(
    expressions,
    CheckedPerform {
      effect_declaration: owner,
      operation: member,
      atom: imported,
      arguments: arguments
    }
  )
  let (expressions, performed) = expressions.perform(detail, local, range(0, 7))
  let effect_graph = effects.freeze()
  let expression_graph = expressions.freeze()

  Test.assert_true(
    match effect_graph.kind(detail) { CheckedPerformDetailKind -> true, _ -> false }
  )
  Test.assert_true(
    match effect_graph.inspect(detail) {
      CheckedPerformDetail(value) ->
        declaration_identity_eq(value.effect_declaration, owner) and
        declaration_identity_eq(value.operation, member) and
        semantic_type_id_eq(value.atom, imported) and
        expression_graph.expression_list_len(value.arguments) == 1 and
        checked_expr_id_eq(expression_graph.expression_list_at(value.arguments, 0), argument)
      _ -> false
    }
  )
  Test.assert_true(
    match expression_graph.kind(performed) { CheckedPerformKind -> true, _ -> false }
  )
  Test.assert_eq_usize(
    checked_effect_expr_id_ordinal(expression_graph.perform_detail(performed)),
    checked_effect_expr_id_ordinal(detail)
  )
}

test "checked handlers retain parameters continuations completions and return clauses" {
  let module = named_module_identity("fixture/effect_handle", 71)
  let dependency = named_module_identity("dependency/effect_handle", 44)
  let (catalog, local, imported) = types(module, dependency)
  let function = ModuleFunctionIdentity(module, 0)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("handle fixture"),
    catalog,
    8
  )
  let (expressions, parameter) = expressions.binding(
    function,
    imported,
    range(0, 1),
    CheckedImmutableBinding
  )
  let (expressions, continuation) = expressions.binding(
    function,
    imported,
    range(1, 2),
    CheckedImmutableBinding
  )
  let (expressions, returned) = expressions.binding(
    function,
    imported,
    range(2, 3),
    CheckedImmutableBinding
  )
  let (expressions, body) = expressions.integer(1, imported, range(3, 4))
  let (expressions, resumed) = expressions.resume_expr(body, local, range(4, 5))
  let (expressions, return_body) = expressions.integer(2, imported, range(5, 6))
  let owner = effect_declaration(dependency)
  let member = operation(owner, "put")
  let effects = checked_effect_builder(expressions, 1)
  let (effects, parameters) = effects.parameter_list()
  let (effects, parameters) = effects.parameter_list_push(
    expressions,
    parameters,
    parameter
  )
  let (effects, parameters) = effects.finish_parameter_list(parameters)
  let (effects, clauses) = effects.clause_list()
  let (effects, clauses) = effects.clause_list_push(
    expressions,
    clauses,
    CheckedHandlerClause {
      effect_declaration: owner,
      operation: member,
      atom: imported,
      parameters: parameters,
      continuation: CheckedImmediateHandlerClause,
      body: body,
      completion: CheckedHandlerAborts,
      range: range(10, 11)
    }
  )
  let (effects, clauses) = effects.clause_list_push(
    expressions,
    clauses,
    CheckedHandlerClause {
      effect_declaration: owner,
      operation: member,
      atom: imported,
      parameters: parameters,
      continuation: CheckedImmediateHandlerClause,
      body: resumed,
      completion: CheckedHandlerResumes,
      range: range(11, 12)
    }
  )
  let (effects, clauses) = effects.clause_list_push(
    expressions,
    clauses,
    CheckedHandlerClause {
      effect_declaration: owner,
      operation: member,
      atom: imported,
      parameters: parameters,
      continuation: CheckedImmediateHandlerClause,
      body: body,
      completion: CheckedHandlerMixed,
      range: range(12, 13)
    }
  )
  let (effects, clauses) = effects.clause_list_push(
    expressions,
    clauses,
    CheckedHandlerClause {
      effect_declaration: owner,
      operation: member,
      atom: imported,
      parameters: parameters,
      continuation: CheckedDeferredHandlerClause(continuation),
      body: body,
      completion: CheckedHandlerDeferred,
      range: range(13, 14)
    }
  )
  let (effects, clauses) = effects.finish_clause_list(clauses)
  let (effects, detail) = effects.handle_expr(
    expressions,
    CheckedHandle {
      body: body,
      clauses: clauses,
      return_clause: CheckedHandleReturnClause(returned, return_body)
    }
  )
  let (effects, no_return_detail) = effects.handle_expr(
    expressions,
    CheckedHandle {
      body: body,
      clauses: clauses,
      return_clause: CheckedNoHandleReturn
    }
  )
  let (expressions, handled) = expressions.handle_expr(detail, local, range(0, 14))
  let (expressions, no_return_handle) = expressions.handle_expr(
    no_return_detail,
    local,
    range(0, 14)
  )
  let effect_graph = effects.freeze()
  let expression_graph = expressions.freeze()
  let checked = match effect_graph.inspect(detail) {
    CheckedHandleDetail(value) -> value
    _ -> panic("expected checked handler detail")
  }

  Test.assert_eq_usize(effect_graph.clause_list_len(checked.clauses), 4)
  Test.assert_eq_usize(effect_graph.parameter_list_len(parameters), 1)
  Test.assert_true(
    checked_binding_id_eq(effect_graph.parameter_list_at(parameters, 0), parameter)
  )
  Test.assert_eq(completion_code(effect_graph.clause_list_at(checked.clauses, 0).completion), 1)
  Test.assert_eq(completion_code(effect_graph.clause_list_at(checked.clauses, 1).completion), 2)
  Test.assert_eq(completion_code(effect_graph.clause_list_at(checked.clauses, 2).completion), 3)
  Test.assert_eq(completion_code(effect_graph.clause_list_at(checked.clauses, 3).completion), 4)
  Test.assert_true(
    match effect_graph.clause_list_at(checked.clauses, 3).continuation {
      CheckedDeferredHandlerClause(found) -> checked_binding_id_eq(found, continuation)
      _ -> false
    }
  )
  Test.assert_true(
    match checked.return_clause {
      CheckedHandleReturnClause(found_binding, found_body) ->
        checked_binding_id_eq(found_binding, returned) and
        checked_expr_id_eq(found_body, return_body)
      _ -> false
    }
  )
  Test.assert_true(
    match effect_graph.inspect(no_return_detail) {
      CheckedHandleDetail(value) -> match value.return_clause {
        CheckedNoHandleReturn -> true
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(checked_expr_id_eq(expression_graph.resume_value(resumed), body))
  Test.assert_eq_usize(
    checked_effect_expr_id_ordinal(expression_graph.handle_detail(handled)),
    checked_effect_expr_id_ordinal(detail)
  )
  Test.assert_eq_usize(
    checked_effect_expr_id_ordinal(
      expression_graph.handle_detail(no_return_handle)
    ),
    checked_effect_expr_id_ordinal(no_return_detail)
  )
}

test "checked named handlers retain implementation type arguments and source site" {
  let module = named_module_identity("fixture/effect_install", 71)
  let dependency = named_module_identity("dependency/effect_install", 44)
  let (catalog, local, imported) = types(module, dependency)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("with handler"),
    catalog,
    4
  )
  let (expressions, argument) = expressions.integer(3, imported, range(0, 1))
  let (expressions, body) = expressions.integer(4, imported, range(1, 2))
  let (expressions, arguments) = expressions.expression_list()
  let (expressions, arguments) = expressions.expression_list_push(arguments, argument)
  let (expressions, arguments) = expressions.finish_expression_list(arguments)
  let (expressions, type_arguments) = expressions.type_list()
  let (expressions, type_arguments) = expressions.type_list_push(type_arguments, imported)
  let (expressions, type_arguments) = expressions.finish_type_list(type_arguments)
  let implementation = handler_implementation_identity(dependency)
  let effects = checked_effect_builder(expressions, 1)
  let (effects, detail) = effects.handler_install(
    expressions,
    CheckedHandlerInstall {
      implementation: implementation,
      type_arguments: type_arguments,
      arguments: arguments,
      atom: imported,
      body: body,
      source_site: 29
    }
  )
  let (expressions, installed) = expressions.handler_install(detail, local, range(0, 12))
  let effect_graph = effects.freeze()
  let expression_graph = expressions.freeze()

  Test.assert_true(
    match effect_graph.inspect(detail) {
      CheckedHandlerInstallDetail(value) ->
        handler_implementation_identity_eq(value.implementation, implementation) and
        semantic_type_id_eq(value.atom, imported) and
        value.source_site == 29 and
        checked_expr_id_eq(value.body, body) and
        expression_graph.type_list_len(value.type_arguments) == 1 and
        semantic_type_id_eq(
          expression_graph.type_list_at(value.type_arguments, 0),
          imported
        ) and
        expression_graph.expression_list_len(value.arguments) == 1
      _ -> false
    }
  )
  Test.assert_eq_usize(
    checked_effect_expr_id_ordinal(
      expression_graph.handler_install_detail(installed)
    ),
    checked_effect_expr_id_ordinal(detail)
  )
}
