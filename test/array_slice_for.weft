-- Primitive array/slice for loops lower through the shared indexed-storage
-- fact and bounds path. The binder receives each element by value.

use stdlib/num.{*}
use "runtime/rc_implicit_test.weft"

fn for_sum_array(values: [i64; 4]) -> i64 {
  let mut total = 0
  for value in values {
    total = total + value
  }
  total
}

fn for_sum_slice(values: [i64]) -> i64 {
  let mut total = 0
  for value in values {
    total = total + value
  }
  total
}

fn for_count_slice<T>(values: [T]) -> usize {
  let mut count: usize = 0
  for value in values {
    value
    count = count + 1
  }
  count
}

fn for_first_over_ten(values: [i64]) -> i64 {
  for value in values {
    if value > 10 { return value } else { 0 }
  }
  0
}

fn for_continue_break(values: [i64]) -> i64 {
  let mut total = 0
  for value in values {
    if value == 2 { continue } else { 0 }
    if value == 4 { break } else { 0 }
    total = total + value
  }
  total
}

fn for_temporary_managed_counts(probe: RuntimeRcProbe) -> i64 {
  let mut observed = 0
  for value in [probe, probe] {
    observed = observed * 10 + runtime_rc_probe_count(value)
  }
  observed * 10 + runtime_rc_probe_count(probe)
}

fn for_temporary_managed_break(probe: RuntimeRcProbe) -> i64 {
  for value in [probe, probe] {
    runtime_rc_probe_count(value)
    break
  }
  runtime_rc_probe_count(probe)
}

fn for_temporary_managed_return(probe: RuntimeRcProbe) -> i64 {
  for value in [probe, probe] {
    return runtime_rc_probe_count(value)
  }
  0
}

test "for_iterates_fixed_array_in_order" {
  Test.assert_eq(for_sum_array([10, 20, 5, 7]), 42)
}

test "for_iterates_empty_fixed_array" {
  let values: [i64; 0] = []
  let mut visits = 0
  for value in values {
    visits = visits + value + 1
  }
  Test.assert_eq(visits, 0)
}

test "for_iterates_slice_window" {
  let values = [1, 10, 20, 5, 7, 100]
  Test.assert_eq(for_sum_slice(values[1..5]), 42)
}

test "for_iterates_empty_slice" {
  let values = [1, 2, 3]
  Test.assert_eq(if for_count_slice<i64>(values[2..2]) == 0 { 1 } else { 0 }, 1)
}

test "for_reads_mutable_slice_by_value_without_extending_the_borrow" {
  let mut values = [10, 20, 5, 7]
  let writable: [mut i64] = values[..]
  let mut total = 0
  for value in writable {
    total = total + value
  }
  writable[0] = 42
  Test.assert_eq(total, 42)
  Test.assert_eq(writable[0], 42)
}

test "for_specialises_generic_slice_element_type" {
  let words = ["alpha", "beta", "gamma"]
  Test.assert_eq(if for_count_slice<str>(words[..]) == 3 { 1 } else { 0 }, 1)
}

test "for_handles_cfg_collection_values" {
  let left = [10, 20, 12]
  let right = [1, 2, 3]
  let mut total = 0
  for value in if true { left } else { right } {
    total = total + value
  }
  Test.assert_eq(total, 42)
}

test "for_preserves_exact_float_element_width" {
  let values: [f32; 3] = [1.5, 2.5, 3.0]
  let mut total: f64 = 0.0
  for value in values {
    total = total + num_f32_to_f64(value)
  }
  Test.assert_eq_f64(total, 7.0)
}

test "for_copies_and_cleans_nested_array_elements" {
  let rows: [[i64; 2]; 2] = [[10, 20], [5, 7]]
  let mut total = 0
  for row in rows {
    total = total + row[0] + row[1]
  }
  Test.assert_eq(total, 42)
}

test "for_cleans_managed_items_and_owned_collection_temporary" {
  let probe: RuntimeRcProbe = runtime_rc_probe_new(42)
  Test.assert_eq(for_temporary_managed_counts(probe), 441)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "for_cleans_owned_collection_on_break_and_return" {
  let break_probe: RuntimeRcProbe = runtime_rc_probe_new(1)
  Test.assert_eq(for_temporary_managed_break(break_probe), 1)
  Test.assert_eq(runtime_rc_probe_count(break_probe), 1)
  let return_probe: RuntimeRcProbe = runtime_rc_probe_new(2)
  Test.assert_eq(for_temporary_managed_return(return_probe), 4)
  Test.assert_eq(runtime_rc_probe_count(return_probe), 1)
}

test "for_return_break_and_continue_take_correct_edges" {
  let values = [1, 2, 3, 4, 100]
  Test.assert_eq(for_first_over_ten(values[..]), 100)
  Test.assert_eq(for_continue_break(values[..]), 4)
}
