use stdlib/random as random
use stdlib/bytes.{Bytes}
use stdlib/option.{*}
use stdlib/list.{Cons, List, Nil}
use stdlib/num.{*}
use stdlib/panic.{panic}
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/test/property as prop
use stdlib/test/property.{Arbitrary, ChoiceOutOfRange, Counterexample, Draw, EmptyRange, Falsified, Gen, GenerationExhausted, HandlerContractViolated, InvertedLengthRange, LengthDomainTooWide, NoAlternatives, NoWeightedAlternatives, Passed, SampleExhausted, SampleHandlerContractViolated, Sampled, WeightTotalOverflow, ZeroCases, ZeroWeight}
use stdlib/test/property/enumerate as enumerate
use stdlib/test/property/enumerate.{EnumerationComplete, EnumerationDepthLimitReached, EnumerationPathLimitReached, EnumerationStopped, VisitNext, VisitStop}
use stdlib/test/property/protocol.{ChoiceLog}
use stdlib/test/property/replay as replay
use stdlib/test/property/replay.{ChoiceBoundChanged, ChoiceProgramExhausted, DiscardLimitReached, GeneratorContractViolated, UnusedChoices}
use test/module_fixtures/property_extreme_handler as extreme_handler
use test/module_fixtures/property_extreme_handler.{Exact, Highest, Lowest, Middle}
use stdlib/vector/handles.{PersistentVector, Vector}
use stdlib/utf8 as utf8

effect PropertyProbe {
  fn observe(value: usize) -> usize
}

effect EnumerationProbe {
  fn visit(value: i64) -> enumerate.Visit
}

type ArbitrarySample {
  ArbitrarySample(i64)
}

impl Arbitrary for ArbitrarySample {
  fn arbitrary() -> Gen<ArbitrarySample> {
    prop.map<i64, ArbitrarySample>(prop.constant<i64>(42), value => ArbitrarySample(value))
  }
}

fn property_config(seed: u64, cases: usize) -> prop.Config {
  prop.config(random.seed(seed), cases, 24, 40, 80).expect("positive case budget")
}

fn always_false(value: usize) -[Test]> bool { false }

fn is_42(value: i64) -[Test]> bool { value == 42 }

fn is_false(value: bool) -[Test]> bool { not value }

fn reject_i64(value: i64) -[Test]> bool { false }

fn reject_bool(value: bool) -[Test]> bool { false }

fn in_signed_test_range(value: i64) -[Test]> bool {
  value >= 0 - 5 and value < 6
}

fn in_finite_test_range(value: usize) -[Test]> bool {
  value >= 40 and value < 44
}

fn is_expected_pair(value: (usize, i64)) -[Test]> bool {
  match value {
    (left, right) -> left == 16 and right == 42
  }
}

fn observed_is_8(value: usize) -[PropertyProbe]> bool {
  PropertyProbe.observe(value) == 8
}

fn reject_value(value: usize) -> Option<usize> { None<usize>() }

fn accept_even_half(value: usize) -> Option<usize> {
  if value % 2 == 0 { Some<usize>(value / 2) } else { None<usize>() }
}

fn accept_true(value: bool) -> Option<bool> {
  if value { Some<bool>(value) } else { None<bool>() }
}

fn is_below_four(value: usize) -[Test]> bool { value < 4 }

fn is_arbitrary_sample(value: ArbitrarySample) -[Test]> bool {
  match value { ArbitrarySample(inner) -> inner == 42 }
}

fn is_bounded_canonical_text(value: str) -[Test]> bool {
  let scalars = value.scalar_count()
  utf8.validate(value) and scalars >= 0 and scalars <= 24
}

fn enumerate_all_bool(value: bool) -> enumerate.Visit { VisitNext }

fn enumerate_all_i64(value: i64) -> enumerate.Visit { VisitNext }

fn enumerate_all_pair(value: (bool, bool)) -> enumerate.Visit { VisitNext }

fn enumerate_stop_at_true_false(value: (bool, bool)) -> enumerate.Visit {
  match value {
    (true, false) -> VisitStop
    _ -> VisitNext
  }
}

fn enumerate_probe(value: i64) -[EnumerationProbe]> enumerate.Visit {
  EnumerationProbe.visit(value)
}

fn first_failure(seed: u64) -[Test]> prop.Counterexample {
  let generator = prop.usize_below(10).expect("nonempty generator domain")
  match prop.run(property_config(seed, 20), generator, always_false) {
    Falsified(counterexample) -> counterexample
    Passed(_) -> panic("always-false property passed")
    HandlerContractViolated(_) -> panic("random handler violated Draw")
    _ -> panic("unconstrained generator exhausted")
  }
}

fn first_boolean_failure(seed: u64) -[Test]> prop.Counterexample {
  match prop.run(property_config(seed, 8), prop.boolean(), is_false) {
    Falsified(counterexample) -> counterexample
    Passed(_) -> panic("seeded boolean campaign passed")
    HandlerContractViolated(_) -> panic("random handler violated Draw")
    _ -> panic("boolean generator exhausted")
  }
}

test "property configuration rejects only an empty case campaign" {
  match prop.config(random.seed(1), 0, 0, 0, 0) {
    Err(ZeroCases) -> Test.assert_true(true)
    Ok(_) -> Test.assert_true(false)
  }
  let configured = property_config(9, 7)
  Test.assert_true(configured.seed().value() == 9)
  Test.assert_eq_usize(configured.cases(), 7)
  Test.assert_eq_usize(configured.size(), 24)
  Test.assert_eq_usize(configured.discards(), 40)
  Test.assert_eq_usize(configured.shrinks(), 80)
}

test "constant properties consume no choices" {
  match prop.run(property_config(1, 8), prop.constant<i64>(42), is_42) {
    Passed(summary) -> {
      Test.assert_eq_usize(summary.cases(), 8)
      Test.assert_true(summary.seed().value() == 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "random campaigns capture exact falsifying choices" {
  let counterexample = first_failure(0)
  Test.assert_true(counterexample.seed().value() == 0)
  Test.assert_eq_usize(counterexample.case_index(), 0)
  Test.assert_eq_usize(counterexample.executed_cases(), 1)
  Test.assert_eq_usize(counterexample.limits().size(), 24)
  Test.assert_eq_usize(counterexample.limits().discards(), 40)
  Test.assert_true(counterexample.shrink_count() > 0)
  Test.assert_eq_usize(counterexample.choices().len(), 1)
  let choice = counterexample.choices().get(0).expect("first draw is recorded")
  Test.assert_eq_usize(choice.bound().exclusive_upper(), 10)
  Test.assert_eq_usize(choice.selected(), 0)
}

test "the same seed reproduces the same choice program" {
  let first = first_failure(42).choices().get(0).expect("first run drew once")
  let second = first_failure(42).choices().get(0).expect("second run drew once")
  Test.assert_eq_usize(first.bound().exclusive_upper(), second.bound().exclusive_upper())
  Test.assert_eq_usize(first.selected(), second.selected())
}

test "boolean generation covers its complete typed alternative" {
  let counterexample = first_boolean_failure(0)
  let choices = counterexample.choices()
  let choice = choices.get(0).expect("boolean draw is recorded")
  Test.assert_eq_usize(choice.bound().exclusive_upper(), 2)
  Test.assert_eq_usize(choice.selected(), 1)
}

test "exact replay regenerates the minimized counterexample" {
  let counterexample = first_failure(42)
  let generator = prop.usize_below(10).expect("nonempty generator domain")
  match replay.run(generator, counterexample.limits(), counterexample.choices()) {
    Ok(value) -> Test.assert_eq_usize(value, 0)
    Err(_) -> Test.assert_true(false)
  }
}

test "replay rejects changed exhausted and surplus choice programs" {
  let recorded = first_failure(7).choices()
  let changed = prop.usize_below(9).expect("nonempty generator domain")
  match replay.run(changed, prop.limits(24, 40), recorded) {
    Err(ChoiceBoundChanged(index, original, requested)) -> {
      Test.assert_eq_usize(index, 0)
      Test.assert_eq_usize(original.exclusive_upper(), 10)
      Test.assert_eq_usize(requested.exclusive_upper(), 9)
    }
    _ -> Test.assert_true(false)
  }

  let empty = match prop.run(property_config(1, 1), prop.constant<i64>(1), reject_i64) {
    Falsified(counterexample) -> counterexample.choices()
    _ -> panic("constant failure did not produce an empty choice program")
  }
  match replay.run(prop.boolean(), prop.limits(24, 40), empty) {
    Err(ChoiceProgramExhausted(index, bound)) -> {
      Test.assert_eq_usize(index, 0)
      Test.assert_eq_usize(bound.exclusive_upper(), 2)
    }
    _ -> Test.assert_true(false)
  }

  match replay.run(prop.constant<i64>(1), prop.limits(24, 40), recorded) {
    Err(UnusedChoices(remaining)) -> Test.assert_eq_usize(remaining, 1)
    _ -> Test.assert_true(false)
  }
}

test "check composes with the native Test handler on success" {
  prop.check(property_config(4, 5), prop.constant<i64>(42), is_42)
}

test "scalar ranges retain their complete signed and finite domains" {
  match prop.i64_range(3, 3) {
    Err(EmptyRange) -> Test.assert_true(true)
    Ok(_) -> Test.assert_true(false)
  }
  match prop.usize_range(9, 8) {
    Err(EmptyRange) -> Test.assert_true(true)
    Ok(_) -> Test.assert_true(false)
  }
  let signed = prop.i64_range(0 - 5, 6).expect("nonempty signed interval")
  match prop.run(property_config(90, 80), signed, in_signed_test_range) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 80)
    _ -> Test.assert_true(false)
  }
  let finite = prop.usize_range(40, 44).expect("nonempty finite interval")
  match prop.run(property_config(91, 40), finite, in_finite_test_range) {
    Passed(_) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "map bind sizing and pairs compose without a second effect vocabulary" {
  let sized = prop.sized<usize>(size => prop.constant<usize>(size))
  let resized = prop.resize<usize>(sized, 7)
  let mapped = prop.map<usize, usize>(resized, value => value + 1)
  let bound = prop.bind<usize, usize>(mapped, value => prop.constant<usize>(value * 2))
  let generated = prop.pair<usize, i64>(bound, prop.constant<i64>(42))
  match prop.run(property_config(3, 4), generated, is_expected_pair) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 4)
    _ -> Test.assert_true(false)
  }
}

test "Option and Result generators preserve typed alternatives under replay" {
  let zero_log = match prop.run(property_config(1, 1), prop.boolean(), reject_bool) {
    Falsified(counterexample) -> counterexample.choices()
    _ -> panic("boolean falsification did not produce a choice")
  }
  let one_log = first_boolean_failure(0).choices()

  match replay.run<Option<i64>>(prop.option<i64>(prop.constant<i64>(42)), prop.limits(10, 40), zero_log) {
    Ok(option) -> match option {
      None -> Test.assert_true(true)
      Some(_) -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match replay.run<Option<i64>>(prop.option<i64>(prop.constant<i64>(42)), prop.limits(10, 40), one_log) {
    Ok(option) -> match option {
      Some(value) -> Test.assert_eq(value, 42)
      None -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match replay.run<Result<i64, str>>(prop.result<i64, str>(prop.constant<i64>(42), prop.constant<str>("error")), prop.limits(10, 40), zero_log) {
    Ok(result) -> match result {
      Err(message) -> Test.assert_str_eq(message, "error")
      Ok(_) -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match replay.run<Result<i64, str>>(prop.result<i64, str>(prop.constant<i64>(42), prop.constant<str>("error")), prop.limits(10, 40), one_log) {
    Ok(result) -> match result {
      Ok(value) -> Test.assert_eq(value, 42)
      Err(_) -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "one_of validates its family and replays the selected generator" {
  let empty = Nil<Gen<i64>>()
  match prop.one_of<i64>(empty) {
    Err(NoAlternatives) -> Test.assert_true(true)
    Ok(_) -> Test.assert_true(false)
  }

  let alternatives = Cons<Gen<i64>>(
    prop.constant<i64>(10),
    Cons<Gen<i64>>(prop.constant<i64>(20), Nil<Gen<i64>>())
  )
  let generator = prop.one_of<i64>(alternatives).expect("two alternatives")
  let one_of_failure: Counterexample = match prop.run(property_config(2, 1), generator, reject_i64) {
    Falsified(counterexample) -> counterexample
    _ -> panic("one_of falsification did not produce a choice program")
  }
  Test.assert_eq_usize(one_of_failure.choices().len(), 1)
  let first_log: ChoiceLog = match prop.run(property_config(1, 1), prop.boolean(), reject_bool) {
    Falsified(counterexample) -> counterexample.choices()
    _ -> panic("boolean falsification did not produce a choice")
  }
  Test.assert_eq_usize(first_log.len(), 1)
  match replay.run<i64>(generator, prop.limits(10, 40), first_log) {
    Ok(value) -> Test.assert_eq(value, 10)
    Err(failure) -> match failure {
      ChoiceBoundChanged(_, _, _) -> Test.assert_eq(1, 0)
      ChoiceProgramExhausted(index, _) -> Test.assert_eq_usize(index, 0)
      UnusedChoices(_) -> Test.assert_eq(3, 0)
      DiscardLimitReached(_) -> Test.assert_eq(4, 0)
      GeneratorContractViolated(_) -> Test.assert_eq(5, 0)
    }
  }
}

test "property callbacks preserve unrelated effects" {
  let result = handle prop.run(
    property_config(3, 5),
    prop.constant<usize>(7),
    observed_is_8
  ) {
    PropertyProbe.observe(value) -> resume(value + 1)
  }
  match result {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 5)
    _ -> Test.assert_true(false)
  }
}

test "bounded filter_map refines values without duplicating its input" {
  let source = prop.usize_below(8).expect("nonempty generator domain")
  let refined = prop.filter_map<usize, usize>(source, 20, accept_even_half)
  match prop.run(property_config(8, 30), refined, is_below_four) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 30)
    _ -> Test.assert_true(false)
  }
}

test "bounded filter_map reports exact discard exhaustion" {
  let constrained = prop.filter_map<usize, usize>(prop.constant<usize>(7), 10, reject_value)
  let config = prop.config(random.seed(1), 1, 4, 2, 0).expect("positive case budget")
  match prop.run(config, constrained, always_false) {
    GenerationExhausted(failure) -> match failure {
      prop.DiscardLimitReached(attempts) -> Test.assert_eq_usize(attempts, 3)
    }
    _ -> Test.assert_true(false)
  }

  let empty_choices = match prop.run(property_config(2, 1), prop.constant<i64>(1), reject_i64) {
    Falsified(counterexample) -> counterexample.choices()
    _ -> panic("constant falsification did not produce an empty choice program")
  }
  match replay.run(constrained, prop.limits(4, 2), empty_choices) {
    Err(DiscardLimitReached(attempts)) -> Test.assert_eq_usize(attempts, 3)
    _ -> Test.assert_true(false)
  }
}

test "Arbitrary is ordinary typed generator evidence" {
  match prop.run(property_config(12, 4), prop.gen<ArbitrarySample>(), is_arbitrary_sample) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 4)
    _ -> Test.assert_true(false)
  }
}

test "sample checks custom Draw handlers before exposing a choice" {
  let outcome = handle prop.sample(prop.boolean(), prop.limits(4, 0)) {
    Draw.choose(bound) -> resume(bound.exclusive_upper())
  }
  match outcome {
    SampleHandlerContractViolated(failure) -> match failure {
      ChoiceOutOfRange(selected, bound) -> {
        Test.assert_eq_usize(selected, 2)
        Test.assert_eq_usize(bound.exclusive_upper(), 2)
      }
    }
    Sampled(_) -> Test.assert_true(false)
    SampleExhausted(_) -> Test.assert_true(false)
  }
}

test "integer generators cover their complete fixed-width value sets" {
  let limits = prop.limits(1, 0)
  match with extreme_handler(Lowest) { prop.sample(prop.u8(), limits) } {
    Sampled(value) -> Test.assert_true(__u8_to_u64(value) == 0)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.u16(), limits) } {
    Sampled(value) -> Test.assert_true(__u16_to_u64(value) == 65535)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.u32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value) == 4294967295)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.u64(), limits) } {
    Sampled(value) -> Test.assert_true(value == 18446744073709551615)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.usize(), limits) } {
    Sampled(value) -> Test.assert_true(value == 18446744073709551615)
    _ -> Test.assert_true(false)
  }

  match with extreme_handler(Middle) { prop.sample(prop.i8(), limits) } {
    Sampled(value) -> Test.assert_eq(__i8_to_i64(value), 0 - 128)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Middle) { prop.sample(prop.i16(), limits) } {
    Sampled(value) -> Test.assert_eq(__i16_to_i64(value), 0 - 32768)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Middle) { prop.sample(prop.i32(), limits) } {
    Sampled(value) -> Test.assert_eq(__i32_to_i64(value), 0 - 2147483648)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.i64(), limits) } {
    Sampled(value) -> Test.assert_eq(value, 0 - 1)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.isize(), limits) } {
    Sampled(value) -> Test.assert_eq(__isize_to_i64(value), 0 - 1)
    _ -> Test.assert_true(false)
  }
}

test "floating generators cover complete bit domains" {
  let limits = prop.limits(1, 0)
  match with extreme_handler(Lowest) { prop.sample(prop.f32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value.to_bits()) == 0)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.f32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value.to_bits()) == 4294967295)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.f64(), limits) } {
    Sampled(value) -> Test.assert_true(value.to_bits() == 18446744073709551615)
    _ -> Test.assert_true(false)
  }
}

test "finite f32 generation maps around both nonfinite bands" {
  let limits = prop.limits(1, 0)
  match with extreme_handler(Lowest) { prop.sample(prop.finite_f32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value.to_bits()) == 0)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Middle) { prop.sample(prop.finite_f32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value.to_bits()) == 2147483648)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.finite_f32(), limits) } {
    Sampled(value) -> Test.assert_true(__u32_to_u64(value.to_bits()) == 4286578687)
    _ -> Test.assert_true(false)
  }
}

test "finite f64 generation maps around both nonfinite bands" {
  let limits = prop.limits(1, 0)
  match with extreme_handler(Lowest) { prop.sample(prop.finite_f64(), limits) } {
    Sampled(value) -> Test.assert_true(value.to_bits() == 0)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Exact(9218868437227405312)) { prop.sample(prop.finite_f64(), limits) } {
    Sampled(value) -> Test.assert_true(value.to_bits() == 9223372036854775808)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.finite_f64(), limits) } {
    Sampled(value) -> Test.assert_true(value.to_bits() == 18442240474082181119)
    _ -> Test.assert_true(false)
  }
}

test "Unicode scalar generation excludes the surrogate interval without rejection" {
  let limits = prop.limits(1, 0)
  match with extreme_handler(Lowest) { prop.sample(prop.unicode_scalar(), limits) } {
    Sampled(value) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(prop.unicode_scalar(), limits) } {
    Sampled(value) -> Test.assert_eq(value, 1114111)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Middle) { prop.sample(prop.unicode_scalar(), limits) } {
    Sampled(value) -> Test.assert_true(value < 55296 or value > 57343)
    _ -> Test.assert_true(false)
  }
}

test "bounded string generation counts scalars and always emits canonical UTF-8" {
  let lengths = prop.lengths(2, 5).expect("ordered string length domain")
  match with extreme_handler(Lowest) {
    prop.sample(prop.str(lengths), prop.limits(8, 0))
  } {
    Sampled(value) -> {
      Test.assert_true(utf8.validate(value))
      Test.assert_eq(value.scalar_count(), 2)
      Test.assert_eq(value.len(), 2)
    }
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) {
    prop.sample(prop.str(lengths), prop.limits(4, 0))
  } {
    Sampled(value) -> {
      Test.assert_true(utf8.validate(value))
      Test.assert_eq(value.scalar_count(), 4)
      Test.assert_eq(value.len(), 16)
    }
    _ -> Test.assert_true(false)
  }
}

test "seeded string campaigns cover canonical variable-length text" {
  let lengths = prop.lengths(0, 40).expect("ordered string length domain")
  match prop.run(property_config(97, 100), prop.str(lengths), is_bounded_canonical_text) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 100)
    _ -> Test.assert_true(false)
  }
}

test "enumeration covers finite choices in stable lexicographic order" {
  match enumerate.run(
    prop.boolean(),
    prop.limits(1, 0),
    enumerate.budget(2, 1),
    enumerate_all_bool
  ) {
    EnumerationComplete(paths, values) -> {
      Test.assert_eq_usize(paths, 2)
      Test.assert_eq_usize(values, 2)
    }
    _ -> Test.assert_true(false)
  }

  let pairs = prop.pair<bool, bool>(prop.boolean(), prop.boolean())
  match enumerate.run(pairs, prop.limits(2, 0), enumerate.budget(4, 2), enumerate_stop_at_true_false) {
    EnumerationStopped(paths, values, choices) -> {
      Test.assert_eq_usize(paths, 3)
      Test.assert_eq_usize(values, 3)
      match replay.run(pairs, prop.limits(2, 0), choices) {
        Ok((left, right)) -> Test.assert_true(left and not right)
        Err(_) -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "enumeration reports path and choice-depth bounds exactly" {
  let pairs = prop.pair<bool, bool>(prop.boolean(), prop.boolean())
  match enumerate.run(pairs, prop.limits(2, 0), enumerate.budget(3, 2), enumerate_all_pair) {
    EnumerationPathLimitReached(paths, values) -> {
      Test.assert_eq_usize(paths, 3)
      Test.assert_eq_usize(values, 3)
    }
    _ -> Test.assert_true(false)
  }

  match enumerate.run(prop.boolean(), prop.limits(1, 0), enumerate.budget(1, 0), enumerate_all_bool) {
    EnumerationDepthLimitReached(paths, values, position, bound) -> {
      Test.assert_eq_usize(paths, 1)
      Test.assert_eq_usize(values, 0)
      Test.assert_eq_usize(position, 0)
      Test.assert_eq_usize(bound.exclusive_upper(), 2)
    }
    _ -> Test.assert_true(false)
  }

  match enumerate.run(prop.constant<i64>(42), prop.limits(0, 0), enumerate.budget(1, 0), enumerate_all_i64) {
    EnumerationComplete(paths, values) -> {
      Test.assert_eq_usize(paths, 1)
      Test.assert_eq_usize(values, 1)
    }
    _ -> Test.assert_true(false)
  }

  match enumerate.run(prop.constant<i64>(42), prop.limits(0, 0), enumerate.budget(0, 0), enumerate_all_i64) {
    EnumerationPathLimitReached(paths, values) -> {
      Test.assert_eq_usize(paths, 0)
      Test.assert_eq_usize(values, 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "enumeration counts rejected paths without visiting a specimen" {
  let accepted = prop.filter_map<bool, bool>(prop.boolean(), 1, accept_true)
  match enumerate.run(accepted, prop.limits(1, 0), enumerate.budget(2, 1), enumerate_all_bool) {
    EnumerationComplete(paths, values) -> {
      Test.assert_eq_usize(paths, 2)
      Test.assert_eq_usize(values, 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "enumeration preserves visitor effects" {
  let outcome = handle enumerate.run(
    prop.constant<i64>(42),
    prop.limits(0, 0),
    enumerate.budget(1, 0),
    enumerate_probe
  ) {
    EnumerationProbe.visit(value) -> resume(if value == 42 { VisitNext } else { VisitStop })
  }
  match outcome {
    EnumerationComplete(paths, values) -> {
      Test.assert_eq_usize(paths, 1)
      Test.assert_eq_usize(values, 1)
    }
    _ -> Test.assert_true(false)
  }
}

test "collection length domains are typed inclusive and size bounded" {
  match prop.lengths(4, 3) {
    Err(InvertedLengthRange) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let maximum: usize = 18446744073709551615
  match prop.lengths(0, maximum) {
    Err(LengthDomainTooWide) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }

  let lengths = prop.lengths(2, 5).expect("ordered length domain")
  Test.assert_eq_usize(lengths.minimum(), 2)
  Test.assert_eq_usize(lengths.maximum(), 5)

  match with extreme_handler(Highest) {
    prop.sample(prop.list(prop.constant<i64>(7), lengths), prop.limits(3, 0))
  } {
    Sampled(values) -> {
      Test.assert_eq_usize(values.len(), 3)
      Test.assert_eq(values.get(0).unwrap_or(0), 7)
    }
    _ -> Test.assert_true(false)
  }

  match with extreme_handler(Highest) {
    prop.sample(prop.vector(prop.constant<i64>(8), lengths), prop.limits(3, 0))
  } {
    Sampled(values) -> {
      Test.assert_eq_usize(values.len(), 3)
      Test.assert_eq(values.get(2).unwrap_or(0), 8)
    }
    _ -> Test.assert_true(false)
  }

  match with extreme_handler(Highest) {
    prop.sample(prop.persistent_vector(prop.constant<i64>(9), lengths), prop.limits(3, 0))
  } {
    Sampled(values) -> {
      Test.assert_eq_usize(values.len(), 3)
      Test.assert_eq(values.get(1).unwrap_or(0), 9)
    }
    _ -> Test.assert_true(false)
  }

  match with extreme_handler(Highest) {
    prop.sample(prop.bytes(lengths), prop.limits(0, 0))
  } {
    Sampled(values) -> Test.assert_eq_usize(values.len(), 2)
    _ -> Test.assert_true(false)
  }
}

test "uniform and weighted alternatives preserve declared choice domains" {
  let limits = prop.limits(1, 0)
  let binary = prop.either<i64>(prop.constant<i64>(10), prop.constant<i64>(20))
  match with extreme_handler(Lowest) { prop.sample(binary, limits) } {
    Sampled(value) -> Test.assert_eq(value, 10)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(binary, limits) } {
    Sampled(value) -> Test.assert_eq(value, 20)
    _ -> Test.assert_true(false)
  }

  let empty = Nil<(usize, Gen<i64>)>()
  match prop.frequency<i64>(empty) {
    Err(NoWeightedAlternatives) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let zero_weight = Cons<(usize, Gen<i64>)>(
    (0, prop.constant<i64>(10)),
    Nil<(usize, Gen<i64>)>()
  )
  match prop.frequency<i64>(zero_weight) {
    Err(ZeroWeight(index)) -> Test.assert_eq_usize(index, 0)
    _ -> Test.assert_true(false)
  }
  let maximum: usize = 18446744073709551615
  let overflowing = Cons<(usize, Gen<i64>)>(
    (maximum, prop.constant<i64>(10)),
    Cons<(usize, Gen<i64>)>((1, prop.constant<i64>(20)), Nil<(usize, Gen<i64>)>())
  )
  match prop.frequency<i64>(overflowing) {
    Err(WeightTotalOverflow) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }

  let weighted = Cons<(usize, Gen<i64>)>(
    (1, prop.constant<i64>(10)),
    Cons<(usize, Gen<i64>)>((3, prop.constant<i64>(20)), Nil<(usize, Gen<i64>)>())
  )
  let frequency = prop.frequency<i64>(weighted).expect("valid positive total")
  match with extreme_handler(Lowest) { prop.sample(frequency, limits) } {
    Sampled(value) -> Test.assert_eq(value, 10)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Highest) { prop.sample(frequency, limits) } {
    Sampled(value) -> Test.assert_eq(value, 20)
    _ -> Test.assert_true(false)
  }
}
