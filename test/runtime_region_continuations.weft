use runtime/memory.{*}
use runtime/alloc.{*}

effect RegionDeferred {
  @deferred fn get() -> i64
}

test "runtime_region_tail_resume_with_region_value_stays_scoped" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 41)
    handle RegionDeferred.get() {
      RegionDeferred.get() -> resume(mem_load64(p) + 1)
    }
  })
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_deferred_continuation_without_region_values_allowed" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    handle RegionDeferred.get() {
      RegionDeferred.get() with k -> k(42)
    }
  })
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}
