use stdlib/num

effect MutableStateAbort { fn stop() -> i64 }
effect MutableStateOuter { fn stop() -> i64 }

fn mutable_state_abort() -[MutableStateAbort]> i64 { MutableStateAbort.stop() }

test "integer local stores survive an abort to their surrounding handler" {
  let mut value = 0
  let result = handle { value = 1 mutable_state_abort() } {
    MutableStateAbort.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(value, 1)
}

test "floating local stores survive an abort to their surrounding handler" {
  let mut value = 0.0
  let result = handle { value = 1.5 mutable_state_abort() } {
    MutableStateAbort.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(value, 1.5)
}

test "narrow floating local stores survive an abort to their surrounding handler" {
  let mut value: f32 = 0.0
  let result = handle { value = 1.5 mutable_state_abort() } {
    MutableStateAbort.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(value.to_f64(), 1.5)
}

test "normal and resumed handler completion retain local stores" {
  for perform in [true, false] {
    let mut value = 0
    let result = handle {
      value = 1
      let result = if perform { mutable_state_abort() } else { 41 }
      value = value + 1
      result + 1
    } {
      MutableStateAbort.stop() -> resume(41)
    }
    Test.assert_eq(result, 42)
    Test.assert_eq(value, 2)
  }
}

test "nested aborts retain the latest stores and leave earlier copies unchanged" {
  let mut value = 1
  let copy = value
  let result = handle {
    value = 2
    let inner = handle { value = 3 mutable_state_abort() } {
      MutableStateAbort.stop() -> 40
    }
    Test.assert_eq(inner, 40)
    Test.assert_eq(value, 3)
    value = 4
    MutableStateOuter.stop()
  } {
    MutableStateOuter.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(value, 4)
  Test.assert_eq(copy, 1)
}

test "mutable cells in a handler clause survive its nested abort" {
  let result = handle mutable_state_abort() {
    MutableStateAbort.stop() -> {
      let mut value = 0
      let nested = handle { value = 2 MutableStateOuter.stop() } {
        MutableStateOuter.stop() -> 40
      }
      nested + value
    }
  }
  Test.assert_eq(result, 42)
}

test "loop iterations each retain their stores across handler aborts" {
  let mut sum = 0
  for i in 0..8 {
    let mut value = i
    let result = handle { value = value + 1 mutable_state_abort() } {
      MutableStateAbort.stop() -> 0
    }
    sum = sum + value + result
  }
  Test.assert_eq(sum, 36)
}
