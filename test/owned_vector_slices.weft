use stdlib/vector as vector
use stdlib/vector.{Vector}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_count, runtime_rc_probe_load}

fn slice_total(values: [i64]) -> i64 {
  let mut total = 0
  for value in values { total = total + value }
  total
}

fn consume_sliced_vector(values: owned Vector<i64>) -> i64 {
  slice_total(values[..]) + slice_total(values[..])
}

test "owned Vector supports repeated and overlapping immutable slices" {
  let mut values = vector.new<i64>()
  values.push(10)
  values.push(20)
  values.push(12)
  let prefix = values[..2]
  let suffix = values[1..]
  Test.assert_eq(slice_total(prefix), 30)
  Test.assert_eq(slice_total(suffix), 32)
  Test.assert_eq(slice_total(values[..]), 42)
  Test.assert_eq(slice_total(values[1..2]), 20)
  Test.assert_eq(consume_sliced_vector(values), 84)
}

test "owned Vector can be observed repeatedly through slices in a loop" {
  let mut values = vector.new<i64>()
  values.push(7)
  let mut total = 0
  for i in 0..6 { total = total + slice_total(values[..]) }
  Test.assert_eq(total, 42)
}

test "owned Vector mutates after the last use of a slice" {
  let mut values = vector.new<i64>()
  values.push(20)
  let before = values[..]
  Test.assert_eq(slice_total(before), 20)
  values.push(22)
  Test.assert_eq(slice_total(values[..]), 42)
  let writable: [mut i64] = values[..]
  writable[0] = 10
  Test.assert_eq(slice_total(writable[..]), 32)
  Test.assert_eq(slice_total(values[..]), 32)
}

fn observe_probe_slice(values: [RuntimeRcProbe]) -> i64 {
  runtime_rc_probe_load(values[0])
}

fn sliced_probe_owner(probe: RuntimeRcProbe) -> i64 {
  let mut values = vector.new<RuntimeRcProbe>()
  values.push(probe)
  observe_probe_slice(values[..]) + observe_probe_slice(values[..])
}

test "repeated slices preserve exactly one Vector cleanup" {
  let probe = runtime_rc_probe_new(21)
  Test.assert_eq(sliced_probe_owner(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "empty owned Vector supports repeated empty slices" {
  let values = vector.new<i64>()
  Test.assert_eq(slice_total(values[..]), 0)
  Test.assert_eq(slice_total(values[0..0]), 0)
  Test.assert_eq(consume_sliced_vector(values), 0)
}
