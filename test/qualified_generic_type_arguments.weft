-- A module-qualified generic type application names the same type as its
-- unqualified spelling, whatever the spelling of its arguments: `m.T<q.A>`,
-- `T<q.A>`, `m.T<A>` and `T<A>` are one identity.

use stdlib/grammar/sql as sql_grammar
use stdlib/grammar/sql.{SqlGrammar}
use stdlib/grammar/staging as staging
use stdlib/grammar/staging.{Staged, validated}
use stdlib/option as opt
use stdlib/diagnostic/schema.{DiagnosticSourceNamed}
use stdlib/option.{Option, Some, None}

fn qualified_both() -> staging.Staged<sql_grammar.SqlGrammar> {
  staging.validated<sql_grammar.SqlGrammar>("both")
}

fn qualified_outer_bare_call() -> staging.Staged<sql_grammar.SqlGrammar> {
  validated<SqlGrammar>("outer")
}

fn bare_outer_qualified_call() -> Staged<sql_grammar.SqlGrammar> {
  staging.validated<sql_grammar.SqlGrammar>("inner")
}

fn bare_both() -> Staged<SqlGrammar> { staging.validated<sql_grammar.SqlGrammar>("bare") }

fn qualified_option() -> opt.Option<sql_grammar.SqlGrammar> { None<SqlGrammar>() }

fn source_of(staged: Staged<SqlGrammar>) -> str {
  match staged.source {
    DiagnosticSourceNamed(name) -> name
    _ -> "?"
  }
}

test "qualified and bare generic spellings agree and interchange" {
  Test.assert_str_eq(source_of(qualified_both()), "both")
  Test.assert_str_eq(source_of(qualified_outer_bare_call()), "outer")
  Test.assert_str_eq(source_of(bare_outer_qualified_call()), "inner")
  Test.assert_str_eq(source_of(bare_both()), "bare")
  let mixed: staging.Staged<sql_grammar.SqlGrammar> = bare_both()
  Test.assert_str_eq(source_of(mixed), "bare")
  Test.assert_true(match qualified_option() { None -> true, _ -> false })
}
