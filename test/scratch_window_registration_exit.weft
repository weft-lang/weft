-- Expected exit code: 101
-- Registration grows the type table's entries and count, which a scratch
-- window's journal cannot unwind, so registering inside one must stop loudly.

use compiler/storage.{nlist_new}
use compiler/weft/check/table.{ttable_add, ttable_new, ttable_scratch_facts_checkpoint}

fn main() -> i64 {
  let table = ttable_new()
  let checkpoint = ttable_scratch_facts_checkpoint(table)
  ttable_add(table, 0, 0, 0, 0, 0, 0, nlist_new())
}
