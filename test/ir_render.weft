-- `weft ir` renders typed IR from data. These cases pin the exact text for
-- hand-built functions, so the view is checked independently of lowering.

use compiler/ir/data.{*}
use compiler/ir/render as ir_render
use compiler/ir/render.{
  IrCleanupAction,
  IrCleanupArrayGlue,
  IrCleanupAtBind,
  IrCleanupAtRewrap,
  IrCleanupAtSlot,
  IrCleanupAtValue,
  IrCleanupDrop,
  IrCleanupFlowAlias,
  IrCleanupPlanGlue,
  IrCleanupRecord,
  IrCleanupRelease,
  IrCleanupSite,
  IrCleanupSlotAlias,
  IrCleanupUnsited,
  IrRenderContext
}
use compiler/storage.{*}
use compiler/types/algebra.{*}
use runtime/effects.{continuation_cleanup_kind_rc}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/string.{int_to_str}
use stdlib/test.{Test}

fn names() -> Map<i64, str> {
  map.new<i64, str>().insert(1, "add").insert(2, "main").insert(3, "Circle").insert(4, "Log").insert(
    5,
    "note"
  ).insert(6, "Shape")
}

fn context() -> IrRenderContext {
  IrRenderContext {
    names: names(),
    plan_text: (plan: i64) => "plan".concat(int_to_str(plan)),
    cleanup: ir_render.no_cleanup
  }
}

-- Every body reports the same records, so nested bodies show where the
-- renderer places them.
fn context_with_cleanup(records: List<IrCleanupRecord>) -> IrRenderContext {
  IrRenderContext {
    names: names(),
    plan_text: (plan: i64) => "plan".concat(int_to_str(plan)),
    cleanup: (blocks: IrBlockList) => records
  }
}

fn val1(first: i64) -> IrValueList { IrValueCons(first, IrValueNil) }

fn val2(first: i64, second: i64) -> IrValueList { IrValueCons(first, val1(second)) }

fn inst1(first: IrInst) -> IrInstList { IrInstCons(first, IrInstNil) }

fn block1(first: IrBlock) -> IrBlockList { IrBlockListCons(first, IrBlockListNil) }

fn one(function: IrFunction) -> IrFunctionList { IrFunctionCons(function, IrFunctionNil) }

fn adder() -> IrFunction {
  let entry = IrBlock(
    0,
    val2(0, 1),
    inst1(IrBinaryI64(2, IrAdd, 0, 1)),
    IrTermReturn(2)
  )
  IrFunction(1, 2, block1(entry), 0)
}

fn returns_zero() -> IrFunction {
  IrFunction(2, 0, block1(IrBlock(0, IrValueNil, IrInstNil, IrTermReturn(0))), 0)
}

test "a straight-line function renders its parameters, instructions and return" {
  Test.assert_str_eq(
    ir_render.render_functions(one(adder()), context(), ""),
    "fn add (2 params)\n  b0(%0, %1):\n    %2 = add %0, %1\n    return %2\n"
  )
}

test "branches, joins and calls name their targets" {
  let entry = IrBlock(0, val1(0), inst1(IrConstI64(1, 0)), IrTermBranch(0, 1, 2))
  let named = IrBlock(
    1,
    IrValueNil,
    inst1(IrCallI64(2, 1, val2(0, 1))),
    IrTermJump(3, val1(2))
  )
  let unnamed = IrBlock(
    2,
    IrValueNil,
    inst1(IrCallI64(4, 99, IrValueNil)),
    IrTermJump(3, val1(4))
  )
  let join = IrBlock(3, val1(5), IrInstNil, IrTermReturn(5))
  let body = IrBlockListCons(
    entry,
    IrBlockListCons(named, IrBlockListCons(unnamed, block1(join)))
  )
  Test.assert_str_eq(
    ir_render.render_functions(one(IrFunction(2, 1, body, 0)), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    %1 = const 0\n    branch %0 ? b1 : b2\n  b1():\n    %2 = call add(%0, %1)\n    jump b3(%2)\n  b2():\n    %4 = call h99()\n    jump b3(%4)\n  b3(%5):\n    return %5\n"
  )
}

test "constructors, performs, stakes and cleanup plans render with their names" {
  let body = IrInstCons(
    IrVariantInitI64(1, 3, val1(0), 1),
    IrInstCons(
      IrPerformI64(2, 4, 5, val1(0)),
      IrInstCons(
        IrManagedStakeI64(3, 1, continuation_cleanup_kind_rc(), 1, 0),
        IrInstCons(IrStructuralDropI64(1, 7), inst1(IrOwnedDropI64(0, 6)))
      )
    )
  )
  let function = IrFunction(
    2,
    1,
    block1(IrBlock(0, val1(0), body, IrTermReturn(2))),
    0
  )
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    %1 = variant Circle(%0) mask=1\n    %2 = perform Log.note(%0)\n    %3 = retain.rc %1 origin=unknown\n    structural_drop %1 plan7\n    owned_drop %0 : Shape\n    return %2\n"
  )
}

test "a closure body renders beneath the instruction that creates it" {
  let captures = nlist_new()
  nlist_add(captures, node_new(4, 0, 0, 0, 0))
  let closure = IrClosureI64(
    1,
    adder(),
    captures,
    IrLambdaSemanticFacts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())
  )
  let function = IrFunction(
    2,
    1,
    block1(IrBlock(0, val1(0), inst1(closure), IrTermReturn(1))),
    0
  )
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    %1 = closure captures=[%0]\n      fn add (2 params)\n        b0(%0, %1):\n          %2 = add %0, %1\n          return %2\n    return %1\n"
  )
}

test "a function filter selects one function, and an unknown name selects none" {
  let both = IrFunctionCons(adder(), IrFunctionCons(returns_zero(), IrFunctionNil))
  Test.assert_str_eq(
    ir_render.render_functions(both, context(), "main"),
    "fn main (0 params)\n  b0():\n    return %0\n"
  )
  Test.assert_str_eq(ir_render.render_functions(both, context(), "missing"), "")
  Test.assert_str_eq(
    ir_render.render_functions(both, context(), ""),
    "fn add (2 params)\n  b0(%0, %1):\n    %2 = add %0, %1\n    return %2\n\nfn main (0 params)\n  b0():\n    return %0\n"
  )
}

test "types render structurally with declared names" {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  Test.assert_str_eq(ir_render.type_text(context(), ty_union(ty_i64(), ty_nil())), "i64 | nil")
  Test.assert_str_eq(
    ir_render.type_text(context(), ty_named_with_metadata(6, 0, args, 0)),
    "Shape<i64>"
  )
  Test.assert_str_eq(ir_render.type_text(context(), ty_owned(ty_named(6, 0))), "owned Shape")
  Test.assert_str_eq(ir_render.type_text(context(), ty_array(ty_bool(), 4)), "[bool; 4]")
  Test.assert_str_eq(ir_render.type_text(context(), ty_slice_with_mut(ty_i64(), 0)), "[i64]")
  Test.assert_str_eq(ir_render.type_text(context(), ty_var(3)), "T3")
  Test.assert_str_eq(ir_render.type_text(context(), ty_named(12345, 0)), "#12345")
  Test.assert_str_eq(ir_render.type_text(context(), 0), "?")
}

test "managed stakes name their semantic origin" {
  let stakes = IrInstCons(
    IrManagedStakeI64(1, 0, continuation_cleanup_kind_rc(), 1, ir_managed_stake_origin_binding()),
    inst1(
      IrManagedAcquireI64(0, continuation_cleanup_kind_rc(), ir_managed_stake_origin_aggregate())
    )
  )
  let function = IrFunction(2, 1, block1(IrBlock(0, val1(0), stakes, IrTermReturn(0))), 0)
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    %1 = retain.rc %0 origin=binding\n    acquire.rc %0 origin=aggregate\n    return %0\n"
  )
}

fn record(
  index: i64,
  site: IrCleanupSite,
  protects: i64,
  action: IrCleanupAction,
  origin: i64
) -> IrCleanupRecord {
  IrCleanupRecord { record: index, site: site, value: protects, action: action, origin: origin }
}

test "every cleanup action and site renders beneath the body that arms it" {
  let records = Cons(
    record(
      0,
      IrCleanupAtValue(1),
      1,
      IrCleanupRelease(1),
      ir_managed_stake_origin_call_transport()
    ),
    Cons(
      record(1, IrCleanupAtBind(0), 0, IrCleanupDrop(6), ir_managed_stake_origin_binding()),
      Cons(
        record(
          2,
          IrCleanupAtRewrap(3),
          3,
          IrCleanupPlanGlue(9),
          ir_managed_stake_origin_aggregate()
        ),
        Cons(
          record(
            3,
            IrCleanupAtSlot(2),
            4,
            IrCleanupArrayGlue(77),
            ir_managed_stake_origin_unknown()
          ),
          Cons(
            record(
              2,
              IrCleanupUnsited,
              5,
              IrCleanupSlotAlias,
              ir_managed_stake_origin_aggregate()
            ),
            Cons(
              record(
                0,
                IrCleanupUnsited,
                6,
                IrCleanupFlowAlias,
                ir_managed_stake_origin_control()
              ),
              Nil
            )
          )
        )
      )
    )
  )
  Test.assert_str_eq(
    ir_render.render_functions(one(returns_zero()), context_with_cleanup(records), ""),
    "fn main (0 params)\n  b0():\n    return %0\n  cleanup r0 release add %1 at %1 (call_transport)\n  cleanup r1 drop Shape %0 at bind %0 (binding)\n  cleanup r2 glue plan9 %3 at rewrap %3 (aggregate)\n  cleanup r3 array_glue #77 %4 at slot2 (unknown)\n  cleanup %5 aliases r2 (slot)\n  cleanup %6 aliases r0 (join)\n"
  )
}

test "cleanup records follow each nested body at its own indentation" {
  let records = Cons(
    record(
      0,
      IrCleanupAtValue(2),
      2,
      IrCleanupRelease(1),
      ir_managed_stake_origin_result_transfer()
    ),
    Nil
  )
  let captures = nlist_new()
  let closure = IrClosureI64(
    1,
    adder(),
    captures,
    IrLambdaSemanticFacts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())
  )
  let function = IrFunction(
    2,
    0,
    block1(IrBlock(0, IrValueNil, inst1(closure), IrTermReturn(1))),
    0
  )
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context_with_cleanup(records), ""),
    "fn main (0 params)\n  b0():\n    %1 = closure captures=[]\n      fn add (2 params)\n        b0(%0, %1):\n          %2 = add %0, %1\n          return %2\n        cleanup r0 release add %2 at %2 (result_transfer)\n    return %1\n  cleanup r0 release add %2 at %2 (result_transfer)\n"
  )
}

test "no cleanup records renders no cleanup lines" {
  Test.assert_str_eq(
    ir_render.render_functions(one(adder()), context_with_cleanup(Nil), ""),
    "fn add (2 params)\n  b0(%0, %1):\n    %2 = add %0, %1\n    return %2\n"
  )
}

test "managed transfers name the call boundary they bind to, or commit" {
  let transfers = IrInstCons(
    IrManagedTransferI64(
      1,
      ir_managed_transfer_direct_target(),
      0,
      0,
      continuation_cleanup_kind_rc()
    ),
    IrInstCons(
      IrManagedTransferI64(
        2,
        ir_managed_transfer_effect_target(),
        0,
        1,
        continuation_cleanup_kind_rc()
      ),
      IrInstCons(
        IrManagedTransferI64(3, 0, 0, 0, continuation_cleanup_kind_rc()),
        IrInstCons(
          IrManagedTransferI64(4, 1, 0, 2, continuation_cleanup_kind_rc()),
          inst1(ir_managed_transfer_commit(0, continuation_cleanup_kind_rc()))
        )
      )
    )
  )
  let function = IrFunction(2, 1, block1(IrBlock(0, val1(0), transfers, IrTermReturn(0))), 0)
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    transfer.rc %0 to direct lane=0 at %1\n    transfer.rc %0 to effect lane=1 at %2\n    transfer.rc %0 to indirect lane=0 at %3\n    transfer.rc %0 to add lane=2 at %4\n    commit.rc %0\n    return %0\n"
  )
}

test "a borrowed-parameter marker renders its mask, and other slots their id" {
  let body = IrInstCons(
    ir_inst_slot_i64(ir_borrowed_param_mask_slot(5)),
    inst1(ir_inst_slot_i64(3))
  )
  let function = IrFunction(2, 1, block1(IrBlock(0, val1(0), body, IrTermReturn(0))), 0)
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (1 params)\n  b0(%0):\n    borrowed_params mask=5\n    slot3\n    return %0\n"
  )
}

test "call result lanes name their lane and call head in both encodings" {
  let body = IrInstCons(
    IrCallI64(1, 1, IrValueNil),
    IrInstCons(
      ir_inst_call_result_lane_i64(2, 1),
      inst1(ir_inst_call_result_lane_for_head_i64(7, 2, 1))
    )
  )
  let function = IrFunction(2, 0, block1(IrBlock(0, IrValueNil, body, IrTermReturn(7))), 0)
  Test.assert_str_eq(
    ir_render.render_functions(one(function), context(), ""),
    "fn main (0 params)\n  b0():\n    %1 = call add()\n    %2 = result_lane 1 of %1\n    %7 = result_lane 2 of %1\n    return %7\n"
  )
}
