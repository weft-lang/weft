use compiler/weft/format/config as format_config
use compiler/weft/format.{FormatterSuccess, FormatterFailure, formatter_format_text_with_config}
use compiler/source/input.{source_from_text}
use stdlib/diagnostic.{Diagnose}
use stdlib/string
use stdlib/vector.{vector_len, vector_get_in_bounds}
use stdlib/panic.{panic}
use stdlib/option.{Some, None}

test "formatter defaults to 98 characters" {
  Test.assert_eq(format_config.defaults().max_line_length(), 98)
}

test "formatter accepts positive explicit widths" {
  let widths = [1, 40, 80, 98, 100, 120, 9223372036854775807]
  for width in widths {
    match format_config.from_max_line_length(width) {
      Some(config) -> Test.assert_eq(config.max_line_length(), width)
      None -> Test.assert_true(false)
    }
  }
}

test "formatter rejects nonpositive explicit widths" {
  let widths = [0, -1, -98]
  for width in widths {
    match format_config.from_max_line_length(width) {
      Some(_) -> Test.assert_true(false)
      None -> Test.assert_true(true)
    }
  }
}

test "formatter rejects malformed and overflowing text widths" {
  let widths = ["", "0", "-1", "98x", "9.8", "1e2", "9223372036854775808"]
  for width in widths {
    match format_config.from_text(width) {
      Some(_) -> Test.assert_true(false)
      None -> Test.assert_true(true)
    }
  }
}

fn layout_output(source: str, width: i64) -> str {
  let config = match format_config.from_max_line_length(width) {
    Some(config) -> config
    None -> panic("invalid formatter fixture width")
  }
  let result = handle formatter_format_text_with_config(source_from_text(source), config) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  match result {
    FormatterSuccess(formatted) -> formatted
    FormatterFailure(_) -> panic("formatter fixture rejected")
  }
}

test "long function heads include effect and result width" {
  let source = "pub(package) fn project_records<I>(syntax: LongGrammarModuleSyntax, context: LongGrammarModuleCheckContext<I>) -[TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> { result }"
  let expected = "pub(package) fn project_records<I>(\n  syntax: LongGrammarModuleSyntax,\n  context: LongGrammarModuleCheckContext<I>\n) -[TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> { result }"
  let output = layout_output(source, 98)
  Test.assert_str_eq(output, expected)
  Test.assert_str_eq(layout_output(output, 98), output)
  Test.assert_str_eq(layout_output(source, 240), source)
}

test "selected imports wrap within the configured width" {
  let source = "use example.{ Alpha, Beta, Gamma, Delta, Epsilon, Zeta }"
  let expected = "use example.{\n  Alpha,\n  Beta,\n  Gamma,\n  Delta,\n  Epsilon,\n  Zeta\n}"
  let output = layout_output(source, 32)
  Test.assert_str_eq(output, expected)
  Test.assert_str_eq(layout_output(output, 32), output)
}

test "declaration siblings do not acquire continuation indentation" {
  let source = "pub effect Scope {\n  pub(package) fn submit(work: i64) -> i64,\n    pub(package) fn join(task: i64) -> i64\n}\ntype Mode {\n  Ready,\n    Waiting,\n    Sleeping\n}"
  let expected = "pub effect Scope {\n  pub(package) fn submit(work: i64) -> i64,\n  pub(package) fn join(task: i64) -> i64\n}\n\ntype Mode {\n  Ready,\n  Waiting,\n  Sleeping\n}"
  let output = layout_output(source, 98)
  Test.assert_str_eq(output, expected)
  Test.assert_str_eq(layout_output(output, 98), output)
}

test "width counts Unicode scalars and preserves CRLF on inserted lines" {
  let source = "fn πρόσθεση(α: i64, β: i64) -> i64 { α + β }\r\n"
  let output = layout_output(source, 32)
  Test.assert_true(output.contains("\r\n"))
  Test.assert_false(output.replace("\r\n", "").contains("\n"))
  Test.assert_str_eq(layout_output(output, 32), output)
}

test "short match arms stay on one line in a multiline body" {
  let source = "fn unpack(value: Value) -> i64 {\n  match value {\n    Present(word) -> word\n    Absent -> 0\n  }\n}"
  Test.assert_str_eq(layout_output(source, 98), source)
}

fn layout_assert_width(source: str, width: i64) -[Test]> i64 {
  let output = layout_output(source, width)
  let lines = output.split("\n")
  for i in 0..vector_len(lines) {
    Test.assert_true(vector_get_in_bounds(lines, i).scalar_count() <= __i64_to_usize(width))
  }
  Test.assert_str_eq(layout_output(output, width), output)
}

test "nested signatures and expressions fit narrow widths idempotently" {
  let cases = [
    "fn f(very_long_parameter_label: AnotherVeryLongParameterType) -> i64 { 0 }",
    "fn f<LongTypeParameter: AnotherVeryLongTraitName>(value: LongTypeParameter) -> i64 { 0 }",
    "fn nest(x: (LongOne, LongTwo, LongThree)) -[AlphaLongEffect, BetaLongEffect]> Result<LongSuccessType, LongFailureType> { compute(first_argument, second_argument, third_argument) }",
    "fn f<T>(x: T) -> T where T: AlphaLongTrait & BetaLongTrait & GammaLongTrait { x }",
    "fn f<T: FirstLongTrait & SecondLongTrait>(x: T) -> T { x }",
    "fn foo() -> { left: FirstVeryLongType, right: OtherVeryLongType } { { left: 1, right: 2 } }",
    "fn pair() -> (i64, i64) { (very_long_first_value, very_long_second_value) }",
    "type Choice { Value(FirstLongType, SecondLongType, ThirdLongType), Empty }",
    "type Value = FirstLongAlternative | SecondLongAlternative | ThirdLongAlternative",
    "fn update() -> Value { original.{ first: first_long_value, second: second_long_value } }",
    "fn callback(f: (FirstLongType, SecondLongType) -[OneLongEffect, TwoLongEffect]> LastLongType) -> i64 { 0 }",
    "fn calculate() -> i64 { first_long_value + second_long_value * third_long_value }"
  ]
  for source in cases { layout_assert_width(source, 40) }
}

test "width boundary uses character count rather than UTF8 byte count" {
  let source = "fn πρόσθεση(α: i64, β: i64) -> i64 { α + β }"
  Test.assert_str_eq(layout_output(source, 44), source)
  Test.assert_false(layout_output(source, 43) == source)
  layout_assert_width(source, 43)
}

test "comments literals and indivisible names are preserved over the target" {
  let source = "-- This comment deliberately exceeds the configured line width.\nfn extraordinarily_long_function_name() -> str { \"this string payload is indivisible\" }\n"
  let output = layout_output(source, 20)
  Test.assert_true(output.contains("-- This comment deliberately exceeds the configured line width."))
  Test.assert_true(output.contains("\"this string payload is indivisible\""))
  Test.assert_true(output.contains("extraordinarily_long_function_name"))
  Test.assert_str_eq(layout_output(output, 20), output)
}

test "empty singleton nested groups and comments preserve list meaning" {
  let source = "fn tuple() -> (i64,) {\n  let values = [1, -- first\n    2, 3]\n  let pair = (values[0], values[1])\n  (pair.0,)\n}"
  let output = layout_output(source, 24)
  Test.assert_true(output.contains("-- first"))
  Test.assert_true(output.contains("pair.0,"))
  Test.assert_str_eq(layout_output(output, 24), output)
  Test.assert_str_eq(layout_output("fn empty() -> () { () }", 24), "fn empty() -> () { () }")
}

test "wrapped match expressions indent their own arms and closing brace" {
  let source = "fn choose(value: Choice) -> i64 {\n  match value {\n    FirstReallyLongCase(payload) -> match payload { Inner(v) -> v, Other -> 0 }\n    Second -> 0\n  }\n}"
  let expected = "fn choose(value: Choice) -> i64 {\n  match value {\n    FirstReallyLongCase(payload) ->\n      match payload {\n        Inner(v) -> v,\n        Other -> 0\n      }\n    Second -> 0\n  }\n}"
  let output = layout_output(source, 40)
  Test.assert_str_eq(output, expected)
  Test.assert_str_eq(layout_output(output, 40), output)
}
