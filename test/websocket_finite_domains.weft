use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/num
use stdlib/http as http
use stdlib/http.{HttpHeaders, HttpRequestHeadReady}
use stdlib/option.{None, Some, Option}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
use stdlib/string
use stdlib/string.{str_concat}
use stdlib/websocket as websocket
use stdlib/websocket.{*}

fn finite_ws_limits() -> WebSocketLimits {
  websocket.limits(18446744073709551615, 18446744073709551615).unwrap()
}

fn finite_ws_bytes(values: [u8]) -> Bytes { bytes.from_slice(values) }

fn finite_ws_header(payload: Bytes, final: bool, opcode: WebSocketOpcode) -> WebSocketFrameHeader {
  let wire = websocket.encode_server_frame(final, opcode, payload, finite_ws_limits()).unwrap()
  match websocket.parse_frame_header(wire, WebSocketClient, finite_ws_limits()) {
    WebSocketFrameReady(header, consumed) -> header
    _ -> panic("encoded header must parse")
  }
}

fn finite_ws_fragment(state: WebSocketMessageState, payload: Bytes, final: bool, opcode: WebSocketOpcode, cut: usize) -> Result<WebSocketMessageState, WebSocketError> {
  let initial = state.begin(websocket.close_handshake(), WebSocketReceiveMessages, finite_ws_header(payload, final, opcode), finite_ws_limits()).unwrap()
  let frame = if cut > 0 and cut < payload.len() {
    match initial.read(WebSocketMessageChunk(payload.slice(0, cut).unwrap())) {
      WebSocketMessageMore(next) -> next
      WebSocketMessageFailed(error) -> return Err<WebSocketMessageState, WebSocketError>(error)
      WebSocketMessageDone(next) -> panic("nonterminal input ended a frame")
    }
  } else { initial }
  let zero: usize = 0
  let start = if cut > 0 and cut < payload.len() { cut } else { zero }
  match frame.read(WebSocketMessageEnd(payload.slice(start, payload.len()).unwrap())) {
    WebSocketMessageDone(next) -> Ok<WebSocketMessageState, WebSocketError>(next)
    WebSocketMessageFailed(error) -> Err<WebSocketMessageState, WebSocketError>(error)
    WebSocketMessageMore(next) -> panic("terminal input left a frame open")
  }
}

fn finite_ws_split(payload: Bytes, split: usize, left_cut: usize, right_cut: usize) -> Result<WebSocketMessageState, WebSocketError> {
  let first = payload.slice(0, split).unwrap()
  let last = payload.slice(split, payload.len()).unwrap()
  let active = match finite_ws_fragment(websocket.message_state(), first, false, WebSocketText, left_cut) {
    Err(error) -> return Err<WebSocketMessageState, WebSocketError>(error)
    Ok(next) -> next
  }
  let mut interrupted = active
  for opcode in [WebSocketPing, WebSocketPong, WebSocketClose] {
    interrupted = finite_ws_fragment(interrupted, bytes.empty(), true, opcode, 0).unwrap()
  }
  finite_ws_fragment(interrupted, last, true, WebSocketContinuation, right_cut)
}

fn finite_ws_check_splits(payload: Bytes, expected: Option<usize>) -[Test]> nil {
  let origin: usize = 0
  for split in origin..payload.len() + 1 {
    for left in origin..split + 1 {
      for right in origin..payload.len() - split + 1 {
        match finite_ws_split(payload, split, left, right) {
          Ok(state) -> {
            match expected { None -> Test.assert_true(true) Some(offset) -> Test.assert_true(false) }
            match state.pending() { None -> Test.assert_true(true) Some(kind) -> Test.assert_true(false) }
          }
          Err(WebSocketInvalidText(offset)) -> match expected {
            Some(wanted) -> Test.assert_eq_usize(offset, wanted)
            None -> Test.assert_true(false)
          }
          _ -> Test.assert_true(false)
        }
      }
    }
  }
}

test "WebSocket byte limits preserve the entire finite domain" {
  match websocket.limits(0, 0) { Err(WebSocketInvalidFrameLimit(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match websocket.limits(1, 0) { Err(WebSocketInvalidMessageLimit(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match websocket.limits(3, 2) { Err(WebSocketInvalidMessageLimit(2)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match websocket.limits(18446744073709551615, 18446744073709551614) {
    Err(WebSocketInvalidMessageLimit(count)) -> Test.assert_eq_usize(count, 18446744073709551614)
    _ -> Test.assert_true(false)
  }
  match websocket.limits(18446744073709551615, 18446744073709551615) { Ok(limits) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  let header = finite_ws_header(bytes.empty(), true, WebSocketText)
  Test.assert_eq_usize(header.payload_bytes(), 0)
  Test.assert_eq_usize(header.payload_decoder().remaining(), 0)
}

fn finite_ws_error_count(error: WebSocketError) -> usize {
  match error {
    WebSocketInvalidFrameLimit(value) -> value
    WebSocketInvalidMessageLimit(value) -> value
    WebSocketNoncanonicalLength(value) -> value
    WebSocketInvalidLength(value) -> value
    WebSocketFrameTooLarge(value) -> value
    WebSocketControlTooLarge(value) -> value
    WebSocketInvalidCloseReason(value) -> value
    WebSocketCloseReasonTooLong(value) -> value
    WebSocketMessageTooLarge(value) -> value
    WebSocketInvalidText(value) -> value
    WebSocketPayloadLengthMismatch(actual, expected) -> if actual == expected { actual } else { panic("mismatch pair changed") }
    _ -> panic("not a byte-count diagnostic")
  }
}

test "every WebSocket byte diagnostic carries full width counts" {
  let maximum: usize = 18446744073709551615
  for error in [WebSocketInvalidFrameLimit(maximum), WebSocketInvalidMessageLimit(maximum), WebSocketNoncanonicalLength(maximum), WebSocketInvalidLength(maximum), WebSocketFrameTooLarge(maximum), WebSocketControlTooLarge(maximum), WebSocketInvalidCloseReason(maximum), WebSocketCloseReasonTooLong(maximum), WebSocketMessageTooLarge(maximum), WebSocketInvalidText(maximum), WebSocketPayloadLengthMismatch(maximum, maximum)] {
    Test.assert_eq_usize(finite_ws_error_count(error), maximum)
  }
}

test "WebSocket wire length keeps its 63 bit bound independently of local limits" {
  let source: [u8; 10] = [130, 127, 127, 255, 255, 255, 255, 255, 255, 255]
  let wire = finite_ws_bytes(source[..])
  let origin: usize = 0
  for end in origin..10 {
    match websocket.parse_frame_header(wire.slice(0, end).unwrap(), WebSocketClient, finite_ws_limits()) {
      WebSocketFrameNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  match websocket.parse_frame_header(wire, WebSocketClient, finite_ws_limits()) {
    WebSocketFrameReady(header, consumed) -> {
      Test.assert_eq_usize(consumed, 10)
      Test.assert_eq_usize(header.payload_bytes(), 9223372036854775807)
      let decoder = header.payload_decoder()
      Test.assert_eq_usize(decoder.remaining(), 9223372036854775807)
      match decoder.read(bytes.from_str("abc")) {
        WebSocketPayloadChunk(next, value, read) -> {
          Test.assert_eq_usize(read, 3)
          Test.assert_eq_usize(next.remaining(), 9223372036854775804)
          Test.assert_str_eq(value.to_utf8().unwrap(), "abc")
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  let high: [u8; 10] = [130, 127, 128, 0, 0, 0, 0, 0, 0, 0]
  let all: [u8; 10] = [130, 127, 255, 255, 255, 255, 255, 255, 255, 255]
  for candidate in [finite_ws_bytes(high[..]), finite_ws_bytes(all[..])] {
    match websocket.parse_frame_header(candidate, WebSocketClient, finite_ws_limits()) {
      WebSocketFrameFailed(WebSocketInvalidLength(length)) -> {
        let expected: usize = if candidate.get(2).unwrap() == 128 { 9223372036854775808 } else { 18446744073709551615 }
        Test.assert_eq_usize(length, expected)
      }
      _ -> Test.assert_true(false)
    }
  }
  match websocket.parse_frame_header(wire, WebSocketClient, websocket.default_limits()) {
    WebSocketFrameFailed(WebSocketFrameTooLarge(length)) -> Test.assert_eq_usize(length, 9223372036854775807)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket UTF8 remains valid across every transport and message split" {
  for source in ["", "ascii", "¢", "ࠀ", "€", "퟿", "", "𐀀", "😀", "􏿿", "a😀z"] {
    finite_ws_check_splits(bytes.from_str(source), None<usize>())
  }
}

test "WebSocket UTF8 malformed and truncated offsets survive every split and control interruption" {
  let invalid: [u8; 4] = [97, 240, 159, 65]
  finite_ws_check_splits(finite_ws_bytes(invalid[..]), Some<usize>(3))
  let truncated: [u8; 4] = [97, 240, 159, 152]
  finite_ws_check_splits(finite_ws_bytes(truncated[..]), Some<usize>(1))
  let lead: [u8; 3] = [128, 192, 245]
  for value in lead {
    let source: [u8; 1] = [value]
    finite_ws_check_splits(finite_ws_bytes(source[..]), Some<usize>(0))
  }
  for second in [128, 159] {
    let source: [u8; 3] = [224, second.to_u8_checked().unwrap(), 128]
    finite_ws_check_splits(finite_ws_bytes(source[..]), Some<usize>(1))
  }
  let surrogate: [u8; 3] = [237, 160, 128]
  finite_ws_check_splits(finite_ws_bytes(surrogate[..]), Some<usize>(1))
  let overlong: [u8; 4] = [240, 143, 191, 191]
  finite_ws_check_splits(finite_ws_bytes(overlong[..]), Some<usize>(1))
  let outside: [u8; 4] = [244, 144, 128, 128]
  finite_ws_check_splits(finite_ws_bytes(outside[..]), Some<usize>(1))
}

test "WebSocket terminal and nonterminal payload counts reject every mismatched boundary" {
  let payload = bytes.from_str("abc")
  let frame = websocket.message_state().begin(websocket.close_handshake(), WebSocketReceiveMessages, finite_ws_header(payload, true, WebSocketBinary), finite_ws_limits()).unwrap()
  for input in [WebSocketMessageChunk(bytes.empty()), WebSocketMessageChunk(payload), WebSocketMessageChunk(bytes.from_str("abcd")), WebSocketMessageEnd(bytes.empty()), WebSocketMessageEnd(bytes.from_str("ab")), WebSocketMessageEnd(bytes.from_str("abcd"))] {
    let actual = match input { WebSocketMessageChunk(value) -> value.len() WebSocketMessageEnd(value) -> value.len() }
    match frame.read(input) {
      WebSocketMessageFailed(WebSocketPayloadLengthMismatch(got, expected)) -> {
        Test.assert_eq_usize(got, actual)
        Test.assert_eq_usize(expected, 3)
      }
      _ -> Test.assert_true(false)
    }
  }
}

fn finite_ws_state_churn() -> bool {
  let valid = bytes.from_str("a😀z")
  let truncated = valid.slice(0, 4).unwrap()
  match finite_ws_split(valid, 3, 1, 1) {
    Ok(state) -> match state.pending() { None -> nil Some(kind) -> return false }
    Err(error) -> return false
  }
  match finite_ws_split(truncated, 2, 1, 1) {
    Err(WebSocketInvalidText(1)) -> true
    _ -> false
  }
}

test "WebSocket fragment states and early UTF8 failures reuse managed storage" {
  Test.assert_true(finite_ws_state_churn())
  for _ in 0..40 { finite_ws_state_churn() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { Test.assert_true(finite_ws_state_churn()) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}

test "WebSocket text and binary message budgets exclude interleaved control frames" {
  let limits = websocket.limits(4, 6).unwrap()
  let handshake = websocket.close_handshake()
  for opcode in [WebSocketText, WebSocketBinary] {
    let active = websocket.message_state().write(handshake, false, opcode, bytes.from_str("abc"), limits).unwrap()
    let ping = active.write(handshake, true, WebSocketPing, bytes.from_str("ping"), limits).unwrap()
    let pong = ping.write(handshake, true, WebSocketPong, bytes.from_str("pong"), limits).unwrap()
    match pong.write(handshake, true, WebSocketContinuation, bytes.from_str("def"), limits) {
      Ok(done) -> match done.pending() { None -> Test.assert_true(true) Some(kind) -> Test.assert_true(false) }
      _ -> Test.assert_true(false)
    }
    match pong.write(handshake, true, WebSocketContinuation, bytes.from_str("defg"), limits) {
      Err(WebSocketMessageTooLarge(6)) -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    let full = pong.write(handshake, false, WebSocketContinuation, bytes.from_str("def"), limits).unwrap()
    match full.write(handshake, true, WebSocketContinuation, bytes.empty(), limits) {
      Ok(done) -> match done.pending() { None -> Test.assert_true(true) Some(kind) -> Test.assert_true(false) }
      _ -> Test.assert_true(false)
    }
  }
}

fn finite_ws_upgrade(key: str) -> Result<HttpHeaders, WebSocketHandshakeError> {
  let text = "GET / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: " |> str_concat(key) |> str_concat("\r\n\r\n")
  let wire = bytes.from_str(text).to_vector()
  match http.parse_request_head(wire[..], http.default_limits()) {
    HttpRequestHeadReady(head, framing, count) -> websocket.server_upgrade(head)
    _ -> panic("key fixture must be a valid HTTP request")
  }
}

test "WebSocket handshake keys reject missing alphabet and padding bits exactly" {
  for key in ["", "a", "dGhlIHNhbXBsZSBub25jZQ=", "dGhlIHNhbXBsZSBub25jZQ===", "!GhlIHNhbXBsZSBub25jZQ==", "dGhlIHNhbXBsZSBub25jZR==", "dGhlIHNhbXBsZSBub25jZQ=A", "dGhlIHNhbXBsZSBub25jZQA=", "dGhlIHNhbXBsZSBub25jZQ--"] {
    match finite_ws_upgrade(key) { Err(WebSocketHandshakeKey) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  }
  match finite_ws_upgrade("dGhlIHNhbXBsZSBub25jZQ==") {
    Ok(headers) -> Test.assert_eq_usize(headers.len(), 3)
    _ -> Test.assert_true(false)
  }
}
