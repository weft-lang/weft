use stdlib/drop.{Drop}

use stdlib/test.{Test}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read, defer_order_log_write}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count}

effect ConditionalSignal { fn read() -> i64 }

fn conditional_signal_value(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> if cancel { 42 } else { resume(4) }
  }
}

fn conditional_signal_reverse(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> if cancel { resume(4) } else { 42 }
  }
}

test "a conditional immediate clause abandons or resumes only its selected branch" {
  Test.assert_eq(conditional_signal_value(true), 42)
  Test.assert_eq(conditional_signal_value(false), 5)
  Test.assert_eq(conditional_signal_reverse(true), 5)
  Test.assert_eq(conditional_signal_reverse(false), 42)
}

fn conditional_signal_match(mode: i64) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> match mode {
      0 -> resume(4)
      1 -> 42
      value if value < 0 -> 43
      _ -> resume(5)
    }
  }
}

test "matched and guarded immediate outcomes preserve abort and resume exits" {
  for (mode, expected) in [(0, 5), (1, 42), (0 - 1, 43), (2, 6)] {
    Test.assert_eq(conditional_signal_match(mode), expected)
  }
}

fn conditional_signal_transform(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> if cancel { 42 } else { resume(4) }
    return value -> value * 2
  }
}

test "only resumed completion enters the handler return transformation" {
  Test.assert_eq(conditional_signal_transform(true), 42)
  Test.assert_eq(conditional_signal_transform(false), 10)
}

effect ConditionalText { fn read() -> str }
effect ConditionalPair { fn read() -> (str, i64) }

fn conditional_text_result(cancel: bool) -> str {
  handle {
    let value = ConditionalSignal.read()
    if value == 4 { "resumed" } else { "wrong" }
  } {
    ConditionalSignal.read() -> if cancel { "aborted" } else { resume(4) }
  }
}

fn conditional_text_operation(cancel: bool) -> i64 {
  handle {
    if ConditionalText.read() == "resumed" { 7 } else { 8 }
  } {
    ConditionalText.read() -> if cancel { 42 } else { resume("resumed") }
  }
}

fn conditional_pair_result(cancel: bool) -> (str, i64) {
  handle ("resumed", ConditionalSignal.read()) {
    ConditionalSignal.read() -> if cancel { ("aborted", 42) } else { resume(4) }
  }
}

fn conditional_pair_operation(cancel: bool) -> i64 {
  handle {
    let (text, number) = ConditionalPair.read()
    if text == "resumed" { number + 1 } else { 0 }
  } {
    ConditionalPair.read() -> if cancel { 42 } else { resume(("resumed", 4)) }
  }
}

test "operation and handle results have independent scalar and managed types" {
  Test.assert_true(conditional_text_result(true) == "aborted")
  Test.assert_true(conditional_text_result(false) == "resumed")
  Test.assert_eq(conditional_text_operation(true), 42)
  Test.assert_eq(conditional_text_operation(false), 7)
}

test "abort and resume transport their own complete result lane shapes" {
  let (aborted_text, aborted_number) = conditional_pair_result(true)
  let (resumed_text, resumed_number) = conditional_pair_result(false)
  Test.assert_true(aborted_text == "aborted")
  Test.assert_eq(aborted_number, 42)
  Test.assert_true(resumed_text == "resumed")
  Test.assert_eq(resumed_number, 4)
  Test.assert_eq(conditional_pair_operation(true), 42)
  Test.assert_eq(conditional_pair_operation(false), 5)
}

fn conditional_owned_body(log: i64) -[ConditionalSignal]> i64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  ConditionalSignal.read() + 1
}

fn conditional_owned_clause(cancel: bool, log: i64) -> i64 {
  handle conditional_owned_body(log) {
    ConditionalSignal.read() -> {
      let local: owned OwnedAbortToken = owned_abort_token_new(log, 2)
      if cancel { 42 } else { resume(4) }
    }
  }
}

test "each immediate outcome drops clause locals before the suspended outer scope" {
  let abort_log = defer_order_log_new()
  let resume_log = defer_order_log_new()
  Test.assert_eq(conditional_owned_clause(true, abort_log), 42)
  Test.assert_eq(conditional_owned_clause(false, resume_log), 5)
  Test.assert_eq(defer_order_log_read(abort_log), 21)
  Test.assert_eq(defer_order_log_read(resume_log), 21)
}

fn conditional_pair_transform(cancel: bool) -> (str, i64) {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> if cancel { ("aborted", 42) } else { resume(4) }
    return value -> ("resumed", value * 2)
  }
}

fn conditional_scalar_transform(cancel: bool) -> i64 {
  handle ConditionalPair.read() {
    ConditionalPair.read() -> if cancel { 42 } else { resume(("resumed", 4)) }
    return value -> { let (text, number) = value if text == "resumed" { number * 2 } else { 0 } }
  }
}

test "mixed exits bypass a return transform that changes the result layout" {
  let (aborted_text, aborted_number) = conditional_pair_transform(true)
  let (resumed_text, resumed_number) = conditional_pair_transform(false)
  Test.assert_true(aborted_text == "aborted")
  Test.assert_eq(aborted_number, 42)
  Test.assert_true(resumed_text == "resumed")
  Test.assert_eq(resumed_number, 10)
  Test.assert_eq(conditional_scalar_transform(true), 42)
  Test.assert_eq(conditional_scalar_transform(false), 8)
}

fn conditional_nested_clause(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> {
      let inner = handle ConditionalText.read() {
        ConditionalText.read() -> if cancel { "aborted" } else { resume("resumed") }
      }
      if inner == "aborted" { 42 } else { resume(4) }
    }
  }
}

test "nested immediate clauses bind separate resume and abort destinations" {
  Test.assert_eq(conditional_nested_clause(true), 42)
  Test.assert_eq(conditional_nested_clause(false), 5)
}

fn conditional_early_exit(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> {
      if cancel { return 42 } else { nil }
      resume(4)
    }
  }
}

test "explicit abort exits before a later resume remain distinct" {
  Test.assert_eq(conditional_early_exit(true), 42)
  Test.assert_eq(conditional_early_exit(false), 5)
}

effect ConditionalManaged { fn read(value: RuntimeRcProbe) -> RuntimeRcProbe }
effect ConditionalOwned { fn read(value: owned OwnedAbortToken) -> i64 }

fn conditional_managed(mode: i64, input: RuntimeRcProbe) -> RuntimeRcProbe {
  handle ConditionalManaged.read(input) {
    ConditionalManaged.read(arg) -> match mode {
      0 -> arg
      1 -> resume(arg)
      _ -> resume(runtime_rc_probe_new(42))
    }
  }
}

fn conditional_managed_round(mode: i64, input: RuntimeRcProbe) -[Test]> nil {
  let result = conditional_managed(mode, input)
  Test.assert_eq(runtime_rc_probe_load(result), if mode == 2 { 42 } else { 7 })
  Test.assert_eq(runtime_rc_probe_count(result), if mode == 2 { 1 } else { 2 })
  nil
}

test "mixed managed parameter exits retain and release exactly their own stakes" {
  let input = runtime_rc_probe_new(7)
  for mode in 0..3 {
    conditional_managed_round(mode, input)
    Test.assert_eq(runtime_rc_probe_count(input), 1)
  }
}

fn conditional_owned_parameter(cancel: bool, log: i64) -> i64 {
  handle ConditionalOwned.read(owned_abort_token_new(log, 1)) + 1 {
    ConditionalOwned.read(resource) -> if cancel { 42 } else { resume(4) }
  }
}

test "unused owned operation parameters drop once on either immediate outcome" {
  let abort_log = defer_order_log_new()
  let resume_log = defer_order_log_new()
  Test.assert_eq(conditional_owned_parameter(true, abort_log), 42)
  Test.assert_eq(conditional_owned_parameter(false, resume_log), 5)
  Test.assert_eq(defer_order_log_read(abort_log), 1)
  Test.assert_eq(defer_order_log_read(resume_log), 1)
}

type ConditionalBorrowedResource { log: i64, value: i64 }

impl Drop for ConditionalBorrowedResource {
  fn drop(self) -> i64 {
    defer_order_log_write(self.log, defer_order_log_read(self.log) * 10 + self.value)
    0
  }
}

effect ConditionalBorrow { fn read(value: borrow ConditionalBorrowedResource) -> i64 }

fn conditional_borrowed_body(log: i64) -[ConditionalBorrow]> i64 {
  let resource: owned ConditionalBorrowedResource = ConditionalBorrowedResource { log: log, value: 4 }
  ConditionalBorrow.read(resource) + ConditionalBorrow.read(resource)
}

fn conditional_borrowed(cancel: bool, log: i64) -> i64 {
  handle conditional_borrowed_body(log) {
    ConditionalBorrow.read(resource) -> if cancel { 42 } else { resume(resource.value) }
  }
}

test "immediate borrowed parameters preserve the owner's lifetime on both exits" {
  let abort_log = defer_order_log_new()
  let resume_log = defer_order_log_new()
  Test.assert_eq(conditional_borrowed(true, abort_log), 42)
  Test.assert_eq(conditional_borrowed(false, resume_log), 8)
  Test.assert_eq(defer_order_log_read(abort_log), 4)
  Test.assert_eq(defer_order_log_read(resume_log), 4)
}

fn conditional_defer(cancel: bool, log: i64) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> {
      defer { defer_order_log_write(log, defer_order_log_read(log) * 10 + 1) }
      if cancel { 42 } else { resume(4) }
    }
  }
}

test "defer runs once for either immediate control exit" {
  let abort_log = defer_order_log_new()
  let resume_log = defer_order_log_new()
  Test.assert_eq(conditional_defer(true, abort_log), 42)
  Test.assert_eq(conditional_defer(false, resume_log), 5)
  Test.assert_eq(defer_order_log_read(abort_log), 1)
  Test.assert_eq(defer_order_log_read(resume_log), 1)
}

fn conditional_resume_through_inner_prompt(cancel: bool) -> i64 {
  handle ConditionalSignal.read() + 1 {
    ConditionalSignal.read() -> {
      handle {
        let ignored = ConditionalText.read()
        if cancel { return 42 } else { resume(4) }
      } {
        ConditionalText.read() -> resume("inner")
      }
    }
  }
}

test "lexical immediate exits leave nested handled scopes" {
  Test.assert_eq(conditional_resume_through_inner_prompt(true), 42)
  Test.assert_eq(conditional_resume_through_inner_prompt(false), 5)
}

fn conditional_managed_local(cancel: bool) -> RuntimeRcProbe {
  handle ConditionalManaged.read(runtime_rc_probe_new(7)) {
    ConditionalManaged.read(unused) -> {
      let local = runtime_rc_probe_new(42)
      if cancel { local } else { resume(local) }
    }
  }
}

test "a local managed result transfers one stake on either immediate exit" {
  let aborted = conditional_managed_local(true)
  let resumed = conditional_managed_local(false)
  Test.assert_eq(runtime_rc_probe_load(aborted), 42)
  Test.assert_eq(runtime_rc_probe_load(resumed), 42)
  Test.assert_eq(runtime_rc_probe_count(aborted), 1)
  Test.assert_eq(runtime_rc_probe_count(resumed), 1)
}

effect ConditionalFloat { fn read() -> f64 }
effect ConditionalNil { fn read() -> nil }

fn conditional_float(cancel: bool) -> f64 {
  handle ConditionalFloat.read() + 0.5 {
    ConditionalFloat.read() -> if cancel { 42.5 } else { resume(3.5) }
  }
}

fn conditional_nil(cancel: bool) -> i64 {
  handle { ConditionalNil.read() 7 } {
    ConditionalNil.read() -> if cancel { 42 } else { resume(nil) }
  }
}

test "immediate exits preserve floating and nil operation contracts" {
  Test.assert_true(conditional_float(true) == 42.5)
  Test.assert_true(conditional_float(false) == 4.0)
  Test.assert_eq(conditional_nil(true), 42)
  Test.assert_eq(conditional_nil(false), 7)
}

type ConditionalEffectResource { value: i64 }
effect ConditionalCleanup {
  fn read(resource: owned ConditionalEffectResource) -> i64
  fn dropped(value: i64) -> nil
}

impl Drop for ConditionalEffectResource {
  fn drop(self) -[ConditionalCleanup]> i64 {
    ConditionalCleanup.dropped(self.value)
    0
  }
}

fn conditional_effect_cleanup(cancel: bool, log: i64) -[ConditionalCleanup]> i64 {
  handle ConditionalCleanup.read(ConditionalEffectResource { value: 4 }) + 1 {
    ConditionalCleanup.read(resource) -> if cancel { 42 } else { resume(7) }
    ConditionalCleanup.dropped(value) -> {
      defer_order_log_write(log, defer_order_log_read(log) * 10 + value)
      resume(nil)
    }
  }
}

fn conditional_effect_cleanup_outer(cancel: bool, log: i64) -> i64 {
  handle conditional_effect_cleanup(cancel, log) {
    ConditionalCleanup.read(resource) -> resume(0)
    ConditionalCleanup.dropped(value) -> {
      defer_order_log_write(log, defer_order_log_read(log) * 10 + value * 2)
      resume(nil)
    }
  }
}

test "parameter Drop resumes inside the prompt and aborts under the outer handler" {
  let abort_log = defer_order_log_new()
  let resume_log = defer_order_log_new()
  Test.assert_eq(conditional_effect_cleanup_outer(true, abort_log), 42)
  Test.assert_eq(conditional_effect_cleanup_outer(false, resume_log), 8)
  Test.assert_eq(defer_order_log_read(abort_log), 8)
  Test.assert_eq(defer_order_log_read(resume_log), 4)
}
