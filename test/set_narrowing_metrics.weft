-- test/set_narrowing_metrics.weft -- set-theoretic match narrowing evidence

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn set_narrowing_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn set_narrowing_metric_elisions(src: str) -> i64 {
  pipeline_native_set_narrowing_elision_count(set_narrowing_metric_native(src))
}

test "set_narrowing_metric_elides_single_variant_payload_match" {
  let src = "type NarrowBoxMetric { NarrowBoxValue(i64) } fn main(x: NarrowBoxMetric) -> i64 { match x { NarrowBoxValue(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 1)
}

test "set_narrowing_metric_elides_single_variant_no_payload_match" {
  let src = "type NarrowUnitMetric { NarrowUnitValue } fn main(x: NarrowUnitMetric) -> i64 { match x { NarrowUnitValue -> 42 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 1)
}

test "set_narrowing_metric_elides_single_variant_generic_match" {
  let src = "type NarrowGenericMetric<T> { NarrowGenericValue(T) } fn main(x: NarrowGenericMetric<i64>) -> i64 { match x { NarrowGenericValue(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 1)
}

test "set_narrowing_metric_elides_tag_but_keeps_guard_fallback" {
  let src = "type NarrowGuardMetric { NarrowGuardValue(i64) } fn main(x: NarrowGuardMetric, flag: bool) -> i64 { match x { NarrowGuardValue(v) if flag -> v _ -> 99 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 1)
}

test "set_narrowing_metric_keeps_multi_variant_match_generic" {
  let src = "type NarrowChoiceMetric { NarrowChoiceA(i64), NarrowChoiceB(i64) } fn main(x: NarrowChoiceMetric) -> i64 { match x { NarrowChoiceA(v) -> v NarrowChoiceB(v) -> v + 1 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_direct_constructor_impossible_arm" {
  let src = "type NarrowValueMetric { NarrowValueA(i64), NarrowValueB(i64) } fn main() -> i64 { match NarrowValueA(42) { NarrowValueB(v) -> 0 NarrowValueA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 2)
}

test "set_narrowing_metric_elides_let_bound_constructor_impossible_arm" {
  let src = "type NarrowLetMetric { NarrowLetA(i64), NarrowLetB(i64) } fn main() -> i64 { let x = NarrowLetA(42) match x { NarrowLetB(v) -> 0 NarrowLetA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 2)
}

test "set_narrowing_metric_elides_immutable_constructor_alias" {
  let src = "type NarrowAliasMetric { NarrowAliasA(i64), NarrowAliasB(i64) } fn main() -> i64 { let x = NarrowAliasA(42) let y = x match y { NarrowAliasB(v) -> 0 NarrowAliasA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 2)
}

test "set_narrowing_metric_elides_generic_constructor_impossible_arm" {
  let src = "type NarrowValueGenericMetric<T> { NarrowValueGA(T), NarrowValueGB(T) } fn main() -> i64 { match NarrowValueGA<i64>(42) { NarrowValueGB(v) -> 0 NarrowValueGA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 2)
}

test "set_narrowing_metric_keeps_mutable_constructor_binding_generic" {
  let src = "type NarrowMutMetric { NarrowMutA(i64), NarrowMutB(i64) } fn main() -> i64 { let mut x = NarrowMutA(42) match x { NarrowMutB(v) -> 0 NarrowMutA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_function_return_constructor_generic" {
  let src = "type NarrowReturnMetric { NarrowReturnA(i64), NarrowReturnB(i64) } fn make() -> NarrowReturnMetric { NarrowReturnA(42) } fn main() -> i64 { match make() { NarrowReturnB(v) -> 0 NarrowReturnA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_dynamic_constructor_choice_generic" {
  let src = "type NarrowDynamicMetric { NarrowDynamicA(i64), NarrowDynamicB(i64) } fn main(flag: bool) -> i64 { match if flag { NarrowDynamicA(42) } else { NarrowDynamicB(7) } { NarrowDynamicB(v) -> v NarrowDynamicA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_int_match_generic" {
  let src = "fn main(x: i64) -> i64 { match x { 1 -> 42 _ -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

type RuntimeNarrowBox { RuntimeNarrowBoxValue(i64) }
type RuntimeNarrowGuard { RuntimeNarrowGuardValue(i64) }
type RuntimeNarrowGeneric<T> { RuntimeNarrowGenericValue(T) }
type RuntimeNarrowChoice { RuntimeNarrowA(i64), RuntimeNarrowB(i64) }

fn runtime_narrow_extract(x: RuntimeNarrowBox) -> i64 {
  match x {
    RuntimeNarrowBoxValue(v) -> v
    _ -> 0
  }
}

fn runtime_narrow_guard(x: RuntimeNarrowGuard, flag: bool) -> i64 {
  match x {
    RuntimeNarrowGuardValue(v) if flag -> v
    _ -> 99
  }
}

fn runtime_narrow_generic(x: RuntimeNarrowGeneric<i64>) -> i64 {
  match x {
    RuntimeNarrowGenericValue(v) -> v
  }
}

fn runtime_narrow_direct_value() -> i64 {
  match RuntimeNarrowA(42) {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_let_value() -> i64 {
  let x = RuntimeNarrowA(50)
  match x {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_alias_value() -> i64 {
  let x = RuntimeNarrowA(60)
  let y = x
  match y {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_guarded_value(flag: bool) -> i64 {
  match RuntimeNarrowA(12) {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) if flag -> v
    _ -> 99
  }
}

test "set_narrowing_runtime_single_variant_payload_and_wildcard" {
  Test.assert_eq(runtime_narrow_extract(RuntimeNarrowBoxValue(42)), 42)
}

test "set_narrowing_runtime_guard_true_and_false" {
  Test.assert_eq(runtime_narrow_guard(RuntimeNarrowGuardValue(12), true), 12)
  Test.assert_eq(runtime_narrow_guard(RuntimeNarrowGuardValue(12), false), 99)
}

test "set_narrowing_runtime_generic_single_variant" {
  Test.assert_eq(runtime_narrow_generic(RuntimeNarrowGenericValue<i64>(77)), 77)
}

test "set_narrowing_runtime_direct_and_let_constructor_values" {
  Test.assert_eq(runtime_narrow_direct_value(), 42)
  Test.assert_eq(runtime_narrow_let_value(), 50)
  Test.assert_eq(runtime_narrow_alias_value(), 60)
}

test "set_narrowing_runtime_value_guard_true_and_false" {
  Test.assert_eq(runtime_narrow_guarded_value(true), 12)
  Test.assert_eq(runtime_narrow_guarded_value(false), 99)
}
