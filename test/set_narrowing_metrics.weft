-- test/set_narrowing_metrics.weft -- set-theoretic match narrowing evidence
--
-- Rebaselined 2026-07-09: the legacy set-narrowing elision pass was deleted
-- with the AST backend and has no typed-IR port yet; counts pinned at current
-- reality as tripwires (see 2k brief).

use "compiler/codegen.weft"
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"

fn set_narrowing_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn set_narrowing_metric_elisions(src: str) -> i64 {
  pipeline_native_set_narrowing_elision_count(set_narrowing_metric_native(src))
}

test "set_narrowing_metric_elides_single_variant_payload_match" {
  let src = "type NarrowBoxMetric { NarrowBoxValue(i64) } fn main(x: NarrowBoxMetric) -> i64 { match x { NarrowBoxValue(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_single_variant_no_payload_match" {
  let src = "type NarrowUnitMetric { NarrowUnitValue } fn main(x: NarrowUnitMetric) -> i64 { match x { NarrowUnitValue -> 42 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_single_variant_generic_match" {
  let src = "type NarrowGenericMetric<T> { NarrowGenericValue(T) } fn main(x: NarrowGenericMetric<i64>) -> i64 { match x { NarrowGenericValue(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_tag_but_keeps_guard_fallback" {
  let src = "type NarrowGuardMetric { NarrowGuardValue(i64) } fn main(x: NarrowGuardMetric, flag: bool) -> i64 { match x { NarrowGuardValue(v) if flag -> v _ -> 99 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_two_variant_remaining_constructor" {
  let src = "type NarrowChoiceMetric { NarrowChoiceA(i64), NarrowChoiceB(i64) } fn main(x: NarrowChoiceMetric) -> i64 { match x { NarrowChoiceA(v) -> v NarrowChoiceB(v) -> v + 1 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_three_variant_final_remaining_constructor" {
  let src = "type NarrowChoice3Metric { NarrowChoice3A(i64), NarrowChoice3B(i64), NarrowChoice3C(i64) } fn main(x: NarrowChoice3Metric) -> i64 { match x { NarrowChoice3A(v) -> v NarrowChoice3B(v) -> v + 1 NarrowChoice3C(v) -> v + 2 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_guarded_constructor_remaining_residual" {
  let src = "type NarrowGuardChoiceMetric { NarrowGuardChoiceA(i64), NarrowGuardChoiceB(i64) } fn main(x: NarrowGuardChoiceMetric, flag: bool) -> i64 { match x { NarrowGuardChoiceA(v) if flag -> v NarrowGuardChoiceB(v) -> v + 1 _ -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_wildcard_remaining_residual" {
  let src = "type NarrowWildcardChoiceMetric { NarrowWildcardChoiceA(i64), NarrowWildcardChoiceB(i64) } fn main(x: NarrowWildcardChoiceMetric) -> i64 { match x { NarrowWildcardChoiceA(v) -> v _ -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_direct_constructor_impossible_arm" {
  let src = "type NarrowValueMetric { NarrowValueA(i64), NarrowValueB(i64) } fn main() -> i64 { match NarrowValueA(42) { NarrowValueB(v) -> 0 NarrowValueA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_let_bound_constructor_impossible_arm" {
  let src = "type NarrowLetMetric { NarrowLetA(i64), NarrowLetB(i64) } fn main() -> i64 { let x = NarrowLetA(42) match x { NarrowLetB(v) -> 0 NarrowLetA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_immutable_constructor_alias" {
  let src = "type NarrowAliasMetric { NarrowAliasA(i64), NarrowAliasB(i64) } fn main() -> i64 { let x = NarrowAliasA(42) let y = x match y { NarrowAliasB(v) -> 0 NarrowAliasA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_generic_constructor_impossible_arm" {
  let src = "type NarrowValueGenericMetric<T> { NarrowValueGA(T), NarrowValueGB(T) } fn main() -> i64 { match NarrowValueGA<i64>(42) { NarrowValueGB(v) -> 0 NarrowValueGA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_mutable_constructor_binding_residual" {
  let src = "type NarrowMutMetric { NarrowMutA(i64), NarrowMutB(i64) } fn main() -> i64 { let mut x = NarrowMutA(42) match x { NarrowMutB(v) -> 0 NarrowMutA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_remaining_after_function_return_constructor" {
  let src = "type NarrowReturnMetric { NarrowReturnA(i64), NarrowReturnB(i64) } fn make() -> NarrowReturnMetric { NarrowReturnA(42) } fn main() -> i64 { match make() { NarrowReturnB(v) -> 0 NarrowReturnA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_dynamic_constructor_choice_residual" {
  let src = "type NarrowDynamicMetric { NarrowDynamicA(i64), NarrowDynamicB(i64) } fn main(flag: bool) -> i64 { match if flag { NarrowDynamicA(42) } else { NarrowDynamicB(7) } { NarrowDynamicB(v) -> v NarrowDynamicA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_nested_single_variant_payload_match" {
  let src = "type NarrowPayloadInnerMetric { NarrowPayloadInner(i64) } type NarrowPayloadOuterMetric { NarrowPayloadWrap(NarrowPayloadInnerMetric), NarrowPayloadEmpty } fn main(x: NarrowPayloadOuterMetric) -> i64 { match x { NarrowPayloadWrap(inner) -> match inner { NarrowPayloadInner(v) -> v } NarrowPayloadEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_generic_multi_payload_binding_match" {
  let src = "type NarrowPayloadBoxMetric<T> { NarrowPayloadBox(T) } type NarrowPayloadPairMetric<T> { NarrowPayloadPair(NarrowPayloadBoxMetric<T>, i64), NarrowPayloadPairEmpty } fn main(x: NarrowPayloadPairMetric<i64>) -> i64 { match x { NarrowPayloadPair(inner, extra) -> match inner { NarrowPayloadBox(v) -> v + extra } NarrowPayloadPairEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_multi_variant_payload_remaining_constructor" {
  let src = "type NarrowPayloadChoiceMetric { NarrowPayloadLeft(i64), NarrowPayloadRight(i64) } type NarrowPayloadChoiceOuterMetric { NarrowPayloadChoiceWrap(NarrowPayloadChoiceMetric), NarrowPayloadChoiceEmpty } fn main(x: NarrowPayloadChoiceOuterMetric) -> i64 { match x { NarrowPayloadChoiceWrap(inner) -> match inner { NarrowPayloadLeft(v) -> v NarrowPayloadRight(v) -> v + 1 } NarrowPayloadChoiceEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_exact_multi_variant_payload_constructor" {
  let src = "type NarrowPayloadExactInnerMetric { NarrowPayloadExactA(i64), NarrowPayloadExactB(i64) } type NarrowPayloadExactOuterMetric { NarrowPayloadExactWrap(NarrowPayloadExactInnerMetric), NarrowPayloadExactEmpty } fn main() -> i64 { match NarrowPayloadExactWrap(NarrowPayloadExactA(42)) { NarrowPayloadExactWrap(inner) -> match inner { NarrowPayloadExactB(v) -> 0 NarrowPayloadExactA(v) -> v } NarrowPayloadExactEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_exact_payload_through_immutable_alias" {
  let src = "type NarrowPayloadAliasInnerMetric { NarrowPayloadAliasA(i64), NarrowPayloadAliasB(i64) } type NarrowPayloadAliasOuterMetric { NarrowPayloadAliasWrap(NarrowPayloadAliasInnerMetric), NarrowPayloadAliasEmpty } fn main() -> i64 { let x = NarrowPayloadAliasWrap(NarrowPayloadAliasA(42)) let y = x match y { NarrowPayloadAliasEmpty -> 0 NarrowPayloadAliasWrap(inner) -> match inner { NarrowPayloadAliasB(v) -> 0 NarrowPayloadAliasA(v) -> v } } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_exact_multi_payload_constructor_origin" {
  let src = "type NarrowPayloadPairInnerMetric { NarrowPayloadPairA(i64), NarrowPayloadPairB(i64) } type NarrowPayloadExactPairMetric { NarrowPayloadExactPair(i64, NarrowPayloadPairInnerMetric), NarrowPayloadExactPairEmpty } fn main() -> i64 { match NarrowPayloadExactPair(7, NarrowPayloadPairB(5)) { NarrowPayloadExactPair(extra, inner) -> match inner { NarrowPayloadPairA(v) -> extra NarrowPayloadPairB(v) -> v + extra } NarrowPayloadExactPairEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_dynamic_payload_origin_residual" {
  let src = "type NarrowPayloadDynInnerMetric { NarrowPayloadDynA(i64), NarrowPayloadDynB(i64) } type NarrowPayloadDynOuterMetric { NarrowPayloadDynWrap(NarrowPayloadDynInnerMetric), NarrowPayloadDynEmpty } fn main(flag: bool) -> i64 { let inner = if flag { NarrowPayloadDynA(1) } else { NarrowPayloadDynB(2) } match NarrowPayloadDynWrap(inner) { NarrowPayloadDynWrap(x) -> match x { NarrowPayloadDynA(v) -> v NarrowPayloadDynB(v) -> v + 1 } NarrowPayloadDynEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_function_return_payload_origin_residual" {
  let src = "type NarrowPayloadReturnInnerMetric { NarrowPayloadReturnA(i64), NarrowPayloadReturnB(i64) } type NarrowPayloadReturnOuterMetric { NarrowPayloadReturnWrap(NarrowPayloadReturnInnerMetric), NarrowPayloadReturnEmpty } fn make(flag: bool) -> NarrowPayloadReturnInnerMetric { if flag { NarrowPayloadReturnA(1) } else { NarrowPayloadReturnB(2) } } fn main(flag: bool) -> i64 { match NarrowPayloadReturnWrap(make(flag)) { NarrowPayloadReturnWrap(x) -> match x { NarrowPayloadReturnA(v) -> v NarrowPayloadReturnB(v) -> v + 1 } NarrowPayloadReturnEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_if_join_same_constructor" {
  let src = "type NarrowJoinMetric { NarrowJoinA(i64), NarrowJoinB(i64) } fn main(flag: bool) -> i64 { let x = if flag { NarrowJoinA(1) } else { NarrowJoinA(2) } match x { NarrowJoinB(v) -> 0 NarrowJoinA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_direct_if_join_same_constructor" {
  let src = "type NarrowDirectJoinMetric { NarrowDirectJoinA(i64), NarrowDirectJoinB(i64) } fn main(flag: bool) -> i64 { match if flag { NarrowDirectJoinA(1) } else { NarrowDirectJoinA(2) } { NarrowDirectJoinB(v) -> 0 NarrowDirectJoinA(v) -> v } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_elides_if_join_same_payload_constructor" {
  let src = "type NarrowJoinInnerMetric { NarrowJoinInnerA(i64), NarrowJoinInnerB(i64) } type NarrowJoinOuterMetric { NarrowJoinWrap(NarrowJoinInnerMetric), NarrowJoinEmpty } fn main(flag: bool) -> i64 { let x = if flag { NarrowJoinWrap(NarrowJoinInnerA(1)) } else { NarrowJoinWrap(NarrowJoinInnerA(2)) } match x { NarrowJoinEmpty -> 0 NarrowJoinWrap(inner) -> match inner { NarrowJoinInnerB(v) -> 0 NarrowJoinInnerA(v) -> v } } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_mixed_if_join_payload_residual" {
  let src = "type NarrowJoinMixedInnerMetric { NarrowJoinMixedA(i64), NarrowJoinMixedB(i64) } type NarrowJoinMixedOuterMetric { NarrowJoinMixedWrap(NarrowJoinMixedInnerMetric), NarrowJoinMixedEmpty } fn main(flag: bool) -> i64 { let x = if flag { NarrowJoinMixedWrap(NarrowJoinMixedA(1)) } else { NarrowJoinMixedWrap(NarrowJoinMixedB(2)) } match x { NarrowJoinMixedWrap(inner) -> match inner { NarrowJoinMixedA(v) -> v NarrowJoinMixedB(v) -> v + 1 } NarrowJoinMixedEmpty -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

test "set_narrowing_metric_keeps_int_match_generic" {
  let src = "fn main(x: i64) -> i64 { match x { 1 -> 42 _ -> 0 } }"
  Test.assert_eq(set_narrowing_metric_elisions(src), 0)
}

type RuntimeNarrowBox { RuntimeNarrowBoxValue(i64) }
type RuntimeNarrowGuard { RuntimeNarrowGuardValue(i64) }
type RuntimeNarrowGeneric<T> { RuntimeNarrowGenericValue(T) }
type RuntimeNarrowChoice { RuntimeNarrowA(i64), RuntimeNarrowB(i64) }
type RuntimeNarrowChoice3 { RuntimeNarrow3A(i64), RuntimeNarrow3B(i64), RuntimeNarrow3C(i64) }
type RuntimeNarrowPayloadInner { RuntimeNarrowPayloadInnerValue(i64) }
type RuntimeNarrowPayloadOuter { RuntimeNarrowPayloadWrap(RuntimeNarrowPayloadInner), RuntimeNarrowPayloadEmpty }
type RuntimeNarrowPayloadBox<T> { RuntimeNarrowPayloadBoxValue(T) }
type RuntimeNarrowPayloadPair<T> { RuntimeNarrowPayloadPair(RuntimeNarrowPayloadBox<T>, i64), RuntimeNarrowPayloadPairEmpty }
type RuntimeNarrowPayloadChoice { RuntimeNarrowPayloadLeft(i64), RuntimeNarrowPayloadRight(i64) }
type RuntimeNarrowPayloadChoiceOuter { RuntimeNarrowPayloadChoiceWrap(RuntimeNarrowPayloadChoice), RuntimeNarrowPayloadChoiceEmpty }
type RuntimeNarrowPayloadChoicePair { RuntimeNarrowPayloadChoicePairValue(i64, RuntimeNarrowPayloadChoice), RuntimeNarrowPayloadChoicePairEmpty }
type RuntimeNarrowJoin { RuntimeNarrowJoinA(i64), RuntimeNarrowJoinB(i64) }
type RuntimeNarrowJoinOuter { RuntimeNarrowJoinWrap(RuntimeNarrowJoin), RuntimeNarrowJoinEmpty }

fn runtime_narrow_extract(x: RuntimeNarrowBox) -> i64 {
  match x {
    RuntimeNarrowBoxValue(v) -> v
    _ -> 0
  }
}

fn runtime_narrow_guard(x: RuntimeNarrowGuard, flag: bool) -> i64 {
  match x {
    RuntimeNarrowGuardValue(v) if flag -> v
    _ -> 99
  }
}

fn runtime_narrow_generic(x: RuntimeNarrowGeneric<i64>) -> i64 {
  match x {
    RuntimeNarrowGenericValue(v) -> v
  }
}

fn runtime_narrow_direct_value() -> i64 {
  match RuntimeNarrowA(42) {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_let_value() -> i64 {
  let x = RuntimeNarrowA(50)
  match x {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_alias_value() -> i64 {
  let x = RuntimeNarrowA(60)
  let y = x
  match y {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) -> v
  }
}

fn runtime_narrow_remaining_choice(x: RuntimeNarrowChoice) -> i64 {
  match x {
    RuntimeNarrowA(v) -> v
    RuntimeNarrowB(v) -> v + 1
  }
}

fn runtime_narrow_remaining_three(x: RuntimeNarrowChoice3) -> i64 {
  match x {
    RuntimeNarrow3A(v) -> v
    RuntimeNarrow3B(v) -> v + 1
    RuntimeNarrow3C(v) -> v + 2
  }
}

fn runtime_narrow_guarded_remaining(x: RuntimeNarrowChoice, flag: bool) -> i64 {
  match x {
    RuntimeNarrowA(v) if flag -> v
    RuntimeNarrowB(v) -> v + 1
    _ -> 0
  }
}

fn runtime_narrow_wildcard_remaining(x: RuntimeNarrowChoice) -> i64 {
  match x {
    RuntimeNarrowA(v) -> v
    _ -> 0
  }
}

fn runtime_narrow_guarded_value(flag: bool) -> i64 {
  match RuntimeNarrowA(12) {
    RuntimeNarrowB(v) -> 0
    RuntimeNarrowA(v) if flag -> v
    _ -> 99
  }
}

fn runtime_narrow_payload_nested(x: RuntimeNarrowPayloadOuter) -> i64 {
  match x {
    RuntimeNarrowPayloadWrap(inner) -> match inner {
      RuntimeNarrowPayloadInnerValue(v) -> v
    }
    RuntimeNarrowPayloadEmpty -> 0
  }
}

fn runtime_narrow_payload_generic(x: RuntimeNarrowPayloadPair<i64>) -> i64 {
  match x {
    RuntimeNarrowPayloadPair(inner, extra) -> match inner {
      RuntimeNarrowPayloadBoxValue(v) -> v + extra
    }
    RuntimeNarrowPayloadPairEmpty -> 0
  }
}

fn runtime_narrow_payload_choice(x: RuntimeNarrowPayloadChoiceOuter) -> i64 {
  match x {
    RuntimeNarrowPayloadChoiceWrap(inner) -> match inner {
      RuntimeNarrowPayloadLeft(v) -> v
      RuntimeNarrowPayloadRight(v) -> v + 1
    }
    RuntimeNarrowPayloadChoiceEmpty -> 0
  }
}

fn runtime_narrow_payload_exact_direct() -> i64 {
  match RuntimeNarrowPayloadChoiceWrap(RuntimeNarrowPayloadRight(10)) {
    RuntimeNarrowPayloadChoiceWrap(inner) -> match inner {
      RuntimeNarrowPayloadLeft(v) -> 0
      RuntimeNarrowPayloadRight(v) -> v + 1
    }
    RuntimeNarrowPayloadChoiceEmpty -> 0
  }
}

fn runtime_narrow_payload_exact_alias() -> i64 {
  let x = RuntimeNarrowPayloadChoiceWrap(RuntimeNarrowPayloadLeft(9))
  let y = x
  match y {
    RuntimeNarrowPayloadChoiceEmpty -> 0
    RuntimeNarrowPayloadChoiceWrap(inner) -> match inner {
      RuntimeNarrowPayloadRight(v) -> 0
      RuntimeNarrowPayloadLeft(v) -> v
    }
  }
}

fn runtime_narrow_payload_exact_multi_payload() -> i64 {
  match RuntimeNarrowPayloadChoicePairValue(5, RuntimeNarrowPayloadRight(7)) {
    RuntimeNarrowPayloadChoicePairValue(extra, inner) -> match inner {
      RuntimeNarrowPayloadLeft(v) -> extra
      RuntimeNarrowPayloadRight(v) -> v + extra
    }
    RuntimeNarrowPayloadChoicePairEmpty -> 0
  }
}

fn runtime_narrow_payload_dynamic(flag: bool) -> i64 {
  let inner = if flag { RuntimeNarrowPayloadLeft(3) } else { RuntimeNarrowPayloadRight(4) }
  match RuntimeNarrowPayloadChoiceWrap(inner) {
    RuntimeNarrowPayloadChoiceWrap(x) -> match x {
      RuntimeNarrowPayloadLeft(v) -> v
      RuntimeNarrowPayloadRight(v) -> v + 1
    }
    RuntimeNarrowPayloadChoiceEmpty -> 0
  }
}

fn runtime_narrow_join_same(flag: bool) -> i64 {
  let x = if flag { RuntimeNarrowJoinA(8) } else { RuntimeNarrowJoinA(9) }
  match x {
    RuntimeNarrowJoinB(v) -> 0
    RuntimeNarrowJoinA(v) -> v
  }
}

fn runtime_narrow_join_payload_same(flag: bool) -> i64 {
  let x = if flag { RuntimeNarrowJoinWrap(RuntimeNarrowJoinA(4)) } else { RuntimeNarrowJoinWrap(RuntimeNarrowJoinA(5)) }
  match x {
    RuntimeNarrowJoinEmpty -> 0
    RuntimeNarrowJoinWrap(inner) -> match inner {
      RuntimeNarrowJoinB(v) -> 0
      RuntimeNarrowJoinA(v) -> v
    }
  }
}

fn runtime_narrow_join_payload_mixed(flag: bool) -> i64 {
  let x = if flag { RuntimeNarrowJoinWrap(RuntimeNarrowJoinA(6)) } else { RuntimeNarrowJoinWrap(RuntimeNarrowJoinB(7)) }
  match x {
    RuntimeNarrowJoinWrap(inner) -> match inner {
      RuntimeNarrowJoinA(v) -> v
      RuntimeNarrowJoinB(v) -> v + 1
    }
    RuntimeNarrowJoinEmpty -> 0
  }
}

test "set_narrowing_runtime_single_variant_payload_and_wildcard" {
  Test.assert_eq(runtime_narrow_extract(RuntimeNarrowBoxValue(42)), 42)
}

test "set_narrowing_runtime_guard_true_and_false" {
  Test.assert_eq(runtime_narrow_guard(RuntimeNarrowGuardValue(12), true), 12)
  Test.assert_eq(runtime_narrow_guard(RuntimeNarrowGuardValue(12), false), 99)
}

test "set_narrowing_runtime_generic_single_variant" {
  Test.assert_eq(runtime_narrow_generic(RuntimeNarrowGenericValue<i64>(77)), 77)
}

test "set_narrowing_runtime_direct_and_let_constructor_values" {
  Test.assert_eq(runtime_narrow_direct_value(), 42)
  Test.assert_eq(runtime_narrow_let_value(), 50)
  Test.assert_eq(runtime_narrow_alias_value(), 60)
}

test "set_narrowing_runtime_remaining_constructor_paths" {
  Test.assert_eq(runtime_narrow_remaining_choice(RuntimeNarrowA(10)), 10)
  Test.assert_eq(runtime_narrow_remaining_choice(RuntimeNarrowB(10)), 11)
  Test.assert_eq(runtime_narrow_remaining_three(RuntimeNarrow3A(10)), 10)
  Test.assert_eq(runtime_narrow_remaining_three(RuntimeNarrow3B(10)), 11)
  Test.assert_eq(runtime_narrow_remaining_three(RuntimeNarrow3C(10)), 12)
}

test "set_narrowing_runtime_remaining_guard_and_wildcard_residuals" {
  Test.assert_eq(runtime_narrow_guarded_remaining(RuntimeNarrowA(10), true), 10)
  Test.assert_eq(runtime_narrow_guarded_remaining(RuntimeNarrowA(10), false), 0)
  Test.assert_eq(runtime_narrow_guarded_remaining(RuntimeNarrowB(10), false), 11)
  Test.assert_eq(runtime_narrow_wildcard_remaining(RuntimeNarrowA(10)), 10)
  Test.assert_eq(runtime_narrow_wildcard_remaining(RuntimeNarrowB(10)), 0)
}

test "set_narrowing_runtime_value_guard_true_and_false" {
  Test.assert_eq(runtime_narrow_guarded_value(true), 12)
  Test.assert_eq(runtime_narrow_guarded_value(false), 99)
}

test "set_narrowing_runtime_nested_payload_single_variant" {
  Test.assert_eq(runtime_narrow_payload_nested(RuntimeNarrowPayloadWrap(RuntimeNarrowPayloadInnerValue(44))), 44)
  Test.assert_eq(runtime_narrow_payload_nested(RuntimeNarrowPayloadEmpty), 0)
}

test "set_narrowing_runtime_generic_multi_payload_binding" {
  Test.assert_eq(runtime_narrow_payload_generic(RuntimeNarrowPayloadPair<i64>(RuntimeNarrowPayloadBoxValue<i64>(40), 2)), 42)
  Test.assert_eq(runtime_narrow_payload_generic(RuntimeNarrowPayloadPairEmpty<i64>()), 0)
}

test "set_narrowing_runtime_multi_variant_payload_residual" {
  Test.assert_eq(runtime_narrow_payload_choice(RuntimeNarrowPayloadChoiceWrap(RuntimeNarrowPayloadLeft(10))), 10)
  Test.assert_eq(runtime_narrow_payload_choice(RuntimeNarrowPayloadChoiceWrap(RuntimeNarrowPayloadRight(10))), 11)
  Test.assert_eq(runtime_narrow_payload_choice(RuntimeNarrowPayloadChoiceEmpty), 0)
}

test "set_narrowing_runtime_exact_payload_origins" {
  Test.assert_eq(runtime_narrow_payload_exact_direct(), 11)
  Test.assert_eq(runtime_narrow_payload_exact_alias(), 9)
  Test.assert_eq(runtime_narrow_payload_exact_multi_payload(), 12)
}

test "set_narrowing_runtime_dynamic_payload_origin_residual" {
  Test.assert_eq(runtime_narrow_payload_dynamic(true), 3)
  Test.assert_eq(runtime_narrow_payload_dynamic(false), 5)
}

test "set_narrowing_runtime_if_join_origins" {
  Test.assert_eq(runtime_narrow_join_same(true), 8)
  Test.assert_eq(runtime_narrow_join_same(false), 9)
  Test.assert_eq(runtime_narrow_join_payload_same(true), 4)
  Test.assert_eq(runtime_narrow_join_payload_same(false), 5)
  Test.assert_eq(runtime_narrow_join_payload_mixed(true), 6)
  Test.assert_eq(runtime_narrow_join_payload_mixed(false), 8)
}
