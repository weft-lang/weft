-- E1004: exact trait identity, negative-proof evidence, and orphan-aware help.

use compiler/grammar.{*}
use compiler/lib.{*}
use compiler/parse.{parse_module}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/source_acquire.{source_acquire_with_standalone}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type/render.{semantic_type_render}
use stdlib/string.{str_eq, str_find, str_find_from}

fn conformance_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { conformance_text_field(rest, key, fallback) }
      _ -> conformance_text_field(rest, key, fallback)
    }
  }
}

fn conformance_type_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldType(name, value) -> if str_eq(name, key) == 1 { semantic_type_render(value) } else { conformance_type_field(rest, key, fallback) }
      _ -> conformance_type_field(rest, key, fallback)
    }
  }
}

fn conformance_i64_field(fields: DiagnosticFieldList, key: str, fallback: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldI64(name, value) -> if str_eq(name, key) == 1 { value } else { conformance_i64_field(rest, key, fallback) }
      _ -> conformance_i64_field(rest, key, fallback)
    }
  }
}

fn conformance_bool_field(fields: DiagnosticFieldList, key: str, fallback: bool) -> bool {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldBool(name, value) -> if str_eq(name, key) == 1 { value } else { conformance_bool_field(rest, key, fallback) }
      _ -> conformance_bool_field(rest, key, fallback)
    }
  }
}

fn conformance_suggestion_matches(fields: DiagnosticFieldList, expected: str) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(DiagnosticSuggestion(message, DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditNil)) -> {
        if str_eq(message, expected) == 1 { 1 } else { conformance_suggestion_matches(rest, expected) }
      }
      _ -> conformance_suggestion_matches(rest, expected)
    }
  }
}

fn conformance_related_at(related: DiagnosticRelatedLocationList, label: str, src: i64, start: i64, end: i64) -> i64 {
  if start < 0 { 1 }
  else { match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(actual_label, DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), actual_start, actual_end)), rest) -> {
      if str_eq(actual_label, label) == 1 and actual_src == src and actual_start == start and actual_end == end { 1 }
      else { conformance_related_at(rest, label, src, start, end) }
    }
    DiagnosticRelatedLocationCons(item, rest) -> conformance_related_at(rest, label, src, start, end)
  } }
}

fn conformance_related_has_label(related: DiagnosticRelatedLocationList, label: str) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(actual_label, location), rest) -> {
      if str_eq(actual_label, label) == 1 { 1 } else { conformance_related_has_label(rest, label) }
    }
  }
}

fn conformance_primary_at(diagnostic: Diagnostic, src: i64, start: i64, end: i64) -> i64 {
  match diagnostic_primary(diagnostic) {
    DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), actual_start, actual_end) -> {
      if actual_src == src and actual_start == start and actual_end == end { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn conformance_core_matches(
  diagnostic: Diagnostic,
  fields: DiagnosticFieldList,
  message: str,
  context: str,
  reason: str,
  target: str,
  trait_name: str,
  placement: str,
  impl_allowed: bool,
  candidate_count: i64,
  suggestion: str
) -> i64 {
  if str_eq(diagnostic_message(diagnostic), message) == 1 and
     str_eq(conformance_text_field(fields, "context", ""), context) == 1 and
     str_eq(conformance_text_field(fields, "reason", ""), reason) == 1 and
     str_eq(conformance_text_field(fields, "decision", ""), "no") == 1 and
     str_eq(conformance_type_field(fields, "target_type", ""), target) == 1 and
     str_eq(conformance_type_field(fields, "required_trait", ""), trait_name) == 1 and
     str_eq(conformance_text_field(fields, "target_type_text", ""), target) == 1 and
     str_eq(conformance_text_field(fields, "required_trait_text", ""), trait_name) == 1 and
     str_eq(conformance_text_field(fields, "impl_placement", ""), placement) == 1 and
     conformance_bool_field(fields, "impl_allowed_here", not impl_allowed) == impl_allowed and
     conformance_i64_field(fields, "candidate_impl_count", 0 - 1) == candidate_count and
     conformance_suggestion_matches(fields, suggestion) == 1 { 1 } else { 0 }
}

fn conformance_has_no_extended_proof(fields: DiagnosticFieldList) -> i64 {
  if str_eq(conformance_type_field(fields, "candidate_target", "absent"), "absent") == 1 and
     str_eq(conformance_type_field(fields, "unsatisfied_nested_type", "absent"), "absent") == 1 and
     str_eq(conformance_type_field(fields, "unsatisfied_nested_trait", "absent"), "absent") == 1 and
     str_eq(conformance_type_field(fields, "nearby_trait", "absent"), "absent") == 1 and
     str_eq(conformance_text_field(fields, "sendability_reason", "absent"), "absent") == 1 and
     str_eq(conformance_type_field(fields, "sendability_offender", "absent"), "absent") == 1 { 1 } else { 0 }
}

fn conformance_diagnostic_case_matches(diagnostic: Diagnostic, src: i64, source: str, case_id: i64) -> i64 {
  let fields = diagnostic_fields(diagnostic)
  let related = diagnostic_related(diagnostic)
  let case_ok = match case_id {
    1 -> {
      let primary = str_find_from(source, "bool", str_find(source, "need<bool>"))
      let bound = str_find(source, "Mark>")
      let trait_decl = str_find(source, "Mark")
      conformance_core_matches(diagnostic, fields, "type `bool` does not implement `Mark`", "generic argument", "missing_impl", "bool", "Mark", "current_module_trait_local", true, 0, "define a legal implementation in this module or use a conforming type") == 1 and
      conformance_has_no_extended_proof(fields) == 1 and conformance_primary_at(diagnostic, src, primary, primary + 4) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 4) == 1 and
      conformance_related_at(related, "trait declared here", src, trait_decl, trait_decl + 4) == 1
    }
    2 -> {
      let primary = str_find_from(source, "Box<bool>", str_find(source, "need<Box"))
      let bound = str_find_from(source, "Identity", str_find(source, "fn need"))
      let trait_decl = str_find(source, "Identity")
      let target_decl = str_find(source, "Box<T>")
      let candidate = str_find_from(source, "Box<T>", str_find(source, "impl<T"))
      conformance_core_matches(diagnostic, fields, "type `Box<bool>` does not implement `Identity`", "generic argument", "conditional_impl_bound_failed", "Box<bool>", "Identity", "current_module_trait_local", true, 1, "define a legal implementation in this module or use a conforming type") == 1 and
      str_eq(conformance_type_field(fields, "candidate_target", ""), "Box<T>") == 1 and
      str_eq(conformance_type_field(fields, "unsatisfied_nested_type", ""), "bool") == 1 and
      str_eq(conformance_type_field(fields, "unsatisfied_nested_trait", ""), "Marked") == 1 and
      conformance_primary_at(diagnostic, src, primary, primary + 9) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 8) == 1 and
      conformance_related_at(related, "trait declared here", src, trait_decl, trait_decl + 8) == 1 and
      conformance_related_at(related, "target type declared here", src, target_decl, target_decl + 3) == 1 and
      conformance_related_at(related, "matching impl candidate rejected by its own bound", src, candidate, candidate + 3) == 1
    }
    3 -> {
      let primary = str_find_from(source, "U>", str_find(source, "need<U>"))
      let bound = str_find(source, "Mark>")
      let trait_decl = str_find(source, "Mark")
      conformance_core_matches(diagnostic, fields, "type `U` does not implement `Mark`", "generic argument", "missing_carried_bound", "U", "Mark", "carry_bound", false, 0, "carry the required bound on the enclosing type parameter") == 1 and
      conformance_has_no_extended_proof(fields) == 1 and conformance_primary_at(diagnostic, src, primary, primary + 1) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 4) == 1 and
      conformance_related_at(related, "trait declared here", src, trait_decl, trait_decl + 4) == 1
    }
    4 -> {
      let primary = str_find_from(source, "Box>", str_find(source, "need<Box>"))
      let bound = str_find_from(source, "right.Gauge", str_find(source, "fn need"))
      let target_decl = str_find(source, "Box {")
      conformance_core_matches(diagnostic, fields, "type `Box` does not implement `module_fixtures/g2_trait_right.Gauge`", "generic argument", "different_trait_declaration", "Box", "module_fixtures/g2_trait_right.Gauge", "current_module_type_local", true, 0, "define a legal implementation in this module or use a conforming type") == 1 and
      str_eq(conformance_type_field(fields, "nearby_trait", ""), "module_fixtures/g2_trait_left.Gauge") == 1 and
      conformance_primary_at(diagnostic, src, primary, primary + 3) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 11) == 1 and
      conformance_related_at(related, "target type declared here", src, target_decl, target_decl + 3) == 1 and
      conformance_related_has_label(related, "trait declared here") == 1 and
      conformance_related_has_label(related, "this is the distinct trait declaration the type implements") == 1
    }
    5 -> {
      let primary = str_find_from(source, "str", str_find(source, "type Item ="))
      let bound = str_find_from(source, "Value", str_find(source, "type Item:"))
      let trait_decl = str_find(source, "Value")
      conformance_core_matches(diagnostic, fields, "type `str` does not implement `Value`", "associated type binding", "missing_impl", "str", "Value", "current_module_trait_local", true, 0, "define a legal implementation in this module or use a conforming type") == 1 and
      conformance_has_no_extended_proof(fields) == 1 and conformance_primary_at(diagnostic, src, primary, primary + 3) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 5) == 1 and
      conformance_related_at(related, "trait declared here", src, trait_decl, trait_decl + 5) == 1
    }
    6 -> {
      let primary = str_find_from(source, "Unordered", str_find(source, "fn main"))
      let target_decl = str_find(source, "Unordered")
      conformance_core_matches(diagnostic, fields, "type `Unordered` does not implement `Ord`", "ordering operand", "missing_impl", "Unordered", "Ord", "current_module_type_local", true, 0, "define a legal implementation in this module or use a conforming type") == 1 and
      conformance_has_no_extended_proof(fields) == 1 and conformance_primary_at(diagnostic, src, primary, primary + 9) == 1 and
      conformance_related_at(related, "target type declared here", src, target_decl, target_decl + 9) == 1
    }
    7 -> {
      let primary = str_find_from(source, "Vector<i64>", str_find(source, "need<Vector"))
      let bound = str_find(source, "Sendable")
      let target_decl = str_find(source, "Vector<T>")
      conformance_core_matches(diagnostic, fields, "type `Vector<i64>` does not implement `Sendable`", "generic argument", "sealed_structural_requirement", "Vector<i64>", "Sendable", "sealed_structural_predicate", false, 0, "change the value shape so it has a structural Sendable proof") == 1 and
      str_eq(conformance_text_field(fields, "sendability_reason", ""), "reachable mutable state is not Sendable") == 1 and
      str_eq(conformance_type_field(fields, "sendability_offender", ""), "Vector<i64>") == 1 and
      conformance_primary_at(diagnostic, src, primary, primary + 11) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 8) == 1 and
      conformance_related_at(related, "target type declared here", src, target_decl, target_decl + 6) == 1
    }
    8 -> {
      let primary = str_find_from(source, "bool", str_find(source, "need<bool>"))
      let bound = str_find_from(source, "Second", str_find(source, "fn need"))
      let trait_decl = str_find(source, "Second")
      conformance_core_matches(diagnostic, fields, "type `bool` does not implement `Second`", "generic argument", "missing_impl", "bool", "Second", "current_module_trait_local", true, 0, "define a legal implementation in this module or use a conforming type") == 1 and
      conformance_has_no_extended_proof(fields) == 1 and conformance_primary_at(diagnostic, src, primary, primary + 4) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 6) == 1 and
      conformance_related_at(related, "trait declared here", src, trait_decl, trait_decl + 6) == 1
    }
    9 -> {
      let primary = str_find_from(source, "(i64) -> i64", str_find(source, "need<(i64)"))
      let bound = str_find(source, "Sendable")
      conformance_core_matches(diagnostic, fields, "type `(i64) -> i64` does not implement `Sendable`", "generic argument", "sealed_structural_requirement", "(i64) -> i64", "Sendable", "sealed_structural_predicate", false, 0, "change the value shape so it has a structural Sendable proof") == 1 and
      str_eq(conformance_text_field(fields, "sendability_reason", ""), "a function type alone cannot prove its concrete closure captures are Sendable") == 1 and
      str_eq(conformance_type_field(fields, "sendability_offender", "absent"), "absent") == 1 and
      conformance_primary_at(diagnostic, src, primary, primary + 12) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 8) == 1
    }
    _ -> {
      let primary = str_find_from(source, "[i64]", str_find(source, "need<[i64]"))
      let bound = str_find(source, "Sendable")
      conformance_core_matches(diagnostic, fields, "type `[i64]` does not implement `Sendable`", "generic argument", "sealed_structural_requirement", "[i64]", "Sendable", "sealed_structural_predicate", false, 0, "change the value shape so it has a structural Sendable proof") == 1 and
      str_eq(conformance_text_field(fields, "sendability_reason", ""), "a slice type alone cannot prove the scoped-join provenance of its concrete borrow") == 1 and
      str_eq(conformance_type_field(fields, "sendability_offender", "absent"), "absent") == 1 and
      conformance_primary_at(diagnostic, src, primary, primary + 5) == 1 and
      conformance_related_at(related, "required by this trait bound", src, bound, bound + 8) == 1
    }
  }
  if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1004") == 1 and
     str_eq(diagnostic_class_name(diagnostic_class(diagnostic)), "type") == 1 and
     str_eq(diagnostic_severity_name(diagnostic_severity(diagnostic)), "error") == 1 and case_ok { 1 } else { 0 }
}

fn conformance_check_source(source: str, case_id: i64) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = source_acquire_with_standalone(() => handle parse_module(grammar.lex(src, __str_len(source)), src, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  })
  let observation = alloc_zeroed(24)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1004") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        mem_store64_at(observation, 8, conformance_diagnostic_case_matches(diagnostic, src, source, case_id))
      } else { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(observation, 0) == 1 and mem_load64_at(observation, 8) == 1 and mem_load64_at(observation, 16) == 0 { 1 } else { 0 }
}

fn conformance_source_is_clean(source: str) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = source_acquire_with_standalone(() => handle parse_module(grammar.lex(src, __str_len(source)), src, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  })
  let errors = alloc_zeroed(8)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.error(message, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(errors, 0) == 0 { 1 } else { 0 }
}

test "trait_conformance_names_exact_type_bound_and_legal_impl_home" {
  let source = "trait Mark { } fn need<T: Mark>(value: T) -> T { value } fn main() -> bool { need<bool>(true) }"
  Test.assert_eq(conformance_check_source(source, 1), 1)
}

test "trait_conformance_replays_the_failed_conditional_impl_proof" {
  let source = "type Box<T> { Box(T) } trait Marked { } trait Identity { } impl Marked for i64 { } impl<T: Marked> Identity for Box<T> { } fn need<T: Identity>(value: T) -> T { value } fn main() -> Box<bool> { need<Box<bool>>(Box<bool>(true)) }"
  Test.assert_eq(conformance_check_source(source, 2), 1)
}

test "trait_conformance_teaches_the_missing_carried_generic_bound" {
  let source = "trait Mark { } fn need<T: Mark>(value: T) -> T { value } fn forward<U>(value: U) -> U { need<U>(value) }"
  Test.assert_eq(conformance_check_source(source, 3), 1)
}

test "trait_conformance_distinguishes_qualified_same_name_traits" {
  let source = "use module_fixtures/g2_trait_left as left use module_fixtures/g2_trait_right as right type Box { value: i64 } impl left.Gauge for Box { fn left(self) -> i64 { self.value } } fn need<T: right.Gauge>(value: T) -> i64 { value.right() } fn main() -> i64 { need<Box>(Box { value: 1 }) }"
  Test.assert_eq(conformance_check_source(source, 4), 1)
}

test "trait_conformance_associated_binding_points_at_the_bound_type" {
  let source = "trait Value { } trait Source { type Item: Value } type Box { value: str } impl Source for Box { type Item = str }"
  Test.assert_eq(conformance_check_source(source, 5), 1)
}

test "trait_conformance_ord_uses_the_operand_span_and_canonical_trait" {
  let source = "type Unordered { Unordered(i64) } fn main() -> bool { Unordered(1) < Unordered(2) }"
  Test.assert_eq(conformance_check_source(source, 6), 1)
}

test "trait_conformance_sendable_exposes_the_structural_failure_reason" {
  let source = "type Vector<T> { } fn need<T: Sendable>() -> i64 { 1 } fn main() -> i64 { need<Vector<i64>>() }"
  Test.assert_eq(conformance_check_source(source, 7), 1)
}

test "trait_conformance_selects_the_exact_failing_bound_from_an_intersection" {
  let source = "trait First { } trait Second { } impl First for bool { } fn need<T: First & Second>(value: T) -> T { value } fn main() -> bool { need<bool>(true) }"
  Test.assert_eq(conformance_check_source(source, 8), 1)
}

test "trait_conformance_sendable_names_value_level_evidence_requirements" {
  Test.assert_eq(conformance_check_source("fn need<T: Sendable>() -> i64 { 1 } fn main() -> i64 { need<(i64) -> i64>() }", 9), 1)
  Test.assert_eq(conformance_check_source("fn need<T: Sendable>() -> i64 { 1 } fn main() -> i64 { need<[i64]>() }", 10), 1)
}

test "trait_conformance_accepts_direct_conditional_and_carried_evidence" {
  Test.assert_eq(conformance_source_is_clean("trait Mark { } impl Mark for bool { } fn need<T: Mark>(value: T) -> T { value } fn main() -> bool { need<bool>(true) }"), 1)
  Test.assert_eq(conformance_source_is_clean("type Box<T> { Box(T) } trait Mark { } trait Identity { } impl Mark for bool { } impl<T: Mark> Identity for Box<T> { } fn need<T: Identity>(value: T) -> T { value } fn main() -> Box<bool> { need<Box<bool>>(Box<bool>(true)) }"), 1)
  Test.assert_eq(conformance_source_is_clean("trait Mark { } fn need<T: Mark>(value: T) -> T { value } fn forward<U: Mark>(value: U) -> U { need<U>(value) }"), 1)
}
