-- Fixed arrays cross a variant payload as one managed storage handle. The
-- variant owns one count, while extraction returns an independently owned
-- handle. A managed leaf makes missing deep release observable as an exact RC
-- leak after every enclosing handle has left scope.

use runtime/rc_implicit_test.{*}
use runtime/rc.{*}
use runtime/effects.{*}

type VariantArrayCarrier {
  VariantArrayEmpty,
  VariantArrayValue([RuntimeRcProbe; 1])
}

fn variant_array_from_probe(probe: RuntimeRcProbe) -> [RuntimeRcProbe; 1] {
  let storage = rc_array_storage_new(8, 8, 1, 8, continuation_cleanup_kind_rc())
  let raw = runtime_rc_probe_word(probe)
  rc_default_retain(raw)
  runtime_rc_test_store64(rc_array_storage_data(storage), raw)
  runtime_generator_state_word_as<[RuntimeRcProbe; 1]>(storage)
}

fn variant_array_wrap(values: [RuntimeRcProbe; 1]) -> VariantArrayCarrier {
  VariantArrayValue(values)
}

fn variant_array_extract(value: VariantArrayCarrier, fallback: [RuntimeRcProbe; 1]) -> [RuntimeRcProbe; 1] {
  match value {
    VariantArrayEmpty -> fallback
    VariantArrayValue(values) -> values
  }
}

test "variant_array_carrier_balances_managed_storage" {
  let probe = runtime_rc_probe_new(42)
  let mut i = 0
  while i < 128 {
    let values = variant_array_from_probe(probe)
    let carrier = variant_array_wrap(values)
    let extracted = variant_array_extract(carrier, values)
    Test.assert_eq(runtime_rc_probe_load(probe), 42)
    i = i + 1
  }
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "variant_array_nullary_arm_preserves_fallback_owner" {
  let probe = runtime_rc_probe_new(7)
  let values = variant_array_from_probe(probe)
  let extracted = variant_array_extract(VariantArrayEmpty, values)
  Test.assert_eq(runtime_rc_probe_load(probe), 7)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
}
