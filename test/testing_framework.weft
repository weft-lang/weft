use "runtime/alloc.weft"
use "runtime/memory.weft"
use stdlib/string.{*}

-- test/testing_framework.weft -- Test effect assertion helpers.

fn abs_delta(a: i64, b: i64) -> i64 {
  if a >= b { a - b } else { b - a }
}

fn table_value(base: i64, row: i64, col: i64) -> i64 {
  mem_load64(base + row * 24 + col * 8)
}

fn helper_assert_ne(a: i64, b: i64) -[Test]> i64 {
  Test.assert_ne(a, b)
}

fn helper_assert_f64(got: f64, expected: f64, epsilon: f64) -[Test]> i64 {
  Test.assert_eq_f64(got, expected)
  Test.assert_near_f64(got, expected, epsilon)
}

fn helper_snapshot(got: str, expected: str) -[Test]> i64 {
  Test.assert_snapshot(got, expected)
}

fn helper_property(start: i64, end: i64) -[Test]> i64 {
  Test.forall_i64_range(start, end, x => abs_delta(x, x) == 0)
}

fn helper_state_fixture(seed: i64) -[Test]> i64 {
  Test.with_state_i64(seed, () => {
    let first = TestState.get()
    TestState.put(first + 2)
    TestState.get()
  })
}

fn helper_fail_now(error: i64) -[Fail<i64>]> i64 {
  Fail.fail(error)
}

fn helper_fail_fixture(expected: i64) -[Test]> i64 {
  Test.expect_fail_i64(expected, () => helper_fail_now(expected))
}

fn helper_io_fixture() -[Test]> i64 {
  Test.with_io_i64(() => {
    let arena = arena_new(64)
    let buf = arena_alloc(arena, 8, 1)
    let fd = IO.open("path", 2, 0)
    let n = IO.read(fd, buf, 8)
    let first = mem_load8(buf)
    let written = IO.write(fd, buf, 3)
    let closed = IO.close(fd)
    arena_free(arena)
    fd + n + first + written + closed
  })
}

fn helper_diagnose_fixture() -[Test]> i64 {
  Test.with_diagnose_i64(() => {
    Diagnose.error("bad", 0 - 1) + Diagnose.warn("careful", 12) + Diagnose.note("note", 0)
  })
}

type TestingMaskBox {
  value: i64
}

test "test_assertion_helper_detects_record_field_use" {
  let box = TestingMaskBox { value: { Test.assert_eq(1, 1) 42 } }
  box.value
}

test "test_assertion_helpers_happy_paths" {
  Test.assert_eq(42, 42)
  Test.assert_ne(41, 42)
  Test.assert_true(42 == 42)
  Test.assert_false(42 == 41)
  Test.assert_lt(1, 2)
  Test.assert_le(2, 2)
  Test.assert_gt(3, 2)
  Test.assert_ge(3, 3)
  Test.assert_str_eq(str_concat("snap", "shot"), "snapshot")
  Test.assert_str_ne("weft", "rift")
  Test.assert_snapshot("formatter\nok", "formatter\nok")
  Test.assert_eq_f64(42.5, 42.5)
  Test.assert_near_f64(0.1 + 0.2, 0.3, 1e-12)
  Test.forall_i64_range(0, 5, x => x + 1 > x)
}

test "test_assertion_helpers_boundary_matrix" {
  Test.assert_le(0, 0)
  Test.assert_ge(0, 0)
  Test.assert_lt(0 - 10, 0)
  Test.assert_gt(10, 0 - 10)
  Test.assert_ne(0 - 1, 1)
  Test.assert_eq_f64(0.0, 0.0)
  Test.assert_near_f64(1.0, 1.25, 0.25)
  Test.assert_near_f64(1.25, 1.0, 0.25)
  Test.forall_i64_range(0 - 3, 4, x => abs_delta(x, 0) >= 0)
  Test.forall_i64_range(7, 8, x => x == 7)
}

test "test_assertion_helper_detects_indirect_use" {
  helper_assert_ne(10, 11)
  helper_assert_f64(3.5, 3.5, 0.0)
  helper_snapshot("unicode Ω", "unicode Ω")
  helper_property(0, 3)
}

test "test_table_matrix_pattern_with_assert_helpers" {
  let arena = arena_new(128)
  let table = arena_alloc(arena, 96, 8)
  mem_store64(table + 0, 10)
  mem_store64(table + 8, 3)
  mem_store64(table + 16, 7)
  mem_store64(table + 24, 3)
  mem_store64(table + 32, 10)
  mem_store64(table + 40, 7)
  mem_store64(table + 48, 0 - 5)
  mem_store64(table + 56, 5)
  mem_store64(table + 64, 10)
  mem_store64(table + 72, 8)
  mem_store64(table + 80, 8)
  mem_store64(table + 88, 0)

  for row in 0..4 {
    let a = table_value(table, row, 0)
    let b = table_value(table, row, 1)
    let expected = table_value(table, row, 2)
    Test.assert_eq(abs_delta(a, b), expected)
    Test.assert_ge(expected, 0)
  }
  arena_free(arena)
}

test "test_table_matrix_empty_adversarial" {
  let rows = 0
  let mut visited = 0
  for row in 0..rows {
    visited = visited + 1
  }
  Test.assert_eq(visited, 0)
}

test "test_finite_property_matrix_with_assert_helpers" {
  for value in 0..9 {
    let shifted = value - 4
    Test.assert_eq(abs_delta(shifted, shifted), 0)
    Test.assert_ge(abs_delta(shifted, 0), 0)
  }
  Test.forall_i64_range(0, 9, value => {
    let shifted = value - 4
    abs_delta(shifted, shifted) == 0 and abs_delta(shifted, 0) >= 0
  })
}

test "test_effect_fixtures_happy_paths" {
  Test.assert_eq(helper_state_fixture(40), 42)
  Test.assert_eq(helper_fail_fixture(77), 77)
  Test.assert_eq(helper_io_fixture(), 171)
  Test.assert_eq(helper_diagnose_fixture(), 6)
}

test "test_effect_fixtures_are_isolated" {
  let first = Test.with_state_i64(1, () => {
    TestState.put(TestState.get() + 10)
    TestState.get()
  })
  let second = Test.with_state_i64(1, () => TestState.get())
  Test.assert_eq(first, 11)
  Test.assert_eq(second, 1)
}

test "test_effect_fixtures_boundary_cases" {
  Test.assert_eq(Test.with_state_i64(0 - 5, () => TestState.get()), 0 - 5)
  Test.assert_eq(Test.expect_fail_i64(0 - 9, () => helper_fail_now(0 - 9)), 0 - 9)
  Test.assert_eq(Test.with_io_i64(() => {
    let arena = arena_new(64)
    let buf = arena_alloc(arena, 1, 1)
    mem_store8(buf, 90)
    let n = IO.read(0, buf, 0)
    let got = n + mem_load8(buf)
    arena_free(arena)
    got
  }), 90)
  Test.assert_eq(Test.with_diagnose_i64(() => Diagnose.note("unicode Ω", 0 - 99)), 3)
}
