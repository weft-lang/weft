effect Pick { fn get() -> i64 }
effect InnerPick { fn get() -> i64 }

fn branch_resume(value: bool) -> i64 {
  handle Pick.get() {
    Pick.get() -> if value { resume(21) } else { resume(42) }
  }
}

fn matched_resume(value: i64) -> i64 {
  handle Pick.get() {
    Pick.get() -> match value {
      0 -> resume(7)
      1 -> resume(21)
      _ -> resume(42)
    }
  }
}

fn loop_resume() -> i64 {
  handle Pick.get() {
    Pick.get() -> loop { resume(42) }
  }
}

fn while_resume() -> i64 {
  handle Pick.get() {
    Pick.get() -> { while true { resume(42) } 0 }
  }
}

fn nested_resume() -> i64 {
  handle Pick.get() {
    Pick.get() -> {
      let inner = handle InnerPick.get() { InnerPick.get() -> resume(21) }
      resume(inner * 2)
    }
  }
}

fn returning_resume() -> i64 {
  handle Pick.get() {
    Pick.get() -> handle InnerPick.get() {
      InnerPick.get() -> resume(21)
      return value -> resume(value * 2)
    }
  }
}

test "one of two alternative resumes supplies the operation result" {
  Test.assert_eq(branch_resume(true), 21)
  Test.assert_eq(branch_resume(false), 42)
}

test "one of several match arms supplies the operation result" {
  Test.assert_eq(matched_resume(0), 7)
  Test.assert_eq(matched_resume(1), 21)
  Test.assert_eq(matched_resume(99), 42)
}

test "resuming inside loops exits the clause exactly once" {
  Test.assert_eq(loop_resume(), 42)
  Test.assert_eq(while_resume(), 42)
}

test "nested handlers each resume their own operation" {
  Test.assert_eq(nested_resume(), 42)
}

test "a normal-return transform uses the enclosing operation continuation" {
  Test.assert_eq(returning_resume(), 42)
}
