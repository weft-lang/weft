use stdlib/list.{Cons, Nil}

fn immutable_finite() -> usize {
  let value: usize = 18446744073709551615
  return value
}

fn mutable_finite() -> usize {
  let mut value: usize = 0
  value = value + 1
  return value
}

fn loop_finite() -> usize {
  let mut visited: usize = 0
  for _ in Cons<i64>(1, Nil<i64>()) {
    visited = visited + 1
    return visited
  }
  visited
}

fn shadowed_finite() -> usize {
  let value: usize = 9
  let value: usize = { return value }
  value
}

fn small_integer() -> u8 {
  let value: u8 = 255
  return value
}

fn signed_integer() -> isize {
  let value: isize = 0 - 7
  return value
}

fn widened_value(text: bool) -> str | nil {
  let mut value: str | nil = nil
  if text { value = "changed" } else { nil }
  return value
}

fn lambda_finite() -> usize {
  let next: (usize) -> usize = (value: usize) => {
    let result: usize = value + 1
    return result
  }
  return next(4)
}

test "explicit returns preserve finite immutable and mutable annotations" {
  Test.assert_eq_usize(immutable_finite(), 18446744073709551615)
  Test.assert_eq_usize(mutable_finite(), 1)
  Test.assert_true(small_integer() == 255)
  Test.assert_true(signed_integer() == 0 - 7)
}

test "loop exits preserve annotated locals" {
  Test.assert_eq_usize(loop_finite(), 1)
}

test "returns in shadowing initializers see the outer binding" {
  Test.assert_eq_usize(shadowed_finite(), 9)
}

test "explicit returns preserve a mutable union annotation" {
  match widened_value(false) { nil -> Test.assert_true(true) s: str -> Test.assert_true(false) }
  match widened_value(true) { nil -> Test.assert_true(false) s: str -> Test.assert_str_eq(s, "changed") }
}

test "typed lambda returns preserve local annotations" {
  Test.assert_eq_usize(lambda_finite(), 5)
}
