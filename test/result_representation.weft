use stdlib/num as num
use stdlib/num.{*}
use stdlib/test.{Test}

type Reading {
  Missing,
  Measured(f64),
  Estimated(f64)
}

fn reading(flag: i64, value: f64) -> Reading {
  match flag {
    0 -> Missing
    1 -> Measured(value)
    _ -> Estimated(value)
  }
}

fn observed(flag: i64, value: f64) -> f64 {
  match reading(flag, value) {
    Missing -> 17.0
    Measured(result) -> result
    Estimated(result) -> result
  }
}

test "mixed constructor results preserve every floating point bit" {
  let patterns: [u64; 7] = [0, 9223372036854775808, 1, 4607182418800017408, 9218868437227405312, 18442240474082181120, 9221120237041095221]
  for bits in patterns {
    let value = num.f64_from_bits(bits)
    Test.assert_true(observed(1, value).to_bits() == bits)
    Test.assert_true(observed(2, value).to_bits() == bits)
    Test.assert_true(observed(0, value).to_bits() == 17.0.to_bits())
  }
}

type SavedReading { result: Reading }

fn save(flag: i64, value: f64) -> SavedReading {
  SavedReading { result: reading(flag, value) }
}

test "escaping results retain their complete constructor identity" {
  let absent = save(0, 3.5)
  let measured = save(1, 3.5)
  let estimated = save(2, 4.5)
  Test.assert_true(match absent.result { Missing -> true, _ -> false })
  Test.assert_true(match measured.result { Measured(value) -> value == 3.5, _ -> false })
  Test.assert_true(match estimated.result { Estimated(value) -> value == 4.5, _ -> false })
}

fn delayed(flag: i64, value: f64) -> () -> f64 {
  let result = reading(flag, value)
  () => match result {
    Missing -> 17.0
    Measured(value) -> value
    Estimated(value) -> value
  }
}

test "a closure owns an escaping mixed result" {
  let first = delayed(1, 7.25)
  let absent = delayed(0, 0.0)
  Test.assert_true(first() == 7.25)
  Test.assert_true(first() == 7.25)
  Test.assert_true(absent() == 17.0)
}
