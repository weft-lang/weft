-- Compiler-generated ownership changes are explicit typed-IR facts. Runtime
-- helper names are an ABI detail materialised only at the native boundary.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/lib.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/effects.{*}

fn managed_stake_metric_is_runtime_hash(hash: i64) -> i64 {
  if hash == pipeline_rc_default_retain_hash() or hash == pipeline_rc_default_release_hash() { 1 }
  else { if hash == pipeline_closure_default_retain_hash() or hash == pipeline_closure_default_release_hash() { 1 }
  else { if hash == pipeline_rc_default_weak_retain_hash() or hash == pipeline_rc_default_weak_release_hash() { 1 }
  else { 0 } } }
}

-- mode 1 counts semantic stakes; mode 2 counts materialised managed calls.
fn managed_stake_metric_count_insts(insts: IrInstList, mode: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrManagedStakeI64(dst, value, cleanup_kind, delta) -> if mode == 1 { 1 } else { 0 }
        IrCallI64(dst, callee_hash, args) -> if mode == 2 { managed_stake_metric_is_runtime_hash(callee_hash) } else { 0 }
        IrClosureI64(dst, f, captures, evidence) -> managed_stake_metric_count_function(f, mode)
        IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, reserved) -> managed_stake_metric_count_clauses(clauses, mode)
        IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> managed_stake_metric_count_deferred(body, mode) + managed_stake_metric_count_clauses(clauses, mode)
        _ -> 0
      }
      here + managed_stake_metric_count_insts(rest, mode)
    }
  }
}

fn managed_stake_metric_count_blocks(blocks: IrBlockList, mode: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> managed_stake_metric_count_insts(insts, mode) + managed_stake_metric_count_blocks(rest, mode)
    }
  }
}

fn managed_stake_metric_count_function(f: IrFunction, mode: i64) -> i64 {
  match f {
    IrFunction(hash, nparams, blocks, src) -> managed_stake_metric_count_blocks(blocks, mode)
  }
}

fn managed_stake_metric_count_clauses(clauses: IrHandlerClauseBodyList, mode: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> match body {
      IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> managed_stake_metric_count_blocks(blocks, mode) + managed_stake_metric_count_clauses(rest, mode)
      IrHandlerClauseBodyInvalid(reason) -> managed_stake_metric_count_clauses(rest, mode)
    }
  }
}

fn managed_stake_metric_count_deferred(body: IrDeferredHandlerBody, mode: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> managed_stake_metric_count_blocks(blocks, mode)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn managed_stake_metric_count_functions(functions: IrFunctionList, mode: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> managed_stake_metric_count_function(f, mode) + managed_stake_metric_count_functions(rest, mode)
  }
}

fn managed_stake_metric_count_named(functions: IrFunctionList, target: i64, mode: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, nparams, blocks, src) -> if hash == target { managed_stake_metric_count_blocks(blocks, mode) } else { managed_stake_metric_count_named(rest, target, mode) }
    }
  }
}

fn managed_stake_metric_assert_stake(inst: IrInst, dst: i64, value: i64, kind: i64, delta: i64) -> i64 {
  match inst {
    IrManagedStakeI64(actual_dst, actual_value, actual_kind, actual_delta) -> {
      if actual_dst == dst and actual_value == value and actual_kind == kind and actual_delta == delta { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn managed_stake_metric_assert_call(inst: IrInst, dst: i64, value: i64, callee_hash: i64) -> i64 {
  match inst {
    IrCallI64(actual_dst, actual_callee, args) -> {
      if actual_dst == dst and actual_callee == callee_hash and ir_value_list_len(args) == 1 and pipeline_ir_value_list_get_or(args, 0, 0 - 1) == value { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn managed_stake_metric_assert_failure(inst: IrInst, reason: i64) -> i64 {
  match inst {
    IrLoweringFailureI64(actual) -> if actual == reason { 1 } else { 0 }
    _ -> 0
  }
}

fn managed_stake_metric_single_block(inst: IrInst) -> IrBlockList {
  ir_block_list_prepend(ir_block_new_term(0, ir_inst_list_prepend(inst, ir_inst_list_empty()), ir_term_none()), ir_block_list_empty())
}

test "managed_stake_producer_carries_exact_provenance" {
  Test.assert_eq(managed_stake_metric_assert_stake(pipeline_managed_retain_inst(10, 7, continuation_cleanup_kind_rc()), 10, 7, continuation_cleanup_kind_rc(), 1), 1)
  Test.assert_eq(managed_stake_metric_assert_stake(pipeline_managed_release_inst(11, 8, continuation_cleanup_kind_closure()), 11, 8, continuation_cleanup_kind_closure(), 0 - 1), 1)
  Test.assert_eq(managed_stake_metric_assert_stake(pipeline_managed_retain_inst(12, 9, continuation_cleanup_kind_weak()), 12, 9, continuation_cleanup_kind_weak(), 1), 1)
  Test.assert_eq(ir_inst_tag(pipeline_managed_retain_inst(10, 7, continuation_cleanup_kind_rc())), 50)
}

test "managed_stake_producer_rejects_malformed_facts" {
  Test.assert_eq(managed_stake_metric_assert_failure(pipeline_managed_stake_inst(1, 2, continuation_cleanup_kind_none(), 1), 64), 1)
  Test.assert_eq(managed_stake_metric_assert_failure(pipeline_managed_stake_inst(1, 2, continuation_cleanup_kind_rc(), 0), 64), 1)
  Test.assert_eq(managed_stake_metric_assert_failure(pipeline_managed_stake_inst(1, 2, 99, 0 - 1), 64), 1)
}

test "managed_stake_native_boundary_materialises_every_lane" {
  let stake = pipeline_managed_retain_inst(9, 6, continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(stake), 0)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(stake), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_call_def(stake), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_cs_use_safe(stake), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_call_read_safe(stake), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_simple(stake), 0)
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_cs_simple(stake), 1)
  Test.assert_eq(pipeline_ir_native_resident_def_shape(stake, 0), 1)
  Test.assert_eq(if pipeline_ir_intervals_inst_is_call(stake) { 1 } else { 0 }, 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_retain_inst(10, 7, continuation_cleanup_kind_rc())), 10, 7, pipeline_rc_default_retain_hash()), 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_release_inst(11, 8, continuation_cleanup_kind_rc())), 11, 8, pipeline_rc_default_release_hash()), 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_retain_inst(12, 9, continuation_cleanup_kind_closure())), 12, 9, pipeline_closure_default_retain_hash()), 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_release_inst(13, 10, continuation_cleanup_kind_closure())), 13, 10, pipeline_closure_default_release_hash()), 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_retain_inst(14, 11, continuation_cleanup_kind_weak())), 14, 11, pipeline_rc_default_weak_retain_hash()), 1)
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(pipeline_managed_release_inst(15, 12, continuation_cleanup_kind_weak())), 15, 12, pipeline_rc_default_weak_release_hash()), 1)
}

test "managed_stake_native_boundary_does_not_claim_raw_calls" {
  let raw = IrCallI64(20, pipeline_rc_default_retain_hash(), ir_value_list_prepend(7, ir_value_list_empty()))
  Test.assert_eq(managed_stake_metric_assert_call(pipeline_ir_materialise_managed_stake_inst(raw), 20, 7, pipeline_rc_default_retain_hash()), 1)
  Test.assert_eq(managed_stake_metric_count_insts(ir_inst_list_prepend(raw, ir_inst_list_empty()), 1), 0)
}

test "managed_stake_native_boundary_descends_into_carried_programs" {
  let closure_fn = IrFunction(101, 0, managed_stake_metric_single_block(pipeline_managed_retain_inst(10, 7, continuation_cleanup_kind_rc())), 0)
  let closure_facts = ir_lambda_semantic_facts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())
  let closure_inst = IrClosureI64(20, closure_fn, 0, closure_facts)
  let handler_body = IrHandlerClauseBody(201, 0, 0, 0, 0, 0, 0, 0, 1, 0, managed_stake_metric_single_block(pipeline_managed_release_inst(11, 8, continuation_cleanup_kind_closure())))
  let handler_clauses = IrHandlerClauseBodyCons(handler_body, IrHandlerClauseBodyNil)
  let handle_inst = IrHandleI64(21, 0, 200, handler_clauses, 1, 0)
  let deferred_body = IrDeferredHandlerBody(0, 0, 1, 0, managed_stake_metric_single_block(pipeline_managed_retain_inst(12, 9, continuation_cleanup_kind_weak())))
  let deferred_clause = IrHandlerClauseBody(301, 0, 0, 1, 0, 0, 0, 1, 1, 0, managed_stake_metric_single_block(pipeline_managed_release_inst(13, 10, continuation_cleanup_kind_rc())))
  let deferred_inst = IrDeferredHandleI64(22, 0, deferred_body, IrHandlerClauseBodyCons(deferred_clause, IrHandlerClauseBodyNil), 1, 300, 0)
  let insts = ir_inst_list_prepend(closure_inst, ir_inst_list_prepend(handle_inst, ir_inst_list_prepend(deferred_inst, ir_inst_list_empty())))
  let functions = ir_function_list_prepend(IrFunction(1, 0, ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_none()), ir_block_list_empty()), 0), ir_function_list_empty())
  let materialised = pipeline_ir_materialise_managed_stake_functions(functions)
  Test.assert_eq(managed_stake_metric_count_functions(functions, 1), 4)
  Test.assert_eq(managed_stake_metric_count_functions(functions, 2), 0)
  Test.assert_eq(managed_stake_metric_count_functions(materialised, 1), 0)
  Test.assert_eq(managed_stake_metric_count_functions(materialised, 2), 4)
}

test "managed_stake_alias_and_inline_rewrites_preserve_provenance" {
  let stake = pipeline_managed_release_inst(11, 7, continuation_cleanup_kind_closure())
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 70)
  Test.assert_eq(managed_stake_metric_assert_stake(pipeline_ir_rewrite_inst_uses(stake, aliases), 11, 70, continuation_cleanup_kind_closure(), 0 - 1), 1)
  let inline_env = PipelineIrInlineValueEnvCons(7, 70, PipelineIrInlineValueEnvNil)
  let cloned = pipeline_ir_inline_clone_inst(stake, inline_env, 99, 0 - 1, 100)
  Test.assert_eq(pipeline_ir_inline_clone_result_ok(cloned), 1)
  match pipeline_ir_inline_clone_result_insts(cloned) {
    IrInstCons(inst, rest) -> {
      Test.assert_eq(managed_stake_metric_assert_stake(inst, 100, 70, continuation_cleanup_kind_closure(), 0 - 1), 1)
      Test.assert_eq(ir_inst_list_len(rest), 0)
    }
    _ -> Test.assert_eq(0, 1)
  }
  let multi_env = PipelineIrInlineValueEnvCons(11, 110, PipelineIrInlineValueEnvCons(7, 70, PipelineIrInlineValueEnvNil))
  match pipeline_ir_multi_clone_insts(ir_inst_list_prepend(stake, ir_inst_list_empty()), multi_env) {
    IrInstCons(inst, rest) -> Test.assert_eq(managed_stake_metric_assert_stake(inst, 110, 70, continuation_cleanup_kind_closure(), 0 - 1), 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "managed_stake_source_lowering_never_reconstructs_ownership_from_calls" {
  let src = "fn consume(value: (str, i64)) -> i64 { 0 } fn caller(name: str) -> i64 { consume((name, 38)) } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let lowered = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  let caller = str_hash(__str_ptr("caller"), 0, __str_len("caller"))
  Test.assert_eq(managed_stake_metric_count_named(pipeline_ir_functions(lowered), caller, 1), 3)
  Test.assert_eq(managed_stake_metric_count_named(pipeline_ir_functions(lowered), caller, 2), 0)
  Test.assert_eq(managed_stake_metric_count_named(pipeline_ir_functions(optimised), caller, 1), 3)
  Test.assert_eq(managed_stake_metric_count_named(pipeline_ir_functions(optimised), caller, 2), 0)
}
