-- test/liveness_metrics.weft -- per-block liveness fact producer (2l
-- stage 3 substrate): live_in/live_out over hand-built IR shapes pin
-- the backward dataflow before any consumer exists.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/unsafe.weft"

fn lv_diamond() -> i64 {
  -- b0: v1=c1, v2=c5; branch v1 -> b1/b2; b1,b2 jump b3; b3 uses v2.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 1), ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty())), ir_term_branch(1, 1, 2))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_jump(3))
  let b2 = ir_block_new_term(2, ir_inst_list_empty(), ir_term_jump(3))
  let b3 = ir_block_new_term(3, ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 2, 2), ir_inst_list_empty()), ir_term_return(3))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  pipeline_ir_liveness_compute(blocks, 1, 8)
}

test "liveness_diamond_value_live_through_both_arms" {
  let lv = lv_diamond()
  Test.assert_true(pipeline_ir_liveness_live_out_contains(lv, 0, 2))
  Test.assert_true(pipeline_ir_liveness_live_in_contains(lv, 1, 2))
  Test.assert_true(pipeline_ir_liveness_live_in_contains(lv, 2, 2))
  Test.assert_true(pipeline_ir_liveness_live_in_contains(lv, 3, 2))
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 3, 2))
}

test "liveness_diamond_condition_dies_at_branch" {
  let lv = lv_diamond()
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 0, 1))
  Test.assert_false(pipeline_ir_liveness_live_in_contains(lv, 1, 1))
}

test "liveness_loop_value_live_around_backedge" {
  -- b0: v1=c4, v2=c1; jump b1(header); b1 branch v2 -> b2(body)/b3(exit);
  -- b2 uses v1, jumps b1; b3 returns v1. v1 live across the backedge.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 4), ir_inst_list_prepend(ir_inst_const_i64(2, 1), ir_inst_list_empty())), ir_term_jump(1))
  let b1 = ir_block_new_term(1, ir_inst_list_empty(), ir_term_branch(2, 2, 3))
  let b2 = ir_block_new_term(2, ir_inst_list_prepend(ir_inst_binary_i64(3, ir_binary_op_add(), 1, 1), ir_inst_list_empty()), ir_term_jump(1))
  let b3 = ir_block_new_term(3, ir_inst_list_empty(), ir_term_return(1))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_prepend(b2, ir_block_list_prepend(b3, ir_block_list_empty()))))
  let lv = pipeline_ir_liveness_compute(blocks, 1, 8)
  Test.assert_true(pipeline_ir_liveness_live_out_contains(lv, 2, 1))
  Test.assert_true(pipeline_ir_liveness_live_in_contains(lv, 1, 1))
  Test.assert_true(pipeline_ir_liveness_live_out_contains(lv, 1, 1))
  Test.assert_true(pipeline_ir_liveness_live_out_contains(lv, 0, 2))
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 3, 1))
}

test "liveness_dead_def_is_nowhere_live" {
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 9), ir_inst_list_prepend(ir_inst_const_i64(2, 5), ir_inst_list_empty())), ir_term_return(2))
  let blocks = ir_block_list_prepend(b0, ir_block_list_empty())
  let lv = pipeline_ir_liveness_compute(blocks, 1, 4)
  Test.assert_false(pipeline_ir_liveness_live_in_contains(lv, 0, 1))
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 0, 1))
}

test "liveness_jump_arg_use_and_param_def" {
  -- b0 defines v1 and jumps b1(v1); b1's param v2 is used in its return.
  -- v1 is upward-exposed nowhere but live-in of b0? No: defined in b0.
  -- The phi model: v1 used at b0's terminator, v2 defined at b1 entry.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_const_i64(1, 7), ir_inst_list_empty()), ir_term_jump_args(1, ir_value_list_prepend(1, ir_value_list_empty())))
  let b1 = ir_block_new_params(1, ir_value_list_prepend(2, ir_value_list_empty()), ir_inst_list_empty(), ir_term_return(2))
  let blocks = ir_block_list_prepend(b0, ir_block_list_prepend(b1, ir_block_list_empty()))
  let lv = pipeline_ir_liveness_compute(blocks, 1, 4)
  Test.assert_false(pipeline_ir_liveness_live_in_contains(lv, 0, 1))
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 0, 2))
  Test.assert_false(pipeline_ir_liveness_live_out_contains(lv, 1, 2))
  Test.assert_eq(pipeline_ir_liveness_live_in_count(lv, 1), 0)
}

test "liveness_param_live_into_entry" {
  -- Function param v0 used in the entry: upward-exposed there.
  let b0 = ir_block_new_term(0, ir_inst_list_prepend(ir_inst_binary_i64(1, ir_binary_op_add(), 0, 0), ir_inst_list_empty()), ir_term_return(1))
  let blocks = ir_block_list_prepend(b0, ir_block_list_empty())
  let lv = pipeline_ir_liveness_compute(blocks, 1, 4)
  Test.assert_true(pipeline_ir_liveness_live_in_contains(lv, 0, 0))
}
