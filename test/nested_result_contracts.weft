use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/storage.{*}
use compiler/backend/aarch64/codegen.{*}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/test.{Test}

fn contract_fact() -> i64 {
  let fact = cg_semantic_fact_new_raw(0, 1, 0, 1, 1, 0, 1, 0)
  cg_semantic_fact_set_fresh_managed_return(fact, 1)
  fact
}

fn contract_leaf(hash: i64) -> IrFunction {
  IrFunction(hash, 1, IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrVariantInitI64(1, 501, IrValueCons(0, IrValueNil), 0), IrInstNil),
    IrTermReturn(1)), IrBlockListNil), 0)
}

fn contract_wrapper(hash: i64, child: i64, escape: bool) -> IrFunction {
  let tail = IrInstCons(IrManagedStakeI64(3, 1, 1, 0 - 1, 0),
    IrInstCons(IrVariantInitI64(4, 502, IrValueCons(2, IrValueNil), 0), IrInstNil))
  let observed = if escape { IrInstCons(IrCallI64(5, 987654, IrValueCons(1, IrValueNil)), tail) } else { tail }
  IrFunction(hash, 1, IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(1, child, IrValueCons(0, IrValueNil)),
    IrInstCons(IrVariantPayloadI64(2, 1, 0), observed)), IrTermReturn(4)), IrBlockListNil), 0)
}

fn contract_producers(pairs: [(i64, i64)]) -> Map<i64, PipelineIrSmallVariantProducer> {
  let mut result = map.new<i64, PipelineIrSmallVariantProducer>()
  for (base, clone) in pairs { result = result.insert(base, PipelineIrSmallVariantPair(clone)) }
  result
}

fn contract_observer(hash: i64, child: i64) -> IrFunction {
  IrFunction(hash, 1, IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(1, child, IrValueCons(0, IrValueNil)),
    IrInstCons(IrVariantPayloadI64(2, 1, 0),
    IrInstCons(IrManagedStakeI64(3, 1, 1, 0 - 1, 0), IrInstNil))),
    IrTermReturn(2)), IrBlockListNil), 0)
}

fn contract_calls_insts(insts: IrInstList, callee: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) ->
      (if pipeline_ir_small_variant_call_base_hash(inst) == callee { 1 } else { 0 }) + contract_calls_insts(rest, callee)
  }
}

fn contract_calls_blocks(blocks: IrBlockList, callee: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> contract_calls_insts(insts, callee) + contract_calls_blocks(rest, callee)
  }
}

fn contract_calls(functions: IrFunctionList, caller: i64, callee: i64) -> i64 {
  match pipeline_ir_function_list_find_hash(functions, caller) {
    IrFunctionCons(IrFunction(_, _, blocks, _), _) -> contract_calls_blocks(blocks, callee)
    _ -> 0 - 1
  }
}

fn contract_allocations_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> (match inst {
      IrVariantInitI64(_, _, payloads, _) if ir_variant_allocates(payloads) -> 1
      _ -> 0
    }) + contract_allocations_insts(rest)
  }
}

fn contract_allocations_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> contract_allocations_insts(insts) + contract_allocations_blocks(rest)
  }
}

fn contract_allocations(functions: IrFunctionList, hash: i64) -> i64 {
  match pipeline_ir_function_list_find_hash(functions, hash) {
    IrFunctionCons(IrFunction(_, _, blocks, _), _) -> contract_allocations_blocks(blocks)
    _ -> 0 - 1
  }
}

fn contract_chain() -> IrFunctionList {
  IrFunctionCons(contract_observer(100, 200), IrFunctionCons(contract_wrapper(200, 300, false),
    IrFunctionCons(contract_wrapper(300, 400, false), IrFunctionCons(contract_leaf(400), IrFunctionNil))))
}

fn contract_chain_facts() -> PipelineIrSemanticFactList {
  pipeline_ir_semantic_facts_prepend(200, contract_fact(),
    pipeline_ir_semantic_facts_prepend(300, contract_fact(),
    pipeline_ir_semantic_facts_prepend(400, contract_fact(), PipelineIrSemanticFactNil)))
}

test "nested producer clones retain the known contracts of their callees" {
  let input = contract_chain()
  let facts = contract_chain_facts()
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(input)), 0)
  let result = pipeline_ir_small_variant_specialise(input, facts)
  let functions = pipeline_ir_small_variant_specialisations_functions(result)
  let outer = pipeline_ir_small_variant_producer_hash(200)
  let middle = pipeline_ir_small_variant_producer_hash(300)
  let leaf = pipeline_ir_small_variant_producer_hash(400)
  Test.assert_eq(pipeline_ir_small_variant_specialisations_count(result), 3)
  Test.assert_eq(contract_calls(functions, 100, outer), 1)
  Test.assert_eq(contract_calls(functions, outer, middle), 1)
  Test.assert_eq(contract_calls(functions, middle, leaf), 1)
  Test.assert_eq(contract_calls(functions, outer, 300), 0)
  Test.assert_eq(contract_calls(functions, middle, 400), 0)
  for hash in [outer, middle, leaf] { Test.assert_eq(contract_allocations(functions, hash), 0) }
  for hash in [200, 300, 400] { Test.assert_eq(contract_allocations(functions, hash), 1) }
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}

test "the clone queue closes over newly needed dependencies without cloning unrelated producers" {
  let input = contract_chain()
  let pairs = [(200, 1200), (300, 1300), (400, 1400), (900, 1900)]
  let producers = contract_producers(pairs[..])
  let index = pipeline_ir_function_index(IrFunctionCons(contract_leaf(900), input))
  let used = nlist_new()
  pipeline_ir_small_variant_used_add(used, 1200)
  let clones = pipeline_ir_small_variant_clone_functions(producers, used, index, contract_chain_facts())
  Test.assert_eq(nlist_len(used), 3)
  Test.assert_eq(ir_function_list_len(clones), 3)
  Test.assert_eq(contract_calls(clones, 1200, 1300), 1)
  Test.assert_eq(contract_calls(clones, 1300, 1400), 1)
  Test.assert_eq(pipeline_hash_nlist_contains(used, 1900), 0)
  let facts = pipeline_ir_small_variant_clone_facts_extend(producers, used, contract_chain_facts())
  for hash in [1200, 1300, 1400] {
    let fact = pipeline_ir_semantic_fact_find(facts, hash)
    Test.assert_true(fact != 0)
    Test.assert_eq(cg_semantic_fact_managed_return(fact), 0)
    Test.assert_eq(ir_value_shape_lane_count(cg_semantic_fact_return_shape(fact)), 2)
  }
  Test.assert_eq(pipeline_ir_semantic_fact_find(facts, 1900), 0)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(clones)), 0)
}

test "recursive specialization dependencies are materialized once" {
  let input = IrFunctionCons(contract_wrapper(200, 300, false),
    IrFunctionCons(contract_wrapper(300, 200, false), IrFunctionNil))
  let pairs = [(200, 1200), (300, 1300)]
  let producers = contract_producers(pairs[..])
  let facts = pipeline_ir_semantic_facts_prepend(200, contract_fact(),
    pipeline_ir_semantic_facts_prepend(300, contract_fact(), PipelineIrSemanticFactNil))
  let used = nlist_new()
  pipeline_ir_small_variant_used_add(used, 1200)
  let clones = pipeline_ir_small_variant_clone_functions(producers, used, pipeline_ir_function_index(input), facts)
  Test.assert_eq(nlist_len(used), 2)
  Test.assert_eq(ir_function_list_len(clones), 2)
  Test.assert_eq(contract_calls(clones, 1200, 1300), 1)
  Test.assert_eq(contract_calls(clones, 1300, 1200), 1)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(clones)), 0)
}

test "an escaping child result keeps its boxed call inside a specialized parent" {
  let input = IrFunctionCons(contract_wrapper(200, 300, true), IrFunctionCons(contract_leaf(300), IrFunctionNil))
  let pairs = [(200, 1200), (300, 1300)]
  let producers = contract_producers(pairs[..])
  let facts = pipeline_ir_semantic_facts_prepend(200, contract_fact(),
    pipeline_ir_semantic_facts_prepend(300, contract_fact(), PipelineIrSemanticFactNil))
  let used = nlist_new()
  pipeline_ir_small_variant_used_add(used, 1200)
  let clones = pipeline_ir_small_variant_clone_functions(producers, used, pipeline_ir_function_index(input), facts)
  Test.assert_eq(nlist_len(used), 1)
  Test.assert_eq(ir_function_list_len(clones), 1)
  Test.assert_eq(contract_calls(clones, 1200, 300), 1)
  Test.assert_eq(contract_calls(clones, 1200, 987654), 1)
  Test.assert_eq(contract_calls(clones, 1200, 1300), 0)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(clones)), 0)
}

test "nested clones use reserved identities when a function already occupies the preferred hash" {
  let occupied = pipeline_ir_small_variant_producer_hash(200)
  let input = IrFunctionCons(contract_leaf(occupied), contract_chain())
  let result = pipeline_ir_small_variant_specialise(input, contract_chain_facts())
  let functions = pipeline_ir_small_variant_specialisations_functions(result)
  Test.assert_eq(pipeline_ir_small_variant_specialisations_count(result), 3)
  Test.assert_eq(contract_calls(functions, 100, occupied + 104729), 1)
  Test.assert_eq(contract_calls(functions, occupied + 104729, pipeline_ir_small_variant_producer_hash(300)), 1)
  Test.assert_eq(contract_allocations(functions, occupied), 1)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}
