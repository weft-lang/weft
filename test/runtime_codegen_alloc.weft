use "compiler/codegen.weft"

test "runtime_codegen_alloc_scope_lookup_shadowing" {
  let src = __str_ptr("alpha beta")
  let s1 = scope_push(scope_new(), 0, 5, 19)
  let s2 = scope_push(s1, 6, 4, 20)
  let s3 = scope_push(s2, 0, 5, 21)
  Test.assert_eq(scope_lookup(s2, src, 0, 5), 19)
  Test.assert_eq(scope_lookup(s2, src, 6, 4), 20)
  Test.assert_eq(scope_lookup(s3, src, 0, 5), 21)
  Test.assert_eq(scope_lookup(s3, src, 0, 4), 0 - 999)
}

test "runtime_codegen_alloc_ttable_lookup_and_growth" {
  let src = __str_ptr("Alpha")
  let tt = ttable_new()
  ttable_add(tt, src, 0, 5, 0, 2, 1234, 0)
  let entry = ttable_lookup(tt, src, 0, 5)
  Test.assert_eq(__mem_load64(entry + 16), 0)
  Test.assert_eq(__mem_load64(entry + 24), 2)
  Test.assert_eq(__mem_load64(entry + 32), 1234)
  let mut i = 0
  while i < 101 {
    ttable_add(tt, src, 0, 5, 1, i, 0, 0)
    i = i + 1
  }
  Test.assert_eq(__mem_load64(tt + 8), 102)
  Test.assert_eq(if __mem_load64(tt + 16) > 100 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_lookup(tt, src, 1, 4), 0)
}

fn runtime_codegen_layout_store_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  __mem_store64(fields + index * 24, ns)
  __mem_store64(fields + index * 24 + 8, nl)
  __mem_store64(fields + index * 24 + 16, ty)
  0
}

fn runtime_codegen_layout_store_variant(src: i64, variants: i64, index: i64, ns: i64, nl: i64, payloads: i64) -> i64 {
  __mem_store64(variants + index * 40, ns)
  __mem_store64(variants + index * 40 + 8, nl)
  __mem_store64(variants + index * 40 + 16, str_hash(src, ns, nl))
  __mem_store64(variants + index * 40 + 24, if payloads == 0 { 0 } else { nlist_len(payloads) })
  __mem_store64(variants + index * 40 + 32, payloads)
  0
}

test "runtime_codegen_layout_primitive_pointer_and_handle_facts" {
  let tt = ttable_new()
  Test.assert_eq(cg_layout_storage_size(tt, ty_i8()), 1)
  Test.assert_eq(cg_layout_storage_align(tt, ty_i8()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i16()), 2)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i32()), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_f32()), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i64()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_f64()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_bool()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_nil()), 0)
  Test.assert_eq(cg_layout_storage_align(tt, ty_nil()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_mut_ptr(ty_i32())), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_mut_ptr(ty_i32())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_str()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_fn(nlist_new(), ty_i64(), ty_effect_pure())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_continuation(ty_i64(), ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_weak(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_weak(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_nullable(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_nullable(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_nullable(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))), 8)
  Test.assert_eq(cg_layout_inline_align(tt, ty_nullable(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_arc(ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_arc(ty_i64())), 8)
}

test "runtime_codegen_layout_rc_payload_and_block_facts" {
  let tt = ttable_new()
  let rc_i32 = ty_rc(ty_i32())
  let rc_i64 = ty_rc(ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, rc_i32), 8)
  Test.assert_eq(cg_layout_inline_size(tt, rc_i32), 8)
  Test.assert_eq(cg_layout_rc_header_size(), 40)
  Test.assert_eq(cg_layout_rc_payload_size(tt, rc_i32), 4)
  Test.assert_eq(cg_layout_rc_block_size(tt, rc_i32), 44)
  Test.assert_eq(cg_layout_rc_payload_size(tt, rc_i64), 8)
  Test.assert_eq(cg_layout_rc_block_size(tt, rc_i64), 48)
  Test.assert_eq(cg_layout_rc_payload_size(tt, ty_i64()), 0 - 1)
}

test "runtime_codegen_layout_record_inline_offsets" {
  let src = __str_ptr("Mixedabc")
  let tt = ttable_new()
  let fields = alloc_bump(72)
  runtime_codegen_layout_store_field(fields, 0, 5, 1, ty_i8())
  runtime_codegen_layout_store_field(fields, 1, 6, 1, ty_i64())
  runtime_codegen_layout_store_field(fields, 2, 7, 1, ty_i32())
  ttable_add(tt, src, 0, 5, 0, 3, fields, 0)
  let ty = ty_named(type_name_hash(src, 0, 5), ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, ty), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 24)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 0), 0)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 2), 16)
  Test.assert_eq(cg_layout_field_size(tt, ty, 0), 1)
  Test.assert_eq(cg_layout_field_size(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_size(tt, ty, 2), 4)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 3), 0 - 1)
}

test "runtime_codegen_layout_vector_record_payload_eligibility" {
  let src = __str_ptr("PlainabManagedrcNestedchild")
  let tt = ttable_new()
  let plain_fields = alloc_bump(48)
  runtime_codegen_layout_store_field(plain_fields, 0, 5, 1, ty_i8())
  runtime_codegen_layout_store_field(plain_fields, 1, 6, 1, ty_i64())
  ttable_add(tt, src, 0, 5, 0, 2, plain_fields, 0)
  let managed_fields = alloc_bump(24)
  runtime_codegen_layout_store_field(managed_fields, 0, 14, 2, ty_rc(ty_i64()))
  ttable_add(tt, src, 7, 7, 0, 1, managed_fields, 0)
  let nested_fields = alloc_bump(24)
  runtime_codegen_layout_store_field(nested_fields, 0, 22, 5, ty_named(type_name_hash(src, 0, 5), ty_i64()))
  ttable_add(tt, src, 16, 6, 0, 1, nested_fields, 0)
  let plain = ty_named(type_name_hash(src, 0, 5), ty_i64())
  let managed = ty_named(type_name_hash(src, 7, 7), ty_i64())
  let nested = ty_named(type_name_hash(src, 16, 6), ty_i64())
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, plain), 1)
  Test.assert_eq(cg_layout_vector_element_size(tt, plain), 16)
  Test.assert_eq(cg_layout_vector_element_mode(tt, plain), cg_layout_vector_record_mode())
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, managed), 0)
  Test.assert_eq(cg_layout_vector_element_size(tt, managed), 8)
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, nested), 0)
  Test.assert_eq(cg_layout_vector_element_size(tt, nested), 8)
}

test "runtime_codegen_layout_generic_record_substitutes_type_args" {
  let src = __str_ptr("BoxTvalueptr")
  let tt = ttable_new()
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 3, 1, 0, 0))
  let fields = alloc_bump(48)
  runtime_codegen_layout_store_field(fields, 0, 4, 5, ty_var(0))
  runtime_codegen_layout_store_field(fields, 1, 9, 3, ty_mut_ptr(ty_var(0)))
  ttable_add(tt, src, 0, 3, 0, 2, fields, tparams)
  let args = nlist_new()
  nlist_add(args, ty_i32())
  let ty = ty_named_app(type_name_hash(src, 0, 3), ty_i64(), args)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 16)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 0), 0)
  Test.assert_eq(cg_layout_field_size(tt, ty, 0), 4)
  Test.assert_eq(cg_layout_field_align(tt, ty, 0), 4)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_size(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_align(tt, ty, 1), 8)
}

test "runtime_codegen_layout_variant_inline_size_uses_largest_payload" {
  let src = __str_ptr("ChoiceSmallWide")
  let tt = ttable_new()
  let variants = alloc_bump(80)
  let small_payloads = nlist_new()
  nlist_add(small_payloads, ty_i8())
  let wide_payloads = nlist_new()
  nlist_add(wide_payloads, ty_i64())
  nlist_add(wide_payloads, ty_i32())
  runtime_codegen_layout_store_variant(src, variants, 0, 6, 5, small_payloads)
  runtime_codegen_layout_store_variant(src, variants, 1, 11, 4, wide_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, 0)
  let ty = ty_named(type_name_hash(src, 0, 6), ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 24)
}

test "runtime_codegen_layout_unknown_sad_paths" {
  let tt = ttable_new()
  let missing_src = __str_ptr("Missing")
  let missing = ty_named(type_name_hash(missing_src, 0, 7), ty_i64())
  Test.assert_eq(cg_layout_inline_size(tt, ty_union(ty_i64(), ty_bool())), 0 - 1)
  Test.assert_eq(cg_layout_record_inline_size(tt, missing), 0 - 1)
  Test.assert_eq(cg_layout_field_offset(tt, ty_i64(), 0), 0 - 1)
  Test.assert_eq(cg_layout_field_size(tt, missing, 0), 0 - 1)
  Test.assert_eq(cg_layout_rc_block_size(tt, ty_i64()), 0 - 1)
}

test "runtime_codegen_alloc_fmap_lookup_update_and_got_growth" {
  let src = __str_ptr("alpha beta")
  let fm = fmap_new()
  fmap_add(fm, src, 0, 5, 40)
  Test.assert_eq(fmap_contains(fm, src, 0, 5), 1)
  Test.assert_eq(fmap_lookup(fm, src, 0, 5), 40)
  fmap_update_offset(fm, src, 0, 5, 88)
  Test.assert_eq(fmap_lookup(fm, src, 0, 5), 88)
  Test.assert_eq(fmap_contains(fm, src, 6, 4), 0)
  let mut i = 0
  while i < 70 {
    fmap_add_got_patch(fm, i, i + 10)
    i = i + 1
  }
  let gp = __mem_load64(fm + 120)
  Test.assert_eq(__mem_load64(fm + 128), 70)
  Test.assert_eq(if __mem_load64(fm + 136) > 64 { 1 } else { 0 }, 1)
  Test.assert_eq(__mem_load64(gp), 0)
  Test.assert_eq(__mem_load64(gp + 69 * 16), 69)
  Test.assert_eq(__mem_load64(gp + 69 * 16 + 8), 79)
}

test "runtime_codegen_alloc_method_map" {
  let mm = mmap_new()
  mmap_add(mm, 10, 20, 30, 0)
  Test.assert_eq(mmap_lookup(mm, 10, 20), 30)
  Test.assert_eq(mmap_lookup_by_method(mm, 20), 30)
  Test.assert_eq(mmap_lookup(mm, 10, 21), 0)
  mmap_update(mm, 10, 20, 44)
  Test.assert_eq(mmap_lookup(mm, 10, 20), 44)
}

test "runtime_codegen_alloc_template_and_cache_maps" {
  let src = __str_ptr("template")
  let tm = mono_tmap_new()
  mono_tmap_add(tm, 101, 202, src)
  let entry = mono_tmap_lookup(tm, 101)
  Test.assert_eq(__mem_load64(entry), 101)
  Test.assert_eq(__mem_load64(entry + 8), 202)
  Test.assert_eq(__mem_load64(entry + 16), src)
  Test.assert_eq(mono_tmap_lookup(tm, 102), 0)
  let cache = mono_cache_new()
  mono_cache_add(cache, 33, 400)
  mono_cache_add(cache, 34, 500)
  Test.assert_eq(mono_cache_lookup(cache, 33), 400)
  Test.assert_eq(mono_cache_lookup(cache, 34), 500)
  Test.assert_eq(mono_cache_lookup(cache, 35), 0)
}
