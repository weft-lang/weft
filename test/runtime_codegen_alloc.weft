use runtime/alloc.{*}
use "runtime/memory.weft"
use "compiler/codegen.weft"

test "runtime_codegen_bump_scratch_preserves_inter_allocation_values" {
  -- Deferred cleanup emission keeps its first descriptor in x10 while a
  -- second bump reservation targets x12. The atomic allocator must retain the
  -- narrow x9/x11 fast-path scratch contract; selecting scratch registers by
  -- ascending number silently replaced that live descriptor with bump_end.
  let first = cg_bump_scratch_primary(12, 0 - 1)
  let second = cg_bump_scratch_secondary(12, 0 - 1, first)
  Test.assert_eq(first, 9)
  Test.assert_eq(second, 11)
  Test.assert_eq(if first == 10 or second == 10 { 0 } else { 1 }, 1)
  Test.assert_eq(cg_bump_large_imm_tmp(12, first, second), 13)

  -- Operand conflicts still produce two distinct scratch registers.
  let conflict_first = cg_bump_scratch_primary(9, 11)
  let conflict_second = cg_bump_scratch_secondary(9, 11, conflict_first)
  Test.assert_eq(conflict_first, 10)
  Test.assert_eq(conflict_second, 12)
}

test "runtime_codegen_alloc_scope_lookup_shadowing" {
  let src = __str_ptr("alpha beta")
  let s1 = scope_push(scope_new(), 0, 5, 19)
  let s2 = scope_push(s1, 6, 4, 20)
  let s3 = scope_push(s2, 0, 5, 21)
  Test.assert_eq(scope_lookup(s2, src, 0, 5), 19)
  Test.assert_eq(scope_lookup(s2, src, 6, 4), 20)
  Test.assert_eq(scope_lookup(s3, src, 0, 5), 21)
  Test.assert_eq(scope_lookup(s3, src, 0, 4), 0 - 999)
}

test "runtime_codegen_alloc_ttable_lookup_and_growth" {
  let src = __str_ptr("Alpha")
  let tt = ttable_new()
  ttable_add(tt, src, 0, 5, 0, 2, 1234, 0)
  let entry = ttable_lookup(tt, src, 0, 5)
  Test.assert_eq(mem_load64(entry + 16), 0)
  Test.assert_eq(mem_load64(entry + 24), 2)
  Test.assert_eq(mem_load64(entry + 32), 1234)
  let mut i = 0
  while i < 101 {
    ttable_add(tt, src, 0, 5, 1, i, 0, 0)
    i = i + 1
  }
  Test.assert_eq(mem_load64(tt + 8), 102)
  Test.assert_eq(if mem_load64(tt + 16) > 100 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_lookup(tt, src, 1, 4), 0)
}

fn runtime_codegen_layout_store_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  mem_store64(fields + index * 24, ns)
  mem_store64(fields + index * 24 + 8, nl)
  mem_store64(fields + index * 24 + 16, ty)
  0
}

fn runtime_codegen_layout_store_variant(src: i64, variants: i64, index: i64, ns: i64, nl: i64, payloads: i64) -> i64 {
  mem_store64(variants + index * 40, ns)
  mem_store64(variants + index * 40 + 8, nl)
  mem_store64(variants + index * 40 + 16, str_hash(src, ns, nl))
  mem_store64(variants + index * 40 + 24, if payloads == 0 { 0 } else { nlist_len(payloads) })
  mem_store64(variants + index * 40 + 32, payloads)
  0
}

fn runtime_codegen_structural_field(name_hash: i64, ty: i64) -> i64 {
  ty_record_field(name_hash, ty, 0, 0)
}

fn runtime_codegen_structural3(h0: i64, t0: i64, h1: i64, t1: i64, h2: i64, t2: i64) -> i64 {
  let fields = nlist_new()
  nlist_add(fields, runtime_codegen_structural_field(h0, t0))
  nlist_add(fields, runtime_codegen_structural_field(h1, t1))
  nlist_add(fields, runtime_codegen_structural_field(h2, t2))
  ty_record(fields, 0)
}

test "runtime_codegen_layout_primitive_pointer_and_handle_facts" {
  let tt = ttable_new()
  Test.assert_eq(cg_layout_storage_size(tt, ty_i8()), 1)
  Test.assert_eq(cg_layout_storage_align(tt, ty_i8()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i16()), 2)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i32()), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_f32()), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_i64()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_f64()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_bool()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_nil()), 0)
  Test.assert_eq(cg_layout_storage_align(tt, ty_nil()), 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_mut_ptr(ty_i32())), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_mut_ptr(ty_i32())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_str()), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_fn(nlist_new(), ty_i64(), ty_effect_pure())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_continuation(ty_i64(), ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_weak(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_weak(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_nullable(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_nullable(ty_rc(ty_i64()))), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_nullable(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))), 8)
  Test.assert_eq(cg_layout_inline_align(tt, ty_nullable(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_arc(ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_arc(ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_unique(ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_unique(ty_i64())), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_unique(ty_i32())), 4)
  Test.assert_eq(cg_layout_inline_align(tt, ty_unique(ty_i32())), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_owned(ty_i64())), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty_owned(ty_i64())), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_owned(ty_i32())), 4)
  Test.assert_eq(cg_layout_inline_align(tt, ty_owned(ty_i32())), 4)
  Test.assert_eq(cg_layout_storage_size(tt, ty_slice(ty_i64())), 16)
  Test.assert_eq(cg_layout_storage_align(tt, ty_slice(ty_i64())), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty_mut_slice(ty_str())), 16)
  Test.assert_eq(cg_layout_inline_align(tt, ty_mut_slice(ty_str())), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_array(ty_i64(), 2)), 16)
  Test.assert_eq(cg_layout_storage_align(tt, ty_array(ty_i64(), 2)), 8)
}

test "runtime_codegen_layout_array_fact_matrix" {
  let tt = ttable_new()
  let bytes = ty_array(ty_u8(), 3)
  let halfs = ty_array(ty_i16(), 3)
  let views = ty_array(ty_slice(ty_i64()), 3)
  let nested = ty_array(halfs, 4)
  let empty = ty_array(ty_i64(), 0)
  let empty_unknown = ty_array(ty_var(0), 0)
  Test.assert_eq(cg_layout_array_element_size(tt, bytes), 1)
  Test.assert_eq(cg_layout_array_element_align(tt, bytes), 1)
  Test.assert_eq(cg_layout_array_element_mode(tt, bytes), 1)
  Test.assert_eq(cg_layout_array_stride(tt, bytes), 1)
  Test.assert_eq(cg_layout_array_size(tt, bytes), 3)
  Test.assert_eq(cg_layout_array_stride(tt, halfs), 2)
  Test.assert_eq(cg_layout_array_size(tt, halfs), 6)
  Test.assert_eq(cg_layout_storage_size(tt, views), 48)
  Test.assert_eq(cg_layout_storage_align(tt, views), 8)
  Test.assert_eq(cg_layout_array_stride(tt, nested), 6)
  Test.assert_eq(cg_layout_storage_size(tt, nested), 24)
  Test.assert_eq(cg_layout_inline_size(tt, nested), 24)
  Test.assert_eq(cg_layout_inline_align(tt, nested), 2)
  Test.assert_eq(cg_layout_array_size(tt, empty), 0)
  Test.assert_eq(cg_layout_array_align(tt, empty), 1)
  Test.assert_eq(cg_layout_array_size(tt, empty_unknown), 0)
  Test.assert_eq(cg_layout_array_align(tt, empty_unknown), 1)
  Test.assert_eq(cg_layout_storage_mode(tt, ty_i16()), 4)
  Test.assert_eq(cg_layout_array_element_mode(tt, ty_array(ty_i16(), 2)), 4)
  Test.assert_eq(cg_layout_array_element_mode(tt, ty_i16()), 0)
}

test "runtime_codegen_layout_array_union_storage_matrix" {
  let tt = ttable_new()
  let scalar_union = ty_union(ty_i64(), ty_bool())
  let managed_union = ty_union(ty_str(), ty_rc(ty_i64()))
  Test.assert_eq(ty_union_storage_class(scalar_union), 1)
  Test.assert_eq(ty_union_storage_class(managed_union), 2)
  Test.assert_eq(ty_union_storage_class(ty_union(ty_i64(), ty_str())), 0 - 1)
  Test.assert_eq(ty_union_storage_class(ty_union(ty_f32(), ty_i64())), 0 - 1)
  Test.assert_eq(ty_union_storage_class(ty_union(ty_var(91), ty_i64())), 0)
  Test.assert_eq(cg_layout_storage_size(tt, scalar_union), 8)
  Test.assert_eq(cg_layout_storage_align(tt, scalar_union), 8)
  Test.assert_eq(cg_layout_array_stride(tt, ty_array(scalar_union, 2)), 8)
  Test.assert_eq(cg_layout_array_size(tt, ty_array(scalar_union, 2)), 16)
  Test.assert_eq(cg_layout_storage_size(tt, managed_union), 8)
  Test.assert_eq(cg_layout_storage_align(tt, managed_union), 8)
  Test.assert_eq(cg_layout_storage_size(tt, ty_union(ty_i64(), ty_str())), 0 - 1)
  Test.assert_eq(cg_layout_storage_size(tt, ty_union(ty_f32(), ty_i64())), 0 - 1)
}

test "runtime_codegen_layout_arrays_embed_in_records" {
  let src = __str_ptr("ArrayBoxheaditemsfoot")
  let tt = ttable_new()
  let arena = arena_new(128)
  let fields = arena_alloc(arena, 72, 8)
  runtime_codegen_layout_store_field(fields, 0, 8, 4, ty_i8())
  runtime_codegen_layout_store_field(fields, 1, 12, 5, ty_array(ty_i16(), 3))
  runtime_codegen_layout_store_field(fields, 2, 17, 4, ty_i64())
  ttable_add(tt, src, 0, 8, 0, 3, fields, 0)
  let ty = ty_named(type_name_hash(src, 0, 8), ty_i64())
  Test.assert_eq(cg_layout_inline_size(tt, ty), 16)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 0), 0)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 1), 2)
  Test.assert_eq(cg_layout_field_size(tt, ty, 1), 6)
  Test.assert_eq(cg_layout_field_align(tt, ty, 1), 2)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 2), 8)
  arena_free(arena)
}

test "runtime_codegen_layout_array_overflow_and_unknown_paths" {
  let tt = ttable_new()
  Test.assert_eq(cg_layout_array_size(tt, ty_array(ty_i64(), 9223372036854775807)), 0 - 1)
  Test.assert_eq(cg_layout_array_size(tt, ty_array(ty_i64(), 0 - 1)), 0 - 1)
  Test.assert_eq(cg_layout_array_size(tt, ty_array(ty_var(0), 1)), 0 - 1)
  Test.assert_eq(cg_layout_array_size(tt, ty_i64()), 0 - 1)
  Test.assert_eq(cg_layout_array_stride(tt, ty_i64()), 0 - 1)
  Test.assert_eq(cg_layout_checked_mul_nonnegative(9223372036854775807, 2), 0 - 1)
  Test.assert_eq(cg_layout_checked_mul_nonnegative(0 - 1, 8), 0 - 1)
  Test.assert_eq(cg_layout_align_up(9223372036854775807, 8), 0 - 1)
  Test.assert_eq(cg_layout_align_up(8, 0), 0 - 1)
  Test.assert_eq(cg_layout_array_size(tt, ty_array(ty_nil(), 9223372036854775807)), 0)
}

test "runtime_codegen_layout_array_drop_plan_facts" {
  let tt = ttable_new()
  let strings = ty_array(ty_str(), 4)
  let nested_strings = ty_array(ty_array(ty_str(), 3), 4)
  let closures = ty_array(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()), 2)
  let weak_values = ty_array(ty_weak(ty_rc(ty_i64())), 3)
  let views = ty_array(ty_slice(ty_i64()), 5)
  Test.assert_eq(ty_eq(cg_layout_array_leaf_type(nested_strings), ty_str()), 1)
  Test.assert_eq(cg_layout_array_leaf_count(strings), 4)
  Test.assert_eq(cg_layout_array_leaf_count(nested_strings), 12)
  Test.assert_eq(cg_layout_array_leaf_stride(tt, nested_strings), 8)
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, nested_strings), continuation_cleanup_kind_rc())
  Test.assert_eq(cg_layout_array_needs_drop_glue(tt, nested_strings), 1)
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, closures), continuation_cleanup_kind_closure())
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, weak_values), continuation_cleanup_kind_weak())
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, views), continuation_cleanup_kind_none())
  Test.assert_eq(cg_layout_array_needs_drop_glue(tt, views), 0)
}

test "runtime_codegen_layout_array_drop_plan_boundaries" {
  let tt = ttable_new()
  let empty_unknown = ty_array(ty_var(0), 0)
  let nested_empty = ty_array(ty_array(ty_str(), 0), 9223372036854775807)
  let overflowing = ty_array(ty_array(ty_str(), 2), 9223372036854775807)
  Test.assert_eq(cg_layout_array_leaf_count(empty_unknown), 0)
  Test.assert_eq(cg_layout_array_needs_drop_glue(tt, empty_unknown), 0)
  Test.assert_eq(cg_layout_array_leaf_count(nested_empty), 0)
  Test.assert_eq(cg_layout_array_needs_drop_glue(tt, nested_empty), 0)
  Test.assert_eq(cg_layout_array_leaf_count(overflowing), 0 - 1)
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, ty_array(ty_var(0), 1)), 0 - 1)
  Test.assert_eq(cg_layout_array_leaf_drop_kind(tt, ty_array(ty_owned(ty_i64()), 1)), 0 - 1)
  Test.assert_eq(cg_layout_array_needs_drop_glue(tt, ty_array(ty_owned(ty_i64()), 1)), 0 - 1)
  Test.assert_eq(cg_layout_array_leaf_count(ty_i64()), 0 - 1)
}

test "runtime_codegen_value_shape_lane_matrix" {
  let scalar = ir_value_shape_for_type(ty_i64())
  let fp32 = ir_value_shape_for_type(ty_f32())
  let fp64 = ir_value_shape_for_type(ty_f64())
  let view = ir_value_shape_for_type(ty_slice(ty_i64()))
  let mutable_view = ir_value_shape_for_type(ty_mut_slice(ty_str()))
  Test.assert_eq(ir_value_shape_lane_count(scalar), 1)
  Test.assert_eq(ir_value_shape_lane_at_or(scalar, 0, 0), ir_value_lane_gpr())
  Test.assert_eq(ir_value_shape_lane_at_or(fp32, 0, 0), ir_value_lane_f32())
  Test.assert_eq(ir_value_shape_lane_at_or(fp64, 0, 0), ir_value_lane_f64())
  Test.assert_eq(ir_value_shape_lane_count(view), 2)
  Test.assert_eq(ir_value_shape_lane_at_or(view, 0, 0), ir_value_lane_gpr())
  Test.assert_eq(ir_value_shape_lane_at_or(view, 1, 0), ir_value_lane_gpr())
  Test.assert_eq(ir_value_shape_lane_count(mutable_view), 2)
  let fixed_array = ir_value_shape_for_type(ty_array(ty_i64(), 2))
  Test.assert_eq(ir_value_shape_lane_count(fixed_array), 1)
  Test.assert_eq(ir_value_shape_lane_at_or(fixed_array, 0, 0), ir_value_lane_gpr())
  Test.assert_eq(ir_value_shape_for_type(ty_var(0)), ir_value_shape_unknown())
}

test "runtime_codegen_structural_layout_is_canonical_and_padded" {
  let tt = ttable_new()
  let record = runtime_codegen_structural3(300, ty_bool(), 100, ty_f32(), 200, ty_i64())
  let reordered = runtime_codegen_structural3(200, ty_i64(), 300, ty_bool(), 100, ty_f32())
  Test.assert_eq(cg_layout_inline_size(tt, record), 24)
  Test.assert_eq(cg_layout_storage_size(tt, record), 24)
  Test.assert_eq(cg_layout_inline_align(tt, record), 8)
  Test.assert_eq(cg_layout_storage_align(tt, record), 8)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, record, 100), 0)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, record, 200), 8)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, record, 300), 16)
  Test.assert_eq(cg_layout_inline_size(tt, reordered), 24)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, reordered, 200), 8)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, record, 999), 0 - 1)
}

test "runtime_codegen_structural_layout_empty_open_and_nested" {
  let tt = ttable_new()
  let nested_items = nlist_new()
  nlist_add(nested_items, ty_i8())
  nlist_add(nested_items, ty_f64())
  let nested = runtime_codegen_structural3(10, ty_i8(), 20, ty_tuple(nested_items), 30, ty_i16())
  Test.assert_eq(cg_layout_inline_size(tt, nested), 32)
  Test.assert_eq(cg_layout_inline_align(tt, nested), 8)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, nested, 10), 0)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, nested, 20), 8)
  Test.assert_eq(cg_layout_structural_record_field_offset(tt, nested, 30), 24)
  Test.assert_eq(cg_layout_inline_size(tt, ty_record(nlist_new(), 0)), 0)
  Test.assert_eq(cg_layout_inline_align(tt, ty_tuple(nlist_new())), 1)
  Test.assert_eq(cg_layout_inline_size(tt, ty_record(nlist_new(), 1)), 0 - 1)
  Test.assert_eq(cg_layout_inline_align(tt, ty_record(nlist_new(), 1)), 0 - 1)
}

test "runtime_codegen_structural_signature_shape_keeps_mixed_lanes" {
  let record = runtime_codegen_structural3(300, ty_str(), 100, ty_f32(), 200, ty_f64())
  let reordered = runtime_codegen_structural3(200, ty_f64(), 300, ty_str(), 100, ty_f32())
  let shape = ir_value_shape_for_type(record)
  Test.assert_eq(ir_value_shape_lane_count(shape), 3)
  Test.assert_eq(ir_value_shape_lane_at_or(shape, 0, 0), ir_value_lane_f32())
  Test.assert_eq(ir_value_shape_lane_at_or(shape, 1, 0), ir_value_lane_f64())
  Test.assert_eq(ir_value_shape_lane_at_or(shape, 2, 0), ir_value_lane_gpr())

  let params = nlist_new()
  nlist_add(params, node_new(0, 0, 0, record, 0))
  let fact = cg_semantic_fact_new_with_effect_summary(0, cg_semantic_effect_summary_new(1, 0, 0, 0), params, reordered, 0, 0)
  Test.assert_eq(cg_semantic_fact_param_lane_count(fact), 3)
  Test.assert_eq(cg_semantic_fact_return_shape(fact), cg_semantic_fact_param_shape_at(fact, 0))
  Test.assert_eq(cg_semantic_fact_word_abi(fact), 0)
}

test "runtime_codegen_semantic_fact_carries_signature_shapes" {
  let params = nlist_new()
  nlist_add(params, node_new(0, 0, 0, ty_slice(ty_i64()), 0))
  nlist_add(params, node_new(0, 0, 0, ty_f64(), 0))
  nlist_add(params, node_new(0, 0, 0, ty_i64(), 0))
  let summary = cg_semantic_effect_summary_new(1, 0, 0, 0)
  let fact = cg_semantic_fact_new_with_effect_summary(0, summary, params, ty_mut_slice(ty_str()), 0, 0)
  Test.assert_eq(nlist_len(cg_semantic_fact_param_shapes(fact)), 3)
  Test.assert_eq(ir_value_shape_lane_count(cg_semantic_fact_param_shape_at(fact, 0)), 2)
  Test.assert_eq(ir_value_shape_lane_at_or(cg_semantic_fact_param_shape_at(fact, 1), 0, 0), ir_value_lane_f64())
  Test.assert_eq(ir_value_shape_is_single_gpr(cg_semantic_fact_param_shape_at(fact, 2)), 1)
  Test.assert_eq(cg_semantic_fact_param_lane_count(fact), 4)
  Test.assert_eq(ir_value_shape_lane_count(cg_semantic_fact_return_shape(fact)), 2)
  Test.assert_eq(cg_semantic_fact_word_abi(fact), 0)

  let scalar_params = nlist_new()
  nlist_add(scalar_params, node_new(0, 0, 0, ty_i64(), 0))
  let scalar_fact = cg_semantic_fact_new_with_effect_summary(0, summary, scalar_params, ty_i64(), 0, 0)
  Test.assert_eq(cg_semantic_fact_param_lane_count(scalar_fact), 1)
  Test.assert_eq(cg_semantic_fact_word_abi(scalar_fact), 1)
}

test "runtime_ir_borrow_fact_model_verifies_provenance" {
  let origin = ir_borrow_origin(ir_borrow_owner_parameter(1), 2, 3, 1)
  let origins = ir_borrow_origin_list_prepend(origin, ir_borrow_origin_list_empty())
  let values = ir_borrow_value_facts_prepend(2, origins, ir_borrow_value_facts_empty())
  let params = ir_borrow_param_facts_prepend(1, 2, 1, ir_borrow_param_facts_empty())
  let summary_params = ir_value_list_prepend(1, ir_value_list_empty())
  let facts = ir_borrow_facts_new(params, values, 1, ir_borrow_summary_known(summary_params))
  Test.assert_eq(ir_borrow_facts_valid(facts, 3), 1)
  Test.assert_eq(ir_borrow_param_fact_count(ir_borrow_facts_params(facts)), 1)
  Test.assert_eq(ir_borrow_value_fact_count(ir_borrow_facts_values(facts)), 1)
  Test.assert_eq(ir_borrow_summary_param_count_or(ir_borrow_facts_summary(facts), 0 - 1), 1)
  Test.assert_eq(ir_borrow_origin_start(origin), 2)
  Test.assert_eq(ir_borrow_origin_len(origin), 3)
  Test.assert_eq(ir_borrow_origin_mutable(origin), 1)

  let duplicate_params = ir_value_list_prepend(1, ir_value_list_prepend(1, ir_value_list_empty()))
  let duplicate_summary = ir_borrow_facts_new(params, values, 1, ir_borrow_summary_known(duplicate_params))
  Test.assert_eq(ir_borrow_facts_valid(duplicate_summary, 3), 0)
  let opaque_scalar = ir_borrow_facts_new(ir_borrow_param_facts_empty(), ir_borrow_value_facts_empty(), 0 - 1, ir_borrow_summary_unknown())
  Test.assert_eq(ir_borrow_facts_valid(opaque_scalar, 0), 1)
}

test "runtime_codegen_layout_rc_payload_and_block_facts" {
  let tt = ttable_new()
  let rc_i32 = ty_rc(ty_i32())
  let rc_i64 = ty_rc(ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, rc_i32), 8)
  Test.assert_eq(cg_layout_inline_size(tt, rc_i32), 8)
  Test.assert_eq(cg_layout_rc_header_size(), 48)
  Test.assert_eq(cg_layout_rc_payload_size(tt, rc_i32), 4)
  Test.assert_eq(cg_layout_rc_block_size(tt, rc_i32), 52)
  Test.assert_eq(cg_layout_rc_payload_size(tt, rc_i64), 8)
  Test.assert_eq(cg_layout_rc_block_size(tt, rc_i64), 56)
  Test.assert_eq(cg_layout_rc_payload_size(tt, ty_i64()), 0 - 1)
}

test "runtime_codegen_layout_record_inline_offsets" {
  let src = __str_ptr("Mixedabc")
  let tt = ttable_new()
  let arena = arena_new(128)
  let fields = arena_alloc(arena, 72, 8)
  runtime_codegen_layout_store_field(fields, 0, 5, 1, ty_i8())
  runtime_codegen_layout_store_field(fields, 1, 6, 1, ty_i64())
  runtime_codegen_layout_store_field(fields, 2, 7, 1, ty_i32())
  ttable_add(tt, src, 0, 5, 0, 3, fields, 0)
  let ty = ty_named(type_name_hash(src, 0, 5), ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, ty), 8)
  Test.assert_eq(cg_layout_storage_align(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 24)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 0), 0)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 2), 16)
  Test.assert_eq(cg_layout_field_size(tt, ty, 0), 1)
  Test.assert_eq(cg_layout_field_size(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_size(tt, ty, 2), 4)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 3), 0 - 1)
  arena_free(arena)
}

test "runtime_codegen_layout_vector_record_payload_eligibility" {
  let src = __str_ptr("PlainabManagedrcNestedchild")
  let tt = ttable_new()
  let arena = arena_new(160)
  let plain_fields = arena_alloc(arena, 48, 8)
  runtime_codegen_layout_store_field(plain_fields, 0, 5, 1, ty_i8())
  runtime_codegen_layout_store_field(plain_fields, 1, 6, 1, ty_i64())
  ttable_add(tt, src, 0, 5, 0, 2, plain_fields, 0)
  let managed_fields = arena_alloc(arena, 24, 8)
  runtime_codegen_layout_store_field(managed_fields, 0, 14, 2, ty_rc(ty_i64()))
  ttable_add(tt, src, 7, 7, 0, 1, managed_fields, 0)
  let nested_fields = arena_alloc(arena, 24, 8)
  runtime_codegen_layout_store_field(nested_fields, 0, 22, 5, ty_named(type_name_hash(src, 0, 5), ty_i64()))
  ttable_add(tt, src, 16, 6, 0, 1, nested_fields, 0)
  let plain = ty_named(type_name_hash(src, 0, 5), ty_i64())
  let managed = ty_named(type_name_hash(src, 7, 7), ty_i64())
  let nested = ty_named(type_name_hash(src, 16, 6), ty_i64())
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, plain), 1)
  Test.assert_eq(cg_layout_vector_element_size(tt, plain), 16)
  Test.assert_eq(cg_layout_vector_element_mode(tt, plain), cg_layout_vector_record_mode())
  Test.assert_eq(cg_layout_storage_mode(tt, plain), cg_layout_vector_managed_mode())
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, managed), 0)
  Test.assert_eq(cg_layout_vector_element_size(tt, managed), 8)
  Test.assert_eq(cg_layout_vector_record_inline_eligible(tt, nested), 0)
  Test.assert_eq(cg_layout_vector_element_size(tt, nested), 8)
  arena_free(arena)
}

test "runtime_codegen_layout_generic_record_substitutes_type_args" {
  let src = __str_ptr("BoxTvalueptr")
  let tt = ttable_new()
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 3, 1, 0, 0))
  let arena = arena_new(96)
  let fields = arena_alloc(arena, 48, 8)
  runtime_codegen_layout_store_field(fields, 0, 4, 5, ty_var(0))
  runtime_codegen_layout_store_field(fields, 1, 9, 3, ty_mut_ptr(ty_var(0)))
  ttable_add(tt, src, 0, 3, 0, 2, fields, tparams)
  let args = nlist_new()
  nlist_add(args, ty_i32())
  let ty = ty_named_app(type_name_hash(src, 0, 3), ty_i64(), args)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 16)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 0), 0)
  Test.assert_eq(cg_layout_field_size(tt, ty, 0), 4)
  Test.assert_eq(cg_layout_field_align(tt, ty, 0), 4)
  Test.assert_eq(cg_layout_field_offset(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_size(tt, ty, 1), 8)
  Test.assert_eq(cg_layout_field_align(tt, ty, 1), 8)
  arena_free(arena)
}

test "runtime_codegen_layout_variant_inline_size_uses_largest_payload" {
  let src = __str_ptr("ChoiceSmallWide")
  let tt = ttable_new()
  let arena = arena_new(128)
  let variants = arena_alloc(arena, 80, 8)
  let small_payloads = nlist_new()
  nlist_add(small_payloads, ty_i8())
  let wide_payloads = nlist_new()
  nlist_add(wide_payloads, ty_i64())
  nlist_add(wide_payloads, ty_i32())
  runtime_codegen_layout_store_variant(src, variants, 0, 6, 5, small_payloads)
  runtime_codegen_layout_store_variant(src, variants, 1, 11, 4, wide_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, 0)
  let ty = ty_named(type_name_hash(src, 0, 6), ty_i64())
  Test.assert_eq(cg_layout_storage_size(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_align(tt, ty), 8)
  Test.assert_eq(cg_layout_inline_size(tt, ty), 24)
  arena_free(arena)
}

test "runtime_codegen_layout_unknown_sad_paths" {
  let tt = ttable_new()
  let missing_src = __str_ptr("Missing")
  let missing = ty_named(type_name_hash(missing_src, 0, 7), ty_i64())
  Test.assert_eq(cg_layout_inline_size(tt, ty_union(ty_i64(), ty_bool())), 0 - 1)
  Test.assert_eq(cg_layout_record_inline_size(tt, missing), 0 - 1)
  Test.assert_eq(cg_layout_field_offset(tt, ty_i64(), 0), 0 - 1)
  Test.assert_eq(cg_layout_field_size(tt, missing, 0), 0 - 1)
  Test.assert_eq(cg_layout_rc_block_size(tt, ty_i64()), 0 - 1)
}

test "runtime_codegen_alloc_fmap_lookup_update_and_got_growth" {
  let src = __str_ptr("alpha beta")
  let fm = fmap_new()
  fmap_add(fm, src, 0, 5, 40)
  Test.assert_eq(fmap_contains(fm, src, 0, 5), 1)
  Test.assert_eq(fmap_lookup(fm, src, 0, 5), 40)
  fmap_update_offset(fm, src, 0, 5, 88)
  Test.assert_eq(fmap_lookup(fm, src, 0, 5), 88)
  Test.assert_eq(fmap_contains(fm, src, 6, 4), 0)
  let mut i = 0
  while i < 70 {
    fmap_add_got_patch(fm, i, i + 10)
    i = i + 1
  }
  let gp = mem_load64(fm + 120)
  Test.assert_eq(mem_load64(fm + 128), 70)
  Test.assert_eq(if mem_load64(fm + 136) > 64 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64(gp), 0)
  Test.assert_eq(mem_load64(gp + 69 * 16), 69)
  Test.assert_eq(mem_load64(gp + 69 * 16 + 8), 79)
}

test "runtime_codegen_alloc_method_map" {
  let mm = mmap_new()
  mmap_add(mm, 10, 20, 30, 0)
  Test.assert_eq(mmap_lookup(mm, 10, 20), 30)
  Test.assert_eq(mmap_lookup_by_method(mm, 20), 30)
  Test.assert_eq(mmap_lookup(mm, 10, 21), 0)
  mmap_update(mm, 10, 20, 44)
  Test.assert_eq(mmap_lookup(mm, 10, 20), 44)
}

test "runtime_codegen_alloc_template_and_cache_maps" {
  let src = __str_ptr("template")
  let tm = mono_tmap_new()
  mono_tmap_add(tm, 101, 202, src)
  let entry = mono_tmap_lookup(tm, 101)
  Test.assert_eq(mem_load64(entry), 101)
  Test.assert_eq(mem_load64(entry + 8), 202)
  Test.assert_eq(mem_load64(entry + 16), src)
  Test.assert_eq(mono_tmap_lookup(tm, 102), 0)
  let cache = mono_cache_new()
  mono_cache_add(cache, 33, 400)
  mono_cache_add(cache, 34, 500)
  Test.assert_eq(mono_cache_lookup(cache, 33), 400)
  Test.assert_eq(mono_cache_lookup(cache, 34), 500)
  Test.assert_eq(mono_cache_lookup(cache, 35), 0)
}
