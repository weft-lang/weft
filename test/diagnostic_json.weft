use stdlib/diagnostic/json as codec
use stdlib/diagnostic/schema.{*}
use stdlib/json as json
use stdlib/json.{*}
use stdlib/result.{Result, Ok, Err}
use stdlib/semantic_type.{*}
use stdlib/string.{str_eq}

fn named_range(name: str, start: i64, end: i64) -> DiagnosticLocation {
  DiagnosticSourceRange(DiagnosticSourceNamed(name), __i64_to_usize(start), __i64_to_usize(end))
}

fn sample() -> Diagnostic {
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassGrammar,
    DiagnosticCodeAssigned("E7001"),
    "column is not visible",
    named_range("embedded", 7, 14),
    DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation(
        "table declared here",
        DiagnosticSourceRange(DiagnosticSourceBuffer(4096), __i64_to_usize(2), __i64_to_usize(9))
      ),
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation("no range", DiagnosticLocationNone),
        DiagnosticRelatedLocationNil
      )
    ),
    DiagnosticFieldCons(
      DiagnosticFieldText("column", "missing"),
      DiagnosticFieldCons(
        DiagnosticFieldI64("candidates", 0 - 3),
        DiagnosticFieldCons(
          DiagnosticFieldU64("hash", __i64_to_u64(0 - 1)),
          DiagnosticFieldCons(
            DiagnosticFieldBool("recovered", true),
            DiagnosticFieldCons(
              DiagnosticFieldLocation(
                "table",
                DiagnosticSourceRange(
                  DiagnosticSourceUnknown,
                  __i64_to_usize(0),
                  __i64_to_usize(0)
                )
              ),
              DiagnosticFieldCons(
                DiagnosticFieldType("expected", SemanticTypePrimitive("i64")),
                DiagnosticFieldCons(
                  DiagnosticFieldEffectAtom(
                    "needs",
                    SemanticEffectAtom(
                      "TypeCheck",
                      SemanticTypeFactListCons(SemanticTypeOther("I"), SemanticTypeFactListNil)
                    )
                  ),
                  DiagnosticFieldCons(
                    DiagnosticFieldEffectSet(
                      "available",
                      SemanticEffectsClosed(SemanticEffectAtomFactListNil)
                    ),
                    DiagnosticFieldCons(
                      DiagnosticFieldSuggestion(
                        DiagnosticSuggestion(
                          "did you mean `id`?",
                          DiagnosticSuggestionMaybeIncorrect,
                          DiagnosticTextEditCons(
                            DiagnosticTextEdit(named_range("embedded", 7, 14), "id"),
                            DiagnosticTextEditNil
                          )
                        )
                      ),
                      DiagnosticFieldNil
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn rendered(diagnostic: Diagnostic) -> str {
  match json_stringify(codec.encode(diagnostic)) { Ok(text) -> text, Err(_) -> "<unrenderable>" }
}

fn round_trip(diagnostic: Diagnostic) -> bool {
  match json.parse(rendered(diagnostic)) {
    Err(_) -> false
    Ok(parsed) -> match codec.decode(parsed) {
      Err(_) -> false
      Ok(decoded) -> str_eq(rendered(decoded), rendered(diagnostic)) == 1
    }
  }
}

fn decode_text(text: str) -> Result<Diagnostic, codec.DiagnosticJsonError> {
  match json.parse(text) {
    Err(_) -> Err<Diagnostic, codec.DiagnosticJsonError>(
      codec.DiagnosticJsonShape("document", "json")
    )
    Ok(parsed) -> codec.decode(parsed)
  }
}

test "a diagnostic with every field kind survives a text round trip" {
  Test.assert_true(round_trip(sample()))
  Test.assert_true(
    round_trip(
      Diagnostic(
        DiagnosticSeverityWarning,
        DiagnosticClassOther("lint"),
        DiagnosticCodeUnassigned,
        "",
        DiagnosticLocationNone,
        DiagnosticRelatedLocationNil,
        DiagnosticFieldNil
      )
    )
  )
  Test.assert_true(
    round_trip(
      Diagnostic(
        DiagnosticSeverityNote,
        DiagnosticClassTool,
        DiagnosticCodeAssigned(""),
        "note",
        named_range("", 0, 0),
        DiagnosticRelatedLocationNil,
        DiagnosticFieldNil
      )
    )
  )
}

test "the encoding is the tool vocabulary with an explicit schema version" {
  let text = rendered(
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassGrammar,
      DiagnosticCodeUnassigned,
      "bad",
      named_range("embedded", 1, 3),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldNil
    )
  )
  Test.assert_str_eq(
    text,
    "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"grammar\",\"code\":null,\"message\":\"bad\",\"primary\":{\"source\":{\"kind\":\"named\",\"name\":\"embedded\"},\"start\":1,\"end\":3},\"related\":[],\"fields\":[]}"
  )
  match codec.encode(sample()) {
    JsonObject(_) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  -- A u64 beyond the signed domain travels as decimal text and returns intact.
  let wide = rendered(
    Diagnostic(
      DiagnosticSeverityNote,
      DiagnosticClassTool,
      DiagnosticCodeUnassigned,
      "",
      DiagnosticLocationNone,
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(DiagnosticFieldU64("hash", __i64_to_u64(0 - 1)), DiagnosticFieldNil)
    )
  )
  Test.assert_true(wide.contains("\"value\":\"18446744073709551615\""))
}

test "decoding rejects the wrong schema version severity kind and shapes" {
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":2,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[]}"
    ) { Err(codec.DiagnosticJsonShape(_, what)) -> what == "schema_version", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"fatal\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[]}"
    ) { Err(codec.DiagnosticJsonUnknownKind(kind)) -> kind == "fatal", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":{\"source\":{\"kind\":\"named\",\"name\":\"x\"},\"start\":1},\"related\":[],\"fields\":[]}"
    ) { Err(codec.DiagnosticJsonShape(_, what)) -> what == "end", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[{\"kind\":\"colour\",\"name\":\"n\",\"value\":1}]}"
    ) { Err(codec.DiagnosticJsonUnknownKind(kind)) -> kind == "colour", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[{\"kind\":\"type\",\"name\":\"n\",\"value\":{\"kind\":\"galaxy\"}}]}"
    ) { Err(codec.DiagnosticJsonType(_)) -> true, _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[{\"kind\":\"u64\",\"name\":\"n\",\"value\":\"18446744073709551616\"}]}"
    ) { Err(codec.DiagnosticJsonShape(_, what)) -> what == "value", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"tool\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[{\"kind\":\"u64\",\"name\":\"n\",\"value\":-1}]}"
    ) { Err(codec.DiagnosticJsonShape(_, what)) -> what == "value", _ -> false }
  )
  Test.assert_true(
    match decode_text(
      "{\"schema_version\":1,\"severity\":\"error\",\"class\":\"cosmic\",\"message\":\"m\",\"primary\":null,\"related\":[],\"fields\":[]}"
    ) {
      Ok(Diagnostic(_, DiagnosticClassOther(name), _, _, _, _, _)) -> name == "cosmic",
      _ -> false
    }
  )
}
