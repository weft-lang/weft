-- A conditional whose branch yields an owned binding moves it into the join:
-- the binding must not be dropped again at scope end. Each case counts exact
-- Drop runs, so both double drops and lost drops fail.

use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

type BuilderStorage { log: F64Table, steps: i64 }

type Builder = opaque BuilderStorage

impl Drop for Builder {
  fn drop(self) -> nil {
    match self {
      Builder(storage) -> {
        let { log, steps: _ } = storage
        log.set(0, 0, log.get(0, 0).unwrap() + 1.0)
        nil
      }
    }
  }
}

type Frozen { log: F64Table, steps: i64 }

fn builder(log: F64Table) -> owned Builder { Builder(BuilderStorage { log: log, steps: 0 }) }

impl Builder {
  fn step(self: owned Self) -> owned Builder {
    match self {
      Builder(storage) -> {
        let { log, steps } = storage
        Builder(BuilderStorage { log: log, steps: steps + 1 })
      }
    }
  }

  fn freeze(self: owned Self) -> Frozen {
    match self {
      Builder(storage) -> {
        let { log, steps } = storage
        Frozen { log: log, steps: steps }
      }
    }
  }
}

fn drops(run: (F64Table) -> i64) -> f64 {
  let log = table.filled(1, 1, 0.0).unwrap()
  let result = run(log)
  log.get(0, 0).unwrap()
}

fn match_identity(log: F64Table, keep: bool) -> i64 {
  let built = builder(log)
  let built = match keep {
    true -> built
    false -> built.step()
  }
  built.freeze().steps
}

fn if_identity(log: F64Table, keep: bool) -> i64 {
  let built = builder(log)
  let built = if keep { built } else { built.step() }
  built.freeze().steps
}

fn block_identity(log: F64Table, keep: bool) -> i64 {
  let built = builder(log)
  let built = match keep {
    true -> { built }
    false -> { built.step() }
  }
  built.freeze().steps
}

fn distinct_identity(log: F64Table, keep: bool) -> i64 {
  let first = builder(log)
  let second = match keep {
    true -> first
    false -> first.step()
  }
  second.freeze().steps
}

fn both_identity(log: F64Table, keep: bool) -> i64 {
  let built = builder(log)
  let built = match keep {
    true -> built
    false -> built
  }
  built.freeze().steps
}

fn nested_identity(log: F64Table, outer: bool, inner: bool) -> i64 {
  let built = builder(log)
  let built = match outer {
    true -> match inner {
      true -> built
      false -> built.step()
    }
    false -> built
  }
  built.freeze().steps
}

fn kept_unconsumed(log: F64Table, keep: bool) -> i64 {
  let built = builder(log)
  let built = match keep {
    true -> built
    false -> built.step()
  }
  7
}

test "a match arm yielding the owned binding moves it" {
  Test.assert_eq_f64(drops((log) => match_identity(log, true)), 0.0)
  Test.assert_eq_f64(drops((log) => match_identity(log, false)), 0.0)
}

test "an if branch yielding the owned binding moves it" {
  Test.assert_eq_f64(drops((log) => if_identity(log, true)), 0.0)
  Test.assert_eq_f64(drops((log) => if_identity(log, false)), 0.0)
}

test "a block arm yielding the owned binding moves it" {
  Test.assert_eq_f64(drops((log) => block_identity(log, true)), 0.0)
}

test "a branch moving into a differently named binding moves it" {
  Test.assert_eq_f64(drops((log) => distinct_identity(log, true)), 0.0)
}

test "every arm yielding the owned binding moves it" {
  Test.assert_eq_f64(drops((log) => both_identity(log, true)), 0.0)
  Test.assert_eq_f64(drops((log) => both_identity(log, false)), 0.0)
}

test "nested branches yielding the owned binding move it" {
  Test.assert_eq_f64(drops((log) => nested_identity(log, true, true)), 0.0)
  Test.assert_eq_f64(drops((log) => nested_identity(log, true, false)), 0.0)
  Test.assert_eq_f64(drops((log) => nested_identity(log, false, true)), 0.0)
}

test "an unconsumed joined binding is dropped exactly once" {
  Test.assert_eq_f64(drops((log) => kept_unconsumed(log, true)), 1.0)
  Test.assert_eq_f64(drops((log) => kept_unconsumed(log, false)), 1.0)
}
