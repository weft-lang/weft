use "runtime/rc_implicit_test.weft"
use "stdlib/num.weft"

type IndexedBox {
  value: i64,
}

effect IndexedImmediate {
  fn read() -> i64
}

effect IndexedAbort {
  fn read() -> i64
}

effect IndexedDeferred {
  @deferred fn read() -> i64
}

fn indexed_pick(values: [i64; 4], index: usize) -> i64 {
  values[index]
}

fn indexed_generic_pick<T>(values: [T; 2], index: usize) -> T {
  values[index]
}

fn indexed_probe_pair(probe: RuntimeRcProbe) -> [RuntimeRcProbe; 2] {
  [probe, probe]
}

fn indexed_owned_base_count(probe: RuntimeRcProbe) -> i64 {
  let got = indexed_probe_pair(probe)[1]
  runtime_rc_probe_count(got)
}

fn indexed_immediate_clause(values: [i64; 2]) -> i64 {
  handle IndexedImmediate.read() {
    IndexedImmediate.read() -> resume(values[1])
  }
}

fn indexed_abortive_clause(values: [i64; 2]) -> i64 {
  handle IndexedAbort.read() {
    IndexedAbort.read() -> values[1]
  }
}

fn indexed_deferred_clause(values: [i64; 2]) -> i64 {
  handle IndexedDeferred.read() {
    IndexedDeferred.read() with k -> k(values[1])
  }
}

fn indexed_generic_replace<T>(initial: T, replacement: T) -> T {
  let mut values = [initial, initial]
  values[1] = replacement
  values[1]
}

fn indexed_managed_replace(first: RuntimeRcProbe, replacement: RuntimeRcProbe) -> i64 {
  let mut values = [first, first]
  values[0] = replacement
  42
}

fn indexed_immediate_mutation() -> i64 {
  handle IndexedImmediate.read() {
    IndexedImmediate.read() -> resume({ let mut values = [1, 2] values[0] = 42 values[0] })
  }
}

fn indexed_abortive_mutation() -> i64 {
  handle IndexedAbort.read() {
    IndexedAbort.read() -> { let mut values = [1, 2] values[0] = 42 values[0] }
  }
}

fn indexed_deferred_mutation() -> i64 {
  handle IndexedDeferred.read() {
    IndexedDeferred.read() with k -> k({ let mut values = [1, 2] values[0] = 42 values[0] })
  }
}

test "checked_index_reads_fixed_boundaries_and_usize_variables" {
  Test.assert_eq(indexed_pick([10, 20, 30, 40], 0), 10)
  Test.assert_eq(indexed_pick([10, 20, 30, 40], 3), 40)
}

test "checked_index_specialises_generic_element_layout" {
  Test.assert_eq(indexed_generic_pick<i64>([7, 9], 1), 9)
  Test.assert_str_eq(indexed_generic_pick<str>(["alpha", "雪"], 1), "雪")
}

test "checked_index_preserves_exact_scalar_widths" {
  let bytes: [u8; 3] = [1, 2, 255]
  let wide: [f64; 2] = [1.25, 3.75]
  let narrow: [f32; 2] = [1.5, 2.5]
  Test.assert_eq(if bytes[2] == 255 { 1 } else { 0 }, 1)
  Test.assert_eq_f64(wide[1], 3.75)
  Test.assert_eq_f64(num_f32_to_f64(narrow[0]), 1.5)
}

test "checked_index_evaluates_base_then_index_once" {
  let mut order = 0
  let got = { order = order * 10 + 1; [10, 20] }[{ order = order * 10 + 2; 1 }]
  Test.assert_eq(order, 12)
  Test.assert_eq(got, 20)
}

test "checked_index_lowers_cfg_base_and_index" {
  let got = (if true { [3, 5] } else { [7, 11] })[if false { 0 } else { 1 }]
  Test.assert_eq(got, 5)
}

test "checked_index_copies_nested_array_values" {
  let row: [i64; 2] = [[1, 2], [3, 4]][1]
  Test.assert_eq(row[0] * 10 + row[1], 34)
  Test.assert_eq([[[42]]][0][0][0], 42)
}

test "checked_index_retains_managed_elements" {
  let probe = runtime_rc_probe_new(7)
  let values: [RuntimeRcProbe; 2] = [probe, probe]
  let got = values[1]
  Test.assert_eq(runtime_rc_probe_count(got), 4)
  Test.assert_eq(indexed_owned_base_count(probe), 5)
}

test "checked_index_reads_managed_records" {
  let boxes: [IndexedBox; 2] = [IndexedBox { value: 11 }, IndexedBox { value: 29 }]
  Test.assert_eq(boxes[1].value, 29)
}

test "checked_index_lowers_in_all_handler_clause_tiers" {
  Test.assert_eq(indexed_immediate_clause([11, 22]), 22)
  Test.assert_eq(indexed_abortive_clause([13, 26]), 26)
  Test.assert_eq(indexed_deferred_clause([17, 34]), 34)
}

test "checked_index_mutation_preserves_array_value_semantics" {
  let original = [10, 20]
  let mut copy = original
  copy[0] = 42
  Test.assert_eq(original[0], 10)
  Test.assert_eq(copy[0], 42)

  copy[1] = 77
  Test.assert_eq(original[1], 20)
  Test.assert_eq(copy[1], 77)
}

test "checked_index_mutation_preserves_exact_scalar_widths" {
  let mut bytes: [u8; 3] = [1, 2, 3]
  bytes[2] = 255
  let mut wide: [f64; 2] = [1.25, 3.75]
  wide[0] = 4.5
  let mut narrow: [f32; 2] = [1.5, 2.5]
  narrow[1] = 3.5
  Test.assert_eq(if bytes[2] == 255 { 1 } else { 0 }, 1)
  Test.assert_eq_f64(wide[0], 4.5)
  Test.assert_eq_f64(num_f32_to_f64(narrow[1]), 3.5)
}

test "checked_index_mutation_specialises_generic_layout" {
  Test.assert_eq(indexed_generic_replace<i64>(7, 42), 42)
  Test.assert_str_eq(indexed_generic_replace<str>("old", "new"), "new")
}

test "checked_index_mutation_evaluates_index_then_value_once" {
  let mut order = 0
  let mut values = [10, 20]
  values[{ order = order * 10 + 1; 1 }] = { order = order * 10 + 2; 42 }
  Test.assert_eq(order, 12)
  Test.assert_eq(values[1], 42)
}

test "checked_index_mutation_lowers_cfg_index_and_value" {
  let mut values = [10, 20]
  values[if true { 1 } else { 0 }] = if false { 7 } else { 42 }
  Test.assert_eq(values[1], 42)
}

test "checked_index_mutation_copies_nested_array_values" {
  let original = [[1, 2], [3, 4]]
  let mut copy = original
  copy[1] = [8, 9]
  Test.assert_eq(original[1][0] * 10 + original[1][1], 34)
  Test.assert_eq(copy[1][0] * 10 + copy[1][1], 89)
}

test "checked_index_mutation_balances_managed_elements" {
  let first = runtime_rc_probe_new(11)
  let replacement = runtime_rc_probe_new(29)
  Test.assert_eq(indexed_managed_replace(first, replacement), 42)
  Test.assert_eq(runtime_rc_probe_count(first), 1)
  Test.assert_eq(runtime_rc_probe_count(replacement), 1)
}

test "checked_index_mutation_lowers_in_all_handler_clause_tiers" {
  Test.assert_eq(indexed_immediate_mutation(), 42)
  Test.assert_eq(indexed_abortive_mutation(), 42)
  Test.assert_eq(indexed_deferred_mutation(), 42)
}
