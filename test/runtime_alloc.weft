use runtime/alloc_test.{*}

test "runtime_alloc_bump_returns_contiguous_regions" {
  Test.assert_eq(runtime_alloc_bump_contiguous_delta(), 8)
  Test.assert_eq(runtime_alloc_bump_first_value(), 42)
  Test.assert_eq(runtime_alloc_bump_second_value(), 99)
}

test "runtime_alloc_zeroed_clears_requested_bytes" {
  Test.assert_eq(runtime_alloc_zeroed_byte(0), 0)
  Test.assert_eq(runtime_alloc_zeroed_byte(1), 0)
  Test.assert_eq(runtime_alloc_zeroed_byte(2), 0)
  Test.assert_eq(runtime_alloc_zeroed_byte(3), 0)
  Test.assert_eq(runtime_alloc_zeroed_byte(4), 0)
}

test "runtime_alloc_words_advances_by_word_count" {
  Test.assert_eq(runtime_alloc_words_delta(), 24)
}

test "runtime_alloc_round_up_matrix" {
  Test.assert_eq(runtime_alloc_round_up_case(0, 8), 0)
  Test.assert_eq(runtime_alloc_round_up_case(1, 8), 8)
  Test.assert_eq(runtime_alloc_round_up_case(8, 8), 8)
  Test.assert_eq(runtime_alloc_round_up_case(9, 8), 16)
  Test.assert_eq(runtime_alloc_round_up_case(5, 0), 5)
  Test.assert_eq(runtime_alloc_round_up_case(5, 1), 5)
}

test "runtime_alloc_bump_rounded_advances_by_rounded_size" {
  Test.assert_eq(runtime_alloc_bump_rounded_delta(), 16)
}

test "runtime_alloc_bump_grows_past_initial_segment" {
  Test.assert_eq(runtime_alloc_bump_grows_past_initial_segment(), 110)
}
