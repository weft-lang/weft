use "runtime/alloc.weft"

test "runtime_alloc_bump_returns_contiguous_regions" {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  Test.assert_eq(q - p, 8)
  __mem_store64(p, 42)
  __mem_store64(q, 99)
  Test.assert_eq(__mem_load64(p), 42)
  Test.assert_eq(__mem_load64(q), 99)
}

test "runtime_alloc_zeroed_clears_requested_bytes" {
  let p = alloc_zeroed(5)
  Test.assert_eq(__mem_load8(p), 0)
  Test.assert_eq(__mem_load8(p + 1), 0)
  Test.assert_eq(__mem_load8(p + 2), 0)
  Test.assert_eq(__mem_load8(p + 3), 0)
  Test.assert_eq(__mem_load8(p + 4), 0)
}

test "runtime_alloc_words_advances_by_word_count" {
  let p = alloc_words(3)
  let q = alloc_bump(1)
  Test.assert_eq(q - p, 24)
}

test "runtime_alloc_round_up_matrix" {
  Test.assert_eq(alloc_round_up(0, 8), 0)
  Test.assert_eq(alloc_round_up(1, 8), 8)
  Test.assert_eq(alloc_round_up(8, 8), 8)
  Test.assert_eq(alloc_round_up(9, 8), 16)
  Test.assert_eq(alloc_round_up(5, 0), 5)
  Test.assert_eq(alloc_round_up(5, 1), 5)
}

test "runtime_alloc_bump_rounded_advances_by_rounded_size" {
  let p = alloc_bump_rounded(9, 8)
  let q = alloc_bump(1)
  Test.assert_eq(q - p, 16)
}
