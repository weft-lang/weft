-- test/effects.weft — Effect handlers (Tier 2: tail-resumptive)

use "runtime/alloc.weft"

effect State {
  fn get() -> i64
  fn put(v: i64) -> i64
}

effect Counter {
  fn inc() -> i64
  fn read() -> i64
}

effect Ask {
  fn ask() -> i64
}

effect Math {
  fn add(a: i64, b: i64) -> i64
}

effect E {
  fn f() -> i64
}

fn go_state() -[State]> i64 {
  let a = State.get()
  State.put(a + 10)
  let b = State.get()
  State.put(b + 5)
  State.get()
}

fn go_counter() -[Counter]> i64 {
  Counter.inc()
  Counter.inc()
  Counter.inc()
  Counter.read()
}

fn do_put_get() -[State]> i64 {
  State.put(99)
  State.get()
}

test "eff_h_get" {
  let c = alloc_bump(8)
  __mem_store64(c, 42)
  let r = handle State.get() {
    State.get() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 42)
}

test "eff_h_put_get" {
  let c = alloc_bump(8)
  __mem_store64(c, 0)
  let r = handle do_put_get() {
    State.get() -> resume(__mem_load64(c))
    State.put(v) -> { __mem_store64(c, v) resume(0) }
  }
  Test.assert_eq(r, 99)
}

test "eff_h_multi" {
  let c = alloc_bump(8)
  __mem_store64(c, 100)
  let r = handle go_state() {
    State.get() -> resume(__mem_load64(c))
    State.put(v) -> { __mem_store64(c, v) resume(0) }
  }
  Test.assert_eq(r, 115)
}

test "eff_h_counter" {
  let c = alloc_bump(8)
  __mem_store64(c, 0)
  let r = handle go_counter() {
    Counter.inc() -> { __mem_store64(c, __mem_load64(c) + 1) resume(0) }
    Counter.read() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 3)
}

test "eff_h_no_perform" {
  let c = alloc_bump(8)
  __mem_store64(c, 0)
  let r = handle 42 {
    State.get() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 42)
}

test "eff_h_zero_arg" {
  let r = handle Ask.ask() {
    Ask.ask() -> resume(7)
  }
  Test.assert_eq(r, 7)
}

test "eff_h_multi_arg" {
  let r = handle Math.add(10, 20) {
    Math.add(a, b) -> resume(a + b)
  }
  Test.assert_eq(r, 30)
}

test "eff_h_result" {
  let c = alloc_bump(8)
  __mem_store64(c, 10)
  let r = handle State.get() {
    State.get() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 10)
}

test "eff_h_in_if" {
  let c = alloc_bump(8)
  __mem_store64(c, 42)
  let r = handle { if true { State.get() } else { 0 } } {
    State.get() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 42)
}

fn go_while() -[Counter]> i64 {
  let mut i = 0
  while i < 10 { Counter.inc() i = i + 1 }
  Counter.read()
}

test "eff_h_in_while" {
  let c = alloc_bump(8)
  __mem_store64(c, 0)
  let r = handle go_while() {
    Counter.inc() -> { __mem_store64(c, __mem_load64(c) + 1) resume(0) }
    Counter.read() -> resume(__mem_load64(c))
  }
  Test.assert_eq(r, 10)
}

test "eff_h_minimal" {
  let r = handle E.f() { E.f() -> resume(1) }
  Test.assert_eq(r, 1)
}

test "eff_h_no_capture" {
  let r = handle E.f() { E.f() -> resume(77) }
  Test.assert_eq(r, 77)
}
