-- test/logical_short_circuit.weft -- logical and/or short-circuit semantics

test "logical_and_skips_rhs_when_lhs_false_value" {
  let mut seen = 0
  let got = false and { seen = seen + 1 true }
  Test.assert_eq(if got { 1 } else { 0 }, 0)
  Test.assert_eq(seen, 0)
}

test "logical_or_skips_rhs_when_lhs_true_value" {
  let mut seen = 0
  let got = true or { seen = seen + 1 false }
  Test.assert_eq(if got { 1 } else { 0 }, 1)
  Test.assert_eq(seen, 0)
}

test "logical_and_evaluates_rhs_when_lhs_true_value" {
  let mut seen = 0
  let got = true and { seen = seen + 1 true }
  Test.assert_eq(if got { 1 } else { 0 }, 1)
  Test.assert_eq(seen, 1)
}

test "logical_or_evaluates_rhs_when_lhs_false_value" {
  let mut seen = 0
  let got = false or { seen = seen + 1 true }
  Test.assert_eq(if got { 1 } else { 0 }, 1)
  Test.assert_eq(seen, 1)
}

test "logical_and_condition_skips_rhs_when_lhs_false" {
  let mut seen = 0
  let mut result = 0
  if false and { seen = seen + 1 true } {
    result = 1
  } else {
    result = 2
  }
  Test.assert_eq(result, 2)
  Test.assert_eq(seen, 0)
}

test "logical_or_condition_skips_rhs_when_lhs_true" {
  let mut seen = 0
  let mut result = 0
  if true or { seen = seen + 1 false } {
    result = 1
  } else {
    result = 2
  }
  Test.assert_eq(result, 1)
  Test.assert_eq(seen, 0)
}

test "logical_nested_short_circuit_edges" {
  let mut seen = 0
  let got = (false and { seen = seen + 1 true }) or (true or { seen = seen + 10 false })
  Test.assert_eq(if got { 1 } else { 0 }, 1)
  Test.assert_eq(seen, 0)
}
