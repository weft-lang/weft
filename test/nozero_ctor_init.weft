use runtime/rc_implicit_test.{*}
-- test/nozero_ctor_init.weft -- ctor allocation no longer zero-fills its
-- payload at ANY field mask (managed-reference elision). The zero-fill skip rests entirely on
-- emission storing the tag and every payload word before the value is
-- observable; mask 0 (all-unmanaged aggregates -- the bulk of compiler
-- IR nodes) used to divert to the zeroing entry and now does not.
--
-- These locks are only meaningful if the allocator is actually handing
-- back RECYCLED blocks still holding the previous occupant's bytes: on a
-- fresh arena the memory reads zero and an uninitialised word would go
-- unnoticed. Each correctness churn is therefore paired with a heap
-- occupancy assertion proving the bump offset does not move, i.e. every
-- node under test came off the free list, dirty.

type NzV1 { NzV1A(i64) }
type NzV2 { NzV2A(i64, i64), NzV2B(i64, i64) }
type NzV3 { NzV3A(i64, i64, i64) }

type NzR1 { a: i64 }
type NzR2 { a: i64, b: i64 }
type NzR3 { a: i64, b: i64, c: i64 }

-- 30 words of payload (240 B) clears heap_bin_limit (256 B including the
-- 48 B header), so this shape takes the oversize fallback -- rc_alloc_core
-- with zero=0 -- rather than the fused bin fast path.
type NzWide {
  f0: i64, f1: i64, f2: i64, f3: i64, f4: i64,
  f5: i64, f6: i64, f7: i64, f8: i64, f9: i64,
  f10: i64, f11: i64, f12: i64, f13: i64, f14: i64,
  f15: i64, f16: i64, f17: i64, f18: i64, f19: i64,
  f20: i64, f21: i64, f22: i64, f23: i64, f24: i64,
  f25: i64, f26: i64, f27: i64, f28: i64, f29: i64
}

-- Payload-less arms round up to a 16 B payload whose second word no
-- payload store reaches; interleaving them with a payloaded ctor of the
-- same type aims recycled blocks at the bare arm.
type NzMixed { NzBare, NzWith(i64) }

fn nz_v1_read(v: NzV1) -> i64 { match v { NzV1A(a) -> a } }
fn nz_v2_read(v: NzV2) -> i64 {
  match v { NzV2A(a, b) -> a + b  NzV2B(a, b) -> a - b }
}
fn nz_v3_read(v: NzV3) -> i64 { match v { NzV3A(a, b, c) -> a + b + c } }
fn nz_mixed_read(m: NzMixed) -> i64 { match m { NzBare -> 0  NzWith(v) -> v } }

fn nz_churn_v1(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + nz_v1_read(NzV1A(3))
    i = i + 1
  }
  acc
}

fn nz_churn_v2(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + nz_v2_read(NzV2A(10, 4)) + nz_v2_read(NzV2B(10, 4))
    i = i + 1
  }
  acc
}

fn nz_churn_v3(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + nz_v3_read(NzV3A(1, 2, 3))
    i = i + 1
  }
  acc
}

fn nz_churn_r2(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let r = NzR2 { a: 5, b: 9 }
    acc = acc + r.a + r.b
    i = i + 1
  }
  acc
}

-- A literal whose field order differs from the declaration: emission
-- stores at ttable field indices, so coverage of every payload word
-- depends on those indices being a permutation, not on literal order.
fn nz_churn_r3_reordered(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let r = NzR3 { c: 3, a: 1, b: 2 }
    acc = acc + r.a * 100 + r.b * 10 + r.c
    i = i + 1
  }
  acc
}

fn nz_churn_wide(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let w = NzWide {
      f0: 1, f1: 1, f2: 1, f3: 1, f4: 1,
      f5: 1, f6: 1, f7: 1, f8: 1, f9: 1,
      f10: 1, f11: 1, f12: 1, f13: 1, f14: 1,
      f15: 1, f16: 1, f17: 1, f18: 1, f19: 1,
      f20: 1, f21: 1, f22: 1, f23: 1, f24: 1,
      f25: 1, f26: 1, f27: 1, f28: 1, f29: 1
    }
    acc = acc + w.f0 + w.f7 + w.f15 + w.f23 + w.f29
    i = i + 1
  }
  acc
}

fn nz_churn_mixed(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + nz_mixed_read(NzWith(7)) + nz_mixed_read(NzBare)
    i = i + 1
  }
  acc
}

-- Correctness under recycling: every field of every arity reads back the
-- value emission stored, never a previous occupant's bytes.

test "nozero_variant_1_payload_reads_correct" {
  Test.assert_eq(nz_churn_v1(2000), 6000)
}

test "nozero_variant_2_payload_reads_correct" {
  Test.assert_eq(nz_churn_v2(2000), 40000)
}

test "nozero_variant_3_payload_reads_correct" {
  Test.assert_eq(nz_churn_v3(2000), 12000)
}

test "nozero_record_2_field_reads_correct" {
  Test.assert_eq(nz_churn_r2(2000), 28000)
}

test "nozero_record_reordered_literal_covers_every_word" {
  Test.assert_eq(nz_churn_r3_reordered(2000), 246000)
}

test "nozero_oversize_record_bypasses_bin_path" {
  Test.assert_eq(nz_churn_wide(2000), 10000)
}

test "nozero_payload_less_arm_interleaved_reads_correct" {
  Test.assert_eq(nz_churn_mixed(2000), 14000)
}

test "nozero_single_field_record_reads_correct" {
  let mut i = 0
  let mut acc = 0
  while i < 2000 {
    let r = NzR1 { a: 11 }
    acc = acc + r.a
    i = i + 1
  }
  Test.assert_eq(acc, 22000)
}

-- Recycling proof: after one warm round primes the free list, a larger
-- churn must not advance the rc arena bump offset at all. If these fail,
-- the correctness locks above stopped testing dirty memory and their
-- passing means nothing.

test "nozero_variant_churn_serves_from_free_list" {
  nz_churn_v2(100)
  let before = runtime_rc_test_heap_arena_offset()
  nz_churn_v2(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "nozero_record_churn_serves_from_free_list" {
  nz_churn_r3_reordered(100)
  let before = runtime_rc_test_heap_arena_offset()
  nz_churn_r3_reordered(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "nozero_oversize_churn_serves_from_free_list" {
  nz_churn_wide(100)
  let before = runtime_rc_test_heap_arena_offset()
  nz_churn_wide(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "nozero_mixed_arm_churn_serves_from_free_list" {
  nz_churn_mixed(100)
  let before = runtime_rc_test_heap_arena_offset()
  nz_churn_mixed(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}
