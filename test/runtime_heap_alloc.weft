use runtime/memory.{*}
use runtime/alloc.{*}

fn heap_effect_reuse_program() -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  mem_store64(p, 77)
  let freed = alloc_effect_free(p, 8)
  let q = alloc_effect_zeroed(8, 8)
  if freed != 0 { 0 - 2 }
  else { if q != p { 0 - 1 } else { mem_load64(q) } }
}

test "runtime_heap_alloc_reuses_freed_block" {
  let heap = heap_new(96)
  let p = heap_alloc(heap, 8, 8)
  let q = heap_alloc(heap, 8, 8)
  mem_store64(p, 20)
  mem_store64(q, 22)
  Test.assert_eq(heap_free(heap, p, 8), 0)
  let reused = heap_alloc(heap, 8, 8)
  Test.assert_eq(reused, p)
  mem_store64(reused, 20)
  Test.assert_eq(mem_load64(reused) + mem_load64(q), 42)
  Test.assert_eq(heap_free_head(heap), 0)
  Test.assert_eq(heap_remaining(heap), 64)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_zeroed_reuse" {
  let heap = heap_new(48)
  let p = heap_alloc(heap, 8, 8)
  mem_store64(p, 99)
  Test.assert_eq(heap_free(heap, p, 8), 0)
  let z = heap_alloc_zeroed(heap, 8, 8)
  Test.assert_eq(z, p)
  Test.assert_eq(mem_load64(z), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_words_and_min_blocks" {
  let heap = heap_new(64)
  let p = heap_alloc(heap, 1, 1)
  let q = heap_alloc_words(heap, 2)
  let r = heap_alloc(heap, 1, 1)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(q - p, 16)
  Test.assert_eq(r - q, 16)
  Test.assert_eq(heap_remaining(heap), 16)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_bins_are_size_exact" {
  -- A freed small block serves only its own size class: a 16-byte free
  -- never satisfies a 24-byte request, and stays parked in its bin.
  let heap = heap_new(80)
  let small = heap_alloc(heap, 16, 8)
  let large = heap_alloc(heap, 24, 8)
  Test.assert_eq(heap_free(heap, small, 16), 0)
  let next = heap_alloc(heap, 24, 8)
  Test.assert_eq(if next == small { 0 } else { 1 }, 1)
  Test.assert_eq(heap_bin_head(heap, 16), small)
  Test.assert_eq(heap_free_node_size(small), 16)
  Test.assert_eq(heap_remaining(heap), 16)
  Test.assert_eq(if large != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_bin_reuse_lifo" {
  -- Same-class frees recycle LIFO through the bin without touching the
  -- overflow list or the bump pointer.
  let heap = heap_new(96)
  let a = heap_alloc(heap, 32, 8)
  let b = heap_alloc(heap, 32, 8)
  Test.assert_eq(heap_free(heap, a, 32), 0)
  Test.assert_eq(heap_free(heap, b, 32), 0)
  let r1 = heap_alloc(heap, 32, 8)
  let r2 = heap_alloc(heap, 32, 8)
  Test.assert_eq(r1, b)
  Test.assert_eq(r2, a)
  Test.assert_eq(heap_bin_head(heap, 32), 0)
  Test.assert_eq(heap_free_head(heap), 0)
  Test.assert_eq(heap_remaining(heap), 32)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_overflow_splits_large_free_node" {
  -- Blocks above the bin limit recycle through the best-fit overflow
  -- list, splitting the remainder back onto it.
  let heap = heap_new(1024)
  let big = heap_alloc(heap, 512, 8)
  let tail = heap_alloc(heap, 16, 8)
  Test.assert_eq(heap_free(heap, big, 512), 0)
  Test.assert_eq(heap_free_head(heap), big)
  let reused = heap_alloc(heap, 264, 8)
  Test.assert_eq(reused, big)
  let split = big + 264
  Test.assert_eq(heap_free_head(heap), split)
  Test.assert_eq(heap_free_node_size(split), 248)
  Test.assert_eq(if tail != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_overflow_scan_is_best_fit" {
  -- Doubling growth ladders free ascending sizes; a first-fit scan
  -- would shred the largest block for small requests and force an
  -- arena bump when the large size comes back. Best-fit must pick the
  -- SMALLEST adequate node: with 1024 and 512 free (1024 at the LIFO
  -- head), a 512-byte request takes the 512 block, leaving 1024 whole.
  let heap = heap_new(4096)
  let a = heap_alloc(heap, 1024, 8)
  let b = heap_alloc(heap, 512, 8)
  let tail = heap_alloc(heap, 16, 8)
  Test.assert_eq(heap_free(heap, b, 512), 0)
  Test.assert_eq(heap_free(heap, a, 1024), 0)
  Test.assert_eq(heap_free_head(heap), a)
  let small = heap_alloc(heap, 512, 8)
  Test.assert_eq(small, b)
  let large = heap_alloc(heap, 1024, 8)
  Test.assert_eq(large, a)
  Test.assert_eq(if tail != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_aligned_request_skips_bins" {
  let heap = heap_new(96)
  let p0 = heap_alloc(heap, 1, 1)
  let p1 = heap_alloc(heap, 1, 1)
  Test.assert_eq(heap_free(heap, p1, 1), 0)
  let q = heap_alloc(heap, 8, 32)
  Test.assert_eq(if q == p1 { 0 } else { 1 }, 1)
  Test.assert_eq(q % 32, 0)
  Test.assert_eq(q - p0, 32)
  Test.assert_eq(heap_bin_head(heap, 16), p1)
  Test.assert_eq(heap_free_node_size(p1), 16)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_invalid_and_overflow" {
  let heap = heap_new(32)
  -- Capacity is elastic (managed ownership): a request beyond the initial arena
  -- chains a larger arena instead of returning 0. The block must be
  -- real and writable; invalid arguments still fail below.
  let grown = heap_alloc(heap, 40, 8)
  Test.assert_eq(if grown != 0 { 1 } else { 0 }, 1)
  mem_store64_at(grown, 0, 77)
  Test.assert_eq(mem_load64_at(grown, 0), 77)
  Test.assert_eq(heap_alloc(heap, 0 - 1, 8), 0)
  Test.assert_eq(heap_alloc(0, 8, 8), 0)
  Test.assert_eq(heap_free(heap, 0, 8), 0 - 1)
  Test.assert_eq(heap_free(0, 1234, 8), 0 - 1)
  Test.assert_eq(heap_free(heap, 1234, 0 - 1), 0 - 1)
  Test.assert_eq(heap_destroy(0), 0 - 1)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_heap_alloc_growth_survives_churn" {
  -- Runtime lock: allocation churn far past the initial
  -- arena must chain arenas and keep every returned block usable —
  -- the pre-growth behavior was a null return and a caller SIGSEGV.
  let heap = heap_new(256)
  let mut i = 0
  let mut ok = 1
  while i < 2000 {
    let p = heap_alloc(heap, 64, 8)
    if p == 0 { ok = 0 } else {
      mem_store64_at(p, 0, i)
      if mem_load64_at(p, 0) != i { ok = 0 } else { 0 }
    }
    i = i + 1
  }
  Test.assert_eq(ok, 1)
}

test "runtime_heap_alloc_handles_alloc_effect" {
  let heap = heap_new(64)
  let got = handle heap_effect_reuse_program() {
    Alloc.alloc(size, align) -> resume(heap_alloc(heap, size, align))
    Alloc.free(ptr, size) -> resume(heap_free(heap, ptr, size))
  }
  Test.assert_eq(got, 0)
  Test.assert_eq(heap_free_head(heap), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}
