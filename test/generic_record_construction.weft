use stdlib/test.{Test}
use stdlib/string.{*}
use module_fixtures/generic_record_values as records
use runtime/rc.{rc_count}

type Packet<T> { value: T, tail: i64 }
type PairBox<A, B> { first: A, second: B }
type Marker<T> { tag: i64 }
type WideRecordIdentity = opaque (i64, i64, i64)
type DescribedRecord<T> { identity: T, description: str }
type NestedDescribedRecord<T> { row: DescribedRecord<T>, position: usize }
type DescribedRecordSet<T> { DescribedRecordSet(DescribedRecord<T>, DescribedRecord<T>, DescribedRecord<T>) }

fn wide_record_identity_total(value: WideRecordIdentity) -> i64 {
  match value { WideRecordIdentity((first, second, third)) -> first + second + third }
}

fn nested_described_record<T>(identity: T) -> NestedDescribedRecord<T> {
  NestedDescribedRecord {
    row: DescribedRecord { identity: identity, description: "retained".concat(" description") },
    position: 7
  }
}

fn described_record_set_last<T>(values: DescribedRecordSet<T>) -> DescribedRecord<T> {
  match values { DescribedRecordSet(first, second, third) -> third }
}

fn generic_described_record_description<T>(value: DescribedRecord<T>) -> str {
  value.description
}

fn generic_described_record_description_after_branch<T>(choose_left: bool, left: DescribedRecord<T>, right: DescribedRecord<T>) -> str {
  (if choose_left { left } else { right }).description
}

fn packet<T>(value: T) -> Packet<T> {
  Packet { value: value, tail: 7 }
}

fn marked<T>() -> Marker<T> {
  Marker { tag: 9 }
}

fn packet_value<T>(value: Packet<T>) -> T { value.value }

fn swap_fields<A, B>(first: A, second: B) -> PairBox<B, A> {
  PairBox { first: second, second: first }
}

fn packet_union_tail(value: Packet<i64 | str>) -> i64 { value.tail }

fn packet_slice_total(value: Packet<[i64]>) -> i64 {
  value.value[0] + value.value[1] + value.tail
}

test "record arguments infer from field values" {
  let value = Packet { value: 35, tail: 7 }
  Test.assert_eq(value.value + value.tail, 42)
}

test "explicit record arguments determine the field contract" {
  let value = Packet<i64> { value: 35, tail: 7 }
  Test.assert_eq(value.value + value.tail, 42)
}

test "record arguments retain enclosing generic identities" {
  let first = packet(35)
  let second = packet("hello".concat(" world"))
  Test.assert_eq(packet_value(first), 35)
  Test.assert_str_eq(packet_value(second), "hello world")
}

test "expected record types determine phantom arguments" {
  let first: Marker<i64> = Marker { tag: 12 }
  let second = marked<str>()
  Test.assert_eq(first.tag + second.tag, 21)
}

test "multiple record arguments preserve declaration order" {
  let value = PairBox { second: "hello".concat(" world"), first: 42 }
  Test.assert_eq(value.first, 42)
  Test.assert_str_eq(value.second, "hello world")
}

test "wide generic fields preserve later field offsets" {
  let value = packet((17, 18))
  Test.assert_eq(value.value.0 + value.value.1 + value.tail, 42)
}

test "generic records retain managed tuple lanes" {
  let value = packet(("left".concat(" lane"), "right".concat(" lane")))
  Test.assert_str_eq(value.value.0, "left lane")
  Test.assert_str_eq(value.value.1, "right lane")
  Test.assert_eq(value.tail, 7)
}

test "generic record arrays preserve copied storage" {
  let value = packet([11, 12, 12])
  Test.assert_eq(value.value[0] + value.value[1] + value.value[2] + value.tail, 42)
}

test "qualified record constructors preserve module identity" {
  let explicit = records.ForeignBox<str> { payload: "module".concat(" value"), tail: 2 }
  let inferred = records.ForeignBox { payload: 40, tail: 0 }
  Test.assert_str_eq(explicit.payload, "module value")
  Test.assert_eq(explicit.tail + inferred.payload, 42)
}

test "qualified expected record types solve phantom arguments" {
  let value: records.ForeignMarker<str> = records.ForeignMarker { tag: 42 }
  Test.assert_eq(value.tag, 42)
}

test "record and function parameters have independent substitutions" {
  let value = swap_fields(42, "second".concat(" field"))
  Test.assert_str_eq(value.first, "second field")
  Test.assert_eq(value.second, 42)
}

test "contextual record arguments preserve finite numeric types" {
  let value: Packet<u8> = Packet { value: 35, tail: 7 }
  let expected: u8 = 35
  Test.assert_true(value.value == expected)
  Test.assert_eq(value.tail, 7)
}

test "contextual record arguments admit declared union fields" {
  let value: Packet<i64 | str> = Packet { value: 42, tail: 7 }
  Test.assert_eq(packet_union_tail(value), 7)
}

test "generic record destruction releases managed fields exactly once" {
  let text = "retained".concat(" payload")
  {
    let value = packet((text, text))
    Test.assert_str_eq(value.value.0, text)
    Test.assert_str_eq(value.value.1, text)
    Test.assert_eq(rc_count(__str_ptr(text) - 16), 3)
  }
  Test.assert_eq(rc_count(__str_ptr(text) - 16), 1)
}

test "generic records preserve managed array cleanup" {
  let text = "array".concat(" element")
  {
    let value = packet([text, text])
    Test.assert_str_eq(value.value[0], text)
    Test.assert_str_eq(value.value[1], text)
    Test.assert_eq(rc_count(__str_ptr(text) - 16), 3)
  }
  Test.assert_eq(rc_count(__str_ptr(text) - 16), 1)
}

effect RecordStop { fn stop() -> never }

test "aborted generic construction releases completed field values" {
  let text = "partial".concat(" record")
  let result = handle {
    let value = Packet { value: text, tail: RecordStop.stop() }
    value.tail
  } {
    RecordStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(rc_count(__str_ptr(text) - 16), 1)
}

test "functional generic record updates preserve the original value" {
  let original = packet(("first".concat(" value"), 7))
  let changed = original.{value: ("second".concat(" value"), 42)}
  Test.assert_str_eq(original.value.0, "first value")
  Test.assert_eq(original.value.1, 7)
  Test.assert_str_eq(changed.value.0, "second value")
  Test.assert_eq(changed.value.1, 42)
  Test.assert_eq(changed.tail, 7)
}

test "generic records preserve floating point tuple lanes" {
  let value = packet((1.25, 2.5))
  Test.assert_eq_f64(value.value.0 + value.value.1, 3.75)
  Test.assert_eq(value.tail, 7)
}

test "nested generic records retain wide opaque identities" {
  let value = nested_described_record(WideRecordIdentity((11, 13, 18)))
  Test.assert_eq(wide_record_identity_total(value.row.identity), 42)
  Test.assert_str_eq(value.row.description, "retained description")
  Test.assert_eq_usize(value.position, 7)
}

test "generic variants retain records with wide opaque identities" {
  let values = DescribedRecordSet(
    DescribedRecord { identity: WideRecordIdentity((1, 2, 3)), description: "first" },
    DescribedRecord { identity: WideRecordIdentity((4, 5, 6)), description: "second" },
    DescribedRecord { identity: WideRecordIdentity((11, 13, 18)), description: "third" }
  )
  let selected = described_record_set_last(values)
  Test.assert_eq(wide_record_identity_total(selected.identity), 42)
  Test.assert_str_eq(selected.description, "third")
}

test "generic projections recompute offsets after wide substitution" {
  let left = DescribedRecord { identity: WideRecordIdentity((1, 2, 3)), description: "wide left" }
  let right = DescribedRecord { identity: WideRecordIdentity((4, 5, 6)), description: "wide right" }
  Test.assert_str_eq(generic_described_record_description(left), "wide left")
  Test.assert_str_eq(generic_described_record_description_after_branch(false, left, right), "wide right")
}

test "generic slice fields preserve their view and following field" {
  let values = [11, 17, 18, 99]
  let value = Packet { value: values[1..3], tail: 7 }
  Test.assert_eq_usize(value.value.len, 2)
  Test.assert_eq(packet_slice_total(value), 42)
  let empty = Packet<[i64]> { value: values[0..0], tail: 9 }
  Test.assert_eq_usize(empty.value.len, 0)
  Test.assert_eq(empty.tail, 9)
}
