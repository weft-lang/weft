-- test/loop_accumulator_register_metrics.weft -- native evidence for loop-carried scalar values in registers

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}

fn loop_accum_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  -- This suite measures the legacy AST loop-accumulator register optimiser.
  -- Typed-IR native loop CFG emission is covered in ir_optimizer_metrics; keep
  -- these legacy optimiser regressions pinned until typed IR owns the same loop
  -- specialisation facts.
  pipeline_lower_native_ir(typed)
}

fn loop_accum_metric_register(src: str) -> i64 {
  pipeline_native_loop_accumulator_register_count(loop_accum_metric_native(src))
}

fn loop_accum_metric_fp_call_clobber(src: str) -> i64 {
  pipeline_native_fp_register_call_clobber_reject_count(loop_accum_metric_native(src))
}

fn loop_accum_metric_fp_no_free(src: str) -> i64 {
  pipeline_native_fp_register_no_free_count(loop_accum_metric_native(src))
}

fn loop_accum_metric_fp_preserved(src: str) -> i64 {
  pipeline_native_fp_register_preserved_count(loop_accum_metric_native(src))
}

fn loop_accum_metric_fp_preserve_functions(src: str) -> i64 {
  pipeline_native_fp_preserve_function_count(loop_accum_metric_native(src))
}

test "loop_accumulator_register_metric_lowers_range_accumulator" {
  let src = "fn main(n: i64) -> i64 { let mut total = 0 for i in 0..n { total = total + i } total }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_lowers_branchy_range_counter" {
  let src = "fn main(n: i64) -> i64 { let mut count = 0 for i in 0..n { if i > 1 { count = count + 1 } else { 0 } } count }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_lowers_multiple_accumulators" {
  let src = "fn main(n: i64) -> i64 { let mut total = 0 let mut count = 0 while count < n { total = total + count count = count + 1 let marker = total marker } total + count }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_lowers_generic_while_update_not_last" {
  let src = "fn main(n: i64) -> i64 { let mut head = 0 while head < n { let seen = head head = head + 1 seen } head }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_keeps_non_simple_assignment_generic" {
  let src = "fn main(n: i64) -> i64 { let mut total = 0 for i in 0..n { total = i } total }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_keeps_shadowed_binding_generic" {
  let src = "fn main(n: i64) -> i64 { let mut total = 0 for i in 0..n { let total = i total } total }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_metric_lowers_f64_accumulator" {
  let src = "fn main(n: i64) -> f64 { let mut total: f64 = 0.0 for i in 0..n { total = total + 1.0 } total }"
  Test.assert_eq(loop_accum_metric_register(src), 1)
  Test.assert_eq(loop_accum_metric_fp_call_clobber(src), 0)
  Test.assert_eq(loop_accum_metric_fp_no_free(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 1)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 1)
}

test "loop_accumulator_register_metric_lowers_mandelbrot_style_f64_state" {
  let src = "fn main(n: i64) -> f64 { let mut zr: f64 = 0.0 let mut zi: f64 = 0.0 let mut mag2: f64 = 0.0 for i in 0..n { let zr2 = zr * zr let zi2 = zi * zi let next_zi = 2.0 * zr * zi let next_zr = zr2 - zi2 zi = next_zi + 0.5 zr = next_zr + 0.25 let mag_zr = zr * zr let mag_zi = zi * zi mag2 = mag_zr + mag_zi } mag2 }"
  Test.assert_eq(loop_accum_metric_register(src), 3)
}

test "loop_accumulator_register_metric_uses_preserved_f64_register_for_body_call" {
  -- Keep a real call boundary: ordinary scalar `x + 1.0` helpers now
  -- inline from their semantic FP-lane facts. Self-recursion is the
  -- optimiser's deliberate growth fence, so this still exercises the
  -- call-clobber path instead of accidentally becoming a no-call probe.
  let src = "fn step(x: f64) -> f64 { if x < 0.0 - 1000000.0 { step(x + 1.0) } else { x + 1.0 } } fn main(n: i64) -> f64 { let mut total: f64 = 0.0 for i in 0..n { total = step(total) } total }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
  Test.assert_eq(loop_accum_metric_fp_call_clobber(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 0)
}

test "loop_accumulator_register_metric_uses_preserved_f64_register_for_condition_call" {
  let src = "fn keep(i: i64, n: i64) -> bool { i < n } fn main(n: i64) -> f64 { let mut i = 0 let mut total: f64 = 0.0 while keep(i, n) { total = total + 1.0 i = i + 1 } total }"
  Test.assert_eq(loop_accum_metric_fp_call_clobber(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 1)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 1)
}

test "loop_accumulator_register_metric_uses_param_type_for_f64_preserve_prepass" {
  let src = "fn step(x: f64) -> f64 { if x < 0.0 - 1000000.0 { step(x + 1.0) } else { x + 1.0 } } fn main(n: i64, start: f64) -> f64 { let mut total = start for i in 0..n { total = step(total) } total }"
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 0)
}

test "loop_accumulator_register_metric_uses_capture_type_for_f64_preserve_prepass" {
  let src = "fn step(x: f64) -> f64 { if x < 0.0 - 1000000.0 { step(x + 1.0) } else { x + 1.0 } } fn main(n: i64, start: f64) -> f64 { let f = () => { let mut total = start for i in 0..n { total = step(total) } total } f() }"
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 0)
}

test "loop_accumulator_register_metric_does_not_preserve_fp_for_i64_call_loop" {
  let src = "fn step(x: i64) -> i64 { x + 1 } fn main(n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = step(total) i = i + 1 } total }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 0)
}

test "loop_accumulator_register_metric_does_not_preserve_fp_for_call_loop_without_f64_accumulator" {
  let src = "fn keep(i: i64, n: i64) -> bool { i < n } fn main(n: i64) -> i64 { let mut i = 0 while keep(i, n) { i = i + 1 } i }"
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserve_functions(src), 0)
}

test "loop_accumulator_register_metric_classifies_no_free_f64_fp_register" {
  let src = "fn main(n: i64) -> f64 { let mut a0: f64 = 0.0 let mut a1: f64 = 0.0 let mut a2: f64 = 0.0 let mut a3: f64 = 0.0 let mut a4: f64 = 0.0 let mut a5: f64 = 0.0 let mut a6: f64 = 0.0 let mut a7: f64 = 0.0 let mut a8: f64 = 0.0 for i in 0..n { a0 = a0 + 1.0 a1 = a1 + 1.0 a2 = a2 + 1.0 a3 = a3 + 1.0 a4 = a4 + 1.0 a5 = a5 + 1.0 a6 = a6 + 1.0 a7 = a7 + 1.0 a8 = a8 + 1.0 } a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 }"
  Test.assert_eq(loop_accum_metric_register(src), 8)
  Test.assert_eq(loop_accum_metric_fp_no_free(src), 0)
}

test "loop_accumulator_register_metric_classifies_no_free_preserved_f64_fp_register" {
  let src = "fn step(x: f64) -> f64 { if x < 0.0 - 1000000.0 { step(x + 1.0) } else { x + 1.0 } } fn main(n: i64) -> f64 { let mut a0: f64 = 0.0 let mut a1: f64 = 0.0 let mut a2: f64 = 0.0 let mut a3: f64 = 0.0 let mut a4: f64 = 0.0 let mut a5: f64 = 0.0 let mut a6: f64 = 0.0 let mut a7: f64 = 0.0 let mut a8: f64 = 0.0 for i in 0..n { a0 = step(a0) a1 = step(a1) a2 = step(a2) a3 = step(a3) a4 = step(a4) a5 = step(a5) a6 = step(a6) a7 = step(a7) a8 = step(a8) } a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
  Test.assert_eq(loop_accum_metric_fp_no_free(src), 0)
  Test.assert_eq(loop_accum_metric_fp_preserved(src), 0)
}

test "loop_accumulator_register_metric_keeps_shadowed_f64_binding_generic" {
  let src = "fn main(n: i64) -> f64 { let mut total: f64 = 0.0 for i in 0..n { let mut total: f64 = 1.0 total = total + 1.0 } total }"
  Test.assert_eq(loop_accum_metric_register(src), 1)
}

test "loop_accumulator_register_metric_keeps_no_free_pinned_register_generic" {
  let src = "fn main(n: i64) -> i64 { let a = 1 let b = 2 let c = 3 let d = 4 let e = 5 let f = 6 let g = 7 let h = 8 let mut total = 0 while total < n { total = total + 1 let seen = total seen } total + a + b + c + d + e + f + g + h }"
  Test.assert_eq(loop_accum_metric_register(src), 0)
}

test "loop_accumulator_register_runtime_range_sum" {
  let mut total = 0
  for i in 0..6 {
    total = total + i
  }
  Test.assert_eq(total, 15)
}

test "loop_accumulator_register_runtime_branchy_count" {
  let mut count = 0
  for i in 0..5 {
    if i > 1 {
      count = count + 1
    } else { 0 }
  }
  Test.assert_eq(count, 3)
}

test "loop_accumulator_register_runtime_while_update_not_last" {
  let mut head = 0
  while head < 4 {
    let seen = head
    head = head + 1
    seen
  }
  Test.assert_eq(head, 4)
}

test "loop_accumulator_register_runtime_break_stores_final_value" {
  let mut total = 0
  while total < 10 {
    total = total + 1
    if total == 3 { break } else { 0 }
  }
  Test.assert_eq(total, 3)
}

test "loop_accumulator_register_runtime_f64_range_sum" {
  let mut total: f64 = 0.0
  for i in 0..4 {
    total = total + 0.5
  }
  Test.assert_eq(if total == 2.0 { 1 } else { 0 }, 1)
}

test "loop_accumulator_register_runtime_f64_break_stores_final_value" {
  let mut total: f64 = 0.0
  for i in 0..5 {
    total = total + 1.5
    if i == 2 { break } else { 0 }
  }
  Test.assert_eq(if total == 4.5 { 1 } else { 0 }, 1)
}

fn loop_accum_runtime_f64_step(x: f64) -> f64 {
  x + 0.5
}

fn loop_accum_runtime_f64_inner_step(x: f64) -> f64 {
  x + 0.25
}

fn loop_accum_runtime_f64_nested_inner(n: i64) -> f64 {
  let mut total: f64 = 0.0
  for i in 0..n {
    total = loop_accum_runtime_f64_inner_step(total)
  }
  total
}

test "loop_accumulator_register_runtime_f64_call_preserved_register_stays_correct" {
  let mut total: f64 = 0.0
  for i in 0..4 {
    total = loop_accum_runtime_f64_step(total)
  }
  Test.assert_eq(if total == 2.0 { 1 } else { 0 }, 1)
}

test "loop_accumulator_register_runtime_lambda_f64_preserved_register_stays_correct" {
  let f = () => {
    let mut total: f64 = 0.0
    for i in 0..4 {
      total = loop_accum_runtime_f64_step(total)
    }
    total
  }
  Test.assert_eq(if f() == 2.0 { 1 } else { 0 }, 1)
}

test "loop_accumulator_register_runtime_nested_f64_preserved_registers_survive_calls" {
  let mut total: f64 = 0.0
  for i in 0..3 {
    total = total + loop_accum_runtime_f64_nested_inner(2)
  }
  Test.assert_eq(if total == 1.5 { 1 } else { 0 }, 1)
}
