use compiler/weft/grammar.{WeftParser, ParsedWeftSource}
use compiler/weft/syntax/declarations.{*}
use compiler/weft/syntax/primitives.{primitive_type_expr}
use compiler/project/module.{
  DeclVisibility,
  PrivateVisibility,
  PackageVisibility,
  PublicVisibility
}
use compiler/weft/check/declarations as declarations
use compiler/weft/check/table.{ttable_new, ttable_entry_at}
use compiler/source/input.{source_from_text}
use compiler/ir/data.{*}
use compiler/types/algebra.{PRIM_I64, PRIM_NIL, PRIM_STR}
use module_fixtures/compiler_probe.{probe_check_source}
use compiler/weft/products.{TypedModule}
use stdlib/grammar.{Grammar, Parsed, Recovered}
use stdlib/diagnostic/schema.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option}
use stdlib/string.{int_to_str, str_concat}
use stdlib/panic.{panic}
use stdlib/state as state

fn parse(text: str) -> (ParsedWeftSource, List<Diagnostic>) {
  let (result, diagnostics) = state.run(
    Nil<Diagnostic>(),
    () => handle WeftParser().parse(source_from_text(text).all()) {
      Diagnose.report(diagnostic) -> {
        state.modify((items: List<Diagnostic>) => Cons(diagnostic, items))
        resume(0)
      }
      Diagnose.error(message, location) -> resume(0)
      Diagnose.warn(message, location) -> resume(0)
      Diagnose.note(message, location) -> resume(0)
    }
  )
  match result {
    Parsed(syntax) -> (syntax, diagnostics.reverse())
    Recovered(syntax) -> (syntax, diagnostics.reverse())
    _ -> panic("expected retained declaration syntax")
  }
}

fn text_at(syntax: ParsedWeftSource, range: TypeNameRange) -> str {
  syntax.source.source().text.slice(
    __i64_to_usize(range.start),
    __i64_to_usize(range.start + range.length)
  ).unwrap()
}

fn record_fields(syntax: ParsedWeftSource) -> List<RecordFieldSyntax> {
  match syntax.declarations.declarations.first().unwrap().syntax {
    TypeDefinition(RecordSyntax(_, _, fields)) -> fields
    _ -> panic("expected record fields")
  }
}

fn variant_members(syntax: ParsedWeftSource) -> List<VariantMemberSyntax> {
  match syntax.declarations.declarations.first().unwrap().syntax {
    TypeDefinition(VariantSyntax(_, _, members)) -> members
    _ -> panic("expected variant members")
  }
}

fn alias_target(syntax: ParsedWeftSource) -> TypeExpr {
  match syntax.declarations.declarations.first().unwrap().syntax {
    TypeDefinition(AliasSyntax(_, _, target)) -> target
    _ -> panic("expected type alias")
  }
}

fn function_body(syntax: ParsedWeftSource) -> Expr {
  match syntax.declarations.declarations.first().unwrap().syntax {
    FunctionDefinition(function) -> function.body
    _ -> panic("expected function declaration")
  }
}

fn function_syntax(syntax: ParsedWeftSource) -> FunctionSyntax {
  match syntax.declarations.declarations.first().unwrap().syntax {
    FunctionDefinition(function) -> function
    _ -> panic("expected function declaration")
  }
}

fn qualified_typed_constructor_pattern(
  syntax: ParsedWeftSource,
  pattern: Pattern
) -> bool {
  match pattern {
    CtorPattern(_, _, PatternListCons(TypedBinding(_, _, PrimitiveTypeExpr(primitive)),
      PatternListNil), _, qualifier: TypeNameRange) ->
      primitive == PRIM_I64() and text_at(syntax, qualifier) == "pkg"
    _ -> false
  }
}

fn nested_record_pattern(pattern: Pattern) -> bool {
  match pattern {
    RecordPattern(PatternFieldListCons(PatternField(_, _, Binding(_, _), _),
      PatternFieldListCons(PatternField(_, _, TuplePattern(items), _), PatternFieldListNil))) ->
      match items {
        PatternListCons(Binding(_, _), PatternListCons(Binding(_, _), PatternListNil)) -> true
        _ -> false
      }
    _ -> false
  }
}

test "authored functions retain typed expression syntax before checking" {
  let (syntax, diagnostics) = parse(
    "fn choose(flag: bool) -> i64 { let values = [1, 2] if flag { values[0] } else { values[1] } }"
  )
  Test.assert_true(diagnostics.is_empty())
  let body = function_body(syntax)
  Test.assert_eq(expr_tree_unknown_count(body), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(body), 0)
  Test.assert_true(
    match body {
      Let(_, _, ArrayLiteral(ExprListCons(IntLit(1, _, _),
        ExprListCons(IntLit(2, _, _), ExprListNil)), _, _),
        If(Ident(_, _), IndexedGet(Ident(_, _), IntLit(0, _, _), _, _),
        IndexedGet(Ident(_, _), IntLit(1, _, _), _, _))) -> true
      _ -> false
    }
  )
}

test "authored function and lambda signatures retain typed parameters" {
  let source = str_concat(
    "fn apply<T, E>(_ value: T, external local: str, count: i64) ",
    "-[State<T>, E]> T { (left: i64, right: str) => left }"
  )
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  let function = function_syntax(syntax)
  Test.assert_eq(param_list_len(function.params), 3)
  Test.assert_eq(param_list_tree_raw_bridge_slot_count(function.params), 0)
  Test.assert_eq(param_list_tree_unknown_count(function.params), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(function.result), 0)
  Test.assert_eq(type_expr_tree_unknown_count(function.result), 0)
  Test.assert_eq(effect_sig_tree_raw_bridge_slot_count(function.effects), 0)
  Test.assert_eq(effect_sig_tree_unknown_count(function.effects), 0)
  Test.assert_true(
    match function.params {
      ParamListCons(Param(_, _, VariableTypeExpr(_), PositionalParamLabel),
        ParamListCons(Param(_, _, PrimitiveTypeExpr(text_primitive),
        ExplicitParamLabel(label_start, label_length)),
        ParamListCons(Param(_, _, PrimitiveTypeExpr(count_primitive), ImplicitParamLabel),
        ParamListNil))) ->
        text_primitive == PRIM_STR() and count_primitive == PRIM_I64() and
        text_at(
          syntax,
          TypeNameRange { start: label_start, length: label_length }
        ) == "external"
      _ -> false
    }
  )
  Test.assert_true(match function.result { VariableTypeExpr(_) -> true, _ -> false })
  Test.assert_true(
    match function.effects {
      EffectSig(TypeExprListCons(UnqualifiedEffectTypeExpr(_, TypeExprListCons(
        VariableTypeExpr(_), TypeExprListNil, _), range), TypeExprListNil, _), tail) ->
        text_at(syntax, range) == "State" and tail > 0
      _ -> false
    }
  )
  Test.assert_true(
    match function.body {
      Lambda(params, Ident(_, _), _) ->
        param_list_len(params) == 2 and param_list_tree_raw_bridge_slot_count(params) == 0 and
        param_list_tree_unknown_count(params) == 0 and match params {
          ParamListCons(Param(_, _, PrimitiveTypeExpr(first), ImplicitParamLabel),
            ParamListCons(Param(_, _, PrimitiveTypeExpr(second), ImplicitParamLabel),
            ParamListNil)) -> first == PRIM_I64() and second == PRIM_STR()
          _ -> false
        }
      _ -> false
    }
  )
}

test "effect and trait signatures remain typed before registration" {
  let source = str_concat(
    "effect Await<T> { fn visible(_ value: T, label text: str) -> T } ",
    "trait Show { type Item fn show(self, _ prefix: str) -[Log]> str }"
  )
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  match syntax.declarations.declarations.get(0).unwrap().syntax {
    EffectDefinition(effect_syntax) -> match effect_syntax.operations.first().unwrap().operation {
      TypeEffectOp(_, _, params, VariableTypeExpr(_)) -> {
        Test.assert_eq(param_list_len(params), 2)
        Test.assert_eq(param_list_tree_raw_bridge_slot_count(params), 0)
        Test.assert_eq(param_list_tree_unknown_count(params), 0)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match syntax.declarations.declarations.get(1).unwrap().syntax {
    TraitDefinition(trait_syntax) -> {
      Test.assert_eq(type_trait_member_list_tree_raw_bridge_slot_count(trait_syntax.members), 0)
      Test.assert_eq(type_trait_member_list_tree_unknown_count(trait_syntax.members), 0)
      Test.assert_true(
        match trait_syntax.members {
          TypeTraitMemberListCons(TypeTraitAssocType(_, _, _),
            TypeTraitMemberListCons(TypeTraitMethod(_, _, params,
            PrimitiveTypeExpr(primitive), effects), TypeTraitMemberListNil)) ->
            primitive == PRIM_STR() and param_list_len(params) == 2 and
            match params {
              ParamListCons(Param(_, _, VariableTypeExpr(identity), ImplicitParamLabel),
                ParamListCons(Param(_, _, PrimitiveTypeExpr(prefix), PositionalParamLabel),
                ParamListNil)) -> identity == - 1 and prefix == PRIM_STR() and
                effect_sig_count_or(effects, - 1) == 1
              _ -> false
            }
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "module handler signatures and clauses remain typed before registration" {
  let source = str_concat(
    "implements Read(_ seed: i64, label name: str) { ",
    "Read.get(_ key: str) -> resume(seed) }"
  )
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  match syntax.declarations.declarations.first().unwrap().syntax {
    HandlerDefinition(handler) -> {
      Test.assert_eq(param_list_len(handler.params), 2)
      Test.assert_eq(param_list_tree_raw_bridge_slot_count(handler.params), 0)
      Test.assert_eq(param_list_tree_unknown_count(handler.params), 0)
      Test.assert_eq(handler_clause_list_tree_raw_bridge_slot_count(handler.clauses), 0)
      Test.assert_eq(handler_clause_list_tree_unknown_count(handler.clauses), 0)
    }
    _ -> Test.assert_true(false)
  }
}

test "type parameters retain typed bounds and where clauses before checking" {
  let source = str_concat(
    "fn pick<T: Show, U: Collector & {type Item = T}>(value: T, other: U) -> T ",
    "where T: api.Gauge & Show { value }"
  )
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  let function = function_syntax(syntax)
  Test.assert_eq(type_param_list_len(function.type_params), 2)
  Test.assert_eq(type_param_list_tree_raw_bridge_slot_count(function.type_params), 0)
  Test.assert_eq(type_param_list_tree_unknown_count(function.type_params), 0)
  Test.assert_eq(type_param_list_nth_var_id_or(function.type_params, 0, - 1), 0)
  Test.assert_eq(type_param_list_nth_var_id_or(function.type_params, 1, - 1), 1)
  Test.assert_str_eq(text_at(syntax, type_param_name_range(function.type_params, 0)), "T")
  Test.assert_str_eq(text_at(syntax, type_param_name_range(function.type_params, 1)), "U")
  -- The where clause replaces the inline bound of T with the authored list.
  Test.assert_true(
    match type_param_bounds(type_param_list_nth(function.type_params, 0)) {
      TypeParamBoundListCons(QualifiedTraitTypeExpr(module_range, gauge_range),
        first_location: TypeNameRange,
        TypeParamBoundListCons(UnqualifiedTraitTypeExpr(_, show_range),
        second_location: TypeNameRange, TypeParamBoundListNil)) ->
        text_at(syntax, module_range) == "api" and text_at(syntax, gauge_range) == "Gauge" and
        text_at(syntax, first_location) == "api.Gauge" and
        text_at(syntax, show_range) == "Show" and text_at(syntax, second_location) == "Show"
      _ -> false
    }
  )
  -- The constraint block attaches to the preceding bound and resolves the
  -- earlier type parameter.
  Test.assert_true(
    match type_param_bounds(type_param_list_nth(function.type_params, 1)) {
      TypeParamBoundListCons(ConstraintTypeExpr(UnqualifiedTraitTypeExpr(_, trait_range),
        TypeExprListCons(AssociatedBindingTypeExpr(_, VariableTypeExpr(item), item_range),
        TypeExprListNil, _)), location: TypeNameRange, TypeParamBoundListNil) ->
        text_at(syntax, trait_range) == "Collector" and item == 0 and
        text_at(syntax, item_range) == "Item" and text_at(syntax, location) == "Collector"
      _ -> false
    }
  )
  Test.assert_true(
    match function.params {
      ParamListCons(Param(_, _, VariableTypeExpr(first), _),
        ParamListCons(Param(_, _, VariableTypeExpr(second), _), ParamListNil)) ->
        first == 0 and second == 1
      _ -> false
    }
  )
  Test.assert_true(
    match function.result { VariableTypeExpr(identity) -> identity == 0, _ -> false }
  )
}

fn type_param_name_range(params: TypeParamList, index: i64) -> TypeNameRange {
  match type_param_list_nth(params, index) {
    TypeParam(start, length, _, _) -> TypeNameRange { start: start, length: length }
    MissingTypeParam -> panic("expected a type parameter")
  }
}

test "generic impl methods scope outer and own type parameters before checking" {
  let source = str_concat(
    "impl<T> Box<T> { fn map<U>(self, other: U) -> U where T: Show, U: Show { other } } ",
    "impl<T> api.Gauge for unique Box<T> { fn read(self) -> i64 { 0 } } "
  ).concat("impl Gauge for Box<i64> { fn read(self) -> i64 { 0 } }")
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  match syntax.declarations.declarations.get(0).unwrap().syntax {
    ImplDefinition(implementation) -> {
      Test.assert_str_eq(text_at(syntax, implementation.name), "Box")
      -- A method where clause binds the method's own view, never the impl's.
      Test.assert_eq(type_param_list_len(implementation.type_params), 1)
      Test.assert_eq(type_param_list_nth_bound_count_or(implementation.type_params, 0, - 1), 0)
      Test.assert_eq(type_impl_target_tree_raw_bridge_slot_count(implementation.target), 0)
      Test.assert_eq(type_impl_target_tree_unknown_count(implementation.target), 0)
      Test.assert_true(
        match implementation.target.protocol { InherentTypeImpl -> true, _ -> false }
      )
      Test.assert_true(
        match implementation.target.target {
          NamedTypeExpr(_, _, TypeExprListCons(VariableTypeExpr(identity), TypeExprListNil, _), _) ->
            identity == 0
          _ -> false
        }
      )
      match implementation.members.first().unwrap() {
        ImplMethod(method, _) -> {
          Test.assert_eq(type_param_list_len(method.type_params), 2)
          Test.assert_eq(type_param_list_nth_var_id_or(method.type_params, 0, - 1), 0)
          Test.assert_eq(type_param_list_nth_var_id_or(method.type_params, 1, - 1), 1)
          Test.assert_eq(type_param_list_nth_bound_count_or(method.type_params, 0, - 1), 1)
          Test.assert_eq(type_param_list_nth_bound_count_or(method.type_params, 1, - 1), 1)
          Test.assert_true(
            match method.params {
              ParamListCons(Param(_, _, VariableTypeExpr(receiver), _),
                ParamListCons(Param(_, _, VariableTypeExpr(other), _), ParamListNil)) ->
                receiver == - 1 and other == 1
              _ -> false
            }
          )
          Test.assert_true(
            match method.result { VariableTypeExpr(identity) -> identity == 1, _ -> false }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  match syntax.declarations.declarations.get(1).unwrap().syntax {
    ImplDefinition(implementation) -> {
      Test.assert_str_eq(text_at(syntax, implementation.name), "Box")
      Test.assert_true(
        match implementation.target.protocol {
          QualifiedTypeImpl(_, module_range, trait_range) ->
            text_at(syntax, module_range) == "api" and text_at(syntax, trait_range) == "Gauge"
          _ -> false
        }
      )
      Test.assert_true(
        match implementation.target.target {
          UniqueTypeExpr(NamedTypeExpr(_, _, TypeExprListCons(VariableTypeExpr(identity),
            TypeExprListNil, _), _)) -> identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match syntax.declarations.declarations.get(2).unwrap().syntax {
    ImplDefinition(implementation) -> {
      Test.assert_eq(type_param_list_len(implementation.type_params), 0)
      Test.assert_true(
        match implementation.target.protocol {
          UnqualifiedTypeImpl(_, trait_range) -> text_at(syntax, trait_range) == "Gauge"
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "effect type and handler declarations resolve their own type parameters" {
  let source = str_concat(
    "effect Ask<A> { fn ask() -> A } type Box<T> { value: T } type Choice<T> { Some(T), None } ",
    "type Id<T> = opaque T type Same<T> = Box<T> "
  ).concat("implements<T> Ask<T>(_ seed: T) { Ask.ask(_ key: T) -> resume(seed) }")
  let (syntax, diagnostics) = parse(source)
  Test.assert_true(diagnostics.is_empty())
  let declarations = syntax.declarations.declarations
  Test.assert_eq_usize(declarations.len(), 6)
  match declarations.get(0).unwrap().syntax {
    EffectDefinition(effect_syntax) -> {
      Test.assert_eq(type_param_list_len(effect_syntax.type_params), 1)
      Test.assert_true(
        match effect_syntax.operations.first().unwrap().operation {
          TypeEffectOp(_, _, ParamListNil, VariableTypeExpr(identity)) -> identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match declarations.get(1).unwrap().syntax {
    TypeDefinition(RecordSyntax(_, params, fields)) -> {
      Test.assert_eq(type_param_list_len(params), 1)
      Test.assert_true(
        match fields.first().unwrap().annotation {
          VariableTypeExpr(identity) -> identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match declarations.get(2).unwrap().syntax {
    TypeDefinition(VariantSyntax(_, params, members)) -> {
      Test.assert_eq(type_param_list_len(params), 1)
      Test.assert_true(
        match members.first().unwrap().payloads.first().unwrap() {
          VariableTypeExpr(identity) -> identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match declarations.get(3).unwrap().syntax {
    TypeDefinition(OpaqueSyntax(_, params, representation)) -> {
      Test.assert_eq(type_param_list_len(params), 1)
      Test.assert_true(
        match representation { VariableTypeExpr(identity) -> identity == 0, _ -> false }
      )
    }
    _ -> Test.assert_true(false)
  }
  match declarations.get(4).unwrap().syntax {
    TypeDefinition(AliasSyntax(_, params, target)) -> {
      Test.assert_eq(type_param_list_len(params), 1)
      Test.assert_true(
        match target {
          NamedTypeExpr(_, _, TypeExprListCons(VariableTypeExpr(identity), TypeExprListNil, _), _) ->
            identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  match declarations.get(5).unwrap().syntax {
    HandlerDefinition(handler) -> {
      Test.assert_eq(type_param_list_len(handler.type_params), 1)
      Test.assert_true(
        match handler.effect_reference {
          GenericCall(TypeExprListCons(VariableTypeExpr(identity), TypeExprListNil, _),
            Ident(_, _)) -> identity == 0
          _ -> false
        }
      )
      Test.assert_true(
        match handler.params {
          ParamListCons(Param(_, _, VariableTypeExpr(identity), _), ParamListNil) -> identity == 0
          _ -> false
        }
      )
      Test.assert_true(
        match handler.clauses {
          HandlerClauseListCons(HandlerClause(_, ParamListCons(Param(_, _,
            VariableTypeExpr(identity), _), ParamListNil), _, _), HandlerClauseListNil) ->
            identity == 0
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "type parameter diagnostics retain messages and the following declaration" {
  for sample in [
    ("fn f<T: >(x: T) -> T { x }", "expected trait name after type-parameter ':'"),
    ("fn f<T: Show & >(x: T) -> T { x }", "expected trait name after '&'"),
    ("fn f<T U>(x: T) -> T { x }", "expected ',' or '>' after type parameter"),
    ("fn f<T, 12>(x: T) -> T { x }", "expected type parameter name or '>'"),
    (
      "fn f<T: Show & {type Item = i64} & {type Item = str}>(x: T) -> T { x }",
      "duplicate associated-type constraint block"
    ),
    (
      "fn f<T: Show & {Item = i64}>(x: T) -> T { x }",
      "expected 'type' in associated-type constraint"
    ),
    (
      "fn f<T: Show & {type = i64}>(x: T) -> T { x }",
      "expected associated type name after 'type'"
    ),
    (
      "fn f<T: Show & {type Item i64}>(x: T) -> T { x }",
      "expected '=' after associated type name"
    ),
    (
      "fn f<T: Show & {type Item = }>(x: T) -> T { x }",
      "expected type after associated-type '='"
    ),
    (
      "fn f<T: Show & {type Item = i64 type}>(x: T) -> T { x }",
      "expected ',' or '}' after associated-type constraint"
    )
  ] {
    let source = sample.0.concat("\nfn following() -> i64 { 42 }")
    let (syntax, diagnostics) = parse(source)
    Test.assert_true(not diagnostics.is_empty())
    Test.assert_str_eq(diagnostics.first().unwrap().message(), sample.1)
    let declarations = syntax.declarations.declarations
    let following = declarations.get(declarations.len() - __i64_to_usize(1)).unwrap()
    Test.assert_true(match following.validity { ParsedDeclaration -> true, _ -> false })
    Test.assert_str_eq(text_at(syntax, following.range), "fn following() -> i64 { 42 }")
  }
}

test "declaration visibility diagnostics retain messages and recover" {
  for sample in [
    ("pub(crate) fn f() -> i64 { 1 }", "expected 'pub(package)'"),
    (
      "pub(package) effect E { pub fn op() -> i64 }",
      "effect operation visibility cannot exceed effect visibility"
    ),
    ("trait T { pub fn m(self) -> i64 }", "trait members inherit trait visibility"),
    (
      "pub impl Box { fn m(self) -> i64 { 1 } }",
      "visibility belongs on inherent methods, not an impl block"
    ),
    (
      "impl Show for Box { pub fn show(self) -> i64 { 1 } }",
      "trait impl methods inherit trait visibility"
    ),
    (
      "impl Iter for Box { pub type Item = i64 }",
      "associated type bindings cannot have visibility"
    ),
    ("pub test \"named\" { 1 }", "test declarations cannot have visibility"),
    ("pub default handler local<i64>()", "default handler declarations cannot have visibility")
  ] {
    let source = sample.0.concat("\nfn following() -> i64 { 42 }")
    let (syntax, diagnostics) = parse(source)
    Test.assert_true(not diagnostics.is_empty())
    Test.assert_str_eq(diagnostics.first().unwrap().message(), sample.1)
    let declarations = syntax.declarations.declarations
    let following = declarations.get(declarations.len() - __i64_to_usize(1)).unwrap()
    Test.assert_true(match following.validity { ParsedDeclaration -> true, _ -> false })
    Test.assert_str_eq(text_at(syntax, following.range), "fn following() -> i64 { 42 }")
  }
}

fn effect_operation_visibilities(syntax: ParsedWeftSource) -> List<DeclVisibility> {
  match syntax.declarations.declarations.first().unwrap().syntax {
    EffectDefinition(effect_syntax) ->
      effect_syntax.operations.map((operation: EffectOperationSyntax) => operation.visibility)
    _ -> panic("expected effect declaration")
  }
}

test "effect operation visibility inherits from and is capped by the effect" {
  let (inherited, quiet) = parse("effect E { fn op() -> i64 pub fn wide() -> i64 }")
  Test.assert_eq_usize(quiet.len(), 1)
  Test.assert_true(
    match effect_operation_visibilities(inherited) {
      Cons(PrivateVisibility, Cons(PrivateVisibility, Nil)) -> true
      _ -> false
    }
  )
  let (narrowed, none) = parse(
    "pub effect E { fn op() -> i64 pub(package) fn shared() -> i64 pub fn open() -> i64 }"
  )
  Test.assert_true(none.is_empty())
  Test.assert_true(
    match effect_operation_visibilities(narrowed) {
      Cons(PublicVisibility, Cons(PackageVisibility, Cons(PublicVisibility, Nil))) -> true
      _ -> false
    }
  )
  let (capped, one) = parse("pub(package) effect E { pub fn wide() -> i64 }")
  Test.assert_eq_usize(one.len(), 1)
  Test.assert_true(
    match effect_operation_visibilities(capped) {
      Cons(PackageVisibility, Nil) -> true
      _ -> false
    }
  )
}

fn interp_display_count(expr: Expr) -> i64 {
  match expr {
    InterpConcat(left, right) -> interp_display_count(left) + interp_display_count(right)
    InterpDisplay(operand) -> 1 + interp_display_count(operand)
    BinOp(_, left, right) -> interp_display_count(left) + interp_display_count(right)
    _ -> 0
  }
}

fn interp_perform_count(expr: Expr) -> i64 {
  match expr {
    InterpConcat(left, right) -> interp_perform_count(left) + interp_perform_count(right)
    InterpDisplay(operand) -> interp_perform_count(operand)
    Perform(_, _, _, _) -> 1
    _ -> 0
  }
}

test "interpolated strings retain typed display renderings before checking" {
  let (syntax, diagnostics) = parse(
    "fn greet(name: str, count: i64) -> str { i\"hi {name}: {count + 1}!\" }"
  )
  Test.assert_true(diagnostics.is_empty())
  let body = function_body(syntax)
  Test.assert_eq(interp_display_count(body), 2)
  Test.assert_eq(interp_perform_count(body), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(body), 0)
  Test.assert_eq(expr_tree_unknown_count(body), 0)
  Test.assert_true(
    match body {
      InterpConcat(InterpConcat(InterpConcat(StringLit(_, _, _, _), InterpDisplay(Ident(_, _))),
        InterpConcat(StringLit(_, _, _, _),
        InterpDisplay(BinOp(_, Ident(_, _), IntLit(_, _, _))))), StringLit(_, _, _, _)) -> true
      _ -> false
    }
  )
}

test "primitive type spellings resolve through one syntax table" {
  for sample in [
    ("i64", PRIM_I64()),
    ("str", PRIM_STR()),
    ("String", PRIM_STR()),
    ("nil", PRIM_NIL()),
    ("Nil", PRIM_NIL())
  ] {
    Test.assert_true(
      match primitive_type_expr(__str_ptr(sample.0), 0, __str_len(sample.0)) {
        PrimitiveTypeExpr(primitive) -> primitive == sample.1
        _ -> false
      }
    )
  }
  Test.assert_true(
    match primitive_type_expr(__str_ptr("never"), 0, 5) { NeverTypeExpr -> true, _ -> false }
  )
  Test.assert_true(
    match primitive_type_expr(__str_ptr("any"), 0, 3) { AnyTypeExpr -> true, _ -> false }
  )
  for spelled in ["Point", "i6", "I64", "", "strs"] {
    Test.assert_true(
      match primitive_type_expr(__str_ptr(spelled), 0, __str_len(spelled)) {
        MissingTypeExpr -> true
        _ -> false
      }
    )
  }
}

test "authored match arms retain recursive typed patterns before checking" {
  let (syntax, diagnostics) = parse(
    "fn choose(value: any) -> i64 { match value { pkg.Some(item: i64) -> item, {left, right: (a, b)} -> a, _ -> 0 } }"
  )
  Test.assert_true(diagnostics.is_empty())
  let body = function_body(syntax)
  Test.assert_eq(expr_tree_unknown_count(body), 0)
  Test.assert_eq(expr_tree_raw_bridge_slot_count(body), 0)
  Test.assert_true(
    match body {
      Match(_, MatchArmListCons(first, MatchArmListCons(second,
        MatchArmListCons(third, MatchArmListNil))), ExplicitMatch) ->
        qualified_typed_constructor_pattern(syntax, match_arm_pattern(first)) and
        nested_record_pattern(match_arm_pattern(second)) and
        match match_arm_pattern(third) { Wildcard -> true, _ -> false }
      _ -> false
    }
  )
}

test "default handlers retain dedicated configuration syntax" {
  let (syntax, diagnostics) = parse("default handler local<i64>()")
  Test.assert_true(diagnostics.is_empty())
  match syntax.declarations.declarations.first().unwrap().syntax {
    DefaultHandlerDefinition(default) -> match default.configuration {
      HandlerConfiguration(_, _,
        TypeExprListCons(PrimitiveTypeExpr(primitive), TypeExprListNil, _), ExprListNil) ->
        Test.assert_eq(primitive, PRIM_I64())
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "authored aliases retain the complete typed type algebra" {
  let (syntax, diagnostics) = parse(authored_type_algebra_source())
  if not diagnostics.is_empty() { panic("unexpected parser diagnostic") }
  let target = alias_target(syntax)
  if type_expr_tree_raw_bridge_slot_count(target) != 0 { panic("raw type bridge") }
  if type_expr_tree_unknown_count(target) != 0 { panic("unknown typed node") }
  match target {
    FunctionTypeExpr(params, IntersectionTypeExpr(VariableTypeExpr(_),
      ComplementTypeExpr(PrimitiveTypeExpr(nil_primitive))), EffectSetTypeExpr(effects, tail)) ->
      {
        if nil_primitive != PRIM_NIL() { panic("wrong nil primitive") }
        if type_expr_list_len(params) != 8 { panic("wrong parameter count") }
        Test.assert_true(
          match type_expr_list_nth(params, 0) {
            PointerTypeExpr(VariableTypeExpr(_), MutableTypeAccess) -> true
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 1) {
            BorrowTypeExpr(VariableTypeExpr(_), MutableTypeAccess) -> true
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 2) { WeakTypeExpr(_) -> true, _ -> false }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 3) { AtomicTypeExpr(_) -> true, _ -> false }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 4) {
            UniqueTypeExpr(ArrayTypeExpr(PrimitiveTypeExpr(primitive), 4)) ->
              primitive == PRIM_STR()
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 5) {
            OwnedTypeExpr(VariableTypeExpr(_)) -> true
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 6) {
            NamedTypeExpr(_, _, TypeExprListCons(VariableTypeExpr(_), TypeExprListNil,
              location: TypeNameRange), SourceTypeOrigin(name)) ->
              text_at(syntax, name) == "Box" and text_at(syntax, location) == "T"
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(params, 7) {
            UnionTypeExpr(SourceAssociatedTypeExpr(_, _, range), PrimitiveTypeExpr(primitive)) ->
              text_at(syntax, range) == "api.Box<T>.Item" and primitive == PRIM_NIL()
            _ -> false
          }
        )
        Test.assert_eq(type_expr_list_len(effects), 2)
        Test.assert_true(tail > 0)
        Test.assert_true(
          match type_expr_list_nth(effects, 0) {
            UnqualifiedEffectTypeExpr(_, TypeExprListCons(VariableTypeExpr(_), TypeExprListNil, _),
              range) -> text_at(syntax, range) == "State"
            _ -> false
          }
        )
        Test.assert_true(
          match type_expr_list_nth(effects, 1) {
            QualifiedEffectTypeExpr(module, name,
              TypeExprListCons(PrimitiveTypeExpr(primitive), TypeExprListNil, _)) ->
              text_at(syntax, module) == "api" and text_at(syntax, name) == "Read" and
              primitive == PRIM_STR()
            _ -> false
          }
        )
      }
    _ -> Test.assert_true(false)
  }
}

test "authored structural record aliases parse as typed fields" {
  let (syntax, diagnostics) = parse("type Program<T, E> = { value: T, energies: E, .. }")
  if not diagnostics.is_empty() { panic("unexpected parser diagnostic") }
  let target = alias_target(syntax)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(target), 0)
  Test.assert_eq(type_expr_tree_unknown_count(target), 0)
  match target {
    RecordTypeExpr(fields, AdditionalTypeFields, NamedTypeFields) -> {
      Test.assert_eq(type_expr_list_len(fields), 2)
      Test.assert_true(
        match type_expr_list_nth(fields, 0) {
          RecordFieldTypeExpr(_, VariableTypeExpr(_), name) -> text_at(syntax, name) == "value"
          _ -> false
        }
      )
      Test.assert_true(
        match type_expr_list_nth(fields, 1) {
          RecordFieldTypeExpr(_, VariableTypeExpr(_), name) -> text_at(syntax, name) == "energies"
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
  let (exact_syntax, exact_diagnostics) = parse("type Pair = { left: i64, right: str }")
  if not exact_diagnostics.is_empty() { panic("unexpected parser diagnostic") }
  Test.assert_true(
    match alias_target(exact_syntax) {
      RecordTypeExpr(fields, ExactTypeFields, NamedTypeFields) -> type_expr_list_len(fields) == 2
      _ -> false
    }
  )
}

test "authored record fields retain Unicode names order and generic annotations" {
  let (syntax, diagnostics) = parse(
    "-- 🧶\npub type Row<T> { café: T, count: i64, label: str }"
  )
  Test.assert_true(diagnostics.is_empty())
  let fields = record_fields(syntax)
  Test.assert_eq_usize(fields.len(), 3)
  Test.assert_str_eq(text_at(syntax, fields.get(0).unwrap().name), "café")
  Test.assert_str_eq(text_at(syntax, fields.get(1).unwrap().name), "count")
  Test.assert_str_eq(text_at(syntax, fields.get(2).unwrap().name), "label")
  Test.assert_true(
    match fields.get(0).unwrap().annotation { VariableTypeExpr(_) -> true, _ -> false }
  )
  Test.assert_true(
    match fields.get(1).unwrap().annotation {
      PrimitiveTypeExpr(primitive) -> primitive == PRIM_I64(),
      _ -> false
    }
  )
  Test.assert_true(
    match fields.get(2).unwrap().annotation {
      PrimitiveTypeExpr(primitive) -> primitive == PRIM_STR(),
      _ -> false
    }
  )
}

test "variant members derive arity from ordered typed payloads" {
  let (syntax, diagnostics) = parse(
    "type Choice<T> { Empty, Explicit(), One(T), Many(i64, T, str), Nested(api.Box<T>), }"
  )
  Test.assert_true(diagnostics.is_empty())
  let members = variant_members(syntax)
  Test.assert_eq_usize(members.len(), 5)
  for sample in [
    (0, "Empty", 0),
    (1, "Explicit", 0),
    (2, "One", 1),
    (3, "Many", 3),
    (4, "Nested", 1)
  ] {
    let member = members.get(__i64_to_usize(sample.0)).unwrap()
    Test.assert_str_eq(text_at(syntax, member.name), sample.1)
    Test.assert_eq_usize(member.payloads.len(), __i64_to_usize(sample.2))
  }
  let payloads = members.get(3).unwrap().payloads
  Test.assert_true(
    match payloads.get(0).unwrap() {
      PrimitiveTypeExpr(primitive) -> primitive == PRIM_I64(),
      _ -> false
    }
  )
  Test.assert_true(match payloads.get(1).unwrap() { VariableTypeExpr(_) -> true, _ -> false })
  Test.assert_true(
    match payloads.get(2).unwrap() {
      PrimitiveTypeExpr(primitive) -> primitive == PRIM_STR(),
      _ -> false
    }
  )
  Test.assert_true(
    match members.get(4).unwrap().payloads.first().unwrap() {
      SourceAssociatedTypeExpr(NamedTypeExpr(_, _, TypeExprListCons(VariableTypeExpr(_), TypeExprListNil, _), _), _, range) ->
        text_at(syntax, range) == "api.Box"
      _ -> false
    }
  )
}

fn record_source(count: i64, annotation: str) -> str {
  let mut text = "type Wide<T> { "
  for index in 0..count {
    text = text |> str_concat("f") |> str_concat(int_to_str(index)) |> str_concat(": ")
      |> str_concat(annotation) |> str_concat(",")
  }
  text.concat(" } fn following() -> i64 { 42 }")
}

fn variant_source(count: i64) -> str {
  let mut text = "type Choice<T> { "
  for index in 0..count {
    let payloads = if index % 2 == 0 { "," } else { "(i64, T, str)," }
    text = text |> str_concat("V") |> str_concat(int_to_str(index)) |> str_concat(payloads)
  }
  text.concat(" } fn following() -> i64 { 42 }")
}

test "record syntax and host registration have no fixed field buffer limit" {
  for count in [1, 340, 341, 342, 512] {
    let (syntax, diagnostics) = parse(record_source(count, "T"))
    Test.assert_true(diagnostics.is_empty())
    let fields = record_fields(syntax)
    Test.assert_eq_usize(fields.len(), __i64_to_usize(count))
    let mut index = 0
    for field in fields {
      Test.assert_str_eq(text_at(syntax, field.name), "f".concat(int_to_str(index)))
      Test.assert_true(match field.annotation { VariableTypeExpr(_) -> true, _ -> false })
      index = index + 1
    }
    for repeat in 0..2 {
      let table = ttable_new()
      declarations.register(syntax.declarations, syntax.source.source(), table)
      match type_entry_from_ptr(ttable_entry_at(table, 0)) {
        TypeRecordEntry(_, _, registered) -> {
          Test.assert_eq(type_record_field_list_len(registered), count)
          let mut remaining = registered
          let mut index = 0
          loop {
            match remaining {
              TypeRecordFieldListCons(TypeRecordField(start, length, VariableTypeExpr(_)), rest) ->
                {
                  Test.assert_str_eq(
                    text_at(syntax, TypeNameRange { start: start, length: length }),
                    "f".concat(int_to_str(index))
                  )
                  remaining = rest
                  index = index + 1
                }
              TypeRecordFieldListNil -> break
              _ -> { Test.assert_true(false); break }
            }
          }
          Test.assert_eq(index, count)
        }
        _ -> Test.assert_true(false)
      }
    }
    Test.assert_eq_usize(syntax.declarations.declarations.len(), 2)
    Test.assert_eq_usize(record_fields(syntax).len(), __i64_to_usize(count))
  }
}

test "variant syntax and host registration have no fixed member buffer limit" {
  for count in [0, 1, 203, 204, 205, 512] {
    let (syntax, diagnostics) = parse(variant_source(count))
    Test.assert_true(diagnostics.is_empty())
    let members = variant_members(syntax)
    Test.assert_eq_usize(members.len(), __i64_to_usize(count))
    let mut index = 0
    for member in members {
      Test.assert_str_eq(text_at(syntax, member.name), "V".concat(int_to_str(index)))
      Test.assert_eq_usize(member.payloads.len(), if index % 2 == 0 { 0 } else { 3 })
      index = index + 1
    }
    for repeat in 0..2 {
      let table = ttable_new()
      declarations.register(syntax.declarations, syntax.source.source(), table)
      match type_entry_from_ptr(ttable_entry_at(table, 0)) {
        TypeVariantEntry(_, _, registered) -> {
          Test.assert_eq(type_variant_list_len(registered), count)
          let mut remaining = registered
          let mut index = 0
          loop {
            match remaining {
              TypeVariantListCons(TypeVariant(start, length, arity, payloads), rest) -> {
                Test.assert_str_eq(
                  text_at(syntax, TypeNameRange { start: start, length: length }),
                  "V".concat(int_to_str(index))
                )
                Test.assert_eq(arity, if index % 2 == 0 { 0 } else { 3 })
                Test.assert_eq(type_expr_list_len(payloads), arity)
                if arity == 3 {
                  Test.assert_true(
                    match payloads {
                      TypeExprListCons(PrimitiveTypeExpr(first),
                        TypeExprListCons(VariableTypeExpr(_),
                        TypeExprListCons(PrimitiveTypeExpr(last), TypeExprListNil, _), _), _) ->
                        first == PRIM_I64() and last == PRIM_STR()
                      _ -> false
                    }
                  )
                }
                remaining = rest
                index = index + 1
              }
              TypeVariantListNil -> break
              _ -> { Test.assert_true(false); break }
            }
          }
          Test.assert_eq(index, count)
        }
        _ -> Test.assert_true(false)
      }
    }
    Test.assert_eq_usize(syntax.declarations.declarations.len(), 2)
    Test.assert_eq_usize(variant_members(syntax).len(), __i64_to_usize(count))
  }
}

test "member recovery preserves diagnostics and the following declaration" {
  for sample in [
    ("type R { good: i64, , tail: str }", "expected record field after separator"),
    ("type R { good: i64, bad i64, tail: str }", "expected ':' after record field name"),
    ("type R { good: i64, bad: , tail: str }", "expected type after record field ':'"),
    ("type R { good: i64 tail: str }", "expected ',' or '}' after record field"),
    ("type R { good: i64, 12, tail: str }", "expected record field name or '}'"),
    ("type R { good: i64", "expected '}' after record fields"),
    ("type V { Good, , Tail }", "expected variant after separator"),
    ("type V { Good Tail }", "expected ',' or '}' after variant"),
    ("type V { 12, Tail }", "expected variant name or '}'"),
    ("type V { Good", "expected '}' after type variants"),
    ("type V { Bad(, Tail }", "expected variant payload type"),
    ("type V { Bad(i64 str), Tail }", "expected ',' or ')' after variant payload type"),
    ("type V { Bad( }", "expected ')' after variant payload types")
  ] {
    let source = "-- é🧶\n" |> str_concat(sample.0) |> str_concat("\nfn following() -> i64 { 42 }")
    let (syntax, diagnostics) = parse(source)
    Test.assert_eq_usize(diagnostics.len(), 1)
    let diagnostic = diagnostics.first().unwrap()
    Test.assert_true(diagnostic.code().eq(DiagnosticCodeAssigned("E0002")))
    Test.assert_str_eq(diagnostic.message(), sample.1)
    Test.assert_eq_usize(syntax.declarations.declarations.len(), 2)
    let first = syntax.declarations.declarations.first().unwrap()
    Test.assert_true(match first.validity { RecoveredDeclaration -> true, _ -> false })
    let following = syntax.declarations.declarations.get(1).unwrap()
    Test.assert_true(match following.validity { ParsedDeclaration -> true, _ -> false })
    Test.assert_str_eq(text_at(syntax, following.range), "fn following() -> i64 { 42 }")
  }
}

test "member diagnostics retain exact UTF-8 byte positions" {
  for sample in [
    ("type R { café: ", ",", " tail: str }", "expected type after record field ':'"),
    ("type V { Good, ", ",", " Tail }", "expected variant after separator"),
    ("type V { Bad(", ",", " Tail }", "expected variant payload type")
  ] {
    let prefix = "-- é🧶\n".concat(sample.0)
    let source = prefix |> str_concat(sample.1) |> str_concat(sample.2)
    let (syntax, diagnostics) = parse(source)
    Test.assert_eq_usize(diagnostics.len(), 1)
    let diagnostic = diagnostics.first().unwrap()
    Test.assert_str_eq(diagnostic.message(), sample.3)
    match diagnostic.primary() {
      DiagnosticSourceRange(DiagnosticSourceBuffer(identity), start, end) -> {
        Test.assert_eq(identity, __str_ptr(syntax.source.source().text))
        Test.assert_eq_usize(start, prefix.len())
        Test.assert_eq_usize(end, prefix.len() + 1)
      }
      _ -> Test.assert_true(false)
    }
  }
}

test "large authored type declarations reach checking with usable final members" {
  let record_text = record_source(342, "i64").concat(
    " fn read(value: Wide<i64>) -> i64 { value.f341 }"
  )
  let variant_text = variant_source(205).concat(
    " fn last() -> Choice<i64> { V204 } fn payload(value: Choice<i64>) -> i64 { match value { V203(a, b, label) -> a + b, _ -> 0 } }"
  )
  match probe_check_source(__str_ptr(record_text), __str_len(record_text)) {
    TypedModule(_, _, table, _, _) -> Test.assert_true(
      match type_entry_from_ptr(ttable_entry_at(table, 0)) {
        TypeRecordEntry(_, _, fields) -> type_record_field_list_len(fields) == 342
        _ -> false
      }
    )
  }
  match probe_check_source(__str_ptr(variant_text), __str_len(variant_text)) {
    TypedModule(_, _, table, _, _) -> Test.assert_true(
      match type_entry_from_ptr(ttable_entry_at(table, 0)) {
        TypeVariantEntry(_, _, members) -> type_variant_list_len(members) == 205
        _ -> false
      }
    )
  }
}

fn authored_type_algebra_source() -> str {
  "type Program<T, E> = (*mut T, borrow mut T, weak T, arc T, "
    |> str_concat("unique [str; 4], owned T, Box<T>, api.Box<T>.Item?) ")
    |> str_concat("-[State<T>, api.Read<str>, E]> T & ~nil")
}
