-- Analytics: combines CHAMP Map, Set, List, for-in, for-range, pipes
-- Expected exit code: 42
use stdlib/list.{*}
use stdlib/map.{*}
use stdlib/option.{Option}
use stdlib/set.{*}

-- Count unique values in a list using a Set
fn count_unique(xs: List<i64>) -> i64 {
  let mut s = set_new<i64>()
  for x in xs {
    s = s.insert(x)
  }
  -- Count unique values in range 0..100
  set_count_in_range(s, 0, 100)
}

-- Build a histogram (value → count) using a Map
fn histogram(xs: List<i64>) -> Map<i64, i64> {
  let mut m = map_new<i64, i64>()
  for x in xs {
    let cur = m.get(x).unwrap_or(0)
    m = m.insert(x, cur + 1)
  }
  m
}

fn main() -> i64 {
  -- Data with duplicates
  let mut data: List<i64> = Nil<i64>()
  for i in 0..21 {
    data = data.prepend(i)
    data = data.prepend(i)
  }
  -- 42 total elements (21 values, each twice)
  let hist = histogram(data)
  -- Each value appears twice. Check value 10:
  let count_10 = hist.get(10).unwrap_or(0)
  -- Unique count should be 21
  let unique = count_unique(data)
  -- count_10 * unique = 2 * 21 = 42
  count_10 * unique
}
