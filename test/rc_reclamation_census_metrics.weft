-- test/rc_reclamation_census_metrics.weft -- 5a class and event census laws

use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/rc_census.{*}

use compiler/codegen.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/types.{*}

fn rc_census_test_native(functions: IrFunctionList, alloc_elisions: i64, reuse_lowerings: i64) -> NativeModule {
  let fm = fmap_new()
  mem_store64_at(fm + 200, 0, alloc_elisions)
  mem_store64_at(fm + 800, 0, reuse_lowerings)
  NativeModule(buf_new(0), fm, functions)
}

fn rc_census_test_ir(insts: IrInstList) -> IrModule {
  let block = IrBlock(0, ir_value_list_empty(), insts, IrTermReturn(0))
  let function = IrFunction(101, 0, ir_block_list_prepend(block, ir_block_list_empty()), 0)
  pipeline_ir_module(ir_function_list_prepend(function, ir_function_list_empty()))
}

fn rc_census_test_matrix_ir() -> IrModule {
  let mut insts = ir_inst_list_empty()
  insts = ir_inst_list_prepend(IrCallI64(9, pipeline_ir_native_hash_name("rc_default_promote"), ir_value_list_empty()), insts)
  insts = ir_inst_list_prepend(IrCallI64(8, pipeline_ir_native_hash_name("alloc_bump"), ir_value_list_empty()), insts)
  insts = ir_inst_list_prepend(IrCallI64(7, pipeline_ir_native_hash_name("rc_persistent_region_alloc"), ir_value_list_empty()), insts)
  insts = ir_inst_list_prepend(IrCallI64(6, pipeline_ir_native_hash_name("rc_default_alloc"), ir_value_list_empty()), insts)
  insts = ir_inst_list_prepend(IrArrayStorageI64(5, 32, 8), insts)
  insts = ir_inst_list_prepend(IrRecordLayoutInitI64(4, 44, 16, 8, IrRecordLayoutFieldNil), insts)
  insts = ir_inst_list_prepend(IrRecordInitI64(3, 33, IrRecordFieldNil), insts)
  insts = ir_inst_list_prepend(IrVariantInitI64(2, 22, ir_value_list_empty(), 0), insts)
  rc_census_test_ir(insts)
}

fn rc_census_function_param_lane_count(functions: IrFunctionList, hash: i64, want_borrowed: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(fn_hash, param_count, blocks, src) -> {
          if fn_hash == hash { pipeline_ir_native_entry_param_managed_lane_count(blocks, param_count, want_borrowed) }
          else { rc_census_function_param_lane_count(rest, hash, want_borrowed) }
        }
      }
    }
    _ -> 0
  }
}

test "rc_reclamation_site_census_classifies_final_ir_matrix" {
  let ir = rc_census_test_matrix_ir()
  let native = rc_census_test_native(pipeline_ir_functions(ir), 0, 0)
  let census = pipeline_rc_reclamation_site_census(ir, native)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0), 4)
  Test.assert_eq(pipeline_rc_site_census_get(census, 1), 1)
  Test.assert_eq(pipeline_rc_site_census_get(census, 2), 1)
  Test.assert_eq(pipeline_rc_site_census_get(census, 3), 1)
  Test.assert_eq(pipeline_rc_site_census_get(census, 4), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 5), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 6), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 7), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 8), 1)
  Test.assert_eq(pipeline_rc_site_census_total(census), 7)
}

test "rc_reclamation_site_census_reclassifies_native_moves_once" {
  let ir = rc_census_test_matrix_ir()
  let native = rc_census_test_native(pipeline_ir_functions(ir), 1, 1)
  let census = pipeline_rc_reclamation_site_census(ir, native)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0), 2)
  Test.assert_eq(pipeline_rc_site_census_get(census, 1), 2)
  Test.assert_eq(pipeline_rc_site_census_get(census, 4), 1)
  Test.assert_eq(pipeline_rc_site_census_total(census), 7)
}

test "rc_reclamation_site_census_empty_and_invalid_queries_are_zero" {
  let ir = pipeline_ir_empty()
  let native = rc_census_test_native(ir_function_list_empty(), 0, 0)
  let census = pipeline_rc_reclamation_site_census(ir, native)
  Test.assert_eq(pipeline_rc_site_census_total(census), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0 - 1), 0)
  Test.assert_eq(pipeline_rc_site_census_get(census, 9), 0)
}

test "rc_reclamation_promotion_boundaries_do_not_double_count_sites" {
  let insts = ir_inst_list_prepend(
    IrCallI64(1, pipeline_ir_native_hash_name("rc_default_promote_maybe"), ir_value_list_empty()),
    ir_inst_list_empty()
  )
  let ir = rc_census_test_ir(insts)
  let native = rc_census_test_native(pipeline_ir_functions(ir), 0, 0)
  let census = pipeline_rc_reclamation_site_census(ir, native)
  Test.assert_eq(pipeline_rc_site_census_get(census, 8), 1)
  Test.assert_eq(pipeline_rc_site_census_total(census), 0)
}

test "rc_dynamic_census_event_registry_is_complete_and_disjoint" {
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_alloc")), 0)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_alloc_masked")), 0)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_retain")), 1)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_release")), 2)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_deep_release_child")), 3)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_retain_promoted_slow")), 4)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_release_promoted")), 5)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("closure_default_retain")), 6)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("closure_default_release")), 7)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("closure_default_release_promoted")), 8)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_weak_retain")), 9)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_weak_release")), 10)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_weak_load")), 11)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_persistent_region_alloc_unlocked")), 12)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("rc_default_promote")), 13)
  Test.assert_eq(pipeline_rc_census_event_for_function_hash(pipeline_ir_native_hash_name("not_an_rc_helper")), 0 - 1)
}

test "rc_dynamic_census_runtime_abi_twins_match" {
  Test.assert_eq(runtime_state_rc_census_base_offset(), rc_census_base_offset())
  Test.assert_eq(runtime_state_rc_census_event_count(), rc_census_event_count())
  Test.assert_eq(runtime_state_rc_census_size(), runtime_state_rc_census_base_offset() + runtime_state_rc_census_event_count() * 8)
}

test "rc_dynamic_census_partitions_typed_entry_lanes_by_borrow_contract" {
  let managed = ty_rc(ty_i64())
  let insts = ir_inst_list_prepend(
    ir_inst_bind_typed_i64(0, 1, 0, managed),
    ir_inst_list_prepend(
      ir_inst_bind_typed_i64(2, 1, 1, ty_i64()),
      ir_inst_list_prepend(
        ir_inst_bind_typed_i64(4, 1, 2, managed),
        ir_inst_list_prepend(ir_inst_slot_i64(pipeline_ir_borrowed_param_mask_slot(cg_bit(2))), ir_inst_list_empty())
      )
    )
  )
  let block = IrBlock(0, ir_value_list_empty(), insts, IrTermReturn(0))
  let blocks = ir_block_list_prepend(block, ir_block_list_empty())
  Test.assert_eq(pipeline_ir_native_entry_param_managed_lane_count(blocks, 3, 0), 1)
  Test.assert_eq(pipeline_ir_native_entry_param_managed_lane_count(blocks, 3, 1), 1)
  Test.assert_eq(pipeline_ir_native_entry_param_managed_lane_count(ir_block_list_empty(), 3, 0), 0)
}

test "rc_dynamic_census_uses_inferred_per_parameter_facts_not_call_shape" {
  let src = "type CensusParamBox { value: i64 } type CensusParamHolder { item: CensusParamBox } fn census_param_borrowed(p: CensusParamBox) -> i64 { p.value } fn census_param_owned(p: CensusParamBox) -> i64 { let holder = CensusParamHolder { item: p } holder.item.value } fn census_param_mixed(a: CensusParamBox, b: CensusParamBox, scalar: i64) -> i64 { let holder = CensusParamHolder { item: b } a.value + holder.item.value + scalar } fn main() -> i64 { 0 }"
  let functions = pipeline_ir_functions(pipeline_lower_ir(pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)))
  let borrowed_hash = str_hash(__str_ptr("census_param_borrowed"), 0, __str_len("census_param_borrowed"))
  let owned_hash = str_hash(__str_ptr("census_param_owned"), 0, __str_len("census_param_owned"))
  let mixed_hash = str_hash(__str_ptr("census_param_mixed"), 0, __str_len("census_param_mixed"))
  Test.assert_eq(rc_census_function_param_lane_count(functions, borrowed_hash, 0), 0)
  Test.assert_eq(rc_census_function_param_lane_count(functions, borrowed_hash, 1), 1)
  Test.assert_eq(rc_census_function_param_lane_count(functions, owned_hash, 0), 1)
  Test.assert_eq(rc_census_function_param_lane_count(functions, owned_hash, 1), 0)
  Test.assert_eq(rc_census_function_param_lane_count(functions, mixed_hash, 0), 1)
  Test.assert_eq(rc_census_function_param_lane_count(functions, mixed_hash, 1), 1)
}
