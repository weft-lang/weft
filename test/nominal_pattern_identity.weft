use module_fixtures/nominal_pattern_identity as foreign
use stdlib/list as list
use stdlib/option.{Option, Some, None}
use stdlib/string
use runtime/rc.{rc_count}

type List<T> { Nil, Cons(T, List<T>) }

type Result<T, E> { Ok(T), Err(E) }

fn local_tail<T>(value: List<T>) -> List<T> {
  match value { Nil -> Nil<T>() Cons(_, rest) -> rest }
}

fn local_head<T>(value: List<T>) -> Option<T> {
  match value { Nil -> None<T>() Cons(item, _) -> Some<T>(item) }
}

fn foreign_head<T>(value: foreign.List<T>) -> Option<T> {
  match value {
    foreign.Nil -> None<T>()
    foreign.Cons(item, _, _) -> Some<T>(item)
  }
}

test "recursive generic payloads retain the declaring nominal type under shadowing" {
  let values = Cons<str>("first".repeat(3), Cons<str>("tail".repeat(4), Nil<str>()))
  Test.assert_str_eq(local_head<str>(local_tail<str>(values)).unwrap(), "tail".repeat(4))
  Test.assert_true(local_head<str>(local_tail<str>(local_tail<str>(values))).is_none())
  let maximum: usize = 18446744073709551615
  Test.assert_eq_usize(local_head<usize>(Cons<usize>(maximum, Nil<usize>())).unwrap(), maximum)
}

test "stdlib list methods preserve their own recursive type beside a local List" {
  let values = list.Cons<str>("stdlib", list.Cons<str>("tail", list.Nil<str>()))
  Test.assert_eq_usize(values.len(), 2)
  Test.assert_str_eq(values.first().unwrap(), "stdlib")
  Test.assert_str_eq(values.rest().unwrap().first().unwrap(), "tail")
  Test.assert_str_eq(values.reverse().first().unwrap(), "tail")
}

test "qualified variants with different payload counts use the scrutinee declaration" {
  let value = foreign.singleton("foreign".repeat(3), "metadata".repeat(2))
  Test.assert_str_eq(foreign_head<str>(value).unwrap(), "foreign".repeat(3))
  match value {
    foreign.Cons(item, rest, label) -> {
      Test.assert_str_eq(item, "foreign".repeat(3))
      Test.assert_true(foreign_head<str>(rest).is_none())
      Test.assert_str_eq(label, "metadata".repeat(2))
    }
    foreign.Nil -> Test.assert_true(false)
  }
}

test "same spelled result variants retain independent generic payload contracts" {
  let local: Result<str, i64> = Ok<str, i64>("local")
  let other = foreign.success("foreign", 42)
  match local { Ok(text) -> Test.assert_str_eq(text, "local") Err(_) -> Test.assert_true(false) }
  match other {
    foreign.Ok(text, metadata) -> {
      Test.assert_str_eq(text, "foreign")
      Test.assert_eq(metadata, 42)
    }
    foreign.Err(_) -> Test.assert_true(false)
  }
  let failure: Result<str, i64> = Err<str, i64>(73)
  match failure { Err(code) -> Test.assert_eq(code, 73) Ok(_) -> Test.assert_true(false) }
}

-- The foreign constructor has one more payload than the local `Cons` in scope.
-- Returning that payload must follow the foreign declaration's payload types,
-- so the returned string takes its own stake beside the variant's.
fn foreign_label(value: foreign.List<str>) -> str {
  match value {
    foreign.Cons(_, _, label) -> label
    foreign.Nil -> ""
  }
}

test "a foreign payload beyond the local constructor's arity keeps its own stake" {
  let value = foreign.singleton("foreign".repeat(3), "metadata".repeat(2))
  let label = foreign_label(value)
  Test.assert_eq(rc_count(__str_ptr(label) - 16), 2)
  Test.assert_str_eq(label, "metadata".repeat(2))
}
