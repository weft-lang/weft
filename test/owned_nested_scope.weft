use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option, Some, None}

type ScopeToken { log: F64Table, value: i64, digit: f64 }

impl Drop for ScopeToken {
  fn drop(self) -> nil {
    self.log.set(0, 0, self.log.get(0, 0).unwrap() * 10.0 + self.digit)
    nil
  }
}

fn scope_read(token: borrow ScopeToken) -> i64 { token.value }
fn scope_consume(token: owned ScopeToken) -> i64 { token.value }

fn scope_consume_generic<T>(marker: T, token: owned ScopeToken) -> i64 { token.value }
fn scope_return(token: owned ScopeToken) -> owned ScopeToken { token }
fn scope_choose(first: owned ScopeToken, second: owned ScopeToken, choose_first: bool) -> owned ScopeToken {
  if choose_first { first } else { second }
}
fn scope_choose_wrapped(first: owned ScopeToken, second: owned ScopeToken, choose_first: bool) -> Option<owned ScopeToken> {
  let selected = if choose_first { first } else { second }
  Some(selected)
}
fn scope_conditional_param(token: owned ScopeToken, consume: bool) -> i64 {
  if consume { scope_consume(token) } else { scope_read(token) }
}
fn scope_early_param(token: owned ScopeToken, early: bool) -> i64 {
  if early { return scope_read(token) } else { scope_read(token) }
}

trait ScopeSink {
  fn consume(token: owned ScopeToken) -> i64
  fn observe(token: borrow ScopeToken) -> i64
}

type ScopeWitness { ScopeWitness }

impl ScopeSink for ScopeWitness {
  fn consume(token: owned ScopeToken) -> i64 { token.value }
  fn observe(token: borrow ScopeToken) -> i64 { token.value }
}

impl ScopeWitness {
  fn consume_after(self, prefix: [i64], token: owned ScopeToken) -> i64 {
    prefix[0] + token.value
  }
}

fn scope_trait_consume<C: ScopeSink>(token: owned ScopeToken) -> i64 {
  C.consume(token)
}

fn scope_trait_conditional<C: ScopeSink>(token: owned ScopeToken, consume: bool) -> i64 {
  if consume { C.consume(token) } else { C.observe(token) }
}

fn scope_method_consume(token: owned ScopeToken) -> i64 {
  let prefix = [8, 9]
  ScopeWitness().consume_after(prefix[..], token)
}

effect ScopeInspect { fn inspect(token: owned ScopeToken) -> i64 }
effect ScopeDeferred { @deferred fn inspect(token: owned ScopeToken) -> i64 }
effect ScopeAbort { fn stop() -> i64 }
effect ScopeMove { fn move(token: owned ScopeToken) -> owned ScopeToken }
effect ScopeChoose { fn choose(first: owned ScopeToken, second: owned ScopeToken, choose_first: bool) -> owned ScopeToken }
effect ScopePause { @deferred fn pause() -> i64 }

fn scope_pause_then_consume(token: owned ScopeToken, resume_body: bool) -> i64 {
  handle {
    ScopePause.pause()
    scope_consume(token)
  } {
    ScopePause.pause() with k -> if resume_body { k(0) } else { 42 }
  }
}

fn scope_consume_then_pause(token: owned ScopeToken, resume_body: bool) -> i64 {
  handle {
    let value = scope_consume(token)
    ScopePause.pause() + value
  } {
    ScopePause.pause() with k -> if resume_body { k(0) } else { 42 }
  }
}

fn scope_completion_consume(token: owned ScopeToken, resume_body: bool) -> i64 {
  handle { ScopePause.pause() } {
    ScopePause.pause() with k -> if resume_body { k(0) } else { 42 }
    return value -> value + scope_consume(token)
  }
}

fn scope_consume_with_completion(token: owned ScopeToken, resume_body: bool) -> i64 {
  handle {
    let value = scope_consume(token)
    ScopePause.pause() + value
  } {
    ScopePause.pause() with k -> if resume_body { k(0) } else { 42 }
    return value -> value
  }
}

fn scope_borrow_in_deferred(token: owned ScopeToken) -> i64 {
  let before = handle { ScopePause.pause() + scope_read(token) } {
    ScopePause.pause() with k -> k(0)
  }
  before + scope_read(token)
}

fn scope_conditional_capture(token: owned ScopeToken, consume: bool, resume_body: bool) -> i64 {
  handle {
    ScopePause.pause()
    if consume { scope_consume(token) } else { scope_read(token) }
  } { ScopePause.pause() with k -> if resume_body { k(0) } else { 42 } }
}

fn scope_structural_capture(pair: (owned ScopeToken, owned ScopeToken), resume_body: bool) -> i64 {
  handle {
    ScopePause.pause()
    let (first, second) = pair
    scope_consume(first) + scope_consume(second)
  } { ScopePause.pause() with k -> if resume_body { k(0) } else { 42 } }
}

test "conditional capture consumption retains one cleanup owner on every exit" {
  for resume_body in [true, false] {
    for consume in [true, false] {
      let log = table.zeros(1, 1).unwrap()
      let value = scope_conditional_capture(ScopeToken { log: log, value: 42, digit: 1.0 }, consume, resume_body)
      Test.assert_eq(value, 42)
      Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
    }
  }
}

test "structural captures dispose each field once on completion or discard" {
  for resume_body in [true, false] {
    let first_log = table.zeros(1, 1).unwrap()
    let second_log = table.zeros(1, 1).unwrap()
    let value = scope_structural_capture((ScopeToken { log: first_log, value: 20, digit: 1.0 }, ScopeToken { log: second_log, value: 22, digit: 2.0 }), resume_body)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(first_log.get(0, 0).unwrap(), 1.0)
    Test.assert_eq_f64(second_log.get(0, 0).unwrap(), 2.0)
  }
}

test "deferred completion owns captures even when the continuation is discarded" {
  for resume_body in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let value = scope_completion_consume(ScopeToken { log: log, value: 42, digit: 1.0 }, resume_body)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

test "deferred completion preserves prior body ownership transfers" {
  for resume_body in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let value = scope_consume_with_completion(ScopeToken { log: log, value: 42, digit: 1.0 }, resume_body)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

test "borrow-only deferred captures preserve their enclosing owner" {
  let log = table.zeros(1, 1).unwrap()
  let value = scope_borrow_in_deferred(ScopeToken { log: log, value: 42, digit: 1.0 })
  Test.assert_eq(value, 84)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "captured ownership survives either resuming or dropping a suspended body" {
  for resume_body in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let value = scope_pause_then_consume(ScopeToken { log: log, value: 42, digit: 1.0 }, resume_body)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

test "a body can consume an outer owner before suspension" {
  for resume_body in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let value = scope_consume_then_pause(ScopeToken { log: log, value: 42, digit: 1.0 }, resume_body)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

fn scope_effect_move(token: owned ScopeToken) -[ScopeMove]> owned ScopeToken {
  ScopeMove.move(token)
}

fn scope_deferred_roundtrip(token: owned ScopeToken) -> owned ScopeToken {
  handle {
    handle scope_effect_move(token) {
      ScopeMove.move(value) -> { ScopePause.pause() resume(value) }
    }
  } {
    ScopePause.pause() with k -> k(0)
  }
}

test "an owned capture returns through a suspended resuming clause" {
  let log = table.zeros(1, 1).unwrap()
  let value = {
    let token = scope_deferred_roundtrip(ScopeToken { log: log, value: 42, digit: 1.0 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 0.0)
    scope_read(token)
  }
  Test.assert_eq(value, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

fn scope_abort_param(token: owned ScopeToken) -[ScopeAbort]> i64 {
  let value = token.value
  ScopeAbort.stop() + value
}

test "copying a resource field preserves cleanup at the expression scope exit" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let token: owned ScopeToken = ScopeToken { log: log, value: 42, digit: 1.0 }
    token.value
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "associated trait calls transfer an owned argument exactly once" {
  let log = table.zeros(1, 1).unwrap()
  let value = scope_trait_consume<ScopeWitness>(ScopeToken { log: log, value: 42, digit: 1.0 })
  Test.assert_eq(value, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "associated trait calls distinguish borrowed and consuming arguments" {
  for consume in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let value = scope_trait_conditional<ScopeWitness>(ScopeToken { log: log, value: 42, digit: 1.0 }, consume)
    Test.assert_eq(value, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

test "method argument transfers follow flattened parameter lanes" {
  let log = table.zeros(1, 1).unwrap()
  let value = scope_method_consume(ScopeToken { log: log, value: 42, digit: 1.0 })
  Test.assert_eq(value, 50)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "borrowing a resource preserves cleanup at the expression scope exit" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let token: owned ScopeToken = ScopeToken { log: log, value: 42, digit: 1.0 }
    scope_read(token)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "scope cleanup follows each branch's actual ownership transfer" {
  for consume in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let result = {
      let token: owned ScopeToken = ScopeToken { log: log, value: 42, digit: 1.0 }
      if consume { scope_consume(token) } else { scope_read(token) }
    }
    Test.assert_eq(result, 42)
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  }
}

test "an owner returned from a nested scope is dropped only by its recipient" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let moved: owned ScopeToken = {
      let original: owned ScopeToken = ScopeToken { log: log, value: 42, digit: 1.0 }
      original
    }
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 0.0)
    scope_read(moved)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "shadowed resource names retain their independent cleanup order" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let token: owned ScopeToken = ScopeToken { log: log, value: 10, digit: 1.0 }
    let inner = {
      let token: owned ScopeToken = ScopeToken { log: log, value: 32, digit: 2.0 }
      scope_read(token)
    }
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 2.0)
    scope_read(token) + inner
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 21.0)
}

test "a copied field does not consume a named or generic owned parameter" {
  let log = table.zeros(1, 1).unwrap()
  Test.assert_eq(scope_consume(ScopeToken { log: log, value: 42, digit: 1.0 }), 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
  Test.assert_eq(scope_consume_generic<bool>(true, ScopeToken { log: log, value: 43, digit: 2.0 }), 43)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 12.0)
}

test "owned parameter cleanup follows conditional transfers and early returns" {
  let log = table.zeros(1, 1).unwrap()
  for branch in [true, false] {
    Test.assert_eq(scope_conditional_param(ScopeToken { log: log, value: 42, digit: 1.0 }, branch), 42)
    Test.assert_eq(scope_early_param(ScopeToken { log: log, value: 43, digit: 2.0 }, branch), 43)
  }
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1212.0)
}

test "returning an owned parameter transfers its cleanup to the recipient" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let token = scope_return(ScopeToken { log: log, value: 42, digit: 1.0 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 0.0)
    scope_read(token)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "owned parameter cleanup remains exact when its callee aborts" {
  let log = table.zeros(1, 1).unwrap()
  let result = handle scope_abort_param(ScopeToken { log: log, value: 10, digit: 1.0 }) {
    ScopeAbort.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "a resuming clause drops its owned parameter after copying a field" {
  let log = table.zeros(1, 1).unwrap()
  let result = handle ScopeInspect.inspect(ScopeToken { log: log, value: 42, digit: 1.0 }) {
    ScopeInspect.inspect(token) -> resume(token.value)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "an aborting clause leaves its copied-field parameter cleanup to unwinding" {
  let log = table.zeros(1, 1).unwrap()
  let result = handle ScopeInspect.inspect(ScopeToken { log: log, value: 42, digit: 1.0 }) {
    ScopeInspect.inspect(token) -> token.value
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "a deferred clause drops its copied-field parameter exactly once" {
  let log = table.zeros(1, 1).unwrap()
  let result = handle ScopeDeferred.inspect(ScopeToken { log: log, value: 42, digit: 1.0 }) {
    ScopeDeferred.inspect(token) with k -> k(token.value)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "an immediate clause transfers an owned parameter through resume" {
  let log = table.zeros(1, 1).unwrap()
  let result = {
    let token = handle scope_effect_move(ScopeToken { log: log, value: 42, digit: 1.0 }) {
      ScopeMove.move(value) -> resume(value)
    }
    Test.assert_eq_f64(log.get(0, 0).unwrap(), 0.0)
    scope_read(token)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq_f64(log.get(0, 0).unwrap(), 1.0)
}

test "a function drops only the parameter not selected for its owned result" {
  for first in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let result = {
      let token = scope_choose(ScopeToken { log: log, value: 41, digit: 1.0 }, ScopeToken { log: log, value: 42, digit: 2.0 }, first)
      Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 2.0 } else { 1.0 })
      scope_read(token)
    }
    Test.assert_eq(result, if first { 41 } else { 42 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 21.0 } else { 12.0 })
  }
}

test "a resuming clause drops only the parameter not selected for its result" {
  for first in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let result = {
      let token = handle ScopeChoose.choose(ScopeToken { log: log, value: 41, digit: 1.0 }, ScopeToken { log: log, value: 42, digit: 2.0 }, first) {
        ScopeChoose.choose(left, right, choose_left) -> resume(if choose_left { left } else { right })
      }
      Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 2.0 } else { 1.0 })
      scope_read(token)
    }
    Test.assert_eq(result, if first { 41 } else { 42 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 21.0 } else { 12.0 })
  }
}

test "a selected owner retains its provenance through a binding and constructor" {
  for first in [true, false] {
    let log = table.zeros(1, 1).unwrap()
    let result = {
      let wrapped = scope_choose_wrapped(ScopeToken { log: log, value: 41, digit: 1.0 }, ScopeToken { log: log, value: 42, digit: 2.0 }, first)
      Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 2.0 } else { 1.0 })
      match wrapped {
        Some(token) -> scope_consume(token)
        None -> 0
      }
    }
    Test.assert_eq(result, if first { 41 } else { 42 })
    Test.assert_eq_f64(log.get(0, 0).unwrap(), if first { 21.0 } else { 12.0 })
  }
}
