use test/module_fixtures/alias_source as source
use test/module_fixtures/alias_source.{Item as ImportedItem, Pair as ImportedPair}
use test/module_fixtures/alias_export.{ExportedItem, ExportedPair, Total}

type Local { text: str }
type Count = str
type Item = i64

fn qualified(value: source.Item) -> source.Count { source.value(value) }
fn renamed(value: ImportedItem) -> Total { source.value(value) }
fn exported(value: ExportedItem) -> Total { source.value(value) }
fn pair_first<T>(pair: source.Pair<T>) -> T { pair.0 }

test "imported aliases retain the defining module despite local name collisions" {
  let item = source.item(42)
  Test.assert_eq(qualified(item), 42)
  Test.assert_eq(renamed(item), 42)
  Test.assert_eq(exported(item), 42)
  let local: Item = 7
  Test.assert_eq(local, 7)
}

test "generic aliases retain arguments through qualified selected and reexported names" {
  let first: source.Pair<i64> = source.pair(4, 5)
  let second: ImportedPair<str> = source.pair("a", "b")
  let third: ExportedPair<bool> = source.pair(true, false)
  Test.assert_eq(pair_first(first), 4)
  Test.assert_str_eq(pair_first(second), "a")
  Test.assert_true(pair_first(third))
}
