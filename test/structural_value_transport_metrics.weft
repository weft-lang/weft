use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn structural_transport_field(name_hash: i64, ty: i64) -> i64 {
  ty_record_field(name_hash, ty, 0, 0)
}

fn structural_transport_type() -> i64 {
  let fields = nlist_new()
  nlist_add(fields, structural_transport_field(10, ty_str()))
  nlist_add(fields, structural_transport_field(20, ty_i64()))
  nlist_add(fields, structural_transport_field(30, ty_fn(nlist_new(), ty_i64(), ty_effect_pure())))
  nlist_add(fields, structural_transport_field(40, ty_weak(ty_rc(ty_i64()))))
  ty_record(fields, 0)
}

fn structural_transport_assert_call(inst: IrInst, dst: i64, callee: i64, arg: i64) -> i64 {
  match inst {
    IrCallI64(actual_dst, actual_callee, args) -> {
      if actual_dst == dst and actual_callee == callee and pipeline_ir_value_list_get_or(args, 0, 0 - 1) == arg { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn structural_transport_call_at(insts: IrInstList, index: i64, dst: i64, callee: i64, arg: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> if index == 0 { structural_transport_assert_call(inst, dst, callee, arg) } else { structural_transport_call_at(rest, index - 1, dst, callee, arg) }
  }
}

fn structural_transport_load_at(insts: IrInstList, index: i64, dst: i64, slot: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> if index == 0 {
      match inst { IrLoadI64(actual_dst, actual_slot) -> if actual_dst == dst and actual_slot == slot { 1 } else { 0 } _ -> 0 }
    } else { structural_transport_load_at(rest, index - 1, dst, slot) }
  }
}

fn structural_transport_call_lane_at(insts: IrInstList, index: i64, dst: i64, lane: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> if index == 0 {
      match inst { IrCallResultLaneI64(actual_dst, actual_lane) -> if actual_dst == dst and actual_lane == lane { 1 } else { 0 } _ -> 0 }
    } else { structural_transport_call_lane_at(rest, index - 1, dst, lane) }
  }
}

fn structural_transport_return_lane_at(insts: IrInstList, index: i64, lane: i64, value: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> if index == 0 {
      match inst { IrReturnLaneI64(actual_lane, actual_value) -> if actual_lane == lane and actual_value == value { 1 } else { 0 } _ -> 0 }
    } else { structural_transport_return_lane_at(rest, index - 1, lane, value) }
  }
}

fn structural_transport_count_insts(insts: IrInstList, kind: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrCallResultLaneI64(dst, lane) -> if kind == 1 { 1 } else { 0 }
        IrReturnLaneI64(lane, value) -> if kind == 2 { 1 } else { 0 }
        IrSlotI64(slot) -> if kind == 3 { 1 } else { 0 }
        IrStoreI64(slot, value) -> if kind == 4 { 1 } else { 0 }
        _ -> 0
      }
      here + structural_transport_count_insts(rest, kind)
    }
  }
}

fn structural_transport_count_blocks(blocks: IrBlockList, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> structural_transport_count_insts(insts, kind) + structural_transport_count_blocks(rest, kind)
    }
  }
}

fn structural_transport_count_function(functions: IrFunctionList, target_hash: i64, kind: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target_hash {
        structural_transport_count_blocks(blocks, kind)
      } else { structural_transport_count_function(rest, target_hash, kind) }
    }
  }
}

fn structural_transport_count_callee_in_insts(insts: IrInstList, callee: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrCallI64(dst, actual, args) -> if actual == callee { 1 } else { 0 }
        _ -> 0
      }
      here + structural_transport_count_callee_in_insts(rest, callee)
    }
  }
}

fn structural_transport_count_callee_in_blocks(blocks: IrBlockList, callee: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> structural_transport_count_callee_in_insts(insts, callee) + structural_transport_count_callee_in_blocks(rest, callee)
    }
  }
}

fn structural_transport_count_callee(functions: IrFunctionList, target_hash: i64, callee: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target_hash { structural_transport_count_callee_in_blocks(blocks, callee) }
      else { structural_transport_count_callee(rest, target_hash, callee) }
    }
  }
}

fn structural_transport_function_param_count(functions: IrFunctionList, target_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target_hash { nparams }
      else { structural_transport_function_param_count(rest, target_hash) }
    }
  }
}

fn structural_transport_hash(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

fn structural_transport_abort_clause_fact_in_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrHandleI64(dst, src, effect_hash, clauses, nclauses, abort_block) -> match ir_handler_clause_body_list_nth(clauses, 0) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, cleanup_mask, transferred, resume_lanes, result_lanes, first_value, blocks) -> is_abortive * 100 + result_lanes * 10 + pipeline_value_lane_cleanup_mask_kind(cleanup_mask, 0)
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      _ -> structural_transport_abort_clause_fact_in_insts(rest)
    }
  }
}

fn structural_transport_abort_clause_fact_in_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let here = structural_transport_abort_clause_fact_in_insts(insts)
        if here != 0 { here } else { structural_transport_abort_clause_fact_in_blocks(rest) }
      }
    }
  }
}

fn structural_transport_abort_clause_fact(functions: IrFunctionList, target_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_hash { structural_transport_abort_clause_fact_in_blocks(blocks) }
        else { structural_transport_abort_clause_fact(rest, target_hash) }
      }
    }
  }
}

fn structural_transport_lower_source(src: str) -> IrFunctionList {
  pipeline_ir_functions(pipeline_lower_ir(pipeline_check_source(__str_ptr(src), __str_len(src))))
}

fn structural_transport_optimise_source(src: str) -> IrFunctionList {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let lowered = pipeline_lower_ir(typed)
  pipeline_ir_functions(pipeline_optimise_typed_ir(typed, lowered))
}

test "structural value retain and release are lane ordered" {
  let ty = structural_transport_type()
  let retains = pipeline_managed_retain_inst_list(50, ty, 100)
  let releases = pipeline_managed_release_inst_list(50, ty, 200)
  Test.assert_eq(ir_inst_list_len(retains), 3)
  Test.assert_eq(ir_inst_list_len(releases), 3)
  Test.assert_eq(structural_transport_call_at(retains, 0, 100, pipeline_rc_default_retain_hash(), 50), 1)
  Test.assert_eq(structural_transport_call_at(retains, 1, 101, pipeline_closure_default_retain_hash(), 52), 1)
  Test.assert_eq(structural_transport_call_at(retains, 2, 102, pipeline_rc_default_weak_retain_hash(), 53), 1)
  Test.assert_eq(structural_transport_call_at(releases, 0, 200, pipeline_rc_default_weak_release_hash(), 53), 1)
  Test.assert_eq(structural_transport_call_at(releases, 1, 201, pipeline_closure_default_release_hash(), 52), 1)
  Test.assert_eq(structural_transport_call_at(releases, 2, 202, pipeline_rc_default_release_hash(), 50), 1)
}

test "structural mutable slots carry every lane and clean managed lanes" {
  let ty = structural_transport_type()
  let init = pipeline_ir_slot_lane_init_insts(500, 50, 0, 4)
  let loads = pipeline_ir_slot_load_lane_insts(700, 500, 0, 4)
  let stores = pipeline_ir_slot_store_lane_insts(500, 80, 0, 4)
  let managed_loads = pipeline_ir_slot_managed_lane_load_insts(700, 500, ty, 0, 4)
  let cleanup = pipeline_managed_slot_cleanup_inst_list(500, ty, 900)
  Test.assert_eq(ir_inst_list_len(init), 8)
  Test.assert_eq(ir_inst_list_len(loads), 4)
  Test.assert_eq(ir_inst_list_len(stores), 4)
  Test.assert_eq(ir_inst_list_len(managed_loads), 3)
  Test.assert_eq(ir_inst_list_len(cleanup), 6)
  Test.assert_eq(structural_transport_load_at(cleanup, 0, 900, 503), 1)
  Test.assert_eq(structural_transport_call_at(cleanup, 1, 901, pipeline_rc_default_weak_release_hash(), 900), 1)
  Test.assert_eq(structural_transport_load_at(cleanup, 2, 902, 502), 1)
  Test.assert_eq(structural_transport_call_at(cleanup, 3, 903, pipeline_closure_default_release_hash(), 902), 1)
  Test.assert_eq(structural_transport_load_at(cleanup, 4, 904, 500), 1)
  Test.assert_eq(structural_transport_call_at(cleanup, 5, 905, pipeline_rc_default_release_hash(), 904), 1)
}

test "structural call return and handler cleanup facts preserve every lane" {
  let ty = structural_transport_type()
  let call_lanes = pipeline_ir_call_result_lane_insts(40, ty)
  let return_lanes = pipeline_ir_return_lane_insts(40, ty)
  let mask = pipeline_type_value_lane_cleanup_mask(ty)
  Test.assert_eq(ir_inst_list_len(call_lanes), 3)
  Test.assert_eq(ir_inst_list_len(return_lanes), 3)
  Test.assert_eq(pipeline_value_lane_cleanup_mask_kind(mask, 0), continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_value_lane_cleanup_mask_kind(mask, 1), continuation_cleanup_kind_none())
  Test.assert_eq(pipeline_value_lane_cleanup_mask_kind(mask, 2), continuation_cleanup_kind_closure())
  Test.assert_eq(pipeline_value_lane_cleanup_mask_kind(mask, 3), continuation_cleanup_kind_weak())
  Test.assert_eq(structural_transport_call_lane_at(call_lanes, 0, 41, 1), 1)
  Test.assert_eq(structural_transport_call_lane_at(call_lanes, 1, 42, 2), 1)
  Test.assert_eq(structural_transport_call_lane_at(call_lanes, 2, 43, 3), 1)
  Test.assert_eq(structural_transport_return_lane_at(return_lanes, 0, 1, 41), 1)
  Test.assert_eq(structural_transport_return_lane_at(return_lanes, 1, 2, 42), 1)
  Test.assert_eq(structural_transport_return_lane_at(return_lanes, 2, 3, 43), 1)
}

test "structural CFG normalization retains all managed lanes" {
  let ty = structural_transport_type()
  Test.assert_eq(pipeline_managed_arm_needs_retain(1, 0, ty), 1)
  Test.assert_eq(pipeline_managed_arm_needs_retain(0, 0, ty), 0)
  Test.assert_eq(pipeline_managed_arm_needs_retain(1, 1, ty), 0)
  Test.assert_eq(pipeline_managed_arm_needs_retain(1, 0, ty_record(nlist_new(), 0)), 0)
}

test "structural source lowering flattens calls returns CFG and mutable slots" {
  let src = "fn pair_id(value: (str, i64)) -> (str, i64) { value } fn pair_call(value: (str, i64)) -> (str, i64) { pair_id(value) } fn pair_choose(cond: bool, left: (str, i64), right: (str, i64)) -> (str, i64) { if cond { left } else { right } } fn pair_mut(value: (str, i64), next: (str, i64)) -> (str, i64) { let mut current = value current = next current } fn main() -> i64 { 0 }"
  let functions = structural_transport_lower_source(src)
  let pair_id = structural_transport_hash("pair_id")
  let pair_call = structural_transport_hash("pair_call")
  let pair_choose = structural_transport_hash("pair_choose")
  let pair_mut = structural_transport_hash("pair_mut")
  Test.assert_eq(structural_transport_function_param_count(functions, pair_id), 2)
  Test.assert_eq(structural_transport_function_param_count(functions, pair_call), 2)
  Test.assert_eq(structural_transport_function_param_count(functions, pair_choose), 5)
  Test.assert_eq(structural_transport_function_param_count(functions, pair_mut), 4)
  Test.assert_eq(structural_transport_count_function(functions, pair_call, 1), 1)
  Test.assert_eq(structural_transport_count_function(functions, pair_id, 2), 1)
  Test.assert_eq(structural_transport_count_function(functions, pair_call, 2), 1)
  Test.assert_eq(structural_transport_count_function(functions, pair_choose, 2), 1)
  Test.assert_eq(structural_transport_count_function(functions, pair_mut, 2), 1)
  -- Two structural mutable-value lanes plus the existing borrowed-param mask.
  Test.assert_eq(structural_transport_count_function(functions, pair_mut, 3), 3)
  Test.assert_eq(structural_transport_count_function(functions, pair_mut, 4), 4)
}

test "structural handler lowering carries result lanes and cleanup mask" {
  let src = "effect PairStop { fn stop(value: (str, i64)) -> (str, i64) } fn round(value: (str, i64)) -> (str, i64) { handle PairStop.stop(value) { PairStop.stop(arg) -> arg } } fn main() -> i64 { 0 }"
  let functions = structural_transport_lower_source(src)
  Test.assert_eq(structural_transport_abort_clause_fact(functions, structural_transport_hash("round")), 121)
}

test "structural literal call ownership emits one balancing release" {
  let src = "fn consume(value: (str, i64)) -> i64 { 0 } fn caller(name: str) -> i64 { consume((name, 38)) } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let fns = pipeline_typed_fns(typed)
  let expected_params = pipeline_fns_lookup_params(fns, __str_ptr(src), __str_ptr(src) - __str_ptr(src) + 3, 7)
  let pair = pipeline_fns_lookup_pair(fns, __str_ptr(src), __str_ptr(src) - __str_ptr(src) + 3, 7)
  let functions = structural_transport_lower_source(src)
  let optimised = structural_transport_optimise_source(src)
  let raw_retains = structural_transport_count_callee(functions, structural_transport_hash("caller"), pipeline_rc_default_retain_hash())
  let raw_releases = structural_transport_count_callee(functions, structural_transport_hash("caller"), pipeline_rc_default_release_hash())
  let opt_retains = structural_transport_count_callee(optimised, structural_transport_hash("caller"), pipeline_rc_default_retain_hash())
  let opt_releases = structural_transport_count_callee(optimised, structural_transport_hash("caller"), pipeline_rc_default_release_hash())
  let direct_mask = pipeline_call_borrowable_param_mask(fns, pipeline_fns_context_ttable(fns), __str_ptr(src), 3, 7, expected_params, 0)
  let effective_mask = pipeline_fn_effective_borrowable_param_mask_from_pair(fns, pair, expected_params, 0)
  Test.assert_eq(raw_retains, 1)
  Test.assert_eq(raw_releases, 2)
  Test.assert_eq(opt_retains, 1)
  Test.assert_eq(opt_releases, 2)
  Test.assert_eq(direct_mask, 1)
  Test.assert_eq(effective_mask, 1)
}
