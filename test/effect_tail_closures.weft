use stdlib/state as state
use stdlib/state.{State}
use test/module_fixtures/effect_tail_forward as other

effect Tick { fn next() -> i64 }
effect Notice { fn hit() -> nil }

fn forward<E>(body: () -[E]> i64) -[E]> i64 {
  let wrapped = () => body()
  wrapped()
}

fn contextual<E>(body: () -[E]> i64) -[E]> i64 {
  forward(() => body())
}

fn observed<E>(body: () -[Notice, E]> i64) -[E]> i64 {
  let wrapped = () => handle body() { Notice.hit() -> resume(nil) }
  wrapped()
}

fn counted<E>(body: () -[E]> i64) -[E]> (i64, i64) {
  state.run(0, () => {
    State<i64>.put(1)
    body()
  })
}

fn repeated<E>(body: () -[E]> i64) -[E]> i64 {
  let wrapped = () => body() + body()
  wrapped()
}

fn typed_forward<T, E>(value: T, body: (T) -[E]> i64) -[E]> i64 {
  let wrapped = () => body(value)
  wrapped()
}

fn qualified<E>(body: () -[E]> i64) -[E]> i64 {
  let wrapped = () => other.forward(body)
  wrapped()
}

type Callback<E> { callback: () -[E]> i64 }
impl<E> Callback<E> {
  fn read(self) -[E]> i64 { (self.callback)() }
}

fn through_method<E>(callback: Callback<E>) -[E]> i64 {
  let wrapped = () => callback.read()
  wrapped()
}

fn on_completion<E>(body: () -[E]> i64) -[E]> i64 {
  let wrapped = () => handle { Notice.hit(); 2 } {
    Notice.hit() -> resume(nil)
    return value -> value + body()
  }
  wrapped()
}

fn in_clause<E>(body: () -[E]> i64) -[E]> i64 {
  let wrapped = () => handle { Notice.hit(); 42 } {
    Notice.hit() -> { body(); resume(nil) }
  }
  wrapped()
}

test "let-bound closures preserve an enclosing effect parameter" {
  let value = handle forward(() => Tick.next()) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
  Test.assert_eq(forward(() => 7), 7)
}

test "contextual and nested closures preserve open effects" {
  let value = handle contextual(() => forward(() => Tick.next())) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
}

test "local handlers discharge concrete effects without erasing the open tail" {
  let value = handle observed(() => { Notice.hit(); Tick.next() }) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
}

test "a generic state handler preserves the callback residual effect" {
  let (value, calls) = handle counted(() => Tick.next()) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
  Test.assert_eq(calls, 1)
}

test "repeated uses share one open effect parameter" {
  let value = handle repeated(() => Tick.next()) { Tick.next() -> resume(21) }
  Test.assert_eq(value, 42)
}

test "effect parameters retain identity alongside ordinary type parameters" {
  let value = handle typed_forward(2, (extra: i64) => extra + Tick.next()) { Tick.next() -> resume(40) }
  Test.assert_eq(value, 42)
}

test "qualified calls preserve their instantiated open effect" {
  let value = handle qualified(() => Tick.next()) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
}

test "method and projected function calls retain open effects" {
  let callback = Callback { callback: () => Tick.next() }
  let value = handle through_method(callback) { Tick.next() -> resume(42) }
  Test.assert_eq(value, 42)
}

test "handler completion clauses preserve residual callback effects" {
  let value = handle on_completion(() => Tick.next()) { Tick.next() -> resume(40) }
  Test.assert_eq(value, 42)
}

test "operation clauses preserve residual callback effects" {
  let (value, calls) = state.run(0, () => in_clause(() => { state.modify((count: i64) => count + 1); 0 }))
  Test.assert_eq(value, 42)
  Test.assert_eq(calls, 1)
}
