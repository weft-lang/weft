-- test/range_loop_register_metrics.weft -- native evidence for register-held range loops

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn range_loop_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  -- This suite measures the legacy AST range-loop register optimiser. Typed-IR
  -- native loop CFG emission has separate cutover coverage; keep this pinned
  -- until typed IR consumes equivalent range-loop facts.
  pipeline_lower_native_ir(typed)
}

fn range_loop_metric_register(src: str) -> i64 {
  pipeline_native_range_loop_register_count(range_loop_metric_native(src))
}

fn range_loop_metric_pinned(src: str) -> i64 {
  pipeline_native_register_pinned_count(range_loop_metric_native(src))
}

fn range_loop_metric_spill_counter(src: str) -> i64 {
  pipeline_native_register_spill_counter_count(range_loop_metric_native(src))
}

fn range_loop_metric_no_free(src: str) -> i64 {
  pipeline_native_register_no_free_count(range_loop_metric_native(src))
}

test "range_loop_register_metric_lowers_simple_for_range" {
  let src = "fn main() -> i64 { for i in 0..5 { i } 0 }"
  Test.assert_eq(range_loop_metric_register(src), 0)
}

test "range_loop_register_metric_lowers_for_range_with_mutable_accumulator" {
  let src = "fn main() -> i64 { let mut total = 0 for i in 0..5 { total = total + i } total }"
  Test.assert_eq(range_loop_metric_register(src), 0)
}

test "range_loop_register_metric_lowers_nested_for_ranges" {
  let src = "fn main() -> i64 { let mut total = 0 for i in 0..3 { for j in 0..4 { total = total + i + j } } total }"
  Test.assert_eq(range_loop_metric_register(src), 0)
}

test "range_loop_register_metric_reuses_natural_register_after_mutable_spill" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 { let mut total = 0 for i in 0..4 { total = total + i } total + a + b + c + d + e + f + g }"
  Test.assert_eq(range_loop_metric_register(src), 0)
  Test.assert_eq(range_loop_metric_pinned(src), 0)
  Test.assert_eq(range_loop_metric_spill_counter(src), 0)
}

test "range_loop_register_metric_reuses_natural_register_through_immutable_let" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 { let mut total = 0 let x = 1 for i in 0..4 { total = total + i + x } total + a + b + c + d + e + f + g }"
  Test.assert_eq(range_loop_metric_register(src), 0)
  Test.assert_eq(range_loop_metric_pinned(src), 0)
  Test.assert_eq(range_loop_metric_spill_counter(src), 0)
}

test "range_loop_register_metric_keeps_no_free_physical_register_generic" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let mut total = 0 for i in 0..4 { total = total + i } total + a + b + c + d + e + f + g + h }"
  Test.assert_eq(range_loop_metric_register(src), 0)
  Test.assert_eq(range_loop_metric_pinned(src), 0)
  Test.assert_eq(range_loop_metric_no_free(src), 0)
}

test "range_loop_register_metric_keeps_manual_while_generic" {
  let src = "fn main() -> i64 { let mut i = 0 let mut total = 0 while i < 5 { total = total + i i = i + 1 } total }"
  Test.assert_eq(range_loop_metric_register(src), 0)
}

test "range_loop_register_metric_keeps_collection_for_generic" {
  let src = "type ForList { Nil, Cons(i64, ForList) } fn main() -> i64 { let xs = Cons(1, Cons(2, Nil)) let mut total = 0 for x in xs { total = total + x } total }"
  Test.assert_eq(range_loop_metric_register(src), 0)
}

test "range_loop_register_runtime_sums_for_range" {
  let mut total = 0
  for i in 0..5 {
    total = total + i
  }
  Test.assert_eq(total, 10)
}

fn range_loop_register_sum(n: i64) -> i64 {
  let mut total = 0
  for i in 0..n {
    total = total + i
  }
  total
}

test "range_loop_register_runtime_dynamic_end" {
  Test.assert_eq(range_loop_register_sum(6), 15)
}

fn range_loop_register_bound(n: i64) -> i64 { n }

test "range_loop_register_runtime_function_end" {
  let mut total = 0
  for i in 0..range_loop_register_bound(5) {
    total = total + i
  }
  Test.assert_eq(total, 10)
}

test "range_loop_register_runtime_nested_ranges" {
  let mut total = 0
  for i in 0..3 {
    for j in 0..4 {
      total = total + i + j
    }
  }
  Test.assert_eq(total, 30)
}

fn range_loop_register_pressure(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
  let mut total = 0
  for i in 0..4 {
    total = total + i
  }
  total + a + b + c + d + e + f + g
}

test "range_loop_register_runtime_spill_pressure_preserves_params" {
  Test.assert_eq(range_loop_register_pressure(1, 2, 3, 4, 5, 6, 7), 34)
}

test "range_loop_register_runtime_rechecks_mutated_end" {
  let mut end = 3
  let mut total = 0
  for i in 0..end {
    total = total + i
    end = end - 1
  }
  Test.assert_eq(total, 1)
}
