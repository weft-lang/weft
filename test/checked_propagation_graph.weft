-- Checked propagation retains semantic effects and projections, not sugar syntax.

use compiler/project/identity.{
  DeclarationIdentity,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleIdentity,
  RecordFieldDeclaration,
  TypeDeclaration,
  named_module_identity
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticI64,
  SemanticNil,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_id_eq,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  SemanticTypeCatalogInserted,
  semantic_type_catalog_builder
}
use compiler/weft/check/body/graph.{*}
use compiler/weft/check/body/propagation.{*}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn types(
  module: ModuleIdentity,
  dependency: ModuleIdentity
) -> (SemanticTypeCatalog, SemanticTypeId, SemanticTypeId) {
  let local_builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (local_builder, local) = local_builder.primitive(SemanticNil)
  let dependency_builder = semantic_type_graph_builder(semantic_type_segment_id(dependency))
  let (dependency_builder, imported) = dependency_builder.primitive(SemanticI64)
  let catalog = semantic_type_catalog_builder(2)
  let catalog = match catalog.insert(local_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected local semantic type segment")
  }
  let catalog = match catalog.insert(dependency_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected imported semantic type segment")
  }
  (catalog.freeze(), local, imported)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn field_declaration(module: ModuleIdentity) -> DeclarationIdentity {
  let owner = ModuleDeclarationIdentity(
    module,
    TypeDeclaration,
    source_from_text("Record").all()
  )
  MemberDeclarationIdentity(
    owner,
    RecordFieldDeclaration,
    source_from_text("value").all()
  )
}

test "checked failure propagation retains imported atom and operator range" {
  let module = named_module_identity("fixture/failure_propagation", 71)
  let dependency = named_module_identity("dependency/failure_atom", 44)
  let (catalog, local, imported) = types(module, dependency)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("result?"),
    catalog,
    2
  )
  let (expressions, value) = expressions.integer(7, imported, range(0, 6))
  let propagation = checked_propagation_builder(expressions, 1)
  let (propagation, detail) = propagation.failure(
    expressions,
    CheckedFailurePropagation {
      value: value,
      atom: imported,
      operator_range: range(6, 7)
    }
  )
  let (expressions, result) = expressions.failure_propagation(
    detail,
    local,
    range(0, 7)
  )
  let propagation_graph = propagation.freeze()
  let expression_graph = expressions.freeze()

  Test.assert_true(
    match propagation_graph.inspect(detail) {
      CheckedFailurePropagationDetail(checked) ->
        checked_expr_id_eq(checked.value, value) and
        semantic_type_id_eq(checked.atom, imported) and
        checked.operator_range.start == 6 and checked.operator_range.end == 7
      _ -> false
    }
  )
  Test.assert_true(
    match expression_graph.inspect(result).node {
      CheckedFailurePropagationNode(found) -> checked_propagation_expr_id_ordinal(found) ==
        checked_propagation_expr_id_ordinal(detail)
      _ -> false
    }
  )
}

test "checked optional projections retain declared and structural layout facts" {
  let module = named_module_identity("fixture/optional_projection", 71)
  let dependency = named_module_identity("dependency/optional_atom", 44)
  let (catalog, local, imported) = types(module, dependency)
  let expressions = checked_expr_graph_builder(
    module,
    source_from_text("record?.value"),
    catalog,
    3
  )
  let (expressions, base) = expressions.integer(1, imported, range(0, 6))
  let propagation = checked_propagation_builder(expressions, 3)
  let declaration = field_declaration(dependency)
  let (propagation, declared_detail) = propagation.declared_optional_projection(
    expressions,
    CheckedOptionalProjection {
      base: base,
      projection: CheckedDeclaredProjection(declaration, 3),
      atom: imported,
      field_range: range(8, 13)
    }
  )
  let (expressions, declared) = expressions.declared_optional_projection(
    declared_detail,
    local,
    range(0, 13)
  )
  let (propagation, structural_detail) = propagation.structural_optional_projection(
    expressions,
    CheckedOptionalProjection {
      base: base,
      projection: CheckedStructuralProjection(991, CheckedStructuralFieldWordOffset(5)),
      atom: local,
      field_range: range(8, 13)
    }
  )
  let (expressions, structural) = expressions.structural_optional_projection(
    structural_detail,
    local,
    range(0, 13)
  )
  let (propagation, unplaced_detail) = propagation.structural_optional_projection(
    expressions,
    CheckedOptionalProjection {
      base: base,
      projection: CheckedStructuralProjection(992, CheckedStructuralFieldUnplaced("value")),
      atom: local,
      field_range: range(8, 13)
    }
  )
  let (expressions, unplaced) = expressions.structural_optional_projection(
    unplaced_detail,
    local,
    range(0, 13)
  )
  let propagation_graph = propagation.freeze()
  let expression_graph = expressions.freeze()

  Test.assert_true(
    match propagation_graph.optional_projection(declared_detail) {
      checked -> match checked.projection {
        CheckedDeclaredProjection(field, 3) ->
          checked_expr_id_eq(checked.base, base) and
          declaration_identity_eq(field, declaration) and
          semantic_type_id_eq(checked.atom, imported) and
          checked.field_range.start == 8 and checked.field_range.end == 13
        _ -> false
      }
    }
  )
  Test.assert_true(
    match propagation_graph.optional_projection(structural_detail) {
      checked -> match checked.projection {
        CheckedStructuralProjection(991, CheckedStructuralFieldWordOffset(5)) ->
          checked_expr_id_eq(checked.base, base) and semantic_type_id_eq(checked.atom, local)
        _ -> false
      }
    }
  )
  Test.assert_true(
    match propagation_graph.optional_projection(unplaced_detail).projection {
      CheckedStructuralProjection(992, CheckedStructuralFieldUnplaced(name)) -> name == "value"
      _ -> false
    }
  )
  Test.assert_true(
    match expression_graph.inspect(unplaced).node {
      CheckedOptionalProjectionNode(found) ->
        checked_propagation_expr_id_ordinal(found) ==
        checked_propagation_expr_id_ordinal(unplaced_detail)
      _ -> false
    }
  )
  Test.assert_true(
    match (expression_graph.inspect(declared).node, expression_graph.inspect(structural).node) {
      (CheckedOptionalProjectionNode(left), CheckedOptionalProjectionNode(right)) ->
        checked_propagation_expr_id_ordinal(left) ==
        checked_propagation_expr_id_ordinal(declared_detail) and
        checked_propagation_expr_id_ordinal(right) ==
        checked_propagation_expr_id_ordinal(structural_detail)
      _ -> false
    }
  )
}
