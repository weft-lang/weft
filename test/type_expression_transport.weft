-- Syntax and checked types retain their meaning through typed IR transport.
use compiler/ir.{*}
use compiler/types.{*}
use compiler/type_registry.{ttable_new, ttable_register_source}
use compiler/module.{module_decl_fact_register, module_decl_namespace_type, module_decl_namespace_effect, module_visibility_public}
use compiler/lib.{nlist_new, nlist_add, nlist_len, nlist_get, node_new, node_f1, node_f2}

fn transported_type(ty: i64) -> i64 {
  ty |> type_expr_from_node() |> type_expr_to_node()
}

fn assert_type_transport(ty: i64) -[Test]> nil {
  let typed = type_expr_from_node(ty)
  Test.assert_true(ty_eq(type_expr_to_node(typed), ty))
  Test.assert_eq(type_expr_tree_unknown_count(typed), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(typed), 0)
  nil
}

fn transport_declaration(tt: i64, source: str, path: str) -> i64 {
  ttable_register_source(tt, __str_ptr(source), __str_len(source), __str_ptr(path), __str_len(path))
  module_decl_fact_register(tt, __str_ptr(source), 0, module_decl_namespace_type(), 0, 3, module_visibility_public())
}

test "qualified type transport preserves the complete source occurrence" {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  let base = ty_named_app_from(ty_named_surface(71, ty_i64(), 4097, 7), args)
  let qualified = ty_assoc_at(base, 73, 4097, 12)
  let restored = transported_type(qualified)
  Test.assert_eq(ty_assoc_source_start(restored), 4097)
  Test.assert_eq(ty_assoc_source_len(restored), 12)
  Test.assert_eq(ty_named_surface_len(ty_f1(restored)), 7)
  Test.assert_eq(nlist_len(ty_f3(ty_f1(restored))), 1)
  Test.assert_true(ty_eq(nlist_get(ty_f3(ty_f1(restored)), 0), ty_i64()))
  Test.assert_true(match type_expr_from_node(qualified) {
    SourceAssociatedTypeExpr(_, 73, range) -> range.start == 4097 and range.length == 12
    _ -> false
  })
  assert_type_transport(qualified)
}

test "effect substitution renames a tail into the caller parameter context" {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(79))
  let source = ty_effect_sig_with_tail(effects, 1)
  let subst = subst_new()
  subst_add(subst, 0, ty_var(3))
  let renamed = ty_subst(source, subst)
  Test.assert_eq(ty_f2(renamed), 4)
  Test.assert_true(effect_atom_eq(nlist_get(ty_f1(renamed), 0), nlist_get(effects, 0)))
  Test.assert_eq(ty_f2(source), 1)
}

test "function type transport preserves parameterized effects and their tail" {
  let arguments = nlist_new()
  nlist_add(arguments, ty_i64())
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app_args(71, arguments))
  let signature = ty_effect_sig_with_tail(effects, 91)
  let parameters = nlist_new()
  nlist_add(parameters, ty_str())
  let function = ty_fn(parameters, ty_bool(), signature)
  let restored = transported_type(function)
  Test.assert_true(effect_is_subset(ty_f3(restored), signature))
  Test.assert_true(effect_is_subset(signature, ty_f3(restored)))
  Test.assert_eq(ty_f2(ty_f3(restored)), 91)
  let atoms = ty_f1(ty_f3(restored))
  Test.assert_eq(nlist_len(atoms), 1)
  Test.assert_true(if nlist_len(atoms) == 1 {
    effect_atom_eq(nlist_get(atoms, 0), nlist_get(effects, 0))
  } else { false })
  Test.assert_true(ty_eq(restored, function))
}

test "nested function type transport retains both capability contracts" {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(73))
  let callback = ty_fn(nlist_new(), ty_i64(), ty_effect_sig(effects))
  let parameters = nlist_new()
  nlist_add(parameters, callback)
  let function = ty_fn(parameters, callback, ty_effect_pure())
  Test.assert_true(ty_eq(transported_type(function), function))
}

test "function type transport preserves purity and distinct effect instantiations" {
  let pure = ty_fn(nlist_new(), ty_nil(), ty_effect_pure())
  Test.assert_true(ty_eq(transported_type(pure), pure))
  let first_args = nlist_new()
  nlist_add(first_args, ty_i64())
  let second_args = nlist_new()
  nlist_add(second_args, ty_str())
  let first_effects = nlist_new()
  nlist_add(first_effects, ty_effect_app_args(79, first_args))
  let second_effects = nlist_new()
  nlist_add(second_effects, ty_effect_app_args(79, second_args))
  let first = ty_fn(nlist_new(), ty_nil(), ty_effect_sig(first_effects))
  let second = ty_fn(nlist_new(), ty_nil(), ty_effect_sig(second_effects))
  Test.assert_true(ty_eq(transported_type(first), first))
  Test.assert_true(ty_eq(transported_type(second), second))
  Test.assert_true(not ty_eq(transported_type(first), transported_type(second)))
  Test.assert_true(not ty_eq(transported_type(first), pure))
}

test "function type transport preserves mixed nested parameter shapes" {
  let mut callback = ty_fn(nlist_new(), ty_bool(), ty_effect_pure())
  for depth in 0..8 {
    let arguments = nlist_new()
    nlist_add(arguments, ty_array(ty_i64(), depth + 1))
    nlist_add(arguments, ty_slice(ty_str()))
    nlist_add(arguments, callback)
    let effects = nlist_new()
    nlist_add(effects, ty_effect_app(83 + depth))
    let function = ty_fn(arguments, callback, ty_effect_sig(effects))
    Test.assert_true(ty_eq(transported_type(function), function))
    callback = function
  }
}

test "type transport retains set operations and type variables" {
  assert_type_transport(ty_never())
  assert_type_transport(ty_any())
  assert_type_transport(ty_i64())
  assert_type_transport(ty_var(41))
  assert_type_transport(ty_trait(43))
  assert_type_transport(ty_union(ty_i64(), ty_nil()))
  assert_type_transport(ty_inter(ty_str(), ty_compl(ty_var(47))))
  assert_type_transport(ty_assoc(ty_var(53), 59))
  assert_type_transport(ty_continuation(ty_i64(), ty_str()))
}

test "type transport retains access and ownership distinctions" {
  assert_type_transport(ty_weak(ty_str()))
  assert_type_transport(ty_arc(ty_str()))
  assert_type_transport(ty_unique(ty_str()))
  assert_type_transport(ty_owned(ty_str()))
  for access in 0..2 {
    assert_type_transport(ty_ptr_with_mut(ty_i64(), access))
    assert_type_transport(ty_slice_with_mut(ty_str(), access))
    assert_type_transport(ty_borrow_with_mut(ty_array(ty_i64(), 3), access))
  }
  assert_type_transport(ty_array(ty_str(), 0))
  assert_type_transport(ty_array(ty_str(), 1024))
}

test "record type transport retains field provenance and layout" {
  let fields = nlist_new()
  nlist_add(fields, ty_record_field(61, ty_str(), 17, 5))
  nlist_add(fields, ty_record_field(67, ty_i64(), 31, 9))
  for extent in 0..2 {
    for layout in 0..2 {
      let record = ty_record_with_kind(fields, extent, layout)
      assert_type_transport(record)
      let restored = ty_record_fields(transported_type(record))
      Test.assert_eq(ty_record_field_name_start(nlist_get(restored, 0)), 17)
      Test.assert_eq(ty_record_field_name_len(nlist_get(restored, 0)), 5)
      Test.assert_eq(ty_record_field_name_start(nlist_get(restored, 1)), 31)
      Test.assert_eq(ty_record_field_name_len(nlist_get(restored, 1)), 9)
    }
  }
  assert_type_transport(ty_record(nlist_new(), 0))
}

test "named generic type transport separates arguments from absent representation" {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  nlist_add(args, ty_str())
  let named = ty_named_app(71, 0, args)
  assert_type_transport(named)
  let restored = transported_type(named)
  Test.assert_eq(ty_f2(restored), 0)
  Test.assert_eq(nlist_len(ty_f3(restored)), 2)
  Test.assert_true(ty_eq(nlist_get(ty_f3(restored), 0), ty_i64()))
  Test.assert_true(ty_eq(nlist_get(ty_f3(restored), 1), ty_str()))
  Test.assert_true(match type_expr_from_node(named) {
    NamedTypeExpr(71, NoTypeRepresentation, TypeExprListCons(PrimitiveTypeExpr(_), _), UnresolvedTypeOrigin) -> true
    _ -> false
  })
  assert_type_transport(ty_named(73, ty_str()))
}

test "named type transport preserves source ranges and nominal identities" {
  let surface = ty_named_surface(79, 0, 4097, 13)
  let restored = transported_type(surface)
  Test.assert_eq(ty_named_surface_start(restored), 4097)
  Test.assert_eq(ty_named_surface_len(restored), 13)
  Test.assert_true(match type_expr_from_node(surface) {
    NamedTypeExpr(79, NoTypeRepresentation, TypeExprListNil, SourceTypeOrigin(range)) -> range.start == 4097 and range.length == 13
    _ -> false
  })
  let tt = ttable_new()
  let opaque_decl = transport_declaration(tt, "Box", "pkg/opaque.weft")
  let nominal_decl = transport_declaration(tt, "Box ", "pkg/nominal.weft")
  let payloadless_decl = transport_declaration(tt, "Box  ", "pkg/payloadless.weft")
  let opaque_type = ty_named_with_metadata(83, ty_str(), 0, ty_named_opaque_meta(opaque_decl))
  let nominal = ty_named_with_metadata(83, ty_i64(), 0, ty_named_nominal_meta(nominal_decl))
  let payloadless = ty_named_with_metadata(83, 0, 0, ty_named_payloadless_variant_meta(payloadless_decl))
  assert_type_transport(opaque_type)
  assert_type_transport(nominal)
  assert_type_transport(payloadless)
  Test.assert_eq(ty_named_opaque_declaration(transported_type(opaque_type)), opaque_decl)
  Test.assert_true(ty_eq(ty_named_opaque_representation(transported_type(opaque_type)), ty_str()))
  Test.assert_eq(ty_named_nominal_declaration(transported_type(nominal)), nominal_decl)
  Test.assert_eq(ty_named_payloadless_variant_declaration(transported_type(payloadless)), payloadless_decl)
  Test.assert_true(not ty_eq(transported_type(opaque_type), transported_type(nominal)))
}

test "variant type transport preserves absent and present payloads" {
  let empty = transported_type(ty_new(8, 103, 0, 0, 0))
  Test.assert_eq(ty_tag(empty), 8)
  Test.assert_eq(ty_f1(empty), 103)
  Test.assert_eq(ty_f2(empty), 0)
  let full = transported_type(ty_new(8, 107, ty_array(ty_i64(), 5), 0, 0))
  Test.assert_eq(ty_f1(full), 107)
  Test.assert_true(ty_eq(ty_f2(full), ty_array(ty_i64(), 5)))
}

test "qualified effect syntax retains both names and type arguments" {
  let args = nlist_new()
  nlist_add(args, ty_slice(ty_str()))
  let qualified = ty_surface_qualified_effect(109, 7, 117, 11, args)
  let typed = type_expr_from_node(qualified)
  Test.assert_eq(type_expr_tree_unknown_count(typed), 0)
  let restored = type_expr_to_node(typed)
  Test.assert_eq(ty_tag(restored), 26)
  Test.assert_eq(ty_f1(restored), 109)
  Test.assert_eq(ty_f2(restored), 7)
  Test.assert_eq(ty_f3(restored), 117)
  Test.assert_eq(node_f1(ty_f4(restored)), 11)
  Test.assert_true(ty_eq(nlist_get(node_f2(ty_f4(restored)), 0), ty_slice(ty_str())))
  let bare = transported_type(ty_surface_qualified_effect(2, 3, 6, 5, 0))
  Test.assert_eq(node_f2(ty_f4(bare)), 0)
}

test "trait constraints retain qualified syntax associated bindings and provenance" {
  let constraint = ty_surface_qualified_trait(131, 3, 135, 7)
  let bindings = nlist_new()
  nlist_add(bindings, trait_assoc_binding(137, ty_str(), 143, 4))
  nlist_add(bindings, trait_assoc_binding(139, ty_array(ty_i64(), 2), 151, 6))
  let typed = type_expr_from_node(ty_trait_constraint(constraint, bindings))
  Test.assert_eq(type_expr_tree_unknown_count(typed), 0)
  let restored = type_expr_to_node(typed)
  Test.assert_eq(ty_tag(restored), 30)
  let base = trait_atom_base(restored)
  Test.assert_eq(ty_tag(base), 28)
  Test.assert_eq(ty_f1(base), 131)
  Test.assert_eq(ty_f2(base), 3)
  Test.assert_eq(ty_f3(base), 135)
  Test.assert_eq(ty_f4(base), 7)
  let restored_bindings = trait_atom_assoc_bindings(restored)
  Test.assert_eq(nlist_len(restored_bindings), 2)
  Test.assert_eq(trait_assoc_binding_start(nlist_get(restored_bindings, 0)), 143)
  Test.assert_eq(trait_assoc_binding_len(nlist_get(restored_bindings, 1)), 6)
  Test.assert_true(ty_eq(trait_atom_assoc_type(restored, 137), ty_str()))
  Test.assert_true(ty_eq(trait_atom_assoc_type(restored, 139), ty_array(ty_i64(), 2)))
  assert_type_transport(ty_qualified_trait(157))
}

test "declaration effect signatures retain distinct parameter instantiations" {
  let first_args = nlist_new()
  nlist_add(first_args, ty_i64())
  let second_args = nlist_new()
  nlist_add(second_args, ty_str())
  let atoms = nlist_new()
  nlist_add(atoms, ty_effect_app_args(163, first_args))
  nlist_add(atoms, ty_effect_app_args(163, second_args))
  nlist_add(atoms, ty_effect_app(167))
  let signature = effect_sig_from_node(ty_effect_sig_with_tail(atoms, 173))
  let restored = effect_sig_to_node(signature)
  Test.assert_eq(ty_f2(restored), 173)
  Test.assert_eq(nlist_len(ty_f1(restored)), 3)
  for i in 0..3 {
    Test.assert_true(effect_atom_eq(nlist_get(atoms, i), nlist_get(ty_f1(restored), i)))
  }
  Test.assert_true(not effect_atom_eq(nlist_get(ty_f1(restored), 0), nlist_get(ty_f1(restored), 1)))
  Test.assert_eq(effect_sig_contains_hash(signature, 163), 1)
  Test.assert_eq(effect_sig_contains_hash(signature, 179), 0)
  Test.assert_eq(effect_sig_tree_unknown_count(signature), 0)
  let pure = effect_sig_to_node(effect_sig_from_node(ty_effect_pure()))
  Test.assert_eq(nlist_len(ty_f1(pure)), 0)
  Test.assert_eq(ty_f2(pure), 0)
}

test "missing and unsupported type syntax remains explicit through transport" {
  Test.assert_true(match type_expr_from_node(0) { MissingTypeExpr -> true, _ -> false })
  Test.assert_eq(type_expr_tree_unknown_count(type_expr_from_node(0)), 1)
  Test.assert_eq(type_expr_to_node(UnknownTypeExpr(999)), 0)
  let unknown_origin = type_expr_from_node(ty_named_with_metadata(193, ty_i64(), 0, node_new(999, 0, 0, 0, 0)))
  Test.assert_eq(type_expr_tree_unknown_count(unknown_origin), 1)
  Test.assert_eq(type_expr_to_node(unknown_origin), 0)
  Test.assert_true(match type_expr_from_node(ty_new(999, 0, 0, 0, 0)) { UnknownTypeExpr(999) -> true, _ -> false })
  let unsupported = transported_type(ty_unsupported(181))
  Test.assert_eq(ty_tag(unsupported), 20)
  Test.assert_eq(ty_f1(unsupported), 181)
  let incomplete = FunctionTypeExpr(TypeExprListNil, MissingTypeExpr, EffectSetTypeExpr(TypeExprListNil, 0))
  Test.assert_eq(type_expr_tree_unknown_count(incomplete), 1)
  Test.assert_eq(effect_sig_to_node(effect_sig_from_node(ty_i64())), 0)
  Test.assert_eq(effect_sig_tree_unknown_count(MissingEffectSig), 1)
  let unknown_argument = EffectSig(TypeExprListCons(EffectApplicationTypeExpr(191, TypeExprListCons(UnknownTypeExpr(999), TypeExprListNil)), TypeExprListNil), 0)
  Test.assert_eq(effect_sig_tree_unknown_count(unknown_argument), 1)
}

test "unqualified effect syntax retains source ranges through transport and substitution" {
  let args = nlist_new()
  nlist_add(args, ty_var(2))
  let atom = ty_surface_effect_app(71, args, 4097, 4)
  let restored = transported_type(atom)
  Test.assert_eq(ty_f3(restored), 4097)
  Test.assert_eq(ty_f4(restored), 4)
  let subst = subst_new()
  subst_add(subst, 2, ty_str())
  let instantiated = ty_subst(restored, subst)
  Test.assert_eq(ty_f3(instantiated), 4097)
  Test.assert_eq(ty_f4(instantiated), 4)
  Test.assert_true(ty_eq(nlist_get(ty_f2(instantiated), 0), ty_str()))
  assert_type_transport(atom)
}

fn effect_transport_declaration(tt: i64, source: str, path: str) -> i64 {
  ttable_register_source(tt, __str_ptr(source), __str_len(source), __str_ptr(path), __str_len(path))
  module_decl_fact_register(tt, __str_ptr(source), 0, module_decl_namespace_effect(), 0, 4, module_visibility_public())
}

test "effect identity survives transport and gives deterministic specialization keys" {
  let tt = ttable_new()
  let left = effect_transport_declaration(tt, "Read left", "effects/left.weft")
  let right = effect_transport_declaration(tt, "Read right", "effects/right.weft")
  let left_atom = ty_qualified_effect_app(left, 0)
  let right_atom = ty_qualified_effect_app(right, 0)
  Test.assert_false(effect_atom_eq(left_atom, right_atom))
  Test.assert_true(ty_semantic_hash(left_atom) != ty_semantic_hash(right_atom))
  Test.assert_true(effect_atom_eq(transported_type(left_atom), left_atom))
  let independent = effect_transport_declaration(ttable_new(), "Read left", "effects/left.weft")
  Test.assert_eq(ty_semantic_hash(left_atom), ty_semantic_hash(ty_qualified_effect_app(independent, 0)))
  assert_type_transport(left_atom)
}

test "checked effect references retain exact declaration facts in expression transport" {
  let tt = ttable_new()
  let declaration = effect_transport_declaration(tt, "Read", "effects/local.weft")
  let expr = ResolvedEffectIdent(4097, 4, declaration)
  Test.assert_true(match expr |> expr_to_node() |> expr_from_node() {
    ResolvedEffectIdent(start, length, restored) -> start == 4097 and length == 4 and restored == declaration
    _ -> false
  })
}
