-- Compiler-owned spellings hash exactly like the source spans they name, so
-- tables keyed by either kind of name agree.

use compiler/types/names.{str_hash, str_hash_text}

fn span_hash(text: str) -> i64 {
  str_hash(__str_ptr(text), 0, __str_len(text))
}

test "text hashes equal source span hashes on both sides of each word boundary" {
  for text in [
    "",
    "a",
    "abcdefg",
    "abcdefgh",
    "abcdefghi",
    "abcdefghijklmnop",
    "rc_default_release_promoted",
    "héλ-ünïcödé ✓",
    "unsafe_transmute"
  ] {
    Test.assert_eq(str_hash_text(text), span_hash(text))
  }
}

test "text hashes follow djb2 and stay nonnegative after wrapping" {
  Test.assert_eq(str_hash_text(""), 5381)
  Test.assert_eq(str_hash_text("a"), 5381 * 33 + 97)
  Test.assert_eq(str_hash_text("ab"), (5381 * 33 + 97) * 33 + 98)
  -- Long names wrap i64 arithmetic; the key is still its absolute value.
  let long = "closure_default_release_promoted_with_a_long_suffix"
  Test.assert_true(str_hash_text(long) >= 0)
  Test.assert_eq(str_hash_text(long), span_hash(long))
  Test.assert_false(str_hash_text("ab") == str_hash_text("ba"))
}
