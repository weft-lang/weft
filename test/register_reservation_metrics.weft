-- test/register_reservation_metrics.weft -- native register reservation reason buckets

use "compiler/codegen.weft"

fn register_scope_with_phys(phys: i64) -> i64 {
  scope_push_typed(scope_new(), phys, 1, phys, ty_i64())
}

fn register_scope_with_phys2(a: i64, b: i64) -> i64 {
  scope_push_typed(register_scope_with_phys(a), b, 1, b, ty_i64())
}

fn register_scope_with_phys3(a: i64, b: i64, c: i64) -> i64 {
  scope_push_typed(register_scope_with_phys2(a, b), c, 1, c, ty_i64())
}

fn register_full_phys_scope() -> i64 {
  let mut s = scope_new()
  for p in 19..27 {
    s = scope_push_typed(s, p, 1, p, ty_i64())
  }
  s
}

fn register_full_pinned_phys_scope() -> i64 {
  let mut s = scope_new()
  for p in 21..27 {
    s = scope_push_typed(s, p, 1, p, ty_i64())
  }
  s
}

fn register_f64_scope_with_fd(fd: i64) -> i64 {
  scope_push_typed(scope_new(), fd, 1, cg_f64_fp_regid(fd), ty_f64())
}

fn register_full_loop_f64_scope() -> i64 {
  let mut s = scope_new()
  for fd in 16..24 {
    s = scope_push_typed(s, fd, 1, cg_f64_fp_regid(fd), ty_f64())
  }
  s
}

fn register_counter_hidden_mask(start: i64, limit: i64) -> i64 {
  let mut mask = 0
  let mut i = start
  while i < limit {
    mask = mask + cg_bit(i)
    i = i + 1
  }
  mask
}

test "register_reservation_names_scratch_and_pinned_register_classes" {
  Test.assert_eq(cg_phys_is_counter(19), 1)
  Test.assert_eq(cg_phys_is_scratch(19), 1)
  Test.assert_eq(cg_phys_is_pinned(19), 0)
  Test.assert_eq(cg_phys_is_scratch(20), 1)
  Test.assert_eq(cg_phys_is_pinned(21), 1)
  Test.assert_eq(cg_phys_is_pinned(26), 1)
  Test.assert_eq(cg_phys_is_counter(27), 0)
  Test.assert_eq(cg_phys_is_pinned(27), 0)
}

test "register_reservation_names_fp_preserved_and_clobbered_classes" {
  Test.assert_eq(cg_fp_phys_is_call_clobbered(0), 1)
  Test.assert_eq(cg_fp_phys_is_callee_saved(8), 1)
  Test.assert_eq(cg_fp_phys_is_call_clobbered(8), 0)
  Test.assert_eq(cg_fp_phys_is_callee_saved(15), 1)
  Test.assert_eq(cg_fp_phys_is_call_clobbered(15), 0)
  Test.assert_eq(cg_fp_phys_is_call_clobbered(16), 1)
  Test.assert_eq(cg_f64_loop_fp_phys_is_call_clobbered(cg_loop_f64_fp_min()), 1)
  Test.assert_eq(cg_f64_loop_fp_phys_is_call_clobbered(cg_loop_f64_fp_max()), 1)
}

test "register_reservation_finds_loop_f64_fp_registers" {
  Test.assert_eq(cg_scope_first_free_loop_f64_fp(scope_new()), 16)
  Test.assert_eq(cg_scope_first_free_loop_f64_fp(register_f64_scope_with_fd(16)), 17)
  Test.assert_eq(cg_scope_first_free_loop_f64_fp(register_full_loop_f64_scope()), 0)
}

test "register_reservation_uses_natural_counter_register" {
  let fm = fmap_new()
  let r = cg_vreg_reserve_counter(scope_new(), 0, fm)
  Test.assert_eq(cg_vreg_reservation_phys(r), 19)
  Test.assert_eq(cg_vreg_reservation_reason(r), cg_vreg_reason_natural())
  Test.assert_eq(cg_vreg_reservation_natural_phys(r), 19)
  Test.assert_eq(fmap_register_pinned_count(fm), 0)
  Test.assert_eq(fmap_register_scope_collision_count(fm), 0)
  Test.assert_eq(fmap_register_spill_counter_count(fm), 0)
  Test.assert_eq(fmap_register_no_free_count(fm), 0)
}

test "register_reservation_classifies_scope_collision" {
  let fm = fmap_new()
  let r = cg_vreg_reserve_counter(register_scope_with_phys(19), 0, fm)
  Test.assert_eq(cg_vreg_reservation_phys(r), 26)
  Test.assert_eq(cg_vreg_reservation_reason(r), cg_vreg_reason_scope_collision())
  Test.assert_eq(cg_vreg_reservation_natural_phys(r), 19)
  Test.assert_eq(fmap_register_pinned_count(fm), 1)
  Test.assert_eq(fmap_register_scope_collision_count(fm), 1)
  Test.assert_eq(fmap_register_spill_counter_count(fm), 0)
  Test.assert_eq(fmap_register_no_free_count(fm), 0)
}

test "register_reservation_classifies_spill_counter" {
  let fm = fmap_new()
  let r = cg_vreg_reserve_counter(scope_new(), 8, fm)
  Test.assert_eq(cg_vreg_reservation_phys(r), 26)
  Test.assert_eq(cg_vreg_reservation_reason(r), cg_vreg_reason_spill_counter())
  Test.assert_eq(cg_vreg_reservation_natural_phys(r), 0)
  Test.assert_eq(fmap_register_pinned_count(fm), 1)
  Test.assert_eq(fmap_register_scope_collision_count(fm), 0)
  Test.assert_eq(fmap_register_spill_counter_count(fm), 1)
  Test.assert_eq(fmap_register_no_free_count(fm), 0)
}

test "register_reservation_classifies_no_free_physical_register" {
  let fm = fmap_new()
  let r = cg_vreg_reserve_counter(register_full_phys_scope(), 0, fm)
  Test.assert_eq(cg_vreg_reservation_phys(r), 0)
  Test.assert_eq(cg_vreg_reservation_reason(r), cg_vreg_reason_no_free())
  Test.assert_eq(cg_vreg_reservation_natural_phys(r), 19)
  Test.assert_eq(fmap_register_pinned_count(fm), 0)
  Test.assert_eq(fmap_register_scope_collision_count(fm), 0)
  Test.assert_eq(fmap_register_spill_counter_count(fm), 0)
  Test.assert_eq(fmap_register_no_free_count(fm), 1)
}

test "register_reservation_excludes_scratch_registers_from_pinned_fallback" {
  let fm = fmap_new()
  let r = cg_vreg_reserve_counter(register_full_pinned_phys_scope(), 8, fm)
  Test.assert_eq(cg_vreg_reservation_phys(r), 0)
  Test.assert_eq(cg_vreg_reservation_reason(r), cg_vreg_reason_no_free())
  Test.assert_eq(cg_vreg_reservation_natural_phys(r), 0)
  Test.assert_eq(fmap_register_pinned_count(fm), 0)
  Test.assert_eq(fmap_register_scope_collision_count(fm), 0)
  Test.assert_eq(fmap_register_spill_counter_count(fm), 0)
  Test.assert_eq(fmap_register_no_free_count(fm), 1)
}

test "register_reservation_counter_skips_live_scope_registers" {
  let pinned_scope = scope_push_typed(register_scope_with_phys(19), 26, 1, 26, ty_i64())
  Test.assert_eq(cg_counter_after_scope(register_scope_with_phys(19), 0), 1)
  Test.assert_eq(cg_counter_after_scope(pinned_scope, 0), 8)
  Test.assert_eq(cg_counter_after_scope(register_full_phys_scope(), 0), 8)
}

test "register_window_reuses_low_hole_for_single_counter_expression" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_window(pinned_scope, 0, 1, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_reuses_low_contiguous_hole_for_binop_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_window(pinned_scope, 0, 2, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_skips_fragmented_holes" {
  let fm = fmap_new()
  let fragmented_scope = register_scope_with_phys3(19, 21, 26)
  Test.assert_eq(cg_counter_after_scope_window(fragmented_scope, 0, 2, fm), 3)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_falls_back_when_no_window_or_unknown_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_window(register_full_phys_scope(), 0, 1, fm), 8)
  Test.assert_eq(cg_counter_after_scope_window(pinned_scope, 0, 9, fm), 8)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 0)
}

test "register_window_boundary_reuses_low_hole_after_spill_counter" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let lhs = node_new(1, 1, 0, 0, 0)
  let rhs = node_new(1, 2, 0, 0, 0)
  let bin = node_new(3, 1, lhs, rhs, 0)
  Test.assert_eq(cg_counter_for_expr(pinned_scope, 8, bin, 0, fm), 8)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 0)
  Test.assert_eq(cg_counter_for_expr_boundary(pinned_scope, 8, bin, 0, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_boundary_skips_fragmented_holes_after_spill_counter" {
  let fm = fmap_new()
  let fragmented_scope = register_scope_with_phys3(19, 21, 26)
  Test.assert_eq(cg_counter_after_scope_boundary_window(fragmented_scope, 8, 2, fm), 3)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_boundary_falls_back_when_no_low_window_or_unknown_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_boundary_window(register_full_phys_scope(), 8, 1, fm), 8)
  Test.assert_eq(cg_counter_after_scope_boundary_window(pinned_scope, 8, 9, fm), 8)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 0)
}

test "register_window_hidden_mask_skips_low_live_counter" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_boundary_window_hidden(pinned_scope, 8, 1, cg_bit(1), fm), 2)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_hidden_mask_skips_contiguous_hidden_counters" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let hidden = cg_bit(1) + cg_bit(2)
  Test.assert_eq(cg_counter_after_scope_boundary_window_hidden(pinned_scope, 8, 2, hidden, fm), 3)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_hidden_mask_falls_back_when_hidden_blocks_all_holes" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  Test.assert_eq(cg_counter_after_scope_boundary_window_hidden(pinned_scope, 8, 1, register_counter_hidden_mask(1, 7), fm), 8)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 0)
}

test "register_window_hidden_mask_applies_to_expr_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let lhs = node_new(1, 1, 0, 0, 0)
  let rhs = node_new(1, 2, 0, 0, 0)
  let bin = node_new(3, 1, lhs, rhs, 0)
  Test.assert_eq(cg_counter_for_expr_boundary_hidden(pinned_scope, 8, bin, 0, cg_bit(1), fm), 2)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_sizes_discarding_blocks_by_max_child_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let lhs = node_new(1, 1, 0, 0, 0)
  let rhs = node_new(1, 2, 0, 0, 0)
  let bin = node_new(3, 1, lhs, rhs, 0)
  let block = node_new(7, bin, lhs, 0, 0)
  Test.assert_eq(cg_expr_counter_width(block, pinned_scope, 0, fm), 2)
  Test.assert_eq(cg_counter_for_expr(pinned_scope, 0, block, 0, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_sizes_discarded_assignments_by_value_width" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let lhs = node_new(1, 1, 0, 0, 0)
  let rhs = node_new(1, 2, 0, 0, 0)
  let bin = node_new(3, 1, lhs, rhs, 0)
  let assign = node_new(12, 1, 1, bin, 0)
  let block = node_new(7, assign, lhs, 0, 0)
  Test.assert_eq(cg_expr_counter_width(assign, pinned_scope, 0, fm), 2)
  Test.assert_eq(cg_expr_counter_width(block, pinned_scope, 0, fm), 2)
  Test.assert_eq(cg_counter_for_expr(pinned_scope, 0, block, 0, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_sizes_if_by_condition_and_branch_widths" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let one = node_new(1, 1, 0, 0, 0)
  let two = node_new(1, 2, 0, 0, 0)
  let three = node_new(1, 3, 0, 0, 0)
  let four = node_new(1, 4, 0, 0, 0)
  let cond = node_new(3, 7, one, two, 0)
  let then_n = node_new(3, 1, one, two, 0)
  let else_n = node_new(3, 1, three, four, 0)
  let if_n = node_new(5, cond, then_n, else_n, 0)
  Test.assert_eq(cg_expr_counter_width(if_n, pinned_scope, 0, fm), 2)
  Test.assert_eq(cg_counter_for_expr(pinned_scope, 0, if_n, 0, fm), 1)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 1)
}

test "register_window_keeps_binding_width_unknown" {
  let fm = fmap_new()
  let pinned_scope = register_scope_with_phys2(19, 26)
  let lit = node_new(1, 1, 0, 0, 0)
  let binding = node_new(6, 1, 1, lit, lit)
  Test.assert_eq(cg_expr_counter_width(binding, pinned_scope, 0, fm), cg_counter_width_unknown())
  Test.assert_eq(cg_counter_for_expr(pinned_scope, 0, binding, 0, fm), 8)
  Test.assert_eq(fmap_register_window_reuse_count(fm), 0)
}
