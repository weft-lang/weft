-- Method call inside conditional and match expressions
-- Expected exit code: 42
type ConditionalNum { v: i64 }

impl ConditionalNum {
  fn val(self: ConditionalNum) -> i64 { self.v }
  fn is_big(self: ConditionalNum) -> i64 {
    if self.v > 10 { 1 } else { 0 }
  }
}

fn main() -> i64 {
  let n = ConditionalNum { v: 42 }
  if n.is_big() == 1 { n.val() } else { 0 }
}
