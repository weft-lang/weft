use runtime/memory.{*}
-- Method call inside conditional and match expressions
-- Expected exit code: 42
type Num { v: i64 }

impl Num {
  fn val(self: i64) -> i64 { mem_load64(self) }
  fn is_big(self: i64) -> i64 {
    if mem_load64(self) > 10 { 1 } else { 0 }
  }
}

fn main() -> i64 {
  let n = Num { v: 42 }
  if n.is_big() == 1 { n.val() } else { 0 }
}
