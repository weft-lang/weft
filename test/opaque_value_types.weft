use module_fixtures/g4_opaque_left as opaque_left
use module_fixtures/g4_opaque_left.{Same as LeftOpaqueSame}
use module_fixtures/g4_opaque_effect.{OpaqueRelay, make_value as make_relay_value, read_value as read_relay_value, relay_value}
use module_fixtures/g4_opaque_right as opaque_right
use module_fixtures/g4_opaque_right.{Same as RightOpaqueSame}
use module_fixtures/g4_opaque_trait.{OpaqueIdentity}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}
use runtime/opaque_value_test.{opaque_value_transmute_roundtrip}
use stdlib/drop.{*}
use stdlib/vector.{persistent_vector_get, persistent_vector_len, persistent_vector_new, persistent_vector_push}
use stdlib/vector_type.{PersistentVector}

type UserId = opaque i64
type Box<T> = opaque T
type Pair = opaque (i64, i64)
type GenericPair<T> = opaque (T, T)
type View = opaque [i64]
type Label = opaque str
type MaybeId = opaque i64?
type FixedPair = opaque [i64; 2]
type OwnedOpaqueToken = opaque i64
type FrozenOpaque<T> = opaque PersistentVector<T>

type OpaqueAggregateChoice {
  OpaqueAggregateValue(UserId),
  OpaqueAggregateEmpty
}

type OpaqueAggregateRecord {
  value: UserId
}

type GenericOpaqueAggregate<T> {
  GenericOpaqueAggregateValue(Box<T>)
}

type ImportedOpaqueAggregate {
  ImportedOpaqueLeft(LeftOpaqueSame),
  ImportedOpaqueRight(RightOpaqueSame)
}

type OpaquePairCarrier {
  OpaquePairCarrier(Pair, i64)
}

effect OpaqueRead {
  fn read() -> MaybeId
}

effect OpaqueStop {
  fn stop() -> i64
}

trait NumericValue {
  fn numeric_value(self) -> i64
}

trait OpaquePairChoose {
  fn choose(self, other: Self, take_other: bool) -> Self
}

trait GenericOpaquePairChoose {
  fn choose(self, other: Self, take_other: bool) -> Self
}

fn unwrap_user_id(value: UserId) -> i64 {
  match value { UserId(inner) -> inner }
}

fn unwrap_box<T>(value: Box<T>) -> T {
  match value { Box(inner) -> inner }
}

fn sum_pair(value: Pair) -> i64 {
  match value { Pair((left, right)) -> left + right }
}

fn sum_pair_carrier(value: OpaquePairCarrier) -> i64 {
  match value { OpaquePairCarrier(pair, extra) -> pair.lane(0) + pair.lane(1) + extra }
}

fn first_view(value: View) -> i64 {
  match value { View(items) -> items[0] }
}

fn unwrap_label(value: Label) -> str {
  match value { Label(inner) -> inner }
}

fn maybe_value_or(value: MaybeId, fallback: i64) -> i64 {
  match value {
    MaybeId(nil) -> fallback
    MaybeId(inner: i64) -> inner
  }
}

fn sum_fixed_pair(value: FixedPair) -> i64 {
  match value { FixedPair(items) -> items[0] + items[1] }
}

fn evaluated_user_id(log: i64) -> UserId {
  defer_order_log_write(log, defer_order_log_read(log) + 1)
  UserId(42)
}

fn handled_opaque_value() -> i64 {
  handle OpaqueRead.read() {
    OpaqueRead.read() -> resume(MaybeId(42))
  } |> maybe_value_or(0)
}

impl NumericValue for UserId {
  fn numeric_value(self: UserId) -> i64 {
    match self { UserId(value) -> value }
  }
}

impl Pair {
  fn lane(self, index: i64) -> i64 {
    match self { Pair((left, right)) -> if index == 0 { left } else { right } }
  }

  fn keep(self) -> Pair { self }
}

impl OpaquePairChoose for Pair {
  fn choose(self, other: Self, take_other: bool) -> Self {
    if take_other { other } else { self }
  }
}

impl<T> GenericPair<T> {
  fn second(self) -> T {
    match self { GenericPair((first, second)) -> second }
  }

  fn keep(self) -> Self { self }
}

impl<T> GenericOpaquePairChoose for GenericPair<T> {
  fn choose(self, other: Self, take_other: bool) -> Self {
    if take_other { other } else { self }
  }
}

impl Drop for OwnedOpaqueToken {
  fn drop(self: i64) -> i64 {
    defer_order_log_write(self, defer_order_log_read(self) * 10 + 1)
  }
}

fn consume_owned_opaque(log: i64) -> i64 {
  let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
  0
}

fn abort_with_owned_opaque(log: i64) -[OpaqueStop]> i64 {
  let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
  OpaqueStop.stop() + 1000
}

fn loop_with_owned_opaque(log: i64) -> i64 {
  let mut i = 0
  while i < 3 {
    let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
    i = i + 1
  }
  0
}

fn consume_imported_owned_opaque(log: i64) -> i64 {
  let left: owned LeftOpaqueSame = opaque_left.make_owned(log)
  let right: owned RightOpaqueSame = opaque_right.make_owned(log)
  0
}

fn frozen_opaque<T>(first: T, second: T) -> FrozenOpaque<T> {
  let values = persistent_vector_new<T>()
  let one = persistent_vector_push<T>(values, first)
  FrozenOpaque<T>(persistent_vector_push<T>(one, second))
}

fn require_opaque_sendable<T: Sendable>(value: T) -> T {
  value
}

fn opaque_aggregate_value(value: OpaqueAggregateChoice) -> i64 {
  match value {
    OpaqueAggregateValue(UserId(inner)) -> inner
    OpaqueAggregateEmpty -> 0
  }
}

fn generic_opaque_aggregate_value<T>(value: GenericOpaqueAggregate<T>) -> T {
  match value { GenericOpaqueAggregateValue(Box(inner)) -> inner }
}

fn imported_opaque_aggregate_value(value: ImportedOpaqueAggregate) -> i64 {
  match value {
    ImportedOpaqueLeft(inner) -> opaque_left.read(inner)
    ImportedOpaqueRight(inner) -> opaque_right.read(inner)
  }
}

test "scalar opaque wrap and projection preserve value" {
  Test.assert_eq(unwrap_user_id(UserId(42)), 42)
}

test "generic opaque representation substitutes at wrap and projection" {
  Test.assert_eq(unwrap_box(Box(42)), 42)
  Test.assert_true(unwrap_box(Box(true)))
  Test.assert_eq(unwrap_box(Box<i64>(42)), 42)
}

test "record and variant members resolve local opaque identities" {
  let record = OpaqueAggregateRecord { value: UserId(20) }
  Test.assert_eq(unwrap_user_id(record.value), 20)
  Test.assert_eq(opaque_aggregate_value(OpaqueAggregateValue(UserId(22))), 22)
  Test.assert_eq(opaque_aggregate_value(OpaqueAggregateEmpty), 0)
}

test "variant members resolve generic opaque identities" {
  Test.assert_eq(generic_opaque_aggregate_value<i64>(GenericOpaqueAggregateValue<i64>(Box<i64>(42))), 42)
}

test "variant members resolve imported opaque identities" {
  Test.assert_eq(imported_opaque_aggregate_value(ImportedOpaqueLeft(opaque_left.make(20))), 20)
  Test.assert_eq(imported_opaque_aggregate_value(ImportedOpaqueRight(opaque_right.make(22))), 22)
}

test "tuple opaque representation preserves every lane" {
  Test.assert_eq(sum_pair(Pair((20, 22))), 42)
}

test "multi-lane opaque methods transport receiver arguments and results" {
  let left = Pair((10, 11))
  let right = Pair((20, 22))
  Test.assert_eq(left.lane(0), 10)
  Test.assert_eq(left.lane(1), 11)
  Test.assert_eq(left.keep().lane(1), 11)
  Test.assert_eq(left.choose(right, true).lane(1), 22)
  Test.assert_eq(left.choose(right, false).lane(0), 10)
  Test.assert_eq((if true { left } else { right }).lane(1), 11)
  Test.assert_eq((if false { left } else { right }).lane(1), 22)
  Test.assert_eq(left.choose(if true { right } else { left }, true).lane(1), 22)
  Test.assert_eq(left.choose(if false { right } else { left }, true).lane(1), 11)
}

test "generic multi-lane opaque methods preserve concrete shape" {
  let left = GenericPair<i64>((10, 11))
  let right = GenericPair<i64>((20, 22))
  Test.assert_eq(left.second(), 11)
  Test.assert_eq(left.keep().second(), 11)
  Test.assert_eq(left.choose(right, true).second(), 22)
  Test.assert_eq(left.choose(right, false).second(), 11)
  Test.assert_eq((if false { left } else { right }).keep().second(), 22)
  Test.assert_eq(left.choose(if true { right } else { left }, true).second(), 22)
}

test "multi-lane opaque values retain every lane inside variants" {
  Test.assert_eq(sum_pair_carrier(OpaquePairCarrier(Pair((20, 21)), 1)), 42)
}

test "slice opaque representation preserves pointer and length lanes" {
  let values = [42, 7]
  Test.assert_eq(first_view(View(values[..])), 42)
}

test "fixed array opaque representation preserves inline storage" {
  Test.assert_eq(sum_fixed_pair(FixedPair([20, 22])), 42)
}

test "managed opaque representation preserves ownership transport" {
  Test.assert_str_eq(unwrap_label(Label("opaque")), "opaque")
}

test "opaque Sendable fact follows substituted representation" {
  let values = require_opaque_sendable<FrozenOpaque<i64>>(frozen_opaque<i64>(20, 22))
  match values {
    FrozenOpaque(storage) -> {
      Test.assert_eq(persistent_vector_len<i64>(storage), 2)
      Test.assert_eq(persistent_vector_get<i64>(storage, 0, 0), 20)
      Test.assert_eq(persistent_vector_get<i64>(storage, 1, 0), 22)
    }
  }
}

test "nested opaque projection participates in exhaustiveness" {
  Test.assert_eq(maybe_value_or(MaybeId(nil), 42), 42)
  Test.assert_eq(maybe_value_or(MaybeId(42), 0), 42)
}

test "opaque values cross effect operation and handler transport" {
  Test.assert_eq(handled_opaque_value(), 42)
}

test "imported effect signatures retain opaque declaration identity" {
  let result = handle relay_value(make_relay_value(42)) {
    OpaqueRelay.relay(value) -> resume(value)
  }
  Test.assert_eq(read_relay_value(result), 42)
}

test "trait impl retains opaque target identity" {
  Test.assert_eq(UserId(42).numeric_value(), 42)
}

test "same-spelled imported opaque types retain module identity" {
  Test.assert_eq(opaque_left.read(opaque_left.make(20)), 20)
  Test.assert_eq(opaque_right.read(opaque_right.make(22)), 22)
}


test "same-spelled opaque methods retain exact native dispatch identity" {
  let left = opaque_left.make(1)
  let right = opaque_right.make(1)
  Test.assert_eq(left.native_identity(), 101)
  Test.assert_eq(right.native_identity(), 202)
}

test "same-spelled opaque trait impls retain exact native dispatch identity" {
  let left = opaque_left.make(1)
  let right = opaque_right.make(1)
  Test.assert_eq(left.trait_identity(), 1001)
  Test.assert_eq(right.trait_identity(), 2002)
}

test "same-spelled owned opaque types retain exact Drop dispatch identity" {
  let log = defer_order_log_new()
  consume_imported_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "opaque construction evaluates its representation exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(unwrap_user_id(evaluated_user_id(log)), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "trusted transmute bridges an opaque representation exactly" {
  Test.assert_eq(opaque_value_transmute_roundtrip(42), 42)
}

test "owned opaque resource drops exactly once on normal exit" {
  let log = defer_order_log_new()
  consume_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "owned opaque resource drops on handler abort" {
  let log = defer_order_log_new()
  let result = handle abort_with_owned_opaque(log) {
    OpaqueStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "owned opaque resource drops on every loop exit" {
  let log = defer_order_log_new()
  loop_with_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 111)
}
