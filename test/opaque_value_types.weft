use module_fixtures/g4_opaque_left as opaque_left
use module_fixtures/g4_opaque_left.{Same as LeftOpaqueSame, make_managed, make_managed_result}
use module_fixtures/g4_opaque_effect.{OpaqueRelay, make_value as make_relay_value, read_value as read_relay_value, relay_value}
use module_fixtures/g4_opaque_right as opaque_right
use module_fixtures/g4_opaque_right.{Same as RightOpaqueSame}
use module_fixtures/g4_opaque_trait.{OpaqueIdentity}
use module_fixtures/wide_cleanup_boundary.{ImportedCleanupReady, ImportedCleanupWide, imported_cleanup_result, imported_cleanup_wide_check_and_drop, imported_cleanup_wide_new}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}
use runtime/opaque_value_test.{opaque_value_transmute_roundtrip}
use runtime/rc.{rc_count}
use runtime/string.{runtime_str_ptr}
use stdlib/drop.{*}
use stdlib/fail.{Fail}
use stdlib/http as http
use stdlib/http.{HttpHeaders}
use stdlib/json.{Json, json_string, json_stringify}
use stdlib/result.{Err, Ok, Result}
use stdlib/option.{Option}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}

type UserId = opaque i64

type Box<T> = opaque T

type Pair = opaque(i64, i64)

type TryTriple = opaque(i64, i64, i64)

type GenericPair<T> = opaque(T, T)

type View = opaque[i64]

type Label = opaque str

type MaybeId = opaque i64?

type FixedPair = opaque[i64; 2]

type OwnedOpaqueToken = opaque i64

type OwnedGenericOpaque<T> = opaque T

type OwnedWideCarrier = opaque(owned OwnedOpaqueToken, i64, i64, bool, str)

type OwnedJsonWideCarrier = opaque(owned OwnedOpaqueToken, i64, i64, i64, bool, str)

type OwnedConnectionCarrier = opaque(owned OwnedOpaqueToken, str, i64, bool, i64)

type OwnedWideOutcome {
  OwnedWideFailed,
  OwnedWideReady(owned OwnedWideCarrier)
}

type OwnedWideJsonOutcome {
  OwnedWideJsonReady(owned OwnedWideCarrier, Json, HttpHeaders)
}

type OwnedConnectionJsonOutcome {
  OwnedConnectionJsonReady(owned OwnedConnectionCarrier, Json, HttpHeaders)
}

type FrozenOpaque<T> = opaque PersistentVector<T>

type OpaqueAggregateChoice {
  OpaqueAggregateValue(UserId),
    OpaqueAggregateEmpty
}

type OpaqueAggregateRecord {
  value: UserId
}

type GenericOpaqueAggregate<T> {
  GenericOpaqueAggregateValue(Box<T>)
}

type ImportedOpaqueAggregate {
  ImportedOpaqueLeft(LeftOpaqueSame),
    ImportedOpaqueRight(RightOpaqueSame)
}

type OpaquePairCarrier {
  OpaquePairCarrier(Pair, i64)
}

effect OpaqueRead {
  fn read() -> MaybeId
}

effect OpaqueTypedRead<T> {
  fn read() -> i64
}

effect OpaqueOwnedMove<T> {
  fn move(value: owned OwnedGenericOpaque<T>) -> owned OwnedGenericOpaque<T>
}

type OpaqueWideSnapshot<S> {
  OpaqueWideSnapshotted(owned OwnedGenericOpaque<GenericPair<S>>, str)
}

effect OpaqueStop {
  fn stop() -> i64
}

trait NumericValue {
  fn numeric_value(self) -> i64
}

trait OpaquePairChoose {
  fn choose(self, other: Self, take_other: bool) -> Self
}

trait GenericOpaquePairChoose {
  fn choose(self, other: Self, take_other: bool) -> Self
}

fn unwrap_user_id(value: UserId) -> i64 {
  match value { UserId(inner) -> inner }
}

fn unwrap_box<T>(value: Box<T>) -> T {
  match value { Box(inner) -> inner }
}

fn sum_pair(value: Pair) -> i64 {
  match value { Pair((left, right)) -> left + right }
}

fn wide_try_result(succeed: bool) -> Result<TryTriple, i64> {
  if succeed { Ok<TryTriple, i64>(TryTriple((10, 11, 21))) }
  else { Err<TryTriple, i64>(7) }
}

fn wide_try_error_result(succeed: bool) -> Result<i64, (i64, i64, i64)> {
  if succeed { Ok<i64, (i64, i64, i64)>(7) }
  else { Err<i64, (i64, i64, i64)>((10, 11, 21)) }
}

fn wide_try_probe(succeed: bool) -[Fail<i64>]> i64 {
  match wide_try_result(succeed)? {
    TryTriple((first, second, third)) -> first + second + third
  }
}

fn wide_try_cfg_probe(succeed: bool) -[Fail<i64>]> i64 {
  let value = if succeed { wide_try_result(true)? } else { wide_try_result(true)? }
  match value {
    TryTriple((first, second, third)) -> first * 100 + second * 10 + third
  }
}

fn wide_try_run(succeed: bool) -> i64 {
  handle wide_try_probe(succeed) {
    Fail<i64>.fail(error) -> 0 - error
  }
}

fn wide_try_cfg_run(succeed: bool) -> i64 {
  handle wide_try_cfg_probe(succeed) {
    Fail<i64>.fail(error) -> 0 - error
  }
}

fn wide_try_error_probe(succeed: bool) -[Fail<(i64, i64, i64)>]> i64 {
  wide_try_error_result(succeed)?
}

fn wide_try_error_run(succeed: bool) -> i64 {
  handle wide_try_error_probe(succeed) {
    Fail<(i64, i64, i64)>.fail(error) -> match error {
      (first, second, third) -> 100 + first + second + third
    }
  }
}

fn sum_pair_carrier(value: OpaquePairCarrier) -> i64 {
  match value { OpaquePairCarrier(pair, extra) -> pair.lane(0) + pair.lane(1) + extra }
}

fn first_view(value: View) -> i64 {
  match value { View(items) -> items[0] }
}

fn unwrap_label(value: Label) -> str {
  match value { Label(inner) -> inner }
}

fn maybe_value_or(value: MaybeId, fallback: i64) -> i64 {
  match value {
    MaybeId(nil) -> fallback
    MaybeId(inner: i64) -> inner
  }
}

fn sum_fixed_pair(value: FixedPair) -> i64 {
  match value { FixedPair(items) -> items[0] + items[1] }
}

fn evaluated_user_id(log: i64) -> UserId {
  defer_order_log_write(log, defer_order_log_read(log) + 1)
  UserId(42)
}

fn handled_opaque_value() -> i64 {
  handle OpaqueRead.read() {
    OpaqueRead.read() -> resume(MaybeId(42))
  } |> maybe_value_or(0)
}

fn read_opaque_typed_effect() -[OpaqueTypedRead<UserId>]> i64 {
  OpaqueTypedRead<UserId>.read()
}

fn handled_opaque_typed_effect() -> i64 {
  handle read_opaque_typed_effect() {
    OpaqueTypedRead<UserId>.read() -> resume(42)
  }
}

fn handled_owned_generic_opaque_effect() -> i64 {
  let moved = handle OpaqueOwnedMove<GenericPair<i64>>.move(
    OwnedGenericOpaque<GenericPair<i64>>(GenericPair<i64>((20, 22)))
  ) {
    OpaqueOwnedMove<GenericPair<i64>>.move(value) -> resume(value)
  }
  match moved {
    OwnedGenericOpaque(GenericPair((left, right))) -> left + right
  }
}

fn opaque_wide_snapshot<S>(
  owner: owned OwnedGenericOpaque<GenericPair<S>>,
  source: str
) -> OpaqueWideSnapshot<S> {
  -- Intentionally omit explicit constructor type arguments: declaration-
  -- local `S` must be inferred from the checked payloads before flattening.
  OpaqueWideSnapshotted(owner, source)
}

impl NumericValue for UserId {
  fn numeric_value(self: UserId) -> i64 {
    match self { UserId(value) -> value }
  }
}

impl Pair {
  fn lane(self, index: i64) -> i64 {
    match self { Pair((left, right)) -> if index == 0 { left } else { right } }
  }

  fn keep(self) -> Pair { self }
}

impl OpaquePairChoose for Pair {
  fn choose(self, other: Self, take_other: bool) -> Self {
    if take_other { other } else { self }
  }
}

impl<T> GenericPair<T> {
  fn second(self) -> T {
    match self { GenericPair((first, second)) -> second }
  }

  fn keep(self) -> Self { self }
}

impl<T> GenericOpaquePairChoose for GenericPair<T> {
  fn choose(self, other: Self, take_other: bool) -> Self {
    if take_other { other } else { self }
  }
}

impl Drop for OwnedOpaqueToken {
  fn drop(self: i64) -> i64 {
    defer_order_log_write(self, defer_order_log_read(self) * 10 + 1)
  }
}

impl<T> Drop for OwnedGenericOpaque<T> {
  fn drop(self: OwnedGenericOpaque<T>) -> i64 { 0 }
}

impl Drop for OwnedWideCarrier {
  fn drop(self) -> i64 {
    match self {
      OwnedWideCarrier((token, first, second, flag, label)) -> token.drop()
    }
  }
}

impl Drop for OwnedJsonWideCarrier {
  fn drop(self) -> i64 {
    match self {
      OwnedJsonWideCarrier((token, first, second, third, flag, label)) -> token.drop()
    }
  }
}

impl Drop for OwnedConnectionCarrier {
  fn drop(self) -> i64 {
    match self {
      OwnedConnectionCarrier((token, buffered, offset, reusable, identity)) -> token.drop()
    }
  }
}

fn owned_json_wide_pass(
  value: owned OwnedJsonWideCarrier,
  payload: Json
) -> owned OwnedJsonWideCarrier {
  let rendered = json_stringify(payload).expect("test JSON is finite")
  if rendered == "\"echo\"" { value } else { value }
}

fn owned_wide_json_result(
  value: owned OwnedWideCarrier,
  payload: Json
) -> OwnedWideJsonOutcome {
  OwnedWideJsonReady(value, payload, http.headers())
}

fn owned_connection_json_result(
  value: owned OwnedConnectionCarrier,
  payload: Json
) -> OwnedConnectionJsonOutcome {
  OwnedConnectionJsonReady(value, payload, http.headers())
}

fn owned_wide_pass(value: owned OwnedWideCarrier) -> owned OwnedWideCarrier {
  value
}

fn imported_cleanup_wide_roundtrip(log: i64) -> owned ImportedCleanupWide {
  let payload = json_string("payload")
  let rendered = json_stringify(payload).expect("test JSON is finite")
  match imported_cleanup_result(imported_cleanup_wide_new(log), payload) {
    ImportedCleanupReady(returned, document, trailers) -> if rendered == "\"payload\"" and
      json_stringify(document).expect("test JSON is finite") == "\"payload\"" and trailers.len() == 0 {
      returned
    } else {
      returned
    }
  }
}

fn owned_wide_response(
  outcome: OwnedWideOutcome
) -[Fail<i64>]> owned OwnedWideCarrier {
  match outcome {
    OwnedWideFailed -> Fail<i64>.fail(1)
    OwnedWideReady(value) -> {
      let finished = owned_wide_pass(value)
      finished
    }
  }
}

fn owned_wide_fallback(log: i64, code: i64) -> owned OwnedWideCarrier {
  OwnedWideCarrier((OwnedOpaqueToken(log), code, 0, false, "failed"))
}

fn owned_wide_run(log: i64) -> owned OwnedWideCarrier {
  handle owned_wide_response(
    OwnedWideReady(OwnedWideCarrier((OwnedOpaqueToken(log), 11, 22, true, "identity")))
  ) {
    Fail<i64>.fail(code) -> owned_wide_fallback(log, code)
  }
}

fn consume_owned_opaque(log: i64) -> i64 {
  let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
  0
}

fn destructure_owned_generic_opaque(
  value: owned OwnedGenericOpaque<i64>
) -> i64 {
  match value { OwnedGenericOpaque(inner) -> inner }
}

fn inspect_owned_generic_opaque<T>(
  value: borrow OwnedGenericOpaque<T>
) -> i64 {
  21
}

fn inspect_owned_generic_opaque_cfg<T>(
  value: owned OwnedGenericOpaque<T>,
  first_branch: bool
) -> i64 {
  if first_branch {
    inspect_owned_generic_opaque(value)
  } else {
    inspect_owned_generic_opaque(value)
  }
}

fn abort_with_owned_opaque(log: i64) -[OpaqueStop]> i64 {
  let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
  OpaqueStop.stop() + 1000
}

fn loop_with_owned_opaque(log: i64) -> i64 {
  let mut i = 0
  while i < 3 {
    let token: owned OwnedOpaqueToken = OwnedOpaqueToken(log)
    i = i + 1
  }
  0
}

fn consume_imported_owned_opaque(log: i64) -> i64 {
  let left: owned LeftOpaqueSame = opaque_left.make_owned(log)
  let right: owned RightOpaqueSame = opaque_right.make_owned(log)
  0
}

fn frozen_opaque<T>(first: T, second: T) -> FrozenOpaque<T> {
  let values = persistent_vector.new<T>()
  let one = values.push(first)
  FrozenOpaque<T>(one.push(second))
}

fn require_opaque_sendable<T: Sendable>(value: T) -> T {
  value
}

fn opaque_aggregate_value(value: OpaqueAggregateChoice) -> i64 {
  match value {
    OpaqueAggregateValue(UserId(inner)) -> inner
    OpaqueAggregateEmpty -> 0
  }
}

fn generic_opaque_aggregate_value<T>(value: GenericOpaqueAggregate<T>) -> T {
  match value { GenericOpaqueAggregateValue(Box(inner)) -> inner }
}

fn imported_opaque_aggregate_value(value: ImportedOpaqueAggregate) -> i64 {
  match value {
    ImportedOpaqueLeft(inner) -> opaque_left.read(inner)
    ImportedOpaqueRight(inner) -> opaque_right.read(inner)
  }
}

test "scalar opaque wrap and projection preserve value" {
  Test.assert_eq(unwrap_user_id(UserId(42)), 42)
}

test "generic opaque representation substitutes at wrap and projection" {
  Test.assert_eq(unwrap_box(Box(42)), 42)
  Test.assert_true(unwrap_box(Box(true)))
  Test.assert_eq(unwrap_box(Box<i64>(42)), 42)
}

test "record and variant members resolve local opaque identities" {
  let record = OpaqueAggregateRecord { value: UserId(20) }
  Test.assert_eq(unwrap_user_id(record.value), 20)
  Test.assert_eq(opaque_aggregate_value(OpaqueAggregateValue(UserId(22))), 22)
  Test.assert_eq(opaque_aggregate_value(OpaqueAggregateEmpty), 0)
}

test "variant members resolve generic opaque identities" {
  Test.assert_eq(generic_opaque_aggregate_value<i64>(GenericOpaqueAggregateValue<i64>(Box<i64>(42))), 42)
}

test "variant members resolve imported opaque identities" {
  Test.assert_eq(imported_opaque_aggregate_value(ImportedOpaqueLeft(opaque_left.make(20))), 20)
  Test.assert_eq(imported_opaque_aggregate_value(ImportedOpaqueRight(opaque_right.make(22))), 22)
}

test "tuple opaque representation preserves every lane" {
  Test.assert_eq(sum_pair(Pair((20, 22))), 42)
}

test "try preserves every lane of copyable opaque success payloads" {
  Test.assert_eq(wide_try_run(true), 42)
  Test.assert_eq(wide_try_run(false), 0 - 7)
  Test.assert_eq(wide_try_cfg_run(true), 1131)
  Test.assert_eq(wide_try_cfg_run(false), 1131)
  Test.assert_eq(wide_try_error_run(true), 7)
  Test.assert_eq(wide_try_error_run(false), 142)
}

test "multi-lane opaque methods transport receiver arguments and results" {
  let left = Pair((10, 11))
  let right = Pair((20, 22))
  Test.assert_eq(left.lane(0), 10)
  Test.assert_eq(left.lane(1), 11)
  Test.assert_eq(left.keep().lane(1), 11)
  Test.assert_eq(left.choose(right, true).lane(1), 22)
  Test.assert_eq(left.choose(right, false).lane(0), 10)
  Test.assert_eq((if true { left } else { right }).lane(1), 11)
  Test.assert_eq((if false { left } else { right }).lane(1), 22)
  Test.assert_eq(left.choose(if true { right } else { left }, true).lane(1), 22)
  Test.assert_eq(left.choose(if false { right } else { left }, true).lane(1), 11)
}

test "imported opaque methods retain borrowed managed results" {
  let value = make_managed("alpha")
  let first = value.managed_text()
  Test.assert_eq(rc_count(runtime_str_ptr(first) - 16), 2)
  Test.assert_str_eq(first, "alpha.test")
  let second = value.managed_text()
  Test.assert_eq(rc_count(runtime_str_ptr(second) - 16), 3)
  Test.assert_str_eq(second, "alpha.test")
}

test "imported opaque methods retain managed results through generic matches" {
  match make_managed_result("beta") {
    Ok(value) -> {
      let first = value.managed_text()
      Test.assert_eq(rc_count(runtime_str_ptr(first) - 16), 2)
      Test.assert_str_eq(first, "beta.test")
      let second = value.managed_text()
      Test.assert_eq(rc_count(runtime_str_ptr(second) - 16), 3)
      Test.assert_str_eq(second, "beta.test")
    }
    _ -> Test.assert_true(false)
  }
}

test "generic multi-lane opaque methods preserve concrete shape" {
  let left = GenericPair<i64>((10, 11))
  let right = GenericPair<i64>((20, 22))
  Test.assert_eq(left.second(), 11)
  Test.assert_eq(left.keep().second(), 11)
  Test.assert_eq(left.choose(right, true).second(), 22)
  Test.assert_eq(left.choose(right, false).second(), 11)
  Test.assert_eq((if false { left } else { right }).keep().second(), 22)
  Test.assert_eq(left.choose(if true { right } else { left }, true).second(), 22)
}

test "multi-lane opaque values retain every lane inside variants" {
  Test.assert_eq(sum_pair_carrier(OpaquePairCarrier(Pair((20, 21)), 1)), 42)
}

test "owned multi-lane match arm locals preserve every return lane" {
  let log = defer_order_log_new()
  match owned_wide_run(log) {
    OwnedWideCarrier((token, first, second, flag, label)) -> {
      Test.assert_eq(first, 11)
      Test.assert_eq(second, 22)
      Test.assert_true(flag)
      Test.assert_str_eq(label, "identity")
      Test.assert_eq(token.drop(), 0)
      Test.assert_eq(defer_order_log_read(log), 1)
    }
  }
}

test "slice opaque representation preserves pointer and length lanes" {
  let values = [42, 7]
  Test.assert_eq(first_view(View(values[..])), 42)
}

test "fixed array opaque representation preserves inline storage" {
  Test.assert_eq(sum_fixed_pair(FixedPair([20, 22])), 42)
}

test "managed opaque representation preserves ownership transport" {
  Test.assert_str_eq(unwrap_label(Label("opaque")), "opaque")
}

test "opaque Sendable fact follows substituted representation" {
  let values = require_opaque_sendable<FrozenOpaque<i64>>(frozen_opaque<i64>(20, 22))
  match values {
    FrozenOpaque(storage) -> {
      Test.assert_true(storage.len() == 2)
      Test.assert_eq(storage.get(0).unwrap_or(0), 20)
      Test.assert_eq(storage.get(1).unwrap_or(0), 22)
    }
  }
}

test "nested opaque projection participates in exhaustiveness" {
  Test.assert_eq(maybe_value_or(MaybeId(nil), 42), 42)
  Test.assert_eq(maybe_value_or(MaybeId(42), 0), 42)
}

test "opaque values cross effect operation and handler transport" {
  Test.assert_eq(handled_opaque_value(), 42)
}

test "opaque type arguments retain parameterized effect identity" {
  Test.assert_eq(handled_opaque_typed_effect(), 42)
}

test "parameterized effects preserve owned multi-lane opaque arguments" {
  Test.assert_eq(handled_owned_generic_opaque_effect(), 42)
}

test "managed JSON parameters preserve a six-lane owned return" {
  let log = defer_order_log_new()
  let returned = owned_json_wide_pass(
    OwnedJsonWideCarrier((OwnedOpaqueToken(log), 10, 20, 12, true, "owner")),
    json_string("echo")
  )
  match returned {
    OwnedJsonWideCarrier((token, first, second, third, flag, label)) -> {
      Test.assert_eq(first + second + third, 42)
      Test.assert_true(flag)
      Test.assert_str_eq(label, "owner")
      let dropped = token.drop()
    }
  }
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "maximum-width results preserve an owned carrier before JSON and headers" {
  let log = defer_order_log_new()
  match owned_wide_json_result(
    OwnedWideCarrier((OwnedOpaqueToken(log), 20, 22, true, "owner")),
    json_string("payload")
  ) {
    OwnedWideJsonReady(returned, payload, trailers) -> match returned {
      OwnedWideCarrier((token, first, second, flag, label)) -> {
        Test.assert_eq(first + second, 42)
        Test.assert_true(flag)
        Test.assert_str_eq(label, "owner")
        Test.assert_str_eq(json_stringify(payload).expect("test JSON is finite"), "\"payload\"")
        Test.assert_eq(trailers.len(), 0)
        let dropped = token.drop()
      }
    }
  }
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "maximum-width results preserve an owned carrier managed second lane" {
  let log = defer_order_log_new()
  match owned_connection_json_result(
    OwnedConnectionCarrier((OwnedOpaqueToken(log), "buffered", 20, true, 22)),
    json_string("payload")
  ) {
    OwnedConnectionJsonReady(returned, payload, trailers) -> match returned {
      OwnedConnectionCarrier((token, buffered, offset, reusable, identity)) -> {
        Test.assert_str_eq(buffered, "buffered")
        Test.assert_eq(offset + identity, 42)
        Test.assert_true(reusable)
        Test.assert_str_eq(json_stringify(payload).expect("test JSON is finite"), "\"payload\"")
        Test.assert_eq(trailers.len(), 0)
        let dropped = token.drop()
      }
    }
  }
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "imported pattern cleanup preserves every owned result lane" {
  let log = defer_order_log_new()
  Test.assert_eq(imported_cleanup_wide_check_and_drop(imported_cleanup_wide_roundtrip(log)), 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "generic variant constructors infer wide payload layout" {
  match opaque_wide_snapshot<i64>(
    OwnedGenericOpaque<GenericPair<i64>>(GenericPair<i64>((20, 22))),
    "transport"
  ) {
    OpaqueWideSnapshotted(owner, source) -> match owner {
      OwnedGenericOpaque(GenericPair((left, right))) -> {
        Test.assert_eq(left + right, 42)
        Test.assert_str_eq(source, "transport")
      }
    }
  }
}

test "imported effect signatures retain opaque declaration identity" {
  let result = handle relay_value(make_relay_value(42)) {
    OpaqueRelay.relay(value) -> resume(value)
  }
  Test.assert_eq(read_relay_value(result), 42)
}

test "trait impl retains opaque target identity" {
  Test.assert_eq(UserId(42).numeric_value(), 42)
}

test "same-spelled imported opaque types retain module identity" {
  Test.assert_eq(opaque_left.read(opaque_left.make(20)), 20)
  Test.assert_eq(opaque_right.read(opaque_right.make(22)), 22)
}

test "same-spelled opaque methods retain exact native dispatch identity" {
  let left = opaque_left.make(1)
  let right = opaque_right.make(1)
  Test.assert_eq(left.native_identity(), 101)
  Test.assert_eq(right.native_identity(), 202)
}

test "same-spelled opaque trait impls retain exact native dispatch identity" {
  let left = opaque_left.make(1)
  let right = opaque_right.make(1)
  Test.assert_eq(left.trait_identity(), 1001)
  Test.assert_eq(right.trait_identity(), 2002)
}

test "same-spelled owned opaque types retain exact Drop dispatch identity" {
  let log = defer_order_log_new()
  consume_imported_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "opaque construction evaluates its representation exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(unwrap_user_id(evaluated_user_id(log)), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "trusted transmute bridges an opaque representation exactly" {
  Test.assert_eq(opaque_value_transmute_roundtrip(42), 42)
}

test "owned opaque resource drops exactly once on normal exit" {
  let log = defer_order_log_new()
  consume_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "owned generic opaque patterns retain their concrete representation" {
  Test.assert_eq(
    destructure_owned_generic_opaque(OwnedGenericOpaque<i64>(42)),
    42
  )
}

test "typed CFG lowering preserves inferred borrowed generic calls" {
  Test.assert_eq(
    inspect_owned_generic_opaque_cfg<i64>(OwnedGenericOpaque<i64>(20), true) +
      inspect_owned_generic_opaque_cfg<str>(OwnedGenericOpaque<str>("value"), false),
    42
  )
}

test "owned opaque resource drops on handler abort" {
  let log = defer_order_log_new()
  let result = handle abort_with_owned_opaque(log) {
    OpaqueStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "owned opaque resource drops on every loop exit" {
  let log = defer_order_log_new()
  loop_with_owned_opaque(log)
  Test.assert_eq(defer_order_log_read(log), 111)
}
