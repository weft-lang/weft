use runtime/rc_implicit_test.{*}

-- Regression locks for 2s registry item 4. Named functions used as
-- values share the all-owned indirect-call ABI with lambdas. Both read
-- targets only inspect their managed argument, so their direct ABI would
-- otherwise borrow it. Choosing between them at runtime keeps dispatch
-- genuinely indirect; the old mixed convention leaked one 64-byte node
-- per rvalue call (3,200,000 bytes in the 50k probe below).
type IndirectBorrowBox { IndirectBorrowBox(i64) }

fn indirect_borrow_read_a(box: IndirectBorrowBox) -> i64 {
  match box { IndirectBorrowBox(value) -> value }
}

fn indirect_borrow_read_b(box: IndirectBorrowBox) -> i64 {
  match box { IndirectBorrowBox(value) -> value + 1 }
}

fn indirect_borrow_choose(flag: i64) -> (IndirectBorrowBox) -> i64 {
  if flag == 0 { indirect_borrow_read_a } else { indirect_borrow_read_b }
}

fn indirect_borrow_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let f = indirect_borrow_choose(i % 2)
    acc = acc + f(IndirectBorrowBox(i))
    i = i + 1
  }
  acc
}

fn indirect_borrow_direct_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + indirect_borrow_read_a(IndirectBorrowBox(i))
    i = i + 1
  }
  acc
}

fn indirect_borrow_shared_churn(n: i64) -> i64 {
  let shared = IndirectBorrowBox(41)
  let mut i = 0
  let mut acc = 0
  while i < n {
    let f = indirect_borrow_choose(i % 2)
    acc = acc + f(shared)
    i = i + 1
  }
  acc + match shared { IndirectBorrowBox(value) -> value }
}

fn indirect_borrow_identity_a(box: IndirectBorrowBox) -> IndirectBorrowBox { box }
fn indirect_borrow_identity_b(box: IndirectBorrowBox) -> IndirectBorrowBox { box }

fn indirect_borrow_identity_choose(flag: i64) -> (IndirectBorrowBox) -> IndirectBorrowBox {
  if flag == 0 { indirect_borrow_identity_a } else { indirect_borrow_identity_b }
}

fn indirect_borrow_identity_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let f = indirect_borrow_identity_choose(i % 2)
    let box = f(IndirectBorrowBox(i))
    acc = acc + match box { IndirectBorrowBox(value) -> value }
    i = i + 1
  }
  acc
}

fn indirect_borrow_identity_direct_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let box = indirect_borrow_identity_a(IndirectBorrowBox(i))
    acc = acc + match box { IndirectBorrowBox(value) -> value }
    i = i + 1
  }
  acc
}

test "indirect_named_owned_rvalue_dispatch_correct" {
  Test.assert_eq(indirect_borrow_churn(1000), 500000)
}

test "indirect_named_owned_let_argument_survives" {
  -- The all-owned caller retains a let-bound argument before transfer;
  -- the callee consumes that count and the caller's original survives.
  Test.assert_eq(indirect_borrow_shared_churn(1000), 41541)
}

test "indirect_named_owned_return_alias_survives" {
  -- Returning the owned parameter takes a transfer count before the
  -- callee releases its incoming count.
  Test.assert_eq(indirect_borrow_identity_churn(1000), 499500)
}

test "indirect_named_owned_return_churn_stays_flat" {
  -- The indirect call's function type carries its managed result fact
  -- into the let binding, which must release the owned result at scope
  -- exit. The old direct-only result lookup leaked one 64-byte node per
  -- iteration even after argument ownership was aligned.
  indirect_borrow_identity_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(indirect_borrow_identity_churn(50000), 1249975000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "indirect_named_owned_rvalue_churn_stays_flat" {
  indirect_borrow_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(indirect_borrow_churn(50000), 1250000000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "address_taken_direct_call_uses_same_owned_contract" {
  -- read_a is address-taken elsewhere in this module. Its direct calls
  -- must see the same forced mask zero as its emitted entry.
  indirect_borrow_direct_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(indirect_borrow_direct_churn(50000), 1249975000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "address_taken_direct_owned_return_stays_flat" {
  indirect_borrow_identity_direct_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(indirect_borrow_identity_direct_churn(50000), 1249975000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}
