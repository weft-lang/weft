use runtime/rc_implicit_test.{*}

type ProductPatternPoint {
  x: i64,
  y: i64,
}

type ProductPatternGenericBox {
  value: i64,
  ignored: i64,
}

type ProductPatternManaged {
  probe: RuntimeRcProbe,
  marker: i64,
}

type ProductPatternWrap {
  ProductPatternRecord(ProductPatternPoint),
  ProductPatternTuple((i64, i64)),
  ProductPatternNested({pair: (i64, i64), tail: i64 | nil}),
}

type ProductPatternBit {
  ProductPatternZero,
  ProductPatternOne,
}

type ProductPatternMatrixOuter {
  ProductPatternMatrixWrap(ProductPatternBit, i64 | nil),
  ProductPatternMatrixEnd,
}

effect ProductPatternGate {
  fn allow(value: i64) -> bool
}

fn product_pattern_structural(value: {x: i64, y: i64}) -> i64 {
  match value {
    {y: right, x: left} -> left + right
  }
}

fn product_pattern_nominal(value: ProductPatternPoint) -> i64 {
  match value {
    {x, y: right} -> x + right
  }
}

fn product_pattern_tuple(value: (i64, i64)) -> i64 {
  match value {
    (left, right) -> left + right
  }
}

fn product_pattern_singleton(value: (i64,)) -> i64 {
  match value {
    (only,) -> only
  }
}

fn product_pattern_unit(value: ()) -> i64 {
  match value {
    () -> 42
  }
}

fn product_pattern_nested(value: ProductPatternWrap) -> i64 {
  match value {
    ProductPatternRecord({x: 20, y}) -> y
    ProductPatternTuple((left, 22)) -> left + 2
    ProductPatternNested({tail: n: i64, pair: (left, right)}) -> left + right + n
    ProductPatternNested({tail: nil, pair: (left, right)}) -> left + right
    _ -> 0
  }
}

fn product_pattern_guard(value: {x: i64, y: i64}) -[ProductPatternGate]> i64 {
  match value {
    {x, y} if ProductPatternGate.allow(x + y) -> x + y
    _ -> 0
  }
}

fn product_pattern_handle_guard(value: {x: i64, y: i64}) -> i64 {
  handle product_pattern_guard(value) {
    ProductPatternGate.allow(value) -> resume(value == 42)
  }
}

fn product_pattern_capture(value: (i64, i64)) -> i64 {
  match value {
    (left, right) -> {
      let read = () => left + right
      read()
    }
  }
}

fn product_pattern_generic<T>(value: {value: T, ..}, fallback: T) -> T {
  match value {
    {value} -> value
  }
}

fn product_pattern_unwrap_managed(value: ProductPatternManaged, fallback: RuntimeRcProbe) -> RuntimeRcProbe {
  match value {
    {probe, marker: _} -> probe
  }
}

fn product_pattern_unwrap_structural_managed(value: {probe: RuntimeRcProbe, marker: i64}, fallback: RuntimeRcProbe) -> RuntimeRcProbe {
  match value {
    {marker: _, probe} -> probe
  }
}

fn product_pattern_matrix_tuple(value: (ProductPatternBit, ProductPatternBit)) -> i64 {
  match value {
    (ProductPatternZero, ProductPatternZero) -> 0
    (ProductPatternZero, ProductPatternOne) -> 1
    (ProductPatternOne, ProductPatternZero) -> 2
    (ProductPatternOne, ProductPatternOne) -> 3
  }
}

fn product_pattern_matrix_record(value: {left: ProductPatternBit, right: ProductPatternBit}) -> i64 {
  match value {
    {left: ProductPatternZero, right: ProductPatternZero} -> 0
    {right: ProductPatternOne, left: ProductPatternZero} -> 1
    {left: ProductPatternOne, right: ProductPatternZero} -> 2
    {right: ProductPatternOne, left: ProductPatternOne} -> 3
  }
}

fn product_pattern_matrix_nested(value: ProductPatternMatrixOuter) -> i64 {
  match value {
    ProductPatternMatrixWrap(ProductPatternZero, nil) -> 0
    ProductPatternMatrixWrap(ProductPatternZero, n: i64) -> n
    ProductPatternMatrixWrap(ProductPatternOne, nil) -> 1
    ProductPatternMatrixWrap(ProductPatternOne, n: i64) -> n + 1
    ProductPatternMatrixEnd -> 42
  }
}

test "record patterns use semantic field identity and shorthand bindings" {
  Test.assert_eq(product_pattern_structural({y: 22, x: 20}), 42)
  Test.assert_eq(product_pattern_nominal(ProductPatternPoint { y: 22, x: 20 }), 42)
}

test "tuple patterns cover unit singleton and multi-lane values" {
  Test.assert_eq(product_pattern_tuple((20, 22)), 42)
  Test.assert_eq(product_pattern_singleton((42,)), 42)
  Test.assert_eq(product_pattern_unit(()), 42)
}

test "record and tuple patterns recurse through constructors and each other" {
  Test.assert_eq(product_pattern_nested(ProductPatternRecord(ProductPatternPoint { x: 20, y: 22 })), 22)
  Test.assert_eq(product_pattern_nested(ProductPatternTuple((20, 22))), 22)
  Test.assert_eq(product_pattern_nested(ProductPatternNested({pair: (10, 12), tail: 20})), 42)
  Test.assert_eq(product_pattern_nested(ProductPatternNested({tail: nil, pair: (20, 22)})), 42)
  Test.assert_eq(product_pattern_nested(ProductPatternTuple((20, 21))), 0)
}

test "product pattern guards see all recursive bindings" {
  Test.assert_eq(product_pattern_handle_guard({y: 22, x: 20}), 42)
  Test.assert_eq(product_pattern_handle_guard({x: 20, y: 21}), 0)
}

test "product pattern bindings participate in closure capture" {
  Test.assert_eq(product_pattern_capture((20, 22)), 42)
}

test "nominal record patterns cross generic specializations" {
  let box = ProductPatternGenericBox { ignored: 0, value: 42 }
  Test.assert_eq(product_pattern_generic<i64>(box, 0), 42)
}

test "nominal record patterns preserve managed field ownership" {
  let probe = runtime_rc_probe_new(0)
  let fallback = runtime_rc_probe_new(0)
  let unwrapped = product_pattern_unwrap_managed(ProductPatternManaged { marker: 0, probe: probe }, fallback)
  Test.assert_eq(runtime_rc_probe_count(unwrapped), 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  Test.assert_eq(runtime_rc_probe_count(fallback), 1)
}

test "structural record patterns preserve managed field ownership" {
  let probe = runtime_rc_probe_new(0)
  let fallback = runtime_rc_probe_new(0)
  let unwrapped = product_pattern_unwrap_structural_managed({marker: 0, probe: probe}, fallback)
  Test.assert_eq(runtime_rc_probe_count(unwrapped), 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  Test.assert_eq(runtime_rc_probe_count(fallback), 1)
}

test "recursive matrix proves tuple and record product combinations" {
  Test.assert_eq(product_pattern_matrix_tuple((ProductPatternZero, ProductPatternZero)), 0)
  Test.assert_eq(product_pattern_matrix_tuple((ProductPatternZero, ProductPatternOne)), 1)
  Test.assert_eq(product_pattern_matrix_tuple((ProductPatternOne, ProductPatternZero)), 2)
  Test.assert_eq(product_pattern_matrix_tuple((ProductPatternOne, ProductPatternOne)), 3)
  Test.assert_eq(product_pattern_matrix_record({right: ProductPatternOne, left: ProductPatternZero}), 1)
  Test.assert_eq(product_pattern_matrix_record({left: ProductPatternOne, right: ProductPatternZero}), 2)
}

test "recursive matrix composes constructors products and typed residuals" {
  Test.assert_eq(product_pattern_matrix_nested(ProductPatternMatrixWrap(ProductPatternZero, nil)), 0)
  Test.assert_eq(product_pattern_matrix_nested(ProductPatternMatrixWrap(ProductPatternZero, 42)), 42)
  Test.assert_eq(product_pattern_matrix_nested(ProductPatternMatrixWrap(ProductPatternOne, nil)), 1)
  Test.assert_eq(product_pattern_matrix_nested(ProductPatternMatrixWrap(ProductPatternOne, 41)), 42)
  Test.assert_eq(product_pattern_matrix_nested(ProductPatternMatrixEnd), 42)
}
