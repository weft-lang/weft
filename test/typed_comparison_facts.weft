use compiler/ir/data.{*}
use compiler/types/algebra.{*}
use compiler/pipeline.{*}
use compiler/backend/aarch64/codegen.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}
use stdlib/string.{*}

fn same_domain(a: IrComparisonDomain, b: IrComparisonDomain) -> bool {
  match a {
    IrComparisonSigned -> match b {
      IrComparisonSigned -> true
      _ -> false
    }
    IrComparisonUnsigned -> match b {
      IrComparisonUnsigned -> true
      _ -> false
    }
    IrComparisonF32 -> match b {
      IrComparisonF32 -> true
      _ -> false
    }
    IrComparisonF64 -> match b {
      IrComparisonF64 -> true
      _ -> false
    }
  }
}

fn assert_domain(prim: i64, expected: IrComparisonDomain) -[Test]> nil {
  for op in [IrEq, IrNe, IrLt, IrLe, IrGt, IrGe] {
    match ir_comparison_fact(IrFloatBinaryI64(3, prim, op, 1, 2)) {
      IrComparison(dst, actual_op, lhs, rhs, domain) -> {
        Test.assert_eq(dst, 3)
        Test.assert_eq(lhs, 1)
        Test.assert_eq(rhs, 2)
        Test.assert_eq(ir_binary_op_tag(actual_op), ir_binary_op_tag(op))
        Test.assert_true(same_domain(domain, expected))
      }
      IrNotComparison -> Test.assert_true(false)
    }
  }
}

test "comparison facts retain every primitive domain and operand identity" {
  for prim in [PRIM_I8(), PRIM_I16(), PRIM_I32(), PRIM_I64(), PRIM_ISIZE()] {
    assert_domain(prim, IrComparisonSigned)
  }
  for prim in [PRIM_U8(), PRIM_U16(), PRIM_U32(), PRIM_U64(), PRIM_USIZE()] {
    assert_domain(prim, IrComparisonUnsigned)
  }
  assert_domain(PRIM_F32(), IrComparisonF32)
  assert_domain(PRIM_F64(), IrComparisonF64)
  Test.assert_true(match ir_comparison_fact(IrBinaryI64(3, IrLt, 1, 2)) {
    IrComparison(3, IrLt, 1, 2, IrComparisonSigned) -> true
    _ -> false
  })
}

fn is_comparison(inst: IrInst) -> bool {
  match ir_comparison_fact(inst) {
    IrComparison(_, _, _, _, _) -> true
    IrNotComparison -> false
  }
}

test "comparison facts reject unknown domains and noncomparison instructions" {
  for prim in [PRIM_BOOL(), PRIM_STR(), 0 - 1] {
    Test.assert_true(not is_comparison(IrFloatBinaryI64(3, prim, IrLt, 1, 2)))
  }
  for op in [IrAdd, IrSub, IrMul, IrDiv, IrMod, IrBand, IrBor, IrBxor, IrBshl, IrBshr, IrBinaryUnknown] {
    Test.assert_true(not is_comparison(IrBinaryI64(3, op, 1, 2)))
    Test.assert_true(not is_comparison(IrFloatBinaryI64(3, PRIM_F64(), op, 1, 2)))
  }
  Test.assert_true(not is_comparison(IrConstI64(3, 1)))
  Test.assert_true(not is_comparison(IrCallI64(3, 42, IrValueCons(1, IrValueNil))))
}

fn typed_branch_blocks(inst: IrInst, extra: IrInstList, term: IrTerminator) -> IrBlockList {
  IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(inst, IrInstNil), IrTermBranch(3, 1, 2)),
    IrBlockListCons(IrBlock(1, IrValueNil, extra, term),
    IrBlockListCons(IrBlock(2, IrValueNil, IrInstNil, IrTermReturn(1)), IrBlockListNil)))
}

fn fuses(inst: IrInst, blocks: IrBlockList) -> bool {
  match pipeline_ir_native_direct_branch_cmp_info_with_uses(IrInstCons(inst, IrInstNil),
    IrTermBranch(3, 1, 2), pipeline_ir_value_use_facts(blocks)) {
    IrComparison(_, _, _, _, _) -> true
    IrNotComparison -> false
  }
}

test "every comparison domain requires exactly one branch and no value user" {
  for prim in [PRIM_I16(), PRIM_USIZE(), PRIM_F32(), PRIM_F64()] {
    let inst = IrFloatBinaryI64(3, prim, IrLt, 1, 2)
    Test.assert_true(fuses(inst, typed_branch_blocks(inst, IrInstNil, IrTermReturn(1))))
    Test.assert_true(not fuses(inst, typed_branch_blocks(inst, IrInstNil, IrTermReturn(3))))
    Test.assert_true(not fuses(inst, typed_branch_blocks(inst, IrInstNil, IrTermBranch(3, 2, 0))))
    Test.assert_true(not fuses(inst, typed_branch_blocks(inst,
      IrInstCons(IrStoreI64(8, 3), IrInstNil), IrTermReturn(1))))
  }
}

test "native branch lowering and residency audit cover all typed comparison domains" {
  for ty in ["i8", "i16", "i32", "isize", "u8", "u16", "u32", "u64", "usize", "f32", "f64"] {
    for op in ["==", "!=", "<", "<=", ">", ">="] {
      let signature = i"fn main(a: {ty}, b: {ty}) -> i64 "
      let source = signature.concat("{ if a ").concat(op).concat(" b { 1 } else { 0 } }")
      let typed = probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0)
      let optimized = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
      let native = pipeline_lower_native_module_with_audit(typed, optimized, 1)
      Test.assert_eq(pipeline_native_direct_branch_lowering_count(native), 1)
      Test.assert_eq(fmap_emit_error_count(pipeline_native_fmap(native)), 0)
    }
  }
}
