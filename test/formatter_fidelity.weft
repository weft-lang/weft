use compiler/formatter.{*}
use compiler/grammar.{*}
use compiler/lex.{*}
use compiler/lib.{src_eq_at}
use compiler/diagnose.{*}
use compiler/type_registry.{ttable_new}

fn formatter_test_parsed_tokens(source: str) -> i64 {
  let grammar = weft_grammar()
  let tokens = grammar.lex(__str_ptr(source), __str_len(source))
  let tt = ttable_new()
  let _ = handle grammar.parse_tokens(tokens, __str_ptr(source), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  tokens
}

fn formatter_test_role_count(tokens: i64, role: i64) -> i64 {
  let mut count = 0
  for i in 0..tok_count(tokens) {
    if tok_syntax_role(tokens, i) == role { count = count + 1 } else { 0 }
  }
  count
}

fn formatter_test_unmarked_angle_count(tokens: i64) -> i64 {
  let mut count = 0
  for i in 0..tok_count(tokens) {
    if tok_tag(tokens, i) == 4 and (tok_v1(tokens, i) == 7 or tok_v1(tokens, i) == 8) and tok_syntax_role(tokens, i) == 0 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn formatter_test_first_text_mismatch(left_src: i64, left_tokens: i64, right_src: i64, right_tokens: i64) -> i64 {
  let mut mismatch = 0
  let mut i = 0
  while i < tok_count(left_tokens) and mismatch == 0 {
    let left_start = tok_span(left_tokens, i)
    let left_len = tok_end(left_tokens, i) - left_start
    let right_start = tok_span(right_tokens, i)
    let right_len = tok_end(right_tokens, i) - right_start
    if left_len != right_len or (left_len > 0 and src_eq_at(left_src, left_start, right_src + right_start, 0, left_len) == 0) {
      mismatch = i + 1
    } else {
      i = i + 1
    }
  }
  mismatch
}

test "formatter_simple_source_preserves_tokens" {
  let source = "fn main() -> i64 { 42 }\n"
  let source_ptr = __str_ptr(source)
  let tokens = lex(source_ptr, __str_len(source))
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = lex(rendered_ptr, __str_len(rendered))

  Test.assert_str_eq(rendered, source)
  Test.assert_eq(tok_count(rendered_tokens), tok_count(tokens))
  for i in 0..tok_count(tokens) {
    Test.assert_eq(tok_tag(rendered_tokens, i), tok_tag(tokens, i))
    Test.assert_eq(tok_v1(rendered_tokens, i), tok_v1(tokens, i))
    Test.assert_eq(tok_v2(rendered_tokens, i), tok_v2(tokens, i))
    Test.assert_eq(tok_end(rendered_tokens, i) - tok_span(rendered_tokens, i), tok_end(tokens, i) - tok_span(tokens, i))
  }
  Test.assert_eq(formatter_test_first_text_mismatch(source_ptr, tokens, rendered_ptr, rendered_tokens), 0)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_inserted_semicolon_preserves_tokens" {
  let source = "fn main() -> i64 {\n  let x = 41\n  x + 1\n}\n"
  let source_ptr = __str_ptr(source)
  let tokens = lex(source_ptr, __str_len(source))
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = lex(rendered_ptr, __str_len(rendered))

  Test.assert_str_eq(rendered, source)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_parser_marks_generic_angles_not_comparisons" {
  let source = "fn id<T>(x: T) -> T { x } fn main() -> i64 { if 1 < 2 { id<Vector<i64>>(42) } else { 0 } }"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, 1), 6)
  Test.assert_eq(formatter_test_unmarked_angle_count(tokens), 1)
}

test "formatter_parser_marks_parameterized_effect_angles" {
  let source = "effect Box<T> { fn get() -> T } fn read_box<T>() -[Box<T>]> T { perform Box<T>.get() }"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, 1), 8)
  -- The `>` in the effect-arrow close `]>` is lexical punctuation, not a
  -- generic delimiter, and must remain unmarked.
  Test.assert_eq(formatter_test_unmarked_angle_count(tokens), 1)
}
