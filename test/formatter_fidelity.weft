use compiler/formatter.{*}
use compiler/grammar.{*}
use compiler/lex.{*}
use compiler/lib.{src_eq_at}
use compiler/diagnose.{*}
use compiler/type_registry.{ttable_new}
use stdlib/string.{str_concat, str_eq}
use stdlib/vector.{*}

fn formatter_test_parsed_tokens(source: str) -> i64 {
  let grammar = weft_grammar()
  let tokens = grammar.lex(__str_ptr(source), __str_len(source))
  let tt = ttable_new()
  let _ = handle grammar.parse_tokens(tokens, __str_ptr(source), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  tokens
}

fn formatter_test_role_count(tokens: i64, role: i64) -> i64 {
  let mut count = 0
  for i in 0..tok_count(tokens) {
    if tok_syntax_role(tokens, i) == role { count = count + 1 } else { 0 }
  }
  count
}

fn formatter_test_unmarked_angle_count(tokens: i64) -> i64 {
  let mut count = 0
  for i in 0..tok_count(tokens) {
    if tok_tag(tokens, i) == 4 and (tok_v1(tokens, i) == 7 or tok_v1(tokens, i) == 8) and tok_syntax_role(tokens, i) == 0 {
      count = count + 1
    } else { 0 }
  }
  count
}

fn formatter_test_first_text_mismatch(left_src: i64, left_tokens: i64, right_src: i64, right_tokens: i64) -> i64 {
  let mut mismatch = 0
  let mut i = 0
  while i < tok_count(left_tokens) and mismatch == 0 {
    let left_start = tok_span(left_tokens, i)
    let left_len = tok_end(left_tokens, i) - left_start
    let right_start = tok_span(right_tokens, i)
    let right_len = tok_end(right_tokens, i) - right_start
    if left_len != right_len or (left_len > 0 and src_eq_at(left_src, left_start, right_src + right_start, 0, left_len) == 0) {
      mismatch = i + 1
    } else {
      i = i + 1
    }
  }
  mismatch
}

fn formatter_matrix_format(source: str) -> FormatterResult {
  let tt = ttable_new()
  handle formatter_format_source(__str_ptr(source), __str_len(source), tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn formatter_matrix_roundtrips(source: str) -> bool {
  match formatter_matrix_format(source) {
    FormatterFailure(count) -> false
    FormatterSuccess(formatted) -> match formatter_matrix_format(formatted) {
      FormatterFailure(count) -> false
      FormatterSuccess(second) -> str_eq(formatted, second) == 1
    }
  }
}

fn formatter_matrix_rejects(source: str) -> bool {
  match formatter_matrix_format(source) {
    FormatterFailure(count) -> count > 0
    FormatterSuccess(formatted) -> false
  }
}

fn formatter_matrix_comment_variant(source: str) -> str {
  str_concat(
    "-- generated  header — exact\n--- generated  docs — exact\n",
    str_concat(source, "\n-- generated  tail — exact\n")
  )
}

fn formatter_matrix_interpolation_source() -> str {
  -- Split immediately after `{` so this test source does not interpolate the
  -- fixture before the fixture reaches the formatter.
  str_concat(
    "type MatrixOptionalBox { value: i64 } fn matrix_sugar(result: Result<i64, str>, box: MatrixOptionalBox | nil) -[Fail<str>, Maybe]> str { let value = result? \"value ",
    str_concat("{", "value + box?.value}\\n雪\" }")
  )
}

-- One parser-valid source per shipped surface family. The matrix runner also
-- derives a comment-adjacent form from every row, so additions here cover the
-- dense base, canonical second pass, and exact Unicode comment transport.
fn formatter_matrix_sources() -> Vector<str> {
  let cases = vector_new<str>()
  -- 0: module import, alias, selection, wildcard, public/package re-export.
  vector_push<str>(cases, "use stdlib/option use stdlib/result as result_types use stdlib/list.{ List, Cons as Prepend } use stdlib/maybe.{ * } pub use stdlib/fail.{ Fail } pub(package) use compiler/ir as unstable_ir fn main() -> i64 { 0 }")
  -- 1: record/variant/effect/trait/impl/test declarations and visibility.
  vector_push<str>(cases, "pub type MatrixRecord<T> { value: T } pub(package) type MatrixChoice { Empty, Full(i64, str) } pub effect MatrixEff<T> { fn get() -> T @deferred fn later(value: T) -> T } pub trait MatrixTrait { type Item fn read(self: Self) -> Self.Item } impl<T> MatrixRecord<T> { pub fn unwrap(self: MatrixRecord<T>) -> T { self.value } } test \"matrix\" { Test.assert_eq(1, 1) } fn main() -> i64 { 0 }")
  -- 2: associated type bound/projection/binding and effectful trait method.
  vector_push<str>(cases, "trait MatrixMarker { } effect MatrixRead { fn read() -> i64 } trait MatrixAssoc { type Item: MatrixMarker fn get(self: Self) -[MatrixRead]> Self.Item } type MatrixAssocBox { value: i64 } impl MatrixAssoc for MatrixAssocBox { type Item = i64 fn get(self: MatrixAssocBox) -[MatrixRead]> i64 { MatrixRead.read() } } fn main() -> i64 { 0 }")
  -- 3: positional/external/named params, generics, effect tail, function type.
  vector_push<str>(cases, "effect MatrixFx { fn tick() -> nil } type MatrixBox<T> { value: T } fn matrix_signature<T, U, E>(_ positional: T, external inner: U, named: i64, callback: (T) -[E]> U, fixed: [i64; 2], view: [i64], writable: [mut i64], pointer: *i64, mutable_pointer: *mut i64) -[MatrixFx, E]> { left: T, right: U } { { left: positional, right: inner } }")
  -- 4: qualified where bound and qualified member syntax.
  vector_push<str>(cases, "use module_fixtures/g2_trait_right as right fn read_right<T>(value: T) -> i64 where T: right.Gauge { value.right() } fn main() -> i64 { 0 }")
  -- 5: primitive/set/product/indexed/pointer/ownership/function type atoms.
  vector_push<str>(cases, "effect MatrixTypeFx { fn tick() -> nil } type MatrixTypeBox { value: i64 } fn matrix_types(a: i8, b: i16, c: i32, d: i64, e: u8, f: u16, g: u32, h: u64, i: isize, j: usize, k: f32, l: f64, m: str, n: bool, o: nil, p: never, q: any, r: i64 | str, s: i64 & any, t: ~nil, u: i64?, v: { x: i64, ..}, w: {}, x: (i64, str), y: (i64,), z: (), aa: [i64; 2], ab: [i64], ac: [mut i64], ad: *i64, ae: *mut i64, af: weak MatrixTypeBox, ag: unique MatrixTypeBox, ah: owned MatrixTypeBox, ai: (i64) -> i64, aj: (i64) -[MatrixTypeFx]> i64) -> any { q }")
  -- 6: literals, every operator family, grouping, comparison, and pipe.
  vector_push<str>(cases, "fn matrix_id(value: i64) -> i64 { value } fn matrix_operators(x: i64, y: i64) -> i64 { let integer = 42 let float = 1.25 let text = \"line\\n\\\"雪\" let nothing = nil let arithmetic = -x + y * 2 / 1 % 3 let bits = x bshl 1 bshr 1 band y bxor y bor x if (x < y or x <= y or x > y or x >= y or x != y or x == y) and not false { arithmetic + bits |> matrix_id() } else { 0 } }")
  -- 7: labeled/generic calls, typed and capturing lambdas, method-like postfix.
  vector_push<str>(cases, "fn matrix_call(_ positional: i64, external inner: i64, named: i64) -> i64 { positional + inner + named } fn matrix_generic<T>(value: T) -> T { value } fn matrix_lambdas() -> i64 { let captured = 1 let unary = (value: i64) => value + captured let pair = (left: i64, right: i64) => left + right matrix_call(1, 2, 3) + matrix_generic<i64>(unary(34)) + pair(0, 1) }")
  -- 8: while/for/if-let/loop/break/continue/return/defer control surface.
  vector_push<str>(cases, "type MatrixControlOpt { MatrixSome(i64), MatrixNone } fn matrix_control(limit: i64) -> i64 { let mut total = 0 let mut i = 0 while i < limit { i = i + 1 if i == 2 { continue } else { 0 } } for j in 0..limit { total = total + j } if let MatrixSome(value) = MatrixSome(total) { defer 0 if value > 0 { return value } else { loop { break(0) } } } else { 0 } } fn matrix_return_none(flag: bool) -> nil { if flag { return nil } else { nil } } fn matrix_break_none() -> nil { loop { break } }")
  -- 9: nominal/anonymous records, tuples, arrays, indexing/slicing/update.
  vector_push<str>(cases, "type MatrixPoint { x: i64, y: i64 } fn matrix_shapes() -> i64 { let nominal = MatrixPoint { y: 2, x: 1 } let anonymous = { right: 2, left: 1 } let pair = (anonymous.left, anonymous.right) let singleton = (pair.0,) let unit = () let empty = {} let mut values = [1, 2, 3] values[0] = 4 let all = values[..] let prefix = values[..2] let suffix = values[1..] let middle = values[1..2] let updated = nominal.{ x: 40 }.{ y: 2 } updated.x + updated.y + singleton.0 + all.len + prefix.len + suffix.len + middle.len }")
  -- 10: recursive patterns, guards, typed/nil arms, destructuring let/for.
  vector_push<str>(cases, "type MatrixPattern { MatrixNone, MatrixPair(i64, i64), MatrixRecord({ x: i64, y: i64 }) } fn matrix_match(value: MatrixPattern | nil) -> i64 { match value { MatrixPair(20, right) if right > 0 -> right MatrixRecord({ x, y: right }) -> x + right item: MatrixPattern -> 0 nil -> 0 _ -> 0 } } fn matrix_destructure(value: ((i64, i64), { tail: i64 })) -> i64 { let ((left, middle), { tail }): ((i64, i64), { tail: i64 }) = value let mut total = left + middle + tail for ({ x, y }, n) in [({ x: 1, y: 2 }, 3)] { total = total + x + y + n } total }")
  -- 11: immediate/abortive/deferred/return handlers and qualified effects.
  vector_push<str>(cases, "effect MatrixBoxEffect<T> { fn get() -> T fn put(value: T) -> nil } effect MatrixDeferred { @deferred fn step(value: i64) -> i64 } fn matrix_perform() -[MatrixBoxEffect<i64>]> i64 { MatrixBoxEffect<i64>.put(1) MatrixBoxEffect<i64>.get() } fn matrix_handle() -> i64 { handle matrix_perform() { MatrixBoxEffect<i64>.get() -> resume(41) MatrixBoxEffect<i64>.put(value) -> resume(nil) return value -> value + 1 } } fn matrix_abort() -> i64 { handle matrix_perform() { MatrixBoxEffect<i64>.get() -> 42 MatrixBoxEffect<i64>.put(value) -> resume(nil) } } fn matrix_deferred() -> i64 { handle MatrixDeferred.step(1) { MatrixDeferred.step(value) with k -> k(value + 1) } }")
  -- 12: error/optional sugar, string escapes/interpolation, field chaining.
  vector_push<str>(cases, formatter_matrix_interpolation_source())
  -- 13: trusted pointer expression spellings (formatter remains parse-only).
  vector_push<str>(cases, "fn matrix_pointer(value: i64, pointer: *i64, mutable_pointer: *mut i64) -[Unsafe]> i64 { let local = value let address = &local let mut mutable = 0 let mutable_address = &mut mutable mutable_address.* = pointer.* + address.* mutable_pointer.* = mutable_address.* mutable_pointer.* }")
  cases
}

fn formatter_matrix_failures() -> Vector<str> {
  let cases = vector_new<str>()
  vector_push<str>(cases, "fn broken() -> i64 { 1")
  vector_push<str>(cases, "fn broken -> i64 { 1 } fn after() -> i64 { 2 }")
  vector_push<str>(cases, "extern fn forbidden() -> i64 { 0 } fn main() -> i64 { 0 }")
  vector_push<str>(cases, "fn labeled(_ positional: i64, named: i64) -> i64 { positional + named } fn main() -> i64 { labeled(1, named: 2) }")
  cases
}

test "formatter_simple_source_preserves_tokens" {
  let source = "fn main() -> i64 { 42 }\n"
  let source_ptr = __str_ptr(source)
  let tokens = lex(source_ptr, __str_len(source))
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = lex(rendered_ptr, __str_len(rendered))

  Test.assert_str_eq(rendered, source)
  Test.assert_eq(tok_count(rendered_tokens), tok_count(tokens))
  for i in 0..tok_count(tokens) {
    Test.assert_eq(tok_tag(rendered_tokens, i), tok_tag(tokens, i))
    Test.assert_eq(tok_v1(rendered_tokens, i), tok_v1(tokens, i))
    Test.assert_eq(tok_v2(rendered_tokens, i), tok_v2(tokens, i))
    Test.assert_eq(tok_end(rendered_tokens, i) - tok_span(rendered_tokens, i), tok_end(tokens, i) - tok_span(tokens, i))
  }
  Test.assert_eq(formatter_test_first_text_mismatch(source_ptr, tokens, rendered_ptr, rendered_tokens), 0)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_inserted_semicolon_preserves_tokens" {
  let source = "fn main() -> i64 {\n  let x = 41\n  x + 1\n}\n"
  let source_ptr = __str_ptr(source)
  let tokens = lex(source_ptr, __str_len(source))
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = lex(rendered_ptr, __str_len(rendered))

  Test.assert_str_eq(rendered, source)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_indents_nested_blocks_and_preserves_comment_text" {
  let source = "-- leading  text — exact\nfn main() -> i64 {\n let x = 40 -- inline  text\n if true {\n    -- nested  text\n x   +   2\n } else {\n0\n}\n}\n"
  let expected = "-- leading  text — exact\n\nfn main() -> i64 {\n  let x = 40 -- inline  text\n  if true {\n    -- nested  text\n    x + 2\n  } else {\n    0\n  }\n}\n"
  let source_ptr = __str_ptr(source)
  let tokens = formatter_test_parsed_tokens(source)
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = formatter_test_parsed_tokens(rendered)

  Test.assert_str_eq(rendered, expected)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_indents_expression_continuations_once" {
  let source = "fn continued() -> bool {\n true and\n false\n}\n"
  let expected = "fn continued() -> bool {\n  true and\n    false\n}\n"
  let tokens = formatter_test_parsed_tokens(source)
  let rendered = formatter_render_tokens(__str_ptr(source), __str_len(source), tokens)
  Test.assert_str_eq(rendered, expected)
}

test "formatter_parser_marks_top_level_imports_and_declarations" {
  let source = "use compiler/formatter.{*}\nuse compiler/lex.{*}\nfn first() -> i64 { 1 }\nfn second() -> i64 { 2 }\n"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_top_level_import()), 2)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_top_level_decl()), 2)
}

test "formatter_groups_top_level_imports_and_declarations" {
  let source = "use compiler/formatter.{*}\n\n\nuse compiler/lex.{*}\nfn first() -> i64 { 1 }\n\n\nfn second() -> i64 { 2 }\n"
  let expected = "use compiler/formatter.{*}\nuse compiler/lex.{*}\n\nfn first() -> i64 { 1 }\n\nfn second() -> i64 { 2 }\n"
  let source_ptr = __str_ptr(source)
  let tokens = formatter_test_parsed_tokens(source)
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = formatter_test_parsed_tokens(rendered)

  Test.assert_str_eq(rendered, expected)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_attaches_top_level_comments_canonically" {
  let source = "-- module  header\n\n\nuse compiler/formatter.{*}\n\n\n-- import  note\n\nuse compiler/lex.{*}\n\nfn first() -> i64 { 1 } -- trailing  exact\n\n\n--- next  docs\n\n\nfn second() -> i64 { 2 }\n"
  let expected = "-- module  header\n\nuse compiler/formatter.{*}\n-- import  note\nuse compiler/lex.{*}\n\nfn first() -> i64 { 1 } -- trailing  exact\n\n--- next  docs\nfn second() -> i64 { 2 }\n"
  let source_ptr = __str_ptr(source)
  let tokens = formatter_test_parsed_tokens(source)
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = formatter_test_parsed_tokens(rendered)

  Test.assert_str_eq(rendered, expected)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_separates_same_line_top_level_declarations" {
  let source = "fn first() -> i64 { 1 } fn second() -> i64 { 2 }\n"
  let expected = "fn first() -> i64 { 1 }\n\nfn second() -> i64 { 2 }\n"
  let source_ptr = __str_ptr(source)
  let tokens = formatter_test_parsed_tokens(source)
  let rendered = formatter_render_tokens(source_ptr, __str_len(source), tokens)
  let rendered_ptr = __str_ptr(rendered)
  let rendered_tokens = lex(rendered_ptr, __str_len(rendered))

  Test.assert_str_eq(rendered, expected)
  Test.assert_eq(tok_count(rendered_tokens), tok_count(tokens) + 1)
  Test.assert_true(formatter_tokens_equivalent(source_ptr, tokens, rendered_ptr, rendered_tokens))
}

test "formatter_keeps_block_local_synthetic_separators_exact" {
  let separated = "fn main() -> i64 {\n  let x = 41\n  x + 1\n}\n"
  let joined = "fn main() -> i64 {\n  let x = 41 x + 1\n}\n"
  let separated_tokens = formatter_test_parsed_tokens(separated)
  let joined_tokens = lex(__str_ptr(joined), __str_len(joined))
  Test.assert_false(formatter_tokens_equivalent(__str_ptr(separated), separated_tokens, __str_ptr(joined), joined_tokens))
}

test "formatter_parser_marks_generic_angles_not_comparisons" {
  let source = "fn id<T>(x: T) -> T { x } fn main() -> i64 { if 1 < 2 { id<Vector<i64>>(42) } else { 0 } }"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_generic_angle()), 6)
  Test.assert_eq(formatter_test_unmarked_angle_count(tokens), 1)
}

test "formatter_parser_marks_parameterized_effect_angles" {
  let source = "effect Box<T> { fn get() -> T } fn read_box<T>() -[Box<T>]> T { perform Box<T>.get() }"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_generic_angle()), 8)
  -- The `>` in the effect-arrow close `]>` is not a generic delimiter; the
  -- parser marks both close tokens with their distinct effect-close role.
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_effect_close()), 2)
  Test.assert_eq(formatter_test_unmarked_angle_count(tokens), 0)
}

test "formatter_parser_marks_module_and_import_punctuation" {
  let source = "use compiler / formatter.{ * } fn main() -> i64 { 42 }"
  let tokens = formatter_test_parsed_tokens(source)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_module_path()), 1)
  Test.assert_eq(formatter_test_role_count(tokens, tok_syntax_role_import_selection()), 3)
}

test "formatter_generated_surface_matrix_roundtrips_every_row" {
  let cases = formatter_matrix_sources()
  let failures = vector_new<i64>()
  Test.assert_eq(vector_len<str>(cases), 14)
  for i in 0..vector_len<str>(cases) {
    let source = vector_get_in_bounds<str>(cases, i)
    if not formatter_matrix_roundtrips(source) { vector_push<i64>(failures, i * 2) } else { 0 }
    if not formatter_matrix_roundtrips(formatter_matrix_comment_variant(source)) { vector_push<i64>(failures, i * 2 + 1) } else { 0 }
  }
  Test.assert_i64_vector_eq(failures, vector_new<i64>())
}

test "formatter_generated_failure_matrix_fails_closed" {
  let cases = formatter_matrix_failures()
  let accepted = vector_new<i64>()
  Test.assert_eq(vector_len<str>(cases), 4)
  for i in 0..vector_len<str>(cases) {
    if not formatter_matrix_rejects(vector_get_in_bounds<str>(cases, i)) { vector_push<i64>(accepted, i) } else { 0 }
  }
  Test.assert_i64_vector_eq(accepted, vector_new<i64>())
}
