-- test/dns_static.weft — pure static resolver wire/configuration semantics

use runtime/dns_static.{DnsStaticConfig, DnsWireA, DnsWireAAAA, DnsWireAnswers, DnsWireMalformed, DnsWireNameNotFound, DnsWireNoData, DnsWirePermanent, DnsWireResourceExhausted, DnsWireTemporary, DnsWireTruncated, dns_static_config_attempts, dns_static_config_servers, dns_static_config_timeout_ms, dns_static_hosts_lookup, dns_static_parse_resolv, dns_wire_parse_reply, dns_wire_query}
use stdlib/eq.{Eq}
use stdlib/idna.{DomainName, domain_name_parse}
use stdlib/net_address.{IpAddress, IpV4, IpV6, ipv4_address, ipv6_address}
use stdlib/num.{num_i64_to_u8_checked}
use stdlib/result.{Result}
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push, vector_set, vector_with_capacity}
use stdlib/vector/handles.{Vector}

fn dns_static_test_u8(value: i64) -> u8 {
  num_i64_to_u8_checked(value).unwrap_or(0)
}

fn dns_static_test_byte(values: Vector<u8>, index: i64) -> i64 {
  __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(values, index)))
}

fn dns_static_test_push_u16(values: Vector<u8>, value: i64) -> i64 {
  vector_push<u8>(values, dns_static_test_u8((value bshr 8) band 255))
  vector_push<u8>(values, dns_static_test_u8(value band 255))
}

fn dns_static_test_domain(source: str) -> DomainName {
  domain_name_parse(source).expect("static DNS test name must be valid")
}

fn dns_static_test_reply(transaction: i64, name: str, record: i64) -> Vector<u8> {
  let values = if record == 1 {
    dns_wire_query(transaction, name, DnsWireA)
  } else {
    dns_wire_query(transaction, name, DnsWireAAAA)
  }
  vector_set<u8>(values, 2, dns_static_test_u8(129))
  vector_set<u8>(values, 3, dns_static_test_u8(128))
  vector_set<u8>(values, 7, dns_static_test_u8(1))
  vector_push<u8>(values, dns_static_test_u8(192))
  vector_push<u8>(values, dns_static_test_u8(12))
  dns_static_test_push_u16(values, record)
  dns_static_test_push_u16(values, 1)
  vector_push<u8>(values, dns_static_test_u8(0))
  vector_push<u8>(values, dns_static_test_u8(0))
  vector_push<u8>(values, dns_static_test_u8(0))
  vector_push<u8>(values, dns_static_test_u8(60))
  values
}

fn dns_static_test_answer_header(
  transaction: i64,
  name: str,
  record: i64,
  answers: i64
) -> Vector<u8> {
  let values = if record == 1 {
    dns_wire_query(transaction, name, DnsWireA)
  } else {
    dns_wire_query(transaction, name, DnsWireAAAA)
  }
  vector_set<u8>(values, 2, dns_static_test_u8(129))
  vector_set<u8>(values, 3, dns_static_test_u8(128))
  vector_set<u8>(values, 6, dns_static_test_u8((answers bshr 8) band 255))
  vector_set<u8>(values, 7, dns_static_test_u8(answers band 255))
  values
}

fn dns_static_test_i64s(a: i64, b: i64) -> Vector<i64> {
  let values = vector_with_capacity<i64>(2)
  vector_push<i64>(values, a)
  vector_push<i64>(values, b)
  values
}

fn dns_static_test_bytes(values: Vector<i64>) -> Vector<u8> {
  let out = vector_with_capacity<u8>(vector_len<i64>(values))
  for index in 0..vector_len<i64>(values) {
    vector_push<u8>(out, dns_static_test_u8(vector_get_in_bounds<i64>(values, index)))
  }
  out
}

fn dns_static_test_ipv4_rdata(a: i64, b: i64, c: i64, d: i64) -> Vector<u8> {
  let octets = vector_with_capacity<i64>(4)
  vector_push<i64>(octets, a)
  vector_push<i64>(octets, b)
  vector_push<i64>(octets, c)
  vector_push<i64>(octets, d)
  dns_static_test_bytes(octets)
}

--- Append one compressed-owner resource record, declaring `length` rather than
--- the real payload size so overflow cases stay expressible.
fn dns_static_test_push_record_sized(
  values: Vector<u8>,
  record_type: i64,
  record_class: i64,
  rdata: Vector<u8>,
  length: i64
) -> i64 {
  vector_push<u8>(values, dns_static_test_u8(192))
  vector_push<u8>(values, dns_static_test_u8(12))
  dns_static_test_push_u16(values, record_type)
  dns_static_test_push_u16(values, record_class)
  dns_static_test_push_u16(values, 0)
  dns_static_test_push_u16(values, 60)
  dns_static_test_push_u16(values, length)
  for index in 0..vector_len<u8>(rdata) {
    vector_push<u8>(values, vector_get_in_bounds<u8>(rdata, index))
  }
  vector_len<u8>(values)
}

fn dns_static_test_push_record(
  values: Vector<u8>,
  record_type: i64,
  record_class: i64,
  rdata: Vector<u8>
) -> i64 {
  dns_static_test_push_record_sized(values, record_type, record_class, rdata, vector_len<u8>(rdata))
}

fn dns_static_test_ipv4_answer(addresses: Vector<IpAddress>, index: i64, a: u8, b: u8, c: u8, d: u8) -> i64 {
  match vector_get_in_bounds<IpAddress>(addresses, index) {
    IpV4(address) -> if address.eq(ipv4_address(a, b, c, d)) { 1 } else { 0 }
    _ -> 0
  }
}

test "DNS query encoding is exact and carries canonical labels" {
  let query = dns_wire_query(4660, "example.test", DnsWireAAAA)
  Test.assert_eq(vector_len<u8>(query), 30)
  Test.assert_eq(dns_static_test_byte(query, 0), 18)
  Test.assert_eq(dns_static_test_byte(query, 1), 52)
  Test.assert_eq(dns_static_test_byte(query, 2), 1)
  Test.assert_eq(dns_static_test_byte(query, 5), 1)
  Test.assert_eq(dns_static_test_byte(query, 12), 7)
  Test.assert_eq(dns_static_test_byte(query, 20), 4)
  Test.assert_eq(dns_static_test_byte(query, 25), 0)
  Test.assert_eq(dns_static_test_byte(query, 27), 28)
  Test.assert_eq(dns_static_test_byte(query, 29), 1)
}

test "DNS wire replies decode exact A and AAAA values" {
  let v4 = dns_static_test_reply(7, "answer.test", 1)
  dns_static_test_push_u16(v4, 4)
  vector_push<u8>(v4, dns_static_test_u8(192))
  vector_push<u8>(v4, dns_static_test_u8(0))
  vector_push<u8>(v4, dns_static_test_u8(2))
  vector_push<u8>(v4, dns_static_test_u8(9))
  match dns_wire_parse_reply(v4, 7, "answer.test", DnsWireA) {
    DnsWireAnswers(addresses) -> match vector_get_in_bounds<IpAddress>(addresses, 0) {
      IpV4(address) -> Test.assert_eq(if address.eq(ipv4_address(192, 0, 2, 9)) { 1 } else { 0 }, 1)
      _ -> Test.assert_eq(0, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }

  let v6 = dns_static_test_reply(8, "answer.test", 28)
  dns_static_test_push_u16(v6, 16)
  dns_static_test_push_u16(v6, 8193)
  dns_static_test_push_u16(v6, 3512)
  for index in 0..5 { dns_static_test_push_u16(v6, 0) }
  dns_static_test_push_u16(v6, 9)
  match dns_wire_parse_reply(v6, 8, "answer.test", DnsWireAAAA) {
    DnsWireAnswers(addresses) -> match vector_get_in_bounds<IpAddress>(addresses, 0) {
      IpV6(address) -> Test.assert_eq(if address.eq(ipv6_address(8193, 3512, 0, 0, 0, 0, 0, 9)) { 1 } else { 0 }, 1)
      _ -> Test.assert_eq(0, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

fn dns_static_test_reply_kind(values: Vector<u8>, transaction: i64) -> i64 {
  match dns_wire_parse_reply(values, transaction, "status.test", DnsWireA) {
    DnsWireAnswers(_) -> 1
    DnsWireNoData -> 2
    DnsWireNameNotFound -> 3
    DnsWireTemporary -> 4
    DnsWireResourceExhausted -> 7
    DnsWirePermanent -> 5
    DnsWireTruncated -> 6
    DnsWireMalformed(offset) -> 100 + offset
  }
}

test "DNS wire status mapping is typed and fail closed" {
  let missing = dns_wire_query(9, "status.test", DnsWireA)
  vector_set<u8>(missing, 2, dns_static_test_u8(129))
  vector_set<u8>(missing, 3, dns_static_test_u8(131))
  Test.assert_eq(dns_static_test_reply_kind(missing, 9), 3)

  let temporary = dns_wire_query(10, "status.test", DnsWireA)
  vector_set<u8>(temporary, 2, dns_static_test_u8(129))
  vector_set<u8>(temporary, 3, dns_static_test_u8(130))
  Test.assert_eq(dns_static_test_reply_kind(temporary, 10), 4)

  let refused = dns_wire_query(11, "status.test", DnsWireA)
  vector_set<u8>(refused, 2, dns_static_test_u8(129))
  vector_set<u8>(refused, 3, dns_static_test_u8(133))
  Test.assert_eq(dns_static_test_reply_kind(refused, 11), 5)

  let truncated = dns_wire_query(12, "status.test", DnsWireA)
  vector_set<u8>(truncated, 2, dns_static_test_u8(131))
  vector_set<u8>(truncated, 3, dns_static_test_u8(128))
  Test.assert_eq(dns_static_test_reply_kind(truncated, 12), 6)
  Test.assert_eq(dns_static_test_reply_kind(truncated, 13), 100)
}

test "DNS parser rejects forward compression pointers and invalid RDATA lengths" {
  let pointer = dns_static_test_reply(14, "bad.test", 1)
  dns_static_test_push_u16(pointer, 4)
  vector_push<u8>(pointer, dns_static_test_u8(192))
  vector_push<u8>(pointer, dns_static_test_u8(0))
  vector_push<u8>(pointer, dns_static_test_u8(2))
  vector_push<u8>(pointer, dns_static_test_u8(1))
  vector_set<u8>(pointer, vector_len<u8>(dns_wire_query(14, "bad.test", DnsWireA)), dns_static_test_u8(193))
  match dns_wire_parse_reply(pointer, 14, "bad.test", DnsWireA) {
    DnsWireMalformed(_) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }

  let short = dns_static_test_reply(15, "bad.test", 1)
  dns_static_test_push_u16(short, 3)
  vector_push<u8>(short, dns_static_test_u8(192))
  vector_push<u8>(short, dns_static_test_u8(0))
  vector_push<u8>(short, dns_static_test_u8(2))
  match dns_wire_parse_reply(short, 15, "bad.test", DnsWireA) {
    DnsWireMalformed(_) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "resolv.conf parsing is bounded deterministic policy data" {
  let config = dns_static_parse_resolv(
    "# local policy\nnameserver 192.0.2.53\nnameserver invalid\nnameserver 2001:db8::53\nnameserver 198.51.100.53\nnameserver 203.0.113.53\noptions timeout:99 attempts:9 rotate\n"
  )
  Test.assert_eq(vector_len<IpAddress>(dns_static_config_servers(config)), 3)
  Test.assert_eq(dns_static_config_timeout_ms(config), 30000)
  Test.assert_eq(dns_static_config_attempts(config), 5)
}

test "hosts parsing canonicalizes aliases and preserves file order" {
  let host = dns_static_test_domain("BÜCHER.example.")
  let addresses = dns_static_hosts_lookup(
    "127.0.0.1 localhost\n192.0.2.8 ignored xn--bcher-kva.example # alias\n2001:db8::8 xn--bcher-kva.example\n",
    host
  )
  Test.assert_eq(vector_len<IpAddress>(addresses), 2)
  match vector_get_in_bounds<IpAddress>(addresses, 0) {
    IpV4(address) -> Test.assert_eq(if address.eq(ipv4_address(192, 0, 2, 8)) { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match vector_get_in_bounds<IpAddress>(addresses, 1) {
    IpV6(address) -> Test.assert_eq(if address.eq(ipv6_address(8193, 3512, 0, 0, 0, 0, 0, 8)) { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "answer sections skip unrelated records and preserve address order" {
  let values = dns_static_test_answer_header(21, "multi.test", 1, 4)
  -- A compressed CNAME target must be skipped as opaque RDATA, never decoded.
  dns_static_test_push_record(values, 5, 1, dns_static_test_bytes(dns_static_test_i64s(192, 12)))
  dns_static_test_push_record(values, 1, 1, dns_static_test_ipv4_rdata(192, 0, 2, 1))
  -- A wanted type in a foreign class is not an answer.
  dns_static_test_push_record(values, 1, 3, dns_static_test_ipv4_rdata(10, 0, 0, 1))
  dns_static_test_push_record(values, 1, 1, dns_static_test_ipv4_rdata(192, 0, 2, 2))
  match dns_wire_parse_reply(values, 21, "multi.test", DnsWireA) {
    DnsWireAnswers(addresses) -> {
      Test.assert_eq(vector_len<IpAddress>(addresses), 2)
      Test.assert_eq(dns_static_test_ipv4_answer(addresses, 0, 192, 0, 2, 1), 1)
      Test.assert_eq(dns_static_test_ipv4_answer(addresses, 1, 192, 0, 2, 2), 1)
    }
    _ -> Test.assert_eq(0, 1)
  }

  -- An answer section carrying only unrelated records is NODATA, not an error.
  let unrelated = dns_static_test_answer_header(22, "multi.test", 1, 1)
  dns_static_test_push_record(unrelated, 28, 1, dns_static_test_bytes(dns_static_test_i64s(0, 0)))
  match dns_wire_parse_reply(unrelated, 22, "multi.test", DnsWireA) {
    DnsWireNoData -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "replies are bound to the exact question the resolver asked" {
  -- Same-length name substitution must not be accepted.
  let swapped = dns_static_test_answer_header(23, "other.test", 1, 1)
  dns_static_test_push_record(swapped, 1, 1, dns_static_test_ipv4_rdata(203, 0, 113, 1))
  match dns_wire_parse_reply(swapped, 23, "asked.test", DnsWireA) {
    DnsWireMalformed(offset) -> Test.assert_eq(offset, 12)
    _ -> Test.assert_eq(0, 1)
  }

  -- A shorter question section cannot satisfy a longer request either.
  let shorter = dns_static_test_answer_header(24, "a.test", 1, 1)
  dns_static_test_push_record(shorter, 1, 1, dns_static_test_ipv4_rdata(203, 0, 113, 2))
  match dns_wire_parse_reply(shorter, 24, "longer.test", DnsWireA) {
    DnsWireMalformed(offset) -> Test.assert_eq(offset, 12)
    _ -> Test.assert_eq(0, 1)
  }

  -- A reply for the other record type is not this request's answer.
  let other_type = dns_static_test_answer_header(25, "asked.test", 28, 1)
  dns_static_test_push_record(other_type, 28, 1, dns_static_test_bytes(dns_static_test_i64s(0, 0)))
  match dns_wire_parse_reply(other_type, 25, "asked.test", DnsWireA) {
    DnsWireMalformed(offset) -> Test.assert_eq(offset, 12)
    _ -> Test.assert_eq(0, 1)
  }
}

test "malformed headers and record framing fail closed with exact offsets" {
  Test.assert_eq(dns_static_test_reply_kind(vector_with_capacity<u8>(0), 26), 100)

  -- An echoed query has no response bit.
  Test.assert_eq(dns_static_test_reply_kind(dns_wire_query(27, "status.test", DnsWireA), 27), 102)

  -- A non-zero opcode is not an ordinary standard query response.
  let inverse = dns_wire_query(28, "status.test", DnsWireA)
  vector_set<u8>(inverse, 2, dns_static_test_u8(136))
  vector_set<u8>(inverse, 3, dns_static_test_u8(128))
  Test.assert_eq(dns_static_test_reply_kind(inverse, 28), 102)

  -- More than one question is outside the resolver's contract.
  let two = dns_static_test_answer_header(29, "status.test", 1, 1)
  vector_set<u8>(two, 5, dns_static_test_u8(2))
  Test.assert_eq(dns_static_test_reply_kind(two, 29), 104)

  -- A reserved label length is neither a label nor a compression pointer.
  let reserved = dns_static_test_answer_header(30, "status.test", 1, 1)
  let reserved_start = vector_len<u8>(reserved)
  dns_static_test_push_record(reserved, 1, 1, dns_static_test_ipv4_rdata(203, 0, 113, 3))
  vector_set<u8>(reserved, reserved_start, dns_static_test_u8(65))
  Test.assert_eq(dns_static_test_reply_kind(reserved, 30), 100 + reserved_start)

  -- Declared RDATA that runs past the packet is rejected at its length field.
  let overflow = dns_static_test_answer_header(31, "status.test", 1, 1)
  let overflow_start = vector_len<u8>(overflow)
  dns_static_test_push_record_sized(
    overflow, 1, 1, dns_static_test_bytes(dns_static_test_i64s(203, 0)), 4
  )
  Test.assert_eq(dns_static_test_reply_kind(overflow, 31), 100 + overflow_start + 10)
}

test "resolver policy defaults survive empty, commented and partial options" {
  let empty = dns_static_parse_resolv("")
  Test.assert_eq(vector_len<IpAddress>(dns_static_config_servers(empty)), 0)
  Test.assert_eq(dns_static_config_timeout_ms(empty), 5000)
  Test.assert_eq(dns_static_config_attempts(empty), 2)

  let commented = dns_static_parse_resolv("# nameserver 192.0.2.1\n\n \t \nsearch example.test\nnameserver\n")
  Test.assert_eq(vector_len<IpAddress>(dns_static_config_servers(commented)), 0)

  -- Absent, zero and unrelated option values keep the previous policy.
  let partial = dns_static_parse_resolv("nameserver 192.0.2.53\r\noptions timeout: attempts:0 ndots:3\r\n")
  Test.assert_eq(vector_len<IpAddress>(dns_static_config_servers(partial)), 1)
  Test.assert_eq(dns_static_config_timeout_ms(partial), 5000)
  Test.assert_eq(dns_static_config_attempts(partial), 2)

  let chosen = dns_static_parse_resolv("options attempts:3 timeout:2\nnameserver 198.51.100.53 # inline\n")
  Test.assert_eq(dns_static_config_timeout_ms(chosen), 2000)
  Test.assert_eq(dns_static_config_attempts(chosen), 3)
  Test.assert_eq(vector_len<IpAddress>(dns_static_config_servers(chosen)), 1)
}

test "hosts lookup matches canonical identity and ignores unusable lines" {
  let host = dns_static_test_domain("absent.example.")
  Test.assert_eq(
    vector_len<IpAddress>(dns_static_hosts_lookup(
      "127.0.0.1 localhost\n# absent.example\nnot-an-ip absent.example\n192.0.2.1\n",
      host
    )),
    0
  )
  Test.assert_eq(vector_len<IpAddress>(dns_static_hosts_lookup("", host)), 0)

  -- Host files are ASCII-case-insensitive through the same canonical identity.
  let mixed = dns_static_hosts_lookup("192.0.2.4\tABSENT.Example\tabsent-alias\n", host)
  Test.assert_eq(vector_len<IpAddress>(mixed), 1)
  Test.assert_eq(dns_static_test_ipv4_answer(mixed, 0, 192, 0, 2, 4), 1)
}
