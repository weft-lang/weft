-- Expected exit code: 102
-- Retaining a freed block would resurrect storage the free list already owns.

use runtime/rc.{rc_default_alloc, rc_default_release, rc_default_retain}

fn main() -> i64 {
  let block: i64 = rc_default_alloc(8, 8)
  rc_default_release(block)
  rc_default_retain(block)
  0
}
