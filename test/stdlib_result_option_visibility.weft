use stdlib/option.{*}
use stdlib/result.{*}

test "canonical Result import exposes its public methods" {
  let ok = result_ok<i64, str>(7)
  let err = result_err<i64, str>("no")
  Test.assert_eq(ok.is_ok(), 1)
  Test.assert_eq(ok.is_err(), 0)
  Test.assert_eq(ok.unwrap(), 7)
  Test.assert_eq(ok.expect("unused"), 7)
  Test.assert_eq(err.unwrap_or(9), 9)
}

test "canonical Option import exposes its public methods" {
  let some = Some<i64>(7)
  let none = None<i64>()
  Test.assert_eq(some.is_some(), 1)
  Test.assert_eq(some.is_none(), 0)
  Test.assert_eq(some.unwrap(), 7)
  Test.assert_eq(some.expect("unused"), 7)
  Test.assert_eq(none.unwrap_or(9), 9)
}
