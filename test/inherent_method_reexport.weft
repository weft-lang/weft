use stdlib/test.{Test}
use test/module_fixtures/inherent_reexport_facade as facade
use test/module_fixtures/inherent_extension_facade as extension

test "facade imports expose re-exported type methods" {
  Test.assert_eq(facade.make(42).get(), 42)
}

test "facades may own methods for re-exported types" {
  Test.assert_eq(extension.first(17).value(), 17)
  Test.assert_eq(extension.second(29).value(), 29)
}
