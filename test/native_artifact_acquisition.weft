-- Native artifact acquisition is an effectful package boundary; pure native
-- lowering consumes only the resulting typed state.

use compiler/lib.{nlist_get}
use compiler/package.{*}
use compiler/type_registry.{ttable_native_binding_source_binding, ttable_native_binding_source_target, ttable_new, ttable_set_sdk_package_id}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_load64_at, mem_store64_at}
use runtime/source_acquire.{SdkSourcePresent, SdkSourceMissing, NoSdk, SourceAcquire}
use runtime/string.{runtime_str_from_bytes_copy}

type NativeAcquisitionFixture {
  NativeAcquisitionFixture(i64, i64)
}

fn native_acquisition_file(content: str) -> i64 {
  let file = alloc_words(2)
  mem_store64_at(file, 0, __str_ptr(content))
  mem_store64_at(file, 8, __str_len(content))
  file
}

fn native_acquisition_manifest(package_name: str, search: str) -> i64 {
  let target = pkg_native_target_name(pkg_native_compilation_target())
  let prefix = "{\"package\":\"".concat(package_name).concat("\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"")
  let library = "\":{\"libraries\":[{\"id\":\"fixture\",\"kind\":\"archive\",\"link\":\"fixture\",\"search\":[\"".concat(search).concat("\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"license\":\"MIT\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_value\",\"symbol\":\"native_value\",\"library\":\"fixture\",\"params\":[],\"result\":\"i64\",\"optional\":false}]}}}}}")
  pkg_manifest_parse_str(prefix.concat(target).concat(library))
}

fn native_acquisition_root_fixture(search: str) -> NativeAcquisitionFixture {
  let tt = ttable_new()
  let manifest = native_acquisition_manifest("app", search)
  pkg_identity_register_root(tt, manifest)
  let source = "fn wrapper() -> i64 { 0 }"
  let binding_source = pkg_native_binding_source_register(
    tt,
    __str_ptr(source),
    0,
    __str_ptr("native/raw"),
    __str_len("native/raw")
  )
  let library = if binding_source <= 0 { 0 } else { nlist_get(pkg_native_target_libraries(pkg_native_binding_find_target(
      ttable_native_binding_source_binding(binding_source),
      pkg_native_compilation_target()
    )), 0) }
  NativeAcquisitionFixture(tt, library)
}

test "native archive acquisition records stable package path and bytes" {
  match native_acquisition_root_fixture("native/fixture") {
    NativeAcquisitionFixture(tt, library) -> {
      Test.assert_eq(if library > 0 { 1 } else { 0 }, 1)
      if library == 0 { 0 } else {
        let acquired = handle pkg_native_libraries_acquire(tt) {
          SourceAcquire.sdk_origin() -> resume(NoSdk)
          SourceAcquire.load_sdk(path, path_len) -> resume(SdkSourceMissing)
          SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> {
            Test.assert_str_eq(runtime_str_from_bytes_copy(physical, physical_len), "native/fixture/libfixture.a")
            resume(native_acquisition_file("archive-bytes"))
          }
        }
        Test.assert_eq(acquired, 1)
        match pkg_native_library_acquisition(library) {
          NativeLibraryAcquired(path, bytes, len) -> {
            Test.assert_str_eq(path, "native/fixture/libfixture.a")
            Test.assert_eq(len, __str_len("archive-bytes"))
            Test.assert_str_eq(runtime_str_from_bytes_copy(bytes, len), "archive-bytes")
          }
          _ -> Test.assert_eq(0, 1)
        }
      }
    }
  }
}

test "missing native archive is remembered and not reacquired" {
  match native_acquisition_root_fixture("native/missing") {
    NativeAcquisitionFixture(tt, library) -> {
      Test.assert_eq(if library > 0 { 1 } else { 0 }, 1)
      if library == 0 { 0 } else {
        let calls = alloc_words(1)
        mem_store64_at(calls, 0, 0)
        let first = handle pkg_native_libraries_acquire(tt) {
          SourceAcquire.sdk_origin() -> resume(NoSdk)
          SourceAcquire.load_sdk(path, path_len) -> resume(SdkSourceMissing)
          SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> {
            mem_store64_at(calls, 0, mem_load64_at(calls, 0) + 1)
            resume(native_acquisition_file(""))
          }
        }
        let second = handle pkg_native_libraries_acquire(tt) {
          SourceAcquire.sdk_origin() -> resume(NoSdk)
          SourceAcquire.load_sdk(path, path_len) -> resume(SdkSourceMissing)
          SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> {
            mem_store64_at(calls, 0, mem_load64_at(calls, 0) + 1)
            resume(native_acquisition_file(""))
          }
        }
        Test.assert_eq(first + second, 2)
        Test.assert_eq(mem_load64_at(calls, 0), 1)
        match pkg_native_library_acquisition(library) {
          NativeLibraryMissing(path) -> Test.assert_str_eq(path, "native/missing/libfixture.a")
          _ -> Test.assert_eq(0, 1)
        }
      }
    }
  }
}

test "SDK native archives use dedicated SDK acquisition authority" {
  let tt = ttable_new()
  let root = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  pkg_identity_register_root(tt, root)
  let sdk_manifest = native_acquisition_manifest("weft", "native/sdk")
  let sdk_id = pkg_identity_intern_under_owner(
    tt,
    __str_ptr("weft"),
    __str_len("weft"),
    0,
    0,
    sdk_manifest,
    0
  )
  ttable_set_sdk_package_id(tt, sdk_id)
  let source = "fn wrapper() -> i64 { 0 }"
  let binding_source = pkg_native_binding_source_register(
    tt,
    __str_ptr(source),
    sdk_id,
    __str_ptr("native/raw"),
    __str_len("native/raw")
  )
  let library = if binding_source <= 0 { 0 }
  else { nlist_get(pkg_native_target_libraries(ttable_native_binding_source_target(binding_source)), 0) }
  Test.assert_eq(if library > 0 { 1 } else { 0 }, 1)
  if library == 0 { 0 } else {
    let sdk_calls = alloc_words(1)
    let package_calls = alloc_words(1)
    mem_store64_at(sdk_calls, 0, 0)
    mem_store64_at(package_calls, 0, 0)
    let acquired = handle pkg_native_libraries_acquire(tt) {
      SourceAcquire.sdk_origin() -> resume(NoSdk)
      SourceAcquire.load_sdk(path, path_len) -> {
        mem_store64_at(sdk_calls, 0, mem_load64_at(sdk_calls, 0) + 1)
        resume(SdkSourcePresent(__str_ptr("sdk-archive"), __str_len("sdk-archive")))
      }
      SourceAcquire.load(physical, physical_len, logical, logical_len, package_id) -> {
        mem_store64_at(package_calls, 0, mem_load64_at(package_calls, 0) + 1)
        resume(native_acquisition_file(""))
      }
    }
    Test.assert_eq(acquired, 1)
    Test.assert_eq(mem_load64_at(sdk_calls, 0), 1)
    Test.assert_eq(mem_load64_at(package_calls, 0), 0)
    match pkg_native_library_acquisition(library) {
      NativeLibraryAcquired(path, bytes, len) -> Test.assert_str_eq(path, "native/sdk/libfixture.a")
      _ -> Test.assert_eq(0, 1)
    }
  }
}
