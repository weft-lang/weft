-- Expected exit code: 101
-- A borrowed field read past the initialized elements panics before loading
-- the element slot, instead of dereferencing memory beyond the vector.

use stdlib/sorted_map as sorted_map
use stdlib/sorted_map.{SortedEntry, sorted_map_vector}
use stdlib/vector.{vector_get_field_in_bounds}

fn main() -> i64 {
  let m = sorted_map.new<i64, i64>()
  m.insert(7, 70)
  let entries = sorted_map_vector<i64, i64>(m)
  vector_get_field_in_bounds<SortedEntry<i64, i64>, i64>(entries, 1, 0)
}
