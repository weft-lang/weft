use test/module_fixtures/alias_effect_left as left
use test/module_fixtures/alias_effect_right as right
use test/module_fixtures/alias_effect_left.{Read as LeftRead, Read as reader}

fn both_readers() -[left.Read, right.Read]> i64 {
  left.read() * 10 + right.read()
}

fn renamed_reader() -[LeftRead]> i64 { LeftRead.read() }

fn forward_reader<E>(callback: () -[E]> i64) -[E]> i64 { callback() }

test "alias callbacks retain their defining effect declaration" {
  let value = handle left.call(left.read) { left.Read.read() -> resume(42) }
  Test.assert_eq(value, 42)
}

test "nested handlers select distinct same-spelled effect declarations" {
  let value = handle {
    handle both_readers() { right.Read.read() -> resume(2) }
  } { left.Read.read() -> resume(1) }
  Test.assert_eq(value, 12)
}

test "renamed effect imports and generic callbacks retain declaration identity" {
  let value = handle forward_reader(renamed_reader) { left.Read.read() -> resume(42) }
  Test.assert_eq(value, 42)
}

fn generic_readers() -[left.Read, right.Read]> i64 {
  forward_reader(left.read) * 10 + forward_reader(right.read)
}

type LocalReader { value: i64 }
impl LocalReader { fn read(self) -> i64 { self.value } }

test "effect specialization distinguishes callbacks with different declarations" {
  let value = handle {
    handle generic_readers() { right.Read.read() -> resume(2) }
  } { left.Read.read() -> resume(1) }
  Test.assert_eq(value, 12)
}

test "lexical values shadow imported effect names" {
  let reader = LocalReader { value: 42 }
  Test.assert_eq(reader.read(), 42)
}

use module_fixtures/g2_effect_bank as bank

type Number = i64
type NumberReader = () -[bank.Box<Number>]> Number
fn read_number_box() -[bank.Box<Number>]> Number { bank.Box<Number>.get() }
fn use_number_reader(callback: NumberReader) -[bank.Box<Number>]> Number { callback() }

test "qualified parameterized effects expand alias arguments" {
  let value = handle use_number_reader(read_number_box) {
    bank.Box<i64>.get() -> resume(42)
  }
  Test.assert_eq(value, 42)
}

effect Fetch<T> { fn fetch() -> T }
type FetchCallback<T> = () -[Fetch<T>]> T
fn read_fetch_number() -[Fetch<i64>]> i64 { Fetch.fetch() }
fn read_fetch_text() -[Fetch<str>]> str { Fetch.fetch() }
fn run_fetch<T>(value: T, callback: FetchCallback<T>) -> T {
  handle callback() { Fetch<T>.fetch() -> resume(value) }
}

test "generic callback aliases retain parameterized operation payloads" {
  Test.assert_eq(run_fetch(42, read_fetch_number), 42)
  Test.assert_str_eq(run_fetch("text", read_fetch_text), "text")
}
