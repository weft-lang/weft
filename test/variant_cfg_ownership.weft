use module_fixtures/compiler_probe.{require_checked}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/weft/check/table.{str_hash}
use compiler/source/input.{source_from_text}
use compiler/weft/check/table.{ttable_new}
use stdlib/diagnostic.{Diagnose}
use compiler/weft/check as checking

fn check_local(source: str) -[Test]> TypedModule {
  let syntax = handle pipeline_parse_local(source_from_text(source), ttable_new()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, position) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
  handle require_checked(checking.program(syntax)) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, position) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn retains(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrManagedStakeI64(_, _, _, 1, origin) -> if origin == ir_managed_stake_origin_aggregate() {
          1
        } else { 0 }
        _ -> 0
      }
      here + retains(rest)
    }
  }
}

fn block_retains(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> retains(insts) + block_retains(rest)
  }
}

fn function_retains(functions: IrFunctionList, name: str) -> i64 {
  match functions {
    IrFunctionNil -> - 1
    IrFunctionCons(IrFunction(hash, _, blocks, _), rest) -> {
      if hash == str_hash(__str_ptr(name), 0, __str_len(name)) { block_retains(blocks) }
      else { function_retains(rest, name) }
    }
  }
}

test "conditional constructor arguments retain borrowed aggregate payloads" {
  let source = "type Chain { End, Link(i64, Chain) } fn wrap(tail: Chain, flag: bool) -> Chain { Link(if flag { 1 } else { 2 }, tail) } fn main() -> i64 { 0 }"
  let typed = check_local(source)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(function_retains(pipeline_ir_functions(lowered), "wrap"), 1)
}

test "conditional constructor assignment retains the previous mutable tail" {
  let source = "type Chain { End, Link(i64, Chain) } fn wrap(flag: bool) -> Chain { let mut tail: Chain = Link(7, End) for i in 0..2 { tail = Link(if flag { 1 } else { 2 }, tail) } tail } fn main() -> i64 { 0 }"
  let typed = check_local(source)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(function_retains(pipeline_ir_functions(lowered), "wrap"), 1)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  Test.assert_eq(function_retains(pipeline_ir_functions(optimised), "wrap"), 1)
}

test "generic conditional constructor arguments retain borrowed aggregate payloads" {
  let source = "type Chain<T> { End, Link(T, Chain<T>) } fn wrap(tail: Chain<i64>, flag: bool) -> Chain<i64> { Link(if flag { 1 } else { 2 }, tail) } fn main() -> i64 { 0 }"
  let typed = check_local(source)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(function_retains(pipeline_ir_functions(lowered), "wrap"), 1)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  Test.assert_eq(function_retains(pipeline_ir_functions(optimised), "wrap"), 1)
}

test "nested conditional constructor arguments retain borrowed aggregate payloads" {
  let source = "type Chain<T> { End, Link(T, Chain<T>) } type Member { Binding(i64, i64?) } fn wrap(tail: Chain<Member>, flag: bool) -> Chain<Member> { Link(Binding(3, if flag { 5 } else { nil }), tail) } fn main() -> i64 { 0 }"
  let typed = check_local(source)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(function_retains(pipeline_ir_functions(lowered), "wrap"), 1)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  Test.assert_eq(function_retains(pipeline_ir_functions(optimised), "wrap"), 1)
}

test "nested conditional constructor assignment retains loop-carried tails" {
  let source = "type Chain<T> { End, Link(T, Chain<T>) } type Member { Binding(i64, i64?) } fn wrap() -> Chain<Member> { let mut tail: Chain<Member> = End let mut index = 0 while index < 2 { if index == 0 { tail = Link(Binding(3, 5), tail) index = index + 1 } else { tail = Link(Binding(3, if index == 1 { 5 } else { nil }), tail) index = index + 1 } } tail } fn main() -> i64 { 0 }"
  let typed = check_local(source)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(function_retains(pipeline_ir_functions(lowered), "wrap"), 2)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  Test.assert_eq(function_retains(pipeline_ir_functions(optimised), "wrap"), 2)
}
