 b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f39(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } }")
  let ok = if d40 - d20 < 20 * 2048 { 1 } else { 0 }
