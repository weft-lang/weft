use compiler/pipeline.{*}
use runtime/unsafe.{*}
-- test/optimiser_scratch_metrics.weft -- per-function bump scratch
-- reclaim in the IR optimiser (2s item 9). The optimiser's fold
-- allocates CSE tables, entry-fact worklists, and liveness arrays on
-- the bump arena; mark/restore around each function must reclaim them,
-- so the MARGINAL bump cost of 20 extra functions is bounded by the
-- unreclaimed O(K) parts (pure-callee tree nodes), far under the
-- per-function scratch it would be without reclaim. The difference
-- d40 - d20 cancels fixed per-call overhead; 2 KB/fn sits between the
-- reclaimed (~100 B/fn) and unreclaimed (multiple KB/fn) regimes.
-- Uses the pre-promotion entry: mem2reg is outside the reclaim scope.

fn osr_ir_for(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  pipeline_lower_ir(typed)
}

fn osr_optimise_delta(src: str) -> i64 {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let before = alloc_bump_mark()
  pipeline_optimise_typed_ir_pre_promotion(typed, ir)
  alloc_bump_mark() - before
}

test "optimiser_scratch_marginal_bump_bounded" {
  let d20 = osr_optimise_delta("fn osr_f0(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f1(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f2(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f3(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f4(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f5(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f6(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f7(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f8(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f9(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f10(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f11(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f12(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f13(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f14(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f15(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f16(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f17(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f18(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f19(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } }")
  let d40 = osr_optimise_delta("fn osr_f0(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f1(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f2(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f3(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f4(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f5(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f6(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f7(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f8(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f9(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f10(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f11(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f12(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b