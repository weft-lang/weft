test "optimiser_scratch_delta_positive_sanity" {
  -- The meter itself must be live: optimising allocates SOMETHING
  -- unreclaimed at list level (pure-callee tree), so a zero delta
  -- means the probe is broken, not that reclaim is perfect.
  let d = osr_optimise_delta("fn osr_f0(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f1(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f2(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f3(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f4(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f5(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f6(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f7(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f8(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f9(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f10(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f11(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f12(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f13(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f14(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f15(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f16(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f17(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f18(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } } fn osr_f19(a: i64, b: i64) -> i64 { let c = a + b let d = if c > 10 { a * 2 + c } else { b * 3 - c } let e = d + a * b if e > c { e - a } else { e + b } }")
  let ok = if d > 0 { 1 } else { 0 }
  Test.assert_eq(ok, 1)
}
