-- Test: effect handler with register spilling
-- When main() uses enough locals to exhaust all 16 physical registers,
-- handler clause values must spill to stack correctly.
-- Expected exit code: 42

fn add1(x: Int) -> Int { x + 1 }
fn add2(x: Int) -> Int { x + 2 }
fn add3(x: Int) -> Int { x + 3 }

effect E {
  fn get(key: Int) -> Int
}

fn use_effect() -> Int {
  E.get(10)
}

fn main() -> Int {
  let a = add1(0)
  let b = add2(0)
  let c = add3(0)
  let d = match a {
    1 -> 1,
    _ -> 0
  }
  let e = match b {
    2 -> 2,
    _ -> 0
  }
  let f = a + b + c + d + e
  let g = handle use_effect() {
    E.get(key) -> resume(key)
  }
  f + g + 23
}
