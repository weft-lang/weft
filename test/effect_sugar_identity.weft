use stdlib/maybe as absence
use stdlib/fail as failure
use stdlib/result.{Result, Ok, Err}
use test/module_fixtures/sugar_effect_shadow as shadow
use test/module_fixtures/sugar_effect_shadow.{Box}

test "optional chaining selects the standard capability through local name shadowing" {
  let present = handle shadow.optional_value(Box { value: 7 }) { absence.Maybe.none() -> 42 }
  let absent = handle shadow.optional_value(nil) { absence.Maybe.none() -> 42 }
  let local = handle shadow.Maybe.none() { shadow.Maybe.none() -> resume(9) }
  Test.assert_eq(present, 7)
  Test.assert_eq(absent, 42)
  Test.assert_eq(local, 9)
}

test "result propagation selects the standard parameterized capability through local name shadowing" {
  let success = Ok<i64, str>(7)
  let error = Err<i64, str>("missing")
  let present = handle shadow.result_value(success) { failure.Fail<str>.fail(message) -> 42 }
  let absent = handle shadow.result_value(error) { failure.Fail<str>.fail(message) -> 42 }
  let local = handle shadow.Fail.fail(9) { shadow.Fail.fail(value) -> resume(value) }
  Test.assert_eq(present, 7)
  Test.assert_eq(absent, 42)
  Test.assert_eq(local, 9)
}
