use compiler/pipeline.{*}
use compiler/ir.{*}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/option.{Some, None}
use stdlib/test.{Test}
use compiler/types.{PRIM_U64}

type RangeTestCase {
  RangeRead, RangeWrite, RangeChangedStorage, RangeUnknownCall,
  RangeWrongVector, RangeWrongWidth, RangeMissingRowLower, RangeMissingColumnLower,
  RangeNonstrictRow, RangeNonstrictColumn, RangeAlternateEntry, RangeUnsignedRow,
  RangeCommuted, RangeZeroColumn, RangePointerWrite, RangeUnknownOperation, RangeUnsignedProduct, RangeExtraLengthArgument, RangePartialMode
}

fn range_test_blocks(test_case: RangeTestCase) -> IrBlockList {
  let row_lower = match test_case {
    RangeMissingRowLower -> IrBinaryI64(13, IrEq, 1, 1)
    RangeUnsignedRow -> IrFloatBinaryI64(13, PRIM_U64(), IrGe, 1, 11)
    _ -> IrBinaryI64(13, IrGe, 1, 11)
  }
  let column_lower = match test_case {
    RangeMissingColumnLower -> IrBinaryI64(14, IrEq, 3, 3)
    _ -> IrBinaryI64(14, IrGe, 3, 11)
  }
  let column_value = match test_case { RangeZeroColumn -> 11, _ -> 3 }
  let column_upper = match test_case { RangeNonstrictColumn -> IrLe, _ -> IrLt }
  let row_upper = match test_case { RangeNonstrictRow -> IrLe, _ -> IrLt }
  let other_edge = match test_case { RangeAlternateEntry -> 4, _ -> 9 }
  let vec = match test_case { RangeWrongVector -> 4, _ -> 0 }
  let width = match test_case { RangeWrongWidth -> 4, _ -> 2 }
  let access = match test_case {
    RangeWrite -> IrVectorSetI64(19, vec, 18, 11, 0)
    RangeZeroColumn -> IrVectorGetI64(19, vec, 17, 11, 0)
    RangePartialMode -> IrVectorGetI64(19, vec, 18, 11, 3)
    _ -> IrVectorGetI64(19, vec, 18, 11, 0)
  }
  let tail = IrInstCons(access, IrInstNil)
  let guarded = match test_case {
    RangeChangedStorage -> IrInstCons(IrVectorSetI64(20, 0, 11, 11, 0), tail)
    RangeUnknownCall -> IrInstCons(IrCallI64(20, 45678, IrValueNil), tail)
    RangePointerWrite -> IrInstCons(IrPtrStoreI64(20, 0, 11, IrStorageWord64), tail)
    RangeUnknownOperation -> IrInstCons(IrBinaryI64(20, IrBinaryUnknown, 1, 2), tail)
    _ -> tail
  }
  let product = match test_case {
    RangeCommuted -> IrBinaryI64(17, IrMul, width, 1)
    RangeUnsignedProduct -> IrFloatBinaryI64(17, PRIM_U64(), IrMul, 1, width)
    _ -> IrBinaryI64(17, IrMul, 1, width)
  }
  let index = match test_case { RangeCommuted -> IrBinaryI64(18, IrAdd, 3, 17), _ -> IrBinaryI64(18, IrAdd, 17, 3) }
  let length_args = match test_case { RangeExtraLengthArgument -> IrValueCons(0, IrValueCons(2, IrValueNil)), _ -> IrValueCons(0, IrValueNil) }
  IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(10, pipeline_ir_vector_len_hash(), length_args),
    IrInstCons(IrConstI64(11, 0), IrInstCons(IrBinaryI64(12, IrDiv, 10, 2),
    IrInstCons(row_lower, IrInstNil)))), IrTermBranch(13, 1, 9)),
  IrBlockListCons(IrBlock(1, IrValueNil, IrInstCons(column_lower, IrInstNil), IrTermBranch(14, 2, 9)),
  IrBlockListCons(IrBlock(2, IrValueNil, IrInstCons(IrBinaryI64(15, column_upper, column_value, 2), IrInstNil), IrTermBranch(15, 3, 9)),
  IrBlockListCons(IrBlock(3, IrValueNil, IrInstCons(IrBinaryI64(16, row_upper, 1, 12), IrInstNil), IrTermBranch(16, 4, other_edge)),
  IrBlockListCons(IrBlock(4, IrValueNil,
    IrInstCons(product, IrInstCons(index, guarded)), IrTermReturn(19)),
  IrBlockListCons(IrBlock(9, IrValueNil, IrInstNil, IrTermReturn(11)), IrBlockListNil))))))
}

test "dynamic row bounds require every strict signed and storage premise" {
  for test_case in [RangeRead, RangeWrite, RangeChangedStorage, RangeUnknownCall,
    RangeWrongVector, RangeWrongWidth, RangeMissingRowLower, RangeMissingColumnLower,
    RangeNonstrictRow, RangeNonstrictColumn, RangeAlternateEntry, RangeUnsignedRow,
    RangeCommuted, RangeZeroColumn, RangePointerWrite, RangeUnknownOperation, RangeUnsignedProduct, RangeExtraLengthArgument, RangePartialMode] {
    let blocks = range_test_blocks(test_case)
    Test.assert_eq(pipeline_ir_verify_function(IrFunction(23456, 5, blocks, 0)), 0)
    let expected = match test_case { RangeRead -> true, RangeWrite -> true, RangeCommuted -> true, RangeZeroColumn -> true, RangePartialMode -> true, _ -> false }
    match pipeline_ir_row_range_facts(blocks) {
      PipelineIrRowRangeFacts(original, proven) -> {
        Test.assert_true(proven.contains_key(19) == expected)
        let after = pipeline_ir_row_range_apply_blocks(original, proven)
        Test.assert_eq(pipeline_ir_verify_function(IrFunction(23456, 5, after, 0)), 0)
        match pipeline_ir_row_range_definitions(after, map.new<i64, IrInst>()).get(19) {
          Some(IrVectorGetI64(_, _, _, _, mode)) -> Test.assert_eq(mode, if expected { 7 } else { 0 })
          Some(IrVectorSetI64(_, _, _, _, mode)) -> Test.assert_eq(mode, if expected { 7 } else { 0 })
          _ -> Test.assert_true(false)
        }
      }
    }
  }
}

test "access observations use the canonical storage version transitions" {
  for test_case in [RangeRead, RangeWrite, RangeChangedStorage, RangeUnknownCall] {
    let blocks = range_test_blocks(test_case)
    let next = pipeline_ir_native_resident_max_block_id(blocks) + 2
    match pipeline_ir_storage_version_build(blocks, 0, next, map.new<i64, i64>(), Nil<PipelineIrStorageReadVersion>()) {
      PipelineIrStorageVersionBuild(expected, expected_reads) -> match pipeline_ir_storage_timeline_build(blocks, 0, next, map.new<i64, i64>(), Nil<PipelineIrStorageReadVersion>(),
        Nil<PipelineIrStorageAccessVersion>(), PipelineIrStorageReadsAndVectorAccesses) {
        PipelineIrStorageTimeline(actual, actual_reads, accesses) -> {
          Test.assert_eq_usize(expected.len(), actual.len())
          Test.assert_eq_usize(expected_reads.len(), actual_reads.len())
          Test.assert_eq_usize(accesses.len(), match test_case { RangeChangedStorage -> 2, _ -> 1 })
          for id in [0, 1, 2, 3, 4, 9] {
            Test.assert_true(match expected.get(id) {
              Some(state) -> match actual.get(id) { Some(other) -> state == other, None -> false }
              None -> false
            })
          }
        }
      }
    }
  }
}

test "quotient premises imply a representable strict flattened bound" {
  for length in 0..20 {
    for width in 1..8 {
      for row in 0..20 {
        for column in 0..8 {
          if row < length / width and column < width {
            let index = row * width + column
            Test.assert_true(index >= 0 and index < length)
          } else { nil }
        }
      }
    }
  }
  let maximum = 9223372036854775807
  for width in [1, 2, 3, 7, 2147483647, maximum] {
    let row = maximum / width - 1
    let column = width - 1
    let index = row * width + column
    Test.assert_true(index >= 0 and index < maximum)
  }
}

fn range_test_after_guard(clobber: bool, looped: bool) -> IrBlockList {
  let mut result = IrBlockListNil
  let mut current = range_test_blocks(RangeRead)
  let mut walking = true
  while walking {
    match current {
      IrBlockListNil -> { walking = false }
      IrBlockListCons(block, rest) -> {
        let next = match block {
          IrBlock(4, params, _, _) -> IrBlock(4, params,
            IrInstCons(IrBinaryI64(17, IrMul, 1, 2), IrInstCons(IrBinaryI64(18, IrAdd, 17, 3), IrInstNil)),
            if looped { IrTermJump(5, IrValueNil) } else { IrTermBranch(4, 5, 6) })
          _ -> block
        }
        result = ir_block_list_append(result, IrBlockListCons(next, IrBlockListNil))
        current = rest
      }
    }
  }
  let mutation = if clobber { IrInstCons(IrCallI64(20, 34567, IrValueNil), IrInstNil) } else { IrInstNil }
  let tail = if looped {
    IrBlockListCons(IrBlock(5, IrValueNil, IrInstNil, IrTermBranch(4, 6, 7)),
      IrBlockListCons(IrBlock(6, IrValueNil, mutation, IrTermJump(5, IrValueNil)), IrBlockListNil))
  } else {
    IrBlockListCons(IrBlock(5, IrValueNil, mutation, IrTermJump(7, IrValueNil)),
      IrBlockListCons(IrBlock(6, IrValueNil, IrInstNil, IrTermJump(7, IrValueNil)), IrBlockListNil))
  }
  ir_block_list_append(result, ir_block_list_append(tail,
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrVectorGetI64(19, 0, 18, 11, 0), IrInstNil),
      IrTermReturn(19)), IrBlockListNil)))
}

test "row bounds survive joins and loops only while storage remains unchanged" {
  for looped in [false, true] {
    for clobber in [false, true] {
      let blocks = range_test_after_guard(clobber, looped)
      Test.assert_eq(pipeline_ir_verify_function(IrFunction(23456, 5, blocks, 0)), 0)
      match pipeline_ir_row_range_facts(blocks) {
        PipelineIrRowRangeFacts(_, proven) -> Test.assert_true(proven.contains_key(19) == not clobber)
      }
    }
  }
}

test "range facts preserve their original instructions and become idempotent after application" {
  let facts = pipeline_ir_row_range_facts(range_test_blocks(RangeRead))
  match facts {
    PipelineIrRowRangeFacts(original, proven) -> {
      Test.assert_true(proven.contains_key(19))
      Test.assert_true(match pipeline_ir_row_range_definitions(original, map.new<i64, IrInst>()).get(19) {
        Some(IrVectorGetI64(_, _, _, _, 0)) -> true
        _ -> false
      })
      let after = pipeline_ir_row_range_apply(facts)
      Test.assert_eq(ir_block_list_inst_count(after), ir_block_list_inst_count(original))
      Test.assert_eq(ir_block_list_len(after), ir_block_list_len(original))
      match pipeline_ir_row_range_facts(after) {
        PipelineIrRowRangeFacts(_, repeated) -> Test.assert_eq_usize(repeated.len(), 0)
      }
    }
  }
}

test "a write observes its input storage version before invalidating later accesses" {
  let insts = IrInstCons(IrVectorSetI64(10, 0, 1, 2, 0),
    IrInstCons(IrVectorGetI64(11, 0, 1, 2, 0), IrInstNil))
  match pipeline_ir_storage_timeline_block(insts, 4, 0, 5, 100,
    Nil<PipelineIrStorageReadVersion>(), Nil<PipelineIrStorageAccessVersion>(), PipelineIrStorageReadsAndVectorAccesses) {
    PipelineIrStorageTimelineBlock(output, next, reads, accesses) -> {
      Test.assert_eq(output, 100)
      Test.assert_eq(next, 101)
      Test.assert_eq_usize(reads.len(), 0)
      Test.assert_true(match accesses {
        Cons(PipelineIrStorageAccessVersion(11, 0, 1, 4, 100),
          Cons(PipelineIrStorageAccessVersion(10, 0, 1, 4, 5), Nil)) -> true
        _ -> false
      })
    }
  }
}

test "range analysis keeps bounded fallback for sparse oversized and nested graphs" {
  let original = range_test_blocks(RangeRead)
  for id in [511, 512] {
    let blocks = ir_block_list_append(original,
      IrBlockListCons(IrBlock(id, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil))
    match pipeline_ir_row_range_facts(blocks) {
      PipelineIrRowRangeFacts(_, proven) -> Test.assert_true(proven.contains_key(19) == (id == 511))
    }
  }
  let nested = ir_block_list_append(original, IrBlockListCons(IrBlock(10, IrValueNil,
    IrInstCons(IrHandleI64(30, 0, 10, IrHandlerClauseBodyNil, 0, 7), IrInstNil), IrTermReturn(30)), IrBlockListNil))
  match pipeline_ir_row_range_facts(nested) {
    PipelineIrRowRangeFacts(_, proven) -> Test.assert_eq_usize(proven.len(), 0)
  }
  let mut insts = IrInstNil
  for index in 0..4097 { insts = IrInstCons(IrConstI64(index + 100, 0), insts) }
  let oversized = ir_block_list_append(original,
    IrBlockListCons(IrBlock(10, IrValueNil, insts, IrTermReturn(0)), IrBlockListNil))
  match pipeline_ir_row_range_facts(oversized) {
    PipelineIrRowRangeFacts(_, proven) -> Test.assert_eq_usize(proven.len(), 0)
  }
}

test "discarded vector results cannot become range rewrite keys" {
  let mut blocks = IrBlockListNil
  let mut current = range_test_blocks(RangeRead)
  let mut walking = true
  while walking {
    match current {
      IrBlockListNil -> { walking = false }
      IrBlockListCons(block, rest) -> {
        let next = match block {
          IrBlock(4, params, _, _) -> IrBlock(4, params,
            IrInstCons(IrBinaryI64(17, IrMul, 1, 2), IrInstCons(IrBinaryI64(18, IrAdd, 17, 3),
              IrInstCons(IrVectorGetI64(0 - 1, 0, 18, 11, 0), IrInstNil))), IrTermReturn(11))
          _ -> block
        }
        blocks = ir_block_list_append(blocks, IrBlockListCons(next, IrBlockListNil))
        current = rest
      }
    }
  }
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(23456, 5, blocks, 0)), 0)
  let facts = pipeline_ir_row_range_facts(blocks)
  match facts { PipelineIrRowRangeFacts(_, proven) -> Test.assert_eq_usize(proven.len(), 0) }
  Test.assert_eq(ir_block_list_inst_count(pipeline_ir_row_range_apply(facts)), ir_block_list_inst_count(blocks))
}
