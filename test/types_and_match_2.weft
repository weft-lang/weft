-- test/types_and_match.weft -- records, variants, match patterns, feature interactions

-- ═══════════════════════════════════════════════════════════════
-- Type definitions (shared across tests)
-- ═══════════════════════════════════════════════════════════════

-- Records
type Wrap { val: i64 }
type Point { x: i64, y: i64 }
type R3 { a: i64, b: i64, c: i64 }
type Q4 { a: i64, b: i64, c: i64, d: i64 }
type Pair { a: i64, b: i64 }
type Rect { w: i64, h: i64 }
type ABox { x: i64 }
type BBox { y: i64 }
type MultiA { x: i64 }
type MultiB { y: i64, z: i64 }
type VRec { x: i64, y: i64 }

-- Variants
type V1 { V(i64) }
type VLong { LongName(i64) }
type T2 { A(i64), B(i64) }
type T3 { X(i64), Y(i64), Z(i64) }
type Shape { Circle(i64) }
type Opt2 { None, Some(i64) }
type VM1 { VA(i64) }
type EvenOdd { Even(i64), Odd(i64) }

fn sum_pair(p: i64) -> i64 { p.a + p.b }
fn area(r: i64) -> i64 { r.w * r.h }
fn mk_point(a: i64, b: i64) -> i64 { Point { x: a, y: b } }
fn getx(p: i64) -> i64 { p.x }
fn gety(p: i64) -> i64 { p.y }
fn extract_v(t: i64) -> i64 { match t { V(n) -> n } }
fn classify_match(n: i64) -> i64 { match n { 0 -> 0 1 -> 42 _ -> 99 } }
fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn fact_match(n: i64) -> i64 { match n { 0 -> 1 1 -> 1 _ -> n * fact_match(n - 1) } }
fn gcd(a: i64, b: i64) -> i64 { match b { 0 -> a _ -> gcd(b, a - a / b * b) } }
fn f_scr(x: i64) -> i64 { x * 2 }
fn sq(n: i64) -> i64 { n * n }
fn classify_eo(n: i64) -> i64 { if n - n / 2 * 2 == 0 { Even(n) } else { Odd(n) } }
fn process(n: i64) -> i64 {
fn test_wa(n: i64) -> i64 { match n { 0 -> 100 _ -> n + 1 } }
test "deep_nesting" {
  Test.assert_eq(match 1 {
    1 -> {
      let mut s = 0
      let mut i = 0
      while i < 7 {
        if i > 2 { s = s + i * 2 } else { s = s + i }
        i = i + 1
      }
      s
    }
    _ -> 0
  }, 39)
}
test "let_while_fn" {
  let mut s = 0
  let mut i = 1
  while i <= 5 { s = s + sq(i) i = i + 1 }
  Test.assert_eq(s, 55)
}
test "while_variant_dispatch" {
  let mut s = 0
  let mut i = 0
  while i < 5 {
    let v = classify_eo(i)
    let x = match v { Even(n) -> n Odd(n) -> n }
    s = s + x
    i = i + 1
  }
  Test.assert_eq(s, 10)
}
test "variant_record_body" {
  let v = A(42)
  let r = VRec { x: match v { A(n) -> n B(n) -> 0 }, y: 0 }
  Test.assert_eq(r.x, 42)
}
test "cmp_while_match" {
  let mut x = 0
  let mut i = 0
  while i < 42 { x = match i { 0 -> 1 _ -> x + 1 } i = i + 1 }
  Test.assert_eq(x, 42)
}
