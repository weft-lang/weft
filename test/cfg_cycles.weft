use compiler/ir/cfg.{*}
use compiler/ir/data.{*}
use stdlib/test.{Test}

fn cfg_test_block(id: i64, term: IrTerminator, rest: IrBlockList) -> IrBlockList {
  IrBlockListCons(IrBlock(id, IrValueNil, IrInstNil, term), rest)
}

test "cycle facts distinguish a loop from its entry and exits" {
  let blocks = cfg_test_block(0, IrTermJump(10, IrValueNil),
    cfg_test_block(10, IrTermBranch(0, 20, 30),
    cfg_test_block(20, IrTermJump(10, IrValueNil),
    cfg_test_block(30, IrTermReturn(0), IrBlockListNil))))
  let facts = ir_cfg_cycles(blocks)
  Test.assert_true(not ir_cfg_block_is_cyclic(facts, 0))
  Test.assert_true(ir_cfg_block_is_cyclic(facts, 10))
  Test.assert_true(ir_cfg_block_is_cyclic(facts, 20))
  Test.assert_true(not ir_cfg_block_is_cyclic(facts, 30))
  Test.assert_true(not ir_cfg_block_is_cyclic(facts, 100))
}

test "cycle facts include self loops and disconnected components" {
  let blocks = cfg_test_block(0, IrTermReturn(0),
    cfg_test_block(9000000000000000, IrTermJump(9000000000000000, IrValueNil),
    cfg_test_block(2, IrTermJump(3, IrValueNil),
    cfg_test_block(3, IrTermJump(2, IrValueNil), IrBlockListNil))))
  let facts = ir_cfg_cycles(blocks)
  Test.assert_true(not ir_cfg_block_is_cyclic(facts, 0))
  Test.assert_true(ir_cfg_block_is_cyclic(facts, 9000000000000000))
  Test.assert_true(ir_cfg_block_is_cyclic(facts, 2))
  Test.assert_true(ir_cfg_block_is_cyclic(facts, 3))
}

test "malformed CFGs publish no cycle facts" {
  let duplicate = cfg_test_block(1, IrTermJump(1, IrValueNil), cfg_test_block(1, IrTermReturn(0), IrBlockListNil))
  let missing = cfg_test_block(1, IrTermBranch(0, 1, 2), IrBlockListNil)
  let unfinished = cfg_test_block(1, IrTermNone, IrBlockListNil)
  let negative = cfg_test_block(0 - 1, IrTermReturn(0), IrBlockListNil)
  let missing_abort = IrBlockListCons(IrBlock(1, IrValueNil,
    IrInstCons(IrHandleI64(0, 0, 0, IrHandlerClauseBodyNil, 0, 99), IrInstNil), IrTermReturn(0)), IrBlockListNil)
  Test.assert_true(match ir_cfg_cycles(duplicate) { IrCfgInvalid -> true, _ -> false })
  Test.assert_true(match ir_cfg_cycles(missing) { IrCfgInvalid -> true, _ -> false })
  Test.assert_true(match ir_cfg_cycles(unfinished) { IrCfgInvalid -> true, _ -> false })
  Test.assert_true(match ir_cfg_cycles(negative) { IrCfgInvalid -> true, _ -> false })
  Test.assert_true(match ir_cfg_cycles(missing_abort) { IrCfgInvalid -> true, _ -> false })
  Test.assert_true(match ir_cfg_cycles(IrBlockListNil) { IrCfgCycles(facts) -> true, _ -> false })
}

test "long sparse graphs use the work stack and retain exact cycle membership" {
  let mut blocks = cfg_test_block(2000000, IrTermJump(1000000, IrValueNil), IrBlockListNil)
  let mut id = 1999
  while id >= 0 {
    blocks = cfg_test_block(id * 1000, IrTermJump((id + 1) * 1000, IrValueNil), blocks)
    id = id - 1
  }
  let facts = ir_cfg_cycles(blocks)
  id = 0
  while id <= 2000 {
    Test.assert_true(ir_cfg_block_is_cyclic(facts, id * 1000) == (id >= 1000))
    id = id + 1
  }
}

-- Every directed graph on three vertices, including irreducible cycles,
-- duplicate branch destinations, isolated vertices and abort-only edges.
-- The independent oracle uses transitive closure, not component discovery.
test "cycle facts agree with reachability for every three-vertex graph" {
  let mut mask = 0
  while mask < 512 {
    let mut reachable: [bool; 9] = [false, false, false, false, false, false, false, false, false]
    let mut bit = 1
    let mut offset: usize = 0
    while offset < 9 {
      reachable[offset] = (mask band bit) != 0
      bit = bit * 2
      offset = offset + 1
    }
    let mut blocks = IrBlockListNil
    let mut row: usize = 0
    let mut block_id: i64 = 11
    while row < 3 {
      let mut insts = IrInstNil
      let mut col: usize = 0
      let mut target: i64 = 11
      while col < 3 {
        if reachable[row * 3 + col] {
          insts = IrInstCons(IrHandleI64(0, 0, 0, IrHandlerClauseBodyNil, 0, target), insts)
        } else { nil }
        col = col + 1
        target = target + 101
      }
      blocks = IrBlockListCons(IrBlock(block_id, IrValueNil, insts, IrTermReturn(0)), blocks)
      row = row + 1
      block_id = block_id + 101
    }
    let facts = ir_cfg_cycles(blocks)
    let compact_facts = ir_cfg_cycles(ir_cfg_compact_blocks(blocks))
    let mut via: usize = 0
    while via < 3 {
      row = 0
      while row < 3 {
        let mut col: usize = 0
        while col < 3 {
          reachable[row * 3 + col] = reachable[row * 3 + col] or (reachable[row * 3 + via] and reachable[via * 3 + col])
          col = col + 1
        }
        row = row + 1
      }
      via = via + 1
    }
    Test.assert_true(ir_cfg_block_is_cyclic(facts, 11) == reachable[0])
    Test.assert_true(ir_cfg_block_is_cyclic(facts, 112) == reachable[4])
    Test.assert_true(ir_cfg_block_is_cyclic(facts, 213) == reachable[8])
    Test.assert_true(ir_cfg_block_is_cyclic(compact_facts, 2) == reachable[0])
    Test.assert_true(ir_cfg_block_is_cyclic(compact_facts, 1) == reachable[4])
    Test.assert_true(ir_cfg_block_is_cyclic(compact_facts, 0) == reachable[8])
    mask = mask + 1
  }
}

test "CFG compaction preserves values and rewrites branch jump and abort targets" {
  let original = IrBlockListCons(IrBlock(900, IrValueNil, IrInstCons(IrConstI64(7, 42), IrInstNil),
    IrTermJump(300, IrValueCons(7, IrValueNil))),
    IrBlockListCons(IrBlock(300, IrValueCons(8, IrValueNil),
      IrInstCons(IrHandleI64(9, 1234, 5678, IrHandlerClauseBodyNil, 0, 1200), IrInstNil),
      IrTermBranch(8, 1200, 300)), cfg_test_block(1200, IrTermReturn(8), IrBlockListNil)))
  let compact = ir_cfg_compact_blocks(original)
  Test.assert_true(match compact {
    IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(IrConstI64(7, 42), IrInstNil),
      IrTermJump(1, IrValueCons(7, IrValueNil))),
      IrBlockListCons(IrBlock(1, IrValueCons(8, IrValueNil),
        IrInstCons(IrHandleI64(9, 1234, 5678, IrHandlerClauseBodyNil, 0, 2), IrInstNil),
        IrTermBranch(8, 2, 1)),
      IrBlockListCons(IrBlock(2, IrValueNil, IrInstNil, IrTermReturn(8)), IrBlockListNil))) -> true
    _ -> false
  })
}

test "CFG compaction leaves invalid graphs available to the verifier" {
  let missing = cfg_test_block(100, IrTermJump(999, IrValueNil), IrBlockListNil)
  Test.assert_true(match ir_cfg_compact_blocks(missing) {
    IrBlockListCons(IrBlock(100, _, _, IrTermJump(999, _)), IrBlockListNil) -> true
    _ -> false
  })
  let duplicate = cfg_test_block(100, IrTermReturn(0), cfg_test_block(100, IrTermReturn(1), IrBlockListNil))
  Test.assert_true(match ir_cfg_compact_blocks(duplicate) {
    IrBlockListCons(IrBlock(100, _, _, IrTermReturn(0)),
      IrBlockListCons(IrBlock(100, _, _, IrTermReturn(1)), IrBlockListNil)) -> true
    _ -> false
  })
  Test.assert_true(match ir_cfg_compact_blocks(cfg_test_block(100, IrTermNone, IrBlockListNil)) {
    IrBlockListCons(IrBlock(100, _, _, IrTermNone), IrBlockListNil) -> true
    _ -> false
  })
  Test.assert_true(match ir_cfg_compact_blocks(IrBlockListNil) { IrBlockListNil -> true, _ -> false })
}
