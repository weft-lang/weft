use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/state as state
use stdlib/state.{State}
use stdlib/fail.{Fail}
use runtime/rc.{rc_count}

fn transform_location(index: usize) -> DiagnosticLocation {
  DiagnosticSourceRange(DiagnosticSourceNamed("generated.weft"), index, index + 1)
}

fn transform_example() -> Diagnostic {
  let related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("first", transform_location(1)),
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("second", transform_location(2)), DiagnosticRelatedLocationNil))
  let edits = DiagnosticTextEditCons(DiagnosticTextEdit(transform_location(4), "left"),
    DiagnosticTextEditCons(DiagnosticTextEdit(transform_location(5), "right"), DiagnosticTextEditNil))
  let fields = DiagnosticFieldCons(DiagnosticFieldText("text", "value"),
    DiagnosticFieldCons(DiagnosticFieldI64("signed", - 42),
    DiagnosticFieldCons(DiagnosticFieldU64("unsigned", 0xFFFF_FFFF_FFFF_FFFF),
    DiagnosticFieldCons(DiagnosticFieldBool("boolean", true),
    DiagnosticFieldCons(DiagnosticFieldLocation("definition", transform_location(3)),
    DiagnosticFieldCons(DiagnosticFieldType("type", SemanticTypePrimitive("str")),
    DiagnosticFieldCons(DiagnosticFieldEffectAtom("atom", SemanticEffectAtom("Read", SemanticTypeFactListNil)),
    DiagnosticFieldCons(DiagnosticFieldEffectSet("effects", SemanticEffectsClosed(SemanticEffectAtomFactListNil)),
    DiagnosticFieldCons(DiagnosticFieldSuggestion(DiagnosticSuggestion("repair", DiagnosticSuggestionMaybeIncorrect, edits)),
    DiagnosticFieldNil)))))))))
  Diagnostic(DiagnosticSeverityWarning, DiagnosticClassGrammar, DiagnosticCodeAssigned("E0002"), "message", transform_location(0), related, fields)
}

fn transform_field_at(fields: DiagnosticFieldList, index: usize) -> Option<DiagnosticField> {
  let mut remaining = fields
  let mut position: usize = 0
  loop {
    match remaining {
      DiagnosticFieldNil -> return None<DiagnosticField>()
      DiagnosticFieldCons(field, rest) -> {
        if position == index { return Some(field) }
        position = position + 1
        remaining = rest
      }
    }
  }
}

fn transform_shift(location: DiagnosticLocation) -> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(source, start, end) -> DiagnosticSourceRange(DiagnosticSourceNamed("host.weft"), start + 100, end + 100)
    DiagnosticLocationNone -> DiagnosticLocationNone
  }
}

fn transform_observe(location: DiagnosticLocation) -[State<List<usize>>]> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(_, start, _) -> { state.modify((items: List<usize>) => Cons(start, items)) nil }
    DiagnosticLocationNone -> nil
  }
  transform_shift(location)
}

test "diagnostic location transforms visit primary related fields and edits in order" {
  let (mapped, observed) = state.run(Nil<usize>(), () => transform_example().map_locations(transform_observe))
  let order = observed.reverse()
  Test.assert_eq_usize(order.len(), 6)
  for index in 0..6 { Test.assert_eq_usize(order.get(__i64_to_usize(index)).unwrap(), __i64_to_usize(index)) }
  Test.assert_true(match mapped.primary() {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) -> name == "host.weft" and start == 100 and end == 101
    _ -> false
  })
  Test.assert_true(match mapped.related() {
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(first, DiagnosticSourceRange(_, first_start, _)), DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(second, DiagnosticSourceRange(_, second_start, _)), DiagnosticRelatedLocationNil)) ->
      first == "first" and second == "second" and first_start == 101 and second_start == 102
    _ -> false
  })
  Test.assert_true(match transform_field_at(mapped.fields(), 4).unwrap() {
    DiagnosticFieldLocation(name, DiagnosticSourceRange(_, start, end)) -> name == "definition" and start == 103 and end == 104
    _ -> false
  })
  Test.assert_true(match transform_field_at(mapped.fields(), 8).unwrap() {
    DiagnosticFieldSuggestion(DiagnosticSuggestion(message, DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditCons(DiagnosticTextEdit(DiagnosticSourceRange(_, left_start, _), left), DiagnosticTextEditCons(DiagnosticTextEdit(DiagnosticSourceRange(_, right_start, _), right), DiagnosticTextEditNil)))) ->
      message == "repair" and left_start == 104 and right_start == 105 and left == "left" and right == "right"
    _ -> false
  })
}

test "diagnostic location transforms preserve every nonlocation field variant" {
  let mapped = transform_example().map_locations(transform_shift)
  Test.assert_str_eq(mapped.severity().name(), "warning")
  Test.assert_str_eq(mapped.class().name(), "grammar")
  Test.assert_true(mapped.code().eq(DiagnosticCodeAssigned("E0002")))
  Test.assert_str_eq(mapped.message(), "message")
  Test.assert_eq_usize(mapped.fields().len(), 9)
  Test.assert_true(match transform_field_at(mapped.fields(), 0).unwrap() { DiagnosticFieldText(name, value) -> name == "text" and value == "value", _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 1).unwrap() { DiagnosticFieldI64(name, value) -> name == "signed" and value == - 42, _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 2).unwrap() { DiagnosticFieldU64(name, value) -> name == "unsigned" and value == 0xFFFF_FFFF_FFFF_FFFF, _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 3).unwrap() { DiagnosticFieldBool(name, value) -> name == "boolean" and value, _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 5).unwrap() { DiagnosticFieldType(name, SemanticTypePrimitive(value)) -> name == "type" and value == "str", _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 6).unwrap() { DiagnosticFieldEffectAtom(name, SemanticEffectAtom(effect_name, SemanticTypeFactListNil)) -> name == "atom" and effect_name == "Read", _ -> false })
  Test.assert_true(match transform_field_at(mapped.fields(), 7).unwrap() { DiagnosticFieldEffectSet(name, SemanticEffectsClosed(SemanticEffectAtomFactListNil)) -> name == "effects", _ -> false })
}

fn transform_count(location: DiagnosticLocation) -[State<i64>]> DiagnosticLocation {
  state.modify((count: i64) => count + 1)
  location
}

test "absent diagnostic locations are visited without inventing envelope data" {
  let original = uncoded(DiagnosticSeverityNote, DiagnosticClassOther("external"), "empty", DiagnosticLocationNone)
  let (mapped, visits) = state.run(0, () => original.map_locations(transform_count))
  Test.assert_eq(visits, 1)
  Test.assert_true(match mapped.primary() { DiagnosticLocationNone -> true, _ -> false })
  Test.assert_true(match mapped.code() { DiagnosticCodeUnassigned -> true, _ -> false })
  Test.assert_str_eq(mapped.severity().name(), "note")
  Test.assert_str_eq(mapped.class().name(), "external")
  Test.assert_str_eq(mapped.message(), "empty")
  Test.assert_eq_usize(mapped.related().len(), 0)
  Test.assert_eq_usize(mapped.fields().len(), 0)
}

test "identity location transforms preserve full-width offsets and source identities" {
  for source in [DiagnosticSourceUnknown, DiagnosticSourceBuffer(42), DiagnosticSourceNamed("host.weft")] {
    let original = uncoded(DiagnosticSeverityError, DiagnosticClassParse, "wide", DiagnosticSourceRange(source, 0xFFFF_FFFF_FFFF_FFFE, 0xFFFF_FFFF_FFFF_FFFF))
    let mapped = original.map_locations((location: DiagnosticLocation) => location)
    Test.assert_true(match mapped.primary() {
      DiagnosticSourceRange(identity, start, end) -> {
        let same = match (identity, source) {
          (DiagnosticSourceUnknown, DiagnosticSourceUnknown) -> true
          (DiagnosticSourceBuffer(left), DiagnosticSourceBuffer(right)) -> left == right
          (DiagnosticSourceNamed(left), DiagnosticSourceNamed(right)) -> left == right
          _ -> false
        }
        same and start == 0xFFFF_FFFF_FFFF_FFFE and end == 0xFFFF_FFFF_FFFF_FFFF
      }
      _ -> false
    })
  }
}

fn transform_until_abort(location: DiagnosticLocation) -[State<i64>, Fail<i64>]> DiagnosticLocation {
  let count = state.modify((visits: i64) => visits + 1)
  if count == 3 { Fail.fail(count) }
  location
}

test "aborting a diagnostic transform stops before later locations" {
  let (result, visits) = state.run(0, () => handle {
    let mapped = transform_example().map_locations(transform_until_abort)
    0
  } { Fail<i64>.fail(count) -> count })
  Test.assert_eq(result, 3)
  Test.assert_eq(visits, 3)
}

test "large diagnostic location lists preserve every label and ordering" {
  let mut related = DiagnosticRelatedLocationNil
  for index in 0..4096 {
    related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("position", transform_location(__i64_to_usize(index))), related)
  }
  let original = Diagnostic(DiagnosticSeverityError, DiagnosticClassParse, DiagnosticCodeUnassigned, "many", DiagnosticLocationNone, related, DiagnosticFieldNil)
  let mapped = original.map_locations((location: DiagnosticLocation) => location)
  Test.assert_eq_usize(mapped.related().len(), 4096)
  let mut remaining = mapped.related()
  let mut expected: usize = 4096
  loop {
    match remaining {
      DiagnosticRelatedLocationNil -> break
        DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
        expected = expected - 1
        Test.assert_str_eq(label, "position")
        Test.assert_true(match location { DiagnosticSourceRange(_, start, end) -> start == expected and end == expected + 1, _ -> false })
        remaining = rest
      }
    }
  }
  Test.assert_eq_usize(expected, 0)
}

effect SuspendLocation { @deferred fn suspend() -> nil }

fn transform_suspend(location: DiagnosticLocation) -[SuspendLocation]> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(_, start, _) -> if start == 3 { SuspendLocation.suspend() } else { nil }
    DiagnosticLocationNone -> nil
  }
  location
}

fn transform_owned_source(name: str) -[SuspendLocation]> nil {
  let location = DiagnosticSourceRange(DiagnosticSourceNamed(name), 3, 4)
  let related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(name, transform_location(1)), DiagnosticRelatedLocationNil)
  let fields = DiagnosticFieldCons(DiagnosticFieldLocation(name, location), DiagnosticFieldNil)
  let value = Diagnostic(DiagnosticSeverityError, DiagnosticClassParse, DiagnosticCodeUnassigned, name, transform_location(0), related, fields)
  let mapped = value.map_locations(transform_suspend)
  nil
}

test "dropping a suspended location transform releases partially constructed diagnostics" {
  let name = "owned".concat(".weft")
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
  for _ in 0..32 {
    handle transform_owned_source(name) { SuspendLocation.suspend() with k -> nil }
    Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
  }
}
