-- IntoIterator integration: collection coverage, structural items, generic
-- protocol dispatch, live mutable views, and loop-scope abort cleanup.

use runtime/rc_implicit_test.{*}
use stdlib/eq.{Eq}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/hash.{Hash}
use stdlib/iter as iter
use stdlib/iter.{IntoIterator, Iterator}
use stdlib/list.{*}
use stdlib/map as map
use stdlib/ord.{*}
use stdlib/set as set
use stdlib/sorted_map as sorted_map
use stdlib/sorted_set as sorted_set
use stdlib/vector.{*}

effect IteratorStop {
  fn stop(value: i64) -> i64
}

type IteratorProbeKey {
  IteratorProbeKey(i64, RuntimeRcProbe)
}

impl Hash for IteratorProbeKey {
  fn hash(self: IteratorProbeKey) -> i64 {
    match self {
      IteratorProbeKey(value, probe) -> value.hash()
    }
  }
}

impl Eq for IteratorProbeKey {
  fn eq(self: IteratorProbeKey, other: IteratorProbeKey) -> bool {
    match self {
      IteratorProbeKey(left, left_probe) -> match other {
        IteratorProbeKey(right, right_probe) -> left == right
      }
    }
  }
}

fn iterator_probe_key_value(value: IteratorProbeKey) -> i64 {
  match value {
    IteratorProbeKey(key, probe) -> key
  }
}

fn iterator_count<C: IntoIterator>(values: C) -> i64 {
  let mut count = 0
  for _ in values { count = count + 1 }
  count
}

fn iterator_probe_identity(value: RuntimeRcProbe) -> RuntimeRcProbe { value }
fn iterator_probe_keep(value: RuntimeRcProbe) -> bool { true }
fn iterator_double(value: i64) -> i64 { value * 2 }
fn iterator_over_two(value: i64) -> bool { value > 2 }
fn iterator_sum(acc: i64, value: i64) -> i64 { acc + value }
fn iterator_pipe_done(value: nil) -> i64 { 42 }

fn iterator_probe_producer(value: RuntimeRcProbe) -[GeneratorYield]> i64 {
  generator.yield<RuntimeRcProbe>(value)
  generator.yield<RuntimeRcProbe>(value)
  0
}

fn iterator_i64_producer() -[GeneratorYield]> i64 {
  generator.yield<i64>(10)
  generator.yield<i64>(20)
  generator.yield<i64>(12)
  0
}

fn iterator_exit_action(mode: i64, observed: i64) -[IteratorStop]> i64 {
  if mode == 3 { IteratorStop.stop(observed) + 1000 } else { observed }
}

fn iterator_vector_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let values = vector_new<RuntimeRcProbe>()
  vector_push<RuntimeRcProbe>(values, value)
  vector_push<RuntimeRcProbe>(values, value)
  let mut observed = 0
  for item in values {
    observed = observed + runtime_rc_probe_load(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_map_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let empty = map.new<i64, RuntimeRcProbe>()
  let one = empty.insert(10, value)
  let values = one.insert(20, value)
  let mut observed = 0
  for (key, item) in values {
    observed = observed + key + runtime_rc_probe_load(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_set_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let empty = set.new<IteratorProbeKey>()
  let one = empty.insert(IteratorProbeKey(10, value))
  let values = one.insert(IteratorProbeKey(20, value))
  let mut observed = 0
  for item in values {
    observed = observed + iterator_probe_key_value(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_range_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let held: RuntimeRcProbe = value
  let mut observed = 0
  for item in iter.range(0, 2) {
    observed = observed + item + runtime_rc_probe_load(held)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_slice_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let values = [value, value]
  let mut observed = 0
  for item in values[..] {
    observed = observed + runtime_rc_probe_load(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_lazy_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let producer = () => iterator_probe_producer(value)
  let source = iter.from_generator<RuntimeRcProbe>(generator.start<RuntimeRcProbe, i64>(producer))
  let values = source
    |> iter.map<RuntimeRcProbe, RuntimeRcProbe>(iterator_probe_identity)
    |> iter.filter<RuntimeRcProbe>(iterator_probe_keep)
    |> iter.take<RuntimeRcProbe>(2)
  let mut observed = 0
  for item in values {
    observed = observed + runtime_rc_probe_load(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_generator_exit(value: RuntimeRcProbe, mode: i64) -[IteratorStop]> i64 {
  let producer = () => iterator_probe_producer(value)
  let values = iter.from_generator<RuntimeRcProbe>(generator.start<RuntimeRcProbe, i64>(producer))
  let mut observed = 0
  for item in values {
    observed = observed + runtime_rc_probe_load(item)
    if mode == 1 { break } else { 0 }
    if mode == 2 { return observed } else { 0 }
    iterator_exit_action(mode, observed)
  }
  observed
}

fn iterator_exit_family(value: RuntimeRcProbe, family: i64, mode: i64) -[IteratorStop]> i64 {
  match family {
    0 -> iterator_vector_exit(value, mode)
    1 -> iterator_map_exit(value, mode)
    2 -> iterator_set_exit(value, mode)
    3 -> iterator_range_exit(value, mode)
    4 -> iterator_slice_exit(value, mode)
    5 -> iterator_lazy_exit(value, mode)
    _ -> iterator_generator_exit(value, mode)
  }
}

fn iterator_exit_family_run(value: RuntimeRcProbe, family: i64, mode: i64) -> i64 {
  handle iterator_exit_family(value, family, mode) {
    IteratorStop.stop(observed) -> observed
  }
}

test "IntoIterator covers vector map set and structural map items" {
  let vector = vector_new<i64>()
  vector_push<i64>(vector, 10)
  vector_push<i64>(vector, 20)
  vector_push<i64>(vector, 12)
  let mut vector_sum = 0
  for value in vector { vector_sum = vector_sum + value }

  let map0 = map.new<i64, i64>()
  let map1 = map0.insert(10, 1)
  let map2 = map1.insert(20, 2)
  let mut map_sum = 0
  for (key, value) in map2 { map_sum = map_sum + key + value }

  let set0 = set.new<i64>()
  let set1 = set0.insert(4)
  let set2 = set1.insert(5)
  let mut set_sum = 0
  for value in set2 { set_sum = set_sum + value }

  Test.assert_eq(vector_sum, 42)
  Test.assert_eq(map_sum, 33)
  Test.assert_eq(set_sum, 9)
}

test "IntoIterator preserves sorted collection order" {
  let map = sorted_map.new<i64, i64>()
  map.insert(3, 30)
  map.insert(1, 10)
  map.insert(2, 20)
  let mut map_digits = 0
  for (key, value) in map { map_digits = map_digits * 100 + key * 10 + value / 10 }

  let set = sorted_set.new<i64>()
  set.insert(3)
  set.insert(1)
  set.insert(2)
  let mut set_digits = 0
  for value in set { set_digits = set_digits * 10 + value }

  Test.assert_eq(map_digits, 112233)
  Test.assert_eq(set_digits, 123)
}

test "IntoIterator supports generic dispatch iterator identity and lazy methods" {
  Test.assert_eq(iterator_count<Iterator<i64>>(iter.range(7, 10)), 3)
  let result = iter.range(1, 5)
    |> iter.map<i64, i64>(iterator_double)
    |> iter.filter<i64>(iterator_over_two)
    |> iter.take<i64>(2)
    |> iter.fold<i64, i64>(0, iterator_sum)
  Test.assert_eq(result, 10)

  let generated = iter.from_generator<i64>(generator.start<i64, i64>(iterator_i64_producer))
  let mut total = 0
  for value in generated { total = total + value }
  Test.assert_eq(total, 42)
}

test "built-in range array slice and list for paths remain semantic fast paths" {
  let mut range_sum = 0
  for value in 0..4 { range_sum = range_sum + value }
  let mut array_sum = 0
  for value in [10, 20, 12] { array_sum = array_sum + value }
  let backing = [1, 10, 20, 12, 100]
  let mut slice_sum = 0
  for value in backing[1..4] { slice_sum = slice_sum + value }
  let mut list_sum = 0
  for value in Cons<i64>(10, Cons<i64>(20, Cons<i64>(12, Nil))) { list_sum = list_sum + value }
  Test.assert_eq(range_sum, 6)
  Test.assert_eq(array_sum, 42)
  Test.assert_eq(slice_sum, 42)
  Test.assert_eq(list_sum, 42)
}

test "vector iteration observes safe live length mutation" {
  let values = vector_new<i64>()
  vector_push<i64>(values, 10)
  vector_push<i64>(values, 20)
  let mut total = 0
  for value in values {
    total = total + value
    if value == 10 { vector_push<i64>(values, 12) } else { 0 }
  }
  Test.assert_eq(total, 42)
}

test "general for works in statement and pipe positions" {
  let values = vector_new<i64>()
  vector_push<i64>(values, 20)
  vector_push<i64>(values, 22)
  let mut total = 0
  let piped = { for value in values { total = total + value } } |> iterator_pipe_done()
  Test.assert_eq(total, 42)
  Test.assert_eq(piped, 42)
}

test "loop-scope cleanup balances every recoverable exit family" {
  -- Modes: natural exhaustion, break, return, and abortive-handler unwind.
  -- Fatal panic is process-terminal by kernel section 10.7 and is therefore
  -- intentionally not a fictitious recoverable cleanup row.
  for family in 0..7 {
    for mode in 0..4 {
      let value: RuntimeRcProbe = runtime_rc_probe_new(7)
      iterator_exit_family_run(value, family, mode)
      Test.assert_eq(family * 100 + mode * 10 + runtime_rc_probe_count(value), family * 100 + mode * 10 + 1)
    }
  }
}
