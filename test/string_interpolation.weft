use stdlib/display.{*}

test "interp_string_var" {
  let name = "weft"
  Test.assert_eq(str_eq("hello {name}", "hello weft"), 1)
}

test "interp_i64_var" {
  let n = 42
  Test.assert_eq(str_eq("answer {n}", "answer 42"), 1)
}

test "interp_expr" {
  let x = 20
  let y = 22
  Test.assert_eq(str_eq("sum {x + y}", "sum 42"), 1)
}

test "interp_bool" {
  let ok = true
  Test.assert_eq(str_eq("ok {ok}", "ok true"), 1)
}

test "interp_many" {
  let a = "a"
  let b = 40
  Test.assert_eq(str_eq("{a}:{b + 2}:ok", "a:42:ok"), 1)
}
