use stdlib/display.{*}
use stdlib/string.{*}

test "interp_string_var" {
  let name = "weft"
  Test.assert_eq(str_eq(i"hello {name}", "hello weft"), 1)
}

test "interp_i64_var" {
  let n = 42
  Test.assert_eq(str_eq(i"answer {n}", "answer 42"), 1)
}

test "interp_expr" {
  let x = 20
  let y = 22
  Test.assert_eq(str_eq(i"sum {x + y}", "sum 42"), 1)
}

test "interp_bool" {
  let ok = true
  Test.assert_eq(str_eq(i"ok {ok}", "ok true"), 1)
}

test "interp_many" {
  let a = "a"
  let b = 40
  Test.assert_eq(str_eq(i"{a}:{b + 2}:ok", "a:42:ok"), 1)
}

test "plain strings never interpolate" {
  let value = 42
  Test.assert_eq(str_eq("{value}", "{value}"), 1)
  Test.assert_eq(str_eq("type Program<T> = {value: T, ..}", "type Program<T> = {value: T, ..}"), 1)
  Test.assert_eq(str_eq("unmatched } and { are ordinary text", "unmatched } and { are ordinary text"), 1)
}

fn interpolation_string_choice(value: str) -> i64 {
  if str_eq(value, "}") == 1 { 42 } else { 0 }
}

fn interpolation_observe(value: i64) -[TestState]> i64 {
  TestState.put(TestState.get() * 10 + value)
  value
}

test "explicit interpolation marks the string at its opening delimiter" {
  let value = 42
  Test.assert_eq(str_eq(i"answer {value}", "answer 42"), 1)
  Test.assert_eq(str_eq(i"sum {value - 2 + 2}", "sum 42"), 1)
}

test "explicit interpolation decodes ordinary escapes" {
  let value = 42
  Test.assert_eq(str_eq(i"line\n{value}\tend", "line\n42\tend"), 1)
}

test "doubled braces are literal only inside explicit interpolation" {
  let value = 42
  let literal_name = i"{{value}}"
  Test.assert_eq(str_len(literal_name), 7)
  Test.assert_eq(str_byte_at(literal_name, 0), 123)
  Test.assert_eq(str_byte_at(literal_name, 6), 125)
  Test.assert_eq(str_eq(i"{{{value}}}", "{42}"), 1)
  Test.assert_eq(str_eq(i"left {{ middle }} right", "left { middle } right"), 1)
}

test "interpolation expressions balance nested record braces" {
  let value = 42
  Test.assert_eq(str_eq(i"{({ answer: value }).answer}", "42"), 1)
}

test "interpolation preserves control flow and left-to-right evaluation" {
  let conditional = i"result {if true { 42 } else { 0 }}"
  let observed = Test.with_state_i64(0, () => {
    let rendered = i"{interpolation_observe(1)}{interpolation_observe(2)}"
    if str_eq(rendered, "12") == 1 { TestState.get() } else { 0 - 1 }
  })
  Test.assert_eq(str_eq(conditional, "result 42"), 1)
  Test.assert_eq(observed, 12)
}

test "braces inside an expression string do not close interpolation" {
  Test.assert_eq(str_eq(i"answer {interpolation_string_choice("}")}", "answer 42"), 1)
  Test.assert_eq(str_eq(i"answer {40 + -- } remains inside the comment
    2}", "answer 42"), 1)
}

test "nested explicit interpolation uses the same balanced scanner" {
  Test.assert_eq(str_eq(i"outer {i"inner {40 + 2}"}", "outer inner 42"), 1)
}

test "an explicit interpolation string may contain no expressions" {
  Test.assert_eq(str_eq(i"plain", "plain"), 1)
  Test.assert_eq(str_eq(i"", ""), 1)
}
