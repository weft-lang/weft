use "runtime/effects.weft"
use "stdlib/thread.weft"
use "stdlib/unsafe.weft"

fn fiber_body_return(x: i64) -[Unsafe]> i64 {
  x + 2
}

fn fiber_body_once(x: i64) -[Unsafe]> i64 {
  let resumed = fiber_suspend(x + 1)
  resumed + 1
}

fn fiber_body_twice(x: i64) -[Unsafe]> i64 {
  let first = fiber_suspend(x + 1)
  let second = fiber_suspend(first + 1)
  second + 1
}

fn fiber_body_nested_inner(x: i64) -[Unsafe]> i64 {
  let resumed = fiber_suspend(x + 1)
  resumed + 1
}

fn fiber_body_nested_outer(prompt_inner: i64) -[Unsafe]> i64 {
  let first_inner = fiber_resume(prompt_inner, 10)
  fiber_suspend(first_inner + 1)
  99
}

fn run_fiber_direct_return() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let result = fiber_trampoline(prompt, fn_addr_unsafe(fiber_body_return), 40)
  let done = fiber_is_done()
  result * 10 + done
}

fn run_fiber_once() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let first = fiber_trampoline(prompt, fn_addr_unsafe(fiber_body_once), 40)
  let done0 = fiber_is_done()
  let second = fiber_resume(prompt, 42)
  let done1 = fiber_is_done()
  first * 100000 + done0 * 10000 + second * 10 + done1
}

fn run_fiber_twice() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let first = fiber_trampoline(prompt, fn_addr_unsafe(fiber_body_twice), 10)
  let done0 = fiber_is_done()
  let second = fiber_resume(prompt, 20)
  let done1 = fiber_is_done()
  let final = fiber_resume(prompt, 30)
  let done2 = fiber_is_done()
  first * 1000000 + done0 * 100000 + second * 1000 + done1 * 100 + final * 10 + done2
}

fn run_two_suspended_fibers() -[Unsafe]> i64 {
  let segment_a = fiber_segment_new(65536)
  let prompt_a = fiber_prompt_new(segment_a)
  let segment_b = fiber_segment_new(65536)
  let prompt_b = fiber_prompt_new(segment_b)
  let first_a = fiber_trampoline(prompt_a, fn_addr_unsafe(fiber_body_once), 5)
  let first_b = fiber_trampoline(prompt_b, fn_addr_unsafe(fiber_body_once), 7)
  let final_a = fiber_resume(prompt_a, 10)
  let done_a = fiber_is_done()
  let final_b = fiber_resume(prompt_b, 20)
  let done_b = fiber_is_done()
  first_a * 100000 + first_b * 1000 + final_a * 100 + done_a * 10 + final_b + done_b
}

fn run_nested_fiber_resume_restores_outer_prompt() -[Unsafe]> i64 {
  let segment_inner = fiber_segment_new(65536)
  let prompt_inner = fiber_prompt_new(segment_inner)
  let first_inner = fiber_trampoline(prompt_inner, fn_addr_unsafe(fiber_body_nested_inner), 1)
  let segment_outer = fiber_segment_new(65536)
  let prompt_outer = fiber_prompt_new(segment_outer)
  let first_outer = fiber_trampoline(prompt_outer, fn_addr_unsafe(fiber_body_nested_outer), prompt_inner)
  let done0 = fiber_is_done()
  let final_outer = fiber_resume(prompt_outer, 40)
  let done1 = fiber_is_done()
  first_inner * 100000 + first_outer * 1000 + done0 * 100 + final_outer * 10 + done1
}

fn run_unsafe(thunk: () -[Unsafe]> i64) -> i64 {
  handle thunk() {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
}

test "runtime_fiber_layout_initializes_segment_and_prompt" {
  let segment = fiber_segment_new(32)
  let prompt = fiber_prompt_new(segment)
  Test.assert_eq(fiber_segment_size(), 120)
  Test.assert_eq(fiber_prompt_size(), 120)
  Test.assert_eq(fiber_prompt_segment(prompt), segment)
  Test.assert_eq(fiber_prompt_prev_prompt(prompt), 0)
  Test.assert_eq(fiber_segment_stack_len(segment), 4096)
  Test.assert_eq(fiber_segment_stack_top(segment) - fiber_segment_stack_top(segment) / 16 * 16, 0)
  Test.assert_eq(fiber_segment_saved_sp(segment), 0)
}

test "runtime_fiber_trampoline_direct_return_marks_done" {
  Test.assert_eq(run_unsafe(run_fiber_direct_return), 421)
}

test "runtime_fiber_single_suspend_resume_roundtrip" {
  Test.assert_eq(run_unsafe(run_fiber_once), 4100431)
}

test "runtime_fiber_multiple_suspend_resume_roundtrip" {
  Test.assert_eq(run_unsafe(run_fiber_twice), 11021311)
}

test "runtime_fiber_two_suspended_prompts_resume_independently" {
  Test.assert_eq(run_unsafe(run_two_suspended_fibers), 609132)
}

test "runtime_fiber_nested_resume_restores_outer_prompt" {
  Test.assert_eq(run_unsafe(run_nested_fiber_resume_restores_outer_prompt), 212991)
}
