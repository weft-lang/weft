-- A value-producing `if` inside a loop body follows the ordinary result
-- convention: the merged value owns its stake whichever arm supplied it, so a
-- borrowed arm is retained on its own edge before the merge. Without that, the
-- binding's release at the end of every iteration consumes the owner's stake.

use runtime/rc.{rc_count}
use runtime/rc_implicit_test.{
  RuntimeRcProbe,
  runtime_rc_probe_count,
  runtime_rc_probe_load,
  runtime_rc_probe_new
}
use stdlib/test.{Test}

fn load(probe: RuntimeRcProbe) -> i64 { runtime_rc_probe_load(probe) }

fn while_param_or_fresh(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen = if i == n - 1 { held } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_fresh_or_param(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen = if i < n - 1 { runtime_rc_probe_new(1) } else { held }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_two_borrows(first: RuntimeRcProbe, second: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen = if i % 2 == 0 { first } else { second }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_local_borrow(n: i64) -> i64 {
  let local = runtime_rc_probe_new(5)
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen = if i == 0 { local } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
    i = i + 1
  }
  total + runtime_rc_probe_count(local) * 100
}

fn while_annotated(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen: RuntimeRcProbe = if n > 0 { held } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_nested(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let chosen = if i == 0 { runtime_rc_probe_new(1) } else {
      if i == 1 { held } else { runtime_rc_probe_new(2) }
    }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_mutable(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let mut chosen = if i == 0 { held } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
    chosen = runtime_rc_probe_new(3)
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_continue_arm(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    i = i + 1
    let chosen = if i == 2 { continue } else { held }
    total = total + load(chosen)
  }
  total
}

fn for_param_or_fresh(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut total = 0
  for i in 0..n {
    let chosen = if i == 0 { held } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
  }
  total
}

fn loop_param_or_fresh(held: RuntimeRcProbe, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  loop {
    if i == n { break }
    let chosen = if i == 1 { held } else { runtime_rc_probe_new(1) }
    total = total + load(chosen)
    i = i + 1
  }
  total
}

fn while_text(label: str, n: i64) -> i64 {
  let mut i = 0
  let mut total = 0
  while i < n {
    let line_label = if i == n - 1 { label } else { "" }
    total = total + (if line_label.len() > 0 { 1 } else { 0 })
    i = i + 1
  }
  total
}

fn text_count(text: str) -> i64 { rc_count(__str_ptr(text) - 16) }

test "a borrowed parameter arm in a while loop keeps the caller's stake" {
  let held = runtime_rc_probe_new(40)
  let before = runtime_rc_probe_count(held)
  Test.assert_eq(while_param_or_fresh(held, 3), 42)
  Test.assert_eq(while_fresh_or_param(held, 3), 42)
  Test.assert_eq(runtime_rc_probe_count(held), before)
  Test.assert_eq(load(held), 40)
}

test "two borrowed arms in a while loop each keep their owner's stake" {
  let first = runtime_rc_probe_new(10)
  let second = runtime_rc_probe_new(20)
  let first_before = runtime_rc_probe_count(first)
  let second_before = runtime_rc_probe_count(second)
  Test.assert_eq(while_two_borrows(first, second, 4), 60)
  Test.assert_eq(runtime_rc_probe_count(first), first_before)
  Test.assert_eq(runtime_rc_probe_count(second), second_before)
}

test "a borrowed local arm in a while loop keeps the local's stake" {
  Test.assert_eq(while_local_borrow(3), 107)
}

test "annotated, nested and mutable loop bindings retain borrowed arms" {
  let held = runtime_rc_probe_new(7)
  let before = runtime_rc_probe_count(held)
  Test.assert_eq(while_annotated(held, 3), 21)
  Test.assert_eq(while_nested(held, 3), 10)
  Test.assert_eq(while_mutable(held, 2), 14)
  Test.assert_eq(runtime_rc_probe_count(held), before)
  Test.assert_eq(load(held), 7)
}

test "a terminating arm leaves the borrowed arm's retain on its own edge" {
  let held = runtime_rc_probe_new(6)
  let before = runtime_rc_probe_count(held)
  Test.assert_eq(while_continue_arm(held, 3), 12)
  Test.assert_eq(runtime_rc_probe_count(held), before)
}

test "for and unconditional loops retain borrowed arms" {
  let held = runtime_rc_probe_new(9)
  let before = runtime_rc_probe_count(held)
  Test.assert_eq(for_param_or_fresh(held, 3), 11)
  Test.assert_eq(loop_param_or_fresh(held, 3), 11)
  Test.assert_eq(runtime_rc_probe_count(held), before)
}

test "a borrowed string arm beside a literal keeps the caller's stake" {
  let label = "expected".concat(" expression")
  let before = text_count(label)
  Test.assert_eq(while_text(label, 3), 1)
  Test.assert_eq(while_text(label, 1), 1)
  Test.assert_eq(text_count(label), before)
  Test.assert_str_eq(label, "expected expression")
}
