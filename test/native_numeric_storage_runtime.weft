use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/math as math
use stdlib/num.{*}
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/test.{Test}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read}

test "table aliases observe writes across square roots and numeric conversions" {
  let table = f64_table.filled(2, 3, 9.0).unwrap()
  let alias = table
  for row in 0..table.rows() {
    for column in 0..table.columns() {
      let before = table.get(row, column).unwrap()
      let root = before.sqrt()
      Test.assert_true(alias.set(row, column, root + before))
      let narrow: f32 = before.to_f32_round()
      let root32 = narrow.sqrt().to_f64()
      Test.assert_true(root == root32)
      Test.assert_true(table.get(row, column).unwrap() == 12.0)
    }
  }
  Test.assert_eq(table.rows(), 2)
  Test.assert_eq(alias.columns(), 3)
  Test.assert_true(table.get(2, 0).is_none())
}

effect NumericInput { fn input() -> f64 }

fn numeric_argument_inner(table: F64Table, log: i64) -[NumericInput]> f64 {
  let inner: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  let before = table.get(0, 0).unwrap()
  let root = NumericInput.input().sqrt()
  before + root + table.get(0, 0).unwrap()
}

fn numeric_argument_outer(table: F64Table, log: i64) -[NumericInput]> f64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  numeric_argument_inner(table, log)
}

test "numeric argument effects retain mutation order and exact cleanup on resume" {
  let table = f64_table.filled(1, 1, 2.0).unwrap()
  let log = defer_order_log_new()
  let result = handle numeric_argument_outer(table, log) {
    NumericInput.input() -> { table.set(0, 0, 9.0) resume(16.0) }
  }
  Test.assert_true(result == 15.0)
  Test.assert_true(table.get(0, 0).unwrap() == 9.0)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "aborting a numeric argument skips the computation and drops both scopes once" {
  let table = f64_table.filled(1, 1, 2.0).unwrap()
  let log = defer_order_log_new()
  let result = handle numeric_argument_outer(table, log) {
    NumericInput.input() -> { table.set(0, 0, 9.0) 42.0 }
  }
  Test.assert_true(result == 42.0)
  Test.assert_true(table.get(0, 0).unwrap() == 9.0)
  Test.assert_eq(defer_order_log_read(log), 21)
}

fn sqrt(value: f64) -[NumericInput]> f64 { NumericInput.input() + value }

fn ordinary_numeric_name(table: F64Table) -[NumericInput]> f64 {
  let before = table.get(0, 0).unwrap()
  let changed = sqrt(4.0)
  before + changed + table.get(0, 0).unwrap()
}

test "an ordinary same-spelled function keeps its own behavior and effect barrier" {
  let table = f64_table.filled(1, 1, 2.0).unwrap()
  let result = handle ordinary_numeric_name(table) {
    NumericInput.input() -> { table.set(0, 0, 9.0) resume(16.0) }
  }
  Test.assert_true(result == 31.0)
}
