-- Fixed-array destruction is a typed IR fact consumer. These tests keep the
-- plan constants, optimiser transport, native counted loop, and J3 abort edge
-- tied to the same instruction rather than allowing a type rescan in codegen.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"
use runtime/unsafe.{*}

fn array_drop_word_count(code: i64, target: i64) -> i64 {
  let mut count = 0
  let mut pos = 0
  while pos + 4 <= buf_len(code) {
    if pipeline_native_code_word(code, pos) == target { count = count + 1 } else { 0 }
    pos = pos + 4
  }
  count
}

fn array_drop_register_runtime(fm: i64, name: str, offset: i64) -> i64 {
  fmap_add(fm, __str_ptr(name), 0, __str_len(name), offset)
  0
}

fn array_drop_test_function(data: i64, count: i64, stride: i64, kind: i64) -> IrFunction {
  let insts = ir_inst_list_prepend(ir_inst_array_drop_i64(data, count, stride, kind), ir_inst_list_empty())
  ir_function_new_src(74001, 1, ir_block_new_term(0, insts, ir_term_return(0)), 0)
}

test "array_drop_ir_publishes_one_typed_operand" {
  let inst = ir_inst_array_drop_i64(7, 12, 16, continuation_cleanup_kind_rc())
  Test.assert_eq(ir_inst_tag(inst), 43)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 0 - 1)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 1)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 7)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)
}

test "array_drop_ir_alias_rewrite_preserves_plan" {
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3)
  let rewritten = pipeline_ir_rewrite_inst_uses(ir_inst_array_drop_i64(7, 12, 16, continuation_cleanup_kind_weak()), aliases)
  match rewritten {
    IrArrayDropI64(data, count, stride, kind) -> {
      Test.assert_eq(data, 3)
      Test.assert_eq(count, 12)
      Test.assert_eq(stride, 16)
      Test.assert_eq(kind, continuation_cleanup_kind_weak())
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "array_drop_verifier_tracks_data_use" {
  Test.assert_eq(pipeline_ir_verify_function(array_drop_test_function(0, 3, 8, continuation_cleanup_kind_rc())), 0)
  -- kind 2, block 0, undefined value 9.
  Test.assert_eq(pipeline_ir_verify_function(array_drop_test_function(9, 3, 8, continuation_cleanup_kind_rc())), 2000000009)
}

test "array_drop_plan_validity_and_keys_are_total" {
  let rc = continuation_cleanup_kind_rc()
  let closure = continuation_cleanup_kind_closure()
  let weak = continuation_cleanup_kind_weak()
  Test.assert_eq(pipeline_array_drop_plan_is_valid(0, 0, continuation_cleanup_kind_none()), 1)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(3, 8, rc), 1)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(3, 16, closure), 1)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(3, 24, weak), 1)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(1, 0, rc), 0)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(0, 8, rc), 0)
  Test.assert_eq(pipeline_array_drop_plan_is_valid(1, 8, 99), 0)
  let base = pipeline_array_drop_glue_hash(3, 8, rc)
  Test.assert_eq(pipeline_array_drop_glue_hash(3, 8, rc), base)
  Test.assert_eq(if pipeline_array_drop_glue_hash(4, 8, rc) == base { 1 } else { 0 }, 0)
  Test.assert_eq(if pipeline_array_drop_glue_hash(3, 16, rc) == base { 1 } else { 0 }, 0)
  Test.assert_eq(if pipeline_array_drop_glue_hash(3, 8, closure) == base { 1 } else { 0 }, 0)
}

test "array_drop_abort_facts_bind_storage_to_generated_glue" {
  let insts = ir_inst_list_prepend(
    ir_inst_slot_i64(8),
    ir_inst_list_prepend(
      ir_inst_address_of_slot_i64(0, 8),
      ir_inst_list_prepend(ir_inst_array_drop_i64(0, 3, 8, continuation_cleanup_kind_rc()), ir_inst_list_empty())
    )
  )
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(0)), ir_block_list_empty())
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0)
  Test.assert_eq(nlist_len(facts), 1)
  let fact = nlist_get(facts, 0)
  Test.assert_eq(node_tag(fact), 0)
  Test.assert_eq(node_f1(fact), 0)
  Test.assert_eq(node_f2(fact), pipeline_array_drop_glue_hash(3, 8, continuation_cleanup_kind_rc()))
  Test.assert_eq(node_f3(fact), pipeline_ir_abort_cleanup_array_kind())
  Test.assert_eq(pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, facts), 1)
  Test.assert_eq(pipeline_ir_abort_cleanup_inst_has_action(ir_inst_array_drop_i64(0, 3, 8, continuation_cleanup_kind_rc()), 0, node_f2(fact), node_f3(fact)), 1)
}

test "array_drop_zero_plan_has_no_abort_obligation" {
  let insts = ir_inst_list_prepend(ir_inst_array_drop_i64(0, 0, 0, continuation_cleanup_kind_none()), ir_inst_list_empty())
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(0)), ir_block_list_empty())
  Test.assert_eq(nlist_len(pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0)), 0)
}

test "array_drop_native_emits_one_counted_helper_per_plan" {
  let code = buf_new(4096)
  let fm = fmap_new()
  array_drop_register_runtime(fm, "rc_default_release", 4096)
  let homes = pipeline_ir_native_identity_home_facts(1)
  pipeline_ir_native_emit_array_drop(code, 0, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  let first_len = buf_len(code)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(array_drop_word_count(code, encode_sub_imm(31, 31, 32)), 1)
  Test.assert_eq(array_drop_word_count(code, encode_sub_imm(16, 16, 1)), 1)
  Test.assert_eq(array_drop_word_count(code, encode_ret()), 1)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), pipeline_array_drop_glue_hash(3, 8, continuation_cleanup_kind_rc())) > 1 { 1 } else { 0 }, 1)
  pipeline_ir_native_emit_array_drop(code, 0, 3, 8, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(buf_len(code), first_len + 8)
  Test.assert_eq(array_drop_word_count(code, encode_ret()), 1)
  pipeline_ir_native_emit_array_drop(code, 0, 4, 8, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(array_drop_word_count(code, encode_ret()), 2)
}

test "array_drop_native_zero_and_invalid_plans_fail_closed" {
  let code = buf_new(256)
  let fm = fmap_new()
  let homes = pipeline_ir_native_identity_home_facts(1)
  pipeline_ir_native_emit_array_drop(code, 0, 0, 0, continuation_cleanup_kind_none(), fm, homes)
  Test.assert_eq(buf_len(code), 0)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  pipeline_ir_native_emit_array_drop(code, 0, 1, 0, continuation_cleanup_kind_rc(), fm, homes)
  Test.assert_eq(buf_len(code), 4)
  Test.assert_eq(pipeline_native_code_word(code, 0), encode_brk(28))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}

test "array_drop_abort_action_forward_patches_generated_glue" {
  let code = buf_new(4096)
  let fm = fmap_new()
  array_drop_register_runtime(fm, "rc_default_release", 4096)
  let count = 5
  let stride = 8
  let kind = continuation_cleanup_kind_rc()
  let key = pipeline_array_drop_glue_hash(count, stride, kind)
  pipeline_ir_abort_cleanup_emit_action_address(code, node_new(0, 0, key, pipeline_ir_abort_cleanup_array_kind(), 0), fm)
  pipeline_ir_native_emit_array_drop(code, 0, count, stride, kind, fm, pipeline_ir_native_identity_home_facts(1))
  patch_forward_refs(fm, code)
  -- The action-address thunk at +4 branches to the generated entry at +16.
  Test.assert_eq(pipeline_native_code_word(code, 4), encode_b(12))
  Test.assert_eq(fmap_emit_error_count(fm), 0)
}
