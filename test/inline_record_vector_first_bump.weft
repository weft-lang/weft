-- Expected exit code: 42
-- The first inline-record vector load may have to grow the bump region.
use stdlib/vector as vector
use stdlib/vector.{*}

type FirstBumpReading { a: i64, b: i64, c: i64, d: i64, e: i64 }

fn main() -> i64 {
  let values = vector.with_capacity<FirstBumpReading>(1)
  vector_push<FirstBumpReading>(values, FirstBumpReading { a: 8, b: 9, c: 10, d: 7, e: 8 })
  let got = vector_get<FirstBumpReading>(values, 0, FirstBumpReading { a: 0, b: 0, c: 0, d: 0, e: 0 })
  got.a + got.b + got.c + got.d + got.e
}
