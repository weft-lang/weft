use runtime/memory.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/sha256.{*}
use compiler/backend/binary.{binary_len, binary_u8_at, binary_zeros}
use compiler/backend/macho.{*}
use compiler/backend/object.{*}
use stdlib/bytes as bytes
use stdlib/bytes/builder as byte_builder
use stdlib/vector as vector
use stdlib/vector.{*}

test "runtime_peripheral_alloc_sha256_empty" {
  let arena = arena_new(64)
  let out = arena_alloc(arena, 32, 8)
  sha256(__str_ptr(""), 0, out)
  Test.assert_eq(mem_load8(out), 227)
  Test.assert_eq(mem_load8(out + 1), 176)
  Test.assert_eq(mem_load8(out + 2), 196)
  Test.assert_eq(mem_load8(out + 3), 66)
  Test.assert_eq(mem_load8(out + 31), 85)
  arena_free(arena)
}

test "runtime_peripheral_alloc_sha256_abc" {
  let arena = arena_new(64)
  let out = arena_alloc(arena, 32, 8)
  sha256(__str_ptr("abc"), 3, out)
  Test.assert_eq(mem_load8(out), 186)
  Test.assert_eq(mem_load8(out + 1), 120)
  Test.assert_eq(mem_load8(out + 2), 22)
  Test.assert_eq(mem_load8(out + 3), 191)
  Test.assert_eq(mem_load8(out + 31), 173)
  arena_free(arena)
}

test "runtime_peripheral_alloc_code_signature_hashes_append" {
  -- sha256("abcd") begins 88 d4 and ends 89.
  let mut out = byte_builder.new()
  out.append_text("head")
  emit_cs_hashes(out, bytes.from_str("abcd"), 4, 1)
  Test.assert_eq(binary_len(out), 36)
  let one_page = out.finish()
  Test.assert_eq(binary_u8_at(one_page, 36, 4, 0 - 1), 136)
  Test.assert_eq(binary_u8_at(one_page, 36, 5, 0 - 1), 212)
  Test.assert_eq(binary_u8_at(one_page, 36, 35, 0 - 1), 137)
  -- Each 4 KiB page gets its own hash; the last page covers only the bytes
  -- below the code limit.
  let mut signed = byte_builder.new()
  binary_zeros(signed, 4096)
  signed.append_text("abcd")
  let mut pages = byte_builder.new()
  emit_cs_hashes(pages, signed.finish(), 4100, 2)
  Test.assert_eq(binary_len(pages), 64)
  let hashes = pages.finish()
  Test.assert_eq(binary_u8_at(hashes, 64, 32, 0 - 1), 136)
  Test.assert_eq(binary_u8_at(hashes, 64, 63, 0 - 1), 137)
  Test.assert_false(binary_u8_at(hashes, 64, 0, 0 - 1) == 136)
}

test "runtime_peripheral_alloc_object_symbol_string_table" {
  let src = __str_ptr("main")
  let code = buf_new(8)
  bu32(code, 0)
  let relocs = vector.new<ObjectRelocation>()
  let syms = vector.with_capacity<ObjectSymbol>(1)
  vector_push<ObjectRelocation>(
    relocs,
    ObjectRelocation { address: 0, symbol_or_addend: 0, kind: object_reloc_kind_branch26() }
  )
  vector_push<ObjectSymbol>(
    syms,
    ObjectSymbol { name_start: 0, name_len: 4, value: 0, section: 1 }
  )
  Test.assert_eq(vector_element_size<ObjectRelocation>(relocs), 24)
  Test.assert_eq(
    vector_element_mode<ObjectRelocation>(relocs),
    vector_element_mode_record_payload()
  )
  Test.assert_eq(vector_element_size<ObjectSymbol>(syms), 32)
  Test.assert_eq(vector_element_mode<ObjectSymbol>(syms), vector_element_mode_record_payload())
  let obj = emit_object(code, relocs, syms, src, 0, 0)
  let p = buf_ptr(obj)
  Test.assert_eq(if buf_len(obj) > 128 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load8(p), 207)
  Test.assert_eq(mem_load8(p + 1), 250)
  Test.assert_eq(mem_load8(p + 2), 237)
  Test.assert_eq(mem_load8(p + 3), 254)
  -- One-section header is 312 bytes; the four-byte code precedes this
  -- ARM64_RELOC_BRANCH26 entry at byte 316.
  Test.assert_eq(mem_load8(p + 316), 0)
  Test.assert_eq(mem_load8(p + 320), 0)
  Test.assert_eq(mem_load8(p + 323), 45)
}
