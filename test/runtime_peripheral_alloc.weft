use "runtime/memory.weft"
use "runtime/alloc.weft"
use "compiler/sha256.weft"
use "compiler/macho.weft"
use "compiler/object.weft"

test "runtime_peripheral_alloc_sha256_empty" {
  let arena = arena_new(64)
  let out = arena_alloc(arena, 32, 8)
  sha256(__str_ptr(""), 0, out)
  Test.assert_eq(mem_load8(out), 227)
  Test.assert_eq(mem_load8(out + 1), 176)
  Test.assert_eq(mem_load8(out + 2), 196)
  Test.assert_eq(mem_load8(out + 3), 66)
  Test.assert_eq(mem_load8(out + 31), 85)
  arena_free(arena)
}

test "runtime_peripheral_alloc_sha256_abc" {
  let arena = arena_new(64)
  let out = arena_alloc(arena, 32, 8)
  sha256(__str_ptr("abc"), 3, out)
  Test.assert_eq(mem_load8(out), 186)
  Test.assert_eq(mem_load8(out + 1), 120)
  Test.assert_eq(mem_load8(out + 2), 22)
  Test.assert_eq(mem_load8(out + 3), 191)
  Test.assert_eq(mem_load8(out + 31), 173)
  arena_free(arena)
}

test "runtime_peripheral_alloc_code_signature_hashes_append" {
  let b = buf_new(64)
  bstr(b, "abcd")
  emit_cs_hashes(b, 4, 1)
  Test.assert_eq(buf_len(b), 36)
}

test "runtime_peripheral_alloc_object_symbol_string_table" {
  let src = __str_ptr("main")
  let code = buf_new(8)
  bu32(code, 0)
  let relocs = nlist_new()
  let syms = nlist_new()
  nlist_add(syms, node_new(0, 0, 4, 0, 1))
  let obj = emit_object(code, relocs, syms, src)
  let p = buf_ptr(obj)
  Test.assert_eq(if buf_len(obj) > 128 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load8(p), 207)
  Test.assert_eq(mem_load8(p + 1), 250)
  Test.assert_eq(mem_load8(p + 2), 237)
  Test.assert_eq(mem_load8(p + 3), 254)
}
