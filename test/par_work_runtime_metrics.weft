use runtime/par_task.{*}
use runtime/memory.{*}

fn par_work_runtime_descriptor_new(lanes: i64) -> i64 {
  let descriptor = alloc_zeroed(runtime_par_work_descriptor_header_size() + lanes * runtime_par_work_descriptor_entry_size())
  mem_store64(descriptor + runtime_par_work_descriptor_magic_offset(), runtime_par_work_descriptor_magic())
  mem_store64(descriptor + runtime_par_work_descriptor_version_offset(), runtime_par_work_descriptor_version())
  mem_store64(descriptor + runtime_par_work_descriptor_lane_count_offset(), lanes)
  mem_store64(descriptor + runtime_par_work_descriptor_storage_size_offset(), lanes * 8)
  mem_store64(descriptor + runtime_par_work_descriptor_storage_align_offset(), if lanes == 0 { 1 } else { 8 })
  descriptor
}

fn par_work_runtime_descriptor_set(descriptor: i64, lane: i64, lane_class: i64, kind: i64) -> i64 {
  mem_store64(descriptor + runtime_par_work_descriptor_lane_class_offset(lane), lane_class)
  mem_store64(descriptor + runtime_par_work_descriptor_lane_cleanup_offset(lane), kind)
  descriptor
}

fn par_work_runtime_descriptor3(class0: i64, kind0: i64, class1: i64, kind1: i64, class2: i64, kind2: i64) -> i64 {
  let descriptor = par_work_runtime_descriptor_new(3)
  par_work_runtime_descriptor_set(descriptor, 0, class0, kind0)
  par_work_runtime_descriptor_set(descriptor, 1, class1, kind1)
  par_work_runtime_descriptor_set(descriptor, 2, class2, kind2)
  descriptor
}

fn par_work_runtime_descriptor1(lane_class: i64, kind: i64) -> i64 {
  par_work_runtime_descriptor_set(par_work_runtime_descriptor_new(1), 0, lane_class, kind)
}

fn par_work_runtime_zero_descriptor() -> i64 {
  par_work_runtime_descriptor_new(0)
}

test "runtime ParWork descriptor validates every header and lane invariant" {
  let zero = par_work_runtime_zero_descriptor()
  let mixed = par_work_runtime_descriptor3(1, continuation_cleanup_kind_rc(), 2, continuation_cleanup_kind_none(), 3, continuation_cleanup_kind_none())
  Test.assert_eq(runtime_par_work_descriptor_is_valid(zero), 1)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(mixed), 1)
  Test.assert_eq(runtime_par_work_descriptor_lane_count(mixed), 3)
  Test.assert_eq(runtime_par_work_descriptor_lane_class(mixed, 1), 2)
  Test.assert_eq(runtime_par_work_descriptor_lane_cleanup_kind(mixed, 0), continuation_cleanup_kind_rc())

  let wrong_magic = par_work_runtime_zero_descriptor()
  mem_store64(wrong_magic + runtime_par_work_descriptor_magic_offset(), 0)
  let wrong_version = par_work_runtime_zero_descriptor()
  mem_store64(wrong_version + runtime_par_work_descriptor_version_offset(), 2)
  let wrong_size = par_work_runtime_descriptor1(1, continuation_cleanup_kind_none())
  mem_store64(wrong_size + runtime_par_work_descriptor_storage_size_offset(), 7)
  let wrong_align = par_work_runtime_descriptor1(1, continuation_cleanup_kind_none())
  mem_store64(wrong_align + runtime_par_work_descriptor_storage_align_offset(), 1)
  let wrong_class = par_work_runtime_descriptor1(9, continuation_cleanup_kind_none())
  let wrong_kind = par_work_runtime_descriptor1(1, 99)
  let managed_fp = par_work_runtime_descriptor1(3, continuation_cleanup_kind_rc())
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_magic), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_version), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_size), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_align), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_class), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(wrong_kind), 0)
  Test.assert_eq(runtime_par_work_descriptor_is_valid(managed_fp), 0)
}

test "runtime ParWork cleans only initialized lanes after partial construction" {
  let descriptor = par_work_runtime_descriptor3(1, continuation_cleanup_kind_none(), 2, continuation_cleanup_kind_none(), 3, continuation_cleanup_kind_none())
  let work = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  Test.assert_eq(runtime_par_work_entry(work), 66)
  Test.assert_eq(runtime_par_work_size_for_descriptor(descriptor), runtime_par_work_result_data_offset() + 24)
  Test.assert_eq(runtime_par_work_result_store_lane(work, 1, 22), 1)
  Test.assert_eq(runtime_par_work_result_store_lane(work, 1, 33), 0)
  Test.assert_eq(runtime_par_work_result_initialized_mask(work), runtime_par_work_lane_bit(1))
  Test.assert_eq(runtime_par_work_result_publish(work), 0)
  Test.assert_eq(runtime_par_work_result_drop(work), 0)
  Test.assert_eq(runtime_par_work_result_state(work), runtime_par_work_result_moved())
  Test.assert_eq(runtime_par_work_result_load_lane_or(work, 1, 99), 99)
  Test.assert_eq(runtime_par_work_release_closure(work), 1)
  Test.assert_eq(runtime_par_work_release_closure(work), 0)
}

test "runtime ParWork zero-lane result publishes and moves without storage" {
  let descriptor = par_work_runtime_zero_descriptor()
  let work = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  Test.assert_eq(runtime_par_work_size_for_descriptor(descriptor), runtime_par_work_result_data_offset())
  Test.assert_eq(runtime_par_work_result_full_mask(descriptor), 0)
  Test.assert_eq(runtime_par_work_result_state_acquire(work), runtime_par_work_result_empty())
  Test.assert_eq(runtime_par_work_result_publish(work), 1)
  Test.assert_eq(runtime_par_work_result_state_acquire(work), runtime_par_work_result_ready())
  Test.assert_eq(runtime_par_work_result_copy_to(work, 0), 1)
  Test.assert_eq(runtime_par_work_result_move_to(work, 0), 1)
  Test.assert_eq(runtime_par_work_result_state_acquire(work), runtime_par_work_result_moved())
  Test.assert_eq(runtime_par_work_result_state(work), runtime_par_work_result_moved())
  Test.assert_eq(runtime_par_work_result_move_to(work, 0), 0)
}

test "runtime ParWork copies retains and drops every managed lane" {
  let descriptor = par_work_runtime_descriptor3(1, continuation_cleanup_kind_rc(), 1, continuation_cleanup_kind_closure(), 1, continuation_cleanup_kind_weak())
  let payload: rc i64 = rc_default_alloc(8, 8)
  let captured: rc i64 = rc_default_alloc(8, 8)
  let closure = x => x + rc_count(captured)
  let closure_word = runtime_par_task_closure_word(closure)
  let weak_target: rc i64 = rc_default_alloc(8, 8)
  rc_default_retain(payload)
  closure_default_retain(closure_word)
  rc_default_weak_retain(weak_target)
  let work = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  Test.assert_eq(runtime_par_work_result_store_lane(work, 0, payload), 1)
  Test.assert_eq(runtime_par_work_result_store_lane(work, 1, closure_word), 1)
  Test.assert_eq(runtime_par_work_result_store_lane(work, 2, weak_target), 1)
  Test.assert_eq(runtime_par_work_result_publish(work), 1)
  Test.assert_eq(runtime_par_work_result_copy_to(work, runtime_par_work_result_data(work)), 0)
  Test.assert_eq(runtime_par_work_result_move_to(work, runtime_par_work_result_data(work)), 0)
  Test.assert_eq(rc_is_promoted(payload), 1)
  Test.assert_eq(rc_is_promoted(closure_word), 1)
  Test.assert_eq(rc_is_promoted(captured), 1)
  Test.assert_eq(rc_is_promoted(weak_target), 1)

  let destination = alloc_words(3)
  Test.assert_eq(runtime_par_work_result_copy_to(work, destination), 1)
  Test.assert_eq(rc_count(payload), 3)
  Test.assert_eq(rc_count(closure_word), 3)
  Test.assert_eq(rc_weak_count(weak_target), 2)
  continuation_cleanup_release_value(continuation_cleanup_kind_rc(), mem_load64(destination))
  continuation_cleanup_release_value(continuation_cleanup_kind_closure(), mem_load64(destination + 8))
  continuation_cleanup_release_value(continuation_cleanup_kind_weak(), mem_load64(destination + 16))
  Test.assert_eq(rc_count(payload), 2)
  Test.assert_eq(rc_count(closure_word), 2)
  Test.assert_eq(rc_weak_count(weak_target), 1)
  Test.assert_eq(runtime_par_work_result_drop(work), 3)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_count(closure_word), 1)
  Test.assert_eq(rc_weak_count(weak_target), 0)
  Test.assert_eq(runtime_par_work_result_drop(work), 0)
}

test "runtime ParWork move transfers ownership without retain or release" {
  let descriptor = par_work_runtime_descriptor1(1, continuation_cleanup_kind_rc())
  let payload: rc i64 = rc_default_alloc(8, 8)
  rc_default_retain(payload)
  let work = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  runtime_par_work_result_store_lane(work, 0, payload)
  runtime_par_work_result_publish(work)
  let before = rc_count(payload)
  let destination = alloc_words(1)
  let other_descriptor = par_work_runtime_descriptor1(1, continuation_cleanup_kind_none())
  Test.assert_eq(runtime_par_work_result_move_to_expected(work, other_descriptor, destination), 0)
  Test.assert_eq(runtime_par_work_result_move_to_expected(work, descriptor, destination), 1)
  Test.assert_eq(mem_load64(destination), payload)
  Test.assert_eq(rc_count(payload), before)
  Test.assert_eq(runtime_par_work_result_initialized_mask(work), 0)
  Test.assert_eq(runtime_par_work_result_drop(work), 0)
  continuation_cleanup_release_value(continuation_cleanup_kind_rc(), mem_load64(destination))
  Test.assert_eq(rc_count(payload), 1)
}

test "runtime ParWork owns a cloned closure environment exactly once" {
  let descriptor = par_work_runtime_zero_descriptor()
  let payload: rc i64 = rc_default_alloc(8, 8)
  let closure = x => x + rc_count(payload)
  let closure_word = runtime_par_task_closure_word(closure)
  let before = rc_count(payload)
  let work = runtime_par_work_new_raw(descriptor, 66, mem_load64(closure_word), mem_load64(closure_word + 8))
  Test.assert_eq(rc_count(payload), before + 1)
  Test.assert_eq(runtime_par_work_release_closure(work), 1)
  Test.assert_eq(rc_count(payload), before)
  Test.assert_eq(runtime_par_work_release_closure(work), 0)
  Test.assert_eq(runtime_par_work_discard(work), 0)
  Test.assert_eq(rc_count(payload), before)
}

test "runtime ParWork scope owns abandoned results and observed carriers are inert" {
  let descriptor = par_work_runtime_descriptor1(1, continuation_cleanup_kind_rc())
  let abandoned: rc i64 = rc_default_alloc(8, 8)
  let observed: rc i64 = rc_default_alloc(8, 8)
  rc_default_retain(abandoned)
  rc_default_retain(observed)
  let first = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  let second = runtime_par_work_new_raw(descriptor, 66, 77, 0)
  runtime_par_work_result_store_lane(first, 0, abandoned)
  runtime_par_work_result_store_lane(second, 0, observed)
  runtime_par_work_result_publish(first)
  runtime_par_work_result_publish(second)
  let scope = runtime_par_work_scope_new()
  Test.assert_eq(runtime_par_work_scope_track(scope, first), first)
  Test.assert_eq(runtime_par_work_scope_track(scope, second), second)
  Test.assert_eq(runtime_par_work_join(second), second)
  let destination = alloc_words(1)
  Test.assert_eq(runtime_par_work_result_move_to_expected(second, descriptor, destination), 1)
  Test.assert_eq(runtime_par_work_scope_cleanup(scope), 0)
  Test.assert_eq(runtime_par_work_result_state(first), runtime_par_work_result_moved())
  Test.assert_eq(runtime_par_work_result_state(second), runtime_par_work_result_moved())
  Test.assert_eq(rc_count(abandoned), 1)
  Test.assert_eq(rc_count(observed), 2)
  continuation_cleanup_release_value(continuation_cleanup_kind_rc(), mem_load64(destination))
  Test.assert_eq(rc_count(observed), 1)
  Test.assert_eq(runtime_par_work_scope_cleanup(scope), 0)
}
