use test/module_fixtures/module_handler_basic as basic_handler
use test/module_fixtures/module_handler_probe as probe_handler
use test/module_fixtures/module_handler_override as override_handler
use test/module_fixtures/module_handler_abort as abort_handler
use test/module_fixtures/module_handler_deferred as deferred_handler
use test/module_fixtures/module_handler_generic as generic_handler
use test/module_fixtures/module_handler_order as order_handler
use test/module_fixtures/module_handler_default.{module_handler_default_explicit_override, module_handler_default_value}
use runtime/rc_implicit_test.{*}
use stdlib/test.{Test}

fn module_handler_basic() -> i64 {
  with basic_handler() {
    basic_handler.ModuleCounter.get()
  }
}

fn module_handler_control_flow() -> i64 {
  with basic_handler() {
    if true { basic_handler.ModuleCounter.get() } else { 0 }
  }
}

fn module_handler_stateful(probe: RuntimeRcProbe) -> i64 {
  with probe_handler(probe) {
    probe_handler.ModuleProbe.captured_count() * 100 + probe_handler.ModuleProbe.read()
  }
}

fn module_handler_nested_override() -> i64 {
  with basic_handler() {
    with override_handler() {
      basic_handler.ModuleCounter.get()
    }
  }
}

fn module_handler_explicit_override() -> i64 {
  with basic_handler() {
    handle basic_handler.ModuleCounter.get() {
      basic_handler.ModuleCounter.get() -> resume(7)
    }
  }
}

fn module_handler_abort(probe: RuntimeRcProbe) -> i64 {
  with abort_handler(probe) {
    abort_handler.ModuleAbort.stop(42) + 1000
  }
}

fn module_handler_deferred(probe: RuntimeRcProbe) -> i64 {
  with deferred_handler(probe) {
    let value = deferred_handler.ModuleDeferred.step(40)
    if "caller provenance" == deferred_handler.module_handler_expected_text() { value } else { 0 }
  }
}

fn module_handler_deferred_drop(probe: RuntimeRcProbe) -> i64 {
  let during = with deferred_handler(probe) {
    deferred_handler.ModuleDeferred.inspect_drop()
  }
  during * 10 + runtime_rc_probe_count(probe)
}

fn module_handler_generic() -> i64 {
  with generic_handler<i64>() {
    generic_handler.ModuleIdentity<i64>.value(42)
  }
}

fn module_handler_generic_exact_atoms() -> i64 {
  with generic_handler<i64>() {
    with generic_handler<str>() {
      let number = generic_handler.ModuleIdentity<i64>.value(42)
      let text = generic_handler.ModuleIdentity<str>.value("exact atom")
      if text == "exact atom" { number } else { 0 }
    }
  }
}

fn module_handler_constructor_order() -> i64 {
  let mut order = 0
  let handled = with order_handler({ order = order + 1 order }, { order = order + 1 order }) {
    order_handler.ModuleOrder.read()
  }
  handled * 10 + order
}

fn module_handler_closure_capture() -> i64 {
  let captured = 40
  let run = () => with basic_handler() {
    captured + basic_handler.ModuleCounter.get() - 40
  }
  run()
}

fn module_handler_constructor_closure_capture(probe: RuntimeRcProbe) -> i64 {
  let run = () => with probe_handler(probe) {
    probe_handler.ModuleProbe.read()
  }
  run()
}

test "module handler installs a named implementation lexically" {
  Test.assert_eq(module_handler_basic(), 42)
}

test "module handler lowers control flow in the installing source" {
  Test.assert_eq(module_handler_control_flow(), 42)
}

test "module handler constructor captures are live and released once" {
  let probe = runtime_rc_probe_new(73)
  Test.assert_eq(module_handler_stateful(probe), 273)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "nested lexical module handler wins" {
  Test.assert_eq(module_handler_nested_override(), 9)
}

test "explicit inner handler wins over module handler" {
  Test.assert_eq(module_handler_explicit_override(), 7)
}

test "abortive module handler cleans constructor capture" {
  let probe = runtime_rc_probe_new(1)
  Test.assert_eq(module_handler_abort(probe), 242)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "deferred module handler resumes through existing tier five lowering" {
  let probe = runtime_rc_probe_new(2)
  Test.assert_eq(module_handler_deferred(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "deferred module handler prompt owns captures until continuation drop" {
  let probe = runtime_rc_probe_new(2)
  Test.assert_eq(module_handler_deferred_drop(probe), 31)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "generic module handler specializes exact effect atom" {
  Test.assert_eq(module_handler_generic(), 42)
  Test.assert_eq(module_handler_generic_exact_atoms(), 42)
}

test "handler constructor arguments evaluate once from left to right" {
  Test.assert_eq(module_handler_constructor_order(), 122)
}

test "closures capture values through handler bodies and constructors" {
  Test.assert_eq(module_handler_closure_capture(), 42)
  let probe = runtime_rc_probe_new(73)
  Test.assert_eq(module_handler_constructor_closure_capture(probe), 73)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "module default wraps owned function body outermost" {
  Test.assert_eq(module_handler_default_value(), 42)
  Test.assert_eq(module_handler_default_explicit_override(), 8)
}
