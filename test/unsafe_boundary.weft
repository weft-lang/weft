use "stdlib/unsafe.weft"
use "stdlib/thread.weft"

test "safe_pointer_read_write_without_unsafe" {
  let p = __bump_alloc(8)
  __mem_store64(p, 9)
  Test.assert_eq(__mem_load64(p), 9)
}

fn trusted_write_empty() -> i64 {
  handle unsafe_raw_syscall(4, 1, __str_ptr(""), 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(__syscall(num, a0, a1, a2, a3, a4, a5))
  }
}

test "trusted_unsafe_handler_raw_syscall" {
  Test.assert_eq(trusted_write_empty(), 0)
}

test "unsafe_effect_wrapper_mocked" {
  let got = handle unsafe_raw_syscall(4, 1, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(num + a0)
  }
  Test.assert_eq(got, 5)
}

test "trusted_raw_offset_handler" {
  let p = __bump_alloc(16)
  let q = handle unsafe_raw_offset(p, 8) {
    Unsafe.raw_offset(ptr, off) -> resume(__raw_offset(ptr, off))
  }
  __mem_store64(q, 42)
  Test.assert_eq(__mem_load64(p + 8), 42)
}

test "trusted_transmute_handler" {
  let got = handle unsafe_transmute(42) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
  Test.assert_eq(got, 42)
}

test "trusted_int_to_ptr_handler" {
  let got = handle unsafe_int_to_ptr(42) {
    Unsafe.int_to_ptr(addr) -> resume(__int_to_ptr(addr))
  }
  Test.assert_eq(got, 42)
}

test "trusted_runtime_state_handler" {
  let got = handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
  Test.assert_eq(if got != 0 { 1 } else { 0 }, 1)
}

fn unsafe_call_target(x: i64) -> i64 { x + 1 }

test "trusted_raw_call_i64_handler" {
  let got = handle unsafe_raw_call_i64(fn_addr(unsafe_call_target), 41) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
  Test.assert_eq(got, 42)
}
