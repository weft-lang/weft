use runtime/unsafe_boundary_test.{*}

test "safe_pointer_read_write_without_unsafe" {
  Test.assert_eq(unsafe_boundary_raw_memory_read_write(), 9)
}

test "trusted_unsafe_handler_raw_syscall" {
  Test.assert_eq(unsafe_boundary_write_empty(), 0)
}

test "unsafe_effect_wrapper_mocked" {
  Test.assert_eq(unsafe_boundary_mocked_raw_syscall(), 5)
}

test "trusted_raw_offset_handler" {
  Test.assert_eq(unsafe_boundary_raw_offset_base_value(), 7)
  Test.assert_eq(unsafe_boundary_raw_offset_next_value(), 42)
}

test "trusted_raw_offset_preserves_immutable_pointer" {
  Test.assert_eq(unsafe_boundary_raw_offset_preserves_immutable_pointer(), 21)
}

test "trusted_transmute_handler" {
  Test.assert_eq(unsafe_boundary_transmute_back_matches(), 1)
  Test.assert_eq(unsafe_boundary_transmute_store_value(), 33)
}

test "trusted_int_to_ptr_handler" {
  Test.assert_eq(unsafe_boundary_int_to_ptr_value(), 51)
}

test "trusted_runtime_state_handler" {
  Test.assert_eq(unsafe_boundary_runtime_state_nonzero(), 1)
}

test "trusted_raw_call_i64_handler" {
  Test.assert_eq(unsafe_boundary_raw_call_i64_value(), 42)
}
