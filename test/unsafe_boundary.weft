use "stdlib/unsafe.weft"
use "stdlib/thread.weft"

test "safe_pointer_read_write_without_unsafe" {
  let p = __bump_alloc(8)
  __mem_store64(p, 9)
  Test.assert_eq(__mem_load64(p), 9)
}

fn trusted_write_empty() -> i64 {
  handle unsafe_raw_syscall(4, 1, __str_ptr(""), 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(__syscall(num, a0, a1, a2, a3, a4, a5))
  }
}

test "trusted_unsafe_handler_raw_syscall" {
  Test.assert_eq(trusted_write_empty(), 0)
}

test "unsafe_effect_wrapper_mocked" {
  let got = handle unsafe_raw_syscall(4, 1, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(num + a0)
  }
  Test.assert_eq(got, 5)
}

fn trusted_int_to_mut_i64_ptr(addr: i64) -> *mut i64 {
  handle unsafe_int_to_ptr<i64>(addr) {
    Unsafe.int_to_ptr(raw) -> resume(__int_to_ptr(raw))
  }
}

fn trusted_raw_offset_i64(ptr: *i64, offset: i64) -> *i64 {
  handle unsafe_raw_offset<i64>(ptr, offset) {
    Unsafe.raw_offset(raw, off) -> resume(__raw_offset(raw, off))
  }
}

fn trusted_raw_offset_mut_i64(ptr: *mut i64, offset: i64) -> *mut i64 {
  handle unsafe_raw_offset_mut<i64>(ptr, offset) {
    Unsafe.raw_offset(raw, off) -> resume(__raw_offset(raw, off))
  }
}

fn trusted_transmute_i64_to_mut_i64_ptr(value: i64) -> *mut i64 {
  handle unsafe_transmute<i64, *mut i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn trusted_transmute_mut_i64_ptr_to_i64(ptr: *mut i64) -> i64 {
  handle unsafe_transmute<*mut i64, i64>(ptr) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn unsafe_ptr_store_i64(ptr: *mut i64, value: i64) -[Unsafe]> i64 {
  ptr.* = value
  0
}

fn unsafe_ptr_load_i64(ptr: *i64) -[Unsafe]> i64 {
  ptr.*
}

fn trusted_ptr_store_i64(ptr: *mut i64, value: i64) -> i64 {
  handle unsafe_ptr_store_i64(ptr, value) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

fn trusted_ptr_load_i64(ptr: *i64) -> i64 {
  handle unsafe_ptr_load_i64(ptr) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

test "trusted_raw_offset_handler" {
  let p = trusted_int_to_mut_i64_ptr(__bump_alloc(16))
  trusted_ptr_store_i64(p, 7)
  let q = trusted_raw_offset_mut_i64(p, 8)
  trusted_ptr_store_i64(q, 42)
  Test.assert_eq(trusted_ptr_load_i64(p), 7)
  Test.assert_eq(trusted_ptr_load_i64(q), 42)
}

test "trusted_raw_offset_preserves_immutable_pointer" {
  let p = trusted_int_to_mut_i64_ptr(__bump_alloc(16))
  trusted_ptr_store_i64(p, 13)
  let q = trusted_raw_offset_mut_i64(p, 8)
  trusted_ptr_store_i64(q, 21)
  let read = trusted_raw_offset_i64(p, 8)
  Test.assert_eq(trusted_ptr_load_i64(read), 21)
}

test "trusted_transmute_handler" {
  let base = __bump_alloc(8)
  let p = trusted_transmute_i64_to_mut_i64_ptr(base)
  trusted_ptr_store_i64(p, 33)
  Test.assert_eq(trusted_transmute_mut_i64_ptr_to_i64(p), base)
  Test.assert_eq(__mem_load64(base), 33)
}

test "trusted_int_to_ptr_handler" {
  let p = trusted_int_to_mut_i64_ptr(__bump_alloc(8))
  trusted_ptr_store_i64(p, 51)
  Test.assert_eq(trusted_ptr_load_i64(p), 51)
}

test "trusted_runtime_state_handler" {
  let got = handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
  Test.assert_eq(if got != 0 { 1 } else { 0 }, 1)
}

fn unsafe_call_target(x: i64) -> i64 { x + 1 }

test "trusted_raw_call_i64_handler" {
  let got = handle unsafe_raw_call_i64(fn_addr(unsafe_call_target), 41) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
  Test.assert_eq(got, 42)
}
