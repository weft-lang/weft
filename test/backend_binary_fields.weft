use compiler/backend/binary.{*}
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/num
use stdlib/option

-- test/backend_binary_fields.weft -- fixed-width container fields keep every
-- in-range value exactly; out-of-range values are refused by the exit roots
-- backend_binary_field_*_exit.
fn fields_code(values: Bytes) -> str {
  let mut code = ""
  let count = binary_bytes_len(values)
  for index in 0..count {
    let byte = values.get(__i64_to_usize(index)).unwrap_or(0)
    code = if index == 0 { i"{byte}" } else { i"{code} {byte}" }
  }
  code
}

test "unsigned fields are written least significant byte first at their width" {
  let mut out = byte_builder.new()
  binary_u8(out, 255)
  binary_u16(out, 65535)
  binary_u32(out, 16909060)
  binary_u64(out, 9223372036854775807)
  Test.assert_eq(binary_len(out), 15)
  Test.assert_str_eq(
    fields_code(out.finish()),
    "255 255 255 4 3 2 1 255 255 255 255 255 255 255 127"
  )
}

test "signed 32-bit fields use two's complement" {
  let mut out = byte_builder.new()
  binary_i32(out, 0 - 1)
  binary_i32(out, 0 - 2147483648)
  binary_i32(out, 2147483647)
  Test.assert_str_eq(fields_code(out.finish()), "255 255 255 255 0 0 0 128 255 255 255 127")
}

test "text fields are terminated or padded to their exact width" {
  let mut out = byte_builder.new()
  binary_cstring(out, "ab")
  binary_fixed_text(out, "__TEXT", 8)
  binary_fixed_text(out, "", 2)
  binary_fixed_text(out, "wide", 4)
  Test.assert_str_eq(
    fields_code(out.finish()),
    "97 98 0 95 95 84 69 88 84 0 0 0 0 119 105 100 101"
  )
}

test "zeros, padding and patches keep the layout exact" {
  let mut out = byte_builder.new()
  binary_u8(out, 1)
  binary_zeros(out, 3)
  binary_pad_to(out, 2)
  binary_pad_to(out, 8)
  binary_set_u32(out, 4, 4294967295)
  Test.assert_str_eq(fields_code(out.finish()), "1 0 0 0 255 255 255 255")
}
