-- Typed effect signatures are the ownership producer for handler clause
-- parameters. This matrix pins the physical parameter base, fixed-array
-- handle classification, residual managed dispatch, and verifier transport.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn managed_transport_metric_call_count_insts(insts: IrInstList, target_hash: i64, descend_clauses: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrCallI64(dst, callee_hash, args) -> if callee_hash == target_hash { 1 } else { 0 }
        IrHandleI64(dst, src, effect_hash, clauses, nclauses, abort_block) -> {
          if descend_clauses == 1 { managed_transport_metric_call_count_clauses(clauses, target_hash) } else { 0 }
        }
        IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> {
          if descend_clauses == 1 {
            managed_transport_metric_call_count_clauses(clauses, target_hash) + managed_transport_metric_call_count_deferred_body(body, target_hash)
          } else { 0 }
        }
        _ -> 0
      }
      here + managed_transport_metric_call_count_insts(rest, target_hash, descend_clauses)
    }
  }
}

fn managed_transport_metric_call_count_deferred_body(body: IrDeferredHandlerBody, target_hash: i64) -> i64 {
  match body {
    IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> managed_transport_metric_call_count_blocks(blocks, target_hash, 1)
    IrDeferredHandlerBodyInvalid(reason) -> 0
  }
}

fn managed_transport_metric_call_count_blocks(blocks: IrBlockList, target_hash: i64, descend_clauses: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> managed_transport_metric_call_count_insts(insts, target_hash, descend_clauses) + managed_transport_metric_call_count_blocks(rest, target_hash, descend_clauses)
    }
  }
}

fn managed_transport_metric_call_count_clauses(clauses: IrHandlerClauseBodyList, target_hash: i64) -> i64 {
  match clauses {
    IrHandlerClauseBodyNil -> 0
    IrHandlerClauseBodyCons(body, rest) -> match body {
      IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> managed_transport_metric_call_count_blocks(blocks, target_hash, 1) + managed_transport_metric_call_count_clauses(rest, target_hash)
      IrHandlerClauseBodyInvalid(reason) -> managed_transport_metric_call_count_clauses(rest, target_hash)
    }
  }
}

fn managed_transport_metric_call_count_function(functions: IrFunctionList, target_fn: i64, target_call: i64, descend_clauses: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_fn { managed_transport_metric_call_count_blocks(blocks, target_call, descend_clauses) }
        else { managed_transport_metric_call_count_function(rest, target_fn, target_call, descend_clauses) }
      }
    }
  }
}

fn managed_transport_metric_dispatch_count_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrPerformI64(dst, effect_hash, op_hash, args) -> 1
        IrHandlerDirectI64(dst, effect_hash, op_hash, depth, clause_index, args) -> 1
        _ -> 0
      }
      here + managed_transport_metric_dispatch_count_insts(rest)
    }
  }
}

fn managed_transport_metric_dispatch_count_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> managed_transport_metric_dispatch_count_insts(insts) + managed_transport_metric_dispatch_count_blocks(rest)
    }
  }
}

fn managed_transport_metric_dispatch_count_function(functions: IrFunctionList, target_fn: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_fn { managed_transport_metric_dispatch_count_blocks(blocks) }
        else { managed_transport_metric_dispatch_count_function(rest, target_fn) }
      }
    }
  }
}

fn managed_transport_metric_abort_result_kind_in_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrHandleI64(dst, src, effect_hash, clauses, nclauses, abort_block) -> match ir_handler_clause_body_list_nth(clauses, 0) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> result_cleanup_kind
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      _ -> managed_transport_metric_abort_result_kind_in_insts(rest)
    }
  }
}

fn managed_transport_metric_abort_result_kind_in_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let found = managed_transport_metric_abort_result_kind_in_insts(insts)
        if found != 0 { found } else { managed_transport_metric_abort_result_kind_in_blocks(rest) }
      }
    }
  }
}

fn managed_transport_metric_abort_result_kind_in_function(functions: IrFunctionList, target_fn: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_fn { managed_transport_metric_abort_result_kind_in_blocks(blocks) }
        else { managed_transport_metric_abort_result_kind_in_function(rest, target_fn) }
      }
    }
  }
}

fn managed_transport_metric_clause_transport_fact_in_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrHandleI64(dst, src, effect_hash, clauses, nclauses, abort_block) -> match ir_handler_clause_body_list_nth(clauses, 0) {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> result_cleanup_kind * 100 + transferred_param_value_fact
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      _ -> managed_transport_metric_clause_transport_fact_in_insts(rest)
    }
  }
}

fn managed_transport_metric_clause_transport_fact_in_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let found = managed_transport_metric_clause_transport_fact_in_insts(insts)
        if found != 0 { found } else { managed_transport_metric_clause_transport_fact_in_blocks(rest) }
      }
    }
  }
}

fn managed_transport_metric_clause_transport_fact_in_function(functions: IrFunctionList, target_fn: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_fn { managed_transport_metric_clause_transport_fact_in_blocks(blocks) }
        else { managed_transport_metric_clause_transport_fact_in_function(rest, target_fn) }
      }
    }
  }
}

fn managed_transport_metric_deferred_shape_in_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> match inst {
      IrDeferredHandleI64(dst, src, body, clauses, nclauses, effect_hash, scratch_base) -> {
        let body_captures = match body {
          IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> pipeline_capture_value_lane_count(captures)
          IrDeferredHandlerBodyInvalid(reason) -> 9
        }
        let clause_shape = match ir_handler_clause_body_list_nth(clauses, 0) {
          IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> pipeline_capture_value_lane_count(captures) * 100 + has_continuation * 10 + is_abortive
          IrHandlerClauseBodyInvalid(reason) -> 999
        }
        body_captures * 1000 + clause_shape
      }
      _ -> managed_transport_metric_deferred_shape_in_insts(rest)
    }
  }
}

fn managed_transport_metric_deferred_shape_in_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let found = managed_transport_metric_deferred_shape_in_insts(insts)
        if found != 0 { found } else { managed_transport_metric_deferred_shape_in_blocks(rest) }
      }
    }
  }
}

fn managed_transport_metric_deferred_shape_in_function(functions: IrFunctionList, target_fn: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> {
        if hash == target_fn { managed_transport_metric_deferred_shape_in_blocks(blocks) }
        else { managed_transport_metric_deferred_shape_in_function(rest, target_fn) }
      }
    }
  }
}

test "handler parameter release uses its physical clause base" {
  let params = nlist_new()
  nlist_add(params, node_new(0, 0, 0, ty_str(), 0))
  let drops = pipeline_managed_param_release_insts_at_with_borrow_mask(params, 0, 1, 7, 20, 0)
  match drops {
    IrInstCons(inst, rest) -> {
      match inst {
        IrCallI64(dst, callee_hash, args) -> {
          Test.assert_eq(dst, 20)
          Test.assert_eq(callee_hash, pipeline_rc_default_release_hash())
          Test.assert_eq(pipeline_ir_value_list_get_or(args, 0, 0 - 1), 7)
          Test.assert_eq(ir_inst_list_len(rest), 0)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "managed handler transport transfers one owned clause stake" {
  let src = "effect MetricEcho { fn echo(value: str) -> str } fn round(value: str) -> str { handle MetricEcho.echo(value) { MetricEcho.echo(arg) -> resume(arg) } } fn main() -> i64 { let value = round(\"x\") 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(ir)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(
    managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_retain_hash(), 1) * 10 +
      managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_release_hash(), 1),
    11
  )
  Test.assert_eq(managed_transport_metric_dispatch_count_function(functions, round_hash), 1)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
}

test "fixed arrays use one managed effect transport lane" {
  let src = "effect MetricArrayEcho<T> { fn echo(value: T) -> T } fn round(value: [str; 2]) -> [str; 2] { handle MetricArrayEcho<[str; 2]>.echo(value) { MetricArrayEcho<[str; 2]>.echo(arg) -> resume(arg) } } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let functions = pipeline_ir_functions(ir)
  let optimised_functions = pipeline_ir_functions(optimised)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(cg_managed_drop_kind_for_ty(ty_array(ty_str(), 2)), continuation_cleanup_kind_rc())
  Test.assert_eq(
    managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_retain_hash(), 1) * 10 +
      managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_release_hash(), 1),
    11
  )
  Test.assert_eq(
    managed_transport_metric_call_count_function(optimised_functions, round_hash, pipeline_rc_default_retain_hash(), 1) * 10 +
      managed_transport_metric_call_count_function(optimised_functions, round_hash, pipeline_rc_default_release_hash(), 1),
    11
  )
  Test.assert_eq(managed_transport_metric_dispatch_count_function(functions, round_hash), 1)
  Test.assert_eq(managed_transport_metric_clause_transport_fact_in_function(functions, round_hash), 102)
  Test.assert_eq(managed_transport_metric_clause_transport_fact_in_function(optimised_functions, round_hash), 102)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(pipeline_native_emit_error_count(pipeline_lower_native_module(typed, optimised)), 0)
}

test "deferred managed handler transport carries clause release" {
  let src = "effect MetricDeferredEcho { @deferred fn echo(value: str) -> str } fn round(value: str) -> str { handle MetricDeferredEcho.echo(value) { MetricDeferredEcho.echo(arg) with k -> arg } } fn main() -> i64 { let value = round(\"x\") 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let raw = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, raw)
  let functions = pipeline_ir_functions(raw)
  let optimised_functions = pipeline_ir_functions(optimised)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_retain_hash(), 1), 1)
  Test.assert_eq(managed_transport_metric_call_count_function(functions, round_hash, pipeline_rc_default_release_hash(), 1), 1)
  Test.assert_eq(managed_transport_metric_call_count_function(optimised_functions, round_hash, pipeline_rc_default_retain_hash(), 1), 1)
  Test.assert_eq(managed_transport_metric_call_count_function(optimised_functions, round_hash, pipeline_rc_default_release_hash(), 1), 1)
  Test.assert_eq(pipeline_ir_verify_module(raw), 0)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
}

test "abortive result carries its cleanup kind fact" {
  let src = "effect MetricStop { fn stop(value: str) -> str } fn round(value: str) -> str { handle MetricStop.stop(value) { MetricStop.stop(arg) -> arg } } fn main() -> i64 { let value = round(\"x\") 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let raw = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, raw)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(managed_transport_metric_abort_result_kind_in_function(pipeline_ir_functions(raw), round_hash), continuation_cleanup_kind_rc())
  Test.assert_eq(managed_transport_metric_abort_result_kind_in_function(pipeline_ir_functions(optimised), round_hash), continuation_cleanup_kind_rc())
}

test "exact managed clause result carries its transport fact" {
  let src = "type MetricProbe { } effect MetricProbeEcho { fn echo(value: MetricProbe) -> MetricProbe } fn round(value: MetricProbe) -> MetricProbe { handle MetricProbeEcho.echo(value) { MetricProbeEcho.echo(arg) -> resume(arg) } } fn main() -> i64 { 0 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let raw = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, raw)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(managed_transport_metric_clause_transport_fact_in_function(pipeline_ir_functions(raw), round_hash), 102)
  Test.assert_eq(managed_transport_metric_clause_transport_fact_in_function(pipeline_ir_functions(optimised), round_hash), 102)
}

test "handler-only managed captures stay out of the deferred body" {
  let src = "effect MetricCapture { @deferred fn get() -> i64 } fn round() -> i64 { let value = \"x\" handle MetricCapture.get() { MetricCapture.get() with k -> if value == \"x\" { k(1) } else { k(0) } } } fn main() -> i64 { round() }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let round_hash = str_hash(__str_ptr("round"), 0, __str_len("round"))
  Test.assert_eq(managed_transport_metric_deferred_shape_in_function(pipeline_ir_functions(ir), round_hash), 110)
}
