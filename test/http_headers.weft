use stdlib/bytes as bytes
use stdlib/http as http
use stdlib/http.{HttpHeader, HttpHeaders}
use stdlib/iter as iter
use stdlib/iter.{IntoIterator, Iterator}
use stdlib/option.{None, Option, Some}
use stdlib/result
use stdlib/string
use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}

fn header(name: str, value: str) -> HttpHeader {
  http.header(http.parse_field_name(name).unwrap(), bytes.from_str(value)).unwrap()
}

fn sample_headers() -> HttpHeaders {
  http.headers().append(
    header("X-Tag", "first".concat("!"))
  ).append(
    header("Other", "middle".concat("!"))
  ).append(header("x-tag", "last".concat("!")))
}

fn returned_cursor() -> owned Iterator<HttpHeader> {
  sample_headers().into_iter()
}

test "header collection observations use finite indices and preserve empty values" {
  let empty = http.headers()
  Test.assert_true(empty.is_empty())
  Test.assert_eq_usize(empty.len(), 0)
  match empty.get(0) { None -> nil Some(_) -> { Test.assert_true(false) nil } }
  let values = empty.append(header("X-Empty", ""))
  Test.assert_false(values.is_empty())
  Test.assert_eq_usize(values.len(), 1)
  Test.assert_true(empty.is_empty())
  let first = values.get(0).unwrap()
  Test.assert_str_eq(first.name().text(), "x-empty")
  Test.assert_str_eq(first.value().to_utf8().unwrap(), "")
}

test "header lookup rejects every out of range finite offset without narrowing" {
  let values = sample_headers()
  let offsets: [usize; 4] = [3, 4, 9223372036854775808, 18446744073709551615]
  for offset in offsets {
    match values.get(offset) { None -> nil Some(_) -> { Test.assert_true(false) nil } }
  }
  Test.assert_eq_usize(values.len(), 3)
  Test.assert_str_eq(values.get(2).unwrap().value().to_utf8().unwrap(), "last!")
}

test "header traversal preserves wire order and duplicate field names" {
  let values = sample_headers()
  let mut index: usize = 0
  for field in values {
    let indexed = values.get(index).unwrap()
    Test.assert_str_eq(field.name().text(), indexed.name().text())
    Test.assert_str_eq(field.value().to_utf8().unwrap(), indexed.value().to_utf8().unwrap())
    index = index + 1
  }
  Test.assert_eq_usize(index, 3)
  let tags = values
    |> iter.filter((field: HttpHeader) => field.name().text() == "x-tag")
    |> iter.count()
  Test.assert_eq_usize(tags, 2)
  Test.assert_eq_usize(iter.count(http.headers()), 0)
}

test "header iterators retain their source and exhaust once" {
  let mut cursor = returned_cursor()
  Test.assert_str_eq(cursor.next().unwrap().value().to_utf8().unwrap(), "first!")
  Test.assert_str_eq(cursor.next().unwrap().value().to_utf8().unwrap(), "middle!")
  Test.assert_str_eq(cursor.next().unwrap().value().to_utf8().unwrap(), "last!")
  match cursor.next() { None -> nil Some(_) -> { Test.assert_true(false) nil } }
  match cursor.next() { None -> nil Some(_) -> { Test.assert_true(false) nil } }
  cursor.close()
}

test "header iterators keep immutable snapshots across append" {
  let initial = sample_headers()
  let cursor = initial.into_iter()
  let extended = initial.append(header("x-tag", "added"))
  Test.assert_eq_usize(iter.count(cursor), 3)
  Test.assert_eq_usize(iter.count(extended), 4)
  Test.assert_eq_usize(iter.count(initial), 3)
}

fn close_headers_early() -> nil {
  let mut cursor = returned_cursor()
  cursor.next()
  cursor.close()
}

fn drop_headers_unstarted() -> nil {
  let cursor = returned_cursor()
  nil
}

test "closing early and dropping an unstarted header iterator release the source" {
  for _ in 0..50 { close_headers_early(); drop_headers_unstarted() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { close_headers_early(); drop_headers_unstarted() }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}

effect HeaderStop { fn stop() -> never }
type HeaderExit { Exhaust, Break, Return, Abort }

fn traverse_headers(exit: HeaderExit) -[HeaderStop]> usize {
  let mut visited: usize = 0
  for field in sample_headers() {
    if field.value().len() > 0 { visited = visited + 1 } else { nil }
    match exit {
      Exhaust -> nil
      Break -> break
      Return -> return visited
      Abort -> HeaderStop.stop()
    }
  }
  visited
}

fn run_traversal(exit: HeaderExit) -> usize {
  let stopped: usize = 7
  handle traverse_headers(exit) { HeaderStop.stop() -> stopped }
}

test "header traversal releases its cursor on exhaustion break return and abort" {
  Test.assert_eq_usize(run_traversal(Exhaust), 3)
  Test.assert_eq_usize(run_traversal(Break), 1)
  Test.assert_eq_usize(run_traversal(Return), 1)
  Test.assert_eq_usize(run_traversal(Abort), 7)
  for exit in [Exhaust, Break, Return, Abort] {
    for _ in 0..50 { run_traversal(exit) }
    let before = runtime_rc_test_heap_arena_offset()
    for _ in 0..200 { run_traversal(exit) }
    Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
  }
}

test "early header adapters close their unused tail" {
  Test.assert_eq_usize(sample_headers() |> iter.take(0) |> iter.count(), 0)
  Test.assert_eq_usize(sample_headers() |> iter.take(1) |> iter.count(), 1)
  for _ in 0..50 { sample_headers() |> iter.take(1) |> iter.count() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { sample_headers() |> iter.take(1) |> iter.count() }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}
