use stdlib/eq.{Eq}

type EqualityPoint { value: i64 }

type EqualityBox<T> { EqualityBox(T) }

type UnequalValue { value: i64 }

trait EqualityWitness { }

impl Eq for EqualityPoint {
  fn eq(self, other: Self) -> bool { self.value % 10 == other.value % 10 }
}

impl Eq for UnequalValue {
  fn eq(self, other: Self) -> bool { false }
}

impl<T: Eq> Eq for EqualityBox<T> {
  fn eq(self, other: Self) -> bool {
    match (self, other) { (EqualityBox(left), EqualityBox(right)) -> left == right }
  }
}

impl EqualityWitness for EqualityPoint { }

fn equality_generic<T: Eq>(left: T, right: T) -> bool { left == right }

fn inequality_generic<T: Eq>(left: T, right: T) -> bool { left != right }

fn equality_multibound<T: EqualityWitness & Eq>(left: T, right: T) -> bool { left == right }

test "equality uses the declared relation for separate values" {
  let left = EqualityPoint { value: 1 }
  let equal = EqualityPoint { value: 11 }
  let different = EqualityPoint { value: 2 }
  Test.assert_true(left == equal)
  Test.assert_true(not (left == different))
  Test.assert_true(not (left != equal))
  Test.assert_true(left != different)
  Test.assert_true(left.eq(equal))
}

test "identity does not bypass a declared equality relation" {
  let value = UnequalValue { value: 1 }
  Test.assert_true(not (value == value))
  Test.assert_true(value != value)
}

test "generic equality and inequality preserve exact trait dispatch" {
  let left = EqualityPoint { value: 1 }
  let equal = EqualityPoint { value: 11 }
  Test.assert_true(equality_generic(left, equal))
  Test.assert_true(not inequality_generic(left, equal))
  Test.assert_true(equality_multibound(left, equal))
}

test "generic implementations compare their values through Eq" {
  let left: EqualityBox<EqualityPoint> = EqualityBox(EqualityPoint { value: 1 })
  let equal: EqualityBox<EqualityPoint> = EqualityBox(EqualityPoint { value: 11 })
  let different: EqualityBox<EqualityPoint> = EqualityBox(EqualityPoint { value: 2 })
  Test.assert_true(left == equal)
  Test.assert_true(left != different)
}
