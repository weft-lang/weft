-- Expected exit code: 42
use stdlib/display.{*}
-- Stress test: ~200 lines of diverse Weft constructs

type Option {
  Some(i64),
  None
}

type Result {
  Ok(i64),
  Err(str)
}

type List {
  Cons(i64),
  Nil
}

type Pair {
  x: i64,
  y: i64
}

type Color {
  Red,
  Green,
  Blue,
  Custom(i64)
}

trait Eq {
  fn eq(a: i64, b: i64) -> bool
}

trait Show {
  fn show(x: i64) -> str
}

trait Ord {
  fn lt(a: i64, b: i64) -> bool
  fn gt(a: i64, b: i64) -> bool
  fn lte(a: i64, b: i64) -> bool
  fn gte(a: i64, b: i64) -> bool
}

impl Eq for i64 {
  fn eq(a: i64, b: i64) -> bool {
    a == b
  }
}

impl Show for i64 {
  fn show(x: i64) -> str {
    "todo"
  }
}

effect Console {
  fn print(msg: str) -> nil
  fn read() -> str
}

effect State {
  fn get() -> i64
  fn put(val: i64) -> nil
}

effect Error {
  fn raise(msg: str) -> nil
}

fn identity(x: i64) -> i64 {
  x
}

fn add(a: i64, b: i64) -> i64 {
  a + b
}

fn sub(a: i64, b: i64) -> i64 {
  a - b
}

fn mul(a: i64, b: i64) -> i64 {
  a * b
}

fn div(a: i64, b: i64) -> i64 {
  a / b
}

fn negate(x: i64) -> i64 {
  -x
}

fn abs(x: i64) -> i64 {
  if x < 0 {
    -x
  } else {
    x
  }
}

fn max(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn min(a: i64, b: i64) -> i64 {
  if a < b { a } else { b }
}

fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
  max(lo, min(x, hi))
}

fn fib(n: i64) -> i64 {
  if n <= 1 {
    n
  } else {
    add(fib(sub(n, 1)), fib(sub(n, 2)))
  }
}

fn factorial(n: i64) -> i64 {
  if n <= 0 {
    1
  } else {
    mul(n, factorial(sub(n, 1)))
  }
}

fn compose(f: (i64) -> i64, g: (i64) -> i64, x: i64) -> i64 {
  x |> f() |> g()
}

fn apply_twice(f: (i64) -> i64, x: i64) -> i64 {
  x |> f() |> f()
}

fn classify(x: i64) -> str {
  match x {
    0 -> "zero",
    1 -> "one",
    _ -> "other"
  }
}

fn safe_div(a: i64, b: i64) -> i64 {
  if b == 0 {
    0
  } else {
    a / b
  }
}

fn is_even(n: i64) -> bool {
  n % 2 == 0
}

fn is_positive(n: i64) -> bool {
  n > 0
}

fn complex_expr(a: i64, b: i64, c: i64) -> i64 {
  a * b + c * (a - b) / (c + 1)
}

fn nested_calls(x: i64) -> i64 {
  add(mul(x, 2), sub(x, 1))
}

fn chain_ops(x: i64) -> i64 {
  x |> add(1) |> mul(3)
}

fn list_ops() -> i64 {
  let xs = [1, 2, 3, 4, 5]
  let ys = [6, 7, 8]
  let empty = []
  42
}

fn lambda_test() -> i64 {
  let f = x => x + 1
  let g = y => y * 2
  let h = z => if z > 0 { z } else { -z }
  42
}

fn match_test(x: i64) -> i64 {
  match x {
    0 -> 0,
    1 -> 1,
    _ -> x + 1
  }
}

fn let_chain() -> i64 {
  let a = 1
  let b = 2
  let c = a + b
  let d = c * 2
  d
}

fn bool_logic(a: bool, b: bool) -> bool {
  a and b or a
}

fn comparison_chain(x: i64, y: i64, z: i64) -> bool {
  x < y and y < z
}

fn field_access_test(p: Pair) -> i64 {
  p.x + p.y
}



type Maybe<T> {
  Just(T),
  Nothing
}

type Either<L, R> {
  Left(L),
  Right(R)
}

fn greet(name: str) -[Console]> str {
  "hello"
}

fn apply(f: (i64) -> i64, x: i64) -> i64 {
  f(x)
}

fn make_pair() -> Pair {
  Pair { x: 1, y: 2 }
}

fn update_pair(p: Pair) -> Pair {
  Pair { x: 42, y: p.y }
}

fn interp_test() -> str {
  let name = "world"
  "hello {name}!"
}


fn main() -> i64 {
  -- fib(10) = 55, odd -> negate(55) + 97 = 42
  let result = fib(10)
  let check = is_even(result)
  if check {
    result
  } else {
    negate(result) + 97
  }
}
