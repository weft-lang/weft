-- Stress test: ~200 lines of diverse Weft constructs

type Option {
  Some(Int),
  None
}

type Result {
  Ok(Int),
  Err(String)
}

type List {
  Cons(Int),
  Nil
}

type Pair {
  x: Int,
  y: Int
}

type Color {
  Red,
  Green,
  Blue,
  Custom(Int)
}

trait Eq {
  fn eq(a: Int, b: Int) -> Bool
}

trait Show {
  fn show(x: Int) -> String
}

trait Ord {
  fn lt(a: Int, b: Int) -> Bool,
  fn gt(a: Int, b: Int) -> Bool,
  fn lte(a: Int, b: Int) -> Bool,
  fn gte(a: Int, b: Int) -> Bool
}

impl Eq<Int> {
  fn eq(a: Int, b: Int) -> Bool {
    a == b
  }
}

impl Show<Int> {
  fn show(x: Int) -> String {
    "todo"
  }
}

effect Console {
  fn print(msg: String) -> Nil,
  fn read() -> String
}

effect State {
  fn get() -> Int,
  fn put(val: Int) -> Nil
}

effect Error {
  fn raise(msg: String) -> Nil
}

fn identity(x: Int) -> Int {
  x
}

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn sub(a: Int, b: Int) -> Int {
  a - b
}

fn mul(a: Int, b: Int) -> Int {
  a * b
}

fn div(a: Int, b: Int) -> Int {
  a / b
}

fn negate(x: Int) -> Int {
  -x
}

fn abs(x: Int) -> Int {
  if x < 0 {
    -x
  } else {
    x
  }
}

fn max(a: Int, b: Int) -> Int {
  if a > b { a } else { b }
}

fn min(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

fn clamp(x: Int, lo: Int, hi: Int) -> Int {
  max(lo, min(x, hi))
}

fn fib(n: Int) -> Int {
  if n <= 1 {
    n
  } else {
    add(fib(sub(n, 1)), fib(sub(n, 2)))
  }
}

fn factorial(n: Int) -> Int {
  if n <= 0 {
    1
  } else {
    mul(n, factorial(sub(n, 1)))
  }
}

fn compose(f: Int, g: Int) -> Int {
  f |> g
}

fn apply_twice(f: Int, x: Int) -> Int {
  x |> f |> f
}

fn classify(x: Int) -> String {
  match x {
    0 -> "zero",
    1 -> "one",
    _ -> "other"
  }
}

fn safe_div(a: Int, b: Int) -> Int {
  if b == 0 {
    0
  } else {
    a / b
  }
}

fn is_even(n: Int) -> Bool {
  n % 2 == 0
}

fn is_positive(n: Int) -> Bool {
  n > 0
}

fn complex_expr(a: Int, b: Int, c: Int) -> Int {
  a * b + c * (a - b) / (c + 1)
}

fn nested_calls(x: Int) -> Int {
  add(mul(x, 2), sub(x, 1))
}

fn chain_ops(x: Int) -> Int {
  x |> add(1, 2) |> mul(3, 4)
}

fn list_ops() -> Int {
  let xs = [1, 2, 3, 4, 5]
  let ys = [6, 7, 8]
  let empty = []
  42
}

fn lambda_test() -> Int {
  let f = x => x + 1
  let g = y => y * 2
  let h = z => if z > 0 { z } else { -z }
  42
}

fn match_test(x: Int) -> Int {
  match x {
    0 -> 0,
    1 -> 1,
    _ -> x + 1
  }
}

fn let_chain() -> Int {
  let a = 1
  let b = 2
  let c = a + b
  let d = c * 2
  d
}

fn bool_logic(a: Bool, b: Bool) -> Bool {
  a and b or a
}

fn comparison_chain(x: Int, y: Int, z: Int) -> Bool {
  x < y and y < z
}

fn field_access_test(p: Pair) -> Int {
  p.x + p.y
}

fn chained_field(r: Int) -> Int {
  r.x.y.z
}

type Maybe<T> {
  Just(T),
  Nothing
}

type Either<L, R> {
  Left(L),
  Right(R)
}

fn greet(name: String) -[Console]> String {
  "hello"
}

fn apply(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}

fn make_pair() -> Pair {
  {x: 1, y: 2}
}

fn update_pair(p: Pair) -> Pair {
  {p | x: 42}
}

fn interp_test() -> String {
  let name = "world"
  "hello {name}!"
}

use std

fn main() {
  let result = fib(10)
  let check = is_even(result)
  if check {
    result
  } else {
    negate(result)
  }
}
