use "runtime/alloc.weft"
use "runtime/memory.weft"
-- Test memory intrinsics: write "Hi" to stdout via byte buffer
-- Expected: prints "Hi" to stdout, exits 42

use "runtime/syscall.weft"

fn main() -> i64 {
  let arena = arena_new(128)
  let buf = arena_alloc(arena, 64, 8)
  mem_store8(buf, 72)
  mem_store8(buf + 1, 105)
  sys_write(1, buf, 2)
  arena_free(arena)
  42
}
