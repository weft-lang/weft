-- Test memory intrinsics: write "Hi" to stdout via byte buffer
-- Expected: prints "Hi" to stdout, exits 42

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

fn main() -> i64 {
  let buf = __bump_alloc(64)
  __mem_store8(buf, 72)
  __mem_store8(buf + 1, 105)
  sys_write(1, buf, 2)
  42
}
