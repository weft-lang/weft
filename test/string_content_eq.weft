-- test/string_content_eq.weft -- == / != on str is CONTENT equality (2u)
--
-- Before 2u, str == compiled to a pointer comparison and inconsistent
-- literal pooling made "a" == "a" program-dependent. The lowering is
-- nil-safe: identity decides first (nil == nil), either side nil is
-- inequality against any str, and union-typed (str | nil) operands take
-- the same path. Comparisons against the nil LITERAL stay identity
-- guards (that is what flow narrowing consumes).

use "stdlib/string.weft"

fn eq_params(a: str, b: str) -> i64 {
  if a == b { 1 } else { 0 }
}

fn eq_nilable(a: str | nil, b: str | nil) -> i64 {
  if a == b { 1 } else { 0 }
}

test "str_literal_content_equality" {
  Test.assert_eq(eq_params("hello", "hello"), 1)
  Test.assert_eq(eq_params("hello", "world"), 0)
  Test.assert_eq(eq_params("hi", "hello"), 0)
  Test.assert_eq(eq_params("", ""), 1)
}

test "str_let_bound_content_equality" {
  let a = "same!"
  let b = "same!"
  let c = "other"
  Test.assert_eq(eq_params(a, b), 1)
  Test.assert_eq(eq_params(a, c), 0)
}

test "str_ne_is_content_inequality" {
  let ne1 = if "abc" != "def" { 1 } else { 0 }
  let ne2 = if "abc" != "abc" { 1 } else { 0 }
  Test.assert_eq(ne1, 1)
  Test.assert_eq(ne2, 0)
}

test "str_concat_result_content_equality" {
  let joined = str_concat("con", "cat")
  Test.assert_eq(eq_params(joined, "concat"), 1)
}

test "nilable_str_equality_matrix" {
  Test.assert_eq(eq_nilable(nil, nil), 1)
  Test.assert_eq(eq_nilable("abc", nil), 0)
  Test.assert_eq(eq_nilable(nil, "abc"), 0)
  Test.assert_eq(eq_nilable("abc", "abc"), 1)
  Test.assert_eq(eq_nilable("abc", "abd"), 0)
}

test "nil_literal_guard_stays_identity" {
  let x: str | nil = "seven77"
  let is_present = if x != nil { 1 } else { 0 }
  Test.assert_eq(is_present, 1)
  let y: str | nil = nil
  let is_absent = if y == nil { 1 } else { 0 }
  Test.assert_eq(is_absent, 1)
}

-- Regression (2026-08-03): the CFG binop lowering variants (used when
-- the compare sits under loop/branch block lowering) skipped the
-- content-eq selection, so str == inside a while body compiled to
-- pointer identity — always false for distinct descriptors. All binop
-- lowering sites must make the same selection.

fn eq_in_while_params(s: str, t: str) -> i64 {
  let mut i = 0
  let mut c = 7
  while i < 3 {
    if s == t { c = c + 1 } else { 0 }
    i = i + 1
  }
  c
}

fn ne_in_while_params(s: str, t: str) -> i64 {
  let mut i = 0
  let mut c = 7
  while i < 3 {
    if s != t { c = c + 1 } else { 0 }
    i = i + 1
  }
  c
}

fn eq_in_while_cond(s: str, t: str) -> i64 {
  let mut i = 0
  while s == t {
    i = i + 1
    if i == 3 { return i } else { 0 }
  }
  i
}

test "str_eq_in_while_body_params" {
  Test.assert_eq(eq_in_while_params("abc", "abc"), 10)
  Test.assert_eq(eq_in_while_params("abc", "abd"), 7)
  Test.assert_eq(eq_in_while_params("", ""), 10)
}

test "str_ne_in_while_body_params" {
  Test.assert_eq(ne_in_while_params("abc", "abd"), 10)
  Test.assert_eq(ne_in_while_params("abc", "abc"), 7)
}

test "str_eq_in_while_body_locals" {
  let s = "same!"
  let t = "same!"
  let u = "other"
  let mut i = 0
  let mut c = 0
  while i < 4 {
    if s == t { c = c + 1 } else { 0 }
    if s == u { c = c + 100 } else { 0 }
    i = i + 1
  }
  Test.assert_eq(c, 4)
}

test "str_eq_in_while_condition" {
  Test.assert_eq(eq_in_while_cond("go", "go"), 3)
  Test.assert_eq(eq_in_while_cond("go", "no"), 0)
}

test "str_eq_in_nested_loop_branch" {
  let mut i = 0
  let mut hits = 0
  while i < 2 {
    let mut j = 0
    while j < 2 {
      if "k1" == "k1" {
        if "v2" != "v1" { hits = hits + 1 } else { 0 }
      } else { 0 }
      j = j + 1
    }
    i = i + 1
  }
  Test.assert_eq(hits, 4)
}
