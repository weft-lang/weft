use module_fixtures/g4_opaque_left.{ImportedBorrowEffect, Same as ImportedBorrowToken, inspect_borrowed as inspect_imported_borrow, make_owned as make_imported_borrow, perform_borrowed as perform_imported_borrow}
use stdlib/drop.{*}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}

type BorrowSurfaceToken = opaque i64

impl Drop for BorrowSurfaceToken {
  fn drop(self) -> nil { nil }
}

type BorrowNestedToken = opaque i64

type BorrowNestedState {
  BorrowNestedEmpty,
  BorrowNestedFull(owned BorrowNestedToken)
}

type BorrowNestedBox = opaque BorrowNestedState

impl Drop for BorrowNestedToken {
  fn drop(self) -> i64 {
    match self {
      BorrowNestedToken(log) -> defer_order_log_write(log, defer_order_log_read(log) * 10 + 1)
    }
  }
}

impl Drop for BorrowNestedBox {
  fn drop(self) -> i64 {
    match self {
      BorrowNestedBox(state) -> match state {
        BorrowNestedEmpty -> 0
        BorrowNestedFull(token) -> token.drop()
      }
    }
  }
}

fn borrow_nested_read(token: borrow BorrowNestedToken) -> i64 { 9 }

fn borrow_nested_value(box: borrow BorrowNestedBox) -> i64 {
  match box {
    BorrowNestedBox(state) -> match state {
      BorrowNestedEmpty -> 0
      BorrowNestedFull(token) -> borrow_nested_read(token)
    }
  }
}

fn borrow_nested_consume(box: owned BorrowNestedBox) -> i64 { box.drop() }

trait BorrowSurfaceInspect {
  fn inspect(self: borrow Self) -> i64
}

impl BorrowSurfaceInspect for BorrowSurfaceToken {
  fn inspect(self: borrow Self) -> i64 { 11 }
}

impl BorrowSurfaceToken {
  fn mutate(self: borrow mut Self) -> i64 { 22 }
}

effect BorrowSurfaceEffect {
  fn inspect(token: borrow BorrowSurfaceToken) -> i64
  fn mutate(token: borrow mut BorrowSurfaceToken) -> i64
}

effect BorrowScopedHandler {
  fn mutate() -> i64
}

fn borrow_scoped_handler(
  token: borrow BorrowSurfaceToken
) -> i64 {
  handle BorrowScopedHandler.mutate() {
    BorrowScopedHandler.mutate() -> resume(shared_borrow_surface(token))
  }
}

fn borrow_surface_effect_inspect(token: borrow BorrowSurfaceToken) -[BorrowSurfaceEffect]> i64 {
  BorrowSurfaceEffect.inspect(token)
}

fn borrow_surface_effect_mutate(token: borrow mut BorrowSurfaceToken) -[BorrowSurfaceEffect]> i64 {
  BorrowSurfaceEffect.mutate(token)
}

fn borrow_surface_effect_apply(f: (borrow BorrowSurfaceToken) -[BorrowSurfaceEffect]> i64, token: borrow BorrowSurfaceToken) -[BorrowSurfaceEffect]> i64 {
  f(token)
}

fn imported_borrow_effect_apply(f: (borrow ImportedBorrowToken) -[ImportedBorrowEffect]> i64, token: borrow ImportedBorrowToken) -[ImportedBorrowEffect]> i64 {
  f(token)
}

fn shared_borrow_surface(token: borrow BorrowSurfaceToken) -> i64 { 11 }

fn exclusive_borrow_surface(token: borrow mut BorrowSurfaceToken) -> i64 { 22 }

fn borrow_surface_project(token: borrow BorrowSurfaceToken) -> i64 {
  match token { BorrowSurfaceToken(value) -> value }
}

fn borrow_surface_rebind(token: borrow BorrowSurfaceToken) -> i64 {
  match token { alias -> shared_borrow_surface(alias) }
}

fn borrow_surface_new(value: i64) -> owned BorrowSurfaceToken {
  BorrowSurfaceToken(value)
}

fn borrow_surface_consume(token: owned BorrowSurfaceToken) -> i64 { 1 }

fn borrow_surface_pair(left: borrow BorrowSurfaceToken, right: borrow BorrowSurfaceToken) -> i64 { 2 }

fn borrow_surface_generic<T>(token: borrow T) -> i64 { 3 }

fn borrow_surface_apply(f: (borrow BorrowSurfaceToken) -> i64, token: owned BorrowSurfaceToken) -> i64 {
  let first = f(token)
  first + borrow_surface_consume(token)
}

type BorrowCleanupToken = opaque i64

impl Drop for BorrowCleanupToken {
  fn drop(self: i64) -> i64 {
    defer_order_log_write(self, defer_order_log_read(self) * 10 + 1)
  }
}

effect BorrowCleanupStop {
  fn stop() -> never
}

effect BorrowCleanupEffectStop {
  fn stop(token: borrow BorrowCleanupToken) -> never
}

fn borrow_cleanup_new(log: i64) -> owned BorrowCleanupToken { BorrowCleanupToken(log) }
fn borrow_cleanup_read(token: borrow BorrowCleanupToken) -> i64 { 41 }
fn borrow_cleanup_consume(token: owned BorrowCleanupToken) -> i64 { 42 }

fn borrow_cleanup_normal(log: i64) -> i64 {
  let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
}

fn borrow_cleanup_early_return(log: i64) -> i64 {
  let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
  return 42
}

fn borrow_cleanup_continue(log: i64) -> i64 {
  let mut index = 0
  while index < 3 {
    let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
    borrow_cleanup_read(token)
    index = index + 1
    continue
  }
  42
}

fn borrow_cleanup_break(log: i64) -> i64 {
  loop {
    let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
    borrow_cleanup_read(token)
    break
  }
  42
}

fn borrow_cleanup_abort(log: i64) -[BorrowCleanupStop]> i64 {
  let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
  BorrowCleanupStop.stop()
}

fn borrow_cleanup_effect_abort(log: i64) -[BorrowCleanupEffectStop]> i64 {
  let token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  BorrowCleanupEffectStop.stop(token)
}

fn borrow_cleanup_mut_normal(log: i64) -> i64 {
  let mut token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
}

fn borrow_cleanup_mut_early_return(log: i64) -> i64 {
  let mut token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
  return 42
}

fn borrow_cleanup_mut_replace(log: i64) -> i64 {
  let mut token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  token = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
}

fn borrow_cleanup_mut_abort(log: i64) -[BorrowCleanupStop]> i64 {
  let mut token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_read(token)
  BorrowCleanupStop.stop()
}

fn borrow_cleanup_mut_consume(log: i64) -> i64 {
  let mut token: owned BorrowCleanupToken = borrow_cleanup_new(log)
  borrow_cleanup_consume(token)
}

test "owned_resource_borrow_surface_declarations_compile" {
  Test.assert_eq(11 + 22, 33)
}

test "shared borrows are reusable before one consuming use" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let first = shared_borrow_surface(token)
  let second = shared_borrow_surface(token)
  Test.assert_eq(first + second + borrow_surface_consume(token), 23)
}

test "exclusive borrows require and reuse a mutable owner" {
  let mut token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let first = exclusive_borrow_surface(token)
  let second = exclusive_borrow_surface(token)
  Test.assert_eq(first + second + borrow_surface_consume(token), 45)
}

test "multiple shared borrows of one owner coexist in one call" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  Test.assert_eq(borrow_surface_pair(token, token) + borrow_surface_consume(token), 3)
}

test "generic borrow contracts infer and substitute their inner type" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let inferred = borrow_surface_generic(token)
  let explicit = borrow_surface_generic<BorrowSurfaceToken>(token)
  Test.assert_eq(inferred + explicit + borrow_surface_consume(token), 7)
}

test "borrow contracts survive exact function values" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let inspect: (borrow BorrowSurfaceToken) -> i64 = shared_borrow_surface
  Test.assert_eq(inspect(token) + borrow_surface_consume(token), 12)
}

test "borrowed method receivers are reusable before one consuming use" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let first = token.inspect()
  let second = token.inspect()
  Test.assert_eq(first + second + borrow_surface_consume(token), 23)
}

test "borrowed resources preserve private projection and rebinding" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  Test.assert_eq(borrow_surface_project(token) + borrow_surface_rebind(token) + borrow_surface_consume(token), 19)
}

test "borrowed nested resource patterns never acquire cleanup ownership" {
  let log = defer_order_log_new()
  let box: owned BorrowNestedBox = BorrowNestedBox(
    BorrowNestedFull(BorrowNestedToken(log))
  )
  Test.assert_eq(borrow_nested_value(box), 9)
  Test.assert_eq(borrow_nested_value(box), 9)
  Test.assert_eq(defer_order_log_read(log), 0)
  Test.assert_eq(borrow_nested_consume(box), 0)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "exclusive method receivers use mutable owners" {
  let mut token: owned BorrowSurfaceToken = borrow_surface_new(7)
  Test.assert_eq(token.mutate() + token.mutate() + borrow_surface_consume(token), 45)
}

test "borrow parameters can forward their contract" {
  let forward = (token: borrow BorrowSurfaceToken) => shared_borrow_surface(token) + shared_borrow_surface(token)
  Test.assert_eq(borrow_surface_apply(forward, borrow_surface_new(7)), 23)
}

test "effect handlers receive and forward shared resource borrows" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let result = handle borrow_surface_effect_inspect(token) {
    BorrowSurfaceEffect.inspect(value) -> resume(shared_borrow_surface(value))
    BorrowSurfaceEffect.mutate(value) -> resume(exclusive_borrow_surface(value))
  }
  Test.assert_eq(result + borrow_surface_consume(token), 12)
}

test "effect handlers receive and forward exclusive resource borrows" {
  let mut token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let result = handle borrow_surface_effect_mutate(token) {
    BorrowSurfaceEffect.inspect(value) -> resume(shared_borrow_surface(value))
    BorrowSurfaceEffect.mutate(value) -> resume(exclusive_borrow_surface(value))
  }
  Test.assert_eq(result + borrow_surface_consume(token), 23)
}

test "immediate handler captures borrow for lexical dynamic extent" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let result = borrow_scoped_handler(token)
  Test.assert_eq(result + borrow_surface_consume(token), 12)
}

test "borrow effect contracts survive exact function values" {
  let token: owned BorrowSurfaceToken = borrow_surface_new(7)
  let result = handle borrow_surface_effect_apply(borrow_surface_effect_inspect, token) {
    BorrowSurfaceEffect.inspect(value) -> resume(shared_borrow_surface(value))
    BorrowSurfaceEffect.mutate(value) -> resume(exclusive_borrow_surface(value))
  }
  Test.assert_eq(result + borrow_surface_consume(token), 12)
}

test "imported opaque borrow identity crosses effects and exact function values" {
  let log = defer_order_log_new()
  let token: owned ImportedBorrowToken = make_imported_borrow(log)
  let result = handle imported_borrow_effect_apply(perform_imported_borrow, token) {
    ImportedBorrowEffect.inspect(value) -> resume(inspect_imported_borrow(value))
  }
  Test.assert_eq(result, 303)
  Test.assert_eq(defer_order_log_read(log), 0)
}

test "borrow-only scope drops its owner exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_normal(log), 41)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "borrow-only owner cleanup survives early return" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_early_return(log), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "borrow-only owner cleanup survives continue" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_continue(log), 42)
  Test.assert_eq(defer_order_log_read(log), 111)
}

test "borrow-only owner cleanup survives break" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_break(log), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "borrow-only owner cleanup survives handler abort" {
  let log = defer_order_log_new()
  let result = handle borrow_cleanup_abort(log) {
    BorrowCleanupStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "mutable borrow-only scope drops its final owner exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_mut_normal(log), 41)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "mutable borrow-only owner cleanup survives early return" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_mut_early_return(log), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "mutable owned assignment drops replacement and final values once" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_mut_replace(log), 41)
  Test.assert_eq(defer_order_log_read(log), 11)
}

test "mutable borrow-only owner cleanup survives handler abort" {
  let log = defer_order_log_new()
  let result = handle borrow_cleanup_mut_abort(log) {
    BorrowCleanupStop.stop() -> 42
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "mutable consumed owner is not dropped twice at scope exit" {
  let log = defer_order_log_new()
  Test.assert_eq(borrow_cleanup_mut_consume(log), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "borrowed effect abort adds no borrower cleanup" {
  let log = defer_order_log_new()
  let result = handle borrow_cleanup_effect_abort(log) {
    BorrowCleanupEffectStop.stop(token) -> borrow_cleanup_read(token) + 1
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}
