use stdlib/test.{Test}

trait AssociatedBuilder {
  type Item
  fn build(item: Self.Item, adjustment: i64) -> Self
}

type AssociatedBox {
  value: i64
}

impl AssociatedBuilder for AssociatedBox {
  type Item = i64

  fn build(item: i64, adjustment: i64) -> Self {
    AssociatedBox { value: item + adjustment }
  }
}

fn build_generic<C: AssociatedBuilder & {type Item = i64}>(item: i64, adjustment: i64) -> C {
  C.build(item, adjustment)
}

test "associated functions accept ordinary parameters" {
  let concrete = AssociatedBox.build(40, 2)
  Test.assert_eq(concrete.value, 42)
}

test "associated functions dispatch through a trait-bound type" {
  let generic = build_generic<AssociatedBox>(39, 3)
  Test.assert_eq(generic.value, 42)
}

test "associated function arguments may contain control flow" {
  let selected = AssociatedBox.build(if true { 41 } else { 0 }, 1)
  Test.assert_eq(selected.value, 42)
}
