      Test.assert_true(
        match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          hidden_receiver,
          "show"
        ) {
          SemanticImplementationMethodSelectionMissing -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "generic signature bounds select exact trait method declarations" {
  let module = registered(
    "trait Show { fn show(self) -> str } fn render<T: Show>(value: T) -> str { \"\" }"
  )
  let scope = scope_for(module)
