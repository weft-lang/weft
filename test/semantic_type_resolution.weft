      let catalog = product.catalog()
      let methods = product.methods()
      let signature = semantic_signature_named(product, "render")
      let signatures = product.signatures()
      let bound = signatures.bound_at(signature, 0)
      let graph = catalog_graph(catalog, bound.trait_atom)
      match semantic_type_graph_node(graph, bound.trait_atom) {
        SemanticTraitNode(declaration, _) -> match semantic_trait_method_select(
          methods,
          declaration,
          "show"
        ) {
          SemanticTraitMethodSelected(method, method_signature) -> {
            Test.assert_str_eq(declaration_identity_name(method).text().unwrap(), "show")
            let method_graph = catalog_graph(catalog, method_signature)
            Test.assert_true(
              match semantic_type_graph_node(
                method_graph,
                method_signature
              ) {
                SemanticFunctionNode(_, _, _) -> true
                _ -> false
              }
            )
          }
          _ -> Test.assert_true(false)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

fn registered_as(text: str, path: str) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(
    parsed.declarations,
    parsed.source.source(),
    named_module_identity(path, 73)
  )
}

test "each module resolves the effects shared method walks reach through its own declarations" {
  -- `Tick` is declared where no signature names it; only another module's
  -- method performs it, and only its operation reaches `Stamp`.
  let home = registered_as(
    "pub type Stamp { at: i64 } pub effect Tick { fn tick(stamp: Stamp) -> nil }",
    "fixture/effect_home"
  )
  let clock = registered_as(
    "use effect_home as home pub type Clock { hour: i64 } "
      |> str_concat("impl Clock { fn advance(self) -[home.Tick]> nil { nil } }"),
    "fixture/effect_clock"
  )
  let consumer = registered_as(
    "use effect_clock as clock fn run(value: clock.Clock) -> i64 { 0 }",
    "fixture/effect_consumer"
  )
  let edges = [
    registration_scope.resolved_import(
      clock,
      clock.syntax.imports.first().unwrap(),
      home.identity,
      false
    ),
    registration_scope.resolved_import(
      consumer,
      consumer.syntax.imports.first().unwrap(),
      clock.identity,
      false
    ),
  ]
  let modules = [consumer, clock, home]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(edges[..])
  )
  let tick = registration_scope.registration_scope_find_declaration(
    scope,
    home.identity,
    EffectDeclaration,
    "Tick"
  ).unwrap().identity
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(shared) -> {
      -- The root declares no effect, so it resolves none.
      let root_effects = shared.effect_applications()
      Test.assert_true(
        match semantic_effect_application_for_declaration(root_effects, tick) {
          SemanticEffectApplicationSelectionMissing -> true
          _ -> false
        }
      )
      match resolve_module_semantics_with_shared(home, scope, shared) {
        SemanticResolutionAccepted(product) -> {
          let catalog = product.catalog()
          let effects = product.effect_applications()
          let records = product.applications()
          match semantic_effect_application_for_declaration(effects, tick) {
            SemanticEffectApplicationSelected(atom) ->
              match semantic_effect_application_parameter_type(
                effects,
                catalog,
                atom,
                "tick",
                0
              ) {
                Some(stamp) -> Test.assert_true(
                  match semantic_declared_field_projection(records, catalog, stamp, "at") {
                    SemanticDeclaredFieldProjected(_, 0, _) -> true
                    _ -> false
                  }
                )
                None -> Test.assert_str_eq("tick parameter", "present")
              }
            _ -> Test.assert_str_eq("Tick application", "selected")
          }
        }
        _ -> Test.assert_str_eq("effect home resolution", "accepted")
      }
    }
    _ -> Test.assert_str_eq("root resolution", "accepted")
  }
}

-- `count` functions `f0` to `f{count - 1}`, each with its own result type.
fn numbered_functions(count: i64) -> str {
  let mut text = ""
  let mut index = 0
  while index < count {
    let result = if index % 2 == 0 { "i64" } else { "bool" }
    let value = if index % 2 == 0 { "0" } else { "true" }
    text = str_concat(text, i"fn f{index}() -> {result} {{ {value} }} ")
    index = index + 1
  }
  text
}

test "signature products find own and resolved external signatures by identity" {
  let dependency = registered_as(
    str_concat("pub fn helper(value: i64) -> bool { true } ", numbered_functions(3)),
    "fixture/signature_dependency"
  )
  let consumer = registered_as(
    str_concat("use signature_dependency as dep ", numbered_functions(40)),
    "fixture/signature_consumer"
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let scope = registration_scope.registration_scope_build(
    modules2(consumer, dependency),
    imports1(edge)
  )
  let helper = DeclaredFunctionIdentity(
    registration_scope.registration_scope_find_declaration(
      scope,
      dependency.identity,
      ValueDeclaration,
      "helper"
    ).unwrap().identity
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(product) -> {
      let signatures = product.signatures()
      -- Every own function is found as itself.
      let mut found = 0
      let mut index: usize = 0
      while index < signatures.len() {
        let signature = signatures.at(index)
        match signatures.find(signature.identity) {
          Some(selected) -> if function_identity_eq(selected.identity, signature.identity) and
            semantic_type_id_eq(selected.type_id, signature.type_id) { found = found + 1 }
          None -> nil
        }
        index = index + 1
      }
      Test.assert_eq(found, 40)
      -- An external function is absent until resolved, then found.
      Test.assert_true(
        match signatures.find(helper) {
          None -> true
          Some(_) -> false
        }
      )
      match semantic_signature_in_scope(signatures, product.catalog(), scope, helper, 0) {
        SemanticScopeSignatureFound(extended, resolved) -> {
          Test.assert_true(function_identity_eq(resolved.identity, helper))
          Test.assert_true(
            match extended.find(helper) {
              Some(selected) -> semantic_type_id_eq(selected.type_id, resolved.type_id)
              None -> false
            }
          )
          -- Own functions stay found after an external one is added.
          let first = signatures.at(0)
          Test.assert_true(
            match extended.find(first.identity) {
              Some(selected) -> semantic_type_id_eq(selected.type_id, first.type_id)
              None -> false
            }
          )
          -- A second lookup reuses the resolved signature.
          Test.assert_true(
            match semantic_signature_in_scope(extended, extended.catalog(), scope, helper, 0) {
              SemanticScopeSignatureFound(_, again) -> semantic_type_id_eq(
                again.type_id,
                resolved.type_id
              )
              _ -> false
            }
          )
        }
        _ -> Test.assert_str_eq("helper signature", "found")
      }
    }
    _ -> Test.assert_str_eq("consumer resolution", "accepted")
  }
}

test "semantic method catalogs compose dependency implementations independent of module order" {
  let dependency_parsed = parse(
    "pub trait Show { fn show(self) -> str } pub type Box<T> { value: T } "
      |> str_concat("impl<T> Show for Box<T> { fn show(self) -> str { \"box\" } }")
  )
  let dependency = registration.register(
    dependency_parsed.declarations,
    dependency_parsed.source.source(),
    named_module_identity("fixture/method_dependency", 73)
  )
  let consumer_parsed = parse(
    "use dependency as dep fn render(value: dep.Box<i64>) -> str { \"\" }"
  )
  let consumer = registration.register(
    consumer_parsed.declarations,
    consumer_parsed.source.source(),
    named_module_identity("fixture/method_consumer", 73)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let scope = registration_scope.registration_scope_build(
    modules2(consumer, dependency),
    imports1(edge)
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let signature = semantic_signature_named(product, "render")
      let receiver = semantic_function_parameter_at(catalog, signature.type_id, 0)
      Test.assert_true(
        match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          "show"
        ) {
          SemanticImplementationMethodSelected(declaration, _, _, _) ->
            declaration_identity_name(declaration).text().unwrap() == "show"
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "qualified trait implementations retain associated Self context" {
  let dependency_parsed = parse(
    "pub trait Source { type Item fn get(self, value: Self.Item) -> Self.Item }"
  )
  let dependency = registration.register(
    dependency_parsed.declarations,
    dependency_parsed.source.source(),
    named_module_identity("fixture/associated_dependency", 73)
  )
  let consumer_parsed = parse(
    "use dependency as dep type Local { value: i64 } "
      |> str_concat("impl dep.Source for Local { type Item = i64 ")
      |> str_concat(
        "fn get(self, value: Self.Item) -> Self.Item { value } } "
      )
      |> str_concat("fn read(value: Local) -> i64 { 0 }")
  )
  let consumer = registration.register(
    consumer_parsed.declarations,
    consumer_parsed.source.source(),
    named_module_identity("fixture/associated_consumer", 73)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.first().unwrap(),
    dependency.identity,
    false
  )
  let scope = registration_scope.registration_scope_build(
    modules2(consumer, dependency),
    imports1(edge)
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let read = semantic_signature_named(product, "read")
      let receiver = semantic_function_parameter_at(catalog, read.type_id, 0)
      match semantic_implementation_method_select(
        methods,
        catalog,
        conformances,
        Nil<SemanticAssumedConformance>(),
        receiver,
        "get"
      ) {
        SemanticImplementationMethodSelected(_, _, template, substitution) -> {
          let (types, specialized) = semantic_type_product_substitute(
            product.continue_types(),
            substitution,
            template
          )
          let specialized_catalog = semantic_type_product_catalog(types)
          let signature_graph = catalog_graph(specialized_catalog, specialized)
          match semantic_type_graph_node(signature_graph, specialized) {
            SemanticFunctionNode(_, result, _) -> {
              let graph = catalog_graph(specialized_catalog, result)
              Test.assert_true(
                match semantic_type_graph_node(graph, result) {
                  SemanticPrimitiveNode(SemanticI64) -> true
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic method selection reports overlapping applicable implementations" {
  let module = registered(
    "type Box { value: i64 } impl Box { fn value(self) -> i64 { 1 } } "
      |> str_concat("impl Box { fn value(self) -> i64 { 2 } } ")
      |> str_concat("fn read(box: Box) -> i64 { 0 }")
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let signature = semantic_signature_named(product, "read")
      let receiver = semantic_function_parameter_at(catalog, signature.type_id, 0)
      Test.assert_true(
        match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          "value"
        ) {
          SemanticImplementationMethodSelectionAmbiguous -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}
