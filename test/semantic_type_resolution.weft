      )
  )
  match resolve_module_signatures(binding, scope_for(binding)) {
    SemanticSignaturesRejected(_, SemanticDeclarationResolutionRequired) ->
      Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "imported associated constraints retain their declaring module identity" {
  let dependency_parsed = parse("pub trait Source { type Item }")
  let dependency = registration.register(
    dependency_parsed.declarations,
    dependency_parsed.source.source(),
    named_module_identity("fixture/associated_dependency", 73)
  )
  let consumer_parsed = parse(
    "use dependency as dep "
      |> str_concat(
        "fn project<T, S: dep.Source & { type Item = T }>(source: S) -> S.Item { source }"
      )
  )
  let consumer = registration.register(
    consumer_parsed.declarations,
    consumer_parsed.source.source(),
    named_module_identity("fixture/associated_consumer", 73)
  )
  let authored_import = consumer.syntax.imports.first().unwrap()
  let edge = registration_scope.resolved_import(
    consumer,
    authored_import,
    dependency.identity,
    false
  )
  let scope = registration_scope.registration_scope_build(
    modules2(dependency, consumer),
    imports1(edge)
  )
  match resolve_module_signatures(consumer, scope) {
    SemanticSignaturesResolved(product) -> {
      let signature = product.at(0)
      let bound = product.bound_at(signature, 0)
      let catalog = product.catalog()
      let bound_graph = catalog_graph(catalog, bound.trait_atom)
      match semantic_type_graph_node(bound_graph, bound.trait_atom) {
        SemanticTraitNode(declaration, bindings) -> {
          Test.assert_true(
            module_identity_eq(declaration_module(declaration), dependency.identity)
          )
          let traits = semantic_type_graph_traits_local(bound_graph)
          let binding = semantic_type_trait_binding_edge(traits, bindings, 0)
          Test.assert_true(
            module_identity_eq(
              declaration_module(
                semantic_type_graph_trait_binding_declaration(bound_graph, binding)
              ),
              dependency.identity
            )
          )
        }
        _ -> Test.assert_true(false)
      }
      let signature_graph = catalog_graph(catalog, signature.type_id)
      match semantic_type_graph_node(signature_graph, signature.type_id) {
        SemanticFunctionNode(_, result, _) -> {
          let result_graph = catalog_graph(catalog, result)
          Test.assert_true(
            match semantic_type_graph_node(result_graph, result) {
              SemanticAssociatedNode(_, declaration) -> module_identity_eq(
                declaration_module(declaration),
                dependency.identity
              )
              _ -> false
            }
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    SemanticSignaturesRejected(_, _) -> Test.assert_true(false)
  }
}

test "semantic resolution composes signatures with declared aggregate layouts" {
  let module = registered(
    "type Box<T> { value: T, view: [T] } "
      |> str_concat("type Choice<T> { Empty, Pair(T, i64) } ")
      |> str_concat(
        "fn inspect(box: Box<i64>, choice: Choice<str>) -> i64 { 0 }"
      )
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let types = product.catalog()
      let declarations = product.declarations()
      let signature_graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(signature_graph, signature.type_id) {
        SemanticFunctionNode(parameters, _, _) -> {
          let box_type = list_type(signature_graph, parameters, 0)
          let choice_type = list_type(signature_graph, parameters, 1)
          let empty_substitution = semantic_type_substitution_empty()
          let variant_applications = product.variant_applications()
          let box_graph = catalog_graph(types, box_type)
          match semantic_type_graph_node(box_graph, box_type) {
            SemanticNamedNode(box_declaration, _, _, _) -> {
              Test.assert_true(
                match semantic_type_declared_record_template(
                  types,
                  declarations,
                  box_declaration
                ) {
                  SemanticRecordDeclarationTemplateSelected(template, layout, field_count) -> {
                    let template_graph = catalog_graph(types, template)
                    Test.assert_true(
                      match semantic_type_declared_record_template_field(
                        declarations,
                        layout,
                        "value"
                      ) {
                        SemanticRecordTemplateFieldProjected(field, ordinal, _) ->
                          ordinal == 0 and match declaration_identity_name(field).text() {
                            Some(value) -> value == "value"
                            None -> false
                          }
                        _ -> false
                      }
                    )
                    Test.assert_true(
                      match semantic_type_declared_record_template_field(
                        declarations,
                        layout,
                        "view"
                      ) {
                        SemanticRecordTemplateFieldProjected(_, ordinal, _) -> ordinal == 1
                        _ -> false
                      }
                    )
                    Test.assert_true(
                      match semantic_type_declared_record_template_field(
                        declarations,
                        layout,
                        "missing"
                      ) {
                        SemanticRecordTemplateFieldMissing -> true
                        _ -> false
                      }
                    )
                    Test.assert_true(
                      match semantic_type_declared_record_template_field(
                        declarations,
                        __i64_to_usize(999),
                        "value"
                      ) {
                        SemanticRecordTemplateFieldUnavailable -> true
                        _ -> false
                      }
                    )
                    field_count == 2 and match semantic_type_graph_node(template_graph, template) {
                      SemanticNamedNode(found, _, _, _) -> declaration_identity_eq(
                        found,
                        box_declaration
                      )
                      _ -> false
                    }
                  }
                  _ -> false
                }
              )
              let duplicate = semantic_type_declaration_catalog_add(
                declarations,
                types,
                semantic_record_declaration_layout(
                  box_type,
                  Nil<DeclarationIdentity>(),
                  Nil<SemanticTypeId>()
                )
              )
              Test.assert_true(
                match semantic_type_declared_record_template(
                  types,
                  duplicate,
                  box_declaration
                ) {
                  SemanticRecordDeclarationTemplateAmbiguous -> true
                  _ -> false
                }
              )
              -- The most recently added layout a type instantiates wins.
              Test.assert_true(
                match semantic_type_declaration_catalog_resolve(
                  types,
                  duplicate,
                  box_type,
                  empty_substitution
                ) {
                  SemanticRecordDeclarationLayoutMatched(index, _) ->
                    match semantic_type_declared_record_field_count(duplicate, index) {
                      Some(count) -> count == 0
                      None -> false
                    }
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
          let choice_graph = catalog_graph(types, choice_type)
          match semantic_type_graph_node(choice_graph, choice_type) {
            SemanticNamedNode(choice_declaration, _, _, _) -> Test.assert_true(
              match semantic_type_declared_record_template(
                types,
                declarations,
                choice_declaration
              ) {
                SemanticRecordDeclarationTemplateMissing -> true
                _ -> false
              }
            )
            _ -> Test.assert_true(false)
          }
          Test.assert_true(
            match semantic_variant_case_projection(
              variant_applications,
              types,
              choice_type,
              "Empty"
            ) {
              SemanticVariantCaseProjected(_, case_index, payload_count) ->
                case_index == 0 and payload_count == 0
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_case_projection(
              variant_applications,
              types,
              choice_type,
              "Pair"
            ) {
              SemanticVariantCaseProjected(declaration, case_index, payload_count) ->
                declaration_identity_name(declaration).text().unwrap() == "Pair" and
                case_index == 1 and payload_count == 2
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_case_projection(
              variant_applications,
              types,
              choice_type,
              "Missing"
            ) {
              SemanticVariantCaseMissing -> true
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_case_projection(
              variant_applications,
              types,
              box_type,
              "Pair"
            ) {
              SemanticVariantApplicationUnavailable -> true
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_payload_type(
              variant_applications,
              types,
              choice_type,
              1,
              0
            ) {
              Some(payload) -> {
                let payload_graph = catalog_graph(types, payload)
                match semantic_type_graph_node(payload_graph, payload) {
                  SemanticPrimitiveNode(SemanticStr) -> true
                  _ -> false
                }
              }
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_payload_type(
              variant_applications,
              types,
              choice_type,
              1,
              1
            ) {
              Some(payload) -> {
                let payload_graph = catalog_graph(types, payload)
                match semantic_type_graph_node(payload_graph, payload) {
                  SemanticPrimitiveNode(SemanticI64) -> true
                  _ -> false
                }
              }
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_payload_type(
              variant_applications,
              types,
              choice_type,
              0,
              0
            ) {
              None -> true
              _ -> false
            }
          )
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            box_type,
            empty_substitution
          ) {
            SemanticRecordDeclarationLayoutMatched(index, _) -> {
              Test.assert_true(
                match semantic_type_declared_record_field_count(
                  declarations,
                  index
                ) {
                  Some(count) -> count == 2
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_record_field_declaration(
                  declarations,
                  index,
                  0
                ) {
                  Some(field) -> declaration_identity_name(field).text().unwrap() == "value"
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_record_field_type(
                  declarations,
                  index,
                  0
                ) {
                  Some(field_type) -> {
                    let field_graph = catalog_graph(types, field_type)
                    match semantic_type_graph_node(field_graph, field_type) {
                      SemanticVariableNode(SemanticParameterVariable(parameter)) ->
                        parameter == 0
                      _ -> false
                    }
                  }
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
          let applications = product.applications()
          Test.assert_true(
            match semantic_declared_field_projection(
              applications,
              types,
              box_type,
              "value"
            ) {
              SemanticDeclaredFieldProjected(_, field_index, result) -> {
                let result_graph = catalog_graph(types, result)
                field_index == 0 and match semantic_type_graph_node(
                  result_graph,
                  result
                ) {
                  SemanticPrimitiveNode(SemanticI64) -> true
                  _ -> false
                }
              }
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_declared_field_projection(
              applications,
              types,
              box_type,
              "view"
            ) {
              SemanticDeclaredFieldProjected(_, field_index, result) -> {
                let result_graph = catalog_graph(types, result)
                field_index == 1 and match semantic_type_graph_node(
                  result_graph,
                  result
                ) {
                  SemanticSliceNode(element, _) -> {
                    let element_graph = catalog_graph(types, element)
                    match semantic_type_graph_node(element_graph, element) {
                      SemanticPrimitiveNode(SemanticI64) -> true
                      _ -> false
                    }
                  }
                  _ -> false
                }
              }
              _ -> false
            }
          )
          let empty_substitution = semantic_type_substitution_empty()
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            choice_type,
            empty_substitution
          ) {
            SemanticVariantDeclarationLayoutMatched(index, _) -> {
              Test.assert_true(
                match semantic_type_declared_variant_case_count(declarations, index) {
                  Some(count) -> count == 2
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_variant_case_declaration(
                  declarations,
                  index,
                  1
                ) {
                  Some(case) -> declaration_identity_name(case).text().unwrap() == "Pair"
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_variant_payload_count(
                  declarations,
                  index,
                  1
                ) {
                  Some(count) -> count == 2
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_variant_payload_type(
                  declarations,
                  index,
                  1,
                  1
                ) {
                  Some(payload) -> {
                    let payload_graph = catalog_graph(types, payload)
                    match semantic_type_graph_node(payload_graph, payload) {
                      SemanticPrimitiveNode(SemanticI64) -> true
                      _ -> false
                    }
                  }
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

-- A layout declaring exactly one bound: a type parameter bounded by a trait.
fn assert_one_trait_bound(
  types: SemanticTypeCatalog,
  declarations: SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -[Test]> i64 {
  Test.assert_true(
    match semantic_type_declared_bound_count(declarations, layout) {
      Some(count) -> count == 1
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_declared_bound_variable(declarations, layout, 0) {
      Some(SemanticParameterVariable(_)) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_declared_bound_type(declarations, layout, 0) {
      Some(bound) -> {
        let bound_graph = catalog_graph(types, bound)
        match semantic_type_graph_node(bound_graph, bound) {
          SemanticTraitNode(_, _) -> true
          _ -> false
        }
      }
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_declared_bound_type(declarations, layout, 1) {
      None -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_declared_bound_variable(declarations, layout, 1) {
      None -> true
      _ -> false
    }
  )
}

test "semantic record layouts retain generic trait bounds" {
  let module = registered(
    "trait Shown { fn show(self) -> str } "
      |> str_concat("type Box<T: Shown> { value: T } ")
      |> str_concat("fn inspect(box: Box<i64>) -> i64 { 0 }")
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let types = product.catalog()
      let declarations = product.declarations()
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(graph, signature.type_id) {
        SemanticFunctionNode(parameters, _, _) -> {
          let box_type = list_type(graph, parameters, 0)
          let box_graph = catalog_graph(types, box_type)
          match semantic_type_graph_node(box_graph, box_type) {
            SemanticNamedNode(box_declaration, _, _, _) ->
              match semantic_type_declared_record_template(
                types,
                declarations,
                box_declaration
              ) {
                SemanticRecordDeclarationTemplateSelected(_, layout, _) ->
                  assert_one_trait_bound(
                    types,
                    declarations,
                    SemanticDeclaredRecordLayout(layout)
                  )
                _ -> Test.assert_true(false)
              }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic variant layouts retain generic trait bounds" {
  let module = registered(
    "trait Shown { fn show(self) -> str } "
      |> str_concat("type Plain { Plain(i64) } ")
      |> str_concat("type Slot<T: Shown> { Filled(T), Vacant } ")
      |> str_concat("fn inspect(slot: Slot<i64>, plain: Plain) -> i64 { 0 }")
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let types = product.catalog()
      let declarations = product.declarations()
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(graph, signature.type_id) {
        SemanticFunctionNode(parameters, _, _) -> {
          let slot_type = list_type(graph, parameters, 0)
          let unbound = semantic_type_substitution_empty()
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            slot_type,
            unbound
          ) {
            SemanticVariantDeclarationLayoutMatched(layout, _) ->
              assert_one_trait_bound(types, declarations, SemanticDeclaredVariantLayout(layout))
            _ -> Test.assert_true(false)
          }
          -- An unbounded variant declares none.
          let plain_type = list_type(graph, parameters, 1)
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            plain_type,
            unbound
          ) {
            SemanticVariantDeclarationLayoutMatched(layout, _) -> Test.assert_true(
              match semantic_type_declared_bound_count(
                declarations,
                SemanticDeclaredVariantLayout(layout)
              ) {
                Some(count) -> count == 0
                None -> false
              }
            )
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic resolution rejects invalid declared field types atomically" {
  let module = registered("type Broken { value: Missing }")
  Test.assert_true(
    match resolve_module_semantics(module, scope_for(module)) {
      SemanticResolutionRejected(issue) -> match issue {
        SemanticDeclarationResolutionIssue(declaration, SemanticDeclarationResolutionRequired) ->
          declaration_identity_name(declaration).text().unwrap() == "Broken"
        _ -> false
      }
      _ -> false
    }
  )
}

test "semantic resolution keeps same-kind declaration columns aligned" {
  let module = registered(
    "type First { one: i64 } type Second { two: str, three: bool } "
      |> str_concat("fn compare(first: First, second: Second) -> nil { nil }")
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let types = product.catalog()
      let declarations = product.declarations()
      let graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(graph, signature.type_id) {
        SemanticFunctionNode(parameters, _, _) -> {
          let first = list_type(graph, parameters, 0)
          let second = list_type(graph, parameters, 1)
          let substitution = semantic_type_substitution_empty()
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            first,
            substitution
          ) {
            SemanticRecordDeclarationLayoutMatched(index, _) -> {
              Test.assert_true(
                match semantic_type_declared_record_field_declaration(
                  declarations,
                  index,
                  0
                ) {
                  Some(field) -> declaration_identity_name(field).text().unwrap() == "one"
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
          match semantic_type_declaration_catalog_resolve(
            types,
            declarations,
            second,
            substitution
          ) {
            SemanticRecordDeclarationLayoutMatched(index, _) -> {
              Test.assert_true(
                match semantic_type_declared_record_field_count(
                  declarations,
                  index
                ) {
                  Some(count) -> count == 2
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_type_declared_record_field_declaration(
                  declarations,
                  index,
                  1
                ) {
                  Some(field) -> declaration_identity_name(field).text().unwrap() == "three"
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic resolution composes generic effect operation templates" {
  let module = registered(
    "effect Store<T> { fn get() -> T @deferred fn wait(values: [T]) -> T } "
      |> str_concat("effect Clock { fn now() -> i64 } ")
      |> str_concat("fn observe() -[Store<i64>]> i64 { 0 }")
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let types = product.catalog()
      let signature_graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(signature_graph, signature.type_id) {
        SemanticFunctionNode(_, _, effect_signature) -> {
          let effect_graph = catalog_graph(types, effect_signature)
          match semantic_type_graph_node(effect_graph, effect_signature) {
            SemanticEffectSignatureNode(atoms, _) -> {
              let atom = list_type(effect_graph, atoms, 0)
              let effects = product.effects()
              let empty = semantic_type_substitution_empty()
              match semantic_effect_declaration_catalog_resolve(
                types,
                effects,
                atom,
                empty
              ) {
                SemanticEffectDeclarationMatched(layout, substitution) -> {
                  Test.assert_true(
                    match semantic_effect_declaration(effects, layout) {
                      Some(declaration) ->
                        declaration_identity_name(declaration).text().unwrap() == "Store"
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_count(effects, layout) {
                      Some(count) -> count == 2
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_declaration(effects, layout, 1) {
                      Some(operation) ->
                        declaration_identity_name(operation).text().unwrap() == "wait"
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_is_deferred(effects, layout, 1) {
                      Some(deferred) -> deferred
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_parameter_count(effects, layout, 1) {
                      Some(count) -> count == 1
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_parameter_type(effects, layout, 1, 0) {
                      Some(parameter) -> {
                        let parameter_graph = catalog_graph(types, parameter)
                        match semantic_type_graph_node(parameter_graph, parameter) {
                          SemanticSliceNode(element, _) -> {
                            let element_graph = catalog_graph(types, element)
                            match semantic_type_graph_node(element_graph, element) {
                              SemanticVariableNode(SemanticParameterVariable(index)) ->
                                index == 0
                              _ -> false
                            }
                          }
                          _ -> false
                        }
                      }
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_result(effects, layout, 0) {
                      Some(result) -> {
                        let result_graph = catalog_graph(types, result)
                        match semantic_type_graph_node(result_graph, result) {
                          SemanticVariableNode(SemanticParameterVariable(index)) -> index == 0
                          _ -> false
                        }
                      }
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_type_substitution_get(
                      substitution,
                      SemanticParameterVariable(0)
                    ) {
                      Some(concrete) -> {
                        let concrete_graph = catalog_graph(types, concrete)
                        match semantic_type_graph_node(concrete_graph, concrete) {
                          SemanticPrimitiveNode(SemanticI64) -> true
                          _ -> false
                        }
                      }
                      _ -> false
                    }
                  )
                }
                _ -> Test.assert_true(false)
              }
              let applications = product.effect_applications()
              match semantic_effect_operation_projection(
                applications,
                types,
                atom,
                "wait"
              ) {
                SemanticEffectOperationProjected(
                  _,
                  declaration,
                  operation,
                  deferred,
                  parameter_count,
                  result,
                ) -> {
                  Test.assert_str_eq(
                    declaration_identity_name(declaration).text().unwrap(),
                    "Store"
                  )
                  Test.assert_str_eq(
                    declaration_identity_name(operation).text().unwrap(),
                    "wait"
                  )
                  Test.assert_true(deferred)
                  Test.assert_eq_usize(parameter_count, 1)
                  Test.assert_true(
                    match semantic_effect_operation_projection_by_identity(
                      applications,
                      types,
                      atom,
                      operation
                    ) {
                      SemanticEffectOperationProjected(
                        selected_atom,
                        selected_effect,
                        selected_operation,
                        true,
                        1,
                        selected_result,
                      ) -> declaration_identity_eq(selected_effect, declaration) and
                        declaration_identity_eq(selected_operation, operation) and
                        semantic_type_catalog_equal(types, selected_atom, atom) and
                        semantic_type_catalog_equal(types, selected_result, result)
                      _ -> false
                    }
                  )
                  Test.assert_true(
                    match semantic_effect_operation_projection_by_identity(
                      applications,
                      types,
                      atom,
                      declaration
                    ) {
                      SemanticEffectOperationMissing -> true
                      _ -> false
                    }
                  )
                  let result_graph = catalog_graph(types, result)
                  Test.assert_true(
                    match semantic_type_graph_node(result_graph, result) {
                      SemanticPrimitiveNode(SemanticI64) -> true
                      _ -> false
                    }
                  )
                  match semantic_effect_application_parameter_type(
                    applications,
                    types,
                    atom,
                    "wait",
                    0
                  ) {
                    Some(parameter) -> {
                      Test.assert_true(
                        match semantic_effect_application_parameter_type_by_identity(
                          applications,
                          types,
                          atom,
                          operation,
                          0
                        ) {
                          Some(selected) -> semantic_type_catalog_equal(
                            types,
                            selected,
                            parameter
                          )
                          _ -> false
                        }
                      )
                      Test.assert_true(
                        match semantic_effect_application_parameter_type_by_identity(
                          applications,
                          types,
                          atom,
                          operation,
                          1
                        ) {
                          None -> true
                          _ -> false
                        }
                      )
                      let parameter_graph = catalog_graph(types, parameter)
                      Test.assert_true(
                        match semantic_type_graph_node(parameter_graph, parameter) {
                          SemanticSliceNode(element, _) -> {
                            let element_graph = catalog_graph(types, element)
                            match semantic_type_graph_node(element_graph, element) {
                              SemanticPrimitiveNode(SemanticI64) -> true
                              _ -> false
                            }
                          }
                          _ -> false
                        }
                      )
                    }
                    _ -> Test.assert_true(false)
                  }
                }
                _ -> Test.assert_true(false)
              }
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

fn primitive_name(types: borrow SemanticTypeCatalog, value: SemanticTypeId) -> str {
  let graph = catalog_graph(types, value)
  match semantic_type_graph_node(graph, value) {
    SemanticPrimitiveNode(SemanticI8) -> "i8"
    SemanticPrimitiveNode(SemanticI32) -> "i32"
    SemanticPrimitiveNode(SemanticI64) -> "i64"
    SemanticPrimitiveNode(SemanticU8) -> "u8"
    SemanticPrimitiveNode(SemanticU16) -> "u16"
    SemanticPrimitiveNode(SemanticBool) -> "bool"
    SemanticPrimitiveNode(SemanticStr) -> "str"
    SemanticPrimitiveNode(SemanticF64) -> "f64"
    SemanticPrimitiveNode(SemanticNil) -> "nil"
    _ -> "?"
  }
}

-- Every case's payloads, `|` between cases and `,` between payloads, and
-- whether each lookup just past the end is refused.
fn applied_payloads(
  applications: borrow SemanticVariantApplicationCatalog,
  types: borrow SemanticTypeCatalog,
  base: SemanticTypeId
) -> str {
  let cases = match semantic_variant_case_count(applications, types, base) {
    Some(count) -> count
    None -> return "unavailable"
  }
  let mut text = ""
  let mut case: usize = 0
  while case < cases {
    if case > 0 { text = str_concat(text, "|") }
    let mut payload: usize = 0
    loop {
      match semantic_variant_payload_type(applications, types, base, case, payload) {
        Some(value) -> {
          if payload > 0 { text = str_concat(text, ",") }
          text = str_concat(text, primitive_name(types, value))
        }
        None -> break
      }
      payload = payload + 1
    }
    case = case + 1
  }
  match semantic_variant_payload_type(applications, types, base, cases, 0) {
    Some(_) -> str_concat(text, " past-end")
    None -> text
  }
}

-- An operation's parameters, `,` between them.
fn applied_parameters(
  applications: borrow SemanticEffectApplicationCatalog,
  types: borrow SemanticTypeCatalog,
  atom: SemanticTypeId,
  operation: str
) -> str {
  let mut text = ""
  let mut parameter: usize = 0
  loop {
    match semantic_effect_application_parameter_type(
      applications,
      types,
      atom,
      operation,
      parameter
    ) {
      Some(value) -> {
        if parameter > 0 { text = str_concat(text, ",") }
        text = str_concat(text, primitive_name(types, value))
      }
      None -> break
    }
    parameter = parameter + 1
  }
  text
}

test "application columns address every member of every application" {
  let module = registered(
    "type Shape<T> { Dot(i64), Line(T, bool), Empty, Tri(str, T, u8) } "
      |> str_concat("effect Trace<T> { fn mark(first: T, second: bool) -> nil ")
      |> str_concat("fn span(from: i64, to: T, label: str) -> T } ")
      |> str_concat("effect Gauge { fn read(slot: i64, scale: f64) -> f64 } ")
      |> str_concat(
        "fn inspect(small: Shape<i8>, large: Shape<i32>) -[Trace<u16>, Gauge]> i64 { 0 }"
      )
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let types = product.catalog()
      let variants = product.variant_applications()
      let effects = product.effect_applications()
      let graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(graph, signature.type_id) {
        SemanticFunctionNode(parameters, _, effect_signature) -> {
          let small = list_type(graph, parameters, 0)
          let large = list_type(graph, parameters, 1)
          -- Each case's payloads start after every earlier case's, in each
          -- application of the same declaration.
          Test.assert_str_eq(applied_payloads(variants, types, small), "i64|i8,bool||str,i8,u8")
          Test.assert_str_eq(applied_payloads(variants, types, large), "i64|i32,bool||str,i32,u8")
          Test.assert_true(
            match semantic_variant_case_projection(variants, types, large, "Tri") {
              SemanticVariantCaseProjected(_, 3, 3) -> true
              _ -> false
            }
          )
          Test.assert_true(
            match semantic_variant_case_projection(variants, types, small, "Empty") {
              SemanticVariantCaseProjected(_, 2, 0) -> true
              _ -> false
            }
          )
          let effect_graph = catalog_graph(types, effect_signature)
          match semantic_type_graph_node(effect_graph, effect_signature) {
            SemanticEffectSignatureNode(atoms, _) -> {
              let first = list_type(effect_graph, atoms, 0)
              let second = list_type(effect_graph, atoms, 1)
              let (trace, gauge) = match semantic_effect_operation_projection(
                effects,
                types,
                first,
                "mark"
              ) {
                SemanticEffectOperationProjected(_, _, _, _, _, _) -> (first, second)
                _ -> (second, first)
              }
              -- Each operation's parameters start after every earlier
              -- operation's, in every application.
              Test.assert_str_eq(applied_parameters(effects, types, trace, "mark"), "u16,bool")
              Test.assert_str_eq(applied_parameters(effects, types, trace, "span"), "i64,u16,str")
              Test.assert_str_eq(applied_parameters(effects, types, gauge, "read"), "i64,f64")
              Test.assert_str_eq(applied_parameters(effects, types, gauge, "mark"), "")
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic effect applications include atoms reachable through operations" {
  let module = registered(
    "effect Store<T> { fn get() -> T } "
      |> str_concat(
        "effect Nested { fn run(callback: () -[Store<str>]> str) -> str } "
      )
      |> str_concat("fn observe() -[Nested, Store<i64>]> str { \"\" }")
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let types = product.catalog()
      let signatures = product.signatures()
      let signature = signatures.at(0)
      let signature_graph = catalog_graph(types, signature.type_id)
      match semantic_type_graph_node(signature_graph, signature.type_id) {
        SemanticFunctionNode(_, signature_result, effect_signature) -> {
          let effect_graph = catalog_graph(types, effect_signature)
          match semantic_type_graph_node(effect_graph, effect_signature) {
            SemanticEffectSignatureNode(atoms, _) -> {
              let nested = effect_atom_named(effect_graph, atoms, "Nested")
              let integer_store = effect_atom_named(effect_graph, atoms, "Store")
              let applications = product.effect_applications()
              match semantic_effect_operation_projection(
                applications,
                types,
                nested,
                "run"
              ) {
                SemanticEffectOperationProjected(_, _, _, _, 1, result) -> {
                  Test.assert_true(semantic_type_catalog_equal(types, result, signature_result))
                }
                _ -> Test.assert_true(false)
              }
              match semantic_effect_application_parameter_type(
                applications,
                types,
                nested,
                "run",
                0
              ) {
                Some(callback) -> {
                  let callback_graph = catalog_graph(types, callback)
                  match semantic_type_graph_node(callback_graph, callback) {
                    SemanticFunctionNode(_, callback_result, callback_effects) -> {
                      Test.assert_true(
                        semantic_type_catalog_equal(types, callback_result, signature_result)
                      )
                      let callback_effect_graph = catalog_graph(types, callback_effects)
                      match semantic_type_graph_node(
                        callback_effect_graph,
                        callback_effects
                      ) {
                        SemanticEffectSignatureNode(callback_atoms, _) -> {
                          let store = list_type(callback_effect_graph, callback_atoms, 0)
                          match semantic_effect_operation_projection(
                            applications,
                            types,
                            store,
                            "get"
                          ) {
                            SemanticEffectOperationProjected(_, _, _, false, 0, get_result) ->
                              Test.assert_true(
                                semantic_type_catalog_equal(
                                  types,
                                  get_result,
                                  signature_result
                                )
                              )
                            _ -> Test.assert_true(false)
                          }
                        }
                        _ -> Test.assert_true(false)
                      }
                    }
                    _ -> Test.assert_true(false)
                  }
                }
                _ -> Test.assert_true(false)
              }
              match semantic_effect_operation_projection(
                applications,
                types,
                integer_store,
                "get"
              ) {
                SemanticEffectOperationProjected(_, _, _, false, 0, result) -> {
                  let result_graph = catalog_graph(types, result)
                  Test.assert_true(
                    match semantic_type_graph_node(result_graph, result) {
                      SemanticPrimitiveNode(SemanticI64) -> true
                      _ -> false
                    }
                  )
                }
                _ -> Test.assert_true(false)
              }
              Test.assert_true(
                match semantic_effect_operation_projection(
                  applications,
                  types,
                  nested,
                  "missing"
                ) {
                  SemanticEffectOperationMissing -> true
                  _ -> false
                }
              )
              Test.assert_true(
                match semantic_effect_operation_projection(
                  applications,
                  types,
                  signature_result,
                  "get"
                ) {
                  SemanticEffectApplicationUnavailable -> true
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic resolution rejects invalid effect operation types atomically" {
  let module = registered("effect Broken { fn get() -> Missing }")
  Test.assert_true(
    match resolve_module_semantics(module, scope_for(module)) {
      SemanticResolutionRejected(SemanticEffectDeclarationResolutionIssue(issue)) ->
        match issue {
          SemanticEffectOperationTypeRejected(operation, SemanticDeclarationResolutionRequired) ->
            declaration_identity_name(operation).text().unwrap() == "get"
          _ -> false
        }
      _ -> false
    }
  )
}

test "semantic method selection specializes generic trait implementations" {
  let module = registered(
    "trait Same { fn same(self, other: Self) -> bool } "
      |> str_concat("type Box<T> { value: T } ")
      |> str_concat(
        "impl<T> Same for Box<T> { fn same(self, other: Self) -> bool { true } } "
      )
      |> str_concat("fn compare(left: Box<i64>, right: Box<i64>) -> bool { true }")
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let signature = semantic_signature_named(product, "compare")
      let receiver = semantic_function_parameter_at(catalog, signature.type_id, 0)
      match semantic_implementation_method_select(
        methods,
        catalog,
        conformances,
        Nil<SemanticAssumedConformance>(),
        receiver,
        "same"
      ) {
        SemanticImplementationMethodSelected(
          declaration,
          _,
          template,
          substitution,
        ) -> {
          Test.assert_str_eq(declaration_identity_name(declaration).text().unwrap(), "same")
          let (types, specialized) = semantic_type_product_substitute(
            product.continue_types(),
            substitution,
            template
          )
          let specialized_catalog = semantic_type_product_catalog(types)
          Test.assert_true(
            semantic_type_catalog_equal(
              specialized_catalog,
              semantic_function_parameter_at(specialized_catalog, specialized, 0),
              receiver
            )
          )
          Test.assert_true(
            semantic_type_catalog_equal(
              specialized_catalog,
              semantic_function_parameter_at(specialized_catalog, specialized, 1),
              receiver
            )
          )
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "method selection sees only implementations sharing the receiver's head" {
  let module = registered(
    "trait Tag { fn tag(self) -> str } "
      |> str_concat("type Box<T> { value: T } type Pair<A, B> { left: A, right: B } ")
      |> str_concat("impl Tag for i64 { fn tag(self) -> str { \"i64\" } } ")
      |> str_concat("impl<T> Tag for Box<T> { fn tag(self) -> str { \"box\" } } ")
      |> str_concat("impl<A, B> Tag for Pair<A, B> { fn tag(self) -> str { \"pair\" } } ")
      |> str_concat(
        "fn probe(a: i64, b: Box<str>, c: Box<i64>, d: Pair<i64, bool>, e: u8, f: str) -> i64 { 0 }"
      )
  )
  match resolve_module_semantics(module, scope_for(module)) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let signature = semantic_signature_named(product, "probe")
      let mut selected = Nil<(DeclarationIdentity, FunctionIdentity)>()
      let mut index: usize = 6
      while index > 0 {
        index = index - 1
        let receiver = semantic_function_parameter_at(catalog, signature.type_id, index)
        -- The first four receivers have an implementation; `u8` and `str`
        -- have none.
        selected = match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          "tag"
        ) {
          SemanticImplementationMethodSelected(declaration, function, _, _) -> {
            Test.assert_true(index < 4)
            selected.prepend((declaration, function))
          }
          SemanticImplementationMethodSelectionMissing -> {
            Test.assert_true(index >= 4)
            selected
          }
          SemanticImplementationMethodSelectionAmbiguous -> {
            Test.assert_true(false)
            selected
          }
        }
      }
      match selected {
        Cons((_, integer), Cons((boxed, text_box), Cons((_, integer_box), Cons((_, pair), Nil)))) ->
          {
            -- Two applications of one implementation share its method; each
            -- head has its own.
            Test.assert_true(function_identity_eq(text_box, integer_box))
            Test.assert_false(function_identity_eq(integer, text_box))
            Test.assert_false(function_identity_eq(integer, pair))
            Test.assert_false(function_identity_eq(text_box, pair))
            -- The declaration checking selected resolves, for each concrete
            -- receiver, to the implementation of that receiver's head.
            let mut resolved = ""
            let mut probe: usize = 0
            while probe < 6 {
              let receiver = semantic_function_parameter_at(catalog, signature.type_id, probe)
              let label = match semantic_implementation_method_resolve(
                methods,
                catalog,
                conformances,
                receiver,
                boxed
              ) {
                SemanticImplementationMethodSelected(_, function, _, _) ->
                  if function_identity_eq(function, integer) { "i" }
                else if function_identity_eq(function, text_box) { "b" }
                else if function_identity_eq(function, pair) { "p" }
                else { "?" }
                SemanticImplementationMethodSelectionMissing -> "-"
                SemanticImplementationMethodSelectionAmbiguous -> "A"
              }
              resolved = str_concat(resolved, label)
              probe = probe + 1
            }
            Test.assert_str_eq(resolved, "ibbp--")
          }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic method selection filters same-spelled methods by exact trait" {
  let module = registered(
    "trait Eq { fn eq(self, other: Self) -> bool } "
      |> str_concat("trait Other { fn eq(self, other: Self) -> bool } ")
      |> str_concat("type Box { value: i64 } ")
      |> str_concat("impl Eq for Box { fn eq(self, other: Self) -> bool { true } } ")
      |> str_concat("impl Other for Box { fn eq(self, other: Self) -> bool { false } } ")
      |> str_concat("fn compare(left: Box, right: Box) -> bool { true }")
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let signature = semantic_signature_named(product, "compare")
      let receiver = semantic_function_parameter_at(catalog, signature.type_id, 0)
      let eq_trait = registration_scope.registration_scope_find_declaration(
        scope,
        module.identity,
        TraitDeclaration,
        "Eq"
      ).unwrap().identity
      let other_trait = registration_scope.registration_scope_find_declaration(
        scope,
        module.identity,
        TraitDeclaration,
        "Other"
      ).unwrap().identity
      Test.assert_true(
        match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          "eq"
        ) {
          SemanticImplementationMethodSelectionAmbiguous -> true
          _ -> false
        }
      )
      match (
        semantic_trait_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          eq_trait,
          "eq"
        ),
        semantic_trait_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
          receiver,
          other_trait,
          "eq"
        ),
      ) {
        (
          SemanticImplementationMethodSelected(eq_method, _, _, _),
          SemanticImplementationMethodSelected(other_method, _, _, _),
        ) -> Test.assert_true(not declaration_identity_eq(eq_method, other_method))
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic method selection resolves associated results through Self" {
  let module = registered(
    "trait Source { type Item fn get(self, value: Self.Item) -> Self.Item } "
      |> str_concat("type Box { value: i64 } ")
      |> str_concat(
        "impl Source for Box { type Item = i64 "
      )
      |> str_concat("fn get(self, value: Self.Item) -> Self.Item { value } } ")
      |> str_concat("fn read(box: Box) -> i64 { 0 }")
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let read = semantic_signature_named(product, "read")
      let receiver = semantic_function_parameter_at(catalog, read.type_id, 0)
      match semantic_implementation_method_select(
        methods,
        catalog,
        conformances,
        Nil<SemanticAssumedConformance>(),
        receiver,
        "get"
      ) {
        SemanticImplementationMethodSelected(_, _, template, substitution) -> {
          let (types, specialized) = semantic_type_product_substitute(
            product.continue_types(),
            substitution,
            template
          )
          let specialized_catalog = semantic_type_product_catalog(types)
          let signature_graph = catalog_graph(specialized_catalog, specialized)
          match semantic_type_graph_node(signature_graph, specialized) {
            SemanticFunctionNode(_, result, _) -> {
              let graph = catalog_graph(specialized_catalog, result)
              Test.assert_true(
                match semantic_type_graph_node(graph, result) {
                  SemanticPrimitiveNode(SemanticI64) -> true
                  _ -> false
                }
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "semantic method selection enforces conditional implementation bounds" {
  let module = registered(
    "trait Show { fn show(self) -> str } type Wrap<T> { value: T } "
      |> str_concat("impl Show for i64 { fn show(self) -> str { \"i64\" } } ")
      |> str_concat(
        "impl<T: Show> Show for Wrap<T> { fn show(self) -> str { \"wrap\" } } "
      )
      |> str_concat(
        "fn shown(value: Wrap<i64>) -> str { \"\" } fn hidden(value: Wrap<bool>) -> str { \"\" }"
      )
  )
  let scope = scope_for(module)
  match resolve_module_semantics(module, scope) {
    SemanticResolutionAccepted(product) -> {
      let catalog = product.catalog()
      let methods = product.methods()
      let conformances = product.conformances()
      let shown = semantic_signature_named(product, "shown")
      let hidden = semantic_signature_named(product, "hidden")
      let shown_receiver = semantic_function_parameter_at(catalog, shown.type_id, 0)
      let hidden_receiver = semantic_function_parameter_at(catalog, hidden.type_id, 0)
      Test.assert_true(
        match semantic_implementation_method_select(
          methods,
          catalog,
          conformances,
          Nil<SemanticAssumedConformance>(),
