-- Real authored type syntax resolves into the immutable semantic graph before
-- checked-body storage switches away from pointer-shaped legacy nodes.

use compiler/ir/data.{*}
use compiler/project/identity.{named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{*}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/semantic_types.{*}
use compiler/weft/check/storage.{dense_index}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/panic.{panic}
use stdlib/source.{Source}
use stdlib/string.{str_concat}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(
    parsed.declarations,
    parsed.source.source(),
    named_module_identity("fixture/semantic_types", 73)
  )
}

fn resolved_signature(module: RegisteredModule) -> (SemanticTypeGraph, SemanticTypeId) {
  let functions = module.functions
  let registered_function = functions.at(dense_index(0))
  let function = registered_function.syntax
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module.identity))
  match resolve_function_signature(builder, module.source, function) {
    (builder, SemanticTypeResolved(signature)) -> (builder.freeze(), signature)
    (builder, SemanticTypeRejected(_)) -> {
      builder.drop()
      panic("expected signature to resolve")
    }
  }
}

fn list_type(
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  offset: usize
) -> SemanticTypeId {
  let lists = semantic_type_graph_type_lists_local(graph)
  let edge = semantic_type_list_edge(lists, list, offset)
  semantic_type_graph_list_type_id(
    graph,
    edge
  )
}

fn resolve_primitives(
  builder: owned SemanticTypeGraphBuilder,
  source: Source,
  code: i64
) -> owned SemanticTypeGraphBuilder {
  if code == 15 { builder }
  else {
    match resolve_type(builder, source, PrimitiveTypeExpr(code)) {
      (builder, SemanticTypeResolved(_)) -> resolve_primitives(builder, source, code + 1)
      (builder, SemanticTypeRejected(_)) -> {
        builder.drop()
        panic("authored primitive should resolve")
      }
    }
  }
}

fn semantic_primitive_code(primitive: SemanticPrimitive) -> i64 {
  match primitive {
    SemanticI64 -> 0
    SemanticStr -> 1
    SemanticBool -> 2
    SemanticNil -> 3
    SemanticF64 -> 4
    SemanticI32 -> 5
    SemanticI8 -> 6
    SemanticI16 -> 7
    SemanticU8 -> 8
    SemanticU16 -> 9
    SemanticU32 -> 10
    SemanticU64 -> 11
    SemanticIsize -> 12
    SemanticUsize -> 13
    SemanticF32 -> 14
  }
}

fn resolved_primitive_code(code: i64) -> i64 {
  let source = source_from_text("")
  let builder = semantic_type_graph_builder(
    semantic_type_segment_id(named_module_identity("primitive", code))
  )
  match resolve_type(builder, source, PrimitiveTypeExpr(code)) {
    (builder, SemanticTypeResolved(resolved)) -> {
      let graph = builder.freeze()
      match semantic_type_graph_node(graph, resolved) {
        SemanticPrimitiveNode(primitive) -> semantic_primitive_code(primitive)
        _ -> 0 - 1
      }
    }
    (builder, SemanticTypeRejected(_)) -> {
      builder.drop()
      0 - 1
    }
  }
}

test "real authored signatures resolve directly into semantic graph nodes" {
  let module = registered(
    "fn shape<T, E>(pointer: *mut T, borrowed: borrow mut T, view: [mut i64], "
    |> str_concat("array: [str; 4], row: { value: T, label: str,..}, ")
    |> str_concat("pair: (bool, f32), callback: (T) -> T) -[E]> T & ~nil { pointer }")
  )
  let (graph, signature) = resolved_signature(module)

  match semantic_type_graph_node(graph, signature) {
    SemanticFunctionNode(parameters, result, effects) -> {
      let lists = semantic_type_graph_type_lists_local(graph)
      Test.assert_eq_usize(semantic_type_list_len(lists, parameters), 7)
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 0)) {
          SemanticPointerNode(_, SemanticMutable) -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 1)) {
          SemanticBorrowNode(_, SemanticMutable) -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 2)) {
          SemanticSliceNode(_, SemanticMutable) -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 3)) {
          SemanticArrayNode(element, length) -> length == 4 and match
          semantic_type_graph_node(graph, element) {
            SemanticPrimitiveNode(SemanticStr) -> true
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 4)) {
          SemanticRecordNode(_, SemanticStructuralRecord, SemanticOpenRecord) -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, list_type(graph, parameters, 5)) {
          SemanticRecordNode(_, SemanticTupleRecord, SemanticClosedRecord) -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 6)) {
          SemanticFunctionKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, result) {
          SemanticIntersectionNode(_, complement) -> match semantic_type_graph_node(
            graph,
            complement
          ) {
            SemanticComplementNode(nil_type) -> match semantic_type_graph_node(
              graph,
              nil_type
            ) {
              SemanticPrimitiveNode(SemanticNil) -> true
              _ -> false
            }
            _ -> false
          }
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_node(graph, effects) {
          SemanticEffectSignatureNode(effect_list, SemanticOpenEffects(tail)) ->
            semantic_type_list_len(lists, effect_list) == 0 and tail == 1
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "remaining declaration-free authored forms preserve their semantic kind" {
  let module = registered(
    "fn forms<T>(bottom: never, top: any, weak_value: weak T, "
    |> str_concat("atomic_value: arc T, unique_value: unique T, owned_value: owned T, ")
    |> str_concat("continuation: Continuation<T, str>) -> any { top }")
  )
  let (graph, signature) = resolved_signature(module)
  match semantic_type_graph_node(graph, signature) {
    SemanticFunctionNode(parameters, result, _) -> {
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 0)) {
          SemanticBottomKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 1)) {
          SemanticTopKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 2)) {
          SemanticWeakKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 3)) {
          SemanticAtomicKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 4)) {
          SemanticUniqueKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 5)) {
          SemanticOwnedKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, list_type(graph, parameters, 6)) {
          SemanticContinuationKind -> true
          _ -> false
        }
      )
      Test.assert_true(
        match semantic_type_graph_kind(graph, result) {
          SemanticTopKind -> true
          _ -> false
        }
      )
    }
    _ -> Test.assert_true(false)
  }
}

test "structural record field names come from retained source ranges" {
  let module = registered("fn row(value: { alpha: i64, beta: str }) -> i64 { 0 }")
  let (graph, signature) = resolved_signature(module)
  match semantic_type_graph_node(graph, signature) {
    SemanticFunctionNode(parameters, _, _) -> match semantic_type_graph_node(
      graph,
      list_type(graph, parameters, 0)
    ) {
      SemanticRecordNode(fields, SemanticStructuralRecord, SemanticClosedRecord) -> {
        let records = semantic_type_graph_records_local(graph)
        Test.assert_eq_usize(semantic_type_record_field_count(records, fields), 2)
        Test.assert_true(
          match semantic_type_graph_record_field_name(
            graph,
            semantic_type_record_field_edge(records, fields, 0)
          ) {
            SemanticNamedRecordField(name) -> name == "alpha"
            _ -> false
          }
        )
        Test.assert_true(
          match semantic_type_graph_record_field_name(
            graph,
            semantic_type_record_field_edge(records, fields, 1)
          ) {
            SemanticNamedRecordField(name) -> name == "beta"
            _ -> false
          }
        )
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "all authored primitive codes map to typed semantic primitive variants" {
  let source = source_from_text("")
  let builder = resolve_primitives(
    semantic_type_graph_builder(semantic_type_segment_id(named_module_identity("p", 1))),
    source,
    0
  )
  Test.assert_eq_usize(builder.len(), 15)
  builder.drop()

  let mut code: i64 = 0
  while code < 15 {
    Test.assert_eq(resolved_primitive_code(code), code)
    code = code + 1
  }
}

test "declaration-dependent authored types are explicitly deferred to scope resolution" {
  let module = registered("fn named(value: Box<i64>) -> i64 { 0 }")
  let functions = module.functions
  let registered_function = functions.at(dense_index(0))
  let function = registered_function.syntax
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module.identity))
  match resolve_function_signature(builder, module.source, function) {
    (builder, SemanticTypeRejected(SemanticDeclarationResolutionRequired)) -> {
      Test.assert_eq_usize(builder.len(), 0)
      builder.drop()
    }
    (builder, _) -> {
      builder.drop()
      Test.assert_true(false)
      nil
    }
  }
}

test "malformed authored type states fail without a raw fallback" {
  let source = source_from_text("x")
  let segment = semantic_type_segment_id(named_module_identity("invalid", 1))

  let builder = semantic_type_graph_builder(segment)
  let (builder, invalid_primitive) = resolve_type(builder, source, PrimitiveTypeExpr(15))
  Test.assert_true(
    match invalid_primitive {
      SemanticTypeRejected(SemanticInvalidPrimitive(15)) -> true,
      _ -> false
    }
  )

  let (builder, invalid_array) = resolve_type(
    builder,
    source,
    ArrayTypeExpr(PrimitiveTypeExpr(0), 0 - 1)
  )
  Test.assert_true(
    match invalid_array {
      SemanticTypeRejected(SemanticInvalidArrayLength(length)) -> length == 0 - 1
      _ -> false
    }
  )

  let (builder, invalid_variable) = resolve_type(builder, source, VariableTypeExpr(0 - 2))
  Test.assert_true(
    match invalid_variable {
      SemanticTypeRejected(SemanticInvalidVariable(identity)) -> identity == 0 - 2
      _ -> false
    }
  )

  let (builder, missing) = resolve_type(builder, source, MissingTypeExpr)
  Test.assert_true(
    match missing { SemanticTypeRejected(SemanticMissingAuthoredType) -> true, _ -> false }
  )
  Test.assert_eq_usize(builder.len(), 0)
  builder.drop()
}

test "malformed records and function effects cannot enter the semantic graph" {
  let source = source_from_text("x")
  let segment = semantic_type_segment_id(named_module_identity("malformed", 1))
  let builder = semantic_type_graph_builder(segment)
  let malformed_field = TypeExprListCons(
    RecordFieldTypeExpr(
      0,
      PrimitiveTypeExpr(0),
      TypeNameRange { start: 2, length: 1 }
    ),
    TypeExprListNil,
    nil
  )
  let (builder, range_result) = resolve_type(
    builder,
    source,
    RecordTypeExpr(malformed_field, ExactTypeFields, NamedTypeFields)
  )
  Test.assert_true(
    match range_result {
      SemanticTypeRejected(SemanticInvalidRecordFieldRange(_)) -> true
      _ -> false
    }
  )

  let non_field = TypeExprListCons(PrimitiveTypeExpr(0), TypeExprListNil, nil)
  let (builder, field_result) = resolve_type(
    builder,
    source,
    RecordTypeExpr(non_field, ExactTypeFields, NamedTypeFields)
  )
  Test.assert_true(
    match field_result {
      SemanticTypeRejected(SemanticExpectedRecordField) -> true
      _ -> false
    }
  )

  let (builder, effects_result) = resolve_type(
    builder,
    source,
    FunctionTypeExpr(TypeExprListNil, PrimitiveTypeExpr(0), PrimitiveTypeExpr(0))
  )
  Test.assert_true(
    match effects_result {
      SemanticTypeRejected(SemanticUnsupportedAuthoredType(6)) -> true
      _ -> false
    }
  )
  Test.assert_eq_usize(builder.len(), 1)
  builder.drop()
}
