use stdlib/string

type Reader { value: i64 }
type Answer { Yes(i64), No }
type Box<T> { value: T }

impl Reader {
  fn read(self) -> Answer { if self.value < 0 { No } else { Yes(self.value) } }
}

impl<T> Box<T> {
  fn read(self) -> T { self.value }
}

fn invoke<T, E>(body: () -[E]> T) -[E]> T { body() }
fn pure_invoke<T>(body: () -> T) -> T { body() }

fn through<E>(value: i64, body: () -[E]> i64) -[E]> i64 {
  invoke(() => match Reader { value: value }.read() {
    Yes(result) -> result + body()
    No -> 0
  })
}

fn inferred<T>(value: T) -> T { pure_invoke(() => Box { value: value }.read()) }
fn explicit<T>(value: T) -> Box<T> { invoke(() => Box<T> { value: value }) }
fn nested<T>(value: T) -> () -> Box<T> { invoke(() => () => Box<T> { value: value }) }

effect ReadOffset { fn get() -> i64 }

test "generic callbacks preserve nominal method receiver construction" {
  Test.assert_eq(through(20, () => 22), 42)
  Test.assert_eq(through(-1, () => 22), 0)
}

test "generic record callbacks preserve residual effects" {
  let result = handle through(20, () => ReadOffset.get()) {
    ReadOffset.get() -> resume(22)
  }
  Test.assert_eq(result, 42)
}

test "inferred generic record callbacks specialize scalar and managed fields" {
  Test.assert_eq(inferred(42), 42)
  Test.assert_str_eq(inferred("managed".repeat(2)), "managedmanaged")
  Test.assert_eq_f64(inferred(0.25), 0.25)
}

test "explicit generic record callbacks return their specialized record" {
  Test.assert_eq(explicit(42).value, 42)
  Test.assert_str_eq(explicit("retained".repeat(2)).value, "retainedretained")
}

test "nested escaping callbacks retain constructor identity and captured storage" {
  let make = nested("captured".repeat(2))
  Test.assert_str_eq(make().value, "capturedcaptured")
  Test.assert_str_eq(make().value, "capturedcaptured")
}

test "record callbacks preserve wide structural field values" {
  let result = explicit((42, "wide".repeat(2)))
  Test.assert_eq(result.value.0, 42)
  Test.assert_str_eq(result.value.1, "widewide")
}
