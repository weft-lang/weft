use "stdlib/sorted_map.weft"
use "stdlib/sorted_set.weft"
use "stdlib/vector.weft"

fn sorted_keys_are_ordered_i64(keys: i64) -> i64 {
  let mut ok = 1
  let mut i = 1
  while ok == 1 and i < vector_len(keys) {
    if vector_get<i64>(keys, i - 1, 0) > vector_get<i64>(keys, i, 0) {
      ok = 0
    } else {
      i = i + 1
    }
  }
  ok
}

fn sorted_map_reverse_insert_property(n: i64) -> bool {
  let m = sorted_map_new<i64, i64>()
  let mut i = n
  while i >= 0 {
    sorted_map_put<i64, i64>(m, i, i * 10, sorted_cmp_i64)
    sorted_map_put<i64, i64>(m, i, i * 10 + 1, sorted_cmp_i64)
    i = i - 1
  }
  sorted_map_len(m) == n + 1 and
    sorted_keys_are_ordered_i64(sorted_map_keys<i64, i64>(m)) == 1 and
    sorted_map_get<i64, i64>(m, n, 0 - 1, sorted_cmp_i64) == n * 10 + 1
}

test "sorted_map_happy_insert_update_lookup_and_iteration" {
  let m = sorted_map_new<i64, str>()
  Test.assert_eq(sorted_map_put<i64, str>(m, 30, "thirty", sorted_cmp_i64), 1)
  Test.assert_eq(sorted_map_put<i64, str>(m, 10, "ten", sorted_cmp_i64), 1)
  Test.assert_eq(sorted_map_put<i64, str>(m, 20, "twenty", sorted_cmp_i64), 1)
  Test.assert_eq(sorted_map_put<i64, str>(m, 20, "TWENTY", sorted_cmp_i64), 0)

  let keys = sorted_map_keys<i64, str>(m)
  let vals = sorted_map_values<i64, str>(m)
  Test.assert_eq(sorted_map_len(m), 3)
  Test.assert_str_eq(sorted_map_get<i64, str>(m, 20, "missing", sorted_cmp_i64), "TWENTY")
  Test.assert_eq(vector_get<i64>(keys, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(keys, 1, 0), 20)
  Test.assert_eq(vector_get<i64>(keys, 2, 0), 30)
  Test.assert_str_eq(vector_get<str>(vals, 0, ""), "ten")
  Test.assert_str_eq(vector_get<str>(vals, 1, ""), "TWENTY")
  Test.assert_str_eq(vector_get<str>(vals, 2, ""), "thirty")
}

test "sorted_map_happy_entries_and_fold" {
  let m = sorted_map_new<i64, i64>()
  sorted_map_put<i64, i64>(m, 3, 30, sorted_cmp_i64)
  sorted_map_put<i64, i64>(m, 1, 10, sorted_cmp_i64)
  sorted_map_put<i64, i64>(m, 2, 20, sorted_cmp_i64)
  let entries = sorted_map_entries<i64, i64>(m)
  let first = vector_get<SortedEntry<i64, i64>>(entries, 0, sorted_entry<i64, i64>(0, 0))
  let sum = sorted_map_fold<i64, i64, i64>(m, 0, (acc: i64, key: i64, value: i64) => acc + key + value)
  Test.assert_eq(vector_len(entries), 3)
  Test.assert_eq(sorted_entry_key<i64, i64>(first), 1)
  Test.assert_eq(sorted_entry_value<i64, i64>(first), 10)
  Test.assert_eq(sum, 66)
}

test "sorted_map_sad_missing_empty_and_remove" {
  let m = sorted_map_new<i64, i64>()
  Test.assert_eq(sorted_map_is_empty(m), 1)
  Test.assert_eq(sorted_map_contains<i64, i64>(m, 7, sorted_cmp_i64), 0)
  Test.assert_eq(sorted_map_get<i64, i64>(m, 7, 99, sorted_cmp_i64), 99)
  Test.assert_eq(sorted_map_remove<i64, i64>(m, 7, sorted_cmp_i64), 0)

  sorted_map_put<i64, i64>(m, 2, 20, sorted_cmp_i64)
  sorted_map_put<i64, i64>(m, 1, 10, sorted_cmp_i64)
  sorted_map_put<i64, i64>(m, 3, 30, sorted_cmp_i64)
  Test.assert_eq(sorted_map_remove<i64, i64>(m, 2, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_map_len(m), 2)
  Test.assert_eq(sorted_map_contains<i64, i64>(m, 2, sorted_cmp_i64), 0)
  Test.assert_eq(vector_get<i64>(sorted_map_keys<i64, i64>(m), 1, 0), 3)
}

test "sorted_map_str_comparator_handles_empty_and_unicode" {
  let m = sorted_map_new<str, i64>()
  sorted_map_put<str, i64>(m, "Ω", 4, sorted_cmp_str)
  sorted_map_put<str, i64>(m, "beta", 3, sorted_cmp_str)
  sorted_map_put<str, i64>(m, "", 1, sorted_cmp_str)
  sorted_map_put<str, i64>(m, "alpha", 2, sorted_cmp_str)
  let keys = sorted_map_keys<str, i64>(m)
  Test.assert_str_eq(vector_get<str>(keys, 0, "missing"), "")
  Test.assert_str_eq(vector_get<str>(keys, 1, "missing"), "alpha")
  Test.assert_str_eq(vector_get<str>(keys, 2, "missing"), "beta")
  Test.assert_str_eq(vector_get<str>(keys, 3, "missing"), "Ω")
  Test.assert_eq(sorted_map_get<str, i64>(m, "Ω", 0, sorted_cmp_str), 4)
}

test "sorted_map_str_keys_and_values_update_remove" {
  let m = sorted_map_new<str, str>()
  Test.assert_eq(sorted_map_put<str, str>(m, "delta", "four", sorted_cmp_str), 1)
  Test.assert_eq(sorted_map_put<str, str>(m, "alpha", "one", sorted_cmp_str), 1)
  Test.assert_eq(sorted_map_put<str, str>(m, "gamma", "three", sorted_cmp_str), 1)
  Test.assert_eq(sorted_map_put<str, str>(m, "beta", "two", sorted_cmp_str), 1)
  Test.assert_eq(sorted_map_put<str, str>(m, "gamma", "THREE", sorted_cmp_str), 0)
  Test.assert_str_eq(sorted_map_get<str, str>(m, "gamma", "missing", sorted_cmp_str), "THREE")
  Test.assert_eq(sorted_map_remove<str, str>(m, "beta", sorted_cmp_str), 1)
  Test.assert_eq(sorted_map_len(m), 3)
  let keys = sorted_map_keys<str, str>(m)
  let vals = sorted_map_values<str, str>(m)
  Test.assert_str_eq(vector_get<str>(keys, 0, "fallback"), "alpha")
  Test.assert_str_eq(vector_get<str>(keys, 1, "fallback"), "delta")
  Test.assert_str_eq(vector_get<str>(keys, 2, "fallback"), "gamma")
  Test.assert_str_eq(vector_get<str>(vals, 2, "fallback"), "THREE")
  Test.assert_eq(sorted_map_contains<str, str>(m, "beta", sorted_cmp_str), 0)
}

test "sorted_set_happy_insert_remove_and_values" {
  let set = sorted_set_new<i64>()
  Test.assert_eq(sorted_set_insert<i64>(set, 3, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_set_insert<i64>(set, 1, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_set_insert<i64>(set, 2, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_set_insert<i64>(set, 2, sorted_cmp_i64), 0)
  Test.assert_eq(sorted_set_contains<i64>(set, 2, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_set_remove<i64>(set, 2, sorted_cmp_i64), 1)
  Test.assert_eq(sorted_set_contains<i64>(set, 2, sorted_cmp_i64), 0)
  Test.assert_eq(sorted_set_len(set), 2)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(set), 0, 0), 1)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(set), 1, 0), 3)
}

test "sorted_set_union_intersection_difference" {
  let a = sorted_set_new<i64>()
  let b = sorted_set_new<i64>()
  sorted_set_insert<i64>(a, 1, sorted_cmp_i64)
  sorted_set_insert<i64>(a, 2, sorted_cmp_i64)
  sorted_set_insert<i64>(a, 4, sorted_cmp_i64)
  sorted_set_insert<i64>(b, 2, sorted_cmp_i64)
  sorted_set_insert<i64>(b, 3, sorted_cmp_i64)
  sorted_set_insert<i64>(b, 4, sorted_cmp_i64)
  let unioned = sorted_set_union<i64>(a, b, sorted_cmp_i64)
  let both = sorted_set_intersection<i64>(a, b, sorted_cmp_i64)
  let only_a = sorted_set_difference<i64>(a, b, sorted_cmp_i64)
  Test.assert_eq(sorted_set_len(unioned), 4)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(unioned), 2, 0), 3)
  Test.assert_eq(sorted_set_len(both), 2)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(both), 0, 0), 2)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(both), 1, 0), 4)
  Test.assert_eq(sorted_set_len(only_a), 1)
  Test.assert_eq(vector_get<i64>(sorted_set_values<i64>(only_a), 0, 0), 1)
}

test "sorted_set_str_union_intersection_difference" {
  let a = sorted_set_new<str>()
  let b = sorted_set_new<str>()
  sorted_set_insert<str>(a, "alpha", sorted_cmp_str)
  sorted_set_insert<str>(a, "omega", sorted_cmp_str)
  sorted_set_insert<str>(b, "omega", sorted_cmp_str)
  sorted_set_insert<str>(b, "zeta", sorted_cmp_str)
  let unioned = sorted_set_union<str>(a, b, sorted_cmp_str)
  let both = sorted_set_intersection<str>(a, b, sorted_cmp_str)
  let only_a = sorted_set_difference<str>(a, b, sorted_cmp_str)
  Test.assert_eq(sorted_set_len(unioned), 3)
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(unioned), 0, "fallback"), "alpha")
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(unioned), 1, "fallback"), "omega")
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(unioned), 2, "fallback"), "zeta")
  Test.assert_eq(sorted_set_len(both), 1)
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(both), 0, "fallback"), "omega")
  Test.assert_eq(sorted_set_len(only_a), 1)
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(only_a), 0, "fallback"), "alpha")
}

test "sorted_set_sad_empty_and_missing" {
  let set = sorted_set_new<str>()
  Test.assert_eq(sorted_set_is_empty(set), 1)
  Test.assert_eq(sorted_set_contains<str>(set, "missing", sorted_cmp_str), 0)
  Test.assert_eq(sorted_set_remove<str>(set, "missing", sorted_cmp_str), 0)
  sorted_set_insert<str>(set, "Ω", sorted_cmp_str)
  sorted_set_insert<str>(set, "", sorted_cmp_str)
  Test.assert_eq(sorted_set_len(set), 2)
  Test.assert_str_eq(vector_get<str>(sorted_set_values<str>(set), 0, "fallback"), "")
}

test "property_sorted_map_reverse_insertions_keep_keys_sorted" {
  Test.forall_i64_range(0, 12, sorted_map_reverse_insert_property)
}
