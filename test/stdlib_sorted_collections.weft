use stdlib/sorted_map as sorted_map
use stdlib/sorted_map.{SortedEntry, SortedFound, SortedMap, SortedMissing, sorted_map_find, sorted_map_key_at, sorted_map_vector}
use stdlib/sorted_set as sorted_set
use stdlib/sorted_set.{SortedSet}
use stdlib/iter.{Collect, IntoIterator, Iterator}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{*}
use stdlib/ord.{*}
use stdlib/vector as vector
use stdlib/vector.{*}
use runtime/vector_storage.{*}
use runtime/rc.{*}
use runtime/rc_implicit_test.{*}

type ReverseI64 {
  ReverseI64(i64)
}

impl Ord for ReverseI64 {
  fn compare(self, other: Self) -> Ordering {
    match self {
      ReverseI64(left) -> match other {
        ReverseI64(right) -> {
          if left > right { Less } else { if left < right { Greater } else { Equal } }
        }
      }
    }
  }
}

fn reverse_i64_value(value: ReverseI64) -> i64 {
  match value { ReverseI64(inner) -> inner }
}

fn sorted_keys_are_ordered_i64(keys: Vector<i64>) -> bool {
  let mut ok = true
  let mut i = 1
  while ok and i < vector_len<i64>(keys) {
    if vector_get<i64>(keys, i - 1, 0) > vector_get<i64>(keys, i, 0) {
      ok = false
    } else {
      i = i + 1
    }
  }
  ok
}

fn sorted_map_reverse_insert_property(n: i64) -> bool {
  let m = sorted_map.new<i64, i64>()
  let mut i = n
  while i >= 0 {
    m.insert(i, i * 10)
    m.insert(i, i * 10 + 1)
    i = i - 1
  }
  m.len() == n + 1 and
    sorted_keys_are_ordered_i64(m.keys()) and
    m.get(n).unwrap_or(0 - 1) == n * 10 + 1
}

fn sorted_map_repeated_find_scope_addr() -> i64 {
  let m = sorted_map.new<i64, i64>()
  m.insert(10, 1)
  m.insert(20, 2)
  let entries = sorted_map_vector<i64, i64>(m)
  let addr = vector_storage_handle_word<SortedEntry<i64, i64>>(entries)
  let mut total = 0
  let mut i = 0
  while i < 256 {
    let search = sorted_map_find<i64, i64>(m, if i - (i / 2) * 2 == 0 { 10 } else { 15 })
    match search {
      SortedFound(index) -> { total = total + index }
      SortedMissing(index) -> { total = total + index }
    }
    i = i + 1
  }
  if total == 128 { addr } else { 0 }
}

test "sorted_map_happy_insert_update_lookup_and_iteration" {
  let m = sorted_map.new<i64, str>()
  Test.assert_true(m.insert(30, "thirty"))
  Test.assert_true(m.insert(10, "ten"))
  Test.assert_true(m.insert(20, "twenty"))
  Test.assert_false(m.insert(20, "TWENTY"))

  let keys = m.keys()
  let vals = m.values()
  Test.assert_eq(m.len(), 3)
  Test.assert_str_eq(m.get(20).unwrap_or("missing"), "TWENTY")
  Test.assert_eq(vector_get<i64>(keys, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(keys, 1, 0), 20)
  Test.assert_eq(vector_get<i64>(keys, 2, 0), 30)
  Test.assert_str_eq(vector_get<str>(vals, 0, ""), "ten")
  Test.assert_str_eq(vector_get<str>(vals, 1, ""), "TWENTY")
  Test.assert_str_eq(vector_get<str>(vals, 2, ""), "thirty")
}

test "sorted_map_repeated_find_releases_backing_vector_once" {
  let old_addr = sorted_map_repeated_find_scope_addr()
  let next = vector.new<SortedEntry<i64, i64>>()
  Test.assert_eq(vector_storage_handle_word<SortedEntry<i64, i64>>(next), old_addr)
}

test "sorted_map_happy_entries_and_fold" {
  let m = sorted_map.new<i64, i64>()
  m.insert(3, 30)
  m.insert(1, 10)
  m.insert(2, 20)
  let entries = m.entries()
  let (first_key, first_value) = vector_get<(i64, i64)>(entries, 0, (0, 0))
  let sum = m.fold<i64>(0, (acc: i64, key: i64, value: i64) => acc + key + value)
  Test.assert_eq(vector_len<(i64, i64)>(entries), 3)
  Test.assert_eq(first_key, 1)
  Test.assert_eq(first_value, 10)
  Test.assert_eq(sum, 66)
}

test "sorted_map_sad_missing_empty_and_remove" {
  let m = sorted_map.new<i64, i64>()
  Test.assert_true(m.is_empty())
  Test.assert_false(m.contains_key(7))
  Test.assert_true(m.get(7).is_none())
  Test.assert_true(m.remove(7).is_none())

  m.insert(2, 20)
  m.insert(1, 10)
  m.insert(3, 30)
  Test.assert_eq(m.remove(2).unwrap_or(0), 20)
  Test.assert_eq(m.len(), 2)
  Test.assert_false(m.contains_key(2))
  Test.assert_eq(vector_get<i64>(m.keys(), 1, 0), 3)
}

test "sorted_map_str_order_handles_empty_and_unicode" {
  let m = sorted_map.new<str, i64>()
  m.insert("Ω", 4)
  m.insert("beta", 3)
  m.insert("", 1)
  m.insert("alpha", 2)
  let keys = m.keys()
  Test.assert_str_eq(vector_get<str>(keys, 0, "missing"), "")
  Test.assert_str_eq(vector_get<str>(keys, 1, "missing"), "alpha")
  Test.assert_str_eq(vector_get<str>(keys, 2, "missing"), "beta")
  Test.assert_str_eq(vector_get<str>(keys, 3, "missing"), "Ω")
  Test.assert_eq(m.get("Ω").unwrap_or(0), 4)
}

test "sorted_map_str_keys_and_values_update_remove" {
  let m = sorted_map.new<str, str>()
  Test.assert_true(m.insert("delta", "four"))
  Test.assert_true(m.insert("alpha", "one"))
  Test.assert_true(m.insert("gamma", "three"))
  Test.assert_true(m.insert("beta", "two"))
  Test.assert_false(m.insert("gamma", "THREE"))
  Test.assert_str_eq(m.get("gamma").unwrap_or("missing"), "THREE")
  Test.assert_str_eq(m.remove("beta").unwrap_or("missing"), "two")
  Test.assert_eq(m.len(), 3)
  let keys = m.keys()
  let vals = m.values()
  Test.assert_str_eq(vector_get<str>(keys, 0, "fallback"), "alpha")
  Test.assert_str_eq(vector_get<str>(keys, 1, "fallback"), "delta")
  Test.assert_str_eq(vector_get<str>(keys, 2, "fallback"), "gamma")
  Test.assert_str_eq(vector_get<str>(vals, 2, "fallback"), "THREE")
  Test.assert_false(m.contains_key("beta"))
}

test "sorted_map_remove_transfers_managed_value" {
  let probe = runtime_rc_probe_new(42)
  let map = sorted_map.new<i64, RuntimeRcProbe>()
  map.insert(7, probe)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  let removed = map.remove(7)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  match removed {
    Some(value) -> Test.assert_eq(runtime_rc_probe_count(value), 2)
    None -> Test.assert_true(false)
  }
  Test.assert_true(map.is_empty())
}

test "sorted_set_happy_insert_remove_and_values" {
  let set = sorted_set.new<i64>()
  Test.assert_true(set.insert(3))
  Test.assert_true(set.insert(1))
  Test.assert_true(set.insert(2))
  Test.assert_false(set.insert(2))
  Test.assert_true(set.contains(2))
  Test.assert_true(set.remove(2))
  Test.assert_false(set.contains(2))
  Test.assert_eq(set.len(), 2)
  Test.assert_eq(vector_get<i64>(set.values(), 0, 0), 1)
  Test.assert_eq(vector_get<i64>(set.values(), 1, 0), 3)
}

test "sorted_set_union_intersection_difference" {
  let a = sorted_set.new<i64>()
  let b = sorted_set.new<i64>()
  a.insert(1)
  a.insert(2)
  a.insert(4)
  b.insert(2)
  b.insert(3)
  b.insert(4)
  let unioned = a.union(b)
  let both = a.intersection(b)
  let only_a = a.difference(b)
  Test.assert_eq(unioned.len(), 4)
  Test.assert_eq(vector_get<i64>(unioned.values(), 2, 0), 3)
  Test.assert_eq(both.len(), 2)
  Test.assert_eq(vector_get<i64>(both.values(), 0, 0), 2)
  Test.assert_eq(vector_get<i64>(both.values(), 1, 0), 4)
  Test.assert_eq(only_a.len(), 1)
  Test.assert_eq(vector_get<i64>(only_a.values(), 0, 0), 1)
}

test "sorted_set_str_union_intersection_difference" {
  let a = sorted_set.new<str>()
  let b = sorted_set.new<str>()
  a.insert("alpha")
  a.insert("omega")
  b.insert("omega")
  b.insert("zeta")
  let unioned = a.union(b)
  let both = a.intersection(b)
  let only_a = a.difference(b)
  Test.assert_eq(unioned.len(), 3)
  Test.assert_str_eq(vector_get<str>(unioned.values(), 0, "fallback"), "alpha")
  Test.assert_str_eq(vector_get<str>(unioned.values(), 1, "fallback"), "omega")
  Test.assert_str_eq(vector_get<str>(unioned.values(), 2, "fallback"), "zeta")
  Test.assert_eq(both.len(), 1)
  Test.assert_str_eq(vector_get<str>(both.values(), 0, "fallback"), "omega")
  Test.assert_eq(only_a.len(), 1)
  Test.assert_str_eq(vector_get<str>(only_a.values(), 0, "fallback"), "alpha")
}

test "sorted_set_sad_empty_and_missing" {
  let set = sorted_set.new<str>()
  Test.assert_true(set.is_empty())
  Test.assert_false(set.contains("missing"))
  Test.assert_false(set.remove("missing"))
  set.insert("Ω")
  set.insert("")
  Test.assert_eq(set.len(), 2)
  Test.assert_str_eq(vector_get<str>(set.values(), 0, "fallback"), "")
}

test "sorted_collections_collect_with_canonical_order" {
  let set_source = Cons<i64>(4, Cons<i64>(1, Cons<i64>(4, Cons<i64>(2, Nil<i64>()))))
  let set = set_source.into_iter().collect<SortedSet<i64>>()
  let entries = Cons<(i64, str)>((3, "three"), Cons<(i64, str)>((1, "one"), Cons<(i64, str)>((3, "THREE"), Nil<(i64, str)>())))
  let map = entries.into_iter().collect<SortedMap<i64, str>>()

  Test.assert_eq(set.len(), 3)
  Test.assert_eq(vector_get<i64>(set.values(), 0, 0), 1)
  Test.assert_eq(vector_get<i64>(set.values(), 2, 0), 4)
  Test.assert_eq(map.len(), 2)
  Test.assert_eq(vector_get<i64>(map.keys(), 0, 0), 1)
  Test.assert_str_eq(map.get(3).unwrap_or("missing"), "THREE")
}

test "sorted_collections_take_custom_order_from_key_type" {
  let map = sorted_map.new<ReverseI64, i64>()
  map.insert(ReverseI64(1), 10)
  map.insert(ReverseI64(3), 30)
  map.insert(ReverseI64(2), 20)
  let keys = map.keys()
  Test.assert_eq(reverse_i64_value(vector_get<ReverseI64>(keys, 0, ReverseI64(0))), 3)
  Test.assert_eq(reverse_i64_value(vector_get<ReverseI64>(keys, 2, ReverseI64(0))), 1)
}

test "property_sorted_map_reverse_insertions_keep_keys_sorted" {
  Test.forall_i64_range(0, 12, sorted_map_reverse_insert_property)
}

test "sorted_map_key_at_scalar_and_bounds_walk" {
  let m = sorted_map.new<i64, i64>()
  m.insert(30, 3)
  m.insert(10, 1)
  m.insert(20, 2)
  Test.assert_eq(sorted_map_key_at<i64, i64>(m, 0), 10)
  Test.assert_eq(sorted_map_key_at<i64, i64>(m, 1), 20)
  Test.assert_eq(sorted_map_key_at<i64, i64>(m, 2), 30)
  -- keys track updates and removals
  m.remove(20)
  Test.assert_eq(sorted_map_key_at<i64, i64>(m, 0), 10)
  Test.assert_eq(sorted_map_key_at<i64, i64>(m, 1), 30)
}

test "sorted_map_key_at_managed_keys_stay_owned" {
  -- Managed keys come back retained (+1): reading the same key many
  -- times and keeping the reads alive across further map mutation must
  -- not free the underlying string.
  let m = sorted_map.new<str, i64>()
  m.insert("gamma", 3)
  m.insert("alpha", 1)
  m.insert("Ωmega", 24)
  let k0 = sorted_map_key_at<str, i64>(m, 0)
  let k1 = sorted_map_key_at<str, i64>(m, 1)
  let mut i = 0
  while i < 64 {
    let again = sorted_map_key_at<str, i64>(m, 2)
    Test.assert_str_eq(again, "Ωmega")
    i = i + 1
  }
  -- mutate the map after taking the reads
  m.remove("gamma")
  Test.assert_str_eq(k0, "alpha")
  Test.assert_str_eq(k1, "gamma")
  Test.assert_eq(m.len(), 2)
  Test.assert_true(m.contains_key("alpha"))
}

test "vector_get_field_in_bounds_reads_both_payloads" {
  let m = sorted_map.new<i64, i64>()
  m.insert(7, 70)
  m.insert(9, 90)
  let entries = sorted_map_vector<i64, i64>(m)
  Test.assert_eq(vector_get_field_in_bounds<SortedEntry<i64, i64>, i64>(entries, 0, 0), 7)
  Test.assert_eq(vector_get_field_in_bounds<SortedEntry<i64, i64>, i64>(entries, 0, 1), 70)
  Test.assert_eq(vector_get_field_in_bounds<SortedEntry<i64, i64>, i64>(entries, 1, 0), 9)
  Test.assert_eq(vector_get_field_in_bounds<SortedEntry<i64, i64>, i64>(entries, 1, 1), 90)
}

test "sorted_map_find_after_key_at_migration_all_paths" {
  -- The find loop now compares through the borrowed key read: exercise
  -- hit-at-every-position and both miss directions on i64 and str keys.
  let m = sorted_map.new<i64, i64>()
  let mut i = 0
  while i < 9 {
    m.insert(i * 10, i)
    i = i + 1
  }
  let mut j = 0
  while j < 9 {
    let s = sorted_map_find<i64, i64>(m, j * 10)
    match s {
      SortedFound(index) -> Test.assert_eq(index, j)
      SortedMissing(index) -> Test.assert_true(false)
    }
    j = j + 1
  }
  match sorted_map_find<i64, i64>(m, 0 - 5) {
    SortedFound(index) -> Test.assert_true(false)
    SortedMissing(index) -> Test.assert_eq(index, 0)
  }
  match sorted_map_find<i64, i64>(m, 95) {
    SortedFound(index) -> Test.assert_true(false)
    SortedMissing(index) -> Test.assert_eq(index, 9)
  }
  match sorted_map_find<i64, i64>(m, 45) {
    SortedFound(index) -> Test.assert_true(false)
    SortedMissing(index) -> Test.assert_eq(index, 5)
  }
  let ms = sorted_map.new<str, i64>()
  ms.insert("bb", 2)
  ms.insert("aa", 1)
  ms.insert("cc", 3)
  match sorted_map_find<str, i64>(ms, "bb") {
    SortedFound(index) -> Test.assert_eq(index, 1)
    SortedMissing(index) -> Test.assert_true(false)
  }
  match sorted_map_find<str, i64>(ms, "ab") {
    SortedFound(index) -> Test.assert_true(false)
    SortedMissing(index) -> Test.assert_eq(index, 1)
  }
}
