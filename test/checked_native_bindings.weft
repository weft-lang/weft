-- Manifest-declared native functions on the typed path: each is a private
-- value declaration of its trusted binding module whose signature follows its
-- ABI kinds and performs exactly the SDK's sealed `Unsafe`.

use compiler/package/native_abi.{
  NativeAbiConstBytes,
  NativeAbiConstPointer,
  NativeAbiF32,
  NativeAbiF64,
  NativeAbiI16,
  NativeAbiI32,
  NativeAbiI64,
  NativeAbiI8,
  NativeAbiIsize,
  NativeAbiMutBytes,
  NativeAbiMutPointer,
  NativeAbiNil,
  NativeAbiOpaquePointer,
  NativeAbiType,
  NativeAbiU16,
  NativeAbiU32,
  NativeAbiU64,
  NativeAbiU8,
  NativeAbiUsize
}
use compiler/project/identity.{ModuleIdentity, ValueDeclaration, named_module_identity}
use compiler/project/module.{PrivateVisibility}
use compiler/source/input.{source_from_text}
use compiler/source/trust.{TrustedSourceAuthority}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/weft/check/body/producer.{
  CheckedBodiesAccepted,
  CheckedBodiesRejected,
  check_registered_bodies
}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{
  RegisteredModule,
  RegisteredNativeFunction,
  synthetic_module_name
}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/registration/scope.{RegistrationBuilder}
use compiler/weft/check/rejection.{checked_body_producer_issue_category}
use compiler/weft/check/resolution.{
  SemanticResolutionAccepted,
  resolve_module_semantics
}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/list as list
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/string.{str_concat}
use stdlib/test.{Test}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn trusted(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register_with_authority(
    parsed.declarations,
    parsed.source.source(),
    module,
    TrustedSourceAuthority
  )
}

type NativeSpec {
  name: str,
  parameters: List<NativeAbiType>,
  result: NativeAbiType
}

fn add_natives(
  builder: RegistrationBuilder,
  module: ModuleIdentity,
  natives: List<NativeSpec>
) -> nil {
  match natives {
    Nil -> nil
    Cons(spec, rest) -> {
      registration_scope.registration_builder_add_native(
        builder,
        module,
        RegisteredNativeFunction {
          name: synthetic_module_name(module, ValueDeclaration, spec.name, PrivateVisibility),
          parameters: spec.parameters,
          result: spec.result
        }
      )
      add_natives(builder, module, rest)
    }
  }
}

-- Check a trusted binding module whose first import names the SDK's
-- `runtime/unsafe`, registered in `unsafe_package`, with the given natives.
fn binding_outcome(
  text: str,
  natives: List<NativeSpec>,
  unsafe_package: i64,
  discriminator: i64
) -[Test]> str {
  let unsafe_module = trusted(
    "pub effect Unsafe { fn transmute(value: any) -> any }",
    named_module_identity("runtime/unsafe", unsafe_package)
  )
  let binding = trusted(
    str_concat("use runtime/unsafe.{Unsafe} ", text),
    named_module_identity("runtime/fixture_binding", discriminator)
  )
  let builder = registration_scope.registration_builder()
  registration_scope.registration_builder_add(builder, unsafe_module)
  registration_scope.registration_builder_add(builder, binding)
  registration_scope.registration_builder_resolve_import(
    builder,
    binding.identity,
    unsafe_module.identity,
    binding.syntax.imports.get(0).unwrap(),
    false
  )
  add_natives(builder, binding.identity, natives)
  let scope = registration_scope.registration_builder_freeze(builder)
  let registered = registration_scope.registration_scope_find(scope, binding.identity).unwrap()
  match resolve_module_semantics(registered, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let result = handle check_registered_bodies(registered, scope, resolution, discriminator) {
        SemanticConformance.conforms(_, concrete, trait_atom) -> resume(false)
      }
      match result {
        CheckedBodiesAccepted(_) -> "accepted"
        CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
      }
    }
    _ -> "unresolved"
  }
}

fn one(name: str, parameters: List<NativeAbiType>, result: NativeAbiType) -> List<NativeSpec> {
  Nil<NativeSpec>().prepend(NativeSpec { name: name, parameters: parameters, result: result })
}

fn feed() -> List<NativeSpec> {
  let parameters = [NativeAbiOpaquePointer, NativeAbiConstBytes]
  one("native_feed", list.from_slice(parameters[..]), NativeAbiI64)
}

test "a native function's signature follows its ABI kinds and performs Unsafe" {
  Test.assert_str_eq(
    binding_outcome(
      "fn call(session: * any, values: [u8]) -[Unsafe]> i64 { native_feed(session, values) }",
      feed(),
      4001,
      4001
    ),
    "accepted"
  )
  -- The binding module seals the effect behind a handler, as the SDK does.
  Test.assert_str_eq(
    binding_outcome(
      "fn call(session: * any, values: [u8]) -> i64 { handle native_feed(session, values) { Unsafe.transmute(raw) -> resume(__transmute(raw)) } }",
      feed(),
      4002,
      4002
    ),
    "accepted"
  )
  -- A native function is a value of its signature.
  Test.assert_str_eq(
    binding_outcome(
      "fn call(session: * any, values: [u8]) -[Unsafe]> i64 { let f = native_feed f(session, values) }",
      feed(),
      4003,
      4003
    ),
    "accepted"
  )
}

test "every ABI kind crosses as its Weft type" {
  let all_kinds = [
    NativeAbiI8,
    NativeAbiU8,
    NativeAbiI16,
    NativeAbiU16,
    NativeAbiI32,
    NativeAbiU32,
    NativeAbiI64,
    NativeAbiU64,
    NativeAbiIsize,
    NativeAbiUsize,
    NativeAbiF32,
    NativeAbiF64,
    NativeAbiOpaquePointer,
    NativeAbiConstPointer,
    NativeAbiMutPointer,
    NativeAbiConstBytes,
    NativeAbiMutBytes
  ]
  let every = list.from_slice(all_kinds[..])
  Test.assert_str_eq(
    binding_outcome(
      "fn call(a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64, i: isize, j: usize, k: f32, l: f64, m: * any, n: * u8, o: * mut u8, p: [u8], q: [mut u8]) -[Unsafe]> nil { every(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q) }",
      one("every", every, NativeAbiNil),
      4011,
      4011
    ),
    "accepted"
  )
  -- Each result kind is the call's type.
  let results = [
    ("u8", NativeAbiU8),
    ("f32", NativeAbiF32),
    ("* any", NativeAbiOpaquePointer),
    ("* mut u8", NativeAbiMutPointer),
    ("nil", NativeAbiNil)
  ]
  let mut index: usize = 0
  while index < results.len {
    let (spelling, kind) = results[index]
    Test.assert_str_eq(
      binding_outcome(
        i"fn call() -[Unsafe]> {spelling} {{ produce() }}",
        one("produce", Nil<NativeAbiType>(), kind),
        4020 + __u64_to_i64(__usize_to_u64(index)),
        4020 + __u64_to_i64(__usize_to_u64(index))
      ),
      "accepted"
    )
    index = index + 1
  }
}

test "a native call keeps its effect, arguments and result honest" {
  let refused = [
    -- The raw call performs Unsafe, which a pure caller lacks.
    (
      "fn call(session: * any, values: [u8]) -> i64 { native_feed(session, values) }",
      "effect_unavailable"
    ),
    -- Mutable and immutable buffers and pointers never substitute.
    (
      "fn call(session: * any, values: [mut u8]) -[Unsafe]> i64 { native_feed(session, values) }",
      "type_mismatch"
    ),
    (
      "fn call(session: * any, values: [u8]) -[Unsafe]> i64 { native_feed(values, session) }",
      "type_mismatch"
    ),
    ("fn call(session: * any) -[Unsafe]> i64 { native_feed(session, 1) }", "type_mismatch"),
    (
      "fn call(session: * any, values: [u8]) -[Unsafe]> str { native_feed(session, values) }",
      "type_mismatch"
    ),
    ("fn call(session: * any) -[Unsafe]> i64 { native_feed(session) }", "arity_mismatch")
  ]
  let mut index: usize = 0
  while index < refused.len {
    let (text, expected) = refused[index]
    Test.assert_str_eq(
      binding_outcome(
        text,
        feed(),
        4031 + __u64_to_i64(__usize_to_u64(index)),
        4031 + __u64_to_i64(__usize_to_u64(index))
      ),
      expected
    )
    index = index + 1
  }
}

test "only the SDK's runtime Unsafe types a native call" {
  -- A `runtime/unsafe` outside the SDK package cannot supply the sealed
  -- effect, so the native function has no signature.
  Test.assert_str_eq(
    binding_outcome(
      "fn call(session: * any, values: [u8]) -[Unsafe]> i64 { native_feed(session, values) }",
      feed(),
      4041,
      4042
    ),
    "signature_unavailable"
  )
  -- A name the manifest does not declare is still unknown.
  Test.assert_str_eq(
    binding_outcome(
      "fn call(session: * any, values: [u8]) -[Unsafe]> i64 { native_drain(session, values) }",
      feed(),
      4043,
      4043
    ),
    "unknown_identifier"
  )
}
