use compiler/comptime_artifact.{*}
use compiler/native_link.{*}
use compiler/native_target.{NativeLinkLinuxAarch64}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/comptime.{ComptimeFileObservation}
use stdlib/eq.{Eq}
use stdlib/io/types.{IoError, IoNotFound}
use stdlib/list as list
use stdlib/list.{Cons, Nil}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result as result
use stdlib/result.{Result, Ok, Err}

fn comptime_artifact_test_facts() -> NativeArtifactFacts {
  NativeArtifactFacts {
    target: NativeLinkLinuxAarch64,
    platform: NativeArtifactLinuxKernelAbi(3, 7, 0),
    standalone: true,
    dependencies: Nil<NativeArtifactDependency>(),
    static_inputs: Nil<NativeArtifactStaticInput>(),
    compile_time_inputs: Nil<NativeArtifactCompileTimeInput>(),
    trust_grants: Nil<NativeArtifactTrustGrant>(),
    debug_information: NativeArtifactDebugInformationAbsent,
    signing: NativeArtifactUnsigned,
    symbols: Nil<NativeLinkSymbol>()
  }
}

fn comptime_artifact_observation(file: Path, limit: usize, content: str) -> ComptimeFileObservation {
  ComptimeFileObservation {
    path: file,
    limit: limit,
    outcome: Ok<Bytes, IoError>(bytes.from_str(content))
  }
}

test "artifact facts retain ordered exact compile-time file observations" {
  let raw_path_bytes: [u8; 1] = [255]
  let observed = [
    comptime_artifact_observation(path.from_utf8("a").unwrap(), 8, "alpha"),
    comptime_artifact_observation(path.from_bytes(bytes.from_slice(raw_path_bytes[..])).unwrap(), 16, "beta")
  ]
  match comptime_artifact_facts(comptime_artifact_test_facts(), list.from_slice(observed[..])) {
    Err(_) -> Test.assert_true(false)
    Ok(facts) -> match facts.compile_time_inputs {
      Cons(first, Cons(second, Nil)) -> {
        Test.assert_true(first.path.eq(path.from_utf8("a").unwrap()))
        Test.assert_eq_usize(first.limit, 8)
        Test.assert_eq_usize(first.size, 5)
        Test.assert_str_eq(first.content, "sha256:8ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f8")
        Test.assert_true(second.path.eq(path.from_bytes(bytes.from_slice(raw_path_bytes[..])).unwrap()))
        Test.assert_eq_usize(second.limit, 16)
        Test.assert_eq_usize(second.size, 4)
        Test.assert_str_eq(second.content, "sha256:f44e64e75f3948e9f73f8dfa94721c4ce8cbb4f265c4790c702b2d41cfbf2753")
      }
      _ -> Test.assert_true(false)
    }
  }
}

test "artifact JSON preserves native path bytes and unsigned bounds" {
  let observed = [comptime_artifact_observation(path.from_utf8("a").unwrap(), 8, "alpha")]
  let facts = comptime_artifact_facts(comptime_artifact_test_facts(), list.from_slice(observed[..])).unwrap()
  Test.assert_str_eq(
    native_link_artifact_facts_render(facts),
    "{\"artifact_facts_version\":4,\"target\":\"linux-aarch64\",\"minimum_platform_abi\":{\"platform\":\"linux\",\"abi\":\"kernel\",\"major\":3,\"minor\":7,\"patch\":0,\"libc\":\"none\",\"dynamic_loader\":\"none\"},\"standalone\":true,\"sdk\":{\"kind\":\"absent\"},\"dependencies\":[],\"static_inputs\":[],\"compile_time_inputs\":[{\"path_bytes\":[97],\"limit\":\"8\",\"size\":\"5\",\"content\":\"sha256:8ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f8\"}],\"trust_grants\":[],\"debug_information\":{\"kind\":\"absent\"},\"signing\":{\"kind\":\"unsigned\"},\"dynamic_symbols\":[]}\n"
  )
}

test "failed compile-time reads cannot become successful artifact facts" {
  let missing = path.from_utf8("missing.schema").unwrap()
  let observed = [ComptimeFileObservation {
    path: missing,
    limit: 32,
    outcome: Err<Bytes, IoError>(IoNotFound)
  }]
  Test.assert_true(match comptime_artifact_facts(comptime_artifact_test_facts(), list.from_slice(observed[..])) {
    Err(ComptimeArtifactReadFailed(actual, IoNotFound)) -> actual.eq(missing)
    _ -> false
  })
}

test "changed observed content changes the artifact dependency identity" {
  let file = path.from_utf8("schema.json").unwrap()
  let before_observations = [comptime_artifact_observation(file, 64, "alpha")]
  let after_observations = [comptime_artifact_observation(file, 64, "beta")]
  let before = comptime_artifact_facts(comptime_artifact_test_facts(), list.from_slice(before_observations[..])).unwrap()
  let after = comptime_artifact_facts(comptime_artifact_test_facts(), list.from_slice(after_observations[..])).unwrap()
  match (before.compile_time_inputs, after.compile_time_inputs) {
    (Cons(before_input, Nil), Cons(after_input, Nil)) -> Test.assert_true(before_input.content != after_input.content)
    _ -> Test.assert_true(false)
  }
  Test.assert_true(native_link_artifact_facts_render(before) != native_link_artifact_facts_render(after))
}
