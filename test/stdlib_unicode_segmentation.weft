use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}
use stdlib/unicode.{*}
use stdlib/utf8.{utf8_encode_scalar_into, utf8_encode_scalar_len}
use test/unicode_segmentation_conformance_data.{*}

fn unicode_segmentation_case_text(value: UnicodeSegmentationTestCase) -> str {
  let count = unicode_segmentation_test_case_count(value)
  let mut n = 0
  let mut i = 0
  while i < count {
    n = n + utf8_encode_scalar_len(unicode_segmentation_test_case_scalar(value, i))
    i = i + 1
  }
  let text = runtime_str_alloc_uninit(n)
  let data = runtime_str_ptr(text)
  let mut pos = 0
  i = 0
  while i < count {
    pos = utf8_encode_scalar_into(data, pos, unicode_segmentation_test_case_scalar(value, i))
    i = i + 1
  }
  text
}

test "Unicode 17 extended grapheme boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut case_index = 0
  while case_index < unicode_grapheme_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_grapheme_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = unicode_is_grapheme_boundary(text, byte_offset)
      if expected != actual { failures = failures + 1 } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8_encode_scalar_len(unicode_segmentation_test_case_scalar(value, scalar_index))
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
}

test "Unicode 17 default word boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut first_failure = 0
  let mut case_index = 0
  while case_index < unicode_word_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_word_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = unicode_is_word_boundary(text, byte_offset)
      if expected != actual {
        failures = failures + 1
        if first_failure == 0 { first_failure = (case_index + 1) * 1000 + scalar_index } else { 0 }
      } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8_encode_scalar_len(unicode_segmentation_test_case_scalar(value, scalar_index))
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
  Test.assert_eq(first_failure, 0)
}

test "Unicode 17 default sentence boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut first_failure = 0
  let mut case_index = 0
  while case_index < unicode_sentence_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_sentence_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = unicode_is_sentence_boundary(text, byte_offset)
      if expected != actual {
        failures = failures + 1
        if first_failure == 0 { first_failure = (case_index + 1) * 1000 + scalar_index } else { 0 }
      } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8_encode_scalar_len(unicode_segmentation_test_case_scalar(value, scalar_index))
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
  Test.assert_eq(first_failure, 0)
}

test "grapheme APIs use UTF-8 byte offsets" {
  let text = "á🇦🇺👩‍💻z"
  Test.assert_eq(unicode_grapheme_count(text), 4)
  Test.assert_true(unicode_is_grapheme_boundary(text, 0))
  Test.assert_false(unicode_is_grapheme_boundary(text, 1))
  Test.assert_eq(unicode_next_grapheme_boundary(text, 0), 3)
  Test.assert_eq(unicode_next_grapheme_boundary(text, 3), 11)
  Test.assert_eq(unicode_next_grapheme_boundary(text, 11), 22)
  Test.assert_eq(unicode_next_grapheme_boundary(text, 22), 23)
  Test.assert_eq(unicode_next_grapheme_boundary(text, 23), 23)
}

test "grapheme APIs reject invalid offsets" {
  Test.assert_false(unicode_is_grapheme_boundary("é", 1))
  Test.assert_false(unicode_is_grapheme_boundary("é", 3))
  Test.assert_eq(unicode_next_grapheme_boundary("é", 1), 0 - 1)
  Test.assert_eq(unicode_next_grapheme_boundary("é", 3), 0 - 1)
  Test.assert_eq(unicode_grapheme_count(""), 0)
}

test "word APIs preserve apostrophes and numeric punctuation" {
  let text = "can't 32.3"
  Test.assert_eq(unicode_word_segment_count(text), 3)
  Test.assert_eq(unicode_next_word_boundary(text, 0), 5)
  Test.assert_eq(unicode_next_word_boundary(text, 5), 6)
  Test.assert_eq(unicode_next_word_boundary(text, 6), 10)
  Test.assert_false(unicode_is_word_boundary(text, 3))
  Test.assert_false(unicode_is_word_boundary(text, 8))
  Test.assert_eq(unicode_next_word_boundary("é", 1), 0 - 1)
}

test "sentence APIs include terminators and trailing spaces" {
  let text = "One. Two!"
  Test.assert_eq(unicode_sentence_segment_count(text), 2)
  Test.assert_eq(unicode_next_sentence_boundary(text, 0), 5)
  Test.assert_eq(unicode_next_sentence_boundary(text, 5), 9)
  Test.assert_false(unicode_is_sentence_boundary(text, 4))
  Test.assert_true(unicode_is_sentence_boundary(text, 5))
  Test.assert_false(unicode_is_sentence_boundary("3.14 is pi.", 2))
  Test.assert_eq(unicode_next_sentence_boundary("é", 1), 0 - 1)
}
