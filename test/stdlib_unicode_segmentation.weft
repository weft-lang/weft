use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/option.{Option}
use stdlib/test.{*}
use stdlib/unicode as unicode
use stdlib/utf8 as utf8
use stdlib/utf8.{utf8_encode_scalar_into, utf8_scalar_encoded_len}
use test/unicode_segmentation_conformance_data.{*}

fn unicode_segmentation_case_text(value: UnicodeSegmentationTestCase) -> str {
  let count = unicode_segmentation_test_case_count(value)
  let mut n = 0
  let mut i = 0
  while i < count {
    n = n + utf8_scalar_encoded_len(unicode_segmentation_test_case_scalar(value, i))
    i = i + 1
  }
  let text = runtime_str_alloc_uninit(n)
  let data = runtime_str_ptr(text)
  let mut pos = 0
  i = 0
  while i < count {
    pos = utf8_encode_scalar_into(data, pos, unicode_segmentation_test_case_scalar(value, i))
    i = i + 1
  }
  text
}

test "Unicode 17 extended grapheme boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut case_index = 0
  while case_index < unicode_grapheme_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_grapheme_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset: usize = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = text.is_grapheme_boundary(byte_offset)
      if expected != actual { failures = failures + 1 } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8.encoded_len(unicode_segmentation_test_case_scalar(value, scalar_index)).expect("conformance scalar")
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
}

test "Unicode 17 default word boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut first_failure = 0
  let mut case_index = 0
  while case_index < unicode_word_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_word_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset: usize = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = text.is_word_boundary(byte_offset)
      if expected != actual {
        failures = failures + 1
        if first_failure == 0 { first_failure = (case_index + 1) * 1000 + scalar_index } else { 0 }
      } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8.encoded_len(unicode_segmentation_test_case_scalar(value, scalar_index)).expect("conformance scalar")
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
  Test.assert_eq(first_failure, 0)
}

test "Unicode 17 default sentence boundaries pass the complete conformance corpus" {
  let mut failures = 0
  let mut first_failure = 0
  let mut case_index = 0
  while case_index < unicode_sentence_break_test_count() {
    let mark = alloc_bump_mark()
    let value = unicode_sentence_break_test_case(case_index)
    let text = unicode_segmentation_case_text(value)
    let count = unicode_segmentation_test_case_count(value)
    let mut scalar_index = 0
    let mut byte_offset: usize = 0
    while scalar_index <= count {
      let expected = unicode_segmentation_test_case_boundary(value, scalar_index) == 1
      let actual = text.is_sentence_boundary(byte_offset)
      if expected != actual {
        failures = failures + 1
        if first_failure == 0 { first_failure = (case_index + 1) * 1000 + scalar_index } else { 0 }
      } else { 0 }
      if scalar_index < count {
        byte_offset = byte_offset + utf8.encoded_len(unicode_segmentation_test_case_scalar(value, scalar_index)).expect("conformance scalar")
      } else { 0 }
      scalar_index = scalar_index + 1
    }
    alloc_bump_restore_same_segment(mark)
    case_index = case_index + 1
  }
  Test.assert_eq(failures, 0)
  Test.assert_eq(first_failure, 0)
}

test "grapheme APIs use UTF-8 byte offsets" {
  let text = "á🇦🇺👩‍💻z"
  Test.assert_eq_usize(text.grapheme_count(), 4)
  Test.assert_true(text.is_grapheme_boundary(0))
  Test.assert_false(text.is_grapheme_boundary(1))
  Test.assert_eq_usize(text.next_grapheme_boundary(0).expect("valid boundary"), 3)
  Test.assert_eq_usize(text.next_grapheme_boundary(3).expect("valid boundary"), 11)
  Test.assert_eq_usize(text.next_grapheme_boundary(11).expect("valid boundary"), 22)
  Test.assert_eq_usize(text.next_grapheme_boundary(22).expect("valid boundary"), 23)
  Test.assert_eq_usize(text.next_grapheme_boundary(23).expect("valid boundary"), 23)
}

test "grapheme APIs reject invalid offsets" {
  Test.assert_false("é".is_grapheme_boundary(1))
  Test.assert_false("é".is_grapheme_boundary(3))
  Test.assert_true("é".next_grapheme_boundary(1).is_none())
  Test.assert_true("é".next_grapheme_boundary(3).is_none())
  Test.assert_eq_usize("".grapheme_count(), 0)
}

test "word APIs preserve apostrophes and numeric punctuation" {
  let text = "can't 32.3"
  Test.assert_eq_usize(text.word_segment_count(), 3)
  Test.assert_eq_usize(text.next_word_boundary(0).expect("valid boundary"), 5)
  Test.assert_eq_usize(text.next_word_boundary(5).expect("valid boundary"), 6)
  Test.assert_eq_usize(text.next_word_boundary(6).expect("valid boundary"), 10)
  Test.assert_false(text.is_word_boundary(3))
  Test.assert_false(text.is_word_boundary(8))
  Test.assert_true("é".next_word_boundary(1).is_none())
}

test "sentence APIs include terminators and trailing spaces" {
  let text = "One. Two!"
  Test.assert_eq_usize(text.sentence_segment_count(), 2)
  Test.assert_eq_usize(text.next_sentence_boundary(0).expect("valid boundary"), 5)
  Test.assert_eq_usize(text.next_sentence_boundary(5).expect("valid boundary"), 9)
  Test.assert_false(text.is_sentence_boundary(4))
  Test.assert_true(text.is_sentence_boundary(5))
  Test.assert_false("3.14 is pi.".is_sentence_boundary(2))
  Test.assert_true("é".next_sentence_boundary(1).is_none())
}

test "all boundary families reject mid-scalar and full-width invalid offsets" {
  let offsets: [usize; 5] = [1, 3, 9223372036854775807, 9223372036854775808, 18446744073709551615]
  for offset in offsets {
    Test.assert_false("é".is_grapheme_boundary(offset))
    Test.assert_false("é".is_word_boundary(offset))
    Test.assert_false("é".is_sentence_boundary(offset))
    Test.assert_true("é".next_grapheme_boundary(offset).is_none())
    Test.assert_true("é".next_word_boundary(offset).is_none())
    Test.assert_true("é".next_sentence_boundary(offset).is_none())
  }
}

test "all boundary families preserve empty text and the stable end boundary" {
  for text in ["", "é"] {
    let end = text.len()
    Test.assert_true(text.is_grapheme_boundary(end))
    Test.assert_true(text.is_word_boundary(end))
    Test.assert_true(text.is_sentence_boundary(end))
    Test.assert_eq_usize(text.next_grapheme_boundary(end).expect("end boundary"), end)
    Test.assert_eq_usize(text.next_word_boundary(end).expect("end boundary"), end)
    Test.assert_eq_usize(text.next_sentence_boundary(end).expect("end boundary"), end)
    Test.assert_eq_usize(text.next_grapheme_boundary(0).expect("start boundary"), end)
    Test.assert_eq_usize(text.next_word_boundary(0).expect("start boundary"), end)
    Test.assert_eq_usize(text.next_sentence_boundary(0).expect("start boundary"), end)
  }
  Test.assert_eq_usize("".grapheme_count(), 0)
  Test.assert_eq_usize("".word_segment_count(), 0)
  Test.assert_eq_usize("".sentence_segment_count(), 0)
}
