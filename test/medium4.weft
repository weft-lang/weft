-- Function values, generic variants, effect declaration coexisting
-- Expected exit code: 42
type Maybe<T> {
  Just(T),
  Nothing
}

effect Console {
  fn print(msg: str) -> nil
}

fn double(x: i64) -> i64 { x * 2 }

fn apply(f: (i64) -> i64, x: i64) -> i64 {
  f(x)
}

fn unwrap_or(m: Maybe<i64>, fallback: i64) -> i64 {
  match m {
    Just(v) -> v
    Nothing -> fallback
  }
}

fn main() -> i64 {
  let a = apply(double, 10)
  let b = unwrap_or(Just<i64>(20), 2)
  a + b + 2
}
