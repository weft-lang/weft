-- Scalar representation and allocation canary for stdlib/random.

use compiler/ir.{*}
use compiler/lib.{*}
use compiler/module.{module_decl_fact_find, module_decl_fact_find_member, module_decl_fact_function_pair, module_decl_namespace_inherent_method, module_decl_namespace_type, module_fact_entry_source, module_fact_find_path}
use compiler/pipeline.{*}
use compiler/type_registry.{str_hash}

fn random_metric_hash(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

fn random_metric_allocation_inst(inst: IrInst) -> i64 {
  match inst {
    IrClosureI64(_, _, _, _) -> 1
    IrArrayStorageI64(_, _, _) -> 1
    IrVariantInitI64(_, _, _, _) -> 1
    IrRecordInitI64(_, _, _) -> 1
    IrRecordLayoutInitI64(_, _, _, _, _) -> 1
    IrCallI64(_, callee, _) -> {
      if callee == random_metric_hash("alloc_words") or
        callee == random_metric_hash("rc_default_alloc") or
        callee == random_metric_hash("rc_default_alloc_masked") or
        callee == random_metric_hash("rc_default_alloc_masked_reuse") { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn random_metric_allocation_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> random_metric_allocation_inst(inst) + random_metric_allocation_insts(rest)
  }
}

fn random_metric_allocation_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> {
      random_metric_allocation_insts(insts) + random_metric_allocation_blocks(rest)
    }
  }
}

fn random_metric_function_allocations(functions: IrFunctionList, source: i64, wanted: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(IrFunction(hash, _, blocks, function_source), rest) -> {
      if function_source == source and hash == wanted {
        random_metric_allocation_blocks(blocks)
      } else {
        random_metric_function_allocations(rest, source, wanted)
      }
    }
  }
}

test "random hot scalar steps contain no allocation-shaped IR" {
  let source = "use stdlib/random as random use stdlib/result.{*} fn main() -> u64 { let limit = random.bound(6).expect(\"nonzero\") let state = random.from_seed(random.seed(1)) let (next, word) = state.next_u64() let (_, selected) = next.next_below(limit) word bxor __usize_to_u64(selected) }"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(source), __str_len(source), 1, 0)
  let table = match typed { TypedModule(_, _, checked_table) -> checked_table }
  let random_source = module_fact_entry_source(
    module_fact_find_path(table, __str_ptr("stdlib/random"), __str_len("stdlib/random"), 0)
  )
  let state_decl = module_decl_fact_find(
    table, random_source, module_decl_namespace_type(), __str_ptr("State"), 0, __str_len("State")
  )
  let next_decl = module_decl_fact_find_member(
    table, state_decl, module_decl_namespace_inherent_method(), __str_ptr("next_u64"), 0, __str_len("next_u64")
  )
  let below_decl = module_decl_fact_find_member(
    table, state_decl, module_decl_namespace_inherent_method(), __str_ptr("next_below"), 0, __str_len("next_below")
  )
  let functions = pipeline_ir_functions(pipeline_lower_ir(typed))
  Test.assert_true(next_decl != 0)
  Test.assert_true(below_decl != 0)
  Test.assert_eq(random_metric_function_allocations(functions, random_source, pipeline_fn_pair_key(module_decl_fact_function_pair(next_decl))), 0)
  Test.assert_eq(random_metric_function_allocations(functions, random_source, pipeline_fn_pair_key(module_decl_fact_function_pair(below_decl))), 0)
}
