use compiler/docgen.{*}
use compiler/pipeline.{pipeline_check_source_standalone}
use runtime/buffer.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/string.{str_find}

fn docgen_test_render(source: str, path: str) -> str {
  docgen_render_module(pipeline_check_source_standalone(__str_ptr(source), __str_len(source)), path)
}

fn docgen_test_contains(haystack: str, needle: str) -> i64 {
  if str_find(haystack, needle) >= 0 { 1 } else { 0 }
}

fn docgen_test_api_source() -> str {
  let b = buf_new(2048)
  bstr(b, "pub effect State<S> ")
  bstr(b, "{")
  bstr(b, " fn get() -> S @deferred fn wait(value: S) -> S ")
  bstr(b, "}")
  bstr(b, "\n--- Transform one checked value.\n--- The callback remains pure.\n")
  bstr(b, "pub fn map_value<T: Ord>(value: T, f: (T) -> T) -[State<T>]> T ")
  bstr(b, "{")
  bstr(b, " value ")
  bstr(b, "}")
  bstr(b, "\n--- A public choice.\npub type Choice<T> ")
  bstr(b, "{")
  bstr(b, " Pair(T, str), Some(T), None ")
  bstr(b, "}")
  bstr(b, "\n--- Values that can render.\npub trait Render ")
  bstr(b, "{")
  bstr(b, " type Item: Ord fn render(self: Self, value: Self.Item) -[State<Self.Item>]> str ")
  bstr(b, "}")
  bstr(b, "\nfn hidden() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  bstr(b, "\npub(package) fn package_only() -> i64 ")
  bstr(b, "{")
  bstr(b, " 2 ")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

fn docgen_test_one_function(result: str) -> i64 {
  docgen_test_contains(result, "pub fn map_value<T: Ord>(value: T, f: (T) -> T) -[State<T>]> T")
}

test "docgen_renders_checked_function_signature" {
  Test.assert_eq(docgen_test_one_function(docgen_test_render(docgen_test_api_source(), "sample/api.weft")), 1)
}

test "docgen renders associated type equality constraints" {
  let b = buf_new(256)
  bstr(b, "pub trait Source { type Item } pub fn collect<T, C: Source & ")
  bstr(b, "{")
  bstr(b, "type Item = T}>(value: C) -> C { value }")
  let source = runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
  let result = docgen_test_render(source, "sample/collect.weft")
  let expected = buf_new(128)
  bstr(expected, "pub fn collect<T, C: Source & ")
  bstr(expected, "{")
  bstr(expected, "type Item = T}>(value: C) -> C")
  Test.assert_eq(docgen_test_contains(result, runtime_str_from_bytes_copy(buf_ptr(expected), buf_len(expected))), 1)
}

test "docgen_renders_checked_effect_operations" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "pub effect State<S>"), 1)
  Test.assert_eq(docgen_test_contains(result, "fn get() -> S"), 1)
  Test.assert_eq(docgen_test_contains(result, "@deferred fn wait(value: S) -> S"), 1)
}

test "docgen_renders_variant_payloads_and_trait_members" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "pub type Choice<T> {\n  Pair(T, str),\n  Some(T),\n  None\n}"), 1)
  Test.assert_eq(docgen_test_contains(result, "pub trait Render {\n  type Item: Ord\n  fn render(self: Self, value: Self.Item) -[State<Self.Item>]> str\n}"), 1)
}

fn docgen_test_record_source(field_type: str) -> str {
  let b = buf_new(256)
  bstr(b, "--- A checked record.\npub type Pair<T> ")
  bstr(b, "{")
  bstr(b, " left: T, right: ")
  bstr(b, field_type)
  bstr(b, " ")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_renders_checked_record_fields" {
  let result = docgen_test_render(docgen_test_record_source("str"), "pair.weft")
  Test.assert_eq(docgen_test_contains(result, "pub type Pair<T> {\n  left: T,\n  right: str\n}"), 1)
}

test "docgen_record_member_types_track_checker_facts" {
  let integers = docgen_test_render(docgen_test_record_source("i64"), "pair.weft")
  let strings = docgen_test_render(docgen_test_record_source("str"), "pair.weft")
  Test.assert_eq(docgen_test_contains(integers, "right: i64"), 1)
  Test.assert_eq(docgen_test_contains(strings, "right: str"), 1)
  Test.assert_eq(docgen_test_contains(strings, "right: i64"), 0)
}

fn docgen_test_implementation_source() -> str {
  let b = buf_new(512)
  bstr(b, "--- A generic box.\npub type Box<T> ")
  bstr(b, "{")
  bstr(b, " Box(T) ")
  bstr(b, "}")
  bstr(b, "\n--- Values carrying the marker.\npub trait Marker ")
  bstr(b, "{")
  bstr(b, "}")
  bstr(b, "\nimpl<T: Ord> Marker for Box<T> ")
  bstr(b, "{")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_renders_checked_trait_implementation_membership" {
  let result = docgen_test_render(docgen_test_implementation_source(), "impls.weft")
  Test.assert_eq(docgen_test_contains(result, "## Trait implementations"), 1)
  Test.assert_eq(docgen_test_contains(result, "`impl<T: Ord> Marker for Box<T>`"), 1)
}

test "docgen_cross_links_local_trait_and_target" {
  let result = docgen_test_render(docgen_test_implementation_source(), "impls.weft")
  Test.assert_eq(docgen_test_contains(result, "trait [`Marker`](#trait-marker)"), 1)
  Test.assert_eq(docgen_test_contains(result, "target [`Box`](#type-box)"), 1)
}

fn docgen_test_inherent_method_source() -> str {
  let b = buf_new(512)
  bstr(b, "--- A visible box.\npub type MethodBox ")
  bstr(b, "{")
  bstr(b, " value: i64 ")
  bstr(b, "}")
  bstr(b, "\nimpl MethodBox ")
  bstr(b, "{")
  bstr(b, "\n--- Returns the stored value.\n  pub fn value(self) -> i64 ")
  bstr(b, "{")
  bstr(b, " self.value ")
  bstr(b, "}")
  bstr(b, "\n  fn hidden(self) -> i64 ")
  bstr(b, "{")
  bstr(b, " 0 ")
  bstr(b, "}")
  bstr(b, "\n")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_renders_only_public_checked_inherent_methods" {
  let result = docgen_test_render(docgen_test_inherent_method_source(), "methods.weft")
  Test.assert_eq(docgen_test_contains(result, "### Inherent methods"), 1)
  Test.assert_eq(docgen_test_contains(result, "Returns the stored value."), 1)
  Test.assert_eq(docgen_test_contains(result, "pub fn value(self: MethodBox) -> i64"), 1)
  Test.assert_eq(docgen_test_contains(result, "hidden"), 0)
  Test.assert_eq(docgen_test_contains(result, "Public API items: 3. Documented: 2."), 1)
  Test.assert_eq(docgen_test_contains(result, "### Members\n\n#### `value`\n\n_Undocumented._"), 1)
}

fn docgen_test_nested_member_docs_source() -> str {
  let b = buf_new(2048)
  bstr(b, "--- A documented record.\npub type Entry ")
  bstr(b, "{")
  bstr(b, "\n--- Stable entry key.\n  key: i64,\n  value: str\n")
  bstr(b, "}")
  bstr(b, "\n--- A documented choice.\npub type Decision ")
  bstr(b, "{")
  bstr(b, "\n--- The positive choice.\n  Yes,\n  No\n")
  bstr(b, "}")
  bstr(b, "\n--- A documented trait.\npub trait Inspect ")
  bstr(b, "{")
  bstr(b, "\n--- The inspected value.\n  type Item\n--- Inspect one value.\n  fn inspect(self: Self) -> Self.Item\n")
  bstr(b, "}")
  bstr(b, "\n--- A documented effect.\npub effect Read ")
  bstr(b, "{")
  bstr(b, "\n--- Read the next value.\n  fn next() -> str\n  fn wait() -> str\n")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_attaches_docs_to_every_public_member_kind" {
  let result = docgen_test_render(docgen_test_nested_member_docs_source(), "members.weft")
  Test.assert_eq(docgen_test_contains(result, "#### `key`\n\nStable entry key."), 1)
  Test.assert_eq(docgen_test_contains(result, "#### `Yes`\n\nThe positive choice."), 1)
  Test.assert_eq(docgen_test_contains(result, "#### `Item`\n\nThe inspected value."), 1)
  Test.assert_eq(docgen_test_contains(result, "#### `inspect`\n\nInspect one value."), 1)
  Test.assert_eq(docgen_test_contains(result, "#### `next`\n\nRead the next value."), 1)
}

test "docgen_census_counts_the_complete_public_api" {
  let result = docgen_test_render(docgen_test_nested_member_docs_source(), "members.weft")
  Test.assert_eq(docgen_test_contains(result, "Public API items: 12. Documented: 9."), 1)
}

test "docgen_attaches_consecutive_doc_comment_lines" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "Transform one checked value.\nThe callback remains pure."), 1)
  Test.assert_eq(docgen_test_contains(result, "--- Transform"), 0)
}

test "docgen_omits_nonpublic_root_declarations" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "hidden"), 0)
  Test.assert_eq(docgen_test_contains(result, "package_only"), 0)
  Test.assert_eq(docgen_test_contains(result, "Function `map_value`"), 1)
}

test "docgen_reports_public_documentation_census" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "Public API items: 11. Documented: 3."), 1)
  Test.assert_eq(docgen_test_contains(result, "Effect `State`\n\n_Undocumented._"), 1)
}

fn docgen_test_single_source(result_type: str, body: str) -> str {
  let b = buf_new(256)
  bstr(b, "--- Identity.\npub fn identity(value: ")
  bstr(b, result_type)
  bstr(b, ") -> ")
  bstr(b, result_type)
  bstr(b, " ")
  bstr(b, "{")
  bstr(b, " ")
  bstr(b, body)
  bstr(b, " ")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_signature_tracks_checker_fact_changes" {
  let integers = docgen_test_render(docgen_test_single_source("i64", "value"), "identity.weft")
  let strings = docgen_test_render(docgen_test_single_source("str", "value"), "identity.weft")
  Test.assert_eq(docgen_test_contains(integers, "pub fn identity(value: i64) -> i64"), 1)
  Test.assert_eq(docgen_test_contains(strings, "pub fn identity(value: str) -> str"), 1)
  Test.assert_eq(docgen_test_contains(strings, "identity(value: i64)"), 0)
}

test "docgen_blank_line_breaks_comment_attachment" {
  let b = buf_new(256)
  bstr(b, "--- Detached.\n\npub fn value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "detached.weft")
  Test.assert_eq(docgen_test_contains(result, "Detached."), 0)
  Test.assert_eq(docgen_test_contains(result, "_Undocumented._"), 1)
}

test "docgen_handles_crlf_and_indented_doc_prefix" {
  let b = buf_new(256)
  bstr(b, "  --- Windows-safe docs.\r\npub fn value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "crlf.weft")
  Test.assert_eq(docgen_test_contains(result, "Windows-safe docs."), 1)
  Test.assert_eq(docgen_test_contains(result, "Documented: 1."), 1)
}

test "docgen_empty_public_api_is_stable" {
  let b = buf_new(128)
  bstr(b, "fn private_value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 0 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "private.weft")
  Test.assert_eq(docgen_test_contains(result, "# API: `private.weft`"), 1)
  Test.assert_eq(docgen_test_contains(result, "Public API items: 0. Documented: 0."), 1)
  Test.assert_eq(docgen_test_contains(result, "## "), 0)
}
