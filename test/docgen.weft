use compiler/docgen.{*}
use compiler/pipeline.{pipeline_check_source}
use runtime/buffer.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/string.{str_find}

fn docgen_test_render(source: str, path: str) -> str {
  docgen_render_module(pipeline_check_source(__str_ptr(source), __str_len(source)), path)
}

fn docgen_test_contains(haystack: str, needle: str) -> i64 {
  if str_find(haystack, needle) >= 0 { 1 } else { 0 }
}

fn docgen_test_api_source() -> str {
  let b = buf_new(2048)
  bstr(b, "pub effect State<S> ")
  bstr(b, "{")
  bstr(b, " fn get() -> S @deferred fn wait(value: S) -> S ")
  bstr(b, "}")
  bstr(b, "\n--- Transform one checked value.\n--- The callback remains pure.\n")
  bstr(b, "pub fn map_value<T: Ord>(value: T, f: (T) -> T) -[State<T>]> T ")
  bstr(b, "{")
  bstr(b, " value ")
  bstr(b, "}")
  bstr(b, "\n--- A public choice.\npub type Choice<T> ")
  bstr(b, "{")
  bstr(b, " Some(T), None ")
  bstr(b, "}")
  bstr(b, "\n--- Values that can render.\npub trait Render ")
  bstr(b, "{")
  bstr(b, " type Item fn render(self: Self, value: Self.Item) -> str ")
  bstr(b, "}")
  bstr(b, "\nfn hidden() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  bstr(b, "\npub(package) fn package_only() -> i64 ")
  bstr(b, "{")
  bstr(b, " 2 ")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

fn docgen_test_one_function(result: str) -> i64 {
  docgen_test_contains(result, "pub fn map_value<T: Ord>(value: T, f: (T) -> T) -[State<T>]> T")
}

test "docgen_renders_checked_function_signature" {
  Test.assert_eq(docgen_test_one_function(docgen_test_render(docgen_test_api_source(), "sample/api.weft")), 1)
}

test "docgen_renders_checked_effect_operations" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "pub effect State<S>"), 1)
  Test.assert_eq(docgen_test_contains(result, "fn get() -> S"), 1)
  Test.assert_eq(docgen_test_contains(result, "@deferred fn wait(value: S) -> S"), 1)
}

test "docgen_renders_type_and_trait_headers" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "pub type Choice<T>"), 1)
  Test.assert_eq(docgen_test_contains(result, "pub trait Render"), 1)
}

test "docgen_attaches_consecutive_doc_comment_lines" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "Transform one checked value.\nThe callback remains pure."), 1)
  Test.assert_eq(docgen_test_contains(result, "--- Transform"), 0)
}

test "docgen_omits_nonpublic_root_declarations" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "hidden"), 0)
  Test.assert_eq(docgen_test_contains(result, "package_only"), 0)
  Test.assert_eq(docgen_test_contains(result, "Function `map_value`"), 1)
}

test "docgen_reports_public_documentation_census" {
  let result = docgen_test_render(docgen_test_api_source(), "sample/api.weft")
  Test.assert_eq(docgen_test_contains(result, "Public declarations: 4. Documented: 3."), 1)
  Test.assert_eq(docgen_test_contains(result, "Effect `State`\n\n_Undocumented._"), 1)
}

fn docgen_test_single_source(result_type: str, body: str) -> str {
  let b = buf_new(256)
  bstr(b, "--- Identity.\npub fn identity(value: ")
  bstr(b, result_type)
  bstr(b, ") -> ")
  bstr(b, result_type)
  bstr(b, " ")
  bstr(b, "{")
  bstr(b, " ")
  bstr(b, body)
  bstr(b, " ")
  bstr(b, "}")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

test "docgen_signature_tracks_checker_fact_changes" {
  let integers = docgen_test_render(docgen_test_single_source("i64", "value"), "identity.weft")
  let strings = docgen_test_render(docgen_test_single_source("str", "value"), "identity.weft")
  Test.assert_eq(docgen_test_contains(integers, "pub fn identity(value: i64) -> i64"), 1)
  Test.assert_eq(docgen_test_contains(strings, "pub fn identity(value: str) -> str"), 1)
  Test.assert_eq(docgen_test_contains(strings, "identity(value: i64)"), 0)
}

test "docgen_blank_line_breaks_comment_attachment" {
  let b = buf_new(256)
  bstr(b, "--- Detached.\n\npub fn value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "detached.weft")
  Test.assert_eq(docgen_test_contains(result, "Detached."), 0)
  Test.assert_eq(docgen_test_contains(result, "_Undocumented._"), 1)
}

test "docgen_handles_crlf_and_indented_doc_prefix" {
  let b = buf_new(256)
  bstr(b, "  --- Windows-safe docs.\r\npub fn value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 1 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "crlf.weft")
  Test.assert_eq(docgen_test_contains(result, "Windows-safe docs."), 1)
  Test.assert_eq(docgen_test_contains(result, "Documented: 1."), 1)
}

test "docgen_empty_public_api_is_stable" {
  let b = buf_new(128)
  bstr(b, "fn private_value() -> i64 ")
  bstr(b, "{")
  bstr(b, " 0 ")
  bstr(b, "}")
  let result = docgen_test_render(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)), "private.weft")
  Test.assert_eq(docgen_test_contains(result, "# API: `private.weft`"), 1)
  Test.assert_eq(docgen_test_contains(result, "Public declarations: 0. Documented: 0."), 1)
  Test.assert_eq(docgen_test_contains(result, "## "), 0)
}
