use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_len, runtime_str_ptr}
use runtime/utf8.{Utf8StorageMalformed, Utf8StorageScalar, utf8_storage_decode}
use stdlib/num
use stdlib/option
use stdlib/result
use stdlib/utf8 as utf8

fn utf8_storage_test_bytes(bytes: [i64; 4], length: i64) -> str {
  let text = runtime_str_alloc_uninit(length)
  for index in 0..length {
    let finite_index = index.to_usize_checked().expect("nonnegative test offset")
    mem_store8_at(runtime_str_ptr(text), index, bytes[finite_index])
  }
  text
}

test "storage decoding preserves every scalar width and range boundary" {
  for (scalar, width) in [
    (0, 1), (127, 1), (128, 2), (2047, 2), (2048, 3),
    (55295, 3), (57344, 3), (65535, 3), (65536, 4), (1114111, 4)
  ] {
    let text = utf8.from_scalar(scalar).expect("valid scalar boundary")
    Test.assert_eq(runtime_str_len(text), width)
    match utf8_storage_decode(runtime_str_ptr(text), width, 0) {
      Utf8StorageScalar(next, decoded) -> {
        Test.assert_eq(next, width)
        Test.assert_eq(decoded, scalar)
      }
      Utf8StorageMalformed(_) -> Test.assert_true(false)
    }
    for length in 0..width {
      match utf8_storage_decode(runtime_str_ptr(text), length, 0) {
        Utf8StorageScalar(_, _) -> Test.assert_true(false)
        Utf8StorageMalformed(offset) -> Test.assert_eq(offset, 0)
      }
    }
    for offset in 1..width {
      match utf8_storage_decode(runtime_str_ptr(text), width, offset) {
        Utf8StorageScalar(_, _) -> Test.assert_true(false)
        Utf8StorageMalformed(failed) -> Test.assert_eq(failed, offset)
      }
    }
  }
}

test "storage decoding rejects noncanonical and malformed sequences" {
  for bytes in [
    [128, 128, 128, 128], [191, 128, 128, 128],
    [192, 175, 128, 128], [193, 191, 128, 128],
    [194, 127, 128, 128], [223, 192, 128, 128],
    [224, 159, 191, 128], [224, 160, 127, 128],
    [237, 160, 128, 128], [239, 128, 192, 128],
    [240, 143, 191, 191], [240, 144, 127, 128],
    [241, 128, 128, 192], [244, 144, 128, 128],
    [245, 128, 128, 128], [255, 128, 128, 128]
  ] {
    let text = utf8_storage_test_bytes(bytes, 4)
    match utf8_storage_decode(runtime_str_ptr(text), 4, 0) {
      Utf8StorageScalar(_, _) -> Test.assert_true(false)
      Utf8StorageMalformed(offset) -> Test.assert_eq(offset, 0)
    }
  }
}

test "storage bounds fail before touching an unavailable source" {
  for (length, offset) in [(0, 0), (1, -1), (1, 1), (1, 9223372036854775807)] {
    match utf8_storage_decode(0, length, offset) {
      Utf8StorageScalar(_, _) -> Test.assert_true(false)
      Utf8StorageMalformed(failed) -> Test.assert_eq(failed, offset)
    }
  }
}
