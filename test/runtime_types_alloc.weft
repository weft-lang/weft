use "compiler/lib.weft"
use "compiler/types.weft"

-- Closed-world Conformance discharge: these tests exercise trait-free
-- types, so the oracle can answer "nothing conforms".
fn is_subtype_c(a: i64, b: i64) -> i64 {
  handle is_subtype(a, b) {
    Conformance.conforms(th, trh) -> resume(0)
  }
}

fn is_empty_c(ty: i64) -> i64 {
  handle ty_is_empty(ty) {
    Conformance.conforms(th, trh) -> resume(0)
  }
}

fn runtime_types_alloc_call_continuation_param(k: Continuation<i64, i64>) -> i64 {
  k(41)
}

test "runtime_types_alloc_primitive_and_union_nodes" {
  let i = ty_i64()
  let s = ty_str()
  let u = ty_union(i, s)
  Test.assert_eq(ty_tag(i), 2)
  Test.assert_eq(ty_f1(i), PRIM_I64())
  Test.assert_eq(ty_tag(s), 2)
  Test.assert_eq(ty_f1(s), PRIM_STR())
  Test.assert_eq(ty_tag(u), 3)
  Test.assert_eq(ty_f1(u), i)
  Test.assert_eq(ty_f2(u), s)
}

test "runtime_types_alloc_function_and_effect_nodes" {
  let params = nlist_new()
  nlist_add(params, ty_i64())
  nlist_add(params, ty_bool())
  let effects = nlist_new()
  let io = ty_effect_app(42)
  nlist_add(effects, io)
  let sig = ty_effect_sig(effects)
  let f = ty_fn(params, ty_nil(), sig)
  Test.assert_eq(ty_tag(io), 11)
  Test.assert_eq(ty_tag(sig), 10)
  Test.assert_eq(nlist_len(ty_f1(sig)), 1)
  Test.assert_eq(ty_tag(f), 6)
  Test.assert_eq(nlist_len(ty_f1(f)), 2)
  Test.assert_eq(ty_tag(ty_f2(f)), 2)
  Test.assert_eq(ty_f1(ty_f2(f)), PRIM_NIL())
  Test.assert_eq(ty_f3(f), sig)
}

test "runtime_types_alloc_continuation_node" {
  let cont = ty_continuation(ty_i64(), ty_bool())
  let wider = ty_continuation(ty_any(), ty_any())
  let params = nlist_new()
  nlist_add(params, ty_i64())
  let plain_fn = ty_fn(params, ty_bool(), ty_effect_pure())
  Test.assert_eq(ty_tag(cont), 14)
  Test.assert_eq(ty_is_continuation(cont), 1)
  Test.assert_eq(ty_is_continuation(plain_fn), 0)
  Test.assert_eq(ty_tag(ty_f1(cont)), 2)
  Test.assert_eq(ty_f1(ty_f1(cont)), PRIM_I64())
  Test.assert_eq(ty_tag(ty_f2(cont)), 2)
  Test.assert_eq(ty_f1(ty_f2(cont)), PRIM_BOOL())
  Test.assert_eq(ty_eq(cont, ty_continuation(ty_i64(), ty_bool())), 1)
  Test.assert_eq(is_subtype_c(cont, plain_fn), 0)
  Test.assert_eq(is_subtype_c(plain_fn, cont), 0)
  Test.assert_eq(is_subtype_c(wider, cont), 0)
  Test.assert_eq(is_subtype_c(cont, ty_any()), 1)
}

test "runtime_types_alloc_named_trait_and_type_var_nodes" {
  let named = ty_named_app(99, ty_any(), nlist_new())
  let trait_ty = ty_trait(100)
  let var_ty = ty_var(7)
  Test.assert_eq(ty_tag(named), 9)
  Test.assert_eq(ty_f1(named), 99)
  Test.assert_eq(ty_tag(trait_ty), 13)
  Test.assert_eq(ty_f1(trait_ty), 100)
  Test.assert_eq(ty_tag(var_ty), 12)
  Test.assert_eq(ty_f1(var_ty), 7)
}

test "runtime_types_alloc_rc_wrapper" {
  let rc_i64 = ty_rc(ty_i64())
  Test.assert_eq(ty_tag(rc_i64), 9)
  Test.assert_eq(ty_f1(rc_i64), ty_rc_hash())
  Test.assert_eq(ty_is_rc(rc_i64), 1)
  Test.assert_eq(ty_tag(ty_rc_inner(rc_i64)), 2)
  Test.assert_eq(ty_f1(ty_rc_inner(rc_i64)), PRIM_I64())
}

test "runtime_types_alloc_weak_and_internal_atomic_nodes" {
  let weak_i64 = ty_weak(ty_i64())
  let arc_i64 = ty_arc(ty_i64())
  let unique_i64 = ty_unique(ty_i64())
  let owned_i64 = ty_owned(ty_i64())
  Test.assert_eq(ty_tag(weak_i64), 16)
  Test.assert_eq(ty_is_weak(weak_i64), 1)
  Test.assert_eq(ty_tag(ty_weak_inner(weak_i64)), 2)
  Test.assert_eq(ty_f1(ty_weak_inner(weak_i64)), PRIM_I64())
  Test.assert_eq(ty_tag(arc_i64), 17)
  Test.assert_eq(ty_is_arc(arc_i64), 1)
  Test.assert_eq(ty_tag(ty_arc_inner(arc_i64)), 2)
  Test.assert_eq(ty_f1(ty_arc_inner(arc_i64)), PRIM_I64())
  Test.assert_eq(ty_tag(unique_i64), 18)
  Test.assert_eq(ty_is_unique(unique_i64), 1)
  Test.assert_eq(ty_tag(ty_unique_inner(unique_i64)), 2)
  Test.assert_eq(ty_f1(ty_unique_inner(unique_i64)), PRIM_I64())
  Test.assert_eq(ty_tag(owned_i64), 19)
  Test.assert_eq(ty_is_owned(owned_i64), 1)
  Test.assert_eq(ty_tag(ty_owned_inner(owned_i64)), 2)
  Test.assert_eq(ty_f1(ty_owned_inner(owned_i64)), PRIM_I64())
  Test.assert_eq(is_subtype_c(weak_i64, ty_i64()), 0)
  Test.assert_eq(is_subtype_c(arc_i64, ty_i64()), 0)
  Test.assert_eq(is_subtype_c(unique_i64, ty_i64()), 1)
  Test.assert_eq(is_subtype_c(unique_i64, ty_unique(ty_i64())), 1)
  Test.assert_eq(is_subtype_c(owned_i64, ty_i64()), 1)
  Test.assert_eq(is_subtype_c(owned_i64, ty_owned(ty_i64())), 1)
  let named_a = ty_named(12345, ty_i64())
  let named_b = ty_named(12345, ty_i64())
  let named_empty_args = ty_named_app(12345, ty_i64(), nlist_new())
  let owned_named = ty_owned(named_a)
  Test.assert_eq(is_subtype_c(owned_named, named_b), 1)
  Test.assert_eq(is_subtype_c(owned_named, ty_owned(named_b)), 1)
  Test.assert_eq(is_subtype_c(owned_named, named_empty_args), 1)
  Test.assert_eq(is_subtype_c(owned_named, ty_owned(named_empty_args)), 1)
}

test "runtime_types_alloc_pointer_nodes_and_subtyping" {
  let ptr_i64 = ty_ptr(ty_i64())
  let mut_ptr_i64 = ty_mut_ptr(ty_i64())
  let ptr_any = ty_ptr(ty_any())
  Test.assert_eq(ty_tag(ptr_i64), 15)
  Test.assert_eq(ty_ptr_mutable(ptr_i64), 0)
  Test.assert_eq(ty_ptr_mutable(mut_ptr_i64), 1)
  Test.assert_eq(ty_tag(ty_ptr_inner(ptr_i64)), 2)
  Test.assert_eq(ty_f1(ty_ptr_inner(ptr_i64)), PRIM_I64())
  Test.assert_eq(ty_eq(ptr_i64, ty_ptr(ty_i64())), 1)
  Test.assert_eq(is_subtype_c(mut_ptr_i64, ptr_i64), 1)
  Test.assert_eq(is_subtype_c(ptr_i64, mut_ptr_i64), 0)
  Test.assert_eq(is_subtype_c(ptr_i64, ptr_any), 1)
  Test.assert_eq(is_subtype_c(ty_rc(ty_i64()), ptr_i64), 1)
}

test "runtime_types_alloc_array_and_slice_nodes" {
  let fixed = ty_array(ty_i64(), 4)
  let view = ty_slice(ty_str())
  let mutable_view = ty_mut_slice(ty_bool())
  Test.assert_eq(ty_tag(fixed), 22)
  Test.assert_eq(ty_is_array(fixed), 1)
  Test.assert_eq(ty_array_length(fixed), 4)
  Test.assert_eq(ty_f1(ty_array_inner(fixed)), PRIM_I64())
  Test.assert_eq(ty_tag(view), 23)
  Test.assert_eq(ty_is_slice(view), 1)
  Test.assert_eq(ty_slice_mutable(view), 0)
  Test.assert_eq(ty_f1(ty_slice_inner(view)), PRIM_STR())
  Test.assert_eq(ty_slice_mutable(mutable_view), 1)
  Test.assert_eq(ty_f1(ty_slice_inner(mutable_view)), PRIM_BOOL())
  Test.assert_eq(ty_array_length(view), 0 - 1)
}

test "runtime_types_alloc_array_covariance_and_disjoint_lengths" {
  let bools = ty_array(ty_bool(), 2)
  let ints = ty_array(ty_i64(), 2)
  let strings = ty_array(ty_str(), 2)
  Test.assert_eq(is_subtype_c(bools, ints), 1)
  Test.assert_eq(is_subtype_c(ints, bools), 0)
  Test.assert_eq(is_subtype_c(bools, ty_array(ty_i64(), 3)), 0)
  Test.assert_eq(is_empty_c(ty_inter(bools, strings)), 1)
  Test.assert_eq(is_empty_c(ty_inter(bools, ints)), 0)
  Test.assert_eq(is_empty_c(ty_inter(bools, ty_array(ty_bool(), 3))), 1)
  Test.assert_eq(is_empty_c(ty_inter(bools, ty_compl(ints))), 1)
  Test.assert_eq(is_empty_c(ty_inter(ints, ty_compl(bools))), 0)
}

test "runtime_types_alloc_zero_array_is_canonical_and_inhabited" {
  let bottom_zero = ty_array(ty_never(), 0)
  let str_zero = ty_array(ty_str(), 0)
  Test.assert_eq(ty_eq(bottom_zero, str_zero), 1)
  Test.assert_eq(is_subtype_c(bottom_zero, str_zero), 1)
  Test.assert_eq(is_subtype_c(str_zero, bottom_zero), 1)
  Test.assert_eq(is_empty_c(bottom_zero), 0)
  Test.assert_eq(is_empty_c(ty_array(ty_never(), 1)), 1)
}

test "runtime_types_alloc_slice_variance_and_empty_view" {
  let bools = ty_slice(ty_bool())
  let ints = ty_slice(ty_i64())
  let bottom = ty_slice(ty_never())
  Test.assert_eq(is_subtype_c(bools, ints), 1)
  Test.assert_eq(is_subtype_c(ints, bools), 0)
  Test.assert_eq(is_subtype_c(ty_mut_slice(ty_bool()), ty_mut_slice(ty_i64())), 0)
  Test.assert_eq(is_subtype_c(ty_mut_slice(ty_i64()), ty_slice(ty_i64())), 0)
  Test.assert_eq(is_subtype_c(ty_slice(ty_i64()), ty_mut_slice(ty_i64())), 0)
  Test.assert_eq(is_empty_c(bottom), 0)
  Test.assert_eq(is_empty_c(ty_inter(ty_slice(ty_i64()), ty_slice(ty_str()))), 0)
  Test.assert_eq(is_empty_c(ty_inter(ty_array(ty_i64(), 0), ty_slice(ty_i64()))), 1)
}

test "runtime_types_alloc_array_slice_substitution_and_pattern_matching" {
  let subst = subst_new()
  subst_add(subst, 7, ty_str())
  Test.assert_eq(ty_eq(ty_subst(ty_array(ty_var(7), 3), subst), ty_array(ty_str(), 3)), 1)
  Test.assert_eq(ty_eq(ty_subst(ty_mut_slice(ty_var(7)), subst), ty_mut_slice(ty_str())), 1)

  let array_bindings = subst_new()
  Test.assert_eq(ty_pattern_match(ty_array(ty_var(9), 2), ty_array(ty_bool(), 2), array_bindings), 1)
  Test.assert_eq(ty_eq(subst_lookup(array_bindings, 9), ty_bool()), 1)
  Test.assert_eq(ty_pattern_match(ty_array(ty_var(9), 2), ty_array(ty_bool(), 3), subst_new()), 0)

  let slice_bindings = subst_new()
  Test.assert_eq(ty_pattern_unify(ty_slice(ty_var(11)), ty_slice(ty_i64()), slice_bindings), 1)
  Test.assert_eq(ty_eq(subst_lookup(slice_bindings, 11), ty_i64()), 1)
  Test.assert_eq(ty_pattern_unify(ty_mut_slice(ty_var(11)), ty_slice(ty_i64()), subst_new()), 0)
}

test "runtime_types_alloc_dnf_clause_lists" {
  let pos = nlist_new()
  let neg = nlist_new()
  nlist_add(pos, ty_i64())
  nlist_add(neg, ty_str())
  let clause = dnf_clause_new(pos, neg)
  Test.assert_eq(nlist_len(dnf_clause_pos(clause)), 1)
  Test.assert_eq(nlist_len(dnf_clause_neg(clause)), 1)
  Test.assert_eq(ty_tag(nlist_get(dnf_clause_pos(clause), 0)), 2)
  Test.assert_eq(ty_f1(nlist_get(dnf_clause_neg(clause), 0)), PRIM_STR())
}

test "runtime_types_alloc_dnf_atom" {
  let d = dnf_atom(ty_bool())
  let clause = dnf_get(d, 0)
  Test.assert_eq(dnf_len(d), 1)
  Test.assert_eq(nlist_len(dnf_clause_pos(clause)), 1)
  Test.assert_eq(ty_f1(nlist_get(dnf_clause_pos(clause), 0)), PRIM_BOOL())
  Test.assert_eq(nlist_len(dnf_clause_neg(clause)), 0)
}
