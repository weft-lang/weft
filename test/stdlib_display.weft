use stdlib/display.{*}
use stdlib/string.{*}

type DisplayLabel {
  value: str
}

impl Display for DisplayLabel {
  fn display(self) -> str {
    self.value
  }
}

fn display_twice<T: Display>(value: T) -> str {
  str_concat(value.display(), value.display())
}

test "display_primitive_implementations" {
  Test.assert_eq(str_eq(42.display(), "42"), 1)
  Test.assert_eq(str_eq(true.display(), "true"), 1)
  Test.assert_eq(str_eq(false.display(), "false"), 1)
  Test.assert_eq(str_eq("weft".display(), "weft"), 1)
}

test "display_custom_self_typed_implementation" {
  let label = DisplayLabel { value: "roots" }
  Test.assert_eq(str_eq(label.display(), "roots"), 1)
}

test "display_generic_bound_dispatches_custom_implementation" {
  let label = DisplayLabel { value: "weft" }
  Test.assert_eq(str_eq(display_twice<DisplayLabel>(label), "weftweft"), 1)
}
