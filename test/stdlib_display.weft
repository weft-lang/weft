use stdlib/string.{*}

type DisplayLabel {
  value: str
}

impl Display for DisplayLabel {
  fn display(self) -> str {
    self.value
  }
}

fn display_twice<T: Display>(value: T) -> str {
  str_concat(value.display(), value.display())
}

test "display_primitive_implementations" {
  Test.assert_eq(str_eq(42.display(), "42"), 1)
  Test.assert_eq(str_eq(true.display(), "true"), 1)
  Test.assert_eq(str_eq(false.display(), "false"), 1)
  Test.assert_eq(str_eq("weft".display(), "weft"), 1)
}

test "display covers every fixed integer family without narrowing" {
  let signed8: i8 = -128
  let signed16: i16 = -32768
  let signed32: i32 = -2147483648
  let signed_size: isize = -42
  let unsigned8: u8 = 255
  let unsigned16: u16 = 65535
  let unsigned32: u32 = 4294967295
  let unsigned64: u64 = 18446744073709551615
  let unsigned_size: usize = 18446744073709551615
  Test.assert_str_eq(signed8.display(), "-128")
  Test.assert_str_eq(signed16.display(), "-32768")
  Test.assert_str_eq(signed32.display(), "-2147483648")
  Test.assert_str_eq(signed_size.display(), "-42")
  Test.assert_str_eq(unsigned8.display(), "255")
  Test.assert_str_eq(unsigned16.display(), "65535")
  Test.assert_str_eq(unsigned32.display(), "4294967295")
  Test.assert_str_eq(unsigned64.display(), "18446744073709551615")
  Test.assert_str_eq(unsigned_size.display(), "18446744073709551615")
}

test "usize interpolation uses the canonical Display implementation" {
  let count: usize = 16384
  Test.assert_str_eq("bytes: {count}", "bytes: 16384")
}

test "display_custom_self_typed_implementation" {
  let label = DisplayLabel { value: "roots" }
  Test.assert_eq(str_eq(label.display(), "roots"), 1)
}

test "display_generic_bound_dispatches_custom_implementation" {
  let label = DisplayLabel { value: "weft" }
  Test.assert_eq(str_eq(display_twice<DisplayLabel>(label), "weftweft"), 1)
}

test "Display is available through the language prelude" {
  let label = DisplayLabel { value: "implicit" }
  Test.assert_eq(str_eq("value: {label}", "value: implicit"), 1)
}
