effect Par {
  fn witness() -> nil
}

-- Keep the kernel §8.2 public shape typeable independently of the current
-- monomorphic stdlib implementation. The recursive body is intentionally
-- unreachable: this declaration is a surface-conformance witness, not a
-- second par_map.
fn kernel_par_map_shape<T, U>(_ items: [T], with f: (T) -> U) -[Par]> [U] {
  kernel_par_map_shape<T, U>(items, f)
}

test "kernel_10_9_array_and_slice_example_runs_as_written" {
  let arr: [i64; 4] = [1, 2, 3, 4]
  let x = arr[0]
  let slice: [i64] = arr[1..3]
  let len = slice.len
  Test.assert_eq(x, 1)
  Test.assert_eq(if len == 2 { 1 } else { 0 }, 1)
  Test.assert_eq(slice[0] * 10 + slice[1], 23)
}

test "kernel_8_2_generic_slice_signature_is_typeable" {
  -- The compiler checks the generic declaration above even though its
  -- conformance-only body is never executed.
  Test.assert_eq(1, 1)
}
