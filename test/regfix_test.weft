-- Test: bstr with minimal main

fn bu8(b: i64, v: i64) -> i64 {
  let d = __mem_load64(b)
  let l = __mem_load64(b + 8)
  __mem_store8(d + l, v)
  __mem_store64(b + 8, l + 1)
  b
}

fn fill(b: i64, src: i64, n: i64, i: i64) -> i64 {
  if i >= n { b }
  else {
    let byte = __mem_load8(src + i)
    bu8(b, byte)
    fill(b, src, n, i + 1)
  }
}

fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  fill(b, p, l, 0)
}

fn make_buf() -> i64 {
  let h = __bump_alloc(24)
  let d = __bump_alloc(256)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 256)
  h
}

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

fn main() -> i64 {
  let h = make_buf()
  bstr(h, "Hello")
  let d = __mem_load64(h)
  let l = __mem_load64(h + 8)
  sys_write(1, d, l)
  l
}
