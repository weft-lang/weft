use compiler/codegen.{runtime_state_diagnostic_color_mode_offset}
use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/syscall.{syscall_number_ioctl}
use runtime/terminal.{*}

fn terminal_test_cstr(value: str) -> i64 {
  let len = __str_len(value)
  let result = alloc_zeroed(len + 1)
  mem_copy(result, __str_ptr(value), len)
  result
}

fn terminal_test_environment(first: str, second: str) -> i64 {
  let envp = alloc_zeroed(24)
  if __str_len(first) > 0 { mem_store64_at(envp, 0, terminal_test_cstr(first)) } else { 0 }
  if __str_len(second) > 0 { mem_store64_at(envp, 8, terminal_test_cstr(second)) } else { 0 }
  envp
}

test "terminal_color_policy_auto_tracks_only_tty_state" {
  Test.assert_eq(terminal_color_policy(0, terminal_color_mode_auto()), 0)
  Test.assert_eq(terminal_color_policy(1, terminal_color_mode_auto()), 1)
}

test "terminal_color_policy_never_is_a_hard_plain_override" {
  Test.assert_eq(terminal_color_policy(0, terminal_color_mode_never()), 0)
  Test.assert_eq(terminal_color_policy(1, terminal_color_mode_never()), 0)
}

test "terminal_color_policy_always_is_a_hard_ansi_override" {
  Test.assert_eq(terminal_color_policy(0, terminal_color_mode_always()), 1)
  Test.assert_eq(terminal_color_policy(1, terminal_color_mode_always()), 1)
}

test "terminal_color_mode_storage_normalizes_unknown_values" {
  let original = terminal_stderr_color_mode()
  terminal_set_stderr_color_mode(terminal_color_mode_never())
  Test.assert_eq(terminal_stderr_color_mode(), terminal_color_mode_never())
  terminal_set_stderr_color_mode(terminal_color_mode_always())
  Test.assert_eq(terminal_stderr_color_mode(), terminal_color_mode_always())
  terminal_set_stderr_color_mode(99)
  Test.assert_eq(terminal_stderr_color_mode(), terminal_color_mode_auto())
  terminal_set_stderr_color_mode(original)
}

test "terminal_runtime_state_offset_matches_compiler_abi" {
  Test.assert_eq(terminal_diagnostic_color_mode_offset(), runtime_state_diagnostic_color_mode_offset())
  Test.assert_eq(terminal_diagnostic_color_mode_offset(), 168)
}

test "terminal_darwin_tty_probe_constants_match_platform_abi" {
  Test.assert_eq(syscall_number_ioctl(), 54)
  Test.assert_eq(terminal_darwin_tiocgeta(), 1078490131)
  Test.assert_eq(terminal_darwin_termios_words(), 9)
}

test "terminal_environment_defaults_to_auto" {
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("", "")), terminal_color_mode_auto())
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("TERM=xterm-256color", "LANG=en_AU.UTF-8")), terminal_color_mode_auto())
}

test "terminal_environment_honors_nonempty_no_color_only" {
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("NO_COLOR=1", "TERM=xterm")), terminal_color_mode_never())
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("NO_COLOR=", "TERM=xterm")), terminal_color_mode_auto())
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("NO_COLORS=1", "TERM=xterm")), terminal_color_mode_auto())
}

test "terminal_environment_honors_exact_dumb_terminal" {
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("TERM=dumb", "")), terminal_color_mode_never())
  Test.assert_eq(terminal_environment_color_mode(terminal_test_environment("TERM=dumber", "")), terminal_color_mode_auto())
}
