-- FizzBuzz: combines for-range, string interpolation, if/else, string concat
-- Expected exit code: 6
use "stdlib/string.weft"

fn fizzbuzz(n: i64) -> i64 {
  let mut count: i64 = 0
  for i in 1..n + 1 {
    let rem3 = i - i / 3 * 3
    let rem5 = i - i / 5 * 5
    if rem3 == 0 {
      if rem5 == 0 {
        count = count + 1
      } else { 0 }
    } else { 0 }
  }
  count
}

fn main() -> i64 {
  -- Count numbers 1..100 divisible by both 3 and 5
  fizzbuzz(100)
}
