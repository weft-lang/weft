-- A test block that performs no Test operation must still compile through the
-- generated harness: the handler discharges `Test` for the whole chunk, not
-- only for operations spelled in the root. Every block in this file avoids
-- assertion operations on purpose, so failures abort through panic instead.

use stdlib/panic.{panic}

fn declared_test_effect_without_perform() -[Test]> i64 { 3 }

test "block without any assertion runs through the harness" {
  let value = 20 + 22
  if value != 42 { panic("arithmetic failed") }
}

test "block calling a Test function that performs nothing" {
  if declared_test_effect_without_perform() != 3 { panic("helper failed") }
}

test "block with nested match and no assertion" {
  let result = match 2 { 1 -> "one", 2 -> "two", _ -> "many" }
  if result != "two" { panic("match failed") }
}
