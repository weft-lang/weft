test "deep_release_generic_match_rewrap_stays_flat" {
  generic_reclaim_rewrap_churn(2000)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(generic_reclaim_rewrap_churn(50000), 2500000000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

test "deep_release_two_million_chain_no_stack_blowup" {
  Test.assert_eq(deep_chain_key(deep_chain_build(2000000)), 1999999)
}

test "deep_release_extraction_keeps_leaf_alive" {
  let leaf = deep_extract_leaf(4, DeepLeaf(0 - 1))
  deep_interior_churn(64)
  Test.assert_eq(deep_leaf_val(leaf), 47)
}

test "deep_release_borrowed_payload_match_churn_stays_flat" {
  deep_extract_leaf_churn(2000)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(deep_extract_leaf_churn(50000), 12500100000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

test "deep_release_whole_binding_match_churn_stays_flat" {
  deep_extract_whole_churn(2000)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(deep_extract_whole_churn(50000), 750000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

test "payloadless_ctor_arg_reclaims" {
  -- DeepNil as ctor arg is an owned construction, not a borrow: no
  -- borrow-retain, freed by the parent's deep release (the 64B/iter
  -- leak this classification fix closed).
  let mut i = 0
  while i < 2000 {
    let t = DeepNode(i, DeepLeaf(i), DeepNil)
    i = i + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut j = 0
  while j < 20000 {
    let t = DeepNode(j, DeepLeaf(j), DeepNil)
    j = j + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

-- Runtime-owned frees under managed aggregate ownership: growth-abandoned and
-- final vector/buffer storage returns to the heap. After warmup both
-- doubling ladders and compiler-managed headers recycle exactly.
fn growth_vec_round(n: i64) -> i64 {
  let v = vector.new<i64>()
  let mut i = 0
  while i < n {
    vector_push<i64>(v, i)
    i = i + 1
  }
  vector_len<i64>(v)
}

fn growth_buf_round(n: i64) -> i64 {
  let b = buf_new(1)
  let mut i = 0
  while i < n {
    bu8(b, i)
    i = i + 1
  }
  buf_len(b)
}

test "vector_growth_abandoned_buffers_recycle" {
  let mut w = 0
  while w < 50 {
    growth_vec_round(1000)
    w = w + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut r = 0
  while r < 100 {
    growth_vec_round(1000)
    r = r + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "buffer_growth_abandoned_buffers_recycle" {
  let mut w = 0
  while w < 50 {
    growth_buf_round(1000)
    w = w + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut r = 0
  while r < 100 {
    growth_buf_round(1000)
    r = r + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

-- managed-return ownership: managed-returning fns no longer force all-owned params.
-- A borrowed param that flows into the managed result via ctor
-- embedding (arg borrow-retain) or bare return (transfer retain) must
-- stay correct and flat under churn.
fn borrow_embed(leaf: DeepLeaf, k: i64) -> DeepTree {
  DeepNode(k, leaf, DeepNil)
}

fn borrow_passthrough(t: DeepTree) -> DeepTree {
  t
}

test "borrowed_params_in_managed_returning_fns_reclaim" {
  let shared = DeepLeaf(41)
  let mut w = 0
  while w < 2000 {
    let t = borrow_embed(shared, w)
    w = w + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  let mut acc = 0
  while i < 50000 {
    let t = borrow_passthrough(borrow_embed(shared, i))
    acc = acc + match t { DeepNil -> 0, DeepNode(k, leaf, rest) -> k }
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
  Test.assert_eq(deep_leaf_val(shared), 41)
}
