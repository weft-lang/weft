use "runtime/rc_implicit_test.weft"
use "stdlib/vector.weft"
use "runtime/buffer.weft"
use "stdlib/sorted_map.weft"
-- test/aggregate_reclamation.weft -- ordinary-aggregate reclamation
-- locks (2q slice 2 stage A). Variant/record nodes are default-managed
-- headered rc payloads: construction allocates, lifetime-end releases
-- reclaim, and the churn shapes that leaked or corrupted during the
-- slice must stay flat and correct.

type ReclaimBox { RBoxA(i64), RBoxB(i64, i64) }
type ReclaimRec { value: i64, extra: i64 }
type ReclaimTree {
  ReclaimNil,
  ReclaimNode(i64, ReclaimTree, ReclaimTree)
}

fn reclaim_variant_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let v = if i % 2 == 0 { RBoxA(i) } else { RBoxB(i, i + 1) }
    acc = acc + match v { RBoxA(x) -> x, RBoxB(x, y) -> x + y }
    i = i + 1
  }
  acc
}

fn reclaim_record_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let r = ReclaimRec { value: i, extra: i * 2 }
    acc = acc + r.value + r.extra
    i = i + 1
  }
  acc
}

-- The let-with-CFG-body shape that leaked before the interposed scope
-- release: binding used only by a match body.
fn reclaim_match_body(v: i64) -> i64 {
  let b = RBoxA(v)
  match b { RBoxA(x) -> x, RBoxB(x, y) -> x + y }
}

fn reclaim_match_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + reclaim_match_body(i)
    i = i + 1
  }
  acc
}

-- Mixed borrowed/owned merge arms: vector_get's out-of-bounds path
-- returns the owned default through a borrowed-classified param arm.
-- Before per-arm retains the default came back dangling.
fn reclaim_default_survives() -> i64 {
  let v = vector_new<ReclaimBox>()
  let d = vector_get<ReclaimBox>(v, 5, RBoxB(7, 8))
  reclaim_variant_churn(64)
  match d { RBoxA(x) -> 0 - 1, RBoxB(x, y) -> x * 10 + y }
}

-- Passthrough returns of a binding bound inside a match arm: the
-- transfer retain must fire (its absence froze the optimizer's fact
-- plane root under live references during self-compile).
fn reclaim_passthrough(t: ReclaimTree, key: i64) -> ReclaimTree {
  match t {
    ReclaimNil -> t
    ReclaimNode(k, l, r) -> {
      let mut cur = t
      if k < key { cur = l } else { 0 }
      cur
    }
  }
}

fn reclaim_tree_key(t: ReclaimTree) -> i64 {
  match t {
    ReclaimNil -> 0 - 1
    ReclaimNode(k, l, r) -> k
  }
}

test "aggregate_variant_churn_correct" {
  -- even i contribute i, odd i contribute 2i + 1
  Test.assert_eq(reclaim_variant_churn(1000), 750000)
}

test "aggregate_record_churn_correct" {
  Test.assert_eq(reclaim_record_churn(1000), 999 * 1000 * 3 / 2)
}

test "aggregate_variant_churn_heap_flat" {
  reclaim_variant_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_variant_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "aggregate_record_churn_heap_flat" {
  reclaim_record_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_record_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "aggregate_match_body_let_release_heap_flat" {
  reclaim_match_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_match_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "aggregate_mixed_arm_default_survives" {
  Test.assert_eq(reclaim_default_survives(), 78)
}

test "aggregate_passthrough_binding_keeps_shared_node_alive" {
  let leaf = ReclaimNode(5, ReclaimNil, ReclaimNil)
  let root = ReclaimNode(10, leaf, ReclaimNil)
  let picked = reclaim_passthrough(root, 20)
  reclaim_variant_churn(64)
  Test.assert_eq(reclaim_tree_key(picked), 5)
  Test.assert_eq(reclaim_tree_key(root), 10)
}

test "aggregate_sorted_map_insert_shift_intact" {
  let m = sorted_map_new<i64, i64>()
  let mut i = 40
  while i > 0 {
    sorted_map_put<i64, i64>(m, i, i * 10, sorted_cmp_i64)
    i = i - 1
  }
  Test.assert_eq(sorted_map_len(m), 40)
  Test.assert_eq(sorted_map_get<i64, i64>(m, 1, 0 - 1, sorted_cmp_i64), 10)
  Test.assert_eq(sorted_map_get<i64, i64>(m, 20, 0 - 1, sorted_cmp_i64), 200)
  Test.assert_eq(sorted_map_get<i64, i64>(m, 40, 0 - 1, sorted_cmp_i64), 400)
}

-- Stage B locks: match-on-rvalue scrutinees and discarded statement
-- results release at the merge/discard point.

fn reclaim_rvalue_box(i: i64) -> ReclaimBox {
  if i % 2 == 0 { RBoxA(i) } else { RBoxB(i, i + 1) }
}

fn reclaim_scrutinee_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + match reclaim_rvalue_box(i) { RBoxA(x) -> x, RBoxB(x, y) -> x + y }
    i = i + 1
  }
  acc
}

fn reclaim_discard_churn(n: i64) -> i64 {
  let mut i = 0
  while i < n {
    reclaim_rvalue_box(i)
    i = i + 1
  }
  n
}

test "aggregate_rvalue_scrutinee_release_heap_flat" {
  reclaim_scrutinee_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_scrutinee_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "aggregate_discarded_result_release_heap_flat" {
  reclaim_discard_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_discard_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "aggregate_rvalue_scrutinee_churn_correct" {
  Test.assert_eq(reclaim_scrutinee_churn(1000), 750000)
}

-- Stage B lock: mut bindings release their final slot value at scope
-- exit (fn-level muts; loop-body muts were already covered by the
-- loop-scope cleanup machinery).

fn reclaim_mut_scope(i: i64) -> i64 {
  let mut b = reclaim_rvalue_box(i)
  b = reclaim_rvalue_box(i + 1)
  match b { RBoxA(x) -> x, RBoxB(x, y) -> x + y }
}

fn reclaim_mut_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc + reclaim_mut_scope(i)
    i = i + 1
  }
  acc
}

test "aggregate_mut_scope_release_heap_flat" {
  reclaim_mut_churn(200)
  let before = runtime_rc_test_heap_arena_offset()
  reclaim_mut_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

-- Deep release (2q slice 2 stage B): a dying aggregate drops one count
-- on each managed payload field per its header mask; the cascade is an
-- iterative worklist threaded through dying nodes' headers, so
-- million-deep list spines reclaim without recursion. Payload-less
-- ctor Idents (DeepNil) classify as owned constructions, not borrows.
type DeepLeaf { DeepLeaf(i64) }
type DeepTree {
  DeepNil,
  DeepNode(i64, DeepLeaf, DeepTree)
}

fn deep_interior_churn(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let t = DeepNode(i, DeepLeaf(i * 2), DeepNil)
    acc = acc + match t { DeepNil -> 0, DeepNode(k, leaf, rest) -> k }
    i = i + 1
  }
  acc
}

fn deep_chain_build(n: i64) -> DeepTree {
  let mut t = DeepNil
  let mut i = 0
  while i < n {
    t = DeepNode(i, DeepLeaf(i), t)
    i = i + 1
  }
  t
}

fn deep_chain_key(t: DeepTree) -> i64 {
  match t { DeepNil -> 0 - 1, DeepNode(k, leaf, rest) -> k }
}

fn deep_chain_churn(len: i64, rounds: i64) -> i64 {
  let mut r = 0
  let mut acc = 0
  while r < rounds {
    acc = acc + deep_chain_key(deep_chain_build(len))
    r = r + 1
  }
  acc
}

fn deep_extract_leaf(i: i64) -> DeepLeaf {
  match DeepNode(i, DeepLeaf(i * 10 + 7), DeepNil) {
    DeepNil -> DeepLeaf(0 - 1)
    DeepNode(k, leaf, rest) -> leaf
  }
}

fn deep_leaf_val(l: DeepLeaf) -> i64 {
  match l { DeepLeaf(v) -> v }
}

test "deep_release_interior_churn_stays_flat" {
  deep_interior_churn(2000)
  let before = runtime_rc_test_heap_arena_offset()
  deep_interior_churn(50000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

test "deep_release_chain_churn_stays_flat" {
  deep_chain_churn(1000, 4)
  let before = runtime_rc_test_heap_arena_offset()
  deep_chain_churn(1000, 200)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

test "deep_release_two_million_chain_no_stack_blowup" {
  Test.assert_eq(deep_chain_key(deep_chain_build(2000000)), 1999999)
}

test "deep_release_extraction_keeps_leaf_alive" {
  let leaf = deep_extract_leaf(4)
  deep_interior_churn(64)
  Test.assert_eq(deep_leaf_val(leaf), 47)
}

test "payloadless_ctor_arg_reclaims" {
  -- DeepNil as ctor arg is an owned construction, not a borrow: no
  -- borrow-retain, freed by the parent's deep release (the 64B/iter
  -- leak this classification fix closed).
  let mut i = 0
  while i < 2000 {
    let t = DeepNode(i, DeepLeaf(i), DeepNil)
    i = i + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut j = 0
  while j < 20000 {
    let t = DeepNode(j, DeepLeaf(j), DeepNil)
    j = j + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before <= 4096, true)
}

-- Runtime-owned frees (2q slice 2): growth-abandoned vector/buffer
-- data returns to the heap, and the best-fit overflow scan keeps
-- doubling ladders recycling. Per-round drift is bounded by the FINAL
-- buffer plus header (vector/buffer handles die unobserved — compiler-
-- managed handles are follow-up work), never the whole growth ladder.
fn growth_vec_round(n: i64) -> i64 {
  let v = vector_new<i64>()
  let mut i = 0
  while i < n {
    vector_push<i64>(v, i)
    i = i + 1
  }
  vector_len(v)
}

fn growth_buf_round(n: i64) -> i64 {
  let b = buf_new(1)
  let mut i = 0
  while i < n {
    bu8(b, i)
    i = i + 1
  }
  buf_len(b)
}

test "vector_growth_abandoned_buffers_recycle" {
  let mut w = 0
  while w < 50 {
    growth_vec_round(1000)
    w = w + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut r = 0
  while r < 100 {
    growth_vec_round(1000)
    r = r + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  -- 1000 i64s = 8KB final buffer + 40B header per round; the growth
  -- ladder (64B..4KB intermediates) must recycle. Allow slack for
  -- overflow-list fragmentation, assert well under ladder leakage.
  Test.assert_eq((after - before) / 100 <= 9000, true)
}

test "buffer_growth_abandoned_buffers_recycle" {
  let mut w = 0
  while w < 50 {
    growth_buf_round(1000)
    w = w + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut r = 0
  while r < 100 {
    growth_buf_round(1000)
    r = r + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq((after - before) / 100 <= 1200, true)
}
