-- Tag with payload: construction + pattern matching + payload extraction
type Shape {
  Circle(Int),
  Rect(Int),
  Point
}

fn classify(s: Shape) -> Int {
  match s {
    Circle(r) -> r,
    Rect(side) -> side * 10,
    Point -> 0
  }
}

fn main() {
  let a = classify(Shape.Circle(7))
  let b = classify(Shape.Rect(3))
  let c = classify(Shape.Point)
  -- 7 + 30 + 0 = 37
  a + b + c
}
