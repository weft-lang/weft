-- Expected exit code: 37
-- Tag with payload: construction + pattern matching + payload extraction
type Shape {
  Circle(i64),
  Rect(i64),
  Point
}

fn classify(s: Shape) -> i64 {
  match s {
    Circle(r) -> r,
    Rect(side) -> side * 10,
    Point -> 0
  }
}

fn main() {
  let a = classify(Circle(7))
  let b = classify(Rect(3))
  let c = classify(Point)
  -- 7 + 30 + 0 = 37
  a + b + c
}
