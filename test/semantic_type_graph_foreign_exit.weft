-- Expected exit code: 101

use compiler/types/graph.{*}
use compiler/project/identity.{anonymous_module_identity_in_package}

fn segment(ordinal: usize) -> SemanticTypeSegmentId {
  semantic_type_segment_id(anonymous_module_identity_in_package(ordinal, 91))
}

fn main() -> i64 {
  let first_builder = semantic_type_graph_builder(segment(31))
  let (first_builder, first_type) = first_builder.top()
  let first = first_builder.freeze()

  let second_builder = semantic_type_graph_builder(segment(32))
  let (second_builder, second_type) = second_builder.top()
  let second = second_builder.freeze()

  semantic_type_graph_kind(first, second_type)
  semantic_type_graph_kind(second, first_type)
  0
}
