-- Expected exit code: 101
-- An element read past the initialized elements panics before forming an
-- address, instead of loading memory beyond the vector.

use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds}

fn main() -> i64 {
  let mut values = vector.new<i64>()
  values.push(7)
  vector_get_in_bounds<i64>(values, 1)
}
