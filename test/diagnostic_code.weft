use stdlib/diagnostic as diagnostic
use stdlib/diagnostic.{*}
use stdlib/eq.{Eq}
use stdlib/string
use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}

fn code_equal<T: Eq>(left: T, right: T) -> bool { left.eq(right) }

test "diagnostic code equality preserves absence empty text and exact managed content" {
  let cases = [
    (DiagnosticCodeUnassigned, 0),
    (DiagnosticCodeAssigned(""), 1),
    (DiagnosticCodeAssigned("E1002"), 2),
    (DiagnosticCodeAssigned("E".concat("1002")), 2),
    (DiagnosticCodeAssigned("E1003"), 3),
    (DiagnosticCodeAssigned("🧶".repeat(2)), 4),
    (DiagnosticCodeAssigned("🧶🧶"), 4),
    (DiagnosticCodeAssigned("E\0X"), 5),
    (DiagnosticCodeAssigned("E".concat("\0X")), 5),
    (DiagnosticCodeAssigned("E\0Y"), 6),
    (DiagnosticCodeAssigned("E"), 7)
  ]
  for (left, left_id) in cases {
    Test.assert_true(left.eq(left))
    for (right, right_id) in cases {
      Test.assert_eq(if code_equal(left, right) { 1 } else { 0 }, if left_id == right_id { 1 } else { 0 })
      Test.assert_true(left.eq(right) == right.eq(left))
      for (third, _) in cases {
        if left.eq(right) and right.eq(third) { Test.assert_true(left.eq(third)) }
      }
    }
  }
}

fn code_comparison_churn() -> bool {
  DiagnosticCodeAssigned("woven".repeat(8)).eq(DiagnosticCodeAssigned("wovenwoven".repeat(4)))
}

test "diagnostic code comparison releases independent managed strings" {
  for _ in 0..40 { Test.assert_true(code_comparison_churn()) }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { Test.assert_true(code_comparison_churn()) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}

fn code_report(code: DiagnosticCode) -[Diagnose]> i64 {
  Diagnose.report(Diagnostic(
    DiagnosticSeverityNote, DiagnosticClassTest, code, "code transport",
    DiagnosticLocationNone, DiagnosticRelatedLocationNil, DiagnosticFieldNil
  ))
}

test "diagnostic code alternatives survive their canonical effect transport" {
  for original in [DiagnosticCodeUnassigned, DiagnosticCodeAssigned(""), DiagnosticCodeAssigned("T".repeat(8))] {
    let result = handle code_report(original) {
      Diagnose.report(value) -> {
        Test.assert_true(value.code().eq(original))
        resume(42)
      }
      Diagnose.error(message, span) -> resume(0)
      Diagnose.warn(message, span) -> resume(0)
      Diagnose.note(message, span) -> resume(0)
    }
    Test.assert_eq(result, 42)
  }
}
