use module_fixtures/g2_ctor_left as left
use module_fixtures/g2_ctor_right as right

test "qualified constructors retain declaration identity" {
  Test.assert_eq(left.read(left.Same(41)), 41)
  Test.assert_true(right.read(right.Same(true)))
}

test "qualified nullary constructor is a value" {
  Test.assert_eq(left.read(left.Empty), 0)
}

test "qualified generic constructor specializes its parent family" {
  Test.assert_eq(left.unpack(left.Packed<i64>(42), 0), 42)
}

test "qualified constructor arguments preserve cfg" {
  Test.assert_eq(left.read(left.Same(if true { 43 } else { 0 })), 43)
}

test "qualified patterns retain constructor identity" {
  let left_value = match left.Same(44) {
    left.Same(value) -> value
    left.Empty -> 0
  }
  let right_value = match right.Same(true) {
    right.Same(value) -> value
  }
  Test.assert_eq(left_value, 44)
  Test.assert_true(right_value)
}

test "qualified nullary patterns participate in exhaustiveness" {
  let value = match left.Empty {
    left.Same(inner) -> inner
    left.Empty -> 0
  }
  Test.assert_eq(value, 0)
}
