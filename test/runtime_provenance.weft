use runtime/provenance.{*}

test "embedded_native_provenance_is_queryable" {
  let table = runtime_native_provenance_table()
  let count = runtime_native_provenance_count()
  let first = runtime_native_provenance_entry_at(table, 0)
  Test.assert_eq(if table != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if count > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(runtime_native_provenance_entry_is_valid(first), 1)
  Test.assert_eq(if runtime_native_provenance_entry_end(first) > runtime_native_provenance_entry_start(first) { 1 } else { 0 }, 1)
  Test.assert_eq(runtime_native_provenance_lookup_offset(runtime_native_provenance_entry_start(first)), first)
}

test "embedded_native_provenance_rejects_forged_entries" {
  let table = runtime_native_provenance_table()
  Test.assert_eq(runtime_native_provenance_entry_at(table, 0 - 1), 0)
  Test.assert_eq(runtime_native_provenance_entry_at(table, runtime_native_provenance_count()), 0)
  Test.assert_eq(runtime_native_provenance_entry_start(1), 0)
  Test.assert_eq(runtime_native_provenance_entry_name_ptr(1), 0)
  Test.assert_eq(runtime_native_provenance_entry_file_index(1), 0 - 1)
}

test "embedded_native_provenance_carries_path_records" {
  let table = runtime_native_provenance_table()
  let mut path_count = 0
  let mut i = 0
  while i < runtime_native_provenance_count() {
    let entry = runtime_native_provenance_entry_at(table, i)
    if runtime_native_provenance_entry_path_len(entry) > 0 { path_count = path_count + 1 } else { 0 }
    i = i + 1
  }
  Test.assert_eq(if runtime_native_provenance_file_count() > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if path_count > 0 { 1 } else { 0 }, 1)
}
