use runtime/alloc.{arena_alloc, arena_free, arena_new}
use runtime/memory.{mem_load64, mem_store64}
use runtime/rc_implicit_test.{runtime_rc_probe_count, runtime_rc_probe_load, runtime_rc_probe_new}
use runtime/spawn_task.{*}
use stdlib/task as task

effect SpawnProbe {
  fn read(value: i64) -> i64
}

effect SpawnMark {
  fn set(value: i64) -> nil
}

effect SpawnAbort {
  fn stop() -> i64
}

fn spawn_probe_child(value: i64) -[SpawnProbe]> i64 {
  SpawnProbe.read(value) + 1
}

test "sequential TaskScope returns an ordinary scalar result" {
  let got = task.with_sequential(() => {
    let child = task.spawn(() => 42)
    task.join(child)
  })
  Test.assert_eq(got, 42)
}

test "generic task scope infers a result from an explicit return" {
  let got = task.with_sequential(() => {
    return 42
  })
  Test.assert_eq(got, 42)
}

test "nested lambda returns do not change the task scope result" {
  let got = task.with_sequential(() => {
    let nested_fn = () => {
      return "nested"
    }
    let nested = nested_fn()
    if nested == "nested" { return 42 } else { return 0 }
  })
  Test.assert_eq(got, 42)
}

test "effectful task preserves its residual effect contract" {
  let got = handle task.with_sequential(() => {
    let child = task.spawn(() => spawn_probe_child(20))
    task.join(child)
  }) {
    SpawnProbe.read(value) -> resume(value * 2)
  }
  Test.assert_eq(got, 41)
}

test "nested TaskScope stays inside the same structured scope" {
  let got = task.with_sequential(() => {
    let outer = task.spawn(() => {
      let inner = task.spawn(() => 40)
      task.join(inner) + 2
    })
    task.join(outer)
  })
  Test.assert_eq(got, 42)
}

test "typed carrier preserves managed captures and multi-lane results" {
  let prefix = "weft"
  let got = task.with_sequential(() => {
    let child = task.spawn(() => (prefix, 42))
    let (name, value): (str, i64) = task.join(child)
    if name == "weft" { value } else { 0 }
  })
  Test.assert_eq(got, 42)
}

test "dropping an observation right still executes and cleans its task" {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let payload = runtime_rc_probe_new(42)
  let baseline = runtime_rc_probe_count(payload)
  let done = handle task.with_sequential(() => {
    let ignored = task.spawn(() => {
      SpawnMark.set(runtime_rc_probe_load(payload))
      0
    })
    1
  }) {
    SpawnMark.set(value) -> {
      mem_store64(cell, value)
      resume(nil)
    }
  }
  Test.assert_eq(done, 1)
  Test.assert_eq(mem_load64(cell), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), baseline)
  arena_free(arena)
}

test "child abort releases the running carrier capture exactly once" {
  let payload = runtime_rc_probe_new(42)
  let baseline = runtime_rc_probe_count(payload)
  let got = handle task.with_sequential(() => {
    let child = task.spawn(() => {
      let observed = runtime_rc_probe_load(payload)
      SpawnAbort.stop() + observed
    })
    task.join(child)
  }) {
    SpawnAbort.stop() -> 7
  }
  Test.assert_eq(got, 7)
  Test.assert_eq(runtime_rc_probe_count(payload), baseline)
}

test "sequential runtime assigns stable issue-order task identities" {
  let scope = runtime_spawn_scope_new()
  let first_work = runtime_spawn_work_pack<i64, Test>(() => 20)
  let second_work = runtime_spawn_work_pack<i64, Test>(() => 22)
  let first = runtime_spawn_scope_track(scope, first_work)
  let second = runtime_spawn_scope_track(scope, second_work)
  Test.assert_eq(runtime_spawn_task_id(first), 1)
  Test.assert_eq(runtime_spawn_task_id(second), 2)
  Test.assert_eq(runtime_spawn_scope_cleanup(scope), 1)
}
