-- test/short_circuit_effects.weft -- semantics lock: `and` short-
-- circuits, including when the right operand performs effects that a
-- handler observes (0 bumps when the left operand is false).

use "runtime/alloc.weft"
use "runtime/memory.weft"

effect Count {
  fn bump() -> i64
}

fn rhs_bump() -[Count]> bool {
  Count.bump()
  true
}

fn and_probe(flag: bool) -[Count]> bool {
  flag and rhs_bump()
}

fn run_and(flag: bool) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let r = handle and_probe(flag) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let n = mem_load64(cell)
  arena_free(arena)
  if r { n + 100 } else { n }
}

test "and_short_circuits_effectful_rhs_false_lhs" {
  Test.assert_eq(run_and(1 == 2), 0)
}

test "and_evaluates_effectful_rhs_true_lhs" {
  Test.assert_eq(run_and(1 == 1), 101)
}
