-- test/short_circuit_effects.weft -- semantics lock: `and` short-
-- circuits, including when the right operand performs effects that a
-- handler observes (0 bumps when the left operand is false).

use "runtime/alloc.weft"
use "runtime/memory.weft"

effect Count {
  fn bump() -> i64
}

fn rhs_bump() -[Count]> bool {
  Count.bump()
  true
}

fn and_probe(flag: bool) -[Count]> bool {
  flag and rhs_bump()
}

fn run_and(flag: bool) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let r = handle and_probe(flag) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let n = mem_load64(cell)
  arena_free(arena)
  if r { n + 100 } else { n }
}

test "and_short_circuits_effectful_rhs_false_lhs" {
  Test.assert_eq(run_and(1 == 2), 0)
}

test "and_evaluates_effectful_rhs_true_lhs" {
  Test.assert_eq(run_and(1 == 1), 101)
}

-- Loop-body guards: the loop-if lowering historically routed its whole
-- condition through the straight-line path without consulting the CFG
-- gate, so an and/or guard inside a while body evaluated BOTH operands
-- eagerly — for an effectful RHS that was an observable semantics bug
-- (the perform ran even when the LHS was false). Locked here: guards
-- inside loop bodies short-circuit exactly like top-level guards.

fn loop_and_probe(n: i64, flag: bool) -[Count]> i64 {
  let mut g = 0
  let mut hits = 0
  while g < n {
    if flag and rhs_bump() {
      hits = hits + 1
    } else { 0 }
    g = g + 1
  }
  hits
}

fn run_loop_and(n: i64, flag: bool) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let hits = handle loop_and_probe(n, flag) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let bumps = mem_load64(cell)
  arena_free(arena)
  bumps * 1000 + hits
}

test "loop_body_and_short_circuits_effectful_rhs_false_lhs" {
  -- Three iterations, LHS always false: the effectful RHS must never
  -- run and the then-arm must never be taken.
  Test.assert_eq(run_loop_and(3, 1 == 2), 0)
}

test "loop_body_and_evaluates_effectful_rhs_true_lhs" {
  -- Three iterations, LHS true: the RHS runs each iteration and the
  -- then-arm follows its result.
  Test.assert_eq(run_loop_and(3, 1 == 1), 3003)
}
