-- test/short_circuit_effects.weft -- semantics lock: `and` short-
-- circuits, including when the right operand performs effects that a
-- handler observes (0 bumps when the left operand is false).

use runtime/alloc.{*}
use runtime/memory.{*}

effect Count {
  fn bump() -> i64
}

fn rhs_bump() -[Count]> bool {
  Count.bump()
  true
}

fn and_probe(flag: bool) -[Count]> bool {
  flag and rhs_bump()
}

fn run_and(flag: bool) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let r = handle and_probe(flag) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let n = mem_load64(cell)
  arena_free(arena)
  if r { n + 100 } else { n }
}

test "and_short_circuits_effectful_rhs_false_lhs" {
  Test.assert_eq(run_and(1 == 2), 0)
}

test "and_evaluates_effectful_rhs_true_lhs" {
  Test.assert_eq(run_and(1 == 1), 101)
}

-- Loop-body guards: the loop-if lowering historically routed its whole
-- condition through the straight-line path without consulting the CFG
-- gate, so an and/or guard inside a while body evaluated BOTH operands
-- eagerly — for an effectful RHS that was an observable semantics bug
-- (the perform ran even when the LHS was false). Locked here: guards
-- inside loop bodies short-circuit exactly like top-level guards.

fn loop_and_probe(n: i64, flag: bool) -[Count]> i64 {
  let mut g = 0
  let mut hits = 0
  while g < n {
    if flag and rhs_bump() {
      hits = hits + 1
    } else { 0 }
    g = g + 1
  }
  hits
}

fn run_loop_and(n: i64, flag: bool) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let hits = handle loop_and_probe(n, flag) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let bumps = mem_load64(cell)
  arena_free(arena)
  bumps * 1000 + hits
}

test "loop_body_and_short_circuits_effectful_rhs_false_lhs" {
  -- Three iterations, LHS always false: the effectful RHS must never
  -- run and the then-arm must never be taken.
  Test.assert_eq(run_loop_and(3, 1 == 2), 0)
}

test "loop_body_and_evaluates_effectful_rhs_true_lhs" {
  -- Three iterations, LHS true: the RHS runs each iteration and the
  -- then-arm follows its result.
  Test.assert_eq(run_loop_and(3, 1 == 1), 3003)
}

-- Nested while CONDITIONS: the node-path while lowering (whiles inside
-- loop bodies reach it through the loop-body dispatcher) evaluated
-- and/or condition operands eagerly. 2n fixed loop-body `if` guards but
-- the while-condition arm kept the straight-line form until a guarded
-- nlist probe in an inner while condition faulted (2v Stage 0). Locked
-- both ways: an effectful RHS must not run when the LHS decides, and a
-- guarded memory load in the RHS must not fault. `or` routes through
-- the same logical lowering (op 13) as `and` (op 12).

fn inner_while_and_probe(n: i64, enter: i64) -[Count]> i64 {
  let mut outer = 0
  let mut spins = 0
  while outer < n {
    let mut inner = 0
    while inner < enter and rhs_bump() {
      spins = spins + 1
      inner = inner + 1
    }
    outer = outer + 1
  }
  spins
}

fn run_inner_while_and(n: i64, enter: i64) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let spins = handle inner_while_and_probe(n, enter) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let bumps = mem_load64(cell)
  arena_free(arena)
  bumps * 1000 + spins
}

test "nested_while_cond_and_short_circuits_effectful_rhs" {
  -- Inner LHS false on entry: the effectful RHS must never run across
  -- three outer iterations.
  Test.assert_eq(run_inner_while_and(3, 0), 0)
}

test "nested_while_cond_and_evaluates_rhs_when_lhs_true" {
  -- Inner runs once per outer iteration: the RHS bumps on the entering
  -- check; the exiting check short-circuits on the false LHS.
  Test.assert_eq(run_inner_while_and(3, 1), 3003)
}

fn rhs_bump_false() -[Count]> bool {
  Count.bump()
  false
}

fn inner_while_or_probe(n: i64) -[Count]> i64 {
  let mut outer = 0
  let mut spins = 0
  while outer < n {
    let mut inner = 0
    while inner < 0 or rhs_bump_false() {
      spins = spins + 1
      inner = inner + 1
    }
    outer = outer + 1
  }
  spins
}

fn run_inner_while_or(n: i64) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let spins = handle inner_while_or_probe(n) {
    Count.bump() -> {
      mem_store64(cell, mem_load64(cell) + 1)
      resume(0)
    }
  }
  let bumps = mem_load64(cell)
  arena_free(arena)
  bumps * 1000 + spins
}

test "nested_while_cond_or_evaluates_rhs_when_lhs_false" {
  -- False LHS forces the or's RHS each entering check: one bump per
  -- outer iteration, body never entered.
  Test.assert_eq(run_inner_while_or(3), 3000)
}

fn nested_probe_node_at(l: i64, i: i64) -> i64 { mem_load64_at(l, 16 + i * 8) }

fn nested_while_guarded_load(list: i64, len: i64, limit: i64) -> i64 {
  let mut pos = 0
  let mut ei = 0
  let mut acc = 0
  while pos < limit {
    while ei < len and mem_load64_at(nested_probe_node_at(list, ei), 8) <= pos {
      acc = acc + 1
      ei = ei + 1
    }
    pos = pos + 4
  }
  acc
}

test "nested_while_cond_guard_protects_faulting_load" {
  -- One real entry: once ei reaches len the RHS would dereference the
  -- empty cell (a null node, address 8) — the guard must protect it.
  -- Under the eager lowering this faulted (SIGSEGV), not just misread.
  let node = alloc_words(5)
  mem_store64_at(node, 0, 1)
  mem_store64_at(node, 8, 4)
  let list = alloc_words(4)
  mem_store64_at(list, 16, node)
  mem_store64_at(list, 24, 0)
  Test.assert_eq(nested_while_guarded_load(list, 1, 8), 1)
}
