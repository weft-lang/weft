use runtime/rc_implicit_test.{ RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count }
use stdlib/test.{ Test }

type MethodBorrowBox { MethodBorrowBox(RuntimeRcProbe) }
type MethodBorrowPackage { value: MethodBorrowBox }
type MethodBorrowReceiver { MethodBorrowReceiver }

effect MethodBorrowEffect { fn observe(value: MethodBorrowBox) -> i64 }

impl MethodBorrowBox {
  fn read(self) -> i64 {
    match self { MethodBorrowBox(value) -> runtime_rc_probe_load(value) }
  }

  fn identity(self) -> Self { self }

  fn with_tag<T>(self, tag: T) -> Self { self }

  fn packed(self) -> MethodBorrowPackage { MethodBorrowPackage { value: self } }

  fn reader(self) -> () -> i64 { () => self.read() }

  fn observed(self) -[MethodBorrowEffect]> i64 { MethodBorrowEffect.observe(self) }
}

impl MethodBorrowReceiver {
  fn receive(self, value: RuntimeRcProbe) -> MethodBorrowBox { MethodBorrowBox(value) }
}

fn method_read(value: MethodBorrowBox) -> i64 { value.read() }
fn method_identity(value: MethodBorrowBox) -> MethodBorrowBox { value.identity() }
fn method_package(value: MethodBorrowBox) -> MethodBorrowPackage { value.packed() }
fn method_reader(value: MethodBorrowBox) -> () -> i64 { value.reader() }
fn method_generic(value: MethodBorrowBox) -> MethodBorrowBox { value.with_tag<bool>(true) }
fn method_observed(value: MethodBorrowBox) -[MethodBorrowEffect]> i64 { value.observed() }
fn method_received(receiver: MethodBorrowReceiver, value: RuntimeRcProbe) -> MethodBorrowBox { receiver.receive(value) }

fn method_read_scope(probe: RuntimeRcProbe) -> i64 {
  let value = MethodBorrowBox(probe)
  method_read(value) + method_read(value)
}

fn method_identity_scope(probe: RuntimeRcProbe) -> i64 {
  let value = MethodBorrowBox(probe)
  let first = method_identity(value)
  let second = method_identity(value)
  first.read() + second.read() + value.read()
}

fn method_package_scope(probe: RuntimeRcProbe) -> i64 {
  let value = MethodBorrowBox(probe)
  let packed = method_package(value)
  packed.value.read() + value.read()
}

fn method_reader_scope(probe: RuntimeRcProbe) -> i64 {
  let value = MethodBorrowBox(probe)
  let read = method_reader(value)
  read() + read()
}

fn method_generic_scope(probe: RuntimeRcProbe) -> i64 {
  let value = MethodBorrowBox(probe)
  let result = method_generic(value)
  result.read() + value.read()
}

fn method_effect_scope(probe: RuntimeRcProbe) -[MethodBorrowEffect]> i64 {
  let value = MethodBorrowBox(probe)
  method_observed(value)
}

fn method_argument_scope(probe: RuntimeRcProbe) -> i64 {
  let receiver = MethodBorrowReceiver
  let value = method_received(receiver, probe)
  value.read()
}

test "method observation wrappers borrow through repeated calls" {
  let probe = runtime_rc_probe_new(21)
  Test.assert_eq(method_read_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "method alias returns keep each returned value alive" {
  let probe = runtime_rc_probe_new(14)
  Test.assert_eq(method_identity_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "method aggregate construction acquires its receiver" {
  let probe = runtime_rc_probe_new(21)
  Test.assert_eq(method_package_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "method closure capture acquires its receiver" {
  let probe = runtime_rc_probe_new(21)
  Test.assert_eq(method_reader_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "generic method alias returns preserve ownership" {
  let probe = runtime_rc_probe_new(21)
  Test.assert_eq(method_generic_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "resuming method effect retires transferred receiver ownership" {
  let probe = runtime_rc_probe_new(42)
  let result = handle method_effect_scope(probe) {
    MethodBorrowEffect.observe(value) -> resume(value.read())
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "aborting method effect cleans caller and callee obligations once" {
  let probe = runtime_rc_probe_new(42)
  let result = handle method_effect_scope(probe) {
    MethodBorrowEffect.observe(value) -> value.read()
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "owning method arguments acquire a stake from a borrowed wrapper parameter" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(method_argument_scope(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}
