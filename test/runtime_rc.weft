use "runtime/rc.weft"

test "runtime_rc_layout_constants" {
  Test.assert_eq(rc_header_size(), 32)
  Test.assert_eq(rc_count_offset(), 0)
  Test.assert_eq(rc_payload_size_offset(), 8)
  Test.assert_eq(rc_weak_count_offset(), 16)
  Test.assert_eq(rc_default_heap_offset(), 8)
  Test.assert_eq(if rc_default_heap_capacity() >= 4096 { 1 } else { 0 }, 1)
}

test "runtime_rc_default_heap_lazily_initializes" {
  let cell = rc_default_heap_cell()
  Test.assert_eq(__mem_load64(cell), 0)
  let heap = rc_default_heap()
  Test.assert_eq(if heap != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(__mem_load64(cell), heap)
  Test.assert_eq(rc_default_heap(), heap)
}

test "runtime_rc_default_lifecycle_reuses_zeroed_block" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_default_retain(payload), 2)
  Test.assert_eq(rc_default_release(payload), 1)
  __mem_store64(payload, 91)
  Test.assert_eq(rc_default_release(payload), 0)
  let again: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, payload)
  Test.assert_eq(__mem_load64(again), 0)
  Test.assert_eq(rc_default_release(again), 0)
}

test "runtime_rc_default_invalid_paths" {
  Test.assert_eq(rc_default_alloc(0 - 1, 8), 0)
  Test.assert_eq(rc_default_retain(0), 0 - 1)
  Test.assert_eq(rc_default_release(0), 0 - 1)
}

test "runtime_rc_weak_load_retains_live_target" {
  let payload: i64 = rc_default_alloc(8, 8)
  __mem_store64(payload, 123)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_weak_count(payload), 1)
  let loaded: i64 = rc_default_weak_load(payload)
  Test.assert_eq(loaded, payload)
  Test.assert_eq(__mem_load64(loaded), 123)
  Test.assert_eq(rc_count(payload), 2)
  Test.assert_eq(rc_default_release(loaded), 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
  Test.assert_eq(rc_default_release(payload), 0)
}

test "runtime_rc_weak_load_returns_nil_after_target_release" {
  let payload: i64 = rc_default_alloc(8, 8)
  __mem_store64(payload, 77)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  Test.assert_eq(rc_count(payload), 0)
  Test.assert_eq(__mem_load64(payload), 0)
  Test.assert_eq(rc_default_weak_load(payload), 0)
  Test.assert_eq(rc_default_weak_release(payload), 0)
}

test "runtime_rc_weak_keeps_dead_block_out_of_free_list" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  let other: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(if other != payload { 1 } else { 0 }, 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
  let reused: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(reused, payload)
  Test.assert_eq(rc_default_release(other), 0)
  Test.assert_eq(rc_default_release(reused), 0)
}

test "runtime_rc_weak_dead_references_can_be_copied_until_released" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  Test.assert_eq(rc_default_weak_retain(payload), 2)
  Test.assert_eq(rc_default_weak_load(payload), 0)
  Test.assert_eq(rc_default_weak_release(payload), 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
}

test "runtime_rc_weak_invalid_paths" {
  Test.assert_eq(rc_default_weak_retain(0), 0 - 1)
  Test.assert_eq(rc_default_weak_load(0), 0)
  Test.assert_eq(rc_default_weak_release(0), 0 - 1)
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_release(payload), 0 - 1)
  Test.assert_eq(rc_default_release(payload), 0)
}

test "runtime_rc_continuation_drop_releases_segment_rc_slot" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
}

test "runtime_rc_continuation_drop_releases_segment_closure_slot" {
  let f: i64 = rc_default_alloc(16, 8)
  Test.assert_eq(closure_default_retain(f), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, f)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_closure(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(f), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(rc_default_release(f), 0)
}

test "runtime_rc_closure_env_releases_continuation_slot" {
  let k = continuation_new_noop()
  let env: i64 = rc_default_alloc(24, 8)
  __mem_store64(env, 1)
  __mem_store64(env + 8, k)
  __mem_store64(env + 16, continuation_cleanup_kind_continuation())
  Test.assert_eq(closure_default_release_env(env), 0)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
}

test "runtime_rc_closure_release_drops_continuation_env" {
  let k = continuation_new_noop()
  let env: i64 = rc_default_alloc(24, 8)
  __mem_store64(env, 1)
  __mem_store64(env + 8, k)
  __mem_store64(env + 16, continuation_cleanup_kind_continuation())
  let f: i64 = rc_default_alloc(16, 8)
  __mem_store64(f, 0)
  __mem_store64(f + 8, env)
  Test.assert_eq(closure_default_release(f), 0)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
}

test "runtime_rc_continuation_drop_releases_multiple_segment_slots" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let f: i64 = rc_default_alloc(16, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  Test.assert_eq(closure_default_retain(f), 2)
  let segment = alloc_bump(16)
  __mem_store64(segment, p)
  __mem_store64(segment + 8, f)
  let desc = continuation_cleanup_desc_new(2)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  continuation_cleanup_desc_set(desc, 1, continuation_cleanup_kind_closure(), 8, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_cleanup_release_segment(k), 2)
  Test.assert_eq(continuation_cleanup_release_segment(k), 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(rc_count(f), 1)
  Test.assert_eq(rc_default_release(f), 0)
}

test "runtime_rc_continuation_drop_skips_without_segment" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_default_release(p), 1)
}

test "runtime_rc_continuation_drop_skips_resumed_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_resumed(k), 1)
  Test.assert_eq(continuation_drop_managed(k), 0)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_default_release(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 1)
}

test "runtime_rc_continuation_resume_releases_segment_once" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_resume_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_resumed())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(continuation_resume_managed(k), 0)
  Test.assert_eq(continuation_drop_managed(k), 0)
}

test "runtime_rc_continuation_auto_drop_skips_stored_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_stored(k), 1)
  Test.assert_eq(continuation_drop_managed(k), 0)
  Test.assert_eq(continuation_status(k), continuation_status_stored())
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 1)
  Test.assert_eq(continuation_drop_owned_managed(k), 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
}

test "runtime_rc_continuation_resume_managed_accepts_stored_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = alloc_bump(8)
  __mem_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_stored(k), 1)
  Test.assert_eq(continuation_resume_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_resumed())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
}

fn runtime_rc_auto_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 77)
  let addr = p + 0
  addr
}

fn runtime_rc_param_count(p: rc i64) -> i64 {
  rc_count(p)
}

fn runtime_rc_choose(flag: i64, p: rc i64, q: rc i64) -> rc i64 {
  if flag == 1 { p } else { q }
}

fn runtime_rc_identity<T>(x: T) -> T {
  x
}

fn runtime_rc_apply_closure(f: (rc i64) -> i64, p: rc i64) -> i64 {
  f(p)
}

fn runtime_rc_closure_capture_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let addr = p + 0
  let f = () => rc_count(p)
  addr
}

fn runtime_rc_closure_capture_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 41)
  () => __mem_load64(p)
}

fn runtime_rc_closure_copy_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 42)
  let f = () => __mem_load64(p)
  let g = f
  g
}

fn runtime_rc_closure_assignment_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 43)
  let f = () => 0
  let g = () => __mem_load64(p)
  let mut h = f
  h = g
  h
}

fn runtime_rc_nested_closure_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 44)
  let read = () => __mem_load64(p)
  let outer = () => read()
  outer
}

type RuntimeRcMethodBox {
  value: i64
}

impl RuntimeRcMethodBox {
  fn touch(self: RuntimeRcMethodBox, p: rc i64) -> i64 {
    rc_count(p)
  }
}

fn runtime_rc_break_addr() -> i64 {
  let mut addr = 0
  while addr == 0 {
    let p: rc i64 = rc_default_alloc(8, 8)
    addr = p + 0
    break
  }
  addr
}

fn runtime_rc_continue_addr() -> i64 {
  let mut addr = 0
  let mut done = 0
  while done == 0 {
    done = 1
    let p: rc i64 = rc_default_alloc(8, 8)
    addr = p + 0
    continue
  }
  addr
}

test "runtime_rc_auto_release_scope_reuses_zeroed_block" {
  let old = runtime_rc_auto_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, old)
  Test.assert_eq(__mem_load64(again), 0)
}

test "runtime_rc_auto_copy_retain_balances_scope_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_count(p), 1)
  let q: rc i64 = p
  Test.assert_eq(q, p)
  Test.assert_eq(rc_count(p), 2)
}

test "runtime_rc_auto_assignment_releases_old_and_retains_new" {
  let first: rc i64 = rc_default_alloc(8, 8)
  let second: rc i64 = rc_default_alloc(8, 8)
  let mut cur: rc i64 = first
  Test.assert_eq(rc_count(first), 2)
  Test.assert_eq(rc_count(second), 1)
  cur = second
  Test.assert_eq(rc_count(first), 1)
  Test.assert_eq(rc_count(second), 2)
}

test "runtime_rc_auto_param_retain_and_callee_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(runtime_rc_param_count(p), 2)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = if 1 == 1 { p } else { q }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_block_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = { 0 if 1 == 1 { p } else { q } }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_match_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = match 1 {
    1 -> p,
    _ -> q
  }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_assignment" {
  let first: rc i64 = rc_default_alloc(8, 8)
  let second: rc i64 = rc_default_alloc(8, 8)
  let third: rc i64 = rc_default_alloc(8, 8)
  let mut cur: rc i64 = first
  cur = if 1 == 1 { second } else { third }
  Test.assert_eq(rc_count(first), 1)
  Test.assert_eq(rc_count(second), 2)
  Test.assert_eq(rc_count(third), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_call_arg" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(runtime_rc_param_count(if 1 == 1 { p } else { q }), 2)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_return" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = runtime_rc_choose(1, p, q)
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_method_arg_retain_and_release" {
  let box = RuntimeRcMethodBox { value: 1 }
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(box.touch(p), 2)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_auto_closure_arg_retain_and_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let f = (x: rc i64) => rc_count(x)
  Test.assert_eq(runtime_rc_apply_closure(f, p), 3)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_closure_capture_release_reuses_block" {
  let old = runtime_rc_closure_capture_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, old)
}

test "runtime_rc_returned_closure_keeps_captured_rc_alive" {
  let f = runtime_rc_closure_capture_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(q, 99)
  Test.assert_eq(f(), 41)
}

test "runtime_rc_closure_copy_keeps_env_alive" {
  let f = runtime_rc_closure_copy_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(q, 99)
  Test.assert_eq(f(), 42)
}

test "runtime_rc_closure_assignment_keeps_env_alive" {
  let f = runtime_rc_closure_assignment_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(q, 99)
  Test.assert_eq(f(), 43)
}

test "runtime_rc_nested_closure_keeps_captured_closure_alive" {
  let f = runtime_rc_nested_closure_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(q, 99)
  Test.assert_eq(f(), 44)
}

test "runtime_rc_auto_generic_arg_retain_and_return" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = runtime_rc_identity<rc i64>(p)
  Test.assert_eq(q, p)
  Test.assert_eq(rc_count(p), 2)
}

test "runtime_rc_auto_control_transfer_releases_loop_locals" {
  let break_old = runtime_rc_break_addr()
  let break_again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(break_again, break_old)
  let continue_old = runtime_rc_continue_addr()
  let continue_again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(continue_again, continue_old)
}

test "runtime_rc_alloc_initializes_payload" {
  let heap = heap_new(64)
  let payload = rc_alloc(heap, 8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_header_from_payload(payload) + rc_header_size(), payload)
  Test.assert_eq(rc_payload_from_header(rc_header_from_payload(payload)), payload)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 8)
  Test.assert_eq(rc_weak_count(payload), 0)
  Test.assert_eq(rc_block_size(payload), 40)
  Test.assert_eq(__mem_load64(payload), 0)
  __mem_store64(payload, 42)
  Test.assert_eq(__mem_load64(payload), 42)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_retain_release_lifecycle" {
  let heap = heap_new(80)
  let payload = rc_alloc(heap, 8, 8)
  let header = rc_header_from_payload(payload)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_free_head(heap), header)
  Test.assert_eq(heap_free_node_size(header), 40)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_weak_release_frees_dead_block_on_last_weak" {
  let heap = heap_new(128)
  let payload = rc_alloc(heap, 8, 8)
  let header = rc_header_from_payload(payload)
  Test.assert_eq(rc_weak_retain(payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_free_head(heap), 0)
  Test.assert_eq(rc_weak_release(heap, payload), 0)
  Test.assert_eq(heap_free_head(heap), header)
  Test.assert_eq(heap_free_node_size(header), 40)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_multiple_retains" {
  let heap = heap_new(96)
  let payload = rc_alloc(heap, 16, 8)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_retain(payload), 3)
  Test.assert_eq(rc_release(heap, payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_zero_size_payload" {
  let heap = heap_new(32)
  let payload = rc_alloc(heap, 0, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 0)
  Test.assert_eq(rc_block_size(payload), 32)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_invalid_and_overflow_paths" {
  let heap = heap_new(32)
  Test.assert_eq(rc_alloc(0, 8, 8), 0)
  Test.assert_eq(rc_alloc(heap, 0 - 1, 8), 0)
  Test.assert_eq(rc_alloc(heap, 40, 8), 0)
  Test.assert_eq(rc_retain(0), 0 - 1)
  Test.assert_eq(rc_release(heap, 0), 0 - 1)
  Test.assert_eq(rc_release(0, 1234), 0 - 1)
  Test.assert_eq(heap_destroy(heap), 0)
}
