use "runtime/rc.weft"
use "runtime/rc_implicit_test.weft"

fn runtime_rc_test_layout_descriptor(data_size: i64, entry_count: i64) -> i64 {
  let descriptor = runtime_rc_test_alloc_bump(rc_layout_descriptor_header_size() + entry_count * rc_layout_descriptor_entry_size())
  runtime_rc_test_store64(descriptor, rc_layout_descriptor_magic())
  runtime_rc_test_store64(descriptor + 8, data_size)
  runtime_rc_test_store64(descriptor + 16, entry_count)
  descriptor
}

fn runtime_rc_test_layout_descriptor_entry(descriptor: i64, index: i64, offset: i64, count: i64, stride: i64, kind: i64) -> i64 {
  runtime_rc_test_store64(descriptor + rc_layout_descriptor_offset_offset(index), offset)
  runtime_rc_test_store64(descriptor + rc_layout_descriptor_count_offset(index), count)
  runtime_rc_test_store64(descriptor + rc_layout_descriptor_stride_offset(index), stride)
  runtime_rc_test_store64(descriptor + rc_layout_descriptor_kind_offset(index), kind)
  0
}

test "runtime_rc_layout_constants" {
  Test.assert_eq(rc_header_size(), 48)
  Test.assert_eq(rc_count_offset(), 0)
  Test.assert_eq(rc_payload_size_offset(), 8)
  Test.assert_eq(rc_weak_count_offset(), 16)
  Test.assert_eq(rc_promoted_offset(), 24)
  Test.assert_eq(rc_default_heap_offset(), 8)
  Test.assert_eq(rc_atomic_lock_offset(), 32)
  Test.assert_eq(rc_magic_offset(), 40)
  Test.assert_eq(if rc_default_heap_capacity() >= 4096 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_layout_descriptor_flag(), 2147483648)
  Test.assert_eq(rc_size_word_size(2147483680), 32)
  Test.assert_eq(rc_size_word_has_layout_descriptor(2147483680), 1)
}

test "runtime_rc_default_heap_lazily_initializes" {
  let cell = rc_default_heap_cell()
  Test.assert_eq(runtime_rc_test_load64(cell), 0)
  let heap = rc_default_heap()
  Test.assert_eq(if heap != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(runtime_rc_test_load64(cell), heap)
  Test.assert_eq(rc_default_heap(), heap)
}

test "runtime_rc_default_lifecycle_reuses_zeroed_block" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_default_retain(payload), 2)
  Test.assert_eq(rc_default_release(payload), 1)
  runtime_rc_test_store64(payload, 91)
  Test.assert_eq(rc_default_release(payload), 0)
  let again: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, payload)
  Test.assert_eq(runtime_rc_test_load64(again), 0)
  Test.assert_eq(rc_default_release(again), 0)
}

test "runtime_rc_promotion_flag_is_sticky_and_reuse_resets_it" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_is_promoted(payload), 0)
  Test.assert_eq(rc_default_promote(payload), 1)
  Test.assert_eq(rc_is_promoted(payload), 1)
  Test.assert_eq(rc_default_promote(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  let again: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, payload)
  Test.assert_eq(rc_is_promoted(again), 0)
  Test.assert_eq(rc_default_release(again), 0)
}

test "runtime_rc_promoted_values_keep_normal_lifecycle_counts" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_promote(payload), 1)
  Test.assert_eq(rc_default_retain(payload), 2)
  Test.assert_eq(rc_count(payload), 2)
  Test.assert_eq(rc_default_release(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
}

test "runtime_rc_default_invalid_paths" {
  Test.assert_eq(rc_default_alloc(0 - 1, 8), 0)
  Test.assert_eq(rc_default_retain(0), 0 - 1)
  Test.assert_eq(rc_default_release(0), 0 - 1)
}

test "runtime_rc_array_storage_layout_and_empty_lifecycle" {
  let storage: i64 = rc_array_storage_new(0, 8, 0, 8, continuation_cleanup_kind_none())
  Test.assert_eq(rc_count(storage), 1)
  let word = runtime_rc_test_load64(rc_header_from_payload(storage) + rc_payload_size_offset())
  Test.assert_eq(rc_size_word_size(word), rc_array_storage_payload_size())
  Test.assert_eq(rc_size_word_finalizer(word), rc_finalizer_array_storage())
  Test.assert_eq(rc_array_storage_data(storage), 0)
  Test.assert_eq(runtime_rc_test_load64(storage + rc_array_storage_byte_size_offset()), 0)
  Test.assert_eq(runtime_rc_test_load64(storage + rc_array_storage_leaf_count_offset()), 0)
  Test.assert_eq(runtime_rc_test_load64(storage + rc_array_storage_drop_glue_offset()), 0)
  Test.assert_eq(rc_default_release(storage), 0)
}

test "runtime_rc_array_storage_releases_managed_leaves" {
  let first: i64 = rc_default_alloc(8, 8)
  let second: i64 = rc_default_alloc(8, 8)
  let storage: i64 = rc_array_storage_new(16, 8, 2, 8, continuation_cleanup_kind_rc())
  let data = rc_array_storage_data(storage)
  runtime_rc_test_store64(data, first)
  runtime_rc_test_store64(data + 8, second)
  Test.assert_eq(rc_default_release(storage), 0)
  Test.assert_eq(rc_default_payload_has_magic(first), 0)
  Test.assert_eq(rc_default_payload_has_magic(second), 0)
}

test "runtime_rc_array_storage_releases_closure_and_weak_leaves" {
  let closure: i64 = rc_default_alloc(16, 8)
  let closures: i64 = rc_array_storage_new(8, 8, 1, 8, continuation_cleanup_kind_closure())
  runtime_rc_test_store64(rc_array_storage_data(closures), closure)
  Test.assert_eq(rc_default_release(closures), 0)
  Test.assert_eq(rc_default_payload_has_magic(closure), 0)

  let target: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(target), 1)
  let weak_values: i64 = rc_array_storage_new(8, 8, 1, 8, continuation_cleanup_kind_weak())
  runtime_rc_test_store64(rc_array_storage_data(weak_values), target)
  Test.assert_eq(rc_default_release(weak_values), 0)
  Test.assert_eq(rc_weak_count(target), 0)
  Test.assert_eq(rc_default_release(target), 0)
}

test "runtime_rc_array_storage_promotion_is_transitive" {
  let first: i64 = rc_default_alloc(8, 8)
  let second: i64 = rc_default_alloc(8, 8)
  let storage: i64 = rc_array_storage_new(16, 8, 2, 8, continuation_cleanup_kind_rc())
  let data = rc_array_storage_data(storage)
  runtime_rc_test_store64(data, first)
  runtime_rc_test_store64(data + 8, second)
  Test.assert_eq(rc_default_promote(storage), 1)
  Test.assert_eq(rc_is_promoted(first), 1)
  Test.assert_eq(rc_is_promoted(second), 1)
  Test.assert_eq(rc_default_release(storage), 0)
  Test.assert_eq(rc_default_payload_has_magic(first), 0)
  Test.assert_eq(rc_default_payload_has_magic(second), 0)
}

test "runtime_rc_array_storage_rejects_invalid_layouts" {
  Test.assert_eq(rc_array_storage_new(0 - 1, 8, 0, 0, continuation_cleanup_kind_none()), 0)
  Test.assert_eq(rc_array_storage_new(8, 0, 1, 8, continuation_cleanup_kind_none()), 0)
  Test.assert_eq(rc_array_storage_new(8, 8, 0 - 1, 8, continuation_cleanup_kind_none()), 0)
  Test.assert_eq(rc_array_storage_new(8, 8, 1, 0 - 1, continuation_cleanup_kind_none()), 0)
  Test.assert_eq(rc_array_storage_new(8, 8, 1, 8, 99), 0)
  Test.assert_eq(rc_array_storage_new(8, 8, 2, 8, continuation_cleanup_kind_rc()), 0)
  Test.assert_eq(rc_array_storage_new(8, 8, 9223372036854775807, 8, continuation_cleanup_kind_rc()), 0)
  let zst: i64 = rc_array_storage_new(0, 1, 9223372036854775807, 0, continuation_cleanup_kind_none())
  Test.assert_eq(if zst != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_default_release(zst), 0)
}

test "runtime_rc_layout_descriptor_releases_counted_strong_leaves" {
  let descriptor = runtime_rc_test_layout_descriptor(24, 1)
  runtime_rc_test_layout_descriptor_entry(descriptor, 0, 8, 2, 8, continuation_cleanup_kind_rc())
  let first: i64 = rc_default_alloc(8, 8)
  let second: i64 = rc_default_alloc(8, 8)
  let aggregate = rc_default_alloc_described(24, 8, descriptor)
  let word = runtime_rc_test_load64(rc_header_from_payload(aggregate) + rc_payload_size_offset())
  Test.assert_eq(rc_size_word_size(word), 32)
  Test.assert_eq(rc_size_word_has_layout_descriptor(word), 1)
  Test.assert_eq(rc_size_word_mask(word), 0)
  Test.assert_eq(runtime_rc_test_load64(aggregate), descriptor)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset() + 8, first)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset() + 16, second)
  Test.assert_eq(rc_default_release(aggregate), 0)
  Test.assert_eq(rc_default_payload_has_magic(first), 0)
  Test.assert_eq(rc_default_payload_has_magic(second), 0)
}

test "runtime_rc_layout_descriptor_releases_closure_and_weak_entries" {
  let descriptor = runtime_rc_test_layout_descriptor(16, 2)
  runtime_rc_test_layout_descriptor_entry(descriptor, 0, 0, 1, 8, continuation_cleanup_kind_closure())
  runtime_rc_test_layout_descriptor_entry(descriptor, 1, 8, 1, 8, continuation_cleanup_kind_weak())
  let closure: i64 = rc_default_alloc(16, 8)
  let target: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(target), 1)
  let aggregate = rc_default_alloc_described(16, 8, descriptor)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset(), closure)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset() + 8, target)
  Test.assert_eq(rc_default_release(aggregate), 0)
  Test.assert_eq(rc_default_payload_has_magic(closure), 0)
  Test.assert_eq(rc_weak_count(target), 0)
  Test.assert_eq(rc_default_release(target), 0)
}

test "runtime_rc_layout_descriptor_promotion_is_transitive" {
  let descriptor = runtime_rc_test_layout_descriptor(16, 1)
  runtime_rc_test_layout_descriptor_entry(descriptor, 0, 0, 2, 8, continuation_cleanup_kind_rc())
  let first: i64 = rc_default_alloc(8, 8)
  let second: i64 = rc_default_alloc(8, 8)
  let aggregate = rc_default_alloc_described(16, 8, descriptor)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset(), first)
  runtime_rc_test_store64(aggregate + rc_layout_descriptor_data_offset() + 8, second)
  Test.assert_eq(rc_default_promote(aggregate), 1)
  Test.assert_eq(rc_is_promoted(first), 1)
  Test.assert_eq(rc_is_promoted(second), 1)
  Test.assert_eq(rc_default_release(aggregate), 0)
  Test.assert_eq(rc_default_payload_has_magic(first), 0)
  Test.assert_eq(rc_default_payload_has_magic(second), 0)
}

test "runtime_rc_empty_layout_descriptor_is_total" {
  let descriptor = runtime_rc_test_layout_descriptor(0, 0)
  let aggregate = rc_default_alloc_described(0, 8, descriptor)
  Test.assert_eq(if aggregate != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_layout_descriptor_payload_is_valid(aggregate), 1)
  Test.assert_eq(rc_default_release(aggregate), 0)
}

test "runtime_rc_layout_descriptor_rejects_invalid_shapes" {
  let wrong_magic = runtime_rc_test_layout_descriptor(8, 0)
  runtime_rc_test_store64(wrong_magic, 0)
  Test.assert_eq(rc_default_alloc_described(8, 8, wrong_magic), 0)

  let wrong_size = runtime_rc_test_layout_descriptor(16, 0)
  Test.assert_eq(rc_default_alloc_described(8, 8, wrong_size), 0)

  let outside = runtime_rc_test_layout_descriptor(8, 1)
  runtime_rc_test_layout_descriptor_entry(outside, 0, 1, 1, 8, continuation_cleanup_kind_rc())
  Test.assert_eq(rc_default_alloc_described(8, 8, outside), 0)

  let overflow = runtime_rc_test_layout_descriptor(16, 1)
  runtime_rc_test_layout_descriptor_entry(overflow, 0, 0, 9223372036854775807, 8, continuation_cleanup_kind_rc())
  Test.assert_eq(rc_default_alloc_described(16, 8, overflow), 0)

  let bad_kind = runtime_rc_test_layout_descriptor(8, 1)
  runtime_rc_test_layout_descriptor_entry(bad_kind, 0, 0, 1, 8, 99)
  Test.assert_eq(rc_default_alloc_described(8, 8, bad_kind), 0)
  Test.assert_eq(rc_default_alloc_described(0 - 1, 8, bad_kind), 0)
  Test.assert_eq(rc_default_alloc_described(8, 0, bad_kind), 0)
  Test.assert_eq(rc_default_alloc_masked(rc_layout_descriptor_flag(), 8, 0), 0)
}

test "runtime_rc_stale_release_does_not_corrupt_free_list" {
  let first: i64 = rc_default_alloc(8, 8)
  let second: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_release(first), 0)
  Test.assert_eq(rc_default_release(second), 0)
  Test.assert_eq(rc_default_release(second), 0 - 1)
  let reused_second: i64 = rc_default_alloc(8, 8)
  let reused_first: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(reused_second, second)
  Test.assert_eq(reused_first, first)
  Test.assert_eq(rc_default_release(reused_second), 0)
  Test.assert_eq(rc_default_release(reused_first), 0)
}

test "runtime_rc_weak_load_retains_live_target" {
  let payload: i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(payload, 123)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_weak_count(payload), 1)
  let loaded: i64 = rc_default_weak_load(payload)
  Test.assert_eq(loaded, payload)
  Test.assert_eq(runtime_rc_test_load64(loaded), 123)
  Test.assert_eq(rc_count(payload), 2)
  Test.assert_eq(rc_default_release(loaded), 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
  Test.assert_eq(rc_default_release(payload), 0)
}

test "runtime_rc_weak_load_returns_nil_after_target_release" {
  let payload: i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(payload, 77)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  Test.assert_eq(rc_count(payload), 0)
  Test.assert_eq(runtime_rc_test_load64(payload), 0)
  Test.assert_eq(rc_default_weak_load(payload), 0)
  Test.assert_eq(rc_default_weak_release(payload), 0)
}

test "runtime_rc_weak_keeps_dead_block_out_of_free_list" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  let other: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(if other != payload { 1 } else { 0 }, 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
  let reused: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(reused, payload)
  Test.assert_eq(rc_default_release(other), 0)
  Test.assert_eq(rc_default_release(reused), 0)
}

test "runtime_rc_weak_dead_references_can_be_copied_until_released" {
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(payload), 1)
  Test.assert_eq(rc_default_release(payload), 0)
  Test.assert_eq(rc_default_weak_retain(payload), 2)
  Test.assert_eq(rc_default_weak_load(payload), 0)
  Test.assert_eq(rc_default_weak_release(payload), 1)
  Test.assert_eq(rc_default_weak_release(payload), 0)
}

test "runtime_rc_weak_invalid_paths" {
  Test.assert_eq(rc_default_weak_retain(0), 0 - 1)
  Test.assert_eq(rc_default_weak_load(0), 0)
  Test.assert_eq(rc_default_weak_release(0), 0 - 1)
  let payload: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_release(payload), 0 - 1)
  Test.assert_eq(rc_default_release(payload), 0)
}

test "runtime_rc_continuation_drop_releases_segment_rc_slot" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
}

test "runtime_rc_continuation_drop_releases_segment_closure_slot" {
  let f: i64 = rc_default_alloc(16, 8)
  Test.assert_eq(closure_default_retain(f), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, f)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_closure(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(f), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
  Test.assert_eq(rc_default_release(f), 0)
}

test "runtime_rc_continuation_drop_releases_segment_weak_slot" {
  let p: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_weak_retain(p), 1)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_weak(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_weak_count(p), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
  Test.assert_eq(rc_default_release(p), 0)
}

test "runtime_rc_closure_env_releases_continuation_slot" {
  let k = continuation_new_noop()
  let env: i64 = rc_default_alloc(24, 8)
  runtime_rc_test_store64(env, 1)
  runtime_rc_test_store64(env + 8, k)
  runtime_rc_test_store64(env + 16, continuation_cleanup_kind_continuation())
  Test.assert_eq(closure_default_release_env(env), 0)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
}

test "runtime_rc_closure_release_drops_continuation_env" {
  let k = continuation_new_noop()
  let env: i64 = rc_default_alloc(24, 8)
  runtime_rc_test_store64(env, 1)
  runtime_rc_test_store64(env + 8, k)
  runtime_rc_test_store64(env + 16, continuation_cleanup_kind_continuation())
  let f: i64 = rc_default_alloc(16, 8)
  runtime_rc_test_store64(f, 0)
  runtime_rc_test_store64(f + 8, env)
  Test.assert_eq(closure_default_release(f), 0)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
}

test "runtime_rc_closure_promotion_marks_env_and_managed_captures" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let env: i64 = rc_default_alloc(24, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  runtime_rc_test_store64(env, 1)
  runtime_rc_test_store64(env + 8, p)
  runtime_rc_test_store64(env + 16, continuation_cleanup_kind_rc())
  let f: i64 = rc_default_alloc(16, 8)
  runtime_rc_test_store64(f, 0)
  runtime_rc_test_store64(f + 8, env)
  Test.assert_eq(rc_is_promoted(f), 0)
  Test.assert_eq(rc_is_promoted(env), 0)
  Test.assert_eq(rc_is_promoted(p), 0)
  Test.assert_eq(closure_default_promote(f), 3)
  Test.assert_eq(rc_is_promoted(f), 1)
  Test.assert_eq(rc_is_promoted(env), 1)
  Test.assert_eq(rc_is_promoted(p), 1)
  Test.assert_eq(closure_default_release(f), 0)
}

test "runtime_rc_promote_maybe_marks_only_real_default_payloads" {
  Test.assert_eq(rc_default_promote_maybe(41), 0)
  let p: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_is_promoted(p), 0)
  Test.assert_eq(rc_default_promote_maybe(p), 1)
  Test.assert_eq(rc_is_promoted(p), 1)
  Test.assert_eq(rc_default_release(p), 0)
}

test "runtime_rc_continuation_drop_releases_multiple_segment_slots" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let f: i64 = rc_default_alloc(16, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  Test.assert_eq(closure_default_retain(f), 2)
  let segment = runtime_rc_test_alloc_bump(16)
  runtime_rc_test_store64(segment, p)
  runtime_rc_test_store64(segment + 8, f)
  let desc = continuation_cleanup_desc_new(2)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  continuation_cleanup_desc_set(desc, 1, continuation_cleanup_kind_closure(), 8, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_cleanup_release_segment(k), 2)
  Test.assert_eq(continuation_cleanup_release_segment(k), 0)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(rc_count(f), 1)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
  Test.assert_eq(runtime_rc_test_load64(segment + 8), 0)
  Test.assert_eq(rc_default_release(f), 0)
}

test "runtime_rc_continuation_drop_skips_without_segment" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  Test.assert_eq(continuation_drop_managed(k), 1)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_default_release(p), 1)
}

test "runtime_rc_continuation_drop_skips_resumed_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_resumed(k), 1)
  Test.assert_eq(continuation_drop_managed(k), 0)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_default_release(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 1)
}

test "runtime_rc_continuation_resume_releases_segment_once" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_resume_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_resumed())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
  Test.assert_eq(continuation_resume_managed(k), 0)
  Test.assert_eq(continuation_drop_managed(k), 0)
}

test "runtime_rc_continuation_auto_drop_skips_stored_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_stored(k), 1)
  Test.assert_eq(continuation_drop_managed(k), 0)
  Test.assert_eq(continuation_status(k), continuation_status_stored())
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 1)
  Test.assert_eq(continuation_drop_owned_managed(k), 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
}

test "runtime_rc_continuation_resume_managed_accepts_stored_token" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_default_retain(p), 2)
  let segment = runtime_rc_test_alloc_bump(8)
  runtime_rc_test_store64(segment, p)
  let desc = continuation_cleanup_desc_new(1)
  continuation_cleanup_desc_set(desc, 0, continuation_cleanup_kind_rc(), 0, 1)
  let k = continuation_new_with_cleanup_desc(desc)
  continuation_set_segment(k, segment, 0, 0)
  Test.assert_eq(continuation_mark_stored(k), 1)
  Test.assert_eq(continuation_resume_managed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_resumed())
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(continuation_cleanup_desc_live(desc, 0), 0)
  Test.assert_eq(runtime_rc_test_load64(segment), 0)
}

fn runtime_rc_auto_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 77)
  let addr = runtime_rc_test_addr(p)
  addr
}

fn runtime_rc_param_count(p: rc i64) -> i64 {
  rc_count(p)
}

fn runtime_rc_choose(flag: i64, p: rc i64, q: rc i64) -> rc i64 {
  if flag == 1 { p } else { q }
}

fn runtime_rc_identity<T>(x: T) -> T {
  x
}

fn runtime_rc_apply_closure(f: (rc i64) -> i64, p: rc i64) -> i64 {
  f(p)
}

fn runtime_rc_closure_capture_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let addr = runtime_rc_test_addr(p)
  let f = () => rc_count(p)
  addr
}

fn runtime_rc_closure_capture_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 41)
  () => runtime_rc_test_load64(p)
}

fn runtime_rc_closure_copy_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 42)
  let f = () => runtime_rc_test_load64(p)
  let g = f
  g
}

fn runtime_rc_closure_assignment_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 43)
  let f = () => 0
  let g = () => runtime_rc_test_load64(p)
  let mut h = f
  h = g
  h
}

fn runtime_rc_nested_closure_returned() -> () -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 44)
  let read = () => runtime_rc_test_load64(p)
  let outer = () => read()
  outer
}

type RuntimeRcMethodBox {
  value: i64
}

impl RuntimeRcMethodBox {
  fn touch(self: RuntimeRcMethodBox, p: rc i64) -> i64 {
    rc_count(p)
  }
}

fn runtime_rc_break_addr() -> i64 {
  let mut addr = 0
  while addr == 0 {
    let p: rc i64 = rc_default_alloc(8, 8)
    addr = runtime_rc_test_addr(p)
    break
  }
  addr
}

fn runtime_rc_continue_addr() -> i64 {
  let mut addr = 0
  let mut done = 0
  while done == 0 {
    done = 1
    let p: rc i64 = rc_default_alloc(8, 8)
    addr = runtime_rc_test_addr(p)
    continue
  }
  addr
}

test "runtime_rc_auto_release_scope_reuses_zeroed_block" {
  let old = runtime_rc_auto_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, old)
  Test.assert_eq(runtime_rc_test_load64(again), 0)
}

test "runtime_rc_auto_copy_retain_balances_scope_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(rc_count(p), 1)
  let q: rc i64 = p
  Test.assert_eq(q, p)
  Test.assert_eq(rc_count(p), 2)
}

test "runtime_rc_auto_assignment_releases_old_and_retains_new" {
  let first: rc i64 = rc_default_alloc(8, 8)
  let second: rc i64 = rc_default_alloc(8, 8)
  let mut cur: rc i64 = first
  Test.assert_eq(rc_count(first), 2)
  Test.assert_eq(rc_count(second), 1)
  cur = second
  Test.assert_eq(rc_count(first), 1)
  Test.assert_eq(rc_count(second), 2)
}

test "runtime_rc_auto_param_retain_and_callee_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(runtime_rc_param_count(p), 1)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = if 1 == 1 { p } else { q }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_block_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = { 0 if 1 == 1 { p } else { q } }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_match_borrow_retain_for_binding" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = match 1 {
    1 -> p,
    _ -> q
  }
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_assignment" {
  let first: rc i64 = rc_default_alloc(8, 8)
  let second: rc i64 = rc_default_alloc(8, 8)
  let third: rc i64 = rc_default_alloc(8, 8)
  let mut cur: rc i64 = first
  cur = if 1 == 1 { second } else { third }
  Test.assert_eq(rc_count(first), 1)
  Test.assert_eq(rc_count(second), 2)
  Test.assert_eq(rc_count(third), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_call_arg" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(runtime_rc_param_count(if 1 == 1 { p } else { q }), 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_if_borrow_retain_for_return" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = rc_default_alloc(8, 8)
  let r: rc i64 = runtime_rc_choose(1, p, q)
  Test.assert_eq(r, p)
  Test.assert_eq(rc_count(p), 2)
  Test.assert_eq(rc_count(q), 1)
}

test "runtime_rc_auto_method_arg_retain_and_release" {
  let box = RuntimeRcMethodBox { value: 1 }
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(box.touch(p), 1)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_auto_closure_arg_retain_and_release" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let f = (x: rc i64) => rc_count(x)
  Test.assert_eq(runtime_rc_apply_closure(f, p), 2)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_closure_capture_release_reuses_block" {
  let old = runtime_rc_closure_capture_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, old)
}

test "runtime_rc_returned_closure_keeps_captured_rc_alive" {
  let f = runtime_rc_closure_capture_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(q, 99)
  Test.assert_eq(f(), 41)
}

test "runtime_rc_closure_copy_keeps_env_alive" {
  let f = runtime_rc_closure_copy_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(q, 99)
  Test.assert_eq(f(), 42)
}

test "runtime_rc_closure_assignment_keeps_env_alive" {
  let f = runtime_rc_closure_assignment_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(q, 99)
  Test.assert_eq(f(), 43)
}

test "runtime_rc_nested_closure_keeps_captured_closure_alive" {
  let f = runtime_rc_nested_closure_returned()
  let q: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(q, 99)
  Test.assert_eq(f(), 44)
}

test "runtime_rc_auto_generic_arg_retain_and_return" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = runtime_rc_identity<rc i64>(p)
  Test.assert_eq(q, p)
  Test.assert_eq(rc_count(p), 2)
}

test "runtime_rc_auto_control_transfer_releases_loop_locals" {
  let break_old = runtime_rc_break_addr()
  let break_again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(break_again, break_old)
  let continue_old = runtime_rc_continue_addr()
  let continue_again: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(continue_again, continue_old)
}

test "runtime_rc_alloc_initializes_payload" {
  let heap = heap_new(64)
  let payload = rc_alloc(heap, 8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_header_from_payload(payload) + rc_header_size(), payload)
  Test.assert_eq(rc_payload_from_header(rc_header_from_payload(payload)), payload)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 8)
  Test.assert_eq(rc_weak_count(payload), 0)
  Test.assert_eq(rc_block_size(payload), 56)
  Test.assert_eq(runtime_rc_test_load64(payload), 0)
  runtime_rc_test_store64(payload, 42)
  Test.assert_eq(runtime_rc_test_load64(payload), 42)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_retain_release_lifecycle" {
  let heap = heap_new(80)
  let payload = rc_alloc(heap, 8, 8)
  let header = rc_header_from_payload(payload)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  -- 56-byte blocks recycle through the exact-size bin (2q slice 2).
  Test.assert_eq(heap_bin_head(heap, 56), header)
  Test.assert_eq(heap_free_node_size(header), 56)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_weak_release_frees_dead_block_on_last_weak" {
  let heap = heap_new(128)
  let payload = rc_alloc(heap, 8, 8)
  let header = rc_header_from_payload(payload)
  Test.assert_eq(rc_weak_retain(payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_bin_head(heap, 56), 0)
  Test.assert_eq(rc_weak_release(heap, payload), 0)
  Test.assert_eq(heap_bin_head(heap, 56), header)
  Test.assert_eq(heap_free_node_size(header), 56)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_multiple_retains" {
  let heap = heap_new(96)
  let payload = rc_alloc(heap, 16, 8)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_retain(payload), 3)
  Test.assert_eq(rc_release(heap, payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_zero_size_payload" {
  let heap = heap_new(48)
  let payload = rc_alloc(heap, 0, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 0)
  Test.assert_eq(rc_block_size(payload), 48)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_invalid_and_overflow_paths" {
  let heap = heap_new(32)
  Test.assert_eq(rc_alloc(0, 8, 8), 0)
  Test.assert_eq(rc_alloc(heap, 0 - 1, 8), 0)
  -- Capacity is elastic (2q): oversize requests chain a larger arena
  -- and succeed with a live, releasable payload.
  let grown = rc_alloc(heap, 40, 8)
  Test.assert_eq(if grown != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_release(heap, grown), 0)
  Test.assert_eq(rc_retain(0), 0 - 1)
  Test.assert_eq(rc_release(heap, 0), 0 - 1)
  Test.assert_eq(rc_release(0, 1234), 0 - 1)
  Test.assert_eq(heap_destroy(heap), 0)
}
