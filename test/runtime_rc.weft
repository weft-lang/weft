use "runtime/rc.weft"

test "runtime_rc_layout_constants" {
  Test.assert_eq(rc_header_size(), 16)
  Test.assert_eq(rc_count_offset(), 0)
  Test.assert_eq(rc_payload_size_offset(), 8)
  Test.assert_eq(rc_default_heap_offset(), 8)
  Test.assert_eq(if rc_default_heap_capacity() >= 4096 { 1 } else { 0 }, 1)
}

test "runtime_rc_default_heap_lazily_initializes" {
  let cell = rc_default_heap_cell()
  Test.assert_eq(__mem_load64(cell), 0)
  let heap = rc_default_heap()
  Test.assert_eq(if heap != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(__mem_load64(cell), heap)
  Test.assert_eq(rc_default_heap(), heap)
}

test "runtime_rc_default_lifecycle_reuses_zeroed_block" {
  let payload = rc_default_alloc(8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_default_retain(payload), 2)
  Test.assert_eq(rc_default_release(payload), 1)
  __mem_store64(payload, 91)
  Test.assert_eq(rc_default_release(payload), 0)
  let again = rc_default_alloc(8, 8)
  Test.assert_eq(again, payload)
  Test.assert_eq(__mem_load64(again), 0)
  Test.assert_eq(rc_default_release(again), 0)
}

test "runtime_rc_default_invalid_paths" {
  Test.assert_eq(rc_default_alloc(0 - 1, 8), 0)
  Test.assert_eq(rc_default_retain(0), 0 - 1)
  Test.assert_eq(rc_default_release(0), 0 - 1)
}

test "runtime_rc_alloc_initializes_payload" {
  let heap = heap_new(64)
  let payload = rc_alloc(heap, 8, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_header_from_payload(payload) + rc_header_size(), payload)
  Test.assert_eq(rc_payload_from_header(rc_header_from_payload(payload)), payload)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 8)
  Test.assert_eq(rc_block_size(payload), 24)
  Test.assert_eq(__mem_load64(payload), 0)
  __mem_store64(payload, 42)
  Test.assert_eq(__mem_load64(payload), 42)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_retain_release_lifecycle" {
  let heap = heap_new(80)
  let payload = rc_alloc(heap, 8, 8)
  let header = rc_header_from_payload(payload)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_free_head(heap), header)
  Test.assert_eq(heap_free_node_size(header), 24)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_multiple_retains" {
  let heap = heap_new(96)
  let payload = rc_alloc(heap, 16, 8)
  Test.assert_eq(rc_retain(payload), 2)
  Test.assert_eq(rc_retain(payload), 3)
  Test.assert_eq(rc_release(heap, payload), 2)
  Test.assert_eq(rc_release(heap, payload), 1)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_zero_size_payload" {
  let heap = heap_new(32)
  let payload = rc_alloc(heap, 0, 8)
  Test.assert_eq(if payload != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(payload), 1)
  Test.assert_eq(rc_payload_size(payload), 0)
  Test.assert_eq(rc_block_size(payload), 16)
  Test.assert_eq(rc_release(heap, payload), 0)
  Test.assert_eq(heap_destroy(heap), 0)
}

test "runtime_rc_invalid_and_overflow_paths" {
  let heap = heap_new(32)
  Test.assert_eq(rc_alloc(0, 8, 8), 0)
  Test.assert_eq(rc_alloc(heap, 0 - 1, 8), 0)
  Test.assert_eq(rc_alloc(heap, 40, 8), 0)
  Test.assert_eq(rc_retain(0), 0 - 1)
  Test.assert_eq(rc_release(heap, 0), 0 - 1)
  Test.assert_eq(rc_release(0, 1234), 0 - 1)
  Test.assert_eq(heap_destroy(heap), 0)
}
