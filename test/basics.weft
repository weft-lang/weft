-- basics.weft -- converted from test_self_host.sh sections 1-9

-- ═══════════════════════════════════════════════════════════════
-- 1. INTEGER LITERALS
-- ═══════════════════════════════════════════════════════════════
test "int_zero" { Test.assert_eq(0, 0) }
test "int_one" { Test.assert_eq(1, 1) }
test "int_42" { Test.assert_eq(42, 42) }
test "int_255" { Test.assert_eq(255, 255) }
test "int_256" { Test.assert_eq(256, 0) }
test "int_257" { Test.assert_eq(257, 1) }
test "int_65535" { Test.assert_eq(65535, 255) }
test "int_65536" { Test.assert_eq(65536, 0) }
test "int_128" { Test.assert_eq(128, 128) }
test "int_200" { Test.assert_eq(200, 200) }

-- ═══════════════════════════════════════════════════════════════
-- 2. ARITHMETIC -- all ops, precedence, associativity
-- ═══════════════════════════════════════════════════════════════
test "add" { Test.assert_eq(1 + 2, 3) }
test "add_zero" { Test.assert_eq(5 + 0, 5) }
test "add_zero_lhs" { Test.assert_eq(0 + 5, 5) }
test "add_chain" { Test.assert_eq(1 + 2 + 3 + 4, 10) }
test "sub" { Test.assert_eq(5 - 2, 3) }
test "sub_zero" { Test.assert_eq(5 - 0, 5) }
test "sub_self" { Test.assert_eq(42 - 42, 0) }
test "sub_negative" { Test.assert_eq(3 - 7, 252) }
test "sub_chain" { Test.assert_eq(10 - 3 - 5, 2) }
test "mul" { Test.assert_eq(6 * 7, 42) }
test "mul_zero" { Test.assert_eq(42 * 0, 0) }
test "mul_one" { Test.assert_eq(42 * 1, 42) }
test "mul_chain" { Test.assert_eq(2 * 3 * 4, 24) }
test "mul_large" { Test.assert_eq(100 * 100, 16) }
test "div_trunc" { Test.assert_eq(7 / 2, 3) }
test "div_exact" { Test.assert_eq(10 / 2, 5) }
test "div_one" { Test.assert_eq(42 / 1, 42) }
test "div_self" { Test.assert_eq(42 / 42, 1) }
test "div_large" { Test.assert_eq(200 / 2, 100) }
test "div_trunc2" { Test.assert_eq(11 / 4, 2) }
test "prec_add_mul" { Test.assert_eq(2 + 3 * 4, 14) }
test "prec_mul_add" { Test.assert_eq(3 * 4 + 2, 14) }
test "prec_sub_mul" { Test.assert_eq(14 - 3 * 4, 2) }
test "prec_div_add" { Test.assert_eq(6 / 2 + 2, 5) }
test "prec_complex" { Test.assert_eq(1 + 2 * 3 + 4 / 2, 9) }
test "assoc_sub" { Test.assert_eq(10 - 5 - 3, 2) }
test "assoc_div" { Test.assert_eq(100 / 2 / 10, 5) }
test "parens_add_mul" { Test.assert_eq((2 + 3) * 4, 20) }
test "parens_sub_div" { Test.assert_eq((10 - 4) / 3, 2) }

-- ═══════════════════════════════════════════════════════════════
-- 3. COMPARISONS -- all 6 ops, true/false, boundary
-- ═══════════════════════════════════════════════════════════════
test "eq_true" { Test.assert_eq(if 5 == 5 { 1 } else { 0 }, 1) }
test "eq_false" { Test.assert_eq(if 5 == 6 { 1 } else { 0 }, 0) }
test "eq_zero" { Test.assert_eq(if 0 == 0 { 1 } else { 0 }, 1) }
test "ne_true" { Test.assert_eq(if 5 != 6 { 1 } else { 0 }, 1) }
test "ne_false" { Test.assert_eq(if 5 != 5 { 1 } else { 0 }, 0) }
test "ne_zero" { Test.assert_eq(if 0 != 0 { 1 } else { 0 }, 0) }
test "lt_true" { Test.assert_eq(if 3 < 5 { 1 } else { 0 }, 1) }
test "lt_false" { Test.assert_eq(if 5 < 3 { 1 } else { 0 }, 0) }
test "lt_eq" { Test.assert_eq(if 5 < 5 { 1 } else { 0 }, 0) }
test "lt_01" { Test.assert_eq(if 0 < 1 { 1 } else { 0 }, 1) }
test "lt_10" { Test.assert_eq(if 1 < 0 { 1 } else { 0 }, 0) }
test "gt_true" { Test.assert_eq(if 5 > 3 { 1 } else { 0 }, 1) }
test "gt_false" { Test.assert_eq(if 3 > 5 { 1 } else { 0 }, 0) }
test "gt_eq" { Test.assert_eq(if 5 > 5 { 1 } else { 0 }, 0) }
test "gt_10" { Test.assert_eq(if 1 > 0 { 1 } else { 0 }, 1) }
test "gt_01" { Test.assert_eq(if 0 > 1 { 1 } else { 0 }, 0) }
test "le_lt" { Test.assert_eq(if 3 <= 5 { 1 } else { 0 }, 1) }
test "le_eq" { Test.assert_eq(if 5 <= 5 { 1 } else { 0 }, 1) }
test "le_false" { Test.assert_eq(if 6 <= 5 { 1 } else { 0 }, 0) }
test "ge_gt" { Test.assert_eq(if 5 >= 3 { 1 } else { 0 }, 1) }
test "ge_eq" { Test.assert_eq(if 5 >= 5 { 1 } else { 0 }, 1) }
test "ge_false" { Test.assert_eq(if 3 >= 5 { 1 } else { 0 }, 0) }
test "cmp_as_val" {
  let a = if 3 < 5 { 1 } else { 0 }
  let b = if 5 > 3 { 1 } else { 0 }
  Test.assert_eq(a + b, 2)
}

-- ═══════════════════════════════════════════════════════════════
-- 4. IF/ELSE -- branches, nesting, as expression
-- ═══════════════════════════════════════════════════════════════
test "if_true" { Test.assert_eq(if 1 == 1 { 1 } else { 2 }, 1) }
test "if_false" { Test.assert_eq(if 1 == 2 { 1 } else { 2 }, 2) }
test "if_nested_tt" { Test.assert_eq(if 1 == 1 { if 2 == 2 { 1 } else { 2 } } else { 3 }, 1) }
test "if_nested_tf" { Test.assert_eq(if 1 == 1 { if 2 == 3 { 1 } else { 2 } } else { 3 }, 2) }
test "if_nested_ft" { Test.assert_eq(if 1 == 2 { if 2 == 2 { 1 } else { 2 } } else { 3 }, 3) }
test "if_deep4" { Test.assert_eq(if 1 == 1 { if 2 == 2 { if 3 == 3 { if 4 == 4 { 4 } else { 0 } } else { 0 } } else { 0 } } else { 0 }, 4) }
test "if_deep4_fail" { Test.assert_eq(if 1 == 2 { if 2 == 2 { if 3 == 3 { if 4 == 4 { 4 } else { 0 } } else { 0 } } else { 0 } } else { 99 }, 99) }
test "if_expr_let" {
  let x = if 3 > 2 { 5 } else { 1 }
  Test.assert_eq(x * 2, 10)
}
test "if_expr_arith" { Test.assert_eq((if 1 == 1 { 5 } else { 0 }) * 10, 50) }
test "if_complex_cond" {
  let a = 10
  let b = 20
  Test.assert_eq(if a + b == 30 { 42 } else { 0 }, 42)
}
test "if_chain" { Test.assert_eq(if 0 == 1 { 1 } else { if 0 == 2 { 2 } else { 3 } }, 3) }

-- ═══════════════════════════════════════════════════════════════
-- 5. LET BINDINGS
-- ═══════════════════════════════════════════════════════════════
test "let_simple" {
  let x = 42
  Test.assert_eq(x, 42)
}
test "let_arith" {
  let x = 3
  let y = 7
  Test.assert_eq(x + y, 10)
}
test "let_shadow" {
  let x = 1
  let x = 2
  Test.assert_eq(x, 2)
}
test "let_multi" {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  Test.assert_eq(a + b + c + d + e, 15)
}

fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }

test "let_fn_result" {
  let r = fact(5)
  Test.assert_eq(r, 120)
}
test "let_chain" {
  let a = 2
  let b = a * 3
  let c = b * 7
  Test.assert_eq(c, 42)
}

-- ═══════════════════════════════════════════════════════════════
-- 6. LET MUT + ASSIGNMENT
-- ═══════════════════════════════════════════════════════════════
test "mut_basic" {
  let mut x = 5
  x = 10
  Test.assert_eq(x, 10)
}
test "mut_multi" {
  let mut x = 0
  x = 1
  x = 2
  x = 3
  Test.assert_eq(x, 3)
}
test "mut_arith" {
  let mut x = 20
  x = x + 22
  Test.assert_eq(x, 42)
}
test "mut_while" {
  let mut x = 0
  while x < 100 { x = x + 1 }
  Test.assert_eq(x, 100)
}
test "mut_complex" {
  let mut x = 0
  let a = 10
  let b = 20
  x = a + b
  Test.assert_eq(x, 30)
}
test "mut_swap" {
  let mut x = 10
  let mut y = 20
  let tmp = x
  x = y
  y = tmp
  Test.assert_eq(x + y, 30)
}

-- ═══════════════════════════════════════════════════════════════
-- 7. WHILE LOOPS -- basic, edge, nested, patterns
-- ═══════════════════════════════════════════════════════════════
test "while" {
  let mut x = 0
  while x < 42 { x = x + 1 }
  Test.assert_eq(x, 42)
}
test "while_never" {
  let mut x = 0
  while x > 0 { x = x - 1 }
  Test.assert_eq(x, 0)
}
test "while_one" {
  let mut x = 0
  while x < 1 { x = x + 1 }
  Test.assert_eq(x, 1)
}
test "while_sum" {
  let mut x = 0
  let mut i = 0
  while i < 10 { x = x + i i = i + 1 }
  Test.assert_eq(x, 45)
}
test "while_nested" {
  let mut sum = 0
  let mut i = 0
  while i < 3 {
    let mut j = 0
    while j < 4 { sum = sum + 1 j = j + 1 }
    i = i + 1
  }
  Test.assert_eq(sum, 12)
}
test "while_pow2" {
  let mut x = 1
  let mut i = 0
  while i < 7 { x = x * 2 i = i + 1 }
  Test.assert_eq(x, 128)
}
test "while_countdown" {
  let mut n = 100
  while n > 0 { n = n - 1 }
  Test.assert_eq(n, 0)
}
test "while_factorial" {
  let mut p = 1
  let mut i = 1
  while i <= 5 { p = p * i i = i + 1 }
  Test.assert_eq(p, 120)
}
test "while_nested3" {
  let mut s = 0
  let mut i = 0
  while i < 3 {
    let mut j = 0
    while j < 3 {
      let mut k = 0
      while k < 3 { s = s + 1 k = k + 1 }
      j = j + 1
    }
    i = i + 1
  }
  Test.assert_eq(s, 27)
}
test "while_div" {
  let mut x = 24
  while x > 5 { x = x / 2 }
  Test.assert_eq(x, 3)
}
test "while_250" {
  let mut x = 0
  while x < 250 { x = x + 1 }
  Test.assert_eq(x, 250)
}

-- ═══════════════════════════════════════════════════════════════
-- 8. FUNCTIONS -- arity 0-7, recursive, composition
-- ═══════════════════════════════════════════════════════════════
fn f_zero() -> i64 { 42 }
test "fn_zero" { Test.assert_eq(f_zero(), 42) }

fn f_one(x: i64) -> i64 { x }
test "fn_one" { Test.assert_eq(f_one(10), 10) }

fn f_two(a: i64, b: i64) -> i64 { a + b }
test "fn_two" { Test.assert_eq(f_two(10, 20), 30) }

fn f_three(a: i64, b: i64, c: i64) -> i64 { a + b + c }
test "fn_three" { Test.assert_eq(f_three(10, 20, 30), 60) }

fn f_four(a: i64, b: i64, c: i64, d: i64) -> i64 { a + b + c + d }
test "fn_four" { Test.assert_eq(f_four(10, 20, 30, 40), 100) }

fn f_five(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 { a + b + c + d + e }
test "fn_five" { Test.assert_eq(f_five(10, 20, 30, 40, 50), 150) }

fn f_six(a: i64, b: i64, c: i64, d: i64, e: i64, g: i64) -> i64 { a + b + c + d + e + g }
test "fn_six" { Test.assert_eq(f_six(10, 20, 30, 40, 50, 60), 210) }

fn f_seven(a: i64, b: i64, c: i64, d: i64, e: i64, g: i64, h: i64) -> i64 { a + b + c + d + e + g + h }
test "fn_seven" { Test.assert_eq(f_seven(1, 2, 3, 4, 5, 6, 7), 28) }

fn factorial(n: i64) -> i64 { if n <= 1 { 1 } else { n * factorial(n - 1) } }
test "factorial" { Test.assert_eq(factorial(5), 120) }

fn fib(n: i64) -> i64 { if n <= 1 { n } else { fib(n - 1) + fib(n - 2) } }
test "fib" { Test.assert_eq(fib(10), 55) }

fn sum(n: i64) -> i64 { if n <= 0 { 0 } else { n + sum(n - 1) } }
test "fn_recursive_sum" { Test.assert_eq(sum(10), 55) }

fn double(x: i64) -> i64 { x * 2 }
fn add1(x: i64) -> i64 { x + 1 }
test "fn_nested_call" { Test.assert_eq(double(add1(20)), 42) }

fn inc(x: i64) -> i64 { x + 1 }
test "fn_multi_calls" { Test.assert_eq(inc(1) + inc(2) + inc(3) + inc(4), 14) }

fn sub(a: i64, b: i64) -> i64 { a - b }
test "fn_arg_order" { Test.assert_eq(sub(5, 2), 3) }

fn chain_c(x: i64) -> i64 { x + 2 }
fn chain_b(x: i64) -> i64 { chain_c(x * 2) }
fn chain_a(x: i64) -> i64 { chain_b(x + 3) }
test "fn_chain" { Test.assert_eq(chain_a(17), 42) }

fn id(x: i64) -> i64 { x }
test "fn_compose" { Test.assert_eq(id(id(id(id(id(42))))), 42) }

fn deep_f(n: i64) -> i64 { if n <= 0 { 0 } else { 1 + deep_f(n - 1) } }
test "fn_deep_recursion" { Test.assert_eq(deep_f(200), 200) }

-- ═══════════════════════════════════════════════════════════════
-- 9. STRINGS
-- ═══════════════════════════════════════════════════════════════
test "str_hello" { Test.assert_eq(__str_len("hello"), 5) }
test "str_empty" { Test.assert_eq(__str_len(""), 0) }
test "str_one" { Test.assert_eq(__str_len("x"), 1) }
test "str_long" { Test.assert_eq(__str_len("abcdefghijklmnopqrstuvwxyz"), 26) }

fn slen(s: str) -> i64 { __str_len(s) }
test "str_fn_arg" { Test.assert_eq(slen("hello"), 5) }
test "str_spaces" { Test.assert_eq(__str_len("   "), 3) }
test "str_digits" { Test.assert_eq(__str_len("0123456789"), 10) }
