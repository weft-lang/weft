effect FlowAbort { fn stop() -> i64 }
effect FlowRead { fn read() -> i64 }

fn flow_early_abort(early: bool) -> i64 {
  handle {
    if early { return 1 }
    FlowAbort.stop()
  } { FlowAbort.stop() -> 42 }
}

fn flow_early_resume(early: bool) -> i64 {
  handle {
    if early { return 1 }
    FlowRead.read() + 2
  } { FlowRead.read() -> resume(40) }
}

test "an early function return leaves the sibling abort handler active" {
  Test.assert_eq(flow_early_abort(true), 1)
  Test.assert_eq(flow_early_abort(false), 42)
}

test "an early function return leaves the sibling resumptive handler active" {
  Test.assert_eq(flow_early_resume(true), 1)
  Test.assert_eq(flow_early_resume(false), 42)
}

fn flow_nested_early(early: bool) -> i64 {
  handle {
    let inner = handle {
      if early { return 1 }
      FlowRead.read()
    } { FlowRead.read() -> resume(40) }
    inner + FlowRead.read()
  } { FlowRead.read() -> resume(2) }
}

test "nested handler selection survives an early return in a sibling block" {
  Test.assert_eq(flow_nested_early(true), 1)
  Test.assert_eq(flow_nested_early(false), 42)
}

test "continue and break preserve the enclosing handler on other loop paths" {
  let result = handle {
    let mut total = 0
    for i in 0..8 {
      if i == 0 { continue }
      if i == 3 { break }
      total = total + FlowRead.read()
    }
    total
  } { FlowRead.read() -> resume(21) }
  Test.assert_eq(result, 42)
}

fn flow_clause_early(early: bool) -> i64 {
  handle FlowAbort.stop() {
    FlowAbort.stop() -> handle {
      if early { return 1 }
      FlowRead.read()
    } { FlowRead.read() -> resume(42) }
  }
}

test "clause control flow has its own handler entries" {
  Test.assert_eq(flow_clause_early(true), 1)
  Test.assert_eq(flow_clause_early(false), 42)
}
