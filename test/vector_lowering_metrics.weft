-- test/vector_lowering_metrics.weft -- runtime vector lowering semantic coverage

use "stdlib/vector.weft"

fn vector_f64_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn vector_metric_table_x(vec: i64, row: i64) -> f64 {
  vector_get<f64>(vec, row * 7, 0.0)
}

fn vector_metric_table_y(vec: i64, row: i64) -> f64 {
  vector_get<f64>(vec, row * 7 + 1, 0.0)
}

fn vector_metric_table_set_y(vec: i64, row: i64, value: f64) -> i64 {
  vector_set<f64>(vec, row * 7 + 1, value)
}

test "vector_lowering_runtime_len_get_set_happy_paths" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 30)
  Test.assert_eq(vector_set<i64>(vec, 1, 41), 1)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 41)
}

test "vector_lowering_runtime_f64_get_set_happy_paths" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0, 0.0), 1.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 2, 0.0), 3.75), 1)
  Test.assert_eq(vector_set<f64>(vec, 1, 4.5), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 1, 0.0), 4.5), 1)
}

test "vector_lowering_runtime_f64_multiple_gets_in_expression" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  let total = vector_get<f64>(vec, 0, 0.0) + vector_get<f64>(vec, 1, 0.0) + vector_get<f64>(vec, 2, 0.0)
  Test.assert_eq(vector_f64_same(total, 7.5), 1)
}

test "vector_lowering_runtime_scaled_vector_len_table_get_set" {
  let vec = vector_with_capacity<f64>(14)
  vector_push<f64>(vec, 0.0)
  vector_push<f64>(vec, 1.0)
  vector_push<f64>(vec, 2.0)
  vector_push<f64>(vec, 3.0)
  vector_push<f64>(vec, 4.0)
  vector_push<f64>(vec, 5.0)
  vector_push<f64>(vec, 6.0)
  vector_push<f64>(vec, 7.0)
  vector_push<f64>(vec, 8.0)
  vector_push<f64>(vec, 9.0)
  vector_push<f64>(vec, 10.0)
  vector_push<f64>(vec, 11.0)
  vector_push<f64>(vec, 12.0)
  vector_push<f64>(vec, 13.0)
  let count = vector_len(vec) / 7
  let mut i = 0
  let mut total: f64 = 0.0
  while i < count {
    total = total + vector_get<f64>(vec, i * 7 + 3, 0.0)
    vector_set<f64>(vec, i * 7 + 4, total)
    i = i + 1
  }
  Test.assert_eq(vector_f64_same(total, 13.0), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 4, 0.0), 3.0), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 11, 0.0), 13.0), 1)
}

test "vector_lowering_runtime_fixed_field_table_helpers" {
  let vec = vector_with_capacity<f64>(14)
  vector_push<f64>(vec, 1.0)
  vector_push<f64>(vec, 2.0)
  vector_push<f64>(vec, 3.0)
  vector_push<f64>(vec, 4.0)
  vector_push<f64>(vec, 5.0)
  vector_push<f64>(vec, 6.0)
  vector_push<f64>(vec, 7.0)
  vector_push<f64>(vec, 8.0)
  vector_push<f64>(vec, 9.0)
  vector_push<f64>(vec, 10.0)
  vector_push<f64>(vec, 11.0)
  vector_push<f64>(vec, 12.0)
  vector_push<f64>(vec, 13.0)
  vector_push<f64>(vec, 14.0)
  let count = vector_len(vec) / 7
  for i in 0..count {
    vector_metric_table_set_y(vec, i, vector_metric_table_x(vec, i) + vector_metric_table_y(vec, i))
  }
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 1, 0.0), 3.0), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 8, 0.0), 17.0), 1)
}

test "vector_lowering_runtime_push_grows_and_preserves_values" {
  let vec = vector_with_capacity<i64>(1)
  vector_push<i64>(vec, 11)
  vector_push<i64>(vec, 22)
  vector_push<i64>(vec, 33)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_capacity(vec), 4)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 11)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 22)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 33)
}

test "vector_lowering_runtime_push_null_returns_zero" {
  Test.assert_eq(vector_push<i64>(0, 99), 0)
}

test "vector_lowering_runtime_bool_push_stays_generic" {
  let vec = vector_with_capacity<bool>(1)
  vector_push<bool>(vec, true)
  vector_push<bool>(vec, false)
  let first = if vector_get<bool>(vec, 0, false) { 1 } else { 0 }
  let second = if vector_get<bool>(vec, 1, true) { 1 } else { 0 }
  Test.assert_eq(vector_len(vec), 2)
  Test.assert_eq(first, 1)
  Test.assert_eq(second, 0)
}

test "vector_lowering_runtime_capacity_proven_for_range_push_no_grow" {
  let n = 4
  let vec = vector_with_capacity<i64>(n)
  for i in 0..n {
    vector_push<i64>(vec, i + 10)
  }
  Test.assert_eq(vector_len(vec), 4)
  Test.assert_eq(vector_capacity(vec), 4)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(vec, 3, 0), 13)
}

test "vector_lowering_runtime_capacity_mismatch_still_grows" {
  let vec = vector_with_capacity<i64>(2)
  for i in 0..3 {
    vector_push<i64>(vec, i + 1)
  }
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(if vector_capacity(vec) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 1)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 3)
}

test "vector_lowering_runtime_fold_literal_lambda_happy_paths" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_fold<i64, i64>(vec, 5, (acc: i64, x: i64) => acc + x), 65)
  Test.assert_eq(vector_fold<i64, i64>(vec, 1, (acc: i64, x: i64) => acc * x), 6000)
}

test "vector_lowering_runtime_fold_literal_lambda_empty_and_null" {
  let empty = vector_with_capacity<i64>(0)
  Test.assert_eq(vector_fold<i64, i64>(empty, 9, (acc: i64, x: i64) => acc + x), 9)
  Test.assert_eq(vector_fold<i64, i64>(0, 7, (acc: i64, x: i64) => acc + x), 7)
}

test "vector_lowering_runtime_fold_literal_lambda_branchy_body" {
  let vec = vector_with_capacity<i64>(5)
  vector_push<i64>(vec, 1)
  vector_push<i64>(vec, 2)
  vector_push<i64>(vec, 3)
  vector_push<i64>(vec, 4)
  vector_push<i64>(vec, 5)
  let evens = vector_fold<i64, i64>(vec, 0, (acc: i64, x: i64) => if x % 2 == 0 { acc + 1 } else { acc })
  Test.assert_eq(evens, 2)
}

test "vector_lowering_runtime_failed_accesses_preserve_defaults_and_values" {
  let vec = vector_with_capacity<i64>(2)
  vector_push<i64>(vec, 5)
  vector_push<i64>(vec, 6)
  Test.assert_eq(vector_len(0), 0)
  Test.assert_eq(vector_get<i64>(0, 0, 99), 99)
  Test.assert_eq(vector_get<i64>(vec, 0 - 1, 88), 88)
  Test.assert_eq(vector_get<i64>(vec, 2, 77), 77)
  Test.assert_eq(vector_set<i64>(0, 0, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 0 - 1, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 2, 42), 0)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 6)
}

test "vector_lowering_runtime_f64_failed_accesses_preserve_defaults_and_values" {
  let vec = vector_with_capacity<f64>(2)
  vector_push<f64>(vec, 5.5)
  vector_push<f64>(vec, 6.5)
  Test.assert_eq(vector_f64_same(vector_get<f64>(0, 0, 9.25), 9.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0 - 1, 8.25), 8.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 2, 7.25), 7.25), 1)
  Test.assert_eq(vector_set<f64>(0, 0, 42.5), 0)
  Test.assert_eq(vector_set<f64>(vec, 0 - 1, 42.5), 0)
  Test.assert_eq(vector_set<f64>(vec, 2, 42.5), 0)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0, 0.0), 5.5), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 1, 0.0), 6.5), 1)
}

fn vector_direct_get_at(vec: i64, index: i64) -> i64 {
  vector_get<i64>(vec, index, 0)
}

fn vector_direct_set_at(vec: i64, index: i64, value: i64) -> i64 {
  vector_set<i64>(vec, index, value)
}

fn vector_direct_index(width: i64, row: i64, col: i64) -> i64 {
  row * width + col
}

fn vector_direct_graph_get(graph: i64, width: i64, row: i64, col: i64) -> i64 {
  vector_get<i64>(graph, vector_direct_index(width, row, col), 0)
}

fn vector_direct_get_f64_at(vec: i64, index: i64) -> f64 {
  vector_get<f64>(vec, index, 0.0)
}

fn vector_direct_set_f64_at(vec: i64, index: i64, value: f64) -> i64 {
  vector_set<f64>(vec, index, value)
}

test "vector_lowering_runtime_direct_get_set_wrappers" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_direct_get_at(vec, 1), 20)
  Test.assert_eq(vector_direct_set_at(vec, 1, 44), 1)
  Test.assert_eq(vector_direct_get_at(vec, 1), 44)
}

test "vector_lowering_runtime_direct_f64_get_set_wrappers" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  Test.assert_eq(vector_f64_same(vector_direct_get_f64_at(vec, 1), 2.5), 1)
  Test.assert_eq(vector_direct_set_f64_at(vec, 1, 4.5), 1)
  Test.assert_eq(vector_f64_same(vector_direct_get_f64_at(vec, 1), 4.5), 1)
}

test "vector_lowering_runtime_direct_graph_wrapper_with_tiny_index" {
  let graph = vector_with_capacity<i64>(9)
  for i in 0..9 {
    vector_push<i64>(graph, i + 1)
  }
  Test.assert_eq(vector_direct_graph_get(graph, 3, 0, 2), 3)
  Test.assert_eq(vector_direct_graph_get(graph, 3, 2, 1), 8)
}
