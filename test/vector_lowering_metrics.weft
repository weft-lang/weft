-- test/vector_lowering_metrics.weft -- native evidence for direct vector word access lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "stdlib/vector.weft"

fn vector_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn vector_metric_lowerings(src: str) -> i64 {
  pipeline_native_vector_lowering_count(vector_metric_native(src))
}

test "vector_lowering_metric_lowers_i64_len_get_and_set" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let data = __bump_alloc(16) __mem_store64(vec, data) __mem_store64(vec + 8, 2) __mem_store64(vec + 16, 2) __mem_store64(data, 41) __mem_store64(data + 8, 42) let len = vector_len(vec) let got = vector_get<i64>(vec, 1, 0) let ok = vector_set<i64>(vec, 0, got) len + got + ok }"
  Test.assert_eq(vector_metric_lowerings(src), 3)
}

test "vector_lowering_metric_keeps_non_i64_generic_accesses_generic" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 1 } fn main() -> i64 { if vector_get<bool>(0, 0, false) { vector_set<bool>(0, 0, true) } else { 7 } }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_runtime_len_get_set_happy_paths" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 30)
  Test.assert_eq(vector_set<i64>(vec, 1, 41), 1)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 41)
}

test "vector_lowering_runtime_failed_accesses_preserve_defaults_and_values" {
  let vec = vector_with_capacity<i64>(2)
  vector_push<i64>(vec, 5)
  vector_push<i64>(vec, 6)
  Test.assert_eq(vector_len(0), 0)
  Test.assert_eq(vector_get<i64>(0, 0, 99), 99)
  Test.assert_eq(vector_get<i64>(vec, 0 - 1, 88), 88)
  Test.assert_eq(vector_get<i64>(vec, 2, 77), 77)
  Test.assert_eq(vector_set<i64>(0, 0, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 0 - 1, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 2, 42), 0)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 6)
}
