-- test/vector_lowering_metrics.weft -- native evidence for direct vector word access lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "stdlib/vector.weft"

fn vector_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn vector_metric_lowerings(src: str) -> i64 {
  pipeline_native_vector_lowering_count(vector_metric_native(src))
}

fn vector_metric_bound_elisions(src: str) -> i64 {
  pipeline_native_vector_bounds_elision_count(vector_metric_native(src))
}

fn vector_metric_full_bound_elisions(src: str) -> i64 {
  pipeline_native_vector_full_bounds_elision_count(vector_metric_native(src))
}

fn vector_metric_data_hoists(src: str) -> i64 {
  pipeline_native_vector_data_hoist_count(vector_metric_native(src))
}

fn vector_metric_data_hoist_uses(src: str) -> i64 {
  pipeline_native_vector_data_hoist_use_count(vector_metric_native(src))
}

fn vector_metric_push_no_grow(src: str) -> i64 {
  pipeline_native_vector_push_no_grow_count(vector_metric_native(src))
}

fn vector_metric_scaled_addrs(src: str) -> i64 {
  pipeline_native_vector_scaled_addr_count(vector_metric_native(src))
}

fn vector_metric_direct_calls(src: str) -> i64 {
  pipeline_native_vector_direct_call_count(vector_metric_native(src))
}

fn vector_f64_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

test "vector_lowering_metric_lowers_i64_len_get_and_set" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let data = __bump_alloc(16) __mem_store64(vec, data) __mem_store64(vec + 8, 2) __mem_store64(vec + 16, 2) __mem_store64(data, 41) __mem_store64(data + 8, 42) let len = vector_len(vec) let got = vector_get<i64>(vec, 1, 0) let ok = vector_set<i64>(vec, 0, got) len + got + ok }"
  Test.assert_eq(vector_metric_lowerings(src), 3)
}

test "vector_lowering_metric_lowers_f64_get_and_set" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let data = __bump_alloc(16) __mem_store64(vec, data) __mem_store64(vec + 8, 2) __mem_store64(vec + 16, 2) let got = vector_get<f64>(vec, 1, 0.0) vector_set<f64>(vec, 0, got) }"
  Test.assert_eq(vector_metric_lowerings(src), 2)
}

test "vector_lowering_metric_uses_scaled_addr_for_i64_get_and_set" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let data = __bump_alloc(16) __mem_store64(vec, data) __mem_store64(vec + 8, 2) __mem_store64(vec + 16, 2) __mem_store64(data, 41) __mem_store64(data + 8, 42) let got = vector_get<i64>(vec, 1, 0) vector_set<i64>(vec, 0, got) }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 2)
}

test "vector_lowering_metric_uses_scaled_addr_for_f64_get_and_set" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let data = __bump_alloc(16) __mem_store64(vec, data) __mem_store64(vec + 8, 2) __mem_store64(vec + 16, 2) let got = vector_get<f64>(vec, 1, 0.0) vector_set<f64>(vec, 0, got) }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 2)
}

test "vector_lowering_metric_keeps_non_i64_generic_accesses_generic" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 1 } fn main() -> i64 { if vector_get<bool>(0, 0, false) { vector_set<bool>(0, 0, true) } else { 7 } }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_metric_keeps_non_i64_accesses_unscaled" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 1 } fn main() -> i64 { if vector_get<bool>(0, 0, false) { vector_set<bool>(0, 0, true) } else { 7 } }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 0)
}

test "vector_lowering_metric_specializes_direct_get_wrapper" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn get_at(vec: i64, index: i64) -> i64 { vector_get<i64>(vec, index, 0) } fn main(vec: i64, index: i64) -> i64 { get_at(vec, index) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_specializes_direct_set_wrapper" {
  let src = "fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn set_at(vec: i64, index: i64, value: i64) -> i64 { vector_set<i64>(vec, index, value) } fn main(vec: i64, index: i64, value: i64) -> i64 { set_at(vec, index, value) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_specializes_direct_f64_get_wrapper" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn get_at(vec: i64, index: i64) -> f64 { vector_get<f64>(vec, index, 0.0) } fn main(vec: i64, index: i64) -> f64 { get_at(vec, index) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_specializes_direct_f64_get_wrapper_with_tiny_index" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn slot(body: i64, field: i64) -> i64 { body * 7 + field } fn get_field(vec: i64, body: i64, field: i64) -> f64 { vector_get<f64>(vec, slot(body, field), 0.0) } fn main(vec: i64, body: i64, field: i64) -> f64 { get_field(vec, body, field) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_specializes_direct_f64_set_wrapper" {
  let src = "fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn set_at(vec: i64, index: i64, value: f64) -> i64 { vector_set<f64>(vec, index, value) } fn main(vec: i64, index: i64, value: f64) -> i64 { set_at(vec, index, value) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_specializes_graph_edge_wrapper_with_tiny_index" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn graph_index(nodes: i64, from: i64, to: i64) -> i64 { from * nodes + to } fn graph_has_edge(graph: i64, nodes: i64, from: i64, to: i64) -> i64 { vector_get<i64>(graph, graph_index(nodes, from, to), 0) } fn main(graph: i64, nodes: i64, from: i64, to: i64) -> i64 { graph_has_edge(graph, nodes, from, to) }"
  Test.assert_eq(vector_metric_direct_calls(src), 1)
}

test "vector_lowering_metric_keeps_non_i64_direct_get_wrapper_generic" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn get_flag(vec: i64, index: i64) -> bool { vector_get<bool>(vec, index, false) } fn main(vec: i64, index: i64) -> bool { get_flag(vec, index) }"
  Test.assert_eq(vector_metric_direct_calls(src), 0)
}

test "vector_lowering_metric_keeps_effectful_direct_get_wrapper_as_call" {
  let src = "effect Tick { fn next() -> i64 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn get_at(vec: i64, index: i64) -[Tick]> i64 { vector_get<i64>(vec, index, 0) } fn main(vec: i64, index: i64) -[Tick]> i64 { get_at(vec, index) }"
  Test.assert_eq(vector_metric_direct_calls(src), 0)
}

test "vector_lowering_metric_keeps_wrapper_with_control_flow_index_as_call" {
  let src = "fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn clamp_index(index: i64) -> i64 { if index > 0 { index } else { 0 } } fn get_at(vec: i64, index: i64) -> i64 { vector_get<i64>(vec, clamp_index(index), 0) } fn main(vec: i64, index: i64) -> i64 { get_at(vec, index) }"
  Test.assert_eq(vector_metric_direct_calls(src), 0)
}

test "vector_lowering_metric_lowers_i64_push" {
  let src = "fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main() -> i64 { let vec = __bump_alloc(24) __mem_store64(vec, 0) __mem_store64(vec + 8, 0) __mem_store64(vec + 16, 0) vector_push<i64>(vec, 41) }"
  Test.assert_eq(vector_metric_lowerings(src), 1)
}

test "vector_lowering_metric_uses_scaled_addr_for_i64_push_and_grow_copy" {
  let src = "fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main() -> i64 { let vec = __bump_alloc(24) __mem_store64(vec, 0) __mem_store64(vec + 8, 0) __mem_store64(vec + 16, 0) vector_push<i64>(vec, 41) }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 3)
}

test "vector_lowering_metric_keeps_non_i64_push_generic" {
  let src = "fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main() -> i64 { vector_push<bool>(0, true) }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_metric_keeps_non_i64_push_unscaled" {
  let src = "fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main() -> i64 { vector_push<bool>(0, true) }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 0)
}

test "vector_lowering_metric_elides_push_grow_in_capacity_proven_for_range" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(n: i64) -> i64 { let vec = vector_with_capacity<i64>(n) for i in 0..n { vector_push<i64>(vec, i) } vec }"
  Test.assert_eq(vector_metric_push_no_grow(src), 1)
}

test "vector_lowering_metric_uses_scaled_addr_for_no_grow_push" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(n: i64) -> i64 { let vec = vector_with_capacity<i64>(n) for i in 0..n { vector_push<i64>(vec, i) } vec }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 1)
}

test "vector_lowering_metric_elides_push_grow_for_structural_capacity_expr" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(nodes: i64) -> i64 { let graph = vector_with_capacity<i64>(nodes * nodes) for i in 0..nodes * nodes { vector_push<i64>(graph, 0) } graph }"
  Test.assert_eq(vector_metric_push_no_grow(src), 1)
}

test "vector_lowering_metric_keeps_push_grow_when_capacity_mismatches_loop" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(n: i64) -> i64 { let vec = vector_with_capacity<i64>(n) for i in 0..n + 1 { vector_push<i64>(vec, i) } vec }"
  Test.assert_eq(vector_metric_push_no_grow(src), 0)
}

test "vector_lowering_metric_keeps_push_grow_for_multiple_pushes_per_iteration" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(n: i64) -> i64 { let vec = vector_with_capacity<i64>(n) for i in 0..n { vector_push<i64>(vec, i) vector_push<i64>(vec, i) } vec }"
  Test.assert_eq(vector_metric_push_no_grow(src), 0)
}

test "vector_lowering_metric_keeps_push_grow_across_unknown_call" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn touch(x: i64) -> i64 { x } fn main(n: i64) -> i64 { let vec = vector_with_capacity<i64>(n) for i in 0..n { touch(vec) vector_push<i64>(vec, i) } vec }"
  Test.assert_eq(vector_metric_push_no_grow(src), 0)
}

test "vector_lowering_metric_keeps_non_i64_capacity_push_generic" {
  let src = "fn vector_with_capacity<T>(capacity: i64) -> i64 { capacity } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main(n: i64) -> i64 { let vec = vector_with_capacity<bool>(n) for i in 0..n { vector_push<bool>(vec, true) } vec }"
  Test.assert_eq(vector_metric_push_no_grow(src), 0)
}

test "vector_lowering_metric_lowers_i64_fold_literal_lambda" {
  let src = "fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A { init } fn main() -> i64 { vector_fold<i64, i64>(0, 7, (acc: i64, x: i64) => acc + x) }"
  Test.assert_eq(vector_metric_lowerings(src), 1)
}

test "vector_lowering_metric_uses_scaled_addr_for_i64_fold" {
  let src = "fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A { init } fn main() -> i64 { vector_fold<i64, i64>(0, 7, (acc: i64, x: i64) => acc + x) }"
  Test.assert_eq(vector_metric_scaled_addrs(src), 1)
}

test "vector_lowering_metric_keeps_fold_named_callback_generic" {
  let src = "fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A { init } fn add(acc: i64, x: i64) -> i64 { acc + x } fn main() -> i64 { vector_fold<i64, i64>(0, 7, add) }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_metric_keeps_fold_captured_lambda_generic" {
  let src = "fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A { init } fn main() -> i64 { let bias = 1 vector_fold<i64, i64>(0, 7, (acc: i64, x: i64) => acc + x + bias) }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_metric_keeps_non_i64_fold_generic" {
  let src = "fn vector_fold<T, A>(vec: i64, init: A, f: (A, T) -> A) -> A { init } fn main() -> i64 { vector_fold<bool, i64>(0, 0, (acc: i64, x: bool) => if x { acc + 1 } else { acc }) }"
  Test.assert_eq(vector_metric_lowerings(src), 0)
}

test "vector_lowering_metric_elides_upper_bound_from_direct_vector_len_guard" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { total = total + vector_get<i64>(vec, i, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_bound_elisions(src), 1)
  Test.assert_eq(vector_metric_full_bound_elisions(src), 1)
}

test "vector_lowering_metric_elides_upper_bound_from_vector_len_alias_guard" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let len = vector_len(vec) let mut i = 0 let mut total = 0 while i < len { let got = vector_get<i64>(vec, i, 0) vector_set<i64>(vec, i, got) total = total + got i = i + 1 } total }"
  Test.assert_eq(vector_metric_bound_elisions(src), 2)
  Test.assert_eq(vector_metric_full_bound_elisions(src), 2)
}

test "vector_lowering_metric_keeps_upper_bound_when_index_expression_not_proven" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let vec = __bump_alloc(24) let len = vector_len(vec) let mut i = 0 let mut total = 0 while i < len { total = total + vector_get<i64>(vec, i + 1, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_bound_elisions(src), 0)
  Test.assert_eq(vector_metric_full_bound_elisions(src), 0)
}

test "vector_lowering_metric_assignment_invalidates_loop_bound_fact" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { i = i + 1 total = total + vector_get<i64>(vec, i, 0) } total }"
  Test.assert_eq(vector_metric_bound_elisions(src), 0)
  Test.assert_eq(vector_metric_full_bound_elisions(src), 0)
}

test "vector_lowering_metric_negative_assignment_keeps_only_upper_bound_elision" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 while i < vector_len(vec) { let got = vector_get<i64>(vec, i, 0) i = 0 - 1 got } 0 }"
  Test.assert_eq(vector_metric_bound_elisions(src), 1)
  Test.assert_eq(vector_metric_full_bound_elisions(src), 0)
}

test "vector_lowering_metric_hoists_data_pointer_for_direct_guard_loop" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { total = total + vector_get<i64>(vec, i, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_data_hoists(src), 1)
  Test.assert_eq(vector_metric_data_hoist_uses(src), 1)
}

test "vector_lowering_metric_reuses_hoisted_data_for_get_and_set" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_set<T>(vec: i64, index: i64, value: T) -> i64 { 0 } fn main() -> i64 { let vec = __bump_alloc(24) let len = vector_len(vec) let mut i = 0 let mut total = 0 while i < len { let got = vector_get<i64>(vec, i, 0) vector_set<i64>(vec, i, got) total = total + got i = i + 1 } total }"
  Test.assert_eq(vector_metric_data_hoists(src), 1)
  Test.assert_eq(vector_metric_data_hoist_uses(src), 2)
}

test "vector_lowering_metric_does_not_hoist_across_unknown_call" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn touch(x: i64) -> i64 { x } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { touch(vec) total = total + vector_get<i64>(vec, i, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_data_hoists(src), 0)
  Test.assert_eq(vector_metric_data_hoist_uses(src), 0)
}

test "vector_lowering_metric_does_not_hoist_across_generic_vector_mutator" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn vector_push<T>(vec: i64, value: T) -> i64 { vec } fn main() -> i64 { let vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { vector_push<i64>(vec, i) total = total + vector_get<i64>(vec, i, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_data_hoists(src), 0)
  Test.assert_eq(vector_metric_data_hoist_uses(src), 0)
}

test "vector_lowering_metric_does_not_hoist_when_vector_binding_changes" {
  let src = "fn vector_len(vec: i64) -> i64 { 0 } fn vector_get<T>(vec: i64, index: i64, default: T) -> T { default } fn main() -> i64 { let mut vec = __bump_alloc(24) let mut i = 0 let mut total = 0 while i < vector_len(vec) { vec = __bump_alloc(24) total = total + vector_get<i64>(vec, i, 0) i = i + 1 } total }"
  Test.assert_eq(vector_metric_data_hoists(src), 0)
  Test.assert_eq(vector_metric_data_hoist_uses(src), 0)
}

test "vector_lowering_runtime_len_get_set_happy_paths" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 30)
  Test.assert_eq(vector_set<i64>(vec, 1, 41), 1)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 41)
}

test "vector_lowering_runtime_f64_get_set_happy_paths" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0, 0.0), 1.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 2, 0.0), 3.75), 1)
  Test.assert_eq(vector_set<f64>(vec, 1, 4.5), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 1, 0.0), 4.5), 1)
}

test "vector_lowering_runtime_f64_multiple_gets_in_expression" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  let total = vector_get<f64>(vec, 0, 0.0) + vector_get<f64>(vec, 1, 0.0) + vector_get<f64>(vec, 2, 0.0)
  Test.assert_eq(vector_f64_same(total, 7.5), 1)
}

test "vector_lowering_runtime_push_grows_and_preserves_values" {
  let vec = vector_with_capacity<i64>(1)
  vector_push<i64>(vec, 11)
  vector_push<i64>(vec, 22)
  vector_push<i64>(vec, 33)
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(vector_capacity(vec), 4)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 11)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 22)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 33)
}

test "vector_lowering_runtime_push_null_returns_zero" {
  Test.assert_eq(vector_push<i64>(0, 99), 0)
}

test "vector_lowering_runtime_bool_push_stays_generic" {
  let vec = vector_with_capacity<bool>(1)
  vector_push<bool>(vec, true)
  vector_push<bool>(vec, false)
  let first = if vector_get<bool>(vec, 0, false) { 1 } else { 0 }
  let second = if vector_get<bool>(vec, 1, true) { 1 } else { 0 }
  Test.assert_eq(vector_len(vec), 2)
  Test.assert_eq(first, 1)
  Test.assert_eq(second, 0)
}

test "vector_lowering_runtime_capacity_proven_for_range_push_no_grow" {
  let n = 4
  let vec = vector_with_capacity<i64>(n)
  for i in 0..n {
    vector_push<i64>(vec, i + 10)
  }
  Test.assert_eq(vector_len(vec), 4)
  Test.assert_eq(vector_capacity(vec), 4)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(vec, 3, 0), 13)
}

test "vector_lowering_runtime_capacity_mismatch_still_grows" {
  let vec = vector_with_capacity<i64>(2)
  for i in 0..3 {
    vector_push<i64>(vec, i + 1)
  }
  Test.assert_eq(vector_len(vec), 3)
  Test.assert_eq(if vector_capacity(vec) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 1)
  Test.assert_eq(vector_get<i64>(vec, 2, 0), 3)
}

test "vector_lowering_runtime_fold_literal_lambda_happy_paths" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_fold<i64, i64>(vec, 5, (acc: i64, x: i64) => acc + x), 65)
  Test.assert_eq(vector_fold<i64, i64>(vec, 1, (acc: i64, x: i64) => acc * x), 6000)
}

test "vector_lowering_runtime_fold_literal_lambda_empty_and_null" {
  let empty = vector_with_capacity<i64>(0)
  Test.assert_eq(vector_fold<i64, i64>(empty, 9, (acc: i64, x: i64) => acc + x), 9)
  Test.assert_eq(vector_fold<i64, i64>(0, 7, (acc: i64, x: i64) => acc + x), 7)
}

test "vector_lowering_runtime_fold_literal_lambda_branchy_body" {
  let vec = vector_with_capacity<i64>(5)
  vector_push<i64>(vec, 1)
  vector_push<i64>(vec, 2)
  vector_push<i64>(vec, 3)
  vector_push<i64>(vec, 4)
  vector_push<i64>(vec, 5)
  let evens = vector_fold<i64, i64>(vec, 0, (acc: i64, x: i64) => if x % 2 == 0 { acc + 1 } else { acc })
  Test.assert_eq(evens, 2)
}

test "vector_lowering_runtime_failed_accesses_preserve_defaults_and_values" {
  let vec = vector_with_capacity<i64>(2)
  vector_push<i64>(vec, 5)
  vector_push<i64>(vec, 6)
  Test.assert_eq(vector_len(0), 0)
  Test.assert_eq(vector_get<i64>(0, 0, 99), 99)
  Test.assert_eq(vector_get<i64>(vec, 0 - 1, 88), 88)
  Test.assert_eq(vector_get<i64>(vec, 2, 77), 77)
  Test.assert_eq(vector_set<i64>(0, 0, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 0 - 1, 42), 0)
  Test.assert_eq(vector_set<i64>(vec, 2, 42), 0)
  Test.assert_eq(vector_get<i64>(vec, 0, 0), 5)
  Test.assert_eq(vector_get<i64>(vec, 1, 0), 6)
}

test "vector_lowering_runtime_f64_failed_accesses_preserve_defaults_and_values" {
  let vec = vector_with_capacity<f64>(2)
  vector_push<f64>(vec, 5.5)
  vector_push<f64>(vec, 6.5)
  Test.assert_eq(vector_f64_same(vector_get<f64>(0, 0, 9.25), 9.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0 - 1, 8.25), 8.25), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 2, 7.25), 7.25), 1)
  Test.assert_eq(vector_set<f64>(0, 0, 42.5), 0)
  Test.assert_eq(vector_set<f64>(vec, 0 - 1, 42.5), 0)
  Test.assert_eq(vector_set<f64>(vec, 2, 42.5), 0)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 0, 0.0), 5.5), 1)
  Test.assert_eq(vector_f64_same(vector_get<f64>(vec, 1, 0.0), 6.5), 1)
}

fn vector_direct_get_at(vec: i64, index: i64) -> i64 {
  vector_get<i64>(vec, index, 0)
}

fn vector_direct_set_at(vec: i64, index: i64, value: i64) -> i64 {
  vector_set<i64>(vec, index, value)
}

fn vector_direct_index(width: i64, row: i64, col: i64) -> i64 {
  row * width + col
}

fn vector_direct_graph_get(graph: i64, width: i64, row: i64, col: i64) -> i64 {
  vector_get<i64>(graph, vector_direct_index(width, row, col), 0)
}

fn vector_direct_get_f64_at(vec: i64, index: i64) -> f64 {
  vector_get<f64>(vec, index, 0.0)
}

fn vector_direct_set_f64_at(vec: i64, index: i64, value: f64) -> i64 {
  vector_set<f64>(vec, index, value)
}

test "vector_lowering_runtime_direct_get_set_wrappers" {
  let vec = vector_with_capacity<i64>(3)
  vector_push<i64>(vec, 10)
  vector_push<i64>(vec, 20)
  vector_push<i64>(vec, 30)
  Test.assert_eq(vector_direct_get_at(vec, 1), 20)
  Test.assert_eq(vector_direct_set_at(vec, 1, 44), 1)
  Test.assert_eq(vector_direct_get_at(vec, 1), 44)
}

test "vector_lowering_runtime_direct_f64_get_set_wrappers" {
  let vec = vector_with_capacity<f64>(3)
  vector_push<f64>(vec, 1.25)
  vector_push<f64>(vec, 2.5)
  vector_push<f64>(vec, 3.75)
  Test.assert_eq(vector_f64_same(vector_direct_get_f64_at(vec, 1), 2.5), 1)
  Test.assert_eq(vector_direct_set_f64_at(vec, 1, 4.5), 1)
  Test.assert_eq(vector_f64_same(vector_direct_get_f64_at(vec, 1), 4.5), 1)
}

test "vector_lowering_runtime_direct_graph_wrapper_with_tiny_index" {
  let graph = vector_with_capacity<i64>(9)
  for i in 0..9 {
    vector_push<i64>(graph, i + 1)
  }
  Test.assert_eq(vector_direct_graph_get(graph, 3, 0, 2), 3)
  Test.assert_eq(vector_direct_graph_get(graph, 3, 2, 1), 8)
}
