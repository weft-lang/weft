-- Expected exit code: 91
-- Complex match: variant tags with payloads
type Shape {
  Circle(i64),
  Rect(i64)
}

fn area(s: Shape) -> i64 {
  match s {
    Circle(r) -> r * r * 3,
    Rect(side) -> side * side
  }
}

fn main() {
  let c = Circle(5)
  let r = Rect(4)
  -- area(Circle(5)) = 75, area(Rect(4)) = 16
  -- 75 + 16 = 91
  let a = area(c)
  let b = area(r)
  a + b
}
