-- Complex match: variant tags with payloads
type Shape {
  Circle(Int),
  Rect(Int)
}

fn area(s: Shape) -> Int {
  match s {
    Shape.Circle(r) -> r * r * 3,
    Shape.Rect(side) -> side * side
  }
}

fn main() {
  let c = Shape.Circle(5)
  let r = Shape.Rect(4)
  -- area(Circle(5)) = 75, area(Rect(4)) = 16
  -- 75 + 16 = 91
  let a = area(c)
  let b = area(r)
  a + b
}
