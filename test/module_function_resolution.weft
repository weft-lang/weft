use module_fixtures/g2_function_left.{ work as left_work, identity as left_identity }
use module_fixtures/g2_function_right.{ work as right_work }

test "selected function alias lowers to its declaration" {
  Test.assert_eq(left_work(), 11)
}

test "same-spelling functions retain distinct declaration identities" {
  Test.assert_eq(left_work(), 11)
  Test.assert_true(right_work())
}

test "selected function alias preserves identity as a value" {
  let selected: () -> i64 = left_work
  Test.assert_eq(selected(), 11)
}

test "selected generic function alias specializes its declaration" {
  Test.assert_eq(left_identity<i64>(31), 31)
}
