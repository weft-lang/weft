use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/http as http
use stdlib/http.{HttpGet, HttpHeaders, HttpRequestHead, HttpRequestHeadReady, HttpResponseHead, HttpResponseHeadReady}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random.{SecureRandom, SecureRandomExhausted}
use stdlib/secure_random/deterministic as deterministic_random
use stdlib/string.{str_repeat}
use stdlib/vector as vector
use stdlib/vector.{vector_push}
use stdlib/websocket as websocket
use stdlib/websocket.{*}

fn ws_bytes(values: [i64]) -> Bytes {
  let out = vector.new<u8>()
  for value in values {
    vector_push<u8>(out, __i64_to_u8(value))
  }
  bytes.from_vector(out)
}

fn ws_bytes_1(a: i64) -> Bytes {
  let values = [a]
  ws_bytes(values[..])
}

fn ws_bytes_2(a: i64, b: i64) -> Bytes {
  let values = [a, b]
  ws_bytes(values[..])
}

fn ws_bytes_3(a: i64, b: i64, c: i64) -> Bytes {
  let values = [a, b, c]
  ws_bytes(values[..])
}

fn ws_bytes_4(a: i64, b: i64, c: i64, d: i64) -> Bytes {
  let values = [a, b, c, d]
  ws_bytes(values[..])
}

fn ws_bytes_5(a: i64, b: i64, c: i64, d: i64, e: i64) -> Bytes {
  let values = [a, b, c, d, e]
  ws_bytes(values[..])
}

fn ws_bytes_6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> Bytes {
  let values = [a, b, c, d, e, f]
  ws_bytes(values[..])
}

fn ws_bytes_7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> Bytes {
  let values = [a, b, c, d, e, f, g]
  ws_bytes(values[..])
}

fn ws_bytes_10(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64) -> Bytes {
  let values = [a, b, c, d, e, f, g, h, i, j]
  ws_bytes(values[..])
}

fn ws_bytes_11(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64, k: i64) -> Bytes {
  let values = [a, b, c, d, e, f, g, h, i, j, k]
  ws_bytes(values[..])
}

fn ws_usize(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn ws_header(source: Bytes, role: WebSocketRole, limits: WebSocketLimits) -> Option<WebSocketFrameHeader> {
  match websocket.parse_frame_header(source, role, limits) {
    WebSocketFrameReady(header, consumed) -> Some(header)
    _ -> None
  }
}

fn ws_server_header(first: i64, length: i64, limits: WebSocketLimits) -> WebSocketFrameHeader {
  ws_header(ws_bytes_2(first, length), WebSocketClient, limits).unwrap()
}

fn ws_message_begin(
  state: WebSocketMessageState,
  header: WebSocketFrameHeader,
  limits: WebSocketLimits
) -> Result<WebSocketMessageFrame, WebSocketError> {
  state.begin(
    websocket.close_handshake(),
    WebSocketReceiveMessages,
    header,
    limits
  )
}

fn ws_client_hello() -[SecureRandom]> Result<Bytes, WebSocketError> {
  websocket.encode_client_frame(
    true,
    WebSocketText,
    bytes.from_str("Hello"),
    websocket.default_limits()
  )
}

fn ws_client_upgrade_probe() -[SecureRandom]> Result<WebSocketClientUpgrade, WebSocketHandshakeError> {
  websocket.client_upgrade()
}

fn ws_request(source: str) -> HttpRequestHead {
  let values = bytes.from_str(source).to_vector()
  match http.parse_request_head(values[..], http.default_limits()) {
    HttpRequestHeadReady(head, framing, consumed) -> head
    _ -> panic("invalid WebSocket request fixture")
  }
}

fn ws_response(source: str) -> HttpResponseHead {
  let values = bytes.from_str(source).to_vector()
  match http.parse_response_head(values[..], HttpGet, http.default_limits()) {
    HttpResponseHeadReady(head, framing, consumed) -> head
    _ -> panic("invalid WebSocket response fixture")
  }
}

fn ws_header_text(headers: HttpHeaders, name: str) -> str {
  let mut value = ""
  for index in 0..headers.len() {
    match headers.get(index) {
      Some(header) -> if header.name().text() == name {
        value = header.value().to_utf8().unwrap()
        0
      } else { 0 }
      None -> 0
    }
  }
  value
}

test "WebSocket limits reject invalid frame and message bounds" {
  match websocket.limits(0, 8) {
    Err(WebSocketInvalidFrameLimit(value)) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
  match websocket.limits(8, 0) {
    Err(WebSocketInvalidMessageLimit(value)) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
  match websocket.limits(9, 8) {
    Err(WebSocketInvalidMessageLimit(value)) -> Test.assert_eq(value, 8)
    _ -> Test.assert_true(false)
  }
  match websocket.limits(8, 16) {
    Ok(limits) -> Test.assert_eq(ws_server_header(129, 0, limits).payload_bytes(), 0)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket upgrade reproduces the RFC nonce and accept proof" {
  let request = ws_request(
    "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )
  match websocket.server_upgrade(request) {
    Ok(headers) -> {
      Test.assert_str_eq(ws_header_text(headers, "upgrade"), "websocket")
      Test.assert_str_eq(ws_header_text(headers, "connection"), "Upgrade")
      Test.assert_str_eq(
        ws_header_text(headers, "sec-websocket-accept"),
        "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
      )
    }
    _ -> Test.assert_true(false)
  }

  let upgrade = with deterministic_random(
    deterministic_random.stream(bytes.from_str("the sample nonce"))
  ) { ws_client_upgrade_probe() }.unwrap()
  let request_headers = upgrade.headers()
  Test.assert_str_eq(
    ws_header_text(request_headers, "sec-websocket-key"),
    "dGhlIHNhbXBsZSBub25jZQ=="
  )
  let response = ws_response(
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
  )
  match upgrade.validate(response) {
    Ok(done) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket server upgrade rejects ambiguity and declines optional offers" {
  match websocket.server_upgrade(ws_request(
    "POST /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeMethod) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.0\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeHttpVersion) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeUpgrade) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: keep-alive\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeConnection) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: not-base64\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeKey) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )) {
    Err(WebSocketHandshakeKey) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 12\r\n\r\n"
  )) {
    Err(WebSocketHandshakeVersion) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Extensions: permessage-deflate\r\nSec-WebSocket-Protocol: chat\r\n\r\n"
  )) {
    Ok(headers) -> Test.assert_eq(headers.len(), 3)
    _ -> Test.assert_true(false)
  }
  match websocket.server_upgrade(ws_request(
    "GET /chat HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nContent-Length: 1\r\n\r\n"
  )) {
    Err(WebSocketHandshakeBody) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket client upgrade rejects status proof extension and entropy failures" {
  let upgrade = with deterministic_random(
    deterministic_random.stream(bytes.from_str("the sample nonce"))
  ) { ws_client_upgrade_probe() }.unwrap()
  match upgrade.validate(ws_response(
    "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
  )) {
    Err(WebSocketHandshakeStatus) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match upgrade.validate(ws_response(
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: wrong\r\n\r\n"
  )) {
    Err(WebSocketHandshakeAccept) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match upgrade.validate(ws_response(
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n"
  )) {
    Err(WebSocketHandshakeExtensions) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match upgrade.validate(ws_response(
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: chat\r\n\r\n"
  )) {
    Err(WebSocketHandshakeProtocol) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match with deterministic_random(
    deterministic_random.stream(bytes.from_str("fifteen bytes!!"))
  ) { ws_client_upgrade_probe() } {
    Err(WebSocketHandshakeRandom(SecureRandomExhausted(requested, remaining))) -> {
      Test.assert_eq(ws_usize(requested), 16)
      Test.assert_eq(ws_usize(remaining), 15)
    }
    _ -> Test.assert_true(false)
  }
}

test "WebSocket parses the canonical unmasked and masked Hello frames" {
  let limits = websocket.default_limits()
  let server = ws_bytes_7(129, 5, 72, 101, 108, 108, 111)
  match websocket.parse_frame_header(server, WebSocketClient, limits) {
    WebSocketFrameReady(header, consumed) -> {
      Test.assert_eq(ws_usize(consumed), 2)
      Test.assert_true(header.is_final())
      Test.assert_true(not header.is_masked())
      match header.opcode() {
        WebSocketText -> Test.assert_eq(header.payload_bytes(), 5)
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }

  -- RFC 6455 section 5.7: masked client "Hello" with key 37 fa 21 3d.
  let client = ws_bytes_11(129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88)
  match websocket.parse_frame_header(client, WebSocketServer, limits) {
    WebSocketFrameReady(header, consumed) -> {
      Test.assert_eq(ws_usize(consumed), 6)
      Test.assert_true(header.is_masked())
      match header.payload_decoder().read(ws_bytes_2(127, 159)) {
        WebSocketPayloadChunk(next, first, first_count) -> {
          Test.assert_str_eq(first.to_utf8().unwrap(), "He")
          Test.assert_eq(ws_usize(first_count), 2)
          match next.read(ws_bytes_4(77, 81, 88, 99)) {
            WebSocketPayloadEnd(last, last_count) -> {
              Test.assert_str_eq(last.to_utf8().unwrap(), "llo")
              Test.assert_eq(ws_usize(last_count), 3)
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "WebSocket header parsing needs every partial masked boundary" {
  let source = ws_bytes_6(130, 128, 1, 2, 3, 4)
  let mut count = 0
  for end in 0..6 {
    let prefix_values = vector.new<u8>()
    for index in 0..end {
      vector_push<u8>(prefix_values, match source.get(index) {
        Some(value) -> value
        None -> __i64_to_u8(0)
      })
    }
    match websocket.parse_frame_header(bytes.from_vector(prefix_values), WebSocketServer, websocket.default_limits()) {
      WebSocketFrameNeedMore -> {
        count = count + 1
        Test.assert_true(true)
      }
      _ -> Test.assert_true(false)
    }
  }
  match websocket.parse_frame_header(source, WebSocketServer, websocket.default_limits()) {
    WebSocketFrameReady(header, consumed) -> {
      Test.assert_eq(ws_usize(consumed), 6)
      Test.assert_eq(header.payload_bytes(), 0)
      count = count + 1
      Test.assert_true(true)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(count, 7)
}

test "WebSocket rejects wrong masking RSV and reserved opcodes" {
  let limits = websocket.default_limits()
  match websocket.parse_frame_header(ws_bytes_2(129, 128), WebSocketClient, limits) {
    WebSocketFrameFailed(WebSocketMaskForbidden) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(ws_bytes_2(129, 0), WebSocketServer, limits) {
    WebSocketFrameFailed(WebSocketMaskRequired) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(ws_bytes_2(193, 0), WebSocketClient, limits) {
    WebSocketFrameFailed(WebSocketReservedBits(bits)) -> Test.assert_eq(bits, 64)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(ws_bytes_2(131, 0), WebSocketClient, limits) {
    WebSocketFrameFailed(WebSocketReservedOpcode(opcode)) -> Test.assert_eq(opcode, 3)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket enforces canonical extended lengths and configured bounds" {
  let limits = websocket.limits(70000, 140000).unwrap()
  let cases = [
  ws_bytes_2(130, 125),
    ws_bytes_4(130, 126, 0, 126),
    ws_bytes_4(130, 126, 255, 255),
    ws_bytes_10(130, 127, 0, 0, 0, 0, 0, 1, 0, 0)
  ]
  let expected = [125, 126, 65535, 65536]
  let mut valid = 0
  for index in 0..4 {
    match websocket.parse_frame_header(cases[__i64_to_usize(index)], WebSocketClient, limits) {
      WebSocketFrameReady(header, consumed) -> {
        Test.assert_eq(header.payload_bytes(), expected[__i64_to_usize(index)])
        valid = valid + 1
        Test.assert_true(true)
      }
      _ -> Test.assert_true(false)
    }
  }
  Test.assert_eq(valid, 4)
  match websocket.parse_frame_header(ws_bytes_4(130, 126, 0, 125), WebSocketClient, limits) {
    WebSocketFrameFailed(WebSocketNoncanonicalLength(value)) -> Test.assert_eq(value, 125)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(
    ws_bytes_10(130, 127, 0, 0, 0, 0, 0, 0, 255, 255), WebSocketClient, limits
  ) {
    WebSocketFrameFailed(WebSocketNoncanonicalLength(value)) -> Test.assert_eq(value, 65535)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(
    ws_bytes_10(130, 127, 128, 0, 0, 0, 0, 0, 0, 0), WebSocketClient, limits
  ) {
    WebSocketFrameFailed(WebSocketInvalidLength(first)) -> Test.assert_eq(first, 128)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(ws_bytes_4(130, 126, 1, 1), WebSocketClient, websocket.limits(256, 512).unwrap()) {
    WebSocketFrameFailed(WebSocketFrameTooLarge(value)) -> Test.assert_eq(value, 257)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket controls are final and at most 125 bytes" {
  match websocket.parse_frame_header(ws_bytes_2(9, 0), WebSocketClient, websocket.default_limits()) {
    WebSocketFrameFailed(WebSocketFragmentedControl) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.parse_frame_header(ws_bytes_4(137, 126, 0, 126), WebSocketClient, websocket.default_limits()) {
    WebSocketFrameFailed(WebSocketControlTooLarge(value)) -> Test.assert_eq(value, 126)
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketPing, bytes.from_str("ping")) {
    Ok(WebSocketControlPing(payload)) -> Test.assert_str_eq(payload.to_utf8().unwrap(), "ping")
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketPong, bytes.from_str("pong")) {
    Ok(WebSocketControlPong(payload)) -> Test.assert_str_eq(payload.to_utf8().unwrap(), "pong")
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketText, bytes.from_str("data")) {
    Err(WebSocketExpectedControl) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket close payloads preserve absence status and UTF8 reasons" {
  match websocket.decode_control(WebSocketClose, bytes.from_str("")) {
    Ok(WebSocketControlClose(WebSocketCloseWithoutStatus)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketClose, ws_bytes_1(3)) {
    Err(WebSocketInvalidClosePayload) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketClose, ws_bytes_5(3, 232, 98, 121, 101)) {
    Ok(WebSocketControlClose(WebSocketCloseWithStatus(code, reason))) -> {
      Test.assert_eq(code, 1000)
      Test.assert_str_eq(reason, "bye")
    }
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketClose, ws_bytes_2(3, 237)) {
    Err(WebSocketInvalidCloseCode(code)) -> Test.assert_eq(code, 1005)
    _ -> Test.assert_true(false)
  }
  match websocket.decode_control(WebSocketClose, ws_bytes_3(3, 232, 255)) {
    Err(WebSocketInvalidCloseReason(offset)) -> Test.assert_eq(offset, 2)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket close construction follows the current wire registry" {
  for code in [1000, 1012, 1013, 1014, 3000, 4999] {
    match websocket.close(code, "ok") {
      Ok(WebSocketCloseWithStatus(got, reason)) -> Test.assert_eq(got, code)
      _ -> Test.assert_true(false)
    }
  }
  for code in [999, 1004, 1005, 1006, 1015, 2999, 5000] {
    match websocket.close(code, "bad") {
      Err(WebSocketInvalidCloseCode(got)) -> Test.assert_eq(got, code)
      _ -> Test.assert_true(false)
    }
  }
  match websocket.close(1000, str_repeat("x", 124)) {
    Err(WebSocketCloseReasonTooLong(length)) -> Test.assert_eq(length, 124)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket close handshake makes send receive echo and duplicate races explicit" {
  let close = websocket.close(1000, "done").unwrap()
  let received_first = match websocket.close_handshake().on_receive(close) {
    WebSocketCloseEcho(state, WebSocketCloseWithStatus(code, reason)) -> {
      Test.assert_eq(code, 1000)
      Test.assert_str_eq(reason, "done")
      Test.assert_true(state.was_received())
      Test.assert_true(not state.was_sent())
      state
    }
    _ -> websocket.close_handshake()
  }
  match received_first.on_send() {
    WebSocketCloseComplete(state) -> Test.assert_true(state.is_complete())
    _ -> Test.assert_true(false)
  }

  let sent_first = match websocket.close_handshake().on_send() {
    WebSocketCloseAwaitPeer(state) -> state
    _ -> websocket.close_handshake()
  }
  match sent_first.on_send() {
    WebSocketCloseDuplicate(state) -> Test.assert_true(state.was_sent())
    _ -> Test.assert_true(false)
  }
  let limits = websocket.default_limits()
  match websocket.message_state().begin(
    sent_first,
    WebSocketSendMessages,
    ws_server_header(129, 0, limits),
    limits
  ) {
    Err(WebSocketDataAfterClose) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let complete = match sent_first.on_receive(close) {
    WebSocketCloseComplete(state) -> state
    _ -> sent_first
  }
  Test.assert_true(complete.is_complete())
  match complete.on_receive(close) {
    WebSocketCloseDuplicate(state) -> Test.assert_true(state.is_complete())
    _ -> Test.assert_true(false)
  }
}

test "WebSocket server and deterministic client encoders produce canonical wire bytes" {
  match websocket.encode_server_frame(
    true, WebSocketText, bytes.from_str("Hi"), websocket.default_limits()
  ) {
    Ok(wire) -> Test.assert_true(wire.eq(ws_bytes_4(129, 2, 72, 105)))
    _ -> Test.assert_true(false)
  }
  let encoded = with deterministic_random(
    deterministic_random.stream(ws_bytes_4(55, 250, 33, 61))
  ) { ws_client_hello() }
  match encoded {
    Ok(wire) -> Test.assert_true(
      wire.eq(ws_bytes_11(129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88))
    )
    _ -> Test.assert_true(false)
  }
  let exhausted = with deterministic_random(
    deterministic_random.stream(ws_bytes_3(1, 2, 3))
  ) { ws_client_hello() }
  match exhausted {
    Err(WebSocketRandom(error)) -> match error {
      SecureRandomExhausted(requested, remaining) -> {
        Test.assert_eq(ws_usize(requested), 4)
        Test.assert_eq(ws_usize(remaining), 3)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "WebSocket message sequencing carries split UTF8 through control interruption" {
  let limits = websocket.default_limits()
  let initial = websocket.message_state()
  let first_header = ws_server_header(1, 2, limits)
  let after_first = match ws_message_begin(initial, first_header, limits) {
    Ok(frame) -> {
      match frame.content() {
        WebSocketTextContent -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
      match frame.read(WebSocketMessageEnd(ws_bytes_2(240, 159))) {
        WebSocketMessageDone(state) -> state
        _ -> initial
      }
    }
    _ -> initial
  }
  match after_first.pending() {
    Some(WebSocketTextMessage) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let ping_header = ws_server_header(137, 1, limits)
  let after_ping = match ws_message_begin(after_first, ping_header, limits) {
    Ok(frame) -> {
      match frame.content() {
        WebSocketControlContent -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
      match frame.read(WebSocketMessageEnd(bytes.from_str("x"))) {
        WebSocketMessageDone(state) -> state
        _ -> after_first
      }
    }
    _ -> after_first
  }
  let final_header = ws_server_header(128, 2, limits)
  match ws_message_begin(after_ping, final_header, limits) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(ws_bytes_2(167, 182))) {
      WebSocketMessageDone(state) -> {
        match state.pending() {
          None -> Test.assert_true(true)
          _ -> Test.assert_true(false)
        }
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "WebSocket message sequencing rejects continuation interleaving and overflow" {
  let limits = websocket.limits(3, 4).unwrap()
  match ws_message_begin(
    websocket.message_state(), ws_server_header(128, 0, limits), limits
  ) {
    Err(WebSocketContinuationWithoutMessage) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let active = match ws_message_begin(
    websocket.message_state(), ws_server_header(1, 3, limits), limits
  ) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(bytes.from_str("abc"))) {
      WebSocketMessageDone(state) -> state
      _ -> websocket.message_state()
    }
    _ -> websocket.message_state()
  }
  match ws_message_begin(active, ws_server_header(130, 1, limits), limits) {
    Err(WebSocketInterleavedMessage) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match ws_message_begin(active, ws_server_header(128, 2, limits), limits) {
    Err(WebSocketMessageTooLarge(limit)) -> Test.assert_eq(limit, 4)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket message text validation reports malformed and truncated offsets" {
  let limits = websocket.default_limits()
  let active = match ws_message_begin(
    websocket.message_state(), ws_server_header(1, 2, limits), limits
  ) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(ws_bytes_2(240, 159))) {
      WebSocketMessageDone(state) -> state
      _ -> websocket.message_state()
    }
    _ -> websocket.message_state()
  }
  match ws_message_begin(active, ws_server_header(128, 2, limits), limits) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(ws_bytes_2(167, 0))) {
      WebSocketMessageFailed(WebSocketInvalidText(offset)) -> Test.assert_eq(offset, 3)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match ws_message_begin(active, ws_server_header(128, 0, limits), limits) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(bytes.from_str(""))) {
      WebSocketMessageFailed(WebSocketInvalidText(offset)) -> Test.assert_eq(offset, 0)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "WebSocket message payload boundaries and close state are exact" {
  let limits = websocket.default_limits()
  let header = ws_server_header(130, 3, limits)
  match ws_message_begin(websocket.message_state(), header, limits) {
    Ok(frame) -> {
      match frame.read(WebSocketMessageChunk(bytes.from_str(""))) {
        WebSocketMessageFailed(WebSocketPayloadLengthMismatch(actual, expected)) -> {
          Test.assert_eq(actual, 0)
          Test.assert_eq(expected, 3)
        }
        _ -> Test.assert_true(false)
      }
      match frame.read(WebSocketMessageEnd(ws_bytes_2(1, 2))) {
        WebSocketMessageFailed(WebSocketPayloadLengthMismatch(actual, expected)) -> {
          Test.assert_eq(actual, 2)
          Test.assert_eq(expected, 3)
        }
        _ -> Test.assert_true(false)
      }
      match frame.read(WebSocketMessageChunk(ws_bytes_1(1))) {
        WebSocketMessageMore(next) -> match next.read(WebSocketMessageEnd(ws_bytes_2(2, 3))) {
          WebSocketMessageDone(state) -> Test.assert_true(true)
          _ -> Test.assert_true(false)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }

  let close_header = ws_server_header(136, 0, limits)
  let closed = match ws_message_begin(websocket.message_state(), close_header, limits) {
    Ok(frame) -> match frame.read(WebSocketMessageEnd(bytes.from_str(""))) {
      WebSocketMessageDone(state) -> state
      _ -> websocket.message_state()
    }
    _ -> websocket.message_state()
  }
  match closed.pending() {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let peer_closed = match websocket.close_handshake().on_receive(WebSocketCloseWithoutStatus) {
    WebSocketCloseEcho(state, close) -> state
    _ -> websocket.close_handshake()
  }
  match closed.begin(
    peer_closed,
    WebSocketReceiveMessages,
    ws_server_header(129, 0, limits),
    limits
  ) {
    Err(WebSocketDataAfterClose) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "WebSocket outbound message validation shares fragmentation and UTF8 state" {
  let limits = websocket.default_limits()
  let handshake = websocket.close_handshake()
  match websocket.message_state().write(
    handshake,
    false,
    WebSocketText,
    bytes.from_str("Hel"),
    limits
  ) {
    Ok(fragmented) -> {
      match fragmented.pending() {
        Some(WebSocketTextMessage) -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
      match fragmented.write(
        handshake,
        true,
        WebSocketContinuation,
        bytes.from_str("lo"),
        limits
      ) {
        Ok(done) -> match done.pending() {
          None -> Test.assert_true(true)
          _ -> Test.assert_true(false)
        }
        _ -> Test.assert_true(false)
      }
      match fragmented.write(
        handshake,
        true,
        WebSocketBinary,
        bytes.from_str("x"),
        limits
      ) {
        Err(WebSocketInterleavedMessage) -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  match websocket.message_state().write(
    handshake,
    true,
    WebSocketText,
    ws_bytes_1(255),
    limits
  ) {
    Err(WebSocketInvalidText(offset)) -> Test.assert_eq(offset, 0)
    _ -> Test.assert_true(false)
  }
}
