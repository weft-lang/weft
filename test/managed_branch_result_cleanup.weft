use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/test.{*}
use stdlib/string.{*}

type BranchValue { BranchValue(i64, str) }

fn branch_value(number: i64) -> BranchValue { BranchValue(number, number.to_str()) }
fn branch_number(value: BranchValue) -> i64 {
  match value {
    BranchValue(7, text) if text == "7" -> 7
    BranchValue(9, text) if text == "9" -> 9
    BranchValue(11, text) if text == "11" -> 11
    _ -> -1000
  }
}

fn select_if(reuse: bool) -> BranchValue {
  let first = branch_value(7)
  if reuse { first } else { branch_value(11) }
}

fn select_match(choice: i64) -> BranchValue {
  let first = branch_value(7)
  match choice {
    0 -> first
    n if n < 0 -> first
    _ -> branch_value(11)
  }
}

fn select_initialized(seed: bool, reuse: bool) -> BranchValue {
  let first = if seed { branch_value(7) } else { branch_value(9) }
  if reuse { first } else { branch_value(11) }
}

fn select_mutable(reuse: bool) -> BranchValue {
  let mut first = branch_value(3)
  first = branch_value(7)
  if reuse { first } else { branch_value(11) }
}

fn select_array(reuse: bool) -> [str; 2] {
  let first = [7.to_str(), 9.to_str()]
  if reuse { first } else { [11.to_str(), 13.to_str()] }
}

fn array_sum(reuse: bool) -> i64 {
  let mut total = 0
  for text in select_array(reuse) {
    let value = match text {
      item if item == "7" -> 7
      item if item == "9" -> 9
      item if item == "11" -> 11
      item if item == "13" -> 13
      _ -> -1000
    }
    total = total + value
  }
  total
}

fn select_closure(reuse: bool) -> () -> i64 {
  let value = branch_value(7)
  let first = () => branch_number(value)
  if reuse { first } else {
    let alternate = branch_value(11)
    () => branch_number(alternate)
  }
}

fn select_nested(reuse: bool) -> BranchValue {
  let first = branch_value(7)
  let unused = branch_value(3)
  if reuse { first } else { branch_value(11) }
}

fn select_shadowed(reuse: bool) -> BranchValue {
  let first = branch_value(3)
  if reuse {
    let first = branch_value(7)
    first
  } else { branch_value(11) }
}

fn check_churn(expected: i64, sample: () -> i64) -[Test]> nil {
  Test.assert_eq(sample(), expected)
  for _ in 0..50 { sample() }
  let before = runtime_rc_test_heap_arena_offset()
  let mut total = 0
  for _ in 0..200 { total = total + sample() }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
  Test.assert_eq(total, expected * 200)
  nil
}

test "mixed if results release local and fresh alternatives with their children" {
  check_churn(7, () => branch_number(select_if(true)))
  check_churn(11, () => branch_number(select_if(false)))
}

test "mixed match results release guarded and fallback alternatives" {
  check_churn(7, () => branch_number(select_match(0)))
  check_churn(7, () => branch_number(select_match(-1)))
  check_churn(11, () => branch_number(select_match(1)))
}

test "mixed results clean up a binding initialized through control flow" {
  check_churn(7, () => branch_number(select_initialized(true, true)))
  check_churn(9, () => branch_number(select_initialized(false, true)))
  check_churn(11, () => branch_number(select_initialized(true, false)))
  check_churn(11, () => branch_number(select_initialized(false, false)))
}

test "mixed results release the current mutable slot after replacement" {
  check_churn(7, () => branch_number(select_mutable(true)))
  check_churn(11, () => branch_number(select_mutable(false)))
}

test "mixed fixed array results preserve backing and release managed elements" {
  check_churn(16, () => array_sum(true))
  check_churn(24, () => array_sum(false))
}

test "mixed closure results preserve and release captures" {
  check_churn(7, () => { let selected = select_closure(true); selected() })
  check_churn(11, () => { let selected = select_closure(false); selected() })
}

test "nested scopes and shadowed bindings preserve result ownership" {
  check_churn(7, () => branch_number(select_nested(true)))
  check_churn(11, () => branch_number(select_nested(false)))
  check_churn(7, () => branch_number(select_shadowed(true)))
  check_churn(11, () => branch_number(select_shadowed(false)))
}
