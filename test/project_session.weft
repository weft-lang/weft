use compiler/incremental.{*}
use compiler/project_session.{*}
use stdlib/diagnostic.{diagnostic_primary}
use stdlib/diagnostic_type.{*}
use stdlib/string.{str_concat}

fn project_test_overlay(identity: str, package_id: i64, options: i64, target: i64) -> ProjectQueryContext {
  project_query_context(package_id, identity, "", project_source_origin_overlay(), options, target)
}

fn project_test_workspace_overlay(identity: str, physical_path: str, overlay_set: str) -> ProjectQueryContext {
  project_query_context_with_overlay_set(1, identity, physical_path, project_source_origin_overlay(), 0, 1, overlay_set)
}

fn project_test_expect_success(result: ProjectCheckResult) -> i64 {
  match result {
    ProjectCheckSucceeded(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      if project_diagnostics_error_count(parse_diagnostics) == 0 and project_diagnostics_error_count(check_diagnostics) == 0 { 1 } else { 0 }
    }
    _ -> 0
  }
}

fn project_test_expect_failure(result: ProjectCheckResult) -> i64 {
  match result {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> 1
    ProjectCheckParseFailed(parse) -> 1
    _ -> 0
  }
}

test "project session reuses typed parse and check products" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://app/main.weft", 7, 0, 1)
  match project_session_set_source(session, context, "fn answer() -> i64 { 42 }") {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> Test.assert_eq(__str_len(content), 25)
    _ -> Test.assert_eq(0, 1)
  }

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
  Test.assert_eq(project_session_parse_depends_on_source(session, context), 1)
  Test.assert_eq(project_session_prepared_source_depends_on_parse(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_depends_on_prepared_source(session, context), 1)
  Test.assert_eq(project_session_check_depends_on_prepared_parse(session, context), 1)

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "unchanged project source preserves revision and cached products" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://same.weft", 1, 0, 1)
  let source = "fn value() -> i64 { 1 }"
  project_session_set_source(session, context, source)
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  let revision = incremental_database_revision(project_session_database(session))
  let invalidations = incremental_database_invalidation_count(project_session_database(session))

  match project_session_set_source(session, context, source) {
    IncrementalInputUnchanged(ProjectSourcePresent(cached)) -> Test.assert_eq(__str_ptr(cached), __str_ptr(source))
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(incremental_database_revision(project_session_database(session)), revision)
  Test.assert_eq(incremental_database_invalidation_count(project_session_database(session)), invalidations)
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "project edit invalidates only its reverse dependency closure" {
  let session = project_session_new(1)
  let left = project_test_overlay("overlay://left.weft", 1, 0, 1)
  let right = project_test_overlay("overlay://right.weft", 1, 0, 1)
  project_session_set_source(session, left, "fn left() -> i64 { 1 }")
  project_session_set_source(session, right, "fn right() -> i64 { 2 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, left)), 1)
  Test.assert_eq(project_test_expect_success(project_session_check(session, right)), 1)

  match project_session_set_source(session, left, "fn left() -> i64 { 3 }") {
    IncrementalInputChanged(ProjectSourcePresent(content)) -> Test.assert_eq(__str_len(content), 22)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_success(project_session_check(session, right)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, right), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, right), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, right), 1)
  Test.assert_eq(project_session_check_execution_count(session, right), 1)
  Test.assert_eq(project_test_expect_success(project_session_check(session, left)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, left), 2)
  Test.assert_eq(project_session_prepared_source_execution_count(session, left), 2)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, left), 2)
  Test.assert_eq(project_session_check_execution_count(session, left), 2)
}

test "typed check failures retain provenance and are cached" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://broken-type.weft", 1, 0, 1)
  let broken = "fn broken() -> i64 { \"wrong\" }"
  project_session_set_source(session, context, broken)
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      Test.assert_eq(source_n, __str_len(broken))
      Test.assert_eq(project_diagnostics_error_count(parse_diagnostics), 0)
      Test.assert_eq(project_diagnostics_error_count(check_diagnostics), 1)
      Test.assert_eq(if project_diagnostics_len(check_diagnostics) > 0 { 1 } else { 0 }, 1)
      Test.assert_eq(project_diagnostics_item_source_len(check_diagnostics, 0), source_n)
      Test.assert_eq(if project_diagnostics_item_type_table(check_diagnostics, 0) != 0 { 1 } else { 0 }, 1)
      Test.assert_eq(project_diagnostics_item_is_legacy(check_diagnostics, 0), false)
      let diagnostic = project_diagnostics_get(check_diagnostics, 0)
      match diagnostic_primary(diagnostic) {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> {
          Test.assert_eq(source, __str_ptr(broken))
          Test.assert_eq(if end > start { 1 } else { 0 }, 1)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> Test.assert_eq(project_diagnostics_error_count(check_diagnostics), 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_check_execution_count(session, context), 1)

  project_session_set_source(session, context, "fn fixed() -> i64 { 7 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
}

test "parse failures are cached and replaced after correction" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://broken-parse.weft", 1, 0, 1)
  project_session_set_source(session, context, "fn broken( {")
  match project_session_check(session, context) {
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) -> Test.assert_eq(if project_diagnostics_error_count(diagnostics) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, context) {
    ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, source_n, diagnostics)) -> Test.assert_eq(if project_diagnostics_len(diagnostics) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)

  project_session_set_source(session, context, "fn fixed() -> i64 { 9 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
}

test "test-bearing project sources reuse prepared parse and check products" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://tests.weft", 1, 0, 1)
  project_session_set_source(session, context, "test \"one\" { Test.assert_eq(1, 1) } test \"two\" { Test.assert_eq(2, 2) }")

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_depends_on_parse(session, context), 1)
  Test.assert_eq(project_session_prepared_source_depends_on_source(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_depends_on_prepared_source(session, context), 1)
  Test.assert_eq(project_session_check_depends_on_prepared_parse(session, context), 1)

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)

  project_session_set_source(session, context, "test \"edited\" { Test.assert_eq(3, 3) }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
}

test "test preparation failures cache and test-to-plain edits replace dependencies" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://test-edit.weft", 1, 0, 1)
  let broken = "test \"bad\" { Test.assert_true(2) }"
  project_session_set_source(session, context, broken)

  match project_session_check(session, context) {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      Test.assert_eq(if source_n > __str_len(broken) { 1 } else { 0 }, 1)
      Test.assert_eq(project_diagnostics_error_count(parse_diagnostics), 0)
      Test.assert_eq(if project_diagnostics_error_count(check_diagnostics) > 0 { 1 } else { 0 }, 1)
      Test.assert_eq(project_diagnostics_item_source_len(check_diagnostics, 0), source_n)
      Test.assert_eq(if project_diagnostics_item_source(check_diagnostics, 0) != __str_ptr(broken) { 1 } else { 0 }, 1)
      Test.assert_eq(if project_diagnostics_item_type_table(check_diagnostics, 0) != 0 { 1 } else { 0 }, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> Test.assert_eq(if project_diagnostics_len(check_diagnostics) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
  Test.assert_eq(project_session_prepared_source_depends_on_source(session, context), 1)

  project_session_set_source(session, context, "fn now_plain() -> i64 { 42 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_source_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
  Test.assert_eq(project_session_prepared_source_depends_on_source(session, context), 0)
}

test "project diagnostics retain legacy transport metadata" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://legacy-diagnostic.weft", 1, 0, 1)
  let source = "fn broken() -> i64 { 1.nope }"
  project_session_set_source(session, context, source)
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, source_n, parse_diagnostics, check_diagnostics) -> {
      Test.assert_eq(project_diagnostics_error_count(parse_diagnostics), 0)
      Test.assert_eq(if project_diagnostics_len(check_diagnostics) > 0 { 1 } else { 0 }, 1)
      Test.assert_eq(project_diagnostics_item_is_legacy(check_diagnostics, 0), true)
      Test.assert_eq(project_diagnostics_item_source(check_diagnostics, 0), __str_ptr(source))
      Test.assert_eq(project_diagnostics_item_source_len(check_diagnostics, 0), __str_len(source))
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "overlay membership and bytes invalidate their exact project dependents" {
  let session = project_session_new(1)
  let overlay_identity = "overlay-set://workspace"
  let root = project_test_workspace_overlay("overlay://workspace/root.weft", "project_session_overlay_root.weft", overlay_identity)
  let dependency = project_test_workspace_overlay(
    "overlay://workspace/dependency.weft",
    "module_fixtures/project_session_overlay_dependency.weft",
    overlay_identity
  )
  let late_mutation = project_test_workspace_overlay(
    "overlay://workspace/late.weft",
    "module_fixtures/project_session_overlay_late.weft",
    overlay_identity
  )
  let unrelated = project_test_overlay("overlay://unrelated.weft", 1, 0, 1)
  -- Split after `{` so the fixture's selective import is not interpolated by
  -- this outer test source before it reaches the project parser.
  let root_source = str_concat(
    "use module_fixtures/project_session_overlay_dependency.{",
    "answer} fn main() -> i64 { answer() }"
  )
  let dependency_source = "pub fn answer() -> i64 { 42 }"

  project_session_set_source(session, root, root_source)
  project_session_set_source(session, dependency, dependency_source)
  project_session_set_source(session, unrelated, "fn unrelated() -> i64 { 7 }")
  let initial = project_overlay_set_new()
  project_overlay_set_add(initial, root)
  project_overlay_set_add(initial, dependency)
  match project_session_set_overlay_set(session, root, initial) {
    IncrementalInputInserted(overlays) -> Test.assert_eq(project_overlay_set_len(overlays), 2)
    _ -> Test.assert_eq(0, 1)
  }
  -- The session owns an immutable snapshot, not the caller's mutable builder.
  project_overlay_set_add(initial, late_mutation)
  project_overlay_set_add(initial, dependency)
  Test.assert_eq(project_overlay_set_len(initial), 3)

  Test.assert_eq(project_test_expect_success(project_session_check(session, root)), 1)
  Test.assert_eq(project_test_expect_success(project_session_check(session, unrelated)), 1)
  Test.assert_eq(project_session_parse_depends_on_overlay_set(session, root), 1)
  Test.assert_eq(project_session_parse_depends_on_overlay_source(session, root, dependency), 1)
  Test.assert_eq(project_session_parse_execution_count(session, root), 1)

  let same = project_overlay_set_new()
  project_overlay_set_add(same, dependency)
  project_overlay_set_add(same, root)
  match project_session_set_overlay_set(session, root, same) {
    IncrementalInputUnchanged(overlays) -> Test.assert_eq(project_overlay_set_len(overlays), 2)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_success(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, root), 1)

  project_session_set_source(session, dependency, "pub fn renamed() -> i64 { 0 }")
  Test.assert_eq(project_test_expect_failure(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, root), 2)
  Test.assert_eq(project_session_check_execution_count(session, unrelated), 1)

  project_session_set_source(session, dependency, dependency_source)
  Test.assert_eq(project_test_expect_success(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, root), 3)

  let without_dependency = project_overlay_set_new()
  project_overlay_set_add(without_dependency, root)
  match project_session_set_overlay_set(session, root, without_dependency) {
    IncrementalInputChanged(overlays) -> Test.assert_eq(project_overlay_set_len(overlays), 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_failure(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_depends_on_overlay_source(session, root, dependency), 0)
  let executions_without_dependency = project_session_parse_execution_count(session, root)
  project_session_set_source(session, dependency, "pub fn answer() -> i64 { 99 }")
  Test.assert_eq(project_test_expect_failure(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, root), executions_without_dependency)

  let restored = project_overlay_set_new()
  project_overlay_set_add(restored, root)
  project_overlay_set_add(restored, dependency)
  project_session_set_overlay_set(session, root, restored)
  Test.assert_eq(project_test_expect_success(project_session_check(session, root)), 1)
  Test.assert_eq(project_session_parse_depends_on_overlay_source(session, root, dependency), 1)
}

test "overlay contexts fail closed until membership is installed" {
  let session = project_session_new(1)
  let context = project_test_workspace_overlay("overlay://unset/root.weft", "unset_root.weft", "overlay-set://unset")
  project_session_set_source(session, context, "fn main() -> i64 { 42 }")
  match project_session_check(session, context) {
    ProjectCheckCorrupt -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  let empty = project_overlay_set_new()
  project_session_set_overlay_set(session, context, empty)
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)

  let other_overlay_identity = project_test_workspace_overlay(
    "overlay://unset/root.weft",
    "unset_root.weft",
    "overlay-set://other"
  )
  Test.assert_eq(
    if not incremental_query_key_equal(project_session_check_key(session, context), project_session_check_key(session, other_overlay_identity)) { 1 } else { 0 },
    1
  )
  Test.assert_eq(
    if incremental_query_key_equal(project_session_source_key(session, context), project_session_source_key(session, other_overlay_identity)) { 1 } else { 0 },
    1
  )
}

test "missing and empty sources have distinct exact fingerprints" {
  let session = project_session_new(1)
  let disk = project_query_context(1, "disk://missing.weft", "test/fixtures/project-session-does-not-exist.weft", project_source_origin_disk(), 0, 1)
  match project_session_refresh_disk_source(session, disk) {
    IncrementalInputInserted(ProjectSourceMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, disk) {
    ProjectCheckSourceUnset -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_refresh_disk_source(session, disk) {
    IncrementalInputUnchanged(ProjectSourceMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_check_execution_count(session, disk), 1)

  let empty = project_test_overlay("overlay://empty.weft", 1, 0, 1)
  project_session_set_source(session, empty, "")
  Test.assert_eq(project_test_expect_success(project_session_check(session, empty)), 1)
}

test "disk acquisition feeds the same typed session pipeline" {
  let session = project_session_new(1)
  let context = project_query_context(1, "workspace://fixture.weft", "test/fixtures/project_session_source.txt", project_source_origin_disk(), 0, 1)
  match project_session_refresh_disk_source(session, context) {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> Test.assert_eq(if __str_len(content) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  match project_session_refresh_disk_source(session, context) {
    IncrementalInputUnchanged(ProjectSourcePresent(content)) -> Test.assert_eq(if __str_len(content) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "package options target and source origin remain isolated" {
  let session = project_session_new(1)
  let a = project_test_overlay("source://same.weft", 1, 0, 1)
  let package_b = project_test_overlay("source://same.weft", 2, 0, 1)
  let options_b = project_test_overlay("source://same.weft", 1, 1, 1)
  let target_b = project_test_overlay("source://same.weft", 1, 0, 2)
  let disk = project_query_context(1, "source://same.weft", "", project_source_origin_disk(), 0, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, package_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, options_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, target_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, disk)) { 1 } else { 0 }, 1)
}
