type DetachedProjectProduct<T> {
  product: T,
  source: i64,
  source_len: i64,
  dependency: i64,
  dependency_len: i64
}

-- Return only the selected product and byte views, never the session,
-- diagnostics, snapshots, or original managed source bindings.
fn project_test_detached<T>(
  select: (ProjectSession, ProjectQueryContext) -> Option<T>
) -> Option<DetachedProjectProduct<T>> {
  let session = project_session_new(1)
  let root = project_test_workspace_overlay("retained_root", "retained_root.weft", "retained")
  let dependency = project_test_workspace_overlay(
    "module_fixtures/retained_dependency",
    "module_fixtures/retained_dependency.weft",
    "retained"
  )
  let root_text = str_concat(
    "use module_fixtures/retained_dependency.{ retained_answer } ",
    "fn main() -> i64 { retained_answer() }"
  )
  let dependency_text = str_concat("pub fn retained_answer() -> i64 ", "{ 42 }")
  let installed_root = match project_session_set_source(session, root, root_text) {
    IncrementalInputInserted(ProjectSourcePresent(text)) -> text
    _ -> ""
  }
  let installed_dependency = match project_session_set_source(
    session,
    dependency,
    dependency_text
  ) {
    IncrementalInputInserted(ProjectSourcePresent(text)) -> text
    _ -> ""
  }
  let overlays = project_overlay_set_new()
  project_overlay_set_add(overlays, root)
  project_overlay_set_add(overlays, dependency)
  project_session_set_overlay_set(session, root, overlays)
  match select(session, root) {
    Some(product) -> Some(
      DetachedProjectProduct {
        product: product,
        source: __str_ptr(installed_root),
        source_len: __str_len(installed_root),
        dependency: __str_ptr(installed_dependency),
        dependency_len: __str_len(installed_dependency)
      }
    )
    None -> None<DetachedProjectProduct<T>>()
  }
}

fn project_test_assert_detached<T>(
  detached: DetachedProjectProduct<T>
) -[Test]> DetachedProjectProduct<T> {
  -- Occupy the same string allocation sizes with different contents. A freed
  -- source must not pass simply because its old bytes remain undisturbed.
  let replacement = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  let mut churn = vector.new<str>()
  for i in 0..256 {
    churn.push(runtime_str_from_bytes_copy(__str_ptr(replacement), detached.source_len))
    churn.push(runtime_str_from_bytes_copy(__str_ptr(replacement), detached.dependency_len))
  }
  Test.assert_str_eq(
    runtime_str_from_bytes_copy(detached.source, detached.source_len),
    "use module_fixtures/retained_dependency.{ retained_answer } fn main() -> i64 { retained_answer() }"
  )
  Test.assert_str_eq(
    runtime_str_from_bytes_copy(detached.dependency, detached.dependency_len),
    "pub fn retained_answer() -> i64 { 42 }"
  )
  Test.assert_eq_usize(churn.len(), 512)
  detached
}

fn project_test_detached_check(
  session: ProjectSession,
  context: ProjectQueryContext
) -> Option<TypedModule> {
  match project_session_check(session, context) {
    ProjectCheckSucceeded(typed, _, _, _) -> Some(typed)
    _ -> None<TypedModule>()
  }
}

fn project_test_detached_typed_program(
  session: ProjectSession,
  context: ProjectQueryContext
) -> Option<CheckedProgram> {
  match project_session_parse(session, context) {
    ProjectParseSucceeded(ast, _, _) -> match ast {
      AstModule(_, source, table, _, (_, registrations)) -> {
        let entry_source = ttable_program_entry_source_or(table, source)
        match registration_scope_find_source(registrations, entry_source) {
          None -> None<CheckedProgram>()
          Some(root) -> match check_registered_program(
            root.identity,
            registrations,
            ttable_sdk_package_id(table)
          ) {
            CheckedProgramAccepted(program) -> Some(program)
            _ -> None<CheckedProgram>()
          }
        }
      }
    }
    _ -> None<CheckedProgram>()
  }
}

fn project_test_type_issue(issue: SemanticTypeResolutionIssue) -> str {
  match issue {
    SemanticInvalidPrimitive(_) -> "invalid primitive"
    SemanticInvalidVariable(_) -> "invalid variable"
    SemanticInvalidArrayLength(_) -> "invalid array length"
    SemanticMissingAuthoredType -> "missing authored type"
    SemanticExpectedRecordField -> "expected record field"
    SemanticInvalidRecordFieldRange(_) -> "invalid record field range"
    SemanticTypeArgumentCount(_, _) -> "type argument count"
    SemanticDefinitionExpansionRequired(_) -> "definition expansion required"
    SemanticRecursiveTypeDefinition(_) -> "recursive type definition"
    SemanticInternalOwnershipRequiresAuthority -> "internal ownership requires authority"
    SemanticDeclarationResolutionRequired -> "declaration resolution required"
    SemanticUnsupportedAuthoredType(_) -> "unsupported authored type"
  }
}

fn project_test_resolution_issue(issue: SemanticResolutionIssue) -> str {
  match issue {
    SemanticSignatureResolutionIssue(function, type_issue) -> str_concat(
      str_concat("signature for ", project_test_function_name(function)),
      str_concat(": ", project_test_type_issue(type_issue))
    )
    SemanticDeclarationResolutionIssue(_, type_issue) ->
      str_concat("declaration: ", project_test_type_issue(type_issue))
    SemanticEffectDeclarationResolutionIssue(_) -> "effect declaration"
    SemanticMethodDeclarationResolutionIssue(method_issue) ->
      project_test_method_issue(method_issue)
  }
}

fn project_test_method_issue(issue: SemanticMethodResolutionIssue) -> str {
  match issue {
    SemanticTraitMethodTypeRejected(_, type_issue) ->
      str_concat("trait method: ", project_test_type_issue(type_issue))
    SemanticImplementationTargetRejected(_, type_issue) ->
      str_concat("implementation target: ", project_test_type_issue(type_issue))
    SemanticImplementationTraitRejected(_, type_issue) ->
      str_concat("implementation trait: ", project_test_type_issue(type_issue))
    SemanticImplementationBoundRejected(_, type_issue) ->
      str_concat("implementation bound: ", project_test_type_issue(type_issue))
    SemanticImplementationMethodMissing(function, location) -> {
      let name = match location {
        Some(span) -> match span.text() {
          Some(spelling) -> spelling
          None -> project_test_function_name(function)
        }
        None -> project_test_function_name(function)
      }
      str_concat("implementation method missing: ", name)
    }
    SemanticImplementationMethodTypeRejected(_, type_issue) ->
      str_concat("implementation method: ", project_test_type_issue(type_issue))
    SemanticImplementationTraitContractMissing(_) -> "trait contract missing"
    SemanticImplementationRequiredMethodMissing(method) -> {
      let name_span = declaration_identity_name(method)
      let name = match name_span.text() {
        Some(spelling) -> spelling
        None -> "invalid name"
      }
      str_concat("required method missing: ", name)
    }
  }
}

fn project_test_range_text(source: Source, range: CheckedSourceRange) -> str {
  match source.span(range.start, range.end) {
    Some(span) -> match span.text() {
      Some(spelling) -> spelling
      None -> "unavailable span"
    }
    None -> "invalid span"
  }
}

fn project_test_type_node_name(node: Option<SemanticTypeNode>) -> str {
  match node {
    None -> "missing type graph"
    Some(SemanticBottomNode) -> "bottom type"
    Some(SemanticTopNode) -> "top type"
    Some(SemanticPrimitiveNode(_)) -> "primitive type"
    Some(SemanticUnionNode(_, _)) -> "union type"
    Some(SemanticIntersectionNode(_, _)) -> "intersection type"
    Some(SemanticComplementNode(_)) -> "complement type"
    Some(SemanticContinuationNode(_, _)) -> "continuation type"
    Some(SemanticWeakNode(_)) -> "weak type"
    Some(SemanticRcNode(_)) -> "rc type"
    Some(SemanticAtomicNode(_)) -> "atomic type"
    Some(SemanticNamedNode(_, _, _, _)) -> "named type"
    Some(SemanticOwnedNode(_)) -> "owned type"
    Some(SemanticUniqueNode(_)) -> "unique type"
    Some(SemanticPointerNode(_, _)) -> "pointer type"
    Some(SemanticBorrowNode(_, _)) -> "borrow type"
    Some(SemanticSliceNode(_, _)) -> "slice type"
    Some(SemanticArrayNode(_, _)) -> "array type"
    Some(SemanticFunctionNode(_, _, _)) -> "function type"
    Some(SemanticEffectAtomNode(_, _)) -> "effect atom type"
    Some(SemanticEffectSignatureNode(_, _)) -> "effect signature type"
    Some(SemanticRecordNode(_, _, _)) -> "record type"
    Some(SemanticVariantNode(_, _)) -> "variant type"
    Some(SemanticVariableNode(SemanticSelfVariable)) -> "Self variable"
    Some(SemanticVariableNode(_)) -> "type variable"
    Some(SemanticTraitNode(_, _)) -> "trait type"
    Some(SemanticAssociatedNode(_, _)) -> "associated type"
  }
}

fn project_test_catalog_type_name(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> str {
  match catalog.graph_for(id) {
    Some(graph) -> project_test_type_node_name(Some(semantic_type_graph_node(graph, id)))
    None -> "derived type outside resolution catalog"
  }
}

fn project_test_freeze_issue(issue: CheckedBodyProductIssue, source: Source) -> str {
  match issue {
    CheckedBodyBorrowCannotEscape(_) -> "borrow cannot escape"
    CheckedBodyBorrowAggregateCannotEscape(escape) -> str_concat(
      "aggregate borrow cannot escape: ",
      project_test_range_text(source, escape.range)
    )
    CheckedBodyBorrowFactInconsistent(_) -> "borrow fact inconsistent"
    CheckedBodyBorrowInvalidOrigin(_) -> "borrow invalid origin"
    CheckedBodyBorrowViewMissing(_) -> "borrow view missing"
    CheckedBodyBorrowViewTypeMismatch(_) -> "borrow view type mismatch"
    CheckedBodyFunctionRootOutOfOrder(_) -> "root out of order"
    CheckedBodyUnownedExpression(_) -> "unowned expression"
    _ -> "other freeze issue"
  }
}

fn project_test_body_producer_issue(issue: CheckedBodyProducerIssue, source: Source) -> str {
  match issue {
    CheckedBodyProducerTypeRejected(type_issue) -> project_test_type_issue(type_issue)
    CheckedBodyProducerInvalidRange -> "invalid range"
    CheckedBodyProducerUnknownIdentifier(range) -> str_concat(
      "unknown identifier: ",
      project_test_range_text(source, range)
    )
    CheckedBodyProducerUnknownField(range) -> str_concat(
      "unknown field: ",
      project_test_range_text(source, range)
    )
    CheckedBodyProducerImmutableAssignment(_) -> "immutable assignment"
    CheckedBodyProducerPointerSealed -> "pointer sealed"
    CheckedBodyProducerUnsafeEffectUnavailable -> "Unsafe effect unavailable"
    CheckedBodyProducerPointerBindingRequired -> "pointer binding required"
    CheckedBodyProducerMutablePointerBindingRequired(_) -> "mutable pointer binding required"
    CheckedBodyProducerPointerTypeRequired(_) -> "pointer type required"
    CheckedBodyProducerMutablePointerRequired(_) -> "mutable pointer required"
    CheckedBodyProducerInferredBranchMismatch(_, _, range) -> str_concat(
      "branch mismatch at ",
      project_test_range_text(source, range)
    )
    CheckedBodyProducerArityMismatch(_, _) -> "arity mismatch"
    CheckedBodyProducerBreakOutsideLoop -> "break outside loop"
    CheckedBodyProducerContinueOutsideLoop -> "continue outside loop"
    CheckedBodyProducerGenericBoundRejected(_, _) -> "generic bound"
    CheckedBodyProducerCallableRequired(_) -> "callable required"
    CheckedBodyProducerBinaryOperandMismatch(_, _) -> "binary operand mismatch"
    CheckedBodyProducerIntegerOperandRequired(_) -> "integer operand required"
    CheckedBodyProducerNumericOperandRequired(_) -> "numeric operand required"
    CheckedBodyProducerInvalidFloatLiteral(_) -> "invalid float literal"
    CheckedBodyProducerNonExhaustiveMatch -> "non-exhaustive match"
    CheckedBodyProducerCanonicalEqUnavailable -> "canonical Eq unavailable"
    CheckedBodyProducerCanonicalEqInvalid(_) -> "canonical Eq invalid"
    CheckedBodyProducerEqImplementationRequired(_) -> "Eq implementation required"
    CheckedBodyProducerCanonicalOrdUnavailable -> "canonical Ord unavailable"
    CheckedBodyProducerCanonicalOrdInvalid(_) -> "canonical Ord invalid"
    CheckedBodyProducerOrdImplementationRequired(_) -> "Ord implementation required"
    CheckedBodyProducerOrderingCaseUnavailable(_) -> "ordering case unavailable"
    CheckedBodyProducerCanonicalDisplayUnavailable -> "canonical Display unavailable"
    CheckedBodyProducerCanonicalDisplayInvalid(_) -> "canonical Display invalid"
    CheckedBodyProducerDisplayImplementationRequired(_) -> "Display implementation required"
    CheckedBodyProducerCanonicalResultUnavailable -> "canonical Result unavailable"
    CheckedBodyProducerCanonicalFailUnavailable -> "canonical Fail unavailable"
    CheckedBodyProducerUnknownMethod(_) -> "unknown method"
    CheckedBodyProducerSignatureUnavailable(_) -> "signature unavailable"
    CheckedBodyProducerEffectUnavailable(_, range) -> str_concat(
      "effect unavailable at ",
      project_test_range_text(source, range)
    )
    CheckedBodyProducerEffectTailUnavailable(_) -> "effect tail unavailable"
    CheckedBodyProducerGenericDeclarationRequired(_) -> "generic declaration required"
    CheckedBodyProducerLambdaContextRequired(_) -> "lambda context required"
    CheckedBodyProducerLambdaCaptureUnsupported(_) -> "lambda capture unsupported"
    CheckedBodyProducerResultOperandRequired(_) -> "result operand required"
    CheckedBodyProducerTryEffectUnavailable(_) -> "try effect unavailable"
    CheckedBodyProducerOptionalBaseRequired(_) -> "optional base required"
    CheckedBodyProducerMaybeEffectUnavailable -> "Maybe effect unavailable"
    CheckedBodyProducerFieldProjectionUnavailable(_) -> "field projection unavailable"
    CheckedBodyProducerIndexedBaseRequired(_) -> "indexed base required"
    CheckedBodyProducerIterableRequired(_) -> "iterable required"
    CheckedBodyProducerIndexedNamedBindingRequired(_) -> "indexed named binding required"
    CheckedBodyProducerEffectReferenceRequired -> "effect reference required"
    CheckedBodyProducerAmbiguousMethod(_) -> "ambiguous method"
    CheckedBodyProducerUnknownEffectOperation(_) -> "unknown effect operation"
    CheckedBodyProducerAmbiguousEffectApplication(_) -> "ambiguous effect application"
    CheckedBodyProducerHandlerCallRejected(_) -> "handler call rejected"
    CheckedBodyProducerHandlerConstructorRejected(_) -> "handler constructor rejected"
    CheckedBodyProducerDuplicateHandlerClause(_) -> "duplicate handler clause"
    CheckedBodyProducerMissingHandlerClause(_) -> "missing handler clause"
    CheckedBodyProducerHandlerEffectMismatch(_, _) -> "handler effect mismatch"
    CheckedBodyProducerHandlerContinuationRequiresDeferred ->
      "handler continuation requires deferred"
    CheckedBodyProducerResumeOutsideHandler -> "resume outside handler"
    CheckedBodyProducerBodyLocalTypeUnavailable(_) -> "body local type unavailable"
    CheckedBodyProducerUnsupportedPattern -> "unsupported pattern"
    CheckedBodyProducerUnsupportedBinaryOperator(_) -> "unsupported binary operator"
    CheckedBodyProducerUnsupportedMatchArm -> "unsupported match arm"
    CheckedBodyProducerTuplePatternRequired(_) -> "tuple pattern required"
    CheckedBodyProducerTuplePatternArityMismatch(_, _) -> "tuple pattern arity"
    CheckedBodyProducerRecordPatternRequired(_) -> "record pattern required"
    CheckedBodyProducerDuplicateRecordPatternField(_) -> "duplicate record pattern field"
    CheckedBodyProducerDuplicateRecordField(_) -> "duplicate record field"
    CheckedBodyProducerUnknownRecordType(_) -> "unknown record type"
    CheckedBodyProducerNotRecordType(_) -> "not record type"
    CheckedBodyProducerRecordTemplateUnavailable(_) -> "record template unavailable"
    CheckedBodyProducerRecordTemplateAmbiguous(_) -> "record template ambiguous"
    CheckedBodyProducerRecordArgumentsUnresolved(_) -> "record arguments unresolved"
    CheckedBodyProducerMissingRecordField(_) -> "missing record field"
    CheckedBodyProducerRecordUpdateRequired(_) -> "record update required"
    CheckedBodyProducerGenericInferenceIncomplete(range) -> str_concat(
      "generic inference incomplete at ",
      project_test_range_text(source, range)
    )
    CheckedBodyProducerConstructorResultRequired(_) -> "constructor result required"
    CheckedBodyProducerConstructorResultAmbiguous(_) -> "constructor result ambiguous"
    CheckedBodyProducerConstructorArityMismatch(_, _) -> "constructor arity mismatch"
    CheckedBodyProducerVariantPatternRequired(_, range, node) -> str_concat(
      "variant pattern required at ",
      str_concat(
        project_test_range_text(source, range),
        str_concat(" on ", project_test_type_node_name(node))
      )
    )
    CheckedBodyProducerUnknownConstructor(_) -> "unknown constructor"
    CheckedBodyProducerTypeMismatch(_, _) -> "type mismatch"
    CheckedBodyProducerUnsupportedExpression -> "unsupported expression"
    CheckedBodyProducerFreezeRejected(freeze_issue) -> str_concat(
      "freeze: ",
      project_test_freeze_issue(freeze_issue, source)
    )
    CheckedBodyProducerContinuationConsumerRequired(_) -> "continuation consumer required"
    CheckedBodyProducerContinuationResultRequired(_) -> "continuation result required"
    CheckedBodyProducerContinuationBranchEscape(_) -> "continuation branch escape"
    CheckedBodyProducerContinuationMutableBinding(_) -> "continuation mutable binding"
    CheckedBodyProducerEffectApplicationUnavailable -> "effect application unavailable"
    CheckedBodyProducerHandlerClauseRequired -> "handler clause required"
    CheckedBodyProducerUnsupportedParameter -> "unsupported parameter"
    CheckedBodyProducerIteratorResultRequired(_) -> "iterator result required"
    CheckedBodyProducerIteratorItemInvalid(_) -> "iterator item invalid"
    CheckedBodyProducerIteratorItemUnresolved(_) -> "iterator item unresolved"
    CheckedBodyProducerIteratorNextRequired(_) -> "iterator next required"
    CheckedBodyProducerIteratorOptionRequired(_) -> "iterator Option required"
    CheckedBodyProducerIteratorOptionCaseRequired(_) -> "iterator Option case required"
    CheckedBodyProducerIteratorOptionItemMismatch(_) -> "iterator Option item mismatch"
    CheckedBodyProducerIteratorOptionPayloadMismatch(_) -> "iterator Option payload mismatch"
    CheckedBodyProducerConstructorPatternArityMismatch(_, _) -> "constructor pattern arity"
    _ -> "other body issue"
  }
}

fn project_test_body_issue(issue: CheckedModuleInstallerIssue, source: Source) -> str {
  match issue {
    CheckedModuleOrdinaryRejected(function, body_issue) -> str_concat(
      project_test_function_name(function),
      str_concat(": ", project_test_body_producer_issue(body_issue, source))
    )
    CheckedModuleInstallBodyRejected(_, body_issue) ->
      str_concat("handler body: ", project_test_body_producer_issue(body_issue, source))
    CheckedModuleInstallSelectionRejected(_) -> "handler selection"
    CheckedModuleInstallTemplateRejected(_, _) -> "handler template"
    CheckedModuleInstallContractRejected(_, _) -> "handler contract"
    CheckedModuleInstallSpecializationRejected(_, _) -> "handler specialization"
    CheckedModuleInstallCompositionRejected(_) -> "handler composition"
    _ -> "other installer issue"
  }
}

fn project_test_module_name(identity: ModuleIdentity) -> str {
  match identity {
    NamedModuleIdentity(path, _) -> path
    AnonymousModuleIdentity(_, _) -> "anonymous module"
  }
}

fn project_test_function_name(identity: FunctionIdentity) -> str {
  match identity {
    DeclaredFunctionIdentity(declaration) -> {
      let module = declaration_identity_module(declaration)
      let path = project_test_module_name(module)
      let name_span = declaration_identity_name(declaration)
      let spelling = match name_span.text() {
        Some(name) -> name
        None -> "invalid name"
      }
      str_concat(str_concat(path, "."), spelling)
    }
    ModuleFunctionIdentity(module, ordinal) -> str_concat(
      str_concat(project_test_module_name(module), ".<synthetic "),
      str_concat(int_to_str(__u64_to_i64(__usize_to_u64(ordinal))), ">")
    )
    IntrinsicFunctionIdentity(module, _) ->
      str_concat(project_test_module_name(module), ".<intrinsic>")
  }
}

fn project_test_typed_sdk_grammar(module_path: str) -> str {
  let session = project_session_new(1)
  let context = project_query_context(
    0,
    "app/typed_grammar.weft",
    "app/typed_grammar.weft",
    project_source_origin_disk(),
    0,
    1
  )
  let prefix = str_concat("use ", module_path)
  project_session_set_source(
    session,
    context,
    str_concat(prefix, " as guest fn main() -> i64 { 0 }")
  )
  match source_acquire_with_checkout(
    ".",
    () => project_session_parse_with_acquire(session, context)
  ) {
    ProjectParseSucceeded(ast, _, _) -> match ast {
      AstModule(_, source, table, _, (_, registrations)) -> {
        let sdk_package = ttable_sdk_package_id(table)
        match registration_scope_find_source(registrations, source) {
          Some(root) -> match check_registered_program(
            root.identity,
            registrations,
            sdk_package
          ) {
            CheckedProgramAccepted(program) -> if program.module_count() >= 2 {
              str_concat(
                "accepted\n",
                str_concat(
                  checked_lowering_coverage_report(
                    checked_program_lowering_coverage(program)
                  ),
                  str_concat(
                    "\nattempts\n",
                    checked_lowering_attempt_coverage_report(
                      checked_program_lowering_attempt_coverage(program)
                    )
                  )
                )
              )
            } else { "accepted with missing import" }
            CheckedProgramRootMissing -> "root missing"
            CheckedProgramImportTargetMissing(_) -> "import target missing"
            CheckedProgramScopeRejected(_) -> "scope rejected"
            CheckedProgramDuplicateModule(_) -> "duplicate module"
            CheckedProgramModuleResolutionRejected(identity, issue) -> {
              let name = project_test_module_name(identity)
              let detail = project_test_resolution_issue(issue)
              str_concat(str_concat("resolution in ", name), str_concat(": ", detail))
            }
            CheckedProgramModuleBodyRejected(identity, issue) -> {
              let failing = registration_scope_find(registrations, identity).unwrap()
              str_concat(
                str_concat("body in ", project_test_module_name(identity)),
                str_concat(": ", project_test_body_issue(issue, failing.source))
              )
            }
            CheckedProgramModuleSegmentMismatch(_) -> "module segment mismatch"
            CheckedProgramEntrypointRejected(_, _) -> "entrypoint rejected"
          }
          None -> "root registration missing"
        }
      }
    }
    _ -> "parse failed"
  }
}

-- Check one selected module against the shared closure signatures. This keeps
-- parity diagnostics fast even when an unrelated imported body is still open.
pub(package) fn project_test_typed_sdk_module_audit(module_path: str) -> str {
  let session = project_session_new(1)
  let context = project_query_context(
    0,
    "app/typed_grammar.weft",
    "app/typed_grammar.weft",
    project_source_origin_disk(),
    0,
    1
  )
  project_session_set_source(
    session,
    context,
    str_concat(str_concat("use ", module_path), " as guest fn main() -> i64 { 0 }")
  )
  match source_acquire_with_checkout(
    ".",
    () => project_session_parse_with_acquire(session, context)
  ) {
    ProjectParseSucceeded(AstModule(_, source, table, _, (_, registrations)), _, _) -> {
      let sdk_package = ttable_sdk_package_id(table)
      match registration_scope_find_source(registrations, source) {
        None -> "root registration missing"
        Some(root) -> match resolve_module_semantics(root, registrations) {
          SemanticResolutionRejected(issue) -> str_concat(
            "root resolution: ",
            project_test_resolution_issue(issue)
          )
          SemanticResolutionAccepted(shared) -> {
            let mut index: usize = 0
            let mut failures = ""
            while index < registration_scope_len(registrations) {
              let selected = registration_scope_at(
                registrations,
                __u64_to_i64(__usize_to_u64(index))
              )
              let resolved = if module_identity_eq(selected.identity, root.identity) {
                SemanticResolutionAccepted(shared)
              } else {
                resolve_module_semantics_with_shared(
                  selected,
                  registrations,
                  shared
                )
              }
              let detail = match resolved {
                SemanticResolutionRejected(issue) -> str_concat(
                  "resolution: ",
                  project_test_resolution_issue(issue)
                )
                SemanticResolutionAccepted(resolution) -> {
                  let catalog = resolution.catalog()
                  match check_registered_module_with_resolution(
                    selected,
                    registrations,
                    resolution,
                    sdk_package
                  ) {
                    CheckedModuleAccepted(_) -> "accepted"
                    CheckedModuleBodyRejected(issue) -> match issue {
                      CheckedModuleOrdinaryRejected(function, body_issue) -> str_concat(
                        project_test_function_name(function),
                        str_concat(
                          ": ",
                          match body_issue {
                            CheckedBodyProducerTypeMismatch(actual, expected) -> str_concat(
                              "type mismatch: ",
                              str_concat(
                                project_test_catalog_type_name(catalog, actual),
                                str_concat(
                                  " to ",
                                  project_test_catalog_type_name(catalog, expected)
                                )
                              )
                            )
                            _ -> project_test_body_producer_issue(body_issue, selected.source)
                          }
                        )
                      )
                      _ -> project_test_body_issue(issue, selected.source)
                    }
                    CheckedModuleResolutionRejected(issue) -> str_concat(
                      "resolution: ",
                      project_test_resolution_issue(issue)
                    )
                    CheckedModuleSegmentMismatch -> "segment mismatch"
                  }
                }
              }
              if detail != "accepted" {
                failures = str_concat(
                  failures,
                  str_concat(
                    project_test_module_name(selected.identity),
                    str_concat(": ", str_concat(detail, "\n"))
                  )
                )
              }
              index = index + 1
            }
            if failures == "" { "accepted" } else { failures }
          }
        }
      }
    }
    _ -> "parse failed"
  }
}

