use compiler/incremental.{*}
use compiler/project_session.{*}
use stdlib/diagnostic.{diagnostic_primary}
use stdlib/diagnostic_type.{*}

fn project_test_overlay(identity: str, package_id: i64, options: i64, target: i64) -> ProjectQueryContext {
  project_query_context(package_id, identity, "", project_source_origin_overlay(), options, target)
}

fn project_test_expect_success(result: ProjectCheckResult) -> i64 {
  match result {
    ProjectCheckSucceeded(typed, parse_diagnostics, check_diagnostics) -> {
      if project_diagnostics_error_count(parse_diagnostics) == 0 and project_diagnostics_error_count(check_diagnostics) == 0 { 1 } else { 0 }
    }
    _ -> 0
  }
}

test "project session reuses typed parse and check products" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://app/main.weft", 7, 0, 1)
  match project_session_set_source(session, context, "fn answer() -> i64 { 42 }") {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> Test.assert_eq(__str_len(content), 25)
    _ -> Test.assert_eq(0, 1)
  }

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
  Test.assert_eq(project_session_parse_depends_on_source(session, context), 1)
  Test.assert_eq(project_session_check_depends_on_parse(session, context), 1)

  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "unchanged project source preserves revision and cached products" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://same.weft", 1, 0, 1)
  let source = "fn value() -> i64 { 1 }"
  project_session_set_source(session, context, source)
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  let revision = incremental_database_revision(project_session_database(session))
  let invalidations = incremental_database_invalidation_count(project_session_database(session))

  match project_session_set_source(session, context, source) {
    IncrementalInputUnchanged(ProjectSourcePresent(cached)) -> Test.assert_eq(__str_ptr(cached), __str_ptr(source))
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(incremental_database_revision(project_session_database(session)), revision)
  Test.assert_eq(incremental_database_invalidation_count(project_session_database(session)), invalidations)
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "project edit invalidates only its reverse dependency closure" {
  let session = project_session_new(1)
  let left = project_test_overlay("overlay://left.weft", 1, 0, 1)
  let right = project_test_overlay("overlay://right.weft", 1, 0, 1)
  project_session_set_source(session, left, "fn left() -> i64 { 1 }")
  project_session_set_source(session, right, "fn right() -> i64 { 2 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, left)), 1)
  Test.assert_eq(project_test_expect_success(project_session_check(session, right)), 1)

  match project_session_set_source(session, left, "fn left() -> i64 { 3 }") {
    IncrementalInputChanged(ProjectSourcePresent(content)) -> Test.assert_eq(__str_len(content), 22)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_success(project_session_check(session, right)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, right), 1)
  Test.assert_eq(project_session_check_execution_count(session, right), 1)
  Test.assert_eq(project_test_expect_success(project_session_check(session, left)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, left), 2)
  Test.assert_eq(project_session_check_execution_count(session, left), 2)
}

test "typed check failures retain provenance and are cached" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://broken-type.weft", 1, 0, 1)
  let broken = "fn broken() -> i64 { \"wrong\" }"
  project_session_set_source(session, context, broken)
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, parse_diagnostics, check_diagnostics) -> {
      Test.assert_eq(project_diagnostics_error_count(parse_diagnostics), 0)
      Test.assert_eq(project_diagnostics_error_count(check_diagnostics), 1)
      Test.assert_eq(if project_diagnostics_len(check_diagnostics) > 0 { 1 } else { 0 }, 1)
      let diagnostic = project_diagnostics_get(check_diagnostics, 0)
      match diagnostic_primary(diagnostic) {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> {
          Test.assert_eq(source, __str_ptr(broken))
          Test.assert_eq(if end > start { 1 } else { 0 }, 1)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, context) {
    ProjectCheckFailed(typed, parse_diagnostics, check_diagnostics) -> Test.assert_eq(project_diagnostics_error_count(check_diagnostics), 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_check_execution_count(session, context), 1)

  project_session_set_source(session, context, "fn fixed() -> i64 { 7 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
}

test "parse failures are cached and replaced after correction" {
  let session = project_session_new(1)
  let context = project_test_overlay("overlay://broken-parse.weft", 1, 0, 1)
  project_session_set_source(session, context, "fn broken( {")
  match project_session_check(session, context) {
    ProjectCheckParseFailed(ProjectParseFailed(ast, diagnostics)) -> Test.assert_eq(if project_diagnostics_error_count(diagnostics) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, context) {
    ProjectCheckParseFailed(ProjectParseFailed(ast, diagnostics)) -> Test.assert_eq(if project_diagnostics_len(diagnostics) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)

  project_session_set_source(session, context, "fn fixed() -> i64 { 9 }")
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  Test.assert_eq(project_session_parse_execution_count(session, context), 2)
  Test.assert_eq(project_session_check_execution_count(session, context), 2)
}

test "missing and empty sources have distinct exact fingerprints" {
  let session = project_session_new(1)
  let disk = project_query_context(1, "disk://missing.weft", "test/fixtures/project-session-does-not-exist.weft", project_source_origin_disk(), 0, 1)
  match project_session_refresh_disk_source(session, disk) {
    IncrementalInputInserted(ProjectSourceMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_check(session, disk) {
    ProjectCheckSourceUnset -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match project_session_refresh_disk_source(session, disk) {
    IncrementalInputUnchanged(ProjectSourceMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_check_execution_count(session, disk), 1)

  let empty = project_test_overlay("overlay://empty.weft", 1, 0, 1)
  project_session_set_source(session, empty, "")
  Test.assert_eq(project_test_expect_success(project_session_check(session, empty)), 1)
}

test "disk acquisition feeds the same typed session pipeline" {
  let session = project_session_new(1)
  let context = project_query_context(1, "workspace://fixture.weft", "test/fixtures/project_session_source.txt", project_source_origin_disk(), 0, 1)
  match project_session_refresh_disk_source(session, context) {
    IncrementalInputInserted(ProjectSourcePresent(content)) -> Test.assert_eq(if __str_len(content) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_test_expect_success(project_session_check(session, context)), 1)
  match project_session_refresh_disk_source(session, context) {
    IncrementalInputUnchanged(ProjectSourcePresent(content)) -> Test.assert_eq(if __str_len(content) > 0 { 1 } else { 0 }, 1)
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(project_session_parse_execution_count(session, context), 1)
  Test.assert_eq(project_session_check_execution_count(session, context), 1)
}

test "package options target and source origin remain isolated" {
  let session = project_session_new(1)
  let a = project_test_overlay("source://same.weft", 1, 0, 1)
  let package_b = project_test_overlay("source://same.weft", 2, 0, 1)
  let options_b = project_test_overlay("source://same.weft", 1, 1, 1)
  let target_b = project_test_overlay("source://same.weft", 1, 0, 2)
  let disk = project_query_context(1, "source://same.weft", "", project_source_origin_disk(), 0, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, package_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, options_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, target_b)) { 1 } else { 0 }, 1)
  Test.assert_eq(if not incremental_query_key_equal(project_session_check_key(session, a), project_session_check_key(session, disk)) { 1 } else { 0 }, 1)
}
