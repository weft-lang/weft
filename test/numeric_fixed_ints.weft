-- test/numeric_fixed_ints.weft -- fixed-width integer primitive coverage

fn i32_id(x: i32) -> i32 {
  x
}

fn i32_add_one(x: i32) -> i32 {
  x + 1
}

test "i32_contextual_literals_in_let_call_and_return" {
  let x: i32 = 42
  let y = i32_id(7)
  let z = i32_add_one(40)
  Test.assert_eq(if x == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(if y == 7 { 1 } else { 0 }, 1)
  Test.assert_eq(if z == 41 { 1 } else { 0 }, 1)
}

test "i32_homogeneous_arithmetic_wraps_to_32_bits" {
  let max: i32 = 2147483647
  let wrapped = max + 1
  let min: i32 = 0 - 2147483648
  let under = min - 1
  Test.assert_eq(if wrapped == 0 - 2147483648 { 1 } else { 0 }, 1)
  Test.assert_eq(if under == 2147483647 { 1 } else { 0 }, 1)
}

test "i32_contextual_literal_operands_keep_i32_result" {
  let x: i32 = 10
  let a = x + 5
  let b = 5 + x
  let c = x * 3
  Test.assert_eq(if a == 15 { 1 } else { 0 }, 1)
  Test.assert_eq(if b == 15 { 1 } else { 0 }, 1)
  Test.assert_eq(if c == 30 { 1 } else { 0 }, 1)
}

test "i32_comparison_and_bitwise_ops" {
  let x: i32 = 240
  let low: i32 = 15
  let both = x band low
  let either = x bor low
  let flipped = either bxor low
  let shifted_left = low bshl 2
  let neg: i32 = 0 - 8
  let shifted_right = neg bshr 1
  Test.assert_eq(if both == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if either == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if flipped == 240 { 1 } else { 0 }, 1)
  Test.assert_eq(if shifted_left == 60 { 1 } else { 0 }, 1)
  Test.assert_eq(if shifted_right == 0 - 4 { 1 } else { 0 }, 1)
  Test.assert_eq(if i32_id(3) < i32_id(4) { 1 } else { 0 }, 1)
  Test.assert_eq(if i32_id(4) >= i32_id(4) { 1 } else { 0 }, 1)
  Test.assert_eq(if i32_id(0 - 3) < i32_id(2) { 1 } else { 0 }, 1)
}

test "i32_assignment_and_loop_state" {
  let mut total: i32 = 0
  let mut i: i32 = 0
  while i < 5 {
    total = total + i
    i = i + 1
  }
  Test.assert_eq(if total == 10 { 1 } else { 0 }, 1)
  Test.assert_eq(if i == 5 { 1 } else { 0 }, 1)
}
