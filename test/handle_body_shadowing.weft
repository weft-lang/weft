-- A handle body that calls a closure parameter must call the closure even
-- when a module function, local or imported, shares the parameter's name.
-- The handle-body inlining path used to resolve the callee by name first.

use stdlib/diagnostic/schema.{Diagnose}
use stdlib/json.{*}
use stdlib/result.{Ok, Err}

-- `parse` is the wildcard-imported JSON parser: a module function that
-- shares its name with the closure parameters below.
fn boost(value: i64) -> i64 { value + 1000 }

fn measure(value: i64) -> i64 { value + 2000 }

fn apply_handle(parse: (i64) -[Diagnose]> i64) -> i64 {
  handle parse(41) {
    Diagnose.report(value) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn apply_generic_handle<S>(parse: (i64) -[Diagnose]> S, measure: (S) -> i64) -> i64 {
  let value = handle parse(41) {
    Diagnose.report(report) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
  measure(value)
}

fn apply_local_shadow() -> i64 {
  let parse = (value: i64) => value + 1
  handle parse(41) {
    Diagnose.report(report) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn apply_plain(parse: (i64) -> i64) -> i64 { parse(41) }

test "a handle body calls the closure parameter, not the module function of the same name" {
  Test.assert_eq(apply_handle((value: i64) => value + 1), 42)
  Test.assert_eq(apply_plain((value: i64) => value + 1), 42)
  Test.assert_true(match parse("[1]") { Ok(_) -> true, Err(_) -> false })
}

test "a handle body in a generic function calls the closure parameter" {
  Test.assert_eq(apply_generic_handle<i64>((value: i64) => value + 1, (value: i64) => value), 42)
  Test.assert_eq(
    apply_generic_handle<i64>((value: i64) => value + 1, (value: i64) => measure(value)),
    2042
  )
}

test "a handle body calls a local closure that shadows a module function" {
  Test.assert_eq(apply_local_shadow(), 42)
}

test "a handle body still inlines a real module function" {
  let direct = handle boost(1) {
    Diagnose.report(report) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
  Test.assert_eq(direct, 1001)
}
