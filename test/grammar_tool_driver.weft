      let product = product_of(
        grammar_tool_ensure_product(toy_export(), NativeLinkLinuxAarch64, "test")
      )
      Test.assert_true(
        product.contains("target/linux-aarch64/grammar-tools/weft-toy_assignments")
      )
      Test.assert_str_eq(
        product,
        product_of(grammar_tool_ensure_product(toy_export(), NativeLinkLinuxAarch64, "test"))
      )
      nil
    }
  )
}

test "the token table issues session identities and refuses foreign ones" {
  with_platform<nil>(
    () => {
      with_host(
        "type settings { count: i64, label: str }\nfn main() -> i64 { 0 }",
        (tt: i64, src: i64) => {
          let tokens = grammar_tool_tokens()
          let settings_name = TypeName {
            qualifier: None<str>(),
            name: "settings",
            arguments: Nil<ToolTypeIdentity>()
          }
          let (resolved, count_field, listed, same, foreign_fields, foreign_subtype, missing) = host_types.run(
            tt,
            src,
            () => (
              grammar_tool_answer(tokens, ToolQueryResolve(settings_name)),
              grammar_tool_answer(
                tokens,
                ToolQueryField(tool_type_identity(1), NamedTypeField("count"))
              ),
              grammar_tool_answer(tokens, ToolQueryFields(tool_type_identity(1))),
              grammar_tool_answer(
                tokens,
                ToolQuerySubtype(tool_type_identity(1), tool_type_identity(1))
              ),
              grammar_tool_answer(tokens, ToolQueryFields(tool_type_identity(99))),
              grammar_tool_answer(
                tokens,
                ToolQuerySubtype(tool_type_identity(1), tool_type_identity(0))
              ),
              grammar_tool_answer(
                tokens,
                ToolQueryResolve(
                  TypeName {
                    qualifier: None<str>(),
                    name: "orders",
                    arguments: Nil<ToolTypeIdentity>()
                  }
                )
              )
            )
          )
          -- A declared record resolves nominally; its shape comes from `fields`.
          Test.assert_true(
            match resolved {
              ToolReplyType(value) -> tool_type_identity_token(value.identity) == 1 and (
                match value.description {
                  SemanticTypeNamed(name, _) -> str_eq(name, "settings") == 1,
                  _ -> false
                }
              ),
              _ -> false
            }
          )
          Test.assert_true(
            match count_field {
              ToolReplyType(value) -> tool_type_identity_token(value.identity) == 2 and (
                match value.description {
                  SemanticTypePrimitive(name) -> str_eq(name, "i64") == 1,
                  _ -> false
                }
              ),
              _ -> false
            }
          )
          Test.assert_true(
            match listed {
              ToolReplyFields(fields) -> fields.len() == __i64_to_usize(2),
              _ -> false
            }
          )
          Test.assert_true(match same { ToolReplyBool(true) -> true, _ -> false })
          Test.assert_true(
            match foreign_fields { ToolReplyError(ForeignTypeIdentity) -> true, _ -> false }
          )
          Test.assert_true(
            match foreign_subtype { ToolReplyError(ForeignTypeIdentity) -> true, _ -> false }
          )
          Test.assert_true(match missing { ToolReplyError(TypeNotFound) -> true, _ -> false })
          nil
        }
      )
      nil
    }
  )
}

-- Staging exchanges --------------------------------------------------------
fn stage_name(stage: ToolStageOutcome) -> str {
  match stage {
    ToolStageNotRequested -> "not_requested"
    ToolStaged(_) -> "staged"
    ToolStagedNothing -> "staged_nothing"
    ToolStageRefusedParseNotAccepted -> "refused parse"
    ToolStageRefusedCheckRejected -> "refused check"
    ToolStageRefusedNoStaging -> "refused no staging"
    ToolStageRefusedNoTooling -> "refused no tooling"
    ToolStageContextUnavailable -> "context unavailable"
    ToolStageContextUnsupported(GrammarHostTypesContext) -> "unsupported host"
    ToolStageContextUnsupported(GrammarFileContext) -> "unsupported file"
    ToolStageUnsupportedTarget -> "unsupported target"
    ToolStageSinkRefused(name) -> str_concat("sink refused ", name)
  }
}

-- The check phase, the stage phase and every diagnostic of a response.
fn describe_stage(exchange: GrammarToolExchange) -> str {
  match exchange {
    GrammarToolFailed(failure) -> str_concat("failed: ", grammar_tool_failure_message(failure))
    GrammarToolAnswered(response) -> str_concat(
      describe(exchange),
      str_concat(" / ", stage_name(response.stage))
    )
  }
}

fn staged_of(exchange: GrammarToolExchange) -> Option<ToolStagedArtifact> {
  match exchange {
    GrammarToolAnswered(response) -> match response.stage {
      ToolStaged(artifact) -> Some<ToolStagedArtifact>(artifact)
      _ -> None<ToolStagedArtifact>()
    }
    GrammarToolFailed(_) -> None<ToolStagedArtifact>()
  }
}

fn make_directory(text: str) -> i64 { sys_dir_mkdir(runtime_str_cstring(text), 448) }

fn scratch_sink_root() -> str {
  make_directory("target")
  let stamp = platform_time.with_platform(() => monotonic.now()).nanoseconds()
  let root = str_concat("target/staging-driver-", stamp.to_str())
  make_directory(root)
  root
}

fn sink_directory(root: str, name: str) -> str {
  let directory = str_concat(root, str_concat("/", name))
  make_directory(directory)
  directory
}

fn remove_directory(text: str) -> i64 { sys_dir_remove_directory(runtime_str_cstring(text)) }

fn remove_artifact(directory: str) -> i64 {
  sys_remove(runtime_str_cstring(str_concat(directory, "/artifact")))
}

fn verified(directory: str, artifact: ToolStagedArtifact) -> Result<Bytes, StagingVerifyFailure> {
  with dir_inspect_handler() {
    with file_read_handler() {
      verify_artifact(fixture_path(directory), artifact.size, artifact.content, artifact.budget)
    }
  }
}

fn entry_count(directory: str) -> i64 {
  let listed = with dir_inspect_handler() { DirInspect.list(fixture_path(directory)) }
  match listed {
    Ok(entries) -> __u64_to_i64(__usize_to_u64(entries.len()))
    Err(_) -> 0 - 1
  }
}

fn expected_plan() -> str { "assignment count : i64\n= 3\n" }

test "a typed plan export stages through the driver into the compiler's sink directory" {
  with_platform<nil>(
    () => {
      let product = product_of(
        grammar_tool_ensure_product(toy_staging_export(), native_link_target_host(), "test")
      )
      Test.assert_true(product.contains("/grammar-tools/weft-toy_staged_assignments"))
      let root = scratch_sink_root()
      let platform = native_link_target_name(native_link_target_host())
      with_host(
        "type settings { count: i64, label: str }\nfn main() -> i64 { 0 }",
        (tt: i64, src: i64) => {
          -- The staging driver still answers plain checks, with no stage phase.
          Test.assert_str_eq(
            describe_stage(
              grammar_tool_exchange_with_host(
                product,
                request_for(toy_staging_export(), "count = 3", ToolHostContext),
                tt,
                src,
                deadline_in(20000)
              )
            ),
            "checked / not_requested"
          )
          -- A typed plan lands as exactly one artifact the verifier accepts.
          let staged = sink_directory(root, "staged")
          let exchange = grammar_tool_exchange_with_host(
            product,
            stage_request_for(
              toy_staging_export(),
              "count = 3",
              ToolHostContext,
              StagingTypedPlan,
              platform,
              staged
            ),
            tt,
            src,
            deadline_in(20000)
          )
          Test.assert_str_eq(describe_stage(exchange), "checked / staged")
          match staged_of(exchange) {
            Some(artifact) -> {
              Test.assert_eq_usize(artifact.size, expected_plan().len())
              Test.assert_str_eq(
                artifact.content,
                content_digest(bytes.from_str(expected_plan()))
              )
              Test.assert_eq_usize(artifact.budget, __i64_to_usize(4096))
              Test.assert_true(
                match artifact.facts.get("key") {
                  Some(value) -> value.as_str().unwrap_or("") == "count",
                  None -> false
                }
              )
              match verified(staged, artifact) {
                Ok(content) -> Test.assert_str_eq(
                  content.to_utf8().unwrap_or(""),
                  expected_plan()
                )
                Err(_) -> Test.assert_true(false)
              }
            }
            None -> Test.assert_true(false)
          }
          remove_artifact(staged)
          remove_directory(staged)
          -- A validate-only target checks and emits nothing.
          let validated = sink_directory(root, "validated")
          Test.assert_str_eq(
            describe_stage(
              grammar_tool_exchange_with_host(
                product,
                stage_request_for(
                  toy_staging_export(),
                  "count = 3",
                  ToolHostContext,
                  StagingValidateOnly,
                  platform,
                  validated
                ),
                tt,
                src,
                deadline_in(20000)
              )
            ),
            "checked / staged_nothing"
          )
          Test.assert_eq(entry_count(validated), 0)
          remove_directory(validated)
          -- A rejected check withholds the plan and explains itself.
          let rejected = sink_directory(root, "rejected")
          Test.assert_str_eq(
            describe_stage(
              grammar_tool_exchange_with_host(
                product,
                stage_request_for(
                  toy_staging_export(),
                  "other = 3",
                  ToolHostContext,
                  StagingTypedPlan,
                  platform,
                  rejected
                ),
                tt,
                src,
                deadline_in(20000)
              )
            ),
            "rejected | settings has no field with this name @ embedded:0..5 / refused check"
          )
          Test.assert_eq(entry_count(rejected), 0)
          remove_directory(rejected)
          -- A platform the package cannot encode for is refused after the check.
          let unsupported = sink_directory(root, "unsupported")
          Test.assert_str_eq(
            describe_stage(
              grammar_tool_exchange_with_host(
                product,
                stage_request_for(
                  toy_staging_export(),
                  "count = 3",
                  ToolHostContext,
                  StagingTypedPlan,
                  "z80",
                  unsupported
                ),
                tt,
                src,
                deadline_in(20000)
              )
            ),
            "checked / unsupported target"
          )
          Test.assert_eq(entry_count(unsupported), 0)
          remove_directory(unsupported)
          -- A recovered or rejected parse never reaches the package.
          let unparsed = sink_directory(root, "unparsed")
          Test.assert_str_eq(
            describe_stage(
              grammar_tool_exchange_with_host(
                product,
                stage_request_for(
                  toy_staging_export(),
                  "count 3",
                  ToolHostContext,
                  StagingTypedPlan,
                  platform,
                  unparsed
                ),
                tt,
                src,
                deadline_in(20000)
              )
            ),
            "refused parse | expected '=' after the key @ embedded:6..7 / refused parse"
          )
          Test.assert_eq(entry_count(unparsed), 0)
          remove_directory(unparsed)
          nil
        }
      )
      -- A context kind the package does not stage against is refused structurally,
      -- and a stage without any context is not a request the driver answers.
      let file_context = sink_directory(root, "file")
      Test.assert_str_eq(
        describe_stage(
          grammar_tool_exchange_without_host(
            product,
            stage_request_for(
              toy_staging_export(),
              "count = 3",
              ToolFileContext(
                fixture_path("test/fixtures/comptime_sql_schema_v1.json"),
                __i64_to_usize(4096)
              ),
              StagingTypedPlan,
              platform,
              file_context
            ),
            deadline_in(20000)
          )
        ),
        "unsupported file / unsupported file"
      )
      Test.assert_eq(entry_count(file_context), 0)
      remove_directory(file_context)
      let no_context = sink_directory(root, "none")
      Test.assert_true(
        describe_stage(
          grammar_tool_exchange_without_host(
            product,
            stage_request_for(
              toy_staging_export(),
              "count = 3",
              ToolNoContext,
              StagingTypedPlan,
              platform,
              no_context
            ),
            deadline_in(20000)
          )
        ).contains("needs a host or file context")
      )
      remove_directory(no_context)
      -- A check-only export refuses to stage before its grammar runs, and a
      -- parse-only export refuses because it has no tooling at all.
      let check_only = product_of(
        grammar_tool_ensure_product(toy_export(), native_link_target_host(), "test")
      )
      let refused = sink_directory(root, "refused")
      Test.assert_str_eq(
        describe_stage(
          grammar_tool_exchange_without_host(
            check_only,
            stage_request_for(
              toy_export(),
              "count = 3",
              ToolHostContext,
              StagingTypedPlan,
              platform,
              refused
            ),
            deadline_in(20000)
          )
        ),
        "not_requested / refused no staging"
      )
      Test.assert_eq(entry_count(refused), 0)
      let words = product_of(
        grammar_tool_ensure_product(plain_export(), native_link_target_host(), "test")
      )
      Test.assert_str_eq(
        describe_stage(
          grammar_tool_exchange_without_host(
            words,
            stage_request_for(
              plain_export(),
              "hello",
              ToolHostContext,
              StagingTypedPlan,
              platform,
              refused
            ),
            deadline_in(20000)
          )
        ),
        "refused no tooling / refused no tooling"
      )
      Test.assert_eq(entry_count(refused), 0)
      remove_directory(refused)
      remove_directory(root)
      nil
    }
  )
}
