use stdlib/test.{*}
use stdlib/json as json
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/num.{*}
use stdlib/random as random
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/test/property as prop
use stdlib/test/property.{GenerationExhausted, HandlerContractViolated, Passed, Sampled}
use stdlib/test/property/json as json_prop
use test/module_fixtures/property_extreme_handler as extreme_handler
use test/module_fixtures/property_extreme_handler.{Capped}

fn round_trips(value: Json) -> bool {
  match value.stringify() {
    Err(_) -> false
    Ok(document) -> match json.parse(document) {
      Err(_) -> false
      Ok(decoded) -> match decoded.stringify() {
        Err(_) -> false
        Ok(encoded) -> encoded == document
      }
    }
  }
}

fn node_count(value: Json) -> usize {
  let one: usize = 1
  match value {
    JsonArray(items) -> one + array_node_count(items)
    JsonObject(entries) -> one + object_node_count(entries)
    _ -> one
  }
}

fn array_node_count(items: List<Json>) -> usize {
  let zero: usize = 0
  match items {
    Nil -> zero
    Cons(value, rest) -> node_count(value) + array_node_count(rest)
  }
}

fn object_node_count(entries: List<JsonEntry>) -> usize {
  let zero: usize = 0
  match entries {
    Nil -> zero
    Cons(JsonEntry(key, value), rest) -> node_count(value) + object_node_count(rest)
  }
}

fn within_size_24(value: Json) -> bool {
  let maximum: usize = 25
  node_count(value) <= maximum
}

test "JSON scalar generation covers every serializable leaf variant" {
  let limits = prop.limits(8, 0)
  match with extreme_handler(Capped(0)) { prop.sample(json_prop.scalar(), limits) } {
    Sampled(JsonNull) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Capped(1)) { prop.sample(json_prop.scalar(), limits) } {
    Sampled(JsonBool(true)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Capped(2)) { prop.sample(json_prop.scalar(), limits) } {
    Sampled(JsonNumber(_)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Capped(3)) { prop.sample(json_prop.scalar(), limits) } {
    Sampled(JsonFloat(value)) -> Test.assert_true(value.is_finite())
    _ -> Test.assert_true(false)
  }
  match with extreme_handler(Capped(4)) { prop.sample(json_prop.scalar(), limits) } {
    Sampled(JsonString(value)) -> Test.assert_eq(value.scalar_count(), 4)
    _ -> Test.assert_true(false)
  }
}

test "JSON size zero excludes recursive alternatives" {
  match with extreme_handler(Capped(8)) { prop.sample(json_prop.value(), prop.limits(0, 0)) } {
    Sampled(JsonArray(_)) -> Test.assert_true(false)
    Sampled(JsonObject(_)) -> Test.assert_true(false)
    Sampled(_) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "JSON aggregate generation preserves bounded array structure" {
  match with extreme_handler(Capped(1)) { prop.sample(json_prop.value(), prop.limits(4, 0)) } {
    Sampled(value) -> match value {
      JsonArray(items) -> {
        Test.assert_eq_usize(items.len(), 2)
        Test.assert_eq_usize(node_count(value), 5)
      }
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "JSON aggregate generation preserves ordered duplicate object keys" {
  match with extreme_handler(Capped(2)) { prop.sample(json_prop.value(), prop.limits(4, 0)) } {
    Sampled(JsonObject(entries)) -> {
      Test.assert_eq_usize(entries.len(), 3)
      match entries {
        Cons(JsonEntry(first, _), Cons(JsonEntry(second, _), _)) -> Test.assert_true(first == second)
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "JSON generation distributes a linear structural budget" {
  let config = prop.config(random.seed(9001), 300, 24, 0, 20).expect("positive JSON campaign")
  match prop.run(config, json_prop.value(), within_size_24) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 300)
    GenerationExhausted(_) -> Test.assert_true(false)
    HandlerContractViolated(_) -> Test.assert_true(false)
    _ -> Test.assert_true(false)
  }
}

test "generated JSON documents round trip canonically" {
  let config = prop.config(random.seed(20260905), 300, 24, 0, 20).expect("positive JSON campaign")
  match prop.run(config, json_prop.value(), round_trips) {
    Passed(summary) -> Test.assert_eq_usize(summary.cases(), 300)
    GenerationExhausted(_) -> Test.assert_true(false)
    HandlerContractViolated(_) -> Test.assert_true(false)
    _ -> Test.assert_true(false)
  }
}
