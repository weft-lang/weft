use stdlib/list.{*}
use stdlib/map as map
use stdlib/map.{Map, Set, persistent_map_get, persistent_map_is_promoted, persistent_map_new, persistent_map_promote, persistent_map_put, persistent_map_root, persistent_map_size}
use stdlib/option.{*}
use stdlib/set as set
use stdlib/set.{persistent_set_contains, persistent_set_difference, persistent_set_intersection, persistent_set_size, persistent_set_union}
use stdlib/eq.{Eq}
use stdlib/hash.{Hash}
use runtime/map_storage.{*}
use runtime/rc.{*}
use stdlib/string.{*}

type MapCollisionKey {
  id: i64,
  label: str
}

impl Hash for MapCollisionKey {
  fn hash(self: Self) -> i64 { 42 }
}

impl Eq for MapCollisionKey {
  fn eq(self: Self, other: Self) -> bool { self.id == other.id }
}

fn map_collision_key(id: i64, label: str) -> MapCollisionKey {
  MapCollisionKey { id: id, label: label }
}

fn map_build_range(start: i64, end: i64) -> Map<i64, i64> {
  let mut m = map.new<i64, i64>()
  let mut i = start
  while i < end {
    m = m.insert(i, i * 10)
    i = i + 1
  }
  m
}

fn set_build_range(start: i64, end: i64) -> Set<i64> {
  let mut set = set.new<i64>()
  for i in start..end {
    set = set.insert(i)
  }
  set
}

fn sets_equal_in_range(left: Set<i64>, right: Set<i64>, start: i64, end: i64) -> i64 {
  let mut equal = 1
  for i in start..end {
    if left.contains(i) != right.contains(i) {
      equal = 0
    } else { 0 }
  }
  equal
}

fn map_sum_pair(acc: i64, key: i64, val: i64) -> i64 {
  acc + key + val
}

fn list_count_i64(acc: i64, x: i64) -> i64 {
  acc + 1
}

fn list_sum_i64(acc: i64, x: i64) -> i64 {
  acc + x
}

fn map_managed_ledger_scope(value: str) -> i64 {
  let word = map_storage_word_from<str>(value)
  let before = rc_count(word)
  let region = map_storage_persistent_region_new_typed()
  let raw_region = map_storage_persistent_region_word(region)
  rc_persistent_region_retain_kind(raw_region, word, map_storage_cleanup_kind_of<str>())
  rc_count(word) - before
}

fn map_closure_ledger_scope(value: (i64) -> i64) -> i64 {
  let word = map_storage_word_from<(i64) -> i64>(value)
  let before = rc_count(word)
  let region = map_storage_persistent_region_new_typed()
  let raw_region = map_storage_persistent_region_word(region)
  rc_persistent_region_retain_kind(raw_region, word, map_storage_cleanup_kind_of<(i64) -> i64>())
  rc_count(word) - before
}

fn map_managed_payload_scope(key: str, value: str) -> i64 {
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  let map = map.new<str, str>().insert(key, value)
  if map.len() == 1 {
    (rc_count(key_word) - key_before) * 10 + (rc_count(value_word) - value_before)
  } else { 0 - 1 }
}

fn map_closure_payload_scope(value: (i64) -> i64) -> i64 {
  let word = map_storage_word_from<(i64) -> i64>(value)
  let before = rc_count(word)
  let map = map.new<i64, (i64) -> i64>().insert(7, value)
  if map.len() == 1 { rc_count(word) - before } else { 0 - 1 }
}

fn map_managed_remove_scope(key: str, value: str) -> i64 {
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  let one = map.new<str, str>().insert(key, value)
  let removed = one.remove(key)
  if one.len() == 1 and removed.len() == 0 {
    (rc_count(key_word) - key_before) * 10 + (rc_count(value_word) - value_before)
  } else { 0 - 1 }
}

fn map_build_string_range(count: i64) -> Map<str, str> {
  let mut map = map.new<str, str>()
  for i in 0..count {
    map = map.insert(str_concat("key-", int_to_str(i)), str_concat("value-", int_to_str(i)))
  }
  map
}

fn map_string_lengths(acc: i64, key: str, value: str) -> i64 {
  acc + str_len(key) + str_len(value)
}

fn list_count_str(acc: i64, value: str) -> i64 {
  acc + 1
}

test "runtime_map_payload_cleanup_kind_facts" {
  Test.assert_eq(map_storage_cleanup_kind_of<i64>(), 0)
  Test.assert_eq(map_storage_cleanup_kind_of<str>(), 1)
  Test.assert_eq(map_storage_cleanup_kind_of<(i64) -> i64>(), 2)
}

test "runtime_persistent_region_releases_typed_payload_ledger" {
  let value = str_concat("managed-", "map-value")
  let word = map_storage_word_from<str>(value)
  let before = rc_count(word)
  Test.assert_eq(map_managed_ledger_scope(value), 1)
  Test.assert_eq(rc_count(word), before)

  let offset = 7
  let callback = (x: i64) => x + offset
  let closure_word = map_storage_word_from<(i64) -> i64>(callback)
  let closure_before = rc_count(closure_word)
  Test.assert_eq(map_closure_ledger_scope(callback), 1)
  Test.assert_eq(rc_count(closure_word), closure_before)
  Test.assert_eq(callback(35), 42)
}

test "runtime_map_family_owns_and_releases_managed_payloads" {
  let key = str_concat("managed-", "key")
  let value = str_concat("managed-", "value")
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  Test.assert_eq(map_managed_payload_scope(key, value), 11)
  Test.assert_eq(rc_count(key_word), key_before)
  Test.assert_eq(rc_count(value_word), value_before)

  let offset = 7
  let callback = (x: i64) => x + offset
  let callback_word = map_storage_word_from<(i64) -> i64>(callback)
  let callback_before = rc_count(callback_word)
  Test.assert_eq(map_closure_payload_scope(callback), 1)
  Test.assert_eq(rc_count(callback_word), callback_before)
}

test "runtime_map_managed_keys_values_preserve_old_versions" {
  let alpha = str_concat("alpha-", "κ")
  let beta = str_concat("beta-", "雪")
  let first_value = str_concat("first-", "value")
  let second_value = str_concat("second-", "value")
  let updated_value = str_concat("updated-", "value")
  let empty = map.new<str, str>()
  let one = empty.insert(alpha, first_value)
  let two = one.insert(beta, second_value)
  let updated = two.insert(str_concat("alpha-", "κ"), updated_value)

  Test.assert_str_eq(one.get(str_concat("alpha-", "κ")).unwrap_or("missing"), "first-value")
  Test.assert_str_eq(two.get(str_concat("beta-", "雪")).unwrap_or("missing"), "second-value")
  Test.assert_str_eq(two.get(str_concat("alpha-", "κ")).unwrap_or("missing"), "first-value")
  Test.assert_str_eq(updated.get(str_concat("alpha-", "κ")).unwrap_or("missing"), "updated-value")
  Test.assert_eq_usize(empty.len(), 0)
  Test.assert_eq_usize(two.len(), 2)
  Test.assert_eq_usize(updated.len(), 2)
  Test.assert_true(updated.contains_key(str_concat("beta-", "雪")))
  Test.assert_false(updated.contains_key(str_concat("absent-", "key")))
}

test "runtime_map_managed_payloads_cover_subnodes_fold_keys_and_values" {
  let map = map_build_string_range(96)
  let keys = map.keys()
  let values = map.values()
  Test.assert_eq_usize(map.len(), 96)
  Test.assert_str_eq(map.get(str_concat("key-", int_to_str(63))).unwrap_or("missing"), "value-63")
  Test.assert_true(map.contains_key(str_concat("key-", int_to_str(95))))
  Test.assert_false(map.contains_key(str_concat("key-", int_to_str(96))))
  Test.assert_eq(keys.fold<i64>(0, list_count_str), 96)
  Test.assert_eq(values.fold<i64>(0, list_count_str), 96)
  Test.assert_gt(map.fold<i64>(0, map_string_lengths), 1000)
}

test "runtime_map_managed_closure_values_round_trip" {
  let offset = 7
  let callback = (x: i64) => x + offset
  let map = map.new<i64, (i64) -> i64>().insert(7, callback)
  let got = match map.get(7) {
    Some(value) -> value(35)
    None -> 0
  }
  Test.assert_eq(got, 42)
  Test.assert_true(map.contains_key(7))
  Test.assert_false(map.contains_key(8))
}

test "runtime_map_preserves_non_i64_scalar_value_bits" {
  let flags = map.new<str, bool>().insert(str_concat("feature-", "enabled"), true)
  Test.assert_true(flags.get(str_concat("feature-", "enabled")).unwrap_or(false))
  Test.assert_false(flags.get(str_concat("feature-", "missing")).unwrap_or(false))

  let readings = map.new<i64, f64>().insert(7, 42.25)
  Test.assert_eq_f64(readings.get(7).unwrap_or(0.0), 42.25)
  Test.assert_eq_f64(readings.get(8).unwrap_or(0.5), 0.5)
}

test "runtime_map_full_hash_collisions_use_persistent_buckets" {
  let empty = map.new<MapCollisionKey, str>()
  let one = empty.insert(map_collision_key(1, str_concat("first-", "key")), str_concat("first-", "value"))
  let two = one.insert(map_collision_key(2, str_concat("second-", "key")), str_concat("second-", "value"))
  let three = two.insert(map_collision_key(3, str_concat("third-", "key")), str_concat("third-", "value"))
  let updated = three.insert(map_collision_key(2, str_concat("replacement-", "label")), str_concat("updated-", "value"))

  Test.assert_eq_usize(empty.len(), 0)
  Test.assert_eq_usize(one.len(), 1)
  Test.assert_eq_usize(two.len(), 2)
  Test.assert_eq_usize(three.len(), 3)
  Test.assert_eq_usize(updated.len(), 3)
  Test.assert_str_eq(two.get(map_collision_key(2, "lookup")).unwrap_or("missing"), "second-value")
  Test.assert_str_eq(three.get(map_collision_key(3, "lookup")).unwrap_or("missing"), "third-value")
  Test.assert_str_eq(three.get(map_collision_key(2, "lookup")).unwrap_or("missing"), "second-value")
  Test.assert_str_eq(updated.get(map_collision_key(2, "lookup")).unwrap_or("missing"), "updated-value")
  Test.assert_true(updated.contains_key(map_collision_key(1, "lookup")))
  Test.assert_false(updated.contains_key(map_collision_key(4, "missing")))

  let set = set.new<MapCollisionKey>().insert(map_collision_key(1, "one")).insert(map_collision_key(2, "two")).insert(map_collision_key(1, "duplicate"))
  Test.assert_eq_usize(set.len(), 2)
  Test.assert_true(set.contains(map_collision_key(2, "lookup")))
  Test.assert_false(set.contains(map_collision_key(3, "missing")))
}

test "runtime_map_remove_empty_absent_and_persistent_versions" {
  let empty = map.new<i64, i64>()
  let absent_empty = empty.remove(7)
  Test.assert_eq_usize(empty.len(), 0)
  Test.assert_eq_usize(absent_empty.len(), 0)
  Test.assert_eq(if persistent_map_root<i64, i64>(empty) == persistent_map_root<i64, i64>(absent_empty) { 1 } else { 0 }, 1)

  let original = map_build_range(0, 96)
  let without_31 = original.remove(31)
  let without_63 = without_31.remove(63)
  let without_absent = without_63.remove(999)
  let restored = without_absent.insert(31, 310)

  Test.assert_eq_usize(original.len(), 96)
  Test.assert_eq(original.get(31).unwrap_or(0 - 1), 310)
  Test.assert_eq(original.get(63).unwrap_or(0 - 1), 630)
  Test.assert_eq_usize(without_31.len(), 95)
  Test.assert_false(without_31.contains_key(31))
  Test.assert_eq(without_31.get(63).unwrap_or(0 - 1), 630)
  Test.assert_eq_usize(without_63.len(), 94)
  Test.assert_false(without_63.contains_key(31))
  Test.assert_false(without_63.contains_key(63))
  Test.assert_eq(without_63.get(95).unwrap_or(0 - 1), 950)
  Test.assert_eq_usize(without_absent.len(), 94)
  Test.assert_eq(if persistent_map_root<i64, i64>(without_63) == persistent_map_root<i64, i64>(without_absent) { 1 } else { 0 }, 1)
  Test.assert_eq_usize(restored.len(), 95)
  Test.assert_eq(restored.get(31).unwrap_or(0 - 1), 310)
  Test.assert_false(restored.contains_key(63))
}

test "runtime_map_remove_rebuilds_full_hash_collision_chains" {
  let one = map.new<MapCollisionKey, str>().insert(map_collision_key(1, "one"), "value-one")
  let two = one.insert(map_collision_key(2, "two"), "value-two")
  let three = two.insert(map_collision_key(3, "three"), "value-three")
  let without_head = three.remove(map_collision_key(1, "lookup"))
  let without_middle = three.remove(map_collision_key(2, "lookup"))
  let without_tail = three.remove(map_collision_key(3, "lookup"))
  let absent = three.remove(map_collision_key(4, "missing"))

  Test.assert_eq_usize(three.len(), 3)
  Test.assert_str_eq(three.get(map_collision_key(1, "old")).unwrap_or("missing"), "value-one")
  Test.assert_eq_usize(without_head.len(), 2)
  Test.assert_false(without_head.contains_key(map_collision_key(1, "gone")))
  Test.assert_str_eq(without_head.get(map_collision_key(2, "kept")).unwrap_or("missing"), "value-two")
  Test.assert_str_eq(without_head.get(map_collision_key(3, "kept")).unwrap_or("missing"), "value-three")
  Test.assert_eq_usize(without_middle.len(), 2)
  Test.assert_false(without_middle.contains_key(map_collision_key(2, "gone")))
  Test.assert_str_eq(without_middle.get(map_collision_key(1, "kept")).unwrap_or("missing"), "value-one")
  Test.assert_str_eq(without_middle.get(map_collision_key(3, "kept")).unwrap_or("missing"), "value-three")
  Test.assert_eq_usize(without_tail.len(), 2)
  Test.assert_false(without_tail.contains_key(map_collision_key(3, "gone")))
  Test.assert_str_eq(without_tail.get(map_collision_key(1, "kept")).unwrap_or("missing"), "value-one")
  Test.assert_str_eq(without_tail.get(map_collision_key(2, "kept")).unwrap_or("missing"), "value-two")
  Test.assert_eq(if persistent_map_root<MapCollisionKey, str>(three) == persistent_map_root<MapCollisionKey, str>(absent) { 1 } else { 0 }, 1)

  let none = three.remove(map_collision_key(1, "drop")).remove(map_collision_key(2, "drop")).remove(map_collision_key(3, "drop"))
  let reused = none.insert(map_collision_key(4, "new"), "value-four")
  Test.assert_eq_usize(none.len(), 0)
  Test.assert_eq_usize(reused.len(), 1)
  Test.assert_str_eq(reused.get(map_collision_key(4, "lookup")).unwrap_or("missing"), "value-four")
}

test "runtime_map_remove_preserves_and_reclaims_managed_payloads" {
  let key = str_concat("remove-", "κ")
  let value = str_concat("payload-", "雪")
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  Test.assert_eq(map_managed_remove_scope(key, value), 11)
  Test.assert_eq(rc_count(key_word), key_before)
  Test.assert_eq(rc_count(value_word), value_before)

  let first_offset = 5
  let second_offset = 7
  let first = (x: i64) => x + first_offset
  let second = (x: i64) => x + second_offset
  let callbacks = map.new<i64, (i64) -> i64>().insert(1, first).insert(2, second)
  let removed = callbacks.remove(1)
  let old_result = match callbacks.get(1) {
    Some(callback) -> callback(37)
    None -> 0
  }
  let survivor_result = match removed.get(2) {
    Some(callback) -> callback(35)
    None -> 0
  }
  Test.assert_eq(old_result, 42)
  Test.assert_eq(survivor_result, 42)
  Test.assert_false(removed.contains_key(1))
  Test.assert_eq_usize(removed.len(), 1)
}

test "runtime_hash_set_remove_and_algebra_obey_set_laws" {
  let empty = set.new<i64>()
  let left = empty.insert(1).insert(2).insert(3)
  let right = set.new<i64>().insert(3).insert(4).insert(5)
  let union = left.union(right)
  let reverse_union = right.union(left)
  let intersection = left.intersection(right)
  let reverse_intersection = right.intersection(left)
  let difference = left.difference(right)
  let reverse_difference = right.difference(left)
  let removed = left.remove(2)
  let absent = left.remove(99)

  Test.assert_eq_usize(left.len(), 3)
  Test.assert_true(left.contains(2))
  Test.assert_eq_usize(removed.len(), 2)
  Test.assert_false(removed.contains(2))
  Test.assert_eq_usize(absent.len(), 3)
  Test.assert_eq_usize(union.len(), 5)
  Test.assert_eq(sets_equal_in_range(union, reverse_union, 0, 7), 1)
  Test.assert_eq_usize(intersection.len(), 1)
  Test.assert_true(intersection.contains(3))
  Test.assert_eq(sets_equal_in_range(intersection, reverse_intersection, 0, 7), 1)
  Test.assert_eq_usize(difference.len(), 2)
  Test.assert_true(difference.contains(1))
  Test.assert_true(difference.contains(2))
  Test.assert_false(difference.contains(3))
  Test.assert_eq_usize(reverse_difference.len(), 2)
  Test.assert_true(reverse_difference.contains(4))
  Test.assert_true(reverse_difference.contains(5))
  Test.assert_eq_usize(left.union(empty).len(), 3)
  Test.assert_eq_usize(left.intersection(empty).len(), 0)
  Test.assert_eq_usize(left.difference(empty).len(), 3)
  Test.assert_eq_usize(empty.difference(left).len(), 0)
  Test.assert_eq(sets_equal_in_range(left.union(left), left, 0, 7), 1)
  Test.assert_eq(sets_equal_in_range(left.intersection(left), left, 0, 7), 1)
  Test.assert_eq_usize(left.difference(left).len(), 0)
}

test "runtime_hash_set_algebra_covers_deep_paths_and_collisions" {
  let left = set_build_range(0, 96)
  let right = set_build_range(48, 144)
  let union = persistent_set_union<i64>(left, right)
  let intersection = persistent_set_intersection<i64>(left, right)
  let difference = persistent_set_difference<i64>(left, right)
  Test.assert_eq(persistent_set_size<i64>(union), 144)
  Test.assert_eq(persistent_set_size<i64>(intersection), 48)
  Test.assert_eq(persistent_set_size<i64>(difference), 48)
  Test.assert_true(persistent_set_contains<i64>(union, 143))
  Test.assert_false(persistent_set_contains<i64>(intersection, 47))
  Test.assert_true(persistent_set_contains<i64>(intersection, 48))
  Test.assert_true(persistent_set_contains<i64>(intersection, 95))
  Test.assert_false(persistent_set_contains<i64>(intersection, 96))
  Test.assert_true(persistent_set_contains<i64>(difference, 47))
  Test.assert_false(persistent_set_contains<i64>(difference, 48))
  Test.assert_eq(persistent_set_size<i64>(left), 96)
  Test.assert_eq(persistent_set_size<i64>(right), 96)

  let a = set.new<MapCollisionKey>().insert(map_collision_key(1, "one")).insert(map_collision_key(2, "two"))
  let b = set.new<MapCollisionKey>().insert(map_collision_key(2, "other-two")).insert(map_collision_key(3, "three"))
  let collision_union = a.union(b)
  let collision_intersection = a.intersection(b)
  let collision_difference = a.difference(b)
  let collision_removed = collision_union.remove(map_collision_key(2, "remove"))
  Test.assert_eq_usize(collision_union.len(), 3)
  Test.assert_eq_usize(collision_intersection.len(), 1)
  Test.assert_true(collision_intersection.contains(map_collision_key(2, "lookup")))
  Test.assert_eq_usize(collision_difference.len(), 1)
  Test.assert_true(collision_difference.contains(map_collision_key(1, "lookup")))
  Test.assert_eq_usize(collision_removed.len(), 2)
  Test.assert_false(collision_removed.contains(map_collision_key(2, "gone")))
  Test.assert_true(collision_union.contains(map_collision_key(2, "old")))
}

test "runtime_hash_set_algebra_preserves_managed_unicode_elements" {
  let left = set.new<str>().insert(str_concat("alpha-", "κ")).insert(str_concat("shared-", "雪"))
  let right = set.new<str>().insert(str_concat("shared-", "雪")).insert(str_concat("omega-", "λ"))
  let union = left.union(right)
  let intersection = left.intersection(right)
  let difference = left.difference(right)
  Test.assert_eq_usize(union.len(), 3)
  Test.assert_true(union.contains(str_concat("alpha-", "κ")))
  Test.assert_true(union.contains(str_concat("shared-", "雪")))
  Test.assert_true(union.contains(str_concat("omega-", "λ")))
  Test.assert_eq_usize(intersection.len(), 1)
  Test.assert_true(intersection.contains(str_concat("shared-", "雪")))
  Test.assert_eq_usize(difference.len(), 1)
  Test.assert_true(difference.contains(str_concat("alpha-", "κ")))
  Test.assert_true(left.contains(str_concat("shared-", "雪")))
  Test.assert_true(right.contains(str_concat("omega-", "λ")))
}

test "runtime_map_empty_lookup_and_contains" {
  let m = map.new<i64, i64>()
  Test.assert_eq_usize(m.len(), 0)
  Test.assert_true(m.get(1).is_none())
  Test.assert_eq(m.get(1).unwrap_or(0 - 1), 0 - 1)
  Test.assert_false(m.contains_key(1))
}

test "runtime_map_membership_does_not_reserve_a_sentinel_value" {
  let m = map.new<i64, i64>().insert(7, 0 - 9999999)
  Test.assert_true(m.contains_key(7))
  Test.assert_true(m.get(7).is_some())
  Test.assert_eq(m.get(7).unwrap_or(0), 0 - 9999999)
  Test.assert_false(m.contains_key(8))
}

test "runtime_map_persistent_insert_and_update" {
  let empty = map.new<i64, i64>()
  let one = empty.insert(1, 10)
  let two = one.insert(2, 20)
  let updated = two.insert(1, 30)
  Test.assert_eq_usize(empty.len(), 0)
  Test.assert_eq(empty.get(1).unwrap_or(0 - 1), 0 - 1)
  Test.assert_eq_usize(one.len(), 1)
  Test.assert_eq(one.get(1).unwrap_or(0 - 1), 10)
  Test.assert_eq_usize(two.len(), 2)
  Test.assert_eq(two.get(1).unwrap_or(0 - 1), 10)
  Test.assert_eq(two.get(2).unwrap_or(0 - 1), 20)
  Test.assert_eq_usize(updated.len(), 2)
  Test.assert_eq(updated.get(1).unwrap_or(0 - 1), 30)
  Test.assert_eq(updated.get(2).unwrap_or(0 - 1), 20)
}

test "runtime_map_many_keys_force_subnodes" {
  let m = map_build_range(0, 96)
  Test.assert_eq_usize(m.len(), 96)
  Test.assert_eq(m.get(0).unwrap_or(0 - 1), 0)
  Test.assert_eq(m.get(31).unwrap_or(0 - 1), 310)
  Test.assert_eq(m.get(63).unwrap_or(0 - 1), 630)
  Test.assert_eq(m.get(95).unwrap_or(0 - 1), 950)
  Test.assert_eq(m.get(96).unwrap_or(0 - 1), 0 - 1)
}

test "runtime_map_negative_and_boundary_keys" {
  let m = map.new<i64, i64>().insert(0 - 7, 70).insert(0, 22).insert(2147483647, 47)
  Test.assert_eq_usize(m.len(), 3)
  Test.assert_eq(m.get(0 - 7).unwrap_or(0 - 1), 70)
  Test.assert_eq(m.get(0).unwrap_or(0 - 1), 22)
  Test.assert_eq(m.get(2147483647).unwrap_or(0 - 1), 47)
  Test.assert_false(m.contains_key(0 - 8))
}

test "runtime_map_fold_keys_and_values" {
  let m = map.new<i64, i64>().insert(3, 30).insert(4, 40).insert(5, 50)
  let keys = m.keys()
  let vals = m.values()
  Test.assert_eq(m.fold<i64>(0, map_sum_pair), 132)
  Test.assert_eq(keys.fold<i64>(0, list_count_i64), 3)
  Test.assert_eq(vals.fold<i64>(0, list_count_i64), 3)
  Test.assert_eq(keys.fold<i64>(0, list_sum_i64), 12)
  Test.assert_eq(vals.fold<i64>(0, list_sum_i64), 120)
}

test "runtime_persistent_map_managed_root_promotes_without_touching_trie" {
  let m = persistent_map_put(persistent_map_new<i64, i64>(), 1, 10)
  Test.assert_eq(persistent_map_size(m), 1)
  Test.assert_eq(persistent_map_get(m, 1).unwrap_or(0 - 1), 10)
  Test.assert_eq(persistent_map_is_promoted(m), 0)
  persistent_map_promote(m)
  Test.assert_eq(persistent_map_is_promoted(m), 1)
  Test.assert_eq(persistent_map_get(m, 1).unwrap_or(0 - 1), 10)
}

test "runtime_persistent_map_versions_share_structure_but_not_roots" {
  let empty = persistent_map_new<i64, i64>()
  let one = persistent_map_put(empty, 1, 10)
  let two = persistent_map_put(one, 2, 20)
  let updated = persistent_map_put(two, 1, 30)
  Test.assert_eq(persistent_map_size(empty), 0)
  Test.assert_eq(persistent_map_size(one), 1)
  Test.assert_eq(persistent_map_size(two), 2)
  Test.assert_eq(persistent_map_size(updated), 2)
  Test.assert_eq(persistent_map_get(empty, 1).unwrap_or(0 - 1), 0 - 1)
  Test.assert_eq(persistent_map_get(one, 1).unwrap_or(0 - 1), 10)
  Test.assert_eq(persistent_map_get(two, 1).unwrap_or(0 - 1), 10)
  Test.assert_eq(persistent_map_get(two, 2).unwrap_or(0 - 1), 20)
  Test.assert_eq(persistent_map_get(updated, 1).unwrap_or(0 - 1), 30)
  Test.assert_eq(persistent_map_get(updated, 2).unwrap_or(0 - 1), 20)
  Test.assert_eq(if persistent_map_root(one) != persistent_map_root(two) { 1 } else { 0 }, 1)
}
