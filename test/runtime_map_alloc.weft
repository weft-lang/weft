use "stdlib/list.weft"
use "stdlib/map.weft"

fn map_build_range(start: i64, end: i64) -> i64 {
  let mut m = map_new()
  let mut i = start
  while i < end {
    m = map_put(m, i, i * 10)
    i = i + 1
  }
  m
}

fn map_sum_pair(acc: i64, key: i64, val: i64) -> i64 {
  acc + key + val
}

fn list_count_i64(acc: i64, x: i64) -> i64 {
  acc + 1
}

fn list_sum_i64(acc: i64, x: i64) -> i64 {
  acc + x
}

test "runtime_map_empty_lookup_and_contains" {
  let m = map_new()
  Test.assert_eq(map_size(m), 0)
  Test.assert_eq(map_get(m, 1, 0 - 1), 0 - 1)
  Test.assert_eq(map_contains(m, 1), 0)
}

test "runtime_map_persistent_insert_and_update" {
  let empty = map_new()
  let one = map_put(empty, 1, 10)
  let two = map_put(one, 2, 20)
  let updated = map_put(two, 1, 30)
  Test.assert_eq(map_size(empty), 0)
  Test.assert_eq(map_get(empty, 1, 0 - 1), 0 - 1)
  Test.assert_eq(map_size(one), 1)
  Test.assert_eq(map_get(one, 1, 0 - 1), 10)
  Test.assert_eq(map_size(two), 2)
  Test.assert_eq(map_get(two, 1, 0 - 1), 10)
  Test.assert_eq(map_get(two, 2, 0 - 1), 20)
  Test.assert_eq(map_size(updated), 2)
  Test.assert_eq(map_get(updated, 1, 0 - 1), 30)
  Test.assert_eq(map_get(updated, 2, 0 - 1), 20)
}

test "runtime_map_many_keys_force_subnodes" {
  let m = map_build_range(0, 96)
  Test.assert_eq(map_size(m), 96)
  Test.assert_eq(map_get(m, 0, 0 - 1), 0)
  Test.assert_eq(map_get(m, 31, 0 - 1), 310)
  Test.assert_eq(map_get(m, 63, 0 - 1), 630)
  Test.assert_eq(map_get(m, 95, 0 - 1), 950)
  Test.assert_eq(map_get(m, 96, 0 - 1), 0 - 1)
}

test "runtime_map_negative_and_boundary_keys" {
  let m = map_put(map_put(map_put(map_new(), 0 - 7, 70), 0, 22), 2147483647, 47)
  Test.assert_eq(map_size(m), 3)
  Test.assert_eq(map_get(m, 0 - 7, 0 - 1), 70)
  Test.assert_eq(map_get(m, 0, 0 - 1), 22)
  Test.assert_eq(map_get(m, 2147483647, 0 - 1), 47)
  Test.assert_eq(map_contains(m, 0 - 8), 0)
}

test "runtime_map_fold_keys_and_values" {
  let m = map_put(map_put(map_put(map_new(), 3, 30), 4, 40), 5, 50)
  let keys = map_keys(m)
  let vals = map_values(m)
  Test.assert_eq(map_fold(m, 0, map_sum_pair), 132)
  Test.assert_eq(list_fold<i64, i64>(keys, 0, list_count_i64), 3)
  Test.assert_eq(list_fold<i64, i64>(vals, 0, list_count_i64), 3)
  Test.assert_eq(list_fold<i64, i64>(keys, 0, list_sum_i64), 12)
  Test.assert_eq(list_fold<i64, i64>(vals, 0, list_sum_i64), 120)
}
