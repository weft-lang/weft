use stdlib/list.{*}
use stdlib/map.{*}
use stdlib/set.{*}
use runtime/map_storage.{*}
use runtime/rc.{*}
use stdlib/string.{*}

type MapCollisionKey {
  id: i64,
  label: str
}

impl Hash for MapCollisionKey {
  fn hash(self: Self) -> i64 { 42 }
}

impl Eq for MapCollisionKey {
  fn eq(self: Self, other: Self) -> bool { self.id == other.id }
}

fn map_collision_key(id: i64, label: str) -> MapCollisionKey {
  MapCollisionKey { id: id, label: label }
}

fn map_build_range(start: i64, end: i64) -> Map<i64, i64> {
  let mut m = map_new<i64, i64>()
  let mut i = start
  while i < end {
    m = map_put(m, i, i * 10)
    i = i + 1
  }
  m
}

fn set_build_range(start: i64, end: i64) -> Set<i64> {
  let mut set = set_new<i64>()
  for i in start..end {
    set = set_add<i64>(set, i)
  }
  set
}

fn sets_equal_in_range(left: Set<i64>, right: Set<i64>, start: i64, end: i64) -> i64 {
  let mut equal = 1
  for i in start..end {
    if set_contains<i64>(left, i) != set_contains<i64>(right, i) {
      equal = 0
    } else { 0 }
  }
  equal
}

fn map_sum_pair(acc: i64, key: i64, val: i64) -> i64 {
  acc + key + val
}

fn list_count_i64(acc: i64, x: i64) -> i64 {
  acc + 1
}

fn list_sum_i64(acc: i64, x: i64) -> i64 {
  acc + x
}

fn map_managed_ledger_scope(value: str) -> i64 {
  let word = map_storage_word_from<str>(value)
  let before = rc_count(word)
  let region = map_storage_persistent_region_new_typed()
  let raw_region = map_storage_persistent_region_word(region)
  rc_persistent_region_retain_kind(raw_region, word, map_storage_cleanup_kind_of<str>())
  rc_count(word) - before
}

fn map_closure_ledger_scope(value: (i64) -> i64) -> i64 {
  let word = map_storage_word_from<(i64) -> i64>(value)
  let before = rc_count(word)
  let region = map_storage_persistent_region_new_typed()
  let raw_region = map_storage_persistent_region_word(region)
  rc_persistent_region_retain_kind(raw_region, word, map_storage_cleanup_kind_of<(i64) -> i64>())
  rc_count(word) - before
}

fn map_managed_payload_scope(key: str, value: str) -> i64 {
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  let map = map_put<str, str>(map_new<str, str>(), key, value)
  if map_size<str, str>(map) == 1 {
    (rc_count(key_word) - key_before) * 10 + (rc_count(value_word) - value_before)
  } else { 0 - 1 }
}

fn map_closure_payload_scope(value: (i64) -> i64) -> i64 {
  let word = map_storage_word_from<(i64) -> i64>(value)
  let before = rc_count(word)
  let map = map_put<i64, (i64) -> i64>(map_new<i64, (i64) -> i64>(), 7, value)
  if map_size<i64, (i64) -> i64>(map) == 1 { rc_count(word) - before } else { 0 - 1 }
}

fn map_managed_remove_scope(key: str, value: str) -> i64 {
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  let one = map_put<str, str>(map_new<str, str>(), key, value)
  let removed = map_remove<str, str>(one, key)
  if map_size<str, str>(one) == 1 and map_size<str, str>(removed) == 0 {
    (rc_count(key_word) - key_before) * 10 + (rc_count(value_word) - value_before)
  } else { 0 - 1 }
}

fn map_build_string_range(count: i64) -> Map<str, str> {
  let mut map = map_new<str, str>()
  for i in 0..count {
    map = map_put<str, str>(map, str_concat("key-", int_to_str(i)), str_concat("value-", int_to_str(i)))
  }
  map
}

fn map_string_lengths(acc: i64, key: str, value: str) -> i64 {
  acc + str_len(key) + str_len(value)
}

fn list_count_str(acc: i64, value: str) -> i64 {
  acc + 1
}

test "runtime_map_payload_cleanup_kind_facts" {
  Test.assert_eq(map_storage_cleanup_kind_of<i64>(), 0)
  Test.assert_eq(map_storage_cleanup_kind_of<str>(), 1)
  Test.assert_eq(map_storage_cleanup_kind_of<(i64) -> i64>(), 2)
}

test "runtime_persistent_region_releases_typed_payload_ledger" {
  let value = str_concat("managed-", "map-value")
  let word = map_storage_word_from<str>(value)
  let before = rc_count(word)
  Test.assert_eq(map_managed_ledger_scope(value), 1)
  Test.assert_eq(rc_count(word), before)

  let offset = 7
  let callback = (x: i64) => x + offset
  let closure_word = map_storage_word_from<(i64) -> i64>(callback)
  let closure_before = rc_count(closure_word)
  Test.assert_eq(map_closure_ledger_scope(callback), 1)
  Test.assert_eq(rc_count(closure_word), closure_before)
  Test.assert_eq(callback(35), 42)
}

test "runtime_map_family_owns_and_releases_managed_payloads" {
  let key = str_concat("managed-", "key")
  let value = str_concat("managed-", "value")
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  Test.assert_eq(map_managed_payload_scope(key, value), 11)
  Test.assert_eq(rc_count(key_word), key_before)
  Test.assert_eq(rc_count(value_word), value_before)

  let offset = 7
  let callback = (x: i64) => x + offset
  let callback_word = map_storage_word_from<(i64) -> i64>(callback)
  let callback_before = rc_count(callback_word)
  Test.assert_eq(map_closure_payload_scope(callback), 1)
  Test.assert_eq(rc_count(callback_word), callback_before)
}

test "runtime_map_managed_keys_values_preserve_old_versions" {
  let alpha = str_concat("alpha-", "κ")
  let beta = str_concat("beta-", "雪")
  let first_value = str_concat("first-", "value")
  let second_value = str_concat("second-", "value")
  let updated_value = str_concat("updated-", "value")
  let empty = map_new<str, str>()
  let one = map_put<str, str>(empty, alpha, first_value)
  let two = map_put<str, str>(one, beta, second_value)
  let updated = map_put<str, str>(two, str_concat("alpha-", "κ"), updated_value)

  Test.assert_str_eq(map_get_or<str, str>(one, str_concat("alpha-", "κ"), "missing"), "first-value")
  Test.assert_str_eq(map_get_or<str, str>(two, str_concat("beta-", "雪"), "missing"), "second-value")
  Test.assert_str_eq(map_get_or<str, str>(two, str_concat("alpha-", "κ"), "missing"), "first-value")
  Test.assert_str_eq(map_get_or<str, str>(updated, str_concat("alpha-", "κ"), "missing"), "updated-value")
  Test.assert_eq(map_size<str, str>(empty), 0)
  Test.assert_eq(map_size<str, str>(two), 2)
  Test.assert_eq(map_size<str, str>(updated), 2)
  Test.assert_eq(map_contains<str, str>(updated, str_concat("beta-", "雪")), 1)
  Test.assert_eq(map_contains<str, str>(updated, str_concat("absent-", "key")), 0)
}

test "runtime_map_managed_payloads_cover_subnodes_fold_keys_and_values" {
  let map = map_build_string_range(96)
  let keys = map_keys<str, str>(map)
  let values = map_values<str, str>(map)
  Test.assert_eq(map_size<str, str>(map), 96)
  Test.assert_str_eq(map_get_or<str, str>(map, str_concat("key-", int_to_str(63)), "missing"), "value-63")
  Test.assert_eq(map_contains<str, str>(map, str_concat("key-", int_to_str(95))), 1)
  Test.assert_eq(map_contains<str, str>(map, str_concat("key-", int_to_str(96))), 0)
  Test.assert_eq(list_fold<str, i64>(keys, 0, list_count_str), 96)
  Test.assert_eq(list_fold<str, i64>(values, 0, list_count_str), 96)
  Test.assert_gt(map_fold<str, str, i64>(map, 0, map_string_lengths), 1000)
}

test "runtime_map_managed_closure_values_round_trip" {
  let offset = 7
  let callback = (x: i64) => x + offset
  let map = map_put<i64, (i64) -> i64>(map_new<i64, (i64) -> i64>(), 7, callback)
  let got = match map_get<i64, (i64) -> i64>(map, 7) {
    Some(value) -> value(35)
    None -> 0
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(map_contains<i64, (i64) -> i64>(map, 7), 1)
  Test.assert_eq(map_contains<i64, (i64) -> i64>(map, 8), 0)
}

test "runtime_map_preserves_non_i64_scalar_value_bits" {
  let flags = map_put<str, bool>(map_new<str, bool>(), str_concat("feature-", "enabled"), true)
  Test.assert_true(map_get_or<str, bool>(flags, str_concat("feature-", "enabled"), false))
  Test.assert_false(map_get_or<str, bool>(flags, str_concat("feature-", "missing"), false))

  let readings = map_put<i64, f64>(map_new<i64, f64>(), 7, 42.25)
  Test.assert_eq_f64(map_get_or<i64, f64>(readings, 7, 0.0), 42.25)
  Test.assert_eq_f64(map_get_or<i64, f64>(readings, 8, 0.5), 0.5)
}

test "runtime_map_full_hash_collisions_use_persistent_buckets" {
  let empty = map_new<MapCollisionKey, str>()
  let one = map_put<MapCollisionKey, str>(empty, map_collision_key(1, str_concat("first-", "key")), str_concat("first-", "value"))
  let two = map_put<MapCollisionKey, str>(one, map_collision_key(2, str_concat("second-", "key")), str_concat("second-", "value"))
  let three = map_put<MapCollisionKey, str>(two, map_collision_key(3, str_concat("third-", "key")), str_concat("third-", "value"))
  let updated = map_put<MapCollisionKey, str>(three, map_collision_key(2, str_concat("replacement-", "label")), str_concat("updated-", "value"))

  Test.assert_eq(map_size<MapCollisionKey, str>(empty), 0)
  Test.assert_eq(map_size<MapCollisionKey, str>(one), 1)
  Test.assert_eq(map_size<MapCollisionKey, str>(two), 2)
  Test.assert_eq(map_size<MapCollisionKey, str>(three), 3)
  Test.assert_eq(map_size<MapCollisionKey, str>(updated), 3)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(two, map_collision_key(2, "lookup"), "missing"), "second-value")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(three, map_collision_key(3, "lookup"), "missing"), "third-value")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(three, map_collision_key(2, "lookup"), "missing"), "second-value")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(updated, map_collision_key(2, "lookup"), "missing"), "updated-value")
  Test.assert_eq(map_contains<MapCollisionKey, str>(updated, map_collision_key(1, "lookup")), 1)
  Test.assert_eq(map_contains<MapCollisionKey, str>(updated, map_collision_key(4, "missing")), 0)

  let set = set_add<MapCollisionKey>(set_add<MapCollisionKey>(set_add<MapCollisionKey>(set_new<MapCollisionKey>(), map_collision_key(1, "one")), map_collision_key(2, "two")), map_collision_key(1, "duplicate"))
  Test.assert_eq(set_size<MapCollisionKey>(set), 2)
  Test.assert_eq(set_contains<MapCollisionKey>(set, map_collision_key(2, "lookup")), 1)
  Test.assert_eq(set_contains<MapCollisionKey>(set, map_collision_key(3, "missing")), 0)
}

test "runtime_map_remove_empty_absent_and_persistent_versions" {
  let empty = map_new<i64, i64>()
  let absent_empty = map_remove<i64, i64>(empty, 7)
  Test.assert_eq(map_size<i64, i64>(empty), 0)
  Test.assert_eq(map_size<i64, i64>(absent_empty), 0)
  Test.assert_eq(if persistent_map_root<i64, i64>(empty) == persistent_map_root<i64, i64>(absent_empty) { 1 } else { 0 }, 1)

  let original = map_build_range(0, 96)
  let without_31 = map_remove<i64, i64>(original, 31)
  let without_63 = map_remove<i64, i64>(without_31, 63)
  let without_absent = map_remove<i64, i64>(without_63, 999)
  let restored = map_put<i64, i64>(without_absent, 31, 310)

  Test.assert_eq(map_size<i64, i64>(original), 96)
  Test.assert_eq(map_get_or<i64, i64>(original, 31, 0 - 1), 310)
  Test.assert_eq(map_get_or<i64, i64>(original, 63, 0 - 1), 630)
  Test.assert_eq(map_size<i64, i64>(without_31), 95)
  Test.assert_eq(map_contains<i64, i64>(without_31, 31), 0)
  Test.assert_eq(map_get_or<i64, i64>(without_31, 63, 0 - 1), 630)
  Test.assert_eq(map_size<i64, i64>(without_63), 94)
  Test.assert_eq(map_contains<i64, i64>(without_63, 31), 0)
  Test.assert_eq(map_contains<i64, i64>(without_63, 63), 0)
  Test.assert_eq(map_get_or<i64, i64>(without_63, 95, 0 - 1), 950)
  Test.assert_eq(map_size<i64, i64>(without_absent), 94)
  Test.assert_eq(if persistent_map_root<i64, i64>(without_63) == persistent_map_root<i64, i64>(without_absent) { 1 } else { 0 }, 1)
  Test.assert_eq(map_size<i64, i64>(restored), 95)
  Test.assert_eq(map_get_or<i64, i64>(restored, 31, 0 - 1), 310)
  Test.assert_eq(map_contains<i64, i64>(restored, 63), 0)
}

test "runtime_map_remove_rebuilds_full_hash_collision_chains" {
  let one = map_put<MapCollisionKey, str>(map_new<MapCollisionKey, str>(), map_collision_key(1, "one"), "value-one")
  let two = map_put<MapCollisionKey, str>(one, map_collision_key(2, "two"), "value-two")
  let three = map_put<MapCollisionKey, str>(two, map_collision_key(3, "three"), "value-three")
  let without_head = map_remove<MapCollisionKey, str>(three, map_collision_key(1, "lookup"))
  let without_middle = map_remove<MapCollisionKey, str>(three, map_collision_key(2, "lookup"))
  let without_tail = map_remove<MapCollisionKey, str>(three, map_collision_key(3, "lookup"))
  let absent = map_remove<MapCollisionKey, str>(three, map_collision_key(4, "missing"))

  Test.assert_eq(map_size<MapCollisionKey, str>(three), 3)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(three, map_collision_key(1, "old"), "missing"), "value-one")
  Test.assert_eq(map_size<MapCollisionKey, str>(without_head), 2)
  Test.assert_eq(map_contains<MapCollisionKey, str>(without_head, map_collision_key(1, "gone")), 0)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_head, map_collision_key(2, "kept"), "missing"), "value-two")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_head, map_collision_key(3, "kept"), "missing"), "value-three")
  Test.assert_eq(map_size<MapCollisionKey, str>(without_middle), 2)
  Test.assert_eq(map_contains<MapCollisionKey, str>(without_middle, map_collision_key(2, "gone")), 0)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_middle, map_collision_key(1, "kept"), "missing"), "value-one")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_middle, map_collision_key(3, "kept"), "missing"), "value-three")
  Test.assert_eq(map_size<MapCollisionKey, str>(without_tail), 2)
  Test.assert_eq(map_contains<MapCollisionKey, str>(without_tail, map_collision_key(3, "gone")), 0)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_tail, map_collision_key(1, "kept"), "missing"), "value-one")
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(without_tail, map_collision_key(2, "kept"), "missing"), "value-two")
  Test.assert_eq(if persistent_map_root<MapCollisionKey, str>(three) == persistent_map_root<MapCollisionKey, str>(absent) { 1 } else { 0 }, 1)

  let none = map_remove<MapCollisionKey, str>(map_remove<MapCollisionKey, str>(map_remove<MapCollisionKey, str>(three, map_collision_key(1, "drop")), map_collision_key(2, "drop")), map_collision_key(3, "drop"))
  let reused = map_put<MapCollisionKey, str>(none, map_collision_key(4, "new"), "value-four")
  Test.assert_eq(map_size<MapCollisionKey, str>(none), 0)
  Test.assert_eq(map_size<MapCollisionKey, str>(reused), 1)
  Test.assert_str_eq(map_get_or<MapCollisionKey, str>(reused, map_collision_key(4, "lookup"), "missing"), "value-four")
}

test "runtime_map_remove_preserves_and_reclaims_managed_payloads" {
  let key = str_concat("remove-", "κ")
  let value = str_concat("payload-", "雪")
  let key_word = map_storage_word_from<str>(key)
  let value_word = map_storage_word_from<str>(value)
  let key_before = rc_count(key_word)
  let value_before = rc_count(value_word)
  Test.assert_eq(map_managed_remove_scope(key, value), 11)
  Test.assert_eq(rc_count(key_word), key_before)
  Test.assert_eq(rc_count(value_word), value_before)

  let first_offset = 5
  let second_offset = 7
  let first = (x: i64) => x + first_offset
  let second = (x: i64) => x + second_offset
  let callbacks = map_put<i64, (i64) -> i64>(map_put<i64, (i64) -> i64>(map_new<i64, (i64) -> i64>(), 1, first), 2, second)
  let removed = map_remove<i64, (i64) -> i64>(callbacks, 1)
  let old_result = match map_get<i64, (i64) -> i64>(callbacks, 1) {
    Some(callback) -> callback(37)
    None -> 0
  }
  let survivor_result = match map_get<i64, (i64) -> i64>(removed, 2) {
    Some(callback) -> callback(35)
    None -> 0
  }
  Test.assert_eq(old_result, 42)
  Test.assert_eq(survivor_result, 42)
  Test.assert_eq(map_contains<i64, (i64) -> i64>(removed, 1), 0)
  Test.assert_eq(map_size<i64, (i64) -> i64>(removed), 1)
}

test "runtime_hash_set_remove_and_algebra_obey_set_laws" {
  let empty = set_new<i64>()
  let left = set_add<i64>(set_add<i64>(set_add<i64>(empty, 1), 2), 3)
  let right = set_add<i64>(set_add<i64>(set_add<i64>(set_new<i64>(), 3), 4), 5)
  let union = set_union<i64>(left, right)
  let reverse_union = set_union<i64>(right, left)
  let intersection = set_intersection<i64>(left, right)
  let reverse_intersection = set_intersection<i64>(right, left)
  let difference = set_difference<i64>(left, right)
  let reverse_difference = set_difference<i64>(right, left)
  let removed = set_remove<i64>(left, 2)
  let absent = set_remove<i64>(left, 99)

  Test.assert_eq(set_size<i64>(left), 3)
  Test.assert_eq(set_contains<i64>(left, 2), 1)
  Test.assert_eq(set_size<i64>(removed), 2)
  Test.assert_eq(set_contains<i64>(removed, 2), 0)
  Test.assert_eq(set_size<i64>(absent), 3)
  Test.assert_eq(set_size<i64>(union), 5)
  Test.assert_eq(sets_equal_in_range(union, reverse_union, 0, 7), 1)
  Test.assert_eq(set_size<i64>(intersection), 1)
  Test.assert_eq(set_contains<i64>(intersection, 3), 1)
  Test.assert_eq(sets_equal_in_range(intersection, reverse_intersection, 0, 7), 1)
  Test.assert_eq(set_size<i64>(difference), 2)
  Test.assert_eq(set_contains<i64>(difference, 1), 1)
  Test.assert_eq(set_contains<i64>(difference, 2), 1)
  Test.assert_eq(set_contains<i64>(difference, 3), 0)
  Test.assert_eq(set_size<i64>(reverse_difference), 2)
  Test.assert_eq(set_contains<i64>(reverse_difference, 4), 1)
  Test.assert_eq(set_contains<i64>(reverse_difference, 5), 1)
  Test.assert_eq(set_size<i64>(set_union<i64>(left, empty)), 3)
  Test.assert_eq(set_size<i64>(set_intersection<i64>(left, empty)), 0)
  Test.assert_eq(set_size<i64>(set_difference<i64>(left, empty)), 3)
  Test.assert_eq(set_size<i64>(set_difference<i64>(empty, left)), 0)
  Test.assert_eq(sets_equal_in_range(set_union<i64>(left, left), left, 0, 7), 1)
  Test.assert_eq(sets_equal_in_range(set_intersection<i64>(left, left), left, 0, 7), 1)
  Test.assert_eq(set_size<i64>(set_difference<i64>(left, left)), 0)
}

test "runtime_hash_set_algebra_covers_deep_paths_and_collisions" {
  let left = set_build_range(0, 96)
  let right = set_build_range(48, 144)
  let union = persistent_set_union<i64>(left, right)
  let intersection = persistent_set_intersection<i64>(left, right)
  let difference = persistent_set_difference<i64>(left, right)
  Test.assert_eq(persistent_set_size<i64>(union), 144)
  Test.assert_eq(persistent_set_size<i64>(intersection), 48)
  Test.assert_eq(persistent_set_size<i64>(difference), 48)
  Test.assert_eq(persistent_set_contains<i64>(union, 143), 1)
  Test.assert_eq(persistent_set_contains<i64>(intersection, 47), 0)
  Test.assert_eq(persistent_set_contains<i64>(intersection, 48), 1)
  Test.assert_eq(persistent_set_contains<i64>(intersection, 95), 1)
  Test.assert_eq(persistent_set_contains<i64>(intersection, 96), 0)
  Test.assert_eq(persistent_set_contains<i64>(difference, 47), 1)
  Test.assert_eq(persistent_set_contains<i64>(difference, 48), 0)
  Test.assert_eq(persistent_set_size<i64>(left), 96)
  Test.assert_eq(persistent_set_size<i64>(right), 96)

  let a = set_add<MapCollisionKey>(set_add<MapCollisionKey>(set_new<MapCollisionKey>(), map_collision_key(1, "one")), map_collision_key(2, "two"))
  let b = set_add<MapCollisionKey>(set_add<MapCollisionKey>(set_new<MapCollisionKey>(), map_collision_key(2, "other-two")), map_collision_key(3, "three"))
  let collision_union = set_union<MapCollisionKey>(a, b)
  let collision_intersection = set_intersection<MapCollisionKey>(a, b)
  let collision_difference = set_difference<MapCollisionKey>(a, b)
  let collision_removed = set_remove<MapCollisionKey>(collision_union, map_collision_key(2, "remove"))
  Test.assert_eq(set_size<MapCollisionKey>(collision_union), 3)
  Test.assert_eq(set_size<MapCollisionKey>(collision_intersection), 1)
  Test.assert_eq(set_contains<MapCollisionKey>(collision_intersection, map_collision_key(2, "lookup")), 1)
  Test.assert_eq(set_size<MapCollisionKey>(collision_difference), 1)
  Test.assert_eq(set_contains<MapCollisionKey>(collision_difference, map_collision_key(1, "lookup")), 1)
  Test.assert_eq(set_size<MapCollisionKey>(collision_removed), 2)
  Test.assert_eq(set_contains<MapCollisionKey>(collision_removed, map_collision_key(2, "gone")), 0)
  Test.assert_eq(set_contains<MapCollisionKey>(collision_union, map_collision_key(2, "old")), 1)
}

test "runtime_hash_set_algebra_preserves_managed_unicode_elements" {
  let left = set_add<str>(set_add<str>(set_new<str>(), str_concat("alpha-", "κ")), str_concat("shared-", "雪"))
  let right = set_add<str>(set_add<str>(set_new<str>(), str_concat("shared-", "雪")), str_concat("omega-", "λ"))
  let union = set_union<str>(left, right)
  let intersection = set_intersection<str>(left, right)
  let difference = set_difference<str>(left, right)
  Test.assert_eq(set_size<str>(union), 3)
  Test.assert_eq(set_contains<str>(union, str_concat("alpha-", "κ")), 1)
  Test.assert_eq(set_contains<str>(union, str_concat("shared-", "雪")), 1)
  Test.assert_eq(set_contains<str>(union, str_concat("omega-", "λ")), 1)
  Test.assert_eq(set_size<str>(intersection), 1)
  Test.assert_eq(set_contains<str>(intersection, str_concat("shared-", "雪")), 1)
  Test.assert_eq(set_size<str>(difference), 1)
  Test.assert_eq(set_contains<str>(difference, str_concat("alpha-", "κ")), 1)
  Test.assert_eq(set_contains<str>(left, str_concat("shared-", "雪")), 1)
  Test.assert_eq(set_contains<str>(right, str_concat("omega-", "λ")), 1)
}

test "runtime_map_empty_lookup_and_contains" {
  let m = map_new<i64, i64>()
  Test.assert_eq(map_size(m), 0)
  Test.assert_eq(map_get(m, 1).is_none(), 1)
  Test.assert_eq(map_get_or(m, 1, 0 - 1), 0 - 1)
  Test.assert_eq(map_contains(m, 1), 0)
}

test "runtime_map_membership_does_not_reserve_a_sentinel_value" {
  let m = map_put(map_new<i64, i64>(), 7, 0 - 9999999)
  Test.assert_eq(map_contains(m, 7), 1)
  Test.assert_eq(map_get(m, 7).is_some(), 1)
  Test.assert_eq(map_get(m, 7).unwrap_or(0), 0 - 9999999)
  Test.assert_eq(map_contains(m, 8), 0)
}

test "runtime_map_persistent_insert_and_update" {
  let empty = map_new<i64, i64>()
  let one = map_put(empty, 1, 10)
  let two = map_put(one, 2, 20)
  let updated = map_put(two, 1, 30)
  Test.assert_eq(map_size(empty), 0)
  Test.assert_eq(map_get_or(empty, 1, 0 - 1), 0 - 1)
  Test.assert_eq(map_size(one), 1)
  Test.assert_eq(map_get_or(one, 1, 0 - 1), 10)
  Test.assert_eq(map_size(two), 2)
  Test.assert_eq(map_get_or(two, 1, 0 - 1), 10)
  Test.assert_eq(map_get_or(two, 2, 0 - 1), 20)
  Test.assert_eq(map_size(updated), 2)
  Test.assert_eq(map_get_or(updated, 1, 0 - 1), 30)
  Test.assert_eq(map_get_or(updated, 2, 0 - 1), 20)
}

test "runtime_map_many_keys_force_subnodes" {
  let m = map_build_range(0, 96)
  Test.assert_eq(map_size(m), 96)
  Test.assert_eq(map_get_or(m, 0, 0 - 1), 0)
  Test.assert_eq(map_get_or(m, 31, 0 - 1), 310)
  Test.assert_eq(map_get_or(m, 63, 0 - 1), 630)
  Test.assert_eq(map_get_or(m, 95, 0 - 1), 950)
  Test.assert_eq(map_get_or(m, 96, 0 - 1), 0 - 1)
}

test "runtime_map_negative_and_boundary_keys" {
  let m = map_put(map_put(map_put(map_new<i64, i64>(), 0 - 7, 70), 0, 22), 2147483647, 47)
  Test.assert_eq(map_size(m), 3)
  Test.assert_eq(map_get_or(m, 0 - 7, 0 - 1), 70)
  Test.assert_eq(map_get_or(m, 0, 0 - 1), 22)
  Test.assert_eq(map_get_or(m, 2147483647, 0 - 1), 47)
  Test.assert_eq(map_contains(m, 0 - 8), 0)
}

test "runtime_map_fold_keys_and_values" {
  let m = map_put(map_put(map_put(map_new<i64, i64>(), 3, 30), 4, 40), 5, 50)
  let keys = map_keys(m)
  let vals = map_values(m)
  Test.assert_eq(map_fold<i64, i64, i64>(m, 0, map_sum_pair), 132)
  Test.assert_eq(list_fold<i64, i64>(keys, 0, list_count_i64), 3)
  Test.assert_eq(list_fold<i64, i64>(vals, 0, list_count_i64), 3)
  Test.assert_eq(list_fold<i64, i64>(keys, 0, list_sum_i64), 12)
  Test.assert_eq(list_fold<i64, i64>(vals, 0, list_sum_i64), 120)
}

test "runtime_persistent_map_managed_root_promotes_without_touching_trie" {
  let m = persistent_map_put(persistent_map_new<i64, i64>(), 1, 10)
  Test.assert_eq(persistent_map_size(m), 1)
  Test.assert_eq(persistent_map_get_or(m, 1, 0 - 1), 10)
  Test.assert_eq(persistent_map_is_promoted(m), 0)
  persistent_map_promote(m)
  Test.assert_eq(persistent_map_is_promoted(m), 1)
  Test.assert_eq(persistent_map_get_or(m, 1, 0 - 1), 10)
}

test "runtime_persistent_map_versions_share_structure_but_not_roots" {
  let empty = persistent_map_new<i64, i64>()
  let one = persistent_map_put(empty, 1, 10)
  let two = persistent_map_put(one, 2, 20)
  let updated = persistent_map_put(two, 1, 30)
  Test.assert_eq(persistent_map_size(empty), 0)
  Test.assert_eq(persistent_map_size(one), 1)
  Test.assert_eq(persistent_map_size(two), 2)
  Test.assert_eq(persistent_map_size(updated), 2)
  Test.assert_eq(persistent_map_get_or(empty, 1, 0 - 1), 0 - 1)
  Test.assert_eq(persistent_map_get_or(one, 1, 0 - 1), 10)
  Test.assert_eq(persistent_map_get_or(two, 1, 0 - 1), 10)
  Test.assert_eq(persistent_map_get_or(two, 2, 0 - 1), 20)
  Test.assert_eq(persistent_map_get_or(updated, 1, 0 - 1), 30)
  Test.assert_eq(persistent_map_get_or(updated, 2, 0 - 1), 20)
  Test.assert_eq(if persistent_map_root(one) != persistent_map_root(two) { 1 } else { 0 }, 1)
}
