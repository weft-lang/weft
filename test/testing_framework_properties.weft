use "compiler/lib.weft"
use "compiler/types.weft"

-- Closed-world Conformance discharge for trait-free property domains.
fn is_subtype_c(a: i64, b: i64) -> i64 {
  handle is_subtype(a, b) {
    Conformance.conforms(th, trh) -> resume(0)
  }
}

fn ty_is_empty_c(t: i64) -> i64 {
  handle ty_is_empty(t) {
    Conformance.conforms(th, trh) -> resume(0)
  }
}

-- Property-style tests for the testing framework itself, using finite
-- generators over the compiler's real type/effect algebra.

fn prop_implies(a: bool, b: bool) -> bool {
  if a { b } else { true }
}

fn prop_subtype(a: i64, b: i64) -> bool {
  is_subtype_c(a, b) == 1
}

fn prop_empty_type(t: i64) -> bool {
  ty_is_empty_c(t) == 1
}

fn prop_effect_subset(a: i64, b: i64) -> bool {
  effect_is_subset(a, b) == 1
}

fn prop_atom_type(index: i64) -> i64 {
  match index {
    0 -> ty_i64()
    1 -> ty_str()
    2 -> ty_bool()
    _ -> ty_nil()
  }
}

fn prop_sample_type(index: i64) -> i64 {
  match index {
    0 -> ty_never()
    1 -> ty_i64()
    2 -> ty_str()
    3 -> ty_bool()
    4 -> ty_nil()
    5 -> ty_union(ty_i64(), ty_str())
    6 -> ty_inter(ty_i64(), ty_compl(ty_str()))
    _ -> ty_any()
  }
}

fn prop_lattice_type(index: i64) -> i64 {
  match index {
    0 -> ty_never()
    1 -> ty_i64()
    2 -> ty_union(ty_i64(), ty_str())
    _ -> ty_any()
  }
}

fn prop_effect_a() -> i64 { 101 }
fn prop_effect_b() -> i64 { 202 }

fn prop_effect_empty() -> i64 {
  ty_effect_sig(nlist_new())
}

fn prop_effect_one(hash: i64) -> i64 {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(hash))
  ty_effect_sig(effects)
}

fn prop_effect_two(left: i64, right: i64) -> i64 {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(left))
  nlist_add(effects, ty_effect_app(right))
  ty_effect_sig(effects)
}

fn prop_effect_open_one(hash: i64) -> i64 {
  let effects = nlist_new()
  nlist_add(effects, ty_effect_app(hash))
  ty_effect_sig_with_tail(effects, 1)
}

fn prop_effect_sample(index: i64) -> i64 {
  match index {
    0 -> prop_effect_empty()
    1 -> prop_effect_one(prop_effect_a())
    2 -> prop_effect_two(prop_effect_a(), prop_effect_b())
    _ -> prop_effect_open_one(prop_effect_a())
  }
}

fn prop_fn_type(eff: i64) -> i64 {
  let params = nlist_new()
  nlist_add(params, ty_i64())
  ty_fn(params, ty_i64(), eff)
}

test "property_type_subtyping_reflexive" {
  Test.forall_i64_range(0, 8, i => {
    let t = prop_sample_type(i)
    prop_subtype(t, t)
  })
}

test "property_type_union_introduction" {
  Test.forall_i64_range(0, 16, i => {
    let left = prop_atom_type(i / 4)
    let right = prop_atom_type(i - i / 4 * 4)
    let joined = ty_union(left, right)
    prop_subtype(left, joined) and prop_subtype(right, joined)
  })
}

test "property_type_intersection_elimination" {
  Test.forall_i64_range(0, 16, i => {
    let left = prop_atom_type(i / 4)
    let right = prop_atom_type(i - i / 4 * 4)
    let both = ty_inter(left, right)
    prop_subtype(both, left) and prop_subtype(both, right)
  })
}

test "property_type_complement_excludes_self" {
  Test.forall_i64_range(0, 8, i => {
    let t = prop_sample_type(i)
    prop_empty_type(ty_inter(t, ty_compl(t)))
  })
}

test "property_type_subtyping_transitive" {
  Test.forall_i64_range(0, 64, i => {
    let a = prop_lattice_type(i / 16)
    let b = prop_lattice_type((i / 4) - (i / 16) * 4)
    let c = prop_lattice_type(i - (i / 4) * 4)
    prop_implies(prop_subtype(a, b) and prop_subtype(b, c), prop_subtype(a, c))
  })
}

test "property_effect_subset_reflexive_and_empty" {
  Test.forall_i64_range(0, 4, i => {
    let eff = prop_effect_sample(i)
    prop_effect_subset(eff, eff) and prop_effect_subset(prop_effect_empty(), eff)
  })
}

test "property_effect_subset_transitive" {
  Test.forall_i64_range(0, 64, i => {
    let a = prop_effect_sample(i / 16)
    let b = prop_effect_sample((i / 4) - (i / 16) * 4)
    let c = prop_effect_sample(i - (i / 4) * 4)
    prop_implies(prop_effect_subset(a, b) and prop_effect_subset(b, c), prop_effect_subset(a, c))
  })
}

test "property_function_effect_subtyping" {
  let pure_fn = prop_fn_type(prop_effect_empty())
  let io_fn = prop_fn_type(prop_effect_one(prop_effect_a()))
  Test.assert_true(prop_subtype(pure_fn, io_fn))
  Test.assert_false(prop_subtype(io_fn, pure_fn))
}
