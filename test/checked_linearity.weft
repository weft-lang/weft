-- Owned and unique values on the typed path: every direct reference moves the
-- value, a borrow, projection or index only reads it, a use after a possible
-- move is refused, conditional moves are legal, a path that never completes
-- contributes no moves, and no closure captures a linear value.

use compiler/project/identity.{ModuleIdentity, named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/weft/check/body/producer.{
  CheckedBodiesAccepted,
  CheckedBodiesRejected,
  check_registered_bodies
}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/rejection.{checked_body_producer_issue_category}
use compiler/weft/check/resolution.{SemanticResolutionAccepted, resolve_module_semantics}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/list as list
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{Option}
use stdlib/panic.{panic}
use stdlib/string.{str_concat}
use stdlib/test.{Test}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

-- A resource with a Drop implementation, its moving and borrowing uses, and a
-- choice that owns one.
fn resource() -> str {
  "use stdlib/drop.{Drop} "
    |> str_concat("type Token { value: i64 } ")
    |> str_concat("impl Drop for Token { fn drop(self) -> nil { nil } } ")
    |> str_concat("impl Token { ")
    |> str_concat("fn finish(self: owned Self) -> i64 { 1 } ")
    |> str_concat("fn peek(self: borrow Self) -> i64 { 2 } } ")
    |> str_concat("type Held { Holding(owned Token), Empty } ")
    |> str_concat("type Pair { token: owned Token, count: i64 } ")
    |> str_concat("fn release_pair(pair: Pair) -> i64 { 4 } ")
    |> str_concat("fn make() -> owned Token { Token { value: 1 } } ")
    |> str_concat("fn consume(token: owned Token) -> i64 { 1 } ")
    |> str_concat("fn inspect(token: borrow Token) -> i64 { 2 } ")
    |> str_concat("fn release(held: Held) -> i64 { 3 } ")
    |> str_concat("fn fresh() -> Held { Empty } ")
    |> str_concat("fn stop() -> never { loop { } } ")
}

fn outcome(program: str, discriminator: i64) -[Test]> str {
  let drop = registered(
    "pub trait Drop { fn drop(self) -> nil }",
    named_module_identity("stdlib/drop", discriminator)
  )
  let consumer = registered(
    str_concat(resource(), program),
    named_module_identity("fixture/linearity", discriminator)
  )
  let edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    drop.identity,
    false
  )
  let modules = [drop, consumer]
  let imports = [edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> {
      let result = handle check_registered_bodies(consumer, scope, resolution, discriminator) {
        SemanticConformance.conforms(_, concrete, trait_atom) -> resume(true)
      }
      match result {
        CheckedBodiesAccepted(_) -> "accepted"
        CheckedBodiesRejected(issue) -> checked_body_producer_issue_category(issue)
      }
    }
    _ -> "unresolved"
  }
}

fn assert_outcomes(cases: List<str>, expected: str, discriminator: i64) -[Test]> nil {
  match cases {
    Nil -> nil
    Cons(program, rest) -> {
      Test.assert_str_eq(outcome(program, discriminator), expected)
      assert_outcomes(rest, expected, discriminator + 1)
    }
  }
}

test "a linear value moves once along every path" {
  let accepted = [
    "fn run(token: owned Token) -> i64 { consume(token) }",
    -- Borrows and projections read the value before it moves.
    "fn run(token: owned Token) -> i64 { inspect(token) + consume(token) }",
    "fn run(token: owned Token) -> i64 { token.peek() + token.finish() }",
    -- A conditional move leaves the other path to drop the value.
    "fn run(token: owned Token, flag: bool) -> i64 { if flag { consume(token) } else { 0 } }",
    "fn run(token: owned Token, flag: bool) -> i64 { if flag { consume(token) } else { consume(token) } }",
    "fn run(token: owned Token, choice: i64) -> i64 { match choice { 0 -> consume(token), _ -> 0 } }",
    -- A path that never completes contributes no move to the join.
    "fn run(token: owned Token, flag: bool) -> i64 { if flag { return consume(token) } consume(token) }",
    "fn run(token: owned Token, flag: bool) -> i64 { if flag { consume(token) stop() } else { 0 } consume(token) }",
    -- A binding introduced inside a loop is fresh on every iteration.
    "fn run() -> i64 { let mut index = 0 while index < 3 { let token = make() consume(token) index = index + 1 } index }",
    "fn run(token: owned Token) -> i64 { loop { consume(token) break } 0 }",
    -- Assignment gives a moved binding a new value.
    "fn run() -> i64 { let mut token = make() consume(token) token = make() consume(token) }",
    -- A pattern binding owns the payload it extracts, afresh on every
    -- iteration that reaches its arm.
    "fn run() -> i64 { let mut index = 0 while index < 3 { match fresh() { Holding(token) -> consume(token), Empty -> 0 } index = index + 1 } index }",
    "fn run(held: Held) -> i64 { match held { Holding(token) -> consume(token), Empty -> 0 } }",
    "fn run(held: Held) -> i64 { release(held) }",
    -- A projection reads through an aggregate without moving it.
    "fn run(pair: Pair) -> i64 { pair.count + release_pair(pair) }"
  ]
  assert_outcomes(list.from_slice(accepted[..]), "accepted", 4101)
}

test "a use after a possible move is refused" {
  let refused = [
    "fn run(token: owned Token) -> i64 { consume(token) + consume(token) }",
    "fn run(token: owned Token) -> i64 { consume(token) + inspect(token) }",
    "fn run(held: Held, values: [i64]) -> i64 { release(held) + release(held) + values[0] }",
    "fn run(token: owned Token) -> i64 { token.finish() + token.peek() }",
    -- Binding a linear value to another name moves it.
    "fn run(token: owned Token) -> i64 { let other = token consume(token) }",
    -- Possibly moved on one path is moved for every use after the join.
    "fn run(token: owned Token, flag: bool) -> i64 { if flag { consume(token) } else { 0 } consume(token) }",
    "fn run(token: owned Token, choice: i64) -> i64 { match choice { 0 -> consume(token), _ -> 0 } + inspect(token) }",
    -- A loop body runs again with what the last iteration left.
    "fn run(token: owned Token, flag: bool) -> i64 { while flag { consume(token) } 0 }",
    "fn run(token: owned Token) -> i64 { let mut index = 0 loop { if index > 2 { break } consume(token) index = index + 1 } index }",
    "fn run(token: owned Token, flag: bool) -> i64 { while flag { if flag { consume(token) continue } 0 } 0 }",
    -- Each extracted payload and each aggregate holding one is linear too.
    "fn run(held: Held) -> i64 { match held { Holding(token) -> consume(token) + consume(token), Empty -> 0 } }",
    "fn run(held: Held) -> i64 { release(held) + release(held) }",
    "fn run(held: Held) -> i64 { let kept = held release(held) }",
    "fn run(pair: Pair) -> i64 { release_pair(pair) + pair.count }"
  ]
  assert_outcomes(list.from_slice(refused[..]), "linear_use_after_move", 4131)
}

test "a closure never captures a linear value" {
  -- An aggregate holding a linear value is refused by the linearity check;
  -- the body producer already refuses capturing an owned value itself.
  let refused = [
    "fn run(held: Held) -> i64 { let later = () => release(held) 0 }",
    "fn run(held: Held) -> i64 { let later = () => 0 release(held) + { let again = () => release(held) 0 } }"
  ]
  assert_outcomes(list.from_slice(refused[..]), "linear_captured", 4161)
  Test.assert_str_eq(
    outcome("fn run(token: owned Token) -> i64 { let later = () => consume(token) 0 }", 4165),
    "lambda_capture_unsupported"
  )
  -- A closure's own linear values follow the same rules.
  Test.assert_str_eq(
    outcome(
      "fn run() -> i64 { let use_once = () => { let token = make() consume(token) } 0 }",
      4171
    ),
    "accepted"
  )
  Test.assert_str_eq(
    outcome(
      "fn run() -> i64 { let use_twice = () => { let token = make() consume(token) + consume(token) } 0 }",
      4172
    ),
    "linear_use_after_move"
  )
}

test "values that hold nothing linear are used freely" {
  let accepted = [
    "fn run(value: i64) -> i64 { value + value }",
    "fn run(token: borrow Token) -> i64 { inspect(token) + inspect(token) }",
    "type Plain { count: i64 } fn run(plain: Plain) -> i64 { let other = plain plain.count + other.count }"
  ]
  assert_outcomes(list.from_slice(accepted[..]), "accepted", 4181)
}
