use runtime/defer_order_test.{OwnedAbortToken, defer_order_log_new, defer_order_log_read, defer_order_log_write, owned_abort_token_new}
use stdlib/result.{Result, Ok, Err}
use stdlib/test.{Test}

fn path_note(log: i64, digit: i64) -> i64 {
  defer_order_log_write(log, defer_order_log_read(log) * 10 + digit)
}

fn path_consume<T, E>(value: Result<T, E>) -> i64 { 0 }
fn path_consume_leaf(value: owned OwnedAbortToken) -> i64 { 0 }

fn path_break(log: i64, move_owner: bool) -> i64 {
  loop {
    let held: Result<owned OwnedAbortToken, i64> = Ok<owned OwnedAbortToken, i64>(owned_abort_token_new(log, 4))
    if move_owner { path_consume<owned OwnedAbortToken, i64>(held) } else { 0 }
    path_note(log, 8)
    break
  }
  42
}

test "conditional generic transfer preserves cleanup order at break" {
  let moved = defer_order_log_new()
  Test.assert_eq(path_break(moved, true), 42)
  Test.assert_eq(defer_order_log_read(moved), 48)
  let held = defer_order_log_new()
  Test.assert_eq(path_break(held, false), 42)
  Test.assert_eq(defer_order_log_read(held), 84)
}

fn path_return(log: i64, move_owner: bool) -> i64 {
  loop {
    let held: owned OwnedAbortToken = owned_abort_token_new(log, 4)
    if move_owner { 0 } else { path_consume_leaf(held) }
    path_note(log, 8)
    return 42
  }
}

test "conditional leaf transfer preserves cleanup order at return" {
  let moved = defer_order_log_new()
  Test.assert_eq(path_return(moved, false), 42)
  Test.assert_eq(defer_order_log_read(moved), 48)
  let held = defer_order_log_new()
  Test.assert_eq(path_return(held, true), 42)
  Test.assert_eq(defer_order_log_read(held), 84)
}

fn path_continue(log: i64) -> i64 {
  let mut digit = 1
  while digit <= 3 {
    let held: Result<owned OwnedAbortToken, i64> = Ok<owned OwnedAbortToken, i64>(owned_abort_token_new(log, digit))
    if digit == 2 { path_consume<owned OwnedAbortToken, i64>(held) } else { 0 }
    path_note(log, 8)
    digit = digit + 1
    continue
  }
  42
}

test "conditional transfers reset ownership on each continue acquisition" {
  let log = defer_order_log_new()
  Test.assert_eq(path_continue(log), 42)
  Test.assert_eq(defer_order_log_read(log), 812883)
}

fn path_match(log: i64, choice: i64, empty: bool) -> i64 {
  loop {
    let held: Result<owned OwnedAbortToken, i64> = if empty {
      Err<owned OwnedAbortToken, i64>(7)
    } else { Ok<owned OwnedAbortToken, i64>(owned_abort_token_new(log, 4)) }
    match choice {
      0 -> path_consume<owned OwnedAbortToken, i64>(held)
      1 -> 0
      _ -> path_consume<owned OwnedAbortToken, i64>(held)
    }
    path_note(log, 8)
    break
  }
  42
}

test "match transfers balance initialized aggregate alternatives" {
  for choice in 0..3 {
    let log = defer_order_log_new()
    Test.assert_eq(path_match(log, choice, false), 42)
    Test.assert_eq(defer_order_log_read(log), if choice == 1 { 84 } else { 48 })
    let empty = defer_order_log_new()
    Test.assert_eq(path_match(empty, choice, true), 42)
    Test.assert_eq(defer_order_log_read(empty), 8)
  }
}

fn path_nested(log: i64, move_owner: bool) -> i64 {
  loop {
    let held: Result<owned OwnedAbortToken, i64> = Ok<owned OwnedAbortToken, i64>(owned_abort_token_new(log, 4))
    let mut inner = 0
    while inner < 2 { inner = inner + 1 }
    if move_owner { path_consume<owned OwnedAbortToken, i64>(held) } else { 0 }
    let mut after = 0
    while after < 2 { after = after + 1 }
    path_note(log, 8)
    break
  }
  42
}

test "nested backedges do not reacquire a conditionally transferred owner" {
  let moved = defer_order_log_new()
  Test.assert_eq(path_nested(moved, true), 42)
  Test.assert_eq(defer_order_log_read(moved), 48)
  let held = defer_order_log_new()
  Test.assert_eq(path_nested(held, false), 42)
  Test.assert_eq(defer_order_log_read(held), 84)
}
