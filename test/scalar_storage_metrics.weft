test "scalar accesses emit a fixed operation without runtime layout dispatch" {
  let layouts = [IrStorageEmpty, IrStorageU8, IrStorageI8, IrStorageU16, IrStorageI16, IrStorageU32, IrStorageI32, IrStorageWord64]
  for storage in layouts {
    let load = buf_new(16)
    let store = buf_new(16)
    pipeline_ir_native_emit_scalar_load(load, 17, 16, storage)
    pipeline_ir_native_emit_scalar_store(store, 16, 17, storage)
    Test.assert_true(buf_len(load) >= 4 and buf_len(load) <= 8)
    Test.assert_true(buf_len(store) <= 4)
  }
}

test "scalar layout rejects records and malformed size mode pairs" {
  Test.assert_true(not ir_scalar_storage_is_valid(cg_layout_scalar_storage(3, 0)))
  Test.assert_true(not ir_scalar_storage_is_valid(cg_layout_scalar_storage(8, cg_layout_vector_record_mode())))
  Test.assert_true(not ir_scalar_storage_is_valid(cg_layout_scalar_storage(1, 6)))
  Test.assert_true(not ir_scalar_storage_is_valid(cg_layout_scalar_storage(0 - 1, 0)))
  Test.assert_true(cg_layout_scalar_storage(8, cg_layout_vector_managed_mode()) == IrStorageWord64)
  Test.assert_true(cg_layout_scalar_storage(8, cg_layout_vector_closure_mode()) == IrStorageWord64)
  Test.assert_true(cg_layout_scalar_storage(8, cg_layout_vector_weak_mode()) == IrStorageWord64)
}

test "narrow memory encodings keep width direction and offset independent" {
  Test.assert_eq(encode_ldrh(3, 4, 6), 2034240643)
  Test.assert_eq(encode_strh(3, 4, 6), 2030046339)
  Test.assert_eq(encode_ldr_w(3, 4, 12), 3107982467)
  Test.assert_eq(encode_str_w(3, 4, 12), 3103788163)
  Test.assert_eq(encode_ldrh(3, 4, 1), encode_brk(21))
  Test.assert_eq(encode_strh(3, 4, 8192), encode_brk(21))
  Test.assert_eq(encode_ldr_w(3, 4, 2), encode_brk(21))
  Test.assert_eq(encode_str_w(3, 4, 16384), encode_brk(21))
}

test "scalar layout survives alias rewriting and inline value renumbering" {
  let layouts = [IrStorageEmpty, IrStorageU8, IrStorageI8, IrStorageU16, IrStorageI16, IrStorageU32, IrStorageI32, IrStorageWord64]
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 1, 4)
  let values = pipeline_ir_inline_value_env_bind(pipeline_ir_inline_value_env_bind(PipelineIrInlineValueEnvNil, 1, 4), 2, 5)
  for storage in layouts {
    let original = IrPtrLoadI64(2, 1, storage)
    match pipeline_ir_multi_clone_insts(IrInstCons(original, IrInstNil), values) {
      IrInstCons(IrPtrLoadI64(dst, address, actual), IrInstNil) -> {
        Test.assert_true(dst == 5 and address == 4 and actual == storage)
      }
      _ -> Test.assert_true(false)
    }
    match pipeline_ir_rewrite_inst_uses(IrPtrStoreI64(3, 1, 2, storage), aliases) {
      IrPtrStoreI64(dst, address, value, actual) -> Test.assert_true(dst == 3 and address == 4 and value == 2 and actual == storage)
      _ -> Test.assert_true(false)
    }
  }
}

test "the IR verifier rejects invalid scalar storage facts" {
  let load = ir_function_new_src(91, 1, ir_block_new_term(0,
    IrInstCons(IrPtrLoadI64(1, 0, IrStorageInvalid), IrInstNil), ir_term_return(1)), 0)
  let store = ir_function_new_src(92, 2, ir_block_new_term(0,
    IrInstCons(IrPtrStoreI64(2, 0, 1, IrStorageInvalid), IrInstNil), ir_term_return(2)), 0)
  Test.assert_eq(pipeline_ir_verify_function(load), pipeline_ir_verify_error(8, 0, 1))
  Test.assert_eq(pipeline_ir_verify_function(store), pipeline_ir_verify_error(8, 0, 2))
}
