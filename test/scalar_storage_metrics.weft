use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{str_hash}
use compiler/lib.{*}
use runtime/buffer.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}
use stdlib/test.{Test}

fn scalar_fact_count(insts: IrInstList, expected: IrScalarStorage) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrPtrLoadI64(dst, ptr, storage) -> if storage == expected { 1 } else { 0 }
        IrPtrStoreI64(dst, ptr, value, storage) -> if storage == expected { 1 } else { 0 }
        _ -> 0
      }
      here + scalar_fact_count(rest, expected)
    }
  }
}

fn scalar_block_facts(blocks: IrBlockList, expected: IrScalarStorage) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> scalar_fact_count(insts, expected) + scalar_block_facts(rest, expected)
  }
}

fn scalar_check_source(src: str, expected: IrScalarStorage) -[Test]> nil {
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let lowered = pipeline_lower_ir(typed)
  let optimized = pipeline_optimise_typed_ir(typed, lowered)
  let hash = str_hash(__str_ptr("access"), 0, 6)
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(optimized), hash) {
    IrFunctionCons(IrFunction(name, count, blocks, origin), IrFunctionNil) -> {
      Test.assert_eq(scalar_block_facts(blocks, expected), 2)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(pipeline_ir_verify_module(optimized), 0)
  nil
}

test "i8 indexed loads and stores carry exact scalar layout" {
  scalar_check_source("fn access(xs: [mut i8], i: usize, value: i8) -> i8 { let mut result = value for pass in 0..2 { xs[i] = value result = xs[i] } result } fn main() -> i64 { 0 }", IrStorageI8)
}

test "u8 indexed loads and stores carry exact scalar layout" {
  scalar_check_source("fn access(xs: [mut u8], i: usize, value: u8) -> u8 { let mut result = value for pass in 0..2 { xs[i] = value result = xs[i] } result } fn main() -> i64 { 0 }", IrStorageU8)
}

