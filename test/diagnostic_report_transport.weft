-- Expected exit code: 42
-- The canonical Diagnose operation transports the complete managed value.

use compiler/diagnose.{*}
use compiler/lib.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}

fn diagnostic_transport_emit(value: Diagnostic) -[Diagnose]> i64 {
  Diagnose.report(value)
}

fn main() -> i64 {
  let value = Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassTest,
    DiagnosticCodeAssigned("T0001"),
    "managed envelope survives effect transport",
    DiagnosticSourceRange(DiagnosticSourceNamed("diagnostic_report_transport.weft"), 4, 9),
    DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation("related", DiagnosticLocationNone),
      DiagnosticRelatedLocationNil
    ),
    DiagnosticFieldCons(
      DiagnosticFieldText("test", "schema"),
      DiagnosticFieldCons(DiagnosticFieldI64("answer", 42), DiagnosticFieldNil)
    )
  )
  handle diagnostic_transport_emit(value) {
    Diagnose.report(received) -> {
      let code_ok = if received.code().eq(DiagnosticCodeAssigned("T0001")) { 1 } else { 0 }
      let message_ok = if __str_len(received.message()) == 42 { 1 } else { 0 }
      let locations_ok = if received.related().len() == 1 { 1 } else { 0 }
      let fields_ok = if received.fields().len() == 2 { 2 } else { 0 }
      resume(37 + code_ok + message_ok + locations_ok + fields_ok)
    }
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
}
