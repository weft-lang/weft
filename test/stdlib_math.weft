use stdlib/math.{*}
use stdlib/num.{*}

fn math_same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn math_same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn math_distance3_f64(x: f64, y: f64, z: f64) -> f64 {
  math_sqrt_f64(x * x + y * y + z * z)
}

fn math_f64_square_sqrt_property(i: i64) -> bool {
  let value = num_i64_to_f64(i + 1)
  math_sqrt_f64(value * value) == value
}

fn math_f32_square_sqrt_property(i: i64) -> bool {
  let value: f32 = num_i64_to_f64(i + 1).to_f32_round()
  math_sqrt_f32(value * value) == value
}

test "math_f64_sqrt_happy_exact_squares" {
  Test.assert_eq(math_same_f64(math_sqrt_f64(0.0), 0.0), 1)
  Test.assert_eq(math_same_f64(math_sqrt_f64(1.0), 1.0), 1)
  Test.assert_eq(math_same_f64(math_sqrt_f64(4.0), 2.0), 1)
  Test.assert_eq(math_same_f64(math_sqrt_f64(9.0), 3.0), 1)
  Test.assert_eq(math_same_f64(math_sqrt_f64(144.0), 12.0), 1)
}

test "math_f64_sqrt_e2e_distance_kernel" {
  Test.assert_eq(math_same_f64(math_distance3_f64(3.0, 4.0, 12.0), 13.0), 1)
  Test.assert_eq(math_same_f64(math_distance3_f64(2.0, 3.0, 6.0), 7.0), 1)
}

test "property_math_f64_sqrt_small_squares" {
  Test.forall_i64_range(0, 32, math_f64_square_sqrt_property)
}

test "math_f64_abs_min_max_clamp_matrix" {
  Test.assert_eq(math_same_f64(math_abs_f64(0.0 - 3.5), 3.5), 1)
  Test.assert_eq(math_same_f64(math_abs_f64(2.25), 2.25), 1)
  Test.assert_eq(math_same_f64(math_min_f64(4.0, 2.0), 2.0), 1)
  Test.assert_eq(math_same_f64(math_min_f64(0.0 - 4.0, 2.0), 0.0 - 4.0), 1)
  Test.assert_eq(math_same_f64(math_max_f64(4.0, 2.0), 4.0), 1)
  Test.assert_eq(math_same_f64(math_clamp_f64(5.0, 1.0, 3.0), 3.0), 1)
  Test.assert_eq(math_same_f64(math_clamp_f64(0.0 - 2.0, 1.0, 3.0), 1.0), 1)
  Test.assert_eq(math_same_f64(math_clamp_f64(2.0, 1.0, 3.0), 2.0), 1)
}

test "math_f64_nan_infinity_adversarial_values" {
  let nan = math_nan_f64()
  let inf = math_infinity_f64()
  let neg_inf = math_negative_infinity_f64()
  Test.assert_true(math_is_nan_f64(nan))
  Test.assert_true(math_is_nan_f64(math_sqrt_f64(0.0 - 1.0)))
  Test.assert_true(math_is_infinite_f64(inf))
  Test.assert_true(math_is_infinite_f64(neg_inf))
  Test.assert_true(math_is_finite_f64(42.0))
  Test.assert_false(math_is_finite_f64(inf))
  Test.assert_false(math_is_finite_f64(nan))
  Test.assert_true(math_is_nan_f64(math_min_f64(nan, 1.0)))
  Test.assert_true(math_is_nan_f64(math_max_f64(1.0, nan)))
}

test "math_f32_sqrt_happy_exact_squares" {
  let zero: f32 = 0.0
  let one: f32 = 1.0
  let four: f32 = 4.0
  let nine: f32 = 9.0
  let three: f32 = 3.0
  Test.assert_eq(math_same_f32(math_sqrt_f32(zero), zero), 1)
  Test.assert_eq(math_same_f32(math_sqrt_f32(one), one), 1)
  Test.assert_eq(math_same_f32(math_sqrt_f32(four), 2.0), 1)
  Test.assert_eq(math_same_f32(math_sqrt_f32(nine), three), 1)
}

test "property_math_f32_sqrt_small_squares" {
  Test.forall_i64_range(0, 16, math_f32_square_sqrt_property)
}

test "math_f32_abs_min_max_clamp_matrix" {
  let neg: f32 = 0.0 - 3.5
  let pos: f32 = 2.25
  let low: f32 = 1.0
  let mid: f32 = 2.0
  let high: f32 = 3.0
  let too_high: f32 = 5.0
  Test.assert_eq(math_same_f32(math_abs_f32(neg), 3.5), 1)
  Test.assert_eq(math_same_f32(math_abs_f32(pos), pos), 1)
  Test.assert_eq(math_same_f32(math_min_f32(4.0, mid), mid), 1)
  Test.assert_eq(math_same_f32(math_max_f32(4.0, mid), 4.0), 1)
  Test.assert_eq(math_same_f32(math_clamp_f32(too_high, low, high), high), 1)
  Test.assert_eq(math_same_f32(math_clamp_f32(0.0 - 2.0, low, high), low), 1)
  Test.assert_eq(math_same_f32(math_clamp_f32(mid, low, high), mid), 1)
}

test "math_f32_nan_infinity_adversarial_values" {
  let nan = math_nan_f32()
  let inf = math_infinity_f32()
  let neg_inf = math_negative_infinity_f32()
  Test.assert_true(math_is_nan_f32(nan))
  Test.assert_true(math_is_nan_f32(math_sqrt_f32(0.0 - 1.0)))
  Test.assert_true(math_is_infinite_f32(inf))
  Test.assert_true(math_is_infinite_f32(neg_inf))
  Test.assert_true(math_is_finite_f32(42.0))
  Test.assert_false(math_is_finite_f32(inf))
  Test.assert_false(math_is_finite_f32(nan))
  Test.assert_true(math_is_nan_f32(math_min_f32(nan, 1.0)))
  Test.assert_true(math_is_nan_f32(math_max_f32(1.0, nan)))
}
