use stdlib/math as math
use stdlib/num.{*}

fn math_same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn math_same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn math_distance3_f64(x: f64, y: f64, z: f64) -> f64 {
  (x * x + y * y + z * z).sqrt()
}

fn math_f64_square_sqrt_property(i: i64) -> bool {
  let value = (i + 1).to_f64()
  (value * value).sqrt() == value
}

fn math_f32_square_sqrt_property(i: i64) -> bool {
  let value: f32 = (i + 1).to_f64().to_f32_round()
  (value * value).sqrt() == value
}

test "math_f64_sqrt_happy_exact_squares" {
  Test.assert_eq(math_same_f64((0.0).sqrt(), 0.0), 1)
  Test.assert_eq(math_same_f64((1.0).sqrt(), 1.0), 1)
  Test.assert_eq(math_same_f64((4.0).sqrt(), 2.0), 1)
  Test.assert_eq(math_same_f64((9.0).sqrt(), 3.0), 1)
  Test.assert_eq(math_same_f64((144.0).sqrt(), 12.0), 1)
}

test "math_f64_sqrt_e2e_distance_kernel" {
  Test.assert_eq(math_same_f64(math_distance3_f64(3.0, 4.0, 12.0), 13.0), 1)
  Test.assert_eq(math_same_f64(math_distance3_f64(2.0, 3.0, 6.0), 7.0), 1)
}

test "property_math_f64_sqrt_small_squares" {
  Test.forall_i64_range(0, 32, math_f64_square_sqrt_property)
}

test "math_f64_abs_min_max_clamp_matrix" {
  Test.assert_eq(math_same_f64((0.0 - 3.5).abs(), 3.5), 1)
  Test.assert_eq(math_same_f64((2.25).abs(), 2.25), 1)
  Test.assert_eq(math_same_f64((4.0).min(2.0), 2.0), 1)
  Test.assert_eq(math_same_f64((0.0 - 4.0).min(2.0), 0.0 - 4.0), 1)
  Test.assert_eq(math_same_f64((4.0).max(2.0), 4.0), 1)
  Test.assert_eq(math_same_f64((5.0).clamp(1.0, 3.0), 3.0), 1)
  Test.assert_eq(math_same_f64((0.0 - 2.0).clamp(1.0, 3.0), 1.0), 1)
  Test.assert_eq(math_same_f64((2.0).clamp(1.0, 3.0), 2.0), 1)
}

test "math_f64_nan_infinity_adversarial_values" {
  let nan = math.nan_f64()
  let inf = math.infinity_f64()
  let neg_inf = math.negative_infinity_f64()
  Test.assert_true(nan.is_nan())
  Test.assert_true((0.0 - 1.0).sqrt().is_nan())
  Test.assert_true(inf.is_infinite())
  Test.assert_true(neg_inf.is_infinite())
  Test.assert_true((42.0).is_finite())
  Test.assert_false(inf.is_finite())
  Test.assert_false(nan.is_finite())
  Test.assert_true(nan.min(1.0).is_nan())
  Test.assert_true((1.0).max(nan).is_nan())
}

test "math_f32_sqrt_happy_exact_squares" {
  let zero: f32 = 0.0
  let one: f32 = 1.0
  let four: f32 = 4.0
  let nine: f32 = 9.0
  let three: f32 = 3.0
  Test.assert_eq(math_same_f32(zero.sqrt(), zero), 1)
  Test.assert_eq(math_same_f32(one.sqrt(), one), 1)
  Test.assert_eq(math_same_f32(four.sqrt(), 2.0), 1)
  Test.assert_eq(math_same_f32(nine.sqrt(), three), 1)
}

test "property_math_f32_sqrt_small_squares" {
  Test.forall_i64_range(0, 16, math_f32_square_sqrt_property)
}

test "math_f32_abs_min_max_clamp_matrix" {
  let neg: f32 = 0.0 - 3.5
  let pos: f32 = 2.25
  let low: f32 = 1.0
  let mid: f32 = 2.0
  let high: f32 = 3.0
  let four: f32 = 4.0
  let too_high: f32 = 5.0
  let too_low: f32 = 0.0 - 2.0
  Test.assert_eq(math_same_f32(neg.abs(), 3.5), 1)
  Test.assert_eq(math_same_f32(pos.abs(), pos), 1)
  Test.assert_eq(math_same_f32(four.min(mid), mid), 1)
  Test.assert_eq(math_same_f32(four.max(mid), four), 1)
  Test.assert_eq(math_same_f32(too_high.clamp(low, high), high), 1)
  Test.assert_eq(math_same_f32(too_low.clamp(low, high), low), 1)
  Test.assert_eq(math_same_f32(mid.clamp(low, high), mid), 1)
}

test "math_f32_nan_infinity_adversarial_values" {
  let nan = math.nan_f32()
  let inf = math.infinity_f32()
  let neg_inf = math.negative_infinity_f32()
  let finite: f32 = 42.0
  let one: f32 = 1.0
  Test.assert_true(nan.is_nan())
  Test.assert_true((0.0 - one).sqrt().is_nan())
  Test.assert_true(inf.is_infinite())
  Test.assert_true(neg_inf.is_infinite())
  Test.assert_true(finite.is_finite())
  Test.assert_false(inf.is_finite())
  Test.assert_false(nan.is_finite())
  Test.assert_true(nan.min(one).is_nan())
  Test.assert_true(one.max(nan).is_nan())
}
