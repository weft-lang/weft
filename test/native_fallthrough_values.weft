-- Runtime arguments keep these branches and backedges live after inlining.
fn choose(flag: bool, a: i64, b: i64) -> i64 {
  let first = if flag { a } else { b }
  let second = if flag { b } else { a }
  first * 10 + second
}

fn rotate(count: i64) -> i64 {
  let mut first = 1
  let mut second = 2
  for index in 0..count {
    let previous = first
    first = second
    second = previous
  }
  first * 10 + second
}

fn main(argc: i64, argv: i64) -> i64 {
  let flag = argc == 1
  if choose(flag, 2, 3) == 23 and choose(not flag, 2, 3) == 32 and
    rotate(argc - 1) == 12 and rotate(argc) == 21 and rotate(argc + 1) == 12 {
    0
  } else { 1 }
}
