-- Expected exit code: 0
-- Runtime arguments keep these branches and backedges live after inlining.

use runtime/env as platform_env
use stdlib/env.{Env}

fn choose(flag: bool, a: i64, b: i64) -> i64 {
  let first = if flag { a } else { b }
  let second = if flag { b } else { a }
  first * 10 + second
}

fn rotate(count: i64) -> i64 {
  let mut first = 1
  let mut second = 2
  for index in 0..count {
    let previous = first
    first = second
    second = previous
  }
  first * 10 + second
}

fn main() -> i64 {
  -- The argument count is only known at run time, so nothing below folds.
  let argc = with platform_env() { Env.arg_count() }
  let flag = argc == 1
  if choose(flag, 2, 3) == 23 and choose(not flag, 2, 3) == 32 and
    rotate(argc - 1) == 12 and rotate(argc) == 21 and rotate(argc + 1) == 12 {
      0
    } else { 1 }
}
