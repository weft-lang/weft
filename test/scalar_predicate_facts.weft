use compiler/pipeline.{*}
use compiler/ir.{*}
use compiler/types.{*}
use stdlib/option.{Some, None}

fn predicate_test_blocks(first: IrBinaryOp, later: IrBinaryOp, swap: bool) -> IrBlockList {
  let left = if swap { 1 } else { 0 }
  let right = if swap { 0 } else { 1 }
  IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(2, first, 0, 1), IrInstNil), IrTermBranch(2, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(3, later, left, right), IrInstNil), IrTermReturn(3)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstCons(IrBinaryI64(4, later, left, right), IrInstNil), IrTermReturn(4)), IrBlockListNil)))
}

fn assert_predicate_outcomes(blocks: IrBlockList, expected: bool) -[Test]> nil {
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 2, blocks, 0)), 0)
  let facts = pipeline_ir_scalar_predicate_facts(blocks)
  match facts {
    PipelineIrScalarPredicateFacts(_, outcomes) -> {
      Test.assert_true(match outcomes.get(3) { Some(value) -> value == expected, None -> false })
      Test.assert_true(match outcomes.get(4) { Some(value) -> value != expected, None -> false })
      Test.assert_true(not outcomes.contains_key(2))
    }
  }
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 2, pipeline_ir_scalar_apply_predicates(facts), 0)), 0)
  nil
}

test "predicate facts preserve polarity swapped operands and comparison result uses" {
  assert_predicate_outcomes(predicate_test_blocks(IrLt, IrLt, false), true)
  assert_predicate_outcomes(predicate_test_blocks(IrLt, IrGe, false), false)
  assert_predicate_outcomes(predicate_test_blocks(IrLt, IrGt, true), true)
  assert_predicate_outcomes(predicate_test_blocks(IrLt, IrLe, true), false)
  assert_predicate_outcomes(predicate_test_blocks(IrEq, IrEq, true), true)
  assert_predicate_outcomes(predicate_test_blocks(IrEq, IrNe, true), false)
}

test "equal literal operands need not share SSA identity" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil,
    IrInstCons(IrConstI64(2, 0), IrInstCons(IrBinaryI64(3, IrGe, 0, 2), IrInstNil)), IrTermBranch(3, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil,
    IrInstCons(IrConstI64(4, 0), IrInstCons(IrBinaryI64(5, IrLt, 0, 4), IrInstNil)), IrTermReturn(5)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)))
  match pipeline_ir_scalar_predicate_facts(blocks) {
    PipelineIrScalarPredicateFacts(_, outcomes) -> Test.assert_true(match outcomes.get(5) { Some(value) -> not value, None -> false })
  }
}

test "another incoming edge prevents a branch outcome from dominating the merge" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(2, IrLt, 0, 1), IrInstNil), IrTermBranch(2, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(3, IrLt, 0, 1), IrInstNil), IrTermReturn(3)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermJump(7, IrValueNil)), IrBlockListNil)))
  match pipeline_ir_scalar_predicate_facts(blocks) {
    PipelineIrScalarPredicateFacts(_, outcomes) -> Test.assert_true(not outcomes.contains_key(3))
  }
}

test "a fresh load after a mutation cannot inherit a previous loaded value predicate" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil,
    IrInstCons(IrFieldLoadI64(2, 0, 5, 0), IrInstCons(IrBinaryI64(3, IrLt, 2, 1), IrInstNil)), IrTermBranch(3, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil,
    IrInstCons(IrCallI64(4, 9876, IrValueCons(0, IrValueNil)), IrInstCons(IrFieldLoadI64(5, 0, 5, 0),
    IrInstCons(IrBinaryI64(6, IrLt, 5, 1), IrInstNil))), IrTermReturn(6)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(1)), IrBlockListNil)))
  match pipeline_ir_scalar_predicate_facts(blocks) {
    PipelineIrScalarPredicateFacts(_, outcomes) -> Test.assert_true(not outcomes.contains_key(6))
  }
}

test "floating and narrow comparisons are outside the integer predicate domain" {
  for prim in [PRIM_F64(), PRIM_F32(), PRIM_U8(), PRIM_I8(), PRIM_U64()] {
    Test.assert_true(match pipeline_ir_scalar_predicate(IrFloatBinaryI64(2, prim, IrLt, 0, 1)) {
      None -> true
      Some(_) -> false
    })
  }
}

test "a loop backedge cannot establish a fact at function entry" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(2, IrLt, 0, 1), IrInstNil), IrTermBranch(2, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(3, IrLt, 0, 1), IrInstNil), IrTermJump(40, IrValueNil)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)))
  match pipeline_ir_scalar_predicate_facts(blocks) {
    PipelineIrScalarPredicateFacts(_, outcomes) -> {
      Test.assert_true(not outcomes.contains_key(2))
      Test.assert_true(match outcomes.get(3) { Some(value) -> value, None -> false })
    }
  }
}

test "pure value reuse requires a dominating evaluation and preserves operation order" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(2, IrSub, 0, 1), IrInstNil), IrTermJump(7, IrValueNil)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(3, IrSub, 0, 1),
    IrInstCons(IrBinaryI64(4, IrSub, 1, 0), IrInstNil)), IrTermReturn(3)), IrBlockListNil))
  let facts = pipeline_ir_scalar_pure_facts(blocks)
  match facts {
    PipelineIrScalarPureFacts(_, aliases) -> {
      Test.assert_true(match aliases.get(3) { Some(value) -> value == 2, None -> false })
      Test.assert_true(not aliases.contains_key(4))
    }
  }
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 2, pipeline_ir_scalar_apply_pure(facts), 0)), 0)
}

test "pure values computed in only one arm remain distinct after reconvergence" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstNil, IrTermBranch(0, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(2, IrDiv, 0, 1), IrInstNil), IrTermJump(100, IrValueNil)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermJump(100, IrValueNil)),
    IrBlockListCons(IrBlock(100, IrValueNil, IrInstCons(IrBinaryI64(3, IrDiv, 0, 1), IrInstNil), IrTermReturn(3)), IrBlockListNil))))
  match pipeline_ir_scalar_pure_facts(blocks) {
    PipelineIrScalarPureFacts(_, aliases) -> Test.assert_true(not aliases.contains_key(3))
  }
}

test "immutable word computations remain reusable across unknown calls" {
  for op in [IrAdd, IrSub, IrMul, IrDiv, IrMod, IrAnd, IrOr, IrBand, IrBor, IrBxor, IrBshl, IrBshr] {
    let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
      IrInstCons(IrBinaryI64(2, op, 0, 1), IrInstCons(IrCallI64(4, 9876, IrValueNil),
      IrInstCons(IrBinaryI64(3, op, 0, 1), IrInstNil))), IrTermReturn(3)), IrBlockListNil)
    match pipeline_ir_scalar_pure_facts(blocks) {
      PipelineIrScalarPureFacts(_, aliases) -> Test.assert_true(match aliases.get(3) { Some(value) -> value == 2, None -> false })
    }
  }
  Test.assert_true(not pipeline_ir_scalar_is_pure_value(IrBinaryI64(2, IrBinaryUnknown, 0, 1)))
  Test.assert_true(not pipeline_ir_scalar_is_pure_value(IrBinaryI64(2, IrEq, 0, 1)))
  Test.assert_true(pipeline_ir_scalar_is_pure_value(IrUnaryI64(2, IrNot, 0)))
}

test "predicate hash collisions never grant an unrelated comparison outcome" {
  let first = PipelineIrScalarPredicate(PipelineIrScalarLess, 0, 33, true)
  let other = PipelineIrScalarPredicate(PipelineIrScalarLess, 1, 0, true)
  let constants = pipeline_ir_const_env_empty()
  Test.assert_eq(pipeline_ir_scalar_predicate_hash(first, constants), pipeline_ir_scalar_predicate_hash(other, constants))
  Test.assert_true(not pipeline_ir_scalar_predicates_equal(first, other, constants))
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(36, IrLt, 0, 33), IrInstNil), IrTermBranch(36, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil, IrInstCons(IrBinaryI64(37, IrLt, 1, 0), IrInstNil), IrTermReturn(37)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)))
  match pipeline_ir_scalar_predicate_facts(blocks) {
    PipelineIrScalarPredicateFacts(_, outcomes) -> Test.assert_true(not outcomes.contains_key(37))
  }
}

test "discarded comparison results cannot become definition rewrite keys" {
  let blocks = IrBlockListCons(IrBlock(40, IrValueNil, IrInstCons(IrBinaryI64(2, IrLt, 0, 1), IrInstNil), IrTermBranch(2, 7, 90)),
    IrBlockListCons(IrBlock(7, IrValueNil,
    IrInstCons(IrBinaryI64(0 - 1, IrLt, 0, 1), IrInstCons(IrCallI64(0 - 1, 9876, IrValueNil),
    IrInstCons(IrBinaryI64(3, IrLt, 0, 1), IrInstNil))), IrTermReturn(3)),
    IrBlockListCons(IrBlock(90, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)))
  let facts = pipeline_ir_scalar_predicate_facts(blocks)
  match facts {
    PipelineIrScalarPredicateFacts(_, outcomes) -> {
      Test.assert_true(not outcomes.contains_key(0 - 1))
      Test.assert_true(match outcomes.get(3) { Some(value) -> value, None -> false })
    }
  }
  let result = pipeline_ir_scalar_apply_predicates(facts)
  Test.assert_true(match pipeline_ir_merge_find_body(result, 7) {
    IrBlockListCons(IrBlock(_, _, IrInstCons(IrBinaryI64(_, _, _, _),
      IrInstCons(IrCallI64(_, _, _), IrInstCons(IrConstI64(3, 1), IrInstNil))), _), _) -> true
    _ -> false
  })
}
