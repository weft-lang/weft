use stdlib/drop.{Drop}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, OwnedDropToken, owned_drop_token_new, defer_order_log_new, defer_order_log_read}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count}
use stdlib/result.{Result, Ok, Err}

effect AbortResult { fn stop() -> nil }

fn invoke<T, E>(body: () -[E]> T) -[E]> T { body() }

test "generic callback abort preserves the handler owned result" {
  let pending_log = defer_order_log_new()
  let returned_log = defer_order_log_new()
  let returned: owned OwnedDropToken = handle invoke(() => {
    let pending = owned_drop_token_new(pending_log)
    AbortResult.stop()
    pending
  }) {
    AbortResult.stop() -> owned_drop_token_new(returned_log)
  }
  Test.assert_eq(defer_order_log_read(pending_log), 2)
  Test.assert_eq(defer_order_log_read(returned_log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(returned_log), 2)
}

test "direct abort preserves the handler owned result" {
  let pending_log = defer_order_log_new()
  let returned_log = defer_order_log_new()
  let returned: owned OwnedDropToken = handle {
    let pending = owned_drop_token_new(pending_log)
    AbortResult.stop()
    pending
  } {
    AbortResult.stop() -> owned_drop_token_new(returned_log)
  }
  Test.assert_eq(defer_order_log_read(pending_log), 2)
  Test.assert_eq(defer_order_log_read(returned_log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(returned_log), 2)
}

fn invoke_owned(body: () -[AbortResult]> owned OwnedDropToken) -[AbortResult]> owned OwnedDropToken { body() }

test "concrete callback abort preserves the handler owned result" {
  let pending_log = defer_order_log_new()
  let returned_log = defer_order_log_new()
  let returned: owned OwnedDropToken = handle invoke_owned(() => {
    let pending = owned_drop_token_new(pending_log)
    AbortResult.stop()
    pending
  }) {
    AbortResult.stop() -> owned_drop_token_new(returned_log)
  }
  Test.assert_eq(defer_order_log_read(pending_log), 2)
  Test.assert_eq(defer_order_log_read(returned_log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(returned_log), 2)
}

type MixedResult {
  token: owned OwnedAbortToken,
  payload: RuntimeRcProbe,
  count: usize,
  ratio: f64
}

fn consume_mixed(value: MixedResult) -> i64 {
  let {token, payload, count, ratio} = value
  let answer = if count == 42 and ratio == 4.5 { runtime_rc_probe_load(payload) } else { 0 }
  token.drop()
  answer
}

fn abort_mixed(log: i64, payload: RuntimeRcProbe) -[Test]> i64 {
  let value: MixedResult = handle {
    AbortResult.stop()
    MixedResult { token: owned_abort_token_new(log, 9), payload: payload, count: 0, ratio: 0.0 }
  } {
    AbortResult.stop() -> MixedResult { token: owned_abort_token_new(log, 3), payload: payload, count: 42, ratio: 4.5 }
  }
  Test.assert_eq(defer_order_log_read(log), 0)
  consume_mixed(value)
}

test "abort transfers owned and managed record fields together" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_mixed(log, payload), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn consume_variant(value: Result<owned OwnedAbortToken, RuntimeRcProbe>) -> i64 {
  match value {
    Ok(token) -> { token.drop() 42 }
    Err(payload) -> runtime_rc_probe_load(payload)
  }
}

fn abort_variant(log: i64, payload: RuntimeRcProbe, success: bool) -[Test]> i64 {
  let value: Result<owned OwnedAbortToken, RuntimeRcProbe> = handle {
    AbortResult.stop()
    Err<owned OwnedAbortToken, RuntimeRcProbe>(payload)
  } {
    AbortResult.stop() -> if success { Ok<owned OwnedAbortToken, RuntimeRcProbe>(owned_abort_token_new(log, 4)) }
      else { Err<owned OwnedAbortToken, RuntimeRcProbe>(payload) }
  }
  Test.assert_eq(defer_order_log_read(log), 0)
  consume_variant(value)
}

test "abort transfers both linear and managed result variants" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_variant(log, payload, true), 42)
  Test.assert_eq(defer_order_log_read(log), 4)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  let other_log = defer_order_log_new()
  Test.assert_eq(abort_variant(other_log, payload, false), 42)
  Test.assert_eq(defer_order_log_read(other_log), 0)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort transfers both tuple owners and preserves abandoned drop order" {
  let log = defer_order_log_new()
  let returned: (owned OwnedAbortToken, owned OwnedAbortToken) = handle {
    let first = owned_abort_token_new(log, 1)
    let second = owned_abort_token_new(log, 2)
    AbortResult.stop()
    (first, second)
  } {
    AbortResult.stop() -> {
      let unused = owned_abort_token_new(log, 3)
      (owned_abort_token_new(log, 4), owned_abort_token_new(log, 5))
    }
  }
  Test.assert_eq(defer_order_log_read(log), 321)
  match returned {
    (first, second) -> { first.drop() second.drop() }
  }
  Test.assert_eq(defer_order_log_read(log), 32145)
}

type OpaqueResult = opaque (owned OwnedAbortToken, i64)

impl Drop for OpaqueResult {
  fn drop(self) -> i64 {
    match self { OpaqueResult((token, code)) -> token.drop() }
  }
}

test "abort transfers a zero cost opaque resource" {
  let log = defer_order_log_new()
  let returned: owned OpaqueResult = handle {
    AbortResult.stop()
    OpaqueResult((owned_abort_token_new(log, 9), 0))
  } {
    AbortResult.stop() -> OpaqueResult((owned_abort_token_new(log, 6), 42))
  }
  Test.assert_eq(defer_order_log_read(log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(log), 6)
}

effect MoveResult { fn move(value: owned OwnedAbortToken) -> nil }

test "abort transfers an operation parameter into the handler result" {
  let log = defer_order_log_new()
  let returned: owned OwnedAbortToken = handle {
    MoveResult.move(owned_abort_token_new(log, 7))
    owned_abort_token_new(log, 9)
  } {
    MoveResult.move(value) -> value
  }
  Test.assert_eq(defer_order_log_read(log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(log), 7)
}

fn abort_branch(log: i64, first: bool) -> owned OwnedAbortToken {
  handle {
    AbortResult.stop()
    owned_abort_token_new(log, 9)
  } {
    AbortResult.stop() -> if first { owned_abort_token_new(log, 1) }
      else { owned_abort_token_new(log, 2) }
  }
}

test "abort transfers either owned branch result" {
  let log = defer_order_log_new()
  let first = abort_branch(log, true)
  Test.assert_eq(defer_order_log_read(log), 0)
  first.drop()
  Test.assert_eq(defer_order_log_read(log), 1)
  let second = abort_branch(log, false)
  Test.assert_eq(defer_order_log_read(log), 1)
  second.drop()
  Test.assert_eq(defer_order_log_read(log), 12)
}

fn abort_managed(payload: RuntimeRcProbe) -> i64 {
  let returned: RuntimeRcProbe = handle {
    AbortResult.stop()
    payload
  } {
    AbortResult.stop() -> payload
  }
  runtime_rc_probe_load(returned)
}

test "ordinary managed abort results preserve their transport stake" {
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_managed(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

effect DeferredResult { @deferred fn stop() -> nil }

test "abandoning a deferred clause preserves its replacement owned result" {
  let pending_log = defer_order_log_new()
  let returned_log = defer_order_log_new()
  let returned: owned OwnedDropToken = handle {
    let pending = owned_drop_token_new(pending_log)
    DeferredResult.stop()
    pending
  } {
    DeferredResult.stop() with k -> owned_drop_token_new(returned_log)
  }
  Test.assert_eq(defer_order_log_read(pending_log), 2)
  Test.assert_eq(defer_order_log_read(returned_log), 0)
  returned.drop()
  Test.assert_eq(defer_order_log_read(returned_log), 2)
}

fn normal_mixed(log: i64, payload: RuntimeRcProbe) -> i64 {
  consume_mixed(MixedResult { token: owned_abort_token_new(log, 3), payload: payload, count: 42, ratio: 4.5 })
}

test "ordinary mixed result construction releases its managed field" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(normal_mixed(log, payload), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn abort_captured_read(payload: RuntimeRcProbe) -> i64 {
  handle { AbortResult.stop() runtime_rc_probe_load(payload) } {
    AbortResult.stop() -> runtime_rc_probe_load(payload)
  }
}

test "abortive scalar clause releases its captured read argument" {
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_captured_read(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn make_mixed(log: i64, payload: RuntimeRcProbe) -> MixedResult {
  MixedResult { token: owned_abort_token_new(log, 3), payload: payload, count: 42, ratio: 4.5 }
}

fn abort_mixed_factory(log: i64, payload: RuntimeRcProbe) -> i64 {
  let value: MixedResult = handle { AbortResult.stop() make_mixed(log, payload) } {
    AbortResult.stop() -> make_mixed(log, payload)
  }
  consume_mixed(value)
}

fn abort_mixed_bound(log: i64, payload: RuntimeRcProbe) -> i64 {
  let value: MixedResult = handle { AbortResult.stop() make_mixed(log, payload) } {
    AbortResult.stop() -> {
      let returned = MixedResult { token: owned_abort_token_new(log, 3), payload: payload, count: 42, ratio: 4.5 }
      returned
    }
  }
  consume_mixed(value)
}

test "abort record ownership agrees for factory and bound constructors" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_mixed_factory(log, payload), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  let bound_log = defer_order_log_new()
  Test.assert_eq(abort_mixed_bound(bound_log, payload), 42)
  Test.assert_eq(defer_order_log_read(bound_log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn abort_mixed_return(log: i64, payload: RuntimeRcProbe) -> MixedResult {
  handle { AbortResult.stop() make_mixed(log, payload) } {
    AbortResult.stop() -> make_mixed(log, payload)
  }
}

test "abort record results transfer across an ordinary return" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(consume_mixed(abort_mixed_return(log, payload)), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn conditional_managed(payload: RuntimeRcProbe, stop: bool) -> i64 {
  let returned = handle {
    if stop { AbortResult.stop() }
    payload
  } {
    AbortResult.stop() -> payload
  }
  runtime_rc_probe_load(returned)
}

fn transformed_managed(payload: RuntimeRcProbe, stop: bool) -> i64 {
  let returned = handle {
    if stop { AbortResult.stop() }
    0
  } {
    AbortResult.stop() -> payload
    return ignored -> payload
  }
  runtime_rc_probe_load(returned)
}

test "normal and abort completion own the same managed result stake" {
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(conditional_managed(payload, false), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  Test.assert_eq(conditional_managed(payload, true), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  Test.assert_eq(transformed_managed(payload, false), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  Test.assert_eq(transformed_managed(payload, true), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn conditional_array(payload: RuntimeRcProbe, stop: bool) -> i64 {
  let items = [payload]
  let returned: [RuntimeRcProbe; 1] = handle {
    if stop { AbortResult.stop() }
    items
  } {
    AbortResult.stop() -> items
  }
  runtime_rc_probe_load(returned[0])
}

test "normal and abort completion preserve managed fixed array ownership" {
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(conditional_array(payload, false), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  Test.assert_eq(conditional_array(payload, true), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

fn normal_bound_mixed(log: i64, payload: RuntimeRcProbe) -> i64 {
  let value = make_mixed(log, payload)
  consume_mixed(value)
}

test "ordinary named linear records transfer their backing without retaining" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(normal_bound_mixed(log, payload), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}


test "abort preserves three structural fields through resource cleanup" {
  let log = defer_order_log_new()
  let returned = handle {
    let pending = owned_drop_token_new(log)
    AbortResult.stop()
    { first: 0, second: 0, third: 0 }
  } {
    AbortResult.stop() -> { first: 11, second: 22, third: 33 }
  }
  let {first, second, third} = returned
  Test.assert_eq(defer_order_log_read(log), 2)
  Test.assert_eq(first, 11)
  Test.assert_eq(second, 22)
  Test.assert_eq(third, 33)
}

test "abort preserves eight mixed scalar fields through resource cleanup" {
  let log = defer_order_log_new()
  let returned = handle {
    let pending = owned_drop_token_new(log)
    AbortResult.stop()
    { a: 0, b: 0.0, c: false, d: 0, e: 0.0, f: 0, g: false, h: 0 }
  } {
    AbortResult.stop() -> { a: 11, b: 2.5, c: true, d: 44, e: 5.5, f: 66, g: true, h: 88 }
  }
  let {a, b, c, d, e, f, g, h} = returned
  Test.assert_eq(defer_order_log_read(log), 2)
  Test.assert_eq(a, 11)
  Test.assert_true(b == 2.5)
  Test.assert_true(c)
  Test.assert_eq(d, 44)
  Test.assert_true(e == 5.5)
  Test.assert_eq(f, 66)
  Test.assert_true(g)
  Test.assert_eq(h, 88)
}

fn abort_flat_mixed(log: i64, payload: RuntimeRcProbe) -[Test]> i64 {
  let returned = handle {
    let pending = owned_abort_token_new(log, 1)
    AbortResult.stop()
    { token: pending, payload: payload, count: 0, ratio: 0.0 }
  } {
    AbortResult.stop() -> { token: owned_abort_token_new(log, 2), payload: payload, count: 42, ratio: 4.5 }
  }
  Test.assert_eq(defer_order_log_read(log), 1)
  let {token, payload, count, ratio} = returned
  Test.assert_eq(count, 42)
  Test.assert_true(ratio == 4.5)
  let answer = runtime_rc_probe_load(payload)
  token.drop()
  answer
}

test "abort transfers flat owned and managed fields through cleanup" {
  let log = defer_order_log_new()
  let payload = runtime_rc_probe_new(42)
  Test.assert_eq(abort_flat_mixed(log, payload), 42)
  Test.assert_eq(defer_order_log_read(log), 12)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

effect WideOuter { @deferred fn pause() -> nil }
effect WideInner { @deferred fn pause() -> nil }

test "wide abort results survive nested deferred stack cleanup" {
  let log = defer_order_log_new()
  let returned = handle {
    let first = owned_abort_token_new(log, 1)
    handle {
      let second = owned_abort_token_new(log, 2)
      handle {
        let third = owned_abort_token_new(log, 3)
        WideOuter.pause()
        WideInner.pause()
        AbortResult.stop()
        { first: 0, second: 0, third: 0, fourth: 0 }
      } {
        WideInner.pause() with k -> k(nil)
      }
    } {
      WideOuter.pause() with k -> k(nil)
    }
  } {
    AbortResult.stop() -> { first: 11, second: 22, third: 33, fourth: 44 }
  }
  let {first, second, third, fourth} = returned
  Test.assert_eq(defer_order_log_read(log), 321)
  Test.assert_eq(first, 11)
  Test.assert_eq(second, 22)
  Test.assert_eq(third, 33)
  Test.assert_eq(fourth, 44)
}

test "inline deferred bodies dispatch outward scalar aborts" {
  let returned = handle {
    handle { WideInner.pause() AbortResult.stop() 0 } {
      WideInner.pause() with k -> k(nil)
    }
  } {
    AbortResult.stop() -> 42
  }
  Test.assert_eq(returned, 42)
}

effect ResultRead { fn read() -> i64 }

test "resuming clauses dispatch outward aborts through their caller frame" {
  let returned = handle {
    handle { ResultRead.read() + 1000 } {
      ResultRead.read() -> { AbortResult.stop() resume(0) }
    }
  } {
    AbortResult.stop() -> 42
  }
  Test.assert_eq(returned, 42)
}

effect RelayResult { @deferred fn step(value: i64) -> i64 }

test "deferred clauses mask their prompt and resume with its captured context" {
  let increment = 10
  let returned = handle {
    handle {
      let first = RelayResult.step(1)
      RelayResult.step(first)
    } {
      RelayResult.step(value) with k -> k(RelayResult.step(value + 1))
    }
  } {
    RelayResult.step(value) -> resume(value + increment)
  }
  Test.assert_eq(returned, 23)
}
