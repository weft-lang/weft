use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/string.{*}

fn check_reclaimed(expected: i64, sample: () -> i64) -[Test]> nil {
  Test.assert_eq(sample(), expected)
  for _ in 0..50 { sample() }
  let before = runtime_rc_test_heap_arena_offset()
  let mut total = 0
  for _ in 0..200 { total = total + sample() }
  Test.assert_eq(total, expected * 200)
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
  nil
}

fn interpolation(value: i64) -> i64 {
  let text = i"value {value}, next {value + 1}"
  if text == "value 7, next 8" { 1 } else { 0 }
}

fn discard_interpolation(value: i64) -> i64 {
  i"value {value}"
  1
}

fn text_is_seven(text: str) -> bool { text == "7" }
fn interpolate_argument(value: i64) -> i64 {
  if text_is_seven(i"{value}") { 1 } else { 0 }
}

fn nested_interpolation(value: i64) -> i64 {
  let inner = i"<{value}>"
  let text = i"outer {inner} {value}"
  if text == "outer <7> 7" and inner == "<7>" { 1 } else { 0 }
}

fn compare_indexed(value: i64) -> i64 {
  let values = [value.to_str(), (value + 1).to_str()]
  if values[0] == "7" and "8" == values[1] and values[0] != values[1] { 1 } else { 0 }
}

fn compare_left_branch(first: bool) -> i64 {
  if (if first { 7.to_str() } else { 8.to_str() }) == "7" { 1 } else { 2 }
}

fn compare_right_branch(first: bool) -> i64 {
  if "7" != (if first { 7.to_str() } else { 8.to_str() }) { 2 } else { 1 }
}

fn compare_both_branches(first: bool, second: bool) -> i64 {
  if (if first { 7.to_str() } else { 8.to_str() }) ==
     (if second { 7.to_str() } else { 8.to_str() }) { 1 } else { 2 }
}

fn compare_mixed_branch(reuse: bool) -> i64 {
  let existing = 7.to_str()
  let same = (if reuse { existing } else { 8.to_str() }) == "7"
  if existing != "7" { -1000 }
  else { if same { 1 } else { 2 } }
}

fn compare_guard(value: i64) -> i64 {
  match value {
    n if n.to_str() == "7" -> 1
    _ -> 2
  }
}

effect RenderText { fn text() -> str }
fn compare_effect() -[RenderText]> bool { RenderText.text() == "7" }
effect StopComparison { fn stop() -> never }

fn compare_abort(abort: bool) -> i64 {
  handle {
    let equal = 7.to_str() == {
      if abort { StopComparison.stop() } else { nil }
      7.to_str()
    }
    if equal { 1 } else { 0 }
  } {
    StopComparison.stop() -> 2
  }
}

test "interpolation reclaims each converted value and concatenation" {
  check_reclaimed(1, () => interpolation(7))
}

test "discarded interpolation releases its result" {
  check_reclaimed(1, () => discard_interpolation(7))
}

test "interpolation passed to a borrowing function releases its result" {
  check_reclaimed(1, () => interpolate_argument(7))
}

test "nested interpolation preserves a borrowed source and reclaims copies" {
  check_reclaimed(1, () => nested_interpolation(7))
}

test "string comparisons release owned operands on either side" {
  check_reclaimed(1, () => if 7.to_str() == "7" and "8" != 7.to_str() and 7.to_str() == 7.to_str() { 1 } else { 0 })
}

test "indexed comparison operands release their acquired stakes" {
  check_reclaimed(1, () => compare_indexed(7))
}

test "left branching comparison operands release either result" {
  check_reclaimed(3, () => compare_left_branch(true) + compare_left_branch(false))
}

test "right branching comparison operands release either result" {
  check_reclaimed(3, () => compare_right_branch(true) + compare_right_branch(false))
}

test "both branching comparison operands release every result pair" {
  check_reclaimed(6, () => compare_both_branches(true, true) + compare_both_branches(true, false) + compare_both_branches(false, true) + compare_both_branches(false, false))
}

test "mixed borrowed and fresh comparison arms preserve the local owner" {
  check_reclaimed(3, () => compare_mixed_branch(true) + compare_mixed_branch(false))
}

test "match guards release temporary strings on success and fallthrough" {
  check_reclaimed(3, () => compare_guard(7) + compare_guard(8))
}

test "resumed string operands release their transferred result" {
  check_reclaimed(1, () => {
    let equal = handle compare_effect() {
      RenderText.text() -> resume(7.to_str())
    }
    if equal { 1 } else { 0 }
  })
}

test "aborting a later operand releases the earlier temporary" {
  check_reclaimed(3, () => compare_abort(true) + compare_abort(false))
}
