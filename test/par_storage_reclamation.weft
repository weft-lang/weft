use stdlib/result
use stdlib/continuation.{*}
use stdlib/par as par
use stdlib/par.{Par, ParOk, ParErr, par_pthread_pool_start_using, par_pthread_spawn_unsafe_result}
use runtime/par_pool_storage.{runtime_par_worker_id}
use runtime/alloc_test.{runtime_alloc_mutex_storage_guard, runtime_alloc_cond_storage_guard, runtime_alloc_worker_growths_reclaimed, runtime_alloc_heap_retained_bytes, runtime_alloc_heap_retained_bytes_guard}
use runtime/alloc.{heap_capacity}
use runtime/rc.{rc_default_heap}

fn pool_answer() -> i64 {
  par.with_pool(par.pool_config(2, 2).unwrap(), () => {
    let first = par.fork(() => 20)
    let second = par.fork(() => 22)
    first.join() + second.join()
  })
}

test "platform synchronization stays within its declared storage" {
  Test.assert_eq(runtime_alloc_mutex_storage_guard(), 42)
}

test "platform condition storage includes its complete native object" {
  Test.assert_eq(runtime_alloc_cond_storage_guard(), 42)
}

test "worker context destruction releases every private growth mapping" {
  for growths in 0..4 {
    Test.assert_eq(runtime_alloc_worker_growths_reclaimed(growths), growths)
  }
}

test "repeated parallel scopes reuse their heap storage" {
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(pool_answer(), 42) }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let capacity = heap_capacity(heap)
  let mut total = 0
  for _ in 0..32 { total = total + pool_answer() }
  let after = runtime_alloc_heap_retained_bytes(heap)
  Test.assert_eq(total, 1344)
  Test.assert_eq(heap_capacity(heap), capacity)
  Test.assert_eq(after, before)
}

fn pool_start_failure(after_workers: i64) -> i64 {
  match par_pthread_pool_start_using(3, 2, (entry, worker) => {
    if runtime_par_worker_id(worker) == after_workers { ParErr(35) }
    else { par_pthread_spawn_unsafe_result(entry, worker) }
  }) {
    ParErr(error) -> error
    ParOk(pool) -> 0
  }
}

effect StopPool {
  fn stop() -> i64
}

fn pool_abort() -> i64 {
  handle par.with_pool(par.pool_config(2, 2).unwrap(), () => {
    let abandoned = par.fork(() => 42)
    StopPool.stop()
  }) {
    StopPool.stop() -> 42
  }
}

test "pool startup failure reclaims zero and partial worker prefixes" {
  let heap = rc_default_heap()
  for prefix in 0..3 {
    for _ in 0..4 { Test.assert_eq(pool_start_failure(prefix), 35) }
    let before = runtime_alloc_heap_retained_bytes(heap)
    let mut total = 0
    for _ in 0..16 { total = total + pool_start_failure(prefix) }
    let after = runtime_alloc_heap_retained_bytes(heap)
    Test.assert_eq(total, 560)
    Test.assert_eq(after, before)
  }
}

test "abort joins abandoned work and reuses pool storage" {
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(pool_abort(), 42) }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let mut total = 0
  for _ in 0..16 { total = total + pool_abort() }
  let after = runtime_alloc_heap_retained_bytes(heap)
  Test.assert_eq(total, 672)
  Test.assert_eq(after, before)
}

effect PausePool {
  @deferred fn pause() -> i64
}

fn pool_drop_suspended(cell: ContinuationCell) -> i64 {
  let first = handle par.with_pool(par.pool_config(2, 2).unwrap(), () => {
    let abandoned = par.fork(() => 42)
    PausePool.pause()
  }) {
    PausePool.pause() with k -> {
      continuation_cell_store_i64(cell, k)
      0
    }
  }
  let full = continuation_cell_is_full(cell)
  let dropped = continuation_cell_drop_i64(cell)
  if first == 0 and full == 1 and dropped == 1 and continuation_cell_is_full(cell) == 0 { 42 } else { 0 }
}

test "dropping a suspended continuation reclaims its parallel scope" {
  let cell = continuation_cell_new()
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(pool_drop_suspended(cell), 42) }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let mut total = 0
  for _ in 0..8 { total = total + pool_drop_suspended(cell) }
  let after = runtime_alloc_heap_retained_bytes(heap)
  Test.assert_eq(total, 336)
  Test.assert_eq(after, before)
}

fn sequential_map_answer() -> i64 {
  let items = [1, 2, 3, 4, 5, 6]
  par.with_sequential(() => {
    let mapped = par.map(items[..], value => value * 2)
    mapped.fold(0, (sum, value) => sum + value)
  })
}

fn pool_map_answer() -> i64 {
  let items = [1, 2, 3, 4, 5, 6]
  par.with_pool(par.pool_config(2, 1).unwrap(), () => {
    let mapped = par.map(items[..], value => value * 2)
    mapped.fold(0, (sum, value) => sum + value)
  })
}

test "sequential bulk mapping reuses carriers and observation slots" {
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(sequential_map_answer(), 42) }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let mut total = 0
  for _ in 0..16 { total = total + sequential_map_answer() }
  let after = runtime_alloc_heap_retained_bytes(heap)
  Test.assert_eq(total, 672)
  Test.assert_eq(after, before)
}

test "parallel bulk mapping reuses saturated queues and observation slots" {
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(pool_map_answer(), 42) }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let mut total = 0
  for _ in 0..16 { total = total + pool_map_answer() }
  let after = runtime_alloc_heap_retained_bytes(heap)
  Test.assert_eq(total, 672)
  Test.assert_eq(after, before)
}

test "retained storage measurement accounts for bins overflow and arena growth" {
  Test.assert_eq(runtime_alloc_heap_retained_bytes_guard(), 42)
}
