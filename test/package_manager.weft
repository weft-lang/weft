test "pkg_content_digest_is_order_independent_and_stable" {
  let forward = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(forward, pkg_content_entry("a.weft", "A"))
  vector_push<PackageContentEntry>(forward, pkg_content_entry("b.weft", "B"))
  let reverse = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(reverse, pkg_content_entry("b.weft", "B"))
  vector_push<PackageContentEntry>(reverse, pkg_content_entry("a.weft", "A"))
  let expected = "sha256:961ec0e3f0b2c031bf3a5575933caac589d62d78f9a4665959def760c07ce27f"
  Test.assert_eq(str_eq(pkg_content_digest(forward), expected), 1)
  Test.assert_eq(str_eq(pkg_content_digest(reverse), expected), 1)
}

test "pkg_content_digest_frames_path_and_content_boundaries" {
  let left = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(left, pkg_content_entry("ab", "c"))
  let right = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(right, pkg_content_entry("a", "bc"))
  Test.assert_eq(str_eq(pkg_content_digest(left), pkg_content_digest(right)), 0)
}

fn pkg_test_u8(value: i64) -> u8 { __u64_to_u8(__i64_to_u64(value)) }

fn pkg_test_tar_write_text(values: Vector<u8>, start: i64, text: str) -> i64 {
  for index in 0..__str_len(text) {
    vector_set<u8>(values, start + index, pkg_test_u8(str_byte_at(text, index)))
  }
  __str_len(text)
}

fn pkg_test_tar_write_octal(values: Vector<u8>, start: i64, width: i64, value: i64) -> i64 {
  for index in 0..width { vector_set<u8>(values, start + index, pkg_test_u8(0)) }
  let mut remaining = value
  let mut index = width - 2
  while index >= 0 {
    let digit = remaining - remaining / 8 * 8
    vector_set<u8>(values, start + index, pkg_test_u8(48 + digit))
    remaining = remaining / 8
    index = index - 1
  }
  value
}

fn pkg_test_tar_archive(path: str, kind: i64, content: str) -> Bytes {
  let values = vector_new<u8>()
  for index in 0..2048 { vector_push<u8>(values, pkg_test_u8(0)) }
  pkg_test_tar_write_text(values, 0, path)
  pkg_test_tar_write_octal(values, 124, 12, __str_len(content))
  vector_set<u8>(values, 156, pkg_test_u8(kind))
  pkg_test_tar_write_text(values, 257, "ustar")
  vector_set<u8>(values, 262, pkg_test_u8(0))
  vector_set<u8>(values, 263, pkg_test_u8(48))
  vector_set<u8>(values, 264, pkg_test_u8(48))
  for index in 148..156 { vector_set<u8>(values, index, pkg_test_u8(32)) }
  let mut checksum = 0
  for index in 0..512 { checksum = checksum + __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(values, index))) }
  let mut remaining = checksum
  let mut checksum_index = 153
  while checksum_index >= 148 {
    let digit = remaining - remaining / 8 * 8
    vector_set<u8>(values, checksum_index, pkg_test_u8(48 + digit))
    remaining = remaining / 8
    checksum_index = checksum_index - 1
  }
  vector_set<u8>(values, 154, pkg_test_u8(0))
  vector_set<u8>(values, 155, pkg_test_u8(32))
  for index in 0..__str_len(content) {
    vector_set<u8>(values, 512 + index, pkg_test_u8(str_byte_at(content, index)))
  }
  bytes.from_vector(values)
}

fn pkg_test_list_value(values: List<str>, index: i64) -> str {
  match list_nth<str>(values, index) {
    Some(value) -> value
    None -> ""
  }
}

test "pkg_archive_parser_accepts_a_strict_ustar_file" {
  match package_archive_parse(pkg_test_tar_archive("src/main.weft", 48, "fn value() -> i64 { 7 }\n")) {
    PackageArchiveInvalid(message) -> Test.assert_eq(0, 1)
    PackageArchiveParsed(entries) -> {
      Test.assert_eq(vector_len<PackageArchiveEntry>(entries), 1)
      match vector_get_in_bounds<PackageArchiveEntry>(entries, 0) {
        PackageArchiveDirectory(path) -> Test.assert_eq(0, 1)
        PackageArchiveFile(path, content) -> {
          Test.assert_str_eq(path, "src/main.weft")
          Test.assert_eq(vector_len<u8>(content.to_vector()), __str_len("fn value() -> i64 { 7 }\n"))
        }
      }
    }
  }
}

test "pkg_archive_parser_rejects_traversal_links_and_header_drift" {
  let traversal = package_archive_parse(pkg_test_tar_archive("../outside.weft", 48, "bad"))
  let link = package_archive_parse(pkg_test_tar_archive("alias.weft", 50, "target"))
  let corrupt_bytes = pkg_test_tar_archive("main.weft", 48, "ok").to_vector()
  vector_set<u8>(corrupt_bytes, 0, pkg_test_u8(88))
  let corrupt = package_archive_parse(bytes.from_vector(corrupt_bytes))
  match traversal { PackageArchiveInvalid(message) -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
  match link { PackageArchiveInvalid(message) -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
  match corrupt { PackageArchiveInvalid(message) -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
}

test "pkg_archive_paths_and_transport_digest_fail_closed" {
  Test.assert_eq(package_archive_path_safe("src/main.weft"), true)
  Test.assert_eq(package_archive_path_safe(".git/config"), false)
  Test.assert_eq(package_archive_path_safe("src/.weft/state"), false)
  Test.assert_eq(package_archive_path_safe("src/../outside"), false)
  Test.assert_str_eq(package_source_digest(bytes.from_str("abc")), "sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

test "pkg_provider_plans_pin_protocol_config_and_limits" {
  let revision = "0123456789abcdef0123456789abcdef01234567"
  let git = package_provider_git_fetch_args("/usr/bin/git", ".weft/staging/repo", "https://example.test/repo.git", revision)
  Test.assert_eq(list_len(git), 23)
  Test.assert_str_eq(pkg_test_list_value(git, 0), "GIT_CONFIG_NOSYSTEM=1")
  Test.assert_str_eq(pkg_test_list_value(git, 1), "GIT_CONFIG_GLOBAL=/dev/null")
  Test.assert_str_eq(pkg_test_list_value(git, 8), "credential.interactive=never")
  Test.assert_str_eq(pkg_test_list_value(git, 10), "core.hooksPath=/dev/null")
  Test.assert_str_eq(pkg_test_list_value(git, 14), "fetch.fsckObjects=true")
  Test.assert_str_eq(pkg_test_list_value(git, 17), "--no-tags")
  Test.assert_str_eq(pkg_test_list_value(git, 18), "--no-recurse-submodules")
  Test.assert_str_eq(pkg_test_list_value(git, 19), "--depth=1")
  Test.assert_str_eq(pkg_test_list_value(git, 20), "--no-write-fetch-head")
  Test.assert_str_eq(pkg_test_list_value(git, 22), revision)
  let curl = package_provider_curl_args("https://example.test/source.tar", ".weft/staging/source.tar", 67108864)
  Test.assert_eq(list_len(curl), 21)
  Test.assert_str_eq(pkg_test_list_value(curl, 0), "--disable")
  Test.assert_str_eq(pkg_test_list_value(curl, 5), "=https")
  Test.assert_str_eq(pkg_test_list_value(curl, 7), "=https")
  Test.assert_str_eq(pkg_test_list_value(curl, 11), "67108864")
  Test.assert_str_eq(pkg_test_list_value(curl, 20), "https://example.test/source.tar")
}

test "pkg_locked_remote_sources_decode_to_typed_variants" {
  let revision = "0123456789abcdef0123456789abcdef01234567"
  match pkg_lock_remote_source_parse("git:0123456789abcdef0123456789abcdef01234567:https://example.test/repo.git") {
    PackageRemoteSourceParsed(PackageGitSource(url, pin)) -> {
      Test.assert_str_eq(url, "https://example.test/repo.git")
      Test.assert_str_eq(pin, revision)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_lock_remote_source_parse("archive:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:https://example.test/source.tar") {
    PackageRemoteSourceParsed(PackageArchiveSource(url, checksum)) -> {
      Test.assert_str_eq(url, "https://example.test/source.tar")
      Test.assert_str_eq(checksum, "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    }
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_lock_remote_source_parse("path:deps/local") {
    PackageRemoteSourceInvalid -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

fn pkg_test_cache_manifest_text() -> str {
  "{\"package\":\"remote\",\"manifest_version\":1,\"version\":\"1.2.3\",\"weft\":\"0.1\",\"dependencies\":{}}\n"
}

fn pkg_test_cache_content(readme: str) -> str {
  let entries = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(entries, pkg_content_entry("README.md", readme))
  vector_push<PackageContentEntry>(entries, pkg_content_entry("main.weft", "fn remote() -> i64 { 9 }\n"))
  vector_push<PackageContentEntry>(entries, pkg_content_entry("weft.pkg", pkg_test_cache_manifest_text()))
  pkg_content_digest(entries)
}

fn pkg_test_cache_lock(content: str) -> i64 {
  let data = pkg_lock_data_new(1)
  nlist_add(pkg_lock_data_entries(data), pkg_lock_entry_new(
    "remote",
    "1.2.3",
    "git:0123456789abcdef0123456789abcdef01234567:https://example.test/remote.git",
    content
  ))
  data
}

fn pkg_test_cache_file_read<T>(readme: str, body: () -[FileRead]> T) -> T {
  handle body() {
    FileRead.read_all(path, limit) -> {
      let text = pkg_test_path_text(path)
      let content = if str_ends_with(text, "/weft.pkg") == 1 { pkg_test_cache_manifest_text() }
      else { if str_ends_with(text, "/main.weft") == 1 { "fn remote() -> i64 { 9 }\n" }
        else { readme } }
      resume(Ok<Bytes, IoError>(bytes.from_str(content)))
    }
  }
}

-- mode 0: ordinary tree; 1: missing root; 2: hard-linked files; 3: root link.
fn pkg_test_cache_dir_inspect<T>(mode: i64, root: str, body: () -[DirInspect, FileRead]> T) -[FileRead]> T {
  handle body() {
    DirInspect.list(path) -> {
      let entries = vector_new<Path>()
      vector_push<Path>(entries, pkg_test_path("README.md"))
      vector_push<Path>(entries, pkg_test_path("main.weft"))
      vector_push<Path>(entries, pkg_test_path("weft.pkg"))
      resume(Ok<Vector<Path>, IoError>(entries))
    }
    DirInspect.stat(path) -> resume(Ok<DirMetadata, IoError>(DirMetadata {
      exists: mode != 1, kind: if mode == 3 { DirOther } else { DirDirectory }, size: 0, modified_millis: 0, device: 41, inode: 1
    }))
    DirInspect.lstat(path) -> {
      let text = pkg_test_path_text(path)
      if str_eq(text, root) == 1 {
        resume(Ok<DirMetadata, IoError>(DirMetadata {
          exists: mode != 1, kind: if mode == 3 { DirOther } else { DirDirectory }, size: 0, modified_millis: 0, device: 41, inode: 1
        }))
      } else {
        let inode = if mode == 2 { 7 }
        else { if str_ends_with(text, "/weft.pkg") == 1 { 8 }
          else { if str_ends_with(text, "/main.weft") == 1 { 9 } else { 10 } } }
        resume(Ok<DirMetadata, IoError>(DirMetadata {
          exists: true, kind: DirFile, size: 1, modified_millis: 0, device: 41, inode: inode
        }))
      }
    }
    DirInspect.current() -> resume(Ok<Path, IoError>(pkg_test_path(".")))
  }
}

test "pkg_cache_verification_covers_every_file_and_rejects_aliases" {
  let content = pkg_test_cache_content("documentation\n")
  let data = pkg_test_cache_lock(content)
  let root = pkg_cache_root_for_content(content)
  let verified = pkg_test_cache_file_read("documentation\n", () =>
    pkg_test_cache_dir_inspect(0, root, () => pkg_lock_verify_cache_data(data)))
  match verified { PackageCacheVerified -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }

  let drift = pkg_test_cache_file_read("changed documentation\n", () =>
    pkg_test_cache_dir_inspect(0, root, () => pkg_lock_verify_cache_data(data)))
  match drift { PackageCacheCorrupt(name, digest) -> Test.assert_str_eq(name, "remote") _ -> Test.assert_eq(0, 1) }

  let hard_link = pkg_test_cache_file_read("documentation\n", () =>
    pkg_test_cache_dir_inspect(2, root, () => pkg_lock_verify_cache_data(data)))
  match hard_link { PackageCacheCorrupt(name, digest) -> Test.assert_str_eq(digest, content) _ -> Test.assert_eq(0, 1) }
}

test "pkg_cache_verification_distinguishes_missing_and_non_directory_roots" {
  let content = pkg_test_cache_content("documentation\n")
  let data = pkg_test_cache_lock(content)
  let root = pkg_cache_root_for_content(content)
  let missing = pkg_test_cache_file_read("documentation\n", () =>
    pkg_test_cache_dir_inspect(1, root, () => pkg_lock_verify_cache_data(data)))
  match missing { PackageCacheMissing(name, digest) -> Test.assert_str_eq(name, "remote") _ -> Test.assert_eq(0, 1) }

  let linked = pkg_test_cache_file_read("documentation\n", () =>
    pkg_test_cache_dir_inspect(3, root, () => pkg_lock_verify_cache_data(data)))
  match linked { PackageCacheCorrupt(name, digest) -> Test.assert_str_eq(digest, content) _ -> Test.assert_eq(0, 1) }
}

test "pkg_lock_traversal_uses_typed_path_and_byte_capabilities" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read(() =>
    pkg_test_dir_inspect(() =>
    pkg_lock_collect_source_entries(".", manifest, actual)))
  let expected = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(expected, pkg_content_entry("main.weft", "source-bytes"))
  vector_push<PackageContentEntry>(expected, pkg_content_entry("weft.pkg", "manifest-bytes"))
  Test.assert_eq(status, 0)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 2)
  Test.assert_str_eq(pkg_content_digest(actual), pkg_content_digest(expected))
}

test "pkg_lock_traversal_rejects_non_utf8_names_without_loss" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read(() =>
    pkg_test_dir_inspect_invalid_name(() =>
    pkg_lock_collect_source_entries(".", manifest, actual)))
  Test.assert_eq(status, 1)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 0)
}

test "pkg_lock_traversal_propagates_typed_file_read_failure" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read_failure(() =>
    pkg_test_dir_inspect(() =>
    pkg_lock_collect_source_entries(".", manifest, actual)))
  Test.assert_eq(status, 1)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 0)
}

test "pkg_lock_render_sorts_packages_and_pins_schema" {
  let entries = vector_new<i64>()
  vector_push<i64>(entries, pkg_lock_entry_new("lib", "2.0.0", "path:deps/lib", "sha256:bbb"))
  vector_push<i64>(entries, pkg_lock_entry_new("app", "1.0.0", "path:.", "sha256:aaa"))
  let rendered = buf_new(256)
  pkg_lock_render_into(rendered, entries)
  let expected = "{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaa\"},{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbb\"}]}\n"
  Test.assert_eq(pkg_bytes_eq_at(buf_ptr(rendered), 0, buf_len(rendered), __str_ptr(expected), 0, __str_len(expected)), 1)
}

test "pkg_lock_parser_accepts_canonical_sorted_identity" {
  let data = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}]}")
  let app = pkg_lock_data_find_name(data, __str_ptr("app"), __str_len("app"))
  let lib = pkg_lock_data_find_name(data, __str_ptr("lib"), __str_len("lib"))
  Test.assert_eq(pkg_lock_data_status(data), 1)
  Test.assert_eq(pkg_lock_data_count(data), 2)
  Test.assert_str_eq(pkg_lock_entry_version(app), "1.0.0")
  Test.assert_str_eq(pkg_lock_entry_source(lib), "path:deps/lib")
  Test.assert_str_eq(pkg_lock_entry_content(lib), "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
}

test "pkg_lock_parser_accepts_exact_remote_source_identities" {
  let data = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"archive_dep\",\"version\":\"1.0.0\",\"source\":\"archive:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:https://example.test/archive-dep.tar\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"},{\"name\":\"git_dep\",\"version\":\"2.0.0\",\"source\":\"git:0123456789abcdef0123456789abcdef01234567:https://example.test/git-dep.git\",\"content\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\"}]}")
  Test.assert_eq(pkg_lock_data_status(data), 1)
  Test.assert_str_eq(pkg_lock_entry_source(pkg_lock_data_find_name(data, __str_ptr("archive_dep"), __str_len("archive_dep"))), "archive:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:https://example.test/archive-dep.tar")
  Test.assert_str_eq(pkg_lock_entry_source(pkg_lock_data_find_name(data, __str_ptr("git_dep"), __str_len("git_dep"))), "git:0123456789abcdef0123456789abcdef01234567:https://example.test/git-dep.git")
  Test.assert_str_eq(pkg_cache_root_for_content("sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"), ".weft/cache/sha256/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
}

test "pkg_lock_parser_rejects_moving_or_ambiguous_remote_identities" {
  let moving = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"dep\",\"version\":\"1.0.0\",\"source\":\"git:main:https://example.test/dep.git\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  let insecure = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"dep\",\"version\":\"1.0.0\",\"source\":\"archive:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:http://example.test/dep.tar\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}]}")
  let fragment = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"dep\",\"version\":\"1.0.0\",\"source\":\"git:0123456789abcdef0123456789abcdef01234567:https://example.test/dep.git#main\",\"content\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\"}]}")
  Test.assert_eq(pkg_lock_data_status(moving), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(insecure), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(fragment), 0 - 1)
}

test "pkg_lock_parser_rejects_root_schema_matrix" {
  let malformed = pkg_lock_parse("{\"lock_version\":")
  let future_lock = pkg_lock_parse("{\"lock_version\":2,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[]}")
  let future_manifest = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":2,\"weft\":\"0.1\",\"packages\":[]}")
  let wrong_weft = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.2\",\"packages\":[]}")
  let unknown_key = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"unknown\":[]}")
  let empty = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[]}")
  Test.assert_eq(pkg_lock_data_status(malformed), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(future_lock), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(future_manifest), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(wrong_weft), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(unknown_key), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(empty), 0 - 1)
}

test "pkg_lock_parser_rejects_entry_identity_matrix" {
  let bad_digest = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:short\"}]}")
  let traversal = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:../app\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  let unsorted = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"},{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  let duplicate = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  Test.assert_eq(pkg_lock_data_status(bad_digest), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(traversal), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(unsorted), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(duplicate), 0 - 1)
}

test "pkg_lock_match_requires_version_source_and_toolchain" {
  let data = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}]}")
  let exact = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"2.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let wrong_version = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"3.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let wrong_weft = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"2.0.0\",\"weft\":\"0.2\",\"dependencies\":{}}")
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), exact, "path:deps/lib") > 0, true)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), wrong_version, "path:deps/lib"), 0 - 1)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), wrong_weft, "path:deps/lib"), 0 - 1)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), exact, "path:vendor/lib"), 0 - 1)
}

fn pkg_manifest_parse_transient_trust() -> i64 {
  let source = runtime_str_from_bytes_copy(
    __str_ptr("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}"),
    __str_len("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}")
  )
  pkg_manifest_parse_str(source)
}

test "pkg_manifest_trust_schema_round_trips_stable_identity" {
  let m = pkg_manifest_parse_transient_trust()
  let grant = pkg_manifest_find_trust_grant(m, __str_ptr("tls"), __str_len("tls"))
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_trusted_binding_count(m), 1)
  Test.assert_eq(pkg_manifest_trust_grant_count(m), 1)
  Test.assert_eq(pkg_manifest_declares_trusted_binding(m, __str_ptr("native/root"), __str_len("native/root")), 1)
  Test.assert_eq(pkg_trust_grant_names_module(grant, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 1)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"app\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{\"tls\":{\"path\":\"deps/tls\"}},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}\n"), 1)
}

test "pkg_manifest_trust_rejects_module_path_matrix" {
  let empty = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"\"]}")
  let absolute = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"/native/raw\"]}")
  let empty_segment = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native//raw\"]}")
  let dot = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/./raw\"]}")
  let dotdot = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/../raw\"]}")
  let extension = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw.weft\"]}")
  let duplicate = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\",\"native/raw\"]}")
  Test.assert_eq(if pkg_manifest_error_count(empty) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(absolute) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(empty_segment) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(dot) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(dotdot) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(extension) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate) > 0 { 1 } else { 0 }, 1)
}

test "pkg_manifest_trust_rejects_grant_shape_and_identity_matrix" {
  let wrong_trust_shape = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":[]}")
  let wrong_grant_shape = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":[]}}")
  let missing_key = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"modules\":[\"native/raw\"]}}}")
  let unknown_key = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"],\"extra\":1}}}")
  let bad_version = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1 / 2\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  let bad_source = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"git:https://example.test/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  let bad_content = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:short\",\"modules\":[\"native/raw\"]}}}")
  let empty_modules = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[]}}}")
  let self_grant = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"app\":{\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  Test.assert_eq(if pkg_manifest_error_count(wrong_trust_shape) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(wrong_grant_shape) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(missing_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_version) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_source) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_content) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(empty_modules) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(self_grant) > 0 { 1 } else { 0 }, 1)
}

test "pkg_binding_trust_requires_declaration_grant_and_locked_identity" {
  let digest = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let root = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}")
  let dependency = pkg_manifest_parse_str("{\"package\":\"tls\",\"version\":\"1.2.0\",\"trusted_bindings\":[\"native/raw_tls\"]}")
  let tt = ttable_new()
  pkg_identity_register_root(tt, root)
  let dependency_id = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), dependency, 0, __str_ptr(digest), __str_len(digest))
  Test.assert_eq(pkg_binding_module_trust_state(tt, dependency_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, dependency_id, __str_ptr("native/safe"), __str_len("native/safe")), 0)

  let unlocked_tt = ttable_new()
  pkg_identity_register_root(unlocked_tt, root)
  let unlocked_id = pkg_identity_intern_under_owner(unlocked_tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), dependency, 0)
  Test.assert_eq(pkg_binding_module_trust_state(unlocked_tt, unlocked_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 0 - 1)

  let undeclared_tt = ttable_new()
  pkg_identity_register_root(undeclared_tt, root)
  let undeclared = pkg_manifest_parse_str("{\"package\":\"tls\",\"version\":\"1.2.0\"}")
  let undeclared_id = pkg_identity_intern_under_owner_with_content(undeclared_tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), undeclared, 0, __str_ptr(digest), __str_len(digest))
  Test.assert_eq(pkg_binding_module_trust_state(undeclared_tt, undeclared_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 0 - 1)
}

test "pkg_root_binding_declaration_is_self_authorizing_and_exact" {
  let tt = ttable_new()
  let root = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"]}")
  pkg_identity_register_root(tt, root)
  Test.assert_eq(pkg_binding_module_trust_state(tt, 0, __str_ptr("native/raw"), __str_len("native/raw")), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, 0, __str_ptr("native/helper"), __str_len("native/helper")), 0)
}

fn pkg_native_manifest_text() -> str {
  "{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false},{\"id\":\"fixture\",\"kind\":\"archive\",\"link\":\"weft_fixture\",\"search\":[\"native/lib\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"license\":\"MIT OR Apache-2.0\",\"optional\":true}],\"symbols\":[{\"declaration\":\"native_scalars\",\"symbol\":\"weft_scalars\",\"library\":\"system\",\"params\":[\"i8\",\"u8\",\"i16\",\"u16\",\"i32\",\"u32\",\"i64\",\"u64\"],\"result\":\"f64\",\"optional\":false},{\"declaration\":\"native_views\",\"symbol\":\"weft_views\",\"library\":\"fixture\",\"params\":[\"isize\",\"usize\",\"f32\",\"f64\",\"opaque_ptr\",\"const_ptr\",\"mut_ptr\"],\"result\":\"opaque_ptr\",\"optional\":true}]},\"linux-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"c\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_close\",\"symbol\":\"close\",\"library\":\"system\",\"params\":[\"i32\"],\"result\":\"i32\",\"optional\":false}]}}}}}"
}

test "pkg_native_binding_schema_round_trips_complete_typed_fact" {
  let m = pkg_manifest_parse_str(pkg_native_manifest_text())
  let binding = pkg_manifest_find_native_binding(m, __str_ptr("native/raw"), __str_len("native/raw"))
  let macos = pkg_native_binding_find_target(binding, pkg_native_target_macos_aarch64())
  let linux = pkg_native_binding_find_target(binding, pkg_native_target_linux_aarch64())
  let fixture = pkg_native_target_find_library(macos, __str_ptr("fixture"), __str_len("fixture"))
  let views = pkg_native_target_find_symbol(macos, __str_ptr("native_views"), __str_len("native_views"))
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_native_binding_count(m), 1)
  Test.assert_eq(pkg_native_binding_abi(binding), 1)
  Test.assert_eq(nlist_len(pkg_native_binding_targets(binding)), 2)
  Test.assert_eq(nlist_len(pkg_native_target_libraries(macos)), 2)
  Test.assert_eq(nlist_len(pkg_native_target_symbols(macos)), 2)
  Test.assert_eq(nlist_len(pkg_native_target_symbols(linux)), 1)
  Test.assert_eq(pkg_native_library_kind(fixture), pkg_native_library_kind_archive())
  Test.assert_eq(pkg_native_library_optional(fixture), 1)
  match pkg_native_library_license_fact(fixture) {
    NativeLibraryLicenseDeclared(value) -> Test.assert_eq(str_eq(value, "MIT OR Apache-2.0"), 1)
    NativeLibraryLicenseUnspecified -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(nlist_len(pkg_native_symbol_params(views)), 7)
  Test.assert_eq(pkg_native_symbol_result(views), pkg_native_abi_opaque_pointer())
  Test.assert_eq(pkg_native_symbol_optional(views), 1)
  match pkg_native_binding_fact(binding) {
    NativeBindingFact(module, abi, targets) -> {
      Test.assert_eq(str_eq(module, "native/raw"), 1)
      Test.assert_eq(abi, 1)
      Test.assert_eq(list_len<NativeTargetFact>(targets), 2)
      match list_first_or<NativeTargetFact>(targets, NativeTargetFact(NativeMacosAarch64, list_nil<NativeLibraryFact>(), list_nil<NativeSymbolFact>())) {
        NativeTargetFact(target, libraries, symbols) -> {
          match target { NativeMacosAarch64 -> Test.assert_eq(1, 1) NativeLinuxAarch64 -> Test.assert_eq(0, 1) }
          Test.assert_eq(list_len<NativeLibraryFact>(libraries), 2)
          Test.assert_eq(list_len<NativeSymbolFact>(symbols), 2)
        }
      }
    }
  }
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"sdk\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{},\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false},{\"id\":\"fixture\",\"kind\":\"archive\",\"link\":\"weft_fixture\",\"search\":[\"native/lib\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"license\":\"MIT OR Apache-2.0\",\"optional\":true}],\"symbols\":[{\"declaration\":\"native_scalars\",\"symbol\":\"weft_scalars\",\"library\":\"system\",\"params\":[\"i8\",\"u8\",\"i16\",\"u16\",\"i32\",\"u32\",\"i64\",\"u64\"],\"result\":\"f64\",\"optional\":false},{\"declaration\":\"native_views\",\"symbol\":\"weft_views\",\"library\":\"fixture\",\"params\":[\"isize\",\"usize\",\"f32\",\"f64\",\"opaque_ptr\",\"const_ptr\",\"mut_ptr\"],\"result\":\"opaque_ptr\",\"optional\":true}]},\"linux-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"c\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_close\",\"symbol\":\"close\",\"library\":\"system\",\"params\":[\"i32\"],\"result\":\"i32\",\"optional\":false}]}}}}}\n"), 1)
}

test "pkg_native_binding_source_fact_joins_exact_authority_and_target" {
  let manifest = pkg_manifest_parse_str(pkg_native_manifest_text())
  let tt = ttable_new()
  pkg_identity_register_root(tt, manifest)
  let source = "fn wrapper() -> i64 { 0 }"
  let entry = pkg_native_binding_source_register(tt, __str_ptr(source), 0, __str_ptr("native/raw"), __str_len("native/raw"))
  Test.assert_eq(if entry > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_native_binding_source_count(tt), 1)
  Test.assert_eq(ttable_native_binding_source_package(entry), 0)
  Test.assert_eq(ttable_native_binding_source_source(entry), __str_ptr(source))
  Test.assert_eq(ttable_native_binding_source_binding(entry), pkg_manifest_find_native_binding(manifest, __str_ptr("native/raw"), __str_len("native/raw")))
  Test.assert_eq(ttable_native_binding_source_target(entry), pkg_native_binding_find_target(ttable_native_binding_source_binding(entry), pkg_native_compilation_target()))
  Test.assert_eq(pkg_native_binding_source_register(tt, __str_ptr(source), 0, __str_ptr("native/raw"), __str_len("native/raw")), entry)
}

test "pkg_native_manifest_selection_uses_the_sealed_host_target_fact" {
  Test.assert_eq(pkg_native_compilation_target(), sys_native_host_target())
  Test.assert_eq(
    if pkg_native_compilation_target() == pkg_native_target_macos_aarch64() or
    pkg_native_compilation_target() == pkg_native_target_linux_aarch64() { 1 } else { 0 },
    1
  )
}

test "pkg_native_manifest_selection_consumes_an_explicit_table target" {
  let selected = if pkg_native_compilation_target() == pkg_native_target_macos_aarch64() {
    pkg_native_target_linux_aarch64()
  } else { pkg_native_target_macos_aarch64() }
  let manifest = pkg_manifest_parse_str(pkg_native_manifest_text())
  let tt = ttable_new()
  pkg_identity_register_root(tt, manifest)
  Test.assert_eq(ttable_native_compilation_target(tt), 0)
  Test.assert_eq(pkg_native_compilation_target_for_table(tt), pkg_native_compilation_target())
  ttable_set_native_compilation_target(tt, selected)
  Test.assert_eq(pkg_native_compilation_target_for_table(tt), selected)
  let source = "fn wrapper() -> i64 { 0 }"
  let entry = pkg_native_binding_source_register(tt, __str_ptr(source), 0, __str_ptr("native/raw"), __str_len("native/raw"))
  Test.assert_eq(if entry > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_native_binding_source_target(entry), pkg_native_binding_find_target(ttable_native_binding_source_binding(entry), selected))
}

test "pkg_native_binding_source_fact_refuses_target_substitution" {
  let manifest_text = if pkg_native_compilation_target() == pkg_native_target_macos_aarch64() {
    "{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"linux-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"c\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_close\",\"symbol\":\"close\",\"library\":\"system\",\"params\":[\"i32\"],\"result\":\"i32\",\"optional\":false}]}}}}}"
  } else {
    "{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_close\",\"symbol\":\"close\",\"library\":\"system\",\"params\":[\"i32\"],\"result\":\"i32\",\"optional\":false}]}}}}}"
  }
  let manifest = pkg_manifest_parse_str(manifest_text)
  let tt = ttable_new()
  pkg_identity_register_root(tt, manifest)
  Test.assert_eq(pkg_manifest_error_count(manifest), 0)
  Test.assert_eq(pkg_native_binding_source_register(tt, __str_ptr("source"), 0, __str_ptr("native/raw"), __str_len("native/raw")), 0 - 1)
  Test.assert_eq(ttable_native_binding_source_count(tt), 0)
}

test "pkg_native_binding_byte_products_are_typed_and_register_bounded" {
  let accepted = pkg_manifest_parse_str("{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"native_bytes\",\"symbol\":\"native_bytes\",\"library\":\"system\",\"params\":[\"const_bytes\",\"mut_bytes\",\"i64\",\"i64\",\"i64\",\"i64\"],\"result\":\"i64\",\"optional\":false}]}}}}}")
  let binding = pkg_manifest_find_native_binding(accepted, __str_ptr("native/raw"), __str_len("native/raw"))
  let target = pkg_native_binding_find_target(binding, pkg_native_target_macos_aarch64())
  let symbol = pkg_native_target_find_symbol(target, __str_ptr("native_bytes"), __str_len("native_bytes"))
  let params = pkg_native_symbol_params(symbol)
  Test.assert_eq(pkg_manifest_error_count(accepted), 0)
  Test.assert_eq(nlist_get(params, 0), pkg_native_abi_const_bytes())
  Test.assert_eq(nlist_get(params, 1), pkg_native_abi_mut_bytes())
  match pkg_native_abi_type_fact(nlist_get(params, 0)) {
    NativeAbiConstBytes -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_native_abi_type_fact(nlist_get(params, 1)) {
    NativeAbiMutBytes -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }

  let buffer_result = pkg_manifest_parse_str("{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"bad\",\"symbol\":\"bad\",\"library\":\"system\",\"params\":[],\"result\":\"const_bytes\",\"optional\":false}]}}}}}")
  let too_wide = pkg_manifest_parse_str("{\"package\":\"sdk\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"bad\",\"symbol\":\"bad\",\"library\":\"system\",\"params\":[\"const_bytes\",\"const_bytes\",\"const_bytes\",\"const_bytes\",\"i64\"],\"result\":\"i64\",\"optional\":false}]}}}}}")
  Test.assert_eq(if pkg_manifest_error_count(buffer_result) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(too_wide) > 0 { 1 } else { 0 }, 1)
}

test "pkg_native_binding_rejects_authority_version_target_and_shape_matrix" {
  let undeclared = pkg_manifest_parse_str("{\"package\":\"app\",\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{}}}}")
  let future_abi = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":2,\"targets\":{\"macos-aarch64\":{\"libraries\":[],\"symbols\":[]}}}}}")
  let unknown_target = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"windows-x64\":{\"libraries\":[],\"symbols\":[]}}}}}")
  let unknown_binding_key = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{},\"callbacks\":true}}}")
  let duplicate_module = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{}},\"native/raw\":{\"abi_version\":1,\"targets\":{}}}}")
  Test.assert_eq(if pkg_manifest_error_count(undeclared) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(future_abi) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_target) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_binding_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_module) > 0 { 1 } else { 0 }, 1)
}

test "pkg_native_binding_rejects_library_provenance_and_search_matrix" {
  let unknown_kind = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"framework\",\"link\":\"X\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[]}}}}}")
  let system_digest = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"system\",\"link\":\"X\",\"search\":[\"toolchain\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"optional\":false}],\"symbols\":[]}}}}}")
  let artifact_toolchain = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"archive\",\"link\":\"X\",\"search\":[\"toolchain\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"optional\":false}],\"symbols\":[]}}}}}")
  let traversal = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"dynamic\",\"link\":\"X\",\"search\":[\"../lib\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"optional\":false}],\"symbols\":[]}}}}}")
  let empty_license = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"archive\",\"link\":\"X\",\"search\":[\"native\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"license\":\"\",\"optional\":false}],\"symbols\":[]}}}}}")
  let non_text_license = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"x\",\"kind\":\"archive\",\"link\":\"X\",\"search\":[\"native\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"license\":7,\"optional\":false}],\"symbols\":[]}}}}}")
  Test.assert_eq(if pkg_manifest_error_count(unknown_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(system_digest) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(artifact_toolchain) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(traversal) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(empty_license) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(non_text_license) > 0 { 1 } else { 0 }, 1)
}

test "pkg_native_binding_rejects_symbol_abi_and_optionality_matrix" {
  let missing_library = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"x\",\"symbol\":\"x\",\"library\":\"missing\",\"params\":[],\"result\":\"i64\",\"optional\":false}]}}}}}")
  let nil_param = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"x\",\"symbol\":\"x\",\"library\":\"system\",\"params\":[\"nil\"],\"result\":\"i64\",\"optional\":false}]}}}}}")
  let pointer_result = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"x\",\"symbol\":\"x\",\"library\":\"system\",\"params\":[],\"result\":\"mut_ptr\",\"optional\":false}]}}}}}")
  let too_many = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"system\",\"kind\":\"system\",\"link\":\"System\",\"search\":[\"toolchain\"],\"content\":\"toolchain\",\"optional\":false}],\"symbols\":[{\"declaration\":\"x\",\"symbol\":\"x\",\"library\":\"system\",\"params\":[\"i64\",\"i64\",\"i64\",\"i64\",\"i64\",\"i64\",\"i64\",\"i64\",\"i64\"],\"result\":\"i64\",\"optional\":false}]}}}}}")
  let required_from_optional = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"],\"native_bindings\":{\"native/raw\":{\"abi_version\":1,\"targets\":{\"macos-aarch64\":{\"libraries\":[{\"id\":\"xlib\",\"kind\":\"archive\",\"link\":\"x\",\"search\":[\"native\"],\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"optional\":true}],\"symbols\":[{\"declaration\":\"x\",\"symbol\":\"x\",\"library\":\"xlib\",\"params\":[],\"result\":\"nil\",\"optional\":false}]}}}}}")
  Test.assert_eq(if pkg_manifest_error_count(missing_library) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(nil_param) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(pointer_result) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(too_many) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(required_from_optional) > 0 { 1 } else { 0 }, 1)
}

test "pkg_manifest_exports_round_trip_grammar_and_tool_metadata" {
  let m = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"},\"gpu\":{\"module\":\"grammar/gpu\",\"declaration\":\"GpuGrammar\",\"execution\":\"typed_plan\"},\"html\":{\"module\":\"grammar/html\",\"declaration\":\"HtmlGrammar\",\"execution\":\"runtime\"}},\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}")
  let sql = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("sql"), __str_len("sql"))
  let gpu = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("gpu"), __str_len("gpu"))
  let html = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("html"), __str_len("html"))
  let lint = pkg_manifest_find_export(m, pkg_export_kind_tool(), __str_ptr("lint"), __str_len("lint"))
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_export_count(m), 4)
  Test.assert_eq(pkg_export_execution(sql), pkg_export_execution_validate_only())
  Test.assert_eq(pkg_export_execution(gpu), pkg_export_execution_typed_plan())
  Test.assert_eq(pkg_export_execution(html), pkg_export_execution_runtime())
  Test.assert_eq(pkg_export_execution(lint), pkg_export_execution_none())
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"sdk\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{},\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"},\"gpu\":{\"module\":\"grammar/gpu\",\"declaration\":\"GpuGrammar\",\"execution\":\"typed_plan\"},\"html\":{\"module\":\"grammar/html\",\"declaration\":\"HtmlGrammar\",\"execution\":\"runtime\"}},\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}\n"), 1)
}

test "pkg_manifest_exports_rejects_root_and_kind_shapes" {
  let array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":[]}")
  let unknown_kind = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"plugins\":{}}}")
  let grammar_array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":[]}}")
  let tool_array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":[]}}")
  let duplicate_kind = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{},\"tools\":{}}}")
  let duplicate_root = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{},\"exports\":{}}")
  Test.assert_eq(if pkg_manifest_error_count(array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(grammar_array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(tool_array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_root) > 0 { 1 } else { 0 }, 1)
}

test "pkg_manifest_exports_rejects_entry_shape_path_name_and_execution" {
  let missing_declaration = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\"}}}}")
  let tool_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\",\"execution\":\"runtime\"}}}}")
  let missing_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\"}}}}")
  let unknown_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"magic\"}}}}")
  let extension = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint.weft\",\"declaration\":\"main\"}}}}")
  let traversal = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"../lint\",\"declaration\":\"main\"}}}}")
  let bad_public_name = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"bad-name\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}")
  let bad_declaration = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"bad.name\"}}}}")
  Test.assert_eq(if pkg_manifest_error_count(missing_declaration) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(tool_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(missing_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(extension) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(traversal) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_public_name) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_declaration) > 0 { 1 } else { 0 }, 1)
}
