test "pkg_manifest_sad_unknown_directive" {
  let m = pkg_manifest_parse_str("package app\nsource deps/math\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
}

test "pkg_manifest_sad_missing_dep_path" {
  let m = pkg_manifest_parse_str("package app\ndep math\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_manifest_sad_duplicate_dep" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\ndep math deps/other\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
}

test "pkg_manifest_sad_unsupported_version_token" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math 1.0.0\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_manifest_adversarial_rejects_traversal_and_absolute_paths" {
  let traversal = pkg_manifest_parse_str("package app\ndep evil ../outside\n")
  let absolute = pkg_manifest_parse_str("package app\ndep root /tmp/root\n")
  Test.assert_eq(pkg_manifest_error_count(traversal), 1)
  Test.assert_eq(pkg_manifest_error_count(absolute), 1)
  Test.assert_eq(pkg_manifest_dep_count(traversal), 0)
  Test.assert_eq(pkg_manifest_dep_count(absolute), 0)
}

test "pkg_manifest_adversarial_empty_manifest" {
  let m = pkg_manifest_parse_str("")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_manifest_json_sad_malformed_and_wrong_shape" {
  let malformed = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":")
  let wrong_root = pkg_manifest_parse_str("[\"app\"]")
  let wrong_package = pkg_manifest_parse_str("{\"package\":42,\"dependencies\":{}}")
  let wrong_deps = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":[]}")
  Test.assert_eq(pkg_manifest_error_count(malformed), 1)
  Test.assert_eq(pkg_manifest_error_count(wrong_root), 1)
  Test.assert_eq(pkg_manifest_error_count(wrong_package), 1)
  Test.assert_eq(pkg_manifest_error_count(wrong_deps), 1)
}

test "pkg_manifest_json_sad_invalid_dep_values" {
  let traversal = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{\"evil\":\"../outside\"}}")
  let duplicate = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{\"math\":\"deps/math\",\"math\":\"deps/other\"}}")
  let non_string = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{\"math\":42}}")
  let unknown = pkg_manifest_parse_str("{\"package\":\"app\",\"deps\":{\"math\":\"deps/math\"}}")
  Test.assert_eq(pkg_manifest_error_count(traversal), 1)
  Test.assert_eq(pkg_manifest_error_count(duplicate), 1)
  Test.assert_eq(pkg_manifest_error_count(non_string), 1)
  Test.assert_eq(pkg_manifest_error_count(unknown), 1)
  Test.assert_eq(pkg_manifest_dep_count(non_string), 0)
}

test "pkg_manifest_json_sad_schema_and_version_matrix" {
  let future_schema = pkg_manifest_parse_str("{\"package\":\"app\",\"manifest_version\":2,\"dependencies\":{}}")
  let string_schema = pkg_manifest_parse_str("{\"package\":\"app\",\"manifest_version\":\"1\",\"dependencies\":{}}")
  let empty_version = pkg_manifest_parse_str("{\"package\":\"app\",\"version\":\"\",\"dependencies\":{}}")
  let bad_version = pkg_manifest_parse_str("{\"package\":\"app\",\"version\":\"1 / 2\",\"dependencies\":{}}")
  let numeric_weft = pkg_manifest_parse_str("{\"package\":\"app\",\"weft\":1,\"dependencies\":{}}")
  Test.assert_eq(pkg_manifest_error_count(future_schema), 1)
  Test.assert_eq(pkg_manifest_error_count(string_schema), 1)
  Test.assert_eq(pkg_manifest_error_count(empty_version), 1)
  Test.assert_eq(pkg_manifest_error_count(bad_version), 1)
  Test.assert_eq(pkg_manifest_error_count(numeric_weft), 1)
}

test "pkg_manifest_targets_round_trip_as_typed_variants" {
  let m = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"src\",\"tools\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"src/main.weft\"},\"support\":{\"kind\":\"library\",\"source\":\"src/lib.weft\"},\"inspect\":{\"kind\":\"binary\",\"source\":\"tools/inspect.weft\"}},\"dependencies\":{}}")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_source_root_count(m), 2)
  Test.assert_eq(pkg_manifest_target_count(m), 3)
  match pkg_manifest_select_target(m, "app") {
    PackageTargetSelected(target) -> match target {
      PackageBinaryTarget(name, source) -> {
        Test.assert_eq(str_eq(name, "app"), 1)
        Test.assert_eq(str_eq(source, "src/main.weft"), 1)
      }
      PackageLibraryTarget(name, source) -> Test.assert_eq(0, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_manifest_select_target(m, "support") {
    PackageTargetSelected(target) -> match target {
      PackageLibraryTarget(name, source) -> {
        Test.assert_eq(str_eq(name, "support"), 1)
        Test.assert_eq(str_eq(source, "src/lib.weft"), 1)
      }
      PackageBinaryTarget(name, source) -> Test.assert_eq(0, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"app\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{},\"source_roots\":[\"src\",\"tools\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"src/main.weft\"},\"support\":{\"kind\":\"library\",\"source\":\"src/lib.weft\"},\"inspect\":{\"kind\":\"binary\",\"source\":\"tools/inspect.weft\"}}}\n"), 1)
}

test "pkg_manifest_default_target_selection_is_structural" {
  let package_named = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"worker\":{\"kind\":\"binary\",\"source\":\"worker.weft\"},\"app\":{\"kind\":\"binary\",\"source\":\"main.weft\"}}}")
  let sole = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"src\"],\"targets\":{\"cli\":{\"kind\":\"binary\",\"source\":\"src/cli.weft\"},\"api\":{\"kind\":\"library\",\"source\":\"src/lib.weft\"}}}")
  let ambiguous = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"one\":{\"kind\":\"binary\",\"source\":\"one.weft\"},\"two\":{\"kind\":\"binary\",\"source\":\"two.weft\"}}}")
  let library_only = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"src\"],\"targets\":{\"api\":{\"kind\":\"library\",\"source\":\"src/lib.weft\"}}}")
  match pkg_manifest_select_target(package_named, "") {
    PackageTargetSelected(PackageBinaryTarget(name, source)) -> Test.assert_eq(str_eq(name, "app"), 1)
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_manifest_select_target(sole, "") {
    PackageTargetSelected(PackageBinaryTarget(name, source)) -> Test.assert_eq(str_eq(name, "cli"), 1)
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_manifest_select_target(ambiguous, "") {
    PackageTargetAmbiguous -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_manifest_select_target(library_only, "") {
    PackageTargetMissing -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match pkg_manifest_select_target(sole, "missing") {
    PackageTargetMissing -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "pkg_manifest_target_schema_rejects_invalid_roots_and_entries" {
  let empty_roots = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"app.weft\"}}}")
  let duplicate_root = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"src\",\"src\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"src/app.weft\"}}}")
  let unsafe_root = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"../src\"]}")
  let missing_roots = pkg_manifest_parse_str("{\"package\":\"app\",\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"app.weft\"}}}")
  let outside_root = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\"src\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"tools/app.weft\"}}}")
  let unsafe_source = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"../app.weft\"}}}")
  let wrong_suffix = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"app.txt\"}}}")
  let unknown_kind = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"app\":{\"kind\":\"plugin\",\"source\":\"app.weft\"}}}")
  let extra_key = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"app.weft\",\"default\":true}}}")
  let duplicate_target = pkg_manifest_parse_str("{\"package\":\"app\",\"source_roots\":[\".\"],\"targets\":{\"app\":{\"kind\":\"binary\",\"source\":\"app.weft\"},\"app\":{\"kind\":\"binary\",\"source\":\"other.weft\"}}}")
  Test.assert_eq(if pkg_manifest_error_count(empty_roots) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_root) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unsafe_root) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(missing_roots) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(outside_root) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unsafe_source) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(wrong_suffix) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(extra_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_target) > 0 { 1 } else { 0 }, 1)
}

test "pkg_path_safety_table" {
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/math"), 0, __str_len("deps/math")), 1)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/math/lib.weft"), 0, __str_len("deps/math/lib.weft")), 1)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("../deps/math"), 0, __str_len("../deps/math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/../math"), 0, __str_len("deps/../math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("/deps/math"), 0, __str_len("/deps/math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps//math"), 0, __str_len("deps//math")), 0)
}

