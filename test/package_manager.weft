}

test "pkg_dependency_imports_share_canonical_sdk_module_identity" {
  let tt = ttable_new()
  let root = pkg_manifest_parse_str("package app\n")
  pkg_identity_register_root(tt, root)
  ttable_set_root_manifest(tt, root)
  let dependency_manifest = pkg_manifest_parse_str("package fixture\n")
  let dependency = pkg_identity_intern_under_owner(tt, __str_ptr("fixture"), __str_len("fixture"), __str_ptr("deps/fixture"), __str_len("deps/fixture"), dependency_manifest, 0)
  let stdlib_path = "stdlib/drop.weft"
  let runtime_path = "runtime/unsafe.weft"
  let local_path = "internal/helper.weft"
  let stdlib_result = pkg_resolve_default_import(tt, dependency, __str_ptr(stdlib_path), __str_len(stdlib_path))
  let runtime_result = pkg_resolve_default_import(tt, dependency, __str_ptr(runtime_path), __str_len(runtime_path))
  let local_result = pkg_resolve_default_import(tt, dependency, __str_ptr(local_path), __str_len(local_path))
  Test.assert_eq(pkg_resolve_status(stdlib_result), 0)
  Test.assert_eq(pkg_resolve_package(stdlib_result), 0)
  Test.assert_eq(pkg_resolve_path_eq(stdlib_result, stdlib_path), 1)
  Test.assert_eq(pkg_resolve_status(runtime_result), 0)
  Test.assert_eq(pkg_resolve_package(runtime_result), 0)
  Test.assert_eq(pkg_resolve_path_eq(runtime_result, runtime_path), 1)
  Test.assert_eq(pkg_resolve_package(local_result), dependency)
  Test.assert_eq(pkg_resolve_path_eq(local_result, "deps/fixture/internal/helper.weft"), 1)
}

test "installed SDK is one self-authorizing package with its own source root" {
  let tt = ttable_new()
  let root = pkg_manifest_parse_str("package weft\n")
  pkg_identity_register_root(tt, root)
  let sdk = pkg_install_sdk_for_table(tt, "test/fixtures/sdk_package")
  let stdlib_path = "stdlib/example.weft"
  let runtime_path = "runtime/sdk_leaf.weft"
  let compiler_path = "compiler/example.weft"
  let stdlib_result = pkg_resolve_default_import(tt, 0, __str_ptr(stdlib_path), __str_len(stdlib_path))
  let runtime_result = pkg_resolve_default_import(tt, sdk, __str_ptr(runtime_path), __str_len(runtime_path))
  let compiler_result = pkg_resolve_default_import(tt, sdk, __str_ptr(compiler_path), __str_len(compiler_path))
  let identity = pkg_identity_find_id(tt, sdk)

  Test.assert_eq(if sdk > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_sdk_package_id(tt), sdk)
  Test.assert_eq(pkg_resolve_package(stdlib_result), sdk)
  Test.assert_eq(pkg_resolve_package(runtime_result), sdk)
  Test.assert_eq(pkg_resolve_package(compiler_result), sdk)
  Test.assert_eq(pkg_resolve_path_eq(stdlib_result, stdlib_path), 1)
  Test.assert_eq(pkg_resolve_path_eq(runtime_result, runtime_path), 1)
  Test.assert_eq(pkg_resolve_path_eq(compiler_result, compiler_path), 1)
  Test.assert_eq(pkg_bytes_eq_at(pkg_identity_root_ptr(identity), 0, pkg_identity_root_len(identity), __str_ptr("test/fixtures/sdk_package"), 0, __str_len("test/fixtures/sdk_package")), 1)
  Test.assert_eq(pkg_identity_is_sdk(tt, sdk), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, sdk, __str_ptr("runtime/sdk_leaf"), __str_len("runtime/sdk_leaf")), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, sdk, __str_ptr("runtime/not_declared"), __str_len("runtime/not_declared")), 0)
  Test.assert_eq(if pkg_identity_find_id(tt, 0) != identity { 1 } else { 0 }, 1)
}

test "pkg_identity_reuses_one_source_root_and_rejects_conflicting_root" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("package common\n")
  let first = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/left/common"), __str_len("deps/left/common"), manifest)
  let same = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/left/common"), __str_len("deps/left/common"), manifest)
  let conflict = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/right/common"), __str_len("deps/right/common"), manifest)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(first, same)
  Test.assert_eq(conflict, 0 - first)
}

test "pkg_identity_rejects_version_conflict_at_same_source_root" {
  let tt = ttable_new()
  let first_manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"1.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let second_manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"2.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let first = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), first_manifest)
  let conflict = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), second_manifest)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(conflict, 0 - first)
}

test "pkg_identity_rejects_content_conflict_at_same_version_and_source" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"1.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let first_content = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let second_content = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let first = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(first_content), __str_len(first_content))
  let same = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(first_content), __str_len(first_content))
  let conflict = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(second_content), __str_len(second_content))
  let entry = pkg_identity_find_id(tt, first)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(same, first)
  Test.assert_eq(conflict, 0 - first)
  Test.assert_eq(pkg_bytes_eq_at(pkg_identity_content_ptr(entry), 0, pkg_identity_content_len(entry), __str_ptr(first_content), 0, __str_len(first_content)), 1)
}

test "pkg_identity_preserves_remote_source_and_rejects_origin_conflict" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"1.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let root = ".weft/cache/sha256/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let content = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let archive = "archive:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:https://example.test/common.tar"
  let git = "git:cccccccccccccccccccccccccccccccccccccccc:https://example.test/common.git"
  let first = pkg_identity_intern_under_owner_with_source_and_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr(root), __str_len(root), manifest, 0, __str_ptr(archive), __str_len(archive), __str_ptr(content), __str_len(content))
  let same = pkg_identity_intern_under_owner_with_source_and_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr(root), __str_len(root), manifest, 0, __str_ptr(archive), __str_len(archive), __str_ptr(content), __str_len(content))
  let conflict = pkg_identity_intern_under_owner_with_source_and_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr(root), __str_len(root), manifest, 0, __str_ptr(git), __str_len(git), __str_ptr(content), __str_len(content))
  let entry = pkg_identity_find_id(tt, first)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(same, first)
  Test.assert_eq(conflict, 0 - first)
  Test.assert_eq(pkg_bytes_eq_at(pkg_identity_source_ptr(entry), 0, pkg_identity_source_len(entry), __str_ptr(archive), 0, __str_len(archive)), 1)
}

test "pkg_local_import_resolves_beneath_owner_root" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("package lib\n")
  let path = "internal/helper.weft"
  let r = pkg_manifest_resolve_import_from_root(manifest, tt, 17, __str_ptr("deps/lib"), __str_len("deps/lib"), __str_ptr(path), __str_len(path))
  Test.assert_eq(pkg_resolve_status(r), 0)
  Test.assert_eq(pkg_resolve_path_eq(r, "deps/lib/internal/helper.weft"), 1)
  Test.assert_eq(pkg_resolve_package(r), 17)
  Test.assert_eq(pkg_bytes_eq_at(pkg_resolve_logical_ptr(r), 0, pkg_resolve_logical_len(r), __str_ptr(path), 0, __str_len(path)), 1)
}

test "pkg_identity_parent_graph_detects_ancestor_cycle" {
  let tt = ttable_new()
  let lib_manifest = pkg_manifest_parse_str("package lib\n")
  let base_manifest = pkg_manifest_parse_str("package base\n")
  let lib = pkg_identity_intern_under_owner(tt, __str_ptr("lib"), __str_len("lib"), __str_ptr("deps/lib"), __str_len("deps/lib"), lib_manifest, 0)
  let base = pkg_identity_intern_under_owner(tt, __str_ptr("base"), __str_len("base"), __str_ptr("deps/lib/deps/base"), __str_len("deps/lib/deps/base"), base_manifest, lib)
  Test.assert_eq(pkg_identity_is_ancestor(tt, base, lib), 1)
  Test.assert_eq(pkg_identity_is_ancestor(tt, lib, base), 0)
  Test.assert_eq(pkg_identity_is_ancestor(tt, base, base), 1)
}

