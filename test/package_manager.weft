test "pkg_identity_interner_uses_full_name_equality" {
  let tt = ttable_new()
  let math_first = pkg_identity_intern(tt, __str_ptr("math"), __str_len("math"))
  let text = pkg_identity_intern(tt, __str_ptr("text"), __str_len("text"))
  let math_second = pkg_identity_intern(tt, __str_ptr("math"), __str_len("math"))
  Test.assert_eq(math_first > 0, true)
  Test.assert_eq(text > 0, true)
  Test.assert_eq(math_first == text, false)
  Test.assert_eq(math_first, math_second)
}

test "pkg_resolve_carries_dependency_owner_and_relative_module_identity" {
  let tt = ttable_new()
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let path = "math/nested/lib.weft"
  let r = pkg_manifest_resolve_import_for_module(m, tt, 91, __str_ptr(path), __str_len(path))
  let second = pkg_manifest_resolve_import_for_module(m, tt, 91, __str_ptr("math/other.weft"), __str_len("math/other.weft"))
  Test.assert_eq(pkg_resolve_status(r), 1)
  Test.assert_eq(pkg_resolve_path_eq(r, "deps/math/nested/lib.weft"), 1)
  Test.assert_eq(pkg_resolve_package(r) > 0, true)
  Test.assert_eq(pkg_resolve_package(r), pkg_resolve_package(second))
  Test.assert_eq(pkg_bytes_eq_at(pkg_resolve_logical_ptr(r), 0, pkg_resolve_logical_len(r), __str_ptr("nested/lib.weft"), 0, __str_len("nested/lib.weft")), 1)
}

test "pkg_resolve_keeps_local_import_in_owner_package" {
  let tt = ttable_new()
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let path = "local/helpers.weft"
  let r = pkg_manifest_resolve_import_for_module(m, tt, 91, __str_ptr(path), __str_len(path))
  Test.assert_eq(pkg_resolve_status(r), 0)
  Test.assert_eq(pkg_resolve_package(r), 91)
  Test.assert_eq(pkg_bytes_eq_at(pkg_resolve_logical_ptr(r), 0, pkg_resolve_logical_len(r), __str_ptr(path), 0, __str_len(path)), 1)
}

test "pkg_identity_reuses_one_source_root_and_rejects_conflicting_root" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("package common\n")
  let first = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/left/common"), __str_len("deps/left/common"), manifest)
  let same = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/left/common"), __str_len("deps/left/common"), manifest)
  let conflict = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/right/common"), __str_len("deps/right/common"), manifest)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(first, same)
  Test.assert_eq(conflict, 0 - first)
}

test "pkg_identity_rejects_version_conflict_at_same_source_root" {
  let tt = ttable_new()
  let first_manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"1.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let second_manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"2.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let first = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), first_manifest)
  let conflict = pkg_identity_intern_at_root(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), second_manifest)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(conflict, 0 - first)
}

test "pkg_identity_rejects_content_conflict_at_same_version_and_source" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("{\"package\":\"common\",\"version\":\"1.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let first_content = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let second_content = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let first = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(first_content), __str_len(first_content))
  let same = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(first_content), __str_len(first_content))
  let conflict = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("common"), __str_len("common"), __str_ptr("deps/common"), __str_len("deps/common"), manifest, 0, __str_ptr(second_content), __str_len(second_content))
  let entry = pkg_identity_find_id(tt, first)
  Test.assert_eq(first > 0, true)
  Test.assert_eq(same, first)
  Test.assert_eq(conflict, 0 - first)
  Test.assert_eq(pkg_bytes_eq_at(pkg_identity_content_ptr(entry), 0, pkg_identity_content_len(entry), __str_ptr(first_content), 0, __str_len(first_content)), 1)
}

test "pkg_local_import_resolves_beneath_owner_root" {
  let tt = ttable_new()
  let manifest = pkg_manifest_parse_str("package lib\n")
  let path = "internal/helper.weft"
  let r = pkg_manifest_resolve_import_from_root(manifest, tt, 17, __str_ptr("deps/lib"), __str_len("deps/lib"), __str_ptr(path), __str_len(path))
  Test.assert_eq(pkg_resolve_status(r), 0)
  Test.assert_eq(pkg_resolve_path_eq(r, "deps/lib/internal/helper.weft"), 1)
  Test.assert_eq(pkg_resolve_package(r), 17)
  Test.assert_eq(pkg_bytes_eq_at(pkg_resolve_logical_ptr(r), 0, pkg_resolve_logical_len(r), __str_ptr(path), 0, __str_len(path)), 1)
}

test "pkg_identity_parent_graph_detects_ancestor_cycle" {
  let tt = ttable_new()
  let lib_manifest = pkg_manifest_parse_str("package lib\n")
  let base_manifest = pkg_manifest_parse_str("package base\n")
  let lib = pkg_identity_intern_under_owner(tt, __str_ptr("lib"), __str_len("lib"), __str_ptr("deps/lib"), __str_len("deps/lib"), lib_manifest, 0)
  let base = pkg_identity_intern_under_owner(tt, __str_ptr("base"), __str_len("base"), __str_ptr("deps/lib/deps/base"), __str_len("deps/lib/deps/base"), base_manifest, lib)
  Test.assert_eq(pkg_identity_is_ancestor(tt, base, lib), 1)
  Test.assert_eq(pkg_identity_is_ancestor(tt, lib, base), 0)
  Test.assert_eq(pkg_identity_is_ancestor(tt, base, base), 1)
}

test "pkg_add_dep_from_parts_happy_render" {
  let m = pkg_manifest_parse_str("package app\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/math"), __str_len("deps/math"))
  Test.assert_eq(status, 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"app\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{\"math\":\"deps/math\"}}\n"), 1)
}

test "pkg_add_dep_from_parts_happy_preserves_existing_deps" {
  let m = pkg_manifest_parse_str("package app\ndep sql stdlib/grammar/sql\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/math"), __str_len("deps/math"))
  Test.assert_eq(status, 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 2)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"app\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{\"sql\":\"stdlib/grammar/sql\",\"math\":\"deps/math\"}}\n"), 1)
}

test "pkg_add_dep_from_parts_sad_duplicate" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/other"), __str_len("deps/other"))
  Test.assert_eq(status, 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
}

test "pkg_add_dep_from_parts_sad_invalid_name_and_path" {
  let m = pkg_manifest_parse_str("package app\n")
  let bad_name = pkg_manifest_add_dep_from_parts(m, __str_ptr("bad.name"), __str_len("bad.name"), __str_ptr("deps/bad"), __str_len("deps/bad"))
  let bad_path = pkg_manifest_add_dep_from_parts(m, __str_ptr("evil"), __str_len("evil"), __str_ptr("../outside"), __str_len("../outside"))
  Test.assert_eq(bad_name, 1)
  Test.assert_eq(bad_path, 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_content_digest_is_order_independent_and_stable" {
  let forward = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(forward, pkg_content_entry("a.weft", "A"))
  vector_push<PackageContentEntry>(forward, pkg_content_entry("b.weft", "B"))
  let reverse = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(reverse, pkg_content_entry("b.weft", "B"))
  vector_push<PackageContentEntry>(reverse, pkg_content_entry("a.weft", "A"))
  let expected = "sha256:961ec0e3f0b2c031bf3a5575933caac589d62d78f9a4665959def760c07ce27f"
  Test.assert_eq(str_eq(pkg_content_digest(forward), expected), 1)
  Test.assert_eq(str_eq(pkg_content_digest(reverse), expected), 1)
}

test "pkg_content_digest_frames_path_and_content_boundaries" {
  let left = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(left, pkg_content_entry("ab", "c"))
  let right = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(right, pkg_content_entry("a", "bc"))
  Test.assert_eq(str_eq(pkg_content_digest(left), pkg_content_digest(right)), 0)
}

test "pkg_lock_traversal_uses_typed_path_and_byte_capabilities" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read(() =>
    pkg_test_dir_inspect(() =>
      pkg_lock_collect_source_entries(".", manifest, actual)))
  let expected = vector_new<PackageContentEntry>()
  vector_push<PackageContentEntry>(expected, pkg_content_entry("main.weft", "source-bytes"))
  vector_push<PackageContentEntry>(expected, pkg_content_entry("weft.pkg", "manifest-bytes"))
  Test.assert_eq(status, 0)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 2)
  Test.assert_str_eq(pkg_content_digest(actual), pkg_content_digest(expected))
}

test "pkg_lock_traversal_rejects_non_utf8_names_without_loss" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read(() =>
    pkg_test_dir_inspect_invalid_name(() =>
      pkg_lock_collect_source_entries(".", manifest, actual)))
  Test.assert_eq(status, 1)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 0)
}

test "pkg_lock_traversal_propagates_typed_file_read_failure" {
  let manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{}}")
  let actual = vector_new<PackageContentEntry>()
  let status = pkg_test_file_read_failure(() =>
    pkg_test_dir_inspect(() =>
      pkg_lock_collect_source_entries(".", manifest, actual)))
  Test.assert_eq(status, 1)
  Test.assert_eq(vector_len<PackageContentEntry>(actual), 0)
}

test "pkg_lock_render_sorts_packages_and_pins_schema" {
  let entries = vector_new<i64>()
  vector_push<i64>(entries, pkg_lock_entry_new("lib", "2.0.0", "path:deps/lib", "sha256:bbb"))
  vector_push<i64>(entries, pkg_lock_entry_new("app", "1.0.0", "path:.", "sha256:aaa"))
  let rendered = buf_new(256)
  pkg_lock_render_into(rendered, entries)
  let expected = "{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaa\"},{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbb\"}]}\n"
  Test.assert_eq(pkg_bytes_eq_at(buf_ptr(rendered), 0, buf_len(rendered), __str_ptr(expected), 0, __str_len(expected)), 1)
}

test "pkg_lock_parser_accepts_canonical_sorted_identity" {
  let data = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}]}")
  let app = pkg_lock_data_find_name(data, __str_ptr("app"), __str_len("app"))
  let lib = pkg_lock_data_find_name(data, __str_ptr("lib"), __str_len("lib"))
  Test.assert_eq(pkg_lock_data_status(data), 1)
  Test.assert_eq(pkg_lock_data_count(data), 2)
  Test.assert_str_eq(pkg_lock_entry_version(app), "1.0.0")
  Test.assert_str_eq(pkg_lock_entry_source(lib), "path:deps/lib")
  Test.assert_str_eq(pkg_lock_entry_content(lib), "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
}

test "pkg_lock_parser_rejects_root_schema_matrix" {
  let malformed = pkg_lock_parse("{\"lock_version\":")
  let future_lock = pkg_lock_parse("{\"lock_version\":2,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[]}")
  let future_manifest = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":2,\"weft\":\"0.1\",\"packages\":[]}")
  let wrong_weft = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.2\",\"packages\":[]}")
  let unknown_key = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"unknown\":[]}")
  let empty = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[]}")
  Test.assert_eq(pkg_lock_data_status(malformed), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(future_lock), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(future_manifest), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(wrong_weft), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(unknown_key), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(empty), 0 - 1)
}

test "pkg_lock_parser_rejects_entry_identity_matrix" {
  let bad_digest = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:short\"}]}")
  let traversal = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:../app\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  let unsorted = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"},{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  let duplicate = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
  Test.assert_eq(pkg_lock_data_status(bad_digest), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(traversal), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(unsorted), 0 - 1)
  Test.assert_eq(pkg_lock_data_status(duplicate), 0 - 1)
}

test "pkg_lock_match_requires_version_source_and_toolchain" {
  let data = pkg_lock_parse("{\"lock_version\":1,\"manifest_version\":1,\"weft\":\"0.1\",\"packages\":[{\"name\":\"lib\",\"version\":\"2.0.0\",\"source\":\"path:deps/lib\",\"content\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}]}")
  let exact = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"2.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let wrong_version = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"3.0.0\",\"weft\":\"0.1\",\"dependencies\":{}}")
  let wrong_weft = pkg_manifest_parse_str("{\"package\":\"lib\",\"version\":\"2.0.0\",\"weft\":\"0.2\",\"dependencies\":{}}")
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), exact, "path:deps/lib") > 0, true)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), wrong_version, "path:deps/lib"), 0 - 1)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), wrong_weft, "path:deps/lib"), 0 - 1)
  Test.assert_eq(pkg_lock_match_package(data, __str_ptr("lib"), __str_len("lib"), exact, "path:vendor/lib"), 0 - 1)
}

fn pkg_manifest_parse_transient_trust() -> i64 {
  let source = runtime_str_from_bytes_copy(
    __str_ptr("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}"),
    __str_len("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}")
  )
  pkg_manifest_parse_str(source)
}

test "pkg_manifest_trust_schema_round_trips_stable_identity" {
  let m = pkg_manifest_parse_transient_trust()
  let grant = pkg_manifest_find_trust_grant(m, __str_ptr("tls"), __str_len("tls"))
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_trusted_binding_count(m), 1)
  Test.assert_eq(pkg_manifest_trust_grant_count(m), 1)
  Test.assert_eq(pkg_manifest_declares_trusted_binding(m, __str_ptr("native/root"), __str_len("native/root")), 1)
  Test.assert_eq(pkg_trust_grant_names_module(grant, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 1)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"app\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trusted_bindings\":[\"native/root\"],\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}\n"), 1)
}

test "pkg_manifest_trust_rejects_module_path_matrix" {
  let empty = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"\"]}")
  let absolute = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"/native/raw\"]}")
  let empty_segment = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native//raw\"]}")
  let dot = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/./raw\"]}")
  let dotdot = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/../raw\"]}")
  let extension = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw.weft\"]}")
  let duplicate = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\",\"native/raw\"]}")
  Test.assert_eq(if pkg_manifest_error_count(empty) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(absolute) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(empty_segment) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(dot) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(dotdot) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(extension) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate) > 0 { 1 } else { 0 }, 1)
}

test "pkg_manifest_trust_rejects_grant_shape_and_identity_matrix" {
  let wrong_trust_shape = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":[]}")
  let wrong_grant_shape = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":[]}}")
  let missing_key = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"modules\":[\"native/raw\"]}}}")
  let unknown_key = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"],\"extra\":1}}}")
  let bad_version = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1 / 2\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  let bad_source = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"git:https://example.test/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  let bad_content = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:short\",\"modules\":[\"native/raw\"]}}}")
  let empty_modules = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"tls\":{\"version\":\"1.0.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[]}}}")
  let self_grant = pkg_manifest_parse_str("{\"package\":\"app\",\"trust\":{\"app\":{\"version\":\"1.0.0\",\"source\":\"path:.\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw\"]}}}")
  Test.assert_eq(if pkg_manifest_error_count(wrong_trust_shape) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(wrong_grant_shape) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(missing_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_key) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_version) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_source) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_content) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(empty_modules) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(self_grant) > 0 { 1 } else { 0 }, 1)
}

test "pkg_binding_trust_requires_declaration_grant_and_locked_identity" {
  let digest = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let root = pkg_manifest_parse_str("{\"package\":\"app\",\"dependencies\":{\"tls\":\"deps/tls\"},\"trust\":{\"tls\":{\"version\":\"1.2.0\",\"source\":\"path:deps/tls\",\"content\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"modules\":[\"native/raw_tls\"]}}}")
  let dependency = pkg_manifest_parse_str("{\"package\":\"tls\",\"version\":\"1.2.0\",\"trusted_bindings\":[\"native/raw_tls\"]}")
  let tt = ttable_new()
  pkg_identity_register_root(tt, root)
  let dependency_id = pkg_identity_intern_under_owner_with_content(tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), dependency, 0, __str_ptr(digest), __str_len(digest))
  Test.assert_eq(pkg_binding_module_trust_state(tt, dependency_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, dependency_id, __str_ptr("native/safe"), __str_len("native/safe")), 0)

  let unlocked_tt = ttable_new()
  pkg_identity_register_root(unlocked_tt, root)
  let unlocked_id = pkg_identity_intern_under_owner(unlocked_tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), dependency, 0)
  Test.assert_eq(pkg_binding_module_trust_state(unlocked_tt, unlocked_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 0 - 1)

  let undeclared_tt = ttable_new()
  pkg_identity_register_root(undeclared_tt, root)
  let undeclared = pkg_manifest_parse_str("{\"package\":\"tls\",\"version\":\"1.2.0\"}")
  let undeclared_id = pkg_identity_intern_under_owner_with_content(undeclared_tt, __str_ptr("tls"), __str_len("tls"), __str_ptr("deps/tls"), __str_len("deps/tls"), undeclared, 0, __str_ptr(digest), __str_len(digest))
  Test.assert_eq(pkg_binding_module_trust_state(undeclared_tt, undeclared_id, __str_ptr("native/raw_tls"), __str_len("native/raw_tls")), 0 - 1)
}

test "pkg_root_binding_declaration_is_self_authorizing_and_exact" {
  let tt = ttable_new()
  let root = pkg_manifest_parse_str("{\"package\":\"app\",\"trusted_bindings\":[\"native/raw\"]}")
  pkg_identity_register_root(tt, root)
  Test.assert_eq(pkg_binding_module_trust_state(tt, 0, __str_ptr("native/raw"), __str_len("native/raw")), 1)
  Test.assert_eq(pkg_binding_module_trust_state(tt, 0, __str_ptr("native/helper"), __str_len("native/helper")), 0)
}

test "pkg_manifest_exports_round_trip_grammar_and_tool_metadata" {
  let m = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"},\"gpu\":{\"module\":\"grammar/gpu\",\"declaration\":\"GpuGrammar\",\"execution\":\"typed_plan\"},\"html\":{\"module\":\"grammar/html\",\"declaration\":\"HtmlGrammar\",\"execution\":\"runtime\"}},\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}")
  let sql = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("sql"), __str_len("sql"))
  let gpu = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("gpu"), __str_len("gpu"))
  let html = pkg_manifest_find_export(m, pkg_export_kind_grammar(), __str_ptr("html"), __str_len("html"))
  let lint = pkg_manifest_find_export(m, pkg_export_kind_tool(), __str_ptr("lint"), __str_len("lint"))
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_export_count(m), 4)
  Test.assert_eq(pkg_export_execution(sql), pkg_export_execution_validate_only())
  Test.assert_eq(pkg_export_execution(gpu), pkg_export_execution_typed_plan())
  Test.assert_eq(pkg_export_execution(html), pkg_export_execution_runtime())
  Test.assert_eq(pkg_export_execution(lint), pkg_export_execution_none())
  Test.assert_eq(pkg_manifest_rendered_eq(m, "{\"package\":\"sdk\",\"manifest_version\":1,\"version\":\"0.0.0+local\",\"weft\":\"0.1\",\"dependencies\":{},\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"},\"gpu\":{\"module\":\"grammar/gpu\",\"declaration\":\"GpuGrammar\",\"execution\":\"typed_plan\"},\"html\":{\"module\":\"grammar/html\",\"declaration\":\"HtmlGrammar\",\"execution\":\"runtime\"}},\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}\n"), 1)
}

test "pkg_manifest_exports_rejects_root_and_kind_shapes" {
  let array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":[]}")
  let unknown_kind = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"plugins\":{}}}")
  let grammar_array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":[]}}")
  let tool_array = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":[]}}")
  let duplicate_kind = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{},\"tools\":{}}}")
  let duplicate_root = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{},\"exports\":{}}")
  Test.assert_eq(if pkg_manifest_error_count(array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(grammar_array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(tool_array) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_kind) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(duplicate_root) > 0 { 1 } else { 0 }, 1)
}

test "pkg_manifest_exports_rejects_entry_shape_path_name_and_execution" {
  let missing_declaration = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\"}}}}")
  let tool_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"main\",\"execution\":\"runtime\"}}}}")
  let missing_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\"}}}}")
  let unknown_execution = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"magic\"}}}}")
  let extension = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint.weft\",\"declaration\":\"main\"}}}}")
  let traversal = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"../lint\",\"declaration\":\"main\"}}}}")
  let bad_public_name = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"bad-name\":{\"module\":\"tools/lint\",\"declaration\":\"main\"}}}}")
  let bad_declaration = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"lint\":{\"module\":\"tools/lint\",\"declaration\":\"bad.name\"}}}}")
  Test.assert_eq(if pkg_manifest_error_count(missing_declaration) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(tool_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(missing_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(unknown_execution) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(extension) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(traversal) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_public_name) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pkg_manifest_error_count(bad_declaration) > 0 { 1 } else { 0 }, 1)
}
