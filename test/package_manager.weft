use "compiler/package.weft"

test "pkg_manifest_happy_single_dep" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_package_eq(m, "app"), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
  Test.assert_eq(pkg_manifest_has_dep(m, "math"), 1)
  Test.assert_eq(pkg_manifest_dep_path_eq(m, "math", "deps/math"), 1)
}

test "pkg_manifest_happy_multiple_deps_and_comments" {
  let m = pkg_manifest_parse_str("# local deps\npackage app\n\ndep math deps/math\ndep sql stdlib/grammar/sql\n")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 2)
  Test.assert_eq(pkg_manifest_dep_path_eq(m, "math", "deps/math"), 1)
  Test.assert_eq(pkg_manifest_dep_path_eq(m, "sql", "stdlib/grammar/sql"), 1)
}

test "pkg_manifest_happy_unicode_dep_name" {
  let m = pkg_manifest_parse_str("package app\ndep naïve deps/naive\n")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_has_dep(m, "naïve"), 1)
}

test "pkg_manifest_sad_unknown_directive" {
  let m = pkg_manifest_parse_str("package app\nsource deps/math\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
}

test "pkg_manifest_sad_missing_dep_path" {
  let m = pkg_manifest_parse_str("package app\ndep math\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_manifest_sad_duplicate_dep" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\ndep math deps/other\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
}

test "pkg_manifest_sad_unsupported_version_token" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math 1.0.0\n")
  Test.assert_eq(pkg_manifest_error_count(m), 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_manifest_adversarial_rejects_traversal_and_absolute_paths" {
  let traversal = pkg_manifest_parse_str("package app\ndep evil ../outside\n")
  let absolute = pkg_manifest_parse_str("package app\ndep root /tmp/root\n")
  Test.assert_eq(pkg_manifest_error_count(traversal), 1)
  Test.assert_eq(pkg_manifest_error_count(absolute), 1)
  Test.assert_eq(pkg_manifest_dep_count(traversal), 0)
  Test.assert_eq(pkg_manifest_dep_count(absolute), 0)
}

test "pkg_manifest_adversarial_empty_manifest" {
  let m = pkg_manifest_parse_str("")
  Test.assert_eq(pkg_manifest_error_count(m), 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}

test "pkg_path_safety_table" {
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/math"), 0, __str_len("deps/math")), 1)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/math/lib.weft"), 0, __str_len("deps/math/lib.weft")), 1)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("../deps/math"), 0, __str_len("../deps/math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps/../math"), 0, __str_len("deps/../math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("/deps/math"), 0, __str_len("/deps/math")), 0)
  Test.assert_eq(pkg_path_is_safe(__str_ptr("deps//math"), 0, __str_len("deps//math")), 0)
}

test "pkg_cache_path_happy_layout" {
  Test.assert_eq(pkg_cache_path_eq("math/lib.weft", ".weft/cache/math/lib.weft"), 1)
  Test.assert_eq(pkg_cache_path_eq("math/nested/lib.weft", ".weft/cache/math/nested/lib.weft"), 1)
}

test "pkg_cache_path_sad_no_suffix_and_traversal" {
  let direct = pkg_cache_path_for_import(__str_ptr("stdlib"), __str_len("stdlib"))
  let traversal = pkg_cache_path_for_import(__str_ptr("math/../secret.weft"), __str_len("math/../secret.weft"))
  Test.assert_eq(pkg_resolve_status(direct), 0)
  Test.assert_eq(pkg_resolve_path_eq(direct, "stdlib"), 1)
  Test.assert_eq(pkg_resolve_status(traversal), 0 - 1)
}

test "pkg_resolve_happy_package_import" {
  let m = pkg_manifest_parse_str("package app\ndep unitpkg_a deps/unitpkg_a\n")
  let r = pkg_manifest_resolve_import(m, __str_ptr("unitpkg_a/lib.weft"), __str_len("unitpkg_a/lib.weft"))
  Test.assert_eq(pkg_resolve_status(r), 1)
  Test.assert_eq(pkg_resolve_path_eq(r, "deps/unitpkg_a/lib.weft"), 1)
}

test "pkg_resolve_happy_multiple_packages" {
  let m = pkg_manifest_parse_str("package app\ndep unitpkg_b deps/unitpkg_b\ndep unitpkg_c vendor/unitpkg_c\n")
  let r1 = pkg_manifest_resolve_import(m, __str_ptr("unitpkg_b/lib.weft"), __str_len("unitpkg_b/lib.weft"))
  let r2 = pkg_manifest_resolve_import(m, __str_ptr("unitpkg_c/string.weft"), __str_len("unitpkg_c/string.weft"))
  Test.assert_eq(pkg_resolve_status(r1), 1)
  Test.assert_eq(pkg_resolve_status(r2), 1)
  Test.assert_eq(pkg_resolve_path_eq(r1, "deps/unitpkg_b/lib.weft"), 1)
  Test.assert_eq(pkg_resolve_path_eq(r2, "vendor/unitpkg_c/string.weft"), 1)
}

test "pkg_resolve_sad_missing_package_falls_back" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let r = pkg_manifest_resolve_import(m, __str_ptr("text/string.weft"), __str_len("text/string.weft"))
  Test.assert_eq(pkg_resolve_status(r), 0)
  Test.assert_eq(pkg_resolve_path_eq(r, "text/string.weft"), 1)
}

test "pkg_resolve_sad_rejects_traversal_suffix" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let r = pkg_manifest_resolve_import(m, __str_ptr("math/../secret.weft"), __str_len("math/../secret.weft"))
  Test.assert_eq(pkg_resolve_status(r), 0 - 1)
}

test "pkg_resolve_adversarial_unicode_import" {
  let m = pkg_manifest_parse_str("package app\ndep naïve deps/naive\n")
  let r = pkg_manifest_resolve_import(m, __str_ptr("naïve/lib.weft"), __str_len("naïve/lib.weft"))
  Test.assert_eq(pkg_resolve_status(r), 1)
  Test.assert_eq(pkg_resolve_path_eq(r, "deps/naive/lib.weft"), 1)
}

test "pkg_add_dep_from_parts_happy_render" {
  let m = pkg_manifest_parse_str("package app\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/math"), __str_len("deps/math"))
  Test.assert_eq(status, 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "package app\ndep math deps/math\n"), 1)
}

test "pkg_add_dep_from_parts_happy_preserves_existing_deps" {
  let m = pkg_manifest_parse_str("package app\ndep sql stdlib/grammar/sql\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/math"), __str_len("deps/math"))
  Test.assert_eq(status, 0)
  Test.assert_eq(pkg_manifest_dep_count(m), 2)
  Test.assert_eq(pkg_manifest_rendered_eq(m, "package app\ndep sql stdlib/grammar/sql\ndep math deps/math\n"), 1)
}

test "pkg_add_dep_from_parts_sad_duplicate" {
  let m = pkg_manifest_parse_str("package app\ndep math deps/math\n")
  let status = pkg_manifest_add_dep_from_parts(m, __str_ptr("math"), __str_len("math"), __str_ptr("deps/other"), __str_len("deps/other"))
  Test.assert_eq(status, 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 1)
}

test "pkg_add_dep_from_parts_sad_invalid_name_and_path" {
  let m = pkg_manifest_parse_str("package app\n")
  let bad_name = pkg_manifest_add_dep_from_parts(m, __str_ptr("bad.name"), __str_len("bad.name"), __str_ptr("deps/bad"), __str_len("deps/bad"))
  let bad_path = pkg_manifest_add_dep_from_parts(m, __str_ptr("evil"), __str_len("evil"), __str_ptr("../outside"), __str_len("../outside"))
  Test.assert_eq(bad_name, 1)
  Test.assert_eq(bad_path, 1)
  Test.assert_eq(pkg_manifest_dep_count(m), 0)
}
