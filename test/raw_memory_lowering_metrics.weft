use runtime/alloc.{*}
-- test/raw_memory_lowering_metrics.weft -- native evidence for scaled raw-memory lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use runtime/memory.{*}

fn raw_memory_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn raw_memory_metric_scaled(src: str) -> i64 {
  pipeline_native_scaled_mem_lowering_count(raw_memory_metric_native(src))
}

fn raw_memory_metric_direct_call_inlines(src: str) -> i64 {
  pipeline_native_direct_call_inline_count(raw_memory_metric_native(src))
}

fn raw_memory_metric_discard_stores(src: str) -> i64 {
  pipeline_native_discard_store_count(raw_memory_metric_native(src))
}

fn raw_memory_metric_loop_addr_recur(src: str) -> i64 {
  pipeline_native_loop_addr_recur_count(raw_memory_metric_native(src))
}

fn note_value(order: i64, marker: i64, value: i64) -> i64 {
  let current = mem_load64(order)
  mem_store64(order, current * 10 + marker)
  value
}

test "raw_memory_metric_lowers_scaled_load_and_store" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 mem_store64(arr + i * 8, 41) mem_load64(arr + i * 8) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_lowers_safe_bridge_load_and_store" {
  let src = "fn mem_load64_at(ptr: i64, index: i64) -> i64 { mem_load64(ptr + index) } fn mem_store64_at(ptr: i64, index: i64, value: i64) -> i64 { mem_store64(ptr + index, value) 0 } fn main() -> i64 { let arr = 1024 mem_store64_at(arr, 16, 41) mem_load64_at(arr, 16) }"
  Test.assert_eq(if raw_memory_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
}

test "raw_memory_metric_lowers_safe_bridge_byte_load_and_store" {
  let src = "fn mem_load8_at(ptr: i64, index: i64) -> i64 { mem_load8(ptr + index) } fn mem_store8_at(ptr: i64, index: i64, value: i64) -> i64 { mem_store8(ptr + index, value) 0 } fn main() -> i64 { let arr = 1024 mem_store8_at(arr, 2, 65) mem_load8_at(arr, 2) }"
  Test.assert_eq(if raw_memory_metric_direct_call_inlines(src) >= 2 { 1 } else { 0 }, 1)
}

test "raw_memory_metric_discards_safe_bridge_store_result" {
  let src = "fn mem_store64_at(ptr: i64, index: i64, value: i64) -> i64 { mem_store64(ptr + index, value) 0 } fn main() -> i64 { let arr = 1024 mem_store64_at(arr, 16, 41) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 2)
}

test "raw_memory_metric_lowers_commuted_scaled_address" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 1 mem_store64(i * 8 + arr, 7) mem_load64(i * 8 + arr) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_discards_statement_scaled_store_result" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 mem_store64(arr + i * 8, 41) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 1)
}

test "raw_memory_metric_discards_multiple_statement_scaled_store_results" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 1 mem_store64(arr + i * 8, 41) mem_store64(arr + 2 * 8, 42) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 2)
}

test "raw_memory_metric_keeps_used_scaled_store_result" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 let stored = mem_store64(arr + i * 8, 41) stored }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 1)
}

test "raw_memory_metric_keeps_non_word_scale_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 mem_store64(arr + i * 4, 41) mem_load64(arr + i * 4) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_keeps_unscaled_and_byte_access_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 mem_store64(arr + i, 41) mem_load8(arr + i * 8) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_keeps_non_word_statement_store_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let i = 2 mem_store64(arr + i * 4, 41) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 1)
}

test "raw_memory_metric_keeps_single_loop_address_use_scaled" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 while i < 4 { mem_store64(arr + i * 8, i + 10) i = i + 1 } mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_loop_address_recurrence_load_and_store" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 let mut total = 0 while i < 4 { mem_store64(arr + i * 8, i + 1) total = total + mem_load64(arr + i * 8) i = i + 1 } total }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_loop_address_recurrence_multiple_stores" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 while i < 4 { mem_store64(arr + i * 8, i + 1) mem_store64(arr + i * 8, i + 2) i = i + 1 } mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_range_address_recurrence_multiple_stores" {
  let src = "fn main() -> i64 { let arr = 1024 for i in 0..4 { mem_store64(arr + i * 8, i + 1) mem_store64(arr + i * 8, i + 2) } mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_range_address_recurrence_branch_stores" {
  let src = "fn main() -> i64 { let arr = 1024 for i in 0..4 { if i >= 2 { mem_store64(arr + i * 8, 1) } else { mem_store64(arr + i * 8, 0) } } mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_single_variable_step_loop_address_scaled" {
  let src = "fn main(step: i64) -> i64 { let arr = 1024 let mut i = 0 while i < 4 { mem_store64(arr + i * 8, i) i = i + step } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_variable_step_loop_address_recurrence" {
  let src = "fn main(step: i64) -> i64 { let arr = 1024 let mut i = 0 let mut total = 0 while i < 4 { mem_store64(arr + i * 8, i) total = total + mem_load64(arr + i * 8) i = i + step } total }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_single_literal_nonunit_loop_address_scaled" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 while i < 8 { mem_store64(arr + i * 8, i) i = i + 2 } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_literal_nonunit_loop_address_recurrence" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 let mut total = 0 while i < 8 { mem_store64(arr + i * 8, i) total = total + mem_load64(arr + i * 8) i = i + 2 } total }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_mutated_step_loop_address_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let mut step = 2 let mut i = 0 while i < 8 { mem_store64(arr + i * 8, i) step = step + 1 i = i + step } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_self_step_loop_address_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 1 while i < 8 { mem_store64(arr + i * 8, i) i = i + i } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_mutated_base_loop_address_generic" {
  let src = "fn main() -> i64 { let mut arr = 1024 let mut i = 0 while i < 4 { mem_store64(arr + i * 8, i) arr = arr + 8 i = i + 1 } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_shadowed_base_loop_address_generic" {
  let src = "fn main() -> i64 { let arr = 1024 let mut i = 0 while i < 4 { let arr = 1024 mem_store64(arr + i * 8, i) i = i + 1 } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_single_range_address_use_scaled" {
  let src = "fn main() -> i64 { let arr = 1024 for i in 0..4 { mem_store64(arr + i * 8, i + 1) } mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_runtime_scaled_load_and_store_word_slots" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 32, 8)
  mem_store64(arr + 0 * 8, 10)
  mem_store64(arr + 1 * 8, 20)
  mem_store64(arr + 2 * 8, 30)
  mem_store64(arr + 3 * 8, 40)
  Test.assert_eq(mem_load64(arr + 0 * 8), 10)
  Test.assert_eq(mem_load64(arr + 2 * 8), 30)
  Test.assert_eq(mem_load64(3 * 8 + arr), 40)
  arena_free(arena)
}

test "raw_memory_runtime_safe_bridge_store_returns_zero" {
  let arena = arena_new(64)
  let arr = arena_alloc(arena, 16, 8)
  let stored = mem_store64_at(arr, 8, 77)
  Test.assert_eq(stored, 0)
  Test.assert_eq(mem_load64_at(arr, 8), 77)
  arena_free(arena)
}

test "raw_memory_runtime_store_evaluates_address_before_value" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 24, 8)
  let order = arena_alloc(arena, 8, 8)
  mem_store64(order, 0)
  let stored = mem_store64(note_value(order, 1, arr) + note_value(order, 2, 1) * 8, note_value(order, 3, 77))
  Test.assert_eq(stored, 0)
  Test.assert_eq(mem_load64(order), 123)
  Test.assert_eq(mem_load64(arr + 1 * 8), 77)
  arena_free(arena)
}

test "raw_memory_runtime_discarded_store_preserves_order_and_write" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 24, 8)
  let order = arena_alloc(arena, 8, 8)
  mem_store64(order, 0)
  mem_store64(note_value(order, 1, arr) + note_value(order, 2, 1) * 8, note_value(order, 3, 77))
  Test.assert_eq(mem_load64(order), 123)
  Test.assert_eq(mem_load64(arr + 1 * 8), 77)
  arena_free(arena)
}

test "raw_memory_runtime_loop_address_recurrence_store_and_load" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 40, 8)
  let mut i = 0
  let mut total = 0
  while i < 5 {
    mem_store64(arr + i * 8, i + 1)
    total = total + mem_load64(arr + i * 8)
    i = i + 1
  }
  Test.assert_eq(total, 15)
  Test.assert_eq(mem_load64(arr + 4 * 8), 5)
  arena_free(arena)
}

test "raw_memory_runtime_variable_step_loop_address_recurrence" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 64, 8)
  for i in 0..8 {
    mem_store64(arr + i * 8, 0)
  }
  let step = 2
  let mut j = 0
  while j < 8 {
    mem_store64(arr + j * 8, j + 10)
    j = j + step
  }
  Test.assert_eq(mem_load64(arr + 0 * 8), 10)
  Test.assert_eq(mem_load64(arr + 1 * 8), 0)
  Test.assert_eq(mem_load64(arr + 2 * 8), 12)
  Test.assert_eq(mem_load64(arr + 6 * 8), 16)
  arena_free(arena)
}

test "raw_memory_runtime_range_address_recurrence_branch_stores" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 40, 8)
  for i in 0..5 {
    if i >= 2 { mem_store64(arr + i * 8, i + 10) }
    else { mem_store64(arr + i * 8, i + 20) }
  }
  Test.assert_eq(mem_load64(arr + 0 * 8), 20)
  Test.assert_eq(mem_load64(arr + 2 * 8), 12)
  Test.assert_eq(mem_load64(arr + 4 * 8), 14)
  arena_free(arena)
}

test "raw_memory_runtime_commuted_load_preserves_index_then_base_order" {
  let arena = arena_new(128)
  let arr = arena_alloc(arena, 24, 8)
  let order = arena_alloc(arena, 8, 8)
  mem_store64(order, 0)
  mem_store64(arr + 1 * 8, 55)
  let got = mem_load64(note_value(order, 1, 1) * 8 + note_value(order, 2, arr))
  Test.assert_eq(got, 55)
  Test.assert_eq(mem_load64(order), 12)
  arena_free(arena)
}
