-- test/raw_memory_lowering_metrics.weft -- native evidence for scaled raw-memory lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn raw_memory_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn raw_memory_metric_scaled(src: str) -> i64 {
  pipeline_native_scaled_mem_lowering_count(raw_memory_metric_native(src))
}

fn raw_memory_metric_discard_stores(src: str) -> i64 {
  pipeline_native_discard_store_count(raw_memory_metric_native(src))
}

fn raw_memory_metric_loop_addr_recur(src: str) -> i64 {
  pipeline_native_loop_addr_recur_count(raw_memory_metric_native(src))
}

fn note_value(order: i64, marker: i64, value: i64) -> i64 {
  let current = __mem_load64(order)
  __mem_store64(order, current * 10 + marker)
  value
}

test "raw_memory_metric_lowers_scaled_load_and_store" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 __mem_store64(arr + i * 8, 41) __mem_load64(arr + i * 8) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 2)
}

test "raw_memory_metric_lowers_commuted_scaled_address" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 1 __mem_store64(i * 8 + arr, 7) __mem_load64(i * 8 + arr) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 2)
}

test "raw_memory_metric_discards_statement_scaled_store_result" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 __mem_store64(arr + i * 8, 41) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 1)
}

test "raw_memory_metric_discards_multiple_statement_scaled_store_results" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 1 __mem_store64(arr + i * 8, 41) __mem_store64(arr + 2 * 8, 42) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 2)
}

test "raw_memory_metric_keeps_used_scaled_store_result" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 let stored = __mem_store64(arr + i * 8, 41) stored }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 0)
}

test "raw_memory_metric_keeps_non_word_scale_generic" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 __mem_store64(arr + i * 4, 41) __mem_load64(arr + i * 4) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_keeps_unscaled_and_byte_access_generic" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 __mem_store64(arr + i, 41) __mem_load8(arr + i * 8) }"
  Test.assert_eq(raw_memory_metric_scaled(src), 0)
}

test "raw_memory_metric_keeps_non_word_statement_store_generic" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(32) let i = 2 __mem_store64(arr + i * 4, 41) 0 }"
  Test.assert_eq(raw_memory_metric_discard_stores(src), 0)
}

test "raw_memory_metric_keeps_single_loop_address_use_scaled" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) let mut i = 0 while i < 4 { __mem_store64(arr + i * 8, i + 10) i = i + 1 } __mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_lowers_loop_address_recurrence_load_and_store" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) let mut i = 0 let mut total = 0 while i < 4 { __mem_store64(arr + i * 8, i + 1) total = total + __mem_load64(arr + i * 8) i = i + 1 } total }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 2)
}

test "raw_memory_metric_lowers_loop_address_recurrence_multiple_stores" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) let mut i = 0 while i < 4 { __mem_store64(arr + i * 8, i + 1) __mem_store64(arr + i * 8, i + 2) i = i + 1 } __mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 2)
}

test "raw_memory_metric_lowers_range_address_recurrence_multiple_stores" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) for i in 0..4 { __mem_store64(arr + i * 8, i + 1) __mem_store64(arr + i * 8, i + 2) } __mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 2)
}

test "raw_memory_metric_lowers_range_address_recurrence_branch_stores" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) for i in 0..4 { if i >= 2 { __mem_store64(arr + i * 8, 1) } else { __mem_store64(arr + i * 8, 0) } } __mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 2)
}

test "raw_memory_metric_keeps_variable_step_loop_address_generic" {
  let src = "fn main(step: i64) -> i64 { let arr = __bump_alloc(64) let mut i = 0 while i < 4 { __mem_store64(arr + i * 8, i) i = i + step } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_mutated_base_loop_address_generic" {
  let src = "fn main() -> i64 { let mut arr = __bump_alloc(64) let mut i = 0 while i < 4 { __mem_store64(arr + i * 8, i) arr = arr + 8 i = i + 1 } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_shadowed_base_loop_address_generic" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) let mut i = 0 while i < 4 { let arr = __bump_alloc(64) __mem_store64(arr + i * 8, i) i = i + 1 } 0 }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_metric_keeps_single_range_address_use_scaled" {
  let src = "fn main() -> i64 { let arr = __bump_alloc(64) for i in 0..4 { __mem_store64(arr + i * 8, i + 1) } __mem_load64(arr + 3 * 8) }"
  Test.assert_eq(raw_memory_metric_loop_addr_recur(src), 0)
}

test "raw_memory_runtime_scaled_load_and_store_word_slots" {
  let arr = __bump_alloc(32)
  __mem_store64(arr + 0 * 8, 10)
  __mem_store64(arr + 1 * 8, 20)
  __mem_store64(arr + 2 * 8, 30)
  __mem_store64(arr + 3 * 8, 40)
  Test.assert_eq(__mem_load64(arr + 0 * 8), 10)
  Test.assert_eq(__mem_load64(arr + 2 * 8), 30)
  Test.assert_eq(__mem_load64(3 * 8 + arr), 40)
}

test "raw_memory_runtime_store_evaluates_address_before_value" {
  let arr = __bump_alloc(24)
  let order = __bump_alloc(8)
  __mem_store64(order, 0)
  let stored = __mem_store64(note_value(order, 1, arr) + note_value(order, 2, 1) * 8, note_value(order, 3, 77))
  Test.assert_eq(stored, 77)
  Test.assert_eq(__mem_load64(order), 123)
  Test.assert_eq(__mem_load64(arr + 1 * 8), 77)
}

test "raw_memory_runtime_discarded_store_preserves_order_and_write" {
  let arr = __bump_alloc(24)
  let order = __bump_alloc(8)
  __mem_store64(order, 0)
  __mem_store64(note_value(order, 1, arr) + note_value(order, 2, 1) * 8, note_value(order, 3, 77))
  Test.assert_eq(__mem_load64(order), 123)
  Test.assert_eq(__mem_load64(arr + 1 * 8), 77)
}

test "raw_memory_runtime_loop_address_recurrence_store_and_load" {
  let arr = __bump_alloc(40)
  let mut i = 0
  let mut total = 0
  while i < 5 {
    __mem_store64(arr + i * 8, i + 1)
    total = total + __mem_load64(arr + i * 8)
    i = i + 1
  }
  Test.assert_eq(total, 15)
  Test.assert_eq(__mem_load64(arr + 4 * 8), 5)
}

test "raw_memory_runtime_range_address_recurrence_branch_stores" {
  let arr = __bump_alloc(40)
  for i in 0..5 {
    if i >= 2 { __mem_store64(arr + i * 8, i + 10) }
    else { __mem_store64(arr + i * 8, i + 20) }
  }
  Test.assert_eq(__mem_load64(arr + 0 * 8), 20)
  Test.assert_eq(__mem_load64(arr + 2 * 8), 12)
  Test.assert_eq(__mem_load64(arr + 4 * 8), 14)
}

test "raw_memory_runtime_commuted_load_preserves_index_then_base_order" {
  let arr = __bump_alloc(24)
  let order = __bump_alloc(8)
  __mem_store64(order, 0)
  __mem_store64(arr + 1 * 8, 55)
  let got = __mem_load64(note_value(order, 1, 1) * 8 + note_value(order, 2, arr))
  Test.assert_eq(got, 55)
  Test.assert_eq(__mem_load64(order), 12)
}
