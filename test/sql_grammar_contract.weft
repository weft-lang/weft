use stdlib/grammar.{Grammar, ParseResult, Parsed, Recovered, Rejected}
use stdlib/grammar/sql.{grammar}
use stdlib/grammar/sql/syntax.{*}
use stdlib/source.{Source, Span}
use stdlib/diagnostic/schema.{*}
use stdlib/diagnostic
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/state as state
use stdlib/state.{State}
use stdlib/num

fn parse_sql(source: Source, span: Span) -> (ParseResult<SqlSyntax>, i64) {
  state.run(
    0,
    () => handle grammar().parse(span) {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
          _ -> nil
        }
        resume(0)
      }
      Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
      Diagnose.warn(message, position) -> resume(0)
      Diagnose.note(message, position) -> resume(0)
    }
  )
}

fn named_source(text: str) -> Source {
  Source { text: text, identity: DiagnosticSourceNamed("query.sql") }
}

test "SQL Grammar returns inspectable grammar-owned syntax" {
  let source = named_source("select id, name as label from users")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.source.table {
        Some(table) -> table.text == "users" and match syntax.query.selection {
          SqlSelect(Cons(first, Cons(second, Nil))) ->
            match first.expression { SqlColumn(name) -> name.text == "id", _ -> false } and
            match second.expression { SqlColumn(name) -> name.text == "name", _ -> false } and
            match second.alias { Some(alias) -> alias.text == "label", None -> false }
          _ -> false
        }
        None -> false
      }
      _ -> false
    }
  )
}

test "SQL syntax preserves joins predicates aggregates ordering and paging" {
  let source = named_source(
    "select distinct u.name || '!' as label, count(*) as n from users u join orders o on u.id = o.user_id where u.active and o.total > 10 group by u.name having count(*) > 1 order by label desc limit 5 offset 2"
  )
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) ->
        syntax.query.distinct and
        match syntax.query.joins {
          Cons(join, Nil) -> match join.predicate {
            SqlComparisonExpression(SqlEqual, SqlQualifiedColumn(left_source, left_field), SqlQualifiedColumn(right_source, right_field)) ->
              left_source.text == "u" and left_field.text == "id" and right_source.text == "o" and
              right_field.text == "user_id"
            _ -> false
          }
          _ -> false
        } and
        match syntax.query.predicate {
          Some(SqlLogicalExpression(SqlAnd, SqlQualifiedColumn(_, active), SqlComparisonExpression(SqlGreater, SqlQualifiedColumn(_, total), SqlIntegerLiteral(10, _)))) ->
            active.text == "active" and total.text == "total"
          _ -> false
        } and
        match syntax.query.groups {
          Cons(SqlQualifiedColumn(_, name), Nil) -> name.text == "name",
          _ -> false
        } and
        match syntax.query.having {
          Some(SqlComparisonExpression(SqlGreater, SqlAggregateExpression(SqlCount, None, _), SqlIntegerLiteral(1, _))) ->
            true,
          _ -> false
        } and
        match syntax.query.order {
          Cons(item, Nil) -> match item.direction { SqlDescending -> true, _ -> false },
          _ -> false
        } and
        match syntax.query.limit { Some(SqlIntegerLiteral(5, _)) -> true, _ -> false } and
        match syntax.query.offset { Some(SqlIntegerLiteral(2, _)) -> true, _ -> false }
      _ -> false
    }
  )
}

test "SQL Grammar preserves every ordering expression" {
  let source = named_source("select name from users order by id, name")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.order {
        Cons(first, Cons(second, Nil)) ->
          match first.expression { SqlColumn(name) -> name.text == "id", _ -> false } and
          match second.expression { SqlColumn(name) -> name.text == "name", _ -> false }
        _ -> false
      }
      _ -> false
    }
  )
}

test "SQL Grammar preserves enclosing source offsets for fragments" {
  let source = named_source("prefix select id from users suffix")
  let fragment = source.span(7, 27).unwrap()
  let (result, errors) = parse_sql(source, fragment)
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.selection {
        SqlSelect(Cons(item, Nil)) -> match item.expression {
          SqlColumn(name) -> name.text == "id" and name.span.start() == 14
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.source.table {
        Some(table) -> table.span.start() == 22 and match table.span.source().identity {
          DiagnosticSourceNamed(name) -> name == "query.sql",
          _ -> false
        }
        None -> false
      }
      _ -> false
    }
  )
}

test "SQL Grammar makes recovery explicit and withholds invented identifiers" {
  let source = named_source("select id users")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_true(errors > 0)
  Test.assert_true(
    match result {
      Recovered(syntax) -> match syntax.query.source.table { None -> true, Some(_) -> false }
      _ -> false
    }
  )
}

test "SQL Grammar checks integer magnitude without wrapping" {
  let source = named_source("select 9223372036854775807 from readings")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.selection {
        SqlSelect(Cons(item, Nil)) -> match item.expression {
          SqlIntegerLiteral(value, span) -> value == 9223372036854775807 and
            span.text().unwrap() == "9223372036854775807"
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
  for literal in ["9223372036854775808", "18446744073709551616", "9999999999999999999999999"] {
    let source = named_source("select ".concat(literal).concat(" from readings"))
    let (result, errors) = parse_sql(source, source.all())
    Test.assert_eq(errors, 1)
    Test.assert_true(
      match result {
        Recovered(syntax) -> match syntax.query.selection {
          SqlSelect(Cons(item, Nil)) -> match item.expression {
            SqlInvalidExpression(span) -> span.text().unwrap() == literal
            _ -> false
          }
          _ -> false
        }
        _ -> false
      }
    )
  }
}

test "SQL Grammar preserves left associativity and precedence" {
  let source = named_source("select 8 - 3 - 1, 16 / 4 / 2, 1 + 2 * 3 from readings")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.selection {
        SqlSelect(Cons(first, Cons(second, Cons(third, Nil)))) ->
          match first.expression {
            SqlScalarExpression(SqlSubtract, SqlScalarExpression(SqlSubtract,
          SqlIntegerLiteral(8, _), SqlIntegerLiteral(3, _)), SqlIntegerLiteral(1, _)) -> true
            _ -> false
          } and match second.expression {
            SqlScalarExpression(SqlDivide, SqlScalarExpression(SqlDivide,
          SqlIntegerLiteral(16, _), SqlIntegerLiteral(4, _)), SqlIntegerLiteral(2, _)) -> true
            _ -> false
          } and match third.expression {
            SqlScalarExpression(SqlAdd, SqlIntegerLiteral(1, _),
          SqlScalarExpression(SqlMultiply, SqlIntegerLiteral(2, _), SqlIntegerLiteral(3, _))) ->
              true
            _ -> false
          }
        _ -> false
      }
      _ -> false
    }
  )
}

test "SQL Grammar never accepts a missing operand as clean syntax" {
  for text in [
    "",
    "select",
    "select + 1 from readings",
    "select () from readings",
    "select 1 + from readings",
    "select sum() from readings",
    "select a. from readings",
    "select 1 from readings where = 1",
    "select 1 from readings where true and",
    "select 1 from readings order by",
    "select 1 from readings group by",
    "select 1 from readings having",
    "select 1 from readings limit",
    "select 1 from readings offset"
  ] {
    let source = named_source(text)
    let (result, errors) = parse_sql(source, source.all())
    Test.assert_true(errors > 0)
    Test.assert_true(match result { Recovered(_) -> true, _ -> false })
  }
}

test "SQL Grammar bounds recursive expression depth" {
  for depth in [0, 1, 32, 127, 128, 512] {
    let mut expression = "1"
    for level in 0..depth { expression = "(".concat(expression).concat(")") }
    let source = named_source("select ".concat(expression).concat(" from readings"))
    let (result, errors) = parse_sql(source, source.all())
    Test.assert_true(
      match result {
        Parsed(_) -> depth < 128 and errors == 0
        Recovered(_) -> depth >= 128 and errors > 0
        Rejected -> false
      }
    )
  }
}

test "SQL Grammar bounds expression chains before recursive consumers see them" {
  for operators in [0, 1, 32, 128, 129, 512] {
    let mut expression = "1"
    for index in 0..operators { expression = expression.concat(" + 1") }
    let source = named_source("select ".concat(expression).concat(" from readings"))
    let (result, errors) = parse_sql(source, source.all())
    Test.assert_true(
      match result {
        Parsed(_) -> operators <= 128 and errors == 0
        Recovered(_) -> operators > 128 and errors > 0
        Rejected -> false
      }
    )
  }
}

test "SQL Grammar keeps keyword boundaries and case insensitive clauses" {
  let source = named_source("SeLeCt fromage, trueish, order_id FrOm records_1 WhErE trueish")
  let (result, errors) = parse_sql(source, source.all())
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.selection {
        SqlSelect(Cons(a, Cons(b, Cons(c, Nil)))) ->
          match a.expression { SqlColumn(name) -> name.text == "fromage", _ -> false } and
          match b.expression { SqlColumn(name) -> name.text == "trueish", _ -> false } and
          match c.expression { SqlColumn(name) -> name.text == "order_id", _ -> false }
        _ -> false
      }
      _ -> false
    }
  )
}

test "SQL Grammar clause recovery skips quoted payloads and identifier substrings" {
  for text in [
    "select 1 2 'from decoy' from readings",
    "select 1 2 notfrom decoy from readings"
  ] {
    let source = named_source(text)
    let (result, errors) = parse_sql(source, source.all())
    Test.assert_eq(errors, 1)
    Test.assert_true(
      match result {
        Recovered(syntax) -> match syntax.query.source.table {
          Some(name) -> name.text == "readings"
          None -> false
        }
        _ -> false
      }
    )
  }
}

test "SQL Grammar handles every byte prefix of a Unicode fragment" {
  let source = named_source("prefix select 'café 😺' as label from readings suffix")
  let fragment = source.span(7, source.text.len() - 7).unwrap()
  let mut end: usize = 0
  while end <= fragment.len() {
    let input = fragment.subspan(0, end).unwrap()
    let (result, errors) = parse_sql(source, input)
    Test.assert_true(
      match result {
        Parsed(syntax) -> errors == 0 and syntax.span.start() == 7 and syntax.span.end() == 7 +
          end
        Recovered(syntax) -> errors > 0 and syntax.span.start() == 7 and syntax.span.end() == 7 +
          end
        Rejected -> false
      }
    )
    end = end + 1
  }
  let (result, errors) = parse_sql(source, fragment)
  Test.assert_eq(errors, 0)
  Test.assert_true(
    match result {
      Parsed(syntax) -> match syntax.query.selection {
        SqlSelect(Cons(item, Nil)) -> match item.expression {
          SqlStringLiteral(value, span) -> value == "café 😺" and
            span.text().unwrap() == value and span.start() == 15
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
}

test "SQL Grammar reports retained source ranges including end of fragment" {
  let source = named_source("prefix select 1 + suffix")
  let fragment = source.span(7, 17).unwrap()
  let (result, reports) = state.run(
    Nil<Diagnostic>(),
    () => handle grammar().parse(fragment) {
      Diagnose.report(report) -> {
        let reports = State<List<Diagnostic>>.get()
        State<List<Diagnostic>>.put(reports.prepend(report))
        resume(0)
      }
    }
  )
  Test.assert_true(match result { Recovered(_) -> true, _ -> false })
  Test.assert_true(not reports.is_empty())
  for report in reports {
    Test.assert_true(
      match report.primary() {
        DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) ->
          name == "query.sql" and start == 17 and end == 17
        _ -> false
      }
    )
  }
}
