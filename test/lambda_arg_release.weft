use runtime/rc_implicit_test.{*}
-- test/lambda_arg_release.weft -- caller-side release of owned lambda
-- temporaries passed to borrowed params (2q slice 1b). Before the fix,
-- every arg-position lambda leaked its pair+env per execution
-- (~136 B/iter probe-measured); let-bound lambdas already released via
-- scope cleanup. These tests lock correctness across the call shapes
-- and pin reclamation with a heap-occupancy lock.

fn lar_ap(f: (i64) -> i64, v: i64) -> i64 { f(v) }

fn lar_ap_generic<T>(f: (T) -> T, v: T) -> T { f(v) }

fn lar_inc(x: i64) -> i64 { x + 1 }

type LarBox { LarBoxVal(i64) }
trait LarApplier { fn lar_apply_with(self, f: (i64) -> i64) -> i64 }
impl LarApplier for LarBox {
  fn lar_apply_with(self, f: (i64) -> i64) -> i64 {
    match self { LarBoxVal(v) -> f(v) }
  }
}

fn lar_churn_direct(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let base = i
    acc = lar_ap(x => x + base, 1)
    i = i + 1
  }
  acc
}

fn lar_churn_generic(n: i64) -> i64 {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let base = i
    acc = lar_ap_generic<i64>(x => x + base, 1)
    i = i + 1
  }
  acc
}

fn lar_churn_method(n: i64) -> i64 {
  let b = LarBoxVal(5)
  let mut i = 0
  let mut acc = 0
  while i < n {
    let base = i
    acc = b.lar_apply_with(x => x + base)
    i = i + 1
  }
  acc
}

test "lambda_arg_release_direct_call_correct" {
  Test.assert_eq(lar_churn_direct(1000), 1000)
}

test "lambda_arg_release_generic_call_correct" {
  Test.assert_eq(lar_churn_generic(1000), 1000)
}

test "lambda_arg_release_method_call_correct" {
  Test.assert_eq(lar_churn_method(1000), 1004)
}

test "lambda_arg_release_let_bound_still_correct" {
  -- Let-bound lambdas keep their scope-cleanup release; the arg-temp
  -- release must not double-release an Ident argument.
  let mut i = 0
  let mut acc = 0
  while i < 1000 {
    let base = i
    let f = x => x + base
    acc = lar_ap(f, 1)
    i = i + 1
  }
  Test.assert_eq(acc, 1000)
}

test "lambda_arg_release_named_fn_static_pair_noop" {
  -- A named fn flows through the same borrowed-param release and must
  -- no-op on its static pair every iteration.
  let mut i = 0
  let mut acc = 0
  while i < 1000 {
    acc = lar_ap(lar_inc, i)
    i = i + 1
  }
  Test.assert_eq(acc, 1000)
}

test "lambda_arg_release_heap_occupancy_flat" {
  -- Warm one round so the free list is primed, then a larger churn
  -- must not move the rc arena bump offset at all: every pair+env is
  -- released and re-served from the free list.
  lar_churn_direct(100)
  let before = runtime_rc_test_heap_arena_offset()
  lar_churn_direct(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "lambda_arg_release_generic_heap_occupancy_flat" {
  lar_churn_generic(100)
  let before = runtime_rc_test_heap_arena_offset()
  lar_churn_generic(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "lambda_arg_release_method_heap_occupancy_flat" {
  lar_churn_method(100)
  let before = runtime_rc_test_heap_arena_offset()
  lar_churn_method(5000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}
