use runtime/rc_implicit_test.{*}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}
use stdlib/option.{None, Some}

fn weak_surface_live_value() -> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  let w: weak RuntimeRcProbe = weak_ref(p)
  let q: RuntimeRcProbe | nil = weak_load(w)
  if q == p { 42 } else { 0 }
}

fn weak_surface_make_dead_weak() -> weak RuntimeRcProbe {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  weak_ref(p)
}

fn weak_surface_dead_value() -> i64 {
  let w: weak RuntimeRcProbe = weak_surface_make_dead_weak()
  let q: RuntimeRcProbe | nil = weak_load(w)
  if q == nil { 1 } else { 0 }
}

fn weak_surface_reader(w: weak RuntimeRcProbe) -> () -> i64 {
  () => {
    let q: RuntimeRcProbe | nil = weak_load(w)
    if q != nil { 1 } else { 0 }
  }
}

fn weak_surface_closure_value() -> i64 {
  let f: () -> i64 = () => 42
  let w: weak (() -> i64) = weak_ref(f)
  let g: (() -> i64) | nil = weak_load(w)
  if g == nil { 0 } else { 42 }
}

fn weak_surface_load_scope_releases_optional() -> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  let w: weak RuntimeRcProbe = weak_ref(p)
  let during = {
    let q: RuntimeRcProbe | nil = weak_load(w)
    runtime_rc_probe_count(p)
  }
  let after = runtime_rc_probe_count(p)
  during * 10 + after
}

fn weak_surface_vector(value: RuntimeRcProbe) -> PersistentVector<weak RuntimeRcProbe> {
  let reference: weak RuntimeRcProbe = weak_ref(value)
  persistent_vector.new<weak RuntimeRcProbe>().push(reference)
}

test "weak_surface_ref_and_load_live_value" {
  Test.assert_eq(weak_surface_live_value(), 42)
}

test "weak_surface_load_returns_zero_after_strong_owner_drops" {
  Test.assert_eq(weak_surface_dead_value(), 1)
}

test "weak_surface_param_and_closure_capture_retain_weak_handle" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  let w: weak RuntimeRcProbe = weak_ref(p)
  let reader: () -> i64 = weak_surface_reader(w)
  Test.assert_eq(runtime_rc_probe_weak_count(p), 2)
  Test.assert_eq(reader(), 1)
}

test "weak_surface_live_load_increments_strong_count" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  let w: weak RuntimeRcProbe = weak_ref(p)
  Test.assert_eq(runtime_rc_probe_weak_count(p), 1)
  let q: RuntimeRcProbe | nil = weak_load(w)
  Test.assert_eq(if q == p { 1 } else { 0 }, 1)
  Test.assert_eq(runtime_rc_probe_count(p), 2)
}

test "weak_surface_ref_and_load_live_closure" {
  Test.assert_eq(weak_surface_closure_value(), 42)
}

test "weak_surface_optional_load_releases_after_scope" {
  Test.assert_eq(weak_surface_load_scope_releases_optional(), 21)
}

test "persistent vectors own weak element stakes" {
  let value = runtime_rc_probe_new(0)
  let references = weak_surface_vector(value)
  Test.assert_eq(runtime_rc_probe_weak_count(value), 1)
  match references.get(0) {
    None -> Test.assert_true(false)
    Some(reference) -> {
      Test.assert_eq(runtime_rc_probe_weak_count(value), 2)
      match weak_load(reference) {
        nil -> Test.assert_true(false)
        loaded -> Test.assert_true(loaded == value)
      }
    }
  }
}
