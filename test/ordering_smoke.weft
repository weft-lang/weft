use stdlib/ord.{*}

type OrderingSmoke { OrderingSmoke(i64) }

fn ordering_smoke_value(value: OrderingSmoke) -> i64 {
  match value { OrderingSmoke(inner) -> inner }
}

impl Ord for OrderingSmoke {
  fn compare(self: Self, other: Self) -> Ordering {
    ordering_smoke_value(self).compare(ordering_smoke_value(other))
  }
}

fn main() -> i64 {
  if OrderingSmoke(1) < OrderingSmoke(2) { 0 } else { 1 }
}
