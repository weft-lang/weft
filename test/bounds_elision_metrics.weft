-- test/bounds_elision_metrics.weft -- fact-driven vector bounds-check
-- elision: runtime soundness locks and static coverage tripwires.
--
-- bounds_probe_modes encodes the distribution of vector get/set check
-- modes across the optimised IR of a probe source: one byte per
-- check_mode value (bits: 1 = non-null proven, 2 = lower bound proven,
-- 4 = upper bound proven; a set bit means the runtime check is
-- ELIDED). Wrapper inlining means elided modes can be backed by the
-- wrapper's own inlined guards, so soundness is locked by the RUNTIME
-- tests below, and the static pins are coverage tripwires.

use "stdlib/vector.weft"
use stdlib/f64_table.{*}
use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/unsafe.weft"

fn bounds_probe_ir(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

-- Slot-fact probes analyse the pre-promotion IR: the fact plane runs
-- (and decides check modes) before mem2reg rewrites the slots away.
fn bounds_probe_ir_pre(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir_pre_promotion(typed, ir)
}

fn bounds_probe_mode_insts(insts: IrInstList, acc: i64) -> i64 {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> acc + (1 bshl (check_mode * 8))
        IrVectorSetI64(dst, vec, index, value, check_mode) -> acc + (1 bshl (check_mode * 8))
        _ -> acc
      }
      bounds_probe_mode_insts(rest, next)
    }
  }
}

fn bounds_probe_mode_blocks(blocks: IrBlockList, acc: i64) -> i64 {
  match blocks {
    IrBlockListNil -> acc
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> bounds_probe_mode_blocks(rest, bounds_probe_mode_insts(insts, acc))
      }
    }
  }
}

fn bounds_probe_mode_functions(functions: IrFunctionList, want_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == want_hash { bounds_probe_mode_blocks(blocks, 0) }
          else { bounds_probe_mode_functions(rest, want_hash) }
        }
      }
    }
  }
}

fn bounds_probe_modes(src: str) -> i64 {
  bounds_probe_mode_functions(
    pipeline_ir_functions(bounds_probe_ir(src)),
    str_hash(__str_ptr("f"), 0, __str_len("f"))
  )
}

fn indexed_bounds_probe_mode_insts(insts: IrInstList, acc: i64) -> i64 {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          let mode = pipeline_runtime_index_address_check_mode(callee_hash)
          if mode >= 0 { acc + (1 bshl (mode * 8)) } else { acc }
        }
        _ -> acc
      }
      indexed_bounds_probe_mode_insts(rest, next)
    }
  }
}

fn indexed_bounds_probe_mode_blocks(blocks: IrBlockList, acc: i64) -> i64 {
  match blocks {
    IrBlockListNil -> acc
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> indexed_bounds_probe_mode_blocks(rest, indexed_bounds_probe_mode_insts(insts, acc))
      }
    }
  }
}

fn indexed_bounds_probe_mode_functions(functions: IrFunctionList, want_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == want_hash { indexed_bounds_probe_mode_blocks(blocks, 0) }
          else { indexed_bounds_probe_mode_functions(rest, want_hash) }
        }
      }
    }
  }
}

fn indexed_bounds_probe_modes(src: str) -> i64 {
  indexed_bounds_probe_mode_functions(
    pipeline_ir_functions(bounds_probe_ir(src)),
    str_hash(__str_ptr("f"), 0, __str_len("f"))
  )
}

fn slice_bounds_probe_mode_insts(insts: IrInstList, acc: i64) -> i64 {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrCallI64(dst, callee_hash, args) -> {
          let mode = pipeline_runtime_slice_address_check_mode(callee_hash)
          if mode >= 0 { acc + (1 bshl (mode * 8)) } else { acc }
        }
        _ -> acc
      }
      slice_bounds_probe_mode_insts(rest, next)
    }
  }
}

fn slice_bounds_probe_mode_blocks(blocks: IrBlockList, acc: i64) -> i64 {
  match blocks {
    IrBlockListNil -> acc
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> slice_bounds_probe_mode_blocks(rest, slice_bounds_probe_mode_insts(insts, acc))
      }
    }
  }
}

fn slice_bounds_probe_mode_functions(functions: IrFunctionList, want_hash: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == want_hash { slice_bounds_probe_mode_blocks(blocks, 0) }
          else { slice_bounds_probe_mode_functions(rest, want_hash) }
        }
      }
    }
  }
}

fn slice_bounds_probe_modes(src: str) -> i64 {
  slice_bounds_probe_mode_functions(
    pipeline_ir_functions(bounds_probe_ir(src)),
    str_hash(__str_ptr("f"), 0, __str_len("f"))
  )
}

fn indexed_bounds_probe_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_lower_native_module(typed, pipeline_optimise_typed_ir(typed, ir))
}

test "indexed_bounds_unconditional_slice_keeps_upper_check" {
  let src = "fn f(xs: [i64], i: usize) -> i64 { xs[i] } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(src), 65536)
}

test "indexed_bounds_guarded_slice_elides_full_check" {
  let src = "fn f(xs: [i64], i: usize) -> i64 { if i < xs.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(src), 281474976710656)
}

test "indexed_bounds_reversed_and_false_polarities_elide" {
  let reversed = "fn f(xs: [i64], i: usize) -> i64 { if xs.len > i { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  let false_edge = "fn f(xs: [i64], i: usize) -> i64 { if i >= xs.len { 0 } else { xs[i] } } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(reversed), 281474976710656)
  Test.assert_eq(indexed_bounds_probe_modes(false_edge), 281474976710656)
}

test "indexed_bounds_fixed_array_constant_and_guard_elide" {
  let constant = "fn f() -> i64 { let xs = [10, 20, 30] xs[1] } fn main() -> i64 { 0 }"
  let guarded = "fn f(xs: [i64; 3], i: usize) -> i64 { if i < xs.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(constant), 281474976710656)
  -- rc_array_storage_data is inlined to a null-check diamond before the
  -- access; the exact indexed fact must survive that common join.
  Test.assert_eq(indexed_bounds_probe_modes(guarded), 281474976710656)
}

test "indexed_bounds_mutable_slice_write_consumes_same_fact" {
  let src = "fn f(xs: [mut i64], i: usize) -> nil { if i < xs.len { xs[i] = 7 } else { nil } } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(src), 281474976710656)
}

test "indexed_bounds_wrong_length_and_nonstrict_guard_rejected" {
  let wrong_storage = "fn f(xs: [i64], ys: [i64], i: usize) -> i64 { if i < ys.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  let nonstrict = "fn f(xs: [i64], i: usize) -> i64 { if i <= xs.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(wrong_storage), 65536)
  Test.assert_eq(indexed_bounds_probe_modes(nonstrict), 65536)
}

test "indexed_bounds_native_counters_pair_partial_and_full_proofs" {
  let unchecked_src = "fn f(xs: [i64], i: usize) -> i64 { xs[i] } fn main() -> i64 { 0 }"
  let unchecked_native = indexed_bounds_probe_native(unchecked_src)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(unchecked_native), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(unchecked_native), 0)
  let guarded_src = "fn f(xs: [i64], i: usize) -> i64 { if i < xs.len { xs[i] } else { 0 } } fn main() -> i64 { 0 }"
  let guarded_native = indexed_bounds_probe_native(guarded_src)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(guarded_native), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(guarded_native), 1)
}

test "indexed_bounds_shared_counters_include_vector_sites" {
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, i: i64) -> i64 { if i >= 0 { if i < vector_len<i64>(v) { vector_get<i64>(v, i, 0) } else { 0 } } else { 0 } } fn main() -> i64 { 0 }"
  let native = indexed_bounds_probe_native(src)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(native), pipeline_native_vector_bounds_elision_count(native))
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(native), pipeline_native_vector_full_bounds_elision_count(native))
  Test.assert_eq(if pipeline_native_indexed_full_bounds_elision_count(native) >= 1 { 1 } else { 0 }, 1)
}

test "indexed_bounds_primitive_for_reuses_full_loop_proof" {
  let array_src = "fn f(xs: [i64; 4]) -> i64 { let mut total = 0 for x in xs { total = total + x } total } fn main() -> i64 { 0 }"
  let slice_src = "fn f(xs: [i64]) -> i64 { let mut total = 0 for x in xs { total = total + x } total } fn main() -> i64 { 0 }"
  Test.assert_eq(indexed_bounds_probe_modes(array_src), 281474976710656)
  Test.assert_eq(indexed_bounds_probe_modes(slice_src), 281474976710656)
  let array_native = indexed_bounds_probe_native(array_src)
  let slice_native = indexed_bounds_probe_native(slice_src)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(array_native), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(slice_native), 1)
}

test "slice_bounds_unconditional_view_keeps_both_checks" {
  let src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { xs[start..end] } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 1)
}

test "slice_bounds_order_guard_elides_order_check" {
  let src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { if start <= end { xs[start..end] } else { xs } } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 65536)
}

test "slice_bounds_upper_guard_elides_upper_check" {
  let src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { if end <= xs.len { xs[start..end] } else { xs } } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 4294967296)
}

test "slice_bounds_combined_guards_elide_both_checks" {
  let src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { if start <= end { if end <= xs.len { xs[start..end] } else { xs } } else { xs } } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 281474976710656)
}

test "slice_bounds_fixed_constants_elide_both_checks" {
  let src = "fn f() -> usize { let xs = [10, 20, 30] xs[1..3].len } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 281474976710656)
}

test "slice_bounds_wrong_owner_does_not_supply_upper_proof" {
  let src = "fn f(xs: [i64], ys: [i64], start: usize, end: usize) -> [i64] { if start <= end { if end <= ys.len { xs[start..end] } else { xs } } else { xs } } fn main() -> i64 { 0 }"
  Test.assert_eq(slice_bounds_probe_modes(src), 65536)
}

test "slice_bounds_native_counters_include_partial_and_full_proofs" {
  let partial_src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { if start <= end { xs[start..end] } else { xs } } fn main() -> i64 { 0 }"
  let partial = indexed_bounds_probe_native(partial_src)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(partial), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(partial), 0)
  let full_src = "fn f(xs: [i64], start: usize, end: usize) -> [i64] { if start <= end { if end <= xs.len { xs[start..end] } else { xs } } else { xs } } fn main() -> i64 { 0 }"
  let full = indexed_bounds_probe_native(full_src)
  Test.assert_eq(pipeline_native_indexed_bounds_elision_count(full), 1)
  Test.assert_eq(pipeline_native_indexed_full_bounds_elision_count(full), 1)
}

fn bounds_shrink_subject(v: Vector<i64>, i: i64) -> i64 {
  if i >= 0 {
    if i < vector_len<i64>(v) {
      vector_clear<i64>(v)
      vector_get<i64>(v, i, 0 - 7)
    } else { 0 - 1 }
  } else { 0 - 1 }
}

test "bounds_runtime_shrink_takes_fallback" {
  -- RUNTIME SOUNDNESS LOCK: vector_clear between the length guard and
  -- the get shrinks the vector to zero; the get must take its fallback
  -- rather than read the stale element through an elided check.
  let v = vector_new<i64>()
  vector_push<i64>(v, 10)
  vector_push<i64>(v, 20)
  vector_push<i64>(v, 30)
  Test.assert_eq(bounds_shrink_subject(v, 1), 0 - 7)
}

fn bounds_and_guard_subject(v: Vector<i64>, j: i64, key: i64) -> i64 {
  if j >= 0 and vector_get<i64>(v, j, 0 - 7) > key { 1 } else { 0 }
}

test "bounds_runtime_and_guard_out_of_range" {
  -- RUNTIME SOUNDNESS LOCK: `and` short-circuits, so a negative j
  -- never reaches the get; an in-range j and an over-range j must
  -- resolve through the guard chain and the upper check/fallback.
  let v = vector_new<i64>()
  vector_push<i64>(v, 100)
  Test.assert_eq(bounds_and_guard_subject(v, 0 - 1, 5), 0)
  Test.assert_eq(bounds_and_guard_subject(v, 0, 5), 1)
  Test.assert_eq(bounds_and_guard_subject(v, 3, 5), 0)
}

test "bounds_shrink_static_modes" {
  -- Coverage tripwire: the access after the shrink keeps only the
  -- elisions backed by the wrapper's inlined post-shrink guard
  -- (runtime lock above proves the fallback path).
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, i: i64) -> i64 { if i >= 0 { if i < vector_len<i64>(v) { vector_clear<i64>(v) vector_get<i64>(v, i, 0) } else { 0 } } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 65536)
}

test "bounds_and_guard_static_modes" {
  -- `and` short-circuits and its merge param aliases the compare in
  -- the value-definition table, so the guarded get elides its lower
  -- bound (mode 2); the wrapper spec's residual get proves both of
  -- its own internal guards (mode 6).
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, j: i64, key: i64) -> i64 { if j >= 0 and vector_get<i64>(v, j, 0) > key { 1 } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 65536)
}

test "bounds_guarded_get_elides_both_checks" {
  -- Nonnegative guard plus length guard proves both bounds.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, i: i64) -> i64 { if i >= 0 { if i < vector_len<i64>(v) { vector_get<i64>(v, i, 0) } else { 0 } } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 281474976710656)
}

test "bounds_while_header_len_elides_both" {
  -- while i < vector_len(v): the header compare proves the upper bound
  -- and slot induction (i starts at 0, single guarded increment)
  -- proves the lower bound for the body get.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let mut i = 0 let mut s = 0 while i < vector_len<i64>(v) { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 281474976710656)
}

test "bounds_hoisted_len_elides_upper" {
  -- let len = vector_len(v) hoisted out of the loop: the value-def
  -- table's length origin still proves the upper bound cross-block.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode4 = (acc bshr 32) band 255
  let mode6 = (acc bshr 48) band 255
  Test.assert_eq(if mode4 + mode6 >= 1 { 1 } else { 0 }, 1)
}

test "bounds_nonneg_guard_elides_lower_in_loop" {
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, n: i64) -> i64 { let mut j = n let mut s = 0 let mut moving = 1 while moving == 1 { if j >= 0 { s = s + vector_get<i64>(v, j, 0) j = j - 1 } else { moving = 0 } } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode2 = (acc bshr 16) band 255
  let mode6 = (acc bshr 48) band 255
  Test.assert_eq(if mode2 + mode6 >= 1 { 1 } else { 0 }, 1)
}

fn bounds_probe_slot_verdicts(blocks: IrBlockList) -> i64 {
  let cfg = pipeline_ir_cfg_fact_bundle(blocks)
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let seed = pipeline_ir_block_entry_facts_from_blocks_inner(blocks, blocks, cfg, pipeline_ir_block_entry_facts_empty())
  let propagated = pipeline_ir_block_entry_facts_propagate_fixpoint(blocks, cfg, seed, ir_block_list_len(blocks) + 1)
  let slots = nlist_new()
  pipeline_ir_collect_store_slots(blocks, slots)
  let n = nlist_len(slots)
  let mut passing = 0
  let mut i = 0
  while i < n {
    passing = passing + pipeline_ir_slot_nonneg_invariant(blocks, table, propagated, nlist_get(slots, i))
    i = i + 1
  }
  passing
}

fn bounds_probe_exact_fn_verdicts(src: str, want_slots: i64) -> i64 {
  let mut cur = pipeline_ir_functions(bounds_probe_ir_pre(src))
  let mut result = 0 - 1
  let mut done = 0
  let want_hash = str_hash(__str_ptr("f"), 0, __str_len("f"))
  while done == 0 {
    match cur {
      IrFunctionNil -> { done = 1 }
      IrFunctionCons(f, rest) -> {
        match f {
          IrFunction(hash, params, blocks, src2) -> {
            let slots = nlist_new()
            pipeline_ir_collect_store_slots(blocks, slots)
            if hash == want_hash and nlist_len(slots) == want_slots and ir_block_list_len(blocks) > 3 {
              result = bounds_probe_slot_verdicts(blocks)
              done = 1
            } else {
              cur = rest
            }
          }
        }
      }
    }
  }
  result
}

test "bounds_unbounded_increment_rejected_by_induction" {
  -- SOUNDNESS TRIPWIRE for the slot induction rule: an increment with
  -- no strict upper bound on any load of the slot must NOT prove
  -- nonnegativity (the increment could wrap after 2^63 iterations).
  -- Exactly one slot passes: go, whose stores are all nonnegative
  -- constants (sound). The unbounded index i, the accumulator s, and
  -- the stride-2 counter w must all be rejected.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let mut i = 0 let mut s = 0 let mut w = 0 let mut go = 1 while go == 1 { s = s + vector_get<i64>(v, i, 0) w = w + 2 i = i + 1 if s > 100 { go = 0 } else { 0 } } s + w } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_exact_fn_verdicts(src, 4), 1)
}

test "bounds_guarded_increment_accepted_by_induction" {
  -- The while-header strict bound makes the increment overflow-free,
  -- so the index slot passes the invariant.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let mut i = 0 let mut s = 0 while i < vector_len<i64>(v) { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(if bounds_probe_exact_fn_verdicts(src, 2) >= 1 { 1 } else { 0 }, 1)
}

-- ── and-decomposition, offset rule, dominating-bound induction (2o) ──

test "bounds_and_guard_decomposition_elides_body_lower" {
  -- Branch-true on and(ge(j,0), gt(get,key)) implies ge(j,0): the body
  -- get's lower bound elides via the decomposed slot fact. The guard
  -- get itself stays fully checked — the eager and evaluates it on the
  -- dynamic j == -1 exit iteration, so its lower check is load-bearing.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, n: i64, key: i64) -> i64 { let mut j = n let mut s = 0 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(v, j, 0) > key { s = s + vector_get<i64>(v, j, 0) j = j - 1 } else { moving = 0 } } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode2 = (acc bshr 16) band 255
  Test.assert_eq(if mode2 >= 1 { 1 } else { 0 }, 1)
}

test "bounds_dominating_check_accepts_sortit_outer_index" {
  -- The outer index i of the insertion-sort shape increments far from
  -- the loop guard, behind the inner loop's joins. The guard's strict
  -- bound lives in a block that DOMINATES the increment and sits on
  -- every cycle through it, so the induction accepts i and the key
  -- load elides both bounds (mode 6).
  let src = "use \"stdlib/vector.weft\" fn f(items: Vector<i64>) -> Vector<i64> { let len = vector_len<i64>(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode6 = (acc bshr 48) band 255
  Test.assert_eq(if mode6 >= 2 { 1 } else { 0 }, 1)
}

test "bounds_nondominating_check_rejected_by_induction" {
  -- SOUNDNESS TRIPWIRE for the dominating-bound gate: the i < len
  -- check's TRUE block does not dominate the increment (the else path
  -- reaches it too), so the bound proves nothing about the increment
  -- and i must stay unproven.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, n: i64) -> i64 { let len = vector_len<i64>(v) let mut i = 0 let mut g = 0 let mut s = 0 while g < n { if i < len { s = s + 1 } else { s = s + 2 } i = i + 1 g = g + 1 } s + i } fn main() -> i64 { 0 }"
  -- slots: i, g, s. g passes (bounded by its own while header); i must
  -- not; s must not.
  Test.assert_eq(bounds_probe_exact_fn_verdicts(src, 3), 1)
}

test "bounds_inner_cycle_avoiding_check_rejected_by_induction" {
  -- SOUNDNESS TRIPWIRE for the cycle condition: the increment sits in
  -- an inner loop whose backedge avoids the outer guard, so the
  -- increment can repeat without a fresh check and must be rejected.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let mut i = 0 let mut s = 0 while i < vector_len<i64>(v) { let mut k = 0 while k < 3 { i = i + 1 k = k + 1 } s = s + 1 } s } fn main() -> i64 { 0 }"
  -- slots: i, s, k. k passes (own while-header bound); i must be
  -- rejected despite the dominating outer check; s has no bound.
  Test.assert_eq(bounds_probe_exact_fn_verdicts(src, 3), 1)
}

fn bounds_sortit_runtime(items: Vector<i64>) -> Vector<i64> {
  let len = vector_len<i64>(items)
  let mut i = 1
  while i < len {
    let key = vector_get<i64>(items, i, 0)
    let mut j = i - 1
    let mut moving = 1
    while moving == 1 {
      if j >= 0 and vector_get<i64>(items, j, 0) > key {
        vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0))
        j = j - 1
      } else {
        moving = 0
      }
    }
    vector_set<i64>(items, j + 1, key)
    i = i + 1
  }
  items
}

fn bounds_sortit_check(items: Vector<i64>) -> i64 {
  -- 1 when sorted ascending
  let len = vector_len<i64>(items)
  let mut i = 1
  let mut ok = 1
  while i < len {
    if vector_get<i64>(items, i - 1, 0) > vector_get<i64>(items, i, 0) { ok = 0 } else { 0 }
    i = i + 1
  }
  ok
}

test "bounds_sortit_runtime_lock_under_elision" {
  -- RUNTIME LOCK: this binary is compiled by the candidate compiler
  -- with the new elisions active; the insertion sort — including the
  -- eager guard get's j == -1 exit iterations — must still sort every
  -- adversarial shape correctly.
  let a = vector_new<i64>()
  vector_push<i64>(a, 5)
  vector_push<i64>(a, 1)
  vector_push<i64>(a, 4)
  vector_push<i64>(a, 2)
  vector_push<i64>(a, 3)
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(a)), 1)
  let b = vector_new<i64>()
  vector_push<i64>(b, 3)
  vector_push<i64>(b, 2)
  vector_push<i64>(b, 1)
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(b)), 1)
  Test.assert_eq(vector_get<i64>(bounds_sortit_runtime(b), 0, 0 - 9), 1)
  let c = vector_new<i64>()
  vector_push<i64>(c, 7)
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(c)), 1)
  let d = vector_new<i64>()
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(d)), 1)
  let e = vector_new<i64>()
  vector_push<i64>(e, 2)
  vector_push<i64>(e, 2)
  vector_push<i64>(e, 2)
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(e)), 1)
  let f = vector_new<i64>()
  vector_push<i64>(f, 1)
  vector_push<i64>(f, 2)
  vector_push<i64>(f, 3)
  vector_push<i64>(f, 4)
  Test.assert_eq(bounds_sortit_check(bounds_sortit_runtime(f)), 1)
}

-- ── slot upper-bound induction + offset rule (2o unit 2) ──

test "bounds_sortit_ledger_fully_elided_gets" {
  -- With the decrement upper induction (j < len from init i-1 with i
  -- bounded, own-decrement under the dominating j >= 0 guard) plus the
  -- offset rule (nonneg(j+1) from nonneg(j) with wrap-safety from j's
  -- upper), the slot rules take all three gets to mode 6. The
  -- post-promotion loop-param induction then finishes the two sets:
  -- j's header param proves L1 (j >= -1: entry i-1 with i an L0 param,
  -- guarded own-decrement backedge) and U(1) (j < len - 1: entry i-1
  -- under i's strict bound, decrement backedges preserve), so the
  -- derived offset j + 1 is nonneg with an in-bounds upper at both set
  -- sites. Every get and set reaches mode 6; only the parameter nil
  -- checks remain.
  let src = "use \"stdlib/vector.weft\" fn f(items: Vector<i64>) -> Vector<i64> { let len = vector_len<i64>(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  -- Probe only the subject function: all five accesses are fully elided.
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 48) band 255, 5)
  Test.assert_eq((acc bshr 16) band 255, 0)
  Test.assert_eq(acc band 255, 0)
}

test "bounds_upper_induction_rejects_const_store" {
  -- SOUNDNESS TRIPWIRE: a raw const store cannot be compared to a
  -- runtime length, so the slot must not acquire an upper fact and the
  -- guarded get keeps its upper check.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, n: i64) -> i64 { let len = vector_len<i64>(v) let mut i = 1 let mut s = 0 while i < len { let mut j = i - 1 if n > 3 { j = 5 } else { 0 } let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(v, j, 0) > s { s = s + 1 j = j - 1 } else { moving = 0 } } i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 48) band 255, 0)
}

test "bounds_upper_induction_rejects_unguarded_decrement" {
  -- SOUNDNESS TRIPWIRE: an own-decrement with no dominating lower-bound
  -- guard can underflow-wrap to the integer maximum; the slot must not
  -- acquire an upper fact.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>, n: i64) -> i64 { let len = vector_len<i64>(v) let mut i = 1 let mut s = 0 while i < len { let mut j = i - 1 let mut g = 0 while g < n { s = s + vector_get<i64>(v, j, 0) j = j - 1 g = g + 1 } i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 48) band 255, 0)
}

test "bounds_upper_induction_disabled_by_shrink_capable_ops" {
  -- SOUNDNESS TRIPWIRE: a generic call that may shrink the vector makes
  -- every block len-unstable, so the whole-function upper seeding must
  -- not run and the guarded get keeps its upper check.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 1 let mut s = 0 while i < len { let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(v, j, 0) > s { s = s + 1 j = j - 1 } else { moving = 0 } } vector_push<i64>(v, s) i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 48) band 255, 0)
}
-- DRAFT: additions to test/bounds_elision_metrics.weft (row-upper facts)

-- ── scaled-index (row-upper) elision: f64_table shapes ──

test "bounds_row_while_shape_elides_all_sites" {
  -- Pair-loop table kernel, while form: count = len/7 via the
  -- f64_table_row_count rewrite; i and j row-bounded by the guards;
  -- indices i*7+f. All four sites reach mode 6.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>) -> Vector<f64> { let count = f64_table_row_count(bodies, 7) let mut i = 0 while i < count { let mut j = i + 1 while j < count { let xi = f64_table_get(bodies, i, 7, 0, 0.0) let xj = f64_table_get(bodies, j, 7, 0, 0.0) f64_table_set(bodies, i, 7, 3, xi - xj) f64_table_set(bodies, j, 7, 3, xi + xj) j = j + 1 } i = i + 1 } bodies } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 1125899906842624)
}

test "bounds_row_for_range_shape_elides_all_sites" {
  -- Same kernel in for-range form: the desugared shadow binding routes
  -- through value-keyed row facts (load of a row-bounded slot flooded
  -- through the dominated loop body).
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>, steps: i64) -> Vector<f64> { let count = f64_table_row_count(bodies, 7) for step in 0..steps { for i in 0..count { let mut j = i + 1 while j < count { let xi = f64_table_get(bodies, i, 7, 0, 0.0) let xj = f64_table_get(bodies, j, 7, 0, 0.0) f64_table_set(bodies, i, 7, 3, xi - xj) f64_table_set(bodies, j, 7, 3, xi + xj) j = j + 1 } } } bodies } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 1125899906842624)
}

test "bounds_row_three_loop_kernel_extended_plane" {
  -- The full nbody_advance shape: pair loop + position loop inside the
  -- step loop is ~40 blocks, over the 32-block plane. The scaled-index
  -- shape (div + mul + vector ops) admits it to the extended 64-block
  -- plane; every one of the nine kernel sites elides.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/math.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>, steps: i64) -> Vector<f64> { let dt = 0.01 let count = f64_table_row_count(bodies, 7) for step in 0..steps { for i in 0..count { let mut j = i + 1 while j < count { let xi = f64_table_get(bodies, i, 7, 0, 0.0) let xj = f64_table_get(bodies, j, 7, 0, 0.0) let dx = xi - xj let d2 = dx * dx let mag = dt / (d2 * math_sqrt_f64(d2)) let vxi = f64_table_get(bodies, i, 7, 3, 0.0) let vxj = f64_table_get(bodies, j, 7, 3, 0.0) f64_table_set(bodies, i, 7, 3, vxi - dx * mag) f64_table_set(bodies, j, 7, 3, vxj + dx * mag) j = j + 1 } } for i in 0..count { let x = f64_table_get(bodies, i, 7, 0, 0.0) let vx = f64_table_get(bodies, i, 7, 3, 0.0) f64_table_set(bodies, i, 7, 0, x + dt * vx) } } bodies } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 2533274790395904)
}

test "bounds_row_pure_call_keeps_len_facts" {
  -- math_sqrt_f64 between the guard and the access: pure callees are
  -- exempt from the len-fact kill, so the get still reaches mode 6.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/math.weft\" use \"stdlib/f64_table.weft\" fn f(v: Vector<f64>) -> f64 { let mut i = 0 let mut s = 0.0 while i < vector_len<f64>(v) { let t = math_sqrt_f64(0.25) let x = f64_table_get(v, i, 1, 0, 0.0) s = s + x * t i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 281474976710656)
}

-- ── soundness tripwires: shapes that must NOT elide ──

test "bounds_row_non_strict_guard_rejected" {
  -- while j <= count is NOT a strict row bound: j == count would index
  -- count*7+f >= len. The seeder admits strict polarities only, so the
  -- sites keep their upper checks (no mode-6 kernel sites: the mode-6
  -- byte is therefore zero).
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>) -> f64 { let count = f64_table_row_count(bodies, 7) let mut j = 0 let mut s = 0.0 while j <= count { s = s + f64_table_get(bodies, j, 7, 0, 0.0) j = j + 1 } s } fn main() -> i64 { 0 }"
  let mode6 = (bounds_probe_modes(src) bshr 48) band 255
  Test.assert_eq(mode6, 0)
}

test "bounds_row_width_mismatch_rejected" {
  -- Guard proves j < len/7 but the access uses width 5: j*5+4 is not
  -- covered by the width-7 quotient bound. The widths must match, so
  -- the kernel site must not reach mode 6.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>) -> f64 { let count = f64_table_row_count(bodies, 7) let mut j = 0 let mut s = 0.0 while j < count { s = s + f64_table_get(bodies, j, 5, 4, 0.0) j = j + 1 } s } fn main() -> i64 { 0 }"
  let mode6 = (bounds_probe_modes(src) bshr 48) band 255
  Test.assert_eq(mode6, 0)
}

test "bounds_row_impure_call_kills_upper" {
  -- vector_clear between the guard and the access can shrink the
  -- table; the len-derived row bound must not elide the upper check.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>, other: Vector<i64>) -> f64 { let count = f64_table_row_count(bodies, 7) let mut j = 0 let mut s = 0.0 while j < count { vector_clear<i64>(other) s = s + f64_table_get(bodies, j, 7, 0, 0.0) j = j + 1 } s } fn main() -> i64 { 0 }"
  let mode6 = (bounds_probe_modes(src) bshr 48) band 255
  Test.assert_eq(mode6, 0)
}

test "bounds_row_store_before_access_kills_fact" {
  -- The increment lands between the guard and the access: the slot's
  -- row bound no longer describes the loaded value (j may now equal
  -- count), so the site must not elide its upper check.
  let src = "use \"stdlib/vector.weft\" use \"stdlib/f64_table.weft\" fn f(bodies: Vector<f64>) -> f64 { let count = f64_table_row_count(bodies, 7) let mut j = 0 let mut s = 0.0 while j < count { j = j + 1 s = s + f64_table_get(bodies, j, 7, 0, 0.0) } s } fn main() -> i64 { 0 }"
  let mode6 = (bounds_probe_modes(src) bshr 48) band 255
  Test.assert_eq(mode6, 0)
}

-- ── runtime soundness locks ──

fn bounds_row_kernel_sum(t: Vector<f64>, width: i64) -> f64 {
  let count = f64_table_row_count(t, 3)
  let mut s = 0.0
  let mut i = 0
  while i < count {
    let mut j = i + 1
    while j < count {
      s = s + f64_table_get(t, i, 3, 2, 0.0) + f64_table_get(t, j, 3, 0, 0.0)
      j = j + 1
    }
    i = i + 1
  }
  s
}

test "bounds_row_runtime_non_multiple_length" {
  -- RUNTIME LOCK: a 10-element vector at width 3 has 3 full rows and a
  -- leftover element; the elided accesses must hit exactly the right
  -- slots (top row, top field included) and never the leftover.
  let t = f64_table_new(3, 3)
  vector_push<f64>(t, 1.0)
  vector_push<f64>(t, 2.0)
  vector_push<f64>(t, 4.0)
  vector_push<f64>(t, 8.0)
  vector_push<f64>(t, 16.0)
  vector_push<f64>(t, 32.0)
  vector_push<f64>(t, 64.0)
  vector_push<f64>(t, 128.0)
  vector_push<f64>(t, 256.0)
  vector_push<f64>(t, 1024.0)
  -- rows: (1,2,4) (8,16,32) (64,128,256); leftover 1024
  -- pairs: (0,1): 4+8, (0,2): 4+64, (1,2): 32+64 -> sum = 176
  Test.assert_eq(if bounds_row_kernel_sum(t, 3) == 176.0 { 1 } else { 0 }, 1)
}

test "bounds_row_runtime_out_of_range_falls_back" {
  -- RUNTIME LOCK: an unguarded row index beyond the row count keeps
  -- its checks and takes the fallback.
  let t = f64_table_new(3, 2)
  vector_push<f64>(t, 1.0)
  vector_push<f64>(t, 2.0)
  vector_push<f64>(t, 3.0)
  Test.assert_eq(if f64_table_get(t, 5, 3, 1, 0.0 - 7.0) == 0.0 - 7.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if f64_table_get(t, 0 - 1, 3, 1, 0.0 - 9.0) == 0.0 - 9.0 { 1 } else { 0 }, 1)
}

test "bounds_runtime_lambda_shrink_takes_fallback" {
  -- RUNTIME SOUNDNESS LOCK (merge-exposed): jump-chain merging can put
  -- an indirect call in the same block as a guarded get. The lambda
  -- shrinks the vector between the guard and the get, so the get must
  -- take its fallback, not read the stale element through an elided
  -- upper check.
  let v = vector_new<i64>()
  vector_push<i64>(v, 10)
  vector_push<i64>(v, 20)
  Test.assert_eq(bounds_lambda_shrink_subject(v), 0 - 7)
}

fn bounds_lambda_shrink_subject(v: Vector<i64>) -> i64 {
  let g = x => { vector_clear<i64>(v) x }
  let mut i = 0
  let mut s = 0
  while i < vector_len<i64>(v) {
    let t = g(0)
    s = s + vector_get<i64>(v, i, 0 - 7) + t
    i = i + 1
  }
  s
}

fn bounds_dup_get_subject(v: Vector<f64>, i: i64) -> f64 {
  let a = f64_table_get(v, i, 3, 1, 0.0)
  let b = f64_table_get(v, i, 3, 1, 0.0)
  a + b
}

fn bounds_get_set_get_subject(v: Vector<f64>) -> f64 {
  let a = f64_table_get(v, 0, 3, 1, 0.0)
  f64_table_set(v, 0, 3, 1, 99.0)
  let b = f64_table_get(v, 0, 3, 1, 0.0)
  a + b
}

test "bounds_runtime_duplicate_get_semantics" {
  -- Redundant-get elimination collapses same vector/index/fallback
  -- gets; a set between two gets clears the table, so the second get
  -- observes the write.
  let v = f64_table_new(3, 1)
  vector_push<f64>(v, 1.0)
  vector_push<f64>(v, 2.0)
  vector_push<f64>(v, 4.0)
  Test.assert_eq(if bounds_dup_get_subject(v, 0) == 4.0 { 1 } else { 0 }, 1)
  Test.assert_eq(if bounds_get_set_get_subject(v) == 101.0 { 1 } else { 0 }, 1)
}

-- ── loop-param induction + post-promotion re-tightening (2o step 3) ──
--
-- mem2reg promotes loop variables in call-bearing loops to header
-- block params; the post-promotion re-tightening pass ports the slot
-- induction rules to those params (L0 nonneg, L1 >= -1, U upper with
-- headroom) and re-runs the fact-consuming walk, where check modes
-- can only gain bits. The positive pin uses a pure call in the inner
-- loop so the slot-pin machinery bails and the sets' indices are
-- derived from a promoted header param.

test "bounds_param_induction_call_bearing_sets_elide" {
  -- j is a header block param (entry i - 1 under i's strict bound,
  -- guarded own-decrement backedge, identity exit edge): L1 gives
  -- j >= -1, U gives j < len - 1, and the derived offset j + 1 elides
  -- both bounds at the body set AND the post-loop set. All five kernel
  -- sites plus the stdlib spec reach mode 6.
  -- hop's dead recursive arm keeps it out of the multi-block inline
  -- candidate set: the point of this shape is a CALL inside the loop
  -- body, and the splice would otherwise dissolve it.
  let src = "use \"stdlib/vector.weft\" fn hop(x: i64) -> i64 { if x > 3 { x - 1 } else { if x < 0 - 1000000 { hop(x + 1) } else { x + 1 } } } fn f(items: Vector<i64>) -> i64 { let len = vector_len<i64>(items) let mut i = 1 let mut s = 0 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) s = s + hop(j) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 48) band 255, 5)
  Test.assert_eq(acc band 255, 0)
  Test.assert_eq((acc bshr 16) band 255, 0)
}

test "bounds_param_unguarded_decrement_rejected" {
  -- SOUNDNESS TRIPWIRE (L1/U): the decrement backedge has no j >= 0
  -- guard, so j can pass -1 and j + 1 can go negative; the param must
  -- prove neither L1 nor U and the set keeps all its checks.
  let src = "use \"stdlib/vector.weft\" fn hop(x: i64) -> i64 { if x > 3 { x - 1 } else { x + 1 } } fn f(v: Vector<i64>, n: i64) -> i64 { let mut i = 0 let mut s = 0 while i < n { let mut j = i - 1 let mut g = 0 while g < 2 { vector_set<i64>(v, j + 1, 100) s = s + hop(j) j = j - 1 g = g + 1 } i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq(acc band 255, 1)
  Test.assert_eq((acc bshr 48) band 255, 0)
}

test "bounds_param_offset_headroom_boundary" {
  -- HEADROOM BOUNDARY: j enters at i (not i - 1), so U proves only
  -- h = 0 (j < len) and the offset j + 1 may equal len — the derived
  -- rule seeds nonneg (j >= -1 via the guarded decrement) but must NOT
  -- seed the upper fact. The set elides exactly its lower bound.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 1 while i < len { let mut j = i let mut m = 1 while m == 1 { if j >= 0 { vector_set<i64>(v, j + 1, 3) j = j - 1 } else { m = 0 } } i = i + 1 } 0 } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq((acc bshr 16) band 255, 1)
  Test.assert_eq((acc bshr 48) band 255, 0)
  Test.assert_eq(acc band 255, 0)
}

test "bounds_param_negative_two_entry_rejected" {
  -- SOUNDNESS TRIPWIRE (L1 tolerance): entry value -2 is below the
  -- -1 tolerance (j + 1 would start at -1), and the ge(j, -1) guard is
  -- not a nonneg fact; the set must keep its lower check.
  let src = "use \"stdlib/vector.weft\" fn hop(x: i64) -> i64 { if x > 3 { x - 1 } else { x + 1 } } fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 1 let mut s = 0 while i < len { let mut j = 0 - 2 let mut m = 1 while m == 1 { if j >= 0 - 1 { vector_set<i64>(v, j + 1, 3) s = s + hop(j) j = j - 1 } else { m = 0 } } i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq(acc band 255, 1)
  Test.assert_eq((acc bshr 48) band 255, 0)
}

test "bounds_param_nondominating_bound_rejected" {
  -- SOUNDNESS TRIPWIRE (L0 dominating gate): the i < len check's true
  -- arm does not dominate the backedge (the else path reaches it too),
  -- so the increment leg proves nothing and the get at param i keeps
  -- its checks.
  let src = "use \"stdlib/vector.weft\" fn hop(x: i64) -> i64 { if x > 3 { x - 1 } else { x + 1 } } fn f(v: Vector<i64>, n: i64) -> i64 { let len = vector_len<i64>(v) let mut i = 0 let mut g = 0 let mut s = 0 while g < n { if i < len { s = s + 1 } else { s = s + 2 } s = s + hop(i) s = s + vector_get<i64>(v, i, 0) i = i + 1 g = g + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  Test.assert_eq(acc band 255, 1)
  Test.assert_eq((acc bshr 48) band 255, 0)
}

fn bounds_param_hop(x: i64) -> i64 {
  if x > 3 { x - 1 } else { x + 1 }
}

fn bounds_param_dec_runtime(v: Vector<i64>, n: i64) -> i64 {
  let mut i = 0
  let mut s = 0
  while i < n {
    let mut j = i - 1
    let mut g = 0
    while g < 2 {
      vector_set<i64>(v, j + 1, i * 10 + g)
      s = s + bounds_param_hop(j)
      j = j - 1
      g = g + 1
    }
    i = i + 1
  }
  s
}

test "bounds_param_runtime_unguarded_decrement_skips_out_of_range" {
  -- RUNTIME SOUNDNESS LOCK: the unguarded decrement drives j + 1 to
  -- -1; the retained checks must skip those writes and leave every
  -- other element exact.
  let v = vector_new<i64>()
  vector_push<i64>(v, 1)
  vector_push<i64>(v, 2)
  vector_push<i64>(v, 3)
  vector_push<i64>(v, 4)
  Test.assert_eq(bounds_param_dec_runtime(v, 2), 0)
  Test.assert_eq(vector_get<i64>(v, 0, 0 - 9), 11)
  Test.assert_eq(vector_get<i64>(v, 1, 0 - 9), 10)
  Test.assert_eq(vector_get<i64>(v, 2, 0 - 9), 3)
  Test.assert_eq(vector_get<i64>(v, 3, 0 - 9), 4)
  Test.assert_eq(vector_len<i64>(v), 4)
}

fn bounds_param_boundary_runtime(v: Vector<i64>) -> i64 {
  let len = vector_len<i64>(v)
  let mut i = 1
  while i < len {
    let mut j = i
    let mut m = 1
    while m == 1 {
      if j >= 0 { vector_set<i64>(v, j + 1, 90 + j) j = j - 1 } else { m = 0 }
    }
    i = i + 1
  }
  0
}

test "bounds_param_runtime_boundary_set_at_len_falls_back" {
  -- RUNTIME SOUNDNESS LOCK for the headroom boundary: j enters at i,
  -- so the first inner write targets j + 1 == i + 1 which reaches len
  -- on the last outer iteration; the retained upper check must skip it
  -- while the in-range writes (lower bound elided) land exactly.
  let v = vector_new<i64>()
  vector_push<i64>(v, 1)
  vector_push<i64>(v, 2)
  vector_push<i64>(v, 3)
  Test.assert_eq(bounds_param_boundary_runtime(v), 0)
  Test.assert_eq(vector_get<i64>(v, 0, 0 - 9), 1)
  Test.assert_eq(vector_get<i64>(v, 1, 0 - 9), 90)
  Test.assert_eq(vector_get<i64>(v, 2, 0 - 9), 91)
  Test.assert_eq(vector_len<i64>(v), 3)
  Test.assert_eq(vector_get<i64>(v, 3, 0 - 9), 0 - 9)
}
