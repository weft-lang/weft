-- test/bounds_elision_metrics.weft -- fact-driven vector bounds-check
-- elision: runtime soundness locks and static coverage tripwires.
--
-- bounds_probe_modes encodes the distribution of vector get/set check
-- modes across the optimised IR of a probe source: one byte per
-- check_mode value (bits: 1 = non-null proven, 2 = lower bound proven,
-- 4 = upper bound proven; a set bit means the runtime check is
-- ELIDED). Wrapper inlining means elided modes can be backed by the
-- wrapper's own inlined guards, so soundness is locked by the RUNTIME
-- tests below, and the static pins are coverage tripwires.

use "stdlib/vector.weft"
use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/unsafe.weft"

fn bounds_probe_ir(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn bounds_probe_mode_insts(insts: IrInstList, acc: i64) -> i64 {
  match insts {
    IrInstNil -> acc
    IrInstCons(inst, rest) -> {
      let next = match inst {
        IrVectorGetI64(dst, vec, index, fallback, check_mode) -> acc + (1 bshl (check_mode * 8))
        IrVectorSetI64(dst, vec, index, value, check_mode) -> acc + (1 bshl (check_mode * 8))
        _ -> acc
      }
      bounds_probe_mode_insts(rest, next)
    }
  }
}

fn bounds_probe_mode_blocks(blocks: IrBlockList, acc: i64) -> i64 {
  match blocks {
    IrBlockListNil -> acc
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> bounds_probe_mode_blocks(rest, bounds_probe_mode_insts(insts, acc))
      }
    }
  }
}

fn bounds_probe_mode_functions(functions: IrFunctionList, acc: i64) -> i64 {
  match functions {
    IrFunctionNil -> acc
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> bounds_probe_mode_functions(rest, bounds_probe_mode_blocks(blocks, acc))
      }
    }
  }
}

fn bounds_probe_modes(src: str) -> i64 {
  bounds_probe_mode_functions(pipeline_ir_functions(bounds_probe_ir(src)), 0)
}

fn bounds_shrink_subject(v: i64, i: i64) -> i64 {
  if i >= 0 {
    if i < vector_len(v) {
      vector_clear(v)
      vector_get<i64>(v, i, 0 - 7)
    } else { 0 - 1 }
  } else { 0 - 1 }
}

test "bounds_runtime_shrink_takes_fallback" {
  -- RUNTIME SOUNDNESS LOCK: vector_clear between the length guard and
  -- the get shrinks the vector to zero; the get must take its fallback
  -- rather than read the stale element through an elided check.
  let v = vector_new<i64>()
  vector_push<i64>(v, 10)
  vector_push<i64>(v, 20)
  vector_push<i64>(v, 30)
  Test.assert_eq(bounds_shrink_subject(v, 1), 0 - 7)
}

fn bounds_eager_and_subject(v: i64, j: i64, key: i64) -> i64 {
  if j >= 0 and vector_get<i64>(v, j, 0 - 7) > key { 1 } else { 0 }
}

test "bounds_runtime_eager_and_out_of_range" {
  -- RUNTIME SOUNDNESS LOCK: `and` is eager, so the get runs even for
  -- out-of-range indices and must resolve through its checks/fallback.
  let v = vector_new<i64>()
  vector_push<i64>(v, 100)
  Test.assert_eq(bounds_eager_and_subject(v, 0 - 1, 5), 0)
  Test.assert_eq(bounds_eager_and_subject(v, 0, 5), 1)
  Test.assert_eq(bounds_eager_and_subject(v, 3, 5), 0)
}

test "bounds_shrink_static_modes" {
  -- Coverage tripwire: the access after the shrink keeps only the
  -- elisions backed by the wrapper's inlined post-shrink guard
  -- (runtime lock above proves the fallback path).
  let src = "use \"stdlib/vector.weft\" fn f(v: i64, i: i64) -> i64 { if i >= 0 { if i < vector_len(v) { vector_clear(v) vector_get<i64>(v, i, 0) } else { 0 } } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 281474976776192)
}

test "bounds_eager_and_static_modes" {
  let src = "use \"stdlib/vector.weft\" fn f(v: i64, j: i64, key: i64) -> i64 { if j >= 0 and vector_get<i64>(v, j, 0) > key { 1 } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 281474976710657)
}

test "bounds_guarded_get_elides_both_checks" {
  -- Nonnegative guard plus length guard proves both bounds.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64, i: i64) -> i64 { if i >= 0 { if i < vector_len(v) { vector_get<i64>(v, i, 0) } else { 0 } } else { 0 } } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 562949953421312)
}

test "bounds_while_header_len_elides_both" {
  -- while i < vector_len(v): the header compare proves the upper bound
  -- and slot induction (i starts at 0, single guarded increment)
  -- proves the lower bound for the body get.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let mut i = 0 let mut s = 0 while i < vector_len(v) { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_modes(src), 562949953421312)
}

test "bounds_hoisted_len_elides_upper" {
  -- let len = vector_len(v) hoisted out of the loop: the value-def
  -- table's length origin still proves the upper bound cross-block.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let len = vector_len(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode4 = (acc bshr 32) band 255
  let mode6 = (acc bshr 48) band 255
  Test.assert_eq(if mode4 + mode6 >= 1 { 1 } else { 0 }, 1)
}

test "bounds_nonneg_guard_elides_lower_in_loop" {
  let src = "use \"stdlib/vector.weft\" fn f(v: i64, n: i64) -> i64 { let mut j = n let mut s = 0 let mut moving = 1 while moving == 1 { if j >= 0 { s = s + vector_get<i64>(v, j, 0) j = j - 1 } else { moving = 0 } } s } fn main() -> i64 { 0 }"
  let acc = bounds_probe_modes(src)
  let mode2 = (acc bshr 16) band 255
  let mode6 = (acc bshr 48) band 255
  Test.assert_eq(if mode2 + mode6 >= 1 { 1 } else { 0 }, 1)
}

fn bounds_probe_slot_verdicts(blocks: IrBlockList) -> i64 {
  let cfg = pipeline_ir_cfg_fact_bundle(blocks)
  let table = pipeline_ir_cfg_bundle_def_table(cfg)
  let seed = pipeline_ir_block_entry_facts_from_blocks_inner(blocks, blocks, cfg, pipeline_ir_block_entry_facts_empty())
  let propagated = pipeline_ir_block_entry_facts_propagate_fixpoint(blocks, cfg, seed, ir_block_list_len(blocks) + 1)
  let slots = nlist_new()
  pipeline_ir_collect_store_slots(blocks, slots)
  let n = nlist_len(slots)
  let mut passing = 0
  let mut i = 0
  while i < n {
    passing = passing + pipeline_ir_slot_nonneg_invariant(blocks, table, propagated, nlist_get(slots, i))
    i = i + 1
  }
  passing
}

fn bounds_probe_exact_fn_verdicts(src: str, want_slots: i64) -> i64 {
  let mut cur = pipeline_ir_functions(bounds_probe_ir(src))
  let mut result = 0 - 1
  let mut done = 0
  while done == 0 {
    match cur {
      IrFunctionNil -> { done = 1 }
      IrFunctionCons(f, rest) -> {
        match f {
          IrFunction(hash, params, blocks, src2) -> {
            let slots = nlist_new()
            pipeline_ir_collect_store_slots(blocks, slots)
            if nlist_len(slots) == want_slots and ir_block_list_len(blocks) > 3 {
              result = bounds_probe_slot_verdicts(blocks)
              done = 1
            } else {
              cur = rest
            }
          }
        }
      }
    }
  }
  result
}

test "bounds_unbounded_increment_rejected_by_induction" {
  -- SOUNDNESS TRIPWIRE for the slot induction rule: an increment with
  -- no strict upper bound on any load of the slot must NOT prove
  -- nonnegativity (the increment could wrap after 2^63 iterations).
  -- Exactly one slot passes: go, whose stores are all nonnegative
  -- constants (sound). The unbounded index i, the accumulator s, and
  -- the stride-2 counter w must all be rejected.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let mut i = 0 let mut s = 0 let mut w = 0 let mut go = 1 while go == 1 { s = s + vector_get<i64>(v, i, 0) w = w + 2 i = i + 1 if s > 100 { go = 0 } else { 0 } } s + w } fn main() -> i64 { 0 }"
  Test.assert_eq(bounds_probe_exact_fn_verdicts(src, 4), 1)
}

test "bounds_guarded_increment_accepted_by_induction" {
  -- The while-header strict bound makes the increment overflow-free,
  -- so the index slot passes the invariant.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let mut i = 0 let mut s = 0 while i < vector_len(v) { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  Test.assert_eq(if bounds_probe_exact_fn_verdicts(src, 2) >= 1 { 1 } else { 0 }, 1)
}
