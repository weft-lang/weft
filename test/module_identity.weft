test "package_export_fact_resolves_ordinary_public_declarations_by_package" {
  let tt = ttable_new()
  let root_manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"}},\"tools\":{\"fmt\":{\"module\":\"tools/fmt\",\"declaration\":\"main\"}}}}")
  pkg_identity_register_root(tt, root_manifest)
  let grammar_src = "SqlGrammar"
  let tool_src = "main"
  module_test_register_module_in_package(tt, grammar_src, "grammar/sql.weft", 0)
  module_test_register_module_in_package(tt, tool_src, "tools/fmt.weft", 0)
  let grammar_decl = module_test_register_decl(tt, grammar_src, module_decl_namespace_type(), 0, 10, module_visibility_public())
  let tool_decl = module_test_register_decl(tt, tool_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let grammar_export = pkg_manifest_find_export(root_manifest, pkg_export_kind_grammar(), __str_ptr("sql"), __str_len("sql"))
  let tool_export = pkg_manifest_find_export(root_manifest, pkg_export_kind_tool(), __str_ptr("fmt"), __str_len("fmt"))
