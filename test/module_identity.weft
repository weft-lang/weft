}

test "package_export_fact_resolves_ordinary_public_declarations_by_package" {
  let tt = ttable_new()
  let root_manifest = pkg_manifest_parse_str("{\"package\":\"app\",\"exports\":{\"grammars\":{\"sql\":{\"module\":\"grammar/sql\",\"declaration\":\"SqlGrammar\",\"execution\":\"validate_only\"}},\"tools\":{\"fmt\":{\"module\":\"tools/fmt\",\"declaration\":\"main\"}}}}")
  pkg_identity_register_root(tt, root_manifest)
  let grammar_src = "SqlGrammar"
  let tool_src = "main"
  module_test_register_module_in_package(tt, grammar_src, "grammar/sql.weft", 0)
  module_test_register_module_in_package(tt, tool_src, "tools/fmt.weft", 0)
  let grammar_decl = module_test_register_decl(tt, grammar_src, module_decl_namespace_type(), 0, 10, module_visibility_public())
  let tool_decl = module_test_register_decl(tt, tool_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let grammar_export = pkg_manifest_find_export(root_manifest, pkg_export_kind_grammar(), __str_ptr("sql"), __str_len("sql"))
  let tool_export = pkg_manifest_find_export(root_manifest, pkg_export_kind_tool(), __str_ptr("fmt"), __str_len("fmt"))
  Test.assert_eq(package_export_resolve_loaded(tt, 0, grammar_export), package_export_status_resolved())
  Test.assert_eq(package_export_resolve_loaded(tt, 0, tool_export), package_export_status_resolved())
  Test.assert_eq(pkg_export_resolved_declaration(grammar_export), grammar_decl)
  Test.assert_eq(pkg_export_resolved_declaration(tool_export), tool_decl)
}

test "package_export_fact_is_package_qualified_and_enforces_l7_visibility" {
  let tt = ttable_new()
  let root_manifest = pkg_manifest_parse_str("{\"package\":\"app\"}")
  pkg_identity_register_root(tt, root_manifest)
  let dep_manifest = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"stable\":{\"module\":\"facts/stable\",\"declaration\":\"query\"},\"unstable\":{\"module\":\"facts/unstable\",\"declaration\":\"query\"},\"wrong\":{\"module\":\"facts/wrong\",\"declaration\":\"Query\"},\"missing\":{\"module\":\"facts/stable\",\"declaration\":\"absent\"}}}}")
  let dep_id = pkg_identity_intern_under_owner(tt, __str_ptr("sdk"), __str_len("sdk"), __str_ptr("deps/sdk"), __str_len("deps/sdk"), dep_manifest, 0)
  let stable_src = "query"
  let unstable_src = "query"
  let wrong_src = "Query"
  module_test_register_module_in_package(tt, stable_src, "facts/stable.weft", dep_id)
  module_test_register_module_in_package(tt, unstable_src, "facts/unstable.weft", dep_id)
  module_test_register_module_in_package(tt, wrong_src, "facts/wrong.weft", dep_id)
  module_test_register_decl(tt, stable_src, module_decl_namespace_value(), 0, 5, module_visibility_public())
  module_test_register_decl(tt, unstable_src, module_decl_namespace_value(), 0, 5, module_visibility_package())
  module_test_register_decl(tt, wrong_src, module_decl_namespace_type(), 0, 5, module_visibility_public())
  let stable = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("stable"), __str_len("stable"))
  let unstable = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("unstable"), __str_len("unstable"))
  let wrong = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("wrong"), __str_len("wrong"))
  let missing = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("missing"), __str_len("missing"))
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, stable), package_export_status_resolved())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, unstable), package_export_status_not_public())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, wrong), package_export_status_wrong_kind())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, missing), package_export_status_missing_declaration())
}

test "resolved_type_lookup_follows_selected_alias_identity" {
  let tt = ttable_new()
  let root_src = "Renamed"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_type(), 0, 3, module_visibility_package())
  ttable_add(tt, __str_ptr(dep_src), 0, 3, 0, 0, 0, 0)
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("Box", "Renamed"))
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private())
  module_scope_build_all(tt)
  let ty = typecheck_resolve_type(tt, __str_ptr(root_src), 0, 7)
  Test.assert_eq(ty_tag(ty), 9)
  Test.assert_eq(ty_f1(ty), type_name_hash(__str_ptr(dep_src), 0, 3))
}

