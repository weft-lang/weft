test "module_scope_audit_reports_structured_collision_once" {
  let tt = ttable_new()
  let root_src = "same same"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  module_test_register_decl(tt, root_src, module_decl_namespace_value(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, root_src, module_decl_namespace_type(), 5, 4, module_visibility_private())
  let captured = alloc_words(1)
  mem_store64(captured, 0)
  let errors = handle module_diagnose_scope_issues(tt) {
    Diagnose.report(diagnostic) -> {
      let primary_ok = match diagnostic_primary(diagnostic) {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> if source == __str_ptr(root_src) and start == 5 and end == 9 { 1 } else { 0 }
        _ -> 0
      }
      let code_text = diagnostic_code_text(diagnostic_code(diagnostic))
      let code_ok = src_eq(__str_ptr(code_text), 0, __str_len(code_text), "E4003")
      let class_name = diagnostic_class_name(diagnostic_class(diagnostic))
      let class_ok = src_eq(__str_ptr(class_name), 0, __str_len(class_name), "module")
      let message = diagnostic_message(diagnostic)
      let message_ok = src_eq(__str_ptr(message), 0, __str_len(message), "module item 'same' is ambiguous in this scope")
      mem_store64(captured, primary_ok + code_ok + class_ok + message_ok + diagnostic_related_count(diagnostic_related(diagnostic)) + diagnostic_field_count(diagnostic_fields(diagnostic)))
      resume(0)
    }
    Diagnose.error(message, span) -> resume(0 - 100)
    Diagnose.warn(message, span) -> resume(0 - 100)
    Diagnose.note(message, span) -> resume(0 - 100)
  }
  Test.assert_eq(errors, 1)
  Test.assert_eq(mem_load64(captured), 8)
  let repeated = handle module_diagnose_scope_issues(tt) {
    Diagnose.report(diagnostic) -> resume(0 - 100)
    Diagnose.error(message, span) -> resume(0 - 100)
    Diagnose.warn(message, span) -> resume(0 - 100)
    Diagnose.note(message, span) -> resume(0 - 100)
  }
  Test.assert_eq(repeated, 0)
}

