test "stable_module_resolution_queries_cover_every_result_shape" {
  let tt = ttable_new()
  let root_src = "same root"
  let dep_src = "public hidden"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, root_src, module_decl_namespace_value(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, root_src, module_decl_namespace_type(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_package())
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 7, 6, module_visibility_private())
  module_test_register_import(tt, root_src, dep, nlist_new(), "dep", module_visibility_private())

  let invisible_selection = nlist_new()
  nlist_add(invisible_selection, module_test_scope_selection("hidden", "private_item"))
  module_test_register_import(tt, root_src, dep, invisible_selection, "", module_visibility_private())

  let widened_selection = nlist_new()
  nlist_add(widened_selection, module_test_scope_selection("public", "widened"))
  module_test_register_import(tt, root_src, dep, widened_selection, "", module_visibility_public())
  module_scope_build_all(tt)

  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3) {
    ResolvedModuleName(id) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("same"), 0, 4) {
    AmbiguousModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("missing"), 0, 7) {
    MissingModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("private_item"), 0, 12) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("widened"), 0, 7) {
    WidenedReexportName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3, __str_ptr("public"), 0, 6) {
    ResolvedDeclarationName(id) -> {
      Test.assert_eq(module_decl_id_namespace(id), module_decl_namespace_value())
      Test.assert_eq(module_decl_id_name_len(id), 6)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3, __str_ptr("hidden"), 0, 6) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "l7_public_facade_crosses_package_boundary_while_compiler_internals_do_not" {
  let tt = ttable_new()
  let external_src = "stable unstable private"
  let stable_src = "Diagnostic"
  let unstable_src = "IrModule"
  let internal_src = "ResidencyState"
  module_test_register_module_in_package(tt, external_src, "app/main.weft", 2)
  let stable = module_test_register_module_in_package(tt, stable_src, "compiler/facts.weft", 1)
  let unstable = module_test_register_module_in_package(tt, unstable_src, "compiler/ir.weft", 1)
  let internal = module_test_register_module_in_package(tt, internal_src, "compiler/residency.weft", 1)

  module_test_register_decl(tt, stable_src, module_decl_namespace_type(), 0, 10, module_visibility_public())
  module_test_register_decl(tt, unstable_src, module_decl_namespace_type(), 0, 8, module_visibility_package())
  module_test_register_decl(tt, internal_src, module_decl_namespace_type(), 0, 14, module_visibility_private())
  module_test_register_import(tt, external_src, stable, nlist_new(), "stable", module_visibility_private())
  module_test_register_import(tt, external_src, unstable, nlist_new(), "unstable", module_visibility_private())
  module_test_register_import(tt, external_src, internal, nlist_new(), "private", module_visibility_private())
  module_scope_build_all(tt)

  match module_resolve_qualified_name(tt, __str_ptr(external_src), __str_ptr("stable"), 0, 6, __str_ptr("Diagnostic"), 0, 10) {
    ResolvedDeclarationName(id) -> {
      Test.assert_eq(module_decl_id_namespace(id), module_decl_namespace_type())
      Test.assert_eq(module_decl_id_name_len(id), 10)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(external_src), __str_ptr("unstable"), 0, 8, __str_ptr("IrModule"), 0, 8) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(external_src), __str_ptr("private"), 0, 7, __str_ptr("ResidencyState"), 0, 14) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

