use runtime/alloc.{*}
use "runtime/memory.weft"
use "compiler/codegen.weft"
use "compiler/grammar.weft"
use "compiler/module.weft"
use "compiler/typeck.weft"
use "compiler/diagnose.weft"

fn module_test_parse_quiet(source: str, tt: i64) -> i64 {
  let grammar = weft_grammar()
  handle grammar.parse(__str_ptr(source), __str_len(source), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn module_test_parse_diagnostics(source: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let count = alloc_words(1)
  mem_store64(count, 0)
  handle grammar.parse(__str_ptr(source), __str_len(source), tt) {
    Diagnose.error(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
  }
  mem_load64(count)
}

fn module_test_decl(tt: i64, src: str, namespace: i64, name: str) -> i64 {
  module_decl_fact_find(tt, __str_ptr(src), namespace, __str_ptr(name), 0, __str_len(name))
}

fn module_test_selection_name_eq(selection: i64, expected: str) -> i64 {
  if node_f2(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f1(selection), 0, __str_ptr(expected), 0, node_f2(selection)) }
}

fn module_test_selection_alias_eq(selection: i64, expected: str) -> i64 {
  if node_f4(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f3(selection), 0, __str_ptr(expected), 0, node_f4(selection)) }
}

fn module_test_register_module(tt: i64, src: str, path: str) -> i64 {
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  module_fact_find_source(tt, __str_ptr(src))
}

fn module_test_register_decl(tt: i64, src: str, namespace: i64, name_start: i64, name_len: i64, visibility: i64) -> i64 {
  module_decl_fact_register(tt, __str_ptr(src), 0, namespace, name_start, name_len, visibility)
}

fn module_test_scope_selection(name: str, alias: str) -> i64 {
  node_new(0, __str_ptr(name), __str_len(name), __str_ptr(alias), __str_len(alias))
}

fn module_test_scope_wildcard() -> i64 { node_new(0, 0, 0 - 1, 0, 0) }

fn module_test_register_import(tt: i64, importer_src: str, target: i64, selections: i64, alias: str, visibility: i64, legacy: i64) -> i64 {
  module_import_fact_register(tt, __str_ptr(importer_src), target, selections, __str_ptr(alias), __str_len(alias), visibility, legacy)
}

test "module_keywords_lex_as_reserved_surface" {
  let src = "pub package as"
  let toks = lex(__str_ptr(src), __str_len(src))
  Test.assert_eq(tok_tag(toks, 0), 3)
  Test.assert_eq(tok_v1(toks, 0), 34)
  Test.assert_eq(tok_tag(toks, 1), 3)
  Test.assert_eq(tok_v1(toks, 1), 36)
  Test.assert_eq(tok_tag(toks, 2), 3)
  Test.assert_eq(tok_v1(toks, 2), 35)
}

test "module_registry_records_named_logical_identity_without_extension" {
  let src = "fn main() -> i64 { 0 }"
  let path = "test/nested/example.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  let entry = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(module_fact_module_count(tt), 1)
  Test.assert_eq(module_fact_entry_anonymous(entry), 0)
  Test.assert_eq(module_fact_entry_path_len(entry), __str_len("test/nested/example"))
  Test.assert_eq(module_fact_path_eq(entry, __str_ptr(path), __str_len(path), 0), 1)
  match module_id_from_entry(entry) {
    NamedModuleId(path_ptr, path_len, package_id) -> {
      Test.assert_eq(path_len, __str_len("test/nested/example"))
      Test.assert_eq(package_id, 0)
    }
    AnonymousModuleId(ordinal) -> Test.assert_eq(0, 1)
  }
}

test "module_registry_upgrades_anonymous_root_in_place" {
  let src = "fn main() -> i64 { 0 }"
  let path = "test/upgraded.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(src), __str_len(src), 0, 0)
  let anonymous = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(module_fact_entry_anonymous(anonymous), 1)
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  let named = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(named, anonymous)
  Test.assert_eq(module_fact_module_count(tt), 1)
  Test.assert_eq(module_fact_entry_anonymous(named), 0)
  Test.assert_eq(module_fact_path_eq(named, __str_ptr(path), __str_len(path), 0), 1)
}

test "declaration_facts_pin_visibility_and_owner_identity" {
  let src = "pub fn exposed() -> i64 { 1 } pub(package) type Box { value: i64 } effect Signal { fn ping() -> i64 } trait Measure { fn size(self) -> i64 } impl Box { pub(package) fn value(self) -> i64 { self.value } fn hidden(self) -> i64 { 0 } }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let exposed = module_test_decl(tt, src, module_decl_namespace_value(), "exposed")
  let box = module_test_decl(tt, src, module_decl_namespace_type(), "Box")
  let signal = module_test_decl(tt, src, module_decl_namespace_effect(), "Signal")
  let ping = module_test_decl(tt, src, module_decl_namespace_effect_operation(), "ping")
  let measure = module_test_decl(tt, src, module_decl_namespace_trait(), "Measure")
  let size = module_test_decl(tt, src, module_decl_namespace_trait_method(), "size")
  let value = module_test_decl(tt, src, module_decl_namespace_inherent_method(), "value")
  let hidden = module_test_decl(tt, src, module_decl_namespace_inherent_method(), "hidden")
  Test.assert_eq(module_fact_decl_count(tt), 8)
  Test.assert_eq(module_decl_fact_visibility_code(exposed), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(box), module_visibility_package())
  Test.assert_eq(module_decl_fact_visibility_code(signal), module_visibility_private())
  Test.assert_eq(module_decl_fact_visibility_code(measure), module_visibility_private())
  Test.assert_eq(module_decl_fact_visibility_code(value), module_visibility_package())
  Test.assert_eq(module_decl_fact_visibility_code(hidden), module_visibility_private())
  Test.assert_eq(if module_decl_fact_owner(ping) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_decl_fact_owner(size) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(module_decl_fact_owner(value), box)
  Test.assert_eq(module_decl_fact_owner(hidden), box)
}

test "variant constructors inherit type visibility and owner identity" {
  let src = "pub type PublicChoice { Pick(i64), Empty } type PrivateChoice { Hide(str) }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let public_choice = module_test_decl(tt, src, module_decl_namespace_type(), "PublicChoice")
  let private_choice = module_test_decl(tt, src, module_decl_namespace_type(), "PrivateChoice")
  let pick = module_decl_fact_find_member(tt, public_choice, module_decl_namespace_constructor(), __str_ptr("Pick"), 0, 4)
  let empty = module_decl_fact_find_member(tt, public_choice, module_decl_namespace_constructor(), __str_ptr("Empty"), 0, 5)
  let hide = module_decl_fact_find_member(tt, private_choice, module_decl_namespace_constructor(), __str_ptr("Hide"), 0, 4)
  Test.assert_eq(module_decl_fact_owner(pick), public_choice)
  Test.assert_eq(module_decl_fact_owner(empty), public_choice)
  Test.assert_eq(module_decl_fact_owner(hide), private_choice)
  Test.assert_eq(module_decl_fact_visibility_code(pick), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(empty), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(hide), module_visibility_private())
}

test "same-spelled constructors retain distinct parent identities" {
  let src = "pub type LeftChoice { Same(i64) } pub type RightChoice { Same(str) }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let left = module_test_decl(tt, src, module_decl_namespace_type(), "LeftChoice")
  let right = module_test_decl(tt, src, module_decl_namespace_type(), "RightChoice")
  let left_same = module_decl_fact_find_member(tt, left, module_decl_namespace_constructor(), __str_ptr("Same"), 0, 4)
  let right_same = module_decl_fact_find_member(tt, right, module_decl_namespace_constructor(), __str_ptr("Same"), 0, 4)
  Test.assert_eq(if left_same != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if right_same != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if left_same != right_same { 1 } else { 0 }, 1)
  Test.assert_eq(module_decl_fact_owner(left_same), left)
  Test.assert_eq(module_decl_fact_owner(right_same), right)
}

test "trait_implementation_is_evidence_not_a_second_declaration" {
  let src = "trait Measure { fn size(self) -> i64 } type Box { value: i64 } impl Measure for Box { fn size(self) -> i64 { self.value } }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  Test.assert_eq(module_fact_decl_count(tt), 3)
  Test.assert_eq(if module_test_decl(tt, src, module_decl_namespace_trait_method(), "size") != 0 { 1 } else { 0 }, 1)
}

test "path_import_records_selection_alias_and_wildcard" {
  let src = "use stdlib/option.{ Option as MaybeOption, * } fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  let selected = module_import_fact_selection_at(import, 0)
  let wildcard = module_import_fact_selection_at(import, 1)
  Test.assert_eq(module_import_fact_is_legacy(import), 0)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_private())
  Test.assert_eq(module_import_fact_selection_count(import), 2)
  Test.assert_eq(module_test_selection_name_eq(selected, "Option"), 1)
  Test.assert_eq(module_test_selection_alias_eq(selected, "MaybeOption"), 1)
  Test.assert_eq(node_f2(wildcard), 0 - 1)
  Test.assert_eq(module_fact_path_eq(mem_load64_at(import + 8, 0), __str_ptr("stdlib/option.weft"), __str_len("stdlib/option.weft"), 0), 1)
}

test "module_alias_and_reexport_visibility_are_preserved" {
  let src = "pub(package) use stdlib/option as opt fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  Test.assert_eq(module_import_fact_alias_eq(import, "opt"), 1)
  Test.assert_eq(module_import_fact_selection_count(import), 0)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_package())
}

test "public_reexport_visibility_is_preserved" {
  let src = "pub use stdlib/option.{ Option } fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_public())
  Test.assert_eq(module_import_fact_selection_count(import), 1)
}

test "quoted_import_is_explicitly_marked_as_legacy_wildcard" {
  let src = "use \"stdlib/option.weft\" fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  Test.assert_eq(module_import_fact_is_legacy(import), 1)
  Test.assert_eq(module_import_fact_selection_count(import), 1)
  Test.assert_eq(node_f2(module_import_fact_selection_at(import, 0)), 0 - 1)
}

test "module_visibility_rejects_impl_block_and_test_modifiers" {
  let impl_src = "type Box { value: i64 } pub impl Box { fn value(self) -> i64 { self.value } }"
  let test_src = "pub test \"bad\" { 0 }"
  Test.assert_eq(module_test_parse_diagnostics(impl_src), 1)
  Test.assert_eq(module_test_parse_diagnostics(test_src), 1)
}

test "module_members_inherit_trait_and_effect_visibility" {
  let trait_src = "trait Measure { pub fn size(self) -> i64 }"
  let effect_src = "effect Signal { pub fn ping() -> i64 }"
  Test.assert_eq(module_test_parse_diagnostics(trait_src), 1)
  Test.assert_eq(module_test_parse_diagnostics(effect_src), 1)
}

test "module_path_rejects_absolute_and_empty_segments" {
  Test.assert_eq(if module_test_parse_diagnostics("use /absolute fn main() -> i64 { 0 }") > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_test_parse_diagnostics("use stdlib//option fn main() -> i64 { 0 }") > 0 { 1 } else { 0 }, 1)
}

test "module_paths_accept_keyword_spelled_segments" {
  let source = "use compiler/module.{*}"
  let toks = lex(__str_ptr(source), __str_len(source))
  let surface = handle parse_use_surface(toks, __str_ptr(source), 1) {
    Diagnose.error(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
    Diagnose.warn(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
    Diagnose.note(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
  }
  Test.assert_eq(node_f2(surface), __str_len("compiler/module.weft"))
  Test.assert_eq(src_eq_at(node_f1(surface), 0, __str_ptr("compiler/module.weft"), 0, node_f2(surface)), 1)
  Test.assert_eq(node_f3(node_f4(surface)), 0)
  Test.assert_eq(node_f2(nlist_get(node_f1(node_f4(surface)), 0)), 0 - 1)
}

test "module_scope_local_declaration_resolves_by_identity" {
  let tt = ttable_new()
  let src = "local"
  module_test_register_module(tt, src, "pkg/local.weft")
  let decl = module_test_register_decl(tt, src, module_decl_namespace_value(), 0, 5, module_visibility_private())
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(src), __str_ptr("local"), 0, 5)
  Test.assert_eq(module_scope_entry_target(binding), decl)
  Test.assert_eq(module_scope_entry_import(binding), 0)
}

test "module_scope_selected_alias_preserves_target_declaration" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "item"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 4, module_visibility_package())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("item", "renamed"))
  let import = module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("renamed"), 0, 7)
  Test.assert_eq(module_scope_entry_target(binding), decl)
  Test.assert_eq(module_scope_entry_import(binding), import)
}

test "module_scope_qualified_effect_resolves_by_declaration_identity" {
  let tt = ttable_new()
  let root_src = "bank"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/effects.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_effect(), 0, 3, module_visibility_public())
  module_test_register_import(tt, root_src, dep, nlist_new(), "effects", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let resolved = module_scope_lookup_qualified_declaration(tt, __str_ptr(root_src), __str_ptr("effects"), 0, 7, module_decl_namespace_effect(), __str_ptr(dep_src), 0, 3)
  Test.assert_eq(resolved, decl)
}

test "typeck_records_qualified_effect_declaration_on_field" {
  let tt = ttable_new()
  let root_src = "effects Box"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/effects.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_effect(), 0, 3, module_visibility_public())
  module_test_register_import(tt, root_src, dep, nlist_new(), "effects", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let field = node_new(13, node_new(2, 0, 7, 0, 0), 8, 3, 0)
  Test.assert_eq(typeck_resolve_effect_ref(field, tenv_new(), __str_ptr(root_src), tt), decl)
  Test.assert_eq(effect_ref_decl_fact(field), decl)
}

test "qualified effect type expr retains declaration and arguments" {
  let tt = ttable_new()
  let src = "Box"
  module_test_register_module(tt, src, "pkg/effects.weft")
  let decl = module_test_register_decl(tt, src, module_decl_namespace_effect(), 0, 3, module_visibility_public())
  let args = nlist_new()
  nlist_add(args, ty_i64())
  nlist_add(args, ty_slice(ty_str()))
  let exact = type_expr_from_node(ty_qualified_effect_app(decl, args))
  let node = type_expr_to_node(exact)
  Test.assert_eq(type_expr_tag_or(exact, 0 - 1), 25)
  Test.assert_eq(type_expr_child_count_or(exact, 0 - 1), 2)
  Test.assert_eq(ty_tag(node), 25)
  Test.assert_eq(ty_f1(node), decl)
  Test.assert_eq(nlist_len(effect_atom_args(node)), 2)
  Test.assert_eq(ty_f1(nlist_get(effect_atom_args(node), 0)), PRIM_I64())
  Test.assert_eq(ty_slice_mutable(nlist_get(effect_atom_args(node), 1)), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(exact), 0)
}

test "module_scope_alias_resolves_module_identity" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "dep"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_import(tt, root_src, dep, nlist_new(), "other", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("other"), 0, 5)
  Test.assert_eq(module_scope_entry_kind(binding), module_scope_kind_module())
  Test.assert_eq(module_scope_entry_target(binding), dep)
}

test "module_scope_explicit_wildcard_imports_only_visible_exports" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "public private"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_package())
  module_test_register_decl(tt, dep_src, module_decl_namespace_type(), 7, 7, module_visibility_private())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_wildcard())
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  Test.assert_eq(if module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("public"), 0, 6) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("private"), 0, 7), 0)
}

test "wildcard import preserves same-spelled type and constructor namespaces" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  let box_type = module_decl_fact_register(tt, __str_ptr(dep_src), 0, module_decl_namespace_type(), 0, 3, module_visibility_package())
  let box_ctor = module_decl_fact_register(tt, __str_ptr(dep_src), box_type, module_decl_namespace_constructor(), 0, 3, module_visibility_package())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_wildcard())
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  Test.assert_eq(module_scope_lookup_declaration(tt, __str_ptr(root_src), module_decl_namespace_type(), __str_ptr("Box"), 0, 3), box_type)
  Test.assert_eq(module_scope_lookup_declaration(tt, __str_ptr(root_src), module_decl_namespace_constructor(), __str_ptr("Box"), 0, 3), box_ctor)
  Test.assert_eq(module_scope_lookup_declaration(tt, __str_ptr(root_src), module_decl_namespace_value(), __str_ptr("Box"), 0, 3), 0)
}

test "module_scope_legacy_wildcard_keeps_private_compatibility" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "hidden"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_private())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_wildcard())
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 1)
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("hidden"), 0, 6)
  Test.assert_eq(module_scope_entry_target(binding), decl)
}

test "module_scope_selected_private_name_records_invisible_issue" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "hidden"
  let root = module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_private())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("hidden", ""))
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let issue = module_scope_find_issue(tt, root, __str_ptr("hidden"), 6, module_scope_status_invisible())
  Test.assert_eq(if issue != 0 { 1 } else { 0 }, 1)
}

test "module_scope_reexport_cannot_widen_package_declaration" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "shared"
  let root = module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_package())
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("shared", ""))
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_public(), 0)
  module_scope_build_all(tt)
  let issue = module_scope_find_issue(tt, root, __str_ptr("shared"), 6, module_scope_status_widened_reexport())
  Test.assert_eq(if issue != 0 { 1 } else { 0 }, 1)
}

test "module_scope_same_identity_diamond_deduplicates" {
  let tt = ttable_new()
  let root_src = "root"
  let dep_src = "shared"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_public())
  let first = nlist_new()
  nlist_add(first, module_test_scope_selection("shared", ""))
  let second = nlist_new()
  nlist_add(second, module_test_scope_selection("shared", ""))
  module_test_register_import(tt, root_src, dep, first, "", module_visibility_private(), 0)
  module_test_register_import(tt, root_src, dep, second, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("shared"), 0, 6)
  Test.assert_eq(module_scope_entry_target(binding), decl)
  Test.assert_eq(module_scope_entry_status(binding), module_scope_status_resolved())
}

test "module_scope_distinct_declarations_with_same_spelling_collide" {
  let tt = ttable_new()
  let root_src = "same"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  module_test_register_decl(tt, root_src, module_decl_namespace_value(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, root_src, module_decl_namespace_type(), 0, 4, module_visibility_private())
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("same"), 0, 4)
  Test.assert_eq(module_scope_entry_status(binding), module_scope_status_ambiguous())
  Test.assert_eq(if module_scope_entry_conflict(binding) != 0 { 1 } else { 0 }, 1)
}

test "module_scope_reexport_chain_preserves_origin_identity" {
  let tt = ttable_new()
  let root_src = "root"
  let facade_src = "facade"
  let dep_src = "exported"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let facade = module_test_register_module(tt, facade_src, "pkg/facade.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 8, module_visibility_public())
  let facade_selection = nlist_new()
  nlist_add(facade_selection, module_test_scope_selection("exported", ""))
  module_test_register_import(tt, facade_src, dep, facade_selection, "", module_visibility_public(), 0)
  let root_selection = nlist_new()
  nlist_add(root_selection, module_test_scope_selection("exported", "renamed"))
  module_test_register_import(tt, root_src, facade, root_selection, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("renamed"), 0, 7)
  Test.assert_eq(module_scope_entry_target(binding), decl)
}

test "stable_module_resolution_queries_cover_every_result_shape" {
  let tt = ttable_new()
  let root_src = "same root"
  let dep_src = "public hidden"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, root_src, module_decl_namespace_value(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, root_src, module_decl_namespace_type(), 0, 4, module_visibility_private())
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 6, module_visibility_package())
  module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 7, 6, module_visibility_private())
  module_test_register_import(tt, root_src, dep, nlist_new(), "dep", module_visibility_private(), 0)

  let invisible_selection = nlist_new()
  nlist_add(invisible_selection, module_test_scope_selection("hidden", "private_item"))
  module_test_register_import(tt, root_src, dep, invisible_selection, "", module_visibility_private(), 0)

  let widened_selection = nlist_new()
  nlist_add(widened_selection, module_test_scope_selection("public", "widened"))
  module_test_register_import(tt, root_src, dep, widened_selection, "", module_visibility_public(), 0)
  module_scope_build_all(tt)

  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3) {
    ResolvedModuleName(id) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("same"), 0, 4) {
    AmbiguousModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("missing"), 0, 7) {
    MissingModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("private_item"), 0, 12) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_name(tt, __str_ptr(root_src), __str_ptr("widened"), 0, 7) {
    WidenedReexportName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3, __str_ptr("public"), 0, 6) {
    ResolvedDeclarationName(id) -> {
      Test.assert_eq(module_decl_id_namespace(id), module_decl_namespace_value())
      Test.assert_eq(module_decl_id_name_len(id), 6)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match module_resolve_qualified_name(tt, __str_ptr(root_src), __str_ptr("dep"), 0, 3, __str_ptr("hidden"), 0, 6) {
    InvisibleModuleName -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "resolved_type_lookup_follows_selected_alias_identity" {
  let tt = ttable_new()
  let root_src = "Renamed"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_type(), 0, 3, module_visibility_package())
  ttable_add(tt, __str_ptr(dep_src), 0, 3, 0, 0, 0, 0)
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("Box", "Renamed"))
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private(), 0)
  module_scope_build_all(tt)
  let ty = typecheck_resolve_type(tt, __str_ptr(root_src), 0, 7)
  Test.assert_eq(ty_tag(ty), 9)
  Test.assert_eq(ty_f1(ty), type_name_hash(__str_ptr(dep_src), 0, 3))
}

test "resolved_type_lookup_does_not_flatten_plain_module_import" {
