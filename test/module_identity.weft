test "module_surface_matrix_records_every_canonical_import_form" {
  let src = "use stdlib/option use stdlib/result as result_types use stdlib/list.{ List, Cons as Prepend } use stdlib/maybe.{ * } pub use stdlib/fail.{ Fail } pub(package) use compiler/ir as unstable_ir fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  Test.assert_eq(module_test_import_count_for_source(tt, src), 6)

  let plain = module_test_import_for_source_at(tt, src, 0)
  let aliased = module_test_import_for_source_at(tt, src, 1)
  let selected = module_test_import_for_source_at(tt, src, 2)
  let wildcard = module_test_import_for_source_at(tt, src, 3)
  let public_reexport = module_test_import_for_source_at(tt, src, 4)
  let package_reexport = module_test_import_for_source_at(tt, src, 5)

  Test.assert_eq(module_import_fact_selection_count(plain), 0)
  Test.assert_eq(module_import_fact_alias_eq(aliased, "result_types"), 1)
  Test.assert_eq(module_import_fact_selection_count(selected), 2)
  Test.assert_eq(module_test_selection_name_eq(module_import_fact_selection_at(selected, 0), "List"), 1)
  Test.assert_eq(module_test_selection_alias_eq(module_import_fact_selection_at(selected, 1), "Prepend"), 1)
  Test.assert_eq(node_f2(module_import_fact_selection_at(wildcard, 0)), 0 - 1)
  Test.assert_eq(module_import_fact_visibility_code(public_reexport), module_visibility_public())
  Test.assert_eq(module_import_fact_visibility_code(package_reexport), module_visibility_package())
  Test.assert_eq(module_import_fact_alias_eq(package_reexport, "unstable_ir"), 1)
}

test "prelude_facade_has_exact_non_recursive_surface" {
  let tt = ttable_new()
  module_test_load_file_quiet(tt, "stdlib/prelude.weft")
  let prelude = module_fact_find_path(tt, __str_ptr("stdlib/prelude.weft"), __str_len("stdlib/prelude.weft"), 0)
  module_scope_build_all(tt)
  let prelude_src = module_fact_entry_source(prelude)
  let scopes = module_fact_scopes(tt)
  let mut exports = 0
  let mut facade_edges = 0
  for i in 0..nlist_len(scopes) {
    let entry = nlist_get(scopes, i)
    if module_scope_entry_module(entry) == prelude and module_scope_entry_kind(entry) != module_scope_kind_issue() and module_scope_entry_visibility(entry) == module_visibility_public() {
      exports = exports + 1
    } else { 0 }
  }
  for i in 0..module_fact_import_count(tt) {
    if module_import_fact_importer(module_fact_import_at(tt, i)) == prelude { facade_edges = facade_edges + 1 } else { 0 }
  }
  Test.assert_eq(facade_edges, 7)
  Test.assert_eq(exports, 14)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_type(), __str_ptr("Option"), 0, 6) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_constructor(), __str_ptr("Some"), 0, 4) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_effect(), __str_ptr("Fail"), 0, 4) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_type(), __str_ptr("Iterator"), 0, 8) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_trait(), __str_ptr("IntoIterator"), 0, 12) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_trait(), __str_ptr("Display"), 0, 7) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_value(), __str_ptr("option_some"), 0, 11), 0)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_trait(), __str_ptr("Default"), 0, 7), 0)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_effect(), __str_ptr("IO"), 0, 2), 0)
}

test "anonymous_root_gets_one_idempotent_weak_prelude_edge" {
  let src = "fn main() -> i64 { 0 }"
  let tt = ttable_new()
  let fns = module_test_parse_quiet(src, tt)
  module_test_bind_prelude_quiet(fns, __str_ptr(src), tt)
  let imports_after_first = module_fact_import_count(tt)
  module_test_bind_prelude_quiet(fns, __str_ptr(src), tt)
  let root = module_fact_find_source(tt, __str_ptr(src))
  let prelude = module_fact_find_path(tt, __str_ptr("stdlib/prelude.weft"), __str_len("stdlib/prelude.weft"), 0)
  let mut weak_edges = 0
  for i in 0..module_fact_import_count(tt) {
    let entry = module_fact_import_at(tt, i)
    if module_import_fact_importer(entry) == root and module_import_fact_target(entry) == prelude and module_import_fact_is_weak(entry) == 1 {
      weak_edges = weak_edges + 1
    } else { 0 }
  }
  Test.assert_eq(module_fact_import_count(tt), imports_after_first)
  Test.assert_eq(weak_edges, 1)
}

test "implicit prelude materialises callable implementation bodies" {
  let src = "fn main() -> i64 { Some(7).unwrap_or(0) }"
