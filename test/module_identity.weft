}

test "module_graph_direct_cycle_is_one_logical_identity" {
  let tt = ttable_new()
  let src = "root"
  let root = module_test_register_module(tt, src, "pkg/root.weft")
  let edge = module_test_register_import(tt, src, root, nlist_new(), "root", module_visibility_private())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_is_present(cycle), 1)
  Test.assert_eq(module_import_cycle_count(cycle), 1)
  Test.assert_eq(module_import_cycle_module_at(cycle, 0), root)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 0), edge)
}

test "module_graph_indirect_cycle_rotates_to_least_logical_identity" {
  let tt = ttable_new()
  let z_src = "z"
  let m_src = "m"
  let a_src = "a"
  let z = module_test_register_module(tt, z_src, "pkg/z.weft")
  let m = module_test_register_module(tt, m_src, "pkg/m.weft")
  let a = module_test_register_module(tt, a_src, "pkg/a.weft")
  let z_to_m = module_test_register_import(tt, z_src, m, nlist_new(), "m", module_visibility_private())
  let m_to_a = module_test_register_import(tt, m_src, a, nlist_new(), "a", module_visibility_private())
  let a_to_z = module_test_register_import(tt, a_src, z, nlist_new(), "z", module_visibility_private())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_count(cycle), 3)
  Test.assert_eq(module_import_cycle_module_at(cycle, 0), a)
  Test.assert_eq(module_import_cycle_module_at(cycle, 1), z)
  Test.assert_eq(module_import_cycle_module_at(cycle, 2), m)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 0), a_to_z)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 1), z_to_m)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 2), m_to_a)
}

test "module_cycle_diagnostic_preserves_code_provenance_and_facts" {
  let tt = ttable_new()
  let a_src = "use b"
  let b_src = "use a"
  let a = module_test_register_module(tt, a_src, "pkg/a.weft")
  let b = module_test_register_module(tt, b_src, "pkg/b.weft")
  module_import_fact_register_at(tt, __str_ptr(a_src), b, nlist_new(), 0, 0, module_visibility_private(), 0, 1)
  module_import_fact_register_at(tt, __str_ptr(b_src), a, nlist_new(), 0, 0, module_visibility_private(), 0, 2)
  let observed = handle parse_diagnose_module_cycle(tt, __str_ptr(a_src)) {
    Diagnose.report(diagnostic) -> {
      let primary = diagnostic_primary(diagnostic)
      let primary_ok = match primary {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> if source == __str_ptr(b_src) and start == 2 and end == 5 { 1 } else { 0 }
        _ -> 0
      }
      let class_ok = if src_eq(__str_ptr(diagnostic_class_name(diagnostic_class(diagnostic))), 0, __str_len(diagnostic_class_name(diagnostic_class(diagnostic))), "module") == 1 { 1 } else { 0 }
      let code_ok = if src_eq(__str_ptr(diagnostic_code_text(diagnostic_code(diagnostic))), 0, __str_len(diagnostic_code_text(diagnostic_code(diagnostic))), "E4001") == 1 { 1 } else { 0 }
      resume(primary_ok + class_ok + code_ok + diagnostic_related_count(diagnostic_related(diagnostic)) + diagnostic_field_count(diagnostic_fields(diagnostic)))
    }
    Diagnose.error(message, span) -> resume(0 - 100)
    Diagnose.warn(message, span) -> resume(0 - 100)
    Diagnose.note(message, span) -> resume(0 - 100)
  }
  Test.assert_eq(observed, 6)
}

