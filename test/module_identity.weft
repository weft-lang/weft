test "module_graph_diamond_is_acyclic" {
  let tt = ttable_new()
  let root_src = "root"
  let left_src = "left"
  let right_src = "right"
  let leaf_src = "leaf"
  let root = module_test_register_module(tt, root_src, "pkg/root.weft")
  let left = module_test_register_module(tt, left_src, "pkg/left.weft")
  let right = module_test_register_module(tt, right_src, "pkg/right.weft")
  let leaf = module_test_register_module(tt, leaf_src, "pkg/leaf.weft")
  module_test_register_import(tt, root_src, left, nlist_new(), "left", module_visibility_private())
  module_test_register_import(tt, root_src, right, nlist_new(), "right", module_visibility_private())
  module_test_register_import(tt, left_src, leaf, nlist_new(), "leaf", module_visibility_public())
  module_test_register_import(tt, right_src, leaf, nlist_new(), "leaf", module_visibility_public())
  Test.assert_eq(module_import_cycle_is_present(module_graph_find_cycle(tt)), 0)
}
