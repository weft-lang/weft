test "module_scope_explicit_import_shadows_weak_import_in_either_order" {
  let tt = ttable_new()
  let root_src = "Item root"
  let prelude_src = "Item prelude"
  let explicit_src = "Item explicit"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let prelude = module_test_register_module(tt, prelude_src, "stdlib/prelude.weft")
  let explicit = module_test_register_module(tt, explicit_src, "pkg/explicit.weft")
  module_test_register_decl(tt, prelude_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let explicit_decl = module_test_register_decl(tt, explicit_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let weak_selections = nlist_new()
  nlist_add(weak_selections, module_test_scope_wildcard())
  module_test_register_weak_import(tt, root_src, prelude, weak_selections)
  let explicit_selections = nlist_new()
  nlist_add(explicit_selections, module_test_scope_selection("Item", ""))
  let explicit_import = module_test_register_import(tt, root_src, explicit, explicit_selections, "", module_visibility_private())
  module_scope_build_all(tt)
  let binding = module_scope_lookup(tt, __str_ptr(root_src), __str_ptr("Item"), 0, 4)
  Test.assert_eq(module_scope_entry_target(binding), explicit_decl)
  Test.assert_eq(module_scope_entry_import(binding), explicit_import)
  Test.assert_eq(module_scope_entry_status(binding), module_scope_status_resolved())

  let reverse_tt = ttable_new()
  module_test_register_module(reverse_tt, root_src, "pkg/root.weft")
  let reverse_prelude = module_test_register_module(reverse_tt, prelude_src, "stdlib/prelude.weft")
  let reverse_explicit = module_test_register_module(reverse_tt, explicit_src, "pkg/explicit.weft")
  module_test_register_decl(reverse_tt, prelude_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let reverse_decl = module_test_register_decl(reverse_tt, explicit_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  let reverse_explicit_selections = nlist_new()
  nlist_add(reverse_explicit_selections, module_test_scope_selection("Item", ""))
  let reverse_import = module_test_register_import(reverse_tt, root_src, reverse_explicit, reverse_explicit_selections, "", module_visibility_private())
  let reverse_weak_selections = nlist_new()
  nlist_add(reverse_weak_selections, module_test_scope_wildcard())
  module_test_register_weak_import(reverse_tt, root_src, reverse_prelude, reverse_weak_selections)
  module_scope_build_all(reverse_tt)
  let reverse_binding = module_scope_lookup(reverse_tt, __str_ptr(root_src), __str_ptr("Item"), 0, 4)
  Test.assert_eq(module_scope_entry_target(reverse_binding), reverse_decl)
  Test.assert_eq(module_scope_entry_import(reverse_binding), reverse_import)
  Test.assert_eq(module_scope_entry_status(reverse_binding), module_scope_status_resolved())
}

