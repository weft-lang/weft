  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_effect(), 0, 3, module_visibility_public())
  module_test_register_import(tt, root_src, dep, nlist_new(), "effects", module_visibility_private())
  module_scope_build_all(tt)
  let field = node_new(13, node_new(2, 0, 7, 0, 0), 8, 3, 0)
  Test.assert_eq(typeck_resolve_effect_ref(field, tenv_new(), __str_ptr(root_src), tt), decl)
  Test.assert_eq(effect_ref_decl_fact(field), decl)
}

test "generic qualified calls record the member rather than the AST pointer" {
  let tt = ttable_new()
  let root_src = "bank work"
  let dep_src = "work"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/bank.weft")
  let decl = module_test_register_decl(tt, dep_src, module_decl_namespace_value(), 0, 4, module_visibility_public())
  module_test_register_import(tt, root_src, dep, nlist_new(), "bank", module_visibility_private())
  module_scope_build_all(tt)

  let ft = ftypes_new_with_ttable(tt)
  ftypes_add_module_decl(ft, tt, __str_ptr(dep_src), 0, 4, ty_i64(), nlist_new(), ty_effect_sig(nlist_new()), nlist_new())
  let base = node_new(2, 0, 4, 0, 0)
  let call = node_new(32, base, 5, 4, nlist_new())
  let fact = typeck_record_generic_call_symbol_use(tt, ft, tenv_new(), __str_ptr(root_src), call)

  Test.assert_true(fact != 0)
  Test.assert_eq(typeck_qualified_call_declaration(call), decl)
  Test.assert_eq(semantic_symbol_fact_use_start(fact), 5)
  Test.assert_eq(semantic_symbol_fact_use_len(fact), 4)
  Test.assert_eq(semantic_symbol_fact_definition_source(fact), __str_ptr(dep_src))
  Test.assert_eq(semantic_symbol_fact_kind(fact), semantic_symbol_kind_function())
}

test "qualified effect type expr retains declaration and arguments" {
  let tt = ttable_new()
  let src = "Box"
  module_test_register_module(tt, src, "pkg/effects.weft")
  let decl = module_test_register_decl(tt, src, module_decl_namespace_effect(), 0, 3, module_visibility_public())
  let args = nlist_new()
  nlist_add(args, ty_i64())
  nlist_add(args, ty_slice(ty_str()))
  let exact = type_expr_from_node(ty_qualified_effect_app(decl, args))
  let node = type_expr_to_node(exact)
  Test.assert_eq(type_expr_tag_or(exact, 0 - 1), 25)
  Test.assert_eq(type_expr_child_count_or(exact, 0 - 1), 2)
  Test.assert_eq(ty_tag(node), 25)
  Test.assert_eq(ty_f1(node), decl)
  Test.assert_eq(nlist_len(effect_atom_args(node)), 2)
  Test.assert_eq(ty_f1(nlist_get(effect_atom_args(node), 0)), PRIM_I64())
  Test.assert_eq(ty_slice_mutable(nlist_get(effect_atom_args(node), 1)), 0)
  Test.assert_eq(type_expr_tree_raw_bridge_slot_count(exact), 0)
}

