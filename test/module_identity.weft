fn module_test_parse_quiet(source: str, tt: i64) -> i64 {
  let grammar = weft_grammar()
  handle grammar.parse(__str_ptr(source), __str_len(source), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn module_test_parse_diagnostics(source: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let count = alloc_words(1)
  mem_store64(count, 0)
  handle grammar.parse(__str_ptr(source), __str_len(source), tt) {
    Diagnose.report(diagnostic) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
  }
  mem_load64(count)
}

fn module_test_load_file_quiet(tt: i64, path: str) -> i64 {
  handle parse_use_file(nlist_new(), tt, path) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn module_test_bind_prelude_quiet(fns: i64, src: i64, tt: i64) -> i64 {
  handle parse_bind_implicit_prelude(fns, src, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn module_test_decl(tt: i64, src: str, namespace: i64, name: str) -> i64 {
  module_decl_fact_find(tt, __str_ptr(src), namespace, __str_ptr(name), 0, __str_len(name))
}

fn module_test_selection_name_eq(selection: i64, expected: str) -> i64 {
  if node_f2(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f1(selection), 0, __str_ptr(expected), 0, node_f2(selection)) }
}

fn module_test_selection_alias_eq(selection: i64, expected: str) -> i64 {
  if node_f4(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f3(selection), 0, __str_ptr(expected), 0, node_f4(selection)) }
}

fn module_test_register_module(tt: i64, src: str, path: str) -> i64 {
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  module_fact_find_source(tt, __str_ptr(src))
}

fn module_test_register_module_in_package(tt: i64, src: str, path: str, package_id: i64) -> i64 {
  module_fact_register_source(tt, __str_ptr(src), __str_ptr(path), __str_len(path), package_id)
}

fn module_test_register_decl(tt: i64, src: str, namespace: i64, name_start: i64, name_len: i64, visibility: i64) -> i64 {
  module_decl_fact_register(tt, __str_ptr(src), 0, namespace, name_start, name_len, visibility)
}

fn module_test_scope_selection(name: str, alias: str) -> i64 {
  node_new(0, __str_ptr(name), __str_len(name), __str_ptr(alias), __str_len(alias))
}

fn module_test_scope_wildcard() -> i64 { node_new(0, 0, 0 - 1, 0, 0) }

fn module_test_register_import(tt: i64, importer_src: str, target: i64, selections: i64, alias: str, visibility: i64) -> i64 {
  module_import_fact_register(tt, __str_ptr(importer_src), target, selections, __str_ptr(alias), __str_len(alias), visibility, 0)
}

fn module_test_register_weak_import(tt: i64, importer_src: str, target: i64, selections: i64) -> i64 {
  module_import_fact_register(tt, __str_ptr(importer_src), target, selections, 0, 0, module_visibility_private(), 1)
}

fn module_test_import_count_for_source(tt: i64, src: str) -> i64 {
  let importer = module_fact_find_source(tt, __str_ptr(src))
  let mut count = 0
  for i in 0..module_fact_import_count(tt) {
    if module_import_fact_importer(module_fact_import_at(tt, i)) == importer { count = count + 1 } else { 0 }
  }
  count
}

fn module_test_import_for_source_at(tt: i64, src: str, wanted: i64) -> i64 {
  let importer = module_fact_find_source(tt, __str_ptr(src))
  let mut seen = 0
  for i in 0..module_fact_import_count(tt) {
    let entry = module_fact_import_at(tt, i)
    if module_import_fact_importer(entry) == importer {
      if seen == wanted { return entry } else { seen = seen + 1 }
    } else { 0 }
  }
  0
}

test "module parser delegates unresolved bytes with exact physical logical and package identity" {
  -- Keep the selective-import braces out of a single outer source literal so
  -- the test harness does not interpret them as string interpolation.
  let root = str_concat("use injected_dependency.{", "answer} fn main() -> i64 { answer() }")
  let dependency = "pub fn answer() -> i64 { 42 }"
  let root_path = "injected_root.weft"
  let expected_path = "injected_dependency.weft"
  let expected_logical = "injected_dependency"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(root), __str_len(root), __str_ptr(root_path), __str_len(root_path))
  let seen = alloc_words(6)
  mem_store64_at(seen, 40, 0)
  let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    mem_store64_at(seen, 0, physical_ptr)
    mem_store64_at(seen, 8, physical_len)
    mem_store64_at(seen, 16, logical_ptr)
    mem_store64_at(seen, 24, logical_len)
    mem_store64_at(seen, 32, package_id)
    mem_store64_at(seen, 40, mem_load64_at(seen, 40) + 1)
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(dependency))
    mem_store64_at(result, 8, __str_len(dependency))
    result
  }
  let toks = lex(__str_ptr(root), __str_len(root))
  let fns = handle parse_module_with_loader(toks, __str_ptr(root), tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }

  Test.assert_eq(mem_load64_at(seen, 40), 1)
  Test.assert_eq(mem_load64_at(seen, 8), __str_len(expected_path))
  Test.assert_eq(src_eq_at(mem_load64_at(seen, 0), 0, __str_ptr(expected_path), 0, __str_len(expected_path)), 1)
  Test.assert_eq(mem_load64_at(seen, 24), __str_len(expected_logical))
  Test.assert_eq(src_eq_at(mem_load64_at(seen, 16), 0, __str_ptr(expected_logical), 0, __str_len(expected_logical)), 1)
  Test.assert_eq(mem_load64_at(seen, 32), 0)
  Test.assert_eq(nlist_len(fns), 2)
  Test.assert_eq(if module_fact_find_path(tt, __str_ptr(expected_logical), __str_len(expected_logical), 0) != 0 { 1 } else { 0 }, 1)
}

test "local module parser validates root declarations without loading imports" {
  let root = str_concat("use deliberately_missing_dependency.{", "answer} fn local() -> i64 { 7 } test \"root only\" { Test.assert_eq(local(), 7) }")
  let root_path = "local_probe_root.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(root), __str_len(root), __str_ptr(root_path), __str_len(root_path))
  let diagnostics = alloc_words(1)
  mem_store64_at(diagnostics, 0, 0)
  let fns = handle parse_module_local(lex(__str_ptr(root), __str_len(root)), __str_ptr(root), tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(diagnostics, 0, mem_load64_at(diagnostics, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(diagnostics, 0, mem_load64_at(diagnostics, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }

  Test.assert_eq(mem_load64_at(diagnostics, 0), 0)
  Test.assert_eq(nlist_len(fns), 2)
  Test.assert_eq(decl_is_function(decl_from_node(node_f1(nlist_get(fns, 0)))), 1)
  Test.assert_eq(decl_tag(decl_from_node(node_f1(nlist_get(fns, 1)))), 50)
  Test.assert_eq(module_fact_module_count(tt), 1)
  Test.assert_eq(module_fact_import_count(tt), 0)
}

test "module_keywords_lex_as_reserved_surface" {
  let src = "pub package as"
  let toks = lex(__str_ptr(src), __str_len(src))
  Test.assert_eq(tok_tag(toks, 0), 3)
  Test.assert_eq(tok_v1(toks, 0), 34)
  Test.assert_eq(tok_tag(toks, 1), 3)
  Test.assert_eq(tok_v1(toks, 1), 36)
  Test.assert_eq(tok_tag(toks, 2), 3)
  Test.assert_eq(tok_v1(toks, 2), 35)
}

test "module_registry_records_named_logical_identity_without_extension" {
  let src = "fn main() -> i64 { 0 }"
  let path = "test/nested/example.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  let entry = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(module_fact_module_count(tt), 1)
  Test.assert_eq(module_fact_entry_anonymous(entry), 0)
  Test.assert_eq(module_fact_entry_path_len(entry), __str_len("test/nested/example"))
  Test.assert_eq(module_fact_path_eq(entry, __str_ptr(path), __str_len(path), 0), 1)
  match module_id_from_entry(entry) {
    NamedModuleId(path_ptr, path_len, package_id) -> {
      Test.assert_eq(path_len, __str_len("test/nested/example"))
      Test.assert_eq(package_id, 0)
    }
    AnonymousModuleId(ordinal) -> Test.assert_eq(0, 1)
  }
}

test "module_registry_upgrades_anonymous_root_in_place" {
  let src = "fn main() -> i64 { 0 }"
  let path = "test/upgraded.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(src), __str_len(src), 0, 0)
  let anonymous = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(module_fact_entry_anonymous(anonymous), 1)
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  let named = module_fact_find_source(tt, __str_ptr(src))
  Test.assert_eq(named, anonymous)
  Test.assert_eq(module_fact_module_count(tt), 1)
  Test.assert_eq(module_fact_entry_anonymous(named), 0)
  Test.assert_eq(module_fact_path_eq(named, __str_ptr(path), __str_len(path), 0), 1)
}

test "module_logical_identity_is_independent_of_physical_source_origin" {
  let src = "fn imported() -> i64 { 1 }"
  let physical = "../vendor/math.weft"
  let logical = "dep/math.weft"
  let tt = ttable_new()
  let source_entry = ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(physical), __str_len(physical))
  let module_entry = module_fact_find_source(tt, __str_ptr(src))
  module_fact_upgrade_named(module_entry, __str_ptr(logical), __str_len(logical), 0)
  Test.assert_eq(module_fact_path_eq(module_entry, __str_ptr(logical), __str_len(logical), 0), 1)
  Test.assert_eq(src_eq_at(mem_load64_at(source_entry + 16, 0), 0, __str_ptr(physical), 0, __str_len(physical)), 1)
  Test.assert_eq(mem_load64_at(source_entry + 24, 0), __str_len(physical))
}

test "declaration_facts_pin_visibility_and_owner_identity" {
  let src = "pub fn exposed() -> i64 { 1 } pub(package) type Box { value: i64 } effect Signal { fn ping() -> i64 } trait Measure { fn size(self) -> i64 } impl Box { pub(package) fn value(self) -> i64 { self.value } fn hidden(self) -> i64 { 0 } }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let exposed = module_test_decl(tt, src, module_decl_namespace_value(), "exposed")
  let box = module_test_decl(tt, src, module_decl_namespace_type(), "Box")
  let signal = module_test_decl(tt, src, module_decl_namespace_effect(), "Signal")
  let ping = module_test_decl(tt, src, module_decl_namespace_effect_operation(), "ping")
  let measure = module_test_decl(tt, src, module_decl_namespace_trait(), "Measure")
  let size = module_test_decl(tt, src, module_decl_namespace_trait_method(), "size")
  let value = module_test_decl(tt, src, module_decl_namespace_inherent_method(), "value")
  let hidden = module_test_decl(tt, src, module_decl_namespace_inherent_method(), "hidden")
  Test.assert_eq(module_fact_decl_count(tt), 8)
  Test.assert_eq(module_decl_fact_visibility_code(exposed), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(box), module_visibility_package())
  Test.assert_eq(module_decl_fact_visibility_code(signal), module_visibility_private())
  Test.assert_eq(module_decl_fact_visibility_code(measure), module_visibility_private())
  Test.assert_eq(module_decl_fact_visibility_code(value), module_visibility_package())
  Test.assert_eq(module_decl_fact_visibility_code(hidden), module_visibility_private())
  Test.assert_eq(if module_decl_fact_owner(ping) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_decl_fact_owner(size) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(module_decl_fact_owner(value), box)
  Test.assert_eq(module_decl_fact_owner(hidden), box)
}

test "variant constructors inherit type visibility and owner identity" {
  let src = "pub type PublicChoice { Pick(i64), Empty } type PrivateChoice { Hide(str) }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let public_choice = module_test_decl(tt, src, module_decl_namespace_type(), "PublicChoice")
  let private_choice = module_test_decl(tt, src, module_decl_namespace_type(), "PrivateChoice")
  let pick = module_decl_fact_find_member(tt, public_choice, module_decl_namespace_constructor(), __str_ptr("Pick"), 0, 4)
  let empty = module_decl_fact_find_member(tt, public_choice, module_decl_namespace_constructor(), __str_ptr("Empty"), 0, 5)
  let hide = module_decl_fact_find_member(tt, private_choice, module_decl_namespace_constructor(), __str_ptr("Hide"), 0, 4)
  Test.assert_eq(module_decl_fact_owner(pick), public_choice)
  Test.assert_eq(module_decl_fact_owner(empty), public_choice)
  Test.assert_eq(module_decl_fact_owner(hide), private_choice)
  Test.assert_eq(module_decl_fact_visibility_code(pick), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(empty), module_visibility_public())
  Test.assert_eq(module_decl_fact_visibility_code(hide), module_visibility_private())
}

test "same-spelled constructors retain distinct parent identities" {
  let src = "pub type LeftChoice { Same(i64) } pub type RightChoice { Same(str) }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let left = module_test_decl(tt, src, module_decl_namespace_type(), "LeftChoice")
  let right = module_test_decl(tt, src, module_decl_namespace_type(), "RightChoice")
  let left_same = module_decl_fact_find_member(tt, left, module_decl_namespace_constructor(), __str_ptr("Same"), 0, 4)
  let right_same = module_decl_fact_find_member(tt, right, module_decl_namespace_constructor(), __str_ptr("Same"), 0, 4)
  Test.assert_eq(if left_same != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if right_same != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if left_same != right_same { 1 } else { 0 }, 1)
  Test.assert_eq(module_decl_fact_owner(left_same), left)
  Test.assert_eq(module_decl_fact_owner(right_same), right)
}

test "trait_implementation_is_evidence_not_a_second_declaration" {
  let src = "trait Measure { fn size(self) -> i64 } type Box { value: i64 } impl Measure for Box { fn size(self) -> i64 { self.value } }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  Test.assert_eq(module_fact_decl_count(tt), 3)
  Test.assert_eq(if module_test_decl(tt, src, module_decl_namespace_trait_method(), "size") != 0 { 1 } else { 0 }, 1)
}

test "path_import_records_selection_alias_and_wildcard" {
  let src = "use stdlib/option.{ Option as MaybeOption, * } fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  let selected = module_import_fact_selection_at(import, 0)
  let wildcard = module_import_fact_selection_at(import, 1)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_private())
  Test.assert_eq(module_import_fact_selection_count(import), 2)
  Test.assert_eq(module_test_selection_name_eq(selected, "Option"), 1)
  Test.assert_eq(module_test_selection_alias_eq(selected, "MaybeOption"), 1)
  Test.assert_eq(node_f2(wildcard), 0 - 1)
  Test.assert_eq(module_import_fact_source_offset(import), 4)
  Test.assert_eq(module_fact_path_eq(mem_load64_at(import + 8, 0), __str_ptr("stdlib/option.weft"), __str_len("stdlib/option.weft"), 0), 1)
}

test "module_alias_and_reexport_visibility_are_preserved" {
  let src = "pub(package) use stdlib/option as opt fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  Test.assert_eq(module_import_fact_alias_eq(import, "opt"), 1)
  Test.assert_eq(module_import_fact_selection_count(import), 0)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_package())
}

test "public_reexport_visibility_is_preserved" {
  let src = "pub use stdlib/option.{ Option } fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  let import = module_fact_import_at(tt, 0)
  Test.assert_eq(module_import_fact_visibility_code(import), module_visibility_public())
  Test.assert_eq(module_import_fact_selection_count(import), 1)
}

test "module_surface_matrix_records_every_canonical_import_form" {
  let src = "use stdlib/option use stdlib/result as result_types use stdlib/list.{ List, Cons as Prepend } use stdlib/maybe.{ * } pub use stdlib/fail.{ Fail } pub(package) use compiler/ir as unstable_ir fn main() -> i64 { 0 }"
  let tt = ttable_new()
  module_test_parse_quiet(src, tt)
  Test.assert_eq(module_test_import_count_for_source(tt, src), 6)

  let plain = module_test_import_for_source_at(tt, src, 0)
  let aliased = module_test_import_for_source_at(tt, src, 1)
  let selected = module_test_import_for_source_at(tt, src, 2)
  let wildcard = module_test_import_for_source_at(tt, src, 3)
  let public_reexport = module_test_import_for_source_at(tt, src, 4)
  let package_reexport = module_test_import_for_source_at(tt, src, 5)

  Test.assert_eq(module_import_fact_selection_count(plain), 0)
  Test.assert_eq(module_import_fact_alias_eq(aliased, "result_types"), 1)
  Test.assert_eq(module_import_fact_selection_count(selected), 2)
  Test.assert_eq(module_test_selection_name_eq(module_import_fact_selection_at(selected, 0), "List"), 1)
  Test.assert_eq(module_test_selection_alias_eq(module_import_fact_selection_at(selected, 1), "Prepend"), 1)
  Test.assert_eq(node_f2(module_import_fact_selection_at(wildcard, 0)), 0 - 1)
  Test.assert_eq(module_import_fact_visibility_code(public_reexport), module_visibility_public())
  Test.assert_eq(module_import_fact_visibility_code(package_reexport), module_visibility_package())
  Test.assert_eq(module_import_fact_alias_eq(package_reexport, "unstable_ir"), 1)
}

test "prelude_facade_has_exact_non_recursive_surface" {
  let tt = ttable_new()
  module_test_load_file_quiet(tt, "stdlib/prelude.weft")
  let prelude = module_fact_find_path(tt, __str_ptr("stdlib/prelude.weft"), __str_len("stdlib/prelude.weft"), 0)
  module_scope_build_all(tt)
  let prelude_src = module_fact_entry_source(prelude)
  let scopes = module_fact_scopes(tt)
  let mut exports = 0
  let mut facade_edges = 0
  for i in 0..nlist_len(scopes) {
    let entry = nlist_get(scopes, i)
    if module_scope_entry_module(entry) == prelude and module_scope_entry_kind(entry) != module_scope_kind_issue() and module_scope_entry_visibility(entry) == module_visibility_public() {
      exports = exports + 1
    } else { 0 }
  }
  for i in 0..module_fact_import_count(tt) {
    if module_import_fact_importer(module_fact_import_at(tt, i)) == prelude { facade_edges = facade_edges + 1 } else { 0 }
  }
  Test.assert_eq(facade_edges, 5)
  Test.assert_eq(exports, 11)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_type(), __str_ptr("Option"), 0, 6) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_constructor(), __str_ptr("Some"), 0, 4) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_effect(), __str_ptr("Fail"), 0, 4) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_value(), __str_ptr("option_some"), 0, 11), 0)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_trait(), __str_ptr("Default"), 0, 7), 0)
  Test.assert_eq(module_scope_lookup_declaration(tt, prelude_src, module_decl_namespace_effect(), __str_ptr("IO"), 0, 2), 0)
}

test "anonymous_root_gets_one_idempotent_weak_prelude_edge" {
  let src = "fn main() -> i64 { 0 }"
  let tt = ttable_new()
  let fns = module_test_parse_quiet(src, tt)
  module_test_bind_prelude_quiet(fns, __str_ptr(src), tt)
  let imports_after_first = module_fact_import_count(tt)
  module_test_bind_prelude_quiet(fns, __str_ptr(src), tt)
  let root = module_fact_find_source(tt, __str_ptr(src))
  let prelude = module_fact_find_path(tt, __str_ptr("stdlib/prelude.weft"), __str_len("stdlib/prelude.weft"), 0)
  let mut weak_edges = 0
  for i in 0..module_fact_import_count(tt) {
    let entry = module_fact_import_at(tt, i)
    if module_import_fact_importer(entry) == root and module_import_fact_target(entry) == prelude and module_import_fact_is_weak(entry) == 1 {
      weak_edges = weak_edges + 1
    } else { 0 }
  }
  Test.assert_eq(module_fact_import_count(tt), imports_after_first)
  Test.assert_eq(weak_edges, 1)
}

