  Test.assert_eq(pkg_export_resolved_declaration(tool_export), tool_decl)
}

test "package_export_fact_is_package_qualified_and_enforces_l7_visibility" {
  let tt = ttable_new()
  let root_manifest = pkg_manifest_parse_str("{\"package\":\"app\"}")
  pkg_identity_register_root(tt, root_manifest)
  let dep_manifest = pkg_manifest_parse_str("{\"package\":\"sdk\",\"exports\":{\"tools\":{\"stable\":{\"module\":\"facts/stable\",\"declaration\":\"query\"},\"unstable\":{\"module\":\"facts/unstable\",\"declaration\":\"query\"},\"wrong\":{\"module\":\"facts/wrong\",\"declaration\":\"Query\"},\"missing\":{\"module\":\"facts/stable\",\"declaration\":\"absent\"}}}}")
  let dep_id = pkg_identity_intern_under_owner(tt, __str_ptr("sdk"), __str_len("sdk"), __str_ptr("deps/sdk"), __str_len("deps/sdk"), dep_manifest, 0)
  let stable_src = "query"
  let unstable_src = "query"
  let wrong_src = "Query"
  module_test_register_module_in_package(tt, stable_src, "facts/stable.weft", dep_id)
  module_test_register_module_in_package(tt, unstable_src, "facts/unstable.weft", dep_id)
  module_test_register_module_in_package(tt, wrong_src, "facts/wrong.weft", dep_id)
  module_test_register_decl(tt, stable_src, module_decl_namespace_value(), 0, 5, module_visibility_public())
  module_test_register_decl(tt, unstable_src, module_decl_namespace_value(), 0, 5, module_visibility_package())
  module_test_register_decl(tt, wrong_src, module_decl_namespace_type(), 0, 5, module_visibility_public())
  let stable = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("stable"), __str_len("stable"))
  let unstable = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("unstable"), __str_len("unstable"))
  let wrong = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("wrong"), __str_len("wrong"))
  let missing = pkg_manifest_find_export(dep_manifest, pkg_export_kind_tool(), __str_ptr("missing"), __str_len("missing"))
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, stable), package_export_status_resolved())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, unstable), package_export_status_not_public())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, wrong), package_export_status_wrong_kind())
  Test.assert_eq(package_export_resolve_loaded(tt, dep_id, missing), package_export_status_missing_declaration())
}

test "resolved_type_lookup_follows_selected_alias_identity" {
  let tt = ttable_new()
  let root_src = "Renamed"
  let dep_src = "Box"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_type(), 0, 3, module_visibility_package())
  ttable_add(tt, __str_ptr(dep_src), 0, 3, 0, 0, 0, 0)
  let selections = nlist_new()
  nlist_add(selections, module_test_scope_selection("Box", "Renamed"))
  module_test_register_import(tt, root_src, dep, selections, "", module_visibility_private())
  module_scope_build_all(tt)
  let ty = typecheck_resolve_type(tt, __str_ptr(root_src), 0, 7)
  Test.assert_eq(ty_tag(ty), 9)
  Test.assert_eq(ty_f1(ty), type_name_hash(__str_ptr(dep_src), 0, 3))
}

test "resolved_type_lookup_does_not_flatten_plain_module_import" {
  let tt = ttable_new()
  let root_src = "Box root"
  let dep_src = "Box dep"
  module_test_register_module(tt, root_src, "pkg/root.weft")
  let dep = module_test_register_module(tt, dep_src, "pkg/dep.weft")
  module_test_register_decl(tt, dep_src, module_decl_namespace_type(), 0, 3, module_visibility_public())
  ttable_add(tt, __str_ptr(dep_src), 0, 3, 0, 0, 0, 0)
  module_test_register_import(tt, root_src, dep, nlist_new(), "dep", module_visibility_private())
  module_scope_build_all(tt)
  Test.assert_eq(typecheck_resolve_type(tt, __str_ptr(root_src), 0, 3), 0)
}

test "module_graph_direct_cycle_is_one_logical_identity" {
  let tt = ttable_new()
  let src = "root"
  let root = module_test_register_module(tt, src, "pkg/root.weft")
  let edge = module_test_register_import(tt, src, root, nlist_new(), "root", module_visibility_private())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_is_present(cycle), 1)
  Test.assert_eq(module_import_cycle_count(cycle), 1)
  Test.assert_eq(module_import_cycle_module_at(cycle, 0), root)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 0), edge)
}

test "module_graph_indirect_cycle_rotates_to_least_logical_identity" {
  let tt = ttable_new()
  let z_src = "z"
  let m_src = "m"
  let a_src = "a"
  let z = module_test_register_module(tt, z_src, "pkg/z.weft")
  let m = module_test_register_module(tt, m_src, "pkg/m.weft")
  let a = module_test_register_module(tt, a_src, "pkg/a.weft")
  let z_to_m = module_test_register_import(tt, z_src, m, nlist_new(), "m", module_visibility_private())
  let m_to_a = module_test_register_import(tt, m_src, a, nlist_new(), "a", module_visibility_private())
  let a_to_z = module_test_register_import(tt, a_src, z, nlist_new(), "z", module_visibility_private())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_count(cycle), 3)
  Test.assert_eq(module_import_cycle_module_at(cycle, 0), a)
  Test.assert_eq(module_import_cycle_module_at(cycle, 1), z)
  Test.assert_eq(module_import_cycle_module_at(cycle, 2), m)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 0), a_to_z)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 1), z_to_m)
  Test.assert_eq(module_import_cycle_edge_at(cycle, 2), m_to_a)
}

test "module_cycle_diagnostic_preserves_code_provenance_and_facts" {
  let tt = ttable_new()
  let a_src = "use b"
  let b_src = "use a"
  let a = module_test_register_module(tt, a_src, "pkg/a.weft")
  let b = module_test_register_module(tt, b_src, "pkg/b.weft")
  module_import_fact_register_at(tt, __str_ptr(a_src), b, nlist_new(), 0, 0, module_visibility_private(), 0, 1)
  module_import_fact_register_at(tt, __str_ptr(b_src), a, nlist_new(), 0, 0, module_visibility_private(), 0, 2)
  let observed = handle parse_diagnose_module_cycle(tt, __str_ptr(a_src)) {
    Diagnose.report(diagnostic) -> {
      let primary = diagnostic.primary()
      let primary_ok = match primary {
        DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> if source == __str_ptr(b_src) and start == 2 and end == 5 { 1 } else { 0 }
        _ -> 0
      }
      let class_name = diagnostic.class().name()
      let code_text = diagnostic.code().text()
      let class_ok = if src_eq(__str_ptr(class_name), 0, __str_len(class_name), "module") == 1 { 1 } else { 0 }
      let code_ok = if src_eq(__str_ptr(code_text), 0, __str_len(code_text), "E4001") == 1 { 1 } else { 0 }
      resume(primary_ok + class_ok + code_ok + diagnostic.related().count() + diagnostic.fields().count())
    }
    Diagnose.error(message, span) -> resume(0 - 100)
    Diagnose.warn(message, span) -> resume(0 - 100)
    Diagnose.note(message, span) -> resume(0 - 100)
  }
  Test.assert_eq(observed, 6)
}

