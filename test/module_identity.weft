  let before = nlist_len(fns)
  module_test_bind_prelude_quiet(fns, __str_ptr(src), tt)
  let mut found_unwrap_or = 0
  for i in 0..nlist_len(fns) {
    let pair = nlist_get(fns, i)
    let inner = pipeline_fn_inner(node_f1(pair))
    if inner != 0 and src_eq(node_f2(pair), node_f1(inner), node_f2(inner), "unwrap_or") == 1 {
      found_unwrap_or = 1
    } else { 0 }
  }
  Test.assert_eq(if nlist_len(fns) > before { 1 } else { 0 }, 1)
  Test.assert_eq(found_unwrap_or, 1)
}

test "prelude_facade_constituent_does_not_import_its_owner" {
  let tt = ttable_new()
  module_test_load_file_quiet(tt, "stdlib/result.weft")
  let result = module_fact_find_path(tt, __str_ptr("stdlib/result.weft"), __str_len("stdlib/result.weft"), 0)
  let result_src = module_fact_entry_source(result)
  let reports = alloc_words(1)
  mem_store64(reports, 0)
  source_acquire_with_standalone(() => handle parse_bind_implicit_prelude(nlist_new(), result_src, tt) {
    Diagnose.report(diagnostic) -> { mem_store64(reports, mem_load64(reports) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64(reports, mem_load64(reports) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  })
  let prelude = module_fact_find_path(tt, __str_ptr("stdlib/prelude.weft"), __str_len("stdlib/prelude.weft"), 0)
  let mut reverse_edge = 0
  for i in 0..module_fact_import_count(tt) {
    let edge = module_fact_import_at(tt, i)
    if module_import_fact_importer(edge) == result and module_import_fact_target(edge) == prelude {
      reverse_edge = reverse_edge + 1
    } else { 0 }
  }
  Test.assert_eq(module_graph_reaches(tt, prelude, result), 1)
  Test.assert_eq(reverse_edge, 0)
  Test.assert_eq(mem_load64(reports), 0)
  Test.assert_eq(module_import_cycle_is_present(module_graph_find_cycle(tt)), 0)
}

