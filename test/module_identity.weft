  module_test_register_import(tt, prelude_src, root, nlist_new(), "root", module_visibility_private())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_is_present(cycle), 1)
  Test.assert_eq(module_import_cycle_count(cycle), 2)
}

test "module_graph_reexport_edge_participates_in_cycles" {
  let tt = ttable_new()
  let first_src = "first"
  let second_src = "second"
  let first = module_test_register_module(tt, first_src, "pkg/first.weft")
  let second = module_test_register_module(tt, second_src, "pkg/second.weft")
  module_test_register_import(tt, first_src, second, nlist_new(), "second", module_visibility_public())
  module_test_register_import(tt, second_src, first, nlist_new(), "first", module_visibility_package())
  let cycle = module_graph_find_cycle(tt)
  Test.assert_eq(module_import_cycle_is_present(cycle), 1)
  Test.assert_eq(module_import_cycle_count(cycle), 2)
}

test "module_graph_diamond_is_acyclic" {
  let tt = ttable_new()
  let root_src = "root"
  let left_src = "left"
  let right_src = "right"
  let leaf_src = "leaf"
  let root = module_test_register_module(tt, root_src, "pkg/root.weft")
  let left = module_test_register_module(tt, left_src, "pkg/left.weft")
  let right = module_test_register_module(tt, right_src, "pkg/right.weft")
  let leaf = module_test_register_module(tt, leaf_src, "pkg/leaf.weft")
  module_test_register_import(tt, root_src, left, nlist_new(), "left", module_visibility_private())
  module_test_register_import(tt, root_src, right, nlist_new(), "right", module_visibility_private())
  module_test_register_import(tt, left_src, leaf, nlist_new(), "leaf", module_visibility_public())
  module_test_register_import(tt, right_src, leaf, nlist_new(), "leaf", module_visibility_public())
  Test.assert_eq(module_import_cycle_is_present(module_graph_find_cycle(tt)), 0)
}

test "module handler facts preserve identity specialization and optimizer knowledge" {
  let handler_source = "pub effect FactEffect<T> { fn value(input: T) -> T } pub implements<T> FactEffect<T>() { FactEffect<T>.value(input: T) -> resume(input) }"
  let root_source = "use handler_fact as handler_fact default handler handler_fact<i64>() fn fact_value() -> i64 { handler_fact.FactEffect<i64>.value(42) }"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(root_source), __str_len(root_source), __str_ptr("handler_fact_root.weft"), __str_len("handler_fact_root.weft"))
  ttable_mark_strict_source(tt, __str_ptr(root_source))
  let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(handler_source))
    mem_store64_at(result, 8, __str_len(handler_source))
    result
  }
  let fns = handle parse_module_with_loader(lex(__str_ptr(root_source), __str_len(root_source)), __str_ptr(root_source), tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let reports = alloc_words(1)
  mem_store64_at(reports, 0, 0)
  let errors = handle pipeline_check_loaded(fns, __str_ptr(root_source), tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(reports, 0, mem_load64_at(reports, 0) + 1) resume(0) }
    Diagnose.error(message, span) -> { mem_store64_at(reports, 0, mem_load64_at(reports, 0) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let handler_module = module_fact_find_source(tt, __str_ptr(handler_source))
  let root_module = module_fact_find_source(tt, __str_ptr(root_source))
  let implementation = module_fact_entry_handler_implementation(handler_module)
  let defaults = module_fact_entry_default_handlers(root_module)
  let body_node = pipeline_expr_node_strip_typed(pipeline_first_fn_body_node_for_source(fns, __str_ptr(root_source)))

  Test.assert_eq(errors, 0)
  Test.assert_eq(mem_load64_at(reports, 0), 0)
  Test.assert_eq(if handler_module != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(node_tag(implementation), 2)
  Test.assert_eq(if typeck_handler_implementation_decl(implementation) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(typeck_handler_implementation_clause_count(implementation), 1)
  Test.assert_eq(nlist_len(defaults), 1)
  Test.assert_eq(node_tag(nlist_get(defaults, 0)), 2)
  Test.assert_eq(node_tag(body_node), 64)

  match expr_from_node(body_node) {
    WithHandler(config, body, fact, source_site) -> match fact {
      ResolvedHandlerInstallFact(target_module, installed_implementation, subst, atom) -> {
        let exact_atom = type_expr_to_node(atom)
        let clauses = pipeline_handler_install_clauses(fact)
        Test.assert_eq(target_module, handler_module)
        Test.assert_eq(installed_implementation, implementation)
        Test.assert_eq(effect_atom_eq(exact_atom, ty_subst(typeck_handler_implementation_atom(implementation), subst)), 1)
        Test.assert_eq(handler_clause_list_tree_unknown_count(clauses), 0)
        Test.assert_eq(handler_clause_tag(handler_clause_list_nth(clauses, 0)), 34)
        Test.assert_eq(expr_tag(handler_clause_body_expr(handler_clause_list_nth(clauses, 0))), 35)
        Test.assert_eq(pipeline_handler_install_is_resolved(fact), 1)
        Test.assert_eq(expr_list_len(handler_configuration_args(config)), 0)
        let known_node = node_new(64, node_f1(body_node), node_new(1, 0, 0, 1, 0), node_f3(body_node), source_site)
        let unknown_node = node_new(64, node_f1(body_node), node_new(1, 0, 0, 1, 0), 0, source_site)
        Test.assert_eq(pipeline_ir_node_direct_effect_expr_collect(known_node, __str_ptr(root_source), nlist_new()), 0)
        Test.assert_eq(pipeline_ir_node_direct_effect_expr_collect(unknown_node, __str_ptr(root_source), nlist_new()), 2)
      }
      UnknownHandlerInstallFact -> Test.assert_eq(0, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
}
