fn module_test_parse_quiet(source: str, tt: i64) -> i64 {
  let grammar = weft_grammar()
  source_acquire_with_standalone(() => handle parse_module(grammar.lex(__str_ptr(source), __str_len(source)), __str_ptr(source), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  })
}

fn module_test_parse_diagnostics(source: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let count = alloc_words(1)
  mem_store64(count, 0)
  handle grammar.parse(__str_ptr(source), __str_len(source), tt) {
    Diagnose.report(diagnostic) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
  }
  mem_load64(count)
}

fn module_test_load_file_quiet(tt: i64, path: str) -> i64 {
  source_acquire_with_standalone(() => handle parse_use_file(nlist_new(), tt, path) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  })
}

fn module_test_bind_prelude_quiet(fns: i64, src: i64, tt: i64) -> i64 {
  source_acquire_with_standalone(() => handle parse_bind_implicit_prelude(fns, src, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  })
}

fn module_test_no_source_loader(physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) -> i64 {
  let result = alloc_words(2)
  mem_store64_at(result, 0, 0)
  mem_store64_at(result, 8, 0)
  result
}

fn module_test_decl(tt: i64, src: str, namespace: i64, name: str) -> i64 {
  module_decl_fact_find(tt, __str_ptr(src), namespace, __str_ptr(name), 0, __str_len(name))
}

fn module_test_selection_name_eq(selection: i64, expected: str) -> i64 {
  if node_f2(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f1(selection), 0, __str_ptr(expected), 0, node_f2(selection)) }
}

fn module_test_selection_alias_eq(selection: i64, expected: str) -> i64 {
  if node_f4(selection) != __str_len(expected) { 0 }
  else { src_eq_at(node_f3(selection), 0, __str_ptr(expected), 0, node_f4(selection)) }
}

fn module_test_register_module(tt: i64, src: str, path: str) -> i64 {
  ttable_register_source(tt, __str_ptr(src), __str_len(src), __str_ptr(path), __str_len(path))
  module_fact_find_source(tt, __str_ptr(src))
}

fn module_test_register_module_in_package(tt: i64, src: str, path: str, package_id: i64) -> i64 {
  module_fact_register_source(tt, __str_ptr(src), __str_ptr(path), __str_len(path), package_id)
}

fn module_test_register_decl(tt: i64, src: str, namespace: i64, name_start: i64, name_len: i64, visibility: i64) -> i64 {
  module_decl_fact_register(tt, __str_ptr(src), 0, namespace, name_start, name_len, visibility)
}

fn module_test_scope_selection(name: str, alias: str) -> i64 {
  node_new(0, __str_ptr(name), __str_len(name), __str_ptr(alias), __str_len(alias))
}

fn module_test_scope_wildcard() -> i64 { node_new(0, 0, 0 - 1, 0, 0) }

fn module_test_register_import(tt: i64, importer_src: str, target: i64, selections: i64, alias: str, visibility: i64) -> i64 {
  module_import_fact_register(tt, __str_ptr(importer_src), target, selections, __str_ptr(alias), __str_len(alias), visibility, 0)
}

fn module_test_register_weak_import(tt: i64, importer_src: str, target: i64, selections: i64) -> i64 {
  module_import_fact_register(tt, __str_ptr(importer_src), target, selections, 0, 0, module_visibility_private(), 1)
}

fn module_test_import_count_for_source(tt: i64, src: str) -> i64 {
  let importer = module_fact_find_source(tt, __str_ptr(src))
  let mut count = 0
  for i in 0..module_fact_import_count(tt) {
    if module_import_fact_importer(module_fact_import_at(tt, i)) == importer { count = count + 1 } else { 0 }
  }
  count
}

fn module_test_import_for_source_at(tt: i64, src: str, wanted: i64) -> i64 {
  let importer = module_fact_find_source(tt, __str_ptr(src))
  let mut seen = 0
  for i in 0..module_fact_import_count(tt) {
    let entry = module_fact_import_at(tt, i)
    if module_import_fact_importer(entry) == importer {
      if seen == wanted { return entry } else { seen = seen + 1 }
    } else { 0 }
  }
  0
}

fn module_test_pair_for_source(fns: i64, src: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(fns) and result == 0 {
    let pair = nlist_get(fns, i)
    if node_f2(pair) == src { result = pair } else { i = i + 1 }
  }
  result
}

fn module_test_semantic_fact_count_for_source(tt: i64, src: i64) -> i64 {
  let facts = ttable_semantic_symbol_facts(tt)
  let mut count = 0
  for i in 0..nlist_len(facts) {
    if semantic_symbol_fact_use_source(nlist_get(facts, i)) == src { count = count + 1 } else { 0 }
  }
  count
}

type ModuleCheckedProductFixture {
  base: str,
    outsider: str,
    source_tt: i64,
    base_fns: i64,
    outsider_fns: i64,
    base_errors: i64,
    base_reports: i64,
}

type ModuleCheckedProductExtension {
  root: str,
    root_fns: i64,
    root_errors: i64,
    root_reports: i64,
}

type ModuleProductForestFixture {
  first: str,
    second: str,
    dependent: str,
    source_tt: i64,
    source_fns: i64,
}

fn module_test_make_product_forest_fixture() -> ModuleProductForestFixture {
  let first = str_concat("pub fn forest_first() -> i64 ", str_concat("{", str_concat(" 20 ", "}")))
  let second = str_concat("pub fn forest_second() -> i64 ", str_concat("{", str_concat(" 22 ", "}")))
  let dependent = str_concat("use forest_first.", str_concat("{", str_concat("forest_first", str_concat("}", str_concat(" fn dependent_value() -> i64 ", str_concat("{", str_concat(" forest_first() ", "}")))))))
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(first), __str_len(first), __str_ptr("forest_first.weft"), __str_len("forest_first.weft"))
  ttable_register_source(tt, __str_ptr(second), __str_len(second), __str_ptr("forest_second.weft"), __str_len("forest_second.weft"))
  ttable_register_source(tt, __str_ptr(dependent), __str_len(dependent), __str_ptr("forest_dependent.weft"), __str_len("forest_dependent.weft"))
  let first_fns = module_test_parse_quiet(first, tt)
  let second_fns = module_test_parse_quiet(second, tt)
  let dependent_fns = module_test_parse_quiet(dependent, tt)
  let source_fns = nlist_new()
  nlist_add(source_fns, module_test_pair_for_source(first_fns, __str_ptr(first)))
  nlist_add(source_fns, module_test_pair_for_source(second_fns, __str_ptr(second)))
  nlist_add(source_fns, module_test_pair_for_source(dependent_fns, __str_ptr(dependent)))
  ModuleProductForestFixture {
    first: first,
      second: second,
      dependent: dependent,
      source_tt: tt,
      source_fns: source_fns,
  }
}

fn module_test_product_forest_selection(fixture: ModuleProductForestFixture) -> i64 {
  let selected = nlist_new()
  nlist_add(selected, module_fact_find_source(fixture.source_tt, __str_ptr(fixture.first)))
  nlist_add(selected, module_fact_find_source(fixture.source_tt, __str_ptr(fixture.second)))
  selected
}

fn module_test_make_checked_product_fixture() -> ModuleCheckedProductFixture {
  let dependency = str_concat("pub type Shared ", str_concat("{", str_concat(" value: i64 ", str_concat("}", str_concat(" pub fn shared_value() -> i64 ", str_concat("{", str_concat(" 7 ", "}")))))))
  let base = str_concat("use checked_dependency.", str_concat("{", str_concat("Shared, shared_value", str_concat("}", str_concat(" pub fn base_value() -> i64 ", str_concat("{", str_concat(" shared_value() ", "}")))))))
  let outsider = str_concat("pub fn outsider_value() -> i64 ", str_concat("{", str_concat(" 99 ", "}")))
  let source_tt = ttable_new()
  ttable_register_source(source_tt, __str_ptr(base), __str_len(base), __str_ptr("checked_product_base.weft"), __str_len("checked_product_base.weft"))
  ttable_mark_strict_source(source_tt, __str_ptr(base))
  let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(dependency))
    mem_store64_at(result, 8, __str_len(dependency))
    result
  }
  let base_fns = handle parse_module_with_loader(lex(__str_ptr(base), __str_len(base)), __str_ptr(base), source_tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let base_reports = alloc_words(1)
  mem_store64_at(base_reports, 0, 0)
  let base_errors = handle pipeline_check_loaded(base_fns, __str_ptr(base), source_tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(base_reports, 0, mem_load64_at(base_reports, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(base_reports, 0, mem_load64_at(base_reports, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  ttable_mark_checked_module_products(source_tt, base_fns)
  ttable_register_source(source_tt, __str_ptr(outsider), __str_len(outsider), __str_ptr("checked_product_outsider.weft"), __str_len("checked_product_outsider.weft"))
  let outsider_fns = handle parse_module_with_loader(lex(__str_ptr(outsider), __str_len(outsider)), __str_ptr(outsider), source_tt, module_test_no_source_loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  ModuleCheckedProductFixture {
    base: base,
      outsider: outsider,
      source_tt: source_tt,
      base_fns: base_fns,
      outsider_fns: outsider_fns,
      base_errors: base_errors,
      base_reports: mem_load64_at(base_reports, 0),
  }
}

fn module_test_extend_checked_product(inherited_tt: i64) -> ModuleCheckedProductExtension {
  let root = str_concat("use checked_product_base.", str_concat("{", str_concat("base_value", str_concat("}", str_concat(" fn root_value() -> i64 ", str_concat("{", str_concat(" base_value() + 1 ", "}")))))))
  ttable_register_source(inherited_tt, __str_ptr(root), __str_len(root), __str_ptr("checked_product_root.weft"), __str_len("checked_product_root.weft"))
  let root_fns = handle parse_module_with_loader(lex(__str_ptr(root), __str_len(root)), __str_ptr(root), inherited_tt, module_test_no_source_loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let root_reports = alloc_words(1)
  mem_store64_at(root_reports, 0, 0)
  let root_errors = handle pipeline_check_loaded_extending_checked(root_fns, __str_ptr(root), inherited_tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(root_reports, 0, mem_load64_at(root_reports, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(root_reports, 0, mem_load64_at(root_reports, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  ModuleCheckedProductExtension {
    root: root,
      root_fns: root_fns,
      root_errors: root_errors,
      root_reports: mem_load64_at(root_reports, 0),
  }
}

test "module parser delegates unresolved bytes with exact physical logical and package identity" {
  -- Keep the selective-import braces out of a single outer source literal so
  -- the test harness does not interpret them as string interpolation.
  let root = str_concat("use injected_dependency.{", "answer} fn main() -> i64 { answer() }")
  let dependency = "pub fn answer() -> i64 { 42 }"
  let root_path = "injected_root.weft"
  let expected_path = "injected_dependency.weft"
  let expected_logical = "injected_dependency"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(root), __str_len(root), __str_ptr(root_path), __str_len(root_path))
  let seen = alloc_words(6)
  mem_store64_at(seen, 40, 0)
  let loader: (i64, i64, i64, i64, i64) -> i64 = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    mem_store64_at(seen, 0, physical_ptr)
    mem_store64_at(seen, 8, physical_len)
    mem_store64_at(seen, 16, logical_ptr)
    mem_store64_at(seen, 24, logical_len)
    mem_store64_at(seen, 32, package_id)
    mem_store64_at(seen, 40, mem_load64_at(seen, 40) + 1)
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(dependency))
    mem_store64_at(result, 8, __str_len(dependency))
    result
  }
  let toks = lex(__str_ptr(root), __str_len(root))
  let fns = handle parse_module_with_loader(toks, __str_ptr(root), tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }

  Test.assert_eq(mem_load64_at(seen, 40), 1)
  Test.assert_eq(mem_load64_at(seen, 8), __str_len(expected_path))
  Test.assert_eq(src_eq_at(mem_load64_at(seen, 0), 0, __str_ptr(expected_path), 0, __str_len(expected_path)), 1)
  Test.assert_eq(mem_load64_at(seen, 24), __str_len(expected_logical))
  Test.assert_eq(src_eq_at(mem_load64_at(seen, 16), 0, __str_ptr(expected_logical), 0, __str_len(expected_logical)), 1)
  Test.assert_eq(mem_load64_at(seen, 32), 0)
  Test.assert_eq(nlist_len(fns), 2)
  Test.assert_eq(if module_fact_find_path(tt, __str_ptr(expected_logical), __str_len(expected_logical), 0) != 0 { 1 } else { 0 }, 1)
}

test "shared project table reuses parsed dependency bodies across roots" {
  let first = str_concat("use shared_dependency.{", "answer} fn first() -> i64 { answer() }")
  let second = str_concat("use shared_dependency.{", "answer} fn second() -> i64 { answer() }")
  let dependency = "pub fn answer() -> i64 { 42 }"
  let first_path = "first_root.weft"
  let second_path = "second_root.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(first), __str_len(first), __str_ptr(first_path), __str_len(first_path))
  ttable_register_source(tt, __str_ptr(second), __str_len(second), __str_ptr(second_path), __str_len(second_path))
  let loads = alloc_words(1)
  mem_store64_at(loads, 0, 0)
  let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    mem_store64_at(loads, 0, mem_load64_at(loads, 0) + 1)
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(dependency))
    mem_store64_at(result, 8, __str_len(dependency))
    result
  }
  let first_fns = handle parse_module_with_loader(lex(__str_ptr(first), __str_len(first)), __str_ptr(first), tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let second_fns = handle parse_module_with_loader(lex(__str_ptr(second), __str_len(second)), __str_ptr(second), tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }

  Test.assert_eq(mem_load64_at(loads, 0), 1)
  Test.assert_eq(module_fact_module_count(tt), 3)
  Test.assert_eq(module_fact_import_count(tt), 2)
  Test.assert_eq(nlist_len(first_fns), 2)
  Test.assert_eq(nlist_len(second_fns), 2)
  Test.assert_eq(if nlist_get(first_fns, 0) == nlist_get(second_fns, 0) { 1 } else { 0 }, 1)
  Test.assert_eq(if nlist_get(first_fns, 1) != nlist_get(second_fns, 1) { 1 } else { 0 }, 1)
}

test "injected file imports rehydrate cached bodies for each root" {
  let support = "pub fn support_value() -> i64 { 7 }"
  let tt = ttable_new()
  let loads = alloc_words(1)
  mem_store64_at(loads, 0, 0)
  let source_result = () => {
    mem_store64_at(loads, 0, mem_load64_at(loads, 0) + 1)
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(support))
    mem_store64_at(result, 8, __str_len(support))
    result
  }
  let first_fns = nlist_new()
  let second_fns = nlist_new()
  handle {
    handle parse_use_file(first_fns, tt, "cached_support.weft") {
      Diagnose.report(diagnostic) -> resume(0)
      Diagnose.error(msg, span) -> resume(0)
      Diagnose.warn(msg, span) -> resume(0)
      Diagnose.note(msg, span) -> resume(0)
    }
  } {
    SourceAcquire.sdk_origin() -> resume(NoSdk)
    SourceAcquire.load(physical_ptr, physical_len, logical_ptr, logical_len, package_id) -> resume(source_result())
  }
  handle {
    handle parse_use_file(second_fns, tt, "cached_support.weft") {
      Diagnose.report(diagnostic) -> resume(0)
      Diagnose.error(msg, span) -> resume(0)
      Diagnose.warn(msg, span) -> resume(0)
      Diagnose.note(msg, span) -> resume(0)
    }
  } {
    SourceAcquire.sdk_origin() -> resume(NoSdk)
    SourceAcquire.load(physical_ptr, physical_len, logical_ptr, logical_len, package_id) -> resume(source_result())
  }

  Test.assert_eq(mem_load64_at(loads, 0), 1)
  Test.assert_eq(nlist_len(first_fns), 1)
  Test.assert_eq(nlist_len(second_fns), 1)
  Test.assert_eq(if nlist_get(first_fns, 0) == nlist_get(second_fns, 0) { 1 } else { 0 }, 1)
}

test "parsed module products instantiate exact root-local checker closures" {
  let dependency = str_concat("pub type Shared ", str_concat("{", str_concat(" value: i64 ", str_concat("}", str_concat(" pub fn shared_value() -> i64 ", str_concat("{", str_concat(" 7 ", "}")))))))
  let first = str_concat("use shared_product.", str_concat("{", str_concat("Shared, shared_value", str_concat("}", str_concat(" type Local ", str_concat("{", str_concat(" item: Shared ", str_concat("}", str_concat(" fn first_value() -> i64 ", str_concat("{", str_concat(" shared_value() ", "}")))))))))))
  let second = str_concat("use shared_product.", str_concat("{", str_concat("Shared, shared_value", str_concat("}", str_concat(" type Local ", str_concat("{", str_concat(" item: Shared ", str_concat("}", str_concat(" fn second_value() -> i64 ", str_concat("{", str_concat(" shared_value() + 1 ", "}")))))))))))
  let first_path = "product/first.weft"
  let second_path = "product/second.weft"
  let source_tt = ttable_new()
  ttable_register_source(source_tt, __str_ptr(first), __str_len(first), __str_ptr(first_path), __str_len(first_path))
  ttable_register_source(source_tt, __str_ptr(second), __str_len(second), __str_ptr(second_path), __str_len(second_path))
  ttable_mark_strict_source(source_tt, __str_ptr(first))
  let loads = alloc_words(1)
  mem_store64_at(loads, 0, 0)
  let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => {
    mem_store64_at(loads, 0, mem_load64_at(loads, 0) + 1)
    let result = alloc_words(2)
    mem_store64_at(result, 0, __str_ptr(dependency))
    mem_store64_at(result, 8, __str_len(dependency))
    result
  }
  let first_fns = handle parse_module_with_loader(lex(__str_ptr(first), __str_len(first)), __str_ptr(first), source_tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let second_fns = handle parse_module_with_loader(lex(__str_ptr(second), __str_len(second)), __str_ptr(second), source_tt, loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let source_first_module = module_fact_find_source(source_tt, __str_ptr(first))
  let source_second_module = module_fact_find_source(source_tt, __str_ptr(second))
  let source_first_pair = module_test_pair_for_source(first_fns, __str_ptr(first))

  let first_instance = module_parse_product_instantiate(source_tt, __str_ptr(first), first_fns)
  let second_instance = module_parse_product_instantiate(source_tt, __str_ptr(second), second_fns)
  let mut first_local_fns = nlist_new()
  let mut first_tt = ttable_new()
  match first_instance {
    ModuleParseInstance(fns, tt) -> { first_local_fns = fns first_tt = tt 0 }
    InvalidModuleParseInstance -> 0
  }
  let mut second_local_fns = nlist_new()
  let mut second_tt = ttable_new()
  match second_instance {
    ModuleParseInstance(fns, tt) -> { second_local_fns = fns second_tt = tt 0 }
    InvalidModuleParseInstance -> 0
  }
  let first_local_pair = module_test_pair_for_source(first_local_fns, __str_ptr(first))
  let first_local_module = module_fact_find_source(first_tt, __str_ptr(first))
  let first_shared_module = module_fact_find_path(first_tt, __str_ptr("shared_product"), __str_len("shared_product"), 0)
  let second_local_module = module_fact_find_source(second_tt, __str_ptr(second))

  Test.assert_eq(mem_load64_at(loads, 0), 1)
  Test.assert_eq(module_fact_module_count(source_tt), 3)
  Test.assert_eq(module_fact_module_count(first_tt), 2)
  Test.assert_eq(module_fact_module_count(second_tt), 2)
  Test.assert_eq(if first_shared_module != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_fact_find_source(first_tt, __str_ptr(second)) == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if module_fact_find_source(second_tt, __str_ptr(first)) == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ttable_entry_count(first_tt), 2)
  Test.assert_eq(ttable_entry_count(second_tt), 2)
  Test.assert_eq(ttable_source_is_strict(first_tt, __str_ptr(first)), 1)
  Test.assert_eq(ttable_source_is_strict(second_tt, __str_ptr(second)), 0)
  Test.assert_eq(if node_tag(first_local_pair) != node_tag(source_first_pair) { 1 } else { 0 }, 1)
  Test.assert_eq(if module_decl_fact_module(node_tag(first_local_pair)) == first_local_module { 1 } else { 0 }, 1)
  Test.assert_eq(if module_decl_fact_module(node_tag(source_first_pair)) == source_first_module { 1 } else { 0 }, 1)
  Test.assert_eq(if first_local_module != second_local_module { 1 } else { 0 }, 1)
  Test.assert_eq(module_fact_entry_scope_state(source_first_module), 0)
  Test.assert_eq(module_fact_entry_scope_state(source_second_module), 0)

  let reported = alloc_words(1)
  mem_store64_at(reported, 0, 0)
  let check_errors = handle pipeline_check_loaded(first_local_fns, __str_ptr(first), first_tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(reported, 0, mem_load64_at(reported, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(reported, 0, mem_load64_at(reported, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  Test.assert_eq(check_errors, 0)
  Test.assert_eq(mem_load64_at(reported, 0), 0)
  Test.assert_eq(module_fact_entry_scope_state(first_local_module), 2)
  Test.assert_eq(module_fact_entry_scope_state(source_first_module), 0)
}

test "checked module products extend a root without rechecking inherited bodies" {
  let base = str_concat("pub fn base_value(x: i64) -> i64 ", str_concat("{", str_concat(" x + 1 ", "}")))
  let root = str_concat("use checked_base.", str_concat("{", str_concat("base_value", str_concat("}", str_concat(" fn root_value() -> i64 ", str_concat("{", str_concat(" base_value(6) ", "}")))))))
  let base_path = "checked_base.weft"
  let root_path = "checked_root.weft"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(base), __str_len(base), __str_ptr(base_path), __str_len(base_path))
  let base_fns = handle parse_module_with_loader(lex(__str_ptr(base), __str_len(base)), __str_ptr(base), tt, module_test_no_source_loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let base_reports = alloc_words(1)
  mem_store64_at(base_reports, 0, 0)
  let base_errors = handle pipeline_check_loaded(base_fns, __str_ptr(base), tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(base_reports, 0, mem_load64_at(base_reports, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(base_reports, 0, mem_load64_at(base_reports, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  ttable_mark_checked_module_products(tt, base_fns)
  let base_fact_count = module_test_semantic_fact_count_for_source(tt, __str_ptr(base))
  let base_catalog_count = nlist_len(ttable_get_checked_functions(tt))

  ttable_register_source(tt, __str_ptr(root), __str_len(root), __str_ptr(root_path), __str_len(root_path))
  let root_fns = handle parse_module_with_loader(lex(__str_ptr(root), __str_len(root)), __str_ptr(root), tt, module_test_no_source_loader) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  let root_reports = alloc_words(1)
  mem_store64_at(root_reports, 0, 0)
  let root_errors = handle pipeline_check_loaded_extending_checked(root_fns, __str_ptr(root), tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(root_reports, 0, mem_load64_at(root_reports, 0) + 1) resume(0) }
    Diagnose.error(msg, span) -> { mem_store64_at(root_reports, 0, mem_load64_at(root_reports, 0) + 1) resume(0) }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }

  Test.assert_eq(base_errors, 0)
  Test.assert_eq(mem_load64_at(base_reports, 0), 0)
  Test.assert_eq(root_errors, 0)
  Test.assert_eq(mem_load64_at(root_reports, 0), 0)
  Test.assert_eq(nlist_len(base_fns), 1)
  Test.assert_eq(nlist_len(root_fns), 2)
  Test.assert_eq(nlist_len(ttable_checked_module_pairs(tt)), 1)
  Test.assert_eq(ttable_function_pair_is_checked(tt, nlist_get(base_fns, 0)), 1)
  Test.assert_eq(ttable_function_pair_is_checked(tt, module_test_pair_for_source(root_fns, __str_ptr(root))), 0)
  Test.assert_eq(module_test_semantic_fact_count_for_source(tt, __str_ptr(base)), base_fact_count)
  Test.assert_eq(nlist_len(ttable_get_checked_functions(tt)), base_catalog_count + 1)
}

test "checked products instantiate exact identity-preserving extensible closures" {
  let fixture = module_test_make_checked_product_fixture()
  let base = fixture.base
  let outsider = fixture.outsider
  let source_tt = fixture.source_tt
  let base_fns = fixture.base_fns
  let source_catalog = ttable_get_checked_functions(source_tt)
  let source_catalog_count = nlist_len(source_catalog)
  let source_fact_count = module_test_semantic_fact_count_for_source(source_tt, __str_ptr(base))
  let source_base_module = module_fact_find_source(source_tt, __str_ptr(base))
  let source_dependency_module = module_fact_find_path(source_tt, __str_ptr("checked_dependency"), __str_len("checked_dependency"), 0)
  let source_base_decl = module_decl_fact_find(source_tt, __str_ptr(base), module_decl_namespace_value(), __str_ptr("base_value"), 0, __str_len("base_value"))

  let invalid = module_checked_product_instantiate(source_tt, __str_ptr(outsider), fixture.outsider_fns)
  let instance = module_checked_product_instantiate(source_tt, __str_ptr(base), base_fns)
  let mut inherited_fns = nlist_new()
  let mut inherited_tt = ttable_new()
  let mut valid = 0
  match instance {
    ModuleCheckedInstance(fns, tt) -> { inherited_fns = fns inherited_tt = tt valid = 1 0 }
    InvalidModuleCheckedInstance -> 0
  }
  let invalid_rejected = match invalid {
    ModuleCheckedInstance(fns, tt) -> 0
    InvalidModuleCheckedInstance -> 1
  }
  let inherited_base_module = module_fact_find_source(inherited_tt, __str_ptr(base))
  let inherited_dependency_module = module_fact_find_path(inherited_tt, __str_ptr("checked_dependency"), __str_len("checked_dependency"), 0)
  let inherited_base_decl = module_decl_fact_find(inherited_tt, __str_ptr(base), module_decl_namespace_value(), __str_ptr("base_value"), 0, __str_len("base_value"))
  let inherited_catalog_count = nlist_len(ttable_get_checked_functions(inherited_tt))
  let source_scope_count = module_fact_scope_count(source_tt)

  let extension = module_test_extend_checked_product(inherited_tt)

  Test.assert_eq(fixture.base_errors, 0)
  Test.assert_eq(fixture.base_reports, 0)
  Test.assert_eq(invalid_rejected, 1)
  Test.assert_eq(valid, 1)
  Test.assert_eq(module_fact_module_count(inherited_tt), 3)
  Test.assert_eq(if module_fact_find_source(inherited_tt, __str_ptr(outsider)) == 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if inherited_base_module == source_base_module { 1 } else { 0 }, 1)
  Test.assert_eq(if inherited_dependency_module == source_dependency_module { 1 } else { 0 }, 1)
  Test.assert_eq(if inherited_base_decl == source_base_decl and inherited_base_decl != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if ttable_get_checked_functions(inherited_tt) != source_catalog { 1 } else { 0 }, 1)
  Test.assert_eq(inherited_catalog_count, source_catalog_count)
  Test.assert_eq(nlist_len(ttable_get_checked_functions(inherited_tt)), source_catalog_count + 1)
  Test.assert_eq(nlist_len(inherited_fns), 2)
  Test.assert_eq(nlist_len(ttable_checked_module_pairs(inherited_tt)), 2)
  Test.assert_eq(ttable_source_is_strict(inherited_tt, __str_ptr(base)), 1)
  Test.assert_eq(module_test_semantic_fact_count_for_source(inherited_tt, __str_ptr(base)), source_fact_count)
  Test.assert_eq(extension.root_errors, 0)
  Test.assert_eq(extension.root_reports, 0)
  Test.assert_eq(nlist_len(extension.root_fns), 3)
  Test.assert_eq(module_fact_module_count(source_tt), 3)
  Test.assert_eq(module_fact_scope_count(source_tt), source_scope_count)
  Test.assert_eq(nlist_len(source_catalog), source_catalog_count)
  Test.assert_eq(module_test_semantic_fact_count_for_source(source_tt, __str_ptr(base)), source_fact_count)
}

