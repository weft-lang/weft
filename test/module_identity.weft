test "module_paths_accept_keyword_spelled_segments" {
  let source = "use compiler/module.{*}"
  let toks = lex(__str_ptr(source), __str_len(source))
  let surface = handle parse_use_surface(toks, __str_ptr(source), 1) {
    Diagnose.error(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
    Diagnose.warn(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
    Diagnose.note(msg, span) -> resume(node_new(0, 0, 0, 0, 0))
  }
  Test.assert_eq(node_f2(surface), __str_len("compiler/module.weft"))
  Test.assert_eq(src_eq_at(node_f1(surface), 0, __str_ptr("compiler/module.weft"), 0, node_f2(surface)), 1)
  Test.assert_eq(node_f3(node_f4(surface)), 0)
  Test.assert_eq(node_f2(nlist_get(node_f1(node_f4(surface)), 0)), 0 - 1)
}

