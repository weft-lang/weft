use "runtime/alloc.weft"
use "runtime/rc.weft"

test "runtime_region_promote_return" {
  let arena = arena_new(64)
  let promoted = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 71)
    region_promote_rc(p, 8, 8)
  })
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(__mem_load64(promoted), 71)
  Test.assert_eq(rc_default_release(promoted), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_promote_store_outer" {
  let arena = arena_new(64)
  let slot: rc i64 = rc_default_alloc(8, 8)
  let promoted = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 72)
    region_promote_rc(p, 8, 8)
  })
  __mem_store64(slot, promoted)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(__mem_load64(__mem_load64(slot)), 72)
  Test.assert_eq(rc_default_release(promoted), 0)
  Test.assert_eq(rc_default_release(slot), 0)
  Test.assert_eq(arena_free(arena), 0)
}
