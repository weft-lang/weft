use "runtime/memory.weft"
use "runtime/alloc.weft"
use "runtime/rc.weft"
use "runtime/region_promotion_test.weft"

test "runtime_region_promote_return" {
  let arena = arena_new(64)
  let promoted: rc i64 = with_scoped_arena_alloc_value<rc i64>(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 71)
    region_promote_rc(p, 8, 8)
  })
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(mem_load64(promoted), 71)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_promote_store_outer" {
  let arena = arena_new(64)
  let slot: rc i64 = rc_default_alloc(8, 8)
  let promoted: rc i64 = with_scoped_arena_alloc_value<rc i64>(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 72)
    region_promote_rc(p, 8, 8)
  })
  mem_store64(slot, promoted)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(mem_load64(mem_load64(slot)), 72)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_promote_rc_locals_release_at_scope_exit" {
  let old = runtime_region_promote_auto_release_addr()
  let again: i64 = rc_default_alloc(8, 8)
  Test.assert_eq(again, old)
  Test.assert_eq(mem_load64(again), 0)
  Test.assert_eq(rc_default_release(again), 0)
}
