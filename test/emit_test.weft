-- Expected exit code: 0
-- Emit a signed Mach-O binary whose main returns 42.

use compiler/macho.{*}
use runtime/buffer.{*}
use runtime/syscall.{*}

fn main() -> i64 {
  let code = buf_new(8)
  -- mov x0, #42; ret
  bu32(code, 3531605312)
  bu32(code, 3596551104)
  let binary = emit_macho(code, 0, 16384)
  sys_write(1, buf_ptr(binary), buf_len(binary))
  0
}
