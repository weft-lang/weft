-- Expected exit code: 0
-- Link a hand-emitted `main` that returns 42 into a signed Mach-O image.

use compiler/backend/link.{*}
use compiler/backend/macho.{emit_native_link_macho}
use compiler/backend/target.{*}
use runtime/buffer.{*}
use stdlib/console as console
use stdlib/console/terminal as terminal
use stdlib/list.{Nil}
use stdlib/result.{Err, Ok}

fn main() -> i64 {
  let code = buf_new(8)
  -- mov x0, #42; ret
  bu32(code, 3531605312)
  bu32(code, 3596551104)
  let plan = NativeLinkPlan(
    NativeLinkMacosAarch64,
    code,
    Nil<NativeLinkLibrary>(),
    Nil<NativeLinkImport>(),
    Nil<NativeLinkPlanRelocation>(),
    0,
    NativeLinkDebugInformationAbsent,
    Nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(plan) {
    NativeLinkSucceeded(graph, _) -> with terminal() {
      match console.write_stdout(emit_native_link_macho(graph)) {
        Ok(_) -> 0
        Err(_) -> 1
      }
    }
    NativeLinkRejected(_) -> 1
  }
}
