-- Test: just emit a Mach-O binary and write to stdout

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

fn buf_new(cap: i64) -> i64 {
  let h = __bump_alloc(24)
  let d = __bump_alloc(cap)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, cap)
  h
}

fn buf_len(b: i64) -> i64 { __mem_load64(b + 8) }
fn buf_ptr(b: i64) -> i64 { __mem_load64(b) }

fn bu8(b: i64, v: i64) -> i64 {
  let d = __mem_load64(b)
  let l = __mem_load64(b + 8)
  __mem_store8(d + l, v)
  __mem_store64(b + 8, l + 1)
  b
}

fn bu32(b: i64, v: i64) -> i64 {
  bu8(b, v - v / 256 * 256)
  bu8(b, v / 256 - v / 65536 * 256)
  bu8(b, v / 65536 - v / 16777216 * 256)
  bu8(b, v / 16777216 - v / 4294967296 * 256)
}

fn bu64(b: i64, v: i64) -> i64 {
  bu32(b, v - v / 4294967296 * 4294967296)
  bu32(b, v / 4294967296)
}

fn bzeros(b: i64, n: i64) -> i64 {
  if n <= 0 { b }
  else {
    let d = __mem_load64(b)
    let l = __mem_load64(b + 8)
    zbulk(d, l, n)
    __mem_store64(b + 8, l + n)
    b
  }
}

fn zbulk(d: i64, off: i64, rem: i64) -> i64 {
  if rem <= 0 { 0 }
  else {
    if rem >= 8 {
      __mem_store64(d + off, 0)
      zbulk(d, off + 8, rem - 8)
    } else {
      __mem_store8(d + off, 0)
      zbulk(d, off + 1, rem - 1)
    }
  }
}

fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  let d = __mem_load64(b)
  let bl = __mem_load64(b + 8)
  cmem(d + bl, p, l, 0)
  __mem_store64(b + 8, bl + l)
  b
}

fn cmem(dst: i64, src: i64, len: i64, off: i64) -> i64 {
  if off >= len { 0 }
  else {
    __mem_store8(dst + off, __mem_load8(src + off))
    cmem(dst, src, len, off + 1)
  }
}

fn bpad(b: i64, target: i64) -> i64 {
  let l = buf_len(b)
  if l >= target { b }
  else { bzeros(b, target - l) }
}

fn main() -> i64 {
  let o = buf_new(65536)
  -- Header
  bu32(o, 4277009103)
  bu32(o, 16777228)
  bu32(o, 0)
  bu32(o, 2)
  bu32(o, 10)
  bu32(o, 648)
  bu32(o, 2097285)
  bu32(o, 0)
  -- Just write the header to stdout
  sys_write(1, buf_ptr(o), buf_len(o))
  buf_len(o)
}
