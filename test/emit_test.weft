-- Test: full Mach-O binary emission with split functions (< 12 calls each)
-- Produces a binary that exits with code 42

fn buf_new(cap: i64) -> i64 {
  let h = __bump_alloc(24)
  let d = __bump_alloc(cap)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, cap)
  h
}
fn buf_len(b: i64) -> i64 { __mem_load64(b + 8) }
fn buf_ptr(b: i64) -> i64 { __mem_load64(b) }
fn bu8(b: i64, v: i64) -> i64 {
  let d = __mem_load64(b)
  let l = __mem_load64(b + 8)
  __mem_store8(d + l, v)
  __mem_store64(b + 8, l + 1)
  b
}
fn bu32(b: i64, v: i64) -> i64 {
  bu8(b, v - v / 256 * 256)
  bu8(b, v / 256 - v / 65536 * 256)
  bu8(b, v / 65536 - v / 16777216 * 256)
  bu8(b, v / 16777216 - v / 4294967296 * 256)
}
fn bu64(b: i64, v: i64) -> i64 {
  bu32(b, v - v / 4294967296 * 4294967296)
  bu32(b, v / 4294967296)
}
fn bz(b: i64, n: i64) -> i64 {
  if n <= 0 { b }
  else { bu8(b, 0) bz(b, n - 1) }
}
fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  bscopy(b, p, l, 0)
}
fn bscopy(b: i64, p: i64, l: i64, i: i64) -> i64 {
  if i >= l { b }
  else { bu8(b, __mem_load8(p + i)) bscopy(b, p, l, i + 1) }
}
fn bpad(b: i64, t: i64) -> i64 {
  let l = buf_len(b)
  if l >= t { b } else { bz(b, t - l) }
}
fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(4, fd, buf, len, 0, 0, 0)
}

-- Each emit function has <= 12 calls to stay within register limits

fn emit_hdr(o: i64) -> i64 {
  bu32(o, 4277009103) bu32(o, 16777228)
  bu32(o, 0) bu32(o, 2)
  bu32(o, 10) bu32(o, 648)
  bu32(o, 2097285) bu32(o, 0)
}

fn emit_pz1(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72)
  bstr(o, "__PAGEZERO") bz(o, 6)
}
fn emit_pz2(o: i64) -> i64 {
  bu64(o, 0) bu64(o, 4294967296)
  bu64(o, 0) bu64(o, 0)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}

fn emit_ts1(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 152)
  bstr(o, "__TEXT") bz(o, 10)
}
fn emit_ts2(o: i64) -> i64 {
  bu64(o, 4294967296) bu64(o, 32768)
  bu64(o, 0) bu64(o, 32768)
  bu32(o, 5) bu32(o, 5) bu32(o, 1) bu32(o, 0)
}
fn emit_tx1(o: i64) -> i64 {
  bstr(o, "__text") bz(o, 10)
  bstr(o, "__TEXT") bz(o, 10)
}
fn emit_tx2(o: i64) -> i64 {
  bu64(o, 4294983680) bu64(o, 8)
  bu32(o, 16384) bu32(o, 2)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 2147484672) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}

fn emit_ds1(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 152)
  bstr(o, "__DATA") bz(o, 10)
}
fn emit_ds2(o: i64) -> i64 {
  bu64(o, 4295000064) bu64(o, 16384)
  bu64(o, 32768) bu64(o, 0)
  bu32(o, 3) bu32(o, 3) bu32(o, 1) bu32(o, 0)
}
fn emit_dc1(o: i64) -> i64 {
  bstr(o, "__const") bz(o, 9)
  bstr(o, "__DATA") bz(o, 10)
}
fn emit_dc2(o: i64) -> i64 {
  bu64(o, 4295000064) bu64(o, 0)
  bu32(o, 32768) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}

fn emit_le1(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72)
  bstr(o, "__LINKEDIT") bz(o, 6)
}
fn emit_le2(o: i64) -> i64 {
  bu64(o, 4295016448) bu64(o, 16384)
  bu64(o, 32768) bu64(o, 0)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}

fn emit_mn(o: i64) -> i64 {
  bu32(o, 2147483688) bu32(o, 24)
  bu64(o, 16384) bu64(o, 0)
}

fn emit_dl(o: i64) -> i64 {
  bu32(o, 14) bu32(o, 32) bu32(o, 12)
  bstr(o, "/usr/lib/dyld") bz(o, 7)
}

fn emit_lb1(o: i64) -> i64 {
  bu32(o, 12) bu32(o, 56) bu32(o, 24) bu32(o, 0)
  bu32(o, 65536) bu32(o, 65536)
}
fn emit_lb2(o: i64) -> i64 {
  bstr(o, "/usr/lib/libSystem.B.dylib") bz(o, 7)
}

fn emit_di(o: i64) -> i64 {
  bu32(o, 2147483682) bu32(o, 48)
  bu64(o, 0) bu64(o, 0) bu64(o, 0) bu64(o, 0) bu64(o, 0)
}
fn emit_sy(o: i64) -> i64 {
  bu32(o, 2) bu32(o, 24)
  bu64(o, 0) bu64(o, 0)
}
fn emit_cs(o: i64) -> i64 {
  bu32(o, 29) bu32(o, 16) bu32(o, 0) bu32(o, 0)
}

fn emit_lcs_a(o: i64) -> i64 {
  emit_pz1(o) emit_pz2(o)
  emit_ts1(o) emit_ts2(o)
  emit_tx1(o) emit_tx2(o)
}
fn emit_lcs_b(o: i64) -> i64 {
  emit_ds1(o) emit_ds2(o)
  emit_dc1(o) emit_dc2(o)
  emit_le1(o) emit_le2(o)
}
fn emit_lcs_c(o: i64) -> i64 {
  emit_mn(o) emit_dl(o)
  emit_lb1(o) emit_lb2(o)
  emit_di(o) emit_sy(o) emit_cs(o)
}

fn main() -> i64 {
  let o = buf_new(65536)
  emit_hdr(o)
  emit_lcs_a(o)
  emit_lcs_b(o)
  emit_lcs_c(o)
  bpad(o, 16384)
  bu32(o, 1325400064 + 42 * 32)
  bu32(o, 3596809152)
  bpad(o, 32768)
  sys_write(1, buf_ptr(o), buf_len(o))
  0
}
