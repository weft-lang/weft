-- Expected exit code: 0
use "runtime/alloc.weft"
use "runtime/memory.weft"
-- Test: full Mach-O binary emission — produces a binary that exits with code 42
-- IMPORTANT: callees must be defined BEFORE callers (no forward references)

use runtime/syscall.{*}

-- ── Buffer primitives ──
fn buf_new(cap: i64) -> i64 {
  let arena = arena_new(cap + 64)
  let h = arena_alloc(arena, 24, 8)
  let d = arena_alloc(arena, cap, 8)
  mem_store64(h, d)
  mem_store64(h + 8, 0)
  mem_store64(h + 16, cap)
  h
}
fn buf_len(b: i64) -> i64 { mem_load64(b + 8) }
fn buf_ptr(b: i64) -> i64 { mem_load64(b) }
fn bu8(b: i64, v: i64) -> i64 {
  let d = mem_load64(b)
  let l = mem_load64(b + 8)
  mem_store8(d + l, v)
  mem_store64(b + 8, l + 1)
  b
}
fn bu32(b: i64, v: i64) -> i64 {
  bu8(b, v - v / 256 * 256)
  bu8(b, v / 256 - v / 65536 * 256)
  bu8(b, v / 65536 - v / 16777216 * 256)
  bu8(b, v / 16777216 - v / 4294967296 * 256)
}
fn bu64(b: i64, v: i64) -> i64 {
  bu32(b, v - v / 4294967296 * 4294967296)
  bu32(b, v / 4294967296)
}
fn bscopy(b: i64, p: i64, l: i64, i: i64) -> i64 {
  if i >= l { b }
  else { let byte = mem_load8(p + i) bu8(b, byte) bscopy(b, p, l, i + 1) }
}
fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  bscopy(b, p, l, 0)
}
fn bfill_bulk(d: i64, off: i64, rem: i64) -> i64 {
  if rem <= 0 { 0 }
  else {
    if rem >= 8 {
      mem_store64(d + off, 0)
      bfill_bulk(d, off + 8, rem - 8)
    } else {
      mem_store8(d + off, 0)
      bfill_bulk(d, off + 1, rem - 1)
    }
  }
}
fn bfill(b: i64, n: i64) -> i64 {
  if n <= 0 { b }
  else {
    let d = mem_load64(b)
    let l = mem_load64(b + 8)
    bfill_bulk(d, l, n)
    mem_store64(b + 8, l + n)
    b
  }
}
fn bpad(b: i64, t: i64) -> i64 {
  let l = buf_len(b)
  if l >= t { b } else { bfill(b, t - l) }
}

-- ── Mach-O segment emitters (leaf helpers first, then composites) ──

fn emit_hdr(o: i64) -> i64 {
  bu32(o, 4277009103) bu32(o, 16777228) bu32(o, 0) bu32(o, 2)
  bu32(o, 9) bu32(o, 632) bu32(o, 2097285) bu32(o, 0)
}
fn emit_pz2(o: i64) -> i64 {
  bfill(o, 6) bu64(o, 0) bu64(o, 4294967296) bu64(o, 0) bu64(o, 0)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_pz(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__PAGEZERO") emit_pz2(o)
}
fn emit_text_seg2(o: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296) bu64(o, 32768) bu64(o, 0) bu64(o, 32768)
  bu32(o, 5) bu32(o, 5) bu32(o, 1) bu32(o, 0)
}
fn emit_text_seg(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__TEXT") emit_text_seg2(o)
}
fn emit_text_sec2(o: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294983680) bu64(o, 8) bu32(o, 16384) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 2147484672) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_text_sec(o: i64) -> i64 {
  bstr(o, "__text") bfill(o, 10) bstr(o, "__TEXT") emit_text_sec2(o)
}
fn emit_data_seg2(o: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4295000064) bu64(o, 16384) bu64(o, 32768) bu64(o, 0)
  bu32(o, 3) bu32(o, 3) bu32(o, 1) bu32(o, 0)
}
fn emit_data_seg(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__DATA") emit_data_seg2(o)
}
fn emit_data_sec2(o: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4295000064) bu64(o, 0) bu32(o, 32768) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_data_sec(o: i64) -> i64 {
  bstr(o, "__const") bfill(o, 9) bstr(o, "__DATA") emit_data_sec2(o)
}
fn emit_linkedit2(o: i64) -> i64 {
  bfill(o, 6)
  bu64(o, 4295016448) bu64(o, 16384) bu64(o, 32768) bu64(o, 0)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}
fn emit_linkedit(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__LINKEDIT") emit_linkedit2(o)
}
fn emit_main_lc(o: i64) -> i64 {
  bu32(o, 2147483688) bu32(o, 24) bu64(o, 16384) bu64(o, 0)
}
fn emit_dylinker(o: i64) -> i64 {
  bu32(o, 14) bu32(o, 32) bu32(o, 12) bstr(o, "/usr/lib/dyld") bfill(o, 7)
}
fn emit_dylib2(o: i64) -> i64 {
  bstr(o, "/usr/lib/libSystem.B.dylib") bfill(o, 6)
}
fn emit_dylib(o: i64) -> i64 {
  bu32(o, 12) bu32(o, 56) bu32(o, 24) bu32(o, 0)
  bu32(o, 65536) bu32(o, 65536) emit_dylib2(o)
}
fn emit_symtab(o: i64) -> i64 {
  bu32(o, 2) bu32(o, 24) bfill(o, 16)
}
fn emit_dyld_info(o: i64) -> i64 {
  bu32(o, 2147483682) bu32(o, 48) bfill(o, 40)
}
fn emit_codesig(o: i64) -> i64 {
  bu32(o, 29) bu32(o, 16) bu32(o, 32768) bu32(o, 0)
}

-- ── Composite emitters ──
fn emit_segs(o: i64) -> i64 {
  emit_pz(o) emit_text_seg(o) emit_text_sec(o)
  emit_data_seg(o) emit_data_sec(o) emit_linkedit(o)
}
fn emit_lcs(o: i64) -> i64 {
  emit_main_lc(o) emit_symtab(o) emit_dylinker(o) emit_dylib(o)
  emit_dyld_info(o)
}
fn emit_code(o: i64, val: i64) -> i64 {
  bpad(o, 16384)
  bu32(o, 3531603968 + val * 32)
  bu32(o, 3596551104)
  bpad(o, 32768)
}

-- ── Main ──
fn main() -> i64 {
  let o = buf_new(65536)
  emit_hdr(o)
  emit_pz(o)
  emit_text_seg(o)
  emit_text_sec(o)
  emit_data_seg(o)
  emit_data_sec(o)
  emit_linkedit(o)
  emit_lcs(o)
  emit_code(o, 42)
  sys_write(1, buf_ptr(o), buf_len(o))
  0
}
