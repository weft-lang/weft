use stdlib/tcp.{TcpReadinessInvalidated, TcpWouldBlock}
use stdlib/test.{Test}
use stdlib/tls.{TlsNeedInput, TlsTrust}
use stdlib/tls_stream.{*}

fn tls_stream_error_code(error: TlsStreamError) -> i64 {
  match error {
    TlsStreamTcp(TcpWouldBlock) -> 1
    TlsStreamTcp(other) -> 2
    TlsStreamReadiness(TcpReadinessInvalidated) -> 3
    TlsStreamReadiness(other) -> 4
    TlsStreamTls(TlsTrust) -> 5
    TlsStreamTls(other) -> 6
    TlsStreamPlaintextLimit(limit) -> 7
    TlsStreamInvalidProgress -> 8
    TlsStreamUnexpectedStep(TlsNeedInput) -> 9
    TlsStreamUnexpectedStep(other) -> 10
  }
}

test "TLS stream errors preserve transport, readiness, TLS, limit and state detail" {
  Test.assert_eq(tls_stream_error_code(TlsStreamTcp(TcpWouldBlock)), 1)
  Test.assert_eq(tls_stream_error_code(TlsStreamReadiness(TcpReadinessInvalidated)), 3)
  Test.assert_eq(tls_stream_error_code(TlsStreamTls(TlsTrust)), 5)
  Test.assert_eq(tls_stream_error_code(TlsStreamPlaintextLimit(__i64_to_usize(16385))), 7)
  Test.assert_eq(tls_stream_error_code(TlsStreamInvalidProgress), 8)
  Test.assert_eq(tls_stream_error_code(TlsStreamUnexpectedStep(TlsNeedInput)), 9)
}
