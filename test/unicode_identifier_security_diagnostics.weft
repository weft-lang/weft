use compiler/lex.{lex}
use compiler/lib.{src_eq}
use compiler/parse.{parse_diagnose_identifier_security}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_load64_at, mem_store64_at}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_type.{*}
use stdlib/test.{*}

fn identifier_security_code_eq(diagnostic: Diagnostic, expected: str) -> i64 {
  let code = diagnostic_code_text(diagnostic_code(diagnostic))
  src_eq(__str_ptr(code), 0, __str_len(code), expected)
}

-- Result words: total, W0001, W0002, contract score, primary start/end,
-- related count, and legacy-operation count.
fn identifier_security_observe(source: str) -> i64 {
  let observed = alloc_words(8)
  for i in 0..8 { mem_store64_at(observed, i * 8, 0) }
  let tokens = lex(__str_ptr(source), __str_len(source))
  handle parse_diagnose_identifier_security(tokens, __str_ptr(source)) {
    Diagnose.report(diagnostic) -> {
      mem_store64_at(observed, 0, mem_load64_at(observed, 0) + 1)
      if identifier_security_code_eq(diagnostic, "W0001") == 1 {
        mem_store64_at(observed, 8, mem_load64_at(observed, 8) + 1)
      } else { if identifier_security_code_eq(diagnostic, "W0002") == 1 {
        mem_store64_at(observed, 16, mem_load64_at(observed, 16) + 1)
      } else { 0 } }
      let severity_ok = match diagnostic_severity(diagnostic) {
        DiagnosticSeverityWarning -> 1
        _ -> 0
      }
      let class_ok = match diagnostic_class(diagnostic) {
        DiagnosticClassParse -> 1
        _ -> 0
      }
      mem_store64_at(observed, 24, mem_load64_at(observed, 24) + severity_ok + class_ok)
      match diagnostic_primary(diagnostic) {
        DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, end) -> {
          if mem_load64_at(observed, 32) == 0 {
            mem_store64_at(observed, 32, start + 1)
            mem_store64_at(observed, 40, end)
          } else { 0 }
        }
        _ -> 0
      }
      mem_store64_at(observed, 48, mem_load64_at(observed, 48) + diagnostic_related_count(diagnostic_related(diagnostic)))
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
    Diagnose.warn(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
    Diagnose.note(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
  }
  observed
}

test "mixed-script warning is structured exact and deduplicated by spelling" {
  let observed = identifier_security_observe("fn Сirсlе() -> i64 { 42 } fn main() -> i64 { Сirсlе() + Сirсlе() }")
  Test.assert_eq(mem_load64_at(observed, 0), 1)
  Test.assert_eq(mem_load64_at(observed, 8), 1)
  Test.assert_eq(mem_load64_at(observed, 16), 0)
  Test.assert_eq(mem_load64_at(observed, 24), 2)
  Test.assert_eq(mem_load64_at(observed, 32), 4)
  Test.assert_eq(mem_load64_at(observed, 40), 12)
  Test.assert_eq(mem_load64_at(observed, 56), 0)
}

test "confusable warning relates the distinct source spelling" {
  let observed = identifier_security_observe("fn paypal() -> i64 { 20 } fn pаypаl() -> i64 { 22 } fn main() -> i64 { paypal() + pаypаl() }")
  Test.assert_eq(mem_load64_at(observed, 0), 2)
  Test.assert_eq(mem_load64_at(observed, 8), 1)
  Test.assert_eq(mem_load64_at(observed, 16), 1)
  Test.assert_eq(mem_load64_at(observed, 24), 4)
  Test.assert_eq(mem_load64_at(observed, 48), 1)
}

test "confusable scan sees later ASCII spellings" {
  let observed = identifier_security_observe("fn pаypаl() -> i64 { 20 } fn paypal() -> i64 { 22 }")
  Test.assert_eq(mem_load64_at(observed, 16), 1)
  Test.assert_eq(mem_load64_at(observed, 48), 1)
}

test "single-script Unicode and CJK augmentation remain warning-free" {
  let greek = identifier_security_observe("fn πρόσθεση(α: i64, β: i64) -> i64 { α + β }")
  let japanese = identifier_security_observe("fn ねガ() -> i64 { 42 }")
  Test.assert_eq(mem_load64_at(greek, 0), 0)
  Test.assert_eq(mem_load64_at(japanese, 0), 0)
}

test "repeated non-ASCII spelling is not a confusable pair" {
  let observed = identifier_security_observe("fn κόσμος() -> i64 { 1 } fn main() -> i64 { κόσμος() + κόσμος() }")
  Test.assert_eq(mem_load64_at(observed, 0), 0)
}

test "supplementary confusable prototypes participate" {
  let observed = identifier_security_observe("fn 𝐀() -> i64 { 1 } fn A() -> i64 { 2 }")
  Test.assert_eq(mem_load64_at(observed, 8), 0)
  Test.assert_eq(mem_load64_at(observed, 16), 1)
}

test "ASCII-only source remains security-audit inert" {
  let observed = identifier_security_observe("fn main() -> i64 { let value = 42 value }")
  Test.assert_eq(mem_load64_at(observed, 0), 0)
  Test.assert_eq(mem_load64_at(observed, 56), 0)
}
