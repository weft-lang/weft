use compiler/lex.{lex}
use compiler/lib.{src_eq}
use compiler/parse.{parse_diagnose_bidi_source, parse_diagnose_identifier_security}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_copy, mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_len, runtime_str_ptr}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/test.{*}
use stdlib/utf8.{utf8_encode_scalar_into, utf8_scalar_encoded_len}

fn identifier_security_code_eq(diagnostic: Diagnostic, expected: str) -> i64 {
  let code = diagnostic.code().text()
  src_eq(__str_ptr(code), 0, __str_len(code), expected)
}

-- Result words: total, W0001, W0002, contract score, primary start/end,
-- related count, and legacy-operation count.
fn identifier_security_observe(source: str) -> i64 {
  let observed = alloc_words(8)
  for i in 0..8 { mem_store64_at(observed, i * 8, 0) }
  let tokens = lex(__str_ptr(source), __str_len(source))
  handle parse_diagnose_identifier_security(tokens, __str_ptr(source)) {
    Diagnose.report(diagnostic) -> {
      mem_store64_at(observed, 0, mem_load64_at(observed, 0) + 1)
      if identifier_security_code_eq(diagnostic, "W0001") == 1 {
        mem_store64_at(observed, 8, mem_load64_at(observed, 8) + 1)
      } else { if identifier_security_code_eq(diagnostic, "W0002") == 1 {
        mem_store64_at(observed, 16, mem_load64_at(observed, 16) + 1)
      } else { 0 } }
      let severity_ok = match diagnostic.severity() {
        DiagnosticSeverityWarning -> 1
        _ -> 0
      }
      let class_ok = match diagnostic.class() {
        DiagnosticClassParse -> 1
        _ -> 0
      }
      mem_store64_at(observed, 24, mem_load64_at(observed, 24) + severity_ok + class_ok)
      match diagnostic.primary() {
        DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, end) -> {
          if mem_load64_at(observed, 32) == 0 {
            mem_store64_at(observed, 32, start + 1)
            mem_store64_at(observed, 40, end)
          } else { 0 }
        }
        _ -> 0
      }
      mem_store64_at(observed, 48, mem_load64_at(observed, 48) + diagnostic.related().count())
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
    Diagnose.warn(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
    Diagnose.note(message, span) -> { mem_store64_at(observed, 56, mem_load64_at(observed, 56) + 1) resume(0) }
  }
  observed
}

fn source_insert_scalar(prefix: str, scalar: i64, suffix: str) -> str {
  let prefix_len = runtime_str_len(prefix)
  let scalar_len = utf8_scalar_encoded_len(scalar)
  let suffix_len = runtime_str_len(suffix)
  let out = runtime_str_alloc_uninit(prefix_len + scalar_len + suffix_len)
  let ptr = runtime_str_ptr(out)
  mem_copy(ptr, runtime_str_ptr(prefix), prefix_len)
  let next = utf8_encode_scalar_into(ptr, prefix_len, scalar)
  mem_copy(ptr + next, runtime_str_ptr(suffix), suffix_len)
  out
}

fn bidi_formatting_at(index: i64) -> i64 {
  match index {
    0 -> 8234
    1 -> 8235
    2 -> 8236
    3 -> 8237
    4 -> 8238
    5 -> 8294
    6 -> 8295
    7 -> 8296
    _ -> 8297
  }
}

-- Result words: total, contract score, primary start/end, string contexts,
-- comment contexts, and legacy-operation count.
fn bidi_source_observe(source: str) -> i64 {
  let observed = alloc_words(7)
  for i in 0..7 { mem_store64_at(observed, i * 8, 0) }
  let tokens = lex(runtime_str_ptr(source), runtime_str_len(source))
  handle parse_diagnose_bidi_source(tokens, runtime_str_ptr(source)) {
    Diagnose.report(diagnostic) -> {
      mem_store64_at(observed, 0, mem_load64_at(observed, 0) + 1)
      let code_ok = identifier_security_code_eq(diagnostic, "W0003")
      let severity_ok = match diagnostic.severity() {
        DiagnosticSeverityWarning -> 1
        _ -> 0
      }
      let class_ok = match diagnostic.class() {
        DiagnosticClassParse -> 1
        _ -> 0
      }
      mem_store64_at(observed, 8, mem_load64_at(observed, 8) + code_ok + severity_ok + class_ok)
      match diagnostic.primary() {
        DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, end) -> {
          if mem_load64_at(observed, 16) == 0 {
            mem_store64_at(observed, 16, start + 1)
            mem_store64_at(observed, 24, end)
          } else { 0 }
        }
        _ -> 0
      }
      match diagnostic.fields() {
        DiagnosticFieldCons(DiagnosticFieldText(name, value), rest) -> {
          if src_eq(runtime_str_ptr(value), 0, runtime_str_len(value), "string") == 1 {
            mem_store64_at(observed, 32, mem_load64_at(observed, 32) + 1)
          } else { if src_eq(runtime_str_ptr(value), 0, runtime_str_len(value), "comment") == 1 {
            mem_store64_at(observed, 40, mem_load64_at(observed, 40) + 1)
          } else { 0 } }
        }
        _ -> 0
      }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observed, 48, mem_load64_at(observed, 48) + 1) resume(0) }
    Diagnose.warn(message, span) -> { mem_store64_at(observed, 48, mem_load64_at(observed, 48) + 1) resume(0) }
    Diagnose.note(message, span) -> { mem_store64_at(observed, 48, mem_load64_at(observed, 48) + 1) resume(0) }
  }
  observed
}

test "mixed-script warning is structured exact and deduplicated by spelling" {
  let observed = identifier_security_observe("fn Сirсlе() -> i64 { 42 } fn main() -> i64 { Сirсlе() + Сirсlе() }")
  Test.assert_eq(mem_load64_at(observed, 0), 1)
  Test.assert_eq(mem_load64_at(observed, 8), 1)
  Test.assert_eq(mem_load64_at(observed, 16), 0)
  Test.assert_eq(mem_load64_at(observed, 24), 2)
  Test.assert_eq(mem_load64_at(observed, 32), 4)
  Test.assert_eq(mem_load64_at(observed, 40), 12)
  Test.assert_eq(mem_load64_at(observed, 56), 0)
}

test "confusable warning relates the distinct source spelling" {
  let observed = identifier_security_observe("fn paypal() -> i64 { 20 } fn pаypаl() -> i64 { 22 } fn main() -> i64 { paypal() + pаypаl() }")
  Test.assert_eq(mem_load64_at(observed, 0), 2)
  Test.assert_eq(mem_load64_at(observed, 8), 1)
  Test.assert_eq(mem_load64_at(observed, 16), 1)
  Test.assert_eq(mem_load64_at(observed, 24), 4)
  Test.assert_eq(mem_load64_at(observed, 48), 1)
}

test "confusable scan sees later ASCII spellings" {
  let observed = identifier_security_observe("fn pаypаl() -> i64 { 20 } fn paypal() -> i64 { 22 }")
  Test.assert_eq(mem_load64_at(observed, 16), 1)
  Test.assert_eq(mem_load64_at(observed, 48), 1)
}

test "single-script Unicode and CJK augmentation remain warning-free" {
  let greek = identifier_security_observe("fn πρόσθεση(α: i64, β: i64) -> i64 { α + β }")
  let japanese = identifier_security_observe("fn ねガ() -> i64 { 42 }")
  Test.assert_eq(mem_load64_at(greek, 0), 0)
  Test.assert_eq(mem_load64_at(japanese, 0), 0)
}

test "repeated non-ASCII spelling is not a confusable pair" {
  let observed = identifier_security_observe("fn κόσμος() -> i64 { 1 } fn main() -> i64 { κόσμος() + κόσμος() }")
  Test.assert_eq(mem_load64_at(observed, 0), 0)
}

test "supplementary confusable prototypes participate" {
  let observed = identifier_security_observe("fn 𝐀() -> i64 { 1 } fn A() -> i64 { 2 }")
  Test.assert_eq(mem_load64_at(observed, 8), 0)
  Test.assert_eq(mem_load64_at(observed, 16), 1)
}

test "ASCII-only source remains security-audit inert" {
  let observed = identifier_security_observe("fn main() -> i64 { let value = 42 value }")
  Test.assert_eq(mem_load64_at(observed, 0), 0)
  Test.assert_eq(mem_load64_at(observed, 56), 0)
}

test "all explicit bidi formatting controls warn inside strings" {
  for i in 0..9 {
    let source = source_insert_scalar("fn main() -> str { \"abc", bidi_formatting_at(i), "def\" }")
    let observed = bidi_source_observe(source)
    Test.assert_eq(mem_load64_at(observed, 0), 1)
    Test.assert_eq(mem_load64_at(observed, 8), 3)
    Test.assert_eq(mem_load64_at(observed, 32), 1)
    Test.assert_eq(mem_load64_at(observed, 40), 0)
    Test.assert_eq(mem_load64_at(observed, 48), 0)
  }
}

test "bidi warning preserves exact string control range" {
  let source = source_insert_scalar("fn main() -> str { \"abc", 8238, "def\" }")
  let observed = bidi_source_observe(source)
  Test.assert_eq(mem_load64_at(observed, 16), 24)
  Test.assert_eq(mem_load64_at(observed, 24), 26)
}

test "bidi warning scans lexer-owned comment trivia" {
  let source = source_insert_scalar("-- abc", 8294, "def\nfn main() -> i64 { 42 }")
  let observed = bidi_source_observe(source)
  Test.assert_eq(mem_load64_at(observed, 0), 1)
  Test.assert_eq(mem_load64_at(observed, 8), 3)
  Test.assert_eq(mem_load64_at(observed, 16), 7)
  Test.assert_eq(mem_load64_at(observed, 24), 9)
  Test.assert_eq(mem_load64_at(observed, 32), 0)
  Test.assert_eq(mem_load64_at(observed, 40), 1)
}

test "each literal bidi control receives an exact warning" {
  let first = source_insert_scalar("fn main() -> str { \"", 8238, "")
  let source = source_insert_scalar(first, 8297, "\" }")
  let observed = bidi_source_observe(source)
  Test.assert_eq(mem_load64_at(observed, 0), 2)
  Test.assert_eq(mem_load64_at(observed, 8), 6)
  Test.assert_eq(mem_load64_at(observed, 32), 2)
}

test "ordinary RTL text and directional marks remain warning-free" {
  let hebrew = bidi_source_observe("fn main() -> str { \"שלום\" }")
  let lrm = bidi_source_observe(source_insert_scalar("fn main() -> str { \"abc", 8206, "def\" }"))
  let rlm = bidi_source_observe(source_insert_scalar("-- abc", 8207, "def\nfn main() -> i64 { 42 }"))
  let alm = bidi_source_observe(source_insert_scalar("fn main() -> str { \"abc", 1564, "def\" }"))
  Test.assert_eq(mem_load64_at(hebrew, 0), 0)
  Test.assert_eq(mem_load64_at(lrm, 0), 0)
  Test.assert_eq(mem_load64_at(rlm, 0), 0)
  Test.assert_eq(mem_load64_at(alm, 0), 0)
}
