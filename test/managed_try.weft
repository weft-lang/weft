use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_load, runtime_rc_probe_new}
use stdlib/fail.{Fail}
use stdlib/drop.{Drop}
use stdlib/option.{Option}
use stdlib/result.{Result, Ok, Err}
use stdlib/test.{Test}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_push}

fn managed_try_ok(value: RuntimeRcProbe) -> Result<RuntimeRcProbe, i64> {
  Ok<RuntimeRcProbe, i64>(value)
}

fn managed_try_unwrap(value: RuntimeRcProbe) -[Fail<i64>]> RuntimeRcProbe {
  managed_try_ok(value)?
}

fn managed_try_record(value: RuntimeRcProbe, output: borrow mut Vector<RuntimeRcProbe>) -[Fail<i64>]> i64 {
  let extracted = managed_try_ok(value)?
  output.push(extracted)
  Fail<i64>.fail(9)
}

fn managed_try_record_argument(value: RuntimeRcProbe, output: borrow mut Vector<RuntimeRcProbe>) -[Fail<i64>]> i64 {
  output.push(managed_try_ok(value)?)
  return 42
}

test "managed extraction passed directly as an argument transfers once" {
  let value = runtime_rc_probe_new(42)
  let mut output = vector.new<RuntimeRcProbe>()
  let status = handle managed_try_record_argument(value, output) {
    Fail<i64>.fail(error) -> error
  }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

fn managed_try_record_generic_argument(value: RuntimeRcProbe, output: borrow Vector<RuntimeRcProbe>) -[Fail<i64>]> i64 {
  vector_push<RuntimeRcProbe>(output, managed_try_ok(value)?)
  return 42
}

test "managed extraction passed to a generic call transfers once" {
  let value = runtime_rc_probe_new(42)
  let output = vector.new<RuntimeRcProbe>()
  let status = handle managed_try_record_generic_argument(value, output) {
    Fail<i64>.fail(error) -> error
  }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

effect ManagedTrySource {
  fn get() -> Result<RuntimeRcProbe, i64>
}

fn managed_try_record_effect(output: borrow mut Vector<RuntimeRcProbe>) -[ManagedTrySource, Fail<i64>]> i64 {
  let extracted = ManagedTrySource.get()?
  output.push(extracted)
  Fail<i64>.fail(9)
}

test "managed extraction from an effect result survives abort" {
  let value = runtime_rc_probe_new(42)
  let mut output = vector.new<RuntimeRcProbe>()
  let status = handle {
    handle managed_try_record_effect(output) {
      ManagedTrySource.get() -> resume(managed_try_ok(value))
    }
  } {
    Fail<i64>.fail(error) -> error
  }
  Test.assert_eq(status, 9)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "temporary Result extraction balances its parent and payload" {
  let value = runtime_rc_probe_new(42)
  let result = handle managed_try_unwrap(value) {
    Fail<i64>.fail(error) -> runtime_rc_probe_new(error)
  }
  Test.assert_eq(runtime_rc_probe_load(result), 42)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "managed success remains owned after a later abort" {
  let value = runtime_rc_probe_new(42)
  let mut output = vector.new<RuntimeRcProbe>()
  let status = handle managed_try_record(value, output) {
    Fail<i64>.fail(error) -> error
  }
  Test.assert_eq(status, 9)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  let extracted = output.get(0).expect("recorded payload")
  let later = runtime_rc_probe_new(73)
  Test.assert_eq(runtime_rc_probe_load(extracted), 42)
  Test.assert_eq(runtime_rc_probe_load(later), 73)
}

fn managed_try_repeat(value: RuntimeRcProbe) -[Fail<i64>]> i64 {
  let result = managed_try_ok(value)
  let first = result?
  let second = result?
  runtime_rc_probe_load(first) + runtime_rc_probe_load(second)
}

test "repeated extraction preserves a retained Result owner" {
  let value = runtime_rc_probe_new(21)
  let total = handle managed_try_repeat(value) { Fail<i64>.fail(error) -> error }
  Test.assert_eq(total, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

fn managed_try_error(value: RuntimeRcProbe) -> Result<i64, RuntimeRcProbe> {
  Err<i64, RuntimeRcProbe>(value)
}

fn managed_try_propagate(value: RuntimeRcProbe) -[Fail<RuntimeRcProbe>]> i64 {
  managed_try_error(value)?
}

test "managed error transfers its reference into an abort clause" {
  let value = runtime_rc_probe_new(42)
  let result = handle managed_try_propagate(value) {
    Fail<RuntimeRcProbe>.fail(error) -> runtime_rc_probe_load(error)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "managed error can escape its abort clause" {
  let value = runtime_rc_probe_new(42)
  let result = handle {
    managed_try_propagate(value)
    runtime_rc_probe_new(0)
  } {
    Fail<RuntimeRcProbe>.fail(error) -> error
  }
  Test.assert_eq(runtime_rc_probe_load(result), 42)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

type ManagedTryResource { ManagedTryResource }
impl Drop for ManagedTryResource { fn drop(self: Self) -> nil { nil } }

fn managed_try_fail_resource(value: RuntimeRcProbe) -> Result<owned ManagedTryResource, i64> {
  Err<owned ManagedTryResource, i64>(runtime_rc_probe_load(value))
}

fn managed_try_record_then_linear_error(value: RuntimeRcProbe, output: borrow mut Vector<RuntimeRcProbe>) -[Fail<i64>]> i64 {
  let extracted = managed_try_ok(value)?
  output.push(extracted)
  let resource = managed_try_fail_resource(extracted)?
  0
}

test "a later linear Result error cleans only its own managed argument stake" {
  let value = runtime_rc_probe_new(42)
  let mut output = vector.new<RuntimeRcProbe>()
  let status = handle managed_try_record_then_linear_error(value, output) {
    Fail<i64>.fail(error) -> error
  }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}
