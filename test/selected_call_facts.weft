use module_fixtures/compiler_probe.{require_checked}
use compiler/weft/products.{TypedModule}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/types/algebra.{*}
use stdlib/list.{Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{Option, Some, None}
use stdlib/test.{Test}

fn selected_fixture() -> IrFunction {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrConstI64(3, 0), IrInstCons(IrBinaryI64(4, IrEq, 1, 3), IrInstNil)), IrTermBranch(4, 2, 3)),
    IrBlockListCons(IrBlock(2, IrValueNil,
      IrInstCons(IrConstI64(5, 10), IrInstCons(IrBinaryI64(6, IrSub, 5, 2), IrInstNil)), IrTermJump(4, IrValueCons(6, IrValueNil))),
    IrBlockListCons(IrBlock(3, IrValueNil,
      IrInstCons(IrCallI64(7, 999, IrValueCons(0, IrValueNil)), IrInstNil), IrTermJump(4, IrValueCons(7, IrValueNil))),
    IrBlockListCons(IrBlock(4, IrValueCons(8, IrValueNil), IrInstNil, IrTermReturn(8)), IrBlockListNil))))
  IrFunction(12345, 3, blocks, 0)
}

fn selected_fixture_constants(mode: i64, value: i64) -> PipelineIrConstEnv {
  pipeline_ir_const_env_empty() |> pipeline_ir_const_env_bind(10, mode) |> pipeline_ir_const_env_bind(11, value)
}

fn selected_fixture_call() -> IrInst { IrCallI64(20, 12345, IrValueCons(12, IrValueCons(10, IrValueCons(11, IrValueNil)))) }
fn selected_fixture_candidates() -> Map<i64, IrFunction> { map.new<i64, IrFunction>().insert(12345, selected_fixture()) }

test "direct-call authority preserves native dispatch priority and ordinary bodies" {
  let numeric = pipeline_ir_native_intrinsic_f64_sqrt_hash()
  Test.assert_true(match pipeline_ir_native_direct_call_target(pipeline_ir_pseudo_par_lowering_marker_hash(), 0, 7) { PipelineIrNativeDirectMarker -> true, _ -> false })
  Test.assert_true(match pipeline_ir_native_direct_call_target(numeric, 1, 7) { PipelineIrNativeDirectIntrinsic(32) -> true, _ -> false })
  Test.assert_true(match pipeline_ir_native_direct_call_target(pipeline_ir_vector_len_hash(), 1, 7) { PipelineIrNativeDirectVectorLength -> true, _ -> false })
  Test.assert_true(match pipeline_ir_native_direct_call_target(pipeline_ir_vector_len_hash(), 2, 7) { PipelineIrNativeDirectExternal(7) -> true, _ -> false })
  let got = pipeline_ir_native_hash_name("__got_posix_spawn")
  Test.assert_true(match pipeline_ir_native_direct_call_target(got, 6, 0) { PipelineIrNativeDirectGot(0) -> true, _ -> false })
  Test.assert_true(match pipeline_ir_native_direct_call_target(got, 6, 7) { PipelineIrNativeDirectExternal(7) -> true, _ -> false })
  Test.assert_true(match pipeline_ir_native_direct_call_target(pipeline_ir_native_hash_name("sqrt"), 1, 0) { PipelineIrNativeDirectBody -> true, _ -> false })
}

test "selected signatures require exact checked primitive types and existing facts" {
  let source = "fn pick(value: i64, mode: i64, other: i64) -> i64 { 0 }
    fn text(value: str) -> i64 { 0 }
    fn finite(value: usize) -> i64 { 0 }
    fn generic<T>(value: T) -> i64 { 0 }
    fn floating(value: i64) -> f64 { 0.0 }
    fn borrowed(value: borrow str) -> i64 { 0 }"
  match require_checked(pipeline_check_source_standalone(__str_ptr(source), __str_len(source))) {
    TypedModule(fns, _, tt, owners) -> {
      let facts = pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt)
      let pick = pipeline_ir_native_hash_name("pick")
      Test.assert_true(pipeline_ir_selected_signature(fns, facts, tt, pick, 3))
      for count in [0, 2, 4, 17, 0 - 1] { Test.assert_false(pipeline_ir_selected_signature(fns, facts, tt, pick, count)) }
      Test.assert_false(pipeline_ir_selected_signature(fns, PipelineIrSemanticFactNil, tt, pick, 3))
      Test.assert_false(pipeline_ir_selected_signature(fns, facts, 0, pick, 3))
      for name in ["text", "finite", "generic", "floating", "borrowed", "missing"] {
        Test.assert_false(pipeline_ir_selected_signature(fns, facts, tt, pipeline_ir_native_hash_name(name), 1))
      }
    }
  }
}

test "known selected paths transport block arguments and preserve operand order" {
  let candidates = selected_fixture_candidates()
  for (input, expected) in [(3, 7), (0 - 5, 15), (11, 0 - 1)] {
    Test.assert_true(match pipeline_ir_selected_call_result(selected_fixture_call(), candidates, selected_fixture_constants(0, input)) {
      Some(value) -> value == expected
      None -> false
    })
  }
  for mode in [1, 2, 0 - 1] {
    Test.assert_true(match pipeline_ir_selected_call_result(selected_fixture_call(), candidates, selected_fixture_constants(mode, 3)) { None -> true, _ -> false })
  }
  Test.assert_true(match pipeline_ir_selected_call_result(selected_fixture_call(), candidates, pipeline_ir_const_env_empty()) { None -> true, _ -> false })
  Test.assert_true(match pipeline_ir_selected_call_result(IrCallI64(20, 12345, IrValueCons(10, IrValueNil)), candidates, selected_fixture_constants(0, 3)) { None -> true, _ -> false })
  Test.assert_true(match pipeline_ir_selected_call_result(IrGenericCallI64(20, 12345, TypeExprListNil, IrValueCons(10, IrValueNil)), candidates, selected_fixture_constants(0, 3)) { None -> true, _ -> false })
}

test "selected arithmetic consumes canonical wrapping and unsupported-operation semantics" {
  for operation in [IrAdd, IrSub, IrMul, IrEq, IrNe, IrLt, IrGt, IrLe, IrGe, IrAnd, IrOr, IrDiv, IrMod, IrBshl, IrBshr, IrBinaryUnknown] {
    for (left, right) in [(39, 7), (9223372036854775807, 1), (3, 0), (0 - 7, 2)] {
      let env = pipeline_ir_const_env_empty() |> pipeline_ir_const_env_bind(0, left) |> pipeline_ir_const_env_bind(1, right)
      let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(IrBinaryI64(2, operation, 0, 1), IrInstNil), IrTermReturn(2)), IrBlockListNil)
      let expected = pipeline_ir_const_eval(operation, left, right)
      let result = pipeline_ir_selected_path(blocks, 0, IrValueNil, env, Nil<i64>(), 12)
      Test.assert_true(match expected {
        PipelineIrConstLookup(1, value) -> match result { Some(actual) -> actual == value, None -> false }
        _ -> match result { None -> true, _ -> false }
      })
    }
  }
}

test "selected paths stop at memory effects allocation ownership and unsupported metadata" {
  for barrier in [IrCallI64(3, 999, IrValueNil), IrPerformI64(3, 1, 2, IrValueNil),
    IrPtrLoadI64(3, 0, IrStorageWord64), IrPtrStoreI64(3, 0, 1, IrStorageWord64),
    IrVectorSetI64(3, 0, 1, 2, 0), IrArrayStorageI64(3, 8, 8),
    IrManagedStakeI64(3, 0, 1, 0 - 1, 1), IrOwnedDropI64(0, 123),
    IrBindI64(0, 0, 0, ty_str()), IrBindI64(0, 0, 0, ty_owned(ty_i64())),
    IrFloatBinaryI64(3, PRIM_F64(), IrAdd, 0, 1)] {
    let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstCons(barrier, IrInstCons(IrConstI64(4, 7), IrInstNil)), IrTermReturn(4)), IrBlockListNil)
    Test.assert_true(match pipeline_ir_selected_path(blocks, 0, IrValueNil, pipeline_ir_const_env_empty(), Nil<i64>(), 12) { None -> true, _ -> false })
  }
}

test "unknown control cycles missing blocks and malformed edges remain opaque" {
  for term in [IrTermJump(0, IrValueNil), IrTermJump(9, IrValueNil), IrTermBranch(0, 0, 0), IrTermUnreachable, IrTermNone] {
    let blocks = IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, term), IrBlockListNil)
    Test.assert_true(match pipeline_ir_selected_path(blocks, 0, IrValueNil, pipeline_ir_const_env_empty(), Nil<i64>(), 12) { None -> true, _ -> false })
  }
  let blocks = IrBlockListCons(IrBlock(0, IrValueCons(1, IrValueNil), IrInstNil, IrTermReturn(1)), IrBlockListNil)
  Test.assert_true(match pipeline_ir_selected_path(blocks, 0, IrValueNil, pipeline_ir_const_env_empty(), Nil<i64>(), 12) { None -> true, _ -> false })
  Test.assert_true(match pipeline_ir_selected_path(blocks, 0, IrValueCons(10, IrValueNil), selected_fixture_constants(0, 3), Nil<i64>(), 0) { None -> true, _ -> false })
}

test "selected call facts replace only the call and preserve caller effects and cleanup" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrConstI64(3, 0), IrInstCons(IrConstI64(4, 3),
    IrInstCons(IrPerformI64(5, 1, 2, IrValueNil),
    IrInstCons(IrCallI64(6, 12345, IrValueCons(5, IrValueCons(3, IrValueCons(4, IrValueNil)))),
    IrInstCons(IrOwnedDropI64(0, 777), IrInstNil))))), IrTermReturn(6)), IrBlockListNil)
  let facts = pipeline_ir_selected_call_facts(blocks, selected_fixture_candidates())
  Test.assert_true(pipeline_ir_selected_call_count(facts) == 1)
  let rewritten = pipeline_ir_selected_call_apply(facts)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(111, 3, rewritten, 0)), 0)
  Test.assert_true(match rewritten {
    IrBlockListCons(IrBlock(_, _, IrInstCons(_, IrInstCons(_, IrInstCons(IrPerformI64(5, 1, 2, IrValueNil),
      IrInstCons(IrConstI64(6, 7), IrInstCons(IrOwnedDropI64(0, 777), IrInstNil))))), IrTermReturn(6)), IrBlockListNil) -> true
    _ -> false
  })
  Test.assert_true(pipeline_ir_selected_call_count(pipeline_ir_selected_call_facts(blocks, map.new<i64, IrFunction>())) == 0)
}
