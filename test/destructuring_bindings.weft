type DestructurePoint {
  x: i64,
  y: i64,
}

fn destructure_record(value: DestructurePoint) -> i64 {
  let {y: right, x} = value
  x + right
}

fn destructure_tuple(value: (i64, i64)) -> i64 {
  let (left, right): (i64, i64) = value
  left + right
}

fn destructure_for_tuples(values: [(i64, i64); 3]) -> i64 {
  let mut total = 0
  for (left, right) in values {
    total = total + left + right
  }
  total
}

fn destructure_for_local_tuples() -> i64 {
  let values = [(10, 4), (8, 6), (7, 7)]
  let mut total = 0
  for (left, right) in values {
    total = total + left + right
  }
  total
}

fn destructure_nested(value: ((i64, i64), {tail: i64})) -> i64 {
  let ((left, middle), {tail}) = value
  left + middle + tail
}

fn destructure_for_nested_products() -> i64 {
  let values = [({x: 10, y: 4}, 7), ({x: 8, y: 6}, 7)]
  let mut total = 0
  for ({y, x}, tail) in values {
    total = total + x + y + tail
  }
  total
}

fn destructure_for_wildcard_range() -> i64 {
  let mut visits = 0
  for _ in 0..3 {
    visits = visits + 14
  }
  visits
}

test "destructuring let binds record fields" {
  Test.assert_eq(destructure_record(DestructurePoint { x: 20, y: 22 }), 42)
}

test "destructuring let accepts a whole-pattern annotation" {
  Test.assert_eq(destructure_tuple((20, 22)), 42)
}

test "destructuring for reuses aggregate item transport" {
  Test.assert_eq(destructure_for_tuples([(10, 4), (8, 6), (7, 7)]), 42)
}

test "destructuring for retains the indexed runtime dependency" {
  Test.assert_eq(destructure_for_local_tuples(), 42)
}

test "destructuring bindings recurse through tuple and record products" {
  Test.assert_eq(destructure_nested(((10, 12), {tail: 20})), 42)
}

test "destructuring for transports recursively nested products" {
  Test.assert_eq(destructure_for_nested_products(), 42)
}

test "wildcard for binders work on ranges" {
  Test.assert_eq(destructure_for_wildcard_range(), 42)
}
