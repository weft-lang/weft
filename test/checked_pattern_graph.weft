-- Checked patterns and match arms retain semantic identity without raw nodes.

use compiler/project/identity.{
  ConstructorDeclaration,
  DeclarationIdentity,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  ModuleFunctionIdentity,
  ModuleIdentity,
  RecordFieldDeclaration,
  TypeDeclaration,
  named_module_identity
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{
  SemanticBool,
  SemanticI64,
  SemanticNil,
  SemanticTypeId,
  semantic_type_graph_builder,
  semantic_type_id_eq,
  semantic_type_id_from_ordinal,
  semantic_type_segment_id
}
use compiler/types/graph/catalog.{
  SemanticTypeCatalog,
  SemanticTypeCatalogInserted,
  semantic_type_catalog_builder,
  semantic_type_catalog_single
}
use compiler/weft/check/body/graph.{*}
use compiler/weft/check/body/pattern.{*}
use stdlib/panic.{panic}
use stdlib/test.{Test}

fn types(module: ModuleIdentity) -> SemanticTypeCatalog {
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (builder, _) = builder.primitive(SemanticI64)
  let (builder, _) = builder.primitive(SemanticBool)
  let (builder, _) = builder.primitive(SemanticNil)
  semantic_type_catalog_single(builder.freeze())
}

fn integer_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 0)
}

fn boolean_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 1)
}

fn nil_type(module: ModuleIdentity) -> SemanticTypeId {
  semantic_type_id_from_ordinal(semantic_type_segment_id(module), 2)
}

fn range(start: usize, end: usize) -> CheckedSourceRange {
  CheckedSourceRange { start: start, end: end }
}

fn type_declaration(module: ModuleIdentity) -> DeclarationIdentity {
  ModuleDeclarationIdentity(module, TypeDeclaration, source_from_text("Choice").all())
}

fn pattern_kind_code(kind: CheckedPatternKind) -> i64 {
  match kind {
    CheckedWildcardPatternKind -> 1
    CheckedBindingPatternKind -> 2
    CheckedIntegerPatternKind -> 3
    CheckedConstructorPatternKind -> 4
    CheckedTypedBindingPatternKind -> 5
    CheckedNilPatternKind -> 6
    CheckedRecordPatternKind -> 7
    CheckedTuplePatternKind -> 8
  }
}

test "checked scalar patterns retain bindings types and literal origins" {
  let module = named_module_identity("fixture/pattern_scalars", 71)
  let source = source_from_text("fixture")
  let catalog = types(module)
  let integer = integer_type(module)
  let boolean = boolean_type(module)
  let nil_value = nil_type(module)
  let function = ModuleFunctionIdentity(module, 0)
  let expressions = checked_expr_graph_builder(module, source, catalog, 1)
  let (expressions, binding) = expressions.binding(
    function,
    integer,
    range(0, 1),
    CheckedImmutableBinding
  )
  let patterns = checked_pattern_graph_builder(expressions.segment(), source, catalog)
  let (patterns, wildcard) = patterns.wildcard(integer, range(0, 1))
  let (patterns, bound) = patterns.binding(expressions, binding, integer, range(1, 2))
  let (patterns, numeric) = patterns.integer(
    17,
    CheckedNumericPattern,
    integer,
    range(2, 3)
  )
  let (patterns, boolean_pattern) = patterns.integer(
    1,
    CheckedBooleanPattern,
    boolean,
    range(3, 4)
  )
  let (patterns, typed) = patterns.typed_binding(
    expressions,
    binding,
    integer,
    true,
    integer,
    range(4, 5)
  )
  let (patterns, nil_pattern) = patterns.nil_pattern(nil_value, range(5, 6))
  let graph = patterns.freeze()

  Test.assert_eq(pattern_kind_code(graph.kind(wildcard)), 1)
  Test.assert_eq(pattern_kind_code(graph.kind(bound)), 2)
  Test.assert_eq(pattern_kind_code(graph.kind(numeric)), 3)
  Test.assert_eq(pattern_kind_code(graph.kind(boolean_pattern)), 3)
  Test.assert_eq(pattern_kind_code(graph.kind(typed)), 5)
  Test.assert_eq(pattern_kind_code(graph.kind(nil_pattern)), 6)
  Test.assert_true(checked_binding_id_eq(graph.binding(bound), binding))
  Test.assert_true(semantic_type_id_eq(graph.input_type(boolean_pattern), boolean))
  Test.assert_true(
    match graph.integer_parts(numeric) {
      (17, CheckedNumericPattern) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match graph.typed_binding_parts(typed) {
      (found, annotation) ->
        checked_binding_id_eq(found, binding) and semantic_type_id_eq(annotation, integer)
    }
  )
  Test.assert_true(graph.typed_binding_tests_nil(typed))
  Test.assert_true(
    match graph.inspect(nil_pattern).node { CheckedNilPatternNode -> true, _ -> false }
  )
}

test "constructor and tuple patterns retain exact children and qualifiers" {
  let module = named_module_identity("fixture/pattern_lists", 71)
  let source = source_from_text("fixture")
  let catalog = types(module)
  let integer = integer_type(module)
  let expressions = checked_expr_graph_builder(module, source, catalog, 1)
  let patterns = checked_pattern_graph_builder(expressions.segment(), source, catalog)
  let (patterns, first) = patterns.wildcard(integer, range(0, 1))
  let (patterns, second) = patterns.integer(
    2,
    CheckedNumericPattern,
    integer,
    range(1, 2)
  )
  let (patterns, children) = patterns.pattern_list()
  let (patterns, children) = patterns.pattern_list_push(children, first)
  let (patterns, children) = patterns.pattern_list_push(children, second)
  let (patterns, children) = patterns.pattern_list_finish(children)
  let owner = type_declaration(module)
  let constructor = MemberDeclarationIdentity(
    owner,
    ConstructorDeclaration,
    source_from_text("Some").all()
  )
  let (patterns, constructed) = patterns.constructor(
    constructor,
    children,
    range(0, 3),
    integer,
    range(0, 4)
  )
  let (patterns, tuple) = patterns.tuple(children, integer, range(0, 4))
  let graph = patterns.freeze()

  Test.assert_eq(pattern_kind_code(graph.kind(constructed)), 4)
  Test.assert_eq(pattern_kind_code(graph.kind(tuple)), 8)
  Test.assert_eq_usize(graph.pattern_list_len(children), 2)
  Test.assert_true(checked_pattern_id_eq(graph.pattern_list_at(children, 0), first))
  Test.assert_true(checked_pattern_id_eq(graph.pattern_list_at(children, 1), second))
  Test.assert_true(
    match graph.constructor_parts(constructed) {
      (found, found_children, qualifier) ->
        declaration_identity_eq(found, constructor) and
        graph.pattern_list_len(found_children) == 2 and
        match qualifier {
          found_range: CheckedSourceRange -> found_range.start == 0 and found_range.end == 3
          nil -> false
        }
    }
  )
}

test "record patterns retain exact declared and structural field facts" {
  let module = named_module_identity("fixture/pattern_fields", 71)
  let source = source_from_text("fixture")
  let catalog = types(module)
  let integer = integer_type(module)
  let expressions = checked_expr_graph_builder(module, source, catalog, 1)
  let patterns = checked_pattern_graph_builder(expressions.segment(), source, catalog)
  let (patterns, declared_child) = patterns.wildcard(integer, range(0, 1))
  let (patterns, structural_child) = patterns.integer(
    3,
    CheckedNumericPattern,
    integer,
    range(1, 2)
  )
  let field = MemberDeclarationIdentity(
    type_declaration(module),
    RecordFieldDeclaration,
    source_from_text("value").all()
  )
  let (patterns, fields) = patterns.pattern_field_list()
  let (patterns, fields) = patterns.declared_pattern_field(
    fields,
    field,
    declared_child,
    2,
    integer
  )
  let (patterns, fields) = patterns.structural_pattern_field(
    fields,
    991,
    structural_child,
    CheckedPatternFieldWordOffset(4),
    integer
  )
  let (patterns, fields) = patterns.structural_pattern_field(
    fields,
    992,
    structural_child,
    CheckedPatternFieldUnplaced("target"),
    integer
  )
  let (patterns, fields) = patterns.pattern_field_list_finish(fields)
  let (patterns, record) = patterns.record(fields, integer, range(0, 4))
  let graph = patterns.freeze()
  let declared = graph.pattern_field_list_at(fields, 0)
  let structural = graph.pattern_field_list_at(fields, 1)

  Test.assert_eq(pattern_kind_code(graph.kind(record)), 7)
  Test.assert_eq_usize(graph.pattern_field_list_len(fields), 3)
  Test.assert_true(
    match declared.declaration {
      found: DeclarationIdentity -> declaration_identity_eq(found, field)
      nil -> false
    }
  )
  Test.assert_true(
    match declared.position { CheckedPatternFieldOrdinal(2) -> true, _ -> false }
  )
  Test.assert_true(checked_pattern_id_eq(declared.pattern, declared_child))
  Test.assert_eq(structural.stable_key, 991)
  Test.assert_true(
    match structural.position { CheckedPatternFieldWordOffset(4) -> true, _ -> false }
  )
  Test.assert_true(checked_pattern_id_eq(structural.pattern, structural_child))
  Test.assert_true(semantic_type_id_eq(structural.value_type, integer))
  let unplaced = graph.pattern_field_list_at(fields, 2)
  Test.assert_true(
    match unplaced.position { CheckedPatternFieldUnplaced(name) -> name == "target", _ -> false }
  )
}

test "checked patterns retain imported semantic type segments" {
  let module = named_module_identity("fixture/pattern_import", 71)
  let dependency = named_module_identity("dependency/pattern_type", 44)
  let dependency_builder = semantic_type_graph_builder(semantic_type_segment_id(dependency))
  let (dependency_builder, imported) = dependency_builder.primitive(SemanticI64)
  let local_builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (local_builder, _) = local_builder.primitive(SemanticNil)
  let catalog_builder = semantic_type_catalog_builder(2)
  let catalog_builder = match catalog_builder.insert(dependency_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected imported pattern segment")
  }
  let catalog_builder = match catalog_builder.insert(local_builder.freeze()) {
    SemanticTypeCatalogInserted(next) -> next
    _ -> panic("expected local pattern segment")
  }
  let catalog = catalog_builder.freeze()
  let source = source_from_text("fixture")
  let function = ModuleFunctionIdentity(module, 0)
  let expressions = checked_expr_graph_builder(module, source, catalog, 1)
  let (expressions, binding) = expressions.binding(
    function,
    imported,
    range(0, 1),
    CheckedImmutableBinding
  )
  let patterns = checked_pattern_graph_builder(expressions.segment(), source, catalog)
  let (patterns, typed) = patterns.typed_binding(
    expressions,
    binding,
    imported,
    false,
    imported,
    range(0, 1)
  )
  let graph = patterns.freeze()

  Test.assert_true(semantic_type_id_eq(graph.input_type(typed), imported))
  Test.assert_true(
    match graph.typed_binding_parts(typed) {
      (_, annotation) -> semantic_type_id_eq(annotation, imported)
    }
  )
  Test.assert_false(graph.typed_binding_tests_nil(typed))
}

test "match arms and expressions share exact guarded topology" {
  let module = named_module_identity("fixture/match", 71)
  let source = source_from_text("fixture")
  let catalog = types(module)
  let integer = integer_type(module)
  let boolean = boolean_type(module)
  let expressions = checked_expr_graph_builder(module, source, catalog, 8)
  let (expressions, scrutinee) = expressions.boolean(true, boolean, range(0, 1))
  let (expressions, guard) = expressions.boolean(true, boolean, range(1, 2))
  let (expressions, first_body) = expressions.integer(1, integer, range(2, 3))
  let (expressions, second_body) = expressions.integer(2, integer, range(3, 4))
  let patterns = checked_pattern_graph_builder(expressions.segment(), source, catalog)
  let (patterns, literal) = patterns.integer(
    1,
    CheckedBooleanPattern,
    boolean,
    range(0, 1)
  )
  let (patterns, fallback) = patterns.wildcard(boolean, range(1, 2))
  let (patterns, arms) = patterns.match_arm_list()
  let (patterns, arms) = patterns.match_arm_list_push(
    expressions,
    arms,
    literal,
    CheckedGuarded(guard),
    first_body,
    range(0, 3)
  )
  let (patterns, arms) = patterns.match_arm_list_push(
    expressions,
    arms,
    fallback,
    CheckedUnguarded,
    second_body,
    range(3, 4)
  )
  let (patterns, arms) = patterns.match_arm_list_finish(arms)
  let (expressions, explicit) = expressions.match_expr(
    CheckedExplicitMatch,
    scrutinee,
    arms,
    integer,
    range(0, 4)
  )
  let (expressions, destructured) = expressions.match_expr(
    CheckedLetDestructuring,
    scrutinee,
    arms,
    integer,
    range(0, 4)
  )
  let (expressions, iterated) = expressions.match_expr(
    CheckedForDestructuring,
    scrutinee,
    arms,
    integer,
    range(0, 4)
  )
  let pattern_graph = patterns.freeze()
  let expr_graph = expressions.freeze()
  let first = pattern_graph.match_arm_list_at(arms, 0)
  let second = pattern_graph.match_arm_list_at(arms, 1)

  Test.assert_eq_usize(pattern_graph.match_arm_list_len(arms), 2)
  Test.assert_true(checked_pattern_id_eq(first.pattern, literal))
  Test.assert_true(
    match first.guard {
      CheckedGuarded(found) -> checked_expr_id_eq(found, guard)
      _ -> false
    }
  )
  Test.assert_true(checked_expr_id_eq(first.body, first_body))
  Test.assert_true(match second.guard { CheckedUnguarded -> true, _ -> false })
  Test.assert_true(checked_expr_id_eq(second.body, second_body))
  Test.assert_true(
    match expr_graph.match_parts(explicit) {
      (CheckedExplicitMatch, found_scrutinee, found_arms) ->
        checked_expr_id_eq(found_scrutinee, scrutinee) and
        pattern_graph.match_arm_list_len(found_arms) == 2
      _ -> false
    }
  )
  Test.assert_true(
    match expr_graph.inspect(destructured).node {
      CheckedMatchNode(CheckedLetDestructuring, _, _) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match expr_graph.inspect(iterated).node {
      CheckedMatchNode(CheckedForDestructuring, _, _) -> true
      _ -> false
    }
  )
}
