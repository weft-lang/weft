test "range continue advances before checking the next iteration" {
  let mut total = 0
  for i in 0..8 {
    if i == 0 { continue }
    if i == 3 { break }
    total = total + i
  }
  Test.assert_eq(total, 3)
}

test "every range iteration may continue" {
  let mut visits = 0
  for i in 0..8 { visits = visits + 1 continue }
  Test.assert_eq(visits, 8)
}

test "nested ranges advance independent private counters" {
  let mut total = 0
  for i in 0..4 {
    if i == 0 { continue }
    for j in 0..4 {
      if j == 0 { continue }
      if j == 3 { break }
      total = total + i * 10 + j
    }
  }
  Test.assert_eq(total, 129)
}

test "empty and descending ranges do not enter their body" {
  let mut visits = 0
  for i in 0..0 { visits = visits + 1 }
  for i in 4..2 { visits = visits + 1 }
  Test.assert_eq(visits, 0)
}

test "a range at the signed limit visits the original item without overflow" {
  let mut item = 0
  for i in 9223372036854775806..9223372036854775807 { item = i continue }
  Test.assert_eq(item, 9223372036854775806)
}

test "range bindings shadow outside values only inside the body" {
  let i = 4
  let mut total = 0
  for i in 0..i { total = total + i }
  Test.assert_eq(total, 6)
  Test.assert_eq(i, 4)
}

fn range_return() -> i64 {
  for i in 0..8 { if i == 3 { return i } }
  0 - 1
}

test "return from a range observes the current item" {
  Test.assert_eq(range_return(), 3)
}
