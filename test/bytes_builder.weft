use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/bytes/builder as byte_builder
use stdlib/bytes/builder.{Builder}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{IndexError, IndexOutOfBounds}

-- The finished bytes as one number per byte, most recent last, for exact
-- comparison against expected byte sequences.
fn bytes_code(values: Bytes) -> str {
  let mut code = ""
  let count = values.len().to_u64().to_i64_checked().unwrap_or(0)
  for index in 0..count {
    let byte = values.get(index.to_usize_checked().unwrap_or(0)).unwrap_or(0)
    code = if index == 0 { i"{byte}" } else { i"{code} {byte}" }
  }
  code
}

fn u16_of(value: i64) -> u16 { value.to_u16_checked().expect("test value fits u16") }

fn u32_of(value: i64) -> u32 { value.to_u32_checked().expect("test value fits u32") }

fn u64_of(value: i64) -> u64 { value.to_u64_checked().expect("test value fits u64") }

fn u8_of(value: i64) -> u8 { value.to_u8_checked().expect("test value fits u8") }

test "an empty builder finishes as empty bytes" {
  let out = byte_builder.new()
  Test.assert_true(out.is_empty())
  Test.assert_true(out.len() == 0)
  Test.assert_true(out.finish().is_empty())
}

test "fixed-width integers are written least significant byte first" {
  let mut out = byte_builder.new()
  out.push(u8_of(255))
  out.append_u16_le(u16_of(258))
  out.append_u32_le(u32_of(16909060))
  out.append_u64_le(u64_of(72623859790382856))
  Test.assert_true(out.len() == 15)
  Test.assert_str_eq(bytes_code(out.finish()), "255 2 1 4 3 2 1 8 7 6 5 4 3 2 1")
}

test "fixed-width boundaries keep every bit" {
  let mut out = byte_builder.new()
  out.append_u16_le(u16_of(0))
  out.append_u16_le(u16_of(65535))
  out.append_u32_le(u32_of(4294967295))
  out.append_u64_le(u64_of(9223372036854775807))
  out.append_u64_le(u64_of(9223372036854775807) + u64_of(1))
  Test.assert_str_eq(
    bytes_code(out.finish()),
    "0 0 255 255 255 255 255 255 255 255 255 255 255 255 255 127 0 0 0 0 0 0 0 128"
  )
}

test "bytes, text and other builders append their exact bytes" {
  let mut inner = byte_builder.new()
  inner.append_u16_le(u16_of(513))
  let mut out = byte_builder.with_capacity(2)
  out.append(bytes.from_str("ab"))
  out.append_text("é")
  out.append_text("")
  out.append_from(inner)
  let nothing = byte_builder.new()
  out.append_from(nothing)
  Test.assert_true(inner.len() == 2)
  Test.assert_str_eq(bytes_code(out.finish()), "97 98 195 169 1 2")
  Test.assert_str_eq(bytes_code(inner.finish()), "1 2")
}

test "zero fill and padding extend to exact lengths" {
  let mut out = byte_builder.new()
  out.push(u8_of(7))
  out.append_zeros(0)
  out.append_zeros(2)
  out.pad_to(2)
  out.pad_to(5)
  out.pad_to(5)
  out.push(u8_of(9))
  Test.assert_str_eq(bytes_code(out.finish()), "7 0 0 0 0 9")
}

fn patch_accepted(result: Result<nil, IndexError>) -> bool {
  match result {
    Ok(_) -> true
    Err(_) -> false
  }
}

fn patch_refused_at(result: Result<nil, IndexError>, offset: usize, length: usize) -> bool {
  match result {
    Ok(_) -> false
    Err(IndexOutOfBounds(at, len)) -> at == offset and len == length
  }
}

test "patches overwrite words only within the builder" {
  let mut out = byte_builder.new()
  out.append_zeros(10)
  Test.assert_true(patch_accepted(out.set_u32_le(0, u32_of(16909060))))
  Test.assert_true(patch_accepted(out.set_u32_le(6, u32_of(4294967295))))
  Test.assert_true(patch_refused_at(out.set_u32_le(7, u32_of(1)), 7, 10))
  Test.assert_true(patch_refused_at(out.set_u32_le(10, u32_of(1)), 10, 10))
  Test.assert_true(
    patch_refused_at(out.set_u32_le(18446744073709551615, u32_of(1)), 18446744073709551615, 10)
  )
  Test.assert_str_eq(bytes_code(out.finish()), "4 3 2 1 0 0 255 255 255 255")
  let mut empty = byte_builder.new()
  Test.assert_true(patch_refused_at(empty.set_u32_le(0, u32_of(1)), 0, 0))
  Test.assert_true(empty.is_empty())
}

test "words read back exactly what was written" {
  let mut out = byte_builder.new()
  out.push(u8_of(1))
  out.append_u32_le(u32_of(3735928559))
  out.push(u8_of(2))
  Test.assert_true(out.get_u32_le(1) == Some<u32>(u32_of(3735928559)))
  Test.assert_true(out.get_u32_le(2) == Some<u32>(u32_of(48147902)))
  Test.assert_true(out.get_u32_le(3) == None<u32>())
  Test.assert_true(out.get_u32_le(6) == None<u32>())
  Test.assert_true(out.get_u32_le(18446744073709551615) == None<u32>())
  Test.assert_true(patch_accepted(out.set_u32_le(2, u32_of(305419896))))
  Test.assert_true(out.get_u32_le(2) == Some<u32>(u32_of(305419896)))
}

test "builders grow across many appends" {
  let mut out = byte_builder.with_capacity(1)
  for index in 0..50000 { out.append_u32_le(u32_of(index)) }
  Test.assert_true(out.len() == 200000)
  Test.assert_true(out.get_u32_le(0) == Some<u32>(u32_of(0)))
  Test.assert_true(out.get_u32_le(199996) == Some<u32>(u32_of(49999)))
  Test.assert_true(out.get_u32_le(49380) == Some<u32>(u32_of(12345)))
  let finished = out.finish()
  Test.assert_true(finished.len() == 200000)
  Test.assert_true(finished.get(199996) == Some<u8>(u8_of(79)))
}

fn builder_churn(rounds: i64, finish: bool) -> i64 {
  let mut total = 0
  for round in 0..rounds {
    let mut out = byte_builder.new()
    out.append_u64_le(u64_of(round))
    out.append_text("section")
    out.pad_to(32)
    total = total + out.len().to_u64().to_i64_checked().unwrap_or(0)
    if finish { total = total + out.finish().len().to_u64().to_i64_checked().unwrap_or(0) }
  }
  total
}

test "dropped and finished builders churn with a flat heap" {
  builder_churn(200, false)
  builder_churn(200, true)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(builder_churn(3000, false), 3000 * 32)
  Test.assert_eq(builder_churn(3000, true), 3000 * 64)
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}
