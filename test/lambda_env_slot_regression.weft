-- test/lambda_env_slot_regression.weft -- lambda env value-id
-- reservation. Native lambda emission stores the capture env at
-- dst + 1; the typed lowering originally reserved only one id, so a
-- later value (a loop-hoisted constant in these shapes) could share
-- the env's spill slot and be clobbered by the env store at runtime.
-- Shape required: loop + capturing lambda argument + another argument
-- whose materialisation is hoisted above the loop.

fn lesr_ap(f: (i64) -> i64, v: i64) -> i64 { f(v) }

test "lambda_env_slot_loop_capture_with_hoisted_const_arg" {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let base = i
    acc = lesr_ap(x => x + base, 1)
    i = i + 1
  }
  Test.assert_eq(acc, 3)
}

test "lambda_env_slot_loop_capture_accumulates" {
  let mut i = 0
  let mut total = 0
  while i < 10 {
    let base = i * 2
    total = total + lesr_ap(x => x + base, 5)
    i = i + 1
  }
  -- sum of (5 + 2i) for i in 0..9 = 50 + 90
  Test.assert_eq(total, 140)
}

test "lambda_env_slot_nested_loops_capture" {
  let mut i = 0
  let mut total = 0
  while i < 3 {
    let mut j = 0
    while j < 3 {
      let base = i * 10 + j
      total = total + lesr_ap(x => x + base, 100)
      j = j + 1
    }
    i = i + 1
  }
  -- 9 calls of 100 + (10i + j) = 900 + (0+1+2 + 10+11+12 + 20+21+22)
  Test.assert_eq(total, 999)
}

test "lambda_env_slot_two_capturing_lambdas_one_call_chain" {
  let mut i = 0
  let mut acc = 0
  while i < 4 {
    let a = i
    let b = i + 1
    acc = lesr_ap(x => x + a, 1) + lesr_ap(x => x * b, 2)
    i = i + 1
  }
  -- last iteration: (1 + 3) + (2 * 4) = 12
  Test.assert_eq(acc, 12)
}
