use "runtime/alloc.weft"
use "runtime/memory.weft"
-- test/direct_call_inlining_metrics.weft -- native evidence for tiny pure direct-call inlining

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn direct_inline_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn direct_inline_metric_count(src: str) -> i64 {
  pipeline_native_direct_call_inline_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_leaf_count(src: str) -> i64 {
  pipeline_native_tiny_leaf_function_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_alias_count(src: str) -> i64 {
  pipeline_native_tiny_inline_arg_alias_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_spill_value_count(src: str) -> i64 {
  pipeline_native_register_spill_value_count(direct_inline_metric_native(src))
}

test "direct_call_inline_metric_inlines_multiple_tiny_arithmetic_sites" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main() -> i64 { affine(2, 3, 4) + affine(5, 6, 7) }"
  Test.assert_eq(direct_inline_metric_count(src), 2)
}

test "direct_call_inline_metric_eliminates_static_mem_load_accessor_wrappers" {
  let src = "fn mem_load64_at(ptr: i64, index: i64) -> i64 { mem_load64(ptr + index) } fn tag(n: i64) -> i64 { mem_load64_at(n, 0) } fn f1(n: i64) -> i64 { mem_load64_at(n, 8) } fn main(n: i64) -> i64 { tag(n) + f1(n) }"
  -- 3 -> 7 when the pseudo-bridge min-params completion let wrapper
  -- chains close through two levels (2l inline-closure completion).
  Test.assert_eq(direct_inline_metric_count(src), 7)
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "tiny_leaf_function_metric_keeps_dynamic_mem_load_on_normal_path" {
  let src = "fn mem_load64_at(ptr: i64, index: i64) -> i64 { mem_load64(ptr + index) } fn load_at(n: i64, index: i64) -> i64 { mem_load64_at(n, index) } fn main(n: i64, index: i64) -> i64 { load_at(n, index) }"
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "tiny_leaf_function_metric_keeps_arithmetic_helper_on_normal_path" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main(a: i64, b: i64) -> i64 { add(a, b) }"
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_identifier_args" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main(x: i64, y: i64) -> i64 { add(x, y) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_mixed_identifier_args" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main(x: i64) -> i64 { affine(x, 3, x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_graph_index_shape" {
  let src = "fn graph_index(nodes: i64, from: i64, to: i64) -> i64 { from * nodes + to } fn main(nodes: i64, from: i64, to: i64) -> i64 { graph_index(nodes, from, to) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_inlines_control_flow_helper" {
  -- Multi-block tiny-fn inlining (2k slice B') now takes branchy pure
  -- helpers; the old "control flow keeps the call" limitation is gone.
  let src = "fn clamp_positive(x: i64) -> i64 { if x > 0 { x } else { 0 } } fn main() -> i64 { clamp_positive(3) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_keeps_recursive_control_flow_helper_as_call" {
  -- A self-call re-exposes a candidate site on every splice, so
  -- recursive bodies are excluded from the multi-block candidate set.
  let src = "fn count_down(x: i64) -> i64 { if x > 0 { count_down(x - 1) } else { 0 } } fn main() -> i64 { count_down(3) }"
  Test.assert_eq(direct_inline_metric_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_literal_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { add(1, 2) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_mutable_spill_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { let mut a = 1 let mut b = 2 add(a, b) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
  Test.assert_eq(direct_inline_metric_spill_value_count(src), 0)
}

test "direct_call_inline_metric_effect_declared_perform_free_helper_inlines" {
  -- Inverted by single-block multi-inline admission (2k): the declared
  -- effect row over-approximates and the body carries no performs, so
  -- the multi pre-pass splices it (same policy the multi-block
  -- perform-free wrapper pin records in the spine metrics). The
  -- direct-call inliner itself still refuses declared-effect bodies —
  -- the alias-metric pin below stays 0.
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main() -[Tick]> i64 { declared_effect(1) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_alias_metric_keeps_effectful_helper_as_call" {
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main(x: i64) -[Tick]> i64 { declared_effect(x) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_inlines_pure_f64_sqrt_wrapper" {
  -- The pure-intrinsic bridge admits single-intrinsic float wrappers.
  let src = "fn root(x: f64) -> f64 { __f64_sqrt(x) } fn main(x: f64) -> f64 { root(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_inlines_pure_f32_sqrt_wrapper" {
  let src = "fn root(x: f32) -> f32 { __f32_sqrt(x) } fn main(x: f32) -> f32 { root(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_keeps_non_intrinsic_f64_helper_as_call" {
  let src = "fn square(x: f64) -> f64 { x * x } fn main(x: f64) -> f64 { square(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 0)
}

test "direct_call_inline_metric_inlines_derived_sqrt_arg" {
  -- A float-binary feeding the intrinsic is a supported clone inst, so
  -- the derived-argument wrapper inlines too.
  let src = "fn root_plus_one(x: f64) -> f64 { __f64_sqrt(x + 1.0) } fn main(x: f64) -> f64 { root_plus_one(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

fn inline_dup_i64(x: i64) -> i64 {
  x + x
}

fn inline_add_i64(a: i64, b: i64) -> i64 {
  a + b
}

fn inline_sqrt_f64(x: f64) -> f64 {
  __f64_sqrt(x)
}

fn inline_bump_to_nine_f64(p: i64) -> f64 {
  mem_store64(p, mem_load64(p) + 1)
  9.0
}

fn inline_f64_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

test "direct_call_inline_runtime_evaluates_argument_once" {
  let mut n = 1
  let got = inline_dup_i64({ n = n + 1 n })
  Test.assert_eq(got, 4)
  Test.assert_eq(n, 2)
}

test "direct_call_inline_runtime_aliases_identifier_args" {
  let a = 17
  let b = 25
  Test.assert_eq(inline_add_i64(a, b), 42)
}

test "direct_call_inline_runtime_aliases_under_live_register_pressure" {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  Test.assert_eq(inline_add_i64(a, b) + c + d + e + f + g + h, 36)
}

test "direct_call_inline_runtime_f64_sqrt_evaluates_argument_once" {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 0)
  let got = inline_sqrt_f64(inline_bump_to_nine_f64(p))
  Test.assert_eq(inline_f64_same(got, 3.0), 1)
  Test.assert_eq(mem_load64(p), 1)
  arena_free(arena)
}
