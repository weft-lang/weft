use runtime/alloc.{*}
use runtime/memory.{*}
-- test/direct_call_inlining_metrics.weft -- native evidence for tiny pure direct-call inlining

use stdlib/vector.{*}
use stdlib/num.{*}
use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}

fn direct_inline_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn direct_inline_metric_count(src: str) -> i64 {
  pipeline_native_direct_call_inline_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_leaf_count(src: str) -> i64 {
  pipeline_native_tiny_leaf_function_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_alias_count(src: str) -> i64 {
  pipeline_native_tiny_inline_arg_alias_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_spill_value_count(src: str) -> i64 {
  pipeline_native_register_spill_value_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_optimised(src: str) -> IrModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
}

fn direct_inline_metric_inst_call_count(insts: IrInstList, callee_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let this = match inst {
        IrCallI64(dst, actual_hash, args) -> if actual_hash == callee_hash { 1 } else { 0 }
        _ -> 0
      }
      this + direct_inline_metric_inst_call_count(rest, callee_hash)
    }
  }
}

fn direct_inline_metric_block_call_count(blocks: IrBlockList, callee_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      match block {
        IrBlock(id, params, insts, term) -> direct_inline_metric_inst_call_count(insts, callee_hash) + direct_inline_metric_block_call_count(rest, callee_hash)
      }
    }
  }
}

fn direct_inline_metric_named_call_count(src: str, host_name: str, callee_name: str) -> i64 {
  let functions = pipeline_ir_functions(direct_inline_metric_optimised(src))
  let host_hash = str_hash(__str_ptr(host_name), 0, __str_len(host_name))
  let callee_hash = str_hash(__str_ptr(callee_name), 0, __str_len(callee_name))
  match pipeline_ir_function_list_find_hash(functions, host_hash) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(host, rest) -> {
      match host {
        IrFunction(hash, param_count, blocks, host_src) -> direct_inline_metric_block_call_count(blocks, callee_hash)
      }
    }
  }
}

fn direct_inline_metric_named_tag_count(src: str, host_name: str, tag: i64) -> i64 {
  let functions = pipeline_ir_functions(direct_inline_metric_optimised(src))
  let host_hash = str_hash(__str_ptr(host_name), 0, __str_len(host_name))
  ir_function_list_count_tag(pipeline_ir_function_list_find_hash(functions, host_hash), tag)
}

test "direct_call_inline_metric_inlines_multiple_tiny_arithmetic_sites" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main() -> i64 { affine(2, 3, 4) + affine(5, 6, 7) }"
  Test.assert_eq(direct_inline_metric_count(src), 2)
}

test "direct_call_inline_metric_eliminates_static_mem_load_accessor_wrappers" {
  let src = "fn mem_load64_at(ptr: i64, index: i64) -> i64 { mem_load64(ptr + index) } fn tag(n: i64) -> i64 { mem_load64_at(n, 0) } fn f1(n: i64) -> i64 { mem_load64_at(n, 8) } fn main(n: i64) -> i64 { tag(n) + f1(n) }"
  -- 3 -> 7 when the pseudo-bridge min-params completion let wrapper
  -- chains close through two levels (2l inline-closure completion).
  Test.assert_eq(direct_inline_metric_count(src), 7)
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "tiny_leaf_function_metric_keeps_dynamic_mem_load_on_normal_path" {
  let src = "fn mem_load64_at(ptr: i64, index: i64) -> i64 { mem_load64(ptr + index) } fn load_at(n: i64, index: i64) -> i64 { mem_load64_at(n, index) } fn main(n: i64, index: i64) -> i64 { load_at(n, index) }"
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "tiny_leaf_function_metric_keeps_arithmetic_helper_on_normal_path" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main(a: i64, b: i64) -> i64 { add(a, b) }"
  Test.assert_eq(direct_inline_metric_leaf_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_identifier_args" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main(x: i64, y: i64) -> i64 { add(x, y) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_mixed_identifier_args" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main(x: i64) -> i64 { affine(x, 3, x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_ir_inlines_graph_index_shape" {
  let src = "fn graph_index(nodes: i64, from: i64, to: i64) -> i64 { from * nodes + to } fn main(nodes: i64, from: i64, to: i64) -> i64 { graph_index(nodes, from, to) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_inlines_control_flow_helper" {
  -- Multi-block tiny-fn inlining (2k slice B') now takes branchy pure
  -- helpers; the old "control flow keeps the call" limitation is gone.
  let src = "fn clamp_positive(x: i64) -> i64 { if x > 0 { x } else { 0 } } fn main() -> i64 { clamp_positive(3) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_inlines_typed_vector_get_wrapper" {
  let src = "use stdlib/vector.{*} fn metric_vector_at(values: Vector<i64>, index: i64) -> i64 { vector_get<i64>(values, index, 0 - 7) } fn metric_sum(values: Vector<i64>, n: i64) -> i64 { let mut i = 0 let mut total = 0 while i < n { total = total + metric_vector_at(values, i) i = i + 1 } total } fn main(values: Vector<i64>, n: i64) -> i64 { metric_sum(values, n) }"
  Test.assert_eq(direct_inline_metric_named_call_count(src, "metric_sum", "metric_vector_at"), 0)
  Test.assert_eq(direct_inline_metric_named_tag_count(src, "metric_sum", 28), 1)
}

test "direct_call_inline_metric_inlines_typed_vector_set_wrapper" {
  let src = "use stdlib/vector.{*} fn metric_vector_put(values: Vector<i64>, index: i64, value: i64) -> i64 { vector_set<i64>(values, index, value) } fn metric_fill(values: Vector<i64>, n: i64) -> i64 { let mut i = 0 let mut status = 1 while i < n { status = metric_vector_put(values, i, i + 10) i = i + 1 } status } fn main(values: Vector<i64>, n: i64) -> i64 { metric_fill(values, n) }"
  Test.assert_eq(direct_inline_metric_named_call_count(src, "metric_fill", "metric_vector_put"), 0)
  Test.assert_eq(direct_inline_metric_named_tag_count(src, "metric_fill", 29), 1)
}

test "direct_call_inline_metric_keeps_recursive_control_flow_helper_as_call" {
  -- A self-call re-exposes a candidate site on every splice, so
  -- recursive bodies are excluded from the multi-block candidate set.
  let src = "fn count_down(x: i64) -> i64 { if x > 0 { count_down(x - 1) } else { 0 } } fn main() -> i64 { count_down(3) }"
  Test.assert_eq(direct_inline_metric_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_literal_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { add(1, 2) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_mutable_spill_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { let mut a = 1 let mut b = 2 add(a, b) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
  Test.assert_eq(direct_inline_metric_spill_value_count(src), 0)
}

test "direct_call_inline_metric_effect_declared_perform_free_helper_inlines" {
  -- Inverted by single-block multi-inline admission (2k): the declared
  -- effect row over-approximates and the body carries no performs, so
  -- the multi pre-pass splices it (same policy the multi-block
  -- perform-free wrapper pin records in the spine metrics). The
  -- direct-call inliner itself still refuses declared-effect bodies —
  -- the alias-metric pin below stays 0.
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main() -[Tick]> i64 { declared_effect(1) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_alias_metric_keeps_effectful_helper_as_call" {
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main(x: i64) -[Tick]> i64 { declared_effect(x) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_metric_inlines_pure_f64_sqrt_wrapper" {
  -- The pure-intrinsic bridge admits single-intrinsic float wrappers.
  let src = "fn root(x: f64) -> f64 { __f64_sqrt(x) } fn main(x: f64) -> f64 { root(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_inlines_pure_f32_sqrt_wrapper" {
  let src = "fn root(x: f32) -> f32 { __f32_sqrt(x) } fn main(x: f32) -> f32 { root(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

test "direct_call_inline_metric_inlines_non_intrinsic_f64_helper" {
  let src = "fn square(x: f64) -> f64 { x * x } fn main(x: f64) -> f64 { square(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
  Test.assert_eq(direct_inline_metric_named_call_count(src, "main", "square"), 0)
}

test "direct_call_inline_metric_keeps_float_identity_alias_as_call" {
  -- The multi splice's single-return parameter alias is still materialised
  -- with integer add-zero; float identity stays fenced until that path can
  -- publish an explicit typed SSA alias.
  let src = "fn identity(x: f64) -> f64 { x } fn main(x: f64) -> f64 { identity(x) }"
  Test.assert_eq(direct_inline_metric_named_call_count(src, "main", "identity"), 1)
}

test "direct_call_inline_metric_inlines_derived_sqrt_arg" {
  -- A float-binary feeding the intrinsic is a supported clone inst, so
  -- the derived-argument wrapper inlines too.
  let src = "fn root_plus_one(x: f64) -> f64 { __f64_sqrt(x + 1.0) } fn main(x: f64) -> f64 { root_plus_one(x) }"
  Test.assert_eq(direct_inline_metric_count(src), 1)
}

fn inline_dup_i64(x: i64) -> i64 {
  x + x
}

fn inline_add_i64(a: i64, b: i64) -> i64 {
  a + b
}

fn inline_sqrt_f64(x: f64) -> f64 {
  __f64_sqrt(x)
}

fn inline_vector_get_i64(values: Vector<i64>, index: i64, fallback: i64) -> i64 {
  vector_get<i64>(values, index, fallback)
}

fn inline_vector_set_i64(values: Vector<i64>, index: i64, value: i64) -> i64 {
  vector_set<i64>(values, index, value)
}

fn inline_bump_to_nine_f64(p: i64) -> f64 {
  mem_store64(p, mem_load64(p) + 1)
  9.0
}

fn inline_f64_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn inline_f64_not_equal(a: f64, b: f64) -> i64 {
  if a != b { 1 } else { 0 }
}

fn inline_f32_not_equal(a: f32, b: f32) -> i64 {
  if a != b { 1 } else { 0 }
}

fn inline_f64_times_one(value: f64) -> f64 {
  value * 1.0
}

fn inline_vector_get_f64(values: Vector<f64>, index: i64, fallback: f64) -> f64 {
  vector_get<f64>(values, index, fallback)
}

fn inline_vector_set_f64(values: Vector<f64>, index: i64, value: f64) -> i64 {
  vector_set<f64>(values, index, value)
}

test "direct_call_inline_runtime_evaluates_argument_once" {
  let mut n = 1
  let got = inline_dup_i64({ n = n + 1 n })
  Test.assert_eq(got, 4)
  Test.assert_eq(n, 2)
}

test "direct_call_inline_runtime_aliases_identifier_args" {
  let a = 17
  let b = 25
  Test.assert_eq(inline_add_i64(a, b), 42)
}

test "direct_call_inline_runtime_aliases_under_live_register_pressure" {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  Test.assert_eq(inline_add_i64(a, b) + c + d + e + f + g + h, 36)
}

test "direct_call_inline_runtime_f64_sqrt_evaluates_argument_once" {
  let arena = arena_new(64)
  let p = arena_alloc(arena, 8, 8)
  mem_store64(p, 0)
  let got = inline_sqrt_f64(inline_bump_to_nine_f64(p))
  Test.assert_eq(inline_f64_same(got, 3.0), 1)
  Test.assert_eq(mem_load64(p), 1)
  arena_free(arena)
}

test "direct_call_inline_runtime_float_comparisons_preserve_nan" {
  let nan64 = num_f64_from_bits(9221120237041095221)
  let nan32 = num_f32_from_bits(2143289349)
  Test.assert_eq(inline_f64_not_equal(nan64, nan64), 1)
  Test.assert_eq(inline_f32_not_equal(nan32, nan32), 1)
  Test.assert_eq(inline_f64_not_equal(1.5, 1.5), 0)
}

test "direct_call_inline_runtime_f64_return_preserves_signed_zero" {
  let negative_zero = num_f64_from_bits(9223372036854775808)
  Test.assert_true(num_f64_to_bits(inline_f64_times_one(negative_zero)) == 9223372036854775808)
}

test "direct_call_inline_runtime_vector_wrappers_preserve_checks" {
  let values = vector_with_capacity<i64>(2)
  vector_push<i64>(values, 11)
  vector_push<i64>(values, 22)
  Test.assert_eq(inline_vector_get_i64(values, 1, 99), 22)
  Test.assert_eq(inline_vector_get_i64(values, 0 - 1, 99), 99)
  Test.assert_eq(inline_vector_get_i64(values, 2, 99), 99)
  Test.assert_eq(inline_vector_set_i64(values, 1, 41), 1)
  Test.assert_eq(inline_vector_set_i64(values, 0 - 1, 7), 0)
  Test.assert_eq(inline_vector_set_i64(values, 2, 7), 0)
  Test.assert_eq(vector_get<i64>(values, 0, 0), 11)
  Test.assert_eq(vector_get<i64>(values, 1, 0), 41)
}

test "direct_call_inline_runtime_f64_vector_wrappers_preserve_values_and_checks" {
  let values = vector_with_capacity<f64>(2)
  vector_push<f64>(values, 1.25)
  vector_push<f64>(values, 2.5)
  Test.assert_eq_f64(inline_vector_get_f64(values, 1, 9.0), 2.5)
  Test.assert_eq_f64(inline_vector_get_f64(values, 0 - 1, 9.0), 9.0)
  Test.assert_eq_f64(inline_vector_get_f64(values, 2, 8.0), 8.0)
  Test.assert_eq(inline_vector_set_f64(values, 1, 4.75), 1)
  Test.assert_eq(inline_vector_set_f64(values, 0 - 1, 7.0), 0)
  Test.assert_eq(inline_vector_set_f64(values, 2, 7.0), 0)
  Test.assert_eq_f64(vector_get<f64>(values, 1, 0.0), 4.75)
}
