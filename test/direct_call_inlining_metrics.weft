-- test/direct_call_inlining_metrics.weft -- native evidence for tiny pure direct-call inlining

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn direct_inline_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn direct_inline_metric_count(src: str) -> i64 {
  pipeline_native_direct_call_inline_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_alias_count(src: str) -> i64 {
  pipeline_native_tiny_inline_arg_alias_count(direct_inline_metric_native(src))
}

fn direct_inline_metric_spill_value_count(src: str) -> i64 {
  pipeline_native_register_spill_value_count(direct_inline_metric_native(src))
}

test "direct_call_inline_metric_inlines_multiple_tiny_arithmetic_sites" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main() -> i64 { affine(2, 3, 4) + affine(5, 6, 7) }"
  Test.assert_eq(direct_inline_metric_count(src), 2)
}

test "direct_call_inline_alias_metric_aliases_identifier_args" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main(x: i64, y: i64) -> i64 { add(x, y) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 2)
}

test "direct_call_inline_alias_metric_aliases_mixed_identifier_args" {
  let src = "fn affine(a: i64, b: i64, c: i64) -> i64 { a * b + c } fn main(x: i64) -> i64 { affine(x, 3, x) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 2)
}

test "direct_call_inline_alias_metric_aliases_graph_index_shape" {
  let src = "fn graph_index(nodes: i64, from: i64, to: i64) -> i64 { from * nodes + to } fn main(nodes: i64, from: i64, to: i64) -> i64 { graph_index(nodes, from, to) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 3)
}

test "direct_call_inline_metric_keeps_control_flow_helper_as_call" {
  let src = "fn clamp_positive(x: i64) -> i64 { if x > 0 { x } else { 0 } } fn main() -> i64 { clamp_positive(3) }"
  Test.assert_eq(direct_inline_metric_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_literal_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { add(1, 2) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_mutable_spill_args_materialised" {
  let src = "fn add(a: i64, b: i64) -> i64 { a + b } fn main() -> i64 { let mut a = 1 let mut b = 2 add(a, b) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
  Test.assert_eq(direct_inline_metric_spill_value_count(src), 2)
}

test "direct_call_inline_metric_keeps_effectful_helper_as_call" {
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main() -[Tick]> i64 { declared_effect(1) }"
  Test.assert_eq(direct_inline_metric_count(src), 0)
}

test "direct_call_inline_alias_metric_keeps_effectful_helper_as_call" {
  let src = "effect Tick { fn next() -> i64 } fn declared_effect(x: i64) -[Tick]> i64 { x + 1 } fn main(x: i64) -[Tick]> i64 { declared_effect(x) }"
  Test.assert_eq(direct_inline_metric_alias_count(src), 0)
}

fn inline_dup_i64(x: i64) -> i64 {
  x + x
}

fn inline_add_i64(a: i64, b: i64) -> i64 {
  a + b
}

test "direct_call_inline_runtime_evaluates_argument_once" {
  let mut n = 1
  let got = inline_dup_i64({ n = n + 1 n })
  Test.assert_eq(got, 4)
  Test.assert_eq(n, 2)
}

test "direct_call_inline_runtime_aliases_identifier_args" {
  let a = 17
  let b = 25
  Test.assert_eq(inline_add_i64(a, b), 42)
}

test "direct_call_inline_runtime_aliases_under_live_register_pressure" {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  Test.assert_eq(inline_add_i64(a, b) + c + d + e + f + g + h, 36)
}
