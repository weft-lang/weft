-- Word frequency counter: combines List, Map (CHAMP), for-in, pipes, traits
-- Expected exit code: 3
use "stdlib/list.weft"
use "stdlib/map.weft"

fn count_occurrences(words: i64) -> i64 {
  let mut counts = map_new()
  for word in words {
    let cur = map_get(counts, word, 0)
    counts = map_put(counts, word, cur + 1)
  }
  counts
}

fn main() -> i64 {
  -- Count occurrences of value 42 in a list
  let data = Cons<i64>(42, Cons<i64>(10, Cons<i64>(42, Cons<i64>(20, Cons<i64>(42, Nil)))))
  let counts = count_occurrences(data)
  map_get(counts, 42, 0)
}
