-- Word frequency counter: combines List, Map (CHAMP), for-in, pipes, traits
-- Expected exit code: 3
use "stdlib/list.weft"
use stdlib/map.{*}

fn count_occurrences(words: List<i64>) -> Map<i64, i64> {
  let mut counts = map_new<i64, i64>()
  for word in words {
    let cur = map_get_or(counts, word, 0)
    counts = map_put(counts, word, cur + 1)
  }
  counts
}

fn main() -> i64 {
  -- Count occurrences of value 42 in a list
  let data = list_cons<i64>(42, list_cons<i64>(10, list_cons<i64>(42, list_cons<i64>(20, list_cons<i64>(42, list_nil<i64>())))))
  let counts = count_occurrences(data)
  map_get_or(counts, 42, 0)
}
