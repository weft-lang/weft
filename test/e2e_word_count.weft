-- Word frequency counter: combines List, Map (CHAMP), for-in, pipes, traits
-- Expected exit code: 3
use stdlib/list.{*}
use stdlib/map as map
use stdlib/map.{*}
use stdlib/option.{Option}

fn count_occurrences(words: List<i64>) -> Map<i64, i64> {
  let mut counts = map.new<i64, i64>()
  for word in words {
    let cur = counts.get(word).unwrap_or(0)
    counts = counts.insert(word, cur + 1)
  }
  counts
}

fn main() -> i64 {
  -- Count occurrences of value 42 in a list
  let data = Cons<i64>(42, Cons<i64>(10, Cons<i64>(42, Cons<i64>(20, Cons<i64>(42, Nil<i64>())))))
  let counts = count_occurrences(data)
  counts.get(42).unwrap_or(0)
}
