-- Control flow tests: if/else, let bindings, let mut, while loops, functions
-- Converted from test_self_host.sh sections 4-8

-- Helper functions used by multiple tests
fn factorial(n: i64) -> i64 {
  if n <= 1 { 1 } else { n * factorial(n - 1) }
}

fn fib(n: i64) -> i64 {
  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn sum(n: i64) -> i64 {
  if n <= 0 { 0 } else { n + sum(n - 1) }
}

fn double(x: i64) -> i64 { x * 2 }

fn add1(x: i64) -> i64 { x + 1 }

fn sub(a: i64, b: i64) -> i64 { a - b }

fn id(x: i64) -> i64 { x }

-- Function chain helpers
fn chain_c(x: i64) -> i64 { x + 2 }
fn chain_b(x: i64) -> i64 { chain_c(x * 2) }
fn chain_a(x: i64) -> i64 { chain_b(x + 3) }

-- Arity helpers
fn f0() -> i64 { 42 }
fn f1(x: i64) -> i64 { x }
fn f2(a: i64, b: i64) -> i64 { a + b }
fn f3(a: i64, b: i64, c: i64) -> i64 { a + b + c }
fn f4(a: i64, b: i64, c: i64, d: i64) -> i64 { a + b + c + d }
fn f5(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 { a + b + c + d + e }
fn f6(a: i64, b: i64, c: i64, d: i64, e: i64, g: i64) -> i64 { a + b + c + d + e + g }
fn f7(a: i64, b: i64, c: i64, d: i64, e: i64, g: i64, h: i64) -> i64 { a + b + c + d + e + g + h }

fn inc(x: i64) -> i64 { x + 1 }

fn deep_f(n: i64) -> i64 { if n <= 0 { 0 } else { 1 + deep_f(n - 1) } }

-- ═══════════════════════════════════════════════════════════════
-- 4. IF/ELSE -- branches, nesting, as expression
-- ═══════════════════════════════════════════════════════════════

test "if_true" {
  Test.assert_eq(if 1 == 1 { 1 } else { 2 }, 1)
}

test "if_false" {
  Test.assert_eq(if 1 == 2 { 1 } else { 2 }, 2)
}

test "if_nested_tt" {
  Test.assert_eq(if 1 == 1 { if 2 == 2 { 1 } else { 2 } } else { 3 }, 1)
}

test "if_nested_tf" {
  Test.assert_eq(if 1 == 1 { if 2 == 3 { 1 } else { 2 } } else { 3 }, 2)
}

test "if_nested_ft" {
  Test.assert_eq(if 1 == 2 { if 2 == 2 { 1 } else { 2 } } else { 3 }, 3)
}

test "if_deep4" {
  Test.assert_eq(if 1 == 1 { if 2 == 2 { if 3 == 3 { if 4 == 4 { 4 } else { 0 } } else { 0 } } else { 0 } } else { 0 }, 4)
}

test "if_deep4_fail" {
  Test.assert_eq(if 1 == 2 { if 2 == 2 { if 3 == 3 { if 4 == 4 { 4 } else { 0 } } else { 0 } } else { 0 } } else { 99 }, 99)
}

test "if_expr_let" {
  let x = if 3 > 2 { 5 } else { 1 }
  Test.assert_eq(x * 2, 10)
}

test "if_expr_arith" {
  Test.assert_eq((if 1 == 1 { 5 } else { 0 }) * 10, 50)
}

test "if_complex_cond" {
  let a = 10
  let b = 20
  Test.assert_eq(if a + b == 30 { 42 } else { 0 }, 42)
}

test "if_chain" {
  Test.assert_eq(if 0 == 1 { 1 } else { if 0 == 2 { 2 } else { 3 } }, 3)
}

-- ═══════════════════════════════════════════════════════════════
-- 5. LET BINDINGS
-- ═══════════════════════════════════════════════════════════════

test "let_simple" {
  let x = 42
  Test.assert_eq(x, 42)
}

test "let_arith" {
  let x = 3
  let y = 7
  Test.assert_eq(x + y, 10)
}

test "let_shadow" {
  let x = 1
  let x = 2
  Test.assert_eq(x, 2)
}

test "let_multi" {
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  Test.assert_eq(a + b + c + d + e, 15)
}

test "let_fn_result" {
  let r = factorial(5)
  Test.assert_eq(r, 120)
}

test "let_chain" {
  let a = 2
  let b = a * 3
  let c = b * 7
  Test.assert_eq(c, 42)
}

-- ═══════════════════════════════════════════════════════════════
-- 6. LET MUT + ASSIGNMENT
-- ═══════════════════════════════════════════════════════════════

test "mut_basic" {
  let mut x = 5
  x = 10
  Test.assert_eq(x, 10)
}

test "mut_multi" {
  let mut x = 0
  x = 1
  x = 2
  x = 3
  Test.assert_eq(x, 3)
}

test "mut_arith" {
  let mut x = 20
  x = x + 22
  Test.assert_eq(x, 42)
}

test "mut_while" {
  let mut x = 0
  while x < 100 { x = x + 1 }
  Test.assert_eq(x, 100)
}

test "mut_complex" {
  let mut x = 0
  let a = 10
  let b = 20
  x = a + b
  Test.assert_eq(x, 30)
}

test "mut_swap" {
  let mut x = 10
  let mut y = 20
  let tmp = x
  x = y
  y = tmp
  Test.assert_eq(x + y, 30)
}

-- ═══════════════════════════════════════════════════════════════
-- 7. WHILE LOOPS -- basic, edge, nested, patterns
-- ═══════════════════════════════════════════════════════════════

test "while" {
  let mut x = 0
  while x < 42 { x = x + 1 }
  Test.assert_eq(x, 42)
}

test "while_never" {
  let mut x = 0
  while x > 0 { x = x - 1 }
  Test.assert_eq(x, 0)
}

test "while_one" {
  let mut x = 0
  while x < 1 { x = x + 1 }
  Test.assert_eq(x, 1)
}

test "while_sum" {
  let mut x = 0
  let mut i = 0
  while i < 10 { x = x + i  i = i + 1 }
  Test.assert_eq(x, 45)
}

test "while_nested" {
  let mut sum = 0
  let mut i = 0
  while i < 3 {
    let mut j = 0
    while j < 4 { sum = sum + 1  j = j + 1 }
    i = i + 1
  }
  Test.assert_eq(sum, 12)
}

test "while_pow2" {
  let mut x = 1
  let mut i = 0
  while i < 7 { x = x * 2  i = i + 1 }
  Test.assert_eq(x, 128)
}

test "while_countdown" {
  let mut n = 100
  while n > 0 { n = n - 1 }
  Test.assert_eq(n, 0)
}

test "while_factorial" {
  let mut p = 1
  let mut i = 1
  while i <= 5 { p = p * i  i = i + 1 }
  Test.assert_eq(p, 120)
}

test "while_nested3" {
  let mut s = 0
  let mut i = 0
  while i < 3 {
    let mut j = 0
    while j < 3 {
      let mut k = 0
      while k < 3 { s = s + 1  k = k + 1 }
      j = j + 1
    }
    i = i + 1
  }
  Test.assert_eq(s, 27)
}

test "while_logical_and_guard" {
  let mut spawning = 0
  let mut spawn_error = 0
  while spawning < 5 and spawn_error == 0 {
    spawning = spawning + 1
    if spawning == 3 { spawn_error = 99 } else { 0 }
  }
  Test.assert_eq(spawning * 100 + spawn_error, 399)
}

test "while_logical_and_never_enters" {
  let mut x = 0
  let ready = false
  while x < 5 and ready {
    x = x + 1
  }
  Test.assert_eq(x, 0)
}

test "while_div" {
  let mut x = 24
  while x > 5 { x = x / 2 }
  Test.assert_eq(x, 3)
}

test "while_250" {
  let mut x = 0
  while x < 250 { x = x + 1 }
  Test.assert_eq(x, 250)
}

test "loop_break_value" {
  let got = loop { break(42) }
  Test.assert_eq(got, 42)
}

test "loop_break_value_from_nested_let" {
  let got = loop {
    let x = 40
    let y = x + 2
    break(y)
  }
  Test.assert_eq(got, 42)
}

test "loop_break_value_from_branch" {
  let got = loop {
    let x = 21
    if x * 2 == 42 { break(x * 2) } else { break(0) }
  }
  Test.assert_eq(got, 42)
}

-- ═══════════════════════════════════════════════════════════════
-- 8. FUNCTIONS -- arity 0-7, recursive, composition
-- ═══════════════════════════════════════════════════════════════

test "fn_zero" {
  Test.assert_eq(f0(), 42)
}

test "fn_one" {
  Test.assert_eq(f1(10), 10)
}

test "fn_two" {
  Test.assert_eq(f2(10, 20), 30)
}

test "fn_three" {
  Test.assert_eq(f3(10, 20, 30), 60)
}

test "fn_four" {
  Test.assert_eq(f4(10, 20, 30, 40), 100)
}

test "fn_five" {
  Test.assert_eq(f5(10, 20, 30, 40, 50), 150)
}

test "fn_six" {
  Test.assert_eq(f6(10, 20, 30, 40, 50, 60), 210)
}

test "fn_seven" {
  Test.assert_eq(f7(1, 2, 3, 4, 5, 6, 7), 28)
}

test "factorial" {
  Test.assert_eq(factorial(5), 120)
}

test "fib" {
  Test.assert_eq(fib(10), 55)
}

test "fn_recursive_sum" {
  Test.assert_eq(sum(10), 55)
}

test "fn_nested_call" {
  Test.assert_eq(double(add1(20)), 42)
}

test "fn_multi_calls" {
  Test.assert_eq(inc(1) + inc(2) + inc(3) + inc(4), 14)
}

test "fn_arg_order" {
  Test.assert_eq(sub(5, 2), 3)
}

test "fn_chain" {
  Test.assert_eq(chain_a(17), 42)
}

test "fn_compose" {
  Test.assert_eq(id(id(id(id(id(42))))), 42)
}

test "fn_deep_recursion" {
  Test.assert_eq(deep_f(200), 200)
}
