-- Expected exit code: 102
-- Without quarantine the next allocation reuses the freed block, so the stale
-- release silently frees that new object instead of trapping. Quarantine
-- keeps the freed block out of reuse, and the stale release traps.

use runtime/rc.{rc_default_alloc, rc_default_release, rc_quarantine_enable}

fn main() -> i64 {
  rc_quarantine_enable()
  let block: i64 = rc_default_alloc(8, 8)
  rc_default_release(block)
  let reused: i64 = rc_default_alloc(8, 8)
  rc_default_release(block)
  if reused == block { 0 } else { 1 }
}
