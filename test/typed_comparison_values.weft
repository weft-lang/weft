use stdlib/num as num

-- Each bit reports an independent primitive comparison. Keep operands in
-- parameters so both native comparison and result transport are exercised.
fn relations_f64(a: f64, b: f64) -> i64 {
  let mut result = 0
  if a == b { result = result + 1 }
  if a != b { result = result + 2 }
  if a < b { result = result + 4 }
  if a <= b { result = result + 8 }
  if a > b { result = result + 16 }
  if a >= b { result = result + 32 }
  result
}

fn relations_f32(a: f32, b: f32) -> i64 {
  let mut result = 0
  if a == b { result = result + 1 }
  if a != b { result = result + 2 }
  if a < b { result = result + 4 }
  if a <= b { result = result + 8 }
  if a > b { result = result + 16 }
  if a >= b { result = result + 32 }
  result
}

fn reused_f64(a: f64, b: f64) -> i64 {
  let flag = a < b
  let selected = if flag { 100 } else { 200 }
  if flag { selected + 1 } else { selected + 2 }
}

fn reused_f32(a: f32, b: f32) -> i64 {
  let flag = a <= b
  let selected = if flag { 100 } else { 200 }
  if flag { selected + 1 } else { selected + 2 }
}

fn returned_f64(a: f64, b: f64) -> bool { a < b }
fn returned_f32(a: f32, b: f32) -> bool { a <= b }

fn assert_unordered_f64(bits: u64) -[Test]> nil {
  let nan = num.f64_from_bits(bits)
  Test.assert_eq(relations_f64(nan, 1.0), 2)
  Test.assert_eq(relations_f64(1.0, nan), 2)
  Test.assert_eq(relations_f64(nan, nan), 2)
  Test.assert_eq(reused_f64(nan, 1.0), 202)
  Test.assert_true(not returned_f64(nan, 1.0))
  nil
}

fn assert_unordered_f32(bits: u32) -[Test]> nil {
  let nan = num.f32_from_bits(bits)
  Test.assert_eq(relations_f32(nan, 1.0), 2)
  Test.assert_eq(relations_f32(1.0, nan), 2)
  Test.assert_eq(relations_f32(nan, nan), 2)
  Test.assert_eq(reused_f32(nan, 1.0), 202)
  Test.assert_true(not returned_f32(nan, 1.0))
  nil
}

test "f64 comparisons exclude quiet signaling and negative NaNs from ordering" {
  assert_unordered_f64(9221120237041090560)
  assert_unordered_f64(9218868437227405313)
  assert_unordered_f64(18444492273895866369)
}

test "f32 comparisons exclude quiet signaling and negative NaNs from ordering" {
  assert_unordered_f32(2143289344)
  assert_unordered_f32(2139095041)
  assert_unordered_f32(4290772993)
}

test "f64 ordered comparisons cover finite subnormal zero and infinite values" {
  Test.assert_eq(relations_f64(1.0, 2.0), 14)
  Test.assert_eq(relations_f64(2.0, 1.0), 50)
  Test.assert_eq(relations_f64(1.0, 1.0), 41)
  Test.assert_eq(relations_f64(num.f64_from_bits(9223372036854775808), 0.0), 41)
  Test.assert_eq(relations_f64(num.f64_from_bits(1), 0.0), 50)
  Test.assert_eq(relations_f64(num.f64_from_bits(18442240474082181120), 0.0), 14)
  Test.assert_eq(relations_f64(num.f64_from_bits(9218868437227405312), 0.0), 50)
  Test.assert_eq(reused_f64(1.0, 2.0), 101)
  Test.assert_eq(reused_f64(2.0, 1.0), 202)
  Test.assert_true(returned_f64(1.0, 2.0))
}

test "f32 ordered comparisons cover finite subnormal zero and infinite values" {
  Test.assert_eq(relations_f32(1.0, 2.0), 14)
  Test.assert_eq(relations_f32(2.0, 1.0), 50)
  Test.assert_eq(relations_f32(1.0, 1.0), 41)
  Test.assert_eq(relations_f32(num.f32_from_bits(2147483648), 0.0), 41)
  Test.assert_eq(relations_f32(num.f32_from_bits(1), 0.0), 50)
  Test.assert_eq(relations_f32(num.f32_from_bits(4286578688), 0.0), 14)
  Test.assert_eq(relations_f32(num.f32_from_bits(2139095040), 0.0), 50)
  Test.assert_eq(reused_f32(1.0, 2.0), 101)
  Test.assert_eq(reused_f32(2.0, 1.0), 202)
  Test.assert_true(returned_f32(1.0, 1.0))
}

fn relations_usize(a: usize, b: usize) -> i64 {
  let mut result = 0
  if a == b { result = result + 1 }
  if a != b { result = result + 2 }
  if a < b { result = result + 4 }
  if a <= b { result = result + 8 }
  if a > b { result = result + 16 }
  if a >= b { result = result + 32 }
  result
}

fn reused_usize(a: usize, b: usize) -> i64 {
  let flag = a < b
  let selected = if flag { 100 } else { 200 }
  if flag { selected + 1 } else { selected + 2 }
}

test "full width unsigned comparisons preserve ordering and shared Boolean values" {
  Test.assert_eq(relations_usize(0, 18446744073709551615), 14)
  Test.assert_eq(relations_usize(18446744073709551615, 0), 50)
  Test.assert_eq(relations_usize(9223372036854775808, 9223372036854775808), 41)
  Test.assert_eq(relations_usize(9223372036854775807, 9223372036854775808), 14)
  Test.assert_eq(reused_usize(0, 18446744073709551615), 101)
  Test.assert_eq(reused_usize(18446744073709551615, 0), 202)
}
