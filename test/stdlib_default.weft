use stdlib/default.{*}
use stdlib/list.{*}
use stdlib/option.{*}
use stdlib/string.{*}

type DefaultPoint {
  x: i64,
  label: str
}

type DefaultBox<T> {
  DefaultBox(T)
}

impl Default for DefaultPoint {
  fn default() -> Self {
    DefaultPoint { x: 42, label: "origin" }
  }
}

impl<T: Default> Default for DefaultBox<T> {
  fn default() -> Self {
    DefaultBox<T>(default<T>())
  }
}

fn default_box_value<T>(box: DefaultBox<T>) -> T {
  match box {
    DefaultBox(value) -> value
  }
}

fn make_associated<T: Default>() -> T {
  T.default()
}

fn make_forwarded<T: Default>() -> T {
  default<T>()
}

test "default_numeric_implementations_cover_every_primitive" {
  let i8_value: i8 = default<i8>()
  let i16_value: i16 = default<i16>()
  let i32_value: i32 = default<i32>()
  let i64_value: i64 = default<i64>()
  let isize_value: isize = default<isize>()
  let u8_value: u8 = default<u8>()
  let u16_value: u16 = default<u16>()
  let u32_value: u32 = default<u32>()
  let u64_value: u64 = default<u64>()
  let usize_value: usize = default<usize>()
  let f32_value: f32 = default<f32>()
  let f64_value: f64 = default<f64>()
  Test.assert_eq(i8_value == 0, 1)
  Test.assert_eq(i16_value == 0, 1)
  Test.assert_eq(i32_value == 0, 1)
  Test.assert_eq(i64_value == 0, 1)
  Test.assert_eq(isize_value == 0, 1)
  Test.assert_eq(u8_value == 0, 1)
  Test.assert_eq(u16_value == 0, 1)
  Test.assert_eq(u32_value == 0, 1)
  Test.assert_eq(u64_value == 0, 1)
  Test.assert_eq(usize_value == 0, 1)
  Test.assert_eq(f32_value == 0.0, 1)
  Test.assert_eq(f64_value == 0.0, 1)
}

test "default_scalar_implementations_are_canonical" {
  let bool_value: bool = default<bool>()
  let str_value: str = default<str>()
  let nil_value: nil = default<nil>()
  Test.assert_false(bool_value)
  Test.assert_str_eq(str_value, "")
  Test.assert_eq(nil_value == nil, 1)
}

test "default_dispatches_to_user_implementation" {
  let point: DefaultPoint = default<DefaultPoint>()
  Test.assert_eq(point.x, 42)
  Test.assert_str_eq(point.label, "origin")
}

test "default_type_qualified_call_dispatches_through_bound" {
  let point: DefaultPoint = make_associated<DefaultPoint>()
  Test.assert_eq(point.x, 42)
  Test.assert_str_eq(point.label, "origin")
}

test "default_bounds_survive_generic_forwarding" {
  let point: DefaultPoint = make_forwarded<DefaultPoint>()
  Test.assert_eq(point.x, 42)
  Test.assert_str_eq(point.label, "origin")
}

test "default_generic_impl_composes_recursively" {
  let int_box: DefaultBox<i64> = default<DefaultBox<i64>>()
  let point_box: DefaultBox<DefaultPoint> = default<DefaultBox<DefaultPoint>>()
  Test.assert_eq(default_box_value<i64>(int_box), 0)
  Test.assert_eq(default_box_value<DefaultPoint>(point_box).x, 42)
}

test "default_option_is_none_without_payload_bound" {
  let value: Option<DefaultPoint> = default<Option<DefaultPoint>>()
  Test.assert_eq(value.is_none(), 1)
}

test "default_list_is_empty_without_element_bound" {
  let value: List<DefaultPoint> = default<List<DefaultPoint>>()
  Test.assert_eq(value.len(), 0)
}

test "default_nested_collections_preserve_full_type_identity" {
  let value: Option<List<Option<str>>> = default<Option<List<Option<str>>>>()
  Test.assert_eq(value.is_none(), 1)
}
