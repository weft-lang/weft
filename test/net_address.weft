use stdlib/display.{Display}
use stdlib/eq.{Eq}
use stdlib/net_address.{AddressParseEmpty, AddressParseError, AddressParseInvalid, AddressParseLeadingZero, AddressParseMissingPort, AddressParseOutOfRange, AddressParsePartCount, IpAddress, IpV4, IpV6, Ipv4Address, Ipv6Address, SocketAddress, SocketV4, SocketV6, ip_address_parse, ipv4_address, ipv4_address_parse, ipv6_address, ipv6_address_parse, socket_address_parse}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}

fn net_test_u8(value: u8) -> i64 { __u64_to_i64(__u8_to_u64(value)) }

fn net_test_u16(value: u16) -> i64 { __u64_to_i64(__u16_to_u64(value)) }

fn net_test_u32(value: u32) -> i64 { __u64_to_i64(__u32_to_u64(value)) }

fn net_test_ipv4_text(result: Result<Ipv4Address, AddressParseError>) -> str {
  match result {
    Ok(address) -> address.display()
    Err(_) -> "<error>"
  }
}

fn net_test_ipv6_text(result: Result<Ipv6Address, AddressParseError>) -> str {
  match result {
    Ok(address) -> address.display()
    Err(_) -> "<error>"
  }
}

fn net_test_socket_text(result: Result<SocketAddress, AddressParseError>) -> str {
  match result {
    Ok(address) -> address.display()
    Err(_) -> "<error>"
  }
}

fn net_test_is_empty<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParseEmpty(actual)) -> actual == offset
    _ -> false
  }
}

fn net_test_is_invalid<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParseInvalid(actual)) -> actual == offset
    _ -> false
  }
}

fn net_test_is_out_of_range<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParseOutOfRange(actual)) -> actual == offset
    _ -> false
  }
}

fn net_test_is_leading_zero<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParseLeadingZero(actual)) -> actual == offset
    _ -> false
  }
}

fn net_test_is_part_count<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParsePartCount(actual)) -> actual == offset
    _ -> false
  }
}

fn net_test_is_missing_port<T>(result: Result<T, AddressParseError>, offset: i64) -> bool {
  match result {
    Err(AddressParseMissingPort(actual)) -> actual == offset
    _ -> false
  }
}

test "IPv4 values preserve exact octets and bounds" {
  let address = ipv4_address(0, 1, 254, 255)
  match address.octet(0) {
    Some(value) -> Test.assert_eq(net_test_u8(value), 0)
    None -> Test.assert_eq(0, 1)
  }
  match address.octet(1) {
    Some(value) -> Test.assert_eq(net_test_u8(value), 1)
    None -> Test.assert_eq(0, 1)
  }
  match address.octet(2) {
    Some(value) -> Test.assert_eq(net_test_u8(value), 254)
    None -> Test.assert_eq(0, 1)
  }
  match address.octet(3) {
    Some(value) -> Test.assert_eq(net_test_u8(value), 255)
    None -> Test.assert_eq(0, 1)
  }
  match address.octet(4) {
    Some(_) -> Test.assert_eq(0, 1)
    None -> Test.assert_eq(1, 1)
  }
  Test.assert_str_eq(address.display(), "0.1.254.255")
}

test "IPv6 values preserve exact segments and bounds" {
  let address = ipv6_address(0, 1, 15, 255, 4095, 65535, 8193, 3512)
  match address.segment(0) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 0)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(5) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 65535)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(1) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 1)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(2) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 15)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(3) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 255)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(4) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 4095)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(6) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 8193)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(7) {
    Some(value) -> Test.assert_eq(net_test_u16(value), 3512)
    None -> Test.assert_eq(0, 1)
  }
  match address.segment(8) {
    Some(_) -> Test.assert_eq(0, 1)
    None -> Test.assert_eq(1, 1)
  }
}

test "address equality includes family port and IPv6 scope" {
  let v4 = ipv4_address(127, 0, 0, 1)
  let other_v4 = ipv4_address(127, 0, 0, 2)
  let v6 = ipv6_address(0, 0, 0, 0, 0, 0, 0, 1)
  Test.assert_true(v4.eq(ipv4_address(127, 0, 0, 1)))
  Test.assert_false(v4.eq(other_v4))
  Test.assert_true(v6.eq(ipv6_address(0, 0, 0, 0, 0, 0, 0, 1)))
  Test.assert_false(v6.eq(ipv6_address(0, 0, 0, 0, 0, 0, 0, 2)))
  Test.assert_true(IpV4(v4).eq(IpV4(ipv4_address(127, 0, 0, 1))))
  Test.assert_true(IpV6(v6).eq(IpV6(ipv6_address(0, 0, 0, 0, 0, 0, 0, 1))))
  Test.assert_false(IpV4(v4).eq(IpV6(v6)))
  Test.assert_true(SocketV4(v4, 80).eq(SocketV4(v4, 80)))
  Test.assert_false(SocketV4(v4, 80).eq(SocketV4(v4, 81)))
  Test.assert_false(SocketV4(v4, 80).eq(SocketV6(v6, 80, 0)))
  Test.assert_false(SocketV6(v6, 80, 1).eq(SocketV6(v6, 81, 1)))
  Test.assert_false(SocketV6(v6, 80, 1).eq(SocketV6(ipv6_address(0, 0, 0, 0, 0, 0, 0, 2), 80, 1)))
  Test.assert_false(SocketV6(v6, 80, 1).eq(SocketV6(v6, 80, 2)))
}

test "IPv4 parsing accepts exact decimal boundaries" {
  Test.assert_str_eq(net_test_ipv4_text(ipv4_address_parse("0.0.0.0")), "0.0.0.0")
  Test.assert_str_eq(net_test_ipv4_text(ipv4_address_parse("127.0.0.1")), "127.0.0.1")
  Test.assert_str_eq(net_test_ipv4_text(ipv4_address_parse("255.255.255.255")), "255.255.255.255")
}

test "IPv4 parsing reports every failure family precisely" {
  Test.assert_true(net_test_is_empty<Ipv4Address>(ipv4_address_parse(""), 0))
  Test.assert_true(net_test_is_part_count<Ipv4Address>(ipv4_address_parse("1.2.3"), 5))
  Test.assert_true(net_test_is_part_count<Ipv4Address>(ipv4_address_parse("1.2.3.4.5"), 7))
  Test.assert_true(net_test_is_invalid<Ipv4Address>(ipv4_address_parse("1..2.3"), 2))
  Test.assert_true(net_test_is_invalid<Ipv4Address>(ipv4_address_parse("1.2.3.x"), 6))
  Test.assert_true(net_test_is_out_of_range<Ipv4Address>(ipv4_address_parse("256.0.0.1"), 2))
  Test.assert_true(net_test_is_leading_zero<Ipv4Address>(ipv4_address_parse("01.2.3.4"), 1))
}

test "IPv6 display follows RFC 5952 zero and case rules" {
  Test.assert_str_eq(ipv6_address(0, 0, 0, 0, 0, 0, 0, 0).display(), "::")
  Test.assert_str_eq(ipv6_address(0, 0, 0, 0, 0, 0, 0, 1).display(), "::1")
  Test.assert_str_eq(ipv6_address(8193, 3512, 0, 0, 1, 0, 0, 1).display(), "2001:db8::1:0:0:1")
  Test.assert_str_eq(ipv6_address(8193, 3512, 0, 1, 2, 3, 4, 5).display(), "2001:db8:0:1:2:3:4:5")
  Test.assert_str_eq(ipv6_address(8193, 3512, 1, 0, 0, 0, 0, 0).display(), "2001:db8:1::")
  Test.assert_str_eq(ipv6_address(1, 0, 0, 2, 0, 0, 3, 4).display(), "1::2:0:0:3:4")
  Test.assert_str_eq(ipv6_address(0, 0, 0, 0, 0, 65535, 49152, 513).display(), "::ffff:192.0.2.1")
}

test "IPv6 parsing accepts full compressed and mixed spellings" {
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("::")), "::")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("::1")), "::1")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("2001:0DB8:0000:0000:0001:0000:0000:0001")), "2001:db8::1:0:0:1")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("2001:db8::1")), "2001:db8::1")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("1::")), "1::")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("0:1:2:3:4:5:6:7")), "0:1:2:3:4:5:6:7")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("1:2:3:4:5:6:192.0.2.1")), "1:2:3:4:5:6:c000:201")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("::ffff:192.0.2.128")), "::ffff:192.0.2.128")
  Test.assert_str_eq(net_test_ipv6_text(ipv6_address_parse("::192.0.2.128")), "::192.0.2.128")
}

test "IPv6 parsing rejects malformed compression groups and mixed tails" {
  Test.assert_true(net_test_is_empty<Ipv6Address>(ipv6_address_parse(""), 0))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse(":1"), 0))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse("1::2::3"), 4))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse(":::"), 2))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse("1:2::3:"), 6))
  Test.assert_true(net_test_is_part_count<Ipv6Address>(ipv6_address_parse("1:2:3:4:5:6:7"), 13))
  Test.assert_true(net_test_is_part_count<Ipv6Address>(ipv6_address_parse("1:2:3:4:5:6:7:8:9"), 16))
  Test.assert_true(net_test_is_out_of_range<Ipv6Address>(ipv6_address_parse("12345::"), 4))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse("1:2:3:4:5:6:g:8"), 12))
  Test.assert_true(net_test_is_invalid<Ipv6Address>(ipv6_address_parse("::192.0.2.1:7"), 11))
  Test.assert_true(net_test_is_part_count<Ipv6Address>(ipv6_address_parse("1:2:3:4:5:6:7:192.0.2.1"), 14))
  Test.assert_true(net_test_is_out_of_range<Ipv6Address>(ipv6_address_parse("::ffff:192.0.2.999"), 17))
}

test "family parser preserves the address alternative" {
  match ip_address_parse("192.0.2.1") {
    Ok(IpV4(address)) -> Test.assert_str_eq(address.display(), "192.0.2.1")
    _ -> Test.assert_eq(0, 1)
  }
  match ip_address_parse("2001:db8::1") {
    Ok(IpV6(address)) -> Test.assert_str_eq(address.display(), "2001:db8::1")
    _ -> Test.assert_eq(0, 1)
  }
}

test "socket parsing preserves family port and numeric scope" {
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("127.0.0.1:0")), "127.0.0.1:0")
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("192.0.2.1:65535")), "192.0.2.1:65535")
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("[::1]:443")), "[::1]:443")
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("[fe80::1%7]:8080")), "[fe80::1%7]:8080")
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("[fe80::1%0]:8080")), "[fe80::1]:8080")
  Test.assert_str_eq(net_test_socket_text(socket_address_parse("[fe80::1%4294967295]:65535")), "[fe80::1%4294967295]:65535")
}

test "socket alternatives expose exact numeric fields" {
  match socket_address_parse("192.0.2.1:8080") {
    Ok(SocketV4(address, port)) -> {
      Test.assert_str_eq(address.display(), "192.0.2.1")
      Test.assert_eq(net_test_u16(port), 8080)
    }
    _ -> Test.assert_eq(0, 1)
  }
  match socket_address_parse("[fe80::1%42]:443") {
    Ok(SocketV6(address, port, scope)) -> {
      Test.assert_str_eq(address.display(), "fe80::1")
      Test.assert_eq(net_test_u16(port), 443)
      Test.assert_eq(net_test_u32(scope), 42)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "socket parsing reports absent invalid and overflowing components" {
  Test.assert_true(net_test_is_empty<SocketAddress>(socket_address_parse(""), 0))
  Test.assert_true(net_test_is_missing_port<SocketAddress>(socket_address_parse("127.0.0.1"), 9))
  Test.assert_true(net_test_is_missing_port<SocketAddress>(socket_address_parse("127.0.0.1:"), 10))
  Test.assert_true(net_test_is_invalid<SocketAddress>(socket_address_parse("::1:80"), 0))
  Test.assert_true(net_test_is_out_of_range<SocketAddress>(socket_address_parse("127.0.0.1:65536"), 14))
  Test.assert_true(net_test_is_invalid<SocketAddress>(socket_address_parse("[::1"), 4))
  Test.assert_true(net_test_is_missing_port<SocketAddress>(socket_address_parse("[::1]"), 5))
  Test.assert_true(net_test_is_invalid<SocketAddress>(socket_address_parse("[::1]x:80"), 5))
  Test.assert_true(net_test_is_missing_port<SocketAddress>(socket_address_parse("[::1]:"), 6))
  Test.assert_true(net_test_is_invalid<SocketAddress>(socket_address_parse("[::1%zone]:80"), 5))
  Test.assert_true(net_test_is_out_of_range<SocketAddress>(socket_address_parse("[::1%4294967296]:80"), 14))
  Test.assert_true(net_test_is_invalid<SocketAddress>(socket_address_parse("[::1%1%2]:80"), 6))
}
