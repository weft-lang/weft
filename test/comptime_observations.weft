use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/comptime as comptime
use stdlib/comptime.{ComptimeFileObservation}
use stdlib/file as file
use stdlib/file.{FileRead}
use stdlib/io/types.{IoError, IoNotFound}
use stdlib/list.{Cons, Nil}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}

effect ComptimeOffset {
  fn read() -> i64
}

fn comptime_test_path(text: str) -> Path {
  path.from_utf8(text).unwrap()
}

fn comptime_test_text(outcome: Result<Bytes, IoError>) -> str {
  match outcome {
    Ok(content) -> content.to_utf8().unwrap()
    Err(_) -> ""
  }
}

test "compile-time observation forwards reads and preserves source order" {
  let first = comptime_test_path("schema/users.json")
  let second = comptime_test_path("schema/orders.json")
  let evaluation = handle comptime.observe_file_reads(() => {
    let users = file.read_text(first, 128).unwrap()
    let orders = file.read_text(second, 256).unwrap()
    users.concat(orders)
  }) {
    FileRead.read_all(actual, limit) -> if actual.eq(first) {
      resume(Ok<Bytes, IoError>(bytes.from_str("users")))
    } else {
      resume(Ok<Bytes, IoError>(bytes.from_str("orders")))
    }
  }

  Test.assert_str_eq(evaluation.value, "usersorders")
  match evaluation.file_observations {
    Cons({ path: actual_first, limit: first_limit, outcome: first_outcome }, Cons({ path: actual_second, limit: second_limit, outcome: second_outcome }, Nil)) -> {
      Test.assert_true(actual_first.eq(first))
      Test.assert_eq_usize(first_limit, 128)
      Test.assert_str_eq(comptime_test_text(first_outcome), "users")
      Test.assert_true(actual_second.eq(second))
      Test.assert_eq_usize(second_limit, 256)
      Test.assert_str_eq(comptime_test_text(second_outcome), "orders")
    }
    _ -> Test.assert_true(false)
  }
}

test "compile-time observation retains typed read failures" {
  let missing = comptime_test_path("schema/missing.json")
  let evaluation = handle comptime.observe_file_reads(() => file.read_all(missing, 64)) {
    FileRead.read_all(actual, limit) -> resume(Err<Bytes, IoError>(IoNotFound))
  }
  Test.assert_true(match evaluation.value { Err(IoNotFound) -> true, _ -> false })
  Test.assert_true(match evaluation.file_observations {
    Cons({ path: actual, limit: observed_limit, outcome: Err(IoNotFound) }, Nil) ->
      actual.eq(missing) and observed_limit == 64
    _ -> false
  })
}

test "compile-time observation preserves unrelated residual effects" {
  let schema = comptime_test_path("schema/value.json")
  let evaluation = handle {
    handle comptime.observe_file_reads(() => {
      file.read_text(schema, 32).unwrap().len().to_u64().to_i64_checked().unwrap_or(0) + ComptimeOffset.read()
    }) {
      FileRead.read_all(actual, limit) -> resume(Ok<Bytes, IoError>(bytes.from_str("data")))
    }
  } {
    ComptimeOffset.read() -> resume(38)
  }
  Test.assert_eq(evaluation.value, 42)
}

test "repeated compile-time reads remain distinct observations" {
  let schema = comptime_test_path("schema/repeated.json")
  let evaluation = handle comptime.observe_file_reads(() => {
    let first = file.read_all(schema, 8)
    let second = file.read_all(schema, 16)
    2
  }) {
    FileRead.read_all(actual, limit) -> resume(Ok<Bytes, IoError>(bytes.from_str("same")))
  }
  Test.assert_eq(evaluation.value, 2)
  match evaluation.file_observations {
    Cons({ path: _, limit: first, outcome: _ }, Cons({ path: _, limit: second, outcome: _ }, Nil)) -> {
      Test.assert_eq_usize(first, 8)
      Test.assert_eq_usize(second, 16)
    }
    _ -> Test.assert_true(false)
  }
}
