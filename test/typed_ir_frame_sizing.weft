-- test/typed_ir_frame_sizing.weft -- typed-IR native frame sizing

use compiler/codegen.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}

test "typed_ir_frame_size_grows_for_high_spill_counter" {
  let insts = ir_inst_list_prepend(ir_inst_const_i64(900, 1), ir_inst_list_empty())
  let block = ir_block_new_term(0, insts, ir_term_return(900))
  let blocks = ir_block_list_prepend(block, ir_block_list_empty())
  let frame = pipeline_ir_native_frame_size_for_blocks(0, blocks)
  Test.assert_eq(if frame >= 7152 { 1 } else { 0 }, 1)
  Test.assert_eq(frame % 16, 0)
}

test "typed_ir_frame_size_includes_jump_argument_temps" {
  let args = ir_value_list_prepend(0, ir_value_list_prepend(1, ir_value_list_prepend(2, ir_value_list_empty())))
  let params = ir_value_list_prepend(500, ir_value_list_prepend(501, ir_value_list_prepend(502, ir_value_list_empty())))
  let entry = ir_block_new_term(0, ir_inst_list_empty(), ir_term_jump_args(1, args))
  let exit = ir_block_new_params(1, params, ir_inst_list_empty(), ir_term_return(500))
  let blocks = ir_block_list_prepend(entry, ir_block_list_prepend(exit, ir_block_list_empty()))
  let frame = pipeline_ir_native_frame_size_for_blocks(3, blocks)
  Test.assert_eq(if frame >= 4048 { 1 } else { 0 }, 1)
  Test.assert_eq(frame % 16, 0)
}
