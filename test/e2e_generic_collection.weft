-- Generic collections: combines generics, traits, monomorphisation, for-in, List, Map
-- Expected exit code: 42
use "stdlib/list.weft"
use "stdlib/map.weft"
use "stdlib/eq.weft"

trait Summable {
  fn add_to(self: i64, acc: i64) -> i64
}

impl Summable for i64 {
  fn add_to(self: i64, acc: i64) -> i64 { acc + self }
}

fn sum_list<T: Summable>(xs: i64) -> i64 {
  let mut total: i64 = 0
  for x in xs {
    total = x.add_to(total)
  }
  total
}

fn main() -> i64 {
  -- Sum a list using a generic function with trait bound
  let xs = Cons<i64>(10, Cons<i64>(12, Cons<i64>(20, Nil)))
  sum_list<i64>(xs)
}
