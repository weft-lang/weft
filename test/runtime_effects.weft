use "runtime/effects.weft"

test "runtime_effects_layout_constants" {
  Test.assert_eq(handler_frame_size(), 32)
  Test.assert_eq(handler_frame_eff_hash_offset(), 0)
  Test.assert_eq(handler_frame_num_ops_offset(), 8)
  Test.assert_eq(handler_frame_ops_offset(), 16)
  Test.assert_eq(handler_frame_prev_offset(), 24)
  Test.assert_eq(handler_ops_entry_size(), 24)
  Test.assert_eq(handler_ops_op_hash_offset(), 0)
  Test.assert_eq(handler_ops_fn_ptr_offset(), 8)
  Test.assert_eq(handler_ops_env_ptr_offset(), 16)
}

test "runtime_effects_lookup_single_frame" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let frame = handler_frame_new(11, 1, ops, 0)
  let entry = handler_find_entry(frame, 11, 22)
  let closure = handler_lookup(frame, 11, 22)
  Test.assert_eq(handler_ops_entry_fn_ptr(entry), 333)
  Test.assert_eq(handler_ops_entry_env_ptr(entry), 444)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_multiple_ops" {
  let ops = handler_ops_new(2)
  handler_ops_set(ops, 0, 22, 333, 444)
  handler_ops_set(ops, 1, 23, 555, 666)
  let frame = handler_frame_new(11, 2, ops, 0)
  let closure = handler_lookup(frame, 11, 23)
  Test.assert_eq(handler_closure_fn_ptr(closure), 555)
  Test.assert_eq(handler_closure_env_ptr(closure), 666)
}

test "runtime_effects_lookup_walks_nested_frames" {
  let outer_ops = handler_ops_new(1)
  handler_ops_set(outer_ops, 0, 22, 333, 444)
  let outer = handler_frame_new(11, 1, outer_ops, 0)
  let inner_ops = handler_ops_new(1)
  handler_ops_set(inner_ops, 0, 99, 777, 888)
  let inner = handler_frame_new(12, 1, inner_ops, outer)
  let closure = handler_lookup(inner, 11, 22)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_skips_missing_op_in_matching_frame" {
  let outer_ops = handler_ops_new(1)
  handler_ops_set(outer_ops, 0, 22, 333, 444)
  let outer = handler_frame_new(11, 1, outer_ops, 0)
  let inner_ops = handler_ops_new(1)
  handler_ops_set(inner_ops, 0, 99, 777, 888)
  let inner = handler_frame_new(11, 1, inner_ops, outer)
  let closure = handler_lookup(inner, 11, 22)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_missing_paths" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let frame = handler_frame_new(11, 1, ops, 0)
  Test.assert_eq(handler_find_entry(0, 11, 22), 0)
  Test.assert_eq(handler_find_entry(frame, 12, 22), 0)
  Test.assert_eq(handler_find_entry(frame, 11, 23), 0)
  Test.assert_eq(handler_lookup(0, 11, 22), 0)
  Test.assert_eq(handler_lookup(frame, 12, 22), 0)
  Test.assert_eq(handler_lookup(frame, 11, 23), 0)
}

test "runtime_effects_frame_accessors" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let prev = handler_frame_new(10, 0, 0, 0)
  let frame = handler_frame_new(11, 1, ops, prev)
  let entry = handler_ops_entry(ops, 0)
  Test.assert_eq(handler_frame_eff_hash(frame), 11)
  Test.assert_eq(handler_frame_num_ops(frame), 1)
  Test.assert_eq(handler_frame_ops(frame), ops)
  Test.assert_eq(handler_frame_prev(frame), prev)
  Test.assert_eq(handler_ops_entry_op_hash(entry), 22)
  Test.assert_eq(handler_ops_entry_fn_ptr(entry), 333)
  Test.assert_eq(handler_ops_entry_env_ptr(entry), 444)
}
