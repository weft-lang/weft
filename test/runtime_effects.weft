use "runtime/effects.weft"

test "runtime_effects_layout_constants" {
  Test.assert_eq(handler_frame_size(), 32)
  Test.assert_eq(handler_frame_eff_hash_offset(), 0)
  Test.assert_eq(handler_frame_num_ops_offset(), 8)
  Test.assert_eq(handler_frame_ops_offset(), 16)
  Test.assert_eq(handler_frame_prev_offset(), 24)
  Test.assert_eq(handler_ops_entry_size(), 24)
  Test.assert_eq(handler_ops_op_hash_offset(), 0)
  Test.assert_eq(handler_ops_fn_ptr_offset(), 8)
  Test.assert_eq(handler_ops_env_ptr_offset(), 16)
  Test.assert_eq(continuation_record_size(), 64)
  Test.assert_eq(continuation_status_offset(), 0)
  Test.assert_eq(continuation_cleanup_fn_offset(), 8)
  Test.assert_eq(continuation_cleanup_env_offset(), 16)
  Test.assert_eq(continuation_segment_offset(), 24)
  Test.assert_eq(continuation_saved_sp_offset(), 32)
  Test.assert_eq(continuation_saved_fp_offset(), 40)
  Test.assert_eq(continuation_resume_value_offset(), 48)
  Test.assert_eq(continuation_flags_offset(), 56)
}

test "runtime_effects_lookup_single_frame" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let frame = handler_frame_new(11, 1, ops, 0)
  let entry = handler_find_entry(frame, 11, 22)
  let closure = handler_lookup(frame, 11, 22)
  Test.assert_eq(handler_ops_entry_fn_ptr(entry), 333)
  Test.assert_eq(handler_ops_entry_env_ptr(entry), 444)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_multiple_ops" {
  let ops = handler_ops_new(2)
  handler_ops_set(ops, 0, 22, 333, 444)
  handler_ops_set(ops, 1, 23, 555, 666)
  let frame = handler_frame_new(11, 2, ops, 0)
  let closure = handler_lookup(frame, 11, 23)
  Test.assert_eq(handler_closure_fn_ptr(closure), 555)
  Test.assert_eq(handler_closure_env_ptr(closure), 666)
}

test "runtime_effects_lookup_walks_nested_frames" {
  let outer_ops = handler_ops_new(1)
  handler_ops_set(outer_ops, 0, 22, 333, 444)
  let outer = handler_frame_new(11, 1, outer_ops, 0)
  let inner_ops = handler_ops_new(1)
  handler_ops_set(inner_ops, 0, 99, 777, 888)
  let inner = handler_frame_new(12, 1, inner_ops, outer)
  let closure = handler_lookup(inner, 11, 22)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_skips_missing_op_in_matching_frame" {
  let outer_ops = handler_ops_new(1)
  handler_ops_set(outer_ops, 0, 22, 333, 444)
  let outer = handler_frame_new(11, 1, outer_ops, 0)
  let inner_ops = handler_ops_new(1)
  handler_ops_set(inner_ops, 0, 99, 777, 888)
  let inner = handler_frame_new(11, 1, inner_ops, outer)
  let closure = handler_lookup(inner, 11, 22)
  Test.assert_eq(handler_closure_fn_ptr(closure), 333)
  Test.assert_eq(handler_closure_env_ptr(closure), 444)
}

test "runtime_effects_lookup_missing_paths" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let frame = handler_frame_new(11, 1, ops, 0)
  Test.assert_eq(handler_find_entry(0, 11, 22), 0)
  Test.assert_eq(handler_find_entry(frame, 12, 22), 0)
  Test.assert_eq(handler_find_entry(frame, 11, 23), 0)
  Test.assert_eq(handler_lookup(0, 11, 22), 0)
  Test.assert_eq(handler_lookup(frame, 12, 22), 0)
  Test.assert_eq(handler_lookup(frame, 11, 23), 0)
}

test "runtime_effects_frame_accessors" {
  let ops = handler_ops_new(1)
  handler_ops_set(ops, 0, 22, 333, 444)
  let prev = handler_frame_new(10, 0, 0, 0)
  let frame = handler_frame_new(11, 1, ops, prev)
  let entry = handler_ops_entry(ops, 0)
  Test.assert_eq(handler_frame_eff_hash(frame), 11)
  Test.assert_eq(handler_frame_num_ops(frame), 1)
  Test.assert_eq(handler_frame_ops(frame), ops)
  Test.assert_eq(handler_frame_prev(frame), prev)
  Test.assert_eq(handler_ops_entry_op_hash(entry), 22)
  Test.assert_eq(handler_ops_entry_fn_ptr(entry), 333)
  Test.assert_eq(handler_ops_entry_env_ptr(entry), 444)
}

test "runtime_effects_continuation_record_defaults" {
  let k = continuation_new_noop()
  Test.assert_eq(continuation_status(k), continuation_status_active())
  Test.assert_eq(continuation_cleanup_fn(k), 0)
  Test.assert_eq(continuation_cleanup_env(k), 0)
  Test.assert_eq(continuation_segment(k), 0)
  Test.assert_eq(continuation_saved_sp(k), 0)
  Test.assert_eq(continuation_saved_fp(k), 0)
  Test.assert_eq(continuation_resume_value(k), 0)
  Test.assert_eq(continuation_flags(k), 0)
  Test.assert_eq(continuation_cleanup_needed(k), 0)
}

test "runtime_effects_continuation_cleanup_metadata" {
  let k = continuation_new(1234, 5678)
  Test.assert_eq(continuation_cleanup_fn(k), 1234)
  Test.assert_eq(continuation_cleanup_env(k), 5678)
  Test.assert_eq(continuation_cleanup_needed(k), 1)
}

test "runtime_effects_continuation_segment_metadata" {
  let k = continuation_new_noop()
  Test.assert_eq(continuation_set_segment(k, 11, 22, 33), 1)
  Test.assert_eq(continuation_set_resume_value(k, 44), 1)
  Test.assert_eq(continuation_set_flags(k, 55), 1)
  Test.assert_eq(continuation_segment(k), 11)
  Test.assert_eq(continuation_saved_sp(k), 22)
  Test.assert_eq(continuation_saved_fp(k), 33)
  Test.assert_eq(continuation_resume_value(k), 44)
  Test.assert_eq(continuation_flags(k), 55)
  Test.assert_eq(continuation_cleanup_needed(k), 1)
}

test "runtime_effects_continuation_mark_resumed_is_one_shot" {
  let k = continuation_new_noop()
  Test.assert_eq(continuation_mark_resumed(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_resumed())
  Test.assert_eq(continuation_mark_resumed(k), 0)
  Test.assert_eq(continuation_drop(k), 0)
}

test "runtime_effects_continuation_drop_is_one_shot" {
  let k = continuation_new_noop()
  Test.assert_eq(continuation_drop(k), 1)
  Test.assert_eq(continuation_status(k), continuation_status_dropped())
  Test.assert_eq(continuation_drop(k), 0)
  Test.assert_eq(continuation_mark_resumed(k), 0)
}

test "runtime_effects_continuation_null_is_inert" {
  Test.assert_eq(continuation_status(0), 0 - 1)
  Test.assert_eq(continuation_mark_resumed(0), 0)
  Test.assert_eq(continuation_drop(0), 0)
  Test.assert_eq(continuation_set_segment(0, 1, 2, 3), 0)
  Test.assert_eq(continuation_set_resume_value(0, 4), 0)
  Test.assert_eq(continuation_set_flags(0, 5), 0)
  Test.assert_eq(continuation_cleanup_needed(0), 0)
}
