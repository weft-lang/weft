-- The stage operation of weft-grammar-tool/1: a check request names no
-- operation and a response without a stage member answers a check, so every
-- exchange an older peer understands is unchanged; a stage request carries
-- its target and a response its stage outcome, in the protocol's own
-- vocabulary, round-tripping exactly.

use stdlib/diagnostic/schema.{Diagnostic}
use stdlib/grammar/tooling.{GrammarFileContext, GrammarHostTypesContext}
use stdlib/grammar/tooling/conformance.{ParseOutcomeParsed, ParseOutcomeRejected}
use stdlib/grammar/tooling/protocol.{*}
use stdlib/grammar/tooling/staging.{StagingCapability, StagingTypedPlan, StagingValidateOnly}
use stdlib/json.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}
use stdlib/string.{str_concat}

fn grammar() -> ToolGrammar {
  ToolGrammar {
    package_name: "weft",
    export: "toy",
    module: "module_fixtures/toy_grammar",
    declaration: "AssignmentGrammar"
  }
}

fn sink() -> Path { path.from_utf8(".weft/staging/1-1").unwrap() }

fn stage_request(capability: StagingCapability) -> ToolRequest {
  ToolRequest {
    grammar: grammar(),
    source_name: "embedded",
    source_text: "count = 3",
    context: ToolHostContext,
    operation: ToolOperationStage(
      ToolStageTarget { capability: capability, platform: "macos-aarch64", sink: sink() }
    )
  }
}

fn check_request() -> ToolRequest {
  ToolRequest {
    grammar: grammar(),
    source_name: "embedded",
    source_text: "count = 3",
    context: ToolHostContext,
    operation: ToolOperationCheck
  }
}

fn rendered_request(request: ToolRequest) -> str {
  match encode_request(request) {
    Ok(document) -> render_line(document)
    Err(error) -> str_concat("<", error_message(error))
  }
}

fn decoded_request(text: str) -> Result<ToolRequest, ToolProtocolError> {
  match parse_line(text) {
    Ok(document) -> decode_request(document)
    Err(error) -> Err<ToolRequest, ToolProtocolError>(error)
  }
}

fn operation_name(operation: ToolOperation) -> str {
  match operation {
    ToolOperationCheck -> "check"
    ToolOperationStage(target) -> {
      let capability = match target.capability {
        StagingValidateOnly -> "validate_only"
        StagingTypedPlan -> "typed_plan"
      }
      "stage "
        |> str_concat(capability)
        |> str_concat(" ")
        |> str_concat(target.platform)
        |> str_concat(" ")
        |> str_concat(target.sink.to_utf8().unwrap_or("?"))
    }
  }
}

fn response_with(stage: ToolStageOutcome) -> ToolResponse {
  ToolResponse {
    grammar: grammar(),
    parse: ParseOutcomeParsed,
    check: ToolChecked,
    stage: stage,
    diagnostics: Nil<Diagnostic>(),
    observed_inputs: Nil<ToolObservedInput>()
  }
}

fn rendered_response(response: ToolResponse) -> str {
  match encode_response(response) {
    Ok(document) -> render_line(document)
    Err(error) -> str_concat("<", error_message(error))
  }
}

fn decoded_response(text: str) -> Result<ToolResponse, ToolProtocolError> {
  match parse_line(text) {
    Ok(document) -> decode_response(document)
    Err(error) -> Err<ToolResponse, ToolProtocolError>(error)
  }
}

fn stage_text(stage: ToolStageOutcome) -> str {
  match stage {
    ToolStageNotRequested -> "not_requested"
    ToolStaged(artifact) -> "staged "
      |> str_concat(__u64_to_i64(__usize_to_u64(artifact.size)).to_str())
      |> str_concat(" ")
      |> str_concat(artifact.content)
      |> str_concat(" ")
      |> str_concat(__u64_to_i64(__usize_to_u64(artifact.budget)).to_str())
      |> str_concat(" ")
      |> str_concat(artifact.facts.stringify().unwrap_or("?"))
    ToolStagedNothing -> "staged_nothing"
    ToolStageRefusedParseNotAccepted -> "refused parse_not_accepted"
    ToolStageRefusedCheckRejected -> "refused check_rejected"
    ToolStageRefusedNoStaging -> "refused no_staging"
    ToolStageRefusedNoTooling -> "refused no_tooling"
    ToolStageContextUnavailable -> "context_unavailable"
    ToolStageContextUnsupported(GrammarHostTypesContext) -> "unsupported host_types"
    ToolStageContextUnsupported(GrammarFileContext) -> "unsupported file"
    ToolStageUnsupportedTarget -> "unsupported target"
    ToolStageSinkRefused(name) -> str_concat("sink_refused ", name)
  }
}

fn round_trip(stage: ToolStageOutcome) -> str {
  match decoded_response(rendered_response(response_with(stage))) {
    Ok(response) -> stage_text(response.stage)
    Err(error) -> str_concat("<", error_message(error))
  }
}

test "a check request names no operation and decodes as a check" {
  let line = rendered_request(check_request())
  Test.assert_true(not line.contains("\"operation\""))
  Test.assert_true(not line.contains("\"target\""))
  match decoded_request(line) {
    Ok(request) -> Test.assert_str_eq(operation_name(request.operation), "check")
    Err(_) -> Test.assert_true(false)
  }
  -- An explicit check operation is accepted too.
  match decoded_request(
    "{\"protocol\":\"weft-grammar-tool/1\",\"grammar\":{\"package\":\"weft\",\"export\":\"toy\",\"module\":\"m\",\"declaration\":\"D\"},\"source\":{\"name\":\"embedded\",\"text\":\"count = 3\"},\"context\":{\"kind\":\"host\"},\"operation\":\"check\"}\n"
  ) {
    Ok(request) -> Test.assert_str_eq(operation_name(request.operation), "check")
    Err(_) -> Test.assert_true(false)
  }
}

test "a stage request carries its operation and target and round trips" {
  let line = rendered_request(stage_request(StagingTypedPlan))
  Test.assert_true(
    line.contains(
      "\"operation\":\"stage\",\"target\":{\"capability\":\"typed_plan\",\"platform\":\"macos-aarch64\",\"sink\":\".weft/staging/1-1\"}"
    )
  )
  match decoded_request(line) {
    Ok(request) -> Test.assert_str_eq(
      operation_name(request.operation),
      "stage typed_plan macos-aarch64 .weft/staging/1-1"
    )
    Err(_) -> Test.assert_true(false)
  }
  match decoded_request(rendered_request(stage_request(StagingValidateOnly))) {
    Ok(request) -> Test.assert_str_eq(
      operation_name(request.operation),
      "stage validate_only macos-aarch64 .weft/staging/1-1"
    )
    Err(_) -> Test.assert_true(false)
  }
}

fn request_shape(operation_and_target: str) -> str {
  let text = "{\"protocol\":\"weft-grammar-tool/1\",\"grammar\":{\"package\":\"weft\",\"export\":\"toy\",\"module\":\"m\",\"declaration\":\"D\"},\"source\":{\"name\":\"embedded\",\"text\":\"count = 3\"},\"context\":{\"kind\":\"host\"},"
    |> str_concat(operation_and_target)
    |> str_concat("}\n")
  match decoded_request(text) {
    Ok(request) -> operation_name(request.operation)
    Err(error) -> error_message(error)
  }
}

test "a malformed stage request is a structured protocol error" {
  Test.assert_str_eq(
    request_shape("\"operation\":\"stage\""),
    "grammar tool protocol: request needs target"
  )
  Test.assert_str_eq(
    request_shape("\"operation\":\"deploy\""),
    "grammar tool protocol: request needs operation"
  )
  Test.assert_str_eq(
    request_shape("\"operation\":7"),
    "grammar tool protocol: request needs operation"
  )
  Test.assert_str_eq(
    request_shape(
      "\"operation\":\"stage\",\"target\":{\"capability\":\"executable\",\"platform\":\"p\",\"sink\":\"s\"}"
    ),
    "grammar tool protocol: target needs capability"
  )
  Test.assert_str_eq(
    request_shape(
      "\"operation\":\"stage\",\"target\":{\"capability\":\"typed_plan\",\"sink\":\"s\"}"
    ),
    "grammar tool protocol: target needs platform"
  )
  Test.assert_str_eq(
    request_shape(
      "\"operation\":\"stage\",\"target\":{\"capability\":\"typed_plan\",\"platform\":\"p\"}"
    ),
    "grammar tool protocol: target needs sink"
  )
}

test "every stage outcome round trips through the response line" {
  let facts = JsonObject(Cons(JsonEntry("key", JsonString("count")), Nil<JsonEntry>()))
  Test.assert_str_eq(
    round_trip(
      ToolStaged(
        ToolStagedArtifact {
          size: __i64_to_usize(27),
          content: "sha256:abc",
          budget: __i64_to_usize(4096),
          facts: facts
        }
      )
    ),
    "staged 27 sha256:abc 4096 {\"key\":\"count\"}"
  )
  Test.assert_str_eq(round_trip(ToolStageNotRequested), "not_requested")
  Test.assert_str_eq(round_trip(ToolStagedNothing), "staged_nothing")
  Test.assert_str_eq(round_trip(ToolStageRefusedParseNotAccepted), "refused parse_not_accepted")
  Test.assert_str_eq(round_trip(ToolStageRefusedCheckRejected), "refused check_rejected")
  Test.assert_str_eq(round_trip(ToolStageRefusedNoStaging), "refused no_staging")
  Test.assert_str_eq(round_trip(ToolStageRefusedNoTooling), "refused no_tooling")
  Test.assert_str_eq(round_trip(ToolStageContextUnavailable), "context_unavailable")
  Test.assert_str_eq(
    round_trip(ToolStageContextUnsupported(GrammarHostTypesContext)),
    "unsupported host_types"
  )
  Test.assert_str_eq(
    round_trip(ToolStageContextUnsupported(GrammarFileContext)),
    "unsupported file"
  )
  Test.assert_str_eq(round_trip(ToolStageUnsupportedTarget), "unsupported target")
  Test.assert_str_eq(
    round_trip(ToolStageSinkRefused("limit_exceeded")),
    "sink_refused limit_exceeded"
  )
}

test "the stage member is additive on the wire" {
  let line = rendered_response(response_with(ToolStageNotRequested))
  Test.assert_true(
    line.contains("\"check\":\"checked\",\"stage\":\"not_requested\",\"diagnostics\":[]")
  )
  -- A response without the member answers a check.
  match decoded_response(
    "{\"response\":\"weft-grammar-tool/1\",\"grammar\":{\"package\":\"weft\",\"export\":\"toy\",\"module\":\"module_fixtures/toy_grammar\",\"declaration\":\"AssignmentGrammar\"},\"parse\":\"parsed\",\"check\":\"checked\",\"diagnostics\":[],\"observed_inputs\":[]}\n"
  ) {
    Ok(response) -> Test.assert_str_eq(stage_text(response.stage), "not_requested")
    Err(_) -> Test.assert_true(false)
  }
  let staged = rendered_response(
    response_with(
      ToolStaged(
        ToolStagedArtifact {
          size: __i64_to_usize(1),
          content: "sha256:0",
          budget: __i64_to_usize(2),
          facts: JsonNull
        }
      )
    )
  )
  Test.assert_true(
    staged.contains(
      "\"stage\":{\"staged\":{\"size\":1,\"content\":\"sha256:0\",\"budget\":2,\"facts\":null}}"
    )
  )
}

fn response_shape(stage_json: str) -> str {
  let text = "{\"response\":\"weft-grammar-tool/1\",\"grammar\":{\"package\":\"weft\",\"export\":\"toy\",\"module\":\"module_fixtures/toy_grammar\",\"declaration\":\"AssignmentGrammar\"},\"parse\":\"parsed\",\"check\":\"checked\",\"stage\":"
    |> str_concat(stage_json)
    |> str_concat(",\"diagnostics\":[],\"observed_inputs\":[]}\n")
  match decoded_response(text) {
    Ok(response) -> stage_text(response.stage)
    Err(error) -> error_message(error)
  }
}

test "a malformed stage member is a structured protocol error" {
  Test.assert_str_eq(
    response_shape("\"deployed\""),
    "grammar tool protocol: response needs stage"
  )
  Test.assert_str_eq(response_shape("7"), "grammar tool protocol: response needs stage")
  Test.assert_str_eq(response_shape("{}"), "grammar tool protocol: response needs stage")
  Test.assert_str_eq(
    response_shape("{\"refused\":\"tired\"}"),
    "grammar tool protocol: stage needs refused"
  )
  Test.assert_str_eq(
    response_shape("{\"unsupported\":\"weather\"}"),
    "grammar tool protocol: stage needs unsupported"
  )
  Test.assert_str_eq(
    response_shape("{\"unsupported\":{\"context\":\"clipboard\"}}"),
    "grammar tool protocol: check needs unsupported"
  )
  Test.assert_str_eq(
    response_shape("{\"staged\":{\"size\":1,\"content\":\"sha256:0\",\"facts\":null}}"),
    "grammar tool protocol: staged needs budget"
  )
  Test.assert_str_eq(
    response_shape("{\"staged\":{\"size\":1,\"content\":\"sha256:0\",\"budget\":2}}"),
    "grammar tool protocol: staged needs facts"
  )
  Test.assert_str_eq(
    response_shape("{\"sink_refused\":3}"),
    "grammar tool protocol: response needs stage"
  )
}
