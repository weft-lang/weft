use stdlib/console.{ConsoleWrite, println}
use stdlib/io/types.{IoError, IoPermissionDenied}
use stdlib/result.{result_err, result_ok}

fn main() -> nil {
  handle println("unwritable") {
    ConsoleWrite.write_all(stream, values) -> resume(result_err<usize, IoError>(IoPermissionDenied))
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
}
