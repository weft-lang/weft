use stdlib/console.{ConsoleWrite, println}
use stdlib/io/types.{IoError, IoPermissionDenied}
use stdlib/result.{Err, Ok}

fn main() -> nil {
  handle println("unwritable") {
    ConsoleWrite.write_all(stream, values) -> resume(Err<usize, IoError>(IoPermissionDenied))
    ConsoleWrite.flush(stream) -> resume(Ok<nil, IoError>(nil))
  }
}
