use stdlib/test.{*}
use runtime/alloc.{*}
use runtime/rc_implicit_test.{*}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}
use stdlib/map.{Map, persistent_map_new, persistent_map_put}
use stdlib/num
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/set.{Set, persistent_set_add, persistent_set_contains, persistent_set_new}
use stdlib/string.{*}

fn metric_build_vector(count: i64) -> i64 {
  let mut v: PersistentVector<i64> = persistent_vector.new<i64>()
  for i in 0..count {
    v = v.push(i)
  }
  v.get((count - 1).to_usize_checked().expect("metric count is positive")).unwrap_or(0 - 1)
}

fn metric_build_map(count: i64) -> i64 {
  let mut m: Map<i64, i64> = persistent_map_new<i64, i64>()
  for i in 0..count {
    m = persistent_map_put(m, i, i + 1000)
  }
  m.get(count - 1).unwrap_or(0 - 1)
}

fn metric_build_set(count: i64) -> i64 {
  let mut s: Set<i64> = persistent_set_new<i64>()
  for i in 0..count {
    s = persistent_set_add(s, i)
  }
  persistent_set_contains(s, count - 1)
}

fn metric_build_string_vector(count: i64) -> i64 {
  let mut v: PersistentVector<str> = persistent_vector.new<str>()
  for i in 0..count {
    v = v.push(str_concat("item-", int_to_str(i)))
  }
  let updated = v.set(0, str_concat("updated-", int_to_str(count))).expect("non-empty vector")
  str_len(updated.get(0).unwrap_or(""))
}

fn metric_build_string_map(count: i64) -> i64 {
  let mut map = persistent_map_new<str, str>()
  for i in 0..count {
    map = persistent_map_put<str, str>(map, str_concat("key-", int_to_str(i)), str_concat("value-", int_to_str(i)))
  }
  let updated = persistent_map_put<str, str>(map, str_concat("key-", int_to_str(0)), str_concat("updated-", int_to_str(count)))
  str_len(updated.get(str_concat("key-", int_to_str(0))).unwrap_or(""))
}

fn metric_build_string_set(count: i64) -> i64 {
  let mut set = persistent_set_new<str>()
  for i in 0..count {
    set = persistent_set_add<str>(set, str_concat("item-", int_to_str(i)))
  }
  persistent_set_contains<str>(set, str_concat("item-", int_to_str(count - 1)))
}

fn metric_warm_collection_lifetimes() -> i64 {
  for i in 0..20 {
    metric_build_vector(100)
    metric_build_map(100)
    metric_build_set(100)
    metric_build_string_vector(40)
    metric_build_string_map(40)
    metric_build_string_set(40)
  }
  0
}

test "metric_vector_completed_lifetime_retains_no_bump_bytes" {
  let before = alloc_bump_mark()
  let answer = metric_build_vector(100)
  let after = alloc_bump_mark()
  Test.assert_eq(answer, 99)
  -- Mechanism ledger: 100 pushes retained 32,024 bump bytes when every
  -- path copy was process-lifetime storage; the last version now drops
  -- its shared structural region, so the exact retained bump cost is 0.
  Test.assert_eq(after - before, 0)
}

test "metric_map_completed_lifetime_retains_no_bump_bytes" {
  let before = alloc_bump_mark()
  let answer = metric_build_map(100)
  let after = alloc_bump_mark()
  Test.assert_eq(answer, 1099)
  -- Mechanism ledger: the bump-backed CHAMP retained 36,888 bytes for
  -- this lifetime; all nodes now belong to the last-version region.
  Test.assert_eq(after - before, 0)
}

test "metric_set_completed_lifetime_retains_no_bump_bytes" {
  let before = alloc_bump_mark()
  let answer = metric_build_set(100)
  let after = alloc_bump_mark()
  Test.assert_eq(answer, 1)
  -- Mechanism ledger: Set shares Map's CHAMP representation and moved
  -- from the same measured 36,888 retained bytes to a reclaimed region.
  Test.assert_eq(after - before, 0)
}

test "metric_collection_regions_and_managed_elements_reuse_default_heap" {
  metric_warm_collection_lifetimes()
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(metric_build_string_vector(40), 10)
  Test.assert_eq(metric_build_string_map(40), 10)
  Test.assert_eq(metric_build_string_set(40), 1)
  metric_warm_collection_lifetimes()
  let after = runtime_rc_test_heap_arena_offset()
  -- Mechanism ledger: one warm batch populates the root-handle and managed
  -- payload bins; an identical batch must reuse them while every mmap region
  -- and its typed payload ledger are released.
  Test.assert_eq(after - before, 0)
}
