use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/diagnostic
use stdlib/diagnostic/registry as registry
use stdlib/diagnostic/schema.{DiagnosticCodeAssigned, DiagnosticCodeUnassigned}
use stdlib/option.{None, Some, Option}
use stdlib/string

type RegistryExpectation { code: str, class: str, summary: str }

test "diagnostic catalogue preserves every assigned code class summary and append position" {
  let expected = [
  RegistryExpectation { code: "E4001", class: "module", summary: "module import graph contains a cycle" },
    RegistryExpectation { code: "E4002", class: "module", summary: "qualified module member does not exist" },
    RegistryExpectation { code: "E4003", class: "module", summary: "qualified module member is ambiguous" },
    RegistryExpectation { code: "E4004", class: "module", summary: "qualified module member is not visible" },
    RegistryExpectation { code: "E4005", class: "module", summary: "module member has the wrong value kind" },
    RegistryExpectation { code: "E4006", class: "module", summary: "re-export widens the original visibility" },
    RegistryExpectation { code: "E5001", class: "link", summary: "dependency manifest is malformed" },
    RegistryExpectation { code: "E5002", class: "link", summary: "dependency key does not match its package name" },
    RegistryExpectation { code: "E5003", class: "link", summary: "dependency resolves to conflicting source identities" },
    RegistryExpectation { code: "E5004", class: "link", summary: "package dependency graph contains a cycle" },
    RegistryExpectation { code: "E5005", class: "link", summary: "package lock is malformed or unsupported" },
    RegistryExpectation { code: "E5006", class: "link", summary: "resolved package identity does not match the lock" },
    RegistryExpectation { code: "E5007", class: "link", summary: "dependency manifest attempts to grant package trust" },
    RegistryExpectation { code: "E5008", class: "link", summary: "binding module lacks an exact root trust grant" },
    RegistryExpectation { code: "E5009", class: "link", summary: "package export does not resolve to the required public declaration" },
    RegistryExpectation { code: "W0001", class: "parse", summary: "identifier contains mixed scripts" },
    RegistryExpectation { code: "W0002", class: "parse", summary: "identifier is confusable with another spelling in this source" },
    RegistryExpectation { code: "W0003", class: "parse", summary: "source text contains an invisible bidi formatting control" },
    RegistryExpectation { code: "E1001", class: "type", summary: "name is not defined in this scope" },
    RegistryExpectation { code: "E1002", class: "type", summary: "expression does not match the expected type" },
    RegistryExpectation { code: "E1003", class: "type", summary: "match does not cover every possible value" },
    RegistryExpectation { code: "E2001", class: "effect", summary: "required effect is not available in this context" },
    RegistryExpectation { code: "E1004", class: "type", summary: "type does not satisfy a required trait" },
    RegistryExpectation { code: "E0001", class: "parse", summary: "source text cannot be tokenized as Weft" },
    RegistryExpectation { code: "E0002", class: "parse", summary: "source tokens do not match the Weft grammar" },
    RegistryExpectation { code: "E0003", class: "parse", summary: "syntax is recognized but not supported" },
    RegistryExpectation { code: "E1005", class: "type", summary: "module constant is not a compile-time value" },
    RegistryExpectation { code: "E5010", class: "link", summary: "native binding has no declaration for the compilation target" },
    RegistryExpectation { code: "E5011", class: "link", summary: "locked dependency is absent from the package cache" },
    RegistryExpectation { code: "E5012", class: "link", summary: "immutable package cache content is corrupt" },
    RegistryExpectation { code: "E5013", class: "link", summary: "locked package source acquisition was refused" },
    RegistryExpectation { code: "E5014", class: "link", summary: "trusted dependency update requires explicit capability review" },
    RegistryExpectation { code: "E9001", class: "test", summary: "property is falsified by a reproducible choice program" },
    RegistryExpectation { code: "E9002", class: "test", summary: "property generation exhausted its bounded discard budget" },
    RegistryExpectation { code: "E9003", class: "test", summary: "Draw handler returned a choice outside its promised domain" },
    RegistryExpectation { code: "E5015", class: "link", summary: "embedded SDK is corrupt or incompatible" },
    RegistryExpectation { code: "E5016", class: "link", summary: "canonical SDK path is unavailable" },
    RegistryExpectation { code: "E5017", class: "link", summary: "SDK manifest is malformed or incompatible" },
    RegistryExpectation { code: "E2002", class: "effect", summary: "handler continuation is used more than once" },
    RegistryExpectation { code: "E1006", class: "type", summary: "operation requires runtime discrimination" },
  ]
  Test.assert_eq_usize(registry.len(), 40)
  let origin: usize = 0
  for index in origin..registry.len() {
    let wanted = expected[index]
    let actual = registry.get(index).unwrap()
    match actual.code {
      DiagnosticCodeAssigned(code) -> Test.assert_str_eq(code, wanted.code)
      DiagnosticCodeUnassigned -> Test.assert_true(false)
    }
    Test.assert_str_eq(actual.class.name(), wanted.class)
    Test.assert_str_eq(actual.summary, wanted.summary)
  }
}

fn registry_lookup_churn() -> bool {
  let origin: usize = 0
  for index in origin..registry.len() {
    let entry = registry.get(index).unwrap()
    match entry.code {
      DiagnosticCodeAssigned(code) -> if code.len() != 5 { return false }
      DiagnosticCodeUnassigned -> return false
    }
    if entry.summary.is_empty() or entry.explanation.len() < 180 { return false }
  }
  match registry.get(18446744073709551615) { None -> true Some(entry) -> false }
}

test "diagnostic catalogue records and their code payloads reuse managed storage" {
  Test.assert_true(registry_lookup_churn())
  for _ in 0..40 { registry_lookup_churn() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { Test.assert_true(registry_lookup_churn()) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}
