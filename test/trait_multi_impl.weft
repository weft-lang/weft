-- Multiple impl blocks with same method name on different types
-- Type-aware method resolution: f.val() resolves to Foo's impl,
-- b.val() resolves to Bar's impl.
-- Expected exit code: 42
type Foo { x: i64 }
type Bar { y: i64 }

impl Foo {
  fn val(self: i64) -> i64 { __mem_load64(self) }
}

impl Bar {
  fn val(self: i64) -> i64 { __mem_load64(self) + 10 }
}

fn main() -> i64 {
  let f = Foo { x: 20 }
  let b = Bar { y: 12 }
  f.val() + b.val()
}
