-- provenance_table.weft - embedded table survives Mach-O object relocation.

use runtime/provenance.{*}

test "linked_object_provenance_table" {
  let count = runtime_native_provenance_count()
  let msg = __str_ptr("ok\n")
  let written = __got_write(1, msg, 3, 0, 0, 0)
  Test.assert_eq(written, 3)
  Test.assert_eq(if count > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if runtime_native_provenance_file_count() > 0 { 1 } else { 0 }, 1)
}
