use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/result
use stdlib/string

type Packet { name: str, value: Bytes, code: i64 }
type Envelope { packet: Packet, trailer: str }
type ArrayPacket { values: [str; 2], trailer: str }

fn packet() -> Packet {
  Packet { name: "name".concat("!"), value: bytes.from_str("payload"), code: 7 }
}
fn payload() -> Bytes {
  Envelope { packet: packet(), trailer: "tail".concat("!") }.packet.value
}
fn array_packet() -> ArrayPacket {
  ArrayPacket { values: ["first".concat("!"), "last".concat("!")], trailer: "tail".concat("!") }
}
fn structural_array_packet(text: str) -> {values: [str; 2], trailer: str} {
  {values: [text.concat("!"), text.concat("?")], trailer: "tail".concat("!")}
}

fn loop_projection_length() -> usize {
  let mut total: usize = 0
  for index in 0..4 {
    let current = match index {
      0 -> continue
      3 -> break
      _ -> structural_array_packet("first")
    }
    total = total + current.values[0].len()
  }
  total
}

fn main() -> i64 {
  let retained = payload()
  let copied = array_packet().values
  for _ in 0..200 { packet(); array_packet() }
  if retained.to_utf8().unwrap() != "payload" { return 1 }
  if copied[0] != "first!" or copied[1] != "last!" { return 2 }
  if packet().code != 7 { return 3 }
  let shared = packet()
  for choose in [true, false] {
    if (if choose { shared } else { packet() }).value.len() != 7 { return 4 }
  }
  if shared.name != "name!" { return 5 }
  let lanes = structural_array_packet("first").values
  for _ in 0..20 { structural_array_packet("overwritten") }
  if lanes[0] != "first!" or lanes[1] != "first?" { return 6 }
  let source = structural_array_packet("first")
  let mut edited = source.values
  edited[0] = "changed"
  if source.values[0] != "first!" or edited[0] != "changed" { return 7 }
  if loop_projection_length() != 12 { return 8 }
  0
}
