use stdlib/bytes as bytes
use stdlib/http as http
use stdlib/http.{HttpHeader, HttpHeaders}
use stdlib/iter as iter
use stdlib/iter.{IntoIterator, Iterator}
use stdlib/option
use stdlib/result

fn cookie(value: str) -> HttpHeader {
  http.header(http.parse_field_name("Set-Cookie").unwrap(), bytes.from_str(value)).unwrap()
}

fn cookies() -> HttpHeaders {
  http.headers().append(cookie("a=1")).append(cookie("b=2"))
}

fn retained_cursor() -> owned Iterator<HttpHeader> { cookies().into_iter() }

fn early_count(headers: HttpHeaders) -> usize {
  let mut count: usize = 0
  for _ in headers {
    count = count + 1
    return count
  }
  count
}

fn main() -> i64 {
  let headers = cookies()
  if headers.len() != 2 or headers.is_empty() { return 1 }
  if headers.get(18446744073709551615).is_some() { return 2 }
  let count = headers
    |> iter.filter((field: HttpHeader) => field.name().text() == "set-cookie")
    |> iter.count()
  if count != 2 or early_count(headers) != 1 { return 3 }
  let mut cursor = retained_cursor()
  if cursor.next().unwrap().value().to_utf8().unwrap() != "a=1" { return 4 }
  if cursor.next().unwrap().value().to_utf8().unwrap() != "b=2" { return 5 }
  if cursor.next().is_some() { return 6 }
  cursor.close()
  0
}
