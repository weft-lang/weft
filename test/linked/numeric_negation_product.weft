use stdlib/num as num
use stdlib/num.{*}

type Temperature = opaque f32
type Reading { value: Temperature }
effect Sample { fn read() -> f32 }

fn negate32(value: f32) -> f32 { -value }
fn negate64(value: f64) -> f64 { -value }
fn sample() -[Sample]> f32 { -Sample.read() }

fn main() -> i64 {
  let zero: f32 = -0.0
  if zero.to_bits() != 2147483648 { return 1 }
  let reading = [Reading { value: Temperature(-0.0) }]
  match reading[0].value {
    Temperature(value) -> if value.to_bits() != 2147483648 { return 2 }
  }
  let bits32: u32 = 2139169605
  if negate32(num.f32_from_bits(bits32)).to_bits() != (bits32 bxor 2147483648) { return 3 }
  let bits64: u64 = 9218899782287415996
  if negate64(num.f64_from_bits(bits64)).to_bits() != (bits64 bxor 9223372036854775808) { return 4 }
  let resumed = handle sample() { Sample.read() -> resume(0.0) }
  if resumed.to_bits() != 2147483648 { return 5 }
  let negative_zero = num.f64_from_bits(9223372036854775808)
  if negate64(negative_zero).to_bits() != 0 { return 6 }
  0
}
