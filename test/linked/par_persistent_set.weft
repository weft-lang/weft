-- test/linked/par_persistent_set.weft - managed persistent set roots at Par boundaries.

use "stdlib/set.weft"
use "stdlib/par.weft"
use "runtime/rc.weft"

fn pps_worker(s: i64) -> i64 {
  rc_is_promoted(s) * 100 + persistent_set_contains(s, 9) * 10 + persistent_set_contains(s, 3)
}

test "par_spawn_promotes_persistent_set_root" {
  let empty: rc i64 = persistent_set_new()
  let s: rc i64 = persistent_set_add(persistent_set_add(empty, 9), 3)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = Par.spawn(pps_worker, s)
    Par.await(h)
  })
  Test.assert_eq(got * 10 + rc_is_promoted(s), 1111)
}
