-- test/linked/par_persistent_set.weft - managed persistent set roots at Par boundaries.

use stdlib/set.{*}
use "stdlib/par.weft"

fn pps_worker(s: Set<i64>) -> i64 {
  persistent_set_is_promoted(s) * 100 + persistent_set_contains(s, 9) * 10 + persistent_set_contains(s, 3)
}

test "par_spawn_promotes_persistent_set_root" {
  let empty: Set<i64> = persistent_set_new<i64>()
  let s: Set<i64> = persistent_set_add(persistent_set_add(empty, 9), 3)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = par_spawn<i64>(() => pps_worker(s))
    par_await<i64>(h)
  })
  Test.assert_eq(got * 10 + persistent_set_is_promoted(s), 1111)
}
