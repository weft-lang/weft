-- test/linked/env_proc.weft — Env/Proc capability effects: real spawns
-- through the trusted platform handler, and handler mocks proving the
-- capabilities are ordinary effects that tests can intercept.

use compiler/lib.{*}
use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/safe_env.{runtime_platform_env, runtime_platform_env_with}
use runtime/safe_process.{runtime_platform_proc}
use stdlib/env.{Env}
use stdlib/string.{*}
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/result.{Err, Ok, Result}

fn proc_result_status(result: Result<ProcTermination, ProcError>) -> i64 {
  match result {
    Ok(termination) -> match termination {
      ProcExited(status) -> status
      ProcSignaled(signal) -> 128 + signal
    }
    Err(error) -> 0 - 1
  }
}

fn spawn_true() -[Proc]> i64 {
  proc_result_status(Proc.run("/usr/bin/true", Nil<str>()))
}

fn spawn_false() -[Proc]> i64 {
  proc_result_status(Proc.run("/usr/bin/false", Nil<str>()))
}

fn spawn_sh_exit(code_text: str) -[Proc]> i64 {
  proc_result_status(Proc.run("/bin/sh", Cons<str>("-c", Cons<str>(str_concat("exit ", code_text), Nil<str>()))))
}

test "proc_platform_true_exits_zero" {
  Test.assert_eq(runtime_platform_proc(2, env_fixture_argv(), () => spawn_true()), 0)
}

test "proc_platform_false_exits_one" {
  Test.assert_eq(runtime_platform_proc(2, env_fixture_argv(), () => spawn_false()), 1)
}

test "proc_platform_sh_argument_marshalling" {
  -- The exit code round-trips through the marshalled -c argument, so a
  -- wrong char** layout cannot pass this.
  Test.assert_eq(runtime_platform_proc(2, env_fixture_argv(), () => spawn_sh_exit("42")), 42)
}

fn count_probe() -[Env]> i64 {
  Env.arg_count()
}

fn arg_len_probe(index: i64) -[Env]> i64 {
  match Env.arg(index) {
    nil -> 0 - 1
    value: str -> __str_len(value)
  }
}

fn env_fixture_cstr(value: str) -> i64 {
  let result = alloc_zeroed(__str_len(value) + 1)
  mem_copy(result, __str_ptr(value), __str_len(value))
  result
}

test "env_mock_injects_arguments" {
  let n = handle count_probe() {
    Env.arg_count() -> resume(3)
    Env.arg(index) -> resume("mocked")
  }
  Test.assert_eq(n, 3)
  let l = handle arg_len_probe(0) {
    Env.arg_count() -> resume(3)
    Env.arg(index) -> resume("mocked")
  }
  Test.assert_eq(l, 6)
  let missing = handle arg_len_probe(0) {
    Env.arg_count() -> resume(0)
    Env.arg(index) -> resume(nil)
  }
  Test.assert_eq(missing, 0 - 1)
}

fn env_fixture_argv() -> i64 {
  let argv = alloc_zeroed(56)
  mem_store64_at(argv, 0, env_fixture_cstr("env-probe"))
  mem_store64_at(argv, 8, env_fixture_cstr(""))
  mem_store64_at(argv, 16, 0)
  mem_store64_at(argv, 24, env_fixture_cstr("X"))
  mem_store64_at(argv, 32, env_fixture_cstr("WEFT_ENV_PRESENT=fixture"))
  mem_store64_at(argv, 40, env_fixture_cstr("WEFT_ENV_EMPTY="))
  mem_store64_at(argv, 48, 0)
  argv
}

test "env_platform_distinguishes_empty_arguments_from_missing_indices" {
  let argv = env_fixture_argv()
  Test.assert_eq(runtime_platform_env(2, argv, () => arg_len_probe(0)), 9)
  Test.assert_eq(runtime_platform_env(2, argv, () => arg_len_probe(1)), 0)
  Test.assert_eq(runtime_platform_env(2, argv, () => arg_len_probe(2)), 0 - 1)
  Test.assert_eq(runtime_platform_env(2, argv, () => arg_len_probe(0 - 1)), 0 - 1)
}

fn env_var_len(name: str) -[Env]> i64 {
  match Env.var(name) {
    nil -> 0 - 1
    value: str -> __str_len(value)
  }
}

test "env_platform_reads_present_variable" {
  let len = runtime_platform_env(
    2,
    env_fixture_argv(),
    () => env_var_len("WEFT_ENV_PRESENT")
  )
  Test.assert_eq(len, 7)
}

test "env_platform_preserves_present_empty_variable" {
  let len = runtime_platform_env(
    2,
    env_fixture_argv(),
    () => env_var_len("WEFT_ENV_EMPTY")
  )
  Test.assert_eq(len, 0)
}

test "env_platform_reports_missing_variable_as_nil" {
  let len = runtime_platform_env(
    2,
    env_fixture_argv(),
    () => env_var_len("WEFT_4I_DEFINITELY_MISSING_7C43F1")
  )
  Test.assert_eq(len, 0 - 1)
}

test "env_platform_rejects_empty_and equals-containing names" {
  let argv = env_fixture_argv()
  Test.assert_eq(runtime_platform_env(2, argv, () => env_var_len("")), 0 - 1)
  Test.assert_eq(runtime_platform_env(2, argv, () => env_var_len("WEFT_ENV_PRESENT=fixture")), 0 - 1)
}

fn env_var_mock_probe() -[Env]> i64 {
  match Env.var("mock") {
    nil -> 0
    value: str -> __str_len(value)
  }
}

test "env_var_remains_mockable" {
  let got = handle env_var_mock_probe() {
    Env.var(name) -> resume("injected")
  }
  Test.assert_eq(got, 8)
}

effect EnvProbe {
  fn inspect(value: i64) -> i64
}

fn env_residual_probe() -[Env, EnvProbe]> i64 {
  EnvProbe.inspect(Env.arg_count())
}

test "env_platform_handler_preserves_residual_effects" {
  let got = handle runtime_platform_env_with(
    2,
    env_fixture_argv(),
    env_residual_probe
  ) {
    EnvProbe.inspect(value) -> resume(value + 40)
  }
  Test.assert_eq(got, 42)
}

fn record_spawn(log: i64) -[Proc]> i64 {
  proc_result_status(Proc.run("/bin/echo", Cons<str>("hello", Nil<str>())))
}

test "proc_mock_intercepts_spawn" {
  -- A mock handler observes the request and no process runs.
  let log = nlist_new()
  let r = handle record_spawn(log) {
    Proc.run(path, args) -> {
      nlist_add(log, __str_len(path))
      resume(Ok<ProcTermination, ProcError>(ProcExited(7)))
    }
  }
  Test.assert_eq(r, 7)
  Test.assert_eq(nlist_len(log), 1)
  Test.assert_eq(nlist_get(log, 0), 9)
}
