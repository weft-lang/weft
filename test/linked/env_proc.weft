-- test/linked/env_proc.weft — Env/Proc capability effects: real spawns
-- through the trusted platform handler, and handler mocks proving the
-- capabilities are ordinary effects that tests can intercept.

use "compiler/lib.weft"
use "stdlib/string.weft"
use "stdlib/list.weft"
use "stdlib/process.weft"

fn spawn_true() -[Proc]> i64 {
  Proc.run("/usr/bin/true", list_nil<str>())
}

fn spawn_false() -[Proc]> i64 {
  Proc.run("/usr/bin/false", list_nil<str>())
}

fn spawn_sh_exit(code_text: str) -[Proc]> i64 {
  Proc.run("/bin/sh", list_cons<str>("-c", list_cons<str>(str_concat("exit ", code_text), list_nil<str>())))
}

test "proc_platform_true_exits_zero" {
  Test.assert_eq(runtime_platform_proc(() => spawn_true()), 0)
}

test "proc_platform_false_exits_one" {
  Test.assert_eq(runtime_platform_proc(() => spawn_false()), 1)
}

test "proc_platform_sh_argument_marshalling" {
  -- The exit code round-trips through the marshalled -c argument, so a
  -- wrong char** layout cannot pass this.
  Test.assert_eq(runtime_platform_proc(() => spawn_sh_exit("42")), 42)
}

fn count_probe() -[Env]> i64 {
  Env.arg_count()
}

fn arg_len_probe(index: i64) -[Env]> i64 {
  __str_len(Env.arg(index))
}

test "env_mock_injects_arguments" {
  let n = handle count_probe() {
    Env.arg_count() -> resume(3)
    Env.arg(index) -> resume("mocked")
  }
  Test.assert_eq(n, 3)
  let l = handle arg_len_probe(0) {
    Env.arg_count() -> resume(3)
    Env.arg(index) -> resume("mocked")
  }
  Test.assert_eq(l, 6)
}

fn env_var_len(name: str) -[Env]> i64 {
  let value: str | nil = Env.var(name)
  if value == nil { 0 - 1 } else { __str_len(value) }
}

test "env_platform_reads_present_variable" {
  let len = runtime_platform_env(0, 0, () => env_var_len("PATH"))
  Test.assert_eq(if len > 0 { 1 } else { 0 }, 1)
}

test "env_platform_reports_missing_variable_as_nil" {
  let len = runtime_platform_env(0, 0, () => env_var_len("WEFT_4I_DEFINITELY_MISSING_7C43F1"))
  Test.assert_eq(len, 0 - 1)
}

fn env_var_mock_probe() -[Env]> i64 {
  let value: str | nil = Env.var("mock")
  if value == nil { 0 } else { __str_len(value) }
}

test "env_var_remains_mockable" {
  let got = handle env_var_mock_probe() {
    Env.var(name) -> resume("injected")
  }
  Test.assert_eq(got, 8)
}

fn record_spawn(log: i64) -[Proc]> i64 {
  Proc.run("/bin/echo", list_cons<str>("hello", list_nil<str>()))
}

test "proc_mock_intercepts_spawn" {
  -- A mock handler observes the request and no process runs.
  let log = nlist_new()
  let r = handle record_spawn(log) {
    Proc.run(path, args) -> {
      nlist_add(log, __str_len(path))
      resume(7)
    }
  }
  Test.assert_eq(r, 7)
  Test.assert_eq(nlist_len(log), 1)
  Test.assert_eq(nlist_get(log, 0), 9)
}
