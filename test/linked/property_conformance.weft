-- Cross-target executable contract for deterministic property campaigns.

use stdlib/option.{None, Option}
use stdlib/random as random
use stdlib/result.{*}
use stdlib/test/property as prop
use stdlib/test/property.{DiscardLimitReached, Falsified, GenerationExhausted, HandlerContractViolated, Passed}
use stdlib/test/property/replay as replay
use stdlib/test/property/replay.{ChoiceBoundChanged, ChoiceProgramExhausted, GeneratorContractViolated, UnusedChoices}

fn reject_usize(value: usize) -> bool { false }

fn discard_usize(value: usize) -> Option<usize> { None<usize>() }

fn replay_failure_code(failure: replay.Failure) -> i64 {
  match failure {
    ChoiceProgramExhausted(_, _) -> 6
    ChoiceBoundChanged(_, _, _) -> 7
    UnusedChoices(_) -> 8
    replay.DiscardLimitReached(_) -> 9
    GeneratorContractViolated(_) -> 10
  }
}

fn main() -> i64 {
  let limits = prop.limits(24, 40)
  let config = prop.config(random.seed(42), 8, limits.size(), limits.discards(), 80).expect("positive case budget")
  let generator = prop.usize_below(10).expect("nonempty generator domain")
  match prop.run(config, generator, reject_usize) {
    Passed(_) -> 1
    GenerationExhausted(_) -> 2
    HandlerContractViolated(_) -> 3
    Falsified(counterexample) -> {
      let first = counterexample.choices().get(0).expect("one minimized choice")
      if counterexample.seed().value() != 42 or
        counterexample.limits().size() != 24 or
        counterexample.limits().discards() != 40 or
        first.bound().exclusive_upper() != 10 or
        first.selected() != 0 {
        4
      } else {
        match replay.run(generator, counterexample.limits(), counterexample.choices()) {
          Ok(value) -> if value != 0 {
            5
          } else {
            let constrained = prop.filter_map<usize, usize>(
              prop.constant<usize>(7),
              10,
              discard_usize
            )
            let exhausted = prop.config(random.seed(1), 1, 4, 2, 0).expect("positive case budget")
            match prop.run(exhausted, constrained, reject_usize) {
              GenerationExhausted(DiscardLimitReached(attempts)) -> if attempts == 3 { 0 } else { 11 }
              Passed(_) -> 12
              Falsified(_) -> 13
              HandlerContractViolated(_) -> 14
            }
          }
          Err(failure) -> replay_failure_code(failure)
        }
      }
    }
  }
}
