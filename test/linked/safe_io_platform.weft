-- test/linked/safe_io_platform.weft — real typed file/console/directory bridge

use compiler/native_target.{NativeLinkLinuxAarch64, NativeLinkMacosAarch64, native_link_target_host}
use runtime/safe_io.{*}
use stdlib/bytes.{*}
use stdlib/console.{*}
use stdlib/dir.{*}
use stdlib/file.{*}
use stdlib/io/types.{*}
use stdlib/num.{num_i64_to_u8_checked, num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/path.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

effect SafeIoResidual {
  fn tick() -> i64
}

fn safe_io_path(text: str) -> Path {
  match path_from_utf8(text) {
    Ok(path) -> path
    Err(error) -> safe_io_path("")
  }
}

fn safe_io_count_is(result: Result<usize, IoError>, expected: i64) -> i64 {
  match result {
    Ok(count) -> if num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(count)), 0 - 1) == expected { 1 } else { 0 }
    Err(error) -> 0
  }
}

fn safe_io_error_is<T>(result: Result<T, IoError>, expected: i64) -> i64 {
  match result {
    Ok(value) -> 0
    Err(error) -> if io_error_kind(error) == expected { 1 } else { 0 }
  }
}

fn safe_io_bytes_are(result: Result<Bytes, IoError>, expected: str) -> i64 {
  match result {
    Err(error) -> 0
    Ok(values) -> match bytes_to_utf8(values) {
      Ok(text) -> if text == expected { 1 } else { 0 }
      Err(error) -> 0
    }
  }
}

fn safe_io_remove_all(first: Path, second: Path, third: Path, fourth: Path) -[DirMutate]> i64 {
  dir_remove(first)
  dir_remove(second)
  dir_remove(third)
  dir_remove(fourth)
  0
}

fn safe_io_create_new_probe(path: Path) -[FileWrite]> i64 {
  let first = safe_io_count_is(file_create_new(path, bytes_from_str("abc")), 3)
  let second = safe_io_error_is<usize>(file_create_new(path, bytes_from_str("other")), 5)
  first + second
}

fn safe_io_append_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file_write_all(path, bytes_from_str("abc")), 3) +
    safe_io_count_is(file_append_all(path, bytes_from_str("de")), 2)
}

fn safe_io_truncate_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file_write_all(path, bytes_from_str("long")), 4) +
    safe_io_count_is(file_write_all(path, bytes_from_str("x")), 1)
}

fn safe_io_atomic_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file_write_all(path, bytes_from_str("before")), 6) +
    safe_io_count_is(file_atomic_replace(path, bytes_from_str("atomic")), 6)
}

fn safe_io_binary_payload() -> Bytes {
  let values = vector_new<u8>()
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(0), 0))
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(255), 0))
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(128), 0))
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(65), 0))
  bytes_from_vector(values)
}

fn safe_io_binary_probe(path: Path) -[FileRead, FileWrite, DirMutate]> i64 {
  dir_remove(path)
  let expected = safe_io_binary_payload()
  let wrote = safe_io_count_is(file_write_all(path, expected), 4)
  let mut identity = 0
  let mut malformed_offset = 0
  match file_read_all(path, 4) {
    Err(error) -> 0
    Ok(actual) -> {
      if bytes_equal(actual, expected) { identity = 1 } else { 0 }
    }
  }
  match file_read_text(path, 4) {
    Ok(text) -> 0
    Err(error) -> match error {
      IoTextInvalidUtf8(utf8) -> if utf8_error_offset_or(utf8, 0 - 1) == 1 { malformed_offset = 1 } else { 0 }
      _ -> 0
    }
  }
  let removed = match dir_remove(path) { Ok(value) -> 1 Err(error) -> 0 }
  wrote + identity + malformed_offset + removed
}

fn safe_io_read_probe(create: Path, append: Path, truncate: Path, atomic: Path) -[FileRead]> i64 {
  safe_io_bytes_are(file_read_all(create, 3), "abc") +
    safe_io_bytes_are(file_read_all(append, 5), "abcde") +
    safe_io_bytes_are(file_read_all(truncate, 1), "x") +
    safe_io_bytes_are(file_read_all(atomic, 6), "atomic") +
    safe_io_error_is<Bytes>(file_read_all(atomic, 5), 9)
}

test "safe file platform covers create append truncate atomic and bounds" {
  let create = safe_io_path("/tmp/weft_safe_io_create_93a71")
  let append = safe_io_path("/tmp/weft_safe_io_append_93a71")
  let truncate = safe_io_path("/tmp/weft_safe_io_truncate_93a71")
  let atomic = safe_io_path("/tmp/weft_safe_io_atomic_93a71")
  runtime_platform_dir_mutate(() => safe_io_remove_all(create, append, truncate, atomic))

  Test.assert_eq(runtime_platform_file_write(() => safe_io_create_new_probe(create)), 2)
  Test.assert_eq(runtime_platform_file_write(() => safe_io_append_probe(append)), 2)
  Test.assert_eq(runtime_platform_file_write(() => safe_io_truncate_probe(truncate)), 2)
  Test.assert_eq(runtime_platform_file_write(() => safe_io_atomic_probe(atomic)), 2)
  Test.assert_eq(runtime_platform_file_read(() => safe_io_read_probe(create, append, truncate, atomic)), 5)

  runtime_platform_dir_mutate(() => safe_io_remove_all(create, append, truncate, atomic))
}

test "safe file platform round trips binary bytes and rejects malformed text" {
  let path = safe_io_path("/tmp/weft_safe_io_binary_93a71")
  Test.assert_eq(runtime_platform_safe_io(() => safe_io_binary_probe(path)), 4)
}

fn safe_io_missing_probe(path: Path) -[FileRead]> i64 {
  safe_io_error_is<Bytes>(file_read_all(path, 64), 3)
}

test "safe file platform maps missing paths" {
  let missing = safe_io_path("/tmp/weft_safe_io_missing_93a71")
  runtime_platform_dir_mutate(() => {
    dir_remove(missing)
    0
  })
  Test.assert_eq(runtime_platform_file_read(() => safe_io_missing_probe(missing)), 1)
}

fn safe_io_non_utf8_path() -> Path {
  let values = bytes_to_vector(bytes_from_str("/tmp/weft_safe_io_bytes_"))
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(255), 0))
  match path_from_vector(values) {
    Ok(path) -> path
    Err(error) -> safe_io_path("")
  }
}

fn safe_io_non_utf8_write(path: Path) -[FileWrite]> i64 {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> match file_write_all(path, bytes_from_str("bytes")) {
      Ok(count) -> 0
      Err(error) -> if io_error_platform_code_or(error, 0) == 92 { 1 } else { 0 }
    }
    NativeLinkLinuxAarch64 -> safe_io_count_is(file_write_all(path, bytes_from_str("bytes")), 5)
  }
}

fn safe_io_non_utf8_read(path: Path) -[FileRead]> i64 {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> safe_io_error_is<Bytes>(file_read_all(path, 5), 3)
    NativeLinkLinuxAarch64 -> match file_read_all(path, 5) {
      Err(error) -> 0
      Ok(values) -> if bytes_equal(values, bytes_from_str("bytes")) { 1 } else { 0 }
    }
  }
}

test "safe file platform preserves native path-byte semantics" {
  let path = safe_io_non_utf8_path()
  runtime_platform_dir_mutate(() => {
    dir_remove(path)
    0
  })
  Test.assert_eq(runtime_platform_file_write(() => safe_io_non_utf8_write(path)), 1)
  Test.assert_eq(runtime_platform_file_read(() => safe_io_non_utf8_read(path)), 1)
  runtime_platform_dir_mutate(() => {
    dir_remove(path)
    0
  })
}

fn safe_io_dir_create(parent: Path, child: Path) -[DirMutate]> i64 {
  dir_remove(child)
  dir_remove(parent)
  let parent_ok = match dir_create(parent) { Ok(value) -> 1 Err(error) -> 0 }
  let child_ok = match dir_create(child) { Ok(value) -> 1 Err(error) -> 0 }
  parent_ok + child_ok
}

fn safe_io_dir_inspect(parent: Path, child_name: Path, child: Path) -[DirInspect]> i64 {
  let mut found = 0
  match dir_list(parent) {
    Ok(entries) -> {
      for i in 0..vector_len<Path>(entries) {
        if path_equal(vector_get_in_bounds<Path>(entries, i), child_name) { found = 1 } else { 0 }
      }
      0
    }
    Err(error) -> 0
  }
  let metadata_ok = match dir_metadata(child) {
    Ok(metadata) -> if metadata.exists and dir_kind_code(metadata.kind) == 2 { 1 } else { 0 }
    Err(error) -> 0
  }
  let current_ok = match dir_current() {
    Ok(current) -> if path_len(current) > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
  found + metadata_ok + current_ok
}

fn safe_io_dir_cleanup(parent: Path, child: Path) -[DirMutate]> i64 {
  let child_ok = match dir_remove(child) { Ok(value) -> 1 Err(error) -> 0 }
  let parent_ok = match dir_remove(parent) { Ok(value) -> 1 Err(error) -> 0 }
  child_ok + parent_ok
}

test "safe directory platform transports typed paths and metadata" {
  let parent = safe_io_path("/tmp/weft_safe_io_dir_93a71")
  let child = safe_io_path("/tmp/weft_safe_io_dir_93a71/child")
  let child_name = safe_io_path("child")
  Test.assert_eq(runtime_platform_dir_mutate(() => safe_io_dir_create(parent, child)), 2)
  Test.assert_eq(runtime_platform_dir_inspect(() => safe_io_dir_inspect(parent, child_name, child)), 3)
  Test.assert_eq(runtime_platform_dir_mutate(() => safe_io_dir_cleanup(parent, child)), 2)
}

fn safe_io_console_probe() -[ConsoleWrite]> i64 {
  safe_io_count_is(console_print(bytes_from_str("safe-stdout")), 11) +
    safe_io_count_is(console_eprint(bytes_from_str("safe-stderr")), 11) +
    match console_flush(ConsoleStdout) { Ok(value) -> 1 Err(error) -> 0 } +
    match console_flush(ConsoleStderr) { Ok(value) -> 1 Err(error) -> 0 }
}

fn safe_io_console_zero_read() -[ConsoleRead]> i64 {
  match console_read(0) {
    Ok(values) -> if bytes_len(values) == 0 { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "safe console platform writes both streams and handles zero read" {
  Test.assert_eq(runtime_platform_console_write(safe_io_console_probe), 4)
  Test.assert_eq(runtime_platform_console_read(safe_io_console_zero_read), 1)
}

fn safe_io_combined_probe(path: Path) -[FileRead, FileWrite, DirMutate]> i64 {
  dir_remove(path)
  let wrote = safe_io_count_is(file_write_all(path, bytes_from_str("combined")), 8)
  let read = safe_io_bytes_are(file_read_all(path, 8), "combined")
  let removed = match dir_remove(path) { Ok(value) -> 1 Err(error) -> 0 }
  wrote + read + removed
}

test "safe platform boundary installs the complete capability set" {
  let path = safe_io_path("/tmp/weft_safe_io_combined_93a71")
  Test.assert_eq(runtime_platform_safe_io(() => safe_io_combined_probe(path)), 3)
}

fn safe_io_residual_probe(path: Path) -[FileWrite, SafeIoResidual]> i64 {
  safe_io_count_is(file_write_all(path, bytes_from_str("tail")), 4) + SafeIoResidual.tick()
}

test "safe platform layers preserve independent residual effects" {
  let path = safe_io_path("/tmp/weft_safe_io_residual_93a71")
  runtime_platform_dir_mutate(() => {
    dir_remove(path)
    0
  })
  let got = handle runtime_platform_file_write_with(() => safe_io_residual_probe(path)) {
    SafeIoResidual.tick() -> resume(41)
  }
  Test.assert_eq(got, 42)
  runtime_platform_dir_mutate(() => {
    dir_remove(path)
    0
  })
}
