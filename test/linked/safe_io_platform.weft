-- test/linked/safe_io_platform.weft — real typed file/console/directory bridge

use compiler/native_target.{NativeLinkLinuxAarch64, NativeLinkMacosAarch64, native_link_target_host}
use runtime/console_read as console_read_handler
use runtime/console_write as console_write_handler
use runtime/dir_inspect as dir_inspect_handler
use runtime/dir_mutate as dir_mutate_handler
use runtime/file_read as file_read_handler
use runtime/file_write as file_write_handler
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, InvalidUtf8}
use stdlib/console.{*}
use stdlib/dir as dir
use stdlib/dir.{DirDirectory, DirInspect, DirMutate}
use stdlib/file as file
use stdlib/file.{FileRead, FileWrite}
use stdlib/io/types.{*}
use stdlib/num.{num_i64_to_u8_checked, num_u64_to_i64_checked}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

effect SafeIoResidual {
  fn tick() -> i64
}

fn safe_io_path(text: str) -> Path {
  match path.from_utf8(text) {
    Ok(path) -> path
    Err(error) -> safe_io_path("")
  }
}

fn safe_io_count_is(result: Result<usize, IoError>, expected: i64) -> i64 {
  match result {
    Ok(count) -> if num_u64_to_i64_checked(count.to_u64()).unwrap_or(0 - 1) == expected { 1 } else { 0 }
    Err(error) -> 0
  }
}

fn safe_io_error_code(error: IoError) -> i64 {
  match error {
    IoInterrupted -> 1
    IoWouldBlock -> 2
    IoNotFound -> 3
    IoPermissionDenied -> 4
    IoAlreadyExists -> 5
    IoWrongKind -> 6
    IoInvalidPath -> 7
    IoPlatform(code) -> 8
    IoLimitExceeded(limit) -> 9
    IoUnexpectedEof(received) -> 10
    IoInvalidProgress -> 11
  }
}

fn safe_io_error_is<T>(result: Result<T, IoError>, expected: i64) -> i64 {
  match result {
    Ok(value) -> 0
    Err(error) -> if safe_io_error_code(error) == expected { 1 } else { 0 }
  }
}

fn safe_io_bytes_are(result: Result<Bytes, IoError>, expected: str) -> i64 {
  match result {
    Err(error) -> 0
    Ok(values) -> match values.to_utf8() {
      Ok(text) -> if text == expected { 1 } else { 0 }
      Err(error) -> 0
    }
  }
}

fn safe_io_remove_all(first: Path, second: Path, third: Path, fourth: Path) -[DirMutate]> i64 {
  dir.remove(first)
  dir.remove(second)
  dir.remove(third)
  dir.remove(fourth)
  0
}

fn safe_io_create_new_probe(path: Path) -[FileWrite]> i64 {
  let first = safe_io_count_is(file.create_new(path, bytes.from_str("abc")), 3)
  let second = safe_io_error_is<usize>(file.create_new(path, bytes.from_str("other")), 5)
  first + second
}

fn safe_io_append_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file.write_all(path, bytes.from_str("abc")), 3) +
    safe_io_count_is(file.append_all(path, bytes.from_str("de")), 2)
}

fn safe_io_truncate_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file.write_all(path, bytes.from_str("long")), 4) +
    safe_io_count_is(file.write_all(path, bytes.from_str("x")), 1)
}

fn safe_io_atomic_probe(path: Path) -[FileWrite]> i64 {
  safe_io_count_is(file.write_all(path, bytes.from_str("before")), 6) +
    safe_io_count_is(file.atomic_replace(path, bytes.from_str("atomic")), 6)
}

fn safe_io_binary_payload() -> Bytes {
  let values = vector.new<u8>()
  vector_push<u8>(values, num_i64_to_u8_checked(0).unwrap_or(0))
  vector_push<u8>(values, num_i64_to_u8_checked(255).unwrap_or(0))
  vector_push<u8>(values, num_i64_to_u8_checked(128).unwrap_or(0))
  vector_push<u8>(values, num_i64_to_u8_checked(65).unwrap_or(0))
  bytes.from_vector(values)
}

fn safe_io_binary_probe(path: Path) -[FileRead, FileWrite, DirMutate]> i64 {
  dir.remove(path)
  let expected = safe_io_binary_payload()
  let wrote = safe_io_count_is(file.write_all(path, expected), 4)
  let mut identity = 0
  let mut malformed_offset = 0
  match file.read_all(path, 4) {
    Err(error) -> 0
    Ok(actual) -> {
      if actual.eq(expected) { identity = 1 } else { 0 }
    }
  }
  match file.read_text(path, 4) {
    Ok(text) -> 0
    Err(error) -> match error {
      IoTextInvalidUtf8(utf8) -> match utf8 {
        InvalidUtf8(offset) -> if offset == 1 { malformed_offset = 1 } else { 0 }
      }
      _ -> 0
    }
  }
  let removed = match dir.remove(path) { Ok(value) -> 1 Err(error) -> 0 }
  wrote + identity + malformed_offset + removed
}

fn safe_io_read_probe(create: Path, append: Path, truncate: Path, atomic: Path) -[FileRead]> i64 {
  safe_io_bytes_are(file.read_all(create, 3), "abc") +
    safe_io_bytes_are(file.read_all(append, 5), "abcde") +
    safe_io_bytes_are(file.read_all(truncate, 1), "x") +
    safe_io_bytes_are(file.read_all(atomic, 6), "atomic") +
    safe_io_error_is<Bytes>(file.read_all(atomic, 5), 9)
}

test "safe file platform covers create append truncate atomic and bounds" {
  let create = safe_io_path("/tmp/weft_safe_io_create_93a71")
  let append = safe_io_path("/tmp/weft_safe_io_append_93a71")
  let truncate = safe_io_path("/tmp/weft_safe_io_truncate_93a71")
  let atomic = safe_io_path("/tmp/weft_safe_io_atomic_93a71")
  with dir_mutate_handler() { safe_io_remove_all(create, append, truncate, atomic) }

  Test.assert_eq(with file_write_handler() { safe_io_create_new_probe(create) }, 2)
  Test.assert_eq(with file_write_handler() { safe_io_append_probe(append) }, 2)
  Test.assert_eq(with file_write_handler() { safe_io_truncate_probe(truncate) }, 2)
  Test.assert_eq(with file_write_handler() { safe_io_atomic_probe(atomic) }, 2)
  Test.assert_eq(with file_read_handler() { safe_io_read_probe(create, append, truncate, atomic) }, 5)

  with dir_mutate_handler() { safe_io_remove_all(create, append, truncate, atomic) }
}

test "safe file platform round trips binary bytes and rejects malformed text" {
  let path = safe_io_path("/tmp/weft_safe_io_binary_93a71")
  Test.assert_eq(with dir_mutate_handler() {
    with file_read_handler() {
      with file_write_handler() { safe_io_binary_probe(path) }
    }
  }, 4)
}

fn safe_io_missing_probe(path: Path) -[FileRead]> i64 {
  safe_io_error_is<Bytes>(file.read_all(path, 64), 3)
}

test "safe file platform maps missing paths" {
  let missing = safe_io_path("/tmp/weft_safe_io_missing_93a71")
  with dir_mutate_handler() {
    dir.remove(missing)
    0
  }
  Test.assert_eq(with file_read_handler() { safe_io_missing_probe(missing) }, 1)
}

fn safe_io_non_utf8_path() -> Path {
  let values = bytes.from_str("/tmp/weft_safe_io_bytes_").to_vector()
  vector_push<u8>(values, num_i64_to_u8_checked(255).unwrap_or(0))
  match path.from_vector(values) {
    Ok(path) -> path
    Err(error) -> safe_io_path("")
  }
}

fn safe_io_non_utf8_write(path: Path) -[FileWrite]> i64 {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> match file.write_all(path, bytes.from_str("bytes")) {
      Ok(count) -> 0
      Err(error) -> match error {
        IoPlatform(code) -> if code == 92 { 1 } else { 0 }
        other -> 0
      }
    }
    NativeLinkLinuxAarch64 -> safe_io_count_is(file.write_all(path, bytes.from_str("bytes")), 5)
  }
}

fn safe_io_non_utf8_read(path: Path) -[FileRead]> i64 {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> safe_io_error_is<Bytes>(file.read_all(path, 5), 3)
    NativeLinkLinuxAarch64 -> match file.read_all(path, 5) {
      Err(error) -> 0
      Ok(values) -> if values.eq(bytes.from_str("bytes")) { 1 } else { 0 }
    }
  }
}

test "safe file platform preserves native path-byte semantics" {
  let path = safe_io_non_utf8_path()
  with dir_mutate_handler() {
    dir.remove(path)
    0
  }
  Test.assert_eq(with file_write_handler() { safe_io_non_utf8_write(path) }, 1)
  Test.assert_eq(with file_read_handler() { safe_io_non_utf8_read(path) }, 1)
  with dir_mutate_handler() {
    dir.remove(path)
    0
  }
}

fn safe_io_dir_create(parent: Path, child: Path) -[DirMutate]> i64 {
  dir.remove(child)
  dir.remove(parent)
  let parent_ok = match dir.create(parent) { Ok(value) -> 1 Err(error) -> 0 }
  let child_ok = match dir.create(child) { Ok(value) -> 1 Err(error) -> 0 }
  parent_ok + child_ok
}

fn safe_io_dir_inspect(parent: Path, child_name: Path, child: Path) -[DirInspect]> i64 {
  let mut found = 0
  match dir.list(parent) {
    Ok(entries) -> {
      for i in 0..vector_len<Path>(entries) {
        if vector_get_in_bounds<Path>(entries, i).eq(child_name) { found = 1 } else { 0 }
      }
      0
    }
    Err(error) -> 0
  }
  let metadata_ok = match dir.metadata(child) {
    Ok(metadata) -> if metadata.exists and metadata.kind.eq(DirDirectory) { 1 } else { 0 }
    Err(error) -> 0
  }
  let current_ok = match dir.current() {
    Ok(current) -> if current.len() > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
  found + metadata_ok + current_ok
}

fn safe_io_dir_cleanup(parent: Path, child: Path) -[DirMutate]> i64 {
  let child_ok = match dir.remove(child) { Ok(value) -> 1 Err(error) -> 0 }
  let parent_ok = match dir.remove(parent) { Ok(value) -> 1 Err(error) -> 0 }
  child_ok + parent_ok
}

test "safe directory platform transports typed paths and metadata" {
  let parent = safe_io_path("/tmp/weft_safe_io_dir_93a71")
  let child = safe_io_path("/tmp/weft_safe_io_dir_93a71/child")
  let child_name = safe_io_path("child")
  Test.assert_eq(with dir_mutate_handler() { safe_io_dir_create(parent, child) }, 2)
  Test.assert_eq(with dir_inspect_handler() { safe_io_dir_inspect(parent, child_name, child) }, 3)
  Test.assert_eq(with dir_mutate_handler() { safe_io_dir_cleanup(parent, child) }, 2)
}

fn safe_io_console_probe() -[ConsoleWrite]> i64 {
  safe_io_count_is(write_stdout(bytes.from_str("safe-stdout")), 11) +
    safe_io_count_is(write_stderr(bytes.from_str("safe-stderr")), 11) +
    match flush(ConsoleStdout) { Ok(value) -> 1 Err(error) -> 0 } +
    match flush(ConsoleStderr) { Ok(value) -> 1 Err(error) -> 0 }
}

fn safe_io_console_zero_read() -[ConsoleRead]> i64 {
  match read_bytes(0) {
    Ok(values) -> if values.len() == 0 { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "safe console module installs as a named handler" {
  Test.assert_eq(with console_write_handler() { safe_io_console_probe() }, 4)
  Test.assert_eq(with console_read_handler() { safe_io_console_zero_read() }, 1)
}

fn safe_io_combined_probe(path: Path) -[FileRead, FileWrite, DirMutate]> i64 {
  dir.remove(path)
  let wrote = safe_io_count_is(file.write_all(path, bytes.from_str("combined")), 8)
  let read = safe_io_bytes_are(file.read_all(path, 8), "combined")
  let removed = match dir.remove(path) { Ok(value) -> 1 Err(error) -> 0 }
  wrote + read + removed
}

test "safe platform boundary installs the complete capability set" {
  let path = safe_io_path("/tmp/weft_safe_io_combined_93a71")
  Test.assert_eq(with dir_mutate_handler() {
    with file_read_handler() {
      with file_write_handler() { safe_io_combined_probe(path) }
    }
  }, 3)
}

fn safe_io_residual_probe(path: Path) -[FileWrite, SafeIoResidual]> i64 {
  safe_io_count_is(file.write_all(path, bytes.from_str("tail")), 4) + SafeIoResidual.tick()
}

test "safe platform layers preserve independent residual effects" {
  let path = safe_io_path("/tmp/weft_safe_io_residual_93a71")
  with dir_mutate_handler() {
    dir.remove(path)
    0
  }
  let got = handle with file_write_handler() { safe_io_residual_probe(path) } {
    SafeIoResidual.tick() -> resume(41)
  }
  Test.assert_eq(got, 42)
  with dir_mutate_handler() {
    dir.remove(path)
    0
  }
}
