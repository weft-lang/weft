use stdlib/string.{*}

type Point { code: u8, x: f64, y: f64 }
type Label { text: str, value: i64 }

fn advance(points: [mut Point]) -> nil {
  let first: usize = 0
  for index in first..points.len {
    let point = points[index]
    points[index] = point.{x: point.x + 1.0, y: point.y - 2.0}
  }
}

fn main() -> i64 {
  let mut points = [Point { code: 250, x: 1.0, y: 2.0 }, Point { code: 9, x: 3.0, y: 4.0 }]
  let snapshot = points
  for _ in 0..100 { advance(points[..]) }
  if points[0].x != 101.0 or points[0].y != -198.0 or points[0].code != 250 { return 1 }
  if snapshot[0].x != 1.0 or snapshot[1].y != 4.0 { return 2 }
  let label = Label { text: "hello".concat("!"), value: 7 }
  let reference = weak_ref(label)
  let reader = () => label.value
  let mut entries = [(label, reference, reader), (label, reference, reader)]
  let original = entries
  entries[0] = entries[1]
  let (current, weak, read) = entries[0]
  let (before, _, before_read) = original[0]
  if current.text != "hello!" or before.text != "hello!" or read() != 7 or before_read() != 7 { return 3 }
  match weak_load(weak) {
    loaded: Label -> if loaded.value != 7 { return 4 } else { nil }
    nil -> return 5
  }
  0
}
