-- test/linked/tool_platform.weft -- combined native-tool capability boundary

use compiler/lib.{*}
use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/tool_platform.{*}
use stdlib/dir.{Dir}
use stdlib/env.{Env}
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/string.{*}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{MonotonicClock}
use stdlib/vector.{vector_len}

fn tool_platform_probe() -[Dir, Env, Proc, MonotonicClock]> i64 {
  let arg_count_ok = if Env.arg_count() == 0 { 1 } else { 0 }
  let env_ok = match Env.var("PATH") {
    nil -> 0
    value: str -> if __str_len(value) > 0 { 1 } else { 0 }
  }
  let dir_ok = match Dir.list("test") {
    Ok(entries) -> if vector_len<str>(entries) > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
  let before = monotonic.now()
  let output = Proc.wait(Proc.spawn("/usr/bin/true", Nil<str>()))
  let after = monotonic.now()
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) ->
      if arg_count_ok == 1 and env_ok == 1 and dir_ok == 1 and
        before.nanoseconds() > 0 and after.nanoseconds() >= before.nanoseconds() and status == 0 { 1 } else { 0 }
    _ -> 0
  }
}

test "tool_platform_installs_env_dir_monotonic_time_and_proc_together" {
  let path = alloc_zeroed(__str_len("PATH=/usr/bin:/bin") + 1)
  mem_copy(
    path,
    __str_ptr("PATH=/usr/bin:/bin"),
    __str_len("PATH=/usr/bin:/bin")
  )
  let argv = alloc_zeroed(24)
  mem_store64_at(argv, 0, 0)
  mem_store64_at(argv, 8, path)
  mem_store64_at(argv, 16, 0)
  Test.assert_eq(runtime_platform_tool(0, argv, tool_platform_probe), 1)
}
