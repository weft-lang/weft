-- test/linked/tool_platform.weft -- combined native-tool capability boundary

use compiler/storage.{*}
use runtime/env as env_handler
use runtime/tool_platform.{*}
use stdlib/dir.{Dir}
use stdlib/env.{Env}
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/string.{*}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{MonotonicClock}
use stdlib/vector.{vector_len}

fn tool_platform_probe() -[Dir, Env, Proc, MonotonicClock]> i64 {
  let arg_ok = match Env.arg(0) {
    nil -> 0
    value: str -> if Env.arg_count() >= 1 and __str_len(value) > 0 { 1 } else { 0 }
  }
  let dir_ok = match Dir.list("test") {
    Ok(entries) -> if vector_len<str>(entries) > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
  let before = monotonic.now()
  let output = Proc.wait(Proc.spawn("/usr/bin/true", Nil<str>()))
  let after = monotonic.now()
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) ->
      if arg_ok == 1 and dir_ok == 1 and before.nanoseconds() > 0 and
      after.nanoseconds() >= before.nanoseconds() and status == 0 {
        1
      } else { 0 }
    _ -> 0
  }
}

test "tool_platform_installs_env_dir_monotonic_time_and_proc_together" {
  Test.assert_eq(runtime_platform_tool(tool_platform_probe), 1)
}

-- One line naming what Env reports for the process startup.
fn startup_summary() -[Env]> str {
  let first = match Env.arg(0) {
    nil -> "<none>"
    value: str -> value
  }
  let path = match Env.var("PATH") {
    nil -> "<unset>"
    value: str -> value
  }
  let count = Env.arg_count()
  i"{count}|{first}|{path}"
}

test "tool_platform_env_reads_the_same_startup_as_the_platform_env_handler" {
  let expected = with env_handler() { startup_summary() }
  Test.assert_eq(
    runtime_platform_tool(() => if startup_summary() == expected { 1 } else { 0 }),
    1
  )
}

-- The environment a child observes, one entry per line, as `env` prints it.
fn child_environment_has(line: str) -[Proc]> i64 {
  match Proc.wait(Proc.spawn("/usr/bin/env", Nil<str>())) {
    ProcCompleted(ProcExited(0), stdout_text, stderr_text) -> str_contains(stdout_text, line)
    _ -> 0
  }
}

test "tool_platform_children_inherit_the_startup_environment" {
  let path = with env_handler() { Env.var("PATH") }
  match path {
    nil -> Test.assert_eq(0, 1)
    value: str -> Test.assert_eq(
      runtime_platform_tool(() => child_environment_has(i"PATH={value}\n")),
      1
    )
  }
}
