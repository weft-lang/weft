-- test/linked/tool_platform.weft -- combined native-tool capability boundary

use "compiler/lib.weft"
use "runtime/tool_platform.weft"
use stdlib/list.{*}
use stdlib/string.{*}
use "stdlib/vector.weft"

fn tool_platform_probe() -[Dir, Env, Proc, Time]> i64 {
  let arg_count_ok = if Env.arg_count() == 0 { 1 } else { 0 }
  let env_value: str | nil = Env.var("PATH")
  let env_ok = if env_value == nil { 0 }
  else { if __str_len(env_value) > 0 { 1 } else { 0 } }
  let dir_ok = match Dir.list("test") {
    Ok(entries) -> if vector_len<str>(entries) > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
  let before = Time.now_nanos()
  let output = Proc.wait(Proc.spawn("/usr/bin/true", list_nil<str>()))
  let after = Time.now_nanos()
  if arg_count_ok == 1 and env_ok == 1 and dir_ok == 1 and
    before > 0 and after >= before and output.status == 0 and
    output.error == 0 and output.timed_out == false { 1 } else { 0 }
}

test "tool_platform_installs_env_dir_time_and_proc_together" {
  Test.assert_eq(runtime_platform_tool(0, 0, tool_platform_probe), 1)
}
