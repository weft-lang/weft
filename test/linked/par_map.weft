-- test/linked/par_map.weft - generic par_map over a slice with a pure callback.

use stdlib/par.{*}

fn pm_double(x: i64) -> i64 { x * 2 }

fn run_par_map() -[Par]> i64 {
  let values = [1, 2, 3]
  vector_sum_i64(par_map<i64, i64>(values[..], pm_double), 0)
}

test "par_map_pure_slice" {
  let result = par_with_sequential_i64(run_par_map)
  Test.assert_eq(result, 12)
}

test "par_map_pthread_pool_handler" {
  let result = par_with_pthread_pool_i64(3, 8, run_par_map)
  Test.assert_eq(result, 12)
}
