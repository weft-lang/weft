-- test/linked/par_map.weft - par_map over a list with a pure callback.

use "stdlib/par.weft"
use "runtime/alloc.weft"

fn pm_double(x: i64) -> i64 { x * 2 }
fn pm_add(acc: i64, x: i64) -> i64 { acc + x }

fn pm_items() -> i64 {
  Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil)))
}

fn run_par_map() -[Par]> i64 {
  let mapped = par_map(pm_items(), pm_double)
  list_fold<i64, i64>(mapped, 0, pm_add)
}

test "par_map_pure_list" {
  let result = handle run_par_map() {
    Par.spawn(f, arg) -> {
      let addr = fn_addr(f)
      let tid = alloc_bump(8)
      __got_pthread_create(tid, 0, addr, arg, 0, 0)
      let hnd = alloc_bump(8)
      __mem_store64(hnd, __mem_load64(tid))
      resume(hnd)
    }
    Par.await(h) -> {
      let retval = alloc_bump(8)
      __got_pthread_join(__mem_load64(h), retval, 0, 0, 0, 0)
      resume(__mem_load64(retval))
    }
  }
  Test.assert_eq(result, 12)
}
