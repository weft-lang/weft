-- test/linked/par_pool_captured_rc.weft - pthread pool closure capture of rc values.

use "stdlib/par.weft"
use "runtime/rc.weft"

fn ppcr_captured_rc_computation() -[Par]> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 40)
  let h = Par.spawn(x => __mem_load64(p) + x, 2)
  let promoted = rc_is_promoted(p)
  Par.await(h) + if promoted == 1 { 0 } else { 1000 }
}

test "par_with_pthread_pool_i64_runs_captured_rc_lambda" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, ppcr_captured_rc_computation), 42)
}

fn ppcr_retain_release_worker(p: i64, n: i64) -> i64 {
  let mut i = 0
  while i < n {
    rc_default_retain(p)
    rc_default_release(p)
    i = i + 1
  }
  rc_is_promoted(p)
}

fn ppcr_promoted_rc_atomic_stress() -[Par]> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let h1 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h2 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h3 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h4 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h5 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h6 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h7 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let h8 = Par.spawn(x => ppcr_retain_release_worker(p, x), 2000)
  let sum = Par.await(h1) + Par.await(h2) + Par.await(h3) + Par.await(h4) + Par.await(h5) + Par.await(h6) + Par.await(h7) + Par.await(h8)
  let count = rc_count(p)
  sum * 100 + count
}

test "promoted_rc_retain_release_is_atomic_across_threads" {
  Test.assert_eq(par_with_pthread_pool_i64(4, 8, ppcr_promoted_rc_atomic_stress), 801)
}
