use "runtime/memory.weft"
-- test/linked/par_pool_captured_rc.weft - pthread pool closure capture of rc values.

use "stdlib/par.weft"
use runtime/rc.{*}

fn ppcr_captured_rc_computation() -[Par]> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 40)
  let h = par_spawn<i64>(() => mem_load64(p) + 2)
  let promoted = rc_is_promoted(p)
  par_await<i64>(h) + if promoted == 1 { 0 } else { 1000 }
}

test "par_with_pthread_pool_i64_runs_captured_rc_lambda" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, ppcr_captured_rc_computation), 42)
}

fn ppcr_spawn_arg_worker(x: i64) -> i64 {
  rc_is_promoted(x)
}

fn ppcr_spawn_arg_promotion_computation(p: rc i64) -[Par]> i64 {
  let h = par_spawn<i64>(() => ppcr_spawn_arg_worker(p))
  par_await<i64>(h)
}

test "par_spawn_promotes_managed_arg_without_promoting_unrelated_local" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let local: rc i64 = rc_default_alloc(8, 8)
  let worker_saw_promoted = par_with_pthread_pool_i64(2, 4, () => ppcr_spawn_arg_promotion_computation(p))
  Test.assert_eq(worker_saw_promoted * 100 + rc_is_promoted(p) * 10 + rc_is_promoted(local), 110)
}

fn ppcr_retain_release_worker(p: i64, n: i64) -> i64 {
  let mut i = 0
  while i < n {
    rc_default_retain(p)
    rc_default_release(p)
    i = i + 1
  }
  rc_is_promoted(p)
}

fn ppcr_promoted_rc_atomic_stress() -[Par]> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let h1 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h2 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h3 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h4 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h5 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h6 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h7 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let h8 = par_spawn<i64>(() => ppcr_retain_release_worker(p, 2000))
  let sum = par_await<i64>(h1) + par_await<i64>(h2) + par_await<i64>(h3) + par_await<i64>(h4) + par_await<i64>(h5) + par_await<i64>(h6) + par_await<i64>(h7) + par_await<i64>(h8)
  let count = rc_count(p)
  sum * 100 + count
}

test "promoted_rc_retain_release_is_atomic_across_threads" {
  Test.assert_eq(par_with_pthread_pool_i64(4, 8, ppcr_promoted_rc_atomic_stress), 801)
}
