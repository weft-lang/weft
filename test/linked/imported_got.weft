-- test/linked/imported_got.weft - GOT call emitted from a use'd module.

use "stdlib/unsafe.weft"
use "test/linked_support/imported_got_support.weft"

test "imported_got_write" {
  let msg = __str_ptr("ok\n")
  let written = handle imported_got_write(msg, 3) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
  Test.assert_eq(written, 3)
}
