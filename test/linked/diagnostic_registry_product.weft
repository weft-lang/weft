use stdlib/diagnostic
use stdlib/diagnostic/registry as registry
use stdlib/diagnostic/schema.{DiagnosticCodeAssigned, DiagnosticCodeUnassigned}
use stdlib/option.{None, Some, Option}
use stdlib/string

fn main() -> i64 {
  if registry.len() != 42 { return 1 }
  let origin: usize = 0
  for index in origin..registry.len() {
    let entry = match registry.get(index) { Some(value) -> value None -> return 2 }
    match entry.code {
      DiagnosticCodeAssigned(code) -> if code.len() != 5 { return 3 }
      DiagnosticCodeUnassigned -> return 4
    }
    if entry.class.name().is_empty() or entry.summary.is_empty() { return 5 }
    if entry.explanation.len() < 180 { return 6 }
    if entry.explanation.find("What happened:").is_none() or entry.explanation.find("How to fix:").is_none() or entry.explanation.find("Example:").is_none() { return 7 }
  }
  let absent: [usize; 2] = [registry.len(), 18446744073709551615]
  for index in absent {
    match registry.get(index) { None -> nil Some(value) -> return 8 }
  }
  0
}
