-- test/linked/par_deque.weft - worker-local deque contract.

use stdlib/par.{*}

test "par_deque_owner_lifo_thief_fifo" {
  let d = par_deque_new(3)
  Test.assert_eq(par_deque_push_bottom(d, 10), 1)
  Test.assert_eq(par_deque_push_bottom(d, 20), 1)
  Test.assert_eq(par_deque_push_bottom(d, 30), 1)
  Test.assert_eq(par_deque_push_bottom(d, 40), 0)
  Test.assert_eq(par_deque_pop_bottom(d), 30)
  Test.assert_eq(par_deque_steal_top(d), 10)
  Test.assert_eq(par_deque_pop_bottom(d), 20)
  Test.assert_eq(par_deque_pop_bottom(d), par_queue_empty_value())
  par_deque_destroy(d)
}

test "par_deque_wraps_after_bottom_pop" {
  let d = par_deque_new(3)
  par_deque_push_bottom(d, 1)
  par_deque_push_bottom(d, 2)
  par_deque_push_bottom(d, 3)
  Test.assert_eq(par_deque_pop_bottom(d), 3)
  Test.assert_eq(par_deque_push_bottom(d, 4), 1)
  Test.assert_eq(par_deque_steal_top(d), 1)
  Test.assert_eq(par_deque_pop_bottom(d), 4)
  Test.assert_eq(par_deque_pop_bottom(d), 2)
  Test.assert_eq(par_deque_steal_top(d), par_queue_empty_value())
  par_deque_destroy(d)
}

test "par_deque_zero_capacity_normalizes_to_one" {
  let d = par_deque_new(0)
  Test.assert_eq(par_deque_push_bottom(d, 7), 1)
  Test.assert_eq(par_deque_push_bottom(d, 8), 0)
  Test.assert_eq(par_deque_pop_bottom(d), 7)
  Test.assert_eq(par_deque_steal_top(d), par_queue_empty_value())
  par_deque_destroy(d)
}
