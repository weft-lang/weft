use stdlib/result
use runtime/alloc_test.{runtime_alloc_worker_one_growth_links, runtime_alloc_worker_two_growth_links}
use stdlib/par as par

fn main() -> i64 {
  let result = par.with_pool(par.pool_config(1, 2).unwrap(), () => {
    let first = par.fork(runtime_alloc_worker_one_growth_links)
    let left = first.join()
    let second = par.fork(runtime_alloc_worker_two_growth_links)
    left + second.join()
  })
  if result == 84 { 0 } else { 1 }
}
