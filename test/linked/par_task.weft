use runtime/alloc.{*}
use runtime/memory.{*}
-- test/linked/par_task.weft - pool task/future contract.

use stdlib/par.{*}
use runtime/rc.{*}
use runtime/par_task.{*}
use runtime/effects.{*}
use stdlib/list.{*}

fn pt_double(x: i64) -> i64 { x * 2 }
fn pt_inc(x: i64) -> i64 { x + 1 }
fn pt_promoted_in_pure_helper(p: rc i64) -> i64 { rc_is_promoted(p) }

test "par_task_run_sets_result_and_done" {
  let task = par_task_new(pt_double, 21)
  Test.assert_eq(par_task_done(task), 0)
  Test.assert_eq(par_task_run(task), 42)
  Test.assert_eq(par_task_done(task), 1)
  Test.assert_eq(par_task_result(task), 42)
  Test.assert_eq(par_task_await(task), 42)
}

test "par_task_await_result_rejects_zero_handle" {
  let got = match par_task_await_result(0) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_invalid_handle())
}

test "par_task_await_result_rejects_not_ready" {
  let task = par_task_new(pt_inc, 10)
  let got = match par_task_await_result(task) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_not_ready())
}

test "par_task_observe_result_rejects_double_observation" {
  let task = par_task_new(pt_inc, 10)
  par_task_run(task)
  Test.assert_eq(par_task_await(task), 11)
  let got = match par_task_await_result(task) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_already_observed())
}

test "par_task_array_results_to_list_preserves_order" {
  let arena = arena_new(64)
  let tasks = arena_alloc(arena, 24, 8)
  let task0 = par_task_new(pt_inc, 1)
  let task1 = par_task_new(pt_inc, 2)
  let task2 = par_task_new(pt_inc, 3)
  mem_store64(tasks, task0)
  mem_store64(tasks + 8, task1)
  mem_store64(tasks + 16, task2)
  par_task_run(task2)
  par_task_run(task0)
  par_task_run(task1)
  let results = par_task_array_results_to_list(tasks, 3)
  match results {
    Cons(first, Cons(second, Cons(third, rest))) -> {
      Test.assert_eq(first, 2)
      Test.assert_eq(second, 3)
      Test.assert_eq(third, 4)
    }
    _ -> Test.assert_eq(0, 1)
  }
  arena_free(arena)
}

test "par_task_new_promoted_marks_captured_rc_visible_in_pure_callee" {
  let p: rc i64 = rc_default_alloc(8, 8)
  let task = par_task_new_promoted(x => pt_promoted_in_pure_helper(p) + x, 41)
  Test.assert_eq(rc_is_promoted(p), 1)
  Test.assert_eq(par_task_run(task), 42)
  Test.assert_eq(par_task_await(task), 42)
}
