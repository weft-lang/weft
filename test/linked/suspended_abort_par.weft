-- 3w: surviving Par task/pool ownership under the 4j abort edge.

use "runtime/rc_implicit_test.weft"
use "stdlib/par.weft"

effect SuspendedParAbort {
  fn stop(value: i64) -> i64
}

type SuspendedParMapValue {
  SuspendedParMapValue(i64, RuntimeRcProbe)
}

fn suspended_par_abort_unawaited(payload: RuntimeRcProbe) -[Par, SuspendedParAbort]> i64 {
  let task = par_spawn<i64>(() => runtime_rc_probe_load(payload) + 1)
  SuspendedParAbort.stop(42)
}

fn suspended_par_abort_awaited(payload: RuntimeRcProbe) -[Par, SuspendedParAbort]> i64 {
  let task = par_spawn<i64>(() => runtime_rc_probe_load(payload) + 1)
  let value = par_await<i64>(task)
  SuspendedParAbort.stop(value) + 1000
}

fn suspended_par_abort_mixed(payload: RuntimeRcProbe) -[Par, SuspendedParAbort]> i64 {
  let awaited = par_spawn<i64>(() => runtime_rc_probe_load(payload) + 1)
  let abandoned = par_spawn<i64>(() => runtime_rc_probe_load(payload) + 2)
  let value = par_await<i64>(awaited)
  SuspendedParAbort.stop(value)
}

fn suspended_par_unawaited_return(payload: RuntimeRcProbe) -[Par]> i64 {
  let task = par_spawn<i64>(() => runtime_rc_probe_load(payload) + 1)
  42
}

fn suspended_par_generic_abort_unawaited(payload: RuntimeRcProbe) -[Par, SuspendedParAbort]> i64 {
  let task = par_spawn<RuntimeRcProbe>(() => payload)
  SuspendedParAbort.stop(42)
}

fn suspended_par_generic_unawaited_return(payload: RuntimeRcProbe) -[Par]> i64 {
  let task = par_spawn<RuntimeRcProbe>(() => payload)
  42
}

fn suspended_par_generic_awaited_abort(payload: RuntimeRcProbe) -[Par, SuspendedParAbort]> i64 {
  let task = par_spawn<RuntimeRcProbe>(() => payload)
  let observed = par_await<RuntimeRcProbe>(task)
  SuspendedParAbort.stop(runtime_rc_probe_load(observed))
}

fn suspended_par_map_abort_partial(payload: RuntimeRcProbe) -[SuspendedParAbort]> i64 {
  let values = [1, 2, 3]
  let works = runtime_par_work_scope_new()
  defer runtime_par_work_scope_cleanup(works)
  let mapped = handle par_map<i64, SuspendedParMapValue>(values[..], value => SuspendedParMapValue(value, payload)) {
    Par.submit(work) -> resume(runtime_par_work_scope_track(works, par_work_sequential_submit(work)))
    Par.join(task) -> {
      let joined = runtime_par_work_join(task)
      let value = runtime_par_work_result_load_lane_or(joined, 0, 0)
      if runtime_rc_test_load64(value + 8) == 2 { SuspendedParAbort.stop(42) }
      else { resume(joined) }
    }
  }
  vector_len<SuspendedParMapValue>(mapped)
}

fn suspended_par_map_abort_partial_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_par_map_abort_partial(payload) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_abort_sequential_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_sequential_i64(() => suspended_par_abort_unawaited(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_normal_sequential_run(payload: RuntimeRcProbe) -> i64 {
  par_with_sequential_i64(() => suspended_par_unawaited_return(payload))
}

fn suspended_par_abort_pthread_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_pthread_pool_i64(2, 4, () => suspended_par_abort_unawaited(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_normal_pthread_run(payload: RuntimeRcProbe) -> i64 {
  par_with_pthread_pool_i64(2, 4, () => suspended_par_unawaited_return(payload))
}

fn suspended_par_generic_abort_pthread_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_pthread_pool_i64(2, 4, () => suspended_par_generic_abort_unawaited(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_generic_normal_pthread_run(payload: RuntimeRcProbe) -> i64 {
  par_with_pthread_pool_i64(2, 4, () => suspended_par_generic_unawaited_return(payload))
}

fn suspended_par_generic_awaited_abort_pthread_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_pthread_pool_i64(2, 4, () => suspended_par_generic_awaited_abort(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_abort_pthread_after_await_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_pthread_pool_i64(2, 4, () => suspended_par_abort_awaited(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_direct_pool_abort(payload: RuntimeRcProbe) -[SuspendedParAbort]> i64 {
  let pool = par_pthread_pool_start(2, 4)
  defer par_pthread_pool_shutdown(pool)
  let task = par_pthread_pool_submit(pool, value => runtime_rc_probe_load(payload) + value, 1)
  SuspendedParAbort.stop(42) + task
}

fn suspended_par_direct_pool_abort_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_par_direct_pool_abort(payload) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_abort_sequential_mixed_run(payload: RuntimeRcProbe) -> i64 {
  handle par_with_sequential_i64(() => suspended_par_abort_mixed(payload)) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_nested_direct_pool_abort(payload: RuntimeRcProbe) -[SuspendedParAbort]> i64 {
  let pool = par_pthread_pool_start(2, 4)
  defer par_pthread_pool_shutdown(pool)
  let outer = par_pthread_pool_submit(pool, ignored => {
    par_pthread_pool_submit(pool, value => runtime_rc_probe_load(payload) + value, 1)
    ignored
  }, 0)
  par_pthread_pool_await(outer)
  SuspendedParAbort.stop(42)
}

fn suspended_par_nested_direct_pool_abort_run(payload: RuntimeRcProbe) -> i64 {
  handle suspended_par_nested_direct_pool_abort(payload) {
    SuspendedParAbort.stop(value) -> value
  }
}

fn suspended_par_queue_full_cleanup(payload: RuntimeRcProbe) -> i64 {
  let queue = par_queue_new(1)
  let pool = runtime_par_pool_state_new(queue, 0, 0)
  runtime_par_pool_install_worker_arrays(pool, 0, 0, 0, 0)
  let first = par_pthread_pool_submit(pool, value => runtime_rc_probe_load(payload) + value, 1)
  let second = match par_pthread_pool_submit_result(pool, value => runtime_rc_probe_load(payload) + value, 2) {
    ParOk(task) -> task
    ParErr(error) -> error
  }
  let stopped = par_pthread_pool_shutdown(pool)
  if first > 0 and second == par_error_queue_full() and stopped == 0 { 42 } else { 0 }
}

test "abort_discards_unawaited_sequential_task_capture_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_abort_sequential_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "normal_sequential_scope_discards_unawaited_task_capture_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_normal_sequential_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_shuts_down_pool_and_discards_unawaited_task_capture_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_abort_pthread_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "normal_pool_scope_discards_unawaited_task_capture_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_normal_pthread_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "generic abort joins work then drops unobserved managed result once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_generic_abort_pthread_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "generic normal scope drops unobserved managed result once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_generic_normal_pthread_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "generic abort after await does not drop moved result twice" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(42)
  Test.assert_eq(suspended_par_generic_awaited_abort_pthread_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "generic par_map abort drops initialized prefix and unobserved results" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_map_abort_partial_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_after_pool_await_does_not_release_task_capture_twice" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_abort_pthread_after_await_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abortive_direct_pool_shutdown_discards_unawaited_task_capture_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_direct_pool_abort_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_discards_only_unawaited_task_in_mixed_sequential_scope" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_abort_sequential_mixed_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abortive_pool_shutdown_discards_nested_worker_submission_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_nested_direct_pool_abort_run(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "pool_queue_full_rollback_and_shutdown_release_captures_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(41)
  Test.assert_eq(suspended_par_queue_full_cleanup(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}
