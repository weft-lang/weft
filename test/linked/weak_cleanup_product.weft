type Payload {
  message: str
}

fn message(reference: weak Payload) -> str {
  match weak_load(reference) {
    nil -> "expired"
    live: Payload -> live.message
  }
}

fn main() -> i64 {
  let payload = Payload { message: "still alive" }
  let live = weak_ref(payload)
  let expired = weak_ref(Payload { message: "temporary" })
  let nested = message(weak_ref(payload))
  if message(live) == "still alive" and message(expired) == "expired" and nested == "still alive" {
    0
  } else { 1 }
}
