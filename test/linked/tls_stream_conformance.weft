-- test/linked/tls_stream_conformance.weft — real owned TLS-over-TCP stream

use runtime/safe_tcp.{runtime_platform_tcp}
use runtime/secure_random.{runtime_platform_secure_random}
use stdlib/bytes.{Bytes, bytes_equal, bytes_from_str, bytes_len}
use stdlib/drop.{Drop}
use stdlib/fail.{Fail}
use stdlib/net_address.{SocketAddress, SocketV4, ipv4_address}
use stdlib/result.{Err, Ok}
use stdlib/secure_random.{SecureRandom}
use stdlib/spawn as spawn
use stdlib/tcp.{TcpConnect, TcpError, TcpListen, TcpListener, TcpListenerIO, TcpListenerReadiness, TcpListenerReadinessFailed, TcpListenerReady, TcpReadiness, TcpReadinessError, TcpStreamIO, tcp_accept, tcp_connect, tcp_connect_options_default, tcp_listen, tcp_listen_options, tcp_listener_close, tcp_listener_local_address, tcp_wait_acceptable}
use stdlib/time.{Time}
use stdlib/tls.{TlsError, TlsSession, tls_client_open, tls_server_open}
use stdlib/tls/stream.{TlsStream, TlsStreamError, TlsStreamHandshake, TlsStreamHandshakeFailed, TlsStreamHandshakeReady, TlsStreamInvalidProgress, TlsStreamRead, TlsStreamReadClosed, TlsStreamReadData, TlsStreamReadFailed, TlsStreamWrite, TlsStreamWriteFailed, TlsStreamWrote, tls_stream_close, tls_stream_handshake, tls_stream_read, tls_stream_write}
use stdlib/url.{UrlHost, url_parse}
use test/linked_support/tls_fixtures.{tls_fixture_ca, tls_fixture_server_certificate, tls_fixture_server_private_key}

fn tls_stream_client_open_fixed(
  host: UrlHost
) -[SecureRandom]> Result<owned TlsSession, TlsError> {
  handle tls_client_open(host, tls_fixture_ca()) {
    Time.now_millis() -> resume(1788134400000)
    Time.now_nanos() -> resume(1788134400000000000)
    Time.sleep_millis(ms) -> resume(0)
  }
}

fn tls_stream_require_handshake(
  outcome: TlsStreamHandshake
) -[Fail<TlsStreamError>, TcpStreamIO]> owned TlsStream {
  match outcome {
    TlsStreamHandshakeFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamHandshakeReady(stream) -> stream
  }
}

fn tls_stream_require_read(
  outcome: TlsStreamRead
) -[Fail<TlsStreamError>, TcpStreamIO]> (owned TlsStream, Bytes) {
  match outcome {
    TlsStreamReadData(stream, data) -> (stream, data)
    TlsStreamReadClosed(stream) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(TlsStreamInvalidProgress)
    }
    TlsStreamReadFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
  }
}

fn tls_stream_require_closed(
  outcome: TlsStreamRead
) -[Fail<TlsStreamError>, TcpStreamIO]> owned TlsStream {
  match outcome {
    TlsStreamReadData(stream, data) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(TlsStreamInvalidProgress)
    }
    TlsStreamReadFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamReadClosed(stream) -> stream
  }
}

fn tls_stream_require_write(
  outcome: TlsStreamWrite
) -[Fail<TlsStreamError>, TcpStreamIO]> (owned TlsStream, usize) {
  match outcome {
    TlsStreamWriteFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamWrote(stream, count) -> (stream, count)
  }
}

fn tls_stream_client(
  address: SocketAddress
) -[SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, Fail<TcpError>, Fail<TlsError>, Fail<TlsStreamError>]> i64 {
  match url_parse("https://localhost/") {
    Err(error) -> 0
    Ok(url) -> {
      let transport = tcp_connect(address, tcp_connect_options_default())?
      let session = tls_stream_client_open_fixed(url.host())?
      let stream = tls_stream_require_handshake(tls_stream_handshake(transport, session))
      let message = bytes_from_str("client")
      let (wrote, wrote_count) = tls_stream_require_write(tls_stream_write(stream, message))
      let (received, response) = tls_stream_require_read(
        tls_stream_read(wrote, __i64_to_usize(16384))
      )
      let matched = bytes_equal(response, bytes_from_str("server")) and
        __u64_to_i64(__usize_to_u64(wrote_count)) == bytes_len(message)
      tls_stream_close(received)?
      if matched { 1 } else { 0 }
    }
  }
}

fn tls_stream_require_listener(
  readiness: TcpListenerReadiness
) -[Fail<TcpReadinessError>, TcpListenerIO]> owned TcpListener {
  match readiness {
    TcpListenerReadinessFailed(listener, error) -> {
      let closed = tcp_listener_close(listener)
      Fail<TcpReadinessError>.fail(error)
    }
    TcpListenerReady(listener) -> listener
  }
}

fn tls_stream_loopback() -[SecureRandom, TcpConnect, TcpListen, TcpReadiness, TcpStreamIO, TcpListenerIO, spawn.Spawn, Fail<TcpError>, Fail<TlsError>, Fail<TlsStreamError>, Fail<TcpReadinessError>]> i64 {
  let listener = tcp_listen(
    SocketV4(ipv4_address(127, 0, 0, 1), 0),
    tcp_listen_options(8)
  )?
  let address = tcp_listener_local_address(listener)?
  let client = spawn.spawn(() => tls_stream_client(address))
  let mut ready_listener = tls_stream_require_listener(tcp_wait_acceptable(listener))
  let transport = tcp_accept(ready_listener)?
  tcp_listener_close(ready_listener)?
  let session = tls_server_open(
    tls_fixture_server_certificate(),
    tls_fixture_server_private_key()
  )?
  let stream = tls_stream_require_handshake(tls_stream_handshake(transport, session))
  let (received, request) = tls_stream_require_read(
    tls_stream_read(stream, __i64_to_usize(16384))
  )
  let request_matches = bytes_equal(request, bytes_from_str("client"))
  let message = bytes_from_str("server")
  let (wrote, wrote_count) = tls_stream_require_write(tls_stream_write(received, message))
  let wrote_all = __u64_to_i64(__usize_to_u64(wrote_count)) == bytes_len(message)
  let peer_closed = tls_stream_require_closed(
    tls_stream_read(wrote, __i64_to_usize(16384))
  )
  tls_stream_close(peer_closed)?
  let client_status = spawn.join(client)
  if request_matches and wrote_all and client_status == 1 { 0 } else { 1 }
}

fn tls_stream_with_failures() -[SecureRandom, TcpConnect, TcpListen, TcpReadiness, TcpStreamIO, TcpListenerIO, spawn.Spawn]> i64 {
  handle {
    handle {
      handle {
        handle tls_stream_loopback() {
          Fail<TcpError>.fail(error) -> 11
        }
      } {
        Fail<TlsError>.fail(error) -> 12
      }
    } {
      Fail<TlsStreamError>.fail(error) -> 13
    }
  } {
    Fail<TcpReadinessError>.fail(error) -> 14
  }
}

fn main() -> i64 {
  runtime_platform_secure_random(() =>
    runtime_platform_tcp(() =>
      spawn.with_event_loop(tls_stream_with_failures)
    )
  )
}
