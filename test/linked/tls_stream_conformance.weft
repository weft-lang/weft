-- test/linked/tls_stream_conformance.weft — real owned TLS-over-TCP stream

use runtime/tcp_connect as tcp_connect_handler
use runtime/tcp_listen as tcp_listen_handler
use runtime/tcp_listener_io as tcp_listener_io_handler
use runtime/tcp_stream_io as tcp_stream_io_handler
use runtime/secure_random as platform_random
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/drop.{Drop}
use stdlib/fail.{Fail}
use stdlib/net_address as net
use stdlib/net_address.{SocketAddress, SocketV4}
use stdlib/result.{Err, Ok}
use stdlib/secure_random.{SecureRandom}
use stdlib/task as task
use stdlib/tcp as tcp
use stdlib/tcp.{TcpConnect, TcpError, TcpListen, TcpListener, TcpListenerIO, TcpListenerReadiness, TcpListenerReadinessFailed, TcpListenerReady, TcpReadiness, TcpReadinessError, TcpStreamIO}
use stdlib/time/wall as wall
use stdlib/time/wall.{Timestamp, WallClock, WallClockError}
use stdlib/tls as tls
use stdlib/tls.{TlsError, TlsSession}
use stdlib/tls/stream as tls_stream
use stdlib/tls/stream.{TlsStream, TlsStreamError, TlsStreamHandshake, TlsStreamHandshakeFailed, TlsStreamHandshakeReady, TlsStreamInvalidProgress, TlsStreamRead, TlsStreamReadClosed, TlsStreamReadData, TlsStreamReadFailed, TlsStreamWrite, TlsStreamWriteFailed, TlsStreamWrote}
use stdlib/url as url
use stdlib/url.{UrlHost}
use test/linked_support/tls_fixtures.{tls_fixture_ca, tls_fixture_server_certificate, tls_fixture_server_private_key}

fn tls_stream_client_open_fixed(
  host: UrlHost
) -[SecureRandom]> Result<owned TlsSession, TlsError> {
  handle tls.client(host, tls_fixture_ca()) {
    WallClock.now() -> resume(Ok<Timestamp, WallClockError>(
      wall.milliseconds_since_unix_epoch(1788134400000)
    ))
  }
}

fn tls_stream_require_handshake(
  outcome: TlsStreamHandshake
) -[Fail<TlsStreamError>, TcpStreamIO]> owned TlsStream {
  match outcome {
    TlsStreamHandshakeFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamHandshakeReady(stream) -> stream
  }
}

fn tls_stream_require_read(
  outcome: TlsStreamRead
) -[Fail<TlsStreamError>, TcpStreamIO]> (owned TlsStream, Bytes) {
  match outcome {
    TlsStreamReadData(stream, data) -> (stream, data)
    TlsStreamReadClosed(stream) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(TlsStreamInvalidProgress)
    }
    TlsStreamReadFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
  }
}

fn tls_stream_require_closed(
  outcome: TlsStreamRead
) -[Fail<TlsStreamError>, TcpStreamIO]> owned TlsStream {
  match outcome {
    TlsStreamReadData(stream, data) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(TlsStreamInvalidProgress)
    }
    TlsStreamReadFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamReadClosed(stream) -> stream
  }
}

fn tls_stream_require_write(
  outcome: TlsStreamWrite
) -[Fail<TlsStreamError>, TcpStreamIO]> (owned TlsStream, usize) {
  match outcome {
    TlsStreamWriteFailed(stream, error) -> {
      let dropped = stream.drop()
      Fail<TlsStreamError>.fail(error)
    }
    TlsStreamWrote(stream, count) -> (stream, count)
  }
}

fn tls_stream_client(
  address: SocketAddress
) -[SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, Fail<TcpError>, Fail<TlsError>, Fail<TlsStreamError>]> i64 {
  match url.parse("https://localhost/") {
    Err(error) -> 0
    Ok(url) -> {
      let transport = tcp.connect(address, tcp.connect_options())?
      let session = tls_stream_client_open_fixed(url.host())?
      let stream = tls_stream_require_handshake(tls_stream.handshake(transport, session))
      let message = bytes.from_str("client")
      let (wrote, wrote_count) = tls_stream_require_write(stream.write(message))
      let (received, response) = tls_stream_require_read(
        wrote.read(__i64_to_usize(16384))
      )
      let matched = response.eq(bytes.from_str("server")) and wrote_count == message.len()
      received.close()?
      if matched { 1 } else { 0 }
    }
  }
}

fn tls_stream_require_listener(
  readiness: TcpListenerReadiness
) -[Fail<TcpReadinessError>, TcpListenerIO]> owned TcpListener {
  match readiness {
    TcpListenerReadinessFailed(listener, error) -> {
      let closed = listener.close()
      Fail<TcpReadinessError>.fail(error)
    }
    TcpListenerReady(listener) -> listener
  }
}

fn tls_stream_loopback() -[SecureRandom, TcpConnect, TcpListen, TcpReadiness, TcpStreamIO, TcpListenerIO, task.TaskScope, Fail<TcpError>, Fail<TlsError>, Fail<TlsStreamError>, Fail<TcpReadinessError>]> i64 {
  let listener = tcp.listen(
    SocketV4(net.ipv4(127, 0, 0, 1), 0),
    tcp.listen_options(8)
  )?
  let address = listener.local_address()?
  let client = task.spawn(() => tls_stream_client(address))
  let mut ready_listener = tls_stream_require_listener(listener.wait_acceptable())
  let transport = ready_listener.accept()?
  ready_listener.close()?
  let session = tls.server(
    tls_fixture_server_certificate(),
    tls_fixture_server_private_key()
  )?
  let stream = tls_stream_require_handshake(tls_stream.handshake(transport, session))
  let (received, request) = tls_stream_require_read(
    stream.read(__i64_to_usize(16384))
  )
  let request_matches = request.eq(bytes.from_str("client"))
  let message = bytes.from_str("server")
  let (wrote, wrote_count) = tls_stream_require_write(received.write(message))
  let wrote_all = wrote_count == message.len()
  let peer_closed = tls_stream_require_closed(
    wrote.read(__i64_to_usize(16384))
  )
  peer_closed.close()?
  let client_status = client.join()
  if request_matches and wrote_all and client_status == 1 { 0 } else { 1 }
}

fn tls_stream_with_failures() -[SecureRandom, TcpConnect, TcpListen, TcpReadiness, TcpStreamIO, TcpListenerIO, task.TaskScope]> i64 {
  handle {
    handle {
      handle {
        handle tls_stream_loopback() {
          Fail<TcpError>.fail(error) -> 11
        }
      } {
        Fail<TlsError>.fail(error) -> 12
      }
    } {
      Fail<TlsStreamError>.fail(error) -> 13
    }
  } {
    Fail<TcpReadinessError>.fail(error) -> 14
  }
}

fn main() -> i64 {
  with platform_random() {
    with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() {
            task.with_event_loop(tls_stream_with_failures)
          }
        }
      }
    }
  }
}
