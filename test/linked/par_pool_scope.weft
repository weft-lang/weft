-- test/linked/par_pool_scope.weft - scoped pthread pool spawn/await surface.

use "stdlib/par.weft"

fn pps_double(x: i64) -> i64 { x * 2 }
fn pps_triple(x: i64) -> i64 { x * 3 }
fn pps_add_five(x: i64) -> i64 { x + 5 }

effect PpsWorkerProbe {
  fn value() -> i64
}

fn pps_worker_probe_value() -[PpsWorkerProbe]> i64 {
  PpsWorkerProbe.value()
}

fn pps_allocate_and_read(x: i64) -> i64 {
  let p = alloc_bump(8)
  __mem_store64(p, x + 1)
  __mem_load64(p)
}

fn pps_handle_worker_effect(x: i64) -> i64 {
  let base = handle pps_worker_probe_value() {
    PpsWorkerProbe.value() -> resume(40)
  }
  base + x
}

fn pps_nested_submit(pool: i64) -> i64 {
  let a = par_pthread_pool_submit(pool, pps_double, 10)
  let b = par_pthread_pool_submit(pool, pps_add_five, 10)
  par_pthread_pool_await(a) + par_pthread_pool_await(b)
}

fn pps_fake_pool(queue_capacity: i64) -> i64 {
  let pool = alloc_bump(par_pool_state_size())
  __mem_store64(pool + par_pool_queue_offset(), par_queue_new(queue_capacity))
  __mem_store64(pool + par_pool_workers_offset(), 0)
  __mem_store64(pool + par_pool_worker_count_offset(), 0)
  __mem_store64(pool + par_pool_submit_cursor_offset(), 0)
  __mem_store64(pool + par_pool_control_mutex_offset(), par_pthread_mutex_new())
  __mem_store64(pool + par_pool_control_cond_offset(), par_pthread_cond_new())
  __mem_store64(pool + par_pool_pending_count_offset(), 0)
  pool
}

fn pps_fake_pool_destroy(pool: i64) -> i64 {
  par_queue_destroy(par_pool_queue(pool))
  par_pthread_cond_destroy(par_pool_control_cond(pool))
  par_pthread_mutex_destroy(par_pool_control_mutex(pool))
}

fn pps_pool_computation(pool: i64) -[Par]> i64 {
  let a = Par.spawn(pps_double, 10)
  let b = Par.spawn(pps_triple, 10)
  let c = Par.spawn(pps_add_five, 10)
  Par.await(a) + Par.await(b) + Par.await(c)
}

fn pps_spawn_computation() -[Par]> i64 {
  let a = Par.spawn(pps_double, 10)
  let b = Par.spawn(pps_triple, 10)
  let c = Par.spawn(pps_add_five, 10)
  Par.await(a) + Par.await(b) + Par.await(c)
}

fn pps_sum_list(xs: i64) -> i64 {
  let mut total = 0
  let mut cur = xs
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      total = total + __mem_load64(cur + 8)
      cur = __mem_load64(cur + 16)
    }
  }
  total
}

fn pps_map_computation() -[Par]> i64 {
  pps_sum_list(par_map(Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil))), pps_triple))
}

fn pps_captured_lambda_computation() -[Par]> i64 {
  let base = 40
  let h = Par.spawn(x => base + x, 2)
  Par.await(h)
}

test "par_pthread_pool_submit_and_await_single" {
  let pool = par_pthread_pool_start(2, 4)
  let task = par_pthread_pool_submit(pool, pps_double, 21)
  Test.assert_eq(par_pthread_pool_await(task), 42)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_multiple_tasks_join_correctly" {
  let pool = par_pthread_pool_start(3, 8)
  let a = par_pthread_pool_submit(pool, pps_double, 10)
  let b = par_pthread_pool_submit(pool, pps_triple, 10)
  let c = par_pthread_pool_submit(pool, pps_add_five, 10)
  let result = par_pthread_pool_await(a) + par_pthread_pool_await(b) + par_pthread_pool_await(c)
  Test.assert_eq(result, 65)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_await_order_preserves_values" {
  let pool = par_pthread_pool_start(2, 4)
  let a = par_pthread_pool_submit(pool, pps_double, 7)
  let b = par_pthread_pool_submit(pool, pps_triple, 7)
  Test.assert_eq(par_pthread_pool_await(b), 21)
  Test.assert_eq(par_pthread_pool_await(a), 14)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_handler_runs_par_effect" {
  let pool = par_pthread_pool_start(3, 8)
  let result = handle pps_pool_computation(pool) {
    Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg))
    Par.await(h) -> resume(par_pthread_pool_await(h))
  }
  Test.assert_eq(result, 65)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_with_sequential_i64_runs_spawn_await_scope" {
  Test.assert_eq(par_with_sequential_i64(pps_spawn_computation), 65)
}

test "par_with_pthread_pool_i64_runs_spawn_await_scope" {
  Test.assert_eq(par_with_pthread_pool_i64(3, 8, pps_spawn_computation), 65)
}

test "par_with_pthread_pool_i64_runs_par_map_scope" {
  Test.assert_eq(par_with_pthread_pool_i64(3, 8, pps_map_computation), 18)
}

test "par_with_sequential_i64_runs_captured_lambda" {
  Test.assert_eq(par_with_sequential_i64(pps_captured_lambda_computation), 42)
}

test "par_with_pthread_pool_i64_runs_captured_lambda" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, pps_captured_lambda_computation), 42)
}

test "par_with_sequential_i64_runs_direct_literal_scope" {
  Test.assert_eq(par_with_sequential_i64(() => {
    let a = Par.spawn(pps_double, 10)
    let b = Par.spawn(pps_triple, 10)
    let c = Par.spawn(pps_add_five, 10)
    Par.await(a) + Par.await(b) + Par.await(c)
  }), 65)
}

test "par_with_pthread_pool_i64_runs_direct_literal_scope" {
  Test.assert_eq(par_with_pthread_pool_i64(3, 8, () => {
    let a = Par.spawn(pps_double, 10)
    let b = Par.spawn(pps_triple, 10)
    let c = Par.spawn(pps_add_five, 10)
    Par.await(a) + Par.await(b) + Par.await(c)
  }), 65)
}

test "par_pthread_pool_worker_callback_can_allocate" {
  let pool = par_pthread_pool_start(2, 4)
  let task = par_pthread_pool_submit(pool, pps_allocate_and_read, 41)
  Test.assert_eq(par_pthread_pool_await(task), 42)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_worker_callback_can_install_handler" {
  let pool = par_pthread_pool_start(2, 4)
  let task = par_pthread_pool_submit(pool, pps_handle_worker_effect, 2)
  Test.assert_eq(par_pthread_pool_await(task), 42)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_nested_task_submission" {
  let pool = par_pthread_pool_start(3, 8)
  let task = par_pthread_pool_submit(pool, pps_nested_submit, pool)
  Test.assert_eq(par_pthread_pool_await(task), 35)
  Test.assert_eq(par_pthread_pool_shutdown(pool), 0)
}

test "par_pthread_pool_submit_result_rejects_zero_pool" {
  let got = match par_pthread_pool_submit_result(0, pps_double, 1) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_invalid_handle())
}

test "par_pthread_pool_submit_result_rejects_full_queue" {
  let pool = pps_fake_pool(1)
  let first = match par_pthread_pool_submit_result(pool, pps_double, 1) {
    ParOk(v) -> 1
    ParErr(e) -> e
  }
  let second = match par_pthread_pool_submit_result(pool, pps_double, 2) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(first, 1)
  Test.assert_eq(second, par_error_queue_full())
  pps_fake_pool_destroy(pool)
}
