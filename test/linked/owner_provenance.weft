-- test/linked/owner_provenance.weft -- platform handlers refuse scripted owners
--
-- A resource owner records which interpretation of its capability created it.
-- The platform handlers refuse an owner that a deterministic handler scripted:
-- each operation reports the typed foreign-owner error and touches no
-- platform state, so no integer is ever dereferenced or used as a descriptor.

use runtime/net_poller.{
  NetPollError,
  NetPollInvalidRegistration,
  NetPoller,
  net_poller_adopt_listener,
  net_poller_adopt_stream,
  net_poller_close,
  net_poller_open
}
use runtime/process as platform_process
use runtime/process_environment as child_environment
use runtime/tcp_listener_io as platform_listener_io
use runtime/tcp_stream_io as platform_stream_io
use runtime/time as platform_time
use stdlib/bytes as bytes
use stdlib/fail.{Fail}
use stdlib/io/types.{IoReadProgress, IoWriteProgress}
use stdlib/list.{Cons, Nil}
use stdlib/net_address.{SocketAddress}
use stdlib/option.{None, Option, Some}
use stdlib/process.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/tcp.{*}
use stdlib/test.{Test}
use stdlib/time as time
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant}
use stdlib/vector as vector
use stdlib/vector.{vector_push}
use stdlib/vector/handles.{Vector}

fn soon() -> Instant {
  platform_time.with_platform(() => monotonic.now()).add(time.milliseconds(100))
}

fn foreign_output(output: ProcOutput) -> bool {
  match output {
    ProcFailed(ProcOwnerForeign, stdout_text, stderr_text) -> stdout_text == "" and
      stderr_text == ""
    _ -> false
  }
}

fn scripted_id_is(session: borrow ProcSession, expected: i64) -> bool {
  match scripted_session_id(session) {
    Some(id) -> id == expected
    None -> false
  }
}

fn foreign_child_cases() -[Proc]> i64 {
  if not foreign_output(Proc.wait(scripted_handle(5))) { return 1 }
  if not foreign_output(Proc.wait_until(scripted_handle(6), soon())) { return 2 }
  -- EBADF on both targets: the owner names no child of the platform's.
  if Proc.release(scripted_handle(7)) != 9 { return 3 }
  0
}

fn foreign_session_cases() -[Proc]> i64 {
  let (after_write, written) = Proc.session_write(
    scripted_session(8),
    bytes.from_str("x"),
    soon()
  )
  let write_refused = match written {
    ProcWriteFailed(ProcOwnerForeign, accepted) -> accepted == __i64_to_usize(0)
    _ -> false
  }
  if not write_refused { return 10 }
  if not scripted_id_is(after_write, 8) { return 11 }
  let closed = Proc.session_close_input(after_write)
  if not scripted_id_is(closed, 8) { return 12 }
  let (after_read, read) = Proc.session_read(closed, __i64_to_usize(16), soon())
  let read_refused = match read {
    ProcReadFailed(ProcOwnerForeign) -> true
    _ -> false
  }
  if not read_refused { return 13 }
  if not scripted_id_is(after_read, 8) { return 14 }
  if not foreign_output(Proc.session_finish(after_read)) { return 15 }
  if not foreign_output(Proc.session_finish_until(scripted_session(9), soon())) { return 16 }
  if Proc.session_release(scripted_session(10)) != 9 { return 17 }
  0
}

test "the platform Proc handlers refuse scripted child owners" {
  Test.assert_eq(with platform_process() { foreign_child_cases() }, 0)
  Test.assert_eq(with child_environment(Nil<str>()) { foreign_child_cases() }, 0)
}

test "the platform Proc handlers refuse scripted session owners" {
  Test.assert_eq(with platform_process() { foreign_session_cases() }, 0)
  Test.assert_eq(with child_environment(Nil<str>()) { foreign_session_cases() }, 0)
}

fn tcp_foreign<T>(result: Result<T, TcpError>) -> bool {
  match result {
    Err(TcpOwnerForeign) -> true
    _ -> false
  }
}

fn foreign_stream_cases() -[TcpStreamIO]> i64 {
  let mut stream: owned TcpStream = scripted_stream(21)
  let mut received: Vector<u8> = vector.with_capacity<u8>(4)
  for index in 0..4 { vector_push<u8>(received, __u64_to_u8(__i64_to_u64(0))) }
  let mut sent: Vector<u8> = vector.with_capacity<u8>(4)
  for index in 0..4 { vector_push<u8>(sent, __u64_to_u8(__i64_to_u64(0))) }
  let destination: [mut u8] = received[..]
  let source: [u8] = sent[..]
  if not tcp_foreign<IoReadProgress>(stream.read(destination)) { return 1 }
  if not tcp_foreign<IoWriteProgress>(stream.write(source)) { return 2 }
  if not tcp_foreign<nil>(stream.shutdown(TcpShutdownBoth)) { return 3 }
  if not tcp_foreign<SocketAddress>(stream.local_address()) { return 4 }
  if not tcp_foreign<SocketAddress>(stream.peer_address()) { return 5 }
  -- A release reports EBADF: the owner names no descriptor of the platform's.
  if TcpStreamIO.release(stream) != 0 - 9 { return 6 }
  0
}

fn foreign_listener_cases() -[TcpListenerIO]> i64 {
  let mut listener: owned TcpListener = scripted_listener(22)
  let accepted = match TcpListenerIO.accept(listener) {
    Err(TcpOwnerForeign) -> true
    Ok(stream) -> {
      release_scripted_stream(stream)
      false
    }
    Err(_) -> false
  }
  if not accepted { return 7 }
  if not tcp_foreign<SocketAddress>(TcpListenerIO.local_address(listener)) { return 8 }
  if TcpListenerIO.release(listener) != 0 - 9 { return 9 }
  0
}

test "the platform TCP handlers refuse scripted stream and listener owners" {
  Test.assert_eq(with platform_stream_io() { foreign_stream_cases() }, 0)
  Test.assert_eq(with platform_listener_io() { foreign_listener_cases() }, 0)
}

fn scripted_poller_probe() -[Fail<NetPollError>, TcpStreamIO, TcpListenerIO]> i64 {
  let mut poller: owned NetPoller = net_poller_open()?
  let stream = scripted_stream(31)
  let listener = scripted_listener(32)
  let mut score = 0
  match net_poller_adopt_stream(poller, stream) {
    Err(NetPollInvalidRegistration) -> { score = score + 1 }
    _ -> { score = score + 0 }
  }
  match net_poller_adopt_listener(poller, listener) {
    Err(NetPollInvalidRegistration) -> { score = score + 1 }
    _ -> { score = score + 0 }
  }
  score = score + release_scripted_stream(stream) + release_scripted_listener(listener)
  net_poller_close(poller)?
  score
}

test "the readiness poller cannot register a scripted owner" {
  let score = with platform_stream_io() {
    with platform_listener_io() {
      handle scripted_poller_probe() {
        Fail<NetPollError>.fail(error) -> 0 - 1
      }
    }
  }
  Test.assert_eq(score, 2 + 31 + 32)
}

fn scripted_identifier_cases() -[Proc, TcpStreamIO, TcpListenerIO, Test]> i64 {
  let child = scripted_handle(41)
  Test.assert_true(
    match scripted_handle_id(child) {
      Some(id) -> id == 41
      None -> false
    }
  )
  Test.assert_eq(release_scripted_handle(child), 41)
  let session = scripted_session(42)
  Test.assert_eq(release_scripted_session(session), 42)
  let stream = scripted_stream(43)
  Test.assert_true(
    match scripted_stream_id(stream) {
      Some(id) -> id == 43
      None -> false
    }
  )
  Test.assert_eq(release_scripted_stream(stream), 43)
  let listener = scripted_listener(44)
  Test.assert_true(
    match scripted_listener_id(listener) {
      Some(id) -> id == 44
      None -> false
    }
  )
  Test.assert_eq(release_scripted_listener(listener), 44)
  0
}

test "scripted owners keep the identifiers deterministic handlers chose" {
  let score = with platform_process() {
    with platform_stream_io() { with platform_listener_io() { scripted_identifier_cases() } }
  }
  Test.assert_eq(score, 0)
}
