-- test/linked/par_unique.weft - unique results crossing generic Par boundaries.

use "stdlib/par.weft"
use "runtime/rc.weft"

fn pu_unique_scalar_worker() -> unique i64 {
  41
}

fn pu_inc_worker(x: i64) -> i64 { x + 1 }

test "par_spawn_moves_unique_scalar_result through task carrier" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, () => {
    let h = par_spawn<unique i64>(pu_unique_scalar_worker)
    let value: unique i64 = par_await<unique i64>(h)
    pu_inc_worker(value)
  }), 42)
}

fn pu_unique_rc_worker() -> unique rc i64 { rc_default_alloc(8, 8) }

test "par_spawn_unique_rc_result_uses_zero_rc_move_path" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, () => {
    let h = par_spawn<unique rc i64>(pu_unique_rc_worker)
    rc_is_promoted(par_await<unique rc i64>(h))
  }), 0)
}
