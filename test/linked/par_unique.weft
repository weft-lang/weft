-- test/linked/par_unique.weft - unique results crossing generic Par boundaries.

use stdlib/par as par
use stdlib/par.{*}

type PuBox { value: i64 }

fn pu_unique_scalar_worker() -> unique i64 {
  41
}

fn pu_inc_worker(x: i64) -> i64 { x + 1 }

test "par_fork_moves_unique_scalar_result through ParTask carrier" {
  Test.assert_eq(par.with_pool(2, 4, () => {
    let h = par.fork<unique i64>(pu_unique_scalar_worker)
    let value: unique i64 = h.join()
    pu_inc_worker(value)
  }), 42)
}

fn pu_unique_box_worker() -> unique PuBox { PuBox { value: 42 } }

test "par_fork_moves_unique_aggregate_result" {
  Test.assert_eq(par.with_pool(2, 4, () => {
    let h = par.fork<unique PuBox>(pu_unique_box_worker)
    let value = h.join()
    value.value
  }), 42)
}
