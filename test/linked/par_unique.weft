-- test/linked/par_unique.weft - unique values crossing direct Par boundaries.

use "stdlib/par.weft"
use "runtime/rc.weft"

fn pu_inc_worker(x: i64) -> i64 {
  x + 1
}

test "par_spawn_accepts_unique_value_as_moved_arg" {
  Test.assert_eq(par_with_pthread_pool_i64(2, 4, () => {
    let x: unique i64 = 41
    let h = Par.spawn(pu_inc_worker, x)
    Par.await(h)
  }), 42)
}

fn pu_unique_rc_worker(p: i64) -> i64 {
  rc_is_promoted(p)
}

fn pu_submit_prepared_unique_rc_arg() -> i64 {
  let pool = par_pthread_pool_start(2, 4)
  let p: unique rc i64 = rc_default_alloc(8, 8)
  let h = par_pthread_pool_submit_prepared(pool, pu_unique_rc_worker, p)
  let got = par_pthread_pool_await(h)
  par_pthread_pool_shutdown(pool)
  got
}

test "par_prepared_unique_rc_arg_uses_zero_rc_move_path" {
  Test.assert_eq(pu_submit_prepared_unique_rc_arg(), 0)
}
