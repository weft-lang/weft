-- test/linked/time_platform.weft — real Time platform handler plus mockability

use compiler/lib.{*}
use runtime/time as platform_time
use stdlib/time.{Time}

effect TimeProbe {
  fn inspect(value: i64) -> i64
}

fn realtime_probe() -[Time]> i64 {
  Time.now_millis()
}

fn monotonic_probe() -[Time]> i64 {
  Time.now_nanos()
}

fn sleep_probe(ms: i64) -[Time]> i64 {
  Time.sleep_millis(ms)
}

test "time_platform_realtime_is_plausible" {
  let now = with platform_time() { realtime_probe() }
  Test.assert_eq(if now >= 1700000000000 { 1 } else { 0 }, 1)
}

test "time_platform_monotonic_is_positive_and_nondecreasing" {
  let first = with platform_time() { monotonic_probe() }
  let second = with platform_time() { monotonic_probe() }
  Test.assert_eq(if first > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if second >= first { 1 } else { 0 }, 1)
}

fn sleep_and_measure() -[Time]> i64 {
  let before = Time.now_nanos()
  let status = Time.sleep_millis(2)
  let after = Time.now_nanos()
  if status == 0 and after - before >= 1000000 { 1 } else { 0 }
}

test "time_platform_sleep_advances_monotonic_clock" {
  Test.assert_eq(with platform_time() { sleep_and_measure() }, 1)
}

test "time_platform_sleep_zero_and_negative_status" {
  Test.assert_eq(with platform_time() { sleep_probe(0) }, 0)
  Test.assert_eq(with platform_time() { sleep_probe(0 - 1) }, 0 - 1)
}

fn mock_probe() -[Time]> i64 {
  Time.now_millis() + Time.now_nanos() + Time.sleep_millis(7)
}

test "time_effect_remains_fully_mockable" {
  let got = handle mock_probe() {
    Time.now_millis() -> resume(10)
    Time.now_nanos() -> resume(30)
    Time.sleep_millis(ms) -> resume(ms - 5)
  }
  Test.assert_eq(got, 42)
}

fn residual_probe() -[Time, TimeProbe]> i64 {
  TimeProbe.inspect(Time.now_nanos())
}

test "time_platform_handler_preserves_residual_effects" {
  let got = handle with platform_time() { residual_probe() } {
    TimeProbe.inspect(value) -> resume(if value > 0 { 1 } else { 0 })
  }
  Test.assert_eq(got, 1)
}
