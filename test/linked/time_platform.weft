-- test/linked/time_platform.weft — split platform time capabilities

use compiler/lib.{*}
use runtime/time as platform_time
use stdlib/ord.{Equal, Greater}
use stdlib/result.{Err, Ok, Result}
use stdlib/time as time
use stdlib/time.{Duration}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant, MonotonicClock}
use stdlib/time/sleep as sleep
use stdlib/time/sleep.{Sleep, SleepError}
use stdlib/time/wall as wall
use stdlib/time/wall.{Timestamp, WallClock, WallClockError}

effect TimeProbe {
  fn inspect(value: i64) -> i64
}

fn realtime_probe() -[WallClock]> Result<Timestamp, WallClockError> {
  wall.now()
}

fn monotonic_probe() -[MonotonicClock]> Instant {
  monotonic.now()
}

fn sleep_probe(duration: Duration) -[Sleep]> Result<nil, SleepError> {
  sleep.wait(duration)
}

test "wall_clock_platform_reading_is_plausible" {
  let reading = platform_time.with_platform(() => realtime_probe())
  match reading {
    Ok(timestamp) -> Test.assert_eq(
      if timestamp.milliseconds_since_unix_epoch() >= 1700000000000 { 1 } else { 0 },
      1
    )
    Err(error) -> Test.assert_eq(0, 1)
  }
}

test "monotonic_platform_readings_are_positive_and_nondecreasing" {
  let first = platform_time.with_platform(() => monotonic_probe())
  let second = platform_time.with_platform(() => monotonic_probe())
  Test.assert_eq(if first.nanoseconds() > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if second.compare(first) == Greater or second.compare(first) == Equal { 1 } else { 0 }, 1)
}

fn sleep_and_measure() -[MonotonicClock, Sleep]> i64 {
  let before = monotonic.now()
  let result = sleep.wait(time.milliseconds(2))
  let after = monotonic.now()
  match result {
    Ok(nil) -> if after.nanoseconds() - before.nanoseconds() >= 1000000 { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "sleep_platform_advances_monotonic_clock" {
  Test.assert_eq(platform_time.with_platform(() => sleep_and_measure()), 1)
}

test "sleep_platform_handles_zero_and_rejects_negative_duration" {
  let zero = platform_time.with_platform(() => sleep_probe(time.milliseconds(0)))
  let negative = platform_time.with_platform(() => sleep_probe(time.milliseconds(0 - 1)))
  Test.assert_true(zero.is_ok())
  Test.assert_true(negative.is_err())
}

fn mock_probe() -[WallClock, MonotonicClock, Sleep]> i64 {
  let timestamp = match wall.now() {
    Ok(value) -> value.milliseconds_since_unix_epoch()
    Err(error) -> 0
  }
  let instant = monotonic.now().nanoseconds()
  let slept = match sleep.wait(time.milliseconds(7)) {
    Ok(nil) -> 2
    Err(error) -> 0
  }
  timestamp + instant + slept
}

test "time_capabilities_remain_independently_mockable" {
  let got = handle {
    handle {
      handle mock_probe() {
        WallClock.now() -> resume(Ok<Timestamp, WallClockError>(
          wall.milliseconds_since_unix_epoch(10)
        ))
      }
    } {
      MonotonicClock.now() -> resume(monotonic.nanoseconds(30))
    }
  } {
    Sleep.wait(duration) -> resume(Ok<nil, SleepError>(nil))
  }
  Test.assert_eq(got, 42)
}

fn residual_probe() -[MonotonicClock, TimeProbe]> i64 {
  TimeProbe.inspect(monotonic.now().nanoseconds())
}

test "platform_time_composition_preserves_residual_effects" {
  let got = handle platform_time.with_platform(() => residual_probe()) {
    TimeProbe.inspect(value) -> resume(if value > 0 { 1 } else { 0 })
  }
  Test.assert_eq(got, 1)
}
