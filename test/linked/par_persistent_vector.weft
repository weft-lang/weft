-- test/linked/par_persistent_vector.weft - managed persistent vector roots at Par boundaries.

use "stdlib/vector.weft"
use "stdlib/par.weft"
use "runtime/rc.weft"

fn ppv_worker(v: i64) -> i64 {
  rc_is_promoted(v) * 1000 + persistent_vector_len(v) * 100 + persistent_vector_get<i64>(v, 2, 0)
}

test "par_spawn_promotes_persistent_vector_root" {
  let v0: rc i64 = persistent_vector_new<i64>()
  let v1: rc i64 = persistent_vector_push<i64>(v0, 11)
  let v2: rc i64 = persistent_vector_push<i64>(v1, 22)
  let v3: rc i64 = persistent_vector_push<i64>(v2, 33)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = Par.spawn(ppv_worker, v3)
    Par.await(h)
  })
  Test.assert_eq(got * 10 + rc_is_promoted(v3), 13331)
}
