-- test/linked/par_persistent_vector.weft - managed persistent vector roots at Par boundaries.

use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}
use stdlib/vector.{persistent_vector_is_promoted}
use stdlib/option.{Option}
use stdlib/par as par
use stdlib/par.{*}
use runtime/rc.{*}
use runtime/vector_storage.{*}

fn ppv_worker(v: PersistentVector<i64>) -> i64 {
  let raw = persistent_vector_storage_handle_word<i64>(v)
  rc_is_promoted(raw) * 1000 + v.len() * 100 + v.get(2).unwrap_or(0)
}

fn ppv_pure_helper_retains_promoted(v: PersistentVector<i64>) -> i64 {
  let raw = persistent_vector_storage_handle_word<i64>(v)
  let promoted = rc_default_is_promoted_maybe(raw)
  let before = rc_count(raw)
  let retained = rc_default_retain(raw)
  let during = rc_count(raw)
  let released = rc_default_release(raw)
  let after = rc_count(raw)
  if promoted == 1 and retained == before + 1 and during == before + 1 and released == before and after == before {
    v.get(2).unwrap_or(0)
  } else { 0 }
}

fn ppv_worker_through_pure_helper(v: PersistentVector<i64>) -> i64 {
  ppv_pure_helper_retains_promoted(v)
}

test "par_fork_promotes_persistent_vector_root" {
  let v0: PersistentVector<i64> = persistent_vector.new<i64>()
  let v1: PersistentVector<i64> = v0.push(11)
  let v2: PersistentVector<i64> = v1.push(22)
  let v3: PersistentVector<i64> = v2.push(33)
  let got = par.with_pool(2, 4, () => {
    let h = par.fork<i64>(() => ppv_worker(v3))
    h.join()
  })
  Test.assert_eq(got * 10 + persistent_vector_is_promoted<i64>(v3), 13331)
}

test "par_fork_promoted_value_fact_survives_pure_helper" {
  let v0: PersistentVector<i64> = persistent_vector.new<i64>()
  let v1: PersistentVector<i64> = v0.push(11)
  let v2: PersistentVector<i64> = v1.push(22)
  let v3: PersistentVector<i64> = v2.push(33)
  let got = par.with_pool(2, 4, () => {
    let h = par.fork<i64>(() => ppv_worker_through_pure_helper(v3))
    h.join()
  })
  Test.assert_eq(got * 10 + persistent_vector_is_promoted<i64>(v3), 331)
}
