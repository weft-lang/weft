use stdlib/json as json
use stdlib/json.{JsonInvalidSyntax}
use stdlib/num as num
use stdlib/num.{NumParseEmpty}
use stdlib/result.{Ok, Err}
use stdlib/option.{Option}
use stdlib/string.{*}

fn prefixes_compose() -> bool {
  let source = "Ω42-1.5+.25!"
  let start = source.find("42").expect("number follows the Unicode prefix")
  match num.parse_i64_prefix(source, start) {
    Ok((integer, next)) -> match num.parse_f64_prefix(source, next) {
      Ok((double, next)) -> match num.parse_f32_prefix(source, next) {
        Ok((single, next)) -> integer == 42 and double == -1.5 and
          single.to_bits() == 1048576000 and next == source.len() - 1
        Err(_) -> false
      }
      Err(_) -> false
    }
    Err(_) -> false
  }
}

fn choose_label(reuse: bool) -> str {
  let first = 7.to_str()
  if reuse { first } else { 11.to_str() }
}

fn main() -> i64 {
  if not prefixes_compose() { return 1 }
  for _ in 0..200 {
    if choose_label(true) != "7" or choose_label(false) != "11" { return 4 }
  }
  let maximum: usize = 18446744073709551615
  match num.parse_f64_prefix("1", maximum) {
    Err(NumParseEmpty(at)) if at == maximum -> nil
    _ -> return 2
  }
  match num.parse_f32_prefix("Ω9e-46!", 2) {
    Ok((value, next)) if value.to_bits() == 1 and next == 7 -> nil
    _ -> return 5
  }
  match json.parse("{\"Ω\":[1,1e+]}") {
    Err(JsonInvalidSyntax(at)) if at == 12 -> 0
    _ -> 3
  }
}
