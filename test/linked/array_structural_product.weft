use stdlib/string.{*}

fn main() -> i64 {
  let mut values = [(1, "hello".concat("!")), (2, "weft".concat("!"))]
  let snapshot = values
  values[0] = (3, "updated".concat("!"))
  values[1] = values[1]
  let writable: [mut (i64, str)] = values[..]
  writable[0] = (4, "sliced".concat("!"))
  let mut total = 0
  let mut text = ""
  for (index, value) in writable {
    total = total + index
    text = text.concat(value)
  }
  let (original, greeting) = snapshot[0]
  if total == 6 and text == "sliced!weft!" and original == 1 and greeting == "hello!" { 0 } else { 1 }
}
