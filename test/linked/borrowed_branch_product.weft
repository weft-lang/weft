use stdlib/string.{*}

fn select(first: bool) -> (str, [str; 2]) {
  let left = (7.to_str(), [11.to_str(), 13.to_str()])
  let right = (17.to_str(), [19.to_str(), 23.to_str()])
  match first { true -> left false -> right }
}

fn alias(text: str, first: bool) -> str {
  if first {
    let copy = text
    copy
  } else {
    let mut copy = 29.to_str()
    copy = text
    copy
  }
}

fn early(first: bool) -> str {
  let left = 7.to_str()
  let right = 11.to_str()
  if first { return left } else { nil }
  right
}

effect SelectText { fn select() -> str }
fn resumed(first: bool) -> str {
  handle SelectText.select() {
    SelectText.select() -> {
      let local = 13.to_str()
      if first { local } else { resume(local) }
    }
  }
}

fn churn() -> nil {
  for value in 20..100 { value.to_str() }
  nil
}

fn main() -> i64 {
  for _ in 0..200 {
    let (left, left_values) = select(true)
    let (right, right_values) = select(false)
    if left != "7" or left_values[0] != "11" or left_values[1] != "13" { return 1 }
    if right != "17" or right_values[0] != "19" or right_values[1] != "23" { return 2 }
    if alias(left, true) != "7" or alias(right, false) != "17" { return 3 }
    if (if true { left } else { right }) != "7" { return 4 }
    let early_left = early(true)
    let early_right = early(false)
    let aborted = resumed(true)
    let continued = resumed(false)
    churn()
    if early_left != "7" or early_right != "11" { return 5 }
    if aborted != "13" or continued != "13" { return 6 }
  }
  0
}
