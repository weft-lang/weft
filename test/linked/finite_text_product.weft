use stdlib/option.{None, Option, Some}
use stdlib/string
use stdlib/unicode
use stdlib/utf8 as utf8
use stdlib/utf8.{Utf8Decoded, Utf8Malformed}

fn main() -> i64 {
  let composed = "é".normalize_nfc()
  if composed.len() != 2 or composed.scalar_count() != 1 or composed.grapheme_count() != 1 { return 1 }
  let text = "AΩ😀"
  let mut offset: usize = 0
  let mut sum = 0
  while offset < text.len() {
    match utf8.decode_next(text, offset) {
      Utf8Decoded(next, scalar) -> { offset = next; sum = sum + scalar }
      Utf8Malformed(_) -> return 2
    }
  }
  if offset != 7 or sum != 129514 { return 3 }
  match "é".next_grapheme_boundary(0) {
    Some(next) -> if next != 2 { return 4 }
    None -> return 5
  }
  let maximum: usize = 18446744073709551615
  match utf8.decode_next(text, maximum) {
    Utf8Decoded(_, _) -> return 6
    Utf8Malformed(failed) -> if failed != maximum { return 7 }
  }
  if text.is_word_boundary(maximum) or text.next_sentence_boundary(maximum).is_some() { return 8 }
  0
}
