-- test/linked/par_persistent_map.weft - managed persistent map roots at Par boundaries.

use stdlib/map.{*}
use stdlib/par.{*}
use stdlib/string.{*}

fn ppm_worker(m: Map<i64, i64>) -> i64 {
  persistent_map_is_promoted(m) * 100 + persistent_map_get_or(m, 7, 0 - 1)
}

fn ppm_managed_worker(m: Map<str, str>) -> i64 {
  persistent_map_is_promoted<str, str>(m) * 100 + str_len(persistent_map_get_or<str, str>(m, str_concat("managed-", "key"), ""))
}

test "par_spawn_promotes_persistent_map_root" {
  let empty = persistent_map_new<i64, i64>()
  let m = persistent_map_put(empty, 7, 70)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = par_spawn<i64>(() => ppm_worker(m))
    par_await<i64>(h)
  })
  Test.assert_eq(got * 10 + persistent_map_is_promoted(m), 1701)
}

test "par_spawn_preserves_managed_persistent_map_payloads" {
  let m = persistent_map_put<str, str>(persistent_map_new<str, str>(), str_concat("managed-", "key"), str_concat("value-", "42"))
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = par_spawn<i64>(() => ppm_managed_worker(m))
    par_await<i64>(h)
  })
  Test.assert_eq(got * 10 + persistent_map_is_promoted<str, str>(m), 1081)
}
