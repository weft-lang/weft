-- test/linked/par_persistent_map.weft - managed persistent map roots at Par boundaries.

use "stdlib/map.weft"
use "stdlib/par.weft"

fn ppm_worker(m: Map<i64, i64>) -> i64 {
  persistent_map_is_promoted(m) * 100 + persistent_map_get_or(m, 7, 0 - 1)
}

test "par_spawn_promotes_persistent_map_root" {
  let empty = persistent_map_new()
  let m = persistent_map_put(empty, 7, 70)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = Par.spawn((ignored: i64) => ppm_worker(m), 0)
    Par.await(h)
  })
  Test.assert_eq(got * 10 + persistent_map_is_promoted(m), 1701)
}
