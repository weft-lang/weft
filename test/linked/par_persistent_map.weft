-- test/linked/par_persistent_map.weft - managed persistent map roots at Par boundaries.

use "stdlib/map.weft"
use "stdlib/par.weft"
use "runtime/rc.weft"

fn ppm_worker(m: i64) -> i64 {
  rc_is_promoted(m) * 100 + persistent_map_get(m, 7, 0 - 1)
}

test "par_spawn_promotes_persistent_map_root" {
  let empty: rc i64 = persistent_map_new()
  let m: rc i64 = persistent_map_put(empty, 7, 70)
  let got = par_with_pthread_pool_i64(2, 4, () => {
    let h = Par.spawn(ppm_worker, m)
    Par.await(h)
  })
  Test.assert_eq(got * 10 + rc_is_promoted(m), 1701)
}
