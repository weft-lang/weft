use compiler/comptime/artifact.{ComptimeArtifactInputError, ComptimeArtifactReadFailed}
use compiler/comptime/evaluate.{ComptimeBuildEvaluation, comptime_evaluate_file_reads}
use stdlib/grammar/sql/schema as sql_schema
use stdlib/grammar/sql/schema.{*}
use stdlib/list.{Cons, Nil}
use stdlib/path as path
use stdlib/result.{Result, Ok, Err}
use stdlib/test.{Test}

fn fixture_path() -> str {
  "test/fixtures/comptime_sql_schema_v1.json"
}

fn evaluate_schema() -> Result<ComptimeBuildEvaluation<Result<SqlSchema, SqlSchemaError>>, ComptimeArtifactInputError> {
  comptime_evaluate_file_reads(() => sql_schema.load(path.from_utf8(fixture_path()).unwrap(), 4096))
}

test "production evaluator runs ordinary SQL schema code and records its exact input" {
  match evaluate_schema() {
    Err(_) -> Test.assert_true(false)
    Ok(product) -> {
      match product.value {
        Err(_) -> Test.assert_true(false)
        Ok(schema) -> {
          match schema.tables {
            Nil -> Test.assert_true(false)
            Cons(table, _) -> {
              Test.assert_str_eq(table.name, "users")
              match table.fields {
                Cons(id, Cons(name, Nil)) -> {
                  Test.assert_str_eq(id.name, "id")
                  match id.value { SqlSchemaInteger -> Test.assert_true(true) _ -> Test.assert_true(false) }
                  Test.assert_str_eq(name.name, "name")
                  match name.value { SqlSchemaText -> Test.assert_true(true) _ -> Test.assert_true(false) }
                }
                _ -> Test.assert_true(false)
              }
            }
          }
        }
      }
      match product.inputs {
        Cons(input, Nil) -> {
          Test.assert_str_eq(input.path.to_utf8().unwrap(), fixture_path())
          Test.assert_eq_usize(input.limit, 4096)
          Test.assert_eq_usize(input.size, 66)
          Test.assert_str_eq(input.content, "sha256:02155a1e74b7084163e7a7f32ba6418e480b4d192c9ea940ba2e113239cedb1a")
        }
        _ -> Test.assert_true(false)
      }
    }
  }
}

test "production evaluator retains repeated reads in program order" {
  let source_path = path.from_utf8(fixture_path()).unwrap()
  match comptime_evaluate_file_reads(() => {
    let first = sql_schema.load(source_path, 4096)
    let second = sql_schema.load(source_path, 128)
    (first, second)
  }) {
    Err(_) -> Test.assert_true(false)
    Ok(product) -> match product.inputs {
      Cons(first, Cons(second, Nil)) -> {
        Test.assert_eq_usize(first.limit, 4096)
        Test.assert_eq_usize(second.limit, 128)
        Test.assert_str_eq(first.content, second.content)
      }
      _ -> Test.assert_true(false)
    }
  }
}

test "production evaluator rejects a failed observed read" {
  let missing = path.from_utf8("test/fixtures/comptime-schema-missing.json").unwrap()
  match comptime_evaluate_file_reads(() => sql_schema.load(missing, 64)) {
    Ok(_) -> Test.assert_true(false)
    Err(error) -> match error {
      ComptimeArtifactReadFailed(actual, _) -> Test.assert_str_eq(actual.to_utf8().unwrap(), "test/fixtures/comptime-schema-missing.json")
    }
  }
}

test "production evaluator accepts pure compiled code without inventing inputs" {
  match comptime_evaluate_file_reads(() => 42) {
    Err(_) -> Test.assert_true(false)
    Ok(product) -> {
      Test.assert_eq(product.value, 42)
      match product.inputs {
        Nil -> Test.assert_true(true)
        Cons(_, _) -> Test.assert_true(false)
      }
    }
  }
}
