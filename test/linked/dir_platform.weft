-- test/linked/dir_platform.weft -- real and mocked Dir capability coverage

use compiler/lib.{*}
use compiler/native_target.{NativeLinkLinuxAarch64, NativeLinkMacosAarch64, native_link_target_host}
use runtime/dir.{*}
use stdlib/dir.{*}
use stdlib/result.{*}
use stdlib/string.{*}
use stdlib/vector.{*}

fn dir_list_repo_probe() -[Dir]> i64 {
  match Dir.list("test/linked") {
    Ok(entries) -> {
      let mut i = 0
      let mut found = 0
      let mut dot_entries = 0
      while i < vector_len<str>(entries) {
        let name = vector_get_in_bounds<str>(entries, i)
        if str_eq(name, "dir_platform.weft") == 1 { found = 1 } else { 0 }
        if str_eq(name, ".") == 1 or str_eq(name, "..") == 1 {
          dot_entries = dot_entries + 1
        } else { 0 }
        i = i + 1
      }
      if found == 1 and dot_entries == 0 { 1 } else { 0 }
    }
    Err(error) -> 0
  }
}

test "dir_platform_lists_entries_and_filters_dot_names" {
  Test.assert_eq(runtime_platform_dir(dir_list_repo_probe), 1)
}

fn dir_list_error_probe(path: str) -[Dir]> i64 {
  match Dir.list(path) {
    Ok(entries) -> 0
    Err(error) -> if error > 0 { 1 } else { 0 }
  }
}

fn dir_list_errno_probe(path: str) -[Dir]> i64 {
  match Dir.list(path) {
    Ok(entries) -> 0
    Err(error) -> error
  }
}

fn dir_platform_denied_path() -> str {
  match native_link_target_host() {
    NativeLinkMacosAarch64 -> "/var/root"
    NativeLinkLinuxAarch64 -> "/root"
  }
}

test "dir_platform_list_surfaces_missing_bad_and_denied_paths" {
  Test.assert_eq(runtime_platform_dir(() => dir_list_error_probe("/tmp/weft_4i_dir_missing_7c43f1")), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_list_error_probe("/dev/null/child")), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_list_errno_probe(dir_platform_denied_path())), 13)
}

fn dir_stat_kind_probe(path: str, expected_kind: i64) -[Dir]> i64 {
  match Dir.stat(path) {
    Ok(metadata) -> {
      if metadata.exists and dir_kind_code(metadata.kind) == expected_kind and metadata.modified_millis > 0 { 1 } else { 0 }
    }
    Err(error) -> 0
  }
}

test "dir_platform_stat_covers_file_directory_and_other_kinds" {
  Test.assert_eq(runtime_platform_dir(() => dir_stat_kind_probe("test/linked/dir_platform.weft", 1)), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_stat_kind_probe("/tmp", 2)), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_stat_kind_probe("/dev/null", 3)), 1)
}

fn dir_stat_file_size_probe() -[Dir]> i64 {
  match Dir.stat("test/linked/dir_platform.weft") {
    Ok(metadata) -> if metadata.exists and metadata.size > 0 and metadata.device != 0 and metadata.inode > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
}

fn dir_stat_missing_probe(path: str) -[Dir]> i64 {
  match Dir.stat(path) {
    Ok(metadata) -> if metadata.exists { 0 } else { 1 }
    Err(error) -> 0
  }
}

fn dir_stat_error_probe(path: str) -[Dir]> i64 {
  match Dir.stat(path) {
    Ok(metadata) -> 0
    Err(error) -> if error > 0 { 1 } else { 0 }
  }
}

test "dir_platform_stat_reports_size_missing_and_bad_path_values" {
  Test.assert_eq(runtime_platform_dir(dir_stat_file_size_probe), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_stat_missing_probe("/tmp/weft_4i_stat_missing_7c43f1")), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_stat_error_probe("/dev/null/child")), 1)
}

fn dir_lstat_kind_probe(path: str, expected_kind: i64) -[Dir]> i64 {
  match Dir.lstat(path) {
    Ok(metadata) -> if metadata.exists and dir_kind_code(metadata.kind) == expected_kind and metadata.inode > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "dir_platform_lstat_reports_direct_file_and_directory_metadata" {
  Test.assert_eq(runtime_platform_dir(() => dir_lstat_kind_probe("test/linked/dir_platform.weft", 1)), 1)
  Test.assert_eq(runtime_platform_dir(() => dir_lstat_kind_probe("test/linked", 2)), 1)
}

fn dir_mutation_parent() -> str { "/tmp/weft_4i_dir_platform_7c43f1" }
fn dir_mutation_child() -> str { "/tmp/weft_4i_dir_platform_7c43f1/child" }
fn dir_mutation_renamed() -> str { "/tmp/weft_4i_dir_platform_7c43f1/renamed" }

fn dir_mutation_probe() -[Dir]> i64 {
  -- Recover from an interrupted prior run before asserting this run's states.
  Dir.remove(dir_mutation_child())
  Dir.remove(dir_mutation_renamed())
  Dir.remove(dir_mutation_parent())

  let mut ok = 1
  if Dir.mkdir(dir_mutation_parent()) != 0 { ok = 0 } else { 0 }
  if Dir.mkdir(dir_mutation_parent()) == 0 { ok = 0 } else { 0 }
  if Dir.mkdir(dir_mutation_child()) != 0 { ok = 0 } else { 0 }
  if Dir.rename(dir_mutation_child(), dir_mutation_renamed()) != 0 { ok = 0 } else { 0 }

  match Dir.stat(dir_mutation_child()) {
    Ok(metadata) -> if metadata.exists { ok = 0 } else { 0 }
    Err(error) -> { ok = 0 }
  }
  match Dir.stat(dir_mutation_renamed()) {
    Ok(metadata) -> if metadata.exists and dir_kind_code(metadata.kind) == 2 { 0 } else { ok = 0 }
    Err(error) -> { ok = 0 }
  }

  if Dir.remove(dir_mutation_renamed()) != 0 { ok = 0 } else { 0 }
  if Dir.remove(dir_mutation_parent()) != 0 { ok = 0 } else { 0 }
  if Dir.remove(dir_mutation_parent()) == 0 { ok = 0 } else { 0 }

  -- Idempotent cleanup keeps a failed assertion from poisoning later runs.
  Dir.remove(dir_mutation_child())
  Dir.remove(dir_mutation_renamed())
  Dir.remove(dir_mutation_parent())
  ok
}

test "dir_platform_mutations_cover_success_and_errno_failures" {
  Test.assert_eq(runtime_platform_dir(dir_mutation_probe), 1)
}

fn dir_getcwd_probe() -[Dir]> i64 {
  match Dir.getcwd() {
    Ok(path) -> if __str_len(path) > 0 { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "dir_platform_getcwd_returns_managed_path" {
  Test.assert_eq(runtime_platform_dir(dir_getcwd_probe), 1)
}

fn dir_mock_probe() -[Dir]> i64 {
  let list_score = match Dir.list("mock-list") {
    Ok(entries) -> vector_len<str>(entries)
    Err(error) -> 1000
  }
  let stat_score = match Dir.stat("mock-stat") {
    Ok(metadata) -> if metadata.exists {
      dir_kind_code(metadata.kind) + metadata.size + metadata.modified_millis
    } else { 1000 }
    Err(error) -> 1000
  }
  let lstat_score = match Dir.lstat("mock-lstat") {
    Ok(metadata) -> if metadata.exists {
      dir_kind_code(metadata.kind) + metadata.size + metadata.modified_millis
    } else { 1000 }
    Err(error) -> 1000
  }
  let mkdir_score = Dir.mkdir("mock-mkdir")
  let remove_score = Dir.remove("mock-remove")
  let rename_score = Dir.rename("mock-from", "mock-to")
  let cwd_score = match Dir.getcwd() {
    Ok(path) -> __str_len(path)
    Err(error) -> 1000
  }
  list_score + stat_score + lstat_score + mkdir_score + remove_score + rename_score + cwd_score
}

test "dir_effect_remains_fully_mockable" {
  let got = handle dir_mock_probe() {
    Dir.list(path) -> {
      let entries = vector_new<str>()
      vector_push<str>(entries, "one")
      resume(if str_eq(path, "mock-list") == 1 {
        result_ok<Vector<str>, i64>(entries)
      } else {
        result_err<Vector<str>, i64>(91)
      })
    }
    Dir.stat(path) -> resume(if str_eq(path, "mock-stat") == 1 {
      result_ok<DirMetadata, i64>(DirMetadata {
        exists: true,
        kind: DirDirectory,
        size: 7,
        modified_millis: 11,
        device: 13,
        inode: 17
      })
    } else {
      result_err<DirMetadata, i64>(92)
    })
    Dir.lstat(path) -> resume(if str_eq(path, "mock-lstat") == 1 {
      result_ok<DirMetadata, i64>(DirMetadata {
        exists: true,
        kind: DirFile,
        size: 13,
        modified_millis: 17,
        device: 19,
        inode: 23
      })
    } else {
      result_err<DirMetadata, i64>(96)
    })
    Dir.mkdir(path) -> resume(if str_eq(path, "mock-mkdir") == 1 { 3 } else { 93 })
    Dir.remove(path) -> resume(if str_eq(path, "mock-remove") == 1 { 5 } else { 94 })
    Dir.rename(from, to) -> resume(if str_eq(from, "mock-from") == 1 and str_eq(to, "mock-to") == 1 { 7 } else { 95 })
    Dir.getcwd() -> resume(result_ok<str, i64>("mock"))
  }
  Test.assert_eq(got, 71)
}
