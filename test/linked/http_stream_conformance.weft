fn http_linked_concurrent(
) -[Channel<SocketAddress>, SecureRandom, TcpConnect, TcpListen, TcpListenerIO, TcpReadiness, TcpStreamIO, WallClock, task.TaskScope]> i64 {
  let server = task.spawn(http_linked_server_tls)
  let client = task.spawn(http_linked_client_task)
  let server_status = server.join()
  let client_status = client.join()
  if server_status == 1 and client_status == 1 { 0 }
  else { if server_status != 1 { server_status } else { client_status } }
}

fn main() -> i64 {
  with platform_random() {
    with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() {
            handle task.with_event_loop_channel(
              channel.capacity<SocketAddress>(__i64_to_usize(1)).unwrap(),
              http_linked_concurrent
            ) {
              WallClock.now() -> resume(Ok<Timestamp, WallClockError>(
                wall.milliseconds_since_unix_epoch(1788134400000)
              ))
            }
          }
        }
      }
    }
  }
}
