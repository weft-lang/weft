fn http_linked_server(
) -[Channel<SocketAddress>, HttpServer, HttpBodyIO<TlsStream>, TcpListenerIO, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> i64 {
  let limits = http.default_limits()
  match HttpServer.listen(
    SocketV4(net.ipv4(127, 0, 0, 1), 0),
    tcp.listen_options(__i64_to_usize(8))
  ) {
    HttpServerListenFailed(error) -> Fail<i64>.fail(51)
    HttpServerListening(listener, address) -> {
      match Channel<SocketAddress>.send(address) {
        ChannelSendClosed(returned_address) -> {
          let closed = listener.close()
          Fail<i64>.fail(52)
        }
        ChannelSendAccepted -> match HttpServer.accept(listener, limits) {
          HttpServerAcceptFailed(returned, error) -> {
            let closed = returned.close()
            Fail<i64>.fail(53)
          }
          HttpServerRequestReady(returned, head, request_body) -> {
            match returned.close() {
              Err(error) -> Fail<i64>.fail(54)
              Ok(done) -> 0
            }
            let first: owned HttpConnection<TlsStream> = match http_linked_collect(request_body) {
              HttpLinkedBodyFailed(kind) -> Err<owned HttpConnection<TlsStream>, i64>(131 + kind)?
              HttpLinkedBodyReady(connection, body_bytes, trailers) -> {
                let matches = head.method().text() == "POST" and
                  head.target().bytes().eq(bytes.from_str("/stream")) and
                  body_bytes.eq(bytes.from_str("hello")) and
                  trailers.len() == 0
                if matches { connection }
                else {
                  let closed = http_linked_close(connection, 150)?
                  Err<owned HttpConnection<TlsStream>, i64>(150)?
                }
              }
            }
            let checked: owned HttpConnection<TlsStream> = http_linked_require_server_pool_rejection(first)
            let after_first: owned HttpConnection<TlsStream> = http_linked_server_response(checked)
            let after_first_checked: owned HttpConnection<TlsStream> = http_linked_require_server_pool_rejection(
              after_first
            )
            let second: owned HttpConnection<TlsStream> = http_linked_server_next_request(
              after_first_checked, "/again", 151
            )
            let after_second: owned HttpConnection<TlsStream> = http_linked_server_response(second)
            let third: owned HttpConnection<TlsStream> = http_linked_server_next_request(
              after_second, "/final", 171
            )
            let done: owned HttpConnection<TlsStream> = http_linked_server_response(third)
            let closed = http_linked_close(done, 191)?
            1
          }
        }
      }
    }
  }
}

