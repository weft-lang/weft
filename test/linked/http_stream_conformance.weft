fn http_linked_client_task(
) -[Channel<SocketAddress>, SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, WallClock]> i64 {
  match Channel<SocketAddress>.receive() {
    ChannelDrained -> 61
    ChannelReceived(address) -> handle http_linked_client_tls(http_linked_port(address)) {
      DnsResolve.resolve(host, port, family) -> resume(dns.numeric_candidates(
        IpV4(net.ipv4(127, 0, 0, 1)),
