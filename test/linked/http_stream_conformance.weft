type HttpLinkedBody {
  HttpLinkedBodyReady(owned HttpConnection<TlsStream>, Bytes, HttpHeaders),
    HttpLinkedBodyFailed(i64)
}

type HttpLinkedExchange {
  HttpLinkedExchangeReady(owned HttpConnectionPool<TlsStream>, owned HttpConnection<TlsStream>)
}

fn http_linked_transport_failure_kind(error: HttpTransportError) -> i64 {
  match error {
    HttpTransportTls(tls) -> match tls {
      TlsStreamTcp(error) -> 30
      TlsStreamReadiness(error) -> 31
      TlsStreamTls(error) -> 32
      TlsStreamPlaintextLimit(limit) -> 33
      TlsStreamInvalidProgress -> 34
      TlsStreamUnexpectedStep(step) -> 35
    }
    HttpTransportInvalidProgress -> 34
    HttpTransportReadTimeout(offset) -> 36
    HttpTransportWriteTimeout(offset) -> 37
    HttpTransportWriteMismatch(offset) -> 38
    HttpTransportUnexpectedWrite(offset) -> 39
    HttpTransportWriteIncomplete(remaining) -> 40
    HttpTransportReplayConsumed -> 41
  }
}

fn http_linked_header(name: str, value: str) -> HttpHeader {
  http.header(http.parse_field_name(name).unwrap(), bytes.from_str(value)).unwrap()
}

fn http_linked_headers(first_name: str, first_value: str) -> HttpHeaders {
  http.headers().append(http_linked_header(first_name, first_value))
}

fn http_linked_append(output: borrow mut Vector<u8>, data: Bytes) -> i64 {
  let values = data.to_vector()
  for index in 0..vector_len<u8>(values) {
    vector_push<u8>(output, vector_get_in_bounds<u8>(values, index))
  }
  0
}

fn http_linked_collect(
  stream: owned HttpBodyStream<TlsStream>
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO]> HttpLinkedBody {
  let mut output = vector.with_capacity<u8>(16)
  let mut current: owned HttpBodyStream<TlsStream> = stream
  loop {
    match current.read(__i64_to_usize(3)) {
      HttpBodyReadData(returned, data) -> {
        http_linked_append(output, data)
        current = returned
      }
      HttpBodyReadEnd(connection, trailers) -> break (HttpLinkedBodyReady(
        connection,
        bytes.from_vector(output),
        trailers
      ))
      HttpBodyReadEndClosed(trailers) -> break (HttpLinkedBodyFailed(1))
      HttpBodyReadFailed(returned, HttpBodyWrongDirection) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(2))
      }
      HttpBodyReadFailed(returned, HttpBodyTransport(error)) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(http_linked_transport_failure_kind(error)))
      }
      HttpBodyReadFailed(returned, HttpBodyFragmentLimit(limit)) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(4))
      }
      HttpBodyReadFailed(returned, HttpBodyUnexpectedEof(remaining)) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(5))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(HttpInvalidChunkSize(offset))) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(10))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(HttpChunkLineTooLong(offset))) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(11))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(HttpInvalidChunkTerminator(offset))) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(12))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(HttpTrailersTooLarge(offset))) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(13))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(HttpForbiddenTrailer(offset))) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(14))
      }
      HttpBodyReadFailed(returned, HttpBodyProtocol(error)) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(15))
      }
      HttpBodyReadFailed(returned, error) -> {
        let dropped = returned.drop()
        break (HttpLinkedBodyFailed(6))
      }
      HttpBodyReadCloseFailed(error) -> break (HttpLinkedBodyFailed(7))
    }
  }
}

fn http_linked_require_write(
  stream: owned HttpBodyStream<TlsStream>,
  data: Bytes,
  code: i64
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO]> Result<owned HttpBodyStream<TlsStream>, i64> {
  match stream.write(data) {
    HttpBodyWrote(returned, count) -> Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    HttpBodyWriteFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(code)
    }
  }
}

fn http_linked_drop_finish_outcome(
  outcome: HttpBodyFinishOutcome<TlsStream>,
  code: i64
) -[HttpTransportRelease<TlsStream>, TcpStreamIO]> Result<owned HttpBodyStream<TlsStream>, i64> {
  match outcome {
    HttpBodyFinishFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(code)
    }
    HttpBodyFinished(connection) -> {
      let dropped = connection.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(code)
    }
    HttpBodyFinishedClosed -> Err<owned HttpBodyStream<TlsStream>, i64>(code)
    HttpBodyFinishCloseFailed(error) -> Err<owned HttpBodyStream<TlsStream>, i64>(code)
  }
}

fn http_linked_fixed_writer_preflight(
  stream: owned HttpBodyStream<TlsStream>
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpBodyStream<TlsStream> {
  let incomplete: owned HttpBodyStream<TlsStream> = match stream.finish(http.headers()) {
    HttpBodyFinishFailed(returned, HttpBodyWriteIncomplete(remaining)) -> {
      if __u64_to_i64(__usize_to_u64(remaining)) == 5 {
        Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
      }
      else {
        let dropped = returned.drop()
        Err<owned HttpBodyStream<TlsStream>, i64>(71)
      }
    }
    outcome -> http_linked_drop_finish_outcome(outcome, 72)
  }?
  let overflow: owned HttpBodyStream<TlsStream> = match incomplete.write(bytes.from_str("hello!")) {
    HttpBodyWriteFailed(returned, HttpBodyWriteOverflow(remaining, attempted)) -> {
      let exact = __u64_to_i64(__usize_to_u64(remaining)) == 5 and
        __u64_to_i64(__usize_to_u64(attempted)) == 6
      if exact { Ok<owned HttpBodyStream<TlsStream>, i64>(returned) }
      else {
        let dropped = returned.drop()
        Err<owned HttpBodyStream<TlsStream>, i64>(73)
      }
    }
    HttpBodyWriteFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(74)
    }
    HttpBodyWrote(returned, count) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(75)
    }
  }?
  match overflow.write(bytes.from_str("")) {
    HttpBodyWrote(returned, count) -> if __u64_to_i64(__usize_to_u64(count)) == 0 {
      Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    } else {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(76)
    }
    HttpBodyWriteFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(77)
    }
  }?
}

fn http_linked_chunk_writer_preflight(
  stream: owned HttpBodyStream<TlsStream>
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpBodyStream<TlsStream> {
  match stream.read(__i64_to_usize(1)) {
    HttpBodyReadFailed(returned, HttpBodyWrongDirection) -> Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    HttpBodyReadFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(78)
    }
    HttpBodyReadData(returned, data) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(79)
    }
    HttpBodyReadEnd(connection, trailers) -> {
      let dropped = connection.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(80)
    }
    HttpBodyReadEndClosed(trailers) -> Err<owned HttpBodyStream<TlsStream>, i64>(81)
    HttpBodyReadCloseFailed(error) -> Err<owned HttpBodyStream<TlsStream>, i64>(82)
  }?
}

fn http_linked_chunk_finish_preflight(
  stream: owned HttpBodyStream<TlsStream>
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpBodyStream<TlsStream> {
  match stream.finish(http_linked_headers("Content-Length", "0")) {
    HttpBodyFinishFailed(returned, HttpBodyProtocol(HttpForbiddenTrailer(offset))) -> Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    outcome -> http_linked_drop_finish_outcome(outcome, 83)
  }?
}

fn http_linked_reader_preflight(
  stream: owned HttpBodyStream<TlsStream>
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpBodyStream<TlsStream> {
  let bounded: owned HttpBodyStream<TlsStream> = match stream.read(__i64_to_usize(0)) {
    HttpBodyReadFailed(returned, HttpBodyFragmentLimit(limit)) -> if __u64_to_i64(__usize_to_u64(limit)) == 0 {
      Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    } else {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(84)
    }
    HttpBodyReadFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(85)
    }
    HttpBodyReadData(returned, data) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(86)
    }
    HttpBodyReadEnd(connection, trailers) -> {
      let dropped = connection.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(87)
    }
    HttpBodyReadEndClosed(trailers) -> Err<owned HttpBodyStream<TlsStream>, i64>(88)
    HttpBodyReadCloseFailed(error) -> Err<owned HttpBodyStream<TlsStream>, i64>(89)
  }?
  match bounded.write(bytes.from_str("x")) {
    HttpBodyWriteFailed(returned, HttpBodyWrongDirection) -> Ok<owned HttpBodyStream<TlsStream>, i64>(returned)
    HttpBodyWriteFailed(returned, error) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(90)
    }
    HttpBodyWrote(returned, count) -> {
      let dropped = returned.drop()
      Err<owned HttpBodyStream<TlsStream>, i64>(91)
    }
  }?
}

fn http_linked_require_finish(
  stream: owned HttpBodyStream<TlsStream>,
  trailers: HttpHeaders,
  code: i64
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpConnection<TlsStream> {
  match stream.finish(trailers) {
    HttpBodyFinished(connection) -> connection
    HttpBodyFinishedClosed -> Err<owned HttpConnection<TlsStream>, i64>(code + 10)?
    HttpBodyFinishFailed(returned, HttpBodyWrongDirection) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 1)?
    }
    HttpBodyFinishFailed(returned, HttpBodyWriteIncomplete(remaining)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 2)?
    }
    HttpBodyFinishFailed(returned, HttpBodyProtocol(HttpForbiddenTrailer(offset))) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 3)?
    }
    HttpBodyFinishFailed(returned, HttpBodyTransport(error)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 4)?
    }
    HttpBodyFinishFailed(returned, HttpBodyFragmentLimit(limit)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 5)?
    }
    HttpBodyFinishFailed(returned, HttpBodyUnexpectedEof(remaining)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 6)?
    }
    HttpBodyFinishFailed(returned, HttpBodyWriteOverflow(remaining, attempted)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 7)?
    }
    HttpBodyFinishFailed(returned, HttpBodyUnsupportedUpgrade(framing)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 8)?
    }
    HttpBodyFinishFailed(returned, HttpBodyProtocol(error)) -> {
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(code + 9)?
    }
    HttpBodyFinishCloseFailed(error) -> Err<owned HttpConnection<TlsStream>, i64>(code + 11)?
  }
}

fn http_linked_close(
  connection: owned HttpConnection<TlsStream>,
  code: i64
) -[HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO]> Result<i64, i64> {
  match connection.close() {
    Ok(done) -> Ok<i64, i64>(0)
    Err(error) -> Err<i64, i64>(code)
  }
}

fn http_linked_port(address: SocketAddress) -> u16 {
  match address {
    SocketV4(host, port) -> port
    SocketV6(host, port, scope) -> port
  }
}

fn http_linked_url(port: u16, path: str) -> str {
  str_concat(
    "https://localhost:",
    str_concat(int_to_str(__u64_to_i64(port.to_u64())), path)
  )
}

fn http_linked_client_started(
  begun: HttpPooledClientBegin<TlsStream>,
  failure_base: i64
) -[HttpClient<TlsStream>, HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> HttpLinkedExchange {
  let limits = http.default_limits()
  match begun {
    HttpPooledRequestFailed(pool, HttpExchangeConnectionOrigin) -> {
      let dropped = pool.drop()
      Err<HttpLinkedExchange, i64>(failure_base + 1)?
    }
    HttpPooledRequestFailed(pool, HttpExchangeConnectionNotReusable) -> {
      let dropped = pool.drop()
      Err<HttpLinkedExchange, i64>(failure_base + 2)?
    }
    HttpPooledRequestFailed(pool, error) -> {
      let dropped = pool.drop()
      Err<HttpLinkedExchange, i64>(failure_base + 3)?
    }
    HttpPooledRequestReady(pool, body) -> {
      let ready: owned HttpBodyStream<TlsStream> = http_linked_fixed_writer_preflight(body)
      let wrote: owned HttpBodyStream<TlsStream> = http_linked_require_write(
        ready,
        bytes.from_str("hello"),
        failure_base + 1
      )?
      let connection: owned HttpConnection<TlsStream> = http_linked_require_finish(
        wrote,
        http.headers(),
        failure_base + 2
      )
      match HttpClient<TlsStream>.response(connection, HttpPost, limits) {
        HttpClientResponseFailed(error) -> {
          let dropped = pool.drop()
          Err<HttpLinkedExchange, i64>(failure_base + 3)?
        }
        HttpClientResponseReady(head, response_body) -> match http_linked_collect(
          http_linked_reader_preflight(response_body)
        ) {
          HttpLinkedBodyFailed(kind) -> {
            let dropped = pool.drop()
            Err<HttpLinkedExchange, i64>(failure_base + 4 + kind)?
          }
          HttpLinkedBodyReady(done, body_bytes, trailers) -> {
            let matches = head.status().code() == 200 and
              body_bytes.eq(bytes.from_str("world!")) and
              trailers.len() == 1
            if not matches {
              let closed = http_linked_close(done, failure_base + 5)?
              let dropped = pool.drop()
              Err<HttpLinkedExchange, i64>(failure_base + 5)?
            } else {
              HttpLinkedExchangeReady(pool, done)
            }
          }
        }
      }
    }
  }
}

fn http_linked_client_exchange(
  pool: owned HttpConnectionPool<TlsStream>,
  port: u16,
  path: str,
  failure_base: i64
) -[HttpClient<TlsStream>, HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> HttpLinkedExchange {
  let limits = http.default_limits()
  let authority = str_concat("localhost:", int_to_str(__u64_to_i64(port.to_u64())))
  let headers = http_linked_headers("Host", authority).append(
    http_linked_header("Content-Length", "5")
  )
  let request = http.request(
    HttpPost,
    http.parse_request_target(path).unwrap(),
    Http11,
    headers,
    limits
  ).unwrap()
  let url = url.parse(http_linked_url(port, path)).unwrap()
  http_linked_client_started(
    pool.begin(url, request, limits),
    failure_base
  )
}

fn http_linked_client_reuse_exchange(
  pool: owned HttpConnectionPool<TlsStream>,
  connection: owned HttpConnection<TlsStream>,
  port: u16,
  path: str,
  failure_base: i64
) -[HttpClient<TlsStream>, HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> HttpLinkedExchange {
  let limits = http.default_limits()
  let authority = str_concat("localhost:", int_to_str(__u64_to_i64(port.to_u64())))
  let headers = http_linked_headers("Host", authority).append(
    http_linked_header("Content-Length", "5")
  )
  let request = http.request(
    HttpPost,
    http.parse_request_target(path).unwrap(),
    Http11,
    headers,
    limits
  ).unwrap()
  let url = url.parse(http_linked_url(port, path)).unwrap()
  let begun = match HttpClient<TlsStream>.reuse(url, connection, request, limits) {
    HttpClientRequestFailed(error) -> HttpPooledRequestFailed(pool, error)
    HttpClientRequestReady(body) -> HttpPooledRequestReady(pool, body)
  }
  http_linked_client_started(begun, failure_base)
}

fn http_linked_client(
  port: u16
) -[HttpClient<TlsStream>, HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> i64 {
  let zero: owned HttpConnectionPool<TlsStream> = http_client.pool<TlsStream>(0).unwrap()
  let first = http_linked_client_exchange(zero, port, "/stream", 31)
  match first {
    HttpLinkedExchangeReady(empty, connection) -> match empty.release(connection) {
      HttpPoolAtCapacity(returned_empty, rejected) -> {
        if returned_empty.len() != 0 {
          let closed = http_linked_close(rejected, 61)?
          let dropped = returned_empty.drop()
          Fail<i64>.fail(61)
        } else {
          let dropped = returned_empty.drop()
          let one: owned HttpConnectionPool<TlsStream> = http_client.pool<TlsStream>(1).unwrap()
          match http_linked_client_reuse_exchange(one, rejected, port, "/again", 71) {
            HttpLinkedExchangeReady(empty_one, second_connection) -> match empty_one.release(
              second_connection
            ) {
              HttpPoolStored(stored) -> match stored.checkout(
                url.parse("https://other.example/not-this-origin").unwrap()
              ) {
                HttpPoolHit(returned, unexpected) -> {
                  let closed = http_linked_close(unexpected, 81)?
                  let dropped = returned.drop()
                  Fail<i64>.fail(81)
                }
                HttpPoolMiss(preserved) -> {
                  if preserved.len() != 1 {
                    let dropped = preserved.drop()
                    Fail<i64>.fail(82)
                  } else { match http_linked_client_exchange(
                      preserved, port, "/final", 91
                    ) {
                      HttpLinkedExchangeReady(checked_out, third_connection) -> match checked_out.release(
                        third_connection
                      ) {
                        HttpPoolStored(final_pool) -> {
                          let retained = final_pool.len()
                          let dropped = final_pool.drop()
                          if retained == 1 and dropped == 0 { 1 } else { 83 }
                        }
                        HttpPoolAtCapacity(returned, unexpected) -> {
                          let closed = http_linked_close(unexpected, 84)?
                          let dropped = returned.drop()
                          Fail<i64>.fail(84)
                        }
                        HttpPoolConnectionNotReusable(returned, unexpected) -> {
                          let closed = http_linked_close(unexpected, 85)?
                          let dropped = returned.drop()
                          Fail<i64>.fail(85)
                        }
                        HttpPoolForeignConnection(returned, unexpected) -> {
                          let closed = http_linked_close(unexpected, 86)?
                          let dropped = returned.drop()
                          Fail<i64>.fail(86)
                        }
                      }
                    } }
                }
              }
              HttpPoolAtCapacity(returned, unexpected) -> {
                let closed = http_linked_close(unexpected, 87)?
                let dropped = returned.drop()
                Fail<i64>.fail(87)
              }
              HttpPoolConnectionNotReusable(returned, unexpected) -> {
                let closed = http_linked_close(unexpected, 88)?
                let dropped = returned.drop()
                Fail<i64>.fail(88)
              }
              HttpPoolForeignConnection(returned, unexpected) -> {
                let closed = http_linked_close(unexpected, 89)?
                let dropped = returned.drop()
                Fail<i64>.fail(89)
              }
            }
          }
        }
      }
      HttpPoolStored(returned) -> {
        let dropped = returned.drop()
        Fail<i64>.fail(62)
      }
      HttpPoolConnectionNotReusable(returned, rejected) -> {
        let closed = http_linked_close(rejected, 63)?
        let dropped = returned.drop()
        Fail<i64>.fail(63)
      }
      HttpPoolForeignConnection(returned, rejected) -> {
        let closed = http_linked_close(rejected, 64)?
        let dropped = returned.drop()
        Fail<i64>.fail(64)
      }
    }
  }
}

fn http_linked_client_tls(
  port: u16
) -[DnsResolve, SecureRandom, TcpConnect, TcpReadiness, TcpStreamIO, WallClock]> i64 {
  handle endpoint.with_client_tls(
    tls_fixture_ca(),
    () => http_linked_client(port)
  ) {
    Fail<i64>.fail(code) -> code
  }
}

fn http_linked_server_response(
  connection: owned HttpConnection<TlsStream>
) -[HttpServer, HttpBodyIO<TlsStream>, HttpTransportRelease<TlsStream>, TcpStreamIO, Fail<i64>]> owned HttpConnection<TlsStream> {
  let limits = http.default_limits()
  let response = http.response(
    HttpPost,
    Http11,
    http.status(200).unwrap(),
    bytes.from_str("OK"),
    http_linked_headers("Transfer-Encoding", "chunked"),
    limits
  ).unwrap()
  match HttpServer.respond(connection, response, limits) {
    HttpServerResponseFailed(error) -> Fail<i64>.fail(41)
