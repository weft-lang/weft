    HttpPoolAtCapacity(returned, rejected) -> {
      let closed = http_linked_close(rejected, 122)?
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(122)?
    }
    HttpPoolConnectionNotReusable(returned, rejected) -> {
      let closed = http_linked_close(rejected, 123)?
      let dropped = returned.drop()
      Err<owned HttpConnection<TlsStream>, i64>(123)?
    }
  }
}

