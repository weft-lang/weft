use "stdlib/par.weft"
use "stdlib/string.weft"

type ParGenericRecord {
  left: i64,
  right: f64,
  name: str
}

fn par_with_custom_generic_sequential_i64<E>(body: () -[Par, E]> i64) -[E]> i64 {
  let works = runtime_par_work_scope_new()
  defer runtime_par_work_scope_cleanup(works)
  handle body() {
    Par.submit(work) -> resume(runtime_par_work_scope_track(works, par_work_sequential_submit(work)))
    Par.join(task) -> resume(runtime_par_work_join(task))
  }
}

test "generic ParTask transports scalar results through the sequential policy" {
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<i64>(() => 42)
    par_await<i64>(task)
  })
  Test.assert_eq(got, 42)
}

test "generic ParTask transports zero-lane nil results" {
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<nil>(() => nil)
    let done = par_await<nil>(task)
    42
  })
  Test.assert_eq(got, 42)
}

test "generic ParTask transports floating results without losing bits" {
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<f64>(() => 41.5)
    if par_await<f64>(task) == 41.5 { 1 } else { 0 }
  })
  Test.assert_eq(got, 1)
}

test "generic ParTask transports multi-lane tuple results in order" {
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<(i64, i64)>(() => (20, 22))
    let (left, right): (i64, i64) = par_await<(i64, i64)>(task)
    left + right
  })
  Test.assert_eq(got, 42)
}

test "generic ParTask transports fixed-array results" {
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<[i64; 3]>(() => [10, 20, 12])
    let values: [i64; 3] = par_await<[i64; 3]>(task)
    values[0] + values[1] + values[2]
  })
  Test.assert_eq(got, 42)
}

test "generic ParTask moves managed nominal results and captured environments" {
  let prefix = "we"
  let got = par_with_sequential_i64(() => {
    let task = par_spawn<ParGenericRecord>(() => ParGenericRecord { left: 20, right: 22.0, name: prefix })
    let value = par_await<ParGenericRecord>(task)
    value.left + if value.right == 22.0 { str_len(value.name) } else { 0 }
  })
  Test.assert_eq(got, 22)
}

test "pthread handler preserves generic semantics through its inline fallback" {
  let got = par_with_pthread_pool_i64(2, 8, () => {
    let task = par_spawn<i64>(() => 42)
    par_await<i64>(task)
  })
  Test.assert_eq(got, 42)
}

test "generic task wrappers remain ordinary algebraic operations for custom policies" {
  let got = par_with_custom_generic_sequential_i64(() => {
    let task = par_spawn<i64>(() => 42)
    par_await<i64>(task)
  })
  Test.assert_eq(got, 42)
}
