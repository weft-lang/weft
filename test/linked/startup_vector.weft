use runtime/memory.{mem_load64_at}
use runtime/unsafe.{Unsafe}

-- test/linked/startup_vector.weft - the process entry records the startup
-- argument vector, and the trusted platform intrinsic returns exactly the
-- vector and terminator the entry received.
fn recorded_raw() -[Unsafe]> i64 { __platform_proc_startup_vector() }

fn recorded() -> i64 {
  handle recorded_raw() { Unsafe.transmute(raw) -> resume(__transmute(raw)) }
}

fn count_to_terminator(vector: i64) -> i64 {
  let mut count = 0
  while mem_load64_at(vector, count * 8) != 0 { count = count + 1 }
  count
}

fn main(argc: i64, argv: i64) -> i64 {
  let vector = recorded()
  if vector == 0 { 1 }
  else if vector != argv { 2 }
  else if count_to_terminator(vector) != argc { 3 }
  else if mem_load64_at(vector, 0) == 0 { 4 }
  else if recorded() != vector { 5 }
  else { 0 }
}
