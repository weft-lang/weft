-- test/linked/secure_random_platform.weft — real Darwin CSPRNG product

use runtime/secure_random as platform_random
use runtime/time as platform_time
use stdlib/result.{Err, Ok}
use stdlib/secure_random as secure_random
use stdlib/secure_random.{SecureRandom}
use stdlib/time/monotonic as monotonic

fn secure_random_platform_length(count: i64) -[SecureRandom]> i64 {
  match secure_random.bytes(__i64_to_usize(count)) {
    Ok(values) -> if values.len() == count { 1 } else { 0 }
    Err(error) -> 0
  }
}

test "Darwin SecureRandom covers zero one chunk and multi chunk requests" {
  -- Keep this as a real relocatable-object product, matching the platform
  -- handler integration path rather than the standalone syscall emitter.
  Test.assert_eq(if platform_time.with_platform(() => monotonic.now()).nanoseconds() > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(with platform_random() { secure_random_platform_length(0) }, 1)
  Test.assert_eq(with platform_random() { secure_random_platform_length(1) }, 1)
  Test.assert_eq(with platform_random() { secure_random_platform_length(256) }, 1)
  Test.assert_eq(with platform_random() { secure_random_platform_length(257) }, 1)
  Test.assert_eq(with platform_random() { secure_random_platform_length(513) }, 1)
}

fn secure_random_platform_distinct() -[SecureRandom]> i64 {
  match secure_random.bytes(__i64_to_usize(32)) {
    Err(error) -> 0
    Ok(first) -> match secure_random.bytes(__i64_to_usize(32)) {
      Err(error) -> 0
      Ok(second) -> if first.eq(second) { 0 } else { 1 }
    }
  }
}

test "Darwin SecureRandom produces independent draws" {
  Test.assert_eq(with platform_random() { secure_random_platform_distinct() }, 1)
}

fn secure_random_platform_managed_result() -[SecureRandom]> str {
  match secure_random.bytes(__i64_to_usize(0)) {
    Ok(values) -> if values.len() == 0 { "empty" } else { "unexpected" }
    Err(error) -> "failed"
  }
}

test "Darwin SecureRandom preserves an arbitrary managed result" {
  Test.assert_str_eq(with platform_random() { secure_random_platform_managed_result() }, "empty")
}
