use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/num
use stdlib/http as http
use stdlib/http.{HttpHeaders, HttpRequestHeadReady}
use stdlib/option.{None, Some, Option}
use stdlib/panic.{panic}
use stdlib/result.{Err, Ok, Result}
use stdlib/string
use stdlib/websocket as websocket
use stdlib/websocket.{*}

fn finite_ws_limits() -> WebSocketLimits {
  websocket.limits(18446744073709551615, 18446744073709551615).unwrap()
}

fn finite_ws_bytes(values: [u8]) -> Bytes { bytes.from_slice(values) }

fn finite_ws_header(payload: Bytes, final: bool, opcode: WebSocketOpcode) -> WebSocketFrameHeader {
  let wire = websocket.encode_server_frame(final, opcode, payload, finite_ws_limits()).unwrap()
  match websocket.parse_frame_header(wire, WebSocketClient, finite_ws_limits()) {
    WebSocketFrameReady(header, consumed) -> header
    _ -> panic("encoded header must parse")
  }
}

fn finite_ws_fragment(state: WebSocketMessageState, payload: Bytes, final: bool, opcode: WebSocketOpcode, cut: usize) -> Result<WebSocketMessageState, WebSocketError> {
  let initial = state.begin(websocket.close_handshake(), WebSocketReceiveMessages, finite_ws_header(payload, final, opcode), finite_ws_limits()).unwrap()
  let frame = if cut > 0 and cut < payload.len() {
    match initial.read(WebSocketMessageChunk(payload.slice(0, cut).unwrap())) {
      WebSocketMessageMore(next) -> next
      WebSocketMessageFailed(error) -> return Err<WebSocketMessageState, WebSocketError>(error)
      WebSocketMessageDone(next) -> panic("nonterminal input ended a frame")
    }
  } else { initial }
  let zero: usize = 0
  let start = if cut > 0 and cut < payload.len() { cut } else { zero }
  match frame.read(WebSocketMessageEnd(payload.slice(start, payload.len()).unwrap())) {
    WebSocketMessageDone(next) -> Ok<WebSocketMessageState, WebSocketError>(next)
    WebSocketMessageFailed(error) -> Err<WebSocketMessageState, WebSocketError>(error)
    WebSocketMessageMore(next) -> panic("terminal input left a frame open")
  }
}

fn finite_ws_split(payload: Bytes, split: usize, left_cut: usize, right_cut: usize) -> Result<WebSocketMessageState, WebSocketError> {
  let first = payload.slice(0, split).unwrap()
  let last = payload.slice(split, payload.len()).unwrap()
  let active = match finite_ws_fragment(websocket.message_state(), first, false, WebSocketText, left_cut) {
    Err(error) -> return Err<WebSocketMessageState, WebSocketError>(error)
    Ok(next) -> next
  }
  let mut interrupted = active
  for opcode in [WebSocketPing, WebSocketPong, WebSocketClose] {
    interrupted = finite_ws_fragment(interrupted, bytes.empty(), true, opcode, 0).unwrap()
  }
  finite_ws_fragment(interrupted, last, true, WebSocketContinuation, right_cut)
}

fn main() -> i64 {
  let source: [u8; 10] = [130, 127, 127, 255, 255, 255, 255, 255, 255, 255]
  match websocket.parse_frame_header(finite_ws_bytes(source[..]), WebSocketClient, finite_ws_limits()) {
    WebSocketFrameReady(header, count) -> {
      if count != 10 or header.payload_bytes() != 9223372036854775807 { return 1 }
      match header.payload_decoder().read(bytes.from_str("abc")) {
        WebSocketPayloadChunk(next, payload, read) -> if next.remaining() != 9223372036854775804 or read != 3 or payload.to_utf8().unwrap() != "abc" { return 2 }
        _ -> return 3
      }
    }
    _ -> return 4
  }
  let invalid: [u8; 10] = [130, 127, 255, 255, 255, 255, 255, 255, 255, 255]
  match websocket.parse_frame_header(finite_ws_bytes(invalid[..]), WebSocketClient, finite_ws_limits()) {
    WebSocketFrameFailed(WebSocketInvalidLength(count)) -> if count != 18446744073709551615 { return 5 }
    _ -> return 6
  }
  let origin: usize = 0
  for split in origin..7 {
    match finite_ws_split(bytes.from_str("a😀z"), split, 1, 1) {
      Ok(state) -> match state.pending() { None -> nil Some(kind) -> return 7 }
      _ -> return 8
    }
  }
  let truncated: [u8; 4] = [97, 240, 159, 152]
  match finite_ws_split(finite_ws_bytes(truncated[..]), 2, 1, 1) {
    Err(WebSocketInvalidText(1)) -> nil
    _ -> return 9
  }
  let sent = match websocket.close_handshake().on_send() {
    WebSocketCloseAwaitPeer(state) -> state
    _ -> return 10
  }
  match sent.on_receive(WebSocketCloseWithoutStatus) {
    WebSocketCloseComplete(state) -> if not state.is_complete() { return 11 }
    _ -> return 12
  }
  0
}
