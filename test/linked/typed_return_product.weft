use stdlib/list.{Cons, Nil}

fn finite() -> usize {
  let mut visited: usize = 0
  for _ in Cons<i64>(1, Nil<i64>()) {
    visited = visited + 1
    return visited
  }
  visited
}

fn maximum() -> usize {
  let value: usize = 18446744073709551615
  return value
}

fn main() -> i64 {
  if finite() == 1 and maximum() == 18446744073709551615 { 0 } else { 1 }
}
