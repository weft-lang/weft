-- test/linked/par_pool_map.weft - pthread-backed batch pool map.

use "stdlib/par.weft"

fn ppm_double(x: i64) -> i64 { x * 2 }
fn ppm_inc(x: i64) -> i64 { x + 1 }
fn ppm_add(acc: i64, x: i64) -> i64 { acc + x }

fn ppm_many_items() -> i64 {
  Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Cons<i64>(4, Cons<i64>(5, Nil)))))
}

fn ppm_two_items() -> i64 {
  Cons<i64>(20, Cons<i64>(21, Nil))
}

test "par_pthread_pool_map_many_tasks" {
  let mapped = par_pthread_pool_map(ppm_many_items(), ppm_double, 3)
  Test.assert_eq(list_fold<i64, i64>(mapped, 0, ppm_add), 30)
}

test "par_pthread_pool_map_worker_count_clamped" {
  let mapped = par_pthread_pool_map(Cons<i64>(41, Nil), ppm_inc, 8)
  Test.assert_eq(list_fold<i64, i64>(mapped, 0, ppm_add), 42)
}

test "par_pthread_pool_map_zero_workers_defaults" {
  let mapped = par_pthread_pool_map(ppm_two_items(), ppm_inc, 0)
  Test.assert_eq(list_fold<i64, i64>(mapped, 0, ppm_add), 43)
}

test "par_pthread_pool_map_empty_work" {
  let mapped = par_pthread_pool_map(Nil, ppm_double, 4)
  Test.assert_eq(list_fold<i64, i64>(mapped, 7, ppm_add), 7)
}
