-- test/linked/par_pool_map.weft - pthread-backed batch pool map.

use stdlib/par.{*}
use stdlib/list as list
use stdlib/list.{*}
use runtime/par_task.{*}

fn ppm_double(x: i64) -> i64 { x * 2 }
fn ppm_inc(x: i64) -> i64 { x + 1 }
fn ppm_add(acc: i64, x: i64) -> i64 { acc + x }

fn ppm_many_items() -> List<i64> {
  list.range(1, 6)
}

fn ppm_two_items() -> List<i64> {
  Cons<i64>(20, Cons<i64>(21, Nil<i64>()))
}

fn ppm_range_items(count: i64) -> List<i64> {
  list.range(1, count + 1)
}

fn ppm_expected_double_sum(count: i64) -> i64 {
  count * (count + 1)
}

fn ppm_pool_double_sum(count: i64, workers: i64) -> i64 {
  let mapped = par_pthread_pool_map(ppm_range_items(count), ppm_double, workers)
  mapped.fold<i64>(0, ppm_add)
}

fn ppm_nth_or(values: List<i64>, index: i64, default: i64) -> i64 {
  let mut current = values
  let mut position = 0
  let mut result = default
  let mut done = false
  while not done {
    match current {
      Nil -> { done = true }
      Cons(value, rest) -> {
        if position == index {
          result = value
          done = true
        } else {
          current = rest
          position = position + 1
        }
      }
    }
  }
  result
}

test "par_pthread_pool_map_many_tasks" {
  let mapped = par_pthread_pool_map(ppm_many_items(), ppm_double, 3)
  Test.assert_eq(mapped.fold<i64>(0, ppm_add), 30)
}

test "par_pthread_pool_map_worker_count_clamped" {
  let mapped = par_pthread_pool_map(Cons<i64>(41, Nil<i64>()), ppm_inc, 8)
  Test.assert_eq(mapped.fold<i64>(0, ppm_add), 42)
}

test "par_pthread_pool_map_zero_workers_defaults" {
  let mapped = par_pthread_pool_map(ppm_two_items(), ppm_inc, 0)
  Test.assert_eq(mapped.fold<i64>(0, ppm_add), 43)
}

test "par_pthread_pool_map_empty_work" {
  let mapped = par_pthread_pool_map(Nil<i64>(), ppm_double, 4)
  Test.assert_eq(mapped.fold<i64>(7, ppm_add), 7)
}

test "par_pthread_pool_map_preserves_order_with_local_deques" {
  let mapped = par_pthread_pool_map(ppm_range_items(6), ppm_inc, 3)
  Test.assert_eq(ppm_nth_or(mapped, 0, 0 - 1), 2)
  Test.assert_eq(ppm_nth_or(mapped, 1, 0 - 1), 3)
  Test.assert_eq(ppm_nth_or(mapped, 2, 0 - 1), 4)
  Test.assert_eq(ppm_nth_or(mapped, 3, 0 - 1), 5)
  Test.assert_eq(ppm_nth_or(mapped, 4, 0 - 1), 6)
  Test.assert_eq(ppm_nth_or(mapped, 5, 0 - 1), 7)
  Test.assert_eq(ppm_nth_or(mapped, 6, 0 - 1), 0 - 1)
}

test "par_pthread_pool_map_worker_task_matrix_small" {
  Test.assert_eq(ppm_pool_double_sum(0, 1), ppm_expected_double_sum(0))
  Test.assert_eq(ppm_pool_double_sum(1, 1), ppm_expected_double_sum(1))
  Test.assert_eq(ppm_pool_double_sum(2, 1), ppm_expected_double_sum(2))
  Test.assert_eq(ppm_pool_double_sum(2, 2), ppm_expected_double_sum(2))
  Test.assert_eq(ppm_pool_double_sum(2, 5), ppm_expected_double_sum(2))
}

test "par_pthread_pool_map_worker_task_matrix_zero_default" {
  Test.assert_eq(ppm_pool_double_sum(1, 0), ppm_expected_double_sum(1))
  Test.assert_eq(ppm_pool_double_sum(4, 0), ppm_expected_double_sum(4))
}

test "par_pthread_pool_map_worker_task_matrix_many_tiny" {
  Test.assert_eq(ppm_pool_double_sum(8, 3), ppm_expected_double_sum(8))
  Test.assert_eq(ppm_pool_double_sum(16, 4), ppm_expected_double_sum(16))
  Test.assert_eq(ppm_pool_double_sum(32, 8), ppm_expected_double_sum(32))
}
