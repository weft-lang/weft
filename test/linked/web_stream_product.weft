-- test/linked/web_stream_product.weft — outside-user safe web product

use examples/https_json_streams.{https_json_streams_run}
use runtime/tcp_connect as tcp_connect_handler
use runtime/tcp_listen as tcp_listen_handler
use runtime/tcp_listener_io as tcp_listener_io_handler
use runtime/tcp_stream_io as tcp_stream_io_handler
use runtime/secure_random as platform_random
use test/linked_support/tls_fixtures.{tls_fixture_ca, tls_fixture_server_certificate, tls_fixture_server_private_key}

fn main() -> i64 {
  with platform_random() {
    with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() {
            https_json_streams_run(
              tls_fixture_ca(),
              tls_fixture_server_certificate(),
              tls_fixture_server_private_key()
            )
          }
        }
      }
    }
  }
}
