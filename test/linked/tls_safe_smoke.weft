-- test/linked/tls_safe_smoke.weft — safe TLS binding product smoke

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/result.{Err, Ok}
use stdlib/secure_random.{SecureRandom, SecureRandomError}
use stdlib/time.{Time}
use stdlib/tls as tls
use stdlib/tls.{TlsTrust}
use stdlib/url as url

fn tls_smoke_open_invalid_roots_with_authority() -[SecureRandom, Time]> i64 {
  match url.parse("https://localhost/") {
    Err(error) -> 1
    Ok(url) -> {
      let opened = tls.client(url.host(), bytes.from_str("bad"))
      match opened {
        Err(TlsTrust) -> 0
        Err(error) -> 2
        Ok(session) -> 3
      }
    }
  }
}

fn tls_smoke_with_random() -[Time]> i64 {
  handle tls_smoke_open_invalid_roots_with_authority() {
    SecureRandom.bytes(count) -> {
      resume(Ok<Bytes, SecureRandomError>(
        bytes.from_str("0123456789abcdef0123456789abcdef0123456789abcdef")
      ))
    }
  }
}

fn main() -> i64 {
  handle tls_smoke_with_random() {
    Time.now_millis() -> resume(1788134400000)
    Time.now_nanos() -> resume(0)
    Time.sleep_millis(ms) -> resume(0)
  }
}
