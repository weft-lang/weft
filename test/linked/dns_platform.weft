-- test/linked/dns_platform.weft — sealed Darwin resolver product

use runtime/dns as platform_dns
use runtime/dns.{runtime_dns_error_from_status}
use stdlib/fail.{Fail}
use stdlib/dns as dns
use stdlib/dns.{DnsAnyFamily, DnsError, DnsFamilyUnavailable, DnsIpv4Only, DnsIpv6Only, DnsNameNotFound, DnsPermanentFailure, DnsPlatform, DnsResolve, DnsResourceExhausted, DnsTemporaryFailure}
use stdlib/eq.{Eq}
use stdlib/idna as idna
use stdlib/idna.{DomainName}
use stdlib/net_address as net
use stdlib/net_address.{SocketAddress, SocketV4, SocketV6}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{vector_get_in_bounds, vector_len}
use stdlib/vector/handles.{Vector}

effect DnsPlatformResidual {
  fn tick() -> i64
}

fn dns_platform_domain(source: str) -> DomainName {
  idna.parse(source).expect("platform DNS test domain must be valid")
}

fn dns_platform_error_kind(error: DnsError) -> i64 {
  match error {
    DnsNameNotFound -> 1
    DnsTemporaryFailure -> 2
    DnsPermanentFailure -> 3
    DnsFamilyUnavailable -> 4
    DnsPolicyDenied -> 6
    DnsResourceExhausted -> 5
    DnsPlatform(code) -> 100 + code
  }
}

test "Darwin DNS maps every getaddrinfo status into the portable error family" {
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(1, 0)), 4)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(2, 0)), 2)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(3, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(4, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(5, 0)), 4)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(6, 0)), 5)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(7, 0)), 1)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(8, 0)), 1)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(9, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(10, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(11, 77)), 177)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(12, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(13, 0)), 3)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(14, 0)), 5)
  Test.assert_eq(dns_platform_error_kind(runtime_dns_error_from_status(99, 0)), 199)
}

fn dns_platform_result_is_loopback(
  result: Result<Vector<SocketAddress>, DnsError>,
  port: u16,
  family: i64
) -> bool {
  match result {
    Err(_) -> false
    Ok(candidates) -> {
      let count = vector_len<SocketAddress>(candidates)
      if count == 0 { return false } else { 0 }
      for index in 0..count {
        let accepted = match vector_get_in_bounds<SocketAddress>(candidates, index) {
          SocketV4(address, actual_port) ->
            family != 6 and actual_port == port and address.eq(net.ipv4(127, 0, 0, 1))
          SocketV6(address, actual_port, scope) ->
            family != 4 and actual_port == port and scope == 0 and
            address.eq(net.ipv6(0, 0, 0, 0, 0, 0, 0, 1))
        }
        if not accepted { return false } else { 0 }
      }
      true
    }
  }
}

fn dns_platform_results_equal(
  left: Result<Vector<SocketAddress>, DnsError>,
  right: Result<Vector<SocketAddress>, DnsError>
) -> bool {
  match left {
    Err(left_error) -> match right {
      Err(right_error) -> dns_platform_error_kind(left_error) == dns_platform_error_kind(right_error)
      Ok(_) -> false
    }
    Ok(left_candidates) -> match right {
      Err(_) -> false
      Ok(right_candidates) -> {
        let count = vector_len<SocketAddress>(left_candidates)
        if count != vector_len<SocketAddress>(right_candidates) { return false } else { 0 }
        for index in 0..count {
          if not vector_get_in_bounds<SocketAddress>(left_candidates, index).eq(
            vector_get_in_bounds<SocketAddress>(right_candidates, index)
          ) { return false } else { 0 }
        }
        true
      }
    }
  }
}

fn dns_platform_localhost_probe() -[DnsResolve]> i64 {
  let host = dns_platform_domain("localhost.")
  let first = dns.resolve(host, 8443, DnsAnyFamily)
  let second = dns.resolve(host, 8443, DnsAnyFamily)
  let mut score = 0
  if dns_platform_result_is_loopback(first, 8443, 0) { score = score + 1 } else { 0 }
  if dns_platform_results_equal(first, second) { score = score + 1 } else { 0 }
  if dns_platform_result_is_loopback(dns.resolve(host, 80, DnsIpv4Only), 80, 4) {
    score = score + 1
  } else { 0 }
  if dns_platform_result_is_loopback(dns.resolve(host, 65535, DnsIpv6Only), 65535, 6) {
    score = score + 1
  } else { 0 }
  score
}

test "Darwin DNS copies ordered IPv4 and IPv6 localhost candidates" {
  Test.assert_eq(with platform_dns() { dns_platform_localhost_probe() }, 4)
}

fn dns_platform_numeric_probe() -[DnsResolve]> i64 {
  let host = dns_platform_domain("127.0.0.1.")
  let mut score = 0
  if dns_platform_result_is_loopback(dns.resolve(host, 0, DnsAnyFamily), 0, 4) {
    score = score + 1
  } else { 0 }
  match dns.resolve(host, 443, DnsIpv6Only) {
    Err(DnsFamilyUnavailable) -> { score = score + 1 0 }
    _ -> 0
  }
  score
}

test "Darwin DNS keeps numeric IPv4 local and applies family policy" {
  Test.assert_eq(with platform_dns() { dns_platform_numeric_probe() }, 2)
}

fn dns_platform_repeat_probe() -[DnsResolve]> i64 {
  let host = dns_platform_domain("localhost")
  let mut resolved = 0
  for index in 0..64 {
    if dns_platform_result_is_loopback(dns.resolve(host, 443, DnsAnyFamily), 443, 0) {
      resolved = resolved + 1
    } else { 0 }
  }
  resolved
}

test "Darwin DNS repeatedly copies and releases native resolver answers" {
  Test.assert_eq(with platform_dns() { dns_platform_repeat_probe() }, 64)
}

fn dns_platform_managed_probe() -[DnsResolve, DnsPlatformResidual]> str {
  if dns_platform_result_is_loopback(
    dns.resolve(dns_platform_domain("127.0.0.1"), 53, DnsIpv4Only),
    53,
    4
  ) and DnsPlatformResidual.tick() == 41 {
    "resolved"
  } else {
    "failed"
  }
}

test "Darwin DNS preserves residual effects and an arbitrary managed result" {
  let got = handle with platform_dns() { dns_platform_managed_probe() } {
    DnsPlatformResidual.tick() -> resume(41)
  }
  Test.assert_str_eq(got, "resolved")
}

fn dns_platform_abort_after_resolution() -[DnsResolve, Fail<i64>]> i64 {
  match dns.resolve(dns_platform_domain("localhost"), 443, DnsAnyFamily) {
    Err(error) -> 0
    Ok(candidates) -> Fail<i64>.fail(42)
  }
}

test "aborting after DNS resolution leaves the native resolver reusable" {
  let aborted = handle with platform_dns() { dns_platform_abort_after_resolution() } {
    Fail<i64>.fail(code) -> code
  }
  Test.assert_eq(aborted, 42)
  Test.assert_eq(with platform_dns() { dns_platform_repeat_probe() }, 64)
}
