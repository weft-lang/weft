-- test/linked/par_queue.weft - pthread-protected task queue contract.

use stdlib/par.{*}

test "par_queue_push_pop_fifo" {
  let q = par_queue_new(3)
  Test.assert_eq(par_queue_push(q, 10), 1)
  Test.assert_eq(par_queue_push(q, 20), 1)
  Test.assert_eq(par_queue_push(q, 30), 1)
  Test.assert_eq(par_queue_push(q, 40), 0)
  Test.assert_eq(par_queue_pop(q), 10)
  Test.assert_eq(par_queue_pop(q), 20)
  Test.assert_eq(par_queue_pop(q), 30)
  Test.assert_eq(par_queue_pop(q), par_queue_empty_value())
  par_queue_destroy(q)
}

test "par_queue_wraps_after_pop" {
  let q = par_queue_new(3)
  par_queue_push(q, 1)
  par_queue_push(q, 2)
  par_queue_push(q, 3)
  Test.assert_eq(par_queue_pop(q), 1)
  Test.assert_eq(par_queue_push(q, 4), 1)
  Test.assert_eq(par_queue_pop(q), 2)
  Test.assert_eq(par_queue_pop(q), 3)
  Test.assert_eq(par_queue_pop(q), 4)
  Test.assert_eq(par_queue_pop(q), par_queue_empty_value())
  par_queue_destroy(q)
}

test "par_queue_zero_capacity_normalizes_to_one" {
  let q = par_queue_new(0)
  Test.assert_eq(par_queue_push(q, 7), 1)
  Test.assert_eq(par_queue_push(q, 8), 0)
  Test.assert_eq(par_queue_pop(q), 7)
  Test.assert_eq(par_queue_pop(q), par_queue_empty_value())
  par_queue_destroy(q)
}
