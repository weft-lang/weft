effect Stop { fn stop() -> never }

type Point { x: f64, y: f64 }
type Payload { value: i64 }

fn expired_after_replacement() -> weak Payload {
  let mut value = Payload { value: 7 }
  value = Payload { value: 9 }
  weak_ref(value)
}

fn main() -> i64 {
  let mut points = [Point { x: 1.5, y: 2.5 }]
  let before = handle {
    let point = points[0]
    points[0] = point.{x: { Stop.stop() 3.5 }}
    0
  } { Stop.stop() -> 42 }
  if before != 42 or points[0].x != 1.5 or points[0].y != 2.5 { return 1 } else { nil }
  let after = handle {
    let point = points[0]
    points[0] = point.{x: 3.5}
    Stop.stop()
    0
  } { Stop.stop() -> 42 }
  if after != 42 or points[0].x != 3.5 or points[0].y != 2.5 { return 2 } else { nil }
  let mut current = Payload { value: 7 }
  let result = handle {
    current = Payload { value: 9 }
    current = current
    Stop.stop()
    0
  } { Stop.stop() -> 42 }
  if result != 42 or current.value != 9 { return 3 } else { nil }
  match weak_load(expired_after_replacement()) {
    nil -> 0
    live: Payload -> 4
  }
}
