-- test/linked/par_runtime_contract.weft - pthread helper result/fallback contract.

use stdlib/par.{*}
use stdlib/list.{*}
use runtime/unsafe.{*}

fn prc_inc(x: i64) -> i64 { x + 1 }
fn prc_inc_unsafe(x: i64) -[Unsafe]> i64 { x + 1 }
fn prc_double(x: i64) -> i64 { x * 2 }
fn prc_add(acc: i64, x: i64) -> i64 { acc + x }

fn prc_items() -> List<i64> {
  Cons<i64>(3, Cons<i64>(4, Nil<i64>()))
}

test "par_pthread_spawn_result_success_and_await_result" {
  let got = match par_pthread_spawn_result(prc_inc, 41) {
    ParOk(h) -> {
      match par_pthread_await_result(h) {
        ParOk(v) -> v
        ParErr(e) -> e
      }
    }
    ParErr(e) -> e
  }
  Test.assert_eq(got, 42)
}

test "par_pthread_spawn_unsafe_result_success_and_await_result" {
  let got = match par_pthread_spawn_unsafe_result(prc_inc_unsafe, 41) {
    ParOk(h) -> {
      match par_pthread_await_result(h) {
        ParOk(v) -> v
        ParErr(e) -> e
      }
    }
    ParErr(e) -> e
  }
  Test.assert_eq(got, 42)
}

test "par_pthread_await_result_rejects_zero_handle" {
  let got = match par_pthread_await_result(0) {
    ParOk(v) -> v
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_invalid_handle())
}

test "par_pthread_observe_result_rejects_double_observation" {
  let got = match par_pthread_spawn_result(prc_inc, 10) {
    ParOk(h) -> {
      par_pthread_await(h)
      match par_pthread_await_result(h) {
        ParOk(v) -> v
        ParErr(e) -> e
      }
    }
    ParErr(e) -> e
  }
  Test.assert_eq(got, par_error_already_observed())
}

test "par_pthread_create_status_result_reports_failure" {
  let got = match par_pthread_create_status_result(35, 0) {
    ParOk(h) -> h
    ParErr(e) -> e
  }
  Test.assert_eq(got, 35)
}

test "par_pthread_pool_map_or_sequential_runtime_unavailable" {
  let mapped = par_pthread_pool_map_or_sequential(prc_items(), prc_double, 4, 0)
  Test.assert_eq(mapped.fold<i64>(0, prc_add), 14)
}
