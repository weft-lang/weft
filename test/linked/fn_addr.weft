-- test/linked/fn_addr.weft - fn_addr thunk B instruction decoding.

use "stdlib/thread.weft"

fn force_object_pipeline() -> i64 {
  __got_exit(0, 0, 0, 0, 0, 0)
}

fn thunk_insn(closure: (i64) -> i64) -> i64 {
  let thunk = __mem_load64(closure)
  let b0 = __mem_load8(thunk + 28)
  let b1 = __mem_load8(thunk + 29)
  let b2 = __mem_load8(thunk + 30)
  let b3 = __mem_load8(thunk + 31)
  b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn add_one(x: i64) -> i64 { x + 1 }
fn add_two(x: i64) -> i64 { x + 2 }

test "fn_addr_decodes_b_instruction" {
  let f = add_one
  let g = add_two
  let f_insn = thunk_insn(f)
  let g_insn = thunk_insn(g)
  let f_addr = fn_addr(f)
  let g_addr = fn_addr(g)

  Test.assert_eq(f_insn / 67108864, 5)
  Test.assert_eq(g_insn / 67108864, 5)
  Test.assert_eq(if f_addr > 16384 { 1 } else { 0 }, 1)
  Test.assert_eq(if g_addr > 16384 { 1 } else { 0 }, 1)
  Test.assert_eq(if f_addr != g_addr { 1 } else { 0 }, 1)
}
