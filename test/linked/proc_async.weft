-- test/linked/proc_async.weft -- async Proc handles and output capture

use compiler/lib.{*}
use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/safe_process.{runtime_platform_proc, runtime_platform_proc_with}
use runtime/time as platform_time
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/result.{Ok, Err}
use stdlib/string.{*}
use stdlib/time.{*}

fn proc_test_cstr(value: str) -> i64 {
  let result = alloc_zeroed(__str_len(value) + 1)
  mem_copy(result, __str_ptr(value), __str_len(value))
  result
}

fn proc_test_argv() -> i64 {
  let argv = alloc_zeroed(24)
  mem_store64_at(argv, 0, 0)
  mem_store64_at(argv, 8, proc_test_cstr("PATH=/usr/bin:/bin"))
  mem_store64_at(argv, 16, 0)
  argv
}

fn proc_test_platform(body: () -[Proc]> i64) -> i64 {
  runtime_platform_proc(0, proc_test_argv(), body)
}

fn proc_completed_exact(output: ProcOutput, expected_status: i64, expected_stdout: str, expected_stderr: str) -> bool {
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) ->
      status == expected_status and
      str_eq(stdout_text, expected_stdout) == 1 and
      str_eq(stderr_text, expected_stderr) == 1
    _ -> false
  }
}

fn proc_completed_lengths(output: ProcOutput, expected_status: i64, stdout_len: i64, stderr_len: i64) -> bool {
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) ->
      status == expected_status and __str_len(stdout_text) == stdout_len and __str_len(stderr_text) == stderr_len
    _ -> false
  }
}

fn proc_signal_status(output: ProcOutput) -> i64 {
  match output {
    ProcCompleted(ProcSignaled(signal), stdout_text, stderr_text) -> 128 + signal
    _ -> 0
  }
}

fn proc_args1(first: str) -> List<str> {
  Cons<str>(first, Nil<str>())
}

fn proc_args2(first: str, second: str) -> List<str> {
  Cons<str>(first, Cons<str>(second, Nil<str>()))
}

fn proc_capture_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/bin/sh",
    proc_args2("-c", "printf 'captured-out'; printf 'captured-err' >&2; exit 7")
  )
  let output = Proc.wait(resource)
  if proc_completed_exact(output, 7, "captured-out", "captured-err") { 1 } else { 0 }
}

test "proc_async_captures_stdout_stderr_and_exit_status" {
  Test.assert_eq(proc_test_platform(proc_capture_probe), 1)
}

fn proc_argument_probe() -[Proc]> i64 {
  let args = Cons<str>("-c",
    Cons<str>("printf '%s' \"$1\"",
      Cons<str>("weft-sh",
        Cons<str>("forty-two", Nil<str>()))))
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", args)
  let output = Proc.wait(resource)
  if proc_completed_exact(output, 0, "forty-two", "") { 1 } else { 0 }
}

test "proc_async_marshals_argument_vector" {
  Test.assert_eq(proc_test_platform(proc_argument_probe), 1)
}

fn proc_large_capture_probe() -[Proc]> i64 {
  let program = "BEGIN { for (i = 0; i < 70000; i++) printf \"x\" }"
  let resource: owned ProcHandle = Proc.spawn("/usr/bin/awk", proc_args1(program))
  let output = Proc.wait(resource)
  if proc_completed_lengths(output, 0, 70000, 0) { 1 } else { 0 }
}

test "proc_async_drains_output_larger_than_pipe_capacity" {
  Test.assert_eq(proc_test_platform(proc_large_capture_probe), 1)
}

fn proc_two_children_probe() -[Proc]> i64 {
  let first: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "sleep 0.05; printf first"))
  let second: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "printf second"))
  let second_output = Proc.wait(second)
  let first_output = Proc.wait(first)
  if proc_completed_exact(second_output, 0, "second", "") and
     proc_completed_exact(first_output, 0, "first", "") { 1 } else { 0 }
}

test "proc_async_supports_multiple_live_handles" {
  Test.assert_eq(proc_test_platform(proc_two_children_probe), 1)
}

fn proc_missing_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/weft-proc-definitely-missing-7c43f1",
    Nil<str>()
  )
  let output = Proc.wait(resource)
  match output {
    ProcFailed(ProcSpawnFailed(error), stdout_text, stderr_text) ->
      if error > 0 and __str_len(stdout_text) == 0 and __str_len(stderr_text) == 0 { 1 } else { 0 }
    _ -> 0
  }
}

test "proc_async_surfaces_spawn_failure_as_output_value" {
  Test.assert_eq(proc_test_platform(proc_missing_probe), 1)
}

fn proc_signal_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "kill -TERM $$"))
  proc_signal_status(Proc.wait(resource))
}

test "proc_async_reports_signal_status" {
  Test.assert_eq(proc_test_platform(proc_signal_probe), 143)
}

fn proc_timeout_probe(deadline_nanos: i64) -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/bin/sh",
    proc_args2("-c", "printf 'timeout-out'; printf 'timeout-err' >&2; while :; do :; done")
  )
  let output = Proc.wait_until(resource, deadline_nanos)
  match output {
    ProcTimedOut(ProcSignaled(signal), stdout_text, stderr_text) ->
      if signal == 9 and str_eq(stdout_text, "timeout-out") == 1 and str_eq(stderr_text, "timeout-err") == 1 { 1 } else { 0 }
    _ -> 0
  }
}

test "proc_async_deadline_kills_reaps_and_preserves_capture" {
  let start = with platform_time() { Time.now_nanos() }
  Test.assert_eq(proc_test_platform(() => proc_timeout_probe(start + 500000000)), 1)
}

fn proc_wait_until_completed_probe(deadline_nanos: i64) -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "printf done"))
  let output = Proc.wait_until(resource, deadline_nanos)
  if proc_completed_exact(output, 0, "done", "") { 1 } else { 0 }
}

test "proc_async_deadline_preserves_normal_completion" {
  let start = with platform_time() { Time.now_nanos() }
  Test.assert_eq(proc_test_platform(() => proc_wait_until_completed_probe(start + 2000000000)), 1)
}

test "proc_async_negative_deadline_means_unbounded_wait" {
  Test.assert_eq(proc_test_platform(() => proc_wait_until_completed_probe(0 - 1)), 1)
}

fn proc_drop_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "sleep 5"))
  42
}

test "proc_async_drop_kills_and_reaps_unwaited_child" {
  Test.assert_eq(proc_test_platform(proc_drop_probe), 42)
}

fn proc_mock_wait_probe() -[Proc]> i64 {
  let bridge_probe: owned ProcHandle = proc_handle_from_token(11)
  let bridge_pid = proc_handle_token(bridge_probe)
  Proc.release(bridge_probe)
  let resource: owned ProcHandle = Proc.spawn("mock-program", proc_args1("mock-arg"))
  let output = Proc.wait(resource)
  match output {
    ProcCompleted(ProcExited(status), stdout_text, stderr_text) ->
      bridge_pid + status + __str_len(stdout_text) + __str_len(stderr_text)
    _ -> 0
  }
}

fn proc_mock_handle(pid: i64, stdout_fd: i64, stderr_fd: i64) -> owned ProcHandle {
  proc_handle_from_token(pid)
}

fn proc_mock_consume_pid(resource: ProcHandle) -> i64 {
  proc_handle_release_token(resource)
}

test "proc_async_spawn_and_wait_remain_mockable" {
  let got = handle proc_mock_wait_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(77, 88, 99))
    Proc.wait(resource) -> resume(ProcCompleted(ProcExited(proc_mock_consume_pid(resource) - 70), "out", "err"))
    Proc.wait_until(resource, deadline_nanos) -> resume(ProcTimedOut(ProcSignaled(9), "", ""))
    Proc.run(path, args) -> resume(Err<ProcTermination, ProcError>(ProcSpawnFailed(2)))
    Proc.release(resource) -> resume(0)
  }
  Test.assert_eq(got, 24)
}

fn proc_mock_drop_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("mock-drop", Nil<str>())
  42
}

fn proc_mock_timeout_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("mock-timeout", Nil<str>())
  let output = Proc.wait_until(resource, 424242)
  match output {
    ProcTimedOut(ProcSignaled(signal), stdout_text, stderr_text) -> 128 + signal
    _ -> 0
  }
}

test "proc_async_deadline_operation_remains_mockable" {
  let deadlines = nlist_new()
  let got = handle proc_mock_timeout_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(71, 0 - 1, 0 - 1))
    Proc.wait(resource) -> resume(ProcCompleted(ProcExited(0), "", ""))
    Proc.wait_until(resource, deadline_nanos) -> {
      nlist_add(deadlines, deadline_nanos)
      resume(ProcTimedOut(ProcSignaled(9), "", ""))
    }
    Proc.run(path, args) -> resume(Err<ProcTermination, ProcError>(ProcSpawnFailed(2)))
    Proc.release(resource) -> resume(0)
  }
  Test.assert_eq(got, 137)
  Test.assert_eq(nlist_len(deadlines), 1)
  Test.assert_eq(nlist_get(deadlines, 0), 424242)
}

test "proc_async_owned_drop_routes_through_effect" {
  let log = nlist_new()
  let got = handle proc_mock_drop_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(63, 0 - 1, 0 - 1))
    Proc.wait(resource) -> resume(ProcCompleted(ProcExited(0), "", ""))
    Proc.wait_until(resource, deadline_nanos) -> resume(ProcCompleted(ProcExited(0), "", ""))
    Proc.run(path, args) -> resume(Err<ProcTermination, ProcError>(ProcSpawnFailed(2)))
    Proc.release(resource) -> {
      nlist_add(log, proc_mock_consume_pid(resource))
      resume(0)
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(nlist_len(log), 1)
  Test.assert_eq(nlist_get(log, 0), 63)
}

effect ProcProbe {
  fn inspect(value: i64) -> i64
}

fn proc_residual_probe() -[Proc, ProcProbe]> i64 {
  match Proc.run("/bin/sh", proc_args2("-c", "exit 2")) {
    Ok(ProcExited(status)) -> ProcProbe.inspect(status)
    _ -> 0
  }
}

test "proc_platform_handler_preserves_residual_effects" {
  let got = handle runtime_platform_proc_with(
    0,
    proc_test_argv(),
    proc_residual_probe
  ) {
    ProcProbe.inspect(value) -> resume(value + 40)
  }
  Test.assert_eq(got, 42)
}
