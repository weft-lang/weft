-- test/linked/proc_async.weft -- async Proc handles and output capture

use compiler/lib.{*}
use runtime/process.{*}
use stdlib/list.{*}
use stdlib/string.{*}

fn proc_args1(first: str) -> List<str> {
  list_cons<str>(first, list_nil<str>())
}

fn proc_args2(first: str, second: str) -> List<str> {
  list_cons<str>(first, list_cons<str>(second, list_nil<str>()))
}

fn proc_capture_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/bin/sh",
    proc_args2("-c", "printf 'captured-out'; printf 'captured-err' >&2; exit 7")
  )
  let output = Proc.wait(resource)
  if output.error == 0 and output.timed_out == false and output.status == 7 and
     str_eq(output.stdout_text, "captured-out") == 1 and
     str_eq(output.stderr_text, "captured-err") == 1 { 1 } else { 0 }
}

test "proc_async_captures_stdout_stderr_and_exit_status" {
  Test.assert_eq(runtime_platform_proc(proc_capture_probe), 1)
}

fn proc_argument_probe() -[Proc]> i64 {
  let args = list_cons<str>("-c",
    list_cons<str>("printf '%s' \"$1\"",
      list_cons<str>("weft-sh",
        list_cons<str>("forty-two", list_nil<str>()))))
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", args)
  let output = Proc.wait(resource)
  if output.error == 0 and output.timed_out == false and output.status == 0 and
     str_eq(output.stdout_text, "forty-two") == 1 and
     __str_len(output.stderr_text) == 0 { 1 } else { 0 }
}

test "proc_async_marshals_argument_vector" {
  Test.assert_eq(runtime_platform_proc(proc_argument_probe), 1)
}

fn proc_large_capture_probe() -[Proc]> i64 {
  let program = "BEGIN { for (i = 0; i < 70000; i++) printf \"x\" }"
  let resource: owned ProcHandle = Proc.spawn("/usr/bin/awk", proc_args1(program))
  let output = Proc.wait(resource)
  if output.error == 0 and output.timed_out == false and output.status == 0 and
     __str_len(output.stdout_text) == 70000 and
     __str_len(output.stderr_text) == 0 { 1 } else { 0 }
}

test "proc_async_drains_output_larger_than_pipe_capacity" {
  Test.assert_eq(runtime_platform_proc(proc_large_capture_probe), 1)
}

fn proc_two_children_probe() -[Proc]> i64 {
  let first: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "sleep 0.05; printf first"))
  let second: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "printf second"))
  let second_output = Proc.wait(second)
  let first_output = Proc.wait(first)
  if second_output.error == 0 and first_output.error == 0 and
     str_eq(second_output.stdout_text, "second") == 1 and
     str_eq(first_output.stdout_text, "first") == 1 { 1 } else { 0 }
}

test "proc_async_supports_multiple_live_handles" {
  Test.assert_eq(runtime_platform_proc(proc_two_children_probe), 1)
}

fn proc_missing_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/weft-4i-definitely-missing-7c43f1",
    list_nil<str>()
  )
  let output = Proc.wait(resource)
  if output.error > 0 and output.status == 0 - 1 and
     output.timed_out == false and
     __str_len(output.stdout_text) == 0 and
     __str_len(output.stderr_text) == 0 { 1 } else { 0 }
}

test "proc_async_surfaces_spawn_failure_as_output_value" {
  Test.assert_eq(runtime_platform_proc(proc_missing_probe), 1)
}

fn proc_signal_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "kill -TERM $$"))
  let output = Proc.wait(resource)
  if output.error == 0 { output.status } else { 0 }
}

test "proc_async_reports_signal_status" {
  Test.assert_eq(runtime_platform_proc(proc_signal_probe), 143)
}

fn proc_timeout_probe(deadline_nanos: i64) -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn(
    "/bin/sh",
    proc_args2("-c", "printf 'timeout-out'; printf 'timeout-err' >&2; while :; do :; done")
  )
  let output = Proc.wait_until(resource, deadline_nanos)
  if output.error == 0 and output.timed_out == true and output.status == 137 and
     str_eq(output.stdout_text, "timeout-out") == 1 and
     str_eq(output.stderr_text, "timeout-err") == 1 { 1 } else { 0 }
}

test "proc_async_deadline_kills_reaps_and_preserves_capture" {
  let start = runtime_platform_time(() => Time.now_nanos())
  Test.assert_eq(runtime_platform_proc(() => proc_timeout_probe(start + 500000000)), 1)
}

fn proc_wait_until_completed_probe(deadline_nanos: i64) -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "printf done"))
  let output = Proc.wait_until(resource, deadline_nanos)
  if output.error == 0 and output.timed_out == false and output.status == 0 and
     str_eq(output.stdout_text, "done") == 1 { 1 } else { 0 }
}

test "proc_async_deadline_preserves_normal_completion" {
  let start = runtime_platform_time(() => Time.now_nanos())
  Test.assert_eq(runtime_platform_proc(() => proc_wait_until_completed_probe(start + 2000000000)), 1)
}

test "proc_async_negative_deadline_means_unbounded_wait" {
  Test.assert_eq(runtime_platform_proc(() => proc_wait_until_completed_probe(0 - 1)), 1)
}

fn proc_drop_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("/bin/sh", proc_args2("-c", "sleep 5"))
  42
}

test "proc_async_drop_kills_and_reaps_unwaited_child" {
  Test.assert_eq(runtime_platform_proc(proc_drop_probe), 42)
}

fn proc_mock_wait_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("mock-program", proc_args1("mock-arg"))
  let output = Proc.wait(resource)
  proc_handle_pid(ProcHandle { pid: 11, stdout_fd: 12, stderr_fd: 13, spawn_error: 0 }) +
    output.status + __str_len(output.stdout_text) + __str_len(output.stderr_text) + output.error
}

fn proc_mock_handle(pid: i64, stdout_fd: i64, stderr_fd: i64) -> owned ProcHandle {
  ProcHandle { pid: pid, stdout_fd: stdout_fd, stderr_fd: stderr_fd, spawn_error: 0 }
}

test "proc_async_spawn_and_wait_remain_mockable" {
  let got = handle proc_mock_wait_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(77, 88, 99))
    Proc.wait(resource) -> resume(ProcOutput {
      status: proc_handle_pid(resource) - 70,
      stdout_text: "out",
      stderr_text: "err",
      error: 0,
      timed_out: false
    })
    Proc.wait_until(resource, deadline_nanos) -> resume(ProcOutput {
      status: 0 - 1,
      stdout_text: "",
      stderr_text: "",
      error: 0,
      timed_out: true
    })
    Proc.run(path, args) -> resume(0 - 1)
    Proc.release(resource) -> resume(0)
  }
  Test.assert_eq(got, 24)
}

fn proc_mock_drop_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("mock-drop", list_nil<str>())
  42
}

fn proc_mock_timeout_probe() -[Proc]> i64 {
  let resource: owned ProcHandle = Proc.spawn("mock-timeout", list_nil<str>())
  let output = Proc.wait_until(resource, 424242)
  if output.timed_out { output.status } else { 0 }
}

test "proc_async_deadline_operation_remains_mockable" {
  let deadlines = nlist_new()
  let got = handle proc_mock_timeout_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(71, 0 - 1, 0 - 1))
    Proc.wait(resource) -> resume(ProcOutput {
      status: 0,
      stdout_text: "",
      stderr_text: "",
      error: 0,
      timed_out: false
    })
    Proc.wait_until(resource, deadline_nanos) -> {
      nlist_add(deadlines, deadline_nanos)
      resume(ProcOutput {
        status: 137,
        stdout_text: "",
        stderr_text: "",
        error: 0,
        timed_out: true
      })
    }
    Proc.run(path, args) -> resume(0 - 1)
    Proc.release(resource) -> resume(0)
  }
  Test.assert_eq(got, 137)
  Test.assert_eq(nlist_len(deadlines), 1)
  Test.assert_eq(nlist_get(deadlines, 0), 424242)
}

test "proc_async_owned_drop_routes_through_effect" {
  let log = nlist_new()
  let got = handle proc_mock_drop_probe() {
    Proc.spawn(path, args) -> resume(proc_mock_handle(63, 0 - 1, 0 - 1))
    Proc.wait(resource) -> resume(ProcOutput {
      status: 0,
      stdout_text: "",
      stderr_text: "",
      error: 0,
      timed_out: false
    })
    Proc.wait_until(resource, deadline_nanos) -> resume(ProcOutput {
      status: 0,
      stdout_text: "",
      stderr_text: "",
      error: 0,
      timed_out: false
    })
    Proc.run(path, args) -> resume(0 - 1)
    Proc.release(resource) -> {
      nlist_add(log, proc_handle_pid(resource))
      resume(0)
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(nlist_len(log), 1)
  Test.assert_eq(nlist_get(log, 0), 63)
}
