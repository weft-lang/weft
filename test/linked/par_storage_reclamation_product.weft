use stdlib/result
use stdlib/par as par
use runtime/alloc_test.{runtime_alloc_mutex_storage_guard, runtime_alloc_cond_storage_guard, runtime_alloc_worker_growths_reclaimed, runtime_alloc_heap_retained_bytes}
use runtime/rc.{rc_default_heap}

fn cycle() -> i64 {
  let items = [1, 2, 3]
  par.with_pool(par.pool_config(2, 1).unwrap(), () => {
    let task = par.fork(() => 42)
    let mapped = par.map(items[..], value => value * 7)
    task.join() + mapped.fold(0, (sum, value) => sum + value)
  })
}

fn main() -> i64 {
  if runtime_alloc_mutex_storage_guard() != 42 { return 1 }
  if runtime_alloc_cond_storage_guard() != 42 { return 2 }
  for growths in 0..4 {
    if runtime_alloc_worker_growths_reclaimed(growths) != growths { return 3 }
  }
  let heap = rc_default_heap()
  for _ in 0..4 { if cycle() != 84 { return 4 } }
  let before = runtime_alloc_heap_retained_bytes(heap)
  let mut total = 0
  for _ in 0..32 { total = total + cycle() }
  let after = runtime_alloc_heap_retained_bytes(heap)
  if total == 2688 and before == after { 0 } else { 5 }
}
