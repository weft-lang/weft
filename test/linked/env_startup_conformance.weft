-- test/linked/env_startup_conformance.weft -- one Env contract across handlers
--
-- The product checks the shared Env contract through the fixed handler, then
-- starts itself with the contract's arguments and exactly its environment
-- entries. The child checks the same contract through the platform handler,
-- which reads the startup vector the operating system gave it. The entries
-- include forms only a raw environment can hold, so the platform's parsing
-- and the fixed handler's must agree on them too. The runner starts the
-- product without arguments; the child has arguments and a role entry, and
-- either one identifies it, so a startup that lost one fails the contract
-- rather than starting another child.

use runtime/env as env_handler
use runtime/process_environment as child_environment
use stdlib/env.{Env}
use stdlib/env/fixed as fixed_env
use stdlib/list.{Cons}
use stdlib/process.{Proc, ProcExited, ProcSignaled}
use stdlib/result.{Err, Ok}
use test/linked_support/env_conformance.{
  env_conformance_arguments,
  env_conformance_check,
  env_conformance_environment,
  env_conformance_is_child
}

fn parent(program: str) -> i64 {
  let fixed = with fixed_env(
    Cons(program, env_conformance_arguments()),
    env_conformance_environment()
  ) {
    env_conformance_check()
  }
  if fixed != 0 { return 100 + fixed }
  let child = with child_environment(env_conformance_environment()) {
    match Proc.run(program, env_conformance_arguments()) {
      Ok(ProcExited(status)) -> status
      Ok(ProcSignaled(signal)) -> 64 + signal
      Err(_) -> 99
    }
  }
  if child != 0 { 200 + child } else { 0 }
}

fn main() -> i64 {
  with env_handler() {
    if Env.arg_count() > 1 or env_conformance_is_child() { env_conformance_check() }
    else {
      match Env.arg(0) {
        nil -> 98
        program: str -> parent(program)
      }
    }
  }
}
