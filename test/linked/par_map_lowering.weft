use "runtime/memory.weft"
-- test/linked/par_map_lowering.weft - compiler-lowered scoped par_map.

use "stdlib/par.weft"
use "stdlib/vector.weft"

type PmlCell { value: i64 }

fn pml_triple(x: i64) -> i64 { x * 3 }

fn pml_items() -> List<i64> {
  list_cons<i64>(1, list_cons<i64>(2, list_cons<i64>(3, list_nil<i64>())))
}

fn pml_sum_list(xs: List<i64>) -> i64 {
  list_fold<i64, i64>(xs, 0, (acc: i64, x: i64) => acc + x)
}

test "par_with_sequential_i64_lowers_direct_par_map_literal_scope" {
  let total = par_with_sequential_i64(() => pml_sum_list(par_map(pml_items(), pml_triple)))
  Test.assert_eq(total, 18)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_literal_scope" {
  let total = par_with_pthread_pool_i64(3, 8, () => pml_sum_list(par_map(pml_items(), pml_triple)))
  Test.assert_eq(total, 18)
}

test "par_with_pthread_pool_i64_lowers_direct_captured_par_map_literal_scope" {
  let total = par_with_pthread_pool_i64(3, 8, () => {
    let bias = 10
    pml_sum_list(par_map(pml_items(), x => x + bias))
  })
  Test.assert_eq(total, 36)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_empty_work" {
  let total = par_with_pthread_pool_i64(3, 8, () => pml_sum_list(par_map(list_nil<i64>(), pml_triple)))
  Test.assert_eq(total, 0)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_singleton_work" {
  let total = par_with_pthread_pool_i64(8, 8, () => pml_sum_list(par_map(list_cons<i64>(14, list_nil<i64>()), pml_triple)))
  Test.assert_eq(total, 42)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_many_tiny_tasks" {
  let total = par_with_pthread_pool_i64(8, 32, () => pml_sum_list(par_map(list_range(1, 17), pml_triple)))
  Test.assert_eq(total, 408)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_captured_rc" {
  let p: rc i64 = rc_default_alloc(8, 8)
  mem_store64(p, 40)
  let total = par_with_pthread_pool_i64(3, 8, () => {
    pml_sum_list(par_map(list_cons<i64>(1, list_cons<i64>(2, list_nil<i64>())), x => mem_load64(p) + x))
  })
  Test.assert_eq(total, 83)
}

test "par_with_sequential_i64_reads_captured_immutable_slice" {
  let values = [40, 2]
  let view: [i64] = values[..]
  let total = par_with_sequential_i64(() => {
    pml_sum_list(par_map(list_cons<i64>(1, list_cons<i64>(2, list_nil<i64>())), x => view[0] + x))
  })
  Test.assert_eq(total, 83)
}

test "par_with_pthread_pool_i64_joins_before_body_local_slice_owner_drops" {
  let total = par_with_pthread_pool_i64(3, 8, () => {
    let values = [20, 22]
    let view: [i64] = values[..]
    pml_sum_list(par_map(list_cons<i64>(0, list_cons<i64>(1, list_nil<i64>())), x => if x == 0 { view[0] } else { view[1] }))
  })
  Test.assert_eq(total, 42)
}

test "par_with_pthread_pool_i64_reads_plain_record_slice" {
  let values = [PmlCell { value: 19 }, PmlCell { value: 23 }]
  let view: [PmlCell] = values[..]
  let total = par_with_pthread_pool_i64(2, 4, () => {
    pml_sum_list(par_map(list_cons<i64>(0, list_cons<i64>(1, list_nil<i64>())), x => if x == 0 { view[0].value } else { view[1].value }))
  })
  Test.assert_eq(total, 42)
}

test "par_with_pthread_pool_i64_empty_work_may_capture_empty_slice" {
  let values: [i64; 0] = []
  let view: [i64] = values[..]
  let total = par_with_pthread_pool_i64(2, 4, () => {
    pml_sum_list(par_map(list_nil<i64>(), x => view[0] + x))
  })
  Test.assert_eq(total, 0)
}

test "Vector_mutation_resumes_after_scoped_immutable_slice_join" {
  let values = vector_new<i64>()
  vector_push<i64>(values, 40)
  let view: [i64] = values[..]
  let total = par_with_pthread_pool_i64(2, 4, () => {
    pml_sum_list(par_map(list_cons<i64>(2, list_nil<i64>()), x => view[0] + x))
  })
  let grew = vector_push<i64>(values, total)
  Test.assert_eq(grew, 1)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 1), 42)
}
