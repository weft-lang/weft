-- test/linked/par_map_lowering.weft - compiler-lowered scoped par_map.

use "stdlib/par.weft"

fn pml_triple(x: i64) -> i64 { x * 3 }

fn pml_items() -> i64 {
  Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil)))
}

fn pml_sum_list(xs: i64) -> i64 {
  let mut total = 0
  let mut cur = xs
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      total = total + __mem_load64(cur + 8)
      cur = __mem_load64(cur + 16)
    }
  }
  total
}

test "par_with_sequential_i64_lowers_direct_par_map_literal_scope" {
  let mapped = par_with_sequential_i64(() => par_map(pml_items(), pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 18)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_literal_scope" {
  let mapped = par_with_pthread_pool_i64(3, 8, () => par_map(pml_items(), pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 18)
}

test "par_with_pthread_pool_i64_lowers_direct_captured_par_map_literal_scope" {
  let mapped = par_with_pthread_pool_i64(3, 8, () => {
    let bias = 10
    par_map(pml_items(), x => x + bias)
  })
  Test.assert_eq(pml_sum_list(mapped), 36)
}
