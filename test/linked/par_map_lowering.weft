-- test/linked/par_map_lowering.weft - compiler-lowered scoped par_map.

use "stdlib/par.weft"

fn pml_triple(x: i64) -> i64 { x * 3 }

fn pml_items() -> i64 {
  Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil)))
}

fn pml_sum_list(xs: i64) -> i64 {
  let mut total = 0
  let mut cur = xs
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      total = total + __mem_load64(cur + 8)
      cur = __mem_load64(cur + 16)
    }
  }
  total
}

test "par_with_sequential_i64_lowers_direct_par_map_literal_scope" {
  let mapped = par_with_sequential_i64(() => par_map<i64, i64>(pml_items(), pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 18)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_literal_scope" {
  let mapped = par_with_pthread_pool_i64(3, 8, () => par_map<i64, i64>(pml_items(), pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 18)
}

test "par_with_pthread_pool_i64_lowers_direct_captured_par_map_literal_scope" {
  let mapped = par_with_pthread_pool_i64(3, 8, () => {
    let bias = 10
    par_map<i64, i64>(pml_items(), x => x + bias)
  })
  Test.assert_eq(pml_sum_list(mapped), 36)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_empty_work" {
  let mapped = par_with_pthread_pool_i64(3, 8, () => par_map<i64, i64>(Nil, pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 0)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_singleton_work" {
  let mapped = par_with_pthread_pool_i64(8, 8, () => par_map<i64, i64>(Cons<i64>(14, Nil), pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 42)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_many_tiny_tasks" {
  let mapped = par_with_pthread_pool_i64(8, 32, () => par_map<i64, i64>(
    Cons<i64>(1,
    Cons<i64>(2,
    Cons<i64>(3,
    Cons<i64>(4,
    Cons<i64>(5,
    Cons<i64>(6,
    Cons<i64>(7,
    Cons<i64>(8,
    Cons<i64>(9,
    Cons<i64>(10,
    Cons<i64>(11,
    Cons<i64>(12,
    Cons<i64>(13,
    Cons<i64>(14,
    Cons<i64>(15,
    Cons<i64>(16, Nil)))))))))))))))),
    pml_triple))
  Test.assert_eq(pml_sum_list(mapped), 408)
}

test "par_with_pthread_pool_i64_lowers_direct_par_map_captured_rc" {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 40)
  let mapped = par_with_pthread_pool_i64(3, 8, () => {
    par_map<i64, i64>(Cons<i64>(1, Cons<i64>(2, Nil)), x => __mem_load64(p) + x)
  })
  Test.assert_eq(pml_sum_list(mapped), 83)
}
