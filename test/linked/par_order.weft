-- test/linked/par_order.weft - Par effect: spawn + await ordering.

use "stdlib/par.weft"
use "runtime/alloc.weft"

fn identity(x: i64) -> i64 { x }

fn ordered_test() -[Par]> i64 {
  let h1 = Par.spawn(identity, 10)
  let r1 = Par.await(h1)
  let h2 = Par.spawn(identity, 20)
  let r2 = Par.await(h2)
  let h3 = Par.spawn(identity, 12)
  let r3 = Par.await(h3)
  r1 + r2 + r3
}

test "par_spawn_await_ordering" {
  let result = handle ordered_test() {
    Par.spawn(f, arg) -> {
      let addr = fn_addr(f)
      let tid = alloc_bump(8)
      __got_pthread_create(tid, 0, addr, arg, 0, 0)
      let hnd = alloc_bump(8)
      __mem_store64(hnd, __mem_load64(tid))
      resume(hnd)
    }
    Par.await(h) -> {
      let retval = alloc_bump(8)
      __got_pthread_join(__mem_load64(h), retval, 0, 0, 0, 0)
      resume(__mem_load64(retval))
    }
  }
  Test.assert_eq(result, 42)
}
