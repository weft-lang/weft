-- test/linked/par_order.weft - Par effect: spawn + await ordering.

use "stdlib/par.weft"

fn identity(x: i64) -> i64 { x }

fn ordered_test() -[Par]> i64 {
  let h1 = Par.spawn(identity, 10)
  let r1 = Par.await(h1)
  let h2 = Par.spawn(identity, 20)
  let r2 = Par.await(h2)
  let h3 = Par.spawn(identity, 12)
  let r3 = Par.await(h3)
  r1 + r2 + r3
}

test "par_spawn_await_ordering" {
  let result = handle ordered_test() {
    Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
    Par.await(h) -> resume(par_pthread_await(h))
  }
  Test.assert_eq(result, 42)
}
