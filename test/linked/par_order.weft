-- test/linked/par_order.weft - Par effect: spawn + await ordering.

use "stdlib/par.weft"

fn identity(x: i64) -> i64 { x }

fn ordered_test() -[Par]> i64 {
  let h1 = par_spawn<i64>(() => identity(10))
  let r1 = par_await<i64>(h1)
  let h2 = par_spawn<i64>(() => identity(20))
  let r2 = par_await<i64>(h2)
  let h3 = par_spawn<i64>(() => identity(12))
  let r3 = par_await<i64>(h3)
  r1 + r2 + r3
}

test "par_spawn_await_ordering" {
  let result = par_with_pthread_pool_i64(2, 4, ordered_test)
  Test.assert_eq(result, 42)
}
