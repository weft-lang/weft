-- test/linked/par_order.weft - Par effect: fork + join ordering.

use stdlib/par as par
use stdlib/par.{*}

fn identity(x: i64) -> i64 { x }

fn ordered_test() -[Par]> i64 {
  let h1 = par.fork<i64>(() => identity(10))
  let r1 = par.join<i64>(h1)
  let h2 = par.fork<i64>(() => identity(20))
  let r2 = par.join<i64>(h2)
  let h3 = par.fork<i64>(() => identity(12))
  let r3 = par.join<i64>(h3)
  r1 + r2 + r3
}

test "par_fork_join_ordering" {
  let result = par.with_pool(2, 4, ordered_test)
  Test.assert_eq(result, 42)
}
