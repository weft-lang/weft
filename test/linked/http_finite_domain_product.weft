use stdlib/bytes as bytes
use stdlib/http as http
use stdlib/http.{Http11, HttpChunkHeadData, HttpContentLength, HttpGet, HttpLimits, HttpRequestHead, HttpRequestHeadReady}
use stdlib/http/client as client
use stdlib/http/client.{HttpRedirectSameOrigin, HttpRedirectStrictMethod}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestReady, HttpClientResponseReady}
use stdlib/http/json as http_json
use stdlib/http/json.{HttpJsonReaderReady, HttpJsonReady}
use stdlib/http/replay as replay
use stdlib/http/replay.{HttpReplayReadTimeoutAt, HttpReplayWriteTimeoutAt}
use stdlib/http/stream as stream
use stdlib/http/stream.{HttpBodyIO, HttpBodyFinished}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/option.{Option}
use stdlib/json.{Json}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url

fn full_limits() -> HttpLimits {
  http.limits(8192, 8192, 65536, 100, 18446744073709551615, 1024, 16384, 32).unwrap()
}

fn request() -> HttpRequestHead {
  http.request(HttpGet, http.parse_request_target("/value").unwrap(), Http11,
    http.headers().append(http.header(http.parse_field_name("Host").unwrap(), bytes.from_str("example.com")).unwrap()),
    full_limits()).unwrap()
}

fn exchange() -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(url.parse("https://example.com/value").unwrap(), request(), full_limits()) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(connection, HttpGet, full_limits()) {
        HttpClientResponseReady(head, body) -> match http_json.reader(body, 18446744073709551615) {
          HttpJsonReaderReady(reader) -> match reader.read() {
            HttpJsonReady(returned, document) -> {
              if document.value().as_i64().unwrap() != 42 { return 1 }
              match returned.close() { Ok(done) -> 0 Err(error) -> 2 }
            }
            _ -> 3
          }
          _ -> 4
        }
        _ -> 5
      }
      _ -> 6
    }
    _ -> 7
  }
}

fn main() -> i64 {
  let maximum: usize = 18446744073709551615
  let wire = bytes.from_str("GET / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 18446744073709551615\r\n\r\n").to_vector()
  match http.parse_request_head(wire[..], full_limits()) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> if count != maximum or consumed != wire.len() { return 8 }
    _ -> return 9
  }
  let chunk = bytes.from_str("FFFFFFFFFFFFFFFF\r\n").to_vector()
  match http.parse_chunk_head(chunk[..], full_limits()) {
    HttpChunkHeadData(count, consumed) -> if count != maximum or consumed != chunk.len() { return 10 }
    _ -> return 11
  }
  let policy = client.redirect_policy(maximum, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  for _ in 0..32 {
    let fixture = replay.fixture(
      bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\n42"),
      bytes.from_str("GET /value HTTP/1.1\r\nhost: example.com\r\n\r\n"),
      3, 4, HttpReplayReadTimeoutAt(maximum), HttpReplayWriteTimeoutAt(maximum)
    ).unwrap()
    if replay.with_client(fixture, exchange) != 0 { return 12 }
    let stats = fixture.stats()
    if stats.closes != 1 or stats.releases != 0 or stats.errors != 0 or stats.begins != 1 { return 13 }
  }
  0
}
