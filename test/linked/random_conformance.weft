-- Cross-target executable contract for deterministic pseudo-random values.

use stdlib/random as random
use stdlib/random.{ZeroBound}
use stdlib/result.{Err, Ok}

fn main() -> i64 {
  let state0 = random.from_seed(random.seed(0))
  let (state1, word1) = state0.next_u64()
  let (state2, word2) = state1.next_u64()
  if word1 != 16294208416658607535 or word2 != 7960286522194355700 {
    1
  } else {
    match random.bound(9223372036854775809) {
      Err(ZeroBound) -> 2
      Ok(bound) -> {
        let rejection_state = random.from_seed(random.seed(11400714819323198485))
        let (after, selected) = rejection_state.next_below(bound)
        let (_, following) = after.next_u64()
        if selected == 8686239339925766635 and following == 1961750202426094747 { 0 } else { 3 }
      }
    }
  }
}
