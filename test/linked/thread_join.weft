-- test/linked/thread_join.weft - target-semantic thread create/join via fn_addr.

use runtime/par_pthread.{*}

fn thread_worker(arg: i64) -> i64 { arg + 1 }

test "thread_create_join" {
  let spawned = runtime_par_pthread_spawn(thread_worker, 41)
  Test.assert_eq(runtime_par_pair_status(spawned), 0)
  if runtime_par_pair_status(spawned) == 0 {
    let joined = runtime_par_pthread_join_handle(runtime_par_pair_value(spawned))
    Test.assert_eq(runtime_par_pair_status(joined), 0)
    Test.assert_eq(runtime_par_pair_value(joined), 42)
  } else { 0 }
}
