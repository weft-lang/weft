use runtime/memory.{*}
-- test/linked/thread_join.weft - direct pthread create/join via fn_addr.

use stdlib/thread.{*}
use runtime/alloc.{*}

fn thread_worker(arg: i64) -> i64 { arg + 1 }

test "pthread_create_join" {
  let f = thread_worker
  let arena = arena_new(64)
  let tid = arena_alloc(arena, 8, 8)
  __got_pthread_create(tid, 0, fn_addr(f), 41, 0, 0)
  let retval = arena_alloc(arena, 8, 8)
  __got_pthread_join(mem_load64(tid), retval, 0, 0, 0, 0)
  Test.assert_eq(mem_load64(retval), 42)
  arena_free(arena)
}
