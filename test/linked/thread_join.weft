-- test/linked/thread_join.weft - direct pthread create/join via fn_addr.

use "stdlib/thread.weft"

fn thread_worker(arg: i64) -> i64 { arg + 1 }

test "pthread_create_join" {
  let f = thread_worker
  let tid = __bump_alloc(8)
  __got_pthread_create(tid, 0, fn_addr(f), 41, 0, 0)
  let retval = __bump_alloc(8)
  __got_pthread_join(__mem_load64(tid), retval, 0, 0, 0, 0)
  Test.assert_eq(__mem_load64(retval), 42)
}
