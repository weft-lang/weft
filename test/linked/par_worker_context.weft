-- test/linked/par_worker_context.weft - worker context and local-first task pop.

use "stdlib/par.weft"

fn pwc_pool_with_workers(workers: i64, count: i64) -> i64 {
  let pool = alloc_bump(par_pool_state_size())
  __mem_store64(pool + par_pool_workers_offset(), workers)
  __mem_store64(pool + par_pool_worker_count_offset(), count)
  pool
}

test "par_worker_context_fields" {
  let workers = alloc_bump(8)
  let pool = pwc_pool_with_workers(workers, 1)
  let local = par_deque_new(2)
  let shared = par_queue_new(2)
  let worker = par_worker_new(3, pool, local, shared, 5)
  Test.assert_eq(par_worker_id(worker), 3)
  Test.assert_eq(par_worker_local_queue(worker), local)
  Test.assert_eq(par_worker_shared_queue(worker), shared)
  Test.assert_eq(par_worker_count(worker), 5)
  par_deque_destroy(local)
  par_queue_destroy(shared)
}

test "par_worker_pop_task_prefers_local_then_shared" {
  let workers = alloc_bump(8)
  let pool = pwc_pool_with_workers(workers, 1)
  let local = par_deque_new(2)
  let shared = par_queue_new(2)
  let worker = par_worker_new(0, pool, local, shared, 1)
  __mem_store64(workers, worker)
  par_deque_push_bottom(local, 7)
  par_deque_push_bottom(local, 8)
  par_queue_push(shared, 11)
  Test.assert_eq(par_worker_pop_task_raw(worker), 8)
  Test.assert_eq(par_worker_pop_task_raw(worker), 7)
  Test.assert_eq(par_worker_pop_task_raw(worker), 11)
  Test.assert_eq(par_worker_pop_task_raw(worker), par_queue_empty_value())
  par_deque_destroy(local)
  par_queue_destroy(shared)
}

test "par_worker_pop_task_steals_from_peer_local_queue" {
  let workers = alloc_bump(16)
  let pool = pwc_pool_with_workers(workers, 2)
  let local0 = par_deque_new(2)
  let local1 = par_deque_new(2)
  let shared = par_queue_new(2)
  let worker0 = par_worker_new(0, pool, local0, shared, 2)
  let worker1 = par_worker_new(1, pool, local1, shared, 2)
  __mem_store64(workers, worker0)
  __mem_store64(workers + 8, worker1)
  par_deque_push_bottom(local1, 42)
  par_deque_push_bottom(local1, 43)
  Test.assert_eq(par_worker_pop_task_raw(worker0), 42)
  Test.assert_eq(par_worker_pop_task_raw(worker1), 43)
  Test.assert_eq(par_worker_pop_task_raw(worker0), par_queue_empty_value())
  par_deque_destroy(local0)
  par_deque_destroy(local1)
  par_queue_destroy(shared)
}

test "par_worker_pop_task_prefers_shared_before_steal" {
  let workers = alloc_bump(16)
  let pool = pwc_pool_with_workers(workers, 2)
  let local0 = par_deque_new(2)
  let local1 = par_deque_new(2)
  let shared = par_queue_new(2)
  let worker0 = par_worker_new(0, pool, local0, shared, 2)
  let worker1 = par_worker_new(1, pool, local1, shared, 2)
  __mem_store64(workers, worker0)
  __mem_store64(workers + 8, worker1)
  par_queue_push(shared, 5)
  par_deque_push_bottom(local1, 9)
  Test.assert_eq(par_worker_pop_task_raw(worker0), 5)
  Test.assert_eq(par_worker_pop_task_raw(worker0), 9)
  par_deque_destroy(local0)
  par_deque_destroy(local1)
  par_queue_destroy(shared)
}
