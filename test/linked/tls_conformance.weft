-- test/linked/tls_conformance.weft — target-neutral TLS protocol matrix

use stdlib/bytes.{Bytes, bytes_from_str, bytes_to_vector}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random.{SecureRandom, SecureRandomError, SecureRandomLimitExceeded}
use stdlib/time.{Time}
use stdlib/tls.{*}
use stdlib/url.{url_parse}
use stdlib/vector.{vector_get_in_bounds, vector_push, vector_with_capacity}
use stdlib/vector/handles.{Vector}
use test/linked_support/tls_fixtures.{tls_fixture_ca, tls_fixture_server_certificate, tls_fixture_server_private_key, tls_fixture_unknown_ca}

type TlsScenarioOutcome {
  TlsScenarioRoundTrip,
    TlsScenarioFailed(TlsError),
    TlsScenarioStalled,
    TlsScenarioTransferMismatch,
    TlsScenarioPlaintextMismatch,
    TlsScenarioCloseMismatch,
    TlsScenarioTimedOut
}

type TlsPumpOutcome {
  TlsPumped,
    TlsPumpFailed(TlsError),
    TlsPumpMismatch
}

fn tls_scratch(capacity: i64) -> Vector<u8> {
  let values = vector_with_capacity<u8>(capacity)
  for index in 0..capacity { vector_push<u8>(values, __i64_to_u8(0)) }
  values
}

fn tls_pump(
  source: borrow mut TlsSession,
  destination: borrow mut TlsSession
) -> TlsPumpOutcome {
  let buffer = tls_scratch(32768)
  match tls_drain(source, buffer[..]) {
    Err(error) -> TlsPumpFailed(error)
    Ok(count) -> {
      if count == __i64_to_usize(0) {
        TlsPumped
      } else {
        match tls_feed(destination, buffer[__i64_to_usize(0)..count]) {
          Err(error) -> TlsPumpFailed(error)
          Ok(accepted) -> if accepted == count { TlsPumped } else { TlsPumpMismatch }
        }
      }
    }
  }
}

fn tls_step_is_done(step: TlsStep) -> bool {
  match step {
    TlsDone -> true
    _ -> false
  }
}

fn tls_handshake_drive(
  client: borrow mut TlsSession,
  server: borrow mut TlsSession,
  remaining: i64
) -> TlsScenarioOutcome {
  if remaining <= 0 {
    TlsScenarioStalled
  } else {
    match tls_handshake(client) {
      Err(error) -> TlsScenarioFailed(error)
      Ok(client_step) -> match tls_handshake(server) {
        Err(error) -> TlsScenarioFailed(error)
        Ok(server_step) -> match tls_pump(client, server) {
          TlsPumpFailed(error) -> TlsScenarioFailed(error)
          TlsPumpMismatch -> TlsScenarioTransferMismatch
          TlsPumped -> match tls_pump(server, client) {
            TlsPumpFailed(error) -> TlsScenarioFailed(error)
            TlsPumpMismatch -> TlsScenarioTransferMismatch
            TlsPumped -> {
              if tls_step_is_done(client_step) and tls_step_is_done(server_step) {
                TlsScenarioRoundTrip
              } else {
                tls_handshake_drive(client, server, remaining - 1)
              }
            }
          }
        }
      }
    }
  }
}

fn tls_plaintext_is_hello(buffer: Vector<u8>, count: usize) -> bool {
  count == __i64_to_usize(5) and
    vector_get_in_bounds<u8>(buffer, 0) == __i64_to_u8(104) and
    vector_get_in_bounds<u8>(buffer, 1) == __i64_to_u8(101) and
    vector_get_in_bounds<u8>(buffer, 2) == __i64_to_u8(108) and
    vector_get_in_bounds<u8>(buffer, 3) == __i64_to_u8(108) and
    vector_get_in_bounds<u8>(buffer, 4) == __i64_to_u8(111)
}

fn tls_round_trip_after_handshake(
  client: borrow mut TlsSession,
  server: borrow mut TlsSession
) -> TlsScenarioOutcome {
  let plaintext = bytes_to_vector(bytes_from_str("hello"))
  match tls_write_start(client, plaintext[..]) {
    Err(error) -> TlsScenarioFailed(error)
    Ok(TlsWrote(count)) -> {
      if count != __i64_to_usize(5) {
        TlsScenarioPlaintextMismatch
      } else {
        match tls_pump(client, server) {
          TlsPumpFailed(error) -> TlsScenarioFailed(error)
          TlsPumpMismatch -> TlsScenarioTransferMismatch
          TlsPumped -> {
            let received = tls_scratch(32)
            match tls_read(server, received[..]) {
              Err(error) -> TlsScenarioFailed(error)
              Ok(TlsRead(read_count)) -> {
                if not tls_plaintext_is_hello(received, read_count) {
                  TlsScenarioPlaintextMismatch
                } else {
                  match tls_close_step(client) {
                    Err(error) -> TlsScenarioFailed(error)
                    Ok(client_close) -> match tls_pump(client, server) {
                      TlsPumpFailed(error) -> TlsScenarioFailed(error)
                      TlsPumpMismatch -> TlsScenarioTransferMismatch
                      TlsPumped -> {
                        let peer_buffer = tls_scratch(8)
                        match tls_read(server, peer_buffer[..]) {
                          Err(error) -> TlsScenarioFailed(error)
                          Ok(TlsPeerClosed) -> match tls_close_step(server) {
                            Err(error) -> TlsScenarioFailed(error)
                            Ok(server_close) -> match tls_pump(server, client) {
                              TlsPumpFailed(error) -> TlsScenarioFailed(error)
                              TlsPumpMismatch -> TlsScenarioTransferMismatch
                              TlsPumped -> match tls_read(client, peer_buffer[..]) {
                                Ok(TlsPeerClosed) -> TlsScenarioRoundTrip
                                Err(error) -> TlsScenarioFailed(error)
                                _ -> TlsScenarioCloseMismatch
                              }
                            }
                          }
                          _ -> TlsScenarioCloseMismatch
                        }
                      }
                    }
                  }
                }
              }
              _ -> TlsScenarioPlaintextMismatch
            }
          }
        }
      }
    }
    _ -> TlsScenarioPlaintextMismatch
  }
}

fn tls_drive_owned_pair(
  client: owned TlsSession,
  server: owned TlsSession
) -> TlsScenarioOutcome {
  let mut client_owner: owned TlsSession = client
  let mut server_owner: owned TlsSession = server
  match tls_handshake_drive(client_owner, server_owner, 64) {
    TlsScenarioRoundTrip -> tls_round_trip_after_handshake(client_owner, server_owner)
    outcome -> outcome
  }
}

fn tls_url_host(source: str) -> Result<UrlHost, TlsError> {
  match url_parse(source) {
    Err(error) -> Err<UrlHost, TlsError>(TlsIdentity)
    Ok(url) -> Ok<UrlHost, TlsError>(url.host())
  }
}

fn tls_run_pair_with_authority(
  url: str,
  trust_roots: Bytes
) -[SecureRandom, Time]> TlsScenarioOutcome {
  match tls_url_host(url) {
    Err(error) -> TlsScenarioFailed(error)
    Ok(host) -> match tls_client_open(host, trust_roots) {
      Err(error) -> TlsScenarioFailed(error)
      Ok(client) -> match tls_server_open(
        tls_fixture_server_certificate(),
        tls_fixture_server_private_key()
      ) {
        Err(error) -> TlsScenarioFailed(error)
        Ok(server) -> tls_drive_owned_pair(client, server)
      }
    }
  }
}

fn tls_run_truncated_with_authority() -[SecureRandom, Time]> TlsScenarioOutcome {
  match tls_url_host("https://localhost/") {
    Err(error) -> TlsScenarioFailed(error)
    Ok(host) -> match tls_client_open(host, tls_fixture_ca()) {
      Err(error) -> TlsScenarioFailed(error)
      Ok(client) -> {
        let mut client_owner: owned TlsSession = client
        match tls_feed_eof(client_owner) {
          Err(error) -> TlsScenarioFailed(error)
          Ok(done) -> match tls_handshake(client_owner) {
            Err(TlsTruncated) -> TlsScenarioRoundTrip
            Err(error) -> TlsScenarioFailed(error)
            Ok(first) -> {
              let encrypted = tls_scratch(32768)
              match tls_drain(client_owner, encrypted[..]) {
                Err(error) -> TlsScenarioFailed(error)
                Ok(count) -> match tls_handshake(client_owner) {
                  Err(TlsTruncated) -> TlsScenarioRoundTrip
                  Err(error) -> TlsScenarioFailed(error)
                  _ -> TlsScenarioStalled
                }
              }
            }
          }
        }
      }
    }
  }
}

fn tls_run_timeout_with_authority() -[SecureRandom, Time]> TlsScenarioOutcome {
  match tls_url_host("https://localhost/") {
    Err(error) -> TlsScenarioFailed(error)
    Ok(host) -> match tls_client_open(host, tls_fixture_ca()) {
      Err(error) -> TlsScenarioFailed(error)
      Ok(client) -> {
        let mut client_owner: owned TlsSession = client
        match tls_handshake(client_owner) {
          Err(error) -> TlsScenarioFailed(error)
          Ok(first) -> {
            let encrypted = tls_scratch(32768)
            match tls_drain(client_owner, encrypted[..]) {
              Err(error) -> TlsScenarioFailed(error)
              Ok(count) -> match tls_handshake(client_owner) {
                Ok(TlsNeedInput) -> TlsScenarioTimedOut
                Err(error) -> TlsScenarioFailed(error)
                _ -> TlsScenarioStalled
              }
            }
          }
        }
      }
    }
  }
}

fn tls_deterministic_seed(count: usize) -> Result<Bytes, SecureRandomError> {
  if count == __i64_to_usize(48) {
    Ok<Bytes, SecureRandomError>(
      bytes_from_str("0123456789abcdef0123456789abcdef0123456789abcdef")
    )
  } else {
    Err<Bytes, SecureRandomError>(SecureRandomLimitExceeded(count))
  }
}

fn tls_run_pair_with_random(url: str, roots: Bytes) -[Time]> TlsScenarioOutcome {
  handle tls_run_pair_with_authority(url, roots) {
    SecureRandom.bytes(count) -> resume(tls_deterministic_seed(count))
  }
}

fn tls_run_truncated_with_random() -[Time]> TlsScenarioOutcome {
  handle tls_run_truncated_with_authority() {
    SecureRandom.bytes(count) -> resume(tls_deterministic_seed(count))
  }
}

fn tls_run_timeout_with_random() -[Time]> TlsScenarioOutcome {
  handle tls_run_timeout_with_authority() {
    SecureRandom.bytes(count) -> resume(tls_deterministic_seed(count))
  }
}

fn tls_run_pair(url: str, roots: Bytes, now_millis: i64) -> TlsScenarioOutcome {
  handle tls_run_pair_with_random(url, roots) {
    Time.now_millis() -> resume(now_millis)
    Time.now_nanos() -> resume(0)
    Time.sleep_millis(ms) -> resume(0)
  }
}

fn tls_run_truncated() -> TlsScenarioOutcome {
  handle tls_run_truncated_with_random() {
    Time.now_millis() -> resume(1788134400000)
    Time.now_nanos() -> resume(0)
    Time.sleep_millis(ms) -> resume(0)
  }
}

fn tls_run_timeout() -> TlsScenarioOutcome {
  handle tls_run_timeout_with_random() {
    Time.now_millis() -> resume(1788134400000)
    Time.now_nanos() -> resume(0)
    Time.sleep_millis(ms) -> resume(0)
  }
}

fn main() -> i64 {
  let valid = match tls_run_pair(
    "https://localhost/",
    tls_fixture_ca(),
    1788134400000
  ) {
    TlsScenarioRoundTrip -> 1
    _ -> 0
  }
  let wrong_host = match tls_run_pair(
    "https://example.com/",
    tls_fixture_ca(),
    1788134400000
  ) {
    TlsScenarioFailed(TlsIdentity) -> 2
    _ -> 0
  }
  let unknown_ca = match tls_run_pair(
    "https://localhost/",
    tls_fixture_unknown_ca(),
    1788134400000
  ) {
    TlsScenarioFailed(TlsTrust) -> 4
    _ -> 0
  }
  let expired = match tls_run_pair(
    "https://localhost/",
    tls_fixture_ca(),
    4102444800000
  ) {
    TlsScenarioFailed(TlsCertificateExpired) -> 8
    _ -> 0
  }
  let future = match tls_run_pair(
    "https://localhost/",
    tls_fixture_ca(),
    0
  ) {
    TlsScenarioFailed(TlsCertificateNotYetValid) -> 16
    _ -> 0
  }
  let truncated = match tls_run_truncated() {
    TlsScenarioRoundTrip -> 32
    _ -> 0
  }
  let timeout = match tls_run_timeout() {
    TlsScenarioTimedOut -> 64
    _ -> 0
  }
  let passed = valid + wrong_host + unknown_ca + expired + future + truncated + timeout
  if passed == 127 {
    0
  } else {
    127 - passed
  }
}
