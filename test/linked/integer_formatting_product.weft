use stdlib/num as num
use stdlib/num.{*}
use stdlib/result.{Ok, Err}

fn main() -> i64 {
  let minimum: i64 = -9223372036854775808
  let maximum: i64 = 9223372036854775807
  if minimum.display() != "-9223372036854775808" { return 1 }
  if maximum.to_str() != "9223372036854775807" { return 2 }
  let unsigned: u64 = 18446744073709551615
  if unsigned.display() != "18446744073709551615" { return 3 }
  for value in [minimum, minimum + 1, -10, -1, 0, 1, 10, maximum] {
    match num.parse_i64(value.display()) {
      Ok(parsed) -> if parsed != value { return 4 } else { nil }
      Err(_) -> return 5
    }
  }
  0
}
