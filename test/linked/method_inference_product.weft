use stdlib/map as map
use stdlib/map.{Map}
use stdlib/list as list
use stdlib/list.{List}

fn main() -> i64 {
  let source = map.new<i64, bool>().insert(7, true).insert(11, false)
  let copied = source.fold(map.new<i64, bool>(),
    (result: Map<i64, bool>, key: i64, value: bool) => result.insert(key, value))
  let sum = list.range(1, 5).map((value: i64) => value * 2).fold(0, (acc: i64, value: i64) => acc + value)
  if copied.len() == 2 and copied.contains_key(7) and copied.contains_key(11) and sum == 20 { 0 } else { 1 }
}
