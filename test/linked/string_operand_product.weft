use stdlib/string.{*}

fn compare_choices(first: bool, second: bool) -> bool {
  (if first { 7.to_str() } else { 8.to_str() }) ==
  (if second { 7.to_str() } else { 8.to_str() })
}

fn rendered(value: i64) -> str { "value {value}, next {value + 1}" }

fn main() -> i64 {
  for _ in 0..200 {
    if not compare_choices(true, true) or not compare_choices(false, false) { return 1 }
    if compare_choices(true, false) or compare_choices(false, true) { return 2 }
    let values = [7.to_str(), 8.to_str()]
    if values[0] != "7" or "8" != values[1] or values[0] == values[1] { return 3 }
    if rendered(7) != "value 7, next 8" { return 4 }
    let value = 7
    if "{value}" != "7" { return 5 }
  }
  0
}
