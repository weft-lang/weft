-- test/linked/env_default_handler.weft -- parameterless platform defaults
--
-- The platform Env and Proc handlers take no parameters, so a module can
-- declare them as its zero-state defaults: every function the module owns
-- then reads the process startup and starts children without installing
-- either handler lexically.

use runtime/env as platform_env
use runtime/process as platform_process
use stdlib/env.{Env}
use stdlib/list.{Cons, Nil}
use stdlib/process.{Proc, ProcExited}
use stdlib/result.{Ok}

default handler platform_env()

default handler platform_process()

fn program() -[Env]> str? { Env.arg(0) }

fn child_status() -[Proc]> i64 {
  match Proc.run("/bin/sh", Cons("-c", Cons("exit 7", Nil<str>()))) {
    Ok(ProcExited(status)) -> status
    _ -> 0 - 1
  }
}

fn main() -> i64 {
  if Env.arg_count() < 1 { return 1 }
  match program() {
    nil -> return 2
    name: str -> if name.is_empty() { return 3 }
  }
  if child_status() != 7 { return 4 }
  0
}
