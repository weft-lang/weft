use stdlib/iter as iter
use stdlib/option.{Option, Some}
use stdlib/diagnostic/registry as registry
use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/string

type Entry { text: str }

type Host { value: Entry }

impl Host {
  fn project<U>(self, f: (Entry) -> U) -> U { f(self.value) }
}

fn chain<A, B, C>(second: (B) -> C, first: (A) -> B, value: A) -> C { second(first(value)) }

fn main() -> i64 {
  let host = Host { value: Entry { text: "standalone" } }
  if host.project(entry => entry.text) != "standalone" { return 1 }
  if Some(Entry { text: "optional" }).map(entry => entry.text).unwrap() != "optional" { return 2 }
  if registry.get(0).map(entry => entry.summary).unwrap() != "module import graph contains a cycle" { return 3 }
  if chain(entry => entry.text, text => Entry { text: text }, "dependent") != "dependent" { return 4 }
  let values = host.project(entry => {
    let mut values = vector.new<str>()
    values.push(entry.text)
    values
  })
  if values.len() != 1 or values.get(0).unwrap() != "standalone" { return 5 }
  if iter.position(values, value => value == "standalone").unwrap() != 0 { return 6 }
  0
}
