-- test/linked/par_runtime_helpers.weft - standard pthread-backed Par helpers.

use "stdlib/par.weft"

fn prh_inc(x: i64) -> i64 { x + 1 }
fn prh_double(x: i64) -> i64 { x * 2 }
fn prh_sum(acc: i64, x: i64) -> i64 { acc + x }

fn prh_many_items() -> i64 {
  Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Cons<i64>(4, Cons<i64>(5, Nil)))))
}

fn prh_empty_map() -[Par]> i64 {
  let mapped = par_map(Nil, prh_inc)
  list_fold<i64, i64>(mapped, 7, prh_sum)
}

fn prh_singleton_map() -[Par]> i64 {
  let mapped = par_map(Cons<i64>(41, Nil), prh_inc)
  list_fold<i64, i64>(mapped, 0, prh_sum)
}

fn prh_many_tiny_tasks() -[Par]> i64 {
  let mapped = par_map(prh_many_items(), prh_double)
  list_fold<i64, i64>(mapped, 0, prh_sum)
}

test "par_runtime_helper_empty_work" {
  let result = handle prh_empty_map() {
    Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
    Par.await(h) -> resume(par_pthread_await(h))
  }
  Test.assert_eq(result, 7)
}

test "par_runtime_helper_singleton_work" {
  let result = handle prh_singleton_map() {
    Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
    Par.await(h) -> resume(par_pthread_await(h))
  }
  Test.assert_eq(result, 42)
}

test "par_runtime_helper_many_tiny_tasks" {
  let result = handle prh_many_tiny_tasks() {
    Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
    Par.await(h) -> resume(par_pthread_await(h))
  }
  Test.assert_eq(result, 30)
}
