-- test/linked/par_runtime_helpers.weft - standard pthread-backed Par helpers.

use stdlib/par as par
use stdlib/par.{*}
use stdlib/vector.{*}

fn prh_inc(x: i64) -> i64 { x + 1 }
fn prh_double(x: i64) -> i64 { x * 2 }

fn prh_empty_map() -[Par]> i64 {
  let values: [i64; 0] = []
  let mapped = par.map<i64, i64>(values[..], prh_inc)
  vector_sum_i64(mapped, 7)
}

fn prh_singleton_map() -[Par]> i64 {
  let values = [41]
  let mapped = par.map<i64, i64>(values[..], prh_inc)
  vector_sum_i64(mapped, 0)
}

fn prh_many_tiny_tasks() -[Par]> i64 {
  let values = [1, 2, 3, 4, 5]
  let mapped = par.map<i64, i64>(values[..], prh_double)
  vector_sum_i64(mapped, 0)
}

test "par_runtime_helper_empty_work" {
  let result = par.with_sequential(prh_empty_map)
  Test.assert_eq(result, 7)
}

test "par_runtime_helper_singleton_work" {
  let result = par.with_pool(2, 4, prh_singleton_map)
  Test.assert_eq(result, 42)
}

test "par_runtime_helper_many_tiny_tasks" {
  let result = par.with_pool(3, 8, prh_many_tiny_tasks)
  Test.assert_eq(result, 30)
}
