-- test/linked/par_pool_captured_map.weft - pthread pool par_map with captured callback.

use "stdlib/par.weft"

fn ppcm_sum_list(xs: i64) -> i64 {
  let mut total = 0
  let mut cur = xs
  let mut done = 0
  while done == 0 {
    let tag = __mem_load64(cur)
    if tag == __mem_load64(Nil) {
      done = 1
    } else {
      total = total + __mem_load64(cur + 8)
      cur = __mem_load64(cur + 16)
    }
  }
  total
}

fn ppcm_captured_map_computation() -[Par]> i64 {
  let bias = 10
  ppcm_sum_list(par_map(Cons<i64>(1, Cons<i64>(2, Cons<i64>(3, Nil))), x => x + bias))
}

test "par_with_pthread_pool_i64_runs_captured_par_map_callback" {
  Test.assert_eq(par_with_pthread_pool_i64(3, 8, ppcm_captured_map_computation), 36)
}
