use stdlib/num as num
use stdlib/num.{*}

type Reading { code: u8, temperature: f32, delta: i16, serial: u64 }
type Point { x: f64, y: f64 }
effect Stop { fn stop() -> never }

fn exchange(values: [mut Reading]) -> Reading {
  let first = values[0]
  let second = values[1]
  values[0] = second
  values[1] = first
  first
}

fn retained_reading() -> Reading {
  let mut values = [
    Reading { code: 250, temperature: num.f32_from_bits(2143289349), delta: -300, serial: 18446744073709551615 },
    Reading { code: 9, temperature: 3.5, delta: 12, serial: 42 }
  ]
  exchange(values[..])
}

fn main() -> i64 {
  let reading = retained_reading()
  if reading.code != 250 or reading.temperature.to_bits() != 2143289349 or
    reading.delta != -300 or reading.serial != 18446744073709551615 { return 1 } else { nil }
  let reference = weak_ref(reading)
  match weak_load(reference) {
    nil -> return 2
    loaded: Reading -> if loaded.serial != reading.serial { return 3 } else { nil }
  }
  let mut points = [Point { x: 1.5, y: 2.5 }, Point { x: 3.5, y: 4.5 }]
  let original = points
  let first = points[0]
  let second = points[1]
  points[0] = second.{x: second.x + 1.0}
  points[1] = first.{y: first.y + 2.0}
  if original[0].x != 1.5 or original[1].y != 4.5 or
    points[0].x != 4.5 or points[1].y != 4.5 { return 4 } else { nil }
  let outcome = handle {
    let snapshot = points[0]
    points[0] = snapshot.{x: { Stop.stop() 9.5 }}
    0
  } { Stop.stop() -> 42 }
  if outcome != 42 or points[0].x != 4.5 or points[0].y != 4.5 { 5 } else { 0 }
}
