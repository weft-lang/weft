-- test/linked/par_spawn.weft - Par effect: single spawn + await.

use "stdlib/par.weft"

fn worker(arg: i64) -> i64 { arg + 10 }

fn computation() -[Par]> i64 {
  let h = Par.spawn(worker, 32)
  Par.await(h)
}

test "par_single_spawn_await" {
  let result = handle computation() {
    Par.spawn(f, arg) -> {
      let addr = fn_addr(f)
      let tid = __bump_alloc(8)
      __got_pthread_create(tid, 0, addr, arg, 0, 0)
      let hnd = __bump_alloc(8)
      __mem_store64(hnd, __mem_load64(tid))
      resume(hnd)
    }
    Par.await(h) -> {
      let retval = __bump_alloc(8)
      __got_pthread_join(__mem_load64(h), retval, 0, 0, 0, 0)
      resume(__mem_load64(retval))
    }
  }
  Test.assert_eq(result, 42)
}
