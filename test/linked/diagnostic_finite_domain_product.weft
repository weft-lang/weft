use stdlib/diagnostic as diagnostic
use stdlib/diagnostic.{*}

fn main() -> i64 {
  let diagnostic = diagnostic.uncoded(
    DiagnosticSeverityNote, DiagnosticClassTool, "finite source range",
    DiagnosticSourceRange(DiagnosticSourceNamed("🧶.weft"), 9223372036854775808, 18446744073709551615)
  )
  let location = diagnostic.primary()
  match location {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) -> {
      if name != "🧶.weft" or start != 9223372036854775808 or end != 18446744073709551615 { return 1 }
    }
    _ -> return 2
  }
  let mut related = DiagnosticRelatedLocationNil
  let mut edits = DiagnosticTextEditNil
  let mut fields = DiagnosticFieldNil
  for _ in 0..1000 {
    related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("source", location), related)
    edits = DiagnosticTextEditCons(DiagnosticTextEdit(location, "replacement"), edits)
    fields = DiagnosticFieldCons(DiagnosticFieldSuggestion(DiagnosticSuggestion("replace", DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditNil)), fields)
  }
  if related.len() != 1000 or edits.len() != 1000 or fields.len() != 1000 or fields.suggestion_count() != 1000 { return 3 }
  0
}
