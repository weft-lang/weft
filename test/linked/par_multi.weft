-- test/linked/par_multi.weft - Par effect: multiple parallel forks.

use stdlib/par as par
use stdlib/par.{*}

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn add_five(x: i64) -> i64 { x + 5 }

fn multi_fork() -[Par]> i64 {
  let a = par.fork<i64>(() => double(10))
  let b = par.fork<i64>(() => triple(10))
  let c = par.fork<i64>(() => add_five(10))
  let ra = par.join<i64>(a)
  let rb = par.join<i64>(b)
  let rc = par.join<i64>(c)
  ra + rb + rc
}

test "par_multiple_forks" {
  let result = par.with_pool(3, 8, multi_fork)
  Test.assert_eq(result, 65)
}
