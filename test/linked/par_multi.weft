-- test/linked/par_multi.weft - Par effect: multiple parallel spawns.

use "stdlib/par.weft"

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn add_five(x: i64) -> i64 { x + 5 }

fn multi_spawn() -[Par]> i64 {
  let a = par_spawn<i64>(() => double(10))
  let b = par_spawn<i64>(() => triple(10))
  let c = par_spawn<i64>(() => add_five(10))
  let ra = par_await<i64>(a)
  let rb = par_await<i64>(b)
  let rc = par_await<i64>(c)
  ra + rb + rc
}

test "par_multiple_spawns" {
  let result = par_with_pthread_pool_i64(3, 8, multi_spawn)
  Test.assert_eq(result, 65)
}
