-- test/linked/par_multi.weft - Par effect: multiple parallel spawns.

use "stdlib/par.weft"
use "runtime/alloc.weft"

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn add_five(x: i64) -> i64 { x + 5 }

fn multi_spawn() -[Par]> i64 {
  let a = Par.spawn(double, 10)
  let b = Par.spawn(triple, 10)
  let c = Par.spawn(add_five, 10)
  let ra = Par.await(a)
  let rb = Par.await(b)
  let rc = Par.await(c)
  ra + rb + rc
}

test "par_multiple_spawns" {
  let result = handle multi_spawn() {
    Par.spawn(f, arg) -> {
      let addr = fn_addr(f)
      let tid = alloc_bump(8)
      __got_pthread_create(tid, 0, addr, arg, 0, 0)
      let hnd = alloc_bump(8)
      __mem_store64(hnd, __mem_load64(tid))
      resume(hnd)
    }
    Par.await(h) -> {
      let retval = alloc_bump(8)
      __got_pthread_join(__mem_load64(h), retval, 0, 0, 0, 0)
      resume(__mem_load64(retval))
    }
  }
  Test.assert_eq(result, 65)
}
