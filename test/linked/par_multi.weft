-- test/linked/par_multi.weft - Par effect: multiple parallel spawns.

use "stdlib/par.weft"

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn add_five(x: i64) -> i64 { x + 5 }

fn multi_spawn() -[Par]> i64 {
  let a = Par.spawn(double, 10)
  let b = Par.spawn(triple, 10)
  let c = Par.spawn(add_five, 10)
  let ra = Par.await(a)
  let rb = Par.await(b)
  let rc = Par.await(c)
  ra + rb + rc
}

test "par_multiple_spawns" {
  let result = handle multi_spawn() {
    Par.spawn(f, arg) -> resume(par_pthread_spawn(f, arg))
    Par.await(h) -> resume(par_pthread_await(h))
  }
  Test.assert_eq(result, 65)
}
