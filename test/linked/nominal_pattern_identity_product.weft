use stdlib/list as list
use stdlib/option.{Option, Some, None}
use stdlib/string

type List<T> { Nil, Cons(T, List<T>) }

fn rest<T>(value: List<T>) -> List<T> { match value { Nil -> Nil<T>() Cons(_, tail) -> tail } }

fn first<T>(value: List<T>) -> Option<T> { match value { Nil -> None<T>() Cons(head, _) -> Some<T>(head) } }

fn main() -> i64 {
  let local = Cons<str>("head", Cons<str>("local".repeat(3), Nil<str>()))
  if first<str>(rest<str>(local)).unwrap() != "local".repeat(3) { return 1 }
  let shared = list.Cons<str>("head", list.Cons<str>("stdlib".repeat(3), list.Nil<str>()))
  if shared.len() != 2 { return 2 }
  if shared.rest().unwrap().first().unwrap() != "stdlib".repeat(3) { return 3 }
  0
}
