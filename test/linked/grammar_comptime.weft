use compiler/comptime_artifact.{ComptimeArtifactReadFailed}
use compiler/grammar_comptime.{*}
use compiler/grammar_registry.{*}
use runtime/dir_mutate as dir_mutate_handler
use runtime/file_write as file_write_handler
use stdlib/bytes as bytes
use stdlib/diagnostic/schema.{*}
use stdlib/dir as dir
use stdlib/file as file
use stdlib/grammar.{ParseResult, Parsed, Recovered, Rejected, Checked, CheckRejected}
use stdlib/list.{Cons, Nil}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/panic.{panic}
use stdlib/result.{Result, Ok, Err}
use stdlib/source.{Source}

fn grammar_comptime_path(text: str) -> Path {
  path.from_utf8(text).unwrap()
}

fn grammar_comptime_parse(module_id: i64, text: str) -> GrammarModuleSyntax {
  let source = Source { text: text, identity: DiagnosticSourceNamed("comptime-grammar") }
  let parsed = handle grammar_module_parse_syntax(module_id, source.all()) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
  match parsed {
    Parsed(syntax) -> syntax
    Recovered(syntax) -> syntax
    Rejected -> panic("expected valid embedded grammar fixture")
  }
}

fn grammar_comptime_check(text: str, schema: Path) -> Result<GrammarComptimeCheck, GrammarComptimeError> {
  let syntax = grammar_comptime_parse(grammar_module_mini_sql(), text)
  handle grammar_module_check_file_context(syntax, schema, 4096) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn grammar_comptime_write(schema: Path, content: str) -> bool {
  with file_write_handler() {
    match file.write_all(schema, bytes.from_str(content)) {
      Ok(count) -> count == content.len()
      Err(_) -> false
    }
  }
}

fn grammar_comptime_remove(schema: Path) -> nil {
  with dir_mutate_handler() {
    dir.remove(schema)
    nil
  }
}

test "grammar registry checks SQL with a compile-time schema value" {
  let schema = grammar_comptime_path("test/fixtures/comptime_sql_schema_v1.json")
  match grammar_comptime_check("select id, name from users", schema) {
    Err(_) -> Test.assert_true(false)
    Ok(checked) -> {
      Test.assert_true(match checked.result {
        Checked(GrammarComptimeSqlPlan(_)) -> true
        CheckRejected -> false
      })
      match checked.inputs {
        Cons(input, Nil) -> {
          Test.assert_true(input.path.eq(schema))
          Test.assert_eq_usize(input.size, 66)
          Test.assert_str_eq(input.content, "sha256:02155a1e74b7084163e7a7f32ba6418e480b4d192c9ea940ba2e113239cedb1a")
        }
        _ -> Test.assert_true(false)
      }
    }
  }
}

test "changed schema content invalidates the same registry check" {
  let schema = grammar_comptime_path("/tmp/weft_grammar_comptime_schema_6f84.json")
  let before = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"active\":\"bool\"}}}"
  let after = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"}}}"
  grammar_comptime_remove(schema)
  Test.assert_true(grammar_comptime_write(schema, before))
  let before_check = grammar_comptime_check("select active from users", schema)
  Test.assert_true(grammar_comptime_write(schema, after))
  let after_check = grammar_comptime_check("select active from users", schema)
  match (before_check, after_check) {
    (Ok(first), Ok(second)) -> {
      Test.assert_true(match first.result { Checked(GrammarComptimeSqlPlan(_)) -> true, CheckRejected -> false })
      Test.assert_true(match second.result { Checked(GrammarComptimeSqlPlan(_)) -> false, CheckRejected -> true })
      match (first.inputs, second.inputs) {
        (Cons(first_input, Nil), Cons(second_input, Nil)) -> {
          Test.assert_true(first_input.path.eq(second_input.path))
          Test.assert_true(first_input.content != second_input.content)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  grammar_comptime_remove(schema)
}

test "invalid SQL schema retains the observed compile-time input" {
  let schema = grammar_comptime_path("/tmp/weft_grammar_comptime_invalid_6f84.json")
  grammar_comptime_remove(schema)
  Test.assert_true(grammar_comptime_write(schema, "{}"))
  match grammar_comptime_check("select id from users", schema) {
    Err(GrammarComptimeSqlSchemaRejected(_, Cons(input, Nil))) -> {
      Test.assert_true(input.path.eq(schema))
      Test.assert_eq_usize(input.size, 2)
    }
    _ -> Test.assert_true(false)
  }
  grammar_comptime_remove(schema)
}

test "failed schema read remains a typed registry context error" {
  let missing = grammar_comptime_path("/tmp/weft_grammar_comptime_missing_6f84.json")
  grammar_comptime_remove(missing)
  match grammar_comptime_check("select id from users", missing) {
    Err(GrammarComptimeInputFailed(ComptimeArtifactReadFailed(actual, _))) -> Test.assert_true(actual.eq(missing))
    _ -> Test.assert_true(false)
  }
}

test "a grammar without file context support is rejected before reading" {
  let syntax = grammar_comptime_parse(grammar_module_einsum(), "ij,jk->ik")
  let missing = grammar_comptime_path("/tmp/weft_grammar_comptime_unused_6f84.json")
  match handle grammar_module_check_file_context(syntax, missing, 4096) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  } {
    Err(GrammarComptimeContextUnsupported) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}
