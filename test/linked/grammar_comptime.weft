-- Grammar checks against bounded compile-time context files, driven through
-- the grammar tool driver. The SQL and einsum exports interpret their own
-- context files inside their driver products; the compiler observes only
-- the outcome and the inputs the grammar read.

use compiler/backend/target.{native_link_target_host}
use compiler/grammar/tool.{*}
use runtime/alloc.{alloc_zeroed}
use runtime/dir_mutate as dir_mutate_handler
use runtime/file_write as file_write_handler
use runtime/memory.{mem_copy, mem_store64_at}
use runtime/process as process_handler
use runtime/source_acquire.{SourceAcquire, source_acquire_with_checkout}
use runtime/time as platform_time
use stdlib/bytes as bytes
use stdlib/dir as dir
use stdlib/file as file
use stdlib/grammar/tooling.{GrammarHostTypesContext}
use stdlib/grammar/tooling/conformance.{ParseOutcomeParsed}
use stdlib/grammar/tooling/protocol.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option, Some, None}
use stdlib/panic.{panic}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/process.{Proc}
use stdlib/result.{Result, Ok, Err}
use stdlib/string.{str_concat, str_eq}
use stdlib/time as time
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant}

fn context_cstr(value: str) -> i64 {
  let result = alloc_zeroed(__str_len(value) + 1)
  mem_copy(result, __str_ptr(value), __str_len(value))
  result
}

fn context_argv() -> i64 {
  let argv = alloc_zeroed(24)
  mem_store64_at(argv, 0, 0)
  mem_store64_at(argv, 8, context_cstr("PATH=/usr/bin:/bin"))
  mem_store64_at(argv, 16, 0)
  argv
}

fn with_platform<T>(body: () -[Proc, SourceAcquire, Test]> T) -[Test]> T {
  with process_handler(0, context_argv()) { source_acquire_with_checkout(".", body) }
}

fn deadline_in(millis: i64) -> Instant {
  platform_time.with_platform(() => monotonic.now()).add(time.milliseconds(millis))
}

fn context_path(text: str) -> Path { path.from_utf8(text).unwrap() }

--- The driver product for an exported grammar, built on first use and
--- reused afterwards through its stamp.
fn product_for(name: str) -[SourceAcquire]> (GrammarToolExport, str) {
  match grammar_tool_resolve(name) {
    GrammarToolResolved(export) -> match grammar_tool_ensure_product(
      export,
      native_link_target_host(),
      "test"
    ) {
      GrammarToolProductReady(product) -> (export, product)
      GrammarToolProductFailed(message) -> panic(str_concat("driver product: ", message))
    }
    _ -> panic(str_concat("unresolved grammar export: ", name))
  }
}

fn check_with(
  name: str,
  text: str,
  context: ToolContext
) -[Proc, SourceAcquire]> Option<ToolResponse> {
  let (export, product) = product_for(name)
  let request = ToolRequest {
    grammar: grammar_tool_identity(export),
    source_name: "embedded",
    source_text: text,
    context: context
  }
  match grammar_tool_exchange_without_host(product, request, deadline_in(30000)) {
    GrammarToolAnswered(response) -> Some<ToolResponse>(response)
    GrammarToolFailed(_) -> None<ToolResponse>()
  }
}

fn check_with_file(
  name: str,
  text: str,
  context: Path
) -[Proc, SourceAcquire]> Option<ToolResponse> {
  check_with(name, text, ToolFileContext(context, __i64_to_usize(4096)))
}

fn write_context(target: Path, content: str) -> bool {
  with file_write_handler() {
    match file.write_all(target, bytes.from_str(content)) {
      Ok(count) -> count == content.len()
      Err(_) -> false
    }
  }
}

fn remove_context(target: Path) -> nil {
  with dir_mutate_handler() {
    dir.remove(target)
    nil
  }
}

fn single_input(response: ToolResponse) -> Option<ToolObservedInput> {
  match response.observed_inputs {
    Cons(input, Nil) -> Some<ToolObservedInput>(input)
    _ -> None<ToolObservedInput>()
  }
}

fn observed_content(input: ToolObservedInput, size: usize, digest: str) -> bool {
  match input.outcome {
    ToolObservedContent(actual_size, actual_digest) ->
      actual_size == size and str_eq(actual_digest, digest) == 1
    ToolObservedFailure(_) -> false
  }
}

fn observed_digest(input: ToolObservedInput) -> str {
  match input.outcome {
    ToolObservedContent(_, digest) -> digest
    ToolObservedFailure(name) -> str_concat("failed:", name)
  }
}

fn checked(response: ToolResponse) -> bool {
  match response.check { ToolChecked -> true, _ -> false }
}

fn rejected(response: ToolResponse) -> bool {
  match response.check { ToolCheckRejected -> true, _ -> false }
}

fn context_unavailable(response: ToolResponse) -> bool {
  match response.check { ToolContextUnavailable -> true, _ -> false }
}

test "the SQL export checks a query against a compile-time schema file" {
  with_platform<nil>(
    () => {
      let schema = context_path("test/fixtures/comptime_sql_schema_v1.json")
      match check_with_file("sql", "select id, name from users", schema) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(match response.parse { ParseOutcomeParsed -> true, _ -> false })
          Test.assert_true(checked(response))
          Test.assert_eq_usize(response.diagnostics.len(), __i64_to_usize(0))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(schema))
              Test.assert_eq_usize(input.limit, __i64_to_usize(4096))
              Test.assert_true(
                observed_content(
                  input,
                  __i64_to_usize(66),
                  "sha256:02155a1e74b7084163e7a7f32ba6418e480b4d192c9ea940ba2e113239cedb1a"
                )
              )
            }
          }
        }
      }
      nil
    }
  )
}

test "changed schema content invalidates the same check" {
  with_platform<nil>(
    () => {
      let schema = context_path("/tmp/weft_grammar_comptime_schema_6f84.json")
      let before = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"active\":\"bool\"}}}"
      let after = "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\"}}}"
      remove_context(schema)
      Test.assert_true(write_context(schema, before))
      let first = check_with_file("sql", "select active from users", schema)
      Test.assert_true(write_context(schema, after))
      let second = check_with_file("sql", "select active from users", schema)
      match (first, second) {
        (Some(first_response), Some(second_response)) -> {
          Test.assert_true(checked(first_response))
          Test.assert_true(rejected(second_response))
          Test.assert_eq_usize(second_response.diagnostics.len(), __i64_to_usize(1))
          match (single_input(first_response), single_input(second_response)) {
            (Some(first_input), Some(second_input)) -> {
              Test.assert_true(first_input.path.eq(second_input.path))
              Test.assert_true(
                str_eq(observed_digest(first_input), observed_digest(second_input)) == 0
              )
            }
            _ -> Test.assert_true(false)
          }
        }
        _ -> Test.assert_true(false)
      }
      remove_context(schema)
      nil
    }
  )
}

test "an invalid SQL schema is reported with its observed input retained" {
  with_platform<nil>(
    () => {
      let schema = context_path("/tmp/weft_grammar_comptime_invalid_6f84.json")
      remove_context(schema)
      Test.assert_true(write_context(schema, "{}"))
      match check_with_file("sql", "select id from users", schema) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(context_unavailable(response))
          Test.assert_eq_usize(response.diagnostics.len(), __i64_to_usize(1))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(schema))
              Test.assert_true(
                match input.outcome {
                  ToolObservedContent(size, _) -> size == __i64_to_usize(2)
                  ToolObservedFailure(_) -> false
                }
              )
            }
          }
        }
      }
      remove_context(schema)
      nil
    }
  )
}

test "a missing SQL schema is a failed observed input" {
  with_platform<nil>(
    () => {
      let missing = context_path("/tmp/weft_grammar_comptime_missing_6f84.json")
      remove_context(missing)
      match check_with_file("sql", "select id from users", missing) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(context_unavailable(response))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(missing))
              Test.assert_true(
                match input.outcome {
                  ToolObservedFailure(name) -> str_eq(name, "not_found") == 1
                  ToolObservedContent(_, _) -> false
                }
              )
            }
          }
        }
      }
      nil
    }
  )
}

test "the einsum export checks operand shapes from a context file" {
  with_platform<nil>(
    () => {
      let context = context_path("test/fixtures/comptime_einsum_context_v1.json")
      match check_with_file("einsum", "ij,jk->ik", context) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(checked(response))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(context))
              Test.assert_true(
                observed_content(
                  input,
                  __i64_to_usize(63),
                  "sha256:68c37c7276391ae22886f7d9c952c276338a7d60ebedeec5ff712cdd88c56f5a"
                )
              )
            }
          }
        }
      }
      nil
    }
  )
}

test "an invalid einsum context retains its observed input" {
  with_platform<nil>(
    () => {
      let context = context_path("/tmp/weft_grammar_comptime_invalid_einsum_6f84.json")
      remove_context(context)
      Test.assert_true(write_context(context, "{}"))
      match check_with_file("einsum", "ij,jk->ik", context) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(context_unavailable(response))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(context))
              Test.assert_true(
                match input.outcome {
                  ToolObservedContent(size, _) -> size == __i64_to_usize(2)
                  ToolObservedFailure(_) -> false
                }
              )
            }
          }
        }
      }
      remove_context(context)
      nil
    }
  )
}

test "a checked einsum rejection retains its valid context" {
  with_platform<nil>(
    () => {
      let context = context_path("/tmp/weft_grammar_comptime_mismatch_einsum_6f84.json")
      let source = "{\"context_version\":1,\"element\":\"f64\",\"operands\":[[2,3],[5,4]]}"
      remove_context(context)
      Test.assert_true(write_context(context, source))
      match check_with_file("einsum", "ij,jk->ik", context) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(rejected(response))
          match single_input(response) {
            None -> Test.assert_true(false)
            Some(input) -> {
              Test.assert_true(input.path.eq(context))
              Test.assert_true(
                match input.outcome {
                  ToolObservedContent(size, _) -> size == source.len()
                  ToolObservedFailure(_) -> false
                }
              )
            }
          }
        }
      }
      remove_context(context)
      nil
    }
  )
}

test "the einsum export declines host types structurally" {
  with_platform<nil>(
    () => {
      match check_with("einsum", "ij,jk->ik", ToolHostContext) {
        None -> Test.assert_true(false)
        Some(response) -> {
          Test.assert_true(
            match response.check {
              ToolCheckUnsupported(GrammarHostTypesContext) -> true
              _ -> false
            }
          )
          Test.assert_true(match response.observed_inputs { Nil -> true, _ -> false })
        }
      }
      nil
    }
  )
}

test "the retired registry name resolves to the SQL export through manifest data" {
  with_platform<nil>(
    () => {
      match (grammar_tool_resolve("mini_sql"), grammar_tool_resolve("sql")) {
        (GrammarToolResolved(alias), GrammarToolResolved(canonical)) -> {
          Test.assert_true(str_eq(alias.module, canonical.module) == 1)
          Test.assert_true(str_eq(alias.declaration, canonical.declaration) == 1)
          Test.assert_true(str_eq(alias.export, "mini_sql") == 1)
        }
        _ -> Test.assert_true(false)
      }
      nil
    }
  )
}
