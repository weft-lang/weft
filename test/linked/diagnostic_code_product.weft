use stdlib/diagnostic.{*}
use stdlib/eq.{Eq}
use stdlib/string

fn equal<T: Eq>(left: T, right: T) -> bool { left.eq(right) }

fn main() -> i64 {
  let empty = DiagnosticCodeAssigned("")
  if equal(empty, DiagnosticCodeUnassigned) { return 1 }
  if not equal(empty, DiagnosticCodeAssigned("")) { return 2 }
  let code = DiagnosticCodeAssigned("E".concat("1002"))
  if not equal(code, DiagnosticCodeAssigned("E1002")) { return 3 }
  match code {
    DiagnosticCodeAssigned(text) -> if text != "E1002" { return 4 }
    DiagnosticCodeUnassigned -> return 5
  }
  let transported = handle Diagnose.report(Diagnostic(
    DiagnosticSeverityNote, DiagnosticClassTest, empty, "empty code",
    DiagnosticLocationNone, DiagnosticRelatedLocationNil, DiagnosticFieldNil
  )) {
    Diagnose.report(value) -> resume(if value.code().eq(empty) { 42 } else { 0 })
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if transported == 42 { 0 } else { 6 }
}
