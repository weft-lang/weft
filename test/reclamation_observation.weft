use stdlib/drop.{Drop}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read, defer_order_log_write}

type ObservationToken { log: i64, digit: i64 }
impl Drop for ObservationToken {
  fn drop(self) -> nil {
    defer_order_log_write(self.log, defer_order_log_read(self.log) * 10 + self.digit)
    nil
  }
}

fn observation_new(log: i64, digit: i64) -> owned ObservationToken {
  ObservationToken { log: log, digit: digit }
}
fn observation_direct(log: i64) -> nil { let token = observation_new(log, 1); nil }
fn observation_explicit(log: i64) -> nil { let token: owned ObservationToken = observation_new(log, 2); nil }
fn observation_discard(log: i64) -> nil { observation_new(log, 3); nil }
fn observation_inner(log: i64) -> nil { observation_direct(log) }
fn observation_outer(log: i64) -> nil { observation_inner(log) }
fn observation_generic<T>(log: i64, value: T) -> T { let token = observation_new(log, 4); value }
fn observation_generic_wrapper(log: i64) -> nil { observation_generic<i64>(log, 42); nil }
fn observation_invoke<E>(log: i64, action: (i64) -[E]> nil) -[E]> nil { action(log) }
fn observation_callback(log: i64) -> nil { observation_invoke(log, observation_direct) }
fn observation_constant(log: i64) -> i64 { let token = observation_new(log, 5); 42 }
fn observation_choose(log: i64, first: bool) -> owned ObservationToken {
  if first { observation_new(log, 6) } else { observation_new(log, 7) }
}
fn observation_branch(log: i64, first: bool) -> nil { let token = observation_choose(log, first); nil }
fn observation_conditional_discard(log: i64, first: bool) -> nil { if first { observation_choose(log, first) } }
fn observation_legacy(log: i64) -> nil { let token = owned_abort_token_new(log, 8); nil }

test "unused scalar calls retain their inferred and explicit local resource drops" {
  let log = defer_order_log_new()
  observation_direct(log)
  observation_explicit(log)
  Test.assert_eq(defer_order_log_read(log), 12)
}

test "discarding an owned temporary remains observable through a nil wrapper" {
  let log = defer_order_log_new()
  observation_discard(log)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "resource cleanup propagates through transitive scalar call wrappers" {
  let log = defer_order_log_new()
  observation_outer(log)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "generic local cleanup survives specialization and an unused result" {
  let log = defer_order_log_new()
  observation_generic_wrapper(log)
  Test.assert_eq(defer_order_log_read(log), 4)
}

test "callback identity specialization preserves local resource cleanup" {
  let log = defer_order_log_new()
  observation_callback(log)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "equal scalar calls cannot be commoned across their local drops" {
  let log = defer_order_log_new()
  Test.assert_eq(observation_constant(log) + observation_constant(log), 84)
  Test.assert_eq(defer_order_log_read(log), 55)
}

test "conditional owned results retain exactly one selected drop" {
  let log = defer_order_log_new()
  observation_branch(log, true)
  observation_branch(log, false)
  Test.assert_eq(defer_order_log_read(log), 67)
}

test "conditional statement wrappers preserve selected cleanup and skip the other path" {
  let log = defer_order_log_new()
  observation_conditional_discard(log, false)
  Test.assert_eq(defer_order_log_read(log), 0)
  observation_conditional_discard(log, true)
  Test.assert_eq(defer_order_log_read(log), 6)
}

test "cleanup summaries also preserve existing runtime resource adapters" {
  let log = defer_order_log_new()
  observation_legacy(log)
  Test.assert_eq(defer_order_log_read(log), 8)
}
