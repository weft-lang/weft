-- test/typed_ir_trap_metrics.weft -- focused typed-IR trap invariants

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn typed_ir_trap_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn typed_ir_trap_metric_lowering_failures(src: str) -> i64 {
  pipeline_native_typed_lowering_failure_count(typed_ir_trap_metric_native(src))
}

test "typed_ir_trap_metric_simple_function_has_no_lowering_failure_stub" {
  let src = "fn main() -> i64 { 42 }"
  Test.assert_eq(typed_ir_trap_metric_lowering_failures(src), 0)
}

test "typed_ir_trap_metric_pointer_cfg_has_no_lowering_failure_stub" {
  let src = "fn main() -[Unsafe]> i64 { let x = 5 let p = &x let q = &x if p == q { p.* } else { 0 } }"
  Test.assert_eq(typed_ir_trap_metric_lowering_failures(src), 0)
}

test "typed_ir_trap_metric_while_has_no_lowering_failure_stub" {
  let src = "fn main() -> i64 { let mut i = 0 while i < 3 { i = i + 1 } i }"
  Test.assert_eq(typed_ir_trap_metric_lowering_failures(src), 0)
}

test "typed_ir_trap_metric_match_has_no_lowering_failure_stub" {
  let src = "type Opt { None, Some(i64) } fn main() -> i64 { let x = Some(42) match x { Some(v) -> v None -> 0 } }"
  Test.assert_eq(typed_ir_trap_metric_lowering_failures(src), 0)
}

test "typed_ir_trap_metric_cross_function_effect_handler_has_no_lowering_failure_stub" {
  let src = "effect Test { fn assert_eq(got: i64, expected: i64) -> i64 } fn t_0() -[Test]> i64 { Test.assert_eq(1, 1) } fn main() -> i64 { handle t_0() { Test.assert_eq(g, e) -> resume(0) } }"
  Test.assert_eq(typed_ir_trap_metric_lowering_failures(src), 0)
}
