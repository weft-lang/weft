use stdlib/ord.{*}

type OrdRank {
  OrdRank(i64)
}

type OrdBox<T> {
  OrdBox(T)
}

fn ord_rank_value(rank: OrdRank) -> i64 {
  match rank {
    OrdRank(value) -> value
  }
}

impl Ord for OrdRank {
  fn compare(self: Self, other: Self) -> i64 {
    ord_compare<i64>(ord_rank_value(self), ord_rank_value(other))
  }
}

impl<T: Ord> Ord for OrdBox<T> {
  fn compare(self: Self, other: Self) -> i64 {
    match self {
      OrdBox(left) -> match other {
        OrdBox(right) -> left.compare(right)
      }
    }
  }
}

trait OrdWitness { }

impl OrdWitness for OrdRank { }

fn ord_generic_relations<T: Ord>(low: T, high: T) -> i64 {
  if low < high and low <= high and high > low and high >= low { 1 } else { 0 }
}

fn ord_generic_multibound_relations<T: OrdWitness & Ord>(low: T, high: T) -> i64 {
  if low < high and high > low { 1 } else { 0 }
}

test "ord_numeric_implementations_cover_every_primitive" {
  Test.assert_eq(ord_compare<i8>(1, 2), 0 - 1)
  Test.assert_eq(ord_compare<i16>(2, 1), 1)
  Test.assert_eq(ord_compare<i32>(3, 3), 0)
  Test.assert_eq(ord_compare<i64>(0 - 4, 0 - 3), 0 - 1)
  Test.assert_eq(ord_compare<isize>(5, 4), 1)
  Test.assert_eq(ord_compare<u8>(1, 2), 0 - 1)
  Test.assert_eq(ord_compare<u16>(2, 1), 1)
  Test.assert_eq(ord_compare<u32>(3, 3), 0)
  Test.assert_eq(ord_compare<u64>(4, 5), 0 - 1)
  Test.assert_eq(ord_compare<usize>(6, 5), 1)
  Test.assert_eq(ord_compare<f32>(1.25, 1.5), 0 - 1)
  Test.assert_eq(ord_compare<f64>(2.5, 2.5), 0)
}

test "ord_float_nan_is_a_stable_final_equivalence_class" {
  let nan64: f64 = 0.0 / 0.0
  let nan32: f32 = 0.0 / 0.0
  Test.assert_eq(ord_compare<f64>(nan64, 1.0), 1)
  Test.assert_eq(ord_compare<f64>(1.0, nan64), 0 - 1)
  Test.assert_eq(ord_compare<f64>(nan64, nan64), 0)
  Test.assert_eq(ord_compare<f32>(nan32, 1.0), 1)
  Test.assert_eq(ord_compare<f32>(1.0, nan32), 0 - 1)
  Test.assert_eq(ord_compare<f32>(nan32, nan32), 0)
}

test "ord_str_compare_handles_empty_prefix_unicode_and_equality" {
  Test.assert_eq(ord_compare<str>("", "a"), 0 - 1)
  Test.assert_eq(ord_compare<str>("alpha", "alphabet"), 0 - 1)
  Test.assert_eq(ord_compare<str>("beta", "alpha"), 1)
  Test.assert_eq(ord_compare<str>("same", "same"), 0)
  Test.assert_eq(ord_compare<str>("z", "Ω"), 0 - 1)
}

test "ord_relational_operators_dispatch_for_str" {
  let alpha: str = "alpha"
  let beta: str = "beta"
  Test.assert_eq(alpha < beta, 1)
  Test.assert_eq(alpha <= beta, 1)
  Test.assert_eq(beta > alpha, 1)
  Test.assert_eq(beta >= alpha, 1)
  Test.assert_eq(alpha >= beta, 0)
}

test "ord_relational_operators_dispatch_for_user_type" {
  let low = OrdRank(2)
  let high = OrdRank(7)
  Test.assert_eq(low < high, 1)
  Test.assert_eq(low <= high, 1)
  Test.assert_eq(high > low, 1)
  Test.assert_eq(high >= low, 1)
  Test.assert_eq(low > high, 0)
}

test "ord_relational_operators_dispatch_through_generic_bounds" {
  Test.assert_eq(ord_generic_relations<str>("alpha", "beta"), 1)
  Test.assert_eq(ord_generic_relations<i64>(2, 7), 1)
  Test.assert_eq(ord_generic_multibound_relations<OrdRank>(OrdRank(2), OrdRank(7)), 1)
  Test.assert_eq(ord_generic_relations<OrdBox<i64>>(OrdBox(2), OrdBox(7)), 1)
}

test "ord_compare_laws_hold_for_string_matrix" {
  let ab = ord_compare<str>("a", "b")
  let ba = ord_compare<str>("b", "a")
  let bc = ord_compare<str>("b", "c")
  let ac = ord_compare<str>("a", "c")
  Test.assert_eq(ab, 0 - ba)
  Test.assert_eq(ord_compare<str>("a", "a"), 0)
  Test.assert_eq(if ab < 0 and bc < 0 and ac < 0 { 1 } else { 0 }, 1)
}
