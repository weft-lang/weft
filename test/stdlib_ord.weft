use stdlib/ord.{*}

type OrdRank {
  OrdRank(i64)
}

type OrdBox<T> {
  OrdBox(T)
}

fn ord_rank_value(rank: OrdRank) -> i64 {
  match rank {
    OrdRank(value) -> value
  }
}

impl Ord for OrdRank {
  fn compare(self: Self, other: Self) -> Ordering {
    ord_compare<i64>(ord_rank_value(self), ord_rank_value(other))
  }
}

impl<T: Ord> Ord for OrdBox<T> {
  fn compare(self: Self, other: Self) -> Ordering {
    match self {
      OrdBox(left) -> match other {
        OrdBox(right) -> left.compare(right)
      }
    }
  }
}

trait OrdWitness { }

impl OrdWitness for OrdRank { }

fn ord_generic_relations<T: Ord>(low: T, high: T) -> i64 {
  if low < high and low <= high and high > low and high >= low { 1 } else { 0 }
}

fn ord_generic_multibound_relations<T: OrdWitness & Ord>(low: T, high: T) -> i64 {
  if low < high and high > low { 1 } else { 0 }
}

fn assert_less(ordering: Ordering) -[Test]> i64 {
  match ordering {
    Less -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

fn assert_equal(ordering: Ordering) -[Test]> i64 {
  match ordering {
    Equal -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

fn assert_greater(ordering: Ordering) -[Test]> i64 {
  match ordering {
    Greater -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "ord_numeric_implementations_cover_every_primitive" {
  assert_less(ord_compare<i8>(1, 2))
  assert_greater(ord_compare<i16>(2, 1))
  assert_equal(ord_compare<i32>(3, 3))
  assert_less(ord_compare<i64>(0 - 4, 0 - 3))
  assert_greater(ord_compare<isize>(5, 4))
  assert_less(ord_compare<u8>(1, 2))
  assert_greater(ord_compare<u16>(2, 1))
  assert_equal(ord_compare<u32>(3, 3))
  assert_less(ord_compare<u64>(4, 5))
  assert_greater(ord_compare<usize>(6, 5))
  assert_less(ord_compare<f32>(1.25, 1.5))
  assert_equal(ord_compare<f64>(2.5, 2.5))
}

test "ord_float_nan_is_a_stable_final_equivalence_class" {
  let nan64: f64 = 0.0 / 0.0
  let nan32: f32 = 0.0 / 0.0
  assert_greater(ord_compare<f64>(nan64, 1.0))
  assert_less(ord_compare<f64>(1.0, nan64))
  assert_equal(ord_compare<f64>(nan64, nan64))
  assert_greater(ord_compare<f32>(nan32, 1.0))
  assert_less(ord_compare<f32>(1.0, nan32))
  assert_equal(ord_compare<f32>(nan32, nan32))
}

test "ord_str_compare_handles_empty_prefix_unicode_and_equality" {
  assert_less(ord_compare<str>("", "a"))
  assert_less(ord_compare<str>("alpha", "alphabet"))
  assert_greater(ord_compare<str>("beta", "alpha"))
  assert_equal(ord_compare<str>("same", "same"))
  assert_less(ord_compare<str>("z", "Ω"))
}

test "ord_relational_operators_dispatch_for_str" {
  let alpha: str = "alpha"
  let beta: str = "beta"
  Test.assert_eq(alpha < beta, 1)
  Test.assert_eq(alpha <= beta, 1)
  Test.assert_eq(beta > alpha, 1)
  Test.assert_eq(beta >= alpha, 1)
  Test.assert_eq(alpha >= beta, 0)
}

test "ord_relational_operators_dispatch_for_user_type" {
  let low = OrdRank(2)
  let high = OrdRank(7)
  Test.assert_eq(low < high, 1)
  Test.assert_eq(low <= high, 1)
  Test.assert_eq(high > low, 1)
  Test.assert_eq(high >= low, 1)
  Test.assert_eq(low > high, 0)
}

test "ord_relational_operators_dispatch_through_generic_bounds" {
  Test.assert_eq(ord_generic_relations<str>("alpha", "beta"), 1)
  Test.assert_eq(ord_generic_relations<i64>(2, 7), 1)
  Test.assert_eq(ord_generic_multibound_relations<OrdRank>(OrdRank(2), OrdRank(7)), 1)
  Test.assert_eq(ord_generic_relations<OrdBox<i64>>(OrdBox(2), OrdBox(7)), 1)
}

test "ord_compare_laws_hold_for_string_matrix" {
  assert_less(ord_compare<str>("a", "b"))
  assert_greater(ord_compare<str>("b", "a"))
  assert_equal(ord_compare<str>("a", "a"))
  assert_less(ord_compare<str>("b", "c"))
  assert_less(ord_compare<str>("a", "c"))
}
