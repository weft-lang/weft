use compiler/storage.{ nlist_new, nlist_add, nlist_len }
use compiler/project/module.{ module_fact_register_source }
use compiler/project/checked_modules.{ module_checked_product_share_semantic_facts }
use compiler/weft/check/table.{*}
use compiler/types/algebra.{ ty_i64, ty_bool }
use stdlib/test.{ Test }

fn binding_fact(tt: i64, src: i64, start: i64, len: i64, ty: i64) -> i64 {
  ttable_add_semantic_symbol_fact(tt, src, start, len, src, start, len, ty, 0, semantic_symbol_kind_local(), 0, 0)
}

test "binding queries require exact source and declaration span" {
  let tt = ttable_new()
  let src = __str_ptr("first source")
  let other = __str_ptr("second source")
  let first = binding_fact(tt, src, 3, 5, ty_i64())
  let second = binding_fact(tt, other, 3, 5, ty_bool())
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 3, 5), first)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, other, 3, 5), second)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 4, 5), 0)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 3, 4), 0)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 3, 0), 0)
  Test.assert_eq(ttable_find_semantic_binding_fact(0, src, 3, 5), 0)
}

test "binding queries exclude uses and other symbol kinds" {
  let tt = ttable_new()
  let src = __str_ptr("declaration and use")
  let fact = binding_fact(tt, src, 0, 3, ty_i64())
  ttable_add_semantic_symbol_fact(tt, src, 9, 3, src, 0, 3, ty_bool(), 0, semantic_symbol_kind_local(), 0, 0)
  ttable_add_semantic_symbol_fact(tt, src, 15, 3, src, 15, 3, ty_bool(), 0, semantic_symbol_kind_parameter(), 0, 0)
  ttable_add_semantic_symbol_fact(tt, src, 0, 3, src, 0, 3, ty_bool(), 0, semantic_symbol_kind_match_arm(), 0, 0)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 0, 3), fact)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 9, 3), 0)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 15, 3), 0)
}

test "binding refinement preserves point-query match-arm priority" {
  let tt = ttable_new()
  let src = __str_ptr("refined binding")
  binding_fact(tt, src, 0, 7, ty_i64())
  let arm = ttable_add_semantic_symbol_fact(tt, src, 0, 7, src, 0, 7, ty_bool(), 0, semantic_symbol_kind_match_arm(), 0, 0)
  let refined = binding_fact(tt, src, 0, 7, ty_bool())
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 0, 7), refined)
  Test.assert_eq(ttable_find_semantic_symbol_fact(tt, src, 0), arm)
  Test.assert_eq(nlist_len(ttable_semantic_symbol_facts(tt)), 3)
}

test "binding lookup retains exact identities across index growth and collisions" {
  let tt = ttable_new()
  let src = __str_ptr("many declarations")
  for i in 0..5000 { binding_fact(tt, src, i * 1024, 1, i + 100) }
  for i in 0..5000 {
    let found = ttable_find_semantic_binding_fact(tt, src, i * 1024, 1)
    Test.assert_true(found != 0)
    Test.assert_eq(semantic_symbol_fact_type(found), i + 100)
  }
  let refined = binding_fact(tt, src, 2048, 1, ty_bool())
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 2048, 1), refined)
  Test.assert_eq(ttable_find_semantic_binding_fact(tt, src, 5000 * 1024, 1), 0)
}

test "checked products share facts but own independent binding projections" {
  let source = ttable_new()
  let dest = ttable_new()
  let src = __str_ptr("selected source")
  let other = __str_ptr("unselected source")
  let path = "selected.weft"
  let selected = nlist_new()
  nlist_add(selected, module_fact_register_source(source, src, __str_ptr(path), __str_len(path), 0))
  let original_type = ty_i64()
  let original = binding_fact(source, src, 0, 8, original_type)
  binding_fact(source, other, 0, 8, ty_i64())
  module_checked_product_share_semantic_facts(source, dest, selected)
  Test.assert_eq(ttable_find_semantic_binding_fact(dest, src, 0, 8), original)
  Test.assert_eq(ttable_find_semantic_binding_fact(dest, other, 0, 8), 0)
  let refined = binding_fact(dest, src, 0, 8, ty_bool())
  Test.assert_eq(ttable_find_semantic_binding_fact(dest, src, 0, 8), refined)
  Test.assert_eq(ttable_find_semantic_binding_fact(source, src, 0, 8), original)
  Test.assert_eq(semantic_symbol_fact_type(original), original_type)
}
