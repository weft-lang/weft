use runtime/alloc.{alloc_bump_mark, alloc_zeroed}
use runtime/memory.{mem_load8_at, mem_store8_at}
use runtime/sha256.{sha256, sha256_with_zeroed_range}

fn sha_test_assert_hex(digest: i64, expected: str) -[Test]> i64 {
  let digits = "0123456789abcdef"
  for index in 0..32 {
    let byte = mem_load8_at(digest, index)
    Test.assert_eq(mem_load8_at(__str_ptr(digits), byte / 16), mem_load8_at(__str_ptr(expected), index * 2))
    Test.assert_eq(mem_load8_at(__str_ptr(digits), byte % 16), mem_load8_at(__str_ptr(expected), index * 2 + 1))
  }
  0
}

test "SHA256 matches independent full-width padding and multiblock vectors" {
  let data = alloc_zeroed(1000000)
  for index in 0..1000000 { mem_store8_at(data, index, 97) }
  let digest = alloc_zeroed(32)
  for len in [0, 55, 56, 63, 64, 65, 1000000] {
    let expected = match len {
      0 -> "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      55 -> "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"
      56 -> "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"
      63 -> "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"
      64 -> "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"
      65 -> "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0"
      _ -> "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"
    }
    sha256(data, len, digest)
    sha_test_assert_hex(digest, expected)
  }
}

type HashMask { EmptyMask, FirstByte, WholeInput, LastByte, SecondHalf }

test "masked hashing matches explicit zeroing across blocks and padding" {
  let data = alloc_zeroed(192)
  let copy = alloc_zeroed(192)
  let actual = alloc_zeroed(32)
  let expected = alloc_zeroed(32)
  for len in [55, 56, 63, 64, 65, 96, 127, 128, 129, 192] {
    for mask in [EmptyMask, FirstByte, WholeInput, LastByte, SecondHalf] {
      let (start, count) = match mask {
        EmptyMask -> (0, 0)
        FirstByte -> (0, 1)
        WholeInput -> (0, len)
        LastByte -> (len - 1, 1)
        SecondHalf -> (len / 2, len / 2)
      }
      for index in 0..len {
        mem_store8_at(data, index, (index + 1) % 256)
        mem_store8_at(copy, index, if index >= start and index < start + count { 0 } else { (index + 1) % 256 })
      }
      sha256_with_zeroed_range(data, len, start, count, actual)
      sha256(copy, len, expected)
      for index in 0..32 { Test.assert_eq(mem_load8_at(actual, index), mem_load8_at(expected, index)) }
      for index in 0..len { Test.assert_eq(mem_load8_at(data, index), (index + 1) % 256) }
    }
  }
}

test "SHA256 scratch allocation is independent of payload size" {
  let data = alloc_zeroed(1048576)
  let digest = alloc_zeroed(32)
  sha256(data, 1, digest)
  let before_small = alloc_bump_mark()
  sha256(data, 64, digest)
  let after_small = alloc_bump_mark()
  sha256(data, 1048576, digest)
  let after_large = alloc_bump_mark()
  Test.assert_eq(after_large - after_small, after_small - before_small)
  Test.assert_true(after_large - after_small <= 1024)
}
