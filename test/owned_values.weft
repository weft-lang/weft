use "stdlib/drop.weft"

type OwnedValueToken {
  value: i64
}

impl Drop for OwnedValueToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

fn owned_token_new(value: i64) -> owned OwnedValueToken {
  OwnedValueToken { value: value }
}

fn owned_consume_token(x: owned OwnedValueToken) -> i64 {
  42
}

fn owned_id_token(x: owned OwnedValueToken) -> owned OwnedValueToken {
  x
}

fn owned_make_token() -> owned OwnedValueToken {
  owned_token_new(43)
}

fn owned_apply_token(f: (owned OwnedValueToken) -> i64, x: owned OwnedValueToken) -> i64 {
  f(x)
}

fn owned_apply_consume_token(x: owned OwnedValueToken) -> i64 {
  owned_consume_token(x)
}

test "owned_resource_constructs_and_consumes_once" {
  Test.assert_eq(owned_consume_token(owned_token_new(42)), 42)
}

test "owned_resource_moves_through_let_once" {
  let x: owned OwnedValueToken = owned_make_token()
  let y: owned OwnedValueToken = x
  Test.assert_eq(owned_consume_token(y), 42)
}

test "owned_resource_can_roundtrip_as_owned" {
  let x: owned OwnedValueToken = owned_token_new(7)
  Test.assert_eq(owned_consume_token(owned_id_token(x)), 42)
}

test "owned_resource_can_cross_function_value_boundary" {
  Test.assert_eq(owned_apply_token(owned_apply_consume_token, owned_token_new(11)), 42)
}
