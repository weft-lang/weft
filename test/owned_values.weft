fn owned_consume_i64(x: owned i64) -> i64 {
  x
}

fn owned_id_i64(x: owned i64) -> owned i64 {
  x
}

fn owned_make_i64() -> owned i64 {
  43
}

fn owned_apply_i64(f: (owned i64) -> i64, x: owned i64) -> i64 {
  f(x)
}

test "owned_literal_constructs_and_consumes_once" {
  Test.assert_eq(owned_consume_i64(42), 42)
}

test "owned_value_moves_through_let_once" {
  let x: owned i64 = owned_make_i64()
  let y: owned i64 = x
  Test.assert_eq(owned_consume_i64(y), 43)
}

test "owned_value_can_roundtrip_as_owned" {
  let x: owned i64 = 7
  Test.assert_eq(owned_consume_i64(owned_id_i64(x)), 7)
}

test "owned_contextual_lambda_consumes_param_once" {
  Test.assert_eq(owned_apply_i64(x => x, 11), 11)
}
