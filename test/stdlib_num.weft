use stdlib/num.{*}
use stdlib/result.{*}
use stdlib/string.{*}

fn parse_i64_value(src: str, default: i64) -> i64 {
  num_parse_i64_value_or(num_parse_i64(src), default)
}

fn parse_i64_ok(src: str) -> i64 {
  num_parse_i64_is_ok(num_parse_i64(src))
}

fn parse_i64_error(src: str) -> i64 {
  num_parse_i64_error_code(num_parse_i64(src))
}

fn parse_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  let text = num_i64_to_str(n)
  let parsed = num_parse_i64(text)
  num_parse_i64_is_ok(parsed) == 1 and num_parse_i64_value_or(parsed, 999) == n
}

fn parse_f64_bits(source: str) -> u64 {
  num_f64_to_bits(num_parse_f64_value_or(num_parse_f64(source), 0.0))
}

fn parse_f32_bits(source: str) -> u32 {
  num_f32_to_bits(num_parse_f32_value_or(num_parse_f32(source), 0.0))
}

fn same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn f64_two_to_63() -> f64 {
  num_i64_to_f64(4611686018427387904) * 2.0
}

fn i64_to_f64_step_property(i: i64) -> bool {
  let n = i - 16
  num_i64_to_f64(n) + 1.0 == num_i64_to_f64(n + 1)
}

fn f64_to_i64_exact_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  match num_f64_to_i64_exact(num_i64_to_f64(n)) {
    Ok(value) -> value == n
    Err(error) -> false
  }
}

fn f64_f32_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  let narrowed = num_f64_to_f32_round(num_i64_to_f64(n))
  num_f32_to_f64(narrowed) == num_i64_to_f64(n)
}

fn i64_to_i8_checked_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  match num_i64_to_i8_checked(n) {
    Ok(value) -> num_i8_to_i64(value) == n
    Err(error) -> false
  }
}

fn num_cast_is_out_of_range<T>(result: Result<T, NumCastError>) -> i64 {
  match result {
    Ok(value) -> 0
    Err(NumCastOutOfRange) -> 1
  }
}

fn num_exact_error_is(result: Result<i64, NumExactIntError>, expected: NumExactIntError) -> i64 {
  match result {
    Ok(value) -> 0
    Err(error) -> if error == expected { 1 } else { 0 }
  }
}

test "num_parse_i64_happy_scalar_values" {
  Test.assert_eq(parse_i64_value("0", 99), 0)
  Test.assert_eq(parse_i64_value("42", 0), 42)
  Test.assert_eq(parse_i64_value("+42", 0), 42)
  Test.assert_eq(parse_i64_value("-42", 0), 0 - 42)
  Test.assert_eq(parse_i64_value("00042", 0), 42)
  Test.assert_eq(parse_i64_value("-00042", 0), 0 - 42)
}

test "num_parse_i64_happy_boundaries" {
  let max = num_parse_i64("9223372036854775807")
  let min = num_parse_i64("-9223372036854775808")
  let near_min = num_parse_i64("-9223372036854775807")
  Test.assert_eq(num_parse_i64_is_ok(max), 1)
  Test.assert_str_eq(num_i64_to_str(num_parse_i64_value_or(max, 0)), "9223372036854775807")
  Test.assert_eq(num_parse_i64_is_ok(min), 1)
  Test.assert_eq(num_parse_i64_is_ok(near_min), 1)
  Test.assert_eq(num_parse_i64_value_or(min, 0) + 1, num_parse_i64_value_or(near_min, 0))
}

test "num_parse_i64_prefix_happy_paths" {
  let first = num_parse_i64_prefix("123abc", 0)
  let second = num_parse_i64_prefix("abc-45!", 3)
  Test.assert_eq(num_parse_i64_is_ok(first), 1)
  Test.assert_eq(num_parse_i64_value_or(first, 0), 123)
  Test.assert_eq(num_parse_i64_next_pos(first), 3)
  Test.assert_eq(num_parse_i64_value_or(second, 0), 0 - 45)
  Test.assert_eq(num_parse_i64_next_pos(second), 6)
}

test "num_parse_i64_sad_empty_invalid_and_trailing" {
  Test.assert_eq(parse_i64_ok(""), 0)
  Test.assert_eq(parse_i64_error(""), num_parse_err_empty())
  Test.assert_eq(parse_i64_error("+"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("-"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("abc"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("12abc"), num_parse_err_trailing())
  Test.assert_eq(num_parse_i64_error_pos(num_parse_i64("12abc")), 2)
}

test "num_parse_i64_sad_overflow_matrix" {
  let pos = num_parse_i64("9223372036854775808")
  let neg = num_parse_i64("-9223372036854775809")
  let long_digits = num_parse_i64("100000000000000000000")
  let leading_zeros = num_parse_i64("00000000000000000000042")
  Test.assert_eq(num_parse_i64_error_code(pos), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_error_code(neg), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_error_code(long_digits), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_is_ok(leading_zeros), 1)
  Test.assert_eq(num_parse_i64_value_or(leading_zeros, 0), 42)
}

test "num_parse_f64_happy_decimal_and_exponent_matrix" {
  Test.assert_true(parse_f64_bits("0") == 0)
  Test.assert_true(parse_f64_bits(".5") == 4602678819172646912)
  Test.assert_true(parse_f64_bits("1.") == 4607182418800017408)
  Test.assert_true(parse_f64_bits("+1.5") == 4609434218613702656)
  Test.assert_true(parse_f64_bits("1.25e2") == 4638496509959077888)
  Test.assert_true(parse_f64_bits("1e-3") == 4562254508917369340)
}

test "num_parse_f64_preserves_rounding_and_signed_zero" {
  Test.assert_true(parse_f64_bits("9007199254740993.0") == 4845873199050653696)
  Test.assert_true(parse_f64_bits("0.123456789012345678901234567890123456789") == 4593560419847042655)
  Test.assert_true(parse_f64_bits("5e-324") == 1)
  Test.assert_true(parse_f64_bits("-0") == 9223372036854775808)
}

test "num_parse_f32_happy_and_nearest_even_matrix" {
  Test.assert_true(parse_f32_bits(".5") == 1056964608)
  Test.assert_true(parse_f32_bits("1.5") == 1069547520)
  Test.assert_true(parse_f32_bits("16777217.0") == 1266679808)
  Test.assert_true(parse_f32_bits("1e-45") == 1)
  Test.assert_true(parse_f32_bits("-0") == 2147483648)
}

test "num_parse_float_prefixes_compose_at_offsets" {
  let f64_result = num_parse_f64_prefix("abc-12.5e1!", 3)
  let f32_result = num_parse_f32_prefix("x.25rest", 1)
  Test.assert_eq(num_parse_f64_is_ok(f64_result), 1)
  Test.assert_true(num_f64_to_bits(num_parse_f64_value_or(f64_result, 0.0)) == 13861868546813853696)
  Test.assert_eq(num_parse_f64_next_pos(f64_result), 10)
  Test.assert_eq(num_parse_f32_is_ok(f32_result), 1)
  Test.assert_true(num_f32_to_bits(num_parse_f32_value_or(f32_result, 0.0)) == 1048576000)
  Test.assert_eq(num_parse_f32_next_pos(f32_result), 4)
}

test "num_parse_float_reports_typed malformed positions" {
  let empty = num_parse_f64("")
  let sign = num_parse_f64("-")
  let dot = num_parse_f64(".")
  let exponent = num_parse_f64("1e+")
  Test.assert_eq(num_parse_f64_error_code(empty), num_parse_err_empty())
  Test.assert_eq(num_parse_f64_error_pos(empty), 0)
  Test.assert_eq(num_parse_f64_error_code(sign), num_parse_err_invalid())
  Test.assert_eq(num_parse_f64_error_pos(sign), 1)
  Test.assert_eq(num_parse_f64_error_code(dot), num_parse_err_invalid())
  Test.assert_eq(num_parse_f64_error_pos(dot), 0)
  Test.assert_eq(num_parse_f64_error_code(exponent), num_parse_err_invalid())
  Test.assert_eq(num_parse_f64_error_pos(exponent), 3)
}

test "num_parse_float_distinguishes overflow underflow and trailing" {
  Test.assert_eq(num_parse_f64_error_code(num_parse_f64("1e309")), num_parse_err_overflow())
  Test.assert_eq(num_parse_f64_error_code(num_parse_f64("1e-324")), num_parse_err_underflow())
  Test.assert_eq(num_parse_f32_error_code(num_parse_f32("1e39")), num_parse_err_overflow())
  Test.assert_eq(num_parse_f32_error_code(num_parse_f32("1e-46")), num_parse_err_underflow())
  Test.assert_eq(num_parse_f64_error_code(num_parse_f64("12.5ms")), num_parse_err_trailing())
  Test.assert_eq(num_parse_f64_error_pos(num_parse_f64("12.5ms")), 4)
}

test "num_parse_float_classifies pathological exponents without expansion" {
  Test.assert_eq(num_parse_f64_error_code(num_parse_f64("1e999999999999999999999")), num_parse_err_overflow())
  Test.assert_eq(num_parse_f64_error_code(num_parse_f64("1e-999999999999999999999")), num_parse_err_underflow())
}

test "num_parse_float_roundtrips explicit nonfinite spellings" {
  let infinity = num_parse_f64("inf")
  let negative_infinity = num_parse_f64("-inf")
  let nan = num_parse_f64("NaN")
  Test.assert_true(num_f64_to_bits(num_parse_f64_value_or(infinity, 0.0)) == 9218868437227405312)
  Test.assert_true(num_f64_to_bits(num_parse_f64_value_or(negative_infinity, 0.0)) == 18442240474082181120)
  Test.assert_true(num_parse_f64_value_or(nan, 0.0) != num_parse_f64_value_or(nan, 0.0))
  Test.assert_true(parse_f32_bits("inf") == 2139095040)
  Test.assert_true(parse_f32_bits("-inf") == 4286578688)
  let nan32 = num_parse_f32_value_or(num_parse_f32("NaN"), 0.0)
  Test.assert_true(nan32 != nan32)
}

test "property_num_small_i64_roundtrips" {
  Test.forall_i64_range(0, 33, parse_roundtrip_property)
}

test "num_i64_to_f64_happy_boundaries" {
  Test.assert_eq(same_f64(num_i64_to_f64(0), 0.0), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(42), 42.0), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(-7), -7.0), 1)
}

test "num_i64_to_f64_enables_explicit_mixed_arithmetic" {
  Test.assert_eq(same_f64(num_i64_to_f64(40) + 2.5, 42.5), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(9) / 2.0, 4.5), 1)
}

test "num_i64_to_f64_method_surface" {
  let a: i64 = 20
  let b: i64 = 22
  Test.assert_eq(same_f64(a.to_f64() + b.to_f64(), 42.0), 1)
}

test "property_num_small_i64_to_f64_steps" {
  Test.forall_i64_range(0, 33, i64_to_f64_step_property)
}

test "num_integer_family_to_f64_signed_matrix" {
  let a: i8 = -8
  let b: i16 = -160
  let c: i32 = -32000
  let d: i64 = -64000
  let e: isize = -128
  Test.assert_eq(same_f64(num_i8_to_f64(a), 0.0 - 8.0), 1)
  Test.assert_eq(same_f64(num_i16_to_f64(b), 0.0 - 160.0), 1)
  Test.assert_eq(same_f64(num_i32_to_f64(c), 0.0 - 32000.0), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(d), 0.0 - 64000.0), 1)
  Test.assert_eq(same_f64(num_isize_to_f64(e), 0.0 - 128.0), 1)
}

test "num_integer_family_to_f64_unsigned_matrix" {
  let a: u8 = 255
  let b: u16 = 65535
  let c: u32 = 4294967295
  let d: u64 = 9223372036854775808
  let e: usize = 9223372036854775808
  Test.assert_eq(same_f64(num_u8_to_f64(a), 255.0), 1)
  Test.assert_eq(same_f64(num_u16_to_f64(b), 65535.0), 1)
  Test.assert_eq(same_f64(num_u32_to_f64(c), 4294967295.0), 1)
  Test.assert_eq(same_f64(num_u64_to_f64(d), f64_two_to_63()), 1)
  Test.assert_eq(same_f64(num_usize_to_f64(e), f64_two_to_63()), 1)
}

test "num_integer_family_to_f64_method_surface" {
  let a: i16 = -20
  let b: u32 = 62
  let c: usize = 0
  Test.assert_eq(same_f64(a.to_f64() + b.to_f64() + c.to_f64(), 42.0), 1)
}

test "num_integer_family_to_f32_round_signed_matrix" {
  let a: i8 = -8
  let b: i16 = 160
  let c: i32 = 16777217
  let d: i64 = -16777217
  let e: isize = -128
  Test.assert_eq(same_f64(num_f32_to_f64(num_i8_to_f32_round(a)), 0.0 - 8.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_i16_to_f32_round(b)), 160.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_i32_to_f32_round(c)), 16777216.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_i64_to_f32_round(d)), 0.0 - 16777216.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_isize_to_f32_round(e)), 0.0 - 128.0), 1)
}

test "num_integer_family_to_f32_round_unsigned_matrix" {
  let a: u8 = 255
  let b: u16 = 65535
  let c: u32 = 16777217
  let d: u64 = 9223372036854775808
  let e: usize = 9223372036854775808
  Test.assert_eq(same_f64(num_f32_to_f64(num_u8_to_f32_round(a)), 255.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_u16_to_f32_round(b)), 65535.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_u32_to_f32_round(c)), 16777216.0), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_u64_to_f32_round(d)), f64_two_to_63()), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(num_usize_to_f32_round(e)), f64_two_to_63()), 1)
}

test "num_integer_family_to_f32_method_surface" {
  let value: i32 = 16777217
  let rounded = value.to_f32_round()
  Test.assert_eq(same_f64(num_f32_to_f64(rounded), 16777216.0), 1)
}

test "num_integer_canonical_widening_happy_matrix" {
  let a: i8 = -128
  let b: i16 = -32768
  let c: i32 = -2147483648
  let d: isize = -42
  let e: u8 = 255
  let f: u16 = 65535
  let g: u32 = 4294967295
  let h: usize = 9223372036854775808
  Test.assert_eq(num_i8_to_i64(a), -128)
  Test.assert_eq(num_i16_to_i64(b), -32768)
  Test.assert_eq(num_i32_to_i64(c), -2147483648)
  Test.assert_eq(num_isize_to_i64(d), -42)
  Test.assert_eq(if num_u8_to_u64(e) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_u16_to_u64(f) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_u32_to_u64(g) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_usize_to_u64(h) == 9223372036854775808 { 1 } else { 0 }, 1)
}

test "num_integer_canonical_widening_method_surface" {
  let signed: i16 = -20
  let unsigned: u16 = 62
  Test.assert_eq(signed.to_i64(), -20)
  Test.assert_eq(if unsigned.to_u64() == 62 { 1 } else { 0 }, 1)
}

test "num_int_cast_helpers_happy_and_sad" {
  let ok = num_i64_to_i8_checked(7)
  let err = num_i64_to_i8_checked(128)
  Test.assert_true(ok.is_ok())
  Test.assert_eq(num_i8_to_i64(ok.unwrap_or(0)), 7)
  Test.assert_true(err.is_err())
  Test.assert_eq(num_cast_is_out_of_range<i8>(err), 1)
  Test.assert_eq(num_i8_to_i64(err.unwrap_or(42)), 42)
}

test "num_i64_integer_checked_happy_matrix" {
  let i8_min = num_i64_to_i8_checked(-128)
  let i16_max = num_i64_to_i16_checked(32767)
  let i32_min = num_i64_to_i32_checked(-2147483648)
  let isize_value = num_i64_to_isize_checked(-42)
  let u8_max = num_i64_to_u8_checked(255)
  let u16_max = num_i64_to_u16_checked(65535)
  let u32_max = num_i64_to_u32_checked(4294967295)
  let u64_value = num_i64_to_u64_checked(42)
  let usize_value = num_i64_to_usize_checked(42)
  Test.assert_eq(num_i8_to_i64(i8_min.unwrap_or(0)), -128)
  Test.assert_eq(num_i16_to_i64(i16_max.unwrap_or(0)), 32767)
  Test.assert_eq(num_i32_to_i64(i32_min.unwrap_or(0)), -2147483648)
  Test.assert_eq(num_isize_to_i64(isize_value.unwrap_or(0)), -42)
  Test.assert_eq(if u8_max.unwrap_or(0) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_max.unwrap_or(0) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_max.unwrap_or(0) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_value.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_value.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
}

test "num_i64_integer_checked_sad_boundaries" {
  Test.assert_eq(num_cast_is_out_of_range<i8>(num_i64_to_i8_checked(-129)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i8>(num_i64_to_i8_checked(128)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>(num_i64_to_i16_checked(-32769)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>(num_i64_to_i16_checked(32768)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>(num_i64_to_i32_checked(-2147483649)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>(num_i64_to_i32_checked(2147483648)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>(num_i64_to_u8_checked(-1)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>(num_i64_to_u8_checked(256)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u16>(num_i64_to_u16_checked(65536)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u32>(num_i64_to_u32_checked(4294967296)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u64>(num_i64_to_u64_checked(-1)), 1)
  Test.assert_eq(num_cast_is_out_of_range<usize>(num_i64_to_usize_checked(-1)), 1)
}

test "num_u64_integer_checked_happy_matrix" {
  let i8_max = num_u64_to_i8_checked(127)
  let i16_max = num_u64_to_i16_checked(32767)
  let i32_max = num_u64_to_i32_checked(2147483647)
  let i64_max = num_u64_to_i64_checked(9223372036854775807)
  let isize_max = num_u64_to_isize_checked(9223372036854775807)
  let u8_max = num_u64_to_u8_checked(255)
  let u16_max = num_u64_to_u16_checked(65535)
  let u32_max = num_u64_to_u32_checked(4294967295)
  let usize_top = num_u64_to_usize_checked(18446744073709551615)
  Test.assert_eq(num_i8_to_i64(i8_max.unwrap_or(0)), 127)
  Test.assert_eq(num_i16_to_i64(i16_max.unwrap_or(0)), 32767)
  Test.assert_eq(num_i32_to_i64(i32_max.unwrap_or(0)), 2147483647)
  Test.assert_eq(i64_max.unwrap_or(0), 9223372036854775807)
  Test.assert_eq(num_isize_to_i64(isize_max.unwrap_or(0)), 9223372036854775807)
  Test.assert_eq(if u8_max.unwrap_or(0) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_max.unwrap_or(0) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_max.unwrap_or(0) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_top.unwrap_or(0) == 18446744073709551615 { 1 } else { 0 }, 1)
}

test "num_u64_integer_checked_sad_boundaries" {
  Test.assert_eq(num_cast_is_out_of_range<i8>(num_u64_to_i8_checked(128)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>(num_u64_to_i16_checked(32768)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>(num_u64_to_i32_checked(2147483648)), 1)
  Test.assert_eq(num_cast_is_out_of_range<i64>(num_u64_to_i64_checked(9223372036854775808)), 1)
  Test.assert_eq(num_cast_is_out_of_range<isize>(num_u64_to_isize_checked(9223372036854775808)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>(num_u64_to_u8_checked(256)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u16>(num_u64_to_u16_checked(65536)), 1)
  Test.assert_eq(num_cast_is_out_of_range<u32>(num_u64_to_u32_checked(4294967296)), 1)
}

test "num_integer_checked_method_chaining_surface" {
  let signed: i32 = 42
  let unsigned: u32 = 42
  let narrowed = signed.to_i64().to_u8_checked()
  let widened_signed = unsigned.to_u64().to_i64_checked()
  Test.assert_eq(if narrowed.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(widened_signed.unwrap_or(0), 42)
}

test "property_num_small_i64_to_i8_checked_roundtrips" {
  Test.forall_i64_range(0, 33, i64_to_i8_checked_roundtrip_property)
}

test "num_traits_numeric_marker_all_scalar_primitives" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  let f: u8 = 0
  let g: u16 = 0
  let h: u32 = 0
  let i: u64 = 0
  let j: usize = 0
  let k: f32 = 0.0
  let l: f64 = 0.0
  Test.assert_eq(
    num_accepts_numeric<i8>(a) + num_accepts_numeric<i16>(b) +
      num_accepts_numeric<i32>(c) + num_accepts_numeric<i64>(d) +
      num_accepts_numeric<isize>(e) + num_accepts_numeric<u8>(f) +
      num_accepts_numeric<u16>(g) + num_accepts_numeric<u32>(h) +
      num_accepts_numeric<u64>(i) + num_accepts_numeric<usize>(j) +
      num_accepts_numeric<f32>(k) + num_accepts_numeric<f64>(l),
    12)
}

test "num_traits_integer_metadata_signed_matrix" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  Test.assert_eq(num_bit_width<i8>(a), 8)
  Test.assert_eq(num_bit_width<i16>(b), 16)
  Test.assert_eq(num_bit_width<i32>(c), 32)
  Test.assert_eq(num_bit_width<i64>(d), 64)
  Test.assert_eq(num_bit_width<isize>(e), 64)
  Test.assert_eq(num_is_signed<i8>(a) + num_is_signed<i16>(b) + num_is_signed<i32>(c) + num_is_signed<i64>(d) + num_is_signed<isize>(e), 5)
}

test "num_traits_integer_metadata_unsigned_matrix" {
  let a: u8 = 0
  let b: u16 = 0
  let c: u32 = 0
  let d: u64 = 0
  let e: usize = 0
  Test.assert_eq(num_bit_width<u8>(a), 8)
  Test.assert_eq(num_bit_width<u16>(b), 16)
  Test.assert_eq(num_bit_width<u32>(c), 32)
  Test.assert_eq(num_bit_width<u64>(d), 64)
  Test.assert_eq(num_bit_width<usize>(e), 64)
  Test.assert_eq(num_is_signed<u8>(a) + num_is_signed<u16>(b) + num_is_signed<u32>(c) + num_is_signed<u64>(d) + num_is_signed<usize>(e), 0)
}

test "num_traits_signed_integer_bounds_matrix" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  Test.assert_eq(num_signed_min_i64<i8>(a), -128)
  Test.assert_eq(num_signed_max_i64<i8>(a), 127)
  Test.assert_eq(num_signed_min_i64<i16>(b), -32768)
  Test.assert_eq(num_signed_max_i64<i16>(b), 32767)
  Test.assert_eq(num_signed_min_i64<i32>(c), -2147483648)
  Test.assert_eq(num_signed_max_i64<i32>(c), 2147483647)
  Test.assert_eq(num_signed_min_i64<i64>(d), 0 - 9223372036854775808)
  Test.assert_eq(num_signed_max_i64<i64>(d), 9223372036854775807)
  Test.assert_eq(num_signed_min_i64<isize>(e), 0 - 9223372036854775808)
  Test.assert_eq(num_signed_max_i64<isize>(e), 9223372036854775807)
}

test "num_traits_unsigned_integer_bounds_matrix" {
  let a: u8 = 0
  let b: u16 = 0
  let c: u32 = 0
  let d: u64 = 0
  let e: usize = 0
  Test.assert_eq(if num_unsigned_max_u64<u8>(a) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_unsigned_max_u64<u16>(b) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_unsigned_max_u64<u32>(c) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_unsigned_max_u64<u64>(d) == 18446744073709551615 { 1 } else { 0 }, 1)
  Test.assert_eq(if num_unsigned_max_u64<usize>(e) == 18446744073709551615 { 1 } else { 0 }, 1)
}

test "num_traits_float_metadata_matrix" {
  let a: f32 = 0.0
  let b: f64 = 0.0
  Test.assert_eq(num_float_width<f32>(a), 32)
  Test.assert_eq(num_float_mantissa_bits<f32>(a), 24)
  Test.assert_eq(num_float_exponent_bits<f32>(a), 8)
  Test.assert_eq(num_float_width<f64>(b), 64)
  Test.assert_eq(num_float_mantissa_bits<f64>(b), 53)
  Test.assert_eq(num_float_exponent_bits<f64>(b), 11)
}

test "num_traits_direct_method_dispatch" {
  let a: i16 = 0
  let b: u32 = 0
  let c: f64 = 0.0
  Test.assert_eq(a.bit_width() + a.is_signed(), 17)
  Test.assert_eq(if b.max_u64() == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(c.float_width() + c.mantissa_bits() + c.exponent_bits(), 128)
}

test "num_f64_to_i64_exact_happy_scalars" {
  let zero = num_f64_to_i64_exact(0.0)
  let pos = num_f64_to_i64_exact(42.0)
  let neg = num_f64_to_i64_exact(0.0 - 7.0)
  Test.assert_true(zero.is_ok())
  Test.assert_eq(zero.unwrap_or(99), 0)
  Test.assert_eq(pos.unwrap_or(0), 42)
  Test.assert_eq(neg.unwrap_or(0), 0 - 7)
}

test "num_f64_to_i64_exact_rejects_fractional_nonfinite" {
  let fractional = num_f64_to_i64_exact(3.5)
  let negative_fractional = num_f64_to_i64_exact(0.0 - 2.25)
  let nan_value = num_f64_to_i64_exact(0.0 / 0.0)
  let infinity = num_f64_to_i64_exact(1.0 / 0.0)
  Test.assert_true(fractional.is_err())
  Test.assert_eq(num_exact_error_is(fractional, NumExactIntNotExact), 1)
  Test.assert_eq(num_exact_error_is(negative_fractional, NumExactIntNotExact), 1)
  Test.assert_eq(num_exact_error_is(nan_value, NumExactIntNaN), 1)
  Test.assert_eq(num_exact_error_is(infinity, NumExactIntNotExact), 1)
}

test "num_f64_to_i64_exact_method_surface" {
  let value: f64 = 20.0 + 22.0
  let converted = value.to_i64_exact()
  Test.assert_true(converted.is_ok())
  Test.assert_eq(converted.unwrap_or(0), 42)
}

test "property_num_small_f64_to_i64_exact_roundtrips" {
  Test.forall_i64_range(0, 33, f64_to_i64_exact_roundtrip_property)
}

test "num_f32_f64_conversion_happy_scalars" {
  let half: f32 = num_f64_to_f32_round(1.5)
  let neg: f32 = num_f64_to_f32_round(0.0 - 2.25)
  Test.assert_eq(same_f64(num_f32_to_f64(half), 1.5), 1)
  Test.assert_eq(same_f64(num_f32_to_f64(neg), 0.0 - 2.25), 1)
  Test.assert_eq(same_f32(half, 1.5), 1)
}

test "num_f32_f64_conversion_method_surface" {
  let value: f32 = 42.5.to_f32_round()
  Test.assert_eq(same_f64(value.to_f64(), 42.5), 1)
}

test "num_f64_to_f32_round_precision_boundary" {
  let rounded = num_f64_to_f32_round(16777217.0)
  Test.assert_eq(same_f64(num_f32_to_f64(rounded), 16777216.0), 1)
}

test "property_num_small_f64_f32_roundtrips" {
  Test.forall_i64_range(0, 33, f64_f32_roundtrip_property)
}
