use "stdlib/num.weft"
use "stdlib/string.weft"

fn parse_i64_value(src: str, default: i64) -> i64 {
  num_parse_i64_value_or(num_parse_i64(src), default)
}

fn parse_i64_ok(src: str) -> i64 {
  num_parse_i64_is_ok(num_parse_i64(src))
}

fn parse_i64_error(src: str) -> i64 {
  num_parse_i64_error_code(num_parse_i64(src))
}

fn parse_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  let text = num_i64_to_str(n)
  let parsed = num_parse_i64(text)
  num_parse_i64_is_ok(parsed) == 1 and num_parse_i64_value_or(parsed, 999) == n
}

fn same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn i64_to_f64_step_property(i: i64) -> bool {
  let n = i - 16
  num_i64_to_f64(n) + 1.0 == num_i64_to_f64(n + 1)
}

test "num_parse_i64_happy_scalar_values" {
  Test.assert_eq(parse_i64_value("0", 99), 0)
  Test.assert_eq(parse_i64_value("42", 0), 42)
  Test.assert_eq(parse_i64_value("+42", 0), 42)
  Test.assert_eq(parse_i64_value("-42", 0), 0 - 42)
  Test.assert_eq(parse_i64_value("00042", 0), 42)
  Test.assert_eq(parse_i64_value("-00042", 0), 0 - 42)
}

test "num_parse_i64_happy_boundaries" {
  let max = num_parse_i64("9223372036854775807")
  let min = num_parse_i64("-9223372036854775808")
  let near_min = num_parse_i64("-9223372036854775807")
  Test.assert_eq(num_parse_i64_is_ok(max), 1)
  Test.assert_str_eq(num_i64_to_str(num_parse_i64_value_or(max, 0)), "9223372036854775807")
  Test.assert_eq(num_parse_i64_is_ok(min), 1)
  Test.assert_eq(num_parse_i64_is_ok(near_min), 1)
  Test.assert_eq(num_parse_i64_value_or(min, 0) + 1, num_parse_i64_value_or(near_min, 0))
}

test "num_parse_i64_prefix_happy_paths" {
  let first = num_parse_i64_prefix("123abc", 0)
  let second = num_parse_i64_prefix("abc-45!", 3)
  Test.assert_eq(num_parse_i64_is_ok(first), 1)
  Test.assert_eq(num_parse_i64_value_or(first, 0), 123)
  Test.assert_eq(num_parse_i64_next_pos(first), 3)
  Test.assert_eq(num_parse_i64_value_or(second, 0), 0 - 45)
  Test.assert_eq(num_parse_i64_next_pos(second), 6)
}

test "num_parse_i64_sad_empty_invalid_and_trailing" {
  Test.assert_eq(parse_i64_ok(""), 0)
  Test.assert_eq(parse_i64_error(""), num_parse_err_empty())
  Test.assert_eq(parse_i64_error("+"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("-"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("abc"), num_parse_err_invalid())
  Test.assert_eq(parse_i64_error("12abc"), num_parse_err_trailing())
  Test.assert_eq(num_parse_i64_error_pos(num_parse_i64("12abc")), 2)
}

test "num_parse_i64_sad_overflow_matrix" {
  let pos = num_parse_i64("9223372036854775808")
  let neg = num_parse_i64("-9223372036854775809")
  let long_digits = num_parse_i64("100000000000000000000")
  let leading_zeros = num_parse_i64("00000000000000000000042")
  Test.assert_eq(num_parse_i64_error_code(pos), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_error_code(neg), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_error_code(long_digits), num_parse_err_overflow())
  Test.assert_eq(num_parse_i64_is_ok(leading_zeros), 1)
  Test.assert_eq(num_parse_i64_value_or(leading_zeros, 0), 42)
}

test "property_num_small_i64_roundtrips" {
  Test.forall_i64_range(0, 33, parse_roundtrip_property)
}

test "num_i64_to_f64_happy_boundaries" {
  Test.assert_eq(same_f64(num_i64_to_f64(0), 0.0), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(42), 42.0), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(-7), -7.0), 1)
}

test "num_i64_to_f64_enables_explicit_mixed_arithmetic" {
  Test.assert_eq(same_f64(num_i64_to_f64(40) + 2.5, 42.5), 1)
  Test.assert_eq(same_f64(num_i64_to_f64(9) / 2.0, 4.5), 1)
}

test "num_i64_to_f64_method_surface" {
  let a: i64 = 20
  let b: i64 = 22
  Test.assert_eq(same_f64(a.to_f64() + b.to_f64(), 42.0), 1)
}

test "property_num_small_i64_to_f64_steps" {
  Test.forall_i64_range(0, 33, i64_to_f64_step_property)
}
