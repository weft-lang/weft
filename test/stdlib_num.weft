use stdlib/num as num
use stdlib/num.{*}
use stdlib/option.{None, Option, Some}
use stdlib/result.{*}
use stdlib/string.{*}

fn parse_i64_value(src: str, default: i64) -> i64 {
  num.parse_i64(src).unwrap_or(default)
}

fn parse_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  let text = n.to_str()
  match num.parse_i64(text) {
    Ok(parsed) -> parsed == n
    Err(error) -> false
  }
}

fn parse_f64_bits(source: str) -> u64 {
  num.parse_f64(source).unwrap_or(0.0).to_bits()
}

fn parse_f32_bits(source: str) -> u32 {
  num.parse_f32(source).unwrap_or(0.0).to_bits()
}

fn num_parse_is_empty<T>(result: Result<T, NumParseError>, pos: i64) -> bool {
  match result {
    Err(NumParseEmpty(at)) -> at == pos
    other -> false
  }
}

fn num_parse_is_invalid<T>(result: Result<T, NumParseError>, pos: i64) -> bool {
  match result {
    Err(NumParseInvalid(at)) -> at == pos
    other -> false
  }
}

fn num_parse_is_overflow<T>(result: Result<T, NumParseError>, pos: i64) -> bool {
  match result {
    Err(NumParseOverflow(at)) -> at == pos
    other -> false
  }
}

fn num_parse_is_underflow<T>(result: Result<T, NumParseError>, pos: i64) -> bool {
  match result {
    Err(NumParseUnderflow(at)) -> at == pos
    other -> false
  }
}

fn num_parse_is_trailing<T>(result: Result<T, NumParseError>, pos: i64) -> bool {
  match result {
    Err(NumParseTrailing(at)) -> at == pos
    other -> false
  }
}

fn num_parse_is_overflow_kind<T>(result: Result<T, NumParseError>) -> bool {
  match result {
    Err(NumParseOverflow(at)) -> true
    other -> false
  }
}

fn num_parse_is_underflow_kind<T>(result: Result<T, NumParseError>) -> bool {
  match result {
    Err(NumParseUnderflow(at)) -> true
    other -> false
  }
}

fn same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn f64_two_to_63() -> f64 {
  4611686018427387904.to_f64() * 2.0
}

fn i64_to_f64_step_property(i: i64) -> bool {
  let n = i - 16
  n.to_f64() + 1.0 == (n + 1).to_f64()
}

fn f64_to_i64_exact_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  match n.to_f64().to_i64_exact() {
    Ok(value) -> value == n
    Err(error) -> false
  }
}

fn f64_f32_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  let narrowed = n.to_f64().to_f32_round()
  narrowed.to_f64() == n.to_f64()
}

fn i64_to_i8_checked_roundtrip_property(i: i64) -> bool {
  let n = i - 16
  match n.to_i8_checked() {
    Ok(value) -> value.to_i64() == n
    Err(error) -> false
  }
}

fn num_trait_witness<T: Num>(value: T) -> i64 { 1 }

fn num_cast_is_out_of_range<T>(result: Result<T, NumCastError>) -> i64 {
  match result {
    Ok(value) -> 0
    Err(NumCastOutOfRange) -> 1
  }
}

fn usize_option_is(result: Option<usize>, expected: usize) -> bool {
  match result {
    Some(value) -> value == expected
    None -> false
  }
}

fn usize_option_is_none(result: Option<usize>) -> bool {
  match result {
    Some(value) -> false
    None -> true
  }
}

fn num_exact_error_is(result: Result<i64, NumExactIntError>, expected: NumExactIntError) -> i64 {
  match result {
    Ok(value) -> 0
    Err(error) -> if error == expected { 1 } else { 0 }
  }
}

test "num_parse_i64_happy_scalar_values" {
  Test.assert_eq(parse_i64_value("0", 99), 0)
  Test.assert_eq(parse_i64_value("42", 0), 42)
  Test.assert_eq(parse_i64_value("+42", 0), 42)
  Test.assert_eq(parse_i64_value("-42", 0), 0 - 42)
  Test.assert_eq(parse_i64_value("00042", 0), 42)
  Test.assert_eq(parse_i64_value("-00042", 0), 0 - 42)
}

test "num_parse_i64_happy_boundaries" {
  let max = num.parse_i64("9223372036854775807")
  let min = num.parse_i64("-9223372036854775808")
  let near_min = num.parse_i64("-9223372036854775807")
  Test.assert_true(max.is_ok())
  Test.assert_str_eq(max.unwrap_or(0).to_str(), "9223372036854775807")
  Test.assert_true(min.is_ok())
  Test.assert_true(near_min.is_ok())
  Test.assert_eq(min.unwrap_or(0) + 1, near_min.unwrap_or(0))
}

test "num_parse_i64_prefix_happy_paths" {
  let first = num.parse_i64_prefix("123abc", 0)
  let second = num.parse_i64_prefix("abc-45!", 3)
  match first {
    Ok((value, next)) -> { Test.assert_eq(value, 123) Test.assert_eq(next, 3) }
    Err(error) -> Test.assert_true(false)
  }
  match second {
    Ok((value, next)) -> { Test.assert_eq(value, 0 - 45) Test.assert_eq(next, 6) }
    Err(error) -> Test.assert_true(false)
  }
}

test "num_parse_i64_sad_empty_invalid_and_trailing" {
  Test.assert_true(num_parse_is_empty<i64>(num.parse_i64(""), 0))
  Test.assert_true(num_parse_is_invalid<i64>(num.parse_i64("+"), 1))
  Test.assert_true(num_parse_is_invalid<i64>(num.parse_i64("-"), 1))
  Test.assert_true(num_parse_is_invalid<i64>(num.parse_i64("abc"), 0))
  Test.assert_true(num_parse_is_trailing<i64>(num.parse_i64("12abc"), 2))
}

test "num_parse_i64_sad_overflow_matrix" {
  let pos = num.parse_i64("9223372036854775808")
  let neg = num.parse_i64("-9223372036854775809")
  let long_digits = num.parse_i64("100000000000000000000")
  let leading_zeros = num.parse_i64("00000000000000000000042")
  Test.assert_true(num_parse_is_overflow<i64>(pos, 19))
  Test.assert_true(num_parse_is_overflow<i64>(neg, 20))
  Test.assert_true(num_parse_is_overflow<i64>(long_digits, 21))
  Test.assert_true(leading_zeros.is_ok())
  Test.assert_eq(leading_zeros.unwrap_or(0), 42)
}

test "num_parse_f64_happy_decimal_and_exponent_matrix" {
  Test.assert_true(parse_f64_bits("0") == 0)
  Test.assert_true(parse_f64_bits(".5") == 4602678819172646912)
  Test.assert_true(parse_f64_bits("1.") == 4607182418800017408)
  Test.assert_true(parse_f64_bits("+1.5") == 4609434218613702656)
  Test.assert_true(parse_f64_bits("1.25e2") == 4638496509959077888)
  Test.assert_true(parse_f64_bits("1e-3") == 4562254508917369340)
}

test "num_parse_f64_preserves_rounding_and_signed_zero" {
  Test.assert_true(parse_f64_bits("9007199254740993.0") == 4845873199050653696)
  Test.assert_true(parse_f64_bits("0.123456789012345678901234567890123456789") == 4593560419847042655)
  Test.assert_true(parse_f64_bits("5e-324") == 1)
  Test.assert_true(parse_f64_bits("-0") == 9223372036854775808)
}

test "num_parse_f32_happy_and_nearest_even_matrix" {
  Test.assert_true(parse_f32_bits(".5") == 1056964608)
  Test.assert_true(parse_f32_bits("1.5") == 1069547520)
  Test.assert_true(parse_f32_bits("16777217.0") == 1266679808)
  Test.assert_true(parse_f32_bits("1e-45") == 1)
  Test.assert_true(parse_f32_bits("-0") == 2147483648)
}

test "num_parse_float_prefixes_compose_at_offsets" {
  let f64_result = num.parse_f64_prefix("abc-12.5e1!", 3)
  let f32_result = num.parse_f32_prefix("x.25rest", 1)
  match f64_result {
    Ok((value, next)) -> {
      Test.assert_true(value.to_bits() == 13861868546813853696)
      Test.assert_eq(next, 10)
    }
    Err(error) -> Test.assert_true(false)
  }
  match f32_result {
    Ok((value, next)) -> {
      Test.assert_true(value.to_bits() == 1048576000)
      Test.assert_eq(next, 4)
    }
    Err(error) -> Test.assert_true(false)
  }
}

test "num_parse_float_reports_typed malformed positions" {
  let empty = num.parse_f64("")
  let sign = num.parse_f64("-")
  let dot = num.parse_f64(".")
  let exponent = num.parse_f64("1e+")
  Test.assert_true(num_parse_is_empty<f64>(empty, 0))
  Test.assert_true(num_parse_is_invalid<f64>(sign, 1))
  Test.assert_true(num_parse_is_invalid<f64>(dot, 0))
  Test.assert_true(num_parse_is_invalid<f64>(exponent, 3))
}

test "num_parse_float_distinguishes overflow underflow and trailing" {
  Test.assert_true(num_parse_is_overflow<f64>(num.parse_f64("1e309"), 5))
  Test.assert_true(num_parse_is_underflow<f64>(num.parse_f64("1e-324"), 6))
  Test.assert_true(num_parse_is_overflow<f32>(num.parse_f32("1e39"), 4))
  Test.assert_true(num_parse_is_underflow<f32>(num.parse_f32("1e-46"), 5))
  Test.assert_true(num_parse_is_trailing<f64>(num.parse_f64("12.5ms"), 4))
}

test "num_parse_float_classifies pathological exponents without expansion" {
  Test.assert_true(num_parse_is_overflow_kind<f64>(num.parse_f64("1e999999999999999999999")))
  Test.assert_true(num_parse_is_underflow_kind<f64>(num.parse_f64("1e-999999999999999999999")))
}

test "num_parse_float_roundtrips explicit nonfinite spellings" {
  let infinity = num.parse_f64("inf")
  let negative_infinity = num.parse_f64("-inf")
  let nan = num.parse_f64("NaN")
  Test.assert_true(infinity.unwrap_or(0.0).to_bits() == 9218868437227405312)
  Test.assert_true(negative_infinity.unwrap_or(0.0).to_bits() == 18442240474082181120)
  Test.assert_true(nan.unwrap_or(0.0).to_bits() == 9221120237041090560)
  Test.assert_true(parse_f32_bits("inf") == 2139095040)
  Test.assert_true(parse_f32_bits("-inf") == 4286578688)
  Test.assert_true(num.parse_f32("NaN").unwrap_or(0.0).to_bits() == 2143289344)
}

test "property_num_small_i64_roundtrips" {
  Test.forall_i64_range(0, 33, parse_roundtrip_property)
}

test "num_i64_to_f64_happy_boundaries" {
  Test.assert_eq(same_f64(0.to_f64(), 0.0), 1)
  Test.assert_eq(same_f64(42.to_f64(), 42.0), 1)
  Test.assert_eq(same_f64((-7).to_f64(), -7.0), 1)
}

test "num_i64_to_f64_enables_explicit_mixed_arithmetic" {
  Test.assert_eq(same_f64(40.to_f64() + 2.5, 42.5), 1)
  Test.assert_eq(same_f64(9.to_f64() / 2.0, 4.5), 1)
}

test "num_i64_to_f64_method_surface" {
  let a: i64 = 20
  let b: i64 = 22
  Test.assert_eq(same_f64(a.to_f64() + b.to_f64(), 42.0), 1)
}

test "property_num_small_i64_to_f64_steps" {
  Test.forall_i64_range(0, 33, i64_to_f64_step_property)
}

test "num_integer_family_to_f64_signed_matrix" {
  let a: i8 = -8
  let b: i16 = -160
  let c: i32 = -32000
  let d: i64 = -64000
  let e: isize = -128
  Test.assert_eq(same_f64(a.to_f64(), 0.0 - 8.0), 1)
  Test.assert_eq(same_f64(b.to_f64(), 0.0 - 160.0), 1)
  Test.assert_eq(same_f64(c.to_f64(), 0.0 - 32000.0), 1)
  Test.assert_eq(same_f64(d.to_f64(), 0.0 - 64000.0), 1)
  Test.assert_eq(same_f64(e.to_f64(), 0.0 - 128.0), 1)
}

test "num_integer_family_to_f64_unsigned_matrix" {
  let a: u8 = 255
  let b: u16 = 65535
  let c: u32 = 4294967295
  let d: u64 = 9223372036854775808
  let e: usize = 9223372036854775808
  Test.assert_eq(same_f64(a.to_f64(), 255.0), 1)
  Test.assert_eq(same_f64(b.to_f64(), 65535.0), 1)
  Test.assert_eq(same_f64(c.to_f64(), 4294967295.0), 1)
  Test.assert_eq(same_f64(d.to_f64(), f64_two_to_63()), 1)
  Test.assert_eq(same_f64(e.to_f64(), f64_two_to_63()), 1)
}

test "num_integer_family_to_f64_method_surface" {
  let a: i16 = -20
  let b: u32 = 62
  let c: usize = 0
  Test.assert_eq(same_f64(a.to_f64() + b.to_f64() + c.to_f64(), 42.0), 1)
}

test "num_integer_family_to_f32_round_signed_matrix" {
  let a: i8 = -8
  let b: i16 = 160
  let c: i32 = 16777217
  let d: i64 = -16777217
  let e: isize = -128
  Test.assert_eq(same_f64(a.to_f32_round().to_f64(), 0.0 - 8.0), 1)
  Test.assert_eq(same_f64(b.to_f32_round().to_f64(), 160.0), 1)
  Test.assert_eq(same_f64(c.to_f32_round().to_f64(), 16777216.0), 1)
  Test.assert_eq(same_f64(d.to_f32_round().to_f64(), 0.0 - 16777216.0), 1)
  Test.assert_eq(same_f64(e.to_f32_round().to_f64(), 0.0 - 128.0), 1)
}

test "num_integer_family_to_f32_round_unsigned_matrix" {
  let a: u8 = 255
  let b: u16 = 65535
  let c: u32 = 16777217
  let d: u64 = 9223372036854775808
  let e: usize = 9223372036854775808
  Test.assert_eq(same_f64(a.to_f32_round().to_f64(), 255.0), 1)
  Test.assert_eq(same_f64(b.to_f32_round().to_f64(), 65535.0), 1)
  Test.assert_eq(same_f64(c.to_f32_round().to_f64(), 16777216.0), 1)
  Test.assert_eq(same_f64(d.to_f32_round().to_f64(), f64_two_to_63()), 1)
  Test.assert_eq(same_f64(e.to_f32_round().to_f64(), f64_two_to_63()), 1)
}

test "num_integer_family_to_f32_method_surface" {
  let value: i32 = 16777217
  let rounded = value.to_f32_round()
  Test.assert_eq(same_f64(rounded.to_f64(), 16777216.0), 1)
}

test "num_integer_canonical_widening_happy_matrix" {
  let a: i8 = -128
  let b: i16 = -32768
  let c: i32 = -2147483648
  let d: isize = -42
  let e: u8 = 255
  let f: u16 = 65535
  let g: u32 = 4294967295
  let h: usize = 9223372036854775808
  Test.assert_eq(a.to_i64(), -128)
  Test.assert_eq(b.to_i64(), -32768)
  Test.assert_eq(c.to_i64(), -2147483648)
  Test.assert_eq(d.to_i64(), -42)
  Test.assert_eq(if e.to_u64() == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if f.to_u64() == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if g.to_u64() == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if h.to_u64() == 9223372036854775808 { 1 } else { 0 }, 1)
}

test "num_integer_canonical_widening_method_surface" {
  let signed: i16 = -20
  let unsigned: u16 = 62
  Test.assert_eq(signed.to_i64(), -20)
  Test.assert_eq(if unsigned.to_u64() == 62 { 1 } else { 0 }, 1)
}

test "num_int_cast_helpers_happy_and_sad" {
  let ok = 7.to_i8_checked()
  let err = 128.to_i8_checked()
  Test.assert_true(ok.is_ok())
  Test.assert_eq(ok.unwrap_or(0).to_i64(), 7)
  Test.assert_true(err.is_err())
  Test.assert_eq(num_cast_is_out_of_range<i8>(err), 1)
  Test.assert_eq(err.unwrap_or(42).to_i64(), 42)
}

test "num_i64_integer_checked_happy_matrix" {
  let i8_min = (-128).to_i8_checked()
  let i16_max = 32767.to_i16_checked()
  let i32_min = (-2147483648).to_i32_checked()
  let isize_value = (-42).to_isize_checked()
  let u8_max = 255.to_u8_checked()
  let u16_max = 65535.to_u16_checked()
  let u32_max = 4294967295.to_u32_checked()
  let u64_value = 42.to_u64_checked()
  let usize_value = 42.to_usize_checked()
  Test.assert_eq(i8_min.unwrap_or(0).to_i64(), -128)
  Test.assert_eq(i16_max.unwrap_or(0).to_i64(), 32767)
  Test.assert_eq(i32_min.unwrap_or(0).to_i64(), -2147483648)
  Test.assert_eq(isize_value.unwrap_or(0).to_i64(), -42)
  Test.assert_eq(if u8_max.unwrap_or(0) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_max.unwrap_or(0) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_max.unwrap_or(0) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if u64_value.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_value.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
}

test "num_i64_integer_checked_sad_boundaries" {
  Test.assert_eq(num_cast_is_out_of_range<i8>((-129).to_i8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i8>(128.to_i8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>((-32769).to_i16_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>(32768.to_i16_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>((-2147483649).to_i32_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>(2147483648.to_i32_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>((-1).to_u8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>(256.to_u8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u16>(65536.to_u16_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u32>(4294967296.to_u32_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u64>((-1).to_u64_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<usize>((-1).to_usize_checked()), 1)
}

test "num_usize_checked_add_covers_identity_and_overflow" {
  let zero: usize = 0
  let one: usize = 1
  let two: usize = 2
  let maximum: usize = 18446744073709551615
  Test.assert_true(usize_option_is(zero.checked_add(zero), zero))
  Test.assert_true(usize_option_is(one.checked_add(two), 3))
  Test.assert_true(usize_option_is(maximum.checked_add(zero), maximum))
  Test.assert_true(usize_option_is_none(maximum.checked_add(one)))
}

test "num_usize_checked_sub_covers_identity_and_underflow" {
  let zero: usize = 0
  let one: usize = 1
  let three: usize = 3
  Test.assert_true(usize_option_is(three.checked_sub(zero), three))
  Test.assert_true(usize_option_is(three.checked_sub(one), 2))
  Test.assert_true(usize_option_is(three.checked_sub(three), zero))
  Test.assert_true(usize_option_is_none(zero.checked_sub(one)))
}

test "num_usize_checked_mul_covers_zero_boundary_and_overflow" {
  let zero: usize = 0
  let one: usize = 1
  let two: usize = 2
  let maximum: usize = 18446744073709551615
  let half: usize = 9223372036854775807
  Test.assert_true(usize_option_is(maximum.checked_mul(zero), zero))
  Test.assert_true(usize_option_is(zero.checked_mul(maximum), zero))
  Test.assert_true(usize_option_is(maximum.checked_mul(one), maximum))
  Test.assert_true(usize_option_is(half.checked_mul(two), 18446744073709551614))
  Test.assert_true(usize_option_is_none(maximum.checked_mul(two)))
}

test "num_u64_integer_checked_happy_matrix" {
  let i8_source: u64 = 127
  let i16_source: u64 = 32767
  let i32_source: u64 = 2147483647
  let i64_source: u64 = 9223372036854775807
  let u8_source: u64 = 255
  let u16_source: u64 = 65535
  let u32_source: u64 = 4294967295
  let usize_source: u64 = 18446744073709551615
  let i8_max = i8_source.to_i8_checked()
  let i16_max = i16_source.to_i16_checked()
  let i32_max = i32_source.to_i32_checked()
  let i64_max = i64_source.to_i64_checked()
  let isize_max = i64_source.to_isize_checked()
  let u8_max = u8_source.to_u8_checked()
  let u16_max = u16_source.to_u16_checked()
  let u32_max = u32_source.to_u32_checked()
  let usize_top = usize_source.to_usize_checked()
  Test.assert_eq(i8_max.unwrap_or(0).to_i64(), 127)
  Test.assert_eq(i16_max.unwrap_or(0).to_i64(), 32767)
  Test.assert_eq(i32_max.unwrap_or(0).to_i64(), 2147483647)
  Test.assert_eq(i64_max.unwrap_or(0), 9223372036854775807)
  Test.assert_eq(isize_max.unwrap_or(0).to_i64(), 9223372036854775807)
  Test.assert_eq(if u8_max.unwrap_or(0) == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if u16_max.unwrap_or(0) == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if u32_max.unwrap_or(0) == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if usize_top.unwrap_or(0) == 18446744073709551615 { 1 } else { 0 }, 1)
}

test "num_u64_integer_checked_sad_boundaries" {
  let i8_source: u64 = 128
  let i16_source: u64 = 32768
  let i32_source: u64 = 2147483648
  let signed_source: u64 = 9223372036854775808
  let u8_source: u64 = 256
  let u16_source: u64 = 65536
  let u32_source: u64 = 4294967296
  Test.assert_eq(num_cast_is_out_of_range<i8>(i8_source.to_i8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i16>(i16_source.to_i16_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i32>(i32_source.to_i32_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<i64>(signed_source.to_i64_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<isize>(signed_source.to_isize_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u8>(u8_source.to_u8_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u16>(u16_source.to_u16_checked()), 1)
  Test.assert_eq(num_cast_is_out_of_range<u32>(u32_source.to_u32_checked()), 1)
}

test "num_integer_checked_method_chaining_surface" {
  let signed: i32 = 42
  let unsigned: u32 = 42
  let narrowed = signed.to_i64().to_u8_checked()
  let widened_signed = unsigned.to_u64().to_i64_checked()
  Test.assert_eq(if narrowed.unwrap_or(0) == 42 { 1 } else { 0 }, 1)
  Test.assert_eq(widened_signed.unwrap_or(0), 42)
}

test "property_num_small_i64_to_i8_checked_roundtrips" {
  Test.forall_i64_range(0, 33, i64_to_i8_checked_roundtrip_property)
}

test "num_traits_numeric_marker_all_scalar_primitives" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  let f: u8 = 0
  let g: u16 = 0
  let h: u32 = 0
  let i: u64 = 0
  let j: usize = 0
  let k: f32 = 0.0
  let l: f64 = 0.0
  Test.assert_eq(
    num_trait_witness<i8>(a) + num_trait_witness<i16>(b) +
      num_trait_witness<i32>(c) + num_trait_witness<i64>(d) +
      num_trait_witness<isize>(e) + num_trait_witness<u8>(f) +
      num_trait_witness<u16>(g) + num_trait_witness<u32>(h) +
      num_trait_witness<u64>(i) + num_trait_witness<usize>(j) +
      num_trait_witness<f32>(k) + num_trait_witness<f64>(l),
    12)
}

test "num_traits_integer_metadata_signed_matrix" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  Test.assert_eq(a.bit_width(), 8)
  Test.assert_eq(b.bit_width(), 16)
  Test.assert_eq(c.bit_width(), 32)
  Test.assert_eq(d.bit_width(), 64)
  Test.assert_eq(e.bit_width(), 64)
  Test.assert_true(a.is_signed())
  Test.assert_true(b.is_signed())
  Test.assert_true(c.is_signed())
  Test.assert_true(d.is_signed())
  Test.assert_true(e.is_signed())
}

test "num_traits_integer_metadata_unsigned_matrix" {
  let a: u8 = 0
  let b: u16 = 0
  let c: u32 = 0
  let d: u64 = 0
  let e: usize = 0
  Test.assert_eq(a.bit_width(), 8)
  Test.assert_eq(b.bit_width(), 16)
  Test.assert_eq(c.bit_width(), 32)
  Test.assert_eq(d.bit_width(), 64)
  Test.assert_eq(e.bit_width(), 64)
  Test.assert_false(a.is_signed())
  Test.assert_false(b.is_signed())
  Test.assert_false(c.is_signed())
  Test.assert_false(d.is_signed())
  Test.assert_false(e.is_signed())
}

test "num_traits_signed_integer_bounds_matrix" {
  let a: i8 = 0
  let b: i16 = 0
  let c: i32 = 0
  let d: i64 = 0
  let e: isize = 0
  Test.assert_eq(a.min_i64(), -128)
  Test.assert_eq(a.max_i64(), 127)
  Test.assert_eq(b.min_i64(), -32768)
  Test.assert_eq(b.max_i64(), 32767)
  Test.assert_eq(c.min_i64(), -2147483648)
  Test.assert_eq(c.max_i64(), 2147483647)
  Test.assert_eq(d.min_i64(), 0 - 9223372036854775808)
  Test.assert_eq(d.max_i64(), 9223372036854775807)
  Test.assert_eq(e.min_i64(), 0 - 9223372036854775808)
  Test.assert_eq(e.max_i64(), 9223372036854775807)
}

test "num_traits_unsigned_integer_bounds_matrix" {
  let a: u8 = 0
  let b: u16 = 0
  let c: u32 = 0
  let d: u64 = 0
  let e: usize = 0
  Test.assert_eq(if a.max_u64() == 255 { 1 } else { 0 }, 1)
  Test.assert_eq(if b.max_u64() == 65535 { 1 } else { 0 }, 1)
  Test.assert_eq(if c.max_u64() == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(if d.max_u64() == 18446744073709551615 { 1 } else { 0 }, 1)
  Test.assert_eq(if e.max_u64() == 18446744073709551615 { 1 } else { 0 }, 1)
}

test "num_traits_float_metadata_matrix" {
  let a: f32 = 0.0
  let b: f64 = 0.0
  Test.assert_eq(a.float_width(), 32)
  Test.assert_eq(a.mantissa_bits(), 24)
  Test.assert_eq(a.exponent_bits(), 8)
  Test.assert_eq(b.float_width(), 64)
  Test.assert_eq(b.mantissa_bits(), 53)
  Test.assert_eq(b.exponent_bits(), 11)
}

test "num_traits_direct_method_dispatch" {
  let a: i16 = 0
  let b: u32 = 0
  let c: f64 = 0.0
  Test.assert_eq(a.bit_width(), 16)
  Test.assert_true(a.is_signed())
  Test.assert_eq(if b.max_u64() == 4294967295 { 1 } else { 0 }, 1)
  Test.assert_eq(c.float_width() + c.mantissa_bits() + c.exponent_bits(), 128)
}

test "num_f64_to_i64_exact_happy_scalars" {
  let zero = 0.0.to_i64_exact()
  let pos = 42.0.to_i64_exact()
  let neg = (0.0 - 7.0).to_i64_exact()
  Test.assert_true(zero.is_ok())
  Test.assert_eq(zero.unwrap_or(99), 0)
  Test.assert_eq(pos.unwrap_or(0), 42)
  Test.assert_eq(neg.unwrap_or(0), 0 - 7)
}

test "num_f64_to_i64_exact_rejects_fractional_nonfinite" {
  let fractional = 3.5.to_i64_exact()
  let negative_fractional = (0.0 - 2.25).to_i64_exact()
  let nan_value = (0.0 / 0.0).to_i64_exact()
  let infinity = (1.0 / 0.0).to_i64_exact()
  Test.assert_true(fractional.is_err())
  Test.assert_eq(num_exact_error_is(fractional, NumExactIntNotExact), 1)
  Test.assert_eq(num_exact_error_is(negative_fractional, NumExactIntNotExact), 1)
  Test.assert_eq(num_exact_error_is(nan_value, NumExactIntNaN), 1)
  Test.assert_eq(num_exact_error_is(infinity, NumExactIntNotExact), 1)
}

test "num_f64_to_i64_exact_method_surface" {
  let value: f64 = 20.0 + 22.0
  let converted = value.to_i64_exact()
  Test.assert_true(converted.is_ok())
  Test.assert_eq(converted.unwrap_or(0), 42)
}

test "property_num_small_f64_to_i64_exact_roundtrips" {
  Test.forall_i64_range(0, 33, f64_to_i64_exact_roundtrip_property)
}

test "num_f32_f64_conversion_happy_scalars" {
  let half: f32 = 1.5.to_f32_round()
  let neg: f32 = (0.0 - 2.25).to_f32_round()
  Test.assert_eq(same_f64(half.to_f64(), 1.5), 1)
  Test.assert_eq(same_f64(neg.to_f64(), 0.0 - 2.25), 1)
  Test.assert_eq(same_f32(half, 1.5), 1)
}

test "num_f32_f64_conversion_method_surface" {
  let value: f32 = 42.5.to_f32_round()
  Test.assert_eq(same_f64(value.to_f64(), 42.5), 1)
}

test "num_f64_to_f32_round_precision_boundary" {
  let rounded = 16777217.0.to_f32_round()
  Test.assert_eq(same_f64(rounded.to_f64(), 16777216.0), 1)
}

test "property_num_small_f64_f32_roundtrips" {
  Test.forall_i64_range(0, 33, f64_f32_roundtrip_property)
}
