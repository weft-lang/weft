use stdlib/test.{Test}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read, defer_order_log_write}

effect SelectedObserve { fn observed(value: i64) -> i64 }
effect SelectedInput { fn input() -> i64 }

fn selected_choose(value: i64, mode: i64) -[SelectedObserve]> i64 {
  match mode {
    1 -> SelectedObserve.observed(value + 1)
    2 -> SelectedObserve.observed(value + 2)
    4 -> SelectedObserve.observed(value + 4)
    _ -> 7
  }
}

fn selected_inner(log: i64) -[SelectedInput, SelectedObserve]> i64 {
  let inner: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  selected_choose(SelectedInput.input(), 0)
}

fn selected_outer(log: i64) -[SelectedInput, SelectedObserve]> i64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  selected_inner(log)
}

test "selected call arguments still execute and both resource scopes close once" {
  let log = defer_order_log_new()
  let inputs = defer_order_log_new()
  let observations = defer_order_log_new()
  let result = handle {
    handle selected_outer(log) {
      SelectedInput.input() -> { defer_order_log_write(inputs, defer_order_log_read(inputs) + 1) resume(42) }
    }
  } {
    SelectedObserve.observed(value) -> { defer_order_log_write(observations, defer_order_log_read(observations) + 1) resume(value) }
  }
  Test.assert_eq(result, 7)
  Test.assert_eq(defer_order_log_read(inputs), 1)
  Test.assert_eq(defer_order_log_read(observations), 0)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "aborting a selected call argument skips the call and preserves exact cleanup" {
  let log = defer_order_log_new()
  let result = handle {
    handle selected_outer(log) {
      SelectedInput.input() -> 42
    }
  } {
    SelectedObserve.observed(value) -> resume(value)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "residual selected-call branches preserve their distinct effects and results" {
  let observations = defer_order_log_new()
  for (mode, expected) in [(0, 7), (1, 31), (2, 32), (4, 34), (9, 7)] {
    let result = handle selected_choose(30, mode) {
      SelectedObserve.observed(value) -> { defer_order_log_write(observations, defer_order_log_read(observations) + 1) resume(value) }
    }
    Test.assert_eq(result, expected)
  }
  Test.assert_eq(defer_order_log_read(observations), 3)
}

fn selected_owned(value: owned OwnedAbortToken, mode: i64) -> i64 { if mode == 0 { 7 } else { 8 } }

test "constant branches never erase an owned parameter's drop" {
  let log = defer_order_log_new()
  let value: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  Test.assert_eq(selected_owned(value, 0), 7)
  Test.assert_eq(defer_order_log_read(log), 1)
}
