use compiler/lib.{node_f1, node_f3, node_f4}
use compiler/type_registry.{str_hash}
use compiler/typeck.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}

fn setup_call_arguments(insts: IrInstList, target: i64) -> IrValueList {
  match insts {
    IrInstNil -> IrValueNil
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, callee, args) -> if callee == target { args } else { setup_call_arguments(rest, target) }
      _ -> setup_call_arguments(rest, target)
    }
  }
}

fn setup_block_arguments(blocks: IrBlockList, target: i64) -> IrValueList {
  match blocks {
    IrBlockListNil -> IrValueNil
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let args = setup_call_arguments(insts, target)
        if ir_value_list_len(args) != 0 { args } else { setup_block_arguments(rest, target) }
      }
    }
  }
}

fn lowered_setup_arguments(source: str) -> IrValueList {
  let typed = probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0)
  match typed {
    TypedModule(functions, src, table) -> {
      let pair = pipeline_fns_lookup_pair_by_hash(functions, str_hash(__str_ptr("sample"), 0, 6))
      let inner = pipeline_fn_inner(node_f1(pair))
      let params = node_f3(inner)
      let args = pipeline_par_call_args_typed(expr_from_node(node_f4(inner)))
      let module = pipeline_lower_module_with_fns(src, table, functions)
      let lowered = pipeline_lower_par_pthread_scope_typed(args, 1, params, pipeline_value_env_empty(), module, 32, 0, 1, 1000)
      setup_block_arguments(pipeline_lowered_blocks_blocks(lowered), pipeline_par_pthread_pool_start_config_hash())
    }
  }
}

test "parallel setup transports both words of a checked opaque configuration" {
  let source = "type Setup = opaque (i64, i64)
fn par_pthread_pool_start_config(config: Setup) -> i64 { match config { Setup((workers, capacity)) -> workers + capacity } }
fn invoke(config: Setup, body: () -> i64) -> i64 { body() }
fn sample(config: Setup) -> i64 { invoke(config, () => 42) }"
  let args = lowered_setup_arguments(source)
  Test.assert_eq(ir_value_list_len(args), 2)
  Test.assert_eq(pipeline_ir_value_list_get_or(args, 1, -1), pipeline_ir_value_list_get_or(args, 0, -1) + 1)
}

test "parallel setup follows the declared layout of a wider inline configuration" {
  let source = "type Setup = opaque (i64, i64, i64, i64, i64, i64, i64, i64)
fn par_pthread_pool_start_config(config: Setup) -> i64 { 0 }
fn invoke(config: Setup, body: () -> i64) -> i64 { body() }
fn sample(config: Setup) -> i64 { invoke(config, () => 42) }"
  let args = lowered_setup_arguments(source)
  Test.assert_eq(ir_value_list_len(args), 8)
  for lane in 0..8 {
    Test.assert_eq(pipeline_ir_value_list_get_or(args, lane, -1), pipeline_ir_value_list_get_or(args, 0, -1) + lane)
  }
}
