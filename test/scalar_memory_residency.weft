use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/test.{Test}

fn memory_roundtrip_i8(values: [mut i8], seed: i8, choose: bool) -> bool {
  let one: i8 = 1
  let carried = seed + values[0]
  if choose { values[1] = carried }
  else {
    values[1] = carried + one
    values[1] = values[1] - one
  }
  let observed = values[1]
  values[0] = observed + one
  let result = carried + values[0]
  result == one and values[1] == carried and values[0] == carried + one
}

test "i8 scalar memory preserves normalization and ordered writes across branches" {
  for choose in [true, false] {
    let mut values = vector.new<i8>()
    values.push(1)
    values.push(2)
    Test.assert_true(memory_roundtrip_i8(values[..], 127, choose))
  }
}

