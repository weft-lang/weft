-- Linux/aarch64 compiler-pipeline and standalone-product boundaries.

use compiler/lib.{bytes_u8_at}
use compiler/native_link.{*}
use compiler/native_target.{*}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use stdlib/list.{Nil, list_len}
use stdlib/string.{str_concat}

test "pipeline_linux_target_closes_real_standalone_elf_product" {
  let source = "pub fn main() -> i64 { 42 }"
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  Test.assert_eq(pipeline_native_binary_format_kind(native), pipeline_binary_kind_elf_executable())
  Test.assert_eq(pipeline_native_emit_error_count(native), 0)
  Test.assert_eq(pipeline_native_unmaterialized_trap_count(native), 0)
  match pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped) {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_elf_executable())
      Test.assert_eq(if buf_len(output) > 4096 { 1 } else { 0 }, 1)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 0, 0), 127)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 1, 0), 69)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 2, 0), 76)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 3, 0), 70)
      Test.assert_str_eq(
        pipeline_native_artifact_facts_render(facts),
        "{\"artifact_facts_version\":2,\"target\":\"linux-aarch64\",\"minimum_platform_abi\":{\"platform\":\"linux\",\"abi\":\"kernel\",\"major\":3,\"minor\":7,\"patch\":0,\"libc\":\"none\",\"dynamic_loader\":\"none\"},\"standalone\":true,\"dependencies\":[],\"static_inputs\":[],\"trust_grants\":[{\"package\":\"weft\",\"version\":\"0.1.0\",\"source\":\"path:.\",\"content\":\"root\",\"module\":\"runtime/tls_mbedtls\"}],\"debug_information\":{\"kind\":\"absent\"},\"signing\":{\"kind\":\"unsigned\"},\"dynamic_symbols\":[]}\n"
      )
      match facts {
        NativeArtifactFacts(NativeLinkLinuxAarch64, NativeArtifactLinuxKernelAbi(major, minor, patch), true, Nil, static_inputs, trust_grants, NativeArtifactDebugInformationAbsent, NativeArtifactUnsigned, symbols) -> {
          Test.assert_eq(major, 3)
          Test.assert_eq(minor, 7)
          Test.assert_eq(patch, 0)
          Test.assert_eq(list_len<NativeArtifactStaticInput>(static_inputs), 0)
          Test.assert_eq(list_len<NativeArtifactTrustGrant>(trust_grants), 1)
          Test.assert_eq(list_len<NativeLinkSymbol>(symbols), 0)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    PipelineNativeProductFailed(binary) -> Test.assert_eq(0, 1)
  }

  let panic_source = str_concat(
    "use stdlib/panic.",
    str_concat(
    "{",
    str_concat(
    "panic}\npub fn main() -> i64 ",
    str_concat("{", " panic(\"linux panic\") }")
  )
  )
  )
  let panic_typed = pipeline_check_source_standalone(__str_ptr(panic_source), __str_len(panic_source))
  let panic_native = pipeline_lower_native_ir_for_target_closed(panic_typed, NativeLinkLinuxAarch64)
  Test.assert_eq(pipeline_native_emit_error_count(panic_native), 0)
  Test.assert_eq(pipeline_native_unmaterialized_trap_count(panic_native), 0)
  match pipeline_checked_native_product(panic_native, __str_ptr(panic_source), PipelineNativeDebugInformationStripped) {
    PipelineNativeProductReady(binary, facts) -> {
      Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_elf_executable())
      Test.assert_eq(if buf_len(pipeline_binary_buf(binary)) > 4096 { 1 } else { 0 }, 1)
    }
    PipelineNativeProductFailed(binary) -> Test.assert_eq(0, 1)
  }
}

test "pipeline_explicit_host_target_preserves_default_native_code_bytes" {
  let source = "pub fn main() -> i64 { 42 }"
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let implicit = pipeline_lower_native_ir(typed)
  let explicit = pipeline_lower_native_ir_for_target(typed, native_link_target_host())
  let implicit_code = pipeline_native_code(implicit)
  let explicit_code = pipeline_native_code(explicit)
  Test.assert_eq(buf_len(implicit_code), buf_len(explicit_code))
  let mut same = 1
  let mut index = 0
  while same == 1 and index < buf_len(implicit_code) {
    if bytes_u8_at(buf_ptr(implicit_code), buf_len(implicit_code), index, 0) !=
      bytes_u8_at(buf_ptr(explicit_code), buf_len(explicit_code), index, 0) {
      same = 0
    } else { index = index + 1 }
  }
  Test.assert_eq(same, 1)
}

test "pipeline_linux_executable_closes_compiled_functions_from_main" {
  -- Unreachable declarations remain typed compiler data, but only the closed
  -- executable graph contributes native code. The linked tool-platform test
  -- separately pins that this also removes a Darwin-only foreign reference.
  let source = "fn unreachable() -> i64 { 13 }\npub fn main() -> i64 { 42 }"
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  Test.assert_eq(pipeline_native_emit_error_count(native), 0)
  Test.assert_eq(pipeline_native_unmaterialized_trap_count(native), 0)
  Test.assert_eq(if pipeline_native_function_count(native) > pipeline_native_ir_emit_count(native) { 1 } else { 0 }, 1)
  match pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped) {
    PipelineNativeProductReady(binary, facts) -> {
      Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_elf_executable())
      Test.assert_eq(if buf_len(pipeline_binary_buf(binary)) > 4096 { 1 } else { 0 }, 1)
    }
    PipelineNativeProductFailed(binary) -> Test.assert_eq(0, 1)
  }
}

test "pipeline_linux_debug_product_carries_shared_dwarf_fact" {
  let source = "pub fn helper(value: i64) -> i64 { value + 1 }\npub fn main() -> i64 { helper(41) }"
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  match pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationIncluded) {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      Test.assert_eq(pipeline_binary_kind(binary), pipeline_binary_kind_elf_executable())
      Test.assert_eq(if buf_len(output) > 4096 { 1 } else { 0 }, 1)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 60, 0), 5)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 61, 0), 0)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 62, 0), 4)
      Test.assert_eq(bytes_u8_at(buf_ptr(output), buf_len(output), 63, 0), 0)
      match native_link_artifact_debug_information(facts) {
        NativeArtifactDwarfInformation(version) -> Test.assert_str_eq(version, "dwarf-v4-function-file-line")
        NativeArtifactDebugInformationAbsent -> Test.assert_eq(0, 1)
      }
    }
    PipelineNativeProductFailed(binary) -> Test.assert_eq(0, 1)
  }
}
