use stdlib/option.{*}
use stdlib/result.{*}
use stdlib/list.{*}
use stdlib/string.{*}

type GenericMethodRecord {
  value: i64
}

test "option_methods_are_generic_across_some_and_none" {
  let some = Some<str>("weft")
  let none = None<str>()
  Test.assert_true(some.is_some())
  Test.assert_false(some.is_none())
  Test.assert_false(none.is_some())
  Test.assert_true(none.is_none())
  Test.assert_eq(str_eq(some.unwrap_or("fallback"), "weft"), 1)
  Test.assert_eq(str_eq(none.unwrap_or("fallback"), "fallback"), 1)
}

test "option_unwrap_or_preserves_record_payloads" {
  let present = Some<GenericMethodRecord>(GenericMethodRecord { value: 42 })
  let absent = None<GenericMethodRecord>()
  Test.assert_eq(present.unwrap_or(GenericMethodRecord { value: 0 }).value, 42)
  Test.assert_eq(absent.unwrap_or(GenericMethodRecord { value: 7 }).value, 7)
}

test "result_methods_are_generic_in_value_and_error" {
  let ok = Ok<str, bool>("weft")
  let err = Err<str, bool>(true)
  Test.assert_true(ok.is_ok())
  Test.assert_false(ok.is_err())
  Test.assert_false(err.is_ok())
  Test.assert_true(err.is_err())
  Test.assert_eq(str_eq(ok.unwrap_or("fallback"), "weft"), 1)
  Test.assert_eq(str_eq(err.unwrap_or("fallback"), "fallback"), 1)
}

test "result_unwrap_or_preserves_record_payloads" {
  let ok = Ok<GenericMethodRecord, str>(GenericMethodRecord { value: 42 })
  let err = Err<GenericMethodRecord, str>("broken")
  Test.assert_eq(ok.unwrap_or(GenericMethodRecord { value: 0 }).value, 42)
  Test.assert_eq(err.unwrap_or(GenericMethodRecord { value: 9 }).value, 9)
}

test "list_methods_are_generic_across_empty_and_nonempty_lists" {
  let empty = Nil<str>()
  let values = empty.prepend("tail").prepend("head")
  Test.assert_true(empty.len() == 0)
  Test.assert_true(values.len() == 2)
  Test.assert_eq(str_eq(values.first().unwrap_or("missing"), "head"), 1)
  Test.assert_str_eq(values.rest().unwrap().first().unwrap_or("missing"), "tail")
  Test.assert_true(values.rest().unwrap().rest().unwrap().len() == 0)
}

test "list_methods_preserve_nested_generic_identity" {
  let one = Some<i64>(42)
  let values = Nil<Option<i64>>().prepend(one)
  Test.assert_true(values.len() == 1)
  Test.assert_eq(values.first().unwrap_or(None<i64>()).unwrap_or(0), 42)
}
