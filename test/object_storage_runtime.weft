use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/vector as vector
use stdlib/option.{Option}
use stdlib/result.{Result}
use stdlib/test.{Test}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read}

test "aliased table writes preserve shape and expose each newly written value" {
  let table = f64_table.filled(2, 3, 1.0).unwrap()
  let alias = table
  for row in 0..table.rows() {
    for column in 0..table.columns() {
      let before = table.get(row, column).unwrap()
      Test.assert_true(alias.set(row, column, before + 2.0))
      Test.assert_true(table.set(row, column, alias.get(row, column).unwrap() * 3.0))
      Test.assert_true(alias.get(row, column).unwrap() == 9.0)
    }
  }
  Test.assert_eq(table.rows(), 2)
  Test.assert_eq(alias.columns(), 3)
  Test.assert_true(table.get(2, 0).is_none())
  Test.assert_false(alias.set(0, 3, 100.0))
}

test "scalar vector replacement changes elements while push pop and clear change length" {
  let mut values = vector.new<i64>()
  values.push(10)
  Test.assert_eq_usize(values.len(), 1)
  Test.assert_eq(values.set(0, 20).unwrap(), 10)
  Test.assert_eq(values.get(0).unwrap(), 20)
  Test.assert_eq_usize(values.len(), 1)
  values.reserve(32)
  values.push(30)
  Test.assert_eq_usize(values.len(), 2)
  Test.assert_eq(values.pop().unwrap(), 30)
  Test.assert_eq_usize(values.len(), 1)
  Test.assert_eq(values.get(0).unwrap(), 20)
  values.clear()
  Test.assert_eq_usize(values.len(), 0)
  Test.assert_true(values.get(0).is_none())
}

type InlineCell { tag: u8, value: i64 }
type ManagedCell { label: str, names: [str; 2] }

test "inline records and fixed arrays remain independent copies after replacement" {
  let mut records = vector.new<InlineCell>()
  records.push(InlineCell { tag: 1, value: 10 })
  let before = records.get(0).unwrap()
  let replaced = records.set(0, InlineCell { tag: 2, value: 20 }).unwrap()
  let after = records.get(0).unwrap()
  Test.assert_true(before.tag == 1 and replaced.tag == 1 and after.tag == 2)
  Test.assert_eq(before.value + replaced.value + after.value, 40)
  let mut arrays = vector.new<[i64; 2]>()
  arrays.push([3, 4])
  let old = arrays.get(0).unwrap()
  arrays.set(0, [7, 8])
  let current = arrays.get(0).unwrap()
  Test.assert_eq(old[0] + old[1], 7)
  Test.assert_eq(current[0] + current[1], 15)
}

test "managed element replacement keeps retained old objects alive after the container clears" {
  let mut values = vector.new<ManagedCell>()
  values.push(ManagedCell { label: "old", names: ["first", "second"] })
  let old = values.get(0).unwrap()
  let replaced = values.set(0, ManagedCell { label: "new", names: ["third", "fourth"] }).unwrap()
  let current = values.get(0).unwrap()
  values.clear()
  Test.assert_str_eq(old.label, "old")
  Test.assert_str_eq(replaced.names[1], "second")
  Test.assert_str_eq(current.label, "new")
  Test.assert_str_eq(current.names[0], "third")
}

effect CellPolicy { fn adjust() -> f64 }

fn object_storage_inner(table: F64Table, log: i64) -[CellPolicy]> f64 {
  let inner: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  let before = table.get(0, 0).unwrap()
  table.set(0, 0, before + 1.0)
  let adjustment = CellPolicy.adjust()
  before + table.get(0, 0).unwrap() + adjustment
}

fn object_storage_outer(table: F64Table, log: i64) -[CellPolicy]> f64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  object_storage_inner(table, log)
}

test "a resumed handler can mutate an alias and each resource still drops once" {
  let table = f64_table.filled(1, 1, 2.0).unwrap()
  let log = defer_order_log_new()
  let result = handle object_storage_outer(table, log) {
    CellPolicy.adjust() -> { table.set(0, 0, 10.0) resume(4.0) }
  }
  Test.assert_true(result == 16.0)
  Test.assert_true(table.get(0, 0).unwrap() == 10.0)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "aborting after element writes preserves mutation and ordered resource cleanup" {
  let table = f64_table.filled(1, 1, 2.0).unwrap()
  let log = defer_order_log_new()
  let result = handle object_storage_outer(table, log) {
    CellPolicy.adjust() -> { table.set(0, 0, 20.0) 42.0 }
  }
  Test.assert_true(result == 42.0)
  Test.assert_true(table.get(0, 0).unwrap() == 20.0)
  Test.assert_eq(defer_order_log_read(log), 21)
}
