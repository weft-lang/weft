fn segment(ordinal: usize) -> SemanticTypeSegmentId {
  semantic_type_segment_id(anonymous_module_identity_in_package(ordinal, 91))
}

fn effect_declaration(ordinal: usize, name: str) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    anonymous_module_identity_in_package(ordinal, 91),
    EffectDeclaration,
    source_from_text(name).all()
  )
}

fn type_declaration(ordinal: usize, name: str) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    anonymous_module_identity_in_package(ordinal, 91),
    TypeDeclaration,
    source_from_text(name).all()
  )
}

fn variant_declaration(
  ordinal: usize,
  owner_name: str,
  name: str
) -> DeclarationIdentity {
  MemberDeclarationIdentity(
    type_declaration(ordinal, owner_name),
    ConstructorDeclaration,
    source_from_text(name).all()
  )
}

fn trait_declaration(ordinal: usize, name: str) -> DeclarationIdentity {
  ModuleDeclarationIdentity(
    anonymous_module_identity_in_package(ordinal, 91),
    TraitDeclaration,
    source_from_text(name).all()
  )
}

fn associated_declaration(
  ordinal: usize,
  owner_name: str,
  name: str
) -> DeclarationIdentity {
  MemberDeclarationIdentity(
    trait_declaration(ordinal, owner_name),
    AssociatedTypeDeclaration,
    source_from_text(name).all()
  )
}

fn declaration_name_hash(declaration: DeclarationIdentity) -> i64 {
  match declaration_identity_name(declaration).text() {
    Some(name) -> name.hash()
    None -> 0
  }
}

fn primitive_code(value: SemanticPrimitiveView) -> i64 {
  match value {
    SemanticPrimitivePresent(primitive) -> match primitive {
      SemanticI64 -> 1
      SemanticStr -> 2
      SemanticBool -> 3
      SemanticNil -> 4
      SemanticF64 -> 5
      SemanticI32 -> 6
      SemanticI8 -> 7
      SemanticI16 -> 8
      SemanticU8 -> 9
      SemanticU16 -> 10
      SemanticU32 -> 11
      SemanticU64 -> 12
      SemanticIsize -> 13
      SemanticUsize -> 14
      SemanticF32 -> 15
    }
    SemanticPrimitiveAbsent -> 0
  }
}

fn primitive_from_code(code: usize) -> SemanticPrimitive {
  match code {
    0 -> SemanticI64
    1 -> SemanticStr
    2 -> SemanticBool
    3 -> SemanticNil
    4 -> SemanticF64
    5 -> SemanticI32
    6 -> SemanticI8
    7 -> SemanticI16
    8 -> SemanticU8
    9 -> SemanticU16
    10 -> SemanticU32
    11 -> SemanticU64
    12 -> SemanticIsize
    13 -> SemanticUsize
    _ -> SemanticF32
  }
}

fn mutability_code(mutability: SemanticMutability) -> i64 {
  match mutability {
    SemanticImmutable -> 0
    SemanticMutable -> 1
  }
}

fn usize_matches_i64(value: usize, expected: i64) -> bool {
  match num_scalar_usize_to_i64(value) {
    Some(actual) -> actual == expected
    None -> false
  }
}

fn usize_to_i64(value: usize) -> i64 {
  match num_scalar_usize_to_i64(value) {
    Some(actual) -> actual
    None -> 0
  }
}

fn legacy_primitive_from_code(code: usize) -> i64 {
  match code {
    0 -> PRIM_I64()
    1 -> PRIM_STR()
    2 -> PRIM_BOOL()
    3 -> PRIM_NIL()
    4 -> PRIM_F64()
    5 -> PRIM_I32()
    6 -> PRIM_I8()
    7 -> PRIM_I16()
    8 -> PRIM_U8()
    9 -> PRIM_U16()
    10 -> PRIM_U32()
    11 -> PRIM_U64()
    12 -> PRIM_ISIZE()
    13 -> PRIM_USIZE()
    _ -> PRIM_F32()
  }
}

fn typed_core_step(
  builder: owned SemanticTypeGraphBuilder,
  current: SemanticTypeId,
  code: usize
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  if code < 15 {
    match builder.primitive(primitive_from_code(code)) {
      (builder, primitive) -> builder.union(current, primitive)
    }
  } else {
    if code < 30 {
      match builder.primitive(primitive_from_code(code - 15)) {
        (builder, primitive) -> builder.intersection(current, primitive)
      }
    } else {
      match code {
        30 -> builder.complement(current)
        31 -> builder.weak(current)
        32 -> builder.atomic(current)
        33 -> builder.unique(current)
        34 -> builder.owned(current)
        35 -> builder.continuation(current, current)
        36 -> builder.pointer(current, SemanticImmutable)
        37 -> builder.pointer(current, SemanticMutable)
        38 -> builder.borrow(current, SemanticImmutable)
        39 -> builder.borrow(current, SemanticMutable)
        40 -> builder.slice(current, SemanticImmutable)
        41 -> builder.slice(current, SemanticMutable)
        42 -> builder.array(current, 4)
        43 -> {
          let parameters = [current]
          match builder.type_list(
            list.from_slice<SemanticTypeId>(parameters[..])
          ) {
            (builder, parameter_types) -> {
              let no_effects: [SemanticTypeId; 0] = []
              match builder.type_list(
                list.from_slice<SemanticTypeId>(no_effects[..])
              ) {
                (builder, effect_types) -> match builder.effect_signature(
                  effect_types,
                  SemanticClosedEffects
                ) {
                  (builder, effects) -> builder.function(
                    parameter_types,
                    current,
                    effects
                  )
                }
              }
            }
          }
        }
        44 -> {
          let names = ["value"]
          let fields = [current]
          builder.record(
            list.from_slice<str>(names[..]),
            list.from_slice<SemanticTypeId>(fields[..]),
            SemanticClosedRecord
          )
        }
        45 -> {
          let names = ["value"]
          let fields = [current]
          builder.record(
            list.from_slice<str>(names[..]),
            list.from_slice<SemanticTypeId>(fields[..]),
            SemanticOpenRecord
          )
        }
        46 -> {
          let fields = [current]
          builder.tuple(list.from_slice<SemanticTypeId>(fields[..]))
        }
        47 -> builder.variant(
          variant_declaration(37, "Generated", "Value"),
          current
        )
        48 -> builder.variable(SemanticParameterVariable(7))
        49 -> builder.variable(SemanticSelfVariable)
        50 -> builder.trait_atom(trait_declaration(37, "Display"))
        51 -> builder.associated(
          current,
          associated_declaration(37, "Iterator", "Item")
        )
        _ -> match builder.top() {
          (builder, top) -> builder.union(current, top)
        }
      }
    }
  }
}

fn typed_core_program(
  builder: owned SemanticTypeGraphBuilder,
  current: SemanticTypeId,
  codes: List<usize>
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match codes {
    Nil -> (builder, current)
    Cons(code, rest) -> match typed_core_step(builder, current, code) {
      (builder, next) -> typed_core_program(builder, next, rest)
    }
  }
}

fn legacy_core_step(current: i64, code: usize) -> i64 {
  if code < 15 {
    ty_union(current, ty_prim(legacy_primitive_from_code(code)))
  } else {
    if code < 30 {
      ty_inter(current, ty_prim(legacy_primitive_from_code(code - 15)))
    } else {
      match code {
        30 -> ty_compl(current)
        31 -> ty_weak(current)
        32 -> ty_arc(current)
        33 -> ty_unique(current)
        34 -> ty_owned(current)
        35 -> ty_continuation(current, current)
        36 -> ty_ptr(current)
        37 -> ty_mut_ptr(current)
        38 -> ty_borrow(current)
        39 -> ty_borrow_mut(current)
        40 -> ty_slice(current)
        41 -> ty_mut_slice(current)
        42 -> ty_array(current, 4)
        43 -> {
          let parameters = nlist_new()
          nlist_add(parameters, current)
          ty_fn(parameters, current, ty_effect_pure())
        }
        44 -> {
          let fields = nlist_new()
          nlist_add(fields, ty_record_field("value".hash(), current, 0, 0))
          ty_record(fields, 0)
        }
        45 -> {
          let fields = nlist_new()
          nlist_add(fields, ty_record_field("value".hash(), current, 0, 0))
          ty_record(fields, 1)
        }
        46 -> {
          let fields = nlist_new()
          nlist_add(fields, current)
          ty_tuple(fields)
        }
        47 -> ty_new(8, "Value".hash(), current, 0, 0)
        48 -> ty_var(7)
        49 -> ty_self()
        50 -> ty_trait("Display".hash())
        51 -> ty_assoc(current, "Item".hash())
        _ -> ty_union(current, ty_any())
      }
    }
  }
}

fn legacy_core_program(current: i64, codes: List<usize>) -> i64 {
  match codes {
    Nil -> current
    Cons(code, rest) -> legacy_core_program(legacy_core_step(current, code), rest)
  }
}

fn graph_primitive_matches_legacy(
  primitive: SemanticPrimitive,
  legacy: i64
) -> bool {
  ty_f1(legacy) == legacy_primitive_from_code(
    __i64_to_usize(
      primitive_code(SemanticPrimitivePresent(primitive)) - 1
    )
  )
}

fn graph_type_list_matches_legacy(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeListId,
  legacy: i64,
  offset: usize
) -> bool {
  let lists = semantic_type_graph_type_lists_local(graph)
  let length = semantic_type_list_len(lists, id)
  if length != __i64_to_usize(nlist_len(legacy)) { false }
  else {
    if offset >= length { true }
    else {
      let edge = semantic_type_list_edge(lists, id, offset)
      graph_core_matches_legacy(
        graph,
        semantic_type_graph_list_type_id(graph, edge),
        nlist_get(legacy, usize_to_i64(offset))
      ) and graph_type_list_matches_legacy(graph, id, legacy, offset + 1)
    }
  }
}

fn graph_record_fields_match_legacy(
  graph: borrow SemanticTypeGraph,
  records: borrow SemanticRecordLocalGraph,
  fields: SemanticRecordFieldListId,
  legacy: i64,
  offset: usize
) -> bool {
  let length = semantic_type_record_field_count(records, fields)
  if length != __i64_to_usize(nlist_len(legacy)) { false }
  else {
    if offset >= length { true }
    else {
      let edge = semantic_type_record_field_edge(records, fields, offset)
      let legacy_field = nlist_get(legacy, usize_to_i64(offset))
      semantic_type_record_field_hash(records, edge) ==
        ty_record_field_hash(legacy_field) and
        graph_core_matches_legacy(
          graph,
          semantic_type_graph_record_field_type_id(graph, edge),
          ty_record_field_type(legacy_field)
        ) and graph_record_fields_match_legacy(
          graph,
          records,
          fields,
          legacy,
          offset + 1
        )
    }
  }
}

fn graph_core_matches_legacy(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId,
  legacy: i64
) -> bool {
  match semantic_type_graph_node(graph, id) {
    SemanticBottomNode -> ty_tag(legacy) == 0
    SemanticTopNode -> ty_tag(legacy) == 1
    SemanticPrimitiveNode(primitive) ->
      ty_tag(legacy) == 2 and graph_primitive_matches_legacy(primitive, legacy)
    SemanticUnionNode(left, right) ->
      ty_tag(legacy) == 3 and graph_core_matches_legacy(
        graph,
        left,
        ty_f1(legacy)
      ) and graph_core_matches_legacy(
        graph,
        right,
        ty_f2(legacy)
      )
    SemanticIntersectionNode(left, right) ->
      ty_tag(legacy) == 4 and graph_core_matches_legacy(
        graph,
        left,
        ty_f1(legacy)
      ) and graph_core_matches_legacy(
        graph,
        right,
        ty_f2(legacy)
      )
    SemanticComplementNode(inner) ->
      ty_tag(legacy) == 5 and graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticContinuationNode(input, result) ->
      ty_tag(legacy) == 14 and graph_core_matches_legacy(
        graph,
        input,
        ty_f1(legacy)
      ) and graph_core_matches_legacy(
        graph,
        result,
        ty_f2(legacy)
      )
    SemanticWeakNode(inner) ->
      ty_tag(legacy) == 16 and graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticAtomicNode(inner) ->
      ty_tag(legacy) == 17 and graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticUniqueNode(inner) ->
      ty_tag(legacy) == 18 and graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticOwnedNode(inner) ->
      ty_tag(legacy) == 19 and graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticPointerNode(inner, mutability) ->
      ty_tag(legacy) == 15 and mutability_code(mutability) == ty_f2(legacy) and
      graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticBorrowNode(inner, mutability) ->
      ty_tag(legacy) == 29 and mutability_code(mutability) == ty_f2(legacy) and
      graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticSliceNode(inner, mutability) ->
      ty_tag(legacy) == 23 and mutability_code(mutability) == ty_f2(legacy) and
      graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticArrayNode(inner, length) ->
      ty_tag(legacy) == 22 and usize_matches_i64(length, ty_f2(legacy)) and
      graph_core_matches_legacy(graph, inner, ty_f1(legacy))
    SemanticFunctionNode(parameters, result, effects) ->
      ty_tag(legacy) == 6 and graph_type_list_matches_legacy(
        graph,
        parameters,
        ty_f1(legacy),
        0
      ) and graph_core_matches_legacy(
        graph,
        result,
        ty_f2(legacy)
      ) and graph_core_matches_legacy(graph, effects, ty_f3(legacy))
    SemanticEffectAtomNode(declaration, arguments) ->
      (ty_tag(legacy) == 11 or ty_tag(legacy) == 25) and
      graph_type_list_matches_legacy(graph, arguments, ty_f2(legacy), 0)
    SemanticEffectSignatureNode(effects, tail) ->
      ty_tag(legacy) == 10 and graph_type_list_matches_legacy(
        graph,
        effects,
        ty_f1(legacy),
        0
      ) and match tail {
        SemanticClosedEffects -> ty_f2(legacy) == 0
        SemanticOpenEffects(id) -> usize_matches_i64(id, ty_f2(legacy))
      }
    SemanticNamedNode(declaration, role, representation, arguments) ->
      ty_tag(legacy) == 9 and graph_core_matches_legacy(
        graph,
        representation,
        ty_f2(legacy)
      ) and graph_type_list_matches_legacy(graph, arguments, ty_f3(legacy), 0)
    SemanticRecordNode(fields, shape, openness) -> {
      let records = semantic_type_graph_records_local(graph)
      ty_tag(legacy) == 7 and match shape {
        SemanticStructuralRecord -> ty_record_tuple_kind(legacy) == 0
        SemanticTupleRecord -> ty_record_tuple_kind(legacy) == 1
      } and match openness {
        SemanticClosedRecord -> ty_record_open(legacy) == 0
        SemanticOpenRecord -> ty_record_open(legacy) == 1
      } and graph_record_fields_match_legacy(
        graph,
        records,
        fields,
        ty_record_fields(legacy),
        0
      )
    }
    SemanticVariantNode(declaration, payload) ->
      ty_tag(legacy) == 8 and graph_core_matches_legacy(
        graph,
        payload,
        ty_f2(legacy)
      )
    SemanticVariableNode(variable) -> ty_tag(legacy) == 12 and match variable {
      SemanticParameterVariable(id) -> usize_matches_i64(id, ty_f1(legacy))
      SemanticSelfVariable -> ty_f1(legacy) == 0 - 1
    }
    SemanticTraitNode(declaration) ->
      ty_tag(legacy) == 13 and declaration_name_hash(declaration) == ty_f1(legacy)
    SemanticAssociatedNode(base, declaration) ->
      ty_tag(legacy) == 21 and graph_core_matches_legacy(
        graph,
        base,
        ty_f1(legacy)
      ) and declaration_name_hash(declaration) == ty_f2(legacy)
  }
}

fn generated_core_graph_matches(codes: List<usize>) -> bool {
  let builder = semantic_type_graph_builder(segment(37))
  match builder.bottom() {
    (builder, bottom) -> match typed_core_program(builder, bottom, codes) {
      (builder, root) -> {
        let graph = builder.freeze()
        graph_core_matches_legacy(graph, root, legacy_core_program(ty_never(), codes))
      }
    }
  }
}

fn shifted_core_codes(codes: List<usize>) -> List<usize> {
  match codes {
    Nil -> Nil<usize>()
    Cons(code, rest) -> Cons<usize>((code + 1) % 52, shifted_core_codes(rest))
  }
}

fn generated_core_equality_matches_legacy(codes: List<usize>) -> bool {
  let shifted = shifted_core_codes(codes)
  let builder = semantic_type_graph_builder(segment(41))
  match builder.bottom() {
    (builder, first_bottom) -> match typed_core_program(
      builder,
      first_bottom,
      codes
    ) {
      (builder, first) -> match builder.bottom() {
        (builder, same_bottom) -> match typed_core_program(
          builder,
          same_bottom,
          codes
        ) {
          (builder, same) -> match builder.bottom() {
            (builder, shifted_bottom) -> match typed_core_program(
              builder,
              shifted_bottom,
              shifted
            ) {
              (builder, different) -> {
                let graph = builder.freeze()
                let catalog = semantic_type_catalog_single(graph)
                let expected = ty_eq(
                  legacy_core_program(ty_never(), codes),
                  legacy_core_program(ty_never(), shifted)
                )
                semantic_type_graph_equal_within_segment(graph, first, same) and
                  required_semantic_hash(catalog, first) ==
                  required_semantic_hash(catalog, same) and
                  semantic_type_graph_equal_within_segment(graph, first, different) ==
                  expected and if expected {
                    required_semantic_hash(catalog, first) ==
                      required_semantic_hash(catalog, different)
                  } else { true }
              }
            }
          }
        }
      }
    }
  }
}

fn semantic_dnf_atoms_match_legacy(
  graph: borrow SemanticTypeGraph,
  atoms: List<SemanticTypeId>,
  legacy: i64,
  offset: i64
) -> bool {
  match atoms {
    Nil -> offset == nlist_len(legacy)
    Cons(atom, rest) -> offset < nlist_len(legacy) and graph_core_matches_legacy(
      graph,
      atom,
      nlist_get(legacy, offset)
    ) and semantic_dnf_atoms_match_legacy(graph, rest, legacy, offset + 1)
  }
}

fn semantic_dnf_matches_legacy_from(
  graph: borrow SemanticTypeGraph,
  positive_clauses: List<List<SemanticTypeId>>,
  negative_clauses: List<List<SemanticTypeId>>,
  legacy: i64,
  offset: i64
) -> bool {
  match (positive_clauses, negative_clauses) {
    (Nil, Nil) -> offset == dnf_len(legacy)
    (
      Cons(positive, remaining_positives),
      Cons(negative, remaining_negatives),
    ) -> {
      if offset >= dnf_len(legacy) { false }
      else {
        let clause = dnf_get(legacy, offset)
        semantic_dnf_atoms_match_legacy(
          graph,
          positive,
          dnf_clause_pos(clause),
          0
        ) and semantic_dnf_atoms_match_legacy(
          graph,
          negative,
          dnf_clause_neg(clause),
          0
        ) and semantic_dnf_matches_legacy_from(
          graph,
          remaining_positives,
          remaining_negatives,
          legacy,
          offset + 1
        )
      }
    }
    _ -> false
  }
}

fn generated_core_dnf_matches_legacy(codes: List<usize>) -> bool {
  let builder = semantic_type_graph_builder(segment(66))
  match builder.bottom() {
    (builder, bottom) -> match typed_core_program(builder, bottom, codes) {
      (builder, root) -> {
        let graph = builder.freeze()
        let catalog = semantic_type_catalog_single(graph)
        let dnf = semantic_type_to_dnf(catalog, root)
        semantic_dnf_matches_legacy_from(
          graph,
          semantic_dnf_positive_clauses(dnf),
          semantic_dnf_negative_clauses(dnf),
          to_dnf(legacy_core_program(ty_never(), codes)),
          0
        )
      }
    }
  }
}

fn semantic_type_is_empty_without_conformance(
  catalog: borrow SemanticTypeCatalog,
  ty: SemanticTypeId
) -> bool {
  handle semantic_type_is_empty(catalog, ty) {
    SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
  }
}

fn semantic_type_is_subtype_without_conformance(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -> bool {
  handle semantic_type_is_subtype(catalog, actual, expected) {
    SemanticConformance.conforms(concrete, trait_declaration) -> resume(false)
  }
}

fn legacy_type_is_empty_without_conformance(ty: i64) -> bool {
  handle ty_is_empty(ty) {
    Conformance.conforms(concrete, trait_atom) -> resume(0)
  }
}

fn legacy_type_is_subtype_without_conformance(
  actual: i64,
  expected: i64
) -> bool {
  handle is_subtype(actual, expected) {
    Conformance.conforms(concrete, trait_atom) -> resume(0)
  }
}

fn generated_core_subtyping_matches_legacy(codes: List<usize>) -> bool {
  let shifted = shifted_core_codes(codes)
  let builder = semantic_type_graph_builder(segment(69))
  match builder.bottom() {
    (builder, first_bottom) -> match typed_core_program(
      builder,
      first_bottom,
      codes
    ) {
      (builder, first) -> match builder.bottom() {
        (builder, second_bottom) -> match typed_core_program(
          builder,
          second_bottom,
          shifted
        ) {
          (builder, second) -> {
            let graph = builder.freeze()
            let catalog = semantic_type_catalog_single(graph)
            let legacy_first = legacy_core_program(ty_never(), codes)
            let legacy_second = legacy_core_program(ty_never(), shifted)
            semantic_type_is_empty_without_conformance(catalog, first) ==
              legacy_type_is_empty_without_conformance(legacy_first) and
              semantic_type_is_subtype_without_conformance(
                catalog,
                first,
                second
              ) == legacy_type_is_subtype_without_conformance(
                legacy_first,
                legacy_second
              ) and semantic_type_is_subtype_without_conformance(
                catalog,
                second,
                first
              ) == legacy_type_is_subtype_without_conformance(
                legacy_second,
                legacy_first
              )
          }
        }
      }
    }
  }
}

fn generated_core_projection_matches_legacy(codes: List<usize>) -> bool {
  let module = anonymous_module_identity_in_package(73, 91)
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  match builder.bottom() {
    (builder, bottom) -> match typed_core_program(builder, bottom, codes) {
      (builder, root) -> {
        let graph = builder.freeze()
        let catalog = semantic_type_catalog_single(graph)
        let context = semantic_type_projection_context(
          module,
          registration_scope(),
          Nil<str>()
        )
        let table = ttable_new()
        let storage = registration_storage(table, registration_scope())
        semantic_type_fact_from_graph(catalog, context, root).render() ==
          semantic_type_fact(
            legacy_core_program(ty_never(), codes),
            table,
            0,
            0,
            storage
          ).render()
      }
    }
  }
}

fn semantic_release_code(kind: SemanticReleaseKind) -> i64 {
  match kind {
    SemanticNoRelease -> 0
    SemanticManagedRelease -> 1
    SemanticClosureRelease -> 2
    SemanticWeakRelease -> 3
  }
}

fn semantic_lane_code(lane: SemanticValueLaneClass) -> i64 {
  match lane {
    SemanticLaneUnavailable -> 0
    SemanticGprLane -> 1
    SemanticF32Lane -> 2
    SemanticF64Lane -> 3
  }
}

fn semantic_union_storage_code(storage: SemanticUnionStorageClass) -> i64 {
  match storage {
    SemanticNotUnionStorage -> 0
    SemanticDeferredUnionStorage -> 0
    SemanticWordUnionStorage -> 1
    SemanticManagedUnionStorage -> 2
    SemanticIncompatibleUnionStorage -> 0 - 1
  }
}

fn semantic_word_count_code(words: Option<usize>) -> i64 {
  match words {
    Some(count) -> match num_scalar_usize_to_i64(count) {
      Some(value) -> value
      None -> 0
    }
    None -> 0
  }
}

fn generated_layout_lanes_match(
  catalog: borrow SemanticTypeCatalog,
  typed: SemanticTypeId,
  legacy: i64,
  lane: i64,
  words: i64
) -> bool {
  if lane >= words { true }
  else {
    semantic_release_code(
      semantic_value_lane_release_kind(catalog, typed, __i64_to_usize(lane))
    ) == ty_value_lane_release_kind(legacy, lane) and
      semantic_lane_code(
        semantic_value_lane_class(catalog, typed, __i64_to_usize(lane))
      ) == ty_value_lane_class(legacy, lane) and generated_layout_lanes_match(
        catalog,
        typed,
        legacy,
        lane + 1,
        words
      )
  }
}

fn generated_core_layout_matches_legacy(codes: List<usize>) -> bool {
  let builder = semantic_type_graph_builder(segment(74))
  match builder.bottom() {
    (builder, bottom) -> match typed_core_program(builder, bottom, codes) {
      (builder, root) -> {
        let graph = builder.freeze()
        let catalog = semantic_type_catalog_single(graph)
        let legacy = legacy_core_program(ty_never(), codes)
        let words = ty_value_storage_word_count(legacy)
        semantic_word_count_code(semantic_value_word_count(catalog, root)) == words and
          semantic_release_code(semantic_field_release_kind(catalog, root)) ==
          ty_field_release_mask_kind(legacy) and semantic_release_code(
            semantic_value_release_kind(catalog, root)
          ) == ty_value_release_kind(legacy) and
          semantic_value_has_release_lane(catalog, root) ==
          (ty_value_has_release_lane(legacy) == 1) and semantic_union_storage_code(
            semantic_union_storage_class(catalog, root)
          ) == ty_union_storage_class(legacy) and semantic_field_may_require_release(
            catalog,
            root
          ) == (ty_field_may_require_release_mask(legacy) == 1) and
          generated_layout_lanes_match(catalog, root, legacy, 0, words)
      }
    }
  }
}

fn semantic_type_is_empty_with_conformance(
  catalog: borrow SemanticTypeCatalog,
  ty: SemanticTypeId,
  conforms: bool
) -> bool {
  handle semantic_type_is_empty(catalog, ty) {
    SemanticConformance.conforms(concrete, trait_declaration) -> resume(conforms)
  }
}

fn generated_empty_substitution_shares_original(codes: List<usize>) -> bool {
  let builder = semantic_type_graph_builder(segment(63))
  match builder.bottom() {
    (builder, bottom) -> match typed_core_program(builder, bottom, codes) {
      (builder, root) -> {
        let graph = builder.freeze()
        let catalog = semantic_type_catalog_single(graph)
        let substitution = semantic_type_substitution_empty()
        let { graph: result_graph, root: result_root } = semantic_type_substitute(
          catalog,
          substitution,
          segment(64),
          segment(65),
          root
        )
        semantic_type_id_eq(result_root, root) and
          semantic_type_graph_len(result_graph) == 0
      }
    }
  }
}

fn required_catalog_insert(
  builder: owned SemanticTypeCatalogBuilder,
  graph: SemanticTypeGraph
) -> owned SemanticTypeCatalogBuilder {
  match builder.insert(graph) {
    SemanticTypeCatalogInserted(next) -> next
    SemanticTypeCatalogDuplicate(next, _) -> {
      next.drop()
      panic("semantic type catalog fixture has a duplicate segment")
    }
  }
}

fn required_semantic_hash(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> i64 {
  match semantic_type_catalog_hash(catalog, id) {
    Some(hash) -> hash
    None -> panic("semantic type hash fixture is outside the catalog")
  }
}

test "dense columns preserve semantic primitive variants" {
  let mut builder = dense_builder<SemanticPrimitive>()
  builder.push(SemanticI64)
  builder.push(SemanticStr)
  let segment = builder.freeze()

  Test.assert_true(match segment.at(dense_index(0)) { SemanticI64 -> true, _ -> false })
  Test.assert_true(match segment.at(dense_index(1)) { SemanticStr -> true, _ -> false })
}

test "semantic type ids use segment identity and insertion ordinal" {
  let identity = segment(7)
  let builder = semantic_type_graph_builder(identity)
  let (builder, bottom) = builder.bottom()
  let (builder, top) = builder.top()

  Test.assert_true(semantic_type_segment_id_eq(semantic_type_id_segment(bottom), identity))
  Test.assert_eq_usize(semantic_type_id_ordinal(bottom), 0)
  Test.assert_eq_usize(semantic_type_id_ordinal(top), 1)
  Test.assert_true(not semantic_type_id_eq(bottom, top))
  let graph = builder.freeze()
  Test.assert_true(
    match semantic_type_graph_node(graph, bottom) {
      SemanticBottomNode -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, top) {
      SemanticTopNode -> true
      _ -> false
    }
  )
}

test "semantic segments compare complete retained module identity" {
  let first = semantic_type_segment_id(named_module_identity("types/core", 7))
  let same = semantic_type_segment_id(named_module_identity("types/core", 7))
  let other_package = semantic_type_segment_id(named_module_identity("types/core", 8))
  let other_module = semantic_type_segment_id(named_module_identity("types/other", 7))

  Test.assert_true(semantic_type_segment_id_eq(first, same))
  Test.assert_true(not semantic_type_segment_id_eq(first, other_package))
  Test.assert_true(not semantic_type_segment_id_eq(first, other_module))
}

test "semantic primitive payloads are typed" {
  let builder = semantic_type_graph_builder(segment(11))
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, boolean) = builder.primitive(SemanticBool)
  let (builder, nil_value) = builder.primitive(SemanticNil)
  let (builder, float64) = builder.primitive(SemanticF64)
  let (builder, integer32) = builder.primitive(SemanticI32)
  let (builder, integer8) = builder.primitive(SemanticI8)
  let (builder, integer16) = builder.primitive(SemanticI16)
  let (builder, unsigned8) = builder.primitive(SemanticU8)
  let (builder, unsigned16) = builder.primitive(SemanticU16)
  let (builder, unsigned32) = builder.primitive(SemanticU32)
  let (builder, unsigned64) = builder.primitive(SemanticU64)
  let (builder, signed_size) = builder.primitive(SemanticIsize)
  let (builder, unsigned_size) = builder.primitive(SemanticUsize)
  let (builder, float32) = builder.primitive(SemanticF32)
  let graph = builder.freeze()

  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, integer)), 1)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, text)), 2)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, boolean)), 3)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, nil_value)), 4)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, float64)), 5)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, integer32)), 6)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, integer8)), 7)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, integer16)), 8)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, unsigned8)), 9)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, unsigned16)), 10)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, unsigned32)), 11)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, unsigned64)), 12)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, signed_size)), 13)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, unsigned_size)), 14)
  Test.assert_eq(primitive_code(semantic_type_graph_primitive(graph, float32)), 15)
  Test.assert_true(
    match semantic_type_graph_node(graph, integer) {
      SemanticPrimitiveNode(SemanticI64) -> true
      _ -> false
    }
  )
}

test "compound semantic nodes retain typed child ids" {
  let builder = semantic_type_graph_builder(segment(13))
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, union) = builder.union(integer, text)
  let (builder, intersection) = builder.intersection(integer, text)
  let (builder, complement) = builder.complement(union)
  let (builder, continuation) = builder.continuation(integer, text)
  let (builder, weak) = builder.weak(union)
  let (builder, atomic) = builder.atomic(union)
  let (builder, unique) = builder.unique(union)
  let (builder, owned) = builder.owned(union)
  let (builder, pointer) = builder.pointer(union, SemanticImmutable)
  let (builder, mutable_pointer) = builder.pointer(union, SemanticMutable)
  let (builder, borrow) = builder.borrow(union, SemanticImmutable)
  let (builder, mutable_borrow) = builder.borrow(union, SemanticMutable)
  let (builder, slice) = builder.slice(union, SemanticImmutable)
  let (builder, mutable_slice) = builder.slice(union, SemanticMutable)
  let (builder, array) = builder.array(union, 4)
  let graph = builder.freeze()

  Test.assert_true(
    match semantic_type_graph_binary(graph, union) {
      SemanticBinaryTypePresent(left, right) ->
        semantic_type_id_eq(left, integer) and semantic_type_id_eq(right, text)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_binary(graph, intersection) {
      SemanticBinaryTypePresent(left, right) ->
        semantic_type_id_eq(left, integer) and semantic_type_id_eq(right, text)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_unary(graph, complement) {
      SemanticUnaryTypePresent(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, union) {
      SemanticUnionNode(left, right) ->
        semantic_type_id_eq(left, integer) and semantic_type_id_eq(right, text)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, intersection) {
      SemanticIntersectionNode(left, right) ->
        semantic_type_id_eq(left, integer) and semantic_type_id_eq(right, text)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, complement) {
      SemanticComplementNode(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, continuation) {
      SemanticContinuationNode(input, result) ->
        semantic_type_id_eq(input, integer) and semantic_type_id_eq(result, text)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, weak) {
      SemanticWeakNode(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, atomic) {
      SemanticAtomicNode(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, unique) {
      SemanticUniqueNode(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, owned) {
      SemanticOwnedNode(inner) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, pointer) {
      SemanticPointerNode(inner, SemanticImmutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, mutable_pointer) {
      SemanticPointerNode(inner, SemanticMutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, borrow) {
      SemanticBorrowNode(inner, SemanticImmutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, mutable_borrow) {
      SemanticBorrowNode(inner, SemanticMutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, slice) {
      SemanticSliceNode(inner, SemanticImmutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, mutable_slice) {
      SemanticSliceNode(inner, SemanticMutable) -> semantic_type_id_eq(inner, union)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(graph, array) {
      SemanticArrayNode(inner, length) -> semantic_type_id_eq(inner, union) and length == 4
      _ -> false
    }
  )
  let local_union = semantic_type_graph_local_id(graph, union)
  let local_graph = semantic_type_graph_local(graph)
  Test.assert_true(
    semantic_type_id_eq(semantic_type_graph_type_id(graph, local_union), union)
  )
  let mutable_pointer_edge = semantic_type_local_graph_mutable_unary(
    local_graph,
    semantic_type_graph_local_id(graph, mutable_pointer)
  )
  Test.assert_true(
    not semantic_type_local_graph_mutable_unary_is_imported(
      local_graph,
      mutable_pointer_edge
    ) and semantic_local_type_id_eq(
      semantic_type_local_graph_mutable_unary_id(local_graph, mutable_pointer_edge),
      local_union
    ) and match semantic_type_local_graph_mutability(local_graph, mutable_pointer_edge) {
      SemanticMutable -> true
      _ -> false
    }
  )
  let array_edge = semantic_type_local_graph_array(
    local_graph,
    semantic_type_graph_local_id(graph, array)
  )
  Test.assert_true(
    not semantic_type_local_graph_array_is_imported(local_graph, array_edge) and
      semantic_local_type_id_eq(
        semantic_type_local_graph_array_id(local_graph, array_edge),
        local_union
      ) and semantic_type_local_graph_array_length(local_graph, array_edge) == 4
  )
  let union_edges = semantic_type_local_graph_binary(local_graph, local_union)
  Test.assert_true(
    not semantic_type_local_graph_binary_left_is_imported(
      local_graph,
      union_edges
    )
  )
  Test.assert_true(
    not semantic_type_local_graph_binary_right_is_imported(
      local_graph,
      union_edges
    )
  )
  Test.assert_true(
    semantic_local_type_id_ordinal(
      semantic_type_local_graph_binary_left_id(local_graph, union_edges)
    ) == semantic_type_id_ordinal(integer) and
      semantic_local_type_id_ordinal(
        semantic_type_local_graph_binary_right_id(local_graph, union_edges)
      ) == semantic_type_id_ordinal(text)
  )
  let local_complement = semantic_type_graph_local_id(graph, complement)
  let complement_edge = semantic_type_local_graph_unary(local_graph, local_complement)
  Test.assert_true(
    not semantic_type_local_graph_unary_is_imported(
      local_graph,
      complement_edge
    )
  )
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_local_graph_unary_id(local_graph, complement_edge),
      local_union
    ) and semantic_type_id_eq(
      semantic_type_graph_unary_type_id(graph, complement_edge),
      union
    )
  )
}

test "kind-specific views reject different shapes" {
  let builder = semantic_type_graph_builder(segment(17))
  let (builder, bottom) = builder.bottom()
  let (builder, integer) = builder.primitive(SemanticI64)
  let graph = builder.freeze()

  Test.assert_true(
    match semantic_type_graph_primitive(graph, bottom) {
      SemanticPrimitiveAbsent -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_binary(graph, integer) {
      SemanticBinaryTypeAbsent -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_unary(graph, integer) {
      SemanticUnaryTypeAbsent -> true
      _ -> false
    }
  )
}

test "a graph rejects ids owned by another segment" {
  let first_builder = semantic_type_graph_builder(segment(19))
  let (first_builder, first) = first_builder.top()
  let first_graph = first_builder.freeze()

  let second_builder = semantic_type_graph_builder(segment(20))
  let (second_builder, second) = second_builder.top()
  let second_graph = second_builder.freeze()

  Test.assert_true(semantic_type_graph_contains(first_graph, first))
  Test.assert_true(not semantic_type_graph_contains(first_graph, second))
  Test.assert_true(semantic_type_graph_contains(second_graph, second))
  Test.assert_true(not semantic_type_graph_contains(second_graph, first))
}

test "cross segment children remain explicit imported ids" {
  let dependency_builder = semantic_type_graph_builder(segment(23))
  let (dependency_builder, dependency_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(24))
  let (root_builder, local_type) = root_builder.primitive(SemanticStr)
  let (root_builder, joined) = root_builder.union(dependency_type, local_type)
  let (root_builder, weak_dependency) = root_builder.weak(dependency_type)
  let (root_builder, pointer_dependency) = root_builder.pointer(
    dependency_type,
    SemanticMutable
  )
  let (root_builder, array_dependency) = root_builder.array(dependency_type, 3)
  let root = root_builder.freeze()
  let root_local = semantic_type_graph_local(root)

  Test.assert_true(semantic_type_graph_contains(dependency, dependency_type))
  Test.assert_true(
    match semantic_type_graph_binary(root, joined) {
      SemanticBinaryTypePresent(left, right) ->
        semantic_type_id_eq(left, dependency_type) and semantic_type_id_eq(right, local_type)
      _ -> false
    }
  )
  let joined_edges = semantic_type_local_graph_binary(
    root_local,
    semantic_type_graph_local_id(root, joined)
  )
  Test.assert_true(
    semantic_type_local_graph_binary_left_is_imported(
      root_local,
      joined_edges
    )
  )
  Test.assert_true(
    not semantic_type_local_graph_binary_right_is_imported(
      root_local,
      joined_edges
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_binary_left_type_id(root, joined_edges),
      dependency_type
    ) and
      semantic_local_type_id_ordinal(
        semantic_type_local_graph_binary_right_id(root_local, joined_edges)
      ) == semantic_type_id_ordinal(local_type)
  )
  let weak_edge = semantic_type_local_graph_unary(
    root_local,
    semantic_type_graph_local_id(root, weak_dependency)
  )
  Test.assert_true(
    semantic_type_local_graph_unary_is_imported(
      root_local,
      weak_edge
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_unary_type_id(root, weak_edge),
      dependency_type
    ) and match semantic_type_graph_node(root, weak_dependency) {
      SemanticWeakNode(inner) -> semantic_type_id_eq(inner, dependency_type)
      _ -> false
    }
  )
  let pointer_edge = semantic_type_local_graph_mutable_unary(
    root_local,
    semantic_type_graph_local_id(root, pointer_dependency)
  )
  Test.assert_true(
    semantic_type_local_graph_mutable_unary_is_imported(root_local, pointer_edge) and
      semantic_type_id_eq(
        semantic_type_graph_mutable_unary_type_id(root, pointer_edge),
        dependency_type
      )
  )
  let array_edge = semantic_type_local_graph_array(
    root_local,
    semantic_type_graph_local_id(root, array_dependency)
  )
  Test.assert_true(
    semantic_type_local_graph_array_is_imported(root_local, array_edge) and
      semantic_type_id_eq(
        semantic_type_graph_array_type_id(root, array_edge),
        dependency_type
      ) and semantic_type_local_graph_array_length(root_local, array_edge) == 3
  )
}

test "semantic lists, callables, and effects retain exact identity" {
  let dependency_builder = semantic_type_graph_builder(segment(25))
  let (dependency_builder, dependency_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(26))
  let (root_builder, local_type) = root_builder.primitive(SemanticStr)
  let empty_values: [SemanticTypeId; 0] = []
  let pair_values = [local_type, dependency_type]
  let (root_builder, empty) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(empty_values[..])
  )
  let (root_builder, pair) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(pair_values[..])
  )
  let state = effect_declaration(26, "State")
  let (root_builder, effect_atom) = root_builder.effect_atom(state, pair)
  let effect_values = [effect_atom]
  let (root_builder, effect_set) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(effect_values[..])
  )
  let (root_builder, closed_effects) = root_builder.effect_signature(
    effect_set,
    SemanticClosedEffects
  )
  let (root_builder, open_effects) = root_builder.effect_signature(
    effect_set,
    SemanticOpenEffects(17)
  )
  let (root_builder, function) = root_builder.function(
    pair,
    dependency_type,
    closed_effects
  )
  let opaque_declaration = type_declaration(26, "OpaqueBox")
  let nominal_declaration = type_declaration(26, "NominalBox")
  let variant_declaration = type_declaration(26, "EmptyCase")
  let (root_builder, opaque) = root_builder.named(
    opaque_declaration,
    SemanticOpaqueType,
    dependency_type,
    pair
  )
  let (root_builder, nominal) = root_builder.named(
    nominal_declaration,
    SemanticNominalType,
    local_type,
    empty
  )
  let (root_builder, payloadless_variant) = root_builder.named(
    variant_declaration,
    SemanticPayloadlessVariantType,
    local_type,
    empty
  )
  let (root_builder, top) = root_builder.top()
  let root = root_builder.freeze()
  let local = semantic_type_graph_local(root)
  let lists = semantic_type_graph_type_lists_local(root)
  let functions = semantic_type_graph_functions_local(root)
  let effects = semantic_type_graph_effects_local(root)
  let named = semantic_type_graph_named_local(root)

  Test.assert_true(semantic_type_graph_contains(dependency, dependency_type))
  Test.assert_eq_usize(semantic_type_list_count(lists), 3)
  Test.assert_eq_usize(semantic_type_list_id_ordinal(empty), 0)
  Test.assert_eq_usize(semantic_type_list_id_ordinal(pair), 1)
  Test.assert_eq_usize(semantic_type_list_len(lists, empty), 0)
  Test.assert_eq_usize(semantic_type_list_len(lists, pair), 2)
  Test.assert_eq_usize(semantic_type_id_ordinal(top), 8)

  let first = semantic_type_list_edge(lists, pair, 0)
  let second = semantic_type_list_edge(lists, pair, 1)
  Test.assert_true(not semantic_type_list_edge_is_imported(lists, first))
  Test.assert_true(semantic_type_list_edge_is_imported(lists, second))
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_list_edge_local_id(lists, first),
      semantic_type_graph_local_id(root, local_type)
    )
  )
  Test.assert_true(
    semantic_type_id_eq(semantic_type_graph_list_type_id(root, first), local_type)
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_list_type_id(root, second),
      dependency_type
    )
  )

  let function_edge = semantic_type_local_graph_function(
    local,
    semantic_type_graph_local_id(root, function)
  )
  Test.assert_eq_usize(
    semantic_type_list_id_ordinal(
      semantic_type_function_parameters(functions, function_edge)
    ),
    semantic_type_list_id_ordinal(pair)
  )
  Test.assert_true(
    semantic_type_function_result_is_imported(functions, function_edge)
  )
  Test.assert_true(
    not semantic_type_function_effects_are_imported(functions, function_edge)
  )
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_function_effects_local_id(functions, function_edge),
      semantic_type_graph_local_id(root, closed_effects)
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_function_result_type_id(root, function_edge),
      dependency_type
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_function_effects_type_id(root, function_edge),
      closed_effects
    )
  )
  Test.assert_true(
    match semantic_type_graph_node(root, function) {
      SemanticFunctionNode(parameters, result, effects) ->
        semantic_type_list_id_ordinal(parameters) ==
        semantic_type_list_id_ordinal(pair) and
        semantic_type_id_eq(result, dependency_type) and
        semantic_type_id_eq(effects, closed_effects)
      _ -> false
    }
  )

  let atom_edge = semantic_type_local_graph_effect_atom(
    local,
    semantic_type_graph_local_id(root, effect_atom)
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_effect_atom_declaration(root, atom_edge),
      state
    )
  )
  Test.assert_eq(
    semantic_type_effect_atom_declaration_hash(effects, atom_edge),
    retained_declaration_identity_hash(state)
  )
  Test.assert_eq_usize(
    semantic_type_list_id_ordinal(
      semantic_type_effect_atom_arguments(effects, atom_edge)
    ),
    semantic_type_list_id_ordinal(pair)
  )

  let closed_edge = semantic_type_local_graph_effect_signature(
    local,
    semantic_type_graph_local_id(root, closed_effects)
  )
  let open_edge = semantic_type_local_graph_effect_signature(
    local,
    semantic_type_graph_local_id(root, open_effects)
  )
  Test.assert_true(not semantic_type_effect_signature_is_open(effects, closed_edge))
  Test.assert_true(semantic_type_effect_signature_is_open(effects, open_edge))
  Test.assert_eq_usize(semantic_type_effect_signature_tail(effects, open_edge), 17)
  Test.assert_eq_usize(
    semantic_type_list_id_ordinal(
      semantic_type_effect_signature_effects(effects, closed_edge)
    ),
    semantic_type_list_id_ordinal(effect_set)
  )
  Test.assert_true(
    match semantic_type_graph_node(root, effect_atom) {
      SemanticEffectAtomNode(declaration, arguments) ->
        declaration_identity_eq(declaration, state) and
        semantic_type_list_id_ordinal(arguments) ==
        semantic_type_list_id_ordinal(pair)
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(root, open_effects) {
      SemanticEffectSignatureNode(values, SemanticOpenEffects(tail)) ->
        semantic_type_list_id_ordinal(values) ==
        semantic_type_list_id_ordinal(effect_set) and tail == 17
      _ -> false
    }
  )

  let opaque_edge = semantic_type_local_graph_named(
    local,
    semantic_type_graph_local_id(root, opaque)
  )
  let nominal_edge = semantic_type_local_graph_named(
    local,
    semantic_type_graph_local_id(root, nominal)
  )
  let variant_edge = semantic_type_local_graph_named(
    local,
    semantic_type_graph_local_id(root, payloadless_variant)
  )
  Test.assert_true(
    match semantic_type_named_role(named, opaque_edge) {
      SemanticOpaqueType -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_named_role(named, nominal_edge) {
      SemanticNominalType -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_named_role(named, variant_edge) {
      SemanticPayloadlessVariantType -> true
      _ -> false
    }
  )
  Test.assert_true(
    semantic_type_named_representation_is_imported(named, opaque_edge)
  )
  Test.assert_true(
    not semantic_type_named_representation_is_imported(named, nominal_edge)
  )
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_named_representation_local_id(named, nominal_edge),
      semantic_type_graph_local_id(root, local_type)
    )
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_named_declaration(root, opaque_edge),
      opaque_declaration
    )
  )
  Test.assert_eq(
    semantic_type_named_declaration_hash(named, opaque_edge),
    retained_declaration_identity_hash(opaque_declaration)
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_named_representation_type_id(root, opaque_edge),
      dependency_type
    )
  )
  Test.assert_eq_usize(
    semantic_type_list_id_ordinal(semantic_type_named_arguments(named, opaque_edge)),
    semantic_type_list_id_ordinal(pair)
  )
  Test.assert_true(
    match semantic_type_graph_node(root, opaque) {
      SemanticNamedNode(
      declaration,
      SemanticOpaqueType,
      representation,
      arguments,
    ) -> declaration_identity_eq(declaration, opaque_declaration) and
        semantic_type_id_eq(representation, dependency_type) and
        semantic_type_list_id_ordinal(arguments) ==
        semantic_type_list_id_ordinal(pair)
      _ -> false
    }
  )
}

test "semantic records preserve exact fields and local traversal" {
  let dependency_builder = semantic_type_graph_builder(segment(27))
  let (dependency_builder, dependency_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(28))
  let (root_builder, local_type) = root_builder.primitive(SemanticStr)
  let record_names = ["title", "count"]
  let record_types = [local_type, dependency_type]
  let (root_builder, closed_record) = root_builder.record(
    list.from_slice<str>(record_names[..]),
    list.from_slice<SemanticTypeId>(record_types[..]),
    SemanticClosedRecord
  )
  let empty_record_names: [str; 0] = []
  let empty_record_types: [SemanticTypeId; 0] = []
  let (root_builder, open_record) = root_builder.record(
    list.from_slice<str>(empty_record_names[..]),
    list.from_slice<SemanticTypeId>(empty_record_types[..]),
    SemanticOpenRecord
  )
  let tuple_values = [dependency_type, local_type]
  let (root_builder, tuple) = root_builder.tuple(
    list.from_slice<SemanticTypeId>(tuple_values[..])
  )
  let empty_tuple_values: [SemanticTypeId; 0] = []
  let (root_builder, empty_tuple) = root_builder.tuple(
    list.from_slice<SemanticTypeId>(empty_tuple_values[..])
  )
  let root = root_builder.freeze()
  let local = semantic_type_graph_local(root)
  let records = semantic_type_graph_records_local(root)

  Test.assert_true(semantic_type_graph_contains(dependency, dependency_type))
  let closed_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(root, closed_record)
  )
  let open_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(root, open_record)
  )
  let tuple_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(root, tuple)
  )
  let empty_tuple_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(root, empty_tuple)
  )

  Test.assert_true(
    match semantic_type_record_shape(records, closed_edge) {
      SemanticStructuralRecord -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_record_openness(records, closed_edge) {
      SemanticClosedRecord -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_record_openness(records, open_edge) {
      SemanticOpenRecord -> true
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_record_shape(records, tuple_edge) {
      SemanticTupleRecord -> true
      _ -> false
    }
  )

  let closed_fields = semantic_type_record_fields(records, closed_edge)
  let open_fields = semantic_type_record_fields(records, open_edge)
  let tuple_fields = semantic_type_record_fields(records, tuple_edge)
  let empty_tuple_fields = semantic_type_record_fields(records, empty_tuple_edge)
  Test.assert_eq_usize(semantic_type_record_field_count(records, closed_fields), 2)
  Test.assert_eq_usize(semantic_type_record_field_count(records, open_fields), 0)
  Test.assert_eq_usize(semantic_type_record_field_count(records, tuple_fields), 2)
  Test.assert_eq_usize(
    semantic_type_record_field_count(records, empty_tuple_fields),
    0
  )

  let title = semantic_type_record_field_edge(records, closed_fields, 0)
  let count = semantic_type_record_field_edge(records, closed_fields, 1)
  Test.assert_true(not semantic_type_record_field_is_imported(records, title))
  Test.assert_true(semantic_type_record_field_is_imported(records, count))
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_record_field_local_id(records, title),
      semantic_type_graph_local_id(root, local_type)
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_record_field_type_id(root, count),
      dependency_type
    )
  )
  Test.assert_true(
    match semantic_type_graph_record_field_name(root, title) {
      SemanticNamedRecordField(name) -> name == "title"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_record_field_name(root, count) {
      SemanticNamedRecordField(name) -> name == "count"
      _ -> false
    }
  )
  Test.assert_eq(
    semantic_type_record_field_hash(records, title),
    "title".hash()
  )
  Test.assert_eq(
    semantic_type_record_field_hash(records, count),
    "count".hash()
  )

  let tuple_first = semantic_type_record_field_edge(records, tuple_fields, 0)
  let tuple_second = semantic_type_record_field_edge(records, tuple_fields, 1)
  Test.assert_true(semantic_type_record_field_is_imported(records, tuple_first))
  Test.assert_true(not semantic_type_record_field_is_imported(records, tuple_second))
  Test.assert_eq(semantic_type_record_field_hash(records, tuple_first), 0 - 1)
  Test.assert_eq(semantic_type_record_field_hash(records, tuple_second), 0 - 2)
  Test.assert_true(
    match semantic_type_graph_record_field_name(root, tuple_first) {
      SemanticTupleRecordField(position) -> position == 0
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_record_field_name(root, tuple_second) {
      SemanticTupleRecordField(position) -> position == 1
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(root, closed_record) {
      SemanticRecordNode(fields, SemanticStructuralRecord, SemanticClosedRecord) ->
        semantic_type_record_field_count(records, fields) == 2
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(root, tuple) {
      SemanticRecordNode(fields, SemanticTupleRecord, SemanticClosedRecord) ->
        semantic_type_record_field_count(records, fields) == 2
      _ -> false
    }
  )
}

test "semantic payload variants retain exact constructor identity" {
  let dependency_builder = semantic_type_graph_builder(segment(35))
  let (dependency_builder, dependency_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(36))
  let (root_builder, local_type) = root_builder.primitive(SemanticStr)
  let local_declaration = variant_declaration(36, "Outcome", "Ready")
  let imported_declaration = variant_declaration(35, "Remote", "Found")
  let (root_builder, local_variant) = root_builder.variant(
    local_declaration,
    local_type
  )
  let (root_builder, imported_variant) = root_builder.variant(
    imported_declaration,
    dependency_type
  )
  let root = root_builder.freeze()
  let local = semantic_type_graph_local(root)
  let variants = semantic_type_graph_variants_local(root)

  Test.assert_true(semantic_type_graph_contains(dependency, dependency_type))
  let local_edge = semantic_type_local_graph_variant(
    local,
    semantic_type_graph_local_id(root, local_variant)
  )
  let imported_edge = semantic_type_local_graph_variant(
    local,
    semantic_type_graph_local_id(root, imported_variant)
  )
  Test.assert_true(
    not semantic_type_variant_payload_is_imported(variants, local_edge)
  )
  Test.assert_true(
    semantic_type_variant_payload_is_imported(variants, imported_edge)
  )
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_variant_payload_local_id(variants, local_edge),
      semantic_type_graph_local_id(root, local_type)
    )
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_variant_declaration(root, local_edge),
      local_declaration
    )
  )
  Test.assert_eq(
    semantic_type_variant_declaration_hash(variants, local_edge),
    retained_declaration_identity_hash(local_declaration)
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_variant_declaration(root, imported_edge),
      imported_declaration
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_variant_payload_type_id(root, imported_edge),
      dependency_type
    )
  )
  Test.assert_true(
    match semantic_type_graph_node(root, imported_variant) {
      SemanticVariantNode(declaration, payload) -> declaration_identity_eq(
        declaration,
        imported_declaration
      ) and semantic_type_id_eq(payload, dependency_type)
      _ -> false
    }
  )
}

test "semantic variables traits and associated projections retain typed identity" {
  let dependency_builder = semantic_type_graph_builder(segment(38))
  let (dependency_builder, dependency_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(39))
  let (root_builder, local_type) = root_builder.primitive(SemanticStr)
  let parameter_value = SemanticParameterVariable(7)
  let (root_builder, parameter) = root_builder.variable(parameter_value)
  let (root_builder, self_type) = root_builder.variable(SemanticSelfVariable)
  let trait_identity = trait_declaration(39, "Iterable")
  let associated_identity = associated_declaration(39, "Iterable", "Item")
  let imported_associated_identity = associated_declaration(
    38,
    "RemoteIterable",
    "RemoteItem"
  )
  let (root_builder, trait_atom) = root_builder.trait_atom(trait_identity)
  let (root_builder, local_associated) = root_builder.associated(
    local_type,
    associated_identity
  )
  let (root_builder, imported_associated) = root_builder.associated(
    dependency_type,
    imported_associated_identity
  )
  let root = root_builder.freeze()
  let local = semantic_type_graph_local(root)
  let variables = semantic_type_graph_variables_local(root)
  let traits = semantic_type_graph_traits_local(root)
  let associated = semantic_type_graph_associated_local(root)

  Test.assert_true(semantic_type_graph_contains(dependency, dependency_type))
  let parameter_edge = semantic_type_local_graph_variable(
    local,
    semantic_type_graph_local_id(root, parameter)
  )
  let self_edge = semantic_type_local_graph_variable(
    local,
    semantic_type_graph_local_id(root, self_type)
  )
  Test.assert_true(
    match semantic_type_variable_value(variables, parameter_edge) {
      SemanticParameterVariable(id) -> id == 7
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_variable_value(variables, self_edge) {
      SemanticSelfVariable -> true
      _ -> false
    }
  )

  let trait_edge = semantic_type_local_graph_trait(
    local,
    semantic_type_graph_local_id(root, trait_atom)
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_trait_declaration(root, trait_edge),
      trait_identity
    )
  )
  Test.assert_eq(
    semantic_type_trait_declaration_hash(traits, trait_edge),
    retained_declaration_identity_hash(trait_identity)
  )

  let local_associated_edge = semantic_type_local_graph_associated(
    local,
    semantic_type_graph_local_id(root, local_associated)
  )
  let imported_associated_edge = semantic_type_local_graph_associated(
    local,
    semantic_type_graph_local_id(root, imported_associated)
  )
  Test.assert_true(
    not semantic_type_associated_base_is_imported(
      associated,
      local_associated_edge
    )
  )
  Test.assert_true(
    semantic_type_associated_base_is_imported(
      associated,
      imported_associated_edge
    )
  )
  Test.assert_true(
    semantic_local_type_id_eq(
      semantic_type_associated_base_local_id(associated, local_associated_edge),
      semantic_type_graph_local_id(root, local_type)
    )
  )
  Test.assert_true(
    semantic_type_id_eq(
      semantic_type_graph_associated_base_type_id(
        root,
        imported_associated_edge
      ),
      dependency_type
    )
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_associated_declaration(root, local_associated_edge),
      associated_identity
    )
  )
  Test.assert_eq(
    semantic_type_associated_declaration_hash(
      associated,
      local_associated_edge
    ),
    retained_declaration_identity_hash(associated_identity)
  )
  Test.assert_true(
    declaration_identity_eq(
      semantic_type_graph_associated_declaration(
        root,
        imported_associated_edge
      ),
      imported_associated_identity
    )
  )
  Test.assert_true(
    match semantic_type_graph_node(root, parameter) {
      SemanticVariableNode(SemanticParameterVariable(id)) -> id == 7
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(root, trait_atom) {
      SemanticTraitNode(declaration) -> declaration_identity_eq(
        declaration,
        trait_identity
      )
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_graph_node(root, imported_associated) {
      SemanticAssociatedNode(base, declaration) -> semantic_type_id_eq(
        base,
        dependency_type
      ) and declaration_identity_eq(declaration, imported_associated_identity)
      _ -> false
    }
  )
}

test "semantic graph equality preserves structural and nominal laws" {
  let dependency_builder = semantic_type_graph_builder(segment(44))
  let (dependency_builder, external_type) = dependency_builder.primitive(SemanticI64)
  let dependency = dependency_builder.freeze()
  let builder = semantic_type_graph_builder(segment(42))
  let (builder, i64_type) = builder.primitive(SemanticI64)
  let (builder, another_i64) = builder.primitive(SemanticI64)
  let (builder, str_type) = builder.primitive(SemanticStr)
  let empty_values: [SemanticTypeId; 0] = []
  let (builder, empty) = builder.type_list(
    list.from_slice<SemanticTypeId>(empty_values[..])
  )

  let first_names = ["left", "right"]
  let first_types = [i64_type, str_type]
  let (builder, first_record) = builder.record(
    list.from_slice<str>(first_names[..]),
    list.from_slice<SemanticTypeId>(first_types[..]),
    SemanticClosedRecord
  )
  let reversed_names = ["right", "left"]
  let reversed_types = [str_type, another_i64]
  let (builder, reversed_record) = builder.record(
    list.from_slice<str>(reversed_names[..]),
    list.from_slice<SemanticTypeId>(reversed_types[..]),
    SemanticClosedRecord
  )
  let tuple_values = [i64_type, str_type]
  let (builder, first_tuple) = builder.tuple(
    list.from_slice<SemanticTypeId>(tuple_values[..])
  )
  let reversed_tuple_values = [str_type, another_i64]
  let (builder, reversed_tuple) = builder.tuple(
    list.from_slice<SemanticTypeId>(reversed_tuple_values[..])
  )

  let state = effect_declaration(42, "State")
  let log = effect_declaration(42, "Log")
  let (builder, state_atom) = builder.effect_atom(state, empty)
  let (builder, log_atom) = builder.effect_atom(log, empty)
  let forward_effect_values = [state_atom, log_atom]
  let (builder, forward_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(forward_effect_values[..])
  )
  let reversed_effect_values = [log_atom, state_atom]
  let (builder, reversed_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(reversed_effect_values[..])
  )
  let (builder, first_signature) = builder.effect_signature(
    forward_effects,
    SemanticClosedEffects
  )
  let (builder, reversed_signature) = builder.effect_signature(
    reversed_effects,
    SemanticClosedEffects
  )
  let duplicated_state_values = [state_atom, state_atom]
  let (builder, duplicated_state_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(duplicated_state_values[..])
  )
  let (builder, duplicated_state_signature) = builder.effect_signature(
    duplicated_state_effects,
    SemanticClosedEffects
  )
  let state_only_values = [state_atom]
  let (builder, state_only_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(state_only_values[..])
  )
  let (builder, state_only_signature) = builder.effect_signature(
    state_only_effects,
    SemanticClosedEffects
  )
  let (builder, first_open_signature) = builder.effect_signature(
    forward_effects,
    SemanticOpenEffects(3)
  )
  let (builder, other_open_signature) = builder.effect_signature(
    reversed_effects,
    SemanticOpenEffects(4)
  )

  let box_identity = type_declaration(42, "Box")
  let other_box_identity = type_declaration(43, "Box")
  let (builder, first_opaque) = builder.named(
    box_identity,
    SemanticOpaqueType,
    i64_type,
    empty
  )
  let (builder, same_opaque) = builder.named(
    box_identity,
    SemanticOpaqueType,
    str_type,
    empty
  )
  let (builder, other_opaque) = builder.named(
    other_box_identity,
    SemanticOpaqueType,
    i64_type,
    empty
  )
  let (builder, first_nominal) = builder.named(
    box_identity,
    SemanticNominalType,
    i64_type,
    empty
  )
  let (builder, other_nominal) = builder.named(
    box_identity,
    SemanticNominalType,
    str_type,
    empty
  )
  let (builder, empty_i64_array) = builder.array(i64_type, 0)
  let (builder, empty_str_array) = builder.array(str_type, 0)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)

  Test.assert_true(
    semantic_type_graph_equal_within_segment(graph, i64_type, another_i64)
  )
  Test.assert_true(semantic_type_graph_contains(dependency, external_type))
  Test.assert_false(
    semantic_type_graph_equal_within_segment(graph, external_type, external_type)
  )
  Test.assert_true(
    semantic_type_graph_equal_within_segment(
      graph,
      first_record,
      reversed_record
    )
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(
      graph,
      first_tuple,
      reversed_tuple
    )
  )
  Test.assert_true(
    semantic_type_graph_equal_within_segment(
      graph,
      first_signature,
      reversed_signature
    )
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(
      graph,
      duplicated_state_signature,
      first_signature
    )
  )
  Test.assert_true(
    semantic_type_graph_equal_within_segment(
      graph,
      duplicated_state_signature,
      state_only_signature
    )
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(
      graph,
      first_open_signature,
      other_open_signature
    )
  )
  Test.assert_true(
    semantic_type_graph_equal_within_segment(graph, first_opaque, same_opaque)
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(graph, first_opaque, other_opaque)
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(graph, first_nominal, other_nominal)
  )
  Test.assert_true(
    semantic_type_graph_equal_within_segment(
      graph,
      empty_i64_array,
      empty_str_array
    )
  )
  Test.assert_eq(
    required_semantic_hash(catalog, i64_type),
    required_semantic_hash(catalog, another_i64)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, first_record),
    required_semantic_hash(catalog, reversed_record)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, first_signature),
    required_semantic_hash(catalog, reversed_signature)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, duplicated_state_signature),
    required_semantic_hash(catalog, state_only_signature)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, first_opaque),
    required_semantic_hash(catalog, same_opaque)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, empty_i64_array),
    required_semantic_hash(catalog, empty_str_array)
  )
}

test "semantic type catalogs resolve exact frozen segments" {
  let first_builder = semantic_type_graph_builder(segment(45))
  let (first_builder, first_type) = first_builder.primitive(SemanticI64)
  let first = first_builder.freeze()
  let second_builder = semantic_type_graph_builder(segment(46))
  let (second_builder, second_type) = second_builder.primitive(SemanticStr)
  let second = second_builder.freeze()
  let duplicate_builder = semantic_type_graph_builder(segment(45))
  let (duplicate_builder, duplicate_type) = duplicate_builder.primitive(SemanticBool)
  let duplicate = duplicate_builder.freeze()
  let missing_builder = semantic_type_graph_builder(segment(47))
  let (missing_builder, missing_type) = missing_builder.primitive(SemanticNil)
  let missing = missing_builder.freeze()

  let builder = semantic_type_catalog_builder(3)
    |> required_catalog_insert(first)
    |> required_catalog_insert(second)
  match builder.insert(duplicate) {
    SemanticTypeCatalogDuplicate(builder, id) -> {
      let catalog = builder.freeze()
      Test.assert_true(
        semantic_type_segment_id_eq(id, semantic_type_id_segment(first_type))
      )
      Test.assert_eq_usize(catalog.len(), 2)
      Test.assert_true(
        match catalog.graph_for(first_type) {
          Some(graph) -> semantic_type_graph_contains(graph, first_type)
          None -> false
        }
      )
      Test.assert_true(
        match catalog.graph_for(second_type) {
          Some(graph) -> semantic_type_graph_contains(graph, second_type)
          None -> false
        }
      )
      Test.assert_true(
        match catalog.graph_for(missing_type) {
          Some(_) -> false
          None -> true
        }
      )
      Test.assert_false(
        semantic_type_catalog_equal(catalog, missing_type, missing_type)
      )
      Test.assert_true(
        match semantic_type_catalog_hash(catalog, missing_type) {
          Some(_) -> false
          None -> true
        }
      )
      Test.assert_true(semantic_type_graph_contains(duplicate, duplicate_type))
      Test.assert_true(semantic_type_graph_contains(missing, missing_type))
    }
    SemanticTypeCatalogInserted(builder) -> {
      builder.drop()
      Test.assert_true(false)
    }
  }
}

test "semantic graph equality resolves distinct imported ids through the catalog" {
  let left_builder = semantic_type_graph_builder(segment(48))
  let (left_builder, left_leaf) = left_builder.primitive(SemanticI64)
  let left_graph = left_builder.freeze()
  let right_builder = semantic_type_graph_builder(segment(49))
  let (right_builder, right_leaf) = right_builder.primitive(SemanticI64)
  let (right_builder, right_other) = right_builder.primitive(SemanticStr)
  let right_graph = right_builder.freeze()
  let root_builder = semantic_type_graph_builder(segment(50))
  let (root_builder, left_weak) = root_builder.weak(left_leaf)
  let (root_builder, right_weak) = root_builder.weak(right_leaf)
  let root_graph = root_builder.freeze()

  let catalog_builder = semantic_type_catalog_builder(3)
    |> required_catalog_insert(left_graph)
    |> required_catalog_insert(right_graph)
    |> required_catalog_insert(root_graph)
  let catalog = catalog_builder.freeze()
  Test.assert_true(semantic_type_catalog_equal(catalog, left_leaf, right_leaf))
  Test.assert_false(semantic_type_catalog_equal(catalog, left_leaf, right_other))
  Test.assert_true(semantic_type_catalog_equal(catalog, left_weak, right_weak))
  Test.assert_eq(
    required_semantic_hash(catalog, left_leaf),
    required_semantic_hash(catalog, right_leaf)
  )
  Test.assert_eq(
    required_semantic_hash(catalog, left_weak),
    required_semantic_hash(catalog, right_weak)
  )
  Test.assert_false(
    semantic_type_graph_equal_within_segment(
      root_graph,
      left_weak,
      right_weak
    )
  )
}

test "semantic graph substitution publishes canonical shared structure" {
  let builder = semantic_type_graph_builder(segment(51))
  let (builder, parameter) = builder.variable(SemanticParameterVariable(0))
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, boolean) = builder.primitive(SemanticBool)
  let empty_values: [SemanticTypeId; 0] = []
  let (builder, empty) = builder.type_list(
    list.from_slice<SemanticTypeId>(empty_values[..])
  )

  let (builder, union) = builder.union(parameter, text)
  let (builder, intersection) = builder.intersection(parameter, boolean)
  let (builder, complement) = builder.complement(parameter)
  let (builder, continuation) = builder.continuation(parameter, union)
  let (builder, weak) = builder.weak(parameter)
  let (builder, atomic) = builder.atomic(parameter)
  let (builder, unique) = builder.unique(parameter)
  let (builder, owned) = builder.owned(parameter)
  let (builder, pointer) = builder.pointer(parameter, SemanticMutable)
  let (builder, borrowed) = builder.borrow(parameter, SemanticImmutable)
  let (builder, slice) = builder.slice(parameter, SemanticMutable)
  let (builder, array) = builder.array(parameter, 4)
  let tuple_values = [
    pointer,
    borrowed,
    slice,
    array,
    weak,
    atomic,
    unique,
    owned,
    intersection,
    complement,
  ]
  let (builder, tuple) = builder.tuple(
    list.from_slice<SemanticTypeId>(tuple_values[..])
  )

  let record_names = ["value", "stable"]
  let record_values = [parameter, text]
  let (builder, record) = builder.record(
    list.from_slice<str>(record_names[..]),
    list.from_slice<SemanticTypeId>(record_values[..]),
    SemanticClosedRecord
  )
  let type_arguments = [parameter]
  let (builder, type_argument_list) = builder.type_list(
    list.from_slice<SemanticTypeId>(type_arguments[..])
  )
  let box_declaration = type_declaration(51, "Box")
  let (builder, named) = builder.named(
    box_declaration,
    SemanticNominalType,
    record,
    type_argument_list
  )
  let option_declaration = variant_declaration(51, "Option", "Some")
  let (builder, variant) = builder.variant(option_declaration, parameter)
  let display_declaration = trait_declaration(51, "Display")
  let (builder, trait_atom) = builder.trait_atom(display_declaration)
  let item_declaration = associated_declaration(51, "Iterator", "Item")
  let (builder, associated) = builder.associated(parameter, item_declaration)

  let state_declaration = effect_declaration(51, "State")
  let log_declaration = effect_declaration(51, "Log")
  let (builder, state_parameter) = builder.effect_atom(
    state_declaration,
    type_argument_list
  )
  let explicit_effect_values = [state_parameter]
  let (builder, explicit_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(explicit_effect_values[..])
  )
  let (builder, open_effects) = builder.effect_signature(
    explicit_effects,
    SemanticOpenEffects(1)
  )

  let integer_arguments = [integer]
  let (builder, integer_argument_list) = builder.type_list(
    list.from_slice<SemanticTypeId>(integer_arguments[..])
  )
  let (builder, state_integer) = builder.effect_atom(
    state_declaration,
    integer_argument_list
  )
  let (builder, log) = builder.effect_atom(log_declaration, empty)
  let binding_effect_values = [state_integer, log]
  let (builder, binding_effects) = builder.type_list(
    list.from_slice<SemanticTypeId>(binding_effect_values[..])
  )
  let (builder, effect_binding) = builder.effect_signature(
    binding_effects,
    SemanticClosedEffects
  )

  let parameter_values = [named, tuple, variant, trait_atom, associated]
  let (builder, parameters) = builder.type_list(
    list.from_slice<SemanticTypeId>(parameter_values[..])
  )
  let (builder, function) = builder.function(
    parameters,
    continuation,
    open_effects
  )

  let (builder, expected_union) = builder.union(integer, text)
  let (builder, expected_intersection) = builder.intersection(integer, boolean)
  let (builder, expected_complement) = builder.complement(integer)
  let (builder, expected_continuation) = builder.continuation(
    integer,
    expected_union
  )
  let (builder, expected_weak) = builder.weak(integer)
  let (builder, expected_atomic) = builder.atomic(integer)
  let (builder, expected_unique) = builder.unique(integer)
  let (builder, expected_owned) = builder.owned(integer)
  let (builder, expected_pointer) = builder.pointer(integer, SemanticMutable)
  let (builder, expected_borrowed) = builder.borrow(
    integer,
    SemanticImmutable
  )
  let (builder, expected_slice) = builder.slice(integer, SemanticMutable)
  let (builder, expected_array) = builder.array(integer, 4)
  let expected_tuple_values = [
    expected_pointer,
    expected_borrowed,
    expected_slice,
    expected_array,
    expected_weak,
    expected_atomic,
    expected_unique,
    expected_owned,
    expected_intersection,
    expected_complement,
  ]
  let (builder, expected_tuple) = builder.tuple(
    list.from_slice<SemanticTypeId>(expected_tuple_values[..])
  )
  let expected_record_values = [integer, text]
  let (builder, expected_record) = builder.record(
    list.from_slice<str>(record_names[..]),
    list.from_slice<SemanticTypeId>(expected_record_values[..]),
    SemanticClosedRecord
  )
  let (builder, expected_named) = builder.named(
    box_declaration,
    SemanticNominalType,
    expected_record,
    integer_argument_list
  )
  let (builder, expected_variant) = builder.variant(
    option_declaration,
    integer
  )
  let (builder, expected_associated) = builder.associated(
    integer,
    item_declaration
  )
  let expected_parameter_values = [
    expected_named,
    expected_tuple,
    expected_variant,
    trait_atom,
    expected_associated,
  ]
  let (builder, expected_parameters) = builder.type_list(
    list.from_slice<SemanticTypeId>(expected_parameter_values[..])
  )
  let (builder, expected_function) = builder.function(
    expected_parameters,
    expected_continuation,
    effect_binding
  )
  let (builder, renamed_tail) = builder.variable(SemanticParameterVariable(7))
  let source_graph = builder.freeze()
  let source_catalog = semantic_type_catalog_single(source_graph)

  let substitution = semantic_type_substitution_empty()
    |> semantic_type_substitution_bind(SemanticParameterVariable(0), integer)
    |> semantic_type_substitution_bind(
      SemanticParameterVariable(1),
      effect_binding
    )
    |> semantic_type_substitution_bind(SemanticParameterVariable(0), boolean)
  let {
    graph: result_graph,
      root: result_root,
  } = semantic_type_substitute(
    source_catalog,
    substitution,
    segment(52),
    segment(53),
    function
  )
  let result_catalog = semantic_type_catalog_with_graph(
    source_catalog,
    result_graph
  )
  let result_lists = semantic_type_graph_type_lists_local(result_graph)
  Test.assert_true(
    semantic_type_catalog_equal(
      result_catalog,
      result_root,
      expected_function
    )
  )
  Test.assert_true(
    match semantic_type_graph_node(result_graph, result_root) {
      SemanticFunctionNode(_, _, result_effects) -> match semantic_type_graph_node(
        result_graph,
        result_effects
      ) {
        SemanticEffectSignatureNode(effects, SemanticClosedEffects) ->
          semantic_type_list_len(
            result_lists,
            effects
          ) == 2
        _ -> false
      }
      _ -> false
    }
  )

  let rename_substitution = semantic_type_substitution_empty()
    |> semantic_type_substitution_bind(SemanticParameterVariable(0), integer)
    |> semantic_type_substitution_bind(
      SemanticParameterVariable(1),
      renamed_tail
    )
  let {
    graph: renamed_graph,
      root: renamed_root,
  } = semantic_type_substitute(
    source_catalog,
    rename_substitution,
    segment(54),
    segment(55),
    open_effects
  )
  let renamed_lists = semantic_type_graph_type_lists_local(renamed_graph)
  Test.assert_true(
    match semantic_type_graph_node(renamed_graph, renamed_root) {
      SemanticEffectSignatureNode(effects, SemanticOpenEffects(id)) ->
        id == 7 and semantic_type_list_len(
          renamed_lists,
          effects
        ) == 1
      _ -> false
    }
  )

  let associated_substitution = semantic_type_substitution_empty()
    |> semantic_type_substitution_bind_associated(
      SemanticParameterVariable(0),
      item_declaration,
      boolean
    )
  let {
    graph: associated_graph,
      root: associated_root,
  } = semantic_type_substitute(
    source_catalog,
    associated_substitution,
    segment(56),
    segment(57),
    associated
  )
  Test.assert_true(semantic_type_id_eq(associated_root, boolean))
  Test.assert_eq_usize(semantic_type_graph_len(associated_graph), 0)

  let unchanged_substitution = semantic_type_substitution_empty()
  let {
    graph: unchanged_graph,
      root: unchanged_root,
  } = semantic_type_substitute(
    source_catalog,
    unchanged_substitution,
    segment(58),
    segment(59),
    text
  )
  Test.assert_true(semantic_type_id_eq(unchanged_root, text))
  Test.assert_eq_usize(semantic_type_graph_len(unchanged_graph), 0)
}

test "semantic self variables substitute directly" {
  let builder = semantic_type_graph_builder(segment(60))
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, self_type) = builder.variable(SemanticSelfVariable)
  let source_graph = builder.freeze()
  let source_catalog = semantic_type_catalog_single(source_graph)
  let substitution = semantic_type_substitution_empty()
    |> semantic_type_substitution_bind(SemanticSelfVariable, text)
  let { graph: result_graph, root: result_root } = semantic_type_substitute(
    source_catalog,
    substitution,
    segment(61),
    segment(62),
    self_type
  )

  Test.assert_true(semantic_type_id_eq(result_root, text))
  Test.assert_eq_usize(semantic_type_graph_len(result_graph), 0)
}

test "semantic DNF resolves imported atoms and distributes complements" {
  let dependency_builder = semantic_type_graph_builder(segment(67))
  let (dependency_builder, integer) = dependency_builder.primitive(SemanticI64)
  let dependency_graph = dependency_builder.freeze()

  let root_builder = semantic_type_graph_builder(segment(68))
  let (root_builder, text) = root_builder.primitive(SemanticStr)
  let (root_builder, either) = root_builder.union(integer, text)
  let (root_builder, neither) = root_builder.complement(either)
  let (root_builder, bottom) = root_builder.bottom()
  let (root_builder, top) = root_builder.top()
  let (root_builder, not_bottom) = root_builder.complement(bottom)
  let (root_builder, not_top) = root_builder.complement(top)
  let root_graph = root_builder.freeze()
  let catalog = required_catalog_insert(
    required_catalog_insert(
      semantic_type_catalog_builder(2),
      dependency_graph
    ),
    root_graph
  ).freeze()

  let either_dnf = semantic_type_to_dnf(catalog, either)
  Test.assert_eq_usize(semantic_dnf_clause_count(either_dnf), 2)
  Test.assert_true(
    match (
      semantic_dnf_positive_clauses(either_dnf),
      semantic_dnf_negative_clauses(either_dnf),
    ) {
      (
      Cons(Cons(first, Nil), Cons(Cons(second, Nil), Nil)),
      Cons(Nil, Cons(Nil, Nil)),
    ) -> semantic_type_id_eq(first, integer) and
        semantic_type_id_eq(second, text)
      _ -> false
    }
  )

  let neither_dnf = semantic_type_to_dnf(catalog, neither)
  Test.assert_eq_usize(semantic_dnf_clause_count(neither_dnf), 1)
  Test.assert_true(
    match (
      semantic_dnf_positive_clauses(neither_dnf),
      semantic_dnf_negative_clauses(neither_dnf),
    ) {
      (
      Cons(Nil, Nil),
      Cons(Cons(first, Cons(second, Nil)), Nil),
    ) -> semantic_type_id_eq(first, integer) and
        semantic_type_id_eq(second, text)
      _ -> false
    }
  )
  Test.assert_eq_usize(
    semantic_dnf_clause_count(semantic_type_to_dnf(catalog, bottom)),
    0
  )
  Test.assert_eq_usize(
    semantic_dnf_clause_count(semantic_type_to_dnf(catalog, top)),
    1
  )
  Test.assert_eq_usize(
    semantic_dnf_clause_count(semantic_type_to_dnf(catalog, not_bottom)),
    1
  )
  Test.assert_eq_usize(
    semantic_dnf_clause_count(semantic_type_to_dnf(catalog, not_top)),
    0
  )
}

test "semantic emptiness consults exact trait conformance" {
  let builder = semantic_type_graph_builder(segment(70))
  let (builder, integer) = builder.primitive(SemanticI64)
  let display_declaration = trait_declaration(70, "Display")
  let (builder, display) = builder.trait_atom(display_declaration)
  let (builder, implements_display) = builder.intersection(integer, display)
  let (builder, not_display) = builder.complement(display)
  let (builder, excludes_display) = builder.intersection(integer, not_display)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)

  Test.assert_true(
    semantic_type_is_empty_with_conformance(
      catalog,
      implements_display,
      false
    )
  )
  Test.assert_false(
    semantic_type_is_empty_with_conformance(
      catalog,
      implements_display,
      true
    )
  )
  Test.assert_false(
    semantic_type_is_empty_with_conformance(
      catalog,
      excludes_display,
      false
    )
  )
  Test.assert_true(
    semantic_type_is_empty_with_conformance(
      catalog,
      excludes_display,
      true
    )
  )
}

test "semantic subtyping preserves record and indexed set laws" {
  let builder = semantic_type_graph_builder(segment(71))
  let (builder, bottom) = builder.bottom()
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, boolean) = builder.primitive(SemanticBool)
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, disjoint_primitives) = builder.intersection(integer, text)

  let actual_names = ["x", "y"]
  let actual_types = [integer, text]
  let expected_names = ["x"]
  let expected_types = [integer]
  let empty_types = [bottom]
  let (builder, closed_actual) = builder.record(
    list.from_slice<str>(actual_names[..]),
    list.from_slice<SemanticTypeId>(actual_types[..]),
    SemanticClosedRecord
  )
  let (builder, open_expected) = builder.record(
    list.from_slice<str>(expected_names[..]),
    list.from_slice<SemanticTypeId>(expected_types[..]),
    SemanticOpenRecord
  )
  let (builder, closed_expected) = builder.record(
    list.from_slice<str>(expected_names[..]),
    list.from_slice<SemanticTypeId>(expected_types[..]),
    SemanticClosedRecord
  )
  let (builder, empty_record) = builder.record(
    list.from_slice<str>(expected_names[..]),
    list.from_slice<SemanticTypeId>(empty_types[..]),
    SemanticOpenRecord
  )

  let (builder, empty_array) = builder.array(bottom, 0)
  let (builder, impossible_array) = builder.array(bottom, 1)
  let (builder, bool_array) = builder.array(boolean, 2)
  let (builder, int_array) = builder.array(integer, 2)
  let (builder, long_array) = builder.array(integer, 3)
  let (builder, bool_slice) = builder.slice(boolean, SemanticImmutable)
  let (builder, int_slice) = builder.slice(integer, SemanticImmutable)
  let (builder, mutable_bool_slice) = builder.slice(boolean, SemanticMutable)
  let (builder, mutable_int_slice) = builder.slice(integer, SemanticMutable)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)

  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, boolean, integer)
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(catalog, integer, boolean)
  )
  Test.assert_true(
    semantic_type_is_empty_without_conformance(catalog, disjoint_primitives)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(
      catalog,
      closed_actual,
      open_expected
    )
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      closed_actual,
      closed_expected
    )
  )
  Test.assert_true(
    semantic_type_is_empty_without_conformance(catalog, empty_record)
  )
  Test.assert_false(
    semantic_type_is_empty_without_conformance(catalog, empty_array)
  )
  Test.assert_true(
    semantic_type_is_empty_without_conformance(catalog, impossible_array)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, bool_array, int_array)
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(catalog, bool_array, long_array)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, bool_slice, int_slice)
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      mutable_bool_slice,
      mutable_int_slice
    )
  )
}

test "semantic callable and ownership subtyping keeps variance explicit" {
  let builder = semantic_type_graph_builder(segment(72))
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, boolean) = builder.primitive(SemanticBool)
  let no_values: [SemanticTypeId; 0] = []
  let (builder, empty) = builder.type_list(
    list.from_slice<SemanticTypeId>(no_values[..])
  )
  let (builder, pure) = builder.effect_signature(empty, SemanticClosedEffects)
  let io_declaration = effect_declaration(72, "IO")
  let (builder, io) = builder.effect_atom(io_declaration, empty)
  let io_values = [io]
  let (builder, io_list) = builder.type_list(
    list.from_slice<SemanticTypeId>(io_values[..])
  )
  let (builder, io_effects) = builder.effect_signature(
    io_list,
    SemanticClosedEffects
  )
  let (builder, open_effects) = builder.effect_signature(
    empty,
    SemanticOpenEffects(0)
  )
  let integer_values = [integer]
  let boolean_values = [boolean]
  let (builder, integer_parameters) = builder.type_list(
    list.from_slice<SemanticTypeId>(integer_values[..])
  )
  let (builder, boolean_parameters) = builder.type_list(
    list.from_slice<SemanticTypeId>(boolean_values[..])
  )
  let (builder, narrow_function) = builder.function(
    integer_parameters,
    boolean,
    pure
  )
  let (builder, wide_function) = builder.function(
    boolean_parameters,
    integer,
    pure
  )
  let (builder, effectful_function) = builder.function(
    integer_parameters,
    boolean,
    io_effects
  )
  let (builder, open_function) = builder.function(
    integer_parameters,
    boolean,
    open_effects
  )
  let (builder, narrow_continuation) = builder.continuation(integer, boolean)
  let (builder, wide_continuation) = builder.continuation(boolean, integer)
  let (builder, mutable_bool_pointer) = builder.pointer(boolean, SemanticMutable)
  let (builder, mutable_int_pointer) = builder.pointer(integer, SemanticMutable)
  let (builder, immutable_int_pointer) = builder.pointer(
    integer,
    SemanticImmutable
  )
  let (builder, weak_bool) = builder.weak(boolean)
  let (builder, weak_int) = builder.weak(integer)
  let (builder, atomic_bool) = builder.atomic(boolean)
  let (builder, atomic_int) = builder.atomic(integer)
  let (builder, unique_bool) = builder.unique(boolean)
  let (builder, owned_bool) = builder.owned(boolean)
  let (builder, borrowed_bool) = builder.borrow(boolean, SemanticImmutable)
  let (builder, borrowed_int) = builder.borrow(integer, SemanticImmutable)
  let (builder, mut_borrowed_bool) = builder.borrow(boolean, SemanticMutable)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)

  Test.assert_true(
    semantic_type_is_subtype_without_conformance(
      catalog,
      narrow_function,
      wide_function
    )
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      wide_function,
      narrow_function
    )
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      effectful_function,
      narrow_function
    )
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(
      catalog,
      effectful_function,
      open_function
    )
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(
      catalog,
      narrow_continuation,
      wide_continuation
    )
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(
      catalog,
      mutable_bool_pointer,
      immutable_int_pointer
    )
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      mutable_bool_pointer,
      mutable_int_pointer
    )
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, weak_bool, weak_int)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, atomic_bool, atomic_int)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, unique_bool, integer)
  )
  Test.assert_true(
    semantic_type_is_subtype_without_conformance(catalog, owned_bool, integer)
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      borrowed_bool,
      borrowed_int
    )
  )
  Test.assert_false(
    semantic_type_is_subtype_without_conformance(
      catalog,
      mut_borrowed_bool,
      borrowed_bool
    )
  )
}

test "semantic graph facts retain exact declarations across segments" {
  let dependency_module = named_module_identity("dependency/types", 91)
  let dependency_segment = semantic_type_segment_id(dependency_module)
  let dependency_builder = semantic_type_graph_builder(dependency_segment)
  let (dependency_builder, integer) = dependency_builder.primitive(SemanticI64)
  let dependency_graph = dependency_builder.freeze()

  let root_module = named_module_identity("application", 91)
  let root_builder = semantic_type_graph_builder(
    semantic_type_segment_id(root_module)
  )
  let empty_values: [SemanticTypeId; 0] = []
  let (root_builder, empty) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(empty_values[..])
  )
  let argument_values = [integer]
  let (root_builder, arguments) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(argument_values[..])
  )
  let box_declaration = ModuleDeclarationIdentity(
    dependency_module,
    TypeDeclaration,
    source_from_text("Box").all()
  )
  let show_declaration = ModuleDeclarationIdentity(
    dependency_module,
    TraitDeclaration,
    source_from_text("Show").all()
  )
  let state_declaration = ModuleDeclarationIdentity(
    dependency_module,
    EffectDeclaration,
    source_from_text("State").all()
  )
  let item_declaration = MemberDeclarationIdentity(
    show_declaration,
    AssociatedTypeDeclaration,
    source_from_text("Item").all()
  )
  let (root_builder, box_type) = root_builder.named(
    box_declaration,
    SemanticOpaqueType,
    integer,
    arguments
  )
  let (root_builder, show_type) = root_builder.trait_atom(show_declaration)
  let (root_builder, item_type) = root_builder.associated(
    box_type,
    item_declaration
  )
  let (root_builder, state) = root_builder.effect_atom(
    state_declaration,
    arguments
  )
  let state_values = [state]
  let (root_builder, state_list) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(state_values[..])
  )
  let (root_builder, effects) = root_builder.effect_signature(
    state_list,
    SemanticOpenEffects(1)
  )
  let parameter_values = [box_type, show_type]
  let (root_builder, parameters) = root_builder.type_list(
    list.from_slice<SemanticTypeId>(parameter_values[..])
  )
  let (root_builder, function) = root_builder.function(
    parameters,
    item_type,
    effects
  )
  let root_graph = root_builder.freeze()
  let catalog = required_catalog_insert(
    required_catalog_insert(
      semantic_type_catalog_builder(2),
      dependency_graph
    ),
    root_graph
  ).freeze()
  let names = ["T", "E"]
  let context = semantic_type_projection_context(
    root_module,
    registration_scope(),
    list.from_slice<str>(names[..])
  )

  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, box_type) {
      semantic_fact.SemanticTypeNamed(
      name,
      semantic_fact.SemanticTypeFactListCons(
      semantic_fact.SemanticTypePrimitive(primitive),
      semantic_fact.SemanticTypeFactListNil,
    ),
    ) -> name == "Box" and primitive == "i64"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, show_type) {
      semantic_fact.SemanticTypeQualifiedTrait(module_name, name) ->
        module_name == "dependency/types" and name == "Show"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, function) {
      semantic_fact.SemanticTypeFunction(
      semantic_fact.SemanticTypeFactListCons(
      semantic_fact.SemanticTypeNamed(parameter_name, _),
      semantic_fact.SemanticTypeFactListCons(
      semantic_fact.SemanticTypeQualifiedTrait(trait_module, trait_name),
      semantic_fact.SemanticTypeFactListNil,
    ),
    ),
      semantic_fact.SemanticTypeAssociated(
      semantic_fact.SemanticTypeNamed(base_name, _),
      item_name,
    ),
      semantic_fact.SemanticEffectsOpen(
      semantic_fact.SemanticEffectAtomFactListCons(
      semantic_fact.SemanticEffectAtom(effect_name, _),
      semantic_fact.SemanticEffectAtomFactListNil,
    ),
      tail_name,
    ),
    ) -> parameter_name == "Box" and trait_module == "dependency/types" and
        trait_name == "Show" and base_name == "Box" and item_name == "Item" and
        effect_name == "State" and tail_name == "E"
      _ -> false
    }
  )
}

test "semantic graph facts project structural source vocabulary" {
  let module = named_module_identity("projection", 91)
  let builder = semantic_type_graph_builder(semantic_type_segment_id(module))
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, boolean) = builder.primitive(SemanticBool)
  let (builder, pointer) = builder.pointer(boolean, SemanticMutable)
  let (builder, texts) = builder.array(text, 3)
  let field_names = ["left", "right"]
  let field_types = [pointer, texts]
  let (builder, record) = builder.record(
    list.from_slice<str>(field_names[..]),
    list.from_slice<SemanticTypeId>(field_types[..]),
    SemanticOpenRecord
  )
  let (builder, weak_text) = builder.weak(text)
  let (builder, unique_text) = builder.unique(weak_text)
  let (builder, owned_text) = builder.owned(unique_text)
  let (builder, borrowed_text) = builder.borrow(text, SemanticImmutable)
  let (builder, text_slice) = builder.slice(text, SemanticMutable)
  let (builder, atomic_text) = builder.atomic(text)
  let (builder, self_type) = builder.variable(SemanticSelfVariable)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)
  let context = semantic_type_projection_context(
    module,
    registration_scope(),
    Nil<str>()
  )

  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, record) {
      semantic_fact.SemanticTypeRecord(
      semantic_fact.SemanticRecordFieldFactListCons(
      semantic_fact.SemanticRecordField(
      left_name,
      0,
      semantic_fact.SemanticTypePointer(
      semantic_fact.SemanticTypePrimitive(left_type),
      true,
    ),
    ),
      semantic_fact.SemanticRecordFieldFactListCons(
      semantic_fact.SemanticRecordField(
      right_name,
      1,
      semantic_fact.SemanticTypeArray(
      semantic_fact.SemanticTypePrimitive(right_type),
      3,
    ),
    ),
      semantic_fact.SemanticRecordFieldFactListNil,
    ),
    ),
      true,
      false,
    ) -> left_name == "left" and left_type == "bool" and
        right_name == "right" and right_type == "str"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, owned_text) {
      semantic_fact.SemanticTypeOwned(owned_inner) -> match owned_inner {
        semantic_fact.SemanticTypeUnique(unique_inner) -> match unique_inner {
          semantic_fact.SemanticTypeWeak(weak_inner) -> match weak_inner {
            semantic_fact.SemanticTypePrimitive(name) -> name == "str"
            _ -> false
          }
          _ -> false
        }
        _ -> false
      }
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, borrowed_text) {
      semantic_fact.SemanticTypeBorrow(
      semantic_fact.SemanticTypePrimitive(name),
      false,
    ) -> name == "str"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, text_slice) {
      semantic_fact.SemanticTypeSlice(
      semantic_fact.SemanticTypePrimitive(name),
      true,
    ) -> name == "str"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, atomic_text) {
      semantic_fact.SemanticTypeOther(name) -> name == "promoted_atomic_managed"
      _ -> false
    }
  )
  Test.assert_true(
    match semantic_type_fact_from_graph(catalog, context, self_type) {
      semantic_fact.SemanticTypeVariable(name) -> name == "Self"
      _ -> false
    }
  )
}

test "semantic value layout separates lanes ownership and union placement" {
  let builder = semantic_type_graph_builder(segment(75))
  let (builder, bottom) = builder.bottom()
  let (builder, text) = builder.primitive(SemanticStr)
  let (builder, integer) = builder.primitive(SemanticI64)
  let (builder, float32) = builder.primitive(SemanticF32)
  let (builder, float64) = builder.primitive(SemanticF64)
  let (builder, nil_type) = builder.primitive(SemanticNil)
  let no_values: [SemanticTypeId; 0] = []
  let (builder, no_arguments) = builder.type_list(
    list.from_slice<SemanticTypeId>(no_values[..])
  )
  let (builder, opaque_float) = builder.named(
    type_declaration(75, "OpaqueFloat"),
    SemanticOpaqueType,
    float32,
    no_arguments
  )
  let (builder, nominal) = builder.named(
    type_declaration(75, "ManagedValue"),
    SemanticNominalType,
    float64,
    no_arguments
  )
  let (builder, payloadless) = builder.named(
    type_declaration(75, "Payloadless"),
    SemanticPayloadlessVariantType,
    float64,
    no_arguments
  )
  let (builder, nullable_nominal) = builder.union(nominal, nil_type)
  let (builder, bottom_or_text) = builder.union(bottom, text)
  let (builder, incompatible_union) = builder.union(bottom_or_text, integer)
  let field_names = ["z", "a"]
  let field_types = [float32, float64]
  let (builder, record) = builder.record(
    list.from_slice<str>(field_names[..]),
    list.from_slice<SemanticTypeId>(field_types[..]),
    SemanticClosedRecord
  )
  let (builder, open_record) = builder.record(
    list.from_slice<str>(field_names[..]),
    list.from_slice<SemanticTypeId>(field_types[..]),
    SemanticOpenRecord
  )
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)

  Test.assert_eq(
    semantic_word_count_code(semantic_value_word_count(catalog, record)),
    2
  )
  Test.assert_eq(
    semantic_lane_code(semantic_value_lane_class(catalog, opaque_float, 0)),
    2
  )
  Test.assert_eq(
    semantic_release_code(semantic_value_release_kind(catalog, nominal)),
    1
  )
  Test.assert_true(semantic_value_has_release_lane(catalog, nominal))
  Test.assert_eq(
    semantic_release_code(semantic_value_release_kind(catalog, payloadless)),
    0
  )
  Test.assert_eq(
    semantic_union_storage_code(
      semantic_union_storage_class(catalog, nullable_nominal)
    ),
    2
  )
  Test.assert_eq(
    semantic_union_storage_code(
      semantic_union_storage_class(catalog, incompatible_union)
    ),
    0 - 1
  )
  Test.assert_eq(
    semantic_word_count_code(semantic_value_word_count(catalog, open_record)),
    0
  )
  let first_lane = if "z".hash() < "a".hash() { 2 } else { 3 }
  let second_lane = if first_lane == 2 { 3 } else { 2 }
  Test.assert_eq(
    semantic_lane_code(semantic_value_lane_class(catalog, record, 0)),
    first_lane
  )
  Test.assert_eq(
    semantic_lane_code(semantic_value_lane_class(catalog, record, 1)),
    second_lane
  )
}

test "empty semantic type graphs freeze without sentinel nodes" {
  let builder = semantic_type_graph_builder_with_capacity(segment(29), 64)
  let graph = builder.freeze()

  Test.assert_eq_usize(semantic_type_graph_len(graph), 0)
}

test "generated set theoretic graphs match the legacy algebra structure" {
  let operation = prop.usize_below(52).expect("the core operation domain is nonempty")
  let lengths = prop.lengths(0, 32).expect("the bounded program length is valid")
  let programs = prop.list<usize>(operation, lengths)
  let config = prop.config(random.seed(0x53454d414e544943), 160, 32, 32, 160).expect(
    "the semantic graph campaign has cases"
  )
  let subtype_lengths = prop.lengths(0, 8).expect(
    "the subtype campaign length is bounded"
  )
  let subtype_programs = prop.list<usize>(operation, subtype_lengths)
  let subtype_config = prop.config(
    random.seed(0x5355425459504553),
    96,
    8,
    32,
    96
  ).expect("the subtype campaign has cases")
  let projection_operation = prop.usize_below(44).expect(
    "the projection operation domain is nonempty"
  )
  let projection_programs = prop.list<usize>(
    projection_operation,
    subtype_lengths
  )
  let projection_config = prop.config(
    random.seed(0x50524f4a45435453),
    80,
    8,
    32,
    80
  ).expect("the projection campaign has cases")

  prop.check(config, programs, generated_core_graph_matches)
  prop.check(config, programs, generated_core_equality_matches_legacy)
  prop.check(config, programs, generated_empty_substitution_shares_original)
  prop.check(config, programs, generated_core_dnf_matches_legacy)
  prop.check(config, programs, generated_core_layout_matches_legacy)
  prop.check(
    subtype_config,
    subtype_programs,
    generated_core_subtyping_matches_legacy
  )
  prop.check(
    projection_config,
    projection_programs,
    generated_core_projection_matches_legacy
  )
}
