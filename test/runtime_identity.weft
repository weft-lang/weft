use runtime/identity.{RuntimeIdentity, runtime_identity_new}
use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/eq.{Eq}

fn identity_equal<T: Eq>(left: T, right: T) -> bool { left == right }

fn identity_capture() -> () -> RuntimeIdentity {
  let identity = runtime_identity_new()
  () => identity
}

fn identity_churn(count: i64) -> i64 {
  let mut distinct = 0
  for index in 0..count {
    let left = runtime_identity_new()
    let right = runtime_identity_new()
    if left != right { distinct = distinct + 1 }
  }
  distinct
}

test "fresh identities differ while repeated observations agree" {
  let first = runtime_identity_new()
  let second = runtime_identity_new()
  Test.assert_true(first == first)
  Test.assert_true(first != second)
  Test.assert_true(second != first)
  Test.assert_true(identity_equal(first, first))
  Test.assert_true(not identity_equal(first, second))
}

test "identity survives transport in ordinary values" {
  let first = runtime_identity_new()
  let pair = (first, runtime_identity_new())
  let items = [first, pair.1]
  Test.assert_true(items[0] == first)
  Test.assert_true(items[1] == pair.1)
  Test.assert_true(items[0] != items[1])
}

test "captured identities outlive their creating scope" {
  let first = identity_capture()
  let second = identity_capture()
  Test.assert_true(first() == first())
  Test.assert_true(first() != second())
}

test "discarded identity storage is reclaimed during repeated generation" {
  Test.assert_eq(identity_churn(200), 200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(identity_churn(10000), 10000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}
