-- Test: rebuilding a record with one field changed
-- (the seed-era `{p | x: 42}` update syntax is gone; explicit
-- reconstruction tests the same field semantics)
-- Expected exit code: 42

type Point {
  x: i64,
  y: i64
}

fn main() -> i64 {
  let p = Point { x: 10, y: 20 }
  let q = Point { x: 42, y: p.y }
  q.x
}
