-- test/lambda_hoisting.weft -- lambda closure semantics (2k slice A)
--
-- Companion to lambda_hoisting_metrics.weft, which asserts on the
-- emitted IR shape and the module counters. This file asserts on what
-- the hoisted closures actually DO: captures (scalar and managed),
-- nesting, escape, arity, generics, control flow, and boundary inputs.
-- It deliberately imports only the stdlib — closure semantics must not
-- depend on the compiler being in scope.

use "stdlib/vector.weft"
use "stdlib/string.weft"

fn lh_make_adder(k: i64) -> (i64) -> i64 {
  (x: i64) => x + k
}

fn lh_generic_apply<T>(f: (T) -> T, x: T) -> T { f(x) }

fn lh_apply_n(f: (i64) -> i64, x: i64, n: i64) -> i64 {
  let mut acc = x
  let mut i = 0
  while i < n {
    acc = f(acc)
    i = i + 1
  }
  acc
}

test "lambda_hoist_scalar_capture_round_trips" {
  let k = 5
  let f = (x: i64) => x + k
  Test.assert_eq(f(10), 15)
  Test.assert_eq(f(0), 5)
}

test "lambda_hoist_multiple_captures_keep_their_order" {
  let a = 1
  let b = 20
  let c = 300
  let f = (x: i64) => x + a * 1000 + b * 10 + c
  Test.assert_eq(f(7), 7 + 1000 + 200 + 300)
}

test "lambda_hoist_managed_capture_stays_alive" {
  -- A captured str must survive every invocation: the env holds a
  -- retained reference, and repeated calls must not free it.
  let s = "hello"
  let f = (x: i64) => x + str_len(s)
  let mut total = 0
  let mut i = 0
  while i < 64 {
    total = total + f(1)
    i = i + 1
  }
  Test.assert_eq(total, 64 * 6)
  Test.assert_str_eq(s, "hello")
}

test "lambda_hoist_zero_capture_body" {
  let f = (x: i64) => x * 3
  Test.assert_eq(f(14), 42)
}

test "lambda_hoist_multi_param_arity" {
  let base = 100
  let f2 = (a: i64, b: i64) => a + b + base
  let f3 = (a: i64, b: i64, c: i64) => a * b + c + base
  Test.assert_eq(f2(1, 2), 103)
  Test.assert_eq(f3(2, 3, 4), 110)
}

test "lambda_hoist_nested_lambda_captures_outer_scope" {
  let outer = (x: i64) => {
    let y = x * 2
    let inner = (z: i64) => z + y + x
    inner(3)
  }
  Test.assert_eq(outer(4), 3 + 8 + 4)
  Test.assert_eq(outer(0), 3)
}

test "lambda_hoist_escaping_closure_outlives_its_frame" {
  let add7 = lh_make_adder(7)
  let add0 = lh_make_adder(0)
  Test.assert_eq(add7(1), 8)
  Test.assert_eq(add7(35), 42)
  Test.assert_eq(add0(5), 5)
}

test "lambda_hoist_closure_passed_through_generic_function" {
  Test.assert_eq(lh_generic_apply<i64>((v: i64) => v * 3, 5), 15)
  Test.assert_eq(lh_generic_apply<i64>((v: i64) => v - 1, 43), 42)
}

test "lambda_hoist_closure_invoked_many_times_through_a_param" {
  -- The invoke path (load pair, call with env first) must be stable
  -- across repeated calls and across two different closures.
  let k = 3
  let f = (x: i64) => x + k
  let g = (x: i64) => x * k
  Test.assert_eq(lh_apply_n(f, 0, 14), 42)
  Test.assert_eq(lh_apply_n(g, 1, 3), 27)
}

test "lambda_hoist_body_with_control_flow_and_locals" {
  -- Multi-block bodies (branch + loop + locals) are the whole point of
  -- routing through the optimiser; they must stay correct.
  let bound = 10
  let f = (x: i64) => {
    let mut acc = 0
    let mut i = 0
    while i < x {
      if i band 1 == 0 { acc = acc + i } else { acc = acc + bound }
      i = i + 1
    }
    acc
  }
  Test.assert_eq(f(0), 0)
  Test.assert_eq(f(1), 0)
  Test.assert_eq(f(4), 0 + 10 + 2 + 10)
}

test "lambda_hoist_vector_fold_adapter" {
  let vec = vector_new<i64>()
  vector_push<i64>(vec, 2)
  vector_push<i64>(vec, 3)
  vector_push<i64>(vec, 4)
  let scale = 10
  Test.assert_eq(vector_fold<i64, i64>(vec, 0, (acc: i64, x: i64) => acc + x * scale), 90)
  Test.assert_eq(vector_fold<i64, i64>(vec, 1, (acc: i64, x: i64) => acc * x), 24)
}

test "lambda_hoist_empty_and_boundary_inputs" {
  let f = (x: i64) => x + 1
  Test.assert_eq(f(0 - 1), 0)
  Test.assert_eq(f(0), 1)
  let vec = vector_new<i64>()
  Test.assert_eq(vector_fold<i64, i64>(vec, 7, (acc: i64, x: i64) => acc + x), 7)
}

