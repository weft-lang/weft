-- Generic recursion whose instantiations stop growing reaches finitely many
-- specialisations, so it checks, lowers and runs: recursion at the function's
-- own parameters, permuted or closed arguments, growth outside any cycle, and
-- dispatch that takes a receiver apart as far as the recursion rebuilds it.

use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

fn repeat_count<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else { 1 + repeat_count<T>(n - 1, value) }
}

fn alternate<A, B>(n: i64, first: A, second: B) -> i64 {
  if n == 0 { 0 } else { 1 + alternate<B, A>(n - 1, second, first) }
}

fn settle<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else { 1 + settle<i64>(n - 1, n) }
}

fn settle_wrapped<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else {
    let mut fixed = vector.new<i64>()
    fixed.push(n)
    1 + settle_wrapped<Vector<i64>>(n - 1, fixed)
  }
}

fn inferred_count<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else { 1 + inferred_count(n - 1, value) }
}

fn closure_count<T>(n: i64, value: T) -> i64 {
  let again = (count: i64) => closure_count<T>(count, value)
  if n == 0 { 0 } else { 1 + again(n - 1) }
}

fn nested_len<T>(value: T) -> i64 {
  let mut inner = vector.new<T>()
  inner.push(value)
  let mut outer = vector.new<Vector<T>>()
  outer.push(inner)
  if outer.is_empty() { 0 } else { 1 }
}

-- Growth outside a cycle: `wrap_twice` instantiates `nested_len` at a larger
-- type, but `nested_len` never calls back.
fn wrap_twice<T>(n: i64, value: T) -> i64 {
  if n == 0 { nested_len<Vector<T>>(vector.new<T>()) } else { wrap_twice<T>(n - 1, value) }
}

fn ping<T>(n: i64, value: T) -> i64 { if n == 0 { 0 } else { 1 + pong<T>(n - 1, value) } }

fn pong<U>(n: i64, value: U) -> i64 { if n == 0 { 0 } else { 1 + ping<U>(n - 1, value) } }

type Box<T> { value: T }

impl<T> Box<T> {
  fn count(self, n: i64) -> i64 {
    if n == 0 { 0 } else { 1 + Box<T> { value: self.value }.count(n - 1) }
  }

  fn unwrap_count(self, n: i64) -> i64 { settle_box<T>(self.value, n) }
}

fn settle_box<U>(value: U, n: i64) -> i64 {
  if n == 0 { 0 } else { 1 + Box<U> { value: value }.unwrap_count(n - 1) }
}

trait Deep {
  fn deep(self, n: i64) -> i64
}

impl Deep for i64 {
  fn deep(self, n: i64) -> i64 { self + n }
}

-- The receiver's instantiation selects this implementation at T one level
-- inside it; calling back at Box<T> rebuilds exactly that level.
impl<T> Deep for Box<T> {
  fn deep(self, n: i64) -> i64 { go(Box<T> { value: self.value }, n) }
}

fn go<T: Deep>(value: T, n: i64) -> i64 {
  if n == 0 { 0 } else { 1 + value.deep(n - 1) }
}

test "recursion at the function's own parameters" {
  Test.assert_eq(repeat_count<str>(4, "x"), 4)
}

test "recursion may permute type parameters" {
  Test.assert_eq(alternate<i64, str>(5, 1, "one"), 5)
}

test "recursion may use closed instantiations" {
  Test.assert_eq(settle<str>(3, "top"), 3)
  Test.assert_eq(settle_wrapped<str>(3, "top"), 3)
}

test "inferred recursion at the function's own parameters" {
  Test.assert_eq(inferred_count<str>(4, "x"), 4)
}

test "a closure recursing at the function's own parameters" {
  Test.assert_eq(closure_count<i64>(3, 7), 3)
}

test "growth outside any cycle" {
  Test.assert_eq(wrap_twice<str>(2, "x"), 1)
}

test "mutual recursion passing parameters through" {
  Test.assert_eq(ping<str>(5, "x"), 5)
}

test "a method recursing at its own receiver" {
  Test.assert_eq(Box<str> { value: "x" }.count(4), 4)
}

test "a method and a function recursing without growth" {
  Test.assert_eq(settle_box<i64>(1, 4), 4)
}

test "dispatch that takes apart what the recursion builds" {
  Test.assert_eq(go(Box<i64> { value: 1 }, 3), 3)
  Test.assert_eq(go(Box<Box<i64>> { value: Box<i64> { value: 2 } }, 2), 2)
}
