-- Generic instantiation inference (2u follow-up): bare generic ctors
-- solve their type args from argument types and/or the expected type,
-- and bare generic fn calls solve from argument types. Explicit
-- name<targs>(args) forms must keep working unchanged.

type Opt<T> {
  Just(T),
  Nothing
}

type Res<T, E> {
  Okv(T),
  Errv(E)
}

type List2<T> {
  Nil2,
  Cons2(T, List2<T>)
}

fn get_none() -> Opt<i64> {
  Nothing
}

fn get_some() -> Opt<i64> {
  Just(5)
}

fn get_none_explicit() -> Opt<i64> {
  Nothing<i64>()
}

fn get_some_explicit() -> Opt<i64> {
  Just<i64>(5)
}

fn or_zero(o: Opt<i64>) -> i64 {
  match o {
    Just(x) -> x,
    Nothing -> 0
  }
}

fn pick(flag: i64) -> Opt<i64> {
  if flag == 1 { Just(40) } else { Nothing }
}

fn to_res(o: Opt<i64>) -> Res<i64, str> {
  match o {
    Just(x) -> Okv(x),
    Nothing -> Errv("none")
  }
}

fn res_code(r: Res<i64, str>) -> i64 {
  match r {
    Okv(x) -> x,
    Errv(m) -> 0 - 1
  }
}

fn early(flag: i64) -> Opt<i64> {
  if flag == 1 { return Just(7) } else { 0 }
  Nothing
}

fn sum2(xs: List2<i64>) -> i64 {
  match xs {
    Nil2 -> 0,
    Cons2(h, t) -> h + sum2(t)
  }
}

fn id_generic<T>(x: T) -> T {
  x
}

test "nullary_ctor_infers_from_return_type" {
  Test.assert_eq(or_zero(get_none()), 0)
}

test "payload_ctor_infers_from_args_in_return_position" {
  Test.assert_eq(or_zero(get_some()), 5)
}

test "explicit_type_args_still_work" {
  Test.assert_eq(or_zero(get_none_explicit()), 0)
  Test.assert_eq(or_zero(get_some_explicit()), 5)
}

test "annotated_let_infers_nullary_and_payload" {
  let a: Opt<i64> = Nothing
  let b: Opt<i64> = Just(3)
  Test.assert_eq(or_zero(a), 0)
  Test.assert_eq(or_zero(b), 3)
}

test "unannotated_let_infers_from_args" {
  let o = Just(9)
  Test.assert_eq(or_zero(o), 9)
}

test "argument_position_infers_from_param_type" {
  Test.assert_eq(or_zero(Nothing), 0)
  Test.assert_eq(or_zero(Just(11)), 11)
}

test "assignment_infers_from_target_type" {
  let mut cur: Opt<i64> = Nothing
  cur = Just(2)
  Test.assert_eq(or_zero(cur), 2)
}

test "if_branches_infer_in_result_position" {
  Test.assert_eq(or_zero(pick(1)), 40)
  Test.assert_eq(or_zero(pick(0)), 0)
}

test "match_arms_infer_multi_tparam_from_return_type" {
  Test.assert_eq(res_code(to_res(Just(6))), 6)
  Test.assert_eq(res_code(to_res(Nothing)), 0 - 1)
}

test "early_return_value_infers" {
  Test.assert_eq(or_zero(early(1)), 7)
  Test.assert_eq(or_zero(early(0)), 0)
}

test "nested_ctor_args_cascade" {
  Test.assert_eq(sum2(Cons2(20, Cons2(22, Nil2))), 42)
}

test "generic_fn_call_infers_from_args" {
  Test.assert_eq(id_generic(42), 42)
}
