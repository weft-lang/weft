use module_fixtures/g2_function_left as left
use module_fixtures/g2_function_right as right

type QualifiedShadow {
  work: i64
}

test "qualified calls retain declaration identity" {
  Test.assert_eq(left.work(), 11)
  Test.assert_true(right.work())
}

test "qualified function value retains declaration identity" {
  let selected: () -> i64 = left.work
  Test.assert_eq(selected(), 11)
}

test "qualified explicit generic call specializes its declaration" {
  Test.assert_eq(left.identity<i64>(31), 31)
}

test "qualified generic call infers and specializes its declaration" {
  Test.assert_eq(left.identity(32), 32)
}

test "qualified calls preserve identity through cfg arguments" {
  Test.assert_eq(left.add_one(if true { 40 } else { 0 }), 41)
  Test.assert_eq(left.identity(if false { 0 } else { 42 }), 42)
}

test "lexical value shadows module qualifier" {
  let left = QualifiedShadow { work: 43 }
  Test.assert_eq(left.work, 43)
}
