use stdlib/random as random
use stdlib/random.{SplitMix64V1, ZeroBound}
use stdlib/result.{*}

fn random_bound(upper: usize) -> random.Bound {
  random.bound(upper).expect("test bound must be nonzero")
}

test "random seeds preserve the complete unsigned domain" {
  let largest: u64 = 18446744073709551615
  Test.assert_true(random.seed(0).value() == 0)
  Test.assert_true(random.seed(largest).value() == largest)
}

test "random state names its stable algorithm" {
  match random.from_seed(random.seed(42)).algorithm() {
    SplitMix64V1 -> Test.assert_true(true)
  }
}

test "splitmix64 sequence matches the specified vectors" {
  let state0 = random.from_seed(random.seed(0))
  let (state1, word1) = state0.next_u64()
  let (state2, word2) = state1.next_u64()
  let (state3, word3) = state2.next_u64()
  let (state4, word4) = state3.next_u64()
  Test.assert_true(word1 == 16294208416658607535)
  Test.assert_true(word2 == 7960286522194355700)
  Test.assert_true(word3 == 487617019471545679)
  Test.assert_true(word4 == 17909611376780542444)
  Test.assert_true(state0.next_u64().1 == word1)
  Test.assert_true(state4.next_u64().1 == 1961750202426094747)
}

test "random bounds reject only the empty domain" {
  match random.bound(0) {
    Err(ZeroBound) -> Test.assert_true(true)
    Ok(_) -> Test.assert_true(false)
  }
  let one = random_bound(1)
  let largest: usize = 18446744073709551615
  let full = random_bound(largest)
  Test.assert_eq_usize(one.exclusive_upper(), 1)
  Test.assert_eq_usize(full.exclusive_upper(), largest)
}

test "bounded selection stays inside every representative domain" {
  let one = random_bound(1)
  let six = random_bound(6)
  let largest: usize = 18446744073709551615
  let full = random_bound(largest)
  let state0 = random.from_seed(random.seed(7))
  let (state1, only) = state0.next_below(one)
  let (state2, die) = state1.next_below(six)
  let (_, wide) = state2.next_below(full)
  Test.assert_eq_usize(only, 0)
  Test.assert_true(die < 6)
  Test.assert_true(wide < largest)
}

test "bounded selection consumes rejected words deterministically" {
  let high = random_bound(9223372036854775809)
  let state = random.from_seed(random.seed(11400714819323198485))
  let (after, selected) = state.next_below(high)
  let (_, following) = after.next_u64()
  Test.assert_eq_usize(selected, 8686239339925766635)
  Test.assert_true(following == 1961750202426094747)
}
