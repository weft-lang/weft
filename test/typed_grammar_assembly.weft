use compiler/weft/check/checked_program.{CheckedProgram}
use compiler/weft/lower/coverage.{
  checked_program_root_function_lowering_shape
}
use compiler/weft/lower/specialization.{
  CheckedSpecializationAccepted,
  CheckedSpecializationRejected,
  plan_checked_program_specializations
}
use compiler/weft/check/registration/scope.{registration_scope_find_source}
use compiler/weft/check/typed.{check_assembled_weft_program}
use compiler/weft/assemble.{assemble_weft_native_program_with_support_and_loader}
use compiler/weft/load.{
  NativeRuntime
}
use compiler/weft/products.{AstModule}
use compiler/diagnostic/observe.{observe_errors}
use compiler/pipeline.{pipeline_parse_local}
use compiler/source/input.{SourceLoaded, SourceRequest}
use compiler/source/loading.{source_loader}
use compiler/source/owners as source_owners
use compiler/weft/check/table.{ttable_new}
use stdlib/diagnostic.{Diagnose}
use stdlib/diagnostic/schema.{DiagnosticSourceNamed}
use stdlib/grammar.{Checked, CheckRejected, CheckResult}
use stdlib/option.{Option}
use stdlib/source.{Source}
use stdlib/string.{str_concat}
use stdlib/test.{Test}

fn observe_typed_assembled_program(text: str) -> (CheckResult<CheckedProgram>, i64) {
  let source = Source { text: text, identity: DiagnosticSourceNamed("typed-assembled.weft") }
  let table = ttable_new()
  let acquire = (request: SourceRequest) => SourceLoaded(
    Source { text: "", identity: DiagnosticSourceNamed(request.physical_path) }
  )
  let loader = source_loader(acquire, source_owners.new())
  handle observe_errors(
    () => {
      let syntax = pipeline_parse_local(source, table)
      match syntax {
        AstModule(_, root_source, _, _, (_, registrations)) -> {
          let root = registration_scope_find_source(registrations, root_source).unwrap()
          match assemble_weft_native_program_with_support_and_loader(
            syntax,
            root.identity,
            NativeRuntime,
            loader
          ) {
            Checked(assembled) -> check_assembled_weft_program(assembled)
            CheckRejected -> CheckRejected<CheckedProgram>()
          }
        }
      }
    }
  ) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

test "native assembly reaches the typed checked grammar without raw products" {
  let (result, errors) = observe_typed_assembled_program("fn main() -> i64 { 42 }")
  match result {
    Checked(program) -> Test.assert_true(program.module_count() >= 1)
    CheckRejected -> Test.assert_true(false)
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering forms conditional control flow with an exact join lane" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { if true { 41 } else { 42 } }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 4)
          Test.assert_eq_usize(shape.block_parameters, 1)
          Test.assert_eq_usize(shape.branches, 1)
          Test.assert_eq_usize(shape.jumps, 2)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_eq_usize(shape.slots, 0)
          Test.assert_eq_usize(shape.loads, 0)
          Test.assert_eq_usize(shape.stores, 0)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering carries mutable scalar locals through slots" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { let mut value = 1\nvalue = 2\nvalue }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 1)
          Test.assert_eq_usize(shape.block_parameters, 0)
          Test.assert_eq_usize(shape.branches, 0)
          Test.assert_eq_usize(shape.jumps, 0)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 1)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering carries mutable locals around a while back edge" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { let mut value = 0\nwhile value < 2 { value = value + 1 }\nvalue }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 4)
          Test.assert_eq_usize(shape.block_parameters, 0)
          Test.assert_eq_usize(shape.branches, 1)
          Test.assert_eq_usize(shape.jumps, 2)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 3)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering stops a block at an explicit return" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { return 41\n42 }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 1)
          Test.assert_eq_usize(shape.block_parameters, 0)
          Test.assert_eq_usize(shape.branches, 0)
          Test.assert_eq_usize(shape.jumps, 0)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering joins the fallthrough side of an early-return branch" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { if true { return 41 } else { 42 } }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 4)
          Test.assert_eq_usize(shape.block_parameters, 1)
          Test.assert_eq_usize(shape.branches, 1)
          Test.assert_eq_usize(shape.jumps, 1)
          Test.assert_eq_usize(shape.returns, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering retains semantic identities on generic calls" {
  let (result, errors) = observe_typed_assembled_program(
    "fn identity<T>(value: T) -> T { value } fn main() -> i64 { identity<i64>(42) }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 1) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 1)
          Test.assert_eq_usize(shape.semantic_generic_calls, 1)
          Test.assert_eq_usize(shape.first_generic_type_arguments, 1)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization resolves concrete associated result shapes" {
  let source = "trait Factory { type Output fn make() -> Self.Output }\n" |>
    str_concat("type Maker { Maker }\n") |>
    str_concat("impl Factory for Maker { type Output = i64 fn make() -> i64 { 42 } }\n") |>
    str_concat("fn make_as<T: Factory>() -> T.Output { T.make() }\n") |>
    str_concat("fn main() -> i64 { make_as<Maker>() }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> Test.assert_true(plan.function_count() > 0)
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization retains inferred generic function references" {
  let source = "fn equal<T>(left: T, right: T) -> bool { true }\n" |>
    str_concat(
      "fn compare<T>(value: T, operation: (T, T) -> bool) -> bool { operation(value, value) }\n"
    ) |>
    str_concat("fn compare_default<T>(value: T) -> bool { compare<T>(value, equal) }\n") |>
    str_concat("fn main() -> bool { compare_default<i64>(42) }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> Test.assert_true(plan.function_count() > 0)
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization resolves generic managed mutable cleanup" {
  let source = "fn replace<T>(first: T, second: T) -> T {\n" |>
    str_concat("  let mut value = first\n") |>
    str_concat("  value = second\n") |>
    str_concat("  value\n") |>
    str_concat("}\n") |>
    str_concat("fn main() -> str { replace<str>(\"before\", \"after\") }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(plan.instruction_count(64), 0)
        Test.assert_eq(plan.instruction_count(60), 4)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering retains managed mutable ownership transitions" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> str { let mut value = \"before\"\nvalue = \"after\"\nvalue }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 3)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_eq_usize(shape.semantic_mutable_slots, 4)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering cleans managed mutable slots before loop returns" {
  let source = "fn main(flag: bool) -> str {\n" |>
    str_concat("  let mut value = \"before\"\n") |>
    str_concat("  while flag { return value }\n") |>
    str_concat("  value = \"after\"\n") |>
    str_concat("  value\n") |>
    str_concat("}")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 5)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_eq_usize(shape.semantic_mutable_slots, 6)
          Test.assert_eq_usize(shape.returns, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}
