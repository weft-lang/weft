test "typed specialization resolves concrete associated result shapes" {
  let source = "trait Factory { type Output fn make() -> Self.Output }\n" |>
    str_concat("type Maker { Maker }\n") |>
    str_concat("impl Factory for Maker { type Output = i64 fn make() -> i64 { 42 } }\n") |>
    str_concat("fn make_as<T: Factory>() -> T.Output { T.make() }\n") |>
    str_concat("fn main() -> i64 { make_as<Maker>() }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> Test.assert_true(plan.function_count() > 0)
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization retains inferred generic function references" {
  let source = "fn equal<T>(left: T, right: T) -> bool { true }\n" |>
    str_concat(
      "fn compare<T>(value: T, operation: (T, T) -> bool) -> bool { operation(value, value) }\n"
    ) |>
    str_concat("fn compare_default<T>(value: T) -> bool { compare<T>(value, equal) }\n") |>
    str_concat("fn main() -> bool { compare_default<i64>(42) }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> Test.assert_true(plan.function_count() > 0)
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization resolves generic managed mutable cleanup" {
  let source = "fn replace<T>(first: T, second: T) -> T {\n" |>
    str_concat("  let mut value = first\n") |>
    str_concat("  value = second\n") |>
    str_concat("  value\n") |>
    str_concat("}\n") |>
    str_concat("fn main() -> str { replace<str>(\"before\", \"after\") }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(plan.instruction_count(64), 0)
        Test.assert_eq(plan.instruction_count(60), 4)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization materializes closure capture layout" {
  let source = "fn main(value: str) -> i64 { let callback = () => value\n0 }"
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(plan.semantic_data_count(9), 1)
        let { catalog: _, symbols: _, instances: _, functions } = plan
        let (words, managed) = capture_shape_in_functions(functions)
        Test.assert_eq(words, 1)
        Test.assert_eq(managed, 1)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization materializes every lane of an owned record capture" {
  let source = "fn main() -> i64 { let value = { left: 1, right: \"owned\" }\n" |>
    str_concat("let callback = () => value\n0 }")
