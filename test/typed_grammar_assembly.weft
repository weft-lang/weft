  Test.assert_eq(errors, 0)
}

test "typed closure application transports owned arguments but preserves borrows" {
  let source = "fn call_owned(f: (str) -> i64, value: str) -> i64 { f(value) }\n" |>
    str_concat(
      "fn call_borrowed(f: (borrow str) -> i64, value: str) -> i64 { f(value) }"
    )
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> Test.assert_eq_usize(shape.managed_transfers, 1)
      }
      match checked_program_root_function_lowering_shape(program, 1) {
        None -> Test.assert_true(false)
        Some(shape) -> Test.assert_eq_usize(shape.managed_transfers, 0)
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering gives mutable slots independent assignment stakes" {
  let source = "fn main(first: str, second: str) -> str { " |>
    str_concat("let mut value = first\nvalue = second\nvalue }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match checked_program_root_function_lowering_shape(program, 0) {
      None -> Test.assert_true(false)
      Some(shape) -> {
        Test.assert_eq_usize(shape.managed_acquires, 2)
        Test.assert_eq_usize(shape.managed_stakes, 5)
        Test.assert_eq_usize(shape.semantic_mutable_slots, 4)
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering forms conditional control flow with an exact join lane" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> i64 { if true { 41 } else { 42 } }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.blocks, 4)
          Test.assert_eq_usize(shape.block_parameters, 1)
          Test.assert_eq_usize(shape.branches, 1)
          Test.assert_eq_usize(shape.jumps, 2)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_eq_usize(shape.slots, 0)
          Test.assert_eq_usize(shape.loads, 0)
          Test.assert_eq_usize(shape.stores, 0)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

