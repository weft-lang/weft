          Test.assert_eq_usize(shape.blocks, 4)
          Test.assert_eq_usize(shape.block_parameters, 0)
          Test.assert_eq_usize(shape.branches, 1)
          Test.assert_eq_usize(shape.jumps, 2)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 3)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

