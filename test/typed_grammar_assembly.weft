use compiler/weft/check/checked_program.{CheckedProgram}
use compiler/weft/check/registration/scope.{registration_scope_find_source}
use compiler/weft/check/typed.{check_assembled_weft_program}
use compiler/weft/assemble.{assemble_weft_native_program_with_support_and_loader}
use compiler/weft/load.{
  NativeRuntime
}
use compiler/weft/products.{AstModule}
use compiler/diagnostic/observe.{observe_errors}
use compiler/pipeline.{pipeline_parse_local}
use compiler/source/input.{SourceLoaded, SourceRequest}
use compiler/source/loading.{source_loader}
use compiler/source/owners as source_owners
use compiler/weft/check/table.{ttable_new}
use stdlib/diagnostic.{Diagnose}
use stdlib/diagnostic/schema.{DiagnosticSourceNamed}
use stdlib/grammar.{Checked, CheckRejected, CheckResult}
use stdlib/option.{Option}
use stdlib/source.{Source}
use stdlib/test.{Test}

fn observe_typed_assembled_program(text: str) -> (CheckResult<CheckedProgram>, i64) {
  let source = Source { text: text, identity: DiagnosticSourceNamed("typed-assembled.weft") }
  let table = ttable_new()
  let acquire = (request: SourceRequest) => SourceLoaded(
    Source { text: "", identity: DiagnosticSourceNamed(request.physical_path) }
  )
  let loader = source_loader(acquire, source_owners.new())
  handle observe_errors(
    () => {
      let syntax = pipeline_parse_local(source, table)
      match syntax {
        AstModule(_, root_source, _, _, (_, registrations)) -> {
          let root = registration_scope_find_source(registrations, root_source).unwrap()
          match assemble_weft_native_program_with_support_and_loader(
            syntax,
            root.identity,
            NativeRuntime,
            loader
          ) {
            Checked(assembled) -> check_assembled_weft_program(assembled)
            CheckRejected -> CheckRejected<CheckedProgram>()
          }
        }
      }
    }
  ) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

test "native assembly reaches the typed checked grammar without raw products" {
  let (result, errors) = observe_typed_assembled_program("fn main() -> i64 { 42 }")
  match result {
    Checked(program) -> Test.assert_true(program.module_count() >= 1)
    CheckRejected -> Test.assert_true(false)
  }
  Test.assert_eq(errors, 0)
}
