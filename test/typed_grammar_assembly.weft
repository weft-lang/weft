test "typed lowering transports by-value call stakes but not borrowed parameters" {
  let source = "fn consume(value: str) -> i64 { 0 }\n" |>
    str_concat("fn observe(value: borrow str) -> i64 { 0 }\n") |>
    str_concat("fn call_owned(value: str) -> i64 { consume(value) }\n") |>
    str_concat("fn call_borrowed(value: str) -> i64 { observe(value) }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      match checked_program_root_function_lowering_shape(program, 2) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.managed_acquires, 1)
          Test.assert_eq_usize(shape.managed_stakes, 2)
          Test.assert_eq_usize(shape.managed_transfers, 1)
        }
      }
      match checked_program_root_function_lowering_shape(program, 3) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.managed_acquires, 1)
          Test.assert_eq_usize(shape.managed_stakes, 1)
          Test.assert_eq_usize(shape.managed_transfers, 0)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

