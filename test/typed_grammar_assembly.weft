test "typed lowering keeps structural record values in canonical lanes" {
  let source = "fn main() -> i64 {\n" |>
    str_concat("  let pair = { right: 2, left: 40 }\n") |>
    str_concat("  pair.left + pair.right\n") |>
    str_concat("}")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(plan.instruction_count(64), 0)
        Test.assert_eq(plan.instruction_count(65), 0)
        Test.assert_eq(plan.instruction_count(46), 0)
        Test.assert_eq(plan.instruction_count(48), 0)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization lowers nominal records through described layouts" {
  let source = "type Pair { left: i64, right: i64 }\n" |>
    str_concat("fn main() -> Pair { Pair { right: 2, left: 40 } }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        Test.assert_eq(plan.instruction_count(64), 0)
        Test.assert_eq(plan.instruction_count(65), 0)
        Test.assert_eq(plan.instruction_count(46), 1)
        Test.assert_eq(plan.instruction_count(48), 0)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed specialization lowers every lane of a nominal slice field" {
  let source = "type Box { values: [i64] }\n" |>
    str_concat("fn main(box: Box) -> usize { box.values.len }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match plan_checked_program_specializations(program) {
      CheckedSpecializationAccepted(plan) -> {
        let shape = int_to_str(plan.instruction_count(64)) |>
          str_concat(",") |>
          str_concat(int_to_str(plan.instruction_count(65))) |>
          str_concat(",") |>
          str_concat(int_to_str(plan.instruction_count(46))) |>
          str_concat(",") |>
          str_concat(int_to_str(plan.instruction_count(48)))
        Test.assert_str_eq(shape, "0,0,0,2")
        Test.assert_eq(plan.semantic_data_count(2), 0)
        Test.assert_eq(plan.semantic_data_count(4), 0)
      }
      CheckedSpecializationRejected(_) -> Test.assert_true(false)
    }
  }
  Test.assert_eq(errors, 0)
}

