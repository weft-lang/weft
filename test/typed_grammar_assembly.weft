test "typed lowering retains managed mutable ownership transitions" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> str { let mut value = \"before\"\nvalue = \"after\"\nvalue }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 3)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_eq_usize(shape.semantic_mutable_slots, 4)
          Test.assert_eq_usize(shape.returns, 1)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering cleans managed mutable slots before loop returns" {
  let source = "fn main(flag: bool) -> str {\n" |>
    str_concat("  let mut value = \"before\"\n") |>
    str_concat("  while flag { return value }\n") |>
    str_concat("  value = \"after\"\n") |>
    str_concat("  value\n") |>
    str_concat("}")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program_value) -> {
      let program = program_value
      match checked_program_root_function_lowering_shape(program, 0) {
        None -> Test.assert_true(false)
        Some(shape) -> {
          Test.assert_eq_usize(shape.slots, 1)
          Test.assert_eq_usize(shape.loads, 5)
          Test.assert_eq_usize(shape.stores, 2)
          Test.assert_eq_usize(shape.semantic_mutable_slots, 6)
          Test.assert_eq_usize(shape.returns, 2)
          Test.assert_true(shape.edges_match)
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}
