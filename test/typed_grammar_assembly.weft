fn capture_word_shape(words: IrConcreteCaptureWordList) -> (i64, i64) {
  match words {
    IrConcreteCaptureWordNil -> (0, 0)
    IrConcreteCaptureWordCons(word, remaining) -> {
      let (count, managed) = capture_word_shape(remaining)
      (
        count + 1,
        managed + if word.cleanup_kind == continuation_cleanup_kind_rc() { 1 }
      else { 0 }
      )
    }
  }
}

fn capture_shape_in_instructions(instructions: IrInstList) -> (i64, i64) {
  match instructions {
    IrInstNil -> (0, 0)
    IrInstCons(instruction, remaining) -> {
      let (rest_count, rest_managed) = capture_shape_in_instructions(remaining)
      match instruction {
        IrSemanticDataI64(_, IrSemanticSpecializedClosure(_, words, _, _, _), _, _) -> {
          let (count, managed) = capture_word_shape(words)
          (count + rest_count, managed + rest_managed)
        }
        _ -> (rest_count, rest_managed)
      }
    }
  }
}

fn capture_shape_in_blocks(blocks: IrBlockList) -> (i64, i64) {
  match blocks {
    IrBlockListNil -> (0, 0)
    IrBlockListCons(IrBlock(_, _, instructions, _), remaining) -> {
      let (count, managed) = capture_shape_in_instructions(instructions)
      let (rest_count, rest_managed) = capture_shape_in_blocks(remaining)
      (count + rest_count, managed + rest_managed)
    }
  }
}

fn capture_shape_in_functions(functions: List<IrFunction>) -> (i64, i64) {
  match functions {
    Nil -> (0, 0)
    Cons(IrFunction(_, _, blocks, _), remaining) -> {
      let (count, managed) = capture_shape_in_blocks(blocks)
      let (rest_count, rest_managed) = capture_shape_in_functions(remaining)
      (count + rest_count, managed + rest_managed)
    }
  }
}

fn observe_typed_assembled_program(text: str) -> (CheckResult<CheckedProgram>, i64) {
  let source = Source { text: text, identity: DiagnosticSourceNamed("typed-assembled.weft") }
  let table = ttable_new()
  let acquire = (request: SourceRequest) => SourceLoaded(
    Source { text: "", identity: DiagnosticSourceNamed(request.physical_path) }
  )
  let loader = source_loader(acquire, source_owners.new())
  handle observe_errors(
    () => {
      let syntax = pipeline_parse_local(source, table)
      match syntax {
        AstModule(_, root_source, _, _, (_, registrations)) -> {
          let root = registration_scope_find_source(registrations, root_source).unwrap()
          match assemble_weft_native_program_with_support_and_loader(
            syntax,
            root.identity,
            NativeRuntime,
            loader
          ) {
            Checked(assembled) -> check_assembled_weft_program(assembled)
            CheckRejected -> CheckRejected<CheckedProgram>()
          }
        }
      }
    }
  ) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

fn typed_root_body(program: borrow CheckedProgram) -> CheckedBodyProduct {
  let root = program.root()
  let module = program.module(root).unwrap()
  let composed = module.body()
  composed.ordinary()
}

test "native assembly reaches the typed checked grammar without raw products" {
  let (result, errors) = observe_typed_assembled_program("fn main() -> i64 { 42 }")
  match result {
    Checked(program) -> Test.assert_true(program.module_count() >= 1)
    CheckRejected -> Test.assert_true(false)
  }
  Test.assert_eq(errors, 0)
}

test "checked ownership facts distinguish lexical stakes from aliases" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> str { let value = \"owned\"\nvalue }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      let body = typed_root_body(program)
      let expressions = body.expressions()
      let ownership = body.ownership()
      let root = body.function(0).body
      match expressions.let_parts(root) {
        (binding, value, result) -> {
          match ownership.kind(value) {
            CheckedOwnedValue -> Test.assert_true(true)
            _ -> Test.assert_true(false)
          }
          match ownership.kind(result) {
            CheckedExactBorrowedValue -> Test.assert_true(
              ownership.borrows_from(result, binding)
            )
            _ -> Test.assert_true(false)
          }
          match ownership.kind(root) {
            CheckedOwnedValue -> Test.assert_true(true)
            _ -> Test.assert_true(false)
          }
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "checked ownership facts retain projected binding provenance" {
  let source = "type Pair { value: str }\n" |>
    str_concat("fn main(pair: Pair) -> str { pair.value }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      let body = typed_root_body(program)
      let expressions = body.expressions()
      let ownership = body.ownership()
      let function = body.function(0)
      let parameter = expressions.function_parameter(function.parameters, 0)
      match ownership.kind(function.body) {
        CheckedProjectedBorrowedValue -> Test.assert_true(
          ownership.borrows_from(function.body, parameter)
        )
        _ -> Test.assert_true(false)
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "checked ownership facts preserve outer provenance through nested scopes" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main() -> str { let outer = \"owned\"\nlet inner = 1\nouter }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      let body = typed_root_body(program)
      let expressions = body.expressions()
      let ownership = body.ownership()
      let root = body.function(0).body
      match expressions.let_parts(root) {
        (outer, _, inner_scope) -> {
          match ownership.kind(inner_scope) {
            CheckedExactBorrowedValue -> Test.assert_true(
              ownership.borrows_from(inner_scope, outer)
            )
            _ -> Test.assert_true(false)
          }
          match ownership.kind(root) {
            CheckedOwnedValue -> Test.assert_true(true)
            _ -> Test.assert_true(false)
          }
        }
      }
    }
  }
  Test.assert_eq(errors, 0)
}

test "checked ownership facts keep projections from call results owned" {
  let source = "type Pair { value: str }\n" |>
    str_concat("fn keep(pair: Pair) -> Pair { pair }\n") |>
    str_concat("fn main(pair: Pair) -> str { keep(pair).value }")
  let (result, errors) = observe_typed_assembled_program(source)
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> {
      let body = typed_root_body(program)
      let ownership = body.ownership()
      let kind = match ownership.kind(body.function(1).body) {
        CheckedOwnedValue -> 0
        CheckedExactBorrowedValue -> 1
        CheckedProjectedBorrowedValue -> 2
      }
      Test.assert_eq(kind, 0)
    }
  }
  Test.assert_eq(errors, 0)
}

test "typed lowering acquires and releases by-value managed parameters" {
  let (result, errors) = observe_typed_assembled_program(
    "fn main(value: str) -> str { value }"
  )
  match result {
    CheckRejected -> Test.assert_true(false)
    Checked(program) -> match checked_program_root_function_lowering_shape(program, 0) {
      None -> Test.assert_true(false)
      Some(shape) -> {
        Test.assert_eq_usize(shape.managed_acquires, 1)
        Test.assert_eq_usize(shape.managed_stakes, 2)
        Test.assert_eq_usize(shape.managed_transfers, 0)
      }
    }
  }
  Test.assert_eq(errors, 0)
}

