-- Fixed arrays cross a closure environment as one managed storage handle.
-- The escaping closure owns that handle after its creator frame has gone;
-- invoking it returns a distinct owner, and closure promotion recursively
-- promotes both the array storage and its managed leaf.

use runtime/rc_implicit_test.{*}
use runtime/rc.{*}
use runtime/effects.{*}

fn closure_array_from_probe(probe: RuntimeRcProbe) -> [RuntimeRcProbe; 1] {
  let storage = rc_array_storage_new(8, 8, 1, 8, continuation_cleanup_kind_rc())
  let raw = runtime_rc_probe_word(probe)
  rc_default_retain(raw)
  runtime_rc_test_store64(rc_array_storage_data(storage), raw)
  runtime_generator_state_word_as<[RuntimeRcProbe; 1]>(storage)
}

fn closure_array_make_reader(probe: RuntimeRcProbe) -> () -> [RuntimeRcProbe; 1] {
  let values = closure_array_from_probe(probe)
  () => values
}

fn closure_array_storage(values: [RuntimeRcProbe; 1]) -> i64 {
  runtime_generator_state_word_from<[RuntimeRcProbe; 1]>(values)
}

fn closure_array_first_probe_word(values: [RuntimeRcProbe; 1]) -> i64 {
  runtime_rc_test_load64(rc_array_storage_data(closure_array_storage(values)))
}

test "closure_array_carrier_outlives_creator_and_balances_owners" {
  let probe = runtime_rc_probe_new(42)
  let mut i = 0
  while i < 128 {
    let reader = closure_array_make_reader(probe)
    let first = reader()
    let second = reader()
    Test.assert_eq(runtime_rc_test_load64(closure_array_first_probe_word(first)), 42)
    Test.assert_eq(runtime_rc_test_load64(closure_array_first_probe_word(second)), 42)
    i = i + 1
  }
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "closure_array_carrier_promotion_is_transitive" {
  let probe = runtime_rc_probe_new(7)
  let reader = closure_array_make_reader(probe)
  let values = reader()
  let storage = closure_array_storage(values)
  Test.assert_eq(rc_is_promoted(storage), 0)
  Test.assert_eq(rc_is_promoted(runtime_rc_probe_word(probe)), 0)
  Test.assert_eq(if closure_default_promote(reader) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_is_promoted(storage), 1)
  Test.assert_eq(rc_is_promoted(runtime_rc_probe_word(probe)), 1)
  Test.assert_eq(runtime_rc_test_load64(closure_array_first_probe_word(values)), 7)
}
