-- test/bump_reclaim_metrics.weft -- bump mark/restore segment discipline
--
-- alloc_bump_restore_same_segment must prove the mark belongs to the
-- LIVE segment before rewinding. The original end-distance heuristic
-- (end - mark <= 512MB) accepted marks from a previous segment whenever
-- a freshly chained segment landed within 512MB above them; the restore
-- then zeroed across the inter-segment gap and rewound the bump pointer
-- out of the live segment — later allocations overwrote live rc arena
-- descriptors (layout-dependent heap corruption, found compiling
-- bounds_elision_metrics). The fix tracks the live segment's base in
-- runtime state (codegen twin: runtime_state_bump_base_offset) and
-- requires base <= mark <= bump.
--
-- Test discipline: the Test effect's assert machinery itself bump-
-- allocates (~KBs per assert), so no assert may sit between taking a
-- mark and restoring it — a mid-test segment chain would make the mark
-- legitimately stale and the test flaky. Marks are proven same-segment
-- structurally (alloc lands exactly at the mark), restores run before
-- any assert, and values are compared afterwards.

use runtime/alloc.{*}

fn bump_reclaim_segment_size() -> i64 { 536870912 }

test "bump_restore_same_segment_rewinds_live_marks" {
  let m1 = alloc_bump_mark()
  let p1 = alloc_bump(1048576)
  -- If the 1MB landed elsewhere, a chain happened mid-test; retry once
  -- in the fresh segment, where a second chain is impossible.
  let m = if p1 == m1 { m1 } else { alloc_bump_mark() }
  let p = if p1 == m1 { p1 } else { alloc_bump(1048576) }
  alloc_bump_restore_same_segment(m)
  let after = alloc_bump_mark()
  Test.assert_eq(p, m)
  Test.assert_eq(after, m)
}

test "bump_restore_rejects_mark_from_previous_segment" {
  -- A request larger than a whole default segment always chains a fresh
  -- mapping, so the earlier mark is guaranteed stale.
  let stale = alloc_bump_mark()
  let big = alloc_bump(bump_reclaim_segment_size() + 4096)
  let live = alloc_bump_mark()
  alloc_bump_restore_same_segment(stale)
  let after = alloc_bump_mark()
  Test.assert_eq(if big == 0 { 0 } else { 1 }, 1)
  Test.assert_eq(after, live)
}

test "bump_restore_rejects_zero_and_garbage_marks" {
  let live = alloc_bump_mark()
  alloc_bump_restore_same_segment(0)
  let a1 = alloc_bump_mark()
  alloc_bump_restore_same_segment(0 - 1)
  let a2 = alloc_bump_mark()
  alloc_bump_restore_same_segment(7)
  let a3 = alloc_bump_mark()
  alloc_bump_restore_same_segment(live + 1048576)
  let a4 = alloc_bump_mark()
  Test.assert_eq(a1, live)
  Test.assert_eq(if a2 >= live { 1 } else { 0 }, 1)
  Test.assert_eq(if a3 >= a2 { 1 } else { 0 }, 1)
  Test.assert_eq(if a4 >= a3 { 1 } else { 0 }, 1)
}

test "bump_segment_base_tracks_live_segment" {
  -- The base slot always sits at or below the bump pointer, and a chain
  -- moves it to the new mapping (the fresh allocation IS the new base
  -- plus nothing — the allocation starts the segment's usable range).
  let base0 = alloc_bump_segment_base()
  let mark0 = alloc_bump_mark()
  Test.assert_eq(if mark0 >= base0 { 1 } else { 0 }, 1)
  let big = alloc_bump(bump_reclaim_segment_size() + 4096)
  let base1 = alloc_bump_segment_base()
  Test.assert_eq(big, base1)
  Test.assert_eq(if base1 == base0 { 1 } else { 0 }, 0)
}
