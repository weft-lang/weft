use runtime/memory.{*}
use runtime/alloc.{*}
use stdlib/par as par
use stdlib/par.{*}

test "runtime_region_par_fork_without_region_capture_allowed" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 3)
    let parallel = par.with_sequential(() => {
      let h = par.fork<i64>(() => 42)
      par.join<i64>(h)
    })
    parallel + mem_load64(p)
  })
  Test.assert_eq(got, 45)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_par_fork_region_free_worker_arg_allowed" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    par.with_sequential(() => {
      let h = par.fork<i64>(() => 42)
      par.join<i64>(h)
    })
  })
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}
