use "runtime/memory.weft"
use runtime/alloc.{*}
use stdlib/par.{*}

test "runtime_region_par_spawn_without_region_capture_allowed" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    mem_store64(p, 3)
    let parallel = par_with_sequential_i64(() => {
      let h = par_spawn<i64>(() => 42)
      par_await<i64>(h)
    })
    parallel + mem_load64(p)
  })
  Test.assert_eq(got, 45)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}

test "runtime_region_par_spawn_region_free_worker_arg_allowed" {
  let arena = arena_new(64)
  let got = with_scoped_arena_alloc(arena, () => {
    par_with_sequential_i64(() => {
      let h = par_spawn<i64>(() => 42)
      par_await<i64>(h)
    })
  })
  Test.assert_eq(got, 42)
  Test.assert_eq(arena_offset(arena), 0)
  Test.assert_eq(arena_free(arena), 0)
}
