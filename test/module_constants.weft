use compiler/ir.{*}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/pipeline.{*}
use compiler/semantic_fact.{*}
use compiler/type_registry.{*}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_load64, mem_store64}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_registry.{*}
use stdlib/diagnostic_type.{*}
use stdlib/string.{str_eq}
use test/module_fixtures/g2_constant_reexport as constant_reexport
use test/module_fixtures/g2_constant_values as constant_values
use test/module_fixtures/g2_constant_values.{ FORWARD_VALUE as selected_forward, PUBLIC_VALUE as selected_value }

const ROOT_LATER: i64 = 40
const ROOT_FORWARD: i64 = ROOT_LATER + 2
const ROOT_SUB: i64 = ROOT_FORWARD - 2
const ROOT_MUL: i64 = 6 * 7
const ROOT_TRUE: bool = not false
const ROOT_LOGIC: bool = ROOT_TRUE and (ROOT_FORWARD == ROOT_MUL)
const ROOT_U8: u8 = 255
const ROOT_F32: f32 = 1.5
const ROOT_F64: f64 = 2.5
const ROOT_TEXT: str = "weft"
const ROOT_NIL: nil = nil
const root_shadow: i64 = 42

fn constant_test_check_diagnostic(source: str, code: DiagnosticCode) -> i64 {
  let observed = alloc_words(1)
  mem_store64(observed, 0)
  handle pipeline_check_source_with_diagnostics_standalone(__str_ptr(source), __str_len(source)) {
    Diagnose.report(diagnostic) -> {
      if diagnostic_code_text(diagnostic_code(diagnostic)) == diagnostic_code_text(code) {
        mem_store64(observed, mem_load64(observed) + 1)
      } else { 0 }
      resume(0)
    }
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  mem_load64(observed)
}

fn constant_test_parsed_source(source: str) -> AstModule {
  pipeline_parse_source_standalone(__str_ptr(source), __str_len(source))
}

test "module constants evaluate exact scalar and string values" {
  Test.assert_eq(ROOT_FORWARD, 42)
  Test.assert_eq(ROOT_SUB, 40)
  Test.assert_eq(ROOT_MUL, 42)
  Test.assert_true(ROOT_TRUE)
  Test.assert_true(ROOT_LOGIC)
  Test.assert_true(ROOT_U8 == 255)
  Test.assert_true(ROOT_F32 > 1.0)
  Test.assert_true(ROOT_F64 > 2.0)
  Test.assert_str_eq(ROOT_TEXT, "weft")
  Test.assert_true(ROOT_NIL == nil)
}

test "local bindings shadow module constants" {
  let root_shadow = 9
  Test.assert_eq(root_shadow, 9)
}

test "qualified and selective imports preserve constant identity" {
  Test.assert_eq(constant_values.PUBLIC_VALUE, 37)
  Test.assert_eq(selected_value, 37)
  Test.assert_eq(constant_values.FORWARD_VALUE, 7)
  Test.assert_eq(selected_forward, 7)
  Test.assert_str_eq(constant_values.PUBLIC_TEXT, "module")
}

test "package visibility and re-exports preserve constant identity" {
  Test.assert_eq(constant_values.PACKAGE_VALUE, 41)
  Test.assert_eq(constant_reexport.REEXPORTED_VALUE, 37)
}

test "constant declarations do not enter the function-pair list" {
  let source = "const ANSWER: i64 = 42 fn main() -> i64 { ANSWER }"
  match constant_test_parsed_source(source) {
    AstModule(fns, src, tt) -> {
      let declaration = module_decl_fact_find(tt, src, module_decl_namespace_value(), src, 6, 6)
      Test.assert_eq(nlist_len(fns), 1)
      Test.assert_true(declaration != 0)
      Test.assert_eq(module_decl_fact_function_pair(declaration), 0)
      Test.assert_true(module_decl_fact_constant_fact(declaration) != 0)
    }
  }
}

test "constant definitions and uses project a distinct semantic fact" {
  let source = "const ANSWER: i64 = 42 fn main() -> i64 { ANSWER }"
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  match typed {
    TypedModule(fns, src, tt) -> {
      match semantic_fact_query_position(tt, src, 47) {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolConstant, ty, occurrence, definition)))) -> Test.assert_true(str_eq(name, "ANSWER") == 1)
        _ -> Test.assert_true(false)
      }
    }
  }
}

test "constant calls are rejected as runtime evaluation" {
  let source = "fn compute() -> i64 { 1 } const BAD: i64 = compute() fn main() -> i64 { BAD }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_constant_evaluation()), 1)
}

test "constants remain values and cannot be called as functions" {
  let source = "const ANSWER: i64 = 42 fn main() -> i64 { ANSWER() }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_type_mismatch()), 1)
}

test "constant reference cycles are rejected once" {
  let source = "const FIRST: i64 = SECOND const SECOND: i64 = FIRST fn main() -> i64 { FIRST }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_constant_evaluation()), 1)
}

test "constant division stays fenced pending exact semantics" {
  let source = "const BAD: i64 = 8 / 2 fn main() -> i64 { BAD }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_constant_evaluation()), 1)
}

test "constant type mismatches use the ordinary typed diagnostic" {
  let source = "const BAD: bool = \"not bool\" fn main() -> i64 { 0 }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_type_mismatch()), 1)
}

test "constant annotations are mandatory syntax" {
  let source = "const BAD = 1 fn main() -> i64 { 0 }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_syntax_error()), 1)
}

test "runtime-represented constant types stay rejected" {
  let source = "const ITEMS: [i64; 2] = [1, 2] fn main() -> i64 { 0 }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_constant_evaluation()), 1)
}

test "private qualified constants retain module visibility" {
  let source = "use test/module_fixtures/g2_constant_values as values fn main() -> i64 { values.PRIVATE_VALUE }"
  Test.assert_eq(constant_test_check_diagnostic(source, diagnostic_code_module_member_invisible()), 1)
}
