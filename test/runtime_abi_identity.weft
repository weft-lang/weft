-- Source functions may share a runtime ABI spelling without changing either
-- the generated memory/control-flow operations or their own call behavior.
fn rc_default_retain(value: i64) -> i64 { value + 1 }
fn rc_default_release(value: i64) -> i64 { value + 2 }
fn closure_default_retain(value: i64) -> i64 { value + 3 }
fn closure_default_release(value: i64) -> i64 { value + 4 }
fn runtime_index_address(value: i64) -> i64 { value + 5 }
fn fiber_resume(value: i64) -> i64 { value + 6 }
fn runtime_par_work_scope_cleanup(value: i64) -> i64 { value + 7 }

type Box { value: i64 }
fn make_box(value: i64) -> Box { Box { value: value } }
fn make_callback(box: Box) -> (i64) -> i64 { value => box.value + value }

test "runtime ABI spellings retain ordinary user function behavior" {
  Test.assert_eq(rc_default_retain(10), 11)
  Test.assert_eq(rc_default_release(10), 12)
  Test.assert_eq(closure_default_retain(10), 13)
  Test.assert_eq(closure_default_release(10), 14)
  Test.assert_eq(runtime_index_address(10), 15)
  Test.assert_eq(fiber_resume(10), 16)
  Test.assert_eq(runtime_par_work_scope_cleanup(10), 17)
}

test "managed records and captured closures survive runtime spelling collisions" {
  let box = make_box(40)
  let callback = make_callback(box)
  Test.assert_eq(callback(2), 42)
  Test.assert_eq(box.value, 40)
  let values = [callback(1), callback(2), callback(3)]
  Test.assert_eq(values[0] + values[1] + values[2], 126)
}

test "runtime spelling collisions preserve function values and projected calls" {
  let release = rc_default_release
  let callbacks = (rc_default_retain, closure_default_release)
  Test.assert_eq(release(40), 42)
  Test.assert_eq((callbacks.0)(40), 41)
  Test.assert_eq((callbacks.1)(40), 44)
}
