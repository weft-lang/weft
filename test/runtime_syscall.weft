use runtime/syscall.{*}

-- A shrinking ledger, not a constant table: every number here is a Darwin
-- syscall passed to the raw escape, which means the operation is not yet a
-- sealed semantic leaf and cannot work on another target. `open` and `close`
-- left this list when their call sites moved to the platform ABI; `open` had to,
-- because Linux/AArch64 has no `open` syscall and 5 there is `setxattr`. These
-- three are the residual escapes.
test "runtime_residual_raw_darwin_syscall_numbers" {
  Test.assert_eq(syscall_number_unlink(), 10)
  Test.assert_eq(syscall_number_ioctl(), 54)
  Test.assert_eq(syscall_number_lstat(), 340)
}

test "runtime_sys_read_zero_bytes_is_harmless" {
  Test.assert_eq(sys_read(0, __str_ptr(""), 0), 0)
}

test "runtime_sys_write_zero_bytes_is_harmless" {
  Test.assert_eq(sys_write(1, __str_ptr(""), 0), 0)
}
