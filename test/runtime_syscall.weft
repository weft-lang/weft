use runtime/syscall.{*}

test "runtime_syscall_numbers_macos_aarch64_matrix" {
  Test.assert_eq(syscall_number_exit(), 1)
  Test.assert_eq(syscall_number_read(), 3)
  Test.assert_eq(syscall_number_write(), 4)
  Test.assert_eq(syscall_number_open(), 5)
  Test.assert_eq(syscall_number_close(), 6)
  Test.assert_eq(syscall_number_unlink(), 10)
  Test.assert_eq(syscall_number_munmap(), 73)
  Test.assert_eq(syscall_number_mmap(), 197)
}

test "runtime_sys_write_zero_bytes_is_harmless" {
  Test.assert_eq(sys_write(1, __str_ptr(""), 0), 0)
}
