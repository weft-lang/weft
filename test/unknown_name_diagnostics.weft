-- E1001: structured unresolved-name diagnostics and scalar-aware repairs.

use compiler/diagnose.{*}
use compiler/grammar.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/string.{str_eq, str_find, str_find_from}

fn unknown_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { unknown_text_field(rest, key, fallback) }
      _ -> unknown_text_field(rest, key, fallback)
    }
  }
}

fn unknown_i64_field(fields: DiagnosticFieldList, key: str, fallback: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldI64(name, value) -> if str_eq(name, key) == 1 { value } else { unknown_i64_field(rest, key, fallback) }
      _ -> unknown_i64_field(rest, key, fallback)
    }
  }
}

fn unknown_related_matches(related: DiagnosticRelatedLocationList, src: i64, start: i64, end: i64) -> i64 {
  match related {
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> match location {
      DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> {
        if str_eq(label, "similarly named declaration") == 1 and source == src and actual_start == start and actual_end == end { 1 } else { 0 }
      }
      _ -> 0
    }
    _ -> 0
  }
}

fn unknown_typed_suggestion_matches(fields: DiagnosticFieldList, src: i64, start: i64, end: i64, replacement: str) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(DiagnosticSuggestion(message, applicability, edits)) -> {
        let applicability_ok = match applicability { DiagnosticSuggestionMaybeIncorrect -> 1 _ -> 0 }
        let edit_ok = match edits {
          DiagnosticTextEditCons(DiagnosticTextEdit(location, actual_replacement), DiagnosticTextEditNil) -> match location {
            DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> {
              if source == src and actual_start == start and actual_end == end and str_eq(actual_replacement, replacement) == 1 { 1 } else { 0 }
            }
            _ -> 0
          }
          _ -> 0
        }
        if str_eq(message, "replace the unresolved name") == 1 and applicability_ok == 1 and edit_ok == 1 { 1 } else { 0 }
      }
      _ -> unknown_typed_suggestion_matches(rest, src, start, end, replacement)
    }
  }
}

fn unknown_diagnostic_matches(
  diagnostic: Diagnostic,
  src: i64,
  name: str,
  name_kind: str,
  suggestion: str,
  start: i64,
  end: i64,
  declaration_start: i64,
  declaration_end: i64,
  origin: str
) -> i64 {
  let code_ok = str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1001")
  let class_ok = str_eq(diagnostic_class_name(diagnostic_class(diagnostic)), "type")
  let severity_ok = str_eq(diagnostic_severity_name(diagnostic_severity(diagnostic)), "error")
  let fields = diagnostic_fields(diagnostic)
  let name_ok = str_eq(unknown_text_field(fields, "name", ""), name)
  let kind_ok = str_eq(unknown_text_field(fields, "name_kind", ""), name_kind)
  let suggestion_ok = str_eq(unknown_text_field(fields, "suggestion", ""), suggestion)
  let confidence_ok = str_eq(unknown_text_field(fields, "suggestion_confidence", ""), "high")
  let origin_ok = str_eq(unknown_text_field(fields, "suggestion_origin", ""), origin)
  let distance_ok = if unknown_i64_field(fields, "suggestion_distance", 99) == 1 { 1 } else { 0 }
  let primary_ok = match diagnostic_primary(diagnostic) {
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end) -> if source == src and actual_start == start and actual_end == end { 1 } else { 0 }
    _ -> 0
  }
  let related_ok = unknown_related_matches(diagnostic_related(diagnostic), src, declaration_start, declaration_end)
  let typed_ok = unknown_typed_suggestion_matches(fields, src, start, end, suggestion)
  code_ok + class_ok + severity_ok + name_ok + kind_ok + suggestion_ok + confidence_ok + origin_ok + distance_ok + primary_ok + related_ok + typed_ok
}

fn unknown_check_source(
  source: str,
  name: str,
  name_kind: str,
  suggestion: str,
  declaration: str,
  origin: str
) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = handle grammar.parse(src, __str_len(source), tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let observation = alloc_zeroed(32)
  let start = str_find_from(source, name, str_find(source, declaration) + __str_len(declaration))
  let declaration_start = str_find(source, declaration)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1001") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        mem_store64_at(observation, 8, unknown_diagnostic_matches(
          diagnostic,
          src,
          name,
          name_kind,
          suggestion,
          start,
          start + __str_len(name),
          declaration_start,
          declaration_start + __str_len(declaration),
          origin
        ))
      } else { mem_store64_at(observation, 24, mem_load64_at(observation, 24) + 1) }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  mem_load64_at(observation, 0) * 1000 + mem_load64_at(observation, 8) * 10 + mem_load64_at(observation, 16) * 2 + mem_load64_at(observation, 24)
}

test "unknown_name_distance_is_unicode_scalar_aware" {
  Test.assert_eq(typeck_name_edit_distance(__str_ptr("counter"), __str_len("counter"), __str_ptr("counte"), __str_len("counte")), 1)
  Test.assert_eq(typeck_name_edit_distance(__str_ptr("counter"), __str_len("counter"), __str_ptr("countre"), __str_len("countre")), 1)
  Test.assert_eq(typeck_name_edit_distance(__str_ptr("café"), __str_len("café"), __str_ptr("cafè"), __str_len("cafè")), 1)
  Test.assert_eq(typeck_name_edit_distance(__str_ptr("πράξη"), __str_len("πράξη"), __str_ptr("πραξη"), __str_len("πραξη")), 1)
  Test.assert_eq(typeck_name_edit_distance(__str_ptr("abc"), __str_len("abc"), __str_ptr("xyz"), __str_len("xyz")), 3)
}

test "unknown_name_without_suggestion_keeps_exact_payload" {
  let src = __str_ptr("missing")
  let diagnostic = typeck_unknown_name_diagnostic(src, 0, 7, "identifier", NoTypeckNameSuggestion())
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1001")
  Test.assert_str_eq(diagnostic_message(diagnostic), "unknown identifier 'missing'")
  Test.assert_eq(diagnostic_location_start(diagnostic_primary(diagnostic)), 0)
  Test.assert_eq(diagnostic_location_end(diagnostic_primary(diagnostic)), 7)
  Test.assert_eq(diagnostic_related_count(diagnostic_related(diagnostic)), 0)
  Test.assert_eq(diagnostic_suggestion_count(diagnostic_fields(diagnostic)), 0)
  Test.assert_eq(diagnostic_field_count(diagnostic_fields(diagnostic)), 2)
}

test "unknown_identifier_suggests_nearest_local_with_typed_edit" {
  let source = "fn main() -> i64 { let counter = 1 counte }"
  Test.assert_eq(unknown_check_source(source, "counte", "identifier", "counter", "counter", "local"), 1120)
}

test "unknown_function_suggests_resolved_module_function" {
  let source = "fn calculate() -> i64 { 1 } fn main() -> i64 { calculatee() }"
  Test.assert_eq(unknown_check_source(source, "calculatee", "function", "calculate", "calculate", "module-scope"), 1120)
}

test "unknown_generic_target_uses_same_function_family" {
  let source = "fn collect<T>(value: T) -> T { value } fn main() -> i64 { collectt<i64>(1) }"
  Test.assert_eq(unknown_check_source(source, "collectt", "function", "collect", "collect", "module-scope"), 1120)
}

test "unknown_assignment_target_uses_identifier_family" {
  let source = "fn main() -> i64 { let mut total = 1 tota = 2 total }"
  Test.assert_eq(unknown_check_source(source, "tota", "identifier", "total", "total", "local"), 1120)
}
