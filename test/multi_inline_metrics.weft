use compiler/weft/products.{TypedModule}
use module_fixtures/compiler_probe.{probe_check_source, probe_check_source_with_origin}
-- test/multi_inline_metrics.weft -- multi-block tiny-fn inlining (multi-block inlining)
--
-- The optimiser splices small pure unmanaged-param callees with branchy
-- bodies (null-guarded accessors, comparators) into callers. These tests
-- compile source in-process and assert on the optimised IR: inlined calls
-- are gone, ineligible calls remain, and the spliced CFG stays sound.

use stdlib/vector as vector
use compiler/backend/aarch64/codegen.{*}
use compiler/weft/check/body.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir/data.{*}
use compiler/pipeline.{*}
use compiler/storage.{*}
use compiler/weft/check/table.{*}
use compiler/types/algebra.{*}
use runtime/alloc.{*}
use runtime/memory.{*}

test "loop inlining follows sparse CFG cycles beyond the old analysis budget" {
  let callee = IrFunction(770077, 1,
    IrBlockListCons(IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(0, 1, 2)),
    IrBlockListCons(IrBlock(1, IrValueNil, IrInstCons(IrConstI64(1, 10), IrInstNil), IrTermReturn(1)),
    IrBlockListCons(IrBlock(2, IrValueNil, IrInstCons(IrConstI64(2, 20), IrInstNil), IrTermReturn(2)), IrBlockListNil))), 0)
  let candidates = pipeline_ir_inline_candidate_prepend(770077, callee, PipelineIrInlineCandidateNil)
  let mut blocks = IrBlockListCons(IrBlock(20000, IrValueNil, IrInstNil, IrTermReturn(0)), IrBlockListNil)
  let mut id = 20
  while id > 0 {
    blocks = IrBlockListCons(IrBlock(id, IrValueNil, IrInstNil, IrTermReturn(0)), blocks)
    id = id - 1
  }
  blocks = IrBlockListCons(IrBlock(10000, IrValueNil,
    IrInstCons(IrCallI64(2, 770077, IrValueCons(0, IrValueNil)), IrInstNil), IrTermBranch(0, 10000, 20000)), blocks)
  blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(1, 770077, IrValueCons(0, IrValueNil)), IrInstNil), IrTermJump(10000, IrValueNil)), blocks)
  let result = pipeline_ir_multi_inline_function_blocks(123, 1, blocks, candidates, PipelineIrSemanticFactNil, 0)
  Test.assert_eq(pipeline_ir_multi_pass_changed(result), 1)
  Test.assert_eq(mi_count_calls_blocks(pipeline_ir_multi_pass_blocks(result), 770077), 1)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(123, 1, pipeline_ir_multi_pass_blocks(result), 0)), 0)
}

test "inlining visits newly exposed calls in order and preserves the unprocessed suffix" {
  let leaf = IrFunction(770079, 1, IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrConstI64(1, 7), IrInstNil), IrTermReturn(1)), IrBlockListNil), 0)
  let wrapper = IrFunction(770078, 1, IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrCallI64(1, 770079, IrValueCons(0, IrValueNil)), IrInstNil), IrTermReturn(1)), IrBlockListNil), 0)
  let candidates = pipeline_ir_inline_candidate_prepend(770078, wrapper,
    pipeline_ir_inline_candidate_prepend(770079, leaf, PipelineIrInlineCandidateNil))
  let mut calls = IrInstNil
  let mut value = 40
  while value > 0 {
    calls = IrInstCons(IrCallI64(value, 770078, IrValueCons(0, IrValueNil)), calls)
    value = value - 1
  }
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, calls, IrTermReturn(40)), IrBlockListNil)
  let result = pipeline_ir_multi_inline_function_blocks(124, 1, blocks, candidates, PipelineIrSemanticFactNil, 0)
  Test.assert_eq(pipeline_ir_multi_pass_changed(result), 32)
  Test.assert_eq(mi_count_calls_blocks(pipeline_ir_multi_pass_blocks(result), 770078), 24)
  Test.assert_eq(mi_count_calls_blocks(pipeline_ir_multi_pass_blocks(result), 770079), 0)
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(124, 1, pipeline_ir_multi_pass_blocks(result), 0)), 0)
}

fn mi_optimised(src_str: str) -> IrModule {
  let src = __str_ptr(src_str)
  let n = __str_len(src_str)
  let typed = probe_check_source_with_origin(src, n, 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

test "late projection transport preserves the existing ownership admission rules" {
  let read = IrFieldLoadI64(2, 0, 123, 0)
  let packed = IrRecordLayoutWordLoadI64(2, 0, 8, 123, 0)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(read, 71, 0, 0, PipelineIrInlineEarly), 0)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(read, 71, 0, 0, PipelineIrInlineAfterLayout), 1)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(packed, 71, 0, 0, PipelineIrInlineAfterLayout), 1)
  let allocating = IrVariantInitI64(2, 88, IrValueCons(0, IrValueNil), 1)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(allocating, 71, 0, 0, PipelineIrInlineAfterLayout), 0)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(allocating, 71, 1, 0, PipelineIrInlineAfterLayout), 1)
  let retain = IrCallI64(2, pipeline_ir_native_hash_name("rc_default_retain"), IrValueCons(0, IrValueNil))
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(retain, 71, 0, 0, PipelineIrInlineAfterLayout), 0)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(retain, 71, 0, 1, PipelineIrInlineAfterLayout), 1)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported_at(IrCallI64(2, 71, IrValueCons(0, IrValueNil)), 71, 0, 1, PipelineIrInlineAfterLayout), 0)
}

test "conditional record accessors inline through the shared late transport policy" {
  let src = "type Row { value: i64, valid: bool }
fn read_row(row: Row) -> i64 { if row.valid { row.value } else { 0 } }
fn total_rows(row: Row, count: i64) -> i64 {
  let mut total = 0
  let mut i = 0
  while i < count { total = total + read_row(row) i = i + 1 }
  total
}
fn main() -> i64 { total_rows(Row { value: 42, valid: true }, 3) - 126 }"
  let ir = mi_optimised(src)
  Test.assert_eq(mi_calls_in(pipeline_ir_functions(ir), mi_hash("total_rows"), mi_hash("read_row")), 0)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
}

test "checked table projections inline after optional result specialization" {
  let src = "use stdlib/f64_table as table use stdlib/f64_table.{ F64Table }
use stdlib/option.{ Option }
fn first_column(rows: F64Table, row: i64) -> f64 { rows.get(row, 0).unwrap() }
fn total_rows(rows: F64Table, count: i64) -> f64 {
  let mut total = 0.0
  let mut i = 0
  while i < count { total = total + first_column(rows, i) i = i + 1 }
  total
}
fn main() -> i64 { let rows = table.zeros(3, 1).unwrap() if total_rows(rows, 3) == 0.0 { 0 } else { 1 } }"
  let ir = mi_optimised(src)
  Test.assert_eq(mi_calls_in(pipeline_ir_functions(ir), mi_hash("total_rows"), mi_hash("first_column")), 0)
  Test.assert_eq(pipeline_ir_verify_module(ir), 0)
}

fn mi_count_calls_insts(insts: IrInstList, target_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee_hash, args) -> if callee_hash == target_hash { 1 } else { 0 }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> if pipeline_ir_materialise_managed_stake_hash(cleanup_kind, delta) == target_hash { 1 } else { 0 }
        _ -> 0
      }
      one + mi_count_calls_insts(rest, target_hash)
    }
  }
}

fn mi_count_calls_blocks(blocks: IrBlockList, target_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> mi_count_calls_insts(insts, target_hash)
      }
      one + mi_count_calls_blocks(rest, target_hash)
    }
  }
}

fn mi_count_method_calls_insts(insts: IrInstList, type_hash: i64, method_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrMethodCallI64(dst, candidate_type, candidate_method, receiver, args) -> if candidate_type == type_hash and candidate_method == method_hash { 1 } else { 0 }
        _ -> 0
      }
      one + mi_count_method_calls_insts(rest, type_hash, method_hash)
    }
  }
}

fn mi_count_method_calls_blocks(blocks: IrBlockList, type_hash: i64, method_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> mi_count_method_calls_insts(insts, type_hash, method_hash)
      }
      one + mi_count_method_calls_blocks(rest, type_hash, method_hash)
    }
  }
}

fn mi_method_calls_in(fns_list: IrFunctionList, fn_hash: i64, type_hash: i64, method_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, nparams, blocks, src) -> {
          if hash == fn_hash {
            mi_count_method_calls_blocks(blocks, type_hash, method_hash)
          } else {
            mi_method_calls_in(rest, fn_hash, type_hash, method_hash)
          }
        }
      }
    }
  }
}

fn mi_method_owner_in_insts(insts: IrInstList, method_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrMethodCallI64(dst, type_hash, candidate_method, receiver, args) -> if candidate_method == method_hash { type_hash } else { mi_method_owner_in_insts(rest, method_hash) }
      _ -> mi_method_owner_in_insts(rest, method_hash)
    }
  }
}

fn mi_method_owner_in_blocks(blocks: IrBlockList, method_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let owner = mi_method_owner_in_insts(insts, method_hash)
        if owner >= 0 { owner } else { mi_method_owner_in_blocks(rest, method_hash) }
      }
    }
  }
}

fn mi_method_owner_in(fns_list: IrFunctionList, fn_hash: i64, method_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, nparams, blocks, src) -> if hash == fn_hash { mi_method_owner_in_blocks(blocks, method_hash) } else { mi_method_owner_in(rest, fn_hash, method_hash) }
    }
  }
}

fn mi_count_dense_role_calls_insts(insts: IrInstList, facts: PipelineIrSemanticFactList, role: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let found = match inst {
        IrCallI64(dst, callee_hash, args) -> pipeline_ir_semantic_fact_lookup_dense_table_role(facts, callee_hash)
        IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(type_hash, method_hash))
        _ -> cg_semantic_dense_table_role_none()
      }
      (if found == role { 1 } else { 0 }) + mi_count_dense_role_calls_insts(rest, facts, role)
    }
  }
}

fn mi_count_dense_role_calls_blocks(blocks: IrBlockList, facts: PipelineIrSemanticFactList, role: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) -> mi_count_dense_role_calls_insts(insts, facts, role) + mi_count_dense_role_calls_blocks(rest, facts, role)
  }
}

fn mi_dense_role_calls_in(fns_list: IrFunctionList, fn_hash: i64, facts: PipelineIrSemanticFactList, role: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(IrFunction(hash, nparams, blocks, src), rest) -> if hash == fn_hash { mi_count_dense_role_calls_blocks(blocks, facts, role) } else { mi_dense_role_calls_in(rest, fn_hash, facts, role) }
  }
}

fn mi_calls_in(fns_list: IrFunctionList, fn_hash: i64, target_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, nparams, blocks, src) -> {
          if hash == fn_hash {
            mi_count_calls_blocks(blocks, target_hash)
          } else {
            mi_calls_in(rest, fn_hash, target_hash)
          }
        }
      }
    }
  }
}

fn mi_hash(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

fn mi_i64_pair_spec_hash(name: str) -> i64 {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  nlist_add(args, ty_i64())
  mono_spec_hash(mi_hash(name), args)
}

fn mi_caller_calls(src_str: str, caller: str, callee: str) -> i64 {
  mi_calls_in(pipeline_ir_functions(mi_optimised(src_str)), mi_hash(caller), mi_hash(callee))
}

fn mi_small_variant_count_insts(insts: IrInstList, kind: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrVariantInitI64(dst, tag, payloads, mask) -> if kind == 1 { 1 } else { 0 }
        IrVariantTagI64(dst, base) -> if kind == 2 { 1 } else { 0 }
        IrVariantPayloadI64(dst, base, index) -> if kind == 3 { 1 } else { 0 }
        IrManagedStakeI64(dst, value, cleanup_kind, delta, origin) -> if kind == 4 { 1 } else { 0 }
        IrCallResultLaneI64(dst, lane) -> if kind == 5 { 1 } else { 0 }
        IrReturnLaneI64(lane, value) -> if kind == 6 { 1 } else { 0 }
        _ -> 0
      }
      here + mi_small_variant_count_insts(rest, kind)
    }
  }
}

fn mi_small_variant_count_blocks(blocks: IrBlockList, kind: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> mi_small_variant_count_insts(insts, kind) + mi_small_variant_count_blocks(rest, kind)
    }
  }
}

fn mi_small_variant_function_metric(functions: IrFunctionList, target: i64, kind: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target { mi_small_variant_count_blocks(blocks, kind) }
      else { mi_small_variant_function_metric(rest, target, kind) }
    }
  }
}

fn mi_small_variant_call_lane_after(insts: IrInstList, head: i64, metric: i64) -> i64 {
  match insts {
    IrInstCons(IrCallResultLaneI64(dst, encoded), rest) -> {
      if metric == 1 { ir_call_result_lane_physical(encoded) }
      else { if metric == 2 { ir_call_result_lane_head(dst, encoded) }
      else { if metric == 3 { encoded } else { dst } } }
    }
    _ -> 0 - 1
  }
}

fn mi_small_variant_call_lane_insts(insts: IrInstList, callee: i64, metric: i64) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, actual, args) -> if actual == callee { mi_small_variant_call_lane_after(rest, dst, metric) }
      else { mi_small_variant_call_lane_insts(rest, callee, metric) }
      _ -> mi_small_variant_call_lane_insts(rest, callee, metric)
    }
  }
}

fn mi_small_variant_call_lane_blocks(blocks: IrBlockList, callee: i64, metric: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let local = mi_small_variant_call_lane_insts(insts, callee, metric)
        if local != 0 - 1 { local } else { mi_small_variant_call_lane_blocks(rest, callee, metric) }
      }
    }
  }
}

fn mi_small_variant_call_lane(functions: IrFunctionList, target: i64, callee: i64, metric: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target { mi_small_variant_call_lane_blocks(blocks, callee, metric) }
      else { mi_small_variant_call_lane(rest, target, callee, metric) }
    }
  }
}

fn mi_small_variant_lane_callee_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0 - 1
    IrInstCons(inst, rest) -> match inst {
      IrCallI64(dst, callee, args) -> match rest {
        IrInstCons(IrCallResultLaneI64(lane_dst, encoded), tail) -> callee
        _ -> mi_small_variant_lane_callee_insts(rest)
      }
      _ -> mi_small_variant_lane_callee_insts(rest)
    }
  }
}

fn mi_small_variant_lane_callee_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0 - 1
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> {
        let local = mi_small_variant_lane_callee_insts(insts)
        if local != 0 - 1 { local } else { mi_small_variant_lane_callee_blocks(rest) }
      }
    }
  }
}

fn mi_small_variant_lane_callee(functions: IrFunctionList, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(function, rest) -> match function {
      IrFunction(hash, nparams, blocks, src) -> if hash == target { mi_small_variant_lane_callee_blocks(blocks) }
      else { mi_small_variant_lane_callee(rest, target) }
    }
  }
}

fn mi_small_variant_managed_fact() -> i64 {
  let fact = cg_semantic_fact_new_raw(0, 1, 0, 1, 1, 0, 1, 0)
  cg_semantic_fact_set_fresh_managed_return(fact, 1)
  fact
}

fn mi_small_variant_function(hash: i64, nparams: i64, blocks: IrBlockList) -> IrFunction {
  IrFunction(hash, nparams, blocks, 0)
}

-- ---------------------------------------------------------------------
-- Happy paths
-- ---------------------------------------------------------------------

test "multi_inline_null_guarded_accessor_disappears" {
  -- The vector_storage accessor shape: null guard around a raw load.
  let src = "fn guarded_load(vec: i64) -> i64 {
  if vec == 0 { 0 } else { vec * 3 + 7 }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + guarded_load(i)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "guarded_load"), 0)
}

test "multi_inline_comparator_shape_disappears" {
  -- Nested-if comparator: six blocks, pure scalar.
  let src = "fn cmp3(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + cmp3(i, 5)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "cmp3"), 0)
}

test "multi_inline_wrapper_chain_collapses" {
  -- Wrapper -> guarded body: the wrapper swallows the branchy body in
  -- pass one; callers swallow the wrapper via the rebuilt candidates.
  let src = "fn guarded(vec: i64) -> i64 {
  if vec == 0 { 0 } else { vec * 5 }
}

fn wrapper(vec: i64) -> i64 {
  guarded(vec)
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + wrapper(i)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "wrapper"), 0)
  Test.assert_eq(mi_caller_calls(src, "hot", "guarded"), 0)
}

test "multi_inline_multiple_sites_one_block" {
  let src = "fn pick(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn hot(x: i64, y: i64, z: i64) -> i64 {
  pick(x, y) + pick(y, z) + pick(x, z)
}

fn main() -> i64 {
  hot(1, 2, 3)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "pick"), 0)
}

test "multi_inline_sites_counted" {
  let src = "fn pick(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn hot(x: i64, y: i64) -> i64 {
  pick(x, y)
}

fn main() -> i64 {
  hot(1, 2)
}"
  let optimised = mi_optimised(src)
  -- multi splices merge into the direct-call inline site counter
  Test.assert_eq(if pipeline_ir_direct_call_inline_sites(optimised) >= 1 { 1 } else { 0 }, 1)
}

-- ---------------------------------------------------------------------
-- Semantic-operation eligibility, then sad paths: every remaining
-- ineligibility reason leaves the call in place.
-- ---------------------------------------------------------------------

test "multi_inline_typed_vector_store_body_disappears" {
  -- Typed vector stores are semantic operations: a branchy wrapper may be
  -- spliced while its bounds-check mode remains attached to the operation.
  let src = "use stdlib/vector as vector use stdlib/vector.{*}

fn poke(v: Vector<i64>, i: i64) -> i64 {
  if i < 0 { 0 } else { vector_set<i64>(v, i, i) }
}

fn hot(v: Vector<i64>, n: i64) -> i64 {
  let mut i = 0
  while i < n {
    poke(v, i)
    i = i + 1
  }
  n
}

fn main(v: Vector<i64>) -> i64 {
  hot(v, 3)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "poke"), 0)
}

test "multi_inline_match_bodied_accessor_disappears" {
  -- Match-bodied accessors carry the unmatched-arm trap inst; under
  -- loop-gated splicing they are affordable candidates, and lowered
  -- bodies embed their whole ownership protocol, so managed-parameter
  -- accessors splice like any other candidate.
  let src = "type Wrap {
  Wrap(i64)
}

fn unwrap_w(w: Wrap) -> i64 {
  match w {
    Wrap(v) -> if v > 0 { v } else { 0 - v }
  }
}

fn hot(n: i64) -> i64 {
  let w = Wrap(n)
  unwrap_w(w) + unwrap_w(w)
}

fn main() -> i64 {
  hot(4)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "unwrap_w"), 0)
}

test "multi_inline_resolved_inherent_method_chain_disappears" {
  -- Resolved inherent calls carry exact owner/method identity and the same
  -- physical ABI argument list as direct calls. A wrapper around a branchy
  -- method therefore erases completely inside its hot caller.
  let src = "type MethodCounter = opaque i64

impl MethodCounter {
  fn at_least(self, floor: i64) -> i64 {
    match self {
      MethodCounter(value) -> if value < floor { floor } else { value }
    }
  }
}

fn adjusted(counter: MethodCounter, floor: i64) -> i64 {
  counter.at_least(floor)
}

fn hot(counter: MethodCounter, n: i64) -> i64 {
  let mut total = 0
  let mut i = 0
  while i < n {
    total = total + adjusted(counter, i)
    i = i + 1
  }
  total
}

fn main() -> i64 {
  hot(MethodCounter(2), 4)
}"
  let typed = probe_check_source(__str_ptr(src), __str_len(src))
  let raw = pipeline_lower_ir(typed)
  let functions = pipeline_ir_functions(pipeline_optimise_typed_ir(typed, raw))
  let owner = mi_method_owner_in(pipeline_ir_functions(raw), mi_hash("adjusted"), mi_hash("at_least"))
  let facts = match typed { TypedModule(fns, source, tt, owners) -> pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt) }
  Test.assert_eq(mi_calls_in(functions, mi_hash("hot"), mi_hash("adjusted")), 0)
  Test.assert_eq(mi_method_calls_in(functions, mi_hash("hot"), owner, mi_hash("at_least")), 0)
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(owner, mi_hash("at_least"))), cg_semantic_dense_table_role_none())
}

test "multi_inline_rejects_effectful_callee" {
  let src = "effect Tick {
  fn bump() -> i64
}

fn noisy(a: i64) -[Tick]> i64 {
  if a > 0 { Tick.bump() } else { 0 }
}

fn hot(n: i64) -[Tick]> i64 {
  noisy(n) + noisy(n + 1)
}

fn main() -> i64 {
  handle hot(3) {
    Tick.bump() -> resume(1)
  }
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "noisy") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_requires_a_fact_to_inline_source_level_retains" {
  let retain = IrCallI64(
    1,
    pipeline_rc_default_retain_hash(),
    ir_value_list_prepend(0, ir_value_list_empty())
  )
  let forwarding = IrFunction(
    9101,
    1,
    ir_block_list_prepend(
      ir_block_new_term(0, ir_inst_list_prepend(retain, ir_inst_list_empty()), IrTermReturn(1)),
      ir_block_list_empty()
    ),
    0
  )
  let packaged = IrFunction(
    9102,
    1,
    ir_block_list_prepend(
      ir_block_new_term(
        0,
        ir_inst_list_prepend(
          retain,
          ir_inst_list_prepend(IrBinaryI64(2, IrAdd, 1, 0), ir_inst_list_empty())
        ),
        IrTermReturn(2)
      ),
      ir_block_list_empty()
    ),
    0
  )
  let forwarding_fact = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 0, 2, 0)
  let packaged_fact = cg_semantic_fact_new_raw(0, 1, 1, 0, 0, 0, 2, 0)
  let facts = pipeline_ir_semantic_facts_prepend(
    9101,
    forwarding_fact,
    pipeline_ir_semantic_facts_prepend(
      9102,
      packaged_fact,
      pipeline_ir_semantic_facts_empty()
    )
  )
  pipeline_ir_direct_retain_return_enrich(
    ir_function_list_prepend(
      forwarding,
      ir_function_list_prepend(packaged, ir_function_list_empty())
    ),
    facts
  )
  Test.assert_eq(cg_semantic_fact_direct_retain_return(forwarding_fact), 1)
  Test.assert_eq(cg_semantic_fact_direct_retain_return(packaged_fact), 0)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported(retain, 9101, 0, 1), 1)
  Test.assert_eq(pipeline_ir_multi_inline_inst_supported(retain, 9102, 0, 0), 0)
}

test "multi_inline_rejects_oversize_body" {
  -- Body over the inst cap stays a call.
  let src = "fn big(a: i64, b: i64) -> i64 {
  if a == 0 { 0 } else {
    let c1 = a * 3 + b
    let c2 = c1 * 5 + a
    let c3 = c2 * 7 + b
    let c4 = c3 * 9 + a
    let c5 = c4 * 11 + b
    let c6 = c5 * 13 + a
    let c7 = c6 * 15 + b
    let c8 = c7 * 17 + a
    let c9 = c8 * 19 + b
    let c10 = c9 * 21 + a
    let c11 = c10 * 23 + b
    let c12 = c11 * 25 + a
    let c13 = c12 * 27 + b
    let c14 = c13 * 29 + a
    let c15 = c14 * 31 + b
    let c16 = c15 * 33 + a
    c16 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15
  }
}

fn hot(n: i64) -> i64 {
  big(n, 3)
}

fn main() -> i64 {
  hot(2)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "big") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_rejects_self_recursive_callee" {
  let src = "fn rec_sum(n: i64) -> i64 {
  if n <= 0 { 0 } else { n + rec_sum(n - 1) }
}

fn hot(n: i64) -> i64 {
  rec_sum(n) + rec_sum(n + 1)
}

fn main() -> i64 {
  hot(3)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "rec_sum") >= 1 { 1 } else { 0 }, 1)
}

-- ---------------------------------------------------------------------
-- Whole-compiler tripwire: the compiler still optimises itself with the
-- splice active and the accessor forest actually collapses somewhere.
-- ---------------------------------------------------------------------

fn mi_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "multi_inline_bench_find_loop_accessors_collapse" {
  -- The motivating workload: sorted_lookup's find loop stops calling the
  -- vector-storage accessor forest.
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = probe_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let functions = pipeline_ir_functions(optimised)
  -- vector_len swallowed vector_storage_len; sorted_map_len swallowed both.
  let total_storage_len_calls = mi_total_calls(functions, mi_hash("vector_storage_len"))
  Test.assert_eq(total_storage_len_calls, 0)
  let total_elem_size_calls = mi_total_calls(functions, mi_hash("vector_storage_element_size"))
  Test.assert_eq(total_elem_size_calls, 0)
}

test "floating table accessors inline through complete scalar lane facts" {
  -- Exercise the accessor contract directly, independently of benchmark
  -- representations. Managed/GPR inputs and FP values each have one lane.
  let src = "use stdlib/f64_table as f64_table
use stdlib/f64_table.{ F64Table }
use stdlib/option.{ Option }
fn read_cell(cells: F64Table, row: i64) -> f64 { cells.get(row, 1).unwrap() }
fn write_cell(cells: F64Table, row: i64, value: f64) -> bool { cells.set(row, 1, value) }
fn adjust(cells: F64Table, delta: f64) -> nil {
  let mut row = 0
  while row < cells.rows() {
    write_cell(cells, row, read_cell(cells, row) + delta)
    row = row + 1
  }
}
fn main() -> i64 {
  let cells = f64_table.zeros(2, 2).unwrap()
  adjust(cells, 1.5)
  if read_cell(cells, 1) == 1.5 { 0 } else { 1 }
}"
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let raw = pipeline_lower_ir(typed)
  let table_owner = mi_method_owner_in(pipeline_ir_functions(raw), mi_hash("read_cell"), mi_hash("get"))
  Test.assert_true(table_owner != 0)
  Test.assert_eq(mi_calls_in(pipeline_ir_functions(raw), mi_hash("adjust"), mi_hash("read_cell")), 1)
  Test.assert_eq(mi_calls_in(pipeline_ir_functions(raw), mi_hash("adjust"), mi_hash("write_cell")), 1)
  let facts = match typed { TypedModule(fns, source, tt, owners) -> pipeline_ir_semantic_facts_from_fns_with_tt(fns, 0, tt) }
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(table_owner, mi_hash("rows"))), cg_semantic_dense_table_role_rows())
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(table_owner, mi_hash("get"))), cg_semantic_dense_table_role_get())
  Test.assert_eq(pipeline_ir_semantic_fact_lookup_dense_table_role(facts, pipeline_ir_method_patch_key(table_owner, mi_hash("set"))), cg_semantic_dense_table_role_set())
  let optimised = pipeline_optimise_typed_ir(typed, raw)
  let functions = pipeline_ir_functions(optimised)
  let advance = mi_hash("adjust")
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  Test.assert_eq(mi_calls_in(functions, advance, mi_hash("read_cell")), 0)
  Test.assert_eq(mi_calls_in(functions, advance, mi_hash("write_cell")), 0)
  Test.assert_eq(mi_dense_role_calls_in(functions, advance, facts, cg_semantic_dense_table_role_storage_rows()), 0)
  Test.assert_eq(mi_dense_role_calls_in(functions, advance, facts, cg_semantic_dense_table_role_storage_get()), 0)
  Test.assert_eq(mi_dense_role_calls_in(functions, advance, facts, cg_semantic_dense_table_role_storage_set()), 0)
  Test.assert_eq(mi_method_calls_in(functions, advance, table_owner, mi_hash("rows")), 0)
  Test.assert_eq(mi_method_calls_in(functions, advance, table_owner, mi_hash("get")), 0)
  Test.assert_eq(mi_method_calls_in(functions, advance, table_owner, mi_hash("set")), 0)
}

fn mi_total_calls(fns_list: IrFunctionList, target_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> mi_count_calls_blocks(blocks, target_hash)
      }
      one + mi_total_calls(rest, target_hash)
    }
  }
}

fn mi_total_generic_calls(fns_list: IrFunctionList, base_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> mi_generic_calls_blocks(blocks, base_hash)
      }
      one + mi_total_generic_calls(rest, base_hash)
    }
  }
}

fn mi_generic_calls_blocks(blocks: IrBlockList, base_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> mi_generic_calls_insts(insts, base_hash)
      }
      one + mi_generic_calls_blocks(rest, base_hash)
    }
  }
}

fn mi_generic_calls_insts(insts: IrInstList, base_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrGenericCallI64(dst, callee_hash, type_args, args) -> if callee_hash == base_hash { 1 } else { 0 }
        _ -> 0
      }
      one + mi_generic_calls_insts(rest, base_hash)
    }
  }
}

-- ---------------------------------------------------------------------
-- Stage 2: managed/scalar-lane multi-block candidates (spec facts +
-- semantic ABI-shape gate)
-- ---------------------------------------------------------------------

test "multi_inline_match_bodied_spec_disappears" {
  -- Generic specs qualify through the site-driven spec facts.
  let src = "type Pair2 {
  Pair2(i64, i64)
}

fn pair2_first(p: Pair2) -> i64 {
  match p {
    Pair2(a, b) -> a
  }
}

fn hot(n: i64) -> i64 {
  let p = Pair2(n, n + 1)
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + pair2_first(p)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(5)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "pair2_first"), 0)
}

test "multi_inline_managed_return_still_balanced" {
  -- Behavioural witness compiled in-process: a managed-returning helper
  -- chain optimises and the module still verifies.
  let src = "type Box2 {
  Box2(i64)
}

fn box2_make(v: i64) -> Box2 {
  if v > 0 { Box2(v) } else { Box2(0 - v) }
}

fn box2_get(b: Box2) -> i64 {
  match b {
    Box2(v) -> v
  }
}

fn main() -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < 4 {
    acc = acc + box2_get(box2_make(i - 2))
    i = i + 1
  }
  acc
}"
  Test.assert_eq(pipeline_ir_verify_module(mi_optimised(src)), 0)
}

test "multi_inline_float_signature_disappears" {
  -- Typed IR retains both the f64 ABI lane facts and the primitive on the
  -- relocated comparison, so the old all-GPR exclusion is unnecessary.
  let src = "fn fmix(a: f64, b: f64) -> i64 {
  if a < b { 1 } else { 0 }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + fmix(1.5, 2.5)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(3)
}"
  let optimised = mi_optimised(src)
  Test.assert_eq(mi_calls_in(pipeline_ir_functions(optimised), mi_hash("hot"), mi_hash("fmix")), 0)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
}

test "multi_inline_rejects_multiword_signature" {
  -- A slice is one logical value but two physical lanes; positional scalar
  -- cloning must not pretend that it is one parameter.
  let src = "fn slice_pick(values: [i64], pick_first: bool) -> i64 {
  if pick_first { values[0] } else { values[1] }
}

fn hot(values: [i64], n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + slice_pick(values, i == 0)
    i = i + 1
  }
  acc
}

fn main(values: [i64]) -> i64 {
  hot(values, 2)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "slice_pick") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_wrapper_becomes_candidate_after_swallowing" {
  -- 1-block bodies are never candidates directly (see the gate comment),
  -- but a wrapper that swallows a branchy body in pass one becomes a
  -- multi-block candidate for the second pass, so its callers collapse
  -- the whole chain.
  let src = "fn deep(v: i64) -> i64 {
  if v == 0 { 0 } else { v * 3 }
}

fn wrap1(v: i64) -> i64 {
  deep(v)
}

fn main() -> i64 {
  wrap1(4)
}"
  Test.assert_eq(mi_caller_calls(src, "main", "wrap1"), 0)
  Test.assert_eq(mi_caller_calls(src, "wrap1", "deep"), 0)
}

test "multi_inline_sorted_chain_collapses" {
  -- The stage-2 motivating chain: the find loop's entry-key reads stop
  -- being calls (sorted_entry_key spec inlines; the storage accessors
  -- already collapsed by multi-block inlining).
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = probe_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let functions = pipeline_ir_functions(optimised)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  -- the whole chain collapsed: storage loads (B'), managed entry
  -- accessors (stage 2), and the match-bodied entry-key specs
  -- (trap-arm unlock under loop gating)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("vector_get_in_bounds")), 0)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("sorted_entry_key")), 0)
  -- the borrowed key-read chain (key_at -> get_field_in_bounds ->
  -- storage field load) must also fully collapse into the find loop:
  -- if these come back as calls, the rc-pair-free probe regressed
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("sorted_map_key_at")), 0)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("vector_get_field_in_bounds")), 0)
  -- The find result must have no boxed residue. It may either use the private
  -- scalar tag/payload ABI or disappear completely when the now-unmanaged
  -- comparator makes the whole search cheap enough to inline.
  let find_hash = mi_i64_pair_spec_hash("sorted_map_find")
  let clone_hash = mi_small_variant_lane_callee(functions, mi_hash("lookup_sweep"))
  if clone_hash == 0 - 1 {
    Test.assert_eq(mi_calls_in(functions, mi_hash("lookup_sweep"), find_hash), 0)
    Test.assert_eq(mi_small_variant_function_metric(functions, mi_hash("lookup_sweep"), 1), 0)
  } else {
    Test.assert_eq(if clone_hash != find_hash { 1 } else { 0 }, 1)
    Test.assert_eq(mi_small_variant_call_lane(functions, mi_hash("lookup_sweep"), clone_hash, 1), 1)
    Test.assert_eq(mi_small_variant_function_metric(functions, clone_hash, 6), 1)
  }
}

test "multi_inline_sorted_find_borrows_storage_without_reference_churn" {
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = probe_check_source_with_origin(csrc, clen, 1, 0)
  let functions = pipeline_ir_functions(pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed)))
  let find_hash = mi_i64_pair_spec_hash("sorted_map_find")
  Test.assert_eq(mi_calls_in(functions, find_hash, mi_hash("rc_default_retain")), 0)
  Test.assert_eq(mi_calls_in(functions, find_hash, mi_hash("rc_default_release")), 0)
}

-- ---------------------------------------------------------------------
-- scalar replacement: representation-driven small-variant scalar replacement
-- ---------------------------------------------------------------------

test "small_variant_call_lane_encoding_preserves_legacy_and_explicit_heads" {
  Test.assert_eq(ir_call_result_lane_physical(1), 1)
  Test.assert_eq(ir_call_result_lane_head(12, 1), 11)
  let encoded = ir_call_result_lane_encode_for_head(7, 1)
  Test.assert_eq(if encoded < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(ir_call_result_lane_physical(encoded), 1)
  Test.assert_eq(ir_call_result_lane_head(41, encoded), 7)
}

test "unrelated functions do not disable result specialization" {
  let producer_hash = 18001
  let caller_hash = 18002
  let mut functions = IrFunctionCons(mi_small_variant_caller(caller_hash, producer_hash, 0), IrFunctionCons(mi_small_variant_producer(producer_hash), IrFunctionNil))
  for i in 0..1100 {
    functions = IrFunctionCons(mi_small_variant_producer(20000 + i), functions)
  }
  let facts = pipeline_ir_semantic_facts_prepend(producer_hash, mi_small_variant_managed_fact(), pipeline_ir_semantic_facts_empty())
  let result = pipeline_ir_small_variant_specialise(functions, facts)
  Test.assert_eq(pipeline_ir_small_variant_specialisations_count(result), 1)
  Test.assert_eq(mi_calls_in(pipeline_ir_small_variant_specialisations_functions(result), caller_hash, producer_hash), 0)
}

test "small_variant_local_lifetime_scalarises_without_names" {
  let insts = ir_inst_list_prepend(
    IrConstI64(0, 42),
    ir_inst_list_prepend(
      IrVariantInitI64(1, 501, ir_value_list_prepend(0, ir_value_list_empty()), 0),
      ir_inst_list_prepend(
        IrVariantTagI64(2, 1),
        ir_inst_list_prepend(
          IrVariantPayloadI64(3, 1, 0),
          ir_inst_list_prepend(IrBinaryI64(4, IrAdd, 2, 3), ir_inst_list_empty())
        )
      )
    )
  )
  let function = mi_small_variant_function(8001, 0, ir_block_list_prepend(ir_block_new_term(0, insts, IrTermReturn(4)), ir_block_list_empty()))
  let rewritten = pipeline_ir_small_variant_scalarise_function_with(function, 8001, pipeline_ir_semantic_facts_empty(), pipeline_ir_small_variant_producers_empty(), nlist_new(), 0)
  let functions = ir_function_list_prepend(rewritten, ir_function_list_empty())
  Test.assert_eq(mi_small_variant_function_metric(functions, 8001, 1), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, 8001, 2), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, 8001, 3), 0)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}

fn mi_small_variant_producer(hash: i64) -> IrFunction {
  let insts = ir_inst_list_prepend(IrVariantInitI64(1, 601, ir_value_list_prepend(0, ir_value_list_empty()), 0), ir_inst_list_empty())
  mi_small_variant_function(hash, 1, ir_block_list_prepend(ir_block_new_term(0, insts, IrTermReturn(1)), ir_block_list_empty()))
}

fn mi_small_variant_caller(hash: i64, producer_hash: i64, escapes: i64) -> IrFunction {
  let tail = if escapes == 1 {
    ir_inst_list_prepend(IrCallI64(2, 999901, ir_value_list_prepend(1, ir_value_list_empty())), ir_inst_list_empty())
  } else {
    ir_inst_list_prepend(
      IrManagedStakeI64(2, 1, 1, 1, 0),
      ir_inst_list_prepend(
        IrVariantTagI64(3, 2),
        ir_inst_list_prepend(
          IrVariantPayloadI64(4, 2, 0),
          ir_inst_list_prepend(IrBinaryI64(5, IrAdd, 3, 4), ir_inst_list_empty())
        )
      )
    )
  }
  let insts = ir_inst_list_prepend(IrCallI64(1, producer_hash, ir_value_list_prepend(0, ir_value_list_empty())), tail)
  mi_small_variant_function(hash, 1, ir_block_list_prepend(ir_block_new_term(0, insts, if escapes == 1 { IrTermReturn(2) } else { IrTermReturn(5) }), ir_block_list_empty()))
}

test "small_variant_interprocedural_transport_keeps_canonical_abi" {
  let producer_hash = 8101
  let caller_hash = 8102
  let producer = mi_small_variant_producer(producer_hash)
  let caller = mi_small_variant_caller(caller_hash, producer_hash, 0)
  let input = ir_function_list_prepend(caller, ir_function_list_prepend(producer, ir_function_list_empty()))
  let facts = pipeline_ir_semantic_facts_prepend(producer_hash, mi_small_variant_managed_fact(), pipeline_ir_semantic_facts_empty())
  let result = pipeline_ir_small_variant_specialise(input, facts)
  let functions = pipeline_ir_small_variant_specialisations_functions(result)
  let clone_hash = pipeline_ir_small_variant_producer_hash(producer_hash)
  Test.assert_eq(pipeline_ir_small_variant_specialisations_count(result), 1)
  -- External/unknown callers retain the boxed producer.
  Test.assert_eq(mi_small_variant_function_metric(functions, producer_hash, 1), 1)
  -- Proven callers use a private two-register producer clone.
  Test.assert_eq(mi_calls_in(functions, caller_hash, producer_hash), 0)
  Test.assert_eq(mi_calls_in(functions, caller_hash, clone_hash), 1)
  Test.assert_eq(mi_small_variant_function_metric(functions, caller_hash, 2), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, caller_hash, 3), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, caller_hash, 4), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, clone_hash, 1), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, clone_hash, 6), 1)
  Test.assert_eq(mi_small_variant_call_lane(functions, caller_hash, clone_hash, 1), 1)
  Test.assert_eq(mi_small_variant_call_lane(functions, caller_hash, clone_hash, 2), 1)
  Test.assert_eq(if mi_small_variant_call_lane(functions, caller_hash, clone_hash, 3) < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}

test "small_variant_escape_keeps_boxed_transport_and_emits_no_clone" {
  let producer_hash = 8201
  let caller_hash = 8202
  let producer = mi_small_variant_producer(producer_hash)
  let caller = mi_small_variant_caller(caller_hash, producer_hash, 1)
  let input = ir_function_list_prepend(caller, ir_function_list_prepend(producer, ir_function_list_empty()))
  let facts = pipeline_ir_semantic_facts_prepend(producer_hash, mi_small_variant_managed_fact(), pipeline_ir_semantic_facts_empty())
  let result = pipeline_ir_small_variant_specialise(input, facts)
  let functions = pipeline_ir_small_variant_specialisations_functions(result)
  Test.assert_eq(pipeline_ir_small_variant_specialisations_count(result), 0)
  Test.assert_eq(mi_calls_in(functions, caller_hash, producer_hash), 1)
  Test.assert_eq(mi_small_variant_function_metric(functions, caller_hash, 5), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, producer_hash, 1), 1)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}

fn mi_small_variant_join_producer(hash: i64, trap_else: i64) -> IrFunction {
  let entry = ir_block_new_term(0, ir_inst_list_empty(), IrTermBranch(0, 1, 2))
  let variant = ir_inst_list_prepend(
    IrConstI64(1, 9),
    ir_inst_list_prepend(IrVariantInitI64(2, 701, ir_value_list_prepend(1, ir_value_list_empty()), 0), ir_inst_list_empty())
  )
  let left = ir_block_new_term(1, variant, IrTermJump(3, ir_value_list_prepend(2, ir_value_list_empty())))
  let right = if trap_else == 1 {
    ir_block_new_term(2, ir_inst_list_prepend(IrLoweringFailureI64(77), ir_inst_list_empty()), IrTermJump(3, ir_value_list_prepend(0, ir_value_list_empty())))
  } else {
    ir_block_new_term(2, ir_inst_list_prepend(IrConstI64(3, 0), ir_inst_list_empty()), IrTermJump(3, ir_value_list_prepend(3, ir_value_list_empty())))
  }
  let join = ir_block_new_params(3, ir_value_list_prepend(4, ir_value_list_empty()), ir_inst_list_empty(), IrTermReturn(4))
  mi_small_variant_function(hash, 1, ir_block_list_prepend(entry, ir_block_list_prepend(left, ir_block_list_prepend(right, ir_block_list_prepend(join, ir_block_list_empty())))))
}

test "small_variant_join_ignores_nonreturning_trap_predecessor" {
  let hash = 8301
  let function = mi_small_variant_join_producer(hash, 1)
  let fact = cg_semantic_fact_new_raw(0, 1, 0, 1, 1, 0, 1, 0)
  let facts = pipeline_ir_semantic_facts_prepend(hash, fact, pipeline_ir_semantic_facts_empty())
  pipeline_ir_fresh_return_enrich(ir_function_list_prepend(function, ir_function_list_empty()), facts)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(fact), 1)
  Test.assert_eq(pipeline_ir_small_variant_producer_eligible(function, facts), 1)
}

test "small_variant_join_rejects_reachable_noncandidate_predecessor" {
  let hash = 8302
  let function = mi_small_variant_join_producer(hash, 0)
  let facts = pipeline_ir_semantic_facts_prepend(hash, mi_small_variant_managed_fact(), pipeline_ir_semantic_facts_empty())
  Test.assert_eq(pipeline_ir_small_variant_producer_eligible(function, facts), 0)
}

test "mixed immediate and managed returns have a scalar representation without a fresh managed claim" {
  let hash = 18303
  let entry = IrBlock(0, IrValueNil, IrInstNil, IrTermBranch(0, 1, 2))
  let present = IrBlock(1, IrValueNil, IrInstCons(IrVariantInitI64(2, 710, IrValueCons(1, IrValueNil), 0), IrInstNil), IrTermJump(3, IrValueCons(2, IrValueNil)))
  let absent = IrBlock(2, IrValueNil, IrInstCons(IrVariantInitI64(3, 711, IrValueNil, 0), IrInstNil), IrTermJump(3, IrValueCons(3, IrValueNil)))
  let join = IrBlock(3, IrValueCons(4, IrValueNil), IrInstNil, IrTermReturn(4))
  let function = IrFunction(hash, 2, IrBlockListCons(entry, IrBlockListCons(present, IrBlockListCons(absent, IrBlockListCons(join, IrBlockListNil)))), 0)
  let fact = cg_semantic_fact_new_raw(0, 1, 0, 1, 1, 0, 1, 0)
  let facts = pipeline_ir_semantic_facts_prepend(hash, fact, pipeline_ir_semantic_facts_empty())
  pipeline_ir_fresh_return_enrich(IrFunctionCons(function, IrFunctionNil), facts)
  Test.assert_eq(cg_semantic_fact_fresh_managed_return(fact), 0)
  Test.assert_eq(pipeline_ir_small_variant_producer_eligible(function, facts), 1)
  let scalar = pipeline_ir_small_variant_scalarise_function_with(function, hash + 1, facts, pipeline_ir_small_variant_producers_empty(), nlist_new(), 1)
  let census = pipeline_rc_site_census_new()
  pipeline_rc_site_census_functions(IrFunctionCons(scalar, IrFunctionNil), census)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0), 0)
  Test.assert_eq(pipeline_ir_verify_function(scalar), 0)
}

test "small_variant_shape_gate_rejects_managed_and_wide_payloads" {
  let one = ir_value_list_prepend(1, ir_value_list_empty())
  let two = ir_value_list_prepend(1, ir_value_list_prepend(2, ir_value_list_empty()))
  Test.assert_eq(pipeline_ir_small_variant_constructor_eligible(IrVariantInitI64(3, 801, one, 0)), 1)
  Test.assert_eq(pipeline_ir_small_variant_constructor_eligible(IrVariantInitI64(3, 801, one, 1)), 0)
  Test.assert_eq(pipeline_ir_small_variant_constructor_eligible(IrVariantInitI64(3, 801, two, 0)), 0)
  Test.assert_eq(pipeline_ir_small_variant_constructor_eligible(IrVariantInitI64(3, 801, ir_value_list_empty(), 0)), 1)
}

test "payloadless constructors preserve identity without managed storage" {
  let src = "type Direction {
  Before,
  Same,
  After
}

fn choose(flag: bool) -> Direction {
  if flag { Before } else { After }
}

fn rank(direction: Direction) -> i64 {
  match direction {
    Before -> 0 - 1
    Same -> 0
    After -> 1
  }
}

fn main() -> i64 {
  rank(choose(true))
}"
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let functions = pipeline_ir_functions(pipeline_lower_ir(typed))
  Test.assert_eq(mi_small_variant_function_metric(functions, mi_hash("choose"), 1), 2)
  let census = pipeline_rc_site_census_new()
  pipeline_rc_site_census_functions(pipeline_ir_function_list_find_hash(functions, mi_hash("choose")), census)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, mi_hash("choose"), 4), 0)
  Test.assert_eq(mi_small_variant_function_metric(functions, mi_hash("rank"), 4), 0)
  Test.assert_eq(pipeline_ir_verify_module(pipeline_ir_module(functions)), 0)
}


-- ---------------------------------------------------------------------
-- Loop gating: cold sites in large hosts keep their calls
-- ---------------------------------------------------------------------

test "multi_inline_fatal_boundaries_keep_their_native_frame" {
  let src = "use stdlib/panic.{ * }
fn stop_here() -> i64 { panic(\"the input is unavailable\") }
fn read_or_stop(value: i64) -> i64 { if value > 0 { value } else { stop_here() } }
fn main(value: i64) -> i64 { read_or_stop(value) }"
  Test.assert_eq(mi_caller_calls(src, "main", "read_or_stop"), 0)
  Test.assert_eq(mi_caller_calls(src, "main", "stop_here"), 1)
  Test.assert_eq(pipeline_ir_verify_module(mi_optimised(src)), 0)
}

test "generic straight bodies preserve the checked never result" {
  let src = "use stdlib/panic.{ * }
fn stop_with<T>(value: T) -> i64 { panic(\"the input is unavailable\") }
fn main() -> i64 { stop_with<i64>(42) }"
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let prefix = pipeline_typed_optimisation_prefix(typed, pipeline_lower_ir(typed))
  let lowered = pipeline_ir_module(pipeline_typed_optimisation_prefix_functions(prefix))
  let args = nlist_new()
  nlist_add(args, ty_i64())
  let hash = mono_spec_hash(mi_hash("stop_with"), args)
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(lowered), hash) {
    IrFunctionCons(IrFunction(found, count, blocks, origin), IrFunctionNil) -> {
      Test.assert_eq(pipeline_ir_multi_return_count(blocks), 0)
      Test.assert_eq(ir_block_list_count_term_tag(blocks, 4), 1)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(pipeline_ir_verify_module(lowered), 0)
}

test "multi_inline_cold_site_in_large_host_stays_call" {
  -- The host exceeds the small-host threshold (many branches) and the
  -- call site sits outside every loop: splicing is skipped there.
  let src = "fn picky(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn big_host(x: i64) -> i64 {
  let a = if x > 1 { x } else { 1 }
  let b = if a > 2 { a } else { 2 }
  let c = if b > 3 { b } else { 3 }
  let d = if c > 4 { c } else { 4 }
  let e = if d > 5 { d } else { 5 }
  let f = if e > 6 { e } else { 6 }
  picky(f, x)
}

fn main() -> i64 {
  big_host(9)
}"
  Test.assert_eq(if mi_caller_calls(src, "big_host", "picky") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_loop_site_in_large_host_splices" {
  -- Same large host, but the call sits inside a while loop: it splices.
  let src = "fn picky(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn big_host(x: i64) -> i64 {
  let a = if x > 1 { x } else { 1 }
  let b = if a > 2 { a } else { 2 }
  let c = if b > 3 { b } else { 3 }
  let d = if c > 4 { c } else { 4 }
  let e = if d > 5 { d } else { 5 }
  let f = if e > 6 { e } else { 6 }
  let mut acc = 0
  let mut i = 0
  while i < f {
    acc = acc + picky(i, x)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  big_host(9)
}"
  Test.assert_eq(mi_caller_calls(src, "big_host", "picky"), 0)
}

-- ---------------------------------------------------------------------
-- Emission-intercepted generic call sites stay opaque (1-block miswire
-- root cause): the backend substitutes per-spec constants (element
-- size/mode) or byte-accurate inline-record code at these sites, so the
-- optimiser must never resolve them to their collected spec bodies.
-- ---------------------------------------------------------------------

test "multi_inline_single_block_const_wrapper_disappears" {
  -- The ex-culprit SHAPE — a 1-block constant-returning function — is
  -- safe to splice when it is a real function (the miswire was the
  -- intrinsic placeholder, not the splice mechanics).
  let src = "fn word_mode() -> i64 { 0 }

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + word_mode() + i
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "word_mode"), 0)
}

test "layout facts supply real storage answers instead of inlining placeholder bodies" {
  let src = "use stdlib/vector.{ vector_element_size_of, vector_element_mode_of }
fn size() -> i64 { vector_element_size_of<u16>() }
fn mode() -> i64 { vector_element_mode_of<str>() }
fn main() -> i64 { size() + mode() }"
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(mi_total_generic_calls(pipeline_ir_functions(lowered), pipeline_ir_native_vector_element_size_of_hash()), 1)
  Test.assert_eq(mi_total_generic_calls(pipeline_ir_functions(lowered), pipeline_ir_native_vector_element_mode_of_hash()), 1)
  let optimized = pipeline_optimise_typed_ir(typed, lowered)
  let functions = pipeline_ir_functions(optimized)
  for (name, expected) in [("size", 2), ("mode", 8)] {
    match pipeline_ir_function_list_find_hash(functions, mi_hash(name)) {
      IrFunctionCons(IrFunction(_, _, IrBlockListCons(IrBlock(_, _, insts, IrTermReturn(value)), IrBlockListNil), _), _) -> {
        let answer = pipeline_ir_inst_list_const_def_lookup(insts, value)
        Test.assert_eq(pipeline_ir_const_lookup_valid(answer), 1)
        Test.assert_eq(pipeline_ir_const_lookup_value(answer), expected)
      }
      _ -> Test.assert_true(false)
    }
  }
  Test.assert_eq(pipeline_ir_verify_module(optimized), 0)
}

test "packed record transport exposes typed storage before inlining" {
  -- Packed fields must keep their byte widths through optimization. The
  -- shared layout lowering removes the storage shims before ordinary
  -- call inlining can substitute their word-generic fallback bodies.
  let src = "use stdlib/vector as vector use stdlib/vector.{*}
use stdlib/option.{ Some, None }

type Pack3 { a: u8, b: i8, ok: bool }

fn pk(a: u8, b: i8, ok: bool) -> Pack3 {
  Pack3 { a: a, b: b, ok: ok }
}

fn main() -> i64 {
  let mut v = vector.with_capacity<Pack3>(2)
  v.push(pk(250, -8, true))
  match v.get(0) {
    Some(got) -> if got.a == 250 and got.b == -8 and got.ok { 0 } else { 1 }
    None -> 2
  }
}"
  let optimized = mi_optimised(src)
  let file_functions = pipeline_ir_functions(optimized)
  Test.assert_eq(mi_total_generic_calls(file_functions, mi_hash("vector_store_value")) + mi_total_generic_calls(file_functions, mi_hash("vector_storage_store_value")), 0)
  Test.assert_eq(mi_total_generic_calls(file_functions, mi_hash("vector_load_value")) + mi_total_generic_calls(file_functions, mi_hash("vector_storage_load_value")) + mi_total_generic_calls(file_functions, mi_hash("vector_storage_load_value_in_bounds")), 0)
  Test.assert_eq(pipeline_ir_verify_module(optimized), 0)
}
