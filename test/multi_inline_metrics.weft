-- test/multi_inline_metrics.weft -- multi-block tiny-fn inlining (2k slice B')
--
-- The optimiser splices small pure unmanaged-param callees with branchy
-- bodies (null-guarded accessors, comparators) into callers. These tests
-- compile source in-process and assert on the optimised IR: inlined calls
-- are gone, ineligible calls remain, and the spliced CFG stays sound.

use "compiler/codegen.weft"
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"

fn mi_optimised(src_str: str) -> IrModule {
  let src = __str_ptr(src_str)
  let n = __str_len(src_str)
  let typed = pipeline_check_source_with_origin(src, n, 1, 0)
  let ir = pipeline_lower_ir(typed)
  pipeline_optimise_typed_ir(typed, ir)
}

fn mi_count_calls_insts(insts: IrInstList, target_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee_hash, args) -> if callee_hash == target_hash { 1 } else { 0 }
        _ -> 0
      }
      one + mi_count_calls_insts(rest, target_hash)
    }
  }
}

fn mi_count_calls_blocks(blocks: IrBlockList, target_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> mi_count_calls_insts(insts, target_hash)
      }
      one + mi_count_calls_blocks(rest, target_hash)
    }
  }
}

fn mi_calls_in(fns_list: IrFunctionList, fn_hash: i64, target_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, nparams, blocks, src) -> {
          if hash == fn_hash {
            mi_count_calls_blocks(blocks, target_hash)
          } else {
            mi_calls_in(rest, fn_hash, target_hash)
          }
        }
      }
    }
  }
}

fn mi_hash(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

fn mi_i64_pair_spec_hash(name: str) -> i64 {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  nlist_add(args, ty_i64())
  mono_spec_hash(mi_hash(name), args)
}

fn mi_caller_calls(src_str: str, caller: str, callee: str) -> i64 {
  mi_calls_in(pipeline_ir_functions(mi_optimised(src_str)), mi_hash(caller), mi_hash(callee))
}

-- ---------------------------------------------------------------------
-- Happy paths
-- ---------------------------------------------------------------------

test "multi_inline_null_guarded_accessor_disappears" {
  -- The vector_storage accessor shape: null guard around a raw load.
  let src = "fn guarded_load(vec: i64) -> i64 {
  if vec == 0 { 0 } else { vec * 3 + 7 }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + guarded_load(i)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "guarded_load"), 0)
}

test "multi_inline_comparator_shape_disappears" {
  -- Nested-if comparator: six blocks, pure scalar.
  let src = "fn cmp3(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + cmp3(i, 5)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "cmp3"), 0)
}

test "multi_inline_wrapper_chain_collapses" {
  -- Wrapper -> guarded body: the wrapper swallows the branchy body in
  -- pass one; callers swallow the wrapper via the rebuilt candidates.
  let src = "fn guarded(vec: i64) -> i64 {
  if vec == 0 { 0 } else { vec * 5 }
}

fn wrapper(vec: i64) -> i64 {
  guarded(vec)
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + wrapper(i)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "wrapper"), 0)
  Test.assert_eq(mi_caller_calls(src, "hot", "guarded"), 0)
}

test "multi_inline_multiple_sites_one_block" {
  let src = "fn pick(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn hot(x: i64, y: i64, z: i64) -> i64 {
  pick(x, y) + pick(y, z) + pick(x, z)
}

fn main() -> i64 {
  hot(1, 2, 3)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "pick"), 0)
}

test "multi_inline_sites_counted" {
  let src = "fn pick(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn hot(x: i64, y: i64) -> i64 {
  pick(x, y)
}

fn main() -> i64 {
  hot(1, 2)
}"
  let optimised = mi_optimised(src)
  -- multi splices merge into the direct-call inline site counter
  Test.assert_eq(if pipeline_ir_direct_call_inline_sites(optimised) >= 1 { 1 } else { 0 }, 1)
}

-- ---------------------------------------------------------------------
-- Sad paths: every ineligibility reason leaves the call in place
-- ---------------------------------------------------------------------

test "multi_inline_rejects_raw_store_body" {
  -- Store-shaped bodies (vector set) are outside the clone whitelist.
  let src = "use \"stdlib/vector.weft\"

fn poke(v: i64, i: i64) -> i64 {
  if v == 0 { 0 } else { vector_set<i64>(v, i, i) }
}

fn hot(n: i64) -> i64 {
  let mut i = 0
  while i < n {
    poke(0, i)
    i = i + 1
  }
  n
}

fn main() -> i64 {
  hot(3)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "poke") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_match_bodied_accessor_disappears" {
  -- Match-bodied accessors carry the unmatched-arm trap inst; under
  -- loop-gated splicing they are affordable candidates, and lowered
  -- bodies embed their whole ownership protocol, so managed-parameter
  -- accessors splice like any other candidate.
  let src = "type Wrap {
  Wrap(i64)
}

fn unwrap_w(w: Wrap) -> i64 {
  match w {
    Wrap(v) -> if v > 0 { v } else { 0 - v }
  }
}

fn hot(n: i64) -> i64 {
  let w = Wrap(n)
  unwrap_w(w) + unwrap_w(w)
}

fn main() -> i64 {
  hot(4)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "unwrap_w"), 0)
}

test "multi_inline_rejects_effectful_callee" {
  let src = "effect Tick {
  fn bump() -> i64
}

fn noisy(a: i64) -> i64 {
  if a > 0 { Tick.bump() } else { 0 }
}

fn hot(n: i64) -[Tick]> i64 {
  noisy(n) + noisy(n + 1)
}

fn main() -> i64 {
  handle hot(3) {
    Tick.bump() -> resume(1)
  }
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "noisy") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_rejects_oversize_body" {
  -- Body over the inst cap stays a call.
  let src = "fn big(a: i64, b: i64) -> i64 {
  if a == 0 { 0 } else {
    let c1 = a * 3 + b
    let c2 = c1 * 5 + a
    let c3 = c2 * 7 + b
    let c4 = c3 * 9 + a
    let c5 = c4 * 11 + b
    let c6 = c5 * 13 + a
    let c7 = c6 * 15 + b
    let c8 = c7 * 17 + a
    let c9 = c8 * 19 + b
    let c10 = c9 * 21 + a
    let c11 = c10 * 23 + b
    let c12 = c11 * 25 + a
    let c13 = c12 * 27 + b
    let c14 = c13 * 29 + a
    let c15 = c14 * 31 + b
    let c16 = c15 * 33 + a
    c16 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15
  }
}

fn hot(n: i64) -> i64 {
  big(n, 3)
}

fn main() -> i64 {
  hot(2)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "big") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_rejects_self_recursive_callee" {
  let src = "fn rec_sum(n: i64) -> i64 {
  if n <= 0 { 0 } else { n + rec_sum(n - 1) }
}

fn hot(n: i64) -> i64 {
  rec_sum(n) + rec_sum(n + 1)
}

fn main() -> i64 {
  hot(3)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "rec_sum") >= 1 { 1 } else { 0 }, 1)
}

-- ---------------------------------------------------------------------
-- Whole-compiler tripwire: the compiler still optimises itself with the
-- splice active and the accessor forest actually collapses somewhere.
-- ---------------------------------------------------------------------

fn mi_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "multi_inline_bench_find_loop_accessors_collapse" {
  -- The motivating workload: sorted_lookup's find loop stops calling the
  -- vector-storage accessor forest.
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let functions = pipeline_ir_functions(optimised)
  -- vector_len swallowed vector_storage_len; sorted_map_len swallowed both.
  let total_storage_len_calls = mi_total_calls(functions, mi_hash("vector_storage_len"))
  Test.assert_eq(total_storage_len_calls, 0)
  let total_elem_size_calls = mi_total_calls(functions, mi_hash("vector_storage_element_size"))
  Test.assert_eq(total_elem_size_calls, 0)
}

fn mi_total_calls(fns_list: IrFunctionList, target_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> mi_count_calls_blocks(blocks, target_hash)
      }
      one + mi_total_calls(rest, target_hash)
    }
  }
}

fn mi_total_generic_calls(fns_list: IrFunctionList, base_hash: i64) -> i64 {
  match fns_list {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> {
      let one = match f {
        IrFunction(hash, nparams, blocks, src) -> mi_generic_calls_blocks(blocks, base_hash)
      }
      one + mi_total_generic_calls(rest, base_hash)
    }
  }
}

fn mi_generic_calls_blocks(blocks: IrBlockList, base_hash: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> mi_generic_calls_insts(insts, base_hash)
      }
      one + mi_generic_calls_blocks(rest, base_hash)
    }
  }
}

fn mi_generic_calls_insts(insts: IrInstList, base_hash: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrGenericCallI64(dst, callee_hash, type_args, args) -> if callee_hash == base_hash { 1 } else { 0 }
        _ -> 0
      }
      one + mi_generic_calls_insts(rest, base_hash)
    }
  }
}

-- ---------------------------------------------------------------------
-- Stage 2: managed multi-block candidates (spec facts + word-call gate)
-- ---------------------------------------------------------------------

test "multi_inline_match_bodied_spec_disappears" {
  -- Generic specs qualify through the site-driven spec facts.
  let src = "type Pair2 {
  Pair2(i64, i64)
}

fn pair2_first(p: Pair2) -> i64 {
  match p {
    Pair2(a, b) -> a
  }
}

fn hot(n: i64) -> i64 {
  let p = Pair2(n, n + 1)
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + pair2_first(p)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(5)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "pair2_first"), 0)
}

test "multi_inline_managed_return_still_balanced" {
  -- Behavioural witness compiled in-process: a managed-returning helper
  -- chain optimises and the module still verifies.
  let src = "type Box2 {
  Box2(i64)
}

fn box2_make(v: i64) -> Box2 {
  if v > 0 { Box2(v) } else { Box2(0 - v) }
}

fn box2_get(b: Box2) -> i64 {
  match b {
    Box2(v) -> v
  }
}

fn main() -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < 4 {
    acc = acc + box2_get(box2_make(i - 2))
    i = i + 1
  }
  acc
}"
  Test.assert_eq(pipeline_ir_verify_module(mi_optimised(src)), 0)
}

test "multi_inline_rejects_float_signature" {
  -- f64 params/returns cross the boundary in FP registers the scalar
  -- clone path does not model: the word-call gate keeps the call.
  let src = "fn fmix(a: f64, b: f64) -> i64 {
  if a < b { 1 } else { 0 }
}

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + fmix(1.5, 2.5)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(3)
}"
  Test.assert_eq(if mi_caller_calls(src, "hot", "fmix") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_wrapper_becomes_candidate_after_swallowing" {
  -- 1-block bodies are never candidates directly (see the gate comment),
  -- but a wrapper that swallows a branchy body in pass one becomes a
  -- multi-block candidate for the second pass, so its callers collapse
  -- the whole chain.
  let src = "fn deep(v: i64) -> i64 {
  if v == 0 { 0 } else { v * 3 }
}

fn wrap1(v: i64) -> i64 {
  deep(v)
}

fn main() -> i64 {
  wrap1(4)
}"
  Test.assert_eq(mi_caller_calls(src, "main", "wrap1"), 0)
  Test.assert_eq(mi_caller_calls(src, "wrap1", "deep"), 0)
}

test "multi_inline_sorted_chain_collapses" {
  -- The stage-2 motivating chain: the find loop's entry-key reads stop
  -- being calls (sorted_entry_key spec inlines; the storage accessors
  -- already collapsed in slice B').
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let functions = pipeline_ir_functions(optimised)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
  -- the whole chain collapsed: storage loads (B'), managed entry
  -- accessors (stage 2), and the match-bodied entry-key specs
  -- (trap-arm unlock under loop gating)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("vector_get_in_bounds")), 0)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("sorted_entry_key")), 0)
  -- the borrowed key-read chain (key_at -> get_field_in_bounds ->
  -- storage field load) must also fully collapse into the find loop:
  -- if these come back as calls, the rc-pair-free probe regressed
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("sorted_map_key_at")), 0)
  Test.assert_eq(mi_total_generic_calls(functions, mi_hash("vector_get_field_in_bounds")), 0)
}

test "multi_inline_sorted_find_unwraps_storage_once" {
  let file = read_file(mi_path_pair("bench/compare/weft/sorted_lookup.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let functions = pipeline_ir_functions(pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed)))
  let find_hash = mi_i64_pair_spec_hash("sorted_map_find")
  Test.assert_eq(mi_calls_in(functions, find_hash, mi_hash("rc_default_retain")), 1)
  Test.assert_eq(mi_calls_in(functions, find_hash, mi_hash("rc_default_release")), 0)
}


-- ---------------------------------------------------------------------
-- Loop gating: cold sites in large hosts keep their calls
-- ---------------------------------------------------------------------

test "multi_inline_cold_site_in_large_host_stays_call" {
  -- The host exceeds the small-host threshold (many branches) and the
  -- call site sits outside every loop: splicing is skipped there.
  let src = "fn picky(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn big_host(x: i64) -> i64 {
  let a = if x > 1 { x } else { 1 }
  let b = if a > 2 { a } else { 2 }
  let c = if b > 3 { b } else { 3 }
  let d = if c > 4 { c } else { 4 }
  let e = if d > 5 { d } else { 5 }
  let f = if e > 6 { e } else { 6 }
  picky(f, x)
}

fn main() -> i64 {
  big_host(9)
}"
  Test.assert_eq(if mi_caller_calls(src, "big_host", "picky") >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_loop_site_in_large_host_splices" {
  -- Same large host, but the call sits inside a while loop: it splices.
  let src = "fn picky(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn big_host(x: i64) -> i64 {
  let a = if x > 1 { x } else { 1 }
  let b = if a > 2 { a } else { 2 }
  let c = if b > 3 { b } else { 3 }
  let d = if c > 4 { c } else { 4 }
  let e = if d > 5 { d } else { 5 }
  let f = if e > 6 { e } else { 6 }
  let mut acc = 0
  let mut i = 0
  while i < f {
    acc = acc + picky(i, x)
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  big_host(9)
}"
  Test.assert_eq(mi_caller_calls(src, "big_host", "picky"), 0)
}

-- ---------------------------------------------------------------------
-- Emission-intercepted generic call sites stay opaque (1-block miswire
-- root cause): the backend substitutes per-spec constants (element
-- size/mode) or byte-accurate inline-record code at these sites, so the
-- optimiser must never resolve them to their collected spec bodies.
-- ---------------------------------------------------------------------

test "multi_inline_single_block_const_wrapper_disappears" {
  -- The ex-culprit SHAPE — a 1-block constant-returning function — is
  -- safe to splice when it is a real function (the miswire was the
  -- intrinsic placeholder, not the splice mechanics).
  let src = "fn word_mode() -> i64 { 0 }

fn hot(n: i64) -> i64 {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + word_mode() + i
    i = i + 1
  }
  acc
}

fn main() -> i64 {
  hot(10)
}"
  Test.assert_eq(mi_caller_calls(src, "hot", "word_mode"), 0)
}

test "multi_inline_constant_intrinsic_sites_stay_calls" {
  -- vector_element_size_of / vector_element_mode_of spec bodies are
  -- `const 0` placeholders; emission substitutes the real per-spec
  -- value. Splicing them wired element mode 0 into managed vectors
  -- (keys read back as freed-slot garbage). The sites must survive to
  -- emission for every element class, including managed (str).
  let src = "use \"stdlib/vector.weft\"

fn main() -> i64 {
  let v = vector_with_capacity<str>(2)
  vector_push<str>(v, \"a\")
  vector_len(v)
}"
  let file_functions = pipeline_ir_functions(mi_optimised(src))
  Test.assert_eq(if mi_total_generic_calls(file_functions, mi_hash("vector_element_size_of")) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if mi_total_generic_calls(file_functions, mi_hash("vector_element_mode_of")) >= 1 { 1 } else { 0 }, 1)
}

test "multi_inline_inline_record_load_store_sites_stay_calls" {
  -- For inline-record element types the vector store/load family is
  -- emission-intercepted with byte-accurate copies; the word-generic
  -- spec bodies must not splice in their place (packed i8/bool fields
  -- read back as zero when they do).
  let src = "use \"stdlib/vector.weft\"

type Pack3 { a: u8, b: i8, ok: bool }

fn pk(a: i64, b: i64, ok: bool) -> Pack3 {
  Pack3 { a: num_i64_to_u8(a), b: num_i64_to_i8(b), ok: ok }
}

fn main() -> i64 {
  let v = vector_with_capacity<Pack3>(2)
  vector_push<Pack3>(v, pk(250, 0 - 8, true))
  let got = vector_get<Pack3>(v, 0, pk(0, 0, false))
  if got.ok { 1 } else { 0 }
}"
  let file_functions = pipeline_ir_functions(mi_optimised(src))
  Test.assert_eq(if mi_total_generic_calls(file_functions, mi_hash("vector_storage_store_value")) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(if mi_total_generic_calls(file_functions, mi_hash("vector_load_value")) + mi_total_generic_calls(file_functions, mi_hash("vector_storage_load_value")) >= 1 { 1 } else { 0 }, 1)
}
