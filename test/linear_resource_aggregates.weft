-- Source-level conformance for finite aggregate shapes containing owned
-- resources. Each test observes the exact Drop sequence rather than merely
-- accepting the type, so construction transfer and both cleanup edges remain
-- part of the contract.

use runtime/defer_order_test.{OwnedAbortToken, defer_order_log_new, defer_order_log_read, defer_order_log_write, owned_abort_token_new}
use module_fixtures/linear_resource_boundary.{linear_resource_imported_consume, linear_resource_imported_result}
use stdlib/fail.{Fail}
use stdlib/result.{Result, result_err, result_ok}
use stdlib/string.{str_len}

type LinearResourceRecord {
  code: i64,
  token: owned OwnedAbortToken
}

type LinearResourceVariant {
  LinearResourceEmpty,
  LinearResourceHeld(i64, owned OwnedAbortToken)
}

type LinearResourceLoopStep {
  LinearResourceLoopAgain(owned OwnedAbortToken),
  LinearResourceLoopDone(owned OwnedAbortToken)
}

type LinearResourceEnvelope {
  result: Result<owned OwnedAbortToken, i64>,
  trailer: i64
}

type LinearResourceOpaque = opaque LinearResourceRecord

effect LinearResourceAbort {
  fn stop(value: i64) -> i64
}

effect LinearResourceTransport {
  fn take(value: Result<owned OwnedAbortToken, i64>) -> i64
}

type LinearResourceEffectToken {
  log: i64,
  digit: i64
}

effect LinearResourceOwner {
  fn make(log: i64, digit: i64) -> owned LinearResourceEffectToken
  fn discard(value: owned LinearResourceEffectToken) -> i64
  fn release(log: i64, digit: i64) -> i64
}

impl Drop for LinearResourceEffectToken {
  fn drop(self) -[LinearResourceOwner]> i64 {
    LinearResourceOwner.release(self.log, self.digit)
  }
}

fn linear_resource_effect_token_new(log: i64, digit: i64) -> owned LinearResourceEffectToken {
  LinearResourceEffectToken { log: log, digit: digit }
}

fn linear_resource_result_ok(log: i64, digit: i64) -> Result<owned OwnedAbortToken, i64> {
  result_ok<owned OwnedAbortToken, i64>(owned_abort_token_new(log, digit))
}

fn linear_resource_result_err() -> Result<owned OwnedAbortToken, i64> {
  result_err<owned OwnedAbortToken, i64>(7)
}

fn linear_resource_drop_ok_local(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 1)
  42
}

fn linear_resource_drop_err_local(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_err()
  42
}

fn linear_resource_drop_record_local(log: i64) -> i64 {
  let held: LinearResourceRecord = LinearResourceRecord {
    code: 7,
    token: owned_abort_token_new(log, 2)
  }
  42
}

fn linear_resource_drop_tuple_local(log: i64) -> i64 {
  let held: (i64, owned OwnedAbortToken) = (7, owned_abort_token_new(log, 3))
  42
}

fn linear_resource_drop_variant_local(log: i64) -> i64 {
  let held: LinearResourceVariant = LinearResourceHeld(7, owned_abort_token_new(log, 4))
  42
}

fn linear_resource_drop_empty_variant_local(log: i64) -> i64 {
  let held: LinearResourceVariant = LinearResourceEmpty
  42
}

fn linear_resource_drop_nested_local(log: i64) -> i64 {
  let held: LinearResourceEnvelope = LinearResourceEnvelope {
    result: linear_resource_result_ok(log, 5),
    trailer: 9
  }
  42
}

fn linear_resource_drop_before_return(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 6)
  return 42
}

fn linear_resource_abort_ok_local(log: i64) -[LinearResourceAbort]> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 7)
  LinearResourceAbort.stop(42) + 1000
}

fn linear_resource_abort_err_local(log: i64) -[LinearResourceAbort]> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_err()
  LinearResourceAbort.stop(42) + 1000
}

fn linear_resource_consume_result(value: Result<owned OwnedAbortToken, i64>) -> i64 {
  51
}

fn linear_resource_consume_generic<T, E>(value: Result<T, E>) -> i64 {
  52
}

fn linear_resource_return_result(value: Result<owned OwnedAbortToken, i64>) -> Result<owned OwnedAbortToken, i64> {
  value
}

fn linear_resource_move_direct(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 8)
  linear_resource_consume_result(held)
}

fn linear_resource_move_generic(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 9)
  linear_resource_consume_generic<owned OwnedAbortToken, i64>(held)
}

fn linear_resource_move_through_return(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 1)
  let returned: Result<owned OwnedAbortToken, i64> = linear_resource_return_result(held)
  linear_resource_consume_result(returned)
}

fn linear_resource_abort_in_callee(value: Result<owned OwnedAbortToken, i64>) -[LinearResourceAbort]> i64 {
  LinearResourceAbort.stop(53)
}

fn linear_resource_move_then_abort(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 2)
  handle linear_resource_abort_in_callee(held) {
    LinearResourceAbort.stop(value) -> value
  }
}

fn linear_resource_inline_move(log: i64) -> i64 {
  linear_resource_consume_result(linear_resource_result_ok(log, 3))
}

fn linear_resource_inline_move_then_abort(log: i64) -> i64 {
  handle linear_resource_abort_in_callee(linear_resource_result_ok(log, 4)) {
    LinearResourceAbort.stop(value) -> value
  }
}

fn linear_resource_abort_again_after_move(log: i64) -[LinearResourceAbort]> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 5)
  let first = handle linear_resource_abort_in_callee(held) {
    LinearResourceAbort.stop(value) -> value
  }
  LinearResourceAbort.stop(first)
}

fn linear_resource_move_through_effect(log: i64) -[LinearResourceTransport]> i64 {
  LinearResourceTransport.take(linear_resource_result_ok(log, 6))
}

fn linear_resource_owned_effect_round_trip(log: i64) -[LinearResourceOwner]> i64 {
  LinearResourceOwner.discard(LinearResourceOwner.make(log, 7))
}

fn linear_resource_consume_token(value: owned OwnedAbortToken) -> i64 {
  61
}

impl Drop for LinearResourceOpaque {
  fn drop(self) -> i64 {
    match self {
      LinearResourceOpaque(parts) -> {
        let {token, code} = parts
        linear_resource_consume_token(token) - 61
      }
    }
  }
}

fn linear_resource_branch_move(log: i64, first: bool) -> i64 {
  let token: owned OwnedAbortToken = owned_abort_token_new(log, if first { 1 } else { 2 })
  if first {
    linear_resource_consume_token(token)
  } else {
    linear_resource_consume_token(token)
  }
}

fn linear_resource_match_alternative_move(log: i64, first: bool) -> i64 {
  let token: owned OwnedAbortToken = owned_abort_token_new(log, if first { 3 } else { 4 })
  match first {
    true -> linear_resource_consume_token(token)
    false -> linear_resource_consume_token(token)
  }
}

fn linear_resource_opaque_new(log: i64) -> owned LinearResourceOpaque {
  LinearResourceOpaque(LinearResourceRecord {
    code: 67,
    token: owned_abort_token_new(log, 5)
  })
}

fn linear_resource_opaque_round_trip(
  value: owned LinearResourceOpaque
) -> owned LinearResourceOpaque {
  match value {
    LinearResourceOpaque(parts) -> {
      let {token, code} = parts
      LinearResourceOpaque(LinearResourceRecord { code: code, token: token })
    }
  }
}

fn linear_resource_opaque_consume(value: owned LinearResourceOpaque) -> i64 {
  match value {
    LinearResourceOpaque(parts) -> {
      let {token, code} = parts
      code + linear_resource_consume_token(token) - 61
    }
  }
}

fn linear_resource_opaque_move(log: i64) -> i64 {
  linear_resource_opaque_consume(
    linear_resource_opaque_round_trip(linear_resource_opaque_new(log))
  )
}

fn linear_resource_match_move(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 7)
  match held {
    Ok(token) -> linear_resource_consume_token(token)
    Err(error) -> error
  }
}

fn linear_resource_match_wildcard(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 8)
  match held {
    Ok(_) -> defer_order_log_read(log)
    Err(error) -> error
  }
}

fn linear_resource_match_copyable_error(log: i64) -> i64 {
  let held: Result<owned OwnedAbortToken, str> = result_err<owned OwnedAbortToken, str>("kept")
  match held {
    Ok(token) -> linear_resource_consume_token(token)
    Err(message) -> str_len(message)
  }
}

fn linear_resource_match_record_move(log: i64) -> i64 {
  let held = LinearResourceRecord {
    code: 62,
    token: owned_abort_token_new(log, 9)
  }
  match held {
    {token, code} -> code + linear_resource_consume_token(token) - 61
  }
}

fn linear_resource_match_record_wildcard(log: i64) -> i64 {
  let held = LinearResourceRecord {
    code: 63,
    token: owned_abort_token_new(log, 1)
  }
  match held {
    {token: _, code} -> code + defer_order_log_read(log)
  }
}

fn linear_resource_match_tuple_move(log: i64) -> i64 {
  let held: (i64, owned OwnedAbortToken) = (64, owned_abort_token_new(log, 2))
  match held {
    (code, token) -> code + linear_resource_consume_token(token) - 61
  }
}

fn linear_resource_destructure_record(log: i64) -> i64 {
  let held = LinearResourceRecord {
    code: 65,
    token: owned_abort_token_new(log, 3)
  }
  let {token, code} = held
  code + linear_resource_consume_token(token) - 61
}

fn linear_resource_match_abort_after_split(log: i64) -[LinearResourceAbort]> i64 {
  let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 4)
  match held {
    Ok(token) -> LinearResourceAbort.stop(66)
    Err(error) -> error
  }
}

fn linear_resource_try_ok(log: i64) -[Fail<i64>]> i64 {
  let token: owned OwnedAbortToken = linear_resource_result_ok(log, 5)?
  linear_resource_consume_token(token)
}

fn linear_resource_try_ok_unused(log: i64) -[Fail<i64>]> i64 {
  let token: owned OwnedAbortToken = linear_resource_result_ok(log, 6)?
  69
}

fn linear_resource_try_err(log: i64) -[Fail<i64>]> i64 {
  let token: owned OwnedAbortToken = linear_resource_result_err()?
  linear_resource_consume_token(token)
}

fn linear_resource_try_return(log: i64) -[Fail<i64>]> owned OwnedAbortToken {
  linear_resource_result_ok(log, 7)?
}

fn linear_resource_try_then_abort(log: i64) -[Fail<i64>, LinearResourceAbort]> i64 {
  let token: owned OwnedAbortToken = linear_resource_result_ok(log, 8)?
  LinearResourceAbort.stop(70)
}

fn linear_resource_owned_error(log: i64) -> Result<i64, owned OwnedAbortToken> {
  result_err<i64, owned OwnedAbortToken>(owned_abort_token_new(log, 9))
}

fn linear_resource_try_owned_error(log: i64) -[Fail<owned OwnedAbortToken>]> i64 {
  linear_resource_owned_error(log)?
}

fn linear_resource_try_cfg(log: i64, succeeds: bool) -[Fail<i64>]> i64 {
  let token: owned OwnedAbortToken = (if succeeds {
    linear_resource_result_ok(log, 1)
  } else {
    linear_resource_result_err()
  })?
  linear_resource_consume_token(token)
}

fn linear_resource_loop_continue(log: i64) -> i64 {
  let mut digit = 1
  while digit <= 3 {
    let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, digit)
    digit = digit + 1
    continue
  }
  71
}

fn linear_resource_loop_break(log: i64) -> i64 {
  loop {
    let held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 4)
    break
  }
  72
}

fn linear_resource_loop_break_value(log: i64) -> Result<owned OwnedAbortToken, i64> {
  loop {
    break(linear_resource_result_ok(log, 5))
  }
}

fn linear_resource_nested_loop_break(log: i64) -> i64 {
  let outer: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 1)
  loop {
    let inner: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 2)
    break
  }
  73
}

fn linear_resource_loop_step(
  token: owned OwnedAbortToken,
  index: i64
) -> LinearResourceLoopStep {
  if index < 3 {
    LinearResourceLoopAgain(token)
  } else {
    LinearResourceLoopDone(token)
  }
}

fn linear_resource_loop_match_carries_owner(log: i64) -> i64 {
  let mut current: owned OwnedAbortToken = owned_abort_token_new(log, 5)
  let mut index = 0
  let returned = loop {
    match linear_resource_loop_step(current, index) {
      LinearResourceLoopAgain(next) -> {
        current = next
        index = index + 1
      }
      LinearResourceLoopDone(next) -> break(next)
    }
  }
  linear_resource_consume_token(returned)
}

fn linear_resource_opaque_loop_direct_match(log: i64) -> i64 {
  let mut current: owned LinearResourceOpaque = linear_resource_opaque_new(log)
  let returned = loop {
    match current {
      LinearResourceOpaque(parts) -> {
        let {token, code} = parts
        break(LinearResourceOpaque(LinearResourceRecord { code: code, token: token }))
      }
    }
  }
  linear_resource_opaque_consume(returned)
}

fn linear_resource_loop_match_drops_unused_break_payload(log: i64) -> i64 {
  loop {
    match LinearResourceHeld(74, owned_abort_token_new(log, 6)) {
      LinearResourceEmpty -> break(0)
      LinearResourceHeld(code, token) -> break(code)
    }
  }
}

fn linear_resource_while_match_drops_unused_continue_payload(log: i64) -> i64 {
  let mut index = 0
  while index < 2 {
    match LinearResourceHeld(index, owned_abort_token_new(log, index + 1)) {
      LinearResourceEmpty -> { index = 2 }
      LinearResourceHeld(code, token) -> {
        index = index + 1
        continue
      }
    }
  }
  75
}

fn linear_resource_imported_return(log: i64) -> i64 {
  linear_resource_consume_result(linear_resource_imported_result(log, 6))
}

fn linear_resource_imported_argument(log: i64) -> i64 {
  linear_resource_imported_consume(linear_resource_result_ok(log, 7))
}

fn linear_resource_mut_replace(log: i64) -> i64 {
  let mut held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 8)
  held = linear_resource_result_ok(log, 9)
  77
}

fn linear_resource_loop_mut_break(log: i64) -> i64 {
  loop {
    let mut held: Result<owned OwnedAbortToken, i64> = linear_resource_result_ok(log, 3)
    break
  }
  78
}

fn linear_resource_flat_mut_replace(log: i64) -> i64 {
  let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 8))
  held = (2, owned_abort_token_new(log, 9))
  79
}

fn linear_resource_flat_mut_initial_abort(log: i64) -[LinearResourceAbort]> i64 {
  let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 4))
  LinearResourceAbort.stop(80)
}

fn linear_resource_flat_mut_replace_abort(log: i64) -[LinearResourceAbort]> i64 {
  let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 5))
  held = (2, owned_abort_token_new(log, 6))
  LinearResourceAbort.stop(81)
}

fn linear_resource_consume_tuple(value: (i64, owned OwnedAbortToken)) -> i64 { 82 }

fn linear_resource_flat_mut_move_then_abort(log: i64) -[LinearResourceAbort]> i64 {
  let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 7))
  let answer = linear_resource_consume_tuple(held)
  LinearResourceAbort.stop(answer)
}

fn linear_resource_flat_mut_cfg_replace(log: i64, succeeds: bool) -> i64 {
  let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 1))
  held = if succeeds {
    (2, owned_abort_token_new(log, 2))
  } else {
    (3, owned_abort_token_new(log, 3))
  }
  83
}

fn linear_resource_flat_loop_mut_break(log: i64) -> i64 {
  loop {
    let mut held: (i64, owned OwnedAbortToken) = (1, owned_abort_token_new(log, 4))
    break
  }
  84
}

test "linear Result Ok local drops its resource exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_ok_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "linear Result Err local has no resource to drop" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_err_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 0)
}

test "linear record local drops its owned field exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_record_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "linear tuple local drops its owned position exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_tuple_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "linear tagged variant selects only its live payload" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_variant_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 4)
  Test.assert_eq(linear_resource_drop_empty_variant_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 4)
}

test "nested linear aggregate cleanup follows the exact structural path" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_nested_local(log), 42)
  Test.assert_eq(defer_order_log_read(log), 5)
}

test "linear aggregate cleanup runs before an explicit return" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_drop_before_return(log), 42)
  Test.assert_eq(defer_order_log_read(log), 6)
}

test "linear Result cleanup survives an abortive handler edge" {
  let log = defer_order_log_new()
  let got = handle linear_resource_abort_ok_local(log) {
    LinearResourceAbort.stop(value) -> value
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "linear Result Err cleanup remains inert on an abortive handler edge" {
  let log = defer_order_log_new()
  let got = handle linear_resource_abort_err_local(log) {
    LinearResourceAbort.stop(value) -> value
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 0)
}

test "whole linear aggregate moves into a direct callee exactly once" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_move_direct(log), 51)
  Test.assert_eq(defer_order_log_read(log), 8)
}

test "whole generic aggregate move uses the substituted linear layout" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_move_generic(log), 52)
  Test.assert_eq(defer_order_log_read(log), 9)
}

test "whole linear aggregate transfers through a return boundary" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_move_through_return(log), 51)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "caller retains one linear obligation while a callee may abort" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_move_then_abort(log), 53)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "temporary linear call result moves without requiring a local binding" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_inline_move(log), 51)
  Test.assert_eq(defer_order_log_read(log), 3)
}

test "one owned value may move once in either if branch" {
  let first_log = defer_order_log_new()
  let second_log = defer_order_log_new()
  Test.assert_eq(linear_resource_branch_move(first_log, true), 61)
  Test.assert_eq(linear_resource_branch_move(second_log, false), 61)
  Test.assert_eq(defer_order_log_read(first_log), 1)
  Test.assert_eq(defer_order_log_read(second_log), 2)
}

test "one owned value may move once in each mutually exclusive match arm" {
  let first_log = defer_order_log_new()
  let second_log = defer_order_log_new()
  Test.assert_eq(linear_resource_match_alternative_move(first_log, true), 61)
  Test.assert_eq(linear_resource_match_alternative_move(second_log, false), 61)
  Test.assert_eq(defer_order_log_read(first_log), 3)
  Test.assert_eq(defer_order_log_read(second_log), 4)
}

test "owned opaque aggregates destructure exhaustively outside Drop" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_opaque_move(log), 67)
  Test.assert_eq(defer_order_log_read(log), 5)
}

test "temporary linear call result stays protected across a callee abort" {
  let log = defer_order_log_new()
  Test.assert_eq(linear_resource_inline_move_then_abort(log), 53)
  Test.assert_eq(defer_order_log_read(log), 4)
}

test "aborted move leaves no stale obligation for an outer handler" {
  let log = defer_order_log_new()
  let got = handle linear_resource_abort_again_after_move(log) {
    LinearResourceAbort.stop(value) -> value
  }
  Test.assert_eq(got, 53)
  Test.assert_eq(defer_order_log_read(log), 5)
}

test "linear aggregate moves through an effect operation and handler clause" {
  let log = defer_order_log_new()
  let got = handle linear_resource_move_through_effect(log) {
    LinearResourceTransport.take(value) -> resume(54)
  }
  Test.assert_eq(got, 54)
  Test.assert_eq(defer_order_log_read(log), 6)
}

test "handler-owned parameter Drop can perform the handled effect" {
  let log = defer_order_log_new()
  let got = handle linear_resource_owned_effect_round_trip(log) {
    LinearResourceOwner.make(target, digit) -> resume(linear_resource_effect_token_new(target, digit))
    LinearResourceOwner.discard(value) -> resume(55)
    LinearResourceOwner.release(target, digit) -> resume(defer_order_log_write(target, digit))
  }
  Test.assert_eq(got, 55)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "captured handler evidence preserves effectful parameter Drop" {
  let log = defer_order_log_new()
  let f = handle {
    let target = log
    () => {
      let value: owned LinearResourceEffectToken = LinearResourceOwner.make(target, 8)
      LinearResourceOwner.discard(value)
    }
  } {
    LinearResourceOwner.make(target, digit) -> resume(linear_resource_effect_token_new(target, digit))
    LinearResourceOwner.discard(value) -> resume(56)
    LinearResourceOwner.release(target, digit) -> resume(defer_order_log_write(target, digit))
  }
  let got = handle f() {
    LinearResourceOwner.make(target, digit) -> resume(linear_resource_effect_token_new(target, 9))
    LinearResourceOwner.discard(value) -> resume(0)
    LinearResourceOwner.release(target, digit) -> resume(defer_order_log_write(target, 9))
  }
  Test.assert_eq(got, 56)
  Test.assert_eq(defer_order_log_read(log), 8)
}

