use compiler/pipeline.{*}

fn par_work_descriptor_test_field(name_hash: i64, ty: i64) -> i64 {
  ty_record_field(name_hash, ty, 0, 0)
}

fn par_work_descriptor_test_record9() -> i64 {
  let fields = nlist_new()
  for i in 0..9 { nlist_add(fields, par_work_descriptor_test_field(i + 1, ty_i64())) }
  ty_record(fields, 0)
}

fn par_work_descriptor_test_mixed() -> i64 {
  let fields = nlist_new()
  nlist_add(fields, par_work_descriptor_test_field(10, ty_f32()))
  nlist_add(fields, par_work_descriptor_test_field(20, ty_f64()))
  nlist_add(fields, par_work_descriptor_test_field(30, ty_str()))
  nlist_add(fields, par_work_descriptor_test_field(40, ty_fn(nlist_new(), ty_i64(), ty_effect_pure())))
  nlist_add(fields, par_work_descriptor_test_field(50, ty_weak(ty_rc(ty_i64()))))
  ty_record(fields, 0)
}

test "ParWork descriptor covers scalar floating and zero-lane shapes" {
  let zero = pipeline_par_work_descriptor_zero()
  let scalar = pipeline_par_work_descriptor_for_type(ty_i32())
  let fp32 = pipeline_par_work_descriptor_for_type(ty_f32())
  let fp64 = pipeline_par_work_descriptor_for_type(ty_f64())
  Test.assert_eq(pipeline_par_work_descriptor_is_valid(zero), 1)
  Test.assert_eq(pipeline_par_work_descriptor_lane_count(zero), 0)
  Test.assert_eq(pipeline_par_work_descriptor_storage_size(zero), 0)
  Test.assert_eq(pipeline_par_work_descriptor_storage_align(zero), 1)
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(scalar, 0), ir_value_lane_gpr())
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(fp32, 0), ir_value_lane_f32())
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(fp64, 0), ir_value_lane_f64())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(fp64, 0), continuation_cleanup_kind_none())
}

test "ParWork descriptor carries managed promotion and cleanup plans" {
  let string_value = pipeline_par_work_descriptor_for_type(ty_str())
  let array_value = pipeline_par_work_descriptor_for_type(ty_array(ty_str(), 3))
  let closure_value = pipeline_par_work_descriptor_for_type(ty_fn(nlist_new(), ty_i64(), ty_effect_pure()))
  let weak_value = pipeline_par_work_descriptor_for_type(ty_weak(ty_rc(ty_i64())))
  let named_value = pipeline_par_work_descriptor_for_type(ty_named(12345, ty_i64()))
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(string_value, 0), continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(array_value, 0), continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(closure_value, 0), continuation_cleanup_kind_closure())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(weak_value, 0), continuation_cleanup_kind_weak())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(named_value, 0), continuation_cleanup_kind_rc())
}

test "ParWork descriptor preserves slice and structural lane order" {
  let slice_value = pipeline_par_work_descriptor_for_type(ty_slice(ty_i64()))
  let mixed = pipeline_par_work_descriptor_for_type(par_work_descriptor_test_mixed())
  Test.assert_eq(pipeline_par_work_descriptor_lane_count(slice_value), 2)
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(slice_value, 0), ir_value_lane_gpr())
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(slice_value, 1), ir_value_lane_gpr())
  Test.assert_eq(pipeline_par_work_descriptor_lane_count(mixed), 5)
  Test.assert_eq(pipeline_par_work_descriptor_storage_size(mixed), 40)
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(mixed, 0), ir_value_lane_f32())
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(mixed, 1), ir_value_lane_f64())
  Test.assert_eq(pipeline_par_work_descriptor_lane_class(mixed, 2), ir_value_lane_gpr())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(mixed, 2), continuation_cleanup_kind_rc())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(mixed, 3), continuation_cleanup_kind_closure())
  Test.assert_eq(pipeline_par_work_descriptor_lane_cleanup_kind(mixed, 4), continuation_cleanup_kind_weak())
}

test "ParWork descriptor rejects unknown wide and inconsistent shapes" {
  let unknown = pipeline_par_work_descriptor_for_type(ty_record(nlist_new(), 1))
  let wide = pipeline_par_work_descriptor_for_type(par_work_descriptor_test_record9())
  let bad_shape = nlist_new()
  let bad_cleanup = nlist_new()
  nlist_add(bad_shape, 99)
  nlist_add(bad_cleanup, continuation_cleanup_kind_none())
  let bad_lane = PipelineParWorkDescriptorLanes(bad_shape, bad_cleanup)
  let fp_shape = nlist_new()
  let fp_cleanup = nlist_new()
  nlist_add(fp_shape, ir_value_lane_f64())
  nlist_add(fp_cleanup, continuation_cleanup_kind_rc())
  let managed_fp = PipelineParWorkDescriptorLanes(fp_shape, fp_cleanup)
  Test.assert_eq(pipeline_par_work_descriptor_reason(unknown), pipeline_par_work_descriptor_reason_unknown_shape())
  Test.assert_eq(pipeline_par_work_descriptor_reason(wide), pipeline_par_work_descriptor_reason_too_wide())
  Test.assert_eq(pipeline_par_work_descriptor_is_valid(bad_lane), 0)
  Test.assert_eq(pipeline_par_work_descriptor_is_valid(managed_fp), 0)
  Test.assert_eq(pipeline_par_work_descriptor_hash(bad_lane), 0)
}

test "ParWork descriptor encoding is deterministic cached and self describing" {
  let code = buf_new(1024)
  let fm = fmap_new()
  let descriptor = pipeline_par_work_descriptor_for_type(par_work_descriptor_test_mixed())
  let offset = pipeline_ir_native_ensure_par_work_descriptor(code, descriptor, fm)
  let first_len = buf_len(code)
  Test.assert_eq(if offset > 1 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset), pipeline_par_work_descriptor_magic())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 8), pipeline_par_work_descriptor_version())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 16), 5)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 24), 40)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 32), 8)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 40), ir_value_lane_f32())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 48), continuation_cleanup_kind_none())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 64), continuation_cleanup_kind_none())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 80), continuation_cleanup_kind_rc())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 96), continuation_cleanup_kind_closure())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 112), continuation_cleanup_kind_weak())
  Test.assert_eq(pipeline_ir_native_ensure_par_work_descriptor(code, descriptor, fm), offset)
  Test.assert_eq(buf_len(code), first_len)
  Test.assert_eq(mono_cache_lookup(fmap_mono_cache(fm), pipeline_par_work_descriptor_hash(descriptor)), offset)
}

test "ParWork zero-lane descriptor has a complete static encoding" {
  let code = buf_new(128)
  let fm = fmap_new()
  let descriptor = pipeline_par_work_descriptor_zero()
  let offset = pipeline_ir_native_ensure_par_work_descriptor(code, descriptor, fm)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset), pipeline_par_work_descriptor_magic())
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 16), 0)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 24), 0)
  Test.assert_eq(mem_load64_at(buf_ptr(code), offset + 32), 1)
  Test.assert_eq(buf_len(code), offset + pipeline_par_work_descriptor_header_size())
}
