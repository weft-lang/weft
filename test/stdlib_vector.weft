  Test.forall_i64_range(0, 40, vector_sort_property)
}

test "vector_sort_managed_elements_reclaim_after_swaps" {
  Test.assert_eq(vector_sort_box_round(16), 15)
  Test.assert_eq(vector_sort_box_round(16), 15)
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..20 {
    checksum = checksum + vector_sort_box_round(16)
  }
  let after = alloc_bump_mark()
  Test.assert_eq(checksum, 300)
  Test.assert_eq(after - before, 0)
}

type FrameFreeBox { FrameFreeBox(i64, i64) }

fn frame_free_box_key(b: FrameFreeBox) -> i64 {
  match b { FrameFreeBox(k, v) -> k }
}

test "vector_access_transmute_handlers_stay_frame_free" {
  -- The sealed-Unsafe transmute helpers on the managed-element access
  -- path must compile frame-free inside monomorphized copies: a handler frame
  -- per element load was 325MB of
  -- sorted_lookup RSS. i64 elements lower through the direct fast
  -- path, so the lock uses a managed element type — that is the shape
  -- that reaches vector_storage_word_as<T>. Bump-arena movement here
  -- means the discharge idiom regressed.
  let mut v = vector.new<FrameFreeBox>()
  let mut i = 0
  while i < 64 {
    v.push(FrameFreeBox(i * 3, i))
    i = i + 1
  }
  let mut warm = 0
  let mut acc = 0
  while warm < 100 {
    acc = acc + frame_free_box_key(vector_get_in_bounds<FrameFreeBox>(v, warm - warm / 64 * 64))
    warm = warm + 1
  }
  let before = alloc_bump_mark()
  let mut r = 0
  while r < 20000 {
    acc = acc + frame_free_box_key(vector_get_in_bounds<FrameFreeBox>(v, r - r / 64 * 64))
    r = r + 1
  }
  let after = alloc_bump_mark()
  Test.assert_eq(after - before, 0)
}

test "vector_fixed_arrays_preserve_inline_shape_across_mutation" {
  let mut values = vector.new<[i64; 2]>()
  values.push([1, 2])
  values.push([3, 4])
  values.swap(0, 1)
  values.set(1, [7, 8])
  let first = vector_get_in_bounds<[i64; 2]>(values, 0)
  let second = vector_get_in_bounds<[i64; 2]>(values, 1)
  Test.assert_eq(first[0] * 1000 + first[1] * 100 + second[0] * 10 + second[1], 3478)

  let mut nested = vector.new<[[i64; 2]; 2]>()
  nested.push([[10, 11], [12, 13]])
  let matrix = vector_get_in_bounds<[[i64; 2]; 2]>(nested, 0)
  Test.assert_eq(matrix[0][0] + matrix[0][1] + matrix[1][0] + matrix[1][1], 46)
}

test "vector_managed_fixed_arrays_retain_each_leaf" {
  let mut values = vector.new<[str; 2]>()
  values.push([str_concat("a", "1"), str_concat("b", "2")])
  values.push([str_concat("c", "3"), str_concat("d", "4")])
  values.swap(0, 1)
  values.set(1, [str_concat("e", "5"), str_concat("f", "6")])
  let first = vector_get_in_bounds<[str; 2]>(values, 0)
  let second = vector_get_in_bounds<[str; 2]>(values, 1)
  Test.assert_eq(str_eq(first[0], "c3") + str_eq(first[1], "d4"), 2)
  Test.assert_eq(str_eq(second[0], "e5") + str_eq(second[1], "f6"), 2)
  values.clear()
  Test.assert_true(values.len() == 0)
}

test "vector_zero_length_arrays_are_real_elements" {
  let empty: [i64; 0] = []
  let mut values = vector.new<[i64; 0]>()
  values.push(empty)
  values.push([])
  let loaded = vector_get_in_bounds<[i64; 0]>(values, 1)
  Test.assert_eq(vector_len<[i64; 0]>(values), 2)
  Test.assert_eq(vector_capacity_bytes<[i64; 0]>(values), 0)
  Test.assert_eq(if loaded.len == 0 { 1 } else { 0 }, 1)
  values.clear()
  Test.assert_true(values.len() == 0)
}

test "vector_method_surface_covers_mutation_lookup_and_transforms" {
  let mut values = vector.with_capacity<i64>(1)
  Test.assert_true(values.is_empty())
  Test.assert_true(values.capacity() == 1)
  values.push(3)
  values.push(1)
  values.push(2)
  Test.assert_true(values.len() == 3)
  Test.assert_true(values.capacity() >= 3)
  values.reserve(12)
  Test.assert_true(values.capacity() >= 15)
  match values.set(0, 4) {
    Ok(previous) -> Test.assert_eq(previous, 3)
    Err(_) -> Test.assert_true(false)
  }
  Test.assert_true(vector_index_error(values.set(9, 0), 9, 3))
  Test.assert_eq(values.get(0).unwrap_or(0), 4)
  Test.assert_true(values.get(9).is_none())
  Test.assert_eq(values.fold<i64>(0, vec_sum), 7)

  let mapped = values.map<i64>(vec_double)
  let mut sliced = mapped.slice(1, 3).expect("method slice is in bounds")
  Test.assert_true(vector_result_ok(sliced.insert(1, 9)))
  Test.assert_eq(sliced.remove(0).unwrap_or(0), 2)
  Test.assert_true(sliced.len() == 2)
  Test.assert_eq(sliced.get(0).unwrap_or(0), 9)
  Test.assert_eq(sliced.get(1).unwrap_or(0), 4)

  let even_values = values.filter(vec_even)
  let joined = sliced.concat(even_values)
  Test.assert_eq(joined.find(vec_gt_three).unwrap_or(0), 9)
  Test.assert_eq(option_usize_equals(joined.index_of_by(4, vec_same_i64), 1), 1)
  Test.assert_true(joined.contains(4))
  Test.assert_eq(option_usize_equals(joined.index_of(4), 1), 1)
  let ascending = joined.sort()
  Test.assert_eq(ascending.get(0).unwrap_or(0), 2)
  let descending = ascending.sort_by(vector_sort_desc_i64)
  Test.assert_eq(descending.get(0).unwrap_or(0), 9)
  let reversed = descending.reverse()
  Test.assert_eq(reversed.get(reversed.len() - 1).unwrap_or(0), 9)

  let mut repeated = vector.new<i64>()
  repeated.push(1)
  repeated.push(1)
  repeated.push(2)
  repeated.push(2)
  let deduped = repeated.dedup()
  let deduped_by = repeated.dedup_by(vec_same_i64)
  Test.assert_true(deduped.len() == 2)
  Test.assert_true(deduped_by.len() == 2)
  Test.assert_eq(repeated.pop().unwrap_or(0), 2)
  repeated.clear()
  Test.assert_true(repeated.is_empty())
}

test "vector_method_lookup_preserves_managed_structural_values" {
  let mut values = vector.new<[str; 2]>()
  values.push([str_concat("a", "1"), str_concat("b", "2")])
  let pair = values.get(0).expect("present managed array")
  Test.assert_eq(str_eq(pair[0], "a1") + str_eq(pair[1], "b2"), 2)
  Test.assert_true(values.get(1).is_none())
}
