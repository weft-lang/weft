  Test.forall_i64_range(0, 16, vector_push_len_property)
}

test "vector_sort_ord_handles_empty_singleton_reverse_and_duplicates" {
  let empty = vector.new<i64>().sort()
  let mut singleton = vector.new<i64>()
  singleton.push(42)
  let sorted_singleton = singleton.sort()
  let mut values = vector.new<i64>()
  values.push(5)
  values.push(3)
  values.push(5)
  values.push(1)
  values.push(0 - 2)
  values.push(3)
  let values_data = vector_data<i64>(values)
  let sorted = values.sort()
  Test.assert_true(empty.len() == 0)
  Test.assert_eq(sorted_singleton.get(0).unwrap_or(0), 42)
  Test.assert_eq(vector_data<i64>(sorted), values_data)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 0), 0 - 2)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 1), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 3), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 4), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 5), 5)
}

test "vector_sort_by_honours_custom_descending_comparator" {
  let values = vector.range(0, 6)
  let sorted = values.sort_by(vector_sort_desc_i64)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 0), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 1), 4)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 3), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 4), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 5), 0)
}

test "vector_sort_ord_covers_inline_records_and_utf8_strings" {
  let mut readings = vector.new<PackedReading>()
  readings.push(packed_reading(1, 30, 1))
  readings.push(packed_reading(2, 10, 2))
  readings.push(packed_reading(3, 20, 3))
  let sorted_readings = readings.sort()
  Test.assert_eq(sorted_readings.get(0).expect("first reading").wide, 10)
  Test.assert_eq(sorted_readings.get(1).expect("second reading").wide, 20)
  Test.assert_eq(sorted_readings.get(2).expect("third reading").wide, 30)

  let mut words = vector.new<str>()
  words.push("é")
  words.push("z")
  words.push("a")
  let sorted_words = words.sort()
  Test.assert_eq(if sorted_words.get(0).expect("first word") == "a" { 1 } else { 0 }, 1)
  Test.assert_eq(if sorted_words.get(1).expect("second word") == "z" { 1 } else { 0 }, 1)
  Test.assert_eq(if sorted_words.get(2).expect("third word") == "é" { 1 } else { 0 }, 1)
}

