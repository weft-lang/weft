use stdlib/vector as vector
use stdlib/vector.{*}
use runtime/alloc.{*}
use stdlib/option.{*}
use stdlib/num.{*}
use stdlib/ord.{*}
use stdlib/result.{Err, Ok, Result}
use stdlib/string.{*}

fn vec_sum(acc: i64, x: i64) -> i64 { acc + x }
fn vec_count(acc: i64, x: i64) -> i64 { acc + 1 }
fn vec_double(x: i64) -> i64 { x * 2 }
fn vec_even(x: i64) -> bool { x % 2 == 0 }
fn vec_gt_three(x: i64) -> bool { x > 3 }
fn vec_same_i64(left: i64, right: i64) -> bool { left == right }

type PackedReading { tiny: i8, wide: i64, mid: i32 }
type TinyPacket { a: u8, b: i8, ok: bool }

impl Ord for PackedReading {
  fn compare(self: Self, other: Self) -> Ordering {
    self.wide.compare(other.wide)
  }
}

fn vector_same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn packed_reading(tiny: i64, wide: i64, mid: i64) -> PackedReading {
  PackedReading {
    tiny: tiny.to_i8_checked().unwrap_or(0),
    wide: wide,
    mid: mid.to_i32_checked().unwrap_or(0)
  }
}

fn packed_reading_score(r: PackedReading) -> i64 {
  r.tiny.to_i64() + r.wide + r.mid.to_i64()
}

fn packed_reading_sum(acc: i64, r: PackedReading) -> i64 {
  acc + packed_reading_score(r)
}

fn tiny_packet(a: i64, b: i64, ok: bool) -> TinyPacket {
  TinyPacket {
    a: a.to_u8_checked().unwrap_or(0),
    b: b.to_i8_checked().unwrap_or(0),
    ok: ok
  }
}

fn option_has_value<T>(opt: Option<T>) -> i64 {
  match opt {
    Some(value) -> 1
    None -> 0
  }
}

fn option_value_or_i64(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn option_usize_equals(opt: Option<usize>, expected: usize) -> i64 {
  match opt {
    Some(value) -> if value == expected { 1 } else { 0 }
    None -> 0
  }
}

fn vector_result_ok<T>(result: Result<T, IndexError>) -> bool {
  match result {
    Ok(_) -> true
    Err(_) -> false
  }
}

fn vector_index_error<T>(result: Result<T, IndexError>, index: usize, length: usize) -> bool {
  match result {
    Ok(_) -> false
    Err(error) -> match error {
      IndexOutOfBounds(actual_index, actual_length) ->
        actual_index == index and actual_length == length
    }
  }
}

fn vector_capacity_error<T>(result: Result<owned Vector<T>, StorageCapacityError>, requested: usize) -> bool {
  match result {
    Ok(_) -> false
    Err(error) -> match error {
      CapacityUnrepresentable(actual) -> actual == requested
      CapacityAdditionOverflow(_, _) -> false
    }
  }
}

fn vector_reserve_error(result: Result<nil, StorageCapacityError>, length: usize, additional: usize) -> bool {
  match result {
    Ok(_) -> false
    Err(error) -> match error {
      CapacityUnrepresentable(_) -> false
      CapacityAdditionOverflow(actual_length, actual_additional) ->
        actual_length == length and actual_additional == additional
    }
  }
}

fn vector_storage_size_matches(plan: VectorStorageSize, capacity: i64, bytes: i64) -> bool {
  match plan {
    VectorStorageSized(actual_capacity, actual_bytes) ->
      actual_capacity == capacity and actual_bytes == bytes
    VectorStorageUnrepresentable -> false
  }
}

fn vector_storage_size_rejected(plan: VectorStorageSize) -> bool {
  match plan {
    VectorStorageSized(_, _) -> false
    VectorStorageUnrepresentable -> true
  }
}

fn vector_growth_matches(plan: VectorGrowth, capacity: i64, old_bytes: i64, new_bytes: i64) -> bool {
  match plan {
    VectorGrowthReady -> false
    VectorGrowthResize(actual_capacity, actual_old_bytes, actual_new_bytes) ->
      actual_capacity == capacity and actual_old_bytes == old_bytes and actual_new_bytes == new_bytes
    VectorGrowthUnrepresentable -> false
  }
}

fn vector_growth_is_ready(plan: VectorGrowth) -> bool {
  match plan {
    VectorGrowthReady -> true
    VectorGrowthResize(_, _, _) -> false
    VectorGrowthUnrepresentable -> false
  }
}

fn vector_growth_rejected(plan: VectorGrowth) -> bool {
  match plan {
    VectorGrowthReady -> false
    VectorGrowthResize(_, _, _) -> false
    VectorGrowthUnrepresentable -> true
  }
}

fn vector_push_len_property(i: i64) -> bool {
  let mut v = vector.new<i64>()
  let mut ok = true
  for n in 0..i {
    v.push(n)
    if v.len() != (n + 1).to_usize_checked().unwrap_or(0) {
      ok = false
    } else { 0 }
  }
  ok
}

fn vector_reverse_property(n: i64) -> bool {
  let values = vector.range(0, n)
  let reversed = values.reverse()
  let restored = reversed.reverse()
  let mut ok = restored.len() == n.to_usize_checked().unwrap_or(0)
  for i in 0..n {
    if restored.get(i.to_usize_checked().unwrap_or(0)).unwrap_or(0 - 1) != i { ok = false } else { 0 }
  }
  ok
}

fn vector_sort_desc_i64(left: i64, right: i64) -> Ordering {
  right.compare(left)
}

fn vector_count_i64(values: borrow Vector<i64>, needle: i64) -> i64 {
  let mut count = 0
  let zero: usize = 0
  for i in zero..values.len() {
    if values.get(i).unwrap_or(0 - 1) == needle {
      count = count + 1
    } else { 0 }
  }
  count
}

fn vector_sort_property(n: i64) -> bool {
  let mut values = vector.with_capacity<i64>(n.to_usize_checked().unwrap_or(0))
  let mut expected = vector.with_capacity<i64>(7)
  for bucket in 0..7 {
    expected.push(0)
  }
  for i in 0..n {
    let value = (i * 5 + 3) % 7
    values.push(value)
    let index = value.to_usize_checked().unwrap_or(0)
    expected.set(index, expected.get(index).unwrap_or(0) + 1)
  }
  let sorted = values.sort()
  let mut ok = sorted.len() == n.to_usize_checked().unwrap_or(0)
  let one: usize = 1
  let mut i = one
  while i < sorted.len() {
    if sorted.get(i - 1).unwrap_or(0) > sorted.get(i).unwrap_or(0) {
      ok = false
    } else { 0 }
    i = i + one
  }
  for bucket in 0..7 {
    if vector_count_i64(sorted, bucket) != expected.get(bucket.to_usize_checked().unwrap_or(0)).unwrap_or(0) {
      ok = false
    } else { 0 }
  }
  ok
}

type VectorSortBox { VectorSortBox(i64) }

fn vector_sort_box_value(box: VectorSortBox) -> i64 {
  match box { VectorSortBox(value) -> value }
}

impl Ord for VectorSortBox {
  fn compare(self: Self, other: Self) -> Ordering {
    let left = vector_sort_box_value(self)
    let right = vector_sort_box_value(other)
    left.compare(right)
  }
}

fn vector_sort_box_round(n: i64) -> i64 {
  let mut values = vector.with_capacity<VectorSortBox>(n.to_usize_checked().unwrap_or(0))
  let mut i = n
  while i > 0 {
    i = i - 1
    values.push(VectorSortBox(i))
  }
  let sorted = values.sort()
  if n == 0 { 0 }
  else {
    vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(sorted, 0)) +
      vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(sorted, n - 1))
  }
}

fn vector_sort_box_even(box: VectorSortBox) -> bool {
  vector_sort_box_value(box) % 2 == 0
}

fn vector_sort_box_is_three(box: VectorSortBox) -> bool {
  vector_sort_box_value(box) == 3
}

fn vector_breadth_box_round() -> i64 {
  let mut values = vector.new<VectorSortBox>()
  values.push(VectorSortBox(0))
  values.push(VectorSortBox(1))
  values.push(VectorSortBox(1))
  values.push(VectorSortBox(2))
  values.push(VectorSortBox(3))
  values.push(VectorSortBox(4))
  let sliced = values.slice(1, 6).expect("breadth slice is in bounds")
  let joined = sliced.concat(sliced)
  let filtered = joined.filter(vector_sort_box_even)
  let deduped = values.dedup()
  let found = match deduped.find(vector_sort_box_is_three) {
    Some(box) -> vector_sort_box_value(box)
    None -> 0 - 100
  }
  let removed = match values.remove(2) {
    Some(box) -> vector_sort_box_value(box)
    None -> 0 - 100
  }
  let inserted = values.insert(values.len(), VectorSortBox(5))
  let reversed = values.reverse()
  vector_len<VectorSortBox>(sliced) + vector_len<VectorSortBox>(joined) +
    vector_len<VectorSortBox>(filtered) + vector_len<VectorSortBox>(deduped) +
    found + removed + vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(reversed, 0)) +
    vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(reversed, vector_len<VectorSortBox>(reversed) - 1))
}

test "vector_empty_and_capacity_variants" {
  let empty = vector.new<i64>()
  let reserved = vector.with_capacity<i64>(3)
  let maximum: usize = 18446744073709551615
  Test.assert_eq(vector_header_size(), 64)
  Test.assert_true(empty.len() == 0)
  Test.assert_true(empty.capacity() == 0)
  Test.assert_true(empty.is_empty())
  Test.assert_true(reserved.len() == 0)
  Test.assert_true(reserved.capacity() == 3)
  Test.assert_true(vector_capacity_error<i64>(vector.try_with_capacity<i64>(maximum), maximum))
  Test.assert_eq(vector_element_size<i64>(reserved), 8)
  Test.assert_eq(vector_capacity_bytes<i64>(reserved), 24)
}

test "vector_storage_size_checks_count_and_byte_domains" {
  let i64_max: usize = 9223372036854775807
  let usize_max: usize = 18446744073709551615
  Test.assert_true(vector_storage_size_matches(vector_storage_size(0, 8), 0, 0))
  Test.assert_true(vector_storage_size_matches(vector_storage_size(i64_max, 0), 9223372036854775807, 0))
  Test.assert_true(vector_storage_size_matches(vector_storage_size(1152921504606846975, 8), 1152921504606846975, 9223372036854775800))
  Test.assert_true(vector_storage_size_rejected(vector_storage_size(1152921504606846976, 8)))
  Test.assert_true(vector_storage_size_rejected(vector_storage_size(usize_max, 0)))
  Test.assert_true(vector_storage_size_rejected(vector_storage_size(1, 0 - 1)))
}

test "vector_growth_is_geometric_exact_and_checked" {
  let i64_max: usize = 9223372036854775807
  let usize_max: usize = 18446744073709551615
  Test.assert_true(vector_growth_is_ready(vector_growth(0, 0, 8)))
  Test.assert_true(vector_growth_matches(vector_growth(0, 1, 8), 1, 0, 8))
  Test.assert_true(vector_growth_matches(vector_growth(1, 3, 8), 4, 8, 32))
  Test.assert_true(vector_growth_matches(vector_growth(3, 12, 1), 12, 3, 12))
  Test.assert_true(vector_growth_matches(vector_growth(4611686018427387904, i64_max, 1), 9223372036854775807, 4611686018427387904, 9223372036854775807))
  Test.assert_true(vector_growth_rejected(vector_growth(4611686018427387904, i64_max, 2)))
  Test.assert_true(vector_growth_rejected(vector_growth(0 - 1, 1, 1)))
  Test.assert_true(vector_growth_rejected(vector_growth(0, usize_max, 0)))
}

test "vector_failed_growth_preserves_storage_and_contents" {
  let mut values = vector.with_capacity<i64>(2)
  values.push(7)
  values.push(9)
  let before_capacity = values.capacity()
  let before_bytes = vector_capacity_bytes<i64>(values)
  Test.assert_false(vector_reserve_borrowed<i64>(values, 9223372036854775807))
  Test.assert_true(values.capacity() == before_capacity)
  Test.assert_eq(vector_capacity_bytes<i64>(values), before_bytes)
  Test.assert_true(values.len() == 2)
  Test.assert_eq(values.get(0).unwrap_or(0) * 10 + values.get(1).unwrap_or(0), 79)
}

test "vector_try_reserve_reports_unsigned_addition_overflow_without_mutation" {
  let mut values = vector.with_capacity<i64>(2)
  values.push(7)
  values.push(9)
  let maximum: usize = 18446744073709551615
  let before_capacity = values.capacity()
  Test.assert_true(vector_reserve_error(values.try_reserve(maximum), 2, maximum))
  Test.assert_true(values.capacity() == before_capacity)
  Test.assert_true(values.len() == 2)
  Test.assert_eq(values.get(0).unwrap_or(0) * 10 + values.get(1).unwrap_or(0), 79)
}

test "vector_element_layout_metadata_matrix" {
  Test.assert_eq(vector_element_size_of<bool>(), 1)
  Test.assert_eq(vector_element_size_of<u8>(), 1)
  Test.assert_eq(vector_element_size_of<i8>(), 1)
  Test.assert_eq(vector_element_size_of<u16>(), 2)
  Test.assert_eq(vector_element_size_of<i16>(), 2)
  Test.assert_eq(vector_element_size_of<u32>(), 4)
  Test.assert_eq(vector_element_size_of<i32>(), 4)
  Test.assert_eq(vector_element_size_of<f32>(), 4)
  Test.assert_eq(vector_element_size_of<i64>(), 8)
  Test.assert_eq(vector_element_size_of<str>(), 8)
  Test.assert_eq(vector_element_size_of<PackedReading>(), 24)
  Test.assert_eq(vector_element_size_of<TinyPacket>(), 3)
  Test.assert_eq(vector_element_mode_of<bool>(), 1)
  Test.assert_eq(vector_element_mode_of<i8>(), 2)
  Test.assert_eq(vector_element_mode_of<i16>(), 4)
  Test.assert_eq(vector_element_mode_of<i32>(), 6)
  Test.assert_eq(vector_element_mode_of<f32>(), 5)
  Test.assert_eq(vector_element_mode_of<i64>(), 0)
  Test.assert_eq(vector_element_mode_of<PackedReading>(), vector_element_mode_record_payload())
  Test.assert_eq(vector_element_mode_of<TinyPacket>(), vector_element_mode_record_payload())
  Test.assert_eq(vector_element_size_of<[i64; 2]>(), 16)
  Test.assert_eq(vector_element_leaf_count_of<i64>(), 0 - 1)
  Test.assert_eq(vector_element_leaf_count_of<[i64; 0]>(), 0)
  Test.assert_eq(vector_element_leaf_count_of<[i64; 2]>(), 2)
  Test.assert_eq(vector_element_leaf_count_of<[[i64; 2]; 2]>(), 4)
  Test.assert_eq(vector_element_leaf_stride_of<[i64; 2]>(), 8)
  Test.assert_eq(vector_element_leaf_kind_of<[i64; 2]>(), 0)
  Test.assert_eq(vector_element_leaf_kind_of<[str; 2]>(), 1)
  let bytes = vector.with_capacity<u8>(5)
  let halves = vector.with_capacity<i16>(5)
  let words = vector.with_capacity<f32>(5)
  let records = vector.with_capacity<PackedReading>(2)
  Test.assert_eq(vector_element_size<u8>(bytes), 1)
  Test.assert_eq(vector_capacity_bytes<u8>(bytes), 5)
  Test.assert_eq(vector_element_size<i16>(halves), 2)
  Test.assert_eq(vector_capacity_bytes<i16>(halves), 10)
  Test.assert_eq(vector_element_size<f32>(words), 4)
  Test.assert_eq(vector_capacity_bytes<f32>(words), 20)
  Test.assert_eq(vector_element_size<PackedReading>(records), 24)
  Test.assert_eq(vector_capacity_bytes<PackedReading>(records), 48)
}

test "vector_push_get_and_growth_preserve_order" {
  let mut v = vector.with_capacity<i64>(1)
  v.push(10)
  v.push(20)
  v.push(30)
  Test.assert_true(v.len() == 3)
  Test.assert_eq(if v.capacity() >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(v.get(0).unwrap_or(0), 10)
  Test.assert_eq(v.get(1).unwrap_or(0), 20)
  Test.assert_eq(v.get(2).unwrap_or(0), 30)
}

test "vector_set_survives_intervening_test_effect" {
  let mut v = vector.range(0, 4)
  match v.set(1, 41) {
    Ok(previous) -> Test.assert_eq(previous, 1)
    Err(_) -> Test.assert_true(false)
  }
  Test.assert_eq(v.get(1).unwrap_or(0), 41)
}

test "vector_packed_unsigned_bool_and_growth" {
  let mut bytes = vector.with_capacity<u8>(1)
  let mut flags = vector.with_capacity<bool>(1)
  bytes.push(250)
  bytes.push(251)
  bytes.push(252)
  flags.push(true)
  flags.push(false)
  Test.assert_true(bytes.len() == 3)
  Test.assert_eq(vector_element_size<u8>(bytes), 1)
  Test.assert_eq(if vector_capacity_bytes<u8>(bytes) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(if bytes.get(0).unwrap_or(0) == 250 { 1 } else { 0 }, 1)
  Test.assert_eq(if bytes.get(2).unwrap_or(0) == 252 { 1 } else { 0 }, 1)
  Test.assert_eq(if flags.get(0).unwrap_or(false) { 1 } else { 0 }, 1)
  Test.assert_eq(if flags.get(1).unwrap_or(true) { 1 } else { 0 }, 0)
}

test "vector_packed_signed_values_sign_extend" {
  let mut tiny = vector.with_capacity<i8>(2)
  let mut halves = vector.with_capacity<i16>(2)
  let mut words = vector.with_capacity<i32>(2)
  tiny.push(-8)
  tiny.push(7)
  halves.push(-300)
  halves.push(301)
  words.push(-32000)
  words.push(32001)
  Test.assert_eq(vector_get<i8>(tiny, 0, 0).to_i64(), -8)
  Test.assert_eq(vector_get<i8>(tiny, 1, 0).to_i64(), 7)
  Test.assert_eq(vector_get<i16>(halves, 0, 0).to_i64(), -300)
  Test.assert_eq(vector_get<i16>(halves, 1, 0).to_i64(), 301)
  Test.assert_eq(vector_get<i32>(words, 0, 0).to_i64(), -32000)
  Test.assert_eq(vector_get<i32>(words, 1, 0).to_i64(), 32001)
}

test "vector_packed_f32_round_trip" {
  let mut values = vector.with_capacity<f32>(2)
  values.push(1.25)
  values.push(2.5)
  Test.assert_eq(vector_element_size<f32>(values), 4)
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 0, 0.0), 1.25), 1)
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 1, 0.0), 2.5), 1)
  match values.set(1, 3.75) {
    Ok(previous) -> Test.assert_eq(vector_same_f32(previous, 2.5), 1)
    Err(_) -> Test.assert_true(false)
  }
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 1, 0.0), 3.75), 1)
}

test "vector_inline_record_push_get_set_and_growth" {
  let mut values = vector.with_capacity<PackedReading>(2)
  values.push(packed_reading(-2, 40, 4))
  values.push(packed_reading(3, 50, -11))
  Test.assert_true(values.len() == 2)
  Test.assert_eq(vector_capacity_bytes<PackedReading>(values), 48)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0))), 42)
  Test.assert_eq(vector_get<PackedReading>(values, 1, packed_reading(0, 0, 0)).wide, 50)
  match values.set(1, packed_reading(-8, 70, -20)) {
    Ok(previous) -> Test.assert_eq(packed_reading_score(previous), 42)
    Err(_) -> Test.assert_true(false)
  }
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 1, packed_reading(0, 0, 0))), 42)
  values.push(packed_reading(1, 2, 3))
  Test.assert_true(values.len() == 3)
  Test.assert_eq(if vector_capacity_bytes<PackedReading>(values) >= 72 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0)).wide, 40)
}

test "vector_inline_record_bounds_use_default_and_reject_set" {
  let mut values = vector.with_capacity<PackedReading>(1)
  let fallback = packed_reading(-5, 90, -43)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, fallback)), 42)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0 - 1, fallback)), 42)
  Test.assert_true(vector_index_error(values.set(0, packed_reading(1, 2, 3)), 0, 0))
  values.push(packed_reading(1, 20, 21))
  Test.assert_true(vector_index_error(values.set(1, packed_reading(4, 5, 6)), 1, 1))
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, fallback)), 42)
}

test "vector_inline_record_fold_swap_and_pop" {
  let mut values = vector.with_capacity<PackedReading>(2)
  values.push(packed_reading(1, 10, 31))
  values.push(packed_reading(2, 20, 20))
  Test.assert_eq(values.fold<i64>(0, packed_reading_sum), 84)
  Test.assert_true(vector_result_ok(values.swap(0, 1)))
  Test.assert_eq(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0)).wide, 20)
  let popped = values.pop()
  Test.assert_eq(option_has_value<PackedReading>(popped), 1)
  Test.assert_true(values.len() == 1)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0))), 42)
}

test "vector_inline_record_adversarial_byte_packing" {
  let mut values = vector.with_capacity<TinyPacket>(2)
  values.push(tiny_packet(250, -8, true))
  values.push(tiny_packet(7, 6, false))
  Test.assert_eq(vector_element_size<TinyPacket>(values), 3)
  Test.assert_eq(vector_capacity_bytes<TinyPacket>(values), 6)
  Test.assert_eq(if vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).a == 250 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).b.to_i64(), -8)
  Test.assert_eq(if vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).ok { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<TinyPacket>(values, 1, tiny_packet(0, 0, true)).ok { 1 } else { 0 }, 0)
}

test "vector_set_swap_pop_and_clear" {
  let mut v = vector.range(0, 4)
  match v.set(1, 41) {
    Ok(previous) -> Test.assert_eq(previous, 1)
    Err(_) -> Test.assert_true(false)
  }
  Test.assert_eq(vector_get<i64>(v, 1, 0), 41)
  Test.assert_true(vector_result_ok(v.swap(0, 3)))
  Test.assert_eq(vector_get<i64>(v, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(v, 3, 0), 0)
  let popped = v.pop()
  Test.assert_eq(option_has_value<i64>(popped), 1)
  Test.assert_eq(option_value_or_i64(popped, 0), 0)
  Test.assert_true(v.len() == 3)
  v.clear()
  Test.assert_true(v.len() == 0)
  Test.assert_true(v.is_empty())
}

test "vector_map_fold_and_search" {
  let v = vector.range(1, 6)
  let doubled = v.map<i64>(vec_double)
  Test.assert_eq(v.fold<i64>(0, vec_sum), 15)
  Test.assert_eq(doubled.fold<i64>(0, vec_sum), 30)
  Test.assert_eq(doubled.fold<i64>(0, vec_count), 5)
  Test.assert_eq(option_usize_equals(vector_index_of_i64(doubled, 6), 2), 1)
  Test.assert_eq(option_has_value<usize>(vector_index_of_i64(doubled, 11)), 0)
  Test.assert_true(vector_contains_i64(doubled, 10))
  Test.assert_false(vector_contains_i64(doubled, 11))
}

test "vector_slice_checks_exact_half_open_ranges" {
  let values = vector.range(0, 5)
  let middle = values.slice(1, 4).expect("middle range is valid")
  let empty = values.slice(5, 5).expect("empty end range is valid")
  Test.assert_eq(vector_len<i64>(middle), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(middle, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(middle, 2), 3)
  Test.assert_eq(vector_len<i64>(empty), 0)
  Test.assert_true(values.slice(4, 2).is_none())
  Test.assert_true(values.slice(4, 99).is_none())
  let maximum: usize = 18446744073709551615
  Test.assert_true(values.slice(maximum, maximum).is_none())
  Test.assert_eq(vector_len<i64>(values), 5)
}

test "vector_insert_and_remove_preserve_order_and_boundaries" {
  let mut values = vector.new<i64>()
  values.push(1)
  values.push(3)
  Test.assert_true(vector_result_ok(values.insert(1, 2)))
  Test.assert_true(vector_result_ok(values.insert(0, 0)))
  Test.assert_true(vector_result_ok(values.insert(values.len(), 4)))
  let maximum: usize = 18446744073709551615
  Test.assert_true(vector_index_error(values.insert(maximum, 99), maximum, 5))
  Test.assert_true(vector_index_error(values.insert(values.len() + 1, 99), 6, 5))
  Test.assert_true(values.len() == 5)
  let zero: usize = 0
  for i in zero..values.len() {
    Test.assert_eq(values.get(i).unwrap_or(0 - 1), i.to_u64().to_i64_checked().unwrap_or(0 - 1))
  }

  Test.assert_eq(option_value_or_i64(values.remove(2), 99), 2)
  Test.assert_eq(option_value_or_i64(values.remove(0), 99), 0)
  Test.assert_eq(option_value_or_i64(values.remove(values.len() - 1), 99), 4)
  Test.assert_eq(option_has_value<i64>(values.remove(maximum)), 0)
  Test.assert_eq(option_has_value<i64>(values.remove(values.len())), 0)
  Test.assert_true(values.len() == 2)
  Test.assert_eq(values.get(0).unwrap_or(0), 1)
  Test.assert_eq(values.get(1).unwrap_or(0), 3)
  let mut empty = vector.new<i64>()
  Test.assert_eq(option_has_value<i64>(empty.remove(0)), 0)
}

test "vector_concat_reverse_filter_find_and_dedup" {
  let left = vector.range(0, 3)
  let right = vector.range(3, 6)
  let joined = left.concat(right)
  Test.assert_true(joined.len() == 6)
  let zero: usize = 0
  for i in zero..joined.len() {
    Test.assert_eq(joined.get(i).unwrap_or(0 - 1), i.to_u64().to_i64_checked().unwrap_or(0 - 1))
  }
  Test.assert_true(left.len() == 3)
  let joined_data = vector_data<i64>(joined)
  let reversed = joined.reverse()
  Test.assert_eq(vector_data<i64>(reversed), joined_data)
  for i in zero..reversed.len() {
    Test.assert_eq(reversed.get(i).unwrap_or(0 - 1), 5 - i.to_u64().to_i64_checked().unwrap_or(0))
  }

  let evens = reversed.filter(vec_even)
  Test.assert_true(evens.len() == 3)
  Test.assert_eq(evens.get(0).unwrap_or(0), 4)
  Test.assert_eq(evens.get(1).unwrap_or(0), 2)
  Test.assert_eq(evens.get(2).unwrap_or(0 - 1), 0)
  Test.assert_eq(option_value_or_i64(reversed.find(vec_gt_three), 0 - 1), 5)
  Test.assert_eq(option_has_value<i64>(evens.find(x => x > 10)), 0)

  let mut duplicates = vector.new<i64>()
  duplicates.push(1)
  duplicates.push(1)
  duplicates.push(2)
  duplicates.push(2)
  duplicates.push(2)
  duplicates.push(1)
  let deduped = duplicates.dedup()
  Test.assert_eq(vector_len<i64>(deduped), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 2), 1)
  Test.assert_eq(vector_len<i64>(duplicates), 6)
  Test.assert_eq(option_usize_equals(vector_index_of_by<i64>(duplicates, 2, vec_same_i64), 2), 1)
}

test "property_vector_reverse_twice_is_identity" {
  Test.forall_i64_range(0, 40, vector_reverse_property)
}

test "vector_breadth_managed_values_reclaim" {
  Test.assert_eq(vector_breadth_box_round(), 33)
  Test.assert_eq(vector_breadth_box_round(), 33)
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..20 { checksum = checksum + vector_breadth_box_round() }
  let after = alloc_bump_mark()
  Test.assert_eq(checksum, 660)
  Test.assert_eq(after - before, 0)
}

test "vector_bounds_sad_paths" {
  let mut v = vector.range(3, 6)
  let mut bytes = vector.with_capacity<u8>(2)
  bytes.push(9)
  bytes.push(10)
  Test.assert_eq(vector_get<i64>(v, 0 - 1, 99), 99)
  Test.assert_eq(vector_get<i64>(v, 3, 99), 99)
  Test.assert_eq(if vector_get<u8>(bytes, 0 - 1, 88) == 88 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<u8>(bytes, 2, 77) == 77 { 1 } else { 0 }, 1)
  Test.assert_eq(option_has_value<i64>(vector_get_option<i64>(v, 0 - 1)), 0)
  Test.assert_eq(option_has_value<i64>(vector_get_option<i64>(v, 3)), 0)
  let maximum: usize = 18446744073709551615
  Test.assert_true(vector_index_error(v.set(maximum, 42), maximum, 3))
  Test.assert_true(vector_index_error(v.set(3, 42), 3, 3))
  Test.assert_true(vector_index_error(bytes.set(maximum, 42), maximum, 2))
  Test.assert_true(vector_index_error(bytes.set(2, 42), 2, 2))
  Test.assert_true(vector_index_error(v.swap(0, 3), 3, 3))
  Test.assert_eq(vector_get<i64>(v, 0, 0), 3)
  Test.assert_eq(if vector_get<u8>(bytes, 0, 0) == 9 { 1 } else { 0 }, 1)
}

