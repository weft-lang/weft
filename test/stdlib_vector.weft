use "stdlib/vector.weft"
use "runtime/alloc.weft"
use stdlib/option.{*}
use stdlib/num.{*}
use stdlib/string.{*}

fn vec_sum(acc: i64, x: i64) -> i64 { acc + x }
fn vec_count(acc: i64, x: i64) -> i64 { acc + 1 }
fn vec_double(x: i64) -> i64 { x * 2 }
fn vec_even(x: i64) -> bool { x % 2 == 0 }
fn vec_gt_three(x: i64) -> bool { x > 3 }
fn vec_same_i64(left: i64, right: i64) -> bool { left == right }

type PackedReading { tiny: i8, wide: i64, mid: i32 }
type TinyPacket { a: u8, b: i8, ok: bool }

impl Ord for PackedReading {
  fn compare(self: Self, other: Self) -> i64 {
    if self.wide < other.wide { 0 - 1 }
    else { if self.wide > other.wide { 1 } else { 0 } }
  }
}

fn vector_same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn packed_reading(tiny: i64, wide: i64, mid: i64) -> PackedReading {
  PackedReading {
    tiny: num_int_cast_value_or<i8>(num_i64_to_i8_checked(tiny), 0),
    wide: wide,
    mid: num_int_cast_value_or<i32>(num_i64_to_i32_checked(mid), 0)
  }
}

fn packed_reading_score(r: PackedReading) -> i64 {
  num_i8_to_i64(r.tiny) + r.wide + num_i32_to_i64(r.mid)
}

fn packed_reading_sum(acc: i64, r: PackedReading) -> i64 {
  acc + packed_reading_score(r)
}

fn tiny_packet(a: i64, b: i64, ok: bool) -> TinyPacket {
  TinyPacket {
    a: num_int_cast_value_or<u8>(num_i64_to_u8_checked(a), 0),
    b: num_int_cast_value_or<i8>(num_i64_to_i8_checked(b), 0),
    ok: ok
  }
}

fn option_has_value<T>(opt: Option<T>) -> i64 {
  match opt {
    Some(value) -> 1
    None -> 0
  }
}

fn option_value_or_i64(opt: Option<i64>, default: i64) -> i64 {
  match opt {
    Some(value) -> value
    None -> default
  }
}

fn option_usize_equals(opt: Option<usize>, expected: usize) -> i64 {
  match opt {
    Some(value) -> if value == expected { 1 } else { 0 }
    None -> 0
  }
}

fn vector_push_len_property(i: i64) -> bool {
  let v = vector_new<i64>()
  let mut ok = true
  for n in 0..i {
    vector_push<i64>(v, n)
    if vector_len(v) != n + 1 {
      ok = false
    } else { 0 }
  }
  ok
}

fn vector_reverse_property(n: i64) -> bool {
  let values = vector_from_range(0, n)
  vector_reverse<i64>(values)
  vector_reverse<i64>(values)
  let mut ok = vector_len<i64>(values) == n
  for i in 0..n {
    if vector_get_in_bounds<i64>(values, i) != i { ok = false } else { 0 }
  }
  ok
}

fn vector_sort_desc_i64(left: i64, right: i64) -> i64 {
  if left > right { 0 - 1 } else { if left < right { 1 } else { 0 } }
}

fn vector_count_i64(values: Vector<i64>, needle: i64) -> i64 {
  let mut count = 0
  for i in 0..vector_len<i64>(values) {
    if vector_get_in_bounds<i64>(values, i) == needle {
      count = count + 1
    } else { 0 }
  }
  count
}

fn vector_sort_property(n: i64) -> bool {
  let values = vector_with_capacity<i64>(n)
  let expected = vector_with_capacity<i64>(7)
  for bucket in 0..7 {
    vector_push<i64>(expected, 0)
  }
  for i in 0..n {
    let value = (i * 5 + 3) % 7
    vector_push<i64>(values, value)
    vector_set<i64>(expected, value, vector_get_in_bounds<i64>(expected, value) + 1)
  }
  let sorted = vector_sort<i64>(values)
  let mut ok = vector_len<i64>(sorted) == n
  let mut i = 1
  while i < n {
    if vector_get_in_bounds<i64>(sorted, i - 1) > vector_get_in_bounds<i64>(sorted, i) {
      ok = false
    } else { 0 }
    i = i + 1
  }
  for bucket in 0..7 {
    if vector_count_i64(sorted, bucket) != vector_get_in_bounds<i64>(expected, bucket) {
      ok = false
    } else { 0 }
  }
  ok
}

type VectorSortBox { VectorSortBox(i64) }

fn vector_sort_box_value(box: VectorSortBox) -> i64 {
  match box { VectorSortBox(value) -> value }
}

impl Ord for VectorSortBox {
  fn compare(self: Self, other: Self) -> i64 {
    let left = vector_sort_box_value(self)
    let right = vector_sort_box_value(other)
    if left < right { 0 - 1 } else { if left > right { 1 } else { 0 } }
  }
}

fn vector_sort_box_round(n: i64) -> i64 {
  let values = vector_with_capacity<VectorSortBox>(n)
  let mut i = n
  while i > 0 {
    i = i - 1
    vector_push<VectorSortBox>(values, VectorSortBox(i))
  }
  let sorted = vector_sort<VectorSortBox>(values)
  if n == 0 { 0 }
  else {
    vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(sorted, 0)) +
      vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(sorted, n - 1))
  }
}

fn vector_sort_box_even(box: VectorSortBox) -> bool {
  vector_sort_box_value(box) % 2 == 0
}

fn vector_sort_box_is_three(box: VectorSortBox) -> bool {
  vector_sort_box_value(box) == 3
}

fn vector_breadth_box_round() -> i64 {
  let values = vector_new<VectorSortBox>()
  vector_push<VectorSortBox>(values, VectorSortBox(0))
  vector_push<VectorSortBox>(values, VectorSortBox(1))
  vector_push<VectorSortBox>(values, VectorSortBox(1))
  vector_push<VectorSortBox>(values, VectorSortBox(2))
  vector_push<VectorSortBox>(values, VectorSortBox(3))
  vector_push<VectorSortBox>(values, VectorSortBox(4))
  let sliced = vector_slice<VectorSortBox>(values, 1, 6)
  let joined = vector_concat<VectorSortBox>(sliced, sliced)
  let filtered = vector_filter<VectorSortBox>(joined, vector_sort_box_even)
  let deduped = vector_dedup<VectorSortBox>(values)
  let found = match vector_find<VectorSortBox>(deduped, vector_sort_box_is_three) {
    Some(box) -> vector_sort_box_value(box)
    None -> 0 - 100
  }
  let removed = match vector_remove_at<VectorSortBox>(values, 2) {
    Some(box) -> vector_sort_box_value(box)
    None -> 0 - 100
  }
  vector_insert_at<VectorSortBox>(values, vector_len<VectorSortBox>(values), VectorSortBox(5))
  vector_reverse<VectorSortBox>(values)
  vector_len<VectorSortBox>(sliced) + vector_len<VectorSortBox>(joined) +
    vector_len<VectorSortBox>(filtered) + vector_len<VectorSortBox>(deduped) +
    found + removed + vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(values, 0)) +
    vector_sort_box_value(vector_get_in_bounds<VectorSortBox>(values, vector_len<VectorSortBox>(values) - 1))
}

test "vector_empty_and_capacity_variants" {
  let empty = vector_new<i64>()
  let negative = vector_with_capacity<i64>(0 - 4)
  let reserved = vector_with_capacity<i64>(3)
  Test.assert_eq(vector_header_size(), 64)
  Test.assert_eq(vector_len(empty), 0)
  Test.assert_eq(vector_capacity(empty), 0)
  Test.assert_eq(vector_is_empty(empty), 1)
  Test.assert_eq(vector_len(negative), 0)
  Test.assert_eq(vector_capacity(negative), 0)
  Test.assert_eq(vector_len(reserved), 0)
  Test.assert_eq(vector_capacity(reserved), 3)
  Test.assert_eq(vector_element_size(reserved), 8)
  Test.assert_eq(vector_capacity_bytes(reserved), 24)
}

test "vector_element_layout_metadata_matrix" {
  Test.assert_eq(vector_element_size_of<bool>(), 1)
  Test.assert_eq(vector_element_size_of<u8>(), 1)
  Test.assert_eq(vector_element_size_of<i8>(), 1)
  Test.assert_eq(vector_element_size_of<u16>(), 2)
  Test.assert_eq(vector_element_size_of<i16>(), 2)
  Test.assert_eq(vector_element_size_of<u32>(), 4)
  Test.assert_eq(vector_element_size_of<i32>(), 4)
  Test.assert_eq(vector_element_size_of<f32>(), 4)
  Test.assert_eq(vector_element_size_of<i64>(), 8)
  Test.assert_eq(vector_element_size_of<str>(), 8)
  Test.assert_eq(vector_element_size_of<PackedReading>(), 24)
  Test.assert_eq(vector_element_size_of<TinyPacket>(), 3)
  Test.assert_eq(vector_element_mode_of<bool>(), 1)
  Test.assert_eq(vector_element_mode_of<i8>(), 2)
  Test.assert_eq(vector_element_mode_of<i16>(), 4)
  Test.assert_eq(vector_element_mode_of<i32>(), 6)
  Test.assert_eq(vector_element_mode_of<f32>(), 5)
  Test.assert_eq(vector_element_mode_of<i64>(), 0)
  Test.assert_eq(vector_element_mode_of<PackedReading>(), vector_element_mode_record_payload())
  Test.assert_eq(vector_element_mode_of<TinyPacket>(), vector_element_mode_record_payload())
  Test.assert_eq(vector_element_size_of<[i64; 2]>(), 16)
  Test.assert_eq(vector_element_leaf_count_of<i64>(), 0 - 1)
  Test.assert_eq(vector_element_leaf_count_of<[i64; 0]>(), 0)
  Test.assert_eq(vector_element_leaf_count_of<[i64; 2]>(), 2)
  Test.assert_eq(vector_element_leaf_count_of<[[i64; 2]; 2]>(), 4)
  Test.assert_eq(vector_element_leaf_stride_of<[i64; 2]>(), 8)
  Test.assert_eq(vector_element_leaf_kind_of<[i64; 2]>(), 0)
  Test.assert_eq(vector_element_leaf_kind_of<[str; 2]>(), 1)
  let bytes = vector_with_capacity<u8>(5)
  let halves = vector_with_capacity<i16>(5)
  let words = vector_with_capacity<f32>(5)
  let records = vector_with_capacity<PackedReading>(2)
  Test.assert_eq(vector_element_size(bytes), 1)
  Test.assert_eq(vector_capacity_bytes(bytes), 5)
  Test.assert_eq(vector_element_size(halves), 2)
  Test.assert_eq(vector_capacity_bytes(halves), 10)
  Test.assert_eq(vector_element_size(words), 4)
  Test.assert_eq(vector_capacity_bytes(words), 20)
  Test.assert_eq(vector_element_size(records), 24)
  Test.assert_eq(vector_capacity_bytes(records), 48)
}

test "vector_push_get_and_growth_preserve_order" {
  let v = vector_with_capacity<i64>(1)
  vector_push<i64>(v, 10)
  vector_push<i64>(v, 20)
  vector_push<i64>(v, 30)
  Test.assert_eq(vector_len(v), 3)
  Test.assert_eq(if vector_capacity(v) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<i64>(v, 0, 0), 10)
  Test.assert_eq(vector_get<i64>(v, 1, 0), 20)
  Test.assert_eq(vector_get<i64>(v, 2, 0), 30)
}

test "vector_set_survives_intervening_test_effect" {
  let v = vector_from_range(0, 4)
  let ok = vector_set<i64>(v, 1, 41)
  Test.assert_eq(ok, 1)
  Test.assert_eq(vector_get<i64>(v, 1, 0), 41)
}

test "vector_packed_unsigned_bool_and_growth" {
  let bytes = vector_with_capacity<u8>(1)
  let flags = vector_with_capacity<bool>(1)
  vector_push<u8>(bytes, 250)
  vector_push<u8>(bytes, 251)
  vector_push<u8>(bytes, 252)
  vector_push<bool>(flags, true)
  vector_push<bool>(flags, false)
  Test.assert_eq(vector_len(bytes), 3)
  Test.assert_eq(vector_element_size(bytes), 1)
  Test.assert_eq(if vector_capacity_bytes(bytes) >= 3 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<u8>(bytes, 0, 0) == 250 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<u8>(bytes, 2, 0) == 252 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<bool>(flags, 0, false) { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<bool>(flags, 1, true) { 1 } else { 0 }, 0)
}

test "vector_packed_signed_values_sign_extend" {
  let tiny = vector_with_capacity<i8>(2)
  let halves = vector_with_capacity<i16>(2)
  let words = vector_with_capacity<i32>(2)
  vector_push<i8>(tiny, -8)
  vector_push<i8>(tiny, 7)
  vector_push<i16>(halves, -300)
  vector_push<i16>(halves, 301)
  vector_push<i32>(words, -32000)
  vector_push<i32>(words, 32001)
  Test.assert_eq(num_i8_to_i64(vector_get<i8>(tiny, 0, 0)), -8)
  Test.assert_eq(num_i8_to_i64(vector_get<i8>(tiny, 1, 0)), 7)
  Test.assert_eq(num_i16_to_i64(vector_get<i16>(halves, 0, 0)), -300)
  Test.assert_eq(num_i16_to_i64(vector_get<i16>(halves, 1, 0)), 301)
  Test.assert_eq(num_i32_to_i64(vector_get<i32>(words, 0, 0)), -32000)
  Test.assert_eq(num_i32_to_i64(vector_get<i32>(words, 1, 0)), 32001)
}

test "vector_packed_f32_round_trip" {
  let values = vector_with_capacity<f32>(2)
  vector_push<f32>(values, 1.25)
  vector_push<f32>(values, 2.5)
  Test.assert_eq(vector_element_size(values), 4)
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 0, 0.0), 1.25), 1)
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 1, 0.0), 2.5), 1)
  Test.assert_eq(vector_set<f32>(values, 1, 3.75), 1)
  Test.assert_eq(vector_same_f32(vector_get<f32>(values, 1, 0.0), 3.75), 1)
}

test "vector_inline_record_push_get_set_and_growth" {
  let values = vector_with_capacity<PackedReading>(2)
  vector_push<PackedReading>(values, packed_reading(-2, 40, 4))
  vector_push<PackedReading>(values, packed_reading(3, 50, -11))
  Test.assert_eq(vector_len(values), 2)
  Test.assert_eq(vector_capacity_bytes(values), 48)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0))), 42)
  Test.assert_eq(vector_get<PackedReading>(values, 1, packed_reading(0, 0, 0)).wide, 50)
  Test.assert_eq(vector_set<PackedReading>(values, 1, packed_reading(-8, 70, -20)), 1)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 1, packed_reading(0, 0, 0))), 42)
  vector_push<PackedReading>(values, packed_reading(1, 2, 3))
  Test.assert_eq(vector_len(values), 3)
  Test.assert_eq(if vector_capacity_bytes(values) >= 72 { 1 } else { 0 }, 1)
  Test.assert_eq(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0)).wide, 40)
}

test "vector_inline_record_bounds_use_default_and_reject_set" {
  let values = vector_with_capacity<PackedReading>(1)
  let fallback = packed_reading(-5, 90, -43)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, fallback)), 42)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0 - 1, fallback)), 42)
  Test.assert_eq(vector_set<PackedReading>(values, 0, packed_reading(1, 2, 3)), 0)
  vector_push<PackedReading>(values, packed_reading(1, 20, 21))
  Test.assert_eq(vector_set<PackedReading>(values, 1, packed_reading(4, 5, 6)), 0)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, fallback)), 42)
}

test "vector_inline_record_fold_swap_and_pop" {
  let values = vector_with_capacity<PackedReading>(2)
  vector_push<PackedReading>(values, packed_reading(1, 10, 31))
  vector_push<PackedReading>(values, packed_reading(2, 20, 20))
  Test.assert_eq(vector_fold<PackedReading, i64>(values, 0, packed_reading_sum), 84)
  Test.assert_eq(vector_swap<PackedReading>(values, 0, 1), 1)
  Test.assert_eq(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0)).wide, 20)
  let popped = vector_pop<PackedReading>(values)
  Test.assert_eq(option_has_value<PackedReading>(popped), 1)
  Test.assert_eq(vector_len(values), 1)
  Test.assert_eq(packed_reading_score(vector_get<PackedReading>(values, 0, packed_reading(0, 0, 0))), 42)
}

test "vector_inline_record_adversarial_byte_packing" {
  let values = vector_with_capacity<TinyPacket>(2)
  vector_push<TinyPacket>(values, tiny_packet(250, -8, true))
  vector_push<TinyPacket>(values, tiny_packet(7, 6, false))
  Test.assert_eq(vector_element_size(values), 3)
  Test.assert_eq(vector_capacity_bytes(values), 6)
  Test.assert_eq(if vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).a == 250 { 1 } else { 0 }, 1)
  Test.assert_eq(num_i8_to_i64(vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).b), -8)
  Test.assert_eq(if vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).ok { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<TinyPacket>(values, 1, tiny_packet(0, 0, true)).ok { 1 } else { 0 }, 0)
}

test "vector_set_swap_pop_and_clear" {
  let v = vector_from_range(0, 4)
  Test.assert_eq(vector_set<i64>(v, 1, 41), 1)
  Test.assert_eq(vector_get<i64>(v, 1, 0), 41)
  Test.assert_eq(vector_swap<i64>(v, 0, 3), 1)
  Test.assert_eq(vector_get<i64>(v, 0, 0), 3)
  Test.assert_eq(vector_get<i64>(v, 3, 0), 0)
  let popped = vector_pop<i64>(v)
  Test.assert_eq(option_has_value<i64>(popped), 1)
  Test.assert_eq(option_value_or_i64(popped, 0), 0)
  Test.assert_eq(vector_len(v), 3)
  vector_clear(v)
  Test.assert_eq(vector_len(v), 0)
  Test.assert_eq(vector_is_empty(v), 1)
}

test "vector_map_fold_and_search" {
  let v = vector_from_range(1, 6)
  let doubled = vector_map<i64, i64>(v, vec_double)
  Test.assert_eq(vector_fold<i64, i64>(v, 0, vec_sum), 15)
  Test.assert_eq(vector_fold<i64, i64>(doubled, 0, vec_sum), 30)
  Test.assert_eq(vector_fold<i64, i64>(doubled, 0, vec_count), 5)
  Test.assert_eq(option_usize_equals(vector_index_of_i64(doubled, 6), 2), 1)
  Test.assert_eq(option_has_value<usize>(vector_index_of_i64(doubled, 11)), 0)
  Test.assert_eq(vector_contains_i64(doubled, 10), 1)
  Test.assert_eq(vector_contains_i64(doubled, 11), 0)
}

test "vector_slice_clamps_half_open_ranges" {
  let values = vector_from_range(0, 5)
  let middle = vector_slice<i64>(values, 1, 4)
  let clamped_left = vector_slice<i64>(values, 0 - 4, 2)
  let clamped_right = vector_slice<i64>(values, 4, 99)
  let inverted = vector_slice<i64>(values, 4, 2)
  let past_end = vector_slice<i64>(values, 9, 12)
  Test.assert_eq(vector_len<i64>(middle), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(middle, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(middle, 2), 3)
  Test.assert_eq(vector_len<i64>(clamped_left), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(clamped_left, 0), 0)
  Test.assert_eq(vector_get_in_bounds<i64>(clamped_left, 1), 1)
  Test.assert_eq(vector_len<i64>(clamped_right), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(clamped_right, 0), 4)
  Test.assert_eq(vector_len<i64>(inverted), 0)
  Test.assert_eq(vector_len<i64>(past_end), 0)
  Test.assert_eq(vector_len<i64>(values), 5)
}

test "vector_insert_and_remove_preserve_order_and_boundaries" {
  let values = vector_new<i64>()
  vector_push<i64>(values, 1)
  vector_push<i64>(values, 3)
  Test.assert_eq(vector_insert_at<i64>(values, 1, 2), 1)
  Test.assert_eq(vector_insert_at<i64>(values, 0, 0), 1)
  Test.assert_eq(vector_insert_at<i64>(values, vector_len<i64>(values), 4), 1)
  Test.assert_eq(vector_insert_at<i64>(values, 0 - 1, 99), 0)
  Test.assert_eq(vector_insert_at<i64>(values, vector_len<i64>(values) + 1, 99), 0)
  Test.assert_eq(vector_len<i64>(values), 5)
  for i in 0..5 { Test.assert_eq(vector_get_in_bounds<i64>(values, i), i) }

  Test.assert_eq(option_value_or_i64(vector_remove_at<i64>(values, 2), 99), 2)
  Test.assert_eq(option_value_or_i64(vector_remove_at<i64>(values, 0), 99), 0)
  Test.assert_eq(option_value_or_i64(vector_remove_at<i64>(values, vector_len<i64>(values) - 1), 99), 4)
  Test.assert_eq(option_has_value<i64>(vector_remove_at<i64>(values, 0 - 1)), 0)
  Test.assert_eq(option_has_value<i64>(vector_remove_at<i64>(values, vector_len<i64>(values))), 0)
  Test.assert_eq(vector_len<i64>(values), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 1), 3)
  let empty = vector_new<i64>()
  Test.assert_eq(option_has_value<i64>(vector_remove_at<i64>(empty, 0)), 0)
}

test "vector_concat_reverse_filter_find_and_dedup" {
  let left = vector_from_range(0, 3)
  let right = vector_from_range(3, 6)
  let joined = vector_concat<i64>(left, right)
  Test.assert_eq(vector_len<i64>(joined), 6)
  for i in 0..6 { Test.assert_eq(vector_get_in_bounds<i64>(joined, i), i) }
  Test.assert_eq(vector_len<i64>(left), 3)
  Test.assert_eq(vector_data<i64>(vector_reverse<i64>(joined)), vector_data<i64>(joined))
  for i in 0..6 { Test.assert_eq(vector_get_in_bounds<i64>(joined, i), 5 - i) }

  let evens = vector_filter<i64>(joined, vec_even)
  Test.assert_eq(vector_len<i64>(evens), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(evens, 0), 4)
  Test.assert_eq(vector_get_in_bounds<i64>(evens, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(evens, 2), 0)
  Test.assert_eq(option_value_or_i64(vector_find<i64>(joined, vec_gt_three), 0 - 1), 5)
  Test.assert_eq(option_has_value<i64>(vector_find<i64>(evens, x => x > 10)), 0)

  let duplicates = vector_new<i64>()
  vector_push<i64>(duplicates, 1)
  vector_push<i64>(duplicates, 1)
  vector_push<i64>(duplicates, 2)
  vector_push<i64>(duplicates, 2)
  vector_push<i64>(duplicates, 2)
  vector_push<i64>(duplicates, 1)
  let deduped = vector_dedup<i64>(duplicates)
  Test.assert_eq(vector_len<i64>(deduped), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(deduped, 2), 1)
  Test.assert_eq(vector_len<i64>(duplicates), 6)
  Test.assert_eq(option_usize_equals(vector_index_of_by<i64>(duplicates, 2, vec_same_i64), 2), 1)
}

test "property_vector_reverse_twice_is_identity" {
  Test.forall_i64_range(0, 40, vector_reverse_property)
}

test "vector_breadth_managed_values_reclaim" {
  Test.assert_eq(vector_breadth_box_round(), 33)
  Test.assert_eq(vector_breadth_box_round(), 33)
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..20 { checksum = checksum + vector_breadth_box_round() }
  let after = alloc_bump_mark()
  Test.assert_eq(checksum, 660)
  Test.assert_eq(after - before, 0)
}

test "vector_bounds_sad_paths" {
  let v = vector_from_range(3, 6)
  let bytes = vector_with_capacity<u8>(2)
  vector_push<u8>(bytes, 9)
  vector_push<u8>(bytes, 10)
  Test.assert_eq(vector_get<i64>(v, 0 - 1, 99), 99)
  Test.assert_eq(vector_get<i64>(v, 3, 99), 99)
  Test.assert_eq(if vector_get<u8>(bytes, 0 - 1, 88) == 88 { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get<u8>(bytes, 2, 77) == 77 { 1 } else { 0 }, 1)
  Test.assert_eq(option_has_value<i64>(vector_get_option<i64>(v, 0 - 1)), 0)
  Test.assert_eq(option_has_value<i64>(vector_get_option<i64>(v, 3)), 0)
  Test.assert_eq(vector_set<i64>(v, 0 - 1, 42), 0)
  Test.assert_eq(vector_set<i64>(v, 3, 42), 0)
  Test.assert_eq(vector_set<u8>(bytes, 0 - 1, 42), 0)
  Test.assert_eq(vector_set<u8>(bytes, 2, 42), 0)
  Test.assert_eq(vector_swap<i64>(v, 0, 3), 0)
  Test.assert_eq(vector_get<i64>(v, 0, 0), 3)
  Test.assert_eq(if vector_get<u8>(bytes, 0, 0) == 9 { 1 } else { 0 }, 1)
}

test "vector_pop_empty_sad_path" {
  let v = vector_new<i64>()
  let popped = vector_pop<i64>(v)
  Test.assert_eq(option_has_value<i64>(popped), 0)
  Test.assert_eq(vector_len(v), 0)
}

test "property_vector_push_increments_length" {
  Test.forall_i64_range(0, 16, vector_push_len_property)
}

test "vector_sort_ord_handles_empty_singleton_reverse_and_duplicates" {
  let empty = vector_sort<i64>(vector_new<i64>())
  let singleton = vector_new<i64>()
  vector_push<i64>(singleton, 42)
  vector_sort<i64>(singleton)
  let values = vector_new<i64>()
  vector_push<i64>(values, 5)
  vector_push<i64>(values, 3)
  vector_push<i64>(values, 5)
  vector_push<i64>(values, 1)
  vector_push<i64>(values, 0 - 2)
  vector_push<i64>(values, 3)
  let sorted = vector_sort<i64>(values)
  Test.assert_eq(vector_len<i64>(empty), 0)
  Test.assert_eq(vector_get_in_bounds<i64>(singleton, 0), 42)
  Test.assert_eq(vector_data<i64>(sorted), vector_data<i64>(values))
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 0), 0 - 2)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 1), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 3), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 4), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 5), 5)
}

test "vector_sort_by_honours_custom_descending_comparator" {
  let values = vector_from_range(0, 6)
  let sorted = vector_sort_by<i64>(values, vector_sort_desc_i64)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 0), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 1), 4)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 3), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 4), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(sorted, 5), 0)
}

test "vector_sort_ord_covers_inline_records_and_utf8_strings" {
  let readings = vector_new<PackedReading>()
  vector_push<PackedReading>(readings, packed_reading(1, 30, 1))
  vector_push<PackedReading>(readings, packed_reading(2, 10, 2))
  vector_push<PackedReading>(readings, packed_reading(3, 20, 3))
  vector_sort<PackedReading>(readings)
  Test.assert_eq(vector_get_in_bounds<PackedReading>(readings, 0).wide, 10)
  Test.assert_eq(vector_get_in_bounds<PackedReading>(readings, 1).wide, 20)
  Test.assert_eq(vector_get_in_bounds<PackedReading>(readings, 2).wide, 30)

  let words = vector_new<str>()
  vector_push<str>(words, "é")
  vector_push<str>(words, "z")
  vector_push<str>(words, "a")
  vector_sort<str>(words)
  Test.assert_eq(if vector_get_in_bounds<str>(words, 0) == "a" { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get_in_bounds<str>(words, 1) == "z" { 1 } else { 0 }, 1)
  Test.assert_eq(if vector_get_in_bounds<str>(words, 2) == "é" { 1 } else { 0 }, 1)
}

test "property_vector_sort_is_ordered_and_preserves_multiplicity" {
  Test.forall_i64_range(0, 40, vector_sort_property)
}

test "vector_sort_managed_elements_reclaim_after_swaps" {
  Test.assert_eq(vector_sort_box_round(16), 15)
  Test.assert_eq(vector_sort_box_round(16), 15)
  let before = alloc_bump_mark()
  let mut checksum = 0
  for i in 0..20 {
    checksum = checksum + vector_sort_box_round(16)
  }
  let after = alloc_bump_mark()
  Test.assert_eq(checksum, 300)
  Test.assert_eq(after - before, 0)
}

type FrameFreeBox { FrameFreeBox(i64, i64) }

fn frame_free_box_key(b: FrameFreeBox) -> i64 {
  match b { FrameFreeBox(k, v) -> k }
}

test "vector_access_transmute_handlers_stay_frame_free" {
  -- The sealed-Unsafe transmute helpers on the managed-element access
  -- path must compile frame-free inside monomorphized copies (2r
  -- slice 0): a handler frame per element load was 325MB of
  -- sorted_lookup RSS. i64 elements lower through the direct fast
  -- path, so the lock uses a managed element type — that is the shape
  -- that reaches vector_storage_word_as<T>. Bump-arena movement here
  -- means the discharge idiom regressed.
  let v = vector_new<FrameFreeBox>()
  let mut i = 0
  while i < 64 {
    vector_push<FrameFreeBox>(v, FrameFreeBox(i * 3, i))
    i = i + 1
  }
  let mut warm = 0
  let mut acc = 0
  while warm < 100 {
    acc = acc + frame_free_box_key(vector_get_in_bounds<FrameFreeBox>(v, warm - warm / 64 * 64))
    warm = warm + 1
  }
  let before = alloc_bump_mark()
  let mut r = 0
  while r < 20000 {
    acc = acc + frame_free_box_key(vector_get_in_bounds<FrameFreeBox>(v, r - r / 64 * 64))
    r = r + 1
  }
  let after = alloc_bump_mark()
  Test.assert_eq(after - before, 0)
}

test "vector_fixed_arrays_preserve_inline_shape_across_mutation" {
  let values = vector_new<[i64; 2]>()
  vector_push<[i64; 2]>(values, [1, 2])
  vector_push<[i64; 2]>(values, [3, 4])
  vector_swap<[i64; 2]>(values, 0, 1)
  vector_set<[i64; 2]>(values, 1, [7, 8])
  let first = vector_get_in_bounds<[i64; 2]>(values, 0)
  let second = vector_get_in_bounds<[i64; 2]>(values, 1)
  Test.assert_eq(first[0] * 1000 + first[1] * 100 + second[0] * 10 + second[1], 3478)

  let nested = vector_new<[[i64; 2]; 2]>()
  vector_push<[[i64; 2]; 2]>(nested, [[10, 11], [12, 13]])
  let matrix = vector_get_in_bounds<[[i64; 2]; 2]>(nested, 0)
  Test.assert_eq(matrix[0][0] + matrix[0][1] + matrix[1][0] + matrix[1][1], 46)
}

test "vector_managed_fixed_arrays_retain_each_leaf" {
  let values = vector_new<[str; 2]>()
  vector_push<[str; 2]>(values, [str_concat("a", "1"), str_concat("b", "2")])
  vector_push<[str; 2]>(values, [str_concat("c", "3"), str_concat("d", "4")])
  vector_swap<[str; 2]>(values, 0, 1)
  vector_set<[str; 2]>(values, 1, [str_concat("e", "5"), str_concat("f", "6")])
  let first = vector_get_in_bounds<[str; 2]>(values, 0)
  let second = vector_get_in_bounds<[str; 2]>(values, 1)
  Test.assert_eq(str_eq(first[0], "c3") + str_eq(first[1], "d4"), 2)
  Test.assert_eq(str_eq(second[0], "e5") + str_eq(second[1], "f6"), 2)
  vector_clear<[str; 2]>(values)
  Test.assert_eq(vector_len<[str; 2]>(values), 0)
}

test "vector_zero_length_arrays_are_real_elements" {
  let empty: [i64; 0] = []
  let values = vector_new<[i64; 0]>()
  vector_push<[i64; 0]>(values, empty)
  vector_push<[i64; 0]>(values, [])
  let loaded = vector_get_in_bounds<[i64; 0]>(values, 1)
  Test.assert_eq(vector_len<[i64; 0]>(values), 2)
  Test.assert_eq(vector_capacity_bytes<[i64; 0]>(values), 0)
  Test.assert_eq(if loaded.len == 0 { 1 } else { 0 }, 1)
  vector_clear<[i64; 0]>(values)
  Test.assert_eq(vector_len<[i64; 0]>(values), 0)
}
