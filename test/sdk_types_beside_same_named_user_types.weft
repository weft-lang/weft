-- Checker-synthesized SDK types carry their exact declarations. A module may
-- declare types spelled like them without changing what conversions, slicing
-- or iteration produce.

use stdlib/vector as vector
use stdlib/vector.{to_array, to_vector}

type Vector<T> { first: T }

type Iterator<T> { position: T }

type Option<T> { Held(T), Empty }

fn view_total(view: [i64]) -> i64 {
  let mut total = 0
  for value in view { total = total + value }
  total
}

test "to_vector produces the runtime vector beside a user Vector" {
  let source = [1, 2, 3]
  let converted = source.to_vector()
  let local = Vector<i64> { first: 4 }
  Test.assert_eq_usize(converted.len(), 3)
  Test.assert_eq(view_total(converted[0..2]) + local.first, 7)
}

test "iteration uses the runtime iterator beside a user Iterator" {
  let mut values = vector.new<i64>()
  values.push(5)
  values.push(6)
  let iterator = values.into_iter()
  let mut total = 0
  for value in iterator { total = total + value }
  let local = Iterator<i64> { position: 1 }
  Test.assert_eq(total + local.position, 12)
}

test "to_array produces the runtime option beside a user Option" {
  let source = [7, 8]
  let converted = source.to_vector()
  let fixed = match converted.to_array < 2 > () {
    Some(values) -> values[0] + values[1]
    None -> 0
  }
  let local = match Held<i64>(3) {
    Held(value) -> value
    Empty -> 0
  }
  Test.assert_eq(fixed + local, 18)
}
