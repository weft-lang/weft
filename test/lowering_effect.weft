use module_fixtures/compiler_probe.{require_checked}
use compiler/weft/products.{TypedModule}
use compiler/pipeline.{IrModule, pipeline_check_source_standalone, pipeline_ir_functions, pipeline_ir_module, pipeline_lower_checked, pipeline_lower_checked_with_weft}
use compiler/ir/data.{ir_function_list_len, ir_function_list_empty}
use stdlib/lower as lowering
use stdlib/lower.{Lower}

type ScalarExpression {
  ScalarLiteral(i64),
  ScalarAdd(i64, i64)
}

type ScalarInterpretation {
  ScalarReference,
  ScalarSpecialized
}

type ScalarProduct {
  value: i64,
  interpretation: ScalarInterpretation
}

effect LowerOffset {
  fn read() -> i64
}

fn scalar_request(expression: ScalarExpression) -[Lower<ScalarExpression, ScalarProduct>]> ScalarProduct {
  lowering.lower<ScalarExpression, ScalarProduct>(expression)
}

fn scalar_value(expression: ScalarExpression) -> i64 {
  match expression {
    ScalarLiteral(value) -> value
    ScalarAdd(left, right) -> left + right
  }
}

fn scalar_reference<T, E>(body: () -[Lower<ScalarExpression, ScalarProduct>, E]> T) -[E]> T {
  handle body() {
    Lower<ScalarExpression, ScalarProduct>.lower(expression) -> resume(ScalarProduct {
      value: scalar_value(expression),
      interpretation: ScalarReference
    })
  }
}

fn scalar_specialized<T, E>(body: () -[Lower<ScalarExpression, ScalarProduct>, E]> T) -[E]> T {
  handle body() {
    Lower<ScalarExpression, ScalarProduct>.lower(expression) -> resume(ScalarProduct {
      value: scalar_value(expression),
      interpretation: ScalarSpecialized
    })
  }
}

test "generic Lower handlers select interpretations of one named source" {
  let reference = scalar_reference(() => scalar_request(ScalarAdd(40, 2)))
  let specialized = scalar_specialized(() => scalar_request(ScalarAdd(40, 2)))
  Test.assert_eq(reference.value, 42)
  Test.assert_eq(specialized.value, 42)
  Test.assert_true(match reference.interpretation { ScalarReference -> true, ScalarSpecialized -> false })
  Test.assert_true(match specialized.interpretation { ScalarReference -> false, ScalarSpecialized -> true })
}

test "Lower source and product arguments are part of capability identity" {
  let value = handle {
    let scalar = handle scalar_request(ScalarLiteral(42)) {
      Lower<ScalarExpression, ScalarProduct>.lower(expression) -> resume(ScalarProduct {
        value: scalar_value(expression),
        interpretation: ScalarReference
      })
    }
    let numbered = lowering.lower<i64, ScalarProduct>(41)
    ScalarProduct {
      value: scalar.value + numbered.value,
      interpretation: scalar.interpretation
    }
  } {
    Lower<i64, ScalarProduct>.lower(value) -> resume(ScalarProduct {
      value: value + 1,
      interpretation: ScalarSpecialized
    })
  }
  Test.assert_eq(value.value, 84)
  Test.assert_true(match value.interpretation { ScalarReference -> true, ScalarSpecialized -> false })
}

test "a Lower handler preserves unrelated residual effects" {
  let value = handle scalar_reference(() => {
    let product = scalar_request(ScalarLiteral(40))
    product.value + LowerOffset.read()
  }) {
    LowerOffset.read() -> resume(2)
  }
  Test.assert_eq(value, 42)
}

test "the current Weft IR builder is one Lower handler interpretation" {
  let typed = require_checked(pipeline_check_source_standalone(__str_ptr("fn main() -> i64 { 42 }"), __str_len("fn main() -> i64 { 42 }")))
  let direct = pipeline_lower_checked_with_weft(typed)
  let interpreted = handle pipeline_lower_checked(typed) {
    Lower<TypedModule, IrModule>.lower(module) -> resume(pipeline_lower_checked_with_weft(module))
  }
  Test.assert_eq(
    ir_function_list_len(pipeline_ir_functions(interpreted)),
    ir_function_list_len(pipeline_ir_functions(direct))
  )
}

test "a different Weft Lower handler can suppress IR construction" {
  let typed = require_checked(pipeline_check_source_standalone(__str_ptr("fn main() -> i64 { 42 }"), __str_len("fn main() -> i64 { 42 }")))
  let interpreted = handle pipeline_lower_checked(typed) {
    Lower<TypedModule, IrModule>.lower(module) -> resume(pipeline_ir_module(ir_function_list_empty()))
  }
  Test.assert_eq(ir_function_list_len(pipeline_ir_functions(interpreted)), 0)
}
