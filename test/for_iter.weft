-- test/for_iter.weft — list-backed iterator for loops

type ForList { Nil, Cons(i64, ForList) }

test "for_iter_sum_list" {
  let xs = Cons(10, Cons(11, Cons(21, Nil)))
  let mut s: i64 = 0
  for x in xs {
    s = s + x
  }
  Test.assert_eq(s, 42)
}

test "for_iter_empty_list" {
  let xs = Nil
  let mut s: i64 = 42
  for x in xs {
    s = s + x
  }
  Test.assert_eq(s, 42)
}

test "for_iter_body_branch" {
  let xs = Cons(10, Cons(32, Nil))
  let mut s: i64 = 0
  for x in xs {
    if x == 10 {
      s = s + x
    } else {
      s = s + x
    }
  }
  Test.assert_eq(s, 42)
}
