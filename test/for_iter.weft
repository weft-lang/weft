-- test/for_iter.weft — list-backed iterator for loops

use stdlib/list as list

type ForIterBox<T> { value: T }

type ForIterEntry<T> { box: ForIterBox<T> }

type ForIterEntries<T> = list.List<ForIterEntry<T>>

fn for_iter_collect<T>(entries: ForIterEntries<T>) -> list.List<T> {
  let mut result = Nil<T>()
  for entry in entries {
    let box = entry.box
    result = result.append(box.value)
  }
  result
}

test "for_iter_sum_list" {
  let values = [10, 11, 21]
  let xs = list.from_slice(values[..])
  let mut s: i64 = 0
  for x in xs {
    s = s + x
  }
  Test.assert_eq(s, 42)
}

test "for_iter_empty_list" {
  let values: [i64; 0] = []
  let xs = list.from_slice(values[..])
  let mut s: i64 = 42
  for x in xs {
    s = s + x
  }
  Test.assert_eq(s, 42)
}

test "for_iter_body_branch" {
  let values = [10, 32]
  let xs = list.from_slice(values[..])
  let mut s: i64 = 0
  for x in xs {
    if x == 10 {
      s = s + x
    } else {
      s = s + x
    }
  }
  Test.assert_eq(s, 42)
}

test "for_iter_generic_record_field_binding_uses_specialisation" {
  let entries = [ForIterEntry { box: ForIterBox { value: 42 } }]
  match for_iter_collect(list.from_slice(entries[..])) {
    Cons(value, Nil) -> Test.assert_eq(value, 42)
    _ -> Test.assert_true(false)
  }
}
