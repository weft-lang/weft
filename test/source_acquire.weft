use compiler/source/trust.{
  source_trust_path_can_grant_import_trust,
  source_trust_allows_internal_ownership
}
use runtime/memory.{mem_copy, mem_load8_at, mem_load64_at, mem_store64_at}
use runtime/source_acquire.{
  CheckoutSdk,
  EmbeddedSdk,
  NoSdk,
  SdkSourceFound,
  SdkSourceMissing,
  SdkSourceInvalidPath,
  SourceAcquire,
  source_acquire_with_archive,
  source_acquire_with_checkout,
  source_acquire_with_standalone
}
use runtime/sdk_archive.{SdkArchive, sdk_archive_validate, sdk_archive_digest}
use runtime/sha256.{sha256, sha256_with_zeroed_range}
use stdlib/bytes.{Bytes, bytes_storage}
use stdlib/num
use stdlib/result.{Result}
use stdlib/vector as vector
use stdlib/vector.{vector_data}
use stdlib/vector/handles.{Vector}

effect SourceAcquireResidual {
  fn value() -> i64
}

fn source_acquire_archive_fixture() -> owned Vector<u8> {
  let path = "stdlib/string.weft"
  let source = "pub fn embedded_marker() -> i64 { 73 }"
  let header_size = 96
  let entry_size = 32
  let path_offset = header_size + entry_size
  let source_offset = path_offset + __str_len(path)
  let total = source_offset + __str_len(source)
  let mut archive = vector.with_capacity<u8>(
    total.to_usize_checked().expect("fixture length is finite")
  )
  for index in 0..total { archive.push(0) }
  let bytes = vector_data<u8>(archive)

  mem_copy(bytes, __str_ptr("WEFTSDK1"), 8)
  mem_store64_at(bytes, 8, 1)
  mem_store64_at(bytes, 16, 1)
  mem_store64_at(bytes, 24, entry_size)
  mem_store64_at(bytes, 32, total)
  mem_store64_at(bytes, 40, header_size)
  mem_store64_at(bytes, header_size, path_offset)
  mem_store64_at(bytes, header_size + 8, __str_len(path))
  mem_store64_at(bytes, header_size + 16, source_offset)
  mem_store64_at(bytes, header_size + 24, __str_len(source))
  mem_copy(bytes + path_offset, __str_ptr(path), __str_len(path))
  mem_copy(bytes + source_offset, __str_ptr(source), __str_len(source))
  sha256(bytes, total, bytes + 64)
  archive
}

fn source_acquire_validated(archive: borrow Vector<u8>) -> SdkArchive {
  sdk_archive_validate(
    vector_data<u8>(archive),
    archive.len().to_u64().to_i64_checked().expect("fixture length fits i64")
  ).expect("fixture validates")
}

test "SDK handlers share missing and noncanonical path semantics" {
  let archive = source_acquire_archive_fixture()
  let validated = source_acquire_validated(archive)
  for path in [
    "",
    "/stdlib/string.weft",
    "stdlib/../weft.pkg",
    "stdlib//string.weft",
    "stdlib/./string.weft"
  ] {
    let request = () => SourceAcquire.load_sdk(path)
    Test.assert_true(
      match source_acquire_with_archive(validated, request) {
        SdkSourceInvalidPath -> true,
        _ -> false
      }
    )
    Test.assert_true(
      match source_acquire_with_checkout(".", request) {
        SdkSourceInvalidPath -> true,
        _ -> false
      }
    )
    Test.assert_true(
      match source_acquire_with_standalone(request) { SdkSourceInvalidPath -> true, _ -> false }
    )
  }
  let missing = "stdlib/definitely_missing_sdk_module.weft"
  let request = () => SourceAcquire.load_sdk(missing)
  Test.assert_true(
    match source_acquire_with_archive(validated, request) { SdkSourceMissing -> true, _ -> false }
  )
  Test.assert_true(
    match source_acquire_with_checkout(".", request) { SdkSourceMissing -> true, _ -> false }
  )
  Test.assert_true(
    match source_acquire_with_standalone(request) { SdkSourceMissing -> true, _ -> false }
  )
}

test "an empty SDK entry is present rather than missing" {
  let archive = source_acquire_archive_fixture()
  let bytes = vector_data<u8>(archive)
  let data_offset = mem_load64_at(bytes, 96 + 16)
  mem_store64_at(bytes, 96 + 24, 0)
  mem_store64_at(bytes, 32, data_offset)
  sha256_with_zeroed_range(bytes, data_offset, 64, 32, bytes + 64)
  let validated = sdk_archive_validate(bytes, data_offset).expect("empty entry validates")
  let path = "stdlib/string.weft"
  match source_acquire_with_archive(validated, () => SourceAcquire.load_sdk(path)) {
    SdkSourceFound(content) -> Test.assert_true(content.is_empty())
    SdkSourceMissing -> Test.assert_true(false)
    SdkSourceInvalidPath -> Test.assert_true(false)
  }
}

fn source_acquire_residual_probe() -[SourceAcquire, SourceAcquireResidual]> i64 {
  let loaded = SourceAcquire.load("compiler/storage.weft", "logical/compiler_lib", 73)
  SourceAcquireResidual.value() + match loaded {
    nil -> 0
    content: Bytes -> if content.is_empty() { 0 } else { 1 }
  }
}

fn source_acquire_text(loaded: Bytes?) -> str {
  match loaded {
    nil -> ""
    content: Bytes -> bytes_storage(content)
  }
}

fn source_acquire_is_missing(loaded: Bytes?) -> bool {
  match loaded {
    nil -> true
    _ -> false
  }
}

test "standalone source acquisition reads the complete requested file" {
  let text = source_acquire_text(
    source_acquire_with_standalone(
      () => SourceAcquire.load("compiler/storage.weft", "ignored/logical/path", 91)
    )
  )
  Test.assert_true(text.len() > 100)
  Test.assert_true(text.starts_with("--"))
}

test "standalone source acquisition keeps an empty file present" {
  let text = source_acquire_with_standalone(
    () => SourceAcquire.load("test/fixtures/empty_source.weft", "empty", 0)
  )
  Test.assert_false(source_acquire_is_missing(text))
  Test.assert_str_eq(source_acquire_text(text), "")
}

test "standalone source acquisition returns the canonical missing result" {
  let loaded = source_acquire_with_standalone(
    () => SourceAcquire.load("test/fixtures/source-acquire-definitely-missing.weft", "missing", 0)
  )
  Test.assert_true(source_acquire_is_missing(loaded))
}

test "standalone source acquisition preserves residual effects" {
  let result = handle source_acquire_with_standalone(() => source_acquire_residual_probe()) {
    SourceAcquireResidual.value() -> resume(41)
  }

  Test.assert_eq(result, 42)
}

test "source acquisition publishes typed SDK origins" {
  match source_acquire_with_standalone(() => SourceAcquire.sdk_origin()) {
    NoSdk -> Test.assert_true(true)
    CheckoutSdk(root) -> Test.assert_true(false)
    EmbeddedSdk(digest) -> Test.assert_true(false)
  }

  match source_acquire_with_checkout("/opt/weft/sdk", () => SourceAcquire.sdk_origin()) {
    CheckoutSdk(root) -> Test.assert_str_eq(root, "/opt/weft/sdk")
    EmbeddedSdk(digest) -> Test.assert_true(false)
    NoSdk -> Test.assert_true(false)
  }

  let archive = source_acquire_archive_fixture()
  match source_acquire_with_archive(
    source_acquire_validated(archive),
    () => SourceAcquire.sdk_origin()
  ) {
    EmbeddedSdk(digest) -> Test.assert_str_eq(
      digest,
      sdk_archive_digest(source_acquire_validated(archive))
    )
    CheckoutSdk(root) -> Test.assert_true(false)
    NoSdk -> Test.assert_true(false)
  }
}

test "embedded SDK acquisition returns the archive entry's exact bytes" {
  let archive = source_acquire_archive_fixture()
  let loaded = source_acquire_with_archive(
    source_acquire_validated(archive),
    () => SourceAcquire.load_sdk("stdlib/string.weft")
  )
  match loaded {
    SdkSourceFound(content) -> Test.assert_str_eq(
      bytes_storage(content),
      "pub fn embedded_marker() -> i64 { 73 }"
    )
    SdkSourceMissing -> Test.assert_true(false)
    SdkSourceInvalidPath -> Test.assert_true(false)
  }
}

test "embedded SDK acquisition preserves project filesystem loading" {
  let archive = source_acquire_archive_fixture()
  let loaded = source_acquire_with_archive(
    source_acquire_validated(archive),
    () => SourceAcquire.load("test/source_acquire.weft", "test/source_acquire", 0)
  )
  Test.assert_true(source_acquire_text(loaded).len() > 100)
}

test "checkout SDK acquisition redirects only explicit SDK requests" {
  let installed = source_acquire_with_checkout(
    ".",
    () => SourceAcquire.load_sdk("stdlib/string.weft")
  )
  match installed {
    SdkSourceFound(content) -> Test.assert_true(bytes_storage(content).len() > 100)
    SdkSourceMissing -> Test.assert_true(false)
    SdkSourceInvalidPath -> Test.assert_true(false)
  }
  -- A root spelled without its trailing separator joins with one.
  let unslashed = source_acquire_with_checkout(
    "test",
    () => SourceAcquire.load_sdk("source_acquire.weft")
  )
  Test.assert_true(match unslashed { SdkSourceFound(content) -> true, _ -> false })
  let slashed = source_acquire_with_checkout(
    "test/",
    () => SourceAcquire.load_sdk("source_acquire.weft")
  )
  Test.assert_true(match slashed { SdkSourceFound(content) -> true, _ -> false })

  let missing = source_acquire_with_checkout(
    "test/fixtures/source-acquire-definitely-missing",
    () => SourceAcquire.load_sdk("stdlib/string.weft")
  )
  Test.assert_true(match missing { SdkSourceMissing -> true, _ -> false })

  let compiler = source_acquire_with_checkout(
    "test/fixtures/source-acquire-definitely-missing",
    () => SourceAcquire.load_sdk("compiler/storage.weft")
  )
  Test.assert_true(match compiler { SdkSourceMissing -> true, _ -> false })

  let project = source_acquire_with_checkout(
    "test/fixtures/source-acquire-definitely-missing",
    () => SourceAcquire.load("test/source_acquire.weft", "test/source_acquire", 0)
  )
  Test.assert_true(source_acquire_text(project).len() > 100)
}

test "SDK handlers do not reinterpret physical package paths as SDK authority" {
  let archive = source_acquire_archive_fixture()
  let embedded = source_acquire_with_archive(
    source_acquire_validated(archive),
    () => SourceAcquire.load("compiler/storage.weft", "lib", 91)
  )
  let checkout = source_acquire_with_checkout(
    "test/fixtures/source-acquire-definitely-missing",
    () => SourceAcquire.load("compiler/storage.weft", "lib", 91)
  )
  Test.assert_true(source_acquire_text(embedded).len() > 100)
  Test.assert_true(source_acquire_text(checkout).len() > 100)
}

test "source trust grants name exact compiler authority modules" {
  for name in [
    "compiler/source/registration.weft",
    "compiler/pipeline.weft",
    "compiler/main.weft"
  ] {
    Test.assert_eq(source_trust_path_can_grant_import_trust(__str_ptr(name), __str_len(name)), 1)
  }
  for name in [
    "compiler/weft/parse.weft",
    "compiler/weft/grammar.weft",
    "compiler/weft/imports.weft",
    "stdlib/grammar.weft",
    "stdlib/grammar/sql.weft",
    "source_registration.weft",
    "compiler/source_registration.weft",
    "compiler/source/registration",
    "compiler/source/registration.weft/child",
    "compiler/source/registration.weft.extra",
    "other/compiler/source_registration.weft",
    "compiler/source/loading.weft",
    "other/compiler/source/registration.weft"
  ] {
    Test.assert_eq(source_trust_path_can_grant_import_trust(__str_ptr(name), __str_len(name)), 0)
  }
}

test "internal ownership notation names only the current compiler leaves" {
  for name in [
    "compiler/backend/link.weft",
    "compiler/backend/macho.weft",
    "compiler/backend/object.weft",
    "compiler/pipeline.weft"
  ] {
    Test.assert_eq(source_trust_allows_internal_ownership(__str_ptr(name), __str_len(name)), 1)
  }
  for name in [
    "compiler/macho.weft",
    "compiler/object.weft",
    "compiler/backend/macho",
    "compiler/backend/object.weft/child",
    "compiler/backend/macho.weft.extra",
    "compiler/backend/link",
    "other/compiler/backend/link.weft",
    "other/compiler/backend/macho.weft",
    "compiler/backend/elf.weft"
  ] {
    Test.assert_eq(source_trust_allows_internal_ownership(__str_ptr(name), __str_len(name)), 0)
  }
}
