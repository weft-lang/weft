-- test/stdlib_dns.weft — DNS capability and deterministic fake semantics

use stdlib/display.{Display}
use stdlib/eq.{Eq}
use stdlib/dns.{DnsAnyFamily, DnsError, DnsFakeAddresses, DnsFakeFailure, DnsFakeRecord, DnsFamilyUnavailable, DnsIpv4Only, DnsIpv6Only, DnsNameNotFound, DnsPermanentFailure, DnsPlatform, DnsPolicy, DnsPolicyAllowOnly, DnsPolicyDenied, DnsPolicyTarget, DnsResolve, DnsResourceExhausted, DnsTemporaryFailure, dns_numeric_candidates, dns_resolve, dns_with_fake, dns_with_policy}
use stdlib/idna.{DomainName, domain_name_parse}
use stdlib/net_address.{IpAddress, IpV4, IpV6, SocketAddress, SocketV4, SocketV6, ipv4_address, ipv6_address}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{vector_get_option, vector_len, vector_new, vector_push}
use stdlib/vector/handles.{Vector}

effect DnsResidual {
  fn tick() -> i64
}

fn dns_test_domain(source: str) -> DomainName {
  domain_name_parse(source).expect("test domain must be valid")
}

fn dns_test_addresses() -> Vector<IpAddress> {
  let addresses = vector_new<IpAddress>()
  vector_push<IpAddress>(addresses, IpV6(ipv6_address(8193, 3512, 0, 0, 0, 0, 0, 2)))
  vector_push<IpAddress>(addresses, IpV4(ipv4_address(192, 0, 2, 1)))
  vector_push<IpAddress>(addresses, IpV6(ipv6_address(8193, 3512, 0, 0, 0, 0, 0, 1)))
  addresses
}

fn dns_test_records(host: DomainName, addresses: Vector<IpAddress>) -> Vector<DnsFakeRecord> {
  let records = vector_new<DnsFakeRecord>()
  vector_push<DnsFakeRecord>(records, DnsFakeAddresses(host, addresses))
  records
}

fn dns_test_candidate_text(result: Result<Vector<SocketAddress>, DnsError>, index: i64) -> str {
  match result {
    Ok(candidates) -> match vector_get_option<SocketAddress>(candidates, index) {
      Some(candidate) -> candidate.display()
      None -> "<missing>"
    }
    Err(_) -> "<error>"
  }
}

fn dns_test_candidate_count(result: Result<Vector<SocketAddress>, DnsError>) -> i64 {
  match result {
    Ok(candidates) -> vector_len<SocketAddress>(candidates)
    Err(_) -> 0 - 1
  }
}

fn dns_test_error_kind(result: Result<Vector<SocketAddress>, DnsError>) -> i64 {
  match result {
    Ok(_) -> 0
    Err(DnsNameNotFound) -> 1
    Err(DnsTemporaryFailure) -> 2
    Err(DnsPermanentFailure) -> 3
    Err(DnsFamilyUnavailable) -> 4
    Err(DnsPolicyDenied) -> 6
    Err(DnsResourceExhausted) -> 5
    Err(DnsPlatform(code)) -> 100 + code
  }
}

test "numeric DNS candidates are pure and preserve family port and scope defaults" {
  let v4 = IpV4(ipv4_address(127, 0, 0, 1))
  let v6 = IpV6(ipv6_address(0, 0, 0, 0, 0, 0, 0, 1))
  Test.assert_str_eq(dns_test_candidate_text(dns_numeric_candidates(v4, 0, DnsAnyFamily), 0), "127.0.0.1:0")
  Test.assert_str_eq(dns_test_candidate_text(dns_numeric_candidates(v6, 65535, DnsIpv6Only), 0), "[::1]:65535")
  Test.assert_eq(dns_test_error_kind(dns_numeric_candidates(v4, 443, DnsIpv6Only)), 4)
  Test.assert_eq(dns_test_error_kind(dns_numeric_candidates(v6, 443, DnsIpv4Only)), 4)
}

fn dns_test_order_probe(host: DomainName) -[DnsResolve]> i64 {
  let result = dns_resolve(host, 443, DnsAnyFamily)
  let mut score = 0
  if dns_test_candidate_count(result) == 3 { score = score + 1 } else { 0 }
  if dns_test_candidate_text(dns_resolve(host, 443, DnsAnyFamily), 0) == "[2001:db8::2]:443" { score = score + 1 } else { 0 }
  if dns_test_candidate_text(dns_resolve(host, 443, DnsAnyFamily), 1) == "192.0.2.1:443" { score = score + 1 } else { 0 }
  if dns_test_candidate_text(dns_resolve(host, 443, DnsAnyFamily), 2) == "[2001:db8::1]:443" { score = score + 1 } else { 0 }
  score
}

test "fake DNS preserves deterministic configured candidate order" {
  let host = dns_test_domain("example.test")
  Test.assert_eq(dns_with_fake(dns_test_records(host, dns_test_addresses()), () => dns_test_order_probe(host)), 4)
}

fn dns_test_family_probe(host: DomainName) -[DnsResolve]> i64 {
  let mut score = 0
  let v4 = dns_resolve(host, 80, DnsIpv4Only)
  if dns_test_candidate_count(v4) == 1 and dns_test_candidate_text(v4, 0) == "192.0.2.1:80" {
    score = score + 1
  } else { 0 }
  let v6 = dns_resolve(host, 8080, DnsIpv6Only)
  if dns_test_candidate_count(v6) == 2 and
    dns_test_candidate_text(v6, 0) == "[2001:db8::2]:8080" and
    dns_test_candidate_text(v6, 1) == "[2001:db8::1]:8080" {
    score = score + 1
  } else { 0 }
  score
}

test "fake DNS applies family policy without reordering accepted candidates" {
  let host = dns_test_domain("family.test")
  Test.assert_eq(dns_with_fake(dns_test_records(host, dns_test_addresses()), () => dns_test_family_probe(host)), 2)
}

fn dns_test_empty_and_missing_probe(empty: DomainName, missing: DomainName) -[DnsResolve]> i64 {
  let a = dns_test_error_kind(dns_resolve(empty, 53, DnsAnyFamily))
  let b = dns_test_error_kind(dns_resolve(missing, 53, DnsAnyFamily))
  if a == 1 and b == 1 { 2 } else { 0 }
}

test "fake DNS reports typed not-found for empty and absent records" {
  let empty = dns_test_domain("empty.test")
  let records = dns_test_records(empty, vector_new<IpAddress>())
  Test.assert_eq(dns_with_fake(records, () => dns_test_empty_and_missing_probe(empty, dns_test_domain("missing.test"))), 2)
}

fn dns_test_canonical_probe(relative: DomainName, equivalent: DomainName, absolute: DomainName) -[DnsResolve]> i64 {
  let a = dns_test_candidate_count(dns_resolve(equivalent, 443, DnsAnyFamily))
  let b = dns_test_error_kind(dns_resolve(absolute, 443, DnsAnyFamily))
  if a == 3 and b == 1 and relative.eq(equivalent) { 3 } else { 0 }
}

test "fake DNS keys canonical IDNA and absolute-root identity exactly" {
  let relative = dns_test_domain("BÜCHER.example")
  let equivalent = dns_test_domain("XN--BCHER-KVA.EXAMPLE")
  let absolute = dns_test_domain("xn--bcher-kva.example.")
  let records = dns_test_records(relative, dns_test_addresses())
  Test.assert_eq(dns_with_fake(records, () => dns_test_canonical_probe(relative, equivalent, absolute)), 3)
}

fn dns_test_override_probe(host: DomainName) -[DnsResolve]> i64 {
  dns_test_error_kind(dns_resolve(host, 443, DnsAnyFamily))
}

test "later fake records override earlier records deterministically" {
  let host = dns_test_domain("override.test")
  let records = dns_test_records(host, dns_test_addresses())
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(host, DnsPermanentFailure))
  Test.assert_eq(dns_with_fake(records, () => dns_test_override_probe(host)), 3)
}

fn dns_test_failure_probe() -[DnsResolve]> i64 {
  let mut score = 0
  if dns_test_error_kind(dns_resolve(dns_test_domain("not-found.test"), 1, DnsAnyFamily)) == 1 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("temporary.test"), 1, DnsAnyFamily)) == 2 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("permanent.test"), 1, DnsAnyFamily)) == 3 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("family.test"), 1, DnsAnyFamily)) == 4 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("policy.test"), 1, DnsAnyFamily)) == 6 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("resources.test"), 1, DnsAnyFamily)) == 5 { score = score + 1 } else { 0 }
  if dns_test_error_kind(dns_resolve(dns_test_domain("platform.test"), 1, DnsAnyFamily)) == 177 { score = score + 1 } else { 0 }
  score
}

test "fake DNS transports every stable error alternative and platform detail" {
  let records = vector_new<DnsFakeRecord>()
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("not-found.test"), DnsNameNotFound))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("temporary.test"), DnsTemporaryFailure))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("permanent.test"), DnsPermanentFailure))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("family.test"), DnsFamilyUnavailable))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("policy.test"), DnsPolicyDenied))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("resources.test"), DnsResourceExhausted))
  vector_push<DnsFakeRecord>(records, DnsFakeFailure(dns_test_domain("platform.test"), DnsPlatform(77)))
  Test.assert_eq(dns_with_fake(records, dns_test_failure_probe), 7)
}

fn dns_test_snapshot_probe(
  host: DomainName,
  source_addresses: Vector<IpAddress>,
  source_records: Vector<DnsFakeRecord>
) -[DnsResolve]> i64 {
  vector_push<IpAddress>(source_addresses, IpV4(ipv4_address(203, 0, 113, 9)))
  vector_push<DnsFakeRecord>(source_records, DnsFakeFailure(host, DnsPermanentFailure))
  dns_test_candidate_count(dns_resolve(host, 443, DnsAnyFamily))
}

test "fake DNS snapshots mutable configuration before running the body" {
  let host = dns_test_domain("snapshot.test")
  let addresses = vector_new<IpAddress>()
  vector_push<IpAddress>(addresses, IpV4(ipv4_address(192, 0, 2, 1)))
  let records = dns_test_records(host, addresses)
  Test.assert_eq(dns_with_fake(records, () => dns_test_snapshot_probe(host, addresses, records)), 1)
}

fn dns_test_fresh_result_probe(host: DomainName) -[DnsResolve]> i64 {
  match dns_resolve(host, 443, DnsAnyFamily) {
    Ok(candidates) -> vector_push<SocketAddress>(candidates, SocketV4(ipv4_address(203, 0, 113, 1), 443))
    Err(_) -> 0
  }
  dns_test_candidate_count(dns_resolve(host, 443, DnsAnyFamily))
}

test "each fake DNS success returns a fresh independently mutable vector" {
  let host = dns_test_domain("fresh.test")
  let addresses = vector_new<IpAddress>()
  vector_push<IpAddress>(addresses, IpV4(ipv4_address(192, 0, 2, 1)))
  Test.assert_eq(dns_with_fake(dns_test_records(host, addresses), () => dns_test_fresh_result_probe(host)), 1)
}

fn dns_test_residual_probe(host: DomainName) -[DnsResolve, DnsResidual]> str {
  if dns_test_candidate_count(dns_resolve(host, 443, DnsAnyFamily)) == 3 and DnsResidual.tick() == 41 {
    "resolved"
  } else {
    "failed"
  }
}

test "fake DNS preserves unrelated effects and an arbitrary managed result" {
  let host = dns_test_domain("residual.test")
  let got = handle dns_with_fake(
    dns_test_records(host, dns_test_addresses()),
    () => dns_test_residual_probe(host)
  ) {
    DnsResidual.tick() -> resume(41)
  }
  Test.assert_str_eq(got, "resolved")
}

test "DnsResolve can be replaced by an exact application handler" {
  let host = dns_test_domain("application.test")
  let got = handle dns_resolve(host, 8443, DnsIpv4Only) {
    DnsResolve.resolve(actual_host, port, family) -> {
      if actual_host.eq(host) {
        resume(dns_numeric_candidates(IpV4(ipv4_address(198, 51, 100, 7)), port, family))
      } else {
        resume(Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound))
      }
    }
  }
  Test.assert_str_eq(dns_test_candidate_text(got, 0), "198.51.100.7:8443")
}

fn dns_test_policy_probe(allowed: DomainName, denied: DomainName) -[DnsResolve]> i64 {
  let delegated = dns_test_candidate_count(dns_resolve(allowed, 443, DnsAnyFamily))
  let wrong_port = dns_test_error_kind(dns_resolve(allowed, 80, DnsAnyFamily))
  let wrong_host = dns_test_error_kind(dns_resolve(denied, 443, DnsAnyFamily))
  if delegated == 3 and wrong_port == 6 and wrong_host == 6 { 3 } else { 0 }
}

test "DNS value policy delegates only an exact canonical host and port" {
  let allowed = dns_test_domain("allowed.test")
  let targets = vector_new<DnsPolicyTarget>()
  vector_push<DnsPolicyTarget>(targets, DnsPolicyTarget(allowed, 443))
  let got = dns_with_fake(
    dns_test_records(allowed, dns_test_addresses()),
    () => dns_with_policy(
      DnsPolicyAllowOnly(targets),
      () => dns_test_policy_probe(allowed, dns_test_domain("denied.test"))
    )
  )
  Test.assert_eq(got, 3)
}

fn dns_test_policy_snapshot_probe(
  targets: Vector<DnsPolicyTarget>,
  late: DomainName
) -[DnsResolve, DnsResidual]> str {
  vector_push<DnsPolicyTarget>(targets, DnsPolicyTarget(late, 443))
  let denied = dns_test_error_kind(dns_resolve(late, 443, DnsAnyFamily))
  if denied == 6 and DnsResidual.tick() == 42 { "snapshotted" }
  else { "failed" }
}

fn dns_test_policy_snapshot_run(
  targets: Vector<DnsPolicyTarget>,
  late: DomainName
) -[DnsResolve, DnsResidual]> str {
  dns_with_policy(
    DnsPolicyAllowOnly(targets),
    () => dns_test_policy_snapshot_probe(targets, late)
  )
}

fn dns_test_policy_snapshot_outer(
  targets: Vector<DnsPolicyTarget>,
  late: DomainName
) -[DnsResidual]> str {
  dns_with_fake(
    dns_test_records(late, dns_test_addresses()),
    () => dns_test_policy_snapshot_run(targets, late)
  )
}

test "DNS policy snapshots mutable input and preserves residual effects" {
  let late = dns_test_domain("late.test")
  let targets = vector_new<DnsPolicyTarget>()
  let got = handle dns_test_policy_snapshot_outer(targets, late) {
    DnsResidual.tick() -> resume(42)
  }
  Test.assert_str_eq(got, "snapshotted")
}
