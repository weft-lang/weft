-- E1002: typed mismatch payloads, provenance, and canonical rendering.

use compiler/diagnose.{*}
use compiler/grammar.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_concat}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type.{*}
use stdlib/semantic_type/render
use stdlib/string.{str_eq, str_find, str_find_from}

fn mismatch_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { mismatch_text_field(rest, key, fallback) }
      _ -> mismatch_text_field(rest, key, fallback)
    }
  }
}

fn mismatch_type_field_text(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldType(name, value) -> if str_eq(name, key) == 1 { value.render() } else { mismatch_type_field_text(rest, key, fallback) }
      _ -> mismatch_type_field_text(rest, key, fallback)
    }
  }
}

fn mismatch_location_field_matches(fields: DiagnosticFieldList, key: str, src: i64, start: i64, end: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldLocation(name, DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end)) -> {
        if str_eq(name, key) == 1 and source == src and actual_start == start and actual_end == end { 1 }
        else { mismatch_location_field_matches(rest, key, src, start, end) }
      }
      _ -> mismatch_location_field_matches(rest, key, src, start, end)
    }
  }
}

fn mismatch_related_matches(related: DiagnosticRelatedLocationList, src: i64, start: i64, end: i64) -> i64 {
  match related {
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, DiagnosticSourceRange(DiagnosticSourceBuffer(source), actual_start, actual_end)), rest) -> {
      if str_eq(label, "expected type established here") == 1 and source == src and actual_start == start and actual_end == end { 1 }
      else { mismatch_related_matches(rest, src, start, end) }
    }
    _ -> 0
  }
}

fn mismatch_diagnostic_matches(
  diagnostic: Diagnostic,
  src: i64,
  context: str,
  expected: str,
  found: str,
  reason: str,
  primary_start: i64,
  primary_end: i64,
  origin_start: i64,
  origin_end: i64
) -> i64 {
  let fields = diagnostic_fields(diagnostic)
  let primary_ok = match diagnostic_primary(diagnostic) {
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), start, end) -> if source == src and start == primary_start and end == primary_end { 1 } else { 0 }
    _ -> 0
  }
  let code_ok = str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1002")
  let class_ok = str_eq(diagnostic_class_name(diagnostic_class(diagnostic)), "type")
  let severity_ok = str_eq(diagnostic_severity_name(diagnostic_severity(diagnostic)), "error")
  let context_ok = str_eq(mismatch_text_field(fields, "context", ""), context)
  let expected_ok = str_eq(mismatch_text_field(fields, "expected", ""), expected)
  let found_ok = str_eq(mismatch_text_field(fields, "found", ""), found)
  let expected_type_ok = str_eq(mismatch_type_field_text(fields, "expected_type", ""), expected)
  let found_type_ok = str_eq(mismatch_type_field_text(fields, "found_type", ""), found)
  let expected_relation = if str_eq(reason, "integer_literal_range") == 1 { "literal_out_of_range" } else { "found_not_subtype_of_expected" }
  let relation_ok = str_eq(mismatch_text_field(fields, "relationship", ""), expected_relation)
  let reason_ok = str_eq(mismatch_text_field(fields, "reason", ""), reason)
  let message_ok = str_eq(diagnostic_message(diagnostic), typeck_mismatch_message(reason, context, expected, found))
  let range_ok = if str_eq(reason, "integer_literal_range") == 1 {
    str_eq(mismatch_text_field(fields, "expected_min", ""), "-128") == 1 and str_eq(mismatch_text_field(fields, "expected_max", ""), "127") == 1
  } else { 1 }
  let related_ok = mismatch_related_matches(diagnostic_related(diagnostic), src, origin_start, origin_end)
  let origin_ok = mismatch_location_field_matches(fields, "expected_origin", src, origin_start, origin_end)
  if code_ok == 1 and class_ok == 1 and severity_ok == 1 and message_ok == 1 and context_ok == 1 and expected_ok == 1 and found_ok == 1 and expected_type_ok == 1 and found_type_ok == 1 and relation_ok == 1 and reason_ok == 1 and range_ok == 1 and primary_ok == 1 and related_ok == 1 and origin_ok == 1 { 1 } else { 0 }
}

fn mismatch_check_source(
  source: str,
  context: str,
  expected: str,
  found: str,
  reason: str,
  primary_start: i64,
  primary_end: i64,
  origin_start: i64,
  origin_end: i64
) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = handle grammar.parse(src, __str_len(source), tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let observation = alloc_zeroed(24)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E1002") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        mem_store64_at(observation, 8, mismatch_diagnostic_matches(diagnostic, src, context, expected, found, reason, primary_start, primary_end, origin_start, origin_end))
      } else { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(observation, 0) == 1 and mem_load64_at(observation, 8) == 1 and mem_load64_at(observation, 16) == 0 { 1 } else { 0 }
}

test "semantic_type_renderer_covers_the_stable_vocabulary" {
  let none = SemanticTypeFactListNil
  let one_i64 = SemanticTypeFactListCons(SemanticTypePrimitive("i64"), none)
  let field = SemanticRecordFieldFactListCons(SemanticRecordField("value", 0, SemanticTypePrimitive("str")), SemanticRecordFieldFactListNil)
  let state = SemanticEffectAtomFactListCons(SemanticEffectAtom("State", one_i64), SemanticEffectAtomFactListNil)
  let bottom = SemanticTypeBottom
  let top = SemanticTypeTop
  Test.assert_str_eq(bottom.render(), "never")
  Test.assert_str_eq(top.render(), "any")
  Test.assert_str_eq(SemanticTypePrimitive("i64").render(), "i64")
  Test.assert_str_eq(SemanticTypeNamed("Box", one_i64).render(), "Box<i64>")
  Test.assert_str_eq(SemanticTypeQualifiedNamed("model", "Box", one_i64).render(), "model.Box<i64>")
  Test.assert_str_eq(SemanticTypeQualifiedTrait("model", "Display").render(), "model.Display")
  Test.assert_str_eq(SemanticTypeVariable("T").render(), "T")
  Test.assert_str_eq(SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("str")).render(), "i64 | str")
  Test.assert_str_eq(SemanticTypeIntersection(SemanticTypeNamed("Shape", none), SemanticTypeTrait("Display")).render(), "Shape & Display")
  Test.assert_str_eq(SemanticTypeComplement(SemanticTypePrimitive("nil")).render(), "~nil")
  Test.assert_str_eq(SemanticTypeFunction(one_i64, SemanticTypePrimitive("str"), SemanticEffectsClosed(state)).render(), "(i64) -[State<i64>]> str")
  Test.assert_str_eq(SemanticTypeFunction(none, SemanticTypePrimitive("nil"), SemanticEffectsOpen(SemanticEffectAtomFactListNil, "E")).render(), "() -[E]> nil")
  Test.assert_str_eq(SemanticTypeRecord(field, true, false).render(), runtime_str_concat("{", "value: str, ..}"))
  Test.assert_str_eq(SemanticTypeRecord(field, false, true).render(), "(str,)")
  Test.assert_str_eq(SemanticTypeContinuation(SemanticTypePrimitive("i64"), SemanticTypePrimitive("str")).render(), "continuation<i64, str>")
  Test.assert_str_eq(SemanticTypePointer(SemanticTypePrimitive("i64"), true).render(), "*mut i64")
  Test.assert_str_eq(SemanticTypeWeak(SemanticTypeNamed("Node", none)).render(), "weak Node")
  Test.assert_str_eq(SemanticTypeUnique(SemanticTypeNamed("File", none)).render(), "unique File")
  Test.assert_str_eq(SemanticTypeOwned(SemanticTypeNamed("File", none)).render(), "owned File")
  Test.assert_str_eq(SemanticTypeBorrow(SemanticTypeNamed("File", none), true).render(), "borrow mut File")
  Test.assert_str_eq(SemanticTypeArray(SemanticTypePrimitive("u8"), 32).render(), "[u8; 32]")
  Test.assert_str_eq(SemanticTypeSlice(SemanticTypePrimitive("u8"), false).render(), "[u8]")
  Test.assert_str_eq(SemanticTypeSlice(SemanticTypePrimitive("u8"), true).render(), "[mut u8]")
  Test.assert_str_eq(SemanticTypeAssociated(SemanticTypeVariable("T"), "Item").render(), "T.Item")
  Test.assert_str_eq(SemanticTypeIntersection(SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("str")), SemanticTypeTrait("Display")).render(), "(i64 | str) & Display")
  Test.assert_str_eq(SemanticTypeComplement(SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("str"))).render(), "~(i64 | str)")
  Test.assert_str_eq(SemanticTypePointer(SemanticTypeUnion(SemanticTypePrimitive("i64"), SemanticTypePrimitive("str")), false).render(), "*(i64 | str)")
  Test.assert_str_eq(SemanticTypeRecord(SemanticRecordFieldFactListNil, true, false).render(), runtime_str_concat("{", "..}"))
  Test.assert_str_eq(SemanticTypeOther("future").render(), "future")
  Test.assert_str_eq(SemanticEffectAtom("State", one_i64).render(), "State<i64>")
  Test.assert_str_eq(SemanticQualifiedEffectAtom("state/store", "State", one_i64).render(), "state/store.State<i64>")
  Test.assert_str_eq(SemanticEffectsClosed(SemanticEffectAtomFactListNil).render(), "pure")
  Test.assert_str_eq(SemanticEffectsClosed(state).render(), "State<i64>")
  Test.assert_str_eq(SemanticEffectsOpen(state, "E").render(), "State<i64>, E")
}

test "type_mismatch_argument_points_to_parameter_contract" {
  let source = "fn takes(x: i64) -> i64 { x } fn main() -> i64 { takes(\"snow\") }"
  let primary = str_find(source, "\"snow\"")
  let origin = str_find(source, "x")
  Test.assert_eq(mismatch_check_source(source, "argument", "i64", "str", "incompatible_types", primary, primary + 6, origin, origin + 1), 1)
}

test "type_mismatch_function_value_points_to_callable_binding" {
  let source = "fn main() -> any { let f = (x: i64) => x f(\"snow\") }"
  let primary = str_find(source, "\"snow\"")
  let origin = str_find(source, "f =")
  Test.assert_eq(mismatch_check_source(source, "argument", "i64", "str", "incompatible_types", primary, primary + 6, origin, origin + 1), 1)
}

test "type_mismatch_assignment_points_to_binding_origin" {
  let source = "fn main() -> i64 { let mut count = 1 count = \"snow\" 0 }"
  let primary = str_find(source, "\"snow\"")
  let origin = str_find(source, "count")
  Test.assert_eq(mismatch_check_source(source, "assignment", "i64", "str", "incompatible_types", primary, primary + 6, origin, origin + 5), 1)
}

test "type_mismatch_return_points_to_function_contract" {
  let source = "fn main() -> i64 { \"snow\" }"
  let primary = str_find(source, "\"snow\"")
  let origin = str_find(source, "main")
  Test.assert_eq(mismatch_check_source(source, "return value", "i64", "str", "incompatible_types", primary, primary + 6, origin, origin + 4), 1)
}

test "type_mismatch_annotation_points_to_binding_contract" {
  let source = "fn main() -> i64 { let count: i64 = \"snow\" 0 }"
  let primary = str_find(source, "\"snow\"")
  let origin = str_find(source, "count")
  Test.assert_eq(mismatch_check_source(source, "type annotation", "i64", "str", "incompatible_types", primary, primary + 6, origin, origin + 5), 1)
}

test "type_mismatch_record_field_points_to_declaration" {
  let source = "type Person { name: str, active: bool } fn main() -> i64 { let p = Person { name: 42, active: true } 0 }"
  let primary = str_find(source, "42")
  let origin = str_find(source, "name")
  Test.assert_eq(mismatch_check_source(source, "record field", "str", "i64", "incompatible_types", primary, primary + 2, origin, origin + 4), 1)
}

test "type_mismatch_match_arm_replays_the_first_arm_origin" {
  -- `any` admits the synthesized union so this isolates the arm-local
  -- diagnostic rather than adding a downstream function-return cascade.
  let source = "fn main(n: i64) -> any { match n { 0 -> \"ready\" _ -> false } }"
  let primary = str_find(source, "false")
  let origin = str_find(source, "\"ready\"")
  Test.assert_eq(mismatch_check_source(source, "match arm", "str", "bool", "incompatible_types", primary, primary + 5, origin, origin + 7), 1)
}

test "type_mismatch_nullable_value_teaches_narrowing" {
  let source = "fn maybe(flag: bool) -> i64? { if flag { 7 } else { nil } } fn main() -> i64 { maybe(true) }"
  let primary = str_find_from(source, "maybe", str_find(source, "main"))
  let origin = str_find(source, "main")
  Test.assert_eq(mismatch_check_source(source, "return value", "i64", "i64 | nil", "possibly_nil", primary, primary + 5, origin, origin + 4), 1)
}

test "type_mismatch_nominal_arguments_retain_generic_identity" {
  let source = "type Box<T> { value: T } fn takes(value: Box<i64>) -> i64 { 0 } fn main(box: Box<str>) -> i64 { takes(box) }"
  let primary = str_find_from(source, "box", str_find_from(source, "takes", str_find(source, "main")))
  let origin = str_find_from(source, "value", str_find(source, "takes"))
  Test.assert_eq(mismatch_check_source(source, "argument", "Box<i64>", "Box<str>", "nominal_type_arguments", primary, primary + 3, origin, origin + 5), 1)
}

test "type_mismatch_fixed_array_length_is_a_type_fact" {
  let source = "fn takes(value: [i64; 3]) -> i64 { 0 } fn main(value: [i64; 2]) -> i64 { takes(value) }"
  let primary = str_find_from(source, "value", str_find_from(source, "takes", str_find(source, "main")))
  let origin = str_find(source, "value")
  Test.assert_eq(mismatch_check_source(source, "argument", "[i64; 3]", "[i64; 2]", "array_length", primary, primary + 5, origin, origin + 5), 1)
}

test "type_mismatch_integer_literal_reports_the_value_range" {
  let source = "fn main() -> i64 { let value: i8 = 128 0 }"
  let primary = str_find(source, "128")
  let origin = str_find(source, "value")
  Test.assert_eq(mismatch_check_source(source, "type annotation", "i8", "i64", "integer_literal_range", primary, primary + 3, origin, origin + 5), 1)
}

test "type_mismatch_mutable_slice_teaches_exclusive_view_contract" {
  let source = "fn takes(value: [mut i64]) -> i64 { 0 } fn main(value: [i64]) -> i64 { takes(value) }"
  let primary = str_find_from(source, "value", str_find_from(source, "takes", str_find(source, "main")))
  let origin = str_find(source, "value")
  Test.assert_eq(mismatch_check_source(source, "argument", "[mut i64]", "[i64]", "mutable_slice_contract", primary, primary + 5, origin, origin + 5), 1)
}

test "type_mismatch_structural_shapes_retain_field_names" {
  let source = "fn takes(value: { name: str }) -> i64 { 0 } fn main(value: { age: i64 }) -> i64 { takes(value) }"
  let primary = str_find_from(source, "value", str_find_from(source, "takes", str_find(source, "main")))
  let origin = str_find(source, "value")
  Test.assert_eq(mismatch_check_source(source, "argument", runtime_str_concat("{", "name: str}"), runtime_str_concat("{", "age: i64}"), "structural_shape", primary, primary + 5, origin, origin + 5), 1)
}
