use "runtime/memory.weft"
-- Method call chaining: result of one method call used as receiver of another
-- Expected exit code: 42
type Wrapper { val: i64 }

impl Wrapper {
  fn get(self: i64) -> i64 { mem_load64(self) }
}

impl i64 {
  fn double(self: i64) -> i64 { self + self }
  fn plus(self: i64, n: i64) -> i64 { self + n }
}

fn main() -> i64 {
  let w = Wrapper { val: 20 }
  w.get().double().plus(2)
}
