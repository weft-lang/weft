use stdlib/state as state
use stdlib/state.{State}
use stdlib/string

type Operation { run: (i64) -> i64 }

fn add_ten(value: i64) -> i64 { value + 10 }

fn operation(offset: i64) -> Operation { Operation { run: value => value + offset } }

fn make_adder(offset: i64) -> (i64) -> i64 { value => value + offset }

fn identity<T>(value: T) -> T { value }

fn chosen(value: bool) -> (i64) -> i64 {
  if value { make_adder(10) } else { make_adder(20) }
}

fn note(value: i64) -[State<i64>]> i64 {
  State.put(State.get() * 10 + value)
  value
}

fn acquire_operation() -[State<i64>]> (i64, i64) -> i64 {
  note(1)
  (left, right) => left * 10 + right
}

fn effectful(value: i64) -[State<i64>]> i64 { note(value) }

type EffectOperation { run: (i64) -[State<i64>]> i64 }

test "a parenthesized record field is called" {
  let closure = Operation { run: value => value + 10 }
  let named = Operation { run: add_ten }
  Test.assert_eq((closure.run)(1), 11)
  Test.assert_eq((named.run)(1), 11)
}

test "a projected closure retains its captured environment" {
  let value = operation(41)
  Test.assert_eq((value.run)(1), 42)
  Test.assert_eq((operation(20).run)(22), 42)
}

test "tuple projections and indexed function values can be called" {
  let pair = (7, make_adder(10))
  let choices: [(i64) -> i64; 2] = [make_adder(10), make_adder(20)]
  Test.assert_eq((pair.1)(1), 11)
  Test.assert_eq(choices[0](1), 11)
  Test.assert_eq(choices[1](2), 22)
}

test "returned and selected functions can be called directly" {
  Test.assert_eq(make_adder(40)(2), 42)
  Test.assert_eq(chosen(true)(1), 11)
  Test.assert_eq((if false { make_adder(10) } else { make_adder(20) })(2), 22)
  Test.assert_eq((match 2 { 1 -> make_adder(10) _ -> make_adder(20) })(2), 22)
}

test "parentheses preserve named call inference and nested function calls" {
  Test.assert_eq((add_ten)(1), 11)
  Test.assert_eq((identity)(42), 42)
  Test.assert_str_eq((identity)("weft"), "weft")
  Test.assert_eq(((add_ten))(1), 11)
}

test "immediate typed lambdas and empty argument lists work" {
  Test.assert_eq(((value: i64) => value + 10)(1), 11)
  Test.assert_eq((() => 42)(), 42)
}

test "application evaluates its callee then arguments exactly once" {
  let result = state.run(0, () => acquire_operation()(note(2), note(3)))
  Test.assert_eq(result.0, 23)
  Test.assert_eq(result.1, 123)
}

test "application retains parameterized effects on the selected function" {
  let action = EffectOperation { run: effectful }
  let result = state.run(4, () => (action.run)(2))
  Test.assert_eq(result.0, 2)
  Test.assert_eq(result.1, 42)
}

test "application composes with operators and pipes" {
  Test.assert_eq(2 * make_adder(10)(1) + 1, 23)
  Test.assert_eq(1 |> (operation(10).run)() |> add_ten(), 21)
}

test "application carries floating and aggregate result lanes" {
  let floating = ((value: f64) => value + 0.5, (value: f32) => value + 0.5)
  let tuple_result = ((value: i64) => (value, value + 1), 0)
  Test.assert_true((floating.0)(1.0) == 1.5)
  Test.assert_true((floating.1)(1.0) == 1.5)
  let pair = (tuple_result.0)(41)
  Test.assert_eq(pair.0, 41)
  Test.assert_eq(pair.1, 42)
}

test "application returns managed values with independent ownership" {
  let render = ((value: str) => value.concat("!"), 0)
  let text = (render.0)("weft")
  Test.assert_str_eq(text, "weft!")
}

test "argument mutation cannot replace a previously selected record callee" {
  let mut selected = operation(10)
  let result = (selected.run)({ selected = operation(100); 1 })
  Test.assert_eq(result, 11)
  Test.assert_eq((selected.run)(1), 101)
}

test "argument mutation cannot replace a previously selected indexed callee" {
  let mut selected: [(i64) -> i64; 1] = [make_adder(10)]
  let result = selected[0]({ selected[0] = make_adder(100); 1 })
  Test.assert_eq(result, 11)
  Test.assert_eq(selected[0](1), 101)
}

test "application supplies callback parameter context" {
  let operation = ((render: (str) -> str) => render("weft"), 0)
  Test.assert_str_eq((operation.0)(text => text.concat("!")), "weft!")
  let invoke = operation.0
  Test.assert_str_eq(invoke(text => text.concat("?")), "weft?")
}

fn stop_application(value: i64) -[Fail<i64>]> never { Fail.fail(value) }

test "an application with a never result terminates its control-flow path" {
  let operation = (stop_application, 0)
  let result = handle (operation.0)(if true { 42 } else { 0 }) {
    Fail.fail(value) -> value
    return ignored -> 0
  }
  Test.assert_eq(result, 42)
}
