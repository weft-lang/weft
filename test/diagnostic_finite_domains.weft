use compiler/diagnostic/location.{*}
use compiler/diagnostic/render.{diagnose_report_absolute_span, diagnose_report_absolute_end}
use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/diagnostic as diagnostic
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/option.{None, Some}

fn finite_diagnostic(location: DiagnosticLocation) -> Diagnostic {
  diagnostic.uncoded(DiagnosticSeverityNote, DiagnosticClassTool, "finite location", location)
}

test "diagnostic byte ranges preserve the complete finite domain for every source identity" {
  let sources = [DiagnosticSourceUnknown, DiagnosticSourceNamed("🧶.weft"), DiagnosticSourceBuffer(17)]
  let bounds: [usize; 5] = [0, 1, 9223372036854775807, 9223372036854775808, 18446744073709551615]
  for source in sources {
    for bound in bounds {
      let location = DiagnosticSourceRange(source, bound, bound)
      match finite_diagnostic(location).primary() {
        DiagnosticLocationNone -> Test.assert_true(false)
        DiagnosticSourceRange(actual_source, start, end) -> {
          Test.assert_eq_usize(start, bound)
          Test.assert_eq_usize(end, bound)
          Test.assert_true(match (source, actual_source) {
            (DiagnosticSourceUnknown, DiagnosticSourceUnknown) -> true
            (DiagnosticSourceNamed(expected), DiagnosticSourceNamed(actual)) -> expected == actual
            (DiagnosticSourceBuffer(expected), DiagnosticSourceBuffer(actual)) -> expected == actual
            _ -> false
          })
        }
      }
    }
  }
}

test "an absent diagnostic location is distinct from a zero width range at the origin" {
  let absent = finite_diagnostic(DiagnosticLocationNone)
  let present = finite_diagnostic(DiagnosticSourceRange(DiagnosticSourceUnknown, 0, 0))
  Test.assert_true(match absent.primary() { DiagnosticLocationNone -> true _ -> false })
  Test.assert_true(match present.primary() { DiagnosticSourceRange(source, 0, 0) -> true _ -> false })
}

test "legacy diagnostic producers reject negative and reversed offsets without wrapping" {
  let source = DiagnosticSourceNamed("input.weft")
  let invalid = [(0 - 1, 0), (0, 0 - 1), (4, 3), (0 - 2, 0 - 1)]
  for (start, end) in invalid {
    Test.assert_true(match diagnostic_location_from_offsets(source, start, end) {
      DiagnosticLocationNone -> true
      _ -> false
    })
  }
  match diagnostic_location_from_offsets(source, 0, 9223372036854775807) {
    DiagnosticSourceRange(actual, start, end) -> {
      Test.assert_eq_usize(start, 0)
      Test.assert_eq_usize(end, 9223372036854775807)
    }
    _ -> Test.assert_true(false)
  }
}

test "native diagnostic rendering clamps full width offsets to acquired source bounds" {
  let cases: [(usize, i64); 6] = [(0, 0), (1, 1), (4, 4), (5, 4), (9223372036854775808, 4), (18446744073709551615, 4)]
  for (offset, expected) in cases {
    Test.assert_eq(diagnostic_location_clamp_offset(offset, 4), expected)
    Test.assert_eq(diagnostic_location_clamp_offset(offset, 0), 0)
    Test.assert_eq(diagnostic_location_clamp_offset(offset, 0 - 1), 0)
  }
  Test.assert_eq(diagnostic_location_clamp_offset(18446744073709551615, 9223372036854775807), 9223372036854775807)
}

test "legacy diagnostic transport rejects unsigned and absolute address overflow" {
  let named = DiagnosticSourceNamed("file.weft")
  let finite = finite_diagnostic(DiagnosticSourceRange(named, 9223372036854775807, 9223372036854775808))
  Test.assert_eq(diagnose_report_absolute_span(finite), 9223372036854775807)
  Test.assert_eq(diagnose_report_absolute_end(finite), 0 - 1)
  let buffered = finite_diagnostic(DiagnosticSourceRange(DiagnosticSourceBuffer(20), 5, 9))
  Test.assert_eq(diagnose_report_absolute_span(buffered), 25)
  Test.assert_eq(diagnose_report_absolute_end(buffered), 29)
  Test.assert_eq(diagnostic_location_absolute_offset(DiagnosticSourceBuffer(9223372036854775807), 1), 0 - 1)
  Test.assert_eq(diagnostic_location_absolute_offset(DiagnosticSourceBuffer(0 - 1), 0), 0 - 1)
  Test.assert_eq(diagnostic_location_absolute_offset(named, 18446744073709551615), 0 - 1)
  Test.assert_eq(diagnose_report_absolute_span(finite_diagnostic(DiagnosticLocationNone)), 0 - 1)
  Test.assert_true(match diagnostic_location_signed_offset(18446744073709551615) { None -> true _ -> false })
  Test.assert_true(match diagnostic_location_signed_offset(9223372036854775807) { Some(9223372036854775807) -> true _ -> false })
}

fn diagnostic_list_churn(length: usize) -> bool {
  let mut related = DiagnosticRelatedLocationNil
  let mut edits = DiagnosticTextEditNil
  let mut fields = DiagnosticFieldNil
  let origin: usize = 0
  for index in origin..length {
    let location = DiagnosticSourceRange(DiagnosticSourceNamed("text.weft"), index, index + 1)
    related = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("origin", location), related)
    edits = DiagnosticTextEditCons(DiagnosticTextEdit(location, "🧶"), edits)
    fields = DiagnosticFieldCons(DiagnosticFieldLocation("origin", location), fields)
    fields = DiagnosticFieldCons(DiagnosticFieldSuggestion(DiagnosticSuggestion("replace", DiagnosticSuggestionMachineApplicable, DiagnosticTextEditNil)), fields)
  }
  let snapshot = related
  let extended = DiagnosticRelatedLocationCons(DiagnosticRelatedLocation("extra", DiagnosticLocationNone), related)
  snapshot.len() == length and related.len() == length and extended.len() == length + 1 and
    edits.len() == length and fields.len() == length * 2 and fields.suggestion_count() == length
}

test "diagnostic collection lengths preserve empty deep and shared immutable lists" {
  let related: DiagnosticRelatedLocationList = DiagnosticRelatedLocationNil
  let edits: DiagnosticTextEditList = DiagnosticTextEditNil
  let fields: DiagnosticFieldList = DiagnosticFieldNil
  Test.assert_eq_usize(related.len(), 0)
  Test.assert_eq_usize(edits.len(), 0)
  Test.assert_eq_usize(fields.len(), 0)
  Test.assert_eq_usize(fields.suggestion_count(), 0)
  Test.assert_true(diagnostic_list_churn(0))
  Test.assert_true(diagnostic_list_churn(1))
  Test.assert_true(diagnostic_list_churn(5000))
}

test "diagnostic list traversal and early completion release their managed stakes" {
  for _ in 0..30 { Test.assert_true(diagnostic_list_churn(30)) }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..100 { Test.assert_true(diagnostic_list_churn(30)) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}

test "structured Diagnose transport preserves both full width byte offsets" {
  let location = DiagnosticSourceRange(DiagnosticSourceNamed("🧶.weft"), 9223372036854775808, 18446744073709551615)
  let outcome = handle Diagnose.report(finite_diagnostic(location)) {
    Diagnose.report(value) -> {
      match value.primary() {
        DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) -> {
          Test.assert_str_eq(name, "🧶.weft")
          Test.assert_eq_usize(start, 9223372036854775808)
          Test.assert_eq_usize(end, 18446744073709551615)
        }
        _ -> Test.assert_true(false)
      }
      resume(42)
    }
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  Test.assert_eq(outcome, 42)
}
