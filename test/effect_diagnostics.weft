-- E2001: exact capability identity, discharge reasoning, and provenance.

use compiler/grammar.{*}
use compiler/lib.{*}
use compiler/parse.{parse_module}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/source_acquire.{source_acquire_with_standalone}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_type.{*}
use stdlib/semantic_type_render.{semantic_effect_atom_render, semantic_effect_set_render}
use stdlib/string.{str_eq, str_find, str_find_from}

fn effect_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { effect_text_field(rest, key, fallback) }
      _ -> effect_text_field(rest, key, fallback)
    }
  }
}

fn effect_atom_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldEffectAtom(name, value) -> if str_eq(name, key) == 1 { semantic_effect_atom_render(value) } else { effect_atom_field(rest, key, fallback) }
      _ -> effect_atom_field(rest, key, fallback)
    }
  }
}

fn effect_set_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldEffectSet(name, value) -> if str_eq(name, key) == 1 { semantic_effect_set_render(value) } else { effect_set_field(rest, key, fallback) }
      _ -> effect_set_field(rest, key, fallback)
    }
  }
}

fn effect_suggestion_matches(fields: DiagnosticFieldList) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(DiagnosticSuggestion(message, DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditNil)) -> {
        if str_eq(message, "add the missing effect to the enclosing signature or handle it here") == 1 { 1 }
        else { effect_suggestion_matches(rest) }
      }
      _ -> effect_suggestion_matches(rest)
    }
  }
}

fn effect_related_matches(related: DiagnosticRelatedLocationList, label: str, src: i64, start: i64, end: i64) -> i64 {
  if start < 0 { 1 }
  else { match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(actual_label, DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), actual_start, actual_end)), rest) -> {
      if str_eq(actual_label, label) == 1 and actual_src == src and actual_start == start and actual_end == end { 1 }
      else { effect_related_matches(rest, label, src, start, end) }
    }
    DiagnosticRelatedLocationCons(item, rest) -> effect_related_matches(rest, label, src, start, end)
  } }
}

fn effect_diagnostic_matches(
  diagnostic: Diagnostic,
  src: i64,
  message: str,
  context: str,
  reason: str,
  required: str,
  available: str,
  missing: str,
  missing_atom: str,
  nearby: str,
  primary_start: i64,
  primary_end: i64,
  origin_label: str,
  origin_start: i64,
  origin_end: i64,
  handler_start: i64,
  handler_end: i64
) -> i64 {
  let fields = diagnostic_fields(diagnostic)
  let primary_ok = match diagnostic_primary(diagnostic) {
    DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), start, end) -> if actual_src == src and start == primary_start and end == primary_end { 1 } else { 0 }
    _ -> 0
  }
  let nearby_ok = if __str_len(nearby) == 0 {
    str_eq(effect_atom_field(fields, "nearby_effect", "absent"), "absent")
  } else {
    str_eq(effect_atom_field(fields, "nearby_effect", ""), nearby) == 1 and str_eq(effect_text_field(fields, "nearby_effect_text", ""), nearby) == 1
  }
  let missing_atom_ok = if __str_len(missing_atom) == 0 {
    str_eq(effect_atom_field(fields, "missing_effect", "absent"), "absent")
  } else { str_eq(effect_atom_field(fields, "missing_effect", ""), missing_atom) }
  let handler_ok = effect_related_matches(
    diagnostic_related(diagnostic),
    "nearest handler handles a different instantiation of this effect",
    src,
    handler_start,
    handler_end
  )
  let origin_ok = effect_related_matches(diagnostic_related(diagnostic), origin_label, src, origin_start, origin_end)
  if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E2001") == 1 and
     str_eq(diagnostic_class_name(diagnostic_class(diagnostic)), "effect") == 1 and
     str_eq(diagnostic_severity_name(diagnostic_severity(diagnostic)), "error") == 1 and
     str_eq(diagnostic_message(diagnostic), message) == 1 and
     str_eq(effect_text_field(fields, "context", ""), context) == 1 and
     str_eq(effect_text_field(fields, "reason", ""), reason) == 1 and
     str_eq(effect_set_field(fields, "required_effects", ""), required) == 1 and
     str_eq(effect_set_field(fields, "available_effects", ""), available) == 1 and
     str_eq(effect_set_field(fields, "missing_effects", ""), missing) == 1 and
     str_eq(effect_text_field(fields, "missing_effects_text", ""), missing) == 1 and
     str_eq(effect_text_field(fields, "available_effects_text", ""), available) == 1 and
     missing_atom_ok == 1 and nearby_ok == 1 and effect_suggestion_matches(fields) == 1 and primary_ok == 1 and origin_ok == 1 and handler_ok == 1 { 1 } else { 0 }
}

fn effect_check_source(
  source: str,
  message: str,
  context: str,
  reason: str,
  required: str,
  available: str,
  missing: str,
  missing_atom: str,
  nearby: str,
  primary_start: i64,
  primary_end: i64,
  origin_label: str,
  origin_start: i64,
  origin_end: i64,
  handler_start: i64,
  handler_end: i64
) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = source_acquire_with_standalone(() => handle parse_module(grammar.lex(src, __str_len(source)), src, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  })
  let observation = alloc_zeroed(24)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic_code_text(diagnostic_code(diagnostic)), "E2001") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        mem_store64_at(observation, 8, effect_diagnostic_matches(
          diagnostic, src, message, context, reason, required, available, missing, missing_atom, nearby,
          primary_start, primary_end, origin_label, origin_start, origin_end, handler_start, handler_end
        ))
      } else { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(observation, 0) == 1 and mem_load64_at(observation, 8) == 1 and mem_load64_at(observation, 16) == 0 { 1 } else { 0 }
}

fn effect_source_is_clean(source: str) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = source_acquire_with_standalone(() => handle parse_module(grammar.lex(src, __str_len(source)), src, tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  })
  let errors = alloc_zeroed(8)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.error(message, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(errors, 0) == 0 { 1 } else { 0 }
}

test "effect_unavailable_perform_teaches_pure_contract_and_operation_origin" {
  let source = "effect State { fn get() -> i64 } fn bad() -> i64 { State.get() }"
  let primary = str_find_from(source, "State", str_find(source, "bad"))
  let origin = str_find(source, "get")
  Test.assert_eq(effect_check_source(
    source, "effect `State` is not available in this context", "effect operation", "pure_context",
    "State", "pure", "State", "State", "", primary, primary + 5,
    "operation requires this effect", origin, origin + 3, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_call_preserves_parameterized_identity" {
  let source = "effect Box<T> { fn get() -> T } fn need() -[Box<str>]> i64 { 1 } fn bad() -[Box<i64>]> i64 { need() }"
  let primary = str_find_from(source, "need", str_find(source, "bad"))
  let origin = str_find(source, "need")
  Test.assert_eq(effect_check_source(
    source, "effect `Box<str>` is not available in this context", "call", "different_instantiation",
    "Box<str>", "Box<i64>", "Box<str>", "Box<str>", "Box<i64>", primary, primary + 4,
    "callee declares this effect", origin, origin + 4, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_nearest_handler_explains_parameter_mismatch" {
  let source = "effect Box<T> { fn get() -> T } fn need() -[Box<str>]> str { Box.get() } fn bad() -> i64 { handle need() { Box<i64>.get() -> resume(42) } 0 }"
  let primary = str_find_from(source, "need", str_find(source, "handle"))
  let origin = str_find(source, "need")
  let handler = str_find_from(source, "Box<i64>", str_find(source, "handle"))
  Test.assert_eq(effect_check_source(
    source, "effect `Box<str>` is not available in this context", "call", "different_instantiation",
    "Box<str>", "Box<i64>", "Box<str>", "Box<str>", "Box<i64>", primary, primary + 4,
    "callee declares this effect", origin, origin + 4, handler, handler + 3
  ), 1)
}

test "effect_unavailable_nested_handlers_choose_the_nearest_mismatch" {
  let source = "effect Box<T> { fn get() -> T } fn need() -[Box<str>]> str { Box.get() } fn bad() -> i64 { handle handle need() { Box<i64>.get() -> resume(42) } { Box<bool>.get() -> resume(true) } 0 }"
  let primary = str_find_from(source, "need", str_find(source, "handle"))
  let origin = str_find(source, "need")
  let inner_handler = str_find(source, "Box<i64>")
  Test.assert_eq(effect_check_source(
    source, "effect `Box<str>` is not available in this context", "call", "different_instantiation",
    "Box<str>", "Box<bool>, Box<i64>", "Box<str>", "Box<str>", "Box<i64>", primary, primary + 4,
    "callee declares this effect", origin, origin + 4, inner_handler, inner_handler + 3
  ), 1)
}

test "effect_unavailable_generic_call_reports_the_instantiated_atom" {
  let source = "effect Box<T> { fn get() -> T } fn need<T>() -[Box<T>]> i64 { 1 } fn bad() -> i64 { need<str>() }"
  let primary = str_find_from(source, "need", str_find(source, "bad"))
  let origin = str_find(source, "need")
  Test.assert_eq(effect_check_source(
    source, "effect `Box<str>` is not available in this context", "call", "pure_context",
    "Box<str>", "pure", "Box<str>", "Box<str>", "", primary, primary + 4,
    "callee declares this effect", origin, origin + 4, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_method_preserves_member_span_and_declaration" {
  let source = "effect Noise { fn ping() -> i64 } type Box { value: i64 } impl Box { fn noisy(self: i64) -[Noise]> i64 { Noise.ping() } } fn bad(box: Box) -> i64 { box.noisy() }"
  let primary = str_find_from(source, "noisy", str_find(source, "bad"))
  let origin = str_find(source, "noisy")
  Test.assert_eq(effect_check_source(
    source, "effect `Noise` is not available in this context", "method call", "pure_context",
    "Noise", "pure", "Noise", "Noise", "", primary, primary + 5,
    "method declares this effect", origin, origin + 5, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_distinguishes_same_named_module_declarations" {
  let source = "use module_fixtures/g2_effect_bank as left use module_fixtures/g2_effect_bank_right as right fn bad() -[right.Box<i64>]> i64 { left.Box<i64>.get() }"
  let primary = str_find_from(source, "Box<i64>", str_find(source, "left.Box"))
  Test.assert_eq(effect_check_source(
    source,
    "effect `module_fixtures/g2_effect_bank.Box<i64>` is not available in this context",
    "effect operation", "different_effect_declaration",
    "module_fixtures/g2_effect_bank.Box<i64>",
    "module_fixtures/g2_effect_bank_right.Box<i64>",
    "module_fixtures/g2_effect_bank.Box<i64>",
    "module_fixtures/g2_effect_bank.Box<i64>",
    "module_fixtures/g2_effect_bank_right.Box<i64>",
    primary, primary + 3, "operation requires this effect", 0 - 1, 0 - 1, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_open_tail_names_the_rigid_polymorphic_remainder" {
  let source = "fn apply<E>(cb: () -[E]> i64) -> i64 { cb() }"
  let primary = str_find_from(source, "cb", str_find(source, "{"))
  let origin = str_find(source, "cb")
  Test.assert_eq(effect_check_source(
    source, "effects `E` are not available in this context", "call", "pure_context",
    "E", "pure", "E", "", "", primary, primary + 2,
    "callee declares this effect", origin, origin + 2, 0 - 1, 0 - 1
  ), 1)
}

test "effect_unavailable_multiple_capabilities_are_one_coherent_diagnostic" {
  let source = "effect Read { fn get() -> i64 } effect Write { fn put(v: i64) -> nil } fn both() -[Read, Write]> i64 { 1 } fn bad() -> i64 { both() }"
  let primary = str_find_from(source, "both", str_find(source, "bad"))
  let origin = str_find(source, "both")
  Test.assert_eq(effect_check_source(
    source, "effects `Read, Write` are not available in this context", "call", "pure_context",
    "Read, Write", "pure", "Read, Write", "Read", "", primary, primary + 4,
    "callee declares this effect", origin, origin + 4, 0 - 1, 0 - 1
  ), 1)
}

test "effect_availability_accepts_exact_signature_and_exact_handler" {
  Test.assert_eq(effect_source_is_clean("effect Box<T> { fn get() -> T } fn ok() -[Box<str>]> str { Box.get() }"), 1)
  Test.assert_eq(effect_source_is_clean("effect Box<T> { fn get() -> T } fn need() -[Box<str>]> str { Box.get() } fn ok() -> str { handle need() { Box<str>.get() -> resume(\"ok\") } }"), 1)
}
