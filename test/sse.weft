use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/sse as sse
use stdlib/sse.{*}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}

fn sse_test_text(bytes: Bytes) -> str {
  match bytes.to_utf8() {
    Ok(text) -> text
    Err(error) -> "<invalid>"
  }
}

fn sse_test_retry_or(reconnect: SseReconnect, default: i64) -> i64 {
  match reconnect.retry_millis() {
    Some(value) -> value
    None -> default
  }
}

fn sse_test_usize(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

test "SSE limit construction distinguishes invalid bounds" {
  match sse.limits(0, 8) {
    Err(SseInvalidLineLimit(value)) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
  match sse.limits(8, 0) {
    Err(SseInvalidEventLimit(value)) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
  match sse.limits(8, 16) {
    Ok(limits) -> match sse.decoder(limits).decode(SseInputBytes(bytes.from_str(""))) {
      SseNeedInput(next, consumed) -> Test.assert_eq(sse_test_usize(consumed), 0)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE folds multiline data and preserves typed event metadata" {
  let decoder = sse.decoder(sse.default_limits())
  let source = bytes.from_str("event: notice\nid: 42\ndata: first\ndata:second\n\n")
  match decoder.decode(SseInputBytes(source)) {
    SseEventReady(next, event, consumed) -> {
      Test.assert_eq(sse_test_usize(consumed), source.len())
      Test.assert_str_eq(event.event_type(), "notice")
      Test.assert_str_eq(event.data(), "first\nsecond")
      Test.assert_str_eq(event.last_event_id(), "42")
      Test.assert_str_eq(next.reconnect().last_event_id(), "42")
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE accepts LF CRLF and CR across fragment boundaries" {
  let decoder = sse.decoder(sse.default_limits())
  let after_data = match decoder.decode(SseInputBytes(bytes.from_str("data:one\r"))) {
    SseNeedInput(next, consumed) -> {
      Test.assert_eq(sse_test_usize(consumed), 9)
      next
    }
    _ -> decoder
  }
  let after_event = match after_data.decode(SseInputBytes(bytes.from_str("\n\r"))) {
    SseEventReady(next, event, consumed) -> {
      Test.assert_eq(sse_test_usize(consumed), 2)
      Test.assert_str_eq(event.data(), "one")
      next
    }
    _ -> after_data
  }
  match after_event.decode(SseInputBytes(bytes.from_str("\ndata:two\n\n"))) {
    SseEventReady(next, event, consumed) -> {
      Test.assert_eq(sse_test_usize(consumed), 11)
      Test.assert_str_eq(event.data(), "two")
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE tolerates a fragmented BOM and fragmented Unicode scalars" {
  let source = bytes.from_str("﻿data: Melbourne λ 🧶\n\n")
  let mut decoder = sse.decoder(sse.default_limits())
  let mut observed = ""
  let mut events = 0
  let mut index = 0
  while index < source.len() {
    let fragment = source.slice(__i64_to_usize(index), __i64_to_usize(index + 1)).unwrap()
    match decoder.decode(SseInputBytes(fragment)) {
      SseNeedInput(next, consumed) -> {
        Test.assert_eq(sse_test_usize(consumed), 1)
        decoder = next
        0
      }
      SseEventReady(next, event, consumed) -> {
        Test.assert_eq(sse_test_usize(consumed), 1)
        observed = event.data()
        events = events + 1
        decoder = next
        0
      }
      _ -> Test.assert_true(false)
    }
    index = index + 1
  }
  Test.assert_eq(events, 1)
  Test.assert_str_eq(observed, "Melbourne λ 🧶")
}

test "SSE comments unknown fields and empty blocks never become events" {
  let source = bytes.from_str(": keepalive\nunknown:value\nevent:lost\n\n")
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(source)) {
    SseNeedInput(next, consumed) -> {
      Test.assert_eq(sse_test_usize(consumed), source.len())
      Test.assert_str_eq(next.reconnect().last_event_id(), "")
      match next.decode(SseInputBytes(bytes.from_str("data:visible\n\n"))) {
        SseEventReady(after, event, rest) -> {
          Test.assert_str_eq(event.event_type(), "message")
          Test.assert_str_eq(event.data(), "visible")
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE reconnect controls persist reset and ignore invalid values" {
  let first = bytes.from_str("retry:1500\nid:alpha\ndata:x\n\n")
  let decoder = sse.decoder(sse.default_limits())
  let after_first = match decoder.decode(SseInputBytes(first)) {
    SseEventReady(next, event, consumed) -> {
      Test.assert_str_eq(event.last_event_id(), "alpha")
      Test.assert_eq(sse_test_retry_or(next.reconnect(), 0 - 1), 1500)
      next
    }
    _ -> decoder
  }
  let second = bytes.from_str("retry:12x\nid:\ndata:y\n\n")
  match after_first.decode(SseInputBytes(second)) {
    SseEventReady(next, event, consumed) -> {
      Test.assert_str_eq(event.last_event_id(), "")
      let reconnect = next.reconnect()
      Test.assert_str_eq(reconnect.last_event_id(), "")
      Test.assert_eq(sse_test_retry_or(reconnect, 0 - 1), 1500)
      let overflow = bytes.from_str("retry:9223372036854775808\n\n")
      match next.decode(SseInputBytes(overflow)) {
        SseNeedInput(after, rest) ->
          Test.assert_eq(sse_test_retry_or(after.reconnect(), 0 - 1), 1500)
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE ignores NUL event IDs without disturbing the prior ID" {
  let first = bytes.from_str("id:good\ndata:first\n\n")
  let decoder = sse.decoder(sse.default_limits())
  let next = match decoder.decode(SseInputBytes(first)) {
    SseEventReady(after, event, consumed) -> after
    _ -> decoder
  }
  let raw = vector.with_capacity<u8>(22)
  let prefix = bytes.from_str("id:bad").to_vector()
  for index in 0..vector_len<u8>(prefix) {
    vector_push<u8>(raw, vector_get_in_bounds<u8>(prefix, index))
  }
  vector_push<u8>(raw, __i64_to_u8(0))
  let suffix = bytes.from_str("id\ndata:second\n\n").to_vector()
  for index in 0..vector_len<u8>(suffix) {
    vector_push<u8>(raw, vector_get_in_bounds<u8>(suffix, index))
  }
  match next.decode(SseInputBytes(bytes.from_slice(raw[..]))) {
    SseEventReady(after, event, consumed) -> {
      Test.assert_str_eq(event.last_event_id(), "good")
      Test.assert_str_eq(after.reconnect().last_event_id(), "good")
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE emits at most one event and leaves the suffix with the caller" {
  let source = bytes.from_str("data:one\n\ndata:two\n\n")
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(source)) {
    SseEventReady(next, first, consumed) -> {
      Test.assert_str_eq(first.data(), "one")
      Test.assert_true(consumed < __i64_to_usize(source.len()))
      let suffix = source.slice(consumed, __i64_to_usize(source.len())).unwrap()
      match next.decode(SseInputBytes(suffix)) {
        SseEventReady(after, second, rest_consumed) -> {
          Test.assert_str_eq(second.data(), "two")
          Test.assert_eq(sse_test_usize(rest_consumed), suffix.len())
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE EOF discards an event without its final blank line" {
  let decoder = sse.decoder(sse.default_limits())
  let next = match decoder.decode(SseInputBytes(bytes.from_str("id:7\nretry:25\ndata:lost\n"))) {
    SseNeedInput(after, consumed) -> after
    _ -> decoder
  }
  match next.decode(SseInputEnd) {
    SseEnd(reconnect) -> {
      Test.assert_str_eq(reconnect.last_event_id(), "7")
      Test.assert_eq(sse_test_retry_or(reconnect, 0 - 1), 25)
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE enforces line event and strict UTF8 bounds at exact offsets" {
  match sse.decoder(sse.limits(3, 20).unwrap()).decode(SseInputBytes(bytes.from_str("abcd"))) {
    SseDecodeFailed(SseLineTooLong(offset), consumed) -> {
      Test.assert_eq(offset, 3)
      Test.assert_eq(sse_test_usize(consumed), 3)
    }
    _ -> Test.assert_true(false)
  }
  match sse.decoder(sse.limits(20, 3).unwrap()).decode(SseInputBytes(bytes.from_str("data:abcd\n"))) {
    SseDecodeFailed(SseEventTooLarge(offset), consumed) -> Test.assert_eq(offset, 5)
    _ -> Test.assert_true(false)
  }
  match sse.decoder(sse.limits(20, 3).unwrap()).decode(SseInputBytes(bytes.from_str("data:abc\n\n"))) {
    SseEventReady(next, event, consumed) -> Test.assert_str_eq(event.data(), "abc")
    _ -> Test.assert_true(false)
  }
  let invalid: [u8; 8] = [
    __i64_to_u8(58), __i64_to_u8(32), __i64_to_u8(255), __i64_to_u8(10),
    __i64_to_u8(100), __i64_to_u8(97), __i64_to_u8(10), __i64_to_u8(10)
  ]
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(bytes.from_slice(invalid[..]))) {
    SseDecodeFailed(SseInvalidUtf8(offset), consumed) -> Test.assert_eq(offset, 2)
    _ -> Test.assert_true(false)
  }
  let invalid_after_bom: [u8; 5] = [
    __i64_to_u8(239), __i64_to_u8(187), __i64_to_u8(191), __i64_to_u8(255), __i64_to_u8(10)
  ]
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(bytes.from_slice(invalid_after_bom[..]))) {
    SseDecodeFailed(SseInvalidUtf8(offset), consumed) -> Test.assert_eq(offset, 3)
    _ -> Test.assert_true(false)
  }
}

test "SSE canonical encoding roundtrips events comments and retry" {
  let event = sse.event("notice", "one\ntwo", "42").unwrap()
  let wire = event.encode()
  Test.assert_str_eq(sse_test_text(wire), "event:notice\nid:42\ndata:one\ndata:two\n\n")
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(wire)) {
    SseEventReady(next, decoded, consumed) -> {
      Test.assert_str_eq(decoded.event_type(), "notice")
      Test.assert_str_eq(decoded.data(), "one\ntwo")
      Test.assert_str_eq(decoded.last_event_id(), "42")
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_str_eq(sse_test_text(sse.encode_comment("keepalive").unwrap()), ":keepalive\n")
  Test.assert_str_eq(sse_test_text(sse.encode_retry(250).unwrap()), "retry:250\n")
  let empty = sse.event("", "", "").unwrap().encode()
  Test.assert_str_eq(sse_test_text(empty), "id:\ndata:\n\n")
  match sse.decoder(sse.default_limits()).decode(SseInputBytes(empty)) {
    SseEventReady(next, decoded, consumed) -> {
      Test.assert_str_eq(decoded.event_type(), "message")
      Test.assert_str_eq(decoded.data(), "")
    }
    _ -> Test.assert_true(false)
  }
}

test "SSE encoding validates each wire-sensitive value" {
  match sse.event("bad\nname", "ok", "") {
    Err(SseInvalidEventType) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match sse.event("message", "ok", "bad\nid") {
    Err(SseInvalidEventId) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match sse.event("message", "bad\rdata", "") {
    Err(SseInvalidEventData) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match sse.encode_comment("bad\ncomment") {
    Err(SseInvalidComment) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match sse.encode_retry(0 - 1) {
    Err(SseInvalidRetry(value)) -> Test.assert_eq(value, 0 - 1)
    _ -> Test.assert_true(false)
  }
}

test "Bytes slicing is exact and rejects every invalid bound shape" {
  let values = bytes.from_str("abcdef")
  Test.assert_str_eq(sse_test_text(values.slice(__i64_to_usize(1), __i64_to_usize(4)).unwrap()), "bcd")
  match values.slice(__i64_to_usize(4), __i64_to_usize(3)) {
    None -> Test.assert_true(true)
    Some(other) -> Test.assert_true(false)
  }
  match values.slice(__i64_to_usize(0), __i64_to_usize(7)) {
    None -> Test.assert_true(true)
    Some(other) -> Test.assert_true(false)
  }
}
