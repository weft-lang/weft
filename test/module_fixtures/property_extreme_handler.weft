use stdlib/test/property.{Draw}

pub type Selection {
  Lowest,
  Middle,
  Capped(usize),
  Highest
}

fn capped(requested: usize, bound: ChoiceBound) -> usize {
  let one: usize = 1
  let upper = bound.exclusive_upper()
  if requested < upper { requested } else { upper - one }
}

pub implements Draw(selection: Selection) {
  Draw.choose(bound) -> match selection {
    Lowest -> {
      let selected: usize = 0
      resume(selected)
    }
    Middle -> resume(bound.exclusive_upper() / 2)
    Capped(requested) -> resume(capped(requested, bound))
    Highest -> resume(bound.exclusive_upper() - 1)
  }
}
