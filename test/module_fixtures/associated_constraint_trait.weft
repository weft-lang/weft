pub trait AssociatedConstraintSource {
  type Item
  fn append(self, item: Self.Item) -> Self
}

pub trait AssociatedReturnSource {
  type Item
  fn item(self) -> Self.Item
}

pub fn inferred_item<S: AssociatedReturnSource>(source: S) -> S.Item {
  source.item()
}

pub fn map_inferred_item<S: AssociatedReturnSource, U>(source: S, transform: (S.Item) -> U) -> U {
  transform(source.item())
}
