use runtime/rc_implicit_test.{*}

pub effect ModuleDeferred {
  @deferred fn step(value: i64) -> i64
  @deferred fn inspect_drop() -> i64
}

pub implements ModuleDeferred(probe: RuntimeRcProbe) {
  ModuleDeferred.step(value) with k -> k(value + runtime_rc_probe_load(probe))
  ModuleDeferred.inspect_drop() with k -> runtime_rc_probe_count(probe)
}

pub fn module_handler_expected_text() -> str { "caller provenance" }
