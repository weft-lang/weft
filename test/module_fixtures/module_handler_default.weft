use test/module_fixtures/module_handler_basic as basic_handler

default handler basic_handler()

pub fn module_handler_default_value() -> i64 {
  basic_handler.ModuleCounter.get()
}

pub fn module_handler_default_explicit_override() -> i64 {
  handle basic_handler.ModuleCounter.get() {
    basic_handler.ModuleCounter.get() -> resume(8)
  }
}
