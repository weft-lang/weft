--- A value whose public behavior is supplied by its facade.
pub type FirstValue {
  --- Construct a first value.
  FirstValue(i64)
}

--- Another value with a same-spelled facade method.
pub type SecondValue {
  --- Construct a second value.
  SecondValue(i64)
}

--- Construct a first value.
pub fn first(value: i64) -> FirstValue {
  FirstValue(value)
}

--- Construct a second value.
pub fn second(value: i64) -> SecondValue {
  SecondValue(value)
}
