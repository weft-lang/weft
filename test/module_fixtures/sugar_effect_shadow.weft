use stdlib/maybe as absence
use stdlib/fail as failure
use stdlib/result.{Result}

pub effect Maybe { fn none() -> i64 }
pub effect Fail { fn fail(error: i64) -> i64 }
pub type Box { value: i64 }

pub fn optional_value(value: Box?) -[absence.Maybe]> i64 { value?.value }
pub fn result_value(value: Result<i64, str>) -[failure.Fail<str>]> i64 { value? }
