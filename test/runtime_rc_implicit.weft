use "runtime/rc_implicit_test.weft"

fn runtime_rc_implicit_param_count(p: rc i64) -> i64 {
  rc_count(p)
}

test "runtime_rc_implicit_prelude_for_managed_values" {
  let p: rc i64 = rc_default_alloc(8, 8)
  Test.assert_eq(if p != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(rc_count(p), 1)
  Test.assert_eq(runtime_rc_implicit_param_count(p), 2)
  Test.assert_eq(rc_count(p), 1)
}

test "runtime_rc_implicit_release_reuses_zeroed_block" {
  Test.assert_eq(runtime_rc_implicit_reuse_matches(), 1)
  Test.assert_eq(runtime_rc_implicit_reuse_zeroed_value(), 0)
}
