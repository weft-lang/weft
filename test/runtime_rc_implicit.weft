use "runtime/rc_implicit_test.weft"

fn runtime_rc_implicit_param_count(p: RuntimeRcProbe) -> i64 {
  runtime_rc_probe_count(p)
}

test "runtime_rc_implicit_prelude_for_managed_values" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(0)
  Test.assert_eq(runtime_rc_probe_is_nonnull(p), 1)
  Test.assert_eq(runtime_rc_probe_count(p), 1)
  Test.assert_eq(runtime_rc_implicit_param_count(p), 1)
  Test.assert_eq(runtime_rc_probe_count(p), 1)
}

test "runtime_rc_implicit_release_reuses_zeroed_block" {
  Test.assert_eq(runtime_rc_implicit_reuse_matches(), 1)
  Test.assert_eq(runtime_rc_implicit_reuse_zeroed_value(), 0)
}
