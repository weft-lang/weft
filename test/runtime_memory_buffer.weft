use "runtime/memory.weft"
use "runtime/alloc.weft"
use "runtime/buffer.weft"

test "runtime_mem_copy_copies_bytes" {
  let arena = arena_new(64)
  let src = arena_alloc(arena, 4, 1)
  let dst = arena_alloc(arena, 4, 1)
  mem_store8(src, 10)
  mem_store8(src + 1, 20)
  mem_store8(src + 2, 30)
  mem_store8(src + 3, 40)
  mem_copy(dst, src, 4)
  Test.assert_eq(mem_load8(dst), 10)
  Test.assert_eq(mem_load8(dst + 1), 20)
  Test.assert_eq(mem_load8(dst + 2), 30)
  Test.assert_eq(mem_load8(dst + 3), 40)
  arena_free(arena)
}

test "runtime_memory_zero_length_operations_preserve_bytes" {
  let arena = arena_new(64)
  let src = arena_alloc(arena, 2, 1)
  let dst = arena_alloc(arena, 2, 1)
  mem_store8(src, 1)
  mem_store8(dst, 99)
  mem_store8(dst + 1, 100)
  mem_copy(dst, src, 0)
  mem_fill8(dst, 0, 7)
  mem_zero(dst, 0)
  Test.assert_eq(mem_load8(dst), 99)
  Test.assert_eq(mem_load8(dst + 1), 100)
  arena_free(arena)
}

test "runtime_buffer_writes_little_endian_numbers" {
  let b = buf_new(1)
  bu8(b, 170)
  bu32(b, 16909060)
  bu64(b, 4294967301)
  let p = buf_ptr(b)
  Test.assert_eq(buf_len(b), 13)
  Test.assert_eq(mem_load8(p), 170)
  Test.assert_eq(mem_load8(p + 1), 4)
  Test.assert_eq(mem_load8(p + 2), 3)
  Test.assert_eq(mem_load8(p + 3), 2)
  Test.assert_eq(mem_load8(p + 4), 1)
  Test.assert_eq(mem_load8(p + 5), 5)
  Test.assert_eq(mem_load8(p + 9), 1)
  Test.assert_eq(mem_load8(p + 12), 0)
}

test "runtime_buffer_copy_fill_and_pad" {
  let b = buf_new(2)
  bstr(b, "ab")
  bscopy(b, __str_ptr("cdef"), 4, 1)
  bfill(b, 2)
  bpad(b, 10)
  let p = buf_ptr(b)
  Test.assert_eq(buf_len(b), 10)
  Test.assert_eq(mem_load8(p), 97)
  Test.assert_eq(mem_load8(p + 1), 98)
  Test.assert_eq(mem_load8(p + 2), 100)
  Test.assert_eq(mem_load8(p + 3), 101)
  Test.assert_eq(mem_load8(p + 4), 102)
  Test.assert_eq(mem_load8(p + 5), 0)
  Test.assert_eq(mem_load8(p + 9), 0)
}

test "runtime_buffer_large_copy_is_iterative" {
  let n = 2100000
  let mid = 1048576
  let arena = arena_new(n + 64)
  let src = arena_alloc(arena, n, 1)
  mem_store8(src, 17)
  mem_store8(src + mid, 23)
  mem_store8(src + n - 1, 99)
  let b = buf_new(1)
  bscopy(b, src, n, 0)
  let p = buf_ptr(b)
  Test.assert_eq(buf_len(b), n)
  Test.assert_eq(mem_load8(p), 17)
  Test.assert_eq(mem_load8(p + mid), 23)
  Test.assert_eq(mem_load8(p + n - 1), 99)
  arena_free(arena)
}

test "runtime_buffer_large_fill_is_iterative" {
  let n = 2100000
  let mid = 1048576
  let b = buf_new(1)
  bfill(b, n)
  let p = buf_ptr(b)
  Test.assert_eq(buf_len(b), n)
  Test.assert_eq(mem_load8(p), 0)
  Test.assert_eq(mem_load8(p + mid), 0)
  Test.assert_eq(mem_load8(p + n - 1), 0)
}

test "runtime_zero_capacity_buffer_grows_on_first_write" {
  let b = buf_new(0)
  Test.assert_eq(buf_len(b), 0)
  Test.assert_eq(buf_cap(b), 0)
  bu8(b, 42)
  Test.assert_eq(buf_len(b), 1)
  Test.assert_eq(if buf_cap(b) >= 1 { 1 } else { 0 }, 1)
  Test.assert_eq(mem_load8(buf_ptr(b)), 42)
}
