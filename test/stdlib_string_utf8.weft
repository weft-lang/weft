use "runtime/memory.weft"
use "runtime/string.weft"
use "stdlib/string.weft"
use "stdlib/utf8.weft"
use "stdlib/vector.weft"

fn test_str_from_bytes4(a: i64, b: i64, c: i64, d: i64, len: i64) -> str {
  let data = runtime_str_alloc_data(len, 8)
  if len > 0 { mem_store8_at(data, 0, a) } else { 0 }
  if len > 1 { mem_store8_at(data, 1, b) } else { 0 }
  if len > 2 { mem_store8_at(data, 2, c) } else { 0 }
  if len > 3 { mem_store8_at(data, 3, d) } else { 0 }
  str_from_bytes_copy(data, len)
}

fn utf8_count_property(i: i64) -> bool {
  let scalar = 65 + i
  let s = utf8_string_from_scalar(scalar)
  utf8_validate(s) == 1 and utf8_codepoint_count(s) == 1
}

test "utf8_validate_decode_and_encode_happy_paths" {
  let omega = utf8_decode_next("Ω", 0)
  let euro = utf8_decode_next("€", 0)
  let grin = utf8_string_from_scalar(128512)
  Test.assert_eq(utf8_validate("ascii"), 1)
  Test.assert_eq(utf8_decode_is_ok(omega), 1)
  Test.assert_eq(utf8_decode_scalar(omega), 937)
  Test.assert_eq(utf8_decode_next_pos(omega), 2)
  Test.assert_eq(utf8_decode_scalar(euro), 8364)
  Test.assert_eq(str_len(grin), 4)
  Test.assert_eq(utf8_codepoint_count(str_concat("A", str_concat("Ω", "€"))), 3)
}

test "utf8_rejects_malformed_sequences" {
  let continuation = test_str_from_bytes4(128, 0, 0, 0, 1)
  let overlong = test_str_from_bytes4(192, 175, 0, 0, 2)
  let surrogate = test_str_from_bytes4(237, 160, 128, 0, 3)
  let too_high = test_str_from_bytes4(244, 144, 128, 128, 4)
  let truncated = test_str_from_bytes4(226, 130, 0, 0, 2)
  Test.assert_eq(utf8_validate(continuation), 0)
  Test.assert_eq(utf8_validate(overlong), 0)
  Test.assert_eq(utf8_validate(surrogate), 0)
  Test.assert_eq(utf8_validate(too_high), 0)
  Test.assert_eq(utf8_codepoint_count(truncated), 0 - 1)
  Test.assert_eq(utf8_decode_is_ok(utf8_decode_next(continuation, 0)), 0)
}

test "utf8_scalar_boundaries" {
  let s = str_concat("A", str_concat("Ω", "€"))
  Test.assert_eq(str_is_utf8_boundary(s, 0), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 1), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 2), 0)
  Test.assert_eq(str_is_utf8_boundary(s, 3), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 4), 0)
  Test.assert_eq(str_is_utf8_boundary(s, 6), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 7), 0)
}

test "string_trim_find_contains_and_slices" {
  Test.assert_str_eq(str_trim(" \tweft\n"), "weft")
  Test.assert_eq(str_find("compiler-as-data", "as"), 9)
  Test.assert_eq(str_find_from("banana", "na", 3), 4)
  Test.assert_eq(str_contains("compiler-as-data", "data"), 1)
  Test.assert_eq(str_contains("compiler-as-data", "runtime"), 0)
  Test.assert_str_eq(str_slice_bytes("weft", 2, 9), "ft")
  Test.assert_str_eq(str_slice_bytes("weft", 0 - 1, 2), "")
}

test "string_split_and_join_variants" {
  let parts = str_split("alpha,beta,,delta,", ",")
  Test.assert_eq(vector_len(parts), 5)
  Test.assert_str_eq(vector_get<str>(parts, 0, ""), "alpha")
  Test.assert_str_eq(vector_get<str>(parts, 2, "fallback"), "")
  Test.assert_str_eq(vector_get<str>(parts, 4, "fallback"), "")
  Test.assert_str_eq(str_join(parts, "|"), "alpha|beta||delta|")

  let empty_sep = str_split("abc", "")
  let empty_input = str_split("", ",")
  Test.assert_eq(vector_len(empty_sep), 1)
  Test.assert_str_eq(vector_get<str>(empty_sep, 0, ""), "abc")
  Test.assert_eq(vector_len(empty_input), 1)
  Test.assert_str_eq(vector_get<str>(empty_input, 0, "fallback"), "")
  Test.assert_str_eq(str_join(vector_new<str>(), ","), "")
}

test "property_utf8_ascii_scalars_encode_as_one_codepoint" {
  Test.forall_i64_range(0, 26, utf8_count_property)
}
