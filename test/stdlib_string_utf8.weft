use "runtime/memory.weft"
use "runtime/rc_implicit_test.weft"
use runtime/string.{*}
use stdlib/string.{*}
use stdlib/utf8.{*}
use stdlib/vector.{*}

fn test_str_from_bytes4(a: i64, b: i64, c: i64, d: i64, len: i64) -> str {
  let value = runtime_str_alloc_uninit(len)
  let data = runtime_str_ptr(value)
  if len > 0 { mem_store8_at(data, 0, a) } else { 0 }
  if len > 1 { mem_store8_at(data, 1, b) } else { 0 }
  if len > 2 { mem_store8_at(data, 2, c) } else { 0 }
  if len > 3 { mem_store8_at(data, 3, d) } else { 0 }
  value
}

fn utf8_count_property(i: i64) -> bool {
  let scalar = 65 + i
  let s = utf8_string_from_scalar(scalar)
  utf8_validate(s) == 1 and utf8_codepoint_count(s) == 1
}

fn string_breadth_round() -> i64 {
  let replaced = str_replace("ababa", "ba", "XY")
  let upper = str_to_upper("Weft-é")
  let repeated = str_repeat("Ω", 3)
  let left = str_pad_start("7", 5, "ab")
  let right = str_pad_end("7", 6, "xy")
  str_len(replaced) + str_len(upper) + str_len(repeated) + str_len(left) + str_len(right)
}

fn string_breadth_kind_round(kind: i64) -> i64 {
  match kind {
    0 -> str_len(str_replace("ababa", "ba", "XY"))
    1 -> str_len(str_to_upper("Weft-é"))
    2 -> str_len(str_repeat("Ω", 3))
    3 -> str_len(str_pad_start("7", 5, "ab"))
    _ -> str_len(str_pad_end("7", 6, "xy"))
  }
}

fn string_breadth_kind_delta(kind: i64) -> i64 {
  let mut warm = 0
  while warm < 50 {
    string_breadth_kind_round(kind)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  for i in 0..20 { string_breadth_kind_round(kind) }
  runtime_rc_test_heap_arena_offset() - before
}

test "utf8_validate_decode_and_encode_happy_paths" {
  let omega = utf8_decode_next("Ω", 0)
  let euro = utf8_decode_next("€", 0)
  let grin = utf8_string_from_scalar(128512)
  Test.assert_eq(utf8_validate("ascii"), 1)
  Test.assert_eq(utf8_decode_is_ok(omega), 1)
  Test.assert_eq(utf8_decode_scalar(omega), 937)
  Test.assert_eq(utf8_decode_next_pos(omega), 2)
  Test.assert_eq(utf8_decode_scalar(euro), 8364)
  Test.assert_eq(str_len(grin), 4)
  Test.assert_eq(utf8_codepoint_count(str_concat("A", str_concat("Ω", "€"))), 3)
}

test "utf8_rejects_malformed_sequences" {
  let continuation = test_str_from_bytes4(128, 0, 0, 0, 1)
  let overlong = test_str_from_bytes4(192, 175, 0, 0, 2)
  let surrogate = test_str_from_bytes4(237, 160, 128, 0, 3)
  let too_high = test_str_from_bytes4(244, 144, 128, 128, 4)
  let truncated = test_str_from_bytes4(226, 130, 0, 0, 2)
  Test.assert_eq(utf8_validate(continuation), 0)
  Test.assert_eq(utf8_validate(overlong), 0)
  Test.assert_eq(utf8_validate(surrogate), 0)
  Test.assert_eq(utf8_validate(too_high), 0)
  Test.assert_eq(utf8_codepoint_count(truncated), 0 - 1)
  Test.assert_eq(utf8_decode_is_ok(utf8_decode_next(continuation, 0)), 0)
}

test "utf8_scalar_boundaries" {
  let s = str_concat("A", str_concat("Ω", "€"))
  Test.assert_eq(str_is_utf8_boundary(s, 0), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 1), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 2), 0)
  Test.assert_eq(str_is_utf8_boundary(s, 3), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 4), 0)
  Test.assert_eq(str_is_utf8_boundary(s, 6), 1)
  Test.assert_eq(str_is_utf8_boundary(s, 7), 0)
}

test "string_trim_find_contains_and_slices" {
  Test.assert_str_eq(str_trim(" \tweft\n"), "weft")
  Test.assert_eq(str_find("compiler-as-data", "as"), 9)
  Test.assert_eq(str_find_from("banana", "na", 3), 4)
  Test.assert_eq(str_contains("compiler-as-data", "data"), 1)
  Test.assert_eq(str_contains("compiler-as-data", "runtime"), 0)
  Test.assert_str_eq(str_slice_bytes("weft", 2, 9), "ft")
  Test.assert_str_eq(str_slice_bytes("weft", 0 - 1, 2), "")
}

test "string_prefix_and_suffix_cover_empty_unicode_and_misses" {
  Test.assert_eq(str_starts_with("compiler-as-data", "compiler"), 1)
  Test.assert_eq(str_starts_with("compiler-as-data", "compilex"), 0)
  Test.assert_eq(str_starts_with("Ωmega", "Ω"), 1)
  Test.assert_eq(str_starts_with("weft", ""), 1)
  Test.assert_eq(str_starts_with("", ""), 1)
  Test.assert_eq(str_ends_with("compiler-as-data", "data"), 1)
  Test.assert_eq(str_ends_with("compiler-as-data", "date"), 0)
  Test.assert_eq(str_ends_with("megaΩ", "Ω"), 1)
  Test.assert_eq(str_ends_with("weft", ""), 1)
  Test.assert_eq(str_ends_with("x", "longer"), 0)
}

test "string_replace_is_global_non_overlapping_and_byte_preserving" {
  Test.assert_str_eq(str_replace("banana", "na", "X"), "baXX")
  Test.assert_str_eq(str_replace("aaaa", "aa", "b"), "bb")
  Test.assert_str_eq(str_replace("abc", "b", ""), "ac")
  Test.assert_str_eq(str_replace("Ω-Ω", "Ω", "λ"), "λ-λ")
  Test.assert_str_eq(str_replace("abc", "z", "x"), "abc")
  Test.assert_str_eq(str_replace("abc", "", "x"), "abc")
  Test.assert_str_eq(str_replace("", "a", "b"), "")
}

test "string_ascii_case_conversion_preserves_non_ascii_bytes" {
  Test.assert_str_eq(str_to_upper("Weft 42! éΩ"), "WEFT 42! éΩ")
  Test.assert_str_eq(str_to_lower("WeFT 42! ÉΩ"), "weft 42! ÉΩ")
  Test.assert_str_eq(str_to_upper(""), "")
  Test.assert_str_eq(str_to_lower("already"), "already")
}

test "string_repeat_and_padding_cover_boundaries_and_truncation" {
  Test.assert_str_eq(str_repeat("ab", 3), "ababab")
  Test.assert_str_eq(str_repeat("Ω", 2), "ΩΩ")
  Test.assert_str_eq(str_repeat("ab", 0), "")
  Test.assert_str_eq(str_repeat("ab", 0 - 2), "")
  Test.assert_str_eq(str_repeat("", 4), "")
  Test.assert_str_eq(str_pad_start("7", 5, "ab"), "abab7")
  Test.assert_str_eq(str_pad_end("7", 6, "xy"), "7xyxyx")
  Test.assert_str_eq(str_pad_start("wide", 2, "0"), "wide")
  Test.assert_str_eq(str_pad_end("wide", 4, "0"), "wide")
  Test.assert_str_eq(str_pad_start("x", 3, ""), "x")
  Test.assert_str_eq(str_pad_end("x", 0 - 1, "0"), "x")
}

test "string_breadth_reclaims_dynamic_builders" {
  Test.assert_eq(string_breadth_kind_delta(0), 0)
  Test.assert_eq(string_breadth_kind_delta(1), 0)
  Test.assert_eq(string_breadth_kind_delta(2), 0)
  Test.assert_eq(string_breadth_kind_delta(3), 0)
  Test.assert_eq(string_breadth_kind_delta(4), 0)
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq(string_breadth_round(), 29)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut checksum = 0
  for i in 0..20 { checksum = checksum + string_breadth_round() }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(checksum, 580)
  Test.assert_eq(after - before, 0)
}

test "string_split_and_join_variants" {
  let parts = str_split("alpha,beta,,delta,", ",")
  Test.assert_eq(vector_len<str>(parts), 5)
  Test.assert_str_eq(vector_get<str>(parts, 0, ""), "alpha")
  Test.assert_str_eq(vector_get<str>(parts, 2, "fallback"), "")
  Test.assert_str_eq(vector_get<str>(parts, 4, "fallback"), "")
  Test.assert_str_eq(str_join(parts, "|"), "alpha|beta||delta|")

  let empty_sep = str_split("abc", "")
  let empty_input = str_split("", ",")
  Test.assert_eq(vector_len<str>(empty_sep), 1)
  Test.assert_str_eq(vector_get<str>(empty_sep, 0, ""), "abc")
  Test.assert_eq(vector_len<str>(empty_input), 1)
  Test.assert_str_eq(vector_get<str>(empty_input, 0, "fallback"), "")
  Test.assert_str_eq(str_join(vector_new<str>(), ","), "")
}

test "property_utf8_ascii_scalars_encode_as_one_codepoint" {
  Test.forall_i64_range(0, 26, utf8_count_property)
}
