use runtime/memory.{*}
use runtime/rc_implicit_test.{*}
use runtime/string.{*}
use stdlib/generator as generator
use stdlib/iter as iter
use stdlib/list.{Cons, Nil}
use stdlib/option.{*}
use stdlib/result.{Err, Ok}
use stdlib/string as string
use stdlib/string.{*}
use stdlib/utf8 as utf8
use stdlib/utf8.{InvalidScalar, Utf8Decoded, Utf8Malformed}
use stdlib/vector as vector
use stdlib/vector.{*}

fn test_str_from_bytes4(a: i64, b: i64, c: i64, d: i64, len: i64) -> str {
  let value = runtime_str_alloc_uninit(len)
  let data = runtime_str_ptr(value)
  if len > 0 { mem_store8_at(data, 0, a) } else { 0 }
  if len > 1 { mem_store8_at(data, 1, b) } else { 0 }
  if len > 2 { mem_store8_at(data, 2, c) } else { 0 }
  if len > 3 { mem_store8_at(data, 3, d) } else { 0 }
  value
}

fn utf8_count_property(i: i64) -> bool {
  let scalar = 65 + i
  match utf8.from_scalar(scalar) {
    Some(s) -> utf8.validate(s) and s.scalar_count() == 1
    None -> false
  }
}

fn utf8_invalid_source_releases_remainder(value: RuntimeRcProbe) -> i64 {
  let producer = () => {
    generator.yield<i64>(65)
    generator.yield<i64>(55296)
    generator.yield<i64>(runtime_rc_probe_load(value))
    0
  }
  let source = iter.from_generator(generator.start<i64, i64>(producer))
  match utf8.from_scalars(source) {
    Err(InvalidScalar(index, scalar)) -> {
      if index == 1 and scalar == 55296 { 1 } else { 0 }
    }
    Ok(_) -> 0
  }
}

fn string_breadth_round() -> usize {
  let replaced = "ababa".replace("ba", "XY")
  let upper = "Weft-é".to_ascii_upper()
  let repeated = "Ω".repeat(3)
  let left = "7".pad_start(5, "ab")
  let right = "7".pad_end(6, "xy")
  replaced.len() + upper.len() + repeated.len() + left.len() + right.len()
}

fn string_breadth_kind_round(kind: i64) -> usize {
  match kind {
    0 -> "ababa".replace("ba", "XY").len()
    1 -> "Weft-é".to_ascii_upper().len()
    2 -> "Ω".repeat(3).len()
    3 -> "7".pad_start(5, "ab").len()
    _ -> "7".pad_end(6, "xy").len()
  }
}

fn string_breadth_kind_delta(kind: i64) -> i64 {
  let mut warm = 0
  while warm < 50 {
    string_breadth_kind_round(kind)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  for i in 0..20 { string_breadth_kind_round(kind) }
  runtime_rc_test_heap_arena_offset() - before
}

fn string_join_round(parts: borrow Vector<str>) -> usize {
  string.join(parts, "|").len()
}

fn string_join_reclaim_delta() -> i64 {
  let mut parts = vector.with_capacity<str>(4)
  parts.push("alpha")
  parts.push("βeta")
  parts.push("")
  parts.push("delta")
  for iteration in 0..50 { string_join_round(parts) }
  let before = runtime_rc_test_heap_arena_offset()
  for iteration in 0..200 { string_join_round(parts) }
  runtime_rc_test_heap_arena_offset() - before
}

test "utf8_validate_decode_and_encode_happy_paths" {
  let omega = utf8.decode_next("Ω", 0)
  let euro = utf8.decode_next("€", 0)
  let grin = utf8.from_scalar(128512).unwrap_or("")
  Test.assert_true(utf8.validate("ascii"))
  Test.assert_true(utf8.is_scalar(1114111))
  Test.assert_eq_usize(utf8.encoded_len(65).unwrap_or(0), 1)
  Test.assert_eq_usize(utf8.encoded_len(937).unwrap_or(0), 2)
  Test.assert_eq_usize(utf8.encoded_len(8364).unwrap_or(0), 3)
  Test.assert_eq_usize(utf8.encoded_len(128512).unwrap_or(0), 4)
  match omega {
    Utf8Decoded(next, scalar) -> {
      Test.assert_eq_usize(next, 2)
      Test.assert_eq(scalar, 937)
    }
    Utf8Malformed(offset) -> Test.assert_true(false)
  }
  match euro {
    Utf8Decoded(next, scalar) -> Test.assert_eq(scalar, 8364)
    Utf8Malformed(offset) -> Test.assert_true(false)
  }
  Test.assert_eq_usize(grin.len(), 4)
  Test.assert_eq_usize("A".concat("Ω").concat("€").scalar_count(), 3)
}

test "utf8_rejects_malformed_sequences" {
  let continuation = test_str_from_bytes4(128, 0, 0, 0, 1)
  let overlong = test_str_from_bytes4(192, 175, 0, 0, 2)
  let surrogate = test_str_from_bytes4(237, 160, 128, 0, 3)
  let too_high = test_str_from_bytes4(244, 144, 128, 128, 4)
  let truncated = test_str_from_bytes4(226, 130, 0, 0, 2)
  Test.assert_false(utf8.validate(continuation))
  Test.assert_false(utf8.validate(overlong))
  Test.assert_false(utf8.validate(surrogate))
  Test.assert_false(utf8.validate(too_high))
  Test.assert_false(utf8.is_scalar(0 - 1))
  Test.assert_false(utf8.is_scalar(55296))
  Test.assert_false(utf8.is_scalar(1114112))
  Test.assert_true(utf8.encoded_len(55296).is_none())
  Test.assert_true(utf8.from_scalar(1114112).is_none())
  match utf8.decode_next(continuation, 0) {
    Utf8Decoded(next, scalar) -> Test.assert_true(false)
    Utf8Malformed(offset) -> Test.assert_eq_usize(offset, 0)
  }
}

test "utf8_encodes_finite_scalar_traversals_in_one pass" {
  let scalars = Cons<i64>(65,
    Cons<i64>(937,
      Cons<i64>(8364,
        Cons<i64>(128512, Nil<i64>()))))
  match utf8.from_scalars(scalars) {
    Ok(value) -> {
      Test.assert_str_eq(value, "AΩ€😀")
      Test.assert_eq_usize(value.scalar_count(), 4)
    }
    Err(_) -> Test.assert_true(false)
  }
  match utf8.from_scalars(Nil<i64>()) {
    Ok(value) -> Test.assert_str_eq(value, "")
    Err(_) -> Test.assert_true(false)
  }
}

test "utf8_scalar_traversal_accepts_owned_vector_sources" {
  let mut scalars = vector.new<i64>()
  scalars.push(87)
  scalars.push(101)
  scalars.push(102)
  scalars.push(116)
  match utf8.from_scalars(scalars) {
    Ok(value) -> Test.assert_str_eq(value, "Weft")
    Err(_) -> Test.assert_true(false)
  }
}

test "utf8_scalar_traversal_reports_the_first_invalid_ordinal" {
  let negative = Cons<i64>(65, Cons<i64>(0 - 1, Nil<i64>()))
  match utf8.from_scalars(negative) {
    Err(InvalidScalar(index, value)) -> {
      Test.assert_eq_usize(index, 1)
      Test.assert_eq(value, 0 - 1)
    }
    Ok(_) -> Test.assert_true(false)
  }

  let surrogate = Cons<i64>(55296, Nil<i64>())
  match utf8.from_scalars(surrogate) {
    Err(InvalidScalar(index, value)) -> {
      Test.assert_eq_usize(index, 0)
      Test.assert_eq(value, 55296)
    }
    Ok(_) -> Test.assert_true(false)
  }

  let too_high = Cons<i64>(1114112, Nil<i64>())
  match utf8.from_scalars(too_high) {
    Err(InvalidScalar(index, value)) -> {
      Test.assert_eq_usize(index, 0)
      Test.assert_eq(value, 1114112)
    }
    Ok(_) -> Test.assert_true(false)
  }
}

test "utf8_scalar_traversal_closes_the_source_after_early_failure" {
  let retained_by_remainder = runtime_rc_probe_new(41)
  Test.assert_eq(utf8_invalid_source_releases_remainder(retained_by_remainder), 1)
  Test.assert_eq(runtime_rc_probe_count(retained_by_remainder), 1)
}

test "utf8_scalar_boundaries" {
  let s = "A".concat("Ω").concat("€")
  let maximum: usize = 18446744073709551615
  Test.assert_true(s.is_scalar_boundary(0))
  Test.assert_true(s.is_scalar_boundary(1))
  Test.assert_false(s.is_scalar_boundary(2))
  Test.assert_true(s.is_scalar_boundary(3))
  Test.assert_false(s.is_scalar_boundary(4))
  Test.assert_true(s.is_scalar_boundary(6))
  Test.assert_false(s.is_scalar_boundary(7))
  Test.assert_false(s.is_scalar_boundary(maximum))
}

test "string_trim_find_contains_and_slices" {
  Test.assert_str_eq(" \tweft\n".trim(), "weft")
  Test.assert_eq_usize("compiler-as-data".find("as").unwrap_or(0), 9)
  Test.assert_eq_usize("banana".find_from("na", 3).unwrap_or(0), 4)
  Test.assert_true("compiler-as-data".find("runtime").is_none())
  Test.assert_eq_usize("abc".find("").unwrap_or(1), 0)
  let maximum: usize = 18446744073709551615
  Test.assert_true("abc".find_from("a", maximum).is_none())
  Test.assert_true("".is_empty())
  Test.assert_false("weft".is_empty())
  Test.assert_true("compiler-as-data".contains("data"))
  Test.assert_false("compiler-as-data".contains("runtime"))
  Test.assert_str_eq(str_slice_bytes("weft", 2, 9), "ft")
  Test.assert_str_eq(str_slice_bytes("weft", 0 - 1, 2), "")
}

test "string_prefix_and_suffix_cover_empty_unicode_and_misses" {
  Test.assert_true("compiler-as-data".starts_with("compiler"))
  Test.assert_false("compiler-as-data".starts_with("compilex"))
  Test.assert_true("Ωmega".starts_with("Ω"))
  Test.assert_true("weft".starts_with(""))
  Test.assert_true("".starts_with(""))
  Test.assert_true("compiler-as-data".ends_with("data"))
  Test.assert_false("compiler-as-data".ends_with("date"))
  Test.assert_true("megaΩ".ends_with("Ω"))
  Test.assert_true("weft".ends_with(""))
  Test.assert_false("x".ends_with("longer"))
}

test "string_replace_is_global_non_overlapping_and_byte_preserving" {
  Test.assert_str_eq("banana".replace("na", "X"), "baXX")
  Test.assert_str_eq("aaaa".replace("aa", "b"), "bb")
  Test.assert_str_eq("abc".replace("b", ""), "ac")
  Test.assert_str_eq("Ω-Ω".replace("Ω", "λ"), "λ-λ")
  Test.assert_str_eq("abc".replace("z", "x"), "abc")
  Test.assert_str_eq("abc".replace("", "x"), "abc")
  Test.assert_str_eq("".replace("a", "b"), "")
}

test "string_ascii_case_conversion_preserves_non_ascii_bytes" {
  Test.assert_str_eq("Weft 42! éΩ".to_ascii_upper(), "WEFT 42! éΩ")
  Test.assert_str_eq("WeFT 42! ÉΩ".to_ascii_lower(), "weft 42! ÉΩ")
  Test.assert_str_eq("".to_ascii_upper(), "")
  Test.assert_str_eq("already".to_ascii_lower(), "already")
}

test "string_repeat_and_padding_cover_boundaries_and_truncation" {
  let maximum: usize = 18446744073709551615
  Test.assert_str_eq("ab".repeat(3), "ababab")
  Test.assert_str_eq("Ω".repeat(2), "ΩΩ")
  Test.assert_str_eq("ab".repeat(0), "")
  Test.assert_str_eq("ab".repeat(1), "ab")
  Test.assert_str_eq("".repeat(4), "")
  Test.assert_str_eq("".repeat(maximum), "")
  Test.assert_str_eq("7".pad_start(5, "ab"), "abab7")
  Test.assert_str_eq("7".pad_end(6, "xy"), "7xyxyx")
  Test.assert_str_eq("wide".pad_start(2, "0"), "wide")
  Test.assert_str_eq("wide".pad_end(4, "0"), "wide")
  Test.assert_str_eq("x".pad_start(3, ""), "x")
  Test.assert_str_eq("x".pad_end(maximum, ""), "x")
}

test "string_breadth_reclaims_dynamic_builders" {
  Test.assert_eq(string_breadth_kind_delta(0), 0)
  Test.assert_eq(string_breadth_kind_delta(1), 0)
  Test.assert_eq(string_breadth_kind_delta(2), 0)
  Test.assert_eq(string_breadth_kind_delta(3), 0)
  Test.assert_eq(string_breadth_kind_delta(4), 0)
  let mut warm = 0
  while warm < 50 {
    Test.assert_eq_usize(string_breadth_round(), 29)
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut checksum: usize = 0
  for i in 0..20 { checksum = checksum + string_breadth_round() }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq_usize(checksum, 580)
  Test.assert_eq(after - before, 0)
}

test "string_split_and_join_variants" {
  let parts = "alpha,beta,,delta,".split(",")
  Test.assert_true(parts.len() == 5)
  Test.assert_str_eq(parts.get(0).unwrap_or(""), "alpha")
  Test.assert_str_eq(parts.get(2).unwrap_or("fallback"), "")
  Test.assert_str_eq(parts.get(4).unwrap_or("fallback"), "")
  Test.assert_str_eq(string.join(parts, "|"), "alpha|beta||delta|")
  Test.assert_eq_usize(parts.len(), 5)

  let empty_sep = "abc".split("")
  let empty_input = "".split(",")
  Test.assert_true(empty_sep.len() == 1)
  Test.assert_str_eq(empty_sep.get(0).unwrap_or(""), "abc")
  Test.assert_true(empty_input.len() == 1)
  Test.assert_str_eq(empty_input.get(0).unwrap_or("fallback"), "")
  let empty_parts = vector.new<str>()
  Test.assert_str_eq(string.join(empty_parts, ","), "")
}

test "string join preserves many Unicode parts in order" {
  let mut parts = vector.with_capacity<str>(1000)
  for i in 0..1000 { parts.push("Ω") }
  let joined = string.join(parts, "|")
  Test.assert_eq_usize(joined.len(), 2999)
  Test.assert_true(joined.starts_with("Ω|Ω|Ω"))
  Test.assert_true(joined.ends_with("Ω|Ω|Ω"))
  Test.assert_eq(string_join_reclaim_delta(), 0)
}

test "property_utf8_ascii_scalars_encode_as_one_codepoint" {
  Test.forall_i64_range(0, 26, utf8_count_property)
}

test "UTF-8 decoding preserves full-width invalid offsets without truncation" {
  let offsets: [usize; 5] = [1, 2, 3, 9223372036854775808, 18446744073709551615]
  for offset in offsets {
    match utf8.decode_next("é", offset) {
      Utf8Decoded(_, _) -> Test.assert_true(false)
      Utf8Malformed(failed) -> Test.assert_eq_usize(failed, offset)
    }
  }
  match utf8.decode_next("", 0) {
    Utf8Decoded(_, _) -> Test.assert_true(false)
    Utf8Malformed(failed) -> Test.assert_eq_usize(failed, 0)
  }
}

test "UTF-8 decoding composes finite offsets across mixed-width text" {
  let text = "AΩ€😀"
  let mut offset: usize = 0
  for scalar in [65, 937, 8364, 128512] {
    match utf8.decode_next(text, offset) {
      Utf8Decoded(next, decoded) -> {
        Test.assert_eq(decoded, scalar)
        Test.assert_eq_usize(next - offset, utf8.encoded_len(scalar).expect("valid scalar"))
        offset = next
      }
      Utf8Malformed(_) -> { Test.assert_true(false); nil }
    }
  }
  Test.assert_eq_usize(offset, text.len())
}

test "UTF-8 scalar widths reject non-scalars and preserve all width boundaries" {
  let cases: [(i64, usize); 10] = [
    (0, 1), (127, 1), (128, 2), (2047, 2), (2048, 3),
    (55295, 3), (57344, 3), (65535, 3), (65536, 4), (1114111, 4)
  ]
  for (scalar, width) in cases {
    Test.assert_eq_usize(utf8.encoded_len(scalar).expect("valid scalar"), width)
  }
  for scalar in [-1, 55296, 57343, 1114112, 9223372036854775807] {
    Test.assert_true(utf8.encoded_len(scalar).is_none())
  }
}

fn utf8_decode_churn() -> i64 {
  match utf8.decode_next("😀", 0) {
    Utf8Decoded(_, scalar) -> scalar
    Utf8Malformed(_) -> 0
  }
}

test "UTF-8 decoding reclaims each typed result" {
  for index in 0..50 { utf8_decode_churn() }
  let before = runtime_rc_test_heap_arena_offset()
  let mut total = 0
  for index in 0..1000 { total = total + utf8_decode_churn() }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(total, 128512000)
  Test.assert_eq(after - before, 0)
}
