effect Compare<T> { fn same(left: T, right: T) -> bool }
fn local_compare<T>(left: T, right: T) -[Compare<T>]> bool { Compare<T>.same(left, right) }
fn run_compare<R, E>(body: () -[Compare<str>, E]> R) -[E]> R {
  handle body() { Compare<str>.same(left, right) -> resume(left == right) }
}
fn main() -> i64 {
  run_compare(() => {
    let compare_numbers: (i64, i64) -[Compare<i64>]> bool = local_compare
    Compare<str>.same("a", "a")
    if compare_numbers(1, 1) { 0 } else { 1 }
  })
}
