-- Without a declared bound on the associated type, nothing proves that the
-- projection is a Level.

trait Level {
  type Child
  fn child(self) -> Self.Child
  fn size(self) -> i64
}

fn size_of<U: Level>(node: U) -> i64 { node.size() }

fn child_size<T: Level>(node: T) -> i64 { size_of<T.Child>(node.child()) }

fn main() -> i64 { 0 }
