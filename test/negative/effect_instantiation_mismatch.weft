-- parameterized effects (law L2): distinct instantiations are distinct atoms — a callee
-- requiring Box<str> cannot be charged to a caller declaring Box<i64>.
effect Box<T> {
  fn get() -> T
}

fn callee() -[Box<str>]> i64 {
  1
}

fn caller() -[Box<i64>]> i64 {
  callee()
}

fn main() -> i64 {
  0
}
