use module_fixtures/g2_trait_left as left
use module_fixtures/g2_trait_right as right

type QualifiedBoundMismatchBox { value: i64 }
impl left.Gauge for QualifiedBoundMismatchBox {
  fn left(self) -> i64 { self.value }
}

fn needs_right<T: right.Gauge>(value: T) -> i64 { value.right() }
fn main() -> i64 { needs_right<QualifiedBoundMismatchBox>(QualifiedBoundMismatchBox { value: 1 }) }
