use stdlib/http.{HttpLimits}
use stdlib/http/endpoint.{HttpClient, HttpServerRequest, http_server_request}
use stdlib/http/stream.{HttpConnection}
use stdlib/http/transport.{HttpTransportRelease}
use stdlib/tls/stream.{TlsStream}

fn request_with_client_authority(
  connection: owned HttpConnection<TlsStream>,
  limits: HttpLimits
) -[HttpClient<TlsStream>, HttpTransportRelease<TlsStream>]> HttpServerRequest {
  http_server_request(connection, limits)
}
