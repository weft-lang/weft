use stdlib/http.{HttpLimits}
use stdlib/http_endpoint.{HttpClient, HttpServerRequest, http_server_request}
use stdlib/http_stream.{HttpConnection}
use stdlib/tcp.{TcpStreamIO}

fn request_with_client_authority(
  connection: owned HttpConnection,
  limits: HttpLimits
) -[HttpClient, TcpStreamIO]> HttpServerRequest {
  http_server_request(connection, limits)
}
