-- Reading a stream's platform descriptor is an unsafe operation. Strict code
-- may not discharge Unsafe itself to reach one.

use runtime/unsafe.{Unsafe}
use stdlib/option.{None, Option, Some}
use stdlib/tcp.{TcpStream, scripted_stream, tcp_stream_descriptor}

fn descriptor(stream: borrow TcpStream) -> Option<i64> {
  handle tcp_stream_descriptor(stream) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn main() -> i64 { 0 }
