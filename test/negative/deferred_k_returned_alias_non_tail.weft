effect DeferredArg {
  @deferred fn step(value: i64) -> i64
}

fn go(value: i64) -[DeferredArg]> i64 {
  if value == 0 {
    0
  } else {
    DeferredArg.step(value) + go(value - 1)
  }
}

fn hold(k: Continuation<i64, i64>) -> Continuation<i64, i64> {
  k
}

fn main() -> i64 {
  handle go(1) {
    DeferredArg.step(value) with k -> {
      let saved = hold(k)
      saved(value) + 1
    }
  }
}
