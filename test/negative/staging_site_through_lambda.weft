use stdlib/grammar/sql.{SqlGrammar}
use stdlib/grammar/staging.{Staged, embed}

-- An indirect use cannot smuggle a computed source into a site: the literal
-- must be at the call itself, so a wrapper that forwards its parameter is
-- rejected where the primitive is applied.
fn main() -> i64 {
  let stage = (text: str) => embed<SqlGrammar>(text)
  let staged = stage(r#"select 1"#)
  0
}
