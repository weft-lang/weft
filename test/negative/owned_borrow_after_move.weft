use stdlib/drop.{*}

type OwnedBorrowAfterMoveToken {
  value: i64
}

impl Drop for OwnedBorrowAfterMoveToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

fn consume(token: owned OwnedBorrowAfterMoveToken) -> i64 {
  1
}

fn inspect(token: borrow OwnedBorrowAfterMoveToken) -> i64 {
  2
}

fn bad() -> i64 {
  let token: owned OwnedBorrowAfterMoveToken = OwnedBorrowAfterMoveToken { value: 1 }
  consume(token) + inspect(token)
}
