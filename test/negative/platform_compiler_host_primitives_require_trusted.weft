-- must-fail: compiler-host process and file ABI stays sealed to trusted code

fn main() -> i64 {
  let pid = __platform_proc_id()
  let child = __platform_proc_fork()
  __platform_proc_set_group(pid)
  __platform_proc_dup_to(0, 1)
  __platform_proc_exec(0, 0, 0)
  __platform_proc_wait_usage(child, 0, 0, 0)
  __platform_file_chmod(0, 448)
  pid + child
}
