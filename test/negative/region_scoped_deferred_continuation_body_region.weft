use runtime/alloc.{*}

effect RegionDeferredBody {
  @deferred fn get() -> i64
}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    handle {
      let p = Alloc.alloc(8, 8)
      __mem_store64(p, 41)
      RegionDeferredBody.get()
    } {
      RegionDeferredBody.get() with k -> k(1)
    }
  })
}
