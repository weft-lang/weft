use stdlib/drop.{*}

type BorrowExpectedToken = opaque i64
type BorrowActualToken = opaque i64

impl Drop for BorrowExpectedToken {
  fn drop(self) -> nil { nil }
}

impl Drop for BorrowActualToken {
  fn drop(self) -> nil { nil }
}

fn inspect(token: borrow BorrowExpectedToken) -> i64 { 0 }

fn bad() -> i64 {
  let token: owned BorrowActualToken = BorrowActualToken(1)
  inspect(token)
}
