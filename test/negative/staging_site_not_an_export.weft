use stdlib/diagnostic/schema.{Diagnose}
use stdlib/grammar.{Grammar, ParseResult, Parsed}
use stdlib/grammar/staging.{embed}
use stdlib/source.{Span}

-- A type that implements Grammar but is exported by no manifest cannot
-- stage: staging drives the export's tool driver, which only a manifest
-- export has.
type LocalGrammar { LocalGrammar }

impl Grammar for LocalGrammar {
  type Syntax = usize
  fn parse(self, source: Span) -[Diagnose]> ParseResult<usize> { Parsed(source.len()) }
}

fn main() -> i64 {
  let staged = embed<LocalGrammar>(r#"anything"#)
  0
}
