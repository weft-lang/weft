use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

-- A closure's body belongs to the generic function that creates it.
fn grow<T>(n: i64, value: T) -> i64 {
  let deeper = (count: i64) => {
    let mut wrapped = vector.new<T>()
    wrapped.push(value)
    grow<Vector<T>>(count, wrapped)
  }
  if n == 0 { 0 } else { 1 + deeper(n - 1) }
}

fn main() -> i64 { grow<i64>(3, 1) }
