use stdlib/http.{HttpLimits, HttpRequestHead}
use stdlib/http/endpoint.{HttpClientBegin, HttpServer, http_client_reuse}
use stdlib/http/stream.{HttpConnection}
use stdlib/http/transport.{HttpTransportRelease}
use stdlib/tls/stream.{TlsStream}
use stdlib/url.{Url}

fn reuse_with_server_authority(
  url: Url,
  connection: owned HttpConnection<TlsStream>,
  request: HttpRequestHead,
  limits: HttpLimits
) -[HttpServer, HttpTransportRelease<TlsStream>]> HttpClientBegin<TlsStream> {
  http_client_reuse<TlsStream>(url, connection, request, limits)
}
