use stdlib/num as num
use stdlib/num.{NumParseError}
use stdlib/result.{Result}

fn main() -> i64 {
  let integer: Result<(i64, i64), NumParseError> = num.parse_i64_prefix("42", 0)
  let double: Result<(f64, i64), NumParseError> = num.parse_f64_prefix("1.5", 0)
  let single: Result<(f32, i64), NumParseError> = num.parse_f32_prefix(".5", 0)
  0
}
