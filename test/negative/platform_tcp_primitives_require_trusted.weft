-- must-fail: target socket ABI remains sealed to trusted runtime/platform code

fn main() -> i64 {
  let ipv4 = __platform_tcp_af_inet()
  let ipv6 = __platform_tcp_af_inet6()
  let prefix = __platform_tcp_sockaddr_prefix(ipv4, 16)
  let socket = __platform_tcp_socket(ipv4)
  __platform_tcp_connect(socket, 0, 0)
  __platform_tcp_bind(socket, 0, 0)
  __platform_tcp_listen(socket, 8)
  __platform_tcp_accept(socket)
  __platform_tcp_set_no_delay(socket, 0)
  __platform_tcp_set_keep_alive(socket, 0)
  __platform_tcp_set_reuse_address(socket, 0)
  __platform_tcp_shutdown(socket, 2)
  __platform_tcp_getsockname(socket, 0, 0)
  __platform_tcp_getpeername(socket, 0, 0)
  ipv6 + prefix
}
