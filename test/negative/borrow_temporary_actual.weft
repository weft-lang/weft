use stdlib/drop.{*}

type BorrowTemporaryToken = opaque i64

impl Drop for BorrowTemporaryToken {
  fn drop(self) -> nil { nil }
}

fn make_token() -> owned BorrowTemporaryToken { BorrowTemporaryToken(1) }
fn inspect(token: borrow BorrowTemporaryToken) -> i64 { 0 }

fn bad() -> i64 { inspect(make_token()) }
