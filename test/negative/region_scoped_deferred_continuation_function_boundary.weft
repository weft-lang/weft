use "runtime/alloc.weft"

effect RegionDeferredFn {
  @deferred fn get() -> i64
}

fn go() -[RegionDeferredFn]> i64 {
  RegionDeferredFn.get()
}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 41)
    handle go() {
      RegionDeferredFn.get() with k -> k(1)
    }
  })
}
