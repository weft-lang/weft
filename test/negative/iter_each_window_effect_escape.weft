use stdlib/iter as iter

effect StoreWindow {
  fn store(value: [i64]) -> nil
}

fn store_window(window: borrow [i64]) -[StoreWindow]> nil {
  StoreWindow.store(window)
}

fn main() -> nil {
  handle iter.each_window(iter.range(0, 3), 2, store_window) {
    StoreWindow.store(window) -> resume(nil)
  }
  nil
}
