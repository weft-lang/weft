use stdlib/http/json.{HttpJsonReader}
use stdlib/http/stream.{HttpBodyStream}
use stdlib/http/transport.{HttpTransportRelease}
use stdlib/tls/stream.{TlsStream}

fn forge_http_json_reader(
  body: owned HttpBodyStream<TlsStream>
) -[HttpTransportRelease<TlsStream>]> owned HttpJsonReader<TlsStream> {
  HttpJsonReader(body)
}
