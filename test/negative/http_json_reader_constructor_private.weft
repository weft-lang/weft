use stdlib/http_json.{HttpJsonReader}
use stdlib/http_stream.{HttpBodyStream}
use stdlib/http_transport.{HttpTransportRelease}
use stdlib/tls_stream.{TlsStream}

fn forge_http_json_reader(
  body: owned HttpBodyStream<TlsStream>
) -[HttpTransportRelease<TlsStream>]> owned HttpJsonReader<TlsStream> {
  HttpJsonReader(body)
}
