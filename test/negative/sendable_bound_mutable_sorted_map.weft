use stdlib/sorted_map as sorted_map
use stdlib/sorted_map.{SortedMap}

-- SortedMap is a mutable ordered vector: insert updates every alias in place.
fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn rejected() -> SortedMap<i64, i64> {
  require_sendable<SortedMap<i64, i64>>(sorted_map.new<i64, i64>())
}

fn main() -> i64 { 0 }
