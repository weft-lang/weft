use stdlib/net_address.{SocketV4, ipv4_address}
use stdlib/tcp.{TcpConnect, TcpListenerIO, tcp_listen, tcp_listen_options}

fn outbound_only_cannot_listen() -[TcpConnect, TcpListenerIO]> i64 {
  let listener = tcp_listen(SocketV4(ipv4_address(127, 0, 0, 1), 8080), tcp_listen_options(16))
  0
}

fn main() -> i64 { 0 }
