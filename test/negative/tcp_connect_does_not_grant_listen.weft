use stdlib/net_address as net
use stdlib/net_address.{SocketV4}
use stdlib/tcp as tcp
use stdlib/tcp.{TcpConnect, TcpListenerIO}

fn outbound_only_cannot_listen() -[TcpConnect, TcpListenerIO]> i64 {
  let listener = tcp.listen(SocketV4(net.ipv4(127, 0, 0, 1), 8080), tcp.listen_options(16))
  0
}

fn main() -> i64 { 0 }
