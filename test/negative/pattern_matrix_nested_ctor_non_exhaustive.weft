type MatrixInner {
  MatrixInnerLeft,
  MatrixInnerRight,
}

type MatrixOuter {
  MatrixOuterWrap(MatrixInner),
  MatrixOuterEnd,
}

fn bad(value: MatrixOuter) -> i64 {
  match value {
    MatrixOuterWrap(MatrixInnerLeft) -> 1
    MatrixOuterEnd -> 0
  }
}

fn main() -> i64 { bad(MatrixOuterWrap(MatrixInnerRight)) }
