use stdlib/fail.{Fail}
use stdlib/net_address.{SocketV4, ipv4_address}
use stdlib/tcp.{TcpConnectOptions, TcpError, TcpListen, TcpStreamIO, tcp_connect}

fn inbound_only_cannot_connect() -[TcpListen, TcpStreamIO, Fail<TcpError>]> i64 {
  let stream = tcp_connect(
    SocketV4(ipv4_address(127, 0, 0, 1), 80),
    TcpConnectOptions { no_delay: true, keep_alive: false }
  )
  0
}

fn main() -> i64 { 0 }
