use stdlib/net_address as net
use stdlib/net_address.{SocketV4}
use stdlib/tcp as tcp
use stdlib/tcp.{TcpConnectOptions, TcpListen, TcpStreamIO}

fn inbound_only_cannot_connect() -[TcpListen, TcpStreamIO]> i64 {
  let stream = tcp.connect(
    SocketV4(net.ipv4(127, 0, 0, 1), 80),
    TcpConnectOptions { no_delay: true, keep_alive: false }
  )
  0
}

fn main() -> i64 { 0 }
