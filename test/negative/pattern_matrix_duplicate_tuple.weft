type MatrixDuplicateTupleBit {
  MatrixDuplicateTupleZero,
  MatrixDuplicateTupleOne,
}

fn bad(value: (MatrixDuplicateTupleBit, MatrixDuplicateTupleBit)) -> i64 {
  match value {
    (MatrixDuplicateTupleZero, MatrixDuplicateTupleOne) -> 1
    (MatrixDuplicateTupleZero, MatrixDuplicateTupleOne) -> 2
    _ -> 0
  }
}

fn main() -> i64 { bad((MatrixDuplicateTupleZero, MatrixDuplicateTupleOne)) }
