-- A generator owns its producer closure after the scoped arena is restored.
-- Region-backed captures therefore cannot leave the allocation scope inside it.
use runtime/alloc.{*}
use stdlib/generator as generator
use stdlib/generator.{*}

fn main() -> i64 {
  let arena = arena_new(64)
  let escaped = with_scoped_arena_alloc_value<owned Generator<i64, i64>>(arena, () => {
    let p = Alloc.alloc(8, 8)
    generator.start<i64, i64>(() => {
      generator.yield<i64>(p)
      0
    })
  })
  escaped.close()
}
