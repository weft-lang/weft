use stdlib/io.{*}

fn make_file() -> owned FileHandle {
  handle io_file_open_read("mock-path") {
    IO.open_read(path) -> resume(7)
    IO.read_into(fd, buffer) -> resume(0)
    IO.write_from(fd, buffer) -> resume(0)
    IO.close(fd) -> resume(0)
  }
}

fn bad() -> i64 {
  let file: owned FileHandle = make_file()
  0
}
