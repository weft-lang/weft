use stdlib/io.{*}

fn make_file() -> owned FileHandle {
  handle io_file_open("mock-path", io_o_rdonly(), 0) {
    IO.open(path, flags, mode) -> resume(7)
    IO.read(fd, buf, len) -> resume(0)
    IO.write(fd, buf, len) -> resume(len)
    IO.close(fd) -> resume(0)
  }
}

fn bad() -> i64 {
  let file: owned FileHandle = make_file()
  0
}
