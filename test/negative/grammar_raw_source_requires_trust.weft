use stdlib/grammar.{Grammar, ParseResult, Parsed}
use stdlib/source.{Span}
use stdlib/diagnostic/schema.{Diagnose}

type RawGrammar { RawGrammar }

impl Grammar for RawGrammar {
  type Syntax = i64
  fn parse(self, source: Span) -[Diagnose]> ParseResult<i64> {
    Parsed(__mem_load64(__str_ptr(source.source().text)))
  }
}
