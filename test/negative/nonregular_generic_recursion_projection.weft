-- Box<T>'s child is a Box one level deeper, so recursion through the
-- projection grows every turn.

trait Level {
  type Child: Level
  fn child(self) -> Self.Child
  fn leaf(self) -> bool
}

type Box<T> { value: T }

impl Level for i64 {
  type Child = i64
  fn child(self) -> i64 { self }
  fn leaf(self) -> bool { true }
}

impl<T> Level for Box<T> {
  type Child = Box<Box<T>>
  fn child(self) -> Box<Box<T>> { Box<Box<T>> { value: self } }
  fn leaf(self) -> bool { false }
}

fn walk<T: Level>(node: T, n: i64) -> i64 {
  if n == 0 or node.leaf() { 0 } else { 1 + walk<T.Child>(node.child(), n - 1) }
}

fn main() -> i64 { walk<Box<i64>>(Box<i64> { value: 1 }, 3) }
