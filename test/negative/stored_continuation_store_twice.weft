use "stdlib/continuation.weft"

effect StoredK {
  @deferred fn get() -> i64
}

fn main() -> i64 {
  let first = continuation_cell_new()
  let second = continuation_cell_new()
  handle StoredK.get() {
    StoredK.get() with k -> {
      continuation_cell_store_i64(first, k)
      continuation_cell_store_i64(second, k)
    }
  }
}
