-- A generic argument naming a missing associated type is unknown, not an
-- unimplemented bound.

trait Level {
  type Child: Level
  fn size(self) -> i64
}

fn size_of<U: Level>(node: U) -> i64 { node.size() }

fn ghost<T: Level>(node: T) -> i64 { size_of<T.Parent>(node) }

fn main() -> i64 { 0 }
