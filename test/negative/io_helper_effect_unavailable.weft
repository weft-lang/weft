use stdlib/bytes.{Bytes}
use stdlib/io/helpers.{io_read_all_with}
use stdlib/io/types.{IoError, IoReadProgress}
use stdlib/result.{Result}

effect HiddenRead {
  fn transfer(buffer: [mut u8]) -> Result<IoReadProgress, IoError>
}

fn hidden_read(buffer: [mut u8]) -[HiddenRead]> Result<IoReadProgress, IoError> {
  HiddenRead.transfer(buffer)
}

fn rejected() -> Result<Bytes, IoError> {
  io_read_all_with(1, hidden_read)
}
