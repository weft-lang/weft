type ConditionalBox<T> { ConditionalBox(T) }
trait Marked { fn mark(self) -> i64 }
trait Identity { fn identity(self) -> Self }

impl Marked for i64 { fn mark(self) -> i64 { self } }
impl<T: Marked> Identity for ConditionalBox<T> {
  fn identity(self) -> Self { self }
}

fn accept_identity<T: Identity>(value: T) -> i64 { 42 }

fn main() -> i64 {
  accept_identity<ConditionalBox<bool>>(ConditionalBox<bool>(true))
}
