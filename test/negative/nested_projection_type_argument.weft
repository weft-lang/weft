-- A projection of a projection cannot be specialised yet, even with its bound.

trait Level {
  type Child: Level
  fn child(self) -> Self.Child
  fn leaf(self) -> bool
  fn size(self) -> i64
}

type Root { size: i64 }

type Branch { size: i64 }

type Leaf { size: i64 }

impl Level for Root {
  type Child = Branch
  fn child(self) -> Branch { Branch { size: self.size - 1 } }
  fn leaf(self) -> bool { false }
  fn size(self) -> i64 { self.size }
}

impl Level for Branch {
  type Child = Leaf
  fn child(self) -> Leaf { Leaf { size: self.size - 1 } }
  fn leaf(self) -> bool { false }
  fn size(self) -> i64 { self.size }
}

impl Level for Leaf {
  type Child = Leaf
  fn child(self) -> Leaf { Leaf { size: self.size } }
  fn leaf(self) -> bool { true }
  fn size(self) -> i64 { self.size }
}

fn size_of<U: Level>(node: U) -> i64 { node.size() }

fn grandchild_size<T: Level>(node: T) -> i64 { size_of<T.Child.Child>(node.child().child()) }

fn main() -> i64 { 0 }
