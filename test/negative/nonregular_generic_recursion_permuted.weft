use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

-- Swapping the parameters does not hide growth: A feeds B unchanged and B
-- feeds A wrapped, so the pair grows every second turn.
fn braid<A, B>(n: i64, first: A, second: B) -> i64 {
  if n == 0 { 0 } else {
    let mut wrapped = vector.new<A>()
    wrapped.push(first)
    1 + braid<B, Vector<A>>(n - 1, second, wrapped)
  }
}

fn main() -> i64 { braid<i64, str>(3, 1, "one") }
