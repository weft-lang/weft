use stdlib/list.{*}
use runtime/alloc.{*}

fn noisy(x: i64) -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  __mem_store64(p, x)
  __mem_load64(p)
}

fn add(acc: i64, x: i64) -> i64 { acc + x }

fn main() -[Alloc]> i64 {
  list_fold<i64, i64>(
    list_map<i64, i64>(list_cons<i64>(1, list_nil<i64>()), noisy),
    0,
    add
  )
}
