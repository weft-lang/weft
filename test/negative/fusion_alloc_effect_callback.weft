use stdlib/list.{*}
use runtime/alloc.{*}

fn noisy(x: i64) -[Alloc]> i64 {
  let p = alloc_effect(8, 8)
  __mem_store64(p, x)
  __mem_load64(p)
}

fn add(acc: i64, x: i64) -> i64 { acc + x }

fn main() -[Alloc]> i64 {
  let mapped = Cons<i64>(1, Nil<i64>()).map<i64>(noisy)
  mapped.fold<i64>(0, add)
}
