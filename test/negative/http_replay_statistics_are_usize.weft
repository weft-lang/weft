use stdlib/http/replay.{HttpReplayStats}

fn read_calls(stats: HttpReplayStats) -> i64 { stats.read_calls }

fn read_bytes(stats: HttpReplayStats) -> i64 { stats.read_bytes }

fn write_calls(stats: HttpReplayStats) -> i64 { stats.write_calls }

fn write_bytes(stats: HttpReplayStats) -> i64 { stats.write_bytes }

fn closes(stats: HttpReplayStats) -> i64 { stats.closes }

fn releases(stats: HttpReplayStats) -> i64 { stats.releases }

fn errors(stats: HttpReplayStats) -> i64 { stats.errors }

fn begins(stats: HttpReplayStats) -> i64 { stats.begins }

fn repeated_begins(stats: HttpReplayStats) -> i64 { stats.repeated_begins }

fn main() -> i64 { 0 }
