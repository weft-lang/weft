-- A method and a function recursing through each other: the method passes its
-- impl's target, Box<T>, to the function, which calls the method on a Box of
-- that, so the impl argument grows every turn.

type Box<T> { value: T }

impl<T> Box<T> {
  fn nest(self, n: i64) -> i64 { wrap<Box<T>>(self, n) }
}

fn wrap<U>(value: U, n: i64) -> i64 {
  if n == 0 { 0 } else { Box<U> { value: value }.nest(n - 1) }
}

fn main() -> i64 { wrap<i64>(1, 3) }
