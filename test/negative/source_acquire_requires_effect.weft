use compiler/lib.{nlist_new}
use compiler/parse.{parse_use_file}
use compiler/type_registry.{ttable_new}
use stdlib/diagnostic_type.{Diagnose}

fn rejected() -> i64 {
  handle parse_use_file(nlist_new(), ttable_new(), "missing_dependency.weft") {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
}
