-- qualified names: a qualified handler clause must discharge the atom performed by its
-- body, not merely another instantiation with the same head.
effect Box<T> {
  fn get() -> T
}

fn use_str() -[Box<str>]> str {
  Box.get()
}

fn main() -> i64 {
  handle use_str() {
    Box<i64>.get() -> resume(42)
  }
  0
}
