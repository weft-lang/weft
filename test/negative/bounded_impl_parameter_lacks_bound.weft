-- Without the bound on T, the implementation for Box<T> is not selected.

trait Deep {
  fn deep(self, n: i64) -> i64
}

type Box<T> { value: T }

impl<T: Deep> Deep for Box<T> {
  fn deep(self, n: i64) -> i64 { self.value.deep(n + 1) }
}

fn measure<U: Deep>(value: U) -> i64 { value.deep(0) }

fn unbounded<T>(value: T) -> i64 { measure(Box<T> { value: value }) }

fn main() -> i64 { 0 }
