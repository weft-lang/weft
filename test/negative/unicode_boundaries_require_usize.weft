use stdlib/unicode
use stdlib/option.{Option}

fn grapheme(offset: i64) -> bool { "text".is_grapheme_boundary(offset) }
fn word(offset: i64) -> bool { "text".is_word_boundary(offset) }
fn sentence(offset: i64) -> bool { "text".is_sentence_boundary(offset) }
fn next_grapheme(offset: i64) -> Option<usize> { "text".next_grapheme_boundary(offset) }
fn next_word(offset: i64) -> Option<usize> { "text".next_word_boundary(offset) }
fn next_sentence(offset: i64) -> Option<usize> { "text".next_sentence_boundary(offset) }
