use runtime/safe_io.{runtime_platform_file_write_with}
use stdlib/bytes as bytes
use stdlib/file as file
use stdlib/file.{FileWrite}
use stdlib/path.{Path}

effect ExtraIoAudit {
  fn tick() -> i64
}

fn effectful(path: Path) -[FileWrite, ExtraIoAudit]> i64 {
  file.write_all(path, bytes.empty())
  ExtraIoAudit.tick()
}

fn rejected(path: Path) -> i64 {
  runtime_platform_file_write_with(() => effectful(path))
}
