use stdlib/http.{*}

fn signed_position(error: HttpParseError) -> i64 {
  match error {
    HttpInvalidStartLine(position) -> position
    HttpInvalidMethod(position) -> position
    HttpInvalidTarget(position) -> position
    HttpInvalidVersion(position) -> position
    HttpInvalidStatus(position) -> position
    HttpInvalidFieldName(position) -> position
    HttpInvalidFieldValue(position) -> position
    HttpInvalidLineEnding(position) -> position
    HttpStartLineTooLong(position) -> position
    HttpFieldLineTooLong(position) -> position
    HttpHeadersTooLarge(position) -> position
    HttpTooManyHeaders(position) -> position
    HttpMissingHost(position) -> position
    HttpDuplicateHost(position) -> position
    HttpInvalidHost(position) -> position
    HttpInvalidContentLength(position) -> position
    HttpAmbiguousFraming(position) -> position
    HttpInvalidTransferEncoding(position) -> position
    HttpUnsupportedTransferCoding(position) -> position
    HttpForbiddenBodyFraming(position) -> position
    HttpInvalidConnection(position) -> position
    HttpBodyTooLarge(position) -> position
    HttpInvalidChunkSize(position) -> position
    HttpChunkLineTooLong(position) -> position
    HttpInvalidChunkTerminator(position) -> position
    HttpTrailersTooLarge(position) -> position
    HttpForbiddenTrailer(position) -> position
  }
}

fn main() -> i64 { 0 }
