use stdlib/drop.{*}

type DeferredOuterBorrowToken = opaque i64

impl Drop for DeferredOuterBorrowToken {
  fn drop(self) -> nil { nil }
}

effect DeferredOuterBorrow {
  @deferred fn suspend() -> i64
}

fn inspect(token: borrow DeferredOuterBorrowToken) -> i64 { 1 }

fn bad(token: borrow DeferredOuterBorrowToken) -> i64 {
  handle DeferredOuterBorrow.suspend() {
    DeferredOuterBorrow.suspend() with k -> inspect(token) + k(41)
  }
}
