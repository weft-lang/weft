use compiler/comptime/evaluate.{comptime_evaluate_file_reads}
use stdlib/file.{FileRead}

effect OtherAuthority {
  fn value() -> i64
}

fn effectful_input() -[FileRead, OtherAuthority]> i64 {
  OtherAuthority.value()
}

fn invalid() -[OtherAuthority]> i64 {
  let product = comptime_evaluate_file_reads(() => effectful_input())
  0
}

fn main() -> i64 { 0 }
