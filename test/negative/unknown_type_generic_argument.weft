-- An unknown type used as a bounded generic argument is one error: the bound
-- is not checked against the stand-in, directly or inside another type.

trait Level {
  fn size(self) -> i64
}

type Box<T> { value: T }

impl<T: Level> Level for Box<T> {
  fn size(self) -> i64 { self.value.size() }
}

fn size_of<U: Level>(node: U) -> i64 { node.size() }

fn requires_level<U: Level>() -> i64 { 0 }

fn direct<T: Level>(node: T) -> i64 { size_of<Nope>(node) }

fn wrapped() -> i64 { requires_level<Box<Nope>>() }

fn main() -> i64 { 0 }
