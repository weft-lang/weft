-- A method call instantiates the impl at the arguments its receiver binds:
-- calling depth on a Box<Box<T>> inside Box<T>'s depth grows every turn.

type Box<T> { value: T }

impl<T> Box<T> {
  fn depth(self, n: i64) -> i64 {
    if n == 0 { 0 } else { 1 + Box<Box<T>> { value: self }.depth(n - 1) }
  }
}

fn main() -> i64 { Box<i64> { value: 1 }.depth(3) }
