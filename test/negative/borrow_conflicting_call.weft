use stdlib/drop.{*}

type BorrowConflictToken = opaque i64

impl Drop for BorrowConflictToken {
  fn drop(self) -> nil { nil }
}

fn inspect_and_mutate(shared: borrow BorrowConflictToken, exclusive: borrow mut BorrowConflictToken) -> i64 { 0 }

fn bad() -> i64 {
  let mut token: owned BorrowConflictToken = BorrowConflictToken(1)
  inspect_and_mutate(token, token)
}
