-- Lazy adapters own their callback and upstream chain after the scoped arena
-- is restored. A callback may not smuggle a region-backed value out with it.
use runtime/alloc.{*}
use stdlib/iter as iter
use stdlib/iter.{Iterator}

fn main() -> i64 {
  let arena = arena_new(64)
  let escaped = with_scoped_arena_alloc_value<Iterator<i64>>(arena, () => {
    let p = Alloc.alloc(8, 8)
    iter.map<i64, i64>(iter.range(0, 2), value => value + p)
  })
  escaped.close()
}
