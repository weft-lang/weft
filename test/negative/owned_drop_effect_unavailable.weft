use "stdlib/drop.weft"

effect OwnedDropLog {
  fn ping() -> i64
}

type OwnedDropEffectToken {
  value: i64
}

impl Drop for OwnedDropEffectToken {
  fn drop(self: i64) -[OwnedDropLog]> i64 {
    OwnedDropLog.ping()
  }
}

fn bad() -> i64 {
  let token: owned OwnedDropEffectToken = OwnedDropEffectToken { value: 1 }
  0
}
