trait GenericMethodMarker {
  fn marker(self: Self) -> i64
}

impl GenericMethodMarker for i64 {
  fn marker(self: i64) -> i64 { self }
}

type GenericMethodHost {
  GenericMethodHost
}

impl GenericMethodHost {
  fn accept<T: GenericMethodMarker>(self: GenericMethodHost, value: T) -> i64 {
    value.marker()
  }
}

fn main() -> i64 {
  GenericMethodHost.accept<str>("not marked")
}
