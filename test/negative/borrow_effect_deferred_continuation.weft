use stdlib/drop.{*}

type BorrowDeferredToken = opaque i64

impl Drop for BorrowDeferredToken {
  fn drop(self) -> nil { nil }
}

effect BorrowDeferred {
  @deferred fn inspect(token: borrow BorrowDeferredToken) -> i64
}

fn inspect(token: borrow BorrowDeferredToken) -[BorrowDeferred]> i64 {
  BorrowDeferred.inspect(token)
}

fn bad() -> i64 {
  let token: owned BorrowDeferredToken = BorrowDeferredToken(1)
  handle inspect(token) {
    BorrowDeferred.inspect(value) with k -> k(42)
  }
}
