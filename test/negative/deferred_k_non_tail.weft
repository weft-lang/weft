use "runtime/rc.weft"

effect DeferredK {
  @deferred fn step(value: rc i64) -> rc i64
}

fn go(value: rc i64) -[DeferredK]> rc i64 {
  DeferredK.step(value)
}

fn main() -> rc i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  handle go(p) {
    DeferredK.step(value) with k -> {
      let resumed = k(value)
      resumed
    }
  }
}
