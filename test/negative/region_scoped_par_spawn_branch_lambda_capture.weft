use runtime/alloc.{*}
use stdlib/par.{*}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    par_with_sequential_i64(() => {
      let worker = if true { () => p + 1 } else { () => 1 }
      let task = par_spawn<i64>(worker)
      par_await<i64>(task)
    })
  })
}
