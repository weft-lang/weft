use runtime/alloc.{*}
use stdlib/par as par
use stdlib/par.{*}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    par.with_sequential(() => {
      let worker = if true { () => p + 1 } else { () => 1 }
      let task = par.fork<i64>(worker)
      par.join<i64>(task)
    })
  })
}
