use "runtime/alloc.weft"

effect Par {
  fn spawn(f: (i64) -> i64, arg: i64) -> i64,
  fn await(h: i64) -> i64
}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    handle Par.spawn(if true { x => x + p } else { x => x }, 1) {
      Par.spawn(f, arg) -> resume(f(arg))
      Par.await(h) -> resume(h)
    }
  })
}
