use stdlib/vector as vector
use stdlib/vector.{PersistentVector}
use stdlib/vector/handles.{Vector}

-- A persistent vector is Sendable only when its elements are.
fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn rejected(values: PersistentVector<Vector<i64>>) -> PersistentVector<Vector<i64>> {
  require_sendable<PersistentVector<Vector<i64>>>(values)
}

fn main() -> i64 { 0 }
