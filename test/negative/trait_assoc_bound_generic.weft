trait AssocBoundGenericValue {
  fn value(self) -> i64
}

trait AssocBoundGenericSource {
  type Item: AssocBoundGenericValue
  fn get(self, value: Self.Item) -> Self.Item
}

type AssocBoundGenericBox<T> { value: T }

impl<T> AssocBoundGenericSource for AssocBoundGenericBox<T> {
  type Item = T
  fn get(self, value: Item) -> Item { value }
}
