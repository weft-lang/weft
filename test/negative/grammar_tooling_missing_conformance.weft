-- Host checking requires the tooling conformance; a plain `Grammar` has none.

use module_fixtures/plain_grammar as plain
use stdlib/diagnostic/schema.{Diagnose, DiagnosticSourceUnknown}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/grammar/tooling.{ToolTypeIdentity, GrammarCheckOutcome, GrammarCheckRejected}
use stdlib/grammar/tooling/conformance.{host_check}
use stdlib/source.{Source, Span}
use stdlib/typecheck.{TypeCheck}

fn check(text: str) -[TypeCheck<ToolTypeIdentity>, Diagnose]> GrammarCheckOutcome {
  match plain.grammar().parse(Source { text: text, identity: DiagnosticSourceUnknown }.all()) {
    Parsed(syntax) -> host_check(plain.grammar(), syntax)
    _ -> GrammarCheckRejected
  }
}

fn main() -> i64 { 0 }
