use stdlib/vector
use stdlib/result
use stdlib/par as par
use stdlib/par.{*}

effect Log {
  fn hit() -> i64
}

fn noisy(x: i64) -[Log]> i64 {
  Log.hit() + x
}

fn main() -> i64 {
  let values = [1]
  par.with_pool(par.pool_config(2, 4).unwrap(), () => {
    let mapped = par.map<i64, i64>(values[..], noisy)
    mapped.fold(0, (total, value) => total + value)
  })
}
