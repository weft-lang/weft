type ReturnedAliasBox {
  k: Continuation<i64, i64>
}

effect DeferredK {
  @deferred fn get() -> i64
}

fn hold(k: Continuation<i64, i64>) -> Continuation<i64, i64> {
  k
}

fn main() -> i64 {
  handle DeferredK.get() * 2 {
    DeferredK.get() with k -> {
      let saved = hold(k)
      let stored = ReturnedAliasBox { k: saved }
      0
    }
  }
}
