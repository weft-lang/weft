use stdlib/vector
use stdlib/result
use stdlib/par as par
use stdlib/par.{*}

fn main() -> i64 {
  let mut values = [40, 2]
  let view: [mut i64] = values[..]
  let inputs = [1]
  par.with_pool(par.pool_config(2, 4).unwrap(), () => {
    let mapped = par.map<i64, i64>(inputs[..], x => view[0] + x)
    mapped.fold(0, (total, value) => total + value)
  })
}
