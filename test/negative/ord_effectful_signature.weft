effect OrdNoise {
  fn tick() -> nil
}

type Ordering { Less, Equal, Greater }

trait Ord {
  fn compare(self: Self, other: Self) -[OrdNoise]> Ordering
}

type NoisyOrd {
  NoisyOrd(i64)
}

impl Ord for NoisyOrd {
  fn compare(self: Self, other: Self) -> Ordering { Equal }
}

fn main() -> bool {
  NoisyOrd(1) < NoisyOrd(2)
}
