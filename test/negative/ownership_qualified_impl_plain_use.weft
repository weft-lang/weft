trait QualifiedPlainUse {
  fn consume(self: Self) -> i64
}

type QualifiedPlainUseBox {
  value: i64
}

impl QualifiedPlainUse for unique QualifiedPlainUseBox {
  fn consume(self: unique QualifiedPlainUseBox) -> i64 { self.value }
}

fn apply<T: QualifiedPlainUse>(value: T) -> i64 {
  value.consume()
}

fn main() -> i64 {
  let value = QualifiedPlainUseBox { value: 42 }
  apply(value)
}
