-- must-fail: target entropy and DNS transport ABI remain sealed to trusted runtime/platform code

fn main() -> i64 {
  let random = __platform_secure_random_read(0, 2)
  let udp = __platform_dns_udp_socket(2)
  let tcp = __platform_dns_tcp_socket(2)
  let connected = __platform_dns_connect(udp, 0, 0)
  let deadline = __platform_dns_set_receive_timeout(tcp, random + connected)
  let available = __platform_dns_system_available()
  let resolved = __platform_dns_system_resolve(0, 0, 0, 0)
  let released = __platform_dns_system_release(0)
  __platform_dns_system_error() + deadline + available + resolved + released
}
