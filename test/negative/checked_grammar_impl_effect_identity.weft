use stdlib/grammar.{CheckedGrammar, CheckResult, CheckRejected}
use stdlib/typecheck.{TypeCheck}
use stdlib/diagnostic.{Diagnose}

type WrongIdentityGrammar { WrongIdentityGrammar }

impl CheckedGrammar for WrongIdentityGrammar {
  type Syntax = i64
  type Checked = i64
  type Identity = str

  fn check(self, syntax: i64) -[TypeCheck<i64>, Diagnose]> CheckResult<i64> {
    CheckRejected<i64>()
  }
}
