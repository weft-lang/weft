trait QualifiedDuplicate {
  fn consume(self: Self) -> i64
}

type QualifiedDuplicateBox {
  value: i64
}

impl QualifiedDuplicate for unique QualifiedDuplicateBox {
  fn consume(self: unique QualifiedDuplicateBox) -> i64 { self.value }
}

impl QualifiedDuplicate for unique QualifiedDuplicateBox {
  fn consume(self: unique QualifiedDuplicateBox) -> i64 { self.value }
}

fn main() -> i64 { 0 }
