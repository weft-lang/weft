use stdlib/http_stream.{HttpConnection}
use stdlib/http_transport.{HttpTransportRelease}
use stdlib/tls_stream.{TlsStream}
use stdlib/websocket_stream.{WebSocketStream}

fn forge_websocket_stream(
  connection: owned HttpConnection<TlsStream>
) -[HttpTransportRelease<TlsStream>]> owned WebSocketStream<TlsStream> {
  WebSocketStream(connection)
}
