use stdlib/http/stream.{HttpConnection}
use stdlib/http/transport.{HttpTransportRelease}
use stdlib/tls/stream.{TlsStream}
use stdlib/websocket/stream.{WebSocketStream}

fn forge_websocket_stream(
  connection: owned HttpConnection<TlsStream>
) -[HttpTransportRelease<TlsStream>]> owned WebSocketStream<TlsStream> {
  WebSocketStream(connection)
}
