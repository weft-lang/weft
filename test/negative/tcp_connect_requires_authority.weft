use stdlib/net_address as net
use stdlib/net_address.{SocketV4}
use stdlib/tcp.{tcp_connect, tcp_connect_options_default}

fn missing_connect_authority() -> i64 {
  let stream = tcp_connect(SocketV4(net.ipv4(127, 0, 0, 1), 80), tcp_connect_options_default())
  0
}

fn main() -> i64 { missing_connect_authority() }
