use stdlib/drop.{Drop}

type MixedDropResource { value: i64 }
effect MixedDrop {
  fn read(resource: owned MixedDropResource) -> i64
  fn dropped(value: i64) -> nil
}

impl Drop for MixedDropResource {
  fn drop(self) -[MixedDrop]> i64 { MixedDrop.dropped(self.value) 0 }
}

fn bad(cancel: bool) -> i64 {
  handle MixedDrop.read(MixedDropResource { value: 4 }) + 1 {
    MixedDrop.read(resource) -> if cancel { 42 } else { resume(7) }
    MixedDrop.dropped(value) -> resume(nil)
  }
}
