use stdlib/http.{HttpLimits, HttpRequestHead}
use stdlib/http_endpoint.{HttpClientBegin, HttpServer, http_client_begin}
use stdlib/url.{Url}

fn connect_with_server_authority(
  url: Url,
  request: HttpRequestHead,
  limits: HttpLimits
) -[HttpServer]> HttpClientBegin {
  http_client_begin(url, request, limits)
}
