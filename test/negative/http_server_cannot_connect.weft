use stdlib/http.{HttpLimits, HttpRequestHead}
use stdlib/http/endpoint.{HttpClientBegin, HttpServer, http_client_begin}
use stdlib/tls/stream.{TlsStream}
use stdlib/url.{Url}

fn connect_with_server_authority(
  url: Url,
  request: HttpRequestHead,
  limits: HttpLimits
) -[HttpServer]> HttpClientBegin<TlsStream> {
  http_client_begin<TlsStream>(url, request, limits)
}
