use stdlib/task.{Task}
use stdlib/task/channel as channel
use stdlib/task/channel.{Channel}
use stdlib/result.{Result}
use stdlib/task as task

fn escape_body() -[task.TaskScope, Channel<i64>]> unique Task<i64> {
  task.spawn(() => 42)
}

fn bad() -> i64 {
  let capacity = channel.capacity(1).expect("valid capacity")
  let escaped = task.with_sequential_channel(capacity, escape_body)
  0
}
