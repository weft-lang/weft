use runtime/alloc.{*}
use stdlib/continuation.{*}

effect RegionDeferredStore {
  @deferred fn get() -> i64
}

fn main() -> i64 {
  let cell = continuation_cell_new()
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 41)
    handle RegionDeferredStore.get() {
      RegionDeferredStore.get() with k -> continuation_cell_store_i64(cell, k)
    }
  })
}
