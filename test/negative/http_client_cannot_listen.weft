use stdlib/http_endpoint.{HttpClient, HttpServerListen, http_server_listen}
use stdlib/net_address.{SocketAddress}
use stdlib/tcp.{TcpListenOptions}

fn listen_with_client_authority(
  address: SocketAddress,
  options: TcpListenOptions
) -[HttpClient]> HttpServerListen {
  http_server_listen(address, options)
}
