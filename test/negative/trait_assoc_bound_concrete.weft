trait AssocBoundConcreteValue {
  fn value(self) -> i64
}

trait AssocBoundConcreteSource {
  type Item: AssocBoundConcreteValue
  fn get(self, value: Item) -> Item
}

type AssocBoundConcreteBox { value: str }

impl AssocBoundConcreteSource for AssocBoundConcreteBox {
  type Item = str
  fn get(self, value: Item) -> Item { value }
}
