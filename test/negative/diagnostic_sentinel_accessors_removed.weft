use stdlib/diagnostic
use stdlib/diagnostic/schema.{DiagnosticLocation, DiagnosticRelatedLocationList, DiagnosticTextEditList, DiagnosticFieldList}

fn legacy(location: DiagnosticLocation, related: DiagnosticRelatedLocationList, edits: DiagnosticTextEditList, fields: DiagnosticFieldList) -> i64 {
  location.source()
  location.start()
  location.end()
  related.count()
  edits.count()
  fields.count()
  0
}
