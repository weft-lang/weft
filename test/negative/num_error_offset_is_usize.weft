use stdlib/num.{NumParseError, NumParseEmpty, NumParseInvalid, NumParseOverflow, NumParseUnderflow, NumParseTrailing}

fn position(error: NumParseError) -> i64 {
  match error {
    NumParseEmpty(at) -> at
    NumParseInvalid(at) -> at
    NumParseOverflow(at) -> at
    NumParseUnderflow(at) -> at
    NumParseTrailing(at) -> at
  }
}

fn main() -> i64 { position(NumParseEmpty(0)) }
