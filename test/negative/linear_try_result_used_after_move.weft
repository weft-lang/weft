use stdlib/drop.{Drop}
use stdlib/fail.{Fail}
use stdlib/result.{Result, result_ok}

type LinearTryMoveToken {
  value: i64
}

impl Drop for LinearTryMoveToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

fn consume(value: owned LinearTryMoveToken) -> i64 {
  1
}

fn make() -> Result<owned LinearTryMoveToken, i64> {
  result_ok<owned LinearTryMoveToken, i64>(LinearTryMoveToken { value: 1 })
}

fn bad() -[Fail<i64>]> i64 {
  let result: Result<owned LinearTryMoveToken, i64> = make()
  let token: owned LinearTryMoveToken = result?
  consume(token) + match result {
    Ok(value) -> consume(value)
    Err(error) -> error
  }
}
