use stdlib/sorted_set as sorted_set
use stdlib/sorted_set.{SortedSet}

-- SortedSet wraps a mutable SortedMap, so it inherits its representation's
-- mutability.
fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn rejected() -> SortedSet<i64> {
  require_sendable<SortedSet<i64>>(sorted_set.new<i64>())
}

fn main() -> i64 { 0 }
