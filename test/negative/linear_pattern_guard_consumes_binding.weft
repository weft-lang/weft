use stdlib/drop.{*}

type LinearPatternGuardToken {
  value: i64
}

impl Drop for LinearPatternGuardToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

type LinearPatternGuardChoice {
  LinearPatternGuardEmpty,
  LinearPatternGuardHeld(owned LinearPatternGuardToken)
}

fn consume(value: owned LinearPatternGuardToken) -> i64 {
  1
}

fn bad() -> i64 {
  let held: LinearPatternGuardChoice = LinearPatternGuardHeld(LinearPatternGuardToken { value: 1 })
  match held {
    LinearPatternGuardHeld(token) if consume(token) == 1 -> 1
    _ -> 0
  }
}
