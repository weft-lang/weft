use runtime/spawn_task.{SpawnTask}
use stdlib/channel as channel
use stdlib/channel.{Channel}
use stdlib/result.{Result}
use stdlib/spawn as spawn

fn escape_body() -[spawn.Spawn, Channel<i64>]> unique SpawnTask<i64> {
  spawn.spawn(() => 42)
}

fn bad() -> i64 {
  let capacity = channel.capacity<i64>(1).expect("valid capacity")
  let escaped = spawn.with_event_loop_channel_shutdown(capacity, escape_body)
  0
}
