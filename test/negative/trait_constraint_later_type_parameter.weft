-- Bounds may name only earlier type parameters, so C is not in scope in T's
-- constraint and must be reported rather than read as an unknown type.

trait Level {
  type Child: Level
  fn size(self) -> i64
}

fn grandchild_size<T: Level & { type Child = C }, C: Level>(node: T) -> i64 { node.size() }

fn main() -> i64 { 0 }
