use stdlib/diagnostic/schema.{Diagnose}
use stdlib/file.{FileRead}
use stdlib/grammar.{Grammar, ParseResult, Parsed}
use stdlib/grammar/tooling.{ToolTypeIdentity}
use stdlib/grammar/tooling/conformance as conformance
use stdlib/grammar/tooling/conformance.{StageResult, StageRefused}
use stdlib/grammar/tooling/staging.{*}
use stdlib/json.{JsonNull}
use stdlib/list.{List, Nil}
use stdlib/result.{Result, Ok}
use stdlib/source.{Span}
use stdlib/typecheck.{TypeCheck}

-- The grammar parses to a byte count but stages text: the staging
-- conformance disagrees with the grammar on `Syntax`, so the driver's
-- stage path cannot hand one parse result to both.
type SizeGrammar { SizeGrammar }

impl Grammar for SizeGrammar {
  type Syntax = usize
  fn parse(self, source: Span) -[Diagnose]> ParseResult<usize> { Parsed(source.len()) }
}

impl GrammarStaging for SizeGrammar {
  type Syntax = str
  type Persistent = str

  fn stagings(self) -> List<StagingSupport> { Nil<StagingSupport>() }

  fn persist(
    self,
    syntax: str,
    context: StagingContext
  ) -[TypeCheck<ToolTypeIdentity>, FileRead, Diagnose]> Result<str, StagingRefusal> {
    Ok<str, StagingRefusal>(syntax)
  }

  fn emit(self, plan: str, target: StagingTarget) -[StagingSink, Diagnose]> StagingReport {
    StagingReport { outcome: StagingEmitted, facts: JsonNull }
  }
}

fn agreement(
  grammar: SizeGrammar,
  source: Span
) -[TypeCheck<ToolTypeIdentity>, FileRead, StagingSink, Diagnose]> StageResult {
  match grammar.parse(source) {
    Parsed(syntax) -> conformance.stage(
      grammar,
      syntax,
      StagingHostTypes,
      StagingTarget { capability: StagingTypedPlan, platform: "macos-aarch64" }
    )
    _ -> StageRefused(StagingCheckRejected)
  }
}
