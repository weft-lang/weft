use "runtime/alloc.weft"
use "stdlib/par.weft"

fn worker(x: i64) -> i64 {
  x
}

fn main() -> i64 {
  let arena = arena_new(64)
  with_scoped_arena_alloc(arena, () => {
    let p = Alloc.alloc(8, 8)
    par_with_sequential_i64(() => {
      let task = par_spawn<i64>(() => worker(p))
      par_await<i64>(task)
    })
  })
}
