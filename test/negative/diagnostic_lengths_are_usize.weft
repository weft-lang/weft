use stdlib/diagnostic
use stdlib/diagnostic/schema.{DiagnosticRelatedLocationList, DiagnosticTextEditList, DiagnosticFieldList}

fn related(values: DiagnosticRelatedLocationList) -> i64 { values.len() }

fn edits(values: DiagnosticTextEditList) -> i64 { values.len() }

fn fields(values: DiagnosticFieldList) -> i64 { values.len() }

fn suggestions(values: DiagnosticFieldList) -> i64 { values.suggestion_count() }
