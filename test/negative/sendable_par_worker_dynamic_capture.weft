use stdlib/result
use stdlib/par as par
use stdlib/par.{*}

fn inspect_dynamic(value: any) -> i64 { 0 }

fn bad(state: any) -> i64 {
  let values = [1]
  par.with_pool(par.pool_config(2, 4).unwrap(), () => {
    let mapped = par.map<i64, i64>(values[..], x => x + inspect_dynamic(state))
    mapped.len()
  })
}
