use stdlib/diagnostic/schema.{DiagnosticLocation, DiagnosticSourceNamed, DiagnosticSourceRange}

fn signed_start(start: i64) -> DiagnosticLocation { DiagnosticSourceRange(DiagnosticSourceNamed("file"), start, 9) }

fn signed_end(end: i64) -> DiagnosticLocation { DiagnosticSourceRange(DiagnosticSourceNamed("file"), 0, end) }
