trait QualifiedOverlap {
  fn consume(self: Self) -> i64
}

type QualifiedOverlapBox {
  value: i64
}

impl QualifiedOverlap for QualifiedOverlapBox {
  fn consume(self: QualifiedOverlapBox) -> i64 { self.value }
}

impl QualifiedOverlap for unique QualifiedOverlapBox {
  fn consume(self: unique QualifiedOverlapBox) -> i64 { self.value }
}

fn main() -> i64 { 0 }
