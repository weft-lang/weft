use stdlib/drop.{*}

type BorrowEffectConflictToken = opaque i64

impl Drop for BorrowEffectConflictToken {
  fn drop(self) -> nil { nil }
}

effect BorrowEffectConflict {
  fn inspect_and_mutate(shared: borrow BorrowEffectConflictToken, exclusive: borrow mut BorrowEffectConflictToken) -> i64
}

fn bad() -[BorrowEffectConflict]> i64 {
  let mut token: owned BorrowEffectConflictToken = BorrowEffectConflictToken(1)
  BorrowEffectConflict.inspect_and_mutate(token, token)
}
