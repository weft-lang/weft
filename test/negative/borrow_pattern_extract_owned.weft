use stdlib/drop.{Drop}

type BorrowPatternToken = opaque i64

impl Drop for BorrowPatternToken {
  fn drop(self) -> i64 { 0 }
}

type BorrowPatternBox = opaque owned BorrowPatternToken

impl Drop for BorrowPatternBox {
  fn drop(self) -> i64 {
    match self { BorrowPatternBox(token) -> token.drop() }
  }
}

fn extract(box: borrow BorrowPatternBox) -> owned BorrowPatternToken {
  match box { BorrowPatternBox(token) -> token }
}

fn main() -> i64 { 0 }
