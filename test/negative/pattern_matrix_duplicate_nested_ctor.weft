type MatrixDuplicateInner {
  MatrixDuplicateInnerLeft,
  MatrixDuplicateInnerRight,
}

type MatrixDuplicateOuter {
  MatrixDuplicateOuterWrap(MatrixDuplicateInner),
  MatrixDuplicateOuterEnd,
}

fn bad(value: MatrixDuplicateOuter) -> i64 {
  match value {
    MatrixDuplicateOuterWrap(MatrixDuplicateInnerLeft) -> 1
    MatrixDuplicateOuterWrap(MatrixDuplicateInnerLeft) -> 2
    _ -> 0
  }
}

fn main() -> i64 { bad(MatrixDuplicateOuterWrap(MatrixDuplicateInnerLeft)) }
