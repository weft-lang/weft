effect Log {
  fn hit() -> i64
}

type EffectMethodBox {
  v: i64
}

impl EffectMethodBox {
  fn noisy(self: i64) -[Log]> i64 {
    Log.hit() + __mem_load64(self)
  }
}

fn apply_method(f: (EffectMethodBox) -> i64, b: EffectMethodBox) -> i64 {
  f(b)
}

fn bad(b: EffectMethodBox) -[Log]> i64 {
  let f = (x: EffectMethodBox) => x.noisy()
  apply_method(f, b)
}
