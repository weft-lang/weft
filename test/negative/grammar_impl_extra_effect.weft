use stdlib/grammar.{Grammar, ParseResult, Parsed}
use stdlib/source.{Span}
use stdlib/diagnostic/schema.{Diagnose}

effect Acquire { fn read() -> usize }
type AcquiringGrammar { AcquiringGrammar }

impl Grammar for AcquiringGrammar {
  type Syntax = usize
  fn parse(self, source: Span) -[Diagnose, Acquire]> ParseResult<usize> {
    Parsed(Acquire.read())
  }
}
