use stdlib/http as http
use stdlib/http.{HttpLimits, HttpParseError}
use stdlib/result.{Result}

fn start_line_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(signed, 1, 1, 1, 1, 1, 1, 1) }

fn field_line_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, signed, 1, 1, 1, 1, 1, 1) }

fn header_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, signed, 1, 1, 1, 1, 1) }

fn header_count(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, 1, signed, 1, 1, 1, 1) }

fn body_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, 1, 1, signed, 1, 1, 1) }

fn chunk_line_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, 1, 1, 1, signed, 1, 1) }

fn trailer_bytes(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, 1, 1, 1, 1, signed, 1) }

fn trailer_count(signed: i64) -> Result<HttpLimits, HttpParseError> { http.limits(1, 1, 1, 1, 1, 1, 1, signed) }

fn main() -> i64 { 0 }
