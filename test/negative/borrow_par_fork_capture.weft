use stdlib/drop.{*}
use stdlib/par as par
use stdlib/par.{*}

type BorrowParToken = opaque i64

impl Drop for BorrowParToken {
  fn drop(self) -> nil { nil }
}

fn inspect(token: borrow BorrowParToken) -> i64 { 1 }

fn bad(token: borrow BorrowParToken) -[Par]> i64 {
  let task = par.fork<i64>(() => inspect(token))
  task.join()
}
