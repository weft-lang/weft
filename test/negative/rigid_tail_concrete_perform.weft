-- set-theoretic surface: inside a fn declared -[E]>, E is universally quantified — the
-- body cannot charge a concrete perform to it. Before the fence the
-- open-tail check accepted any effect ("accept-anything arm").
effect Bar {
  fn b() -> i64
}

fn sneaky<E>(cb: () -[E]> i64) -[E]> i64 {
  Bar.b()
}

fn main() -> i64 {
  0
}
