-- Typed arms over i64 | str have no runtime test to compile to:
-- untagged unions carry no boxing (kernel §6.2, option-1 decision
-- 2026-08-03). The diagnostic teaches the fix: a variant type.
fn bad(x: i64 | str) -> i64 {
  match x {
    n: i64 -> n
    s: str -> 0
  }
}

fn main() -> i64 { 0 }
