use stdlib/vector as vector
use stdlib/vector.{*}
use stdlib/ord.{Ordering}

effect SortNoise { fn compare(left: i64, right: i64) -> Ordering }

fn noisy_compare(left: i64, right: i64) -[SortNoise]> Ordering {
  SortNoise.compare(left, right)
}

fn main() -> i64 {
  vector.new<i64>().sort_by(noisy_compare)
  0
}
