use stdlib/vector
use stdlib/result
use stdlib/par as par
use stdlib/par.{*}

fn invoke_scoped(body: () -[Par]> i64) -[Par]> i64 { body() }

fn main() -> i64 {
  let values = [40, 2]
  let view: [i64] = values[..]
  let inputs = [1]
  par.with_pool(par.pool_config(2, 4).unwrap(), () => {
    invoke_scoped(() => {
      let mapped = par.map<i64, i64>(inputs[..], x => view[0] + x)
      mapped.fold(0, (total, value) => total + value)
    })
  })
}
