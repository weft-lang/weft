use stdlib/par as par
use stdlib/par.{*}

fn invoke_scoped(body: () -[Par]> i64) -[Par]> i64 { body() }

fn main() -> i64 {
  let values = [40, 2]
  let view: [i64] = values[..]
  let inputs = [1]
  par.with_pool(2, 4, () => {
    invoke_scoped(() => vector_sum_i64(par.map<i64, i64>(inputs[..], x => view[0] + x), 0))
  })
}
