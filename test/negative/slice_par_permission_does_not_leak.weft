use "stdlib/par.weft"

fn invoke_scoped(body: () -[Par]> i64) -[Par]> i64 { body() }

fn main() -> i64 {
  let values = [40, 2]
  let view: [i64] = values[..]
  par_with_pthread_pool_i64(2, 4, () => {
    invoke_scoped(() => list_fold<i64, i64>(par_map(list_cons<i64>(1, list_nil<i64>()), x => view[0] + x), 0, (acc: i64, x: i64) => acc + x))
  })
}
