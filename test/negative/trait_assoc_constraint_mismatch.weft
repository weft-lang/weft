trait ConstraintMismatchSource {
  type Item
}

type ConstraintMismatchText { value: str }

impl ConstraintMismatchSource for ConstraintMismatchText {
  type Item = str
}

fn require_item<T, C: ConstraintMismatchSource & {type Item = T}>(value: C) -> C {
  value
}

fn main() -> i64 {
  let value = require_item<i64, ConstraintMismatchText>(ConstraintMismatchText { value: "wrong" })
  0
}
