use "stdlib/par.weft"

fn main() -> i64 {
  let values = ["not", "promoted"]
  let view: [str] = values[..]
  par_with_pthread_pool_i64(2, 4, () => {
    list_fold<i64, i64>(par_map(list_cons<i64>(1, list_nil<i64>()), x => if view[0] == "not" { x } else { 0 }), 0, (acc: i64, x: i64) => acc + x)
  })
}
