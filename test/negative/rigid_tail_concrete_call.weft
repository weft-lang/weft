-- set-theoretic surface: same rigid-tail rule for direct calls — a callee's concrete
-- effects cannot ride the caller's universally quantified tail.
effect Bar {
  fn b() -> i64
}

fn eff_fn() -[Bar]> i64 {
  Bar.b()
}

fn sneaky<E>(cb: () -[E]> i64) -[E]> i64 {
  eff_fn()
}

fn main() -> i64 {
  0
}
