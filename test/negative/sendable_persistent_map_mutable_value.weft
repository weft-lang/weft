use stdlib/map as map
use stdlib/map.{Map}
use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

-- A persistent map is Sendable only when its keys and values are.
fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn rejected() -> Map<i64, Vector<i64>> {
  require_sendable<Map<i64, Vector<i64>>>(map.new<i64, Vector<i64>>())
}

fn main() -> i64 { 0 }
