use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

-- A user type spelled like the persistent Map is not the persistent Map: its
-- mutable vector field decides its Sendable fact.
type Map {
  values: Vector<i64>
}

fn require_sendable<T: Sendable>(value: T) -> T {
  value
}

fn rejected() -> Map {
  require_sendable<Map>(Map { values: vector.new<i64>() })
}

fn main() -> i64 { 0 }
