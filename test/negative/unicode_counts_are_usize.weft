use stdlib/unicode
use stdlib/option.{Option}

fn graphemes() -> i64 { "text".grapheme_count() }
fn words() -> i64 { "text".word_segment_count() }
fn sentences() -> i64 { "text".sentence_segment_count() }
fn next_grapheme() -> Option<i64> { "text".next_grapheme_boundary(0) }
fn next_word() -> Option<i64> { "text".next_word_boundary(0) }
fn next_sentence() -> Option<i64> { "text".next_sentence_boundary(0) }
