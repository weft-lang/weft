use stdlib/bytes as bytes
use stdlib/http/transport.{HttpTransportIO, HttpTransportRelease}
use stdlib/tls/stream.{TlsStream}
use stdlib/websocket.{WebSocketText}
use stdlib/websocket/stream as websocket_stream
use stdlib/websocket/stream.{WebSocketStream, WebSocketWriteOutcome}

fn write_without_entropy(
  stream: owned WebSocketStream<TlsStream>
) -[HttpTransportIO<TlsStream>, HttpTransportRelease<TlsStream>]> WebSocketWriteOutcome<TlsStream> {
  stream.client_write_frame(true, WebSocketText, bytes.from_str("unsafe mask"))
}
