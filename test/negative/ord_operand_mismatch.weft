use stdlib/ord.{*}

type LeftRank {
  LeftRank(i64)
}

type RightRank {
  RightRank(i64)
}

impl Ord for LeftRank {
  fn compare(self: Self, other: Self) -> i64 { 0 }
}

impl Ord for RightRank {
  fn compare(self: Self, other: Self) -> i64 { 0 }
}

fn main() -> i64 {
  if LeftRank(1) < RightRank(1) { 1 } else { 0 }
}
