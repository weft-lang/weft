-- A trait method on a type-variable receiver reaches whichever implementation
-- the receiver selects; this one calls back with a larger receiver.

trait Deep {
  fn deep(self, n: i64) -> i64
}

type Box<T> { value: T }

impl<T> Deep for Box<T> {
  fn deep(self, n: i64) -> i64 { go(Box<Box<T>> { value: self }, n) }
}

fn go<T: Deep>(value: T, n: i64) -> i64 {
  if n == 0 { 0 } else { value.deep(n - 1) }
}

fn main() -> i64 { go(Box<i64> { value: 1 }, 3) }
