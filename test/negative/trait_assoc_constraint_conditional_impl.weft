trait ConditionalSource {
  type Item
}

trait ConditionalEvidence { }

type ConditionalText { value: str }
type ConditionalWrapper<T> { ConditionalWrapped(T) }

impl ConditionalSource for ConditionalText {
  type Item = str
}

impl<T: ConditionalSource & {type Item = i64}> ConditionalEvidence for ConditionalWrapper<T> { }

fn require_evidence<T: ConditionalEvidence>(value: T) -> i64 { 1 }

fn main() -> i64 {
  let wrapped = ConditionalWrapped<ConditionalText>(ConditionalText { value: "wrong" })
  require_evidence<ConditionalWrapper<ConditionalText>>(wrapped)
}
