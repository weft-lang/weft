use stdlib/iter as iter
use stdlib/task as task

fn inspect_window(window: borrow [i64]) -> i64 { window[0] }

fn capture_window(window: borrow [i64]) -[task.TaskScope]> nil {
  let child = task.spawn(() => inspect_window(window))
  child.join()
  nil
}

fn main() -> i64 {
  task.with_sequential(() => {
    match iter.each_window(iter.range(0, 3), 2, capture_window) {
      Ok(_) -> 0
      Err(_) -> 1
    }
  })
}
