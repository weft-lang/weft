-- The carried bound selects Box<T>'s implementation on every turn, and each
-- turn recurses at a Box one level deeper.

trait Deep {
  fn deep(self, n: i64) -> i64
}

type Box<T> { value: T }

impl Deep for i64 {
  fn deep(self, n: i64) -> i64 { n }
}

impl<T: Deep> Deep for Box<T> {
  fn deep(self, n: i64) -> i64 { self.value.deep(n) }
}

fn go<T: Deep>(value: T, n: i64) -> i64 {
  if n == 0 { value.deep(0) } else { go(Box<T> { value: value }, n - 1) }
}

fn main() -> i64 { go(1, 3) }
