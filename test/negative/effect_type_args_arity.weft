-- 4c (law L2): type arguments on a non-generic effect are an arity error.
-- (Pre-4a this silently parsed as the two-atom set {State, i64}; the 4a
-- fence made it loud; 4c parses args for real and validates arity.)
effect State {
  fn get() -> i64
}

fn f() -[State<i64>]> i64 {
  1
}

fn main() -> i64 {
  0
}
