-- parameterized effects (law L2): type arguments on a non-generic effect are an arity error.
-- (Previously this silently parsed as the two-atom set {State, i64}; the
-- parameterized-effect parser now validates arity.)
effect State {
  fn get() -> i64
}

fn f() -[State<i64>]> i64 {
  1
}

fn main() -> i64 {
  0
}
