-- 4c: tier 2 has no abort edge — a non-resuming clause's value launders
-- through the completion path, so it cannot compose with a return
-- clause's completion transform yet.
effect Fl {
  fn fail(e: i64) -> i64
}

fn f() -[Fl]> i64 {
  Fl.fail(1)
}

fn main() -> i64 {
  handle f() {
    Fl.fail(e) -> 0 - e
    return v -> v + 1
  }
}
