use stdlib/drop.{*}

type OwnedLinearToken {
  value: i64
}

impl Drop for OwnedLinearToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

fn consume(x: owned OwnedLinearToken) -> i64 {
  1
}

fn bad() -> i64 {
  let x: owned OwnedLinearToken = OwnedLinearToken { value: 1 }
  consume(x) + consume(x)
}
