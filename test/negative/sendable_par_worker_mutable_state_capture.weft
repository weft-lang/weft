use "stdlib/vector.weft"
use "stdlib/par.weft"

fn main() -> i64 {
  let state = vector_new<i64>()
  par_with_pthread_pool_i64(2, 4, () => {
    list_fold<i64, i64>(
      par_map(list_cons<i64>(1, list_nil<i64>()), x => x + vector_len<i64>(state)),
      0,
      (acc: i64, x: i64) => acc + x
    )
  })
}
