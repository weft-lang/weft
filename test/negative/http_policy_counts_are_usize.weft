use stdlib/http/client as client
use stdlib/http/client.{HttpConnectionPool, HttpRedirectHistory}

fn capacity() -> i64 { client.max_idle() }

fn idle(pool: borrow HttpConnectionPool<i64>) -> i64 { pool.len() }

fn history(history: HttpRedirectHistory) -> i64 { history.len() }

fn main() -> i64 { 0 }
