use stdlib/net_address.{SocketAddress}
use stdlib/tcp.{TcpConnectPolicyAllowOnly, TcpListen, tcp_listen_with_policy}
use stdlib/vector.{vector_new, vector_push}

fn connect_policy_is_not_listen_policy(address: SocketAddress) -[TcpListen]> i64 {
  let addresses = vector_new<SocketAddress>()
  vector_push<SocketAddress>(addresses, address)
  tcp_listen_with_policy(TcpConnectPolicyAllowOnly(addresses), () => 0)
}

