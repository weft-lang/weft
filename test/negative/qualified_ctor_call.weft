-- Qualified variant construction is not a language form (kernel §3.2:
-- constructors are bare values). Previously typechecked clean and
-- lowered to an unhandled dynamic perform (runtime BRK).
type Shape {
  Circle(i64),
  Rect(i64),
  Point
}

fn main() -> i64 {
  let s = Shape.Circle(7)
  match s { Circle(r) -> r, _ -> 0 }
}
