use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

fn outward<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else {
    let mut wrapped = vector.new<T>()
    wrapped.push(value)
    inward<Vector<T>>(n - 1, wrapped)
  }
}

fn inward<T>(n: i64, value: T) -> i64 { 1 + outward<T>(n, value) }

fn main() -> i64 { outward<i64>(3, 1) }
