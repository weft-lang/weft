use stdlib/websocket as websocket
use stdlib/websocket.{WebSocketLimits, WebSocketError}
use stdlib/result.{Result}

fn frame_limit(signed: i64) -> Result<WebSocketLimits, WebSocketError> { websocket.limits(signed, 1) }

fn message_limit(signed: i64) -> Result<WebSocketLimits, WebSocketError> { websocket.limits(1, signed) }

fn main() -> i64 { 0 }
