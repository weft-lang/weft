type UniqueBorrowAfterMoveBox { value: i64 }

impl UniqueBorrowAfterMoveBox {
  fn observe(self: borrow Self) -> i64 {
    self.value
  }

  fn finish(self: unique Self) -> i64 {
    self.value
  }
}

fn main() -> i64 {
  let value: unique UniqueBorrowAfterMoveBox = UniqueBorrowAfterMoveBox { value: 41 }
  value.finish() + value.observe()
}
