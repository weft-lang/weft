use stdlib/vector as vector
use stdlib/vector/handles.{Vector}

-- Each independent growing recursion is reported once.
type Wrap<T> { inner: T }

fn widen<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else {
    let mut wrapped = vector.new<T>()
    wrapped.push(value)
    1 + widen<Vector<T>>(n - 1, wrapped)
  }
}

fn deepen<T>(n: i64, value: T) -> i64 {
  if n == 0 { 0 } else { 1 + deepen<Wrap<T>>(n - 1, Wrap<T> { inner: value }) }
}

fn main() -> i64 { widen<i64>(3, 1) + deepen<i64>(3, 1) }
