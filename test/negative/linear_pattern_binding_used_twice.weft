use stdlib/drop.{*}

type LinearPatternTwiceToken {
  value: i64
}

impl Drop for LinearPatternTwiceToken {
  fn drop(self: i64) -> i64 {
    0
  }
}

type LinearPatternTwiceChoice {
  LinearPatternTwiceEmpty,
  LinearPatternTwiceHeld(owned LinearPatternTwiceToken)
}

fn consume(value: owned LinearPatternTwiceToken) -> i64 {
  1
}

fn bad() -> i64 {
  let held: LinearPatternTwiceChoice = LinearPatternTwiceHeld(LinearPatternTwiceToken { value: 1 })
  match held {
    LinearPatternTwiceHeld(token) -> consume(token) + consume(token)
    LinearPatternTwiceEmpty -> 0
  }
}
