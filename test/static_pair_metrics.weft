use "runtime/memory.weft"
-- test/static_pair_metrics.weft -- native evidence for static closure
-- pairs (2q slice 1): named-fn value sites share hash-keyed data slots
-- instead of allocating per execution. The runtime prelude and the
-- indirect-call helper machinery contribute their own named-fn value
-- sites, so assertions are deltas against a baseline that has the same
-- fn-typed-parameter shape but passes a lambda (no named-fn slot).

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn static_pair_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn static_pair_metric_slots(src: str) -> i64 {
  pipeline_native_static_pair_slot_count(static_pair_metric_native(src))
}

fn static_pair_metric_sites(src: str) -> i64 {
  pipeline_native_static_pair_site_count(static_pair_metric_native(src))
}

fn static_pair_baseline_slots() -> i64 {
  static_pair_metric_slots("fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(x => x + 1, 1) }")
}

fn static_pair_baseline_sites() -> i64 {
  static_pair_metric_sites("fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(x => x + 1, 1) }")
}

test "static_pair_metrics_single_site_reserves_one_slot" {
  let slots = static_pair_metric_slots("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) }")
  let sites = static_pair_metric_sites("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) }")
  Test.assert_eq(slots - static_pair_baseline_slots(), 1)
  Test.assert_eq(sites - static_pair_baseline_sites(), 1)
}

test "static_pair_metrics_two_sites_same_callee_share_slot" {
  let slots = static_pair_metric_slots("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) + ap(h, 2) }")
  let sites = static_pair_metric_sites("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) + ap(h, 2) }")
  Test.assert_eq(slots - static_pair_baseline_slots(), 1)
  Test.assert_eq(sites - static_pair_baseline_sites(), 2)
}

test "static_pair_metrics_distinct_callees_distinct_slots" {
  let slots = static_pair_metric_slots("fn h(x: i64) -> i64 { x + 1 } fn g(x: i64) -> i64 { x * 2 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) + ap(g, 2) }")
  let sites = static_pair_metric_sites("fn h(x: i64) -> i64 { x + 1 } fn g(x: i64) -> i64 { x * 2 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(h, 1) + ap(g, 2) }")
  Test.assert_eq(slots - static_pair_baseline_slots(), 2)
  Test.assert_eq(sites - static_pair_baseline_sites(), 2)
}

test "static_pair_metrics_lambda_site_reserves_no_slot" {
  -- Lambdas keep their per-instance pair path; only named-fn refs use
  -- static slots in slice 1. A second lambda site adds no slot.
  let slots = static_pair_metric_slots("fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { ap(x => x + 1, 1) + ap(x => x + 2, 1) }")
  Test.assert_eq(slots - static_pair_baseline_slots(), 0)
}

test "static_pair_metrics_loop_site_counts_once" {
  -- The site count is an emission-time metric: a loop body emits one
  -- site regardless of how many times it executes.
  let slots = static_pair_metric_slots("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { let mut acc = 0 let mut i = 0 while i < 10 { acc = ap(h, acc) i = i + 1 } acc }")
  let sites = static_pair_metric_sites("fn h(x: i64) -> i64 { x + 1 } fn ap(f: (i64) -> i64, v: i64) -> i64 { f(v) } fn main() -> i64 { let mut acc = 0 let mut i = 0 while i < 10 { acc = ap(h, acc) i = i + 1 } acc }")
  Test.assert_eq(slots - static_pair_baseline_slots(), 1)
  Test.assert_eq(sites - static_pair_baseline_sites(), 1)
}

test "static_pair_metrics_baseline_prelude_deterministic" {
  -- Identical programs must produce identical counts (emission
  -- determinism over the runtime prelude's own named-fn sites).
  Test.assert_eq(static_pair_baseline_slots(), static_pair_baseline_slots())
  Test.assert_eq(static_pair_baseline_sites(), static_pair_baseline_sites())
}
