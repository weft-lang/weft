use compiler/pipeline.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use runtime/effects.{continuation_cleanup_kind_rc}

test "unknown array mutation plans cannot lower storage operations" {
  let lowered = pipeline_lower_array_mutation_storage(PipelineArrayMutationUnavailable, 3, 7)
  Test.assert_eq(ir_lowered_expr_is_valid(lowered), 0)
}

test "array mutation preparation publishes one transported owner and data view" {
  let lowered = pipeline_lower_array_mutation_storage(PipelineArrayMutation(100, 24, 8), 3, 7)
  Test.assert_eq(ir_lowered_expr_is_valid(lowered), 1)
  Test.assert_eq(ir_lowered_expr_value(lowered), 9)
  Test.assert_eq(ir_lowered_expr_next_value(lowered), 11)
  let prefix = IrInstCons(IrConstI64(3, 0), IrInstCons(IrSlotI64(100),
    IrInstCons(IrStoreI64(100, 3), ir_lowered_expr_insts(lowered))))
  let body = IrBlock(0, IrValueNil, prefix, IrTermReturn(9))
  Test.assert_eq(pipeline_ir_verify_function(IrFunction(701, 0, IrBlockListCons(body, IrBlockListNil), 0)), 0)
}

test "array mutation results do not claim a fresh allocation obligation" {
  Test.assert_eq(pipeline_ir_native_fresh_managed_alloc_hash(pipeline_rc_array_storage_prepare_mutation_hash()), 0)
  Test.assert_eq(pipeline_ir_abort_cleanup_call_result_lane_release_hash(
    pipeline_rc_array_storage_prepare_mutation_hash(), 0, 0), 0)
}

test "array allocation leaves preserve their cleanup obligation through constructor inlining" {
  for name in ["rc_array_storage_new", "rc_array_storage_new_from_data"] {
    let hash = pipeline_ir_native_hash_name(name)
    let insts = IrInstCons(IrCallI64(6, hash, IrValueNil), IrInstNil)
    let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(6)), IrBlockListNil)
    let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0, 0)
    let acquired = pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 6, pipeline_ir_abort_cleanup_direct_kind())
    Test.assert_true(acquired != 0)
    Test.assert_eq(pipeline_ir_abort_cleanup_call_result_lane_release_hash(hash, 0, 1), 0)
    Test.assert_eq(pipeline_ir_native_fresh_managed_alloc_hash(hash), 1)
  }
}

test "array owner rebinding carries both old and new SSA values" {
  let inst = IrManagedSlotI64(-1, 7, 100, continuation_cleanup_kind_rc(), IrManagedSlotRebind(3))
  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 3), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)
  Test.assert_eq(ir_managed_slot_previous_or(IrManagedSlotRebind(3), 0), 3)
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 3, 2), 7, 6)
  match pipeline_ir_rewrite_inst_uses(inst, aliases) {
    IrManagedSlotI64(_, current, slot, _, IrManagedSlotRebind(previous)) -> {
      Test.assert_eq(current, 6)
      Test.assert_eq(previous, 2)
      Test.assert_eq(slot, 100)
    }
    _ -> Test.assert_true(false)
  }
}

test "array rebinding keeps one canonical handler cleanup record" {
  let kind = continuation_cleanup_kind_rc()
  let insts = IrInstCons(IrCallI64(0, pipeline_ir_abort_cleanup_rc_alloc_hash(), IrValueNil),
    IrInstCons(IrSlotI64(100), IrInstCons(IrStoreI64(100, 0),
    IrInstCons(IrManagedSlotI64(-1, 0, 100, kind, IrManagedSlotAcquire),
    IrInstCons(IrLoadI64(2, 100),
    IrInstCons(IrCallI64(3, pipeline_rc_array_storage_prepare_mutation_hash(), IrValueCons(2, IrValueNil)),
    IrInstCons(IrStoreI64(100, 3),
    IrInstCons(IrManagedSlotI64(-1, 3, 100, kind, IrManagedSlotRebind(2)),
    IrInstCons(IrLoadI64(4, 100),
    IrInstCons(IrManagedSlotI64(5, 4, 100, kind, IrManagedSlotRelease), IrInstNil))))))))))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(5)), IrBlockListNil)
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0, 0)
  let before = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 2)
  let after = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 4)
  Test.assert_true(before != 0 and after != 0)
  Test.assert_eq(pipeline_ir_abort_cleanup_fact_record_index(before), pipeline_ir_abort_cleanup_fact_record_index(after))
  Test.assert_eq(pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 3, pipeline_ir_abort_cleanup_direct_kind()), 0)
}
