type GList<T> {
  GNil,
  GCons(T, GList<T>)
}

type GResult<T, E> {
  GOk(T),
  GErr(E)
}

-- Nested annotations inside a generic body resolve the signature's type
-- variables: lambda parameters and destructuring bindings alike.
fn typed_lambda_param<T>(value: T) -> T {
  let keep = (kept: T, count: i64) => kept
  keep(value, 1)
}

fn typed_binding_first<T>(pair: (T, i64)) -> T {
  let (first: T, second) = pair
  first
}

test "generic_typed_lambda_parameter_resolves_type_variable" {
  Test.assert_eq(typed_lambda_param(41) + 1, 42)
  Test.assert_eq(match typed_lambda_param(GCons(7, GNil)) { GCons(v, _) -> v, GNil -> 0 }, 7)
}

test "generic_typed_destructuring_binding_resolves_type_variable" {
  Test.assert_eq(typed_binding_first((5, 9)), 5)
  Test.assert_eq(
    match typed_binding_first((GCons(3, GNil), 1)) { GCons(v, _) -> v, GNil -> 0 },
    3
  )
}

fn gl_head(xs: GList<i64>) -> i64 {
  match xs { GCons(v, rest) -> v GNil -> 0 }
}

fn result_value(r: GResult<i64, str>) -> i64 {
  match r { GOk(v) -> v GErr(e) -> 0 }
}

test "generic_variant_multi_payload" {
  let xs: GList<i64> = GCons<i64>(42, GNil<i64>())
  Test.assert_eq(gl_head(xs), 42)
}

test "generic_variant_two_params" {
  let r: GResult<i64, str> = GOk<i64, str>(42)
  Test.assert_eq(result_value(r), 42)
}
