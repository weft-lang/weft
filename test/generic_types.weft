type GList<T> {
  GNil,
  GCons(T, GList<T>)
}

type GResult<T, E> {
  GOk(T),
  GErr(E)
}

fn gl_head(xs: GList<i64>) -> i64 {
  match xs { GCons(v, rest) -> v GNil -> 0 }
}

fn result_value(r: GResult<i64, str>) -> i64 {
  match r { GOk(v) -> v GErr(e) -> 0 }
}

test "generic_variant_multi_payload" {
  let xs: GList<i64> = GCons<i64>(42, GNil<i64>())
  Test.assert_eq(gl_head(xs), 42)
}

test "generic_variant_two_params" {
  let r: GResult<i64, str> = GOk<i64, str>(42)
  Test.assert_eq(result_value(r), 42)
}
