-- abort edge: a non-resuming clause abandons the computation and delivers its
-- value to the handle result. These are deliberately non-tail perform shapes:
-- before the abort edge they returned to the perform site and executed the
-- sentinel arithmetic below.

use runtime/rc_implicit_test.{*}
use runtime/defer_order_test.{*}
use stdlib/drop.{Drop}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

effect AbortEdge {
  fn stop(value: i64) -> i64
  fn read() -> i64
}

effect AbortInner {
  fn get() -> i64
}

effect AbortDropOwner {
  fn release(log: i64, digit: i64) -> i64
}

type AbortEffectfulDropToken {
  log: i64,
  digit: i64
}

type AbortGenericEffectfulDropToken<T> {
  AbortGenericEffectfulDropValue(i64, i64, T)
}

type AbortGenericDropOutcome<T> {
  AbortGenericDropFailed(owned AbortGenericEffectfulDropToken<T>, i64)
}

type AbortOpaqueEffectfulDropToken<T> = opaque(owned AbortGenericEffectfulDropToken<T>, i64)

type AbortOpaqueDropOutcome<T> {
  AbortOpaqueDropFailed(owned AbortOpaqueEffectfulDropToken<T>, i64)
}

type AbortNestedOpaqueEffectfulDropToken<T> = opaque(owned AbortOpaqueEffectfulDropToken<T>, i64)

impl Drop for AbortEffectfulDropToken {
  fn drop(self) -[AbortDropOwner]> i64 {
    AbortDropOwner.release(self.log, self.digit)
  }
}

impl<T> Drop for AbortGenericEffectfulDropToken<T> {
  fn drop(self) -[AbortDropOwner]> i64 {
    match self {
      AbortGenericEffectfulDropValue(log, digit, value) -> AbortDropOwner.release(log, digit)
    }
  }
}

impl<T> Drop for AbortOpaqueEffectfulDropToken<T> {
  fn drop(self: AbortOpaqueEffectfulDropToken<T>) -[AbortDropOwner]> i64 {
    match self {
      AbortOpaqueEffectfulDropToken((token, code)) -> token.drop()
    }
  }
}

impl<T> Drop for AbortNestedOpaqueEffectfulDropToken<T> {
  fn drop(self: AbortNestedOpaqueEffectfulDropToken<T>) -[AbortDropOwner]> i64 {
    match self {
      AbortNestedOpaqueEffectfulDropToken((token, code)) -> token.drop()
    }
  }
}

fn abort_with_effectful_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let token: owned AbortEffectfulDropToken = AbortEffectfulDropToken { log: log, digit: 7 }
  AbortEdge.stop(42) + 1000
}

fn abort_under_drop_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_with_effectful_drop(log) {
    AbortDropOwner.release(target, digit) -> resume(defer_order_log_write(target, digit))
  }
}

fn abort_after_effectful_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let token: owned AbortEffectfulDropToken = AbortEffectfulDropToken { log: log, digit: 7 }
  let dropped = token.drop()
  AbortEdge.stop(42) + dropped + 1000
}

fn abort_after_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_effectful_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_generic_effectful_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let token: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 8, 42)
  let dropped = token.drop()
  AbortEdge.stop(43) + dropped + 1000
}

fn abort_after_generic_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_generic_effectful_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_matched_generic_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let outcome: AbortGenericDropOutcome<i64> = AbortGenericDropFailed<i64>(
    AbortGenericEffectfulDropValue<i64>(log, 9, 42),
    17
  )
  match outcome {
    AbortGenericDropFailed(returned, code) -> {
      let dropped = returned.drop()
      AbortEdge.stop(44) + dropped + code + 1000
    }
  }
}

fn abort_after_matched_generic_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_matched_generic_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_generic_drop_round_trip<T>(
  token: owned AbortGenericEffectfulDropToken<T>
) -[AbortDropOwner]> AbortGenericDropOutcome<T> {
  AbortGenericDropFailed<T>(token, 18)
}

fn abort_after_generic_call_matched_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let token: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 1, 42)
  match abort_generic_drop_round_trip<i64>(token) {
    AbortGenericDropFailed(returned, code) -> {
      let dropped = returned.drop()
      AbortEdge.stop(45) + dropped + code + 1000
    }
  }
}

fn abort_after_generic_call_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_generic_call_matched_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_opaque_matched_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let inner: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 2, 42)
  let token: owned AbortOpaqueEffectfulDropToken<i64> = AbortOpaqueEffectfulDropToken<i64>((inner, 19))
  let outcome: AbortOpaqueDropOutcome<i64> = AbortOpaqueDropFailed<i64>(token, 20)
  match outcome {
    AbortOpaqueDropFailed(returned, code) -> {
      let dropped = returned.drop()
      AbortEdge.stop(46) + dropped + code + 1000
    }
  }
}

fn abort_after_opaque_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_opaque_matched_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_opaque_construction(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let inner: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 2, 42)
  let token: owned AbortOpaqueEffectfulDropToken<i64> = AbortOpaqueEffectfulDropToken<i64>((inner, 19))
  AbortEdge.stop(47) + 1000
}

fn abort_after_opaque_construction_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_opaque_construction(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_direct_opaque_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let inner: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 2, 42)
  let token: owned AbortOpaqueEffectfulDropToken<i64> = AbortOpaqueEffectfulDropToken<i64>((inner, 19))
  let dropped = token.drop()
  AbortEdge.stop(48) + dropped + 1000
}

fn abort_after_direct_opaque_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_direct_opaque_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_after_direct_nested_opaque_drop(log: i64) -[AbortEdge, AbortDropOwner]> i64 {
  let inner: owned AbortGenericEffectfulDropToken<i64> = AbortGenericEffectfulDropValue<i64>(log, 2, 42)
  let first: owned AbortOpaqueEffectfulDropToken<i64> = AbortOpaqueEffectfulDropToken<i64>((inner, 19))
  let second: owned AbortNestedOpaqueEffectfulDropToken<i64> = AbortNestedOpaqueEffectfulDropToken<i64>((first, 20))
  let dropped = second.drop()
  AbortEdge.stop(49) + dropped + 1000
}

fn abort_after_direct_nested_opaque_drop_under_handler(log: i64) -[AbortEdge]> i64 {
  handle abort_after_direct_nested_opaque_drop(log) {
    AbortDropOwner.release(target, digit) -> {
      defer_order_log_write(target, defer_order_log_read(target) * 10 + digit)
      resume(0)
    }
  }
}

fn abort_leaf(value: i64) -[AbortEdge]> i64 {
  let resumed = AbortEdge.stop(value)
  resumed + 1000
}

fn abort_depth2(value: i64) -[AbortEdge]> i64 {
  abort_leaf(value) + 100
}

fn abort_depth3(value: i64) -[AbortEdge]> i64 {
  abort_depth2(value) + 10
}

fn abort_in_if(flag: bool, value: i64) -[AbortEdge]> i64 {
  if flag {
    let resumed = AbortEdge.stop(value)
    resumed + 2000
  } else {
    7
  }
}

fn abort_in_match(value: i64) -[AbortEdge]> i64 {
  match value {
    0 -> 5
    _ -> {
      let resumed = AbortEdge.stop(value)
      resumed + 3000
    }
  }
}

fn abort_with_managed_local(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let held: RuntimeRcProbe = payload
  let resumed = AbortEdge.stop(42)
  runtime_rc_probe_count(held) + resumed + 1000
}

fn resume_with_managed_local(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let held: RuntimeRcProbe = payload
  AbortEdge.read() + runtime_rc_probe_count(held)
}

fn abort_with_owned_inner(log: i64) -[AbortEdge]> i64 {
  let inner: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  let resumed = AbortEdge.stop(42)
  resumed + 1000
}

fn abort_with_owned_depth(log: i64) -[AbortEdge]> i64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  abort_with_owned_inner(log) + 100
}

fn abort_with_managed_branch(payload: RuntimeRcProbe, left: bool) -[AbortEdge]> i64 {
  if left {
    let held_left: RuntimeRcProbe = payload
    AbortEdge.stop(41) + runtime_rc_probe_count(held_left) + 1000
  } else {
    let held_right: RuntimeRcProbe = payload
    AbortEdge.stop(42) + runtime_rc_probe_count(held_right) + 1000
  }
}

fn abort_with_managed_mut(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let mut held: RuntimeRcProbe = payload
  let resumed = AbortEdge.stop(42)
  resumed + runtime_rc_probe_count(held) + 1000
}

fn abort_owned_loop(log: i64) -[AbortEdge]> i64 {
  let mut i = 1
  while i <= 3 {
    let token: owned OwnedAbortToken = owned_abort_token_new(log, i)
    if i == 3 { AbortEdge.stop(42) + 1000 } else { 0 }
    i = i + 1
  }
  0
}

fn abort_pair_consume(payload: RuntimeRcProbe, value: i64) -> i64 {
  runtime_rc_probe_count(payload) + value
}

fn abort_during_second_argument() -[AbortEdge]> i64 {
  abort_pair_consume(runtime_rc_probe_new(0), abort_leaf(42))
}

fn abort_temporary_once() -> i64 {
  handle abort_during_second_argument() {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
}

fn abort_owned_pair_consume(token: owned OwnedAbortToken, value: i64) -> i64 {
  value
}

fn abort_owned_during_second_argument(log: i64) -[AbortEdge]> i64 {
  abort_owned_pair_consume(owned_abort_token_new(log, 7), abort_leaf(42))
}

type AbortManagedOwnerBox {
  value: RuntimeRcProbe
}

type AbortManagedOwnerChoice {
  AbortManagedOwnerValue(RuntimeRcProbe),
  AbortManagedOwnerEmpty
}

fn abort_completed_owning_call(payload: RuntimeRcProbe) -> i64 {
  let box = AbortManagedOwnerBox { value: payload }
  runtime_rc_probe_load(box.value)
}

fn abort_after_completed_owning_call(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  abort_completed_owning_call(payload)
  AbortEdge.stop(42) + 1000
}

fn abort_completed_variant_call(payload: RuntimeRcProbe) -> i64 {
  let choice = AbortManagedOwnerValue(payload)
  match choice {
    AbortManagedOwnerValue(value) -> runtime_rc_probe_load(value)
    AbortManagedOwnerEmpty -> 0
  }
}

fn abort_after_completed_variant_call(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  abort_completed_variant_call(payload)
  AbortEdge.stop(42) + 1000
}

fn abort_after_completed_local_transfer(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let held: RuntimeRcProbe = payload
  abort_completed_owning_call(held)
  AbortEdge.stop(42) + 1000
}

fn abort_after_vector_mutation(values: Vector<i64>) -[AbortEdge]> i64 {
  vector_push<i64>(values, 73)
  AbortEdge.stop(42) + 1000
}

test "abort_edge_static_direct_non_tail" {
  let got = handle { AbortEdge.stop(41) + 1000 } {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_nested_callee_non_tail" {
  let got = handle abort_leaf(42) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_depth_two_and_three" {
  let depth2 = handle abort_depth2(20) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  let depth3 = handle abort_depth3(20) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(depth2, 21)
  Test.assert_eq(depth3, 22)
}

test "abort_edge_from_if_arms" {
  let aborted = handle abort_in_if(true, 31) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  let completed = handle abort_in_if(false, 31) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(aborted, 32)
  Test.assert_eq(completed, 7)
}

test "abort_edge_from_match_arm" {
  let aborted = handle abort_in_match(40) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  let completed = handle abort_in_match(0) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(aborted, 42)
  Test.assert_eq(completed, 5)
}

test "abort_edge_clause_nested_handler_keeps_outer_frame" {
  -- The inner dispatch overwrites runtime state's shared frame slot. The
  -- outer abortive clause must use the frame snapshot from its own prologue.
  let got = handle abort_leaf(35) {
    AbortEdge.stop(value) -> handle AbortInner.get() {
      AbortInner.get() -> resume(value + 7)
    }
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_resuming_clause_stays_resumptive" {
  let got = handle { AbortEdge.read() + 2 } {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(40)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_releases_managed_bindings_across_call_frames" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle abort_with_managed_local(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  -- The caller's count survives the handle boundary; the callee parameter
  -- and lexical alias are both unwound by the abort edge.
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_resumption_keeps_ordinary_managed_cleanup_exactly_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle resume_with_managed_local(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(40)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_runs_owned_drop_in_dynamic_lifo_order" {
  let log = defer_order_log_new()
  let got = handle abort_with_owned_depth(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "abort_edge_keeps_inner_handler_available_to_effectful_drop" {
  let log = defer_order_log_new()
  let got = handle abort_under_drop_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "abort_edge_does_not_repeat_an_effectful_drop_completed_before_abort" {
  let log = defer_order_log_new()
  let got = handle abort_after_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "abort_edge_does_not_repeat_a_generic_effectful_drop_completed_before_abort" {
  let log = defer_order_log_new()
  let got = handle abort_after_generic_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 43)
  Test.assert_eq(defer_order_log_read(log), 8)
}

test "abort_edge_does_not_repeat_a_matched_generic_effectful_drop" {
  let log = defer_order_log_new()
  let got = handle abort_after_matched_generic_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 44)
  Test.assert_eq(defer_order_log_read(log), 9)
}

test "abort_edge_does_not_repeat_a_generic_call_result_drop" {
  let log = defer_order_log_new()
  let got = handle abort_after_generic_call_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 45)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "abort_edge_does_not_repeat_an_opaque_generic_drop" {
  let log = defer_order_log_new()
  let got = handle abort_after_opaque_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 46)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "abort_edge_rewraps_an_opaque_owner_exactly_once" {
  let log = defer_order_log_new()
  let got = handle abort_after_opaque_construction_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 47)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "abort_edge_does_not_repeat_a_direct_opaque_drop" {
  let log = defer_order_log_new()
  let got = handle abort_after_direct_opaque_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 48)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "abort_edge_does_not_repeat_a_nested_opaque_drop" {
  let log = defer_order_log_new()
  let got = handle abort_after_direct_nested_opaque_drop_under_handler(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 49)
  Test.assert_eq(defer_order_log_read(log), 2)
}

test "abort_edge_managed_cleanup_tracks_mutually_exclusive_bindings" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let left = handle abort_with_managed_branch(payload, true) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  let right = handle abort_with_managed_branch(payload, false) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(left, 41)
  Test.assert_eq(right, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_releases_mutable_managed_slot" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle abort_with_managed_mut(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_reused_owned_loop_record_drops_each_iteration_once" {
  let log = defer_order_log_new()
  let got = handle abort_owned_loop(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 123)
}

test "abort_edge_reclaims_temporary_created_before_later_argument_aborts" {
  let mut warm = 0
  while warm < 20 {
    abort_temporary_once()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 200 {
    Test.assert_eq(abort_temporary_once(), 42)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "abort_edge_drops_owned_temporary_created_before_later_argument_aborts" {
  let log = defer_order_log_new()
  let got = handle abort_owned_during_second_argument(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "abort_edge_does_not_resurrect_completed_managed_transport" {
  let payload = runtime_rc_probe_new(42)
  let got = handle abort_after_completed_owning_call(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_load(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_commits_variant_payload_before_parameter_cleanup" {
  let payload = runtime_rc_probe_new(42)
  let got = handle abort_after_completed_variant_call(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_load(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_commits_last_use_local_transport_once" {
  let payload = runtime_rc_probe_new(42)
  let got = handle abort_after_completed_local_transfer(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_load(payload), 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_preserves_vector_mutation_from_completed_call" {
  let values = vector.with_capacity<i64>(1)
  let got = handle abort_after_vector_mutation(values) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 0), 73)
}
