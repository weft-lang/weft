-- 4j J2b: a non-resuming clause abandons the computation and delivers its
-- value to the handle result. These are deliberately non-tail perform shapes:
-- before the abort edge they returned to the perform site and executed the
-- sentinel arithmetic below.

use runtime/rc_implicit_test.{*}
use runtime/defer_order_test.{*}

effect AbortEdge {
  fn stop(value: i64) -> i64
  fn read() -> i64
}

effect AbortInner {
  fn get() -> i64
}

fn abort_leaf(value: i64) -[AbortEdge]> i64 {
  let resumed = AbortEdge.stop(value)
  resumed + 1000
}

fn abort_depth2(value: i64) -[AbortEdge]> i64 {
  abort_leaf(value) + 100
}

fn abort_depth3(value: i64) -[AbortEdge]> i64 {
  abort_depth2(value) + 10
}

fn abort_in_if(flag: bool, value: i64) -[AbortEdge]> i64 {
  if flag {
    let resumed = AbortEdge.stop(value)
    resumed + 2000
  } else {
    7
  }
}

fn abort_in_match(value: i64) -[AbortEdge]> i64 {
  match value {
    0 -> 5
    _ -> {
      let resumed = AbortEdge.stop(value)
      resumed + 3000
    }
  }
}

fn abort_with_managed_local(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let held: RuntimeRcProbe = payload
  let resumed = AbortEdge.stop(42)
  runtime_rc_probe_count(held) + resumed + 1000
}

fn resume_with_managed_local(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let held: RuntimeRcProbe = payload
  AbortEdge.read() + runtime_rc_probe_count(held)
}

fn abort_with_owned_inner(log: i64) -[AbortEdge]> i64 {
  let inner: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  let resumed = AbortEdge.stop(42)
  resumed + 1000
}

fn abort_with_owned_depth(log: i64) -[AbortEdge]> i64 {
  let outer: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  abort_with_owned_inner(log) + 100
}

fn abort_with_managed_branch(payload: RuntimeRcProbe, left: bool) -[AbortEdge]> i64 {
  if left {
    let held_left: RuntimeRcProbe = payload
    AbortEdge.stop(41) + runtime_rc_probe_count(held_left) + 1000
  } else {
    let held_right: RuntimeRcProbe = payload
    AbortEdge.stop(42) + runtime_rc_probe_count(held_right) + 1000
  }
}

fn abort_with_managed_mut(payload: RuntimeRcProbe) -[AbortEdge]> i64 {
  let mut held: RuntimeRcProbe = payload
  let resumed = AbortEdge.stop(42)
  resumed + runtime_rc_probe_count(held) + 1000
}

fn abort_owned_loop(log: i64) -[AbortEdge]> i64 {
  let mut i = 1
  while i <= 3 {
    let token: owned OwnedAbortToken = owned_abort_token_new(log, i)
    if i == 3 { AbortEdge.stop(42) + 1000 } else { 0 }
    i = i + 1
  }
  0
}

fn abort_pair_consume(payload: RuntimeRcProbe, value: i64) -> i64 {
  runtime_rc_probe_count(payload) + value
}

fn abort_during_second_argument() -[AbortEdge]> i64 {
  abort_pair_consume(runtime_rc_probe_new(0), abort_leaf(42))
}

fn abort_temporary_once() -> i64 {
  handle abort_during_second_argument() {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
}

fn abort_owned_pair_consume(token: owned OwnedAbortToken, value: i64) -> i64 {
  value
}

fn abort_owned_during_second_argument(log: i64) -[AbortEdge]> i64 {
  abort_owned_pair_consume(owned_abort_token_new(log, 7), abort_leaf(42))
}

test "abort_edge_static_direct_non_tail" {
  let got = handle { AbortEdge.stop(41) + 1000 } {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_nested_callee_non_tail" {
  let got = handle abort_leaf(42) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_depth_two_and_three" {
  let depth2 = handle abort_depth2(20) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  let depth3 = handle abort_depth3(20) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(depth2, 21)
  Test.assert_eq(depth3, 22)
}

test "abort_edge_from_if_arms" {
  let aborted = handle abort_in_if(true, 31) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  let completed = handle abort_in_if(false, 31) {
    AbortEdge.stop(value) -> value + 1
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(aborted, 32)
  Test.assert_eq(completed, 7)
}

test "abort_edge_from_match_arm" {
  let aborted = handle abort_in_match(40) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  let completed = handle abort_in_match(0) {
    AbortEdge.stop(value) -> value + 2
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(aborted, 42)
  Test.assert_eq(completed, 5)
}

test "abort_edge_clause_nested_handler_keeps_outer_frame" {
  -- The inner dispatch overwrites runtime state's shared frame slot. The
  -- outer abortive clause must use the frame snapshot from its own prologue.
  let got = handle abort_leaf(35) {
    AbortEdge.stop(value) -> handle AbortInner.get() {
      AbortInner.get() -> resume(value + 7)
    }
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_resuming_clause_stays_resumptive" {
  let got = handle { AbortEdge.read() + 2 } {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(40)
  }
  Test.assert_eq(got, 42)
}

test "abort_edge_releases_managed_bindings_across_call_frames" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle abort_with_managed_local(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  -- The caller's count survives the handle boundary; the callee parameter
  -- and lexical alias are both unwound by the abort edge.
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_resumption_keeps_ordinary_managed_cleanup_exactly_once" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle resume_with_managed_local(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(40)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_runs_owned_drop_in_dynamic_lifo_order" {
  let log = defer_order_log_new()
  let got = handle abort_with_owned_depth(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 21)
}

test "abort_edge_managed_cleanup_tracks_mutually_exclusive_bindings" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let left = handle abort_with_managed_branch(payload, true) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  let right = handle abort_with_managed_branch(payload, false) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(left, 41)
  Test.assert_eq(right, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_releases_mutable_managed_slot" {
  let payload: RuntimeRcProbe = runtime_rc_probe_new(0)
  let got = handle abort_with_managed_mut(payload) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "abort_edge_reused_owned_loop_record_drops_each_iteration_once" {
  let log = defer_order_log_new()
  let got = handle abort_owned_loop(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 123)
}

test "abort_edge_reclaims_temporary_created_before_later_argument_aborts" {
  let mut warm = 0
  while warm < 20 {
    abort_temporary_once()
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut i = 0
  while i < 200 {
    Test.assert_eq(abort_temporary_once(), 42)
    i = i + 1
  }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
}

test "abort_edge_drops_owned_temporary_created_before_later_argument_aborts" {
  let log = defer_order_log_new()
  let got = handle abort_owned_during_second_argument(log) {
    AbortEdge.stop(value) -> value
    AbortEdge.read() -> resume(0)
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}
