-- test/spawn_emission_metrics.weft -- native evidence for scoped Par lowering

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn spawn_metric_u32_at(p: i64) -> i64 {
  __mem_load8(p) +
  __mem_load8(p + 1) * 256 +
  __mem_load8(p + 2) * 65536 +
  __mem_load8(p + 3) * 16777216
}

fn spawn_metric_next_offset(fm: i64, off: i64, fallback: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = fallback
  while i < n {
    let entry_off = __mem_load64(d + i * 40 + 16)
    if entry_off > off and entry_off < result {
      result = entry_off
    } else { 0 }
    i = i + 1
  }
  result
}

fn spawn_metric_count_bl_to_target(code: i64, start: i64, end: i64, target: i64) -> i64 {
  let p = buf_ptr(code)
  let mut i = start
  let mut count = 0
  while i + 4 <= end {
    if spawn_metric_u32_at(p + i) == encode_bl(target - i) {
      count = count + 1
    } else { 0 }
    i = i + 4
  }
  count
}

fn spawn_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn spawn_metric_lowerings(src: str) -> i64 {
  pipeline_native_par_lowering_count(spawn_metric_native(src))
}

fn spawn_metric_call_sites(src: str, fn_name: str, target_name: str) -> i64 {
  let native = spawn_metric_native(src)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let off = fmap_lookup(fm, __str_ptr(fn_name), 0, __str_len(fn_name))
  let end = spawn_metric_next_offset(fm, off, buf_len(code))
  let target = fmap_lookup(fm, __str_ptr(target_name), 0, __str_len(target_name))
  spawn_metric_count_bl_to_target(code, off, end, target)
}

test "spawn_emission_metric_sequential_literal_lowers" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_pthread_pool_start(workers: i64, capacity: i64) -> i64 { 1 } fn par_pthread_pool_submit(pool: i64, f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_pthread_pool_await(h: i64) -> i64 { h } fn par_pthread_pool_shutdown(pool: i64) -> i64 { 0 } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn par_with_pthread_pool_i64(workers: i64, capacity: i64, body: () -[Par]> i64) -> i64 { let pool = par_pthread_pool_start(workers, capacity) if pool == 0 { par_with_sequential_i64(body) } else { let result = handle body() { Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg)) Par.await(h) -> resume(par_pthread_pool_await(h)) } par_pthread_pool_shutdown(pool) result } } fn main() -> i64 { par_with_sequential_i64(() => { let h = Par.spawn(metric_inc, 41) Par.await(h) }) }"
  Test.assert_eq(spawn_metric_lowerings(src), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_sequential_submit"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_task_await"), 1)
}

test "spawn_emission_metric_pthread_literal_lowers_with_fallback" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_pthread_pool_start(workers: i64, capacity: i64) -> i64 { if workers == 0 { 0 } else { 1 } } fn par_pthread_pool_submit(pool: i64, f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_pthread_pool_submit_prepared(pool: i64, f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_pthread_pool_await(h: i64) -> i64 { h } fn par_pthread_pool_shutdown(pool: i64) -> i64 { 0 } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn par_with_pthread_pool_i64(workers: i64, capacity: i64, body: () -[Par]> i64) -> i64 { let pool = par_pthread_pool_start(workers, capacity) if pool == 0 { par_with_sequential_i64(body) } else { let result = handle body() { Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg)) Par.await(h) -> resume(par_pthread_pool_await(h)) } par_pthread_pool_shutdown(pool) result } } fn main() -> i64 { par_with_pthread_pool_i64(2, 4, () => { let h = Par.spawn(metric_inc, 41) Par.await(h) }) }"
  Test.assert_eq(spawn_metric_lowerings(src), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_pthread_pool_i64"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_start"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_submit"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_submit_prepared"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_await"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_shutdown"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_sequential_submit"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_task_await"), 1)
}

test "spawn_emission_metric_sequential_par_map_lowers_pure_callback" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_pthread_pool_map_scoped_i64(items: i64, f: (i64) -> i64, pool: i64) -> i64 { items + pool } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => par_map<i64, i64>(metric_items(), metric_inc)) }"
  Test.assert_eq(spawn_metric_lowerings(src), 2)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_sequential_map_i64"), 1)
}

test "spawn_emission_metric_par_map_callback_matrix_literal_lambda" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => par_map<i64, i64>(metric_items(), x => x + 1)) }"
  Test.assert_eq(spawn_metric_lowerings(src), 2)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_sequential_map_i64"), 1)
}

test "spawn_emission_metric_pthread_par_map_lowers_pure_captured_callback" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_pthread_pool_start(workers: i64, capacity: i64) -> i64 { if workers == 0 { 0 } else { 1 } } fn par_pthread_pool_submit(pool: i64, f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_pthread_pool_await(h: i64) -> i64 { h } fn par_pthread_pool_shutdown(pool: i64) -> i64 { 0 } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_pthread_pool_map_scoped_i64(items: i64, f: (i64) -> i64, pool: i64) -> i64 { items + pool } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn par_with_pthread_pool_i64(workers: i64, capacity: i64, body: () -[Par]> i64) -> i64 { let pool = par_pthread_pool_start(workers, capacity) if pool == 0 { par_with_sequential_i64(body) } else { let result = handle body() { Par.spawn(f, arg) -> resume(par_pthread_pool_submit(pool, f, arg)) Par.await(h) -> resume(par_pthread_pool_await(h)) } par_pthread_pool_shutdown(pool) result } } fn main() -> i64 { par_with_pthread_pool_i64(2, 4, () => { let bias = 1 par_map<i64, i64>(metric_items(), x => x + bias) }) }"
  Test.assert_eq(spawn_metric_lowerings(src), 3)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_pthread_pool_i64"), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_start"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_map_scoped_i64"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_pthread_pool_shutdown"), 1)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_sequential_map_i64"), 1)
}

test "spawn_emission_metric_par_map_unknown_callback_stays_on_handler_path" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn metric_inc(x: i64) -> i64 { x + 1 } fn choose() -> (i64) -> i64 { metric_inc } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => par_map<i64, i64>(metric_items(), choose())) }"
  Test.assert_eq(spawn_metric_lowerings(src), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 1)
}

test "spawn_emission_metric_par_map_raw_callback_stays_on_handler_path" {
  let direct = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn metric_load(x: i64) -> i64 { __mem_load64(x) } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => par_map<i64, i64>(metric_items(), metric_load)) }"
  Test.assert_eq(spawn_metric_lowerings(direct), 0)
  Test.assert_eq(spawn_metric_call_sites(direct, "main", "par_with_sequential_i64"), 1)
  Test.assert_eq(spawn_metric_call_sites(direct, "main", "par_sequential_map_i64"), 0)

  let literal = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_items() -> i64 { 123 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_sequential_map_i64(items: i64, f: (i64) -> i64) -> i64 { items } fn par_map<T, U>(items: i64, f: (T) -> U) -[Par]> i64 { items } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => par_map<i64, i64>(metric_items(), x => __mem_load64(x))) }"
  Test.assert_eq(spawn_metric_lowerings(literal), 0)
  Test.assert_eq(spawn_metric_call_sites(literal, "main", "par_with_sequential_i64"), 1)
  Test.assert_eq(spawn_metric_call_sites(literal, "main", "par_sequential_map_i64"), 0)
}

test "spawn_emission_metric_raw_spawn_callback_stays_on_handler_path" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_load(x: i64) -> i64 { __mem_load64(x) } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => { let h = Par.spawn(metric_load, 41) Par.await(h) }) }"
  Test.assert_eq(spawn_metric_lowerings(src), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 1)
}

test "spawn_emission_metric_rejects_nonliteral_and_effect_helper_bodies" {
  let nonliteral = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn body() -[Par]> i64 { let h = Par.spawn(metric_inc, 41) Par.await(h) } fn main() -> i64 { par_with_sequential_i64(body) }"
  Test.assert_eq(spawn_metric_lowerings(nonliteral), 0)
  Test.assert_eq(spawn_metric_call_sites(nonliteral, "main", "par_with_sequential_i64"), 1)

  let effect_helper = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn body() -[Par]> i64 { let h = Par.spawn(metric_inc, 41) Par.await(h) } fn main() -> i64 { par_with_sequential_i64(() => body()) }"
  Test.assert_eq(spawn_metric_lowerings(effect_helper), 0)
  Test.assert_eq(spawn_metric_call_sites(effect_helper, "main", "par_with_sequential_i64"), 1)
}

test "spawn_emission_metric_rejects_control_escape_boundary" {
  let src = "effect Par { fn spawn(f: (i64) -> i64, arg: i64) -> i64, fn await(h: i64) -> i64 } fn rc_default_alloc(size: i64, align: i64) -> i64 { alloc_bump(size) } fn rc_default_retain(p: i64) -> i64 { p } fn rc_default_release(p: i64) -> i64 { 0 } fn closure_default_retain(p: i64) -> i64 { p } fn closure_default_release(p: i64) -> i64 { 0 } fn metric_inc(x: i64) -> i64 { x + 1 } fn par_sequential_submit(f: (i64) -> i64, arg: i64) -> i64 { f(arg) } fn par_task_await(h: i64) -> i64 { h } fn par_with_sequential_i64(body: () -[Par]> i64) -> i64 { handle body() { Par.spawn(f, arg) -> resume(par_sequential_submit(f, arg)) Par.await(h) -> resume(par_task_await(h)) } } fn main() -> i64 { par_with_sequential_i64(() => { let h = Par.spawn(metric_inc, 41) return Par.await(h) }) }"
  Test.assert_eq(spawn_metric_lowerings(src), 0)
  Test.assert_eq(spawn_metric_call_sites(src, "main", "par_with_sequential_i64"), 1)
}
