use compiler/grammar_checking.{NativeRuntimeWithRcCensus, check_weft_program_with_loader, check_weft_native_program_with_loader, check_weft_native_program_with_support_and_loader}
use compiler/grammar_source.{WeftParser}
use compiler/diagnostic_observation.{observe_errors}
use compiler/pipeline.{AstModule, TypedModule}
use compiler/type_registry.{ttable_new}
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_store64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/grammar.{Grammar, ParseResult, Parsed, Checked, CheckRejected, CheckResult}
use stdlib/list.{List, Nil}
use stdlib/option.{Option}
use stdlib/source.{Source}
use stdlib/state as state
use stdlib/state.{State}

effect ObserveLoad { fn request(path: str) -> nil }

type CheckEntry { Semantic, Native, NativeCensus }
type LoadNotice { Silent, Report(DiagnosticSeverity), LegacyError, LegacyWarning, LegacyNote }
type Observations { requests: List<str>, diagnostics: List<Diagnostic> }

fn observe_source(text: str, entry: CheckEntry, notice: LoadNotice, support: str) -> (CheckResult<TypedModule>, Observations) {
  observe_source_notice_at(text, entry, notice, support, "")
}

fn observe_source_notice_at(text: str, entry: CheckEntry, notice: LoadNotice, support: str, notice_path: str) -> (CheckResult<TypedModule>, Observations) {
  let source = Source { text: text, identity: DiagnosticSourceNamed("program.weft") }
  let table = ttable_new()
  let loader = (physical: i64, physical_len: i64, logical: i64, logical_len: i64, package_id: i64) => {
    let path = runtime_str_from_bytes_copy(logical, logical_len)
    ObserveLoad.request(path)
    if notice_path == "" or notice_path == path { match notice {
      Silent -> nil
      Report(severity) -> { Diagnose.report(uncoded(severity, DiagnosticClassModule, "support notice", DiagnosticLocationNone)); nil }
      LegacyError -> { Diagnose.error("support error", 0); nil }
      LegacyWarning -> { Diagnose.warn("support warning", 0); nil }
      LegacyNote -> { Diagnose.note("support note", 0); nil }
    } }
    let descriptor = alloc_words(2)
    mem_store64_at(descriptor, 0, __str_ptr(support))
    mem_store64_at(descriptor, 8, __str_len(support))
    descriptor
  }
  let initial = Observations { requests: Nil<str>(), diagnostics: Nil<Diagnostic>() }
  state.run(initial, () => handle {
    handle {
      match WeftParser { table: table }.parse(source.all()) {
        Parsed(parsed) -> {
          let syntax = AstModule(parsed.declarations.functions, __str_ptr(source.text), table)
          match entry {
            Semantic -> check_weft_program_with_loader(syntax, loader)
            Native -> check_weft_native_program_with_loader(syntax, loader)
            NativeCensus -> check_weft_native_program_with_support_and_loader(syntax, NativeRuntimeWithRcCensus, loader)
          }
        }
        _ -> CheckRejected<TypedModule>()
      }
    } {
      Diagnose.report(diagnostic) -> {
        state.modify((seen: Observations) => Observations { requests: seen.requests, diagnostics: seen.diagnostics.prepend(diagnostic) })
        resume(0)
      }
      Diagnose.error(message, position) -> {
        let diagnostic = uncoded(DiagnosticSeverityError, DiagnosticClassType, message, DiagnosticLocationNone)
        state.modify((seen: Observations) => Observations { requests: seen.requests, diagnostics: seen.diagnostics.prepend(diagnostic) })
        resume(0)
      }
      Diagnose.warn(message, position) -> {
        let diagnostic = uncoded(DiagnosticSeverityWarning, DiagnosticClassType, message, DiagnosticLocationNone)
        state.modify((seen: Observations) => Observations { requests: seen.requests, diagnostics: seen.diagnostics.prepend(diagnostic) })
        resume(0)
      }
      Diagnose.note(message, position) -> {
        let diagnostic = uncoded(DiagnosticSeverityNote, DiagnosticClassType, message, DiagnosticLocationNone)
        state.modify((seen: Observations) => Observations { requests: seen.requests, diagnostics: seen.diagnostics.prepend(diagnostic) })
        resume(0)
      }
    }
  } {
    ObserveLoad.request(path) -> {
      state.modify((seen: Observations) => Observations { requests: seen.requests.prepend(path), diagnostics: seen.diagnostics })
      resume(nil)
    }
  })
}

fn accepted(result: CheckResult<TypedModule>) -> bool {
  match result { Checked(_) -> true, CheckRejected -> false }
}

fn same_severity(actual: DiagnosticSeverity, expected: DiagnosticSeverity) -> bool {
  match (actual, expected) {
    (DiagnosticSeverityError, DiagnosticSeverityError) -> true
    (DiagnosticSeverityWarning, DiagnosticSeverityWarning) -> true
    (DiagnosticSeverityNote, DiagnosticSeverityNote) -> true
    _ -> false
  }
}

fn notice_preserved(diagnostic: Diagnostic, notice: LoadNotice) -> bool {
  let (severity, message) = match notice {
    Silent -> return false
    Report(severity) -> (severity, "support notice")
    LegacyError -> (DiagnosticSeverityError, "support error")
    LegacyWarning -> (DiagnosticSeverityWarning, "support warning")
    LegacyNote -> (DiagnosticSeverityNote, "support note")
  }
  same_severity(diagnostic.severity(), severity) and diagnostic.message() == message
}

test "Weft checking rejects support acquisition errors even for a valid program" {
  for entry in [Semantic, Native, NativeCensus] {
    for notice in [Report(DiagnosticSeverityError), LegacyError] {
      let (result, observed) = observe_source("fn main() -> i64 { 42 }", entry, notice, "")
      Test.assert_false(accepted(result))
      Test.assert_false(observed.requests.is_empty())
      Test.assert_eq_usize(observed.diagnostics.len(), observed.requests.len())
      for diagnostic in observed.diagnostics { Test.assert_true(notice_preserved(diagnostic, notice)) }
    }
  }
}

test "Weft checking preserves warning and note diagnostics without rejecting" {
  for entry in [Semantic, Native, NativeCensus] {
    for notice in [Report(DiagnosticSeverityWarning), Report(DiagnosticSeverityNote), LegacyWarning, LegacyNote] {
      let (result, observed) = observe_source("fn main() -> i64 { 42 }", entry, notice, "")
      Test.assert_true(accepted(result))
      Test.assert_false(observed.requests.is_empty())
      Test.assert_eq_usize(observed.diagnostics.len(), observed.requests.len())
      for diagnostic in observed.diagnostics { Test.assert_true(notice_preserved(diagnostic, notice)) }
    }
  }
}

test "Weft checking rejects malformed support before exposing a typed program" {
  for entry in [Semantic, Native, NativeCensus] {
    for support in ["}", "0x"] {
      let (result, observed) = observe_source("fn main() -> i64 { 42 }", entry, Silent, support)
      Test.assert_false(accepted(result))
      Test.assert_false(observed.diagnostics.is_empty())
    }
  }
}

test "Weft checking retains support acquisition authority and native binding order" {
  let (semantic, semantic_observed) = observe_source("fn main() -> i64 { 42 }", Semantic, Silent, "")
  let (native, native_observed) = observe_source("fn main() -> i64 { 42 }", Native, Silent, "")
  Test.assert_true(accepted(semantic))
  Test.assert_true(accepted(native))
  Test.assert_true(semantic_observed.diagnostics.is_empty())
  Test.assert_true(native_observed.diagnostics.is_empty())
  Test.assert_str_eq(semantic_observed.requests.reverse().first().unwrap(), "stdlib/prelude")
  Test.assert_str_eq(native_observed.requests.reverse().first().unwrap(), "runtime/panic")
}

test "Weft checked results reject semantic errors after successful support loading" {
  for entry in [Semantic, Native, NativeCensus] {
    for text in ["fn main() -> i64 { missing }", "fn main() -> i64 { \"wrong\" }"] {
      let (result, observed) = observe_source(text, entry, Silent, "")
      Test.assert_false(accepted(result))
      Test.assert_false(observed.diagnostics.is_empty())
    }
  }
}

test "RC census support is acquired only by the instrumented grammar host" {
  for path in ["runtime/rc_census_stakes", "runtime/rc_census"] {
    for notice in [Report(DiagnosticSeverityError), LegacyError] {
      for entry in [Semantic, Native, NativeCensus] {
        let (result, observed) = observe_source_notice_at("fn main() -> i64 { 42 }", entry, notice, "", path)
        match entry {
          NativeCensus -> {
            Test.assert_false(accepted(result))
            Test.assert_eq_usize(observed.diagnostics.len(), 1)
            Test.assert_true(notice_preserved(observed.diagnostics.first().unwrap(), notice))
          }
          _ -> {
            Test.assert_true(accepted(result))
            Test.assert_true(observed.diagnostics.is_empty())
          }
        }
      }
    }
  }
}

test "RC census support preserves native and implicit prelude order" {
  let (result, observed) = observe_source("fn main() -> i64 { 42 }", NativeCensus, Silent, "")
  Test.assert_true(accepted(result))
  Test.assert_true(observed.diagnostics.is_empty())
  let requests = observed.requests.reverse()
  Test.assert_eq_usize(requests.len(), 4)
  Test.assert_str_eq(requests.get(0).unwrap(), "runtime/panic")
  Test.assert_str_eq(requests.get(1).unwrap(), "runtime/rc_census_stakes")
  Test.assert_str_eq(requests.get(2).unwrap(), "runtime/rc_census")
  Test.assert_str_eq(requests.get(3).unwrap(), "stdlib/prelude")
}

fn check_with_bool_loader(entry: CheckEntry) -> (CheckResult<TypedModule>, bool) {
  let source = Source { text: "fn main() -> i64 { 42 }", identity: DiagnosticSourceNamed("stateful-loader.weft") }
  let table = ttable_new()
  let loader = (physical: i64, physical_len: i64, logical: i64, logical_len: i64, package_id: i64) => {
    State<bool>.put(true)
    let descriptor = alloc_words(2)
    mem_store64_at(descriptor, 0, __str_ptr(""))
    mem_store64_at(descriptor, 8, 0)
    descriptor
  }
  let run: () -[State<bool>]> CheckResult<TypedModule> = () => handle {
    match WeftParser { table: table }.parse(source.all()) {
      Parsed(parsed) -> {
        let syntax = AstModule(parsed.declarations.functions, __str_ptr(source.text), table)
        match entry {
          Semantic -> check_weft_program_with_loader(syntax, loader)
          Native -> check_weft_native_program_with_loader(syntax, loader)
          NativeCensus -> check_weft_native_program_with_support_and_loader(syntax, NativeRuntimeWithRcCensus, loader)
        }
      }
      _ -> CheckRejected<TypedModule>()
    }
  } {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
  state.run(false, run)
}

test "grammar support observation does not intercept a loader's boolean state" {
  for entry in [Semantic, Native, NativeCensus] {
    let (result, requested) = check_with_bool_loader(entry)
    Test.assert_true(accepted(result))
    Test.assert_true(requested)
  }
}

test "diagnostic observation preserves integer state while counting only errors" {
  -- Construct the callback before installing handlers: a closure created
  -- under a handler can retain that handler's lexical evidence.
  let body = () => {
    State<i64>.put(42)
    Diagnose.error("first", 1)
    Diagnose.warn("warning", 2)
    Diagnose.note("note", 3)
    Diagnose.report(uncoded(DiagnosticSeverityError, DiagnosticClassType, "second", DiagnosticLocationNone))
    State<i64>.get()
  }
  let ((result, errors), final_state) = state.run(0, () => handle observe_errors(body) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  })
  Test.assert_eq(result, 42)
  Test.assert_eq(final_state, 42)
  Test.assert_eq(errors, 2)
}
