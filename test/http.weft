use stdlib/bytes.{Bytes, bytes_equal, bytes_from_slice, bytes_from_str, bytes_to_utf8, bytes_to_vector}
use stdlib/http.{*}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/string.{str_len}
use stdlib/vector.{vector_len, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

fn http_test_vector(source: str) -> Vector<u8> {
  bytes_to_vector(bytes_from_str(source))
}

fn http_test_request(source: str) -> HttpRequestHeadParse {
  let values = http_test_vector(source)
  http_parse_request_head(values[..], http_default_limits())
}

fn http_test_response(source: str, method: HttpMethod) -> HttpResponseHeadParse {
  let values = http_test_vector(source)
  http_parse_response_head(values[..], method, http_default_limits())
}

fn http_test_chunk(source: str) -> HttpChunkParse {
  let values = http_test_vector(source)
  http_parse_chunk(values[..], http_default_limits())
}

fn http_test_usize(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

fn http_test_error_kind(error: HttpParseError) -> i64 {
  match error {
    HttpInvalidStartLine(offset) -> 1
    HttpInvalidMethod(offset) -> 2
    HttpInvalidTarget(offset) -> 3
    HttpInvalidVersion(offset) -> 4
    HttpInvalidStatus(offset) -> 5
    HttpInvalidFieldName(offset) -> 6
    HttpInvalidFieldValue(offset) -> 7
    HttpInvalidLineEnding(offset) -> 8
    HttpStartLineTooLong(offset) -> 9
    HttpFieldLineTooLong(offset) -> 10
    HttpHeadersTooLarge(offset) -> 11
    HttpTooManyHeaders(offset) -> 12
    HttpMissingHost(offset) -> 13
    HttpDuplicateHost(offset) -> 14
    HttpInvalidHost(offset) -> 15
    HttpInvalidContentLength(offset) -> 16
    HttpAmbiguousFraming(offset) -> 17
    HttpInvalidTransferEncoding(offset) -> 18
    HttpUnsupportedTransferCoding(offset) -> 19
    HttpForbiddenBodyFraming(offset) -> 20
    HttpInvalidConnection(offset) -> 21
    HttpBodyTooLarge(offset) -> 22
    HttpInvalidChunkSize(offset) -> 23
    HttpChunkLineTooLong(offset) -> 24
    HttpInvalidChunkTerminator(offset) -> 25
    HttpTrailersTooLarge(offset) -> 26
    HttpForbiddenTrailer(offset) -> 27
  }
}

fn http_test_request_error(source: str) -> i64 {
  match http_test_request(source) {
    HttpRequestHeadFailed(error) -> http_test_error_kind(error)
    _ -> 0
  }
}

fn http_test_response_error(source: str, method: HttpMethod) -> i64 {
  match http_test_response(source, method) {
    HttpResponseHeadFailed(error) -> http_test_error_kind(error)
    _ -> 0
  }
}

fn http_test_chunk_error(source: str) -> i64 {
  match http_test_chunk(source) {
    HttpChunkFailed(error) -> http_test_error_kind(error)
    _ -> 0
  }
}

fn http_test_header(name: str, value: str) -> HttpHeader {
  http_header(http_field_name_parse(name).unwrap(), bytes_from_str(value)).unwrap()
}

fn http_test_host_headers() -> HttpHeaders {
  http_headers_append(http_headers_empty(), http_test_header("Host", "example.com"))
}

test "HTTP methods are direct typed variants with sealed extension tokens" {
  Test.assert_str_eq(http_method_text(http_method_parse("GET").unwrap()), "GET")
  Test.assert_str_eq(http_method_text(http_method_parse("HEAD").unwrap()), "HEAD")
  Test.assert_str_eq(http_method_text(http_method_parse("POST").unwrap()), "POST")
  Test.assert_str_eq(http_method_text(http_method_parse("PUT").unwrap()), "PUT")
  Test.assert_str_eq(http_method_text(http_method_parse("DELETE").unwrap()), "DELETE")
  Test.assert_str_eq(http_method_text(http_method_parse("CONNECT").unwrap()), "CONNECT")
  Test.assert_str_eq(http_method_text(http_method_parse("OPTIONS").unwrap()), "OPTIONS")
  Test.assert_str_eq(http_method_text(http_method_parse("PATCH").unwrap()), "PATCH")
  Test.assert_str_eq(http_method_text(http_method_parse("TRACE").unwrap()), "TRACE")
  match http_method_parse("PROPFIND").unwrap() {
    HttpExtension(extension) -> Test.assert_str_eq(http_method_text(HttpExtension(extension)), "PROPFIND")
    _ -> Test.assert_true(false)
  }
  match http_method_parse("get").unwrap() {
    HttpExtension(extension) -> Test.assert_str_eq(http_method_text(HttpExtension(extension)), "get")
    _ -> Test.assert_true(false)
  }
  match http_method_parse("BAD METHOD") { Err(HttpInvalidMethod(3)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "request head parsing owns canonical fields framing and exact boundary" {
  let source = "POST /submit?q=1 HTTP/1.1\r\nHost: Example.COM\r\nX-Trace:\t abc \t\r\nContent-Length: 5\r\n\r\nhelloNEXT"
  match http_test_request(source) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> {
      Test.assert_str_eq(http_method_text(http_request_method(head)), "POST")
      Test.assert_true(bytes_equal(http_request_target_bytes(http_request_target(head)), bytes_from_str("/submit?q=1")))
      match http_request_version(head) { Http11 -> Test.assert_true(true) _ -> Test.assert_true(false) }
      match http_request_connection(head) { HttpConnectionPersistent -> Test.assert_true(true) _ -> Test.assert_true(false) }
      Test.assert_eq(http_test_usize(count), 5)
      match http_request_body_framing(head) {
        HttpContentLength(stored) -> Test.assert_eq(http_test_usize(stored), 5)
        _ -> Test.assert_true(false)
      }
      Test.assert_eq(http_test_usize(consumed), str_len("POST /submit?q=1 HTTP/1.1\r\nHost: Example.COM\r\nX-Trace:\t abc \t\r\nContent-Length: 5\r\n\r\n"))
      let headers = http_request_headers(head)
      Test.assert_eq(http_headers_len(headers), 3)
      match http_headers_get(headers, 1) {
        Some(header) -> {
          Test.assert_str_eq(http_field_name_text(http_header_name(header)), "x-trace")
          Test.assert_str_eq(bytes_to_utf8(http_header_value(header)).unwrap(), "abc")
        }
        None -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
}

test "request framing preserves empty fixed chunked and close policies" {
  match http_test_request("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, count) -> match http_request_connection(head) {
      HttpConnectionPersistent -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match http_test_request("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 0, 0\r\nConnection: close\r\n\r\n") {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> {
      Test.assert_eq(http_test_usize(count), 0)
      match http_request_connection(head) { HttpConnectionClose -> Test.assert_true(true) _ -> Test.assert_true(false) }
    }
    _ -> Test.assert_true(false)
  }
  match http_test_request("POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n") {
    HttpRequestHeadReady(head, HttpChunked, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_request("GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> match http_request_connection(head) {
      HttpConnectionPersistent -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match http_test_request("GET / HTTP/1.0\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> match http_request_connection(head) {
      HttpConnectionClose -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
}

test "response framing covers fixed close no-body switch and tunnel alternatives" {
  match http_test_response("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", HttpGet) {
    HttpResponseHeadReady(head, HttpContentLength(count), consumed) -> {
      Test.assert_eq(http_status_code(http_response_status(head)), 200)
      Test.assert_str_eq(bytes_to_utf8(http_response_reason(head)).unwrap(), "OK")
      match http_response_body_framing(head) {
        HttpContentLength(stored) -> Test.assert_eq(http_test_usize(stored), 5)
        _ -> Test.assert_true(false)
      }
      match http_response_connection(head) { HttpConnectionPersistent -> Test.assert_true(true) _ -> Test.assert_true(false) }
    }
    _ -> Test.assert_true(false)
  }
  match http_test_response("HTTP/1.1 200 OK\r\n\r\nbody", HttpGet) {
    HttpResponseHeadReady(head, HttpUntilConnectionClose, consumed) -> match http_response_connection(head) {
      HttpConnectionClose -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
    _ -> Test.assert_true(false)
  }
  match http_test_response("HTTP/1.1 200 OK\r\nContent-Length: 42\r\n\r\n", HttpHead) {
    HttpResponseHeadReady(head, HttpNoBody, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_response("HTTP/1.1 304 Not Modified\r\nContent-Length: 42\r\n\r\n", HttpGet) {
    HttpResponseHeadReady(head, HttpNoBody, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_response("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n", HttpGet) {
    HttpResponseHeadReady(head, HttpProtocolSwitch, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_response("HTTP/1.1 200 Connection Established\r\n\r\n", HttpConnect) {
    HttpResponseHeadReady(head, HttpConnectTunnel, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "request target forms are method-sensitive and share URL host identity" {
  Test.assert_true(http_test_request_error("GET * HTTP/1.1\r\nHost: example.com\r\n\r\n") == 3)
  match http_test_request("OPTIONS * HTTP/1.1\r\nHost: example.com\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_request("GET https://xn--bcher-kva.example/x HTTP/1.1\r\nHost: xn--bcher-kva.example\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match http_test_request("CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n") {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  Test.assert_true(http_test_request_error("CONNECT /x HTTP/1.1\r\nHost: example.com\r\n\r\n") == 3)
  Test.assert_true(http_test_request_error("CONNECT [::1] HTTP/1.1\r\nHost: [::1]\r\n\r\n") == 3)
  Test.assert_true(http_test_request_error("GET /bad%XZ HTTP/1.1\r\nHost: example.com\r\n\r\n") == 3)
  Test.assert_true(http_test_request_error("GET https://user@example.com/x HTTP/1.1\r\nHost: example.com\r\n\r\n") == 3)
  Test.assert_true(http_test_request_error("GET /café HTTP/1.1\r\nHost: example.com\r\n\r\n") == 3)
  Test.assert_true(http_test_request_error("GET / HTTP/1.1\r\nHost: 127.1\r\n\r\n") == 15)
}

test "identical content lengths converge while conflicting and ambiguous framing fail closed" {
  match http_test_request("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\n") {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> Test.assert_eq(http_test_usize(count), 5)
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 5, 6\r\n\r\n"), 16)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n"), 17)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked, gzip\r\n\r\n"), 18)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"), 19)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n"), 18)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length:\r\n\r\n"), 16)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: +5\r\n\r\n"), 16)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 9223372036854775808\r\n\r\n"), 16)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked, chunked\r\n\r\n"), 18)
  Test.assert_eq(http_test_request_error("POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked;bad=yes\r\n\r\n"), 18)
  Test.assert_eq(http_test_response_error("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n", HttpGet), 20)
}

test "host and connection fields reject routing and reuse ambiguity" {
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\n\r\n"), 13)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\nHost: a.example\r\nHost: b.example\r\n\r\n"), 14)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\nHost:\r\n\r\n"), 15)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\nHost: good.example,evil.example\r\n\r\n"), 15)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close,,upgrade\r\n\r\n"), 21)
}

test "strict start and field syntax rejects parser differential shapes" {
  Test.assert_eq(http_test_request_error("GET  / HTTP/1.1\r\nHost: example.com\r\n\r\n"), 1)
  Test.assert_eq(http_test_request_error("G@T / HTTP/1.1\r\nHost: example.com\r\n\r\n"), 2)
  Test.assert_eq(http_test_request_error("GET /#x HTTP/1.1\r\nHost: example.com\r\n\r\n"), 3)
  Test.assert_eq(http_test_request_error("GET / HTTP/2.0\r\nHost: example.com\r\n\r\n"), 4)
  Test.assert_eq(http_test_response_error("HTTP/1.1 20 OK\r\n\r\n", HttpGet), 1)
  Test.assert_eq(http_test_response_error("HTTP/1.1 2x0 OK\r\n\r\n", HttpGet), 5)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\nHost : example.com\r\n\r\n"), 6)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\r\n Host: example.com\r\n\r\n"), 8)
  Test.assert_eq(http_test_request_error("GET / HTTP/1.1\nHost: example.com\n\n"), 8)
}

test "field constructors preserve obs-text but reject controls" {
  let values = vector_with_capacity<u8>(3)
  vector_push<u8>(values, __i64_to_u8(65))
  vector_push<u8>(values, __i64_to_u8(255))
  vector_push<u8>(values, __i64_to_u8(66))
  let header = http_header(http_field_name_parse("X-Binary").unwrap(), bytes_from_slice(values[..])).unwrap()
  Test.assert_str_eq(http_field_name_text(http_header_name(header)), "x-binary")
  let invalid = vector_with_capacity<u8>(1)
  vector_push<u8>(invalid, __i64_to_u8(0))
  match http_header(http_field_name_parse("x").unwrap(), bytes_from_slice(invalid[..])) {
    Err(error) -> Test.assert_eq(http_test_error_kind(error), 7)
    Ok(_) -> Test.assert_true(false)
  }
  match http_status(99) { Err(error) -> Test.assert_eq(http_test_error_kind(error), 5) _ -> Test.assert_true(false) }
  Test.assert_eq(http_status_code(http_status(999).unwrap()), 999)
}

test "configured limits fail with distinct typed outcomes" {
  let start_limit = http_limits(3, 100, 100, 10, 100, 100, 100, 10).unwrap()
  let field_limit = http_limits(100, 3, 100, 10, 100, 100, 100, 10).unwrap()
  let bytes_limit = http_limits(100, 100, 5, 10, 100, 100, 100, 10).unwrap()
  let count_limit = http_limits(100, 100, 100, 1, 100, 100, 100, 10).unwrap()
  let body_limit = http_limits(100, 100, 100, 10, 4, 100, 100, 10).unwrap()
  let request = http_test_vector("GET / HTTP/1.1\r\nHost: example.com\r\nX: y\r\n\r\n")
  match http_parse_request_head(request[..], start_limit) { HttpRequestHeadFailed(error) -> Test.assert_eq(http_test_error_kind(error), 9) _ -> Test.assert_true(false) }
  match http_parse_request_head(request[..], field_limit) { HttpRequestHeadFailed(error) -> Test.assert_eq(http_test_error_kind(error), 10) _ -> Test.assert_true(false) }
  match http_parse_request_head(request[..], bytes_limit) { HttpRequestHeadFailed(error) -> Test.assert_eq(http_test_error_kind(error), 11) _ -> Test.assert_true(false) }
  match http_parse_request_head(request[..], count_limit) { HttpRequestHeadFailed(error) -> Test.assert_eq(http_test_error_kind(error), 12) _ -> Test.assert_true(false) }
  let large_body = http_test_vector("POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 5\r\n\r\n")
  match http_parse_request_head(large_body[..], body_limit) { HttpRequestHeadFailed(error) -> Test.assert_eq(http_test_error_kind(error), 22) _ -> Test.assert_true(false) }
}

test "request and response heads remain incomplete at every byte boundary" {
  let request = http_test_vector("GET /x HTTP/1.1\r\nHost: example.com\r\n\r\n")
  for end in 0..vector_len<u8>(request) {
    match http_parse_request_head(request[__i64_to_usize(0)..__i64_to_usize(end)], http_default_limits()) {
      HttpRequestHeadNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  match http_parse_request_head(request[..], http_default_limits()) {
    HttpRequestHeadReady(head, HttpNoBody, consumed) -> Test.assert_eq(http_test_usize(consumed), vector_len<u8>(request))
    _ -> Test.assert_true(false)
  }
  let response = http_test_vector("HTTP/1.1 204 No Content\r\n\r\n")
  for end in 0..vector_len<u8>(response) {
    match http_parse_response_head(response[__i64_to_usize(0)..__i64_to_usize(end)], HttpGet, http_default_limits()) {
      HttpResponseHeadNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  match http_parse_response_head(response[..], HttpGet, http_default_limits()) {
    HttpResponseHeadReady(head, HttpNoBody, consumed) -> Test.assert_eq(http_test_usize(consumed), vector_len<u8>(response))
    _ -> Test.assert_true(false)
  }
}

test "canonical head encoders round trip through the same semantic parser" {
  let request = http_request_head_new(
    HttpPost,
    http_request_target_parse("/submit").unwrap(),
    Http11,
    http_headers_append(
    http_headers_append(http_headers_empty(), http_test_header("Host", "example.com")),
    http_test_header("Content-Length", "5")
  ),
    http_default_limits()
  ).unwrap()
  let request_wire = http_encode_request_head(request)
  Test.assert_str_eq(bytes_to_utf8(request_wire).unwrap(), "POST /submit HTTP/1.1\r\nhost: example.com\r\ncontent-length: 5\r\n\r\n")
  let request_values = bytes_to_vector(request_wire)
  match http_parse_request_head(request_values[..], http_default_limits()) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> Test.assert_eq(http_test_usize(count), 5)
    _ -> Test.assert_true(false)
  }

  let response = http_response_head_new(
    HttpPost,
    Http11,
    http_status(201).unwrap(),
    bytes_from_str("Created"),
    http_headers_append(http_headers_empty(), http_test_header("Content-Length", "0")),
    http_default_limits()
  ).unwrap()
  let response_wire = http_encode_response_head(response)
  Test.assert_str_eq(bytes_to_utf8(response_wire).unwrap(), "HTTP/1.1 201 Created\r\ncontent-length: 0\r\n\r\n")
  let response_values = bytes_to_vector(response_wire)
  match http_parse_response_head(response_values[..], HttpPost, http_default_limits()) {
    HttpResponseHeadReady(head, HttpContentLength(count), consumed) -> Test.assert_eq(http_test_usize(count), 0)
    _ -> Test.assert_true(false)
  }
}

test "chunk parser and encoder preserve data extensions and every split boundary" {
  match http_test_chunk("A;foo=bar\r\n0123456789\r\nrest") {
    HttpChunkReady(HttpChunkData(data), consumed) -> {
      Test.assert_str_eq(bytes_to_utf8(data).unwrap(), "0123456789")
      Test.assert_eq(http_test_usize(consumed), 23)
    }
    _ -> Test.assert_true(false)
  }
  let extended = "A ; foo = \"a\\\"b\" ; bare\r\n0123456789\r\nrest"
  match http_test_chunk(extended) {
    HttpChunkReady(HttpChunkData(data), consumed) -> {
      Test.assert_str_eq(bytes_to_utf8(data).unwrap(), "0123456789")
      Test.assert_eq(http_test_usize(consumed), str_len("A ; foo = \"a\\\"b\" ; bare\r\n0123456789\r\n"))
    }
    _ -> Test.assert_true(false)
  }
  let encoded = http_encode_chunk(bytes_from_str("hello"), http_default_limits()).unwrap()
  Test.assert_str_eq(bytes_to_utf8(encoded).unwrap(), "5\r\nhello\r\n")
  let values = bytes_to_vector(encoded)
  for end in 0..vector_len<u8>(values) {
    match http_parse_chunk(values[__i64_to_usize(0)..__i64_to_usize(end)], http_default_limits()) {
      HttpChunkNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  match http_parse_chunk(values[..], http_default_limits()) {
    HttpChunkReady(HttpChunkData(data), consumed) -> Test.assert_str_eq(bytes_to_utf8(data).unwrap(), "hello")
    _ -> Test.assert_true(false)
  }
  match http_encode_chunk(bytes_from_str(""), http_default_limits()) {
    Err(error) -> Test.assert_eq(http_test_error_kind(error), 23)
    Ok(data) -> Test.assert_true(false)
  }
  Test.assert_eq(http_test_chunk_error("1;\r\na\r\n"), 23)
  Test.assert_eq(http_test_chunk_error("1;=x\r\na\r\n"), 23)
  Test.assert_eq(http_test_chunk_error("1;foo=\"unterminated\r\na\r\n"), 23)
  Test.assert_eq(http_test_chunk_error("1 trailing\r\na\r\n"), 23)
}

test "chunk head parser exposes a streaming boundary before content arrives" {
  let prefix = http_test_vector("A;foo=bar\r\n")
  for end in 0..vector_len<u8>(prefix) {
    match http_parse_chunk_head(
      prefix[__i64_to_usize(0)..__i64_to_usize(end)],
      http_default_limits()
    ) {
      HttpChunkHeadNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  match http_parse_chunk_head(prefix[..], http_default_limits()) {
    HttpChunkHeadData(size, consumed) -> {
      Test.assert_eq(http_test_usize(size), 10)
      Test.assert_eq(http_test_usize(consumed), vector_len<u8>(prefix))
    }
    _ -> Test.assert_true(false)
  }
  let terminal = http_test_vector("0\r\nX-Checksum: yes\r\n\r\n")
  match http_parse_chunk_head(terminal[..], http_default_limits()) {
    HttpChunkHeadEnd(trailers, consumed) -> {
      Test.assert_eq(http_headers_len(trailers), 1)
      Test.assert_eq(http_test_usize(consumed), vector_len<u8>(terminal))
    }
    _ -> Test.assert_true(false)
  }
  let invalid = http_test_vector("Z\r\n")
  match http_parse_chunk_head(invalid[..], http_default_limits()) {
    HttpChunkHeadFailed(HttpInvalidChunkSize(offset)) -> Test.assert_eq(offset, 0)
    _ -> Test.assert_true(false)
  }
}

test "terminal chunks carry safe trailers and reject malformed framing" {
  match http_test_chunk("0\r\nX-Checksum: yes\r\n\r\nnext") {
    HttpChunkReady(HttpChunkEnd(trailers), consumed) -> {
      Test.assert_eq(http_headers_len(trailers), 1)
      Test.assert_eq(http_test_usize(consumed), 22)
    }
    _ -> Test.assert_true(false)
  }
  let trailers = http_headers_append(http_headers_empty(), http_test_header("X-Checksum", "yes"))
  Test.assert_str_eq(bytes_to_utf8(http_encode_chunk_end(trailers, http_default_limits()).unwrap()).unwrap(), "0\r\nx-checksum: yes\r\n\r\n")
  let terminal = http_test_vector("0\r\nX-Checksum: yes\r\n\r\n")
  for end in 0..vector_len<u8>(terminal) {
    match http_parse_chunk(terminal[__i64_to_usize(0)..__i64_to_usize(end)], http_default_limits()) {
      HttpChunkNeedMore -> Test.assert_true(true)
      _ -> Test.assert_true(false)
    }
  }
  Test.assert_eq(http_test_chunk_error("Z\r\n"), 23)
  Test.assert_eq(http_test_chunk_error("1\r\naXX"), 25)
  Test.assert_eq(http_test_chunk_error("0\r\nContent-Length: 0\r\n\r\n"), 27)
}

test "chunk and trailer limits have independent typed failures" {
  let chunk_line_limit = http_limits(100, 100, 100, 10, 100, 1, 100, 10).unwrap()
  let body_limit = http_limits(100, 100, 100, 10, 1, 100, 100, 10).unwrap()
  let trailer_limit = http_limits(100, 100, 100, 10, 100, 100, 5, 1).unwrap()
  let long_line = http_test_vector("10\r\n")
  match http_parse_chunk(long_line[..], chunk_line_limit) { HttpChunkFailed(error) -> Test.assert_eq(http_test_error_kind(error), 24) _ -> Test.assert_true(false) }
  let large = http_test_vector("2\r\nab\r\n")
  match http_parse_chunk(large[..], body_limit) { HttpChunkFailed(error) -> Test.assert_eq(http_test_error_kind(error), 22) _ -> Test.assert_true(false) }
  let trailers = http_test_vector("0\r\nX: y\r\nZ: q\r\n\r\n")
  match http_parse_chunk(trailers[..], trailer_limit) { HttpChunkFailed(error) -> Test.assert_eq(http_test_error_kind(error), 26) _ -> Test.assert_true(false) }
}

test "all public parse result failure alternatives remain directly matchable" {
  let bad_request = http_test_request("GET  / HTTP/1.1\r\nHost: example.com\r\n\r\n")
  match bad_request { HttpRequestHeadFailed(HttpInvalidStartLine(offset)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  let bad_response = http_test_response("HTTP/1.1 2x0 Bad\r\n\r\n", HttpGet)
  match bad_response { HttpResponseHeadFailed(HttpInvalidStatus(offset)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  let bad_chunk = http_test_chunk("x\r\n")
  match bad_chunk { HttpChunkFailed(HttpInvalidChunkSize(offset)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match HttpChunkData(bytes_from_str("x")) { HttpChunkData(data) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match HttpChunkEnd(http_headers_empty()) { HttpChunkEnd(trailers) -> Test.assert_true(true) _ -> Test.assert_true(false) }
}
