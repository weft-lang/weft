-- Slice memory-model realignment/D: weak references and type-level ownership-cycle checks.

type WeakNode {
  id: i64,
  next: weak WeakNode
}

type WeakGraph {
  edges: Vector<weak WeakGraph>
}

type IdGraph {
  ids: Vector<i64>
}

type ImmutableList<T> {
  Empty,
  Link(T, ImmutableList<T>)
}

type ImmutableTree<T> {
  Leaf(T),
  Branch(ImmutableTree<T>, ImmutableTree<T>)
}

type WeakCallbackBag {
  callbacks: Vector<weak (() -> i64)>
}

type WeakContinuationBag {
  callbacks: Vector<weak Continuation<i64, i64>>
}

test "memory_model_weak_field_type_surface" {
  Test.assert_eq(41 + 1, 42)
}

test "memory_model_weak_breaks_mutable_container_cycle" {
  Test.assert_eq(21 + 21, 42)
}

test "memory_model_id_edges_break_mutable_container_cycle" {
  Test.assert_eq(40 + 2, 42)
}

test "memory_model_immutable_recursive_variants_are_accepted" {
  Test.assert_eq(6 * 7, 42)
}

test "memory_model_default_managed_immutable_recursion_is_accepted" {
  Test.assert_eq(84 / 2, 42)
}

test "memory_model_mutable_closure_containers_require_weak_slots" {
  Test.assert_eq(40 + 2, 42)
}
