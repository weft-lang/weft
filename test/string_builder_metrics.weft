use runtime/rc_implicit_test.{*}
use stdlib/test.{*}
use stdlib/string.{*}
use stdlib/string/builder as builder

effect BuilderAbort {
  fn stop() -> i64
}

fn finished_length() -> i64 {
  let mut output = builder.with_capacity(16)
  output.append("builder-")
  output.append("Ω")
  output.finish().len()
}

fn aborted_length() -[BuilderAbort]> i64 {
  let mut output = builder.with_capacity(16)
  output.append("discard this initialized prefix")
  BuilderAbort.stop()
}

fn handle_abort() -> i64 {
  handle aborted_length() {
    BuilderAbort.stop() -> 0
  }
}

fn warmed_heap_delta(abort: bool) -> i64 {
  let mut warm = 0
  while warm < 50 {
    if abort { handle_abort() } else { finished_length() }
    warm = warm + 1
  }
  let before = runtime_rc_test_heap_arena_offset()
  let mut iteration = 0
  while iteration < 200 {
    if abort { handle_abort() } else { finished_length() }
    iteration = iteration + 1
  }
  runtime_rc_test_heap_arena_offset() - before
}

test "finished text builders reuse all managed storage" {
  Test.assert_eq(finished_length(), 10)
  Test.assert_eq(warmed_heap_delta(false), 0)
}

test "aborted text builders reclaim their initialized storage" {
  Test.assert_eq(handle_abort(), 0)
  Test.assert_eq(warmed_heap_delta(true), 0)
}
