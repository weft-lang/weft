use runtime/memory.{*}
use stdlib/ord.{*}
use stdlib/option.{Option}
use stdlib/time as time
use stdlib/time.{Date, Time, Weekday}

fn time_option_has_value(opt: Option<Date>) -> i64 {
  match opt {
    Some(date) -> 1
    None -> 0
  }
}

fn time_epoch_roundtrip_property(i: i64) -> bool {
  let day = i - 16
  time.from_epoch_day(day).to_epoch_day() == day
}

fn time_weekday_index(weekday: Weekday) -> i64 {
  match weekday {
    Sunday -> 0
    Monday -> 1
    Tuesday -> 2
    Wednesday -> 3
    Thursday -> 4
    Friday -> 5
    Saturday -> 6
  }
}

fn time_order_is_less(ordering: Ordering) -> bool {
  match ordering { Less -> true _ -> false }
}

fn time_order_is_equal(ordering: Ordering) -> bool {
  match ordering { Equal -> true _ -> false }
}

fn time_order_is_greater(ordering: Ordering) -> bool {
  match ordering { Greater -> true _ -> false }
}

test "time_duration_happy_paths" {
  Test.assert_eq(time.duration_to_millis(time.duration_millis(42)), 42)
  Test.assert_eq(time.duration_to_millis(time.duration_seconds(3)), 3000)
  Test.assert_eq(time.duration_to_millis(time.duration_minutes(2)), 120000)
  Test.assert_eq(time.duration_to_millis(time.duration_hours(2)), 7200000)
  Test.assert_eq(time.duration_to_millis(time.duration_days(2)), 172800000)
  Test.assert_eq(time.duration_to_seconds(time.duration_millis(2999)), 2)
}

test "time_duration_arithmetic_and_boundaries" {
  let a = time.duration_seconds(5)
  let b = time.duration_millis(250)
  Test.assert_eq(time.duration_to_millis(time.duration_add(a, b)), 5250)
  Test.assert_eq(time.duration_to_millis(time.duration_sub(a, b)), 4750)
  Test.assert_eq(time.duration_to_millis(time.duration_neg(b)), 0 - 250)
  Test.assert_true(time_order_is_less(time.duration_cmp(time.duration_millis(1), time.duration_millis(2))))
  Test.assert_true(time_order_is_greater(time.duration_cmp(time.duration_millis(2), time.duration_millis(1))))
  Test.assert_true(time_order_is_equal(time.duration_cmp(time.duration_millis(2), time.duration_millis(2))))
  Test.assert_eq(time.duration_to_millis(time.duration_clamp(time.duration_millis(5), time.duration_millis(10), time.duration_millis(20))), 10)
  Test.assert_eq(time.duration_to_millis(time.duration_clamp(time.duration_millis(25), time.duration_millis(10), time.duration_millis(20))), 20)
  Test.assert_eq(time.duration_to_millis(time.duration_clamp(time.duration_millis(15), time.duration_millis(10), time.duration_millis(20))), 15)
}

test "time_instant_happy_paths" {
  let start = time.instant_from_millis(1000)
  let later = time.instant_add(start, time.duration_seconds(3))
  let earlier = time.instant_sub(later, time.duration_millis(500))
  Test.assert_eq(time.instant_to_millis(start), 1000)
  Test.assert_eq(time.instant_to_millis(later), 4000)
  Test.assert_eq(time.instant_to_millis(earlier), 3500)
  Test.assert_eq(time.duration_to_millis(time.instant_duration_since(later, start)), 3000)
  Test.assert_eq(time.duration_to_millis(time.instant_duration_since(start, later)), 0 - 3000)
  Test.assert_true(time_order_is_less(time.instant_cmp(start, later)))
  Test.assert_true(time_order_is_greater(time.instant_cmp(later, start)))
  Test.assert_true(time_order_is_equal(time.instant_cmp(start, time.instant_from_millis(1000))))
}

test "time_effect_handler_happy_path" {
  let now = handle time.time_now() {
    Time.now_millis() -> resume(123456)
  }
  Test.assert_eq(time.instant_to_millis(now), 123456)
}

test "time_date_validity_happy_and_sad_paths" {
  Test.assert_true(time.is_leap_year(2000))
  Test.assert_true(time.is_leap_year(2024))
  Test.assert_false(time.is_leap_year(1900))
  Test.assert_false(time.is_leap_year(2023))
  Test.assert_eq(time.days_in_month(2024, 2).unwrap(), 29)
  Test.assert_eq(time.days_in_month(2023, 2).unwrap(), 28)
  Test.assert_true(time.days_in_month(2023, 0).is_none())
  Test.assert_true(time.days_in_month(2023, 13).is_none())
  Test.assert_eq(time.days_in_year(2024), 366)
  Test.assert_eq(time.days_in_year(2023), 365)
  Test.assert_eq(time_option_has_value(time.date(2024, 2, 29)), 1)
  Test.assert_eq(time_option_has_value(time.date(2023, 2, 29)), 0)
  Test.assert_eq(time_option_has_value(time.date(2023, 0, 1)), 0)
  Test.assert_eq(time_option_has_value(time.date(2023, 12, 0)), 0)
}

test "time_date_epoch_boundaries_and_weekdays" {
  let epoch = time.date(1970, 1, 1).unwrap()
  Test.assert_eq(epoch.to_epoch_day(), 0)
  Test.assert_eq(time.date(1970, 1, 2).unwrap().to_epoch_day(), 1)
  Test.assert_eq(time.date(1969, 12, 31).unwrap().to_epoch_day(), 0 - 1)
  let zero = time.from_epoch_day(0)
  let before = time.from_epoch_day(0 - 1)
  let after = time.from_epoch_day(11017)
  Test.assert_eq(zero.year(), 1970)
  Test.assert_eq(zero.month(), 1)
  Test.assert_eq(zero.day(), 1)
  Test.assert_eq(before.year(), 1969)
  Test.assert_eq(before.month(), 12)
  Test.assert_eq(before.day(), 31)
  Test.assert_eq(after.year(), 2000)
  Test.assert_eq(after.month(), 3)
  Test.assert_eq(after.day(), 1)
  Test.assert_eq(time_weekday_index(epoch.weekday()), 4)
  Test.assert_eq(time_weekday_index(before.weekday()), 3)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(3).weekday()), 0)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(4).weekday()), 1)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(5).weekday()), 2)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(7).weekday()), 4)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(8).weekday()), 5)
  Test.assert_eq(time_weekday_index(time.from_epoch_day(9).weekday()), 6)
}

test "time_date_add_days_table" {
  let leap = time.date(2024, 2, 28).unwrap()
  let leap_next = leap.add_days(1)
  let leap_after = leap.add_days(2)
  let non_leap_prev = time.date(2023, 3, 1).unwrap().add_days(0 - 1)
  Test.assert_eq(leap_next.year(), 2024)
  Test.assert_eq(leap_next.month(), 2)
  Test.assert_eq(leap_next.day(), 29)
  Test.assert_eq(leap_after.year(), 2024)
  Test.assert_eq(leap_after.month(), 3)
  Test.assert_eq(leap_after.day(), 1)
  Test.assert_eq(non_leap_prev.year(), 2023)
  Test.assert_eq(non_leap_prev.month(), 2)
  Test.assert_eq(non_leap_prev.day(), 28)
}

test "property_time_epoch_day_roundtrips" {
  Test.forall_i64_range(0, 33, time_epoch_roundtrip_property)
}
