use runtime/memory.{*}
use stdlib/ord.{*}
use stdlib/time.{*}

fn time_option_has_value(opt: Option<Date>) -> i64 {
  match opt {
    Some(date) -> 1
    None -> 0
  }
}

fn time_epoch_roundtrip_property(i: i64) -> bool {
  let day = i - 16
  date_to_epoch_day(date_from_epoch_day(day)) == day
}

fn time_order_is_less(ordering: Ordering) -> bool {
  match ordering { Less -> true _ -> false }
}

fn time_order_is_equal(ordering: Ordering) -> bool {
  match ordering { Equal -> true _ -> false }
}

fn time_order_is_greater(ordering: Ordering) -> bool {
  match ordering { Greater -> true _ -> false }
}

test "time_duration_happy_paths" {
  Test.assert_eq(duration_to_millis(duration_millis(42)), 42)
  Test.assert_eq(duration_to_millis(duration_seconds(3)), 3000)
  Test.assert_eq(duration_to_millis(duration_minutes(2)), 120000)
  Test.assert_eq(duration_to_millis(duration_hours(2)), 7200000)
  Test.assert_eq(duration_to_millis(duration_days(2)), 172800000)
  Test.assert_eq(duration_to_seconds(duration_millis(2999)), 2)
}

test "time_duration_arithmetic_and_boundaries" {
  let a = duration_seconds(5)
  let b = duration_millis(250)
  Test.assert_eq(duration_to_millis(duration_add(a, b)), 5250)
  Test.assert_eq(duration_to_millis(duration_sub(a, b)), 4750)
  Test.assert_eq(duration_to_millis(duration_neg(b)), 0 - 250)
  Test.assert_true(time_order_is_less(duration_cmp(duration_millis(1), duration_millis(2))))
  Test.assert_true(time_order_is_greater(duration_cmp(duration_millis(2), duration_millis(1))))
  Test.assert_true(time_order_is_equal(duration_cmp(duration_millis(2), duration_millis(2))))
  Test.assert_eq(duration_to_millis(duration_clamp(duration_millis(5), duration_millis(10), duration_millis(20))), 10)
  Test.assert_eq(duration_to_millis(duration_clamp(duration_millis(25), duration_millis(10), duration_millis(20))), 20)
  Test.assert_eq(duration_to_millis(duration_clamp(duration_millis(15), duration_millis(10), duration_millis(20))), 15)
}

test "time_instant_happy_paths" {
  let start = instant_from_millis(1000)
  let later = instant_add(start, duration_seconds(3))
  let earlier = instant_sub(later, duration_millis(500))
  Test.assert_eq(instant_to_millis(start), 1000)
  Test.assert_eq(instant_to_millis(later), 4000)
  Test.assert_eq(instant_to_millis(earlier), 3500)
  Test.assert_eq(duration_to_millis(instant_duration_since(later, start)), 3000)
  Test.assert_eq(duration_to_millis(instant_duration_since(start, later)), 0 - 3000)
  Test.assert_true(time_order_is_less(instant_cmp(start, later)))
  Test.assert_true(time_order_is_greater(instant_cmp(later, start)))
  Test.assert_true(time_order_is_equal(instant_cmp(start, instant_from_millis(1000))))
}

test "time_effect_handler_happy_path" {
  let now = handle time_now() {
    Time.now_millis() -> resume(123456)
  }
  Test.assert_eq(instant_to_millis(now), 123456)
}

test "time_date_validity_happy_and_sad_paths" {
  Test.assert_true(date_is_leap_year(2000))
  Test.assert_true(date_is_leap_year(2024))
  Test.assert_false(date_is_leap_year(1900))
  Test.assert_false(date_is_leap_year(2023))
  Test.assert_eq(date_days_in_month(2024, 2), 29)
  Test.assert_eq(date_days_in_month(2023, 2), 28)
  Test.assert_eq(date_days_in_month(2023, 13), 0)
  Test.assert_true(date_is_valid(2024, 2, 29))
  Test.assert_false(date_is_valid(2023, 2, 29))
  Test.assert_false(date_is_valid(2023, 0, 1))
  Test.assert_false(date_is_valid(2023, 12, 0))
  Test.assert_eq(time_option_has_value(date_new_option(2024, 2, 29)), 1)
  Test.assert_eq(time_option_has_value(date_new_option(2023, 2, 29)), 0)
}

test "time_date_epoch_boundaries_and_weekdays" {
  Test.assert_eq(date_to_epoch_day(date_new(1970, 1, 1)), 0)
  Test.assert_eq(date_to_epoch_day(date_new(1970, 1, 2)), 1)
  Test.assert_eq(date_to_epoch_day(date_new(1969, 12, 31)), 0 - 1)
  let zero = date_from_epoch_day(0)
  let before = date_from_epoch_day(0 - 1)
  let after = date_from_epoch_day(11017)
  Test.assert_eq(date_year(zero), 1970)
  Test.assert_eq(date_month(zero), 1)
  Test.assert_eq(date_day(zero), 1)
  Test.assert_eq(date_year(before), 1969)
  Test.assert_eq(date_month(before), 12)
  Test.assert_eq(date_day(before), 31)
  Test.assert_eq(date_year(after), 2000)
  Test.assert_eq(date_month(after), 3)
  Test.assert_eq(date_day(after), 1)
  Test.assert_eq(date_day_of_week(date_new(1970, 1, 1)), 4)
  Test.assert_eq(date_day_of_week(date_new(1969, 12, 31)), 3)
}

test "time_date_add_days_table" {
  let leap_next = date_add_days(date_new(2024, 2, 28), 1)
  let leap_after = date_add_days(date_new(2024, 2, 28), 2)
  let non_leap_prev = date_add_days(date_new(2023, 3, 1), 0 - 1)
  Test.assert_eq(date_year(leap_next), 2024)
  Test.assert_eq(date_month(leap_next), 2)
  Test.assert_eq(date_day(leap_next), 29)
  Test.assert_eq(date_year(leap_after), 2024)
  Test.assert_eq(date_month(leap_after), 3)
  Test.assert_eq(date_day(leap_after), 1)
  Test.assert_eq(date_year(non_leap_prev), 2023)
  Test.assert_eq(date_month(non_leap_prev), 2)
  Test.assert_eq(date_day(non_leap_prev), 28)
}

test "property_time_epoch_day_roundtrips" {
  Test.forall_i64_range(0, 33, time_epoch_roundtrip_property)
}
