use runtime/memory.{*}
use stdlib/ord.{*}
use stdlib/option.{Option}
use stdlib/result.{Err, Ok, Result}
use stdlib/time as time
use stdlib/time.{Duration}
use stdlib/time/calendar as calendar
use stdlib/time/calendar.{Date, Friday, Monday, Saturday, Sunday, Thursday, Tuesday, Wednesday, Weekday}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{Instant, MonotonicClock}
use stdlib/time/sleep as sleep
use stdlib/time/sleep.{InvalidSleepDuration, Sleep, SleepDurationOutOfRange, SleepError, SleepInterrupted, SleepUnavailable}
use stdlib/time/wall as wall
use stdlib/time/wall.{Timestamp, WallClock, WallClockError, WallClockUnavailable}

fn time_option_has_value(opt: Option<Date>) -> i64 {
  match opt {
    Some(date) -> 1
    None -> 0
  }
}

fn time_epoch_roundtrip_property(i: i64) -> bool {
  let day = i - 16
  calendar.from_epoch_day(day).to_epoch_day() == day
}

fn time_weekday_index(weekday: Weekday) -> i64 {
  match weekday {
    Sunday -> 0
    Monday -> 1
    Tuesday -> 2
    Wednesday -> 3
    Thursday -> 4
    Friday -> 5
    Saturday -> 6
  }
}

fn time_order_is_less(ordering: Ordering) -> bool {
  match ordering { Less -> true _ -> false }
}

fn time_order_is_equal(ordering: Ordering) -> bool {
  match ordering { Equal -> true _ -> false }
}

fn time_order_is_greater(ordering: Ordering) -> bool {
  match ordering { Greater -> true _ -> false }
}

fn time_sleep_result_code(result: Result<nil, SleepError>) -> i64 {
  match result {
    Ok(nil) -> 0
    Err(error) -> match error {
      InvalidSleepDuration -> 1
      SleepDurationOutOfRange -> 2
      SleepInterrupted -> 3
      SleepUnavailable -> 4
    }
  }
}

test "time_duration_happy_paths" {
  Test.assert_eq(time.milliseconds(42).milliseconds(), 42)
  Test.assert_eq(time.seconds(3).milliseconds(), 3000)
  Test.assert_eq(time.minutes(2).milliseconds(), 120000)
  Test.assert_eq(time.hours(2).milliseconds(), 7200000)
  Test.assert_eq(time.days(2).milliseconds(), 172800000)
  Test.assert_eq(time.milliseconds(2999).whole_seconds(), 2)
}

test "time_duration_arithmetic_and_boundaries" {
  let a = time.seconds(5)
  let b = time.milliseconds(250)
  Test.assert_eq(a.add(b).milliseconds(), 5250)
  Test.assert_eq(a.subtract(b).milliseconds(), 4750)
  Test.assert_eq(b.negate().milliseconds(), 0 - 250)
  Test.assert_true(time_order_is_less(time.milliseconds(1).compare(time.milliseconds(2))))
  Test.assert_true(time_order_is_greater(time.milliseconds(2).compare(time.milliseconds(1))))
  Test.assert_true(time_order_is_equal(time.milliseconds(2).compare(time.milliseconds(2))))
  Test.assert_eq(time.milliseconds(5).clamp(time.milliseconds(10), time.milliseconds(20)).milliseconds(), 10)
  Test.assert_eq(time.milliseconds(25).clamp(time.milliseconds(10), time.milliseconds(20)).milliseconds(), 20)
  Test.assert_eq(time.milliseconds(15).clamp(time.milliseconds(10), time.milliseconds(20)).milliseconds(), 15)
}

test "time_instant_happy_paths" {
  let start = monotonic.nanoseconds(1000000000)
  let later = start.add(time.seconds(3))
  let earlier = later.subtract(time.milliseconds(500))
  Test.assert_eq(start.nanoseconds(), 1000000000)
  Test.assert_eq(later.nanoseconds(), 4000000000)
  Test.assert_eq(earlier.nanoseconds(), 3500000000)
  Test.assert_eq(later.duration_since(start).milliseconds(), 3000)
  Test.assert_eq(start.duration_since(later).milliseconds(), 0 - 3000)
  Test.assert_true(time_order_is_less(start.compare(later)))
  Test.assert_true(time_order_is_greater(later.compare(start)))
  Test.assert_true(time_order_is_equal(start.compare(monotonic.nanoseconds(1000000000))))
}

test "monotonic_clock_handler_happy_path" {
  let now = handle monotonic.now() {
    MonotonicClock.now() -> resume(monotonic.nanoseconds(123456))
  }
  Test.assert_eq(now.nanoseconds(), 123456)
}

test "wall_clock_has_typed_reading_and_failure" {
  let reading = handle wall.now() {
    WallClock.now() -> resume(Ok<Timestamp, WallClockError>(wall.milliseconds_since_unix_epoch(1700000000123)))
  }
  let unavailable = handle wall.now() {
    WallClock.now() -> resume(Err<Timestamp, WallClockError>(WallClockUnavailable))
  }
  match reading {
    Ok(timestamp) -> Test.assert_eq(timestamp.milliseconds_since_unix_epoch(), 1700000000123)
    Err(error) -> Test.assert_true(false)
  }
  match unavailable {
    Err(WallClockUnavailable) -> Test.assert_true(true)
    Ok(timestamp) -> Test.assert_true(false)
  }
}

test "time_sleep_has_typed_success_and_failure" {
  let succeeded = handle sleep.wait(time.milliseconds(3)) {
    Sleep.wait(duration) -> resume(sleep.result_from_platform_status(
      if duration.milliseconds() == 3 { 0 } else { 0 - 7 }
    ))
  }
  let interrupted = handle sleep.wait(time.milliseconds(3)) {
    Sleep.wait(duration) -> resume(sleep.result_from_platform_status(0 - 4))
  }
  let unavailable = handle sleep.wait(time.milliseconds(3)) {
    Sleep.wait(duration) -> resume(sleep.result_from_platform_status(0 - 9))
  }
  let out_of_range = handle sleep.wait(time.milliseconds(3)) {
    Sleep.wait(duration) -> resume(Err<nil, SleepError>(SleepDurationOutOfRange))
  }
  let invalid = handle sleep.wait(time.milliseconds(0 - 1)) {
    Sleep.wait(duration) -> resume(Ok<nil, SleepError>(nil))
  }
  Test.assert_eq(time_sleep_result_code(succeeded), 0)
  Test.assert_eq(time_sleep_result_code(out_of_range), 2)
  Test.assert_eq(time_sleep_result_code(interrupted), 3)
  Test.assert_eq(time_sleep_result_code(unavailable), 4)
  Test.assert_eq(time_sleep_result_code(invalid), 1)
}

test "time_date_validity_happy_and_sad_paths" {
  Test.assert_true(calendar.is_leap_year(2000))
  Test.assert_true(calendar.is_leap_year(2024))
  Test.assert_false(calendar.is_leap_year(1900))
  Test.assert_false(calendar.is_leap_year(2023))
  Test.assert_eq(calendar.days_in_month(2024, 2).unwrap(), 29)
  Test.assert_eq(calendar.days_in_month(2023, 2).unwrap(), 28)
  Test.assert_true(calendar.days_in_month(2023, 0).is_none())
  Test.assert_true(calendar.days_in_month(2023, 13).is_none())
  Test.assert_eq(calendar.days_in_year(2024), 366)
  Test.assert_eq(calendar.days_in_year(2023), 365)
  Test.assert_eq(time_option_has_value(calendar.date(2024, 2, 29)), 1)
  Test.assert_eq(time_option_has_value(calendar.date(2023, 2, 29)), 0)
  Test.assert_eq(time_option_has_value(calendar.date(2023, 0, 1)), 0)
  Test.assert_eq(time_option_has_value(calendar.date(2023, 12, 0)), 0)
}

test "time_date_epoch_boundaries_and_weekdays" {
  let epoch = calendar.date(1970, 1, 1).unwrap()
  Test.assert_eq(epoch.to_epoch_day(), 0)
  Test.assert_eq(calendar.date(1970, 1, 2).unwrap().to_epoch_day(), 1)
  Test.assert_eq(calendar.date(1969, 12, 31).unwrap().to_epoch_day(), 0 - 1)
  let zero = calendar.from_epoch_day(0)
  let before = calendar.from_epoch_day(0 - 1)
  let after = calendar.from_epoch_day(11017)
  Test.assert_eq(zero.year(), 1970)
  Test.assert_eq(zero.month(), 1)
  Test.assert_eq(zero.day(), 1)
  Test.assert_eq(before.year(), 1969)
  Test.assert_eq(before.month(), 12)
  Test.assert_eq(before.day(), 31)
  Test.assert_eq(after.year(), 2000)
  Test.assert_eq(after.month(), 3)
  Test.assert_eq(after.day(), 1)
  Test.assert_eq(time_weekday_index(epoch.weekday()), 4)
  Test.assert_eq(time_weekday_index(before.weekday()), 3)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(3).weekday()), 0)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(4).weekday()), 1)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(5).weekday()), 2)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(7).weekday()), 4)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(8).weekday()), 5)
  Test.assert_eq(time_weekday_index(calendar.from_epoch_day(9).weekday()), 6)
}

test "time_date_epoch_conversion_covers_the_full_i64_domain" {
  let minimum = 0 - 9223372036854775808
  let maximum = 9223372036854775807
  let minimum_date = calendar.from_epoch_day(minimum)
  let maximum_date = calendar.from_epoch_day(maximum)
  Test.assert_eq(minimum_date.to_epoch_day(), minimum)
  Test.assert_eq(maximum_date.to_epoch_day(), maximum)
  Test.assert_eq(calendar.from_epoch_day(0 - 1000000000).to_epoch_day(), 0 - 1000000000)
  Test.assert_eq(calendar.from_epoch_day(1000000000).to_epoch_day(), 1000000000)
  Test.assert_true(calendar.date(minimum_date.year(), minimum_date.month(), minimum_date.day()).is_some())
  Test.assert_true(calendar.date(maximum_date.year(), maximum_date.month(), maximum_date.day()).is_some())
  Test.assert_true(calendar.date(0 - 26000000000000001, 1, 1).is_none())
  Test.assert_true(calendar.date(26000000000000001, 1, 1).is_none())
}

test "time_date_add_days_table" {
  let leap = calendar.date(2024, 2, 28).unwrap()
  let leap_next = leap.add_days(1)
  let leap_after = leap.add_days(2)
  let non_leap_prev = calendar.date(2023, 3, 1).unwrap().add_days(0 - 1)
  Test.assert_eq(leap_next.year(), 2024)
  Test.assert_eq(leap_next.month(), 2)
  Test.assert_eq(leap_next.day(), 29)
  Test.assert_eq(leap_after.year(), 2024)
  Test.assert_eq(leap_after.month(), 3)
  Test.assert_eq(leap_after.day(), 1)
  Test.assert_eq(non_leap_prev.year(), 2023)
  Test.assert_eq(non_leap_prev.month(), 2)
  Test.assert_eq(non_leap_prev.day(), 28)
}

test "property_time_epoch_day_roundtrips" {
  Test.forall_i64_range(0, 33, time_epoch_roundtrip_property)
}
