-- Expected exit code: 3
type Option {
  Some(Int),
  None
}

trait Eq {
  fn eq(a: Int, b: Int) -> Bool
}

impl Eq<Int> {
  fn eq(a: Int, b: Int) -> Bool {
    a == b
  }
}

effect Console {
  fn print(msg: String) -> Nil
}

fn identity(x: Int) -> Int {
  x
}

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn lambda_test() -> Int {
  let f = x => x + 1
  42
}

fn main() {
  let result = add(1, 2)
  result
}
