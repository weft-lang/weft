-- test/guard_narrowing.weft -- nil-guard flow narrowing (guard narrowing)
--
-- `x != nil` / `x == nil` guards refine an immutable binding's type in
-- the positions the short-circuit contract (kernel.md 5.3.1) proves
-- conditionally executed: if-then under `!=`, if-else under `==`,
-- and-rhs under `!=`, or-rhs under `==`. Only the non-nil direction
-- binds, and only for immutable bindings. Rejection cases (unguarded
-- use, mut-binding guard) live in test/negative/narrowing_*.weft.

fn nw_len(s: str) -> i64 { __str_len(s) }

fn nw_if_then(x: str | nil) -> i64 {
  if x != nil { nw_len(x) } else { 0 }
}

fn nw_if_else(x: str | nil) -> i64 {
  if x == nil { 0 } else { nw_len(x) }
}

fn nw_nil_first_operand(x: str | nil) -> i64 {
  if nil != x { nw_len(x) } else { 0 }
}

fn nw_and_rhs(x: str | nil) -> bool {
  x != nil and nw_len(x) > 2
}

fn nw_or_rhs(x: str | nil) -> bool {
  x == nil or nw_len(x) > 2
}

fn nw_nested(x: str | nil, y: str | nil) -> i64 {
  if x != nil {
    if y != nil { nw_len(x) + nw_len(y) } else { nw_len(x) }
  } else { 0 }
}

fn nw_let_bound() -> i64 {
  let x: str | nil = "seven77"
  if x != nil { nw_len(x) } else { 0 }
}

test "narrow_if_then_branch_accepts_value" {
  Test.assert_eq(nw_if_then("hello"), 5)
}

test "narrow_if_then_branch_nil_takes_else" {
  Test.assert_eq(nw_if_then(nil), 0)
}

test "narrow_if_else_branch_accepts_value" {
  Test.assert_eq(nw_if_else("hi"), 2)
}

test "narrow_if_else_branch_nil_takes_then" {
  Test.assert_eq(nw_if_else(nil), 0)
}

test "narrow_nil_on_left_of_guard" {
  Test.assert_eq(nw_nil_first_operand("abcd"), 4)
}

test "narrow_and_rhs_sees_non_nil" {
  Test.assert_true(nw_and_rhs("abc"))
  Test.assert_false(nw_and_rhs("ab"))
  Test.assert_false(nw_and_rhs(nil))
}

test "narrow_or_rhs_sees_non_nil" {
  Test.assert_true(nw_or_rhs(nil))
  Test.assert_true(nw_or_rhs("abc"))
  Test.assert_false(nw_or_rhs("ab"))
}

test "narrow_nested_guards_stack" {
  Test.assert_eq(nw_nested("ab", "cde"), 5)
  Test.assert_eq(nw_nested("ab", nil), 2)
  Test.assert_eq(nw_nested(nil, "cde"), 0)
}

test "narrow_let_bound_optional" {
  Test.assert_eq(nw_let_bound(), 7)
}

test "narrow_if_expression_type_is_branch_union" {
  -- synth_if narrows too: the then-branch reads x at type str, so the
  -- whole if-expression checks as str against the annotation.
  let x: str | nil = "ok"
  let y: str = if x != nil { x } else { "fallback" }
  Test.assert_eq(__str_len(y), 2)
}
