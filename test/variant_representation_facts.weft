use module_fixtures/compiler_probe.{probe_check_source}
use compiler/ir.{*}
use compiler/pipeline.{*}
use stdlib/test.{Test}

fn variant_representation_count_insts(insts: IrInstList, allocated: bool) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let count = match inst {
        IrVariantInitI64(dst, tag, payloads, mask) -> if ir_variant_allocates(payloads) == allocated { 1 } else { 0 }
        _ -> 0
      }
      count + variant_representation_count_insts(rest, allocated)
    }
  }
}

fn variant_representation_count_blocks(blocks: IrBlockList, allocated: bool) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(id, params, insts, term), rest) ->
      variant_representation_count_insts(insts, allocated) + variant_representation_count_blocks(rest, allocated)
  }
}

fn variant_representation_count(source: str, name: str, allocated: bool) -> i64 {
  let typed = probe_check_source(__str_ptr(source), __str_len(source))
  let functions = pipeline_ir_functions(pipeline_lower_ir(typed))
  match pipeline_ir_function_list_find_hash(functions, pipeline_ir_native_hash_name(name)) {
    IrFunctionCons(IrFunction(hash, count, blocks, src), IrFunctionNil) -> variant_representation_count_blocks(blocks, allocated)
    _ -> 0 - 1
  }
}

test "lowering retains constructor identity independently of storage" {
  let source = "type Choice { Empty, Present(i64) } fn absent() -> Choice { Empty } fn present() -> Choice { Present(42) } fn main() -> i64 { 0 }"
  Test.assert_eq(variant_representation_count(source, "absent", false), 1)
  Test.assert_eq(variant_representation_count(source, "absent", true), 0)
  Test.assert_eq(variant_representation_count(source, "present", true), 1)
}

test "integer constants never acquire constructor identity" {
  let source = "fn number() -> i64 { 0 - 31337 } fn main() -> i64 { 0 }"
  Test.assert_eq(variant_representation_count(source, "number", false), 0)
  Test.assert_eq(variant_representation_count(source, "number", true), 0)
}

test "allocation census distinguishes immediate and backed constructors" {
  let immediate = IrVariantInitI64(0, 31337, IrValueNil, 0)
  let backed = IrVariantInitI64(2, 31338, IrValueCons(1, IrValueNil), 0)
  let census = pipeline_rc_site_census_new()
  pipeline_rc_site_census_insts(IrInstCons(immediate, IrInstCons(backed, IrInstNil)), census)
  Test.assert_eq(pipeline_rc_site_census_get(census, 0), 1)
}

test "immediate constructors do not claim fresh managed storage" {
  let immediate = IrVariantInitI64(0, 31337, IrValueNil, 0)
  let backed = IrVariantInitI64(2, 31338, IrValueCons(1, IrValueNil), 0)
  let empty = pipeline_ir_live_set_empty()
  let facts = pipeline_ir_semantic_facts_empty()
  let fresh = pipeline_ir_fresh_return_add_inst(backed, facts, pipeline_ir_fresh_return_add_inst(immediate, facts, empty))
  Test.assert_eq(pipeline_ir_live_set_contains(fresh, 0), 0)
  Test.assert_eq(pipeline_ir_live_set_contains(fresh, 2), 1)
  Test.assert_eq(pipeline_ir_reuse_shape_for_inst(immediate), 0)
}

test "immediate constructors preserve registers and floating point state" {
  let immediate = IrVariantInitI64(0, 31337, IrValueNil, 0)
  let backed = IrVariantInitI64(2, 31338, IrValueCons(1, IrValueNil), 0)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(immediate), 0)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(backed), 1)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(immediate), 1)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(backed), 0)
  Test.assert_true(not pipeline_ir_intervals_inst_is_call(immediate))
  Test.assert_true(pipeline_ir_intervals_inst_is_call(backed))
}
