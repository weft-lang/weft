use stdlib/drop.{Drop}

trait QualifiedConsume {
  type Item
  fn consume(self: Self) -> Self.Item
}

type QualifiedUniqueBox {
  value: i64
}

impl QualifiedConsume for unique QualifiedUniqueBox {
  type Item = i64

  fn consume(self: unique QualifiedUniqueBox) -> i64 {
    self.value
  }
}

type QualifiedOwnedToken = opaque i64

impl Drop for QualifiedOwnedToken {
  fn drop(self) -> nil { nil }
}

impl QualifiedConsume for owned QualifiedOwnedToken {
  type Item = i64

  fn consume(self: owned QualifiedOwnedToken) -> i64 {
    match self {
      QualifiedOwnedToken(value) -> value
    }
  }
}

type QualifiedSharedBox {
  value: i64
}

impl QualifiedConsume for QualifiedSharedBox {
  type Item = i64

  fn consume(self: QualifiedSharedBox) -> i64 {
    self.value
  }
}

fn qualified_owned_token(value: i64) -> owned QualifiedOwnedToken {
  QualifiedOwnedToken(value)
}

fn qualified_increment(value: i64) -> i64 { value + 1 }

fn qualified_transform<T, U, S: QualifiedConsume & {type Item = T}>(
  source: S,
  transform: (T) -> U
) -> U {
  transform(source.consume())
}

test "qualified unique protocol target dispatches directly" {
  let source: unique QualifiedUniqueBox = QualifiedUniqueBox { value: 40 }
  Test.assert_eq(source.consume(), 40)
}

test "qualified owned protocol target dispatches directly" {
  Test.assert_eq(qualified_owned_token(41).consume(), 41)
}

test "generic inference preserves unique and owned conformance targets" {
  let unique_source: unique QualifiedUniqueBox = QualifiedUniqueBox { value: 40 }
  Test.assert_eq(qualified_transform(unique_source, qualified_increment), 41)
  Test.assert_eq(qualified_transform(qualified_owned_token(41), qualified_increment), 42)
}

test "unqualified protocol targets retain ordinary conformance" {
  let source = QualifiedSharedBox { value: 41 }
  Test.assert_eq(qualified_transform(source, qualified_increment), 42)
}
