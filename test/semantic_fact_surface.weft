use compiler/ir.{ir_borrow_summary_known, ir_borrow_summary_unknown, ir_value_list_empty, ir_value_list_prepend}
use compiler/pipeline.{TypedModule, pipeline_check_source, pipeline_ir_semantic_borrow_summary_for_entry}
use compiler/semantic_fact.{*}
use compiler/type_registry.{ttable_new}
use compiler/types.{*}
use stdlib/semantic_type.{*}
use stdlib/string.{str_find, str_find_from}

fn semantic_fact_test_query(source: str, name: str) -> SemanticFactEnvelope {
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> semantic_fact_query_function(tt, src, name)
  }
}

fn semantic_fact_test_query_with_ownership(source: str, name: str) -> SemanticFactEnvelope {
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> {
      let entry = semantic_fact_resolve_function_entry(tt, src, name)
      semantic_fact_function_entry_with_ownership(
        tt,
        entry,
        semantic_fact_ownership_from_borrow_summary(pipeline_ir_semantic_borrow_summary_for_entry(fns, tt, entry))
      )
    }
  }
}

fn semantic_fact_old_purity_reader(value: SemanticPurityFact) -> i64 {
  match value {
    SemanticPurityPure -> 1
    SemanticPurityEffectful -> 2
    SemanticPurityOpen -> 3
    SemanticPurityOther(name) -> 4
  }
}

fn semantic_fact_old_envelope_reader(value: SemanticFactEnvelope) -> i64 {
  match value {
    SemanticFactEnvelope(version, result) -> 1
    SemanticFactEnvelopeOther(name) -> 0
  }
}

fn semantic_fact_old_conformance_reader(value: SemanticConformanceDecisionFact) -> i64 {
  match value {
    SemanticConformanceYes -> 1
    SemanticConformanceNo -> 2
    SemanticConformanceUnknown(reason) -> 3
    SemanticConformanceDecisionOther(name) -> 4
  }
}

fn semantic_fact_old_ownership_reader(value: SemanticOwnershipFact) -> i64 {
  match value {
    SemanticOwnershipUnknown -> 1
    SemanticOwnershipBorrowedParameters(indices) -> 2
    SemanticOwnershipOther(name) -> 3
  }
}

fn semantic_fact_old_shape_reader(value: SemanticValueShapeFact) -> i64 {
  match value {
    SemanticValueShapeUnknown -> 1
    SemanticValueShapeWords(count) -> 2
    SemanticValueShapeExactWords(count, lanes) -> 3
    SemanticValueShapeOther(name) -> 4
  }
}

fn semantic_fact_old_bounds_reader(value: SemanticBoundsFact) -> i64 {
  match value {
    SemanticBoundsUnknown -> 1
    SemanticBoundsTraits(traits) -> 2
    SemanticBoundsTypeParameters(params) -> 3
    SemanticBoundsOther(name) -> 4
  }
}

test "semantic_fact_schema_is_versioned_and_other_extensible" {
  match semantic_fact_schema_version() {
    SemanticFactSchemaV1 -> Test.assert_eq(1, 1)
    SemanticFactSchemaVersionOther(name) -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(semantic_fact_old_purity_reader(SemanticPurityOther("future-purity")), 4)
  Test.assert_eq(semantic_fact_old_envelope_reader(SemanticFactEnvelopeOther("future-envelope")), 0)
  Test.assert_eq(semantic_fact_old_conformance_reader(SemanticConformanceDecisionOther("future-decision")), 4)
  Test.assert_eq(semantic_fact_old_ownership_reader(SemanticOwnershipOther("future-ownership")), 3)
  Test.assert_eq(semantic_fact_old_shape_reader(SemanticValueShapeOther("future-shape")), 4)
  Test.assert_eq(semantic_fact_old_bounds_reader(SemanticBoundsOther("future-bounds")), 4)
}

test "semantic_fact_query_reports_missing_without_checker_catalog" {
  match semantic_fact_query_function(ttable_new(), __str_ptr("missing"), "missing") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_borrow_projection_sorts_and_deduplicates_parameter_indices" {
  let indices = ir_value_list_prepend(1, ir_value_list_prepend(0, ir_value_list_prepend(1, ir_value_list_empty())))
  match semantic_fact_ownership_from_borrow_summary(ir_borrow_summary_known(indices)) {
    SemanticOwnershipBorrowedParameters(SemanticIndexFactListCons(0, SemanticIndexFactListCons(1, SemanticIndexFactListNil))) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
  match semantic_fact_ownership_from_borrow_summary(ir_borrow_summary_unknown()) {
    SemanticOwnershipUnknown -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_function_ownership_uses_interprocedural_borrow_producer" {
  let source = "fn choose(xs: [i64], ys: [i64], first: bool) -> [i64] { if first { xs } else { ys } } fn forward(xs: [i64], ys: [i64], first: bool) -> [i64] { choose(xs, ys, first) }"
  match semantic_fact_test_query_with_ownership(source, "forward") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, SemanticOwnershipBorrowedParameters(indices), shape, bounds)))) -> {
      match indices {
        SemanticIndexFactListCons(0, SemanticIndexFactListCons(1, SemanticIndexFactListNil)) -> Test.assert_eq(1, 1)
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_function_ownership_preserves_known_empty_summary" {
  let scalar = "fn scalar(value: i64) -> i64 { value }"
  match semantic_fact_test_query_with_ownership(scalar, "scalar") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, SemanticOwnershipBorrowedParameters(SemanticIndexFactListNil), shape, bounds)))) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_publishes_generic_pure_signature" {
  let source = "fn fact_identity<T>(value: T) -> T { value }"
  match semantic_fact_test_query(source, "fact_identity") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      Test.assert_str_eq(name, "fact_identity")
      match params {
        SemanticParameterFactListCons(SemanticParameter(param_name, SemanticTypeVariable(param_type)), SemanticParameterFactListNil) -> {
          Test.assert_str_eq(param_name, "value")
          Test.assert_str_eq(param_type, "T")
        }
        _ -> Test.assert_eq(0, 1)
      }
      match result {
        SemanticTypeVariable(type_name) -> Test.assert_str_eq(type_name, "T")
        _ -> Test.assert_eq(0, 1)
      }
      match effects {
        SemanticEffectsClosed(SemanticEffectAtomFactListNil) -> Test.assert_eq(1, 1)
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 1)
      match ownership { SemanticOwnershipUnknown -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
      match shape { SemanticValueShapeUnknown -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
      match bounds {
        SemanticBoundsTypeParameters(SemanticTypeParameterFactListCons(SemanticTypeParameter(param_name, SemanticBoundsTraits(SemanticTraitBoundFactListNil)), SemanticTypeParameterFactListNil)) -> Test.assert_str_eq(param_name, "T")
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
  -- The stable checker envelope projects representation-neutral return-alias
  -- facts for an unspecialised generic without publishing them as slice-only
  -- IR borrow provenance.
  match semantic_fact_test_query_with_ownership(source, "fact_identity") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, SemanticOwnershipBorrowedParameters(SemanticIndexFactListCons(index, SemanticIndexFactListNil)), shape, bounds)))) -> Test.assert_eq(index, 0)
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_function_publishes_exact_mixed_return_layout" {
  let source = "fn fact_layout() -> (f32, f64, i64) { (1.0, 2.0, 3) }"
  match semantic_fact_test_query(source, "fact_layout") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, SemanticValueShapeExactWords(3, lanes), bounds)))) -> {
      match lanes {
        SemanticValueLaneFactListCons(SemanticValueLaneF32, SemanticValueLaneFactListCons(SemanticValueLaneF64, SemanticValueLaneFactListCons(SemanticValueLaneGpr, SemanticValueLaneFactListNil))) -> Test.assert_eq(1, 1)
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_function_publishes_resolved_multi_trait_bounds" {
  let source = "trait FactFirst { } trait FactSecond { } fn fact_bounded<T: FactFirst & FactSecond>(value: T) -> T { value }"
  match semantic_fact_test_query(source, "fact_bounded") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, SemanticBoundsTypeParameters(SemanticTypeParameterFactListCons(SemanticTypeParameter(param, traits), SemanticTypeParameterFactListNil)))))) -> {
      Test.assert_str_eq(param, "T")
      match traits {
        SemanticBoundsTraits(SemanticTraitBoundFactListCons(SemanticTraitBound(first), SemanticTraitBoundFactListCons(SemanticTraitBound(second), SemanticTraitBoundFactListNil))) -> {
          Test.assert_str_eq(first, "FactFirst")
          Test.assert_str_eq(second, "FactSecond")
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_preserves_parameterized_effect_atom" {
  let source = "effect FactState<S> { fn get() -> S } fn fact_read<S>() -[FactState<S>]> S { FactState.get() }"
  match semantic_fact_test_query(source, "fact_read") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      match effects {
        SemanticEffectsClosed(SemanticEffectAtomFactListCons(SemanticEffectAtom(atom_name, SemanticTypeFactListCons(SemanticTypeVariable(arg_name), SemanticTypeFactListNil)), SemanticEffectAtomFactListNil)) -> {
          Test.assert_str_eq(atom_name, "FactState")
          Test.assert_str_eq(arg_name, "S")
        }
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 2)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_preserves_open_effect_tail" {
  let source = "fn fact_invoke<E>(body: () -[E]> i64) -[E]> i64 { body() }"
  match semantic_fact_test_query(source, "fact_invoke") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      match effects {
        SemanticEffectsOpen(SemanticEffectAtomFactListNil, tail) -> Test.assert_str_eq(tail, "E")
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 3)
      match params {
        SemanticParameterFactListCons(SemanticParameter(param_name, SemanticTypeFunction(SemanticTypeFactListNil, SemanticTypePrimitive(return_name), SemanticEffectsOpen(SemanticEffectAtomFactListNil, callback_tail))), SemanticParameterFactListNil) -> {
          Test.assert_str_eq(param_name, "body")
          Test.assert_str_eq(return_name, "i64")
          Test.assert_str_eq(callback_tail, "E")
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_type_projection_uses_source_vocabulary" {
  let tt = ttable_new()
  match semantic_fact_type(ty_array(ty_mut_slice(ty_i64()), 4), tt, __str_ptr(""), 0) {
    SemanticTypeArray(SemanticTypeSlice(SemanticTypePrimitive(name), mutable), length) -> {
      Test.assert_str_eq(name, "i64")
      Test.assert_eq(if mutable { 1 } else { 0 }, 1)
      Test.assert_eq(length, 4)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_type_projection_preserves_resource_borrow_mode" {
  let tt = ttable_new()
  match semantic_fact_type(ty_borrow_mut(ty_named(4242, ty_i64())), tt, __str_ptr(""), 0) {
    SemanticTypeBorrow(inner, mutable) -> {
      Test.assert_eq(if mutable { 1 } else { 0 }, 1)
      match inner {
        SemanticTypeNamed(name, args) -> Test.assert_eq(1, 1)
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_preserves_resource_borrow_contracts" {
  let source = "use stdlib/drop.{*} type FactToken = opaque i64 impl Drop for FactToken { fn drop(self) -> nil { nil } } fn fact_borrows(shared: borrow FactToken, exclusive: borrow mut FactToken) -> i64 { 0 }"
  match semantic_fact_test_query(source, "fact_borrows") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, SemanticParameterFactListCons(SemanticParameter(shared_name, SemanticTypeBorrow(shared_inner, shared_mut)), SemanticParameterFactListCons(SemanticParameter(exclusive_name, SemanticTypeBorrow(exclusive_inner, exclusive_mut)), SemanticParameterFactListNil)), result, effects, purity, ownership, shape, bounds)))) -> {
      Test.assert_str_eq(shared_name, "shared")
      Test.assert_str_eq(exclusive_name, "exclusive")
      Test.assert_eq(if shared_mut { 1 } else { 0 }, 0)
      Test.assert_eq(if exclusive_mut { 1 } else { 0 }, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_publishes_type_declaration_fact" {
  let source = "type FactPair<T> { left: T, right: i64 } fn main() -> i64 { 0 }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_type(tt, src, "FactPair") {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactTypeDeclaration(SemanticTypeDeclaration(name, SemanticTypeDeclarationRecord, SemanticTypeParameterFactListCons(SemanticTypeParameter(param, SemanticBoundsTraits(SemanticTraitBoundFactListNil)), SemanticTypeParameterFactListNil), items)))) -> {
        Test.assert_str_eq(name, "FactPair")
        Test.assert_str_eq(param, "T")
        Test.assert_eq(items, 2)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_checker_publishes_effect_operation_fact" {
  let source = "effect FactBox<T> { @deferred fn get(value: T) -> T } fn main() -> i64 { 0 }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_effect(tt, src, "FactBox") {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(SemanticEffectDeclaration(name, SemanticTypeParameterFactListCons(SemanticTypeParameter(param, SemanticBoundsTraits(SemanticTraitBoundFactListNil)), SemanticTypeParameterFactListNil), SemanticEffectOperationFactListCons(SemanticEffectOperation(operation, SemanticParameterFactListCons(SemanticParameter(value_name, SemanticTypeVariable(value_type)), SemanticParameterFactListNil), SemanticTypeVariable(return_type), deferred), SemanticEffectOperationFactListNil))))) -> {
        Test.assert_str_eq(name, "FactBox")
        Test.assert_str_eq(param, "T")
        Test.assert_str_eq(operation, "get")
        Test.assert_str_eq(value_name, "value")
        Test.assert_str_eq(value_type, "T")
        Test.assert_str_eq(return_type, "T")
        Test.assert_eq(if deferred { 1 } else { 0 }, 1)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_effect_operation_preserves_resource_borrow_modes" {
  let source = "use stdlib/drop.{*} type FactEffectToken = opaque i64 impl Drop for FactEffectToken { fn drop(self) -> nil { nil } } effect FactBorrowEffect { fn inspect(shared: borrow FactEffectToken, exclusive: borrow mut FactEffectToken) -> i64 } fn main() -> i64 { 0 }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_effect(tt, src, "FactBorrowEffect") {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(SemanticEffectDeclaration(name, params, SemanticEffectOperationFactListCons(SemanticEffectOperation(operation, SemanticParameterFactListCons(SemanticParameter(shared_name, SemanticTypeBorrow(shared_inner, shared_mut)), SemanticParameterFactListCons(SemanticParameter(exclusive_name, SemanticTypeBorrow(exclusive_inner, exclusive_mut)), SemanticParameterFactListNil)), result, deferred), SemanticEffectOperationFactListNil))))) -> {
        Test.assert_str_eq(name, "FactBorrowEffect")
        Test.assert_str_eq(operation, "inspect")
        Test.assert_str_eq(shared_name, "shared")
        Test.assert_str_eq(exclusive_name, "exclusive")
        Test.assert_eq(if shared_mut { 1 } else { 0 }, 0)
        Test.assert_eq(if exclusive_mut { 1 } else { 0 }, 1)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_reports_missing_between_symbols" {
  let source = "fn fact_gap(value: i64) -> i64 { value }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, str_find(source, "->")) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) -> Test.assert_eq(1, 1)
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_resolves_parameter_use_to_definition" {
  let source = "fn fact_param(value: i64) -> i64 { value }"
  let definition = str_find(source, "value")
  let occurrence = str_find_from(source, "value", definition + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolParameter, SemanticTypePrimitive(type_name), SemanticSourceLocation(use_path, use_start, use_len), SemanticSourceLocation(def_path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "value")
        Test.assert_str_eq(type_name, "i64")
        Test.assert_str_eq(use_path, "")
        Test.assert_eq(use_start, occurrence)
        Test.assert_eq(use_len, 5)
        Test.assert_str_eq(def_path, "")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_uses_the_winning_shadowed_local" {
  let source = "fn fact_shadow(value: i64) -> i64 { let value: str = \"x\"; __str_len(value) }"
  let parameter = str_find(source, "value")
  let definition = str_find_from(source, "value", parameter + 1)
  let occurrence = str_find_from(source, "value", definition + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolLocal, SemanticTypePrimitive(type_name), use_location, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "value")
        Test.assert_str_eq(type_name, "str")
        Test.assert_str_eq(path, "")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_resolves_recursive_destructuring_binding" {
  let source = "fn fact_destructure(value: ((i64, str), i64)) -> i64 { let ((left, label), right) = value; __str_len(label) + left + right }"
