}

test "semantic_fact_conformance_uses_resolved_trait_identity" {
  let source = "trait FactMark { fn mark(self) -> i64 } impl FactMark for i64 { fn mark(self: i64) -> i64 { self } } fn fact_conformance(value: i64, other: bool) -> bool { if value == 0 { other } else { other } }"
  let value_use = str_find_from(source, "value", str_find(source, "if value"))
  let other_use = str_find_from(source, "other", str_find(source, "{ other"))
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> {
      match semantic_fact_query_conformance_at(tt, src, value_use + 5, "FactMark") {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactConformance(SemanticConformance(SemanticTypePrimitive(type_name), trait_name, SemanticConformanceYes)))) -> {
          Test.assert_str_eq(type_name, "i64")
          Test.assert_str_eq(trait_name, "FactMark")
        }
        _ -> Test.assert_eq(0, 1)
      }
      match semantic_fact_query_conformance_at(tt, src, other_use, "FactMark") {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactConformance(SemanticConformance(SemanticTypePrimitive(type_name), trait_name, SemanticConformanceNo)))) -> Test.assert_str_eq(type_name, "bool")
        _ -> Test.assert_eq(0, 1)
      }
    }
  }
}

