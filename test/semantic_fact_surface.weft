use compiler/pipeline.{TypedModule, pipeline_check_source}
use compiler/semantic_fact.{*}
use compiler/type_registry.{ttable_new}
use compiler/types.{*}
use stdlib/string.{str_find, str_find_from}

fn semantic_fact_test_query(source: str, name: str) -> SemanticFactEnvelope {
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> semantic_fact_query_function(tt, src, name)
  }
}

fn semantic_fact_old_purity_reader(value: SemanticPurityFact) -> i64 {
  match value {
    SemanticPurityPure -> 1
    SemanticPurityEffectful -> 2
    SemanticPurityOpen -> 3
    SemanticPurityOther(name) -> 4
  }
}

fn semantic_fact_old_envelope_reader(value: SemanticFactEnvelope) -> i64 {
  match value {
    SemanticFactEnvelope(version, result) -> 1
    SemanticFactEnvelopeOther(name) -> 0
  }
}

test "semantic_fact_schema_is_versioned_and_other_extensible" {
  match semantic_fact_schema_version() {
    SemanticFactSchemaV1 -> Test.assert_eq(1, 1)
    SemanticFactSchemaVersionOther(name) -> Test.assert_eq(0, 1)
  }
  Test.assert_eq(semantic_fact_old_purity_reader(SemanticPurityOther("future-purity")), 4)
  Test.assert_eq(semantic_fact_old_envelope_reader(SemanticFactEnvelopeOther("future-envelope")), 0)
}

test "semantic_fact_query_reports_missing_without_checker_catalog" {
  match semantic_fact_query_function(ttable_new(), __str_ptr("missing"), "missing") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) -> Test.assert_eq(1, 1)
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_publishes_generic_pure_signature" {
  let source = "fn fact_identity<T>(value: T) -> T { value }"
  match semantic_fact_test_query(source, "fact_identity") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      Test.assert_str_eq(name, "fact_identity")
      match params {
        SemanticParameterFactListCons(SemanticParameter(param_name, SemanticTypeVariable(param_type)), SemanticParameterFactListNil) -> {
          Test.assert_str_eq(param_name, "value")
          Test.assert_str_eq(param_type, "T")
        }
        _ -> Test.assert_eq(0, 1)
      }
      match result {
        SemanticTypeVariable(type_name) -> Test.assert_str_eq(type_name, "T")
        _ -> Test.assert_eq(0, 1)
      }
      match effects {
        SemanticEffectsClosed(SemanticEffectAtomFactListNil) -> Test.assert_eq(1, 1)
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 1)
      match ownership { SemanticOwnershipUnknown -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
      match shape { SemanticValueShapeUnknown -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
      match bounds { SemanticBoundsUnknown -> Test.assert_eq(1, 1) _ -> Test.assert_eq(0, 1) }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_preserves_parameterized_effect_atom" {
  let source = "effect FactState<S> { fn get() -> S } fn fact_read<S>() -[FactState<S>]> S { FactState.get() }"
  match semantic_fact_test_query(source, "fact_read") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      match effects {
        SemanticEffectsClosed(SemanticEffectAtomFactListCons(SemanticEffectAtom(atom_name, SemanticTypeFactListCons(SemanticTypeVariable(arg_name), SemanticTypeFactListNil)), SemanticEffectAtomFactListNil)) -> {
          Test.assert_str_eq(atom_name, "FactState")
          Test.assert_str_eq(arg_name, "S")
        }
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 2)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_preserves_open_effect_tail" {
  let source = "fn fact_invoke<E>(body: () -[E]> i64) -[E]> i64 { body() }"
  match semantic_fact_test_query(source, "fact_invoke") {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(SemanticFunction(name, params, result, effects, purity, ownership, shape, bounds)))) -> {
      match effects {
        SemanticEffectsOpen(SemanticEffectAtomFactListNil, tail) -> Test.assert_str_eq(tail, "E")
        _ -> Test.assert_eq(0, 1)
      }
      Test.assert_eq(semantic_fact_old_purity_reader(purity), 3)
      match params {
        SemanticParameterFactListCons(SemanticParameter(param_name, SemanticTypeFunction(SemanticTypeFactListNil, SemanticTypePrimitive(return_name), SemanticEffectsOpen(SemanticEffectAtomFactListNil, callback_tail))), SemanticParameterFactListNil) -> {
          Test.assert_str_eq(param_name, "body")
          Test.assert_str_eq(return_name, "i64")
          Test.assert_str_eq(callback_tail, "E")
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_type_projection_uses_source_vocabulary" {
  let tt = ttable_new()
  match semantic_fact_type(ty_array(ty_mut_slice(ty_i64()), 4), tt, __str_ptr(""), 0) {
    SemanticTypeArray(SemanticTypeSlice(SemanticTypePrimitive(name), mutable), length) -> {
      Test.assert_str_eq(name, "i64")
      Test.assert_eq(if mutable { 1 } else { 0 }, 1)
      Test.assert_eq(length, 4)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "semantic_fact_checker_publishes_type_declaration_fact" {
  let source = "type FactPair<T> { left: T, right: i64 } fn main() -> i64 { 0 }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_type(tt, src, "FactPair") {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactTypeDeclaration(SemanticTypeDeclaration(name, SemanticTypeDeclarationRecord, SemanticTypeParameterFactListCons(SemanticTypeParameter(param, SemanticBoundsUnknown), SemanticTypeParameterFactListNil), items)))) -> {
        Test.assert_str_eq(name, "FactPair")
        Test.assert_str_eq(param, "T")
        Test.assert_eq(items, 2)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_checker_publishes_effect_operation_fact" {
  let source = "effect FactBox<T> { @deferred fn get(value: T) -> T } fn main() -> i64 { 0 }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_effect(tt, src, "FactBox") {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(SemanticEffectDeclaration(name, SemanticTypeParameterFactListCons(SemanticTypeParameter(param, SemanticBoundsUnknown), SemanticTypeParameterFactListNil), SemanticEffectOperationFactListCons(SemanticEffectOperation(operation, SemanticParameterFactListCons(SemanticParameter(value_name, SemanticTypeVariable(value_type)), SemanticParameterFactListNil), SemanticTypeVariable(return_type), deferred), SemanticEffectOperationFactListNil))))) -> {
        Test.assert_str_eq(name, "FactBox")
        Test.assert_str_eq(param, "T")
        Test.assert_str_eq(operation, "get")
        Test.assert_str_eq(value_name, "value")
        Test.assert_str_eq(value_type, "T")
        Test.assert_str_eq(return_type, "T")
        Test.assert_eq(if deferred { 1 } else { 0 }, 1)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_reports_missing_between_symbols" {
  let source = "fn fact_gap(value: i64) -> i64 { value }"
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, str_find(source, "->")) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) -> Test.assert_eq(1, 1)
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_resolves_parameter_use_to_definition" {
  let source = "fn fact_param(value: i64) -> i64 { value }"
  let definition = str_find(source, "value")
  let occurrence = str_find_from(source, "value", definition + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolParameter, SemanticTypePrimitive(type_name), SemanticSourceLocation(use_path, use_start, use_len), SemanticSourceLocation(def_path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "value")
        Test.assert_str_eq(type_name, "i64")
        Test.assert_str_eq(use_path, "")
        Test.assert_eq(use_start, occurrence)
        Test.assert_eq(use_len, 5)
        Test.assert_str_eq(def_path, "")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_uses_the_winning_shadowed_local" {
  let source = "fn fact_shadow(value: i64) -> i64 { let value: str = \"x\"; __str_len(value) }"
  let parameter = str_find(source, "value")
  let definition = str_find_from(source, "value", parameter + 1)
  let occurrence = str_find_from(source, "value", definition + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolLocal, SemanticTypePrimitive(type_name), use_location, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "value")
        Test.assert_str_eq(type_name, "str")
        Test.assert_str_eq(path, "")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_resolves_recursive_destructuring_binding" {
  let source = "fn fact_destructure(value: ((i64, str), i64)) -> i64 { let ((left, label), right) = value; __str_len(label) + left + right }"
  let definition = str_find(source, "label")
  let occurrence = str_find_from(source, "label", definition + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolPattern, SemanticTypePrimitive(type_name), use_location, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "label")
        Test.assert_str_eq(type_name, "str")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_preserves_definition_while_narrowing_type" {
  let source = "fn fact_narrow(value: str?) -> i64 { if value != nil { __str_len(value) } else { 0 } }"
  let definition = str_find(source, "value")
  let guard = str_find_from(source, "value", definition + 1)
  let occurrence = str_find_from(source, "value", guard + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolParameter, SemanticTypePrimitive(type_name), use_location, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(name, "value")
        Test.assert_str_eq(type_name, "str")
        Test.assert_eq(def_start, definition)
        Test.assert_eq(def_len, 5)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_publishes_exact_effect_operation_use" {
  let source = "effect FactUse<S> { fn get() -> S fn put(value: S) -> nil } fn fact_use() -[FactUse<i64>]> i64 { FactUse.get() }"
  let declared_get = str_find(source, "get")
  let occurrence = str_find_from(source, "get", declared_get + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectOperationUse(SemanticEffectOperationUse(SemanticEffectAtom(atom_name, SemanticTypeFactListCons(SemanticTypePrimitive(atom_arg), SemanticTypeFactListNil)), operation, SemanticTypeFunction(SemanticTypeFactListNil, SemanticTypePrimitive(return_name), SemanticEffectsClosed(SemanticEffectAtomFactListCons(SemanticEffectAtom(effect_name, SemanticTypeFactListCons(SemanticTypePrimitive(effect_arg), SemanticTypeFactListNil)), SemanticEffectAtomFactListNil))), occurrence_location, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(atom_name, "FactUse")
        Test.assert_str_eq(atom_arg, "i64")
        Test.assert_str_eq(operation, "get")
        Test.assert_str_eq(return_name, "i64")
        Test.assert_str_eq(effect_name, "FactUse")
        Test.assert_str_eq(effect_arg, "i64")
        Test.assert_eq(def_start, declared_get)
        Test.assert_eq(def_len, 3)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_publishes_exact_handler_clause_operation" {
  let source = "effect FactHandle<S> { fn get() -> S } fn fact_handle_go() -[FactHandle<i64>]> i64 { FactHandle.get() } fn main() -> i64 { handle fact_handle_go() { FactHandle<i64>.get() -> resume(42) } }"
  let declared_get = str_find(source, "get")
  let perform_get = str_find_from(source, "get", declared_get + 1)
  let clause_get = str_find_from(source, "get", perform_get + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, clause_get) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectOperationUse(SemanticEffectOperationUse(SemanticEffectAtom(atom_name, SemanticTypeFactListCons(SemanticTypePrimitive(atom_arg), SemanticTypeFactListNil)), operation, SemanticTypeFunction(params, SemanticTypePrimitive(return_name), effects), occurrence, SemanticSourceLocation(path, def_start, def_len))))) -> {
        Test.assert_str_eq(atom_name, "FactHandle")
        Test.assert_str_eq(atom_arg, "i64")
        Test.assert_str_eq(operation, "get")
        Test.assert_str_eq(return_name, "i64")
        Test.assert_eq(def_start, declared_get)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_resolves_impl_associated_type_use" {
  let source = "trait FactAssoc { type Item fn get(self, value: Self.Item) -> Self.Item } type FactAssocBox { value: i64 } impl FactAssoc for FactAssocBox { type Item = [i64; 4] fn get(self, value: Self.Item) -> Self.Item { value } } fn main() -> i64 { 0 }"
  let binding = str_find(source, "type Item =") + 5
  let occurrence = str_find_from(source, "Self.Item", binding)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactAssociatedTypeUse(SemanticAssociatedTypeUse(SemanticTypeNamed(base_name, SemanticTypeFactListNil), assoc_name, SemanticTypeArray(SemanticTypePrimitive(element_name), length), SemanticSourceLocation(use_path, use_start, use_len), SemanticSourceLocation(def_path, def_start, def_len))))) -> {
        Test.assert_str_eq(base_name, "FactAssocBox")
        Test.assert_str_eq(assoc_name, "Item")
        Test.assert_str_eq(element_name, "i64")
        Test.assert_eq(length, 4)
        Test.assert_eq(use_start, occurrence)
        Test.assert_eq(use_len, 9)
        Test.assert_eq(def_start, binding)
        Test.assert_eq(def_len, 4)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_publishes_tuple_position_without_definition" {
  let source = "fn fact_tuple(value: (i64, str)) -> str { value.1 }"
  let occurrence = str_find(source, ".1") + 1
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, occurrence) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(SemanticSymbol(name, SemanticSymbolTuplePosition, SemanticTypePrimitive(type_name), SemanticSourceLocation(use_path, use_start, use_len), SemanticSourceLocationOther(definition))))) -> {
        Test.assert_str_eq(name, "1")
        Test.assert_str_eq(type_name, "str")
        Test.assert_eq(use_start, occurrence)
        Test.assert_eq(use_len, 1)
        Test.assert_str_eq(definition, "none")
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}

test "semantic_fact_position_publishes_typed_match_narrowing_and_residuals" {
  let source = "fn fact_match(value: str | nil) -> i64 { match value { text: str if __str_len(text) > 3 -> 1, text: str -> 2, nil -> 3 } }"
  let first = str_find(source, "text: str")
  let second = str_find_from(source, "text: str", first + 1)
  let nil_arm = str_find_from(source, "nil ->", second + 1)
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> {
      match semantic_fact_query_position(tt, src, first) {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactMatchArm(SemanticMatchArm(SemanticTypePrimitive(narrowed), SemanticTypeUnion(SemanticTypePrimitive(residual_left), SemanticTypePrimitive(residual_right)), guarded, SemanticSourceLocation(path, start, len))))) -> {
          Test.assert_str_eq(narrowed, "str")
          Test.assert_str_eq(residual_left, "str")
          Test.assert_str_eq(residual_right, "nil")
          Test.assert_eq(if guarded { 1 } else { 0 }, 1)
          Test.assert_eq(start, first)
          Test.assert_eq(len, 4)
        }
        _ -> Test.assert_eq(0, 1)
      }
      match semantic_fact_query_position(tt, src, second) {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactMatchArm(SemanticMatchArm(SemanticTypePrimitive(narrowed), SemanticTypePrimitive(residual), guarded, occurrence)))) -> {
          Test.assert_str_eq(narrowed, "str")
          Test.assert_str_eq(residual, "nil")
          Test.assert_eq(if guarded { 1 } else { 0 }, 0)
        }
        _ -> Test.assert_eq(0, 1)
      }
      match semantic_fact_query_position(tt, src, nil_arm) {
        SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactMatchArm(SemanticMatchArm(SemanticTypePrimitive(narrowed), SemanticTypeBottom, guarded, occurrence)))) -> {
          Test.assert_str_eq(narrowed, "nil")
          Test.assert_eq(if guarded { 1 } else { 0 }, 0)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
  }
}

test "semantic_fact_position_publishes_typed_catch_all_as_never_residual" {
  let source = "fn fact_match_all(value: i64) -> i64 { match value { number: i64 -> number } }"
  let arm = str_find(source, "number: i64")
  match pipeline_check_source(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, src, tt) -> match semantic_fact_query_position(tt, src, arm) {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactMatchArm(SemanticMatchArm(SemanticTypePrimitive(narrowed), SemanticTypeBottom, guarded, occurrence)))) -> {
        Test.assert_str_eq(narrowed, "i64")
        Test.assert_eq(if guarded { 1 } else { 0 }, 0)
      }
      _ -> Test.assert_eq(0, 1)
    }
  }
}
