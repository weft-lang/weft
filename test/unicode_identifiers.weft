use compiler/lex.{*}
use module_fixtures/κόσμος as κόσμος
use runtime/alloc.{alloc_words}
use runtime/memory.{mem_store8_at}

fn πρόσθεση(α: i64, β: i64) -> i64 { α + β }

test "Unicode identifiers resolve by NFC identity" {
  let café = 20
  let 值 = 20
  let 𐐀9 = 2
  Test.assert_eq(πρόσθεση(café + 值, 𐐀9), 42)
}

test "Unicode combining marks continue identifiers" {
  let q̣̇ = 42
  Test.assert_eq(q̣̇, 42)
}

test "Unicode module paths aliases and members preserve identity" {
  Test.assert_eq(κόσμος.απάντηση(), 42)
}

test "Unicode identifier lexer accepts all UTF-8 widths" {
  let greek = lex(__str_ptr("αβ2"), __str_len("αβ2"))
  Test.assert_eq(tok_tag(greek, 0), 2)
  Test.assert_eq(tok_v2(greek, 0), 5)
  Test.assert_eq(tok_end(greek, 0), 5)
  let supplementary = lex(__str_ptr("𐐀9"), __str_len("𐐀9"))
  Test.assert_eq(tok_tag(supplementary, 0), 2)
  Test.assert_eq(tok_v2(supplementary, 0), 5)
}

test "Unicode continuation prevents ASCII keyword prefix capture" {
  let tokens = lex(__str_ptr("elseα"), __str_len("elseα"))
  Test.assert_eq(tok_tag(tokens, 0), 2)
  Test.assert_eq(tok_v2(tokens, 0), 6)
}

test "Unicode lexer marks non-NFC identifiers exactly" {
  let tokens = lex(__str_ptr("café"), __str_len("café"))
  Test.assert_eq(tok_count(tokens), 2)
  Test.assert_eq(tok_tag(tokens, 0), 14)
  Test.assert_eq(tok_v1(tokens, 0), 2)
  Test.assert_eq(tok_v2(tokens, 0), 6)
  Test.assert_eq(tok_span(tokens, 0), 0)
  Test.assert_eq(tok_end(tokens, 0), 6)
}

test "Unicode lexer subtracts default-ignorable code points" {
  let tokens = lex(__str_ptr("α‍x"), __str_len("α‍x"))
  Test.assert_eq(tok_tag(tokens, 0), 2)
  Test.assert_eq(tok_end(tokens, 0), 2)
  Test.assert_eq(tok_tag(tokens, 1), 14)
  Test.assert_eq(tok_v1(tokens, 1), 3)
  Test.assert_eq(tok_v2(tokens, 1), 3)
  Test.assert_eq(tok_span(tokens, 1), 2)
}

test "Unicode lexer rejects continue-only and non-XID starts" {
  let mark = lex(__str_ptr("́x"), __str_len("́x"))
  Test.assert_eq(tok_tag(mark, 0), 14)
  Test.assert_eq(tok_v1(mark, 0), 4)
  Test.assert_eq(tok_v2(mark, 0), 2)
  let emoji = lex(__str_ptr("😀x"), __str_len("😀x"))
  Test.assert_eq(tok_tag(emoji, 0), 14)
  Test.assert_eq(tok_v1(emoji, 0), 4)
  Test.assert_eq(tok_v2(emoji, 0), 4)
}

test "Unicode lexer rejects malformed UTF-8 before ordinary tokens" {
  let source = alloc_words(1)
  mem_store8_at(source, 0, 195)
  mem_store8_at(source, 1, 40)
  let tokens = lex(source, 2)
  Test.assert_eq(tok_count(tokens), 2)
  Test.assert_eq(tok_tag(tokens, 0), 14)
  Test.assert_eq(tok_v1(tokens, 0), 1)
  Test.assert_eq(tok_span(tokens, 0), 0)
  Test.assert_eq(tok_tag(tokens, 1), 7)
}
