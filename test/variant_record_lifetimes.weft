use stdlib/list.{List, Nil, Cons}
use stdlib/list as list

test "conditional generic constructors preserve shared tails across reassignment" {
  let source = [Method(Signature { start: 7, params: MoreParams(42, NoParams) })]
  let original = list.from_slice(source[..])
  let mut members = original
  let mut index = 0
  while index < 64 {
    members = Cons<Member>(Binding(index, if index % 2 == 0 { index } else { nil }), members)
    index = index + 1
  }
  let mut remaining = 64
  for member in members {
    match member {
      Binding(name, location) -> {
        remaining = remaining - 1
        Test.assert_eq(name, remaining)
      }
      Method(signature) -> {
        Test.assert_eq(remaining, 0)
        Test.assert_eq(signature.start, 7)
        Test.assert_true(
          match signature.params {
            MoreParams(42, NoParams) -> true
            _ -> false
          }
        )
      }
    }
  }
  Test.assert_eq(remaining, 0)
  Test.assert_eq_usize(original.len(), 1)
  for member in original {
    Test.assert_true(
      match member {
        Method(signature) -> signature.start == 7 and match signature.params {
          MoreParams(42, NoParams) -> true
          _ -> false
        }
        _ -> false
      }
    )
  }
}

type Params { NoParams, MoreParams(i64, Params) }

type Signature { start: i64, params: Params }

type ParsedSignature { signature: Signature, next: i64 }

type Member { Method(Signature), Binding(i64, i64?) }

fn make_members() -> List<Member> {
  let mut members: List<Member> = Nil
  let mut index = 0
  while index < 2 {
    if index == 0 {
      let parsed = ParsedSignature {
        signature: Signature { start: 7, params: MoreParams(42, NoParams) },
        next: 1
      }
      members = Cons(Method(parsed.signature), members)
      index = parsed.next
    } else {
      members = Cons(Binding(3, if index == 1 { 5 } else { nil }), members)
      index = index + 1
    }
  }
  members.reverse()
}

test "heterogeneous variant list retains nested record payloads" {
  let members = make_members()
  for member in members {
    match member {
      Method(function) -> {
        Test.assert_eq(function.start, 7)
        Test.assert_true(match function.params { MoreParams(42, NoParams) -> true, _ -> false })
        nil
      }
      Binding(name, location) -> { Test.assert_eq(name, 3); nil }
    }
  }
}
