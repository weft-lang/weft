use "stdlib/vector.weft"
use "stdlib/string.weft"

test "runtime_persistent_vector_managed_root_promotes_without_touching_chunks" {
  Test.assert_eq(persistent_vector_header_size(), 80)
  let v = persistent_vector_push<i64>(persistent_vector_new<i64>(), 10)
  Test.assert_eq(persistent_vector_len(v), 1)
  Test.assert_eq(persistent_vector_get<i64>(v, 0, 0 - 1), 10)
  Test.assert_eq(persistent_vector_is_promoted<i64>(v), 0)
  persistent_vector_promote<i64>(v)
  Test.assert_eq(persistent_vector_is_promoted<i64>(v), 1)
  Test.assert_eq(persistent_vector_get<i64>(v, 0, 0 - 1), 10)
}

test "runtime_persistent_vector_push_versions_remain_stable" {
  let empty = persistent_vector_new<i64>()
  let one = persistent_vector_push<i64>(empty, 10)
  let two = persistent_vector_push<i64>(one, 20)
  let three = persistent_vector_push<i64>(two, 30)
  Test.assert_eq(persistent_vector_len(empty), 0)
  Test.assert_eq(persistent_vector_len(one), 1)
  Test.assert_eq(persistent_vector_len(two), 2)
  Test.assert_eq(persistent_vector_len(three), 3)
  Test.assert_eq(persistent_vector_get<i64>(empty, 0, 0 - 1), 0 - 1)
  Test.assert_eq(persistent_vector_get<i64>(one, 0, 0 - 1), 10)
  Test.assert_eq(persistent_vector_get<i64>(two, 1, 0 - 1), 20)
  Test.assert_eq(persistent_vector_get<i64>(three, 2, 0 - 1), 30)
  Test.assert_eq(if persistent_vector_root(one) != persistent_vector_root(two) { 1 } else { 0 }, 1)
}

test "runtime_persistent_vector_set_path_copies_target_chunk" {
  let base = persistent_vector_push<i64>(persistent_vector_push<i64>(persistent_vector_new<i64>(), 7), 8)
  let updated = persistent_vector_set<i64>(base, 0, 70)
  let invalid = persistent_vector_set<i64>(updated, 99, 99)
  Test.assert_eq(persistent_vector_get<i64>(base, 0, 0 - 1), 7)
  Test.assert_eq(persistent_vector_get<i64>(base, 1, 0 - 1), 8)
  Test.assert_eq(persistent_vector_get<i64>(updated, 0, 0 - 1), 70)
  Test.assert_eq(persistent_vector_get<i64>(updated, 1, 0 - 1), 8)
  Test.assert_eq(persistent_vector_get<i64>(invalid, 0, 0 - 1), 70)
  Test.assert_eq(persistent_vector_len(invalid), 2)
}

test "runtime_persistent_vector_crosses_chunk_boundary" {
  let mut v = persistent_vector_new<i64>()
  for i in 0..35 {
    v = persistent_vector_push<i64>(v, i * 2)
  }
  Test.assert_eq(persistent_vector_len(v), 35)
  Test.assert_eq(persistent_vector_chunk_count(v), 2)
  Test.assert_eq(persistent_vector_get<i64>(v, 0, 0 - 1), 0)
  Test.assert_eq(persistent_vector_get<i64>(v, 31, 0 - 1), 62)
  Test.assert_eq(persistent_vector_get<i64>(v, 32, 0 - 1), 64)
  Test.assert_eq(persistent_vector_get<i64>(v, 34, 0 - 1), 68)
}

test "runtime_persistent_vector_grows_to_second_tree_level" {
  let mut v = persistent_vector_new<i64>()
  for i in 0..1060 {
    v = persistent_vector_push<i64>(v, i)
  }
  let updated_tree = persistent_vector_set<i64>(v, 1000, 7000)
  let updated_tail = persistent_vector_set<i64>(updated_tree, 1059, 9000)
  Test.assert_eq(persistent_vector_len(v), 1060)
  Test.assert_eq(persistent_vector_chunk_count(v), 34)
  Test.assert_eq(persistent_vector_tree_depth(v), 2)
  Test.assert_eq(persistent_vector_get<i64>(v, 0, 0 - 1), 0)
  Test.assert_eq(persistent_vector_get<i64>(v, 31, 0 - 1), 31)
  Test.assert_eq(persistent_vector_get<i64>(v, 32, 0 - 1), 32)
  Test.assert_eq(persistent_vector_get<i64>(v, 1024, 0 - 1), 1024)
  Test.assert_eq(persistent_vector_get<i64>(v, 1059, 0 - 1), 1059)
  Test.assert_eq(persistent_vector_get<i64>(updated_tree, 1000, 0 - 1), 7000)
  Test.assert_eq(persistent_vector_get<i64>(updated_tree, 1059, 0 - 1), 1059)
  Test.assert_eq(persistent_vector_get<i64>(updated_tail, 1000, 0 - 1), 7000)
  Test.assert_eq(persistent_vector_get<i64>(updated_tail, 1059, 0 - 1), 9000)
  Test.assert_eq(persistent_vector_get<i64>(v, 1000, 0 - 1), 1000)
}

test "runtime_persistent_vector_fixed_arrays_cross_chunk_boundary" {
  let mut values = persistent_vector_new<[i64; 2]>()
  for i in 0..35 {
    values = persistent_vector_push<[i64; 2]>(values, [i, i + 100])
  }
  let first = persistent_vector_get<[i64; 2]>(values, 0, [0 - 1, 0 - 1])
  let boundary = persistent_vector_get<[i64; 2]>(values, 32, [0 - 1, 0 - 1])
  let last = persistent_vector_get<[i64; 2]>(values, 34, [0 - 1, 0 - 1])
  Test.assert_eq(first[0] + first[1], 100)
  Test.assert_eq(boundary[0] + boundary[1], 164)
  Test.assert_eq(last[0] + last[1], 168)
}

test "runtime_persistent_vector_managed_array_path_copy_preserves_versions" {
  let empty = persistent_vector_new<[str; 2]>()
  let one = persistent_vector_push<[str; 2]>(empty, [str_concat("a", "1"), str_concat("b", "2")])
  let two = persistent_vector_push<[str; 2]>(one, [str_concat("c", "3"), str_concat("d", "4")])
  let changed = persistent_vector_set<[str; 2]>(two, 0, [str_concat("e", "5"), str_concat("f", "6")])
  let old = persistent_vector_get<[str; 2]>(two, 0, ["", ""])
  let next = persistent_vector_get<[str; 2]>(changed, 0, ["", ""])
  let tail = persistent_vector_get<[str; 2]>(changed, 1, ["", ""])
  Test.assert_eq(str_eq(old[0], "a1") + str_eq(old[1], "b2"), 2)
  Test.assert_eq(str_eq(next[0], "e5") + str_eq(next[1], "f6"), 2)
  Test.assert_eq(str_eq(tail[0], "c3") + str_eq(tail[1], "d4"), 2)
}
