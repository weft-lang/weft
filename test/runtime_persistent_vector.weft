use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}
use stdlib/vector.{persistent_vector_chunk_count, persistent_vector_header_size, persistent_vector_is_promoted, persistent_vector_promote, persistent_vector_root, persistent_vector_tree_depth}
use stdlib/iter as iter
use stdlib/option.{*}
use stdlib/string.{*}

test "runtime_persistent_vector_managed_root_promotes_without_touching_chunks" {
  Test.assert_eq(persistent_vector_header_size(), 80)
  let v = persistent_vector.new<i64>().push(10)
  Test.assert_eq(v.len(), 1)
  Test.assert_eq(v.get(0).unwrap_or(0 - 1), 10)
  Test.assert_eq(persistent_vector_is_promoted<i64>(v), 0)
  persistent_vector_promote<i64>(v)
  Test.assert_eq(persistent_vector_is_promoted<i64>(v), 1)
  Test.assert_eq(v.get(0).unwrap_or(0 - 1), 10)
}

test "runtime_persistent_vector_push_versions_remain_stable" {
  let empty = persistent_vector.new<i64>()
  let one = empty.push(10)
  let two = one.push(20)
  let three = two.push(30)
  Test.assert_eq(empty.len(), 0)
  Test.assert_eq(one.len(), 1)
  Test.assert_eq(two.len(), 2)
  Test.assert_eq(three.len(), 3)
  Test.assert_true(empty.get(0).is_none())
  Test.assert_eq(one.get(0).unwrap_or(0 - 1), 10)
  Test.assert_eq(two.get(1).unwrap_or(0 - 1), 20)
  Test.assert_eq(three.get(2).unwrap_or(0 - 1), 30)
  Test.assert_eq(if persistent_vector_root(one) != persistent_vector_root(two) { 1 } else { 0 }, 1)
}

test "runtime_persistent_vector_set_path_copies_target_chunk" {
  let base = persistent_vector.new<i64>().push(7).push(8)
  let updated = base.set(0, 70).expect("index is in bounds")
  Test.assert_true(updated.set(99, 99).is_none())
  Test.assert_eq(base.get(0).unwrap_or(0 - 1), 7)
  Test.assert_eq(base.get(1).unwrap_or(0 - 1), 8)
  Test.assert_eq(updated.get(0).unwrap_or(0 - 1), 70)
  Test.assert_eq(updated.get(1).unwrap_or(0 - 1), 8)
  Test.assert_eq(updated.len(), 2)
}

test "runtime_persistent_vector_crosses_chunk_boundary" {
  let mut v = persistent_vector.new<i64>()
  for i in 0..35 {
    v = v.push(i * 2)
  }
  Test.assert_eq(v.len(), 35)
  Test.assert_eq(persistent_vector_chunk_count(v), 2)
  Test.assert_eq(v.get(0).unwrap_or(0 - 1), 0)
  Test.assert_eq(v.get(31).unwrap_or(0 - 1), 62)
  Test.assert_eq(v.get(32).unwrap_or(0 - 1), 64)
  Test.assert_eq(v.get(34).unwrap_or(0 - 1), 68)
}

test "runtime_persistent_vector_grows_to_second_tree_level" {
  let mut v = persistent_vector.new<i64>()
  for i in 0..1060 {
    v = v.push(i)
  }
  let updated_tree = v.set(1000, 7000).expect("tree index is in bounds")
  let updated_tail = updated_tree.set(1059, 9000).expect("tail index is in bounds")
  Test.assert_eq(v.len(), 1060)
  Test.assert_eq(persistent_vector_chunk_count(v), 34)
  Test.assert_eq(persistent_vector_tree_depth(v), 2)
  Test.assert_eq(v.get(0).unwrap_or(0 - 1), 0)
  Test.assert_eq(v.get(31).unwrap_or(0 - 1), 31)
  Test.assert_eq(v.get(32).unwrap_or(0 - 1), 32)
  Test.assert_eq(v.get(1024).unwrap_or(0 - 1), 1024)
  Test.assert_eq(v.get(1059).unwrap_or(0 - 1), 1059)
  Test.assert_eq(updated_tree.get(1000).unwrap_or(0 - 1), 7000)
  Test.assert_eq(updated_tree.get(1059).unwrap_or(0 - 1), 1059)
  Test.assert_eq(updated_tail.get(1000).unwrap_or(0 - 1), 7000)
  Test.assert_eq(updated_tail.get(1059).unwrap_or(0 - 1), 9000)
  Test.assert_eq(v.get(1000).unwrap_or(0 - 1), 1000)
}

test "runtime_persistent_vector_fixed_arrays_cross_chunk_boundary" {
  let mut values = persistent_vector.new<[i64; 2]>()
  for i in 0..35 {
    values = values.push([i, i + 100])
  }
  let first = values.get(0).expect("first value exists")
  let boundary = values.get(32).expect("boundary value exists")
  let last = values.get(34).expect("last value exists")
  Test.assert_eq(first[0] + first[1], 100)
  Test.assert_eq(boundary[0] + boundary[1], 164)
  Test.assert_eq(last[0] + last[1], 168)
}

test "runtime_persistent_vector_managed_array_path_copy_preserves_versions" {
  let empty = persistent_vector.new<[str; 2]>()
  let one = empty.push([str_concat("a", "1"), str_concat("b", "2")])
  let two = one.push([str_concat("c", "3"), str_concat("d", "4")])
  let changed = two.set(0, [str_concat("e", "5"), str_concat("f", "6")]).expect("index is in bounds")
  let old = two.get(0).expect("old value exists")
  let next = changed.get(0).expect("changed value exists")
  let tail = changed.get(1).expect("tail value exists")
  Test.assert_eq(str_eq(old[0], "a1") + str_eq(old[1], "b2"), 2)
  Test.assert_eq(str_eq(next[0], "e5") + str_eq(next[1], "f6"), 2)
  Test.assert_eq(str_eq(tail[0], "c3") + str_eq(tail[1], "d4"), 2)
}

test "runtime_persistent_vector_collects_and_iterates_in_order" {
  let values = iter.range(2, 6).collect<PersistentVector<i64>>()
  let mut digits = 0
  for value in values { digits = digits * 10 + value }
  Test.assert_eq(values.len(), 4)
  Test.assert_eq(digits, 2345)
}
