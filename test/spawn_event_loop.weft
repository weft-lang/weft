use runtime/alloc.{arena_alloc, arena_free, arena_new}
use runtime/memory.{mem_load64, mem_store64}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_load, runtime_rc_probe_new}
use runtime/tcp_connect as tcp_connect_handler
use runtime/tcp_listen as tcp_listen_handler
use runtime/tcp_listener_io as tcp_listener_io_handler
use runtime/tcp_stream_io as tcp_stream_io_handler
use stdlib/fail.{Fail}
use stdlib/io/types.{IoEndOfFile, IoReadBytes, IoWroteBytes}
use stdlib/net_address as net
use stdlib/net_address.{SocketAddress, SocketV4}
use stdlib/result.{Err, Ok, Result}
use stdlib/spawn as spawn
use stdlib/tcp as tcp
use stdlib/tcp.{TcpConnect, TcpError, TcpListener, TcpListenerIO, TcpListenerReadiness, TcpListenerReadinessFailed, TcpListenerReady, TcpReadiness, TcpReadinessError, TcpReadinessInterrupted, TcpReadinessInvalidated, TcpReadinessPlatform, TcpReadinessResourceExhausted, TcpStream, TcpStreamIO, TcpStreamReadiness, TcpStreamReadinessFailed, TcpStreamReady}
use stdlib/time as time
use stdlib/time.{SleepError}
use stdlib/vector.{vector_get_in_bounds, vector_push, vector_with_capacity}
use stdlib/vector/handles.{Vector}

effect EventLoopMark {
  fn mark(value: i64) -> nil
}

effect EventLoopAbort {
  fn stop() -> i64
}

fn event_loop_delayed_mark(delay: i64, value: i64) -[time.Time, EventLoopMark]> i64 {
  time.sleep(time.milliseconds(delay))
  EventLoopMark.mark(value)
  value
}

fn event_loop_sleeping_probe(payload: RuntimeRcProbe) -[time.Time]> i64 {
  time.sleep(time.milliseconds(100))
  runtime_rc_probe_load(payload)
}

fn event_loop_aborting_child() -[EventLoopAbort]> i64 {
  EventLoopAbort.stop()
}

fn event_loop_sleep_42() -[time.Time]> i64 {
  time.sleep(time.milliseconds(1))
  42
}

fn event_loop_sleep_pair() -[time.Time]> (str, i64) {
  time.sleep(time.milliseconds(1))
  ("weft", 42)
}

fn event_loop_nested_outer() -[spawn.Spawn, time.Time]> i64 {
  time.sleep(time.milliseconds(1))
  let inner = spawn.spawn(event_loop_sleep_42)
  spawn.join(inner)
}

fn event_loop_nested_scope() -> i64 {
  spawn.with_event_loop(() => {
    let task = spawn.spawn(event_loop_sleep_42)
    spawn.join(task)
  })
}

fn event_loop_tcp_error_code(error: TcpError) -> i64 {
  match error {
    TcpInterrupted -> 1
    TcpWouldBlock -> 2
    TcpConnectionRefused -> 3
    TcpConnectionReset -> 4
    TcpConnectionAborted -> 5
    TcpBrokenPipe -> 6
    TcpNotConnected -> 7
    TcpAddressInUse -> 8
    TcpAddressUnavailable -> 9
    TcpNetworkUnreachable -> 10
    TcpTimedOut -> 11
    TcpPermissionDenied -> 12
    TcpResourceExhausted -> 13
    TcpInvalidProgress -> 14
    TcpPolicyDenied -> 15
    TcpPlatform(code) -> 1000 + code
  }
}

fn event_loop_readiness_error_code(error: TcpReadinessError) -> i64 {
  match error {
    TcpReadinessInterrupted -> 1
    TcpReadinessResourceExhausted -> 2
    TcpReadinessInvalidated -> 3
    TcpReadinessPlatform(code) -> 1000 + code
  }
}

fn event_loop_tcp_close_status(result: Result<nil, TcpError>) -> i64 {
  match result {
    Ok(nil) -> 1
    Err(error) -> 0 - event_loop_tcp_error_code(error)
  }
}

fn event_loop_sleep_status(result: Result<nil, SleepError>) -> i64 {
  match result {
    Ok(nil) -> 0
    Err(error) -> match error {
      InvalidSleepDuration() -> 0 - 1
      SleepFailed(status) -> status
    }
  }
}

fn event_loop_delayed_connect(
  address: SocketAddress
) -[time.Time, TcpConnect, TcpStreamIO]> i64 {
  time.sleep(time.milliseconds(1))
  match tcp.connect(address, tcp.connect_options()) {
    Err(error) -> 0 - event_loop_tcp_error_code(error)
    Ok(stream) -> event_loop_tcp_close_status(stream.close())
  }
}

fn event_loop_delayed_abort() -[time.Time, EventLoopAbort]> i64 {
  time.sleep(time.milliseconds(1))
  EventLoopAbort.stop()
}

fn event_loop_require_stream_ready(
  readiness: TcpStreamReadiness
) -[Fail<TcpReadinessError>, TcpStreamIO]> owned TcpStream {
  match readiness {
    TcpStreamReadinessFailed(returned, error) -> {
      let closed = returned.close()
      Fail<TcpReadinessError>.fail(error)
    }
    TcpStreamReady(returned) -> returned
  }
}

fn event_loop_require_listener_ready(
  readiness: TcpListenerReadiness
) -[Fail<TcpReadinessError>, TcpListenerIO]> owned TcpListener {
  match readiness {
    TcpListenerReadinessFailed(returned, error) -> {
      let closed = returned.close()
      Fail<TcpReadinessError>.fail(error)
    }
    TcpListenerReady(returned) -> returned
  }
}

fn event_loop_tcp_accept_probe(
) -[TcpConnect, TcpListen, TcpStreamIO, TcpListenerIO, Fail<TcpError>, Fail<TcpReadinessError>]> i64 {
  spawn.with_event_loop(() => {
    let listener: owned TcpListener = tcp.listen(
      SocketV4(net.ipv4(127, 0, 0, 1), 0),
      tcp.listen_options(8)
    )?
    let address = listener.local_address()?
    let connector = spawn.spawn(() => event_loop_delayed_connect(address))
    let mut ready_listener: owned TcpListener = event_loop_require_listener_ready(
      listener.wait_acceptable()
    )
    let server: owned TcpStream = ready_listener.accept()?
    server.close()?
    ready_listener.close()?
    spawn.join(connector) * 100 + 11
  })
}

fn event_loop_tcp_stream_probe(
) -[TcpConnect, TcpListen, TcpStreamIO, TcpListenerIO, Fail<TcpError>, Fail<TcpReadinessError>]> i64 {
  spawn.with_event_loop(() => {
    let mut listener: owned TcpListener = tcp.listen(
      SocketV4(net.ipv4(127, 0, 0, 1), 0),
      tcp.listen_options(8)
    )?
    let address = listener.local_address()?
    let client: owned TcpStream = tcp.connect(address, tcp.connect_options())?
    let server: owned TcpStream = listener.accept()?
    listener.close()?

    let mut ready_client: owned TcpStream = event_loop_require_stream_ready(
      client.wait_writable()
    )
    let source: Vector<u8> = vector_with_capacity<u8>(1)
    vector_push<u8>(source, __u64_to_u8(__i64_to_u64(42)))
    let source_view: [u8] = source[..]
    let wrote = match ready_client.write(source_view)? {
      IoWroteBytes(count) -> __u64_to_i64(__usize_to_u64(count))
    }

    let mut ready_server: owned TcpStream = event_loop_require_stream_ready(
      server.wait_readable()
    )
    let received: Vector<u8> = vector_with_capacity<u8>(1)
    vector_push<u8>(received, __u64_to_u8(__i64_to_u64(0)))
    let received_view: [mut u8] = received[..]
    let read = match ready_server.read(received_view)? {
      IoEndOfFile -> 0
      IoReadBytes(count) -> __u64_to_i64(__usize_to_u64(count))
    }
    ready_client.close()?
    ready_server.close()?
    wrote * 10000 + read * 1000 +
      __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(received, 0))) * 10 + 2
  })
}

fn event_loop_tcp_accept_run() -> i64 {
  handle {
    handle with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() { event_loop_tcp_accept_probe() }
        }
      }
    } {
      Fail<TcpError>.fail(error) -> 0 - event_loop_tcp_error_code(error)
    }
  } {
    Fail<TcpReadinessError>.fail(error) -> 0 - 10000 - event_loop_readiness_error_code(error)
  }
}

fn event_loop_tcp_stream_run() -> i64 {
  handle {
    handle with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() { event_loop_tcp_stream_probe() }
        }
      }
    } {
      Fail<TcpError>.fail(error) -> 0 - event_loop_tcp_error_code(error)
    }
  } {
    Fail<TcpReadinessError>.fail(error) -> 0 - 10000 - event_loop_readiness_error_code(error)
  }
}

fn event_loop_tcp_abort_readiness_probe(
  observed: Vector<SocketAddress>
) -[TcpConnect, TcpListen, TcpStreamIO, TcpListenerIO, Fail<TcpError>, Fail<TcpReadinessError>]> i64 {
  let aborted = handle spawn.with_event_loop(() => {
    let listener: owned TcpListener = tcp.listen(
      SocketV4(net.ipv4(127, 0, 0, 1), 0),
      tcp.listen_options(8)
    )?
    vector_push<SocketAddress>(observed, listener.local_address()?)
    let aborting = spawn.spawn(event_loop_delayed_abort)
    let ready = event_loop_require_listener_ready(listener.wait_acceptable())
    0
  }) {
    EventLoopAbort.stop() -> 7
  }
  let rebound: owned TcpListener = tcp.listen(
    vector_get_in_bounds<SocketAddress>(observed, 0),
    tcp.listen_options(1)
  )?
  rebound.close()?
  aborted * 10 + 1
}

fn event_loop_tcp_abort_readiness_run() -> i64 {
  let observed = vector_with_capacity<SocketAddress>(1)
  handle {
    handle with tcp_connect_handler() {
      with tcp_listen_handler() {
        with tcp_listener_io_handler() {
          with tcp_stream_io_handler() { event_loop_tcp_abort_readiness_probe(observed) }
        }
      }
    } {
      Fail<TcpError>.fail(error) -> 0 - event_loop_tcp_error_code(error)
    }
  } {
    Fail<TcpReadinessError>.fail(error) -> 0 - 10000 - event_loop_readiness_error_code(error)
  }
}

test "event loop joins an ordinary sleeping child" {
  let got = spawn.with_event_loop(() => {
    let task = spawn.spawn(event_loop_sleep_42)
    spawn.join(task)
  })
  Test.assert_eq(got, 42)
}

test "event loop carrier preserves a managed multi-lane result" {
  let got = spawn.with_event_loop(() => {
    let task = spawn.spawn(event_loop_sleep_pair)
    let (name, value): (str, i64) = spawn.join(task)
    if name == "weft" { value } else { 0 }
  })
  Test.assert_eq(got, 42)
}

test "event loop runs another task while the first timer is pending" {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 16, 8)
  mem_store64(cell, 0)
  mem_store64(cell + 8, 0)
  let got = handle spawn.with_event_loop(() => {
    let slow = spawn.spawn(() => event_loop_delayed_mark(10, 20))
    let fast = spawn.spawn(() => event_loop_delayed_mark(1, 10))
    spawn.join(slow) + spawn.join(fast)
  }) {
    EventLoopMark.mark(value) -> {
      let count = mem_load64(cell)
      mem_store64(cell + 8, mem_load64(cell + 8) * 10 + value / 10)
      mem_store64(cell, count + 1)
      resume(nil)
    }
  }
  Test.assert_eq(got, 30)
  Test.assert_eq(mem_load64(cell), 2)
  Test.assert_eq(mem_load64(cell + 8), 12)
  arena_free(arena)
}

test "event loop drains an unobserved accepted task before scope return" {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  let got = handle spawn.with_event_loop(() => {
    let ignored = spawn.spawn(() => event_loop_delayed_mark(1, 42))
    1
  }) {
    EventLoopMark.mark(value) -> {
      mem_store64(cell, value)
      resume(nil)
    }
  }
  Test.assert_eq(got, 1)
  Test.assert_eq(mem_load64(cell), 42)
  arena_free(arena)
}

test "event loop accepts nested Spawn inside a suspended child" {
  let got = spawn.with_event_loop(() => {
    let outer = spawn.spawn(event_loop_nested_outer)
    spawn.join(outer)
  })
  Test.assert_eq(got, 42)
}

test "event loop preserves typed Time sleep failures" {
  let negative = spawn.with_event_loop(() => event_loop_sleep_status(time.sleep(time.milliseconds(0 - 1))))
  let zero = spawn.with_event_loop(() => event_loop_sleep_status(time.sleep(time.milliseconds(0))))
  let overflow = spawn.with_event_loop(() => event_loop_sleep_status(time.sleep(time.milliseconds(9223372036855))))
  Test.assert_eq(negative, 0 - 1)
  Test.assert_eq(zero, 0)
  Test.assert_eq(overflow, 0 - 1)
}

test "event loop abort drops a sleeping continuation and managed capture" {
  let payload = runtime_rc_probe_new(42)
  let baseline = runtime_rc_probe_count(payload)
  let got = handle spawn.with_event_loop(() => {
    let sleeping = spawn.spawn(() => event_loop_sleeping_probe(payload))
    let aborting = spawn.spawn(event_loop_aborting_child)
    spawn.join(aborting)
  }) {
    EventLoopAbort.stop() -> 7
  }
  Test.assert_eq(got, 7)
  Test.assert_eq(runtime_rc_probe_count(payload), baseline)
}

test "event loop normal drain drops an unobserved managed result" {
  let payload = runtime_rc_probe_new(42)
  let baseline = runtime_rc_probe_count(payload)
  let got = spawn.with_event_loop(() => {
    let ignored = spawn.spawn(() => event_loop_sleeping_probe(payload))
    7
  })
  Test.assert_eq(got, 7)
  Test.assert_eq(runtime_rc_probe_count(payload), baseline)
}

test "event loop drives many task suspensions iteratively" {
  let got = spawn.with_event_loop(() => {
    let mut i = 0
    while i < 128 {
      let ignored = spawn.spawn(event_loop_sleep_42)
      i = i + 1
    }
    42
  })
  Test.assert_eq(got, 42)
}

test "event loop handlers nest without sharing task scopes" {
  let got = spawn.with_event_loop(() => {
    let task = spawn.spawn(event_loop_nested_scope)
    spawn.join(task)
  })
  Test.assert_eq(got, 42)
}

test "event loop resumes listener readiness after running a delayed connector" {
  Test.assert_eq(event_loop_tcp_accept_run(), 111)
}

test "event loop returns stream owners across writable and readable readiness" {
  Test.assert_eq(event_loop_tcp_stream_run(), 11422)
}

test "event loop abort cancels readiness before dropping and rebinding listener" {
  Test.assert_eq(event_loop_tcp_abort_readiness_run(), 71)
}
