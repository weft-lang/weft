-- An owned value is dropped exactly once on every exit that still owns it.
-- Destructuring an owned record takes its fields apart without running its
-- Drop. An owned binding a match pattern takes from its scrutinee is dropped
-- on every exit that does not move it: a branch that only reads it, a branch
-- that leaves through `continue` or `return`, and the branch beside one that
-- moves it. Each case counts exact Drop runs, so both double drops and lost
-- drops fail.

use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

type Token { log: F64Table, value: i64 }

impl Drop for Token {
  fn drop(self) -> nil {
    let { log, value: _ } = self
    log.set(0, 0, log.get(0, 0).unwrap() + 1.0)
    nil
  }
}

type Holder { Held(owned Token), Idle }

impl Drop for Holder {
  fn drop(self) -> nil {
    match self {
      Held(token) -> token.drop()
      Idle -> nil
    }
  }
}

type Pair { Both(owned Token, owned Token) }

impl Drop for Pair {
  fn drop(self) -> nil {
    match self {
      Both(first, second) -> {
        first.drop()
        second.drop()
      }
    }
  }
}

fn token(log: F64Table, value: i64) -> owned Token { Token { log: log, value: value } }

fn held(log: F64Table, value: i64) -> owned Holder { Held(token(log, value)) }

-- Moving a token takes its fields apart, so its Drop does not run.
fn spend(token: owned Token) -> i64 {
  let { log: _, value } = token
  value
}

-- Naming every field moves each one out; the record's Drop still does not run.
fn spend_both(token: owned Token) -> i64 {
  let { log, value } = token
  value + log.rows()
}

fn drops(run: (F64Table) -> i64) -> f64 {
  let log = table.filled(1, 1, 0.0).unwrap()
  run(log)
  log.get(0, 0).unwrap()
}

fn read_only(log: F64Table) -> i64 {
  match held(log, 3) {
    Held(token) -> token.value
    Idle -> 0
  }
}

fn moved_on_one_branch(log: F64Table, spend_it: bool) -> i64 {
  match held(log, 3) {
    Held(token) -> if spend_it { spend(token) } else { 0 }
    Idle -> 0
  }
}

fn read_on_one_branch(log: F64Table, read_it: bool) -> i64 {
  match held(log, 3) {
    Held(token) -> if read_it { token.value } else { 0 }
    Idle -> 0
  }
}

fn split_pair(log: F64Table, first_wins: bool) -> i64 {
  match Both(token(log, 1), token(log, 2)) {
    Both(first, second) -> if first_wins { spend(first) } else { spend(second) }
  }
}

-- Even rounds leave their token through `continue`; odd rounds move it.
fn continue_in_loop(log: F64Table, rounds: i64) -> i64 {
  let mut spent = 0
  for round in 0..rounds {
    match held(log, round) {
      Held(token) -> if round % 2 == 0 { continue } else { spent = spent + spend(token) }
      Idle -> nil
    }
  }
  spent
}

fn returns_early(log: F64Table, early: bool) -> i64 {
  match held(log, 5) {
    Held(token) -> {
      if early { return 0 } else { nil }
      spend(token)
    }
    Idle -> 0
  }
}

fn spend_holder(holder: owned Holder) -> i64 {
  match holder {
    Held(token) -> spend(token)
    Idle -> 0
  }
}

fn whole_binding(log: F64Table, spend_it: bool) -> i64 {
  match held(log, 4) {
    whole -> if spend_it { spend_holder(whole) } else { 0 }
  }
}

test "destructuring an owned record moves its fields without dropping it" {
  Test.assert_eq_f64(drops((log) => spend(token(log, 3))), 0.0)
  Test.assert_eq_f64(drops((log) => spend_both(token(log, 3))), 0.0)
}

test "a binding only read is dropped once" {
  Test.assert_eq_f64(drops((log) => read_only(log)), 1.0)
}

test "a binding moved on one branch is dropped on the other" {
  Test.assert_eq_f64(drops((log) => moved_on_one_branch(log, true)), 0.0)
  Test.assert_eq_f64(drops((log) => moved_on_one_branch(log, false)), 1.0)
}

test "a binding read on one branch is dropped on both" {
  Test.assert_eq_f64(drops((log) => read_on_one_branch(log, true)), 1.0)
  Test.assert_eq_f64(drops((log) => read_on_one_branch(log, false)), 1.0)
}

test "each binding of a pattern is dropped where its branch leaves it" {
  Test.assert_eq_f64(drops((log) => split_pair(log, true)), 1.0)
  Test.assert_eq_f64(drops((log) => split_pair(log, false)), 1.0)
}

test "a binding left by continue is dropped each round" {
  Test.assert_eq_f64(drops((log) => continue_in_loop(log, 6)), 3.0)
  Test.assert_eq_f64(drops((log) => continue_in_loop(log, 1)), 1.0)
}

test "a binding left by an early return is dropped" {
  Test.assert_eq_f64(drops((log) => returns_early(log, true)), 1.0)
  Test.assert_eq_f64(drops((log) => returns_early(log, false)), 0.0)
}

test "a whole-scrutinee binding moved on one branch is dropped on the other" {
  Test.assert_eq_f64(drops((log) => whole_binding(log, true)), 0.0)
  Test.assert_eq_f64(drops((log) => whole_binding(log, false)), 1.0)
}
