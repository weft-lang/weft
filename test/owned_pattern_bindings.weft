-- Destructuring an owned record takes its fields apart without running its
-- Drop. Each case counts exact Drop runs, so both double drops and lost drops
-- fail.

use stdlib/drop.{Drop}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

type Token { log: F64Table, value: i64 }

impl Drop for Token {
  fn drop(self) -> nil {
    let { log, value: _ } = self
    log.set(0, 0, log.get(0, 0).unwrap() + 1.0)
    nil
  }
}

fn token(log: F64Table, value: i64) -> owned Token { Token { log: log, value: value } }

-- Moving a token takes its fields apart, so its Drop does not run.
fn spend(token: owned Token) -> i64 {
  let { log: _, value } = token
  value
}

-- Naming every field moves each one out; the record's Drop still does not run.
fn spend_both(token: owned Token) -> i64 {
  let { log, value } = token
  value + log.rows()
}

fn drops(run: (F64Table) -> i64) -> f64 {
  let log = table.filled(1, 1, 0.0).unwrap()
  run(log)
  log.get(0, 0).unwrap()
}

test "destructuring an owned record moves its fields without dropping it" {
  Test.assert_eq_f64(drops((log) => spend(token(log, 3))), 0.0)
  Test.assert_eq_f64(drops((log) => spend_both(token(log, 3))), 0.0)
}
