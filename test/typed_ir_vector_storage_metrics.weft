-- test/typed_ir_vector_storage_metrics.weft -- typed-IR vector storage cutover metrics

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/lib.{*}
use compiler/types.{*}

fn typed_ir_vector_metric_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module(typed, optimised)
}

fn typed_ir_vector_metric_ir_emit(src: str) -> i64 {
  pipeline_native_ir_emit_count(typed_ir_vector_metric_native(src))
}

fn typed_ir_vector_metric_failures(src: str) -> i64 {
  pipeline_native_typed_lowering_failure_count(typed_ir_vector_metric_native(src))
}

fn typed_ir_vector_metric_generic_calls(src: str) -> i64 {
  pipeline_native_typed_generic_call_emit_count(typed_ir_vector_metric_native(src))
}

test "typed_ir_vector_storage_inline_record_helpers_emit_from_ir" {
  let src = "use stdlib/vector as vector use stdlib/vector.{*} type TinyPacket { a: u8, b: i8, ok: bool } fn tiny_packet(a: i64, b: i64, ok: bool) -> TinyPacket { TinyPacket { a: __i64_to_u8(a), b: __i64_to_i8(b), ok: ok } } fn main() -> i64 { let values = vector.with_capacity<TinyPacket>(2) vector_push<TinyPacket>(values, tiny_packet(250, -8, true)) if vector_get<TinyPacket>(values, 0, tiny_packet(0, 0, false)).a == 250 { 0 } else { 1 } }"
  let native = typed_ir_vector_metric_native(src)
  Test.assert_eq(pipeline_native_typed_lowering_failure_count(native), 0)
  Test.assert_eq(if pipeline_native_ir_emit_count(native) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_typed_generic_call_emit_count(native) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(if pipeline_native_vector_lowering_count(native) > 0 { 1 } else { 0 }, 1)
}

test "monomorph_type_hash_covers_every_structural_type_tag" {
  Test.assert_ne(cg_type_node_hash(ty_new(8, 101, ty_i64(), 0, 0)), cg_type_node_hash(ty_new(8, 101, ty_str(), 0, 0)))
  Test.assert_ne(cg_type_node_hash(ty_unsupported(1)), cg_type_node_hash(ty_unsupported(2)))
  Test.assert_ne(cg_type_node_hash(ty_assoc(ty_i64(), 11)), cg_type_node_hash(ty_assoc(ty_i64(), 12)))
  Test.assert_ne(cg_type_node_hash(ty_array(ty_i64(), 2)), cg_type_node_hash(ty_array(ty_str(), 2)))
  Test.assert_ne(cg_type_node_hash(ty_array(ty_i64(), 2)), cg_type_node_hash(ty_array(ty_i64(), 3)))
  Test.assert_eq(cg_type_node_hash(ty_array(ty_i64(), 0)), cg_type_node_hash(ty_array(ty_str(), 0)))
  Test.assert_ne(cg_type_node_hash(ty_slice(ty_i64())), cg_type_node_hash(ty_mut_slice(ty_i64())))
  Test.assert_ne(cg_type_node_hash(ty_slice(ty_i64())), cg_type_node_hash(ty_slice(ty_str())))
  Test.assert_ne(cg_type_node_hash(ty_record_field(11, ty_i64(), 0, 0)), cg_type_node_hash(ty_record_field(11, ty_str(), 0, 0)))

  let left = nlist_new()
  let right = nlist_new()
  nlist_add(left, ty_array(ty_i64(), 0))
  nlist_add(right, ty_array(ty_str(), 2))
  Test.assert_ne(mono_spec_hash(42, left), mono_spec_hash(42, right))
}
