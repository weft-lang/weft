use stdlib/num as num
use stdlib/num.{*}
use stdlib/test.{Test}
use runtime/defer_order_test.{OwnedAbortToken, owned_abort_token_new, defer_order_log_new, defer_order_log_read}

type NestedReading {
  NoReading,
  ActualReading(f64),
  PredictedReading(f64)
}

fn nested_reading(mode: i64, value: f64) -> NestedReading {
  match mode {
    0 -> NoReading
    1 -> ActualReading(value)
    _ -> PredictedReading(value)
  }
}

fn nested_reading_middle(mode: i64, value: f64) -> NestedReading {
  match nested_reading(mode, value) {
    NoReading -> NoReading
    ActualReading(value) -> PredictedReading(value)
    PredictedReading(value) -> ActualReading(value)
  }
}

fn nested_reading_outer(mode: i64, value: f64) -> NestedReading {
  match nested_reading_middle(mode, value) {
    NoReading -> NoReading
    ActualReading(value) -> PredictedReading(value)
    PredictedReading(value) -> ActualReading(value)
  }
}

fn nested_reading_bits(mode: i64, value: f64) -> u64 {
  match nested_reading_outer(mode, value) {
    NoReading -> 17.0.to_bits()
    ActualReading(value) -> value.to_bits()
    PredictedReading(value) -> value.to_bits()
  }
}

test "nested variant producers preserve immediate tags and every floating point bit" {
  let patterns: [u64; 7] = [0, 9223372036854775808, 1, 4607182418800017408, 9218868437227405312, 18442240474082181120, 9221120237041095221]
  for bits in patterns {
    let value = num.f64_from_bits(bits)
    Test.assert_true(nested_reading_bits(1, value) == bits)
    Test.assert_true(nested_reading_bits(2, value) == bits)
    Test.assert_true(nested_reading_bits(0, value) == 17.0.to_bits())
  }
}

fn nested_reading_saved(mode: i64, value: f64) -> () -> NestedReading {
  let result = nested_reading_outer(mode, value)
  () => result
}

test "nested results captured by a closure retain their boxed constructor identity" {
  let absent = nested_reading_saved(0, 1.25)
  let actual = nested_reading_saved(1, 1.25)
  let predicted = nested_reading_saved(2, 2.5)
  for repetition in 0..3 {
    Test.assert_true(match absent() { NoReading -> true, _ -> false })
    Test.assert_true(match actual() { ActualReading(value) -> value == 1.25, _ -> false })
    Test.assert_true(match predicted() { PredictedReading(value) -> value == 2.5, _ -> false })
  }
}

effect NestedReadingSource {
  fn mode() -> i64
}

fn nested_reading_source(log: i64, value: f64) -[NestedReadingSource]> NestedReading {
  let token: owned OwnedAbortToken = owned_abort_token_new(log, 3)
  match NestedReadingSource.mode() {
    0 -> NoReading
    1 -> ActualReading(value)
    _ -> PredictedReading(value)
  }
}

fn nested_reading_effect_middle(log: i64, value: f64) -[NestedReadingSource]> NestedReading {
  let token: owned OwnedAbortToken = owned_abort_token_new(log, 2)
  match nested_reading_source(log, value) {
    NoReading -> NoReading
    ActualReading(value) -> PredictedReading(value)
    PredictedReading(value) -> ActualReading(value)
  }
}

fn nested_reading_effect_observe(log: i64, value: f64) -[NestedReadingSource]> f64 {
  let token: owned OwnedAbortToken = owned_abort_token_new(log, 1)
  match nested_reading_effect_middle(log, value) {
    NoReading -> 17.0
    ActualReading(value) -> value
    PredictedReading(value) -> value
  }
}

test "nested producer calls preserve effect resumption and exact resource cleanup" {
  for mode in 0..3 {
    let log = defer_order_log_new()
    let result = handle nested_reading_effect_observe(log, 12.5) {
      NestedReadingSource.mode() -> resume(mode)
    }
    Test.assert_true(result == if mode == 0 { 17.0 } else { 12.5 })
    Test.assert_eq(defer_order_log_read(log), 321)
  }
}

test "aborting a nested producer releases each suspended owner exactly once" {
  let log = defer_order_log_new()
  let result = handle nested_reading_effect_observe(log, 12.5) {
    NestedReadingSource.mode() -> 42.0
  }
  Test.assert_true(result == 42.0)
  Test.assert_eq(defer_order_log_read(log), 321)
}
