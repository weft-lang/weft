fn bit(b: bool) -> i64 {
  if b { 1 } else { 0 }
}

fn same(a: f64, b: f64) -> i64 {
  bit(a == b)
}

fn near(a: f64, b: f64, eps: f64) -> i64 {
  let diff = if a > b { a - b } else { b - a }
  bit(diff < eps)
}

fn add_f64(a: f64, b: f64) -> f64 {
  a + b
}

fn scale_shift(x: f64) -> f64 {
  x * 2.0 - 1.25
}

fn branch_score(x: f64) -> i64 {
  if x < 2.5 { 11 } else { 7 }
}

test "f64_literal_and_arithmetic_exact_halves" {
  Test.assert_eq(same(1.5 + 2.25, 3.75), 1)
  Test.assert_eq(same(7.5 / 2.5, 3.0), 1)
  Test.assert_eq(same(3.5 - 1.25, 2.25), 1)
  Test.assert_eq(same(1.5 * 2.0, 3.0), 1)
}

test "f64_function_params_return_and_locals" {
  let x: f64 = add_f64(1.125, 2.375)
  let y = scale_shift(x)
  Test.assert_eq(same(y, 5.75), 1)
}

test "f64_comparison_matrix" {
  let a = bit(1.5 < 2.0)
  let b = bit(2.0 > 1.5) * 2
  let c = bit(2.0 <= 2.0) * 4
  let d = bit(2.0 >= 2.0) * 8
  let e = bit(2.0 == 2.0) * 16
  let f = bit(2.0 != 3.0) * 32
  Test.assert_eq(a + b + c + d + e + f, 63)
}

test "f64_direct_branch_comparison" {
  Test.assert_eq(branch_score(2.25), 11)
  Test.assert_eq(branch_score(2.5), 7)
}

test "f64_negative_literal_desugaring" {
  Test.assert_eq(same(-2.5, 0.0 - 2.5), 1)
  Test.assert_eq(same(-2.5 + 5.0, 2.5), 1)
}

test "f64_long_fractional_literal_does_not_overflow_decimal_lowering" {
  let value = 0.0000690460016972063023
  Test.assert_eq(bit(value > 0.000069046001697), 1)
  Test.assert_eq(bit(value < 0.000069046001698), 1)
  Test.assert_eq(near(value * 365.24, 0.025218361659888, 0.000000000001), 1)
}

test "f64_exponent_literal_notation_evaluates_directly" {
  Test.assert_eq(same(1e3, 1000.0), 1)
  Test.assert_eq(same(1.25e2, 125.0), 1)
  Test.assert_eq(near(1e-3, 0.001, 0.000000000000001), 1)
}

test "f64_subnormal_and_overflow_literals_evaluate_directly" {
  Test.assert_eq(bit(5e-324 > 0.0), 1)
  Test.assert_eq(same(1e-324, 0.0), 1)
  Test.assert_eq(same(1e309, 1.0 / 0.0), 1)
}

test "f64_precision_boundary_rounds_nearest_even" {
  let rounded = 9007199254740993.0
  Test.assert_eq(same(rounded, 9007199254740992.0), 1)
}

test "float_literal_does_not_capture_range_operator" {
  let mut total = 0
  for i in 1..3 {
    total = total + i
  }
  Test.assert_eq(total, 3)
}
