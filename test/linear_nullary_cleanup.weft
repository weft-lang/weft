use runtime/defer_order_test.{
  OwnedAbortToken,
  defer_order_log_new,
  defer_order_log_read,
  owned_abort_token_new
}

type CleanupChoice {
  CleanupEmpty,
  CleanupOtherEmpty,
  CleanupHeld(owned OwnedAbortToken)
}

type CleanupEnvelope {
  choice: CleanupChoice,
  token: owned OwnedAbortToken
}

type CleanupOpaque = opaque CleanupChoice

effect CleanupAbort { fn stop() -> i64 }

fn cleanup_empty(other: bool) -> CleanupChoice {
  if other { CleanupOtherEmpty } else { CleanupEmpty }
}

fn cleanup_discard(choice: CleanupChoice) -> i64 { 42 }

fn cleanup_nested(log: i64, held: bool) -> i64 {
  let envelope = CleanupEnvelope {
    choice: if held { CleanupHeld(owned_abort_token_new(log, 1)) } else { CleanupEmpty },
    token: owned_abort_token_new(log, 2)
  }
  42
}

fn cleanup_opaque(log: i64, held: bool) -> i64 {
  let choice = CleanupOpaque(
    if held { CleanupHeld(owned_abort_token_new(log, 3)) } else { CleanupOtherEmpty }
  )
  42
}

fn cleanup_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let choice: CleanupChoice = if held { CleanupHeld(owned_abort_token_new(log, 4)) } else {
    CleanupEmpty
  }
  CleanupAbort.stop() + 100
}

fn cleanup_replace(log: i64) -> i64 {
  let mut choice: CleanupChoice = CleanupEmpty
  choice = CleanupHeld(owned_abort_token_new(log, 5))
  choice = CleanupOtherEmpty
  42
}

fn cleanup_inferred_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let choice = if held { CleanupHeld(owned_abort_token_new(log, 4)) } else { CleanupEmpty }
  CleanupAbort.stop() + 100
}

fn cleanup_inferred_match(log: i64, held: bool) -> i64 {
  let choice = match held {
    true -> CleanupHeld(owned_abort_token_new(log, 3))
    false -> CleanupOtherEmpty
  }
  42
}

fn cleanup_inferred_mut(log: i64, held: bool) -> i64 {
  let mut choice = if held { CleanupHeld(owned_abort_token_new(log, 1)) } else { CleanupEmpty }
  choice = CleanupHeld(owned_abort_token_new(log, 2))
  42
}

test "nullary linear alternatives transfer and discard without backing storage" {
  Test.assert_eq(cleanup_discard(cleanup_empty(false)), 42)
  Test.assert_eq(cleanup_discard(cleanup_empty(true)), 42)
}

test "nested linear cleanup skips empty payloads and preserves drop order" {
  let empty = defer_order_log_new()
  Test.assert_eq(cleanup_nested(empty, false), 42)
  Test.assert_eq(defer_order_log_read(empty), 2)
  let held = defer_order_log_new()
  Test.assert_eq(cleanup_nested(held, true), 42)
  Test.assert_eq(defer_order_log_read(held), 21)
}

test "opaque linear cleanup preserves immediate and allocated alternatives" {
  let empty = defer_order_log_new()
  Test.assert_eq(cleanup_opaque(empty, false), 42)
  Test.assert_eq(defer_order_log_read(empty), 0)
  let held = defer_order_log_new()
  Test.assert_eq(cleanup_opaque(held, true), 42)
  Test.assert_eq(defer_order_log_read(held), 3)
}

test "abort cleanup skips nullary alternatives and drops held resources once" {
  let empty = defer_order_log_new()
  Test.assert_eq(handle cleanup_abort(empty, false) { CleanupAbort.stop() -> 42 }, 42)
  Test.assert_eq(defer_order_log_read(empty), 0)
  let held = defer_order_log_new()
  Test.assert_eq(handle cleanup_abort(held, true) { CleanupAbort.stop() -> 42 }, 42)
  Test.assert_eq(defer_order_log_read(held), 4)
}

test "linear replacement handles both immediate to heap transitions" {
  let log = defer_order_log_new()
  Test.assert_eq(cleanup_replace(log), 42)
  Test.assert_eq(defer_order_log_read(log), 5)
}

test "inferred constructor joins preserve abort cleanup obligations" {
  let empty = defer_order_log_new()
  Test.assert_eq(handle cleanup_inferred_abort(empty, false) { CleanupAbort.stop() -> 42 }, 42)
  Test.assert_eq(defer_order_log_read(empty), 0)
  let held = defer_order_log_new()
  Test.assert_eq(handle cleanup_inferred_abort(held, true) { CleanupAbort.stop() -> 42 }, 42)
  Test.assert_eq(defer_order_log_read(held), 4)
}

test "inferred match and mutable bindings retain complete resource layouts" {
  let empty = defer_order_log_new()
  Test.assert_eq(cleanup_inferred_match(empty, false), 42)
  Test.assert_eq(defer_order_log_read(empty), 0)
  let held = defer_order_log_new()
  Test.assert_eq(cleanup_inferred_match(held, true), 42)
  Test.assert_eq(defer_order_log_read(held), 3)
  let replaced = defer_order_log_new()
  Test.assert_eq(cleanup_inferred_mut(replaced, true), 42)
  Test.assert_eq(defer_order_log_read(replaced), 12)
  let introduced = defer_order_log_new()
  Test.assert_eq(cleanup_inferred_mut(introduced, false), 42)
  Test.assert_eq(defer_order_log_read(introduced), 2)
}

effect CleanupGive { fn give(choice: CleanupChoice) -> i64 }

fn cleanup_take(choice: CleanupChoice) -> i64 { 1 }

fn cleanup_pick(log: i64, held: bool) -> CleanupChoice {
  if held { CleanupHeld(owned_abort_token_new(log, 4)) } else { CleanupEmpty }
}

fn cleanup_mut_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let mut choice = if held { CleanupHeld(owned_abort_token_new(log, 1)) } else { CleanupEmpty }
  let first = CleanupAbort.stop()
  choice = CleanupHeld(owned_abort_token_new(log, 2))
  first
}

fn cleanup_call_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let taken = cleanup_take(
    if held { CleanupHeld(owned_abort_token_new(log, 4)) } else { CleanupEmpty }
  )
  CleanupAbort.stop() + taken
}

fn cleanup_record_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let envelope = CleanupEnvelope {
    choice: if held { CleanupHeld(owned_abort_token_new(log, 1)) } else { CleanupEmpty },
    token: owned_abort_token_new(log, 2)
  }
  CleanupAbort.stop() + 100
}

fn cleanup_match_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let choice = match held {
    true -> CleanupHeld(owned_abort_token_new(log, 3))
    false -> CleanupOtherEmpty
  }
  CleanupAbort.stop() + 100
}

fn cleanup_opaque_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let choice = CleanupOpaque(
    if held { CleanupHeld(owned_abort_token_new(log, 3)) } else { CleanupOtherEmpty }
  )
  CleanupAbort.stop() + 100
}

fn cleanup_effect_join_abort(log: i64, held: bool) -[CleanupAbort, CleanupGive]> i64 {
  let given = CleanupGive.give(
    if held { CleanupHeld(owned_abort_token_new(log, 4)) } else { CleanupEmpty }
  )
  CleanupAbort.stop() + given
}

fn cleanup_returned_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let choice = cleanup_pick(log, held)
  CleanupAbort.stop() + 100
}

fn cleanup_nested_join_abort(log: i64, which: i64) -[CleanupAbort]> i64 {
  let choice: CleanupChoice = if which == 0 { CleanupEmpty } else {
    if which == 1 { CleanupHeld(owned_abort_token_new(log, 1)) } else {
      match which == 2 {
        true -> CleanupHeld(owned_abort_token_new(log, 2))
        false -> CleanupOtherEmpty
      }
    }
  }
  CleanupAbort.stop() + 100
}

fn cleanup_moved_join_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let first = CleanupHeld(owned_abort_token_new(log, 1))
  let choice = if held { first } else {
    cleanup_take(first)
    CleanupHeld(owned_abort_token_new(log, 2))
  }
  CleanupAbort.stop() + 100
}

fn cleanup_aborted_log(run: (i64) -[CleanupAbort]> i64) -> i64 {
  let log = defer_order_log_new()
  let result = handle run(log) { CleanupAbort.stop() -> 42 }
  if result == 42 { defer_order_log_read(log) } else { 0 - 1 }
}

test "aborting after a mutable slot initialised through a join drops its choice once" {
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_mut_join_abort(log, true)), 1)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_mut_join_abort(log, false)), 0)
}

test "aborting after joins consumed by calls, fields, matches and wrappers drops once" {
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_call_join_abort(log, true)), 4)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_call_join_abort(log, false)), 0)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_record_join_abort(log, true)), 21)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_record_join_abort(log, false)), 2)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_match_join_abort(log, true)), 3)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_opaque_join_abort(log, true)), 3)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_returned_join_abort(log, true)), 4)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_returned_join_abort(log, false)), 0)
}

test "aborting after a join transported through an effect drops once" {
  let log = defer_order_log_new()
  let result = handle handle cleanup_effect_join_abort(log, true) {
    CleanupGive.give(choice) -> resume(1)
  } { CleanupAbort.stop() -> 42 }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 4)
}

test "nested joins and a local moved into one arm keep exact abort obligations" {
  for which in 0..4 {
    let expected = if which == 1 { 1 } else { if which == 2 { 2 } else { 0 } }
    Test.assert_eq(
      cleanup_aborted_log((log: i64) => cleanup_nested_join_abort(log, which)),
      expected
    )
  }
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_moved_join_abort(log, true)), 1)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_moved_join_abort(log, false)), 12)
}

type CleanupWrapped { CleanupWrap(CleanupChoice), CleanupBare }

type CleanupLayout { choice: CleanupChoice, small: i32, token: owned OwnedAbortToken }

fn cleanup_record_abort(log: i64) -[CleanupAbort]> i64 {
  let envelope = CleanupEnvelope {
    choice: CleanupHeld(owned_abort_token_new(log, 1)),
    token: owned_abort_token_new(log, 2)
  }
  CleanupAbort.stop() + 100
}

fn cleanup_wrapped(log: i64, held: bool) -> i64 {
  let wrapped = CleanupWrap(
    if held { CleanupHeld(owned_abort_token_new(log, 5)) } else { CleanupEmpty }
  )
  7
}

fn cleanup_wrapped_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let wrapped = CleanupWrap(
    if held { CleanupHeld(owned_abort_token_new(log, 3)) } else { CleanupEmpty }
  )
  CleanupAbort.stop() + 100
}

fn cleanup_layout(log: i64) -> i64 {
  let layout = CleanupLayout {
    choice: CleanupHeld(owned_abort_token_new(log, 4)),
    small: 1,
    token: owned_abort_token_new(log, 5)
  }
  7
}

fn cleanup_layout_abort(log: i64, held: bool) -[CleanupAbort]> i64 {
  let layout = CleanupLayout {
    choice: if held { CleanupHeld(owned_abort_token_new(log, 1)) } else { CleanupEmpty },
    small: 3,
    token: owned_abort_token_new(log, 2)
  }
  CleanupAbort.stop() + 100
}

test "a linear field is dropped by its aggregate's glue alone" {
  let wrapped = defer_order_log_new()
  Test.assert_eq(cleanup_wrapped(wrapped, true), 7)
  Test.assert_eq(defer_order_log_read(wrapped), 5)
  let empty = defer_order_log_new()
  Test.assert_eq(cleanup_wrapped(empty, false), 7)
  Test.assert_eq(defer_order_log_read(empty), 0)
  let layout = defer_order_log_new()
  Test.assert_eq(cleanup_layout(layout), 7)
  Test.assert_eq(defer_order_log_read(layout), 54)
}

test "aborting after an aggregate owns its linear components drops each once" {
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_record_abort(log)), 21)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_wrapped_abort(log, true)), 3)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_wrapped_abort(log, false)), 0)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_layout_abort(log, true)), 21)
  Test.assert_eq(cleanup_aborted_log((log: i64) => cleanup_layout_abort(log, false)), 2)
}
