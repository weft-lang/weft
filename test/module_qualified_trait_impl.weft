use module_fixtures/g2_trait_left as left
use module_fixtures/g2_trait_right as right

type QualifiedGaugeBox {
  value: i64
}

impl left.Gauge for QualifiedGaugeBox {
  fn left(self) -> i64 { self.value }
}

impl right.Gauge for QualifiedGaugeBox {
  fn right(self) -> i64 { self.value + 1 }
}

test "qualified trait impl resolves the exact declaration" {
  let box = QualifiedGaugeBox { value: 42 }
  Test.assert_eq(box.left(), 42)
  Test.assert_eq(box.right(), 43)
}
