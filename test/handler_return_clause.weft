-- 4c (kernel §7.3): `return v -> expr` transforms the handled
-- expression's normal completion. Requires all op clauses to resume
-- (tier-2 has no abort edge yet — see 4c brief).

effect Ask {
  fn ask() -> i64
}

effect Sup {
  fn word() -> str
}

fn compute() -[Ask]> i64 {
  Ask.ask() + Ask.ask()
}

fn speak() -[Sup]> str {
  Sup.word()
}

fn outer_sum() -[Ask]> i64 {
  let inner = handle compute() {
    Ask.ask() -> resume(5)
    return v -> v * 10
  }
  inner + Ask.ask()
}

test "return_clause_transforms_completion" {
  let got = handle compute() {
    Ask.ask() -> resume(10)
    return v -> v * 2
  }
  Test.assert_eq(got, 40)
}

test "return_clause_changes_handle_type" {
  let got = handle speak() {
    Sup.word() -> resume("weft")
    return v -> __str_len(v)
  }
  Test.assert_eq(got, 4)
}

test "return_clause_nested_handles" {
  let got = handle outer_sum() {
    Ask.ask() -> resume(2)
    return v -> v + 1
  }
  Test.assert_eq(got, 103)
}

test "return_clause_identity" {
  let got = handle compute() {
    Ask.ask() -> resume(21)
    return v -> v
  }
  Test.assert_eq(got, 42)
}

test "return_clause_binder_shadowing_ok" {
  let v = 7
  let got = handle compute() {
    Ask.ask() -> resume(v)
    return v -> v + 100
  }
  Test.assert_eq(got, 114)
}
