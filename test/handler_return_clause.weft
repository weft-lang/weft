-- parameterized effects (kernel §7.3): `return v -> expr` transforms the handled
-- expression's normal completion. Abortive clauses bypass that transform.

effect Ask {
  fn ask() -> i64
}

effect Sup {
  fn word() -> str
}

effect ReturnFail {
  fn fail(error: i64) -> never
}

fn compute() -[Ask]> i64 {
  Ask.ask() + Ask.ask()
}

fn speak() -[Sup]> str {
  Sup.word()
}

fn return_clause_generic_tuple<T, E>(body: () -[Sup, E]> T) -[E]> T {
  let fallback = "weft"
  handle body() {
    Sup.word() -> resume(fallback)
    return value -> value
  }
}

fn return_clause_tuple_body() -[Sup]> (str, i64) {
  (Sup.word(), 42)
}

fn outer_sum() -[Ask]> i64 {
  let inner = handle compute() {
    Ask.ask() -> resume(5)
    return v -> v * 10
  }
  inner + Ask.ask()
}

fn return_or_fail(should_fail: bool) -[ReturnFail]> i64 {
  if should_fail { ReturnFail.fail(41) } else { 20 }
}

test "return_clause_transforms_completion" {
  let got = handle compute() {
    Ask.ask() -> resume(10)
    return v -> v * 2
  }
  Test.assert_eq(got, 40)
}

test "return_clause_changes_handle_type" {
  let got = handle speak() {
    Sup.word() -> resume("weft")
    return v -> __str_len(v)
  }
  Test.assert_eq(got, 4)
}

test "return_clause_nested_handles" {
  let got = handle outer_sum() {
    Ask.ask() -> resume(2)
    return v -> v + 1
  }
  Test.assert_eq(got, 103)
}

test "return_clause_identity" {
  let got = handle compute() {
    Ask.ask() -> resume(21)
    return v -> v
  }
  Test.assert_eq(got, 42)
}

test "return_clause_generic_identity_preserves_wide_managed_value" {
  let value = return_clause_generic_tuple(return_clause_tuple_body)
  let (word, number): (str, i64) = value
  Test.assert_eq(if word == "weft" { number } else { 0 }, 42)
}

test "return_clause_binder_shadowing_ok" {
  let v = 7
  let got = handle compute() {
    Ask.ask() -> resume(v)
    return v -> v + 100
  }
  Test.assert_eq(got, 114)
}

test "return_clause_transforms_completion_but_abort_bypasses_transform" {
  let completed = handle return_or_fail(false) {
    ReturnFail.fail(error) -> error + 1
    return value -> value * 2
  }
  let aborted = handle return_or_fail(true) {
    ReturnFail.fail(error) -> error + 1
    return value -> value * 2
  }
  Test.assert_eq(completed, 40)
  Test.assert_eq(aborted, 42)
}
