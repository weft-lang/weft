use "stdlib/continuation.weft"

effect StoredYield {
  @deferred fn yield(value: i64) -> i64
}

fn stored_once_producer() -[StoredYield]> i64 {
  let next = StoredYield.yield(10)
  next + 1
}

fn stored_arg_producer(base: i64) -[StoredYield]> i64 {
  let next = StoredYield.yield(base)
  next + base
}

fn stored_continuation_resume_once() -> i64 {
  let cell = continuation_cell_new()
  let first = handle stored_once_producer() {
    StoredYield.yield(value) with k -> {
      let ok = continuation_cell_store_i64(cell, k)
      value + ok
    }
  }
  let full_after_store = continuation_cell_is_full(cell)
  let second = continuation_cell_resume_i64(cell, 41, 0)
  let full_after_resume = continuation_cell_is_full(cell)
  first * 1000 + full_after_store * 100 + second * 10 + full_after_resume
}

fn stored_continuation_drop_before_resume() -> i64 {
  let cell = continuation_cell_new()
  let first = handle stored_once_producer() {
    StoredYield.yield(value) with k -> {
      continuation_cell_store_i64(cell, k)
      value
    }
  }
  let full_after_store = continuation_cell_is_full(cell)
  let dropped = continuation_cell_drop_i64(cell)
  let resumed_empty = continuation_cell_resume_i64(cell, 99, 7)
  first * 1000 + full_after_store * 100 + dropped * 10 + resumed_empty
}

fn stored_continuations_two_cells_independent() -> i64 {
  let left = continuation_cell_new()
  let right = continuation_cell_new()
  let first = handle stored_arg_producer(5) {
    StoredYield.yield(value) with k -> {
      continuation_cell_store_i64(left, k)
      value
    }
  }
  let second = handle stored_arg_producer(7) {
    StoredYield.yield(value) with k -> {
      continuation_cell_store_i64(right, k)
      value
    }
  }
  let right_resumed = continuation_cell_resume_i64(right, 30, 0)
  let left_resumed = continuation_cell_resume_i64(left, 20, 0)
  first * 10000 + second * 1000 + left_resumed * 10 + right_resumed
}

fn stored_cell_rejects_overwrite_and_keeps_first() -> i64 {
  let cell = continuation_cell_new()
  let first = handle stored_arg_producer(1) {
    StoredYield.yield(value) with k -> {
      continuation_cell_store_i64(cell, k)
      value
    }
  }
  let second = handle stored_arg_producer(2) {
    StoredYield.yield(value) with k -> {
      let ok = continuation_cell_store_i64(cell, k)
      value + ok
    }
  }
  let resumed = continuation_cell_resume_i64(cell, 10, 0)
  first * 1000 + second * 100 + resumed
}

fn stored_empty_cell_resume_and_drop_are_inert() -> i64 {
  let cell = continuation_cell_new()
  let resumed = continuation_cell_resume_i64(cell, 99, 123)
  let dropped = continuation_cell_drop_i64(cell)
  resumed + dropped
}

fn stored_continuation_resume_twice_uses_default_after_consume() -> i64 {
  let cell = continuation_cell_new()
  handle stored_once_producer() {
    StoredYield.yield(value) with k -> {
      continuation_cell_store_i64(cell, k)
      value
    }
  }
  let first = continuation_cell_resume_i64(cell, 8, 0)
  let second = continuation_cell_resume_i64(cell, 99, 7)
  let dropped = continuation_cell_drop_i64(cell)
  first * 100 + second * 10 + dropped
}

test "stored_continuation_resume_once" {
  Test.assert_eq(stored_continuation_resume_once(), 11520)
}

test "stored_continuation_drop_before_resume" {
  Test.assert_eq(stored_continuation_drop_before_resume(), 10117)
}

test "stored_continuations_two_cells_independent" {
  Test.assert_eq(stored_continuations_two_cells_independent(), 57287)
}

test "stored_cell_rejects_overwrite_and_keeps_first" {
  Test.assert_eq(stored_cell_rejects_overwrite_and_keeps_first(), 1211)
}

test "stored_empty_cell_resume_and_drop_are_inert" {
  Test.assert_eq(stored_empty_cell_resume_and_drop_are_inert(), 123)
}

test "stored_continuation_resume_twice_uses_default_after_consume" {
  Test.assert_eq(stored_continuation_resume_twice_uses_default_after_consume(), 970)
}
