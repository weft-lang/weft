use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/string
use stdlib/result
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_weak_count, runtime_rc_test_heap_arena_offset}

type Packet { name: str, value: Bytes, code: i64 }
type Envelope { packet: Packet, trailer: str }

fn packet() -> Packet {
  Packet { name: "name".concat("!"), value: bytes.from_str("payload"), code: 7 }
}

fn projected_length() -> usize { packet().value.len() }
fn projected_scalar() -> usize {
  if packet().code == 7 { let one: usize = 1; one } else { let zero: usize = 0; zero }
}
fn projected_name() -> usize { packet().name.len() }
fn retained_payload() -> Bytes { packet().value }
fn returned_projection_length() -> usize { retained_payload().len() }
fn nested_projection_length() -> usize {
  Envelope { packet: packet(), trailer: "tail".concat("!") }.packet.value.len()
}
fn borrowed_projection_length() -> usize {
  let source = packet()
  let value = source.value
  value.len() + source.value.len()
}

fn heap_growth(f: () -> usize) -> i64 {
  for _ in 0..50 { f() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { f() }
  runtime_rc_test_heap_arena_offset() - before
}

test "managed fields survive temporary record cleanup" {
  Test.assert_eq_usize(projected_length(), 7)
  Test.assert_eq(heap_growth(projected_length), 0)
  Test.assert_eq_usize(projected_name(), 5)
  Test.assert_eq(heap_growth(projected_name), 0)
}

test "scalar projection releases every managed sibling" {
  Test.assert_eq_usize(projected_scalar(), 1)
  Test.assert_eq(heap_growth(projected_scalar), 0)
}

test "returned fields own their lifetime independently of the temporary" {
  let value = retained_payload()
  for _ in 0..100 { packet() }
  Test.assert_str_eq(value.to_utf8().unwrap(), "payload")
  Test.assert_eq(heap_growth(returned_projection_length), 0)
}

test "nested projections release each temporary owner" {
  Test.assert_eq_usize(nested_projection_length(), 7)
  Test.assert_eq(heap_growth(nested_projection_length), 0)
}

test "field access preserves a shared source for later use" {
  Test.assert_eq_usize(borrowed_projection_length(), 14)
  Test.assert_eq(heap_growth(borrowed_projection_length), 0)
}

fn structural_packet() -> {name: str, value: Bytes} {
  {name: "name".concat("!"), value: bytes.from_str("payload")}
}
fn structural_projection_length() -> usize { structural_packet().value.len() }
fn tuple_packet() -> (str, Bytes) { ("name".concat("!"), bytes.from_str("payload")) }
fn tuple_projection_length() -> usize { tuple_packet().1.len() }

test "structural record and tuple projections release unused lanes" {
  Test.assert_eq_usize(structural_projection_length(), 7)
  Test.assert_eq(heap_growth(structural_projection_length), 0)
  Test.assert_eq_usize(tuple_projection_length(), 7)
  Test.assert_eq(heap_growth(tuple_projection_length), 0)
}

fn generic_packet<T>(value: T) -> {name: str, value: T} {
  {name: "name".concat("!"), value: value}
}
fn generic_projection<T>(value: T) -> T { generic_packet<T>(value).value }
fn generic_projection_length() -> usize {
  let (label, value) = generic_projection<(str, Bytes)>(("tag".concat("!"), bytes.from_str("payload")))
  label.len() + value.len()
}
test "generic projection preserves every selected managed lane" {
  Test.assert_eq_usize(generic_projection_length(), 11)
  Test.assert_eq(heap_growth(generic_projection_length), 0)
}

type ArrayPacket { values: [str; 2], trailer: str }
fn array_packet() -> ArrayPacket {
  ArrayPacket { values: ["first".concat("!"), "last".concat("!")], trailer: "tail".concat("!") }
}
fn array_projection_length() -> usize {
  let values = array_packet().values
  values[0].len() + values[1].len()
}
fn array_sibling_projection_length() -> usize { array_packet().trailer.len() }
fn structural_array_packet(text: str) -> {values: [str; 2], trailer: str} {
  {values: [text.concat("!"), text.concat("?")], trailer: "tail".concat("!")}
}
fn structural_array_projection_length() -> usize {
  let values = structural_array_packet("first").values
  for _ in 0..20 { structural_array_packet("overwritten") }
  values[0].len() + values[1].len()
}
fn borrowed_structural_array_projection_length() -> usize {
  let source = structural_array_packet("first")
  let mut values = source.values
  values[0] = "new"
  source.values[0].len() + values[0].len()
}
test "array fields survive temporary cleanup and detach before mutation" {
  Test.assert_eq_usize(array_projection_length(), 11)
  Test.assert_eq(heap_growth(array_projection_length), 0)
  Test.assert_eq_usize(array_sibling_projection_length(), 5)
  Test.assert_eq(heap_growth(array_sibling_projection_length), 0)
  Test.assert_eq_usize(structural_array_projection_length(), 12)
  Test.assert_eq(heap_growth(structural_array_projection_length), 0)
  Test.assert_eq_usize(borrowed_structural_array_projection_length(), 9)
  Test.assert_eq(heap_growth(borrowed_structural_array_projection_length), 0)
}

fn discarded_loop_results() -> usize {
  for _ in 0..20 { structural_array_packet("overwritten") }
  for _ in [1, 2, 3] { structural_array_packet("overwritten") }
  let shared = packet()
  for index in 0..4 {
    match index { 0 -> shared _ -> packet() }
  }
  shared.value.len()
}
fn loop_initializer_projection() -> usize {
  let mut total: usize = 0
  for index in 0..4 {
    let current = match index {
      0 -> continue
      3 -> break
      _ -> structural_packet()
    }
    total = total + current.value.len()
  }
  total
}
test "loops release discarded managed results and preserve borrowed branches" {
  Test.assert_eq_usize(discarded_loop_results(), 7)
  Test.assert_eq(heap_growth(discarded_loop_results), 0)
  Test.assert_eq_usize(loop_initializer_projection(), 14)
  Test.assert_eq(heap_growth(loop_initializer_projection), 0)
}

fn conditional_projection_length() -> usize {
  let shared = packet()
  let mut sum: usize = 0
  for choose in [true, false] {
    sum = sum + (if choose { shared } else { packet() }).value.len()
  }
  sum + shared.value.len()
}
test "conditional projections preserve both shared and temporary branches" {
  Test.assert_eq_usize(conditional_projection_length(), 21)
  Test.assert_eq(heap_growth(conditional_projection_length), 0)
}

effect ProjectionStop { fn stop() -> never }
fn consume_payload(value: Bytes, other: i64) -> usize { value.len() }
fn aborted_projection_length() -> usize {
  let stopped: usize = 7
  handle consume_payload(packet().value, { ProjectionStop.stop(); 0 }) {
    ProjectionStop.stop() -> stopped
  }
}
test "abort after projection releases the selected field exactly once" {
  Test.assert_eq_usize(aborted_projection_length(), 7)
  Test.assert_eq(heap_growth(aborted_projection_length), 0)
}

type ClosurePacket { read: () -> usize, trailer: str }
fn closure_packet() -> ClosurePacket {
  let value = bytes.from_str("payload")
  ClosurePacket { read: () => value.len(), trailer: "tail".concat("!") }
}
fn closure_projection_length() -> usize {
  let read = closure_packet().read
  read()
}
test "closure projections retain captured values across temporary cleanup" {
  Test.assert_eq_usize(closure_projection_length(), 7)
  Test.assert_eq(heap_growth(closure_projection_length), 0)
}

effect PacketRead { fn read() -> Packet }
fn handled_projection_length() -> usize {
  handle PacketRead.read().value.len() { PacketRead.read() -> resume(packet()) }
}
test "resumed effect results release their temporary record after projection" {
  Test.assert_eq_usize(handled_projection_length(), 7)
  Test.assert_eq(heap_growth(handled_projection_length), 0)
}

type WeakPacket { reference: weak RuntimeRcProbe, trailer: str }
fn projected_weak(probe: RuntimeRcProbe) -> weak RuntimeRcProbe {
  WeakPacket { reference: weak_ref(probe), trailer: "tail".concat("!") }.reference
}
test "weak projections keep one selected stake and release it at scope exit" {
  let probe = runtime_rc_probe_new(9)
  {
    let reference = projected_weak(probe)
    Test.assert_eq(runtime_rc_probe_weak_count(probe), 1)
    match weak_load(reference) {
      nil -> Test.assert_true(false)
      live: RuntimeRcProbe -> Test.assert_eq(runtime_rc_probe_load(live), 9)
    }
  }
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}
