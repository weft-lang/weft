use stdlib/bytes.{*}
use stdlib/console.{*}
use stdlib/file.{*}
use stdlib/io/types.{*}
use stdlib/num.{*}
use stdlib/path.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

fn text_path() -> Path {
  match path_from_utf8("text.weft") {
    Ok(path) -> path
    Err(error) -> text_path()
  }
}

fn text_result_value(result: Result<str, IoTextError>) -> str {
  match result {
    Ok(text) -> text
    Err(error) -> "error"
  }
}

fn text_result_error_kind(result: Result<str, IoTextError>) -> i64 {
  match result {
    Ok(text) -> 0
    Err(error) -> match error {
      IoTextInvalidUtf8(utf8) -> 100 + utf8_error_offset_or(utf8, 0)
      IoTextIo(io) -> io_error_kind(io)
    }
  }
}

fn text_result_family(result: Result<str, IoTextError>) -> i64 {
  match result {
    Ok(text) -> 0
    Err(error) -> io_text_error_kind(error)
  }
}

fn text_result_utf8_offset(result: Result<str, IoTextError>) -> i64 {
  match result {
    Ok(text) -> 0 - 1
    Err(error) -> io_text_utf8_offset_or(error, 0 - 1)
  }
}

fn invalid_text_bytes() -> Bytes {
  let values = vector_new<u8>()
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(65), 0))
  vector_push<u8>(values, num_int_cast_value_or<u8>(num_i64_to_u8_checked(255), 0))
  bytes_from_vector(values)
}

test "file text read preserves valid UTF-8" {
  let path = text_path()
  let result = handle file_read_text(path, 64) {
    FileRead.read_all(actual, limit) -> {
      Test.assert_true(path_equal(actual, path))
      Test.assert_eq(num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(limit)), 0), 64)
      resume(result_ok<Bytes, IoError>(bytes_from_str("héλlo")))
    }
  }
  Test.assert_str_eq(text_result_value(result), "héλlo")
}

test "file text read preserves transport errors" {
  let result = handle file_read_text(text_path(), 8) {
    FileRead.read_all(path, limit) -> resume(result_err<Bytes, IoError>(IoNotFound))
  }
  Test.assert_eq(text_result_error_kind(result), 3)
  Test.assert_eq(text_result_family(result), 1)
  Test.assert_eq(text_result_utf8_offset(result), 0 - 1)
}

test "file text read reports malformed UTF-8 offset" {
  let result = handle file_read_text(text_path(), 2) {
    FileRead.read_all(path, limit) -> resume(result_ok<Bytes, IoError>(invalid_text_bytes()))
  }
  Test.assert_eq(text_result_error_kind(result), 101)
  Test.assert_eq(text_result_family(result), 2)
  Test.assert_eq(text_result_utf8_offset(result), 1)
}

fn exercise_file_text_writes(path: Path) -[FileWrite]> i64 {
  let a = match file_create_new_text(path, "new") { Ok(count) -> 1 Err(error) -> 0 }
  let b = match file_write_text(path, "hé") { Ok(count) -> 1 Err(error) -> 0 }
  let c = match file_append_text(path, "!") { Ok(count) -> 1 Err(error) -> 0 }
  let d = match file_atomic_replace_text(path, "done") { Ok(count) -> 1 Err(error) -> 0 }
  a + b + c + d
}

test "file text writes preserve every file mode and UTF-8 bytes" {
  let modes = vector_new<i64>()
  let lengths = vector_new<i64>()
  let total = handle exercise_file_text_writes(text_path()) {
    FileWrite.write_all(path, values, mode) -> {
      vector_push<i64>(modes, file_write_mode_kind(mode))
      vector_push<i64>(lengths, bytes_len(values))
      resume(result_ok<usize, IoError>(0))
    }
  }
  Test.assert_eq(total, 4)
  Test.assert_eq(vector_get_in_bounds<i64>(modes, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(modes, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(modes, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(modes, 3), 4)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 0), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 1), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 2), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 3), 4)
}

fn exercise_console_text() -[ConsoleRead, ConsoleWrite]> i64 {
  let read_result = match read(8) { Ok(text) -> if text == "in" { 1 } else { 0 } Err(error) -> 0 }
  let write_result = match write(ConsoleStdout, "a") { Ok(count) -> 1 Err(error) -> 0 }
  let print_result = match try_print("é") { Ok(count) -> 1 Err(error) -> 0 }
  let eprint_result = match try_eprint("err") { Ok(count) -> 1 Err(error) -> 0 }
  let println_result = match try_println("42") { Ok(count) -> 1 Err(error) -> 0 }
  let eprintln_result = match try_eprintln("true") { Ok(count) -> 1 Err(error) -> 0 }
  read_result + write_result + print_result + eprint_result + println_result + eprintln_result
}

fn exercise_console_convenience() -[ConsoleWrite]> i64 {
  print("out")
  eprint("err")
  println("line")
  eprintln("oops")
  4
}

test "console conveniences cover both streams and newline policy" {
  let streams = vector_new<i64>()
  let lengths = vector_new<i64>()
  let total = handle exercise_console_convenience() {
    ConsoleWrite.write_all(stream, values) -> {
      vector_push<i64>(streams, match stream { ConsoleStdout -> 1 ConsoleStderr -> 2 })
      vector_push<i64>(lengths, bytes_len(values))
      resume(result_ok<usize, IoError>(0))
    }
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
  Test.assert_eq(total, 4)
  Test.assert_eq(vector_get_in_bounds<i64>(streams, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(streams, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(streams, 2), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(streams, 3), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 0), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 1), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 2), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 3), 5)
}

test "console text helpers preserve streams and UTF-8 bytes" {
  let events = vector_new<i64>()
  let lengths = vector_new<i64>()
  let total = handle {
    handle exercise_console_text() {
      ConsoleRead.read(limit) -> resume(result_ok<Bytes, IoError>(bytes_from_str("in")))
    }
  } {
    ConsoleWrite.write_all(stream, values) -> {
      vector_push<i64>(events, match stream { ConsoleStdout -> 1 ConsoleStderr -> 2 })
      vector_push<i64>(lengths, bytes_len(values))
      resume(result_ok<usize, IoError>(0))
    }
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
  Test.assert_eq(total, 6)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 1), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 2), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 3), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(events, 4), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 0), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 1), 2)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 2), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 3), 3)
  Test.assert_eq(vector_get_in_bounds<i64>(lengths, 4), 5)
}
