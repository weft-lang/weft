-- A record, tuple, array or variant construction owns each evaluated field,
-- element or payload until the construction completes. A return, break or
-- continue in a later one leaves before that, so the earlier ones must be
-- released (managed) or dropped (linear) on the way out, exactly once.

use runtime/rc_implicit_test.{*}
use runtime/defer_order_test.{
  OwnedAbortToken,
  defer_order_log_new,
  defer_order_log_read,
  owned_abort_token_new
}

type ProbeHolder { probe: RuntimeRcProbe, value: i64 }

type ProbePair { first: RuntimeRcProbe, second: RuntimeRcProbe, value: i64 }

type HolderOfHolder { inner: ProbeHolder, value: i64 }

type ProbeVariant { ProbeAndValue(RuntimeRcProbe, i64), NoProbe }

type TokenHolder { token: owned OwnedAbortToken, value: i64 }

type TokenPair { first: owned OwnedAbortToken, second: owned OwnedAbortToken, value: i64 }

fn same_probe(probe: RuntimeRcProbe) -> RuntimeRcProbe { probe }

fn holder_value(holder: ProbeHolder) -> i64 { holder.value }

fn return_in_later_field(probe: RuntimeRcProbe) -> i64 {
  let holder = ProbeHolder { probe: probe, value: { return 42 } }
  holder_value(holder)
}

fn conditional_return_in_later_field(probe: RuntimeRcProbe, early: bool) -> i64 {
  let holder = ProbeHolder { probe: probe, value: if early { return 42 } else { 1 } }
  holder_value(holder) + 41
}

fn return_after_two_fields(probe: RuntimeRcProbe) -> i64 {
  let pair = ProbePair { first: probe, second: probe, value: { return 42 } }
  pair.value
}

fn return_after_temporary_field(probe: RuntimeRcProbe) -> i64 {
  let holder = ProbeHolder { probe: same_probe(probe), value: { return 42 } }
  holder_value(holder)
}

fn return_after_nested_record(probe: RuntimeRcProbe) -> i64 {
  let outer = HolderOfHolder {
    inner: ProbeHolder { probe: probe, value: 1 },
    value: { return 42 }
  }
  outer.value
}

fn return_in_structural_record(probe: RuntimeRcProbe, early: bool) -> i64 {
  let record = { probe: probe, value: if early { return 42 } else { 1 } }
  record.value + 41
}

fn return_in_tuple(probe: RuntimeRcProbe, early: bool) -> i64 {
  let pair = (probe, if early { return 42 } else { 1 })
  pair.1 + 41
}

test "a return in a later field releases an earlier managed field" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_in_later_field(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a conditional exit releases the field only on the exiting path" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(conditional_return_in_later_field(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(conditional_return_in_later_field(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "an exit releases every earlier field" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_after_two_fields(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "an exit releases an earlier temporary field" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_after_temporary_field(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "an exit releases an earlier nested record" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_after_nested_record(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "an exit releases earlier fields of a structural record" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_in_structural_record(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(return_in_structural_record(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "an exit releases earlier tuple elements" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_in_tuple(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(return_in_tuple(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

fn return_in_later_payload(probe: RuntimeRcProbe, early: bool) -> i64 {
  let variant = ProbeAndValue(probe, if early { return 42 } else { 1 })
  match variant {
    ProbeAndValue(_, value) -> value + 41
    NoProbe -> 0
  }
}

test "a variant constructor releases an earlier payload on exit" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_in_later_payload(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(return_in_later_payload(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a break in a later field releases an earlier field" {
  let probe = runtime_rc_probe_new(41)
  let result = loop {
    let holder = ProbeHolder { probe: probe, value: { break (42) } }
    holder_value(holder)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a continue in a later field releases an earlier field every iteration" {
  let probe = runtime_rc_probe_new(41)
  let mut total = 0
  for index in 0..5 {
    let holder = ProbeHolder { probe: probe, value: if index < 4 { continue } else { index } }
    total = total + holder_value(holder)
  }
  Test.assert_eq(total, 4)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a completed construction keeps its field stake until the record dies" {
  let probe = runtime_rc_probe_new(41)
  let holder = ProbeHolder { probe: probe, value: 1 }
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  Test.assert_eq(holder_value(holder), 1)
}

fn token_value(holder: TokenHolder) -> i64 {
  match holder { { token: _, value } -> value }
}

fn return_after_owned_field(log: i64) -> i64 {
  let holder = TokenHolder { token: owned_abort_token_new(log, 4), value: { return 42 } }
  token_value(holder)
}

fn return_after_two_owned_fields(log: i64, early: bool) -> i64 {
  let pair = TokenPair {
    first: owned_abort_token_new(log, 4),
    second: owned_abort_token_new(log, 5),
    value: if early { return 42 } else { 1 }
  }
  match pair { { first: _, second: _, value } -> value + 41 }
}

test "a return in a later field drops an earlier owned field once" {
  let log = defer_order_log_new()
  Test.assert_eq(return_after_owned_field(log), 42)
  Test.assert_eq(defer_order_log_read(log), 4)
}

-- Evaluated fields drop in reverse order, as a finished record's leaves do.
test "an exit drops every earlier owned field once, latest first" {
  let log = defer_order_log_new()
  Test.assert_eq(return_after_two_owned_fields(log, true), 42)
  Test.assert_eq(defer_order_log_read(log), 54)
}

test "a completed construction drops its owned fields in reverse declaration order" {
  let log = defer_order_log_new()
  Test.assert_eq(return_after_two_owned_fields(log, false), 42)
  Test.assert_eq(defer_order_log_read(log), 54)
}

test "a break in a later field drops an earlier owned field once" {
  let log = defer_order_log_new()
  let result = loop {
    let holder = TokenHolder { token: owned_abort_token_new(log, 7), value: { break (42) } }
    token_value(holder)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

fn return_in_later_element(probe: RuntimeRcProbe) -> i64 {
  let values = [probe, probe, { return 42 }]
  0
}

fn conditional_return_in_later_element(probe: RuntimeRcProbe, early: bool) -> i64 {
  let values = [probe, if early { return 42 } else { probe }]
  runtime_rc_probe_load(values[1]) + 1
}

fn integer_element_exit(early: bool) -> i64 {
  let values = [1, 2, if early { return 7 } else { 3 }]
  values[2]
}

fn integer_element_churn(count: i64) -> i64 {
  let mut total = 0
  for index in 0..count { total = total + integer_element_exit(index % 2 == 0) }
  total
}

test "a return in a later element releases the elements already stored" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(return_in_later_element(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a conditional element exit releases the storage only on the exiting path" {
  let probe = runtime_rc_probe_new(41)
  Test.assert_eq(conditional_return_in_later_element(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(conditional_return_in_later_element(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "a break in a later element releases the elements already stored" {
  let probe = runtime_rc_probe_new(41)
  let result = loop {
    let values = [probe, { break (42) }]
    runtime_rc_probe_count(values[0])
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

-- Heap growth across one churn; warming with the same call settles the free
-- lists and any high-water storage first.
fn integer_element_churn_growth(count: i64) -> i64 {
  let before = runtime_rc_test_heap_arena_offset()
  let total = integer_element_churn(count)
  let after = runtime_rc_test_heap_arena_offset()
  if total == count * 5 { after - before } else { 0 - 1 }
}

test "element exits release the array storage itself" {
  integer_element_churn_growth(10000)
  Test.assert_eq(integer_element_churn_growth(10000), 0)
}
