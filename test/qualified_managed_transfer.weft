use module_fixtures/managed_call_boundary as boundary
use module_fixtures/managed_call_boundary.{ManagedCallBoundary}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_load, runtime_rc_probe_new}
use stdlib/fail.{Fail}
use stdlib/result.{Ok, Err}

fn qualified_transfer_error(value: RuntimeRcProbe) -[ManagedCallBoundary, Fail<i64>]> i64 {
  boundary.exchange(value)?
}

fn qualified_transfer_cfg_error(value: RuntimeRcProbe, other: RuntimeRcProbe, first: bool) -[ManagedCallBoundary, Fail<i64>]> i64 {
  boundary.exchange(if first { value } else { other })?
}

fn qualified_transfer_later_abort(value: RuntimeRcProbe) -[ManagedCallBoundary, Fail<i64>]> i64 {
  let observed = boundary.exchange(value)?
  Fail<i64>.fail(observed)
}

test "qualified call retires its managed argument before Result abort" {
  let value = runtime_rc_probe_new(42)
  let status = handle {
    handle qualified_transfer_error(value) {
      ManagedCallBoundary.exchange(argument) -> resume(Err<i64, i64>(runtime_rc_probe_load(argument)))
    }
  } { Fail<i64>.fail(error) -> error }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "qualified call with branching argument retires the selected managed stake" {
  let value = runtime_rc_probe_new(42)
  let other = runtime_rc_probe_new(73)
  let status = handle {
    handle qualified_transfer_cfg_error(value, other, false) {
      ManagedCallBoundary.exchange(argument) -> resume(Err<i64, i64>(runtime_rc_probe_load(argument)))
    }
  } { Fail<i64>.fail(error) -> error }
  Test.assert_eq(status, 73)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
  Test.assert_eq(runtime_rc_probe_count(other), 1)
}

test "successful qualified call leaves no argument cleanup for a later abort" {
  let value = runtime_rc_probe_new(42)
  let status = handle {
    handle qualified_transfer_later_abort(value) {
      ManagedCallBoundary.exchange(argument) -> resume(Ok<i64, i64>(runtime_rc_probe_load(argument)))
    }
  } { Fail<i64>.fail(error) -> error }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "aborting qualified callee still cleans its managed argument" {
  let value = runtime_rc_probe_new(42)
  let status = handle {
    handle qualified_transfer_error(value) {
      ManagedCallBoundary.exchange(argument) -> runtime_rc_probe_load(argument)
    }
  } { Fail<i64>.fail(error) -> error }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}
