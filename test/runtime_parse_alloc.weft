use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"

use "compiler/pipeline.weft"

fn parse_alloc_count(src: str) -> i64 {
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  nlist_len(pipeline_ast_fns(ast))
}

fn parse_alloc_entries(src: str) -> TypeEntryList {
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  pipeline_ast_type_entries(ast)
}

test "runtime_parse_alloc_record_fields" {
  let entries = parse_alloc_entries("type Pair { left: i64, right: i64 } fn main() -> i64 { 0 }")
  Test.assert_eq(type_entry_list_len(entries), 1)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 0, 0 - 1), 0)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 0, 0 - 1), 2)
}

test "runtime_parse_alloc_variant_fields" {
  let entries = parse_alloc_entries("type Maybe { Some(i64), None } fn main() -> i64 { 0 }")
  Test.assert_eq(type_entry_list_len(entries), 1)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 0, 0 - 1), 1)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 0, 0 - 1), 2)
}

test "runtime_parse_alloc_generic_record_type_params" {
  let entries = parse_alloc_entries("type Box<T> { value: T } fn main() -> i64 { 0 }")
  Test.assert_eq(type_entry_list_len(entries), 1)
  Test.assert_eq(type_entry_list_nth_kind_or(entries, 0, 0 - 1), 0)
  Test.assert_eq(type_entry_list_nth_item_count_or(entries, 0, 0 - 1), 1)
  Test.assert_eq(type_entry_list_nth_type_param_count_or(entries, 0, 0 - 1), 1)
}

test "runtime_parse_alloc_use_deduplicates_loaded_file" {
  let src = "use \"test/fixtures/runtime_parse_alloc_import.weft\" use \"test/fixtures/runtime_parse_alloc_import.weft\" fn main() -> i64 { imported() }"
  Test.assert_eq(parse_alloc_count(src), 2)
}

test "runtime_parse_alloc_missing_use_keeps_local_decls" {
  let src = "use \"test/fixtures/runtime_parse_alloc_missing.weft\" fn main() -> i64 { 0 }"
  Test.assert_eq(parse_alloc_count(src), 1)
}
