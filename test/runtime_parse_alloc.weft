test "runtime_parse_alloc_generic_call_pointer_type_arg" {
  let src = "fn id<T>(x: T) -> T { x } fn main(p: *mut i64) -> *mut i64 { id<*mut i64>(p) }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let pair = nlist_get(pipeline_ast_fns(ast), 1)
  let fn_wrap = node_f1(pair)
  let fn_inner = node_f1(fn_wrap)
  let body = node_f4(fn_inner)
  let type_args = node_f1(body)
  let arg_ty = nlist_get(type_args, 0)
  Test.assert_eq(node_tag(body), 36)
  Test.assert_eq(nlist_len(type_args), 1)
  Test.assert_eq(ty_tag(arg_ty), 15)
  Test.assert_eq(ty_ptr_mutable(arg_ty), 1)
  Test.assert_eq(ty_tag(ty_ptr_inner(arg_ty)), 2)
  Test.assert_eq(ty_f1(ty_ptr_inner(arg_ty)), PRIM_I64())
}

test "runtime_parse_alloc_pointer_assignment_node" {
  let src = "fn write(p: *mut i64) -> i64 { p.* = 7 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let pair = nlist_get(pipeline_ast_fns(ast), 0)
  let fn_wrap = node_f1(pair)
  let fn_inner = node_f1(fn_wrap)
  let body = node_f4(fn_inner)
  Test.assert_eq(node_tag(body), 57)
  Test.assert_eq(node_tag(node_f1(body)), 2)
  Test.assert_eq(node_tag(node_f2(body)), 1)
  Test.assert_eq(node_f1(node_f2(body)), 7)
}

test "runtime_parse_alloc_continuation_type_application" {
  let src = "fn take(k: Continuation<i64, bool>) -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let pair = nlist_get(pipeline_ast_fns(ast), 0)
  let fn_wrap = node_f1(pair)
  let fn_inner = node_f1(fn_wrap)
  let params = node_f3(fn_inner)
  let param = nlist_get(params, 0)
  let param_ty = node_f3(param)
  Test.assert_eq(nlist_len(params), 1)
  Test.assert_eq(ty_tag(param_ty), 14)
  Test.assert_eq(ty_tag(ty_f1(param_ty)), 2)
  Test.assert_eq(ty_f1(ty_f1(param_ty)), PRIM_I64())
  Test.assert_eq(ty_tag(ty_f2(param_ty)), 2)
  Test.assert_eq(ty_f1(ty_f2(param_ty)), PRIM_BOOL())
}

test "runtime_parse_alloc_use_deduplicates_loaded_file" {
  let src = "use \"test/fixtures/runtime_parse_alloc_import.weft\" use \"test/fixtures/runtime_parse_alloc_import.weft\" fn main() -> i64 { imported() }"
  Test.assert_eq(parse_alloc_count(src), 2)
}

test "runtime_parse_alloc_missing_use_keeps_local_decls" {
  let src = "use \"test/fixtures/runtime_parse_alloc_missing.weft\" fn main() -> i64 { 0 }"
  Test.assert_eq(parse_alloc_count(src), 1)
}
