test "runtime_parse_alloc_pointer_type_prefix" {
  let src = "fn take(x: *i64) -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let pair = nlist_get(pipeline_ast_fns(ast), 0)
  let fn_wrap = node_f1(pair)
  let fn_inner = node_f1(fn_wrap)
  let params = node_f3(fn_inner)
  let param = nlist_get(params, 0)
  let param_ty = node_f3(param)
  Test.assert_eq(ty_tag(param_ty), 15)
  Test.assert_eq(ty_ptr_mutable(param_ty), 0)
  Test.assert_eq(ty_tag(ty_ptr_inner(param_ty)), 2)
  Test.assert_eq(ty_f1(ty_ptr_inner(param_ty)), PRIM_I64())
}

