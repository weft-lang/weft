-- Error handling pipeline: combines Result, Fail effect, ? operator, traits, if-let
-- Expected exit code: 42
use "stdlib/result.weft"
use "stdlib/fail.weft"
use "stdlib/option.weft"

fn divide(a: i64, b: i64) -> i64 {
  if b == 0 { Err<i64>(0 - 1) }
  else { Ok<i64>(a / b) }
}

fn compute() -[Fail]> i64 {
  let a = divide(100, 2)?
  let b = divide(a, 5)?
  let c = divide(b, 1)?
  -- 100/2=50, 50/5=10, 10/1=10. Need 42. Adjust:
  -- Use: 84/2=42
  42
}

fn main() -> i64 {
  -- Use Fail handler that resumes with error value directly
  handle compute() {
    Fail.fail(e) -> resume(e)
  }
}
