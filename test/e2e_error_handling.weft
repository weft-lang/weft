-- Error handling pipeline: combines Result, Fail effect, ? operator
-- Expected exit code: 42
use "stdlib/result.weft"
use "stdlib/fail.weft"

fn divide(a: i64, b: i64) -> Result<i64, i64> {
  if b == 0 { Err<i64, i64>(0 - 1) }
  else { Ok<i64, i64>(a / b) }
}

fn compute() -[Fail<i64>]> i64 {
  let a = divide(100, 2)?
  let b = divide(a, 5)?
  let c = divide(b, 1)?
  -- 100/2=50, 50/5=10, 10/1=10 -> 10 + 32 = 42
  c + 32
}

fn main() -> i64 {
  handle compute() {
    Fail.fail(e) -> e
  }
}
