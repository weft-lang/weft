use "runtime/memory.weft"
-- Inherent impl: method on a record type
-- Expected exit code: 42
type Point {
  x: i64,
  y: i64
}

impl Point {
  fn sum(self: i64) -> i64 {
    let s = self
    let sx = mem_load64(s)
    let sy = mem_load64(s + 8)
    sx + sy
  }
}

fn main() -> i64 {
  let p = Point { x: 30, y: 12 }
  p.sum()
}
