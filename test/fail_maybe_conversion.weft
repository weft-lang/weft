-- 4j J4: abortive handlers convert effects into data without returning
-- their clause value to the perform site.

use stdlib/fail.{*}
use "stdlib/maybe.weft"

fn conversion_ok_i64() -[Fail<i64>]> i64 { 42 }
fn conversion_err_i64() -[Fail<i64>]> i64 { Fail.fail(7) }
fn conversion_ok_str() -[Fail<str>]> str { "weft" }
fn conversion_err_str() -[Fail<str>]> str { Fail.fail("broken") }

fn conversion_some_i64() -[Maybe]> i64 { 42 }
fn conversion_none_i64() -[Maybe]> i64 { Maybe.none() }
fn conversion_some_str() -[Maybe]> str { "weft" }
fn conversion_none_str() -[Maybe]> str { Maybe.none() }

test "try_result_i64_round_trips_ok_and_err" {
  let ok = try_result<i64, i64>(conversion_ok_i64)
  let err = try_result<i64, i64>(conversion_err_i64)
  match ok {
    Ok(value) -> Test.assert_eq(value, 42)
    Err(error) -> Test.assert_eq(error, 0 - 1)
  }
  match err {
    Ok(value) -> Test.assert_eq(value, 0 - 1)
    Err(error) -> Test.assert_eq(error, 7)
  }
}

test "try_result_str_round_trips_ok_and_err" {
  let ok = try_result<str, str>(conversion_ok_str)
  let err = try_result<str, str>(conversion_err_str)
  match ok {
    Ok(value) -> Test.assert_str_eq(value, "weft")
    Err(error) -> Test.assert_str_eq(error, "unexpected")
  }
  match err {
    Ok(value) -> Test.assert_str_eq(value, "unexpected")
    Err(error) -> Test.assert_str_eq(error, "broken")
  }
}

test "try_option_i64_round_trips_some_and_none" {
  let some = try_option<i64>(conversion_some_i64)
  let none = try_option<i64>(conversion_none_i64)
  match some {
    Some(value) -> Test.assert_eq(value, 42)
    None -> Test.assert_eq(0, 1)
  }
  match none {
    Some(value) -> Test.assert_eq(value, 0 - 1)
    None -> Test.assert_eq(1, 1)
  }
}

test "try_option_str_round_trips_some_and_none" {
  let some = try_option<str>(conversion_some_str)
  let none = try_option<str>(conversion_none_str)
  match some {
    Some(value) -> Test.assert_str_eq(value, "weft")
    None -> Test.assert_eq(0, 1)
  }
  match none {
    Some(value) -> Test.assert_str_eq(value, "unexpected")
    None -> Test.assert_eq(1, 1)
  }
}
