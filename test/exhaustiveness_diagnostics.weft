-- E1003: pattern-matrix counterexamples and coverage provenance.

use compiler/grammar.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use runtime/alloc.{*}
use runtime/memory.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type/render
use stdlib/string.{str_eq, str_find, str_find_from}

fn exhaustiveness_text_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> if str_eq(name, key) == 1 { value } else { exhaustiveness_text_field(rest, key, fallback) }
      _ -> exhaustiveness_text_field(rest, key, fallback)
    }
  }
}

fn exhaustiveness_i64_field(fields: DiagnosticFieldList, key: str, fallback: i64) -> i64 {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldI64(name, value) -> if str_eq(name, key) == 1 { value } else { exhaustiveness_i64_field(rest, key, fallback) }
      _ -> exhaustiveness_i64_field(rest, key, fallback)
    }
  }
}

fn exhaustiveness_type_field(fields: DiagnosticFieldList, key: str, fallback: str) -> str {
  match fields {
    DiagnosticFieldNil -> fallback
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldType(name, value) -> if str_eq(name, key) == 1 { value.render() } else { exhaustiveness_type_field(rest, key, fallback) }
      _ -> exhaustiveness_type_field(rest, key, fallback)
    }
  }
}

fn exhaustiveness_suggestion_matches(fields: DiagnosticFieldList, expected_pattern: str) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldSuggestion(DiagnosticSuggestion(message, DiagnosticSuggestionMaybeIncorrect, DiagnosticTextEditNil)) -> {
        if str_eq(message, pattern_matrix_non_exhaustive_suggestion(expected_pattern)) == 1 { 1 }
        else { exhaustiveness_suggestion_matches(rest, expected_pattern) }
      }
      _ -> exhaustiveness_suggestion_matches(rest, expected_pattern)
    }
  }
}

fn exhaustiveness_related_location_matches(
  related: DiagnosticRelatedLocationList,
  label: str,
  src: i64,
  start: i64,
  end: i64
) -> i64 {
  if start < 0 { 1 }
  else { match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(actual_label, DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), actual_start, actual_end)), rest) -> {
      if str_eq(actual_label, label) == 1 and actual_src == src and actual_start == start and actual_end == end { 1 }
      else { exhaustiveness_related_location_matches(rest, label, src, start, end) }
    }
    DiagnosticRelatedLocationCons(item, rest) -> exhaustiveness_related_location_matches(rest, label, src, start, end)
  } }
}

fn exhaustiveness_diagnostic_matches(
  diagnostic: Diagnostic,
  src: i64,
  witness: str,
  pattern: str,
  witness_kind: str,
  scrutinee_type: str,
  primary_start: i64,
  primary_end: i64,
  guarded_count: i64,
  guard_start: i64,
  guard_end: i64,
  type_start: i64,
  type_end: i64
) -> i64 {
  let fields = diagnostic.fields()
  let primary_ok = match diagnostic.primary() {
    DiagnosticSourceRange(DiagnosticSourceBuffer(actual_src), start, end) -> if actual_src == src and start == primary_start and end == primary_end { 1 } else { 0 }
    _ -> 0
  }
  let guard_ok = exhaustiveness_related_location_matches(
    diagnostic.related(),
    "a guarded arm does not prove coverage when its guard is false",
    src,
    guard_start,
    guard_end
  )
  let type_ok = exhaustiveness_related_location_matches(diagnostic.related(), "matched type declared here", src, type_start, type_end)
  let concrete = if str_eq(witness_kind, "concrete_value") == 1 { 1 } else { 0 }
  if str_eq(diagnostic.code().text(), "E1003") == 1 and
     str_eq(diagnostic.class().name(), "type") == 1 and
     str_eq(diagnostic.severity().name(), "error") == 1 and
     str_eq(diagnostic.message(), pattern_matrix_non_exhaustive_message(witness, concrete)) == 1 and
     str_eq(exhaustiveness_text_field(fields, "context", ""), "match") == 1 and
     str_eq(exhaustiveness_text_field(fields, "reason", ""), "uncovered_value") == 1 and
     str_eq(exhaustiveness_text_field(fields, "coverage_model", ""), "recursive_pattern_matrix") == 1 and
     str_eq(exhaustiveness_text_field(fields, "witness", ""), witness) == 1 and
     str_eq(exhaustiveness_text_field(fields, "witness_kind", ""), witness_kind) == 1 and
     str_eq(exhaustiveness_text_field(fields, "suggested_pattern", ""), pattern) == 1 and
     str_eq(exhaustiveness_type_field(fields, "scrutinee_type", ""), scrutinee_type) == 1 and
     exhaustiveness_i64_field(fields, "guarded_arm_count", 0 - 1) == guarded_count and
     exhaustiveness_suggestion_matches(fields, pattern) == 1 and
     primary_ok == 1 and guard_ok == 1 and type_ok == 1 { 1 } else { 0 }
}

fn exhaustiveness_check_source(
  source: str,
  witness: str,
  pattern: str,
  witness_kind: str,
  scrutinee_type: str,
  primary_start: i64,
  primary_end: i64,
  guarded_count: i64,
  guard_start: i64,
  guard_end: i64,
  type_start: i64,
  type_end: i64
) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = handle grammar.parse(src, __str_len(source), tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let observation = alloc_zeroed(24)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> {
      if str_eq(diagnostic.code().text(), "E1003") == 1 {
        mem_store64_at(observation, 0, mem_load64_at(observation, 0) + 1)
        mem_store64_at(observation, 8, exhaustiveness_diagnostic_matches(
          diagnostic, src, witness, pattern, witness_kind, scrutinee_type,
          primary_start, primary_end, guarded_count, guard_start, guard_end, type_start, type_end
        ))
      } else { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) }
      resume(0)
    }
    Diagnose.error(message, span) -> { mem_store64_at(observation, 16, mem_load64_at(observation, 16) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(observation, 0) == 1 and mem_load64_at(observation, 8) == 1 and mem_load64_at(observation, 16) == 0 { 1 } else { 0 }
}

fn exhaustiveness_source_is_clean(source: str) -> i64 {
  let src = __str_ptr(source)
  let tt = ttable_new()
  let grammar = weft_grammar()
  let fns = handle grammar.parse(src, __str_len(source), tt) {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, span) -> resume(0)
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  let errors = alloc_zeroed(8)
  handle grammar.check(fns, src, tt) {
    Diagnose.report(diagnostic) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.error(message, span) -> { mem_store64_at(errors, 0, mem_load64_at(errors, 0) + 1) resume(0) }
    Diagnose.warn(message, span) -> resume(0)
    Diagnose.note(message, span) -> resume(0)
  }
  if mem_load64_at(errors, 0) == 0 { 1 } else { 0 }
}

test "exhaustiveness_variant_names_a_constructible_counterexample" {
  let source = "type Choice { Left(i64), Right(i64) } fn bad(value: Choice) -> i64 { match value { Left(n) -> n } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let type_origin = str_find(source, "Choice")
  Test.assert_eq(exhaustiveness_check_source(source, "Right(0)", "Right(0)", "concrete_value", "Choice", primary, primary + 5, 0, 0 - 1, 0 - 1, type_origin, type_origin + 6), 1)
}

test "exhaustiveness_recursive_matrix_reconstructs_nested_constructor_holes" {
  let source = "type Inner { Left, Right } type Outer { Wrap(Inner), Stop } fn bad(value: Outer) -> i64 { match value { Wrap(Left) -> 1 Stop -> 0 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let type_origin = str_find(source, "Outer")
  Test.assert_eq(exhaustiveness_check_source(source, "Wrap(Right)", "Wrap(Right)", "concrete_value", "Outer", primary, primary + 5, 0, 0 - 1, 0 - 1, type_origin, type_origin + 5), 1)
}

test "exhaustiveness_recursive_type_prefers_a_finite_counterexample" {
  let source = "type RecursiveWitness { Recur(RecursiveWitness), End } fn bad(value: RecursiveWitness) -> i64 { match value { } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let type_origin = str_find(source, "RecursiveWitness")
  Test.assert_eq(exhaustiveness_check_source(source, "End", "End", "concrete_value", "RecursiveWitness", primary, primary + 5, 0, 0 - 1, 0 - 1, type_origin, type_origin + 16), 1)
}

test "exhaustiveness_recursive_type_follows_an_uncovered_recursive_edge" {
  let source = "type RecursiveWitness { Recur(RecursiveWitness), End } fn bad(value: RecursiveWitness) -> i64 { match value { End -> 0 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let type_origin = str_find(source, "RecursiveWitness")
  Test.assert_eq(exhaustiveness_check_source(source, "Recur(End)", "Recur(End)", "concrete_value", "RecursiveWitness", primary, primary + 5, 0, 0 - 1, 0 - 1, type_origin, type_origin + 16), 1)
}

test "exhaustiveness_recursive_type_total_coverage_terminates_cleanly" {
  let source = "type RecursiveWitness { Recur(RecursiveWitness), End } fn good(value: RecursiveWitness) -> i64 { match value { Recur(_) -> 1 End -> 0 } }"
  Test.assert_eq(exhaustiveness_source_is_clean(source), 1)
}

test "exhaustiveness_recursive_matrix_reconstructs_product_holes" {
  let source = "type Bit { Zero, One } fn bad(value: (Bit, Bit)) -> i64 { match value { (Zero, _) -> 0 (One, Zero) -> 1 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  Test.assert_eq(exhaustiveness_check_source(source, "(One, One)", "(One, One)", "concrete_value", "(Bit, Bit)", primary, primary + 5, 0, 0 - 1, 0 - 1, 0 - 1, 0 - 1), 1)
}

test "exhaustiveness_guard_provenance_teaches_the_false_path" {
  let source = "type Bit { Zero, One } fn bad(value: Bit, flag: bool) -> i64 { match value { Zero if flag -> 0 One -> 1 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let guard = str_find_from(source, "flag", str_find(source, "if"))
  let type_origin = str_find(source, "Bit")
  Test.assert_eq(exhaustiveness_check_source(source, "Zero", "Zero", "concrete_value", "Bit", primary, primary + 5, 1, guard, guard + 4, type_origin, type_origin + 3), 1)
}

test "exhaustiveness_opaque_projection_reports_a_representation_witness" {
  let source = "type UserId = opaque i64 fn bad(value: UserId) -> i64 { match value { UserId(0) -> 0 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  let type_origin = str_find(source, "UserId")
  Test.assert_eq(exhaustiveness_check_source(source, "UserId(1)", "UserId(1)", "concrete_value", "UserId", primary, primary + 5, 0, 0 - 1, 0 - 1, type_origin, type_origin + 6), 1)
}

test "exhaustiveness_nullable_residual_reports_nil_not_a_type_expression" {
  let source = "fn bad(value: str | nil) -> i64 { match value { text: str -> 1 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  Test.assert_eq(exhaustiveness_check_source(source, "nil", "nil", "concrete_value", "str | nil", primary, primary + 5, 0, 0 - 1, 0 - 1, 0 - 1, 0 - 1), 1)
}

test "exhaustiveness_infinite_scalar_uses_a_deterministic_missing_value" {
  let source = "fn bad(value: i64) -> i64 { match value { 0 -> 0 1 -> 1 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  Test.assert_eq(exhaustiveness_check_source(source, "2", "2", "concrete_value", "i64", primary, primary + 5, 0, 0 - 1, 0 - 1, 0 - 1, 0 - 1), 1)
}

test "exhaustiveness_unpatternable_string_value_suggests_a_valid_catch_all" {
  let source = "fn bad(value: str | nil) -> i64 { match value { nil -> 0 } }"
  let primary = str_find_from(source, "value", str_find(source, "match"))
  Test.assert_eq(exhaustiveness_check_source(source, "\"\"", "_", "concrete_value", "str | nil", primary, primary + 5, 0, 0 - 1, 0 - 1, 0 - 1, 0 - 1), 1)
}

test "exhaustiveness_guarded_typed_arm_does_not_hide_later_total_coverage" {
  let source = "fn main(value: str | nil) -> i64 { match value { text: str if __str_len(text) > 3 -> 1 text: str -> 2 nil -> 3 } }"
  Test.assert_eq(exhaustiveness_source_is_clean(source), 1)
}
