use stdlib/bytes as bytes
use stdlib/display.{Display}
use stdlib/http.{Http11, HttpGet, HttpHead, HttpHeaders, HttpPost, HttpPut, HttpResponseHead, http_default_limits, http_field_name_parse, http_header, http_headers_append, http_headers_empty, http_response_head_new, http_status}
use stdlib/http/client.{HttpPoolCapacityTooLarge, HttpPoolNegativeCapacity, HttpRedirectAnyOrigin, HttpRedirectBrowserMethod, HttpRedirectCrossOrigin, HttpRedirectFailed, HttpRedirectFollowGet, HttpRedirectFollowReplay, HttpRedirectInvalidLimit, HttpRedirectLimitExceeded, HttpRedirectLocationUrl, HttpRedirectLocationUtf8, HttpRedirectLoop, HttpRedirectMultipleLocations, HttpRedirectSameOrigin, HttpRedirectStop, HttpRedirectStrictMethod, http_connection_pool, http_pool_max_idle, http_redirect_history, http_redirect_history_len, http_redirect_policy, http_redirect_step}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url
use stdlib/url.{Url, UrlOrigin}

fn http_client_policy_headers(location: str) -> HttpHeaders {
  http_headers_append(
    http_headers_empty(),
    http_header(http_field_name_parse("Location").unwrap(), bytes.from_str(location)).unwrap()
  )
}

fn http_client_policy_response(code: i64, headers: HttpHeaders) -> HttpResponseHead {
  http_response_head_new(
    HttpGet,
    Http11,
    http_status(code).unwrap(),
    bytes.from_str("policy"),
    headers,
    http_default_limits()
  ).unwrap()
}

test "URL origins ignore resources and normalize default ports" {
  let left = url.parse("https://EXAMPLE.com/a?x=1#old").unwrap().origin()
  let right = url.parse("https://example.com:443/other").unwrap().origin()
  let port = url.parse("https://example.com:444/a").unwrap().origin()
  Test.assert_true(left.eq(right))
  Test.assert_false(left.eq(port))
  Test.assert_str_eq(left.display(), "https://example.com:443")
}

test "redirect policy distinguishes ordinary responses and relative targets" {
  let current = url.parse("https://example.com/a/start?old=1").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  let history = http_redirect_history(current)
  match http_redirect_step(
    history,
    current,
    HttpGet,
    http_client_policy_response(200, http_headers_empty()),
    policy
  ) {
    HttpRedirectStop(returned) -> Test.assert_eq(http_redirect_history_len(returned), 1)
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(
    history,
    current,
    HttpGet,
    http_client_policy_response(301, http_client_policy_headers("../next?q=2")),
    policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) -> {
      Test.assert_eq(http_redirect_history_len(returned), 2)
      Test.assert_str_eq(target.display(), "https://example.com/next?q=2")
    }
    _ -> Test.assert_true(false)
  }
  -- History is persistent: evaluating a branch never mutates its predecessor.
  Test.assert_eq(http_redirect_history_len(history), 1)
}

test "redirect targets inherit or explicitly replace fragments" {
  let current = url.parse("https://example.com/start#client-state").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/next")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) ->
      Test.assert_str_eq(target.display(), "https://example.com/next#client-state")
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/next#")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) ->
      Test.assert_str_eq(target.display(), "https://example.com/next#")
    _ -> Test.assert_true(false)
  }
}

test "redirect loop identity excludes client-only fragments" {
  let current = url.parse("https://example.com/start#one").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/start#two")), policy
  ) {
    HttpRedirectFailed(HttpRedirectLoop(target)) ->
      Test.assert_str_eq(target.display(), "https://example.com/start#two")
    _ -> Test.assert_true(false)
  }
}

test "303 rewrites ordinary methods to GET but preserves HEAD" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(303, http_client_policy_headers("/done"))
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(http_redirect_history(current), current, HttpPut, response, policy) {
    HttpRedirectFollowGet(returned, target) -> Test.assert_str_eq(target.display(), "https://example.com/done")
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(http_redirect_history(current), current, HttpHead, response, policy) {
    HttpRedirectFollowReplay(returned, target, HttpHead) -> Test.assert_eq(http_redirect_history_len(returned), 2)
    _ -> Test.assert_true(false)
  }
}

test "301 and 302 browser compatibility rewrites only POST" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(302, http_client_policy_headers("/done"))
  let browser = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectBrowserMethod).unwrap()
  let strict = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(http_redirect_history(current), current, HttpPost, response, browser) {
    HttpRedirectFollowGet(returned, target) -> Test.assert_eq(http_redirect_history_len(returned), 2)
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(http_redirect_history(current), current, HttpPost, response, strict) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_eq(http_redirect_history_len(returned), 2)
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(http_redirect_history(current), current, HttpPut, response, browser) {
    HttpRedirectFollowReplay(returned, target, HttpPut) -> Test.assert_eq(http_redirect_history_len(returned), 2)
    _ -> Test.assert_true(false)
  }
}

test "307 and 308 always require explicit request replay" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectBrowserMethod).unwrap()
  match http_redirect_step(
    http_redirect_history(current), current, HttpPost,
    http_client_policy_response(307, http_client_policy_headers("/temporary")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_str_eq(target.display(), "https://example.com/temporary")
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(
    http_redirect_history(current), current, HttpPost,
    http_client_policy_response(308, http_client_policy_headers("/permanent")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_str_eq(target.display(), "https://example.com/permanent")
    _ -> Test.assert_true(false)
  }
}

test "redirect history rejects loops and exact hop-limit overflow" {
  let first = url.parse("https://example.com/a").unwrap()
  let second = url.parse("https://example.com/b").unwrap()
  let one_hop = http_redirect_policy(1, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  let next = match http_redirect_step(
    http_redirect_history(first), first, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/b")), one_hop
  ) {
    HttpRedirectFollowReplay(history, target, method) -> history
    _ -> http_redirect_history(first)
  }
  match http_redirect_step(
    next, second, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/c")), one_hop
  ) {
    HttpRedirectFailed(HttpRedirectLimitExceeded(limit)) -> Test.assert_eq(limit, 1)
    _ -> Test.assert_true(false)
  }
  let loops = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(
    next, second, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/a")), loops
  ) {
    HttpRedirectFailed(HttpRedirectLoop(target)) -> Test.assert_str_eq(target.display(), "https://example.com/a")
    _ -> Test.assert_true(false)
  }
}

test "redirect origin policy rejects or explicitly admits authority changes" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(301, http_client_policy_headers("https://other.example/next"))
  let same = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(http_redirect_history(current), current, HttpGet, response, same) {
    HttpRedirectFailed(HttpRedirectCrossOrigin(from, to)) -> {
      Test.assert_str_eq(from.display(), "https://example.com:443")
      Test.assert_str_eq(to.display(), "https://other.example:443")
    }
    _ -> Test.assert_true(false)
  }
  let any = http_redirect_policy(5, HttpRedirectAnyOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(http_redirect_history(current), current, HttpGet, response, any) {
    HttpRedirectFollowReplay(returned, target, HttpGet) -> Test.assert_str_eq(target.display(), "https://other.example/next")
    _ -> Test.assert_true(false)
  }
}

test "redirect locations reject ambiguity and invalid UTF-8" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  let duplicate = http_headers_append(
    http_client_policy_headers("/one"),
    http_header(http_field_name_parse("location").unwrap(), bytes.from_str("/two")).unwrap()
  )
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, duplicate), policy
  ) {
    HttpRedirectFailed(HttpRedirectMultipleLocations(count)) -> Test.assert_eq(count, 2)
    _ -> Test.assert_true(false)
  }
  let invalid_bytes: [u8; 1] = [__i64_to_u8(255)]
  let invalid = http_headers_append(
    http_headers_empty(),
    http_header(http_field_name_parse("Location").unwrap(), bytes.from_slice(invalid_bytes[..])).unwrap()
  )
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, invalid), policy
  ) {
    HttpRedirectFailed(HttpRedirectLocationUtf8(offset)) -> Test.assert_eq(offset, 0)
    _ -> Test.assert_true(false)
  }
}

test "redirect responses without a location stop and malformed targets fail" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod).unwrap()
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_headers_empty()), policy
  ) {
    HttpRedirectStop(returned) -> Test.assert_eq(http_redirect_history_len(returned), 1)
    _ -> Test.assert_true(false)
  }
  match http_redirect_step(
    http_redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("https://[/bad")), policy
  ) {
    HttpRedirectFailed(HttpRedirectLocationUrl(error)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "redirect and pool configuration bounds are typed" {
  match http_redirect_policy(0 - 1, HttpRedirectSameOrigin, HttpRedirectStrictMethod) {
    Err(HttpRedirectInvalidLimit(limit)) -> Test.assert_eq(limit, 0 - 1)
    _ -> Test.assert_true(false)
  }
  match http_connection_pool<i64>(0 - 1) {
    Err(HttpPoolNegativeCapacity(capacity)) -> Test.assert_eq(capacity, 0 - 1)
    _ -> Test.assert_true(false)
  }
  match http_connection_pool<i64>(http_pool_max_idle() + 1) {
    Err(HttpPoolCapacityTooLarge(requested, maximum)) -> {
      Test.assert_eq(requested, maximum + 1)
      Test.assert_eq(maximum, 4)
    }
    _ -> Test.assert_true(false)
  }
}
