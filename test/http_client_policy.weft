use stdlib/bytes as bytes
use stdlib/display.{Display}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpHead, HttpHeaders, HttpPost, HttpPut, HttpResponseHead}
use stdlib/http/client as http_client
use stdlib/http/client.{HttpPoolCapacityTooLarge, HttpRedirectAnyOrigin, HttpRedirectBrowserMethod, HttpRedirectCrossOrigin, HttpRedirectFailed, HttpRedirectFollowGet, HttpRedirectFollowReplay, HttpRedirectLimitExceeded, HttpRedirectLocationUrl, HttpRedirectLocationUtf8, HttpRedirectLoop, HttpRedirectMultipleLocations, HttpRedirectSameOrigin, HttpRedirectStop, HttpRedirectStrictMethod}
use stdlib/result.{Err, Ok, Result}
use stdlib/url as url
use stdlib/url.{Url, UrlOrigin}

fn http_client_policy_headers(location: str) -> HttpHeaders {
  http.headers().append(
    http.header(http.parse_field_name("Location").unwrap(), bytes.from_str(location)).unwrap()
  )
}

fn http_client_policy_response(code: i64, headers: HttpHeaders) -> HttpResponseHead {
  http.response(
    HttpGet,
    Http11,
    http.status(code).unwrap(),
    bytes.from_str("policy"),
    headers,
    http.default_limits()
  ).unwrap()
}

test "URL origins ignore resources and normalize default ports" {
  let left = url.parse("https://EXAMPLE.com/a?x=1#old").unwrap().origin()
  let right = url.parse("https://example.com:443/other").unwrap().origin()
  let port = url.parse("https://example.com:444/a").unwrap().origin()
  Test.assert_true(left.eq(right))
  Test.assert_false(left.eq(port))
  Test.assert_str_eq(left.display(), "https://example.com:443")
}

test "redirect policy distinguishes ordinary responses and relative targets" {
  let current = url.parse("https://example.com/a/start?old=1").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  let history = http_client.redirect_history(current)
  match http_client.step(
    history,
    current,
    HttpGet,
    http_client_policy_response(200, http.headers()),
    policy
  ) {
    HttpRedirectStop(returned) -> Test.assert_true(returned.len() == 1)
    _ -> Test.assert_true(false)
  }
  match http_client.step(
    history,
    current,
    HttpGet,
    http_client_policy_response(301, http_client_policy_headers("../next?q=2")),
    policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) -> {
      Test.assert_true(returned.len() == 2)
      Test.assert_str_eq(target.display(), "https://example.com/next?q=2")
    }
    _ -> Test.assert_true(false)
  }
  -- History is persistent: evaluating a branch never mutates its predecessor.
  Test.assert_true(history.len() == 1)
}

test "redirect targets inherit or explicitly replace fragments" {
  let current = url.parse("https://example.com/start#client-state").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/next")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) ->
      Test.assert_str_eq(target.display(), "https://example.com/next#client-state")
    _ -> Test.assert_true(false)
  }
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/next#")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpGet) ->
      Test.assert_str_eq(target.display(), "https://example.com/next#")
    _ -> Test.assert_true(false)
  }
}

test "redirect loop identity excludes client-only fragments" {
  let current = url.parse("https://example.com/start#one").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/start#two")), policy
  ) {
    HttpRedirectFailed(HttpRedirectLoop(target)) ->
      Test.assert_str_eq(target.display(), "https://example.com/start#two")
    _ -> Test.assert_true(false)
  }
}

test "303 rewrites ordinary methods to GET but preserves HEAD" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(303, http_client_policy_headers("/done"))
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(http_client.redirect_history(current), current, HttpPut, response, policy) {
    HttpRedirectFollowGet(returned, target) -> Test.assert_str_eq(target.display(), "https://example.com/done")
    _ -> Test.assert_true(false)
  }
  match http_client.step(http_client.redirect_history(current), current, HttpHead, response, policy) {
    HttpRedirectFollowReplay(returned, target, HttpHead) -> Test.assert_true(returned.len() == 2)
    _ -> Test.assert_true(false)
  }
}

test "301 and 302 browser compatibility rewrites only POST" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(302, http_client_policy_headers("/done"))
  let browser = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectBrowserMethod)
  let strict = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(http_client.redirect_history(current), current, HttpPost, response, browser) {
    HttpRedirectFollowGet(returned, target) -> Test.assert_true(returned.len() == 2)
    _ -> Test.assert_true(false)
  }
  match http_client.step(http_client.redirect_history(current), current, HttpPost, response, strict) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_true(returned.len() == 2)
    _ -> Test.assert_true(false)
  }
  match http_client.step(http_client.redirect_history(current), current, HttpPut, response, browser) {
    HttpRedirectFollowReplay(returned, target, HttpPut) -> Test.assert_true(returned.len() == 2)
    _ -> Test.assert_true(false)
  }
}

test "307 and 308 always require explicit request replay" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectBrowserMethod)
  match http_client.step(
    http_client.redirect_history(current), current, HttpPost,
    http_client_policy_response(307, http_client_policy_headers("/temporary")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_str_eq(target.display(), "https://example.com/temporary")
    _ -> Test.assert_true(false)
  }
  match http_client.step(
    http_client.redirect_history(current), current, HttpPost,
    http_client_policy_response(308, http_client_policy_headers("/permanent")), policy
  ) {
    HttpRedirectFollowReplay(returned, target, HttpPost) -> Test.assert_str_eq(target.display(), "https://example.com/permanent")
    _ -> Test.assert_true(false)
  }
}

test "redirect history rejects loops and exact hop-limit overflow" {
  let first = url.parse("https://example.com/a").unwrap()
  let second = url.parse("https://example.com/b").unwrap()
  let one_hop = http_client.redirect_policy(1, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  let next = match http_client.step(
    http_client.redirect_history(first), first, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/b")), one_hop
  ) {
    HttpRedirectFollowReplay(history, target, method) -> history
    _ -> http_client.redirect_history(first)
  }
  match http_client.step(
    next, second, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/c")), one_hop
  ) {
    HttpRedirectFailed(HttpRedirectLimitExceeded(limit)) -> Test.assert_true(limit == 1)
    _ -> Test.assert_true(false)
  }
  let loops = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(
    next, second, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("/a")), loops
  ) {
    HttpRedirectFailed(HttpRedirectLoop(target)) -> Test.assert_str_eq(target.display(), "https://example.com/a")
    _ -> Test.assert_true(false)
  }
}

test "redirect origin policy rejects or explicitly admits authority changes" {
  let current = url.parse("https://example.com/start").unwrap()
  let response = http_client_policy_response(301, http_client_policy_headers("https://other.example/next"))
  let same = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(http_client.redirect_history(current), current, HttpGet, response, same) {
    HttpRedirectFailed(HttpRedirectCrossOrigin(from, to)) -> {
      Test.assert_str_eq(from.display(), "https://example.com:443")
      Test.assert_str_eq(to.display(), "https://other.example:443")
    }
    _ -> Test.assert_true(false)
  }
  let any = http_client.redirect_policy(5, HttpRedirectAnyOrigin, HttpRedirectStrictMethod)
  match http_client.step(http_client.redirect_history(current), current, HttpGet, response, any) {
    HttpRedirectFollowReplay(returned, target, HttpGet) -> Test.assert_str_eq(target.display(), "https://other.example/next")
    _ -> Test.assert_true(false)
  }
}

test "redirect locations reject ambiguity and invalid UTF-8" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  let duplicate = http_client_policy_headers("/one").append(
    http.header(http.parse_field_name("location").unwrap(), bytes.from_str("/two")).unwrap()
  )
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, duplicate), policy
  ) {
    HttpRedirectFailed(HttpRedirectMultipleLocations(count)) -> Test.assert_true(count == 2)
    _ -> Test.assert_true(false)
  }
  let invalid_bytes: [u8; 1] = [__i64_to_u8(255)]
  let invalid = http.headers().append(
    http.header(http.parse_field_name("Location").unwrap(), bytes.from_slice(invalid_bytes[..])).unwrap()
  )
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, invalid), policy
  ) {
    HttpRedirectFailed(HttpRedirectLocationUtf8(offset)) -> Test.assert_true(offset == 0)
    _ -> Test.assert_true(false)
  }
}

test "redirect responses without a location stop and malformed targets fail" {
  let current = url.parse("https://example.com/start").unwrap()
  let policy = http_client.redirect_policy(5, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http.headers()), policy
  ) {
    HttpRedirectStop(returned) -> Test.assert_true(returned.len() == 1)
    _ -> Test.assert_true(false)
  }
  match http_client.step(
    http_client.redirect_history(current), current, HttpGet,
    http_client_policy_response(301, http_client_policy_headers("https://[/bad")), policy
  ) {
    HttpRedirectFailed(HttpRedirectLocationUrl(error)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "finite pool capacities preserve oversized requests" {
  match http_client.pool<i64>(http_client.max_idle() + 1) {
    Err(HttpPoolCapacityTooLarge(requested, maximum)) -> {
      Test.assert_true(requested == maximum + 1)
      Test.assert_true(maximum == 4)
    }
    _ -> Test.assert_true(false)
  }
  let maximum: usize = 18446744073709551615
  match http_client.pool<i64>(maximum) {
    Err(HttpPoolCapacityTooLarge(requested, supported)) -> {
      Test.assert_true(requested == maximum)
      Test.assert_true(supported == http_client.max_idle())
    }
    _ -> Test.assert_true(false)
  }
}

test "redirect construction is total across zero and full-width hop budgets" {
  let current = url.parse("https://example.com/start").unwrap()
  let history = http_client.redirect_history(current)
  let response = http_client_policy_response(301, http_client_policy_headers("/next"))
  let zero = http_client.redirect_policy(0, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(history, current, HttpGet, response, zero) {
    HttpRedirectFailed(HttpRedirectLimitExceeded(0)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  let maximum: usize = 18446744073709551615
  let full = http_client.redirect_policy(maximum, HttpRedirectSameOrigin, HttpRedirectStrictMethod)
  match http_client.step(history, current, HttpGet, response, full) {
    HttpRedirectFollowReplay(next, target, HttpGet) -> {
      Test.assert_eq_usize(next.len(), 2)
      Test.assert_str_eq(target.display(), "https://example.com/next")
    }
    _ -> Test.assert_true(false)
  }
}
