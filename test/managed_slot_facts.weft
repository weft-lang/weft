use compiler/pipeline.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use runtime/effects.{continuation_cleanup_kind_rc}

fn managed_slot_blocks(insts: IrInstList) -> IrBlockList {
  IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(0)), IrBlockListNil)
}

fn managed_slot_prefix(tail: IrInstList) -> IrInstList {
  IrInstCons(IrCallI64(0, pipeline_ir_abort_cleanup_rc_alloc_hash(), IrValueNil),
    IrInstCons(IrSlotI64(100),
    IrInstCons(IrStoreI64(100, 0),
    IrInstCons(IrManagedSlotI64(0 - 1, 0, 100, continuation_cleanup_kind_rc(), IrManagedSlotAcquire), tail))))
}

test "a mutable observation aliases its binding instead of acquiring a stake" {
  let kind = continuation_cleanup_kind_rc()
  let insts = managed_slot_prefix(
    IrInstCons(IrLoadI64(2, 100),
    IrInstCons(IrManagedSlotI64(0 - 1, 2, 100, kind, IrManagedSlotObserve),
    IrInstCons(IrManagedSlotI64(3, 2, 100, kind, IrManagedSlotRelease), IrInstNil))))
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(managed_slot_blocks(insts), 0, 0)
  let owner = pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts,
    pipeline_ir_abort_cleanup_structural_slot_site(100), pipeline_ir_abort_cleanup_direct_kind())
  let observed = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 2)
  Test.assert_true(owner != 0)
  Test.assert_true(observed != 0)
  Test.assert_eq(pipeline_ir_abort_cleanup_fact_record_index(owner), pipeline_ir_abort_cleanup_fact_record_index(observed))
  Test.assert_eq(pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 2, pipeline_ir_abort_cleanup_direct_kind()), 0)
  Test.assert_eq(nlist_len(facts), 3)
}

test "retaining a borrowed slot observation still acquires an independent stake" {
  let kind = continuation_cleanup_kind_rc()
  let insts = managed_slot_prefix(
    IrInstCons(IrLoadI64(2, 100),
    IrInstCons(IrManagedSlotI64(0 - 1, 2, 100, kind, IrManagedSlotObserve),
    IrInstCons(IrManagedStakeI64(3, 2, kind, 1, ir_managed_stake_origin_binding()),
    IrInstCons(IrManagedStakeI64(4, 2, kind, 0 - 1, ir_managed_stake_origin_cleanup()),
    IrInstCons(IrManagedSlotI64(5, 2, 100, kind, IrManagedSlotRelease), IrInstNil))))))
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(managed_slot_blocks(insts), 0, 0)
  let retained = pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 3, pipeline_ir_abort_cleanup_direct_kind())
  let borrowed = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 2)
  Test.assert_true(retained != 0)
  Test.assert_eq(node_f1(retained), 2)
  Test.assert_true(pipeline_ir_abort_cleanup_fact_record_index(retained) != pipeline_ir_abort_cleanup_fact_record_index(borrowed))
  Test.assert_eq(pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 2, pipeline_ir_abort_cleanup_direct_kind()), 0)
}

test "replacement keeps one binding record and a distinct new producer" {
  let kind = continuation_cleanup_kind_rc()
  let insts = managed_slot_prefix(
    IrInstCons(IrLoadI64(2, 100),
    IrInstCons(IrCallI64(3, pipeline_ir_abort_cleanup_rc_alloc_hash(), IrValueNil),
    IrInstCons(IrStoreI64(100, 3),
    IrInstCons(IrManagedSlotI64(4, 3, 100, kind, IrManagedSlotReplace(2)),
    IrInstCons(IrLoadI64(5, 100),
    IrInstCons(IrManagedSlotI64(6, 5, 100, kind, IrManagedSlotRelease), IrInstNil)))))))
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(managed_slot_blocks(insts), 0, 0)
  let before = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 2)
  let after = pipeline_ir_abort_cleanup_find_slot_alias_value(facts, 5)
  let producer = pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 3, pipeline_ir_abort_cleanup_direct_kind())
  Test.assert_true(before != 0)
  Test.assert_true(after != 0)
  Test.assert_true(producer != 0)
  Test.assert_eq(pipeline_ir_abort_cleanup_fact_record_index(before), pipeline_ir_abort_cleanup_fact_record_index(after))
  Test.assert_true(pipeline_ir_abort_cleanup_fact_record_index(producer) != pipeline_ir_abort_cleanup_fact_record_index(after))
  Test.assert_eq(pipeline_ir_abort_cleanup_find_acquisition_site_kind(facts, 2, pipeline_ir_abort_cleanup_direct_kind()), 0)
}

test "managed slot transitions expose their SSA operands and native call boundary" {
  let kind = continuation_cleanup_kind_rc()
  let replacement = IrManagedSlotI64(4, 3, 100, kind, IrManagedSlotReplace(2))
  let live = pipeline_ir_live_set_add_inst_uses(replacement, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_contains(live, 2), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(live, 3), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(live, 100), 1)
  Test.assert_eq(pipeline_ir_inst_def_or(replacement, 0 - 1), 4)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(replacement), 0)
  Test.assert_true(pipeline_ir_intervals_inst_is_call(replacement))
  Test.assert_eq(pipeline_ir_native_resident_inst_cs_use_safe(replacement), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_simple(replacement, 0), 0)
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_cs_simple(replacement, 0), 1)
  let observation = IrManagedSlotI64(0 - 1, 2, 100, kind, IrManagedSlotObserve)
  Test.assert_eq(pipeline_ir_inst_def_or(observation, 0 - 1), 0 - 1)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(observation), 1)
  Test.assert_true(not pipeline_ir_intervals_inst_is_call(observation))
  Test.assert_eq(pipeline_ir_native_resident_inst_simple(observation, 0), 1)
  let acquisition = IrManagedSlotI64(0 - 1, 2, 100, kind, IrManagedSlotAcquire)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(acquisition), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_simple(acquisition, 0), 0)
  Test.assert_eq(pipeline_ir_native_resident_inst_cs_use_safe(acquisition), 1)
  Test.assert_eq(pipeline_ir_native_resident_inst_fp_simple(acquisition, 0), 1)
}

test "value rewriting preserves mutable storage identity" {
  let aliases = pipeline_ir_alias_env_empty()
    |> pipeline_ir_alias_env_bind(2, 20)
    |> pipeline_ir_alias_env_bind(3, 30)
    |> pipeline_ir_alias_env_bind(100, 999)
  let original = IrManagedSlotI64(4, 3, 100, continuation_cleanup_kind_rc(), IrManagedSlotReplace(2))
  match pipeline_ir_rewrite_inst_uses(original, aliases) {
    IrManagedSlotI64(dst, value, slot, kind, IrManagedSlotReplace(previous)) -> {
      Test.assert_eq(dst, 4)
      Test.assert_eq(value, 30)
      Test.assert_eq(previous, 20)
      Test.assert_eq(slot, 100)
    }
    _ -> Test.assert_true(false)
  }
}

test "scalar assignment does not reserve managed cleanup temporaries" {
  Test.assert_eq(pipeline_ir_slot_assignment_next_value(0, 0, 42), 42)
}
