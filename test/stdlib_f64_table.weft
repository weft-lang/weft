use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

fn f64_table_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn f64_table_test_value(table: F64Table, row: i64, column: i64) -> f64 {
  table.get(row, column).unwrap()
}

test "f64_table_filled_shape_and_mutation" {
  let table = f64_table.filled(2, 3, 1.5).unwrap()
  Test.assert_eq(table.rows(), 2)
  Test.assert_eq(table.columns(), 3)
  Test.assert_false(table.is_empty())
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 0, 0), 1.5), 1)
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 1, 2), 1.5), 1)
  Test.assert_true(table.set(1, 1, 9.5))
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 1, 1), 9.5), 1)
}

test "f64_table_zero_rows_preserve_rectangular_shape" {
  let table = f64_table.zeros(0, 4).unwrap()
  Test.assert_eq(table.rows(), 0)
  Test.assert_eq(table.columns(), 4)
  Test.assert_true(table.is_empty())
  Test.assert_true(table.get(0, 0).is_none())
  Test.assert_false(table.set(0, 0, 1.0))
}

test "f64_table_invalid_shapes_are_explicit" {
  Test.assert_true(f64_table.zeros(1, 0).is_none())
  Test.assert_true(f64_table.zeros(1, 0 - 1).is_none())
  Test.assert_true(f64_table.zeros(0 - 1, 1).is_none())
  Test.assert_true(f64_table.zeros(9223372036854775807, 2).is_none())
}

test "f64_table_lookup_and_mutation_reject_each_invalid_coordinate" {
  let table = f64_table.zeros(1, 2).unwrap()
  Test.assert_true(table.get(0 - 1, 0).is_none())
  Test.assert_true(table.get(1, 0).is_none())
  Test.assert_true(table.get(0, 0 - 1).is_none())
  Test.assert_true(table.get(0, 2).is_none())
  Test.assert_false(table.set(0 - 1, 0, 1.0))
  Test.assert_false(table.set(1, 0, 1.0))
  Test.assert_false(table.set(0, 0 - 1, 1.0))
  Test.assert_false(table.set(0, 2, 1.0))
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 0, 0), 0.0), 1)
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 0, 1), 0.0), 1)
}

test "f64_table_loop_e2e" {
  let table = f64_table.zeros(2, 3).unwrap()
  table.set(0, 0, 1.0)
  table.set(0, 1, 10.0)
  table.set(0, 2, 100.0)
  table.set(1, 0, 2.0)
  table.set(1, 1, 20.0)
  table.set(1, 2, 200.0)
  for row in 0..table.rows() {
    table.set(row, 1, f64_table_test_value(table, row, 0) + f64_table_test_value(table, row, 1))
  }
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 0, 1), 11.0), 1)
  Test.assert_eq(f64_table_same(f64_table_test_value(table, 1, 1), 22.0), 1)
}
