use stdlib/f64_table.{*}
use "stdlib/vector.weft"

fn f64_table_same(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

test "f64_table_happy_paths_get_set_and_row_count" {
  let table = f64_table_new(3, 2)
  vector_push<f64>(table, 1.0)
  vector_push<f64>(table, 2.0)
  vector_push<f64>(table, 3.0)
  vector_push<f64>(table, 4.0)
  vector_push<f64>(table, 5.0)
  vector_push<f64>(table, 6.0)
  Test.assert_eq(f64_table_row_count(table, 3), 2)
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 3, 0, 0.0), 1.0), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 1, 3, 2, 0.0), 6.0), 1)
  Test.assert_eq(f64_table_set(table, 1, 3, 1, 9.5), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 1, 3, 1, 0.0), 9.5), 1)
}

test "f64_table_empty_and_invalid_shape_sad_paths" {
  let empty_width = f64_table_new(0, 3)
  let empty_rows = f64_table_new(3, 0 - 1)
  Test.assert_eq(vector_len<f64>(empty_width), 0)
  Test.assert_eq(vector_len<f64>(empty_rows), 0)
  Test.assert_eq(f64_table_row_count(empty_width, 0), 0)
  Test.assert_eq(f64_table_same(f64_table_get(empty_width, 0, 0, 0, 7.0), 7.0), 1)
  Test.assert_eq(f64_table_set(empty_width, 0, 0, 0, 1.0), 0)
}

test "f64_table_field_and_bounds_sad_paths" {
  let table = f64_table_new(2, 1)
  vector_push<f64>(table, 2.0)
  vector_push<f64>(table, 4.0)
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 2, 0 - 1, 8.0), 8.0), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 2, 2, 9.0), 9.0), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 1, 2, 0, 10.0), 10.0), 1)
  Test.assert_eq(f64_table_set(table, 0, 2, 0 - 1, 1.0), 0)
  Test.assert_eq(f64_table_set(table, 0, 2, 2, 1.0), 0)
  Test.assert_eq(f64_table_set(table, 1, 2, 0, 1.0), 0)
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 2, 0, 0.0), 2.0), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 2, 1, 0.0), 4.0), 1)
}

test "f64_table_loop_e2e" {
  let table = f64_table_new(3, 2)
  vector_push<f64>(table, 1.0)
  vector_push<f64>(table, 10.0)
  vector_push<f64>(table, 100.0)
  vector_push<f64>(table, 2.0)
  vector_push<f64>(table, 20.0)
  vector_push<f64>(table, 200.0)
  let rows = f64_table_row_count(table, 3)
  for row in 0..rows {
    f64_table_set(table, row, 3, 1, f64_table_get(table, row, 3, 0, 0.0) + f64_table_get(table, row, 3, 1, 0.0))
  }
  Test.assert_eq(f64_table_same(f64_table_get(table, 0, 3, 1, 0.0), 11.0), 1)
  Test.assert_eq(f64_table_same(f64_table_get(table, 1, 3, 1, 0.0), 22.0), 1)
}
