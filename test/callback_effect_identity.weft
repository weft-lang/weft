use module_fixtures/effect_identity.{Compare, compare}
use module_fixtures/effect_identity as comparisons

fn run_compare<R, E>(body: () -[Compare<str>, E]> R) -[E]> R {
  handle body() {
    Compare<str>.same(left, right) -> resume(left == right)
  }
}

fn local_compare<T>(left: T, right: T) -[Compare<T>]> bool {
  Compare<T>.same(left, right)
}

test "explicit generic calls preserve fixed callback effect arguments" {
  run_compare(() => {
    Test.assert_true(local_compare<str>("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "inferred generic calls publish instantiated callback effects" {
  run_compare(() => {
    Test.assert_true(local_compare("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "selectively imported generic calls retain declaring effect identity" {
  run_compare(() => {
    Test.assert_true(compare<str>("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "qualified generic calls retain fixed and residual callback effects" {
  run_compare(() => {
    Test.assert_true(comparisons.compare<str>("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "inferred qualified calls publish their resolved effect arguments" {
  run_compare(() => {
    Test.assert_true(comparisons.compare("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "other instantiations remain residual effects of the same head" {
  let result = handle run_compare(() => {
    Test.assert_true(local_compare<str>("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    if local_compare<i64>(21, 21) { 42 } else { 0 }
  }) {
    Compare<i64>.same(left, right) -> resume(left == right)
  }
  Test.assert_eq(result, 42)
}

type Label { text: str }
impl Label {
  fn reflexive<T>(self, value: T) -[Compare<T>]> bool { Compare<T>.same(value, value) }
}

test "generic method resolution precedes callback effect collection" {
  let label = Label { text: "method" }
  run_compare(() => {
    Test.assert_true(label.reflexive<str>("left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}

test "generic function references acquire effects only when called" {
  let unused: (i64, i64) -[Compare<i64>]> bool = local_compare
  run_compare(() => {
    let compare_text: (str, str) -[Compare<str>]> bool = local_compare
    Test.assert_true(compare_text("left", "left"))
    Test.assert_true(Compare<str>.same("right", "right"))
    0
  })
}
