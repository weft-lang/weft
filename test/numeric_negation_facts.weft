use compiler/ir.{*}
use compiler/typeck.{type_hash_of}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/types.{*}
use stdlib/test.{Test}

test "numeric negation bridges preserve the checked result type and operand" {
  for ty in [ty_i8(), ty_u64(), ty_f32(), ty_f64()] {
    let node = node_new(65, node_new(2, 17, 5, 0, 0), ty, 0, 0)
    let expression = expr_from_node(node)
    Test.assert_true(match expression {
      Negate(Ident(start, len), result) -> start == 17 and len == 5 and ty_eq(type_expr_to_node(result), ty)
      _ -> false
    })
    let roundtrip = expr_to_node(expression)
    Test.assert_eq(node_tag(roundtrip), 65)
    Test.assert_true(ty_eq(node_f2(roundtrip), ty))
    Test.assert_eq(node_f1(node_f1(roundtrip)), 17)
    Test.assert_true(ty_eq(pipeline_expr_type_node_typed(expression), ty))
    Test.assert_eq(pipeline_expr_type_hash_typed(expression, 0, pipeline_value_env_empty(), 0, 0, 0, 0), type_hash_of(ty))
  }
}

test "checking publishes contextual floating negation width" {
  let source = "fn narrow() -> f32 { -0.0 } fn wide(value: f64) -> f64 { -value } fn explicit(value: f64) -> f64 { 0.0 - value }"
  match pipeline_check_source_standalone(__str_ptr(source), __str_len(source)) {
    TypedModule(fns, _, _, owners) -> {
      let narrow = pipeline_fns_lookup_pair_by_hash(fns, pipeline_ir_native_hash_name("narrow"))
      let wide = pipeline_fns_lookup_pair_by_hash(fns, pipeline_ir_native_hash_name("wide"))
      let explicit = pipeline_fns_lookup_pair_by_hash(fns, pipeline_ir_native_hash_name("explicit"))
      Test.assert_true(match expr_from_node(node_f4(pipeline_fn_inner(node_f1(narrow)))) {
        Negate(FloatLit(_, _, literal_ty), result_ty) -> type_expr_prim_id_or(literal_ty, -1) == PRIM_F32() and type_expr_prim_id_or(result_ty, -1) == PRIM_F32()
        _ -> false
      })
      Test.assert_true(match expr_from_node(node_f4(pipeline_fn_inner(node_f1(wide)))) {
        Negate(Ident(_, _), result_ty) -> type_expr_prim_id_or(result_ty, -1) == PRIM_F64()
        _ -> false
      })
      Test.assert_true(match expr_from_node(node_f4(pipeline_fn_inner(node_f1(explicit)))) {
        BinOp(2, FloatLit(_, _, _), Ident(_, _)) -> true
        _ -> false
      })
    }
  }
}

test "floating negation lowers to exact sign reversal from the checked lane" {
  for ty in [ty_f32(), ty_f64()] {
    let lowered = pipeline_lower_negation_value(7, type_expr_from_node(ty), 8)
    Test.assert_true(ir_lowered_expr_is_valid(lowered) == 1)
    Test.assert_eq(ir_lowered_expr_value(lowered), 9)
    Test.assert_eq(ir_lowered_expr_next_value(lowered), 10)
    let expected = if ty_eq(ty, ty_f32()) { 2147483648 } else { -9223372036854775808 }
    Test.assert_true(match ir_lowered_expr_insts(lowered) {
      IrInstCons(IrConstI64(8, sign), IrInstCons(IrBinaryI64(9, IrBxor, 7, 8), IrInstNil)) -> sign == expected
      _ -> false
    })
  }
  Test.assert_true(ir_lowered_expr_is_valid(pipeline_lower_negation_value(7, MissingTypeExpr, 8)) == 0)
  Test.assert_true(ir_lowered_expr_is_valid(pipeline_lower_negation_value(7, type_expr_from_node(ty_str()), 8)) == 0)
}

test "integer negation lowering retains the declared wrapping width" {
  for ty in [ty_i8(), ty_i16(), ty_i32(), ty_i64(), ty_u8(), ty_u16(), ty_u32(), ty_u64(), ty_isize(), ty_usize()] {
    let lowered = pipeline_lower_negation_value(7, type_expr_from_node(ty), 8)
    Test.assert_true(match ir_lowered_expr_insts(lowered) {
      IrInstCons(IrConstI64(8, 0), IrInstCons(IrFloatBinaryI64(9, prim, IrSub, 8, 7), IrInstNil)) -> prim == ty_f1(ty)
      _ -> false
    })
  }
}
