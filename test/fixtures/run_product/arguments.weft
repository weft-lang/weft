-- A product that reads its arguments through the platform environment handler,
-- which takes the raw argument vector. `weft run` must forward them exactly.

use runtime/env as env_handler
use stdlib/env.{Env}

fn inspect_args() -[Env]> i64 {
  if Env.arg_count() != 3 { 10 }
  else {
    match Env.arg(1) {
      nil -> 11
      first -> if first != "alpha" { 12 } else {
        match Env.arg(2) {
          nil -> 13
          second -> if second == "two words" { 0 } else { 14 }
        }
      }
    }
  }
}

fn main(argc: i64, argv: i64) -> i64 {
  with env_handler(argc, argv) { inspect_args() }
}
