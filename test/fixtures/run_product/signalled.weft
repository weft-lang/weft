-- A product whose child kills the product itself with SIGKILL, so `weft run`
-- reports 128 plus the signal number.

use runtime/process as process_handler
use stdlib/list.{Cons, Nil}
use stdlib/process.{Proc}

fn main() -> i64 {
  with process_handler() {
    Proc.run("/bin/sh", Cons("-c", Cons("kill -9 $PPID", Nil<str>())))
  }
  0
}
