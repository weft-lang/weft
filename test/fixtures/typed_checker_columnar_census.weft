-- Dynamic RC probe for a typed columnar checked-expression representation.

use compiler/weft/check/storage.{*}

type CensusKind {
  CensusLeafKind,
  CensusBranchKind
}

type CensusSegment {
  CensusSegment(
    DenseSegment<CensusKind>,
    DenseSegment<usize>,
    DenseSegment<i64>,
    DenseSegment<usize>,
    DenseSegment<DenseIndex>,
    DenseSegment<DenseIndex>,
    DenseSegment<usize>
  )
}

fn storage_index(value: usize) -> i64 { __u64_to_i64(__usize_to_u64(value)) }

fn census_kind(segment: borrow CensusSegment, expression: DenseIndex) -> CensusKind {
  match segment {
    CensusSegment(kinds, payloads, leaf_values, leaf_types, lefts, rights, branch_types) -> {
      kinds.at(expression)
    }
  }
}

fn census_branch_index_sum(segment: borrow CensusSegment, expression: DenseIndex) -> i64 {
  match segment {
    CensusSegment(kinds, payloads, leaf_values, leaf_types, lefts, rights, branch_types) -> {
      let payload = payloads.at(expression)
      let left = lefts.at(dense_index(payload))
      let right = rights.at(dense_index(payload))
      storage_index(dense_index_value(left)) + storage_index(dense_index_value(right))
    }
  }
}

fn main() -> i64 {
  let mut kinds = dense_builder_with_capacity<CensusKind>(3)
  let mut payloads = dense_builder_with_capacity<usize>(3)
  let mut leaf_values = dense_builder_with_capacity<i64>(2)
  let mut leaf_types = dense_builder_with_capacity<usize>(2)
  let mut lefts = dense_builder_with_capacity<DenseIndex>(1)
  let mut rights = dense_builder_with_capacity<DenseIndex>(1)
  let mut branch_types = dense_builder_with_capacity<usize>(1)
  let left = dense_index(0)
  let right = dense_index(1)
  let root = dense_index(2)

  leaf_values.push(1)
  leaf_types.push(1)
  kinds.push(CensusLeafKind)
  payloads.push(0)
  leaf_values.push(2)
  leaf_types.push(1)
  kinds.push(CensusLeafKind)
  payloads.push(1)
  lefts.push(left)
  rights.push(right)
  branch_types.push(1)
  kinds.push(CensusBranchKind)
  payloads.push(0)

  let segment = CensusSegment(
    kinds.freeze(),
    payloads.freeze(),
    leaf_values.freeze(),
    leaf_types.freeze(),
    lefts.freeze(),
    rights.freeze(),
    branch_types.freeze()
  )
  let mut total = 0
  for iteration in 0..10000 {
    match census_kind(segment, root) {
      CensusBranchKind -> {
        total = total + census_branch_index_sum(segment, root)
      }
      _ -> return 1
    }
  }
  if total == 10000 { 0 } else { 2 }
}
