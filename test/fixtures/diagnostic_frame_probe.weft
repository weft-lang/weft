-- Synthetic renderer probe for spans that ordinary checker facts rarely own.

use compiler/diagnose.{diagnose_render_report_in_registry}
use compiler/type_registry.{ttable_new, ttable_register_source}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}

pub fn main() -> i64 {
  let source = "zero\none two\nthree\nfour\nfive\nsix seven\neight"
  let tt = ttable_new()
  ttable_register_source(
    tt,
    __str_ptr(source),
    __str_len(source),
    __str_ptr("probe.weft"),
    __str_len("probe.weft")
  )
  diagnose_render_report_in_registry(
    tt,
    Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassOther("renderer-test"),
      DiagnosticCodeUnassigned,
      "range crosses the omitted middle",
      DiagnosticSourceRange(DiagnosticSourceBuffer(__str_ptr(source)), 2, 42),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldNil
    )
  )
}
