fn register(depth: i64) -> i64 {
  if depth == 0 { 1 } else { register(depth - 1) + 1 }
}

fn check_expr(depth: i64) -> i64 {
  if depth == 0 { 1 } else { check_expr(depth - 1) + 1 }
}

fn ty_new(depth: i64) -> i64 {
  if depth == 0 { 1 } else { ty_new(depth - 1) + 1 }
}

fn expr_to_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { expr_to_node(depth - 1) + 1 }
}

fn type_expr_to_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { type_expr_to_node(depth - 1) + 1 }
}

fn decl_to_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { decl_to_node(depth - 1) + 1 }
}

fn expr_from_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { expr_from_node(depth - 1) + 1 }
}

fn type_expr_from_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { type_expr_from_node(depth - 1) + 1 }
}

fn decl_from_node(depth: i64) -> i64 {
  if depth == 0 { 1 } else { decl_from_node(depth - 1) + 1 }
}

fn module_product_clone_types(depth: i64) -> i64 {
  if depth == 0 { 1 } else { module_product_clone_types(depth - 1) + 1 }
}

fn main() -> i64 {
  let total = register(1) + check_expr(2) + ty_new(1) + expr_to_node(1) +
    type_expr_to_node(1) + decl_to_node(1) + expr_from_node(1) +
    type_expr_from_node(1) + decl_from_node(1) + module_product_clone_types(1)
  if total == 21 { 0 } else { 1 }
}
