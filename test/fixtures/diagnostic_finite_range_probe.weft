use compiler/diagnose.{diagnose_render_report_in_registry}
use compiler/type_registry.{ttable_new, ttable_register_source}
use stdlib/diagnostic.{*}

fn main() -> i64 {
  let text = "🧶 a\nb"
  let table = ttable_new()
  ttable_register_source(table, __str_ptr(text), __str_len(text), __str_ptr("finite.weft"), __str_len("finite.weft"))
  let sources = [DiagnosticSourceBuffer(__str_ptr(text)), DiagnosticSourceNamed("finite.weft")]
  for source in sources {
    diagnose_render_report_in_registry(table, Diagnostic(
      DiagnosticSeverityNote, DiagnosticClassTool, DiagnosticCodeUnassigned,
      "offsets exceed the acquired source",
      DiagnosticSourceRange(source, 9223372036854775808, 18446744073709551615),
      DiagnosticRelatedLocationNil, DiagnosticFieldNil
    ))
  }
  0
}
