use stdlib/diagnostic/schema.{Diagnose, DiagnosticSourceNamed}
use stdlib/grammar.{Grammar, CheckedGrammar, Parsed, Checked}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as checking
use stdlib/grammar/sql/schema as schema
use stdlib/grammar/sql/schema_typecheck as schema_types
use stdlib/grammar/sql/schema_typecheck.{SqlSchemaIdentity}
use stdlib/grammar/sql/execute as execution
use stdlib/grammar/sql/execute.{SqlInputRow, SqlIntegerValue, SqlOutputRecordRow}
use stdlib/grammar/sql/plan
use stdlib/list as list
use stdlib/list.{Cons, Nil}
use stdlib/result.{Ok, Err}
use stdlib/source.{Source}

fn query() -[Diagnose]> i64 {
  let source = Source {
    text: "select total + 2 from readings where total > 10",
    identity: DiagnosticSourceNamed("consumer.sql")
  }
  let catalog = match schema.parse(
    "{\"schema_version\":1,\"tables\":{\"readings\":{\"total\":\"i64\"}}}"
  ) {
    Ok(value) -> value
    Err(_) -> return 1
  }
  let syntax = match sql.grammar().parse(source.all()) {
    Parsed(value) -> value
    _ -> return 2
  }
  let checked = with schema_types(catalog) {
    checking.checker<SqlSchemaIdentity>().check(syntax)
  }
  let plan = match checked {
    Checked(value) -> value
    _ -> return 3
  }
  let first = [SqlIntegerValue(40)]
  let second = [SqlIntegerValue(5)]
  let rows = [
    SqlInputRow { values: list.from_slice(first[..]) },
    SqlInputRow { values: list.from_slice(second[..]) }
  ]
  let inputs = [execution.input(plan.source(), list.from_slice(rows[..]))]
  match execution.run(plan, list.from_slice(inputs[..])) {
    Ok(result) -> match result.rows {
      Cons(SqlOutputRecordRow(Cons(SqlIntegerValue(value), Nil)), Nil) -> value
      _ -> 4
    }
    Err(_) -> 5
  }
}

fn main() -> i64 {
  handle query() {
    Diagnose.report(diagnostic) -> 6
  }
}
