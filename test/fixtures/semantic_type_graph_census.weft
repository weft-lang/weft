-- Dynamic RC probe for hot local traversal and structural equality over a
-- segmented semantic type graph.

use compiler/project/identity.{
  AssociatedTypeDeclaration,
  ConstructorDeclaration,
  EffectDeclaration,
  MemberDeclarationIdentity,
  ModuleDeclarationIdentity,
  TraitDeclaration,
  TypeDeclaration,
  named_module_identity
}
use compiler/source/input.{source_from_text}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{*}
use compiler/types/graph/equality.{semantic_type_catalog_context_equal}
use stdlib/list as list
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

fn required_context(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph
) -> SemanticTypeCatalogContext {
  match catalog.segment(semantic_type_graph_segment(graph)) {
    Some(SemanticTypeCatalogSegmentValue(context)) -> context
    None -> panic("Semantic type census catalog lost its only segment")
  }
}

fn main() -> i64 {
  let builder = semantic_type_graph_builder(
    semantic_type_segment_id(named_module_identity("census/semantic_types", 41))
  )
  let (builder, left) = builder.primitive(SemanticI64)
  let (builder, right) = builder.primitive(SemanticStr)
  let (builder, root) = builder.union(left, right)
  let (builder, equal_left) = builder.primitive(SemanticI64)
  let (builder, equal_right) = builder.primitive(SemanticStr)
  let (builder, equal_root) = builder.union(equal_left, equal_right)
  let list_values = [left, right]
  let (builder, pair) = builder.type_list(
    list.from_slice<SemanticTypeId>(list_values[..])
  )
  let state = ModuleDeclarationIdentity(
    named_module_identity("census/semantic_types", 41),
    EffectDeclaration,
    source_from_text("State").all()
  )
  let (builder, effect_atom) = builder.effect_atom(state, pair)
  let effect_values = [effect_atom]
  let (builder, effect_set) = builder.type_list(
    list.from_slice<SemanticTypeId>(effect_values[..])
  )
  let (builder, effects) = builder.effect_signature(
    effect_set,
    SemanticOpenEffects(17)
  )
  let (builder, function) = builder.function(pair, left, effects)
  let box_declaration = ModuleDeclarationIdentity(
    named_module_identity("census/semantic_types", 41),
    TypeDeclaration,
    source_from_text("Box").all()
  )
  let (builder, named) = builder.named(
    box_declaration,
    SemanticOpaqueType,
    left,
    pair
  )
  let record_names = ["left", "right"]
  let record_types = [left, right]
  let (builder, record) = builder.record(
    list.from_slice<str>(record_names[..]),
    list.from_slice<SemanticTypeId>(record_types[..]),
    SemanticClosedRecord
  )
  let ready_declaration = MemberDeclarationIdentity(
    box_declaration,
    ConstructorDeclaration,
    source_from_text("Ready").all()
  )
  let (builder, variant) = builder.variant(ready_declaration, right)
  let (builder, variable) = builder.variable(SemanticParameterVariable(7))
  let iterable_declaration = ModuleDeclarationIdentity(
    named_module_identity("census/semantic_types", 41),
    TraitDeclaration,
    source_from_text("Iterable").all()
  )
  let (builder, trait_atom) = builder.trait_atom(iterable_declaration)
  let item_declaration = MemberDeclarationIdentity(
    iterable_declaration,
    AssociatedTypeDeclaration,
    source_from_text("Item").all()
  )
  let (builder, associated) = builder.associated(right, item_declaration)
  let graph = builder.freeze()
  let catalog = semantic_type_catalog_single(graph)
  let catalog_context = required_context(catalog, graph)
  let local_graph = semantic_type_graph_local(graph)
  let local_lists = semantic_type_graph_type_lists_local(graph)
  let local_functions = semantic_type_graph_functions_local(graph)
  let local_effects = semantic_type_graph_effects_local(graph)
  let local_named = semantic_type_graph_named_local(graph)
  let local_records = semantic_type_graph_records_local(graph)
  let local_variants = semantic_type_graph_variants_local(graph)
  let local_variables = semantic_type_graph_variables_local(graph)
  let local_traits = semantic_type_graph_traits_local(graph)
  let local_associated = semantic_type_graph_associated_local(graph)
  let local_root = semantic_type_graph_local_id(graph, root)
  let local_equal_root = semantic_type_graph_local_id(graph, equal_root)
  let local_function = semantic_type_graph_local_id(graph, function)
  let local_effect_atom = semantic_type_graph_local_id(graph, effect_atom)
  let local_effect_signature = semantic_type_graph_local_id(graph, effects)
  let local_named_type = semantic_type_graph_local_id(graph, named)
  let local_record = semantic_type_graph_local_id(graph, record)
  let local_variant = semantic_type_graph_local_id(graph, variant)
  let local_variable = semantic_type_graph_local_id(graph, variable)
  let local_trait = semantic_type_graph_local_id(graph, trait_atom)
  let local_projection = semantic_type_graph_local_id(graph, associated)
  let mut total: usize = 0

  for iteration in 0..10000 {
    if not semantic_type_catalog_context_equal(
      catalog,
      catalog_context,
      local_root,
      catalog_context,
      local_equal_root
    ) { return 14 }
    else { nil }
    match semantic_type_graph_kind_local(local_graph, local_root) {
      SemanticUnionKind -> {
        let edges = semantic_type_local_graph_binary(local_graph, local_root)
        if semantic_type_local_graph_binary_left_is_imported(local_graph, edges) or
          semantic_type_local_graph_binary_right_is_imported(local_graph, edges) {
            return 1
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_local_graph_binary_left_id(local_graph, edges)
            ) + semantic_local_type_id_ordinal(
              semantic_type_local_graph_binary_right_id(local_graph, edges)
            )
          }
        let first = semantic_type_list_edge(local_lists, pair, 0)
        let second = semantic_type_list_edge(local_lists, pair, 1)
        if semantic_type_list_edge_is_imported(local_lists, first) or
          semantic_type_list_edge_is_imported(local_lists, second) {
            return 3
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_list_edge_local_id(local_lists, first)
            ) + semantic_local_type_id_ordinal(
              semantic_type_list_edge_local_id(local_lists, second)
            )
          }
        let function_edge = semantic_type_local_graph_function(
          local_graph,
          local_function
        )
        if semantic_type_function_result_is_imported(local_functions, function_edge) or
          semantic_type_function_effects_are_imported(local_functions, function_edge) {
            return 4
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_function_result_local_id(local_functions, function_edge)
            ) + semantic_local_type_id_ordinal(
              semantic_type_function_effects_local_id(local_functions, function_edge)
            )
          }
        let atom_edge = semantic_type_local_graph_effect_atom(
          local_graph,
          local_effect_atom
        )
        let signature_edge = semantic_type_local_graph_effect_signature(
          local_graph,
          local_effect_signature
        )
        if semantic_type_effect_atom_declaration_hash(local_effects, atom_edge) == 0 or
          semantic_type_list_id_ordinal(
            semantic_type_effect_atom_arguments(local_effects, atom_edge)
          ) != semantic_type_list_id_ordinal(pair) or
          not semantic_type_effect_signature_is_open(local_effects, signature_edge) {
            return 5
          } else {
            total = total + semantic_type_list_id_ordinal(
              semantic_type_effect_signature_effects(local_effects, signature_edge)
            ) + semantic_type_effect_signature_tail(local_effects, signature_edge)
          }
        let named_edge = semantic_type_local_graph_named(local_graph, local_named_type)
        if semantic_type_named_declaration_hash(local_named, named_edge) == 0 or
          semantic_type_named_representation_is_imported(local_named, named_edge) or
          semantic_type_list_id_ordinal(
            semantic_type_named_arguments(local_named, named_edge)
          ) != semantic_type_list_id_ordinal(pair) {
            return 6
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_named_representation_local_id(local_named, named_edge)
            )
          }
        let record_edge = semantic_type_local_graph_record(local_graph, local_record)
        let record_fields = semantic_type_record_fields(local_records, record_edge)
        let first_field = semantic_type_record_field_edge(
          local_records,
          record_fields,
          0
        )
        let second_field = semantic_type_record_field_edge(
          local_records,
          record_fields,
          1
        )
        if semantic_type_record_field_count(local_records, record_fields) != 2 or
          semantic_type_record_field_is_imported(local_records, first_field) or
          semantic_type_record_field_is_imported(local_records, second_field) {
            return 7
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_record_field_local_id(local_records, first_field)
            ) + semantic_local_type_id_ordinal(
              semantic_type_record_field_local_id(local_records, second_field)
            )
          }
        let variant_edge = semantic_type_local_graph_variant(
          local_graph,
          local_variant
        )
        if semantic_type_variant_declaration_hash(local_variants, variant_edge) == 0 or
          semantic_type_variant_payload_is_imported(local_variants, variant_edge) {
            return 8
          } else {
            total = total + semantic_local_type_id_ordinal(
              semantic_type_variant_payload_local_id(local_variants, variant_edge)
            )
          }
        let variable_edge = semantic_type_local_graph_variable(
          local_graph,
          local_variable
        )
        if semantic_type_variable_is_self(local_variables, variable_edge) {
          return 10
        } else {
          total = total + semantic_type_variable_parameter(
            local_variables,
            variable_edge
          )
        }
        let trait_edge = semantic_type_local_graph_trait(local_graph, local_trait)
        if semantic_type_trait_declaration_hash(local_traits, trait_edge) == 0 {
          return 12
        } else { nil }
        let associated_edge = semantic_type_local_graph_associated(
          local_graph,
          local_projection
        )
        if semantic_type_associated_declaration_hash(
          local_associated,
          associated_edge
        ) == 0 or semantic_type_associated_base_is_imported(
          local_associated,
          associated_edge
        ) {
          return 11
        } else {
          total = total + semantic_local_type_id_ordinal(
            semantic_type_associated_base_local_id(
              local_associated,
              associated_edge
            )
          )
        }
      }
      _ -> return 2
    }
  }

  if total == 370000 { 0 } else { 9 }
}
