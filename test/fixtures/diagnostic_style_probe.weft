-- Synthetic human-renderer probe for every ANSI role. Color never carries
-- meaning by itself: severity names, codes, carets, and labels remain present.

use compiler/diagnose.{diagnose_render_report_in_registry}
use compiler/type_registry.{ttable_new, ttable_register_source}
use runtime/terminal.{terminal_color_mode_always, terminal_set_stderr_color_mode}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}

pub fn main() -> i64 {
  let source = "alpha beta gamma"
  let tt = ttable_new()
  ttable_register_source(tt, __str_ptr(source), __str_len(source), __str_ptr("style.weft"), __str_len("style.weft"))
  terminal_set_stderr_color_mode(terminal_color_mode_always())
  diagnose_render_report_in_registry(
    tt,
    diagnostic_new(
      DiagnosticSeverityWarning,
      DiagnosticClassOther("renderer-test"),
      DiagnosticCodeUnassigned,
      "warning role",
      DiagnosticSourceRange(DiagnosticSourceBuffer(__str_ptr(source)), 0, 5),
      DiagnosticRelatedLocationCons(
        DiagnosticRelatedLocation("related role", DiagnosticSourceRange(DiagnosticSourceBuffer(__str_ptr(source)), 6, 10)),
        DiagnosticRelatedLocationNil
      ),
      DiagnosticFieldNil
    )
  )
  diagnose_render_report_in_registry(
    tt,
    diagnostic_new(
      DiagnosticSeverityNote,
      DiagnosticClassOther("renderer-test"),
      DiagnosticCodeUnassigned,
      "note role",
      DiagnosticSourceRange(DiagnosticSourceBuffer(__str_ptr(source)), 11, 16),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldNil
    )
  )
}
