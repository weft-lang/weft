use native_raw.{FixtureHandle, fixture_drop_count_safe, fixture_fill_bytes, fixture_get_safe, fixture_open_safe, fixture_sum_slice}
use stdlib/bytes as bytes
use stdlib/vector.{vector_get_in_bounds}

fn scoped_handle_value() -> i64 {
  let resource: owned FixtureHandle = fixture_open_safe(40)
  fixture_get_safe(resource)
}

fn main() -> i64 {
  let handle_value = scoped_handle_value()
  let values = bytes.from_str("abc").to_vector()
  let filled = fixture_fill_bytes(values[..], 14)
  let sum = fixture_sum_slice(values[..])
  let bytes_match = vector_get_in_bounds<u8>(values, 0) == __i64_to_u8(14) and
    vector_get_in_bounds<u8>(values, 1) == __i64_to_u8(14) and
    vector_get_in_bounds<u8>(values, 2) == __i64_to_u8(14)
  if handle_value == 40 and filled == 3 and sum == 42 and bytes_match and
     fixture_drop_count_safe() == 1 {
    0
  } else {
    1
  }
}
