use stdlib/par as par
use runtime/rc_implicit_test.{*}
use runtime/alloc.{heap_remaining}
use runtime/rc.{rc_default_heap}

fn sequential_capture(payload: RuntimeRcProbe) -> i64 {
  let inputs = [1, 2]
  par.with_sequential(() => {
    let values = par.map(inputs[..], value => runtime_rc_probe_load(payload) + value)
    values.fold(0, (sum, value) => sum + value)
  })
}

fn pool_capture(payload: RuntimeRcProbe) -> i64 {
  let inputs = [1, 2]
  par.with_pool(1, 2, () => {
    let values = par.map(inputs[..], value => runtime_rc_probe_load(payload) + value)
    values.fold(0, (sum, value) => sum + value)
  })
}

fn bound_capture(payload: RuntimeRcProbe) -> i64 {
  let callback = (value: i64) => runtime_rc_probe_load(payload) + value
  let inputs = [1, 2]
  let first = par.with_sequential(() => {
    let values = par.map(inputs[..], callback)
    values.fold(0, (sum, value) => sum + value)
  })
  first + callback(3)
}

fn noncapturing_map() -> i64 {
  let inputs = [1, 2, 3]
  par.with_sequential(() => {
    let values = par.map(inputs[..], value => value * 7)
    values.fold(0, (sum, value) => sum + value)
  })
}

test "sequential mapping releases its direct callback capture" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(sequential_capture(payload), 43)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "parallel mapping releases its direct callback capture" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(pool_capture(payload), 43)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "mapping preserves a named callback's independent owner" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(bound_capture(payload), 66)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "noncapturing direct mapping callbacks leave no heap owner" {
  let heap = rc_default_heap()
  for _ in 0..4 { Test.assert_eq(noncapturing_map(), 42) }
  let before = heap_remaining(heap)
  let mut total = 0
  for _ in 0..16 { total = total + noncapturing_map() }
  let after = heap_remaining(heap)
  Test.assert_eq(total, 672)
  Test.assert_eq(after, before)
}

fn empty_capture(payload: RuntimeRcProbe) -> i64 {
  let inputs: [i64; 0] = []
  let sequential = par.with_sequential(() => {
    let values = par.map(inputs[..], value => runtime_rc_probe_load(payload) + value)
    values.fold(0, (sum, value) => sum + value)
  })
  sequential + par.with_pool(1, 1, () => {
    let values = par.map(inputs[..], value => runtime_rc_probe_load(payload) + value)
    values.fold(0, (sum, value) => sum + value)
  })
}

fn make_callback(payload: RuntimeRcProbe) -> (i64) -> i64 {
  value => runtime_rc_probe_load(payload) + value
}

fn factory_capture(payload: RuntimeRcProbe) -> i64 {
  let inputs = [1, 2]
  par.with_sequential(() => {
    let values = par.map(inputs[..], make_callback(payload))
    values.fold(0, (sum, value) => sum + value)
  })
}

fn branch_capture(payload: RuntimeRcProbe, first: bool) -> i64 {
  let inputs = [1, 2]
  par.with_pool(1, 2, () => {
    let values = par.map(inputs[..], if first {
      value => runtime_rc_probe_load(payload) + value
    } else {
      value => runtime_rc_probe_load(payload) * value
    })
    values.fold(0, (sum, value) => sum + value)
  })
}

test "empty mapping still releases uninvoked direct callbacks" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(empty_capture(payload), 0)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "mapping releases a callback returned by a factory" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(factory_capture(payload), 43)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}

test "mapping releases callbacks selected by either branch" {
  let payload = runtime_rc_probe_new(20)
  Test.assert_eq(branch_capture(payload, true), 43)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
  Test.assert_eq(branch_capture(payload, false), 60)
  Test.assert_eq(runtime_rc_probe_count(payload), 1)
}
