use module_fixtures/g2_ctor_left as left
use module_fixtures/g2_ctor_right as right
use module_fixtures/g2_ctor_left.{LeftChoice}
use module_fixtures/g2_ctor_right.{RightChoice}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_count, runtime_rc_probe_load, runtime_rc_probe_new, runtime_rc_test_heap_arena_offset}
use runtime/defer_order_test.{OwnedAbortToken, defer_order_log_new, defer_order_log_read, owned_abort_token_new}
use stdlib/fail.{Fail}

type ConstructorBox { ConstructorBox(i64) }
type ConstructorPair { ConstructorPair(i64, bool) }
type ConstructorFloat { ConstructorFloat(f64) }
type ConstructorManaged { ConstructorManaged(RuntimeRcProbe) }
type ConstructorGeneric<T> { ConstructorGeneric(T) }
type ConstructorOwned { ConstructorOwned(owned OwnedAbortToken) }
type ConstructorWide { ConstructorWide([i64; 3], i64) }

fn constructor_apply<T>(build: (i64) -> T) -> T { build(42) }
fn constructor_pair_apply(build: (i64, bool) -> ConstructorPair) -> ConstructorPair { build(42, true) }
fn constructor_float_apply(build: (f64) -> ConstructorFloat) -> ConstructorFloat { build(1.25) }
fn constructor_managed_apply(build: (RuntimeRcProbe) -> ConstructorManaged, value: RuntimeRcProbe) -> ConstructorManaged { build(value) }
fn constructor_owned_apply(build: (owned OwnedAbortToken) -> ConstructorOwned, value: owned OwnedAbortToken) -> ConstructorOwned { build(value) }
fn constructor_wide_apply(build: ([i64; 3], i64) -> ConstructorWide) -> ConstructorWide { build([10, 20, 30], 42) }

fn constructor_owned_scope(log: i64) -> i64 {
  let wrapped = constructor_owned_apply(ConstructorOwned, owned_abort_token_new(log, 7))
  42
}

fn constructor_managed_abort(value: RuntimeRcProbe) -[Fail<i64>]> i64 {
  let boxed = constructor_managed_apply(ConstructorManaged, value)
  Fail<i64>.fail(42)
}

fn constructor_round() -> i64 {
  match constructor_apply<ConstructorBox>(ConstructorBox) { ConstructorBox(value) -> value }
}

fn constructor_rounds(count: i64) -> i64 {
  let mut sum = 0
  for index in 0..count { sum = sum + constructor_round() }
  sum
}

fn constructor_identity<T>(value: T) -> T { value }

test "payload constructor is a first-class callback" {
  match constructor_apply<ConstructorBox>(ConstructorBox) {
    ConstructorBox(value) -> Test.assert_eq(value, 42)
  }
}

test "constructor value can be bound and called repeatedly" {
  let build: (i64) -> ConstructorBox = ConstructorBox
  let first = build(20)
  let second = build(22)
  match first {
    ConstructorBox(a) -> match second { ConstructorBox(b) -> Test.assert_eq(a + b, 42) }
  }
}

test "constructor callback preserves all payload arguments" {
  match constructor_pair_apply(ConstructorPair) {
    ConstructorPair(value, flag) -> { Test.assert_eq(value, 42) Test.assert_true(flag) }
  }
}

test "constructor callback preserves floating payload representation" {
  match constructor_float_apply(ConstructorFloat) {
    ConstructorFloat(value) -> Test.assert_true(value == 1.25)
  }
}

test "constructor callback transfers its managed payload once" {
  let value = runtime_rc_probe_new(42)
  let boxed = constructor_managed_apply(ConstructorManaged, value)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  match boxed { ConstructorManaged(payload) -> Test.assert_eq(runtime_rc_probe_load(payload), 42) }
}

test "qualified constructor values preserve declaration identity" {
  let integer: (i64) -> LeftChoice = left.Same
  let boolean: (bool) -> RightChoice = right.Same
  Test.assert_eq(left.read(integer(42)), 42)
  Test.assert_true(right.read(boolean(true)))
}

test "generic constructor callback infers its payload type from context" {
  match constructor_apply<ConstructorGeneric<i64>>(ConstructorGeneric) {
    ConstructorGeneric(value) -> Test.assert_eq(value, 42)
  }
}

test "generic constructor value specializes from its binding annotation" {
  let build: (i64) -> ConstructorGeneric<i64> = ConstructorGeneric
  match build(42) { ConstructorGeneric(value) -> Test.assert_eq(value, 42) }
}

test "constructor callback transfers an owned resource into aggregate cleanup" {
  let log = defer_order_log_new()
  Test.assert_eq(constructor_owned_scope(log), 42)
  Test.assert_eq(defer_order_log_read(log), 7)
}

test "constructor callback carries wide payloads without shifting later arguments" {
  match constructor_wide_apply(ConstructorWide) {
    ConstructorWide(values, marker) -> {
      Test.assert_eq(values[0], 10)
      Test.assert_eq(values[2], 30)
      Test.assert_eq(marker, 42)
    }
  }
}

test "constructor callback payload is released by abort cleanup" {
  let value = runtime_rc_probe_new(42)
  let status = handle constructor_managed_abort(value) { Fail<i64>.fail(error) -> error }
  Test.assert_eq(status, 42)
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "repeated constructor callbacks reclaim closures and constructed values" {
  constructor_rounds(64)
  let before = runtime_rc_test_heap_arena_offset()
  let total = constructor_rounds(1000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(total, 42000)
  Test.assert_eq(after, before)
}

test "ordinary generic function values share annotation specialization" {
  let identity: (i64) -> i64 = constructor_identity
  Test.assert_eq(identity(42), 42)
}
