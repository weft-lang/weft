use compiler/grammar_host.{parse_registered_source}
use compiler/source_input.{source_from_text}
use compiler/pipeline.{pipeline_check_loaded}
use compiler/type_registry.{ttable_new}
use compiler/typeck.{typeck_nil_discrimination, NilExcluded, NilOnly, NilSentinel, NilIndistinguishable, NilUnresolved}
use compiler/types.{ty_i64, ty_bool, ty_str, ty_nil, ty_nullable, ty_any, ty_f64, ty_f32}
use runtime/source_acquire.{source_acquire_with_standalone}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/list.{List, Cons, Nil}
use stdlib/string.{*}
use stdlib/state as state
use stdlib/state.{State}

type DiscriminationReports { reports: List<Diagnostic>, legacy: i64 }

type PresentValue { value: i64 }

type PresentChoice { FirstChoice, LastChoice }

fn check_discrimination_source(source: str) -> (i64, DiscriminationReports) {
  state.run(DiscriminationReports { reports: Nil<Diagnostic>(), legacy: 0 }, () => {
    source_acquire_with_standalone(() => handle {
      let src = __str_ptr(source)
      let tt = ttable_new()
      let fns = parse_registered_source(source_from_text(source), tt)
      pipeline_check_loaded(fns.functions, src, tt)
    } {
      Diagnose.report(diagnostic) -> {
        let current = State<DiscriminationReports>.get()
        State<DiscriminationReports>.put(DiscriminationReports { reports: Cons(diagnostic, current.reports), legacy: current.legacy })
        resume(0)
      }
      Diagnose.error(message, span) -> {
        let current = State<DiscriminationReports>.get()
        State<DiscriminationReports>.put(DiscriminationReports { reports: current.reports, legacy: current.legacy + 1 })
        resume(0)
      }
      Diagnose.warn(message, span) -> resume(0)
      Diagnose.note(message, span) -> resume(0)
    })
  })
}

fn assert_discrimination_rejected(source: str) -[Test]> nil {
  let checked = check_discrimination_source(source)
  Test.assert_eq(checked.0, 1)
  Test.assert_eq(checked.1.legacy, 0)
  match checked.1.reports {
    Cons(diagnostic, Nil) -> {
      Test.assert_true(diagnostic.code().eq(DiagnosticCodeAssigned("E1006")))
      match diagnostic.primary() {
        DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end) -> {
          Test.assert_eq(buffer, __str_ptr(source))
          Test.assert_true(end > start)
        }
        _ -> Test.assert_true(false)
      }
    }
    _ -> Test.assert_true(false)
  }
  nil
}

test "nil discrimination is a representation fact distinct from type membership" {
  let tt = ttable_new()
  Test.assert_true(match typeck_nil_discrimination(ty_i64(), tt) { NilExcluded -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nil(), tt) { NilOnly -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nullable(ty_str()), tt) { NilSentinel(inner) -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nullable(ty_i64()), tt) { NilIndistinguishable -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nullable(ty_bool()), tt) { NilIndistinguishable -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nullable(ty_f64()), tt) { NilIndistinguishable -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_nullable(ty_f32()), tt) { NilIndistinguishable -> true _ -> false })
  Test.assert_true(match typeck_nil_discrimination(ty_any(), tt) { NilUnresolved -> true _ -> false })
}

test "nullable scalar equality cannot mistake a present zero or false for nil" {
  assert_discrimination_rejected("fn present(value: i64?) -> bool { value != nil } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("fn present(value: bool?) -> bool { nil == value } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("fn present(value: f64?) -> bool { value == nil } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("fn present(value: f32?) -> bool { nil != value } fn main() -> i64 { 0 }")
}

test "nil patterns and typed scalar arms require the same discrimination proof" {
  assert_discrimination_rejected("fn present(value: i64?) -> bool { match value { nil -> false _ -> true } } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("fn present(value: i64?) -> bool { match value { integer: i64 -> true _ -> false } } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("fn present(value: i64 | str) -> bool { match value { integer: i64 -> true _ -> false } } fn main() -> i64 { 0 }")
}

test "structural products and opaque scalars cannot borrow a nil sentinel" {
  assert_discrimination_rejected("fn present(value: (i64, i64)?) -> bool { value != nil } fn main() -> i64 { 0 }")
  assert_discrimination_rejected("type Count = opaque i64 fn present(value: Count?) -> bool { value != nil } fn main() -> i64 { 0 }")
}

fn present_record(value: PresentValue?) -> bool { value != nil }

fn present_choice(value: PresentChoice?) -> bool { value != nil }

fn record_payload(value: PresentValue?) -> i64 {
  match value { present: PresentValue -> present.value nil -> - 1 }
}

fn present_empty_array(value: [i64; 0]?) -> bool { value != nil }

fn empty_array_length(value: [i64; 0]?) -> usize {
  let absent: usize = 99
  match value { items: [i64; 0] -> items.len, nil -> absent }
}

fn present_zero_array(value: [i64; 2]?) -> bool { nil != value }

fn present_function(value: (() -> i64)?) -> bool { value != nil }

fn nullable_function_result(value: (() -> i64)?) -> i64 {
  match value { callback: () -> i64 -> callback(), nil -> -1 }
}

fn present_text(value: str?) -> bool { value != nil }

fn nullable_function_answer() -> i64 { 42 }

fn nullable_catch_all(value: i64?) -> i64 { match value { whole: i64? -> 42 } }

fn nullable_record_catch_all(value: PresentValue?) -> i64 { match value { whole: PresentValue? -> 42 } }

test "managed values and nonzero constructor tags preserve nil discrimination" {
  Test.assert_true(present_record(PresentValue { value: 0 }))
  Test.assert_true(not present_record(nil))
  Test.assert_true(present_choice(FirstChoice))
  Test.assert_true(present_choice(LastChoice))
  Test.assert_true(not present_choice(nil))
  Test.assert_eq(record_payload(PresentValue { value: 0 }), 0)
  Test.assert_eq(record_payload(nil), - 1)
  let empty: [i64; 0] = []
  let zeros = [0, 0]
  Test.assert_true(present_empty_array(empty))
  Test.assert_false(present_empty_array(nil))
  Test.assert_eq_usize(empty_array_length(empty), 0)
  Test.assert_eq_usize(empty_array_length(nil), 99)
  Test.assert_true(present_zero_array(zeros))
  Test.assert_false(present_zero_array(nil))
  Test.assert_true(present_function(nullable_function_answer))
  Test.assert_false(present_function(nil))
  Test.assert_eq(nullable_function_result(nullable_function_answer), 42)
  Test.assert_eq(nullable_function_result(nil), -1)
  let captured = 7
  let closure = () => captured
  Test.assert_eq(nullable_function_result(closure), 7)
  Test.assert_true(present_text(""))
  Test.assert_true(present_text("".concat("")))
  Test.assert_false(present_text(nil))
}

test "typed catch-all arms do not test a nil sentinel" {
  Test.assert_eq(nullable_catch_all(0), 42)
  Test.assert_eq(nullable_catch_all(nil), 42)
  Test.assert_eq(nullable_record_catch_all(nil), 42)
  Test.assert_eq(nullable_record_catch_all(PresentValue { value: 0 }), 42)
}
