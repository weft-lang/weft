use stdlib/bytes.{Bytes, bytes_concat, bytes_equal, bytes_from_slice, bytes_from_str, bytes_len, bytes_to_utf8}
use stdlib/http.{Http11, HttpGet, HttpRequestHead, http_default_limits, http_field_name_parse, http_header, http_headers_append, http_headers_empty, http_request_head_new, http_request_target_parse}
use stdlib/http_endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientUpgradeFailed, HttpClientUpgradeReady}
use stdlib/http_replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay, http_replay_fixture, http_replay_stats}
use stdlib/http_stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO, http_body_finish, http_connection_close}
use stdlib/http_transport.{HttpReplayTransportState, HttpTransportIO, HttpTransportRelease}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random.{SecureRandom, SecureRandomError, secure_random_with_deterministic}
use stdlib/websocket.{WebSocketBinaryContent, WebSocketClientUpgrade, WebSocketControlContent, WebSocketControlPing, WebSocketRandom, WebSocketText, WebSocketTextContent, websocket_client_upgrade, websocket_client_upgrade_headers, websocket_default_limits}
use stdlib/websocket_stream.{WebSocketStreamControl, WebSocketStreamFrame, WebSocketStreamFrameReadFailed, WebSocketStreamFrameStopped, WebSocketStreamOpen, WebSocketStreamOpenFailed, WebSocketStreamPayload, WebSocketStreamPayloadEnd, WebSocketStreamPayloadReadFailed, WebSocketStreamPayloadRejected, WebSocketStreamPayloadStopped, WebSocketStreamProtocol, WebSocketStreamWriteRejected, WebSocketStreamWriteStopped, WebSocketStreamWrote, WebSocketStreamWrongRole, websocket_client_stream, websocket_client_write_frame, websocket_frame_read, websocket_stream_close, websocket_stream_next}
use stdlib/url.{url_parse}

fn websocket_stream_request(upgrade: WebSocketClientUpgrade) -> HttpRequestHead {
  let headers = http_headers_append(
    websocket_client_upgrade_headers(upgrade),
    http_header(
      http_field_name_parse("Host").unwrap(),
      bytes_from_str("example.com")
    ).unwrap()
  )
  http_request_head_new(
    HttpGet,
    http_request_target_parse("/chat").unwrap(),
    Http11,
    headers,
    http_default_limits()
  ).unwrap()
}

fn websocket_stream_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>, SecureRandom]> i64 {
  let upgrade = websocket_client_upgrade().unwrap()
  match HttpClient<HttpReplayTransportState>.begin(
    url_parse("https://example.com/chat").unwrap(),
    websocket_stream_request(upgrade),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientUpgradeFailed(error) -> 5
        HttpClientUpgradeReady(response, connection) -> match websocket_client_stream(
          connection,
          upgrade,
          response,
          websocket_default_limits()
        ) {
          WebSocketStreamOpenFailed(returned, error) -> 6
          WebSocketStreamOpen(stream) -> match websocket_stream_next(stream) {
            WebSocketStreamFrameReadFailed(returned, error) -> 7
            WebSocketStreamFrameStopped(returned, error) -> 8
            WebSocketStreamFrame(frame, header, WebSocketTextContent) -> match websocket_frame_read(
              frame,
              __i64_to_usize(0)
            ) {
              WebSocketStreamPayloadRejected(returned, error) -> match websocket_frame_read(
                returned,
                __i64_to_usize(2)
              ) {
                WebSocketStreamPayload(next, first) -> if bytes_to_utf8(first).unwrap() != "H" { 9 }
                else { match websocket_frame_read(next, __i64_to_usize(3)) {
                  WebSocketStreamPayload(last_frame, middle) -> if bytes_to_utf8(middle).unwrap() != "el" { 10 }
                  else { match websocket_frame_read(last_frame, __i64_to_usize(3)) {
                      WebSocketStreamPayloadEnd(stream, last) -> if bytes_to_utf8(last).unwrap() != "lo" { 11 }
                      else { match websocket_client_write_frame(
                          stream,
                          true,
                          WebSocketText,
                          bytes_from_str("Yo")
                        ) {
                          WebSocketStreamWrote(returned) -> match websocket_stream_close(returned) {
                            Ok(done) -> 0
                            Err(error) -> 12
                          }
                          WebSocketStreamWriteRejected(returned, WebSocketStreamWrongRole(role)) -> 19
                          WebSocketStreamWriteRejected(returned, WebSocketStreamProtocol(WebSocketRandom(error))) -> 20
                          WebSocketStreamWriteRejected(returned, error) -> 21
                          WebSocketStreamWriteStopped(returned, error) -> 14
                        } }
                      _ -> 15
                    } }
                  _ -> 16
                } }
                _ -> 17
              }
              _ -> 22
            }
            _ -> 18
          }
        }
      }
    }
  }
}

fn websocket_stream_entropy() -> Bytes {
  let mask = [__i64_to_u8(1), __i64_to_u8(2), __i64_to_u8(3), __i64_to_u8(4)]
  bytes_concat(bytes_from_str("the sample nonce"), bytes_from_slice(mask[..]))
}

fn websocket_stream_control_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>, SecureRandom]> i64 {
  let upgrade = websocket_client_upgrade().unwrap()
  match HttpClient<HttpReplayTransportState>.begin(
    url_parse("https://example.com/chat").unwrap(),
    websocket_stream_request(upgrade),
    http_default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match http_body_finish(writer, http_headers_empty()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http_default_limits()
      ) {
        HttpClientUpgradeFailed(error) -> 2
        HttpClientUpgradeReady(response, connection) -> match websocket_client_stream(
          connection,
          upgrade,
          response,
          websocket_default_limits()
        ) {
          WebSocketStreamOpenFailed(returned, error) -> 3
          WebSocketStreamOpen(stream) -> match websocket_stream_next(stream) {
            WebSocketStreamFrame(frame, header, WebSocketControlContent) -> match websocket_frame_read(
              frame,
              __i64_to_usize(1)
            ) {
              WebSocketStreamControl(returned, WebSocketControlPing(payload)) -> if bytes_len(payload) != 0 { 4 }
              else { match websocket_stream_close(returned) {
                  Ok(done) -> 0
                  Err(error) -> 5
                } }
              _ -> 6
            }
            _ -> 7
          }
        }
      }
      _ -> 8
    }
  }
}

fn websocket_stream_input() -> Bytes {
  let frame = [__i64_to_u8(129), __i64_to_u8(5)]
  bytes_concat(
    bytes_concat(
      bytes_from_str("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"),
      bytes_from_slice(frame[..])
    ),
    bytes_from_str("Hello")
  )
}

fn websocket_stream_expected() -> Bytes {
  let frame = [
    __i64_to_u8(129), __i64_to_u8(130), __i64_to_u8(1), __i64_to_u8(2),
    __i64_to_u8(3), __i64_to_u8(4), __i64_to_u8(88), __i64_to_u8(109)
  ]
  bytes_concat(
    bytes_from_str("GET /chat HTTP/1.1\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\nhost: example.com\r\n\r\n"),
    bytes_from_slice(frame[..])
  )
}

fn websocket_stream_control_input() -> Bytes {
  let frame = [__i64_to_u8(137), __i64_to_u8(0)]
  bytes_concat(
    bytes_from_str("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"),
    bytes_from_slice(frame[..])
  )
}

test "owned WebSocket stream crosses 101 and preserves bounded frame backpressure" {
  let fixture = http_replay_fixture(
    websocket_stream_input(),
    websocket_stream_expected(),
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(secure_random_with_deterministic(
    websocket_stream_entropy(),
    () => http_client_with_replay(fixture, websocket_stream_exchange)
  ), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
  Test.assert_eq(http_replay_stats(fixture).releases, 0)
  Test.assert_eq(http_replay_stats(fixture).errors, 0)
}

test "owned WebSocket stream decodes an empty control frame without over-reading" {
  let fixture = http_replay_fixture(
    websocket_stream_control_input(),
    bytes_from_str("GET /chat HTTP/1.1\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\nhost: example.com\r\n\r\n"),
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(secure_random_with_deterministic(
    bytes_from_str("the sample nonce"),
    () => http_client_with_replay(fixture, websocket_stream_control_exchange)
  ), 0)
  Test.assert_eq(http_replay_stats(fixture).closes, 1)
  Test.assert_eq(http_replay_stats(fixture).errors, 0)
}
