use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, bytes_concat}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpRequestHead}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestFailed, HttpClientRequestReady, HttpClientUpgradeFailed, HttpClientUpgradeReady}
use stdlib/http/replay as http_replay
use stdlib/http/replay.{HttpReplayFixture, HttpReplayReadComplete, HttpReplayWriteComplete, http_client_with_replay}
use stdlib/http/stream as http_stream
use stdlib/http/stream.{HttpBodyFinishCloseFailed, HttpBodyFinishFailed, HttpBodyFinished, HttpBodyFinishedClosed, HttpBodyIO}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportIO, HttpTransportRelease}
use stdlib/result.{Err, Ok, Result}
use stdlib/secure_random.{SecureRandom, SecureRandomError, secure_random_with_deterministic}
use stdlib/websocket as websocket
use stdlib/websocket.{WebSocketBinaryContent, WebSocketClientUpgrade, WebSocketControlContent, WebSocketControlPing, WebSocketRandom, WebSocketText, WebSocketTextContent}
use stdlib/websocket/stream as websocket_stream
use stdlib/websocket/stream.{WebSocketStreamControl, WebSocketStreamFrame, WebSocketStreamFrameReadFailed, WebSocketStreamFrameStopped, WebSocketStreamOpen, WebSocketStreamOpenFailed, WebSocketStreamPayload, WebSocketStreamPayloadEnd, WebSocketStreamPayloadReadFailed, WebSocketStreamPayloadRejected, WebSocketStreamPayloadStopped, WebSocketStreamProtocol, WebSocketStreamWriteRejected, WebSocketStreamWriteStopped, WebSocketStreamWrote, WebSocketStreamWrongRole}
use stdlib/url as url

fn websocket_stream_request(upgrade: WebSocketClientUpgrade) -> HttpRequestHead {
  let headers = upgrade.headers().append(
    http.header(
      http.parse_field_name("Host").unwrap(),
      bytes.from_str("example.com")
    ).unwrap()
  )
  http.request(
    HttpGet,
    http.parse_request_target("/chat").unwrap(),
    Http11,
    headers,
    http.default_limits()
  ).unwrap()
}

fn websocket_stream_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>, SecureRandom]> i64 {
  let upgrade = websocket.client_upgrade().unwrap()
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/chat").unwrap(),
    websocket_stream_request(upgrade),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinishedClosed -> 2
      HttpBodyFinishFailed(returned, error) -> 3
      HttpBodyFinishCloseFailed(error) -> 4
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientUpgradeFailed(error) -> 5
        HttpClientUpgradeReady(response, connection) -> match websocket_stream.client(
          connection,
          upgrade,
          response,
          websocket.default_limits()
        ) {
          WebSocketStreamOpenFailed(returned, error) -> 6
          WebSocketStreamOpen(stream) -> match stream.next() {
            WebSocketStreamFrameReadFailed(returned, error) -> 7
            WebSocketStreamFrameStopped(returned, error) -> 8
            WebSocketStreamFrame(frame, header, WebSocketTextContent) -> match frame.read(
              __i64_to_usize(0)
            ) {
              WebSocketStreamPayloadRejected(returned, error) -> match returned.read(
                __i64_to_usize(2)
              ) {
                WebSocketStreamPayload(next, first) -> if first.to_utf8().unwrap() != "H" { 9 }
                else { match next.read(__i64_to_usize(3)) {
                  WebSocketStreamPayload(last_frame, middle) -> if middle.to_utf8().unwrap() != "el" { 10 }
                  else { match last_frame.read(__i64_to_usize(3)) {
                      WebSocketStreamPayloadEnd(stream, last) -> if last.to_utf8().unwrap() != "lo" { 11 }
                      else { match stream.client_write_frame(
                          true,
                          WebSocketText,
                          bytes.from_str("Yo")
                        ) {
                          WebSocketStreamWrote(returned) -> match returned.close() {
                            Ok(done) -> 0
                            Err(error) -> 12
                          }
                          WebSocketStreamWriteRejected(returned, WebSocketStreamWrongRole(role)) -> 19
                          WebSocketStreamWriteRejected(returned, WebSocketStreamProtocol(WebSocketRandom(error))) -> 20
                          WebSocketStreamWriteRejected(returned, error) -> 21
                          WebSocketStreamWriteStopped(returned, error) -> 14
                        } }
                      _ -> 15
                    } }
                  _ -> 16
                } }
                _ -> 17
              }
              _ -> 22
            }
            _ -> 18
          }
        }
      }
    }
  }
}

fn websocket_stream_entropy() -> Bytes {
  let mask = [__i64_to_u8(1), __i64_to_u8(2), __i64_to_u8(3), __i64_to_u8(4)]
  bytes_concat(bytes.from_str("the sample nonce"), bytes.from_slice(mask[..]))
}

fn websocket_stream_control_exchange(
) -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>, SecureRandom]> i64 {
  let upgrade = websocket.client_upgrade().unwrap()
  match HttpClient<HttpReplayTransportState>.begin(
    url.parse("https://example.com/chat").unwrap(),
    websocket_stream_request(upgrade),
    http.default_limits()
  ) {
    HttpClientRequestFailed(error) -> 1
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.upgrade(
        connection,
        HttpGet,
        http.default_limits()
      ) {
        HttpClientUpgradeFailed(error) -> 2
        HttpClientUpgradeReady(response, connection) -> match websocket_stream.client(
          connection,
          upgrade,
          response,
          websocket.default_limits()
        ) {
          WebSocketStreamOpenFailed(returned, error) -> 3
          WebSocketStreamOpen(stream) -> match stream.next() {
            WebSocketStreamFrame(frame, header, WebSocketControlContent) -> match frame.read(
              __i64_to_usize(1)
            ) {
              WebSocketStreamControl(returned, WebSocketControlPing(payload)) -> if payload.len() != 0 { 4 }
              else { match returned.close() {
                  Ok(done) -> 0
                  Err(error) -> 5
                } }
              _ -> 6
            }
            _ -> 7
          }
        }
      }
      _ -> 8
    }
  }
}

fn websocket_stream_input() -> Bytes {
  let frame = [__i64_to_u8(129), __i64_to_u8(5)]
  bytes_concat(
    bytes_concat(
      bytes.from_str("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"),
      bytes.from_slice(frame[..])
    ),
    bytes.from_str("Hello")
  )
}

fn websocket_stream_expected() -> Bytes {
  let frame = [
    __i64_to_u8(129), __i64_to_u8(130), __i64_to_u8(1), __i64_to_u8(2),
    __i64_to_u8(3), __i64_to_u8(4), __i64_to_u8(88), __i64_to_u8(109)
  ]
  bytes_concat(
    bytes.from_str("GET /chat HTTP/1.1\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\nhost: example.com\r\n\r\n"),
    bytes.from_slice(frame[..])
  )
}

fn websocket_stream_control_input() -> Bytes {
  let frame = [__i64_to_u8(137), __i64_to_u8(0)]
  bytes_concat(
    bytes.from_str("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"),
    bytes.from_slice(frame[..])
  )
}

test "owned WebSocket stream crosses 101 and preserves bounded frame backpressure" {
  let fixture = http_replay.fixture(
    websocket_stream_input(),
    websocket_stream_expected(),
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(secure_random_with_deterministic(
    websocket_stream_entropy(),
    () => http_client_with_replay(fixture, websocket_stream_exchange)
  ), 0)
  Test.assert_eq(fixture.stats().closes, 1)
  Test.assert_eq(fixture.stats().releases, 0)
  Test.assert_eq(fixture.stats().errors, 0)
}

test "owned WebSocket stream decodes an empty control frame without over-reading" {
  let fixture = http_replay.fixture(
    websocket_stream_control_input(),
    bytes.from_str("GET /chat HTTP/1.1\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\nhost: example.com\r\n\r\n"),
    __i64_to_usize(2),
    __i64_to_usize(2),
    HttpReplayReadComplete,
    HttpReplayWriteComplete
  ).unwrap()
  Test.assert_eq(secure_random_with_deterministic(
    bytes.from_str("the sample nonce"),
    () => http_client_with_replay(fixture, websocket_stream_control_exchange)
  ), 0)
  Test.assert_eq(fixture.stats().closes, 1)
  Test.assert_eq(fixture.stats().errors, 0)
}
