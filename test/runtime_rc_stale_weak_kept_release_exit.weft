-- Expected exit code: 102
-- A weak observer keeps a block allocated after its last strong release, with
-- a strong count of zero. A further strong release has no stake to consume.

use runtime/rc.{rc_default_alloc, rc_default_release, rc_default_weak_retain}

fn main() -> i64 {
  let block: i64 = rc_default_alloc(8, 8)
  rc_default_weak_retain(block)
  rc_default_release(block)
  rc_default_release(block)
  0
}
