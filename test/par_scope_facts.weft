use compiler/typeck.{*}
use compiler/type_registry.{*}
use compiler/module.{*}
use compiler/pipeline.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}

fn scope_declaration(table: i64, source: i64, name: str) -> i64 {
  module_decl_fact_find(table, source, module_decl_namespace_value(), __str_ptr(name), 0, __str_len(name))
}

test "parallel scope facts carry callback positions from exact SDK declarations" {
  let text = "use stdlib/par as policy fn main() -> i64 { 0 }"
  let typed = probe_check_source_with_origin(__str_ptr(text), __str_len(text), 1, 0)
  match typed {
    TypedModule(functions, source, table) -> {
      let module = module_fact_find_path(table, __str_ptr("stdlib/par"), __str_len("stdlib/par"), 0)
      Test.assert_true(module != 0)
      let origin = module_fact_entry_source(module)
      match typeck_par_decl_role(scope_declaration(table, origin, "with_sequential")) {
        ParCallScopeSequential(body_index) -> Test.assert_eq(body_index, 0)
        _ -> Test.assert_true(false)
      }
      match typeck_par_decl_role(scope_declaration(table, origin, "with_pool")) {
        ParCallScopePool(body_index) -> Test.assert_eq(body_index, 1)
        _ -> Test.assert_true(false)
      }
      match typeck_par_decl_role(scope_declaration(table, origin, "fork")) {
        ParCallFork -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
      match typeck_par_decl_role(scope_declaration(table, origin, "map")) {
        ParCallMap -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
    }
  }
}

test "same-spelled ordinary functions never acquire parallel scope facts" {
  let text = "fn with_pool(config: i64, body: () -> i64) -> i64 { body() } fn with_sequential(body: () -> i64) -> i64 { body() } fn main() -> i64 { with_pool(0, () => with_sequential(() => 42)) }"
  let typed = probe_check_source_with_origin(__str_ptr(text), __str_len(text), 1, 0)
  match typed {
    TypedModule(functions, source, table) -> {
      for name in ["with_pool", "with_sequential", "main"] {
        let declaration = scope_declaration(table, source, name)
        Test.assert_true(declaration != 0)
        match typeck_par_decl_role(declaration) {
          ParCallNone -> Test.assert_true(true)
          _ -> Test.assert_true(false)
        }
      }
      match typeck_par_decl_role(0) {
        ParCallNone -> Test.assert_true(true)
        _ -> Test.assert_true(false)
      }
    }
  }
}
