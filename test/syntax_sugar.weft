-- test/syntax_sugar.weft — pipes, for loops, if-let, string interpolation, optional chaining, loop

use stdlib/list as list
use stdlib/list.{*}
use stdlib/iter as iter

-- Helpers for pipe tests
fn double(x: i64) -> i64 { x * 2 }
fn inc(x: i64) -> i64 { x + 1 }
fn add(x: i64, n: i64) -> i64 { x + n }
fn add3(a: i64, b: i64, c: i64) -> i64 { a + b + c }
fn id(x: i64) -> i64 { x }
fn pipe_sum(acc: i64, x: i64) -> i64 { acc + x }
fn pipe_list_map<T, U>(values: List<T>, f: (T) -> U) -> List<U> { values.map<U>(f) }
fn pipe_list_fold<T, A>(values: List<T>, init: A, f: (A, T) -> A) -> A { values.fold<A>(init, f) }

-- Pipes
test "pipe_unary" { Test.assert_eq(21 |> double(), 42) }
test "pipe_extra_args" { Test.assert_eq(20 |> add(22), 42) }
test "pipe_chain" { Test.assert_eq(20 |> inc() |> double(), 42) }
test "pipe_bare_fn" { Test.assert_eq(21 |> double, 42) }
test "pipe_from_expr" { let x = 10 + 11 Test.assert_eq(x |> double(), 42) }
test "pipe_three_args" { Test.assert_eq(10 |> add3(12, 20), 42) }
test "pipe_in_let" { let r = 21 |> double() Test.assert_eq(r, 42) }
test "pipe_5_deep" { Test.assert_eq(37 |> inc() |> inc() |> inc() |> inc() |> inc(), 42) }
test "pipe_zero" { Test.assert_eq(0 |> id(), 0) }
test "pipe_prec" { Test.assert_eq(40 + 2 |> id(), 42) }
test "pipe_generic_call_chain" { Test.assert_eq(list.range(0, 5) |> pipe_list_map<i64, i64>(double) |> pipe_list_fold<i64, i64>(0, pipe_sum), 20) }
test "pipe_qualified_call" { Test.assert_eq_usize((1 |> list.range(4)).len(), 3) }
test "pipe_qualified_generic_call_chain" {
  Test.assert_eq(
    iter.range(0, 5)
      |> iter.map(double)
      |> iter.fold(0, pipe_sum),
    20
  )
}
test "pipe_multiline_chain" {
  Test.assert_eq(
    20
      |> inc()
      |> double(),
    42
  )
}
test "pipe_generic_call_multiline_chain" {
  Test.assert_eq(
    list.range(0, 5)
      |> pipe_list_map<i64, i64>(double)
      |> pipe_list_fold<i64, i64>(0, pipe_sum),
    20
  )
}

-- For loops
test "for_basic" { let mut s: i64 = 0 for i in 0..42 { s = s + 1 } Test.assert_eq(s, 42) }
test "for_sum" { let mut s: i64 = 0 for i in 0..5 { s = s + i } Test.assert_eq(s, 10) }
test "for_nonzero_start" { let mut s: i64 = 0 for i in 10..14 { s = s + 1 } Test.assert_eq(s + 38, 42) }
test "for_var_end" { let n = 42 let mut s: i64 = 0 for i in 0..n { s = s + 1 } Test.assert_eq(s, 42) }
test "for_nested" { let mut s: i64 = 0 for i in 0..6 { for j in 0..7 { s = s + 1 } } Test.assert_eq(s, 42) }
test "for_use_index" { let mut last: i64 = 0 for i in 0..43 { last = i } Test.assert_eq(last, 42) }
test "for_zero_iter" { let mut s: i64 = 0 for i in 0..0 { s = 99 } Test.assert_eq(s, 0) }
test "for_one_iter" { let mut s: i64 = 0 for i in 0..1 { s = 42 } Test.assert_eq(s, 42) }
test "for_100" { let mut s: i64 = 0 for i in 0..100 { s = s + 1 } Test.assert_eq(s, 100) }
test "for_index_shadow_mut" {
  let mut s: i64 = 0
  for i in 0..7 {
    let mut i = 0
    i = i + 6
    s = s + i
  }
  Test.assert_eq(s, 42)
}

test "if_no_else_assign" {
  let mut r: i64 = 0
  if true { r = 42 }
  Test.assert_eq(r, 42)
}

test "if_no_else_discards_value" {
  let mut r: i64 = 42
  if true { 99 }
  Test.assert_eq(r, 42)
}

-- If-let
type Opt { Some(i64), None }

test "iflet_ctor" {
  let x = Some(42)
  Test.assert_eq(if let Some(v) = x { v } else { 0 }, 42)
}
test "iflet_else" {
  let x = None
  Test.assert_eq(if let Some(v) = x { v } else { 42 }, 42)
}
test "iflet_int" {
  let x = 42
  Test.assert_eq(if let 42 = x { 42 } else { 0 }, 42)
}
test "iflet_bind" {
  let x = 42
  Test.assert_eq(if let v = x { v } else { 0 }, 42)
}
test "iflet_no_else" {
  let x = Some(42)
  let mut r: i64 = 0
  if let Some(v) = x { r = v }
  Test.assert_eq(r, 42)
}
test "iflet_no_else_discards_value" {
  let x = Some(99)
  let mut r: i64 = 42
  if let Some(v) = x { v }
  Test.assert_eq(r, 42)
}
test "iflet_nested" {
  let x = Some(42)
  Test.assert_eq(
    if let Some(v) = x {
      if let 42 = v { 42 } else { 0 }
    } else { 0 },
    42
  )
}
test "iflet_wildcard" {
  let x = 42
  Test.assert_eq(if let _ = x { 42 } else { 0 }, 42)
}

-- Loop expression
test "loop_basic" {
  let mut i = 0
  loop {
    i = i + 1
    if i == 42 { break(i) } else { 0 }
  }
  Test.assert_eq(i, 42)
}
test "loop_break_val" {
  let r = loop {
    break(42)
  }
  Test.assert_eq(r, 42)
}
