use stdlib/list as list
use stdlib/list.{List}
use stdlib/option
use stdlib/string
use stdlib/vector as vector
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count}

type ListPoint { x: i64, y: i64 }

type ListNestedRow {
  values: List<i64>,
}

fn list_from_scoped_values(value: RuntimeRcProbe) -> List<RuntimeRcProbe> {
  let source = [value, value]
  list.from_slice(source[..])
}

test "slice construction preserves empty singleton and repeated values" {
  let empty: [i64; 0] = []
  let singleton = [42]
  let values = [3, -1, 3, 9223372036854775807, -9223372036854775808]
  Test.assert_true(list.from_slice(empty[..]).is_empty())
  Test.assert_eq(list.from_slice(singleton[..]).first().unwrap(), 42)
  let result = list.from_slice(values[..])
  Test.assert_true(result.len() == 5)
  Test.assert_eq(result.get(0).unwrap(), 3)
  Test.assert_eq(result.get(1).unwrap(), -1)
  Test.assert_eq(result.get(2).unwrap(), 3)
  Test.assert_eq(result.get(3).unwrap(), 9223372036854775807)
  Test.assert_eq(result.get(4).unwrap(), -9223372036854775808)
  Test.assert_true(result.get(5).is_none())
}

test "every slice boundary preserves exactly the selected source order" {
  let source = [7, -3, 0, 9]
  let zero: usize = 0
  let bound: usize = 5
  for start in zero..bound {
    for end in start..bound {
      let values = list.from_slice(source[start..end])
      Test.assert_true(values.len() == end - start)
      for offset in zero..end - start {
        Test.assert_eq(values.get(offset).unwrap(), source[start + offset])
      }
    }
  }
}

test "constructed list values survive the source owner and release exactly once" {
  let value = runtime_rc_probe_new(7)
  {
    let copied = list_from_scoped_values(value)
    Test.assert_eq(runtime_rc_probe_count(value), 3)
    Test.assert_eq(runtime_rc_probe_load(copied.get(0).unwrap()), 7)
    Test.assert_eq(runtime_rc_probe_load(copied.get(1).unwrap()), 7)
    Test.assert_eq(runtime_rc_probe_count(value), 3)
  }
  Test.assert_eq(runtime_rc_probe_count(value), 1)
}

test "slice construction preserves records with managed collection fields" {
  let first_values = [20, 22]
  let second_values = [42]
  let rows = [
    ListNestedRow { values: list.from_slice(first_values[..]) },
    ListNestedRow { values: list.from_slice(second_values[..]) },
  ]
  let copied = list.from_slice(rows[..])
  Test.assert_eq_usize(copied.len(), 2)
  Test.assert_eq(copied.get(0).unwrap().values.get(0).unwrap() + copied.get(0).unwrap().values.get(1).unwrap(), 42)
  Test.assert_eq(copied.get(1).unwrap().values.get(0).unwrap(), 42)
}

test "source mutation preserves the persistent list snapshot" {
  let mut source = [10, 20, 30]
  let values = list.from_slice(source[..])
  source[0] = 99
  source[2] = -1
  Test.assert_eq(values.get(0).unwrap(), 10)
  Test.assert_eq(values.get(2).unwrap(), 30)
  Test.assert_eq(source[0], 99)
  Test.assert_eq(source[2], -1)
}

test "slice construction retains allocated Unicode text" {
  let first = "Ω".repeat(3)
  let second = "weft".repeat(2)
  let source = [first, second, ""]
  let values = list.from_slice(source[..])
  Test.assert_true(values.get(0).unwrap() == "ΩΩΩ")
  Test.assert_true(values.get(1).unwrap() == "weftweft")
  Test.assert_true(values.get(2).unwrap() == "")
}

test "slice construction preserves float and record element layouts" {
  let floats = [1.25, -2.5, 0.0]
  let float_values = list.from_slice(floats[..])
  Test.assert_true(float_values.get(0).unwrap() == 1.25)
  Test.assert_true(float_values.get(1).unwrap() == -2.5)
  let points = [ListPoint { x: 3, y: 4 }, ListPoint { x: -1, y: 8 }]
  let point_values = list.from_slice(points[..])
  let first = point_values.get(0).unwrap()
  let second = point_values.get(1).unwrap()
  Test.assert_eq(first.x + first.y, 7)
  Test.assert_eq(second.x + second.y, 7)
}


test "vector views construct long lists in exact order" {
  let mut source = vector.with_capacity<i64>(4096)
  for value in 0..4096 { source.push(value) }
  let values = list.from_slice(source[..])
  Test.assert_true(values.len() == 4096)
  let mut expected = 0
  for value in values {
    Test.assert_eq(value, expected)
    expected = expected + 1
  }
  Test.assert_eq(expected, 4096)
  Test.assert_eq(source.get(4095).unwrap(), 4095)
}
