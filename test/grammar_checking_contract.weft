use stdlib/typecheck.{*}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/semantic_type.{*}
use stdlib/diagnostic.{*}
use stdlib/list.{List, Nil}
use stdlib/option.{Option, None}
use stdlib/result.{Result, Ok, Err}

fn described<I>(identity: I, description: SemanticTypeFact) -> ResolvedType<I> {
  ResolvedType { identity: identity, description: description }
}

fn catalog_type_name<I>(name: str) -> TypeName<I> {
  TypeName { qualifier: None<str>(), name: name, arguments: Nil<I>() }
}

fn inspect_row<I>() -[TypeCheck<I>]> bool {
  let request = TypeName { qualifier: None<str>(), name: "Row", arguments: Nil<I>() }
  match TypeCheck<I>.resolve(request) {
    Ok(row) -> match TypeCheck<I>.field(row.identity, NamedTypeField("value")) {
      Ok(value) -> match value.description {
        SemanticTypePrimitive(name) -> name == "i64"
        _ -> false
      }
      Err(_) -> false
    }
    Err(_) -> false
  }
}

fn is_value_field(field: TypeField) -> bool {
  match field {
    NamedTypeField(name) -> name == "value"
    _ -> false
  }
}

fn run_catalog<R, E>(body: () -[TypeCheck<str>, E]> R) -[E]> R {
  handle body() {
    TypeCheck<str>.resolve(request) -> resume(if request.name == "Row" {
      Ok<ResolvedType<str>, TypeQueryError>(described("row", SemanticTypeNamed("Row", SemanticTypeFactListNil)))
    } else { Err<ResolvedType<str>, TypeQueryError>(TypeNotFound) })
    TypeCheck<str>.field(base, field) -> resume(if base == "row" and is_value_field(field) {
      Ok<ResolvedType<str>, TypeQueryError>(described("integer", SemanticTypePrimitive("i64")))
    } else { Err<ResolvedType<str>, TypeQueryError>(TypeFieldNotFound) })
    TypeCheck<str>.fields(base) -> resume(if base == "row" {
      Ok<List<ResolvedField<str>>, TypeQueryError>(Cons(ResolvedField {
        selector: NamedTypeField("value"),
        value: described("integer", SemanticTypePrimitive("i64"))
      }, Nil<ResolvedField<str>>()))
    } else { Err<List<ResolvedField<str>>, TypeQueryError>(TypeFieldsUnavailable) })
    TypeCheck<str>.subtype(actual, expected) -> resume(Ok<bool, TypeQueryError>(actual == expected))
  }
}

type CatalogSyntax { table: str }
type CatalogPlan { table: str, row: SemanticTypeFact }
type CatalogGrammar { CatalogGrammar }

type WideSyntax { WideSyntax(i64, i64, i64) }
type WidePlan { WidePlan(i64, i64, i64) }
type WideGrammar { WideGrammar }

impl CheckedGrammar for WideGrammar {
  type Syntax = WideSyntax
  type Checked = WidePlan
  type Identity = str

  fn check(self, syntax: WideSyntax) -[TypeCheck<str>, Diagnose]> CheckResult<WidePlan> {
    match syntax { WideSyntax(first, second, third) -> Checked(WidePlan(first, second, third)) }
  }
}

impl CheckedGrammar for CatalogGrammar {
  type Syntax = CatalogSyntax
  type Checked = CatalogPlan
  type Identity = str

  fn check(self, syntax: CatalogSyntax) -[TypeCheck<str>, Diagnose]> CheckResult<CatalogPlan> {
    match TypeCheck<str>.resolve(catalog_type_name<str>(syntax.table)) {
      Ok(row) -> Checked(CatalogPlan { table: syntax.table, row: row.description })
      Err(_) -> {
        Diagnose.report(uncoded(DiagnosticSeverityError, DiagnosticClassType, "catalog table is not visible", DiagnosticLocationNone))
        CheckRejected<CatalogPlan>()
      }
    }
  }
}

fn check_with<G: CheckedGrammar>(grammar: G, syntax: G.Syntax) -[TypeCheck<G.Identity>, Diagnose]> CheckResult<G.Checked> {
  grammar.check(syntax)
}

fn discard_diagnostics<R, E>(body: () -[Diagnose, E]> R) -[E]> R {
  handle body() {
    Diagnose.report(diagnostic) -> resume(0)
    Diagnose.error(message, position) -> resume(0)
    Diagnose.warn(message, position) -> resume(0)
    Diagnose.note(message, position) -> resume(0)
  }
}

test "generic type facts retain grammar-owned opaque identity parameters" {
  Test.assert_true(run_catalog(() => inspect_row<str>()))
}

test "type-query handling preserves residual test authority" {
  run_catalog(() => {
    Test.assert_true(inspect_row<str>())
    Test.assert_true(match TypeCheck<str>.subtype("row", "row") { Ok(answer) -> answer, _ -> false })
    0
  })
}

test "type-query handlers expose ordered record fields" {
  run_catalog(() => match TypeCheck<str>.fields("row") {
    Ok(Cons(field, Nil)) -> Test.assert_true(
      match field.selector { NamedTypeField(name) -> name == "value", _ -> false } and
      match field.value.description { SemanticTypePrimitive(name) -> name == "i64", _ -> false }
    )
    _ -> Test.assert_true(false)
  })
}

test "checked grammars preserve their host identity through the common contract" {
  let result = discard_diagnostics(() => run_catalog(() =>
    check_with<CatalogGrammar>(CatalogGrammar(), CatalogSyntax { table: "Row" })
  ))
  Test.assert_true(match result {
    Checked(plan) -> plan.table == "Row" and match plan.row {
      SemanticTypeNamed(name, _) -> name == "Row"
      _ -> false
    }
    CheckRejected -> false
  })
}

test "checked grammars never expose a plan after host-query rejection" {
  let result = discard_diagnostics(() => run_catalog(() =>
    check_with<CatalogGrammar>(CatalogGrammar(), CatalogSyntax { table: "Missing" })
  ))
  Test.assert_true(match result { CheckRejected -> true, Checked(_) -> false })
}

test "checked grammar calls preserve every lane of associated syntax" {
  let result = discard_diagnostics(() => run_catalog(() =>
    check_with<WideGrammar>(WideGrammar(), WideSyntax(11, 22, 33))
  ))
  Test.assert_true(match result {
    Checked(WidePlan(first, second, third)) -> first == 11 and second == 22 and third == 33
    CheckRejected -> false
  })
}
