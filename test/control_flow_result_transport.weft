use module_fixtures/compiler_probe.{probe_check_source}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{Option}

fn pair(position: i64) -> (List<i64>, i64) { (Cons(42, Nil), position + 1) }

test "conditional tuple calls carry the trailing value across loop iterations" {
  let mut position = 0
  let mut results: List<List<i64>> = Nil
  for attempt in 0..3 {
    let (items, next) = if position == 1 { pair(position) } else { (Nil<i64>(), position + 1) }
    results = Cons(items, results)
    position = next
  }
  Test.assert_eq(position, 3)
  Test.assert_eq_usize(results.len(), 3)
  Test.assert_true(results.get(0).unwrap().is_empty())
  Test.assert_eq(results.get(1).unwrap().first().unwrap(), 42)
  Test.assert_true(results.get(2).unwrap().is_empty())
}

test "while initializers carry tuple results from either conditional branch" {
  for choose_call in [true, false] {
    let mut attempt = 0
    let mut position = 0
    while attempt < 3 {
      let (items, next) = if choose_call { pair(position) } else { (Nil<i64>(), position + 1) }
      Test.assert_eq_usize(items.len(), if choose_call { 1 } else { 0 })
      position = next
      attempt = attempt + 1
    }
    Test.assert_eq(position, 3)
  }
}

fn generic_pair<T>(value: T, position: i64) -> (T, i64) { (value, position + 1) }

test "generic loop initializer results retain managed and scalar values" {
  let text = "retained".concat(" value")
  let mut position = 0
  for attempt in 0..3 {
    let (value, next) = if attempt == 1 { (text, position + 1) }
    else { generic_pair<str>(text, position) }
    Test.assert_str_eq(value, "retained value")
    position = next
  }
  Test.assert_eq(position, 3)
  Test.assert_str_eq(text, "retained value")
}

fn wide(position: i64) -> ([i64; 3], str, i64) { ([3, 5, 7], "wide", position + 1) }

test "nested branch results preserve arrays and trailing fields in loop bindings" {
  let mut position = 0
  for attempt in 0..3 {
    let (values, label, next) = if attempt == 1 { ([3, 5, 7], "wide", position + 1) }
    else { if attempt == 0 { wide(position) } else { wide(position) } }
    Test.assert_eq(values[0] + values[1] + values[2], 15)
    Test.assert_str_eq(label, "wide")
    position = next
  }
  Test.assert_eq(position, 3)
}

test "loop initializer exits do not fabricate a partial tuple value" {
  let mut attempts = 0
  let mut position = 0
  loop {
    attempts = attempts + 1
    let (items, next) = if attempts == 1 { continue }
    else if attempts == 4 { break } else { pair(position) }
    Test.assert_eq(items.first().unwrap(), 42)
    position = next
  }
  Test.assert_eq(attempts, 4)
  Test.assert_eq(position, 2)
}

fn target_arity(blocks: IrBlockList, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> - 1
    IrBlockListCons(IrBlock(id, params, _, _), rest) -> {
      if id == target { ir_value_list_len(params) } else { target_arity(rest, target) }
    }
  }
}

fn bad_edges(blocks: IrBlockList, all: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, _, term), rest) -> {
      let mismatch = match term {
        IrTermJump(target, values) -> if target_arity(all, target) != ir_value_list_len(values) {
          1
        } else { 0 }
        _ -> 0
      }
      mismatch + bad_edges(rest, all)
    }
  }
}

fn bad_function_edges(functions: IrFunctionList) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(IrFunction(_, _, blocks, _), rest) -> bad_edges(blocks, blocks) +
      bad_function_edges(rest)
  }
}

test "conditional tuple results preserve control flow edge arity" {
  let source = "fn pair(p: i64) -> (str, i64) { (\"value\", p + 1) } fn main() -> i64 { let mut p = 0 for attempt in 0..3 { let (items, end) = if p == 1 { pair(p) } else { (\"empty\", p + 1) } p = end } p }"
  let typed = probe_check_source(__str_ptr(source), __str_len(source))
  let lowered = pipeline_lower_ir(typed)
  Test.assert_eq(bad_function_edges(pipeline_ir_functions(lowered)), 0)
  let optimised = pipeline_optimise_typed_ir(typed, lowered)
  Test.assert_eq(bad_function_edges(pipeline_ir_functions(optimised)), 0)
}
