use compiler/ir/data.{*}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_load, runtime_rc_probe_count}

test "block result projection distinguishes an absent tail from explicit nil" {
  Test.assert_true(expr_is_absent(expr_from_node(0)))
  Test.assert_false(expr_is_absent(NilExpr))
  Test.assert_false(expr_is_absent(UnknownExpr(99)))
  match expr_block_result(IntLit(42, 0, 2), UnknownExpr(0)) {
    IntLit(value, _, _) -> Test.assert_eq(value, 42)
    _ -> Test.assert_true(false)
  }
  match expr_block_result(IntLit(42, 0, 2), NilExpr) {
    NilExpr -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match expr_block_result(IntLit(42, 0, 2), UnknownExpr(99)) {
    UnknownExpr(tag) -> Test.assert_eq(tag, 99)
    _ -> Test.assert_true(false)
  }
}

fn nested_product(first: bool) -> (i64, str, f64) {
  if first { { (20, "first", 22.0) } } else { { (21, "second", 21.0) } }
}

test "nested branch blocks retain every scalar and managed result lane" {
  let first = nested_product(true)
  let second = nested_product(false)
  Test.assert_eq(first.0, 20)
  Test.assert_str_eq(first.1, "first")
  Test.assert_eq_f64(first.2, 22.0)
  Test.assert_eq(second.0, 21)
  Test.assert_str_eq(second.1, "second")
  Test.assert_eq_f64(second.2, 21.0)
}

fn nested_reference(first: bool, value: RuntimeRcProbe) -> RuntimeRcProbe {
  if first { { value } } else { { value } }
}

test "nested branch blocks preserve borrowed result ownership" {
  for first in [true, false] {
    let value = runtime_rc_probe_new(42)
    let result = nested_reference(first, value)
    Test.assert_eq(runtime_rc_probe_load(result), 42)
    Test.assert_eq(runtime_rc_probe_count(value), 2)
  }
}

fn nested_float(first: bool) -> f64 { if first { { 20.5 } } else { { 21.5 } } }

test "nested blocks preserve floating-point branch result classification" {
  Test.assert_eq_f64(nested_float(true) + nested_float(false), 42.0)
}

fn nested_nil_value(selected: bool) -> str | nil {
  if selected { "text" } else { if true { 99 } }
}

test "an explicit nil alternative cannot leak a discarded scalar as a nullable value" {
  match nested_nil_value(false) {
    nil -> Test.assert_true(true)
    value: str -> Test.assert_true(false)
  }
  match nested_nil_value(true) {
    value: str -> Test.assert_str_eq(value, "text")
    nil -> Test.assert_true(false)
  }
}
