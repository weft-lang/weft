-- Ownership-transfer facts at generic calls and iterator loop exits.

use compiler/ir.{*}
use compiler/lib.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}

fn owned_call_slot_mode_insts(insts: IrInstList, wanted_mode: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let here = match inst {
        IrStructuralSlotI64(value, slot, plan, mode) -> if mode == wanted_mode { 1 } else { 0 }
        _ -> 0
      }
      here + owned_call_slot_mode_insts(rest, wanted_mode)
    }
  }
}

fn owned_call_slot_mode_blocks(blocks: IrBlockList, wanted_mode: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> owned_call_slot_mode_insts(insts, wanted_mode) +
        owned_call_slot_mode_blocks(rest, wanted_mode)
    }
  }
}

fn owned_call_slot_mode(ir: IrModule, fn_name: str, wanted_mode: i64) -> i64 {
  let wanted = str_hash(__str_ptr(fn_name), 0, __str_len(fn_name))
  match pipeline_ir_function_list_find_hash(pipeline_ir_functions(ir), wanted) {
    IrFunctionNil -> 0 - 1
    IrFunctionCons(fn_ir, rest) -> owned_call_slot_mode_blocks(pipeline_ir_function_blocks(fn_ir), wanted_mode)
  }
}

fn owned_call_slot_mode_functions(functions: IrFunctionList, wanted_mode: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(fn_ir, rest) -> owned_call_slot_mode_blocks(
      pipeline_ir_function_blocks(fn_ir), wanted_mode
    ) + owned_call_slot_mode_functions(rest, wanted_mode)
  }
}

test "qualified generic calls carry owned argument transfer facts" {
  let src = "use stdlib/drop.{*}
use stdlib/iter.{*}
use stdlib/iter as iter
type Token = opaque i64
impl Drop for Token { fn drop(self: i64) -> i64 { 0 } }
fn pass<N>(value: owned Token, ignored: N) -> owned Token { value }
fn explicit_call(token: owned Token) -> owned Token { pass<i64>(token, 0) }
fn inferred_call(token: owned Token) -> owned Token { pass(token, 0) }
fn qualified_call(iterator: owned Iterator<i64>) -> owned Iterator<i64> {
  iter.take(iterator, 1)
}
fn main() -> i64 { 0 }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  Test.assert_eq(owned_call_slot_mode(ir, "explicit_call", 3), 1)
  Test.assert_eq(owned_call_slot_mode(ir, "inferred_call", 3), 1)
  Test.assert_eq(owned_call_slot_mode(ir, "qualified_call", 3), 1)
}

test "destructuring for exits preserve the iterator drop obligation" {
  let src = "use stdlib/map as map
fn f(mode: i64) -> i64 {
  let values = map.new<i64, i64>().insert(10, 1).insert(20, 2)
  for (key, value) in values {
    if mode == 1 { break } else { 0 }
    if mode == 2 { return key + value } else { 0 }
  }
  0
}
fn main() -> i64 { 0 }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  -- The shared fallthrough/break exit and the direct return each drop the
  -- owned iterator slot. The synthetic tuple binder must not shadow it.
  Test.assert_eq(owned_call_slot_mode(ir, "f", 4), 2)
}

test "generic borrowed iterator receiver preserves scope cleanup" {
  let src = "use stdlib/iter.{*}
use stdlib/iter as iter
use stdlib/option.{*}
fn first_like<S: IntoIterator>(input: S) -> bool {
  let mut source = input.into_iter()
  match source.next() { Some(value) -> true None -> false }
}
fn main() -> i64 { if first_like(iter.range(0, 2)) { 1 } else { 0 } }
"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let functions = pipeline_typed_optimisation_prefix_functions(pipeline_typed_optimisation_prefix(typed, ir))
  Test.assert_eq(if owned_call_slot_mode_functions(functions, 4) >= 1 { 1 } else { 0 }, 1)
}
