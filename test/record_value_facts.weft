use compiler/weft/products.{TypedModule}
use compiler/pipeline.{*}
use compiler/ir/data.{*}
use compiler/backend/aarch64/codegen.{*}
use compiler/weft/check/table.{str_hash}
use compiler/types/algebra.{ty_named, ty_i64}
use compiler/storage.{*}
use runtime/memory.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}

fn record_value_hash(name: str) -> i64 { str_hash(__str_ptr(name), 0, __str_len(name)) }

fn record_value_table() -> i64 {
  let source = "type Reading { x: f64, y: f64 } type Packed { byte: u8, value: f32, signed: i16, wide: u64 } type Managed { x: str, y: i64 } type Chain { End, Link(i64, Chain) } type Recursive { child: Chain } fn main() -> i64 { 0 }"
  match probe_check_source_with_origin(__str_ptr(source), __str_len(source), 1, 0) {
    TypedModule(_, _, tt, owners) -> tt
  }
}

fn record_value_constructor(dst: i64, hash: i64, first: i64, second: i64) -> IrInst {
  IrRecordInitI64(dst, hash, IrRecordFieldCons(record_value_hash("x"), 0, first,
    IrRecordFieldCons(record_value_hash("y"), 1, second, IrRecordFieldNil)))
}

fn record_value_prefix(hash: i64, tail: IrInstList) -> IrInstList {
  IrInstCons(IrConstI64(0, 1), IrInstCons(IrConstI64(1, 2),
    IrInstCons(record_value_constructor(2, hash, 0, 1), tail)))
}

fn record_value_rewrite(insts: IrInstList, term: IrTerminator) -> IrBlockList {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, term), IrBlockListNil)
  pipeline_ir_record_apply_values(pipeline_ir_record_value_facts(blocks, record_value_table(), 0))
}

fn record_value_count(blocks: IrBlockList, tag: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(IrBlock(_, _, insts, _), rest) -> ir_inst_list_count_tag(insts, tag) + record_value_count(rest, tag)
  }
}

test "fresh scalar record projections and unused cleanup need no box" {
  let insts = record_value_prefix(record_value_hash("Reading"),
    IrInstCons(IrFieldLoadI64(3, 2, record_value_hash("x"), 0),
      IrInstCons(IrManagedStakeI64(4, 2, 1, -1, 0), IrInstNil)))
  let blocks = record_value_rewrite(insts, IrTermReturn(3))
  Test.assert_eq(record_value_count(blocks, 10), 0)
  Test.assert_eq(record_value_count(blocks, 11), 0)
  Test.assert_eq(record_value_count(blocks, 50), 0)
  match blocks {
    IrBlockListCons(IrBlock(_, _, _, IrTermReturn(value)), _) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
}

test "escaping record returns retain the canonical representation" {
  let blocks = record_value_rewrite(record_value_prefix(record_value_hash("Reading"), IrInstNil), IrTermReturn(2))
  Test.assert_eq(record_value_count(blocks, 10), 1)
}

test "unknown calls retain record identity and its cleanup" {
  let insts = record_value_prefix(record_value_hash("Reading"),
    IrInstCons(IrCallI64(3, 99, IrValueCons(2, IrValueNil)),
      IrInstCons(IrManagedStakeI64(4, 2, 1, -1, 0), IrInstNil)))
  let blocks = record_value_rewrite(insts, IrTermReturn(3))
  Test.assert_eq(record_value_count(blocks, 10), 1)
  Test.assert_eq(record_value_count(blocks, 50), 1)
}

test "observed stake results prevent record cleanup erasure" {
  let insts = record_value_prefix(record_value_hash("Reading"), IrInstCons(IrManagedStakeI64(3, 2, 1, 1, 0), IrInstNil))
  let blocks = record_value_rewrite(insts, IrTermReturn(3))
  Test.assert_eq(record_value_count(blocks, 10), 1)
  Test.assert_eq(record_value_count(blocks, 50), 1)
}

test "managed and unresolved record layouts cannot prove scalar replacement" {
  for name in ["Managed", "Unresolved"] {
    let blocks = record_value_rewrite(record_value_prefix(record_value_hash(name),
      IrInstCons(IrFieldLoadI64(3, 2, record_value_hash("x"), 0), IrInstNil)), IrTermReturn(3))
    Test.assert_eq(record_value_count(blocks, 10), 1)
  }
}

test "dominating record snapshots can be projected in successor blocks" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    record_value_prefix(record_value_hash("Reading"), IrInstNil), IrTermJump(1, IrValueNil)),
    IrBlockListCons(IrBlock(1, IrValueNil,
      IrInstCons(IrFieldLoadI64(3, 2, record_value_hash("y"), 1),
        IrInstCons(IrManagedStakeI64(4, 2, 1, -1, 0), IrInstNil)), IrTermReturn(3)), IrBlockListNil))
  let result = pipeline_ir_record_apply_values(pipeline_ir_record_value_facts(blocks, record_value_table(), 0))
  Test.assert_eq(record_value_count(result, 10), 0)
  Test.assert_eq(record_value_count(result, 11), 0)
}

test "unsupported record joins remain materialized" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil,
    record_value_prefix(record_value_hash("Reading"), IrInstNil), IrTermJump(1, IrValueCons(2, IrValueNil))),
    IrBlockListCons(IrBlock(1, IrValueCons(3, IrValueNil),
      IrInstCons(IrFieldLoadI64(4, 3, record_value_hash("y"), 1), IrInstNil), IrTermReturn(4)), IrBlockListNil))
  let result = pipeline_ir_record_apply_values(pipeline_ir_record_value_facts(blocks, record_value_table(), 0))
  Test.assert_eq(record_value_count(result, 10), 1)
}

test "packed record facts distinguish value words from indexed byte offsets" {
  match cg_layout_plain_record(record_value_table(), ty_named(record_value_hash("Packed"), ty_i64())) {
    CgPlainRecordLayout(_, CgPlainRecordField(_, 0, 0, IrStorageU8,
      CgPlainRecordField(_, 1, 4, IrStorageU32,
        CgPlainRecordField(_, 2, 8, IrStorageI16,
          CgPlainRecordField(_, 3, 16, IrStorageWord64, CgPlainRecordFieldsNil))))) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "recursive managed fields are rejected before inline layout expansion" {
  match cg_layout_plain_record(record_value_table(), ty_named(record_value_hash("Recursive"), ty_i64())) {
    CgPlainRecordUnavailable -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
}

test "record decisions account for every selected and retained constructor" {
  let reading = record_value_hash("Reading")
  let fields = IrRecordFieldCons(record_value_hash("x"), 0, 0, IrRecordFieldNil)
  let insts = record_value_prefix(reading,
    IrInstCons(IrFieldLoadI64(3, 2, record_value_hash("x"), 0),
    IrInstCons(record_value_constructor(4, reading, 0, 1),
    IrInstCons(record_value_constructor(5, record_value_hash("Unknown"), 0, 1),
    IrInstCons(IrRecordInitI64(6, reading, fields), IrInstNil)))))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(4)), IrBlockListNil)
  let facts = pipeline_ir_record_value_facts(blocks, record_value_table(), 0)
  let census = pipeline_ir_record_value_census(facts)
  Test.assert_true(census.scalar == 1)
  Test.assert_true(census.unavailable_layout == 1)
  Test.assert_true(census.incomplete_fields == 1)
  Test.assert_true(census.observed_identity == 1)
  match pipeline_ir_record_value_decision(facts, 2) {
    Some(PipelineIrRecordScalar(fields)) -> Test.assert_eq(ir_record_field_list_len(fields), 2)
    _ -> Test.assert_true(false)
  }
  match pipeline_ir_record_value_decision(facts, 4) {
    Some(PipelineIrRecordMaterialized(PipelineIrRecordIdentityObserved)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match pipeline_ir_record_value_decision(facts, 5) {
    Some(PipelineIrRecordMaterialized(PipelineIrRecordLayoutUnavailable)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match pipeline_ir_record_value_decision(facts, 6) {
    Some(PipelineIrRecordMaterialized(PipelineIrRecordFieldsIncomplete)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match pipeline_ir_record_value_decision(facts, 0) {
    None -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(record_value_count(pipeline_ir_record_apply_values(facts), 10), 3)
}

test "a wholly unsupported record population remains queryable and unchanged" {
  let insts = record_value_prefix(record_value_hash("Managed"), IrInstNil)
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(2)), IrBlockListNil)
  let facts = pipeline_ir_record_value_facts(blocks, record_value_table(), 0)
  let census = pipeline_ir_record_value_census(facts)
  Test.assert_true(census.scalar == 0 and census.unavailable_layout == 1)
  Test.assert_eq(record_value_count(pipeline_ir_record_apply_values(facts), 10), 1)
}

fn record_value_chain_insts(remaining: i64, next: i64, previous: i64) -> IrInstList {
  if remaining == 0 { IrInstNil }
  else {
    IrInstCons(record_value_constructor(next, record_value_hash("Reading"), previous, 1),
      IrInstCons(IrFieldLoadI64(next + 1, next, record_value_hash("x"), 0),
        record_value_chain_insts(remaining - 1, next + 2, next + 1)))
  }
}

test "long projection chains resolve to the original scalar snapshot" {
  let insts = IrInstCons(IrConstI64(0, 42), IrInstCons(IrConstI64(1, 3), record_value_chain_insts(500, 2, 0)))
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(1001)), IrBlockListNil)
  let facts = pipeline_ir_record_value_facts(blocks, record_value_table(), 0)
  Test.assert_true(pipeline_ir_record_value_census(facts).scalar == 500)
  let result = pipeline_ir_record_apply_values(facts)
  Test.assert_eq(record_value_count(result, 10), 0)
  Test.assert_eq(record_value_count(result, 11), 0)
  match result {
    IrBlockListCons(IrBlock(_, _, _, IrTermReturn(value)), _) -> Test.assert_eq(value, 0)
    _ -> Test.assert_true(false)
  }
}
