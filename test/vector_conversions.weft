-- Explicit owning conversions preserve the array/slice/Vector separation:
-- every conversion copies, and Vector -> array succeeds only at exact length.

use stdlib/vector as vector
use stdlib/vector.{*}
use stdlib/num.{*}
use stdlib/option.{*}

type ConversionBox { value: i64 }

fn conversion_i64_vector() -> Vector<i64> {
  let values = vector.new<i64>()
  vector_push<i64>(values, 10)
  vector_push<i64>(values, 20)
  vector_push<i64>(values, 12)
  values
}

fn conversion_copy_slice<T>(values: [T]) -> Vector<T> {
  values.to_vector()
}

fn conversion_exact_generic<T>(values: Vector<T>) -> Option<[T; 2]> {
  values.to_array<2>()
}

fn conversion_temporary_vector() -> Vector<i64> {
  conversion_i64_vector()
}

test "array_to_vector_copies_and_detaches_storage" {
  let mut source = [10, 20, 12]
  let copied = source.to_vector()
  source[0] = 99
  Test.assert_eq(vector_get_in_bounds<i64>(copied, 0) + vector_get_in_bounds<i64>(copied, 1) + vector_get_in_bounds<i64>(copied, 2), 42)
  Test.assert_eq(source[0], 99)
}

test "immutable_and_mutable_slices_copy_to_vector" {
  let mut source = [5, 10, 20, 12]
  let immutable = source[1..]
  let first = conversion_copy_slice<i64>(immutable)
  Test.assert_eq(vector_sum_i64(first, 0), 42)

  let writable: [mut i64] = source[1..]
  let second = writable.to_vector()
  writable[0] = 99
  Test.assert_eq(vector_sum_i64(second, 0), 42)
  Test.assert_eq(source[1], 99)
}

test "empty_array_and_slice_convert_to_empty_vectors" {
  let empty: [i64; 0] = []
  let from_array = empty.to_vector()
  let from_slice = empty[..].to_vector()
  Test.assert_eq(vector_len<i64>(from_array) + vector_len<i64>(from_slice), 0)
}

test "to_vector_preserves_exact_float_width" {
  let source: [f32; 2] = [1.5, 2.5]
  let copied = source.to_vector()
  let sum = num_f32_to_f64(vector_get_in_bounds<f32>(copied, 0)) + num_f32_to_f64(vector_get_in_bounds<f32>(copied, 1))
  Test.assert_eq_f64(sum, 4.0)
}

test "to_vector_copies_managed_and_plain_record_elements" {
  let words = ["we", "ft"]
  let copied_words = words.to_vector()
  Test.assert_str_eq(vector_get_in_bounds<str>(copied_words, 0), "we")
  Test.assert_str_eq(vector_get_in_bounds<str>(copied_words, 1), "ft")

  let boxes = [ConversionBox { value: 20 }, ConversionBox { value: 22 }]
  let copied_boxes = boxes.to_vector()
  Test.assert_eq(vector_get_in_bounds<ConversionBox>(copied_boxes, 0).value + vector_get_in_bounds<ConversionBox>(copied_boxes, 1).value, 42)
}

test "vector_to_array_returns_some_only_at_exact_length" {
  let values = conversion_i64_vector()
  let exact = values.to_array<3>()
  let short = values.to_array<2>()
  let long = values.to_array<4>()
  Test.assert_eq(match exact { Some(array) -> array[0] + array[1] + array[2] None -> 0 }, 42)
  Test.assert_true(short.is_none())
  Test.assert_true(long.is_none())
}

test "vector_to_array_copy_is_independent_of_later_vector_mutation" {
  let values = conversion_i64_vector()
  let copied = values.to_array<3>()
  vector_set<i64>(values, 0, 99)
  Test.assert_eq(match copied { Some(array) -> array[0] + array[1] + array[2] None -> 0 }, 42)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 0), 99)
}

test "zero_length_vector_converts_to_some_empty_array" {
  let values = vector.new<i64>()
  let copied = values.to_array<0>()
  Test.assert_eq(match copied { Some(array) -> if array.len == 0 { 1 } else { 0 } None -> 0 }, 1)
}

test "vector_to_array_preserves_exact_float_width" {
  let values = vector.new<f32>()
  vector_push<f32>(values, 1.5)
  vector_push<f32>(values, 2.5)
  let copied = values.to_array<2>()
  let sum = match copied {
    Some(array) -> num_f32_to_f64(array[0]) + num_f32_to_f64(array[1])
    None -> 0.0
  }
  Test.assert_eq_f64(sum, 4.0)
}

test "vector_to_array_copies_managed_and_plain_record_elements" {
  let words = vector.new<str>()
  vector_push<str>(words, "we")
  vector_push<str>(words, "ft")
  let copied_words = words.to_array<2>()
  Test.assert_eq(match copied_words { Some(array) -> if array[0] == "we" and array[1] == "ft" { 1 } else { 0 } None -> 0 }, 1)

  let boxes = vector.new<ConversionBox>()
  vector_push<ConversionBox>(boxes, ConversionBox { value: 20 })
  vector_push<ConversionBox>(boxes, ConversionBox { value: 22 })
  let copied_boxes = conversion_exact_generic<ConversionBox>(boxes)
  Test.assert_eq(match copied_boxes { Some(array) -> array[0].value + array[1].value None -> 0 }, 42)
}

test "temporary_vector_receiver_is_valid" {
  let copied = conversion_temporary_vector().to_array<3>()
  Test.assert_eq(match copied { Some(array) -> array[0] + array[1] + array[2] None -> 0 }, 42)
}

test "immutable_vector_slice_allows_read_only_array_copy" {
  let values = conversion_i64_vector()
  let view = values[..]
  let copied = values.to_array<3>()
  Test.assert_eq(match copied { Some(array) -> array[0] + array[1] + array[2] + view[0] - 10 None -> 0 }, 42)
}
