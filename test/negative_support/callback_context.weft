pub type CallbackEntry { text: str }

pub type CallbackContextHost { value: CallbackEntry }

impl CallbackContextHost {
  pub fn project<U>(self, callback: (CallbackEntry) -> U) -> U { callback(self.value) }
  pub fn opaque(self, callback: any) -> i64 { 0 }
  pub fn move(self, callback: (unique i64) -> i64) -> i64 { callback(21) }
}
