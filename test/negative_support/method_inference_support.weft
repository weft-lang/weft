pub type InferenceCheckHost<T> { InferenceCheckHost(T) }

pub trait InferenceCheckMarker {
  fn marker(self: Self) -> i64
}

impl InferenceCheckMarker for i64 {
  fn marker(self: i64) -> i64 { self }
}

pub effect InferenceCheckRead {
  fn read() -> i64
}

pub fn inference_check_read(value: i64) -[InferenceCheckRead]> i64 {
  value + InferenceCheckRead.read()
}

impl<T> InferenceCheckHost<T> {
  pub fn choose<A>(self, value: A) -> A { value }
  pub fn same<A>(self, first: A, second: A) -> A { first }
  pub fn combine<A, B>(self, first: A, second: B) -> (A, B) { (first, second) }
  pub fn unused<A>(self) -> i64 { 42 }
  pub fn marked<A: InferenceCheckMarker>(self, value: A) -> i64 { value.marker() }
  pub fn pure<A>(self, value: A, callback: (A) -> i64) -> i64 { callback(value) }
  pub fn observe<A, e>(self, value: A, callback: (A) -[e]> i64) -[e]> i64 { callback(value) }
}
