use "compiler/mini_sql.weft"
use "compiler/grammar.weft"
use "compiler/diagnose.weft"
use "compiler/pipeline.weft"

fn embedded_sql_parse_quiet(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_with_offset_quiet(src: str, host_offset: i64) -> i64 {
  let tt = 0
  handle mini_sql_parse_source_at(__str_ptr(src), __str_len(src), tt, host_offset) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_tokens_quiet(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let tokens = grammar.lex(__str_ptr(src), __str_len(src))
  handle grammar.parse_tokens(tokens, __str_ptr(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_diagnostics(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let count = alloc_bump(8)
  __mem_store64(count, 0)
  handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
  }
  __mem_load64(count)
}

fn embedded_sql_first_parse_span(src: str, host_offset: i64) -> i64 {
  let tt = 0
  let first = alloc_bump(8)
  __mem_store64(first, 0 - 1)
  handle mini_sql_parse_source_at(__str_ptr(src), __str_len(src), tt, host_offset) {
    Diagnose.error(msg, span) -> {
      if __mem_load64(first) < 0 { __mem_store64(first, span) } else { 0 }
      resume(0)
    }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  __mem_load64(first)
}

fn embedded_sql_check_errors(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let query = handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  handle grammar.check(query, __str_ptr(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_check_with_offset_span(src: str, host_offset: i64) -> i64 {
  let tt = 0
  let first = alloc_bump(8)
  __mem_store64(first, 0 - 1)
  let query = embedded_sql_parse_with_offset_quiet(src, host_offset)
  handle mini_sql_check_ast_at(query, __str_ptr(src), tt, host_offset) {
    Diagnose.error(msg, span) -> {
      if __mem_load64(first) < 0 { __mem_store64(first, span) } else { 0 }
      resume(0)
    }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  __mem_load64(first)
}

fn embedded_sql_table_id(src: str) -> i64 {
  let query = embedded_sql_parse_quiet(src)
  mini_sql_table_id(__str_ptr(src), mini_sql_query_table_node(query))
}

test "embedded_sql_parse_single_column" {
  let query = embedded_sql_parse_quiet("select id from users")
  Test.assert_eq(node_tag(query), mini_sql_query_tag())
  Test.assert_eq(mini_sql_query_column_count(query), 1)
  Test.assert_eq(mini_sql_query_star(query), 0)
  Test.assert_eq(mini_sql_query_has_where(query), 0)
  Test.assert_eq(embedded_sql_table_id("select id from users"), mini_sql_table_users())
}

test "embedded_sql_parse_multiple_columns_and_where" {
  let query = embedded_sql_parse_quiet("SELECT id, name FROM users WHERE id = 1")
  Test.assert_eq(mini_sql_query_column_count(query), 2)
  Test.assert_eq(mini_sql_query_has_where(query), 1)
  Test.assert_eq(mini_sql_query_table_len(query), 5)
}

test "embedded_sql_parse_star_projection" {
  let query = embedded_sql_parse_quiet("select * from orders")
  Test.assert_eq(mini_sql_query_star(query), 1)
  Test.assert_eq(mini_sql_query_column_count(query), 0)
  Test.assert_eq(embedded_sql_table_id("select * from orders"), mini_sql_table_orders())
}

test "embedded_sql_parse_tokens_path_matches_source_path" {
  let from_tokens = embedded_sql_parse_tokens_quiet("select id from users")
  let from_source = embedded_sql_parse_quiet("select id from users")
  Test.assert_eq(mini_sql_query_column_count(from_tokens), mini_sql_query_column_count(from_source))
  Test.assert_eq(mini_sql_query_table_len(from_tokens), mini_sql_query_table_len(from_source))
}

test "embedded_sql_parse_sad_paths_report_diagnostics" {
  Test.assert_eq(embedded_sql_parse_diagnostics(""), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id, from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where name = 'unterminated"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where (id = 1"), 1)
}

test "embedded_sql_parse_missing_from_recovers_with_diagnostics" {
  let count = embedded_sql_parse_diagnostics("select id users")
  Test.assert_eq(if count > 0 { 1 } else { 0 }, 1)
}

test "embedded_sql_parse_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_first_parse_span("select id users", 100), 110)
}

test "embedded_sql_check_accepts_catalog_queries" {
  Test.assert_eq(embedded_sql_check_errors("select id, name from users where id = 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id, total from orders where user_id = 7"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name from users where name = 'Ada'"), 0)
}

test "embedded_sql_check_reports_unknown_names" {
  Test.assert_eq(embedded_sql_check_errors("select id from missing"), 1)
  Test.assert_eq(embedded_sql_check_errors("select nope from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where nope = 1"), 1)
}

test "embedded_sql_check_reports_predicate_type_mismatch" {
  Test.assert_eq(embedded_sql_check_errors("select id from users where id = 'not an int'"), 1)
  Test.assert_eq(embedded_sql_check_errors("select active from users where active = 1"), 1)
}

test "embedded_sql_check_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_check_with_offset_span("select nope from users", 200), 207)
}

test "embedded_sql_adversarial_unicode_and_host_collisions" {
  Test.assert_eq(embedded_sql_check_errors("select name from users where name = 'Ω'"), 0)
  let query = embedded_sql_parse_quiet("select fn from type")
  Test.assert_eq(mini_sql_query_column_count(query), 1)
  Test.assert_eq(mini_sql_query_table_len(query), 4)
}

test "embedded_sql_typed_grammar_impls_do_not_shadow_weft_grammar" {
  let src = "fn main() -> i64 { 42 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(pipeline_typed_fns(typed)), 1)
}
