use module_fixtures/compiler_probe.{require_checked}
use compiler/weft/products.{TypedModule}
use compiler/pipeline.{pipeline_check_source_standalone}
use compiler/storage.{nlist_len, nlist_get, node_f2}
use compiler/weft/check/host_types as host_types
use compiler/grammar/registry.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/diagnostic
use stdlib/grammar.{
  Grammar,
  CheckedGrammar,
  ParseResult,
  Parsed,
  Recovered,
  Rejected,
  CheckResult,
  Checked,
  CheckRejected
}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/syntax.{*}
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/schema.{*}
use stdlib/grammar/sql/schema_typecheck as schema_typecheck
use stdlib/grammar/sql/schema_typecheck.{SqlSchemaIdentity}
use stdlib/list as list
use stdlib/list.{List, Nil}
use stdlib/num
use stdlib/option.{Option, Some, None}
use stdlib/result.{Result}
use stdlib/source.{Source, Span}
use stdlib/state as state
use stdlib/state.{State}

type Reports = List<Diagnostic>

fn observe<T, E>(body: () -[Diagnose, E]> T) -[E]> (T, Reports) {
  let (value, reports) = state.run<Reports, T, E>(
    Nil<Diagnostic>(),
    () => handle body() {
      Diagnose.report(report) -> {
        let reports = State<Reports>.get()
        State<Reports>.put(reports.prepend(report))
        resume(0)
      }
    }
  )
  (value, reports.reverse())
}

fn fragment(text: str, offset: i64) -> Span {
  let mut prefix = ""
  for i in 0..offset { prefix = prefix.concat(" ") }
  let source = Source { text: prefix.concat(text), identity: DiagnosticSourceNamed("query.sql") }
  source.span(prefix.len(), source.text.len()).unwrap()
}

fn parsed_query(text: str, offset: i64) -> (ParseResult<SqlSyntax>, Reports) {
  observe(() => sql.grammar().parse(fragment(text, offset)))
}

fn embedded_sql_parse_quiet(text: str) -> SqlSyntax {
  let (parsed, reports) = parsed_query(text, 0)
  match parsed {
    Parsed(syntax) -> syntax
    Recovered(syntax) -> syntax
    Rejected -> {
      let source = fragment("", 0)
      SqlSyntax {
        span: source,
        query: SqlQuery {
          distinct: false,
          selection: SqlSelect(Nil<SqlProjection>()),
          source: SqlSource { table: None<SqlIdentifier>(), alias: None<SqlIdentifier>() },
          joins: Nil<SqlJoinClause>(),
          predicate: None<SqlExpression>(),
          groups: Nil<SqlExpression>(),
          having: None<SqlExpression>(),
          order: Nil<SqlOrder>(),
          limit: None<SqlExpression>(),
          offset: None<SqlExpression>()
        }
      }
    }
  }
}

fn embedded_sql_parse_diagnostics(text: str) -> i64 {
  let (parsed, reports) = parsed_query(text, 0)
  reports.len().to_u64().to_i64_checked().unwrap()
}

fn first_position(reports: Reports) -> i64 {
  match reports.first() {
    Some(report) -> match report.primary() {
      DiagnosticSourceRange(_, start, _) -> start.to_u64().to_i64_checked().unwrap()
      _ -> - 1
    }
    None -> - 1
  }
}

fn embedded_sql_first_parse_span(text: str, offset: i64) -> i64 {
  let (parsed, reports) = parsed_query(text, offset)
  first_position(reports)
}

fn catalog() -> SqlSchema {
  let users = [
    SqlSchemaField { name: "id", value: SqlSchemaInteger },
    SqlSchemaField { name: "name", value: SqlSchemaText },
    SqlSchemaField { name: "active", value: SqlSchemaBoolean }
  ]
  let orders = [
    SqlSchemaField { name: "id", value: SqlSchemaInteger },
    SqlSchemaField { name: "user_id", value: SqlSchemaInteger },
    SqlSchemaField { name: "total", value: SqlSchemaInteger }
  ]
  let tables = [
    SqlSchemaTable { name: "users", fields: list.from_slice(users[..]) },
    SqlSchemaTable { name: "orders", fields: list.from_slice(orders[..]) }
  ]
  SqlSchema { tables: list.from_slice(tables[..]) }
}

fn catalog_check(text: str, offset: i64) -> (CheckResult<SqlPlan<SqlSchemaIdentity>>, Reports) {
  observe(
    () => match sql.grammar().parse(fragment(text, offset)) {
      Parsed(syntax) -> with schema_typecheck(catalog()) {
        sql_check.checker<SqlSchemaIdentity>().check(syntax)
      }
      _ -> CheckRejected<SqlPlan<SqlSchemaIdentity>>()
    }
  )
}

fn embedded_sql_check_rejected(text: str) -> bool {
  let (result, reports) = catalog_check(text, 0)
  match result { Checked(_) -> false, CheckRejected -> true }
}

fn embedded_sql_check_with_offset_span(text: str, offset: i64) -> i64 {
  let (result, reports) = catalog_check(text, offset)
  first_position(reports)
}

fn host_check(
  text: str,
  host_text: str,
  offset: i64
) -> (CheckResult<SqlPlan<host_types.HostTypeIdentity>>, Reports) {
  let host = require_checked(
    pipeline_check_source_standalone(__str_ptr(host_text), __str_len(host_text))
  )
  observe(
    () => match sql.grammar().parse(fragment(text, offset)) {
      Parsed(syntax) -> match host {
        TypedModule(_, source, table, owners) -> host_types.run(
          table,
          source,
          () =>
        sql_check.checker<host_types.HostTypeIdentity>().check(syntax)
        )
      }
      _ -> CheckRejected<SqlPlan<host_types.HostTypeIdentity>>()
    }
  )
}

fn embedded_sql_host_check_rejected(text: str, host_text: str) -> bool {
  let (result, reports) = host_check(text, host_text, 0)
  match result { Checked(_) -> false, CheckRejected -> true }
}

fn embedded_sql_host_check_with_offset_span(text: str, host_text: str, offset: i64) -> i64 {
  let (result, reports) = host_check(text, host_text, offset)
  first_position(reports)
}

fn embedded_sql_checked_source_function_count(src: str) -> i64 {
  let typed = require_checked(pipeline_check_source_standalone(__str_ptr(src), __str_len(src)))
  let (fns, source) = match typed {
    TypedModule(functions, retained_source, _, _) -> (functions, retained_source)
  }
  let mut count = 0
  for i in 0..nlist_len(fns) {
    if node_f2(nlist_get(fns, i)) == source { count = count + 1 }
  }
  count
}

fn projections(syntax: SqlSyntax) -> SqlProjections {
  match syntax.query.selection { SqlSelect(items) -> items, SqlSelectAll -> Nil }
}

fn column(expression: SqlExpression) -> str {
  match expression { SqlColumn(name) -> name.text, _ -> "" }
}

fn qualified(expression: SqlExpression, source: str, field: str) -> bool {
  match expression {
    SqlQualifiedColumn(a, b) -> a.text == source and b.text == field,
    _ -> false
  }
}

test "embedded_sql_registry_lookup" {
  Test.assert_true(
    match grammar_module_lookup(__str_ptr("mini_sql"), __str_len("mini_sql")) {
      Some(GrammarModuleSql) -> true
      _ -> false
    }
  )
  Test.assert_true(
    match grammar_module_lookup(__str_ptr("sql"), __str_len("sql")) { None -> true, _ -> false }
  )
  Test.assert_true(match grammar_module_lookup(0, 0) { None -> true, _ -> false })
}

test "embedded_sql_registry_placement_metadata" {
  let module = GrammarModuleSql
  Test.assert_str_eq(grammar_module_name(module), "mini_sql")
  Test.assert_str_eq(grammar_module_public_name(module), "sql")
  Test.assert_true(
    match grammar_module_origin(module) { GrammarModuleFirstPartyOrigin -> true, _ -> false }
  )
  Test.assert_str_eq(grammar_module_current_path(module), "stdlib/grammar/sql.weft")
  Test.assert_str_eq(grammar_module_target_import_path(module), "stdlib/grammar/sql.weft")
  Test.assert_true(
    match GrammarModulePackageOrigin("dependency") {
      GrammarModulePackageOrigin(package_name) -> package_name == "dependency"
      _ -> false
    }
  )
}

test "embedded_sql_registry_execution_boundary" {
  match grammar_module_execution(GrammarModuleSql) {
    GrammarModuleRuntimeExecution(runtime) -> {
      Test.assert_str_eq(runtime.lowering.target, "stdlib/grammar/sql/execute.weft")
      Test.assert_str_eq(runtime.target, "stdlib/grammar/sql/execute.weft")
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_true(
    match GrammarModuleValidateOnly { GrammarModuleValidateOnly -> true, _ -> false }
  )
  Test.assert_true(
    match GrammarModuleTypedPlan(GrammarModuleLowering { target: "generated/plan" }) {
      GrammarModuleTypedPlan(lowering) -> lowering.target == "generated/plan"
      _ -> false
    }
  )
}

test "SQL registry summaries consume typed syntax" {
  let query = embedded_sql_parse_quiet(
    "select distinct u.name, o.total from users u join orders o on u.id = o.user_id where o.total > 10"
  )
  let syntax = GrammarModuleSqlSyntax(query)
  Test.assert_eq(grammar_module_syntax_column_count(syntax), 2)
  Test.assert_eq(grammar_module_syntax_distinct(syntax), 1)
  Test.assert_eq(grammar_module_syntax_has_where(syntax), 1)
  Test.assert_str_eq(grammar_module_syntax_table(syntax).unwrap(), "users")
}

test "SQL single and multiple column projections preserve names" {
  for text in ["select id from users", "SELECT id, name FROM users WHERE id = 1"] {
    let syntax = embedded_sql_parse_quiet(text)
    Test.assert_str_eq(syntax.query.source.table.unwrap().text, "users")
    Test.assert_str_eq(column(projections(syntax).first().unwrap().expression), "id")
  }
  Test.assert_eq_usize(
    projections(embedded_sql_parse_quiet("select id, name from users")).len(),
    2
  )
}

test "SQL comparison and boolean operators are distinct syntax values" {
  let syntax = embedded_sql_parse_quiet("select id from users where active = true")
  Test.assert_true(
    match syntax.query.predicate {
      Some(SqlComparisonExpression(SqlEqual, SqlColumn(name), SqlBooleanLiteral(true, _))) ->
        name.text == "active"
      _ -> false
    }
  )
  let other = embedded_sql_parse_quiet("select id from users where name <> 'Ada'")
  Test.assert_true(
    match other.query.predicate {
      Some(SqlComparisonExpression(SqlNotEqual, SqlColumn(name), SqlStringLiteral(value, _))) ->
        name.text == "name" and value == "Ada"
      _ -> false
    }
  )
}

test "SQL boolean grouping preserves precedence" {
  let first = embedded_sql_parse_quiet(
    "select id from users where id = 1 or name = 'Ada' and active"
  )
  Test.assert_true(
    match first.query.predicate {
      Some(SqlLogicalExpression(SqlOr, _, SqlLogicalExpression(SqlAnd, _, _))) -> true,
      _ -> false
    }
  )
  let second = embedded_sql_parse_quiet(
    "select id from users where (id = 1 or name = 'Ada') and active"
  )
  Test.assert_true(
    match second.query.predicate {
      Some(SqlLogicalExpression(SqlAnd, SqlLogicalExpression(SqlOr, _, _), _)) -> true,
      _ -> false
    }
  )
}

test "SQL star and distinct selections remain separate" {
  let all = embedded_sql_parse_quiet("select * from orders")
  Test.assert_true(match all.query.selection { SqlSelectAll -> true, _ -> false })
  Test.assert_true(not all.query.distinct)
  let distinct = embedded_sql_parse_quiet("select distinct * from users")
  Test.assert_true(distinct.query.distinct)
  Test.assert_true(match distinct.query.selection { SqlSelectAll -> true, _ -> false })
}

test "SQL projection expressions preserve explicit and implicit aliases" {
  let items = projections(
    embedded_sql_parse_quiet("select id as user_id, 'Ada' label, true as marker, 7 from users")
  )
  Test.assert_eq_usize(items.len(), 4)
  Test.assert_str_eq(items.get(0).unwrap().alias.unwrap().text, "user_id")
  Test.assert_str_eq(items.get(1).unwrap().alias.unwrap().text, "label")
  Test.assert_true(
    match items.get(1).unwrap().expression {
      SqlStringLiteral(value, _) -> value == "Ada",
      _ -> false
    }
  )
  Test.assert_true(
    match items.get(2).unwrap().expression { SqlBooleanLiteral(true, _) -> true, _ -> false }
  )
  Test.assert_true(
    match items.get(3).unwrap().expression { SqlIntegerLiteral(7, _) -> true, _ -> false }
  )
  Test.assert_true(match items.get(3).unwrap().alias { None -> true, _ -> false })
}

test "SQL scalar precedence and ordering are preserved" {
  let syntax = embedded_sql_parse_quiet(
    "select id + 2 * 3 as value, name || '!' from users order by id desc, name asc"
  )
  Test.assert_true(
    match projections(syntax).first().unwrap().expression {
      SqlScalarExpression(SqlAdd, SqlColumn(_), SqlScalarExpression(SqlMultiply, SqlIntegerLiteral(2, _), SqlIntegerLiteral(3, _))) ->
        true
      _ -> false
    }
  )
  Test.assert_true(
    match projections(syntax).get(1).unwrap().expression {
      SqlScalarExpression(SqlConcat, _, _) -> true,
      _ -> false
    }
  )
  Test.assert_eq_usize(syntax.query.order.len(), 2)
  Test.assert_true(
    match syntax.query.order.first().unwrap().direction { SqlDescending -> true, _ -> false }
  )
  Test.assert_true(
    match syntax.query.order.get(1).unwrap().direction { SqlAscending -> true, _ -> false }
  )
}

test "SQL grouping aggregates and having retain their structure" {
  let syntax = embedded_sql_parse_quiet(
    "select name, count(*) as n, sum(id) from users group by name, active having count(*) > 1 order by sum(id) desc"
  )
  Test.assert_eq_usize(syntax.query.groups.len(), 2)
  Test.assert_true(
    match projections(syntax).get(1).unwrap().expression {
      SqlAggregateExpression(SqlCount, None, _) -> true,
      _ -> false
    }
  )
  Test.assert_true(
    match projections(syntax).get(2).unwrap().expression {
      SqlAggregateExpression(SqlSum, Some(SqlColumn(name)), _) -> name.text == "id",
      _ -> false
    }
  )
  Test.assert_true(
    match syntax.query.having {
      Some(SqlComparisonExpression(SqlGreater, SqlAggregateExpression(SqlCount, None, _), SqlIntegerLiteral(1, _))) ->
        true,
      _ -> false
    }
  )
  Test.assert_true(
    match syntax.query.order.first().unwrap().expression {
      SqlAggregateExpression(SqlSum, _, _) -> true,
      _ -> false
    }
  )
}

test "SQL joins preserve table aliases and qualified references" {
  let syntax = embedded_sql_parse_quiet(
    "select u.name, o.total from users as u join orders o on u.id = o.user_id where o.total > 10"
  )
  Test.assert_str_eq(syntax.query.source.alias.unwrap().text, "u")
  let join = syntax.query.joins.first().unwrap()
  Test.assert_str_eq(join.source.table.unwrap().text, "orders")
  Test.assert_str_eq(join.source.alias.unwrap().text, "o")
  Test.assert_true(
    match join.predicate {
      SqlComparisonExpression(SqlEqual, left, right) -> qualified(left, "u", "id") and qualified(
        right,
        "o",
        "user_id"
      ),
      _ -> false
    }
  )
  Test.assert_true(qualified(projections(syntax).first().unwrap().expression, "u", "name"))
}

test "SQL paging preserves independent limit and offset expressions" {
  let syntax = embedded_sql_parse_quiet("select id from users limit 10 offset 1 + 2")
  Test.assert_true(
    match syntax.query.limit { Some(SqlIntegerLiteral(10, _)) -> true, _ -> false }
  )
  Test.assert_true(
    match syntax.query.offset {
      Some(SqlScalarExpression(SqlAdd, SqlIntegerLiteral(1, _), SqlIntegerLiteral(2, _))) -> true,
      _ -> false
    }
  )
  let offset = embedded_sql_parse_quiet("select id from users offset 1")
  Test.assert_true(match offset.query.limit { None -> true, _ -> false })
  Test.assert_true(
    match offset.query.offset { Some(SqlIntegerLiteral(1, _)) -> true, _ -> false }
  )
}

test "SQL syntax survives its original source binding" {
  let syntax = embedded_sql_parse_quiet("select name from users where name = 'Ω'")
  Test.assert_str_eq(syntax.span.text().unwrap(), "select name from users where name = 'Ω'")
  Test.assert_str_eq(
    projections(syntax).first().unwrap().alias.unwrap_or(
      SqlIdentifier { text: "", span: syntax.span }
    ).text,
    ""
  )
}

test "embedded_sql_parse_sad_paths_report_diagnostics" {
  Test.assert_eq(embedded_sql_parse_diagnostics(""), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id, from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id as from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id + from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select (id + 1 from users"), 1)
  Test.assert_eq(
    embedded_sql_parse_diagnostics("select id from users where name = 'unterminated"),
    1
  )
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where (id = 1"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where id >"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where id = 1 and"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order id"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order by"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order by id,"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users limit"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users offset"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users offset 1 limit 2"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group id"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group by"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group by id,"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select avg(id) from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select count(*) from users having"), 1)
  Test.assert_eq(
    embedded_sql_parse_diagnostics("select count(*) from users having count(*) >"),
    1
  )
  Test.assert_eq(
    if embedded_sql_parse_diagnostics("select u. from users u") > 0 { 1 } else { 0 },
    1
  )
  Test.assert_eq(embedded_sql_parse_diagnostics("select u.name from users u join orders o"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select u.name from users u join on u.id = 1"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select distinct from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id distinct from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id as distinct from users"), 2)
}

test "embedded_sql_parse_missing_from_recovers_with_diagnostics" {
  let count = embedded_sql_parse_diagnostics("select id users")
  Test.assert_eq(if count > 0 { 1 } else { 0 }, 1)
}

test "embedded_sql_parse_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_first_parse_span("select id users", 100), 115)
}

test "embedded_sql_check_accepts_catalog_queries" {
  Test.assert_true(not embedded_sql_check_rejected("select id, name from users where id = 1"))
  Test.assert_true(
    not embedded_sql_check_rejected("select id, total from orders where user_id = 7")
  )
  Test.assert_true(not embedded_sql_check_rejected("select name from users where name = 'Ada'"))
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select id as user_id, 'Ada' label, true as marker from users"
    )
  )
  Test.assert_true(not embedded_sql_check_rejected("select 1, false as inactive from users"))
  Test.assert_true(
    not embedded_sql_check_rejected("select id + 1 as next_id, name || '!' label from users")
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select id from users order by name desc, id + 1")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name from users where active order by name || '!' asc"
    )
  )
  Test.assert_true(not embedded_sql_check_rejected("select id from users limit 10"))
  Test.assert_true(not embedded_sql_check_rejected("select id from users offset 1"))
  Test.assert_true(
    embedded_sql_check_rejected("select id from users order by name limit id + 1 offset 2")
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select name, count(*) from users group by name")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select active, sum(id), min(name), max(id), count(name) from users group by active"
    )
  )
  Test.assert_true(not embedded_sql_check_rejected("select count(*) from users"))
  Test.assert_true(
    not embedded_sql_check_rejected("select sum(total) from orders order by sum(total) desc")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name, count(*) from users group by name having count(*) > 1"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name, count(*) from users group by name having name = 'Ada' or count(*) > 1"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select count(*) from users having count(*) > 1")
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select id + 1 as next_id from users order by next_id desc")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name, count(*) as n from users group by name having n > 1 order by n desc"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name as label, count(*) as n from users group by name having label = 'Ada' and n > 1"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select users.id from users where users.active order by users.name"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select u.id from users as u where u.active order by u.name")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select u.name, count(*) as n from users u group by u.name having n > 1 order by u.name"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select id as u from users as u order by u.id")
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select u.name, o.total from users u join orders o on u.id = o.user_id where o.total > 10 order by u.name"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select name, total from users join orders on users.id = orders.user_id"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select users.name, sum(orders.total) total_due from users join orders on users.id = orders.user_id group by users.name having total_due > 100 order by users.name"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select distinct name from users order by name")
  )
  Test.assert_true(not embedded_sql_check_rejected("select distinct * from users"))
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select distinct u.name, o.total from users u join orders o on u.id = o.user_id order by o.total"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select distinct name, count(*) as n from users group by name having n > 1"
    )
  )
  Test.assert_true(not embedded_sql_check_rejected("select id from users where active"))
  Test.assert_true(
    not embedded_sql_check_rejected(
      "select id from users where id + 1 > 2 and name || '!' = 'Ada!'"
    )
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select id from users where id >= 1 and active = true")
  )
  Test.assert_true(
    not embedded_sql_check_rejected("select id from users where name <> 'Ada' or active = false")
  )
}

test "embedded_sql_check_reports_unknown_names" {
  Test.assert_true(embedded_sql_check_rejected("select id from missing"))
  Test.assert_true(embedded_sql_check_rejected("select nope from users"))
  Test.assert_true(embedded_sql_check_rejected("select nope as missing_alias from users"))
  Test.assert_true(embedded_sql_check_rejected("select nope + 1 from users"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where nope = 1"))
  Test.assert_true(embedded_sql_check_rejected("select id from users order by nope"))
  Test.assert_true(embedded_sql_check_rejected("select id from users limit nope"))
  Test.assert_true(embedded_sql_check_rejected("select id from users offset nope"))
}

test "embedded_sql_check_reports_predicate_type_mismatch" {
  Test.assert_true(embedded_sql_check_rejected("select id from users where id = 'not an int'"))
  Test.assert_true(embedded_sql_check_rejected("select active from users where active = 1"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where name > 'Ada'"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where id and active = true"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where 1"))
  Test.assert_true(embedded_sql_check_rejected("select name + 1 from users"))
  Test.assert_true(embedded_sql_check_rejected("select id || '!' from users"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where name + 1 = 2"))
  Test.assert_true(embedded_sql_check_rejected("select id from users order by name + 1"))
  Test.assert_true(embedded_sql_check_rejected("select id from users limit name"))
  Test.assert_true(embedded_sql_check_rejected("select id from users offset name || '!'"))
  Test.assert_true(embedded_sql_check_rejected("select name, id from users group by name"))
  Test.assert_true(
    embedded_sql_check_rejected("select name, count(*) from users group by name order by id")
  )
  Test.assert_true(embedded_sql_check_rejected("select sum(name) from users"))
  Test.assert_true(embedded_sql_check_rejected("select id from users where count(*) > 1"))
  Test.assert_true(embedded_sql_check_rejected("select count(*) from users group by count(*)"))
  Test.assert_true(embedded_sql_check_rejected("select count(*) from users limit count(*)"))
  Test.assert_true(
    embedded_sql_check_rejected("select name, count(*) from users group by name having id > 1")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select name, count(*) from users group by name having name")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select name, count(*) from users group by name having count(*)")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select name as label from users order by label + 1")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select id as user_id from users where user_id = 1")
  )
  Test.assert_true(embedded_sql_check_rejected("select id as user_id from users limit user_id"))
  Test.assert_true(embedded_sql_check_rejected("select id as x, name as x from users order by x"))
  Test.assert_true(embedded_sql_check_rejected("select id as name from users order by name + 1"))
  Test.assert_true(
    embedded_sql_check_rejected(
      "select name, count(*) as x, sum(id) as x from users group by name having x > 1"
    )
  )
  Test.assert_true(
    embedded_sql_check_rejected(
      "select name as label, count(*) from users group by name having label > 1"
    )
  )
  Test.assert_true(embedded_sql_check_rejected("select orders.id from users"))
  Test.assert_true(embedded_sql_check_rejected("select users.id from users u"))
  Test.assert_true(embedded_sql_check_rejected("select users.nope from users"))
  Test.assert_true(embedded_sql_check_rejected("select users.name + 1 from users"))
  Test.assert_true(embedded_sql_check_rejected("select id as u from users order by u.id"))
  Test.assert_true(
    embedded_sql_check_rejected("select id from users join orders on users.id = orders.user_id")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select u.name from users u join missing m on true")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select u.name from users u join orders o on u.name = o.total")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select u.name from users u join orders o on u.id")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select x.name from users u join orders o on u.id = o.user_id")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select u.nope from users u join orders o on u.id = o.user_id")
  )
  Test.assert_true(embedded_sql_check_rejected("select distinct nope from users"))
  Test.assert_true(
    embedded_sql_check_rejected(
      "select distinct id from users join orders on users.id = orders.user_id"
    )
  )
  Test.assert_true(
    embedded_sql_check_rejected(
      "select distinct name, count(*) from users group by name having name"
    )
  )
}

test "embedded_sql_check_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_check_with_offset_span("select nope from users", 200), 207)
}

test "embedded_sql_host_typecheck_accepts_host_records" {
  let host = "type users { id: i64, name: str, active: bool } type orders { id: i64, user_id: i64, total: i64 } fn main() -> i64 { 0 }"
  Test.assert_true(
    not embedded_sql_host_check_rejected("select id, name from users where id = 1", host)
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected("select name from users where name = 'Ada'", host)
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select id as user_id, 'Ada' label, true marker from users",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select id + 1 next_id, name || '!' label from users where id + 1 > 2",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select id from users where active or id >= 1 and name <> 'Ada'",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select id from users where active order by name desc, id + 1 asc",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select id from users order by name limit id + 1 offset 2",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select name, count(*), sum(id) from users group by name order by sum(id) desc",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select name, count(*), sum(id) from users group by name having sum(id) > 10 and name = 'Ada'",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select id + 1 as next_id from users order by next_id desc",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select name, count(*) as n from users group by name having n > 1 order by n desc",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select users.id from users where users.active order by users.name",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select u.id from users as u where u.active order by u.name",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select u.name, o.total from users u join orders o on u.id = o.user_id where o.total > 10 order by u.name",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select name, total from users join orders on users.id = orders.user_id",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select u.name, sum(o.total) total_due from users u join orders o on u.id = o.user_id group by u.name having total_due > 100 order by u.name",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected("select distinct name from users order by name", host)
  )
  Test.assert_true(not embedded_sql_host_check_rejected("select distinct * from users", host))
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select distinct u.name, o.total from users u join orders o on u.id = o.user_id order by o.total",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select distinct name, count(*) as n from users group by name having n > 1",
      host
    )
  )
}

test "embedded_sql_host_typecheck_uses_host_not_catalog" {
  let host = "type invoices { total: i64, memo: str, paid: bool } fn main() -> i64 { 0 }"
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select memo from invoices where total >= 10 and paid = true",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select memo as label, total amount, true marker from invoices where paid",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select total + 5 adjusted, memo || '!' label from invoices where total * 2 >= 20",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select memo from invoices order by total + 5 desc, memo || '!' asc",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select memo from invoices where paid order by total desc limit total + 5 offset 1",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select paid, count(*), sum(total) from invoices group by paid order by sum(total) desc limit 10",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select paid, count(*), sum(total) from invoices group by paid having sum(total) > 100 and paid = true order by sum(total) desc limit 10",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select total + 5 as adjusted, memo from invoices order by adjusted desc",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select paid, sum(total) as total_due from invoices group by paid having total_due > 100 order by total_due desc",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select i.memo from invoices as i where i.total >= 10 order by i.memo",
      host
    )
  )
  Test.assert_true(
    not embedded_sql_host_check_rejected(
      "select i.paid, sum(i.total) as total_due from invoices i group by i.paid having total_due > 100 order by i.paid",
      host
    )
  )
  Test.assert_true(
    embedded_sql_check_rejected("select memo from invoices where total >= 10 and paid = true")
  )
  Test.assert_true(
    embedded_sql_check_rejected("select memo from invoices order by total + 5 desc")
  )
  Test.assert_true(embedded_sql_check_rejected("select memo from invoices limit total + 5"))
  Test.assert_true(
    embedded_sql_check_rejected("select paid, count(*), sum(total) from invoices group by paid")
  )
}

test "embedded_sql_host_typecheck_reports_unknown_names" {
  let host = "type users { id: i64, name: str } fn main() -> i64 { 0 }"
  Test.assert_true(embedded_sql_host_check_rejected("select id from missing", host))
  Test.assert_true(embedded_sql_host_check_rejected("select nope from users", host))
  Test.assert_true(
    embedded_sql_host_check_rejected("select nope as missing_alias from users", host)
  )
  Test.assert_true(embedded_sql_host_check_rejected("select nope + 1 from users", host))
  Test.assert_true(embedded_sql_host_check_rejected("select id from users where nope = 1", host))
  Test.assert_true(embedded_sql_host_check_rejected("select id from users order by nope", host))
  Test.assert_true(embedded_sql_host_check_rejected("select id from users limit nope", host))
  Test.assert_true(embedded_sql_host_check_rejected("select id from users offset nope", host))
}

test "embedded_sql_host_typecheck_reports_predicate_type_mismatch" {
  let host = "type users { id: i64, name: str, active: bool } fn main() -> i64 { 0 }"
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users where id = 'not an int'", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select active from users where active = 1", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users where name > 'Ada'", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users where id and active = true", host)
  )
  Test.assert_true(embedded_sql_host_check_rejected("select name + 1 from users", host))
  Test.assert_true(embedded_sql_host_check_rejected("select id || '!' from users", host))
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users where name + 1 = 2", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users order by name + 1", host)
  )
  Test.assert_true(embedded_sql_host_check_rejected("select id from users limit name", host))
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users offset name || '!'", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select name, id from users group by name", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select name, count(*) from users group by name order by id",
      host
    )
  )
  Test.assert_true(embedded_sql_host_check_rejected("select sum(name) from users", host))
  Test.assert_true(
    embedded_sql_host_check_rejected("select id from users where count(*) > 1", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select count(*) from users group by count(*)", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select count(*) from users offset count(*)", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select name, count(*) from users group by name having id > 1",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select name, count(*) from users group by name having name",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select name, count(*) from users group by name having count(*)",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select name as label from users order by label + 1", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id as user_id from users where user_id = 1", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id as user_id from users offset user_id", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id as x, name as x from users order by x", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select id as name from users order by name + 1", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select name, count(*) as x, sum(id) as x from users group by name having x > 1",
      host
    )
  )
  Test.assert_true(embedded_sql_host_check_rejected("select orders.id from users", host))
  Test.assert_true(embedded_sql_host_check_rejected("select users.id from users u", host))
  Test.assert_true(embedded_sql_host_check_rejected("select users.nope from users", host))
  Test.assert_true(embedded_sql_host_check_rejected("select users.name + 1 from users", host))
  Test.assert_true(
    embedded_sql_host_check_rejected("select id as u from users order by u.id", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select id from users join users on users.id = users.id",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select u.name from users u join missing m on true", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select u.name from users u join users o on u.name = o.id",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected("select u.name from users u join users o on u.id", host)
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select x.name from users u join users o on u.id = o.id",
      host
    )
  )
  Test.assert_true(embedded_sql_host_check_rejected("select distinct nope from users", host))
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select distinct id from users join users on users.id = users.id",
      host
    )
  )
  Test.assert_true(
    embedded_sql_host_check_rejected(
      "select distinct name, count(*) from users group by name having name",
      host
    )
  )
}

test "embedded_sql_host_typecheck_maps_diagnostics_to_host_span" {
  let host = "type users { id: i64 } fn main() -> i64 { 0 }"
  Test.assert_eq(
    embedded_sql_host_check_with_offset_span("select nope from users", host, 300),
    307
  )
}

test "embedded_sql_adversarial_unicode_and_host_collisions" {
  Test.assert_true(not embedded_sql_check_rejected("select name from users where name = 'Ω'"))
  let query = embedded_sql_parse_quiet("select fn from type")
  Test.assert_eq_usize(projections(query).len(), 1)
  Test.assert_str_eq(query.query.source.table.unwrap().text, "type")
}

test "embedded_sql_typed_grammar_impls_do_not_shadow_weft_grammar" {
  let src = "fn main() -> i64 { 42 }"
  Test.assert_eq(embedded_sql_checked_source_function_count(src), 1)
}
