use "compiler/mini_sql.weft"
use "compiler/grammar.weft"
use "compiler/diagnose.weft"
use "compiler/pipeline.weft"
use "compiler/typeck.weft"

fn embedded_sql_parse_quiet(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_with_offset_quiet(src: str, host_offset: i64) -> i64 {
  let tt = 0
  handle mini_sql_parse_source_at(__str_ptr(src), __str_len(src), tt, host_offset) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_tokens_quiet(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let tokens = grammar.lex(__str_ptr(src), __str_len(src))
  handle grammar.parse_tokens(tokens, __str_ptr(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_parse_diagnostics(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let count = alloc_bump(8)
  __mem_store64(count, 0)
  handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { __mem_store64(count, __mem_load64(count) + 1) resume(0) }
  }
  __mem_load64(count)
}

fn embedded_sql_first_parse_span(src: str, host_offset: i64) -> i64 {
  let tt = 0
  let first = alloc_bump(8)
  __mem_store64(first, 0 - 1)
  handle mini_sql_parse_source_at(__str_ptr(src), __str_len(src), tt, host_offset) {
    Diagnose.error(msg, span) -> {
      if __mem_load64(first) < 0 { __mem_store64(first, span) } else { 0 }
      resume(0)
    }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  __mem_load64(first)
}

fn embedded_sql_check_errors(src: str) -> i64 {
  let grammar = mini_sql_grammar()
  let tt = 0
  let query = handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  handle mini_sql_check_ast(query, __str_ptr(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn embedded_sql_host_check_typecheck(query: i64, src: i64, host_tt: i64) -[Diagnose]> i64 {
  handle mini_sql_check_ast_host(query, src, host_tt) {
    TypeCheck.resolve_type(name_src, ns, nl) -> resume(typecheck_resolve_type(host_tt, name_src, ns, nl))
    TypeCheck.resolve_field_type(base_ty, field_src, ns, nl) -> resume(typecheck_resolve_field_type(host_tt, base_ty, field_src, ns, nl))
    TypeCheck.subtype(actual_ty, expected_ty) -> resume(typecheck_subtype(host_tt, actual_ty, expected_ty))
  }
}

fn embedded_sql_host_check_typecheck_at(query: i64, src: i64, host_tt: i64, host_offset: i64) -[Diagnose]> i64 {
  handle mini_sql_check_ast_host_at(query, src, host_tt, host_offset) {
    TypeCheck.resolve_type(name_src, ns, nl) -> resume(typecheck_resolve_type(host_tt, name_src, ns, nl))
    TypeCheck.resolve_field_type(base_ty, field_src, ns, nl) -> resume(typecheck_resolve_field_type(host_tt, base_ty, field_src, ns, nl))
    TypeCheck.subtype(actual_ty, expected_ty) -> resume(typecheck_subtype(host_tt, actual_ty, expected_ty))
  }
}

fn embedded_sql_host_check_errors(src: str, host_src: str) -> i64 {
  let query = embedded_sql_parse_quiet(src)
  let typed = pipeline_check_source(__str_ptr(host_src), __str_len(host_src))
  match typed {
    TypedModule(fns, hs, host_tt) -> {
      handle embedded_sql_host_check_typecheck(query, __str_ptr(src), host_tt) {
        Diagnose.error(msg, span) -> resume(0)
        Diagnose.warn(msg, span) -> resume(0)
        Diagnose.note(msg, span) -> resume(0)
      }
    }
  }
}

fn embedded_sql_host_check_with_offset_span(src: str, host_src: str, host_offset: i64) -> i64 {
  let typed = pipeline_check_source(__str_ptr(host_src), __str_len(host_src))
  let first = alloc_bump(8)
  __mem_store64(first, 0 - 1)
  let query = embedded_sql_parse_with_offset_quiet(src, host_offset)
  match typed {
    TypedModule(fns, hs, host_tt) -> {
      handle embedded_sql_host_check_typecheck_at(query, __str_ptr(src), host_tt, host_offset) {
        Diagnose.error(msg, span) -> {
          if __mem_load64(first) < 0 { __mem_store64(first, span) } else { 0 }
          resume(0)
        }
        Diagnose.warn(msg, span) -> resume(0)
        Diagnose.note(msg, span) -> resume(0)
      }
    }
  }
  __mem_load64(first)
}

fn embedded_sql_check_with_offset_span(src: str, host_offset: i64) -> i64 {
  let tt = 0
  let first = alloc_bump(8)
  __mem_store64(first, 0 - 1)
  let query = embedded_sql_parse_with_offset_quiet(src, host_offset)
  handle mini_sql_check_ast_at(query, __str_ptr(src), tt, host_offset) {
    Diagnose.error(msg, span) -> {
      if __mem_load64(first) < 0 { __mem_store64(first, span) } else { 0 }
      resume(0)
    }
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  __mem_load64(first)
}

fn embedded_sql_table_id(src: str) -> i64 {
  let query = embedded_sql_parse_quiet(src)
  mini_sql_table_id(__str_ptr(src), mini_sql_query_table_node(query))
}

test "embedded_sql_parse_single_column" {
  let query = embedded_sql_parse_quiet("select id from users")
  Test.assert_eq(node_tag(query), mini_sql_query_tag())
  Test.assert_eq(mini_sql_query_column_count(query), 1)
  Test.assert_eq(mini_sql_query_star(query), 0)
  Test.assert_eq(mini_sql_query_has_where(query), 0)
  Test.assert_eq(embedded_sql_table_id("select id from users"), mini_sql_table_users())
}

test "embedded_sql_parse_multiple_columns_and_where" {
  let query = embedded_sql_parse_quiet("SELECT id, name FROM users WHERE id = 1")
  Test.assert_eq(mini_sql_query_column_count(query), 2)
  Test.assert_eq(mini_sql_query_has_where(query), 1)
  Test.assert_eq(mini_sql_query_table_len(query), 5)
}

test "embedded_sql_parse_predicate_comparisons_and_bool_literals" {
  let query = embedded_sql_parse_quiet("select id from users where active = true")
  let pred = node_f3(query)
  Test.assert_eq(node_tag(pred), mini_sql_where_eq_tag())
  Test.assert_eq(node_f3(pred), mini_sql_cmp_eq())
  Test.assert_eq(mini_sql_lit_type(node_f2(pred)), mini_sql_ty_bool())

  let ne = embedded_sql_parse_quiet("select id from users where name <> 'Ada'")
  Test.assert_eq(node_f3(node_f3(ne)), mini_sql_cmp_ne())
}

test "embedded_sql_parse_predicate_precedence_and_grouping" {
  let query = embedded_sql_parse_quiet("select id from users where id = 1 or name = 'Ada' and active = true")
  let pred = node_f3(query)
  Test.assert_eq(node_tag(pred), mini_sql_where_bool_tag())
  Test.assert_eq(node_f3(pred), mini_sql_logic_or())
  Test.assert_eq(node_f3(node_f2(pred)), mini_sql_logic_and())

  let grouped = embedded_sql_parse_quiet("select id from users where (id = 1 or name = 'Ada') and active = true")
  let grouped_pred = node_f3(grouped)
  Test.assert_eq(node_f3(grouped_pred), mini_sql_logic_and())
  Test.assert_eq(node_f3(node_f1(grouped_pred)), mini_sql_logic_or())
}

test "embedded_sql_parse_star_projection" {
  let query = embedded_sql_parse_quiet("select * from orders")
  Test.assert_eq(mini_sql_query_star(query), 1)
  Test.assert_eq(mini_sql_query_column_count(query), 0)
  Test.assert_eq(embedded_sql_table_id("select * from orders"), mini_sql_table_orders())
}

test "embedded_sql_parse_projection_expressions_and_aliases" {
  let query = embedded_sql_parse_quiet("select id as user_id, 'paid' label, true as active_flag, 7 from users")
  Test.assert_eq(mini_sql_query_column_count(query), 4)

  let first = mini_sql_query_select_item(query, 0)
  Test.assert_eq(node_tag(first), mini_sql_select_item_tag())
  Test.assert_eq(node_tag(mini_sql_select_item_expr(first)), mini_sql_ident_tag())
  Test.assert_eq(mini_sql_select_item_has_alias(first), 1)
  Test.assert_eq(mini_sql_select_item_explicit_as(first), 1)
  Test.assert_eq(mini_sql_ident_len(mini_sql_select_item_alias(first)), 7)

  let second = mini_sql_query_select_item(query, 1)
  Test.assert_eq(node_tag(mini_sql_select_item_expr(second)), mini_sql_lit_tag())
  Test.assert_eq(mini_sql_lit_type(mini_sql_select_item_expr(second)), mini_sql_ty_str())
  Test.assert_eq(mini_sql_select_item_has_alias(second), 1)
  Test.assert_eq(mini_sql_select_item_explicit_as(second), 0)

  let third = mini_sql_query_select_item(query, 2)
  Test.assert_eq(mini_sql_lit_type(mini_sql_select_item_expr(third)), mini_sql_ty_bool())
  Test.assert_eq(mini_sql_select_item_explicit_as(third), 1)

  let fourth = mini_sql_query_select_item(query, 3)
  Test.assert_eq(mini_sql_lit_type(mini_sql_select_item_expr(fourth)), mini_sql_ty_i64())
  Test.assert_eq(mini_sql_select_item_has_alias(fourth), 0)
}

test "embedded_sql_parse_scalar_expression_precedence" {
  let query = embedded_sql_parse_quiet("select id + 1 * 2 as score, name || '!' label from users")
  Test.assert_eq(mini_sql_query_column_count(query), 2)

  let first = mini_sql_query_select_item(query, 0)
  let expr = mini_sql_select_item_expr(first)
  Test.assert_eq(node_tag(expr), mini_sql_expr_binary_tag())
  Test.assert_eq(node_f3(expr), mini_sql_expr_add())
  Test.assert_eq(node_tag(node_f2(expr)), mini_sql_expr_binary_tag())
  Test.assert_eq(node_f3(node_f2(expr)), mini_sql_expr_mul())
  Test.assert_eq(mini_sql_select_item_explicit_as(first), 1)

  let second = mini_sql_query_select_item(query, 1)
  let concat = mini_sql_select_item_expr(second)
  Test.assert_eq(node_tag(concat), mini_sql_expr_binary_tag())
  Test.assert_eq(node_f3(concat), mini_sql_expr_concat())
  Test.assert_eq(mini_sql_select_item_explicit_as(second), 0)
}

test "embedded_sql_parse_order_by_terms" {
  let query = embedded_sql_parse_quiet("select id from users order by name desc, id + 1 asc")
  Test.assert_eq(mini_sql_query_order_count(query), 2)

  let first = mini_sql_query_order_item(query, 0)
  Test.assert_eq(node_tag(first), mini_sql_order_item_tag())
  Test.assert_eq(mini_sql_order_item_dir(first), mini_sql_order_desc())
  Test.assert_eq(node_tag(mini_sql_order_item_expr(first)), mini_sql_ident_tag())

  let second = mini_sql_query_order_item(query, 1)
  let expr = mini_sql_order_item_expr(second)
  Test.assert_eq(mini_sql_order_item_dir(second), mini_sql_order_asc())
  Test.assert_eq(node_tag(expr), mini_sql_expr_binary_tag())
  Test.assert_eq(node_f3(expr), mini_sql_expr_add())
}

test "embedded_sql_parse_where_before_order_by" {
  let query = embedded_sql_parse_quiet("select id from users where active order by id desc")
  Test.assert_eq(mini_sql_query_has_where(query), 1)
  Test.assert_eq(mini_sql_query_order_count(query), 1)
  Test.assert_eq(mini_sql_order_item_dir(mini_sql_query_order_item(query, 0)), mini_sql_order_desc())
}

test "embedded_sql_parse_limit_offset_tail" {
  let query = embedded_sql_parse_quiet("select id from users order by name limit 10 offset id + 1")
  Test.assert_eq(mini_sql_query_order_count(query), 1)
  Test.assert_eq(mini_sql_query_has_limit(query), 1)
  Test.assert_eq(mini_sql_query_has_offset(query), 1)
  Test.assert_eq(node_tag(mini_sql_query_limit_expr(query)), mini_sql_lit_tag())
  Test.assert_eq(mini_sql_lit_type(mini_sql_query_limit_expr(query)), mini_sql_ty_i64())

  let offset = mini_sql_query_offset_expr(query)
  Test.assert_eq(node_tag(offset), mini_sql_expr_binary_tag())
  Test.assert_eq(node_f3(offset), mini_sql_expr_add())
}

test "embedded_sql_parse_offset_without_limit" {
  let query = embedded_sql_parse_quiet("select id from users offset 5")
  Test.assert_eq(mini_sql_query_has_limit(query), 0)
  Test.assert_eq(mini_sql_query_has_offset(query), 1)
  Test.assert_eq(node_tag(mini_sql_query_offset_expr(query)), mini_sql_lit_tag())
}

test "embedded_sql_parse_group_by_and_aggregates" {
  let query = embedded_sql_parse_quiet("select name, count(*) as n, sum(id) total from users group by name order by count(*) desc limit 10")
  Test.assert_eq(mini_sql_query_column_count(query), 3)
  Test.assert_eq(mini_sql_query_group_count(query), 1)
  Test.assert_eq(node_tag(mini_sql_query_group_item(query, 0)), mini_sql_ident_tag())

  let count_item = mini_sql_query_select_item(query, 1)
  let count_expr = mini_sql_select_item_expr(count_item)
  Test.assert_eq(node_tag(count_expr), mini_sql_agg_call_tag())
  Test.assert_eq(mini_sql_agg_kind(count_expr), mini_sql_agg_count())
  Test.assert_eq(mini_sql_agg_star(count_expr), 1)
  Test.assert_eq(mini_sql_select_item_explicit_as(count_item), 1)

  let sum_expr = mini_sql_select_item_expr(mini_sql_query_select_item(query, 2))
  Test.assert_eq(node_tag(sum_expr), mini_sql_agg_call_tag())
  Test.assert_eq(mini_sql_agg_kind(sum_expr), mini_sql_agg_sum())
  Test.assert_eq(node_tag(mini_sql_agg_arg(sum_expr)), mini_sql_ident_tag())

  let order_expr = mini_sql_order_item_expr(mini_sql_query_order_item(query, 0))
  Test.assert_eq(node_tag(order_expr), mini_sql_agg_call_tag())
  Test.assert_eq(mini_sql_order_item_dir(mini_sql_query_order_item(query, 0)), mini_sql_order_desc())
}

test "embedded_sql_parse_multiple_group_keys" {
  let query = embedded_sql_parse_quiet("select active, name, count(id) from users group by active, name")
  Test.assert_eq(mini_sql_query_group_count(query), 2)
  Test.assert_eq(mini_sql_agg_kind(mini_sql_select_item_expr(mini_sql_query_select_item(query, 2))), mini_sql_agg_count())
}

test "embedded_sql_parse_having_clause" {
  let query = embedded_sql_parse_quiet("select name, count(*) from users group by name having count(*) > 1 order by count(*) desc")
  Test.assert_eq(mini_sql_query_group_count(query), 1)
  Test.assert_eq(mini_sql_query_has_having(query), 1)
  Test.assert_eq(node_tag(mini_sql_query_having_node(query)), mini_sql_where_eq_tag())
  Test.assert_eq(node_f3(mini_sql_query_having_node(query)), mini_sql_cmp_gt())
  Test.assert_eq(node_tag(node_f1(mini_sql_query_having_node(query))), mini_sql_agg_call_tag())
  Test.assert_eq(mini_sql_query_order_count(query), 1)
}

test "embedded_sql_parse_tokens_path_matches_source_path" {
  let from_tokens = embedded_sql_parse_tokens_quiet("select id from users")
  let from_source = embedded_sql_parse_quiet("select id from users")
  Test.assert_eq(mini_sql_query_column_count(from_tokens), mini_sql_query_column_count(from_source))
  Test.assert_eq(mini_sql_query_table_len(from_tokens), mini_sql_query_table_len(from_source))
}

test "embedded_sql_parse_sad_paths_report_diagnostics" {
  Test.assert_eq(embedded_sql_parse_diagnostics(""), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id, from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id as from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id + from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select (id + 1 from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where name = 'unterminated"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where (id = 1"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where id >"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users where id = 1 and"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order id"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order by"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users order by id,"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users limit"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users offset"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users offset 1 limit 2"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group id"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group by"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select id from users group by id,"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select avg(id) from users"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select count(*) from users having"), 1)
  Test.assert_eq(embedded_sql_parse_diagnostics("select count(*) from users having count(*) >"), 1)
}

test "embedded_sql_parse_missing_from_recovers_with_diagnostics" {
  let count = embedded_sql_parse_diagnostics("select id users")
  Test.assert_eq(if count > 0 { 1 } else { 0 }, 1)
}

test "embedded_sql_parse_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_first_parse_span("select id users", 100), 115)
}

test "embedded_sql_check_accepts_catalog_queries" {
  Test.assert_eq(embedded_sql_check_errors("select id, name from users where id = 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id, total from orders where user_id = 7"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name from users where name = 'Ada'"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id as user_id, 'Ada' label, true as marker from users"), 0)
  Test.assert_eq(embedded_sql_check_errors("select 1, false as inactive from users"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id + 1 as next_id, name || '!' label from users"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users order by name desc, id + 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name from users where active order by name || '!' asc"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users limit 10"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users offset 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users order by name limit id + 1 offset 2"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name"), 0)
  Test.assert_eq(embedded_sql_check_errors("select active, sum(id), min(name), max(id), count(name) from users group by active"), 0)
  Test.assert_eq(embedded_sql_check_errors("select count(*) from users"), 0)
  Test.assert_eq(embedded_sql_check_errors("select sum(total) from orders order by sum(total) desc"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name having count(*) > 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name having name = 'Ada' or count(*) > 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select count(*) from users having count(*) > 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id + 1 as next_id from users order by next_id desc"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) as n from users group by name having n > 1 order by n desc"), 0)
  Test.assert_eq(embedded_sql_check_errors("select name as label, count(*) as n from users group by name having label = 'Ada' and n > 1"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users where active"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users where id + 1 > 2 and name || '!' = 'Ada!'"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users where id >= 1 and active = true"), 0)
  Test.assert_eq(embedded_sql_check_errors("select id from users where name <> 'Ada' or active = false"), 0)
}

test "embedded_sql_check_reports_unknown_names" {
  Test.assert_eq(embedded_sql_check_errors("select id from missing"), 1)
  Test.assert_eq(embedded_sql_check_errors("select nope from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select nope as missing_alias from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select nope + 1 from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where nope = 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users order by nope"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users limit nope"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users offset nope"), 1)
}

test "embedded_sql_check_reports_predicate_type_mismatch" {
  Test.assert_eq(embedded_sql_check_errors("select id from users where id = 'not an int'"), 1)
  Test.assert_eq(embedded_sql_check_errors("select active from users where active = 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where name > 'Ada'"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where id and active = true"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name + 1 from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id || '!' from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where name + 1 = 2"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users order by name + 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users limit name"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users offset name || '!'"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, id from users group by name"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name order by id"), 1)
  Test.assert_eq(embedded_sql_check_errors("select sum(name) from users"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id from users where count(*) > 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select count(*) from users group by count(*)"), 1)
  Test.assert_eq(embedded_sql_check_errors("select count(*) from users limit count(*)"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name having id > 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name having name"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) from users group by name having count(*)"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name as label from users order by label + 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id as user_id from users where user_id = 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id as user_id from users limit user_id"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id as x, name as x from users order by x"), 1)
  Test.assert_eq(embedded_sql_check_errors("select id as name from users order by name + 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name, count(*) as x, sum(id) as x from users group by name having x > 1"), 1)
  Test.assert_eq(embedded_sql_check_errors("select name as label, count(*) from users group by name having label > 1"), 1)
}

test "embedded_sql_check_maps_diagnostics_to_host_span" {
  Test.assert_eq(embedded_sql_check_with_offset_span("select nope from users", 200), 207)
}

test "embedded_sql_host_typecheck_accepts_host_records" {
  let host = "type users { id: i64, name: str, active: bool } fn main() -> i64 { 0 }"
  Test.assert_eq(embedded_sql_host_check_errors("select id, name from users where id = 1", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select name from users where name = 'Ada'", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id as user_id, 'Ada' label, true marker from users", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id + 1 next_id, name || '!' label from users where id + 1 > 2", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where active or id >= 1 and name <> 'Ada'", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where active order by name desc, id + 1 asc", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users order by name limit id + 1 offset 2", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*), sum(id) from users group by name order by sum(id) desc", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*), sum(id) from users group by name having sum(id) > 10 and name = 'Ada'", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select id + 1 as next_id from users order by next_id desc", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) as n from users group by name having n > 1 order by n desc", host), 0)
}

test "embedded_sql_host_typecheck_uses_host_not_catalog" {
  let host = "type invoices { total: i64, memo: str, paid: bool } fn main() -> i64 { 0 }"
  Test.assert_eq(embedded_sql_host_check_errors("select memo from invoices where total >= 10 and paid = true", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select memo as label, total amount, true marker from invoices where paid", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select total + 5 adjusted, memo || '!' label from invoices where total * 2 >= 20", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select memo from invoices order by total + 5 desc, memo || '!' asc", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select memo from invoices where paid order by total desc limit total + 5 offset 1", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select paid, count(*), sum(total) from invoices group by paid order by sum(total) desc limit 10", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select paid, count(*), sum(total) from invoices group by paid having sum(total) > 100 and paid = true order by sum(total) desc limit 10", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select total + 5 as adjusted, memo from invoices order by adjusted desc", host), 0)
  Test.assert_eq(embedded_sql_host_check_errors("select paid, sum(total) as total_due from invoices group by paid having total_due > 100 order by total_due desc", host), 0)
  Test.assert_eq(embedded_sql_check_errors("select memo from invoices where total >= 10 and paid = true"), 1)
  Test.assert_eq(embedded_sql_check_errors("select memo from invoices order by total + 5 desc"), 1)
  Test.assert_eq(embedded_sql_check_errors("select memo from invoices limit total + 5"), 1)
  Test.assert_eq(embedded_sql_check_errors("select paid, count(*), sum(total) from invoices group by paid"), 1)
}

test "embedded_sql_host_typecheck_reports_unknown_names" {
  let host = "type users { id: i64, name: str } fn main() -> i64 { 0 }"
  Test.assert_eq(embedded_sql_host_check_errors("select id from missing", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select nope from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select nope as missing_alias from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select nope + 1 from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where nope = 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users order by nope", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users limit nope", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users offset nope", host), 1)
}

test "embedded_sql_host_typecheck_reports_predicate_type_mismatch" {
  let host = "type users { id: i64, name: str, active: bool } fn main() -> i64 { 0 }"
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where id = 'not an int'", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select active from users where active = 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where name > 'Ada'", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where id and active = true", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name + 1 from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id || '!' from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where name + 1 = 2", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users order by name + 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users limit name", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users offset name || '!'", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, id from users group by name", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) from users group by name order by id", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select sum(name) from users", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id from users where count(*) > 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select count(*) from users group by count(*)", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select count(*) from users offset count(*)", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) from users group by name having id > 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) from users group by name having name", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) from users group by name having count(*)", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name as label from users order by label + 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id as user_id from users where user_id = 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id as user_id from users offset user_id", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id as x, name as x from users order by x", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select id as name from users order by name + 1", host), 1)
  Test.assert_eq(embedded_sql_host_check_errors("select name, count(*) as x, sum(id) as x from users group by name having x > 1", host), 1)
}

test "embedded_sql_host_typecheck_maps_diagnostics_to_host_span" {
  let host = "type users { id: i64 } fn main() -> i64 { 0 }"
  Test.assert_eq(embedded_sql_host_check_with_offset_span("select nope from users", host, 300), 307)
}

test "embedded_sql_adversarial_unicode_and_host_collisions" {
  Test.assert_eq(embedded_sql_check_errors("select name from users where name = 'Ω'"), 0)
  let query = embedded_sql_parse_quiet("select fn from type")
  Test.assert_eq(mini_sql_query_column_count(query), 1)
  Test.assert_eq(mini_sql_query_table_len(query), 4)
}

test "embedded_sql_typed_grammar_impls_do_not_shadow_weft_grammar" {
  let src = "fn main() -> i64 { 42 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(pipeline_typed_fns(typed)), 1)
}
