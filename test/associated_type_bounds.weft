-- A bound declared on an associated type holds for every implementation, so a
-- projection of a type parameter carries it: with T: Level and
-- `type Child: Level`, T.Child is itself a Level.

trait Level {
  type Child: Level
  fn child(self) -> Self.Child
  fn leaf(self) -> bool
  fn size(self) -> i64
}

type Root { size: i64 }

type Branch { size: i64 }

type Leaf { size: i64 }

impl Level for Root {
  type Child = Branch
  fn child(self) -> Branch { Branch { size: self.size - 1 } }
  fn leaf(self) -> bool { false }
  fn size(self) -> i64 { self.size }
}

impl Level for Branch {
  type Child = Leaf
  fn child(self) -> Leaf { Leaf { size: self.size - 1 } }
  fn leaf(self) -> bool { false }
  fn size(self) -> i64 { self.size }
}

impl Level for Leaf {
  type Child = Leaf
  fn child(self) -> Leaf { Leaf { size: self.size } }
  fn leaf(self) -> bool { true }
  fn size(self) -> i64 { self.size }
}

fn size_of<U: Level>(node: U) -> i64 { node.size() }

fn child_size<T: Level>(node: T) -> i64 { size_of<T.Child>(node.child()) }

fn child_leaf<T: Level>(node: T) -> bool { node.child().leaf() }

fn child_size_direct<T: Level>(node: T) -> i64 { node.child().size() }

-- Binding the intermediate projection to its own parameter reaches two levels
-- down with single-level projections.
fn grandchild_size<C: Level, T: Level & { type Child = C }>(node: T) -> i64 {
  size_of<C.Child>(node.child().child())
}

-- Recursion through the projection reaches Root, Branch and Leaf, and Leaf's
-- child is Leaf again, so it closes.
fn depth<T: Level>(node: T) -> i64 {
  if node.leaf() { 0 } else { 1 + depth<T.Child>(node.child()) }
}

test "a projection carries its declared bound" {
  Test.assert_eq(child_size<Root>(Root { size: 5 }), 4)
  Test.assert_eq(child_size<Leaf>(Leaf { size: 2 }), 2)
}

test "methods of a projection's declared bound are callable on it" {
  Test.assert_eq(child_size_direct<Root>(Root { size: 5 }), 4)
  Test.assert_true(not child_leaf<Root>(Root { size: 5 }))
  Test.assert_true(child_leaf<Branch>(Branch { size: 3 }))
}

test "a constrained intermediate parameter reaches two levels down" {
  Test.assert_eq(grandchild_size<Branch, Root>(Root { size: 5 }), 3)
}

test "recursion through a bounded projection closes" {
  Test.assert_eq(depth<Root>(Root { size: 5 }), 2)
  Test.assert_eq(depth<Leaf>(Leaf { size: 1 }), 0)
}
