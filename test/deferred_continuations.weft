use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/rc.weft"

effect DeferredTail {
  @deferred fn get() -> i64
}

effect DeferredArg {
  @deferred fn step(value: i64) -> i64
}

effect DeferredOuter {
  @deferred fn get() -> i64
}

effect DeferredInner {
  @deferred fn get() -> i64
}

effect DeferredBranch {
  @deferred fn pick(flag: bool) -> i64
}

effect DeferredYield {
  @deferred fn emit(value: i64) -> i64
}

effect DeferredNext {
  fn next(value: i64) -> i64
}

effect DeferredMany {
  @deferred fn pack(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64
}

fn deferred_tail_go() -[DeferredTail]> i64 {
  DeferredTail.get()
}

fn deferred_tail_plus_one_go() -[DeferredTail]> i64 {
  DeferredTail.get() + 1
}

fn deferred_rc_param_count_go(p: rc i64) -[DeferredTail]> i64 {
  let resumed = DeferredTail.get()
  resumed + if p == 0 { 0 } else { 2 }
}

fn deferred_rc_param_tail_go(p: rc i64) -[DeferredTail]> i64 {
  DeferredTail.get()
}

fn deferred_rc_param_return_go(p: rc i64) -[DeferredTail]> rc i64 {
  let ignored = DeferredTail.get()
  p
}

fn deferred_arg_go(value: i64) -[DeferredArg]> i64 {
  DeferredArg.step(value)
}

fn deferred_arg_bind_go(value: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(value)
  stepped + value
}

fn deferred_arg_expr_go(value: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(value + 1)
  stepped + value
}

fn deferred_recursive_arg_go(value: i64) -[DeferredArg]> i64 {
  if value == 0 {
    0
  } else {
    DeferredArg.step(value) + deferred_recursive_arg_go(value - 1)
  }
}

fn deferred_two_arg_go(left: i64, right: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(left + right)
  stepped + left
}

fn deferred_nested_go() -[DeferredOuter, DeferredInner]> i64 {
  inner_add(DeferredInner.get(), DeferredOuter.get())
}

fn deferred_branch_go(flag: bool) -[DeferredBranch]> i64 {
  DeferredBranch.pick(flag)
}

fn deferred_generator_producer(seed: i64) -[DeferredYield]> i64 {
  let first = DeferredYield.emit(seed)
  let second = DeferredYield.emit(first + 1)
  second + 1
}

fn deferred_generator_like_next() -> i64 {
  handle {
    handle deferred_generator_producer(20) {
      DeferredYield.emit(value) with k -> {
        let next = DeferredNext.next(value)
        k(next)
      }
    }
  } {
    DeferredNext.next(value) -> resume(value + 10)
  }
}

fn deferred_conditional_tail_skip() -> i64 {
  handle if false { DeferredTail.get() } else { 42 } {
    DeferredTail.get() with k -> k(20)
  }
}

test "deferred_body_lambda_uses_late_ordinary_function" {
  let got = handle {
    let base = 40
    let f = (x: i64) => x + base
    f(1) + DeferredTail.get()
  } {
    DeferredTail.get() with k -> k(1)
  }
  Test.assert_eq(got, 42)
}

test "deferred_body_lambda_dispatches_current_effect_dynamically" {
  -- A deferred handler has no stable frame/ops-table pointer to capture.
  -- The synthetic lambda function must leave this perform residual so the
  -- active fiber handler receives it at invocation.
  let got = handle {
    let f = () => DeferredTail.get()
    f()
  } {
    DeferredTail.get() with k -> k(42)
  }
  Test.assert_eq(got, 42)
}

fn deferred_conditional_non_tail_fiber_resume(flag: bool) -> i64 {
  handle if flag { DeferredTail.get() * 2 } else { 1 } {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_conditional_non_tail_fiber_drop(flag: bool) -> i64 {
  handle if flag { DeferredTail.get() * 2 } else { 1 } {
    DeferredTail.get() with k -> {
      let ignored = 20
      ignored + 7
    }
  }
}

fn deferred_repeated_non_tail_fiber_resume() -> i64 {
  handle {
    let first = DeferredTail.get()
    let second = DeferredTail.get()
    first + second
  } {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_repeated_non_tail_fiber_nested_drop() -> i64 {
  handle {
    let first = DeferredYield.emit(1)
    let second = DeferredYield.emit(2)
    first + second
  } {
    DeferredYield.emit(value) with k -> {
      if value == 1 {
        let resumed = k(10)
        resumed + 1
      } else {
        50
      }
    }
  }
}

fn deferred_repeated_branch_fiber_resume(flag: bool) -> i64 {
  handle if flag {
    let first = DeferredTail.get()
    let second = DeferredTail.get()
    first + second
  } else {
    DeferredTail.get() * 2
  } {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_direct_local_k_alias() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let saved = k
      let resumed = saved(20)
      resumed + 2
    }
  }
}

