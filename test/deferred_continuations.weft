use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/rc.weft"

effect DeferredTail {
  @deferred fn get() -> i64
}

effect DeferredArg {
  @deferred fn step(value: i64) -> i64
}

effect DeferredOuter {
  @deferred fn get() -> i64
}

effect DeferredInner {
  @deferred fn get() -> i64
}

effect DeferredBranch {
  @deferred fn pick(flag: bool) -> i64
}

effect DeferredYield {
  @deferred fn emit(value: i64) -> i64
}

effect DeferredNext {
  fn next(value: i64) -> i64
}

fn deferred_tail_go() -[DeferredTail]> i64 {
  DeferredTail.get()
}

fn deferred_tail_plus_one_go() -[DeferredTail]> i64 {
  DeferredTail.get() + 1
}

fn deferred_rc_param_count_go(p: rc i64) -[DeferredTail]> i64 {
  let resumed = DeferredTail.get()
  resumed + if p == 0 { 0 } else { 2 }
}

fn deferred_rc_param_tail_go(p: rc i64) -[DeferredTail]> i64 {
  DeferredTail.get()
}

fn deferred_rc_param_return_go(p: rc i64) -[DeferredTail]> rc i64 {
  let ignored = DeferredTail.get()
  p
}

fn deferred_arg_go(value: i64) -[DeferredArg]> i64 {
  DeferredArg.step(value)
}

fn deferred_arg_bind_go(value: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(value)
  stepped + value
}

fn deferred_arg_expr_go(value: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(value + 1)
  stepped + value
}

fn deferred_two_arg_go(left: i64, right: i64) -[DeferredArg]> i64 {
  let stepped = DeferredArg.step(left + right)
  stepped + left
}

fn deferred_nested_go() -[DeferredOuter, DeferredInner]> i64 {
  inner_add(DeferredInner.get(), DeferredOuter.get())
}

fn deferred_branch_go(flag: bool) -[DeferredBranch]> i64 {
  DeferredBranch.pick(flag)
}

fn deferred_generator_producer(seed: i64) -[DeferredYield]> i64 {
  let first = DeferredYield.emit(seed)
  let second = DeferredYield.emit(first + 1)
  second + 1
}

fn deferred_generator_like_next() -> i64 {
  handle {
    handle deferred_generator_producer(20) {
      DeferredYield.emit(value) with k -> {
        let next = DeferredNext.next(value)
        k(next)
      }
    }
  } {
    DeferredNext.next(value) -> resume(value + 10)
  }
}

fn deferred_conditional_tail_skip() -> i64 {
  handle if false { DeferredTail.get() } else { 42 } {
    DeferredTail.get() with k -> k(20)
  }
}

fn deferred_with_managed_cleanup_go() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 41)
  handle deferred_tail_go() {
    DeferredTail.get() with k -> k(__mem_load64(p) + 1)
  }
}

fn deferred_resumed_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> k(rc_count(p))
  }
  got * 10 + rc_count(p)
}

fn deferred_dropped_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> rc_count(p)
  }
  got * 10 + rc_count(p)
}

fn deferred_direct_non_tail_continuation() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_direct_let_continuation() -> i64 {
  handle {
    let value = DeferredTail.get()
    value * 2
  } {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_direct_non_tail_drops_body_continuation() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let resumed = 20
      resumed + 7
    }
  }
}

fn deferred_function_boundary_non_tail_continuation() -> i64 {
  handle deferred_tail_go() * 2 {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_function_boundary_non_tail_drops_continuation() -> i64 {
  handle deferred_tail_go() * 2 {
    DeferredTail.get() with k -> {
      let resumed = 20
      resumed + 7
    }
  }
}

fn deferred_function_boundary_callee_rest_continuation() -> i64 {
  handle deferred_tail_plus_one_go() * 2 {
    DeferredTail.get() with k -> k(20)
  }
}

fn deferred_function_boundary_arg_continuation() -> i64 {
  handle deferred_arg_go(41) {
    DeferredArg.step(value) with k -> {
      let resumed = k(value + 1)
      resumed + 1
    }
  }
}

fn deferred_function_boundary_arg_drops_continuation() -> i64 {
  handle deferred_arg_go(41) {
    DeferredArg.step(value) with k -> value + 1
  }
}

fn deferred_function_boundary_arg_callee_rest() -> i64 {
  handle deferred_arg_bind_go(20) + 2 {
    DeferredArg.step(value) with k -> k(value + 1)
  }
}

fn deferred_function_boundary_op_arg_expression() -> i64 {
  handle deferred_arg_expr_go(20) * 2 {
    DeferredArg.step(value) with k -> k(value)
  }
}

fn deferred_function_boundary_multiple_args() -> i64 {
  handle deferred_two_arg_go(20, 1) + 1 {
    DeferredArg.step(value) with k -> k(value)
  }
}

fn deferred_function_boundary_param_shadowing() -> i64 {
  let value = 100
  let got = handle deferred_arg_bind_go(20) {
    DeferredArg.step(value) with k -> k(value + 1)
  }
  got + value
}

fn deferred_function_boundary_rc_param_resume_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_rc_param_count_go(p) {
    DeferredTail.get() with k -> {
      let before = rc_count(p)
      let resumed = k(40)
      before * 1000 + resumed * 10 + rc_count(p)
    }
  }
  got
}

fn deferred_function_boundary_rc_param_drop_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_rc_param_count_go(p) {
    DeferredTail.get() with k -> rc_count(p)
  }
  got * 10 + rc_count(p)
}

fn deferred_function_boundary_rc_param_unused_release() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  handle deferred_rc_param_tail_go(p) {
    DeferredTail.get() with k -> {
      let before = rc_count(p)
      let resumed = k(41)
      before * 100 + resumed * 10 + rc_count(p)
    }
  }
}

fn deferred_function_boundary_rc_param_return_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let q: rc i64 = handle deferred_rc_param_return_go(p) {
    DeferredTail.get() with k -> k(0)
  }
  rc_count(p)
}

fn inner_add(left: i64, right: i64) -> i64 {
  left + right
}

test "deferred_continuation_call_resumes_once" {
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> k(42)
  }
  Test.assert_eq(got, 42)
}

test "deferred_clause_without_k_stays_tail_resumptive" {
  let got = handle deferred_tail_go() {
    DeferredTail.get() -> resume(41)
  }
  Test.assert_eq(got + 1, 42)
}

test "deferred_clause_with_k_preserves_params" {
  let got = handle deferred_arg_go(40) {
    DeferredArg.step(value) with k -> {
      let next = value + 2
      k(next)
    }
  }
  Test.assert_eq(got, 42)
}

test "deferred_continuation_call_branches_in_tail_position" {
  let got = handle deferred_branch_go(true) {
    DeferredBranch.pick(flag) with k -> if flag { k(42) } else { k(0) }
  }
  Test.assert_eq(got, 42)
}

test "deferred_nested_handlers_keep_prompt_order" {
  let got = handle {
    handle deferred_nested_go() {
      DeferredInner.get() with k -> k(10)
    }
  } {
    DeferredOuter.get() with k -> k(32)
  }
  Test.assert_eq(got, 42)
}

test "deferred_continuation_with_managed_cleanup_descriptor" {
  Test.assert_eq(deferred_with_managed_cleanup_go(), 42)
}

test "deferred_resumed_continuation_owns_and_releases_segment" {
  Test.assert_eq(deferred_resumed_segment_count(), 21)
}

test "deferred_dropped_continuation_owns_and_releases_segment" {
  Test.assert_eq(deferred_dropped_segment_count(), 21)
}

test "deferred_direct_non_tail_continuation_returns_resumed_body" {
  Test.assert_eq(deferred_direct_non_tail_continuation(), 42)
}

test "deferred_direct_let_continuation_returns_resumed_body" {
  Test.assert_eq(deferred_direct_let_continuation(), 42)
}

test "deferred_direct_non_tail_without_k_returns_clause_value" {
  Test.assert_eq(deferred_direct_non_tail_drops_body_continuation(), 27)
}

test "deferred_function_boundary_non_tail_continuation_returns_resumed_body" {
  Test.assert_eq(deferred_function_boundary_non_tail_continuation(), 42)
}

test "deferred_function_boundary_non_tail_without_k_returns_clause_value" {
  Test.assert_eq(deferred_function_boundary_non_tail_drops_continuation(), 27)
}

test "deferred_function_boundary_resumes_callee_rest" {
  Test.assert_eq(deferred_function_boundary_callee_rest_continuation(), 42)
}

test "deferred_function_boundary_arg_non_tail_returns_resumed_body" {
  Test.assert_eq(deferred_function_boundary_arg_continuation(), 43)
}

test "deferred_function_boundary_arg_without_k_returns_clause_value" {
  Test.assert_eq(deferred_function_boundary_arg_drops_continuation(), 42)
}

test "deferred_function_boundary_arg_resumes_callee_rest" {
  Test.assert_eq(deferred_function_boundary_arg_callee_rest(), 43)
}

test "deferred_function_boundary_operation_arg_expression" {
  Test.assert_eq(deferred_function_boundary_op_arg_expression(), 82)
}

test "deferred_function_boundary_multiple_call_args" {
  Test.assert_eq(deferred_function_boundary_multiple_args(), 42)
}

test "deferred_function_boundary_param_shadowing" {
  Test.assert_eq(deferred_function_boundary_param_shadowing(), 141)
}

test "deferred_function_boundary_rc_param_resume_releases_after_k" {
  Test.assert_eq(deferred_function_boundary_rc_param_resume_count(), 3421)
}

test "deferred_function_boundary_rc_param_drop_releases_without_k" {
  Test.assert_eq(deferred_function_boundary_rc_param_drop_count(), 31)
}

test "deferred_function_boundary_rc_param_unused_still_released" {
  Test.assert_eq(deferred_function_boundary_rc_param_unused_release(), 711)
}

test "deferred_function_boundary_rc_param_return_is_retained" {
  Test.assert_eq(deferred_function_boundary_rc_param_return_count(), 2)
}

test "deferred_generator_like_yield_next_e2e" {
  Test.assert_eq(deferred_generator_like_next(), 42)
}

test "deferred_tail_continuation_in_skipped_branch_is_not_captured" {
  Test.assert_eq(deferred_conditional_tail_skip(), 42)
}

test "deferred_operation_metadata_reifies_matrix" {
  let src = "effect DeferredMeta { @deferred fn later(value: i64) -> i64 fn now() -> bool } fn main() -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  let ops = type_entry_effect_ops(type_entry_list_nth(entries, 0))
  Test.assert_eq(type_effect_op_list_len(ops), 2)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 1, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 2, 7), 7)
  Test.assert_eq(type_effect_op_list_nth_param_count_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 0, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 1, 0 - 1), 2)
}
