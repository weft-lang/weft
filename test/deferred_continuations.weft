    }
  }
}

fn deferred_recursive_handler_returned_helper() -> i64 {
  handle deferred_recursive_arg_go(3) {
    DeferredArg.step(value) with k -> {
      let saved = deferred_return_helper(k)
      saved(value * 10)
    }
