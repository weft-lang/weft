fn deferred_split_spilled_k_closure() -> i64 {
  handle DeferredMany.pack(1, 2, 3, 4, 5, 6, 7) + 1 {
    DeferredMany.pack(a, b, c, d, e, f, g) with k -> {
      let sum = a + b + c + d + e + f + g
      let resumed = k(sum)
      resumed + 2
    }
  }
}

fn deferred_with_managed_cleanup_go() -> i64 {
  let p: rc i64 = rc_default_word_new(41)
  handle deferred_tail_go() {
    DeferredTail.get() with k -> k(rc_default_word_load(p) + 1)
  }
}

fn deferred_resumed_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> k(rc_count(p))
  }
  got * 10 + rc_count(p)
}

fn deferred_dropped_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> rc_count(p)
  }
  got * 10 + rc_count(p)
}

fn deferred_direct_non_tail_continuation() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let resumed = k(20)
      resumed + 2
    }
  }
}

fn deferred_resume_helper(k: Continuation<i64, i64>, value: i64) -> i64 {
  k(value)
}

fn deferred_return_helper(k: Continuation<i64, i64>) -> Continuation<i64, i64> {
  k
}

fn deferred_return_stmt_helper(k: Continuation<i64, i64>) -> Continuation<i64, i64> {
  return k
}

fn deferred_direct_continuation_helper() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let resumed = deferred_resume_helper(k, 20)
      resumed + 2
    }
  }
}

fn deferred_direct_returned_continuation_helper() -> i64 {
  handle DeferredTail.get() * 2 {
    DeferredTail.get() with k -> {
      let saved = deferred_return_helper(k)
      let resumed = saved(20)
      resumed + 2
    }
  }
}

