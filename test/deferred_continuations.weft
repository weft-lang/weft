test "deferred_operation_metadata_reifies_matrix" {
  let src = "effect DeferredMeta { @deferred fn later(value: i64) -> i64 fn now() -> bool } fn main() -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  let ops = type_entry_effect_ops(type_entry_list_nth(entries, 0))
  Test.assert_eq(type_effect_op_list_len(ops), 2)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 1, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 2, 7), 7)
  Test.assert_eq(type_effect_op_list_nth_param_count_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 0, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 1, 0 - 1), 2)
}
