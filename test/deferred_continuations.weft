use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/macho.weft"
use "compiler/object.weft"
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "runtime/rc.weft"

effect DeferredTail {
  @deferred fn get() -> i64
}

effect DeferredArg {
  @deferred fn step(value: i64) -> i64
}

effect DeferredOuter {
  @deferred fn get() -> i64
}

effect DeferredInner {
  @deferred fn get() -> i64
}

effect DeferredBranch {
  @deferred fn pick(flag: bool) -> i64
}

fn deferred_tail_go() -[DeferredTail]> i64 {
  DeferredTail.get()
}

fn deferred_arg_go(value: i64) -[DeferredArg]> i64 {
  DeferredArg.step(value)
}

fn deferred_nested_go() -[DeferredOuter, DeferredInner]> i64 {
  inner_add(DeferredInner.get(), DeferredOuter.get())
}

fn deferred_branch_go(flag: bool) -[DeferredBranch]> i64 {
  DeferredBranch.pick(flag)
}

fn deferred_with_managed_cleanup_go() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 41)
  handle deferred_tail_go() {
    DeferredTail.get() with k -> k(__mem_load64(p) + 1)
  }
}

fn deferred_resumed_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> k(rc_count(p))
  }
  got * 10 + rc_count(p)
}

fn deferred_dropped_segment_count() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> rc_count(p)
  }
  got * 10 + rc_count(p)
}

fn inner_add(left: i64, right: i64) -> i64 {
  left + right
}

test "deferred_continuation_call_resumes_once" {
  let got = handle deferred_tail_go() {
    DeferredTail.get() with k -> k(42)
  }
  Test.assert_eq(got, 42)
}

test "deferred_clause_without_k_stays_tail_resumptive" {
  let got = handle deferred_tail_go() {
    DeferredTail.get() -> resume(41)
  }
  Test.assert_eq(got + 1, 42)
}

test "deferred_clause_with_k_preserves_params" {
  let got = handle deferred_arg_go(40) {
    DeferredArg.step(value) with k -> {
      let next = value + 2
      k(next)
    }
  }
  Test.assert_eq(got, 42)
}

test "deferred_continuation_call_branches_in_tail_position" {
  let got = handle deferred_branch_go(true) {
    DeferredBranch.pick(flag) with k -> if flag { k(42) } else { k(0) }
  }
  Test.assert_eq(got, 42)
}

test "deferred_nested_handlers_keep_prompt_order" {
  let got = handle {
    handle deferred_nested_go() {
      DeferredInner.get() with k -> k(10)
    }
  } {
    DeferredOuter.get() with k -> k(32)
  }
  Test.assert_eq(got, 42)
}

test "deferred_continuation_with_managed_cleanup_descriptor" {
  Test.assert_eq(deferred_with_managed_cleanup_go(), 42)
}

test "deferred_resumed_continuation_owns_and_releases_segment" {
  Test.assert_eq(deferred_resumed_segment_count(), 21)
}

test "deferred_dropped_continuation_owns_and_releases_segment" {
  Test.assert_eq(deferred_dropped_segment_count(), 21)
}

test "deferred_operation_metadata_reifies_matrix" {
  let src = "effect DeferredMeta { @deferred fn later(value: i64) -> i64 fn now() -> bool } fn main() -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  let ops = type_entry_effect_ops(type_entry_list_nth(entries, 0))
  Test.assert_eq(type_effect_op_list_len(ops), 2)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 1, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_is_deferred_or(ops, 2, 7), 7)
  Test.assert_eq(type_effect_op_list_nth_param_count_or(ops, 0, 0 - 1), 1)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 0, 0 - 1), 0)
  Test.assert_eq(type_effect_op_list_nth_return_type_prim_id_or(ops, 1, 0 - 1), 2)
}
