-- test/linked_support/env_conformance.weft -- one Env contract, two handlers
--
-- A process started with these arguments and environment entries must
-- observe exactly what the fixed Env handler reports for the same lists. The
-- entries include forms only a raw environment can hold: an entry without
-- `=`, an entry with an empty name, and a repeated name. The last entry marks
-- a process started with them as the child of a conformance check.

use stdlib/env.{Env}
use stdlib/list.{Cons, List, Nil}

--- The arguments after argument zero.
pub fn env_conformance_arguments() -> List<str> {
  Cons<str>("", Cons<str>("alpha", Cons<str>("two words", Cons<str>("é☃", Nil<str>()))))
}

--- The environment entries, in order.
pub fn env_conformance_environment() -> List<str> {
  Cons<str>(
    "X",
    Cons<str>(
      "WEFT_ENV_PRESENT=fixture",
      Cons<str>(
        "WEFT_ENV_EMPTY=",
        Cons<str>(
          "WEFT_ENV_DUP=first",
          Cons<str>(
            "WEFT_ENV_DUP=second",
            Cons<str>(
              "WEFT_ENV_EQUALS=a=b",
              Cons<str>(
                "WEFT_ENV_UTF8=é☃",
                Cons<str>("=orphan", Cons<str>("WEFT_ENV_ROLE=child", Nil<str>()))
              )
            )
          )
        )
      )
    )
  )
}

fn same(value: str?, expected: str) -> bool {
  match value {
    nil -> false
    actual: str -> actual == expected
  }
}

fn absent(value: str?) -> bool {
  match value {
    nil -> true
    actual: str -> false
  }
}

--- Whether the installed Env reports the startup of a conformance child.
pub fn env_conformance_is_child() -[Env]> bool {
  match Env.var("WEFT_ENV_ROLE") {
    nil -> false
    role: str -> role == "child"
  }
}

--- Zero when the installed Env reports the shared startup, otherwise the
--- number of the first case it contradicts.
pub fn env_conformance_check() -[Env]> i64 {
  if Env.arg_count() != 5 { return 1 }
  if absent(Env.arg(0)) { return 2 }
  if not same(Env.arg(1), "") { return 3 }
  if not same(Env.arg(2), "alpha") { return 4 }
  if not same(Env.arg(3), "two words") { return 5 }
  if not same(Env.arg(4), "é☃") { return 6 }
  if not absent(Env.arg(5)) { return 7 }
  if not absent(Env.arg(0 - 1)) { return 8 }
  if not same(Env.var("WEFT_ENV_PRESENT"), "fixture") { return 9 }
  if not same(Env.var("WEFT_ENV_EMPTY"), "") { return 10 }
  if not absent(Env.var("X")) { return 11 }
  if not same(Env.var("WEFT_ENV_DUP"), "first") { return 12 }
  if not same(Env.var("WEFT_ENV_EQUALS"), "a=b") { return 13 }
  if not same(Env.var("WEFT_ENV_UTF8"), "é☃") { return 14 }
  if not absent(Env.var("")) { return 15 }
  if not absent(Env.var("WEFT_ENV_PRESENT=fixture")) { return 16 }
  if not absent(Env.var("WEFT_ENV_MISSING")) { return 17 }
  if not absent(Env.var("WEFT_ENV_PRES")) { return 18 }
  if not absent(Env.var("WEFT_ENV_PRESENTX")) { return 19 }
  if not absent(Env.var("WEFT_ENV_PRESENT\0")) { return 20 }
  if not env_conformance_is_child() { return 21 }
  0
}
