-- imported_got_support.weft - linked GOT helper imported by a test.

use "stdlib/unsafe.weft"

fn imported_got_write(msg: i64, len: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(__got_write(1, msg, len, 0, 0, 0))
  }
}
