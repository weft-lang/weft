use "runtime/memory.weft"
-- Stateful computation: combines effects, handlers, for-range, closures
-- Expected exit code: 42

use runtime/alloc.{*}

effect State {
  fn get() -> i64
  fn put(val: i64) -> i64
}

fn count_up(n: i64) -[State]> i64 {
  for i in 0..n {
    let cur = State.get()
    State.put(cur + 1)
  }
  State.get()
}

fn with_state(init: i64, f: () -[State]> i64) -> i64 {
  -- State cell: arena-backed i64, mutated via the safe runtime memory facade.
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, init)
  let result = handle f() {
    State.get() -> resume(mem_load64(cell))
    State.put(v) -> {
      mem_store64(cell, v)
      resume(0)
    }
  }
  arena_free(arena)
  result
}

fn main() -> i64 {
  with_state(0, () => count_up(42))
}
