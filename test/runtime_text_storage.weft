-- Trusted text storage primitives that keep byte addresses inside the runtime.

use runtime/string.{
  runtime_str_from_utf8_vector,
  runtime_str_storage_from_vector,
  runtime_str_storage_push_byte,
  runtime_str_utf8_first_malformed
}
use runtime/vector_storage.{vector_storage_append_text_bytes}
use stdlib/string.{str_byte_at, str_len}
use stdlib/vector as vector
use stdlib/vector.{vector_len, vector_reserve}
use stdlib/vector/handles.{Vector}

fn bytes_of(values: [i64]) -> owned Vector<u8> {
  let mut out = vector.new<u8>()
  for value in values {
    out.push(__i64_to_u8(value))
  }
  out
}

fn text_of(values: [i64]) -> str {
  let bytes = bytes_of(values)
  match runtime_str_from_utf8_vector(bytes) {
    nil -> "<malformed>"
    text: str -> text
  }
}

test "text appends copy exact source ranges into reserved byte capacity" {
  let out = vector.new<u8>()
  Test.assert_true(vector_reserve<u8>(out, 8))
  Test.assert_true(vector_storage_append_text_bytes(out, "hello", 0, 5))
  Test.assert_true(vector_storage_append_text_bytes(out, "world", 1, 2))
  Test.assert_true(vector_storage_append_text_bytes(out, "ignored", 3, 0))
  Test.assert_eq(vector_len<u8>(out), 7)
  match runtime_str_from_utf8_vector(out) {
    nil -> Test.assert_true(false)
    text: str -> Test.assert_str_eq(text, "helloor")
  }
}

test "text appends refuse ranges outside the source or the reservation" {
  let out = vector.new<u8>()
  Test.assert_true(vector_reserve<u8>(out, 4))
  Test.assert_false(vector_storage_append_text_bytes(out, "abc", 0 - 1, 1))
  Test.assert_false(vector_storage_append_text_bytes(out, "abc", 0, 0 - 1))
  Test.assert_false(vector_storage_append_text_bytes(out, "abc", 2, 2))
  Test.assert_false(vector_storage_append_text_bytes(out, "abc", 4, 0))
  Test.assert_false(vector_storage_append_text_bytes(out, "abcde", 0, 5))
  Test.assert_eq(vector_len<u8>(out), 0)
  Test.assert_true(vector_storage_append_text_bytes(out, "abcd", 0, 4))
  Test.assert_false(vector_storage_append_text_bytes(out, "e", 0, 1))
  Test.assert_eq(vector_len<u8>(out), 4)
  let unreserved = vector.new<u8>()
  Test.assert_false(vector_storage_append_text_bytes(unreserved, "x", 0, 1))
  Test.assert_eq(vector_len<u8>(unreserved), 0)
}

test "byte vectors become text only when they are well-formed UTF-8" {
  let empty: [i64; 0] = []
  let ascii = [119, 101, 102, 116]
  let accented = [99, 97, 102, 195, 169]
  let emoji = [240, 159, 152, 128]
  Test.assert_str_eq(text_of(empty[..]), "")
  Test.assert_str_eq(text_of(ascii[..]), "weft")
  Test.assert_str_eq(text_of(accented[..]), "café")
  Test.assert_str_eq(text_of(emoji[..]), "😀")
  -- Invalid lead, lone continuation, truncated two- and three-byte forms,
  -- overlong, surrogate, beyond U+10FFFF, and a truncated trailing scalar.
  let invalid_lead = [255]
  let continuation = [128]
  let truncated_two = [195]
  let truncated_three = [224, 160]
  let overlong = [192, 128]
  let surrogate = [237, 160, 128]
  let beyond = [244, 144, 128, 128]
  let trailing = [97, 240, 159, 152]
  Test.assert_str_eq(text_of(invalid_lead[..]), "<malformed>")
  Test.assert_str_eq(text_of(continuation[..]), "<malformed>")
  Test.assert_str_eq(text_of(truncated_two[..]), "<malformed>")
  Test.assert_str_eq(text_of(truncated_three[..]), "<malformed>")
  Test.assert_str_eq(text_of(overlong[..]), "<malformed>")
  Test.assert_str_eq(text_of(surrogate[..]), "<malformed>")
  Test.assert_str_eq(text_of(beyond[..]), "<malformed>")
  Test.assert_str_eq(text_of(trailing[..]), "<malformed>")
}

test "byte storage copies arbitrary bytes independently of the vector" {
  let source = [0, 255, 128, 97]
  let mut values = bytes_of(source[..])
  let storage = runtime_str_storage_from_vector(values)
  values.push(__i64_to_u8(1))
  Test.assert_eq(str_len(storage), 4)
  Test.assert_eq(str_byte_at(storage, 0), 0)
  Test.assert_eq(str_byte_at(storage, 1), 255)
  Test.assert_eq(str_byte_at(storage, 2), 128)
  Test.assert_eq(str_byte_at(storage, 3), 97)
}

fn storage_of(values: [i64]) -> str {
  let bytes = bytes_of(values)
  runtime_str_storage_from_vector(bytes)
}

test "storage validation reports the first malformed byte offset" {
  Test.assert_eq(runtime_str_utf8_first_malformed(""), 0 - 1)
  Test.assert_eq(runtime_str_utf8_first_malformed("héλlo 😀"), 0 - 1)
  let lead = [255, 97]
  let middle = [97, 98, 195, 40]
  let tail = [97, 240, 159, 152]
  Test.assert_eq(runtime_str_utf8_first_malformed(storage_of(lead[..])), 0)
  Test.assert_eq(runtime_str_utf8_first_malformed(storage_of(middle[..])), 2)
  Test.assert_eq(runtime_str_utf8_first_malformed(storage_of(tail[..])), 1)
}

test "storage byte appends copy the source and add one arbitrary byte" {
  let source = "ab"
  let high = runtime_str_storage_push_byte(source, __i64_to_u8(255))
  let nul = runtime_str_storage_push_byte("", __i64_to_u8(0))
  Test.assert_str_eq(source, "ab")
  Test.assert_eq(str_len(high), 3)
  Test.assert_eq(str_byte_at(high, 0), 97)
  Test.assert_eq(str_byte_at(high, 1), 98)
  Test.assert_eq(str_byte_at(high, 2), 255)
  Test.assert_eq(str_len(nul), 1)
  Test.assert_eq(str_byte_at(nul, 0), 0)
}
