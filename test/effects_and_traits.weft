use "runtime/memory.weft"
-- test/effects_and_traits.weft -- effect annotations, closures, handlers, generics, traits, conformance

use runtime/alloc.{*}

-- ═══════════════════════════════════════════════════════════════
-- Helper functions for closure tests
-- ═══════════════════════════════════════════════════════════════
fn apply(f: (i64) -> i64, x: i64) -> i64 { f(x) }
fn apply2(f: (i64, i64) -> i64, a: i64, b: i64) -> i64 { f(a, b) }
fn a3(f: (i64) -> i64, x: i64) -> i64 { f(x) }
fn a2(f: (i64) -> i64, x: i64) -> i64 { a3(f, x) }
fn a1(f: (i64) -> i64, x: i64) -> i64 { a2(f, x) }

-- ═══════════════════════════════════════════════════════════════
-- Helper functions for generic tests
-- ═══════════════════════════════════════════════════════════════
fn id<T>(x: T) -> T { x }
fn pair<A, B>(a: i64, b: i64) -> i64 { a + b }
fn f3<X, Y, Z>(x: i64) -> i64 { x }
fn fst<A, B>(a: A, b: B) -> A { a }
fn wrap<U>(y: U) -> U { id(y) }
fn id_eff<T>(x: T) -[IO]> T { x }
fn apply_gen<T, U>(f: (T) -> U, x: T) -> U { f(x) }

-- ═══════════════════════════════════════════════════════════════
-- Shared effect declarations
-- ═══════════════════════════════════════════════════════════════
effect State {
  fn get() -> i64
  fn put(v: i64) -> i64
}

effect Counter {
  fn inc() -> i64
  fn read() -> i64
}

effect Ask {
  fn ask() -> i64
}

effect Math {
  fn add(a: i64, b: i64) -> i64
}

effect E {
  fn f() -> i64
}

effect Log {
  fn log() -> i64
}

effect Net {
  fn ping() -> i64
}

effect VeryLongEffectNameThatIsUnusuallyLong {
  fn ping() -> i64
}

-- ═══════════════════════════════════════════════════════════════
-- Shared trait declarations
-- ═══════════════════════════════════════════════════════════════
trait Display {
  fn display(self: i64) -> i64
}

trait Greet {
  fn greet(self: i64) -> i64
}

trait Val {
  fn val(self: i64) -> i64
}

trait Show {
  fn show(self: i64) -> i64
}

trait Dbl {
  fn dbl(self: i64) -> i64
}

trait Id_t {
  fn id_m(self: i64) -> i64
}

trait V {
  fn v(self: i64) -> i64
}

trait S {
  fn s(self: i64) -> i64
}

trait A_t {
  fn a(self: i64) -> i64
}

trait B_t {
  fn b(self: i64) -> i64
}

trait C_t {
  fn c(self: i64) -> i64
}

trait D_t {
  fn d(self: i64) -> i64
}

trait Big {
  fn big_a(self: i64) -> i64
  fn big_b(self: i64) -> i64
  fn big_c(self: i64) -> i64
  fn big_d(self: i64) -> i64
}

trait Marker { }

trait Logged {
  fn logged(self: i64) -[Log]> i64
}

trait Iter {
  type Item
  fn next(self: i64) -> i64
}

trait VeryLongTraitNameForTesting {
  fn check(self: i64) -> i64
}

trait GenericImplIdentity {
  fn identity(self) -> Self
}

trait GenericImplMarked {
  fn mark(self) -> i64
}

trait GenericImplConditional {
  fn conditional(self) -> Self
}

trait SpecificImplScore {
  fn score(self) -> i64
}

-- ═══════════════════════════════════════════════════════════════
-- Shared type declarations
-- ═══════════════════════════════════════════════════════════════
type Point { x: i64, y: i64 }
type Box_t { v: i64 }
type Pair_t { a: i64, b: i64 }
type W_t { v: i64 }
type N_t { v: i64 }
type Foo_t { x: i64 }
type Bar_t { y: i64 }
type Shape { Circle(i64) }
type Outer { inner: i64 }
type Inner { val_f: i64 }
type F_t { x: i64 }
type V_t { x: i64 }
type Impl_A { x: i64 }
type Impl_B { x: i64 }
type Impl_C { x: i64 }
type Impl_D { x: i64 }
type Impl_E { x: i64 }
type GenericImplBox<T> { GenericImplBox(T) }
type GenericImplPair<A, B> { GenericImplPair(A, B) }
type SpecificImplBox<T> { SpecificImplBox(T) }

-- ═══════════════════════════════════════════════════════════════
-- Impl blocks
-- ═══════════════════════════════════════════════════════════════
impl Point {
  fn sum(self: i64) -> i64 {
    mem_load64(self) + mem_load64(self + 8)
  }
}

impl<T> GenericImplBox<T> {
  fn echo(self, value: T) -> T { value }
}

impl<T> GenericImplIdentity for GenericImplBox<T> {
  fn identity(self) -> Self { self }
}

impl GenericImplMarked for i64 {
  fn mark(self) -> i64 { self }
}

impl<T: GenericImplMarked> GenericImplConditional for GenericImplBox<T> {
  fn conditional(self) -> Self { self }
}

impl<T> GenericImplPair<T, T> {
  fn choose_second(self, first: T, second: T) -> T { second }
}

impl SpecificImplScore for SpecificImplBox<i64> {
  fn score(self) -> i64 { 20 }
}

impl SpecificImplScore for SpecificImplBox<bool> {
  fn score(self) -> i64 { 22 }
}

fn accept_generic_impl_conditional<T: GenericImplConditional>(value: T) -> i64 { 42 }

impl i64 {
  fn answer(self: i64) -> i64 { 42 }
  fn double(self: i64) -> i64 { self + self }
  fn inc(self: i64) -> i64 { self + 1 }
  fn dec(self: i64) -> i64 { self - 1 }
  fn triple(self: i64) -> i64 { self * 3 }
  fn half(self: i64) -> i64 { self / 2 }
  fn dbl_i(self: i64) -> i64 { self + self }
  fn get_i(self: i64) -> i64 { self }
  fn id_i(self: i64) -> i64 { self }
  fn zero(self: i64) -> i64 { 0 }
  fn add3_m(self: i64, a: i64, b: i64, c: i64) -> i64 { self + a + b + c }
  fn max_exit(self: i64) -> i64 { 255 }
  fn pt(self: i64) -> i64 { self + 10 }
  fn inc2(self: i64) -> i64 { self.inc().inc() }
  fn x_m(self: i64) -> i64 { self }
}

fn helper(n: i64) -> i64 { n * 2 }
fn take_i64(n: i64) -> i64 { n }

impl i64 {
  fn dbl_h(self: i64) -> i64 { helper(self) }
}

impl Greet for i64 {
  fn greet(self: i64) -> i64 { 42 }
}

impl Val for Box_t {
  fn val(self: i64) -> i64 { mem_load64(self) }
}

impl Box_t {
  fn add_m(self: i64, n: i64) -> i64 { mem_load64(self) + n }
}

impl Pair_t {
  fn first(self: i64) -> i64 { mem_load64(self) }
  fn second(self: i64) -> i64 { mem_load64(self + 8) }
  fn sum_p(self: i64) -> i64 { mem_load64(self) + mem_load64(self + 8) }
}

impl Foo_t {
  fn val_f(self: i64) -> i64 { mem_load64(self) }
}

impl Bar_t {
  fn val_b(self: i64) -> i64 { mem_load64(self) + 10 }
}

impl W_t {
  fn get_w(self: i64) -> i64 { mem_load64(self) }
}

impl N_t {
  fn val_n(self: i64) -> i64 { mem_load64(self) }
  fn big_n(self: i64) -> i64 { if mem_load64(self) > 10 { 1 } else { 0 } }
}

impl Shape {
  fn radius(self: i64) -> i64 { mem_load64(self + 8) }
}

impl str {
  fn len42(self: i64) -> i64 { 42 }
  fn code(self: i64) -> i64 { 42 }
}

impl bool {
  fn to_int(self: i64) -> i64 { if self == 1 { 42 } else { 0 } }
}

impl Inner {
  fn get_inner(self: i64) -> i64 { mem_load64(self) }
}

impl Show for i64 {
  fn show(self: i64) -> i64 { self }
}

impl Dbl for i64 {
  fn dbl(self: i64) -> i64 { self + self }
}

impl Id_t for i64 {
  fn id_m(self: i64) -> i64 { self }
}

impl Id_t for W_t {
  fn id_m(self: i64) -> i64 { mem_load64(self) }
}

impl V for i64 {
  fn v(self: i64) -> i64 { self }
}

impl V for F_t {
  fn v(self: i64) -> i64 { mem_load64(self) }
}

impl V for Box_t {
  fn v(self: i64) -> i64 { mem_load64(self) }
}

impl S for i64 {
  fn s(self: i64) -> i64 { self }
}

impl A_t for i64 {
  fn a(self: i64) -> i64 { 20 }
}

impl B_t for i64 {
  fn b(self: i64) -> i64 { 22 }
}

impl C_t for i64 {
  fn c(self: i64) -> i64 { 12 }
}

impl D_t for i64 {
  fn d(self: i64) -> i64 { 9 }
}

impl Big for i64 {
  fn big_a(self: i64) -> i64 { 10 }
  fn big_b(self: i64) -> i64 { 11 }
  fn big_c(self: i64) -> i64 { 12 }
  fn big_d(self: i64) -> i64 { 9 }
}

impl Marker for i64 { }

impl Logged for i64 {
  fn logged(self: i64) -[Log]> i64 { self }
}

impl Iter for i64 {
  type Item = i64
  fn next(self: i64) -> i64 { self + 1 }
}


impl VeryLongTraitNameForTesting for i64 {
  fn check(self: i64) -> i64 { self }
}

impl V_t {
  fn get_x(self: i64) -> i64 { mem_load64(self) }
}

impl V_t {
  fn dbl_x(self: i64) -> i64 { mem_load64(self) * 2 }
}

impl Impl_A { fn v_a(self: i64) -> i64 { mem_load64(self) } }
impl Impl_B { fn v_b(self: i64) -> i64 { mem_load64(self) } }
impl Impl_C { fn v_c(self: i64) -> i64 { mem_load64(self) } }
impl Impl_D { fn v_d(self: i64) -> i64 { mem_load64(self) } }
impl Impl_E { fn v_e(self: i64) -> i64 { mem_load64(self) } }

-- ═══════════════════════════════════════════════════════════════
-- Helper functions for effect type annotation tests
-- ═══════════════════════════════════════════════════════════════
fn eff_f() -[IO]> i64 { 42 }
fn eff_multi() -[IO, Log]> i64 { 42 }
fn eff_three() -[IO, Log, Net]> i64 { 42 }
fn eff_pure() -> i64 { 42 }
fn eff_dup() -[IO, IO]> i64 { 42 }
fn eff_long() -[VeryLongEffectNameThatIsUnusuallyLong]> i64 { 42 }
fn fact_eff(n: i64) -[IO]> i64 { if n <= 1 { return 1 } n * fact_eff(n - 1) }

-- Helper functions for handler tests
fn state_do_it() -[State]> i64 { State.put(99) State.get() }
fn state_go() -[State]> i64 {
  let a = State.get()
  State.put(a + 10)
  let b = State.get()
  State.put(b + 5)
  State.get()
}
fn counter_go() -[Counter]> i64 {
  Counter.inc()
  Counter.inc()
  Counter.inc()
  Counter.read()
}
fn counter_loop() -[Counter]> i64 {
  let mut i = 0
  while i < 10 {
    Counter.inc()
    i = i + 1
  }
  Counter.read()
}

-- Generic helper functions for bounded generics
fn f_show<T: Show>(x: T) -> T { x }
fn f_val<T: Val>(x: T) -> i64 { 42 }
fn double_it<T: Dbl>(x: T) -> i64 { 42 }
fn get_id<T: Id_t>(x: T) -> i64 { 42 }
fn check_v<T: V>(x: T) -> i64 { 42 }
fn f_s<T>(x: T) -> T where T: S { x }
fn f_ab<T: A_t & B_t>(x: T) -> T { x }
fn display_show<T: Show>(x: T) -> i64 { x.show() }
fn f_marker<T: Marker>(x: T) -> T { x }
fn f_long<T: VeryLongTraitNameForTesting>(x: T) -> T { x }
fn f_multi_where<X, Y>(x: X, y: Y) -> i64 where X: A_t, Y: B_t { 42 }
fn f_where_ab<X, Y>(x: X, y: Y) -> i64 where X: A_t & B_t, Y: A_t { 42 }
fn f_all_bounded<A: V, B: V, C: V>(a: A, b: B, c: C) -> i64 { 42 }

fn f_bound_eff<T: V>(x: T) -[E]> i64 { E.f() }

fn go_rec(x: i64, t: i64) -> i64 { if x >= t { x } else { go_rec(x.inc(), t) } }

fn fact_m(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact_m(n.dec()) } }

-- ═══════════════════════════════════════════════════════════════
-- 39. EFFECT TYPE ANNOTATIONS
-- ═══════════════════════════════════════════════════════════════

test "eff_plain" { Test.assert_eq(42, 42) }
test "eff_io" { Test.assert_eq(Test.with_io_i64(() => eff_f()), 42) }
test "eff_multi" {
  Test.assert_eq(Test.with_io_i64(() => handle eff_multi() { Log.log() -> resume(0) }), 42)
}
test "eff_three" {
  let got = Test.with_io_i64(() => handle { handle eff_three() { Net.ping() -> resume(0) } } { Log.log() -> resume(0) })
  Test.assert_eq(got, 42)
}
test "eff_pure_arrow" { Test.assert_eq(eff_pure(), 42) }
test "eff_adv_dup" { Test.assert_eq(Test.with_io_i64(() => eff_dup()), 42) }
test "eff_adv_long_name" {
  Test.assert_eq(handle eff_long() { VeryLongEffectNameThatIsUnusuallyLong.ping() -> resume(0) }, 42)
}

-- ═══════════════════════════════════════════════════════════════
-- 40. CLOSURES / LAMBDAS
-- ═══════════════════════════════════════════════════════════════

-- Basic lambdas
test "lam_const" { let f = x => 42 Test.assert_eq(f(0), 42) }
test "lam_identity" { let f = x => x Test.assert_eq(f(42), 42) }
test "lam_add1" { let f = x => x + 1 Test.assert_eq(f(41), 42) }
test "lam_arith" { let f = x => x * 2 + 2 Test.assert_eq(f(20), 42) }
test "lam_zero" { let f = x => 0 Test.assert_eq(f(99), 0) }
test "lam_255" { let f = x => 255 Test.assert_eq(f(0), 255) }

-- Closure captures
test "lam_cap_one" { let a = 10 let f = x => x + a Test.assert_eq(f(32), 42) }
test "lam_cap_two" { let a = 10 let b = 20 let f = x => x + a + b Test.assert_eq(f(12), 42) }
test "lam_cap_three" { let a = 1 let b = 2 let c = 3 let f = x => x + a + b + c Test.assert_eq(f(36), 42) }
test "lam_cap_nested" {
  let a = 10
  let b = 20
  let f = x => { let r = x + a r + b }
  Test.assert_eq(f(12), 42)
}

-- Passing closures as arguments
test "lam_pass" { let g = x => x * 2 Test.assert_eq(apply(g, 21), 42) }
test "lam_pass_cap" { let off = 10 let g = x => x + off Test.assert_eq(apply(g, 32), 42) }
test "lam_pass_inline" { Test.assert_eq(apply(x => x + 1, 41), 42) }
test "lam_call_captured_closure" { let inc = x => x + 1 let f = y => inc(y) Test.assert_eq(f(41), 42) }

-- Multiple calls
test "lam_multi_call" { let f = x => x + 1 Test.assert_eq(f(20) + f(21), 43) }

-- Closure in if/else
test "lam_in_if" { let f = if true { x => 42 } else { x => 0 } Test.assert_eq(f(0), 42) }

-- Closure in let chain
test "lam_let_chain" {
  let a = 10
  let f = x => x + a
  let b = f(12)
  let g = y => y + b
  Test.assert_eq(g(20), 42)
}

-- Control flow inside lambda
test "lam_if_body" { let f = x => if x > 10 { 42 } else { 0 } Test.assert_eq(f(20), 42) }
test "lam_while_body" {
  let f = n => { let mut i = 0 while i < n { i = i + 1 } i }
  Test.assert_eq(f(42), 42)
}
test "lam_return" { let f = x => { if x > 10 { return 42 } x } Test.assert_eq(f(20), 42) }
test "lam_break" {
  let f = x => { let mut i = 0 while i < 100 { if i == x { break } i = i + 1 } i }
  Test.assert_eq(f(42), 42)
}

-- Closure capturing closure
test "lam_cap_lam" {
  let add = a => b => a + b
  let add10 = add(10)
  Test.assert_eq(apply(add10, 32), 42)
}

-- Adversarial
test "lam_adv_many_caps" {
  let a = 1 let b = 2 let c = 3 let d = 4 let e = 5 let g = 6 let h = 7 let i = 8
  let f = x => x + a + b + c + d + e + g + h + i
  Test.assert_eq(f(6), 42)
}
test "lam_adv_deep" { Test.assert_eq(a1(x => x + 1, 41), 42) }

-- Property: capture preserves immutable value
test "lam_prop_value" { let x = 42 let f = y => x let x = 99 Test.assert_eq(f(0), 42) }
test "lam_prop_local_shadow" { let x = 100 let f = y => { let mut x = y x = x + 1 x } Test.assert_eq(f(41), 42) }

-- Property: consistent results
test "lam_prop_consistent" {
  let f = x => x + 1
  Test.assert_eq(if f(5) == f(5) { 1 } else { 0 }, 1)
}

-- Multi-param lambdas
test "mlam_two" { let f = (x, y) => x + y Test.assert_eq(f(20, 22), 42) }
test "mlam_three" { let f = (a, b, c) => a + b + c Test.assert_eq(f(10, 20, 12), 42) }
test "mlam_zero" { let f = () => 42 Test.assert_eq(f(), 42) }
test "mlam_four" { let f = (a, b, c, d) => a + b + c + d Test.assert_eq(f(10, 20, 30, 40), 100) }
test "mlam_seven" { let f = (a, b, c, d, e, g, h) => a + b + c + d + e + g + h Test.assert_eq(f(1, 2, 3, 4, 5, 6, 21), 42) }
test "mlam_cap" { let off = 2 let f = (x, y) => x + y + off Test.assert_eq(f(20, 20), 42) }
test "mlam_pass" { Test.assert_eq(apply2((x, y) => x + y, 20, 22), 42) }
test "mlam_group" { Test.assert_eq((40 + 2), 42) }
test "mlam_group_nested" { Test.assert_eq(((21 * 2)), 42) }
test "mlam_disambig" { let x = 42 Test.assert_eq((x), 42) }
test "mlam_typed" { let f = (x: i64, y: i64) => x + y Test.assert_eq(f(20, 22), 42) }
test "mlam_zero_block" { let f = () => { let x = 40 x + 2 } Test.assert_eq(f(), 42) }
test "mlam_control" { let f = (x, y) => if x > y { x } else { y } Test.assert_eq(f(42, 10), 42) }

-- ═══════════════════════════════════════════════════════════════
-- 41. EFFECT HANDLERS (Tier 2: tail-resumptive)
-- ═══════════════════════════════════════════════════════════════

-- Basic State.get
test "eff_h_get" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 42)
  Test.assert_eq(handle State.get() { State.get() -> resume(mem_load64(c)) }, 42)
  arena_free(arena)
}

-- State.put then get
test "eff_h_put_get" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 0)
  let r = handle state_do_it() {
    State.get() -> resume(mem_load64(c))
    State.put(v) -> { mem_store64(c, v) resume(0) }
  }
  Test.assert_eq(r, 99)
  arena_free(arena)
}

-- Multiple performs accumulate
test "eff_h_multi" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 100)
  let r = handle state_go() {
    State.get() -> resume(mem_load64(c))
    State.put(v) -> { mem_store64(c, v) resume(0) }
  }
  Test.assert_eq(r, 115)
  arena_free(arena)
}

-- Handler captures enclosing variable
test "eff_h_capture" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 0)
  let offset = 100
  let r = handle { State.get() + 42 } {
    State.get() -> resume(mem_load64(c) + offset)
  }
  Test.assert_eq(r, 142)
  arena_free(arena)
}

-- Complex body with block
test "eff_h_complex" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 5)
  let r = handle {
    let x = State.get()
    State.put(x * 2)
    State.get() + 1
  } {
    State.get() -> resume(mem_load64(c))
    State.put(v) -> { mem_store64(c, v) resume(0) }
  }
  Test.assert_eq(r, 11)
  arena_free(arena)
}

-- Different effect name (Counter)
test "eff_h_counter" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 0)
  let r = handle counter_go() {
    Counter.inc() -> { let v = mem_load64(c) mem_store64(c, v + 1) resume(0) }
    Counter.read() -> resume(mem_load64(c))
  }
  Test.assert_eq(r, 3)
  arena_free(arena)
}

-- Body performs no effects
test "eff_h_no_perf" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 0)
  let r = handle 42 { State.get() -> resume(mem_load64(c)) }
  Test.assert_eq(r, 42)
  arena_free(arena)
}

-- Single zero-arg operation
test "eff_h_zero_arg" {
  Test.assert_eq(handle Ask.ask() { Ask.ask() -> resume(7) }, 7)
}

-- Operation with multiple args
test "eff_h_multi_arg" {
  Test.assert_eq(handle Math.add(10, 20) { Math.add(a, b) -> resume(a + b) }, 30)
}

-- Handler result flows through
test "eff_h_result" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 10)
  let r = handle State.get() { State.get() -> resume(mem_load64(c)) }
  Test.assert_eq(r, 10)
  arena_free(arena)
}

-- Perform in if branch
test "eff_h_in_if" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 42)
  let r = handle { if true { State.get() } else { 0 } } {
    State.get() -> resume(mem_load64(c))
  }
  Test.assert_eq(r, 42)
  arena_free(arena)
}

-- Perform in while loop
test "eff_h_in_while" {
  let arena = arena_new(64)
  let c = arena_alloc(arena, 8, 8)
  mem_store64(c, 0)
  let r = handle counter_loop() {
    Counter.inc() -> { mem_store64(c, mem_load64(c) + 1) resume(0) }
    Counter.read() -> resume(mem_load64(c))
  }
  Test.assert_eq(r, 10)
  arena_free(arena)
}

-- Adversarial: minimal
test "eff_h_adv_minimal" {
  Test.assert_eq(handle E.f() { E.f() -> resume(1) }, 1)
}

-- Adversarial: handler with no captures
test "eff_h_adv_no_cap" {
  Test.assert_eq(handle E.f() { E.f() -> resume(77) }, 77)
}

