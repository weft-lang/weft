trait AssocValue4d {
  fn assoc_value(self) -> i64
}

impl AssocValue4d for i64 {
  fn assoc_value(self) -> i64 { self }
}

trait AssocSource4d {
  type Item: AssocValue4d
  fn get(self, value: Item) -> Item
  fn keep(self, value: Self.Item) -> Self.Item
}

type AssocHolder4d<T> {
  AssocHolder4d(T)
}

impl<T: AssocValue4d> AssocSource4d for AssocHolder4d<T> {
  type Item = T

  fn get(self, value: Self.Item) -> Self.Item { value }

  fn keep(self, value: Item) -> Item { value }
}

test "associated type unqualified projection" {
  let holder: AssocHolder4d<i64> = AssocHolder4d(42)
  Test.assert_eq(holder.get(42), 42)
}

test "associated type explicit Self projection" {
  let holder: AssocHolder4d<i64> = AssocHolder4d(1)
  Test.assert_eq(holder.keep(42), 42)
}

