  pipeline_ir_abort_cleanup_add_acquisition_fact(facts, 3, 3, cg_owned_drop_type_hash(typeck_linear_layout_plan_type(leaf)), pipeline_ir_abort_cleanup_owned_kind())
  fmap_set_current_abort_cleanup_facts(fm, facts)
  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, plan), 1)
  let homes = pipeline_ir_native_identity_home_facts(4)

  let ok_code = buf_new(2048)
