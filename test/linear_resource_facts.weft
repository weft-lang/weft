  Test.assert_eq(node_f3(fact), pipeline_ir_abort_cleanup_structural_kind())
  Test.assert_eq(pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, facts), 1)
  Test.assert_eq(pipeline_ir_abort_cleanup_inst_has_action(ir_inst_structural_drop_i64(0, plan), 0, node_f2(fact), node_f3(fact)), 1)
}

