use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/effects.{continuation_cleanup_kind_none}
use runtime/memory.{*}
use compiler/lib.{*}
use compiler/codegen.{*}
use compiler/diagnose.{*}
use compiler/encode.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use compiler/typeck.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use stdlib/diagnostic/schema.{*}

fn linear_test_native_word_count(code: i64, target: i64) -> i64 {
  let mut count = 0
  let mut pos = 0
  while pos + 4 <= buf_len(code) {
    if pipeline_native_code_word(code, pos) == target { count = count + 1 } else { 0 }
    pos = pos + 4
  }
  count
}

fn linear_test_args1(arg: i64) -> i64 {
  let args = nlist_new()
  nlist_add(args, arg)
  args
}

fn linear_test_args2(first: i64, second: i64) -> i64 {
  let args = nlist_new()
  nlist_add(args, first)
  nlist_add(args, second)
  args
}

fn linear_test_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  mem_store64(fields + index * 24, ns)
  mem_store64(fields + index * 24 + 8, nl)
  mem_store64(fields + index * 24 + 16, ty)
  0
}

fn linear_test_variant(src: i64, variants: i64, index: i64, ns: i64, nl: i64, payloads: i64) -> i64 {
  mem_store64(variants + index * 40, ns)
  mem_store64(variants + index * 40 + 8, nl)
  mem_store64(variants + index * 40 + 16, str_hash(src, ns, nl))
  mem_store64(variants + index * 40 + 24, if payloads == 0 { 0 } else { nlist_len(payloads) })
  mem_store64(variants + index * 40 + 32, payloads)
  0
}

fn linear_test_token() -> i64 {
  ty_named(str_hash(__str_ptr("Token"), 0, 5), ty_i64())
}

test "loop cleanup follows linear transfer through aggregate constructors" {
  let payload = 10
  let variant = ir_inst_variant_init_i64(
    20, 7001, ir_value_list_prepend(payload, ir_value_list_empty()), 0
  )
  let nested = ir_inst_variant_init_i64(
    21, 7002, ir_value_list_prepend(20, ir_value_list_empty()), 0
  )
  let variant_insts = ir_inst_list_prepend(
    variant,
    ir_inst_list_prepend(nested, ir_inst_list_empty())
  )
  let carried = IrBlock(
    1,
    ir_value_list_empty(),
    variant_insts,
    ir_term_jump_args(99, ir_value_list_prepend(21, ir_value_list_empty()))
  )
  let unrelated = IrBlock(
    2,
    ir_value_list_empty(),
    variant_insts,
    ir_term_jump_args(99, ir_value_list_prepend(30, ir_value_list_empty()))
  )
  Test.assert_eq(pipeline_ir_block_loop_scope_cleanup_applies(carried, payload, 97, 98, 99, 0, 0), 0)
  Test.assert_eq(pipeline_ir_block_loop_scope_cleanup_applies(unrelated, payload, 97, 98, 99, 0, 0), 1)

  let record = ir_inst_record_init_i64(
    22,
    8001,
    ir_record_field_list_prepend(8101, 0, payload, ir_record_field_list_empty())
  )
  let record_exit = IrBlock(
    3,
    ir_value_list_empty(),
    ir_inst_list_prepend(record, ir_inst_list_empty()),
    ir_term_return(22)
  )
  Test.assert_eq(pipeline_ir_block_loop_scope_cleanup_applies(record_exit, payload, 97, 98, 99, 0, 0), 0)

  let layout_word = ir_inst_record_layout_init_i64(
    23,
    8002,
    8,
    8,
    ir_record_layout_field_list_prepend_word(
      8102, 0, payload, continuation_cleanup_kind_none(), ir_record_layout_field_list_empty()
    )
  )
  let layout_word_exit = IrBlock(
    4,
    ir_value_list_empty(),
    ir_inst_list_prepend(layout_word, ir_inst_list_empty()),
    ir_term_return(23)
  )
  Test.assert_eq(pipeline_ir_block_loop_scope_cleanup_applies(layout_word_exit, payload, 97, 98, 99, 0, 0), 0)

  let layout_array = ir_inst_record_layout_init_i64(
    24,
    8003,
    8,
    8,
    ir_record_layout_field_list_prepend_array(
      8103, 0, payload, 8, 1, 8, continuation_cleanup_kind_none(), ir_record_layout_field_list_empty()
    )
  )
  let layout_array_exit = IrBlock(
    5,
    ir_value_list_empty(),
    ir_inst_list_prepend(layout_array, ir_inst_list_empty()),
    ir_term_return(24)
  )
  Test.assert_eq(pipeline_ir_block_loop_scope_cleanup_applies(layout_array_exit, payload, 97, 98, 99, 0, 0), 1)
}

test "loop cleanup preserves an unconditional linear prefix across synthetic CFG roots" {
  let source = 5
  let entry = ir_block_new_term(8, ir_inst_list_empty(), ir_term_jump(10))
  let split = ir_block_new_term(
    10,
    ir_inst_list_prepend(
      ir_inst_structural_split_i64(source, 7001, 0, 0),
      ir_inst_list_empty()
    ),
    ir_term_jump(37)
  )
  let normal = ir_block_new_term(37, ir_inst_list_empty(), ir_term_jump(9))
  -- Handler and cleanup lowering can add a semantic successor whose dynamic
  -- predecessor is outside this recursively lowered subgraph.
  let synthetic_root = ir_block_new_term(22, ir_inst_list_empty(), ir_term_jump(9))
  let exit = ir_block_new_term(9, ir_inst_list_empty(), ir_term_jump(99))
  let blocks = ir_block_list_prepend(
    entry,
    ir_block_list_prepend(
      split,
      ir_block_list_prepend(
        normal,
        ir_block_list_prepend(synthetic_root, ir_block_list_prepend(exit, ir_block_list_empty()))
      )
    )
  )

  Test.assert_eq(pipeline_ir_block_paths_consume_value(blocks, blocks, 9, source, 0, 0, ir_value_list_empty()), 0)
  Test.assert_eq(pipeline_ir_block_list_entry_prefix_consumes_value(blocks, source, 0, 0), 1)
  Test.assert_eq(pipeline_ir_block_list_loop_scope_cleanup_count(blocks, source, 97, 98, 99, 0, 0), 0)

  let call_before_split = ir_block_new_term(
    8,
    ir_inst_list_prepend(ir_inst_call_i64(6, 9001, ir_value_list_empty()), ir_inst_list_empty()),
    ir_term_jump(10)
  )
  let barrier_blocks = ir_block_list_prepend(
    call_before_split,
    ir_block_list_prepend(
      split,
      ir_block_list_prepend(
        normal,
        ir_block_list_prepend(synthetic_root, ir_block_list_prepend(exit, ir_block_list_empty()))
      )
    )
  )
  Test.assert_eq(pipeline_ir_block_list_entry_prefix_consumes_value(barrier_blocks, source, 0, 0), 0)
  Test.assert_eq(pipeline_ir_block_list_loop_scope_cleanup_count(barrier_blocks, source, 97, 98, 99, 0, 0), 1)
}

test "linear_layout_distinguishes_copyable_owned_and_unique_roots" {
  let scalar = typeck_linear_layout_type(0, ty_i64())
  Test.assert_eq(typeck_linear_layout_fact_decision(scalar), typeck_linear_layout_decision_copyable())
  Test.assert_eq(typeck_linear_layout_fact_plan(scalar), 0)

  let owned_ty = ty_owned(linear_test_token())
  let owned = typeck_linear_layout_type(0, owned_ty)
  let plan = typeck_linear_layout_fact_plan(owned)
  Test.assert_eq(typeck_linear_layout_fact_decision(owned), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 1)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(plan), owned_ty), 1)
  Test.assert_eq(typeck_linear_layout_plan_words(plan), 1)

  -- Importing an opaque resource can deliberately hide its representation.
  -- The owned resource boundary still carries one ABI owner lane.
  let hidden_resource = ty_named_with_metadata(9017, 0, 0, ty_named_opaque_meta(0))
  let hidden_owned_ty = ty_owned(hidden_resource)
  let hidden_owned = typeck_linear_layout_type(0, hidden_owned_ty)
  let hidden_plan = typeck_linear_layout_fact_plan(hidden_owned)
  Test.assert_eq(ty_value_storage_word_count(hidden_owned_ty), 0)
  Test.assert_eq(typeck_linear_layout_fact_decision(hidden_owned), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(hidden_plan), 1)
  Test.assert_eq(typeck_linear_layout_plan_words(hidden_plan), 1)

  -- A typed let annotation describes its binding, not the result of the
  -- enclosing expression. CFG initializer inference must follow the body
  -- through defer and recover the scalar tail instead of inventing a linear
  -- cleanup obligation for the outer binding.
  let local_src = __str_ptr("token")
  let typed_let = LetTyped(
    Let(0, 5, IntLit(1, 0, 0), IntLit(0, 0, 0)),
    type_expr_from_node(owned_ty)
  )
  let inferred = pipeline_init_type_node_typed(
    Defer(IntLit(1, 0, 0), typed_let, 0),
    0,
    pipeline_value_env_empty(),
    pipeline_lower_module(local_src, 0)
  )
  Test.assert_eq(ty_eq(inferred, ty_i64()), 1)

  let unique = typeck_linear_layout_type(0, ty_unique(ty_i64()))
  Test.assert_eq(typeck_linear_layout_fact_decision(unique), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(unique), typeck_linear_layout_reason_unique())
}

test "linear_layout_fact_producer_memoizes_semantically_equal_types" {
  let tt = ttable_new()
  let first_fields = nlist_new()
  nlist_add(first_fields, ty_record_field(41, ty_owned(linear_test_token()), 0, 0))
  let second_fields = nlist_new()
  nlist_add(second_fields, ty_record_field(41, ty_owned(linear_test_token()), 0, 0))
  let first_ty = ty_record(first_fields, 0)
  let second_ty = ty_record(second_fields, 0)

  let first = typeck_linear_layout_type(tt, first_ty)
  let second = typeck_linear_layout_type(tt, second_ty)
  Test.assert_eq(ty_eq(first_ty, second_ty), 1)
  Test.assert_eq(first, second)
  Test.assert_eq(typeck_linear_layout_fact_plan(first), typeck_linear_layout_fact_plan(second))
}

test "linear_layout_fact_cache_restores_persistent_bucket_heads" {
  let tt = ttable_new()
  let persistent_ty = ty_owned(linear_test_token())
  let persistent = typeck_linear_layout_type(tt, persistent_ty)
  let mark = alloc_bump_mark()
  let checkpoint = ttable_linear_layout_cache_checkpoint(tt)
  let scratch_ty = ty_owned(ty_named(type_name_hash(__str_ptr("Other"), 0, 5), ty_i64()))
  let scratch = typeck_linear_layout_type(tt, scratch_ty)
  Test.assert_eq(typeck_linear_layout_fact_decision(scratch), typeck_linear_layout_decision_linear())
  Test.assert_eq(ttable_linear_layout_fact_lookup(tt, scratch_ty), scratch)
  ttable_linear_layout_cache_restore(tt, checkpoint)
  Test.assert_eq(ttable_linear_layout_fact_lookup(tt, scratch_ty), 0)
  Test.assert_eq(ttable_linear_layout_fact_lookup(tt, persistent_ty), persistent)
  alloc_bump_restore_same_segment(mark)
}

test "type_equality_handles_absent_optional_children" {
  Test.assert_eq(ty_eq(0, 0), 1)
  Test.assert_eq(ty_eq(0, ty_i64()), 0)
  let hash = type_name_hash(__str_ptr("Token"), 0, 5)
  Test.assert_eq(ty_eq(ty_named(hash, 0), ty_named(hash, 0)), 1)
}

test "linear_layout_fact_cache_versions_registry_growth" {
  let src = __str_ptr("Packetresource")
  let tt = ttable_new()
  let packet_hash = type_name_hash(src, 0, 6)
  let packet_ty = ty_named(packet_hash, ty_i64())
  let unresolved = typeck_linear_layout_type(tt, packet_ty)
  Test.assert_eq(typeck_linear_layout_fact_decision(unresolved), typeck_linear_layout_decision_copyable())

  let arena = arena_new(64)
  let fields = arena_alloc(arena, 24, 8)
  linear_test_field(fields, 0, 6, 8, ty_owned(linear_test_token()))
  ttable_add(tt, src, 0, 6, 0, 1, fields, nlist_new())
  let resolved = typeck_linear_layout_type(tt, packet_ty)
  Test.assert_eq(typeck_linear_layout_fact_decision(resolved), typeck_linear_layout_decision_linear())
  Test.assert_eq(resolved == unresolved, 0)
  arena_free(arena)
}

test "linear_layout_records_use_canonical_offsets_and_exact_paths" {
  let owned_ty = ty_owned(linear_test_token())
  let fields = nlist_new()
  nlist_add(fields, ty_record_field(202, owned_ty, 0, 0))
  nlist_add(fields, ty_record_field(101, ty_i64(), 0, 0))
  let record_ty = ty_record(fields, 0)
  let fact = typeck_linear_layout_type(0, record_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let children = typeck_linear_layout_plan_children(plan)
  let child = nlist_get(children, 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 2)
  Test.assert_eq(typeck_linear_layout_plan_words(plan), 2)
  Test.assert_eq(nlist_len(children), 1)
  Test.assert_eq(typeck_linear_layout_component_kind(child), 1)
  Test.assert_eq(typeck_linear_layout_component_key(child), 202)
  Test.assert_eq(typeck_linear_layout_component_index(child), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 1)
  Test.assert_eq(typeck_linear_layout_plan_kind(typeck_linear_layout_component_plan(child)), 1)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 1)
  Test.assert_eq(typeck_linear_layout_path_key(path), 202)
  Test.assert_eq(typeck_linear_layout_path_index(path), 1)
  Test.assert_eq(typeck_linear_layout_path_offset(path), 1)
}

test "linear_layout_tuples_preserve_position_and_nested_plan" {
  let nested_fields = nlist_new()
  nlist_add(nested_fields, ty_record_field(77, ty_owned(linear_test_token()), 0, 0))
  let elems = nlist_new()
  nlist_add(elems, ty_str())
  nlist_add(elems, ty_record(nested_fields, 0))
  let fact = typeck_linear_layout_type(0, ty_tuple(elems))
  let plan = typeck_linear_layout_fact_plan(fact)
  let child = nlist_get(typeck_linear_layout_plan_children(plan), 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 3)
  Test.assert_eq(typeck_linear_layout_component_kind(child), 2)
  Test.assert_eq(typeck_linear_layout_component_index(child), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 1)
  Test.assert_eq(typeck_linear_layout_plan_kind(typeck_linear_layout_component_plan(child)), 2)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 2)
  Test.assert_eq(typeck_linear_layout_path_index(path), 1)
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_path_rest(path)), 1)
  Test.assert_eq(typeck_linear_layout_path_key(typeck_linear_layout_path_rest(path)), 77)
}

test "linear_layout_generic_result_is_contagiously_linear_after_substitution" {
  let src = __str_ptr("ResultOkErr")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  nlist_add(tparams, node_new(2, 1, 1, 0, 0))
  let ok_payloads = nlist_new()
  let err_payloads = nlist_new()
  nlist_add(ok_payloads, ty_var(0))
  nlist_add(err_payloads, ty_var(1))
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 6, 2, ok_payloads)
  linear_test_variant(src, variants, 1, 8, 3, err_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, tparams)
  let result_hash = type_name_hash(src, 0, 6)

  let copyable_ty = ty_named_app(result_hash, ty_i64(), linear_test_args2(ty_i64(), ty_str()))
  Test.assert_eq(typeck_linear_layout_fact_decision(typeck_linear_layout_type(tt, copyable_ty)), typeck_linear_layout_decision_copyable())
  Test.assert_eq(typeck_ty_is_linear(tt, copyable_ty), 0)

  let owned_ty = ty_owned(linear_test_token())
  let linear_ty = ty_named_app(result_hash, ty_i64(), linear_test_args2(owned_ty, ty_str()))
  let fact = typeck_linear_layout_type(tt, linear_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let alternatives = typeck_linear_layout_plan_children(plan)
  let ok = nlist_get(alternatives, 0)
  let err = nlist_get(alternatives, 1)
  let payload = nlist_get(typeck_linear_layout_variant_payloads(ok), 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_ty_is_linear(tt, linear_ty), 1)
  Test.assert_str_eq(typeck_linear_use_twice_message(tt, linear_ty), "type error: linear aggregate value used more than once")
  Test.assert_str_eq(typeck_linear_capture_message(tt, linear_ty), "type error: linear aggregate value cannot be captured by closure")
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 5)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(plan), linear_ty), 1)
  Test.assert_eq(nlist_len(alternatives), 2)
  Test.assert_eq(typeck_linear_layout_variant_hash(ok), str_hash(src, 6, 2))
  Test.assert_eq(typeck_linear_layout_variant_index(ok), 0)
  Test.assert_eq(typeck_linear_layout_variant_words(ok), 2)
  Test.assert_eq(nlist_len(typeck_linear_layout_variant_payloads(ok)), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(payload), 1)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(typeck_linear_layout_component_plan(payload)), owned_ty), 1)
  Test.assert_eq(typeck_linear_layout_variant_index(err), 1)
  Test.assert_eq(nlist_len(typeck_linear_layout_variant_payloads(err)), 0)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 3)
  Test.assert_eq(typeck_linear_layout_path_key(path), str_hash(src, 6, 2))
  Test.assert_eq(typeck_linear_layout_path_index(path), 0)
  Test.assert_eq(typeck_linear_layout_path_offset(path), 1)

  let copyable_try = pipeline_try_inst_for_type(8, 7, 6384065697, copyable_ty, tt)
  let linear_try = pipeline_try_inst_for_type(8, 7, 6384065697, linear_ty, tt)
  Test.assert_eq(ir_inst_tag(copyable_try), 22)
  Test.assert_eq(pipeline_try_inst_next_value(copyable_try, 8), 9)
  Test.assert_eq(ir_inst_tag(linear_try), 54)
  Test.assert_eq(pipeline_try_inst_next_value(linear_try, 8), 10)
  Test.assert_eq(pipeline_ir_live_inst_def(linear_try), 8)
  Test.assert_eq(pipeline_ir_max_inst_value(linear_try, 0), 9)
  Test.assert_eq(
    pipeline_ir_abort_cleanup_inst_has_action(
      linear_try,
      7,
      pipeline_structural_drop_glue_hash(plan),
      pipeline_ir_abort_cleanup_structural_kind()
    ),
    1
  )
  match linear_try {
    IrTryLinearI64(dst, value, effect_key, parent_plan, ok_plan, error_plan) -> {
      Test.assert_eq(dst, 8)
      Test.assert_eq(value, 7)
      Test.assert_eq(typeck_linear_layout_plan_identity(parent_plan), typeck_linear_layout_plan_identity(plan))
      Test.assert_eq(typeck_linear_layout_plan_kind(ok_plan), 1)
      Test.assert_eq(error_plan, 0)
    }
    _ -> Test.assert_eq(0, 1)
  }

  let wide_success_elems = nlist_new()
  nlist_add(wide_success_elems, ty_i64())
  nlist_add(wide_success_elems, ty_i64())
  nlist_add(wide_success_elems, ty_bool())
  let wide_error_elems = nlist_new()
  nlist_add(wide_error_elems, ty_i64())
  nlist_add(wide_error_elems, ty_i64())
  nlist_add(wide_error_elems, ty_bool())
  let wide_success_ty = ty_owned(ty_tuple(wide_success_elems))
  let wide_error_ty = ty_tuple(wide_error_elems)
  let wide_linear_ty = ty_named_app(
    result_hash,
    ty_i64(),
    linear_test_args2(wide_success_ty, wide_error_ty)
  )
  let wide_try = pipeline_try_inst_for_type(20, 19, 6384065697, wide_linear_ty, tt)
  let wide_plan = typeck_linear_layout_fact_plan(typeck_linear_layout_type(tt, wide_linear_ty))
  let wide_insts = pipeline_try_insts(wide_try, 20, 19, 3)

  Test.assert_eq(pipeline_try_linear_success_lane_count(wide_plan), 3)
  Test.assert_eq(pipeline_try_linear_error_lane_count(wide_plan), 3)
  Test.assert_eq(pipeline_try_linear_scratch_lane_count(wide_plan), 3)
  Test.assert_eq(pipeline_try_inst_next_value(wide_try, 20), 26)
  Test.assert_eq(pipeline_ir_max_inst_value(wide_try, 0), 25)
  Test.assert_eq(ir_inst_list_len(wide_insts), 3)
  match wide_insts {
    IrInstCons(first, IrInstCons(second, IrInstCons(third, IrInstNil))) -> {
      Test.assert_eq(ir_inst_tag(first), 54)
      match second {
        IrTryResultLaneI64(dst, scratch) -> {
          Test.assert_eq(dst, 21)
          Test.assert_eq(scratch, 24)
        }
        _ -> Test.assert_eq(0, 1)
      }
      match third {
        IrTryResultLaneI64(dst, scratch) -> {
          Test.assert_eq(dst, 22)
          Test.assert_eq(scratch, 25)
        }
        _ -> Test.assert_eq(0, 1)
      }
    }
    _ -> Test.assert_eq(0, 1)
  }
  arena_free(arena)
}

test "linear_layout_named_record_substitutes_fields_before_classification" {
  let src = __str_ptr("Envelopevaluecode")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  let fields = arena_alloc(arena, 48, 8)
  linear_test_field(fields, 0, 8, 5, ty_var(0))
  linear_test_field(fields, 1, 13, 4, ty_i64())
  ttable_add(tt, src, 0, 8, 0, 2, fields, tparams)
  let envelope_hash = type_name_hash(src, 0, 8)
  let envelope_ty = ty_named_app(envelope_hash, ty_i64(), linear_test_args1(ty_owned(linear_test_token())))
  let fact = typeck_linear_layout_type(tt, envelope_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let child = nlist_get(typeck_linear_layout_plan_children(plan), 0)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 4)
  Test.assert_eq(typeck_linear_layout_plan_identity(plan), ty_semantic_hash(envelope_ty))
  Test.assert_eq(typeck_linear_layout_component_key(child), str_hash(src, 8, 5))
  Test.assert_eq(typeck_linear_layout_component_index(child), 0)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 0)
  arena_free(arena)
}

test "linear_layout_rejects_recursive_resource_variants_but_accepts_copyable_recursion" {
  let src = __str_ptr("ChainEndMore")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  let chain_hash = type_name_hash(src, 0, 5)
  let recursive_ty = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_var(0)))
  let end_payloads = nlist_new()
  let more_payloads = nlist_new()
  nlist_add(more_payloads, ty_var(0))
  nlist_add(more_payloads, recursive_ty)
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 5, 3, end_payloads)
  linear_test_variant(src, variants, 1, 8, 4, more_payloads)
  ttable_add(tt, src, 0, 5, 1, 2, variants, tparams)

  let copyable_chain = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_i64()))
  Test.assert_eq(typeck_linear_layout_fact_decision(typeck_linear_layout_type(tt, copyable_chain)), typeck_linear_layout_decision_copyable())

  let linear_chain = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_owned(linear_test_token())))
  let fact = typeck_linear_layout_type(tt, linear_chain)
  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(fact), typeck_linear_layout_reason_recursive())
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_fact_path(fact)), 3)
  arena_free(arena)
}

test "linear_layout_keeps_arbitrary_containers_and_untagged_sets_fenced" {
  let owned_ty = ty_owned(linear_test_token())
  let array = typeck_linear_layout_type(0, ty_array(owned_ty, 4))
  Test.assert_eq(typeck_linear_layout_fact_decision(array), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(array), typeck_linear_layout_reason_container())

  let vector_hash = str_hash(__str_ptr("Vector"), 0, 6)
  let vector = typeck_linear_layout_type(0, ty_named_app(vector_hash, ty_i64(), linear_test_args1(owned_ty)))
  Test.assert_eq(typeck_linear_layout_fact_decision(vector), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(vector), typeck_linear_layout_reason_container())
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_fact_path(vector)), 4)
  Test.assert_eq(typeck_linear_layout_path_index(typeck_linear_layout_fact_path(vector)), 0)

  let union = typeck_linear_layout_type(0, ty_union(ty_i64(), owned_ty))
  Test.assert_eq(typeck_linear_layout_fact_decision(union), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(union), typeck_linear_layout_reason_set_operator())
}

test "linear_use_checker_consumes_contagious_generic_fact" {
  let src = __str_ptr("ResultOkErrx")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  nlist_add(tparams, node_new(2, 1, 1, 0, 0))
  let ok_payloads = nlist_new()
  let err_payloads = nlist_new()
  nlist_add(ok_payloads, ty_var(0))
  nlist_add(err_payloads, ty_var(1))
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 6, 2, ok_payloads)
  linear_test_variant(src, variants, 1, 8, 3, err_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, tparams)
  let result_ty = ty_named_app(
    type_name_hash(src, 0, 6),
    ty_i64(),
    linear_test_args2(ty_owned(linear_test_token()), ty_i64())
  )
  let body = node_new(3, 0, node_new(2, 11, 1, 0, 0), node_new(2, 11, 1, 0, 0), 0)
  let observed = alloc_zeroed(8)
  mem_store64(observed, 0)
  let errors = handle check_unique_binding_usage(src, 11, 1, result_ty, body, tt) {
    Diagnose.error(message, span) -> {
      Test.assert_str_eq(message, "type error: linear aggregate value used more than once")
      mem_store64(observed, mem_load64(observed) + 1)
      resume(0)
    }
  }
  Test.assert_eq(errors, 1)
  Test.assert_eq(mem_load64(observed), 1)
  arena_free(arena)
}

test "structural_drop_ir_carries_one_value_use_and_an_opaque_plan" {
  let plan = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 991)
  let inst = ir_inst_structural_drop_i64(7, plan)
  Test.assert_eq(ir_inst_tag(inst), 52)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 0 - 1)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 1)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(inst), 0)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 7)

  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)

  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3)
  match pipeline_ir_rewrite_inst_uses(inst, aliases) {
    IrStructuralDropI64(value, plan) -> {
      Test.assert_eq(value, 3)
      Test.assert_eq(typeck_linear_layout_plan_identity(plan), 991)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "structural_split_ir_disarms_parent_and_preserves_exact_residual_fact" {
  let parent = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 992)
  let residual = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 993)
  let inst = ir_inst_structural_split_i64(7, parent, residual, 1)
  Test.assert_eq(ir_inst_tag(inst), 53)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 0 - 1)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 1)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 7)
  Test.assert_eq(
    pipeline_ir_abort_cleanup_inst_has_action(
      inst,
      7,
      cg_owned_drop_type_hash(typeck_linear_layout_plan_type(parent)),
      pipeline_ir_abort_cleanup_owned_kind()
    ),
    1
  )

  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)

  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3)
  match pipeline_ir_rewrite_inst_uses(inst, aliases) {
    IrStructuralSplitI64(value, rewritten_parent, rewritten_residual, release_backing) -> {
      Test.assert_eq(value, 3)
      Test.assert_eq(typeck_linear_layout_plan_identity(rewritten_parent), 992)
      Test.assert_eq(typeck_linear_layout_plan_identity(rewritten_residual), 993)
      Test.assert_eq(release_backing, 1)
    }
    _ -> Test.assert_eq(0, 1)
  }
}

test "structural_drop_plan_validation_is_exact_and_fail_closed" {
  let owned_ty = ty_owned(ty_named(7001, ty_i64()))
  let leaf = typeck_linear_layout_plan(1, owned_ty, 0, 1, 7101)
  let payloads = nlist_new()
  nlist_add(payloads, typeck_linear_layout_component(3, 8001, 0, 1, leaf))
  let alternatives = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8001, 0, payloads, 2))
  let empty_payloads = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8002, 1, empty_payloads, 1))
  let plan = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9101)

  Test.assert_eq(pipeline_structural_drop_plan_is_valid(leaf), 1)
  Test.assert_eq(pipeline_structural_drop_plan_is_valid(plan), 1)
  Test.assert_eq(pipeline_structural_drop_plan_value_words(plan), 1)
  Test.assert_eq(pipeline_structural_drop_glue_hash(plan), pipeline_structural_drop_glue_hash(plan))
  let other = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9102)
  Test.assert_eq(if pipeline_structural_drop_glue_hash(plan) == pipeline_structural_drop_glue_hash(other) { 1 } else { 0 }, 0)

  let invalid = typeck_linear_layout_plan(2, ty_i64(), nlist_new(), 1, 9201)
  Test.assert_eq(pipeline_structural_drop_plan_is_valid(invalid), 0)
  let code = buf_new(64)
  let fm = fmap_new()
  pipeline_ir_native_emit_structural_drop(code, 0, invalid, fm, pipeline_ir_native_identity_home_facts(1))
  Test.assert_eq(buf_len(code), 4)
  Test.assert_eq(pipeline_native_code_word(code, 0), encode_brk(66))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}

test "structural_drop_named_variant_emits_one_cached_tagged_glue" {
  let owned_ty = ty_owned(ty_named(7001, ty_i64()))
  let leaf = typeck_linear_layout_plan(1, owned_ty, 0, 1, 7101)
  let payloads = nlist_new()
  nlist_add(payloads, typeck_linear_layout_component(3, 8001, 0, 1, leaf))
  let alternatives = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8001, 0, payloads, 2))
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8002, 1, 0, 1))
  let plan = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9101)
  let code = buf_new(4096)
  let fm = fmap_new()
  fmap_add(fm, __str_ptr("rc_default_release"), 0, 18, 8192)
  mmap_add(fmap_mmap(fm), 7001, cg_drop_method_hash(), 4096, 0)
  let homes = pipeline_ir_native_identity_home_facts(1)

  pipeline_ir_native_emit_structural_drop(code, 0, plan, fm, homes)
  let first_len = buf_len(code)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(linear_test_native_word_count(code, encode_sub_imm(31, 31, 16)), 1)
  Test.assert_eq(linear_test_native_word_count(code, encode_cmp(16, 17)), 2)
  Test.assert_eq(linear_test_native_word_count(code, encode_ret()), 1)
  Test.assert_eq(fmap_typed_method_call_emit_count(fm), 1)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), pipeline_structural_drop_glue_hash(plan)) > 1 { 1 } else { 0 }, 1)

  pipeline_ir_native_emit_structural_drop(code, 0, plan, fm, homes)
  Test.assert_eq(if buf_len(code) > first_len { 1 } else { 0 }, 1)
  Test.assert_eq(linear_test_native_word_count(code, encode_ret()), 1)
  Test.assert_eq(fmap_typed_method_call_emit_count(fm), 1)
}

test "structural_drop_flat_record_walks_owned_lanes_inline" {
  let leaf_a = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let leaf_b = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(1, 8101, 0, 0, leaf_a))
  nlist_add(children, typeck_linear_layout_component(1, 8102, 2, 2, leaf_b))
  let plan = typeck_linear_layout_plan(2, ty_i64(), children, 3, 9301)
  let drop = ir_inst_structural_drop_i64(7, plan)
  Test.assert_eq(pipeline_structural_drop_plan_use_words(plan), 3)
  Test.assert_eq(pipeline_ir_max_inst_value(drop, 0), 9)
  let uses = pipeline_ir_live_set_add_inst_uses(drop, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 3)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 8), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 9), 1)
  Test.assert_eq(pipeline_ir_inst_multi_lane_capture_uses(drop, 7), 1)
  Test.assert_eq(pipeline_ir_inst_multi_lane_capture_uses(drop, 8), 1)
  Test.assert_eq(pipeline_ir_inst_multi_lane_capture_uses(drop, 9), 1)
  Test.assert_eq(pipeline_ir_inst_multi_lane_capture_uses(drop, 10), 0)
  let params = ir_value_list_prepend(7, ir_value_list_prepend(8, ir_value_list_prepend(9, ir_value_list_empty())))
  let blocks = ir_block_list_prepend(
    IrBlock(0, params, ir_inst_list_prepend(drop, ir_inst_list_empty()), ir_term_return(0)),
    ir_block_list_empty()
  )
  Test.assert_eq(pipeline_ir_block_params_feed_multi_lane_capture(blocks, 0), 1)
  let code = buf_new(256)
  let fm = fmap_new()
  mmap_add(fmap_mmap(fm), 7001, cg_drop_method_hash(), 4096, 0)
  mmap_add(fmap_mmap(fm), 7002, cg_drop_method_hash(), 8192, 0)

  pipeline_ir_native_emit_structural_drop(code, 0, plan, fm, pipeline_ir_native_identity_home_facts(3))
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(fmap_typed_method_call_emit_count(fm), 2)
  Test.assert_eq(linear_test_native_word_count(code, encode_ret()), 0)
  Test.assert_eq(mono_cache_lookup(fmap_mono_cache(fm), pipeline_structural_drop_glue_hash(plan)), 0)
  Test.assert_eq(if buf_len(code) >= 8 { 1 } else { 0 }, 1)
}

test "structural_drop_registry_deduplicates_exact_plans_and_rejects_collisions" {
  let alternatives = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8002, 0, 0, 1))
  let plan = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9101)
  let equivalent = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9101)
  let collision = typeck_linear_layout_plan(5, ty_named(9002, ty_i64()), alternatives, 1, 9101)
  let key = pipeline_structural_drop_glue_hash(plan)
  let fm = fmap_new()

  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, plan), 1)
  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, equivalent), 0)
  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, collision), 0 - 1)
  Test.assert_eq(fmap_structural_drop_plan_count(fm), 1)
  Test.assert_eq(fmap_structural_drop_plan_lookup(fm, key), plan)
}

test "structural_drop_abort_fact_replaces_plain_backing_release" {
  let owned_ty = ty_owned(ty_named(7001, ty_i64()))
  let leaf = typeck_linear_layout_plan(1, owned_ty, 0, 1, 7101)
  let ok_payloads = nlist_new()
