use runtime/alloc.{*}
use runtime/memory.{*}
use compiler/lib.{*}
use compiler/diagnose.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use compiler/typeck.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use stdlib/diagnostic_type.{*}

fn linear_test_args1(arg: i64) -> i64 {
  let args = nlist_new()
  nlist_add(args, arg)
  args
}

fn linear_test_args2(first: i64, second: i64) -> i64 {
  let args = nlist_new()
  nlist_add(args, first)
  nlist_add(args, second)
  args
}

fn linear_test_field(fields: i64, index: i64, ns: i64, nl: i64, ty: i64) -> i64 {
  mem_store64(fields + index * 24, ns)
  mem_store64(fields + index * 24 + 8, nl)
  mem_store64(fields + index * 24 + 16, ty)
  0
}

fn linear_test_variant(src: i64, variants: i64, index: i64, ns: i64, nl: i64, payloads: i64) -> i64 {
  mem_store64(variants + index * 40, ns)
  mem_store64(variants + index * 40 + 8, nl)
  mem_store64(variants + index * 40 + 16, str_hash(src, ns, nl))
  mem_store64(variants + index * 40 + 24, if payloads == 0 { 0 } else { nlist_len(payloads) })
  mem_store64(variants + index * 40 + 32, payloads)
  0
}

fn linear_test_token() -> i64 {
  ty_named(str_hash(__str_ptr("Token"), 0, 5), ty_i64())
}

test "linear_layout_distinguishes_copyable_owned_and_unique_roots" {
  let scalar = typeck_linear_layout_type(0, ty_i64())
  Test.assert_eq(typeck_linear_layout_fact_decision(scalar), typeck_linear_layout_decision_copyable())
  Test.assert_eq(typeck_linear_layout_fact_plan(scalar), 0)

  let owned_ty = ty_owned(linear_test_token())
  let owned = typeck_linear_layout_type(0, owned_ty)
  let plan = typeck_linear_layout_fact_plan(owned)
  Test.assert_eq(typeck_linear_layout_fact_decision(owned), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 1)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(plan), owned_ty), 1)
  Test.assert_eq(typeck_linear_layout_plan_words(plan), 1)

  let unique = typeck_linear_layout_type(0, ty_unique(ty_i64()))
  Test.assert_eq(typeck_linear_layout_fact_decision(unique), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(unique), typeck_linear_layout_reason_unique())
}

test "linear_layout_records_use_canonical_offsets_and_exact_paths" {
  let owned_ty = ty_owned(linear_test_token())
  let fields = nlist_new()
  nlist_add(fields, ty_record_field(202, owned_ty, 0, 0))
  nlist_add(fields, ty_record_field(101, ty_i64(), 0, 0))
  let record_ty = ty_record(fields, 0)
  let fact = typeck_linear_layout_type(0, record_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let children = typeck_linear_layout_plan_children(plan)
  let child = nlist_get(children, 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 2)
  Test.assert_eq(typeck_linear_layout_plan_words(plan), 2)
  Test.assert_eq(nlist_len(children), 1)
  Test.assert_eq(typeck_linear_layout_component_kind(child), 1)
  Test.assert_eq(typeck_linear_layout_component_key(child), 202)
  Test.assert_eq(typeck_linear_layout_component_index(child), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 1)
  Test.assert_eq(typeck_linear_layout_plan_kind(typeck_linear_layout_component_plan(child)), 1)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 1)
  Test.assert_eq(typeck_linear_layout_path_key(path), 202)
  Test.assert_eq(typeck_linear_layout_path_index(path), 1)
  Test.assert_eq(typeck_linear_layout_path_offset(path), 1)
}

test "linear_layout_tuples_preserve_position_and_nested_plan" {
  let nested_fields = nlist_new()
  nlist_add(nested_fields, ty_record_field(77, ty_owned(linear_test_token()), 0, 0))
  let elems = nlist_new()
  nlist_add(elems, ty_str())
  nlist_add(elems, ty_record(nested_fields, 0))
  let fact = typeck_linear_layout_type(0, ty_tuple(elems))
  let plan = typeck_linear_layout_fact_plan(fact)
  let child = nlist_get(typeck_linear_layout_plan_children(plan), 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 3)
  Test.assert_eq(typeck_linear_layout_component_kind(child), 2)
  Test.assert_eq(typeck_linear_layout_component_index(child), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 1)
  Test.assert_eq(typeck_linear_layout_plan_kind(typeck_linear_layout_component_plan(child)), 2)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 2)
  Test.assert_eq(typeck_linear_layout_path_index(path), 1)
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_path_rest(path)), 1)
  Test.assert_eq(typeck_linear_layout_path_key(typeck_linear_layout_path_rest(path)), 77)
}

test "linear_layout_generic_result_is_contagiously_linear_after_substitution" {
  let src = __str_ptr("ResultOkErr")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  nlist_add(tparams, node_new(2, 1, 1, 0, 0))
  let ok_payloads = nlist_new()
  let err_payloads = nlist_new()
  nlist_add(ok_payloads, ty_var(0))
  nlist_add(err_payloads, ty_var(1))
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 6, 2, ok_payloads)
  linear_test_variant(src, variants, 1, 8, 3, err_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, tparams)
  let result_hash = type_name_hash(src, 0, 6)

  let copyable_ty = ty_named_app(result_hash, ty_i64(), linear_test_args2(ty_i64(), ty_str()))
  Test.assert_eq(typeck_linear_layout_fact_decision(typeck_linear_layout_type(tt, copyable_ty)), typeck_linear_layout_decision_copyable())
  Test.assert_eq(typeck_ty_is_linear(tt, copyable_ty), 0)

  let owned_ty = ty_owned(linear_test_token())
  let linear_ty = ty_named_app(result_hash, ty_i64(), linear_test_args2(owned_ty, ty_str()))
  let fact = typeck_linear_layout_type(tt, linear_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let alternatives = typeck_linear_layout_plan_children(plan)
  let ok = nlist_get(alternatives, 0)
  let err = nlist_get(alternatives, 1)
  let payload = nlist_get(typeck_linear_layout_variant_payloads(ok), 0)
  let path = typeck_linear_layout_fact_path(fact)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_ty_is_linear(tt, linear_ty), 1)
  Test.assert_str_eq(typeck_linear_use_twice_message(tt, linear_ty), "type error: linear aggregate value used more than once")
  Test.assert_str_eq(typeck_linear_capture_message(tt, linear_ty), "type error: linear aggregate value cannot be captured by closure")
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 5)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(plan), linear_ty), 1)
  Test.assert_eq(nlist_len(alternatives), 2)
  Test.assert_eq(typeck_linear_layout_variant_hash(ok), str_hash(src, 6, 2))
  Test.assert_eq(typeck_linear_layout_variant_index(ok), 0)
  Test.assert_eq(typeck_linear_layout_variant_words(ok), 2)
  Test.assert_eq(nlist_len(typeck_linear_layout_variant_payloads(ok)), 1)
  Test.assert_eq(typeck_linear_layout_component_offset(payload), 1)
  Test.assert_eq(ty_eq(typeck_linear_layout_plan_type(typeck_linear_layout_component_plan(payload)), owned_ty), 1)
  Test.assert_eq(typeck_linear_layout_variant_index(err), 1)
  Test.assert_eq(nlist_len(typeck_linear_layout_variant_payloads(err)), 0)
  Test.assert_eq(typeck_linear_layout_path_kind(path), 3)
  Test.assert_eq(typeck_linear_layout_path_key(path), str_hash(src, 6, 2))
  Test.assert_eq(typeck_linear_layout_path_index(path), 0)
  Test.assert_eq(typeck_linear_layout_path_offset(path), 1)
  arena_free(arena)
}

test "linear_layout_named_record_substitutes_fields_before_classification" {
  let src = __str_ptr("Envelopevaluecode")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  let fields = arena_alloc(arena, 48, 8)
  linear_test_field(fields, 0, 8, 5, ty_var(0))
  linear_test_field(fields, 1, 13, 4, ty_i64())
  ttable_add(tt, src, 0, 8, 0, 2, fields, tparams)
  let envelope_hash = type_name_hash(src, 0, 8)
  let envelope_ty = ty_named_app(envelope_hash, ty_i64(), linear_test_args1(ty_owned(linear_test_token())))
  let fact = typeck_linear_layout_type(tt, envelope_ty)
  let plan = typeck_linear_layout_fact_plan(fact)
  let child = nlist_get(typeck_linear_layout_plan_children(plan), 0)

  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_linear())
  Test.assert_eq(typeck_linear_layout_plan_kind(plan), 4)
  Test.assert_eq(typeck_linear_layout_plan_identity(plan), ty_semantic_hash(envelope_ty))
  Test.assert_eq(typeck_linear_layout_component_key(child), str_hash(src, 8, 5))
  Test.assert_eq(typeck_linear_layout_component_index(child), 0)
  Test.assert_eq(typeck_linear_layout_component_offset(child), 0)
  arena_free(arena)
}

test "linear_layout_rejects_recursive_resource_variants_but_accepts_copyable_recursion" {
  let src = __str_ptr("ChainEndMore")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  let chain_hash = type_name_hash(src, 0, 5)
  let recursive_ty = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_var(0)))
  let end_payloads = nlist_new()
  let more_payloads = nlist_new()
  nlist_add(more_payloads, ty_var(0))
  nlist_add(more_payloads, recursive_ty)
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 5, 3, end_payloads)
  linear_test_variant(src, variants, 1, 8, 4, more_payloads)
  ttable_add(tt, src, 0, 5, 1, 2, variants, tparams)

  let copyable_chain = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_i64()))
  Test.assert_eq(typeck_linear_layout_fact_decision(typeck_linear_layout_type(tt, copyable_chain)), typeck_linear_layout_decision_copyable())

  let linear_chain = ty_named_app(chain_hash, ty_i64(), linear_test_args1(ty_owned(linear_test_token())))
  let fact = typeck_linear_layout_type(tt, linear_chain)
  Test.assert_eq(typeck_linear_layout_fact_decision(fact), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(fact), typeck_linear_layout_reason_recursive())
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_fact_path(fact)), 3)
  arena_free(arena)
}

test "linear_layout_keeps_arbitrary_containers_and_untagged_sets_fenced" {
  let owned_ty = ty_owned(linear_test_token())
  let array = typeck_linear_layout_type(0, ty_array(owned_ty, 4))
  Test.assert_eq(typeck_linear_layout_fact_decision(array), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(array), typeck_linear_layout_reason_container())

  let vector_hash = str_hash(__str_ptr("Vector"), 0, 6)
  let vector = typeck_linear_layout_type(0, ty_named_app(vector_hash, ty_i64(), linear_test_args1(owned_ty)))
  Test.assert_eq(typeck_linear_layout_fact_decision(vector), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(vector), typeck_linear_layout_reason_container())
  Test.assert_eq(typeck_linear_layout_path_kind(typeck_linear_layout_fact_path(vector)), 4)
  Test.assert_eq(typeck_linear_layout_path_index(typeck_linear_layout_fact_path(vector)), 0)

  let union = typeck_linear_layout_type(0, ty_union(ty_i64(), owned_ty))
  Test.assert_eq(typeck_linear_layout_fact_decision(union), typeck_linear_layout_decision_unsupported())
  Test.assert_eq(typeck_linear_layout_fact_reason(union), typeck_linear_layout_reason_set_operator())
}

test "linear_use_checker_consumes_contagious_generic_fact" {
  let src = __str_ptr("ResultOkErrx")
  let tt = ttable_new()
  let arena = arena_new(128)
  let tparams = nlist_new()
  nlist_add(tparams, node_new(2, 0, 1, 0, 0))
  nlist_add(tparams, node_new(2, 1, 1, 0, 0))
  let ok_payloads = nlist_new()
  let err_payloads = nlist_new()
  nlist_add(ok_payloads, ty_var(0))
  nlist_add(err_payloads, ty_var(1))
  let variants = arena_alloc(arena, 80, 8)
  linear_test_variant(src, variants, 0, 6, 2, ok_payloads)
  linear_test_variant(src, variants, 1, 8, 3, err_payloads)
  ttable_add(tt, src, 0, 6, 1, 2, variants, tparams)
  let result_ty = ty_named_app(
    type_name_hash(src, 0, 6),
    ty_i64(),
    linear_test_args2(ty_owned(linear_test_token()), ty_i64())
  )
  let body = node_new(3, 0, node_new(2, 11, 1, 0, 0), node_new(2, 11, 1, 0, 0), 0)
  let observed = alloc_zeroed(8)
  mem_store64(observed, 0)
  let errors = handle check_unique_binding_usage(src, 11, 1, result_ty, body, tt) {
    Diagnose.error(message, span) -> {
      Test.assert_str_eq(message, "type error: linear aggregate value used more than once")
      mem_store64(observed, mem_load64(observed) + 1)
      resume(0)
    }
  }
  Test.assert_eq(errors, 1)
  Test.assert_eq(mem_load64(observed), 1)
  arena_free(arena)
}

test "structural_drop_ir_carries_one_value_use_and_an_opaque_plan" {
  let inst = ir_inst_structural_drop_i64(7, 991)
  Test.assert_eq(ir_inst_tag(inst), 52)
  Test.assert_eq(pipeline_ir_live_inst_def(inst), 0 - 1)
  Test.assert_eq(pipeline_ir_live_inst_is_call(inst), 1)
  Test.assert_eq(pipeline_ir_native_inst_clobbers_pinned(inst), 1)
  Test.assert_eq(pipeline_ir_native_inst_preserves_fp_env(inst), 0)
  Test.assert_eq(pipeline_ir_max_inst_value(inst, 3), 7)

  let uses = pipeline_ir_live_set_add_inst_uses(inst, pipeline_ir_live_set_empty())
  Test.assert_eq(pipeline_ir_live_set_len(uses), 1)
  Test.assert_eq(pipeline_ir_live_set_contains(uses, 7), 1)

  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3)
  match pipeline_ir_rewrite_inst_uses(inst, aliases) {
    IrStructuralDropI64(value, plan) -> {
      Test.assert_eq(value, 3)
      Test.assert_eq(plan, 991)
    }
    _ -> Test.assert_eq(0, 1)
  }
}
