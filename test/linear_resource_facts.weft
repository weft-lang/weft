  Test.assert_eq(pipeline_native_code_word(bad_code, 0), encode_brk(67))
  Test.assert_eq(fmap_emit_error_count(fm), 1)
}

test "constructor_plan_lookup_crosses_zero_cost_enclosing_aggregates" {
  let leaf = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let payloads = nlist_new()
  nlist_add(payloads, typeck_linear_layout_component(3, 8001, 0, 1, leaf))
  let alternatives = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8001, 0, payloads, 2))
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8002, 1, 0, 1))
  let variant = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9101)
  let tuple_children = nlist_new()
  nlist_add(tuple_children, typeck_linear_layout_component(2, 0, 0, 0, variant))
  let tuple = typeck_linear_layout_plan(3, ty_i64(), tuple_children, 2, 9201)
  let wrapped_tuple = typeck_linear_layout_plan(6, ty_named(9002, ty_i64()), tuple, 2, 9301)

  Test.assert_eq(pipeline_ir_abort_cleanup_variant_plan_for_tag(wrapped_tuple, 8001), variant)
  Test.assert_eq(pipeline_ir_abort_cleanup_variant_plan_for_tag(wrapped_tuple, 8002), variant)
  Test.assert_eq(pipeline_ir_abort_cleanup_variant_plan_for_tag(wrapped_tuple, 8999), 0)

  let record_children = nlist_new()
  nlist_add(record_children, typeck_linear_layout_component(1, 8101, 0, 0, leaf))
  let record = typeck_linear_layout_plan(4, ty_named(9003, ty_i64()), record_children, 1, 9401)
  let record_tuple_children = nlist_new()
  nlist_add(record_tuple_children, typeck_linear_layout_component(2, 0, 0, 0, record))
  let record_tuple = typeck_linear_layout_plan(3, ty_i64(), record_tuple_children, 2, 9501)
  let wrapped_record_tuple = typeck_linear_layout_plan(6, ty_named(9004, ty_i64()), record_tuple, 2, 9601)
  Test.assert_eq(pipeline_ir_abort_cleanup_record_plan(wrapped_record_tuple), record)

  let shifted_children = nlist_new()
  nlist_add(shifted_children, typeck_linear_layout_component(2, 0, 1, 1, variant))
  let shifted = typeck_linear_layout_plan(3, ty_i64(), shifted_children, 2, 9701)
  Test.assert_eq(pipeline_ir_abort_cleanup_variant_plan_for_tag(shifted, 8001), 0)
}

test "record_construction_commits_owned_children_by_semantic_offsets" {
  let leaf_a = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let leaf_b = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let nested_children = nlist_new()
  nlist_add(nested_children, typeck_linear_layout_component(2, 0, 0, 0, leaf_a))
  nlist_add(nested_children, typeck_linear_layout_component(2, 0, 1, 1, leaf_b))
  let nested = typeck_linear_layout_plan(3, ty_i64(), nested_children, 2, 7201)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(1, 8101, 0, 1, nested))
  let plan = typeck_linear_layout_plan(4, ty_named(9001, ty_i64()), children, 3, 9101)
  let key = pipeline_structural_drop_glue_hash(plan)
  let fm = fmap_new()
  let facts = nlist_new()
  pipeline_ir_abort_cleanup_add_acquisition_fact(facts, 0, 0, key, pipeline_ir_abort_cleanup_structural_kind())
  fmap_set_current_abort_cleanup_facts(fm, facts)
  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, plan), 1)
  let homes = pipeline_ir_native_identity_home_facts(6)
  let compact_fields = ir_record_field_list_prepend(
    8101, 1, 4,
    ir_record_field_list_prepend(8101, 2, 5, ir_record_field_list_empty())
  )
  let compact = buf_new(4096)
  pipeline_ir_abort_cleanup_emit_commit_record_structural(compact, 0, compact_fields, fm, homes)
  Test.assert_eq(if buf_len(compact) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(fmap_emit_error_count(fm), 0)

  let layout_fields = ir_record_layout_field_list_prepend_word(
    8101, 8, 4, continuation_cleanup_kind_none(),
    ir_record_layout_field_list_prepend_word(8101, 16, 5, continuation_cleanup_kind_none(), ir_record_layout_field_list_empty())
  )
  Test.assert_eq(pipeline_ir_record_layout_word_value_at_byte_offset(layout_fields, 8), 4)
  Test.assert_eq(pipeline_ir_record_layout_word_value_at_byte_offset(layout_fields, 16), 5)
  Test.assert_eq(pipeline_ir_record_layout_word_value_at_byte_offset(layout_fields, 24), 0 - 1)
  let described = buf_new(4096)
  pipeline_ir_abort_cleanup_emit_commit_record_layout_structural(described, 0, layout_fields, fm, homes)
  Test.assert_eq(if buf_len(described) > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
}

test "flat_structural_abort_frame_reserves_exact_shadow_words" {
  let leaf_a = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let leaf_b = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(1, 8101, 0, 0, leaf_a))
  nlist_add(children, typeck_linear_layout_component(1, 8102, 2, 2, leaf_b))
  let flat = typeck_linear_layout_plan(2, ty_i64(), children, 3, 9301)
  let alternatives = nlist_new()
  nlist_add(alternatives, typeck_linear_layout_variant_alternative(8201, 0, 0, 1))
  let named = typeck_linear_layout_plan(5, ty_named(9001, ty_i64()), alternatives, 1, 9401)
  let fm = fmap_new()
  let facts = nlist_new()
  let flat_key = pipeline_structural_drop_glue_hash(flat)
  let named_key = pipeline_structural_drop_glue_hash(named)
  pipeline_ir_abort_cleanup_add_acquisition_fact(facts, 0, 0, flat_key, pipeline_ir_abort_cleanup_structural_kind())
  pipeline_ir_abort_cleanup_add_acquisition_fact(facts, 3, 3, named_key, pipeline_ir_abort_cleanup_structural_kind())
  Test.assert_eq(fmap_structural_drop_plan_register(fm, flat_key, flat), 1)
  Test.assert_eq(fmap_structural_drop_plan_register(fm, named_key, named), 1)

  Test.assert_eq(pipeline_structural_drop_plan_storage_mode(leaf_a), 1)
  Test.assert_eq(pipeline_structural_drop_plan_storage_mode(flat), 2)
  Test.assert_eq(pipeline_structural_drop_plan_storage_mode(named), 3)
  Test.assert_eq(pipeline_ir_abort_cleanup_fact_shadow_words(nlist_get(facts, 0), fm), 3)
  Test.assert_eq(pipeline_ir_abort_cleanup_fact_shadow_words(nlist_get(facts, 1), fm), 0)
  Test.assert_eq(pipeline_ir_abort_cleanup_total_shadow_words(facts, fm), 3)
  -- Each record carries the cleanup identity, exact handler context, and
  -- semantic origin used to distinguish pending indirect transfers.
  Test.assert_eq(pipeline_ir_abort_cleanup_shadow_base(64, facts), 192)
  Test.assert_eq(pipeline_ir_abort_cleanup_shadow_offset(64, facts, nlist_get(facts, 0), fm), 192)
  Test.assert_eq(pipeline_ir_abort_cleanup_frame_size(64, facts, 1, fm), 224)
  Test.assert_eq(pipeline_ir_abort_cleanup_frame_size(64, facts, 0, fm), 64)
}

test "wide_flat_call_arms_abort_cleanup_after_its_final_lane" {
  let leaf_a = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let leaf_b = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(2, 0, 0, 0, leaf_a))
  nlist_add(children, typeck_linear_layout_component(2, 0, 2, 2, leaf_b))
  let plan = typeck_linear_layout_plan(3, ty_i64(), children, 3, 9301)
  let actions = nlist_new()
  pipeline_ir_abort_cleanup_add_structural_action_fact(actions, 0, plan)
  let facts = nlist_new()
  let lanes = ir_inst_list_prepend(
    ir_inst_call_result_lane_for_head_i64(1, 1, 0),
    ir_inst_list_prepend(ir_inst_call_result_lane_for_head_i64(2, 2, 0), ir_inst_list_empty())
  )
  pipeline_ir_abort_cleanup_collect_acquisition_inst_list_with_call(lanes, ir_block_list_empty(), actions, facts, 0, 0, ty_tuple(nlist_new()), 0)

  Test.assert_eq(nlist_len(facts), 1)
  let fact = nlist_get(facts, 0)
  Test.assert_eq(node_tag(fact), 2)
  Test.assert_eq(node_f1(fact), 0)
  Test.assert_eq(node_f2(fact), pipeline_structural_drop_glue_hash(plan))
  Test.assert_eq(node_f3(fact), pipeline_ir_abort_cleanup_structural_kind())
}

test "flat_structural_abort_registration_packs_and_disarms_one_shadow" {
  let leaf_a = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let leaf_b = typeck_linear_layout_plan(1, ty_owned(ty_named(7002, ty_i64())), 0, 1, 7102)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(1, 8101, 0, 0, leaf_a))
  nlist_add(children, typeck_linear_layout_component(1, 8102, 2, 2, leaf_b))
  let plan = typeck_linear_layout_plan(2, ty_i64(), children, 3, 9301)
  let key = pipeline_structural_drop_glue_hash(plan)
  let facts = nlist_new()
  pipeline_ir_abort_cleanup_add_acquisition_fact(facts, 0, 0, key, pipeline_ir_abort_cleanup_structural_kind())
  let fm = fmap_new()
  Test.assert_eq(fmap_structural_drop_plan_register(fm, key, plan), 1)
  fmap_set_current_abort_cleanup_facts(fm, facts)
  fmap_set_current_abort_cleanup_base(fm, 64)
  fmap_set_current_abort_cleanup_boundary(fm, 64)
  fmap_set_current_abort_cleanup_instrumented(fm, 1)
  mmap_add(fmap_mmap(fm), 7001, cg_drop_method_hash(), 4096, 0)
  mmap_add(fmap_mmap(fm), 7002, cg_drop_method_hash(), 8192, 0)
  let code = buf_new(8192)
  let homes = pipeline_ir_native_identity_home_facts(3)

  pipeline_ir_abort_cleanup_emit_register_site(code, 0, fm, homes)
  let registered_len = buf_len(code)
  Test.assert_eq(if registered_len > 0 { 1 } else { 0 }, 1)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(fmap_typed_method_call_emit_count(fm), 2)
  Test.assert_eq(linear_test_native_word_count(code, encode_ret()), 1)
  Test.assert_eq(if mono_cache_lookup(fmap_mono_cache(fm), key) > 1 { 1 } else { 0 }, 1)

  pipeline_ir_abort_cleanup_emit_disarm_structural(code, 0, plan, fm, homes)
  Test.assert_eq(if buf_len(code) > registered_len { 1 } else { 0 }, 1)
  Test.assert_eq(fmap_emit_error_count(fm), 0)
  Test.assert_eq(fmap_typed_method_call_emit_count(fm), 2)
}

test "mutable flat slot aliases share one canonical abort record" {
  let leaf = typeck_linear_layout_plan(1, ty_owned(ty_named(7001, ty_i64())), 0, 1, 7101)
  let children = nlist_new()
  nlist_add(children, typeck_linear_layout_component(2, 0, 1, 1, leaf))
  let plan = typeck_linear_layout_plan(3, ty_i64(), children, 2, 9301)
  let key = pipeline_structural_drop_glue_hash(plan)
  let first_rebind = ir_inst_structural_slot_rebind_i64(10, 20, plan)
  let first_alias = ir_inst_structural_slot_alias_i64(30, 20, plan)
  let insts = ir_inst_list_prepend(
    first_rebind,
    ir_inst_list_prepend(
      first_alias,
      ir_inst_list_prepend(
        ir_inst_structural_slot_rebind_i64(40, 20, plan),
        ir_inst_list_prepend(ir_inst_structural_slot_alias_i64(50, 20, plan), ir_inst_list_empty())
      )
    )
  )
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(0)), ir_block_list_empty())
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0, 0)

  Test.assert_eq(ir_inst_tag(first_rebind), 55)
  match first_rebind {
    IrStructuralSlotI64(value, slot, observed_plan, mode) -> {
      Test.assert_eq(value, 10)
      Test.assert_eq(slot, 20)
      Test.assert_eq(observed_plan, plan)
      Test.assert_eq(mode, 2)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(ir_inst_tag(first_alias), 55)
  Test.assert_eq(nlist_len(facts), 3)

  let canonical = nlist_get(facts, 0)
  let alias_a = nlist_get(facts, 1)
  let alias_b = nlist_get(facts, 2)
  Test.assert_eq(node_tag(canonical), pipeline_ir_abort_cleanup_structural_slot_site(20))
  Test.assert_eq(node_f1(canonical), 20)
  Test.assert_eq(node_f2(canonical), key)
  Test.assert_eq(node_f3(canonical), pipeline_ir_abort_cleanup_structural_kind())
  Test.assert_eq(node_tag(alias_a), 0 - 1)
  Test.assert_eq(node_f1(alias_a), 30)
  Test.assert_eq(node_f3(alias_a), pipeline_ir_abort_cleanup_slot_alias_kind())
  Test.assert_eq(node_tag(alias_b), 0 - 1)
  Test.assert_eq(node_f1(alias_b), 50)
  Test.assert_eq(node_f3(alias_b), pipeline_ir_abort_cleanup_slot_alias_kind())
  Test.assert_eq(node_f4(alias_a), node_f4(canonical))
  Test.assert_eq(node_f4(alias_b), node_f4(canonical))
  Test.assert_eq(
    pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, 30, key, pipeline_ir_abort_cleanup_structural_kind()),
    alias_a
  )
  Test.assert_eq(
    pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, 50, key, pipeline_ir_abort_cleanup_structural_kind()),
    alias_b
  )
}

test "typed binds of mutable flat slot aliases do not acquire a second record" {
  let elems = nlist_new()
  nlist_add(elems, ty_i64())
  nlist_add(elems, ty_owned(ty_named(7001, ty_i64())))
  let aggregate_ty = ty_tuple(elems)
  let plan = pipeline_linear_cleanup_plan(0, aggregate_ty)
  let key = pipeline_structural_drop_glue_hash(plan)
  let insts = ir_inst_list_prepend(
    ir_inst_structural_slot_rebind_i64(10, 20, plan),
    ir_inst_list_prepend(
      ir_inst_structural_slot_alias_i64(30, 20, plan),
      ir_inst_list_prepend(
        ir_inst_bind_typed_i64(0, 0, 30, aggregate_ty),
        ir_inst_list_prepend(
          ir_inst_structural_split_i64(30, plan, 0, 1),
          ir_inst_list_empty()
        )
      )
    )
  )
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(0)), ir_block_list_empty())
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0, 0)

  Test.assert_eq(nlist_len(facts), 2)
  let canonical = nlist_get(facts, 0)
  let alias = nlist_get(facts, 1)
  Test.assert_eq(node_tag(canonical), pipeline_ir_abort_cleanup_structural_slot_site(20))
  Test.assert_eq(node_f1(canonical), 20)
  Test.assert_eq(node_f2(canonical), key)
  Test.assert_eq(node_f3(canonical), pipeline_ir_abort_cleanup_structural_kind())
  Test.assert_eq(node_tag(alias), 0 - 1)
  Test.assert_eq(node_f1(alias), 30)
  Test.assert_eq(node_f2(alias), key)
  Test.assert_eq(node_f3(alias), pipeline_ir_abort_cleanup_slot_alias_kind())
  Test.assert_eq(node_f4(alias), node_f4(canonical))
  Test.assert_eq(
    pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(facts, 30, key, pipeline_ir_abort_cleanup_structural_kind()),
    alias
  )
}

test "linear pattern transfer prefers a mutable slot owner across representation actions" {
  let facts = nlist_new()
  pipeline_ir_abort_cleanup_add_acquisition_fact(
    facts,
    pipeline_ir_abort_cleanup_structural_slot_site(20),
    20,
    111,
    pipeline_ir_abort_cleanup_owned_kind()
  )
  pipeline_ir_abort_cleanup_add_acquisition_fact(
    facts,
    30,
    30,
    222,
    pipeline_ir_abort_cleanup_structural_kind()
  )
  nlist_add(facts, node_new(
    0 - 1,
    30,
    111,
    pipeline_ir_abort_cleanup_slot_alias_kind(),
    0
  ))

  let direct = nlist_get(facts, 1)
  let alias = nlist_get(facts, 2)
  Test.assert_eq(
    pipeline_ir_abort_cleanup_find_acquisition_value_action_kind(
      facts, 30, 222, pipeline_ir_abort_cleanup_structural_kind()
    ),
    direct
  )
  Test.assert_eq(
    pipeline_ir_abort_cleanup_find_linear_transfer_fact(
      facts, 30, 222, pipeline_ir_abort_cleanup_structural_kind()
    ),
    alias
  )
}

test "opaque rewrap marker acquires the wrapper cleanup fact" {
  let wrapper_ty = ty_owned(ty_named(7003, ty_i64()))
  let wrapper_plan = typeck_linear_layout_plan(1, wrapper_ty, 0, 1, 7201)
  let marker = ir_inst_linear_rewrap_acquire_i64(7, wrapper_plan)
  let insts = ir_inst_list_prepend(
    marker,
    ir_inst_list_prepend(
      ir_inst_owned_drop_i64(7, cg_owned_drop_type_hash(wrapper_ty)),
      ir_inst_list_empty()
    )
  )
  let blocks = ir_block_list_prepend(
    ir_block_new_term(0, insts, ir_term_return(0)),
    ir_block_list_empty()
  )
  let facts = pipeline_ir_abort_cleanup_facts_for_blocks(blocks, 0, 0)

  Test.assert_eq(ir_inst_tag(marker), 55)
  match marker {
    IrStructuralSlotI64(value, slot, observed_plan, mode) -> {
      Test.assert_eq(value, 7)
      Test.assert_eq(slot, 7)
      Test.assert_eq(observed_plan, wrapper_plan)
      Test.assert_eq(mode, 5)
    }
    _ -> Test.assert_true(false)
  }
  Test.assert_eq(nlist_len(facts), 1)
  let fact = nlist_get(facts, 0)
  Test.assert_eq(node_tag(fact), pipeline_ir_abort_cleanup_rewrap_site(7))
  Test.assert_eq(node_f1(fact), 7)
  Test.assert_eq(node_f2(fact), cg_owned_drop_type_hash(wrapper_ty))
  Test.assert_eq(node_f3(fact), pipeline_ir_abort_cleanup_owned_kind())
  Test.assert_eq(pipeline_ir_abort_cleanup_blocks_need_instrumentation(blocks, facts), 1)
}

test "handler linear cleanup reactivation is explicit effectful IR" {
  let hash = pipeline_ir_pseudo_handler_cleanup_reactivate_hash()
  let marker = ir_inst_call_i64(
    0 - 1,
    hash,
    ir_value_list_prepend(37, ir_value_list_empty())
  )
  let blocks = ir_block_list_prepend(
    ir_block_new_term(0, ir_inst_list_prepend(marker, ir_inst_list_empty()), ir_term_return(0)),
    ir_block_list_empty()
  )

  Test.assert_eq(pipeline_ir_handler_cleanup_frame_blocks(blocks), 37)
  Test.assert_eq(pipeline_ir_handler_cleanup_frame_blocks(ir_block_list_empty()), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_kind(hash), 46)
  Test.assert_eq(pipeline_ir_native_intrinsic_arity(46), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(46), 65536)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(46), 1)
  Test.assert_eq(pipeline_ir_inst_is_dead_pure_candidate(marker, pipeline_ir_semantic_facts_empty()), 0)
}
