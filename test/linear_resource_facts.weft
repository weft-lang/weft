  let insts = ir_inst_list_prepend(
    ir_inst_variant_init_i64(0, 8002, ir_value_list_empty(), 0),
    ir_inst_list_prepend(ir_inst_structural_drop_i64(0, plan), ir_inst_list_empty())
  )
  let blocks = ir_block_list_prepend(ir_block_new_term(0, insts, ir_term_return(0)), ir_block_list_empty())
