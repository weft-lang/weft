use stdlib/test.{*}
use stdlib/string.{*}
use stdlib/string/builder as builder

test "text builder finishes empty text" {
  let output = builder.new()
  Test.assert_true(output.is_empty())
  Test.assert_eq_usize(output.len(), 0)
  Test.assert_str_eq(output.finish(), "")
}

test "text builder appends complete Unicode strings" {
  let mut output = builder.with_capacity(3)
  output.append("a")
  output.append("Ω")
  Test.assert_true(not output.is_empty())
  Test.assert_eq_usize(output.len(), 3)
  Test.assert_str_eq(output.finish(), "aΩ")
}

test "text builder grows while preserving its initialized prefix" {
  let mut output = builder.with_capacity(1)
  for index in 0..1000 {
    output.append("ab")
  }
  Test.assert_eq_usize(output.len(), 2000)
  let text = output.finish()
  Test.assert_eq(text.len(), 2000)
  Test.assert_true(text.starts_with("abab"))
  Test.assert_true(text.ends_with("abab"))
}
