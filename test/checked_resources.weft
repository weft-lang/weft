-- Owned resources on the typed path: an `owned` type must implement the
-- SDK's `Drop`, and an owned or unique value is stored only where its single
-- obligation stays exact.

use compiler/project/identity.{ModuleIdentity, named_module_identity}
use compiler/source/input.{source_from_text}
use compiler/weft/check/body/installer.{CheckedModuleOrdinaryRejected}
use compiler/weft/check/checked_module.{
  CheckedModuleAccepted,
  CheckedModuleBodyRejected,
  CheckedModuleResolutionRejected,
  check_registered_module_with_resolution
}
use compiler/weft/check/registration/catalog as registration
use compiler/weft/check/registration/catalog.{RegisteredModule}
use compiler/weft/check/registration/scope as registration_scope
use compiler/weft/check/rejection.{checked_body_producer_issue_category}
use compiler/weft/check/resolution.{SemanticResolutionAccepted, resolve_module_semantics}
use compiler/weft/grammar.{ParsedWeftSource, WeftParser}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{Grammar, Parsed}
use stdlib/list as list
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{Option}
use stdlib/panic.{panic}
use stdlib/string.{str_concat}
use stdlib/test.{Test}

fn parse(text: str) -[Test]> ParsedWeftSource {
  let result = handle WeftParser().parse(source_from_text(text).all()) {
    Diagnose.report(diagnostic) -> { Test.assert_true(false); resume(0) }
    Diagnose.error(message, location) -> { Test.assert_true(false); resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  }
  match result {
    Parsed(syntax) -> syntax
    _ -> panic("expected complete authored syntax")
  }
}

fn registered(text: str, module: ModuleIdentity) -[Test]> RegisteredModule {
  let parsed = parse(text)
  registration.register(parsed.declarations, parsed.source.source(), module)
}

-- A resource that implements the SDK's `Drop`, plain data that does not,
-- and plain data with only an inherent `drop`.
fn resources() -> str {
  "use stdlib/drop.{Drop} use stdlib/vector/handles.{Vector} "
    |> str_concat("type Token { value: i64 } ")
    |> str_concat("impl Drop for Token { fn drop(self) -> nil { nil } } ")
    |> str_concat("type Plain { count: i64 } ")
    |> str_concat("type Inherent { count: i64 } ")
    |> str_concat("impl Inherent { fn drop(self) -> nil { nil } } ")
    |> str_concat("type Choice<T> { Chosen(T), Unchosen } ")
}

-- Check `program` beside the SDK's `Drop` and vector handle, with the real
-- conformance catalog answering `Drop`.
fn outcome(program: str, discriminator: i64) -[Test]> str {
  let drop = registered(
    "pub trait Drop { }",
    named_module_identity("stdlib/drop", discriminator)
  )
  let handles = registered(
    "pub type Vector<T> { }",
    named_module_identity("stdlib/vector/handles", discriminator)
  )
  let consumer = registered(
    str_concat(resources(), program),
    named_module_identity("fixture/resources", discriminator)
  )
  let drop_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(0).unwrap(),
    drop.identity,
    false
  )
  let handles_edge = registration_scope.resolved_import(
    consumer,
    consumer.syntax.imports.get(1).unwrap(),
    handles.identity,
    false
  )
  let modules = [drop, handles, consumer]
  let imports = [drop_edge, handles_edge]
  let scope = registration_scope.registration_scope_build(
    list.from_slice(modules[..]),
    list.from_slice(imports[..])
  )
  match resolve_module_semantics(consumer, scope) {
    SemanticResolutionAccepted(resolution) -> match check_registered_module_with_resolution(
      consumer,
      scope,
      resolution,
      discriminator
    ) {
      CheckedModuleAccepted(_) -> "accepted"
      CheckedModuleBodyRejected(CheckedModuleOrdinaryRejected(_, issue, _)) ->
        checked_body_producer_issue_category(issue)
      CheckedModuleBodyRejected(_) -> "installer"
      CheckedModuleResolutionRejected(_) -> "resolution"
      _ -> "other"
    }
    _ -> "unresolved"
  }
}

fn assert_outcomes(cases: List<str>, expected: str, discriminator: i64) -[Test]> nil {
  match cases {
    Nil -> nil
    Cons(program, rest) -> {
      Test.assert_str_eq(outcome(program, discriminator), expected)
      assert_outcomes(rest, expected, discriminator + 1)
    }
  }
}

test "an owned value implements the SDK's Drop" {
  let accepted = [
    "fn keep(token: owned Token) -> i64 { 0 }",
    "fn make() -> owned Token { Token { value: 1 } }",
    "fn hold() -> i64 { let token: owned Token = Token { value: 1 } 0 }",
    "type Holder { token: owned Token } fn run(holder: Holder) -> i64 { 0 }",
    "type Holding { Held(owned Token), Idle } fn run(holding: Holding) -> i64 { 0 }",
    "fn wrap() -> Choice<owned Token> { Chosen(Token { value: 1 }) }",
    "fn call(consume: (owned Token) -> i64) -> i64 { 0 }",
    -- A type variable is decided where it is instantiated.
    "fn keep<T>(value: owned T) -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(accepted[..]), "accepted", 5101)
  let refused = [
    "fn keep(value: owned i64) -> i64 { 0 }",
    "fn keep(value: owned Plain) -> i64 { 0 }",
    -- Only the SDK's `Drop` counts, not a method that happens to be named so.
    "fn keep(value: owned Inherent) -> i64 { 0 }",
    "fn hold() -> i64 { let plain: owned Plain = Plain { count: 1 } 0 }",
    "type Holder { plain: owned Plain } fn run() -> i64 { 0 }",
    "type Holding { Held(owned i64), Idle } fn run() -> i64 { 0 }",
    "type Wrapped = opaque i64 fn hold() -> i64 { let wrapped: owned Wrapped = Wrapped(1) 0 }",
    "fn call(consume: (owned Plain) -> i64) -> i64 { 0 }",
    "fn wrap() -> Choice<owned Plain> { Unchosen }"
  ]
  assert_outcomes(list.from_slice(refused[..]), "owned_drop_required", 5121)
}

test "owned values live only in finite storage" {
  let accepted = [
    "type Pair { first: owned Token, second: owned Token } fn run(pair: Pair) -> i64 { 0 }",
    "fn run(pair: (owned Token, i64)) -> i64 { 0 }",
    "fn run(values: Vector<Token>) -> i64 { 0 }",
    "fn run(values: [Token; 2]) -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(accepted[..]), "accepted", 5141)
  let containers = [
    "type Bag { tokens: Vector<owned Token> } fn run() -> i64 { 0 }",
    "fn run(tokens: Vector<owned Token>) -> i64 { 0 }",
    "type Bag<T> = opaque Vector<T> type Holder { tokens: Bag<owned Token> } fn run() -> i64 { 0 }",
    "fn run(tokens: [owned Token; 2]) -> i64 { 0 }",
    "type Holder { token: owned Token } fn run(holders: Vector<Holder>) -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(containers[..]), "owned_storage_container", 5151)
  let unions = [
    "fn run(token: owned Token | nil) -> i64 { 0 }",
    "type Holder { token: owned Token | i64 } fn run() -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(unions[..]), "owned_storage_set_operator", 5161)
}

test "unique wraps only ordinary data at a root" {
  Test.assert_str_eq(outcome("fn run(plain: unique Plain) -> i64 { 0 }", 5171), "accepted")
  let refused = [
    "type Holder { plain: unique Plain } fn run() -> i64 { 0 }",
    "type Holder { token: owned Token } fn run(holder: unique Holder) -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(refused[..]), "unique_nested", 5172)
}

test "an owned value's drop effects belong to the function that may drop it" {
  let logged = "effect Log { fn note() -> nil } type Logged { value: i64 } "
    |> str_concat("impl Drop for Logged { fn drop(self) -[Log]> nil { Log.note() } } ")
  let accepted = [
    str_concat(
      logged,
      "fn hold() -[Log]> i64 { let value: owned Logged = Logged { value: 1 } 0 }"
    ),
    str_concat(logged, "fn keep(value: owned Logged) -[Log]> i64 { 0 }"),
    -- A `drop` that performs nothing needs nothing of its function.
    "fn keep(token: owned Token) -> i64 { 0 }"
  ]
  assert_outcomes(list.from_slice(accepted[..]), "accepted", 5181)
  let refused = [
    str_concat(logged, "fn hold() -> i64 { let value: owned Logged = Logged { value: 1 } 0 }"),
    str_concat(logged, "fn keep(value: owned Logged) -> i64 { 0 }"),
    str_concat(
      logged,
      "effect Other { fn other() -> nil } fn keep(value: owned Logged) -[Other]> i64 { 0 }"
    )
  ]
  assert_outcomes(list.from_slice(refused[..]), "owned_drop_effect_unavailable", 5191)
}
