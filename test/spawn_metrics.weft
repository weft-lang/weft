use compiler/ir.{*}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{ttable_get_checked_functions}
use compiler/typeck.{ftypes_entry_return_type, ftypes_find_decl, typeck_concurrency_boundary_for_entry, typeck_concurrency_boundary_spawn_scope, typeck_concurrency_boundary_spawn_submit, typeck_decl_identity_is}
use compiler/types.{ty_f1, ty_named_opaque_declaration}
use runtime/alloc.{alloc_bump_mark}

fn spawn_metric_immediate_captures(inst: IrInst) -> i64 {
  match inst {
    IrHandleI64(dst, handle_src, effect_hash, clauses, nclauses, abort_block) -> match clauses {
      IrHandlerClauseBodyCons(body, rest) -> match body {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> captures
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      IrHandlerClauseBodyNil -> 0
    }
    _ -> 0
  }
}

fn spawn_metric_deferred_body_captures(inst: IrInst) -> i64 {
  match inst {
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> match body {
      IrDeferredHandlerBody(captures, ops_value, result_lanes, first_value, blocks) -> captures
      IrDeferredHandlerBodyInvalid(reason) -> 0
    }
    _ -> 0
  }
}

fn spawn_metric_deferred_clause_captures(inst: IrInst) -> i64 {
  match inst {
    IrDeferredHandleI64(dst, handle_src, body, clauses, nclauses, effect_hash, scratch_base) -> match clauses {
      IrHandlerClauseBodyCons(clause, rest) -> match clause {
        IrHandlerClauseBody(op_hash, nparams, captures, has_continuation, is_abortive, result_cleanup_kind, transferred_param_value_fact, resume_lanes, result_lanes, first_value, blocks) -> captures
        IrHandlerClauseBodyInvalid(reason) -> 0
      }
      IrHandlerClauseBodyNil -> 0
    }
    _ -> 0
  }
}

test "Spawn typed pack declaration resolves to its compiler-native identity" {
  let src = "use stdlib/spawn as spawn\nfn main() -> i64 { 0 }\n"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  let tt = match typed { TypedModule(fns, source, table) -> table }
  let runtime_module = module_fact_find_path(tt, __str_ptr("runtime/spawn_task"), __str_len("runtime/spawn_task"), 0)
  Test.assert_true(runtime_module != 0)
  let runtime_source = module_fact_entry_source(runtime_module)
  let pack_decl = module_decl_fact_find(tt, runtime_source, module_decl_namespace_value(), __str_ptr("runtime_spawn_work_pack"), 0, __str_len("runtime_spawn_work_pack"))
  Test.assert_true(pack_decl != 0)
  Test.assert_eq(pipeline_fn_pair_key(module_decl_fact_function_pair(pack_decl)), pipeline_ir_native_spawn_work_pack_hash())
  let spawn_module = module_fact_find_path(tt, __str_ptr("stdlib/spawn"), __str_len("stdlib/spawn"), 0)
  let spawn_source = module_fact_entry_source(spawn_module)
  let submit_decl = module_decl_fact_find(tt, spawn_source, module_decl_namespace_value(), __str_ptr("spawn"), 0, __str_len("spawn"))
  let scope_decl = module_decl_fact_find(tt, spawn_source, module_decl_namespace_value(), __str_ptr("with_sequential"), 0, __str_len("with_sequential"))
  let checked = ttable_get_checked_functions(tt)
  let submit_entry = ftypes_find_decl(checked, submit_decl)
  Test.assert_eq(typeck_concurrency_boundary_for_entry(submit_entry), typeck_concurrency_boundary_spawn_submit())
  Test.assert_eq(typeck_concurrency_boundary_for_entry(ftypes_find_decl(checked, scope_decl)), typeck_concurrency_boundary_spawn_scope())
  Test.assert_eq(ty_named_opaque_declaration(ty_f1(ftypes_entry_return_type(submit_entry))), module_decl_fact_find(tt, runtime_source, module_decl_namespace_type(), __str_ptr("SpawnTask"), 0, __str_len("SpawnTask")))
}

test "same-spelled user declarations never acquire Spawn boundary or intrinsic identity" {
  let src = "fn spawn(f: () -> i64) -> i64 { f() }\nfn runtime_spawn_work_pack(x: i64) -> i64 { x + 1 }\nfn main() -> i64 { runtime_spawn_work_pack(spawn(() => 40)) }\n"
  let typed = pipeline_check_source_with_origin_standalone(__str_ptr(src), __str_len(src), 1, 0)
  match typed {
    TypedModule(fns, source, table) -> {
      let fake_spawn = module_decl_fact_find(table, source, module_decl_namespace_value(), __str_ptr("spawn"), 0, __str_len("spawn"))
      let fake_pack = module_decl_fact_find(table, source, module_decl_namespace_value(), __str_ptr("runtime_spawn_work_pack"), 0, __str_len("runtime_spawn_work_pack"))
      Test.assert_true(fake_spawn != 0)
      Test.assert_true(fake_pack != 0)
      Test.assert_eq(typeck_decl_identity_is(fake_spawn, "stdlib/spawn", "spawn"), 0)
      Test.assert_true(pipeline_fn_pair_key(module_decl_fact_function_pair(fake_pack)) != pipeline_ir_native_spawn_work_pack_hash())
    }
  }
}

test "immediate handler captures follow aliases and retain optimiser payloads" {
  let captures = nlist_new()
  nlist_add(captures, pipeline_lambda_capture_entry(0, 0, 7, 0))
  let body = IrHandlerClauseBody(11, 0, captures, 0, 0, 0, 0 - 1, 1, 1, 0, IrBlockListNil)
  let clauses = IrHandlerClauseBodyCons(body, IrHandlerClauseBodyNil)
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 7, 3)
  let mark = alloc_bump_mark()
  let rewritten = pipeline_ir_rewrite_inst_uses(IrHandleI64(0 - 1, 0, 22, clauses, 1, 0 - 1), aliases)
  let end = alloc_bump_mark()
  let rewritten_captures = spawn_metric_immediate_captures(rewritten)
  Test.assert_eq(node_f3(nlist_get(captures, 0)), 7)
  Test.assert_true(rewritten_captures != captures)
  Test.assert_eq(node_f3(nlist_get(rewritten_captures, 0)), 3)
  Test.assert_eq(pipeline_ir_inst_list_capture_payload_in_range(IrInstCons(rewritten, IrInstNil), mark, end), 1)
}

test "deferred handler body and clause captures retain rewritten payloads" {
  let body_captures = nlist_new()
  nlist_add(body_captures, pipeline_lambda_capture_entry(0, 0, 8, 0))
  let clause_captures = nlist_new()
  nlist_add(clause_captures, pipeline_lambda_capture_entry(0, 0, 9, 0))
  let body = IrDeferredHandlerBody(body_captures, 0, 1, 0, IrBlockListNil)
  let clause = IrHandlerClauseBody(11, 0, clause_captures, 0, 0, 0, 0 - 1, 1, 1, 0, IrBlockListNil)
  let clauses = IrHandlerClauseBodyCons(clause, IrHandlerClauseBodyNil)
  let aliases = pipeline_ir_alias_env_bind(pipeline_ir_alias_env_bind(pipeline_ir_alias_env_empty(), 8, 4), 9, 5)
  let mark = alloc_bump_mark()
  let rewritten = pipeline_ir_rewrite_inst_uses(IrDeferredHandleI64(0, 0, body, clauses, 1, 22, 10), aliases)
  let end = alloc_bump_mark()
  let rewritten_body = spawn_metric_deferred_body_captures(rewritten)
  let rewritten_clause = spawn_metric_deferred_clause_captures(rewritten)
  Test.assert_eq(node_f3(nlist_get(body_captures, 0)), 8)
  Test.assert_eq(node_f3(nlist_get(clause_captures, 0)), 9)
  Test.assert_eq(node_f3(nlist_get(rewritten_body, 0)), 4)
  Test.assert_eq(node_f3(nlist_get(rewritten_clause, 0)), 5)
  Test.assert_eq(pipeline_ir_inst_list_capture_payload_in_range(IrInstCons(rewritten, IrInstNil), mark, end), 1)
}
