use "runtime/rc_implicit_test.weft"

type RecursiveInner {
  Number(i64),
  Maybe(i64 | nil),
  End,
}

type RecursiveOuter {
  Wrap(RecursiveInner),
  Pair(RecursiveInner, RecursiveInner),
  Stop,
}

type RecursiveTree<T> {
  Leaf(T),
  Branch(RecursiveTree<T>, RecursiveTree<T>),
}

type RecursiveManaged {
  ManagedLeaf(RuntimeRcProbe),
  ManagedWrap(RecursiveManaged),
  ManagedEnd,
}

type RecursiveDepth {
  DepthValue(i64),
  DepthNext(RecursiveDepth),
}

effect RecursivePatternGate {
  fn allow(value: i64) -> bool
}

fn recursive_pattern_number(value: RecursiveOuter) -> i64 {
  match value {
    Wrap(Number(n)) -> n
    _ -> 0
  }
}

fn recursive_pattern_literal(value: RecursiveOuter) -> i64 {
  match value {
    Wrap(Number(42)) -> 42
    Wrap(Number(_)) -> 1
    _ -> 0
  }
}

fn recursive_pattern_same_outer(value: RecursiveOuter) -> i64 {
  match value {
    Wrap(Number(n)) -> n
    Wrap(End) -> 42
    Wrap(Maybe(nil)) -> 41
    Wrap(Maybe(n: i64)) -> n
    _ -> 0
  }
}

fn recursive_pattern_pair_guard(value: RecursiveOuter) -> i64 {
  match value {
    Pair(Number(left), Number(right)) if left + right == 42 -> left + right
    _ -> 0
  }
}

fn recursive_pattern_effect_guard(value: RecursiveOuter) -[RecursivePatternGate]> i64 {
  match value {
    Pair(Number(left), Number(right)) if RecursivePatternGate.allow(left + right) -> left + right
    _ -> 0
  }
}

fn recursive_pattern_handle_guard(value: RecursiveOuter) -> i64 {
  handle recursive_pattern_effect_guard(value) {
    RecursivePatternGate.allow(value) -> resume(value == 42)
  }
}

fn recursive_pattern_deep(value: RecursiveDepth) -> i64 {
  match value {
    DepthNext(DepthNext(DepthNext(DepthValue(n)))) -> n
    _ -> 0
  }
}

fn recursive_pattern_capture(value: RecursiveOuter) -> i64 {
  match value {
    Wrap(Number(n)) -> {
      let read = () => n
      read()
    }
    _ -> 0
  }
}

fn recursive_pattern_generic<T>(value: RecursiveTree<T>, fallback: T) -> T {
  match value {
    Branch(Leaf(left), Leaf(_)) -> left
    _ -> fallback
  }
}

fn recursive_pattern_unwrap_managed(value: RecursiveManaged, fallback: RuntimeRcProbe) -> RuntimeRcProbe {
  match value {
    ManagedWrap(ManagedLeaf(probe)) -> probe
    _ -> fallback
  }
}

test "recursive constructor patterns bind through nested payloads" {
  Test.assert_eq(recursive_pattern_number(Wrap(Number(42))), 42)
  Test.assert_eq(recursive_pattern_number(Stop), 0)
}

test "recursive constructor patterns test literals and continue outer arms" {
  Test.assert_eq(recursive_pattern_literal(Wrap(Number(42))), 42)
  Test.assert_eq(recursive_pattern_literal(Wrap(Number(7))), 1)
  Test.assert_eq(recursive_pattern_literal(Stop), 0)
}

test "recursive constructor patterns admit repeated outer constructors" {
  Test.assert_eq(recursive_pattern_same_outer(Wrap(Number(42))), 42)
  Test.assert_eq(recursive_pattern_same_outer(Wrap(End)), 42)
  Test.assert_eq(recursive_pattern_same_outer(Wrap(Maybe(nil))), 41)
  Test.assert_eq(recursive_pattern_same_outer(Wrap(Maybe(42))), 42)
}

test "recursive constructor pattern guards see every nested binding" {
  Test.assert_eq(recursive_pattern_pair_guard(Pair(Number(20), Number(22))), 42)
  Test.assert_eq(recursive_pattern_pair_guard(Pair(Number(20), Number(21))), 0)
  Test.assert_eq(recursive_pattern_pair_guard(Pair(Number(20), End)), 0)
  Test.assert_eq(recursive_pattern_handle_guard(Pair(Number(20), Number(22))), 42)
  Test.assert_eq(recursive_pattern_handle_guard(Pair(Number(20), Number(21))), 0)
}

test "recursive constructor patterns cross generic specializations" {
  let tree = Branch(Leaf(42), Leaf(0))
  Test.assert_eq(recursive_pattern_generic<i64>(tree, 0), 42)
}

test "recursive constructor patterns short-circuit pathological depth" {
  Test.assert_eq(recursive_pattern_deep(DepthNext(DepthNext(DepthNext(DepthValue(42))))), 42)
  Test.assert_eq(recursive_pattern_deep(DepthValue(42)), 0)
  Test.assert_eq(recursive_pattern_deep(DepthNext(DepthValue(42))), 0)
}

test "recursive constructor bindings participate in closure capture" {
  Test.assert_eq(recursive_pattern_capture(Wrap(Number(42))), 42)
}

test "recursive constructor bindings preserve managed payload ownership" {
  let probe = runtime_rc_probe_new(0)
  let fallback = runtime_rc_probe_new(0)
  let unwrapped = recursive_pattern_unwrap_managed(ManagedWrap(ManagedLeaf(probe)), fallback)
  Test.assert_eq(runtime_rc_probe_count(unwrapped), 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 2)
  Test.assert_eq(runtime_rc_probe_count(fallback), 1)
}
