use runtime/rc_implicit_test.{*}
use stdlib/eq.{Eq}
use stdlib/state as state
use stdlib/state.{State}

type EqualityLifetime { probe: RuntimeRcProbe }

effect EqualityPause { @deferred fn next() -> nil }

impl Eq for EqualityLifetime {
  fn eq(self, other: Self) -> bool {
    runtime_rc_probe_load(self.probe) == runtime_rc_probe_load(other.probe)
  }
}

fn equality_temporary(probe: RuntimeRcProbe) -> EqualityLifetime { EqualityLifetime { probe: probe } }

fn equality_churn(probe: RuntimeRcProbe, count: i64) -> i64 {
  let mut same = 0
  for index in 0..count {
    if equality_temporary(probe) == equality_temporary(probe) { same = same + 1 }
  }
  same
}

fn equality_ordered(probe: RuntimeRcProbe, digit: i64) -[State<i64>]> EqualityLifetime {
  State<i64>.put(State<i64>.get() * 10 + digit)
  equality_temporary(probe)
}

fn equality_return_right(probe: RuntimeRcProbe) -> bool { equality_temporary(probe) == { return true } }

fn equality_return_left(probe: RuntimeRcProbe) -> bool { { return true } == equality_temporary(probe) }

fn equality_return_receiver_branch(probe: RuntimeRcProbe, choose: bool) -> bool {
  (if choose { equality_temporary(probe) } else { equality_temporary(probe) }) == { return true }
}

fn equality_return_argument_branch(probe: RuntimeRcProbe, leave: bool) -> bool {
  equality_temporary(probe) == (if leave { return true } else { equality_temporary(probe) })
}

fn equality_method_return(probe: RuntimeRcProbe) -> bool { equality_temporary(probe).eq({ return true }) }

fn equality_break(probe: RuntimeRcProbe) -> bool { loop { equality_temporary(probe) != { break (true) } } }

fn equality_continue(probe: RuntimeRcProbe) -> i64 {
  let mut count = 0
  while count < 100 {
    count = count + 1
    equality_temporary(probe) == { continue }
  }
  count
}

fn equality_suspend(probe: RuntimeRcProbe) -[EqualityPause]> EqualityLifetime {
  EqualityPause.next()
  equality_temporary(probe)
}

test "equality evaluates operands once from left to right" {
  let probe = runtime_rc_probe_new(42)
  let compared = state.run(0, () => equality_ordered(probe, 1) == equality_ordered(probe, 2))
  Test.assert_true(compared.0)
  Test.assert_eq(compared.1, 12)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "temporary equality operands are reclaimed after comparison" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(equality_churn(probe, 200), 200)
  let before = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(equality_churn(probe, 10000), 10000)
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(after - before, 0)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "returning from either equality operand preserves cleanup" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_true(equality_return_right(probe))
  Test.assert_true(equality_return_left(probe))
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "branching receivers and partial argument exits preserve cleanup" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_true(equality_return_receiver_branch(probe, true))
  Test.assert_true(equality_return_receiver_branch(probe, false))
  Test.assert_true(equality_return_argument_branch(probe, true))
  Test.assert_true(equality_return_argument_branch(probe, false))
  Test.assert_true(equality_method_return(probe))
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "loop exits from comparison operands release temporary receivers" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_true(equality_break(probe))
  Test.assert_eq(equality_continue(probe), 100)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "aborting an equality operand releases earlier values" {
  let probe = runtime_rc_probe_new(42)
  let result = handle equality_temporary(probe) == Fail<i64>.fail(7) { Fail.fail(value) -> value == 7 }
  Test.assert_true(result)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "suspended equality retains its earlier operand through resumption" {
  let probe = runtime_rc_probe_new(42)
  let result = handle equality_temporary(probe) == equality_suspend(probe) {
    EqualityPause.next() with continuation -> continuation(nil)
  }
  Test.assert_true(result)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "abandoning an equality continuation releases the earlier operand" {
  let probe = runtime_rc_probe_new(42)
  let result = handle equality_temporary(probe) == equality_suspend(probe) {
    EqualityPause.next() with continuation -> true
  }
  Test.assert_true(result)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}
