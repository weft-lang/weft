use compiler/ir/data.{*}
use compiler/pipeline.{pipeline_lambda_ir_body_subst}
use compiler/types/algebra.{ty_var, ty_str, ty_eq, subst_new, subst_add}

fn replacement() -> i64 {
  let subst = subst_new()
  subst_add(subst, 17, ty_str())
  subst
}

test "specialization preserves and substitutes inferred constructor facts" {
  let original = RecordInit(
    1,
    3,
    RecordFieldListNil,
    InferredRecordType(
      type_expr_from_node(ty_var(17)),
      RecordSourceRange { start: 7, end: 19 }
    )
  )
  let concrete = pipeline_lambda_ir_body_subst(original, replacement())
  Test.assert_true(
    match concrete {
      RecordInit(1, 3, RecordFieldListNil, InferredRecordType(ty, range)) ->
        ty_eq(type_expr_to_node(ty), ty_str()) and range.start == 7 and range.end == 19
      _ -> false
    }
  )
  Test.assert_true(
    match original {
      RecordInit(_, _, _, InferredRecordType(ty, range)) ->
        type_expr_tag_or(ty, - 1) == 12 and range.start == 7 and range.end == 19
      _ -> false
    }
  )
}

test "specialization preserves explicit constructor provenance" {
  let original = RecordInit(
    1,
    3,
    RecordFieldListNil,
    ExplicitRecordType(
      type_expr_from_node(ty_var(17)),
      RecordSourceRange { start: 2, end: 14 }
    )
  )
  let concrete = pipeline_lambda_ir_body_subst(original, replacement())
  Test.assert_true(
    match concrete {
      RecordInit(1, 3, RecordFieldListNil, ExplicitRecordType(ty, range)) ->
        ty_eq(type_expr_to_node(ty), ty_str()) and range.start == 2 and range.end == 14
      _ -> false
    }
  )
}

test "specialization leaves intentionally absent constructor input absent" {
  let original = RecordInit(
    1,
    3,
    RecordFieldListNil,
    InferredRecordType(MissingTypeExpr, RecordSourceRange { start: 0, end: 0 })
  )
  Test.assert_true(
    match pipeline_lambda_ir_body_subst(original, replacement()) {
      RecordInit(1, 3, RecordFieldListNil, InferredRecordType(MissingTypeExpr, range)) ->
        range.start == 0 and range.end == 0
      _ -> false
    }
  )
}

test "record update syntax retains its suffix through the raw adapter" {
  let expression = RecordUpdate(
    Ident(1, 5),
    RecordFieldListNil,
    UnknownRecordUpdateFact(RecordSourceRange { start: 6, end: 14 })
  )
  Test.assert_true(
    match expr_from_node(expr_to_node(expression)) {
      RecordUpdate(Ident(1, 5), RecordFieldListNil, UnknownRecordUpdateFact(range)) ->
        range.start == 6 and range.end == 14
      _ -> false
    }
  )
}

test "record update syntax range survives specialization before checking" {
  let expression = RecordUpdate(
    Ident(1, 5),
    RecordFieldListNil,
    UnknownRecordUpdateFact(RecordSourceRange { start: 6, end: 9 })
  )
  Test.assert_true(
    match pipeline_lambda_ir_body_subst(expression, replacement()) {
      RecordUpdate(_, _, UnknownRecordUpdateFact(range)) ->
        range.start == 6 and range.end == 9
      _ -> false
    }
  )
}

test "checked record update types specialize without losing the syntax range" {
  let expression = RecordUpdate(
    Ident(1, 5),
    RecordFieldListNil,
    ResolvedRecordUpdateFact(
      type_expr_from_node(ty_var(17)),
      type_expr_from_node(ty_var(17)),
      RecordSourceRange { start: 6, end: 9 }
    )
  )
  Test.assert_true(
    match pipeline_lambda_ir_body_subst(expression, replacement()) {
      RecordUpdate(_, _, ResolvedRecordUpdateFact(result, base, range)) ->
        ty_eq(type_expr_to_node(result), ty_str()) and
        ty_eq(type_expr_to_node(base), ty_str()) and
        range.start == 6 and range.end == 9
      _ -> false
    }
  )
}
