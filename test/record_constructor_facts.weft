use compiler/ir/data.{*}
use compiler/pipeline.{pipeline_lambda_ir_body_subst}
use compiler/types/algebra.{ty_var, ty_str, ty_eq, subst_new, subst_add}

fn replacement() -> i64 {
  let subst = subst_new()
  subst_add(subst, 17, ty_str())
  subst
}

test "specialization preserves and substitutes inferred constructor facts" {
  let original = RecordInit(1, 3, RecordFieldListNil, InferredRecordType(type_expr_from_node(ty_var(17))))
  let concrete = pipeline_lambda_ir_body_subst(original, replacement())
  Test.assert_true(match concrete {
    RecordInit(1, 3, RecordFieldListNil, InferredRecordType(ty)) -> ty_eq(type_expr_to_node(ty), ty_str())
    _ -> false
  })
  Test.assert_true(match original {
    RecordInit(_, _, _, InferredRecordType(ty)) -> type_expr_tag_or(ty, -1) == 12
    _ -> false
  })
}

test "specialization preserves explicit constructor provenance" {
  let original = RecordInit(1, 3, RecordFieldListNil, ExplicitRecordType(type_expr_from_node(ty_var(17))))
  let concrete = pipeline_lambda_ir_body_subst(original, replacement())
  Test.assert_true(match concrete {
    RecordInit(1, 3, RecordFieldListNil, ExplicitRecordType(ty)) -> ty_eq(type_expr_to_node(ty), ty_str())
    _ -> false
  })
}

test "specialization leaves intentionally absent constructor input absent" {
  let original = RecordInit(1, 3, RecordFieldListNil, InferredRecordType(MissingTypeExpr))
  Test.assert_true(match pipeline_lambda_ir_body_subst(original, replacement()) {
    RecordInit(1, 3, RecordFieldListNil, InferredRecordType(MissingTypeExpr)) -> true
    _ -> false
  })
}
