-- test/ast_migration_metrics.weft -- real compiler-source AST migration gate

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use compiler/macho.{*}
use compiler/object.{*}
use "compiler/ir.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use stdlib/io.{*}

fn ast_migration_compiler_main_source() -> str {
  io_read_file_raw("compiler/main.weft")
}

fn ast_migration_compiler_main_parsed_metrics() -> AstMigrationMetrics {
  let src = ast_migration_compiler_main_source()
  pipeline_ast_migration_metrics(pipeline_parse_source_with_origin(__str_ptr(src), __str_len(src), 1, 0))
}

fn ast_migration_compiler_main_typed_metrics() -> AstMigrationMetrics {
  let src = ast_migration_compiler_main_source()
  pipeline_typed_ast_migration_metrics(pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0))
}

test "ast_migration_metrics_reads_compiler_main" {
  let src = ast_migration_compiler_main_source()
  Test.assert_gt(__str_ptr(src), 0)
  Test.assert_gt(__str_len(src), 0)
}

test "ast_migration_metrics_compiler_main_parsed_ready" {
  let metrics = ast_migration_compiler_main_parsed_metrics()
  Test.assert_gt(pipeline_ast_migration_decl_count(metrics), 0)
  Test.assert_gt(pipeline_ast_migration_type_entry_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_unknown_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_raw_bridge_slot_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_ready(metrics), 1)
}

test "ast_migration_metrics_compiler_main_typed_ready" {
  let metrics = ast_migration_compiler_main_typed_metrics()
  Test.assert_gt(pipeline_ast_migration_decl_count(metrics), 0)
  Test.assert_gt(pipeline_ast_migration_type_entry_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_unknown_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_raw_bridge_slot_count(metrics), 0)
  Test.assert_eq(pipeline_ast_migration_ready(metrics), 1)
}
