}

test "ck_wrong_value_in_home_is_pinpointed" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  ck_ev(events, 0, 4, 12, 41)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 911, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 1)
  Test.assert_eq(fmap_ck_first_expected(fm), 41)
  Test.assert_eq(fmap_ck_first_found(fm), 42)
}

-- Probe programs through the full audited pipeline: emission-recorded
-- events replayed over the real emitted buffer must verify cleanly and
-- actually check reads.

fn ck_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module_with_audit(typed, optimised, 1)
}

fn ck_positive(count: i64) -> i64 {
  if count > 0 { 1 } else { 0 }
}

test "ck_pressure_program_clean_and_checked" {
  let src = "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; a + b + c + d + e + f + g + h + i + j + k + l } fn main() -> i64 { work(1, 2) }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

test "ck_loop_program_pinned_open_violations" {
  -- OPEN CLASSIFICATION (2v Stage 0 bring-up): the first violation is a
  -- read of an identity-home value (x21 = value 2's canonical home)
  -- after a cs home-reuse tenant's const def wrote it. Candidate
  -- classes: mem2reg alias ids recorded under different event ids, a
  -- dead edge-arg move, or a real cs-pool liveness gap. Driving this
  -- pin to zero is the Stage 0 definition of done; any movement must
  -- re-run the classification, not just update the number.
  let src = "use \"stdlib/vector.weft\" fn f(v: i64) -> i64 { let len = vector_len(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 6)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

test "ck_sort_program_pinned_open_violations" {
  -- Same open-classification pin as the loop program above.
  let src = "use \"stdlib/vector.weft\" fn sortit(items: i64) -> i64 { let len = vector_len(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 5)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

fn ck_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "ck_whole_compiler_read_verification_tripwire" {
  -- Stage 0 bring-up tripwire: the compiler's own emission, replayed.
  -- The open-violation pin tracks the residual uninstrumented-def /
  -- alias-id discrepancies under classification (2v brief progress);
  -- Stage 0's definition of done drives it to zero. Any change that
  -- MOVES it — either direction — must re-run the classification, not
  -- just update the number.
  let file = read_file(ck_path_pair("compiler/main.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let native = pipeline_lower_native_module_with_audit(typed, optimised, 1)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 258)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native) - 150000), 1)
}
