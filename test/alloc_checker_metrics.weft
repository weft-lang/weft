-- test/alloc_checker_metrics.weft -- 2v allocation checker (Stage 0).
-- Round-trip coverage for decode_reads_aarch64, the read-side dual of the
-- emission audit's write decoder: every encoder in the emission vocabulary
-- is decoded back to its read set. The write decoder catches foreign
-- writes into tenancy windows; the read decoder is the primitive that lets
-- the 2v checker verify every operand READ observes the value the
-- allocator claims (the stale-read hole the 2l cs pool documented).
-- Bit scheme matches decode_writes: bits 0-30 x0-x30, bits 32-47 d0-d15,
-- bit 49 unknown.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/grammar.{*}
use "compiler/pipeline.weft"

test "reads_decoder_gpr_arithmetic_and_moves" {
  Test.assert_eq(decode_reads_aarch64(encode_movz(13, 7, 0)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_movk(12, 65535, 48)), 4096)
  Test.assert_eq(decode_reads_aarch64(encode_movn(14, 0)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_add_imm(12, 31, 16)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_sub_imm(13, 13, 1)), 8192)
  Test.assert_eq(decode_reads_aarch64(encode_add_reg(14, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_sub_reg(12, 13, 14)), 24576)
  Test.assert_eq(decode_reads_aarch64(encode_mul(13, 12, 14)), 20480)
  Test.assert_eq(decode_reads_aarch64(encode_sdiv(12, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_udiv(14, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_msub(13, 15, 16, 17)), 229376)
  Test.assert_eq(decode_reads_aarch64(encode_and_reg(12, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_orr_reg(13, 31, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_eor_reg(14, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_lsl_reg(12, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_asr_reg(13, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_lsr_reg(14, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_ldaxr(12, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_stlxr(12, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_stlr(12, 15)), 36864)
  Test.assert_eq(decode_reads_aarch64(encode_cmp(12, 13)), 12288)
  Test.assert_eq(decode_reads_aarch64(encode_cset(13, 0)), 0)
}

test "reads_decoder_fp_and_convert" {
  Test.assert_eq(decode_reads_aarch64(encode_fmov_d_from_x(2, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_fmov_x_from_d(12, 2)), 17179869184)
  Test.assert_eq(decode_reads_aarch64(encode_fmov_d_from_d(3, 4)), 68719476736)
  Test.assert_eq(decode_reads_aarch64(encode_fmov_s_from_w(5, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_fmov_w_from_s(13, 5)), 137438953472)
  Test.assert_eq(decode_reads_aarch64(encode_fmov_s_from_s(6, 7)), 549755813888)
  Test.assert_eq(decode_reads_aarch64(encode_sxtw(12, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_sxtb(13, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_sxth(14, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_uxtb(12, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_uxth(13, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_uxtw(14, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_scvtf_d_from_x(2, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_ucvtf_d_from_x(3, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_fcvtzs_x_from_d(12, 2)), 17179869184)
  Test.assert_eq(decode_reads_aarch64(encode_scvtf_s_from_x(4, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_ucvtf_s_from_x(5, 15)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_fcvtzs_x_from_s(13, 4)), 68719476736)
  Test.assert_eq(decode_reads_aarch64(encode_fcvt_d_from_s(2, 5)), 137438953472)
  Test.assert_eq(decode_reads_aarch64(encode_fcvt_s_from_d(5, 2)), 17179869184)
  Test.assert_eq(decode_reads_aarch64(encode_fadd_d(2, 3, 4)), 103079215104)
  Test.assert_eq(decode_reads_aarch64(encode_fsub_d(3, 4, 5)), 206158430208)
  Test.assert_eq(decode_reads_aarch64(encode_fmul_d(4, 5, 6)), 412316860416)
  Test.assert_eq(decode_reads_aarch64(encode_fdiv_d(5, 6, 7)), 824633720832)
  Test.assert_eq(decode_reads_aarch64(encode_fcmp_d(2, 3)), 51539607552)
  Test.assert_eq(decode_reads_aarch64(encode_fsqrt_d(6, 7)), 549755813888)
  Test.assert_eq(decode_reads_aarch64(encode_fadd_s(2, 3, 4)), 103079215104)
  Test.assert_eq(decode_reads_aarch64(encode_fsub_s(3, 4, 5)), 206158430208)
  Test.assert_eq(decode_reads_aarch64(encode_fmul_s(4, 5, 6)), 412316860416)
  Test.assert_eq(decode_reads_aarch64(encode_fdiv_s(5, 6, 7)), 824633720832)
  Test.assert_eq(decode_reads_aarch64(encode_fcmp_s(2, 3)), 51539607552)
  Test.assert_eq(decode_reads_aarch64(encode_fsqrt_s(7, 8)), 1099511627776)
}

test "reads_decoder_branch_mem_and_special" {
  Test.assert_eq(decode_reads_aarch64(encode_b(1024)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_b(0 - 1024)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_b_cond(0 - 64, 1)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_bl(2048)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_bl(0 - 2048)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_ret()), 1073741824)
  Test.assert_eq(decode_reads_aarch64(encode_stp_pre(19, 20, 31, 0 - 16)), 1572864)
  Test.assert_eq(decode_reads_aarch64(encode_stp_d_pre(8, 9, 31, 0 - 16)), 3298534883328)
  Test.assert_eq(decode_reads_aarch64(encode_ldp_post(29, 30, 31, 16)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_ldp_post(12, 13, 31, 16)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_ldp_d_post(8, 9, 31, 16)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_str(12, 31, 8)), 4096)
  Test.assert_eq(decode_reads_aarch64(encode_ldr(12, 31, 8)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_ldr(12, 15, 8)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_strb(12, 15, 3)), 36864)
  Test.assert_eq(decode_reads_aarch64(encode_ldrb(13, 15, 3)), 32768)
  Test.assert_eq(decode_reads_aarch64(encode_adrp(12, 0 - 2)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_adr(17, 0 - 8)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_svc()), 0)
  Test.assert_eq(decode_reads_aarch64(encode_brk(20)), 0)
  Test.assert_eq(decode_reads_aarch64(encode_ldr_reg_lsl3(12, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_ldr_d_reg_lsl3(2, 15, 16)), 98304)
  Test.assert_eq(decode_reads_aarch64(encode_str_reg_lsl3(12, 15, 16)), 102400)
  Test.assert_eq(decode_reads_aarch64(encode_str_d_reg_lsl3(2, 15, 16)), 17179967488)
  Test.assert_eq(decode_reads_aarch64(encode_blr(16)), 65536)
  Test.assert_eq(decode_reads_aarch64(3019898880 + 32 + 14), 16384)
  Test.assert_eq(decode_reads_aarch64(encode_cbnz(5, 64)), 32)
  -- unpatched placeholder reads nothing; garbage is unknown
  Test.assert_eq(decode_reads_aarch64(0), 0)
  Test.assert_eq(decode_reads_aarch64(3), decode_writes_unknown_bit())
}

-- Hand-built replay verdicts. Each builds a code buffer plus the event
-- ledger the emission choke points would have produced, replays, and
-- pins the verdict counters and first-violation detail.

fn ck_probe_fm() -> i64 {
  let fm = fmap_new()
  fmap_set_current_frame_size(fm, 2048)
  fm
}

fn ck_ev(events: i64, kind: i64, off: i64, loc: i64, value: i64) -> i64 {
  nlist_add(events, node_new(kind, off, loc, value, 0))
  0
}

test "ck_clean_def_then_read_is_checked" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  ck_ev(events, 0, 4, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 900, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_foreign_write_between_def_and_read_violates" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_movz(12, 9, 0))
  ck_ev(events, 0, 8, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 901, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 1)
  Test.assert_eq(fmap_ck_checked_count(fm), 0)
  Test.assert_eq(fmap_ck_first_fn_hash(fm), 901)
  Test.assert_eq(fmap_ck_first_offset(fm), 8)
  Test.assert_eq(fmap_ck_first_loc(fm), 12)
  Test.assert_eq(fmap_ck_first_expected(fm), 40)
  Test.assert_eq(fmap_ck_first_found(fm), 1)
}

test "ck_move_propagates_value" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_add_imm(13, 12, 0))
  ck_ev(events, 0, 8, 13, 40)
  bu32(code, encode_add_reg(0, 13, 13))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 902, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_slot_store_load_roundtrip" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(17, 5, 0))
  ck_ev(events, 1, 4, 17, 40)
  bu32(code, encode_str(17, 31, 16))
  ck_ev(events, 1, 8, 0 - 3, 40)
  bu32(code, encode_movz(17, 9, 0))
  ck_ev(events, 0, 12, 0 - 3, 40)
  bu32(code, encode_ldr(16, 31, 16))
  ck_ev(events, 0, 16, 16, 40)
  bu32(code, encode_add_reg(0, 16, 16))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 903, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 2)
}

test "ck_call_kills_volatile_but_not_callee_saved" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_movz(23, 6, 0))
  ck_ev(events, 1, 8, 23, 41)
  bu32(code, encode_bl(64))
  ck_ev(events, 0, 12, 23, 41)
  ck_ev(events, 0, 12, 12, 40)
  bu32(code, encode_add_reg(0, 23, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 904, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 1)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
  Test.assert_eq(fmap_ck_first_loc(fm), 12)
}

test "ck_slots_survive_calls" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(17, 5, 0))
  ck_ev(events, 1, 4, 17, 40)
  bu32(code, encode_str(17, 31, 24))
  ck_ev(events, 1, 8, 0 - 4, 40)
  bu32(code, encode_bl(64))
  ck_ev(events, 0, 12, 0 - 4, 40)
  bu32(code, encode_ldr(16, 31, 24))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 905, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_unreachable_block_stays_unchecked" {
  -- The block after an unconditional b is reachable by no edge: its
  -- entry stays TOP and its reads are never judged.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_b(8))
  ck_ev(events, 0, 8, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 906, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 0)
}

test "ck_branch_target_join_agreement_stays_checked" {
  -- The cbnz's taken edge lands on the read, but both incoming paths
  -- (taken and fallthrough-through-the-middle-block) carry the same
  -- content: the v2 meet keeps it and the read is verified. (Under the
  -- v1 linear replay this was a coverage reset.)
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_cbnz(5, 8))
  ck_ev(events, 0, 12, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 907, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_join_disagreement_goes_unchecked" {
  -- Taken path carries value 40 in x12, fallthrough path redefines x12
  -- as value 41 before the join: the meet must-agree rule drops x12 to
  -- BOTTOM at the join — the read is neither checked nor a violation.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_cbnz(5, 12))
  bu32(code, encode_movz(12, 9, 0))
  ck_ev(events, 1, 12, 12, 41)
  bu32(code, encode_b(4))
  ck_ev(events, 0, 16, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 914, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 0)
}

test "ck_loop_backedge_agreement_checked" {
  -- A loop header reached from the preheader and from its own backedge:
  -- the loop body re-defs the counter under the same value id, so the
  -- meet converges and both the in-loop read and the post-loop read of
  -- the invariant value verify.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_movz(13, 0, 0))
  ck_ev(events, 1, 8, 13, 41)
  ck_ev(events, 0, 8, 12, 40)
  bu32(code, encode_sub_imm(13, 13, 1))
  ck_ev(events, 1, 12, 13, 41)
  bu32(code, encode_cbnz(13, 0 - 4))
  ck_ev(events, 0, 16, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 915, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 2)
}

test "ck_conditional_fallthrough_keeps_tracking" {
  -- The cbnz jumps PAST the read (target 12): the read at 8 sits on the
  -- pure fallthrough path and stays checked.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_cbnz(5, 12))
  ck_ev(events, 0, 8, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 908, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_sp_dance_preserves_slot_tracking" {
  -- The outgoing-arg dance (sub sp / arg store / bl / arg load /
  -- add sp) must not drop frame-slot tracking: slot addressing is
  -- bias-adjusted while sp sits below the frame base, and the arg-area
  -- store at [sp, #0] does not touch frame slot 0.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(17, 5, 0))
  ck_ev(events, 1, 4, 17, 40)
  bu32(code, encode_str(17, 31, 16))
  ck_ev(events, 1, 8, 0 - 3, 40)
  bu32(code, encode_sub_imm(31, 31, 16))
  bu32(code, encode_str(12, 31, 0))
  bu32(code, encode_bl(64))
  bu32(code, encode_ldr(12, 31, 0))
  bu32(code, encode_add_imm(31, 31, 16))
  ck_ev(events, 0, 28, 0 - 3, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 909, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_sp_sub_biases_slot_reads" {
  -- A read of a tracked slot recorded while sp is biased still checks:
  -- the emitter-recorded slot id is frame-relative and the replay's
  -- bias accounting keeps the cell aligned.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(17, 5, 0))
  ck_ev(events, 1, 4, 17, 40)
  bu32(code, encode_str(17, 31, 16))
  ck_ev(events, 1, 8, 0 - 3, 40)
  bu32(code, encode_sub_imm(31, 31, 32))
  ck_ev(events, 0, 12, 0 - 3, 40)
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 916, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 1)
}

test "ck_unmatched_sp_add_resets_slots" {
  -- An add sp with no matching dance sub (epilogue shape) drops slot
  -- tracking conservatively.
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(17, 5, 0))
  ck_ev(events, 1, 4, 17, 40)
  bu32(code, encode_str(17, 31, 16))
  ck_ev(events, 1, 8, 0 - 3, 40)
  bu32(code, encode_add_imm(31, 31, 32))
  ck_ev(events, 0, 12, 0 - 3, 40)
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 917, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 0)
}

test "ck_unknown_word_bails_to_untracked" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, 3)
  ck_ev(events, 0, 8, 12, 40)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 910, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 0)
}

test "ck_copy_source_keeps_old_binding" {
  -- A register-to-home copy (add home, src, #0) rebinds only the HOME:
  -- the source register still holds its previous tenant (the copied
  -- value equals it), and a later read of that tenant from the source
  -- register must stay checked-clean. Rebinding the source under the
  -- copy's id was the Stage 0 bring-up false-positive class (the whole
  -- 258/6/5 pin population).
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  bu32(code, encode_add_imm(22, 12, 0))
  ck_ev(events, 1, 8, 22, 41)
  ck_ev(events, 0, 8, 12, 40)
  ck_ev(events, 0, 8, 22, 41)
  bu32(code, encode_add_reg(0, 12, 22))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 912, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 0)
  Test.assert_eq(fmap_ck_checked_count(fm), 2)
}

test "ck_wrong_value_in_home_is_pinpointed" {
  let fm = ck_probe_fm()
  let code = buf_new(4096)
  let events = nlist_new()
  bu32(code, encode_movz(12, 5, 0))
  ck_ev(events, 1, 4, 12, 40)
  ck_ev(events, 0, 4, 12, 41)
  bu32(code, encode_add_reg(0, 12, 12))
  bu32(code, encode_ret())
  pipeline_ir_native_alloc_checker_function(code, fm, 911, 0, events)
  Test.assert_eq(fmap_ck_violation_count(fm), 1)
  Test.assert_eq(fmap_ck_first_expected(fm), 41)
  Test.assert_eq(fmap_ck_first_found(fm), 42)
}

-- Probe programs through the full audited pipeline: emission-recorded
-- events replayed over the real emitted buffer must verify cleanly and
-- actually check reads.

fn ck_native(src: str) -> NativeModule {
  let typed = pipeline_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  pipeline_lower_native_module_with_audit(typed, optimised, 1)
}

fn ck_positive(count: i64) -> i64 {
  if count > 0 { 1 } else { 0 }
}

test "ck_pressure_program_clean_and_checked" {
  let src = "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; a + b + c + d + e + f + g + h + i + j + k + l } fn main() -> i64 { work(1, 2) }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

test "ck_stage1_premeasurement_counters_populate" {
  -- Stage 1 pre-measurement sanity: 12 chained values live across a
  -- RECURSIVE call (recursion defeats the inliner; a leaf probe called
  -- with constants folds away entirely) force max pressure past the
  -- 8-register bank and a measured call site with a fat crossing set.
  -- Floors, not exact pins — the liveness numbers move with the
  -- optimizer; the whole-compiler tripwire below carries the corpus
  -- floors.
  let src = "fn work(a: i64, b: i64) -> i64 { let c = a + b; let d = c + a; let e = d + b; let f = e + c; let g = f + d; let h = g + e; let i = h + f; let j = i + g; let k = j + h; let l = k + i; if a < 2 { a + b + c + d + e + f + g + h + i + j + k + l } else { work(a - 1, l) + a + b + c + d + e + f + g + h + i + j + k + l } } fn main() -> i64 { work(9, 2) }"
  let native = ck_native(src)
  Test.assert_eq(ck_positive(pipeline_native_live_functions_measured(native) - 1), 1)
  Test.assert_eq(ck_positive(pipeline_native_max_pressure(native) - 8), 1)
  Test.assert_eq(ck_positive(pipeline_native_call_sites_measured(native)), 1)
}

test "ck_loop_program_clean" {
  -- CLASSIFIED CLOSED (2v Stage 0): the entire 6/5/258 pin population
  -- was ONE class — store_reg_pinned's source-register double-def
  -- rebinding a non-x17 copy source under the copy's id, erasing the
  -- source's still-live tenant; the next genuine read of the old
  -- tenant then flagged. Ground truth by hand-decode of this probe's
  -- f: not mem2reg alias ids, not dead edge-args, not a cs-pool
  -- liveness gap — the emitted code was correct. Fix: only x17 (the
  -- sole forwarding-read staging register) is rebound on copies. This
  -- pin at ZERO is the checker gate; any regression must re-run the
  -- classification, not bump the number.
  let src = "use \"stdlib/vector.weft\" fn f(v: Vector<i64>) -> i64 { let len = vector_len<i64>(v) let mut i = 0 let mut s = 0 while i < len { s = s + vector_get<i64>(v, i, 0) i = i + 1 } s } fn main() -> i64 { 0 }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

test "ck_sort_program_clean" {
  -- Same closed classification as the loop program above.
  let src = "use \"stdlib/vector.weft\" fn sortit(items: Vector<i64>) -> Vector<i64> { let len = vector_len<i64>(items) let mut i = 1 while i < len { let key = vector_get<i64>(items, i, 0) let mut j = i - 1 let mut moving = 1 while moving == 1 { if j >= 0 and vector_get<i64>(items, j, 0) > key { vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0)) j = j - 1 } else { moving = 0 } } vector_set<i64>(items, j + 1, key) i = i + 1 } items } fn main() -> i64 { 0 }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native)), 1)
}

fn ck_path_pair(path: str) -> i64 {
  let pair = alloc_words(2)
  mem_store64_at(pair, 0, __str_ptr(path))
  mem_store64_at(pair, 8, __str_len(path))
  pair
}

test "ck_whole_compiler_read_verification_tripwire" {
  -- The compiler's own emission, replayed, at ZERO violations: this is
  -- the live checker gate (2v). Every read the emission records must
  -- observe the value the allocator claims. Any change that moves the
  -- count off zero is a regression to classify at ground truth (IR +
  -- event + code dump), never a number to bump.
  let file = read_file(ck_path_pair("compiler/main.weft"))
  let csrc = mem_load64_at(file, 0)
  let clen = mem_load64_at(file, 8)
  let typed = pipeline_check_source_with_origin(csrc, clen, 1, 0)
  let ir = pipeline_lower_ir(typed)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  let native = pipeline_lower_native_module_with_audit(typed, optimised, 1)
  -- Floor sits below the current v2 deterministic count (312,030) but
  -- ABOVE the v1 linear replay's 186,677: a regression that silently
  -- reverts the CFG-worklist join coverage fails this gate.
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(ck_positive(pipeline_native_ck_checked_count(native) - 250000), 1)
  -- Stage 1 pre-measurement corpus floors: liveness must have measured
  -- the bulk of the corpus and found call sites, real pressure, and
  -- spilled defs — zeros here mean the producer silently disengaged.
  Test.assert_eq(ck_positive(pipeline_native_live_functions_measured(native) - 5000), 1)
  Test.assert_eq(ck_positive(pipeline_native_call_sites_measured(native) - 10000), 1)
  Test.assert_eq(ck_positive(pipeline_native_max_pressure(native) - 10), 1)
  Test.assert_eq(ck_positive(pipeline_native_spill_load_bucket(native, 0) + pipeline_native_spill_load_bucket(native, 1) - 100), 1)
  -- Prologue-pair census canary (2v Stage 2): every callee-saved
  -- register the emitted body writes must sit inside the saved pair
  -- prefix. 32 handler-clause writes escaped before the handle-bearing
  -- pair force; this pin at ZERO is the save-discipline gate — a
  -- regression is caller corruption the checker cannot see.
  Test.assert_eq(pipeline_native_pair_census_counter(native, 4), 0)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 5), 0)
  Test.assert_eq(ck_positive(pipeline_native_pair_census_counter(native, 0) - 10000), 1)
  -- Soft-barrier census after the C1 flips (C1a pool-transparent set +
  -- C1b bespoke-arm re-scratch): every former soft barrier is now
  -- simple, so the only remaining soft kind is content-eq (44) — and
  -- the compiler corpus contains no str ==/!= (node ids and src_eq
  -- carry all its comparisons). These pins at ZERO lock that state: a
  -- nonzero count means either a new pool-clobbering intrinsic joined
  -- the emitter or str equality entered the compiler — both worth a
  -- conscious look at the mask table. The specimen test below keeps
  -- the census machinery itself proven live.
  Test.assert_eq(pipeline_native_soft_barrier_counter(native, 0), 0)
  Test.assert_eq(ck_positive(pipeline_native_soft_barrier_counter(native, 1) - 40000), 1)
  Test.assert_eq(pipeline_native_soft_barrier_counter(native, 2), 0)
  -- Fn-param pool residency floors (2v Stage 2 S0): thousands of
  -- parameters live in caller-saved seats corpus-wide (whole-window +
  -- call-final classes). Zeros mean the admission silently disengaged.
  Test.assert_eq(ck_positive(pipeline_native_fn_param_resident_counter(native, 0) - 1000), 1)
  Test.assert_eq(ck_positive(pipeline_native_fn_param_resident_counter(native, 1) - 1000), 1)
  -- Cross-block pool residency floors (2v Stage 2 C3): barrier-free
  -- cross-block windows (rounded over enclosing loops) and their
  -- call-final variant live in caller-saved seats corpus-wide
  -- (1,864 / 631 at landing). Zeros mean the admission silently
  -- disengaged.
  Test.assert_eq(ck_positive(pipeline_native_crossblock_pool_counter(native, 0) - 1000), 1)
  Test.assert_eq(ck_positive(pipeline_native_crossblock_pool_counter(native, 1) - 300), 1)
}

test "intrinsic_clobber_mask_pins" {
  -- The C1 colorer's interference input: exact GPR clobber masks per
  -- inline-emitting intrinsic kind, audited against the emitter arm by
  -- arm. A new kind lands as a true barrier (-1) until audited here.
  -- C1b re-scratched the bespoke arms off the pools: 2/3/8 and 35-37
  -- are x15|x16|x17 (229376), 12 adds x0 (229377), 38-43 are x16|x17
  -- (196608), and frame-pointer capture (45) writes only x17 (131072);
  -- only content-eq (44) still holds pool scratch.
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(4), 196609)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(2), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(3), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(8), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(12), 229377)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(13), 196609)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(19), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(20), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(29), 196609)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(35), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(36), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(37), 229376)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(38), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(39), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(40), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(41), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(42), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(43), 196608)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(44), 261120)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(45), 131072)
  -- True barriers: bump-alloc + sized mem (BL out on grow/copy arms),
  -- real calls, fiber switches, syscall, unknown/unaudited kinds.
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(1), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(14), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(15), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(16), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(23), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(24), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(34), 0 - 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_clobber_mask(0), 0 - 1)
}

fn arity10_sink(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64) -> i64 {
  if a < 1 { a + b + c + d + e + f + g + h + i + j }
  else { arity10_sink(a - 1, b, c, d, e, f, g, h, i, j) }
}

fn arity9_wrapper(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
  arity10_sink(a, b, c, d, e, f, g, h, i, 42)
}

test "call_window_seat_survives_high_arity_staging" {
  -- Regression (2026-08-03): move_call_args writes x0..arity-1, not
  -- just x0-x7. A class-2 (x8/x10-x14) call-window tenant seated
  -- below the final call's arity was clobbered by a lower argument's
  -- staging before its own read — the 9-param wrapper's appended
  -- constant is exactly the shape that seated in x8 under a 10-arg
  -- call. The arity guard keeps seats at or above the staged count.
  Test.assert_eq(arity9_wrapper(3, 1, 2, 3, 4, 5, 6, 7, 8), 78)
  Test.assert_eq(arity9_wrapper(0, 10, 20, 30, 40, 50, 60, 70, 80), 402)
}

test "intrinsic_pool_transparent_pins" {
  -- The C1 simple-flip set, exactly: mask != -1 and mask band 32766 == 0
  -- (no x1-x14 writes). A kind in this set is NOT a barrier — the
  -- resident walk, split hooks, and fp classification all treat it as a
  -- plain inline instruction. Widening this set requires re-auditing
  -- the emitter arm for BOTH register files (GPR pool and d2-d7).
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(4), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(5), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(6), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(7), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(9), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(10), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(11), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(13), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(19), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(20), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(21), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(22), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(25), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(26), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(27), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(28), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(29), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(30), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(31), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(32), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(33), 1)
  -- C1b: the re-scratched bespoke arms joined the transparent set —
  -- mem stores + raw_offset (x15 staging), atomic lock (x15/x16/x17),
  -- the scaled/bridge family (base x15, value carried in x17).
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(2), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(3), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(8), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(12), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(35), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(36), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(37), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(38), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(39), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(40), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(41), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(42), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(43), 1)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(45), 1)
  -- content-eq keeps pool scratch (6-register byte loop) and stays a
  -- (soft) barrier; it also clobbers the x10/x11 pin bank, so it must
  -- stay in intrinsic_clobbers_pinned.
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(44), 0)
  -- True barriers stay true barriers.
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(1), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(14), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(15), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(16), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(17), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(18), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(23), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(24), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(34), 0)
  Test.assert_eq(pipeline_ir_native_intrinsic_pool_transparent(0), 0)
}

test "soft_barrier_census_classifies_specimen" {
  -- str equality lowers to the content-eq intrinsic (kind 44, soft);
  -- the recursive caller's self-call is a true barrier. The specimen
  -- fn must land in the soft-only class; both event classes must be
  -- populated; checker and canary stay at zero.
  let src = "fn sb_eqcheck(a: str, b: str) -> i64 { if a == b { 1 } else { 0 } } fn sb_caller(n: i64, s: str) -> i64 { if n == 0 { 0 } else { sb_eqcheck(s, s) + sb_caller(n - 1, s) } } fn main() -> i64 { sb_caller(3, \"abc\") }"
  let native = ck_native(src)
  Test.assert_eq(ck_positive(pipeline_native_soft_barrier_counter(native, 0)), 1)
  Test.assert_eq(ck_positive(pipeline_native_soft_barrier_counter(native, 1)), 1)
  Test.assert_eq(ck_positive(pipeline_native_soft_barrier_counter(native, 2)), 1)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 4), 0)
}

test "pair_census_handler_clause_bank_writes_stay_saved" {
  -- The reproducer shape: a small parent (few own values) whose handler
  -- clause bodies carry their own value numbering into bank homes the
  -- parent's next_value would not save. Handle-bearing functions must
  -- force all four pairs.
  let src = "effect PairCkFx { fn ping(x: i64) -> i64 } fn pair_ck_perform(x: i64) -[PairCkFx]> i64 { PairCkFx.ping(x) } fn pair_ck_handle(x: i64) -> i64 { handle pair_ck_perform(x) { PairCkFx.ping(v) -> { let a = v + 1 let b = a + 1 let c = b + 1 let d = c + 1 let e = d + 1 resume(e) } } } fn main() -> i64 { pair_ck_handle(10) }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 4), 0)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 5), 0)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
}

effect PairCkRtFx {
  fn ping(x: i64) -> i64
}

fn pair_ck_rt_perform(x: i64) -[PairCkRtFx]> i64 {
  PairCkRtFx.ping(x)
}

fn pair_ck_rt_handle(x: i64) -> i64 {
  handle pair_ck_rt_perform(x) {
    PairCkRtFx.ping(v) -> {
      let a = v + 1
      let b = a + 1
      let c = b + 1
      let d = c + 1
      let e = d + 1
      resume(e - 5)
    }
  }
}

fn pair_ck_rt_caller(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64) -> i64 {
  -- Recursion defeats the inliner; the params live in bank registers
  -- across the handler call, so a clause write to an unsaved pair
  -- corrupts one of them (the pre-fix failure mode).
  if p0 == 0 { 0 } else {
    let r = pair_ck_rt_handle(p0)
    p0 + p1 + p2 + p3 + p4 + r + pair_ck_rt_caller(p0 - p0, p1, p2, p3, p4)
  }
}

test "pair_census_runtime_bank_values_survive_handler_clause" {
  Test.assert_eq(pair_ck_rt_caller(10, 20, 30, 40, 50), 160)
}

test "naked_leaf_qualifies_and_checks_clean" {
  -- tiny_add is single-block, bank-sized, slot-free: naked. pick's
  -- if-merge carries a block param, so it stays framed (the shuffle
  -- conservatism) — both must verify clean under the checker and the
  -- pair-census canary.
  let src = "fn tiny_add(a: i64, b: i64) -> i64 { a + b } fn pick(a: i64, b: i64) -> i64 { if a < b { a } else { b } } fn main(x: i64) -> i64 { tiny_add(x, 2) + pick(x, 3) }"
  let native = ck_native(src)
  Test.assert_eq(ck_positive(pipeline_native_naked_leaf_counter(native, 0)), 1)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 4), 0)
}

test "naked_leaf_slot_and_call_shapes_stay_framed" {
  -- Calls need x30 and surviving slots read the frame, so neither
  -- shape may go naked (mem2reg legitimately promotes slotted's slot
  -- away, making it naked-eligible; the module count includes prelude
  -- leaves, so this pins the checker gate rather than an exact count).
  let src = "fn slotted(a: i64) -> i64 { let mut m = a m = m + 1 m } fn calling(a: i64) -> i64 { slotted(a) + 1 } fn main(x: i64) -> i64 { calling(x) }"
  let native = ck_native(src)
  Test.assert_eq(pipeline_native_ck_violation_count(native), 0)
  Test.assert_eq(pipeline_native_pair_census_counter(native, 4), 0)
}

fn nk_rt_leaf(a: i64, b: i64, c: i64) -> i64 {
  a * 2 + b - c
}

fn nk_rt_caller(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64) -> i64 {
  -- Recursion defeats the inliner; the caller's bank values must
  -- survive the naked-leaf call untouched (it saves nothing because it
  -- clobbers nothing).
  if p0 == 0 { 0 } else {
    let r = nk_rt_leaf(p1, p2, p3)
    p0 + p1 + p2 + p3 + p4 + r + nk_rt_caller(p0 - p0, p1, p2, p3, p4)
  }
}

test "naked_leaf_runtime_semantics_and_caller_bank_survival" {
  Test.assert_eq(nk_rt_leaf(3, 4, 5), 5)
  -- r = nk_rt_leaf(20, 30, 40) = 20*2 + 30 - 40 = 30
  Test.assert_eq(nk_rt_caller(10, 20, 30, 40, 50), 10 + 20 + 30 + 40 + 50 + 30)
}
