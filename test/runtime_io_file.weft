use "runtime/alloc.weft"
use "stdlib/io.weft"
use "stdlib/string.weft"

fn io_mock_read_file_program() -[IO]> str {
  io_read_file("mock-path")
}

fn io_mock_write_file_program() -[IO]> i64 {
  io_write_file("mock-path", "abc")
}

test "runtime_io_cstring_boundaries" {
  let empty = io_cstring("")
  let word = io_cstring("abc")
  Test.assert_eq(__mem_load8(empty), 0)
  Test.assert_eq(__mem_load8(word), 97)
  Test.assert_eq(__mem_load8(word + 1), 98)
  Test.assert_eq(__mem_load8(word + 2), 99)
  Test.assert_eq(__mem_load8(word + 3), 0)
}

test "runtime_io_write_file_mock_handler" {
  let seen = alloc_bump(40)
  let got = handle io_mock_write_file_program() {
    IO.open(path, flags, mode) -> {
      __mem_store64(seen, flags)
      __mem_store64(seen + 8, mode)
      resume(7)
    }
    IO.write(fd, buf, len) -> {
      __mem_store64(seen + 16, fd)
      __mem_store64(seen + 24, len)
      __mem_store64(seen + 32, __mem_load8(buf))
      resume(len)
    }
    IO.close(fd) -> resume(0)
  }
  Test.assert_eq(got, 3)
  Test.assert_eq(__mem_load64(seen), io_o_write_create_trunc())
  Test.assert_eq(__mem_load64(seen + 8), io_mode_user_rw())
  Test.assert_eq(__mem_load64(seen + 16), 7)
  Test.assert_eq(__mem_load64(seen + 24), 3)
  Test.assert_eq(__mem_load64(seen + 32), 97)
}

test "runtime_io_read_file_mock_handler" {
  let reads = alloc_bump(8)
  __mem_store64(reads, 0)
  let got = handle io_mock_read_file_program() {
    IO.open(path, flags, mode) -> resume(9)
    IO.read(fd, buf, len) -> {
      let count = __mem_load64(reads)
      if count == 0 {
        __mem_store8(buf, 111)
        __mem_store8(buf + 1, 107)
        __mem_store64(reads, 1)
        resume(2)
      } else {
        resume(0)
      }
    }
    IO.close(fd) -> resume(0)
  }
  Test.assert_eq(str_eq(got, "ok"), 1)
  Test.assert_eq(__mem_load64(reads), 1)
}

test "runtime_io_read_file_open_failure_is_empty" {
  let got = handle io_read_file("missing") {
    IO.open(path, flags, mode) -> resume(0 - 2)
  }
  Test.assert_eq(str_len(got), 0)
}

test "runtime_io_raw_file_roundtrip_and_unlink" {
  let path = "/tmp/weft-runtime-io-file.txt"
  raw_unlink(io_cstring(path))
  let missing_before = raw_open(io_cstring(path), io_o_rdonly(), 0)
  let wrote = io_write_file_raw(path, "roundtrip")
  let read_back = io_read_file_raw(path)
  let unlinked = raw_unlink(io_cstring(path))
  let missing = io_read_file_raw(path)
  Test.assert_eq(if missing_before < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(wrote, 9)
  Test.assert_eq(str_eq(read_back, "roundtrip"), 1)
  Test.assert_eq(unlinked, 0)
  Test.assert_eq(str_len(missing), 0)
}
