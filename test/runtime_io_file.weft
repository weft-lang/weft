use runtime/memory.{*}
use runtime/alloc.{*}
use runtime/string.{*}
use stdlib/io.{*}
use stdlib/string.{*}

effect FileAbort {
  fn stop(value: i64) -> i64
}

fn io_mock_read_file_program() -[IO]> str {
  io_read_file("mock-path")
}

fn io_mock_write_file_program() -[IO]> i64 {
  io_write_file("mock-path", "abc")
}

fn io_owned_file_abort(log: i64) -[IO, FileAbort]> i64 {
  let file: owned FileHandle = io_file_open_read("mock-path")
  mem_store64(log, mem_load64(log) * 10 + 1)
  FileAbort.stop(42) + 1000
}

fn io_owned_file_loop() -[IO]> i64 {
  let mut i = 0
  while i < 3 {
    let file: owned FileHandle = io_file_open_read("mock-path")
    i = i + 1
  }
  0
}

test "runtime_io_cstring_scope_preserves_boundary_bytes" {
  let empty = runtime_str_with_cstring_i64("", (raw) => mem_load8(raw))
  let word = runtime_str_with_cstring_i64("abc", (raw) => {
    mem_load8(raw) + mem_load8(raw + 1) + mem_load8(raw + 2) + mem_load8(raw + 3)
  })
  Test.assert_eq(empty, 0)
  Test.assert_eq(word, 294)
}

test "runtime_io_write_file_mock_handler" {
  let arena = arena_new(64)
  let seen = arena_alloc(arena, 40, 8)
  let got = handle io_mock_write_file_program() {
    IO.open_write(path) -> {
      mem_store64(seen, 1)
      resume(7)
    }
    IO.write(fd, buf, len) -> {
      mem_store64(seen + 8, fd)
      mem_store64(seen + 16, len)
      mem_store64(seen + 24, mem_load8(buf))
      resume(len)
    }
    IO.close(fd) -> resume(0)
  }
  Test.assert_eq(got, 3)
  Test.assert_eq(mem_load64(seen), 1)
  Test.assert_eq(mem_load64(seen + 8), 7)
  Test.assert_eq(mem_load64(seen + 16), 3)
  Test.assert_eq(mem_load64(seen + 24), 97)
  arena_free(arena)
}

test "runtime_io_read_file_mock_handler" {
  let arena = arena_new(64)
  let reads = arena_alloc(arena, 8, 8)
  mem_store64(reads, 0)
  let got = handle io_mock_read_file_program() {
    IO.open_read(path) -> resume(9)
    IO.read(fd, buf, len) -> {
      let count = mem_load64(reads)
      if count == 0 {
        mem_store8(buf, 111)
        mem_store8(buf + 1, 107)
        mem_store64(reads, 1)
        resume(2)
      } else {
        resume(0)
      }
    }
    IO.close(fd) -> resume(0)
  }
  Test.assert_eq(str_eq(got, "ok"), 1)
  Test.assert_eq(mem_load64(reads), 1)
  arena_free(arena)
}

test "runtime_io_read_file_open_failure_is_empty" {
  let got = handle io_read_file("missing") {
    IO.open_read(path) -> resume(0 - 2)
  }
  Test.assert_eq(str_len(got), 0)
}

test "runtime_io_owned_file_auto_drop_uses_local_handler" {
  let arena = arena_new(64)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(log, 0)
  let got = handle {
    let file: owned FileHandle = io_file_open_read("mock-path")
    mem_store64(log, mem_load64(log) * 10 + 1)
    55
  } {
    IO.open_read(path) -> {
      mem_store64(log, mem_load64(log) * 10 + 2)
      resume(7)
    }
    IO.read(fd, buf, len) -> resume(0)
    IO.write(fd, buf, len) -> resume(len)
    IO.close(fd) -> {
      mem_store64(log, mem_load64(log) * 10 + fd)
      resume(0)
    }
  }
  Test.assert_eq(got, 55)
  Test.assert_eq(mem_load64(log), 217)
  arena_free(arena)
}

test "runtime_io_owned_file_defer_runs_before_drop" {
  let arena = arena_new(64)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(log, 0)
  let got = handle {
    let file: owned FileHandle = io_file_open_read("mock-path")
    defer mem_store64(log, mem_load64(log) * 10 + 3)
    mem_store64(log, mem_load64(log) * 10 + 1)
    88
  } {
    IO.read(fd, buf, len) -> resume(0)
    IO.write(fd, buf, len) -> resume(len)
    IO.open_read(path) -> resume(7)
    IO.close(fd) -> {
      mem_store64(log, mem_load64(log) * 10 + fd)
      resume(0)
    }
  }
  Test.assert_eq(got, 88)
  Test.assert_eq(mem_load64(log), 137)
  arena_free(arena)
}

test "runtime_io_opaque_owned_file_drops_on_abort" {
  let arena = arena_new(64)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(log, 0)
  let got = handle {
    handle io_owned_file_abort(log) {
      FileAbort.stop(value) -> value
    }
  } {
    IO.open_read(path) -> resume(7)
    IO.read(fd, buf, len) -> resume(0)
    IO.write(fd, buf, len) -> resume(len)
    IO.close(fd) -> {
      mem_store64(log, mem_load64(log) * 10 + fd)
      resume(0)
    }
  }
  Test.assert_eq(got, 42)
  Test.assert_eq(mem_load64(log), 17)
  arena_free(arena)
}

test "runtime_io_opaque_owned_file_drops_each_loop_iteration" {
  let arena = arena_new(64)
  let opened = arena_alloc(arena, 8, 8)
  let log = arena_alloc(arena, 8, 8)
  mem_store64(opened, 0)
  mem_store64(log, 0)
  let got = handle io_owned_file_loop() {
    IO.open_read(path) -> {
      let next = mem_load64(opened) + 1
      mem_store64(opened, next)
      resume(next)
    }
    IO.read(fd, buf, len) -> resume(0)
    IO.write(fd, buf, len) -> resume(len)
    IO.close(fd) -> {
      mem_store64(log, mem_load64(log) * 10 + fd)
      resume(0)
    }
  }
  Test.assert_eq(got, 0)
  Test.assert_eq(mem_load64(log), 123)
  arena_free(arena)
}

test "runtime_io_raw_file_roundtrip_and_unlink" {
  let path = "/tmp/weft-runtime-io-file.txt"
  raw_remove(path)
  let missing_before = raw_open_read(path)
  let wrote = io_write_file_raw(path, "roundtrip")
  let read_back = io_read_file_raw(path)
  let unlinked = raw_remove(path)
  let missing = io_read_file_raw(path)
  Test.assert_eq(if missing_before < 0 { 1 } else { 0 }, 1)
  Test.assert_eq(wrote, 9)
  Test.assert_eq(str_eq(read_back, "roundtrip"), 1)
  Test.assert_eq(unlinked, 0)
  Test.assert_eq(str_len(missing), 0)
}
