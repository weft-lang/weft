use stdlib/num.{*}

fn same_f32(a: f32, b: f32) -> i64 {
  if a == b { 1 } else { 0 }
}

fn same_f64(a: f64, b: f64) -> i64 {
  if a == b { 1 } else { 0 }
}

fn near_f64(a: f64, b: f64, eps: f64) -> i64 {
  let diff = if a > b { a - b } else { b - a }
  if diff < eps { 1 } else { 0 }
}

fn take_f32(value: f32) -> f32 {
  value
}

fn add_f32(a: f32, b: f32) -> f32 {
  a + b
}

fn is_f32_first_arg(a: f32) -> i64 {
  if a == 1.5 { 1 } else { 0 }
}

fn is_f32_second_arg(x: i64, a: f32) -> i64 {
  if x == 7 and a == 1.5 { 1 } else { 0 }
}

fn contextual_f32_return() -> f32 {
  1.25 + 0.75
}

fn f32_branch_score(value: f32) -> i64 {
  if value > 1.0 and value <= 2.0 { 10 } else { 0 }
}

type F32MethodBox {
  F32MethodBox(f32)
}

impl F32MethodBox {
  fn add(self: F32MethodBox, extra: f32) -> f32 {
    match self {
      F32MethodBox(value) -> value + extra
    }
  }
}

fn f32_roundtrip_property(i: i64) -> bool {
  let value: f32 = (i - 8).to_f64().to_f32_round()
  value.to_f64() == (i - 8).to_f64()
}

test "f32_happy_literals_locals_and_arithmetic_matrix" {
  let sum: f32 = 1.5 + 2.25
  let diff: f32 = 5.0 - 1.25
  let product: f32 = 1.5 * 2.0
  let quotient: f32 = 7.5 / 2.5
  Test.assert_eq(same_f32(sum, 3.75), 1)
  Test.assert_eq(same_f32(diff, 3.75), 1)
  Test.assert_eq(same_f32(product, 3.0), 1)
  Test.assert_eq(same_f32(quotient, 3.0), 1)
}

test "f32_happy_params_returns_and_assignment" {
  let a: f32 = take_f32(1.25)
  let b: f32 = contextual_f32_return()
  let mut c: f32 = add_f32(a, b)
  Test.assert_eq(same_f32(c, 3.25), 1)
  c = 4.5
  Test.assert_eq(same_f32(c, 4.5), 1)
}

test "f32_call_arguments_lower_contextual_literals_in_let_initializers" {
  let first = is_f32_first_arg(1.5)
  let second = is_f32_second_arg(7, 1.5)
  Test.assert_eq(first, 1)
  Test.assert_eq(second, 1)
}

test "f32_happy_comparisons_and_direct_branches" {
  let low: f32 = 1.5
  let high: f32 = 2.5
  Test.assert_eq(if low < high { 1 } else { 0 }, 1)
  Test.assert_eq(if low == 1.5 { 1 } else { 0 }, 1)
  Test.assert_eq(if high != 1.5 { 1 } else { 0 }, 1)
  Test.assert_eq(f32_branch_score(1.5), 10)
  Test.assert_eq(f32_branch_score(2.5), 0)
}

test "f32_adversarial_negative_zero_and_contextual_literals" {
  let neg: f32 = 0.0 - 2.5
  let zero: f32 = 0.0
  Test.assert_eq(same_f32(neg + 2.5, zero), 1)
  Test.assert_eq(same_f32(take_f32(0.0 - 1.25), 0.0 - 1.25), 1)
}

test "f32_precision_is_real_single_precision_not_f64_alias" {
  let rounded_contextual_literal: f32 = 16777217.0
  let rounded_contextual: f32 = 16777216.0 + 1.0
  let rounded_intrinsic = 16777217.0.to_f32_round()
  let default_f64 = 16777217.0
  Test.assert_eq(same_f64(rounded_contextual_literal.to_f64(), 16777216.0), 1)
  Test.assert_eq(same_f64(rounded_contextual.to_f64(), 16777216.0), 1)
  Test.assert_eq(same_f64(rounded_intrinsic.to_f64(), 16777216.0), 1)
  Test.assert_eq(same_f64(default_f64, 16777217.0), 1)
}

test "f32_long_fractional_literal_rounds_after_safe_decimal_lowering" {
  let value: f32 = 0.0000690460016972063023
  Test.assert_eq(near_f64(value.to_f64(), 0.000069046001697, 0.00000000001), 1)
}

test "f32_exponent_subnormal_and_overflow_literals" {
  let thousand: f32 = 1e3
  let tiny: f32 = 1e-45
  let under: f32 = 1e-46
  let over: f32 = 1e39
  Test.assert_eq(same_f64(thousand.to_f64(), 1000.0), 1)
  Test.assert_eq(if tiny.to_f64() > 0.0 { 1 } else { 0 }, 1)
  Test.assert_eq(same_f64(under.to_f64(), 0.0), 1)
  Test.assert_eq(same_f64(over.to_f64(), 1.0 / 0.0), 1)
}

test "f32_conversions_and_method_surface" {
  let value: f32 = 42.5.to_f32_round()
  Test.assert_eq(same_f64(value.to_f64(), 42.5), 1)
  Test.assert_eq(same_f64(value.to_f64(), 42.5), 1)
  Test.assert_eq(same_f32(42.5.to_f32_round(), value), 1)
}

test "f32_method_call_arithmetic_preserves_single_precision_bits" {
  let box = F32MethodBox(1.5)
  Test.assert_eq(same_f32(box.add(2.25), 3.75), 1)
}

test "property_f32_small_integral_roundtrips" {
  Test.forall_i64_range(0, 17, f32_roundtrip_property)
}
