use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}
use stdlib/state as state
use stdlib/state.{State}
use stdlib/test.{Test}

type LabelledValue { label: str, value: i64, valid: bool }

fn label(value: LabelledValue) -> str {
  if value.valid { value.label } else { "missing" }
}

fn checked_value(value: LabelledValue) -> i64 {
  if value.valid { value.value } else { 0 }
}

fn first_column(values: F64Table, row: i64) -> f64 {
  values.get(row, 0).unwrap()
}

test "conditional projections preserve both branches and managed results" {
  let present = LabelledValue { label: "kept", value: 7, valid: true }
  let absent = LabelledValue { label: "hidden", value: 99, valid: false }
  let mut total = 0
  for i in 0..20 {
    total = total + checked_value(present) + checked_value(absent)
    Test.assert_str_eq(label(present), "kept")
    Test.assert_str_eq(label(absent), "missing")
  }
  Test.assert_eq(total, 140)
}

test "checked projections observe intervening writes and retain invalid offsets" {
  let values = table.zeros(3, 1).unwrap()
  let mut sum = 0.0
  for i in 0..20 {
    values.set(1, 0, 2.0)
    sum = sum + first_column(values, 1)
    values.set(1, 0, 5.0)
    sum = sum + first_column(values, 1)
  }
  Test.assert_true(sum == 140.0)
  Test.assert_true(match values.get(0 - 1, 0) { None -> true, Some(_) -> false })
  Test.assert_true(match values.get(3, 0) { None -> true, Some(_) -> false })
  Test.assert_true(match values.get(0, 1) { None -> true, Some(_) -> false })
}

effect Observe { fn seen(value: i64) -> nil }

fn observed_value(value: LabelledValue) -[Observe]> i64 {
  Observe.seen(value.value)
  checked_value(value)
}

fn observed_sequence(value: LabelledValue) -[State<i64>]> i64 {
  handle {
    let mut total = 0
    for i in 0..12 { total = total + observed_value(value) }
    total
  } {
    Observe.seen(next) -> { State.put(State.get() + next) resume(nil) }
  }
}

test "effectful projections preserve every observation" {
  let value = LabelledValue { label: "sample", value: 3, valid: true }
  let (total, observations) = state.run(0, () => observed_sequence(value))
  Test.assert_eq(observations, 36)
  Test.assert_eq(total, 36)
}
