-- Behavioral coverage for fact-selected consuming persistent updates. The
-- optimiser may reuse only a dying version handle; collection semantics stay
-- persistent when an older version remains observable.

use stdlib/map.{*}
use stdlib/vector.{*}
use stdlib/string.{*}

test "consuming updates preserve map and vector results" {
  let mut map = map_new<i64, i64>()
  let mut vec = persistent_vector_new<i64>()
  for i in 0..96 {
    map = map_put<i64, i64>(map, i, i + 1000)
    vec = persistent_vector_push<i64>(vec, i * 3)
  }
  Test.assert_eq(map_get_or<i64, i64>(map, 95, 0 - 1), 1095)
  Test.assert_eq(persistent_vector_get<i64>(vec, 95, 0 - 1), 285)
}

test "shared persistent versions remain independently observable" {
  let original_map = map_put<i64, i64>(map_new<i64, i64>(), 1, 10)
  let updated_map = map_put<i64, i64>(original_map, 1, 20)
  Test.assert_eq(map_get_or<i64, i64>(original_map, 1, 0), 10)
  Test.assert_eq(map_get_or<i64, i64>(updated_map, 1, 0), 20)

  let original_vec = persistent_vector_push<i64>(persistent_vector_new<i64>(), 7)
  let updated_vec = persistent_vector_push<i64>(original_vec, 8)
  Test.assert_eq(persistent_vector_get<i64>(original_vec, 0, 0), 7)
  Test.assert_eq(persistent_vector_get<i64>(updated_vec, 1, 0), 8)
}

test "consuming updates preserve managed children" {
  let mut map = map_new<str, str>()
  let mut vec = persistent_vector_new<str>()
  for i in 0..40 {
    let key = str_concat("key-", int_to_str(i))
    let value = str_concat("value-", int_to_str(i))
    map = map_put<str, str>(map, key, value)
    vec = persistent_vector_push<str>(vec, str_concat("item-", int_to_str(i)))
  }
  Test.assert_str_eq(map_get_or<str, str>(map, "key-39", "missing"), "value-39")
  Test.assert_str_eq(persistent_vector_get<str>(vec, 39, "missing"), "item-39")
}
