-- Behavioral coverage for fact-selected consuming persistent updates. The
-- optimiser may reuse only a dying version handle; collection semantics stay
-- persistent when an older version remains observable.

use stdlib/map as map
use stdlib/map.{*}
use stdlib/option.{Option}
use stdlib/persistent_vector as persistent_vector
use stdlib/string.{*}

test "consuming updates preserve map and vector results" {
  let mut map = map.new<i64, i64>()
  let mut vec = persistent_vector.new<i64>()
  for i in 0..96 {
    map = map.insert(i, i + 1000)
    vec = vec.push(i * 3)
  }
  Test.assert_eq(map.get(95).unwrap_or(0 - 1), 1095)
  Test.assert_eq(vec.get(95).unwrap_or(0 - 1), 285)
}

test "shared persistent versions remain independently observable" {
  let original_map = map.new<i64, i64>().insert(1, 10)
  let updated_map = original_map.insert(1, 20)
  Test.assert_eq(original_map.get(1).unwrap_or(0), 10)
  Test.assert_eq(updated_map.get(1).unwrap_or(0), 20)

  let original_vec = persistent_vector.new<i64>().push(7)
  let updated_vec = original_vec.push(8)
  Test.assert_eq(original_vec.get(0).unwrap_or(0), 7)
  Test.assert_eq(updated_vec.get(1).unwrap_or(0), 8)
}

test "consuming updates preserve managed children" {
  let mut map = map.new<str, str>()
  let mut vec = persistent_vector.new<str>()
  for i in 0..40 {
    let key = str_concat("key-", int_to_str(i))
    let value = str_concat("value-", int_to_str(i))
    map = map.insert(key, value)
    vec = vec.push(str_concat("item-", int_to_str(i)))
  }
  Test.assert_str_eq(map.get("key-39").unwrap_or("missing"), "value-39")
  Test.assert_str_eq(vec.get(39).unwrap_or("missing"), "item-39")
}
