use "runtime/alloc.weft"
use "compiler/lex.weft"

fn bytes_fill(len: i64, byte: i64) -> i64 {
  let p = alloc_bump(len + 1)
  let mut i = 0
  while i < len {
    __mem_store8(p + i, byte)
    i = i + 1
  }
  __mem_store8(p + len, 0)
  p
}

fn escaped_string_source() -> i64 {
  let p = alloc_bump(5)
  __mem_store8(p, 34)
  __mem_store8(p + 1, 97)
  __mem_store8(p + 2, 92)
  __mem_store8(p + 3, 110)
  __mem_store8(p + 4, 34)
  p
}

test "runtime_lex_alloc_empty_source" {
  let toks = lex(__str_ptr(""), 0)
  Test.assert_eq(tok_count(toks), 1)
  Test.assert_eq(tok_tag(toks, 0), 7)
}

test "runtime_lex_alloc_basic_tokens" {
  let toks = lex(__str_ptr("123 abc"), 7)
  Test.assert_eq(tok_count(toks), 3)
  Test.assert_eq(tok_tag(toks, 0), 1)
  Test.assert_eq(tok_v1(toks, 0), 0)
  Test.assert_eq(tok_v2(toks, 0), 3)
  Test.assert_eq(tok_tag(toks, 1), 2)
  Test.assert_eq(tok_v1(toks, 1), 4)
  Test.assert_eq(tok_v2(toks, 1), 3)
  Test.assert_eq(tok_tag(toks, 2), 7)
}

test "runtime_lex_alloc_range_source" {
  let toks = lex_range(__str_ptr("xxx 12 y"), 4, 2)
  Test.assert_eq(tok_count(toks), 2)
  Test.assert_eq(tok_tag(toks, 0), 1)
  Test.assert_eq(tok_v1(toks, 0), 4)
  Test.assert_eq(tok_v2(toks, 0), 2)
  Test.assert_eq(tok_tag(toks, 1), 7)
}

test "runtime_lex_alloc_string_escape_buffer" {
  let src = escaped_string_source()
  let toks = lex(src, 5)
  let str_ptr = src + tok_v1(toks, 0)
  Test.assert_eq(tok_count(toks), 2)
  Test.assert_eq(tok_tag(toks, 0), 8)
  Test.assert_eq(tok_v2(toks, 0), 2)
  Test.assert_eq(__mem_load8(str_ptr), 97)
  Test.assert_eq(__mem_load8(str_ptr + 1), 10)
  Test.assert_eq(tok_tag(toks, 1), 7)
}

test "runtime_lex_alloc_token_buffer_growth" {
  let src = bytes_fill(512, 40)
  let toks = lex(src, 512)
  Test.assert_eq(tok_count(toks), 513)
  Test.assert_eq(tok_tag(toks, 0), 5)
  Test.assert_eq(tok_v1(toks, 0), 1)
  Test.assert_eq(tok_tag(toks, 511), 5)
  Test.assert_eq(tok_v1(toks, 511), 1)
  Test.assert_eq(tok_tag(toks, 512), 7)
}
