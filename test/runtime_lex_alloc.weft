use runtime/memory.{*}
use runtime/alloc.{*}
use compiler/lex.{*}

fn bytes_fill(arena: i64, len: i64, byte: i64) -> i64 {
  let p = arena_alloc(arena, len + 1, 8)
  let mut i = 0
  while i < len {
    mem_store8(p + i, byte)
    i = i + 1
  }
  mem_store8(p + len, 0)
  p
}

fn escaped_string_source(arena: i64) -> i64 {
  let p = arena_alloc(arena, 5, 8)
  mem_store8(p, 34)
  mem_store8(p + 1, 97)
  mem_store8(p + 2, 92)
  mem_store8(p + 3, 110)
  mem_store8(p + 4, 34)
  p
}

test "runtime_lex_alloc_empty_source" {
  let toks = lex(__str_ptr(""), 0)
  Test.assert_eq(tok_count(toks), 1)
  Test.assert_eq(tok_tag(toks, 0), 7)
}

test "runtime_lex_alloc_basic_tokens" {
  let toks = lex(__str_ptr("123 abc"), 7)
  Test.assert_eq(tok_count(toks), 3)
  Test.assert_eq(tok_tag(toks, 0), 1)
  Test.assert_eq(tok_v1(toks, 0), 0)
  Test.assert_eq(tok_v2(toks, 0), 3)
  Test.assert_eq(tok_tag(toks, 1), 2)
  Test.assert_eq(tok_v1(toks, 1), 4)
  Test.assert_eq(tok_v2(toks, 1), 3)
  Test.assert_eq(tok_tag(toks, 2), 7)
}

test "runtime_lex_alloc_range_source" {
  let toks = lex_range(__str_ptr("xxx 12 y"), 4, 2)
  Test.assert_eq(tok_count(toks), 2)
  Test.assert_eq(tok_tag(toks, 0), 1)
  Test.assert_eq(tok_v1(toks, 0), 4)
  Test.assert_eq(tok_v2(toks, 0), 2)
  Test.assert_eq(tok_tag(toks, 1), 7)
}

test "runtime_lex_alloc_string_escape_buffer" {
  let arena = arena_new(64)
  let src = escaped_string_source(arena)
  let toks = lex(src, 5)
  let str_ptr = src + tok_v1(toks, 0)
  Test.assert_eq(tok_count(toks), 2)
  Test.assert_eq(tok_tag(toks, 0), 8)
  Test.assert_eq(tok_v2(toks, 0), 2)
  Test.assert_eq(mem_load8(str_ptr), 97)
  Test.assert_eq(mem_load8(str_ptr + 1), 10)
  Test.assert_eq(tok_tag(toks, 1), 7)
  arena_free(arena)
}

test "runtime_lex_alloc_token_buffer_growth" {
  let arena = arena_new(1024)
  let src = bytes_fill(arena, 512, 40)
  let toks = lex(src, 512)
  Test.assert_eq(tok_count(toks), 513)
  Test.assert_eq(tok_tag(toks, 0), 5)
  Test.assert_eq(tok_v1(toks, 0), 1)
  Test.assert_eq(tok_tag(toks, 511), 5)
  Test.assert_eq(tok_v1(toks, 511), 1)
  Test.assert_eq(tok_tag(toks, 512), 7)
  arena_free(arena)
}

-- ---------------------------------------------------------------------
-- EOF sentinel at batch boundaries.
--
-- lex_batch processes 200 tokens per call and only emits the EOF token
-- when it runs out of SOURCE with budget left. A source whose token
-- count is an exact multiple of 200, ending at its last token, exhausts
-- the budget precisely at end-of-source — and used to yield a token
-- stream with no sentinel. Every EOF-terminated walk (parse_module)
-- then ran off the end of the buffer into adjacent arena memory:
-- silently mis-parsing whatever it found there, or dying with SIGSEGV
-- once it reached an unmapped page.
-- ---------------------------------------------------------------------

fn lex_tok_string(arena: i64, count: i64) -> i64 {
  -- `0 ` repeated: one token per two source bytes, no trailing space so
  -- the source ends exactly at the final token.
  let len = count * 2 - 1
  let p = arena_alloc(arena, len + 1, 8)
  let mut i = 0
  while i < count {
    mem_store8(p + i * 2, 48)
    if i + 1 < count { mem_store8(p + i * 2 + 1, 32) } else { 0 }
    i = i + 1
  }
  mem_store8(p + len, 0)
  p
}

fn lex_last_tag(toks: i64) -> i64 {
  tok_tag(toks, tok_count(toks) - 1)
}

test "runtime_lex_emits_eof_at_exact_batch_boundary" {
  let arena = arena_new(65536)
  -- exactly one full batch
  let src200 = lex_tok_string(arena, 200)
  let toks200 = lex(src200, 200 * 2 - 1)
  Test.assert_eq(tok_count(toks200), 201)
  Test.assert_eq(lex_last_tag(toks200), 7)
  arena_free(arena)
}

test "runtime_lex_emits_eof_at_every_batch_multiple" {
  let arena = arena_new(262144)
  for mult in 1..5 {
    let n = mult * 200
    let src = lex_tok_string(arena, n)
    let toks = lex(src, n * 2 - 1)
    Test.assert_eq(tok_count(toks), n + 1)
    Test.assert_eq(lex_last_tag(toks), 7)
  }
  arena_free(arena)
}

test "runtime_lex_emits_eof_around_the_boundary" {
  -- one under, exact, one over: the sentinel is unconditional
  let arena = arena_new(65536)
  for n in 199..202 {
    let src = lex_tok_string(arena, n)
    let toks = lex(src, n * 2 - 1)
    Test.assert_eq(tok_count(toks), n + 1)
    Test.assert_eq(lex_last_tag(toks), 7)
  }
  arena_free(arena)
}

test "runtime_lex_eof_sentinel_appears_exactly_once" {
  let arena = arena_new(65536)
  let src = lex_tok_string(arena, 200)
  let toks = lex(src, 200 * 2 - 1)
  let mut sentinels = 0
  let mut i = 0
  while i < tok_count(toks) {
    if tok_tag(toks, i) == 7 { sentinels = sentinels + 1 } else { 0 }
    i = i + 1
  }
  Test.assert_eq(sentinels, 1)
  arena_free(arena)
}

test "runtime_lex_range_emits_eof_at_batch_boundary" {
  -- lex_range shares lex_loop, so it inherits the same guarantee.
  let arena = arena_new(65536)
  let src = lex_tok_string(arena, 200)
  let toks = lex_range(src, 0, 200 * 2 - 1)
  Test.assert_eq(tok_count(toks), 201)
  Test.assert_eq(lex_last_tag(toks), 7)
  arena_free(arena)
}

test "runtime_lex_trailing_whitespace_still_ends_in_eof" {
  -- Trailing whitespace pushed the batch past end-of-source and hid the
  -- bug; both shapes must terminate identically.
  let arena = arena_new(65536)
  let padded = bytes_fill(arena, 8, 32)
  let toks = lex(padded, 8)
  Test.assert_eq(tok_count(toks), 1)
  Test.assert_eq(lex_last_tag(toks), 7)
  arena_free(arena)
}
