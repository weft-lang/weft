use compiler/ir/data.{*}
use compiler/weft/facts/reclamation.{reclamation_facts}
use stdlib/list.{List, Cons, Nil}

fn reclamation_function(hash: i64, insts: IrInstList) -> IrFunction {
  IrFunction(hash, 0, IrBlockListCons(IrBlock(0, IrValueNil, insts, IrTermReturn(0)), IrBlockListNil), 0)
}
fn reclamation_call(callee: i64) -> IrInstList {
  IrInstCons(IrCallI64(0, callee, IrValueNil), IrInstNil)
}
fn reclamation_drop() -> IrInstList { IrInstCons(IrOwnedDropI64(0, 42), IrInstNil) }

test "empty and scalar-only graphs have no resource cleanup observations" {
  Test.assert_eq_usize(reclamation_facts(IrFunctionNil).len(), 0)
  let functions = IrFunctionCons(reclamation_function(1, IrInstCons(IrConstI64(0, 42), IrInstNil)), IrFunctionNil)
  Test.assert_eq_usize(reclamation_facts(functions).len(), 0)
}

test "a local drop propagates through callers without marking an unrelated function" {
  let functions = IrFunctionCons(reclamation_function(1, reclamation_call(2)),
    IrFunctionCons(reclamation_function(2, reclamation_call(3)),
      IrFunctionCons(reclamation_function(3, reclamation_drop()),
        IrFunctionCons(reclamation_function(4, IrInstNil), IrFunctionNil))))
  let facts = reclamation_facts(functions)
  Test.assert_eq_usize(facts.len(), 3)
  for hash in [1, 2, 3] { Test.assert_true(facts.contains_key(hash)) }
  Test.assert_false(facts.contains_key(4))
}

test "recursive components converge with and without a cleanup seed" {
  let calls = IrInstCons(IrCallI64(1, 1, IrValueNil), reclamation_call(3))
  let functions = IrFunctionCons(reclamation_function(1, reclamation_call(2)),
    IrFunctionCons(reclamation_function(2, calls), IrFunctionCons(reclamation_function(3, reclamation_drop()), IrFunctionNil)))
  Test.assert_eq_usize(reclamation_facts(functions).len(), 3)
  let pure_cycle = IrFunctionCons(reclamation_function(1, reclamation_call(2)),
    IrFunctionCons(reclamation_function(2, reclamation_call(1)), IrFunctionNil))
  Test.assert_eq_usize(reclamation_facts(pure_cycle).len(), 0)
}

test "duplicate edges and function order do not change cleanup reachability" {
  let twice = IrInstCons(IrCallI64(0, 2, IrValueNil), reclamation_call(2))
  let forward = IrFunctionCons(reclamation_function(1, twice), IrFunctionCons(reclamation_function(2, reclamation_drop()), IrFunctionNil))
  let reverse = IrFunctionCons(reclamation_function(2, reclamation_drop()), IrFunctionCons(reclamation_function(1, twice), IrFunctionNil))
  let left = reclamation_facts(forward)
  let right = reclamation_facts(reverse)
  Test.assert_eq_usize(left.len(), 2)
  Test.assert_eq_usize(right.len(), 2)
  for hash in [1, 2] { Test.assert_true(left.contains_key(hash) and right.contains_key(hash)) }
}

test "structural cleanup distinguishes an actual slot drop from bookkeeping" {
  let dropping = IrInstCons(IrStructuralSlotI64(0, 0, 42, 4), IrInstNil)
  let observing = IrInstCons(IrStructuralSlotI64(0, 0, 42, 1), IrInstNil)
  let functions = IrFunctionCons(reclamation_function(1, dropping), IrFunctionCons(reclamation_function(2, observing), IrFunctionNil))
  let facts = reclamation_facts(functions)
  Test.assert_true(facts.contains_key(1))
  Test.assert_false(facts.contains_key(2))
}

test "merely constructing a closure does not execute the resource-owning body" {
  let body = reclamation_function(2, reclamation_drop())
  let closure = IrInstCons(IrClosureI64(0, body, 0, IrLambdaSemanticFacts(IrLambdaEvidenceNone, 0, ir_borrow_facts_empty())), IrInstNil)
  let functions = IrFunctionCons(reclamation_function(1, closure), IrFunctionCons(body, IrFunctionNil))
  let facts = reclamation_facts(functions)
  Test.assert_false(facts.contains_key(1))
  Test.assert_true(facts.contains_key(2))
}

test "all resource cleanup instructions and unknown dispatches retain observations" {
  for inst in [
    IrOwnedDropI64(0, 42),
    IrStructuralDropI64(0, 42),
    IrStructuralSlotI64(0, 0, 42, 4),
    IrStructuralSplitI64(0, 42, 43, 0),
    IrTryLinearI64(0, 1, 2, 3, 4, 5),
    IrArrayDropI64(0, 1, 1, 1),
    IrIndirectCallI64(0, 1, IrValueNil, UnknownTypeExpr(0)),
    IrMethodCallI64(0, 1, 2, 3, IrValueNil),
    IrLoweringFailureI64(1),
  ] {
    let functions = IrFunctionCons(reclamation_function(1, IrInstCons(inst, IrInstNil)), IrFunctionNil)
    Test.assert_true(reclamation_facts(functions).contains_key(1))
  }
}

test "nested handler cleanup is an observation of the installing function" {
  let blocks = IrBlockListCons(IrBlock(0, IrValueNil, reclamation_drop(), IrTermReturn(0)), IrBlockListNil)
  let clause = IrHandlerClauseBody(1, 0, 0, 0, HandlerClauseAborts, 0, 0, 1, 1, 1, blocks)
  let clauses = IrHandlerClauseBodyCons(clause, IrHandlerClauseBodyNil)
  let inst = IrHandleI64(0, 0, 1, clauses, 1, 0)
  let functions = IrFunctionCons(reclamation_function(1, IrInstCons(inst, IrInstNil)), IrFunctionNil)
  Test.assert_true(reclamation_facts(functions).contains_key(1))
}

test "long dependency chains propagate with a bounded worklist" {
  let mut functions = IrFunctionCons(reclamation_function(1024, reclamation_drop()), IrFunctionNil)
  for hash in 0..1024 {
    functions = IrFunctionCons(reclamation_function(hash, reclamation_call(hash + 1)), functions)
  }
  let facts = reclamation_facts(functions)
  Test.assert_eq_usize(facts.len(), 1025)
  Test.assert_true(facts.contains_key(0))
}
