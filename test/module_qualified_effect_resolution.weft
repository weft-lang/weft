use module_fixtures/g2_effect_bank as bank
use module_fixtures/g2_effect_bank.{ Box }
use module_fixtures/g2_effect_bank_right as right_bank

fn read_remote_box() -[bank.Box<i64>]> i64 {
  bank.Box<i64>.get()
}

fn read_right_box() -[right_bank.Box<i64>]> i64 {
  right_bank.Box<i64>.get()
}

fn read_remote_box_through_selected_signature() -[Box<i64>]> i64 {
  bank.Box<i64>.get()
}

test "qualified effect perform retains declaration identity" {
  let value = handle read_remote_box() {
    bank.Box<i64>.get() -> resume(42)
  }
  Test.assert_eq(value, 42)
}

test "same-spelling qualified effects retain distinct declarations" {
  let left = handle read_remote_box() {
    bank.Box<i64>.get() -> resume(11)
  }
  let right = handle read_right_box() {
    right_bank.Box<i64>.get() -> resume(31)
  }
  Test.assert_eq(left + right, 42)
}

test "selected effect signatures retain qualified-operation compatibility" {
  let value = handle read_remote_box_through_selected_signature() {
    bank.Box<i64>.get() -> resume(42)
  }
  Test.assert_eq(value, 42)
}
