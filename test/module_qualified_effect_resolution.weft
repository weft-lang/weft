use module_fixtures/g2_effect_bank as bank
use module_fixtures/g2_effect_bank.{ Box }

fn read_remote_box() -[Box<i64>]> i64 {
  bank.Box<i64>.get()
}

test "qualified effect perform retains declaration identity" {
  let value = handle read_remote_box() {
    bank.Box<i64>.get() -> resume(42)
  }
  Test.assert_eq(value, 42)
}
