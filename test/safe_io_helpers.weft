use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/io/helpers.{*}
use stdlib/io/types.{*}
use stdlib/num.{*}
use stdlib/option.{None, Some}
use stdlib/result.{*}
use stdlib/vector.{*}

effect HelperRead {
  fn transfer(buffer: [mut u8]) -> Result<IoReadProgress, IoError>
}

effect HelperWrite {
  fn transfer(buffer: [u8]) -> Result<IoWriteProgress, IoError>
}

fn helper_read(buffer: [mut u8]) -[HelperRead]> Result<IoReadProgress, IoError> {
  HelperRead.transfer(buffer)
}

fn helper_write(buffer: [u8]) -[HelperWrite]> Result<IoWriteProgress, IoError> {
  HelperWrite.transfer(buffer)
}

fn counter_new() -> Vector<i64> {
  let counter = vector_new<i64>()
  vector_push<i64>(counter, 0)
  counter
}

fn counter_take(counter: Vector<i64>) -> i64 {
  let value = vector_get_in_bounds<i64>(counter, 0)
  vector_set<i64>(counter, 0, value + 1)
  value
}

fn byte(value: i64) -> u8 {
  num_i64_to_u8_checked(value).unwrap_or(0)
}

fn byte_i64(value: u8) -> i64 {
  num_u64_to_i64_checked(num_u8_to_u64(value)).unwrap_or(0)
}

fn bytes_byte_or(values: Bytes, index: i64, default: i64) -> i64 {
  match values.get(index) {
    Some(value) -> byte_i64(value)
    None -> default
  }
}

fn bytes_result_or(result: Result<Bytes, IoError>) -> Bytes {
  match result {
    Ok(values) -> values
    Err(error) -> bytes.empty()
  }
}

fn error_result_or<T>(result: Result<T, IoError>) -> IoError {
  match result {
    Ok(value) -> IoPlatform(0 - 1)
    Err(error) -> error
  }
}

fn written_or(result: Result<usize, IoError>, default: i64) -> i64 {
  match result {
    Ok(count) -> num_u64_to_i64_checked(num_usize_to_u64(count)).unwrap_or(default)
    Err(error) -> default
  }
}

test "bounded read_all continues after short reads until EOF" {
  let calls = counter_new()
  let result = handle io_read_all_with(8, helper_read) {
    HelperRead.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        buffer[0] = byte(65)
        buffer[1] = byte(66)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(2)))
      } else { if call == 1 {
        buffer[0] = byte(67)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(1)))
      } else {
        resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
      } }
    }
  }
  let values = bytes_result_or(result)
  Test.assert_str_eq(match values.to_utf8() { Ok(text) -> text Err(error) -> "bad" }, "ABC")
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 3)
}

test "bounded read_all retries interruption" {
  let calls = counter_new()
  let result = handle io_read_all_with(4, helper_read) {
    HelperRead.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        resume(Err<IoReadProgress, IoError>(IoInterrupted))
      } else { if call == 1 {
        buffer[0] = byte(88)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(1)))
      } else {
        resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
      } }
    }
  }
  Test.assert_str_eq(match bytes_result_or(result).to_utf8() { Ok(text) -> text Err(error) -> "bad" }, "X")
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 3)
}

test "bounded read_all probes exact limit for EOF" {
  let calls = counter_new()
  let result = handle io_read_all_with(2, helper_read) {
    HelperRead.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        buffer[0] = byte(79)
        buffer[1] = byte(75)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(2)))
      } else {
        resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
      }
    }
  }
  Test.assert_str_eq(match bytes_result_or(result).to_utf8() { Ok(text) -> text Err(error) -> "bad" }, "OK")
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 2)
}

test "bounded read_all rejects the first byte beyond the limit" {
  let result = handle io_read_all_with(2, helper_read) {
    HelperRead.transfer(buffer) -> {
      buffer[0] = byte(1)
      buffer[1] = byte(2)
      buffer[2] = byte(3)
      resume(Ok<IoReadProgress, IoError>(IoReadBytes(3)))
    }
  }
  let error = error_result_or<Bytes>(result)
  Test.assert_eq(io_error_kind(error), 9)
  Test.assert_eq(io_error_count_or(error, 99), 2)
}

test "bounded read_all handles empty EOF without allocation-visible data" {
  let calls = counter_new()
  let result = handle io_read_all_with(0, helper_read) {
    HelperRead.transfer(buffer) -> {
      counter_take(calls)
      resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
    }
  }
  Test.assert_true(bytes_result_or(result).is_empty())
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 1)
}

test "read_exact combines partial reads" {
  let calls = counter_new()
  let result = handle io_read_exact_with(3, helper_read) {
    HelperRead.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        buffer[0] = byte(65)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(1)))
      } else {
        buffer[0] = byte(66)
        buffer[1] = byte(67)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(2)))
      }
    }
  }
  Test.assert_str_eq(match bytes_result_or(result).to_utf8() { Ok(text) -> text Err(error) -> "bad" }, "ABC")
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 2)
}

test "read_exact reports received count on early EOF" {
  let calls = counter_new()
  let result = handle io_read_exact_with(3, helper_read) {
    HelperRead.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        buffer[0] = byte(65)
        buffer[1] = byte(66)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(2)))
      } else {
        resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
      }
    }
  }
  let error = error_result_or<Bytes>(result)
  Test.assert_eq(io_error_kind(error), 10)
  Test.assert_eq(io_error_count_or(error, 99), 2)
}

test "read_exact zero succeeds without invoking transport" {
  let calls = counter_new()
  let result = handle io_read_exact_with(0, helper_read) {
    HelperRead.transfer(buffer) -> {
      counter_take(calls)
      resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
    }
  }
  Test.assert_true(bytes_result_or(result).is_empty())
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 0)
}

test "read helpers reject zero and overreported progress" {
  let zero = handle io_read_exact_with(1, helper_read) {
    HelperRead.transfer(buffer) -> resume(Ok<IoReadProgress, IoError>(IoReadBytes(0)))
  }
  let too_large = handle io_read_exact_with(1, helper_read) {
    HelperRead.transfer(buffer) -> resume(Ok<IoReadProgress, IoError>(IoReadBytes(2)))
  }
  Test.assert_eq(io_error_kind(error_result_or<Bytes>(zero)), 11)
  Test.assert_eq(io_error_kind(error_result_or<Bytes>(too_large)), 11)
}

test "read helpers preserve non-interruption errors" {
  let result = handle io_read_all_with(8, helper_read) {
    HelperRead.transfer(buffer) -> resume(Err<IoReadProgress, IoError>(IoPermissionDenied))
  }
  Test.assert_eq(io_error_kind(error_result_or<Bytes>(result)), 4)
}

test "bounded read_all crosses the internal chunk boundary losslessly" {
  let produced = counter_new()
  let calls = counter_new()
  let result = handle io_read_all_with(5000, helper_read) {
    HelperRead.transfer(buffer) -> {
      counter_take(calls)
      let start = vector_get_in_bounds<i64>(produced, 0)
      let left = 5000 - start
      if left == 0 {
        resume(Ok<IoReadProgress, IoError>(IoEndOfFile))
      } else {
        let n = if left < io_transfer_chunk_size() { left } else { io_transfer_chunk_size() }
        for i in 0..n {
          buffer[num_i64_to_usize_checked(i).unwrap_or(0)] = byte((start + i) % 251)
        }
        vector_set<i64>(produced, 0, start + n)
        resume(Ok<IoReadProgress, IoError>(IoReadBytes(num_i64_to_usize_checked(n).unwrap_or(0))))
      }
    }
  }
  let values = bytes_result_or(result)
  Test.assert_eq(values.len(), 5000)
  Test.assert_eq(bytes_byte_or(values, 0, 999), 0)
  Test.assert_eq(bytes_byte_or(values, 4095, 999), 4095 % 251)
  Test.assert_eq(bytes_byte_or(values, 4999, 999), 4999 % 251)
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 3)
}

test "write_all advances the immutable suffix after partial writes" {
  let calls = counter_new()
  let starts = vector_new<i64>()
  let result = handle io_write_all_with(bytes.from_str("ABCD"), helper_write) {
    HelperWrite.transfer(buffer) -> {
      let call = counter_take(calls)
      vector_push<i64>(starts, byte_i64(buffer[0]))
      resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(if call == 0 { 2 } else { 2 })))
    }
  }
  Test.assert_eq(written_or(result, 0 - 1), 4)
  Test.assert_eq(vector_get_in_bounds<i64>(starts, 0), 65)
  Test.assert_eq(vector_get_in_bounds<i64>(starts, 1), 67)
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 2)
}

test "write_all retries interruption and preserves errors" {
  let calls = counter_new()
  let interrupted = handle io_write_all_with(bytes.from_str("Z"), helper_write) {
    HelperWrite.transfer(buffer) -> {
      let call = counter_take(calls)
      if call == 0 {
        resume(Err<IoWriteProgress, IoError>(IoInterrupted))
      } else {
        resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(1)))
      }
    }
  }
  let denied = handle io_write_all_with(bytes.from_str("Z"), helper_write) {
    HelperWrite.transfer(buffer) -> resume(Err<IoWriteProgress, IoError>(IoPermissionDenied))
  }
  Test.assert_eq(written_or(interrupted, 0 - 1), 1)
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 2)
  Test.assert_eq(io_error_kind(error_result_or<usize>(denied)), 4)
}

test "write_all rejects zero and overreported progress" {
  let zero = handle io_write_all_with(bytes.from_str("Z"), helper_write) {
    HelperWrite.transfer(buffer) -> resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(0)))
  }
  let too_large = handle io_write_all_with(bytes.from_str("Z"), helper_write) {
    HelperWrite.transfer(buffer) -> resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(2)))
  }
  Test.assert_eq(io_error_kind(error_result_or<usize>(zero)), 11)
  Test.assert_eq(io_error_kind(error_result_or<usize>(too_large)), 11)
}

test "write_all empty input succeeds without invoking transport" {
  let calls = counter_new()
  let result = handle io_write_all_with(bytes.empty(), helper_write) {
    HelperWrite.transfer(buffer) -> {
      counter_take(calls)
      resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(1)))
    }
  }
  Test.assert_eq(written_or(result, 0 - 1), 0)
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 0)
}

test "write_all crosses the internal chunk boundary through many partial writes" {
  let source = vector_with_capacity<u8>(5000)
  for i in 0..5000 {
    vector_push<u8>(source, byte(i % 251))
  }
  let calls = counter_new()
  let starts = vector_new<i64>()
  let result = handle io_write_all_with(bytes.from_vector(source), helper_write) {
    HelperWrite.transfer(buffer) -> {
      let call = counter_take(calls)
      vector_push<i64>(starts, byte_i64(buffer[0]))
      resume(Ok<IoWriteProgress, IoError>(IoWroteBytes(1000)))
    }
  }
  Test.assert_eq(written_or(result, 0 - 1), 5000)
  Test.assert_eq(vector_get_in_bounds<i64>(calls, 0), 5)
  Test.assert_eq(vector_get_in_bounds<i64>(starts, 0), 0)
  Test.assert_eq(vector_get_in_bounds<i64>(starts, 4), 4000 % 251)
}
