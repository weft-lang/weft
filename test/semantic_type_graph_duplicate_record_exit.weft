-- Expected exit code: 101

use compiler/project/identity.{anonymous_module_identity_in_package}
use compiler/types/graph.{*}
use stdlib/list as list

fn main() -> i64 {
  let builder = semantic_type_graph_builder(
    semantic_type_segment_id(anonymous_module_identity_in_package(33, 91))
  )
  let (builder, integer) = builder.primitive(SemanticI64)
  let duplicate_names = ["value", "value"]
  let duplicate_types = [integer, integer]
  let (builder, record) = builder.record(
    list.from_slice<str>(duplicate_names[..]),
    list.from_slice<SemanticTypeId>(duplicate_types[..]),
    SemanticClosedRecord
  )
  builder.freeze()
  semantic_type_id_ordinal(record)
  0
}
