-- Declarations the ownership graph must accept: immutable recursion through
-- persistent collections, generic wrappers, variants and opaque wrappers over
-- immutable storage; same-spelled user types that are not the runtime's mutable
-- containers; and a same-named foreign declaration, which is a distinct node.

use module_fixtures/ownership_same_named_node as foreign
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/persistent_vector as persistent_vector
use stdlib/vector as vector
use stdlib/vector/handles.{PersistentVector, Vector}

type MapTree { label: i64, children: Map<i64, MapTree> }

type ListTree { label: i64, children: PersistentVector<ListTree> }

type Holder<T> { value: T }

type HeldNode { label: i64, next: Holder<HeldNode>? }

type Chain<T> { Link(T, Chain<T>), End }

type ChainNode { label: i64, rest: Chain<ChainNode> }

type Frozen<T> = opaque PersistentVector<T>

type FrozenNode { label: i64, kids: Frozen<FrozenNode> }

type SortedMap<K, V> { key: K, value: V }

type SortedNode { label: i64, edge: SortedMap<i64, SortedNode>? }

type Node { label: i64, others: Vector<foreign.Node> }

fn frozen_empty<T>() -> Frozen<T> { Frozen<T>(persistent_vector.new<T>()) }

fn frozen_len<T>(values: Frozen<T>) -> usize {
  match values {
    Frozen(items) -> items.len()
  }
}

test "persistent map trees hold their children immutably" {
  let leaf = MapTree { label: 2, children: map.new<i64, MapTree>() }
  let root = MapTree { label: 1, children: map.new<i64, MapTree>().insert(2, leaf) }
  let child = match root.children.get(2) {
    Some(found) -> found.label
    None -> 0
  }
  Test.assert_eq(root.label + child, 3)
}

test "persistent vector trees hold their children immutably" {
  let leaf = ListTree { label: 5, children: persistent_vector.new<ListTree>() }
  let root = ListTree { label: 1, children: persistent_vector.new<ListTree>().push(leaf) }
  Test.assert_eq_usize(root.children.len(), 1)
}

test "generic records and variants recurse immutably" {
  let tail = HeldNode { label: 2, next: nil }
  let head = HeldNode { label: 1, next: Holder<HeldNode> { value: tail } }
  let later = ChainNode { label: 3, rest: End<ChainNode>() }
  let first = ChainNode { label: 4, rest: Link<ChainNode>(later, End<ChainNode>()) }
  let linked = match first.rest {
    Link(node, rest) -> node.label
    End -> 0
  }
  let next = match head.next {
    nil -> 0
    held: Holder<HeldNode> -> held.value.label
  }
  Test.assert_eq(next + linked, 5)
}

test "opaque wrappers over immutable storage recurse" {
  let node = FrozenNode { label: 6, kids: frozen_empty<FrozenNode>() }
  Test.assert_eq_usize(frozen_len<FrozenNode>(node.kids), 0)
}

test "same-spelled user types are not the runtime containers" {
  let tail = SortedNode { label: 2, edge: nil }
  let head = SortedNode { label: 1, edge: SortedMap<i64, SortedNode> { key: 7, value: tail } }
  let key = match head.edge {
    nil -> 0
    edge: SortedMap<i64, SortedNode> -> edge.key + edge.value.label
  }
  Test.assert_eq(key, 9)
}

test "a same-named foreign declaration is a distinct node" {
  let mut others = vector.new<foreign.Node>()
  others.push(foreign.Node { label: 8 })
  let node = Node { label: 1, others: others }
  let stored = node.others
  Test.assert_eq_usize(stored.len(), 1)
}
