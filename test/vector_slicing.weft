-- Vector slicing is a zero-copy borrow over stable contiguous storage. The
-- owner may be observed through canonical read-only APIs while an immutable
-- view is live, but mutation/reallocation resumes only after the last use.

use stdlib/vector as vector
use stdlib/vector.{*}
use stdlib/num.{*}

type VectorSliceBox { value: i64 }

fn vector_slice_i64_values() -> Vector<i64> {
  let values = vector.with_capacity<i64>(4)
  vector_push<i64>(values, 10)
  vector_push<i64>(values, 20)
  vector_push<i64>(values, 5)
  vector_push<i64>(values, 7)
  values
}

fn vector_slice_middle<T>(values: Vector<T>) -> [T] {
  values[1..3]
}

test "vector_slice_forms_cover_full_prefix_suffix_and_middle" {
  let values = vector_slice_i64_values()
  let full: [i64] = values[..]
  let prefix: [i64] = values[..2]
  let suffix: [i64] = values[2..]
  let middle: [i64] = values[1..3]
  Test.assert_eq(if full.len == 4 { 1 } else { 0 }, 1)
  Test.assert_eq(prefix[0] + prefix[1], 30)
  Test.assert_eq(suffix[0] + suffix[1], 12)
  Test.assert_eq(middle[0] + middle[1], 25)
}

test "vector_slice_generic_result_maps_to_owner_argument" {
  let values = vector_slice_i64_values()
  let middle = vector_slice_middle<i64>(values)
  Test.assert_eq(middle[0] + middle[1], 25)
}

test "vector_immutable_slice_allows_canonical_read_only_access" {
  let values = vector_slice_i64_values()
  let view: [i64] = values[..]
  let observed_len = vector_len<i64>(values)
  let observed_last = vector_get_in_bounds<i64>(values, 3)
  Test.assert_eq(view[0] + observed_len + observed_last, 21)
}

test "vector_mutable_slice_is_zero_copy" {
  let values = vector_slice_i64_values()
  let writable: [mut i64] = values[1..3]
  writable[0] = 42
  writable[1] = 9
  let changed = writable[0] + writable[1]
  Test.assert_eq(changed, 51)
  Test.assert_eq(vector_get_in_bounds<i64>(values, 1) + vector_get_in_bounds<i64>(values, 2), 51)
}

test "vector_mutation_resumes_after_last_slice_use" {
  let values = vector_slice_i64_values()
  let view: [i64] = values[..]
  let first = view[0]
  Test.assert_true(vector_push<i64>(values, 32))
  Test.assert_eq(first + vector_get_in_bounds<i64>(values, 4), 42)
}

test "unrelated_vector_can_mutate_while_slice_is_live" {
  let left = vector.new<i64>()
  vector_push<i64>(left, 10)
  let right = vector.new<i64>()
  let view: [i64] = left[..]
  Test.assert_true(vector_push<i64>(right, 32))
  Test.assert_eq(view[0] + vector_get_in_bounds<i64>(right, 0), 42)
}

test "vector_slice_preserves_exact_float_width" {
  let values = vector.new<f32>()
  vector_push<f32>(values, 1.5)
  vector_push<f32>(values, 2.5)
  let view: [f32] = values[..]
  Test.assert_eq_f64(num_f32_to_f64(view[0]) + num_f32_to_f64(view[1]), 4.0)
}

test "vector_slice_loads_managed_elements_by_value" {
  let values = vector.new<VectorSliceBox>()
  vector_push<VectorSliceBox>(values, VectorSliceBox { value: 20 })
  vector_push<VectorSliceBox>(values, VectorSliceBox { value: 22 })
  let view: [VectorSliceBox] = values[..]
  Test.assert_eq(view[0].value + view[1].value, 42)
}

test "array_and_vector_slices_share_plain_record_layout" {
  let mut array_values: [VectorSliceBox; 2] = [VectorSliceBox { value: 11 }, VectorSliceBox { value: 20 }]
  let array_view: [mut VectorSliceBox] = array_values[..]
  array_view[0] = VectorSliceBox { value: 22 }

  let vector_values = vector.new<VectorSliceBox>()
  vector_push<VectorSliceBox>(vector_values, VectorSliceBox { value: array_view[0].value })
  vector_push<VectorSliceBox>(vector_values, VectorSliceBox { value: array_view[1].value })
  let vector_view: [VectorSliceBox] = vector_values[..]
  Test.assert_eq(vector_view[0].value + vector_view[1].value, 42)
  Test.assert_eq(array_values[0].value, 22)
}
