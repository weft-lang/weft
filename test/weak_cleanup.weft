use runtime/rc_implicit_test.{*}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}

effect WeakCleanupAbort {
  fn stop(value: i64) -> i64
}

fn weak_cleanup_inferred(probe: RuntimeRcProbe) -> i64 {
  let reference = weak_ref(probe)
  0
}

fn weak_cleanup_annotated(probe: RuntimeRcProbe) -> i64 {
  let reference: weak RuntimeRcProbe = weak_ref(probe)
  0
}

fn weak_cleanup_matched(reference: weak RuntimeRcProbe) -> i64 {
  match weak_load(reference) {
    nil -> 0
    live: RuntimeRcProbe -> runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_named(reference: weak RuntimeRcProbe) -> i64 {
  let loaded = weak_load(reference)
  match loaded {
    nil -> 0
    live: RuntimeRcProbe -> runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_named_annotated(reference: weak RuntimeRcProbe) -> i64 {
  let loaded: RuntimeRcProbe | nil = weak_load(reference)
  match loaded {
    nil -> 0
    live: RuntimeRcProbe -> runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_return(probe: RuntimeRcProbe, leave: bool) -> i64 {
  let reference = weak_ref(probe)
  if leave { return 42 } else { 0 }
  weak_cleanup_matched(reference)
}

fn weak_cleanup_match_return(reference: weak RuntimeRcProbe) -> i64 {
  match weak_load(reference) {
    nil -> return 0
    live: RuntimeRcProbe -> return runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_abort(probe: RuntimeRcProbe) -[WeakCleanupAbort]> i64 {
  let reference = weak_ref(probe)
  match weak_load(reference) {
    nil -> WeakCleanupAbort.stop(0)
    live: RuntimeRcProbe -> WeakCleanupAbort.stop(runtime_rc_probe_load(live))
  }
}

fn weak_cleanup_transfer(reference: weak RuntimeRcProbe) -> RuntimeRcProbe | nil {
  let loaded = weak_load(reference)
  loaded
}

fn weak_cleanup_match_transfer(reference: weak RuntimeRcProbe) -> RuntimeRcProbe | nil {
  match weak_load(reference) {
    nil -> return nil
    live: RuntimeRcProbe -> live
  }
}

fn weak_cleanup_dead() -> weak RuntimeRcProbe {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(probe)
  reference
}

fn weak_cleanup_churn() -> i64 {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(probe)
  weak_cleanup_matched(reference)
}

fn weak_cleanup_generic<T>(reference: weak PersistentVector<T>) -> PersistentVector<T> | nil {
  let loaded = weak_load(reference)
  loaded
}

fn weak_cleanup_discard(probe: RuntimeRcProbe) -> i64 {
  weak_cleanup_reader(probe)
  weak_ref(probe)
  let reference = weak_ref(probe)
  weak_load(reference)
  0
}

fn weak_cleanup_nested(probe: RuntimeRcProbe) -> i64 {
  match weak_load(weak_ref(probe)) {
    nil -> 0
    live: RuntimeRcProbe -> runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_conditional_operand(probe: RuntimeRcProbe, flag: bool) -> i64 {
  match weak_load(if flag { weak_ref(probe) } else { weak_ref(probe) }) {
    nil -> 0
    live: RuntimeRcProbe -> runtime_rc_probe_load(live)
  }
}

fn weak_cleanup_reader(probe: RuntimeRcProbe) -> () -> i64 {
  () => runtime_rc_probe_load(probe)
}

test "inferred weak bindings release their stake" {
  let probe = runtime_rc_probe_new(42)
  weak_cleanup_inferred(probe)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "annotated weak bindings release their stake" {
  let probe = runtime_rc_probe_new(42)
  weak_cleanup_annotated(probe)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "matching a weak load releases the acquired strong stake" {
  let probe = runtime_rc_probe_new(42)
  let reference: weak RuntimeRcProbe = weak_ref(probe)
  Test.assert_eq(weak_cleanup_matched(reference), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "inferred weak load bindings release their strong stake" {
  let probe = runtime_rc_probe_new(42)
  let reference: weak RuntimeRcProbe = weak_ref(probe)
  Test.assert_eq(weak_cleanup_named(reference), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "annotated weak load bindings release their strong stake" {
  let probe = runtime_rc_probe_new(42)
  let reference: weak RuntimeRcProbe = weak_ref(probe)
  Test.assert_eq(weak_cleanup_named_annotated(reference), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "weak bindings clean up on early return and fallthrough" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(weak_cleanup_return(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
  Test.assert_eq(weak_cleanup_return(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "weak load match cleanup covers explicit return" {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(probe)
  Test.assert_eq(weak_cleanup_match_return(reference), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 1)
}

test "aborting a match releases weak and loaded strong stakes" {
  let probe = runtime_rc_probe_new(42)
  let result = handle weak_cleanup_abort(probe) {
    WeakCleanupAbort.stop(value) -> value
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "resuming a match releases weak and loaded strong stakes" {
  let probe = runtime_rc_probe_new(42)
  let result = handle weak_cleanup_abort(probe) {
    WeakCleanupAbort.stop(value) -> resume(value)
  }
  Test.assert_eq(result, 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "weak load transfers exactly one strong stake" {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(probe)
  let during = {
    let loaded = weak_cleanup_transfer(reference)
    Test.assert_true(loaded == probe)
    runtime_rc_probe_count(probe)
  }
  Test.assert_eq(during, 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "returning a loaded match binder preserves its strong stake" {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(probe)
  let during = {
    let loaded = weak_cleanup_match_transfer(reference)
    Test.assert_true(loaded == probe)
    runtime_rc_probe_count(probe)
  }
  Test.assert_eq(during, 2)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "expired weak loads take nil arms and remain transferable" {
  let reference = weak_cleanup_dead()
  Test.assert_eq(weak_cleanup_matched(reference), 0)
  Test.assert_eq(weak_cleanup_match_return(reference), 0)
  Test.assert_true(weak_cleanup_transfer(reference) == nil)
  Test.assert_true(weak_cleanup_match_transfer(reference) == nil)
}

test "weak creation and matched loading are heap flat after warmup" {
  for i in 0..8 { weak_cleanup_churn() }
  let before = runtime_rc_test_heap_arena_offset()
  let mut total = 0
  for i in 0..1000 { total = total + weak_cleanup_churn() }
  let after = runtime_rc_test_heap_arena_offset()
  Test.assert_eq(total, 42000)
  Test.assert_eq(after, before)
}

test "generic weak loads preserve their instantiated managed type" {
  let values = persistent_vector.new<i64>().push(42)
  let reference = weak_ref(values)
  match weak_cleanup_generic<i64>(reference) {
    nil -> Test.assert_true(false)
    loaded: PersistentVector<i64> -> Test.assert_eq_usize(loaded.len(), 1)
  }
}

test "discarded weak expressions release their acquired stakes" {
  let probe = runtime_rc_probe_new(42)
  weak_cleanup_discard(probe)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "temporary weak operands release after loading" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(weak_cleanup_nested(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
}

test "weak operand cleanup covers control flow merges" {
  let probe = runtime_rc_probe_new(42)
  Test.assert_eq(weak_cleanup_conditional_operand(probe, true), 42)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
  Test.assert_eq(weak_cleanup_conditional_operand(probe, false), 42)
  Test.assert_eq(runtime_rc_probe_weak_count(probe), 0)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "weak creation releases its temporary strong owner" {
  let reference = weak_ref(runtime_rc_probe_new(42))
  Test.assert_true(weak_load(reference) == nil)
}

test "temporary closure weak creation releases captured owners" {
  let probe = runtime_rc_probe_new(42)
  let reference = weak_ref(weak_cleanup_reader(probe))
  Test.assert_true(weak_load(reference) == nil)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}
