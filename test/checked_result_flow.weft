use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option, Some, None}
use stdlib/fail.{Fail}
use runtime/defer_order_test.{OwnedAbortToken, defer_order_log_new, defer_order_log_read, owned_abort_token_new}

fn checked_pair(values: F64Table, row: i64) -> Option<f64> {
  match values.get(row, 0) {
    Some(first) -> match values.get(row, 1) {
      Some(second) -> Some(first * 10.0 + second)
      None -> None<f64>()
    }
    None -> None<f64>()
  }
}

test "successive checked results preserve both failure positions" {
  let values = table.zeros(2, 2).unwrap()
  values.set(0, 0, 3.0)
  values.set(0, 1, 7.0)
  values.set(1, 0, 5.0)
  values.set(1, 1, 9.0)
  Test.assert_true(checked_pair(values, 0).unwrap() == 37.0)
  Test.assert_true(checked_pair(values, 1).unwrap() == 59.0)
  for row in [0 - 1, 2, 9223372036854775807] {
    Test.assert_true(match checked_pair(values, row) { None -> true, Some(_) -> false })
  }
  let narrow = table.zeros(2, 1).unwrap()
  Test.assert_true(match checked_pair(narrow, 0) { None -> true, Some(_) -> false })
}

test "loop reads observe every intervening point update" {
  let values = table.zeros(1, 2).unwrap()
  let mut expected = 0.0
  let mut observed = 0.0
  for index in 0..20 {
    values.set(0, 0, 2.0)
    values.set(0, 1, 3.0)
    observed = observed + checked_pair(values, 0).unwrap()
    values.set(0, 1, 8.0)
    observed = observed + checked_pair(values, 0).unwrap()
    expected = expected + 51.0
  }
  Test.assert_true(observed == expected)
}

effect ChangeColumn { fn between_reads() -> nil }

fn checked_pair_with_effect(values: F64Table) -[ChangeColumn]> f64 {
  match values.get(0, 0) {
    Some(first) -> {
      ChangeColumn.between_reads()
      match values.get(0, 1) { Some(second) -> first * 10.0 + second, None -> 0.0 }
    }
    None -> 0.0
  }
}

test "an effect between successful reads preserves the new observation" {
  let values = table.zeros(1, 2).unwrap()
  values.set(0, 0, 4.0)
  values.set(0, 1, 2.0)
  let answer = handle checked_pair_with_effect(values) {
    ChangeColumn.between_reads() -> { values.set(0, 1, 9.0) resume(nil) }
  }
  Test.assert_true(answer == 49.0)
}

fn checked_resource_scope(log: i64, present: bool, abort: bool) -[Fail<i64>]> i64 {
  let outer = owned_abort_token_new(log, 1)
  let selected = if present { Some<owned OwnedAbortToken>(owned_abort_token_new(log, 2)) }
    else { None<owned OwnedAbortToken>() }
  match selected {
    Some(inner) -> {
      let last = owned_abort_token_new(log, 3)
      if abort { Fail<i64>.fail(17) } else { 7 }
    }
    None -> 9
  }
}

test "checked resource payloads preserve exact normal and abort cleanup" {
  for present in [false, true] {
    for abort in [false, true] {
      let log = defer_order_log_new()
      let answer = handle checked_resource_scope(log, present, abort) {
        Fail<i64>.fail(error) -> error
      }
      let expected = if not present { 9 } else { if abort { 17 } else { 7 } }
      Test.assert_eq(answer, expected)
      Test.assert_eq(defer_order_log_read(log), if present { 321 } else { 1 })
    }
  }
}
