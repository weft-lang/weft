use runtime/rc.{rc_count}
use runtime/rc_implicit_test.{RuntimeRcProbe, runtime_rc_probe_new, runtime_rc_probe_weak_count}
use runtime/defer_order_test.{defer_order_log_new, defer_order_log_read, defer_order_log_write}
use stdlib/drop.{Drop}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option}

effect ResultPause { @deferred fn pause() -> nil }

fn observe(value: str) -[ResultPause]> str { value }

fn observe_number(value: i64) -[ResultPause]> i64 { value }

fn copy_values<T, E>(values: List<T>, transform: (T) -[E]> T) -[E]> List<T> {
  let mut remaining = values
  let mut result = Nil<T>()
  loop {
    match remaining {
      Nil -> break
        Cons(value, rest) -> { result = Cons(transform(value), result); remaining = rest }
    }
  }
  result
}

fn retained_list(name: str) -[ResultPause]> List<str> {
  let input = Cons(name, Cons(name, Nil<str>()))
  let result = copy_values(input, observe)
  ResultPause.pause()
  result
}

fn discard_list(name: str) -> nil {
  handle retained_list(name) { ResultPause.pause() with k -> Nil<str>() }
  nil
}

fn abort_list(name: str) -> nil {
  handle retained_list(name) { ResultPause.pause() -> Nil<str>() }
  nil
}

fn resume_list(name: str) -> usize {
  let values = handle retained_list(name) { ResultPause.pause() with k -> k(nil) }
  values.first().unwrap().len() + values.get(1).unwrap().len()
}

test "callback-specialized list results are released when a later continuation is dropped" {
  let name = "owned".concat(".weft")
  for _ in 0..32 { discard_list(name); Test.assert_eq(rc_count(__str_ptr(name) - 16), 1) }
}

test "callback-specialized list results are released on a later abort" {
  let name = "owned".concat(".weft")
  for _ in 0..32 { abort_list(name); Test.assert_eq(rc_count(__str_ptr(name) - 16), 1) }
}

test "resuming a specialized result preserves its values and releases its stakes" {
  let name = "owned".concat(".weft")
  for _ in 0..32 {
    Test.assert_eq_usize(resume_list(name), 20)
    Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
  }
}

fn string_factory<E>(name: str, transform: (str) -[E]> str) -[E]> str { transform(name) }

fn reader_factory<E>(name: str, transform: (str) -[E]> str) -[E]> () -> str {
  let value = transform(name)
  () => value
}

fn tuple_factory<E>(name: str, transform: (str) -[E]> str) -[E]> (str, str, i64) {
  (transform(name), transform(name), 42)
}

fn array_factory<E>(name: str, transform: (str) -[E]> str) -[E]> [str; 2] {
  [transform(name), transform(name)]
}

type ResultRecord { first: str, reader: () -> str }

fn record_factory<E>(name: str, transform: (str) -[E]> str) -[E]> ResultRecord {
  let value = transform(name)
  ResultRecord { first: value, reader: () => value }
}

fn retained_string(name: str) -[ResultPause]> str {
  let value = string_factory(name, observe)
  ResultPause.pause()
  value
}

fn retained_reader(name: str) -[ResultPause]> () -> str {
  let value = reader_factory(name, observe)
  ResultPause.pause()
  value
}

fn retained_tuple(name: str) -[ResultPause]> (str, str, i64) {
  let value = tuple_factory(name, observe)
  ResultPause.pause()
  value
}

fn retained_array(name: str) -[ResultPause]> [str; 2] {
  let value = array_factory(name, observe)
  ResultPause.pause()
  value
}

fn retained_record(name: str) -[ResultPause]> ResultRecord {
  let value = record_factory(name, observe)
  ResultPause.pause()
  value
}

fn discard_string(name: str) -> nil {
  handle retained_string(name) { ResultPause.pause() with k -> "fallback" }
  nil
}

test "specialized string results release every returned stake" {
  let name = "owned".concat(".weft")
  discard_string(name)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn discard_reader(name: str) -> nil {
  handle retained_reader(name) { ResultPause.pause() with k -> () => "fallback" }
  nil
}

test "specialized reader results release every returned stake" {
  let name = "owned".concat(".weft")
  discard_reader(name)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn discard_tuple(name: str) -> nil {
  handle retained_tuple(name) { ResultPause.pause() with k -> ("left", "right", 0) }
  nil
}

test "specialized tuple results release every returned stake" {
  let name = "owned".concat(".weft")
  discard_tuple(name)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn discard_array(name: str) -> nil {
  handle retained_array(name) { ResultPause.pause() with k -> ["left", "right"] }
  nil
}

test "specialized array results release every returned stake" {
  let name = "owned".concat(".weft")
  discard_array(name)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn discard_record(name: str) -> nil {
  handle retained_record(name) { ResultPause.pause() with k -> ResultRecord { first: "fallback", reader: () => "fallback" } }
  nil
}

test "specialized record results release every returned stake" {
  let name = "owned".concat(".weft")
  discard_record(name)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn resumed_other_results(name: str) -> bool {
  let text = handle retained_string(name) { ResultPause.pause() with k -> k(nil) }
  let reader = handle retained_reader(name) { ResultPause.pause() with k -> k(nil) }
  let tuple = handle retained_tuple(name) { ResultPause.pause() with k -> k(nil) }
  let array = handle retained_array(name) { ResultPause.pause() with k -> k(nil) }
  let record = handle retained_record(name) { ResultPause.pause() with k -> k(nil) }
  text == name and reader() == name and tuple.0 == name and tuple.1 == name and tuple.2 == 42 and
    array[0] == name and array[1] == name and record.first == name and (record.reader)() == name
}

test "resumed specialized products preserve closure captures and every physical result lane" {
  let name = "owned".concat(".weft")
  for _ in 0..32 {
    Test.assert_true(resumed_other_results(name))
    Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
  }
}

fn weak_factory<E>(value: RuntimeRcProbe, transform: (i64) -[E]> i64) -[E]> weak RuntimeRcProbe {
  transform(42)
  weak_ref(value)
}

fn retained_weak(value: RuntimeRcProbe) -[ResultPause]> weak RuntimeRcProbe {
  let reference = weak_factory(value, observe_number)
  ResultPause.pause()
  reference
}

fn discard_weak(value: RuntimeRcProbe) -> nil {
  handle { let reference = retained_weak(value); nil } { ResultPause.pause() with k -> nil }
  nil
}

test "specialized weak results release the weak stake without releasing their live referent" {
  let value = runtime_rc_probe_new(42)
  for _ in 0..32 { discard_weak(value); Test.assert_eq(runtime_rc_probe_weak_count(value), 0) }
}

type ResultToken = opaque(i64, i64)

impl Drop for ResultToken {
  fn drop(self) -> nil {
    match self { ResultToken((log, digit)) -> { defer_order_log_write(log, defer_order_log_read(log) * 10 + digit); nil } }
  }
}

fn token_factory<E>(log: i64, transform: (i64) -[E]> i64) -[E]> owned ResultToken {
  ResultToken((log, transform(1)))
}

fn tokens_factory<E>(log: i64, transform: (i64) -[E]> i64) -[E]> (owned ResultToken, owned ResultToken) {
  (ResultToken((log, transform(1))), ResultToken((log, transform(2))))
}

fn retained_token(log: i64) -[ResultPause]> owned ResultToken {
  let token = token_factory(log, observe_number)
  ResultPause.pause()
  token
}

fn retained_tokens(log: i64) -[ResultPause]> (owned ResultToken, owned ResultToken) {
  let tokens = tokens_factory(log, observe_number)
  ResultPause.pause()
  tokens
}

fn discard_token(log: i64) -> nil {
  handle { let token = retained_token(log); nil } { ResultPause.pause() with k -> nil }
  nil
}

fn discard_tokens(log: i64) -> nil {
  handle { let tokens = retained_tokens(log); nil } { ResultPause.pause() with k -> nil }
  nil
}

test "specialized owned results run Drop exactly once on abandonment" {
  let log = defer_order_log_new()
  discard_token(log)
  Test.assert_eq(defer_order_log_read(log), 1)
}

test "specialized structural resource results preserve reverse field Drop order" {
  let log = defer_order_log_new()
  discard_tokens(log)
  Test.assert_eq(defer_order_log_read(log), 21)
}

trait ResultMaker {
  type Product
  fn make(self) -> Self.Product
}

type NameMaker { name: str }

impl ResultMaker for NameMaker {
  type Product = List<str>
    fn make(self) -> List<str> { Cons(self.name, Nil<str>()) }
}

fn associated_factory<M: ResultMaker, E>(maker: M, transform: (i64) -[E]> i64) -[E]> M.Product {
  transform(42)
  maker.make()
}

fn retained_associated(name: str) -[ResultPause]> List<str> {
  let result = associated_factory(NameMaker { name: name }, observe_number)
  ResultPause.pause()
  result
}

fn discard_associated(name: str) -> nil {
  handle retained_associated(name) { ResultPause.pause() with k -> Nil<str>() }
  nil
}

test "specialized associated results retain their concrete ownership contract" {
  let name = "owned".concat(".weft")
  for _ in 0..32 { discard_associated(name); Test.assert_eq(rc_count(__str_ptr(name) - 16), 1) }
}

fn resume_associated(name: str) -> usize {
  let result = handle retained_associated(name) { ResultPause.pause() with k -> k(nil) }
  result.first().unwrap().len()
}

test "resumed associated products preserve and release their concrete values" {
  let name = "owned".concat(".weft")
  Test.assert_eq_usize(resume_associated(name), 10)
  Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
}

fn suspend_observe(value: str) -[ResultPause]> str {
  ResultPause.pause()
  value
}

fn discard_during_factory(name: str) -> nil {
  handle tuple_factory(name, suspend_observe) { ResultPause.pause() with k -> ("left", "right", 0) }
  nil
}

test "abandoning a specialized call before return releases argument transports exactly once" {
  let name = "owned".concat(".weft")
  for _ in 0..32 { discard_during_factory(name); Test.assert_eq(rc_count(__str_ptr(name) - 16), 1) }
}

fn retained_branch_tuple(name: str, choose: bool) -[ResultPause]> (str, str, i64) {
  let value = tuple_factory(if choose { name } else { name }, observe)
  ResultPause.pause()
  value
}

fn discard_branch_tuple(name: str, choose: bool) -> nil {
  handle retained_branch_tuple(name, choose) { ResultPause.pause() with k -> ("left", "right", 0) }
  nil
}

test "branching generic arguments preserve their transfers on either control-flow path" {
  let name = "owned".concat(".weft")
  for choose in [true, false] {
    discard_branch_tuple(name, choose)
    Test.assert_eq(rc_count(__str_ptr(name) - 16), 1)
  }
}
