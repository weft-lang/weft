fn bool_to_i64(b: bool) -> i64 {
  if b { 1 } else { 0 }
}

test "operator_comparison_matrix" {
  let a = bool_to_i64(5 == 5)
  let b = bool_to_i64(5 != 6) * 2
  let c = bool_to_i64(3 < 5) * 4
  let d = bool_to_i64(5 > 3) * 8
  let e = bool_to_i64(5 <= 5) * 16
  let f = bool_to_i64(5 >= 5) * 32
  Test.assert_eq(a + b + c + d + e + f, 63)
}

test "operator_bitwise_matrix" {
  Test.assert_eq((6 band 3) + (4 bor 1) + (7 bxor 3) + (1 bshl 3) + (8 bshr 1), 23)
}

test "operator_bool_equality" {
  Test.assert_eq(bool_to_i64(true == true) + bool_to_i64(true != false), 2)
}
