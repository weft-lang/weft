use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}
use stdlib/unicode.{*}

test "unicode_normalization_pins_unicode_17" {
  Test.assert_str_eq(unicode_version(), "17.0.0")
}

test "unicode_normalization_preserves_empty_and_ascii_text" {
  Test.assert_str_eq(unicode_normalize_nfc(""), "")
  Test.assert_str_eq(unicode_normalize_nfd("weft_17"), "weft_17")
  Test.assert_str_eq(unicode_normalize_nfkc("Hello, world!"), "Hello, world!")
  Test.assert_str_eq(unicode_normalize_nfkd("123"), "123")
}

test "unicode_nfc_and_nfd_transform_canonical_equivalents" {
  Test.assert_str_eq(unicode_normalize_nfc("café"), "café")
  Test.assert_str_eq(unicode_normalize_nfd("café"), "café")
  Test.assert_str_eq(unicode_normalize_nfc("Å"), "Å")
  Test.assert_str_eq(unicode_normalize_nfd("Å"), "Å")
}

test "unicode_normalization_orders_combining_marks_stably" {
  Test.assert_str_eq(unicode_normalize_nfd("q̣̇"), "q̣̇")
  -- Equal combining classes retain their source order.
  Test.assert_str_eq(unicode_normalize_nfd("q́̀"), "q́̀")
}

test "unicode_normalization_honours_composition_exclusions" {
  -- U+0344 decomposes to diaeresis + acute and is excluded from recomposition.
  Test.assert_str_eq(unicode_normalize_nfc("̈́"), "̈́")
}

test "unicode_normalization_handles_algorithmic_hangul" {
  Test.assert_str_eq(unicode_normalize_nfc("각"), "각")
  Test.assert_str_eq(unicode_normalize_nfd("각"), "각")
}

test "unicode_compatibility_forms_expand_ligatures_and_width" {
  Test.assert_str_eq(unicode_normalize_nfc("ﬁ"), "ﬁ")
  Test.assert_str_eq(unicode_normalize_nfkc("ﬁ①Ｗｅｆｔ"), "fi1Weft")
  Test.assert_str_eq(unicode_normalize_nfkd("ﬁ①"), "fi1")
}

test "unicode_compatibility_forms_cover_supplementary_mappings" {
  -- MATHEMATICAL BOLD CAPITAL A is outside the BMP but compatibility-folds.
  Test.assert_str_eq(unicode_normalize_nfkc("𝐀"), "A")
  Test.assert_str_eq(unicode_normalize_nfc("🧵"), "🧵")
}

test "unicode_compatibility_handles_maximal_decomposition_expansion" {
  -- U+FDFA expands to 18 scalars, the Unicode 17 maximum. This pins the
  -- scratch-capacity bound as well as recursive compatibility lookup.
  Test.assert_str_eq(unicode_normalize_nfkd("ﷺ"), "صلى الله عليه وسلم")
}

test "unicode_is_normalized_distinguishes_all_four_forms" {
  Test.assert_eq(unicode_is_normalized_nfc("café"), 1)
  Test.assert_eq(unicode_is_normalized_nfc("café"), 0)
  Test.assert_eq(unicode_is_normalized_nfd("café"), 1)
  Test.assert_eq(unicode_is_normalized_nfd("café"), 0)
  Test.assert_eq(unicode_is_normalized_nfkc("ﬁ"), 0)
  Test.assert_eq(unicode_is_normalized_nfkc("fi"), 1)
  Test.assert_eq(unicode_is_normalized_nfkd("Å"), 0)
  Test.assert_eq(unicode_is_normalized_nfkd("Å"), 1)
}

test "unicode_normalization_is_idempotent" {
  let text = "Ḍ̇ ﬁ 가 𝐀"
  let nfc = unicode_normalize_nfc(text)
  let nfd = unicode_normalize_nfd(text)
  let nfkc = unicode_normalize_nfkc(text)
  let nfkd = unicode_normalize_nfkd(text)
  Test.assert_str_eq(unicode_normalize_nfc(nfc), nfc)
  Test.assert_str_eq(unicode_normalize_nfd(nfd), nfd)
  Test.assert_str_eq(unicode_normalize_nfkc(nfkc), nfkc)
  Test.assert_str_eq(unicode_normalize_nfkd(nfkd), nfkd)
}

test "unicode_normalization_rejects_forged_malformed_utf8" {
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_str_eq(unicode_normalize_nfc(text), "")
  Test.assert_eq(unicode_is_normalized_nfc(text), 0)
}
