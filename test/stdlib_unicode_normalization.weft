use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}
use stdlib/unicode as unicode

test "unicode_normalization_pins_unicode_17" {
  Test.assert_str_eq(unicode.version(), "17.0.0")
}

test "unicode_normalization_preserves_empty_and_ascii_text" {
  Test.assert_str_eq("".normalize_nfc(), "")
  Test.assert_str_eq("weft_17".normalize_nfd(), "weft_17")
  Test.assert_str_eq("Hello, world!".normalize_nfkc(), "Hello, world!")
  Test.assert_str_eq("123".normalize_nfkd(), "123")
  Test.assert_true("weft_17".is_ascii())
  Test.assert_false("λ".is_ascii())
}

test "unicode_nfc_and_nfd_transform_canonical_equivalents" {
  Test.assert_str_eq("café".normalize_nfc(), "café")
  Test.assert_str_eq("café".normalize_nfd(), "café")
  Test.assert_str_eq("Å".normalize_nfc(), "Å")
  Test.assert_str_eq("Å".normalize_nfd(), "Å")
}

test "unicode_normalization_orders_combining_marks_stably" {
  Test.assert_str_eq("q̣̇".normalize_nfd(), "q̣̇")
  -- Equal combining classes retain their source order.
  Test.assert_str_eq("q́̀".normalize_nfd(), "q́̀")
}

test "unicode_normalization_honours_composition_exclusions" {
  -- U+0344 decomposes to diaeresis + acute and is excluded from recomposition.
  Test.assert_str_eq("̈́".normalize_nfc(), "̈́")
}

test "unicode_normalization_handles_algorithmic_hangul" {
  Test.assert_str_eq("각".normalize_nfc(), "각")
  Test.assert_str_eq("각".normalize_nfd(), "각")
}

test "unicode_compatibility_forms_expand_ligatures_and_width" {
  Test.assert_str_eq("ﬁ".normalize_nfc(), "ﬁ")
  Test.assert_str_eq("ﬁ①Ｗｅｆｔ".normalize_nfkc(), "fi1Weft")
  Test.assert_str_eq("ﬁ①".normalize_nfkd(), "fi1")
}

test "unicode_compatibility_forms_cover_supplementary_mappings" {
  -- MATHEMATICAL BOLD CAPITAL A is outside the BMP but compatibility-folds.
  Test.assert_str_eq("𝐀".normalize_nfkc(), "A")
  Test.assert_str_eq("🧵".normalize_nfc(), "🧵")
}

test "unicode_compatibility_handles_maximal_decomposition_expansion" {
  -- U+FDFA expands to 18 scalars, the Unicode 17 maximum. This pins the
  -- scratch-capacity bound as well as recursive compatibility lookup.
  Test.assert_str_eq("ﷺ".normalize_nfkd(), "صلى الله عليه وسلم")
}

test "unicode_is_normalized_distinguishes_all_four_forms" {
  Test.assert_true("café".is_normalized_nfc())
  Test.assert_false("café".is_normalized_nfc())
  Test.assert_true("café".is_normalized_nfd())
  Test.assert_false("café".is_normalized_nfd())
  Test.assert_false("ﬁ".is_normalized_nfkc())
  Test.assert_true("fi".is_normalized_nfkc())
  Test.assert_false("Å".is_normalized_nfkd())
  Test.assert_true("Å".is_normalized_nfkd())
}

test "unicode_normalization_is_idempotent" {
  let text = "Ḍ̇ ﬁ 가 𝐀"
  let nfc = text.normalize_nfc()
  let nfd = text.normalize_nfd()
  let nfkc = text.normalize_nfkc()
  let nfkd = text.normalize_nfkd()
  Test.assert_str_eq(nfc.normalize_nfc(), nfc)
  Test.assert_str_eq(nfd.normalize_nfd(), nfd)
  Test.assert_str_eq(nfkc.normalize_nfkc(), nfkc)
  Test.assert_str_eq(nfkd.normalize_nfkd(), nfkd)
}

test "unicode_normalization_rejects_forged_malformed_utf8" {
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_str_eq(text.normalize_nfc(), "")
  Test.assert_false(text.is_normalized_nfc())
}
