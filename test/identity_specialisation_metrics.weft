-- test/identity_specialisation_metrics.weft -- static callback identity
-- specialisation (2k): named-function pairs clone generic specs per
-- call-site recipe; dynamic and lambda closure values retain the
-- canonical indirect path.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/lib.{*}
use compiler/grammar.{*}
use compiler/pipeline.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}

type IdsNativeIdentityProbe {
  IdsNativeIdentityProbe(NativeModule, PipelineIrIdentitySpecialisations)
}

fn ids_canonical_typed(typed: TypedModule, ir: IrModule) -> PipelineIrIdentitySpecialisations {
  match typed {
    TypedModule(fns, user_src, tt) -> {
      let base_functions = pipeline_ir_functions(ir)
      let templates = pipeline_generic_template_pairs(fns)
      let source_specs = pipeline_collect_generic_specs_fns(fns, tt, user_src)
      let ir_specs = pipeline_collect_generic_specs_ir_functions(base_functions, templates, fns, tt)
      let direct_specs = pipeline_ir_function_list_dedup(pipeline_ir_function_list_append(source_specs, ir_specs))
      let generic_specs = pipeline_collect_generic_specs_closure(direct_specs, templates, fns, tt)
      let canonical = pipeline_ir_hoisted_lambda_fns_extend(pipeline_ir_function_list_append(base_functions, generic_specs))
      pipeline_ir_identity_specialise(canonical)
    }
  }
}

fn ids_canonical(program: str) -> PipelineIrIdentitySpecialisations {
  let src = __str_ptr(program)
  let typed = pipeline_check_source_with_origin(src, __str_len(program), 1, 0)
  let ir = pipeline_lower_ir(typed)
  ids_canonical_typed(typed, ir)
}

fn ids_native_identity_probe(program: str) -> IdsNativeIdentityProbe {
  let src = __str_ptr(program)
  let typed = pipeline_check_source_with_origin(src, __str_len(program), 1, 0)
  let ir = pipeline_lower_ir(typed)
  let identities = ids_canonical_typed(typed, ir)
  let optimised = pipeline_optimise_typed_ir(typed, ir)
  IdsNativeIdentityProbe(pipeline_lower_native_module(typed, optimised), identities)
}

fn ids_native_identity_probe_native(probe: IdsNativeIdentityProbe) -> NativeModule {
  match probe {
    IdsNativeIdentityProbe(native, identities) -> native
  }
}

fn ids_native_identity_probe_identities(probe: IdsNativeIdentityProbe) -> PipelineIrIdentitySpecialisations {
  match probe {
    IdsNativeIdentityProbe(native, identities) -> identities
  }
}

fn ids_hash(name: str) -> i64 {
  str_hash(__str_ptr(name), 0, __str_len(name))
}

fn ids_count_indirect_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrIndirectCallI64(dst, callee, args) -> 1
        _ -> 0
      }
      one + ids_count_indirect_insts(rest)
    }
  }
}

fn ids_count_generic_insts(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrGenericCallI64(dst, callee, type_args, args) -> 1
        _ -> 0
      }
      one + ids_count_generic_insts(rest)
    }
  }
}

fn ids_count_contextual_generic_refs(insts: IrInstList) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrGenericFunctionRefI64(dst, callee, type_args) -> 1
        _ -> 0
      }
      one + ids_count_contextual_generic_refs(rest)
    }
  }
}

fn ids_count_contextual_generic_refs_blocks(blocks: IrBlockList) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> ids_count_contextual_generic_refs(insts) + ids_count_contextual_generic_refs_blocks(rest)
    }
  }
}

fn ids_count_contextual_generic_refs_function(functions: IrFunctionList, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, params, blocks, src) -> if hash == target { ids_count_contextual_generic_refs_blocks(blocks) } else { ids_count_contextual_generic_refs_function(rest, target) }
    }
  }
}

fn ids_count_direct_insts(insts: IrInstList, target: i64) -> i64 {
  match insts {
    IrInstNil -> 0
    IrInstCons(inst, rest) -> {
      let one = match inst {
        IrCallI64(dst, callee_hash, args) -> if callee_hash == target { 1 } else { 0 }
        _ -> 0
      }
      one + ids_count_direct_insts(rest, target)
    }
  }
}

fn ids_count_blocks(blocks: IrBlockList, kind: i64, target: i64) -> i64 {
  match blocks {
    IrBlockListNil -> 0
    IrBlockListCons(block, rest) -> {
      let one = match block {
        IrBlock(id, params, insts, term) -> {
          if kind == 1 { ids_count_indirect_insts(insts) }
          else { if kind == 2 { ids_count_generic_insts(insts) }
          else { ids_count_direct_insts(insts, target) } }
        }
      }
      one + ids_count_blocks(rest, kind, target)
    }
  }
}

fn ids_count_in_function(functions: IrFunctionList, fn_hash: i64, kind: i64, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> {
      match f {
        IrFunction(hash, params, blocks, src) -> {
          if hash == fn_hash {
            ids_count_blocks(blocks, kind, target)
          } else {
            ids_count_in_function(rest, fn_hash, kind, target)
          }
        }
      }
    }
  }
}

fn ids_has_function_hash(functions: IrFunctionList, target: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, params, blocks, src) -> if hash == target { 1 } else { ids_has_function_hash(rest, target) }
    }
  }
}

fn ids_count_tag_in_function(functions: IrFunctionList, target: i64, tag: i64) -> i64 {
  match functions {
    IrFunctionNil -> 0 - 100
    IrFunctionCons(f, rest) -> match f {
      IrFunction(hash, params, blocks, src) -> if hash == target { ir_block_list_count_tag(blocks, tag) } else { ids_count_tag_in_function(rest, target, tag) }
    }
  }
}

fn ids_i64_spec_hash(name: str) -> i64 {
  let args = nlist_new()
  nlist_add(args, ty_i64())
  mono_spec_hash(ids_hash(name), args)
}

fn ids_request_count(result: PipelineIrIdentitySpecialisations) -> i64 {
  nlist_len(pipeline_ir_identity_specialisations_requests(result))
}

fn ids_request_clone_hash(result: PipelineIrIdentitySpecialisations, index: i64) -> i64 {
  node_f2(nlist_get(pipeline_ir_identity_specialisations_requests(result), index))
}

fn ids_request_recipe_len(result: PipelineIrIdentitySpecialisations, index: i64) -> i64 {
  nlist_len(node_f3(nlist_get(pipeline_ir_identity_specialisations_requests(result), index)))
}

fn ids_clone_indirects(result: PipelineIrIdentitySpecialisations, index: i64) -> i64 {
  ids_count_in_function(
    pipeline_ir_identity_specialisations_functions(result),
    ids_request_clone_hash(result, index),
    1,
    0
  )
}

fn ids_clone_generic_calls(result: PipelineIrIdentitySpecialisations, index: i64) -> i64 {
  ids_count_in_function(
    pipeline_ir_identity_specialisations_functions(result),
    ids_request_clone_hash(result, index),
    2,
    0
  )
}

fn ids_u32_at(p: i64) -> i64 {
  mem_load8(p) +
  mem_load8(p + 1) * 256 +
  mem_load8(p + 2) * 65536 +
  mem_load8(p + 3) * 16777216
}

fn ids_is_unconditional_b(word: i64) -> i64 {
  if word / 67108864 == 5 { 1 } else { 0 }
}

fn ids_adjacent_b_pairs(code: i64, start: i64, end: i64) -> i64 {
  let data = buf_ptr(code)
  let mut count = 0
  let mut pos = start
  while pos + 8 <= end {
    if ids_is_unconditional_b(ids_u32_at(data + pos)) == 1 and ids_is_unconditional_b(ids_u32_at(data + pos + 4)) == 1 {
      count = count + 1
    } else { 0 }
    pos = pos + 4
  }
  count
}

test "identity_specialisation_static_named_callback_clones_and_devirtualises" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 { apply<i64>(inc, 41) }")
  Test.assert_eq(ids_request_count(result), 1)
  Test.assert_eq(ids_request_recipe_len(result, 0), 1)
  Test.assert_eq(ids_clone_indirects(result, 0), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 2, 0), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 3, ids_request_clone_hash(result, 0)), 1)
}

test "identity_specialisation_transitive_generic_recipe_closes_chain" {
  let result = ids_canonical("fn inner<T>(f: (T) -> T, x: T) -> T { f(x) }
fn outer<T>(f: (T) -> T, x: T) -> T { inner<T>(f, x) }
fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 { outer<i64>(inc, 41) }")
  Test.assert_eq(ids_request_count(result), 2)
  Test.assert_eq(ids_clone_generic_calls(result, 0) + ids_clone_generic_calls(result, 1), 0)
  Test.assert_eq(ids_clone_indirects(result, 0) + ids_clone_indirects(result, 1), 0)
}

test "identity_specialisation_contextual_generic_reference_collects_target" {
  let program = "fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn identity<T>(x: T) -> T { x }
fn outer<T>(x: T) -> T { apply<T>(identity, x) }
fn main() -> i64 { outer<i64>(42) }"
  let typed = pipeline_check_source_with_origin(__str_ptr(program), __str_len(program), 1, 0)
  match typed {
    TypedModule(fns, src, tt) -> {
      let pair = pipeline_generic_template_find(fns, src, ids_hash("outer"))
      let body = node_f4(pipeline_fn_inner(node_f1(pair)))
      let callback = nlist_get(node_f3(node_f2(body)), 0)
      Test.assert_eq(node_tag(callback), 36)
      Test.assert_eq(node_tag(node_f2(callback)), 2)
      Test.assert_eq(nlist_len(node_f1(callback)), 1)
      let ir = pipeline_lower_ir(typed)
      let base = pipeline_ir_functions(ir)
      let templates = pipeline_generic_template_pairs(fns)
      let source_specs = pipeline_collect_generic_specs_fns(fns, tt, src)
      let ir_specs = pipeline_collect_generic_specs_ir_functions(base, templates, fns, tt)
      let direct = pipeline_ir_function_list_dedup(pipeline_ir_function_list_append(source_specs, ir_specs))
      Test.assert_eq(ids_count_contextual_generic_refs_function(direct, ids_i64_spec_hash("outer")), 1)
    }
  }
  let result = ids_canonical(program)
  let functions = pipeline_ir_identity_specialisations_functions(result)
  Test.assert_eq(ids_has_function_hash(functions, ids_i64_spec_hash("outer")), 1)
  Test.assert_eq(ids_count_tag_in_function(functions, ids_i64_spec_hash("outer"), 40), 1)
  Test.assert_eq(ids_has_function_hash(functions, ids_i64_spec_hash("identity")), 1)
}

test "identity_specialisation_repeated_recipe_reuses_one_clone" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 { apply<i64>(inc, 1) + apply<i64>(inc, 2) }")
  Test.assert_eq(ids_request_count(result), 1)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 3, ids_request_clone_hash(result, 0)), 2)
}

test "identity_specialisation_distinct_recipes_emit_distinct_clones" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn inc(x: i64) -> i64 { x + 1 }
fn dec(x: i64) -> i64 { x - 1 }
fn main() -> i64 { apply<i64>(inc, 2) + apply<i64>(dec, 2) }")
  Test.assert_eq(ids_request_count(result), 2)
  Test.assert_eq(if ids_request_clone_hash(result, 0) != ids_request_clone_hash(result, 1) { 1 } else { 0 }, 1)
  Test.assert_eq(ids_clone_indirects(result, 0) + ids_clone_indirects(result, 1), 0)
}

test "identity_specialisation_multiple_static_callbacks_share_recipe_clone" {
  let result = ids_canonical("fn combine<T>(f: (T) -> T, g: (T) -> T, x: T) -> T { f(g(x)) }
fn inc(x: i64) -> i64 { x + 1 }
fn twice(x: i64) -> i64 { x * 2 }
fn main() -> i64 { combine<i64>(inc, twice, 20) }")
  Test.assert_eq(ids_request_count(result), 1)
  Test.assert_eq(ids_request_recipe_len(result, 0), 2)
  Test.assert_eq(ids_clone_indirects(result, 0), 0)
}

test "identity_specialisation_dynamic_callback_keeps_canonical_fallback" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn choose(flag: bool, a: (i64) -> i64, b: (i64) -> i64) -> (i64) -> i64 {
  if flag { a } else { b }
}
fn inc(x: i64) -> i64 { x + 1 }
fn dec(x: i64) -> i64 { x - 1 }
fn main() -> i64 { apply<i64>(choose(true, inc, dec), 41) }")
  Test.assert_eq(ids_request_count(result), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 2, 0), 1)
}

test "identity_specialisation_lambda_closure_uses_env_aware_clone" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn main() -> i64 {
  let offset = 1
  apply<i64>(x => x + offset, 41)
}")
  Test.assert_eq(ids_request_count(result), 1)
  Test.assert_eq(ids_clone_indirects(result, 0), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 2, 0), 0)
}

test "identity_specialisation_factory_closure_keeps_dynamic_fallback" {
  let result = ids_canonical("fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn make(offset: i64) -> (i64) -> i64 { x => x + offset }
fn main() -> i64 { apply<i64>(make(1), 41) }")
  Test.assert_eq(ids_request_count(result), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 2, 0), 1)
}

test "identity_specialisation_local_static_pair_devirtualises_without_clone" {
  let result = ids_canonical("fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 {
  let f = inc
  f(41)
}")
  Test.assert_eq(ids_request_count(result), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 1, 0), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 3, ids_hash("inc")), 1)
}

test "identity_specialisation_local_lambda_devirtualises_with_env_load" {
  let result = ids_canonical("fn main() -> i64 {
  let offset = 1
  let f = x => x + offset
  f(41)
}")
  Test.assert_eq(ids_request_count(result), 0)
  Test.assert_eq(ids_count_in_function(pipeline_ir_identity_specialisations_functions(result), ids_hash("main"), 1, 0), 0)
  Test.assert_eq(pipeline_ir_verify_function_list(pipeline_ir_identity_specialisations_functions(result), 0), 0)
}

test "identity_specialisation_clone_semantic_fact_matches_canonical_spec" {
  let program = "fn apply<T>(f: (T) -> T, x: T) -> T { f(x) }
fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 { apply<i64>(inc, 41) }"
  let src = __str_ptr(program)
  let typed = pipeline_check_source_with_origin(src, __str_len(program), 1, 0)
  let optimised = pipeline_optimise_typed_ir(typed, pipeline_lower_ir(typed))
  let result = ids_canonical(program)
  Test.assert_eq(if pipeline_ir_semantic_fact_find(pipeline_ir_semantic_facts(optimised), ids_request_clone_hash(result, 0)) != 0 { 1 } else { 0 }, 1)
  Test.assert_eq(pipeline_ir_verify_module(optimised), 0)
}

test "identity_specialisation_emitted_target_uses_direct_adr_without_local_thunk" {
  -- The lambda body is hoisted before the identity clone. Its target is
  -- therefore already emitted and nearby when the clone constructs the
  -- closure: a direct ADR is sufficient, whereas the old path emitted
  -- adjacent `b over; b target` words for a local thunk.
  let program = "fn apply<T>(f: (i64) -> i64, x: i64) -> i64 {
  let local = (value: i64) => value
  f(local(x))
}
fn inc(x: i64) -> i64 { x + 1 }
fn main() -> i64 { apply<i64>(inc, 41) }"
  let probe = ids_native_identity_probe(program)
  let native = ids_native_identity_probe_native(probe)
  let identities = ids_native_identity_probe_identities(probe)
  let clone_hash = ids_request_clone_hash(identities, 0)
  let code = pipeline_native_code(native)
  let fm = pipeline_native_fmap(native)
  let clone_off = mono_cache_lookup(fmap_mono_cache(fm), clone_hash)
  Test.assert_eq(ids_request_count(identities), 1)
  Test.assert_eq(if clone_off > 1 { 1 } else { 0 }, 1)
  Test.assert_eq(ids_adjacent_b_pairs(code, clone_off, buf_len(code)), 0)
}
