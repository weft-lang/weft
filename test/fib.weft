-- Expected exit code: 55
-- Fibonacci via wrapper functions (tests callee-saved register preservation)
fn sub(a: Int, b: Int) -> Int { a - b }
fn add(a: Int, b: Int) -> Int { a + b }
fn fib(n: Int) -> Int {
  if n <= 1 { n } else { add(fib(sub(n, 1)), fib(sub(n, 2))) }
}
-- fib(10) = 55
fn main() { fib(10) }
