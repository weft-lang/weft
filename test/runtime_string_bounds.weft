-- The runtime's text slicing and matching refuse every range outside the
-- text, including ranges whose end overflows i64, and read no byte outside it.

use runtime/string.{
  runtime_str_byte_at,
  runtime_str_eq,
  runtime_str_len,
  runtime_str_matches_at,
  runtime_str_slice_bytes,
  runtime_str_storage_from_vector
}
use stdlib/random as random
use stdlib/result.{Result}
use stdlib/test/property as prop
use stdlib/vector as vector

-- The expected slice, built byte by byte from the clamped range.
fn expected_slice(text: str, start: i64, len: i64) -> str {
  let n = runtime_str_len(text)
  let mut bytes = vector.new<u8>()
  if start >= 0 and len >= 0 and start <= n {
    let take = if len > n - start { n - start } else { len }
    for index in 0..take { bytes.push(__i64_to_u8(runtime_str_byte_at(text, start + index))) }
  } else { nil }
  runtime_str_storage_from_vector(bytes)
}

fn expected_match(text: str, position: i64, needle: str) -> bool {
  let n = runtime_str_len(text)
  let needle_len = runtime_str_len(needle)
  if position < 0 or needle_len > n or position > n - needle_len { return false }
  let mut matches = true
  for index in 0..needle_len {
    if runtime_str_byte_at(text, position + index) != runtime_str_byte_at(needle, index) {
      matches = false
    } else { nil }
  }
  matches
}

fn boundary_values(n: i64) -> [i64; 10] {
  [
    0 - 9223372036854775807 - 1,
    0 - 1,
    0,
    1,
    n - 1,
    n,
    n + 1,
    9223372036854775807 - n,
    9223372036854775807 - 1,
    9223372036854775807
  ]
}

test "slices refuse or clamp every boundary range without overflowing" {
  for text in ["", "a", "abc", "héllo"] {
    let n = runtime_str_len(text)
    for start in boundary_values(n) {
      for len in boundary_values(n) {
        Test.assert_eq(
          runtime_str_eq(
            runtime_str_slice_bytes(text, start, len),
            expected_slice(text, start, len)
          ),
          1
        )
      }
    }
  }
}

fn byte_text(value: i64) -> str {
  let mut bytes = vector.new<u8>()
  bytes.push(__i64_to_u8(value))
  runtime_str_storage_from_vector(bytes)
}

test "matches refuse every boundary position without overflowing" {
  for text in ["", "a", "abc", "héllo"] {
    let n = runtime_str_len(text)
    for needle in ["", "a", "bc", "llo"] {
      for position in boundary_values(n) {
        Test.assert_true(
          runtime_str_matches_at(text, position, needle) == expected_match(text, position, needle)
        )
      }
    }
  }
}

-- A position whose end overflows wraps to an address near the text. Whatever
-- byte lies there, exactly one single-byte needle would match it, so no needle
-- may match at all.
test "no byte matches at a position whose end overflows" {
  for text in ["", "a", "abc", "héllo"] {
    for position in [9223372036854775807, 9223372036854775806] {
      for value in 0..256 {
        Test.assert_false(runtime_str_matches_at(text, position, byte_text(value)))
      }
    }
  }
}

fn bounds_laws(case: (str, (i64, i64))) -> bool {
  let (text, range) = case
  let (start, len) = range
  runtime_str_eq(runtime_str_slice_bytes(text, start, len), expected_slice(text, start, len)) ==
    1 and runtime_str_matches_at(text, start, "l") == expected_match(text, start, "l")
}

test "generated ranges slice and match exactly as the byte oracle" {
  let lengths = prop.lengths(0, 12).expect("text lengths are valid")
  let offsets = prop.i64_range(0 - 4, 16).expect("offset range is valid")
  let config = prop.config(random.seed(0x5354524e42445321), 300, 12, 0, 200).expect(
    "the bounds campaign is valid"
  )
  prop.check(
    config,
    prop.pair<str, (i64, i64)>(prop.str(lengths), prop.pair<i64, i64>(offsets, offsets)),
    bounds_laws
  )
}
