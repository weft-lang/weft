use compiler/weft/unicode/normalization_data.{*}
use runtime/string.{runtime_str_storage_from_vector}
use stdlib/string.{int_to_str}
use stdlib/test.{*}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len}
use stdlib/vector/handles.{Vector}

fn normalization_test_is_nfc(text: str) -> i64 {
  if unicode_text_is_nfc(text) { 1 } else { 0 }
}

-- Render scalars as decimal words so one assertion pins a whole sequence.
fn normalization_test_scalars(values: borrow Vector<i64>) -> str {
  let mut text = ""
  for index in 0..vector_len<i64>(values) {
    let word = int_to_str(vector_get_in_bounds<i64>(values, index))
    text = if index == 0 { word } else { text.concat(" ").concat(word) }
  }
  text
}

fn normalization_test_decomposed(scalars: [i64]) -> owned Vector<i64> {
  let mut out = vector.new<i64>()
  for scalar in scalars { unicode_canonical_decompose_push(scalar, out) }
  out
}

test "unicode_normalization_data_pins_unicode_17" {
  Test.assert_str_eq(unicode_normalization_data_version(), "17.0.0")
}

test "unicode_nfc_accepts_empty_ascii_and_precomposed_text" {
  Test.assert_eq(normalization_test_is_nfc(""), 1)
  Test.assert_eq(normalization_test_is_nfc("weft_17"), 1)
  Test.assert_eq(normalization_test_is_nfc("café"), 1)
}

test "unicode_nfc_rejects_decomposed_composition" {
  Test.assert_eq(normalization_test_is_nfc("café"), 0)
}

test "unicode_nfc_observes_hidden_decomposition_order" {
  -- U+1E0A decomposes to D + dot-above, so a following dot-below must
  -- reorder and recompose even though the first source scalar has CCC zero.
  Test.assert_eq(normalization_test_is_nfc("Ḍ̇"), 0)
  Test.assert_eq(normalization_test_is_nfc("Ḍ̇"), 1)
}

test "unicode_nfc_rejects_out_of_order_combining_classes" {
  Test.assert_eq(normalization_test_is_nfc("q̣̇"), 0)
  Test.assert_eq(normalization_test_is_nfc("q̣̇"), 1)
}

test "unicode_nfc_handles_algorithmic_hangul_composition" {
  Test.assert_eq(normalization_test_is_nfc("가"), 1)
  Test.assert_eq(normalization_test_is_nfc("가"), 0)
  Test.assert_eq(normalization_test_is_nfc("각"), 1)
  Test.assert_eq(normalization_test_is_nfc("각"), 0)
}

test "unicode_nfc_does_not_apply_compatibility_decomposition" {
  Test.assert_eq(normalization_test_is_nfc("ﬁ"), 1)
}

test "unicode_nfc_rejects_malformed_utf8" {
  let mut bytes = vector.new<u8>()
  bytes.push(__i64_to_u8(195))
  bytes.push(__i64_to_u8(40))
  Test.assert_eq(normalization_test_is_nfc(runtime_str_storage_from_vector(bytes)), 0)
}

test "unicode_normalization_property_boundaries" {
  Test.assert_eq(unicode_nfc_quick_check_no(832), 1) -- U+0340
  Test.assert_eq(unicode_nfc_quick_check_maybe(768), 1) -- U+0300
  Test.assert_eq(unicode_canonical_combining_class(769), 230)
  Test.assert_eq(unicode_canonical_combining_class(803), 220)
}

test "canonical decomposition pushes recursive and algorithmic parts" {
  let mut out = vector.new<i64>()
  out.push(1)
  unicode_canonical_decompose_push(7690, out) -- U+1E0A: D + dot above
  unicode_canonical_decompose_push(44032, out) -- U+AC00: L + V
  unicode_canonical_decompose_push(44033, out) -- U+AC01: L + V + T
  unicode_canonical_decompose_push(97, out)
  Test.assert_str_eq(normalization_test_scalars(out), "1 68 775 4352 4449 4352 4449 4520 97")
}

test "canonical ordering is stable within a combining class and bounded by starters" {
  let mut marks: [i64; 6] = [113, 775, 803, 769, 97, 803]
  let mut values = normalization_test_decomposed(marks[..])
  unicode_canonical_order(values)
  Test.assert_str_eq(normalization_test_scalars(values), "113 803 775 769 97 803")
  let mut empty = vector.new<i64>()
  unicode_canonical_order(empty)
  Test.assert_eq(vector_len<i64>(empty), 0)
}

test "canonical composition respects blocking and appends after existing output" {
  let mut source: [i64; 5] = [101, 769, 4352, 4449, 4520]
  let values = normalization_test_decomposed(source[..])
  let mut out = vector.new<i64>()
  out.push(7)
  unicode_canonical_compose(values, out)
  Test.assert_str_eq(normalization_test_scalars(out), "7 233 44033")
  let mut blocked: [i64; 3] = [97, 803, 803]
  let blocked_values = normalization_test_decomposed(blocked[..])
  let mut blocked_out = vector.new<i64>()
  unicode_canonical_compose(blocked_values, blocked_out)
  Test.assert_str_eq(normalization_test_scalars(blocked_out), "7841 803")
  let empty_values = vector.new<i64>()
  let mut empty_out = vector.new<i64>()
  unicode_canonical_compose(empty_values, empty_out)
  Test.assert_eq(vector_len<i64>(empty_out), 0)
}
