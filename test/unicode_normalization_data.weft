use compiler/unicode_normalization_data.{*}
use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}

fn normalization_test_is_nfc(text: str) -> i64 {
  unicode_bytes_are_nfc(__str_ptr(text), 0, __str_len(text))
}

test "unicode_normalization_data_pins_unicode_17" {
  Test.assert_str_eq(unicode_normalization_data_version(), "17.0.0")
}

test "unicode_nfc_accepts_empty_ascii_and_precomposed_text" {
  Test.assert_eq(normalization_test_is_nfc(""), 1)
  Test.assert_eq(normalization_test_is_nfc("weft_17"), 1)
  Test.assert_eq(normalization_test_is_nfc("café"), 1)
}

test "unicode_nfc_rejects_decomposed_composition" {
  Test.assert_eq(normalization_test_is_nfc("café"), 0)
}

test "unicode_nfc_observes_hidden_decomposition_order" {
  -- U+1E0A decomposes to D + dot-above, so a following dot-below must
  -- reorder and recompose even though the first source scalar has CCC zero.
  Test.assert_eq(normalization_test_is_nfc("Ḍ̇"), 0)
  Test.assert_eq(normalization_test_is_nfc("Ḍ̇"), 1)
}

test "unicode_nfc_rejects_out_of_order_combining_classes" {
  Test.assert_eq(normalization_test_is_nfc("q̣̇"), 0)
  Test.assert_eq(normalization_test_is_nfc("q̣̇"), 1)
}

test "unicode_nfc_handles_algorithmic_hangul_composition" {
  Test.assert_eq(normalization_test_is_nfc("가"), 1)
  Test.assert_eq(normalization_test_is_nfc("가"), 0)
  Test.assert_eq(normalization_test_is_nfc("각"), 1)
  Test.assert_eq(normalization_test_is_nfc("각"), 0)
}

test "unicode_nfc_does_not_apply_compatibility_decomposition" {
  Test.assert_eq(normalization_test_is_nfc("ﬁ"), 1)
}

test "unicode_nfc_rejects_malformed_utf8" {
  let text = runtime_str_alloc_uninit(2)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 195)
  mem_store8_at(data, 1, 40)
  Test.assert_eq(normalization_test_is_nfc(text), 0)
}

test "unicode_normalization_property_boundaries" {
  Test.assert_eq(unicode_nfc_quick_check_no(832), 1)     -- U+0340
  Test.assert_eq(unicode_nfc_quick_check_maybe(768), 1) -- U+0300
  Test.assert_eq(unicode_canonical_combining_class(769), 230)
  Test.assert_eq(unicode_canonical_combining_class(803), 220)
}
