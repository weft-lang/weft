use compiler/grammar_host.{parse_use_module_with_loader}
use compiler/declaration_syntax.{*}
use compiler/ir.{*}
use compiler/lex.{lex}
use compiler/lib.{nlist_new, nlist_len, nlist_get, node_f4}
use compiler/module.{PrivateVisibility, PackageVisibility, PublicVisibility}
use compiler/parse.{parse_module_syntax_local}
use compiler/type_registry.{ttable_new}
use compiler/types.{PRIM_I64}
use stdlib/diagnostic/schema.{Diagnose, DiagnosticSeverityError}
use stdlib/list.{List, Cons, Nil}
use stdlib/option.{Option}
use stdlib/state as state

fn declaration_syntax_parse(source: str) -> (ParsedModuleSyntax, i64) {
  let tokens = lex(__str_ptr(source), __str_len(source))
  state.run(0, () => handle parse_module_syntax_local(tokens, __str_ptr(source), ttable_new()) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1) nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, location) -> { state.modify((count: i64) => count + 1) resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  })
}

fn declaration_syntax_text(source: str, declaration: SourceDeclaration) -> str {
  source.slice(__i64_to_usize(declaration.range.start), __i64_to_usize(declaration.range.start + declaration.range.length)).unwrap()
}

fn declaration_syntax_no_loader(physical: i64, physical_len: i64, logical: i64, logical_len: i64, package_id: i64) -> i64 { 0 }

test "transparent type declarations retain visibility target and source range" {
  let source = "-- 🧶\npub type Value = i64 | str\ntype Pair<T> = (T, T)"
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 0)
  Test.assert_eq_usize(parsed.declarations.len(), 2)
  let value = parsed.declarations.get(0).unwrap()
  Test.assert_true(match value.visibility { PublicVisibility -> true, _ -> false })
  Test.assert_true(match value.syntax {
    TypeDefinition(TypeAliasEntry(_, _, UnionTypeExpr(PrimitiveTypeExpr(_), PrimitiveTypeExpr(_)))) -> true
    _ -> false
  })
  Test.assert_str_eq(declaration_syntax_text(source, value), "pub type Value = i64 | str")
  Test.assert_true(match parsed.declarations.get(1).unwrap().syntax {
    TypeDefinition(TypeAliasEntry(_, parameters, RecordTypeExpr(_, _, _))) -> type_param_list_len(parameters) == 1
    _ -> false
  })
}

fn declaration_syntax_parse_dependency(source: str) -> (i64, i64) {
  let tokens = lex(__str_ptr(source), __str_len(source))
  let functions = nlist_new()
  let (_, errors) = state.run(0, () => handle parse_use_module_with_loader(tokens, __str_ptr(source), functions, ttable_new(), declaration_syntax_no_loader) {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> { state.modify((count: i64) => count + 1) nil }
        _ -> nil
      }
      resume(0)
    }
    Diagnose.error(message, location) -> { state.modify((count: i64) => count + 1) resume(0) }
    Diagnose.warn(message, location) -> resume(0)
    Diagnose.note(message, location) -> resume(0)
  })
  (functions, errors)
}

test "source parsing retains all top-level declarations in order" {
  let source = "use missing/dep as dep\npub const answer: i64 = 42\npub(package) type Entry { value: i64 }\ntype Choice { Off, On(i64) }\ntype Token = opaque str\neffect Read { fn value() -> i64 }\ntrait Show { fn show(self) -> str }\nimpl Show for Entry { fn show(self) -> str { \"ok\" } }\npub fn run() -> i64 { answer }\ntest \"example\" { 42 }\nimplements Read() { Read.value() -> resume(42) }\ndefault handler dep()"
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 0)
  Test.assert_true(parsed.declarations.len() == 12)
  let declarations = parsed.declarations
  Test.assert_true(match declarations.get(0).unwrap().syntax { ImportDefinition(_) -> true, _ -> false })
  Test.assert_true(match declarations.get(1).unwrap().syntax { ConstantDefinition(constant) -> type_expr_prim_id_or(constant.declared_type, -1) == PRIM_I64(), _ -> false })
  Test.assert_true(match declarations.get(2).unwrap().syntax { TypeDefinition(TypeRecordEntry(_, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(3).unwrap().syntax { TypeDefinition(TypeVariantEntry(_, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(4).unwrap().syntax { TypeDefinition(TypeOpaqueEntry(_, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(5).unwrap().syntax { TypeDefinition(TypeEffectEntry(_, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(6).unwrap().syntax { TypeDefinition(TypeTraitEntry(_, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(7).unwrap().syntax { TypeDefinition(TypeImplEntry(_, _, _, _)) -> true, _ -> false })
  Test.assert_true(match declarations.get(8).unwrap().syntax { FunctionDefinition(_) -> true, _ -> false })
  Test.assert_true(match declarations.get(9).unwrap().syntax { TestDefinition(_) -> true, _ -> false })
  Test.assert_true(match declarations.get(10).unwrap().syntax { HandlerDefinition(_) -> true, _ -> false })
  Test.assert_true(match declarations.get(11).unwrap().syntax { DefaultHandlerDefinition(_) -> true, _ -> false })
  let mut end = 0
  for declaration in declarations {
    Test.assert_true(declaration.range.start >= end)
    Test.assert_true(declaration.range.length > 0)
    Test.assert_true(match declaration.validity { ParsedDeclaration -> true, _ -> false })
    end = declaration.range.start + declaration.range.length
  }
  Test.assert_true(match declarations.get(1).unwrap().visibility { PublicVisibility -> true, _ -> false })
  Test.assert_true(match declarations.get(2).unwrap().visibility { PackageVisibility -> true, _ -> false })
  Test.assert_true(match declarations.get(3).unwrap().visibility { PrivateVisibility -> true, _ -> false })
  Test.assert_str_eq(declaration_syntax_text(source, declarations.get(1).unwrap()), "pub const answer: i64 = 42")
}

test "retained function syntax includes signature generics and capability atoms" {
  let source = "-- é🧶\npub fn invoke<T: api.Show>(value: T) -[State<T>]> T { value }"
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 0)
  Test.assert_true(match parsed.declarations.first().unwrap().syntax {
    FunctionDefinition(function) -> {
      Test.assert_eq(param_list_len(function.params), 1)
      Test.assert_eq(type_param_list_len(function.type_params), 1)
      Test.assert_true(match function.result { VariableTypeExpr(_) -> true, _ -> false })
      Test.assert_true(match function.effects {
        EffectSig(TypeExprListCons(UnqualifiedEffectTypeExpr(_, TypeExprListCons(VariableTypeExpr(_), TypeExprListNil), range), TypeExprListNil), 0) ->
          source.slice(__i64_to_usize(range.start), __i64_to_usize(range.start + range.length)).unwrap() == "State"
        _ -> false
      })
      source.slice(__i64_to_usize(function.name.start), __i64_to_usize(function.name.start + function.name.length)).unwrap() == "invoke"
    }
    _ -> false
  })
  Test.assert_true(parsed.declarations.first().unwrap().range.start == 10)
}

test "recovered declarations remain explicit and preserve the following function" {
  for source in ["const bad = 1\nfn good() -> i64 { 7 }", "type Missing\nfn good() -> i64 { 7 }", "use\nfn good() -> i64 { 7 }"] {
    let (parsed, errors) = declaration_syntax_parse(source)
    Test.assert_true(errors > 0)
    Test.assert_true(match parsed.declarations.first().unwrap().validity { RecoveredDeclaration -> true, _ -> false })
    let last = parsed.declarations.get(parsed.declarations.len() - 1).unwrap()
    Test.assert_true(match last.syntax { FunctionDefinition(_) -> true, _ -> false })
    Test.assert_true(match last.validity { ParsedDeclaration -> true, _ -> false })
    Test.assert_str_eq(declaration_syntax_text(source, last), "fn good() -> i64 { 7 }")
    Test.assert_eq(nlist_len(parsed.functions), 1)
  }
}

test "duplicate handler recovery retains the declaration that caused the error" {
  let source = "implements First() {}\nimplements Second() {}\nfn good() -> i64 { 7 }"
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 1)
  Test.assert_true(parsed.declarations.len() == 3)
  Test.assert_true(match parsed.declarations.get(1).unwrap().syntax {
    HandlerDefinition(handler) -> match handler.effect_reference {
      Ident(start, len) -> source.slice(__i64_to_usize(start), __i64_to_usize(start + len)).unwrap() == "Second"
      _ -> false
    }
    _ -> false
  })
  Test.assert_true(match parsed.declarations.get(1).unwrap().validity { RecoveredDeclaration -> true, _ -> false })
}

test "entry and dependency parsing share recovery but dependency tests stay inactive" {
  let source = "test \"hidden\" { 41 }\nfn visible() -> i64 { 42 }"
  let (entry, entry_errors) = declaration_syntax_parse(source)
  let (dependency, dependency_errors) = declaration_syntax_parse_dependency(source)
  Test.assert_eq(entry_errors, 0)
  Test.assert_eq(dependency_errors, 0)
  Test.assert_eq(nlist_len(entry.functions), 2)
  Test.assert_eq(nlist_len(dependency), 1)
  Test.assert_eq(node_f4(nlist_get(dependency, 0)), 0)
  let malformed = "const missing\nfn retained() -> i64 { 3 }"
  let (recovered_entry, first_errors) = declaration_syntax_parse(malformed)
  let (recovered_dependency, second_errors) = declaration_syntax_parse_dependency(malformed)
  Test.assert_true(first_errors > 0)
  Test.assert_eq(first_errors, second_errors)
  Test.assert_eq(nlist_len(recovered_entry.functions), 1)
  Test.assert_eq(nlist_len(recovered_dependency), 1)
}

test "empty and comment-only sources produce no declarations" {
  for source in ["", "-- 🧶\n-- const ignored: i64 = 4\n"] {
    let (parsed, errors) = declaration_syntax_parse(source)
    Test.assert_eq(errors, 0)
    Test.assert_true(parsed.declarations.is_empty())
    Test.assert_eq(nlist_len(parsed.functions), 0)
  }
}

test "lexical failure has the same boundary for entries and dependencies" {
  let source = "const name: str = \"unfinished"
  let (entry, entry_errors) = declaration_syntax_parse(source)
  let (dependency, dependency_errors) = declaration_syntax_parse_dependency(source)
  Test.assert_true(entry_errors > 0)
  Test.assert_eq(entry_errors, dependency_errors)
  Test.assert_true(entry.declarations.is_empty())
  Test.assert_eq(nlist_len(entry.functions), 0)
  Test.assert_eq(nlist_len(dependency), 0)
}

test "adjacent generic closes and assignments retain full declaration ranges" {
  let source = "-- 🧶\npub type Pair<T>=(T,T)\ntype Last<U>=U\nfn finish() -> i64 { 42 }"
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 0)
  Test.assert_eq_usize(parsed.declarations.len(), 3)
  Test.assert_str_eq(declaration_syntax_text(source, parsed.declarations.get(0).unwrap()), "pub type Pair<T>=(T,T)")
  Test.assert_str_eq(declaration_syntax_text(source, parsed.declarations.get(1).unwrap()), "type Last<U>=U")
  Test.assert_str_eq(declaration_syntax_text(source, parsed.declarations.get(2).unwrap()), "fn finish() -> i64 { 42 }")
  Test.assert_eq(nlist_len(parsed.functions), 1)
}

test "token expansion preserves all following declarations in large sources" {
  let mut source = ""
  for i in 0..500 { source = source.concat("type A{i}<T>=T\n") }
  source = source.concat("fn finish() -> i64 { 42 }")
  let (parsed, errors) = declaration_syntax_parse(source)
  Test.assert_eq(errors, 0)
  Test.assert_eq_usize(parsed.declarations.len(), 501)
  Test.assert_eq(nlist_len(parsed.functions), 1)
  Test.assert_str_eq(declaration_syntax_text(source, parsed.declarations.get(500).unwrap()), "fn finish() -> i64 { 42 }")
}
