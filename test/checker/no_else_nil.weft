type NoElseOpt { Some(i64), None }

fn if_no_else_assignment(flag: bool) -> i64 {
  let mut r: i64 = 0
  if flag { r = 42 }
  r
}

fn if_no_else_value_statement(flag: bool) -> i64 {
  if flag { 99 }
  42
}

fn iflet_no_else_assignment(x: NoElseOpt) -> i64 {
  let mut r: i64 = 0
  if let Some(v) = x { r = v }
  r
}

fn iflet_no_else_value_statement(x: NoElseOpt) -> i64 {
  if let Some(v) = x { v }
  42
}
