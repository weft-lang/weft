effect Math {
  fn add(a: i64, b: i64) -> i64
}

effect OuterResume {
  fn get() -> i64
}

effect InnerResume {
  fn get() -> i64
}

fn main() -> i64 {
  handle Math.add(20, 22) {
    Math.add(a, b) -> resume(a + b)
  }
}

fn nested_handler_resume_ok() -> i64 {
  handle OuterResume.get() {
    OuterResume.get() -> {
      let f = x => handle InnerResume.get() {
        InnerResume.get() -> resume(x)
      }
      resume(f(42))
    }
  }
}
