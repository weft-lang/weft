type StructuralSurfaceBox<T> {
  exact: {value: T, label: str},
  open: {value: T, ..},
  pair: (T, str),
  singleton: (T,),
  unit: ()
}

type StructuralSurfaceChoice<T> {
  Exact({value: T, label: str}),
  Open({value: T, ..}),
  Pair((T, str))
}

effect StructuralSurfaceEffect<T> {
  fn transform(value: {value: T, ..}, pair: (T, str)) -> {value: T, ..}
}

trait StructuralSurfaceTrait {
  fn inspect(value: {value: i64, ..}, pair: (i64, str)) -> (i64, str)
}

fn structural_exact_identity<T>(value: {value: T, label: str}) -> {value: T, label: str} {
  value
}

fn structural_width(value: {value: bool, label: str}) -> {value: i64, ..} {
  value
}

fn structural_open_width(value: {value: bool, label: str, ..}) -> {value: i64, ..} {
  value
}

fn structural_reordered(value: {value: i64, label: str}) -> {label: str, value: i64} {
  value
}

fn structural_tuple_depth(value: (bool, str)) -> (i64, str) {
  value
}

fn structural_singleton_tuple(value: (i64,)) -> (i64,) {
  value
}

fn structural_grouped(value: (i64)) -> i64 {
  value
}

fn structural_unit(value: ()) -> () {
  value
}

fn structural_eight_lane_identity(value: (i64, i64, i64, i64, i64, i64, i64, i64)) -> (i64, i64, i64, i64, i64, i64, i64, i64) {
  value
}

fn structural_eight_lane_call(value: (i64, i64, i64, i64, i64, i64, i64, i64)) -> (i64, i64, i64, i64, i64, i64, i64, i64) {
  structural_eight_lane_identity(value)
}

fn structural_managed_pair_if(cond: bool, left: (str, i64), right: (str, i64)) -> (str, i64) {
  if cond { left } else { right }
}

fn structural_managed_pair_mut(value: (str, i64), next: (str, i64)) -> (str, i64) {
  let mut current = value
  current = next
  current
}

fn main() -> i64 {
  0
}
