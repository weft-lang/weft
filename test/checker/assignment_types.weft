fn assign_i64() -> i64 {
  let mut x = 0
  x = 42
  x
}

fn assign_typed_i64() -> i64 {
  let mut x: i64 = 1
  x = 41
  x + 1
}

fn assign_str() -> str {
  let mut s = "old"
  s = "new"
  s
}

fn assign_bool() -> bool {
  let mut b = false
  b = true
  b
}

fn assign_after_branch(flag: bool) -> i64 {
  let mut x = 0
  if flag { x = 1 } else { x = 2 }
  x
}

fn shadow_mutability() -> i64 {
  let x = 1
  let mut x = 2
  x = 42
  x
}

fn lambda_local_mutable() -> i64 {
  let x = 1
  let f = y => {
    let mut x = y
    x = x + 1
    x
  }
  f(41)
}
