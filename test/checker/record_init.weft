type Point { x: i64, y: i64 }
type Rect { w: i64, h: i64 }
type HasX { x: i64 }

fn direct() -> i64 {
  let p = Point { x: 20, y: 22 }
  p.x + p.y
}

fn reordered() -> i64 {
  let p = Point { y: 22, x: 20 }
  p.x + p.y
}

fn multiple_record_types() -> i64 {
  let r = Rect { w: 6, h: 7 }
  let h = HasX { x: 42 }
  r.w * r.h + h.x - 42
}

fn through_function() -> Point {
  Point { x: 40, y: 2 }
}
