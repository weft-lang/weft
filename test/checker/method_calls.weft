effect MethodLog {
  fn ping() -> i64
}

type MethodBox {
  v: i64
}

trait MethodAdder {
  fn bump(self: i64, n: i64) -> i64
}

impl MethodBox {
  fn add(self: i64, n: i64) -> i64 {
    __mem_load64(self) + n
  }

  fn add3(self: i64, a: i64, b: i64, c: i64) -> i64 {
    __mem_load64(self) + a + b + c
  }

  fn noisy(self: i64) -[MethodLog]> i64 {
    MethodLog.ping()
  }
}

impl MethodAdder for MethodBox {
  fn bump(self: i64, n: i64) -> i64 {
    __mem_load64(self) + n
  }
}

fn method_one_arg(b: MethodBox) -> i64 {
  b.add(1)
}

fn method_three_args(b: MethodBox) -> i64 {
  b.add3(1, 2, 3)
}

fn trait_bound_method<T: MethodAdder>(x: T) -> i64 {
  x.bump(2)
}

fn method_effect_allowed(b: MethodBox) -[MethodLog]> i64 {
  b.noisy()
}
