type ShapePattern {
  PointPattern,
  CirclePattern(i64),
  RectPattern(i64, i64)
}

type ColorPattern {
  RedPattern(i64),
  BluePattern
}

fn pattern_zero_payload(s: ShapePattern) -> i64 {
  match s {
    PointPattern -> 0
    CirclePattern(r) -> r
    RectPattern(w, h) -> w + h
  }
}

fn pattern_wildcard_payload(s: ShapePattern) -> i64 {
  match s {
    CirclePattern(_) -> 1
    RectPattern(_, h) -> h
    PointPattern -> 0
  }
}

fn pattern_guard_bindings(c: ColorPattern) -> i64 {
  match c {
    RedPattern(v) if v > 0 -> v
    RedPattern(_) -> 0
    BluePattern -> 1
  }
}

fn pattern_literal_i64(n: i64) -> i64 {
  match n {
    0 -> 10
    1 -> 20
    _ -> 30
  }
}

fn pattern_bare_zero_payload_arg() -> i64 {
  pattern_zero_payload(PointPattern)
}

fn pattern_bare_zero_payload_binding() -> i64 {
  let s: ShapePattern = PointPattern
  pattern_zero_payload(s)
}
