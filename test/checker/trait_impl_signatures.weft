effect ImplSigLog {
  fn ping() -> i64
}

type ImplSigBox {
  v: i64
}

trait ImplSigAdder {
  fn add(self: ImplSigBox, n: i64) -> i64
}

trait ImplSigEffect {
  fn noisy(self: ImplSigBox) -[ImplSigLog]> i64
  fn quiet(self: ImplSigBox) -[ImplSigLog]> i64
}

impl ImplSigAdder for ImplSigBox {
  fn add(self: ImplSigBox, n: i64) -> i64 {
    self.v + n
  }
}

impl ImplSigEffect for ImplSigBox {
  fn noisy(self: ImplSigBox) -[ImplSigLog]> i64 {
    ImplSigLog.ping()
  }

  fn quiet(self: ImplSigBox) -> i64 {
    7
  }
}

fn use_impl_sig_adder<T: ImplSigAdder>(x: T) -> i64 {
  x.add(4)
}

fn use_impl_sig_effect<T: ImplSigEffect>(x: T) -[ImplSigLog]> i64 {
  x.noisy() + x.quiet()
}
