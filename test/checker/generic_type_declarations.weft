type List<T> {
  Nil,
  Cons(T, List<T>)
}

type Result<T, E> {
  Ok(T),
  Err(E)
}

fn keep_i64(xs: List<i64>) -> List<i64> {
  xs
}

fn keep_result(r: Result<i64, str>) -> Result<i64, str> {
  r
}

fn main() -> i64 {
  let xs: List<i64> = Cons<i64>(1, Nil<i64>())
  let ys: List<i64> = keep_i64(xs)
  let ok: Result<i64, str> = Ok<i64, str>(42)
  let kept: Result<i64, str> = keep_result(ok)
  42
}
