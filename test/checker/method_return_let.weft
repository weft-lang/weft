trait Parses {
  fn parse(self: i64) -> i64
}

type Grammar {
  Grammar
}

impl Parses for Grammar {
  fn parse(self: i64) -> i64 { 42 }
}

fn make_grammar() -> Grammar { Grammar() }

fn needs_i64(x: i64) -> i64 { x }

fn main() -> i64 {
  let grammar = make_grammar()
  let parsed = grammar.parse()
  needs_i64(parsed)
}
