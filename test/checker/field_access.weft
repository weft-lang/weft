type Point { x: i64, y: i64 }
type Rect { w: i64, h: i64 }
type HasX { x: i64 }

fn direct() -> i64 {
  let p = Point { x: 20, y: 22 }
  p.x + p.y
}

fn param(p: Point) -> i64 {
  p.x + p.y
}

fn returned() -> i64 {
  let r = make_rect()
  r.w * r.h
}

fn make_rect() -> Rect {
  Rect { w: 6, h: 7 }
}

fn same_field_name() -> i64 {
  let p = Point { x: 20, y: 22 }
  let h = HasX { x: 1 }
  p.x + h.x + 21
}
