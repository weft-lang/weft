use "stdlib/unsafe.weft"

fn safe_pointer_read_write_ok() -> i64 {
  let p = __bump_alloc(8)
  __mem_store64(p, 9)
  __mem_load64(p)
}

fn direct_raw_syscall_ok() -[Unsafe]> i64 {
  __syscall(4, 1, __str_ptr(""), 0, 0, 0, 0)
}

fn direct_got_ok() -[Unsafe]> i64 {
  __got_write(1, __str_ptr(""), 0, 0, 0, 0)
}

fn direct_raw_offset_ok(ptr: i64) -[Unsafe]> i64 {
  __raw_offset(ptr, 8)
}

fn direct_transmute_ok(value: i64) -[Unsafe]> i64 {
  __transmute(value)
}

fn direct_int_to_ptr_ok(addr: i64) -[Unsafe]> i64 {
  __int_to_ptr(addr)
}

fn direct_runtime_state_ok() -[Unsafe]> i64 {
  __runtime_state()
}

fn unsafe_effect_wrapper_ok() -[Unsafe]> i64 {
  unsafe_raw_syscall(4, 1, 0, 0, 0, 0, 0)
}

fn trusted_wrapper_ok() -> i64 {
  handle unsafe_raw_syscall(4, 1, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

fn trusted_raw_syscall_impl_ok() -> i64 {
  handle unsafe_raw_syscall(4, 1, __str_ptr(""), 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(__syscall(num, a0, a1, a2, a3, a4, a5))
  }
}

fn trusted_raw_offset_impl_ok(ptr: i64) -> i64 {
  handle unsafe_raw_offset(ptr, 8) {
    Unsafe.raw_offset(p, off) -> resume(__raw_offset(p, off))
  }
}

fn trusted_transmute_impl_ok(value: i64) -> i64 {
  handle unsafe_transmute(value) {
    Unsafe.transmute(v) -> resume(__transmute(v))
  }
}

fn trusted_int_to_ptr_impl_ok(addr: i64) -> i64 {
  handle unsafe_int_to_ptr(addr) {
    Unsafe.int_to_ptr(v) -> resume(__int_to_ptr(v))
  }
}

fn trusted_runtime_state_impl_ok() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

fn unsafe_generic_ok<T>(x: T, f: (T) -[Unsafe]> i64) -[Unsafe]> i64 {
  f(x)
}

type UnsafeMethodBox {
  ptr: i64
}

impl UnsafeMethodBox {
  fn raw_field(self: i64) -[Unsafe]> i64 {
    __raw_offset(self, 8)
  }
}

fn unsafe_method_ok(box: UnsafeMethodBox) -[Unsafe]> i64 {
  box.raw_field()
}

fn main() -> i64 {
  safe_pointer_read_write_ok() + trusted_wrapper_ok() + trusted_raw_syscall_impl_ok() + trusted_raw_offset_impl_ok(10) + trusted_transmute_impl_ok(7) + trusted_int_to_ptr_impl_ok(3) + if trusted_runtime_state_impl_ok() != 0 { 1 } else { 0 }
}
