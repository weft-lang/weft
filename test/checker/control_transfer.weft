effect Counter {
  fn next() -> i64
}

fn early_i64(flag: bool) -> i64 {
  if flag { return 42 } else { 0 }
  0
}

fn early_str(flag: bool) -> str {
  if flag { return "yes" } else { 0 }
  "no"
}

fn return_effect() -[Counter]> i64 {
  return Counter.next()
}

fn break_value() -> i64 {
  let r = loop {
    break(42)
  }
  r
}

fn break_effect() -[Counter]> i64 {
  loop {
    break(Counter.next())
  }
}
