type ArraySurfaceRecord<T> {
  fixed: [T; 4],
  empty: [never; 0],
  view: [T],
  mutable_view: [mut T]
}

type ArraySurfaceChoice<T> {
  Fixed([T; 2]),
  View([T]),
  MutableView([mut T])
}

effect ArraySurfaceEffect<T> {
  fn transform(value: [T; 2], view: [T]) -> [T; 2]
}

trait ArraySurfaceTrait {
  fn inspect(fixed: [i64; 2], view: [i64], mutable_view: [mut i64]) -> [i64; 2]
}

fn fixed_identity<T>(value: [T; 4]) -> [T; 4] {
  value
}

fn nested_identity(value: [[i64; 2]; 3]) -> [[i64; 2]; 3] {
  value
}

fn array_covariance(value: [bool; 2]) -> [i64; 2] {
  value
}

fn slice_covariance(value: [bool]) -> [i64] {
  value
}

fn canonical_empty_array(value: [never; 0]) -> [str; 0] {
  value
}

fn immutable_slice_param(value: [i64]) -> i64 {
  0
}

fn mutable_slice_param(value: [mut i64]) -> i64 {
  0
}

fn main() -> i64 {
  0
}
