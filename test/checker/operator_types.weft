fn bool_to_i64(b: bool) -> i64 {
  if b { 1 } else { 0 }
}

fn comparison_matrix() -> i64 {
  bool_to_i64(5 == 5)
  + bool_to_i64(5 != 6) * 2
  + bool_to_i64(3 < 5) * 4
  + bool_to_i64(5 > 3) * 8
  + bool_to_i64(5 <= 5) * 16
  + bool_to_i64(5 >= 5) * 32
}

fn bool_equality(a: bool, b: bool) -> bool {
  a == b
}

fn string_equality_typechecks(a: str, b: str) -> bool {
  a != b
}

fn bitwise_matrix() -> i64 {
  (6 band 3) + (4 bor 1) + (7 bxor 3) + (1 bshl 3) + (8 bshr 1)
}
