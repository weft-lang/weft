effect State {
  fn get() -> i64
  fn put(v: i64) -> i64
}

fn handle_two_direct_ops() -> i64 {
  handle {
    let x = State.get()
    State.put(x)
  } {
    State.get() -> resume(20)
    State.put(v) -> resume(v + 2)
  }
}

fn handle_branch_op() -> i64 {
  handle {
    if true { State.get() } else { 0 }
  } {
    State.get() -> resume(7)
  }
}

fn main() -> i64 {
  handle_two_direct_ops() + handle_branch_op()
}
