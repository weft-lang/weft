use stdlib/http.{HttpLimits, HttpRequestHead}
use stdlib/http/endpoint.{HttpClient, HttpClientBegin, HttpClientRequestFailed, HttpExchangeUnsupportedScheme, HttpServer, HttpServerListen, HttpServerListenFailed}
use stdlib/net_address.{SocketAddress}
use stdlib/tcp.{TcpListenOptions}
use stdlib/url.{Url, UrlHttp}

-- These handlers deliberately return the typed failure half of each protocol
-- operation. Their pure signatures prove that deterministic/fault-injection
-- interpretations need neither DNS/socket authority nor TLS authority.
fn http_mock_client_begin(
  url: Url,
  request: HttpRequestHead,
  limits: HttpLimits
) -> HttpClientBegin<i64> {
  handle HttpClient<i64>.begin(url, request, limits) {
    HttpClient<i64>.begin(handled_url, handled_request, handled_limits) -> resume(HttpClientRequestFailed<i64>(HttpExchangeUnsupportedScheme(UrlHttp)))
  }
}

fn http_mock_server_listen(
  address: SocketAddress,
  options: TcpListenOptions
) -> HttpServerListen {
  handle HttpServer.listen(address, options) {
    HttpServer.listen(handled_address, handled_options) -> resume(HttpServerListenFailed(HttpExchangeUnsupportedScheme(UrlHttp)))
  }
}
