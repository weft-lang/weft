fn if_bool(b: bool) -> i64 {
  if b { 1 } else { 0 }
}

fn if_comparison(n: i64) -> i64 {
  if n < 10 { 1 } else { 0 }
}

fn while_comparison(n: i64) -> i64 {
  let mut i = 0
  while i < n { i = i + 1 }
  i
}

fn not_bool(b: bool) -> bool {
  not b
}

fn logical_bools(a: bool, b: bool) -> bool {
  a and b or not a
}
