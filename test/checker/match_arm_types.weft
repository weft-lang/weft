type Choice { A(i64), B(i64) }
type Person { name: str, active: bool }
type Pair { x: i64, y: i64 }

fn int_arms(n: i64) -> i64 {
  match n {
    0 -> 10
    1 -> 20
    _ -> 42
  }
}

fn string_arms(n: i64) -> str {
  match n {
    0 -> "zero"
    1 -> "one"
    _ -> "many"
  }
}

fn bool_arms(n: i64) -> bool {
  match n {
    0 -> true
    _ -> false
  }
}

fn variant_payload_arms(c: Choice) -> i64 {
  match c {
    A(x) -> x
    B(y) -> y + 1
  }
}

fn record_arms(n: i64) -> Person {
  match n {
    0 -> Person { name: "ada", active: true }
    _ -> Person { name: "grace", active: false }
  }
}

fn nested_arm_types(p: Pair) -> i64 {
  match p.x {
    0 -> match p.y {
      0 -> 0
      _ -> 1
    }
    _ -> p.x + p.y
  }
}
