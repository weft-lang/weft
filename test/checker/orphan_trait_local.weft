use "test/checker/orphan_foreign_type.weft"

trait OrphanTraitLocal {
  fn trait_local_value(self) -> i64
}

impl OrphanTraitLocal for OrphanForeignType {
  fn trait_local_value(self) -> i64 { self.value }
}

fn orphan_trait_local_accepts(value: OrphanForeignType) -> i64 {
  value.trait_local_value()
}
