effect Log {
  fn hit() -> i64
}

type LambdaEffectBox {
  v: i64
}

impl LambdaEffectBox {
  fn noisy(self: i64) -[Log]> i64 {
    Log.hit() + __mem_load64(self)
  }
}

type LambdaEffectRecord {
  v: i64
}

fn apply(f: (i64) -> i64, x: i64) -> i64 {
  f(x)
}

fn apply2(f: (i64, i64) -> i64, x: i64, y: i64) -> i64 {
  f(x, y)
}

fn apply_log(f: (i64) -[Log]> i64, x: i64) -[Log]> i64 {
  f(x)
}

fn apply_log_record(f: (i64) -[Log]> LambdaEffectRecord, x: i64) -[Log]> LambdaEffectRecord {
  f(x)
}

fn apply_log_method(f: (LambdaEffectBox) -[Log]> i64, b: LambdaEffectBox) -[Log]> i64 {
  f(b)
}

fn plain() -> i64 {
  let f = x => x + 1
  apply(f, 41)
}

fn captured() -> i64 {
  let offset = 10
  let f = x => x + offset
  apply(f, 32)
}

fn nested() -> i64 {
  let add = a => b => a + b
  let add10 = add(10)
  apply(add10, 32)
}

fn multi_param() -> i64 {
  let f = (x, y) => x + y
  apply2(f, 20, 22)
}

fn effectful() -[Log]> i64 {
  let f = x => Log.hit() + x
  apply_log(f, 41)
}

fn effectful_record_field() -[Log]> LambdaEffectRecord {
  let f = x => LambdaEffectRecord { v: Log.hit() + x }
  apply_log_record(f, 41)
}

fn effectful_method_call(b: LambdaEffectBox) -[Log]> i64 {
  let f = (x: LambdaEffectBox) => x.noisy()
  apply_log_method(f, b)
}

fn early_return() -> i64 {
  let f = x => {
    if x > 0 { return x + 1 } else { 0 }
    x
  }
  apply(f, 41)
}
