-- test/direct_branch_lowering_metrics.weft -- native evidence for cmp + branch condition lowering
--
-- Compare/branch fusion requires a comparison with one branch user. Boolean
-- values needed elsewhere must still be materialized. Counter/window reuse
-- is measured separately and remains zero where native lowering has no
-- corresponding register-placement proof.

use compiler/codegen.{*}
use compiler/typeck.{*}
use compiler/macho.{*}
use compiler/object.{*}
use compiler/ir.{*}
use compiler/pipeline.{*}
use module_fixtures/compiler_probe.{probe_check_source_with_origin}

fn direct_branch_metric_native(src: str) -> NativeModule {
  let typed = probe_check_source_with_origin(__str_ptr(src), __str_len(src), 1, 0)
  -- Measure native lowering of this probe's explicit function graph.
  pipeline_lower_native_ir(typed)
}

fn direct_branch_metric_count(src: str) -> i64 {
  pipeline_native_direct_branch_lowering_count(direct_branch_metric_native(src))
}

fn direct_branch_metric_counter_reuse(src: str) -> i64 {
  pipeline_native_branch_counter_reuse_count(direct_branch_metric_native(src))
}

fn direct_branch_metric_window_reuse(src: str) -> i64 {
  pipeline_native_register_window_reuse_count(direct_branch_metric_native(src))
}

test "direct_branch_metric_lowers_comparison_variants" {
  -- Dynamic operands: const specimens fold at the optimiser (including
  -- every comparison op now), so params keep the codegen lowering under
  -- test for all six variants.
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a == b { 1 } else { 0 } } fn main() -> i64 { check(1, 1) }"), 1)
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a != b { 1 } else { 0 } } fn main() -> i64 { check(1, 2) }"), 1)
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a < b { 1 } else { 0 } } fn main() -> i64 { check(1, 2) }"), 1)
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a > b { 1 } else { 0 } } fn main() -> i64 { check(2, 1) }"), 1)
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a <= b { 1 } else { 0 } } fn main() -> i64 { check(1, 1) }"), 1)
  Test.assert_eq(direct_branch_metric_count("fn check(a: i64, b: i64) -> i64 { if a >= b { 1 } else { 0 } } fn main() -> i64 { check(2, 1) }"), 1)
}

test "direct_branch_metric_lowers_while_and_nested_if_conditions" {
  let src = "fn main() -> i64 { let mut i = 0 let mut total = 0 while i < 5 { if i == 3 { total = total + 10 } else { total = total + i } i = i + 1 } total }"
  Test.assert_eq(direct_branch_metric_count(src), 2)
}

test "direct_branch_metric_keeps_non_comparison_bool_condition_generic" {
  let src = "fn main() -> i64 { let flag = true if flag { 1 } else { 0 } }"
  Test.assert_eq(direct_branch_metric_count(src), 0)
}

test "direct_branch_metric_keeps_materialized_comparison_value_generic" {
  let src = "fn main() -> i64 { let flag = 1 < 2 if flag { 1 } else { 0 } }"
  Test.assert_eq(direct_branch_metric_count(src), 0)
}

test "direct_branch_metric_lowers_logical_composite_condition_edges" {
  -- Jump threading + chain merging expose each comparison of the
  -- short-circuit form as its own direct compare-branch. Params keep
  -- the condition dynamic (const operands fold the branches away).
  let src = "fn edges(a: i64, b: i64, c: i64) -> i64 { if a < b and b < c { 1 } else { 0 } } fn main() -> i64 { edges(1, 2, 3) }"
  Test.assert_eq(direct_branch_metric_count(src), 2)
}

test "direct_branch_metric_reclaims_comparison_condition_temps" {
  let src = "fn main(a: i64, b: i64) -> i64 { if a + 1 < b + 2 { a + b } else { b - a } }"
  Test.assert_eq(direct_branch_metric_count(src), 1)
  Test.assert_eq(direct_branch_metric_counter_reuse(src), 0)
}

test "direct_branch_metric_reclaims_logical_condition_temps_independently" {
  -- Composite conditions lower as two direct compare-branches after
  -- jump threading + chain merging.
  let src = "fn main(a: i64, b: i64, c: i64) -> i64 { if a + 1 < b + 2 and b + 3 < c + 4 { c } else { a } }"
  Test.assert_eq(direct_branch_metric_count(src), 2)
  Test.assert_eq(direct_branch_metric_counter_reuse(src), 0)
}

test "direct_branch_metric_reclaims_generic_bool_condition_temp" {
  let src = "fn main(flag: bool, x: i64) -> i64 { if flag { x + 1 } else { x - 1 } }"
  Test.assert_eq(direct_branch_metric_count(src), 0)
  Test.assert_eq(direct_branch_metric_counter_reuse(src), 0)
}

test "direct floating branches do not imply counter temporary reuse" {
  let src = "fn main(a: f64, b: f64) -> i64 { if a < b { 1 } else { 0 } }"
  Test.assert_eq(direct_branch_metric_count(src), 1)
  Test.assert_eq(direct_branch_metric_counter_reuse(src), 0)
}

test "direct_branch_metric_reuses_floor_window_with_hidden_outer_temp" {
  let src = "fn main(a: i64, b: i64) -> i64 { let y = a + { let mut i = 0 if i + 1 < b + 2 { i = i + 1 } else { i = i + 2 } i } y + b }"
  Test.assert_eq(direct_branch_metric_count(src), 1)
  Test.assert_eq(direct_branch_metric_window_reuse(src), 0)
}

test "direct_branch_metric_floor_window_falls_back_when_low_counters_hidden" {
  let src = "fn main(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 { let y = a + { let mut i = 0 if i + 1 < h + 2 { i = i + 1 } else { i = i + 2 } i } y + b + c + d + e + f + g + h }"
  Test.assert_eq(direct_branch_metric_count(src), 1)
  Test.assert_eq(direct_branch_metric_window_reuse(src), 0)
}

fn direct_branch_floor_window_runtime(a: i64, b: i64) -> i64 {
  let y = a + {
    let mut i = 0
    if i + 1 < b + 2 {
      i = i + 1
    } else {
      i = i + 2
    }
    i
  }
  y + b
}

test "direct_branch_runtime_floor_window_preserves_outer_temp" {
  Test.assert_eq(direct_branch_floor_window_runtime(10, 20), 31)
}

test "direct_branch_runtime_evaluates_operands_once" {
  let mut n = 0
  if { n = n + 1 n } < { n = n + 1 n } {
    Test.assert_eq(n, 2)
  } else {
    Test.assert_eq(0, 1)
  }
  Test.assert_eq(n, 2)
}

fn branch_use_blocks(extra: IrInstList, second: IrTerminator) -> IrBlockList {
  IrBlockListCons(IrBlock(0, IrValueNil,
    IrInstCons(IrBinaryI64(2, IrLt, 0, 1), IrInstNil), IrTermBranch(2, 1, 2)),
  IrBlockListCons(IrBlock(1, IrValueNil, extra, second),
  IrBlockListCons(IrBlock(2, IrValueNil, IrInstNil, IrTermReturn(0)),
  IrBlockListCons(IrBlock(3, IrValueCons(11, IrValueNil), IrInstNil, IrTermReturn(11)), IrBlockListNil))))
}

test "comparison materialization follows complete branch and value users" {
  let comparison = IrInstCons(IrBinaryI64(2, IrLt, 0, 1), IrInstNil)
  let term = IrTermBranch(2, 1, 2)
  let alone = pipeline_ir_value_use_facts(branch_use_blocks(IrInstNil, IrTermReturn(1)))
  Test.assert_true(pipeline_ir_value_has_single_branch_use(alone, 2))
  Test.assert_true(not pipeline_ir_value_has_single_branch_use(alone, 99))
  Test.assert_true(match pipeline_ir_native_direct_branch_cmp_info_with_uses(comparison, term, alone) {
    IrComparison(2, IrLt, 0, 1, IrComparisonSigned) -> true
    _ -> false
  })

  let reused = pipeline_ir_value_use_facts(branch_use_blocks(IrInstNil, IrTermBranch(2, 2, 0)))
  Test.assert_true(not pipeline_ir_value_has_single_branch_use(reused, 2))
  Test.assert_true(match pipeline_ir_native_direct_branch_cmp_info_with_uses(comparison, term, reused) {
    IrNotComparison -> true
    _ -> false
  })
  let returned = pipeline_ir_value_use_facts(branch_use_blocks(IrInstNil, IrTermReturn(2)))
  Test.assert_true(not pipeline_ir_value_has_single_branch_use(returned, 2))
  let transported = pipeline_ir_value_use_facts(branch_use_blocks(IrInstNil, IrTermJump(3, IrValueCons(2, IrValueNil))))
  Test.assert_true(not pipeline_ir_value_has_single_branch_use(transported, 2))
}

test "instruction users keep comparison values materialized" {
  let users = IrInstCons(IrStoreI64(8, 2),
    IrInstCons(IrCallI64(9, 42, IrValueCons(2, IrValueNil)),
    IrInstCons(IrReturnLaneI64(1, 2),
    IrInstCons(IrBinaryI64(10, IrEq, 2, 2), IrInstNil))))
  let mut remaining = users
  let mut walking = true
  while walking {
    match remaining {
      IrInstNil -> { walking = false }
      IrInstCons(inst, rest) -> {
        let facts = pipeline_ir_value_use_facts(branch_use_blocks(IrInstCons(inst, IrInstNil), IrTermReturn(0)))
        Test.assert_true(not pipeline_ir_value_has_single_branch_use(facts, 2))
        remaining = rest
      }
    }
  }
}
