test "generator_generic_send_values_resume_producer" {
  let g = generator_new<i64, i64>(generator_generic_named_send)
  let first = generator_next<i64, i64>(g)
  let done = generator_send<i64, i64>(g, 40)
  Test.assert_eq(generator_generic_next_value_or<i64>(first, 0), 12)
