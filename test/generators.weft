  let mut g = generator.start<i64, i64>(generator_generic_named_single)
  let first = g.next()
  let done = g.next()
  Test.assert_eq(first.unwrap_or(0), 14)
  Test.assert_true(done.is_none())
  Test.assert_eq(g.result().unwrap(), 28)
}

test "generator_generic_multiple_yields_preserve_order" {
  let mut g = generator.start<i64, i64>(generator_generic_named_many)
  let a = g.next()
  let b = g.next()
  let c = g.next()
  let done = g.next()
  Test.assert_eq(a.unwrap_or(0), 2)
  Test.assert_eq(b.unwrap_or(0), 5)
  Test.assert_eq(c.unwrap_or(0), 8)
  Test.assert_true(done.is_none())
  Test.assert_eq(g.result().unwrap(), 11)
}

test "generator_generic_mutable_literal_before_yield_uses_spilled_packet" {
  let mut g = generator.start<i64, i64>(() => {
    let mut i = 2
    generator.yield<i64>(i)
    i = i + 3
    i
  })
  let first = g.next()
  let done = g.next()
  Test.assert_eq(first.unwrap_or(0), 2)
  Test.assert_true(done.is_none())
  Test.assert_eq(g.result().unwrap(), 5)
}

test "generator_generic_mutable_loop_literal_preserves_order" {
  let mut g = generator.start<i64, i64>(() => {
    let mut i = 1
    while i < 5 {
      generator.yield<i64>(i)
      i = i + 1
    }
    i
  })
  let a = g.next()
  let b = g.next()
  let c = g.next()
  let d = g.next()
  let done = g.next()
  Test.assert_eq(a.unwrap_or(0), 1)
  Test.assert_eq(b.unwrap_or(0), 2)
  Test.assert_eq(c.unwrap_or(0), 3)
  Test.assert_eq(d.unwrap_or(0), 4)
  Test.assert_true(done.is_none())
  Test.assert_eq(g.result().unwrap(), 5)
}

