test "generator_generic_mutable_loop_literal_preserves_order" {
  let g = generator_new<i64, i64>(() => {
    let mut i = 1
    while i < 5 {
      generator_yield<i64>(i)
      i = i + 1
    }
    i
  })
  let a = generator_next<i64, i64>(g)
  let b = generator_next<i64, i64>(g)
  let c = generator_next<i64, i64>(g)
  let d = generator_next<i64, i64>(g)
  let done = generator_next<i64, i64>(g)
  Test.assert_eq(a.unwrap_or(0), 1)
  Test.assert_eq(b.unwrap_or(0), 2)
  Test.assert_eq(c.unwrap_or(0), 3)
  Test.assert_eq(d.unwrap_or(0), 4)
  Test.assert_true(done.is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 5)
}

