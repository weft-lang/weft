use "stdlib/generator.weft"
use "test/fixtures/generator_imported_producer.weft"
use "runtime/rc.weft"

fn generator_next_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let g = generator_i64_new(() => 99)
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
    1 -> {
      let g = generator_i64_new(() => {
        generator_yield_i64(23)
        0
      })
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
    _ -> {
      let g = generator_i64_new(() => {
        generator_yield_i64(0 - 5)
        0
      })
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
  }
}

fn generator_next_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 117
    1 -> 23
    _ -> 0 - 5
  }
}

fn generator_named_empty() -> i64 {
  77
}

fn generator_named_single() -[GeneratorYield]> i64 {
  generator_yield_i64(11)
  22
}

fn generator_named_many() -[GeneratorYield]> i64 {
  generator_yield_i64(1)
  generator_yield_i64(4)
  generator_yield_i64(9)
  16
}

fn generator_named_send() -[GeneratorYield]> i64 {
  let sent = generator_yield_i64(30)
  sent + 5
}

fn generator_named_inner() -[GeneratorYield]> i64 {
  generator_yield_i64(13)
  17
}

fn generator_named_wrapper() -[GeneratorYield]> i64 {
  generator_named_inner() + 2
}

fn generator_closure_helper(base: i64) -[GeneratorYield]> i64 {
  generator_yield_i64(base)
  base + 2
}

test "generator_empty_producer_finishes_at_creation" {
  let g = generator_i64_new(() => 42)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  let first = generator_i64_next(g)
  let second = generator_i64_next(g)
  Test.assert_eq(generator_next_is_done(first), 1)
  Test.assert_eq(generator_next_is_done(second), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 42)
  Test.assert_eq(generator_i64_drop(g), 0)
}

test "generator_single_yield_then_result" {
  let g = generator_i64_new(() => {
    generator_yield_i64(7)
    42
  })
  Test.assert_eq(generator_i64_has_current(g), 1)
  Test.assert_eq(generator_i64_is_done(g), 0)
  let first = generator_i64_next(g)
  let second = generator_i64_next(g)
  Test.assert_eq(generator_next_is_done(first), 0)
  Test.assert_eq(generator_next_value_or(first, 0), 7)
  Test.assert_eq(generator_next_is_done(second), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 42)
}

test "generator_multiple_yields_preserve_order" {
  let g = generator_i64_new(() => {
    generator_yield_i64(1)
    generator_yield_i64(2)
    generator_yield_i64(3)
    99
  })
  let a = generator_i64_next(g)
  let b = generator_i64_next(g)
  let c = generator_i64_next(g)
  let done = generator_i64_next(g)
  let again = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(a, 0), 1)
  Test.assert_eq(generator_next_value_or(b, 0), 2)
  Test.assert_eq(generator_next_value_or(c, 0), 3)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_next_is_done(again), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 99)
}

test "generator_send_values_resume_producer" {
  let g = generator_i64_new(() => {
    let a = generator_yield_i64(10)
    let b = generator_yield_i64(a + 1)
    b + 2
  })
  let first = generator_i64_next(g)
  let second = generator_i64_send(g, 20)
  let done = generator_i64_send(g, 30)
  let again = generator_i64_send(g, 40)
  Test.assert_eq(generator_next_value_or(first, 0), 10)
  Test.assert_eq(generator_next_value_or(second, 0), 21)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_next_is_done(again), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 32)
}

test "generator_drop_pending_continuation" {
  let g = generator_i64_new(() => {
    generator_yield_i64(5)
    88
  })
  Test.assert_eq(generator_i64_has_current(g), 1)
  let dropped = generator_i64_drop(g)
  let next = generator_i64_next(g)
  Test.assert_eq(dropped, 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_next_is_done(next), 1)
}

test "generator_next_variant_helper_matrix" {
  for row in 0..3 {
    Test.assert_eq(generator_next_matrix_case(row), generator_next_matrix_expected(row))
  }
}

test "generator_named_empty_function_finishes_at_creation" {
  let g = generator_i64_new(generator_named_empty)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  Test.assert_eq(generator_i64_result_or(g, 0), 77)
  Test.assert_eq(generator_next_is_done(generator_i64_next(g)), 1)
}

test "generator_named_function_single_yield_then_result" {
  let g = generator_i64_new(generator_named_single)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(first, 0), 11)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 22)
}

test "generator_named_function_multiple_yields_preserve_order" {
  let g = generator_i64_new(generator_named_many)
  let a = generator_i64_next(g)
  let b = generator_i64_next(g)
  let c = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(a, 0), 1)
  Test.assert_eq(generator_next_value_or(b, 0), 4)
  Test.assert_eq(generator_next_value_or(c, 0), 9)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 16)
}

test "generator_named_function_send_values_resume_producer" {
  let g = generator_i64_new(generator_named_send)
  let first = generator_i64_next(g)
  let done = generator_i64_send(g, 40)
  Test.assert_eq(generator_next_value_or(first, 0), 30)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 45)
}

test "generator_named_function_calls_yielding_helper" {
  let g = generator_i64_new(generator_named_wrapper)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(first, 0), 13)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 19)
}

test "generator_imported_named_function_producer" {
  let g = generator_i64_new(generator_imported_producer)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(first, 0), 21)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 34)
}

test "generator_local_closure_empty_finishes_at_creation" {
  let producer = () => 58
  let g = generator_i64_new(producer)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  Test.assert_eq(generator_i64_result_or(g, 0), 58)
  Test.assert_eq(generator_next_is_done(generator_i64_next(g)), 1)
}

test "generator_local_closure_send_values_resume_producer" {
  let producer = () => {
    let sent = generator_yield_i64(6)
    sent + 7
  }
  let g = generator_i64_new(producer)
  let first = generator_i64_next(g)
  let done = generator_i64_send(g, 8)
  Test.assert_eq(generator_next_value_or(first, 0), 6)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 15)
}

test "generator_local_closure_captures_shadowed_i64" {
  let base = 31
  let producer = () => {
    generator_yield_i64(base)
    base + 1
  }
  let base = 90
  let g = generator_i64_new(producer)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(base, 90)
  Test.assert_eq(generator_next_value_or(first, 0), 31)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 32)
}

test "generator_local_closure_calls_yielding_helper" {
  let base = 41
  let producer = () => generator_closure_helper(base)
  let g = generator_i64_new(producer)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(first, 0), 41)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 43)
}

test "generator_local_closure_captures_rc_across_yield" {
  let p: rc i64 = rc_default_alloc(8, 8)
  __mem_store64(p, 56)
  let producer = () => {
    generator_yield_i64(__mem_load64(p))
    __mem_load64(p) + 1
  }
  let g = generator_i64_new(producer)
  let first = generator_i64_next(g)
  let done = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(first, 0), 56)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 57)
}
