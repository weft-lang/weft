test "generator_generic_bool_yield" {
  let g = generator_new<bool, i64>(generator_generic_named_bool)
  let first = generator_next<bool, i64>(g)
  let done = generator_next<bool, i64>(g)
  Test.assert_eq(if generator_generic_next_value_or<bool>(first, false) { 1 } else { 0 }, 1)
  Test.assert_eq(generator_generic_next_is_done<bool>(done), 1)
  Test.assert_eq(generator_result_or<bool, i64>(g, 0), 1)
}

test "generator_generic_bool_false_yield" {
  let g = generator_new<bool, i64>(() => {
    generator_yield<bool>(false)
    generator_yield<bool>(true)
    2
  })
  let first = generator_next<bool, i64>(g)
  let second = generator_next<bool, i64>(g)
  let done = generator_next<bool, i64>(g)
  Test.assert_eq(if generator_generic_next_value_or<bool>(first, true) { 1 } else { 0 }, 0)
  Test.assert_eq(if generator_generic_next_value_or<bool>(second, false) { 1 } else { 0 }, 1)
  Test.assert_eq(generator_generic_next_is_done<bool>(done), 1)
  Test.assert_eq(generator_result_or<bool, i64>(g, 0), 2)
}

test "generator_generic_bool_result" {
  let g = generator_new<i64, bool>(generator_generic_named_bool_result)
  let first = generator_next<i64, bool>(g)
  let done = generator_next<i64, bool>(g)
  Test.assert_eq(generator_generic_next_value_or<i64>(first, 0), 6)
  Test.assert_eq(generator_generic_next_is_done<i64>(done), 1)
  Test.assert_eq(if generator_result_or<i64, bool>(g, false) { 1 } else { 0 }, 1)
}

test "generator_generic_rc_result_retained_until_drop" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result)
  let default: RuntimeRcProbe = runtime_rc_probe_new(0)
  let result: RuntimeRcProbe = generator_result_or<i64, RuntimeRcProbe>(g, default)
  Test.assert_eq(runtime_rc_probe_load(result), 88)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
  Test.assert_eq(generator_drop<i64, RuntimeRcProbe>(g), 0)
  Test.assert_eq(runtime_rc_probe_count(result), 1)
}

test "generator_generic_rc_result_or_retains_each_read" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result)
  let default1: RuntimeRcProbe = runtime_rc_probe_new(0)
  let result1: RuntimeRcProbe = generator_result_or<i64, RuntimeRcProbe>(g, default1)
  let default2: RuntimeRcProbe = runtime_rc_probe_new(0)
  let result2: RuntimeRcProbe = generator_result_or<i64, RuntimeRcProbe>(g, default2)
  Test.assert_eq(runtime_rc_probe_load(result2), 88)
  Test.assert_eq(runtime_rc_probe_count(result1), 3)
  Test.assert_eq(generator_drop<i64, RuntimeRcProbe>(g), 0)
  Test.assert_eq(runtime_rc_probe_count(result1), 2)
}

test "generator_generic_rc_result_or_pending_returns_retained_default" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result_after_yield)
  let default: RuntimeRcProbe = runtime_rc_probe_new(7)
  let result: RuntimeRcProbe = generator_result_or<i64, RuntimeRcProbe>(g, default)
  Test.assert_eq(runtime_rc_probe_load(result), 7)
  Test.assert_eq(runtime_rc_probe_count(default), 2)
  Test.assert_eq(generator_drop<i64, RuntimeRcProbe>(g), 1)
  Test.assert_eq(runtime_rc_probe_count(default), 2)
}

test "generator_generic_rc_yield_drop_releases_buffered_current" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(35)
  let producer = () => {
    generator_yield<RuntimeRcProbe>(p)
    0
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  Test.assert_eq(runtime_rc_probe_count(p), 3)
  Test.assert_eq(generator_drop<RuntimeRcProbe, i64>(g), 1)
  Test.assert_eq(runtime_rc_probe_count(p), 2)
}

test "generator_generic_rc_yield_next_transfers_current_then_cleans_producer" {
  let g = generator_new<RuntimeRcProbe, i64>(generator_generic_named_rc_yield_owned)
  let first = generator_next<RuntimeRcProbe, i64>(g)
  let value: RuntimeRcProbe = generator_generic_next_value_or<RuntimeRcProbe>(first, runtime_rc_probe_new(0))
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  -- 2q slice 2 count contract: call results are owned — the extractor
  -- returns value with its own count on top of the packet's stake. The
  -- end-to-end churn shape is arena-flat (gen_flat probe).
  Test.assert_eq(runtime_rc_probe_count(value), 3)
  let done = generator_next<RuntimeRcProbe, i64>(g)
  Test.assert_eq(generator_generic_next_is_done<RuntimeRcProbe>(done), 1)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  Test.assert_eq(generator_drop<RuntimeRcProbe, i64>(g), 0)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "generator_generic_local_closure_captures_shadowed_i64" {
  let base = 71
  let producer = () => {
    generator_yield<i64>(base)
    base + 2
  }
  let base = 4
  let g = generator_new<i64, i64>(producer)
  let first = generator_next<i64, i64>(g)
  let done = generator_next<i64, i64>(g)
  Test.assert_eq(base, 4)
  Test.assert_eq(generator_generic_next_value_or<i64>(first, 0), 71)
  Test.assert_eq(generator_generic_next_is_done<i64>(done), 1)
  Test.assert_eq(generator_result_or<i64, i64>(g, 0), 73)
}

test "generator_generic_local_closure_calls_yielding_helper" {
  let base = 51
  let producer = () => generator_generic_closure_helper(base)
  let g = generator_new<i64, i64>(producer)
  let first = generator_next<i64, i64>(g)
  let done = generator_next<i64, i64>(g)
  Test.assert_eq(generator_generic_next_value_or<i64>(first, 0), 51)
  Test.assert_eq(generator_generic_next_is_done<i64>(done), 1)
  Test.assert_eq(generator_result_or<i64, i64>(g, 0), 55)
}

test "generator_generic_drop_pending_continuation" {
  let g = generator_new<bool, i64>(() => {
    generator_yield<bool>(true)
    64
  })
  Test.assert_eq(generator_has_current<bool, i64>(g), 1)
  let dropped = generator_drop<bool, i64>(g)
  let next = generator_next<bool, i64>(g)
  Test.assert_eq(dropped, 1)
  Test.assert_eq(generator_has_current<bool, i64>(g), 0)
  Test.assert_eq(generator_is_done<bool, i64>(g), 1)
  Test.assert_eq(generator_generic_next_is_done<bool>(next), 1)
}

test "generator_generic_next_variant_helper_matrix" {
  for row in 0..3 {
    Test.assert_eq(generator_generic_matrix_case(row), generator_generic_matrix_expected(row))
  }
}
