use runtime/memory.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}
use test/fixtures/generator_imported_producer.{*}
use test/module_fixtures/generator_start_lookalike as generator_start_lookalike
use runtime/rc_implicit_test.{*}

fn generator_named_empty() -> i64 {
  77
}

fn generator_named_single() -[GeneratorYield]> i64 {
  generator.yield<i64>(11)
  22
}

fn generator_named_many() -[GeneratorYield]> i64 {
  generator.yield<i64>(1)
  generator.yield<i64>(4)
  generator.yield<i64>(9)
  16
}

fn generator_named_mutable_before_yield() -[GeneratorYield]> i64 {
  let mut i = 4
  generator.yield<i64>(i)
  i = i + 3
  i
}

fn generator_named_after_yield() -[GeneratorYield]> i64 {
  generator.yield<i64>(30)
  45
}

fn generator_named_inner() -[GeneratorYield]> i64 {
  generator.yield<i64>(13)
  17
}

fn generator_named_wrapper() -[GeneratorYield]> i64 {
  generator_named_inner() + 2
}

fn generator_deep_recursive_inner(depth: i64) -[GeneratorYield]> i64 {
  if depth == 0 {
    generator.yield<i64>(42)
    0
  } else {
    generator_deep_recursive_inner(depth - 1)
  }
}

fn generator_deep_recursive() -[GeneratorYield]> i64 {
  generator_deep_recursive_inner(40)
}

fn generator_closure_helper(base: i64) -[GeneratorYield]> i64 {
  generator.yield<i64>(base)
  base + 2
}

fn generator_generic_named_single() -[GeneratorYield]> i64 {
  generator.yield<i64>(14)
  28
}

fn generator_generic_named_many() -[GeneratorYield]> i64 {
  generator.yield<i64>(2)
  generator.yield<i64>(5)
  generator.yield<i64>(8)
  11
}

fn generator_generic_named_mutable_before_yield() -[GeneratorYield]> i64 {
  let mut i = 6
  generator.yield<i64>(i)
  i = i + 5
  i
}

fn generator_generic_named_bool() -[GeneratorYield]> i64 {
  generator.yield<bool>(true)
  1
}

fn generator_generic_named_bool_result() -[GeneratorYield]> bool {
  generator.yield<i64>(6)
  true
}

fn generator_generic_named_rc_result() -[GeneratorYield]> RuntimeRcProbe {
  let p: RuntimeRcProbe = runtime_rc_probe_new(88)
  p
}

fn generator_generic_named_rc_result_after_yield() -[GeneratorYield]> RuntimeRcProbe {
  generator.yield<i64>(5)
  let p: RuntimeRcProbe = runtime_rc_probe_new(99)
  p
}

fn generator_generic_named_rc_yield_owned() -[GeneratorYield]> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(44)
  generator.yield<RuntimeRcProbe>(p)
  0
}

fn generator_generic_named_after_yield() -[GeneratorYield]> i64 {
  generator.yield<i64>(12)
  43
}

fn generator_generic_closure_helper(base: i64) -[GeneratorYield]> i64 {
  generator.yield<i64>(base)
  base + 4
}

fn generator_generic_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let mut g = generator.start<i64, i64>(() => 33)
      let next = g.next()
      (if next.is_none() { 100 } else { 0 }) + g.result().unwrap()
    }
    1 -> {
      let mut g = generator.start<i64, i64>(generator_generic_named_single)
      let next = g.next()
      next.unwrap_or(0)
    }
    _ -> {
      let mut g = generator.start<bool, i64>(generator_generic_named_bool)
      let next = g.next()
      if next.unwrap_or(false) { 1 } else { 0 }
    }
  }
}

fn generator_generic_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 133
    1 -> 14
    _ -> 1
  }
}

test "generator producer validation uses exact declaration identity" {
  Test.assert_eq(generator_start_lookalike.start<i64, str>(41), 41)
}

test "generator_empty_producer_finishes_at_creation" {
  let mut g = generator.start<i64, i64>(() => 42)
  Test.assert_true(g.is_done())
  Test.assert_false(g.has_current())
  Test.assert_true(g.next().is_none())
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 42)
  g.close()
}

test "generator_single_yield_then_result" {
  let mut g = generator.start<i64, i64>(() => {
    generator.yield<i64>(7)
    42
  })
  Test.assert_true(g.has_current())
  Test.assert_false(g.is_done())
  let first = g.next()
  let second = g.next()
  Test.assert_eq(first.unwrap_or(0), 7)
  Test.assert_true(second.is_none())
  Test.assert_eq(g.result().unwrap(), 42)
}

test "generator_multiple_yields_preserve_order" {
  let mut g = generator.start<i64, i64>(() => {
    generator.yield<i64>(1)
    generator.yield<i64>(2)
    generator.yield<i64>(3)
    99
  })
  Test.assert_eq(g.next().unwrap_or(0), 1)
  Test.assert_eq(g.next().unwrap_or(0), 2)
  Test.assert_eq(g.next().unwrap_or(0), 3)
  Test.assert_true(g.next().is_none())
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 99)
}

test "generator_mutable_literal_before_yield_uses_spilled_packet" {
  let mut g = generator.start<i64, i64>(() => {
    let mut i = 1
    generator.yield<i64>(i)
    i = i + 1
    i
  })
  Test.assert_eq(g.next().unwrap_or(0), 1)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 2)
}

test "generator_mutable_loop_literal_preserves_order" {
  let mut g = generator.start<i64, i64>(() => {
    let mut i = 1
    while i < 4 {
      generator.yield<i64>(i)
      i = i + 1
    }
    i
  })
  Test.assert_eq(g.next().unwrap_or(0), 1)
  Test.assert_eq(g.next().unwrap_or(0), 2)
  Test.assert_eq(g.next().unwrap_or(0), 3)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 4)
}

test "generator_next_resumes_producer" {
  let mut g = generator.start<i64, i64>(() => {
    generator.yield<i64>(10)
    generator.yield<i64>(21)
    32
  })
  Test.assert_eq(g.next().unwrap_or(0), 10)
  Test.assert_eq(g.next().unwrap_or(0), 21)
  Test.assert_true(g.next().is_none())
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 32)
}

test "generator_drop_pending_continuation" {
  let mut g = generator.start<i64, i64>(() => {
    generator.yield<i64>(5)
    88
  })
  Test.assert_true(g.has_current())
  g.close()
}

