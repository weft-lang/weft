use "stdlib/generator.weft"

fn generator_next_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let g = generator_i64_new(() => 99)
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
    1 -> {
      let g = generator_i64_new(() => {
        generator_yield_i64(23)
        0
      })
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
    _ -> {
      let g = generator_i64_new(() => {
        generator_yield_i64(0 - 5)
        0
      })
      let next = generator_i64_next(g)
      generator_next_is_done(next) * 100 + generator_next_value_or(next, 17)
    }
  }
}

fn generator_next_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 117
    1 -> 23
    _ -> 0 - 5
  }
}

test "generator_empty_producer_finishes_at_creation" {
  let g = generator_i64_new(() => 42)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  let first = generator_i64_next(g)
  let second = generator_i64_next(g)
  Test.assert_eq(generator_next_is_done(first), 1)
  Test.assert_eq(generator_next_is_done(second), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 42)
  Test.assert_eq(generator_i64_drop(g), 0)
}

test "generator_single_yield_then_result" {
  let g = generator_i64_new(() => {
    generator_yield_i64(7)
    42
  })
  Test.assert_eq(generator_i64_has_current(g), 1)
  Test.assert_eq(generator_i64_is_done(g), 0)
  let first = generator_i64_next(g)
  let second = generator_i64_next(g)
  Test.assert_eq(generator_next_is_done(first), 0)
  Test.assert_eq(generator_next_value_or(first, 0), 7)
  Test.assert_eq(generator_next_is_done(second), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 42)
}

test "generator_multiple_yields_preserve_order" {
  let g = generator_i64_new(() => {
    generator_yield_i64(1)
    generator_yield_i64(2)
    generator_yield_i64(3)
    99
  })
  let a = generator_i64_next(g)
  let b = generator_i64_next(g)
  let c = generator_i64_next(g)
  let done = generator_i64_next(g)
  let again = generator_i64_next(g)
  Test.assert_eq(generator_next_value_or(a, 0), 1)
  Test.assert_eq(generator_next_value_or(b, 0), 2)
  Test.assert_eq(generator_next_value_or(c, 0), 3)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_next_is_done(again), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 99)
}

test "generator_send_values_resume_producer" {
  let g = generator_i64_new(() => {
    let a = generator_yield_i64(10)
    let b = generator_yield_i64(a + 1)
    b + 2
  })
  let first = generator_i64_next(g)
  let second = generator_i64_send(g, 20)
  let done = generator_i64_send(g, 30)
  let again = generator_i64_send(g, 40)
  Test.assert_eq(generator_next_value_or(first, 0), 10)
  Test.assert_eq(generator_next_value_or(second, 0), 21)
  Test.assert_eq(generator_next_is_done(done), 1)
  Test.assert_eq(generator_next_is_done(again), 1)
  Test.assert_eq(generator_i64_result_or(g, 0), 32)
}

test "generator_drop_pending_continuation" {
  let g = generator_i64_new(() => {
    generator_yield_i64(5)
    88
  })
  Test.assert_eq(generator_i64_has_current(g), 1)
  let dropped = generator_i64_drop(g)
  let next = generator_i64_next(g)
  Test.assert_eq(dropped, 1)
  Test.assert_eq(generator_i64_has_current(g), 0)
  Test.assert_eq(generator_i64_is_done(g), 1)
  Test.assert_eq(generator_next_is_done(next), 1)
}

test "generator_next_variant_helper_matrix" {
  for row in 0..3 {
    Test.assert_eq(generator_next_matrix_case(row), generator_next_matrix_expected(row))
  }
}
