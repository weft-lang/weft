use runtime/memory.{*}
use stdlib/generator.{*}
use stdlib/option.{*}
use test/fixtures/generator_imported_producer.{*}
use runtime/rc_implicit_test.{*}

fn generator_named_empty() -> i64 {
  77
}

fn generator_named_single() -[GeneratorYield]> i64 {
  generator_yield<i64>(11)
  22
}

fn generator_named_many() -[GeneratorYield]> i64 {
  generator_yield<i64>(1)
  generator_yield<i64>(4)
  generator_yield<i64>(9)
  16
}

fn generator_named_mutable_before_yield() -[GeneratorYield]> i64 {
  let mut i = 4
  generator_yield<i64>(i)
  i = i + 3
  i
}

fn generator_named_send() -[GeneratorYield]> i64 {
  let sent = generator_yield<i64>(30)
  sent + 5
}

fn generator_named_inner() -[GeneratorYield]> i64 {
  generator_yield<i64>(13)
  17
}

fn generator_named_wrapper() -[GeneratorYield]> i64 {
  generator_named_inner() + 2
}

fn generator_deep_recursive_inner(depth: i64) -[GeneratorYield]> i64 {
  if depth == 0 {
    generator_yield<i64>(42)
  } else {
    generator_deep_recursive_inner(depth - 1)
  }
}

fn generator_deep_recursive() -[GeneratorYield]> i64 {
  generator_deep_recursive_inner(40)
}

fn generator_closure_helper(base: i64) -[GeneratorYield]> i64 {
  generator_yield<i64>(base)
  base + 2
}

fn generator_generic_named_single() -[GeneratorYield]> i64 {
  generator_yield<i64>(14)
  28
}

fn generator_generic_named_many() -[GeneratorYield]> i64 {
  generator_yield<i64>(2)
  generator_yield<i64>(5)
  generator_yield<i64>(8)
  11
}

fn generator_generic_named_mutable_before_yield() -[GeneratorYield]> i64 {
  let mut i = 6
  generator_yield<i64>(i)
  i = i + 5
  i
}

fn generator_generic_named_bool() -[GeneratorYield]> i64 {
  generator_yield<bool>(true)
  1
}

fn generator_generic_named_bool_result() -[GeneratorYield]> bool {
  generator_yield<i64>(6)
  true
}

fn generator_generic_named_rc_result() -[GeneratorYield]> RuntimeRcProbe {
  let p: RuntimeRcProbe = runtime_rc_probe_new(88)
  p
}

fn generator_generic_named_rc_result_after_yield() -[GeneratorYield]> RuntimeRcProbe {
  generator_yield<i64>(5)
  let p: RuntimeRcProbe = runtime_rc_probe_new(99)
  p
}

fn generator_generic_named_rc_yield_owned() -[GeneratorYield]> i64 {
  let p: RuntimeRcProbe = runtime_rc_probe_new(44)
  generator_yield<RuntimeRcProbe>(p)
  0
}

fn generator_generic_named_send() -[GeneratorYield]> i64 {
  let sent = generator_yield<i64>(12)
  sent + 3
}

fn generator_generic_closure_helper(base: i64) -[GeneratorYield]> i64 {
  generator_yield<i64>(base)
  base + 4
}

fn generator_generic_matrix_case(row: i64) -> i64 {
  match row {
    0 -> {
      let g = generator_new<i64, i64>(() => 33)
      let next = generator_next<i64, i64>(g)
      (if next.is_none() { 100 } else { 0 }) + generator_result<i64, i64>(g).unwrap()
    }
    1 -> {
      let g = generator_new<i64, i64>(generator_generic_named_single)
      let next = generator_next<i64, i64>(g)
      next.unwrap_or(0)
    }
    _ -> {
      let g = generator_new<bool, i64>(generator_generic_named_bool)
      let next = generator_next<bool, i64>(g)
      if next.unwrap_or(false) { 1 } else { 0 }
    }
  }
}

fn generator_generic_matrix_expected(row: i64) -> i64 {
  match row {
    0 -> 133
    1 -> 14
    _ -> 1
  }
}

test "generator_empty_producer_finishes_at_creation" {
  let g = generator_new<i64, i64>(() => 42)
  Test.assert_true(generator_is_done<i64, i64>(g))
  Test.assert_false(generator_has_current<i64, i64>(g))
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 42)
  generator_drop<i64, i64>(g)
}

test "generator_single_yield_then_result" {
  let g = generator_new<i64, i64>(() => {
    generator_yield<i64>(7)
    42
  })
  Test.assert_true(generator_has_current<i64, i64>(g))
  Test.assert_false(generator_is_done<i64, i64>(g))
  let first = generator_next<i64, i64>(g)
  let second = generator_next<i64, i64>(g)
  Test.assert_eq(first.unwrap_or(0), 7)
  Test.assert_true(second.is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 42)
}

test "generator_multiple_yields_preserve_order" {
  let g = generator_new<i64, i64>(() => {
    generator_yield<i64>(1)
    generator_yield<i64>(2)
    generator_yield<i64>(3)
    99
  })
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 1)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 2)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 3)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 99)
}

test "generator_mutable_literal_before_yield_uses_spilled_packet" {
  let g = generator_new<i64, i64>(() => {
    let mut i = 1
    generator_yield<i64>(i)
    i = i + 1
    i
  })
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 1)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 2)
}

test "generator_mutable_loop_literal_preserves_order" {
  let g = generator_new<i64, i64>(() => {
    let mut i = 1
    while i < 4 {
      generator_yield<i64>(i)
      i = i + 1
    }
    i
  })
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 1)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 2)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 3)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 4)
}

test "generator_send_values_resume_producer" {
  let g = generator_new<i64, i64>(() => {
    let a = generator_yield<i64>(10)
    let b = generator_yield<i64>(a + 1)
    b + 2
  })
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 10)
  Test.assert_eq(generator_send<i64, i64>(g, 20).unwrap_or(0), 21)
  Test.assert_true(generator_send<i64, i64>(g, 30).is_none())
  Test.assert_true(generator_send<i64, i64>(g, 40).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 32)
}

test "generator_drop_pending_continuation" {
  let g = generator_new<i64, i64>(() => {
    generator_yield<i64>(5)
    88
  })
  Test.assert_true(generator_has_current<i64, i64>(g))
  generator_drop<i64, i64>(g)
  Test.assert_false(generator_has_current<i64, i64>(g))
  Test.assert_true(generator_is_done<i64, i64>(g))
  Test.assert_true(generator_next<i64, i64>(g).is_none())
}

test "generator_named_empty_function_finishes_at_creation" {
  let g = generator_new<i64, i64>(generator_named_empty)
  Test.assert_true(generator_is_done<i64, i64>(g))
  Test.assert_false(generator_has_current<i64, i64>(g))
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 77)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
}

