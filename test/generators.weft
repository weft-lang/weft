test "generator_local_closure_captures_shadowed_i64" {
  let base = 31
  let producer = () => {
    generator_yield<i64>(base)
    base + 1
  }
  let base = 90
  let g = generator_new<i64, i64>(producer)
  Test.assert_eq(base, 90)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 31)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 32)
}

test "generator_local_closure_calls_yielding_helper" {
  let base = 41
  let producer = () => generator_closure_helper(base)
  let g = generator_new<i64, i64>(producer)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 41)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 43)
}

test "generator_local_closure_captures_rc_across_yield" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(56)
  let producer = () => {
    generator_yield<i64>(runtime_rc_probe_load(p))
    runtime_rc_probe_load(p) + 1
  }
  let g = generator_new<i64, i64>(producer)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 56)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 57)
}

