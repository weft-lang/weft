  let producer = () => 58
  let g = generator_new<i64, i64>(producer)
  Test.assert_true(generator_is_done<i64, i64>(g))
  Test.assert_false(generator_has_current<i64, i64>(g))
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 58)
  Test.assert_true(generator_next<i64, i64>(g).is_none())
}

test "generator_local_closure_send_values_resume_producer" {
  let producer = () => {
    let sent = generator_yield<i64>(6)
    sent + 7
  }
  let g = generator_new<i64, i64>(producer)
  Test.assert_eq(generator_next<i64, i64>(g).unwrap_or(0), 6)
  Test.assert_true(generator_send<i64, i64>(g, 8).is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 15)
