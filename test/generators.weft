  let mut g = generator.start<i64, i64>(generator_deep_recursive)
  Test.assert_eq(g.next().unwrap_or(0), 42)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 0)
}

test "generator_imported_named_function_producer" {
  let mut g = generator.start<i64, i64>(generator_imported_producer)
  Test.assert_eq(g.next().unwrap_or(0), 21)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 34)
}

test "generator_local_closure_empty_finishes_at_creation" {
  let producer = () => 58
  let mut g = generator.start<i64, i64>(producer)
  Test.assert_true(g.is_done())
  Test.assert_false(g.has_current())
  Test.assert_eq(g.result().unwrap(), 58)
  Test.assert_true(g.next().is_none())
}

test "generator_local_closure_completes_after_yield" {
  let producer = () => {
    generator.yield<i64>(6)
    15
  }
  let mut g = generator.start<i64, i64>(producer)
  Test.assert_eq(g.next().unwrap_or(0), 6)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 15)
}

test "generator_local_closure_captures_shadowed_i64" {
  let base = 31
  let producer = () => {
    generator.yield<i64>(base)
    base + 1
  }
  let base = 90
  let mut g = generator.start<i64, i64>(producer)
  Test.assert_eq(base, 90)
  Test.assert_eq(g.next().unwrap_or(0), 31)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 32)
}

test "generator_local_closure_calls_yielding_helper" {
  let base = 41
  let producer = () => generator_closure_helper(base)
  let mut g = generator.start<i64, i64>(producer)
  Test.assert_eq(g.next().unwrap_or(0), 41)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 43)
}

test "generator_local_closure_captures_rc_across_yield" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(56)
  let producer = () => {
    generator.yield<i64>(runtime_rc_probe_load(p))
    runtime_rc_probe_load(p) + 1
  }
  let mut g = generator.start<i64, i64>(producer)
  Test.assert_eq(g.next().unwrap_or(0), 56)
  Test.assert_true(g.next().is_none())
  Test.assert_eq(g.result().unwrap(), 57)
}

