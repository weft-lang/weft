test "generator_generic_bool_yield" {
  let g = generator_new<bool, i64>(generator_generic_named_bool)
  let first = generator_next<bool, i64>(g)
  let done = generator_next<bool, i64>(g)
  Test.assert_true(first.unwrap_or(false))
  Test.assert_true(done.is_none())
  Test.assert_eq(generator_result<bool, i64>(g).unwrap(), 1)
}

test "generator_generic_bool_false_yield" {
  let g = generator_new<bool, i64>(() => {
    generator_yield<bool>(false)
    generator_yield<bool>(true)
    2
  })
  let first = generator_next<bool, i64>(g)
  let second = generator_next<bool, i64>(g)
  let done = generator_next<bool, i64>(g)
  Test.assert_false(first.unwrap_or(true))
  Test.assert_true(second.unwrap_or(false))
  Test.assert_true(done.is_none())
  Test.assert_eq(generator_result<bool, i64>(g).unwrap(), 2)
}

test "generator_generic_bool_result" {
  let g = generator_new<i64, bool>(generator_generic_named_bool_result)
  let first = generator_next<i64, bool>(g)
  let done = generator_next<i64, bool>(g)
  Test.assert_eq(first.unwrap_or(0), 6)
  Test.assert_true(done.is_none())
  Test.assert_true(generator_result<i64, bool>(g).unwrap())
}

test "generator_generic_rc_result_retained_until_drop" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result)
  let result: RuntimeRcProbe = generator_result<i64, RuntimeRcProbe>(g).unwrap()
  Test.assert_eq(runtime_rc_probe_load(result), 88)
  Test.assert_eq(runtime_rc_probe_count(result), 2)
  generator_drop<i64, RuntimeRcProbe>(g)
  Test.assert_eq(runtime_rc_probe_count(result), 1)
}

test "generator_generic_result_retains_each_read" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result)
  let result1: RuntimeRcProbe = generator_result<i64, RuntimeRcProbe>(g).unwrap()
  let result2: RuntimeRcProbe = generator_result<i64, RuntimeRcProbe>(g).unwrap()
  Test.assert_eq(runtime_rc_probe_load(result2), 88)
  Test.assert_eq(runtime_rc_probe_count(result1), 3)
  generator_drop<i64, RuntimeRcProbe>(g)
  Test.assert_eq(runtime_rc_probe_count(result1), 2)
}

test "generator_generic_result_is_none_while_pending" {
  let g = generator_new<i64, RuntimeRcProbe>(generator_generic_named_rc_result_after_yield)
  Test.assert_true(generator_result<i64, RuntimeRcProbe>(g).is_none())
  generator_drop<i64, RuntimeRcProbe>(g)
  Test.assert_true(generator_is_done<i64, RuntimeRcProbe>(g))
}

test "generator_generic_rc_yield_drop_releases_buffered_current" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(35)
  let producer = () => {
    generator_yield<RuntimeRcProbe>(p)
    0
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  Test.assert_eq(runtime_rc_probe_count(p), 3)
  generator_drop<RuntimeRcProbe, i64>(g)
  Test.assert_eq(runtime_rc_probe_count(p), 2)
}

test "generator_generic_rc_yield_next_transfers_current_then_cleans_producer" {
  let g = generator_new<RuntimeRcProbe, i64>(generator_generic_named_rc_yield_owned)
  let first = generator_next<RuntimeRcProbe, i64>(g)
  let value: RuntimeRcProbe = first.unwrap()
  Test.assert_eq(runtime_rc_probe_load(value), 44)
  -- While the producer is suspended, the structural carrier owns one field
  -- stake in addition to the producer local, returned variant, and extractor.
  Test.assert_eq(runtime_rc_probe_count(value), 4)
  Test.assert_true(generator_next<RuntimeRcProbe, i64>(g).is_none())
  Test.assert_eq(runtime_rc_probe_count(value), 2)
  generator_drop<RuntimeRcProbe, i64>(g)
  Test.assert_eq(runtime_rc_probe_count(value), 2)
}

test "generator_generic_second_resumed_yield_owns_consumer_stake" {
  let p: RuntimeRcProbe = runtime_rc_probe_new(45)
  let producer = () => {
    generator_yield<RuntimeRcProbe>(p)
    generator_yield<RuntimeRcProbe>(p)
    0
  }
  let g = generator_new<RuntimeRcProbe, i64>(producer)
  let first = generator_next<RuntimeRcProbe, i64>(g)
  let second = generator_next<RuntimeRcProbe, i64>(g)
  Test.assert_eq(runtime_rc_probe_count(p), 5)
  generator_drop<RuntimeRcProbe, i64>(g)
  -- The local `producer` binding still owns its capture; dropping the state
  -- must leave both consumer stakes plus that capture and the caller stake.
  Test.assert_eq(runtime_rc_probe_count(p), 4)
}

test "generator_generic_local_closure_captures_shadowed_i64" {
  let base = 71
  let producer = () => {
    generator_yield<i64>(base)
    base + 2
  }
  let base = 4
  let g = generator_new<i64, i64>(producer)
  let first = generator_next<i64, i64>(g)
  let done = generator_next<i64, i64>(g)
  Test.assert_eq(base, 4)
  Test.assert_eq(first.unwrap_or(0), 71)
  Test.assert_true(done.is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 73)
}

test "generator_generic_local_closure_calls_yielding_helper" {
  let base = 51
  let producer = () => generator_generic_closure_helper(base)
  let g = generator_new<i64, i64>(producer)
  let first = generator_next<i64, i64>(g)
  let done = generator_next<i64, i64>(g)
  Test.assert_eq(first.unwrap_or(0), 51)
  Test.assert_true(done.is_none())
  Test.assert_eq(generator_result<i64, i64>(g).unwrap(), 55)
}

test "generator_generic_drop_pending_continuation" {
  let g = generator_new<bool, i64>(() => {
    generator_yield<bool>(true)
    64
  })
  Test.assert_true(generator_has_current<bool, i64>(g))
  generator_drop<bool, i64>(g)
  Test.assert_false(generator_has_current<bool, i64>(g))
  Test.assert_true(generator_is_done<bool, i64>(g))
  Test.assert_true(generator_next<bool, i64>(g).is_none())
}

test "generator_option_step_matrix" {
  for row in 0..3 {
    Test.assert_eq(generator_generic_matrix_case(row), generator_generic_matrix_expected(row))
  }
}
