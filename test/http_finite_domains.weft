use runtime/rc_implicit_test.{runtime_rc_test_heap_arena_offset}
use stdlib/bytes as bytes
use stdlib/string.{*}
use stdlib/http as http
use stdlib/http.{*}
use stdlib/result.{Err, Ok, Result}

fn finite_http_limits() -> HttpLimits {
  let maximum: usize = 18446744073709551615
  http.limits(maximum, maximum, maximum, maximum, maximum, maximum, maximum, maximum).unwrap()
}

fn finite_http_request(source: str, limits: HttpLimits) -> HttpRequestHeadParse {
  let wire = bytes.from_str(source).to_vector()
  http.parse_request_head(wire[..], limits)
}

fn finite_http_chunk_head(source: str, limits: HttpLimits) -> HttpChunkHeadParse {
  let wire = bytes.from_str(source).to_vector()
  http.parse_chunk_head(wire[..], limits)
}

fn finite_http_error_position(error: HttpParseError) -> usize {
  match error {
    HttpInvalidStartLine(position) -> position
    HttpInvalidMethod(position) -> position
    HttpInvalidTarget(position) -> position
    HttpInvalidVersion(position) -> position
    HttpInvalidStatus(position) -> position
    HttpInvalidFieldName(position) -> position
    HttpInvalidFieldValue(position) -> position
    HttpInvalidLineEnding(position) -> position
    HttpStartLineTooLong(position) -> position
    HttpFieldLineTooLong(position) -> position
    HttpHeadersTooLarge(position) -> position
    HttpTooManyHeaders(position) -> position
    HttpMissingHost(position) -> position
    HttpDuplicateHost(position) -> position
    HttpInvalidHost(position) -> position
    HttpInvalidContentLength(position) -> position
    HttpAmbiguousFraming(position) -> position
    HttpInvalidTransferEncoding(position) -> position
    HttpUnsupportedTransferCoding(position) -> position
    HttpForbiddenBodyFraming(position) -> position
    HttpInvalidConnection(position) -> position
    HttpBodyTooLarge(position) -> position
    HttpInvalidChunkSize(position) -> position
    HttpChunkLineTooLong(position) -> position
    HttpInvalidChunkTerminator(position) -> position
    HttpTrailersTooLarge(position) -> position
    HttpForbiddenTrailer(position) -> position
  }
}

test "every HTTP parse failure preserves its full finite position" {
  let maximum: usize = 18446744073709551615
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidStartLine(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidMethod(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidTarget(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidVersion(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidStatus(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidFieldName(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidFieldValue(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidLineEnding(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpStartLineTooLong(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpFieldLineTooLong(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpHeadersTooLarge(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpTooManyHeaders(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpMissingHost(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpDuplicateHost(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidHost(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidContentLength(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpAmbiguousFraming(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidTransferEncoding(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpUnsupportedTransferCoding(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpForbiddenBodyFraming(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidConnection(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpBodyTooLarge(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidChunkSize(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpChunkLineTooLong(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpInvalidChunkTerminator(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpTrailersTooLarge(maximum)), maximum)
  Test.assert_eq_usize(finite_http_error_position(HttpForbiddenTrailer(maximum)), maximum)
}

test "HTTP structural limits reject zero while allowing an empty body budget" {
  match http.limits(0, 1, 1, 1, 1, 1, 1, 1) { Err(HttpStartLineTooLong(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 0, 1, 1, 1, 1, 1, 1) { Err(HttpFieldLineTooLong(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 1, 0, 1, 1, 1, 1, 1) { Err(HttpHeadersTooLarge(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 1, 1, 0, 1, 1, 1, 1) { Err(HttpTooManyHeaders(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 1, 1, 1, 1, 0, 1, 1) { Err(HttpChunkLineTooLong(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 1, 1, 1, 1, 1, 0, 1) { Err(HttpTrailersTooLarge(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match http.limits(1, 1, 1, 1, 1, 1, 1, 0) { Err(HttpTrailersTooLarge(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  Test.assert_eq_usize(http.limits(1, 1, 1, 1, 0, 1, 1, 1).unwrap().body_bytes(), 0)
  Test.assert_eq_usize(finite_http_limits().body_bytes(), 18446744073709551615)
}

test "decimal content lengths retain the complete unsigned domain" {
  let limits = finite_http_limits()
  let prefix = "POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: "
  match finite_http_request(prefix.concat("9223372036854775808\r\n\r\n"), limits) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> Test.assert_eq_usize(count, 9223372036854775808)
    _ -> Test.assert_true(false)
  }
  match finite_http_request(prefix.concat("18446744073709551615, 18446744073709551615\r\n\r\n"), limits) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> Test.assert_eq_usize(count, 18446744073709551615)
    _ -> Test.assert_true(false)
  }
  match finite_http_request(prefix.concat("18446744073709551616\r\n\r\n"), limits) {
    HttpRequestHeadFailed(HttpInvalidContentLength(position)) -> Test.assert_eq_usize(position, 19)
    _ -> Test.assert_true(false)
  }
  match finite_http_request(prefix.concat("9223372036854775808\r\n\r\n"), http.default_limits()) {
    HttpRequestHeadFailed(HttpBodyTooLarge(position)) -> Test.assert_eq_usize(position, 0)
    _ -> Test.assert_true(false)
  }
}

test "large chunk heads distinguish configured budgets from numeric overflow" {
  let limits = finite_http_limits()
  match finite_http_chunk_head("8000000000000000\r\n", limits) {
    HttpChunkHeadData(count, consumed) -> { Test.assert_eq_usize(count, 9223372036854775808); Test.assert_eq_usize(consumed, 18) }
    _ -> Test.assert_true(false)
  }
  match finite_http_chunk_head("FFFFFFFFFFFFFFFF;name=token\r\n", limits) {
    HttpChunkHeadData(count, consumed) -> { Test.assert_eq_usize(count, 18446744073709551615); Test.assert_eq_usize(consumed, 29) }
    _ -> Test.assert_true(false)
  }
  match finite_http_chunk_head("10000000000000000\r\n", limits) {
    HttpChunkHeadFailed(HttpInvalidChunkSize(position)) -> Test.assert_eq_usize(position, 16)
    _ -> Test.assert_true(false)
  }
  match finite_http_chunk_head("FFFFFFFFFFFFFFFF\r\n", http.default_limits()) {
    HttpChunkHeadFailed(HttpBodyTooLarge(position)) -> Test.assert_eq_usize(position, 0)
    _ -> Test.assert_true(false)
  }
  let wire = bytes.from_str("FFFFFFFFFFFFFFFF\r\nx").to_vector()
  match http.parse_chunk(wire[..], limits) { HttpChunkNeedMore -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "zero body budgets admit empty framing and reject positive lengths" {
  let limits = http.limits(256, 256, 512, 8, 0, 256, 256, 8).unwrap()
  match finite_http_request("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n", limits) {
    HttpRequestHeadReady(head, HttpContentLength(0), consumed) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match finite_http_request("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 1\r\n\r\n", limits) {
    HttpRequestHeadFailed(HttpBodyTooLarge(0)) -> Test.assert_true(true)
    _ -> Test.assert_true(false)
  }
  match finite_http_chunk_head("0\r\n\r\n", limits) { HttpChunkHeadEnd(trailers, consumed) -> Test.assert_eq_usize(consumed, 5) _ -> Test.assert_true(false) }
  match finite_http_chunk_head("1\r\n", limits) { HttpChunkHeadFailed(HttpBodyTooLarge(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "line and field section limits include exact terminator boundaries" {
  let wire = "GET / HTTP/1.1\r\nHost: a\r\n\r\n"
  let exact = http.limits(14, 7, 11, 1, 0, 1, 2, 1).unwrap()
  match finite_http_request(wire, exact) { HttpRequestHeadReady(head, framing, consumed) -> Test.assert_eq_usize(consumed, wire.len()) _ -> Test.assert_true(false) }
  match finite_http_request(wire, http.limits(13, 7, 11, 1, 0, 1, 2, 1).unwrap()) {
    HttpRequestHeadFailed(HttpStartLineTooLong(13)) -> Test.assert_true(true) _ -> Test.assert_true(false)
  }
  match finite_http_request(wire, http.limits(14, 6, 11, 1, 0, 1, 2, 1).unwrap()) {
    HttpRequestHeadFailed(HttpFieldLineTooLong(22)) -> Test.assert_true(true) _ -> Test.assert_true(false)
  }
  match finite_http_request(wire, http.limits(14, 7, 10, 1, 0, 1, 2, 1).unwrap()) {
    HttpRequestHeadFailed(HttpHeadersTooLarge(27)) -> Test.assert_true(true) _ -> Test.assert_true(false)
  }
  match finite_http_chunk_head("A\r\n", exact) { HttpChunkHeadFailed(HttpBodyTooLarge(0)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
  match finite_http_chunk_head("AA\r\n", exact) { HttpChunkHeadFailed(HttpChunkLineTooLong(1)) -> Test.assert_true(true) _ -> Test.assert_true(false) }
}

test "invalid Host remains invalid before or after a duplicate" {
  for fields in ["Host: bad host\r\nHost: example.com\r\n", "Host: example.com\r\nHost: bad host\r\n", "Host: bad host\r\nHost: b\r\nHost: c\r\n"] {
    match finite_http_request("GET / HTTP/1.1\r\n" |> str_concat(fields) |> str_concat("\r\n"), finite_http_limits()) {
      HttpRequestHeadFailed(HttpInvalidHost(position)) -> Test.assert_eq_usize(position, 16)
      _ -> Test.assert_true(false)
    }
  }
  match finite_http_request("GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n", finite_http_limits()) {
    HttpRequestHeadFailed(HttpDuplicateHost(16)) -> Test.assert_true(true) _ -> Test.assert_true(false)
  }
}

fn finite_http_failed_parse() -> bool {
  match finite_http_request("GET / HTTP/1.1\r\nHost: good\r\nX-A: b\r\nBad Name: c\r\n\r\n", finite_http_limits()) {
    HttpRequestHeadFailed(HttpInvalidFieldName(position)) -> position == 39
    _ -> false
  }
}

test "early HTTP parse failures reclaim partially built field collections" {
  Test.assert_true(finite_http_failed_parse())
  for _ in 0..40 { finite_http_failed_parse() }
  let before = runtime_rc_test_heap_arena_offset()
  for _ in 0..200 { Test.assert_true(finite_http_failed_parse()) }
  Test.assert_eq(runtime_rc_test_heap_arena_offset(), before)
}
