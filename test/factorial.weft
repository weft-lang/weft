-- Expected exit code: 120
-- Factorial via wrapper mul (tests deep recursion + register preservation)
fn sub(a: Int, b: Int) -> Int { a - b }
fn mul(a: Int, b: Int) -> Int { a * b }
fn factorial(n: Int) -> Int {
  if n <= 0 { 1 } else { mul(n, factorial(sub(n, 1))) }
}
-- factorial(5) = 120
fn main() { factorial(5) }
