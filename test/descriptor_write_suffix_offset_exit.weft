-- Expected exit code: 101
-- A write offset beyond a byte vector's initialized elements is a caller
-- contract violation; it panics instead of reaching the platform.

use runtime/descriptor_io.{descriptor_write_suffix}
use stdlib/vector as vector

fn main() -> i64 {
  let mut values = vector.new<u8>()
  values.push(__i64_to_u8(1))
  descriptor_write_suffix(1, values, __i64_to_usize(2))
}
