-- The weft command line as typed values: the colour option and command
-- table, and the requests of the commands whose arguments it reads.

use compiler/backend/target.{NativeLinkLinuxAarch64, NativeLinkMacosAarch64, NativeLinkTarget}
use compiler/tool/cli.{*}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/string/builder as builder
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len, vector_push}

fn words(values: List<str>) -> Vector<str> {
  let out: Vector<str> = vector.new<str>()
  for value in values { vector_push<str>(out, value) }
  out
}

fn joined(values: Vector<str>) -> str {
  let mut out = builder.new()
  for index in 0..vector_len<str>(values) {
    if index > 0 { out.append("|") }
    out.append(vector_get_in_bounds<str>(values, index))
  }
  out.finish()
}

fn none() -> List<str> { Nil<str>() }

fn one(a: str) -> List<str> { Cons(a, Nil<str>()) }

fn two(a: str, b: str) -> List<str> { Cons(a, one(b)) }

fn three(a: str, b: str, c: str) -> List<str> { Cons(a, two(b, c)) }

fn four(a: str, b: str, c: str, d: str) -> List<str> { Cons(a, three(b, c, d)) }

fn five(a: str, b: str, c: str, d: str, e: str) -> List<str> { Cons(a, four(b, c, d, e)) }

-- Invocation ----------------------------------------------------------------
fn command_name(command: CliCommand) -> str {
  match command {
    CliCompileInput -> "compile-input"
    CliVersionFlag -> "--version"
    CliVersion -> "version"
    CliTarget -> "target"
    CliFmt -> "fmt"
    CliCheck -> "check"
    CliAst -> "ast"
    CliTest -> "test"
    CliMcp -> "mcp"
    CliLsp -> "lsp"
    CliPkg -> "pkg"
    CliExplain -> "explain"
    CliDoc -> "doc"
    CliIr -> "ir"
    CliSymbols -> "symbols"
    CliRun -> "run"
    CliBuild -> "build"
    CliCompile -> "compile"
    CliUnknown(word) -> i"unknown {word}"
  }
}

fn color_name(color: Option<CliColor>) -> str {
  match color {
    None -> "default"
    Some(CliColorAuto) -> "auto"
    Some(CliColorAlways) -> "always"
    Some(CliColorNever) -> "never"
  }
}

fn parsed(values: List<str>) -> str {
  match cli_parse(words(values)) {
    CliParsed(invocation) ->
      i"{color_name(invocation.color)} {command_name(invocation.command)} [{joined(invocation.arguments)}] skip {invocation.consumed}"
    CliColorMissing -> "color missing"
    CliColorInvalid -> "color invalid"
  }
}

test "cli_names_every_command" {
  let names = words(
    Cons(
      "--version",
      Cons(
        "version",
        Cons(
          "target",
          Cons(
            "fmt",
            Cons(
              "check",
              Cons(
                "ast",
                Cons(
                  "test",
                  Cons(
                    "mcp",
                    Cons(
                      "lsp",
                      Cons(
                        "pkg",
                        Cons(
                          "explain",
                          Cons(
                            "doc",
                            Cons(
                              "ir",
                              Cons("symbols", Cons("run", Cons("build", Cons("compile", none()))))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  for index in 0..vector_len<str>(names) {
    let word = vector_get_in_bounds<str>(names, index)
    Test.assert_str_eq(command_name(cli_command(word)), word)
  }
  Test.assert_str_eq(command_name(cli_command("fmtx")), "unknown fmtx")
  Test.assert_str_eq(command_name(cli_command("")), "unknown ")
  Test.assert_str_eq(command_name(cli_command("Check")), "unknown Check")
}

test "cli_reads_the_colour_option_before_the_command" {
  Test.assert_str_eq(parsed(none()), "default compile-input [] skip 0")
  Test.assert_str_eq(parsed(two("check", "a.weft")), "default check [a.weft] skip 0")
  Test.assert_str_eq(parsed(three("--color", "always", "fmt")), "always fmt [] skip 2")
  Test.assert_str_eq(parsed(two("--color=never", "ast")), "never ast [] skip 1")
  Test.assert_str_eq(parsed(two("--color=auto", "lsp")), "auto lsp [] skip 1")
  Test.assert_str_eq(
    parsed(three("--no-color", "run", "--")),
    "never run [--] skip 1"
  )
  -- A colour option alone still compiles standard input.
  Test.assert_str_eq(parsed(one("--no-color")), "never compile-input [] skip 1")
  -- Only the first word may be the colour option.
  Test.assert_str_eq(
    parsed(three("check", "--color", "never")),
    "default check [--color|never] skip 0"
  )
  Test.assert_str_eq(
    parsed(three("--no-color", "--color=always", "x")),
    "never unknown --color=always [x] skip 1"
  )
}

test "cli_rejects_a_malformed_colour_option" {
  Test.assert_str_eq(parsed(one("--color")), "color missing")
  Test.assert_str_eq(parsed(two("--color", "loud")), "color invalid")
  Test.assert_str_eq(parsed(one("--color=")), "color invalid")
  Test.assert_str_eq(parsed(two("--color=rainbow", "check")), "color invalid")
  Test.assert_str_eq(parsed(one("--color=ALWAYS")), "color invalid")
}

test "cli_needs_the_package_cache_only_for_project_commands" {
  Test.assert_false(cli_uses_package_cache(CliVersionFlag))
  Test.assert_false(cli_uses_package_cache(CliVersion))
  Test.assert_false(cli_uses_package_cache(CliTarget))
  Test.assert_false(cli_uses_package_cache(CliExplain))
  Test.assert_false(cli_uses_package_cache(CliPkg))
  Test.assert_false(cli_uses_package_cache(CliUnknown("x")))
  Test.assert_true(cli_uses_package_cache(CliCompileInput))
  Test.assert_true(cli_uses_package_cache(CliCheck))
  Test.assert_true(cli_uses_package_cache(CliBuild))
  Test.assert_true(cli_uses_package_cache(CliRun))
}

-- Sources, version and target -----------------------------------------------
fn source_name(source: Option<CliSource>) -> str {
  match source {
    None -> "usage"
    Some(CliStandardInput) -> "stdin"
    Some(CliSourcePath(path)) -> i"path {path}"
  }
}

test "cli_reads_an_optional_or_required_single_source" {
  Test.assert_str_eq(source_name(cli_source(words(none()))), "stdin")
  Test.assert_str_eq(source_name(cli_source(words(one("a b.weft")))), "path a b.weft")
  Test.assert_str_eq(source_name(cli_source(words(two("a", "b")))), "usage")
  match cli_single(words(one("E1001"))) {
    Some(word) -> Test.assert_str_eq(word, "E1001")
    None -> Test.assert_true(false)
  }
  Test.assert_true(cli_single(words(none())).is_none())
  Test.assert_true(cli_single(words(two("a", "b"))).is_none())
}

fn version_name(request: CliVersionRequest) -> str {
  match request {
    CliVersionHuman -> "human"
    CliVersionJson -> "json"
    CliVersionUsage -> "usage"
  }
}

fn target_name(target: NativeLinkTarget) -> str {
  match target {
    NativeLinkMacosAarch64 -> "macos"
    NativeLinkLinuxAarch64 -> "linux"
  }
}

fn target_request(values: List<str>) -> str {
  match cli_target(words(values)) {
    CliTargetList -> "list"
    CliTargetShow(None) -> "show host"
    CliTargetShow(Some(target)) -> i"show {target_name(target)}"
    CliTargetUnsupported -> "unsupported"
    CliTargetUsage -> "usage"
  }
}

test "cli_reads_version_and_target_requests" {
  Test.assert_str_eq(version_name(cli_version(words(none()))), "human")
  Test.assert_str_eq(version_name(cli_version(words(one("--json")))), "json")
  Test.assert_str_eq(version_name(cli_version(words(one("--JSON")))), "usage")
  Test.assert_str_eq(version_name(cli_version(words(two("--json", "--json")))), "usage")
  Test.assert_str_eq(target_request(one("list")), "list")
  Test.assert_str_eq(target_request(two("list", "extra")), "usage")
  Test.assert_str_eq(target_request(one("show")), "show host")
  Test.assert_str_eq(target_request(two("show", "linux-aarch64")), "show linux")
  Test.assert_str_eq(target_request(two("show", "macos-aarch64")), "show macos")
  Test.assert_str_eq(target_request(two("show", "x86_64")), "unsupported")
  Test.assert_str_eq(target_request(three("show", "macos-aarch64", "x")), "usage")
  Test.assert_str_eq(target_request(none()), "usage")
  Test.assert_str_eq(target_request(one("describe")), "usage")
}

-- Compile -------------------------------------------------------------------
fn compile_request(values: List<str>) -> str {
  match cli_compile(words(values)) {
    CliCompileProgram(CliStandardInput) -> "program stdin"
    CliCompileProgram(CliSourcePath(path)) -> i"program {path}"
    CliCompileMetrics(path) -> i"metrics {path}"
    CliCompileRcCensus(path) -> i"rc census {path}"
    CliCompileCheckerStorage(path, None) -> i"checker storage {path}"
    CliCompileCheckerStorage(path, Some(root)) -> i"checker storage {path} embedding {root}"
    CliCompileUsage(usage) -> if usage.starts_with("usage: weft compile --checker") {
      "census usage"
    } else { "usage" }
  }
}

test "cli_reads_every_compile_request" {
  Test.assert_str_eq(compile_request(none()), "program stdin")
  Test.assert_str_eq(compile_request(one("a.weft")), "program a.weft")
  Test.assert_str_eq(compile_request(two("--metrics", "a.weft")), "metrics a.weft")
  Test.assert_str_eq(compile_request(two("--rc-census", "a.weft")), "rc census a.weft")
  Test.assert_str_eq(
    compile_request(two("--checker-storage-census", "a.weft")),
    "checker storage a.weft"
  )
  Test.assert_str_eq(
    compile_request(four("--checker-storage-census", "--embed-sdk", ".", "a.weft")),
    "checker storage a.weft embedding ."
  )
}

test "cli_rejects_malformed_compile_requests" {
  Test.assert_str_eq(compile_request(one("--metrics")), "usage")
  Test.assert_str_eq(compile_request(three("--metrics", "a.weft", "b.weft")), "usage")
  Test.assert_str_eq(compile_request(one("--rc-census")), "usage")
  Test.assert_str_eq(compile_request(two("a.weft", "b.weft")), "usage")
  Test.assert_str_eq(compile_request(one("--fast")), "usage")
  Test.assert_str_eq(compile_request(one("--checker-storage-census")), "census usage")
  Test.assert_str_eq(
    compile_request(four("--checker-storage-census", "--sdk", ".", "a.weft")),
    "census usage"
  )
  Test.assert_str_eq(
    compile_request(three("--checker-storage-census", "--embed-sdk", ".")),
    "census usage"
  )
}

-- Run -----------------------------------------------------------------------
fn run_request(values: List<str>) -> str {
  match cli_run(words(values)) {
    CliRunReady(CliRunPath(path), args) -> i"path {path} [{joined(args)}]"
    CliRunReady(CliRunTarget(name), args) -> i"target '{name}' [{joined(args)}]"
    CliRunUsage -> "usage"
  }
}

test "cli_reads_every_run_request" {
  Test.assert_str_eq(run_request(none()), "target '' []")
  Test.assert_str_eq(run_request(one("--")), "target '' []")
  Test.assert_str_eq(run_request(three("--", "a", "two words")), "target '' [a|two words]")
  Test.assert_str_eq(run_request(one("app")), "target 'app' []")
  Test.assert_str_eq(run_request(four("app", "--", "-x", "--")), "target 'app' [-x|--]")
  -- A word with a slash or the source suffix is a file.
  Test.assert_str_eq(run_request(one("main.weft")), "path main.weft []")
  Test.assert_str_eq(run_request(one("src/app")), "path src/app []")
  Test.assert_str_eq(run_request(three("./x.weft", "--", "y")), "path ./x.weft [y]")
  Test.assert_str_eq(run_request(one("weft")), "target 'weft' []")
}

test "cli_requires_run_arguments_after_a_separator" {
  Test.assert_str_eq(run_request(two("app", "extra")), "usage")
  Test.assert_str_eq(run_request(three("main.weft", "x", "--")), "usage")
}

-- Build ---------------------------------------------------------------------
fn optional(value: Option<str>) -> str {
  match value {
    None -> "-"
    Some(text) -> text
  }
}

fn build_request(values: List<str>) -> str {
  match cli_build(words(values)) {
    CliBuildUsage -> "usage"
    CliBuildReady(options) -> {
      let input = match options.input {
        CliBuildPath(file) ->
          i"file {file.source} -> {file.output} facts {optional(file.facts)} sdk {optional(file.sdk)}"
        CliBuildTarget(name) -> i"target '{name}'"
      }
      let debug = match options.debug {
        CliDebugIncluded -> "debug"
        CliDebugStripped -> "stripped"
      }
      let target = match options.target {
        None -> "host"
        Some(chosen) -> target_name(chosen)
      }
      let heap = match options.heap {
        CliHeapReuse -> "reuse"
        CliHeapQuarantine -> "quarantine"
      }
      i"{input}; {debug} {target} {heap}"
    }
  }
}

test "cli_reads_target_builds" {
  Test.assert_str_eq(build_request(none()), "target ''; debug host reuse")
  Test.assert_str_eq(build_request(one("app")), "target 'app'; debug host reuse")
  Test.assert_str_eq(
    build_request(four("app", "--target", "linux-aarch64", "--strip-debug")),
    "target 'app'; stripped linux reuse"
  )
  Test.assert_str_eq(
    build_request(two("--rc-quarantine", "app")),
    "target 'app'; debug host quarantine"
  )
}

test "cli_reads_file_builds" {
  Test.assert_str_eq(
    build_request(three("main.weft", "-o", "out")),
    "file main.weft -> out facts - sdk -; debug host reuse"
  )
  Test.assert_str_eq(
    build_request(
      Cons(
        "-o",
        Cons(
          "out",
          Cons(
            "--artifact-facts",
            Cons("out.facts.json", Cons("--embed-sdk", Cons(".", one("compiler/main.weft"))))
          )
        )
      )
    ),
    "file compiler/main.weft -> out facts out.facts.json sdk .; debug host reuse"
  )
  Test.assert_str_eq(
    build_request(five("a.weft", "-o", "b", "--target", "macos-aarch64")),
    "file a.weft -> b facts - sdk -; debug macos reuse"
  )
}

test "cli_rejects_every_malformed_build" {
  -- Repeated options.
  Test.assert_str_eq(build_request(five("a.weft", "-o", "b", "-o", "c")), "usage")
  Test.assert_str_eq(build_request(two("--strip-debug", "--strip-debug")), "usage")
  Test.assert_str_eq(build_request(two("--rc-quarantine", "--rc-quarantine")), "usage")
  Test.assert_str_eq(
    build_request(four("--target", "linux-aarch64", "--target", "linux-aarch64")),
    "usage"
  )
  -- Missing or unsupported values.
  Test.assert_str_eq(build_request(two("a.weft", "-o")), "usage")
  Test.assert_str_eq(build_request(one("--target")), "usage")
  Test.assert_str_eq(build_request(two("--target", "x86_64")), "usage")
  Test.assert_str_eq(
    build_request(three("a.weft", "-o", "b")),
    "file a.weft -> b facts - sdk -; debug host reuse"
  )
  Test.assert_str_eq(build_request(four("a.weft", "-o", "b", "--artifact-facts")), "usage")
  -- An output needs a source; facts and an SDK need an output.
  Test.assert_str_eq(build_request(two("-o", "b")), "usage")
  Test.assert_str_eq(build_request(three("app", "--artifact-facts", "f")), "usage")
  Test.assert_str_eq(build_request(three("app", "--embed-sdk", ".")), "usage")
  -- One positional; unknown options.
  Test.assert_str_eq(build_request(two("a", "b")), "usage")
  Test.assert_str_eq(build_request(one("--release")), "usage")
}

-- IR ------------------------------------------------------------------------
fn ir_request(values: List<str>) -> str {
  match cli_ir(words(values)) {
    CliIrProblem(problem) -> i"problem: {problem}"
    CliIrReady(options) -> {
      let stage = match options.stage {
        CliIrLowered -> "lowered"
        CliIrOptimised -> "optimised"
        CliIrNative -> "native"
      }
      let facts = match options.facts {
        CliIrNoFacts -> "no facts"
        CliIrCleanupFacts -> "cleanup"
      }
      let scope = match options.scope {
        CliIrRoot -> "root"
        CliIrEverything -> "all"
        CliIrFunction(name) -> i"function {name}"
      }
      i"{options.path}: {stage}, {facts}, {scope}"
    }
  }
}

test "cli_reads_ir_requests" {
  Test.assert_str_eq(ir_request(one("a.weft")), "a.weft: optimised, no facts, root")
  Test.assert_str_eq(
    ir_request(three("--stage", "lowered", "a.weft")),
    "a.weft: lowered, no facts, root"
  )
  Test.assert_str_eq(
    ir_request(three("a.weft", "--function", "main")),
    "a.weft: optimised, no facts, function main"
  )
  Test.assert_str_eq(ir_request(two("--all", "a.weft")), "a.weft: optimised, no facts, all")
  -- Cleanup facts imply the native stage, and agree with it when named.
  Test.assert_str_eq(
    ir_request(three("--facts", "cleanup", "a.weft")),
    "a.weft: native, cleanup, root"
  )
  Test.assert_str_eq(
    ir_request(five("--stage", "native", "--facts", "cleanup", "a.weft")),
    "a.weft: native, cleanup, root"
  )
}

test "cli_explains_every_malformed_ir_request" {
  Test.assert_str_eq(ir_request(none()), "problem: expected an input file")
  Test.assert_str_eq(
    ir_request(two("a.weft", "b.weft")),
    "problem: expected exactly one input file"
  )
  Test.assert_str_eq(
    ir_request(two("a.weft", "--stage")),
    "problem: --stage needs lowered, optimised or native"
  )
  Test.assert_str_eq(
    ir_request(three("--stage", "parsed", "a.weft")),
    "problem: unknown stage (use lowered, optimised or native)"
  )
  Test.assert_str_eq(ir_request(two("a.weft", "--facts")), "problem: --facts needs cleanup")
  Test.assert_str_eq(
    ir_request(three("--facts", "all", "a.weft")),
    "problem: unknown facts (use cleanup)"
  )
  Test.assert_str_eq(
    ir_request(two("a.weft", "--function")),
    "problem: --function needs a function name"
  )
  Test.assert_str_eq(
    ir_request(four("--all", "--function", "f", "a.weft")),
    "problem: choose one of --all and --function"
  )
  Test.assert_str_eq(
    ir_request(four("--function", "f", "--all", "a.weft")),
    "problem: choose one of --all and --function"
  )
  Test.assert_str_eq(
    ir_request(five("--stage", "optimised", "--facts", "cleanup", "a.weft")),
    "problem: --facts cleanup describes native emission (use --stage native)"
  )
}

-- Environment colour ---------------------------------------------------------
fn environment_color(no_color: str?, term: str?) -> str {
  color_name(Some(cli_environment_color(no_color, term)))
}

test "cli_environment_colour_defaults_to_auto" {
  Test.assert_str_eq(environment_color(nil, nil), "auto")
  Test.assert_str_eq(environment_color(nil, "xterm-256color"), "auto")
}

test "cli_environment_colour_honours_nonempty_no_color_only" {
  Test.assert_str_eq(environment_color("1", "xterm"), "never")
  Test.assert_str_eq(environment_color("false", nil), "never")
  -- An empty NO_COLOR is unset.
  Test.assert_str_eq(environment_color("", "xterm"), "auto")
}

test "cli_environment_colour_honours_an_exactly_dumb_terminal" {
  Test.assert_str_eq(environment_color(nil, "dumb"), "never")
  Test.assert_str_eq(environment_color(nil, "dumber"), "auto")
  Test.assert_str_eq(environment_color(nil, "Dumb"), "auto")
  Test.assert_str_eq(environment_color("", "dumb"), "never")
}

-- Packages ------------------------------------------------------------------
fn pkg_request(values: List<str>) -> str {
  match cli_pkg(words(values)) {
    CliPkgInit(name) -> i"init {name}"
    CliPkgAddPath(name, path) -> i"add {name} path {path}"
    CliPkgAddGit(name, url, revision) -> i"add {name} git {url} at {revision}"
    CliPkgAddArchive(name, url, digest) -> i"add {name} archive {url} with {digest}"
    CliPkgLock -> "lock"
    CliPkgFetch -> "fetch"
    CliPkgFetchOffline -> "fetch offline"
    CliPkgUpdate(name, pin, CliTrustReview) -> i"update {name} to {pin} for review"
    CliPkgUpdate(name, pin, CliTrustAccept) -> i"update {name} to {pin} accepting trust"
    CliPkgExports -> "exports"
    CliPkgAudit -> "audit"
    CliPkgUsage(usage) -> if usage.starts_with("usage: weft pkg init") { "usage" } else {
      "action usage"
    }
    CliPkgUnknown -> "unknown"
  }
}

test "cli_reads_every_package_request" {
  Test.assert_str_eq(pkg_request(one("init")), "init app")
  Test.assert_str_eq(pkg_request(two("init", "cli_app")), "init cli_app")
  Test.assert_str_eq(pkg_request(three("add", "util", "../util")), "add util path ../util")
  Test.assert_str_eq(
    pkg_request(Cons("add", five("remote", "--git", "https://x/r.git", "--revision", "ab12"))),
    "add remote git https://x/r.git at ab12"
  )
  Test.assert_str_eq(
    pkg_request(Cons("add", five("tar", "--archive", "https://x/t.tar", "--sha256", "sha256:ff"))),
    "add tar archive https://x/t.tar with sha256:ff"
  )
  Test.assert_str_eq(pkg_request(one("lock")), "lock")
  Test.assert_str_eq(pkg_request(one("fetch")), "fetch")
  Test.assert_str_eq(pkg_request(two("fetch", "--offline")), "fetch offline")
  Test.assert_str_eq(
    pkg_request(four("update", "remote", "--sha256", "sha256:aa")),
    "update remote to sha256:aa for review"
  )
  Test.assert_str_eq(
    pkg_request(five("update", "remote", "--revision", "cd34", "--accept-trust-change")),
    "update remote to cd34 accepting trust"
  )
  Test.assert_str_eq(pkg_request(one("exports")), "exports")
  Test.assert_str_eq(pkg_request(one("audit")), "audit")
}

test "cli_rejects_every_malformed_package_request" {
  Test.assert_str_eq(pkg_request(none()), "usage")
  Test.assert_str_eq(pkg_request(one("publish")), "unknown")
  Test.assert_str_eq(pkg_request(three("init", "a", "b")), "usage")
  Test.assert_str_eq(pkg_request(two("lock", "extra")), "usage")
  Test.assert_str_eq(pkg_request(two("exports", "extra")), "usage")
  Test.assert_str_eq(pkg_request(two("audit", "extra")), "usage")
  Test.assert_str_eq(pkg_request(two("fetch", "--online")), "action usage")
  Test.assert_str_eq(pkg_request(two("add", "util")), "action usage")
  Test.assert_str_eq(pkg_request(four("add", "util", "path", "extra")), "action usage")
  -- A git source pins a revision; an archive pins a digest.
  Test.assert_str_eq(
    pkg_request(Cons("add", five("remote", "--git", "u", "--sha256", "sha256:ff"))),
    "action usage"
  )
  Test.assert_str_eq(
    pkg_request(Cons("add", five("tar", "--archive", "u", "--revision", "ab"))),
    "action usage"
  )
  Test.assert_str_eq(pkg_request(three("update", "remote", "--sha256")), "action usage")
  Test.assert_str_eq(pkg_request(four("update", "remote", "--pin", "x")), "action usage")
  Test.assert_str_eq(
    pkg_request(five("update", "remote", "--revision", "x", "--accept")),
    "action usage"
  )
}
