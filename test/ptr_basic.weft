fn ptr_read(p: *i64) -> i64 {
  p.*
}

fn mut_ptr_read(p: *mut i64) -> i64 {
  p.*
}

fn mut_ptr_write(p: *mut i64, value: i64) -> i64 {
  p.* = value
  p.*
}

test "ptr_basic_immutable_local_read" {
  let x = 42
  let p = &x
  Test.assert_eq(p.*, 42)
}

test "ptr_basic_parameter_read" {
  let x = 17
  Test.assert_eq(ptr_read(&x), 17)
}

test "ptr_basic_repeated_address_keeps_identity" {
  let x = 5
  let p = &x
  let q = &x
  if p == q {
    Test.assert_eq(p.*, 5)
  } else {
    Test.assert_eq(0, 1)
  }
}

test "ptr_basic_mut_pointer_read" {
  let mut y = 33
  Test.assert_eq(mut_ptr_read(&mut y), 33)
}

test "ptr_basic_mut_pointer_subtypes_to_immutable" {
  let mut y = 44
  Test.assert_eq(ptr_read(&mut y), 44)
}

test "ptr_basic_mut_pointer_assignment_updates_local" {
  let mut y = 1
  let p = &mut y
  p.* = 9
  Test.assert_eq(y, 9)
}

test "ptr_basic_mut_pointer_assignment_through_parameter" {
  let mut y = 2
  Test.assert_eq(mut_ptr_write(&mut y, 15), 15)
  Test.assert_eq(y, 15)
}

test "ptr_basic_mut_pointer_assignment_alias_ordering" {
  let mut y = 3
  let p = &mut y
  let q = p
  p.* = 21
  q.* = q.* + 1
  Test.assert_eq(y, 22)
}
