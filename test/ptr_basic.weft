use "stdlib/unsafe.weft"

fn ptr_read(p: *i64) -[Unsafe]> i64 {
  p.*
}

fn mut_ptr_read(p: *mut i64) -[Unsafe]> i64 {
  p.*
}

fn mut_ptr_write(p: *mut i64, value: i64) -[Unsafe]> i64 {
  p.* = value
  p.*
}

fn ptr_basic_immutable_local_read_impl() -[Unsafe]> i64 {
  let x = 42
  let p = &x
  p.*
}

fn ptr_basic_parameter_read_impl() -[Unsafe]> i64 {
  let x = 17
  ptr_read(&x)
}

fn ptr_basic_repeated_address_keeps_identity_impl() -[Unsafe]> i64 {
  let x = 5
  let p = &x
  let q = &x
  if p == q { p.* } else { 0 }
}

fn ptr_basic_mut_pointer_read_impl() -[Unsafe]> i64 {
  let mut y = 33
  mut_ptr_read(&mut y)
}

fn ptr_basic_mut_pointer_subtypes_to_immutable_impl() -[Unsafe]> i64 {
  let mut y = 44
  ptr_read(&mut y)
}

fn ptr_basic_mut_pointer_assignment_updates_local_impl() -[Unsafe]> i64 {
  let mut y = 1
  let p = &mut y
  p.* = 9
  y
}

fn ptr_basic_mut_pointer_assignment_through_parameter_impl() -[Unsafe]> i64 {
  let mut y = 2
  let wrote = mut_ptr_write(&mut y, 15)
  wrote * 100 + y
}

fn ptr_basic_mut_pointer_assignment_alias_ordering_impl() -[Unsafe]> i64 {
  let mut y = 3
  let p = &mut y
  let q = p
  p.* = 21
  q.* = q.* + 1
  y
}

fn ptr_basic_run_unsafe(f: () -[Unsafe]> i64) -> i64 {
  handle f() {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

test "ptr_basic_immutable_local_read" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_immutable_local_read_impl), 42)
}

test "ptr_basic_parameter_read" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_parameter_read_impl), 17)
}

test "ptr_basic_repeated_address_keeps_identity" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_repeated_address_keeps_identity_impl), 5)
}

test "ptr_basic_mut_pointer_read" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_mut_pointer_read_impl), 33)
}

test "ptr_basic_mut_pointer_subtypes_to_immutable" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_mut_pointer_subtypes_to_immutable_impl), 44)
}

test "ptr_basic_mut_pointer_assignment_updates_local" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_mut_pointer_assignment_updates_local_impl), 9)
}

test "ptr_basic_mut_pointer_assignment_through_parameter" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_mut_pointer_assignment_through_parameter_impl), 1515)
}

test "ptr_basic_mut_pointer_assignment_alias_ordering" {
  Test.assert_eq(ptr_basic_run_unsafe(ptr_basic_mut_pointer_assignment_alias_ordering_impl), 22)
}
