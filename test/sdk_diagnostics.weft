use compiler/sdk_source.{sdk_archive_diagnostic, sdk_source_diagnostic, sdk_manifest_diagnostic}
use runtime/sdk_archive.{*}
use stdlib/diagnostic
use stdlib/diagnostic/schema.{*}

fn sdk_diagnostic_reason(diagnostic: Diagnostic) -> str {
  let mut fields = diagnostic.fields()
  let mut reason = ""
  let mut done = false
  while not done {
    match fields {
      DiagnosticFieldNil -> { done = true }
      DiagnosticFieldCons(field, rest) -> {
        match field {
          DiagnosticFieldText(name, value) -> { if name == "reason" { reason = value } }
          _ -> nil
        }
        fields = rest
      }
    }
  }
  reason
}

test "archive diagnostics preserve all typed validation reasons" {
  for index in 0..6 {
    let (error, reason) = match index {
      0 -> (SdkArchiveTruncated, "truncated")
      1 -> (SdkArchiveBadMagic, "bad_magic")
      2 -> (SdkArchiveUnsupportedVersion(2), "unsupported_version")
      3 -> (SdkArchiveInvalidLayout, "invalid_layout")
      4 -> (SdkArchiveInvalidEntry(17), "invalid_entry")
      _ -> (SdkArchiveDigestMismatch, "digest_mismatch")
    }
    let diagnostic = sdk_archive_diagnostic(error)
    Test.assert_str_eq(diagnostic.class().name(), "link")
    Test.assert_str_eq(diagnostic.code().text(), "E5015")
    Test.assert_str_eq(sdk_diagnostic_reason(diagnostic), reason)
  }
}

test "source and manifest diagnostics retain canonical paths" {
  let diagnostic = sdk_source_diagnostic("stdlib/console.weft", "missing")
  Test.assert_str_eq(diagnostic.code().text(), "E5016")
  Test.assert_str_eq(sdk_diagnostic_reason(diagnostic), "missing")
  match diagnostic.primary() {
    DiagnosticSourceRange(DiagnosticSourceNamed(path), start, end) -> Test.assert_str_eq(path, "stdlib/console.weft")
    _ -> Test.assert_true(false)
  }
  let manifest = sdk_manifest_diagnostic()
  Test.assert_str_eq(manifest.code().text(), "E5017")
  match manifest.primary() {
    DiagnosticSourceRange(DiagnosticSourceNamed(path), start, end) -> Test.assert_str_eq(path, "weft.pkg")
    _ -> Test.assert_true(false)
  }
}
