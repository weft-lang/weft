use "runtime/alloc.weft"
use "runtime/memory.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"
use "compiler/diagnose.weft"
use runtime/buffer.{*}

fn grammar_test_tokens(src: str) -> i64 {
  let grammar = weft_grammar()
  grammar.lex(__str_ptr(src), __str_len(src))
}

fn grammar_parse_tokens_quiet(grammar: WeftGrammar, toks: i64, src: i64, tt: i64) -> i64 {
  handle grammar.parse_tokens(toks, src, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn grammar_parse_quiet(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  handle grammar.parse(src, n, tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn grammar_test_parse_tokens(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let toks = grammar.lex(__str_ptr(src), __str_len(src))
  grammar_parse_tokens_quiet(grammar, toks, __str_ptr(src), tt)
}

fn grammar_test_parse_source(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  grammar_parse_quiet(grammar, __str_ptr(src), __str_len(src), tt)
}

fn grammar_test_check_errors(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = grammar_parse_quiet(grammar, __str_ptr(src), __str_len(src), tt)
  handle grammar.check(fns, __str_ptr(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
}

fn grammar_test_parse_diagnostics(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let arena = arena_new(64)
  let count = arena_alloc(arena, 8, 8)
  mem_store64(count, 0)
  handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.warn(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
    Diagnose.note(msg, span) -> { mem_store64(count, mem_load64(count) + 1) resume(0) }
  }
  let result = mem_load64(count)
  arena_free(arena)
  result
}

fn grammar_test_parse_recovered_fns(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = handle grammar.parse(__str_ptr(src), __str_len(src), tt) {
    Diagnose.error(msg, span) -> resume(0)
    Diagnose.warn(msg, span) -> resume(0)
    Diagnose.note(msg, span) -> resume(0)
  }
  nlist_len(fns)
}

fn grammar_test_first_body_tag_from_tokens(src: str) -> i64 {
  let fns = grammar_test_parse_tokens(src)
  node_tag(pipeline_first_fn_body_node(fns))
}

fn grammar_test_first_body_tag_from_source(src: str) -> i64 {
  let fns = grammar_test_parse_source(src)
  node_tag(pipeline_first_fn_body_node(fns))
}

fn grammar_test_body_tag_agrees(src: str, expected: i64) -> i64 {
  if grammar_test_first_body_tag_from_tokens(src) != expected { 0 }
  else { if grammar_test_first_body_tag_from_source(src) != expected { 0 } else { 1 } }
}

fn grammar_test_interp_body_tag() -> i64 {
  let b = buf_new(128)
  bstr(b, "fn main(value: i64) -> str { \"value ")
  bu8(b, 123)
  bstr(b, "value}\" }")
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = grammar_parse_quiet(grammar, buf_ptr(b), buf_len(b), tt)
  node_tag(pipeline_first_fn_body_node(fns))
}

type GrammarCollisionBox { value: i64 }

fn grammar_collision_same_name(x: i64) -> i64 { x + 1 }

impl GrammarCollisionBox {
  fn grammar_collision_same_name(self: GrammarCollisionBox, x: i64) -> i64 { x + 10 }
}

test "grammar_lex_exposes_token_stream" {
  let toks = grammar_test_tokens("fn main() -> i64 { 42 }")
  Test.assert_eq(tok_tag(toks, 0), 3)
  Test.assert_eq(tok_v1(toks, 0), 1)
  Test.assert_eq(tok_tag(toks, 1), 2)
  Test.assert_eq(tok_v2(toks, 1), 4)
  Test.assert_eq(tok_tag(toks, tok_count(toks) - 1), 7)
}

test "grammar_lex_spans_track_offsets_and_eof" {
  let src = "\n  fn main() -> i64 { 42 }"
  let toks = grammar_test_tokens(src)
  Test.assert_eq(tok_tag(toks, 0), 3)
  Test.assert_eq(tok_tag(toks, 1), 2)
  Test.assert_eq(tok_v1(toks, 1), 6)
  Test.assert_eq(tok_v2(toks, 1), 4)
  Test.assert_eq(tok_tag(toks, tok_count(toks) - 1), 7)
  Test.assert_eq(tok_v1(toks, tok_count(toks) - 1), __str_len(src))
}

test "grammar_parse_tokens_parses_multiple_functions" {
  let fns = grammar_test_parse_tokens("fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }")
  Test.assert_eq(nlist_len(fns), 2)
}

test "grammar_parse_source_matches_pipeline_parse_source" {
  let src = "type GrammarBox<T> { value: T } fn main() -> i64 { 42 }"
  let direct = grammar_test_parse_source(src)
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(direct), nlist_len(pipeline_ast_fns(ast)))
}

test "grammar_parse_source_handles_string_interpolation" {
  let src = "trait GrammarDisplay { fn display(self: i64) -> str } impl GrammarDisplay for i64 { fn display(self: i64) -> str { \"\" } } fn main() -> str { \"value {40 + 2}\" }"
  let fns = grammar_test_parse_source(src)
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(fns), nlist_len(pipeline_ast_fns(ast)))
}

test "grammar_parse_body_tag_matrix_core_exprs" {
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { if true { 1 } else { 2 } }", 5), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { let x = 1 x }", 6), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { match 1 { 1 -> 2, _ -> 3 } }", 15), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { x => x + 1 }", 29), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { loop { break(7) } }", 49), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { defer 1 2 }", 52), 1)
}

test "grammar_parse_body_tag_matrix_effects_and_sugar" {
  Test.assert_eq(grammar_test_body_tag_agrees("effect GrammarParseEff { fn get() -> i64 } fn main() -> i64 { handle GrammarParseEff.get() { GrammarParseEff.get() -> resume(42) } }", 33), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { ok()? } fn ok() -> i64 { 1 }", 45), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("type GrammarOptBox { value: i64 } fn main(b: GrammarOptBox) -> i64 { b?.value }", 48), 1)
  Test.assert_eq(grammar_test_interp_body_tag(), 46)
}

test "grammar_parse_body_tag_matrix_records_and_loops" {
  Test.assert_eq(grammar_test_body_tag_agrees("type GrammarRecordBox { value: i64 } fn main() -> GrammarRecordBox { GrammarRecordBox { value: 42 } }", 14), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("fn main() -> i64 { for i in 0..3 { 1 } }", 11), 1)
  Test.assert_eq(grammar_test_body_tag_agrees("type GrammarList { Nil, Cons(i64, GrammarList) } fn main(xs: GrammarList) -> i64 { for x in xs { x } }", 47), 1)
}

test "grammar_parse_declaration_table_variants" {
  let src = "type GrammarDeclRecord { value: i64 } type GrammarDeclVariant { One, Two(i64) } effect GrammarDeclEff { fn get() -> i64 } trait GrammarDeclTrait { fn val(self: GrammarDeclRecord) -> i64 } impl GrammarDeclTrait for GrammarDeclRecord { fn val(self: GrammarDeclRecord) -> i64 { 1 } } fn main() -> i64 { 0 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  let entries = pipeline_ast_type_entries(ast)
  Test.assert_eq(type_entry_list_count_kind(entries, 0), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 1), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 2), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 3), 1)
  Test.assert_eq(type_entry_list_count_kind(entries, 4), 1)
}

test "typed_grammar_check_accepts_valid_module" {
  Test.assert_eq(grammar_test_check_errors("fn main() -> i64 { 40 + 2 }"), 0)
}

test "typed_grammar_check_handles_trait_conformance" {
  let src = "trait GrammarCheckValue { fn value(self: i64) -> i64 } type GrammarCheckBox { value: i64 } impl GrammarCheckValue for GrammarCheckBox { fn value(self: i64) -> i64 { self } } fn unwrap<T: GrammarCheckValue>(x: T) -> i64 { x.value() } fn main() -> i64 { 0 }"
  Test.assert_eq(grammar_test_check_errors(src), 0)
}

test "typed_grammar_check_reports_type_error_count" {
  let errors = grammar_test_check_errors("fn main() -> i64 { \"bad\" }")
  Test.assert_eq(if errors > 0 { 1 } else { 0 }, 1)
}

test "grammar_parse_reports_missing_block_close" {
  let src = "fn broken() -> i64 { 1"
  Test.assert_eq(grammar_test_parse_diagnostics(src), 1)
}

test "grammar_parse_recovers_after_missing_block_close" {
  let src = "fn broken() -> i64 { 1\nfn after() -> i64 { 2 }"
  Test.assert_eq(grammar_test_parse_diagnostics(src), 1)
  Test.assert_eq(grammar_test_parse_recovered_fns(src), 2)
}

test "grammar_parse_reports_malformed_function_header" {
  let src = "fn broken -> i64 { 1 }\nfn after() -> i64 { 2 }"
  Test.assert_eq(grammar_test_parse_diagnostics(src), 1)
  Test.assert_eq(grammar_test_parse_recovered_fns(src), 2)
}

test "grammar_method_name_does_not_shadow_global_function" {
  let b = GrammarCollisionBox { value: 0 }
  Test.assert_eq(grammar_collision_same_name(1) * 10 + b.grammar_collision_same_name(1), 31)
}
