use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn grammar_test_tokens(src: str) -> i64 {
  let grammar = weft_grammar()
  grammar.lex(__str_ptr(src), __str_len(src))
}

fn grammar_test_parse_tokens(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let toks = grammar.lex(__str_ptr(src), __str_len(src))
  grammar.parse_tokens(toks, __str_ptr(src), tt)
}

fn grammar_test_parse_source(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  grammar.parse(__str_ptr(src), __str_len(src), tt)
}

fn grammar_test_check_errors(src: str) -> i64 {
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = grammar.parse(__str_ptr(src), __str_len(src), tt)
  grammar.check(fns, __str_ptr(src), tt)
}

type GrammarCollisionBox { value: i64 }

fn grammar_collision_same_name(x: i64) -> i64 { x + 1 }

impl GrammarCollisionBox {
  fn grammar_collision_same_name(self: GrammarCollisionBox, x: i64) -> i64 { x + 10 }
}

test "grammar_lex_exposes_token_stream" {
  let toks = grammar_test_tokens("fn main() -> i64 { 42 }")
  Test.assert_eq(tok_tag(toks, 0), 3)
  Test.assert_eq(tok_v1(toks, 0), 1)
  Test.assert_eq(tok_tag(toks, 1), 2)
  Test.assert_eq(tok_v2(toks, 1), 4)
  Test.assert_eq(tok_tag(toks, tok_count(toks) - 1), 7)
}

test "grammar_parse_tokens_parses_multiple_functions" {
  let fns = grammar_test_parse_tokens("fn alpha() -> i64 { 1 } fn beta() -> i64 { alpha() + 1 }")
  Test.assert_eq(nlist_len(fns), 2)
}

test "grammar_parse_source_matches_pipeline_parse_source" {
  let src = "type GrammarBox<T> { value: T } fn main() -> i64 { 42 }"
  let direct = grammar_test_parse_source(src)
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(direct), nlist_len(pipeline_ast_fns(ast)))
}

test "grammar_parse_source_handles_string_interpolation" {
  let src = "trait GrammarDisplay { fn display(self: i64) -> str } impl GrammarDisplay for i64 { fn display(self: i64) -> str { \"\" } } fn main() -> str { \"value {40 + 2}\" }"
  let fns = grammar_test_parse_source(src)
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(fns), nlist_len(pipeline_ast_fns(ast)))
}

test "typed_grammar_check_accepts_valid_module" {
  Test.assert_eq(grammar_test_check_errors("fn main() -> i64 { 40 + 2 }"), 0)
}

test "typed_grammar_check_handles_trait_conformance" {
  let src = "trait GrammarCheckValue { fn value(self: i64) -> i64 } type GrammarCheckBox { value: i64 } impl GrammarCheckValue for GrammarCheckBox { fn value(self: i64) -> i64 { self } } fn unwrap<T: GrammarCheckValue>(x: T) -> i64 { x.value() } fn main() -> i64 { 0 }"
  Test.assert_eq(grammar_test_check_errors(src), 0)
}

test "typed_grammar_check_reports_type_error_count" {
  let errors = grammar_test_check_errors("fn main() -> i64 { \"bad\" }")
  Test.assert_eq(if errors > 0 { 1 } else { 0 }, 1)
}

test "grammar_method_name_does_not_shadow_global_function" {
  let b = GrammarCollisionBox { value: 0 }
  Test.assert_eq(grammar_collision_same_name(1) * 10 + b.grammar_collision_same_name(1), 31)
}
