use runtime/memory.{*}
-- test/method_dispatch_bug.weft — Regression tests for method dispatch
-- Root cause: synth didn't recurse into perform args, so method calls
-- inside Test.assert_eq(...) weren't converted from tag 32 to tag 41.
-- Fixed by adding tag 32/41 handling in check_expr.

trait V { fn v(self: i64) -> i64 }
trait A_t { fn a(self: i64) -> i64 }
trait B_t { fn b(self: i64) -> i64 }

type Foo { x: i64 }
type Bar { y: i64 }
type F_t { x: i64 }

impl Foo { fn val(self: i64) -> i64 { mem_load64(self) } }
impl Bar { fn val(self: i64) -> i64 { mem_load64(self) + 10 } }

impl V for i64 { fn v(self: i64) -> i64 { self } }
impl V for F_t { fn v(self: i64) -> i64 { mem_load64(self) } }

impl A_t for i64 { fn a(self: i64) -> i64 { 20 } }
impl B_t for i64 { fn b(self: i64) -> i64 { 22 } }

-- Two types with same method name: dispatch must use type_hash
test "impl_type_dispatch" {
  let f = Foo { x: 20 }
  let b = Bar { y: 12 }
  Test.assert_eq(f.val() + b.val(), 42)
}

-- Same trait, different types: must dispatch to correct impl
test "same_trait_diff_types" {
  let f = F_t { x: 42 }
  Test.assert_eq(f.v(), 42)
}

-- Two traits on one type: method hash differs, but verifies no interference
test "two_traits_one_type" {
  let x: i64 = 1
  Test.assert_eq(x.a() + x.b(), 42)
}

-- Method call as argument to another method call
test "method_in_method_arg" {
  let f = Foo { x: 21 }
  let b = Bar { y: 11 }
  Test.assert_eq(f.val() + b.val(), 42)
}

-- Method call result used in binop inside perform
test "method_binop_in_perform" {
  let x: i64 = 21
  Test.assert_eq(x.v() + x.v(), 42)
}

-- Chained method calls inside perform
test "chained_in_perform" {
  let f = F_t { x: 42 }
  Test.assert_eq(f.v(), 42)
}

-- Let-bound vs inline: both should give same result
test "let_vs_inline" {
  let f = F_t { x: 42 }
  let r = f.v()
  Test.assert_eq(r, 42)
}
