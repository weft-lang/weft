-- test/pipeline_transitive_import.weft -- pipeline owns its private imports

use compiler/pipeline.{*}
use compiler/lib.{*}
use runtime/buffer.{*}

test "pipeline_import_alone_can_parse_source" {
  let src = "fn main() -> i64 { 42 }"
  let ast = pipeline_parse_source(__str_ptr(src), __str_len(src))
  Test.assert_eq(nlist_len(pipeline_ast_fns(ast)), 1)
}

test "pipeline_import_alone_can_lower_native" {
  let src = "fn main() -> i64 { 42 }"
  let typed = pipeline_check_source(__str_ptr(src), __str_len(src))
  let native = pipeline_lower_native_ir(typed)
  Test.assert_eq(if buf_len(pipeline_native_code(native)) > 0 { 1 } else { 0 }, 1)
}
