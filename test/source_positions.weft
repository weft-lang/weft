use compiler/source/position.{*}
use compiler/storage.{RawSourceView, raw_source_view}
use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}

fn position_at(text: str, offset: i64) -> SourcePosition { source_position_at(text, offset) }

-- The legacy tables' raw views of the same bytes.
fn raw_view(text: str) -> RawSourceView {
  raw_source_view(runtime_str_ptr(text), __str_len(text))
}

fn source_position_test_bytes(bytes: [i64]) -> str {
  let mut length = 0
  for byte in bytes { length = length + 1 }
  let text = runtime_str_alloc_uninit(length)
  let data = runtime_str_ptr(text)
  let mut index = 0
  for byte in bytes {
    mem_store8_at(data, index, byte)
    index = index + 1
  }
  text
}

fn source_position_test_cr_text(with_lf: i64) -> str {
  let len = if with_lf == 1 { 5 } else { 4 }
  let text = runtime_str_alloc_uninit(len)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 97)
  mem_store8_at(data, 1, 13)
  if with_lf == 1 {
    mem_store8_at(data, 2, 10)
    mem_store8_at(data, 3, 206)
    mem_store8_at(data, 4, 178)
  } else {
    mem_store8_at(data, 2, 206)
    mem_store8_at(data, 3, 178)
  }
  text
}

test "source_position_ascii_and_newline_units" {
  let p = position_at("ab\ncd", 4)
  Test.assert_eq(source_position_line0(p), 1)
  Test.assert_eq(source_position_byte_column0(p), 1)
  Test.assert_eq(source_position_scalar_column0(p), 1)
  Test.assert_eq(source_position_utf16_column0(p), 1)
}

test "source_position_distinguishes_utf8_scalar_and_utf16_columns" {
  let p = position_at("aΩ😀z", 7)
  Test.assert_eq(source_position_byte_column0(p), 7)
  Test.assert_eq(source_position_scalar_column0(p), 3)
  Test.assert_eq(source_position_utf16_column0(p), 4)
}

test "source_position_combining_marks_are_scalars_not_graphemes" {
  let p = position_at("éx", 3)
  Test.assert_eq(source_position_byte_column0(p), 3)
  Test.assert_eq(source_position_scalar_column0(p), 2)
  Test.assert_eq(source_position_utf16_column0(p), 2)
}

test "source_position_crlf_and_bare_cr_are_single_line_breaks" {
  let crlf_text = source_position_test_cr_text(1)
  let cr_text = source_position_test_cr_text(0)
  let crlf = position_at(crlf_text, __str_len(crlf_text))
  let cr = position_at(cr_text, __str_len(cr_text))
  Test.assert_eq(source_position_line0(crlf), 1)
  Test.assert_eq(source_position_scalar_column0(crlf), 1)
  Test.assert_eq(source_position_line0(cr), 1)
  Test.assert_eq(source_position_scalar_column0(cr), 1)
}

test "source_position_clamps_offsets_to_source_bounds" {
  let before = position_at("abc", 0 - 9)
  let after = position_at("abc", 99)
  Test.assert_eq(source_position_byte_column0(before), 0)
  Test.assert_eq(source_position_byte_column0(after), 3)
}

test "source_position_utf8_protocol_can_address_inside_scalar" {
  let p = position_at("Ω", 1)
  Test.assert_eq(source_position_byte_column0(p), 1)
  Test.assert_eq(source_position_scalar_column0(p), 0)
  Test.assert_eq(source_position_utf16_column0(p), 0)
}

test "source_position_rejects_malformed_utf8_before_target" {
  let bytes = [111, 255]
  let text = source_position_test_bytes(bytes[..])
  let p = source_position_at(text, 2)
  Test.assert_eq(source_position_is_valid(p), 0)
  Test.assert_eq(source_position_invalid_offset(p), 1)
}

test "source_position_forward_conversion_covers_all_protocol_units" {
  let text = "aΩ😀z"
  Test.assert_eq(
    source_position_offset_for_line_column(text, 0, 7, source_position_encoding_utf8()),
    7
  )
  Test.assert_eq(
    source_position_offset_for_line_column(text, 0, 3, source_position_encoding_utf32()),
    7
  )
  Test.assert_eq(
    source_position_offset_for_line_column(text, 0, 4, source_position_encoding_utf16()),
    7
  )
}

test "source_position_forward_conversion_clamps_mid_scalar_and_past_line" {
  let text = "😀x\nq"
  Test.assert_eq(
    source_position_offset_for_line_column(text, 0, 1, source_position_encoding_utf16()),
    0
  )
  Test.assert_eq(
    source_position_offset_for_line_column(text, 0, 99, source_position_encoding_utf16()),
    5
  )
  Test.assert_eq(
    source_position_offset_for_line_column(text, 9, 0, source_position_encoding_utf16()),
    __str_len(text)
  )
}

test "source_position_forward_conversion_handles_crlf_lines" {
  let text = source_position_test_cr_text(1)
  Test.assert_eq(
    source_position_offset_for_line_column(text, 1, 1, source_position_encoding_utf16()),
    5
  )
}

test "source_position_decodes_strict_unicode_scalars" {
  let text = "Ω😀"
  Test.assert_eq(source_position_utf8_scalar(text, 0), 937)
  Test.assert_eq(source_position_utf8_scalar(text, 2), 128512)
  Test.assert_eq(source_position_utf8_scalar(text, 1), 0 - 1)
}

fn source_position_assert_malformed(bytes: [i64]) -[Test]> nil {
  let text = source_position_test_bytes(bytes)
  Test.assert_eq(source_position_utf8_width(text, 0), 0 - 1)
  Test.assert_eq(source_position_utf8_scalar(text, 0), 0 - 1)
  Test.assert_eq(source_position_is_valid(source_position_at(text, __str_len(text))), 0)
  nil
}

test "source_position_rejects_overlong_surrogate_and_out_of_range_sequences" {
  let overlong_two = [192, 128]
  let overlong_three = [224, 128, 128]
  let surrogate = [237, 160, 128]
  let above_max = [244, 144, 128, 128]
  let invalid_lead = [248, 128]
  source_position_assert_malformed(overlong_two[..])
  source_position_assert_malformed(overlong_three[..])
  source_position_assert_malformed(surrogate[..])
  source_position_assert_malformed(above_max[..])
  source_position_assert_malformed(invalid_lead[..])
}

test "source_position_width_and_newline_outside_the_text_are_empty" {
  Test.assert_eq(source_position_utf8_width("ab", 2), 0 - 1)
  Test.assert_eq(source_position_utf8_width("ab", 0 - 1), 0 - 1)
  Test.assert_eq(source_position_is_newline_at("a\n", 2), 0)
  Test.assert_eq(source_position_is_newline_at("a\n", 0 - 1), 0)
  Test.assert_eq(source_position_is_newline_at("a\n", 1), 1)
  Test.assert_eq(source_position_is_newline_at("", 0), 0)
}

test "source_position_next_scalar_offset_steps_scalars_and_malformed_bytes" {
  Test.assert_eq(source_position_next_scalar_offset("aΩ", 0), 1)
  Test.assert_eq(source_position_next_scalar_offset("aΩ", 1), 3)
  Test.assert_eq(source_position_next_scalar_offset("aΩ", 3), 3)
  Test.assert_eq(source_position_next_scalar_offset("aΩ", 99), 3)
  let malformed = [255, 97]
  Test.assert_eq(
    source_position_next_scalar_offset(source_position_test_bytes(malformed[..]), 0),
    1
  )
}

-- The legacy tables' raw views and source text share every algorithm, so
-- each representation of the same bytes gives the same answers.
test "source_position_raw_views_agree_with_text" {
  let malformed = [111, 255]
  for text in [
    "",
    "ab\ncd",
    "aΩ😀z",
    "😀x\nq",
    source_position_test_cr_text(1),
    source_position_test_bytes(malformed[..])
  ] {
    let raw = raw_view(text)
    for offset in 0..__str_len(text) + 1 {
      let from_text = source_position_at(text, offset)
      let from_raw = source_position_at(raw, offset)
      Test.assert_eq(source_position_is_valid(from_raw), source_position_is_valid(from_text))
      Test.assert_eq(source_position_line0(from_raw), source_position_line0(from_text))
      Test.assert_eq(
        source_position_byte_column0(from_raw),
        source_position_byte_column0(from_text)
      )
      Test.assert_eq(
        source_position_scalar_column0(from_raw),
        source_position_scalar_column0(from_text)
      )
      Test.assert_eq(
        source_position_utf16_column0(from_raw),
        source_position_utf16_column0(from_text)
      )
      Test.assert_eq(
        source_position_utf8_width(raw, offset),
        source_position_utf8_width(text, offset)
      )
      Test.assert_eq(
        source_position_is_newline_at(raw, offset),
        source_position_is_newline_at(text, offset)
      )
      Test.assert_eq(
        source_position_next_scalar_offset(raw, offset),
        source_position_next_scalar_offset(text, offset)
      )
    }
    for line in 0..3 {
      for column in 0..6 {
        Test.assert_eq(
          source_position_offset_for_line_column(
            raw,
            line,
            column,
            source_position_encoding_utf16()
          ),
          source_position_offset_for_line_column(
            text,
            line,
            column,
            source_position_encoding_utf16()
          )
        )
      }
    }
  }
}
