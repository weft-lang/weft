use compiler/source_position.{*}
use runtime/memory.{mem_store8_at}
use runtime/string.{runtime_str_alloc_uninit, runtime_str_ptr}
use stdlib/test.{*}

fn position_at(text: str, offset: i64) -> SourcePosition {
  source_position_at(__str_ptr(text), __str_len(text), offset)
}

fn source_position_test_cr_text(with_lf: i64) -> str {
  let len = if with_lf == 1 { 5 } else { 4 }
  let text = runtime_str_alloc_uninit(len)
  let data = runtime_str_ptr(text)
  mem_store8_at(data, 0, 97)
  mem_store8_at(data, 1, 13)
  if with_lf == 1 {
    mem_store8_at(data, 2, 10)
    mem_store8_at(data, 3, 206)
    mem_store8_at(data, 4, 178)
  } else {
    mem_store8_at(data, 2, 206)
    mem_store8_at(data, 3, 178)
  }
  text
}

test "source_position_ascii_and_newline_units" {
  let p = position_at("ab\ncd", 4)
  Test.assert_eq(source_position_line0(p), 1)
  Test.assert_eq(source_position_byte_column0(p), 1)
  Test.assert_eq(source_position_scalar_column0(p), 1)
  Test.assert_eq(source_position_utf16_column0(p), 1)
}

test "source_position_distinguishes_utf8_scalar_and_utf16_columns" {
  let p = position_at("aΩ😀z", 7)
  Test.assert_eq(source_position_byte_column0(p), 7)
  Test.assert_eq(source_position_scalar_column0(p), 3)
  Test.assert_eq(source_position_utf16_column0(p), 4)
}

test "source_position_combining_marks_are_scalars_not_graphemes" {
  let p = position_at("éx", 3)
  Test.assert_eq(source_position_byte_column0(p), 3)
  Test.assert_eq(source_position_scalar_column0(p), 2)
  Test.assert_eq(source_position_utf16_column0(p), 2)
}

test "source_position_crlf_and_bare_cr_are_single_line_breaks" {
  let crlf_text = source_position_test_cr_text(1)
  let cr_text = source_position_test_cr_text(0)
  let crlf = position_at(crlf_text, __str_len(crlf_text))
  let cr = position_at(cr_text, __str_len(cr_text))
  Test.assert_eq(source_position_line0(crlf), 1)
  Test.assert_eq(source_position_scalar_column0(crlf), 1)
  Test.assert_eq(source_position_line0(cr), 1)
  Test.assert_eq(source_position_scalar_column0(cr), 1)
}

test "source_position_clamps_offsets_to_source_bounds" {
  let before = position_at("abc", 0 - 9)
  let after = position_at("abc", 99)
  Test.assert_eq(source_position_byte_column0(before), 0)
  Test.assert_eq(source_position_byte_column0(after), 3)
}

test "source_position_utf8_protocol_can_address_inside_scalar" {
  let p = position_at("Ω", 1)
  Test.assert_eq(source_position_byte_column0(p), 1)
  Test.assert_eq(source_position_scalar_column0(p), 0)
  Test.assert_eq(source_position_utf16_column0(p), 0)
}

test "source_position_rejects_malformed_utf8_before_target" {
  let text = runtime_str_alloc_uninit(2)
  let bytes = runtime_str_ptr(text)
  mem_store8_at(bytes, 0, 111)
  mem_store8_at(bytes, 1, 255)
  let p = source_position_at(bytes, 2, 2)
  Test.assert_eq(source_position_is_valid(p), 0)
  Test.assert_eq(source_position_invalid_offset(p), 1)
}

test "source_position_forward_conversion_covers_all_protocol_units" {
  let text = "aΩ😀z"
  let src = __str_ptr(text)
  let n = __str_len(text)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 0, 7, source_position_encoding_utf8()), 7)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 0, 3, source_position_encoding_utf32()), 7)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 0, 4, source_position_encoding_utf16()), 7)
}

test "source_position_forward_conversion_clamps_mid_scalar_and_past_line" {
  let text = "😀x\nq"
  let src = __str_ptr(text)
  let n = __str_len(text)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 0, 1, source_position_encoding_utf16()), 0)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 0, 99, source_position_encoding_utf16()), 5)
  Test.assert_eq(source_position_offset_for_line_column(src, n, 9, 0, source_position_encoding_utf16()), n)
}

test "source_position_forward_conversion_handles_crlf_lines" {
  let text = source_position_test_cr_text(1)
  Test.assert_eq(source_position_offset_for_line_column(__str_ptr(text), __str_len(text), 1, 1, source_position_encoding_utf16()), 5)
}
