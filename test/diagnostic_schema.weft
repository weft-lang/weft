-- 6a: L8 structured diagnostic envelope and typed Diagnose transport.

use compiler/diagnose.{*}
use compiler/lib.{*}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_registry.{*}
use stdlib/diagnostic_type.{*}
use stdlib/semantic_type.{*}

fn diagnostic_schema_full_value() -> Diagnostic {
  let primary = DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 4, 9)
  let related = DiagnosticRelatedLocationCons(
    DiagnosticRelatedLocation("expected type originates here", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
    DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation("value narrowed here", DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 1, 3)),
      DiagnosticRelatedLocationNil
    )
  )
  let fields = DiagnosticFieldCons(
    DiagnosticFieldText("expected", "i64"),
    DiagnosticFieldCons(
      DiagnosticFieldI64("candidate_count", 2),
      DiagnosticFieldCons(
        DiagnosticFieldBool("recoverable", true),
        DiagnosticFieldCons(
          DiagnosticFieldLocation("definition", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
          DiagnosticFieldCons(DiagnosticFieldType("found_type", SemanticTypePrimitive("str")), DiagnosticFieldNil)
        )
      )
    )
  )
  diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassType,
    DiagnosticCodeAssigned("E0123"),
    "expected i64, found str",
    primary,
    related,
    fields
  )
}

fn diagnostic_registry_entry_matches_class(index: i64, expected_code: str, expected_class: str, expected_summary: str) -> i64 {
  match diagnostic_registry_entry(index) {
    DiagnosticRegistryEntry(code, class, summary) -> {
      let code_ok = src_eq(__str_ptr(code), 0, __str_len(code), expected_code)
      let class_name = diagnostic_class_name(class)
      let class_ok = src_eq(__str_ptr(class_name), 0, __str_len(class_name), expected_class)
      let summary_ok = src_eq(__str_ptr(summary), 0, __str_len(summary), expected_summary)
      if code_ok == 1 and class_ok == 1 and summary_ok == 1 { 1 } else { 0 }
    }
  }
}

fn diagnostic_registry_entry_matches(index: i64, expected_code: str, expected_summary: str) -> i64 {
  diagnostic_registry_entry_matches_class(index, expected_code, "module", expected_summary)
}

test "diagnostic_schema_version_is_stable" {
  Test.assert_eq(diagnostic_schema_version(), 1)
}

test "diagnostic_schema_round_trips_core_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_str_eq(diagnostic_severity_name(diagnostic_severity(value)), "error")
  Test.assert_str_eq(diagnostic_class_name(diagnostic_class(value)), "type")
  Test.assert_eq(if diagnostic_code_is_assigned(diagnostic_code(value)) { 1 } else { 0 }, 1)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code(value)), "E0123")
  Test.assert_str_eq(diagnostic_message(value), "expected i64, found str")
}

test "diagnostic_schema_preserves_source_range" {
  let primary = diagnostic_primary(diagnostic_schema_full_value())
  Test.assert_eq(diagnostic_location_start(primary), 4)
  Test.assert_eq(diagnostic_location_end(primary), 9)
  let named = match diagnostic_location_source(primary) {
    DiagnosticSourceNamed(name) -> src_eq(__str_ptr(name), 0, __str_len(name), "example.weft")
    _ -> 0
  }
  Test.assert_eq(named, 1)
}

test "diagnostic_schema_preserves_related_and_extensible_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_eq(diagnostic_related_count(diagnostic_related(value)), 2)
  Test.assert_eq(diagnostic_field_count(diagnostic_fields(value)), 5)
}

test "diagnostic_schema_uncoded_state_is_explicit" {
  let value = diagnostic_uncoded(
    DiagnosticSeverityWarning,
    DiagnosticClassParse,
    "legacy producer",
    DiagnosticLocationNone
  )
  Test.assert_eq(if diagnostic_code_is_assigned(diagnostic_code(value)) { 1 } else { 0 }, 0)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code(value)), "")
  Test.assert_eq(diagnostic_location_start(diagnostic_primary(value)), 0 - 1)
  Test.assert_eq(diagnostic_location_end(diagnostic_primary(value)), 0 - 1)
}

test "diagnostic_schema_other_class_is_union_extensible" {
  let value = diagnostic_uncoded(
    DiagnosticSeverityNote,
    DiagnosticClassOther("future-family"),
    "future diagnostic",
    DiagnosticLocationNone
  )
  Test.assert_str_eq(diagnostic_class_name(diagnostic_class(value)), "future-family")
  Test.assert_str_eq(diagnostic_severity_name(diagnostic_severity(value)), "note")
}

test "diagnostic_registry_stable_prefix_is_append_only" {
  Test.assert_eq(if diagnostic_registry_count() >= 21 { 1 } else { 0 }, 1)
  Test.assert_eq(diagnostic_registry_entry_matches(0, "E4001", "module import graph contains a cycle"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches(1, "E4002", "qualified module member does not exist"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches(2, "E4003", "qualified module member is ambiguous"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches(3, "E4004", "qualified module member is not visible"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches(4, "E4005", "module member has the wrong value kind"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches(5, "E4006", "re-export widens the original visibility"), 1)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_import_cycle()), "E4001")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_member_missing()), "E4002")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_member_ambiguous()), "E4003")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_member_invisible()), "E4004")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_member_wrong_kind()), "E4005")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_module_reexport_widening()), "E4006")
  Test.assert_eq(diagnostic_registry_entry_matches_class(6, "E5001", "link", "dependency manifest is malformed"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(7, "E5002", "link", "dependency key does not match its package name"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(8, "E5003", "link", "dependency resolves to conflicting source identities"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(9, "E5004", "link", "package dependency graph contains a cycle"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(10, "E5005", "link", "package lock is malformed or unsupported"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(11, "E5006", "link", "resolved package identity does not match the lock"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(12, "E5007", "link", "dependency manifest attempts to grant package trust"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(13, "E5008", "link", "binding module lacks an exact root trust grant"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(14, "E5009", "link", "package export does not resolve to the required public declaration"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(15, "W0001", "parse", "identifier contains mixed scripts"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(16, "W0002", "parse", "identifier is confusable with another spelling in this source"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(17, "W0003", "parse", "source text contains an invisible bidi formatting control"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(18, "E1001", "type", "name is not defined in this scope"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(19, "E1002", "type", "expression does not match the expected type"), 1)
  Test.assert_eq(diagnostic_registry_entry_matches_class(20, "E1003", "type", "match does not cover every possible value"), 1)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_manifest_malformed()), "E5001")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_name_mismatch()), "E5002")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_source_conflict()), "E5003")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_dependency_cycle()), "E5004")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_lock_malformed()), "E5005")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_lock_mismatch()), "E5006")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_dependency_trust_grant()), "E5007")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_binding_trust_mismatch()), "E5008")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_package_export_invalid()), "E5009")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_identifier_mixed_script()), "W0001")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_identifier_confusable()), "W0002")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_source_bidi_formatting()), "W0003")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_unknown_name()), "E1001")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_type_mismatch()), "E1002")
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code_non_exhaustive_match()), "E1003")
}
