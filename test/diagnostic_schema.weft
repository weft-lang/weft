-- 6a: L8 structured diagnostic envelope and typed Diagnose transport.

use "compiler/diagnose.weft"

fn diagnostic_schema_full_value() -> Diagnostic {
  let primary = DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 4, 9)
  let related = DiagnosticRelatedLocationCons(
    DiagnosticRelatedLocation("expected type originates here", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
    DiagnosticRelatedLocationCons(
      DiagnosticRelatedLocation("value narrowed here", DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 1, 3)),
      DiagnosticRelatedLocationNil
    )
  )
  let fields = DiagnosticFieldCons(
    DiagnosticFieldText("expected", "i64"),
    DiagnosticFieldCons(
      DiagnosticFieldI64("candidate_count", 2),
      DiagnosticFieldCons(
        DiagnosticFieldBool("recoverable", true),
        DiagnosticFieldCons(
          DiagnosticFieldLocation("definition", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
          DiagnosticFieldNil
        )
      )
    )
  )
  diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassType,
    DiagnosticCodeAssigned("E0123"),
    "expected i64, found str",
    primary,
    related,
    fields
  )
}

test "diagnostic_schema_version_is_stable" {
  Test.assert_eq(diagnostic_schema_version(), 1)
}

test "diagnostic_schema_round_trips_core_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_str_eq(diagnostic_severity_name(diagnostic_severity(value)), "error")
  Test.assert_str_eq(diagnostic_class_name(diagnostic_class(value)), "type")
  Test.assert_eq(if diagnostic_code_is_assigned(diagnostic_code(value)) { 1 } else { 0 }, 1)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code(value)), "E0123")
  Test.assert_str_eq(diagnostic_message(value), "expected i64, found str")
}

test "diagnostic_schema_preserves_source_range" {
  let primary = diagnostic_primary(diagnostic_schema_full_value())
  Test.assert_eq(diagnostic_location_start(primary), 4)
  Test.assert_eq(diagnostic_location_end(primary), 9)
  let named = match diagnostic_location_source(primary) {
    DiagnosticSourceNamed(name) -> src_eq(__str_ptr(name), 0, __str_len(name), "example.weft")
    _ -> 0
  }
  Test.assert_eq(named, 1)
}

test "diagnostic_schema_preserves_related_and_extensible_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_eq(diagnostic_related_count(diagnostic_related(value)), 2)
  Test.assert_eq(diagnostic_field_count(diagnostic_fields(value)), 4)
}

test "diagnostic_schema_uncoded_state_is_explicit" {
  let value = diagnostic_uncoded(
    DiagnosticSeverityWarning,
    DiagnosticClassParse,
    "legacy producer",
    DiagnosticLocationNone
  )
  Test.assert_eq(if diagnostic_code_is_assigned(diagnostic_code(value)) { 1 } else { 0 }, 0)
  Test.assert_str_eq(diagnostic_code_text(diagnostic_code(value)), "")
  Test.assert_eq(diagnostic_location_start(diagnostic_primary(value)), 0 - 1)
  Test.assert_eq(diagnostic_location_end(diagnostic_primary(value)), 0 - 1)
}

test "diagnostic_schema_other_class_is_union_extensible" {
  let value = diagnostic_uncoded(
    DiagnosticSeverityNote,
    DiagnosticClassOther("future-family"),
    "future diagnostic",
    DiagnosticLocationNone
  )
  Test.assert_str_eq(diagnostic_class_name(diagnostic_class(value)), "future-family")
  Test.assert_str_eq(diagnostic_severity_name(diagnostic_severity(value)), "note")
}
