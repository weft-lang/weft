-- L8 structured diagnostic envelope and typed Diagnose transport.

use compiler/diagnose.{*}
use compiler/lib.{*}
use stdlib/diagnostic
use stdlib/diagnostic.{*}
use stdlib/diagnostic/registry
use stdlib/option.{None, Some, Option}
use stdlib/string
use stdlib/diagnostic/schema.{*}
use stdlib/semantic_type.{*}

fn diagnostic_schema_full_value() -> Diagnostic {
  let primary = DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 4, 9)
  let related = DiagnosticRelatedLocationCons(
    DiagnosticRelatedLocation("expected type originates here", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
    DiagnosticRelatedLocationCons(
    DiagnosticRelatedLocation("value narrowed here", DiagnosticSourceRange(DiagnosticSourceNamed("example.weft"), 1, 3)),
    DiagnosticRelatedLocationNil
  )
  )
  let fields = DiagnosticFieldCons(
    DiagnosticFieldText("expected", "i64"),
    DiagnosticFieldCons(
    DiagnosticFieldI64("candidate_count", 2),
    DiagnosticFieldCons(
    DiagnosticFieldU64("candidate_limit", 18446744073709551615),
    DiagnosticFieldCons(
    DiagnosticFieldBool("recoverable", true),
    DiagnosticFieldCons(
    DiagnosticFieldLocation("definition", DiagnosticSourceRange(DiagnosticSourceNamed("types.weft"), 10, 14)),
    DiagnosticFieldCons(
    DiagnosticFieldType("found_type", SemanticTypePrimitive("str")),
    DiagnosticFieldCons(
    DiagnosticFieldEffectAtom("required_effect", SemanticEffectAtom("State", SemanticTypeFactListCons(SemanticTypePrimitive("str"), SemanticTypeFactListNil))),
    DiagnosticFieldCons(
    DiagnosticFieldEffectSet("available_effects", SemanticEffectsClosed(SemanticEffectAtomFactListCons(SemanticEffectAtom("IO", SemanticTypeFactListNil), SemanticEffectAtomFactListNil))),
    DiagnosticFieldNil
  )
  )
  )
  )
  )
  )
  )
  )
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassType,
    DiagnosticCodeAssigned("E0123"),
    "expected i64, found str",
    primary,
    related,
    fields
  )
}

fn diagnostic_registry_entry_matches_class(index: usize, expected_code: str, expected_class: str, expected_summary: str) -> bool {
  match registry.get(index) {
    None -> false
    Some(entry) -> match entry.code {
      DiagnosticCodeAssigned(code) -> code == expected_code and entry.class.name() == expected_class and entry.summary == expected_summary
      DiagnosticCodeUnassigned -> false
    }
  }
}

fn diagnostic_registry_entry_matches(index: usize, expected_code: str, expected_summary: str) -> bool {
  diagnostic_registry_entry_matches_class(index, expected_code, "module", expected_summary)
}

test "diagnostic_schema_version_is_stable" {
  Test.assert_eq(diagnostic.schema_version(), 1)
}

test "diagnostic_schema_round_trips_core_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_str_eq(value.severity().name(), "error")
  Test.assert_str_eq(value.class().name(), "type")
  Test.assert_eq(if value.code().is_assigned() { 1 } else { 0 }, 1)
  Test.assert_str_eq(value.code().text(), "E0123")
  Test.assert_str_eq(value.message(), "expected i64, found str")
}

test "diagnostic_schema_preserves_source_range" {
  let primary = diagnostic_schema_full_value().primary()
  match primary {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), start, end) -> {
      Test.assert_str_eq(name, "example.weft")
      Test.assert_eq_usize(start, 4)
      Test.assert_eq_usize(end, 9)
    }
    _ -> Test.assert_true(false)
  }
}

test "diagnostic_schema_preserves_related_and_extensible_fields" {
  let value = diagnostic_schema_full_value()
  Test.assert_eq_usize(value.related().len(), 2)
  Test.assert_eq_usize(value.fields().len(), 8)
}

test "diagnostic_schema_uncoded_state_is_explicit" {
  let value = diagnostic.uncoded(
    DiagnosticSeverityWarning,
    DiagnosticClassParse,
    "legacy producer",
    DiagnosticLocationNone
  )
  Test.assert_eq(if value.code().is_assigned() { 1 } else { 0 }, 0)
  Test.assert_str_eq(value.code().text(), "")
  Test.assert_true(match value.primary() {
    DiagnosticLocationNone -> true
    DiagnosticSourceRange(source, start, end) -> false
  })
}

test "diagnostic_schema_other_class_is_union_extensible" {
  let value = diagnostic.uncoded(
    DiagnosticSeverityNote,
    DiagnosticClassOther("future-family"),
    "future diagnostic",
    DiagnosticLocationNone
  )
  Test.assert_str_eq(value.class().name(), "future-family")
  Test.assert_str_eq(value.severity().name(), "note")
}

test "diagnostic_registry_stable_prefix_is_append_only" {
  Test.assert_true(registry.len() >= 28)
  Test.assert_true(diagnostic_registry_entry_matches(0, "E4001", "module import graph contains a cycle"))
  Test.assert_true(diagnostic_registry_entry_matches(1, "E4002", "qualified module member does not exist"))
  Test.assert_true(diagnostic_registry_entry_matches(2, "E4003", "qualified module member is ambiguous"))
  Test.assert_true(diagnostic_registry_entry_matches(3, "E4004", "qualified module member is not visible"))
  Test.assert_true(diagnostic_registry_entry_matches(4, "E4005", "module member has the wrong value kind"))
  Test.assert_true(diagnostic_registry_entry_matches(5, "E4006", "re-export widens the original visibility"))
  Test.assert_str_eq(registry.module_import_cycle().text(), "E4001")
  Test.assert_str_eq(registry.module_member_missing().text(), "E4002")
  Test.assert_str_eq(registry.module_member_ambiguous().text(), "E4003")
  Test.assert_str_eq(registry.module_member_invisible().text(), "E4004")
  Test.assert_str_eq(registry.module_member_wrong_kind().text(), "E4005")
  Test.assert_str_eq(registry.module_reexport_widening().text(), "E4006")
  Test.assert_true(diagnostic_registry_entry_matches_class(6, "E5001", "link", "dependency manifest is malformed"))
  Test.assert_true(diagnostic_registry_entry_matches_class(7, "E5002", "link", "dependency key does not match its package name"))
  Test.assert_true(diagnostic_registry_entry_matches_class(8, "E5003", "link", "dependency resolves to conflicting source identities"))
  Test.assert_true(diagnostic_registry_entry_matches_class(9, "E5004", "link", "package dependency graph contains a cycle"))
  Test.assert_true(diagnostic_registry_entry_matches_class(10, "E5005", "link", "package lock is malformed or unsupported"))
  Test.assert_true(diagnostic_registry_entry_matches_class(11, "E5006", "link", "resolved package identity does not match the lock"))
  Test.assert_true(diagnostic_registry_entry_matches_class(12, "E5007", "link", "dependency manifest attempts to grant package trust"))
  Test.assert_true(diagnostic_registry_entry_matches_class(13, "E5008", "link", "binding module lacks an exact root trust grant"))
  Test.assert_true(diagnostic_registry_entry_matches_class(14, "E5009", "link", "package export does not resolve to the required public declaration"))
  Test.assert_true(diagnostic_registry_entry_matches_class(15, "W0001", "parse", "identifier contains mixed scripts"))
  Test.assert_true(diagnostic_registry_entry_matches_class(16, "W0002", "parse", "identifier is confusable with another spelling in this source"))
  Test.assert_true(diagnostic_registry_entry_matches_class(17, "W0003", "parse", "source text contains an invisible bidi formatting control"))
  Test.assert_true(diagnostic_registry_entry_matches_class(18, "E1001", "type", "name is not defined in this scope"))
  Test.assert_true(diagnostic_registry_entry_matches_class(19, "E1002", "type", "expression does not match the expected type"))
  Test.assert_true(diagnostic_registry_entry_matches_class(20, "E1003", "type", "match does not cover every possible value"))
  Test.assert_true(diagnostic_registry_entry_matches_class(21, "E2001", "effect", "required effect is not available in this context"))
  Test.assert_true(diagnostic_registry_entry_matches_class(22, "E1004", "type", "type does not satisfy a required trait"))
  Test.assert_true(diagnostic_registry_entry_matches_class(23, "E0001", "parse", "source text cannot be tokenized as Weft"))
  Test.assert_true(diagnostic_registry_entry_matches_class(24, "E0002", "parse", "source tokens do not match the Weft grammar"))
  Test.assert_true(diagnostic_registry_entry_matches_class(25, "E0003", "parse", "syntax is recognized but not supported"))
  Test.assert_true(diagnostic_registry_entry_matches_class(27, "E5010", "link", "native binding has no declaration for the compilation target"))
  Test.assert_str_eq(registry.native_binding_target_missing().text(), "E5010")
  Test.assert_true(diagnostic_registry_entry_matches_class(28, "E5011", "link", "locked dependency is absent from the package cache"))
  Test.assert_str_eq(registry.package_cache_missing().text(), "E5011")
  Test.assert_true(diagnostic_registry_entry_matches_class(31, "E5014", "link", "trusted dependency update requires explicit capability review"))
  Test.assert_str_eq(registry.package_trust_review().text(), "E5014")
  Test.assert_true(diagnostic_registry_entry_matches_class(32, "E9001", "test", "property is falsified by a reproducible choice program"))
  Test.assert_true(diagnostic_registry_entry_matches_class(33, "E9002", "test", "property generation exhausted its bounded discard budget"))
  Test.assert_true(diagnostic_registry_entry_matches_class(34, "E9003", "test", "Draw handler returned a choice outside its promised domain"))
  Test.assert_str_eq(registry.property_falsified().text(), "E9001")
  Test.assert_str_eq(registry.property_generation_exhausted().text(), "E9002")
  Test.assert_str_eq(registry.property_draw_contract().text(), "E9003")
  Test.assert_true(diagnostic_registry_entry_matches_class(35, "E5015", "link", "embedded SDK is corrupt or incompatible"))
  Test.assert_true(diagnostic_registry_entry_matches_class(36, "E5016", "link", "canonical SDK path is unavailable"))
  Test.assert_true(diagnostic_registry_entry_matches_class(37, "E5017", "link", "SDK manifest is malformed or incompatible"))
  Test.assert_str_eq(registry.sdk_corrupt().text(), "E5015")
  Test.assert_str_eq(registry.sdk_path_unavailable().text(), "E5016")
  Test.assert_str_eq(registry.sdk_manifest_invalid().text(), "E5017")
  Test.assert_str_eq(registry.package_manifest_malformed().text(), "E5001")
  Test.assert_str_eq(registry.package_name_mismatch().text(), "E5002")
  Test.assert_str_eq(registry.package_source_conflict().text(), "E5003")
  Test.assert_str_eq(registry.package_dependency_cycle().text(), "E5004")
  Test.assert_str_eq(registry.package_lock_malformed().text(), "E5005")
  Test.assert_str_eq(registry.package_lock_mismatch().text(), "E5006")
  Test.assert_str_eq(registry.package_dependency_trust_grant().text(), "E5007")
  Test.assert_str_eq(registry.package_binding_trust_mismatch().text(), "E5008")
  Test.assert_str_eq(registry.package_export_invalid().text(), "E5009")
  Test.assert_str_eq(registry.identifier_mixed_script().text(), "W0001")
  Test.assert_str_eq(registry.identifier_confusable().text(), "W0002")
  Test.assert_str_eq(registry.source_bidi_formatting().text(), "W0003")
  Test.assert_str_eq(registry.unknown_name().text(), "E1001")
  Test.assert_str_eq(registry.type_mismatch().text(), "E1002")
  Test.assert_str_eq(registry.non_exhaustive_match().text(), "E1003")
  Test.assert_str_eq(registry.effect_unavailable().text(), "E2001")
  Test.assert_str_eq(registry.trait_conformance().text(), "E1004")
  Test.assert_str_eq(registry.invalid_source().text(), "E0001")
  Test.assert_str_eq(registry.syntax_error().text(), "E0002")
  Test.assert_str_eq(registry.unsupported_syntax().text(), "E0003")
}

test "diagnostic registry entries couple every code to its teaching body" {
  let origin: usize = 0
  for index in origin..registry.len() {
    let entry = registry.get(index).unwrap()
    match entry.code {
      DiagnosticCodeAssigned(code) -> Test.assert_true(code.len() == 5)
      DiagnosticCodeUnassigned -> Test.assert_true(false)
    }
    Test.assert_true(entry.explanation.len() >= 180)
    Test.assert_true(entry.explanation.find("What happened:").is_some())
    Test.assert_true(entry.explanation.find("How to fix:").is_some())
    Test.assert_true(entry.explanation.find("Example:").is_some())
  }
}

test "diagnostic registry lookups preserve append positions and finite absence" {
  Test.assert_eq_usize(registry.len(), 38)
  let absent: [usize; 3] = [registry.len(), registry.len() + 1, 18446744073709551615]
  for index in absent {
    match registry.get(index) { None -> Test.assert_true(true) Some(entry) -> Test.assert_true(false) }
  }
}
