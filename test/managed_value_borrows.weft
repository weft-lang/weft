use stdlib/test.{Test}

type ManagedBorrowValue {
  text: str
}

fn managed_borrow_text(value: borrow ManagedBorrowValue) -> str {
  value.text
}

fn managed_borrow_pair(
  first: borrow ManagedBorrowValue,
  second: borrow ManagedBorrowValue
) -> i64 {
  first.text.len() + second.text.len()
}

test "ordinary managed values support reusable shared borrows" {
  let value = ManagedBorrowValue { text: "weft" }
  Test.assert_str_eq(managed_borrow_text(value), "weft")
  Test.assert_str_eq(managed_borrow_text(value), "weft")
  Test.assert_str_eq(value.text, "weft")
}

test "ordinary managed aliases may be borrowed together for observation" {
  let value = ManagedBorrowValue { text: "weft" }
  let alias = value
  Test.assert_eq(managed_borrow_pair(value, alias), 8)
}
