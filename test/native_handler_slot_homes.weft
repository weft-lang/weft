use compiler/backend/aarch64/codegen.{*}
use compiler/backend/aarch64/encode.{*}
use compiler/ir/data.{*}
use compiler/storage.{*}
use compiler/pipeline.{*}
use runtime/buffer.{*}

fn handler_slot_blocks(first_slot: i64, count: i64, aborts: bool) -> IrBlockList {
  let mut insts = IrInstCons(ir_inst_const_i64(count - 1, 42), IrInstNil)
  if aborts { insts = IrInstCons(ir_inst_abort_landing_i64(9), insts) } else { nil }
  insts = IrInstCons(ir_inst_handle_i64(8, 0, 1, IrHandlerClauseBodyNil, 0), insts)
  for slot in first_slot..8 { insts = IrInstCons(ir_inst_slot_i64(slot), insts) }
  IrBlockListCons(ir_block_new_term(0, insts, ir_term_return(count - 1)), IrBlockListNil)
}

test "abort-surviving cells have disjoint frame homes beyond values and handler scratch" {
  for count in [16, 260, 300, 1024] {
    let blocks = handler_slot_blocks(0, count, true)
    let homes = pipeline_ir_native_identity_home_facts_with_handler_scratch(count, blocks, 0)
    let allocated = pipeline_ir_native_value_home_facts_with_handler_scratch(count, blocks, 0, 0)
    let frame = pipeline_ir_native_scalar_frame_size_for_blocks(0, blocks)
    for slot in 0..8 {
      let home = pipeline_ir_native_value_home_lookup(homes, slot)
      Test.assert_true(home < 0)
      Test.assert_eq(home, pipeline_ir_native_value_home_lookup(allocated, slot))
      let offset = (0 - home - 1) * 8
      Test.assert_true(offset >= (count + 2 - 8) * 8)
      Test.assert_true(offset + 8 <= frame)
      for other in 0..slot { Test.assert_true(home != pipeline_ir_native_value_home_lookup(homes, other)) }
    }
    Test.assert_eq(pipeline_ir_native_handler_scratch_base(homes), count)
    Test.assert_eq(pipeline_ir_native_value_home_lookup(homes, count), pipeline_ir_native_identity_home(count))
    Test.assert_eq(pipeline_ir_native_value_home_lookup(homes, count + 1), pipeline_ir_native_identity_home(count + 1))
  }
}

test "handler cell placement preserves immutable parameter homes" {
  let blocks = handler_slot_blocks(3, 16, true)
  let homes = pipeline_ir_native_identity_home_facts_with_handler_scratch(16, blocks, 0)
  for value in 0..3 { Test.assert_eq(pipeline_ir_native_value_home_lookup(homes, value), pipeline_ir_native_identity_home(value)) }
  for value in 3..8 { Test.assert_true(pipeline_ir_native_value_home_lookup(homes, value) < 0) }
}

test "handlers without an abort landing retain their ordinary local homes" {
  let blocks = handler_slot_blocks(0, 16, false)
  let homes = pipeline_ir_native_identity_home_facts_with_handler_scratch(16, blocks, 0)
  Test.assert_eq(pipeline_ir_native_value_home_fact_count(homes), 18)
  for value in 0..8 { Test.assert_eq(pipeline_ir_native_value_home_lookup(homes, value), pipeline_ir_native_identity_home(value)) }
}

test "address-taking uses the same relocated cell home as loads and stores" {
  for offset in [0, 8, 128, 2048] {
    let assigned = pipeline_ir_native_pinned_slot_new(2, 0 - offset / 8 - 1, 0, 0)
    let homes = pipeline_ir_native_value_home_facts(16, assigned)
    let code = buf_new(64)
    let fm = fmap_new()
    pipeline_ir_native_emit_address_of_slot(code, 4, 2, fm, homes)
    Test.assert_eq(pipeline_native_code_word(code, 0), encode_add_imm(17, 31, offset))
    Test.assert_eq(pipeline_native_code_word(code, 4), encode_add_imm(23, 17, 0))
  }
}
