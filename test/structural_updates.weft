use "runtime/rc_implicit_test.weft"

type NominalUpdatePair {
  x: i64,
  y: i64,
}

type NominalUpdateWide {
  lead: (i64, i64),
  answer: i64,
  name: str,
}

type NominalUpdateArray {
  items: [i64; 2],
  n: i64,
}

type NominalUpdateManaged {
  probe: RuntimeRcProbe,
  n: i64,
}

fn structural_update_pair(value: {x: i64, y: i64}) -> {x: i64, y: i64} {
  value.{x: 40}
}

fn structural_update_add(value: {x: i64}) -> {x: i64, y: i64} {
  value.{y: 2}
}

fn structural_update_change(value: {x: i64}) -> {x: str, y: i64} {
  value.{x: "weft", y: 38}
}

fn structural_update_generic<T>(value: {x: T, y: i64}, next: T) -> {x: T, y: i64} {
  value.{x: next}
}

fn structural_update_empty(value: {x: i64, y: i64}) -> {x: i64, y: i64} {
  value.{}
}

fn structural_update_array(value: {items: [i64; 2], n: i64}) -> {items: [i64; 2], n: i64} {
  value.{items: [20, 22]}
}

fn structural_update_empty_add(value: {}) -> {answer: i64} {
  value.{answer: 42}
}

fn structural_update_nested(value: {inner: {x: i64, y: i64}, name: str}) -> {inner: {x: i64, y: i64}, name: str} {
  let inner = value.inner.{x: 40}
  value.{inner: inner}
}

effect StructuralUpdateRead {
  fn next() -> i64
}

fn structural_update_effectful(value: {x: i64, y: i64}) -[StructuralUpdateRead]> {x: i64, y: i64} {
  value.{x: StructuralUpdateRead.next()}
}

fn structural_update_handle(value: {x: i64, y: i64}) -> {x: i64, y: i64} {
  handle structural_update_effectful(value) {
    StructuralUpdateRead.next() -> resume(40)
  }
}

fn structural_update_owned_base(probe: RuntimeRcProbe) -> {probe: RuntimeRcProbe, n: i64} {
  {probe: probe, n: 1}
}

fn structural_update_three_field_base() -> {alpha: i64, beta: i64, gamma: i64} {
  {alpha: 11, beta: 22, gamma: 33}
}

fn structural_update_direct_call_base() -> {alpha: i64, beta: i64, gamma: i64} {
  structural_update_three_field_base().{beta: 44}
}

fn structural_update_borrowed_managed_count(probe: RuntimeRcProbe) -> i64 {
  let base = {probe: probe, n: 1}
  let updated = base.{n: 2}
  runtime_rc_probe_count(probe) * 10 + updated.n
}

fn structural_update_owned_managed_count(probe: RuntimeRcProbe) -> i64 {
  let updated = structural_update_owned_base(probe).{n: 2}
  runtime_rc_probe_count(probe) * 10 + updated.n
}

fn structural_update_overwrite_managed_count(old: RuntimeRcProbe, next: RuntimeRcProbe) -> i64 {
  let base = {probe: old, n: 1}
  let updated = base.{probe: next, n: 2}
  runtime_rc_probe_count(old) * 100 + runtime_rc_probe_count(next) * 10 + updated.n
}

fn nominal_update_pair(value: NominalUpdatePair) -> NominalUpdatePair {
  value.{x: 40}
}

fn nominal_update_owned_pair() -> NominalUpdatePair {
  NominalUpdatePair { x: 1, y: 2 }.{x: 40}
}

fn nominal_update_empty(value: NominalUpdatePair) -> NominalUpdatePair {
  value.{}
}

fn nominal_update_generic<T>(value: NominalUpdatePair, next: i64) -> NominalUpdatePair {
  value.{x: next}
}

fn nominal_update_array_copy(value: NominalUpdateArray) -> NominalUpdateArray {
  value.{n: 40}
}

fn nominal_update_array_replace(value: NominalUpdateArray) -> NominalUpdateArray {
  value.{items: [20, 22]}
}

fn nominal_update_managed_count(probe: RuntimeRcProbe) -> i64 {
  let base = NominalUpdateManaged { probe: probe, n: 1 }
  let updated = base.{n: 2}
  runtime_rc_probe_count(probe) * 10 + updated.n
}

fn nominal_update_overwrite_managed_count(old: RuntimeRcProbe, next: RuntimeRcProbe) -> i64 {
  let base = NominalUpdateManaged { probe: old, n: 1 }
  let updated = base.{probe: next, n: 2}
  runtime_rc_probe_count(old) * 100 + runtime_rc_probe_count(next) * 10 + updated.n
}

effect NominalUpdateRead {
  fn next() -> i64
}

fn nominal_update_effectful(value: NominalUpdatePair) -[NominalUpdateRead]> NominalUpdatePair {
  value.{x: NominalUpdateRead.next()}
}

fn nominal_update_handle(value: NominalUpdatePair) -> NominalUpdatePair {
  handle nominal_update_effectful(value) {
    NominalUpdateRead.next() -> resume(40)
  }
}

test "functional update overwrites and adds structural fields" {
  let pair = structural_update_pair({y: 2, x: 1})
  let added = structural_update_add({x: 40})
  Test.assert_eq(pair.x, 40)
  Test.assert_eq(pair.y, 2)
  Test.assert_eq(added.x, 40)
  Test.assert_eq(added.y, 2)
}

test "functional update preserves every unchanged direct-call result lane" {
  let updated = structural_update_direct_call_base()
  Test.assert_eq(updated.alpha, 11)
  Test.assert_eq(updated.beta, 44)
  Test.assert_eq(updated.gamma, 33)
}

test "functional update changes an overwritten field type" {
  let changed = structural_update_change({x: 0})
  Test.assert_eq(__str_len(changed.x) + changed.y, 42)
}

test "functional update evaluates its base once and updates left to right" {
  let mut state = 0
  let updated = ({
    state = state * 10 + 1
    {x: state, y: 0}
  }).{
    y: { state = state * 10 + 2 state },
    x: { state = state * 10 + 3 state },
  }
  Test.assert_eq(state, 123)
  Test.assert_eq(updated.y, 12)
  Test.assert_eq(updated.x, 123)
}

test "functional update crosses generic calls and CFG values" {
  let next = if true { 40 } else { 0 }
  let updated = structural_update_generic<i64>({y: 2, x: 1}, next)
  Test.assert_eq(updated.x + updated.y, 42)
}

test "empty functional update preserves the complete shape" {
  let updated = structural_update_empty({y: 2, x: 40})
  Test.assert_eq(updated.x + updated.y, 42)
}

test "functional update contextualises array-valued fields" {
  let updated = structural_update_array({n: 0, items: [0, 0]})
  let items = updated.items
  Test.assert_eq(items[0] + items[1], 42)
}

test "functional update extends the empty structural record" {
  Test.assert_eq(structural_update_empty_add({}).answer, 42)
}

test "functional update transports nested shapes and unchanged managed fields" {
  let updated = structural_update_nested({name: "weft", inner: {y: 2, x: 1}})
  Test.assert_eq(updated.inner.x, 40)
  Test.assert_eq(updated.inner.y, 2)
  Test.assert_eq(__str_len(updated.name), 4)
}

test "functional update crosses closure capture and return transport" {
  let value = {x: 1, y: 2}
  let update = next => value.{x: next}
  let updated = update(40)
  Test.assert_eq(updated.x, 40)
  Test.assert_eq(updated.y, 2)
}

test "functional update fields compose effects and handler transport" {
  let updated = structural_update_handle({y: 2, x: 1})
  Test.assert_eq(updated.x, 40)
  Test.assert_eq(updated.y, 2)
}

test "functional update retains unchanged managed fields from borrowed bases" {
  let probe = runtime_rc_probe_new(0)
  Test.assert_eq(structural_update_borrowed_managed_count(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "functional update consumes owned bases after retaining unchanged fields" {
  let probe = runtime_rc_probe_new(0)
  Test.assert_eq(structural_update_owned_managed_count(probe), 22)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)
}

test "functional update does not retain overwritten managed fields" {
  let old = runtime_rc_probe_new(0)
  let next = runtime_rc_probe_new(0)
  Test.assert_eq(structural_update_overwrite_managed_count(old, next), 332)
  Test.assert_eq(runtime_rc_probe_count(old), 1)
  Test.assert_eq(runtime_rc_probe_count(next), 1)
}

test "nominal functional update preserves identity and untouched fields" {
  let borrowed = nominal_update_pair(NominalUpdatePair { x: 1, y: 2 })
  let owned = nominal_update_owned_pair()
  let empty = nominal_update_empty(NominalUpdatePair { x: 20, y: 22 })
  let chained = NominalUpdatePair { x: 0, y: 0 }.{x: 20}.{y: 22}
  Test.assert_eq(borrowed.x + borrowed.y, 42)
  Test.assert_eq(owned.x + owned.y, 42)
  Test.assert_eq(empty.x + empty.y, 42)
  Test.assert_eq(chained.x + chained.y, 42)
}

test "nominal update offsets include widened inline fields" {
  let base = NominalUpdateWide { lead: (20, 22), answer: 0, name: "weft" }
  let updated = base.{answer: 38}
  Test.assert_eq(updated.answer + __str_len(updated.name), 42)
}

test "nominal functional update evaluates its base once and fields left to right" {
  let mut state = 0
  let updated = ({
    state = state * 10 + 1
    NominalUpdatePair { x: state, y: 0 }
  }).{
    y: { state = state * 10 + 2 state },
    x: { state = state * 10 + 3 state },
  }
  Test.assert_eq(state, 123)
  Test.assert_eq(updated.y, 12)
  Test.assert_eq(updated.x, 123)
}

test "nominal functional update crosses generic specializations" {
  let updated = nominal_update_generic<i64>(NominalUpdatePair { x: 1, y: 2 }, 40)
  Test.assert_eq(updated.x + updated.y, 42)
}

test "nominal functional update copies and replaces inline arrays" {
  let copied = nominal_update_array_copy(NominalUpdateArray { items: [20, 22], n: 0 })
  let replaced = nominal_update_array_replace(NominalUpdateArray { items: [0, 0], n: 0 })
  Test.assert_eq(copied.items[0] + copied.items[1] + copied.n, 82)
  Test.assert_eq(replaced.items[0] + replaced.items[1], 42)
}

test "nominal functional update transports managed fields without leaks" {
  let probe = runtime_rc_probe_new(0)
  Test.assert_eq(nominal_update_managed_count(probe), 42)
  Test.assert_eq(runtime_rc_probe_count(probe), 1)

  let old = runtime_rc_probe_new(0)
  let next = runtime_rc_probe_new(0)
  Test.assert_eq(nominal_update_overwrite_managed_count(old, next), 332)
  Test.assert_eq(runtime_rc_probe_count(old), 1)
  Test.assert_eq(runtime_rc_probe_count(next), 1)
}

test "nominal functional update crosses effects and handler transport" {
  let updated = nominal_update_handle(NominalUpdatePair { x: 1, y: 2 })
  Test.assert_eq(updated.x + updated.y, 42)
}
