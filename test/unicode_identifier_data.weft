use compiler/unicode_identifier_data.{*}
use stdlib/test.{*}

test "unicode_identifier_data_pins_unicode_17" {
  Test.assert_str_eq(unicode_identifier_data_version(), "17.0.0")
}

test "unicode_identifier_ascii_profile" {
  Test.assert_eq(unicode_identifier_profile_start(65), 1)
  Test.assert_eq(unicode_identifier_profile_start(122), 1)
  Test.assert_eq(unicode_identifier_profile_start(95), 1)
  Test.assert_eq(unicode_identifier_profile_start(48), 0)
  Test.assert_eq(unicode_identifier_profile_continue(48), 1)
  Test.assert_eq(unicode_identifier_profile_continue(95), 1)
}

test "unicode_identifier_multiscript_xid_start" {
  Test.assert_eq(unicode_identifier_profile_start(945), 1)    -- Greek alpha
  Test.assert_eq(unicode_identifier_profile_start(20013), 1)  -- CJK 中
  Test.assert_eq(unicode_identifier_profile_start(66560), 1)  -- Deseret U+10400
}

test "unicode_identifier_marks_and_middle_dot_continue_only" {
  Test.assert_eq(unicode_xid_start(769), 0)
  Test.assert_eq(unicode_identifier_profile_continue(769), 1)
  Test.assert_eq(unicode_xid_start(183), 0)
  Test.assert_eq(unicode_identifier_profile_continue(183), 1)
}

test "unicode_identifier_rejects_emoji_and_out_of_range_scalars" {
  Test.assert_eq(unicode_identifier_profile_start(128512), 0)
  Test.assert_eq(unicode_identifier_profile_continue(128512), 0)
  Test.assert_eq(unicode_identifier_profile_start(0 - 1), 0)
  Test.assert_eq(unicode_identifier_profile_continue(1114112), 0)
}

test "unicode_identifier_default_ignorable_profile_subtraction" {
  Test.assert_eq(unicode_default_ignorable(8205), 1)          -- ZWJ
  Test.assert_eq(unicode_xid_continue(8205), 1)
  Test.assert_eq(unicode_identifier_profile_continue(8205), 0)
  Test.assert_eq(unicode_default_ignorable(65039), 1)         -- VS16
  Test.assert_eq(unicode_xid_continue(65039), 1)
  Test.assert_eq(unicode_identifier_profile_continue(65039), 0)
  Test.assert_eq(unicode_default_ignorable(173), 1)           -- soft hyphen
}

test "unicode_identifier_range_edges_are_inclusive" {
  Test.assert_eq(unicode_xid_start(65), 1)
  Test.assert_eq(unicode_xid_start(90), 1)
  Test.assert_eq(unicode_xid_start(91), 0)
  Test.assert_eq(unicode_xid_start(201546), 1)                 -- U+3134A
  Test.assert_eq(unicode_xid_start(201547), 0)
}

test "unicode_identifier_profile_start_is_always_continue_on_samples" {
  let mut scalar = 0
  let mut valid = 1
  while scalar <= 1114111 and valid == 1 {
    if unicode_identifier_profile_start(scalar) == 1 and unicode_identifier_profile_continue(scalar) == 0 {
      valid = 0
    } else { 0 }
    scalar = scalar + 997
  }
  Test.assert_eq(valid, 1)
}

test "unicode_identifier_default_ignorables_never_enter_profile_on_samples" {
  let mut scalar = 0
  let mut valid = 1
  while scalar <= 1114111 and valid == 1 {
    if unicode_default_ignorable(scalar) == 1 and (unicode_identifier_profile_start(scalar) == 1 or unicode_identifier_profile_continue(scalar) == 1) {
      valid = 0
    } else { 0 }
    scalar = scalar + 257
  }
  Test.assert_eq(valid, 1)
}
