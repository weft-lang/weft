use stdlib/num
use stdlib/string
use stdlib/option
use stdlib/vector as vector
use stdlib/vector.{to_array}

test "radix and separator integer expressions have ordinary arithmetic semantics" {
  Test.assert_eq(0x2a, 42)
  Test.assert_eq(0x2A, 42)
  Test.assert_eq(0b10_1010, 42)
  Test.assert_eq(1_000_000 + 0xFF, 1000255)
  Test.assert_eq(-0x2A + 0b10, -40)
  Test.assert_eq(0x1e+2, 32)
  Test.assert_eq(000_042, 42)
}

test "contextual radix literals preserve signed and unsigned integer widths" {
  let a: i8 = -0x80
  let b: i16 = -0x8000
  let c: i32 = -0x8000_0000
  let d: i64 = -0x8000_0000_0000_0000
  let e: isize = -0x8000_0000_0000_0000
  let f: u8 = 0xFF
  let g: u16 = 0xFFFF
  let h: u32 = 0xFFFF_FFFF
  let i: u64 = 0xFFFF_FFFF_FFFF_FFFF
  let j: usize = 0xFFFF_FFFF_FFFF_FFFF
  Test.assert_true(a == -128 and b == -32768 and c == -2147483648)
  Test.assert_true(d == -9223372036854775808 and e == -9223372036854775808)
  Test.assert_true(f == 255 and g == 65535 and h == 4294967295)
  Test.assert_true(i == 18446744073709551615 and j == 18446744073709551615)
}

type LiteralWord = u64
const HIGH_BIT: LiteralWord = 0x8000_0000_0000_0000
const LOW_MASK: u64 = 0b1111_1111
fn literal_word() -> LiteralWord { 18_446_744_073_709_551_615 }

test "aliases constant expressions and return context preserve full unsigned magnitudes" {
  Test.assert_true(HIGH_BIT == 9223372036854775808)
  Test.assert_true(LOW_MASK == 255)
  Test.assert_true(literal_word() == 0xFFFF_FFFF_FFFF_FFFF)
}

fn radix_pattern(value: u8) -> i64 {
  match value { 0x2A -> 1, 0b1111_1111 -> 2, 1_0 -> 3, _ -> 4 }
}

test "integer patterns use the same radix and separator values" {
  Test.assert_eq(radix_pattern(42), 1)
  Test.assert_eq(radix_pattern(255), 2)
  Test.assert_eq(radix_pattern(10), 3)
  Test.assert_eq(radix_pattern(11), 4)
}

test "fixed arrays and vector conversions share compile-time literal lengths" {
  let fixed: [i64; 0x3] = [10, 20, 30]
  Test.assert_eq(fixed[0b10], 30)
  let mut values = vector.new<i64>()
  values.push(10)
  values.push(20)
  values.push(30)
  let copied: Option<[i64; 0b11]> = values.to_array<0x3>()
  match copied {
    Some(array) -> Test.assert_eq(array[0x1], 20)
    None -> Test.assert_true(false)
  }
  Test.assert_true(values.to_array<0b10>().is_none())
  let empty: [i64; 0_0] = []
  Test.assert_true(empty.len == 0)
}

test "float separators preserve exact rounding in every decimal component" {
  let ordinary: f64 = 1_2.5_0e+0_1
  let fraction: f64 = 0.0_0_1_2_5
  let exponent: f32 = 1_2_5e-0_3
  Test.assert_true(ordinary.to_bits() == 125.0.to_bits())
  Test.assert_true(fraction.to_bits() == 0.00125.to_bits())
  let expected: f32 = 0.125
  Test.assert_true(exponent.to_bits() == expected.to_bits())
  let zero: f64 = 0_0.0_0e+9_999
  Test.assert_true(zero.to_bits() == 0.0.to_bits())
}

test "long mantissas and subnormal float boundaries ignore separators exactly" {
  let large: f64 = 12_345_678_901_234_567_890.12_3
  let large_plain: f64 = 12345678901234567890.123
  let normal: f64 = 2.2_250738585072014e-3_08
  let normal_plain: f64 = 2.2250738585072014e-308
  let tiny: f64 = 4.940_656_458_412_465_4e-3_24
  let tiny_plain: f64 = 4.9406564584124654e-324
  Test.assert_true(large.to_bits() == large_plain.to_bits())
  Test.assert_true(normal.to_bits() == normal_plain.to_bits())
  Test.assert_true(tiny.to_bits() == tiny_plain.to_bits())
  Test.assert_true(tiny.to_bits() == 1)
}

test "tuple projection labels remain distinct from floating-point tokens" {
  let pairs = ((11, 12), (21, 22))
  Test.assert_eq(pairs.0.1, 12)
  Test.assert_eq(pairs. 1 . 0, 21)
  Test.assert_eq((0x2a, 0b11).0, 42)
}

test "numeric literal fragments preserve interpolation source offsets" {
  let value = 0x2a
  Test.assert_str_eq(i"answer {value + 0b10}", "answer 44")
  Test.assert_str_eq(i"sum {value - 0xA + 1_0}", "sum 42")
}
