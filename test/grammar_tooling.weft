fn span(text: str) -> Span {
  Source { text: text, identity: DiagnosticSourceNamed("embedded") }.all()
}

-- Count error diagnostics around each kind of body. The helpers are
-- specialized per result type: a generic counter would make the caller's type
-- variable flow into `state.run`, which the checker does not yet substitute
-- correctly.
fn parse_outcome_counting(body: () -[Diagnose]> ParseOutcome) -> (ParseOutcome, i64) {
  state.run(
    0,
    () => handle body() {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
          _ -> nil
        }
        resume(0)
      }
      Diagnose.error(message, position) -> { state.modify((count: i64) => count + 1); resume(0) }
      Diagnose.warn(message, position) -> resume(0)
      Diagnose.note(message, position) -> resume(0)
    }
  )
}

fn outcome_counting(body: () -[Diagnose]> GrammarCheckOutcome) -> (GrammarCheckOutcome, i64) {
  state.run(
    0,
    () => handle body() {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> { state.modify((count: i64) => count + 1); nil }
          _ -> nil
        }
        resume(0)
