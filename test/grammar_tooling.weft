-- Collect the primary location of every error diagnostic, in report order.
fn outcome_locations(
  body: () -[Diagnose]> GrammarCheckOutcome
) -> (GrammarCheckOutcome, List<DiagnosticLocation>) {
  state.run(
    Nil<DiagnosticLocation>(),
    () => handle body() {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> {
            state.modify(
              (seen: List<DiagnosticLocation>) => seen.append(diagnostic.primary())
            )
            nil
          }
          _ -> nil
        }
        resume(0)
      }
      Diagnose.error(message, position) -> resume(0)
      Diagnose.warn(message, position) -> resume(0)
      Diagnose.note(message, position) -> resume(0)
    }
  )
}

fn parse_locations(
  body: () -[Diagnose]> ParseOutcome
) -> (ParseOutcome, List<DiagnosticLocation>) {
  state.run(
    Nil<DiagnosticLocation>(),
    () => handle body() {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> {
            state.modify(
              (seen: List<DiagnosticLocation>) => seen.append(diagnostic.primary())
            )
            nil
          }
          _ -> nil
        }
        resume(0)
      }
      Diagnose.error(message, position) -> resume(0)
      Diagnose.warn(message, position) -> resume(0)
      Diagnose.note(message, position) -> resume(0)
    }
  )
}

fn embedded_range(location: DiagnosticLocation, start: usize, end: usize) -> bool {
  match location {
    DiagnosticSourceRange(DiagnosticSourceNamed(name), actual_start, actual_end) ->
      name == "embedded" and actual_start == start and actual_end == end
    _ -> false
  }
}

