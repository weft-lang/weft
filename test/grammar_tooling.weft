-- Answer every file read with one fixed content, or a missing file.
fn with_file<T>(content: Option<str>, body: () -[FileRead]> T) -> T {
  handle body() {
    FileRead.read_all(actual, limit) -> resume(
      match content {
        Some(text) -> Ok<Bytes, IoError>(bytes.from_str(text))
        None -> Err<Bytes, IoError>(IoNotFound)
      }
    )
  }
}

-- A file read that must never happen.
fn without_reads<T>(body: () -[FileRead]> T) -[Test]> T {
  handle body() {
    FileRead.read_all(actual, limit) -> {
      Test.assert_true(false)
      resume(Err<Bytes, IoError>(IoNotFound))
    }
  }
}

-- A host type query that must never happen.
fn without_type_queries<T>(body: () -[TypeCheck<ToolTypeIdentity>]> T) -[Test]> T {
  handle body() {
    TypeCheck<ToolTypeIdentity>.resolve(request) -> {
      Test.assert_true(false)
      resume(Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(TypeNotFound))
    }
    TypeCheck<ToolTypeIdentity>.field(base, field) -> {
      Test.assert_true(false)
      resume(Err<ResolvedType<ToolTypeIdentity>, TypeQueryError>(ForeignTypeIdentity))
    }
    TypeCheck<ToolTypeIdentity>.fields(base) -> {
      Test.assert_true(false)
      resume(Err<List<ResolvedField<ToolTypeIdentity>>, TypeQueryError>(ForeignTypeIdentity))
    }
    TypeCheck<ToolTypeIdentity>.subtype(actual, expected) -> {
      Test.assert_true(false)
      resume(Err<bool, TypeQueryError>(ForeignTypeIdentity))
    }
  }
}

fn users_catalog() -> HostCatalog {
  let fields = [("id", "i64"), ("name", "str"), ("active", "bool")]
  catalog_with(primitive_catalog(), catalog_record("users", list.from_slice(fields[..])))
}

fn settings_catalog() -> HostCatalog {
  let fields = [("count", "i64"), ("label", "str")]
  catalog_with(primitive_catalog(), catalog_record("settings", list.from_slice(fields[..])))
}

fn sql_syntax(text: str) -> SqlSyntax {
  let (parsed, _) = sql_parse_counting(text)
  match parsed {
    Parsed(syntax) -> syntax
    _ -> panic("expected the SQL sample to parse")
  }
}

fn einsum_syntax(text: str) -> EinsumSyntax {
  let (parsed, _) = einsum_parse_counting(text)
  match parsed {
    Parsed(syntax) -> syntax
    _ -> panic("expected the einsum sample to parse")
  }
}

fn assignment_syntax(text: str) -> AssignmentSyntax {
  let (parsed, _) = assignment_parse_counting(text)
  match parsed {
    Parsed(syntax) -> syntax
    _ -> panic("expected the assignment sample to parse")
  }
}

fn greedy_syntax() -> greedy.GreedySyntax { greedy.GreedySyntax() }

fn sql_schema_path() -> Path {
  path.from_utf8("test/fixtures/comptime_sql_schema_v1.json").unwrap()
}

fn einsum_context_path() -> Path {
  path.from_utf8("test/fixtures/comptime_einsum_context_v1.json").unwrap()
}

fn sql_schema_json() -> str {
  "{\"schema_version\":1,\"tables\":{\"users\":{\"id\":\"i64\",\"name\":\"str\"}}}"
}

fn einsum_context_json() -> str {
  "{\"context_version\":1,\"element\":\"f64\",\"operands\":[[2,3],[3,4]]}"
}

fn is_checked(outcome: GrammarCheckOutcome) -> bool {
  match outcome { GrammarChecked -> true, _ -> false }
}

fn is_rejected(outcome: GrammarCheckOutcome) -> bool {
  match outcome { GrammarCheckRejected -> true, _ -> false }
}

fn is_unsupported(outcome: GrammarCheckOutcome, kind: GrammarContextKind) -> bool {
  match outcome { GrammarCheckUnsupported(actual) -> context_kind_same(actual, kind), _ -> false }
}

fn is_unavailable(outcome: GrammarCheckOutcome) -> bool {
  match outcome { GrammarContextUnavailable -> true, _ -> false }
}

test "grammars declare the contexts their tooling accepts" {
  Test.assert_true(supports_context(sql.grammar().contexts(), GrammarHostTypesContext))
  Test.assert_true(supports_context(sql.grammar().contexts(), GrammarFileContext))
  Test.assert_true(not supports_context(einsum.grammar().contexts(), GrammarHostTypesContext))
  Test.assert_true(supports_context(einsum.grammar().contexts(), GrammarFileContext))
  Test.assert_true(supports_context(toy.grammar().contexts(), GrammarHostTypesContext))
  Test.assert_true(not supports_context(toy.grammar().contexts(), GrammarFileContext))
  Test.assert_true(not supports_context(Nil<GrammarContextKind>(), GrammarFileContext))
}

test "parse outcomes carry no syntax payload" {
  let (sql_ok, sql_ok_errors) = parse_outcome_counting(
    () => parse_outcome(sql.grammar(), span("select id from users"))
  )
  Test.assert_true(match sql_ok { ParseOutcomeParsed -> true, _ -> false })
  Test.assert_eq(sql_ok_errors, 0)
  let (sql_recovered, sql_recovered_errors) = parse_outcome_counting(
    () => parse_outcome(sql.grammar(), span("select + from users"))
  )
  Test.assert_true(match sql_recovered { ParseOutcomeRecovered -> true, _ -> false })
  Test.assert_true(sql_recovered_errors > 0)
  let (rejected, rejected_errors) = parse_outcome_counting(
    () => parse_outcome(toy.grammar(), span("count 3"))
  )
  Test.assert_true(match rejected { ParseOutcomeRejected -> true, _ -> false })
  Test.assert_eq(rejected_errors, 1)
  let (einsum_ok, einsum_errors) = parse_outcome_counting(
    () => parse_outcome(einsum.grammar(), span("ij,jk->ik"))
  )
  Test.assert_true(match einsum_ok { ParseOutcomeParsed -> true, _ -> false })
  Test.assert_eq(einsum_errors, 0)
}

test "a grammar without tooling conformance still parses through the public contract" {
  let (word, word_errors) = parse_outcome_counting(
    () => parse_outcome(plain.grammar(), span("hello"))
  )
  Test.assert_true(match word { ParseOutcomeParsed -> true, _ -> false })
  Test.assert_eq(word_errors, 0)
  let (empty, empty_locations) = parse_locations(
    () => parse_outcome(plain.grammar(), span(""))
  )
  Test.assert_true(match empty { ParseOutcomeRejected -> true, _ -> false })
  match empty_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 0, 0))
    _ -> Test.assert_true(false)
  }
  let (trailing, trailing_locations) = parse_locations(
    () => parse_outcome(plain.grammar(), span("hello 2"))
  )
  Test.assert_true(match trailing { ParseOutcomeRejected -> true, _ -> false })
  match trailing_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 5, 6))
    _ -> Test.assert_true(false)
  }
  let (parsed, parsed_errors) = word_parse_counting("word")
  Test.assert_eq(parsed_errors, 0)
  match parsed {
    Parsed(syntax) -> {
      Test.assert_str_eq(syntax.word, "word")
      Test.assert_true(embedded_range(syntax.word_span.location(), 0, 4))
    }
    _ -> Test.assert_true(false)
  }
}

test "diagnostics carry the embedded source identity and byte offsets" {
  let (key_error, key_locations) = parse_locations(
    () => parse_outcome(toy.grammar(), span("count 3"))
  )
  Test.assert_true(match key_error { ParseOutcomeRejected -> true, _ -> false })
  match key_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 6, 7))
    _ -> Test.assert_true(false)
  }
  let (mismatch, mismatch_locations) = outcome_locations(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("count = \"x\""))
    }
  )
  Test.assert_true(is_rejected(mismatch))
  match mismatch_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 8, 11))
    _ -> Test.assert_true(false)
  }
  let (unknown, unknown_locations) = outcome_locations(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("  other = 1"))
    }
  )
  Test.assert_true(is_rejected(unknown))
  match unknown_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 2, 7))
    _ -> Test.assert_true(false)
  }
  let (column, column_locations) = outcome_locations(
    () => with host(users_catalog()) {
      host_check(sql.grammar(), sql_syntax("select missing from users"))
    }
  )
  Test.assert_true(is_rejected(column))
  match column_locations {
    Cons(location, Nil) -> Test.assert_true(embedded_range(location, 7, 14))
    _ -> Test.assert_true(false)
  }
}

test "host checking answers through the tool identity handler" {
  let accepted = sql_syntax("select id, name from users")
  let (outcome, errors) = outcome_counting(
    () => with host(users_catalog()) { host_check(sql.grammar(), accepted) }
  )
  Test.assert_true(is_checked(outcome))
  Test.assert_eq(errors, 0)
  let unknown_column = sql_syntax("select missing from users")
  let (rejected, rejected_errors) = outcome_counting(
    () => with host(users_catalog()) { host_check(sql.grammar(), unknown_column) }
  )
  Test.assert_true(is_rejected(rejected))
  Test.assert_true(rejected_errors > 0)
  let unknown_table = sql_syntax("select id from orders")
  let (missing, missing_errors) = outcome_counting(
    () => with host(users_catalog()) { host_check(sql.grammar(), unknown_table) }
  )
  Test.assert_true(is_rejected(missing))
  Test.assert_true(missing_errors > 0)
}

test "a third-party grammar conforms without compiler imports" {
  let (ok, ok_errors) = outcome_counting(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("count = 3"))
    }
  )
  Test.assert_true(is_checked(ok))
  Test.assert_eq(ok_errors, 0)
  let (text_ok, text_errors) = outcome_counting(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("label = \"x\""))
    }
  )
  Test.assert_true(is_checked(text_ok))
  Test.assert_eq(text_errors, 0)
  let (mismatch, mismatch_errors) = outcome_counting(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("count = \"x\""))
    }
  )
  Test.assert_true(is_rejected(mismatch))
  Test.assert_eq(mismatch_errors, 1)
  let (unknown, unknown_errors) = outcome_counting(
    () => with host(settings_catalog()) {
      host_check(toy.grammar(), assignment_syntax("other = 1"))
    }
  )
  Test.assert_true(is_rejected(unknown))
  Test.assert_eq(unknown_errors, 1)
  let (no_record, no_record_errors) = outcome_counting(
    () => with host(primitive_catalog()) {
      host_check(toy.grammar(), assignment_syntax("count = 3"))
    }
  )
  Test.assert_true(is_rejected(no_record))
  Test.assert_eq(no_record_errors, 1)
}

test "unsupported contexts are refused before the grammar runs" {
  let equation = einsum_syntax("ij,jk->ik")
  let (outcome, errors) = without_type_queries(
    () => outcome_counting_queries(() => host_check(einsum.grammar(), equation))
  )
  Test.assert_true(is_unsupported(outcome, GrammarHostTypesContext))
  Test.assert_eq(errors, 0)
  let (greedy_outcome, greedy_errors) = without_type_queries(
    () => outcome_counting_queries(() => host_check(greedy.grammar(), greedy_syntax()))
  )
  Test.assert_true(is_unsupported(greedy_outcome, GrammarHostTypesContext))
  Test.assert_eq(greedy_errors, 0)
  let assignment = assignment_syntax("count = 3")
  let (refused, refused_errors) = without_reads(
    () => outcome_counting_reads(
      () => context_check(toy.grammar(), assignment, sql_schema_path(), 4096)
    )
  )
  Test.assert_true(is_unsupported(refused, GrammarFileContext))
  Test.assert_eq(refused_errors, 0)
}

test "context files are loaded under observed reads" {
  let accepted = sql_syntax("select id from users")
  let (evaluation, errors) = with_file(
    Some<str>(sql_schema_json()),
    () => evaluation_counting(
      () => comptime.observe_file_reads(
        () => context_check(sql.grammar(), accepted, sql_schema_path(), 4096)
      )
    )
  )
  Test.assert_true(is_checked(evaluation.value))
  Test.assert_eq(errors, 0)
  match evaluation.file_observations {
    Cons({ path: observed, limit: bound, outcome: Ok(_) }, Nil) -> {
      Test.assert_true(observed.eq(sql_schema_path()))
      Test.assert_eq_usize(bound, 4096)
    }
    _ -> Test.assert_true(false)
  }
  let unknown = sql_syntax("select missing from users")
  let (rejected, rejected_errors) = with_file(
    Some<str>(sql_schema_json()),
    () => outcome_counting_reads(
      () => context_check(sql.grammar(), unknown, sql_schema_path(), 4096)
    )
  )
  Test.assert_true(is_rejected(rejected))
  Test.assert_true(rejected_errors > 0)
  let contraction = einsum_syntax("ij,jk->ik")
  let (einsum_ok, einsum_errors) = with_file(
    Some<str>(einsum_context_json()),
    () => outcome_counting_reads(
      () => context_check(einsum.grammar(), contraction, einsum_context_path(), 4096)
    )
  )
  Test.assert_true(is_checked(einsum_ok))
  Test.assert_eq(einsum_errors, 0)
  let wrong_rank = einsum_syntax("ijk,jk->i")
  let (einsum_rejected, einsum_rejected_errors) = with_file(
    Some<str>(einsum_context_json()),
    () => outcome_counting_reads(
      () => context_check(einsum.grammar(), wrong_rank, einsum_context_path(), 4096)
    )
  )
  Test.assert_true(is_rejected(einsum_rejected))
  Test.assert_true(einsum_rejected_errors > 0)
}

test "an unavailable or invalid context is a structured outcome with a diagnostic" {
  let accepted = sql_syntax("select id from users")
  let (missing, missing_errors) = with_file(
    None<str>(),
    () => outcome_counting_reads(
      () => context_check(sql.grammar(), accepted, sql_schema_path(), 4096)
    )
  )
  Test.assert_true(is_unavailable(missing))
  Test.assert_eq(missing_errors, 1)
  let (invalid, invalid_errors) = with_file(
    Some<str>("[]"),
    () => outcome_counting_reads(
      () => context_check(sql.grammar(), accepted, sql_schema_path(), 4096)
    )
  )
  Test.assert_true(is_unavailable(invalid))
  Test.assert_eq(invalid_errors, 1)
  let contraction = einsum_syntax("ij,jk->ik")
  let (einsum_missing, einsum_missing_errors) = with_file(
    None<str>(),
    () => outcome_counting_reads(
      () => context_check(einsum.grammar(), contraction, einsum_context_path(), 4096)
    )
  )
  Test.assert_true(is_unavailable(einsum_missing))
  Test.assert_eq(einsum_missing_errors, 1)
}

test "context checking confines a grammar to the requested file and limit" {
  let (evaluation, errors) = with_file(
    Some<str>("{}"),
    () => evaluation_counting(
      () => comptime.observe_file_reads(
        () => context_check(greedy.grammar(), greedy_syntax(), sql_schema_path(), 64)
      )
    )
  )
  Test.assert_true(is_checked(evaluation.value))
  Test.assert_eq(errors, 0)
  match evaluation.file_observations {
    Cons({ path: observed, limit: bound, outcome: Ok(_) }, Nil) -> {
      Test.assert_true(observed.eq(sql_schema_path()))
      Test.assert_eq_usize(bound, 64)
    }
    _ -> Test.assert_true(false)
  }
  let (unconfined, unconfined_errors) = with_file(
    Some<str>("{}"),
    () => outcome_counting_reads(
      () => greedy.grammar().check_with_context(greedy_syntax(), sql_schema_path(), 64).outcome
    )
  )
  Test.assert_true(is_checked(unconfined))
  Test.assert_eq(unconfined_errors, 2)
  let (missing, missing_errors) = with_file(
    None<str>(),
    () => outcome_counting_reads(
      () => context_check(greedy.grammar(), greedy_syntax(), sql_schema_path(), 64)
    )
  )
  Test.assert_true(is_unavailable(missing))
  Test.assert_eq(missing_errors, 0)
}

test "the host fixture answers structured query errors" {
  let catalog = users_catalog()
  let unknown = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.resolve(
      TypeName { qualifier: None<str>(), name: "orders", arguments: Nil<ToolTypeIdentity>() }
    )
  }
  Test.assert_true(match unknown { Err(TypeNotFound) -> true, _ -> false })
  let qualified = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.resolve(
      TypeName { qualifier: Some<str>("pkg"), name: "users", arguments: Nil<ToolTypeIdentity>() }
    )
  }
  Test.assert_true(match qualified { Err(TypeNotFound) -> true, _ -> false })
  let users = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.resolve(
      TypeName { qualifier: None<str>(), name: "users", arguments: Nil<ToolTypeIdentity>() }
    )
  }
  match users {
    Ok(resolved) -> {
      Test.assert_true(
        match resolved.description { SemanticTypeRecord(_, false, false) -> true, _ -> false }
      )
      let applied = with host(catalog) {
        TypeCheck<ToolTypeIdentity>.resolve(
          TypeName {
            qualifier: None<str>(),
            name: "users",
            arguments: Cons(resolved.identity, Nil<ToolTypeIdentity>())
          }
        )
      }
      Test.assert_true(match applied { Err(TypeArgumentCount(0, 1)) -> true, _ -> false })
      let by_name = with host(catalog) {
        TypeCheck<ToolTypeIdentity>.field(resolved.identity, NamedTypeField("name"))
      }
      Test.assert_true(
        match by_name {
          Ok(field) -> match field.description {
            SemanticTypePrimitive(name) -> name == "str",
            _ -> false
          }
          Err(_) -> false
        }
      )
      let positional = with host(catalog) {
        TypeCheck<ToolTypeIdentity>.field(resolved.identity, PositionalTypeField(0))
      }
      Test.assert_true(match positional { Err(TypeFieldNotFound) -> true, _ -> false })
      let listed = with host(catalog) { TypeCheck<ToolTypeIdentity>.fields(resolved.identity) }
      Test.assert_true(match listed { Ok(fields) -> fields.len() == 3, Err(_) -> false })
      let same = with host(catalog) {
        TypeCheck<ToolTypeIdentity>.subtype(resolved.identity, resolved.identity)
      }
      Test.assert_true(match same { Ok(true) -> true, _ -> false })
    }
    Err(_) -> Test.assert_true(false)
  }
  let primitive = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.resolve(
      TypeName { qualifier: None<str>(), name: "i64", arguments: Nil<ToolTypeIdentity>() }
    )
  }
  match primitive {
    Ok(resolved) -> {
      let fields = with host(catalog) { TypeCheck<ToolTypeIdentity>.fields(resolved.identity) }
      Test.assert_true(match fields { Err(TypeFieldsUnavailable) -> true, _ -> false })
    }
    Err(_) -> Test.assert_true(false)
  }
  let foreign = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.fields(tool_type_identity(99))
  }
  Test.assert_true(match foreign { Err(ForeignTypeIdentity) -> true, _ -> false })
  let mixed = with host(catalog) {
    TypeCheck<ToolTypeIdentity>.subtype(tool_type_identity(1), tool_type_identity(2))
  }
  Test.assert_true(match mixed { Ok(false) -> true, _ -> false })
}
