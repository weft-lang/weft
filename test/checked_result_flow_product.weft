-- Expected exit code: 0
-- Runtime input retains both success and failure paths in linked products.

use runtime/env as platform_env
use stdlib/env.{Env}
use stdlib/f64_table as table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option, Some, None}

fn pair(values: F64Table, row: i64) -> Option<f64> {
  match values.get(row, 0) {
    Some(first) -> match values.get(row, 1) {
      Some(second) -> Some(first * 10.0 + second)
      None -> None<f64>()
    }
    None -> None<f64>()
  }
}

fn main() -> i64 {
  -- The argument count is only known at run time, so nothing below folds.
  let argc = with platform_env() { Env.arg_count() }
  let values = table.zeros(argc + 1, 2).unwrap()
  let mut total = 0.0
  for iteration in 0..argc + 3 {
    values.set(argc, 0, 4.0)
    values.set(argc, 1, 2.0)
    total = total + pair(values, argc).unwrap()
    values.set(argc, 1, 9.0)
    total = total + pair(values, argc).unwrap()
  }
  let bad_row = match pair(values, argc + 1) { None -> true, Some(_) -> false }
  let narrow = table.zeros(argc + 1, 1).unwrap()
  let bad_column = match pair(narrow, argc) { None -> true, Some(_) -> false }
  if total == 364.0 and bad_row and bad_column { 0 } else { 1 }
}
