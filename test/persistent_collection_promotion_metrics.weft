use "stdlib/map.weft"
use "stdlib/set.weft"
use "stdlib/vector.weft"
use "runtime/rc.weft"

test "persistent_collection_metric_map_promotes_root_and_family_owner_only" {
  let m: Map<i64, i64> = persistent_map_put(persistent_map_new(), 1, 10)
  let raw_root = persistent_map_root(m)
  let region = map_storage_persistent_region<i64, i64>(m)
  Test.assert_eq(persistent_map_is_promoted(m), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 0)
  persistent_map_promote(m)
  Test.assert_eq(persistent_map_is_promoted(m), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 1)
  Test.assert_eq(persistent_map_get_or(m, 1, 0 - 1), 10)
}

test "persistent_collection_metric_set_promotes_root_and_family_owner_only" {
  let s: Set<i64> = persistent_set_add(persistent_set_new(), 5)
  let raw_root = persistent_set_root(s)
  let region = map_storage_persistent_region<i64, i64>(set_storage_map<i64>(s))
  Test.assert_eq(persistent_set_is_promoted(s), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 0)
  persistent_set_promote(s)
  Test.assert_eq(persistent_set_is_promoted(s), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 1)
  Test.assert_eq(persistent_set_contains(s, 5), 1)
}

test "persistent_collection_metric_vector_promotes_root_and_family_owner_only" {
  let mut v: rc i64 = persistent_vector_new<i64>()
  for i in 0..35 {
    v = persistent_vector_push<i64>(v, i)
  }
  let raw_root = persistent_vector_root(v)
  let raw_tree = persistent_vector_tree_root(v)
  let raw_tail = persistent_vector_tail(v)
  let region = persistent_vector_region(v)
  Test.assert_eq(persistent_vector_chunk_count(v), 2)
  Test.assert_eq(rc_default_is_promoted_maybe(v), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tree), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tail), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 0)
  rc_default_promote_maybe(v)
  Test.assert_eq(rc_default_is_promoted_maybe(v), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tree), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tail), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(region), 1)
  Test.assert_eq(persistent_vector_get<i64>(v, 34, 0 - 1), 34)
}

test "persistent_collection_metric_mutable_vector_promotes_managed_header" {
  let vec = vector_new<i64>()
  vector_push<i64>(vec, 10)
  vector_storage_promote<i64>(vec)
  Test.assert_eq(vector_storage_is_promoted<i64>(vec), 1)
  Test.assert_eq(vector_get<i64>(vec, 0, 0 - 1), 10)
}
