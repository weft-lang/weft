use "stdlib/map.weft"
use "stdlib/set.weft"
use "stdlib/vector.weft"
use "runtime/rc.weft"

test "persistent_collection_metric_map_promotes_only_managed_root" {
  let m: rc i64 = persistent_map_put(persistent_map_new(), 1, 10)
  let raw_root = persistent_map_root(m)
  Test.assert_eq(rc_default_is_promoted_maybe(m), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  rc_default_promote_maybe(m)
  Test.assert_eq(rc_default_is_promoted_maybe(m), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(persistent_map_get(m, 1, 0 - 1), 10)
}

test "persistent_collection_metric_set_promotes_only_managed_root" {
  let s: rc i64 = persistent_set_add(persistent_set_new(), 5)
  let raw_root = persistent_set_root(s)
  Test.assert_eq(rc_default_is_promoted_maybe(s), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  rc_default_promote_maybe(s)
  Test.assert_eq(rc_default_is_promoted_maybe(s), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(persistent_set_contains(s, 5), 1)
}

test "persistent_collection_metric_vector_promotes_only_managed_root" {
  let mut v: rc i64 = persistent_vector_new<i64>()
  for i in 0..35 {
    v = persistent_vector_push<i64>(v, i)
  }
  let raw_root = persistent_vector_root(v)
  let raw_tree = persistent_vector_tree_root(v)
  let raw_tail = persistent_vector_tail(v)
  Test.assert_eq(persistent_vector_chunk_count(v), 2)
  Test.assert_eq(rc_default_is_promoted_maybe(v), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tree), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tail), 0)
  rc_default_promote_maybe(v)
  Test.assert_eq(rc_default_is_promoted_maybe(v), 1)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_root), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tree), 0)
  Test.assert_eq(rc_default_is_promoted_maybe(raw_tail), 0)
  Test.assert_eq(persistent_vector_get<i64>(v, 34, 0 - 1), 34)
}

test "persistent_collection_metric_mutable_vector_has_no_managed_root" {
  let vec = vector_new<i64>()
  vector_push<i64>(vec, 10)
  rc_default_promote_maybe(vec)
  Test.assert_eq(rc_default_is_promoted_maybe(vec), 0)
  Test.assert_eq(vector_get<i64>(vec, 0, 0 - 1), 10)
}
