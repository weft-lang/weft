-- compiler/syntax_grammar.weft -- typed, backend-neutral concrete grammar data
--
-- Grammar implementations are executable parser/checker components.  This
-- companion representation is their inspectable concrete-syntax contract:
-- editor parsers and other grammar consumers interpret these values instead
-- of maintaining a second handwritten grammar.

pub(package) type SyntaxGrammar {
  SyntaxGrammar(
    str,
    SyntaxExprList,
    SyntaxExpr,
    SyntaxExprList,
    SyntaxConflictList,
    SyntaxRuleList
  )
}

pub(package) type SyntaxExpr {
  SyntaxLiteral(str),
  SyntaxPattern(str),
  SyntaxRustPattern(str),
  SyntaxReference(str),
  SyntaxSequence(SyntaxExprList),
  SyntaxChoice(SyntaxExprList),
  SyntaxRepeat(SyntaxExpr),
  SyntaxRepeatOne(SyntaxExpr),
  SyntaxOptional(SyntaxExpr),
  SyntaxField(str, SyntaxExpr),
  SyntaxPrecedence(i64, SyntaxExpr),
  SyntaxPrecedenceLeft(i64, SyntaxExpr),
  SyntaxPrecedenceRight(SyntaxExpr),
  SyntaxPrecedenceRightAt(i64, SyntaxExpr),
  SyntaxToken(SyntaxExpr),
  SyntaxTokenImmediate(SyntaxExpr),
  SyntaxCommaSeparated(SyntaxExpr),
  SyntaxCommaSeparatedOne(SyntaxExpr)
}

pub(package) type SyntaxExprList {
  SyntaxExprNil,
  SyntaxExprCons(SyntaxExpr, SyntaxExprList)
}

pub(package) type SyntaxRule {
  SyntaxRule(str, SyntaxExpr)
}

pub(package) type SyntaxRuleList {
  SyntaxRuleNil,
  SyntaxRuleCons(SyntaxRule, SyntaxRuleList)
}

pub(package) type SyntaxConflictList {
  SyntaxConflictNil,
  SyntaxConflictCons(SyntaxExprList, SyntaxConflictList)
}

pub(package) type SyntaxBinaryOperator {
  SyntaxBinaryOperator(str, i64)
}

pub(package) type SyntaxBinaryOperatorList {
  SyntaxBinaryOperatorNil,
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator, SyntaxBinaryOperatorList)
}

pub(package) fn syntax_exprs1(a: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, SyntaxExprNil)
}

pub(package) fn syntax_exprs2(a: SyntaxExpr, b: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs1(b))
}

pub(package) fn syntax_exprs3(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs2(b, c))
}

pub(package) fn syntax_exprs4(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs3(b, c, d))
}

pub(package) fn syntax_exprs5(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs4(b, c, d, e))
}

pub(package) fn syntax_exprs6(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs5(b, c, d, e, f))
}

pub(package) fn syntax_exprs7(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs6(b, c, d, e, f, g))
}

pub(package) fn syntax_exprs8(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr, h: SyntaxExpr) -> SyntaxExprList {
  SyntaxExprCons(a, syntax_exprs7(b, c, d, e, f, g, h))
}

pub(package) fn syntax_exprs_concat(left: SyntaxExprList, right: SyntaxExprList) -> SyntaxExprList {
  match left {
    SyntaxExprNil -> right
    SyntaxExprCons(head, rest) -> SyntaxExprCons(head, syntax_exprs_concat(rest, right))
  }
}

pub(package) fn syntax_rules1(a: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, SyntaxRuleNil)
}

pub(package) fn syntax_rules2(a: SyntaxRule, b: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules1(b))
}

pub(package) fn syntax_rules3(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules2(b, c))
}

pub(package) fn syntax_rules4(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule, d: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules3(b, c, d))
}

pub(package) fn syntax_rules5(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule, d: SyntaxRule, e: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules4(b, c, d, e))
}

pub(package) fn syntax_rules6(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule, d: SyntaxRule, e: SyntaxRule, f: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules5(b, c, d, e, f))
}

pub(package) fn syntax_rules7(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule, d: SyntaxRule, e: SyntaxRule, f: SyntaxRule, g: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules6(b, c, d, e, f, g))
}

pub(package) fn syntax_rules8(a: SyntaxRule, b: SyntaxRule, c: SyntaxRule, d: SyntaxRule, e: SyntaxRule, f: SyntaxRule, g: SyntaxRule, h: SyntaxRule) -> SyntaxRuleList {
  SyntaxRuleCons(a, syntax_rules7(b, c, d, e, f, g, h))
}

pub(package) fn syntax_rules_concat(left: SyntaxRuleList, right: SyntaxRuleList) -> SyntaxRuleList {
  match left {
    SyntaxRuleNil -> right
    SyntaxRuleCons(head, rest) -> SyntaxRuleCons(head, syntax_rules_concat(rest, right))
  }
}

pub(package) fn syntax_conflicts1(a: SyntaxExprList) -> SyntaxConflictList {
  SyntaxConflictCons(a, SyntaxConflictNil)
}

pub(package) fn syntax_conflicts2(a: SyntaxExprList, b: SyntaxExprList) -> SyntaxConflictList {
  SyntaxConflictCons(a, syntax_conflicts1(b))
}

pub(package) fn syntax_conflicts4(a: SyntaxExprList, b: SyntaxExprList, c: SyntaxExprList, d: SyntaxExprList) -> SyntaxConflictList {
  SyntaxConflictCons(a, SyntaxConflictCons(b, SyntaxConflictCons(c, syntax_conflicts1(d))))
}

pub(package) fn syntax_conflicts_concat(left: SyntaxConflictList, right: SyntaxConflictList) -> SyntaxConflictList {
  match left {
    SyntaxConflictNil -> right
    SyntaxConflictCons(head, rest) -> SyntaxConflictCons(head, syntax_conflicts_concat(rest, right))
  }
}
