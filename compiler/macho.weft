-- macho.weft — Mach-O binary format emission with ad-hoc code signing

use "compiler/lib.weft"
use "compiler/sha256.weft"

fn emit_pz2(o: i64) -> i64 {
  bfill(o, 6) bu64(o, 0) bu64(o, 4294967296) bu64(o, 0) bu64(o, 0)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_pz(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__PAGEZERO") emit_pz2(o)
}
-- Round up to page boundary (16384)
fn page_round(n: i64) -> i64 { ((n + 16383) / 16384) * 16384 }
fn emit_text_seg2(o: i64, ts: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296) bu64(o, ts) bu64(o, 0) bu64(o, ts)
  bu32(o, 5) bu32(o, 5) bu32(o, 1) bu32(o, 0)
}
fn emit_text_seg(o: i64, ts: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__TEXT") emit_text_seg2(o, ts)
}
fn emit_text_sec2(o: i64, code_size: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294983680) bu64(o, code_size) bu32(o, 16384) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 2147484672) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_text_sec(o: i64, code_size: i64) -> i64 {
  bstr(o, "__text") bfill(o, 10) bstr(o, "__TEXT") emit_text_sec2(o, code_size)
}
fn emit_data_seg2(o: i64, ts: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296 + ts) bu64(o, 16384) bu64(o, ts) bu64(o, 0)
  bu32(o, 3) bu32(o, 3) bu32(o, 1) bu32(o, 0)
}
fn emit_data_seg(o: i64, ts: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__DATA") emit_data_seg2(o, ts)
}
fn emit_data_sec2(o: i64, ts: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296 + ts) bu64(o, 0) bu32(o, ts) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
fn emit_data_sec(o: i64, ts: i64) -> i64 {
  bstr(o, "__const") bfill(o, 9) bstr(o, "__DATA") emit_data_sec2(o, ts)
}
fn emit_linkedit2(o: i64, ts: i64) -> i64 {
  bfill(o, 6)
  bu64(o, 4294967296 + ts + 16384) bu64(o, 16384) bu64(o, ts) bu64(o, 0)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}
fn emit_linkedit(o: i64, ts: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__LINKEDIT") emit_linkedit2(o, ts)
}
fn emit_linkedit_signed2(o: i64, ts: i64, sig_off: i64, linkedit_size: i64) -> i64 {
  bfill(o, 6)
  bu64(o, 4294967296 + ts + 16384) bu64(o, linkedit_size) bu64(o, sig_off) bu64(o, linkedit_size)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}
fn emit_linkedit_signed(o: i64, ts: i64, sig_off: i64, linkedit_size: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__LINKEDIT") emit_linkedit_signed2(o, ts, sig_off, linkedit_size)
}
fn emit_main_lc(o: i64, entry: i64) -> i64 {
  bu32(o, 2147483688) bu32(o, 24) bu64(o, 16384 + entry) bu64(o, 67108864)
}
fn emit_symtab(o: i64) -> i64 {
  bu32(o, 2) bu32(o, 24) bfill(o, 16)
}
fn emit_dylinker(o: i64) -> i64 {
  bu32(o, 14) bu32(o, 32) bu32(o, 12) bstr(o, "/usr/lib/dyld") bfill(o, 7)
}
fn emit_dylib2(o: i64) -> i64 {
  bstr(o, "/usr/lib/libSystem.B.dylib") bfill(o, 6)
}
fn emit_dylib(o: i64) -> i64 {
  bu32(o, 12) bu32(o, 56) bu32(o, 24) bu32(o, 0)
  bu32(o, 65536) bu32(o, 65536) emit_dylib2(o)
}
fn emit_dyld_info(o: i64) -> i64 {
  bu32(o, 2147483682) bu32(o, 48) bfill(o, 40)
}

fn emit_segs(o: i64, cs: i64, ts: i64) -> i64 {
  emit_pz(o) emit_text_seg(o, ts) emit_text_sec(o, cs)
  emit_data_seg(o, ts) emit_data_sec(o, ts) emit_linkedit(o, ts)
}
fn emit_lcs(o: i64, entry: i64) -> i64 {
  emit_main_lc(o, entry) emit_symtab(o) emit_dylinker(o) emit_dylib(o)
  emit_dyld_info(o)
}

-- LC_CODE_SIGNATURE load command (16 bytes)
fn emit_codesig_lc(o: i64, dataoff: i64, datasize: i64) -> i64 {
  bu32(o, 29) bu32(o, 16) bu32(o, dataoff) bu32(o, datasize)
}

-- Write big-endian u32 to output buffer
fn emit_be32(o: i64, val: i64) -> i64 {
  let v = val band 4294967295
  bu8(o, v bshr 24)
  bu8(o, (v bshr 16) band 255)
  bu8(o, (v bshr 8) band 255)
  bu8(o, v band 255)
}

-- Write big-endian u64 to output buffer
fn emit_be64(o: i64, val: i64) -> i64 {
  emit_be32(o, val bshr 32)
  emit_be32(o, val band 4294967295)
}

-- Compute and write ad-hoc code signature (split into small functions)
fn emit_codesig(o: i64, codelimit: i64, text_off: i64, text_size: i64) -> i64 {
  let nhashes = (codelimit + 4095) / 4096
  let hash_off = 93
  let cdir_size = hash_off + nhashes * 32
  let total_size = 20 + cdir_size
  emit_cs_super(o, total_size)
  emit_cs_cdir(o, cdir_size, hash_off, nhashes, codelimit)
  emit_cs_exec(o, text_off, text_size)
  emit_cs_id(o)
  emit_cs_hashes(o, codelimit, nhashes)
  total_size
}

fn emit_cs_super(o: i64, total_size: i64) -> i64 {
  emit_be32(o, 4208856256)
  emit_be32(o, total_size)
  emit_be32(o, 1)
  emit_be32(o, 0)
  emit_be32(o, 20)
}

fn emit_cs_cdir(o: i64, cdir_size: i64, hash_off: i64, nhashes: i64, codelimit: i64) -> i64 {
  emit_be32(o, 4208856066)
  emit_be32(o, cdir_size)
  emit_be32(o, 132096)
  emit_be32(o, 131074)
  emit_be32(o, hash_off)
  emit_be32(o, 88)
  emit_be32(o, 0)
  emit_be32(o, nhashes)
  emit_be32(o, codelimit)
  emit_cs_cdir2(o)
}

fn emit_cs_cdir2(o: i64) -> i64 {
  bu8(o, 32) bu8(o, 2) bu8(o, 0) bu8(o, 12)
  emit_be32(o, 0) emit_be32(o, 0) emit_be32(o, 0) emit_be32(o, 0)
  emit_be64(o, 0)
}

fn emit_cs_exec(o: i64, text_off: i64, text_size: i64) -> i64 {
  emit_be64(o, text_off)
  emit_be64(o, text_size)
  emit_be64(o, 1)
}

fn emit_cs_id(o: i64) -> i64 {
  bu8(o, 119) bu8(o, 101) bu8(o, 102) bu8(o, 116) bu8(o, 0)
}

fn emit_cs_hashes(o: i64, codelimit: i64, nhashes: i64) -> i64 {
  let base = buf_ptr(o)
  let hash_out = __bump_alloc(32)
  let k = __bump_alloc(512)
  sha256_k_init(k)
  let mut page = 0
  while page < nhashes {
    let off = page * 4096
    let len = if off + 4096 > codelimit { codelimit - off } else { 4096 }
    sha256_with_k(base + off, len, hash_out, k)
    let mut hi = 0
    while hi < 32 { bu8(o, __mem_load8(hash_out + hi)) hi = hi + 1 }
    page = page + 1
  }
  0
}

fn emit_macho(code: i64, main_off: i64) -> i64 {
  let cs = buf_len(code)
  let ts = page_round(16384 + cs)
  let so = ts + 16384
  emit_macho2(code, main_off, cs, ts, so)
}

fn emit_macho2(code: i64, main_off: i64, cs: i64, ts: i64, so: i64) -> i64 {
  let nh = (so + 4095) / 4096
  let ss = 20 + 93 + nh * 32
  let ll = page_round(ss)
  emit_macho3(code, main_off, cs, ts, so, ss, ll)
}

fn emit_macho3(code: i64, m: i64, cs: i64, ts: i64, so: i64, ss: i64, ll: i64) -> i64 {
  let o = buf_new(so + ll + 4096)
  emit_macho_hdr(o, cs, ts, so, ll, ss, m)
  bscopy(o, buf_ptr(code), cs, 0)
  bpad(o, ts)
  bpad(o, so)
  emit_codesig(o, so, 16384, ts - 16384)
  bpad(o, so + ll)
  o
}

fn emit_macho_hdr(o: i64, cs: i64, ts: i64, so: i64, ll: i64, ss: i64, m: i64) -> i64 {
  bu32(o, 4277009103) bu32(o, 16777228) bu32(o, 0) bu32(o, 2)
  bu32(o, 10) bu32(o, 648) bu32(o, 2097285) bu32(o, 0)
  emit_pz(o)
  emit_text_seg(o, ts) emit_text_sec(o, cs)
  emit_data_seg(o, ts) emit_data_sec(o, ts)
  emit_linkedit_signed(o, ts, so, ll)
  emit_lcs(o, m)
  emit_codesig_lc(o, so, ss)
  bpad(o, 16384)
}
