-- macho.weft — Mach-O binary format emission with ad-hoc code signing

use compiler/lib.{*}
use compiler/codegen.{bytes_set_u32}
use compiler/encode.{*}
use compiler/native_link.{*}
use compiler/sha256.{*}
use runtime/buffer.{*}
use runtime/macho_storage.{*}
use stdlib/list.{*}

pub(package) fn emit_pz2(o: i64) -> i64 {
  bfill(o, 6) bu64(o, 0) bu64(o, 4294967296) bu64(o, 0) bu64(o, 0)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
pub(package) fn emit_pz(o: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__PAGEZERO") emit_pz2(o)
}
-- Round up to page boundary (16384)
pub(package) fn page_round(n: i64) -> i64 { ((n + 16383) / 16384) * 16384 }
pub(package) fn emit_text_seg2(o: i64, ts: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296) bu64(o, ts) bu64(o, 0) bu64(o, ts)
  bu32(o, 5) bu32(o, 5) bu32(o, 1) bu32(o, 0)
}
pub(package) fn emit_text_seg(o: i64, ts: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__TEXT") emit_text_seg2(o, ts)
}
pub(package) fn emit_text_sec2(o: i64, code_size: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294983680) bu64(o, code_size) bu32(o, 16384) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 2147484672) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
pub(package) fn emit_text_sec(o: i64, code_size: i64) -> i64 {
  bstr(o, "__text") bfill(o, 10) bstr(o, "__TEXT") emit_text_sec2(o, code_size)
}
-- The __DATA segment is a writable zero-fill page block (filesize 0).
-- Its base 16KB holds nothing by default; static closure-pair slots
-- (2q slice 1) live here, and ds grows page-rounded when they need more.
pub(package) fn emit_data_seg2(o: i64, ts: i64, ds: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296 + ts) bu64(o, ds) bu64(o, ts) bu64(o, 0)
  bu32(o, 3) bu32(o, 3) bu32(o, 1) bu32(o, 0)
}
pub(package) fn emit_data_seg(o: i64, ts: i64, ds: i64) -> i64 {
  bu32(o, 25) bu32(o, 152) bstr(o, "__DATA") emit_data_seg2(o, ts, ds)
}
pub(package) fn emit_data_sec2(o: i64, ts: i64) -> i64 {
  bfill(o, 10)
  bu64(o, 4294967296 + ts) bu64(o, 0) bu32(o, ts) bu32(o, 2)
  bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0) bu32(o, 0)
}
pub(package) fn emit_data_sec(o: i64, ts: i64) -> i64 {
  bstr(o, "__const") bfill(o, 9) bstr(o, "__DATA") emit_data_sec2(o, ts)
}
pub(package) fn emit_linkedit2(o: i64, ts: i64) -> i64 {
  bfill(o, 6)
  bu64(o, 4294967296 + ts + 16384) bu64(o, 16384) bu64(o, ts) bu64(o, 0)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}
pub(package) fn emit_linkedit(o: i64, ts: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__LINKEDIT") emit_linkedit2(o, ts)
}
-- sig_off is also the __LINKEDIT vmaddr offset: the segment starts
-- directly after the __DATA zero-fill block (ts + ds).
pub(package) fn emit_linkedit_signed2(o: i64, ts: i64, sig_off: i64, linkedit_size: i64) -> i64 {
  bfill(o, 6)
  bu64(o, 4294967296 + sig_off) bu64(o, linkedit_size) bu64(o, sig_off) bu64(o, linkedit_size)
  bu32(o, 1) bu32(o, 1) bu32(o, 0) bu32(o, 0)
}
pub(package) fn emit_linkedit_signed(o: i64, ts: i64, sig_off: i64, linkedit_size: i64) -> i64 {
  bu32(o, 25) bu32(o, 72) bstr(o, "__LINKEDIT") emit_linkedit_signed2(o, ts, sig_off, linkedit_size)
}
pub(package) fn emit_main_lc(o: i64, entry: i64) -> i64 {
  bu32(o, 2147483688) bu32(o, 24) bu64(o, 16384 + entry) bu64(o, 67108864)
}
pub(package) fn emit_symtab(o: i64) -> i64 {
  bu32(o, 2) bu32(o, 24) bfill(o, 16)
}
pub(package) fn emit_dylinker(o: i64) -> i64 {
  bu32(o, 14) bu32(o, 32) bu32(o, 12) bstr(o, "/usr/lib/dyld") bfill(o, 7)
}
pub(package) fn emit_dylib2(o: i64) -> i64 {
  bstr(o, "/usr/lib/libSystem.B.dylib") bfill(o, 6)
}
pub(package) fn emit_dylib(o: i64) -> i64 {
  bu32(o, 12) bu32(o, 56) bu32(o, 24) bu32(o, 0)
  bu32(o, 65536) bu32(o, 65536) emit_dylib2(o)
}
pub(package) fn emit_dyld_info(o: i64) -> i64 {
  bu32(o, 2147483682) bu32(o, 48) bfill(o, 40)
}

pub(package) fn emit_segs(o: i64, cs: i64, ts: i64) -> i64 {
  emit_pz(o) emit_text_seg(o, ts) emit_text_sec(o, cs)
  emit_data_seg(o, ts, 16384) emit_data_sec(o, ts) emit_linkedit(o, ts)
}
pub(package) fn emit_lcs(o: i64, entry: i64) -> i64 {
  emit_main_lc(o, entry) emit_symtab(o) emit_dylinker(o) emit_dylib(o)
  emit_dyld_info(o)
}

-- LC_CODE_SIGNATURE load command (16 bytes)
pub(package) fn emit_codesig_lc(o: i64, dataoff: i64, datasize: i64) -> i64 {
  bu32(o, 29) bu32(o, 16) bu32(o, dataoff) bu32(o, datasize)
}

-- Write big-endian u32 to output buffer
pub(package) fn emit_be32(o: i64, val: i64) -> i64 {
  let v = val band 4294967295
  bu8(o, v bshr 24)
  bu8(o, (v bshr 16) band 255)
  bu8(o, (v bshr 8) band 255)
  bu8(o, v band 255)
}

-- Write big-endian u64 to output buffer
pub(package) fn emit_be64(o: i64, val: i64) -> i64 {
  emit_be32(o, val bshr 32)
  emit_be32(o, val band 4294967295)
}

-- Compute and write ad-hoc code signature (split into small functions)
pub(package) fn emit_codesig(o: i64, codelimit: i64, text_off: i64, text_size: i64) -> i64 {
  let nhashes = (codelimit + 4095) / 4096
  let hash_off = 93
  let cdir_size = hash_off + nhashes * 32
  let total_size = 20 + cdir_size
  emit_cs_super(o, total_size)
  emit_cs_cdir(o, cdir_size, hash_off, nhashes, codelimit)
  emit_cs_exec(o, text_off, text_size)
  emit_cs_id(o)
  emit_cs_hashes(o, codelimit, nhashes)
  total_size
}

pub(package) fn emit_cs_super(o: i64, total_size: i64) -> i64 {
  emit_be32(o, 4208856256)
  emit_be32(o, total_size)
  emit_be32(o, 1)
  emit_be32(o, 0)
  emit_be32(o, 20)
}

pub(package) fn emit_cs_cdir(o: i64, cdir_size: i64, hash_off: i64, nhashes: i64, codelimit: i64) -> i64 {
  emit_be32(o, 4208856066)
  emit_be32(o, cdir_size)
  emit_be32(o, 132096)
  emit_be32(o, 131074)
  emit_be32(o, hash_off)
  emit_be32(o, 88)
  emit_be32(o, 0)
  emit_be32(o, nhashes)
  emit_be32(o, codelimit)
  emit_cs_cdir2(o)
}

pub(package) fn emit_cs_cdir2(o: i64) -> i64 {
  bu8(o, 32) bu8(o, 2) bu8(o, 0) bu8(o, 12)
  emit_be32(o, 0) emit_be32(o, 0) emit_be32(o, 0) emit_be32(o, 0)
  emit_be64(o, 0)
}

pub(package) fn emit_cs_exec(o: i64, text_off: i64, text_size: i64) -> i64 {
  emit_be64(o, text_off)
  emit_be64(o, text_size)
  emit_be64(o, 1)
}

pub(package) fn emit_cs_id(o: i64) -> i64 {
  bu8(o, 119) bu8(o, 101) bu8(o, 102) bu8(o, 116) bu8(o, 0)
}

pub(package) fn emit_cs_hashes(o: i64, codelimit: i64, nhashes: i64) -> i64 {
  -- Re-read buf_ptr after each hash write since bu8 may relocate the buffer
  let hash_out = macho_storage_alloc_scratch(32)
  let k = sha256_k_values()
  let mut page = 0
  while page < nhashes {
    let base = buf_ptr(o)
    let off = page * 4096
    let len = if off + 4096 > codelimit { codelimit - off } else { 4096 }
    sha256_with_k(base + off, len, hash_out, k)
    let mut hi = 0
    while hi < 32 { bu8(o, macho_storage_byte_at(hash_out, hi)) hi = hi + 1 }
    page = page + 1
  }
  0
}

-- ds: __DATA zero-fill vmsize (16384 default; larger page-rounded sizes
-- carry static closure-pair slots).
pub(package) fn emit_macho(code: i64, main_off: i64, ds: i64) -> rc i64 {
  let cs = buf_len(code)
  let ts = page_round(16384 + cs)
  let so = ts + ds
  emit_macho2(code, main_off, cs, ts, so, ds)
}

-- Emit Mach-O with real LINKEDIT data (GOT, bind info, symbol table)
-- ngot = number of GOT entries to emit
pub(package) fn emit_macho_linked(code: i64, main_off: i64, fm: i64) -> rc i64 {
  let cs = buf_len(code)
  let ts = page_round(16384 + cs)
  let so = ts + 16384
  let ngot_patches = macho_storage_got_patch_count(fm)
  -- If no GOT entries, fall back to simple emission
  if ngot_patches == 0 { emit_macho2(code, main_off, cs, ts, so, 16384) }
  else {
    -- 5 GOT slots: posix_spawn=0, waitpid=1, exit=2, pthread_create=3, pthread_join=4
    let ngot = 5
    -- LINKEDIT layout: bind + indirect + symtab + strtab
    let bind_size = 73
    let bind_padded = 80
    let indirect_size = ngot * 4
    let indirect_padded = (indirect_size + 7) / 8 * 8
    let symtab_size = ngot * 16
    -- String table: \0 + _posix_spawn\0 + _waitpid\0 + _exit\0 + _pthread_create\0 + _pthread_join\0
    -- = 1 + 13 + 9 + 6 + 16 + 14 = 59, padded to 60
    let strtab_size = 60
    let linkedit_pre = bind_padded + indirect_padded + symtab_size + strtab_size
    let codesig_off = so + linkedit_pre
    let nh = (codesig_off + 4095) / 4096
    let ss = 20 + 93 + nh * 32
    let ll = page_round(linkedit_pre + ss)
    let o = buf_new(so + ll + 4096)
    -- Header: 11 load commands, updated sizeofcmds
    bu32(o, 4277009103) bu32(o, 16777228) bu32(o, 0) bu32(o, 2)
    bu32(o, 11) bu32(o, 728) bu32(o, 2097285) bu32(o, 0)
    -- Segments
    emit_pz(o) emit_text_seg(o, ts) emit_text_sec(o, cs)
    emit_data_seg(o, ts, 16384) emit_got_sec(o, ts, ngot)
    emit_linkedit_signed(o, ts, so, ll)
    -- Load commands with real offsets
    emit_main_lc(o, main_off)
    emit_symtab_real(o, so + bind_padded + indirect_padded, ngot, so + bind_padded + indirect_padded + symtab_size, strtab_size)
    emit_dylinker(o) emit_dylib(o)
    emit_dyld_info_real(o, so, bind_size)
    emit_dysymtab(o, so + bind_padded, ngot)
    emit_codesig_lc(o, codesig_off, ss)
    -- Pad to page boundary then copy code section
    bpad(o, 16384)
    bscopy(o, buf_ptr(code), cs, 0)
    bpad(o, ts)
    -- GOT entries (zero-filled — dyld binds at load time)
    bpad(o, so)
    -- LINKEDIT data
    emit_bind_data(o)
    bpad(o, so + bind_padded)
    emit_indirect_data(o, ngot)
    bpad(o, so + bind_padded + indirect_padded)
    emit_nlist_data(o, ngot)
    emit_strtab_data(o)
    bpad(o, codesig_off)
    -- Code signature
    emit_codesig(o, codesig_off, 16384, ts - 16384)
    bpad(o, so + ll)
    o
  }
}

-- __got section header (replaces __const)
pub(package) fn emit_got_sec(o: i64, ts: i64, ngot: i64) -> i64 {
  bstr(o, "__got") bfill(o, 11)
  bstr(o, "__DATA") bfill(o, 10)
  bu64(o, 4294967296 + ts) bu64(o, ngot * 8)
  bu32(o, ts) bu32(o, 3)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 6)
  bu32(o, 0) bu32(o, 0) bu32(o, 0)
}

-- LC_SYMTAB with real offsets
pub(package) fn emit_symtab_real(o: i64, symoff: i64, nsyms: i64, stroff: i64, strsize: i64) -> i64 {
  bu32(o, 2) bu32(o, 24) bu32(o, symoff) bu32(o, nsyms) bu32(o, stroff) bu32(o, strsize)
}

-- LC_DYLD_INFO_ONLY with bind offsets
pub(package) fn emit_dyld_info_real(o: i64, bind_off: i64, bind_size: i64) -> i64 {
  bu32(o, 2147483682) bu32(o, 48)
  bu32(o, 0) bu32(o, 0)
  bu32(o, bind_off) bu32(o, bind_size)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
}

-- LC_DYSYMTAB
pub(package) fn emit_dysymtab(o: i64, indirect_off: i64, ngot: i64) -> i64 {
  bu32(o, 11) bu32(o, 80)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, ngot)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
  bu32(o, indirect_off) bu32(o, ngot)
  bu32(o, 0) bu32(o, 0)
  bu32(o, 0) bu32(o, 0)
}

-- Non-lazy bind info for 5 symbols
pub(package) fn emit_bind_data(o: i64) -> i64 {
  bu8(o, 17)   -- SET_DYLIB_ORDINAL_IMM(1)
  bu8(o, 81)   -- SET_TYPE_IMM(POINTER=1)
  bu8(o, 114)  -- SET_SEGMENT_AND_OFFSET_ULEB(seg=2)
  bu8(o, 0)    -- offset=0
  bu8(o, 64) bstr(o, "_posix_spawn") bu8(o, 0) bu8(o, 144)
  bu8(o, 64) bstr(o, "_waitpid") bu8(o, 0) bu8(o, 144)
  bu8(o, 64) bstr(o, "_exit") bu8(o, 0) bu8(o, 144)
  bu8(o, 64) bstr(o, "_pthread_create") bu8(o, 0) bu8(o, 144)
  bu8(o, 64) bstr(o, "_pthread_join") bu8(o, 0) bu8(o, 144)
  bu8(o, 0)    -- DONE
  0
}

-- Indirect symbol table (ngot entries)
pub(package) fn emit_indirect_data(o: i64, ngot: i64) -> i64 {
  for i in 0..ngot { bu32(o, i) }
  0
}

-- nlist_64 entries (each 16 bytes)
pub(package) fn emit_nlist_data(o: i64, ngot: i64) -> i64 {
  -- strx offsets: \0(0) _posix_spawn(1) _waitpid(14) _exit(23) _pthread_create(29) _pthread_join(45)
  bu32(o, 1) bu8(o, 1) bu8(o, 0) bu8(o, 0) bu8(o, 1) bu64(o, 0)
  bu32(o, 14) bu8(o, 1) bu8(o, 0) bu8(o, 0) bu8(o, 1) bu64(o, 0)
  bu32(o, 23) bu8(o, 1) bu8(o, 0) bu8(o, 0) bu8(o, 1) bu64(o, 0)
  bu32(o, 29) bu8(o, 1) bu8(o, 0) bu8(o, 0) bu8(o, 1) bu64(o, 0)
  bu32(o, 45) bu8(o, 1) bu8(o, 0) bu8(o, 0) bu8(o, 1) bu64(o, 0)
  0
}

-- String table
pub(package) fn emit_strtab_data(o: i64) -> i64 {
  bu8(o, 0)
  bstr(o, "_posix_spawn") bu8(o, 0)
  bstr(o, "_waitpid") bu8(o, 0)
  bstr(o, "_exit") bu8(o, 0)
  bstr(o, "_pthread_create") bu8(o, 0)
  bstr(o, "_pthread_join") bu8(o, 0)
  0
}

pub(package) fn emit_macho2(code: i64, main_off: i64, cs: i64, ts: i64, so: i64, ds: i64) -> rc i64 {
  let nh = (so + 4095) / 4096
  let ss = 20 + 93 + nh * 32
  let ll = page_round(ss)
  emit_macho3(code, main_off, cs, ts, so, ss, ll, ds)
}

pub(package) fn emit_macho3(code: i64, m: i64, cs: i64, ts: i64, so: i64, ss: i64, ll: i64, ds: i64) -> rc i64 {
  let o = buf_new(so + ll + 4096)
  emit_macho_hdr(o, cs, ts, so, ll, ss, m, ds)
  bscopy(o, buf_ptr(code), cs, 0)
  bpad(o, ts)
  bpad(o, so)
  emit_codesig(o, so, 16384, ts - 16384)
  bpad(o, so + ll)
  o
}

pub(package) fn emit_macho_hdr(o: i64, cs: i64, ts: i64, so: i64, ll: i64, ss: i64, m: i64, ds: i64) -> i64 {
  bu32(o, 4277009103) bu32(o, 16777228) bu32(o, 0) bu32(o, 2)
  bu32(o, 10) bu32(o, 648) bu32(o, 2097285) bu32(o, 0)
  emit_pz(o)
  emit_text_seg(o, ts) emit_text_sec(o, cs)
  emit_data_seg(o, ts, ds) emit_data_sec(o, ts)
  emit_linkedit_signed(o, ts, so, ll)
  emit_lcs(o, m)
  emit_codesig_lc(o, so, ss)
  bpad(o, 16384)
}

-- The Mach-O leaf owns managed output buffers; the shared native-link module
-- remains a pure typed graph producer with no internal ownership privilege.
pub(package) fn native_link_emit_bind_data(symbols: List<NativeLinkSymbol>) -> rc i64 {
  let bind = buf_new(list_len<NativeLinkSymbol>(symbols) * 40 + 16)
  if list_len<NativeLinkSymbol>(symbols) != 0 {
    bu8(bind, 81)
    bu8(bind, 114)
    native_link_emit_uleb(bind, 0)
    let mut current = symbols
    let mut done = false
    while done == false {
      match current {
        Nil -> { done = true 0 }
        Cons(symbol, rest) -> {
          match symbol {
            NativeLinkUndefinedStrong(name, ordinal, origin) -> {
              if ordinal <= 15 {
                bu8(bind, 16 + ordinal)
              } else {
                bu8(bind, 32)
                native_link_emit_uleb(bind, ordinal)
              }
              bu8(bind, 64)
              bu8(bind, 95)
              bstr(bind, name)
              bu8(bind, 0)
              bu8(bind, 144)
            }
          }
          current = rest
          0
        }
      }
    }
  } else { 0 }
  bu8(bind, 0)
  bind
}

pub(package) fn native_link_emit_strtab(symbols: List<NativeLinkSymbol>) -> rc i64 {
  let strings = buf_new(list_len<NativeLinkSymbol>(symbols) * 32 + 8)
  bu8(strings, 0)
  let mut current = symbols
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(symbol, rest) -> {
        match symbol {
          NativeLinkUndefinedStrong(name, ordinal, origin) -> {
            bu8(strings, 95)
            bstr(strings, name)
            bu8(strings, 0)
          }
        }
        current = rest
        0
      }
    }
  }
  strings
}

pub(package) fn emit_native_link_macho(graph: NativeLinkGraph) -> rc i64 {
  match graph {
    NativeLinkGraph(target, original_code, libraries, symbols, relocations, static_slots) -> {
      let symbol_count = list_len<NativeLinkSymbol>(symbols)
      let stub_base = native_link_align(buf_len(original_code), 4)
      let code_size = stub_base + symbol_count * 12
      let text_size = page_round(16384 + code_size)
      let static_offset = native_link_align(symbol_count * 8, 16)
      let static_size = static_slots * 16
      let data_need = static_offset + static_size
      let data_size = page_round(if data_need > 0 { data_need } else { 1 })
      let linkedit_offset = text_size + data_size
      let code = buf_new(code_size + 16)
      bscopy(code, buf_ptr(original_code), buf_len(original_code), 0)
      bpad(code, stub_base)
      native_link_emit_stubs(code, symbols, text_size, stub_base, 0)
      native_link_apply_relocations(code, relocations, text_size, stub_base, static_offset)

      let bind = native_link_emit_bind_data(symbols)
      let strings = native_link_emit_strtab(symbols)
      let bind_size = buf_len(bind)
      let bind_padded = native_link_align(bind_size, 8)
      let indirect_size = symbol_count * 4
      let indirect_padded = native_link_align(indirect_size, 8)
      let symtab_size = symbol_count * 16
      let linkedit_before_signature = bind_padded + indirect_padded + symtab_size + buf_len(strings)
      let signature_offset = linkedit_offset + linkedit_before_signature
      let hash_count = (signature_offset + 4095) / 4096
      let signature_size = 20 + 93 + hash_count * 32
      let linkedit_size = page_round(linkedit_before_signature + signature_size)

      let dylibs = native_link_dylibs(libraries)
      let dylib_count = list_len<str>(dylibs)
      let data_command_size = 72 + (1 + (if static_size > 0 { 1 } else { 0 })) * 80
      let commands_size = 72 + 152 + data_command_size + 72 + 24 + 24 + 32 + native_link_dylib_commands_size(dylibs) + 48 + 80 + 16
      let output = buf_new(linkedit_offset + linkedit_size + 4096)
      bu32(output, 4277009103) bu32(output, 16777228) bu32(output, 0) bu32(output, 2)
      bu32(output, 10 + dylib_count) bu32(output, commands_size) bu32(output, 2097285) bu32(output, 0)
      emit_pz(output)
      emit_text_seg(output, text_size) emit_text_sec(output, code_size)
      native_link_emit_data_segment(output, text_size, data_size, symbol_count, static_offset, static_size)
      emit_linkedit_signed(output, text_size, linkedit_offset, linkedit_size)
      emit_main_lc(output, 0)
      emit_symtab_real(
        output,
        linkedit_offset + bind_padded + indirect_padded,
        symbol_count,
        linkedit_offset + bind_padded + indirect_padded + symtab_size,
        buf_len(strings)
      )
      emit_dylinker(output)
      native_link_emit_dylib_commands(output, dylibs)
      emit_dyld_info_real(output, linkedit_offset, bind_size)
      emit_dysymtab(output, linkedit_offset + bind_padded, symbol_count)
      emit_codesig_lc(output, signature_offset, signature_size)
      bpad(output, 16384)
      bscopy(output, buf_ptr(code), buf_len(code), 0)
      bpad(output, text_size)
      bpad(output, linkedit_offset)
      bscopy(output, buf_ptr(bind), bind_size, 0)
      bpad(output, linkedit_offset + bind_padded)
      for i in 0..symbol_count { bu32(output, i) }
      bpad(output, linkedit_offset + bind_padded + indirect_padded)
      native_link_emit_nlists(output, symbols)
      bscopy(output, buf_ptr(strings), buf_len(strings), 0)
      bpad(output, signature_offset)
      emit_codesig(output, signature_offset, 16384, text_size - 16384)
      bpad(output, linkedit_offset + linkedit_size)
      output
    }
  }
}
