-- compiler/docgen.weft -- checked semantic facts to local Markdown API docs

use compiler/lib.{*}
use compiler/module.{*}
use compiler/pipeline.{TypedModule}
use compiler/semantic_fact.{*}
use compiler/type_registry.{*}
use compiler/typeck.{ftypes_find_decl}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{runtime_int_to_str, runtime_str_from_bytes_copy}
use stdlib/semantic_type.{*}
use stdlib/semantic_type_render.{semantic_type_append, semantic_type_append_effects}

pub(package) fn docgen_append_trait_bounds(b: i64, bounds: SemanticTraitBoundFactList, first: bool) -> i64 {
  match bounds {
    SemanticTraitBoundFactListNil -> 0
    SemanticTraitBoundFactListCons(bound, rest) -> {
      if not first { bstr(b, " & ") } else { 0 }
      match bound {
        SemanticTraitBound(name) -> bstr(b, name)
        SemanticTraitBoundOther(name) -> bstr(b, name)
      }
      docgen_append_trait_bounds(b, rest, false)
    }
    SemanticTraitBoundFactListOther(name) -> {
      if not first { bstr(b, " & ") } else { 0 }
      bstr(b, name)
    }
  }
  0
}

pub(package) fn docgen_append_type_parameter(b: i64, parameter: SemanticTypeParameterFact) -> i64 {
  match parameter {
    SemanticTypeParameter(name, bounds) -> {
      bstr(b, name)
      match bounds {
        SemanticBoundsTraits(SemanticTraitBoundFactListNil) -> 0
        SemanticBoundsTraits(traits) -> { bstr(b, ": ") docgen_append_trait_bounds(b, traits, true) }
        SemanticBoundsUnknown -> 0
        SemanticBoundsTypeParameters(params) -> 0
        SemanticBoundsOther(name) -> { bstr(b, ": ") bstr(b, name) }
      }
    }
    SemanticTypeParameterOther(name) -> bstr(b, name)
  }
  0
}

pub(package) fn docgen_append_type_parameters_inner(b: i64, parameters: SemanticTypeParameterFactList, first: bool) -> i64 {
  match parameters {
    SemanticTypeParameterFactListNil -> 0
    SemanticTypeParameterFactListCons(parameter, rest) -> {
      if not first { bstr(b, ", ") } else { 0 }
      docgen_append_type_parameter(b, parameter)
      docgen_append_type_parameters_inner(b, rest, false)
    }
    SemanticTypeParameterFactListOther(name) -> {
      if not first { bstr(b, ", ") } else { 0 }
      bstr(b, name)
    }
  }
  0
}

pub(package) fn docgen_append_type_parameters(b: i64, parameters: SemanticTypeParameterFactList) -> i64 {
  match parameters {
    SemanticTypeParameterFactListNil -> 0
    _ -> {
      bstr(b, "<")
      docgen_append_type_parameters_inner(b, parameters, true)
      bstr(b, ">")
    }
  }
  0
}

pub(package) fn docgen_append_parameter(b: i64, parameter: SemanticParameterFact) -> i64 {
  match parameter {
    SemanticParameter(name, ty) -> { bstr(b, name) bstr(b, ": ") semantic_type_append(b, ty) }
    SemanticParameterOther(name) -> bstr(b, name)
  }
  0
}

pub(package) fn docgen_append_parameters(b: i64, parameters: SemanticParameterFactList, first: bool) -> i64 {
  match parameters {
    SemanticParameterFactListNil -> 0
    SemanticParameterFactListCons(parameter, rest) -> {
      if not first { bstr(b, ", ") } else { 0 }
      docgen_append_parameter(b, parameter)
      docgen_append_parameters(b, rest, false)
    }
    SemanticParameterFactListOther(name) -> {
      if not first { bstr(b, ", ") } else { 0 }
      bstr(b, name)
    }
  }
  0
}

pub(package) fn docgen_function_type_parameters(bounds: SemanticBoundsFact) -> SemanticTypeParameterFactList {
  match bounds {
    SemanticBoundsTypeParameters(parameters) -> parameters
    _ -> SemanticTypeParameterFactListNil
  }
}

pub(package) fn docgen_append_function_fact(b: i64, fact: SemanticFunctionFact) -> i64 {
  match fact {
    SemanticFunction(name, parameters, result, effects, purity, ownership, shape, bounds) -> {
      bstr(b, "pub fn ")
      bstr(b, name)
      docgen_append_type_parameters(b, docgen_function_type_parameters(bounds))
      bstr(b, "(")
      docgen_append_parameters(b, parameters, true)
      bstr(b, ")")
      semantic_type_append_effects(b, effects)
      semantic_type_append(b, result)
    }
    SemanticFunctionOther(name) -> { bstr(b, "pub fn ") bstr(b, name) }
  }
  0
}

pub(package) fn docgen_append_function_signature(b: i64, tt: i64, declaration: i64) -> i64 {
  let functions = ttable_get_checked_functions(tt)
  let entry = if functions == 0 { 0 } else { ftypes_find_decl(functions, declaration) }
  match semantic_fact_function_entry(tt, entry) {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact))) -> {
      docgen_append_function_fact(b, fact)
      1
    }
    _ -> 0
  }
}

pub(package) fn docgen_append_type_declaration_fact(b: i64, fact: SemanticTypeDeclarationFact) -> i64 {
  match fact {
    SemanticTypeDeclaration(name, kind, parameters, member_count) -> {
      match kind {
        SemanticTypeDeclarationTrait -> bstr(b, "pub trait ")
        _ -> bstr(b, "pub type ")
      }
      bstr(b, name)
      docgen_append_type_parameters(b, parameters)
      match kind {
        SemanticTypeDeclarationOpaque -> bstr(b, " = opaque")
        _ -> 0
      }
    }
    SemanticTypeDeclarationOther(name) -> { bstr(b, "pub type ") bstr(b, name) }
  }
  0
}

pub(package) fn docgen_append_type_signature(b: i64, tt: i64, declaration: i64) -> i64 {
  let entry = ttable_lookup_decl_fact(tt, declaration)
  match semantic_fact_type_declaration_entry(entry, tt) {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactTypeDeclaration(fact))) -> {
      docgen_append_type_declaration_fact(b, fact)
      1
    }
    _ -> 0
  }
}

pub(package) fn docgen_append_effect_operation(b: i64, operation: SemanticEffectOperationFact) -> i64 {
  match operation {
    SemanticEffectOperation(name, parameters, result, deferred) -> {
      bstr(b, "  ")
      if deferred { bstr(b, "@deferred ") } else { 0 }
      bstr(b, "fn ")
      bstr(b, name)
      bstr(b, "(")
      docgen_append_parameters(b, parameters, true)
      bstr(b, ") -> ")
      semantic_type_append(b, result)
    }
    SemanticEffectOperationOther(name) -> { bstr(b, "  fn ") bstr(b, name) }
  }
  0
}

pub(package) fn docgen_append_effect_operations(b: i64, operations: SemanticEffectOperationFactList) -> i64 {
  match operations {
    SemanticEffectOperationFactListNil -> 0
    SemanticEffectOperationFactListCons(operation, rest) -> {
      docgen_append_effect_operation(b, operation)
      bstr(b, "\n")
      docgen_append_effect_operations(b, rest)
    }
    SemanticEffectOperationFactListOther(name) -> { bstr(b, "  ") bstr(b, name) bstr(b, "\n") }
  }
  0
}

pub(package) fn docgen_append_effect_fact(b: i64, fact: SemanticEffectDeclarationFact) -> i64 {
  match fact {
    SemanticEffectDeclaration(name, parameters, operations) -> {
      bstr(b, "pub effect ")
      bstr(b, name)
      docgen_append_type_parameters(b, parameters)
      bstr(b, " ")
      bstr(b, "{")
      bstr(b, "\n")
      docgen_append_effect_operations(b, operations)
      bstr(b, "}")
    }
    SemanticEffectDeclarationOther(name) -> { bstr(b, "pub effect ") bstr(b, name) }
  }
  0
}

pub(package) fn docgen_append_effect_signature(b: i64, tt: i64, declaration: i64) -> i64 {
  let entry = ttable_lookup_decl_fact(tt, declaration)
  match semantic_fact_effect_declaration_entry(entry, tt) {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(fact))) -> {
      docgen_append_effect_fact(b, fact)
      1
    }
    _ -> 0
  }
}

pub(package) fn docgen_line_start(src: i64, position: i64) -> i64 {
  let mut start = position
  while start > 0 and mem_load8_at(src, start - 1) != 10 and mem_load8_at(src, start - 1) != 13 {
    start = start - 1
  }
  start
}

pub(package) fn docgen_previous_line_bounds(src: i64, line_start: i64) -> i64 {
  if line_start <= 0 { node_new(0, 0, 0, 0, 0) }
  else {
    let mut end = line_start
    if end > 0 and mem_load8_at(src, end - 1) == 10 { end = end - 1 } else { 0 }
    if end > 0 and mem_load8_at(src, end - 1) == 13 { end = end - 1 } else { 0 }
    let start = docgen_line_start(src, end)
    node_new(0, start, end, 0, 0)
  }
}

pub(package) fn docgen_doc_content_start(src: i64, start: i64, end: i64) -> i64 {
  let mut content = start
  while content < end and (mem_load8_at(src, content) == 32 or mem_load8_at(src, content) == 9) { content = content + 1 }
  if content + 3 > end { 0 - 1 }
  else { if mem_load8_at(src, content) != 45 or mem_load8_at(src, content + 1) != 45 or mem_load8_at(src, content + 2) != 45 { 0 - 1 }
    else {
      content = content + 3
      if content < end and mem_load8_at(src, content) == 32 { content + 1 } else { content }
    } }
}

pub(package) fn docgen_comment_first_line(src: i64, name_start: i64) -> i64 {
  let mut line = docgen_line_start(src, name_start)
  let mut first = line
  let mut done = false
  while not done and line > 0 {
    let bounds = docgen_previous_line_bounds(src, line)
    let start = node_f1(bounds)
    let end = node_f2(bounds)
    if docgen_doc_content_start(src, start, end) < 0 { done = true }
    else { first = start line = start }
  }
  first
}

pub(package) fn docgen_has_comment(src: i64, name_start: i64) -> bool {
  docgen_comment_first_line(src, name_start) < docgen_line_start(src, name_start)
}

pub(package) fn docgen_append_comment(b: i64, src: i64, name_start: i64) -> i64 {
  let declaration_line = docgen_line_start(src, name_start)
  let first = docgen_comment_first_line(src, name_start)
  if first >= declaration_line { 0 }
  else {
    let mut line = first
    while line < declaration_line {
      let mut end = line
      while end < declaration_line and mem_load8_at(src, end) != 10 and mem_load8_at(src, end) != 13 { end = end + 1 }
      let content = docgen_doc_content_start(src, line, end)
      if content >= 0 { bscopy(b, src + content, end - content, 0) bstr(b, "\n") } else { 0 }
      while end < declaration_line and (mem_load8_at(src, end) == 10 or mem_load8_at(src, end) == 13) { end = end + 1 }
      line = end
    }
    1
  }
}

pub(package) fn docgen_decl_is_public_root(declaration: i64, src: i64) -> bool {
  if declaration == 0 or module_decl_fact_source(declaration) != src or module_decl_fact_owner(declaration) != 0 { false }
  else { if module_decl_fact_visibility_code(declaration) != module_visibility_public() { false }
    else {
      let namespace = module_decl_fact_namespace(declaration)
      namespace == module_decl_namespace_value() or namespace == module_decl_namespace_type() or namespace == module_decl_namespace_effect() or namespace == module_decl_namespace_trait()
    } }
}

pub(package) fn docgen_decl_kind(declaration: i64) -> str {
  let namespace = module_decl_fact_namespace(declaration)
  if namespace == module_decl_namespace_value() { "Function" }
  else { if namespace == module_decl_namespace_effect() { "Effect" }
    else { if namespace == module_decl_namespace_trait() { "Trait" }
      else { "Type" } } }
}

pub(package) fn docgen_append_decl_signature(b: i64, tt: i64, declaration: i64) -> i64 {
  let namespace = module_decl_fact_namespace(declaration)
  if namespace == module_decl_namespace_value() { docgen_append_function_signature(b, tt, declaration) }
  else { if namespace == module_decl_namespace_effect() { docgen_append_effect_signature(b, tt, declaration) }
    else { docgen_append_type_signature(b, tt, declaration) } }
}

pub(package) fn docgen_public_count(tt: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    if docgen_decl_is_public_root(module_fact_decl_at(tt, i), src) { count = count + 1 } else { 0 }
  }
  count
}

pub(package) fn docgen_documented_count(tt: i64, src: i64) -> i64 {
  let mut count = 0
  for i in 0..module_fact_decl_count(tt) {
    let declaration = module_fact_decl_at(tt, i)
    if docgen_decl_is_public_root(declaration, src) and docgen_has_comment(src, module_decl_fact_name_ptr(declaration) - src) { count = count + 1 } else { 0 }
  }
  count
}

pub(package) fn docgen_append_declaration(b: i64, tt: i64, src: i64, declaration: i64) -> i64 {
  let name_start = module_decl_fact_name_ptr(declaration) - src
  bstr(b, "## ")
  bstr(b, docgen_decl_kind(declaration))
  bstr(b, " `")
  bscopy(b, module_decl_fact_name_ptr(declaration), module_decl_fact_name_len(declaration), 0)
  bstr(b, "`\n\n")
  if docgen_append_comment(b, src, name_start) == 0 { bstr(b, "_Undocumented._\n") } else { 0 }
  bstr(b, "\n```weft\n")
  let rendered = docgen_append_decl_signature(b, tt, declaration)
  bstr(b, "\n```\n\n")
  rendered
}

pub(package) fn docgen_render_module(typed: TypedModule, path: str) -> str {
  match typed {
    TypedModule(fns, src, tt) -> {
      let b = buf_new(1024)
      bstr(b, "# API: `")
      bstr(b, path)
      bstr(b, "`\n\n_Generated from checked semantic facts. Do not edit._\n\n")
      bstr(b, "Public declarations: ")
      bstr(b, runtime_int_to_str(docgen_public_count(tt, src)))
      bstr(b, ". Documented: ")
      bstr(b, runtime_int_to_str(docgen_documented_count(tt, src)))
      bstr(b, ".\n\n")
      for i in 0..module_fact_decl_count(tt) {
        let declaration = module_fact_decl_at(tt, i)
        if docgen_decl_is_public_root(declaration, src) {
          docgen_append_declaration(b, tt, src, declaration)
        } else { 0 }
      }
      runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
    }
  }
}
