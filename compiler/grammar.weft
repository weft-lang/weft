-- compiler/grammar.weft — Grammar trait and WeftGrammar implementation
--
-- The Parseable trait is the extension point for embedded languages.
-- Weft's own syntax is defined as a Grammar module implementing Parseable.
-- SQL, HTML, GPU kernels, etc. would implement the same trait.
--
-- This is the "grammars are modules" principle from compiler-as-data:
-- the host compiler doesn't know Weft syntax — it just calls
-- grammar.parse(source) and grammar.check(ast) through the trait.

use "compiler/ir.weft"

-- ══════════════════════════════════════════════════════════════
-- The Grammar trait
-- ══════════════════════════════════════════════════════════════

trait Parseable {
  -- Parse source text into an AST. Pure — no effects needed.
  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -> i64
}

-- ══════════════════════════════════════════════════════════════
-- WeftGrammar: Weft's own syntax as a Grammar module
-- ══════════════════════════════════════════════════════════════

type WeftGrammar { WeftGrammar }

impl Parseable for WeftGrammar {
  -- Delegates to the existing parse_module in parse.weft
  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -> i64 {
    let toks = lex(source, source_len)
    parse_module(toks, source, tt)
  }
}

-- Create the default Weft grammar
fn weft_grammar() -> i64 { WeftGrammar }
