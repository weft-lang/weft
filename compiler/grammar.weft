-- compiler/grammar.weft — Grammar trait and WeftGrammar implementation
--
-- The Grammar trait is the extension point for embedded languages.
-- Weft's own syntax is defined as a Grammar module implementing Grammar.
-- SQL, HTML, GPU kernels, etc. would implement the same trait.
--
-- This is the "grammars are modules" principle from compiler-as-data:
-- the host compiler doesn't know Weft syntax — it calls grammar.lex and
-- grammar.parse through the trait.

use compiler/parse.{*}
use compiler/diagnose.{*}
use compiler/lex.{*}
use compiler/lib.{op_prec}
use compiler/syntax_grammar.{*}
use compiler/type_registry.{*}
use compiler/typecheck_effect.{*}

-- ══════════════════════════════════════════════════════════════
-- The Grammar trait
-- ══════════════════════════════════════════════════════════════

pub(package) trait Grammar {
  -- Lex source text into the compiler's token-list representation.
  fn lex(self: i64, source: i64, source_len: i64) -> i64

  -- Parse a token stream into an AST/function list.
  fn parse_tokens(self: i64, tokens: i64, source: i64, tt: i64) -[Diagnose]> i64

  -- Parse source text into an AST/function list, reporting recovery diagnostics.
  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -[Diagnose]> i64
}

pub(package) trait TypedGrammar {
  -- Check a parsed AST/function list. This is a separate trait until the
  -- language has trait inheritance (`TypedGrammar: Grammar`).
  fn check(self: i64, fns: i64, source: i64, tt: i64) -[TypeCheck, Diagnose]> i64
}

-- ══════════════════════════════════════════════════════════════
-- WeftGrammar: Weft's own syntax as a Grammar module
-- ══════════════════════════════════════════════════════════════

pub(package) type WeftGrammar { WeftGrammar }

impl Grammar for WeftGrammar {
  fn lex(self: i64, source: i64, source_len: i64) -> i64 {
    lex(source, source_len)
  }

  fn parse_tokens(self: i64, tokens: i64, source: i64, tt: i64) -[Diagnose]> i64 {
    parse_module_local(tokens, source, tt)
  }

  -- Delegates to the existing lex/parse_module front end.
  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -[Diagnose]> i64 {
    ttable_register_source(tt, source, source_len, 0, 0)
    let toks = lex(source, source_len)
    parse_module_local(toks, source, tt)
  }
}

-- ══════════════════════════════════════════════════════════════
-- Inspectable Weft concrete grammar
-- ══════════════════════════════════════════════════════════════
--
-- The executable parser above remains the authoritative recovery/checking
-- implementation.  This typed production graph is its concrete-syntax view
-- for parser generators.  Tree-sitter is one interpretation; consumers do
-- not parse compiler source or carry a handwritten grammar of their own.

fn sx_lit(value: str) -> SyntaxExpr { SyntaxLiteral(value) }
fn sx_pattern(value: str) -> SyntaxExpr { SyntaxPattern(value) }
fn sx_rust_pattern(value: str) -> SyntaxExpr { SyntaxRustPattern(value) }
fn sx_ref(name: str) -> SyntaxExpr { SyntaxReference(name) }
fn sx_field(name: str, value: SyntaxExpr) -> SyntaxExpr { SyntaxField(name, value) }
fn sx_optional(value: SyntaxExpr) -> SyntaxExpr { SyntaxOptional(value) }
fn sx_repeat(value: SyntaxExpr) -> SyntaxExpr { SyntaxRepeat(value) }
fn sx_repeat_one(value: SyntaxExpr) -> SyntaxExpr { SyntaxRepeatOne(value) }
fn sx_comma(value: SyntaxExpr) -> SyntaxExpr { SyntaxCommaSeparated(value) }
fn sx_comma_one(value: SyntaxExpr) -> SyntaxExpr { SyntaxCommaSeparatedOne(value) }

fn sx_seq2(a: SyntaxExpr, b: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs2(a, b))
}

fn sx_seq3(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs3(a, b, c))
}

fn sx_seq4(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs4(a, b, c, d))
}

fn sx_seq5(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs5(a, b, c, d, e))
}

fn sx_seq6(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs6(a, b, c, d, e, f))
}

fn sx_seq7(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs7(a, b, c, d, e, f, g))
}

fn sx_seq8(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr, h: SyntaxExpr) -> SyntaxExpr {
  SyntaxSequence(syntax_exprs8(a, b, c, d, e, f, g, h))
}

fn sx_choice2(a: SyntaxExpr, b: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs2(a, b))
}

fn sx_choice3(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs3(a, b, c))
}

fn sx_choice4(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs4(a, b, c, d))
}

fn sx_choice5(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs5(a, b, c, d, e))
}

fn sx_choice6(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs6(a, b, c, d, e, f))
}

fn sx_choice7(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs7(a, b, c, d, e, f, g))
}

fn sx_choice8(a: SyntaxExpr, b: SyntaxExpr, c: SyntaxExpr, d: SyntaxExpr, e: SyntaxExpr, f: SyntaxExpr, g: SyntaxExpr, h: SyntaxExpr) -> SyntaxExpr {
  SyntaxChoice(syntax_exprs8(a, b, c, d, e, f, g, h))
}

fn sx_rule(name: str, body: SyntaxExpr) -> SyntaxRule { SyntaxRule(name, body) }

pub(package) fn weft_syntax_binary_operators() -> SyntaxBinaryOperatorList {
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("..", 20),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("|>", 19),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("or", 13),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("and", 12),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("==", 5),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("!=", 6),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("<", 7),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator(">", 8),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("<=", 9),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator(">=", 10),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("bor", 15),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("bxor", 16),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("band", 14),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("bshl", 17),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("bshr", 18),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("+", 1),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("-", 2),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("*", 3),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("/", 4),
  SyntaxBinaryOperatorCons(SyntaxBinaryOperator("%", 11), SyntaxBinaryOperatorNil))))))))))))))))))))
}

fn weft_syntax_binary_expressions(operators: SyntaxBinaryOperatorList) -> SyntaxExprList {
  match operators {
    SyntaxBinaryOperatorNil -> SyntaxExprNil
    SyntaxBinaryOperatorCons(SyntaxBinaryOperator(spelling, op_id), rest) -> {
      SyntaxExprCons(
        SyntaxPrecedenceLeft(op_prec(op_id), sx_seq3(
          sx_field("left", sx_ref("_expression")),
          sx_field("operator", sx_lit(spelling)),
          sx_field("right", sx_ref("_expression"))
        )),
        weft_syntax_binary_expressions(rest)
      )
    }
  }
}

fn weft_syntax_declaration_rules() -> SyntaxRuleList {
  let declarations = SyntaxChoice(syntax_exprs8(
    sx_ref("use_declaration"), sx_ref("const_declaration"),
    sx_ref("function_declaration"), sx_ref("type_declaration"),
    sx_ref("trait_declaration"), sx_ref("impl_block"),
    sx_ref("effect_declaration"), sx_ref("test_declaration")
  ))
  let use_name = sx_choice3(sx_ref("identifier"), sx_ref("type_identifier"), sx_ref("constant_identifier"))
  let use_member = sx_seq2(
    sx_field("name", use_name),
    sx_optional(sx_seq2(sx_lit("as"), sx_field("alias", use_name)))
  )
  let first = syntax_rules8(
    sx_rule("source_file", sx_repeat(sx_choice2(sx_ref("_declaration"), sx_ref("stray_closing_brace")))),
    sx_rule("stray_closing_brace", sx_lit("}")),
    sx_rule("_declaration", declarations),
    sx_rule("visibility", sx_choice3(
      sx_lit("pub"), sx_seq4(sx_lit("pub"), sx_lit("("), sx_lit("package"), sx_lit(")")), sx_lit("private")
    )),
    sx_rule("use_declaration", sx_seq5(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("use"),
      sx_field("path", sx_choice2(sx_ref("string"), sx_ref("use_path"))),
      sx_optional(sx_seq2(sx_lit("as"), sx_field("alias", use_name))), sx_optional(sx_lit(";"))
    )),
    sx_rule("use_path", sx_seq3(
      sx_field("root", sx_ref("identifier")),
      sx_repeat(sx_seq2(sx_lit("/"), sx_field("segment", sx_ref("identifier")))),
      sx_optional(sx_seq2(sx_lit("."), sx_field("selections", sx_ref("use_selections"))))
    )),
    sx_rule("use_selections", sx_seq3(
      sx_lit("{"), sx_comma_one(sx_choice2(sx_lit("*"), use_member)), sx_lit("}")
    )),
    sx_rule("const_declaration", sx_seq8(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("const"),
      sx_field("name", sx_choice2(sx_ref("constant_identifier"), sx_ref("identifier"))), sx_lit(":"),
      sx_field("type", sx_ref("_type")), sx_lit("="), sx_field("value", sx_ref("_expression")), sx_optional(sx_lit(";"))
    ))
  )

  let functions_and_types = syntax_rules8(
    sx_rule("function_declaration", sx_seq8(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("fn"),
      sx_field("name", sx_ref("function_name")), sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))),
      sx_field("parameters", sx_ref("parameters")), sx_optional(sx_field("return_type", sx_ref("return_type"))),
      sx_optional(sx_field("where_clause", sx_ref("where_clause"))), sx_field("body", sx_ref("block"))
    )),
    sx_rule("function_signature", SyntaxSequence(syntax_exprs_concat(
      syntax_exprs8(
        sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_optional(sx_ref("deferred_attribute")),
        sx_lit("fn"), sx_field("name", sx_ref("function_name")),
        sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))), sx_field("parameters", sx_ref("parameters")),
        sx_field("return_type", sx_ref("return_type")), sx_optional(sx_field("where_clause", sx_ref("where_clause")))
      ),
      syntax_exprs1(sx_optional(sx_choice2(sx_lit(";"), sx_lit(","))))
    ))),
    sx_rule("deferred_attribute", sx_seq2(sx_lit("@"), sx_lit("deferred"))),
    sx_rule("type_declaration", sx_seq6(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("type"),
      sx_field("name", sx_ref("type_identifier")), sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))),
      sx_choice2(
        sx_seq3(sx_lit("{"), sx_optional(sx_field("body", sx_ref("type_body"))), sx_lit("}")),
        sx_seq2(sx_lit("="), sx_field("representation", sx_ref("opaque_type")))
      ),
      sx_optional(sx_lit(";"))
    )),
    sx_rule("type_body", sx_repeat_one(sx_seq2(
      sx_choice2(sx_ref("record_field"), sx_ref("variant")), sx_optional(sx_lit(","))
    ))),
    sx_rule("record_field", sx_seq4(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_field("name", sx_ref("identifier")),
      sx_lit(":"), sx_field("type", sx_ref("_type"))
    )),
    sx_rule("variant", sx_seq2(
      sx_field("name", sx_ref("type_identifier")), sx_optional(sx_field("payload", sx_ref("variant_payload")))
    )),
    sx_rule("variant_payload", sx_seq3(sx_lit("("), sx_comma_one(sx_ref("_type")), sx_lit(")")))
  )

  let nominal = syntax_rules_concat(syntax_rules8(
    sx_rule("opaque_type", sx_seq2(sx_lit("opaque"), sx_ref("_type"))),
    sx_rule("trait_declaration", SyntaxSequence(syntax_exprs_concat(
      syntax_exprs8(
        sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("trait"),
        sx_field("name", sx_ref("type_identifier")), sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))),
        sx_optional(sx_field("where_clause", sx_ref("where_clause"))), sx_lit("{"),
        sx_repeat(sx_choice2(sx_ref("function_signature"), sx_ref("associated_type_declaration"))), sx_lit("}")
      ), SyntaxExprNil
    ))),
    sx_rule("associated_type_declaration", SyntaxSequence(syntax_exprs6(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("type"),
      sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("bound", sx_ref("type_bound")))),
      sx_optional(sx_seq2(sx_lit("="), sx_field("type", sx_ref("_type")))),
      sx_optional(sx_lit(";"))
    ))),
    sx_rule("impl_block", SyntaxSequence(syntax_exprs7(
      sx_lit("impl"), sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))),
      sx_choice2(
        sx_seq3(sx_field("trait", sx_ref("_named_type")), sx_lit("for"), sx_field("type", sx_ref("_type"))),
        sx_field("type", sx_ref("_type"))
      ),
      sx_optional(sx_field("where_clause", sx_ref("where_clause"))), sx_lit("{"),
      sx_repeat(sx_choice2(sx_ref("function_declaration"), sx_ref("associated_type_declaration"))), sx_lit("}")
    ))),
    sx_rule("effect_declaration", sx_seq7(
      sx_optional(sx_field("visibility", sx_ref("visibility"))), sx_lit("effect"),
      sx_field("name", sx_ref("type_identifier")), sx_optional(sx_field("type_parameters", sx_ref("type_parameters"))),
      sx_lit("{"), sx_repeat(sx_ref("function_signature")), sx_lit("}")
    )),
    sx_rule("test_declaration", sx_seq3(
      sx_lit("test"), sx_field("name", sx_ref("string")), sx_field("body", sx_ref("block"))
    )),
    sx_rule("parameters", sx_seq3(sx_lit("("), sx_comma(sx_ref("parameter")), sx_lit(")"))),
    sx_rule("function_name", sx_choice3(sx_ref("identifier"), sx_ref("type_identifier"), sx_ref("constant_identifier")))
  ), syntax_rules1(
    sx_rule("parameter", sx_seq5(
      sx_optional(sx_seq2(sx_field("label", sx_ref("identifier")), sx_lit("with"))),
      sx_optional(sx_lit("_")), sx_optional(sx_lit("with")),
      sx_field("name", sx_choice2(sx_ref("identifier"), sx_lit("self"))),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("type", sx_ref("_type"))))
    ))
  ))

  let signatures = syntax_rules8(
    sx_rule("return_type", sx_choice2(
      sx_seq2(sx_lit("->"), sx_field("type", sx_ref("_type"))),
      sx_seq4(sx_lit("-["), sx_optional(sx_field("effects", sx_ref("effect_list"))), sx_lit("]>"), sx_field("type", sx_ref("_type")))
    )),
    sx_rule("effect_list", sx_comma_one(sx_choice2(sx_ref("effect_type"), sx_ref("effect_tail")))),
    sx_rule("effect_type", sx_seq3(
      sx_optional(sx_seq2(sx_field("module", sx_ref("identifier")), sx_lit("."))),
      sx_field("name", sx_ref("type_identifier")), sx_optional(sx_field("arguments", sx_ref("type_arguments")))
    )),
    sx_rule("effect_tail", sx_seq2(sx_lit(".."), sx_field("name", sx_choice2(sx_ref("identifier"), sx_ref("type_identifier"))))),
    sx_rule("type_parameters", sx_seq3(
      SyntaxTokenImmediate(sx_lit("<")), sx_comma_one(sx_ref("type_parameter")), sx_lit(">")
    )),
    sx_rule("type_arguments", sx_seq3(
      SyntaxTokenImmediate(sx_lit("<")), sx_comma_one(sx_ref("_type")), sx_lit(">")
    )),
    sx_rule("type_parameter", sx_seq2(
      sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("bound", sx_ref("type_bound"))))
    )),
    sx_rule("type_bound", sx_seq2(sx_ref("_type"), sx_repeat(sx_seq2(sx_lit("&"), sx_ref("_type")))))
  )

  let where_rules = syntax_rules2(
    sx_rule("where_clause", SyntaxPrecedenceRight(sx_seq2(sx_lit("where"), sx_comma_one(sx_ref("where_predicate"))))),
    sx_rule("where_predicate", sx_seq3(
      sx_field("type", sx_ref("_type")), sx_lit(":"), sx_field("bound", sx_ref("type_bound"))
    ))
  )

  syntax_rules_concat(first, syntax_rules_concat(functions_and_types,
    syntax_rules_concat(nominal, syntax_rules_concat(signatures, where_rules))))
}

fn weft_syntax_type_rules() -> SyntaxRuleList {
  let all_types = SyntaxChoice(syntax_exprs_concat(
    syntax_exprs8(
      sx_ref("primitive_type"), sx_ref("type_identifier"), sx_ref("constant_identifier"), sx_ref("self_type"),
      sx_ref("qualified_type"), sx_ref("generic_type"), sx_ref("union_type"), sx_ref("intersection_type")
    ),
    syntax_exprs_concat(
      syntax_exprs8(
        sx_ref("complement_type"), sx_ref("optional_type"), sx_ref("ownership_type"), sx_ref("pointer_type"),
        sx_ref("array_type"), sx_ref("slice_type"), sx_ref("structural_record_type"), sx_ref("function_type")
      ),
      syntax_exprs2(sx_ref("tuple_type"), sx_ref("parenthesized_type"))
    )
  ))
  let primitive_types = SyntaxChoice(syntax_exprs_concat(
    syntax_exprs8(
      sx_lit("i8"), sx_lit("i16"), sx_lit("i32"), sx_lit("i64"),
      sx_lit("isize"), sx_lit("u8"), sx_lit("u16"), sx_lit("u32")
    ),
    syntax_exprs_concat(
      syntax_exprs8(
        sx_lit("u64"), sx_lit("usize"), sx_lit("f32"), sx_lit("f64"),
        sx_lit("str"), sx_lit("bool"), sx_lit("nil"), sx_lit("never")
      ),
      syntax_exprs1(sx_lit("any"))
    )
  ))
  let first = syntax_rules8(
    sx_rule("_type", all_types),
    sx_rule("_named_type", sx_choice6(
      sx_ref("primitive_type"), sx_ref("type_identifier"), sx_ref("constant_identifier"),
      sx_ref("self_type"), sx_ref("qualified_type"), sx_ref("generic_type")
    )),
    sx_rule("primitive_type", primitive_types),
    sx_rule("self_type", sx_lit("Self")),
    sx_rule("qualified_type", SyntaxPrecedence(16, sx_seq4(
      sx_field("module", sx_choice2(sx_ref("identifier"), sx_ref("self_type"))), sx_lit("."), sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_field("arguments", sx_ref("type_arguments")))
    ))),
    sx_rule("generic_type", SyntaxPrecedence(15, sx_seq2(
      sx_field("name", sx_choice2(sx_ref("type_identifier"), sx_ref("identifier"))),
      sx_field("arguments", sx_ref("type_arguments"))
    ))),
    sx_rule("union_type", SyntaxPrecedenceLeft(1, sx_seq3(
      sx_field("left", sx_ref("_type")), sx_lit("|"), sx_field("right", sx_ref("_type"))
    ))),
    sx_rule("intersection_type", SyntaxPrecedenceLeft(2, sx_seq3(
      sx_field("left", sx_ref("_type")), sx_lit("&"), sx_field("right", sx_ref("_type"))
    )))
  )

  let compound = syntax_rules8(
    sx_rule("complement_type", SyntaxPrecedence(3, sx_seq2(sx_lit("~"), sx_field("type", sx_ref("_type"))))),
    sx_rule("optional_type", SyntaxPrecedenceLeft(4, sx_seq2(sx_field("type", sx_ref("_type")), sx_lit("?")))),
    sx_rule("ownership_type", SyntaxPrecedence(3, sx_seq3(
      sx_field("ownership", sx_choice7(
        sx_lit("rc"), sx_lit("arc"), sx_lit("weak"), sx_lit("unique"),
        sx_lit("Unique"), sx_lit("owned"), sx_lit("borrow")
      )),
      sx_optional(sx_lit("mut")), sx_field("type", sx_ref("_type"))
    ))),
    sx_rule("pointer_type", SyntaxPrecedence(3, sx_seq3(
      sx_lit("*"), sx_optional(sx_lit("mut")), sx_field("type", sx_ref("_type"))
    ))),
    sx_rule("array_type", sx_seq5(
      sx_lit("["), sx_field("element", sx_ref("_type")), sx_lit(";"),
      sx_field("length", sx_ref("integer")), sx_lit("]")
    )),
    sx_rule("slice_type", sx_seq4(
      sx_lit("["), sx_optional(sx_lit("mut")), sx_field("element", sx_ref("_type")), sx_lit("]")
    )),
    sx_rule("structural_record_type", sx_seq3(
      sx_lit("{"), sx_comma(sx_choice2(sx_ref("record_type_field"), sx_ref("open_record_marker"))), sx_lit("}")
    )),
    sx_rule("record_type_field", sx_seq3(
      sx_field("name", sx_ref("identifier")), sx_lit(":"), sx_field("type", sx_ref("_type"))
    ))
  )

  let final_rules = syntax_rules4(
    sx_rule("open_record_marker", sx_lit("..")),
    sx_rule("function_type", SyntaxPrecedenceRight(sx_seq2(
      sx_seq3(sx_lit("("), sx_comma(sx_ref("_type")), sx_lit(")")),
      sx_choice2(
        sx_seq2(sx_lit("->"), sx_field("return_type", sx_ref("_type"))),
        sx_seq4(
          sx_lit("-["), sx_optional(sx_field("effects", sx_ref("effect_list"))),
          sx_lit("]>"), sx_field("return_type", sx_ref("_type"))
        )
      )
    ))),
    sx_rule("tuple_type", sx_choice2(
      sx_seq2(sx_lit("("), sx_lit(")")),
      sx_seq5(sx_lit("("), sx_ref("_type"), sx_lit(","), sx_comma(sx_ref("_type")), sx_lit(")"))
    )),
    sx_rule("parenthesized_type", sx_seq3(sx_lit("("), sx_ref("_type"), sx_lit(")")))
  )

  syntax_rules_concat(first, syntax_rules_concat(compound, final_rules))
}

fn weft_syntax_expression_choices() -> SyntaxExpr {
  SyntaxChoice(syntax_exprs_concat(
    syntax_exprs8(
      sx_ref("identifier"), sx_ref("type_identifier"), sx_ref("constant_identifier"), sx_ref("self_expression"),
      sx_ref("integer"), sx_ref("float"), sx_ref("string"), sx_ref("boolean")
    ),
    syntax_exprs_concat(
      syntax_exprs8(
        sx_ref("nil_literal"), sx_ref("let_expression"), sx_ref("binary_expression"), sx_ref("unary_expression"),
        sx_ref("assignment_expression"), sx_ref("call_expression"), sx_ref("constructor_expression"), sx_ref("generic_value_expression")
      ),
      syntax_exprs_concat(
        syntax_exprs8(
          sx_ref("field_expression"), sx_ref("pointer_dereference"), sx_ref("index_expression"), sx_ref("slice_expression"),
          sx_ref("optional_chain_expression"), sx_ref("try_expression"), sx_ref("if_expression"), sx_ref("if_let_expression")
        ),
        syntax_exprs_concat(
          syntax_exprs8(
            sx_ref("match_expression"), sx_ref("while_expression"), sx_ref("for_expression"), sx_ref("loop_expression"),
            sx_ref("handle_expression"), sx_ref("resume_expression"), sx_ref("return_expression"), sx_ref("break_expression")
          ),
          syntax_exprs_concat(
            syntax_exprs8(
              sx_ref("continue_expression"), sx_ref("defer_expression"), sx_ref("lambda_expression"), sx_ref("array_expression"),
              sx_ref("record_expression"), sx_ref("anonymous_record_expression"), sx_ref("record_update_expression"), sx_ref("tuple_expression")
            ),
            syntax_exprs2(sx_ref("parenthesized_expression"), sx_ref("block"))
          )
        )
      )
    )
  ))
}

fn weft_syntax_expression_rules_first() -> SyntaxRuleList {
  syntax_rules8(
    sx_rule("block", sx_seq3(
      sx_lit("{"), sx_repeat(sx_choice2(sx_ref("_statement"), sx_lit(";"))), sx_lit("}")
    )),
    sx_rule("_statement", sx_ref("_expression")),
    sx_rule("_expression", weft_syntax_expression_choices()),
    sx_rule("let_expression", SyntaxPrecedenceRight(sx_seq5(
      sx_lit("let"), sx_optional(sx_lit("mut")), sx_field("pattern", sx_ref("_pattern")),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("type", sx_ref("_type")))),
      sx_seq2(sx_lit("="), sx_field("value", sx_ref("_expression")))
    ))),
    sx_rule("assignment_expression", SyntaxPrecedenceRightAt(1, sx_seq3(
      sx_field("left", sx_choice4(
        sx_ref("identifier"), sx_ref("field_expression"), sx_ref("index_expression"), sx_ref("pointer_dereference")
      )),
      sx_lit("="), sx_field("right", sx_ref("_expression"))
    ))),
    sx_rule("binary_expression", SyntaxChoice(weft_syntax_binary_expressions(weft_syntax_binary_operators()))),
    sx_rule("unary_expression", SyntaxPrecedence(13, sx_seq2(
      sx_field("operator", sx_choice4(
        sx_lit("not"), sx_lit("-"), sx_lit("&"), sx_seq2(sx_lit("&"), sx_lit("mut"))
      )),
      sx_field("operand", sx_ref("_expression"))
    ))),
    sx_rule("pointer_dereference", SyntaxPrecedenceLeft(16, sx_seq2(
      sx_field("pointer", sx_ref("_expression")), sx_lit(".*")
    )))
  )
}

fn weft_syntax_call_rules() -> SyntaxRuleList {
  let field_receivers = SyntaxChoice(syntax_exprs_concat(
    syntax_exprs8(
      sx_ref("identifier"), sx_ref("type_identifier"), sx_ref("constant_identifier"), sx_ref("self_expression"),
      sx_ref("integer"), sx_ref("float"), sx_ref("string"), sx_ref("boolean")
    ),
    syntax_exprs_concat(
      syntax_exprs8(
        sx_ref("nil_literal"), sx_ref("call_expression"), sx_ref("constructor_expression"), sx_ref("generic_value_expression"),
        sx_ref("field_expression"), sx_ref("index_expression"), sx_ref("slice_expression"), sx_ref("array_expression")
      ),
      syntax_exprs8(
        sx_ref("record_expression"), sx_ref("anonymous_record_expression"), sx_ref("record_update_expression"), sx_ref("tuple_expression"),
        sx_ref("parenthesized_expression"), sx_ref("try_expression"), sx_ref("optional_chain_expression"), sx_ref("block")
      )
    )
  ))
  syntax_rules8(
    sx_rule("call_expression", SyntaxPrecedence(15, sx_seq3(
      sx_field("function", sx_choice3(sx_ref("identifier"), sx_ref("field_expression"), sx_ref("parenthesized_expression"))),
      sx_optional(sx_field("type_arguments", sx_ref("value_type_arguments"))),
      sx_field("arguments", sx_ref("arguments"))
    ))),
    sx_rule("constructor_expression", SyntaxPrecedence(17, sx_seq3(
      sx_field("constructor", sx_choice3(
        sx_ref("type_identifier"), sx_ref("constant_identifier"),
        sx_seq3(sx_field("module", sx_ref("identifier")), sx_lit("."), sx_ref("type_identifier"))
      )),
      sx_optional(sx_field("type_arguments", sx_ref("value_type_arguments"))),
      sx_field("arguments", sx_ref("arguments"))
    ))),
    sx_rule("generic_value_expression", sx_choice2(
      SyntaxPrecedence(15, sx_seq2(
        sx_field("name", sx_choice2(sx_ref("type_identifier"), sx_ref("constant_identifier"))),
        sx_field("type_arguments", sx_ref("value_type_arguments"))
      )),
      SyntaxPrecedence(17, sx_seq2(
        sx_field("name", sx_seq3(
          sx_field("module", sx_ref("identifier")), sx_lit("."), sx_ref("type_identifier")
        )),
        sx_field("type_arguments", sx_ref("value_type_arguments"))
      ))
    )),
    sx_rule("value_type_arguments", sx_seq3(
      SyntaxTokenImmediate(sx_lit("<")), sx_comma_one(sx_choice2(sx_ref("_type"), sx_ref("integer"))), sx_lit(">")
    )),
    -- The compiler inserts a statement separator before a call opener on the
    -- next line. Canonical formatted calls have an adjacent opener.
    sx_rule("arguments", sx_seq3(
      SyntaxTokenImmediate(sx_lit("(")), sx_comma(sx_ref("argument")), sx_lit(")")
    )),
    sx_rule("argument", sx_seq2(
      sx_optional(sx_seq2(sx_field("label", sx_ref("identifier")), sx_lit(":"))),
      sx_field("value", sx_ref("_expression"))
    )),
    sx_rule("field_expression", SyntaxPrecedenceLeft(16, sx_seq3(
      sx_field("receiver", field_receivers), sx_lit("."),
      sx_field("field", sx_choice3(sx_ref("identifier"), sx_ref("type_identifier"), sx_ref("integer")))
    ))),
    sx_rule("index_expression", SyntaxPrecedenceLeft(14, sx_seq4(
      sx_field("value", sx_ref("_expression")), sx_lit("["), sx_field("index", sx_ref("_expression")), sx_lit("]")
    )))
  )
}

fn weft_syntax_postfix_rules() -> SyntaxRuleList {
  syntax_rules3(
    sx_rule("slice_expression", SyntaxPrecedenceLeft(14, sx_seq6(
      sx_field("value", sx_ref("_expression")), sx_lit("["),
      sx_optional(sx_field("start", sx_ref("_expression"))), sx_lit(".."),
      sx_optional(sx_field("end", sx_ref("_expression"))), sx_lit("]")
    ))),
    sx_rule("optional_chain_expression", SyntaxPrecedenceLeft(16, sx_seq3(
      sx_field("receiver", sx_ref("_expression")), sx_lit("?."), sx_field("field", sx_ref("identifier"))
    ))),
    sx_rule("try_expression", SyntaxPrecedenceLeft(14, sx_seq2(
      sx_field("expression", sx_ref("_expression")), sx_lit("?")
    )))
  )
}

fn weft_syntax_control_rules() -> SyntaxRuleList {
  let alternative = sx_optional(sx_seq2(
    sx_lit("else"), sx_field("alternative", sx_choice3(
      sx_ref("block"), sx_ref("if_expression"), sx_ref("if_let_expression")
    ))
  ))
  syntax_rules8(
    sx_rule("if_expression", SyntaxPrecedenceRight(sx_seq4(
      sx_lit("if"), sx_field("condition", sx_ref("_expression")),
      sx_field("consequence", sx_ref("block")), alternative
    ))),
    sx_rule("if_let_expression", SyntaxPrecedenceRight(sx_seq7(
      sx_lit("if"), sx_lit("let"), sx_field("pattern", sx_ref("_pattern")), sx_lit("="),
      sx_field("value", sx_ref("_expression")), sx_field("consequence", sx_ref("block")), alternative
    ))),
    sx_rule("match_expression", sx_seq5(
      sx_lit("match"), sx_field("value", sx_ref("_expression")), sx_lit("{"), sx_repeat(sx_ref("match_arm")), sx_lit("}")
    )),
    sx_rule("match_arm", sx_seq4(
      sx_field("pattern", sx_ref("_pattern")),
      sx_optional(sx_seq2(sx_lit("if"), sx_field("guard", sx_ref("_expression")))),
      sx_lit("->"), sx_seq2(sx_field("body", sx_ref("_expression")), sx_optional(sx_lit(",")))
    )),
    sx_rule("while_expression", sx_seq3(
      sx_lit("while"), sx_field("condition", sx_ref("_expression")), sx_field("body", sx_ref("block"))
    )),
    sx_rule("for_expression", sx_seq5(
      sx_lit("for"), sx_field("pattern", sx_ref("_pattern")), sx_lit("in"),
      sx_field("iterator", sx_ref("_expression")), sx_field("body", sx_ref("block"))
    )),
    sx_rule("loop_expression", sx_seq2(sx_lit("loop"), sx_field("body", sx_ref("block")))),
    sx_rule("handle_expression", sx_seq5(
      sx_lit("handle"), sx_field("expression", sx_ref("_expression")), sx_lit("{"),
      sx_repeat(sx_choice2(sx_ref("handler_clause"), sx_ref("handler_return_clause"))), sx_lit("}")
    ))
  )
}

fn weft_syntax_handler_rules() -> SyntaxRuleList {
  syntax_rules8(
    sx_rule("handler_clause", sx_seq7(
      sx_field("effect", sx_ref("effect_reference")), sx_lit("."),
      sx_field("operation", sx_ref("identifier")), sx_field("parameters", sx_ref("handler_parameters")),
      sx_optional(sx_seq2(sx_lit("with"), sx_field("continuation", sx_ref("identifier")))),
      sx_lit("->"), sx_field("body", sx_ref("_expression"))
    )),
    sx_rule("effect_reference", sx_seq3(
      sx_optional(sx_seq2(sx_field("module", sx_ref("identifier")), sx_lit("."))),
      sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_field("type_arguments", sx_ref("type_arguments")))
    )),
    sx_rule("handler_parameters", sx_seq3(
      sx_lit("("), sx_comma(sx_ref("handler_parameter")), sx_lit(")")
    )),
    sx_rule("handler_parameter", sx_seq2(
      sx_field("name", sx_choice2(sx_ref("identifier"), sx_lit("_"))),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("type", sx_ref("_type"))))
    )),
    sx_rule("handler_return_clause", sx_seq4(
      sx_lit("return"), sx_field("name", sx_ref("identifier")), sx_lit("->"), sx_field("body", sx_ref("_expression"))
    )),
    sx_rule("resume_expression", SyntaxPrecedenceRight(sx_seq2(
      sx_lit("resume"), sx_field("value", sx_ref("_expression"))
    ))),
    sx_rule("return_expression", SyntaxPrecedenceRight(sx_seq2(
      sx_lit("return"), sx_optional(sx_field("value", sx_ref("_expression")))
    ))),
    sx_rule("break_expression", SyntaxPrecedenceRight(sx_seq2(
      sx_lit("break"), sx_optional(sx_field("value", sx_ref("_expression")))
    )))
  )
}

fn weft_syntax_value_rules() -> SyntaxRuleList {
  let first = syntax_rules8(
    sx_rule("continue_expression", sx_lit("continue")),
    sx_rule("defer_expression", SyntaxPrecedenceRight(sx_seq2(
      sx_lit("defer"), sx_field("cleanup", sx_ref("_expression"))
    ))),
    sx_rule("lambda_expression", SyntaxPrecedenceRightAt(0 - 1, sx_seq3(
      sx_choice2(
        sx_field("parameter", sx_ref("identifier")),
        sx_seq3(sx_lit("("), sx_comma(sx_choice2(sx_ref("parameter"), sx_ref("identifier"))), sx_lit(")"))
      ),
      sx_lit("=>"), sx_field("body", sx_ref("_expression"))
    ))),
    sx_rule("array_expression", sx_seq3(sx_lit("["), sx_comma(sx_ref("_expression")), sx_lit("]"))),
    sx_rule("record_expression", sx_seq4(
      sx_field("base", sx_choice2(
        sx_ref("type_identifier"), sx_seq3(sx_field("module", sx_ref("identifier")), sx_lit("."), sx_ref("type_identifier"))
      )),
      sx_lit("{"), sx_comma(sx_ref("field_initializer")), sx_lit("}")
    )),
    sx_rule("anonymous_record_expression", sx_seq3(
      sx_lit("{"), sx_comma(sx_ref("field_initializer")), sx_lit("}")
    )),
    sx_rule("record_update_expression", SyntaxPrecedenceLeft(16, sx_seq4(
      sx_field("base", sx_ref("_expression")), sx_lit(".{"), sx_comma(sx_ref("field_initializer")), sx_lit("}")
    ))),
    sx_rule("field_initializer", sx_seq3(
      sx_field("name", sx_ref("identifier")), sx_lit(":"), sx_field("value", sx_ref("_expression"))
    ))
  )
  let final_rules = syntax_rules2(
    sx_rule("tuple_expression", sx_seq5(
      sx_lit("("), sx_ref("_expression"), sx_lit(","), sx_comma(sx_ref("_expression")), sx_lit(")")
    )),
    sx_rule("parenthesized_expression", sx_choice2(
      sx_seq2(sx_lit("("), sx_lit(")")),
      sx_seq3(sx_lit("("), sx_ref("_expression"), sx_lit(")"))
    ))
  )
  syntax_rules_concat(first, final_rules)
}

fn weft_syntax_expression_rules() -> SyntaxRuleList {
  syntax_rules_concat(weft_syntax_expression_rules_first(),
    syntax_rules_concat(weft_syntax_call_rules(),
      syntax_rules_concat(weft_syntax_postfix_rules(),
        syntax_rules_concat(weft_syntax_control_rules(),
          syntax_rules_concat(weft_syntax_handler_rules(), weft_syntax_value_rules())))))
}

fn weft_syntax_pattern_rules() -> SyntaxRuleList {
  let pattern_choices = SyntaxChoice(syntax_exprs_concat(
    syntax_exprs8(
      sx_ref("wildcard_pattern"), sx_ref("binding_pattern"), sx_ref("typed_pattern"), sx_ref("integer_pattern"),
      sx_ref("boolean_pattern"), sx_ref("nil_pattern"), sx_ref("constructor_pattern"), sx_ref("qualified_constructor_pattern")
    ),
    syntax_exprs3(sx_ref("record_pattern"), sx_ref("tuple_pattern"), sx_ref("parenthesized_pattern"))
  ))
  let first = syntax_rules8(
    sx_rule("_pattern", pattern_choices),
    sx_rule("wildcard_pattern", sx_lit("_")),
    sx_rule("binding_pattern", sx_ref("identifier")),
    sx_rule("typed_pattern", sx_seq3(
      sx_field("name", sx_ref("identifier")), sx_lit(":"), sx_field("type", sx_ref("_type"))
    )),
    sx_rule("integer_pattern", sx_ref("integer")),
    sx_rule("boolean_pattern", sx_ref("boolean")),
    sx_rule("nil_pattern", sx_lit("nil")),
    sx_rule("constructor_pattern", sx_seq2(
      sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_seq3(sx_lit("("), sx_comma(sx_ref("_pattern")), sx_lit(")")))
    ))
  )
  let remaining = syntax_rules5(
    sx_rule("qualified_constructor_pattern", sx_seq4(
      sx_field("module", sx_ref("identifier")), sx_lit("."), sx_field("name", sx_ref("type_identifier")),
      sx_optional(sx_seq3(sx_lit("("), sx_comma(sx_ref("_pattern")), sx_lit(")")))
    )),
    sx_rule("record_pattern", sx_seq3(sx_lit("{"), sx_comma(sx_ref("record_pattern_field")), sx_lit("}"))),
    sx_rule("record_pattern_field", sx_seq2(
      sx_field("name", sx_ref("identifier")),
      sx_optional(sx_seq2(sx_lit(":"), sx_field("pattern", sx_ref("_pattern"))))
    )),
    sx_rule("tuple_pattern", sx_choice2(
      sx_seq2(sx_lit("("), sx_lit(")")),
      sx_seq5(sx_lit("("), sx_ref("_pattern"), sx_lit(","), sx_comma(sx_ref("_pattern")), sx_lit(")"))
    )),
    sx_rule("parenthesized_pattern", sx_seq3(sx_lit("("), sx_ref("_pattern"), sx_lit(")")))
  )
  syntax_rules_concat(first, remaining)
}

fn weft_syntax_lexical_rules() -> SyntaxRuleList {
  syntax_rules8(
    sx_rule("integer", sx_pattern("[0-9]+")),
    sx_rule("float", sx_pattern("([0-9]+\\.[0-9]+|[0-9]+[eE][+-]?[0-9]+|[0-9]+\\.[0-9]+[eE][+-]?[0-9]+)")),
    sx_rule("string", SyntaxToken(sx_pattern("\"([^\"\\\\]|\\\\.)*\""))),
    sx_rule("boolean", sx_choice2(sx_lit("true"), sx_lit("false"))),
    sx_rule("nil_literal", sx_lit("nil")),
    sx_rule("self_expression", sx_lit("self")),
    sx_rule("identifier", sx_rust_pattern("(?:[a-z_]|[\\pL&&[^A-Z]])[\\pL\\pN\\pM_]*")),
    sx_rule("type_identifier", sx_pattern("[A-Z][a-zA-Z0-9_]*"))
  )
}

fn weft_syntax_lexical_rules_final() -> SyntaxRuleList {
  syntax_rules3(
    sx_rule("constant_identifier", SyntaxToken(
      sx_pattern("([A-Z][A-Z0-9]*_[A-Z0-9_]*|[A-Z][A-Z0-9]+)"))),
    sx_rule("doc_comment", SyntaxToken(SyntaxPrecedence(1, sx_pattern("---[^\\n]*")))),
    sx_rule("line_comment", SyntaxToken(sx_pattern("--[^\\n]*")))
  )
}

fn weft_syntax_conflicts() -> SyntaxConflictList {
  let first = syntax_conflicts4(
    syntax_exprs1(sx_ref("tuple_type")),
    syntax_exprs2(sx_ref("parameter"), sx_ref("_expression")),
    syntax_exprs2(sx_ref("binding_pattern"), sx_ref("typed_pattern")),
    syntax_exprs2(sx_ref("parameter"), sx_ref("lambda_expression"))
  )
  let second = syntax_conflicts_concat(
    syntax_conflicts2(
      syntax_exprs2(sx_ref("parameter"), sx_ref("self_expression")),
      syntax_exprs2(sx_ref("function_type"), sx_ref("parenthesized_type"))
    ),
    syntax_conflicts1(syntax_exprs2(sx_ref("function_type"), sx_ref("tuple_type")))
  )
  let third = syntax_conflicts2(
    syntax_exprs2(sx_ref("block"), sx_ref("anonymous_record_expression")),
    syntax_exprs2(sx_ref("_expression"), sx_ref("record_expression"))
  )
  syntax_conflicts_concat(first, syntax_conflicts_concat(second, third))
}

pub(package) fn weft_syntax_grammar() -> SyntaxGrammar {
  let rules = syntax_rules_concat(weft_syntax_declaration_rules(),
    syntax_rules_concat(weft_syntax_type_rules(),
      syntax_rules_concat(weft_syntax_expression_rules(),
        syntax_rules_concat(weft_syntax_pattern_rules(),
          syntax_rules_concat(weft_syntax_lexical_rules(), weft_syntax_lexical_rules_final())))))
  SyntaxGrammar(
    "weft",
    syntax_exprs3(sx_pattern("\\s"), sx_ref("line_comment"), sx_ref("doc_comment")),
    sx_ref("identifier"),
    syntax_exprs4(sx_ref("_declaration"), sx_ref("_expression"), sx_ref("_type"), sx_ref("_pattern")),
    weft_syntax_conflicts(),
    rules
  )
}

-- Create the default Weft grammar
pub(package) fn weft_grammar() -> WeftGrammar { WeftGrammar() }
