-- compiler/sdk_source.weft -- one diagnostic interpretation of SDK acquisition

use runtime/alloc.{alloc_words}
use runtime/buffer.{buf_new, bscopy, bstr, buf_ptr, buf_len}
use runtime/memory.{mem_store64_at}
use runtime/sdk_archive.{SdkArchiveError, SdkArchiveTruncated, SdkArchiveBadMagic, SdkArchiveUnsupportedVersion, SdkArchiveInvalidLayout, SdkArchiveInvalidEntry, SdkArchiveDigestMismatch, sdk_archive_version}
use runtime/source_acquire.{SdkSource, SdkSourcePresent, SdkSourceMissing, SdkSourceInvalidPath, SourceAcquire}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic/schema.{*}

pub(package) fn sdk_archive_diagnostic(error: SdkArchiveError) -> Diagnostic {
  let (reason, detail) = match error {
    SdkArchiveTruncated -> ("truncated", DiagnosticFieldNil)
    SdkArchiveBadMagic -> ("bad_magic", DiagnosticFieldNil)
    SdkArchiveUnsupportedVersion(version) -> ("unsupported_version", DiagnosticFieldCons(DiagnosticFieldI64("found_version", version), DiagnosticFieldNil))
    SdkArchiveInvalidLayout -> ("invalid_layout", DiagnosticFieldNil)
    SdkArchiveInvalidEntry(index) -> ("invalid_entry", DiagnosticFieldCons(DiagnosticFieldI64("entry_index", index), DiagnosticFieldNil))
    SdkArchiveDigestMismatch -> ("digest_mismatch", DiagnosticFieldNil)
  }
  Diagnostic(
    DiagnosticSeverityError, DiagnosticClassLink, DiagnosticCodeAssigned("E5015"),
    "the compiler's embedded SDK is damaged or incompatible; reinstall the matching compiler binary",
    DiagnosticLocationNone, DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(DiagnosticFieldText("reason", reason),
      DiagnosticFieldCons(DiagnosticFieldI64("archive_version", sdk_archive_version()), detail))
  )
}

pub(package) fn sdk_source_diagnostic(path: str, reason: str) -> Diagnostic {
  Diagnostic(
    DiagnosticSeverityError, DiagnosticClassLink, DiagnosticCodeAssigned("E5016"),
    "the selected SDK cannot supply this canonical path; check the import or reinstall the matching compiler",
    DiagnosticSourceRange(DiagnosticSourceNamed(path), 0, 0), DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(DiagnosticFieldText("path", path),
      DiagnosticFieldCons(DiagnosticFieldText("reason", reason), DiagnosticFieldNil))
  )
}

pub(package) fn sdk_manifest_diagnostic() -> Diagnostic {
  Diagnostic(
    DiagnosticSeverityError, DiagnosticClassLink, DiagnosticCodeAssigned("E5017"),
    "the selected SDK manifest is malformed or does not match this compiler's language version",
    DiagnosticSourceRange(DiagnosticSourceNamed("weft.pkg"), 0, 0), DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(DiagnosticFieldText("path", "weft.pkg"), DiagnosticFieldNil)
  )
}

-- The parser/native acquisition ABI still expects a two-word byte descriptor.
-- Interpret failure before crossing it; an empty source is a successful view.
pub(package) fn sdk_source_descriptor(source: SdkSource) -> i64 {
  let result = alloc_words(2)
  let (data, len) = match source {
    SdkSourcePresent(data, len) -> (data, len)
    SdkSourceMissing -> (0, 0)
    SdkSourceInvalidPath -> (0, 0)
  }
  mem_store64_at(result, 0, data)
  mem_store64_at(result, 8, len)
  result
}

pub(package) fn sdk_source_load_required(path: i64, path_len: i64) -[SourceAcquire, Diagnose]> i64 {
  let source = SourceAcquire.load_sdk(path, path_len)
  match source {
    SdkSourcePresent(data, len) -> 0
    SdkSourceMissing -> Diagnose.report(sdk_source_diagnostic(runtime_str_from_bytes_copy(path, path_len), "missing"))
    SdkSourceInvalidPath -> Diagnose.report(sdk_source_diagnostic(runtime_str_from_bytes_copy(path, path_len), "invalid_path"))
  }
  sdk_source_descriptor(source)
}

-- A resolved module identity has no source suffix and no filesystem root.
-- Physical spellings such as ./test/example.weft belong only to disk loading.
pub(package) fn sdk_source_load_module(logical_path: i64, logical_len: i64) -[SourceAcquire, Diagnose]> i64 {
  let path = buf_new(logical_len + 5)
  bscopy(path, logical_path, logical_len, 0)
  bstr(path, ".weft")
  sdk_source_load_required(buf_ptr(path), buf_len(path))
}
