-- Production compile-time evaluation over ordinary compiled Weft code.

use compiler/comptime/artifact.{ComptimeArtifactInputError, comptime_artifact_inputs}
use compiler/backend/link.{NativeArtifactCompileTimeInputs}
use runtime/file_read as platform_file_read
use stdlib/comptime as comptime
use stdlib/file.{FileRead}
use stdlib/result.{Result, Ok, Err}

-- A successfully evaluated value and the exact inputs that produced it.
-- Every value/input pair is representable, so this is an ordinary named type.
pub(package) type ComptimeBuildEvaluation<T> {
  value: T,
  inputs: NativeArtifactCompileTimeInputs
}

-- Run ordinary compiled Weft code under the narrow production FileRead
-- capability, observe each operation, and project successful observations to
-- artifact inputs. Any failed read prevents a successful build dependency set.
pub(package) fn comptime_evaluate_file_reads<T>(body: () -[FileRead]> T) -> Result<ComptimeBuildEvaluation<T>, ComptimeArtifactInputError> {
  let evaluation = with platform_file_read() {
    comptime.observe_file_reads(body)
  }
  match comptime_artifact_inputs(evaluation.file_observations) {
    Err(error) -> Err<ComptimeBuildEvaluation<T>, ComptimeArtifactInputError>(error)
    Ok(inputs) -> Ok<ComptimeBuildEvaluation<T>, ComptimeArtifactInputError>(ComptimeBuildEvaluation {
      value: evaluation.value,
      inputs: inputs
    })
  }
}
