-- Compiler projection from public compile-time observations to artifact facts.

use compiler/backend/link.{NativeArtifactCompileTimeInput, NativeArtifactCompileTimeInputs, NativeArtifactFacts, native_link_artifact_with_compile_time_inputs}
use compiler/package/source.{package_source_digest}
use stdlib/comptime.{ComptimeFileObservations}
use stdlib/io/types.{IoError}
use stdlib/list.{Nil, Cons}
use stdlib/path.{Path}
use stdlib/result.{Result, Ok, Err}

-- A failed file operation is retained as a typed build failure and never
-- projected into a successful artifact's dependency facts.
pub(package) type ComptimeArtifactInputError {
  ComptimeArtifactReadFailed(Path, IoError)
}

-- Translate successful observations without losing order or repeated reads.
-- The content digest identifies the exact bytes returned to the evaluator,
-- not a later reread of the path.
pub(package) fn comptime_artifact_inputs(observations: ComptimeFileObservations) -> Result<NativeArtifactCompileTimeInputs, ComptimeArtifactInputError> {
  match observations {
    Nil -> Ok<NativeArtifactCompileTimeInputs, ComptimeArtifactInputError>(Nil<NativeArtifactCompileTimeInput>())
    Cons(observation, rest) -> {
      let path = observation.path
      let limit = observation.limit
      match observation.outcome {
        Err(error) -> Err<NativeArtifactCompileTimeInputs, ComptimeArtifactInputError>(ComptimeArtifactReadFailed(path, error))
        Ok(content) -> match comptime_artifact_inputs(rest) {
          Err(error) -> Err<NativeArtifactCompileTimeInputs, ComptimeArtifactInputError>(error)
          Ok(inputs) -> Ok<NativeArtifactCompileTimeInputs, ComptimeArtifactInputError>(Cons(
            NativeArtifactCompileTimeInput {
              path: path,
              limit: limit,
              size: content.len(),
              content: package_source_digest(content)
            },
            inputs
          ))
        }
      }
    }
  }
}

-- Attach observed compile-time inputs to an otherwise complete native product.
pub(package) fn comptime_artifact_facts(facts: NativeArtifactFacts, observations: ComptimeFileObservations) -> Result<NativeArtifactFacts, ComptimeArtifactInputError> {
  match comptime_artifact_inputs(observations) {
    Err(error) -> Err<NativeArtifactFacts, ComptimeArtifactInputError>(error)
    Ok(inputs) -> Ok<NativeArtifactFacts, ComptimeArtifactInputError>(native_link_artifact_with_compile_time_inputs(facts, inputs))
  }
}
