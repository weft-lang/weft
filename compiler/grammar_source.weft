-- Retained source parsing with a private bridge to current compiler storage.

use stdlib/grammar.{Grammar, ParseResult, Parsed, Recovered, Rejected}
use stdlib/source.{Source, Span}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/schema.{*}
use stdlib/state as state
use stdlib/state.{State}
use stdlib/num
use stdlib/result.{Result}
use compiler/lex.{lex_range}
use compiler/parse.{parse_module_syntax_local, parse_first_source_error}
use compiler/declaration_syntax.{ParsedModuleSyntax}
use compiler/type_registry.{ttable_register_source}
use compiler/diagnostic_location.{diagnostic_location_from_offsets}

-- The table is supplied by the host session; parsing never loads a source.
pub(package) type WeftParser { table: i64 }

-- Current checker/token storage stays private. The retained source backs every
-- name range in the structured declarations and every formatter token.
pub(package) type ParsedWeftSource {
  source: Span,
  declarations: ParsedModuleSyntax,
  tokens: i64
}

pub(package) fn grammar_source_location(source: Source, location: DiagnosticLocation) -> DiagnosticLocation {
  match location {
    DiagnosticSourceRange(DiagnosticSourceBuffer(buffer), start, end) ->
      if buffer == __str_ptr(source.text) { DiagnosticSourceRange(source.identity, start, end) }
      else { location }
    other -> other
  }
}

fn report_legacy(source: Source, severity: DiagnosticSeverity, message: str, position: i64) -[Diagnose]> i64 {
  let buffer = __str_ptr(source.text)
  let relative = if position >= buffer { position - buffer } else { position }
  let limit = __str_len(source.text)
  let location = if relative < 0 or relative > limit { DiagnosticLocationNone }
    else { diagnostic_location_from_offsets(source.identity, relative, if relative < limit { relative + 1 } else { relative }) }
  Diagnose.report(uncoded(severity, DiagnosticClassParse, message, location))
}

impl Grammar for WeftParser {
  type Syntax = ParsedWeftSource

  fn parse(self, span: Span) -[Diagnose]> ParseResult<ParsedWeftSource> {
    let source = span.source()
    let start = span.start().to_u64().to_i64_checked().unwrap()
    let length = span.len().to_u64().to_i64_checked().unwrap()
    let buffer = __str_ptr(source.text)
    ttable_register_source(self.table, buffer, __str_len(source.text), 0, 0)
    let tokens = lex_range(buffer, start, length)
    let invalid_source = parse_first_source_error(tokens) >= 0
    let (declarations, failed) = state.run(false, () => handle parse_module_syntax_local(tokens, buffer, self.table) {
      Diagnose.report(diagnostic) -> {
        match diagnostic.severity() {
          DiagnosticSeverityError -> State.put(true)
          _ -> nil
        }
        Diagnose.report(diagnostic.map_locations((location: DiagnosticLocation) => grammar_source_location(source, location)))
        resume(0)
      }
      Diagnose.error(message, position) -> {
        State.put(true)
        report_legacy(source, DiagnosticSeverityError, message, position)
        resume(0)
      }
      Diagnose.warn(message, position) -> {
        report_legacy(source, DiagnosticSeverityWarning, message, position)
        resume(0)
      }
      Diagnose.note(message, position) -> {
        report_legacy(source, DiagnosticSeverityNote, message, position)
        resume(0)
      }
    })
    if invalid_source { Rejected<ParsedWeftSource>() }
    else {
      let syntax = ParsedWeftSource { source: span, declarations: declarations, tokens: tokens }
      if failed { Recovered(syntax) } else { Parsed(syntax) }
    }
  }
}
