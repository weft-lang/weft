-- compiler/diagnose.weft -- compiler diagnostic renderer

use compiler/lib.{*}
use stdlib/diagnostic.{*}

pub(package) fn diagnostic_render_primary(primary: DiagnosticLocation) -> i64 {
  match primary {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(src) -> if start >= 0 { eprint_span(src, start) } else { 0 }
        DiagnosticSourceNamed(name) -> { eprint(name) eprint(": ") }
      }
    }
  }
}

-- Baseline human renderer for the stable envelope. Rich source rails and
-- suggestions grow here; producers never pre-render those facts into message.
pub(package) fn diagnostic_render(diagnostic: Diagnostic) -> i64 {
  let severity = diagnostic_severity(diagnostic)
  let code = diagnostic_code(diagnostic)
  diagnostic_render_primary(diagnostic_primary(diagnostic))
  eprint(diagnostic_severity_name(severity))
  if diagnostic_code_is_assigned(code) {
    eprint("[")
    eprint(diagnostic_code_text(code))
    eprint("]")
  } else { 0 }
  eprint(": ")
  eprint(diagnostic_message(diagnostic))
  eprint("\n")
}

pub(package) fn diagnose_max_render_span() -> i64 { 16777216 }

pub(package) fn diagnose_normalize_span(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    if span >= src {
      let offset = span - src
      if offset >= 0 and offset < diagnose_max_render_span() { offset } else { 0 - 1 }
    } else {
      if span < diagnose_max_render_span() { span } else { 0 - 1 }
    }
  }
}

pub(package) fn diagnose_render(src: i64, msg: str, span: i64) -> i64 {
  let offset = diagnose_normalize_span(src, span)
  if offset >= 0 { eprint_span(src, offset) } else { 0 }
  eprint(msg)
  eprint("\n")
}
