-- compiler/diagnose.weft -- compiler diagnostic effect surface

use "compiler/lib.weft"

-- L8's stable diagnostic envelope. Severity and class are values rather than
-- integer conventions so every handler sees the same meaning. The Other arm
-- keeps category consumers union-extensible while named classes remain
-- available for filtering and code-registry partitioning.
type DiagnosticSeverity {
  DiagnosticSeverityError
  DiagnosticSeverityWarning
  DiagnosticSeverityNote
}

type DiagnosticClass {
  DiagnosticClassParse
  DiagnosticClassType
  DiagnosticClassEffect
  DiagnosticClassOwnership
  DiagnosticClassModule
  DiagnosticClassLink
  DiagnosticClassGrammar
  DiagnosticClassTool
  DiagnosticClassRuntime
  DiagnosticClassTest
  DiagnosticClassOther(str)
}

-- An unassigned code is an explicit migration state, never an empty-string
-- convention. Once a DiagnosticCodeAssigned value ships through the registry,
-- kernel §13.7 makes that spelling stable API.
type DiagnosticCode {
  DiagnosticCodeUnassigned
  DiagnosticCodeAssigned(str)
}

-- SourceBuffer is an in-process identity. Renderers must resolve it through
-- their source registry before exposing a path/URI; it is never serialized as
-- a pointer. SourceNamed covers runtime/test events that already own a stable
-- file label. Ranges are byte offsets with an exclusive end.
type DiagnosticSource {
  DiagnosticSourceUnknown
  DiagnosticSourceBuffer(i64)
  DiagnosticSourceNamed(str)
}

type DiagnosticLocation {
  DiagnosticLocationNone
  DiagnosticSourceRange(DiagnosticSource, i64, i64)
}

type DiagnosticRelatedLocation {
  DiagnosticRelatedLocation(str, DiagnosticLocation)
}

type DiagnosticRelatedLocationList {
  DiagnosticRelatedLocationNil
  DiagnosticRelatedLocationCons(DiagnosticRelatedLocation, DiagnosticRelatedLocationList)
}

-- Machine-actionable payload fields are deliberately a small open value
-- algebra. Consumers must keep an `other` arm when matching this type; later
-- teaching payloads can add variants without changing the envelope.
type DiagnosticField {
  DiagnosticFieldText(str, str)
  DiagnosticFieldI64(str, i64)
  DiagnosticFieldBool(str, bool)
  DiagnosticFieldLocation(str, DiagnosticLocation)
}

type DiagnosticFieldList {
  DiagnosticFieldNil
  DiagnosticFieldCons(DiagnosticField, DiagnosticFieldList)
}

type Diagnostic {
  Diagnostic(
    DiagnosticSeverity,
    DiagnosticClass,
    DiagnosticCode,
    str,
    DiagnosticLocation,
    DiagnosticRelatedLocationList,
    DiagnosticFieldList
  )
}

effect Diagnose {
  -- Canonical structured operation. The legacy operations remain during the
  -- producer migration; new consumers and 6b failure events use report.
  fn report(diagnostic: Diagnostic) -> i64
  fn error(msg: str, span: i64) -> i64
  fn warn(msg: str, span: i64) -> i64
  fn note(msg: str, span: i64) -> i64
}

fn diagnostic_schema_version() -> i64 { 1 }

fn diagnostic_related_empty() -> DiagnosticRelatedLocationList {
  DiagnosticRelatedLocationNil
}

fn diagnostic_fields_empty() -> DiagnosticFieldList {
  DiagnosticFieldNil
}

fn diagnostic_new(
  severity: DiagnosticSeverity,
  class: DiagnosticClass,
  code: DiagnosticCode,
  message: str,
  primary: DiagnosticLocation,
  related: DiagnosticRelatedLocationList,
  fields: DiagnosticFieldList
) -> Diagnostic {
  Diagnostic(severity, class, code, message, primary, related, fields)
}

fn diagnostic_uncoded(
  severity: DiagnosticSeverity,
  class: DiagnosticClass,
  message: str,
  primary: DiagnosticLocation
) -> Diagnostic {
  diagnostic_new(
    severity,
    class,
    DiagnosticCodeUnassigned,
    message,
    primary,
    diagnostic_related_empty(),
    diagnostic_fields_empty()
  )
}

fn diagnostic_report(diagnostic: Diagnostic) -[Diagnose]> i64 {
  Diagnose.report(diagnostic)
}

fn diagnostic_severity(diagnostic: Diagnostic) -> DiagnosticSeverity {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> severity
  }
}

fn diagnostic_class(diagnostic: Diagnostic) -> DiagnosticClass {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> class
  }
}

fn diagnostic_code(diagnostic: Diagnostic) -> DiagnosticCode {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> code
  }
}

fn diagnostic_message(diagnostic: Diagnostic) -> str {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> message
  }
}

fn diagnostic_primary(diagnostic: Diagnostic) -> DiagnosticLocation {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> primary
  }
}

fn diagnostic_related(diagnostic: Diagnostic) -> DiagnosticRelatedLocationList {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> related
  }
}

fn diagnostic_fields(diagnostic: Diagnostic) -> DiagnosticFieldList {
  match diagnostic {
    Diagnostic(severity, class, code, message, primary, related, fields) -> fields
  }
}

fn diagnostic_severity_name(severity: DiagnosticSeverity) -> str {
  match severity {
    DiagnosticSeverityError -> "error"
    DiagnosticSeverityWarning -> "warning"
    DiagnosticSeverityNote -> "note"
  }
}

fn diagnostic_class_name(class: DiagnosticClass) -> str {
  match class {
    DiagnosticClassParse -> "parse"
    DiagnosticClassType -> "type"
    DiagnosticClassEffect -> "effect"
    DiagnosticClassOwnership -> "ownership"
    DiagnosticClassModule -> "module"
    DiagnosticClassLink -> "link"
    DiagnosticClassGrammar -> "grammar"
    DiagnosticClassTool -> "tool"
    DiagnosticClassRuntime -> "runtime"
    DiagnosticClassTest -> "test"
    DiagnosticClassOther(name) -> name
  }
}

fn diagnostic_code_is_assigned(code: DiagnosticCode) -> bool {
  match code {
    DiagnosticCodeUnassigned -> false
    DiagnosticCodeAssigned(value) -> true
  }
}

fn diagnostic_code_text(code: DiagnosticCode) -> str {
  match code {
    DiagnosticCodeUnassigned -> ""
    DiagnosticCodeAssigned(value) -> value
  }
}

fn diagnostic_location_source(location: DiagnosticLocation) -> DiagnosticSource {
  match location {
    DiagnosticLocationNone -> DiagnosticSourceUnknown
    DiagnosticSourceRange(source, start, end) -> source
  }
}

fn diagnostic_location_start(location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> start
  }
}

fn diagnostic_location_end(location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> end
  }
}

fn diagnostic_related_count(related: DiagnosticRelatedLocationList) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(item, rest) -> 1 + diagnostic_related_count(rest)
  }
}

fn diagnostic_field_count(fields: DiagnosticFieldList) -> i64 {
  match fields {
    DiagnosticFieldNil -> 0
    DiagnosticFieldCons(field, rest) -> 1 + diagnostic_field_count(rest)
  }
}

fn diagnostic_severity_tag(severity: DiagnosticSeverity) -> i64 {
  match severity {
    DiagnosticSeverityError -> 1
    DiagnosticSeverityWarning -> 2
    DiagnosticSeverityNote -> 3
  }
}

fn diagnostic_render_primary(primary: DiagnosticLocation) -> i64 {
  match primary {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(src) -> if start >= 0 { eprint_span(src, start) } else { 0 }
        DiagnosticSourceNamed(name) -> { eprint(name) eprint(": ") }
      }
    }
  }
}

-- Baseline human renderer for the stable envelope. Rich source rails and
-- suggestions grow here; producers never pre-render those facts into message.
fn diagnostic_render(diagnostic: Diagnostic) -> i64 {
  let severity = diagnostic_severity(diagnostic)
  let code = diagnostic_code(diagnostic)
  diagnostic_render_primary(diagnostic_primary(diagnostic))
  eprint(diagnostic_severity_name(severity))
  if diagnostic_code_is_assigned(code) {
    eprint("[")
    eprint(diagnostic_code_text(code))
    eprint("]")
  } else { 0 }
  eprint(": ")
  eprint(diagnostic_message(diagnostic))
  eprint("\n")
}

fn diagnose_max_render_span() -> i64 { 16777216 }

fn diagnose_normalize_span(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    if span >= src {
      let offset = span - src
      if offset >= 0 and offset < diagnose_max_render_span() { offset } else { 0 - 1 }
    } else {
      if span < diagnose_max_render_span() { span } else { 0 - 1 }
    }
  }
}

fn diagnose_render(src: i64, msg: str, span: i64) -> i64 {
  let offset = diagnose_normalize_span(src, span)
  if offset >= 0 { eprint_span(src, offset) } else { 0 }
  eprint(msg)
  eprint("\n")
}
