-- compiler/diagnose.weft -- compiler diagnostic effect surface

use "compiler/lib.weft"

effect Diagnose {
  fn error(msg: str, span: i64) -> i64
  fn warn(msg: str, span: i64) -> i64
  fn note(msg: str, span: i64) -> i64
}

fn diagnose_max_render_span() -> i64 { 16777216 }

fn diagnose_normalize_span(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    if span >= src {
      let offset = span - src
      if offset >= 0 and offset < diagnose_max_render_span() { offset } else { 0 - 1 }
    } else {
      if span < diagnose_max_render_span() { span } else { 0 - 1 }
    }
  }
}

fn diagnose_render(src: i64, msg: str, span: i64) -> i64 {
  let offset = diagnose_normalize_span(src, span)
  if offset >= 0 { eprint_span(src, offset) } else { 0 }
  eprint(msg)
  eprint("\n")
}
