-- compiler/diagnose.weft -- compiler diagnostic renderer

use compiler/lib.{*}
use compiler/diagnostic_frame.{*}
use compiler/diagnostic_style.{*}
use stdlib/diagnostic.{*}

pub(package) fn diagnostic_render_primary(primary: DiagnosticLocation) -> i64 {
  match primary {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(src) -> if start >= 0 { eprint_span(src, start) } else { 0 }
        DiagnosticSourceNamed(name) -> { eprint(name) eprint(": ") }
      }
    }
  }
}

pub(package) fn diagnostic_render_heading(diagnostic: Diagnostic) -> i64 {
  diagnostic_render_heading_styled(diagnostic, 0)
}

pub(package) fn diagnostic_render_heading_styled(diagnostic: Diagnostic, style: i64) -> i64 {
  let severity = diagnostic_severity(diagnostic)
  let code = diagnostic_code(diagnostic)
  diagnostic_style_start(style)
  eprint(diagnostic_severity_name(severity))
  if diagnostic_code_is_assigned(code) {
    eprint("[")
    eprint(diagnostic_code_text(code))
    eprint("]")
  } else { 0 }
  diagnostic_style_reset(style)
  eprint(": ")
  eprint(diagnostic_message(diagnostic))
  eprint("\n")
}

-- Teaching prose consumes structured producer facts. Renderers never perform
-- semantic lookup or recover facts from message text.
pub(package) fn diagnostic_render_help(diagnostic: Diagnostic) -> i64 {
  let suggestion = diagnostic_render_text_field(diagnostic_fields(diagnostic), "suggestion")
  if __str_len(suggestion) > 0 {
    eprint("help: did you mean '")
    eprint(suggestion)
    eprint("'?\n")
  } else { 0 }
  let relationship = diagnostic_render_text_field(diagnostic_fields(diagnostic), "relationship")
  let reason = diagnostic_render_text_field(diagnostic_fields(diagnostic), "reason")
  let mut taught = false
  if diagnostic_render_text_eq(reason, "uncovered_value") == 1 {
    let witness = diagnostic_render_text_field(diagnostic_fields(diagnostic), "witness")
    let pattern = diagnostic_render_text_field(diagnostic_fields(diagnostic), "suggested_pattern")
    eprint("help: add an arm matching `")
    eprint(pattern)
    eprint("`; the uncovered witness is `")
    eprint(witness)
    eprint("`.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "integer_literal_range") == 1 {
    let expected_min = diagnostic_render_text_field(diagnostic_fields(diagnostic), "expected_min")
    let expected_max = diagnostic_render_text_field(diagnostic_fields(diagnostic), "expected_max")
    eprint("help: this integer type accepts values from ")
    eprint(expected_min)
    eprint(" through ")
    eprint(expected_max)
    eprint("; choose a fitting value or a wider integer type.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "missing_carried_bound") == 1 {
    let target = diagnostic_render_text_field(diagnostic_fields(diagnostic), "target_type_text")
    let required = diagnostic_render_text_field(diagnostic_fields(diagnostic), "required_trait_text")
    eprint("help: add `") eprint(target) eprint(": ") eprint(required)
    eprint("` to the enclosing generic signature; required bounds must be carried explicitly.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "different_trait_declaration") == 1 {
    let required = diagnostic_render_text_field(diagnostic_fields(diagnostic), "required_trait_text")
    let nearby = diagnostic_render_text_field(diagnostic_fields(diagnostic), "nearby_trait_text")
    eprint("help: this type implements `") eprint(nearby) eprint("`, but the bound requires `") eprint(required)
    eprint("`; same short names never merge across modules.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "conditional_impl_bound_failed") == 1 {
    let candidate = diagnostic_render_text_field(diagnostic_fields(diagnostic), "candidate_target_text")
    let nested_type = diagnostic_render_text_field(diagnostic_fields(diagnostic), "unsatisfied_nested_type_text")
    let nested_trait = diagnostic_render_text_field(diagnostic_fields(diagnostic), "unsatisfied_nested_trait_text")
    eprint("help: a matching `") eprint(candidate) eprint("` impl candidate exists, but it requires `")
    eprint(nested_type) eprint(": ") eprint(nested_trait) eprint("`; satisfy that nested bound or use another type.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "sealed_structural_requirement") == 1 {
    let detail = diagnostic_render_text_field(diagnostic_fields(diagnostic), "sendability_reason")
    eprint("help: `Sendable` is a sealed structural proof, not a user-written impl; ") eprint(detail) eprint(".\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "missing_delimiter") == 1 {
    let expected = diagnostic_render_text_field(diagnostic_fields(diagnostic), "expectation")
    let context = diagnostic_render_text_field(diagnostic_fields(diagnostic), "context")
    eprint("help: insert `") eprint(expected) eprint("` to close this ") eprint(context) eprint(".") eprint("\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "missing_impl") == 1 {
    let context = diagnostic_render_text_field(diagnostic_fields(diagnostic), "context")
    let target = diagnostic_render_text_field(diagnostic_fields(diagnostic), "target_type_text")
    let required = diagnostic_render_text_field(diagnostic_fields(diagnostic), "required_trait_text")
    let placement = diagnostic_render_text_field(diagnostic_fields(diagnostic), "impl_placement")
    if diagnostic_render_text_eq(context, "ordering operand") == 1 {
      eprint("help: ordering is trait dispatch; implement `") eprint(required)
      eprint("` with `compare(self, Self) -> i64`, or compare a supported type.\n")
    } else { if diagnostic_render_text_eq(context, "associated type binding") == 1 {
      eprint("help: this associated type binding must implement `") eprint(required)
      eprint("`; choose a conforming type or add a legal impl.\n")
    } else { if diagnostic_render_bool_field(diagnostic_fields(diagnostic), "impl_allowed_here") {
      eprint("help: define `impl ") eprint(required) eprint(" for ") eprint(target)
      eprint("` in this module, or pass a type that already implements the trait.\n")
    } else { if diagnostic_render_text_eq(placement, "trait_defining_module_only") == 1 {
      eprint("help: `") eprint(target) eprint("` is primitive, so only the module defining `") eprint(required)
      eprint("` may add the impl; otherwise pass a conforming type.\n")
    } else {
      eprint("help: this module owns neither `") eprint(target) eprint("` nor `") eprint(required)
      eprint("`; add the impl to a defining module or pass a conforming type.\n")
    } } } }
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "pure_context") == 1 {
    let missing = diagnostic_render_text_field(diagnostic_fields(diagnostic), "missing_effects_text")
    eprint("help: this context is declared pure with `->`; add `-[")
    eprint(missing)
    eprint("]>` to the enclosing signature or handle the effect here.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "different_instantiation") == 1 {
    let missing = diagnostic_render_text_field(diagnostic_fields(diagnostic), "missing_effects_text")
    let nearby = diagnostic_render_text_field(diagnostic_fields(diagnostic), "nearby_effect_text")
    eprint("help: `")
    eprint(nearby)
    eprint("` is available, but it does not discharge `")
    eprint(missing)
    eprint("`; effect type arguments are part of capability identity.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "different_effect_declaration") == 1 {
    let missing = diagnostic_render_text_field(diagnostic_fields(diagnostic), "missing_effects_text")
    let nearby = diagnostic_render_text_field(diagnostic_fields(diagnostic), "nearby_effect_text")
    eprint("help: `")
    eprint(nearby)
    eprint("` is available, but `")
    eprint(missing)
    eprint("` is a different effect declaration; same short names never merge across modules.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "open_effect_tail") == 1 {
    let missing = diagnostic_render_text_field(diagnostic_fields(diagnostic), "missing_effects_text")
    eprint("help: the callee's open effect tail `")
    eprint(missing)
    eprint("` cannot be charged to this closed signature; make the enclosing signature polymorphic or handle the effects before this call.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "missing_effect") == 1 {
    let missing = diagnostic_render_text_field(diagnostic_fields(diagnostic), "missing_effects_text")
    eprint("help: add `-[")
    eprint(missing)
    eprint("]>` to the enclosing signature or handle the effect here.\n")
    taught = true
  } else { 0 }
  if not taught and diagnostic_render_text_eq(reason, "non_callable") == 1 {
    let expected = diagnostic_render_text_field(diagnostic_fields(diagnostic), "expected")
    let found = diagnostic_render_text_field(diagnostic_fields(diagnostic), "found")
    eprint("help: remove the call parentheses to use this `")
    eprint(found)
    eprint("` value, or replace it with a function of type `")
    eprint(expected)
    eprint("`.\n")
    taught = true
  } else { 0 }
  if not taught and __str_len(relationship) == 29 and src_eq(__str_ptr(relationship), 0, __str_len(relationship), "found_not_subtype_of_expected") == 1 {
    if diagnostic_render_text_eq(reason, "possibly_nil") == 1 {
      eprint("help: this value may be nil; narrow it with match or if let, or handle nil before using it here.\n")
    } else { if diagnostic_render_text_eq(reason, "array_length") == 1 {
      eprint("help: a fixed array's length is part of its type; construct or convert to the expected length.\n")
    } else { if diagnostic_render_text_eq(reason, "mutable_slice_contract") == 1 {
      eprint("help: a mutable slice needs an exclusive mutable view with the same element type.\n")
    } else { if diagnostic_render_text_eq(reason, "nominal_type_arguments") == 1 {
      eprint("help: generic arguments are part of nominal type identity; convert the value or generalise the surrounding contract.\n")
    } else { if diagnostic_render_text_eq(reason, "structural_shape") == 1 {
      eprint("help: record and tuple compatibility is checked field by field; compare the expected and found shapes.\n")
    } else {
      eprint("help: Weft accepts a value here when its type is a subtype of the expected type.\n")
    } } } } }
  } else { 0 }
}

pub(package) fn diagnostic_render_body(diagnostic: Diagnostic) -> i64 {
  diagnostic_render_heading(diagnostic)
  diagnostic_render_related(diagnostic_related(diagnostic))
  diagnostic_render_help(diagnostic)
}

pub(package) fn diagnostic_render_related_location(label: str, location: DiagnosticLocation) -> i64 {
  match location {
    DiagnosticLocationNone -> 0
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceUnknown -> 0
        DiagnosticSourceBuffer(src) -> if start >= 0 { eprint_span(src, start) } else { 0 }
        DiagnosticSourceNamed(name) -> { eprint(name) eprint(": ") }
      }
      eprint("note: ")
      eprint(label)
      eprint("\n")
    }
  }
}

pub(package) fn diagnostic_render_related(related: DiagnosticRelatedLocationList) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
      diagnostic_render_related_location(label, location)
      diagnostic_render_related(rest)
    }
  }
}

pub(package) fn diagnostic_render_text_eq(value: str, expected: str) -> i64 {
  if __str_len(value) != __str_len(expected) { 0 }
  else { src_eq(__str_ptr(value), 0, __str_len(value), expected) }
}

pub(package) fn diagnostic_render_text_field(fields: DiagnosticFieldList, key: str) -> str {
  match fields {
    DiagnosticFieldNil -> ""
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldText(name, value) -> {
        if __str_len(name) == __str_len(key) and src_eq(__str_ptr(name), 0, __str_len(name), key) == 1 { value }
        else { diagnostic_render_text_field(rest, key) }
      }
      _ -> diagnostic_render_text_field(rest, key)
    }
  }
}

pub(package) fn diagnostic_render_bool_field(fields: DiagnosticFieldList, key: str) -> bool {
  match fields {
    DiagnosticFieldNil -> false
    DiagnosticFieldCons(field, rest) -> match field {
      DiagnosticFieldBool(name, value) -> {
        if __str_len(name) == __str_len(key) and src_eq(__str_ptr(name), 0, __str_len(name), key) == 1 { value }
        else { diagnostic_render_bool_field(rest, key) }
      }
      _ -> diagnostic_render_bool_field(rest, key)
    }
  }
}

pub(package) fn diagnostic_render(diagnostic: Diagnostic) -> i64 {
  diagnostic_render_primary(diagnostic_primary(diagnostic))
  diagnostic_render_body(diagnostic)
}

pub(package) fn diagnose_max_render_span() -> i64 { 16777216 }

pub(package) fn diagnose_normalize_span(src: i64, span: i64) -> i64 {
  if span < 0 { 0 - 1 }
  else {
    if span >= src {
      let offset = span - src
      if offset >= 0 and offset < diagnose_max_render_span() { offset } else { 0 - 1 }
    } else {
      if span < diagnose_max_render_span() { span } else { 0 - 1 }
    }
  }
}

pub(package) fn diagnose_render(src: i64, msg: str, span: i64) -> i64 {
  let offset = diagnose_normalize_span(src, span)
  if offset >= 0 { eprint_span(src, offset) } else { 0 }
  eprint(msg)
  eprint("\n")
}

-- Primitive adapters let compiler handler configurations consume the stable
-- Diagnostic envelope without importing its implementation module merely to
-- unpack fields. Structured transports retain the code; legacy operations
-- naturally expose an empty code through their existing adapter paths.
pub(package) fn diagnose_report_severity_tag(diagnostic: Diagnostic) -> i64 {
  match diagnostic_severity(diagnostic) {
    DiagnosticSeverityError -> 1
    DiagnosticSeverityWarning -> 2
    DiagnosticSeverityNote -> 3
  }
}

pub(package) fn diagnose_report_message(diagnostic: Diagnostic) -> str {
  diagnostic_message(diagnostic)
}

pub(package) fn diagnose_report_code(diagnostic: Diagnostic) -> str {
  diagnostic_code_text(diagnostic_code(diagnostic))
}

pub(package) fn diagnose_report_absolute_span(diagnostic: Diagnostic) -> i64 {
  match diagnostic_primary(diagnostic) {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceBuffer(src) -> if start >= 0 { src + start } else { 0 - 1 }
        _ -> start
      }
    }
  }
}

pub(package) fn diagnose_report_absolute_end(diagnostic: Diagnostic) -> i64 {
  match diagnostic_primary(diagnostic) {
    DiagnosticLocationNone -> 0 - 1
    DiagnosticSourceRange(source, start, end) -> {
      match source {
        DiagnosticSourceBuffer(src) -> if end >= 0 { src + end } else { 0 - 1 }
        _ -> end
      }
    }
  }
}

pub(package) fn diagnose_render_report(diagnostic: Diagnostic) -> i64 {
  diagnostic_render(diagnostic)
}

pub(package) fn diagnostic_render_registered_related(tt: i64, related: DiagnosticRelatedLocationList, color: i64) -> i64 {
  match related {
    DiagnosticRelatedLocationNil -> 0
    DiagnosticRelatedLocationCons(DiagnosticRelatedLocation(label, location), rest) -> {
      match location {
        DiagnosticLocationNone -> 0
        _ -> {
          diagnostic_frame_render_prefix(tt, location)
          let note_style = if color == 1 { diagnostic_style_related() } else { diagnostic_style_plain() }
          diagnostic_style_start(note_style) eprint("note") diagnostic_style_reset(note_style)
          eprint(": ") eprint(label) eprint("\n")
          diagnostic_frame_render_location_styled(tt, location, label, note_style)
        }
      }
      diagnostic_render_registered_related(tt, rest, color)
    }
  }
}

-- Canonical human renderer when the pipeline has registered source buffers.
-- The same structured value drives heading, exact rails, related provenance,
-- and teaching text; presentation never rescans syntax for meaning.
pub(package) fn diagnose_render_report_in_registry(tt: i64, diagnostic: Diagnostic) -> i64 {
  let primary = diagnostic_primary(diagnostic)
  let color = diagnostic_style_enabled(tt)
  let primary_style = if color == 0 { diagnostic_style_plain() }
    else { match diagnostic_severity(diagnostic) {
      DiagnosticSeverityError -> diagnostic_style_error()
      DiagnosticSeverityWarning -> diagnostic_style_warning()
      DiagnosticSeverityNote -> diagnostic_style_note()
    } }
  diagnostic_frame_render_prefix(tt, primary)
  diagnostic_render_heading_styled(diagnostic, primary_style)
  diagnostic_frame_render_location_styled(tt, primary, diagnostic_message(diagnostic), primary_style)
  diagnostic_render_registered_related(tt, diagnostic_related(diagnostic), color)
  diagnostic_render_help(diagnostic)
}
