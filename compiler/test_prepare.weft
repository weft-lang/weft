-- compiler/test_prepare.weft -- shared test-source preparation boundary
--
-- Check, test, LSP, MCP, and project sessions must agree on the source and AST
-- transformation that makes `test` declarations checkable as ordinary
-- package-visible functions. Runtime harness generation and execution remain
-- command concerns; this module owns only deterministic compiler input.

use compiler/ir.{*}
use compiler/lib.{nlist_add, nlist_get, nlist_len, nlist_new, node_f1, node_f2, node_new}
use compiler/module.{*}
use compiler/type_registry.{effect_name_hash}
use compiler/typeck.{effect_sig_one}
use stdlib/string.{int_to_str, str_concat}

pub(package) type TestPreparedSource {
  TestPreparedSource(str, i64)
}

pub(package) fn test_prepare_source_content(prepared: TestPreparedSource) -> str {
  match prepared { TestPreparedSource(content, wrapper_bank_start) -> content }
}

pub(package) fn test_prepare_source_wrapper_bank_start(prepared: TestPreparedSource) -> i64 {
  match prepared { TestPreparedSource(content, wrapper_bank_start) -> wrapper_bank_start }
}

pub(package) fn test_prepare_wrapper_name(index: i64) -> str {
  str_concat("t_", int_to_str(index))
}

pub(package) fn test_prepare_wrapper_name_digit_count(index: i64) -> i64 {
  if index < 10 { 1 } else { 1 + test_prepare_wrapper_name_digit_count(index / 10) }
}

pub(package) fn test_prepare_wrapper_name_len(index: i64) -> i64 {
  2 + test_prepare_wrapper_name_digit_count(index)
}

pub(package) fn test_prepare_wrapper_name_offset_from_bank(name_bank_start: i64, index: i64) -> i64 {
  let mut offset = name_bank_start + 4
  let mut i = 0
  while i < index {
    offset = offset + test_prepare_wrapper_name_len(i) + 1
    i = i + 1
  }
  offset
}

fn test_prepare_name_bank(index: i64, count: i64, acc: str) -> str {
  if index >= count { acc }
  else { test_prepare_name_bank(index + 1, count, str_concat(acc, str_concat(test_prepare_wrapper_name(index), " "))) }
}

pub(package) fn test_prepare_source(raw: str, wrapper_count: i64) -> TestPreparedSource {
  let prefix = "use stdlib/test.{*} "
  let wrapper_bank_start = __str_len(prefix) + __str_len(raw)
  let bank = if wrapper_count <= 0 { "" }
    else { test_prepare_name_bank(0, wrapper_count, "\n-- ") }
  TestPreparedSource(str_concat(prefix, str_concat(raw, bank)), wrapper_bank_start)
}

fn test_prepare_decl_is_test(decl: Decl) -> i64 {
  match decl {
    TestDecl(ns, nl, body) -> 1
    _ -> 0
  }
}

pub(package) fn test_prepare_fns_have_tests(fns: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut i = 0
  while i < nfns {
    if test_prepare_decl_is_test(decl_from_node(node_f1(nlist_get(fns, i)))) == 1 { return 1 } else { 0 }
    i = i + 1
  }
  0
}

pub(package) fn test_prepare_fns_test_count(fns: i64) -> i64 {
  let nfns = nlist_len(fns)
  let mut count = 0
  for i in 0..nfns {
    if test_prepare_decl_is_test(decl_from_node(node_f1(nlist_get(fns, i)))) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn test_prepare_add_wrapper_for_decl(regular: i64, decl: Decl, test_src: i64, test_effects: i64, index: i64, name_bank_start: i64, tt: i64) -> i64 {
  match decl {
    TestDecl(name_ns, name_nl, typed_body) -> {
      let wrapper_ns = test_prepare_wrapper_name_offset_from_bank(name_bank_start, index)
      let wrapper_len = test_prepare_wrapper_name_len(index)
      let fn_inner = node_new(8, wrapper_ns, wrapper_len, nlist_new(), expr_to_node(typed_body))
      let fn_wrap = node_new(23, fn_inner, 0, test_effects, 0)
      -- The compiler-owned harness is an SDK module in installed layouts.
      -- Only these synthetic, reserved wrapper declarations cross its one-way
      -- import edge into the user test module; user declarations retain their
      -- authored visibility and never acquire SDK package membership.
      let declaration = module_decl_fact_register(tt, test_src, 0, module_decl_namespace_value(), wrapper_ns, wrapper_len, module_visibility_public())
      let fn_pair = node_new(declaration, fn_wrap, test_src, 0, 0)
      module_decl_fact_bind_function_pair(declaration, fn_pair)
      module_fact_cache_function_pair(tt, test_src, fn_pair)
      nlist_add(regular, fn_pair)
    }
    _ -> 0
  }
}

pub(package) fn test_prepare_wrap_fns(fns: i64, name_bank_start: i64, tt: i64) -> i64 {
  let regular = nlist_new()
  let nfns = nlist_len(fns)
  let test_effects = effect_sig_one(effect_name_hash(__str_ptr("Test"), 0, 4))
  let mut test_index = 0
  for i in 0..nfns {
    let pair = nlist_get(fns, i)
    let decl = decl_from_node(node_f1(pair))
    if test_prepare_decl_is_test(decl) == 1 {
      test_prepare_add_wrapper_for_decl(regular, decl, node_f2(pair), test_effects, test_index, name_bank_start, tt)
      test_index = test_index + 1
    } else {
      nlist_add(regular, pair)
    }
  }
  regular
}
