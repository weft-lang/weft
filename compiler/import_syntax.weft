-- Import declarations before package resolution or source acquisition.
-- Names are source-relative byte ranges; the enclosing parsed source owns
-- their text. Storage cursors stay private to the current parser adapter.

use stdlib/list.{List}
use compiler/module.{DeclVisibility}

pub(package) type ImportName {
  start: usize,
  length: usize
}

pub(package) type ImportSelection {
  ImportWildcard,
  ImportSymbol(ImportName),
  ImportRenamedSymbol(ImportName, ImportName)
}

pub(package) type ImportBinding {
  ImportModule(ImportName),
  ImportSymbols(List<ImportSelection>)
}

pub(package) type ImportSyntax {
  module_path: str,
  binding: ImportBinding
}

pub(package) type ImportParse {
  ImportParsed(ImportSyntax, i64),
  ImportInvalid(i64)
}

pub(package) type ImportSelectionsParse {
  NoImportSelections(i64),
  ParsedImportSelections(List<ImportSelection>, i64)
}

pub(package) type ImportDeclaration {
  syntax: ImportSyntax,
  visibility: DeclVisibility,
  start: usize,
  end: usize
}
