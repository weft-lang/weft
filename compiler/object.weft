-- compiler/object.weft -- Emit Mach-O relocatable object file (.o)
--
-- Produces a .o file that the system linker (ld) turns into an executable.
-- This replaces the direct executable emission in macho.weft for linked
-- binaries. External function calls become BL 0 + ARM64_RELOC_BRANCH26.
-- The linker handles GOT, stubs, code signing, and segment layout.

use compiler/lib.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/object_storage.{*}
use stdlib/vector as vector
use stdlib/vector.{*}

-- Typed, contiguous object-emitter tables. Both records contain only scalar
-- fields, so Vector stores their payloads inline without per-entry nodes.
pub(package) type ObjectSymbol {
  name_start: i64,
  name_len: i64,
  value: i64,
  section: i64
}

pub(package) type ObjectRelocation {
  address: i64,
  symbol_or_addend: i64,
  kind: i64
}

-- External symbol names for GOT indices used by linked user programs.
pub(package) fn got_sym_name(gi: i64) -> str {
  match gi {
    0 -> "posix_spawn"
    1 -> "waitpid"
    2 -> "exit"
    3 -> "pthread_create"
    4 -> "pthread_join"
    5 -> "mmap"
    6 -> "write"
    7 -> "read"
    8 -> "open"
    9 -> "close"
    10 -> "pthread_mutex_init"
    11 -> "pthread_mutex_lock"
    12 -> "pthread_mutex_unlock"
    13 -> "pthread_mutex_destroy"
    14 -> "pthread_cond_init"
    15 -> "pthread_cond_wait"
    16 -> "pthread_cond_signal"
    17 -> "pthread_cond_broadcast"
    18 -> "pthread_cond_destroy"
    19 -> "clock_gettime"
    20 -> "nanosleep"
    21 -> "getenv"
    22 -> "opendir"
    23 -> "readdir"
    24 -> "closedir"
    25 -> "stat"
    26 -> "mkdir"
    27 -> "remove"
    28 -> "rename"
    29 -> "getcwd"
    30 -> "__error"
    31 -> "pipe"
    32 -> "posix_spawn_file_actions_init"
    33 -> "posix_spawn_file_actions_adddup2"
    34 -> "posix_spawn_file_actions_addclose"
    35 -> "posix_spawn_file_actions_destroy"
    36 -> "kill"
    37 -> "getaddrinfo"
    38 -> "freeaddrinfo"
    39 -> "signal"
    _ -> "unknown"
  }
}
pub(package) fn got_sym_count() -> i64 { 40 }

-- Relocation kinds carried in the reloc node's f3 field.
pub(package) fn object_reloc_kind_branch26() -> i64 { 0 }
pub(package) fn object_reloc_kind_page21() -> i64 { 1 }
pub(package) fn object_reloc_kind_pageoff12() -> i64 { 2 }
pub(package) fn object_reloc_kind_addend() -> i64 { 3 }

-- Compile with external linkage: build .o file buffer.
-- `weft build` consumes the retained typed link plan. External object users
-- may also invoke the platform linker; used system libraries are auto-linked
-- by legal LC_LINKER_OPTION commands, while package artifacts require their
-- exact validated paths.
pub(package) fn compile_object(code: i64, fm: i64, src: i64, ngot: i64) -> rc i64 {
  -- Static closure-pair slots (static closure ownership) live in a zerofill
  -- __DATA,__wstatic section; ADRP/ADD sites relocate against its base
  -- symbol with an ARM64_RELOC_ADDEND carrying the slot offset.
  let nslots = object_storage_static_pair_slot_count(fm)
  let wsize = nslots * 16
  let code_size = buf_len(code)
  let wstatic_addr = (code_size + 15) / 16 * 16
  let native_external_count = object_storage_native_external_count(fm)
  -- Build symbol list: _main (defined, index 0), the embedded provenance
  -- table (defined, index 1), an optional wstatic base, then externals.
  -- Symbol order must match relocation indices.
  let mut syms = vector.migration_with_capacity_i64<ObjectSymbol>(got_sym_count() + native_external_count + 3)
  let names = object_storage_alloc_scratch(768)
  -- _main symbol points to offset 0 (our startup code: mmap + call main + ret).
  -- The actual main() function is called via BL from the startup code.
  let mut p = 0
  mem_copy(names + p, __str_ptr("main"), 4)
  syms.push(ObjectSymbol { name_start: names + p - src, name_len: 4, value: 0, section: 1 })
  p = p + 4
  let provenance_name_len = __str_len("weft_provenance")
  mem_copy(names + p, __str_ptr("weft_provenance"), provenance_name_len)
  syms.push(ObjectSymbol { name_start: names + p - src, name_len: provenance_name_len, value: object_storage_native_provenance_table_offset(fm), section: 1 })
  p = p + provenance_name_len
  if nslots > 0 {
    let wname_len = __str_len("weft_static_pairs")
    mem_copy(names + p, __str_ptr("weft_static_pairs"), wname_len)
    syms.push(ObjectSymbol { name_start: names + p - src, name_len: wname_len, value: wstatic_addr, section: 2 })
    p = p + wname_len
  } else { 0 }
  -- External symbols: indices 1-10 match GOT indices 0-9.
  for gi in 0..got_sym_count() {
    let name = got_sym_name(gi)
    let nl = __str_len(name)
    mem_copy(names + p, __str_ptr(name), nl)
    syms.push(ObjectSymbol { name_start: names + p - src, name_len: nl, value: 0, section: 0 })
    p = p + nl
  }
  -- Manifest-native externals follow the fixed runtime bridge symbols. Their
  -- GOT indices are assigned lazily in the same used-list order, so relocation
  -- indices and undefined-symbol order share one deterministic source.
  for ni in 0..native_external_count {
    let name_ptr = object_storage_native_external_symbol_ptr(fm, ni)
    let name_len = object_storage_native_external_symbol_len(fm, ni)
    syms.push(ObjectSymbol { name_start: name_ptr - src, name_len: name_len, value: 0, section: 0 })
  }
  let extdef_shift = 1 + (if nslots > 0 { 1 } else { 0 })

  -- Build relocation list from GOT patches.
  let gn = object_storage_got_patch_count(fm)
  let spn = object_storage_static_pair_patch_count(fm)
  let mut relocs = vector.migration_with_capacity_i64<ObjectRelocation>(gn + spn * 4 + 2)
  for i in 0..gn {
    let code_pos = object_storage_got_patch_code_pos(fm, i)
    let gi = object_storage_got_patch_index(fm, i)
    -- Final symbol index = gi + 1 + extdef_shift (defined symbols first).
    relocs.push(ObjectRelocation { address: code_pos, symbol_or_addend: gi + 1 + extdef_shift, kind: object_reloc_kind_branch26() })
  }
  -- Startup's provenance ADRP/ADD pair relocates against the local table
  -- symbol in __text. This remains ASLR- and final-link-placement-safe even
  -- when the table lies more than ADR's +/-1 MiB range from startup.
  let provenance_adrp_pos = object_storage_native_provenance_adrp_pos(fm)
  relocs.push(ObjectRelocation { address: provenance_adrp_pos, symbol_or_addend: 1, kind: object_reloc_kind_page21() })
  relocs.push(ObjectRelocation { address: provenance_adrp_pos + 4, symbol_or_addend: 1, kind: object_reloc_kind_pageoff12() })
  -- Static-pair ADRP/ADD sites: ADDEND must directly precede the entry
  -- it modifies. The wstatic base symbol has final index 2.
  for i in 0..spn {
    let adrp_pos = object_storage_static_pair_patch_code_pos(fm, i)
    let slot_off = object_storage_static_pair_patch_slot_off(fm, i)
    relocs.push(ObjectRelocation { address: adrp_pos, symbol_or_addend: slot_off, kind: object_reloc_kind_addend() })
    relocs.push(ObjectRelocation { address: adrp_pos, symbol_or_addend: 2, kind: object_reloc_kind_page21() })
    relocs.push(ObjectRelocation { address: adrp_pos + 4, symbol_or_addend: slot_off, kind: object_reloc_kind_addend() })
    relocs.push(ObjectRelocation { address: adrp_pos + 4, symbol_or_addend: 2, kind: object_reloc_kind_pageoff12() })
  }

  emit_object_with_link_plan(code, relocs, syms, src, wstatic_addr, wsize, fm)
}

pub(package) fn object_link_option_argument_count(fm: i64) -> i64 {
  let mut count = 0
  for i in 0..object_storage_native_link_library_count(fm) {
    let entry = object_storage_native_link_library_entry(fm, i)
    if object_storage_native_link_library_is_used(entry) == 1 and object_storage_native_link_library_kind(entry) == 1 {
      count = count + 1
    } else { 0 }
  }
  count
}

pub(package) fn object_link_option_command_size(fm: i64) -> i64 {
  let mut size = 0
  for i in 0..object_storage_native_link_library_count(fm) {
    let entry = object_storage_native_link_library_entry(fm, i)
    if object_storage_native_link_library_is_used(entry) == 1 and object_storage_native_link_library_kind(entry) == 1 {
      let raw = 12 + 2 + object_storage_native_link_library_link_len(entry) + 1
      size = size + (raw + 7) / 8 * 8
    } else { 0 }
  }
  size
}

pub(package) fn object_emit_link_options(o: i64, fm: i64, cmd_size: i64) -> i64 {
  if cmd_size == 0 { 0 }
  else {
    for i in 0..object_storage_native_link_library_count(fm) {
      let entry = object_storage_native_link_library_entry(fm, i)
      if object_storage_native_link_library_is_used(entry) == 1 and object_storage_native_link_library_kind(entry) == 1 {
        let start = buf_len(o)
        let raw_size = 12 + 2 + object_storage_native_link_library_link_len(entry) + 1
        let library_cmd_size = (raw_size + 7) / 8 * 8
        bu32(o, 45)            -- cmd: LC_LINKER_OPTION
        bu32(o, library_cmd_size)
        bu32(o, 1)
        bstr(o, "-l")
        bscopy(o, object_storage_native_link_library_link_ptr(entry), object_storage_native_link_library_link_len(entry), 0)
        bu8(o, 0)
        let written = buf_len(o) - start
        if written < library_cmd_size { bfill(o, library_cmd_size - written) } else { 0 }
      } else { 0 }
    }
    cmd_size
  }
}

-- Emit a complete .o file from code buffer + relocation list + symbol info
-- code: buf with machine code
-- relocs: typed vector of {address, symbol_or_addend, kind} entries
-- syms: typed vector of {name_start, name_len, value, section} entries
--       (section = 0 undefined, 1 __text, 2 __wstatic)
-- src: source buffer (for symbol name bytes)
-- wstatic_addr/wsize: zerofill __wstatic section placement (wsize 0 = absent)
pub(package) fn emit_object(code: i64, relocs: Vector<ObjectRelocation>, syms: Vector<ObjectSymbol>, src: i64, wstatic_addr: i64, wsize: i64) -> rc i64 {
  emit_object_with_link_plan(code, relocs, syms, src, wstatic_addr, wsize, 0)
}

pub(package) fn emit_object_with_link_plan(code: i64, relocs: Vector<ObjectRelocation>, syms: Vector<ObjectSymbol>, src: i64, wstatic_addr: i64, wsize: i64, fm: i64) -> rc i64 {
  let code_size = buf_len(code)
  let nrelocs = vector_len<ObjectRelocation>(relocs)
  let nsyms = vector_len<ObjectSymbol>(syms)
  let nsects = if wsize > 0 { 2 } else { 1 }

  -- Compute offsets
  let hdr_size = 32
  let seg_cmd_size = 72 + 80 * nsects
  let bv_cmd_size = 24
  let symtab_cmd_size = 24
  let dysymtab_cmd_size = 80
  let linker_option_cmd_size = object_link_option_command_size(fm)
  let cmds_size = seg_cmd_size + bv_cmd_size + symtab_cmd_size + dysymtab_cmd_size + linker_option_cmd_size
  let code_off = hdr_size + cmds_size
  let reloc_off = code_off + code_size
  let sym_off = reloc_off + nrelocs * 8
  let str_off = sym_off + nsyms * 16

  -- Build string table and compute strsize
  let strtab = buf_new(512)
  bu8(strtab, 0)
  let str_indices = object_storage_alloc_scratch(nsyms * 8)
  for i in 0..nsyms {
    let sym = vector_get_in_bounds<ObjectSymbol>(syms, i)
    let ns = sym.name_start
    let nl = sym.name_len
    object_storage_store_word(str_indices, i, buf_len(strtab))
    bu8(strtab, 95)
    bscopy(strtab, src + ns, nl, 0)
    bu8(strtab, 0)
  }
  let strsize = buf_len(strtab)

  -- Count defined vs undefined symbols
  let mut nextdef = 0
  let mut nundef = 0
  for i in 0..nsyms {
    let sym = vector_get_in_bounds<ObjectSymbol>(syms, i)
    if sym.section >= 1 { nextdef = nextdef + 1 } else { nundef = nundef + 1 }
  }

  let total_size = str_off + strsize
  let o = buf_new(total_size + 256)

  -- Mach-O header (32 bytes)
  bu32(o, 4277009103)    -- magic: 0xFEEDFACF
  bu32(o, 16777228)      -- cputype: ARM64
  bu32(o, 0)             -- cpusubtype: ALL
  bu32(o, 1)             -- filetype: MH_OBJECT
  bu32(o, 4 + object_link_option_argument_count(fm)) -- ncmds
  bu32(o, cmds_size)     -- sizeofcmds
  bu32(o, 8192)          -- flags: MH_SUBSECTIONS_VIA_SYMBOLS
  bu32(o, 0)             -- reserved

  -- LC_SEGMENT_64 (72 + 80 * nsects bytes)
  bu32(o, 25)            -- cmd: LC_SEGMENT_64
  bu32(o, seg_cmd_size)  -- cmdsize
  bfill(o, 16)           -- segname: empty
  bu64(o, 0)             -- vmaddr
  if wsize > 0 { bu64(o, wstatic_addr + wsize) } else { bu64(o, code_size) }  -- vmsize
  bu64(o, code_off)      -- fileoff
  bu64(o, code_size)     -- filesize
  bu32(o, 7)             -- maxprot: rwx
  bu32(o, 7)             -- initprot: rwx
  bu32(o, nsects)        -- nsects
  bu32(o, 0)             -- flags

  -- section_64: __text (80 bytes)
  bstr(o, "__text") bfill(o, 10)
  bstr(o, "__TEXT") bfill(o, 10)
  bu64(o, 0)             -- addr
  bu64(o, code_size)     -- size
  bu32(o, code_off)      -- offset
  bu32(o, 2)             -- align: 2^2 = 4
  bu32(o, reloc_off)     -- reloff
  bu32(o, nrelocs)       -- nreloc
  bu32(o, 2147484672)    -- flags: S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
  bu32(o, 0) bu32(o, 0) bu32(o, 0)

  -- section_64: __wstatic zerofill (static closure-pair slots)
  if wsize > 0 {
    bstr(o, "__wstatic") bfill(o, 7)
    bstr(o, "__DATA") bfill(o, 10)
    bu64(o, wstatic_addr)  -- addr
    bu64(o, wsize)         -- size
    bu32(o, 0)             -- offset (zerofill: no file content)
    bu32(o, 4)             -- align: 2^4 = 16
    bu32(o, 0)             -- reloff
    bu32(o, 0)             -- nreloc
    bu32(o, 1)             -- flags: S_ZEROFILL
    bu32(o, 0) bu32(o, 0) bu32(o, 0)
    0
  } else { 0 }

  -- LC_BUILD_VERSION (24 bytes)
  bu32(o, 50)            -- cmd: LC_BUILD_VERSION
  bu32(o, 24)            -- cmdsize
  bu32(o, 1)             -- platform: PLATFORM_MACOS
  bu32(o, 917504)        -- minos: 14.0.0 = 0x0E0000
  bu32(o, 983040)        -- sdk: 15.0.0 = 0x0F0000
  bu32(o, 0)             -- ntools

  -- Preserve manifest-selected library directives in the relocatable object
  -- as compatibility metadata. Native product finalization consumes the same
  -- typed plan directly, without a parallel package-specific command surface.
  object_emit_link_options(o, fm, linker_option_cmd_size)

  -- LC_SYMTAB (24 bytes)
  bu32(o, 2)             -- cmd: LC_SYMTAB
  bu32(o, 24)            -- cmdsize
  bu32(o, sym_off)       -- symoff
  bu32(o, nsyms)         -- nsyms
  bu32(o, str_off)       -- stroff
  bu32(o, strsize)       -- strsize

  -- LC_DYSYMTAB (80 bytes)
  bu32(o, 11)            -- cmd: LC_DYSYMTAB
  bu32(o, 80)            -- cmdsize
  bu32(o, 0)             -- ilocalsym
  bu32(o, 0)             -- nlocalsym
  bu32(o, 0)             -- iextdefsym
  bu32(o, nextdef)       -- nextdefsym
  bu32(o, nextdef)       -- iundefsym
  bu32(o, nundef)        -- nundefsym
  bfill(o, 48)           -- remaining fields: all zero

  -- Code section
  bscopy(o, buf_ptr(code), code_size, 0)

  -- Relocation entries (8 bytes each)
  for i in 0..nrelocs {
    let rel = vector_get_in_bounds<ObjectRelocation>(relocs, i)
    let r_address = rel.address
    let r_symidx = rel.symbol_or_addend
    let r_kind = rel.kind
    bu32(o, r_address)
    -- Second word: symidx/addend | pcrel<<24 | length<<25 | extern<<27 | type<<28
    if r_kind == object_reloc_kind_branch26() {
      -- ARM64_RELOC_BRANCH26 (type=2), extern=1, length=2, pcrel=1 = 0x2D000000
      bu32(o, r_symidx + 754974720)
    } else { if r_kind == object_reloc_kind_page21() {
      -- ARM64_RELOC_PAGE21 (type=3), extern=1, length=2, pcrel=1 = 0x3D000000
      bu32(o, r_symidx + 1023410176)
    } else { if r_kind == object_reloc_kind_pageoff12() {
      -- ARM64_RELOC_PAGEOFF12 (type=4), extern=1, length=2, pcrel=0 = 0x4C000000
      bu32(o, r_symidx + 1275068416)
    } else {
      -- ARM64_RELOC_ADDEND (type=10), extern=0, length=2, pcrel=0: value
      -- in the symbolnum field, applies to the next entry = 0xA4000000
      bu32(o, r_symidx + 2751463424)
    } } }
  }

  -- Symbol table (nlist_64, 16 bytes each)
  -- Defined symbols first, then undefined. section carries the section number
  -- for defined symbols (1 = __text, 2 = __wstatic).
  for i in 0..nsyms {
    let sym = vector_get_in_bounds<ObjectSymbol>(syms, i)
    if sym.section >= 1 {
      let strx = object_storage_word_at(str_indices, i)
      bu32(o, strx)
      bu8(o, 15)           -- n_type: N_SECT | N_EXT = 0x0F
      bu8(o, sym.section)  -- n_sect
      bu8(o, 0) bu8(o, 0)  -- n_desc: 0
      bu64(o, sym.value)    -- n_value: address in object
    } else { 0 }
  }
  for i in 0..nsyms {
    let sym = vector_get_in_bounds<ObjectSymbol>(syms, i)
    if sym.section == 0 {
      let strx = object_storage_word_at(str_indices, i)
      bu32(o, strx)
      bu8(o, 1)            -- n_type: N_UNDF | N_EXT = 0x01
      bu8(o, 0)            -- n_sect: NO_SECT
      bu8(o, 0) bu8(o, 0)  -- n_desc: 0
      bu64(o, 0)            -- n_value: 0
    } else { 0 }
  }

  -- String table
  bscopy(o, buf_ptr(strtab), strsize, 0)

  o
}
