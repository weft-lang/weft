-- compiler/mini_sql.weft -- a small embedded SQL grammar module
--
-- This is intentionally not full SQL. It is the first non-Weft Grammar
-- implementation: SELECT projections FROM table with an optional WHERE.

use "compiler/grammar.weft"
use "compiler/diagnose.weft"
use "compiler/typecheck_effect.weft"
use "compiler/types.weft"

type MiniSqlGrammar { MiniSqlGrammar }

fn mini_sql_grammar() -> MiniSqlGrammar { MiniSqlGrammar() }

fn mini_sql_query_tag() -> i64 { 701 }
fn mini_sql_ident_tag() -> i64 { 702 }
fn mini_sql_where_eq_tag() -> i64 { 703 }
fn mini_sql_lit_tag() -> i64 { 704 }
fn mini_sql_tokens_tag() -> i64 { 705 }
fn mini_sql_where_bool_tag() -> i64 { 706 }
fn mini_sql_select_item_tag() -> i64 { 707 }
fn mini_sql_expr_binary_tag() -> i64 { 708 }

fn mini_sql_cmp_eq() -> i64 { 1 }
fn mini_sql_cmp_ne() -> i64 { 2 }
fn mini_sql_cmp_lt() -> i64 { 3 }
fn mini_sql_cmp_le() -> i64 { 4 }
fn mini_sql_cmp_gt() -> i64 { 5 }
fn mini_sql_cmp_ge() -> i64 { 6 }

fn mini_sql_logic_and() -> i64 { 1 }
fn mini_sql_logic_or() -> i64 { 2 }

fn mini_sql_expr_add() -> i64 { 1 }
fn mini_sql_expr_sub() -> i64 { 2 }
fn mini_sql_expr_mul() -> i64 { 3 }
fn mini_sql_expr_div() -> i64 { 4 }
fn mini_sql_expr_concat() -> i64 { 5 }

fn mini_sql_ty_unknown() -> i64 { 0 }
fn mini_sql_ty_i64() -> i64 { 1 }
fn mini_sql_ty_str() -> i64 { 2 }
fn mini_sql_ty_bool() -> i64 { 3 }

fn mini_sql_table_unknown() -> i64 { 0 }
fn mini_sql_table_users() -> i64 { 1 }
fn mini_sql_table_orders() -> i64 { 2 }

fn mini_sql_result(node: i64, pos: i64) -> i64 {
  let r = alloc_bump(16)
  __mem_store64(r, node)
  __mem_store64(r + 8, pos)
  r
}

fn mini_sql_result_node(r: i64) -> i64 { __mem_load64(r) }
fn mini_sql_result_pos(r: i64) -> i64 { __mem_load64(r + 8) }

fn mini_sql_query_new(columns: i64, table_node: i64, where_node: i64, star: i64) -> i64 {
  node_new(mini_sql_query_tag(), columns, table_node, where_node, star)
}

fn mini_sql_ident_new(start: i64, len: i64) -> i64 {
  node_new(mini_sql_ident_tag(), start, len, 0, 0)
}

fn mini_sql_lit_new(start: i64, len: i64, lit_type: i64, value: i64) -> i64 {
  node_new(mini_sql_lit_tag(), start, len, lit_type, value)
}

fn mini_sql_select_item_new(expr: i64, alias: i64, explicit_as: i64) -> i64 {
  node_new(mini_sql_select_item_tag(), expr, alias, explicit_as, 0)
}

fn mini_sql_expr_binary_new(left: i64, right: i64, op: i64) -> i64 {
  node_new(mini_sql_expr_binary_tag(), left, right, op, 0)
}

fn mini_sql_where_cmp_new(column: i64, literal: i64, op: i64) -> i64 {
  node_new(mini_sql_where_eq_tag(), column, literal, op, 0)
}

fn mini_sql_where_eq_new(column: i64, literal: i64) -> i64 {
  mini_sql_where_cmp_new(column, literal, mini_sql_cmp_eq())
}

fn mini_sql_where_bool_new(left: i64, right: i64, op: i64) -> i64 {
  node_new(mini_sql_where_bool_tag(), left, right, op, 0)
}

fn mini_sql_empty_query() -> i64 {
  mini_sql_query_new(nlist_new(), 0, 0, 0)
}

fn mini_sql_tokens_new(source_len: i64) -> i64 {
  node_new(mini_sql_tokens_tag(), source_len, 0, 0, 0)
}

fn mini_sql_tokens_source_len(tokens: i64) -> i64 {
  if tokens == 0 { 0 }
  else { if node_tag(tokens) == mini_sql_tokens_tag() { node_f1(tokens) } else { 0 } }
}

fn mini_sql_query_column_count(query: i64) -> i64 {
  if query == 0 { 0 } else { nlist_len(node_f1(query)) }
}

fn mini_sql_query_star(query: i64) -> i64 {
  if query == 0 { 0 } else { node_f4(query) }
}

fn mini_sql_query_has_where(query: i64) -> i64 {
  if query == 0 { 0 } else { if node_f3(query) == 0 { 0 } else { 1 } }
}

fn mini_sql_query_table_node(query: i64) -> i64 {
  if query == 0 { 0 } else { node_f2(query) }
}

fn mini_sql_ident_start(ident: i64) -> i64 {
  if ident == 0 { 0 } else { node_f1(ident) }
}

fn mini_sql_ident_len(ident: i64) -> i64 {
  if ident == 0 { 0 } else { node_f2(ident) }
}

fn mini_sql_query_table_len(query: i64) -> i64 {
  mini_sql_ident_len(mini_sql_query_table_node(query))
}

fn mini_sql_query_select_item(query: i64, index: i64) -> i64 {
  if query == 0 { 0 } else { nlist_get(node_f1(query), index) }
}

fn mini_sql_select_item_expr(item: i64) -> i64 {
  if item == 0 { 0 }
  else { if node_tag(item) == mini_sql_select_item_tag() { node_f1(item) } else { item } }
}

fn mini_sql_select_item_alias(item: i64) -> i64 {
  if item == 0 { 0 }
  else { if node_tag(item) == mini_sql_select_item_tag() { node_f2(item) } else { 0 } }
}

fn mini_sql_select_item_has_alias(item: i64) -> i64 {
  if mini_sql_select_item_alias(item) == 0 { 0 } else { 1 }
}

fn mini_sql_select_item_explicit_as(item: i64) -> i64 {
  if item == 0 { 0 }
  else { if node_tag(item) == mini_sql_select_item_tag() { node_f3(item) } else { 0 } }
}

fn mini_sql_ascii_lower(ch: i64) -> i64 {
  if ch >= 65 and ch <= 90 { ch + 32 } else { ch }
}

fn mini_sql_is_ident_start(ch: i64) -> i64 {
  if is_alpha(ch) == 1 { 1 } else { if ch == 95 { 1 } else { 0 } }
}

fn mini_sql_is_ident_continue(ch: i64) -> i64 {
  if mini_sql_is_ident_start(ch) == 1 { 1 } else { is_digit(ch) }
}

fn mini_sql_skip_ws(src: i64, n: i64, pos: i64) -> i64 {
  let mut p = pos
  while p < n and is_ws(__mem_load8(src + p)) == 1 {
    p = p + 1
  }
  p
}

fn mini_sql_word_matches(src: i64, n: i64, pos: i64, word: str) -> i64 {
  let len = __str_len(word)
  if pos + len > n { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      if mini_sql_ascii_lower(__mem_load8(src + pos + i)) != mini_sql_ascii_lower(__mem_load8(__str_ptr(word) + i)) {
        ok = 0
        i = len
      } else {
        i = i + 1
      }
    }
    if ok == 0 { 0 }
    else {
      if pos + len < n and mini_sql_is_ident_continue(__mem_load8(src + pos + len)) == 1 { 0 } else { 1 }
    }
  }
}

fn mini_sql_ident_eq(src: i64, ident: i64, word: str) -> i64 {
  if ident == 0 { 0 }
  else { src_eq(src, node_f1(ident), node_f2(ident), word) }
}

fn mini_sql_ident_matches_word(src: i64, n: i64, ident: i64, word: str) -> i64 {
  if ident == 0 { 0 }
  else {
    if mini_sql_ident_len(ident) != __str_len(word) { 0 }
    else { mini_sql_word_matches(src, n, mini_sql_ident_start(ident), word) }
  }
}

fn mini_sql_ident_is_reserved(src: i64, n: i64, ident: i64) -> i64 {
  if mini_sql_ident_matches_word(src, n, ident, "select") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "from") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "where") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "as") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "and") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "or") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "true") == 1 { 1 }
  else { if mini_sql_ident_matches_word(src, n, ident, "false") == 1 { 1 }
  else { 0 } } } } } } } }
}

fn mini_sql_error_at(msg: str, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  Diagnose.error(msg, host_offset + pos)
}

fn mini_sql_recover_to_keyword(src: i64, n: i64, pos: i64, keyword: str) -> i64 {
  let mut p = pos
  let mut result = n
  while p < n {
    if mini_sql_word_matches(src, n, p, keyword) == 1 {
      result = p
      p = n
    } else {
      p = p + 1
    }
  }
  result
}

fn mini_sql_parse_ident(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    if mini_sql_is_ident_start(__mem_load8(src + p)) == 0 { mini_sql_result(0, p) }
    else {
      let mut end = p + 1
      while end < n and mini_sql_is_ident_continue(__mem_load8(src + end)) == 1 {
        end = end + 1
      }
      mini_sql_result(mini_sql_ident_new(p, end - p), end)
    }
  }
}

fn mini_sql_parse_int_literal(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let mut end = p
  let mut value = 0
  while end < n and is_digit(__mem_load8(src + end)) == 1 {
    value = value * 10 + __mem_load8(src + end) - 48
    end = end + 1
  }
  if end == p { mini_sql_result(0, p) }
  else { mini_sql_result(mini_sql_lit_new(p, end - p, mini_sql_ty_i64(), value), end) }
}

fn mini_sql_parse_bool_literal(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "true") == 1 {
    mini_sql_result(mini_sql_lit_new(p, 4, mini_sql_ty_bool(), 1), p + 4)
  } else { if mini_sql_word_matches(src, n, p, "false") == 1 {
    mini_sql_result(mini_sql_lit_new(p, 5, mini_sql_ty_bool(), 0), p + 5)
  } else { mini_sql_result(0, p) } }
}

fn mini_sql_parse_string_literal(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n or __mem_load8(src + p) != 39 { mini_sql_result(0, p) }
  else {
    let mut end = p + 1
    let mut closed = 0
    while end < n and closed == 0 {
      if __mem_load8(src + end) == 39 {
        closed = 1
      } else {
        end = end + 1
      }
    }
    if closed == 1 {
      mini_sql_result(mini_sql_lit_new(p + 1, end - p - 1, mini_sql_ty_str(), 0), end + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: unterminated string literal", p, host_offset)
      mini_sql_result(mini_sql_lit_new(p + 1, n - p - 1, mini_sql_ty_str(), 0), n)
    }
  }
}

fn mini_sql_parse_literal(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let bool_res = mini_sql_parse_bool_literal(src, n, p)
  if mini_sql_result_node(bool_res) != 0 { bool_res }
  else { if p < n and __mem_load8(src + p) == 39 {
    mini_sql_parse_string_literal(src, n, p, host_offset)
  } else {
    mini_sql_parse_int_literal(src, n, p)
  } }
}

fn mini_sql_parse_scalar_atom(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p < n and __mem_load8(src + p) == 40 {
    let inner_res = mini_sql_parse_scalar_expr(src, n, p + 1, host_offset)
    let inner = mini_sql_result_node(inner_res)
    let after_inner = mini_sql_skip_ws(src, n, mini_sql_result_pos(inner_res))
    if after_inner < n and __mem_load8(src + after_inner) == 41 {
      mini_sql_result(inner, after_inner + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: expected ')' in expression", after_inner, host_offset)
      mini_sql_result(inner, after_inner)
    }
  }
  else {
    let lit_res = mini_sql_parse_literal(src, n, p, host_offset)
    let lit = mini_sql_result_node(lit_res)
    if lit != 0 { lit_res }
    else {
      let id_res = mini_sql_parse_ident(src, n, p)
      let id = mini_sql_result_node(id_res)
      if id == 0 { mini_sql_result(0, mini_sql_result_pos(id_res)) }
      else {
        if mini_sql_ident_is_reserved(src, n, id) == 1 { mini_sql_result(0, p) }
        else { id_res }
      }
    }
  }
}

fn mini_sql_parse_scalar_mul_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    match __mem_load8(src + p) {
      42 -> mini_sql_result(mini_sql_expr_mul(), p + 1)
      47 -> mini_sql_result(mini_sql_expr_div(), p + 1)
      _ -> mini_sql_result(0, p)
    }
  }
}

fn mini_sql_parse_scalar_add_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    match __mem_load8(src + p) {
      43 -> mini_sql_result(mini_sql_expr_add(), p + 1)
      45 -> mini_sql_result(mini_sql_expr_sub(), p + 1)
      124 -> {
        if p + 1 < n and __mem_load8(src + p + 1) == 124 {
          mini_sql_result(mini_sql_expr_concat(), p + 2)
        } else { mini_sql_result(0, p) }
      }
      _ -> mini_sql_result(0, p)
    }
  }
}

fn mini_sql_parse_scalar_mul(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_scalar_atom(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let op_res = mini_sql_parse_scalar_mul_op(src, n, p)
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      done = 1
    } else {
      let right_res = mini_sql_parse_scalar_atom(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected expression after operator", mini_sql_result_pos(right_res), host_offset)
        left = mini_sql_expr_binary_new(left, 0, op)
        p = mini_sql_result_pos(right_res)
      } else {
        left = mini_sql_expr_binary_new(left, right, op)
        p = mini_sql_result_pos(right_res)
      }
    }
  }
  mini_sql_result(left, p)
}

fn mini_sql_parse_scalar_expr(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_scalar_mul(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let op_res = mini_sql_parse_scalar_add_op(src, n, p)
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      done = 1
    } else {
      let right_res = mini_sql_parse_scalar_mul(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected expression after operator", mini_sql_result_pos(right_res), host_offset)
        left = mini_sql_expr_binary_new(left, 0, op)
        p = mini_sql_result_pos(right_res)
      } else {
        left = mini_sql_expr_binary_new(left, right, op)
        p = mini_sql_result_pos(right_res)
      }
    }
  }
  mini_sql_result(left, p)
}

fn mini_sql_parse_projection_expr(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  mini_sql_parse_scalar_expr(src, n, pos, host_offset)
}

fn mini_sql_parse_projection_alias(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let explicit_as = if mini_sql_word_matches(src, n, p, "as") == 1 { 1 } else { 0 }
  let alias_pos = if explicit_as == 1 { mini_sql_skip_ws(src, n, p + 2) } else { p }
  let alias_res = mini_sql_parse_ident(src, n, alias_pos)
  let alias = mini_sql_result_node(alias_res)
  let result = alloc_bump(24)
  if alias == 0 {
    if explicit_as == 1 {
      mini_sql_error_at("mini_sql parse error: expected alias after AS", mini_sql_result_pos(alias_res), host_offset)
    } else { 0 }
    __mem_store64(result, 0)
    __mem_store64(result + 8, alias_pos)
    __mem_store64(result + 16, explicit_as)
  } else {
    if mini_sql_ident_is_reserved(src, n, alias) == 1 {
      if explicit_as == 1 {
        mini_sql_error_at("mini_sql parse error: expected alias after AS", mini_sql_ident_start(alias), host_offset)
      } else { 0 }
      __mem_store64(result, 0)
      __mem_store64(result + 8, alias_pos)
      __mem_store64(result + 16, explicit_as)
    } else {
      __mem_store64(result, alias)
      __mem_store64(result + 8, mini_sql_result_pos(alias_res))
      __mem_store64(result + 16, explicit_as)
    }
  }
  result
}

fn mini_sql_alias_result_alias(result: i64) -> i64 { __mem_load64(result) }
fn mini_sql_alias_result_pos(result: i64) -> i64 { __mem_load64(result + 8) }
fn mini_sql_alias_result_explicit_as(result: i64) -> i64 { __mem_load64(result + 16) }

fn mini_sql_parse_projection_item(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let expr_res = mini_sql_parse_projection_expr(src, n, pos, host_offset)
  let expr = mini_sql_result_node(expr_res)
  if expr == 0 {
    mini_sql_error_at("mini_sql parse error: expected selected expression", mini_sql_result_pos(expr_res), host_offset)
    mini_sql_result(0, mini_sql_result_pos(expr_res))
  } else {
    let alias_res = mini_sql_parse_projection_alias(src, n, mini_sql_result_pos(expr_res), host_offset)
    let alias = mini_sql_alias_result_alias(alias_res)
    let explicit_as = mini_sql_alias_result_explicit_as(alias_res)
    mini_sql_result(mini_sql_select_item_new(expr, alias, explicit_as), mini_sql_alias_result_pos(alias_res))
  }
}

fn mini_sql_parse_columns(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let cols = nlist_new()
  let mut p = mini_sql_skip_ws(src, n, pos)
  let mut star = 0
  if p < n and __mem_load8(src + p) == 42 {
    star = 1
    p = p + 1
  } else {
    let mut done = 0
    while done == 0 {
      let item_res = mini_sql_parse_projection_item(src, n, p, host_offset)
      let item = mini_sql_result_node(item_res)
      if item == 0 {
        p = mini_sql_result_pos(item_res)
        done = 1
      } else {
        nlist_add(cols, item)
        p = mini_sql_skip_ws(src, n, mini_sql_result_pos(item_res))
        if p < n and __mem_load8(src + p) == 44 {
          p = mini_sql_skip_ws(src, n, p + 1)
          if mini_sql_word_matches(src, n, p, "from") == 1 {
            mini_sql_error_at("mini_sql parse error: expected selected expression after comma", p, host_offset)
            done = 1
          } else { 0 }
        } else {
          done = 1
        }
      }
    }
  }
  let result = alloc_bump(24)
  __mem_store64(result, cols)
  __mem_store64(result + 8, p)
  __mem_store64(result + 16, star)
  result
}

fn mini_sql_columns_result_cols(result: i64) -> i64 { __mem_load64(result) }
fn mini_sql_columns_result_pos(result: i64) -> i64 { __mem_load64(result + 8) }
fn mini_sql_columns_result_star(result: i64) -> i64 { __mem_load64(result + 16) }

fn mini_sql_parse_cmp_op(src: i64, n: i64, pos: i64) -> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p >= n { mini_sql_result(0, p) }
  else {
    let ch = __mem_load8(src + p)
    match ch {
      61 -> mini_sql_result(mini_sql_cmp_eq(), p + 1)
      33 -> {
        if p + 1 < n and __mem_load8(src + p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_ne(), p + 2)
        } else { mini_sql_result(0, p) }
      }
      60 -> {
        if p + 1 < n and __mem_load8(src + p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_le(), p + 2)
        } else { if p + 1 < n and __mem_load8(src + p + 1) == 62 {
          mini_sql_result(mini_sql_cmp_ne(), p + 2)
        } else { mini_sql_result(mini_sql_cmp_lt(), p + 1) } }
      }
      62 -> {
        if p + 1 < n and __mem_load8(src + p + 1) == 61 {
          mini_sql_result(mini_sql_cmp_ge(), p + 2)
        } else { mini_sql_result(mini_sql_cmp_gt(), p + 1) }
      }
      _ -> mini_sql_result(0, p)
    }
  }
}

fn mini_sql_parse_predicate_leaf(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  let left_res = mini_sql_parse_scalar_expr(src, n, p, host_offset)
  let left = mini_sql_result_node(left_res)
  if left == 0 {
    mini_sql_error_at("mini_sql parse error: expected predicate expression", mini_sql_result_pos(left_res), host_offset)
    mini_sql_result(0, n)
  } else {
    let op_res = mini_sql_parse_cmp_op(src, n, mini_sql_result_pos(left_res))
    let op = mini_sql_result_node(op_res)
    if op == 0 {
      left_res
    } else {
      let right_res = mini_sql_parse_scalar_expr(src, n, mini_sql_result_pos(op_res), host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        mini_sql_error_at("mini_sql parse error: expected predicate expression", mini_sql_result_pos(right_res), host_offset)
        mini_sql_result(mini_sql_where_cmp_new(left, 0, op), mini_sql_result_pos(right_res))
      } else {
        mini_sql_result(mini_sql_where_cmp_new(left, right, op), mini_sql_result_pos(right_res))
      }
    }
  }
}

fn mini_sql_parse_predicate_atom(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let p = mini_sql_skip_ws(src, n, pos)
  if p < n and __mem_load8(src + p) == 40 {
    let inner_res = mini_sql_parse_predicate_or(src, n, p + 1, host_offset)
    let inner = mini_sql_result_node(inner_res)
    let after_inner = mini_sql_skip_ws(src, n, mini_sql_result_pos(inner_res))
    if after_inner < n and __mem_load8(src + after_inner) == 41 {
      mini_sql_result(inner, after_inner + 1)
    } else {
      mini_sql_error_at("mini_sql parse error: expected ')' in predicate", after_inner, host_offset)
      mini_sql_result(inner, after_inner)
    }
  } else {
    mini_sql_parse_predicate_leaf(src, n, p, host_offset)
  }
}

fn mini_sql_parse_predicate_and(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_predicate_atom(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let next = mini_sql_skip_ws(src, n, p)
    if mini_sql_word_matches(src, n, next, "and") == 1 {
      let right_res = mini_sql_parse_predicate_atom(src, n, next + 3, host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        left = mini_sql_where_bool_new(left, 0, mini_sql_logic_and())
      } else {
        left = mini_sql_where_bool_new(left, right, mini_sql_logic_and())
      }
      p = mini_sql_result_pos(right_res)
    } else {
      done = 1
    }
  }
  mini_sql_result(left, p)
}

fn mini_sql_parse_predicate_or(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let first_res = mini_sql_parse_predicate_and(src, n, pos, host_offset)
  let mut left = mini_sql_result_node(first_res)
  let mut p = mini_sql_result_pos(first_res)
  let mut done = 0
  while done == 0 {
    let next = mini_sql_skip_ws(src, n, p)
    if mini_sql_word_matches(src, n, next, "or") == 1 {
      let right_res = mini_sql_parse_predicate_and(src, n, next + 2, host_offset)
      let right = mini_sql_result_node(right_res)
      if right == 0 {
        left = mini_sql_where_bool_new(left, 0, mini_sql_logic_or())
      } else {
        left = mini_sql_where_bool_new(left, right, mini_sql_logic_or())
      }
      p = mini_sql_result_pos(right_res)
    } else {
      done = 1
    }
  }
  mini_sql_result(left, p)
}

fn mini_sql_parse_where(src: i64, n: i64, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, pos)
  if mini_sql_word_matches(src, n, p, "where") == 0 { mini_sql_result(0, p) }
  else {
    p = mini_sql_skip_ws(src, n, p + 5)
    mini_sql_parse_predicate_or(src, n, p, host_offset)
  }
}

fn mini_sql_parse_source_at(src: i64, n: i64, tt: i64, host_offset: i64) -[Diagnose]> i64 {
  let mut p = mini_sql_skip_ws(src, n, 0)
  if mini_sql_word_matches(src, n, p, "select") == 0 {
    mini_sql_error_at("mini_sql parse error: expected SELECT", p, host_offset)
    mini_sql_empty_query()
  } else {
    p = mini_sql_skip_ws(src, n, p + 6)
    let cols_res = mini_sql_parse_columns(src, n, p, host_offset)
    let cols = mini_sql_columns_result_cols(cols_res)
    let star = mini_sql_columns_result_star(cols_res)
    p = mini_sql_skip_ws(src, n, mini_sql_columns_result_pos(cols_res))
    if mini_sql_word_matches(src, n, p, "from") == 0 {
      mini_sql_error_at("mini_sql parse error: expected FROM", p, host_offset)
      p = mini_sql_recover_to_keyword(src, n, p, "from")
    } else { 0 }
    if p < n and mini_sql_word_matches(src, n, p, "from") == 1 { p = mini_sql_skip_ws(src, n, p + 4) } else { 0 }
    let table_res = mini_sql_parse_ident(src, n, p)
    let table_node = mini_sql_result_node(table_res)
    if table_node == 0 {
      mini_sql_error_at("mini_sql parse error: expected table name", mini_sql_result_pos(table_res), host_offset)
    } else {
      p = mini_sql_result_pos(table_res)
    }
    let where_res = mini_sql_parse_where(src, n, p, host_offset)
    let where_node = mini_sql_result_node(where_res)
    p = mini_sql_skip_ws(src, n, mini_sql_result_pos(where_res))
    if p < n {
      mini_sql_error_at("mini_sql parse error: unexpected trailing input", p, host_offset)
    } else { 0 }
    mini_sql_query_new(cols, table_node, where_node, star)
  }
}

fn mini_sql_parse_source(src: i64, n: i64, tt: i64) -[Diagnose]> i64 {
  mini_sql_parse_source_at(src, n, tt, 0)
}

fn mini_sql_table_id(src: i64, table_node: i64) -> i64 {
  if mini_sql_ident_eq(src, table_node, "users") == 1 { mini_sql_table_users() }
  else { if mini_sql_ident_eq(src, table_node, "orders") == 1 { mini_sql_table_orders() }
  else { mini_sql_table_unknown() } }
}

fn mini_sql_column_type(table_id: i64, src: i64, column: i64) -> i64 {
  match table_id {
    1 -> {
      if mini_sql_ident_eq(src, column, "id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "name") == 1 { mini_sql_ty_str() }
      else { if mini_sql_ident_eq(src, column, "active") == 1 { mini_sql_ty_bool() }
      else { mini_sql_ty_unknown() } } }
    }
    2 -> {
      if mini_sql_ident_eq(src, column, "id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "user_id") == 1 { mini_sql_ty_i64() }
      else { if mini_sql_ident_eq(src, column, "total") == 1 { mini_sql_ty_i64() }
      else { mini_sql_ty_unknown() } } }
    }
    _ -> mini_sql_ty_unknown()
  }
}

fn mini_sql_type_error_at(msg: str, pos: i64, host_offset: i64) -[Diagnose]> i64 {
  Diagnose.error(msg, host_offset + pos)
}

fn mini_sql_projection_expr_start(expr: i64) -> i64 {
  if expr == 0 { 0 }
  else {
    match node_tag(expr) {
      702 -> mini_sql_ident_start(expr)
      704 -> node_f1(expr)
      708 -> mini_sql_projection_expr_start(node_f1(expr))
      _ -> 0
    }
  }
}

fn mini_sql_expr_op_is_arithmetic(op: i64) -> i64 {
  if op == mini_sql_expr_add() or op == mini_sql_expr_sub() { 1 }
  else { if op == mini_sql_expr_mul() or op == mini_sql_expr_div() { 1 } else { 0 } }
}

fn mini_sql_catalog_scalar_type(expr: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  if expr == 0 { mini_sql_type_result(mini_sql_ty_unknown(), 0) }
  else {
    match node_tag(expr) {
      702 -> {
        let col_type = mini_sql_column_type(table_id, src, expr)
        if col_type == mini_sql_ty_unknown() {
          mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(expr), host_offset)
          mini_sql_type_result(mini_sql_ty_unknown(), 1)
        } else {
          mini_sql_type_result(col_type, 0)
        }
      }
      704 -> mini_sql_type_result(mini_sql_lit_type(expr), 0)
      708 -> {
        let left = mini_sql_catalog_scalar_type(node_f1(expr), table_id, src, host_offset)
        let right = mini_sql_catalog_scalar_type(node_f2(expr), table_id, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let op = node_f3(expr)
        if mini_sql_expr_op_is_arithmetic(op) == 1 {
          if left_ty != mini_sql_ty_unknown() and left_ty != mini_sql_ty_i64() {
            mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
            errors = errors + 1
          } else { 0 }
          if right_ty != mini_sql_ty_unknown() and right_ty != mini_sql_ty_i64() {
            mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(mini_sql_ty_i64(), errors)
        } else {
          if left_ty != mini_sql_ty_unknown() and left_ty != mini_sql_ty_str() {
            mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
            errors = errors + 1
          } else { 0 }
          if right_ty != mini_sql_ty_unknown() and right_ty != mini_sql_ty_str() {
            mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(mini_sql_ty_str(), errors)
        }
      }
      _ -> mini_sql_type_result(mini_sql_ty_unknown(), 0)
    }
  }
}

fn mini_sql_catalog_projection_type(item: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  mini_sql_catalog_scalar_type(mini_sql_select_item_expr(item), table_id, src, host_offset)
}

fn mini_sql_check_columns(query: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  if mini_sql_query_star(query) == 1 { 0 }
  else {
    let cols = node_f1(query)
    let ncols = nlist_len(cols)
    let mut i = 0
    let mut errors = 0
    while i < ncols {
      let item = nlist_get(cols, i)
      let result = mini_sql_catalog_projection_type(item, table_id, src, host_offset)
      errors = errors + mini_sql_type_result_errors(result)
      i = i + 1
    }
    errors
  }
}

fn mini_sql_lit_type(lit: i64) -> i64 {
  if lit == 0 { mini_sql_ty_unknown() } else { node_f3(lit) }
}

fn mini_sql_lit_weft_type(lit: i64) -> i64 {
  let lit_type = mini_sql_lit_type(lit)
  match lit_type {
    1 -> ty_i64()
    2 -> ty_str()
    3 -> ty_bool()
    _ -> 0
  }
}

fn mini_sql_type_result(ty: i64, errors: i64) -> i64 {
  let r = alloc_bump(16)
  __mem_store64(r, ty)
  __mem_store64(r + 8, errors)
  r
}

fn mini_sql_type_result_ty(r: i64) -> i64 { __mem_load64(r) }
fn mini_sql_type_result_errors(r: i64) -> i64 { __mem_load64(r + 8) }

fn mini_sql_predicate_start(pred: i64) -> i64 {
  if pred == 0 { 0 }
  else {
    match node_tag(pred) {
      702 -> mini_sql_ident_start(pred)
      703 -> mini_sql_projection_expr_start(node_f1(pred))
      704 -> node_f1(pred)
      706 -> mini_sql_predicate_start(node_f1(pred))
      708 -> mini_sql_projection_expr_start(pred)
      _ -> 0
    }
  }
}

fn mini_sql_cmp_is_equality(op: i64) -> i64 {
  if op == mini_sql_cmp_eq() or op == mini_sql_cmp_ne() { 1 } else { 0 }
}

fn mini_sql_cmp_is_relational(op: i64) -> i64 {
  if mini_sql_cmp_is_equality(op) == 1 { 0 } else { 1 }
}

fn mini_sql_catalog_predicate_type(pred: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  if pred == 0 { mini_sql_type_result(mini_sql_ty_unknown(), 0) }
  else {
    match node_tag(pred) {
      702 -> mini_sql_catalog_scalar_type(pred, table_id, src, host_offset)
      703 -> {
        let left_expr = node_f1(pred)
        let right_expr = node_f2(pred)
        let op = node_f3(pred)
        let left = mini_sql_catalog_scalar_type(left_expr, table_id, src, host_offset)
        let right = mini_sql_catalog_scalar_type(right_expr, table_id, src, host_offset)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        if mini_sql_cmp_is_relational(op) == 1 and left_ty != mini_sql_ty_unknown() and right_ty != mini_sql_ty_unknown() and (left_ty != mini_sql_ty_i64() or right_ty != mini_sql_ty_i64()) {
          mini_sql_type_error_at("mini_sql type error: relational predicate requires i64", mini_sql_projection_expr_start(right_expr), host_offset)
          errors = errors + 1
          mini_sql_type_result(mini_sql_ty_bool(), errors)
        } else { if mini_sql_cmp_is_equality(op) == 1 and left_ty != mini_sql_ty_unknown() and right_ty != mini_sql_ty_unknown() and left_ty != right_ty {
          mini_sql_type_error_at("mini_sql type error: predicate type mismatch", mini_sql_projection_expr_start(right_expr), host_offset)
          errors = errors + 1
          mini_sql_type_result(mini_sql_ty_bool(), errors)
        } else {
          mini_sql_type_result(mini_sql_ty_bool(), errors)
        } }
      }
      704 -> mini_sql_catalog_scalar_type(pred, table_id, src, host_offset)
      706 -> {
        let left = mini_sql_catalog_predicate_type(node_f1(pred), table_id, src, host_offset)
        let right = mini_sql_catalog_predicate_type(node_f2(pred), table_id, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        if mini_sql_type_result_ty(left) != mini_sql_ty_unknown() and mini_sql_type_result_ty(left) != mini_sql_ty_bool() {
          mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f1(pred)), host_offset)
          errors = errors + 1
        } else { 0 }
        if mini_sql_type_result_ty(right) != mini_sql_ty_unknown() and mini_sql_type_result_ty(right) != mini_sql_ty_bool() {
          mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f2(pred)), host_offset)
          errors = errors + 1
        } else { 0 }
        mini_sql_type_result(mini_sql_ty_bool(), errors)
      }
      708 -> mini_sql_catalog_scalar_type(pred, table_id, src, host_offset)
      _ -> mini_sql_type_result(mini_sql_ty_unknown(), 0)
    }
  }
}

fn mini_sql_check_where(query: i64, table_id: i64, src: i64, host_offset: i64) -[Diagnose]> i64 {
  let where_node = if query == 0 { 0 } else { node_f3(query) }
  if where_node == 0 { 0 }
  else {
    let result = mini_sql_catalog_predicate_type(where_node, table_id, src, host_offset)
    let mut errors = mini_sql_type_result_errors(result)
    let ty = mini_sql_type_result_ty(result)
    if ty != mini_sql_ty_unknown() and ty != mini_sql_ty_bool() {
      mini_sql_type_error_at("mini_sql type error: predicate expression must be bool", mini_sql_predicate_start(where_node), host_offset)
      errors = errors + 1
    } else { 0 }
    errors
  }
}

fn mini_sql_check_ast_at(query: i64, src: i64, tt: i64, host_offset: i64) -[Diagnose]> i64 {
  let table_node = mini_sql_query_table_node(query)
  let table_id = mini_sql_table_id(src, table_node)
  if table_id == mini_sql_table_unknown() {
    mini_sql_type_error_at("mini_sql type error: unknown table", mini_sql_ident_start(table_node), host_offset)
    1
  } else {
    mini_sql_check_columns(query, table_id, src, host_offset) + mini_sql_check_where(query, table_id, src, host_offset)
  }
}

fn mini_sql_check_ast(query: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  mini_sql_check_ast_at(query, src, tt, 0)
}

fn mini_sql_check_host_columns(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if mini_sql_query_star(query) == 1 { 0 }
  else {
    let cols = node_f1(query)
    let ncols = nlist_len(cols)
    let mut i = 0
    let mut errors = 0
    while i < ncols {
      let item = nlist_get(cols, i)
      let result = mini_sql_host_projection_type(item, table_ty, src, host_offset)
      errors = errors + mini_sql_type_result_errors(result)
      i = i + 1
    }
    errors
  }
}

fn mini_sql_host_scalar_type(expr: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if expr == 0 { mini_sql_type_result(0, 0) }
  else {
    match node_tag(expr) {
      702 -> {
        let col_ty = TypeCheck.resolve_field_type(table_ty, src, mini_sql_ident_start(expr), mini_sql_ident_len(expr))
        if col_ty == 0 {
          mini_sql_type_error_at("mini_sql type error: unknown column", mini_sql_ident_start(expr), host_offset)
          mini_sql_type_result(0, 1)
        } else {
          mini_sql_type_result(col_ty, 0)
        }
      }
      704 -> mini_sql_type_result(mini_sql_lit_weft_type(expr), 0)
      708 -> {
        let left = mini_sql_host_scalar_type(node_f1(expr), table_ty, src, host_offset)
        let right = mini_sql_host_scalar_type(node_f2(expr), table_ty, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let op = node_f3(expr)
        if mini_sql_expr_op_is_arithmetic(op) == 1 {
          if left_ty != 0 {
            let left_i64 = mini_sql_host_type_is_i64(left_ty)
            if left_i64 == 0 {
              mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          if right_ty != 0 {
            let right_i64 = mini_sql_host_type_is_i64(right_ty)
            if right_i64 == 0 {
              mini_sql_type_error_at("mini_sql type error: arithmetic expression requires i64", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          mini_sql_type_result(ty_i64(), errors)
        } else {
          if left_ty != 0 {
            let left_str = mini_sql_host_type_is_str(left_ty)
            if left_str == 0 {
              mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f1(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          if right_ty != 0 {
            let right_str = mini_sql_host_type_is_str(right_ty)
            if right_str == 0 {
              mini_sql_type_error_at("mini_sql type error: concat expression requires str", mini_sql_projection_expr_start(node_f2(expr)), host_offset)
              errors = errors + 1
            } else { 0 }
          } else { 0 }
          mini_sql_type_result(ty_str(), errors)
        }
      }
      _ -> mini_sql_type_result(0, 0)
    }
  }
}

fn mini_sql_host_projection_type(item: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  mini_sql_host_scalar_type(mini_sql_select_item_expr(item), table_ty, src, host_offset)
}

fn mini_sql_host_type_eq(left: i64, right: i64) -[TypeCheck]> i64 {
  if left == 0 or right == 0 { 0 }
  else {
    let lr = TypeCheck.subtype(left, right)
    let rl = TypeCheck.subtype(right, left)
    if lr == 1 and rl == 1 { 1 } else { 0 }
  }
}

fn mini_sql_host_type_is_i64(ty: i64) -[TypeCheck]> i64 {
  mini_sql_host_type_eq(ty, ty_i64())
}

fn mini_sql_host_type_is_bool(ty: i64) -[TypeCheck]> i64 {
  mini_sql_host_type_eq(ty, ty_bool())
}

fn mini_sql_host_type_is_str(ty: i64) -[TypeCheck]> i64 {
  mini_sql_host_type_eq(ty, ty_str())
}

fn mini_sql_host_predicate_type(pred: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  if pred == 0 { mini_sql_type_result(0, 0) }
  else {
    match node_tag(pred) {
      702 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      703 -> {
        let left_expr = node_f1(pred)
        let right_expr = node_f2(pred)
        let op = node_f3(pred)
        let left = mini_sql_host_scalar_type(left_expr, table_ty, src, host_offset)
        let right = mini_sql_host_scalar_type(right_expr, table_ty, src, host_offset)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        if mini_sql_cmp_is_relational(op) == 1 and left_ty != 0 and right_ty != 0 {
          let left_numeric = mini_sql_host_type_is_i64(left_ty)
          let right_numeric = mini_sql_host_type_is_i64(right_ty)
          if left_numeric == 0 or right_numeric == 0 {
            mini_sql_type_error_at("mini_sql type error: relational predicate requires i64", mini_sql_projection_expr_start(right_expr), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(ty_bool(), errors)
        } else { if mini_sql_cmp_is_equality(op) == 1 and left_ty != 0 and right_ty != 0 {
          let same = mini_sql_host_type_eq(left_ty, right_ty)
          if same == 0 {
            mini_sql_type_error_at("mini_sql type error: predicate type mismatch", mini_sql_projection_expr_start(right_expr), host_offset)
            errors = errors + 1
          } else { 0 }
          mini_sql_type_result(ty_bool(), errors)
        } else {
          mini_sql_type_result(ty_bool(), errors)
        } }
      }
      704 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      706 -> {
        let left = mini_sql_host_predicate_type(node_f1(pred), table_ty, src, host_offset)
        let right = mini_sql_host_predicate_type(node_f2(pred), table_ty, src, host_offset)
        let mut errors = mini_sql_type_result_errors(left) + mini_sql_type_result_errors(right)
        let left_ty = mini_sql_type_result_ty(left)
        let right_ty = mini_sql_type_result_ty(right)
        if left_ty != 0 {
          let left_bool = mini_sql_host_type_is_bool(left_ty)
          if left_bool == 0 {
            mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f1(pred)), host_offset)
            errors = errors + 1
          } else { 0 }
        } else { 0 }
        if right_ty != 0 {
          let right_bool = mini_sql_host_type_is_bool(right_ty)
          if right_bool == 0 {
            mini_sql_type_error_at("mini_sql type error: logical predicate operand must be bool", mini_sql_predicate_start(node_f2(pred)), host_offset)
            errors = errors + 1
          } else { 0 }
        } else { 0 }
        mini_sql_type_result(ty_bool(), errors)
      }
      708 -> mini_sql_host_scalar_type(pred, table_ty, src, host_offset)
      _ -> mini_sql_type_result(0, 0)
    }
  }
}

fn mini_sql_check_host_where(query: i64, table_ty: i64, src: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let where_node = if query == 0 { 0 } else { node_f3(query) }
  if where_node == 0 { 0 }
  else {
    let result = mini_sql_host_predicate_type(where_node, table_ty, src, host_offset)
    let mut errors = mini_sql_type_result_errors(result)
    let ty = mini_sql_type_result_ty(result)
    if ty != 0 {
      let is_bool = mini_sql_host_type_is_bool(ty)
      if is_bool == 0 {
        mini_sql_type_error_at("mini_sql type error: predicate expression must be bool", mini_sql_predicate_start(where_node), host_offset)
        errors = errors + 1
      } else { 0 }
    } else { 0 }
    errors
  }
}

fn mini_sql_check_ast_host_at(query: i64, src: i64, tt: i64, host_offset: i64) -[TypeCheck, Diagnose]> i64 {
  let table_node = mini_sql_query_table_node(query)
  let table_ty = TypeCheck.resolve_type(src, mini_sql_ident_start(table_node), mini_sql_ident_len(table_node))
  if table_ty == 0 {
    mini_sql_type_error_at("mini_sql type error: unknown table", mini_sql_ident_start(table_node), host_offset)
    1
  } else {
    mini_sql_check_host_columns(query, table_ty, src, host_offset) + mini_sql_check_host_where(query, table_ty, src, host_offset)
  }
}

fn mini_sql_check_ast_host(query: i64, src: i64, tt: i64) -[TypeCheck, Diagnose]> i64 {
  mini_sql_check_ast_host_at(query, src, tt, 0)
}

impl Grammar for MiniSqlGrammar {
  fn lex(self: i64, source: i64, source_len: i64) -> i64 {
    mini_sql_tokens_new(source_len)
  }

  fn parse_tokens(self: i64, tokens: i64, source: i64, tt: i64) -[Diagnose]> i64 {
    mini_sql_parse_source(source, mini_sql_tokens_source_len(tokens), tt)
  }

  fn parse(self: i64, source: i64, source_len: i64, tt: i64) -[Diagnose]> i64 {
    mini_sql_parse_source(source, source_len, tt)
  }
}

impl TypedGrammar for MiniSqlGrammar {
  fn check(self: i64, fns: i64, source: i64, tt: i64) -[TypeCheck, Diagnose]> i64 {
    mini_sql_check_ast_host(fns, source, tt)
  }
}
