-- compiler/module.weft — semantic module/declaration identity facts.
--
-- module identity keeps logical identity separate from source buffers, physical paths,
-- trust, and backend name hashes. The raw registries below are the bootstrap
-- storage bridge; consumers receive typed facts and must not reconstruct
-- ownership from short-name strings.

use compiler/lib.{*}
use runtime/alloc.{*}
use runtime/memory.{*}

pub(package) type ModuleId {
  NamedModuleId(i64, i64, i64), -- logical path ptr/len, package identity
  AnonymousModuleId(i64)        -- compilation-local anonymous-root ordinal
}

pub(package) type DeclId {
  ModuleDeclId(ModuleId, i64, i64, i64), -- namespace, name ptr/len
  MemberDeclId(DeclId, i64, i64, i64)    -- owner, namespace, name ptr/len
}

pub(package) type DeclVisibility {
  PrivateVisibility,
  PackageVisibility,
  PublicVisibility
}

pub(package) type ModuleImportFact {
  ModuleImportFact(ModuleId, ModuleId, i64, i64, i64) -- selections, visibility code, weak bit
}

pub(package) type ModuleImportCycle {
  NoModuleImportCycle,
  ModuleImportCycle(i64, i64) -- canonical module entries, matching directed import entries
}

pub(package) type ModuleNameResolution {
  ResolvedDeclarationName(DeclId),
  ResolvedModuleName(ModuleId),
  MissingModuleName,
  InvisibleModuleName,
  AmbiguousModuleName,
  WidenedReexportName
}

pub(package) fn module_visibility_private() -> i64 { 0 }
pub(package) fn module_visibility_package() -> i64 { 1 }
pub(package) fn module_visibility_public() -> i64 { 2 }

pub(package) fn module_visibility_from_code(code: i64) -> DeclVisibility {
  if code == module_visibility_public() { PublicVisibility() }
  else { if code == module_visibility_package() { PackageVisibility() }
  else { PrivateVisibility() } }
}

pub(package) fn module_decl_namespace_value() -> i64 { 1 }
pub(package) fn module_decl_namespace_type() -> i64 { 2 }
pub(package) fn module_decl_namespace_effect() -> i64 { 3 }
pub(package) fn module_decl_namespace_trait() -> i64 { 4 }
pub(package) fn module_decl_namespace_inherent_method() -> i64 { 5 }
pub(package) fn module_decl_namespace_trait_method() -> i64 { 6 }
pub(package) fn module_decl_namespace_associated_type() -> i64 { 7 }
pub(package) fn module_decl_namespace_effect_operation() -> i64 { 8 }
pub(package) fn module_decl_namespace_constructor() -> i64 { 9 }
pub(package) fn module_decl_namespace_record_field() -> i64 { 10 }

pub(package) fn module_scope_kind_issue() -> i64 { 0 }
pub(package) fn module_scope_kind_declaration() -> i64 { 1 }
pub(package) fn module_scope_kind_module() -> i64 { 2 }

pub(package) fn module_scope_status_resolved() -> i64 { 0 }
pub(package) fn module_scope_status_ambiguous() -> i64 { 1 }
pub(package) fn module_scope_status_missing() -> i64 { 2 }
pub(package) fn module_scope_status_invisible() -> i64 { 3 }
pub(package) fn module_scope_status_widened_reexport() -> i64 { 4 }

-- ttable-owned registry slots. codegen's ttable_new initializes them through
-- module_fact_tables_init; the producer lives here rather than in lookup or
-- native emission.
pub(package) fn module_fact_modules(tt: i64) -> i64 { mem_load64_at(tt + 112, 0) }
pub(package) fn module_fact_decls(tt: i64) -> i64 { mem_load64_at(tt + 120, 0) }
pub(package) fn module_fact_imports(tt: i64) -> i64 { mem_load64_at(tt + 128, 0) }
pub(package) fn module_fact_scopes(tt: i64) -> i64 { mem_load64_at(tt + 136, 0) }

pub(package) fn module_fact_tables_init(tt: i64) -> i64 {
  mem_store64_at(tt + 112, 0, nlist_new())
  mem_store64_at(tt + 120, 0, nlist_new())
  mem_store64_at(tt + 128, 0, nlist_new())
  mem_store64_at(tt + 136, 0, nlist_new())
  0
}

pub(package) fn module_path_has_weft_suffix(path_ptr: i64, path_len: i64) -> i64 {
  if path_len < 5 { 0 }
  else { src_eq_at(path_ptr, path_len - 5, __str_ptr(".weft"), 0, 5) }
}

pub(package) fn module_logical_path_len(path_ptr: i64, path_len: i64) -> i64 {
  if module_path_has_weft_suffix(path_ptr, path_len) == 1 { path_len - 5 }
  else { path_len }
}

pub(package) fn module_identity_hash(path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  -- FNV-1a is only a lookup accelerator. Equality always compares the full
  -- package/path identity, so collisions cannot merge modules.
  let mut h = 2166136261 bxor package_id
  for i in 0..path_len {
    h = (h bxor mem_load8_at(path_ptr, i)) * 16777619
  }
  h
}

-- Module entry: source, path ptr, logical len, package id, anonymous ordinal,
-- cached hash, scope state, cached function pairs, module-handler template,
-- module-default handler list = 80 bytes. The pair cache
-- separates "interface parsed" from "body present in this code unit": an
-- interface-only prelude load may be followed by an explicit import that
-- needs the already-parsed implementation closure.
pub(package) fn module_fact_entry_source(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn module_fact_entry_path_ptr(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn module_fact_entry_path_len(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
pub(package) fn module_fact_entry_package(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn module_fact_entry_anonymous(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
pub(package) fn module_fact_entry_hash(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn module_fact_entry_scope_state(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
pub(package) fn module_fact_entry_function_pairs(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }
pub(package) fn module_fact_entry_handler_implementation(entry: i64) -> i64 { mem_load64_at(entry + 64, 0) }
pub(package) fn module_fact_entry_default_handlers(entry: i64) -> i64 { mem_load64_at(entry + 72, 0) }

pub(package) fn module_fact_set_handler_implementation(entry: i64, implementation: i64) -> i64 {
  mem_store64_at(entry + 64, 0, implementation)
  implementation
}

pub(package) fn module_fact_add_default_handler(entry: i64, handler: i64) -> i64 {
  nlist_add(module_fact_entry_default_handlers(entry), handler)
  handler
}

pub(package) fn module_fact_set_default_handlers(entry: i64, handlers: i64) -> i64 {
  mem_store64_at(entry + 72, 0, handlers)
  handlers
}

pub(package) fn module_fact_find_source(tt: i64, src: i64) -> i64 {
  let modules = module_fact_modules(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(modules) and result == 0 {
    let entry = nlist_get(modules, i)
    if module_fact_entry_source(entry) == src { result = entry }
    else { i = i + 1 }
  }
  result
}

pub(package) fn module_fact_path_eq(entry: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let logical_len = module_logical_path_len(path_ptr, path_len)
  if module_fact_entry_anonymous(entry) != 0 { 0 }
  else { if module_fact_entry_package(entry) != package_id { 0 }
  else { if module_fact_entry_path_len(entry) != logical_len { 0 }
  else { src_eq_at(module_fact_entry_path_ptr(entry), 0, path_ptr, 0, logical_len) } } }
}

pub(package) fn module_fact_find_path(tt: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let modules = module_fact_modules(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(modules) and result == 0 {
    let entry = nlist_get(modules, i)
    if module_fact_path_eq(entry, path_ptr, path_len, package_id) == 1 { result = entry }
    else { i = i + 1 }
  }
  result
}

pub(package) fn module_fact_upgrade_named(entry: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let logical_len = module_logical_path_len(path_ptr, path_len)
  mem_store64_at(entry + 8, 0, path_ptr)
  mem_store64_at(entry + 16, 0, logical_len)
  mem_store64_at(entry + 24, 0, package_id)
  mem_store64_at(entry + 32, 0, 0)
  mem_store64_at(entry + 40, 0, module_identity_hash(path_ptr, logical_len, package_id))
  entry
}

pub(package) fn module_fact_register_source(tt: i64, src: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let existing = module_fact_find_source(tt, src)
  if existing != 0 {
    if path_len > 0 and module_fact_entry_anonymous(existing) != 0 {
      module_fact_upgrade_named(existing, path_ptr, path_len, package_id)
    } else { existing }
  } else {
    let modules = module_fact_modules(tt)
    let entry = alloc_words(10)
    mem_store64_at(entry, 0, src)
    if path_len > 0 {
      module_fact_upgrade_named(entry, path_ptr, path_len, package_id)
    } else {
      let ordinal = nlist_len(modules) + 1
      mem_store64_at(entry + 8, 0, 0)
      mem_store64_at(entry + 16, 0, 0)
      mem_store64_at(entry + 24, 0, package_id)
      mem_store64_at(entry + 32, 0, ordinal)
      mem_store64_at(entry + 40, 0, 0 - ordinal)
    }
    mem_store64_at(entry + 48, 0, 0)
    mem_store64_at(entry + 56, 0, nlist_new())
    mem_store64_at(entry + 64, 0, 0)
    mem_store64_at(entry + 72, 0, nlist_new())
    nlist_add(modules, entry)
    entry
  }
}

pub(package) fn module_fact_cache_function_pair(tt: i64, src: i64, pair: i64) -> i64 {
  let module_entry = module_fact_register_source(tt, src, 0, 0, 0)
  nlist_add(module_fact_entry_function_pairs(module_entry), pair)
  pair
}

pub(package) fn module_fact_pair_list_contains(pairs: i64, pair: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(pairs) and found == 0 {
    if nlist_get(pairs, i) == pair { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn module_fact_append_function_closure_from(tt: i64, fns: i64, module_entry: i64, visited: i64) -> i64 {
  if module_fact_pair_list_contains(visited, module_entry) == 1 { fns }
  else {
    nlist_add(visited, module_entry)
    let imports = module_fact_imports(tt)
    for i in 0..nlist_len(imports) {
      let import_entry = nlist_get(imports, i)
      if module_import_fact_importer(import_entry) == module_entry {
        module_fact_append_function_closure_from(tt, fns, module_import_fact_target(import_entry), visited)
      } else { 0 }
    }
    let pairs = module_fact_entry_function_pairs(module_entry)
    for i in 0..nlist_len(pairs) {
      let pair = nlist_get(pairs, i)
      if module_fact_pair_list_contains(fns, pair) == 0 { nlist_add(fns, pair) } else { 0 }
    }
    fns
  }
}

-- Materialise a cached module implementation exactly once in the current
-- compilation unit. Dependencies precede the module, matching fresh parse
-- order and preserving the existing forward-reference discipline.
pub(package) fn module_fact_append_function_closure(tt: i64, fns: i64, module_entry: i64) -> i64 {
  module_fact_append_function_closure_from(tt, fns, module_entry, nlist_new())
}

pub(package) fn module_id_from_entry(entry: i64) -> ModuleId {
  if module_fact_entry_anonymous(entry) != 0 {
    AnonymousModuleId(module_fact_entry_anonymous(entry))
  } else {
    NamedModuleId(module_fact_entry_path_ptr(entry), module_fact_entry_path_len(entry), module_fact_entry_package(entry))
  }
}

pub(package) fn module_fact_module_count(tt: i64) -> i64 { nlist_len(module_fact_modules(tt)) }
pub(package) fn module_fact_decl_count(tt: i64) -> i64 { nlist_len(module_fact_decls(tt)) }
pub(package) fn module_fact_import_count(tt: i64) -> i64 { nlist_len(module_fact_imports(tt)) }
pub(package) fn module_fact_scope_count(tt: i64) -> i64 { nlist_len(module_fact_scopes(tt)) }
pub(package) fn module_fact_module_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_modules(tt), index) }
pub(package) fn module_fact_decl_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_decls(tt), index) }
pub(package) fn module_fact_import_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_imports(tt), index) }
pub(package) fn module_fact_scope_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_scopes(tt), index) }

-- The declaration and scope registries are producer-owned nlists. Their
-- otherwise-unused cache word carries a hash tree whose leaves own collision
-- buckets; equality is always rechecked against the complete semantic key.
-- This keeps hashes as accelerators only and preserves DeclId/scope identity
-- under adversarial collisions.
pub(package) fn module_fact_index_find_node(tree: i64, key: i64) -> i64 {
  let mut current = tree
  let mut result = 0
  while current != 0 and result == 0 {
    let current_key = node_f1(current)
    if key == current_key { result = current }
    else { if key < current_key { current = node_f3(current) } else { current = node_f4(current) } }
  }
  result
}

pub(package) fn module_fact_index_insert(tree: i64, key: i64, entry: i64) -> i64 {
  let existing = module_fact_index_find_node(tree, key)
  if existing != 0 {
    nlist_add(node_f2(existing), entry)
    tree
  } else {
    let bucket = nlist_new_capacity(1)
    nlist_add(bucket, entry)
    let leaf = node_new(0, key, bucket, 0, 0)
    if tree == 0 { leaf }
    else {
      let mut current = tree
      let mut done = 0
      while done == 0 {
        if key < node_f1(current) {
          if node_f3(current) == 0 { mem_store64_at(current, 24, leaf) done = 1 }
          else { current = node_f3(current) }
        } else {
          if node_f4(current) == 0 { mem_store64_at(current, 32, leaf) done = 1 }
          else { current = node_f4(current) }
        }
      }
      tree
    }
  }
}

pub(package) fn module_fact_index_add(registry: i64, key: i64, entry: i64) -> i64 {
  let root = mem_load64_at(registry, 24)
  mem_store64_at(registry, 24, module_fact_index_insert(root, key, entry))
  entry
}

-- Declaration entry: module entry, owner declaration entry, namespace,
-- absolute name ptr, name len, visibility, source span, derived native key,
-- bootstrap function-pair bridge, constant fact = 80 bytes. The derived
-- native key and payload bridges are consumers of DeclId, never part of
-- semantic identity.
pub(package) fn module_decl_fact_register(tt: i64, src: i64, owner: i64, namespace: i64, name_start: i64, name_len: i64, visibility: i64) -> i64 {
  let module_entry = module_fact_register_source(tt, src, 0, 0, 0)
  let entry = alloc_words(10)
  mem_store64_at(entry, 0, module_entry)
  mem_store64_at(entry + 8, 0, owner)
  mem_store64_at(entry + 16, 0, namespace)
  mem_store64_at(entry + 24, 0, src + name_start)
  mem_store64_at(entry + 32, 0, name_len)
  mem_store64_at(entry + 40, 0, visibility)
  mem_store64_at(entry + 48, 0, src + name_start)
  mem_store64_at(entry + 56, 0, 0)
  mem_store64_at(entry + 64, 0, 0)
  mem_store64_at(entry + 72, 0, 0)
  let decls = module_fact_decls(tt)
  nlist_add(decls, entry)
  -- The module-wide query intentionally sees owned members as well as roots;
  -- exact member consumers additionally query by owner DeclId.
  module_fact_index_add(decls, module_decl_fact_lookup_key(module_entry, 0, namespace, src + name_start, name_len), entry)
  if owner != 0 { module_fact_index_add(decls, module_decl_fact_lookup_key(0, owner, namespace, src + name_start, name_len), entry) } else { 0 }
  entry
}

-- Register a compiler-produced declaration whose semantic spelling is owned
-- by a fact source (for example a package manifest), not by the module's text
-- buffer. It remains private to the exact module and deliberately has no
-- source range pretending that generated syntax existed.
pub(package) fn module_decl_fact_register_synthetic_private(tt: i64, src: i64, namespace: i64, name_ptr: i64, name_len: i64) -> i64 {
  let entry = module_decl_fact_register(tt, src, 0, namespace, name_ptr - src, name_len, module_visibility_private())
  mem_store64_at(entry + 48, 0, 0)
  entry
}

pub(package) fn module_decl_fact_id(entry: i64) -> DeclId {
  let module_id = module_id_from_entry(mem_load64_at(entry, 0))
  let owner = mem_load64_at(entry + 8, 0)
  let namespace = mem_load64_at(entry + 16, 0)
  let name_ptr = mem_load64_at(entry + 24, 0)
  let name_len = mem_load64_at(entry + 32, 0)
  if owner == 0 { ModuleDeclId(module_id, namespace, name_ptr, name_len) }
  else { MemberDeclId(module_decl_fact_id(owner), namespace, name_ptr, name_len) }
}

pub(package) fn module_decl_fact_name_eq(entry: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  if mem_load64_at(entry + 16, 0) != namespace { 0 }
  else { if mem_load64_at(entry + 32, 0) != name_len { 0 }
  else { src_eq_at(mem_load64_at(entry + 24, 0), 0, name_src + name_start, 0, name_len) } }
}

pub(package) fn module_decl_fact_lookup_key(module_entry: i64, owner: i64, namespace: i64, name_ptr: i64, name_len: i64) -> i64 {
  let identity = if owner != 0 { owner } else { module_entry }
  module_identity_hash(name_ptr, name_len, identity * 131 + namespace * 17)
}

pub(package) fn module_decl_fact_find_indexed(tt: i64, module_entry: i64, owner: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let decls = module_fact_decls(tt)
  let key = module_decl_fact_lookup_key(module_entry, owner, namespace, name_src + name_start, name_len)
  let indexed = module_fact_index_find_node(mem_load64_at(decls, 24), key)
  if indexed == 0 { 0 }
  else {
    let bucket = node_f2(indexed)
    let mut i = 0
    let mut result = 0
    while i < nlist_len(bucket) and result == 0 {
      let entry = nlist_get(bucket, i)
      let identity_ok = if owner != 0 { module_decl_fact_owner(entry) == owner }
        else { module_decl_fact_module(entry) == module_entry }
      if identity_ok and module_decl_fact_name_eq(entry, namespace, name_src, name_start, name_len) == 1 { result = entry }
      else { i = i + 1 }
    }
    result
  }
}

pub(package) fn module_decl_fact_find(tt: i64, src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { 0 }
  else { module_decl_fact_find_indexed(tt, module_entry, 0, namespace, name_src, name_start, name_len) }
}

pub(package) fn module_decl_fact_find_member(tt: i64, owner: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  if owner == 0 { 0 }
  else { module_decl_fact_find_indexed(tt, 0, owner, namespace, name_src, name_start, name_len) }
}

pub(package) fn module_decl_fact_visibility(entry: i64) -> DeclVisibility {
  module_visibility_from_code(mem_load64_at(entry + 40, 0))
}

pub(package) fn module_decl_fact_visibility_code(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn module_decl_fact_namespace(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
pub(package) fn module_decl_fact_owner(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn module_decl_fact_module(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn module_decl_fact_source(entry: i64) -> i64 { module_fact_entry_source(module_decl_fact_module(entry)) }
pub(package) fn module_decl_fact_name_ptr(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn module_decl_fact_name_len(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
pub(package) fn module_decl_fact_source_span_ptr(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }

pub(package) fn module_decl_fact_visible_from(tt: i64, entry: i64, caller_module: i64) -> i64 {
  if entry == 0 or caller_module == 0 { 0 }
  else { if module_decl_fact_module(entry) == caller_module { 1 }
  else {
    let owner = module_decl_fact_owner(entry)
    -- Constructors, trait methods, and associated types inherit their owner.
    -- Inherent methods and effect operations may narrow their own visibility;
    -- an exported effect atom can therefore keep implementation operations
    -- package-private without leaking their carrier types.
    let namespace = module_decl_fact_namespace(entry)
    let visibility_entry = if owner != 0 and namespace != module_decl_namespace_inherent_method() and namespace != module_decl_namespace_effect_operation() { owner } else { entry }
    if module_decl_fact_visibility_code(visibility_entry) == module_visibility_public() { 1 }
    else { if module_decl_fact_visibility_code(visibility_entry) == module_visibility_package() and module_scope_same_package(module_decl_fact_module(visibility_entry), caller_module) == 1 { 1 }
    else { 0 } }
  } } }
}

pub(package) fn module_decl_fact_native_key_or(entry: i64, default: i64) -> i64 {
  if entry == 0 or mem_load64_at(entry + 56, 0) == 0 { default }
  else { mem_load64_at(entry + 56, 0) }
}

pub(package) fn module_decl_fact_derived_native_key(entry: i64, name_hash: i64) -> i64 {
  if entry == 0 { name_hash }
  else {
    let module_hash = module_fact_entry_hash(module_decl_fact_module(entry))
    let owner = module_decl_fact_owner(entry)
    let owner_key = if owner == 0 { 0 } else { module_decl_fact_derived_native_key(owner, name_hash) }
    let mixed = name_hash * 1000003 + module_hash * 8191 + module_decl_fact_namespace(entry) * 131 + owner_key * 17 + 32452843
    if mixed == 0 { 49979687 } else { mixed }
  }
}

pub(package) fn module_decl_fact_mark_native_collision(entry: i64, name_hash: i64) -> i64 {
  if entry == 0 { name_hash }
  else {
    let existing = mem_load64_at(entry + 56, 0)
    if existing != 0 { existing }
    else {
      let key = module_decl_fact_derived_native_key(entry, name_hash)
      mem_store64_at(entry + 56, 0, key)
      key
    }
  }
}

pub(package) fn module_decl_fact_bind_function_pair(entry: i64, pair: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    mem_store64_at(entry + 64, 0, pair)
    pair
  }
}

pub(package) fn module_decl_fact_function_pair(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 64, 0) }
}

-- Constant fact: declared type, parsed initializer, evaluation state,
-- canonical evaluated value. Evaluation states are declaration-identity
-- facts so forward references and cycles never depend on source order.
pub(package) fn module_constant_state_unvisited() -> i64 { 0 }
pub(package) fn module_constant_state_resolving() -> i64 { 1 }
pub(package) fn module_constant_state_resolved() -> i64 { 2 }
pub(package) fn module_constant_state_failed() -> i64 { 3 }

pub(package) fn module_constant_fact_new(declared_ty: i64, initializer: i64) -> i64 {
  node_new(0, declared_ty, initializer, module_constant_state_unvisited(), 0)
}

pub(package) fn module_constant_fact_declared_type(fact: i64) -> i64 { node_f1(fact) }
pub(package) fn module_constant_fact_initializer(fact: i64) -> i64 { node_f2(fact) }
pub(package) fn module_constant_fact_state(fact: i64) -> i64 { node_f3(fact) }
pub(package) fn module_constant_fact_value(fact: i64) -> i64 { node_f4(fact) }

pub(package) fn module_constant_fact_set_declared_type(fact: i64, ty: i64) -> i64 {
  mem_store64_at(fact, 8, ty)
  ty
}

pub(package) fn module_constant_fact_set_state(fact: i64, state: i64) -> i64 {
  mem_store64_at(fact, 24, state)
  state
}

pub(package) fn module_constant_fact_set_value(fact: i64, value: i64) -> i64 {
  mem_store64_at(fact, 32, value)
  value
}

pub(package) fn module_decl_fact_bind_constant_fact(entry: i64, fact: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    mem_store64_at(entry + 72, 0, fact)
    fact
  }
}

pub(package) fn module_decl_fact_constant_fact(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 72, 0) }
}

-- Import entry: importer module, target module, selections, alias ptr/len,
-- re-export visibility, weak-precedence bit, source offset = 64 bytes. Parsed
-- edges carry their `use` offset; compiler-synthesized edges use -1.
pub(package) fn module_import_fact_register(tt: i64, importer_src: i64, target_module: i64, selections: i64, alias_ptr: i64, alias_len: i64, visibility: i64, weak: i64) -> i64 {
  module_import_fact_register_at(tt, importer_src, target_module, selections, alias_ptr, alias_len, visibility, weak, 0 - 1)
}

pub(package) fn module_import_fact_register_at(tt: i64, importer_src: i64, target_module: i64, selections: i64, alias_ptr: i64, alias_len: i64, visibility: i64, weak: i64, source_offset: i64) -> i64 {
  let entry = alloc_words(8)
  mem_store64_at(entry, 0, module_fact_register_source(tt, importer_src, 0, 0, 0))
  mem_store64_at(entry + 8, 0, target_module)
  mem_store64_at(entry + 16, 0, selections)
  mem_store64_at(entry + 24, 0, alias_ptr)
  mem_store64_at(entry + 32, 0, alias_len)
  mem_store64_at(entry + 40, 0, visibility)
  mem_store64_at(entry + 48, 0, weak)
  mem_store64_at(entry + 56, 0, source_offset)
  nlist_add(module_fact_imports(tt), entry)
  entry
}

pub(package) fn module_import_fact_value(entry: i64) -> ModuleImportFact {
  ModuleImportFact(
    module_id_from_entry(mem_load64_at(entry, 0)),
    module_id_from_entry(mem_load64_at(entry + 8, 0)),
    mem_load64_at(entry + 16, 0),
    mem_load64_at(entry + 40, 0),
    mem_load64_at(entry + 48, 0)
  )
}

pub(package) fn module_import_fact_selection_count(entry: i64) -> i64 { nlist_len(mem_load64_at(entry + 16, 0)) }
pub(package) fn module_import_fact_selection_at(entry: i64, index: i64) -> i64 { nlist_get(mem_load64_at(entry + 16, 0), index) }
pub(package) fn module_import_fact_alias_eq(entry: i64, expected: str) -> i64 {
  let alias_ptr = mem_load64_at(entry + 24, 0)
  let alias_len = mem_load64_at(entry + 32, 0)
  if alias_len != __str_len(expected) { 0 }
  else { src_eq_at(alias_ptr, 0, __str_ptr(expected), 0, alias_len) }
}
pub(package) fn module_import_fact_visibility_code(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn module_import_fact_is_weak(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
pub(package) fn module_import_fact_importer(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn module_import_fact_target(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn module_import_fact_alias_ptr(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn module_import_fact_alias_len(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
pub(package) fn module_import_fact_source_offset(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }

pub(package) fn module_entry_list_index(entries: i64, wanted: i64) -> i64 {
  let mut i = 0
  let mut result = 0 - 1
  while i < nlist_len(entries) and result < 0 {
    if nlist_get(entries, i) == wanted { result = i } else { i = i + 1 }
  }
  result
}

pub(package) fn module_entry_list_contains(entries: i64, wanted: i64) -> i64 {
  if module_entry_list_index(entries, wanted) >= 0 { 1 } else { 0 }
}

pub(package) fn module_graph_reaches_from(tt: i64, current: i64, target: i64, visited: i64) -> i64 {
  if current == target { 1 }
  else { if module_entry_list_contains(visited, current) == 1 { 0 }
  else {
    nlist_add(visited, current)
    let imports = module_fact_imports(tt)
    let mut i = 0
    let mut found = 0
    while i < nlist_len(imports) and found == 0 {
      let edge = nlist_get(imports, i)
      if module_import_fact_importer(edge) == current {
        found = module_graph_reaches_from(tt, module_import_fact_target(edge), target, visited)
      } else { 0 }
      i = i + 1
    }
    found
  } }
}

pub(package) fn module_graph_reaches(tt: i64, source: i64, target: i64) -> i64 {
  if source == 0 or target == 0 { 0 }
  else { module_graph_reaches_from(tt, source, target, nlist_new()) }
}

pub(package) fn module_entry_identity_compare(a: i64, b: i64) -> i64 {
  let a_anon = module_fact_entry_anonymous(a)
  let b_anon = module_fact_entry_anonymous(b)
  if a_anon != 0 or b_anon != 0 {
    if a_anon == b_anon { 0 }
    else { if a_anon == 0 { 0 - 1 }
    else { if b_anon == 0 { 1 }
    else { if a_anon < b_anon { 0 - 1 } else { 1 } } } }
  } else {
    let a_package = module_fact_entry_package(a)
    let b_package = module_fact_entry_package(b)
    if a_package < b_package { 0 - 1 }
    else { if a_package > b_package { 1 }
    else {
      let a_ptr = module_fact_entry_path_ptr(a)
      let b_ptr = module_fact_entry_path_ptr(b)
      let a_len = module_fact_entry_path_len(a)
      let b_len = module_fact_entry_path_len(b)
      let limit = if a_len < b_len { a_len } else { b_len }
      let mut i = 0
      let mut result = 0
      while i < limit and result == 0 {
        let a_ch = mem_load8_at(a_ptr, i)
        let b_ch = mem_load8_at(b_ptr, i)
        if a_ch < b_ch { result = 0 - 1 }
        else { if a_ch > b_ch { result = 1 } else { i = i + 1 } }
      }
      if result != 0 { result }
      else { if a_len < b_len { 0 - 1 } else { if a_len > b_len { 1 } else { 0 } } }
    } }
  }
}

pub(package) fn module_import_cycle_is_present(cycle: ModuleImportCycle) -> i64 {
  match cycle {
    NoModuleImportCycle -> 0
    ModuleImportCycle(modules, edges) -> 1
  }
}

pub(package) fn module_import_cycle_count(cycle: ModuleImportCycle) -> i64 {
  match cycle {
    NoModuleImportCycle -> 0
    ModuleImportCycle(modules, edges) -> nlist_len(modules)
  }
}

pub(package) fn module_import_cycle_module_at(cycle: ModuleImportCycle, index: i64) -> i64 {
  match cycle {
    NoModuleImportCycle -> 0
    ModuleImportCycle(modules, edges) -> nlist_get(modules, index)
  }
}

pub(package) fn module_import_cycle_edge_at(cycle: ModuleImportCycle, index: i64) -> i64 {
  match cycle {
    NoModuleImportCycle -> 0
    ModuleImportCycle(modules, edges) -> nlist_get(edges, index)
  }
}

-- Rotate a discovered cycle to its lexicographically least logical ModuleId.
-- The matching edge at index i always runs modules[i] -> modules[i+1].
pub(package) fn module_import_cycle_canonical(modules: i64, edges: i64) -> ModuleImportCycle {
  let count = nlist_len(modules)
  if count == 0 { NoModuleImportCycle }
  else {
    let mut first = 0
    for i in 1..count {
      if module_entry_identity_compare(nlist_get(modules, i), nlist_get(modules, first)) < 0 { first = i } else { 0 }
    }
    let canonical_modules = nlist_new_capacity(count)
    let canonical_edges = nlist_new_capacity(count)
    for i in 0..count {
      let source_index = (first + i) % count
      nlist_add(canonical_modules, nlist_get(modules, source_index))
      nlist_add(canonical_edges, nlist_get(edges, source_index))
    }
    ModuleImportCycle(canonical_modules, canonical_edges)
  }
}

pub(package) fn module_import_cycle_from_back_edge(path_modules: i64, path_edges: i64, target_index: i64, closing_edge: i64) -> ModuleImportCycle {
  let modules = nlist_new()
  let edges = nlist_new()
  for i in target_index..nlist_len(path_modules) {
    nlist_add(modules, nlist_get(path_modules, i))
    if i < nlist_len(path_edges) { nlist_add(edges, nlist_get(path_edges, i)) } else { 0 }
  }
  nlist_add(edges, closing_edge)
  module_import_cycle_canonical(modules, edges)
}

pub(package) fn module_graph_find_cycle_from(tt: i64, module_entry: i64, finished: i64, path_modules: i64, path_edges: i64) -> ModuleImportCycle {
  if module_entry_list_contains(finished, module_entry) == 1 { NoModuleImportCycle }
  else {
    nlist_add(path_modules, module_entry)
    let imports = module_fact_imports(tt)
    let mut i = 0
    let mut cycle = NoModuleImportCycle
    while i < nlist_len(imports) and module_import_cycle_is_present(cycle) == 0 {
      let edge = nlist_get(imports, i)
      if module_import_fact_importer(edge) != module_entry { i = i + 1 }
      else {
        let target = module_import_fact_target(edge)
        let active_index = module_entry_list_index(path_modules, target)
        if active_index >= 0 {
          cycle = module_import_cycle_from_back_edge(path_modules, path_edges, active_index, edge)
        } else { if module_entry_list_contains(finished, target) == 1 {
          i = i + 1
        } else {
          nlist_add(path_edges, edge)
          cycle = module_graph_find_cycle_from(tt, target, finished, path_modules, path_edges)
          nlist_set_len(path_edges, nlist_len(path_edges) - 1)
          i = i + 1
        } }
      }
    }
    nlist_set_len(path_modules, nlist_len(path_modules) - 1)
    if module_entry_list_contains(finished, module_entry) == 0 { nlist_add(finished, module_entry) } else { 0 }
    cycle
  }
}

-- Producer-owned graph fact. Ordinary, re-export, weak-prelude, and
-- compiler-synthesized edges are deliberately indistinguishable here.
pub(package) fn module_graph_find_cycle(tt: i64) -> ModuleImportCycle {
  let finished = nlist_new()
  let modules = module_fact_modules(tt)
  let mut i = 0
  let mut cycle = NoModuleImportCycle
  while i < nlist_len(modules) and module_import_cycle_is_present(cycle) == 0 {
    cycle = module_graph_find_cycle_from(tt, nlist_get(modules, i), finished, nlist_new(), nlist_new())
    i = i + 1
  }
  cycle
}

-- The otherwise-unused import-list index cell caches audit progress. It never
-- participates in graph semantics; it only prevents parse/check handler
-- configurations from reporting the same cycle twice.
pub(package) fn module_graph_audit_state(tt: i64) -> i64 {
  let imports = module_fact_imports(tt)
  let existing = mem_load64_at(imports, 24)
  if existing != 0 { existing }
  else {
    let state = node_new(0, 0, 0, 0, 0)
    mem_store64_at(imports, 24, state)
    state
  }
}

pub(package) fn module_graph_audit_needed(tt: i64) -> i64 {
  let state = module_graph_audit_state(tt)
  if node_f1(state) != module_fact_import_count(tt) and node_f2(state) == 0 { 1 } else { 0 }
}

pub(package) fn module_graph_mark_audited(tt: i64, reported_cycle: i64) -> i64 {
  let state = module_graph_audit_state(tt)
  mem_store64_at(state + 8, 0, module_fact_import_count(tt))
  if reported_cycle == 1 { mem_store64_at(state + 16, 0, 1) } else { 0 }
  state
}

-- A module-scope entry is the producer-owned resolution fact for one spelling:
-- scope module, spelling ptr/len, kind, target decl/module, originating import,
-- effective export visibility, status, conflicting target/import, and an
-- audit marker = 88 bytes. Issue entries have kind=0 and retain the failed
-- candidate (and its ambiguity peer when one exists).
pub(package) fn module_scope_entry_module(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn module_scope_entry_name_ptr(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
pub(package) fn module_scope_entry_name_len(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
pub(package) fn module_scope_entry_kind(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
pub(package) fn module_scope_entry_target(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
pub(package) fn module_scope_entry_import(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
pub(package) fn module_scope_entry_visibility(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
pub(package) fn module_scope_entry_status(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }
pub(package) fn module_scope_entry_conflict(entry: i64) -> i64 { mem_load64_at(entry + 64, 0) }
pub(package) fn module_scope_entry_conflict_import(entry: i64) -> i64 { mem_load64_at(entry + 72, 0) }
pub(package) fn module_scope_entry_is_diagnosed(entry: i64) -> i64 { mem_load64_at(entry + 80, 0) }
pub(package) fn module_scope_entry_mark_diagnosed(entry: i64) -> i64 { mem_store64_at(entry + 80, 0, 1) }

pub(package) fn module_scope_entry_is_weak(entry: i64) -> i64 {
  let import_entry = module_scope_entry_import(entry)
  if import_entry == 0 { 0 } else { module_import_fact_is_weak(import_entry) }
}

pub(package) fn module_scope_name_eq(entry: i64, module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  if module_scope_entry_module(entry) != module_entry { 0 }
  else { if module_scope_entry_name_len(entry) != name_len { 0 }
  else { src_eq_at(module_scope_entry_name_ptr(entry), 0, name_ptr, 0, name_len) } }
}

pub(package) fn module_scope_lookup_key(module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  module_identity_hash(name_ptr, name_len, module_entry * 131)
}

pub(package) fn module_scope_find_binding(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  let scopes = module_fact_scopes(tt)
  let indexed = module_fact_index_find_node(mem_load64_at(scopes, 24), module_scope_lookup_key(module_entry, name_ptr, name_len))
  if indexed == 0 { 0 }
  else {
    let bucket = node_f2(indexed)
    let mut i = 0
    let mut result = 0
    while i < nlist_len(bucket) and result == 0 {
      let entry = nlist_get(bucket, i)
      if module_scope_entry_kind(entry) != module_scope_kind_issue() and module_scope_name_eq(entry, module_entry, name_ptr, name_len) == 1 { result = entry }
      else { i = i + 1 }
    }
    result
  }
}

pub(package) fn module_scope_find_issue(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, status: i64) -> i64 {
  let scopes = module_fact_scopes(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(scopes) and result == 0 {
    let entry = nlist_get(scopes, i)
    if module_scope_entry_kind(entry) == module_scope_kind_issue() and module_scope_entry_status(entry) == status and module_scope_name_eq(entry, module_entry, name_ptr, name_len) == 1 {
      result = entry
    } else { i = i + 1 }
  }
  result
}

pub(package) fn module_scope_new_entry(module_entry: i64, name_ptr: i64, name_len: i64, kind: i64, target: i64, import_entry: i64, visibility: i64, status: i64) -> i64 {
  let entry = alloc_words(11)
  mem_store64_at(entry, 0, module_entry)
  mem_store64_at(entry + 8, 0, name_ptr)
  mem_store64_at(entry + 16, 0, name_len)
  mem_store64_at(entry + 24, 0, kind)
  mem_store64_at(entry + 32, 0, target)
  mem_store64_at(entry + 40, 0, import_entry)
  mem_store64_at(entry + 48, 0, visibility)
  mem_store64_at(entry + 56, 0, status)
  mem_store64_at(entry + 64, 0, 0)
  mem_store64_at(entry + 72, 0, 0)
  mem_store64_at(entry + 80, 0, 0)
  entry
}

pub(package) fn module_scope_add_binding(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, kind: i64, target: i64, import_entry: i64, visibility: i64) -> i64 {
  let existing = module_scope_find_binding(tt, module_entry, name_ptr, name_len)
  if existing == 0 {
    let entry = module_scope_new_entry(module_entry, name_ptr, name_len, kind, target, import_entry, visibility, module_scope_status_resolved())
    let scopes = module_fact_scopes(tt)
    nlist_add(scopes, entry)
    module_fact_index_add(scopes, module_scope_lookup_key(module_entry, name_ptr, name_len), entry)
    entry
  } else {
    let existing_weak = module_scope_entry_is_weak(existing)
    let incoming_weak = if import_entry == 0 { 0 } else { module_import_fact_is_weak(import_entry) }
    if existing_weak == 1 and incoming_weak == 0 {
      -- A local declaration or explicit import replaces the weak prelude
      -- regardless of registration order. Keep the spelling cell stable so
      -- indexed scope references do not need rewriting.
      mem_store64_at(existing + 24, 0, kind)
      mem_store64_at(existing + 32, 0, target)
      mem_store64_at(existing + 40, 0, import_entry)
      mem_store64_at(existing + 48, 0, visibility)
      mem_store64_at(existing + 56, 0, module_scope_status_resolved())
      mem_store64_at(existing + 64, 0, 0)
      mem_store64_at(existing + 72, 0, 0)
      mem_store64_at(existing + 80, 0, 0)
    } else { if existing_weak == 0 and incoming_weak == 1 {
      -- The prelude has lowest precedence and cannot turn a strong spelling
      -- into either a duplicate or an ambiguity.
      0
    } else { if module_scope_entry_kind(existing) == kind and module_scope_entry_target(existing) == target {
      -- Aliases and re-export diamonds preserve identity. The broadest valid
      -- re-export wins without minting a duplicate binding.
      if visibility > module_scope_entry_visibility(existing) { mem_store64_at(existing + 48, 0, visibility) } else { 0 }
    } else {
      mem_store64_at(existing + 56, 0, module_scope_status_ambiguous())
      if module_scope_entry_conflict(existing) == 0 {
        mem_store64_at(existing + 64, 0, target)
        mem_store64_at(existing + 72, 0, import_entry)
      } else { 0 }
    } } }
    existing
  }
}

pub(package) fn module_scope_add_issue(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, target: i64, import_entry: i64, status: i64) -> i64 {
  module_scope_add_issue_with_conflict(tt, module_entry, name_ptr, name_len, target, 0, import_entry, status)
}

pub(package) fn module_scope_add_issue_with_conflict(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, target: i64, conflict: i64, import_entry: i64, status: i64) -> i64 {
  let entry = module_scope_new_entry(module_entry, name_ptr, name_len, module_scope_kind_issue(), target, import_entry, module_visibility_private(), status)
  mem_store64_at(entry + 64, 0, conflict)
  nlist_add(module_fact_scopes(tt), entry)
  entry
}

pub(package) fn module_scope_same_package(a: i64, b: i64) -> i64 {
  if module_fact_entry_package(a) == module_fact_entry_package(b) { 1 } else { 0 }
}

pub(package) fn module_scope_entry_visible_from(entry: i64, importer_module: i64) -> i64 {
  let visibility = module_scope_entry_visibility(entry)
  if module_scope_entry_module(entry) == importer_module { 1 }
  else { if visibility == module_visibility_public() { 1 }
  else { if visibility == module_visibility_package() and module_scope_same_package(module_scope_entry_module(entry), importer_module) == 1 { 1 }
  else { 0 } } }
}

pub(package) fn module_scope_entry_is_type_constructor_pair(entry: i64) -> i64 {
  if entry == 0 or module_scope_entry_status(entry) != module_scope_status_ambiguous() or module_scope_entry_kind(entry) != module_scope_kind_declaration() { 0 }
  else {
    let first = module_scope_entry_target(entry)
    let second = module_scope_entry_conflict(entry)
    let first_ns = module_decl_fact_namespace(first)
    let second_ns = if second == 0 { 0 } else { module_decl_fact_namespace(second) }
    if first_ns == module_decl_namespace_type() and second_ns == module_decl_namespace_constructor() and module_decl_fact_owner(second) == first { 1 }
    else { if second_ns == module_decl_namespace_type() and first_ns == module_decl_namespace_constructor() and module_decl_fact_owner(first) == second { 1 } else { 0 } }
  }
}

pub(package) fn module_scope_add_local_declarations(tt: i64, module_entry: i64) -> i64 {
  let decls = module_fact_decls(tt)
  for i in 0..nlist_len(decls) {
    let decl = nlist_get(decls, i)
    let namespace = module_decl_fact_namespace(decl)
    -- Primitive inherent impls have no nominal declaration owner, but their
    -- methods still live in method lookup rather than the module-item scope.
    let module_item = if namespace >= module_decl_namespace_value() and namespace <= module_decl_namespace_trait() and module_decl_fact_owner(decl) == 0 { 1 }
      else { if namespace == module_decl_namespace_constructor() { 1 } else { 0 } }
    if module_decl_fact_module(decl) == module_entry and module_item == 1 {
      module_scope_add_binding(tt, module_entry, module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl), module_scope_kind_declaration(), decl, 0, module_decl_fact_visibility_code(decl))
    } else { 0 }
  }
  0
}

pub(package) fn module_scope_import_binding(tt: i64, import_entry: i64, target_binding: i64, local_name_ptr: i64, local_name_len: i64) -> i64 {
  let importer = module_import_fact_importer(import_entry)
  let requested_visibility = module_import_fact_visibility_code(import_entry)
  if module_scope_entry_is_type_constructor_pair(target_binding) == 1 {
    if module_scope_entry_visible_from(target_binding, importer) == 0 {
      module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_invisible())
    } else { if requested_visibility > module_scope_entry_visibility(target_binding) {
      module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_widened_reexport())
    } else {
      module_scope_add_binding(tt, importer, local_name_ptr, local_name_len, module_scope_kind_declaration(), module_scope_entry_target(target_binding), import_entry, requested_visibility)
      module_scope_add_binding(tt, importer, local_name_ptr, local_name_len, module_scope_kind_declaration(), module_scope_entry_conflict(target_binding), import_entry, requested_visibility)
    } }
  } else { if module_scope_entry_status(target_binding) == module_scope_status_ambiguous() {
    module_scope_add_issue_with_conflict(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), module_scope_entry_conflict(target_binding), import_entry, module_scope_status_ambiguous())
  } else { if module_scope_entry_visible_from(target_binding, importer) == 0 {
    module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_invisible())
  } else { if requested_visibility > module_scope_entry_visibility(target_binding) {
    module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_widened_reexport())
  } else {
    module_scope_add_binding(tt, importer, local_name_ptr, local_name_len, module_scope_entry_kind(target_binding), module_scope_entry_target(target_binding), import_entry, requested_visibility)
  } } } }
}

pub(package) fn module_scope_add_wildcard_import(tt: i64, import_entry: i64) -> i64 {
  let target_module = module_import_fact_target(import_entry)
  let importer = module_import_fact_importer(import_entry)
  let requested_visibility = module_import_fact_visibility_code(import_entry)
  -- Snapshot the target scope: additions to the importer must not become new
  -- wildcard candidates when resolving a diamond.
  let scopes = module_fact_scopes(tt)
  let n = nlist_len(scopes)
  for i in 0..n {
    let target_binding = nlist_get(scopes, i)
    if module_scope_entry_module(target_binding) == target_module and module_scope_entry_kind(target_binding) != module_scope_kind_issue() {
      -- Wildcard means every export at the requested tier, not an error for
      -- each deliberately private declaration. Explicit selections retain
      -- targeted invisible/widening issues through module_scope_import_binding.
      if module_scope_entry_visible_from(target_binding, importer) == 1 and requested_visibility <= module_scope_entry_visibility(target_binding) {
        module_scope_import_binding(tt, import_entry, target_binding, module_scope_entry_name_ptr(target_binding), module_scope_entry_name_len(target_binding))
      } else { 0 }
    } else { 0 }
  }
  0
}

pub(package) fn module_scope_add_selected_import(tt: i64, import_entry: i64, selection: i64) -> i64 {
  let name_ptr = node_f1(selection)
  let name_len = node_f2(selection)
  if name_len < 0 { module_scope_add_wildcard_import(tt, import_entry) }
  else {
    let target_binding = module_scope_find_binding(tt, module_import_fact_target(import_entry), name_ptr, name_len)
    let alias_ptr = if node_f4(selection) > 0 { node_f3(selection) } else { name_ptr }
    let alias_len = if node_f4(selection) > 0 { node_f4(selection) } else { name_len }
    if target_binding == 0 {
      module_scope_add_issue(tt, module_import_fact_importer(import_entry), alias_ptr, alias_len, 0, import_entry, module_scope_status_missing())
    } else {
      module_scope_import_binding(tt, import_entry, target_binding, alias_ptr, alias_len)
    }
  }
}

pub(package) fn module_scope_add_import(tt: i64, import_entry: i64) -> i64 {
  let selection_count = module_import_fact_selection_count(import_entry)
  if selection_count == 0 {
    module_scope_add_binding(tt, module_import_fact_importer(import_entry), module_import_fact_alias_ptr(import_entry), module_import_fact_alias_len(import_entry), module_scope_kind_module(), module_import_fact_target(import_entry), import_entry, module_import_fact_visibility_code(import_entry))
  } else {
    for i in 0..selection_count {
      module_scope_add_selected_import(tt, import_entry, module_import_fact_selection_at(import_entry, i))
    }
  }
  0
}

pub(package) fn module_scope_build_module(tt: i64, module_entry: i64) -> i64 {
  let state = module_fact_entry_scope_state(module_entry)
  if state == 2 { 0 }
  else { if state == 1 { 0 }
  else {
    mem_store64_at(module_entry + 48, 0, 1)
    module_scope_add_local_declarations(tt, module_entry)
    let imports = module_fact_imports(tt)
    for i in 0..nlist_len(imports) {
      let import_entry = nlist_get(imports, i)
      if module_import_fact_importer(import_entry) == module_entry {
        module_scope_build_module(tt, module_import_fact_target(import_entry))
        module_scope_add_import(tt, import_entry)
      } else { 0 }
    }
    mem_store64_at(module_entry + 48, 0, 2)
    0
  } }
}

pub(package) fn module_scope_build_all(tt: i64) -> i64 {
  let modules = module_fact_modules(tt)
  for i in 0..nlist_len(modules) {
    module_scope_build_module(tt, nlist_get(modules, i))
  }
  0
}

pub(package) fn module_scope_module_exports_declaration(tt: i64, module_entry: i64, declaration: i64, importer_module: i64) -> i64 {
  let scopes = module_fact_scopes(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(scopes) and found == 0 {
    let entry = nlist_get(scopes, i)
    let target_matches = module_scope_entry_target(entry) == declaration or
      (module_scope_entry_is_type_constructor_pair(entry) == 1 and module_scope_entry_conflict(entry) == declaration)
    if module_scope_entry_module(entry) == module_entry and
      module_scope_entry_kind(entry) == module_scope_kind_declaration() and
      target_matches and module_scope_entry_visible_from(entry, importer_module) == 1 {
      found = 1
    } else { i = i + 1 }
  }
  found
}

-- An explicit module import makes the public surface of that module available
-- through its qualifier. Preserve that fact for inherent-method lookup too:
-- a facade which publicly re-exports a type must expose the type's public
-- inherent methods without also injecting the type name into local scope.
pub(package) fn module_scope_strong_module_import_exposes_declaration(tt: i64, importer_module: i64, declaration: i64) -> i64 {
  module_scope_build_all(tt)
  let imports = module_fact_imports(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(imports) and found == 0 {
    let edge = nlist_get(imports, i)
    if module_import_fact_importer(edge) == importer_module and
      module_import_fact_is_weak(edge) == 0 and
      module_import_fact_selection_count(edge) == 0 and
      module_scope_module_exports_declaration(tt, module_import_fact_target(edge), declaration, importer_module) == 1 {
      found = 1
    } else { i = i + 1 }
  }
  found
}

-- True only when the producer has already emitted the structured diagnostic
-- for this spelling. Checker fallbacks consume this fact to avoid adding a
-- second generic unknown-name error after a scope/import failure.
pub(package) fn module_scope_problem_is_diagnosed(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { 0 }
  else {
    let name_ptr = name_src + name_start
    let binding = module_scope_find_binding(tt, module_entry, name_ptr, name_len)
    if binding != 0 and module_scope_entry_status(binding) == module_scope_status_ambiguous() and module_scope_entry_is_diagnosed(binding) == 1 { 1 }
    else {
      let ambiguous = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_ambiguous())
      let missing = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_missing())
      let invisible = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_invisible())
      let widened = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_widened_reexport())
      if ambiguous != 0 and module_scope_entry_is_diagnosed(ambiguous) == 1 { 1 }
      else { if missing != 0 and module_scope_entry_is_diagnosed(missing) == 1 { 1 }
      else { if invisible != 0 and module_scope_entry_is_diagnosed(invisible) == 1 { 1 }
      else { if widened != 0 and module_scope_entry_is_diagnosed(widened) == 1 { 1 }
      else { 0 } } } }
    }
  }
}

pub(package) fn module_scope_lookup(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { 0 }
  else { module_scope_find_binding(tt, module_entry, name_src + name_start, name_len) }
}

pub(package) fn module_scope_lookup_declaration(tt: i64, src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let binding = module_scope_lookup(tt, src, name_src, name_start, name_len)
  if binding != 0 and module_scope_entry_status(binding) == module_scope_status_ambiguous() and module_scope_entry_kind(binding) == module_scope_kind_declaration() {
    -- A visible type and its inherited-visibility same-spelled constructor
    -- deliberately occupy distinct namespaces. Wildcard/selective imports
    -- retain both declaration identities on the binding; select the one the
    -- consumer requested instead of collapsing the pair to an ambiguity.
    let first = module_scope_entry_target(binding)
    let second = module_scope_entry_conflict(binding)
    if module_scope_entry_is_type_constructor_pair(binding) == 0 { 0 }
    else { if module_decl_fact_namespace(first) == namespace { first } else { if module_decl_fact_namespace(second) == namespace { second } else { 0 } } }
  } else {
    if binding == 0 or module_scope_entry_status(binding) != module_scope_status_resolved() or module_scope_entry_kind(binding) != module_scope_kind_declaration() { 0 }
    else {
    let decl = module_scope_entry_target(binding)
    if module_decl_fact_namespace(decl) == namespace { decl } else { 0 }
    }
  }
}

-- Resolve the second half of `module.member` without flattening it into the
-- caller's spelling scope.  The returned entry is intentionally the target
-- module's producer-owned scope fact: consumers can distinguish missing,
-- ambiguous, invisible, and wrong-namespace members before selecting a
-- declaration identity.
pub(package) fn module_scope_lookup_qualified_entry(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, src)
  if caller_module == 0 { 0 }
  else {
    let qualifier = module_scope_find_binding(tt, caller_module, module_name_src + module_name_start, module_name_len)
    if qualifier == 0 or module_scope_entry_status(qualifier) != module_scope_status_resolved() or module_scope_entry_kind(qualifier) != module_scope_kind_module() { 0 }
    else {
      module_scope_find_binding(tt, module_scope_entry_target(qualifier), member_name_src + member_name_start, member_name_len)
    }
  }
}

pub(package) fn module_scope_qualifier_is_module(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, src)
  if caller_module == 0 { 0 }
  else {
    let qualifier = module_scope_find_binding(tt, caller_module, name_src + name_start, name_len)
    if qualifier != 0 and module_scope_entry_status(qualifier) == module_scope_status_resolved() and module_scope_entry_kind(qualifier) == module_scope_kind_module() { 1 } else { 0 }
  }
}

pub(package) fn module_scope_lookup_module(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let caller_module = module_fact_find_source(tt, src)
  if caller_module == 0 { 0 }
  else {
    let binding = module_scope_find_binding(tt, caller_module, name_src + name_start, name_len)
    if binding != 0 and module_scope_entry_status(binding) == module_scope_status_resolved() and module_scope_entry_kind(binding) == module_scope_kind_module() {
      module_scope_entry_target(binding)
    } else { 0 }
  }
}

pub(package) fn module_scope_lookup_qualified_declaration(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, namespace: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> i64 {
  let caller_module = module_fact_find_source(tt, src)
  let entry = module_scope_lookup_qualified_entry(tt, src, module_name_src, module_name_start, module_name_len, member_name_src, member_name_start, member_name_len)
  if caller_module == 0 { 0 }
  else { if entry != 0 and module_scope_entry_status(entry) == module_scope_status_ambiguous() {
    -- A type and its same-spelled constructor deliberately occupy distinct
    -- namespaces. Resolve the namespace requested by the consumer instead of
    -- treating that cross-namespace pair as a semantic ambiguity.
    let qualifier = module_scope_find_binding(tt, caller_module, module_name_src + module_name_start, module_name_len)
    if qualifier == 0 or module_scope_entry_status(qualifier) != module_scope_status_resolved() or module_scope_entry_kind(qualifier) != module_scope_kind_module() { 0 }
    else {
      let target_module = module_scope_entry_target(qualifier)
      let decl = module_decl_fact_find(tt, module_fact_entry_source(target_module), namespace, member_name_src, member_name_start, member_name_len)
      if decl != 0 and module_decl_fact_visible_from(tt, decl, caller_module) == 1 { decl } else { 0 }
    }
  } else { if entry == 0 or module_scope_entry_status(entry) != module_scope_status_resolved() or module_scope_entry_kind(entry) != module_scope_kind_declaration() or module_scope_entry_visible_from(entry, caller_module) == 0 { 0 }
  else {
    let decl = module_scope_entry_target(entry)
    if module_decl_fact_namespace(decl) == namespace { decl } else { 0 }
  } } }
}

pub(package) fn module_scope_resolution(entry: i64) -> ModuleNameResolution {
  if entry == 0 { MissingModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_ambiguous() { AmbiguousModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_missing() { MissingModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_invisible() { InvisibleModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_widened_reexport() { WidenedReexportName() }
  else { if module_scope_entry_kind(entry) == module_scope_kind_module() {
    ResolvedModuleName(module_id_from_entry(module_scope_entry_target(entry)))
  } else {
    ResolvedDeclarationName(module_decl_fact_id(module_scope_entry_target(entry)))
  } } } } } }
}

-- Stable tooling queries return typed semantic values and keep the raw scope
-- registry private to the compiler. Callers never need to decode entry
-- addresses or status integers.
pub(package) fn module_resolve_name(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> ModuleNameResolution {
  module_scope_build_all(tt)
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { MissingModuleName() }
  else {
    let name_ptr = name_src + name_start
    let binding = module_scope_find_binding(tt, module_entry, name_ptr, name_len)
    if binding != 0 { module_scope_resolution(binding) }
    else {
      let ambiguous = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_ambiguous())
      let invisible = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_invisible())
      let widened = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_widened_reexport())
      if ambiguous != 0 { AmbiguousModuleName() }
      else { if invisible != 0 { InvisibleModuleName() }
      else { if widened != 0 { WidenedReexportName() }
      else { MissingModuleName() } } }
    }
  }
}

pub(package) fn module_resolve_qualified_name(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> ModuleNameResolution {
  let caller_module = module_fact_find_source(tt, src)
  let entry = module_scope_lookup_qualified_entry(tt, src, module_name_src, module_name_start, module_name_len, member_name_src, member_name_start, member_name_len)
  if entry == 0 { MissingModuleName() }
  else { if caller_module == 0 or module_scope_entry_visible_from(entry, caller_module) == 0 { InvisibleModuleName() }
  else { module_scope_resolution(entry) } }
}

pub(package) fn module_decl_id_namespace(id: DeclId) -> i64 {
  match id {
    ModuleDeclId(module_id, namespace, name_ptr, name_len) -> namespace
    MemberDeclId(owner, namespace, name_ptr, name_len) -> namespace
  }
}

pub(package) fn module_decl_id_name_len(id: DeclId) -> i64 {
  match id {
    ModuleDeclId(module_id, namespace, name_ptr, name_len) -> name_len
    MemberDeclId(owner, namespace, name_ptr, name_len) -> name_len
  }
}
