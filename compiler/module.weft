-- compiler/module.weft — semantic module/declaration identity facts.
--
-- 4g keeps logical identity separate from source buffers, physical paths,
-- trust, and backend name hashes. The raw registries below are the bootstrap
-- storage bridge; consumers receive typed facts and must not reconstruct
-- ownership from short-name strings.

use "compiler/lib.weft"
use "runtime/alloc.weft"
use "runtime/memory.weft"

type ModuleId {
  NamedModuleId(i64, i64, i64), -- logical path ptr/len, package identity
  AnonymousModuleId(i64)        -- compilation-local anonymous-root ordinal
}

type DeclId {
  ModuleDeclId(ModuleId, i64, i64, i64), -- namespace, name ptr/len
  MemberDeclId(DeclId, i64, i64, i64)    -- owner, namespace, name ptr/len
}

type DeclVisibility {
  PrivateVisibility,
  PackageVisibility,
  PublicVisibility
}

type ModuleImportFact {
  ModuleImportFact(ModuleId, ModuleId, i64, i64) -- selections, visibility code
}

type ModuleNameResolution {
  ResolvedDeclarationName(DeclId),
  ResolvedModuleName(ModuleId),
  MissingModuleName,
  InvisibleModuleName,
  AmbiguousModuleName,
  WidenedReexportName
}

fn module_visibility_private() -> i64 { 0 }
fn module_visibility_package() -> i64 { 1 }
fn module_visibility_public() -> i64 { 2 }

fn module_visibility_from_code(code: i64) -> DeclVisibility {
  if code == module_visibility_public() { PublicVisibility() }
  else { if code == module_visibility_package() { PackageVisibility() }
  else { PrivateVisibility() } }
}

fn module_decl_namespace_value() -> i64 { 1 }
fn module_decl_namespace_type() -> i64 { 2 }
fn module_decl_namespace_effect() -> i64 { 3 }
fn module_decl_namespace_trait() -> i64 { 4 }
fn module_decl_namespace_inherent_method() -> i64 { 5 }
fn module_decl_namespace_trait_method() -> i64 { 6 }
fn module_decl_namespace_associated_type() -> i64 { 7 }
fn module_decl_namespace_effect_operation() -> i64 { 8 }
fn module_decl_namespace_constructor() -> i64 { 9 }

fn module_scope_kind_issue() -> i64 { 0 }
fn module_scope_kind_declaration() -> i64 { 1 }
fn module_scope_kind_module() -> i64 { 2 }

fn module_scope_status_resolved() -> i64 { 0 }
fn module_scope_status_ambiguous() -> i64 { 1 }
fn module_scope_status_missing() -> i64 { 2 }
fn module_scope_status_invisible() -> i64 { 3 }
fn module_scope_status_widened_reexport() -> i64 { 4 }

-- ttable-owned registry slots. codegen's ttable_new initializes them through
-- module_fact_tables_init; the producer lives here rather than in lookup or
-- native emission.
fn module_fact_modules(tt: i64) -> i64 { mem_load64_at(tt + 112, 0) }
fn module_fact_decls(tt: i64) -> i64 { mem_load64_at(tt + 120, 0) }
fn module_fact_imports(tt: i64) -> i64 { mem_load64_at(tt + 128, 0) }
fn module_fact_scopes(tt: i64) -> i64 { mem_load64_at(tt + 136, 0) }

fn module_fact_tables_init(tt: i64) -> i64 {
  mem_store64_at(tt + 112, 0, nlist_new())
  mem_store64_at(tt + 120, 0, nlist_new())
  mem_store64_at(tt + 128, 0, nlist_new())
  mem_store64_at(tt + 136, 0, nlist_new())
  0
}

fn module_path_has_weft_suffix(path_ptr: i64, path_len: i64) -> i64 {
  if path_len < 5 { 0 }
  else { src_eq_at(path_ptr, path_len - 5, __str_ptr(".weft"), 0, 5) }
}

fn module_logical_path_len(path_ptr: i64, path_len: i64) -> i64 {
  if module_path_has_weft_suffix(path_ptr, path_len) == 1 { path_len - 5 }
  else { path_len }
}

fn module_identity_hash(path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  -- FNV-1a is only a lookup accelerator. Equality always compares the full
  -- package/path identity, so collisions cannot merge modules.
  let mut h = 2166136261 bxor package_id
  for i in 0..path_len {
    h = (h bxor mem_load8_at(path_ptr, i)) * 16777619
  }
  h
}

-- Module entry: source, path ptr, logical len, package id, anonymous ordinal,
-- cached hash = 48 bytes.
fn module_fact_entry_source(entry: i64) -> i64 { mem_load64_at(entry, 0) }
fn module_fact_entry_path_ptr(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
fn module_fact_entry_path_len(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
fn module_fact_entry_package(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
fn module_fact_entry_anonymous(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
fn module_fact_entry_hash(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
fn module_fact_entry_scope_state(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }

fn module_fact_find_source(tt: i64, src: i64) -> i64 {
  let modules = module_fact_modules(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(modules) and result == 0 {
    let entry = nlist_get(modules, i)
    if module_fact_entry_source(entry) == src { result = entry }
    else { i = i + 1 }
  }
  result
}

fn module_fact_path_eq(entry: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let logical_len = module_logical_path_len(path_ptr, path_len)
  if module_fact_entry_anonymous(entry) != 0 { 0 }
  else { if module_fact_entry_package(entry) != package_id { 0 }
  else { if module_fact_entry_path_len(entry) != logical_len { 0 }
  else { src_eq_at(module_fact_entry_path_ptr(entry), 0, path_ptr, 0, logical_len) } } }
}

fn module_fact_find_path(tt: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let modules = module_fact_modules(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(modules) and result == 0 {
    let entry = nlist_get(modules, i)
    if module_fact_path_eq(entry, path_ptr, path_len, package_id) == 1 { result = entry }
    else { i = i + 1 }
  }
  result
}

fn module_fact_upgrade_named(entry: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let logical_len = module_logical_path_len(path_ptr, path_len)
  mem_store64_at(entry + 8, 0, path_ptr)
  mem_store64_at(entry + 16, 0, logical_len)
  mem_store64_at(entry + 24, 0, package_id)
  mem_store64_at(entry + 32, 0, 0)
  mem_store64_at(entry + 40, 0, module_identity_hash(path_ptr, logical_len, package_id))
  entry
}

fn module_fact_register_source(tt: i64, src: i64, path_ptr: i64, path_len: i64, package_id: i64) -> i64 {
  let existing = module_fact_find_source(tt, src)
  if existing != 0 {
    if path_len > 0 and module_fact_entry_anonymous(existing) != 0 {
      module_fact_upgrade_named(existing, path_ptr, path_len, package_id)
    } else { existing }
  } else {
    let modules = module_fact_modules(tt)
    let entry = alloc_words(7)
    mem_store64_at(entry, 0, src)
    if path_len > 0 {
      module_fact_upgrade_named(entry, path_ptr, path_len, package_id)
    } else {
      let ordinal = nlist_len(modules) + 1
      mem_store64_at(entry + 8, 0, 0)
      mem_store64_at(entry + 16, 0, 0)
      mem_store64_at(entry + 24, 0, package_id)
      mem_store64_at(entry + 32, 0, ordinal)
      mem_store64_at(entry + 40, 0, 0 - ordinal)
    }
    mem_store64_at(entry + 48, 0, 0)
    nlist_add(modules, entry)
    entry
  }
}

fn module_id_from_entry(entry: i64) -> ModuleId {
  if module_fact_entry_anonymous(entry) != 0 {
    AnonymousModuleId(module_fact_entry_anonymous(entry))
  } else {
    NamedModuleId(module_fact_entry_path_ptr(entry), module_fact_entry_path_len(entry), module_fact_entry_package(entry))
  }
}

fn module_fact_module_count(tt: i64) -> i64 { nlist_len(module_fact_modules(tt)) }
fn module_fact_decl_count(tt: i64) -> i64 { nlist_len(module_fact_decls(tt)) }
fn module_fact_import_count(tt: i64) -> i64 { nlist_len(module_fact_imports(tt)) }
fn module_fact_scope_count(tt: i64) -> i64 { nlist_len(module_fact_scopes(tt)) }
fn module_fact_module_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_modules(tt), index) }
fn module_fact_decl_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_decls(tt), index) }
fn module_fact_import_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_imports(tt), index) }
fn module_fact_scope_at(tt: i64, index: i64) -> i64 { nlist_get(module_fact_scopes(tt), index) }

-- The declaration and scope registries are producer-owned nlists. Their
-- otherwise-unused cache word carries a hash tree whose leaves own collision
-- buckets; equality is always rechecked against the complete semantic key.
-- This keeps hashes as accelerators only and preserves DeclId/scope identity
-- under adversarial collisions.
fn module_fact_index_find_node(tree: i64, key: i64) -> i64 {
  let mut current = tree
  let mut result = 0
  while current != 0 and result == 0 {
    let current_key = node_f1(current)
    if key == current_key { result = current }
    else { if key < current_key { current = node_f3(current) } else { current = node_f4(current) } }
  }
  result
}

fn module_fact_index_insert(tree: i64, key: i64, entry: i64) -> i64 {
  let existing = module_fact_index_find_node(tree, key)
  if existing != 0 {
    nlist_add(node_f2(existing), entry)
    tree
  } else {
    let bucket = nlist_new_capacity(1)
    nlist_add(bucket, entry)
    let leaf = node_new(0, key, bucket, 0, 0)
    if tree == 0 { leaf }
    else {
      let mut current = tree
      let mut done = 0
      while done == 0 {
        if key < node_f1(current) {
          if node_f3(current) == 0 { mem_store64_at(current, 24, leaf) done = 1 }
          else { current = node_f3(current) }
        } else {
          if node_f4(current) == 0 { mem_store64_at(current, 32, leaf) done = 1 }
          else { current = node_f4(current) }
        }
      }
      tree
    }
  }
}

fn module_fact_index_add(registry: i64, key: i64, entry: i64) -> i64 {
  let root = mem_load64_at(registry, 24)
  mem_store64_at(registry, 24, module_fact_index_insert(root, key, entry))
  entry
}

-- Declaration entry: module entry, owner declaration entry, namespace,
-- absolute name ptr, name len, visibility, source span, derived native key,
-- bootstrap function-pair bridge = 72 bytes. The last two fields are derived
-- consumers of DeclId, never part of semantic identity.
fn module_decl_fact_register(tt: i64, src: i64, owner: i64, namespace: i64, name_start: i64, name_len: i64, visibility: i64) -> i64 {
  let module_entry = module_fact_register_source(tt, src, 0, 0, 0)
  let entry = alloc_words(9)
  mem_store64_at(entry, 0, module_entry)
  mem_store64_at(entry + 8, 0, owner)
  mem_store64_at(entry + 16, 0, namespace)
  mem_store64_at(entry + 24, 0, src + name_start)
  mem_store64_at(entry + 32, 0, name_len)
  mem_store64_at(entry + 40, 0, visibility)
  mem_store64_at(entry + 48, 0, src + name_start)
  mem_store64_at(entry + 56, 0, 0)
  mem_store64_at(entry + 64, 0, 0)
  let decls = module_fact_decls(tt)
  nlist_add(decls, entry)
  -- The legacy module-wide query intentionally sees owned members as well as
  -- roots; exact member consumers additionally query by owner DeclId.
  module_fact_index_add(decls, module_decl_fact_lookup_key(module_entry, 0, namespace, src + name_start, name_len), entry)
  if owner != 0 { module_fact_index_add(decls, module_decl_fact_lookup_key(0, owner, namespace, src + name_start, name_len), entry) } else { 0 }
  entry
}

fn module_decl_fact_id(entry: i64) -> DeclId {
  let module_id = module_id_from_entry(mem_load64_at(entry, 0))
  let owner = mem_load64_at(entry + 8, 0)
  let namespace = mem_load64_at(entry + 16, 0)
  let name_ptr = mem_load64_at(entry + 24, 0)
  let name_len = mem_load64_at(entry + 32, 0)
  if owner == 0 { ModuleDeclId(module_id, namespace, name_ptr, name_len) }
  else { MemberDeclId(module_decl_fact_id(owner), namespace, name_ptr, name_len) }
}

fn module_decl_fact_name_eq(entry: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  if mem_load64_at(entry + 16, 0) != namespace { 0 }
  else { if mem_load64_at(entry + 32, 0) != name_len { 0 }
  else { src_eq_at(mem_load64_at(entry + 24, 0), 0, name_src + name_start, 0, name_len) } }
}

fn module_decl_fact_lookup_key(module_entry: i64, owner: i64, namespace: i64, name_ptr: i64, name_len: i64) -> i64 {
  let identity = if owner != 0 { owner } else { module_entry }
  module_identity_hash(name_ptr, name_len, identity * 131 + namespace * 17)
}

fn module_decl_fact_find_indexed(tt: i64, module_entry: i64, owner: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let decls = module_fact_decls(tt)
  let key = module_decl_fact_lookup_key(module_entry, owner, namespace, name_src + name_start, name_len)
  let indexed = module_fact_index_find_node(mem_load64_at(decls, 24), key)
  if indexed == 0 { 0 }
  else {
    let bucket = node_f2(indexed)
    let mut i = 0
    let mut result = 0
    while i < nlist_len(bucket) and result == 0 {
      let entry = nlist_get(bucket, i)
      let identity_ok = if owner != 0 { module_decl_fact_owner(entry) == owner }
        else { module_decl_fact_module(entry) == module_entry }
      if identity_ok and module_decl_fact_name_eq(entry, namespace, name_src, name_start, name_len) == 1 { result = entry }
      else { i = i + 1 }
    }
    result
  }
}

fn module_decl_fact_find(tt: i64, src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { 0 }
  else { module_decl_fact_find_indexed(tt, module_entry, 0, namespace, name_src, name_start, name_len) }
}

fn module_decl_fact_find_member(tt: i64, owner: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  if owner == 0 { 0 }
  else { module_decl_fact_find_indexed(tt, 0, owner, namespace, name_src, name_start, name_len) }
}

fn module_decl_fact_find_visible_flat(tt: i64, preferred_src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let local = module_decl_fact_find(tt, preferred_src, namespace, name_src, name_start, name_len)
  if local != 0 { local }
  else {
    let decls = module_fact_decls(tt)
    let mut i = 0
    let mut result = 0
    while i < nlist_len(decls) and result == 0 {
      let entry = nlist_get(decls, i)
      if module_decl_fact_name_eq(entry, namespace, name_src, name_start, name_len) == 1 { result = entry }
      else { i = i + 1 }
    }
    result
  }
}

fn module_decl_fact_visibility(entry: i64) -> DeclVisibility {
  module_visibility_from_code(mem_load64_at(entry + 40, 0))
}

fn module_decl_fact_visibility_code(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
fn module_decl_fact_namespace(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
fn module_decl_fact_owner(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
fn module_decl_fact_module(entry: i64) -> i64 { mem_load64_at(entry, 0) }
fn module_decl_fact_source(entry: i64) -> i64 { module_fact_entry_source(module_decl_fact_module(entry)) }
fn module_decl_fact_name_ptr(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
fn module_decl_fact_name_len(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }

fn module_decl_fact_visible_from(tt: i64, entry: i64, caller_module: i64) -> i64 {
  if entry == 0 or caller_module == 0 { 0 }
  else { if module_decl_fact_module(entry) == caller_module { 1 }
  else { if module_fact_module_uses_legacy_flat(tt, caller_module) == 1 { 1 }
  else {
    let owner = module_decl_fact_owner(entry)
    -- Constructors, effect operations, trait methods, and associated types
    -- inherit their owner's visibility in v1. Inherent methods are the sole
    -- member namespace with an independent visibility modifier.
    let visibility_entry = if owner != 0 and module_decl_fact_namespace(entry) != module_decl_namespace_inherent_method() { owner } else { entry }
    if module_decl_fact_visibility_code(visibility_entry) == module_visibility_public() { 1 }
    else { if module_decl_fact_visibility_code(visibility_entry) == module_visibility_package() and module_scope_same_package(module_decl_fact_module(visibility_entry), caller_module) == 1 { 1 }
    else { 0 } }
  } } } }
}

fn module_decl_fact_native_key_or(entry: i64, default: i64) -> i64 {
  if entry == 0 or mem_load64_at(entry + 56, 0) == 0 { default }
  else { mem_load64_at(entry + 56, 0) }
}

fn module_decl_fact_derived_native_key(entry: i64, name_hash: i64) -> i64 {
  if entry == 0 { name_hash }
  else {
    let module_hash = module_fact_entry_hash(module_decl_fact_module(entry))
    let owner = module_decl_fact_owner(entry)
    let owner_key = if owner == 0 { 0 } else { module_decl_fact_derived_native_key(owner, name_hash) }
    let mixed = name_hash * 1000003 + module_hash * 8191 + module_decl_fact_namespace(entry) * 131 + owner_key * 17 + 32452843
    if mixed == 0 { 49979687 } else { mixed }
  }
}

fn module_decl_fact_mark_native_collision(entry: i64, name_hash: i64) -> i64 {
  if entry == 0 { name_hash }
  else {
    let existing = mem_load64_at(entry + 56, 0)
    if existing != 0 { existing }
    else {
      let key = module_decl_fact_derived_native_key(entry, name_hash)
      mem_store64_at(entry + 56, 0, key)
      key
    }
  }
}

fn module_decl_fact_bind_function_pair(entry: i64, pair: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    mem_store64_at(entry + 64, 0, pair)
    pair
  }
}

fn module_decl_fact_function_pair(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 64, 0) }
}

-- Import entry: importer module, target module, selections, alias ptr/len,
-- re-export visibility, legacy quoted bit = 56 bytes.
fn module_import_fact_register(tt: i64, importer_src: i64, target_module: i64, selections: i64, alias_ptr: i64, alias_len: i64, visibility: i64, legacy: i64) -> i64 {
  let entry = alloc_words(7)
  mem_store64_at(entry, 0, module_fact_register_source(tt, importer_src, 0, 0, 0))
  mem_store64_at(entry + 8, 0, target_module)
  mem_store64_at(entry + 16, 0, selections)
  mem_store64_at(entry + 24, 0, alias_ptr)
  mem_store64_at(entry + 32, 0, alias_len)
  mem_store64_at(entry + 40, 0, visibility)
  mem_store64_at(entry + 48, 0, legacy)
  nlist_add(module_fact_imports(tt), entry)
  entry
}

fn module_import_fact_value(entry: i64) -> ModuleImportFact {
  ModuleImportFact(
    module_id_from_entry(mem_load64_at(entry, 0)),
    module_id_from_entry(mem_load64_at(entry + 8, 0)),
    mem_load64_at(entry + 16, 0),
    mem_load64_at(entry + 40, 0)
  )
}

fn module_import_fact_selection_count(entry: i64) -> i64 { nlist_len(mem_load64_at(entry + 16, 0)) }
fn module_import_fact_selection_at(entry: i64, index: i64) -> i64 { nlist_get(mem_load64_at(entry + 16, 0), index) }
fn module_import_fact_alias_eq(entry: i64, expected: str) -> i64 {
  let alias_ptr = mem_load64_at(entry + 24, 0)
  let alias_len = mem_load64_at(entry + 32, 0)
  if alias_len != __str_len(expected) { 0 }
  else { src_eq_at(alias_ptr, 0, __str_ptr(expected), 0, alias_len) }
}
fn module_import_fact_visibility_code(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
fn module_import_fact_is_legacy(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
fn module_import_fact_importer(entry: i64) -> i64 { mem_load64_at(entry, 0) }
fn module_import_fact_target(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
fn module_import_fact_alias_ptr(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
fn module_import_fact_alias_len(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }

fn module_fact_module_uses_legacy_flat(tt: i64, module_entry: i64) -> i64 {
  if module_entry == 0 { 0 }
  else {
    let imports = module_fact_imports(tt)
    let mut i = 0
    let mut found = 0
    while i < nlist_len(imports) and found == 0 {
      let entry = nlist_get(imports, i)
      if (module_import_fact_importer(entry) == module_entry or module_import_fact_target(entry) == module_entry) and module_import_fact_is_legacy(entry) == 1 { found = 1 }
      else { i = i + 1 }
    }
    found
  }
}

fn module_fact_source_uses_legacy_flat(tt: i64, src: i64) -> i64 {
  module_fact_module_uses_legacy_flat(tt, module_fact_find_source(tt, src))
}

-- A module-scope entry is the producer-owned resolution fact for one spelling:
-- scope module, spelling ptr/len, kind, target decl/module, originating import,
-- effective export visibility, status, conflicting target, legacy-collision
-- compatibility bit = 80 bytes. Issue entries have kind=0 and retain the
-- failed candidate (when one exists).
fn module_scope_entry_module(entry: i64) -> i64 { mem_load64_at(entry, 0) }
fn module_scope_entry_name_ptr(entry: i64) -> i64 { mem_load64_at(entry + 8, 0) }
fn module_scope_entry_name_len(entry: i64) -> i64 { mem_load64_at(entry + 16, 0) }
fn module_scope_entry_kind(entry: i64) -> i64 { mem_load64_at(entry + 24, 0) }
fn module_scope_entry_target(entry: i64) -> i64 { mem_load64_at(entry + 32, 0) }
fn module_scope_entry_import(entry: i64) -> i64 { mem_load64_at(entry + 40, 0) }
fn module_scope_entry_visibility(entry: i64) -> i64 { mem_load64_at(entry + 48, 0) }
fn module_scope_entry_status(entry: i64) -> i64 { mem_load64_at(entry + 56, 0) }
fn module_scope_entry_conflict(entry: i64) -> i64 { mem_load64_at(entry + 64, 0) }
fn module_scope_entry_has_legacy_collision(entry: i64) -> i64 { mem_load64_at(entry + 72, 0) }

fn module_scope_name_eq(entry: i64, module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  if module_scope_entry_module(entry) != module_entry { 0 }
  else { if module_scope_entry_name_len(entry) != name_len { 0 }
  else { src_eq_at(module_scope_entry_name_ptr(entry), 0, name_ptr, 0, name_len) } }
}

fn module_scope_lookup_key(module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  module_identity_hash(name_ptr, name_len, module_entry * 131)
}

fn module_scope_find_binding(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64) -> i64 {
  let scopes = module_fact_scopes(tt)
  let indexed = module_fact_index_find_node(mem_load64_at(scopes, 24), module_scope_lookup_key(module_entry, name_ptr, name_len))
  if indexed == 0 { 0 }
  else {
    let bucket = node_f2(indexed)
    let mut i = 0
    let mut result = 0
    while i < nlist_len(bucket) and result == 0 {
      let entry = nlist_get(bucket, i)
      if module_scope_entry_kind(entry) != module_scope_kind_issue() and module_scope_name_eq(entry, module_entry, name_ptr, name_len) == 1 { result = entry }
      else { i = i + 1 }
    }
    result
  }
}

fn module_scope_find_issue(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, status: i64) -> i64 {
  let scopes = module_fact_scopes(tt)
  let mut i = 0
  let mut result = 0
  while i < nlist_len(scopes) and result == 0 {
    let entry = nlist_get(scopes, i)
    if module_scope_entry_kind(entry) == module_scope_kind_issue() and module_scope_entry_status(entry) == status and module_scope_name_eq(entry, module_entry, name_ptr, name_len) == 1 {
      result = entry
    } else { i = i + 1 }
  }
  result
}

fn module_scope_new_entry(module_entry: i64, name_ptr: i64, name_len: i64, kind: i64, target: i64, import_entry: i64, visibility: i64, status: i64) -> i64 {
  let entry = alloc_words(10)
  mem_store64_at(entry, 0, module_entry)
  mem_store64_at(entry + 8, 0, name_ptr)
  mem_store64_at(entry + 16, 0, name_len)
  mem_store64_at(entry + 24, 0, kind)
  mem_store64_at(entry + 32, 0, target)
  mem_store64_at(entry + 40, 0, import_entry)
  mem_store64_at(entry + 48, 0, visibility)
  mem_store64_at(entry + 56, 0, status)
  mem_store64_at(entry + 64, 0, 0)
  mem_store64_at(entry + 72, 0, 0)
  entry
}

fn module_scope_add_binding(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, kind: i64, target: i64, import_entry: i64, visibility: i64) -> i64 {
  let existing = module_scope_find_binding(tt, module_entry, name_ptr, name_len)
  if existing == 0 {
    let entry = module_scope_new_entry(module_entry, name_ptr, name_len, kind, target, import_entry, visibility, module_scope_status_resolved())
    let scopes = module_fact_scopes(tt)
    nlist_add(scopes, entry)
    module_fact_index_add(scopes, module_scope_lookup_key(module_entry, name_ptr, name_len), entry)
    entry
  } else {
    if module_scope_entry_kind(existing) == kind and module_scope_entry_target(existing) == target {
      -- Aliases and re-export diamonds preserve identity. The broadest valid
      -- re-export wins without minting a duplicate binding.
      if visibility > module_scope_entry_visibility(existing) { mem_store64_at(existing + 48, 0, visibility) } else { 0 }
    } else {
      mem_store64_at(existing + 56, 0, module_scope_status_ambiguous())
      if module_scope_entry_conflict(existing) == 0 { mem_store64_at(existing + 64, 0, target) } else { 0 }
      let existing_import = module_scope_entry_import(existing)
      let existing_legacy = if existing_import == 0 { 0 } else { module_import_fact_is_legacy(existing_import) }
      let incoming_legacy = if import_entry == 0 { 0 } else { module_import_fact_is_legacy(import_entry) }
      if existing_legacy == 1 or incoming_legacy == 1 { mem_store64_at(existing + 72, 0, 1) } else { 0 }
    }
    existing
  }
}

fn module_scope_add_issue(tt: i64, module_entry: i64, name_ptr: i64, name_len: i64, target: i64, import_entry: i64, status: i64) -> i64 {
  let entry = module_scope_new_entry(module_entry, name_ptr, name_len, module_scope_kind_issue(), target, import_entry, module_visibility_private(), status)
  nlist_add(module_fact_scopes(tt), entry)
  entry
}

fn module_scope_same_package(a: i64, b: i64) -> i64 {
  if module_fact_entry_package(a) == module_fact_entry_package(b) { 1 } else { 0 }
}

fn module_scope_entry_visible_from(entry: i64, importer_module: i64) -> i64 {
  let visibility = module_scope_entry_visibility(entry)
  if module_scope_entry_module(entry) == importer_module { 1 }
  else { if visibility == module_visibility_public() { 1 }
  else { if visibility == module_visibility_package() and module_scope_same_package(module_scope_entry_module(entry), importer_module) == 1 { 1 }
  else { 0 } } }
}

fn module_scope_add_local_declarations(tt: i64, module_entry: i64) -> i64 {
  let decls = module_fact_decls(tt)
  for i in 0..nlist_len(decls) {
    let decl = nlist_get(decls, i)
    let module_item = if module_decl_fact_owner(decl) == 0 { 1 }
      else { if module_decl_fact_namespace(decl) == module_decl_namespace_constructor() { 1 } else { 0 } }
    if module_decl_fact_module(decl) == module_entry and module_item == 1 {
      module_scope_add_binding(tt, module_entry, module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl), module_scope_kind_declaration(), decl, 0, module_decl_fact_visibility_code(decl))
    } else { 0 }
  }
  0
}

fn module_scope_import_binding(tt: i64, import_entry: i64, target_binding: i64, local_name_ptr: i64, local_name_len: i64) -> i64 {
  let importer = module_import_fact_importer(import_entry)
  let requested_visibility = module_import_fact_visibility_code(import_entry)
  let legacy = module_import_fact_is_legacy(import_entry)
  if module_scope_entry_status(target_binding) == module_scope_status_ambiguous() {
    module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_ambiguous())
  } else { if legacy == 0 and module_scope_entry_visible_from(target_binding, importer) == 0 {
    module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_invisible())
  } else { if legacy == 0 and requested_visibility > module_scope_entry_visibility(target_binding) {
    module_scope_add_issue(tt, importer, local_name_ptr, local_name_len, module_scope_entry_target(target_binding), import_entry, module_scope_status_widened_reexport())
  } else {
    module_scope_add_binding(tt, importer, local_name_ptr, local_name_len, module_scope_entry_kind(target_binding), module_scope_entry_target(target_binding), import_entry, requested_visibility)
  } } }
}

fn module_scope_add_wildcard_import(tt: i64, import_entry: i64) -> i64 {
  let target_module = module_import_fact_target(import_entry)
  let importer = module_import_fact_importer(import_entry)
  let requested_visibility = module_import_fact_visibility_code(import_entry)
  let legacy = module_import_fact_is_legacy(import_entry)
  -- Snapshot the target scope: additions to the importer must not become new
  -- wildcard candidates when resolving a diamond.
  let scopes = module_fact_scopes(tt)
  let n = nlist_len(scopes)
  for i in 0..n {
    let target_binding = nlist_get(scopes, i)
    if module_scope_entry_module(target_binding) == target_module and module_scope_entry_kind(target_binding) != module_scope_kind_issue() {
      -- Wildcard means every export at the requested tier, not an error for
      -- each deliberately private declaration. Explicit selections retain
      -- targeted invisible/widening issues through module_scope_import_binding.
      if legacy == 1 or (module_scope_entry_visible_from(target_binding, importer) == 1 and requested_visibility <= module_scope_entry_visibility(target_binding)) {
        module_scope_import_binding(tt, import_entry, target_binding, module_scope_entry_name_ptr(target_binding), module_scope_entry_name_len(target_binding))
      } else { 0 }
    } else { 0 }
  }
  0
}

fn module_scope_add_selected_import(tt: i64, import_entry: i64, selection: i64) -> i64 {
  let name_ptr = node_f1(selection)
  let name_len = node_f2(selection)
  if name_len < 0 { module_scope_add_wildcard_import(tt, import_entry) }
  else {
    let target_binding = module_scope_find_binding(tt, module_import_fact_target(import_entry), name_ptr, name_len)
    let alias_ptr = if node_f4(selection) > 0 { node_f3(selection) } else { name_ptr }
    let alias_len = if node_f4(selection) > 0 { node_f4(selection) } else { name_len }
    if target_binding == 0 {
      module_scope_add_issue(tt, module_import_fact_importer(import_entry), alias_ptr, alias_len, 0, import_entry, module_scope_status_missing())
    } else {
      module_scope_import_binding(tt, import_entry, target_binding, alias_ptr, alias_len)
    }
  }
}

fn module_scope_add_import(tt: i64, import_entry: i64) -> i64 {
  let selection_count = module_import_fact_selection_count(import_entry)
  if selection_count == 0 {
    module_scope_add_binding(tt, module_import_fact_importer(import_entry), module_import_fact_alias_ptr(import_entry), module_import_fact_alias_len(import_entry), module_scope_kind_module(), module_import_fact_target(import_entry), import_entry, module_import_fact_visibility_code(import_entry))
  } else {
    for i in 0..selection_count {
      module_scope_add_selected_import(tt, import_entry, module_import_fact_selection_at(import_entry, i))
    }
  }
  0
}

fn module_scope_build_module(tt: i64, module_entry: i64) -> i64 {
  let state = module_fact_entry_scope_state(module_entry)
  if state == 2 { 0 }
  else { if state == 1 { 0 }
  else {
    mem_store64_at(module_entry + 48, 0, 1)
    module_scope_add_local_declarations(tt, module_entry)
    let imports = module_fact_imports(tt)
    for i in 0..nlist_len(imports) {
      let import_entry = nlist_get(imports, i)
      if module_import_fact_importer(import_entry) == module_entry {
        module_scope_build_module(tt, module_import_fact_target(import_entry))
        module_scope_add_import(tt, import_entry)
      } else { 0 }
    }
    mem_store64_at(module_entry + 48, 0, 2)
    0
  } }
}

fn module_scope_build_all(tt: i64) -> i64 {
  let modules = module_fact_modules(tt)
  for i in 0..nlist_len(modules) {
    module_scope_build_module(tt, nlist_get(modules, i))
  }
  0
}

fn module_scope_lookup(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { 0 }
  else { module_scope_find_binding(tt, module_entry, name_src + name_start, name_len) }
}

fn module_scope_lookup_declaration(tt: i64, src: i64, namespace: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  let binding = module_scope_lookup(tt, src, name_src, name_start, name_len)
  let usable = if binding == 0 { 0 }
    else { if module_scope_entry_status(binding) == module_scope_status_resolved() { 1 }
    else { module_scope_entry_has_legacy_collision(binding) } }
  if binding == 0 or usable == 0 or module_scope_entry_kind(binding) != module_scope_kind_declaration() { 0 }
  else {
    let decl = module_scope_entry_target(binding)
    if module_decl_fact_namespace(decl) == namespace { decl } else { 0 }
  }
}

-- Resolve the second half of `module.member` without flattening it into the
-- caller's spelling scope.  The returned entry is intentionally the target
-- module's producer-owned scope fact: consumers can distinguish missing,
-- ambiguous, invisible, and wrong-namespace members before selecting a
-- declaration identity.
fn module_scope_lookup_qualified_entry(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, src)
  if caller_module == 0 { 0 }
  else {
    let qualifier = module_scope_find_binding(tt, caller_module, module_name_src + module_name_start, module_name_len)
    if qualifier == 0 or module_scope_entry_status(qualifier) != module_scope_status_resolved() or module_scope_entry_kind(qualifier) != module_scope_kind_module() { 0 }
    else {
      module_scope_find_binding(tt, module_scope_entry_target(qualifier), member_name_src + member_name_start, member_name_len)
    }
  }
}

fn module_scope_qualifier_is_module(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> i64 {
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, src)
  if caller_module == 0 { 0 }
  else {
    let qualifier = module_scope_find_binding(tt, caller_module, name_src + name_start, name_len)
    if qualifier != 0 and module_scope_entry_status(qualifier) == module_scope_status_resolved() and module_scope_entry_kind(qualifier) == module_scope_kind_module() { 1 } else { 0 }
  }
}

fn module_scope_lookup_qualified_declaration(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, namespace: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> i64 {
  let caller_module = module_fact_find_source(tt, src)
  let entry = module_scope_lookup_qualified_entry(tt, src, module_name_src, module_name_start, module_name_len, member_name_src, member_name_start, member_name_len)
  if caller_module == 0 { 0 }
  else { if entry != 0 and module_scope_entry_status(entry) == module_scope_status_ambiguous() {
    -- A type and its same-spelled constructor deliberately occupy distinct
    -- namespaces. Resolve the namespace requested by the consumer instead of
    -- treating that cross-namespace pair as a semantic ambiguity.
    let qualifier = module_scope_find_binding(tt, caller_module, module_name_src + module_name_start, module_name_len)
    if qualifier == 0 or module_scope_entry_status(qualifier) != module_scope_status_resolved() or module_scope_entry_kind(qualifier) != module_scope_kind_module() { 0 }
    else {
      let target_module = module_scope_entry_target(qualifier)
      let decl = module_decl_fact_find(tt, module_fact_entry_source(target_module), namespace, member_name_src, member_name_start, member_name_len)
      if decl != 0 and module_decl_fact_visible_from(tt, decl, caller_module) == 1 { decl } else { 0 }
    }
  } else { if entry == 0 or module_scope_entry_status(entry) != module_scope_status_resolved() or module_scope_entry_kind(entry) != module_scope_kind_declaration() or module_scope_entry_visible_from(entry, caller_module) == 0 { 0 }
  else {
    let decl = module_scope_entry_target(entry)
    if module_decl_fact_namespace(decl) == namespace { decl } else { 0 }
  } } }
}

fn module_scope_resolution(entry: i64) -> ModuleNameResolution {
  if entry == 0 { MissingModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_ambiguous() { AmbiguousModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_missing() { MissingModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_invisible() { InvisibleModuleName() }
  else { if module_scope_entry_status(entry) == module_scope_status_widened_reexport() { WidenedReexportName() }
  else { if module_scope_entry_kind(entry) == module_scope_kind_module() {
    ResolvedModuleName(module_id_from_entry(module_scope_entry_target(entry)))
  } else {
    ResolvedDeclarationName(module_decl_fact_id(module_scope_entry_target(entry)))
  } } } } } }
}

-- Stable tooling queries return typed semantic values and keep the raw scope
-- registry private to the compiler. Callers never need to decode entry
-- addresses or status integers.
fn module_resolve_name(tt: i64, src: i64, name_src: i64, name_start: i64, name_len: i64) -> ModuleNameResolution {
  module_scope_build_all(tt)
  let module_entry = module_fact_find_source(tt, src)
  if module_entry == 0 { MissingModuleName() }
  else {
    let name_ptr = name_src + name_start
    let binding = module_scope_find_binding(tt, module_entry, name_ptr, name_len)
    if binding != 0 { module_scope_resolution(binding) }
    else {
      let ambiguous = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_ambiguous())
      let invisible = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_invisible())
      let widened = module_scope_find_issue(tt, module_entry, name_ptr, name_len, module_scope_status_widened_reexport())
      if ambiguous != 0 { AmbiguousModuleName() }
      else { if invisible != 0 { InvisibleModuleName() }
      else { if widened != 0 { WidenedReexportName() }
      else { MissingModuleName() } } }
    }
  }
}

fn module_resolve_qualified_name(tt: i64, src: i64, module_name_src: i64, module_name_start: i64, module_name_len: i64, member_name_src: i64, member_name_start: i64, member_name_len: i64) -> ModuleNameResolution {
  let caller_module = module_fact_find_source(tt, src)
  let entry = module_scope_lookup_qualified_entry(tt, src, module_name_src, module_name_start, module_name_len, member_name_src, member_name_start, member_name_len)
  if entry == 0 { MissingModuleName() }
  else { if caller_module == 0 or module_scope_entry_visible_from(entry, caller_module) == 0 { InvisibleModuleName() }
  else { module_scope_resolution(entry) } }
}

fn module_decl_id_namespace(id: DeclId) -> i64 {
  match id {
    ModuleDeclId(module_id, namespace, name_ptr, name_len) -> namespace
    MemberDeclId(owner, namespace, name_ptr, name_len) -> namespace
  }
}

fn module_decl_id_name_len(id: DeclId) -> i64 {
  match id {
    ModuleDeclId(module_id, namespace, name_ptr, name_len) -> name_len
    MemberDeclId(owner, namespace, name_ptr, name_len) -> name_len
  }
}
