-- compiler/pipeline_match.weft -- Match lowering helpers

fn pipeline_match_ctor_arms_exhaustive(tt: i64, src: i64, arms: i64, n_arms: i64, tag_ns: i64, tag_nl: i64) -> i64 {
  pipeline_match_ctor_arms_exhaustive_typed(tt, src, match_arm_list_from_nodes(arms, 0, n_arms), tag_ns, tag_nl)
}

fn pipeline_match_variant_name_matches(src: i64, entry_src: i64, variant: TypeVariant, tag_ns: i64, tag_nl: i64) -> i64 {
  match variant {
    TypeVariant(variant_ns, variant_nl, payload_count, payloads) -> {
      if variant_nl == tag_nl {
        src_eq_at(src, tag_ns, entry_src + variant_ns, 0, tag_nl)
      } else {
        0
      }
    }
    MissingTypeVariant -> 0
  }
}

fn pipeline_match_variant_list_has_name(src: i64, entry_src: i64, variants: TypeVariantList, tag_ns: i64, tag_nl: i64) -> i64 {
  match variants {
    TypeVariantListNil -> 0
    TypeVariantListCons(variant, rest) -> {
      if pipeline_match_variant_name_matches(src, entry_src, variant, tag_ns, tag_nl) == 1 {
        1
      } else {
        pipeline_match_variant_list_has_name(src, entry_src, rest, tag_ns, tag_nl)
      }
    }
  }
}

fn pipeline_match_arm_has_ctor_typed(arms: MatchArmList, src: i64, entry_src: i64, variant: TypeVariant) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          match pattern {
            CtorPattern(tag_ns, tag_nl, bindings) -> {
              if has_guard == 0 {
                pipeline_match_variant_name_matches(src, entry_src, variant, tag_ns, tag_nl)
              } else {
                0
              }
            }
            _ -> 0
          }
        }
        _ -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arm_has_ctor_typed(rest, src, entry_src, variant) }
    }
  }
}

fn pipeline_match_arms_cover_variants_typed(arms: MatchArmList, src: i64, entry_src: i64, variants: TypeVariantList) -> i64 {
  match variants {
    TypeVariantListNil -> 1
    TypeVariantListCons(variant, rest) -> {
      if pipeline_match_arm_has_ctor_typed(arms, src, entry_src, variant) == 1 {
        pipeline_match_arms_cover_variants_typed(arms, src, entry_src, rest)
      } else {
        0
      }
    }
  }
}

fn pipeline_match_ctor_entry_exhaustive_typed(entry: TypeEntry, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  match entry {
    TypeVariantEntry(name, tparams, variants) -> {
      let entry_src = type_entry_source_or(entry, 0)
      if pipeline_match_variant_list_has_name(src, entry_src, variants, tag_ns, tag_nl) == 1 {
        pipeline_match_arms_cover_variants_typed(arms, src, entry_src, variants)
      } else {
        0 - 1
      }
    }
    _ -> 0 - 1
  }
}

fn pipeline_match_ctor_entries_exhaustive_typed(entries: TypeEntryList, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  match entries {
    TypeEntryListNil -> 0
    TypeEntryListCons(entry, rest) -> {
      let found = pipeline_match_ctor_entry_exhaustive_typed(entry, src, arms, tag_ns, tag_nl)
      if found >= 0 {
        found
      } else {
        pipeline_match_ctor_entries_exhaustive_typed(rest, src, arms, tag_ns, tag_nl)
      }
    }
  }
}

fn pipeline_match_ctor_arms_exhaustive_typed(tt: i64, src: i64, arms: MatchArmList, tag_ns: i64, tag_nl: i64) -> i64 {
  if tt == 0 {
    0
  } else {
    pipeline_match_ctor_entries_exhaustive_typed(type_entries_from_table(tt), src, arms, tag_ns, tag_nl)
  }
}

fn pipeline_lower_match_body_to_blocks(body: i64, locals: PipelineValueEnv, entry_insts: IrInstList, ctx: PipelineMatchCtx, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, outer_locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      if pipeline_expr_needs_cfg(body) == 1 {
        let body_start = if target_block == start_block + 1 { start_block + 2 } else { start_block + 1 }
        let body_next = if target_block == body_start + 1 { body_start + 2 } else { body_start + 1 }
        let body_blocks = pipeline_lower_expr_to_target_blocks_reserved(body, params, locals, module, next_value, body_start, body_next, target_block)
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(body_start))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(body_blocks))
          pipeline_lowered_blocks_control(
            pipeline_lowered_blocks_next_block(body_blocks),
            pipeline_lowered_blocks_next_value(body_blocks),
            blocks,
            1,
            pipeline_lowered_blocks_falls_through(body_blocks)
          )
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        let lowered = pipeline_lower_expr_sidecar(body, params, locals, src, tt, next_value)
        if ir_lowered_expr_is_valid(lowered) == 1 {
          let args = ir_value_list_prepend(ir_lowered_expr_value(lowered), ir_value_list_empty())
          let insts = ir_inst_list_append(entry_insts, ir_lowered_expr_insts(lowered))
          let block = ir_block_new_term(start_block, insts, ir_term_jump_args(target_block, args))
          pipeline_lowered_blocks(start_block + 1, ir_lowered_expr_next_value(lowered), ir_block_list_prepend(block, ir_block_list_empty()), 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_lower_match_ctor_body_to_blocks(pat: i64, body: i64, ctx: PipelineMatchCtx, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let tag_hash = pipeline_variant_tag_hash(tt, src, node_f1(pat), node_f2(pat))
      if tag_hash < 0 {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let b_nl = node_f4(pat)
        if b_nl < 0 {
          pipeline_lower_match_multi_ctor_body_to_blocks(pat, body, ctx, next_value, start_block)
        } else {
          let payload_insts = if b_nl > 0 {
            ir_inst_list_prepend(ir_inst_variant_payload_i64(next_value, scrutinee_value, 0), ir_inst_list_empty())
          } else {
            ir_inst_list_empty()
          }
          let payload_locals = if b_nl > 0 {
            pipeline_value_env_push(locals, node_f3(pat), b_nl, next_value)
          } else {
            locals
          }
          let body_start_value = if b_nl > 0 { next_value + 1 } else { next_value }
          pipeline_lower_match_body_to_blocks(body, payload_locals, payload_insts, ctx, body_start_value, start_block)
        }
      }
    }
  }
}

fn pipeline_lower_match_multi_ctor_body_to_blocks(pat: i64, body: i64, ctx: PipelineMatchCtx, next_value: i64, start_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      let bindings = node_f3(pat)
      let nb = 0 - node_f4(pat)
      let mut insts = ir_inst_list_empty()
      let mut body_locals = locals
      let mut body_start_value = next_value
      let mut i = 0
      while i < nb {
        let b = nlist_get(bindings, i)
        if node_tag(b) == 18 {
          let value = body_start_value
          let payload = ir_inst_list_prepend(ir_inst_variant_payload_i64(value, scrutinee_value, i), ir_inst_list_empty())
          insts = ir_inst_list_append(insts, payload)
          body_locals = pipeline_value_env_push(body_locals, node_f1(b), node_f2(b), value)
          body_start_value = body_start_value + 1
        } else {
          body_locals = body_locals
        }
        i = i + 1
      }
      pipeline_lower_match_body_to_blocks(body, body_locals, insts, ctx, body_start_value, start_block)
    }
  }
}

fn pipeline_lower_match_guarded_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, arm_locals: PipelineValueEnv, entry_insts: IrInstList, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      if index + 1 >= n_arms {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let src = pipeline_lower_module_src(module)
        let tt = pipeline_lower_module_tt(module)
        let arm = nlist_get(arms, index)
        let guard = node_f3(arm)
        if pipeline_expr_needs_cfg(guard) == 1 {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        } else {
          let guard_value = pipeline_lower_expr_sidecar(guard, params, arm_locals, src, tt, next_value)
          if ir_lowered_expr_is_valid(guard_value) == 1 {
            let body_start = next_block
            let body_blocks = pipeline_lower_match_body_to_blocks(node_f2(arm), arm_locals, ir_inst_list_empty(), ctx, ir_lowered_expr_next_value(guard_value), body_start)
            if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
              let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
              let rest_blocks = pipeline_lower_match_arm_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
              if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                let guard_insts = ir_inst_list_append(entry_insts, ir_lowered_expr_insts(guard_value))
                let guard_block = ir_block_new_term(start_block, guard_insts, ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
                let blocks = ir_block_list_prepend(
                  guard_block,
                  ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
                )
                let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      }
    }
  }
}

fn pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, arm_locals: PipelineValueEnv, entry_insts: IrInstList, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      if index + 1 >= n_arms {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let arm = nlist_get(arms, index)
        let guard = node_f3(arm)
        let rest_gate_block = next_block
        let guard_start = next_block + 1
        let guard_merge_block = next_block + 2
        let guard_blocks = pipeline_lower_expr_to_target_blocks_reserved(guard, params, arm_locals, module, next_value, guard_start, guard_merge_block + 1, guard_merge_block)
        if pipeline_lowered_blocks_is_valid(guard_blocks) == 1 {
          if pipeline_lowered_blocks_falls_through(guard_blocks) == 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let guard_value = pipeline_lowered_blocks_next_value(guard_blocks)
            let body_start = pipeline_lowered_blocks_next_block(guard_blocks)
            let body_blocks = pipeline_lower_match_body_to_blocks(node_f2(arm), arm_locals, ir_inst_list_empty(), ctx, guard_value + 1, body_start)
            if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
              let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
              let rest_blocks = pipeline_lower_match_arm_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
              if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                let guard_params = ir_value_list_prepend(guard_value, ir_value_list_empty())
                let entry = ir_block_new_term(start_block, entry_insts, ir_term_jump(guard_start))
                let guard_merge = ir_block_new_params(guard_merge_block, guard_params, ir_inst_list_empty(), ir_term_branch(guard_value, body_start, rest_gate_block))
                let rest_gate = ir_block_new_term(rest_gate_block, ir_inst_list_empty(), ir_term_jump(rest_start))
                let blocks = ir_block_list_prepend(
                  entry,
                  ir_block_list_append(
                    pipeline_lowered_blocks_blocks(guard_blocks),
                    ir_block_list_prepend(
                      guard_merge,
                      ir_block_list_append(
                        pipeline_lowered_blocks_blocks(body_blocks),
                        ir_block_list_prepend(rest_gate, pipeline_lowered_blocks_blocks(rest_blocks))
                      )
                    )
                  )
                )
                let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_lower_match_tested_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      let src = pipeline_lower_module_src(module)
      let tt = pipeline_lower_module_tt(module)
      let arm = nlist_get(arms, index)
      let pat = node_f1(arm)
      let pat_tag = node_tag(pat)
      let tag_value = next_value
      let expected_value = next_value + 1
      let cmp_value = next_value + 2
      let expected_inst = if pat_tag == 19 {
        ir_inst_const_i64(expected_value, node_f1(pat))
      } else {
        ir_inst_const_i64(expected_value, pipeline_variant_tag_hash(tt, src, node_f1(pat), node_f2(pat)))
      }
      let tag_insts = if pat_tag == 19 {
        ir_inst_list_empty()
      } else {
        ir_inst_list_prepend(ir_inst_variant_tag_i64(tag_value, scrutinee_value), ir_inst_list_empty())
      }
      let compare_left = if pat_tag == 19 { scrutinee_value } else { tag_value }
      let compare_insts = ir_inst_list_append(
        tag_insts,
        ir_inst_list_prepend(
          expected_inst,
          ir_inst_list_prepend(ir_inst_binary_i64(cmp_value, ir_binary_op_eq(), compare_left, expected_value), ir_inst_list_empty())
        )
      )
      let guard = node_f3(arm)
      if guard != 0 {
        if pat_tag == 20 {
          let tag_hash = pipeline_variant_tag_hash(tt, src, node_f1(pat), node_f2(pat))
          if tag_hash < 0 {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          } else {
            let b_nl = node_f4(pat)
            let mut payload_insts = ir_inst_list_empty()
            let mut payload_locals = locals
            let mut guard_start_value = cmp_value + 1
            if b_nl < 0 {
              let bindings = node_f3(pat)
              let nb = 0 - b_nl
              let mut i = 0
              while i < nb {
                let b = nlist_get(bindings, i)
                if node_tag(b) == 18 {
                  let value = guard_start_value
                  let payload = ir_inst_list_prepend(ir_inst_variant_payload_i64(value, scrutinee_value, i), ir_inst_list_empty())
                  payload_insts = ir_inst_list_append(payload_insts, payload)
                  payload_locals = pipeline_value_env_push(payload_locals, node_f1(b), node_f2(b), value)
                  guard_start_value = guard_start_value + 1
                } else {
                  payload_locals = payload_locals
                }
                i = i + 1
              }
            } else {
              if b_nl > 0 {
                payload_insts = ir_inst_list_prepend(ir_inst_variant_payload_i64(guard_start_value, scrutinee_value, 0), ir_inst_list_empty())
                payload_locals = pipeline_value_env_push(locals, node_f3(pat), b_nl, guard_start_value)
                guard_start_value = guard_start_value + 1
              } else {
                payload_locals = locals
              }
            }
            let guard_start = next_block
            let body_start = next_block + 1
            if pipeline_expr_needs_cfg(guard) == 1 {
              let rest_gate = next_block + 1
              let guarded_blocks = pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, payload_locals, payload_insts, guard_start_value, guard_start, rest_gate)
              if pipeline_lowered_blocks_is_valid(guarded_blocks) == 1 {
                let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_gate))
                let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(guarded_blocks))
                pipeline_lowered_blocks_control(
                  pipeline_lowered_blocks_next_block(guarded_blocks),
                  pipeline_lowered_blocks_next_value(guarded_blocks),
                  blocks,
                  1,
                  pipeline_lowered_blocks_falls_through(guarded_blocks)
                )
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            } else {
              let guard_value = pipeline_lower_expr_sidecar(guard, params, payload_locals, src, tt, guard_start_value)
              if ir_lowered_expr_is_valid(guard_value) == 1 {
                let body_blocks = pipeline_lower_match_body_to_blocks(node_f2(arm), payload_locals, ir_inst_list_empty(), ctx, ir_lowered_expr_next_value(guard_value), body_start)
                if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
                  let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
                  let rest_blocks = pipeline_lower_match_arm_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
                  if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                    let guard_insts = ir_inst_list_append(payload_insts, ir_lowered_expr_insts(guard_value))
                    let guard_block = ir_block_new_term(guard_start, guard_insts, ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
                    let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_start))
                    let blocks = ir_block_list_prepend(
                      entry,
                      ir_block_list_prepend(
                        guard_block,
                        ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
                      )
                    )
                    let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                    pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
                  } else {
                    pipeline_lowered_blocks_invalid(start_block, next_value)
                  }
                } else {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                }
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            }
          }
        } else {
          let guard_start = next_block
          let body_start = next_block + 1
          if pipeline_expr_needs_cfg(guard) == 1 {
            let rest_gate = next_block + 1
            let guarded_blocks = pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, locals, ir_inst_list_empty(), cmp_value + 1, guard_start, rest_gate)
            if pipeline_lowered_blocks_is_valid(guarded_blocks) == 1 {
              let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_gate))
              let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(guarded_blocks))
              pipeline_lowered_blocks_control(
                pipeline_lowered_blocks_next_block(guarded_blocks),
                pipeline_lowered_blocks_next_value(guarded_blocks),
                blocks,
                1,
                pipeline_lowered_blocks_falls_through(guarded_blocks)
              )
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          } else {
            let guard_value = pipeline_lower_expr_sidecar(guard, params, locals, src, tt, cmp_value + 1)
            if ir_lowered_expr_is_valid(guard_value) == 1 {
              let body_blocks = pipeline_lower_match_body_to_blocks(node_f2(arm), locals, ir_inst_list_empty(), ctx, ir_lowered_expr_next_value(guard_value), body_start)
              if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
                let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
                let rest_blocks = pipeline_lower_match_arm_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
                if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
                  let guard_block = ir_block_new_term(guard_start, ir_lowered_expr_insts(guard_value), ir_term_branch(ir_lowered_expr_value(guard_value), body_start, rest_start))
                  let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, guard_start, rest_start))
                  let blocks = ir_block_list_prepend(
                    entry,
                    ir_block_list_prepend(
                      guard_block,
                      ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
                    )
                  )
                  let falls_through = if pipeline_lowered_blocks_falls_through(body_blocks) == 1 { 1 } else { pipeline_lowered_blocks_falls_through(rest_blocks) }
                  pipeline_lowered_blocks_control(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1, falls_through)
                } else {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                }
              } else {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              }
            } else {
              pipeline_lowered_blocks_invalid(start_block, next_value)
            }
          }
        }
      } else {
        let body_start = next_block
        let body_blocks = if pat_tag == 20 {
          pipeline_lower_match_ctor_body_to_blocks(pat, node_f2(arm), ctx, cmp_value + 1, body_start)
        } else {
          pipeline_lower_match_body_to_blocks(node_f2(arm), locals, ir_inst_list_empty(), ctx, cmp_value + 1, body_start)
        }
        if pipeline_lowered_blocks_is_valid(body_blocks) == 1 {
          let rest_start = pipeline_lowered_blocks_next_block(body_blocks)
          let rest_blocks = pipeline_lower_match_arm_to_blocks(ctx, index + 1, pipeline_lowered_blocks_next_value(body_blocks), rest_start, rest_start + 1)
          if pipeline_lowered_blocks_is_valid(rest_blocks) == 1 {
            let entry = ir_block_new_term(start_block, compare_insts, ir_term_branch(cmp_value, body_start, rest_start))
            let blocks = ir_block_list_prepend(
              entry,
              ir_block_list_append(pipeline_lowered_blocks_blocks(body_blocks), pipeline_lowered_blocks_blocks(rest_blocks))
            )
            pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(rest_blocks), pipeline_lowered_blocks_next_value(rest_blocks), blocks, 1)
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      }
    }
  }
}

fn pipeline_lower_match_arm_to_blocks(ctx: PipelineMatchCtx, index: i64, next_value: i64, start_block: i64, next_block: i64) -> PipelineLoweredBlocks {
  match ctx {
    PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, target_block) -> {
      if index >= n_arms {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      } else {
        let arm = nlist_get(arms, index)
        let pat = node_f1(arm)
        let pat_tag = node_tag(pat)
        if node_f3(arm) != 0 {
          match pat_tag {
            17 -> {
              if pipeline_expr_needs_cfg(node_f3(arm)) == 1 {
                pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, locals, ir_inst_list_empty(), next_value, start_block, next_block)
              } else {
                pipeline_lower_match_guarded_arm_to_blocks(ctx, index, locals, ir_inst_list_empty(), next_value, start_block, next_block)
              }
            }
            18 -> {
              let match_locals = pipeline_value_env_push(locals, node_f1(pat), node_f2(pat), scrutinee_value)
              if pipeline_expr_needs_cfg(node_f3(arm)) == 1 {
                pipeline_lower_match_cfg_guarded_arm_to_blocks(ctx, index, match_locals, ir_inst_list_empty(), next_value, start_block, next_block)
              } else {
                pipeline_lower_match_guarded_arm_to_blocks(ctx, index, match_locals, ir_inst_list_empty(), next_value, start_block, next_block)
              }
            }
            19 -> pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
            20 -> {
              if index + 1 >= n_arms {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
              }
            }
            _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        } else {
          match pat_tag {
            17 -> pipeline_lower_match_body_to_blocks(node_f2(arm), locals, ir_inst_list_empty(), ctx, next_value, start_block)
            18 -> {
              let match_locals = pipeline_value_env_push(locals, node_f1(pat), node_f2(pat), scrutinee_value)
              pipeline_lower_match_body_to_blocks(node_f2(arm), match_locals, ir_inst_list_empty(), ctx, next_value, start_block)
            }
            19 -> {
              if index + 1 >= n_arms {
                pipeline_lowered_blocks_invalid(start_block, next_value)
              } else {
                pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
              }
            }
            20 -> {
              if index + 1 >= n_arms {
                let src = pipeline_lower_module_src(module)
                let tt = pipeline_lower_module_tt(module)
                if pipeline_match_ctor_arms_exhaustive(tt, src, arms, n_arms, node_f1(pat), node_f2(pat)) == 1 {
                  pipeline_lower_match_ctor_body_to_blocks(pat, node_f2(arm), ctx, next_value, start_block)
                } else {
                  pipeline_lowered_blocks_invalid(start_block, next_value)
                }
              } else {
                pipeline_lower_match_tested_arm_to_blocks(ctx, index, next_value, start_block, next_block)
              }
            }
            _ -> pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      }
    }
  }
}
