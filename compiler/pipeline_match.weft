-- compiler/pipeline_match.weft -- Match lowering helpers

fn pipeline_match_arm_has_ctor(arms: i64, n_arms: i64, src: i64, entry_src: i64, variant_ns: i64, variant_nl: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < n_arms {
    let pat = node_f1(nlist_get(arms, i))
    if node_tag(pat) == 20 {
      if node_f2(pat) == variant_nl {
        if src_eq_at(src, node_f1(pat), entry_src + variant_ns, 0, variant_nl) == 1 {
          result = 1
          i = n_arms
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  result
}

fn pipeline_match_arms_cover_variants(arms: i64, n_arms: i64, src: i64, entry_src: i64, variants: i64, nvariants: i64) -> i64 {
  let mut vi = 0
  let mut result = 1
  while vi < nvariants {
    let v_ns = __mem_load64(variants + vi * 40)
    let v_nl = __mem_load64(variants + vi * 40 + 8)
    if pipeline_match_arm_has_ctor(arms, n_arms, src, entry_src, v_ns, v_nl) == 1 {
      vi = vi + 1
    } else {
      result = 0
      vi = nvariants
    }
  }
  result
}

fn pipeline_match_ctor_arms_exhaustive(tt: i64, src: i64, arms: i64, n_arms: i64, tag_ns: i64, tag_nl: i64) -> i64 {
  if tt == 0 {
    0
  } else {
    let n = __mem_load64(tt + 8)
    let d = __mem_load64(tt)
    let mut ti = 0
    let mut result = 0
    while ti < n {
      let kind = __mem_load64(d + ti * 56 + 16)
      if kind == 1 {
        let nvariants = __mem_load64(d + ti * 56 + 24)
        let variants = __mem_load64(d + ti * 56 + 32)
        let entry_src = __mem_load64(d + ti * 56 + 48)
        let mut vi = 0
        let mut found = 0
        while vi < nvariants {
          let v_ns = __mem_load64(variants + vi * 40)
          let v_nl = __mem_load64(variants + vi * 40 + 8)
          if v_nl == tag_nl {
            if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
              result = pipeline_match_arms_cover_variants(arms, n_arms, src, entry_src, variants, nvariants)
              found = 1
              vi = nvariants
            } else {
              vi = vi + 1
            }
          } else {
            vi = vi + 1
          }
        }
        if found == 1 {
          ti = n
        } else {
          ti = ti + 1
        }
      } else {
        ti = ti + 1
      }
    }
    result
  }
}
