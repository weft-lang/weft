-- compiler/grammar_registry.weft -- first-party embedded grammar registry
--
-- Grammar modules stay behind this boundary so tools can dispatch by module id
-- instead of reaching into a grammar's private AST helpers directly.

use "compiler/lib.weft"
use "compiler/diagnose.weft"
use "compiler/typecheck_effect.weft"
use "compiler/mini_sql.weft"

fn grammar_module_unknown() -> i64 { 0 }
fn grammar_module_mini_sql() -> i64 { 1 }

fn grammar_module_origin_unknown() -> i64 { 0 }
fn grammar_module_origin_first_party() -> i64 { 1 }
fn grammar_module_origin_package() -> i64 { 2 }

fn grammar_module_name(module_id: i64) -> str {
  match module_id {
    1 -> "mini_sql"
    _ -> ""
  }
}

fn grammar_module_public_name(module_id: i64) -> str {
  match module_id {
    1 -> "sql"
    _ -> ""
  }
}

fn grammar_module_origin(module_id: i64) -> i64 {
  match module_id {
    1 -> grammar_module_origin_first_party()
    _ -> grammar_module_origin_unknown()
  }
}

fn grammar_module_current_path(module_id: i64) -> str {
  match module_id {
    1 -> "compiler/mini_sql.weft"
    _ -> ""
  }
}

fn grammar_module_target_import_path(module_id: i64) -> str {
  match module_id {
    1 -> "stdlib/grammar/sql.weft"
    _ -> ""
  }
}

fn grammar_module_name_eq(name_ptr: i64, name_n: i64, expected: str) -> i64 {
  if name_ptr == 0 { 0 }
  else {
    let expected_n = __str_len(expected)
    if name_n != expected_n { 0 }
    else { src_eq_at(name_ptr, 0, __str_ptr(expected), 0, expected_n) }
  }
}

fn grammar_module_lookup(name_ptr: i64, name_n: i64) -> i64 {
  if grammar_module_name_eq(name_ptr, name_n, "mini_sql") == 1 {
    grammar_module_mini_sql()
  } else {
    grammar_module_unknown()
  }
}

fn grammar_module_parse(module_id: i64, src: i64, n: i64, tt: i64) -[Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_parse_source(src, n, tt)
    _ -> 0
  }
}

fn grammar_module_check_catalog(module_id: i64, ast: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_check_ast(ast, src, tt)
    _ -> 0
  }
}

fn grammar_module_check_host(module_id: i64, ast: i64, src: i64, host_tt: i64) -[TypeCheck, Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_check_ast_host(ast, src, host_tt)
    _ -> 0
  }
}

fn grammar_module_root_tag(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> if ast == 0 { 0 } else { node_tag(ast) }
    _ -> 0
  }
}

fn grammar_module_column_count(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_column_count(ast)
    _ -> 0
  }
}

fn grammar_module_star(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_star(ast)
    _ -> 0
  }
}

fn grammar_module_distinct(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_distinct(ast)
    _ -> 0
  }
}

fn grammar_module_has_where(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_has_where(ast)
    _ -> 0
  }
}

fn grammar_module_table_node(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_table_node(ast)
    _ -> 0
  }
}

fn grammar_module_ident_start(module_id: i64, ident: i64) -> i64 {
  match module_id {
    1 -> mini_sql_ident_start(ident)
    _ -> 0
  }
}

fn grammar_module_ident_len(module_id: i64, ident: i64) -> i64 {
  match module_id {
    1 -> mini_sql_ident_len(ident)
    _ -> 0
  }
}
