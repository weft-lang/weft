-- compiler/grammar_registry.weft -- first-party embedded grammar registry
--
-- Grammar modules stay behind this boundary so tools can dispatch by module id
-- instead of reaching into a grammar's private AST helpers directly.

use compiler/lib.{*}
use compiler/diagnose.{*}
use stdlib/diagnostic/schema.{Diagnose}
use compiler/typecheck_effect.{*}
use stdlib/grammar/sql.{*}
use stdlib/grammar.{Grammar, CheckedGrammar, ParseResult, Parsed, Recovered, Rejected, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/syntax.{SqlSyntax, SqlSelection, SqlSelectAll, SqlSelect}
use stdlib/grammar/einsum as einsum
use stdlib/grammar/einsum/check as einsum_check
use stdlib/grammar/einsum/plan.{EinsumOperandSpecs, EinsumPlan}
use stdlib/grammar/einsum/syntax.{EinsumSyntax}
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{Option, Some, None}
use stdlib/source.{Span}
use stdlib/typecheck as public_typecheck

-- The dynamic registry closes over the associated types of first-party
-- grammars. Adding a grammar adds variants here, not a public raw-node ABI.
pub(package) type GrammarModuleSyntax {
  GrammarModuleSqlSyntax(SqlSyntax),
  GrammarModuleEinsumSyntax(EinsumSyntax)
}

pub(package) type GrammarModulePlan<I> {
  GrammarModuleSqlPlan(SqlPlan<I>),
  GrammarModuleEinsumPlan(EinsumPlan<I>)
}

pub(package) type GrammarModuleCheckContext<I> {
  GrammarModuleDefaultContext,
  GrammarModuleEinsumContext(EinsumOperandSpecs<I>)
}

pub(package) fn grammar_module_parse_syntax(module_id: i64, source: Span) -[Diagnose]> ParseResult<GrammarModuleSyntax> {
  match module_id {
    1 -> match sql.grammar().parse(source) {
      Parsed(syntax) -> Parsed<GrammarModuleSyntax>(GrammarModuleSqlSyntax(syntax))
      Recovered(syntax) -> Recovered<GrammarModuleSyntax>(GrammarModuleSqlSyntax(syntax))
      Rejected -> Rejected<GrammarModuleSyntax>()
    }
    2 -> match einsum.grammar().parse(source) {
      Parsed(syntax) -> Parsed<GrammarModuleSyntax>(GrammarModuleEinsumSyntax(syntax))
      Recovered(syntax) -> Recovered<GrammarModuleSyntax>(GrammarModuleEinsumSyntax(syntax))
      Rejected -> Rejected<GrammarModuleSyntax>()
    }
    _ -> Rejected<GrammarModuleSyntax>()
  }
}

pub(package) fn grammar_module_check_plan_with<I>(module_id: i64, syntax: GrammarModuleSyntax, context: GrammarModuleCheckContext<I>) -[public_typecheck.TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> {
  match (module_id, syntax, context) {
    (1, GrammarModuleSqlSyntax(sql_syntax), _) -> match sql_check.checker<I>().check(sql_syntax) {
      Checked(plan) -> Checked<GrammarModulePlan<I>>(GrammarModuleSqlPlan<I>(plan))
      CheckRejected -> CheckRejected<GrammarModulePlan<I>>()
    }
    (2, GrammarModuleEinsumSyntax(einsum_syntax), GrammarModuleEinsumContext(specs)) -> match einsum_check.checker<I>(specs).check(einsum_syntax) {
      Checked(plan) -> Checked<GrammarModulePlan<I>>(GrammarModuleEinsumPlan<I>(plan))
      CheckRejected -> CheckRejected<GrammarModulePlan<I>>()
    }
    _ -> CheckRejected<GrammarModulePlan<I>>()
  }
}

pub(package) fn grammar_module_check_plan<I>(module_id: i64, syntax: GrammarModuleSyntax) -[public_typecheck.TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> {
  grammar_module_check_plan_with<I>(module_id, syntax, GrammarModuleDefaultContext<I>())
}

fn grammar_module_list_count<T>(items: List<T>) -> i64 {
  match items { Nil -> 0, Cons(item, rest) -> 1 + grammar_module_list_count(rest) }
}

pub(package) fn grammar_module_syntax_root_tag(module_id: i64, syntax: GrammarModuleSyntax) -> i64 {
  match (module_id, syntax) { (1, GrammarModuleSqlSyntax(_)) -> mini_sql_query_tag(), _ -> 0 }
}

pub(package) fn grammar_module_syntax_column_count(module_id: i64, syntax: GrammarModuleSyntax) -> i64 {
  match (module_id, syntax) {
    (1, GrammarModuleSqlSyntax(sql_syntax)) -> match sql_syntax.query.selection {
      SqlSelectAll -> 0
      SqlSelect(items) -> grammar_module_list_count(items)
    }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_star(module_id: i64, syntax: GrammarModuleSyntax) -> i64 {
  match (module_id, syntax) {
    (1, GrammarModuleSqlSyntax(sql_syntax)) -> match sql_syntax.query.selection { SqlSelectAll -> 1, _ -> 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_distinct(module_id: i64, syntax: GrammarModuleSyntax) -> i64 {
  match (module_id, syntax) {
    (1, GrammarModuleSqlSyntax(sql_syntax)) -> if sql_syntax.query.distinct { 1 } else { 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_has_where(module_id: i64, syntax: GrammarModuleSyntax) -> i64 {
  match (module_id, syntax) {
    (1, GrammarModuleSqlSyntax(sql_syntax)) -> match sql_syntax.query.predicate { Some(_) -> 1, None -> 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_table(module_id: i64, syntax: GrammarModuleSyntax) -> Option<str> {
  match (module_id, syntax) {
    (1, GrammarModuleSqlSyntax(sql_syntax)) -> match sql_syntax.query.source.table {
      Some(table) -> Some(table.text)
      None -> None<str>()
    }
    _ -> None<str>()
  }
}

pub(package) fn grammar_module_unknown() -> i64 { 0 }
pub(package) fn grammar_module_mini_sql() -> i64 { 1 }
pub(package) fn grammar_module_einsum() -> i64 { 2 }

pub(package) fn grammar_module_origin_unknown() -> i64 { 0 }
pub(package) fn grammar_module_origin_first_party() -> i64 { 1 }
pub(package) fn grammar_module_origin_package() -> i64 { 2 }

pub(package) fn grammar_module_execution_unknown() -> i64 { 0 }
pub(package) fn grammar_module_execution_validate_only() -> i64 { 1 }
pub(package) fn grammar_module_execution_typed_plan() -> i64 { 2 }
pub(package) fn grammar_module_execution_runtime() -> i64 { 3 }

pub(package) fn grammar_module_name(module_id: i64) -> str {
  match module_id {
    1 -> "mini_sql"
    2 -> "einsum"
    _ -> ""
  }
}

pub(package) fn grammar_module_public_name(module_id: i64) -> str {
  match module_id {
    1 -> "sql"
    2 -> "einsum"
    _ -> ""
  }
}

pub(package) fn grammar_module_origin(module_id: i64) -> i64 {
  match module_id {
    1 -> grammar_module_origin_first_party()
    2 -> grammar_module_origin_first_party()
    _ -> grammar_module_origin_unknown()
  }
}

pub(package) fn grammar_module_current_path(module_id: i64) -> str {
  match module_id {
    1 -> "stdlib/grammar/sql.weft"
    2 -> "stdlib/grammar/einsum.weft"
    _ -> ""
  }
}

pub(package) fn grammar_module_target_import_path(module_id: i64) -> str {
  match module_id {
    1 -> "stdlib/grammar/sql.weft"
    2 -> "stdlib/grammar/einsum.weft"
    _ -> ""
  }
}

pub(package) fn grammar_module_execution_model(module_id: i64) -> i64 {
  match module_id {
    1 -> grammar_module_execution_runtime()
    2 -> grammar_module_execution_runtime()
    _ -> grammar_module_execution_unknown()
  }
}

pub(package) fn grammar_module_has_lowering(module_id: i64) -> i64 {
  match module_id {
    1 -> 0
    2 -> 0
    _ -> 0
  }
}

pub(package) fn grammar_module_can_execute(module_id: i64) -> i64 {
  match module_id {
    1 -> 1
    2 -> 1
    _ -> 0
  }
}

pub(package) fn grammar_module_lowering_target(module_id: i64) -> str {
  match module_id {
    1 -> ""
    2 -> ""
    _ -> ""
  }
}

pub(package) fn grammar_module_runtime_target(module_id: i64) -> str {
  match module_id {
    1 -> "stdlib/grammar/sql/execute.weft"
    2 -> "stdlib/grammar/einsum/execute.weft"
    _ -> ""
  }
}

pub(package) fn grammar_module_name_eq(name_ptr: i64, name_n: i64, expected: str) -> i64 {
  if name_ptr == 0 { 0 }
  else {
    let expected_n = __str_len(expected)
    if name_n != expected_n { 0 }
    else { src_eq_at(name_ptr, 0, __str_ptr(expected), 0, expected_n) }
  }
}

pub(package) fn grammar_module_lookup(name_ptr: i64, name_n: i64) -> i64 {
  if grammar_module_name_eq(name_ptr, name_n, "mini_sql") == 1 {
    grammar_module_mini_sql()
  } else { if grammar_module_name_eq(name_ptr, name_n, "einsum") == 1 {
    grammar_module_einsum()
  } else {
    grammar_module_unknown()
  } }
}

pub(package) fn grammar_module_parse(module_id: i64, src: i64, n: i64, tt: i64) -[Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_parse_source(src, n, tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_check_catalog(module_id: i64, ast: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_check_ast(ast, src, tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_check_host(module_id: i64, ast: i64, src: i64, host_tt: i64) -[TypeCheck, Diagnose]> i64 {
  match module_id {
    1 -> mini_sql_check_ast_host(ast, src, host_tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_root_tag(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> if ast == 0 { 0 } else { node_tag(ast) }
    _ -> 0
  }
}

pub(package) fn grammar_module_column_count(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_column_count(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_star(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_star(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_distinct(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_distinct(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_has_where(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_has_where(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_table_node(module_id: i64, ast: i64) -> i64 {
  match module_id {
    1 -> mini_sql_query_table_node(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_ident_start(module_id: i64, ident: i64) -> i64 {
  match module_id {
    1 -> mini_sql_ident_start(ident)
    _ -> 0
  }
}

pub(package) fn grammar_module_ident_len(module_id: i64, ident: i64) -> i64 {
  match module_id {
    1 -> mini_sql_ident_len(ident)
    _ -> 0
  }
}
