-- compiler/grammar_registry.weft -- first-party embedded grammar registry
--
-- Grammar modules stay behind this boundary so tools dispatch on typed module
-- values instead of reaching into a grammar's private AST helpers directly.

use compiler/lib.{*}
use compiler/diagnose.{*}
use stdlib/diagnostic/schema.{Diagnose}
use compiler/typecheck_effect.{*}
use stdlib/grammar/sql.{*}
use stdlib/grammar.{Grammar, CheckedGrammar, ParseResult, Parsed, Recovered, Rejected, CheckResult, Checked, CheckRejected}
use stdlib/grammar/sql as sql
use stdlib/grammar/sql/check as sql_check
use stdlib/grammar/sql/plan.{SqlPlan}
use stdlib/grammar/sql/syntax.{SqlSyntax, SqlSelection, SqlSelectAll, SqlSelect}
use stdlib/grammar/einsum as einsum
use stdlib/grammar/einsum/check as einsum_check
use stdlib/grammar/einsum/plan.{EinsumOperandSpecs, EinsumPlan}
use stdlib/grammar/einsum/syntax.{EinsumSyntax}
use stdlib/list.{List, Nil, Cons}
use stdlib/option.{Option, Some, None}
use stdlib/source.{Span}
use stdlib/typecheck as public_typecheck

-- Identity of a registered first-party grammar. Unknown lookup uses Option,
-- so an invalid integer module id cannot cross the registry boundary.
pub(package) type GrammarModule {
  GrammarModuleSql,
  GrammarModuleEinsum
}

-- Where a grammar declaration entered the registry.
pub(package) type GrammarModuleOrigin {
  GrammarModuleFirstPartyOrigin,
  GrammarModulePackageOrigin(str)
}

-- Lowering metadata carried only by grammars that actually lower.
pub(package) type GrammarModuleLowering {
  target: str
}

-- Runtime metadata carried only by grammars that actually execute.
pub(package) type GrammarModuleRuntime {
  lowering: GrammarModuleLowering,
  target: str
}

-- A grammar's execution capability. The variant makes unsupported target
-- combinations unrepresentable; callers do not coordinate integer flags.
pub(package) type GrammarModuleExecution {
  GrammarModuleValidateOnly,
  GrammarModuleTypedPlan(GrammarModuleLowering),
  GrammarModuleRuntimeExecution(GrammarModuleRuntime)
}

-- The dynamic registry closes over the associated types of first-party
-- grammars. Adding a grammar adds variants here, not a public raw-node ABI.
pub(package) type GrammarModuleSyntax {
  GrammarModuleSqlSyntax(SqlSyntax),
  GrammarModuleEinsumSyntax(EinsumSyntax)
}

pub(package) type GrammarModulePlan<I> {
  GrammarModuleSqlPlan(SqlPlan<I>),
  GrammarModuleEinsumPlan(EinsumPlan<I>)
}

pub(package) type GrammarModuleCheckContext<I> {
  GrammarModuleDefaultContext,
  GrammarModuleEinsumContext(EinsumOperandSpecs<I>)
}

pub(package) fn grammar_module_parse_syntax(module: GrammarModule, source: Span) -[Diagnose]> ParseResult<GrammarModuleSyntax> {
  match module {
    GrammarModuleSql -> match sql.grammar().parse(source) {
      Parsed(syntax) -> Parsed<GrammarModuleSyntax>(GrammarModuleSqlSyntax(syntax))
      Recovered(syntax) -> Recovered<GrammarModuleSyntax>(GrammarModuleSqlSyntax(syntax))
      Rejected -> Rejected<GrammarModuleSyntax>()
    }
    GrammarModuleEinsum -> match einsum.grammar().parse(source) {
      Parsed(syntax) -> Parsed<GrammarModuleSyntax>(GrammarModuleEinsumSyntax(syntax))
      Recovered(syntax) -> Recovered<GrammarModuleSyntax>(GrammarModuleEinsumSyntax(syntax))
      Rejected -> Rejected<GrammarModuleSyntax>()
    }
  }
}

pub(package) fn grammar_module_check_plan_with<I>(syntax: GrammarModuleSyntax, context: GrammarModuleCheckContext<I>) -[public_typecheck.TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> {
  match (syntax, context) {
    (GrammarModuleSqlSyntax(sql_syntax), _) -> match sql_check.checker<I>().check(sql_syntax) {
      Checked(plan) -> Checked<GrammarModulePlan<I>>(GrammarModuleSqlPlan<I>(plan))
      CheckRejected -> CheckRejected<GrammarModulePlan<I>>()
    }
    (GrammarModuleEinsumSyntax(einsum_syntax), GrammarModuleEinsumContext(specs)) -> match einsum_check.checker<I>(specs).check(einsum_syntax) {
      Checked(plan) -> Checked<GrammarModulePlan<I>>(GrammarModuleEinsumPlan<I>(plan))
      CheckRejected -> CheckRejected<GrammarModulePlan<I>>()
    }
    _ -> CheckRejected<GrammarModulePlan<I>>()
  }
}

pub(package) fn grammar_module_check_plan<I>(syntax: GrammarModuleSyntax) -[public_typecheck.TypeCheck<I>, Diagnose]> CheckResult<GrammarModulePlan<I>> {
  grammar_module_check_plan_with<I>(syntax, GrammarModuleDefaultContext<I>())
}

fn grammar_module_list_count<T>(items: List<T>) -> i64 {
  match items { Nil -> 0, Cons(item, rest) -> 1 + grammar_module_list_count(rest) }
}

pub(package) fn grammar_module_for_syntax(syntax: GrammarModuleSyntax) -> GrammarModule {
  match syntax {
    GrammarModuleSqlSyntax(_) -> GrammarModuleSql
    GrammarModuleEinsumSyntax(_) -> GrammarModuleEinsum
  }
}

pub(package) fn grammar_module_syntax_root_tag(syntax: GrammarModuleSyntax) -> i64 {
  match syntax { GrammarModuleSqlSyntax(_) -> mini_sql_query_tag(), _ -> 0 }
}

pub(package) fn grammar_module_syntax_column_count(syntax: GrammarModuleSyntax) -> i64 {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> match sql_syntax.query.selection {
      SqlSelectAll -> 0
      SqlSelect(items) -> grammar_module_list_count(items)
    }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_star(syntax: GrammarModuleSyntax) -> i64 {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> match sql_syntax.query.selection { SqlSelectAll -> 1, _ -> 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_distinct(syntax: GrammarModuleSyntax) -> i64 {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> if sql_syntax.query.distinct { 1 } else { 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_has_where(syntax: GrammarModuleSyntax) -> i64 {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> match sql_syntax.query.predicate { Some(_) -> 1, None -> 0 }
    _ -> 0
  }
}

pub(package) fn grammar_module_syntax_table(syntax: GrammarModuleSyntax) -> Option<str> {
  match syntax {
    GrammarModuleSqlSyntax(sql_syntax) -> match sql_syntax.query.source.table {
      Some(table) -> Some(table.text)
      None -> None<str>()
    }
    _ -> None<str>()
  }
}

pub(package) fn grammar_module_name(module: GrammarModule) -> str {
  match module {
    GrammarModuleSql -> "mini_sql"
    GrammarModuleEinsum -> "einsum"
  }
}

pub(package) fn grammar_module_public_name(module: GrammarModule) -> str {
  match module {
    GrammarModuleSql -> "sql"
    GrammarModuleEinsum -> "einsum"
  }
}

pub(package) fn grammar_module_origin(module: GrammarModule) -> GrammarModuleOrigin {
  match module {
    GrammarModuleSql -> GrammarModuleFirstPartyOrigin
    GrammarModuleEinsum -> GrammarModuleFirstPartyOrigin
  }
}

pub(package) fn grammar_module_current_path(module: GrammarModule) -> str {
  match module {
    GrammarModuleSql -> "stdlib/grammar/sql.weft"
    GrammarModuleEinsum -> "stdlib/grammar/einsum.weft"
  }
}

pub(package) fn grammar_module_target_import_path(module: GrammarModule) -> str {
  match module {
    GrammarModuleSql -> "stdlib/grammar/sql.weft"
    GrammarModuleEinsum -> "stdlib/grammar/einsum.weft"
  }
}

pub(package) fn grammar_module_execution(module: GrammarModule) -> GrammarModuleExecution {
  match module {
    GrammarModuleSql -> GrammarModuleRuntimeExecution(GrammarModuleRuntime {
      lowering: GrammarModuleLowering { target: "stdlib/grammar/sql/execute.weft" },
      target: "stdlib/grammar/sql/execute.weft"
    })
    GrammarModuleEinsum -> GrammarModuleRuntimeExecution(GrammarModuleRuntime {
      lowering: GrammarModuleLowering { target: "stdlib/grammar/einsum/execute.weft" },
      target: "stdlib/grammar/einsum/execute.weft"
    })
  }
}

pub(package) fn grammar_module_name_eq(name_ptr: i64, name_n: i64, expected: str) -> i64 {
  if name_ptr == 0 { 0 }
  else {
    let expected_n = __str_len(expected)
    if name_n != expected_n { 0 }
    else { src_eq_at(name_ptr, 0, __str_ptr(expected), 0, expected_n) }
  }
}

pub(package) fn grammar_module_lookup(name_ptr: i64, name_n: i64) -> Option<GrammarModule> {
  if grammar_module_name_eq(name_ptr, name_n, "mini_sql") == 1 {
    Some<GrammarModule>(GrammarModuleSql)
  } else { if grammar_module_name_eq(name_ptr, name_n, "einsum") == 1 {
    Some<GrammarModule>(GrammarModuleEinsum)
  } else {
    None<GrammarModule>()
  } }
}

pub(package) fn grammar_module_parse(module: GrammarModule, src: i64, n: i64, tt: i64) -[Diagnose]> i64 {
  match module {
    GrammarModuleSql -> mini_sql_parse_source(src, n, tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_check_catalog(module: GrammarModule, ast: i64, src: i64, tt: i64) -[Diagnose]> i64 {
  match module {
    GrammarModuleSql -> mini_sql_check_ast(ast, src, tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_check_host(module: GrammarModule, ast: i64, src: i64, host_tt: i64) -[TypeCheck, Diagnose]> i64 {
  match module {
    GrammarModuleSql -> mini_sql_check_ast_host(ast, src, host_tt)
    _ -> 0
  }
}

pub(package) fn grammar_module_root_tag(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> if ast == 0 { 0 } else { node_tag(ast) }
    _ -> 0
  }
}

pub(package) fn grammar_module_column_count(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_query_column_count(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_star(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_query_star(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_distinct(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_query_distinct(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_has_where(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_query_has_where(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_table_node(module: GrammarModule, ast: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_query_table_node(ast)
    _ -> 0
  }
}

pub(package) fn grammar_module_ident_start(module: GrammarModule, ident: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_ident_start(ident)
    _ -> 0
  }
}

pub(package) fn grammar_module_ident_len(module: GrammarModule, ident: i64) -> i64 {
  match module {
    GrammarModuleSql -> mini_sql_ident_len(ident)
    _ -> 0
  }
}
