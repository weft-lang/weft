-- compiler/sdk/embed.weft — deterministic complete-SDK archive construction
--
-- This is a compiler build input producer, not a user-visible packaging API.
-- It admits only regular files below the three canonical source roots plus the
-- manifest and both pinned alpha-target native archives, read through
-- DirInspect and FileRead. The archive has the layout runtime/sdk_archive
-- reads: a header, one entry per input in byte order of path, then each path
-- followed by its contents. Its digest covers the whole archive with the
-- digest field zeroed.

use runtime/sdk_archive.{
  sdk_archive_digest_offset,
  sdk_archive_entry_size,
  sdk_archive_header_size,
  sdk_archive_version
}
use runtime/sha256.{sha256_digest_of_vector}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/dir as dir
use stdlib/dir.{DirDirectory, DirFile, DirInspect, DirOther}
use stdlib/file as file
use stdlib/file.{FileRead}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Err, Ok, Result}
use stdlib/sorted_set as sorted_set
use stdlib/sorted_set.{SortedSet}
use stdlib/string.{str_len}
use stdlib/string/builder as builder
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_get_in_bounds, vector_len}

pub(package) type SdkArchiveBuild {
  SdkArchiveBuilt(owned Vector<u8>, str, i64),
  SdkArchiveBuildFailed(str)
}

-- What a path names, inspected without following a final symbolic link.
type SdkEmbedEntry {
  SdkEmbedDirectory,
  SdkEmbedFile(i64),
  SdkEmbedLink,
  SdkEmbedSpecial,
  SdkEmbedAbsent
}

-- One admitted input and the size it had when inspected.
type SdkEmbedInput { path: str, size: i64 }

fn sdk_embed_physical(root: str, relative: str) -> str {
  if root.ends_with("/") { i"{root}{relative}" } else { i"{root}/{relative}" }
}

fn sdk_embed_native(root: str, relative: str) -> Option<Path> {
  match path.from_utf8(sdk_embed_physical(root, relative)) {
    Ok(native) -> Some(native)
    Err(_) -> None
  }
}

fn sdk_embed_entry(root: str, relative: str) -[DirInspect]> SdkEmbedEntry {
  let native = match sdk_embed_native(root, relative) {
    Some(value) -> value
    None -> return SdkEmbedAbsent
  }
  let direct = match dir.symlink_metadata(native) {
    Ok(metadata) -> metadata
    Err(_) -> return SdkEmbedAbsent
  }
  if not direct.exists { return SdkEmbedAbsent }
  match direct.kind {
    DirDirectory -> SdkEmbedDirectory
    DirFile -> SdkEmbedFile(direct.size)
    -- Without following links, a link and a special file are both some
    -- other kind; only a special file is still one when followed.
    DirOther -> match dir.metadata(native) {
      Ok(followed) -> if followed.exists and followed.kind == DirOther { SdkEmbedSpecial } else {
        SdkEmbedLink
      }
      Err(_) -> SdkEmbedLink
    }
  }
}

fn sdk_embed_join(relative: str, name: str) -> str {
  if str_len(relative) == 0 { name } else { i"{relative}/{name}" }
}

-- Admit every `.weft` file below a source root; a failure's reason, or empty.
fn sdk_embed_collect_directory(
  root: str,
  relative: str,
  inputs: SortedSet<str>
) -[DirInspect]> str {
  match sdk_embed_entry(root, relative) {
    SdkEmbedDirectory -> nil
    _ -> return "SDK source root is missing or is not a directory"
  }
  let native = match sdk_embed_native(root, relative) {
    Some(value) -> value
    None -> return "SDK source directory cannot be opened"
  }
  let names = match dir.list(native) {
    Ok(entries) -> entries
    Err(_) -> return "SDK source directory cannot be read"
  }
  for entry in names[..] {
    let name = match entry.to_utf8() {
      Ok(text) -> text
      Err(_) -> return "SDK source directory contains a malformed entry"
    }
    let child = sdk_embed_join(relative, name)
    match sdk_embed_entry(root, child) {
      SdkEmbedDirectory -> {
        let failure = sdk_embed_collect_directory(root, child, inputs)
        if str_len(failure) > 0 { return failure }
      }
      SdkEmbedFile(_) -> if name.ends_with(".weft") and not inputs.insert(child) {
        return "SDK source archive contains a duplicate path"
      }
      SdkEmbedLink -> return "SDK source roots cannot contain symbolic links"
      SdkEmbedSpecial -> nil
      SdkEmbedAbsent -> nil
    }
  }
  ""
}

fn sdk_embed_add_required_file(
  root: str,
  relative: str,
  inputs: SortedSet<str>
) -[DirInspect]> str {
  match sdk_embed_entry(root, relative) {
    SdkEmbedFile(_) -> if inputs.insert(relative) { "" } else {
      "SDK source archive contains a duplicate path"
    }
    _ -> "required SDK archive input is missing or is not a regular file"
  }
}

fn sdk_embed_collect(root: str, inputs: SortedSet<str>) -[DirInspect]> str {
  let source_roots = ["compiler", "runtime", "stdlib"]
  for source_root in source_roots[..] {
    let failure = sdk_embed_collect_directory(root, source_root, inputs)
    if str_len(failure) > 0 { return failure }
  }
  let required_files = [
    "weft.pkg",
    "native/lib/macos-aarch64/libweft_mbedtls.a",
    "native/lib/linux-aarch64/libweft_mbedtls.a"
  ]
  for required in required_files[..] {
    let failure = sdk_embed_add_required_file(root, required, inputs)
    if str_len(failure) > 0 { return failure }
  }
  ""
}

-- Every admitted input with its size; empty inputs are refused.
fn sdk_embed_inspect(
  root: str,
  admitted: Vector<str>
) -[DirInspect]> Result<Vector<SdkEmbedInput>, str> {
  let mut inputs = vector.new<SdkEmbedInput>()
  for relative in admitted[..] {
    match sdk_embed_entry(root, relative) {
      SdkEmbedFile(size) -> if size > 0 {
        inputs.push(SdkEmbedInput { path: relative, size: size })
      } else {
        return Err<Vector<SdkEmbedInput>, str>("SDK archive input cannot be read or is empty")
      }
      _ -> return Err<Vector<SdkEmbedInput>, str>("SDK archive input cannot be read or is empty")
    }
  }
  let published: Vector<SdkEmbedInput> = inputs
  Ok<Vector<SdkEmbedInput>, str>(published)
}

fn sdk_embed_push_u64(out: borrow mut Vector<u8>, value: i64) -> nil {
  for index in 0..8 {
    out.push(((value bshr (index * 8)) band 255).to_u8_checked().expect("a byte fits u8"))
  }
}

fn sdk_embed_push_zeros(out: borrow mut Vector<u8>, count: i64) -> nil {
  for index in 0..count { out.push(0) }
}

-- An input's exact contents, refused when it changed since inspection.
fn sdk_embed_read(root: str, input: SdkEmbedInput) -[FileRead]> Option<Bytes> {
  let native = match sdk_embed_native(root, input.path) {
    Some(value) -> value
    None -> return None
  }
  match file.read_all(native, input.size.to_usize_checked().expect("sizes are nonnegative")) {
    Ok(contents) -> if contents.len().to_u64().to_i64_checked().unwrap_or(-1) == input.size {
      Some(contents)
    } else { None }
    Err(_) -> None
  }
}

fn sdk_embed_hex(value: i64) -> str {
  match value {
    10 -> "a"
    11 -> "b"
    12 -> "c"
    13 -> "d"
    14 -> "e"
    15 -> "f"
    _ -> i"{value}"
  }
}

fn sdk_embed_digest_text(digest: Bytes) -> str {
  let mut text = builder.new()
  text.append("sha256:")
  for index in 0..digest.len().to_u64().to_i64_checked().unwrap_or(0) {
    let byte = digest.get(index.to_usize_checked().unwrap_or(0)).unwrap_or(0).to_u64().to_i64_checked().unwrap_or(
      0
    )
    text.append(sdk_embed_hex(byte / 16))
    text.append(sdk_embed_hex(byte % 16))
  }
  text.finish()
}

fn sdk_embed_archive(root: str, inputs: Vector<SdkEmbedInput>) -[FileRead]> SdkArchiveBuild {
  let count = vector_len<SdkEmbedInput>(inputs)
  let header = sdk_archive_header_size()
  let entry_size = sdk_archive_entry_size()
  let mut total = header + count * entry_size
  for input in inputs[..] { total = total + str_len(input.path) + input.size }
  let mut archive = vector.with_capacity<u8>(
    total.to_usize_checked().expect("SDK archive size fits usize")
  )
  bytes.from_str("WEFTSDK1").append_to(archive)
  sdk_embed_push_u64(archive, sdk_archive_version())
  sdk_embed_push_u64(archive, count)
  sdk_embed_push_u64(archive, entry_size)
  sdk_embed_push_u64(archive, total)
  sdk_embed_push_u64(archive, header)
  -- The rest of the header, the digest field included, starts zeroed.
  sdk_embed_push_zeros(archive, header - 48)
  let mut offset = header + count * entry_size
  for input in inputs[..] {
    let path_len = str_len(input.path)
    sdk_embed_push_u64(archive, offset)
    sdk_embed_push_u64(archive, path_len)
    sdk_embed_push_u64(archive, offset + path_len)
    sdk_embed_push_u64(archive, input.size)
    sdk_embed_push_zeros(archive, entry_size - 32)
    offset = offset + path_len + input.size
  }
  for input in inputs[..] {
    bytes.from_str(input.path).append_to(archive)
    match sdk_embed_read(root, input) {
      Some(contents) -> contents.append_to(archive)
      None -> return SdkArchiveBuildFailed(
        "SDK archive input changed or became unreadable during construction"
      )
    }
  }
  let digest = sha256_digest_of_vector(archive)
  for index in 0..digest.len().to_u64().to_i64_checked().unwrap_or(0) {
    let field = (sdk_archive_digest_offset() + index).to_usize_checked().expect("offsets fit")
    archive.set(field, digest.get(index.to_usize_checked().unwrap_or(0)).unwrap_or(0))
  }
  SdkArchiveBuilt(archive, sdk_embed_digest_text(digest), count)
}

--- Build the archive of the SDK below `root`.
pub(package) fn sdk_embed_build(root: str) -[DirInspect, FileRead]> SdkArchiveBuild {
  if str_len(root) == 0 { return SdkArchiveBuildFailed("SDK archive root cannot be empty") }
  let admitted = sorted_set.new<str>()
  let failure = sdk_embed_collect(root, admitted)
  if str_len(failure) > 0 { return SdkArchiveBuildFailed(failure) }
  match sdk_embed_inspect(root, admitted.values()) {
    Err(reason) -> SdkArchiveBuildFailed(reason)
    Ok(inputs) -> sdk_embed_archive(root, inputs)
  }
}
