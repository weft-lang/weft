-- compiler/sdk/source.weft -- one diagnostic interpretation of SDK acquisition

use runtime/sdk_archive.{
  SdkArchiveError,
  SdkArchiveTruncated,
  SdkArchiveBadMagic,
  SdkArchiveUnsupportedVersion,
  SdkArchiveInvalidLayout,
  SdkArchiveInvalidEntry,
  SdkArchiveDigestMismatch,
  sdk_archive_version
}
use runtime/source_acquire.{
  SdkSource,
  SdkSourceFound,
  SdkSourceMissing,
  SdkSourceInvalidPath,
  SourceAcquire
}
use stdlib/bytes.{Bytes}
use stdlib/diagnostic/schema.{*}

pub(package) fn sdk_archive_diagnostic(error: SdkArchiveError) -> Diagnostic {
  let (reason, detail) = match error {
    SdkArchiveTruncated -> ("truncated", DiagnosticFieldNil)
    SdkArchiveBadMagic -> ("bad_magic", DiagnosticFieldNil)
    SdkArchiveUnsupportedVersion(version) -> (
      "unsupported_version",
      DiagnosticFieldCons(DiagnosticFieldI64("found_version", version), DiagnosticFieldNil)
    )
    SdkArchiveInvalidLayout -> ("invalid_layout", DiagnosticFieldNil)
    SdkArchiveInvalidEntry(index) -> (
      "invalid_entry",
      DiagnosticFieldCons(DiagnosticFieldI64("entry_index", index), DiagnosticFieldNil)
    )
    SdkArchiveDigestMismatch -> ("digest_mismatch", DiagnosticFieldNil)
  }
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassLink,
    DiagnosticCodeAssigned("E5015"),
    "the compiler's embedded SDK is damaged or incompatible; reinstall the matching compiler binary",
    DiagnosticLocationNone,
    DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(
      DiagnosticFieldText("reason", reason),
      DiagnosticFieldCons(DiagnosticFieldI64("archive_version", sdk_archive_version()), detail)
    )
  )
}

pub(package) fn sdk_source_diagnostic(path: str, reason: str) -> Diagnostic {
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassLink,
    DiagnosticCodeAssigned("E5016"),
    "the selected SDK cannot supply this canonical path; check the import or reinstall the matching compiler",
    DiagnosticSourceRange(DiagnosticSourceNamed(path), 0, 0),
    DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(
      DiagnosticFieldText("path", path),
      DiagnosticFieldCons(DiagnosticFieldText("reason", reason), DiagnosticFieldNil)
    )
  )
}

pub(package) fn sdk_manifest_diagnostic() -> Diagnostic {
  Diagnostic(
    DiagnosticSeverityError,
    DiagnosticClassLink,
    DiagnosticCodeAssigned("E5017"),
    "the selected SDK manifest is malformed or does not match this compiler's language version",
    DiagnosticSourceRange(DiagnosticSourceNamed("weft.pkg"), 0, 0),
    DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(DiagnosticFieldText("path", "weft.pkg"), DiagnosticFieldNil)
  )
}

--- The bytes of a canonical SDK path, reporting why it is unavailable.
pub(package) fn sdk_source_load_required(path: str) -[SourceAcquire, Diagnose]> Bytes? {
  let reason = match SourceAcquire.load_sdk(path) {
    SdkSourceFound(bytes) -> return bytes
    SdkSourceMissing -> "missing"
    SdkSourceInvalidPath -> "invalid_path"
  }
  Diagnose.report(sdk_source_diagnostic(path, reason))
  nil
}

-- A resolved module identity has no source suffix and no filesystem root.
-- Physical spellings such as ./test/example.weft belong only to disk loading.
pub(package) fn sdk_source_load_module(logical_path: str) -[SourceAcquire, Diagnose]> Bytes? {
  sdk_source_load_required(logical_path.concat(".weft"))
}
