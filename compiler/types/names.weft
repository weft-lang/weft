-- Source spelling keys shared by syntax and semantic type construction.
-- Hashes are lookup keys, never substitutes for resolved declaration identity.

use runtime/memory.{mem_load8, mem_load64}
use compiler/storage.{src_eq}

-- The eight-wide form is bit-identical to djb2's byte loop: wrapping i64
-- arithmetic distributes h * 33 across eight bytes. Masking each shifted
-- byte excludes arithmetic-shift sign extension from every term.
pub(package) fn str_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  let mut i = 0
  while i + 8 <= len {
    let w = mem_load64(src + start + i)
    let wide = h * 1406408618241
    let t0 = (w band 255) * 42618442977
    let t1 = ((w bshr 8) band 255) * 1291467969
    let t2 = ((w bshr 16) band 255) * 39135393
    let t3 = ((w bshr 24) band 255) * 1185921
    let t4 = ((w bshr 32) band 255) * 35937
    let t5 = ((w bshr 40) band 255) * 1089
    let t6 = ((w bshr 48) band 255) * 33
    let t7 = (w bshr 56) band 255
    h = wide + t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7
    i = i + 8
  }
  while i < len {
    h = h * 33 + mem_load8(src + start + i)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}

pub(package) fn effect_name_hash(src: i64, start: i64, len: i64) -> i64 {
  str_hash(src, start, len)
}

pub(package) fn type_name_hash(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "i64") == 1 { - 1 }
  else if src_eq(src, ns, nl, "str") == 1 { - 2 }
  else if src_eq(src, ns, nl, "bool") == 1 { - 3 }
  else if src_eq(src, ns, nl, "nil") == 1 { - 4 }
  else if src_eq(src, ns, nl, "f64") == 1 { - 5 }
  else if src_eq(src, ns, nl, "i32") == 1 { - 6 }
  else if src_eq(src, ns, nl, "i8") == 1 { - 7 }
  else if src_eq(src, ns, nl, "i16") == 1 { - 8 }
  else if src_eq(src, ns, nl, "u8") == 1 { - 9 }
  else if src_eq(src, ns, nl, "u16") == 1 { - 10 }
  else if src_eq(src, ns, nl, "u32") == 1 { - 11 }
  else if src_eq(src, ns, nl, "u64") == 1 { - 12 }
  else if src_eq(src, ns, nl, "isize") == 1 { - 13 }
  else if src_eq(src, ns, nl, "usize") == 1 { - 14 }
  else if src_eq(src, ns, nl, "f32") == 1 { - 15 }
  else { effect_name_hash(src, ns, nl) }
}
