fn semantic_record_field_list_index(
  graph: borrow SemanticRecordLocalGraph,
  id: SemanticRecordFieldListId
) -> DenseIndex {
  let index = match id { SemanticRecordFieldListId(value) -> value }
  match graph {
    SemanticRecordLocalGraphColumns(starts, _, _, _, _, _, _) -> {
      if dense_index_value(index) < starts.len() { index }
      else { panic("Semantic record field list id is out of bounds") }
    }
  }
}

pub(package) fn semantic_type_record_field_count(
  graph: borrow SemanticRecordLocalGraph,
  id: SemanticRecordFieldListId
