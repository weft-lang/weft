  match graph {
    SemanticTypeGraph(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
      } = storage
      semantic_type_reference_type_at(binary_right, segment, index)
    }
  }
}

pub(package) fn semantic_type_graph_node(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticTypeNode {
  match semantic_type_graph_kind(graph, id) {
    SemanticBottomKind -> SemanticBottomNode
    SemanticTopKind -> SemanticTopNode
    SemanticPrimitiveKind -> match semantic_type_graph_primitive(graph, id) {
      SemanticPrimitivePresent(primitive) -> SemanticPrimitiveNode(primitive)
      SemanticPrimitiveAbsent -> panic("Semantic primitive payload is missing")
    }
    SemanticUnionKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(left, right) -> SemanticUnionNode(left, right)
      SemanticBinaryTypeAbsent -> panic("Semantic union payload is missing")
    }
    SemanticIntersectionKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(left, right) -> SemanticIntersectionNode(left, right)
      SemanticBinaryTypeAbsent -> panic("Semantic intersection payload is missing")
    }
    SemanticComplementKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticComplementNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic complement payload is missing")
    }
    SemanticContinuationKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(input, result) -> SemanticContinuationNode(input, result)
      SemanticBinaryTypeAbsent -> panic("Semantic continuation payload is missing")
    }
    SemanticWeakKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticWeakNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic weak payload is missing")
    }
    SemanticAtomicKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticAtomicNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic atomic payload is missing")
    }
    SemanticUniqueKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticUniqueNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic unique payload is missing")
    }
    SemanticOwnedKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticOwnedNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic owned payload is missing")
    }
    SemanticPointerKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticPointerNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticBorrowKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticBorrowNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticSliceKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticSliceNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticArrayKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_array(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticArrayNode(
        semantic_type_graph_array_type_id(graph, edge),
        semantic_type_local_graph_array_length(local, edge)
      )
    }
  }
}
