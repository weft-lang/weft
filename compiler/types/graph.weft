pub(package) fn semantic_type_list_id_ordinal(id: SemanticTypeListId) -> usize {
  match id { SemanticTypeListId(index) -> dense_index_value(index) }
}

fn semantic_type_list_index(
  graph: borrow SemanticTypeListLocalGraph,
  id: SemanticTypeListId
) -> DenseIndex {
  let index = match id { SemanticTypeListId(value) -> value }
  match graph {
    SemanticTypeListLocalGraphColumns(starts, _, _, _) -> {
      if dense_index_value(index) < starts.len() { index }
      else { panic("Semantic type list id is out of bounds") }
    }
  }
}

pub(package) fn semantic_type_list_count(
  graph: borrow SemanticTypeListLocalGraph
) -> usize {
  match graph {
    SemanticTypeListLocalGraphColumns(starts, _, _, _) -> starts.len()
  }
}

pub(package) fn semantic_type_list_len(
  graph: borrow SemanticTypeListLocalGraph,
  id: SemanticTypeListId
) -> usize {
  let index = semantic_type_list_index(graph, id)
  match graph {
    SemanticTypeListLocalGraphColumns(_, lengths, _, _) -> lengths.at(index)
  }
}

pub(package) fn semantic_type_list_edge(
  graph: borrow SemanticTypeListLocalGraph,
  id: SemanticTypeListId,
  offset: usize
) -> SemanticTypeListEdge {
  let index = semantic_type_list_index(graph, id)
  match graph {
    SemanticTypeListLocalGraphColumns(starts, lengths, _, _) -> {
      if offset >= lengths.at(index) {
        panic("Semantic type list offset is out of bounds")
      } else { SemanticTypeListEdge(dense_index(starts.at(index) + offset)) }
    }
  }
}

fn semantic_type_list_edge_index(edge: SemanticTypeListEdge) -> DenseIndex {
  match edge { SemanticTypeListEdge(index) -> index }
}

