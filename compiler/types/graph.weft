  edge: SemanticEffectSignatureTypeEdge
) -> usize {
  let index = semantic_effect_signature_type_edge_index(edge)
  match graph {
    SemanticEffectLocalGraphColumns(_, _, _, tail_open, tails) -> {
      if tail_open.at(index) { tails.at(index) }
      else { panic("Semantic effect signature is closed") }
    }
  }
}

