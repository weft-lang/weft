}

impl SemanticVariantBuilder {
  fn push(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    declaration: DeclarationIdentity,
    payload: SemanticTypeId
  ) -> (owned SemanticVariantBuilder, DenseIndex) {
    match self {
      SemanticVariantBuilder(storage) -> {
        let { identities, payloads } = storage
        match identities.push(declaration) {
          (next_identities, declaration_index) -> match payloads.push(
            segment,
            payload
          ) {
            (next_payloads, payload_index) -> {
              if dense_index_value(declaration_index) != dense_index_value(payload_index) {
                panic("Semantic variant columns diverged")
              } else { nil }
              (
                SemanticVariantBuilder(
                  SemanticVariantBuilderStorage {
                    identities: next_identities,
                    payloads: next_payloads
                  }
                ),
                declaration_index
              )
            }
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticVariantColumn {
    match self {
      SemanticVariantBuilder(storage) -> {
        let { identities, payloads } = storage
        SemanticVariantColumn {
          identities: identities.freeze(),
          payloads: payloads.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticVariantBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticVariantBuilder(storage) -> {
        let { identities, payloads } = storage
        identities.drop()
        payloads.drop()
      }
    }
  }
}

fn semantic_variable_builder() -> owned SemanticVariableBuilder {
  SemanticVariableBuilder(
    SemanticVariableBuilderStorage {
      self_flags: dense_builder<bool>(),
      parameters: dense_builder<usize>()
    }
  )
}

impl SemanticVariableBuilder {
  fn push(
    self: owned Self,
    variable: SemanticTypeVariable
  ) -> (owned SemanticVariableBuilder, DenseIndex) {
    match self {
      SemanticVariableBuilder(storage) -> {
        let { self_flags, parameters } = storage
        let mut next_self_flags = self_flags
        let mut next_parameters = parameters
        let self_index = next_self_flags.push(
          match variable {
            SemanticParameterVariable(_) -> false
            SemanticSelfVariable -> true
          }
        )
        let parameter_index = next_parameters.push(
          match variable {
            SemanticParameterVariable(id) -> id
            SemanticSelfVariable -> __i64_to_usize(0)
          }
        )
        if dense_index_value(self_index) != dense_index_value(parameter_index) {
          panic("Semantic variable columns diverged")
        } else { nil }
        (
          SemanticVariableBuilder(
            SemanticVariableBuilderStorage {
              self_flags: next_self_flags,
              parameters: next_parameters
            }
          ),
          self_index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticVariableColumn {
    match self {
      SemanticVariableBuilder(storage) -> {
        let { self_flags, parameters } = storage
        SemanticVariableColumn {
          self_flags: self_flags.freeze(),
          parameters: parameters.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticVariableBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticVariableBuilder(storage) -> {
        let { self_flags, parameters } = storage
        self_flags.drop()
        parameters.drop()
      }
    }
  }
}

fn semantic_associated_builder() -> owned SemanticAssociatedBuilder {
  SemanticAssociatedBuilder(
    SemanticAssociatedBuilderStorage {
      bases: semantic_type_reference_builder(),
      identities: semantic_declaration_builder()
