      payloads,
      primitives,
      unary_ordinals,
      unary_imported,
      binary_left_ordinals,
      binary_left_imported,
      binary_right_ordinals,
      binary_right_imported,
      _,
      _,
    ) -> semantic_type_reference_is_imported_at(unary_imported, index)
  }
}

