impl SemanticAssociatedBuilder {
  fn push(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    base: SemanticTypeId,
    declaration: DeclarationIdentity
  ) -> (owned SemanticAssociatedBuilder, DenseIndex) {
    match self {
      SemanticAssociatedBuilder(storage) -> {
        let { bases, identities } = storage
        match identities.push(declaration) {
          (next_identities, declaration_index) -> match bases.push(segment, base) {
            (next_bases, base_index) -> {
              if dense_index_value(declaration_index) != dense_index_value(base_index) {
                panic("Semantic associated type columns diverged")
              } else { nil }
              (
                SemanticAssociatedBuilder(
                  SemanticAssociatedBuilderStorage {
                    bases: next_bases,
                    identities: next_identities
                  }
                ),
                declaration_index
              )
            }
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticAssociatedColumn {
    match self {
      SemanticAssociatedBuilder(storage) -> {
        let { bases, identities } = storage
        SemanticAssociatedColumn {
          bases: bases.freeze(),
          identities: identities.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticAssociatedBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticAssociatedBuilder(storage) -> {
        let { bases, identities } = storage
        bases.drop()
        identities.drop()
      }
    }
  }
}

fn semantic_structured_type_builder() -> owned SemanticStructuredTypeBuilder {
  SemanticStructuredTypeBuilder(
    SemanticStructuredTypeBuilderStorage {
      functions: semantic_function_builder(),
      effect_atoms: semantic_effect_atom_builder(),
      effect_signatures: semantic_effect_signature_builder(),
      named: semantic_named_builder(),
      records: semantic_record_builder(),
      variants: semantic_variant_builder(),
      variables: semantic_variable_builder(),
      traits: semantic_declaration_builder(),
      associated: semantic_associated_builder()
    }
  )
}

impl SemanticStructuredTypeBuilder {
  fn push_function(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    parameters: SemanticTypeListId,
    result: SemanticTypeId,
    effects: SemanticTypeId
  ) -> (owned SemanticStructuredTypeBuilder, DenseIndex) {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        match functions.push(segment, parameters, result, effects) {
          (next_functions, index) -> (
            SemanticStructuredTypeBuilder(
              SemanticStructuredTypeBuilderStorage {
                functions: next_functions,
                effect_atoms: effect_atoms,
                effect_signatures: effect_signatures,
                named: named,
                records: records,
                variants: variants,
                variables: variables,
                traits: traits,
                associated: associated
              }
            ),
            index
          )
        }
      }
    }
  }

  fn push_effect_atom(
    self: owned Self,
    declaration: DeclarationIdentity,
    arguments: SemanticTypeListId
  ) -> (owned SemanticStructuredTypeBuilder, DenseIndex) {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        match effect_atoms.push(declaration, arguments) {
          (next_atoms, index) -> (
            SemanticStructuredTypeBuilder(
              SemanticStructuredTypeBuilderStorage {
                functions: functions,
                effect_atoms: next_atoms,
                effect_signatures: effect_signatures,
                named: named,
                records: records,
                variants: variants,
                variables: variables,
                traits: traits,
                associated: associated
              }
            ),
            index
          )
        }
      }
    }
  }

  fn push_effect_signature(
    self: owned Self,
    effects: SemanticTypeListId,
    tail: SemanticEffectTail
  ) -> (owned SemanticStructuredTypeBuilder, DenseIndex) {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        match effect_signatures.push(effects, tail) {
