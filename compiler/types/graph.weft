pub(package) fn semantic_type_record_fields(
  graph: borrow SemanticRecordLocalGraph,
  edge: SemanticRecordTypeEdge
) -> SemanticRecordFieldListId {
  let index = semantic_record_type_edge_index(edge)
  match graph {
    SemanticRecordLocalGraphColumns(starts, _, _, _, _, _, _) -> {
      if dense_index_value(index) < starts.len() { SemanticRecordFieldListId(index) }
      else { panic("Semantic record edge is out of bounds") }
    }
  }
}

