pub(package) fn semantic_type_graph_binary(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticBinaryTypeView {
  let local = semantic_type_graph_local(graph)
  let local_id = semantic_type_graph_local_id(graph, id)
  match semantic_type_graph_kind_local(local, local_id) {
    SemanticUnionKind -> {
      let edges = semantic_type_local_graph_binary(local, local_id)
      SemanticBinaryTypePresent(
        semantic_type_graph_binary_left_type_id(graph, edges),
        semantic_type_graph_binary_right_type_id(graph, edges)
      )
    }
    SemanticIntersectionKind -> {
      let edges = semantic_type_local_graph_binary(local, local_id)
      SemanticBinaryTypePresent(
        semantic_type_graph_binary_left_type_id(graph, edges),
        semantic_type_graph_binary_right_type_id(graph, edges)
      )
    }
    SemanticContinuationKind -> {
      let edges = semantic_type_local_graph_binary(local, local_id)
      SemanticBinaryTypePresent(
        semantic_type_graph_binary_left_type_id(graph, edges),
        semantic_type_graph_binary_right_type_id(graph, edges)
      )
    }
    _ -> SemanticBinaryTypeAbsent
  }
}

