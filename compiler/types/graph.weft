  match graph {
    SemanticRecordLocalGraphColumns(_, lengths, _, _, _, _, _) -> lengths.at(index)
  }
}

pub(package) fn semantic_type_record_field_edge(
  graph: borrow SemanticRecordLocalGraph,
  id: SemanticRecordFieldListId,
  offset: usize
) -> SemanticRecordFieldEdge {
  let index = semantic_record_field_list_index(graph, id)
  match graph {
    SemanticRecordLocalGraphColumns(_, lengths, _, _, _, _, _) -> {
      if offset < lengths.at(index) { SemanticRecordFieldEdge((index, offset)) }
      else { panic("Semantic record field offset is out of bounds") }
    }
  }
}

fn semantic_record_field_edge_index(
  graph: borrow SemanticRecordLocalGraph,
  edge: SemanticRecordFieldEdge
) -> DenseIndex {
  match edge {
    SemanticRecordFieldEdge((record, offset)) -> match graph {
      SemanticRecordLocalGraphColumns(starts, lengths, _, _, _, _, _) -> {
        if dense_index_value(record) >= starts.len() {
          panic("Semantic record field edge is out of bounds")
        } else {
          if offset >= lengths.at(record) {
            panic("Semantic record field edge is out of bounds")
          } else { dense_index(starts.at(record) + offset) }
        }
      }
    }
  }
}

pub(package) fn semantic_type_record_field_hash(
