pub(package) fn semantic_type_graph_record_field_type_id(
  graph: borrow SemanticTypeGraph,
  edge: SemanticRecordFieldEdge
) -> SemanticTypeId {
  let records = semantic_type_graph_records_local(graph)
  let index = semantic_record_field_edge_index(records, edge)
  match graph {
    SemanticTypeGraph(storage) -> {
      let { segment, structured } = storage
      let { records: record_column } = structured
      let { fields } = record_column
      let { types } = fields
      semantic_type_reference_type_at(types, segment, index)
    }
  }
}

pub(package) fn semantic_type_graph_record_field_name(
  graph: borrow SemanticTypeGraph,
  edge: SemanticRecordFieldEdge
) -> SemanticRecordFieldName {
  let records = semantic_type_graph_records_local(graph)
  let index = semantic_record_field_edge_index(records, edge)
  match edge {
    SemanticRecordFieldEdge((record, offset)) -> match semantic_type_record_shape(
      records,
      SemanticRecordTypeEdge(record)
    ) {
      SemanticTupleRecord -> SemanticTupleRecordField(offset)
      SemanticStructuralRecord -> match graph {
        SemanticTypeGraph(storage) -> {
          let { structured } = storage
          let { records: record_column } = structured
          let { fields } = record_column
          let { names } = fields
          match names.get(semantic_type_reference_key(index)) {
            Some(name) -> SemanticNamedRecordField(name)
            None -> panic("Semantic record field is missing its name")
          }
        }
      }
    }
  }
}

