pub(package) fn semantic_type_graph_node(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticTypeNode {
  match semantic_type_graph_kind(graph, id) {
    SemanticBottomKind -> SemanticBottomNode
    SemanticTopKind -> SemanticTopNode
    SemanticPrimitiveKind -> match semantic_type_graph_primitive(graph, id) {
      SemanticPrimitivePresent(primitive) -> SemanticPrimitiveNode(primitive)
      SemanticPrimitiveAbsent -> panic("Semantic primitive payload is missing")
    }
    SemanticUnionKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(left, right) -> SemanticUnionNode(left, right)
      SemanticBinaryTypeAbsent -> panic("Semantic union payload is missing")
    }
    SemanticIntersectionKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(left, right) -> SemanticIntersectionNode(left, right)
      SemanticBinaryTypeAbsent -> panic("Semantic intersection payload is missing")
    }
    SemanticComplementKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticComplementNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic complement payload is missing")
    }
    SemanticContinuationKind -> match semantic_type_graph_binary(graph, id) {
      SemanticBinaryTypePresent(input, result) -> SemanticContinuationNode(input, result)
      SemanticBinaryTypeAbsent -> panic("Semantic continuation payload is missing")
    }
    SemanticWeakKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticWeakNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic weak payload is missing")
    }
    SemanticAtomicKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticAtomicNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic atomic payload is missing")
    }
    SemanticUniqueKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticUniqueNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic unique payload is missing")
    }
    SemanticOwnedKind -> match semantic_type_graph_unary(graph, id) {
      SemanticUnaryTypePresent(inner) -> SemanticOwnedNode(inner)
      SemanticUnaryTypeAbsent -> panic("Semantic owned payload is missing")
    }
    SemanticPointerKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticPointerNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticBorrowKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticBorrowNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticSliceKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_mutable_unary(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticSliceNode(
        semantic_type_graph_mutable_unary_type_id(graph, edge),
        semantic_type_local_graph_mutability(local, edge)
      )
    }
    SemanticArrayKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_array(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticArrayNode(
        semantic_type_graph_array_type_id(graph, edge),
        semantic_type_local_graph_array_length(local, edge)
      )
    }
    SemanticFunctionKind -> {
      let local = semantic_type_graph_local(graph)
      let functions = semantic_type_graph_functions_local(graph)
      let edge = semantic_type_local_graph_function(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticFunctionNode(
        semantic_type_function_parameters(functions, edge),
        semantic_type_graph_function_result_type_id(graph, edge),
        semantic_type_graph_function_effects_type_id(graph, edge)
      )
    }
    SemanticEffectAtomKind -> {
      let local = semantic_type_graph_local(graph)
      let effects = semantic_type_graph_effects_local(graph)
      let edge = semantic_type_local_graph_effect_atom(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticEffectAtomNode(
        semantic_type_graph_effect_atom_declaration(graph, edge),
        semantic_type_effect_atom_arguments(effects, edge)
      )
    }
    SemanticEffectSignatureKind -> {
      let local = semantic_type_graph_local(graph)
      let effects = semantic_type_graph_effects_local(graph)
      let edge = semantic_type_local_graph_effect_signature(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      let tail = if semantic_type_effect_signature_is_open(effects, edge) {
        SemanticOpenEffects(semantic_type_effect_signature_tail(effects, edge))
      } else { SemanticClosedEffects }
      SemanticEffectSignatureNode(
        semantic_type_effect_signature_effects(effects, edge),
        tail
      )
    }
    SemanticNamedKind -> {
      let local = semantic_type_graph_local(graph)
      let named = semantic_type_graph_named_local(graph)
      let edge = semantic_type_local_graph_named(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticNamedNode(
        semantic_type_graph_named_declaration(graph, edge),
        semantic_type_named_role(named, edge),
        semantic_type_graph_named_representation_type_id(graph, edge),
        semantic_type_named_arguments(named, edge)
      )
    }
    SemanticRecordKind -> {
      let local = semantic_type_graph_local(graph)
      let records = semantic_type_graph_records_local(graph)
      let edge = semantic_type_local_graph_record(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticRecordNode(
        semantic_type_record_fields(records, edge),
        semantic_type_record_shape(records, edge),
        semantic_type_record_openness(records, edge)
      )
    }
    SemanticVariantKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_variant(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticVariantNode(
        semantic_type_graph_variant_declaration(graph, edge),
        semantic_type_graph_variant_payload_type_id(graph, edge)
      )
    }
    SemanticVariableKind -> {
      let local = semantic_type_graph_local(graph)
      let variables = semantic_type_graph_variables_local(graph)
      let edge = semantic_type_local_graph_variable(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticVariableNode(semantic_type_variable_value(variables, edge))
    }
    SemanticTraitKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_trait(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticTraitNode(semantic_type_graph_trait_declaration(graph, edge))
    }
    SemanticAssociatedKind -> {
      let local = semantic_type_graph_local(graph)
      let edge = semantic_type_local_graph_associated(
        local,
        semantic_type_graph_local_id(graph, id)
      )
      SemanticAssociatedNode(
        semantic_type_graph_associated_base_type_id(graph, edge),
        semantic_type_graph_associated_declaration(graph, edge)
      )
    }
  }
}
