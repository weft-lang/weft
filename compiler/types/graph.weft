-- Segmented typed storage for canonical semantic types.
--
-- A SemanticTypeId is a segment identity plus an ordinal, never a pointer.
-- The graph owns a hot kind column and a payload-ordinal column; complete
-- shape access goes through kind-specific typed payload columns. Every
-- semantic family used by the production algebra has a typed representation;
-- the remaining migration is to switch the algebra and checker to this graph.

use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use compiler/project/identity.{DeclarationIdentity, ModuleIdentity}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/project/identity/hash.{retained_declaration_identity_hash}
use stdlib/drop.{Drop}
use stdlib/hash.{Hash}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

