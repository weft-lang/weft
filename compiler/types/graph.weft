                functions: functions,
                effect_atoms: effect_atoms,
                effect_signatures: next_signatures,
                named: named,
                records: records,
                variants: variants,
                variables: variables,
                traits: traits,
                associated: associated
              }
            ),
            index
          )
        }
      }
    }
  }

  fn push_named(
    self: owned Self,
