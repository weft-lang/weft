pub(package) fn semantic_type_graph_len(graph: borrow SemanticTypeGraph) -> usize {
  match graph {
    SemanticTypeGraph(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      kinds.len()
    }
  }
}

pub(package) fn semantic_type_local_graph_len(
  graph: borrow SemanticTypeLocalGraph
) -> usize {
  match graph {
    SemanticTypeLocalGraphColumns(
      kinds,
      payloads,
      primitives,
      unary_ordinals,
      unary_imported,
      binary_left_ordinals,
      binary_left_imported,
      binary_right_ordinals,
      binary_right_imported,
      mutable_unary,
      arrays,
    ) -> kinds.len()
  }
}

pub(package) fn semantic_type_graph_contains(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> bool {
  semantic_type_segment_id_eq(
    semantic_type_graph_segment(graph),
    semantic_type_id_segment(id)
  ) and semantic_type_id_ordinal(id) < semantic_type_graph_len(graph)
}

fn semantic_type_graph_index(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> DenseIndex {
  if semantic_type_graph_contains(graph, id) {
    dense_index(semantic_type_id_ordinal(id))
  } else { panic("Semantic type id does not belong to this segment") }
}

fn semantic_type_graph_local_index(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> DenseIndex {
  let ordinal = semantic_local_type_id_ordinal(id)
  if ordinal < semantic_type_local_graph_len(graph) { dense_index(ordinal) }
  else { panic("Semantic local type id is out of bounds") }
}

pub(package) fn semantic_type_graph_local_id(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticLocalTypeId {
  SemanticLocalTypeId(semantic_type_graph_index(graph, id))
}

pub(package) fn semantic_type_graph_type_id(
  graph: borrow SemanticTypeGraph,
  id: SemanticLocalTypeId
) -> SemanticTypeId {
  let local = semantic_type_graph_local(graph)
  SemanticTypeId(
    (
      semantic_type_graph_segment(graph),
      semantic_type_graph_local_index(local, id)
    )
  )
}

pub(package) fn semantic_type_graph_kind(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticTypeKind {
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_kind_local(local, semantic_type_graph_local_id(graph, id))
}

pub(package) fn semantic_type_graph_kind_local(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> SemanticTypeKind {
  let index = semantic_type_graph_local_index(graph, id)
  match graph {
    SemanticTypeLocalGraphColumns(
      kinds,
      payloads,
      primitives,
      unary_ordinals,
      unary_imported,
      binary_left_ordinals,
      binary_left_imported,
      binary_right_ordinals,
      binary_right_imported,
      _,
      _,
    ) -> kinds.at(index)
  }
}

pub(package) fn semantic_type_local_graph_primitive(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> SemanticPrimitive {
  match semantic_type_graph_kind_local(graph, id) {
    SemanticPrimitiveKind -> {
      let payload = semantic_type_graph_payload_local(graph, id)
      match graph {
        SemanticTypeLocalGraphColumns(
          kinds,
          payloads,
          primitives,
          unary_ordinals,
          unary_imported,
          binary_left_ordinals,
          binary_left_imported,
          binary_right_ordinals,
          binary_right_imported,
          _,
          _,
        ) -> primitives.at(payload)
      }
    }
    _ -> panic("Semantic type is not a primitive")
  }
}

fn semantic_type_graph_payload(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> DenseIndex {
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_payload_local(local, semantic_type_graph_local_id(graph, id))
}

fn semantic_type_graph_payload_local(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> DenseIndex {
  let index = semantic_type_graph_local_index(graph, id)
  match graph {
    SemanticTypeLocalGraphColumns(
      kinds,
      payloads,
      primitives,
      unary_ordinals,
      unary_imported,
      binary_left_ordinals,
      binary_left_imported,
      binary_right_ordinals,
      binary_right_imported,
      _,
      _,
    ) -> dense_index(payloads.at(index))
  }
}

pub(package) fn semantic_type_graph_primitive(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticPrimitiveView {
  match semantic_type_graph_kind(graph, id) {
    SemanticPrimitiveKind -> {
      let payload = semantic_type_graph_payload(graph, id)
      match graph {
        SemanticTypeGraph(storage) -> {
          let {
            segment,
              kinds,
              payloads,
              primitives,
              unary,
              binary_left,
              binary_right,
          } = storage
          SemanticPrimitivePresent(primitives.at(payload))
        }
      }
    }
    _ -> SemanticPrimitiveAbsent
  }
}

pub(package) fn semantic_type_graph_unary(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticUnaryTypeView {
  let local = semantic_type_graph_local(graph)
  let local_id = semantic_type_graph_local_id(graph, id)
  match semantic_type_graph_kind_local(local, local_id) {
    SemanticComplementKind -> SemanticUnaryTypePresent(
      semantic_type_graph_unary_type_id(
        graph,
        semantic_type_local_graph_unary(local, local_id)
      )
    )
    SemanticWeakKind -> SemanticUnaryTypePresent(
      semantic_type_graph_unary_type_id(
        graph,
        semantic_type_local_graph_unary(local, local_id)
      )
    )
    SemanticAtomicKind -> SemanticUnaryTypePresent(
      semantic_type_graph_unary_type_id(
        graph,
        semantic_type_local_graph_unary(local, local_id)
      )
    )
    SemanticUniqueKind -> SemanticUnaryTypePresent(
      semantic_type_graph_unary_type_id(
        graph,
        semantic_type_local_graph_unary(local, local_id)
      )
    )
    SemanticOwnedKind -> SemanticUnaryTypePresent(
      semantic_type_graph_unary_type_id(
        graph,
        semantic_type_local_graph_unary(local, local_id)
      )
    )
    _ -> SemanticUnaryTypeAbsent
  }
}

pub(package) fn semantic_type_local_graph_unary(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> SemanticUnaryTypeEdge {
  match semantic_type_graph_kind_local(graph, id) {
    SemanticComplementKind -> SemanticUnaryTypeEdge(
      semantic_type_graph_payload_local(graph, id)
    )
    SemanticWeakKind -> SemanticUnaryTypeEdge(
      semantic_type_graph_payload_local(graph, id)
    )
    SemanticAtomicKind -> SemanticUnaryTypeEdge(
      semantic_type_graph_payload_local(graph, id)
    )
    SemanticUniqueKind -> SemanticUnaryTypeEdge(
      semantic_type_graph_payload_local(graph, id)
    )
    SemanticOwnedKind -> SemanticUnaryTypeEdge(
      semantic_type_graph_payload_local(graph, id)
    )
    _ -> panic("Semantic type is not unary")
  }
}

fn semantic_unary_type_edge_index(edge: SemanticUnaryTypeEdge) -> DenseIndex {
  match edge { SemanticUnaryTypeEdge(index) -> index }
}

