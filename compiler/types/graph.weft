  ) -> (owned SemanticStructuredTypeBuilder, DenseIndex) {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        match traits.push(declaration) {
          (next_traits, index) -> (
            SemanticStructuredTypeBuilder(
              SemanticStructuredTypeBuilderStorage {
                functions: functions,
                effect_atoms: effect_atoms,
                effect_signatures: effect_signatures,
                named: named,
                records: records,
                variants: variants,
                variables: variables,
                traits: next_traits,
                associated: associated
              }
            ),
            index
          )
        }
      }
    }
  }

  fn push_associated(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    base: SemanticTypeId,
    declaration: DeclarationIdentity
  ) -> (owned SemanticStructuredTypeBuilder, DenseIndex) {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        match associated.push(segment, base, declaration) {
          (next_associated, index) -> (
            SemanticStructuredTypeBuilder(
              SemanticStructuredTypeBuilderStorage {
                functions: functions,
                effect_atoms: effect_atoms,
                effect_signatures: effect_signatures,
                named: named,
                records: records,
                variants: variants,
                variables: variables,
                traits: traits,
                associated: next_associated
              }
            ),
            index
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticStructuredTypeColumn {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        SemanticStructuredTypeColumn {
          functions: functions.freeze(),
          effect_atoms: effect_atoms.freeze(),
          effect_signatures: effect_signatures.freeze(),
          named: named.freeze(),
          records: records.freeze(),
          variants: variants.freeze(),
          variables: variables.freeze(),
          traits: traits.freeze(),
          associated: associated.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticStructuredTypeBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticStructuredTypeBuilder(storage) -> {
        let { functions, effect_atoms, effect_signatures, named, records, variants, variables, traits, associated } = storage
        functions.drop()
        effect_atoms.drop()
        effect_signatures.drop()
        named.drop()
        records.drop()
        variants.drop()
        variables.drop()
        traits.drop()
        associated.drop()
      }
    }
  }
}

fn semantic_type_reference_is_imported_at(
  imported: borrow DenseSegment<bool>,
  index: DenseIndex
) -> bool {
  imported.at(index)
}

fn semantic_type_reference_local_id_at(
  ordinals: borrow DenseSegment<usize>,
  imported: borrow DenseSegment<bool>,
  index: DenseIndex
) -> SemanticLocalTypeId {
  if imported.at(index) { panic("Semantic type reference is imported") }
  else { SemanticLocalTypeId(dense_index(ordinals.at(index))) }
}

fn semantic_type_reference_type_at(
  column: borrow SemanticTypeReferenceColumn,
  segment: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { local, modules } = column
  let local_column = local
  let { ordinals, imported } = local_column
  let ordinal = dense_index(ordinals.at(index))
  if imported.at(index) {
    match modules.get(semantic_type_reference_key(index)) {
      Some(module) -> SemanticTypeId((semantic_type_segment_id(module), ordinal))
      None -> panic("Semantic type import reference is missing its module")
    }
  } else { SemanticTypeId((segment, ordinal)) }
}

pub(package) fn semantic_type_graph_builder(
  segment: SemanticTypeSegmentId
) -> owned SemanticTypeGraphBuilder {
  SemanticTypeGraphBuilder(
    SemanticTypeGraphBuilderStorage {
      segment: segment,
      kinds: dense_builder<SemanticTypeKind>(),
      payloads: dense_builder<usize>(),
      primitives: dense_builder<SemanticPrimitive>(),
      unary: semantic_type_reference_builder(),
      binary_left: semantic_type_reference_builder(),
      binary_right: semantic_type_reference_builder(),
      mutable_unary: semantic_mutable_unary_builder(),
      arrays: semantic_array_builder(),
      lists: semantic_type_list_builder(),
      structured: semantic_structured_type_builder()
    }
  )
}

pub(package) fn semantic_type_graph_builder_with_capacity(
  segment: SemanticTypeSegmentId,
  capacity: usize
) -> owned SemanticTypeGraphBuilder {
  SemanticTypeGraphBuilder(
    SemanticTypeGraphBuilderStorage {
      segment: segment,
      kinds: dense_builder_with_capacity<SemanticTypeKind>(capacity),
      payloads: dense_builder_with_capacity<usize>(capacity),
      primitives: dense_builder<SemanticPrimitive>(),
      unary: semantic_type_reference_builder(),
      binary_left: semantic_type_reference_builder(),
      binary_right: semantic_type_reference_builder(),
      mutable_unary: semantic_mutable_unary_builder(),
      arrays: semantic_array_builder(),
      lists: semantic_type_list_builder(),
      structured: semantic_structured_type_builder()
    }
  )
}

fn append_node(
  segment: SemanticTypeSegmentId,
  kinds: borrow mut DenseBuilder<SemanticTypeKind>,
  payloads: borrow mut DenseBuilder<usize>,
  kind: SemanticTypeKind,
  payload: usize
) -> SemanticTypeId {
  let index = kinds.push(kind)
  let payload_index = payloads.push(payload)
  if dense_index_value(index) != dense_index_value(payload_index) {
    panic("Semantic type graph columns diverged")
  } else { nil }
  SemanticTypeId((segment, index))
}

fn finish_append(
  segment: SemanticTypeSegmentId,
  kinds: owned DenseBuilder<SemanticTypeKind>,
  payloads: owned DenseBuilder<usize>,
  primitives: owned DenseBuilder<SemanticPrimitive>,
  unary: owned SemanticTypeReferenceBuilder,
  binary_left: owned SemanticTypeReferenceBuilder,
  binary_right: owned SemanticTypeReferenceBuilder,
  mutable_unary: owned SemanticMutableUnaryBuilder,
  arrays: owned SemanticArrayBuilder,
  lists: owned SemanticTypeListBuilder,
  structured: owned SemanticStructuredTypeBuilder,
  kind: SemanticTypeKind,
  payload: usize
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  let mut kind_values = kinds
  let mut payload_values = payloads
  let id = append_node(segment, kind_values, payload_values, kind, payload)
  (
    SemanticTypeGraphBuilder(
      SemanticTypeGraphBuilderStorage {
        segment: segment,
        kinds: kind_values,
        payloads: payload_values,
        primitives: primitives,
        unary: unary,
        binary_left: binary_left,
        binary_right: binary_right,
        mutable_unary: mutable_unary,
        arrays: arrays,
        lists: lists,
        structured: structured
      }
    ),
    id
  )
}

fn append_unary_node(
  builder: owned SemanticTypeGraphBuilder,
  inner: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
      } = storage
      match unary.push(segment, inner) {
        (unary_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary_values,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
          kind,
          dense_index_value(index)
        )
      }
    }
  }
}

fn append_binary_node(
  builder: owned SemanticTypeGraphBuilder,
  left: SemanticTypeId,
  right: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
      } = storage
      match binary_left.push(segment, left) {
        (left_values, left_index) -> match binary_right.push(segment, right) {
          (right_values, right_index) -> {
            if dense_index_value(left_index) != dense_index_value(right_index) {
              panic("Semantic binary type columns diverged")
            } else { nil }
            finish_append(
              segment,
              kinds,
              payloads,
              primitives,
              unary,
              left_values,
              right_values,
              mutable_unary,
              arrays,
              lists,
              structured,
              kind,
              dense_index_value(left_index)
            )
          }
        }
      }
    }
  }
}

fn append_mutable_unary_node(
  builder: owned SemanticTypeGraphBuilder,
  inner: SemanticTypeId,
  mutability: SemanticMutability,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
      } = storage
      match mutable_unary.push(segment, inner, mutability) {
        (mutable_unary_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary_values,
          arrays,
          lists,
          structured,
          kind,
          dense_index_value(index)
        )
      }
    }
  }
}

fn append_array_node(
  builder: owned SemanticTypeGraphBuilder,
  element: SemanticTypeId,
  length: usize
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
      } = storage
      match arrays.push(segment, element, length) {
        (array_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          array_values,
          lists,
          structured,
          SemanticArrayKind,
          dense_index_value(index)
        )
      }
    }
  }
}

impl SemanticTypeGraphBuilder {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        kinds.len()
      }
    }
  }

  pub(package) fn bottom(
    self: owned Self
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    let zero: usize = 0
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
          SemanticBottomKind,
          zero
        )
      }
    }
  }

  pub(package) fn top(
    self: owned Self
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    let zero: usize = 0
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
          SemanticTopKind,
          zero
        )
      }
    }
  }

  pub(package) fn primitive(
    self: owned Self,
    primitive: SemanticPrimitive
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        let mut primitive_values = primitives
        let payload = dense_index_value(primitive_values.push(primitive))
        finish_append(
          segment,
          kinds,
          payloads,
          primitive_values,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          lists,
          structured,
          SemanticPrimitiveKind,
          payload
        )
      }
    }
  }

  pub(package) fn complement(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticComplementKind)
  }

  pub(package) fn weak(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticWeakKind)
  }

  pub(package) fn atomic(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticAtomicKind)
  }

  pub(package) fn unique(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticUniqueKind)
  }

  pub(package) fn owned(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticOwnedKind)
  }

  pub(package) fn pointer(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticPointerKind)
  }

  pub(package) fn borrow(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticBorrowKind)
  }

  pub(package) fn slice(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticSliceKind)
  }

  pub(package) fn array(
    self: owned Self,
    element: SemanticTypeId,
    length: usize
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_array_node(self, element, length)
  }

  pub(package) fn union(
    self: owned Self,
    left: SemanticTypeId,
    right: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, left, right, SemanticUnionKind)
  }

  pub(package) fn intersection(
    self: owned Self,
    left: SemanticTypeId,
    right: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, left, right, SemanticIntersectionKind)
  }

  pub(package) fn continuation(
    self: owned Self,
    input: SemanticTypeId,
    result: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, input, result, SemanticContinuationKind)
  }

  pub(package) fn function(
    self: owned Self,
    parameters: SemanticTypeListId,
    result: SemanticTypeId,
    effects: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        if semantic_type_list_id_ordinal(parameters) >= lists.len() {
          panic("Semantic function parameter list does not belong to this graph")
        } else { nil }
        match structured.push_function(segment, parameters, result, effects) {
          (next_structured, index) -> finish_append(
            segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            next_structured,
            SemanticFunctionKind,
            dense_index_value(index)
          )
        }
      }
    }
  }

  pub(package) fn effect_atom(
    self: owned Self,
    declaration: DeclarationIdentity,
    arguments: SemanticTypeListId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        if semantic_type_list_id_ordinal(arguments) >= lists.len() {
          panic("Semantic effect argument list does not belong to this graph")
        } else { nil }
        match structured.push_effect_atom(declaration, arguments) {
          (next_structured, index) -> finish_append(
            segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            next_structured,
            SemanticEffectAtomKind,
            dense_index_value(index)
          )
        }
      }
    }
  }

  pub(package) fn effect_signature(
    self: owned Self,
    effects: SemanticTypeListId,
    tail: SemanticEffectTail
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        if semantic_type_list_id_ordinal(effects) >= lists.len() {
          panic("Semantic effect set does not belong to this graph")
        } else { nil }
        match structured.push_effect_signature(effects, tail) {
          (next_structured, index) -> finish_append(
            segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            next_structured,
            SemanticEffectSignatureKind,
            dense_index_value(index)
          )
        }
      }
    }
  }

  pub(package) fn named(
    self: owned Self,
    declaration: DeclarationIdentity,
    role: SemanticNamedRole,
    representation: SemanticTypeId,
    arguments: SemanticTypeListId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            structured,
        } = storage
        if semantic_type_list_id_ordinal(arguments) >= lists.len() {
          panic("Semantic named type argument list does not belong to this graph")
        } else { nil }
        match structured.push_named(
          segment,
          declaration,
          role,
          representation,
          arguments
        ) {
          (next_structured, index) -> finish_append(
            segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
            lists,
            next_structured,
            SemanticNamedKind,
            dense_index_value(index)
          )
        }
      }
    }
  }

