}

impl SemanticEffectAtomBuilder {
  fn push(
    self: owned Self,
    declaration: DeclarationIdentity,
    arguments: SemanticTypeListId
  ) -> (owned SemanticEffectAtomBuilder, DenseIndex) {
    match self {
      SemanticEffectAtomBuilder(storage) -> {
        let { identities, arguments: argument_values } = storage
        let mut arguments_builder = argument_values
        match identities.push(declaration) {
          (next_identities, declaration_index) -> {
            let argument_index = arguments_builder.push(
              semantic_type_list_id_ordinal(arguments)
            )
            if dense_index_value(declaration_index) != dense_index_value(argument_index) {
              panic("Semantic effect atom columns diverged")
            } else { nil }
            (
              SemanticEffectAtomBuilder(
                SemanticEffectAtomBuilderStorage {
                  identities: next_identities,
                  arguments: arguments_builder
                }
              ),
              declaration_index
            )
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticEffectAtomColumn {
    match self {
      SemanticEffectAtomBuilder(storage) -> {
        let { identities, arguments } = storage
        SemanticEffectAtomColumn {
          identities: identities.freeze(),
          arguments: arguments.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticEffectAtomBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticEffectAtomBuilder(storage) -> {
        let { identities, arguments } = storage
        identities.drop()
        arguments.drop()
      }
    }
  }
}

fn semantic_effect_signature_builder() -> owned SemanticEffectSignatureBuilder {
  SemanticEffectSignatureBuilder(
    SemanticEffectSignatureBuilderStorage {
      effects: dense_builder<usize>(),
      tail_open: dense_builder<bool>(),
      tails: dense_builder<usize>()
    }
  )
}

impl SemanticEffectSignatureBuilder {
  fn push(
    self: owned Self,
    effects: SemanticTypeListId,
    tail: SemanticEffectTail
  ) -> (owned SemanticEffectSignatureBuilder, DenseIndex) {
    match self {
      SemanticEffectSignatureBuilder(storage) -> {
        let { effects: effect_values, tail_open, tails } = storage
        let mut effects_builder = effect_values
        let mut open_values = tail_open
        let mut tail_values = tails
        let effect_index = effects_builder.push(semantic_type_list_id_ordinal(effects))
        let zero: usize = 0
        let (open, tail_id) = match tail {
          SemanticClosedEffects -> (false, zero)
          SemanticOpenEffects(id) -> (true, id)
        }
        let open_index = open_values.push(open)
        let tail_index = tail_values.push(tail_id)
        if dense_index_value(effect_index) != dense_index_value(open_index) or
          dense_index_value(effect_index) != dense_index_value(tail_index) {
            panic("Semantic effect signature columns diverged")
          } else { nil }
        (
          SemanticEffectSignatureBuilder(
            SemanticEffectSignatureBuilderStorage {
              effects: effects_builder,
              tail_open: open_values,
              tails: tail_values
            }
          ),
          effect_index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticEffectSignatureColumn {
    match self {
      SemanticEffectSignatureBuilder(storage) -> {
        let { effects, tail_open, tails } = storage
        SemanticEffectSignatureColumn {
          effects: effects.freeze(),
          tail_open: tail_open.freeze(),
          tails: tails.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticEffectSignatureBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticEffectSignatureBuilder(storage) -> {
        let { effects, tail_open, tails } = storage
        effects.drop()
        tail_open.drop()
        tails.drop()
      }
    }
  }
}

fn semantic_named_builder() -> owned SemanticNamedBuilder {
  SemanticNamedBuilder(
    SemanticNamedBuilderStorage {
      identities: semantic_declaration_builder(),
      roles: dense_builder<SemanticNamedRole>(),
      representations: semantic_type_reference_builder(),
      arguments: dense_builder<usize>()
    }
  )
}

impl SemanticNamedBuilder {
  fn push(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    declaration: DeclarationIdentity,
    role: SemanticNamedRole,
    representation: SemanticTypeId,
    arguments: SemanticTypeListId
  ) -> (owned SemanticNamedBuilder, DenseIndex) {
    match self {
      SemanticNamedBuilder(storage) -> {
        let { identities, roles, representations, arguments: argument_values } = storage
        let mut role_values = roles
        let mut arguments_builder = argument_values
        match identities.push(declaration) {
          (next_identities, declaration_index) -> {
            let role_index = role_values.push(role)
            let argument_index = arguments_builder.push(
              semantic_type_list_id_ordinal(arguments)
            )
            match representations.push(segment, representation) {
              (next_representations, representation_index) -> {
                if dense_index_value(declaration_index) != dense_index_value(role_index) or
                  dense_index_value(declaration_index) !=
                  dense_index_value(representation_index) or
                  dense_index_value(declaration_index) !=
                  dense_index_value(argument_index) {
                    panic("Semantic named type columns diverged")
                  } else { nil }
                (
                  SemanticNamedBuilder(
                    SemanticNamedBuilderStorage {
                      identities: next_identities,
                      roles: role_values,
                      representations: next_representations,
                      arguments: arguments_builder
                    }
                  ),
                  declaration_index
                )
              }
            }
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticNamedColumn {
    match self {
      SemanticNamedBuilder(storage) -> {
        let { identities, roles, representations, arguments } = storage
        SemanticNamedColumn {
          identities: identities.freeze(),
          roles: roles.freeze(),
          representations: representations.freeze(),
          arguments: arguments.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticNamedBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticNamedBuilder(storage) -> {
        let { identities, roles, representations, arguments } = storage
        identities.drop()
        roles.drop()
        representations.drop()
        arguments.drop()
      }
    }
  }
}

fn semantic_record_field_builder() -> owned SemanticRecordFieldBuilder {
  SemanticRecordFieldBuilder(
    SemanticRecordFieldBuilderStorage {
      names: map.new<i64, str>(),
      hashes: dense_builder<i64>(),
      types: semantic_type_reference_builder()
    }
  )
}

fn semantic_tuple_field_hash(position: usize) -> i64 {
  match num_scalar_usize_to_i64(position) {
    Some(value) -> 0 - value - 1
    None -> panic("Semantic tuple field position is not representable")
  }
}

impl SemanticRecordFieldBuilder {
  fn len(self: borrow Self) -> usize {
    match self {
      SemanticRecordFieldBuilder(storage) -> {
        let { names, hashes, types } = storage
        hashes.len()
      }
    }
  }

  fn push_named(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    name: str,
    field_type: SemanticTypeId
  ) -> (owned SemanticRecordFieldBuilder, DenseIndex) {
    match self {
      SemanticRecordFieldBuilder(storage) -> {
        let { names, hashes, types } = storage
        let mut hash_values = hashes
        match types.push(segment, field_type) {
          (next_types, type_index) -> {
            let hash_index = hash_values.push(name.hash())
            if dense_index_value(hash_index) != dense_index_value(type_index) {
              panic("Semantic record field columns diverged")
            } else { nil }
            let next_names = names.insert(semantic_type_reference_key(type_index), name)
            (
              SemanticRecordFieldBuilder(
                SemanticRecordFieldBuilderStorage {
                  names: next_names,
                  hashes: hash_values,
                  types: next_types
                }
              ),
              type_index
            )
          }
        }
      }
    }
  }

  fn push_tuple(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    position: usize,
    field_type: SemanticTypeId
  ) -> (owned SemanticRecordFieldBuilder, DenseIndex) {
    match self {
      SemanticRecordFieldBuilder(storage) -> {
        let { names, hashes, types } = storage
        let mut hash_values = hashes
        match types.push(segment, field_type) {
          (next_types, type_index) -> {
            let hash_index = hash_values.push(semantic_tuple_field_hash(position))
            if dense_index_value(hash_index) != dense_index_value(type_index) {
              panic("Semantic tuple field columns diverged")
            } else { nil }
            (
              SemanticRecordFieldBuilder(
                SemanticRecordFieldBuilderStorage {
                  names: names,
                  hashes: hash_values,
                  types: next_types
                }
              ),
              type_index
            )
          }
        }
      }
    }
  }

  fn push_named_fields(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    names: List<str>,
    types: List<SemanticTypeId>,
    length: usize,
    seen: Map<str, bool>
  ) -> (owned SemanticRecordFieldBuilder, usize) {
    match (names, types) {
      (Nil, Nil) -> (self, length)
      (Cons(name, name_rest), Cons(field_type, type_rest)) -> {
        if seen.contains_key(name) {
          panic("Semantic record fields must be unique")
        } else { nil }
        let next_seen = seen.insert(name, true)
        match self.push_named(segment, name, field_type) {
          (next, _) -> next.push_named_fields(
            segment,
            name_rest,
            type_rest,
            length + 1,
            next_seen
          )
        }
      }
      _ -> panic("Semantic record names and types must have equal length")
    }
  }

  fn push_tuple_fields(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    values: List<SemanticTypeId>,
    position: usize
  ) -> (owned SemanticRecordFieldBuilder, usize) {
    match values {
      Nil -> (self, position)
      Cons(field_type, rest) -> match self.push_tuple(segment, position, field_type) {
        (next, _) -> next.push_tuple_fields(segment, rest, position + 1)
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticRecordFieldColumn {
    match self {
      SemanticRecordFieldBuilder(storage) -> {
        let { names, hashes, types } = storage
        SemanticRecordFieldColumn {
          names: names,
          hashes: hashes.freeze(),
          types: types.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticRecordFieldBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticRecordFieldBuilder(storage) -> {
        let { names, hashes, types } = storage
        hashes.drop()
        types.drop()
      }
    }
  }
}

fn semantic_record_builder() -> owned SemanticRecordBuilder {
  SemanticRecordBuilder(
    SemanticRecordBuilderStorage {
      starts: dense_builder<usize>(),
      lengths: dense_builder<usize>(),
      shapes: dense_builder<SemanticRecordShape>(),
      openness: dense_builder<SemanticRecordOpenness>(),
      fields: semantic_record_field_builder()
    }
  )
}

fn finish_semantic_record(
  starts: owned DenseBuilder<usize>,
  lengths: owned DenseBuilder<usize>,
  shapes: owned DenseBuilder<SemanticRecordShape>,
  openness: owned DenseBuilder<SemanticRecordOpenness>,
  fields: owned SemanticRecordFieldBuilder,
  start: usize,
  length: usize,
  shape: SemanticRecordShape,
  open: SemanticRecordOpenness
) -> (owned SemanticRecordBuilder, DenseIndex) {
  let mut start_values = starts
  let mut length_values = lengths
  let mut shape_values = shapes
  let mut openness_values = openness
  let start_index = start_values.push(start)
  let length_index = length_values.push(length)
  let shape_index = shape_values.push(shape)
  let open_index = openness_values.push(open)
  if dense_index_value(start_index) != dense_index_value(length_index) or
    dense_index_value(start_index) != dense_index_value(shape_index) or
    dense_index_value(start_index) != dense_index_value(open_index) {
      panic("Semantic record columns diverged")
    } else { nil }
  (
    SemanticRecordBuilder(
      SemanticRecordBuilderStorage {
        starts: start_values,
        lengths: length_values,
        shapes: shape_values,
        openness: openness_values,
        fields: fields
      }
    ),
    start_index
  )
}

impl SemanticRecordBuilder {
  fn push_record(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    names: List<str>,
    types: List<SemanticTypeId>,
    open: SemanticRecordOpenness
  ) -> (owned SemanticRecordBuilder, DenseIndex) {
    match self {
      SemanticRecordBuilder(storage) -> {
        let { starts, lengths, shapes, openness, fields } = storage
        let start = fields.len()
        match fields.push_named_fields(
          segment,
          names,
          types,
          0,
          map.new<str, bool>()
        ) {
          (next_fields, length) -> finish_semantic_record(
            starts,
            lengths,
            shapes,
            openness,
            next_fields,
            start,
            length,
            SemanticStructuralRecord,
            open
          )
        }
      }
    }
  }

  fn push_tuple(
    self: owned Self,
    segment: SemanticTypeSegmentId,
    values: List<SemanticTypeId>
  ) -> (owned SemanticRecordBuilder, DenseIndex) {
    match self {
      SemanticRecordBuilder(storage) -> {
        let { starts, lengths, shapes, openness, fields } = storage
        let start = fields.len()
        match fields.push_tuple_fields(segment, values, 0) {
          (next_fields, length) -> finish_semantic_record(
            starts,
            lengths,
            shapes,
            openness,
            next_fields,
            start,
            length,
            SemanticTupleRecord,
            SemanticClosedRecord
          )
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticRecordColumn {
    match self {
      SemanticRecordBuilder(storage) -> {
        let { starts, lengths, shapes, openness, fields } = storage
        SemanticRecordColumn {
          starts: starts.freeze(),
          lengths: lengths.freeze(),
          shapes: shapes.freeze(),
          openness: openness.freeze(),
          fields: fields.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticRecordBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticRecordBuilder(storage) -> {
        let { starts, lengths, shapes, openness, fields } = storage
        starts.drop()
        lengths.drop()
        shapes.drop()
        openness.drop()
        fields.drop()
      }
    }
  }
}

fn semantic_variant_builder() -> owned SemanticVariantBuilder {
  SemanticVariantBuilder(
    SemanticVariantBuilderStorage {
      identities: semantic_declaration_builder(),
      payloads: semantic_type_reference_builder()
    }
