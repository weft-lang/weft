-- Segmented typed storage for canonical semantic types.
--
-- A SemanticTypeId is a segment identity plus an ordinal, never a pointer.
-- The graph owns a hot kind column and a payload-ordinal column; complete
-- shape access goes through kind-specific typed payload columns. This first
-- production-shaped slice covers the set-theoretic core used by DNF. Later
-- slices add the nominal, callable, record and effect columns before the
-- legacy algebra switches storage.

use compiler/weft/check/storage.{
  DenseBuilder,
  DenseIndex,
  DenseSegment,
  dense_builder,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use compiler/project/identity.{ModuleIdentity}
use compiler/project/identity/equality.{module_identity_eq}
use stdlib/drop.{Drop}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type SemanticTypeSegmentId = opaque ModuleIdentity

pub(package) type SemanticTypeId = opaque(SemanticTypeSegmentId, DenseIndex)

pub(package) type SemanticLocalTypeId = opaque DenseIndex

pub(package) type SemanticPrimitive {
  SemanticI64,
  SemanticStr,
  SemanticBool,
  SemanticNil,
  SemanticF64,
  SemanticI32,
  SemanticI8,
  SemanticI16,
  SemanticU8,
  SemanticU16,
  SemanticU32,
  SemanticU64,
  SemanticIsize,
  SemanticUsize,
  SemanticF32
}

pub(package) type SemanticMutability {
  SemanticImmutable,
  SemanticMutable
}

pub(package) type SemanticTypeKind {
  SemanticBottomKind,
  SemanticTopKind,
  SemanticPrimitiveKind,
  SemanticUnionKind,
  SemanticIntersectionKind,
  SemanticComplementKind,
  SemanticContinuationKind,
  SemanticWeakKind,
  SemanticAtomicKind,
  SemanticUniqueKind,
  SemanticOwnedKind,
  SemanticPointerKind,
  SemanticBorrowKind,
  SemanticSliceKind,
  SemanticArrayKind
}

pub(package) type SemanticPrimitiveView {
  SemanticPrimitivePresent(SemanticPrimitive),
  SemanticPrimitiveAbsent
}

pub(package) type SemanticUnaryTypeView {
  SemanticUnaryTypePresent(SemanticTypeId),
  SemanticUnaryTypeAbsent
}

pub(package) type SemanticBinaryTypeView {
  SemanticBinaryTypePresent(SemanticTypeId, SemanticTypeId),
  SemanticBinaryTypeAbsent
}

pub(package) type SemanticTypeNode {
  SemanticBottomNode,
  SemanticTopNode,
  SemanticPrimitiveNode(SemanticPrimitive),
  SemanticUnionNode(SemanticTypeId, SemanticTypeId),
  SemanticIntersectionNode(SemanticTypeId, SemanticTypeId),
  SemanticComplementNode(SemanticTypeId),
  SemanticContinuationNode(SemanticTypeId, SemanticTypeId),
  SemanticWeakNode(SemanticTypeId),
  SemanticAtomicNode(SemanticTypeId),
  SemanticUniqueNode(SemanticTypeId),
  SemanticOwnedNode(SemanticTypeId),
  SemanticPointerNode(SemanticTypeId, SemanticMutability),
  SemanticBorrowNode(SemanticTypeId, SemanticMutability),
  SemanticSliceNode(SemanticTypeId, SemanticMutability),
  SemanticArrayNode(SemanticTypeId, usize)
}

pub(package) type SemanticUnaryTypeEdge = opaque DenseIndex

pub(package) type SemanticBinaryTypeEdges = opaque DenseIndex

pub(package) type SemanticMutableUnaryTypeEdge = opaque DenseIndex

pub(package) type SemanticArrayTypeEdge = opaque DenseIndex

type SemanticTypeReferenceBuilderStorage {
  ordinals: owned DenseBuilder<usize>,
  imported: owned DenseBuilder<bool>,
  modules: Map<i64, ModuleIdentity>
}

type SemanticTypeReferenceBuilder = opaque SemanticTypeReferenceBuilderStorage

type SemanticTypeLocalReferenceColumn {
  ordinals: DenseSegment<usize>,
  imported: DenseSegment<bool>
}

type SemanticTypeReferenceColumn {
  local: SemanticTypeLocalReferenceColumn,
  modules: Map<i64, ModuleIdentity>
}

type SemanticMutableUnaryBuilderStorage {
  references: owned SemanticTypeReferenceBuilder,
  mutability: owned DenseBuilder<SemanticMutability>
}

type SemanticMutableUnaryBuilder = opaque SemanticMutableUnaryBuilderStorage

type SemanticMutableUnaryColumn {
  references: SemanticTypeReferenceColumn,
  mutability: DenseSegment<SemanticMutability>
}

type SemanticArrayBuilderStorage {
  elements: owned SemanticTypeReferenceBuilder,
  lengths: owned DenseBuilder<usize>
}

type SemanticArrayBuilder = opaque SemanticArrayBuilderStorage

type SemanticArrayColumn {
  elements: SemanticTypeReferenceColumn,
  lengths: DenseSegment<usize>
}

type SemanticTypeGraphBuilderStorage {
  segment: SemanticTypeSegmentId,
  kinds: owned DenseBuilder<SemanticTypeKind>,
  payloads: owned DenseBuilder<usize>,
  primitives: owned DenseBuilder<SemanticPrimitive>,
  unary: owned SemanticTypeReferenceBuilder,
  binary_left: owned SemanticTypeReferenceBuilder,
  binary_right: owned SemanticTypeReferenceBuilder,
  mutable_unary: owned SemanticMutableUnaryBuilder,
  arrays: owned SemanticArrayBuilder
}

pub(package) type SemanticTypeGraphBuilder = opaque SemanticTypeGraphBuilderStorage

type SemanticTypeGraphStorage {
  segment: SemanticTypeSegmentId,
  kinds: DenseSegment<SemanticTypeKind>,
  payloads: DenseSegment<usize>,
  primitives: DenseSegment<SemanticPrimitive>,
  unary: SemanticTypeReferenceColumn,
  binary_left: SemanticTypeReferenceColumn,
  binary_right: SemanticTypeReferenceColumn,
  mutable_unary: SemanticMutableUnaryColumn,
  arrays: SemanticArrayColumn
}

pub(package) type SemanticTypeGraph = opaque SemanticTypeGraphStorage

pub(package) type SemanticTypeLocalGraph {
  SemanticTypeLocalGraphColumns(
    DenseSegment<SemanticTypeKind>,
    DenseSegment<usize>,
    DenseSegment<SemanticPrimitive>,
    DenseSegment<usize>,
    DenseSegment<bool>,
    DenseSegment<usize>,
    DenseSegment<bool>,
    DenseSegment<usize>,
    DenseSegment<bool>,
    SemanticMutableUnaryLocalColumns,
    SemanticArrayLocalColumns
  )
}

type SemanticMutableUnaryLocalColumns {
  SemanticMutableUnaryLocalColumns(
    DenseSegment<usize>,
    DenseSegment<bool>,
    DenseSegment<SemanticMutability>
  )
}

type SemanticArrayLocalColumns {
  SemanticArrayLocalColumns(
    DenseSegment<usize>,
    DenseSegment<bool>,
    DenseSegment<usize>
  )
}

pub(package) fn semantic_type_segment_id(
  identity: ModuleIdentity
) -> SemanticTypeSegmentId {
  SemanticTypeSegmentId(identity)
}

pub(package) fn semantic_type_segment_module(
  id: SemanticTypeSegmentId
) -> ModuleIdentity {
  match id { SemanticTypeSegmentId(identity) -> identity }
}

pub(package) fn semantic_type_id_segment(id: SemanticTypeId) -> SemanticTypeSegmentId {
  match id { SemanticTypeId((segment, _)) -> segment }
}

pub(package) fn semantic_type_id_ordinal(id: SemanticTypeId) -> usize {
  match id { SemanticTypeId((_, index)) -> dense_index_value(index) }
}

pub(package) fn semantic_local_type_id_ordinal(id: SemanticLocalTypeId) -> usize {
  match id { SemanticLocalTypeId(index) -> dense_index_value(index) }
}

pub(package) fn semantic_local_type_id_eq(
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  semantic_local_type_id_ordinal(left) == semantic_local_type_id_ordinal(right)
}

pub(package) fn semantic_type_segment_id_eq(
  left: SemanticTypeSegmentId,
  right: SemanticTypeSegmentId
) -> bool {
  module_identity_eq(
    semantic_type_segment_module(left),
    semantic_type_segment_module(right)
  )
}

pub(package) fn semantic_type_id_eq(left: SemanticTypeId, right: SemanticTypeId) -> bool {
  semantic_type_segment_id_eq(
    semantic_type_id_segment(left),
    semantic_type_id_segment(right)
  ) and semantic_type_id_ordinal(left) == semantic_type_id_ordinal(right)
}

fn semantic_type_reference_builder() -> owned SemanticTypeReferenceBuilder {
  SemanticTypeReferenceBuilder(
    SemanticTypeReferenceBuilderStorage {
      ordinals: dense_builder<usize>(),
      imported: dense_builder<bool>(),
      modules: map.new<i64, ModuleIdentity>()
    }
  )
}

fn semantic_type_reference_key(index: DenseIndex) -> i64 {
  match num_scalar_usize_to_i64(dense_index_value(index)) {
    Some(value) -> value
    None -> panic("Semantic type reference index is not representable")
  }
}

impl SemanticTypeReferenceBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    reference: SemanticTypeId
  ) -> (owned SemanticTypeReferenceBuilder, DenseIndex) {
    match self {
      SemanticTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, modules } = storage
        let mut ordinal_values = ordinals
        let mut imported_values = imported
        let index = ordinal_values.push(semantic_type_id_ordinal(reference))
        let foreign = not semantic_type_segment_id_eq(
          local,
          semantic_type_id_segment(reference)
        )
        let imported_index = imported_values.push(foreign)
        if dense_index_value(index) != dense_index_value(imported_index) {
          panic("Semantic type reference columns diverged")
        } else { nil }
        let next_modules = if foreign {
          modules.insert(
            semantic_type_reference_key(index),
            semantic_type_segment_module(semantic_type_id_segment(reference))
          )
        } else { modules }
        (
          SemanticTypeReferenceBuilder(
            SemanticTypeReferenceBuilderStorage {
              ordinals: ordinal_values,
              imported: imported_values,
              modules: next_modules
            }
          ),
          index
        )
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticTypeReferenceColumn {
    match self {
      SemanticTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, modules } = storage
        SemanticTypeReferenceColumn {
          local: SemanticTypeLocalReferenceColumn {
            ordinals: ordinals.freeze(),
            imported: imported.freeze()
          },
          modules: modules
        }
      }
    }
  }
}

impl Drop for SemanticTypeReferenceBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticTypeReferenceBuilder(storage) -> {
        let { ordinals, imported, modules } = storage
        ordinals.drop()
        imported.drop()
      }
    }
  }
}

fn semantic_mutable_unary_builder() -> owned SemanticMutableUnaryBuilder {
  SemanticMutableUnaryBuilder(
    SemanticMutableUnaryBuilderStorage {
      references: semantic_type_reference_builder(),
      mutability: dense_builder<SemanticMutability>()
    }
  )
}

impl SemanticMutableUnaryBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticMutableUnaryBuilder, DenseIndex) {
    match self {
      SemanticMutableUnaryBuilder(storage) -> {
        let { references, mutability: mutability_values } = storage
        let mut flags = mutability_values
        match references.push(local, inner) {
          (reference_values, reference_index) -> {
            let flag_index = flags.push(mutability)
            if dense_index_value(reference_index) != dense_index_value(flag_index) {
              panic("Semantic mutable unary columns diverged")
            } else { nil }
            (
              SemanticMutableUnaryBuilder(
                SemanticMutableUnaryBuilderStorage {
                  references: reference_values,
                  mutability: flags
                }
              ),
              reference_index
            )
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticMutableUnaryColumn {
    match self {
      SemanticMutableUnaryBuilder(storage) -> {
        let { references, mutability } = storage
        SemanticMutableUnaryColumn {
          references: references.freeze(),
          mutability: mutability.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticMutableUnaryBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticMutableUnaryBuilder(storage) -> {
        let { references, mutability } = storage
        references.drop()
        mutability.drop()
      }
    }
  }
}

fn semantic_array_builder() -> owned SemanticArrayBuilder {
  SemanticArrayBuilder(
    SemanticArrayBuilderStorage {
      elements: semantic_type_reference_builder(),
      lengths: dense_builder<usize>()
    }
  )
}

impl SemanticArrayBuilder {
  fn push(
    self: owned Self,
    local: SemanticTypeSegmentId,
    element: SemanticTypeId,
    length: usize
  ) -> (owned SemanticArrayBuilder, DenseIndex) {
    match self {
      SemanticArrayBuilder(storage) -> {
        let { elements, lengths } = storage
        let mut length_values = lengths
        match elements.push(local, element) {
          (element_values, element_index) -> {
            let length_index = length_values.push(length)
            if dense_index_value(element_index) != dense_index_value(length_index) {
              panic("Semantic array columns diverged")
            } else { nil }
            (
              SemanticArrayBuilder(
                SemanticArrayBuilderStorage {
                  elements: element_values,
                  lengths: length_values
                }
              ),
              element_index
            )
          }
        }
      }
    }
  }

  fn freeze(self: owned Self) -> SemanticArrayColumn {
    match self {
      SemanticArrayBuilder(storage) -> {
        let { elements, lengths } = storage
        SemanticArrayColumn {
          elements: elements.freeze(),
          lengths: lengths.freeze()
        }
      }
    }
  }
}

impl Drop for SemanticArrayBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticArrayBuilder(storage) -> {
        let { elements, lengths } = storage
        elements.drop()
        lengths.drop()
      }
    }
  }
}

fn semantic_type_reference_is_imported_at(
  imported: borrow DenseSegment<bool>,
  index: DenseIndex
) -> bool {
  imported.at(index)
}

fn semantic_type_reference_local_id_at(
  ordinals: borrow DenseSegment<usize>,
  imported: borrow DenseSegment<bool>,
  index: DenseIndex
) -> SemanticLocalTypeId {
  if imported.at(index) { panic("Semantic type reference is imported") }
  else { SemanticLocalTypeId(dense_index(ordinals.at(index))) }
}

fn semantic_type_reference_type_at(
  column: borrow SemanticTypeReferenceColumn,
  segment: SemanticTypeSegmentId,
  index: DenseIndex
) -> SemanticTypeId {
  let { local, modules } = column
  let local_column = local
  let { ordinals, imported } = local_column
  let ordinal = dense_index(ordinals.at(index))
  if imported.at(index) {
    match modules.get(semantic_type_reference_key(index)) {
      Some(module) -> SemanticTypeId((semantic_type_segment_id(module), ordinal))
      None -> panic("Semantic type import reference is missing its module")
    }
  } else { SemanticTypeId((segment, ordinal)) }
}

pub(package) fn semantic_type_graph_builder(
  segment: SemanticTypeSegmentId
) -> owned SemanticTypeGraphBuilder {
  SemanticTypeGraphBuilder(
    SemanticTypeGraphBuilderStorage {
      segment: segment,
      kinds: dense_builder<SemanticTypeKind>(),
      payloads: dense_builder<usize>(),
      primitives: dense_builder<SemanticPrimitive>(),
      unary: semantic_type_reference_builder(),
      binary_left: semantic_type_reference_builder(),
      binary_right: semantic_type_reference_builder(),
      mutable_unary: semantic_mutable_unary_builder(),
      arrays: semantic_array_builder()
    }
  )
}

pub(package) fn semantic_type_graph_builder_with_capacity(
  segment: SemanticTypeSegmentId,
  capacity: usize
) -> owned SemanticTypeGraphBuilder {
  SemanticTypeGraphBuilder(
    SemanticTypeGraphBuilderStorage {
      segment: segment,
      kinds: dense_builder_with_capacity<SemanticTypeKind>(capacity),
      payloads: dense_builder_with_capacity<usize>(capacity),
      primitives: dense_builder<SemanticPrimitive>(),
      unary: semantic_type_reference_builder(),
      binary_left: semantic_type_reference_builder(),
      binary_right: semantic_type_reference_builder(),
      mutable_unary: semantic_mutable_unary_builder(),
      arrays: semantic_array_builder()
    }
  )
}

fn append_node(
  segment: SemanticTypeSegmentId,
  kinds: borrow mut DenseBuilder<SemanticTypeKind>,
  payloads: borrow mut DenseBuilder<usize>,
  kind: SemanticTypeKind,
  payload: usize
) -> SemanticTypeId {
  let index = kinds.push(kind)
  let payload_index = payloads.push(payload)
  if dense_index_value(index) != dense_index_value(payload_index) {
    panic("Semantic type graph columns diverged")
  } else { nil }
  SemanticTypeId((segment, index))
}

fn finish_append(
  segment: SemanticTypeSegmentId,
  kinds: owned DenseBuilder<SemanticTypeKind>,
  payloads: owned DenseBuilder<usize>,
  primitives: owned DenseBuilder<SemanticPrimitive>,
  unary: owned SemanticTypeReferenceBuilder,
  binary_left: owned SemanticTypeReferenceBuilder,
  binary_right: owned SemanticTypeReferenceBuilder,
  mutable_unary: owned SemanticMutableUnaryBuilder,
  arrays: owned SemanticArrayBuilder,
  kind: SemanticTypeKind,
  payload: usize
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  let mut kind_values = kinds
  let mut payload_values = payloads
  let id = append_node(segment, kind_values, payload_values, kind, payload)
  (
    SemanticTypeGraphBuilder(
      SemanticTypeGraphBuilderStorage {
        segment: segment,
        kinds: kind_values,
        payloads: payload_values,
        primitives: primitives,
        unary: unary,
        binary_left: binary_left,
        binary_right: binary_right,
        mutable_unary: mutable_unary,
        arrays: arrays
      }
    ),
    id
  )
}

fn append_unary_node(
  builder: owned SemanticTypeGraphBuilder,
  inner: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      match unary.push(segment, inner) {
        (unary_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary_values,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          kind,
          dense_index_value(index)
        )
      }
    }
  }
}

fn append_binary_node(
  builder: owned SemanticTypeGraphBuilder,
  left: SemanticTypeId,
  right: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      match binary_left.push(segment, left) {
        (left_values, left_index) -> match binary_right.push(segment, right) {
          (right_values, right_index) -> {
            if dense_index_value(left_index) != dense_index_value(right_index) {
              panic("Semantic binary type columns diverged")
            } else { nil }
            finish_append(
              segment,
              kinds,
              payloads,
              primitives,
              unary,
              left_values,
              right_values,
              mutable_unary,
              arrays,
              kind,
              dense_index_value(left_index)
            )
          }
        }
      }
    }
  }
}

fn append_mutable_unary_node(
  builder: owned SemanticTypeGraphBuilder,
  inner: SemanticTypeId,
  mutability: SemanticMutability,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      match mutable_unary.push(segment, inner, mutability) {
        (mutable_unary_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary_values,
          arrays,
          kind,
          dense_index_value(index)
        )
      }
    }
  }
}

fn append_array_node(
  builder: owned SemanticTypeGraphBuilder,
  element: SemanticTypeId,
  length: usize
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
  match builder {
    SemanticTypeGraphBuilder(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      match arrays.push(segment, element, length) {
        (array_values, index) -> finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          array_values,
          SemanticArrayKind,
          dense_index_value(index)
        )
      }
    }
  }
}

impl SemanticTypeGraphBuilder {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        kinds.len()
      }
    }
  }

  pub(package) fn bottom(
    self: owned Self
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    let zero: usize = 0
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          SemanticBottomKind,
          zero
        )
      }
    }
  }

  pub(package) fn top(
    self: owned Self
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    let zero: usize = 0
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        finish_append(
          segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          SemanticTopKind,
          zero
        )
      }
    }
  }

  pub(package) fn primitive(
    self: owned Self,
    primitive: SemanticPrimitive
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        let mut primitive_values = primitives
        let payload = dense_index_value(primitive_values.push(primitive))
        finish_append(
          segment,
          kinds,
          payloads,
          primitive_values,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
          SemanticPrimitiveKind,
          payload
        )
      }
    }
  }

  pub(package) fn complement(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticComplementKind)
  }

  pub(package) fn weak(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticWeakKind)
  }

  pub(package) fn atomic(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticAtomicKind)
  }

  pub(package) fn unique(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticUniqueKind)
  }

  pub(package) fn owned(
    self: owned Self,
    inner: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_unary_node(self, inner, SemanticOwnedKind)
  }

  pub(package) fn pointer(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticPointerKind)
  }

  pub(package) fn borrow(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticBorrowKind)
  }

  pub(package) fn slice(
    self: owned Self,
    inner: SemanticTypeId,
    mutability: SemanticMutability
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_mutable_unary_node(self, inner, mutability, SemanticSliceKind)
  }

  pub(package) fn array(
    self: owned Self,
    element: SemanticTypeId,
    length: usize
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_array_node(self, element, length)
  }

  pub(package) fn union(
    self: owned Self,
    left: SemanticTypeId,
    right: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, left, right, SemanticUnionKind)
  }

  pub(package) fn intersection(
    self: owned Self,
    left: SemanticTypeId,
    right: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, left, right, SemanticIntersectionKind)
  }

  pub(package) fn continuation(
    self: owned Self,
    input: SemanticTypeId,
    result: SemanticTypeId
  ) -> (owned SemanticTypeGraphBuilder, SemanticTypeId) {
    append_binary_node(self, input, result, SemanticContinuationKind)
  }

  pub(package) fn freeze(self: owned Self) -> SemanticTypeGraph {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        SemanticTypeGraph(
          SemanticTypeGraphStorage {
            segment: segment,
            kinds: kinds.freeze(),
            payloads: payloads.freeze(),
            primitives: primitives.freeze(),
            unary: unary.freeze(),
            binary_left: binary_left.freeze(),
            binary_right: binary_right.freeze(),
            mutable_unary: mutable_unary.freeze(),
            arrays: arrays.freeze()
          }
        )
      }
    }
  }
}

impl Drop for SemanticTypeGraphBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticTypeGraphBuilder(storage) -> {
        let {
          segment,
            kinds,
            payloads,
            primitives,
            unary,
            binary_left,
            binary_right,
            mutable_unary,
            arrays,
        } = storage
        kinds.drop()
        payloads.drop()
        primitives.drop()
        unary.drop()
        binary_left.drop()
        binary_right.drop()
        mutable_unary.drop()
        arrays.drop()
      }
    }
  }
}

pub(package) fn semantic_type_graph_segment(
  graph: borrow SemanticTypeGraph
) -> SemanticTypeSegmentId {
  match graph { SemanticTypeGraph(storage) -> storage.segment }
}

pub(package) fn semantic_type_graph_local(
  graph: borrow SemanticTypeGraph
) -> SemanticTypeLocalGraph {
  match graph {
    SemanticTypeGraph(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      let { local: unary_local, modules: _ } = unary
      let { local: binary_left_local, modules: _ } = binary_left
      let { local: binary_right_local, modules: _ } = binary_right
      let { ordinals: unary_ordinals, imported: unary_imported } = unary_local
      let {
        ordinals: binary_left_ordinals,
          imported: binary_left_imported,
      } = binary_left_local
      let {
        ordinals: binary_right_ordinals,
          imported: binary_right_imported,
      } = binary_right_local
      let {
        references: mutable_unary_references,
          mutability,
      } = mutable_unary
      let {
        local: mutable_unary_local,
          modules: _,
      } = mutable_unary_references
      let {
        ordinals: mutable_unary_ordinals,
          imported: mutable_unary_imported,
      } = mutable_unary_local
      let { elements, lengths } = arrays
      let { local: array_local, modules: _ } = elements
      let { ordinals: array_ordinals, imported: array_imported } = array_local
      SemanticTypeLocalGraphColumns(
        kinds,
        payloads,
        primitives,
        unary_ordinals,
        unary_imported,
        binary_left_ordinals,
        binary_left_imported,
        binary_right_ordinals,
        binary_right_imported,
        SemanticMutableUnaryLocalColumns(
          mutable_unary_ordinals,
          mutable_unary_imported,
          mutability
        ),
        SemanticArrayLocalColumns(array_ordinals, array_imported, lengths)
      )
    }
  }
}

pub(package) fn semantic_type_graph_len(graph: borrow SemanticTypeGraph) -> usize {
  match graph {
    SemanticTypeGraph(storage) -> {
      let {
        segment,
          kinds,
          payloads,
          primitives,
          unary,
          binary_left,
          binary_right,
          mutable_unary,
          arrays,
      } = storage
      kinds.len()
    }
  }
}

pub(package) fn semantic_type_local_graph_len(
  graph: borrow SemanticTypeLocalGraph
) -> usize {
  match graph {
    SemanticTypeLocalGraphColumns(
      kinds,
      payloads,
      primitives,
      unary_ordinals,
      unary_imported,
      binary_left_ordinals,
      binary_left_imported,
      binary_right_ordinals,
      binary_right_imported,
      mutable_unary,
      arrays,
    ) -> kinds.len()
  }
}

pub(package) fn semantic_type_graph_contains(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> bool {
  semantic_type_segment_id_eq(
    semantic_type_graph_segment(graph),
    semantic_type_id_segment(id)
  ) and semantic_type_id_ordinal(id) < semantic_type_graph_len(graph)
}

fn semantic_type_graph_index(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> DenseIndex {
  if semantic_type_graph_contains(graph, id) {
    dense_index(semantic_type_id_ordinal(id))
  } else { panic("Semantic type id does not belong to this segment") }
}

fn semantic_type_graph_local_index(
  graph: borrow SemanticTypeLocalGraph,
  id: SemanticLocalTypeId
) -> DenseIndex {
  let ordinal = semantic_local_type_id_ordinal(id)
  if ordinal < semantic_type_local_graph_len(graph) { dense_index(ordinal) }
  else { panic("Semantic local type id is out of bounds") }
}

pub(package) fn semantic_type_graph_local_id(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticLocalTypeId {
  SemanticLocalTypeId(semantic_type_graph_index(graph, id))
}

pub(package) fn semantic_type_graph_type_id(
  graph: borrow SemanticTypeGraph,
  id: SemanticLocalTypeId
) -> SemanticTypeId {
  let local = semantic_type_graph_local(graph)
  SemanticTypeId(
    (
      semantic_type_graph_segment(graph),
      semantic_type_graph_local_index(local, id)
    )
  )
}

pub(package) fn semantic_type_graph_kind(
  graph: borrow SemanticTypeGraph,
