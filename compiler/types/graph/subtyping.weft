-- Semantic emptiness and subtyping over catalogued type graphs.
--
-- DNF supplies the Boolean structure. Opaque atoms are interpreted here by
-- the primitive, record, indexed, callable and trait-conformance laws. The
-- implementation carries complete semantic ids and resolves every imported
-- edge through the checked-program catalog.

use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/dnf.{*}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

fn semantic_subtyping_required_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic subtyping id is outside its segment") }
    None -> panic("Semantic subtyping catalog is missing a segment")
  }
}

fn semantic_subtyping_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeKind {
  let graph = semantic_subtyping_required_graph(catalog, id)
  semantic_type_graph_kind(graph, id)
}

fn semantic_subtyping_primitive(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticPrimitive {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_primitive(
    local,
    semantic_type_graph_local_id(graph, id)
  )
}

fn semantic_primitive_equal(
  left: SemanticPrimitive,
  right: SemanticPrimitive
) -> bool {
  match (left, right) {
    (SemanticI64, SemanticI64) -> true
    (SemanticStr, SemanticStr) -> true
    (SemanticBool, SemanticBool) -> true
    (SemanticNil, SemanticNil) -> true
    (SemanticF64, SemanticF64) -> true
    (SemanticI32, SemanticI32) -> true
    (SemanticI8, SemanticI8) -> true
    (SemanticI16, SemanticI16) -> true
    (SemanticU8, SemanticU8) -> true
    (SemanticU16, SemanticU16) -> true
    (SemanticU32, SemanticU32) -> true
    (SemanticU64, SemanticU64) -> true
    (SemanticIsize, SemanticIsize) -> true
    (SemanticUsize, SemanticUsize) -> true
    (SemanticF32, SemanticF32) -> true
    _ -> false
  }
}

fn semantic_primitive_is_subprimitive(
  actual: SemanticPrimitive,
  expected: SemanticPrimitive
) -> bool {
  match (actual, expected) {
    (SemanticBool, SemanticI64) -> true
    _ -> false
  }
}

fn semantic_primitives_overlap(
  left: SemanticPrimitive,
  right: SemanticPrimitive
) -> bool {
  semantic_primitive_equal(left, right) or
    semantic_primitive_is_subprimitive(left, right) or
    semantic_primitive_is_subprimitive(right, left)
}

fn semantic_mutability_equal(
  left: SemanticMutability,
  right: SemanticMutability
) -> bool {
  match (left, right) {
    (SemanticImmutable, SemanticImmutable) -> true
    (SemanticMutable, SemanticMutable) -> true
    _ -> false
  }
}

fn semantic_record_shape_equal(
  left: SemanticRecordShape,
  right: SemanticRecordShape
) -> bool {
  match (left, right) {
    (SemanticStructuralRecord, SemanticStructuralRecord) -> true
    (SemanticTupleRecord, SemanticTupleRecord) -> true
    _ -> false
  }
}

fn semantic_record_field_name_equal(
  left: SemanticRecordFieldName,
  right: SemanticRecordFieldName
) -> bool {
  match (left, right) {
    (SemanticNamedRecordField(left_name), SemanticNamedRecordField(right_name)) ->
      left_name == right_name
    (
      SemanticTupleRecordField(left_index),
      SemanticTupleRecordField(right_index),
    ) -> left_index == right_index
    _ -> false
  }
}

fn semantic_subtyping_unary_inner(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_unary_type_id(
    graph,
    semantic_type_local_graph_unary(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_subtyping_mutable_inner(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_mutable_unary_type_id(
    graph,
    semantic_type_local_graph_mutable_unary(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_subtyping_mutability(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticMutability {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_mutability(
    local,
    semantic_type_local_graph_mutable_unary(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_subtyping_array_element(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_array_type_id(
    graph,
    semantic_type_local_graph_array(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_subtyping_array_length(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> usize {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_array_length(
    local,
    semantic_type_local_graph_array(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_record_field_name(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  offset: usize
) -> SemanticRecordFieldName {
  let graph = semantic_subtyping_required_graph(catalog, record)
  let local = semantic_type_graph_local(graph)
  let records = semantic_type_graph_records_local(graph)
  let record_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(graph, record)
  )
  semantic_type_graph_record_field_name(
    graph,
    semantic_type_record_field_edge(
      records,
      semantic_type_record_fields(records, record_edge),
      offset
    )
  )
}

fn semantic_record_field_type(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  offset: usize
) -> SemanticTypeId {
  let graph = semantic_subtyping_required_graph(catalog, record)
  let local = semantic_type_graph_local(graph)
  let records = semantic_type_graph_records_local(graph)
  let record_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(graph, record)
  )
  semantic_type_graph_record_field_type_id(
    graph,
    semantic_type_record_field_edge(
      records,
      semantic_type_record_fields(records, record_edge),
      offset
    )
  )
}

fn semantic_record_field_count(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId
) -> usize {
  let graph = semantic_subtyping_required_graph(catalog, record)
  let local = semantic_type_graph_local(graph)
  let records = semantic_type_graph_records_local(graph)
  let record_edge = semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(graph, record)
  )
  semantic_type_record_field_count(
    records,
    semantic_type_record_fields(records, record_edge)
  )
}

fn semantic_record_shape(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId
) -> SemanticRecordShape {
  let graph = semantic_subtyping_required_graph(catalog, record)
  let local = semantic_type_graph_local(graph)
  let records = semantic_type_graph_records_local(graph)
  semantic_type_record_shape(
    records,
    semantic_type_local_graph_record(
      local,
      semantic_type_graph_local_id(graph, record)
    )
  )
}

fn semantic_record_is_open(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId
) -> bool {
  let graph = semantic_subtyping_required_graph(catalog, record)
  let local = semantic_type_graph_local(graph)
  let records = semantic_type_graph_records_local(graph)
  match semantic_type_record_openness(
    records,
    semantic_type_local_graph_record(
      local,
      semantic_type_graph_local_id(graph, record)
    )
  ) {
    SemanticClosedRecord -> false
    SemanticOpenRecord -> true
  }
}

fn semantic_record_find_field_from(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  wanted_record: SemanticTypeId,
  wanted_offset: usize,
  offset: usize
) -> Option<usize> {
  if offset >= semantic_record_field_count(catalog, record) { None<usize>() }
  else {
    if semantic_record_field_name_equal(
      semantic_record_field_name(catalog, record, offset),
      semantic_record_field_name(catalog, wanted_record, wanted_offset)
    ) { Some<usize>(offset) }
    else {
      semantic_record_find_field_from(
        catalog,
        record,
        wanted_record,
        wanted_offset,
        offset + 1
      )
    }
  }
}

fn semantic_record_fields_domain_equal_from(
  catalog: borrow SemanticTypeCatalog,
  left: SemanticTypeId,
  right: SemanticTypeId,
  offset: usize
) -> bool {
  let left_count = semantic_record_field_count(catalog, left)
  let right_count = semantic_record_field_count(catalog, right)
  if left_count != right_count { false }
  else {
    if offset >= left_count { true }
    else {
      match semantic_record_find_field_from(
        catalog,
        right,
        left,
        offset,
        __i64_to_usize(0)
      ) {
        Some(_) -> semantic_record_fields_domain_equal_from(
          catalog,
          left,
          right,
          offset + 1
        )
        None -> false
      }
    }
  }
}

fn semantic_type_intersection_is_empty(
  catalog: borrow SemanticTypeCatalog,
  left: SemanticTypeId,
  right: SemanticTypeId
) -[SemanticConformance]> bool {
  semantic_dnf_is_empty(
    catalog,
    semantic_dnf_intersection(
      semantic_type_to_dnf(catalog, left),
      semantic_type_to_dnf(catalog, right)
    )
  )
}

fn semantic_record_has_empty_field_from(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  offset: usize
) -[SemanticConformance]> bool {
  if offset >= semantic_record_field_count(catalog, record) { false }
  else {
    semantic_type_is_empty(
      catalog,
      semantic_record_field_type(catalog, record, offset)
    ) or semantic_record_has_empty_field_from(catalog, record, offset + 1)
  }
}

fn semantic_record_positive_atoms_are_disjoint(
  catalog: borrow SemanticTypeCatalog,
  left: SemanticTypeId,
  right: SemanticTypeId
) -[SemanticConformance]> bool {
  if not semantic_record_shape_equal(
    semantic_record_shape(catalog, left),
    semantic_record_shape(catalog, right)
  ) { true }
  else {
    if not semantic_record_is_open(catalog, left) and
      not semantic_record_is_open(catalog, right) and
      not semantic_record_fields_domain_equal_from(
        catalog,
        left,
        right,
        __i64_to_usize(0)
      ) { true }
    else {
      semantic_record_fields_disjoint_from(
        catalog,
        left,
        right,
        __i64_to_usize(0)
      ) or semantic_record_fields_missing_from_closed(
        catalog,
        right,
        left,
        __i64_to_usize(0)
      )
    }
  }
}

fn semantic_record_fields_disjoint_from(
  catalog: borrow SemanticTypeCatalog,
  source: SemanticTypeId,
  other: SemanticTypeId,
  offset: usize
) -[SemanticConformance]> bool {
  if offset >= semantic_record_field_count(catalog, source) { false }
  else {
    match semantic_record_find_field_from(
      catalog,
      other,
      source,
      offset,
      __i64_to_usize(0)
    ) {
      Some(other_offset) -> semantic_type_intersection_is_empty(
        catalog,
        semantic_record_field_type(catalog, source, offset),
        semantic_record_field_type(catalog, other, other_offset)
      ) or semantic_record_fields_disjoint_from(
        catalog,
        source,
        other,
        offset + 1
      )
      None -> if semantic_record_is_open(catalog, other) {
        semantic_record_fields_disjoint_from(
          catalog,
          source,
          other,
          offset + 1
        )
      } else { true }
    }
  }
}

fn semantic_record_fields_missing_from_closed(
  catalog: borrow SemanticTypeCatalog,
  source: SemanticTypeId,
  other: SemanticTypeId,
  offset: usize
) -> bool {
  if semantic_record_is_open(catalog, other) or
    offset >= semantic_record_field_count(catalog, source) { false }
  else {
    match semantic_record_find_field_from(
      catalog,
      other,
      source,
      offset,
      __i64_to_usize(0)
    ) {
      Some(_) -> semantic_record_fields_missing_from_closed(
        catalog,
        source,
        other,
        offset + 1
      )
      None -> true
    }
  }
}

fn semantic_record_subtype_fields_from(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId,
  offset: usize
) -[SemanticConformance]> bool {
  if offset >= semantic_record_field_count(catalog, expected) { true }
  else {
    match semantic_record_find_field_from(
      catalog,
      actual,
      expected,
      offset,
      __i64_to_usize(0)
    ) {
      Some(actual_offset) -> semantic_type_is_subtype(
        catalog,
        semantic_record_field_type(catalog, actual, actual_offset),
        semantic_record_field_type(catalog, expected, offset)
      ) and semantic_record_subtype_fields_from(
        catalog,
        actual,
        expected,
        offset + 1
      )
      None -> false
    }
  }
}

fn semantic_record_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  if not semantic_record_shape_equal(
    semantic_record_shape(catalog, actual),
    semantic_record_shape(catalog, expected)
  ) { false }
  else {
    if not semantic_record_is_open(catalog, expected) and (
      semantic_record_is_open(catalog, actual) or
        not semantic_record_fields_domain_equal_from(
          catalog,
          actual,
          expected,
          __i64_to_usize(0)
        )
    ) { false }
    else {
      semantic_record_subtype_fields_from(
        catalog,
        actual,
        expected,
        __i64_to_usize(0)
      )
    }
  }
}

fn semantic_indexed_positive_atoms_are_disjoint(
  catalog: borrow SemanticTypeCatalog,
  left: SemanticTypeId,
  right: SemanticTypeId
) -[SemanticConformance]> bool {
  match (
    semantic_subtyping_kind(catalog, left),
    semantic_subtyping_kind(catalog, right),
  ) {
    (SemanticArrayKind, SemanticArrayKind) -> {
      let left_length = semantic_subtyping_array_length(catalog, left)
      let right_length = semantic_subtyping_array_length(catalog, right)
      if left_length != right_length { true }
      else {
        left_length > 0 and semantic_type_intersection_is_empty(
          catalog,
          semantic_subtyping_array_element(catalog, left),
          semantic_subtyping_array_element(catalog, right)
        )
      }
    }
    (SemanticSliceKind, SemanticSliceKind) -> false
    (SemanticArrayKind, SemanticSliceKind) -> true
    (SemanticSliceKind, SemanticArrayKind) -> true
    _ -> false
  }
}

fn semantic_indexed_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  match (
    semantic_subtyping_kind(catalog, actual),
    semantic_subtyping_kind(catalog, expected),
  ) {
    (SemanticArrayKind, SemanticArrayKind) -> {
      let actual_length = semantic_subtyping_array_length(catalog, actual)
      let expected_length = semantic_subtyping_array_length(catalog, expected)
      actual_length == expected_length and if actual_length == 0 { true }
      else {
        semantic_type_is_subtype(
          catalog,
          semantic_subtyping_array_element(catalog, actual),
          semantic_subtyping_array_element(catalog, expected)
        )
      }
    }
    (SemanticSliceKind, SemanticSliceKind) -> {
      let actual_mutability = semantic_subtyping_mutability(catalog, actual)
      let expected_mutability = semantic_subtyping_mutability(catalog, expected)
      if not semantic_mutability_equal(actual_mutability, expected_mutability) {
        false
      } else {
        let actual_inner = semantic_subtyping_mutable_inner(catalog, actual)
        let expected_inner = semantic_subtyping_mutable_inner(catalog, expected)
        match actual_mutability {
          SemanticMutable -> semantic_type_is_subtype(
            catalog,
            actual_inner,
            expected_inner
          ) and semantic_type_is_subtype(catalog, expected_inner, actual_inner)
          SemanticImmutable -> semantic_type_is_subtype(
            catalog,
            actual_inner,
            expected_inner
          )
        }
      }
    }
    _ -> false
  }
}

fn semantic_atom_definitely_disjoint_from_record(kind: SemanticTypeKind) -> bool {
  match kind {
    SemanticPrimitiveKind -> true
    SemanticFunctionKind -> true
    SemanticVariantKind -> true
    SemanticEffectSignatureKind -> true
    SemanticEffectAtomKind -> true
    SemanticContinuationKind -> true
    SemanticPointerKind -> true
    SemanticWeakKind -> true
    SemanticAtomicKind -> true
    SemanticUniqueKind -> true
    SemanticOwnedKind -> true
    SemanticArrayKind -> true
    SemanticSliceKind -> true
    _ -> false
  }
}

fn semantic_list_has_never(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticBottomKind -> true
      _ -> semantic_list_has_never(catalog, rest)
    }
  }
}

fn semantic_list_has_disjoint_primitive_from(
  catalog: borrow SemanticTypeCatalog,
  wanted: SemanticPrimitive,
  atoms: List<SemanticTypeId>
) -> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticPrimitiveKind -> not semantic_primitives_overlap(
        wanted,
        semantic_subtyping_primitive(catalog, atom)
      ) or semantic_list_has_disjoint_primitive_from(
        catalog,
        wanted,
        rest
      )
      _ -> semantic_list_has_disjoint_primitive_from(catalog, wanted, rest)
    }
  }
}

fn semantic_list_has_disjoint_primitives(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticPrimitiveKind -> semantic_list_has_disjoint_primitive_from(
        catalog,
        semantic_subtyping_primitive(catalog, atom),
        rest
      ) or semantic_list_has_disjoint_primitives(catalog, rest)
      _ -> semantic_list_has_disjoint_primitives(catalog, rest)
    }
  }
}

fn semantic_list_has_empty_record(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticRecordKind -> semantic_record_has_empty_field_from(
        catalog,
        atom,
        __i64_to_usize(0)
      ) or semantic_list_has_empty_record(catalog, rest)
      _ -> semantic_list_has_empty_record(catalog, rest)
    }
  }
}

fn semantic_list_has_disjoint_record_with(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticRecordKind -> semantic_record_positive_atoms_are_disjoint(
        catalog,
        record,
        atom
      ) or semantic_list_has_disjoint_record_with(catalog, record, rest)
      _ -> semantic_list_has_disjoint_record_with(catalog, record, rest)
    }
  }
}

fn semantic_list_has_disjoint_records(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticRecordKind -> semantic_list_has_disjoint_record_with(
        catalog,
        atom,
        rest
      ) or semantic_list_has_disjoint_records(catalog, rest)
      _ -> semantic_list_has_disjoint_records(catalog, rest)
    }
  }
}

fn semantic_list_has_record_nonrecord_disjoint(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>,
  has_record: bool,
  has_disjoint: bool
) -> bool {
  match atoms {
    Nil -> has_record and has_disjoint
    Cons(atom, rest) -> {
      let kind = semantic_subtyping_kind(catalog, atom)
      semantic_list_has_record_nonrecord_disjoint(
        catalog,
        rest,
        has_record or match kind { SemanticRecordKind -> true, _ -> false },
        has_disjoint or semantic_atom_definitely_disjoint_from_record(kind)
      )
    }
  }
}

fn semantic_list_has_empty_array(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticArrayKind -> {
        let length = semantic_subtyping_array_length(catalog, atom)
        length > 0 and semantic_type_is_empty(
          catalog,
          semantic_subtyping_array_element(catalog, atom)
        ) or semantic_list_has_empty_array(catalog, rest)
      }
      _ -> semantic_list_has_empty_array(catalog, rest)
    }
  }
}

fn semantic_list_has_disjoint_indexed_with(
  catalog: borrow SemanticTypeCatalog,
  indexed: SemanticTypeId,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> semantic_indexed_positive_atoms_are_disjoint(
      catalog,
      indexed,
      atom
    ) or semantic_list_has_disjoint_indexed_with(
      catalog,
      indexed,
      rest
    )
  }
}

fn semantic_list_has_disjoint_indexed(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticArrayKind -> semantic_list_has_disjoint_indexed_with(
        catalog,
        atom,
        rest
      ) or semantic_list_has_disjoint_indexed(catalog, rest)
      SemanticSliceKind -> semantic_list_has_disjoint_indexed_with(
        catalog,
        atom,
        rest
      ) or semantic_list_has_disjoint_indexed(catalog, rest)
      _ -> semantic_list_has_disjoint_indexed(catalog, rest)
    }
  }
}

fn semantic_primitive_is_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  primitive: SemanticPrimitive,
  negative: List<SemanticTypeId>
) -> bool {
  match negative {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticPrimitiveKind -> semantic_primitive_is_subprimitive(
        primitive,
        semantic_subtyping_primitive(catalog, atom)
      ) or semantic_primitive_is_subset_of_negative(catalog, primitive, rest)
      _ -> semantic_primitive_is_subset_of_negative(catalog, primitive, rest)
    }
  }
}

fn semantic_list_has_primitive_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -> bool {
  match positive {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticPrimitiveKind -> semantic_primitive_is_subset_of_negative(
        catalog,
        semantic_subtyping_primitive(catalog, atom),
        negative
      ) or semantic_list_has_primitive_subset_of_negative(
        catalog,
        rest,
        negative
      )
      _ -> semantic_list_has_primitive_subset_of_negative(catalog, rest, negative)
    }
  }
}

fn semantic_record_is_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  record: SemanticTypeId,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match negative {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticRecordKind -> semantic_record_is_subtype(
        catalog,
        record,
        atom
      ) or semantic_record_is_subset_of_negative(catalog, record, rest)
      _ -> semantic_record_is_subset_of_negative(catalog, record, rest)
    }
  }
}

fn semantic_list_has_record_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match positive {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticRecordKind -> semantic_record_is_subset_of_negative(
        catalog,
        atom,
        negative
      ) or semantic_list_has_record_subset_of_negative(catalog, rest, negative)
      _ -> semantic_list_has_record_subset_of_negative(catalog, rest, negative)
    }
  }
}

fn semantic_indexed_is_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  indexed: SemanticTypeId,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match negative {
    Nil -> false
    Cons(atom, rest) -> semantic_indexed_is_subtype(
      catalog,
      indexed,
      atom
    ) or semantic_indexed_is_subset_of_negative(catalog, indexed, rest)
  }
}

fn semantic_list_has_indexed_subset_of_negative(
  catalog: borrow SemanticTypeCatalog,
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match positive {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticArrayKind -> semantic_indexed_is_subset_of_negative(
        catalog,
        atom,
        negative
      ) or semantic_list_has_indexed_subset_of_negative(catalog, rest, negative)
      SemanticSliceKind -> semantic_indexed_is_subset_of_negative(
        catalog,
        atom,
        negative
      ) or semantic_list_has_indexed_subset_of_negative(catalog, rest, negative)
      _ -> semantic_list_has_indexed_subset_of_negative(catalog, rest, negative)
    }
  }
}

fn semantic_atom_is_concrete(
  catalog: borrow SemanticTypeCatalog,
  atom: SemanticTypeId
) -> bool {
  match semantic_subtyping_kind(catalog, atom) {
    SemanticPrimitiveKind -> true
    SemanticNamedKind -> true
    _ -> false
  }
}

fn semantic_concrete_has_unsatisfied_positive_trait(
  catalog: borrow SemanticTypeCatalog,
  concrete: SemanticTypeId,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticTraitKind -> not SemanticConformance.conforms(
        catalog,
        concrete,
        atom
      ) or semantic_concrete_has_unsatisfied_positive_trait(
        catalog,
        concrete,
        rest
      )
      _ -> semantic_concrete_has_unsatisfied_positive_trait(catalog, concrete, rest)
    }
  }
}

fn semantic_list_has_unsatisfied_positive_trait(
  catalog: borrow SemanticTypeCatalog,
  candidates: List<SemanticTypeId>,
  all_positive: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match candidates {
    Nil -> false
    Cons(atom, rest) -> if semantic_atom_is_concrete(catalog, atom) {
      semantic_concrete_has_unsatisfied_positive_trait(
        catalog,
        atom,
        all_positive
      )
    } else {
      semantic_list_has_unsatisfied_positive_trait(catalog, rest, all_positive)
    }
  }
}

fn semantic_concrete_has_satisfied_negative_trait(
  catalog: borrow SemanticTypeCatalog,
  concrete: SemanticTypeId,
  atoms: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> match semantic_subtyping_kind(catalog, atom) {
      SemanticTraitKind -> SemanticConformance.conforms(
        catalog,
        concrete,
        atom
      ) or semantic_concrete_has_satisfied_negative_trait(
        catalog,
        concrete,
        rest
      )
      _ -> semantic_concrete_has_satisfied_negative_trait(catalog, concrete, rest)
    }
  }
}

fn semantic_list_has_satisfied_negative_trait(
  catalog: borrow SemanticTypeCatalog,
  candidates: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  match candidates {
    Nil -> false
    Cons(atom, rest) -> if semantic_atom_is_concrete(catalog, atom) {
      semantic_concrete_has_satisfied_negative_trait(catalog, atom, negative)
    } else {
      semantic_list_has_satisfied_negative_trait(catalog, rest, negative)
    }
  }
}

fn semantic_list_has_overlap(
  catalog: borrow SemanticTypeCatalog,
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -> bool {
  match positive {
    Nil -> false
    Cons(atom, rest) -> semantic_list_contains_equal(
      catalog,
      negative,
      atom
    ) or semantic_list_has_overlap(catalog, rest, negative)
  }
}

fn semantic_list_contains_equal(
  catalog: borrow SemanticTypeCatalog,
  atoms: List<SemanticTypeId>,
  wanted: SemanticTypeId
) -> bool {
  match atoms {
    Nil -> false
    Cons(atom, rest) -> semantic_type_catalog_equal(
      catalog,
      atom,
      wanted
    ) or semantic_list_contains_equal(catalog, rest, wanted)
  }
}

fn semantic_clause_is_unsatisfiable(
  catalog: borrow SemanticTypeCatalog,
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -[SemanticConformance]> bool {
  semantic_list_has_never(catalog, positive) or
    semantic_list_has_disjoint_primitives(catalog, positive) or
    semantic_list_has_empty_record(catalog, positive) or
    semantic_list_has_disjoint_records(catalog, positive) or
    semantic_list_has_record_nonrecord_disjoint(
      catalog,
      positive,
      false,
      false
    ) or semantic_list_has_empty_array(catalog, positive) or
    semantic_list_has_disjoint_indexed(catalog, positive) or
    semantic_list_has_primitive_subset_of_negative(catalog, positive, negative) or
    semantic_list_has_record_subset_of_negative(catalog, positive, negative) or
    semantic_list_has_indexed_subset_of_negative(catalog, positive, negative) or
    semantic_list_has_unsatisfied_positive_trait(catalog, positive, positive) or
    semantic_list_has_satisfied_negative_trait(catalog, positive, negative) or
    semantic_list_has_overlap(catalog, positive, negative)
}

fn semantic_dnf_all_clauses_unsatisfiable(
  catalog: borrow SemanticTypeCatalog,
  positive_clauses: List<List<SemanticTypeId>>,
  negative_clauses: List<List<SemanticTypeId>>
) -[SemanticConformance]> bool {
  match (positive_clauses, negative_clauses) {
    (Nil, Nil) -> true
    (
      Cons(positive, remaining_positives),
      Cons(negative, remaining_negatives),
    ) -> semantic_clause_is_unsatisfiable(
      catalog,
      positive,
      negative
    ) and semantic_dnf_all_clauses_unsatisfiable(
      catalog,
      remaining_positives,
      remaining_negatives
    )
    _ -> panic("Semantic DNF clause columns diverged during emptiness checking")
  }
}

pub(package) fn semantic_dnf_is_empty(
  catalog: borrow SemanticTypeCatalog,
  dnf: SemanticDnf
) -[SemanticConformance]> bool {
  semantic_dnf_all_clauses_unsatisfiable(
    catalog,
    semantic_dnf_positive_clauses(dnf),
    semantic_dnf_negative_clauses(dnf)
  )
}

pub(package) fn semantic_type_is_empty(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -[SemanticConformance]> bool {
  match semantic_subtyping_kind(catalog, id) {
    SemanticBottomKind -> true
    _ -> semantic_dnf_is_empty(catalog, semantic_type_to_dnf(catalog, id))
  }
}

fn semantic_effect_list_contains(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  wanted: SemanticTypeId,
  offset: usize
) -> bool {
  let lists = semantic_type_graph_type_lists_local(graph)
  if offset >= semantic_type_list_len(lists, list) { false }
  else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_list_type_id(
        graph,
        semantic_type_list_edge(lists, list, offset)
      ),
      wanted
    ) or semantic_effect_list_contains(
      catalog,
      graph,
      list,
      wanted,
      offset + 1
    )
  }
}

fn semantic_effect_list_is_subset_from(
  catalog: borrow SemanticTypeCatalog,
  actual_graph: borrow SemanticTypeGraph,
  actual_list: SemanticTypeListId,
  expected_graph: borrow SemanticTypeGraph,
  expected_list: SemanticTypeListId,
  offset: usize
) -> bool {
  let actual_lists = semantic_type_graph_type_lists_local(actual_graph)
  if offset >= semantic_type_list_len(actual_lists, actual_list) { true }
  else {
    semantic_effect_list_contains(
      catalog,
      expected_graph,
      expected_list,
      semantic_type_graph_list_type_id(
        actual_graph,
        semantic_type_list_edge(actual_lists, actual_list, offset)
      ),
      __i64_to_usize(0)
    ) and semantic_effect_list_is_subset_from(
      catalog,
      actual_graph,
      actual_list,
      expected_graph,
      expected_list,
      offset + 1
    )
  }
}

fn semantic_effect_is_subset(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -> bool {
  if not match semantic_subtyping_kind(catalog, actual) {
    SemanticEffectSignatureKind -> true
    _ -> false
  } or not match semantic_subtyping_kind(catalog, expected) {
    SemanticEffectSignatureKind -> true
    _ -> false
  } { true }
  else {
    let actual_graph = semantic_subtyping_required_graph(catalog, actual)
    let expected_graph = semantic_subtyping_required_graph(catalog, expected)
    let actual_local = semantic_type_graph_local(actual_graph)
    let expected_local = semantic_type_graph_local(expected_graph)
    let actual_effects = semantic_type_graph_effects_local(actual_graph)
    let expected_effects = semantic_type_graph_effects_local(expected_graph)
    let actual_edge = semantic_type_local_graph_effect_signature(
      actual_local,
      semantic_type_graph_local_id(actual_graph, actual)
    )
    let expected_edge = semantic_type_local_graph_effect_signature(
      expected_local,
      semantic_type_graph_local_id(expected_graph, expected)
    )
    if semantic_type_effect_signature_is_open(expected_effects, expected_edge) { true }
    else {
      not semantic_type_effect_signature_is_open(actual_effects, actual_edge) and
        semantic_effect_list_is_subset_from(
          catalog,
          actual_graph,
          semantic_type_effect_signature_effects(actual_effects, actual_edge),
          expected_graph,
          semantic_type_effect_signature_effects(expected_effects, expected_edge),
          __i64_to_usize(0)
        )
    }
  }
}

fn semantic_function_parameters_are_subtypes_from(
  catalog: borrow SemanticTypeCatalog,
  actual_graph: borrow SemanticTypeGraph,
  actual_parameters: SemanticTypeListId,
  expected_graph: borrow SemanticTypeGraph,
  expected_parameters: SemanticTypeListId,
  offset: usize
) -[SemanticConformance]> bool {
  let actual_lists = semantic_type_graph_type_lists_local(actual_graph)
  let expected_lists = semantic_type_graph_type_lists_local(expected_graph)
  let actual_count = semantic_type_list_len(actual_lists, actual_parameters)
  let expected_count = semantic_type_list_len(expected_lists, expected_parameters)
  if actual_count != expected_count { false }
  else {
    if offset >= actual_count { true }
    else {
      semantic_type_is_subtype(
        catalog,
        semantic_type_graph_list_type_id(
          expected_graph,
          semantic_type_list_edge(expected_lists, expected_parameters, offset)
        ),
        semantic_type_graph_list_type_id(
          actual_graph,
          semantic_type_list_edge(actual_lists, actual_parameters, offset)
        )
      ) and semantic_function_parameters_are_subtypes_from(
        catalog,
        actual_graph,
        actual_parameters,
        expected_graph,
        expected_parameters,
        offset + 1
      )
    }
  }
}

fn semantic_function_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  let actual_graph = semantic_subtyping_required_graph(catalog, actual)
  let expected_graph = semantic_subtyping_required_graph(catalog, expected)
  let actual_local = semantic_type_graph_local(actual_graph)
  let expected_local = semantic_type_graph_local(expected_graph)
  let actual_functions = semantic_type_graph_functions_local(actual_graph)
  let expected_functions = semantic_type_graph_functions_local(expected_graph)
  let actual_edge = semantic_type_local_graph_function(
    actual_local,
    semantic_type_graph_local_id(actual_graph, actual)
  )
  let expected_edge = semantic_type_local_graph_function(
    expected_local,
    semantic_type_graph_local_id(expected_graph, expected)
  )
  semantic_function_parameters_are_subtypes_from(
    catalog,
    actual_graph,
    semantic_type_function_parameters(actual_functions, actual_edge),
    expected_graph,
    semantic_type_function_parameters(expected_functions, expected_edge),
    __i64_to_usize(0)
  ) and semantic_type_is_subtype(
    catalog,
    semantic_type_graph_function_result_type_id(actual_graph, actual_edge),
    semantic_type_graph_function_result_type_id(expected_graph, expected_edge)
  ) and semantic_effect_is_subset(
    catalog,
    semantic_type_graph_function_effects_type_id(actual_graph, actual_edge),
    semantic_type_graph_function_effects_type_id(expected_graph, expected_edge)
  )
}

fn semantic_binary_children(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> (SemanticTypeId, SemanticTypeId) {
  let graph = semantic_subtyping_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  let edges = semantic_type_local_graph_binary(
    local,
    semantic_type_graph_local_id(graph, id)
  )
  (
    semantic_type_graph_binary_left_type_id(graph, edges),
    semantic_type_graph_binary_right_type_id(graph, edges)
  )
}

fn semantic_continuation_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  match (
    semantic_binary_children(catalog, actual),
    semantic_binary_children(catalog, expected),
  ) {
    ((actual_input, actual_result), (expected_input, expected_result)) ->
      semantic_type_is_subtype(catalog, expected_input, actual_input) and
      semantic_type_is_subtype(catalog, actual_result, expected_result)
  }
}

fn semantic_pointer_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  let actual_inner = semantic_subtyping_mutable_inner(catalog, actual)
  let expected_inner = semantic_subtyping_mutable_inner(catalog, expected)
  match semantic_subtyping_mutability(catalog, expected) {
    SemanticMutable -> match semantic_subtyping_mutability(catalog, actual) {
      SemanticMutable -> semantic_type_catalog_equal(
        catalog,
        actual_inner,
        expected_inner
      )
      SemanticImmutable -> false
    }
    SemanticImmutable -> semantic_type_is_subtype(
      catalog,
      actual_inner,
      expected_inner
    )
  }
}

fn semantic_borrow_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -> bool {
  semantic_mutability_equal(
    semantic_subtyping_mutability(catalog, actual),
    semantic_subtyping_mutability(catalog, expected)
  ) and semantic_type_catalog_equal(
    catalog,
    semantic_subtyping_mutable_inner(catalog, actual),
    semantic_subtyping_mutable_inner(catalog, expected)
  )
}

fn semantic_general_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  semantic_dnf_is_empty(
    catalog,
    semantic_dnf_intersection(
      semantic_type_to_dnf(catalog, actual),
      semantic_dnf_complement(semantic_type_to_dnf(catalog, expected))
    )
  )
}

pub(package) fn semantic_type_is_subtype(
  catalog: borrow SemanticTypeCatalog,
  actual: SemanticTypeId,
  expected: SemanticTypeId
) -[SemanticConformance]> bool {
  if semantic_type_catalog_equal(catalog, actual, expected) { true }
  else {
    let actual_kind = semantic_subtyping_kind(catalog, actual)
    let expected_kind = semantic_subtyping_kind(catalog, expected)
    match actual_kind {
      SemanticBottomKind -> true
      _ -> match expected_kind {
        SemanticTopKind -> true
        _ -> match actual_kind {
          SemanticFunctionKind -> match expected_kind {
            SemanticFunctionKind -> semantic_function_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticRecordKind -> match expected_kind {
            SemanticRecordKind -> semantic_record_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticContinuationKind -> match expected_kind {
            SemanticContinuationKind -> semantic_continuation_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticPointerKind -> match expected_kind {
            SemanticPointerKind -> semantic_pointer_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticWeakKind -> match expected_kind {
            SemanticWeakKind -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              semantic_subtyping_unary_inner(catalog, expected)
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticAtomicKind -> match expected_kind {
            SemanticAtomicKind -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              semantic_subtyping_unary_inner(catalog, expected)
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticUniqueKind -> match expected_kind {
            SemanticUniqueKind -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              semantic_subtyping_unary_inner(catalog, expected)
            )
            _ -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              expected
            )
          }
          SemanticOwnedKind -> match expected_kind {
            SemanticOwnedKind -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              semantic_subtyping_unary_inner(catalog, expected)
            )
            _ -> semantic_type_is_subtype(
              catalog,
              semantic_subtyping_unary_inner(catalog, actual),
              expected
            )
          }
          SemanticBorrowKind -> match expected_kind {
            SemanticBorrowKind -> semantic_borrow_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> false
          }
          SemanticArrayKind -> match expected_kind {
            SemanticArrayKind -> semantic_indexed_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticSliceKind -> match expected_kind {
            SemanticSliceKind -> semantic_indexed_is_subtype(
              catalog,
              actual,
              expected
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          SemanticPrimitiveKind -> match expected_kind {
            SemanticPrimitiveKind -> semantic_primitive_equal(
              semantic_subtyping_primitive(catalog, actual),
              semantic_subtyping_primitive(catalog, expected)
            ) or semantic_primitive_is_subprimitive(
              semantic_subtyping_primitive(catalog, actual),
              semantic_subtyping_primitive(catalog, expected)
            )
            _ -> semantic_general_is_subtype(catalog, actual, expected)
          }
          _ -> semantic_general_is_subtype(catalog, actual, expected)
        }
      }
    }
  }
}
