-- Deterministic semantic hashes over catalogued type graphs.
--
-- Hashes accelerate semantic equality; they never establish it. Local edges
-- stay on scalar ids and only imported edges resolve through the catalog.
-- Catalogs passed to the context-level API must contain the complete imported
-- closure of the checked program.

use compiler/types/graph.{*}
use compiler/types/graph/catalog.{*}
use stdlib/hash.{Hash}
use stdlib/num/scalar.{num_scalar_usize_to_i64}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

type SemanticTypeHashContext = SemanticTypeCatalogContext

fn semantic_hash_mix(seed: i64, value: i64) -> i64 {
  seed * 1099511628211 + value
}

fn semantic_hash_usize(value: usize) -> i64 {
  match num_scalar_usize_to_i64(value) {
    Some(converted) -> converted
    None -> panic("Semantic type hash input is too large")
  }
}

fn semantic_primitive_hash(primitive: SemanticPrimitive) -> i64 {
  match primitive {
    SemanticI64 -> 201
    SemanticStr -> 202
    SemanticBool -> 203
    SemanticNil -> 204
    SemanticF64 -> 205
    SemanticI32 -> 206
    SemanticI8 -> 207
    SemanticI16 -> 208
    SemanticU8 -> 209
    SemanticU16 -> 210
    SemanticU32 -> 211
    SemanticU64 -> 212
    SemanticIsize -> 213
    SemanticUsize -> 214
    SemanticF32 -> 215
  }
}

fn semantic_mutability_hash(mutability: SemanticMutability) -> i64 {
  match mutability {
    SemanticImmutable -> 0
    SemanticMutable -> 1
  }
}

fn semantic_named_role_hash(role: SemanticNamedRole) -> i64 {
  match role {
    SemanticOpaqueType -> 1
    SemanticNominalType -> 2
    SemanticPayloadlessVariantType -> 3
  }
}

fn semantic_record_shape_hash(shape: SemanticRecordShape) -> i64 {
  match shape {
    SemanticStructuralRecord -> 0
    SemanticTupleRecord -> 1
  }
}

fn semantic_record_openness_hash(openness: SemanticRecordOpenness) -> i64 {
  match openness {
    SemanticClosedRecord -> 0
    SemanticOpenRecord -> 1
  }
}

fn semantic_type_catalog_required_hash(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> i64 {
  match catalog.segment(semantic_type_id_segment(id)) {
    Some(SemanticTypeCatalogSegmentValue(context)) -> {
      let { graph } = context
      if semantic_type_graph_contains(graph, id) {
        semantic_local_type_hash(
          catalog,
          context,
          semantic_type_graph_local_id(graph, id)
        )
      } else { panic("Imported semantic type id is outside its segment") }
    }
    None -> panic("Semantic type catalog is missing an imported segment")
  }
}

fn semantic_type_list_edge_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  edge: SemanticTypeListEdge
) -> i64 {
  let { graph, lists } = context
  if semantic_type_list_edge_is_imported(lists, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_list_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_list_edge_local_id(lists, edge)
    )
  }
}

fn semantic_ordered_type_list_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  list: SemanticTypeListId
) -> i64 {
  let { lists } = context
  let length = semantic_type_list_len(lists, list)
  let mut hash = semantic_hash_mix(1469598103934665603, semantic_hash_usize(length))
  let mut offset: usize = 0
  while offset < length {
    hash = semantic_hash_mix(
      hash,
      semantic_type_list_edge_hash(
        catalog,
        context,
        semantic_type_list_edge(lists, list, offset)
      )
    )
    offset = offset + 1
  }
  hash
}

fn semantic_unordered_type_set_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  list: SemanticTypeListId
) -> i64 {
  let { lists } = context
  let length = semantic_type_list_len(lists, list)
  let mut aggregate = 0
  let mut offset: usize = 0
  while offset < length {
    let element = semantic_type_list_edge_hash(
      catalog,
      context,
      semantic_type_list_edge(lists, list, offset)
    )
    -- Bitwise union is commutative and idempotent. The latter is required by
    -- set equality even though well-formed effect sets contain no duplicates.
    aggregate = aggregate bor semantic_hash_mix(1601, element).hash()
    offset = offset + 1
  }
  aggregate
}

fn semantic_unary_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local } = context
  let edge = semantic_type_local_graph_unary(local, id)
  if semantic_type_local_graph_unary_is_imported(local, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_unary_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_local_graph_unary_id(local, edge)
    )
  }
}

fn semantic_binary_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId,
  seed: i64
) -> i64 {
  let { graph, local } = context
  let edges = semantic_type_local_graph_binary(local, id)
  let left = if semantic_type_local_graph_binary_left_is_imported(local, edges) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_binary_left_type_id(graph, edges)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_local_graph_binary_left_id(local, edges)
    )
  }
  let right = if semantic_type_local_graph_binary_right_is_imported(local, edges) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_binary_right_type_id(graph, edges)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_local_graph_binary_right_id(local, edges)
    )
  }
  semantic_hash_mix(semantic_hash_mix(seed, left), right)
}

fn semantic_mutable_unary_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId,
  seed: i64
) -> i64 {
  let { graph, local } = context
  let edge = semantic_type_local_graph_mutable_unary(local, id)
  let inner = if semantic_type_local_graph_mutable_unary_is_imported(local, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_mutable_unary_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_local_graph_mutable_unary_id(local, edge)
    )
  }
  semantic_hash_mix(
    semantic_hash_mix(seed, inner),
    semantic_mutability_hash(semantic_type_local_graph_mutability(local, edge))
  )
}

fn semantic_array_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local } = context
  let edge = semantic_type_local_graph_array(local, id)
  let length = semantic_type_local_graph_array_length(local, edge)
  if length == __i64_to_usize(0) { 2201 }
  else {
    let inner = if semantic_type_local_graph_array_is_imported(local, edge) {
      semantic_type_catalog_required_hash(
        catalog,
        semantic_type_graph_array_type_id(graph, edge)
      )
    } else {
      semantic_local_type_hash(
        catalog,
        context,
        semantic_type_local_graph_array_id(local, edge)
      )
    }
    semantic_hash_mix(semantic_hash_mix(2201, inner), semantic_hash_usize(length))
  }
}

fn semantic_function_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local, functions } = context
  let edge = semantic_type_local_graph_function(local, id)
  let parameters = semantic_ordered_type_list_hash(
    catalog,
    context,
    semantic_type_function_parameters(functions, edge)
  )
  let result = if semantic_type_function_result_is_imported(functions, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_function_result_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_function_result_local_id(functions, edge)
    )
  }
  let effects = if semantic_type_function_effects_are_imported(functions, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_function_effects_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_function_effects_local_id(functions, edge)
    )
  }
  semantic_hash_mix(
    semantic_hash_mix(semantic_hash_mix(601, parameters), result),
    effects
  )
}

fn semantic_effect_atom_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local, effects } = context
  let edge = semantic_type_local_graph_effect_atom(local, id)
  semantic_hash_mix(
    semantic_hash_mix(
      1101,
      semantic_type_effect_atom_declaration_hash(effects, edge)
    ),
    semantic_ordered_type_list_hash(
      catalog,
      context,
      semantic_type_effect_atom_arguments(effects, edge)
    )
  )
}

fn semantic_effect_signature_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local, effects } = context
  let edge = semantic_type_local_graph_effect_signature(local, id)
  let tail = if semantic_type_effect_signature_is_open(effects, edge) {
    semantic_hash_mix(
      1,
      semantic_hash_usize(semantic_type_effect_signature_tail(effects, edge))
    )
  } else { 0 }
  semantic_hash_mix(
    semantic_hash_mix(
      1001,
      semantic_unordered_type_set_hash(
        catalog,
        context,
        semantic_type_effect_signature_effects(effects, edge)
      )
    ),
    tail
  )
}

fn semantic_named_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local, named } = context
  let edge = semantic_type_local_graph_named(local, id)
  let role = semantic_type_named_role(named, edge)
  let identity = semantic_hash_mix(
    semantic_hash_mix(
      901,
      semantic_type_named_declaration_hash(named, edge)
    ),
    semantic_named_role_hash(role)
  )
  let arguments = semantic_ordered_type_list_hash(
    catalog,
    context,
    semantic_type_named_arguments(named, edge)
  )
  match role {
    SemanticOpaqueType -> semantic_hash_mix(identity, arguments)
    _ -> {
      let representation = if semantic_type_named_representation_is_imported(
        named,
        edge
      ) {
        semantic_type_catalog_required_hash(
          catalog,
          semantic_type_graph_named_representation_type_id(graph, edge)
        )
      } else {
        semantic_local_type_hash(
          catalog,
          context,
          semantic_type_named_representation_local_id(named, edge)
        )
      }
      semantic_hash_mix(semantic_hash_mix(identity, representation), arguments)
    }
  }
}

fn semantic_record_field_type_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  edge: SemanticRecordFieldEdge
) -> i64 {
  let { graph, records } = context
  if semantic_type_record_field_is_imported(records, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_record_field_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_record_field_local_id(records, edge)
    )
  }
}

fn semantic_record_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local, records } = context
  let edge = semantic_type_local_graph_record(local, id)
  let fields = semantic_type_record_fields(records, edge)
  let length = semantic_type_record_field_count(records, fields)
  let mut sum = 0
  let mut xor = 0
  let mut offset: usize = 0
  while offset < length {
    let field = semantic_type_record_field_edge(records, fields, offset)
    let element = semantic_hash_mix(
      semantic_type_record_field_hash(records, field),
      semantic_record_field_type_hash(catalog, context, field)
    ).hash()
    sum = sum + element
    xor = xor bxor element
    offset = offset + 1
  }
  semantic_hash_mix(
    semantic_hash_mix(
      semantic_hash_mix(
        semantic_hash_mix(
          semantic_hash_mix(
            701,
            semantic_record_shape_hash(
              semantic_type_record_shape(records, edge)
            )
          ),
          semantic_record_openness_hash(
            semantic_type_record_openness(records, edge)
          )
        ),
        semantic_hash_usize(length)
      ),
      sum
    ),
    xor
  )
}

fn semantic_variant_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local, variants } = context
  let edge = semantic_type_local_graph_variant(local, id)
  let payload = if semantic_type_variant_payload_is_imported(variants, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_variant_payload_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_variant_payload_local_id(variants, edge)
    )
  }
  semantic_hash_mix(
    semantic_hash_mix(
      801,
      semantic_type_variant_declaration_hash(variants, edge)
    ),
    payload
  )
}

fn semantic_variable_hash(
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local, variables } = context
  let edge = semantic_type_local_graph_variable(local, id)
  if semantic_type_variable_is_self(variables, edge) { 1200 }
  else {
    semantic_hash_mix(
      1201,
      semantic_hash_usize(semantic_type_variable_parameter(variables, edge))
    )
  }
}

fn semantic_trait_binding_type_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  edge: SemanticTraitBindingEdge
) -> i64 {
  let { graph, traits } = context
  if semantic_type_trait_binding_type_is_imported(traits, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_trait_binding_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_trait_binding_type_local_id(traits, edge)
    )
  }
}

fn semantic_trait_bindings_hash_from(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  bindings: SemanticTraitBindingListId,
  offset: usize,
  aggregate: i64
) -> i64 {
  let { traits } = context
  if offset >= semantic_type_trait_binding_count(traits, bindings) { aggregate }
  else {
    let edge = semantic_type_trait_binding_edge(traits, bindings, offset)
    let pair = semantic_hash_mix(
      semantic_type_trait_binding_declaration_hash(traits, edge),
      semantic_trait_binding_type_hash(catalog, context, edge)
    )
    semantic_trait_bindings_hash_from(
      catalog,
      context,
      bindings,
      offset + 1,
      aggregate bor pair.hash()
    )
  }
}

fn semantic_trait_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local, traits } = context
  let edge = semantic_type_local_graph_trait(local, id)
  semantic_hash_mix(
    semantic_hash_mix(1301, semantic_type_trait_declaration_hash(traits, edge)),
    semantic_trait_bindings_hash_from(
      catalog,
      context,
      semantic_type_trait_bindings(edge),
      __i64_to_usize(0),
      0
    )
  )
}

fn semantic_associated_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { graph, local, associated } = context
  let edge = semantic_type_local_graph_associated(local, id)
  let base = if semantic_type_associated_base_is_imported(associated, edge) {
    semantic_type_catalog_required_hash(
      catalog,
      semantic_type_graph_associated_base_type_id(graph, edge)
    )
  } else {
    semantic_local_type_hash(
      catalog,
      context,
      semantic_type_associated_base_local_id(associated, edge)
    )
  }
  semantic_hash_mix(
    semantic_hash_mix(2101, base),
    semantic_type_associated_declaration_hash(associated, edge)
  )
}

fn semantic_local_type_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeHashContext,
  id: SemanticLocalTypeId
) -> i64 {
  let { local } = context
  match semantic_type_graph_kind_local(local, id) {
    SemanticBottomKind -> 0
    SemanticTopKind -> 101
    SemanticPrimitiveKind -> semantic_primitive_hash(
      semantic_type_local_graph_primitive(local, id)
    )
    SemanticUnionKind -> semantic_binary_hash(catalog, context, id, 301)
    SemanticIntersectionKind -> semantic_binary_hash(catalog, context, id, 401)
    SemanticComplementKind -> semantic_hash_mix(
      501,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticContinuationKind -> semantic_binary_hash(catalog, context, id, 1401)
    SemanticWeakKind -> semantic_hash_mix(
      1601,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticRcKind -> semantic_hash_mix(
      9101,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticAtomicKind -> semantic_hash_mix(
      1701,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticUniqueKind -> semantic_hash_mix(
      1801,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticOwnedKind -> semantic_hash_mix(
      1901,
      semantic_unary_hash(catalog, context, id)
    )
    SemanticPointerKind -> semantic_mutable_unary_hash(catalog, context, id, 1501)
    SemanticBorrowKind -> semantic_mutable_unary_hash(catalog, context, id, 2901)
    SemanticSliceKind -> semantic_mutable_unary_hash(catalog, context, id, 2301)
    SemanticArrayKind -> semantic_array_hash(catalog, context, id)
    SemanticFunctionKind -> semantic_function_hash(catalog, context, id)
    SemanticEffectAtomKind -> semantic_effect_atom_hash(catalog, context, id)
    SemanticEffectSignatureKind -> semantic_effect_signature_hash(
      catalog,
      context,
      id
    )
    SemanticNamedKind -> semantic_named_hash(catalog, context, id)
    SemanticRecordKind -> semantic_record_hash(catalog, context, id)
    SemanticVariantKind -> semantic_variant_hash(catalog, context, id)
    SemanticVariableKind -> semantic_variable_hash(context, id)
    SemanticTraitKind -> semantic_trait_hash(catalog, context, id)
    SemanticAssociatedKind -> semantic_associated_hash(catalog, context, id)
  }
}

pub(package) fn semantic_type_catalog_context_hash(
  catalog: borrow SemanticTypeCatalog,
  context: borrow SemanticTypeCatalogContext,
  id: SemanticLocalTypeId
) -> i64 {
  semantic_local_type_hash(catalog, context, id)
}

pub(package) fn semantic_type_catalog_hash(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<i64> {
  match catalog.segment(semantic_type_id_segment(id)) {
    Some(SemanticTypeCatalogSegmentValue(context)) -> {
      let { graph } = context
      if semantic_type_graph_contains(graph, id) {
        Some<i64>(
          semantic_local_type_hash(
            catalog,
            context,
            semantic_type_graph_local_id(graph, id)
          )
        )
      } else { None<i64>() }
    }
    None -> None<i64>()
  }
}

pub(package) fn semantic_type_graph_hash_within_segment(
  graph: SemanticTypeGraph,
  id: SemanticTypeId
) -> Option<i64> {
  if not semantic_type_graph_contains(graph, id) { None<i64>() }
  else {
    let catalog = semantic_type_catalog_single(graph)
    semantic_type_catalog_hash(catalog, id)
  }
}
