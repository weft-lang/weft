-- Trait-conformance oracle used by graph-native semantic subtyping.
--
-- Each query borrows the catalog that owns its type ids. Body checking may
-- derive new segments after a handler is installed, so a handler-wide catalog
-- snapshot cannot safely interpret every later concrete type. The eventual
-- production handler uses immutable checked-program conformance facts;
-- associated-type equalities remain part of the trait atom and no hash or
-- raw checker-table address crosses this boundary.

use compiler/types/graph.{SemanticTypeId}
use compiler/types/graph/catalog.{SemanticTypeCatalog}

pub(package) effect SemanticConformance {
  fn conforms(
    types: borrow SemanticTypeCatalog,
    concrete: SemanticTypeId,
    trait_atom: SemanticTypeId
  ) -> bool
}
