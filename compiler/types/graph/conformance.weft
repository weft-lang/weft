-- Trait-conformance oracle used by graph-native semantic subtyping.
--
-- The query carries complete semantic and declaration identities. The eventual
-- production handler is backed by the checked program's immutable conformance
-- facts; no hash or raw checker-table address crosses this boundary.

use compiler/project/identity.{DeclarationIdentity}
use compiler/types/graph.{SemanticTypeId}

pub(package) effect SemanticConformance {
  fn conforms(
    concrete: SemanticTypeId,
    trait_declaration: DeclarationIdentity
  ) -> bool
}
