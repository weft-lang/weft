-- Exact effect purity of a semantic function type. The graph catalog, not
-- authored effect syntax or a checker-table tag, owns this fact.

use compiler/types/graph.{
  SemanticClosedEffects,
  SemanticEffectSignatureNode,
  SemanticFunctionNode,
  SemanticTypeId,
  semantic_type_graph_node,
  semantic_type_graph_type_lists_local,
  semantic_type_list_len
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}

pub(package) type SemanticFunctionPurity {
  SemanticPureFunction,
  SemanticEffectfulFunction(SemanticTypeId),
  SemanticFunctionShapeUnavailable
}

pub(package) fn semantic_function_purity(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> SemanticFunctionPurity {
  match catalog.graph_for(function_type) {
    None -> SemanticFunctionShapeUnavailable
    Some(function_graph) -> match semantic_type_graph_node(function_graph, function_type) {
      SemanticFunctionNode(_, _, effects) -> match catalog.graph_for(effects) {
        None -> SemanticFunctionShapeUnavailable
        Some(effect_graph) -> match semantic_type_graph_node(effect_graph, effects) {
          SemanticEffectSignatureNode(atoms, SemanticClosedEffects) -> {
            let lists = semantic_type_graph_type_lists_local(effect_graph)
            if semantic_type_list_len(lists, atoms) == 0 { SemanticPureFunction }
            else { SemanticEffectfulFunction(effects) }
          }
          SemanticEffectSignatureNode(_, _) -> SemanticEffectfulFunction(effects)
          _ -> SemanticFunctionShapeUnavailable
        }
      }
      _ -> SemanticFunctionShapeUnavailable
    }
  }
}

pub(package) fn semantic_function_is_pure(
  catalog: borrow SemanticTypeCatalog,
  function_type: SemanticTypeId
) -> bool {
  match semantic_function_purity(catalog, function_type) {
    SemanticPureFunction -> true
    _ -> false
  }
}
