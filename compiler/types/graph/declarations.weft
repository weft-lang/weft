-- Resolved type-declaration shapes over immutable semantic graphs.
--
-- A named semantic type retains declaration identity and arguments. Record
-- fields and variant cases belong to the declaration product, not to every
-- named type node. This catalog joins the two without exposing syntax or a
-- checker table; target placement and later checked passes consume the same
-- resolved shapes.
--
-- Every stored column is flat. A match returns only a scalar layout index and
-- its generic substitution; typed accessors expose one field or payload at a
-- time. The product therefore never nests aggregate declaration records or
-- lists inside another List.

use compiler/project/identity.{
  DeclarationIdentity,
  declaration_identity_name,
  declaration_identity_owner
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/project/identity/hash.{retained_declaration_identity_hash}
use compiler/types/graph.{
  SemanticNamedNode,
  SemanticTypeId,
  SemanticTypeVariable,
  SemanticVariableNode,
  semantic_type_graph_node,
  semantic_type_graph_type_lists_local,
  semantic_type_list_len
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match_substituted
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty,
  semantic_type_substitution_get
}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_checked_add}
use stdlib/option.{None, Option, Some}

pub(package) type SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<SemanticTypeId>,
    List<SemanticTypeVariable>,
    List<SemanticTypeId>
  ),
  SemanticVariantDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<usize>,
    List<SemanticTypeId>,
    List<SemanticTypeVariable>,
    List<SemanticTypeId>
  )
}

-- One declaration's layout, of either kind: the index a declared bound is
-- read through.
pub(package) type SemanticDeclaredLayout {
  SemanticDeclaredRecordLayout(usize),
  SemanticDeclaredVariantLayout(usize)
}

-- Each layout's declared bounds: a count per layout beside the flat
-- variables and bound types they own.
type SemanticDeclaredBoundColumns {
  counts: List<usize>,
  variables: List<SemanticTypeVariable>,
  types: List<SemanticTypeId>
}

fn semantic_declared_bounds_empty() -> SemanticDeclaredBoundColumns {
  SemanticDeclaredBoundColumns {
    counts: Nil<usize>(),
    variables: Nil<SemanticTypeVariable>(),
    types: Nil<SemanticTypeId>()
  }
}

fn semantic_declared_bounds_prepend(
  columns: SemanticDeclaredBoundColumns,
  variables: List<SemanticTypeVariable>,
  types: List<SemanticTypeId>
) -> SemanticDeclaredBoundColumns {
  SemanticDeclaredBoundColumns {
    counts: columns.counts.prepend(variables.len()),
    variables: semantic_variables_prepend(variables, columns.variables),
    types: semantic_types_prepend(types, columns.types)
  }
}

type SemanticTypeDeclarationCatalogStorage {
  record_targets: List<SemanticTypeId>,
  -- Each target's declaration key, beside it: a lookup pattern-matches only
  -- the targets that apply the concrete type's own declaration.
  record_keys: List<Option<i64>>,
  record_field_counts: List<usize>,
  record_declarations: List<DeclarationIdentity>,
  record_types: List<SemanticTypeId>,
  record_bounds: SemanticDeclaredBoundColumns,
  variant_targets: List<SemanticTypeId>,
  variant_keys: List<Option<i64>>,
  variant_case_counts: List<usize>,
  variant_declarations: List<DeclarationIdentity>,
  variant_payload_counts: List<usize>,
  variant_payload_types: List<SemanticTypeId>,
  variant_bounds: SemanticDeclaredBoundColumns
}

pub(package) type SemanticTypeDeclarationCatalog = opaque SemanticTypeDeclarationCatalogStorage

pub(package) type SemanticTypeDeclarationLayoutMatch {
  SemanticRecordDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticVariantDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticTypeDeclarationLayoutMissing
}

pub(package) type SemanticUnparameterizedVariantConstructor {
  SemanticUnparameterizedVariantMissing,
  SemanticUnparameterizedVariantSelected(SemanticTypeId, usize, usize, usize),
  SemanticUnparameterizedVariantAmbiguous
}

-- The declared layout a constructor belongs to: its template target, layout
-- index, case index and payload count. A generic template's arguments are
-- the declaration's own type variables.
pub(package) type SemanticDeclaredVariantConstructor {
  SemanticDeclaredVariantConstructorMissing,
  SemanticDeclaredVariantConstructorSelected(SemanticTypeId, usize, usize, usize),
  SemanticDeclaredVariantConstructorAmbiguous
}

pub(package) type SemanticRecordDeclarationTemplateSelection {
  SemanticRecordDeclarationTemplateMissing,
  SemanticRecordDeclarationTemplateSelected(SemanticTypeId, usize, usize),
  SemanticRecordDeclarationTemplateAmbiguous
}

pub(package) type SemanticRecordTemplateFieldProjection {
  SemanticRecordTemplateFieldMissing,
  SemanticRecordTemplateFieldProjected(DeclarationIdentity, usize, SemanticTypeId),
  SemanticRecordTemplateFieldUnavailable
}

fn semantic_record_declaration_template_from(
  types: borrow SemanticTypeCatalog,
  targets: List<SemanticTypeId>,
  counts: List<usize>,
  declaration: DeclarationIdentity,
  index: usize,
  found: SemanticRecordDeclarationTemplateSelection
) -> SemanticRecordDeclarationTemplateSelection {
  match (targets, counts) {
    (Nil, Nil) -> found
    (Cons(target, remaining_targets), Cons(count, remaining_counts)) -> {
      let next = match types.graph_for(target) {
        None -> found
        Some(graph) -> match semantic_type_graph_node(graph, target) {
          SemanticNamedNode(candidate, _, _, _) -> if declaration_identity_eq(
            candidate,
            declaration
          ) {
            match found {
              SemanticRecordDeclarationTemplateMissing ->
                SemanticRecordDeclarationTemplateSelected(
                  target,
                  index,
                  count
                )
              _ -> SemanticRecordDeclarationTemplateAmbiguous
            }
          } else { found }
          _ -> found
        }
      }
      semantic_record_declaration_template_from(
        types,
        remaining_targets,
        remaining_counts,
        declaration,
        index + 1,
        next
      )
    }
    _ -> SemanticRecordDeclarationTemplateAmbiguous
  }
}

pub(package) fn semantic_type_declared_record_template(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticRecordDeclarationTemplateSelection {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> semantic_record_declaration_template_from(
      types,
      storage.record_targets,
      storage.record_field_counts,
      declaration,
      0,
      SemanticRecordDeclarationTemplateMissing
    )
  }
}

fn semantic_declarations_prepend(
  values: List<DeclarationIdentity>,
  suffix: List<DeclarationIdentity>
) -> List<DeclarationIdentity> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<DeclarationIdentity>(
      value,
      semantic_declarations_prepend(remaining, suffix)
    )
  }
}

fn semantic_types_prepend(
  values: List<SemanticTypeId>,
  suffix: List<SemanticTypeId>
) -> List<SemanticTypeId> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<SemanticTypeId>(
      value,
      semantic_types_prepend(remaining, suffix)
    )
  }
}

fn semantic_variables_prepend(
  values: List<SemanticTypeVariable>,
  suffix: List<SemanticTypeVariable>
) -> List<SemanticTypeVariable> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<SemanticTypeVariable>(
      value,
      semantic_variables_prepend(remaining, suffix)
    )
  }
}

fn semantic_usizes_prepend(
  values: List<usize>,
  suffix: List<usize>
) -> List<usize> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<usize>(
      value,
      semantic_usizes_prepend(remaining, suffix)
    )
  }
}

fn semantic_declaration_at(
  values: List<DeclarationIdentity>,
  index: usize
) -> Option<DeclarationIdentity> {
  match values {
    Nil -> None<DeclarationIdentity>()
    Cons(value, remaining) -> if index == 0 { Some<DeclarationIdentity>(value) }
    else { semantic_declaration_at(remaining, index - 1) }
  }
}

fn semantic_type_at(
  values: List<SemanticTypeId>,
  index: usize
) -> Option<SemanticTypeId> {
  match values {
    Nil -> None<SemanticTypeId>()
    Cons(value, remaining) -> if index == 0 { Some<SemanticTypeId>(value) }
    else { semantic_type_at(remaining, index - 1) }
  }
}

fn semantic_variable_at(
  values: List<SemanticTypeVariable>,
  index: usize
) -> Option<SemanticTypeVariable> {
  match values {
    Nil -> None<SemanticTypeVariable>()
    Cons(value, remaining) -> if index == 0 { Some<SemanticTypeVariable>(value) }
    else { semantic_variable_at(remaining, index - 1) }
  }
}

fn semantic_usize_at(values: List<usize>, index: usize) -> Option<usize> {
  match values {
    Nil -> None<usize>()
    Cons(value, remaining) -> if index == 0 { Some<usize>(value) }
    else { semantic_usize_at(remaining, index - 1) }
  }
}

fn semantic_usize_prefix(
  values: List<usize>,
  count: usize,
  total: usize
) -> Option<usize> {
  if count == 0 { Some<usize>(total) }
  else {
    match values {
      Nil -> None<usize>()
      Cons(value, remaining) -> match num_scalar_usize_checked_add(total, value) {
        None -> None<usize>()
        Some(next) -> semantic_usize_prefix(remaining, count - 1, next)
      }
    }
  }
}

pub(package) fn semantic_type_declaration_catalog_empty(
) -> SemanticTypeDeclarationCatalog {
  SemanticTypeDeclarationCatalog(
    SemanticTypeDeclarationCatalogStorage {
      record_targets: Nil<SemanticTypeId>(),
      record_keys: Nil<Option<i64>>(),
      record_field_counts: Nil<usize>(),
      record_declarations: Nil<DeclarationIdentity>(),
      record_types: Nil<SemanticTypeId>(),
      record_bounds: semantic_declared_bounds_empty(),
      variant_targets: Nil<SemanticTypeId>(),
      variant_keys: Nil<Option<i64>>(),
      variant_case_counts: Nil<usize>(),
      variant_declarations: Nil<DeclarationIdentity>(),
      variant_payload_counts: Nil<usize>(),
      variant_payload_types: Nil<SemanticTypeId>(),
      variant_bounds: semantic_declared_bounds_empty()
    }
  )
}

pub(package) fn semantic_record_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    target,
    declarations,
    types,
    Nil<SemanticTypeVariable>(),
    Nil<SemanticTypeId>()
  )
}

pub(package) fn semantic_record_declaration_layout_with_bounds(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>,
  bound_variables: List<SemanticTypeVariable>,
  bound_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    target,
    declarations,
    types,
    bound_variables,
    bound_types
  )
}

pub(package) fn semantic_variant_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  payload_counts: List<usize>,
  payload_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticVariantDeclarationLayout(
    target,
    declarations,
    payload_counts,
    payload_types,
    Nil<SemanticTypeVariable>(),
    Nil<SemanticTypeId>()
  )
}

pub(package) fn semantic_variant_declaration_layout_with_bounds(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  payload_counts: List<usize>,
  payload_types: List<SemanticTypeId>,
  bound_variables: List<SemanticTypeVariable>,
  bound_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticVariantDeclarationLayout(
    target,
    declarations,
    payload_counts,
    payload_types,
    bound_variables,
    bound_types
  )
}

pub(package) fn semantic_type_declaration_catalog_add(
  catalog: SemanticTypeDeclarationCatalog,
  type_catalog: borrow SemanticTypeCatalog,
  layout: SemanticTypeDeclarationLayout
) -> SemanticTypeDeclarationCatalog {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let {
        record_targets,
        record_keys,
        record_field_counts,
        record_declarations,
        record_types,
        record_bounds,
        variant_targets,
        variant_keys,
        variant_case_counts,
        variant_declarations,
        variant_payload_counts,
        variant_payload_types,
        variant_bounds,
      } = storage
      match layout {
        SemanticRecordDeclarationLayout(
          target,
          declarations,
          types,
          bound_variables,
          bound_types,
        ) ->
          SemanticTypeDeclarationCatalog(
            SemanticTypeDeclarationCatalogStorage {
              record_targets: record_targets.prepend(target),
              record_keys: record_keys.prepend(semantic_type_named_key(type_catalog, target)),
              record_field_counts: record_field_counts.prepend(declarations.len()),
              record_declarations: semantic_declarations_prepend(
                declarations,
                record_declarations
              ),
              record_types: semantic_types_prepend(types, record_types),
              record_bounds: semantic_declared_bounds_prepend(
                record_bounds,
                bound_variables,
                bound_types
              ),
              variant_targets: variant_targets,
              variant_keys: variant_keys,
              variant_case_counts: variant_case_counts,
              variant_declarations: variant_declarations,
              variant_payload_counts: variant_payload_counts,
              variant_payload_types: variant_payload_types,
              variant_bounds: variant_bounds
            }
          )
        SemanticVariantDeclarationLayout(
          target,
          declarations,
          payload_counts,
          payload_types,
          bound_variables,
          bound_types,
        ) -> SemanticTypeDeclarationCatalog(
          SemanticTypeDeclarationCatalogStorage {
            record_targets: record_targets,
            record_keys: record_keys,
            record_field_counts: record_field_counts,
            record_declarations: record_declarations,
            record_types: record_types,
            record_bounds: record_bounds,
            variant_targets: variant_targets.prepend(target),
            variant_keys: variant_keys.prepend(semantic_type_named_key(type_catalog, target)),
            variant_case_counts: variant_case_counts.prepend(declarations.len()),
            variant_declarations: semantic_declarations_prepend(
              declarations,
              variant_declarations
            ),
            variant_payload_counts: semantic_usizes_prepend(
              payload_counts,
              variant_payload_counts
            ),
            variant_payload_types: semantic_types_prepend(
              payload_types,
              variant_payload_types
            ),
            variant_bounds: semantic_declared_bounds_prepend(
              variant_bounds,
              bound_variables,
              bound_types
            )
          }
        )
      }
    }
  }
}

-- The declaration a named type applies, keyed by its retained hash; `None`
-- for any other type. A key narrows a lookup and never decides it.
fn semantic_type_named_key(types: borrow SemanticTypeCatalog, id: SemanticTypeId) -> Option<i64> {
  match types.graph_for(id) {
    None -> None<i64>()
    Some(graph) -> match semantic_type_graph_node(graph, id) {
      SemanticNamedNode(declaration, _, _, _) -> Some(
        retained_declaration_identity_hash(declaration)
      )
      _ -> None<i64>()
    }
  }
}

-- The concrete type's key, seen through its substitution when it is a
-- variable, as pattern matching sees it.
fn semantic_type_concrete_key(
  types: borrow SemanticTypeCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> Option<i64> {
  match types.graph_for(concrete) {
    None -> None<i64>()
    Some(graph) -> match semantic_type_graph_node(graph, concrete) {
      SemanticVariableNode(variable) -> match semantic_type_substitution_get(
        concrete_substitution,
        variable
      ) {
        Some(value) -> semantic_type_named_key(types, value)
        None -> None<i64>()
      }
      _ -> semantic_type_named_key(types, concrete)
    }
  }
}

-- Whether a target could apply the concrete type's declaration: only a
-- differing pair of known keys rules it out.
fn semantic_type_keys_may_match(target: Option<i64>, concrete: Option<i64>) -> bool {
  match (target, concrete) {
    (Some(left), Some(right)) -> left == right
    _ -> true
  }
}

fn semantic_type_declaration_resolve_from(
  types: borrow SemanticTypeCatalog,
  targets: List<SemanticTypeId>,
  keys: List<Option<i64>>,
  concrete: SemanticTypeId,
  concrete_key: Option<i64>,
  concrete_substitution: borrow SemanticTypeSubstitution,
  layout_index: usize,
  record: bool
) -> SemanticTypeDeclarationLayoutMatch {
  match (targets, keys) {
    (Cons(target, remaining), Cons(key, remaining_keys)) -> {
      let matched = if semantic_type_keys_may_match(key, concrete_key) {
        semantic_type_pattern_match_substituted(
          types,
          target,
          semantic_type_substitution_empty(),
          concrete,
          concrete_substitution
        )
      } else { SemanticTypePatternRejected }
      match matched {
        SemanticTypePatternRejected -> semantic_type_declaration_resolve_from(
          types,
          remaining,
          remaining_keys,
          concrete,
          concrete_key,
          concrete_substitution,
          layout_index + 1,
          record
        )
        SemanticTypePatternMatched(substitution) -> if record {
          SemanticRecordDeclarationLayoutMatched(layout_index, substitution)
        } else {
          SemanticVariantDeclarationLayoutMatched(layout_index, substitution)
        }
      }
    }
    _ -> SemanticTypeDeclarationLayoutMissing
  }
}

pub(package) fn semantic_type_declaration_catalog_resolve(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> SemanticTypeDeclarationLayoutMatch {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let concrete_key = semantic_type_concrete_key(types, concrete, concrete_substitution)
      match semantic_type_declaration_resolve_from(
        types,
        storage.record_targets,
        storage.record_keys,
        concrete,
        concrete_key,
        concrete_substitution,
        0,
        true
      ) {
        SemanticTypeDeclarationLayoutMissing -> semantic_type_declaration_resolve_from(
          types,
          storage.variant_targets,
          storage.variant_keys,
          concrete,
          concrete_key,
          concrete_substitution,
          0,
          false
        )
        matched -> matched
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) ->
      semantic_usize_at(storage.record_field_counts, layout_index)
  }
}

fn semantic_type_record_field_ordinal(
  counts: List<usize>,
  layout_index: usize,
  field_index: usize
) -> Option<usize> {
  match semantic_usize_prefix(counts, layout_index, 0) {
    None -> None<usize>()
    Some(start) -> num_scalar_usize_checked_add(start, field_index)
  }
}

pub(package) fn semantic_type_declared_record_field_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_record_field_ordinal(
        storage.record_field_counts,
        layout_index,
        field_index
      ) {
        None -> None<DeclarationIdentity>()
        Some(index) -> semantic_declaration_at(storage.record_declarations, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_record_field_ordinal(
        storage.record_field_counts,
        layout_index,
        field_index
      ) {
        None -> None<SemanticTypeId>()
        Some(index) -> semantic_type_at(storage.record_types, index)
      }
    }
  }
}

fn semantic_record_template_field_from(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_count: usize,
  wanted: str,
  field_index: usize
) -> SemanticRecordTemplateFieldProjection {
  if field_index >= field_count { SemanticRecordTemplateFieldMissing }
  else {
    match (
      semantic_type_declared_record_field_declaration(catalog, layout_index, field_index),
      semantic_type_declared_record_field_type(catalog, layout_index, field_index),
    ) {
      (Some(declaration), Some(field_type)) -> {
        let name = declaration_identity_name(declaration)
        if match name.text() { Some(value) -> value == wanted, None -> false } {
          SemanticRecordTemplateFieldProjected(declaration, field_index, field_type)
        } else {
          semantic_record_template_field_from(
            catalog,
            layout_index,
            field_count,
            wanted,
            field_index + 1
          )
        }
      }
      _ -> SemanticRecordTemplateFieldUnavailable
    }
  }
}

pub(package) fn semantic_type_declared_record_template_field(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  wanted: str
) -> SemanticRecordTemplateFieldProjection {
  match semantic_type_declared_record_field_count(catalog, layout_index) {
    None -> SemanticRecordTemplateFieldUnavailable
    Some(field_count) -> semantic_record_template_field_from(
      catalog,
      layout_index,
      field_count,
      wanted,
      0
    )
  }
}

-- A layout's index within its kind, beside that kind's bound columns.
fn semantic_declared_bound_columns(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -> (usize, SemanticDeclaredBoundColumns) {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> match layout {
      SemanticDeclaredRecordLayout(index) -> (index, storage.record_bounds)
      SemanticDeclaredVariantLayout(index) -> (index, storage.variant_bounds)
    }
  }
}

-- The flat position of a layout's bound, when the layout has that many.
fn semantic_declared_bound_ordinal(
  counts: List<usize>,
  layout_index: usize,
  bound_index: usize
) -> Option<usize> {
  match semantic_usize_at(counts, layout_index) {
    None -> None<usize>()
    Some(count) -> if bound_index >= count { None<usize>() }
    else {
      match semantic_usize_prefix(counts, layout_index, 0) {
        None -> None<usize>()
        Some(start) -> num_scalar_usize_checked_add(start, bound_index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_bound_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -> Option<usize> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  semantic_usize_at(columns.counts, index)
}

pub(package) fn semantic_type_declared_bound_variable(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout,
  bound_index: usize
) -> Option<SemanticTypeVariable> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  match semantic_declared_bound_ordinal(columns.counts, index, bound_index) {
    None -> None<SemanticTypeVariable>()
    Some(ordinal) -> semantic_variable_at(columns.variables, ordinal)
  }
}

pub(package) fn semantic_type_declared_bound_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout,
  bound_index: usize
) -> Option<SemanticTypeId> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  match semantic_declared_bound_ordinal(columns.counts, index, bound_index) {
    None -> None<SemanticTypeId>()
    Some(ordinal) -> semantic_type_at(columns.types, ordinal)
  }
}

pub(package) fn semantic_type_declared_variant_case_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) ->
      semantic_usize_at(storage.variant_case_counts, layout_index)
  }
}

fn semantic_type_variant_case_ordinal(
  counts: List<usize>,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  match semantic_usize_prefix(counts, layout_index, 0) {
    None -> None<usize>()
    Some(start) -> num_scalar_usize_checked_add(start, case_index)
  }
}

pub(package) fn semantic_type_declared_variant_case_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<DeclarationIdentity>()
        Some(index) -> semantic_declaration_at(storage.variant_declarations, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<usize>()
        Some(index) -> semantic_usize_at(storage.variant_payload_counts, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize,
  payload_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<SemanticTypeId>()
        Some(case_ordinal) -> match semantic_usize_prefix(
          storage.variant_payload_counts,
          case_ordinal,
          0
        ) {
          None -> None<SemanticTypeId>()
          Some(start) -> match num_scalar_usize_checked_add(start, payload_index) {
            None -> None<SemanticTypeId>()
            Some(index) -> semantic_type_at(storage.variant_payload_types, index)
          }
        }
      }
    }
  }
}

fn semantic_unparameterized_variant_case(
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  layout_index: usize,
  case_index: usize,
  case_count: usize
) -> Option<(usize, usize)> {
  if case_index >= case_count { None<(usize, usize)>() }
  else {
    match semantic_type_declared_variant_case_declaration(catalog, layout_index, case_index) {
      None -> None<(usize, usize)>()
      Some(candidate) -> if declaration_identity_eq(candidate, declaration) {
        match semantic_type_declared_variant_payload_count(catalog, layout_index, case_index) {
          None -> None<(usize, usize)>()
          Some(count) -> Some((case_index, count))
        }
      } else {
        semantic_unparameterized_variant_case(
          catalog,
          declaration,
          layout_index,
          case_index + 1,
          case_count
        )
      }
    }
  }
}

fn semantic_declared_variant_constructor_from(
  catalog: borrow SemanticTypeDeclarationCatalog,
  targets: List<SemanticTypeId>,
  keys: List<Option<i64>>,
  declaration: DeclarationIdentity,
  owner_key: Option<i64>,
  layout_index: usize,
  found: SemanticDeclaredVariantConstructor
) -> SemanticDeclaredVariantConstructor {
  match (targets, keys) {
    (Cons(target, remaining), Cons(key, remaining_keys)) -> {
      let case_count = if semantic_type_keys_may_match(key, owner_key) {
        semantic_type_declared_variant_case_count(catalog, layout_index)
      } else { None<usize>() }
      let next = match case_count {
        None -> found
        Some(case_count) -> match semantic_unparameterized_variant_case(
          catalog,
          declaration,
          layout_index,
          0,
          case_count
        ) {
          None -> found
          Some((case_index, payload_count)) -> match found {
            SemanticDeclaredVariantConstructorMissing ->
              SemanticDeclaredVariantConstructorSelected(
                target,
                layout_index,
                case_index,
                payload_count
              )
            _ -> SemanticDeclaredVariantConstructorAmbiguous
          }
        }
      }
      semantic_declared_variant_constructor_from(
        catalog,
        remaining,
        remaining_keys,
        declaration,
        owner_key,
        layout_index + 1,
        next
      )
    }
    _ -> found
  }
}

-- The declared layout of a constructor, generic or not.
pub(package) fn semantic_type_declared_variant_constructor(
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticDeclaredVariantConstructor {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> semantic_declared_variant_constructor_from(
      catalog,
      storage.variant_targets,
      storage.variant_keys,
      declaration,
      match declaration_identity_owner(declaration) {
        nil -> None<i64>()
        owner: DeclarationIdentity -> Some(retained_declaration_identity_hash(owner))
      },
      0,
      SemanticDeclaredVariantConstructorMissing
    )
  }
}

-- Whether a declared template applies no type arguments.
pub(package) fn semantic_type_template_unparameterized(
  types: borrow SemanticTypeCatalog,
  target: SemanticTypeId
) -> bool {
  match types.graph_for(target) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, target) {
      SemanticNamedNode(_, _, _, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_list_len(lists, arguments) == 0
      }
      _ -> false
    }
  }
}

pub(package) fn semantic_type_declared_unparameterized_variant_constructor(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticUnparameterizedVariantConstructor {
  match semantic_type_declared_variant_constructor(catalog, declaration) {
    SemanticDeclaredVariantConstructorMissing -> SemanticUnparameterizedVariantMissing
    SemanticDeclaredVariantConstructorAmbiguous -> SemanticUnparameterizedVariantAmbiguous
    SemanticDeclaredVariantConstructorSelected(target, layout_index, case_index, payload_count) ->
      if
      semantic_type_template_unparameterized(types, target) {
        SemanticUnparameterizedVariantSelected(target, layout_index, case_index, payload_count)
      } else { SemanticUnparameterizedVariantMissing }
  }
}
