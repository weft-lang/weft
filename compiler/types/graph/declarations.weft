-- Resolved type-declaration shapes over immutable semantic graphs.
--
-- A named semantic type retains declaration identity and arguments. Record
-- fields and variant cases belong to the declaration product, not to every
-- named type node. This catalog joins the two without exposing syntax or a
-- checker table; target placement and later checked passes consume the same
-- resolved shapes.
--
-- Every stored column is a flat persistent vector. Each layout records where
-- its fields, cases and bounds start, and each case where its payloads
-- start, so every accessor is an indexed lookup rather than a walk over the
-- catalog. Layouts are also indexed by their target's declaration key, so a
-- lookup visits only the layouts that could apply the wanted declaration. A
-- match returns only a scalar layout index and its generic substitution;
-- typed accessors expose one field or payload at a time.

use compiler/project/identity.{
  DeclarationIdentity,
  declaration_identity_name,
  declaration_identity_owner
}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/project/identity/hash.{retained_declaration_identity_hash}
use compiler/types/graph.{
  SemanticNamedNode,
  SemanticTypeId,
  SemanticTypeVariable,
  SemanticVariableNode,
  semantic_type_graph_node,
  semantic_type_graph_type_lists_local,
  semantic_type_list_len
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match_substituted
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty,
  semantic_type_substitution_get
}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/option.{None, Option, Some}
use stdlib/persistent_vector as persistent_vector
use stdlib/persistent_vector.{PersistentVector}

pub(package) type SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<SemanticTypeId>,
    List<SemanticTypeVariable>,
    List<SemanticTypeId>
  ),
  SemanticVariantDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<usize>,
    List<SemanticTypeId>,
    List<SemanticTypeVariable>,
    List<SemanticTypeId>
  )
}

-- One declaration's layout, of either kind: the index a declared bound is
-- read through.
pub(package) type SemanticDeclaredLayout {
  SemanticDeclaredRecordLayout(usize),
  SemanticDeclaredVariantLayout(usize)
}

-- Each layout's declared bounds: where they start in the flat variable and
-- bound-type columns, and how many there are.
type SemanticDeclaredBoundColumns {
  starts: PersistentVector<usize>,
  counts: PersistentVector<usize>,
  variables: PersistentVector<SemanticTypeVariable>,
  types: PersistentVector<SemanticTypeId>
}

-- Layout indices by their target's declaration key, newest first, beside
-- the newest-first layouts whose target has no key. A key narrows a lookup
-- and never decides it: distinct declarations may share a key.
type SemanticLayoutKeyIndex {
  keyed: Map<i64, List<usize>>,
  unkeyed: List<usize>
}

-- Record layouts: one target, field start and field count per layout,
-- beside the key index and the flat field columns.
type SemanticRecordLayoutColumns {
  targets: PersistentVector<SemanticTypeId>,
  index: SemanticLayoutKeyIndex,
  field_starts: PersistentVector<usize>,
  field_counts: PersistentVector<usize>,
  declarations: PersistentVector<DeclarationIdentity>,
  types: PersistentVector<SemanticTypeId>,
  bounds: SemanticDeclaredBoundColumns
}

-- Variant layouts: one target, case start and case count per layout, beside
-- the key index; one declaration, payload start and payload count per case;
-- and the flat payload types.
type SemanticVariantLayoutColumns {
  targets: PersistentVector<SemanticTypeId>,
  index: SemanticLayoutKeyIndex,
  case_starts: PersistentVector<usize>,
  case_counts: PersistentVector<usize>,
  declarations: PersistentVector<DeclarationIdentity>,
  payload_starts: PersistentVector<usize>,
  payload_counts: PersistentVector<usize>,
  payload_types: PersistentVector<SemanticTypeId>,
  bounds: SemanticDeclaredBoundColumns
}

type SemanticTypeDeclarationCatalogStorage {
  records: SemanticRecordLayoutColumns,
  variants: SemanticVariantLayoutColumns
}

pub(package) type SemanticTypeDeclarationCatalog = opaque SemanticTypeDeclarationCatalogStorage

pub(package) type SemanticTypeDeclarationLayoutMatch {
  SemanticRecordDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticVariantDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticTypeDeclarationLayoutMissing
}

pub(package) type SemanticUnparameterizedVariantConstructor {
  SemanticUnparameterizedVariantMissing,
  SemanticUnparameterizedVariantSelected(SemanticTypeId, usize, usize, usize),
  SemanticUnparameterizedVariantAmbiguous
}

-- The declared layout a constructor belongs to: its template target, layout
-- index, case index and payload count. A generic template's arguments are
-- the declaration's own type variables.
pub(package) type SemanticDeclaredVariantConstructor {
  SemanticDeclaredVariantConstructorMissing,
  SemanticDeclaredVariantConstructorSelected(SemanticTypeId, usize, usize, usize),
  SemanticDeclaredVariantConstructorAmbiguous
}

pub(package) type SemanticRecordDeclarationTemplateSelection {
  SemanticRecordDeclarationTemplateMissing,
  SemanticRecordDeclarationTemplateSelected(SemanticTypeId, usize, usize),
  SemanticRecordDeclarationTemplateAmbiguous
}

pub(package) type SemanticRecordTemplateFieldProjection {
  SemanticRecordTemplateFieldMissing,
  SemanticRecordTemplateFieldProjected(DeclarationIdentity, usize, SemanticTypeId),
  SemanticRecordTemplateFieldUnavailable
}

fn semantic_push_all<T>(values: PersistentVector<T>, items: List<T>) -> PersistentVector<T> {
  match items {
    Nil -> values
    Cons(item, rest) -> semantic_push_all<T>(values.push(item), rest)
  }
}

-- The flat position of a layout's `index`th item, when it has that many.
fn semantic_layout_ordinal(
  starts: PersistentVector<usize>,
  counts: PersistentVector<usize>,
  layout_index: usize,
  index: usize
) -> Option<usize> {
  match (starts.get(layout_index), counts.get(layout_index)) {
    (Some(start), Some(count)) -> if index < count { Some(start + index) }
    else { None<usize>() }
    _ -> None<usize>()
  }
}

fn semantic_layout_key_index_empty() -> SemanticLayoutKeyIndex {
  SemanticLayoutKeyIndex { keyed: map.new<i64, List<usize>>(), unkeyed: Nil<usize>() }
}

fn semantic_layout_key_index_add(
  index: SemanticLayoutKeyIndex,
  key: Option<i64>,
  layout: usize
) -> SemanticLayoutKeyIndex {
  let { keyed, unkeyed } = index
  match key {
    None -> SemanticLayoutKeyIndex { keyed: keyed, unkeyed: unkeyed.prepend(layout) }
    Some(value) -> {
      let layouts = match keyed.get(value) {
        Some(existing) -> existing.prepend(layout)
        None -> Nil<usize>().prepend(layout)
      }
      SemanticLayoutKeyIndex { keyed: keyed.insert(value, layouts), unkeyed: unkeyed }
    }
  }
}

-- Two newest-first layout lists as one.
fn semantic_layouts_newest_first(left: List<usize>, right: List<usize>) -> List<usize> {
  match (left, right) {
    (Nil, rest) -> rest
    (rest, Nil) -> rest
    (Cons(first, left_rest), Cons(second, right_rest)) -> if first > second {
      semantic_layouts_newest_first(left_rest, right).prepend(first)
    } else { semantic_layouts_newest_first(left, right_rest).prepend(second) }
  }
}

-- The layouts, newest first, whose target could apply a type with `key`:
-- those sharing the key and every unkeyed one. A keyed target applies a
-- declaration, and matches only a type applying that same declaration, so
-- an unkeyed type admits only the unkeyed layouts.
fn semantic_layout_key_candidates(
  index: borrow SemanticLayoutKeyIndex,
  key: Option<i64>
) -> List<usize> {
  match key {
    None -> index.unkeyed
    Some(value) -> match index.keyed.get(value) {
      None -> index.unkeyed
      Some(keyed) -> semantic_layouts_newest_first(keyed, index.unkeyed)
    }
  }
}

fn semantic_declared_bounds_empty() -> SemanticDeclaredBoundColumns {
  SemanticDeclaredBoundColumns {
    starts: persistent_vector.new<usize>(),
    counts: persistent_vector.new<usize>(),
    variables: persistent_vector.new<SemanticTypeVariable>(),
    types: persistent_vector.new<SemanticTypeId>()
  }
}

fn semantic_declared_bounds_add(
  columns: SemanticDeclaredBoundColumns,
  variables: List<SemanticTypeVariable>,
  types: List<SemanticTypeId>
) -> SemanticDeclaredBoundColumns {
  SemanticDeclaredBoundColumns {
    starts: columns.starts.push(columns.variables.len()),
    counts: columns.counts.push(variables.len()),
    variables: semantic_push_all<SemanticTypeVariable>(columns.variables, variables),
    types: semantic_push_all<SemanticTypeId>(columns.types, types)
  }
}

pub(package) fn semantic_type_declaration_catalog_empty(
) -> SemanticTypeDeclarationCatalog {
  SemanticTypeDeclarationCatalog(
    SemanticTypeDeclarationCatalogStorage {
      records: SemanticRecordLayoutColumns {
        targets: persistent_vector.new<SemanticTypeId>(),
        index: semantic_layout_key_index_empty(),
        field_starts: persistent_vector.new<usize>(),
        field_counts: persistent_vector.new<usize>(),
        declarations: persistent_vector.new<DeclarationIdentity>(),
        types: persistent_vector.new<SemanticTypeId>(),
        bounds: semantic_declared_bounds_empty()
      },
      variants: SemanticVariantLayoutColumns {
        targets: persistent_vector.new<SemanticTypeId>(),
        index: semantic_layout_key_index_empty(),
        case_starts: persistent_vector.new<usize>(),
        case_counts: persistent_vector.new<usize>(),
        declarations: persistent_vector.new<DeclarationIdentity>(),
        payload_starts: persistent_vector.new<usize>(),
        payload_counts: persistent_vector.new<usize>(),
        payload_types: persistent_vector.new<SemanticTypeId>(),
        bounds: semantic_declared_bounds_empty()
      }
    }
  )
}

pub(package) fn semantic_record_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    target,
    declarations,
    types,
    Nil<SemanticTypeVariable>(),
    Nil<SemanticTypeId>()
  )
}

pub(package) fn semantic_record_declaration_layout_with_bounds(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>,
  bound_variables: List<SemanticTypeVariable>,
  bound_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    target,
    declarations,
    types,
    bound_variables,
    bound_types
  )
}

pub(package) fn semantic_variant_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  payload_counts: List<usize>,
  payload_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticVariantDeclarationLayout(
    target,
    declarations,
    payload_counts,
    payload_types,
    Nil<SemanticTypeVariable>(),
    Nil<SemanticTypeId>()
  )
}

pub(package) fn semantic_variant_declaration_layout_with_bounds(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  payload_counts: List<usize>,
  payload_types: List<SemanticTypeId>,
  bound_variables: List<SemanticTypeVariable>,
  bound_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticVariantDeclarationLayout(
    target,
    declarations,
    payload_counts,
    payload_types,
    bound_variables,
    bound_types
  )
}

-- Each case's payload start, from the next free payload position.
fn semantic_variant_payload_starts(
  starts: PersistentVector<usize>,
  next: usize,
  counts: List<usize>
) -> PersistentVector<usize> {
  match counts {
    Nil -> starts
    Cons(count, rest) -> semantic_variant_payload_starts(starts.push(next), next + count, rest)
  }
}

pub(package) fn semantic_type_declaration_catalog_add(
  catalog: SemanticTypeDeclarationCatalog,
  type_catalog: borrow SemanticTypeCatalog,
  layout: SemanticTypeDeclarationLayout
) -> SemanticTypeDeclarationCatalog {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let { records, variants } = storage
      match layout {
        SemanticRecordDeclarationLayout(
          target,
          declarations,
          types,
          bound_variables,
          bound_types,
        ) ->
          SemanticTypeDeclarationCatalog(
            SemanticTypeDeclarationCatalogStorage {
              records: SemanticRecordLayoutColumns {
                targets: records.targets.push(target),
                index: semantic_layout_key_index_add(
                  records.index,
                  semantic_type_named_key(type_catalog, target),
                  records.targets.len()
                ),
                field_starts: records.field_starts.push(records.declarations.len()),
                field_counts: records.field_counts.push(declarations.len()),
                declarations: semantic_push_all<DeclarationIdentity>(
                  records.declarations,
                  declarations
                ),
                types: semantic_push_all<SemanticTypeId>(records.types, types),
                bounds: semantic_declared_bounds_add(records.bounds, bound_variables, bound_types)
              },
              variants: variants
            }
          )
        SemanticVariantDeclarationLayout(
          target,
          declarations,
          payload_counts,
          payload_types,
          bound_variables,
          bound_types,
        ) -> SemanticTypeDeclarationCatalog(
          SemanticTypeDeclarationCatalogStorage {
            records: records,
            variants: SemanticVariantLayoutColumns {
              targets: variants.targets.push(target),
              index: semantic_layout_key_index_add(
                variants.index,
                semantic_type_named_key(type_catalog, target),
                variants.targets.len()
              ),
              case_starts: variants.case_starts.push(variants.declarations.len()),
              case_counts: variants.case_counts.push(declarations.len()),
              declarations: semantic_push_all<DeclarationIdentity>(
                variants.declarations,
                declarations
              ),
              payload_starts: semantic_variant_payload_starts(
                variants.payload_starts,
                variants.payload_types.len(),
                payload_counts
              ),
              payload_counts: semantic_push_all<usize>(variants.payload_counts, payload_counts),
              payload_types: semantic_push_all<SemanticTypeId>(
                variants.payload_types,
                payload_types
              ),
              bounds: semantic_declared_bounds_add(variants.bounds, bound_variables, bound_types)
            }
          }
        )
      }
    }
  }
}

fn semantic_record_declaration_template_from(
  types: borrow SemanticTypeCatalog,
  records: borrow SemanticRecordLayoutColumns,
  declaration: DeclarationIdentity,
  candidates: List<usize>,
  found: SemanticRecordDeclarationTemplateSelection
) -> SemanticRecordDeclarationTemplateSelection {
  match candidates {
    Nil -> found
    Cons(index, rest) -> {
      let next = match (records.targets.get(index), records.field_counts.get(index)) {
        (Some(target), Some(count)) -> match types.graph_for(target) {
          None -> found
          Some(graph) -> match semantic_type_graph_node(graph, target) {
            SemanticNamedNode(candidate, _, _, _) -> if declaration_identity_eq(
              candidate,
              declaration
            ) {
              match found {
                SemanticRecordDeclarationTemplateMissing ->
                  SemanticRecordDeclarationTemplateSelected(target, index, count)
                _ -> SemanticRecordDeclarationTemplateAmbiguous
              }
            } else { found }
            _ -> found
          }
        }
        _ -> found
      }
      semantic_record_declaration_template_from(types, records, declaration, rest, next)
    }
  }
}

pub(package) fn semantic_type_declared_record_template(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticRecordDeclarationTemplateSelection {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let records = storage.records
      let index = records.index
      let candidates = semantic_layout_key_candidates(
        index,
        Some(retained_declaration_identity_hash(declaration))
      )
      semantic_record_declaration_template_from(
        types,
        records,
        declaration,
        candidates,
        SemanticRecordDeclarationTemplateMissing
      )
    }
  }
}

-- The declaration a named type applies, keyed by its retained hash; `None`
-- for any other type. A key narrows a lookup and never decides it.
fn semantic_type_named_key(types: borrow SemanticTypeCatalog, id: SemanticTypeId) -> Option<i64> {
  match types.graph_for(id) {
    None -> None<i64>()
    Some(graph) -> match semantic_type_graph_node(graph, id) {
      SemanticNamedNode(declaration, _, _, _) -> Some(
        retained_declaration_identity_hash(declaration)
      )
      _ -> None<i64>()
    }
  }
}

-- The concrete type's key, seen through its substitution when it is a
-- variable, as pattern matching sees it.
fn semantic_type_concrete_key(
  types: borrow SemanticTypeCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> Option<i64> {
  match types.graph_for(concrete) {
    None -> None<i64>()
    Some(graph) -> match semantic_type_graph_node(graph, concrete) {
      SemanticVariableNode(variable) -> match semantic_type_substitution_get(
        concrete_substitution,
        variable
      ) {
        Some(value) -> semantic_type_named_key(types, value)
        None -> None<i64>()
      }
      _ -> semantic_type_named_key(types, concrete)
    }
  }
}

-- The first candidate target, newest first, that the concrete type
-- instantiates.
fn semantic_type_declaration_resolve_from(
  types: borrow SemanticTypeCatalog,
  targets: PersistentVector<SemanticTypeId>,
  candidates: List<usize>,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> Option<(usize, SemanticTypeSubstitution)> {
  match candidates {
    Nil -> None<(usize, SemanticTypeSubstitution)>()
    Cons(index, rest) -> {
      let matched = match targets.get(index) {
        Some(target) -> semantic_type_pattern_match_substituted(
          types,
          target,
          semantic_type_substitution_empty(),
          concrete,
          concrete_substitution
        )
        None -> SemanticTypePatternRejected
      }
      match matched {
        SemanticTypePatternMatched(substitution) -> Some((index, substitution))
        SemanticTypePatternRejected -> semantic_type_declaration_resolve_from(
          types,
          targets,
          rest,
          concrete,
          concrete_substitution
        )
      }
    }
  }
}

pub(package) fn semantic_type_declaration_catalog_resolve(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> SemanticTypeDeclarationLayoutMatch {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let concrete_key = semantic_type_concrete_key(types, concrete, concrete_substitution)
      let records = storage.records
      let variants = storage.variants
      let record_index = records.index
      let variant_index = variants.index
      match semantic_type_declaration_resolve_from(
        types,
        records.targets,
        semantic_layout_key_candidates(record_index, concrete_key),
        concrete,
        concrete_substitution
      ) {
        Some((layout, substitution)) -> SemanticRecordDeclarationLayoutMatched(
          layout,
          substitution
        )
        None -> match semantic_type_declaration_resolve_from(
          types,
          variants.targets,
          semantic_layout_key_candidates(variant_index, concrete_key),
          concrete,
          concrete_substitution
        ) {
          Some((layout, substitution)) ->
            SemanticVariantDeclarationLayoutMatched(layout, substitution)
          None -> SemanticTypeDeclarationLayoutMissing
        }
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let records = storage.records
      records.field_counts.get(layout_index)
    }
  }
}

pub(package) fn semantic_type_declared_record_field_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let records = storage.records
      match semantic_layout_ordinal(
        records.field_starts,
        records.field_counts,
        layout_index,
        field_index
      ) {
        None -> None<DeclarationIdentity>()
        Some(ordinal) -> records.declarations.get(ordinal)
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let records = storage.records
      match semantic_layout_ordinal(
        records.field_starts,
        records.field_counts,
        layout_index,
        field_index
      ) {
        None -> None<SemanticTypeId>()
        Some(ordinal) -> records.types.get(ordinal)
      }
    }
  }
}

fn semantic_record_template_field_from(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_count: usize,
  wanted: str,
  field_index: usize
) -> SemanticRecordTemplateFieldProjection {
  if field_index >= field_count { SemanticRecordTemplateFieldMissing }
  else {
    match (
      semantic_type_declared_record_field_declaration(catalog, layout_index, field_index),
      semantic_type_declared_record_field_type(catalog, layout_index, field_index),
    ) {
      (Some(declaration), Some(field_type)) -> {
        let name = declaration_identity_name(declaration)
        if match name.text() { Some(value) -> value == wanted, None -> false } {
          SemanticRecordTemplateFieldProjected(declaration, field_index, field_type)
        } else {
          semantic_record_template_field_from(
            catalog,
            layout_index,
            field_count,
            wanted,
            field_index + 1
          )
        }
      }
      _ -> SemanticRecordTemplateFieldUnavailable
    }
  }
}

pub(package) fn semantic_type_declared_record_template_field(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  wanted: str
) -> SemanticRecordTemplateFieldProjection {
  match semantic_type_declared_record_field_count(catalog, layout_index) {
    None -> SemanticRecordTemplateFieldUnavailable
    Some(field_count) -> semantic_record_template_field_from(
      catalog,
      layout_index,
      field_count,
      wanted,
      0
    )
  }
}

-- A layout's index within its kind, beside that kind's bound columns.
fn semantic_declared_bound_columns(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -> (usize, SemanticDeclaredBoundColumns) {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> match layout {
      SemanticDeclaredRecordLayout(index) -> {
        let records = storage.records
        (index, records.bounds)
      }
      SemanticDeclaredVariantLayout(index) -> {
        let variants = storage.variants
        (index, variants.bounds)
      }
    }
  }
}

-- The template a layout of either kind declares: the declaration applied to
-- its own type variables.
pub(package) fn semantic_type_declared_layout_target(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> match layout {
      SemanticDeclaredRecordLayout(index) -> {
        let records = storage.records
        records.targets.get(index)
      }
      SemanticDeclaredVariantLayout(index) -> {
        let variants = storage.variants
        variants.targets.get(index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_bound_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout
) -> Option<usize> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  columns.counts.get(index)
}

pub(package) fn semantic_type_declared_bound_variable(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout,
  bound_index: usize
) -> Option<SemanticTypeVariable> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  match semantic_layout_ordinal(columns.starts, columns.counts, index, bound_index) {
    None -> None<SemanticTypeVariable>()
    Some(ordinal) -> columns.variables.get(ordinal)
  }
}

pub(package) fn semantic_type_declared_bound_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout: SemanticDeclaredLayout,
  bound_index: usize
) -> Option<SemanticTypeId> {
  let (index, columns) = semantic_declared_bound_columns(catalog, layout)
  match semantic_layout_ordinal(columns.starts, columns.counts, index, bound_index) {
    None -> None<SemanticTypeId>()
    Some(ordinal) -> columns.types.get(ordinal)
  }
}

pub(package) fn semantic_type_declared_variant_case_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let variants = storage.variants
      variants.case_counts.get(layout_index)
    }
  }
}

fn semantic_variant_case_ordinal(
  variants: borrow SemanticVariantLayoutColumns,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  semantic_layout_ordinal(variants.case_starts, variants.case_counts, layout_index, case_index)
}

pub(package) fn semantic_type_declared_variant_case_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let variants = storage.variants
      match semantic_variant_case_ordinal(variants, layout_index, case_index) {
        None -> None<DeclarationIdentity>()
        Some(ordinal) -> variants.declarations.get(ordinal)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let variants = storage.variants
      match semantic_variant_case_ordinal(variants, layout_index, case_index) {
        None -> None<usize>()
        Some(ordinal) -> variants.payload_counts.get(ordinal)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize,
  payload_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let variants = storage.variants
      match semantic_variant_case_ordinal(variants, layout_index, case_index) {
        None -> None<SemanticTypeId>()
        Some(case_ordinal) -> match semantic_layout_ordinal(
          variants.payload_starts,
          variants.payload_counts,
          case_ordinal,
          payload_index
        ) {
          None -> None<SemanticTypeId>()
          Some(ordinal) -> variants.payload_types.get(ordinal)
        }
      }
    }
  }
}

-- The case of a layout that `declaration` names, with its payload count.
fn semantic_variant_constructor_case(
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  layout_index: usize,
  case_index: usize,
  case_count: usize
) -> Option<(usize, usize)> {
  if case_index >= case_count { None<(usize, usize)>() }
  else {
    match semantic_type_declared_variant_case_declaration(catalog, layout_index, case_index) {
      None -> None<(usize, usize)>()
      Some(candidate) -> if declaration_identity_eq(candidate, declaration) {
        match semantic_type_declared_variant_payload_count(catalog, layout_index, case_index) {
          None -> None<(usize, usize)>()
          Some(count) -> Some((case_index, count))
        }
      } else {
        semantic_variant_constructor_case(
          catalog,
          declaration,
          layout_index,
          case_index + 1,
          case_count
        )
      }
    }
  }
}

fn semantic_declared_variant_constructor_from(
  catalog: borrow SemanticTypeDeclarationCatalog,
  variants: borrow SemanticVariantLayoutColumns,
  declaration: DeclarationIdentity,
  candidates: List<usize>,
  found: SemanticDeclaredVariantConstructor
) -> SemanticDeclaredVariantConstructor {
  match candidates {
    Nil -> found
    Cons(layout_index, rest) -> {
      let case = match variants.case_counts.get(layout_index) {
        Some(case_count) ->
          semantic_variant_constructor_case(catalog, declaration, layout_index, 0, case_count)
        None -> None<(usize, usize)>()
      }
      let next = match (case, variants.targets.get(layout_index)) {
        (Some((case_index, payload_count)), Some(target)) -> match found {
          SemanticDeclaredVariantConstructorMissing -> SemanticDeclaredVariantConstructorSelected(
            target,
            layout_index,
            case_index,
            payload_count
          )
          _ -> SemanticDeclaredVariantConstructorAmbiguous
        }
        _ -> found
      }
      semantic_declared_variant_constructor_from(catalog, variants, declaration, rest, next)
    }
  }
}

-- Every layout below `count`, newest first.
fn semantic_layouts_below(count: usize, layouts: List<usize>) -> List<usize> {
  if count == 0 { layouts }
  else { semantic_layouts_below(count - 1, layouts.prepend(count - 1)) }
}

-- The declared layout of a constructor, generic or not.
pub(package) fn semantic_type_declared_variant_constructor(
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticDeclaredVariantConstructor {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let variants = storage.variants
      let index = variants.index
      -- A case whose owner is unknown could belong to any layout.
      let candidates = match declaration_identity_owner(declaration) {
        nil -> semantic_layouts_below(variants.targets.len(), Nil<usize>())
        owner: DeclarationIdentity -> semantic_layout_key_candidates(
          index,
          Some(retained_declaration_identity_hash(owner))
        )
      }
      semantic_declared_variant_constructor_from(
        catalog,
        variants,
        declaration,
        candidates,
        SemanticDeclaredVariantConstructorMissing
      )
    }
  }
}

-- Whether a declared template applies no type arguments.
pub(package) fn semantic_type_template_unparameterized(
  types: borrow SemanticTypeCatalog,
  target: SemanticTypeId
) -> bool {
  match types.graph_for(target) {
    None -> false
    Some(graph) -> match semantic_type_graph_node(graph, target) {
      SemanticNamedNode(_, _, _, arguments) -> {
        let lists = semantic_type_graph_type_lists_local(graph)
        semantic_type_list_len(lists, arguments) == 0
      }
      _ -> false
    }
  }
}

pub(package) fn semantic_type_declared_unparameterized_variant_constructor(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticUnparameterizedVariantConstructor {
  match semantic_type_declared_variant_constructor(catalog, declaration) {
    SemanticDeclaredVariantConstructorMissing -> SemanticUnparameterizedVariantMissing
    SemanticDeclaredVariantConstructorAmbiguous -> SemanticUnparameterizedVariantAmbiguous
    SemanticDeclaredVariantConstructorSelected(target, layout_index, case_index, payload_count) ->
      if
      semantic_type_template_unparameterized(types, target) {
        SemanticUnparameterizedVariantSelected(target, layout_index, case_index, payload_count)
      } else { SemanticUnparameterizedVariantMissing }
  }
}
