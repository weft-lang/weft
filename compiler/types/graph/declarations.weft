-- Resolved type-declaration shapes over immutable semantic graphs.
--
-- A named semantic type retains declaration identity and arguments. Record
-- fields and variant cases belong to the declaration product, not to every
-- named type node. This catalog joins the two without exposing syntax or a
-- checker table; target placement and later checked passes consume the same
-- resolved shapes.
--
-- Every stored column is flat. A match returns only a scalar layout index and
-- its generic substitution; typed accessors expose one field or payload at a
-- time. The product therefore never nests aggregate declaration records or
-- lists inside another List.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{
  SemanticNamedNode,
  SemanticTypeId,
  semantic_type_graph_node,
  semantic_type_graph_type_lists_local,
  semantic_type_list_len
}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match_substituted
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty
}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_checked_add}
use stdlib/option.{None, Option, Some}

pub(package) type SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<SemanticTypeId>
  ),
  SemanticVariantDeclarationLayout(
    SemanticTypeId,
    List<DeclarationIdentity>,
    List<usize>,
    List<SemanticTypeId>
  )
}

type SemanticTypeDeclarationCatalogStorage {
  record_targets: List<SemanticTypeId>,
  record_field_counts: List<usize>,
  record_declarations: List<DeclarationIdentity>,
  record_types: List<SemanticTypeId>,
  variant_targets: List<SemanticTypeId>,
  variant_case_counts: List<usize>,
  variant_declarations: List<DeclarationIdentity>,
  variant_payload_counts: List<usize>,
  variant_payload_types: List<SemanticTypeId>
}

pub(package) type SemanticTypeDeclarationCatalog = opaque SemanticTypeDeclarationCatalogStorage

pub(package) type SemanticTypeDeclarationLayoutMatch {
  SemanticRecordDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticVariantDeclarationLayoutMatched(usize, SemanticTypeSubstitution),
  SemanticTypeDeclarationLayoutMissing
}

pub(package) type SemanticUnparameterizedVariantConstructor {
  SemanticUnparameterizedVariantMissing,
  SemanticUnparameterizedVariantSelected(SemanticTypeId, usize, usize, usize),
  SemanticUnparameterizedVariantAmbiguous
}

fn semantic_declarations_prepend(
  values: List<DeclarationIdentity>,
  suffix: List<DeclarationIdentity>
) -> List<DeclarationIdentity> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<DeclarationIdentity>(
      value,
      semantic_declarations_prepend(remaining, suffix)
    )
  }
}

fn semantic_types_prepend(
  values: List<SemanticTypeId>,
  suffix: List<SemanticTypeId>
) -> List<SemanticTypeId> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<SemanticTypeId>(
      value,
      semantic_types_prepend(remaining, suffix)
    )
  }
}

fn semantic_usizes_prepend(
  values: List<usize>,
  suffix: List<usize>
) -> List<usize> {
  match values {
    Nil -> suffix
    Cons(value, remaining) -> Cons<usize>(
      value,
      semantic_usizes_prepend(remaining, suffix)
    )
  }
}

fn semantic_declaration_at(
  values: List<DeclarationIdentity>,
  index: usize
) -> Option<DeclarationIdentity> {
  match values {
    Nil -> None<DeclarationIdentity>()
    Cons(value, remaining) -> if index == 0 { Some<DeclarationIdentity>(value) }
    else { semantic_declaration_at(remaining, index - 1) }
  }
}

fn semantic_type_at(
  values: List<SemanticTypeId>,
  index: usize
) -> Option<SemanticTypeId> {
  match values {
    Nil -> None<SemanticTypeId>()
    Cons(value, remaining) -> if index == 0 { Some<SemanticTypeId>(value) }
    else { semantic_type_at(remaining, index - 1) }
  }
}

fn semantic_usize_at(values: List<usize>, index: usize) -> Option<usize> {
  match values {
    Nil -> None<usize>()
    Cons(value, remaining) -> if index == 0 { Some<usize>(value) }
    else { semantic_usize_at(remaining, index - 1) }
  }
}

fn semantic_usize_prefix(
  values: List<usize>,
  count: usize,
  total: usize
) -> Option<usize> {
  if count == 0 { Some<usize>(total) }
  else {
    match values {
      Nil -> None<usize>()
      Cons(value, remaining) -> match num_scalar_usize_checked_add(total, value) {
        None -> None<usize>()
        Some(next) -> semantic_usize_prefix(remaining, count - 1, next)
      }
    }
  }
}

pub(package) fn semantic_type_declaration_catalog_empty(
) -> SemanticTypeDeclarationCatalog {
  SemanticTypeDeclarationCatalog(
    SemanticTypeDeclarationCatalogStorage {
      record_targets: Nil<SemanticTypeId>(),
      record_field_counts: Nil<usize>(),
      record_declarations: Nil<DeclarationIdentity>(),
      record_types: Nil<SemanticTypeId>(),
      variant_targets: Nil<SemanticTypeId>(),
      variant_case_counts: Nil<usize>(),
      variant_declarations: Nil<DeclarationIdentity>(),
      variant_payload_counts: Nil<usize>(),
      variant_payload_types: Nil<SemanticTypeId>()
    }
  )
}

pub(package) fn semantic_record_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticRecordDeclarationLayout(target, declarations, types)
}

pub(package) fn semantic_variant_declaration_layout(
  target: SemanticTypeId,
  declarations: List<DeclarationIdentity>,
  payload_counts: List<usize>,
  payload_types: List<SemanticTypeId>
) -> SemanticTypeDeclarationLayout {
  SemanticVariantDeclarationLayout(
    target,
    declarations,
    payload_counts,
    payload_types
  )
}

pub(package) fn semantic_type_declaration_catalog_add(
  catalog: SemanticTypeDeclarationCatalog,
  layout: SemanticTypeDeclarationLayout
) -> SemanticTypeDeclarationCatalog {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      let {
        record_targets,
          record_field_counts,
          record_declarations,
          record_types,
          variant_targets,
          variant_case_counts,
          variant_declarations,
          variant_payload_counts,
          variant_payload_types,
      } = storage
      match layout {
        SemanticRecordDeclarationLayout(target, declarations, types) ->
          SemanticTypeDeclarationCatalog(
            SemanticTypeDeclarationCatalogStorage {
              record_targets: record_targets.prepend(target),
              record_field_counts: record_field_counts.prepend(declarations.len()),
              record_declarations: semantic_declarations_prepend(
                declarations,
                record_declarations
              ),
              record_types: semantic_types_prepend(types, record_types),
              variant_targets: variant_targets,
              variant_case_counts: variant_case_counts,
              variant_declarations: variant_declarations,
              variant_payload_counts: variant_payload_counts,
              variant_payload_types: variant_payload_types
            }
          )
        SemanticVariantDeclarationLayout(
          target,
          declarations,
          payload_counts,
          payload_types,
        ) -> SemanticTypeDeclarationCatalog(
          SemanticTypeDeclarationCatalogStorage {
            record_targets: record_targets,
            record_field_counts: record_field_counts,
            record_declarations: record_declarations,
            record_types: record_types,
            variant_targets: variant_targets.prepend(target),
            variant_case_counts: variant_case_counts.prepend(declarations.len()),
            variant_declarations: semantic_declarations_prepend(
              declarations,
              variant_declarations
            ),
            variant_payload_counts: semantic_usizes_prepend(
              payload_counts,
              variant_payload_counts
            ),
            variant_payload_types: semantic_types_prepend(
              payload_types,
              variant_payload_types
            )
          }
        )
      }
    }
  }
}

fn semantic_type_declaration_resolve_from(
  types: borrow SemanticTypeCatalog,
  targets: List<SemanticTypeId>,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution,
  layout_index: usize,
  record: bool
) -> SemanticTypeDeclarationLayoutMatch {
  match targets {
    Nil -> SemanticTypeDeclarationLayoutMissing
    Cons(target, remaining) -> match semantic_type_pattern_match_substituted(
      types,
      target,
      semantic_type_substitution_empty(),
      concrete,
      concrete_substitution
    ) {
      SemanticTypePatternRejected -> semantic_type_declaration_resolve_from(
        types,
        remaining,
        concrete,
        concrete_substitution,
        layout_index + 1,
        record
      )
      SemanticTypePatternMatched(substitution) -> if record {
        SemanticRecordDeclarationLayoutMatched(layout_index, substitution)
      } else {
        SemanticVariantDeclarationLayoutMatched(layout_index, substitution)
      }
    }
  }
}

pub(package) fn semantic_type_declaration_catalog_resolve(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> SemanticTypeDeclarationLayoutMatch {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_declaration_resolve_from(
        types,
        storage.record_targets,
        concrete,
        concrete_substitution,
        0,
        true
      ) {
        SemanticTypeDeclarationLayoutMissing -> semantic_type_declaration_resolve_from(
          types,
          storage.variant_targets,
          concrete,
          concrete_substitution,
          0,
          false
        )
        matched -> matched
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) ->
      semantic_usize_at(storage.record_field_counts, layout_index)
  }
}

fn semantic_type_record_field_ordinal(
  counts: List<usize>,
  layout_index: usize,
  field_index: usize
) -> Option<usize> {
  match semantic_usize_prefix(counts, layout_index, 0) {
    None -> None<usize>()
    Some(start) -> num_scalar_usize_checked_add(start, field_index)
  }
}

pub(package) fn semantic_type_declared_record_field_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_record_field_ordinal(
        storage.record_field_counts,
        layout_index,
        field_index
      ) {
        None -> None<DeclarationIdentity>()
        Some(index) -> semantic_declaration_at(storage.record_declarations, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_record_field_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  field_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_record_field_ordinal(
        storage.record_field_counts,
        layout_index,
        field_index
      ) {
        None -> None<SemanticTypeId>()
        Some(index) -> semantic_type_at(storage.record_types, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_case_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) ->
      semantic_usize_at(storage.variant_case_counts, layout_index)
  }
}

fn semantic_type_variant_case_ordinal(
  counts: List<usize>,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  match semantic_usize_prefix(counts, layout_index, 0) {
    None -> None<usize>()
    Some(start) -> num_scalar_usize_checked_add(start, case_index)
  }
}

pub(package) fn semantic_type_declared_variant_case_declaration(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<DeclarationIdentity> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<DeclarationIdentity>()
        Some(index) -> semantic_declaration_at(storage.variant_declarations, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_count(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize
) -> Option<usize> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<usize>()
        Some(index) -> semantic_usize_at(storage.variant_payload_counts, index)
      }
    }
  }
}

pub(package) fn semantic_type_declared_variant_payload_type(
  catalog: borrow SemanticTypeDeclarationCatalog,
  layout_index: usize,
  case_index: usize,
  payload_index: usize
) -> Option<SemanticTypeId> {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> {
      match semantic_type_variant_case_ordinal(
        storage.variant_case_counts,
        layout_index,
        case_index
      ) {
        None -> None<SemanticTypeId>()
        Some(case_ordinal) -> match semantic_usize_prefix(
          storage.variant_payload_counts,
          case_ordinal,
          0
        ) {
          None -> None<SemanticTypeId>()
          Some(start) -> match num_scalar_usize_checked_add(start, payload_index) {
            None -> None<SemanticTypeId>()
            Some(index) -> semantic_type_at(storage.variant_payload_types, index)
          }
        }
      }
    }
  }
}

fn semantic_unparameterized_variant_case(
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  layout_index: usize,
  case_index: usize,
  case_count: usize
) -> Option<(usize, usize)> {
  if case_index >= case_count { None<(usize, usize)>() }
  else {
    match semantic_type_declared_variant_case_declaration(catalog, layout_index, case_index) {
      None -> None<(usize, usize)>()
      Some(candidate) -> if declaration_identity_eq(candidate, declaration) {
        match semantic_type_declared_variant_payload_count(catalog, layout_index, case_index) {
          None -> None<(usize, usize)>()
          Some(count) -> Some((case_index, count))
        }
      } else {
        semantic_unparameterized_variant_case(
          catalog,
          declaration,
          layout_index,
          case_index + 1,
          case_count
        )
      }
    }
  }
}

fn semantic_unparameterized_variant_from(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity,
  layout_index: usize,
  found: SemanticUnparameterizedVariantConstructor
) -> SemanticUnparameterizedVariantConstructor {
  match catalog {
    SemanticTypeDeclarationCatalog(storage) -> match semantic_type_at(
      storage.variant_targets,
      layout_index
    ) {
      None -> found
      Some(target) -> {
        let next = match types.graph_for(target) {
          None -> found
          Some(graph) -> match semantic_type_graph_node(graph, target) {
            SemanticNamedNode(_, _, _, arguments) -> {
              let lists = semantic_type_graph_type_lists_local(graph)
              if semantic_type_list_len(lists, arguments) != 0 { found }
              else {
                match semantic_type_declared_variant_case_count(catalog, layout_index) {
                  None -> found
                  Some(case_count) -> match semantic_unparameterized_variant_case(
                    catalog,
                    declaration,
                    layout_index,
                    0,
                    case_count
                  ) {
                    None -> found
                    Some((case_index, payload_count)) -> match found {
                      SemanticUnparameterizedVariantMissing ->
                        SemanticUnparameterizedVariantSelected(
                          target,
                          layout_index,
                          case_index,
                          payload_count
                        )
                      _ -> SemanticUnparameterizedVariantAmbiguous
                    }
                  }
                }
              }
            }
            _ -> found
          }
        }
        semantic_unparameterized_variant_from(
          types,
          catalog,
          declaration,
          layout_index + 1,
          next
        )
      }
    }
  }
}

pub(package) fn semantic_type_declared_unparameterized_variant_constructor(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticTypeDeclarationCatalog,
  declaration: DeclarationIdentity
) -> SemanticUnparameterizedVariantConstructor {
  semantic_unparameterized_variant_from(
    types,
    catalog,
    declaration,
    0,
    SemanticUnparameterizedVariantMissing
  )
}
