-- Immutable graph-native trait-conformance evidence.
--
-- Evidence is resolved during declaration checking: an implementation target
-- pattern, the complete offered trait atom (including associated results), and
-- its conditional parameter requirements. Assumptions carry exact structural
-- facts such as generic bounds and sealed Sendable decisions. Querying uses
-- only semantic graph ids and the segment catalog.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/conformance.{SemanticConformance}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/types/graph/pattern.{
  SemanticTypePatternMatched,
  SemanticTypePatternRejected,
  semantic_type_pattern_match,
  semantic_type_pattern_match_substituted
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_empty,
  semantic_type_substitution_get,
  semantic_type_substitution_copy
}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type SemanticConformanceRequirement {
  variable: SemanticTypeVariable,
  trait_atom: SemanticTypeId
}

pub(package) type SemanticConformanceEvidence {
  target: SemanticTypeId,
  trait_atom: SemanticTypeId,
  requirements: List<SemanticConformanceRequirement>
}

pub(package) type SemanticConformanceAssumption {
  concrete: SemanticTypeId,
  trait_atom: SemanticTypeId
}

pub(package) type SemanticConformanceCatalog {
  evidence: List<SemanticConformanceEvidence>,
  assumptions: List<SemanticConformanceAssumption>
}

pub(package) fn semantic_conformance_catalog_empty() -> SemanticConformanceCatalog {
  SemanticConformanceCatalog {
    evidence: Nil<SemanticConformanceEvidence>(),
    assumptions: Nil<SemanticConformanceAssumption>()
  }
}

pub(package) fn semantic_conformance_requirement(
  variable: SemanticTypeVariable,
  trait_atom: SemanticTypeId
) -> SemanticConformanceRequirement {
  SemanticConformanceRequirement {
    variable: variable,
    trait_atom: trait_atom
  }
}

pub(package) fn semantic_conformance_evidence(
  target: SemanticTypeId,
  trait_atom: SemanticTypeId,
  requirements: List<SemanticConformanceRequirement>
) -> SemanticConformanceEvidence {
  SemanticConformanceEvidence {
    target: target,
    trait_atom: trait_atom,
    requirements: requirements
  }
}

pub(package) fn semantic_conformance_assumption(
  concrete: SemanticTypeId,
  trait_atom: SemanticTypeId
) -> SemanticConformanceAssumption {
  SemanticConformanceAssumption {
    concrete: concrete,
    trait_atom: trait_atom
  }
}

pub(package) fn semantic_conformance_catalog_add_evidence(
  catalog: SemanticConformanceCatalog,
  evidence: SemanticConformanceEvidence
) -> SemanticConformanceCatalog {
  SemanticConformanceCatalog {
    evidence: catalog.evidence.prepend(evidence),
    assumptions: catalog.assumptions
  }
}

pub(package) fn semantic_conformance_catalog_add_assumption(
  catalog: SemanticConformanceCatalog,
  assumption: SemanticConformanceAssumption
) -> SemanticConformanceCatalog {
  SemanticConformanceCatalog {
    evidence: catalog.evidence,
    assumptions: catalog.assumptions.prepend(assumption)
  }
}

fn semantic_conformance_required_graph(
  types: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match types.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic conformance id is outside its segment") }
    None -> panic("Semantic conformance catalog is missing a type segment")
  }
}

fn semantic_conformance_trait_parts(
  types: borrow SemanticTypeCatalog,
  trait_atom: SemanticTypeId
) -> (SemanticTypeGraph, DeclarationIdentity, SemanticTraitBindingListId) {
  let graph = semantic_conformance_required_graph(types, trait_atom)
  match semantic_type_graph_node(graph, trait_atom) {
    SemanticTraitNode(declaration, bindings) -> (graph, declaration, bindings)
    _ -> panic("Semantic conformance query requires a trait atom")
  }
}

fn semantic_conformance_binding_matches_from(
  types: borrow SemanticTypeCatalog,
  offered_graph: borrow SemanticTypeGraph,
  offered_bindings: SemanticTraitBindingListId,
  offered_substitution: SemanticTypeSubstitution,
  requested_graph: borrow SemanticTypeGraph,
  requested_edge: SemanticTraitBindingEdge,
  requested_substitution: borrow SemanticTypeSubstitution,
  offset: usize
) -> bool {
  let offered_traits = semantic_type_graph_traits_local(offered_graph)
  if offset >= semantic_type_trait_binding_count(offered_traits, offered_bindings) {
    false
  } else {
    let offered_edge = semantic_type_trait_binding_edge(
      offered_traits,
      offered_bindings,
      offset
    )
    if declaration_identity_eq(
      semantic_type_graph_trait_binding_declaration(offered_graph, offered_edge),
      semantic_type_graph_trait_binding_declaration(requested_graph, requested_edge)
    ) {
      let offered_type = semantic_type_graph_trait_binding_type_id(
        offered_graph,
        offered_edge
      )
      let requested_type = semantic_type_graph_trait_binding_type_id(
        requested_graph,
        requested_edge
      )
      match semantic_type_pattern_match_substituted(
        types,
        offered_type,
        offered_substitution,
        requested_type,
        requested_substitution
      ) {
        SemanticTypePatternRejected -> false
        SemanticTypePatternMatched(_) -> {
          match semantic_type_pattern_match_substituted(
            types,
            requested_type,
            semantic_type_substitution_copy(requested_substitution),
            offered_type,
            offered_substitution
          ) {
            SemanticTypePatternMatched(_) -> true
            SemanticTypePatternRejected -> false
          }
        }
      }
    } else {
      semantic_conformance_binding_matches_from(
        types,
        offered_graph,
        offered_bindings,
        offered_substitution,
        requested_graph,
        requested_edge,
        requested_substitution,
        offset + 1
      )
    }
  }
}

fn semantic_conformance_bindings_hold_from(
  types: borrow SemanticTypeCatalog,
  offered_graph: borrow SemanticTypeGraph,
  offered_bindings: SemanticTraitBindingListId,
  offered_substitution: SemanticTypeSubstitution,
  requested_graph: borrow SemanticTypeGraph,
  requested_bindings: SemanticTraitBindingListId,
  requested_substitution: borrow SemanticTypeSubstitution,
  offset: usize
) -> bool {
  let requested_traits = semantic_type_graph_traits_local(requested_graph)
  if offset >= semantic_type_trait_binding_count(requested_traits, requested_bindings) {
    true
  } else {
    semantic_conformance_binding_matches_from(
      types,
      offered_graph,
      offered_bindings,
      offered_substitution,
      requested_graph,
      semantic_type_trait_binding_edge(
        requested_traits,
        requested_bindings,
        offset
      ),
      requested_substitution,
      __i64_to_usize(0)
    ) and semantic_conformance_bindings_hold_from(
      types,
      offered_graph,
      offered_bindings,
      offered_substitution,
      requested_graph,
      requested_bindings,
      requested_substitution,
      offset + 1
    )
  }
}

fn semantic_conformance_trait_satisfies(
  types: borrow SemanticTypeCatalog,
  offered: SemanticTypeId,
  offered_substitution: SemanticTypeSubstitution,
  requested: SemanticTypeId,
  requested_substitution: borrow SemanticTypeSubstitution
) -> bool {
  let (
    offered_graph,
    offered_declaration,
    offered_bindings,
  ) = semantic_conformance_trait_parts(types, offered)
  let (
    requested_graph,
    requested_declaration,
    requested_bindings,
  ) = semantic_conformance_trait_parts(types, requested)
  declaration_identity_eq(offered_declaration, requested_declaration) and
    semantic_conformance_bindings_hold_from(
      types,
      offered_graph,
      offered_bindings,
      offered_substitution,
      requested_graph,
      requested_bindings,
      requested_substitution,
      __i64_to_usize(0)
    )
}

fn semantic_conformance_assumptions_hold(
  types: borrow SemanticTypeCatalog,
  assumptions: List<SemanticConformanceAssumption>,
  concrete: SemanticTypeId,
  requested: SemanticTypeId,
  requested_substitution: borrow SemanticTypeSubstitution
) -> bool {
  match assumptions {
    Nil -> false
    Cons(assumption, remaining) -> {
      if semantic_type_catalog_equal(types, assumption.concrete, concrete) {
        semantic_conformance_trait_satisfies(
          types,
          assumption.trait_atom,
          semantic_type_substitution_empty(),
          requested,
          requested_substitution
        ) or semantic_conformance_assumptions_hold(
          types,
          remaining,
          concrete,
          requested,
          requested_substitution
        )
      } else {
        semantic_conformance_assumptions_hold(
          types,
          remaining,
          concrete,
          requested,
          requested_substitution
        )
      }
    }
  }
}

fn semantic_conformance_query(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticConformanceCatalog,
  concrete: SemanticTypeId,
  requested: SemanticTypeId,
  requested_substitution: borrow SemanticTypeSubstitution,
  remaining_depth: usize
) -> bool {
  if remaining_depth == 0 { false }
  else {
    if semantic_conformance_assumptions_hold(
      types,
      catalog.assumptions,
      concrete,
      requested,
      requested_substitution
    ) { true }
    else {
      semantic_conformance_evidence_hold(
        types,
        catalog,
        catalog.evidence,
        concrete,
        requested,
        requested_substitution,
        remaining_depth
      )
    }
  }
}

fn semantic_conformance_requirements_hold(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticConformanceCatalog,
  requirements: List<SemanticConformanceRequirement>,
  substitution: borrow SemanticTypeSubstitution,
  remaining_depth: usize
) -> bool {
  match requirements {
    Nil -> true
    Cons(requirement, remaining) -> match semantic_type_substitution_get(
      substitution,
      requirement.variable
    ) {
      None -> false
      Some(concrete) -> semantic_conformance_query(
        types,
        catalog,
        concrete,
        requirement.trait_atom,
        substitution,
        remaining_depth - 1
      ) and semantic_conformance_requirements_hold(
        types,
        catalog,
        remaining,
        substitution,
        remaining_depth
      )
    }
  }
}

fn semantic_conformance_evidence_hold(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticConformanceCatalog,
  evidence: List<SemanticConformanceEvidence>,
  concrete: SemanticTypeId,
  requested: SemanticTypeId,
  requested_substitution: borrow SemanticTypeSubstitution,
  remaining_depth: usize
) -> bool {
  match evidence {
    Nil -> false
    Cons(candidate, remaining) -> match semantic_type_pattern_match(
      types,
      candidate.target,
      concrete
    ) {
      SemanticTypePatternRejected -> semantic_conformance_evidence_hold(
        types,
        catalog,
        remaining,
        concrete,
        requested,
        requested_substitution,
        remaining_depth
      )
      SemanticTypePatternMatched(substitution) -> {
        if semantic_conformance_trait_satisfies(
          types,
          candidate.trait_atom,
          substitution,
          requested,
          requested_substitution
        ) and semantic_conformance_requirements_hold(
          types,
          catalog,
          candidate.requirements,
          substitution,
          remaining_depth
        ) { true }
        else {
          semantic_conformance_evidence_hold(
            types,
            catalog,
            remaining,
            concrete,
            requested,
            requested_substitution,
            remaining_depth
          )
        }
      }
    }
  }
}

pub(package) fn semantic_conformance_catalog_conforms(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticConformanceCatalog,
  concrete: SemanticTypeId,
  trait_atom: SemanticTypeId
) -> bool {
  let depth = catalog.evidence.len() + catalog.assumptions.len() + 1
  let substitution = semantic_type_substitution_empty()
  semantic_conformance_query(
    types,
    catalog,
    concrete,
    trait_atom,
    substitution,
    depth
  )
}

pub(package) fn run<R, E>(
  types: borrow SemanticTypeCatalog,
  catalog: borrow SemanticConformanceCatalog,
  body: (borrow SemanticTypeCatalog) -[SemanticConformance, E]> R
) -[E]> R {
  handle body(types) {
    SemanticConformance.conforms(concrete, trait_atom) -> resume(
      semantic_conformance_catalog_conforms(
        types,
        catalog,
        concrete,
        trait_atom
      )
    )
  }
}
