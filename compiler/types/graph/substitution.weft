-- Generic substitution over immutable semantic-type graphs.
--
-- Unchanged subgraphs remain shared through their original complete ids.
-- Changed paths are first written to a private provisional segment. A second
-- catalogued pass publishes them into the result segment and canonicalises
-- effect sets after every substituted atom is structurally comparable. This
-- preserves the kernel rule that effect sets never contain duplicate atoms.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{*}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

pub(package) type SemanticTypeSubstitution {
  variable_self: List<bool>,
  variable_ids: List<usize>,
  values: List<SemanticTypeId>,
  associated_variable_self: List<bool>,
  associated_variable_ids: List<usize>,
  associated_declarations: List<DeclarationIdentity>,
  associated_values: List<SemanticTypeId>
}

pub(package) type SemanticTypeSubstitutionProduct {
  graph: SemanticTypeGraph,
  root: SemanticTypeId
}

type SemanticSubstitutionMode {
  SemanticSubstitute,
  SemanticCanonicalize(SemanticTypeSegmentId)
}

pub(package) fn semantic_type_substitution_empty() -> SemanticTypeSubstitution {
  SemanticTypeSubstitution {
    variable_self: Nil<bool>(),
    variable_ids: Nil<usize>(),
    values: Nil<SemanticTypeId>(),
    associated_variable_self: Nil<bool>(),
    associated_variable_ids: Nil<usize>(),
    associated_declarations: Nil<DeclarationIdentity>(),
    associated_values: Nil<SemanticTypeId>()
  }
}

pub(package) fn semantic_type_substitution_copy(
  substitution: borrow SemanticTypeSubstitution
) -> SemanticTypeSubstitution {
  let {
    variable_self,
      variable_ids,
      values,
      associated_variable_self,
      associated_variable_ids,
      associated_declarations,
      associated_values,
  } = substitution
  SemanticTypeSubstitution {
    variable_self: variable_self,
    variable_ids: variable_ids,
    values: values,
    associated_variable_self: associated_variable_self,
    associated_variable_ids: associated_variable_ids,
    associated_declarations: associated_declarations,
    associated_values: associated_values
  }
}

pub(package) fn semantic_type_substitution_bind(
  substitution: SemanticTypeSubstitution,
  variable: SemanticTypeVariable,
  value: SemanticTypeId
) -> SemanticTypeSubstitution {
  let {
    variable_self,
      variable_ids,
      values,
      associated_variable_self,
      associated_variable_ids,
      associated_declarations,
      associated_values,
  } = substitution
  let is_self = match variable {
    SemanticSelfVariable -> true
    SemanticParameterVariable(_) -> false
  }
  let variable_id = match variable {
    SemanticSelfVariable -> __i64_to_usize(0)
    SemanticParameterVariable(id) -> id
  }
  SemanticTypeSubstitution {
    variable_self: variable_self.append(is_self),
    variable_ids: variable_ids.append(variable_id),
    values: values.append(value),
    associated_variable_self: associated_variable_self,
    associated_variable_ids: associated_variable_ids,
    associated_declarations: associated_declarations,
    associated_values: associated_values
  }
}

pub(package) fn semantic_type_substitution_bind_associated(
  substitution: SemanticTypeSubstitution,
  variable: SemanticTypeVariable,
  declaration: DeclarationIdentity,
  value: SemanticTypeId
) -> SemanticTypeSubstitution {
  let {
    variable_self,
      variable_ids,
      values,
      associated_variable_self,
      associated_variable_ids,
      associated_declarations,
      associated_values,
  } = substitution
  let is_self = match variable {
    SemanticSelfVariable -> true
    SemanticParameterVariable(_) -> false
  }
  let variable_id = match variable {
    SemanticSelfVariable -> __i64_to_usize(0)
    SemanticParameterVariable(id) -> id
  }
  SemanticTypeSubstitution {
    variable_self: variable_self,
    variable_ids: variable_ids,
    values: values,
    associated_variable_self: associated_variable_self.append(is_self),
    associated_variable_ids: associated_variable_ids.append(variable_id),
    associated_declarations: associated_declarations.append(declaration),
    associated_values: associated_values.append(value)
  }
}

fn semantic_substitution_variable_is_self(variable: SemanticTypeVariable) -> bool {
  match variable {
    SemanticSelfVariable -> true
    SemanticParameterVariable(_) -> false
  }
}

fn semantic_substitution_variable_id(variable: SemanticTypeVariable) -> usize {
  match variable {
    SemanticSelfVariable -> __i64_to_usize(0)
    SemanticParameterVariable(id) -> id
  }
}

fn semantic_type_substitution_lookup_from(
  self_flags: List<bool>,
  ids: List<usize>,
  values: List<SemanticTypeId>,
  wanted: SemanticTypeVariable
) -> Option<SemanticTypeId> {
  match (self_flags, ids, values) {
    (
      Cons(is_self, remaining_self),
      Cons(id, remaining_ids),
      Cons(value, remaining_values),
    ) -> {
      if is_self == semantic_substitution_variable_is_self(wanted) and
        id == semantic_substitution_variable_id(wanted) {
          Some<SemanticTypeId>(value)
        } else {
          semantic_type_substitution_lookup_from(
            remaining_self,
            remaining_ids,
            remaining_values,
            wanted
          )
        }
    }
    _ -> None<SemanticTypeId>()
  }
}

fn semantic_type_substitution_lookup(
  substitution: borrow SemanticTypeSubstitution,
  wanted: SemanticTypeVariable
) -> Option<SemanticTypeId> {
  let { variable_self, variable_ids, values } = substitution
  semantic_type_substitution_lookup_from(
    variable_self,
    variable_ids,
    values,
    wanted
  )
}

pub(package) fn semantic_type_substitution_get(
  substitution: borrow SemanticTypeSubstitution,
  wanted: SemanticTypeVariable
) -> Option<SemanticTypeId> {
  semantic_type_substitution_lookup(substitution, wanted)
}

pub(package) fn semantic_type_substitution_len(
  substitution: borrow SemanticTypeSubstitution
) -> usize {
  let { variable_ids } = substitution
  variable_ids.len()
}

fn semantic_type_substitution_lookup_associated_from(
  self_flags: List<bool>,
  ids: List<usize>,
  declarations: List<DeclarationIdentity>,
  values: List<SemanticTypeId>,
  wanted_variable: SemanticTypeVariable,
  wanted_declaration: DeclarationIdentity
) -> Option<SemanticTypeId> {
  match (self_flags, ids, declarations, values) {
    (
      Cons(is_self, remaining_self),
      Cons(id, remaining_ids),
      Cons(declaration, remaining_declarations),
      Cons(value, remaining_values),
    ) -> {
      if is_self == semantic_substitution_variable_is_self(wanted_variable) and
        id == semantic_substitution_variable_id(wanted_variable) and
        declaration_identity_eq(declaration, wanted_declaration) {
          Some<SemanticTypeId>(value)
        } else {
          semantic_type_substitution_lookup_associated_from(
            remaining_self,
            remaining_ids,
            remaining_declarations,
            remaining_values,
            wanted_variable,
            wanted_declaration
          )
        }
    }
    _ -> None<SemanticTypeId>()
  }
}

fn semantic_type_substitution_lookup_associated(
  substitution: borrow SemanticTypeSubstitution,
  variable: SemanticTypeVariable,
  declaration: DeclarationIdentity
) -> Option<SemanticTypeId> {
  let {
    associated_variable_self,
      associated_variable_ids,
      associated_declarations,
      associated_values,
  } = substitution
  semantic_type_substitution_lookup_associated_from(
    associated_variable_self,
    associated_variable_ids,
    associated_declarations,
    associated_values,
    variable,
    declaration
  )
}

fn semantic_substitution_required_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic substitution id is outside its segment") }
    None -> panic("Semantic substitution catalog is missing a segment")
  }
}

fn semantic_substitution_forces(
  mode: SemanticSubstitutionMode,
  id: SemanticTypeId
) -> bool {
  match mode {
    SemanticSubstitute -> false
    SemanticCanonicalize(segment) -> semantic_type_segment_id_eq(
      semantic_type_id_segment(id),
      segment
    )
  }
}

fn semantic_type_list_contains_equal(
  catalog: borrow SemanticTypeCatalog,
  values: List<SemanticTypeId>,
  wanted: SemanticTypeId
) -> bool {
  match values {
    Nil -> false
    Cons(value, rest) -> semantic_type_catalog_equal(
      catalog,
      value,
      wanted
    ) or semantic_type_list_contains_equal(catalog, rest, wanted)
  }
}

fn semantic_substitute_type_list_from(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  offset: usize,
  seen: List<SemanticTypeId>,
  reversed: List<SemanticTypeId>,
  changed: bool,
  unique: bool
) -> (owned SemanticTypeGraphBuilder, List<SemanticTypeId>, bool) {
  let lists = semantic_type_graph_type_lists_local(graph)
  let length = semantic_type_list_len(lists, list)
  if offset >= length { (builder, reversed.reverse(), changed) }
  else {
    let source = semantic_type_graph_list_type_id(
      graph,
      semantic_type_list_edge(lists, list, offset)
    )
    if unique and semantic_type_list_contains_equal(catalog, seen, source) {
      semantic_substitute_type_list_from(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        list,
        offset + 1,
        seen,
        reversed,
        true,
        unique
      )
    } else {
      match semantic_substitute_type(
        catalog,
        builder,
        substitution,
        mode,
        source
      ) {
        (next, value, item_changed) -> semantic_substitute_type_list_from(
          catalog,
          next,
          substitution,
          mode,
          graph,
          list,
          offset + 1,
          Cons<SemanticTypeId>(source, seen),
          Cons<SemanticTypeId>(value, reversed),
          changed or item_changed,
          unique
        )
      }
    }
  }
}

fn semantic_substitute_type_list(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  list: SemanticTypeListId,
  unique: bool
) -> (owned SemanticTypeGraphBuilder, List<SemanticTypeId>, bool) {
  semantic_substitute_type_list_from(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    list,
    __i64_to_usize(0),
    Nil<SemanticTypeId>(),
    Nil<SemanticTypeId>(),
    false,
    unique
  )
}

fn semantic_substitute_unary(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  source: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let graph = semantic_substitution_required_graph(catalog, source)
  match semantic_type_graph_unary(graph, source) {
    SemanticUnaryTypePresent(inner) -> match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      inner
    ) {
      (next, value, changed) -> {
        if not changed and not semantic_substitution_forces(mode, source) {
          (next, source, false)
        } else {
          match kind {
            SemanticComplementKind -> match next.complement(value) {
              (result, id) -> (result, id, true)
            }
            SemanticWeakKind -> match next.weak(value) {
              (result, id) -> (result, id, true)
            }
            SemanticRcKind -> match next.rc(value) {
              (result, id) -> (result, id, true)
            }
            SemanticAtomicKind -> match next.atomic(value) {
              (result, id) -> (result, id, true)
            }
            SemanticUniqueKind -> match next.unique(value) {
              (result, id) -> (result, id, true)
            }
            SemanticOwnedKind -> match next.owned(value) {
              (result, id) -> (result, id, true)
            }
            _ -> panic("Semantic substitution expected a unary type")
          }
        }
      }
    }
    SemanticUnaryTypeAbsent -> panic("Semantic substitution lost a unary child")
  }
}

fn semantic_substitute_binary(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  source: SemanticTypeId,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let graph = semantic_substitution_required_graph(catalog, source)
  match semantic_type_graph_binary(graph, source) {
    SemanticBinaryTypePresent(left, right) -> match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      left
    ) {
      (next, substituted_left, left_changed) -> match semantic_substitute_type(
        catalog,
        next,
        substitution,
        mode,
        right
      ) {
        (next, substituted_right, right_changed) -> {
          if not left_changed and not right_changed and
            not semantic_substitution_forces(mode, source) {
              (next, source, false)
            } else {
              match kind {
                SemanticUnionKind -> match next.union(
                  substituted_left,
                  substituted_right
                ) {
                  (result, id) -> (result, id, true)
                }
                SemanticIntersectionKind -> match next.intersection(
                  substituted_left,
                  substituted_right
                ) {
                  (result, id) -> (result, id, true)
                }
                SemanticContinuationKind -> match next.continuation(
                  substituted_left,
                  substituted_right
                ) {
                  (result, id) -> (result, id, true)
                }
                _ -> panic("Semantic substitution expected a binary type")
              }
            }
        }
      }
    }
    SemanticBinaryTypeAbsent -> panic("Semantic substitution lost binary children")
  }
}

fn semantic_substitute_mutable_unary(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  source: SemanticTypeId,
  inner: SemanticTypeId,
  mutability: SemanticMutability,
  kind: SemanticTypeKind
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  match semantic_substitute_type(
    catalog,
    builder,
    substitution,
    mode,
    inner
  ) {
    (next, value, changed) -> {
      if not changed and not semantic_substitution_forces(mode, source) {
        (next, source, false)
      } else {
        match kind {
          SemanticPointerKind -> match next.pointer(value, mutability) {
            (result, id) -> (result, id, true)
          }
          SemanticBorrowKind -> match next.borrow(value, mutability) {
            (result, id) -> (result, id, true)
          }
          SemanticSliceKind -> match next.slice(value, mutability) {
            (result, id) -> (result, id, true)
          }
          _ -> panic("Semantic substitution expected a mutable unary type")
        }
      }
    }
  }
}

fn semantic_substitute_function(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  parameters: SemanticTypeListId,
  result: SemanticTypeId,
  effects: SemanticTypeId
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  match semantic_substitute_type_list(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    parameters,
    false
  ) {
    (next, parameter_values, parameters_changed) -> match semantic_substitute_type(
      catalog,
      next,
      substitution,
      mode,
      result
    ) {
      (next, result_value, result_changed) -> match semantic_substitute_type(
        catalog,
        next,
        substitution,
        mode,
        effects
      ) {
        (next, effect_value, effects_changed) -> {
          if not parameters_changed and not result_changed and
            not effects_changed and not semantic_substitution_forces(mode, source) {
              (next, source, false)
            } else {
              match next.type_list(parameter_values) {
                (next, parameter_list) -> match next.function(
                  parameter_list,
                  result_value,
                  effect_value
                ) {
                  (result_builder, id) -> (result_builder, id, true)
                }
              }
            }
        }
      }
    }
  }
}

fn semantic_substitute_effect_atom(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  declaration: DeclarationIdentity,
  arguments: SemanticTypeListId
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  match semantic_substitute_type_list(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    arguments,
    false
  ) {
    (next, values, changed) -> {
      if not changed and not semantic_substitution_forces(mode, source) {
        (next, source, false)
      } else {
        match next.type_list(values) {
          (next, list) -> match next.effect_atom(declaration, list) {
            (result, id) -> (result, id, true)
          }
        }
      }
    }
  }
}

fn semantic_effect_tail_binding(
  substitution: borrow SemanticTypeSubstitution,
  tail: SemanticEffectTail
) -> Option<SemanticTypeId> {
  match tail {
    SemanticClosedEffects -> None<SemanticTypeId>()
    SemanticOpenEffects(id) -> semantic_type_substitution_lookup(
      substitution,
      SemanticParameterVariable(id)
    )
  }
}

fn semantic_substitute_effect_signature(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  effects: SemanticTypeListId,
  tail: SemanticEffectTail
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let unique = match mode {
    SemanticSubstitute -> false
    SemanticCanonicalize(_) -> true
  }
  match semantic_substitute_type_list(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    effects,
    unique
  ) {
    (next, explicit_values, effects_changed) -> match semantic_effect_tail_binding(
      substitution,
      tail
    ) {
      None -> {
        if not effects_changed and not semantic_substitution_forces(mode, source) {
          (next, source, false)
        } else {
          match next.type_list(explicit_values) {
            (next, effect_list) -> match next.effect_signature(effect_list, tail) {
              (result, id) -> (result, id, true)
            }
          }
        }
      }
      Some(binding) -> {
        let binding_graph = semantic_substitution_required_graph(catalog, binding)
        match semantic_type_graph_node(binding_graph, binding) {
          SemanticVariableNode(SemanticParameterVariable(id)) -> match next.type_list(
            explicit_values
          ) {
            (next, effect_list) -> match next.effect_signature(
              effect_list,
              SemanticOpenEffects(id)
            ) {
              (result, id) -> (result, id, true)
            }
          }
          SemanticEffectSignatureNode(binding_effects, binding_tail) ->
            match semantic_substitute_type_list(
              catalog,
              next,
              substitution,
              mode,
              binding_graph,
              binding_effects,
              false
            ) {
              (next, binding_values, _) -> match next.type_list(
                explicit_values.concat(binding_values)
              ) {
                (next, effect_list) -> match next.effect_signature(
                  effect_list,
                  binding_tail
                ) {
                  (result, id) -> (result, id, true)
                }
              }
            }
          _ -> {
            if not effects_changed and not semantic_substitution_forces(mode, source) {
              (next, source, false)
            } else {
              match next.type_list(explicit_values) {
                (next, effect_list) -> match next.effect_signature(effect_list, tail) {
                  (result, id) -> (result, id, true)
                }
              }
            }
          }
        }
      }
    }
  }
}

fn semantic_substitute_named(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  declaration: DeclarationIdentity,
  role: SemanticNamedRole,
  representation: SemanticTypeId,
  arguments: SemanticTypeListId
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  match semantic_substitute_type(
    catalog,
    builder,
    substitution,
    mode,
    representation
  ) {
    (next, representation_value, representation_changed) -> match semantic_substitute_type_list(
      catalog,
      next,
      substitution,
      mode,
      graph,
      arguments,
      false
    ) {
      (next, argument_values, arguments_changed) -> {
        if not representation_changed and not arguments_changed and
          not semantic_substitution_forces(mode, source) {
            (next, source, false)
          } else {
            match next.type_list(argument_values) {
              (next, argument_list) -> match next.named(
                declaration,
                role,
                representation_value,
                argument_list
              ) {
                (result, id) -> (result, id, true)
              }
            }
          }
      }
    }
  }
}

fn semantic_substitute_record_fields_from(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  records: borrow SemanticRecordLocalGraph,
  fields: SemanticRecordFieldListId,
  offset: usize,
  names: List<str>,
  values: List<SemanticTypeId>,
  changed: bool
) -> (owned SemanticTypeGraphBuilder, List<str>, List<SemanticTypeId>, bool) {
  let length = semantic_type_record_field_count(records, fields)
  if offset >= length { (builder, names.reverse(), values.reverse(), changed) }
  else {
    let edge = semantic_type_record_field_edge(records, fields, offset)
    let source_type = semantic_type_graph_record_field_type_id(graph, edge)
    match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      source_type
    ) {
      (next, value, item_changed) -> {
        let name = match semantic_type_graph_record_field_name(graph, edge) {
          SemanticNamedRecordField(value) -> value
          SemanticTupleRecordField(_) -> ""
        }
        semantic_substitute_record_fields_from(
          catalog,
          next,
          substitution,
          mode,
          graph,
          records,
          fields,
          offset + 1,
          Cons<str>(name, names),
          Cons<SemanticTypeId>(value, values),
          changed or item_changed
        )
      }
    }
  }
}

fn semantic_substitute_record(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  fields: SemanticRecordFieldListId,
  shape: SemanticRecordShape,
  openness: SemanticRecordOpenness
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let records = semantic_type_graph_records_local(graph)
  match semantic_substitute_record_fields_from(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    records,
    fields,
    __i64_to_usize(0),
    Nil<str>(),
    Nil<SemanticTypeId>(),
    false
  ) {
    (next, names, values, changed) -> {
      if not changed and not semantic_substitution_forces(mode, source) {
        (next, source, false)
      } else {
        match shape {
          SemanticStructuralRecord -> match next.record(names, values, openness) {
            (result, id) -> (result, id, true)
          }
          SemanticTupleRecord -> match next.tuple(values) {
            (result, id) -> (result, id, true)
          }
        }
      }
    }
  }
}

fn semantic_substitute_associated(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  source: SemanticTypeId,
  base: SemanticTypeId,
  declaration: DeclarationIdentity
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let base_graph = semantic_substitution_required_graph(catalog, base)
  let binding = match semantic_type_graph_node(base_graph, base) {
    SemanticVariableNode(variable) -> semantic_type_substitution_lookup_associated(
      substitution,
      variable,
      declaration
    )
    _ -> None<SemanticTypeId>()
  }
  match binding {
    Some(value) -> match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      value
    ) {
      (next, result, _) -> (next, result, true)
    }
    None -> match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      base
    ) {
      (next, value, changed) -> {
        if not changed and not semantic_substitution_forces(mode, source) {
          (next, source, false)
        } else {
          match next.associated(value, declaration) {
            (result, id) -> (result, id, true)
          }
        }
      }
    }
  }
}

fn semantic_substitute_trait_bindings_from(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  traits: borrow SemanticTraitLocalGraph,
  bindings: SemanticTraitBindingListId,
  offset: usize,
  declarations: List<DeclarationIdentity>,
  values: List<SemanticTypeId>,
  changed: bool
) -> (
  owned SemanticTypeGraphBuilder,
  List<DeclarationIdentity>,
  List<SemanticTypeId>,
  bool
) {
  if offset >= semantic_type_trait_binding_count(traits, bindings) {
    (builder, declarations.reverse(), values.reverse(), changed)
  } else {
    let edge = semantic_type_trait_binding_edge(traits, bindings, offset)
    let source_type = semantic_type_graph_trait_binding_type_id(graph, edge)
    match semantic_substitute_type(
      catalog,
      builder,
      substitution,
      mode,
      source_type
    ) {
      (next, value, item_changed) -> semantic_substitute_trait_bindings_from(
        catalog,
        next,
        substitution,
        mode,
        graph,
        traits,
        bindings,
        offset + 1,
        Cons<DeclarationIdentity>(
          semantic_type_graph_trait_binding_declaration(graph, edge),
          declarations
        ),
        Cons<SemanticTypeId>(value, values),
        changed or item_changed
      )
    }
  }
}

fn semantic_substitute_trait(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  graph: borrow SemanticTypeGraph,
  source: SemanticTypeId,
  declaration: DeclarationIdentity,
  bindings: SemanticTraitBindingListId
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  let traits = semantic_type_graph_traits_local(graph)
  let binding_count = semantic_type_trait_binding_count(traits, bindings)
  match semantic_substitute_trait_bindings_from(
    catalog,
    builder,
    substitution,
    mode,
    graph,
    traits,
    bindings,
    __i64_to_usize(0),
    Nil<DeclarationIdentity>(),
    Nil<SemanticTypeId>(),
    false
  ) {
    (next, declarations, values, changed) -> {
      if not changed and not semantic_substitution_forces(mode, source) {
        (next, source, false)
      } else {
        if binding_count == 0 {
          match next.trait_atom(declaration) {
            (result, id) -> (result, id, true)
          }
        } else {
          match next.trait_constraint(declaration, declarations, values) {
            (result, id) -> (result, id, true)
          }
        }
      }
    }
  }
}

fn semantic_substitute_type(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeGraphBuilder,
  substitution: borrow SemanticTypeSubstitution,
  mode: SemanticSubstitutionMode,
  source: SemanticTypeId
) -> (owned SemanticTypeGraphBuilder, SemanticTypeId, bool) {
  if match mode {
    SemanticSubstitute -> false
    SemanticCanonicalize(segment) -> not semantic_type_segment_id_eq(
      semantic_type_id_segment(source),
      segment
    )
  } { (builder, source, false) }
  else {
    let graph = semantic_substitution_required_graph(catalog, source)
    let forced = semantic_substitution_forces(mode, source)
    match semantic_type_graph_node(graph, source) {
      SemanticBottomNode -> if forced {
        match builder.bottom() { (next, id) -> (next, id, true) }
      } else { (builder, source, false) }
      SemanticTopNode -> if forced {
        match builder.top() { (next, id) -> (next, id, true) }
      } else { (builder, source, false) }
      SemanticPrimitiveNode(primitive) -> if forced {
        match builder.primitive(primitive) { (next, id) -> (next, id, true) }
      } else { (builder, source, false) }
      SemanticUnionNode(_, _) -> semantic_substitute_binary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticUnionKind
      )
      SemanticIntersectionNode(_, _) -> semantic_substitute_binary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticIntersectionKind
      )
      SemanticComplementNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticComplementKind
      )
      SemanticContinuationNode(_, _) -> semantic_substitute_binary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticContinuationKind
      )
      SemanticWeakNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticWeakKind
      )
      SemanticRcNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticRcKind
      )
      SemanticAtomicNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticAtomicKind
      )
      SemanticUniqueNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticUniqueKind
      )
      SemanticOwnedNode(_) -> semantic_substitute_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        SemanticOwnedKind
      )
      SemanticPointerNode(inner, mutability) -> semantic_substitute_mutable_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        inner,
        mutability,
        SemanticPointerKind
      )
      SemanticBorrowNode(inner, mutability) -> semantic_substitute_mutable_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        inner,
        mutability,
        SemanticBorrowKind
      )
      SemanticSliceNode(inner, mutability) -> semantic_substitute_mutable_unary(
        catalog,
        builder,
        substitution,
        mode,
        source,
        inner,
        mutability,
        SemanticSliceKind
      )
      SemanticArrayNode(element, length) -> match semantic_substitute_type(
        catalog,
        builder,
        substitution,
        mode,
        element
      ) {
        (next, value, changed) -> {
          if not changed and not forced { (next, source, false) }
          else {
            match next.array(value, length) {
              (result, id) -> (result, id, true)
            }
          }
        }
      }
      SemanticFunctionNode(parameters, result, effects) -> semantic_substitute_function(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        source,
        parameters,
        result,
        effects
      )
      SemanticEffectAtomNode(declaration, arguments) -> semantic_substitute_effect_atom(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        source,
        declaration,
        arguments
      )
      SemanticEffectSignatureNode(effects, tail) -> semantic_substitute_effect_signature(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        source,
        effects,
        tail
      )
      SemanticNamedNode(declaration, role, representation, arguments) ->
        semantic_substitute_named(
          catalog,
          builder,
          substitution,
          mode,
          graph,
          source,
          declaration,
          role,
          representation,
          arguments
        )
      SemanticRecordNode(fields, shape, openness) -> semantic_substitute_record(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        source,
        fields,
        shape,
        openness
      )
      SemanticVariantNode(declaration, payload) -> match semantic_substitute_type(
        catalog,
        builder,
        substitution,
        mode,
        payload
      ) {
        (next, value, changed) -> {
          if not changed and not forced { (next, source, false) }
          else {
            match next.variant(declaration, value) {
              (result, id) -> (result, id, true)
            }
          }
        }
      }
      SemanticVariableNode(variable) -> match semantic_type_substitution_lookup(
        substitution,
        variable
      ) {
        Some(value) -> (builder, value, true)
        None -> if forced {
          match builder.variable(variable) { (next, id) -> (next, id, true) }
        } else { (builder, source, false) }
      }
      SemanticTraitNode(declaration, bindings) -> semantic_substitute_trait(
        catalog,
        builder,
        substitution,
        mode,
        graph,
        source,
        declaration,
        bindings
      )
      SemanticAssociatedNode(base, declaration) -> semantic_substitute_associated(
        catalog,
        builder,
        substitution,
        mode,
        source,
        base,
        declaration
      )
    }
  }
}

pub(package) fn semantic_type_substitute(
  catalog: borrow SemanticTypeCatalog,
  substitution: borrow SemanticTypeSubstitution,
  provisional_segment: SemanticTypeSegmentId,
  result_segment: SemanticTypeSegmentId,
  root: SemanticTypeId
) -> SemanticTypeSubstitutionProduct {
  if semantic_type_segment_id_eq(provisional_segment, result_segment) {
    panic("Semantic substitution segments must be distinct")
  } else { nil }
  if match catalog.segment(provisional_segment) { Some(_) -> true, None -> false } or
    match catalog.segment(result_segment) { Some(_) -> true, None -> false } {
      panic("Semantic substitution segment already exists in the catalog")
    } else { nil }

  let provisional_builder = semantic_type_graph_builder(provisional_segment)
  match semantic_substitute_type(
    catalog,
    provisional_builder,
    substitution,
    SemanticSubstitute,
    root
  ) {
    (provisional_builder, provisional_root, changed) -> {
      let provisional_graph = provisional_builder.freeze()
      if not changed {
        SemanticTypeSubstitutionProduct {
          graph: semantic_type_graph_builder(result_segment).freeze(),
          root: root
        }
      } else {
        let provisional_catalog = semantic_type_catalog_with_graph(
          catalog,
          provisional_graph
        )
        let empty = semantic_type_substitution_empty()
        let result_builder = semantic_type_graph_builder(result_segment)
        match semantic_substitute_type(
          provisional_catalog,
          result_builder,
          empty,
          SemanticCanonicalize(provisional_segment),
          provisional_root
        ) {
          (result_builder, result_root, _) -> SemanticTypeSubstitutionProduct {
            graph: result_builder.freeze(),
            root: result_root
          }
        }
      }
    }
  }
}
