-- Immutable lookup of semantic-type segments by retained module identity.
--
-- The catalog owns no global compiler state. Checked-program composition
-- supplies exactly the frozen segments in its closure. A scalar open-addressed
-- index selects a one-word segment handle; exact retained identity decides a
-- hash collision. Beside it, each owner's next free derived ordinal is kept
-- as segments arrive, so allocating a derived segment never walks the others.

use compiler/types/graph.{*}
use compiler/project/identity.{ModuleIdentity}
use compiler/project/identity/equality.{module_identity_eq}
use compiler/project/identity/hash.{retained_module_identity_hash}
use compiler/weft/check/storage.{
  DenseBuilder,
  DenseSegment,
  dense_builder_with_capacity,
  dense_index,
  dense_index_value
}
use stdlib/drop.{Drop}
use stdlib/list.{Cons, List, Nil}
use stdlib/map as map
use stdlib/map.{Map}
use stdlib/num/scalar.{num_scalar_usize_checked_add, num_scalar_usize_checked_mul}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

pub(package) type SemanticTypeCatalogContext {
  graph: SemanticTypeGraph,
  local: SemanticTypeLocalGraph,
  lists: SemanticTypeListLocalGraph,
  functions: SemanticFunctionLocalGraph,
  effects: SemanticEffectLocalGraph,
  named: SemanticNamedLocalGraph,
  records: SemanticRecordLocalGraph,
  variants: SemanticVariantLocalGraph,
  variables: SemanticVariableLocalGraph,
  traits: SemanticTraitLocalGraph,
  associated: SemanticAssociatedLocalGraph
}

pub(package) type SemanticTypeCatalogSegment {
  SemanticTypeCatalogSegmentValue(SemanticTypeCatalogContext)
}

-- One owner's next free derived ordinal.
type SemanticDerivedOrdinal {
  owner: ModuleIdentity,
  next: usize
}

-- Next free derived ordinals by the owner's retained hash; exact identity
-- decides a collision within a bucket.
type SemanticDerivedOrdinals = Map<i64, List<SemanticDerivedOrdinal>>

type SemanticTypeCatalogStorage {
  segments: DenseSegment<SemanticTypeCatalogSegment>,
  slots: DenseSegment<usize>,
  mask: usize,
  derived: SemanticDerivedOrdinals
}

pub(package) type SemanticTypeCatalog = opaque SemanticTypeCatalogStorage

type SemanticTypeCatalogBuilderStorage {
  segments: owned DenseBuilder<SemanticTypeCatalogSegment>,
  slots: owned DenseBuilder<usize>,
  mask: usize,
  derived: SemanticDerivedOrdinals
}

pub(package) type SemanticTypeCatalogBuilder = opaque SemanticTypeCatalogBuilderStorage

pub(package) type SemanticTypeCatalogInsert {
  SemanticTypeCatalogInserted(owned SemanticTypeCatalogBuilder),
  SemanticTypeCatalogDuplicate(
    owned SemanticTypeCatalogBuilder,
    SemanticTypeSegmentId
  )
}

pub(package) type SemanticTypeCatalogExtend {
  SemanticTypeCatalogExtended(SemanticTypeCatalog),
  SemanticTypeCatalogAlreadyPresent(SemanticTypeCatalog, SemanticTypeSegmentId)
}

fn semantic_type_catalog_capacity(expected: usize) -> usize {
  let needed = match num_scalar_usize_checked_mul(expected, 2) {
    Some(value) -> value
    None -> panic("Semantic type catalog capacity is too large")
  }
  let mut capacity: usize = 8
  while capacity < needed {
    capacity = match num_scalar_usize_checked_mul(capacity, 2) {
      Some(value) -> value
      None -> panic("Semantic type catalog capacity is too large")
    }
  }
  capacity
}

fn semantic_type_catalog_hash(segment: SemanticTypeSegmentId) -> i64 {
  semantic_type_segment_hash(segment)
}

fn semantic_type_catalog_index(hash: i64, mask: usize) -> usize {
  __i64_to_usize(hash band __u64_to_i64(__usize_to_u64(mask)))
}

fn semantic_derived_ordinal_raise(
  bucket: List<SemanticDerivedOrdinal>,
  owner: ModuleIdentity,
  next: usize
) -> List<SemanticDerivedOrdinal> {
  match bucket {
    Nil -> Nil<SemanticDerivedOrdinal>().prepend(
      SemanticDerivedOrdinal { owner: owner, next: next }
    )
    Cons(entry, rest) -> if module_identity_eq(entry.owner, owner) {
      if entry.next >= next { bucket }
      else { rest.prepend(SemanticDerivedOrdinal { owner: owner, next: next }) }
    } else { semantic_derived_ordinal_raise(rest, owner, next).prepend(entry) }
  }
}

-- The ordinals after a segment arrives: a derived segment raises its owner's
-- next free ordinal past its own.
fn semantic_derived_ordinals_with(
  derived: SemanticDerivedOrdinals,
  segment: SemanticTypeSegmentId
) -> SemanticDerivedOrdinals {
  let owner = semantic_type_segment_module(segment)
  match semantic_type_segment_derived_ordinal(segment, owner) {
    None -> derived
    Some(ordinal) -> {
      let next = match num_scalar_usize_checked_add(ordinal, 1) {
        Some(value) -> value
        None -> panic("Semantic type segment ordinal is exhausted")
      }
      let key = retained_module_identity_hash(owner)
      let bucket = match derived.get(key) {
        Some(found) -> found
        None -> Nil<SemanticDerivedOrdinal>()
      }
      derived.insert(key, semantic_derived_ordinal_raise(bucket, owner, next))
    }
  }
}

-- The owner's next free derived ordinal, and never below `floor`.
fn semantic_derived_ordinal_next(
  bucket: List<SemanticDerivedOrdinal>,
  owner: ModuleIdentity,
  floor: usize
) -> usize {
  match bucket {
    Nil -> floor
    Cons(entry, rest) -> if module_identity_eq(entry.owner, owner) {
      if entry.next > floor { entry.next } else { floor }
    } else { semantic_derived_ordinal_next(rest, owner, floor) }
  }
}

fn semantic_type_catalog_segment(
  graph: SemanticTypeGraph
) -> SemanticTypeCatalogSegment {
  SemanticTypeCatalogSegmentValue(
    SemanticTypeCatalogContext {
      graph: graph,
      local: semantic_type_graph_local(graph),
      lists: semantic_type_graph_type_lists_local(graph),
      functions: semantic_type_graph_functions_local(graph),
      effects: semantic_type_graph_effects_local(graph),
      named: semantic_type_graph_named_local(graph),
      records: semantic_type_graph_records_local(graph),
      variants: semantic_type_graph_variants_local(graph),
      variables: semantic_type_graph_variables_local(graph),
      traits: semantic_type_graph_traits_local(graph),
      associated: semantic_type_graph_associated_local(graph)
    }
  )
}

fn semantic_type_catalog_segment_id(
  segment: borrow SemanticTypeCatalogSegment
) -> SemanticTypeSegmentId {
  match segment {
    SemanticTypeCatalogSegmentValue(storage) -> {
      let { graph } = storage
      semantic_type_graph_segment(graph)
    }
  }
}

pub(package) fn semantic_type_catalog_builder(
  expected: usize
) -> owned SemanticTypeCatalogBuilder {
  let capacity = semantic_type_catalog_capacity(expected)
  let mut slots = dense_builder_with_capacity<usize>(capacity)
  let mut index: usize = 0
  while index < capacity {
    slots.push(0)
    index = index + 1
  }
  SemanticTypeCatalogBuilder(
    SemanticTypeCatalogBuilderStorage {
      segments: dense_builder_with_capacity<SemanticTypeCatalogSegment>(expected),
      slots: slots,
      mask: capacity - 1,
      derived: map.new<i64, List<SemanticDerivedOrdinal>>()
    }
  )
}

pub(package) fn semantic_type_catalog_empty(expected: usize) -> SemanticTypeCatalog {
  semantic_type_catalog_builder(expected).freeze()
}

impl SemanticTypeCatalogBuilder {
  pub(package) fn insert(
    self: owned Self,
    graph: SemanticTypeGraph
  ) -> SemanticTypeCatalogInsert {
    let wanted = semantic_type_graph_segment(graph)
    match self {
      SemanticTypeCatalogBuilder(storage) -> {
        let { segments, slots, mask, derived } = storage
        let mut slot = semantic_type_catalog_index(
          semantic_type_catalog_hash(wanted),
          mask
        )
        let mut probes: usize = 0
        let mut selected: usize = mask + 1
        let mut duplicate = false
        while probes <= mask and selected > mask {
          let occupied = slots.at(dense_index(slot))
          if occupied == 0 {
            selected = slot
          } else {
            let existing = segments.at(dense_index(occupied - 1))
            if semantic_type_segment_id_eq(
              semantic_type_catalog_segment_id(existing),
              wanted
            ) {
              selected = slot
              duplicate = true
            } else {
              slot = (slot + 1) band mask
              probes = probes + 1
            }
          }
        }
        if selected > mask { panic("Semantic type catalog has no free slot") }
        else {
          if duplicate {
            SemanticTypeCatalogDuplicate(
              SemanticTypeCatalogBuilder(
                SemanticTypeCatalogBuilderStorage {
                  segments: segments,
                  slots: slots,
                  mask: mask,
                  derived: derived
                }
              ),
              wanted
            )
          } else {
            let mut next_segments = segments
            let mut next_slots = slots
            let index = next_segments.push(semantic_type_catalog_segment(graph))
            next_slots.set(dense_index(selected), dense_index_value(index) + 1)
            SemanticTypeCatalogInserted(
              SemanticTypeCatalogBuilder(
                SemanticTypeCatalogBuilderStorage {
                  segments: next_segments,
                  slots: next_slots,
                  mask: mask,
                  derived: semantic_derived_ordinals_with(derived, wanted)
                }
              )
            )
          }
        }
      }
    }
  }

  pub(package) fn freeze(self: owned Self) -> SemanticTypeCatalog {
    match self {
      SemanticTypeCatalogBuilder(storage) -> {
        let { segments, slots, mask, derived } = storage
        SemanticTypeCatalog(
          SemanticTypeCatalogStorage {
            segments: segments.freeze(),
            slots: slots.freeze(),
            mask: mask,
            derived: derived
          }
        )
      }
    }
  }
}

impl Drop for SemanticTypeCatalogBuilder {
  fn drop(self) -> nil {
    match self {
      SemanticTypeCatalogBuilder(storage) -> {
        let { segments, slots, mask: _, derived: _ } = storage
        segments.drop()
        slots.drop()
      }
    }
  }
}

impl SemanticTypeCatalog {
  pub(package) fn len(self: borrow Self) -> usize {
    match self {
      SemanticTypeCatalog(storage) -> {
        let { segments } = storage
        segments.len()
      }
    }
  }

  pub(package) fn segment(
    self: borrow Self,
    wanted: SemanticTypeSegmentId
  ) -> Option<SemanticTypeCatalogSegment> {
    match self {
      SemanticTypeCatalog(storage) -> {
        let { segments, slots, mask } = storage
        let mut slot = semantic_type_catalog_index(
          semantic_type_catalog_hash(wanted),
          mask
        )
        let mut probes: usize = 0
        while probes <= mask {
          let occupied = slots.at(dense_index(slot))
          if occupied == 0 { return None<SemanticTypeCatalogSegment>() }
          else {
            let candidate = segments.at(dense_index(occupied - 1))
            if semantic_type_segment_id_eq(
              semantic_type_catalog_segment_id(candidate),
              wanted
            ) { return Some<SemanticTypeCatalogSegment>(candidate) }
            else {
              slot = (slot + 1) band mask
              probes = probes + 1
            }
          }
        }
        None<SemanticTypeCatalogSegment>()
      }
    }
  }

  pub(package) fn graph_for(
    self: borrow Self,
    id: SemanticTypeId
  ) -> Option<SemanticTypeGraph> {
    match self.segment(semantic_type_id_segment(id)) {
      Some(SemanticTypeCatalogSegmentValue(storage)) ->
        Some<SemanticTypeGraph>(storage.graph)
      None -> None<SemanticTypeGraph>()
    }
  }

  pub(package) fn next_derived_segment(
    self: borrow Self,
    owner: ModuleIdentity,
    floor: usize
  ) -> usize {
    match self {
      SemanticTypeCatalog(storage) -> {
        let { derived } = storage
        match derived.get(retained_module_identity_hash(owner)) {
          Some(bucket) -> semantic_derived_ordinal_next(bucket, owner, floor)
          None -> floor
        }
      }
    }
  }
}

fn semantic_type_catalog_copy_segments(
  segments: borrow DenseSegment<SemanticTypeCatalogSegment>,
  index: usize,
  builder: owned SemanticTypeCatalogBuilder
) -> owned SemanticTypeCatalogBuilder {
  if index >= segments.len() { builder }
  else {
    match segments.at(dense_index(index)) {
      SemanticTypeCatalogSegmentValue(context) -> {
        let { graph } = context
        match builder.insert(graph) {
          SemanticTypeCatalogInserted(next) -> semantic_type_catalog_copy_segments(
            segments,
            index + 1,
            next
          )
          SemanticTypeCatalogDuplicate(next, _) -> {
            next.drop()
            panic("Semantic type catalog duplicated an existing segment while copying")
          }
        }
      }
    }
  }
}

fn semantic_type_catalog_grow(
  catalog: borrow SemanticTypeCatalog,
  expected: usize
) -> SemanticTypeCatalog {
  match catalog {
    SemanticTypeCatalog(storage) -> {
      let { segments } = storage
      semantic_type_catalog_copy_segments(
        segments,
        0,
        semantic_type_catalog_builder(expected)
      ).freeze()
    }
  }
}

-- Compose independently resolved module signature segments with the shared
-- declaration/method graph. The builder checks exact segment identity, so a
-- collision is an invalid composition rather than an overwritten type.
fn semantic_type_catalog_copy_into(
  catalog: borrow SemanticTypeCatalog,
  builder: owned SemanticTypeCatalogBuilder
) -> owned SemanticTypeCatalogBuilder {
  match catalog {
    SemanticTypeCatalog(storage) -> {
      let { segments } = storage
      semantic_type_catalog_copy_segments(segments, 0, builder)
    }
  }
}

fn semantic_type_catalog_union_segments(
  segments: borrow DenseSegment<SemanticTypeCatalogSegment>,
  index: usize,
  builder: owned SemanticTypeCatalogBuilder
) -> owned SemanticTypeCatalogBuilder {
  if index >= segments.len() { builder }
  else {
    match segments.at(dense_index(index)) {
      SemanticTypeCatalogSegmentValue(context) -> {
        let { graph } = context
        match builder.insert(graph) {
          SemanticTypeCatalogInserted(next) -> semantic_type_catalog_union_segments(
            segments,
            index + 1,
            next
          )
          SemanticTypeCatalogDuplicate(next, _) -> semantic_type_catalog_union_segments(
            segments,
            index + 1,
            next
          )
        }
      }
    }
  }
}

--- Compose catalogs whose shared segments carry the same immutable identity.
--- Independently checked modules repeat their imported segments; union keeps
--- one copy while retaining every module-local and body-derived segment.
pub(package) fn semantic_type_catalog_union(
  left: borrow SemanticTypeCatalog,
  right: borrow SemanticTypeCatalog
) -> SemanticTypeCatalog {
  let builder = semantic_type_catalog_copy_into(
    left,
    semantic_type_catalog_builder(left.len() + right.len())
  )
  match right {
    SemanticTypeCatalog(storage) -> {
      let { segments } = storage
      semantic_type_catalog_union_segments(segments, 0, builder).freeze()
    }
  }
}

pub(package) fn semantic_type_catalog_merge_distinct(
  shared: borrow SemanticTypeCatalog,
  additional: borrow SemanticTypeCatalog
) -> SemanticTypeCatalog {
  let builder = semantic_type_catalog_copy_into(
    shared,
    semantic_type_catalog_builder(shared.len() + additional.len())
  )
  semantic_type_catalog_copy_into(additional, builder).freeze()
}

pub(package) fn semantic_type_catalog_extend(
  catalog: borrow SemanticTypeCatalog,
  graph: SemanticTypeGraph
) -> SemanticTypeCatalogExtend {
  match catalog {
    SemanticTypeCatalog(storage) -> {
      let { segments, slots, mask, derived } = storage
      let required = segments.len() + 1
      let capacity = mask + 1
      let wanted_capacity = semantic_type_catalog_capacity(required)
      if wanted_capacity > capacity {
        let grown = semantic_type_catalog_grow(catalog, required)
        semantic_type_catalog_extend(grown, graph)
      } else {
        let wanted = semantic_type_graph_segment(graph)
        let mut slot = semantic_type_catalog_index(
          semantic_type_catalog_hash(wanted),
          mask
        )
        let mut probes: usize = 0
        while probes <= mask {
          let occupied = slots.at(dense_index(slot))
          if occupied == 0 {
            let index = segments.len()
            let next_segments = segments.push(semantic_type_catalog_segment(graph))
            let next_slots = slots.set(dense_index(slot), index + 1)
            return SemanticTypeCatalogExtended(
              SemanticTypeCatalog(
                SemanticTypeCatalogStorage {
                  segments: next_segments,
                  slots: next_slots,
                  mask: mask,
                  derived: semantic_derived_ordinals_with(derived, wanted)
                }
              )
            )
          } else {
            let existing = segments.at(dense_index(occupied - 1))
            if semantic_type_segment_id_eq(
              semantic_type_catalog_segment_id(existing),
              wanted
            ) {
              return SemanticTypeCatalogAlreadyPresent(
                SemanticTypeCatalog(
                  SemanticTypeCatalogStorage {
                    segments: segments,
                    slots: slots,
                    mask: mask,
                    derived: derived
                  }
                ),
                wanted
              )
            } else {
              slot = (slot + 1) band mask
              probes = probes + 1
            }
          }
        }
        panic("Semantic type catalog has no free slot")
      }
    }
  }
}

pub(package) fn semantic_type_catalog_with_graph(
  catalog: borrow SemanticTypeCatalog,
  graph: SemanticTypeGraph
) -> SemanticTypeCatalog {
  match semantic_type_catalog_extend(catalog, graph) {
    SemanticTypeCatalogExtended(next) -> next
    SemanticTypeCatalogAlreadyPresent(_, _) ->
      panic("Semantic type catalog extension duplicates a segment")
  }
}

pub(package) fn semantic_type_catalog_single(
  graph: SemanticTypeGraph
) -> SemanticTypeCatalog {
  let empty = semantic_type_catalog_empty(1)
  match semantic_type_catalog_extend(empty, graph) {
    SemanticTypeCatalogExtended(catalog) -> catalog
    SemanticTypeCatalogAlreadyPresent(_, _) ->
      panic("A single semantic type segment cannot duplicate itself")
  }
}
