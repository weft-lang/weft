-- Structural equality over one frozen semantic-type segment.
--
-- Exact ids are the fast path. Scalar columns reject unequal shapes and
-- declaration hashes before cold retained identities are compared. Imported
-- edges with the same complete id compare equal; resolving two distinct
-- imported ids structurally belongs to the checked-program segment catalog.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}

type SemanticTypeEqualityView {
  local: SemanticTypeLocalGraph,
  lists: SemanticTypeListLocalGraph,
  functions: SemanticFunctionLocalGraph,
  effects: SemanticEffectLocalGraph,
  named: SemanticNamedLocalGraph,
  records: SemanticRecordLocalGraph,
  variants: SemanticVariantLocalGraph,
  variables: SemanticVariableLocalGraph,
  traits: SemanticTraitLocalGraph,
  associated: SemanticAssociatedLocalGraph
}

fn semantic_type_equality_view(
  graph: borrow SemanticTypeGraph
) -> SemanticTypeEqualityView {
  SemanticTypeEqualityView {
    local: semantic_type_graph_local(graph),
    lists: semantic_type_graph_type_lists_local(graph),
    functions: semantic_type_graph_functions_local(graph),
    effects: semantic_type_graph_effects_local(graph),
    named: semantic_type_graph_named_local(graph),
    records: semantic_type_graph_records_local(graph),
    variants: semantic_type_graph_variants_local(graph),
    variables: semantic_type_graph_variables_local(graph),
    traits: semantic_type_graph_traits_local(graph),
    associated: semantic_type_graph_associated_local(graph)
  }
}

fn semantic_primitive_equal(
  left: SemanticPrimitiveView,
  right: SemanticPrimitiveView
) -> bool {
  match (left, right) {
    (SemanticPrimitivePresent(SemanticI64),
      SemanticPrimitivePresent(SemanticI64)) -> true
    (SemanticPrimitivePresent(SemanticStr),
      SemanticPrimitivePresent(SemanticStr)) -> true
    (SemanticPrimitivePresent(SemanticBool),
      SemanticPrimitivePresent(SemanticBool)) -> true
    (SemanticPrimitivePresent(SemanticNil),
      SemanticPrimitivePresent(SemanticNil)) -> true
    (SemanticPrimitivePresent(SemanticF64),
      SemanticPrimitivePresent(SemanticF64)) -> true
    (SemanticPrimitivePresent(SemanticI32),
      SemanticPrimitivePresent(SemanticI32)) -> true
    (SemanticPrimitivePresent(SemanticI8),
      SemanticPrimitivePresent(SemanticI8)) -> true
    (SemanticPrimitivePresent(SemanticI16),
      SemanticPrimitivePresent(SemanticI16)) -> true
    (SemanticPrimitivePresent(SemanticU8),
      SemanticPrimitivePresent(SemanticU8)) -> true
    (SemanticPrimitivePresent(SemanticU16),
      SemanticPrimitivePresent(SemanticU16)) -> true
    (SemanticPrimitivePresent(SemanticU32),
      SemanticPrimitivePresent(SemanticU32)) -> true
    (SemanticPrimitivePresent(SemanticU64),
      SemanticPrimitivePresent(SemanticU64)) -> true
    (SemanticPrimitivePresent(SemanticIsize),
      SemanticPrimitivePresent(SemanticIsize)) -> true
    (SemanticPrimitivePresent(SemanticUsize),
      SemanticPrimitivePresent(SemanticUsize)) -> true
    (SemanticPrimitivePresent(SemanticF32),
      SemanticPrimitivePresent(SemanticF32)) -> true
    (SemanticPrimitiveAbsent, SemanticPrimitiveAbsent) -> true
    _ -> false
  }
}

fn semantic_mutability_equal(
  left: SemanticMutability,
  right: SemanticMutability
) -> bool {
  match (left, right) {
    (SemanticImmutable, SemanticImmutable) -> true
    (SemanticMutable, SemanticMutable) -> true
    _ -> false
  }
}

fn semantic_named_role_equal(
  left: SemanticNamedRole,
  right: SemanticNamedRole
) -> bool {
  match (left, right) {
    (SemanticOpaqueType, SemanticOpaqueType) -> true
    (SemanticNominalType, SemanticNominalType) -> true
    (SemanticPayloadlessVariantType, SemanticPayloadlessVariantType) -> true
    _ -> false
  }
}

fn semantic_record_shape_equal(
  left: SemanticRecordShape,
  right: SemanticRecordShape
) -> bool {
  match (left, right) {
    (SemanticStructuralRecord, SemanticStructuralRecord) -> true
    (SemanticTupleRecord, SemanticTupleRecord) -> true
    _ -> false
  }
}

fn semantic_record_openness_equal(
  left: SemanticRecordOpenness,
  right: SemanticRecordOpenness
) -> bool {
  match (left, right) {
    (SemanticClosedRecord, SemanticClosedRecord) -> true
    (SemanticOpenRecord, SemanticOpenRecord) -> true
    _ -> false
  }
}

fn semantic_record_field_name_equal(
  left: SemanticRecordFieldName,
  right: SemanticRecordFieldName
) -> bool {
  match (left, right) {
    (SemanticNamedRecordField(left_name), SemanticNamedRecordField(right_name)) ->
      left_name == right_name
    (SemanticTupleRecordField(left_position),
      SemanticTupleRecordField(right_position)) -> left_position == right_position
    _ -> false
  }
}

fn semantic_local_reference_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left_imported: bool,
  right_imported: bool,
  left_local: SemanticLocalTypeId,
  right_local: SemanticLocalTypeId,
  left_complete: SemanticTypeId,
  right_complete: SemanticTypeId
) -> bool {
  if left_imported or right_imported {
    left_imported and right_imported and semantic_type_id_eq(
      left_complete,
      right_complete
    )
  } else { semantic_local_type_equal(graph, view, left_local, right_local) }
}

fn semantic_list_edge_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticTypeListEdge,
  right: SemanticTypeListEdge
) -> bool {
  let { lists } = view
  let left_imported = semantic_type_list_edge_is_imported(lists, left)
  let right_imported = semantic_type_list_edge_is_imported(lists, right)
  if left_imported or right_imported {
    left_imported and right_imported and semantic_type_id_eq(
      semantic_type_graph_list_type_id(graph, left),
      semantic_type_graph_list_type_id(graph, right)
    )
  } else {
    semantic_local_type_equal(
      graph,
      view,
      semantic_type_list_edge_local_id(lists, left),
      semantic_type_list_edge_local_id(lists, right)
    )
  }
}

fn semantic_type_list_equal_from(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticTypeListId,
  right: SemanticTypeListId,
  offset: usize
) -> bool {
  let { lists } = view
  let left_len = semantic_type_list_len(lists, left)
  let right_len = semantic_type_list_len(lists, right)
  if left_len != right_len { false }
  else {
    if offset >= left_len { true }
    else {
      semantic_list_edge_equal(
        graph,
        view,
        semantic_type_list_edge(lists, left, offset),
        semantic_type_list_edge(lists, right, offset)
      ) and semantic_type_list_equal_from(graph, view, left, right, offset + 1)
    }
  }
}

fn semantic_type_list_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticTypeListId,
  right: SemanticTypeListId
) -> bool {
  semantic_type_list_equal_from(graph, view, left, right, __i64_to_usize(0))
}

fn semantic_type_list_contains_edge(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  list: SemanticTypeListId,
  candidate: SemanticTypeListEdge,
  offset: usize
) -> bool {
  let { lists } = view
  let length = semantic_type_list_len(lists, list)
  if offset >= length { false }
  else {
    semantic_list_edge_equal(
      graph,
      view,
      semantic_type_list_edge(lists, list, offset),
      candidate
    ) or semantic_type_list_contains_edge(
      graph,
      view,
      list,
      candidate,
      offset + 1
    )
  }
}

fn semantic_type_set_is_subset_from(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticTypeListId,
  right: SemanticTypeListId,
  offset: usize
) -> bool {
  let { lists } = view
  let left_len = semantic_type_list_len(lists, left)
  if offset >= left_len { true }
  else {
    semantic_type_list_contains_edge(
      graph,
      view,
      right,
      semantic_type_list_edge(lists, left, offset),
      __i64_to_usize(0)
    ) and semantic_type_set_is_subset_from(
      graph,
      view,
      left,
      right,
      offset + 1
    )
  }
}

fn semantic_type_set_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticTypeListId,
  right: SemanticTypeListId
) -> bool {
  semantic_type_set_is_subset_from(
    graph,
    view,
    left,
    right,
    __i64_to_usize(0)
  ) and semantic_type_set_is_subset_from(
    graph,
    view,
    right,
    left,
    __i64_to_usize(0)
  )
}

fn semantic_unary_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local } = view
  let left_edge = semantic_type_local_graph_unary(local, left)
  let right_edge = semantic_type_local_graph_unary(local, right)
  let left_imported = semantic_type_local_graph_unary_is_imported(
    local,
    left_edge
  )
  let right_imported = semantic_type_local_graph_unary_is_imported(
    local,
    right_edge
  )
  semantic_local_reference_equal(
    graph,
    view,
    left_imported,
    right_imported,
    if left_imported { left } else {
      semantic_type_local_graph_unary_id(local, left_edge)
    },
    if right_imported { right } else {
      semantic_type_local_graph_unary_id(local, right_edge)
    },
    semantic_type_graph_unary_type_id(graph, left_edge),
    semantic_type_graph_unary_type_id(graph, right_edge)
  )
}

fn semantic_binary_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local } = view
  let left_edges = semantic_type_local_graph_binary(local, left)
  let right_edges = semantic_type_local_graph_binary(local, right)
  let left_left_imported = semantic_type_local_graph_binary_left_is_imported(
    local,
    left_edges
  )
  let right_left_imported = semantic_type_local_graph_binary_left_is_imported(
    local,
    right_edges
  )
  let left_right_imported = semantic_type_local_graph_binary_right_is_imported(
    local,
    left_edges
  )
  let right_right_imported = semantic_type_local_graph_binary_right_is_imported(
    local,
    right_edges
  )
  semantic_local_reference_equal(
    graph,
    view,
    left_left_imported,
    right_left_imported,
    if left_left_imported { left } else {
      semantic_type_local_graph_binary_left_id(local, left_edges)
    },
    if right_left_imported { right } else {
      semantic_type_local_graph_binary_left_id(local, right_edges)
    },
    semantic_type_graph_binary_left_type_id(graph, left_edges),
    semantic_type_graph_binary_left_type_id(graph, right_edges)
  ) and semantic_local_reference_equal(
    graph,
    view,
    left_right_imported,
    right_right_imported,
    if left_right_imported { left } else {
      semantic_type_local_graph_binary_right_id(local, left_edges)
    },
    if right_right_imported { right } else {
      semantic_type_local_graph_binary_right_id(local, right_edges)
    },
    semantic_type_graph_binary_right_type_id(graph, left_edges),
    semantic_type_graph_binary_right_type_id(graph, right_edges)
  )
}

fn semantic_mutable_unary_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local } = view
  let left_edge = semantic_type_local_graph_mutable_unary(local, left)
  let right_edge = semantic_type_local_graph_mutable_unary(local, right)
  let left_imported = semantic_type_local_graph_mutable_unary_is_imported(
    local,
    left_edge
  )
  let right_imported = semantic_type_local_graph_mutable_unary_is_imported(
    local,
    right_edge
  )
  semantic_mutability_equal(
    semantic_type_local_graph_mutability(local, left_edge),
    semantic_type_local_graph_mutability(local, right_edge)
  ) and semantic_local_reference_equal(
    graph,
    view,
    left_imported,
    right_imported,
    if left_imported { left } else {
      semantic_type_local_graph_mutable_unary_id(local, left_edge)
    },
    if right_imported { right } else {
      semantic_type_local_graph_mutable_unary_id(local, right_edge)
    },
    semantic_type_graph_mutable_unary_type_id(graph, left_edge),
    semantic_type_graph_mutable_unary_type_id(graph, right_edge)
  )
}

fn semantic_array_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local } = view
  let left_edge = semantic_type_local_graph_array(local, left)
  let right_edge = semantic_type_local_graph_array(local, right)
  let left_length = semantic_type_local_graph_array_length(local, left_edge)
  let right_length = semantic_type_local_graph_array_length(local, right_edge)
  if left_length != right_length { false }
  else {
    if left_length == __i64_to_usize(0) { true }
    else {
      let left_imported = semantic_type_local_graph_array_is_imported(
        local,
        left_edge
      )
      let right_imported = semantic_type_local_graph_array_is_imported(
        local,
        right_edge
      )
      semantic_local_reference_equal(
        graph,
        view,
        left_imported,
        right_imported,
        if left_imported { left } else {
          semantic_type_local_graph_array_id(local, left_edge)
        },
        if right_imported { right } else {
          semantic_type_local_graph_array_id(local, right_edge)
        },
        semantic_type_graph_array_type_id(graph, left_edge),
        semantic_type_graph_array_type_id(graph, right_edge)
      )
    }
  }
}

fn semantic_function_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, functions } = view
  let left_edge = semantic_type_local_graph_function(local, left)
  let right_edge = semantic_type_local_graph_function(local, right)
  let left_result_imported = semantic_type_function_result_is_imported(
    functions,
    left_edge
  )
  let right_result_imported = semantic_type_function_result_is_imported(
    functions,
    right_edge
  )
  let left_effects_imported = semantic_type_function_effects_are_imported(
    functions,
    left_edge
  )
  let right_effects_imported = semantic_type_function_effects_are_imported(
    functions,
    right_edge
  )
  semantic_type_list_equal(
    graph,
    view,
    semantic_type_function_parameters(functions, left_edge),
    semantic_type_function_parameters(functions, right_edge)
  ) and semantic_local_reference_equal(
    graph,
    view,
    left_result_imported,
    right_result_imported,
    if left_result_imported { left } else {
      semantic_type_function_result_local_id(functions, left_edge)
    },
    if right_result_imported { right } else {
      semantic_type_function_result_local_id(functions, right_edge)
    },
    semantic_type_graph_function_result_type_id(graph, left_edge),
    semantic_type_graph_function_result_type_id(graph, right_edge)
  ) and semantic_local_reference_equal(
    graph,
    view,
    left_effects_imported,
    right_effects_imported,
    if left_effects_imported { left } else {
      semantic_type_function_effects_local_id(functions, left_edge)
    },
    if right_effects_imported { right } else {
      semantic_type_function_effects_local_id(functions, right_edge)
    },
    semantic_type_graph_function_effects_type_id(graph, left_edge),
    semantic_type_graph_function_effects_type_id(graph, right_edge)
  )
}

fn semantic_declaration_equal(
  left_hash: i64,
  right_hash: i64,
  left: DeclarationIdentity,
  right: DeclarationIdentity
) -> bool {
  left_hash == right_hash and declaration_identity_eq(left, right)
}

fn semantic_effect_atom_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, effects } = view
  let left_edge = semantic_type_local_graph_effect_atom(local, left)
  let right_edge = semantic_type_local_graph_effect_atom(local, right)
  semantic_declaration_equal(
    semantic_type_effect_atom_declaration_hash(effects, left_edge),
    semantic_type_effect_atom_declaration_hash(effects, right_edge),
    semantic_type_graph_effect_atom_declaration(graph, left_edge),
    semantic_type_graph_effect_atom_declaration(graph, right_edge)
  ) and semantic_type_list_equal(
    graph,
    view,
    semantic_type_effect_atom_arguments(effects, left_edge),
    semantic_type_effect_atom_arguments(effects, right_edge)
  )
}

fn semantic_effect_signature_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, effects } = view
  let left_edge = semantic_type_local_graph_effect_signature(local, left)
  let right_edge = semantic_type_local_graph_effect_signature(local, right)
  let left_open = semantic_type_effect_signature_is_open(effects, left_edge)
  let right_open = semantic_type_effect_signature_is_open(effects, right_edge)
  if left_open != right_open { false }
  else {
    let same_tail = if left_open {
      semantic_type_effect_signature_tail(effects, left_edge) ==
        semantic_type_effect_signature_tail(effects, right_edge)
    } else { true }
    same_tail and semantic_type_set_equal(
      graph,
      view,
      semantic_type_effect_signature_effects(effects, left_edge),
      semantic_type_effect_signature_effects(effects, right_edge)
    )
  }
}

fn semantic_named_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, named } = view
  let left_edge = semantic_type_local_graph_named(local, left)
  let right_edge = semantic_type_local_graph_named(local, right)
  let left_role = semantic_type_named_role(named, left_edge)
  let right_role = semantic_type_named_role(named, right_edge)
  if not semantic_named_role_equal(left_role, right_role) { false }
  else {
    if not semantic_declaration_equal(
      semantic_type_named_declaration_hash(named, left_edge),
      semantic_type_named_declaration_hash(named, right_edge),
      semantic_type_graph_named_declaration(graph, left_edge),
      semantic_type_graph_named_declaration(graph, right_edge)
    ) { false }
    else {
      if not semantic_type_list_equal(
        graph,
        view,
        semantic_type_named_arguments(named, left_edge),
        semantic_type_named_arguments(named, right_edge)
      ) { false }
      else {
        match left_role {
          SemanticOpaqueType -> true
          _ -> {
            let left_imported = semantic_type_named_representation_is_imported(
              named,
              left_edge
            )
            let right_imported = semantic_type_named_representation_is_imported(
              named,
              right_edge
            )
            semantic_local_reference_equal(
              graph,
              view,
              left_imported,
              right_imported,
              if left_imported { left } else {
                semantic_type_named_representation_local_id(named, left_edge)
              },
              if right_imported { right } else {
                semantic_type_named_representation_local_id(named, right_edge)
              },
              semantic_type_graph_named_representation_type_id(graph, left_edge),
              semantic_type_graph_named_representation_type_id(graph, right_edge)
            )
          }
        }
      }
    }
  }
}

fn semantic_record_field_type_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticRecordFieldEdge,
  right: SemanticRecordFieldEdge
) -> bool {
  let { records } = view
  let left_imported = semantic_type_record_field_is_imported(records, left)
  let right_imported = semantic_type_record_field_is_imported(records, right)
  if left_imported or right_imported {
    left_imported and right_imported and semantic_type_id_eq(
      semantic_type_graph_record_field_type_id(graph, left),
      semantic_type_graph_record_field_type_id(graph, right)
    )
  } else {
    semantic_local_type_equal(
      graph,
      view,
      semantic_type_record_field_local_id(records, left),
      semantic_type_record_field_local_id(records, right)
    )
  }
}

fn semantic_record_contains_field(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  fields: SemanticRecordFieldListId,
  candidate: SemanticRecordFieldEdge,
  offset: usize
) -> bool {
  let { records } = view
  let length = semantic_type_record_field_count(records, fields)
  if offset >= length { false }
  else {
    let edge = semantic_type_record_field_edge(records, fields, offset)
    let same = semantic_type_record_field_hash(records, edge) ==
      semantic_type_record_field_hash(records, candidate) and
      semantic_record_field_name_equal(
        semantic_type_graph_record_field_name(graph, edge),
        semantic_type_graph_record_field_name(graph, candidate)
      ) and semantic_record_field_type_equal(graph, view, edge, candidate)
    same or semantic_record_contains_field(
      graph,
      view,
      fields,
      candidate,
      offset + 1
    )
  }
}

fn semantic_record_fields_equal_from(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticRecordFieldListId,
  right: SemanticRecordFieldListId,
  offset: usize
) -> bool {
  let { records } = view
  let left_len = semantic_type_record_field_count(records, left)
  let right_len = semantic_type_record_field_count(records, right)
  if left_len != right_len { false }
  else {
    if offset >= left_len { true }
    else {
      semantic_record_contains_field(
        graph,
        view,
        right,
        semantic_type_record_field_edge(records, left, offset),
        __i64_to_usize(0)
      ) and semantic_record_fields_equal_from(
        graph,
        view,
        left,
        right,
        offset + 1
      )
    }
  }
}

fn semantic_record_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, records } = view
  let left_edge = semantic_type_local_graph_record(local, left)
  let right_edge = semantic_type_local_graph_record(local, right)
  semantic_record_shape_equal(
    semantic_type_record_shape(records, left_edge),
    semantic_type_record_shape(records, right_edge)
  ) and semantic_record_openness_equal(
    semantic_type_record_openness(records, left_edge),
    semantic_type_record_openness(records, right_edge)
  ) and semantic_record_fields_equal_from(
    graph,
    view,
    semantic_type_record_fields(records, left_edge),
    semantic_type_record_fields(records, right_edge),
    __i64_to_usize(0)
  )
}

fn semantic_variant_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, variants } = view
  let left_edge = semantic_type_local_graph_variant(local, left)
  let right_edge = semantic_type_local_graph_variant(local, right)
  if not semantic_declaration_equal(
    semantic_type_variant_declaration_hash(variants, left_edge),
    semantic_type_variant_declaration_hash(variants, right_edge),
    semantic_type_graph_variant_declaration(graph, left_edge),
    semantic_type_graph_variant_declaration(graph, right_edge)
  ) { false }
  else {
    let left_imported = semantic_type_variant_payload_is_imported(
      variants,
      left_edge
    )
    let right_imported = semantic_type_variant_payload_is_imported(
      variants,
      right_edge
    )
    semantic_local_reference_equal(
      graph,
      view,
      left_imported,
      right_imported,
      if left_imported { left } else {
        semantic_type_variant_payload_local_id(variants, left_edge)
      },
      if right_imported { right } else {
        semantic_type_variant_payload_local_id(variants, right_edge)
      },
      semantic_type_graph_variant_payload_type_id(graph, left_edge),
      semantic_type_graph_variant_payload_type_id(graph, right_edge)
    )
  }
}

fn semantic_variable_equal(
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, variables } = view
  let left_edge = semantic_type_local_graph_variable(local, left)
  let right_edge = semantic_type_local_graph_variable(local, right)
  let left_self = semantic_type_variable_is_self(variables, left_edge)
  let right_self = semantic_type_variable_is_self(variables, right_edge)
  left_self == right_self and if left_self { true }
  else {
    semantic_type_variable_parameter(variables, left_edge) ==
      semantic_type_variable_parameter(variables, right_edge)
  }
}

fn semantic_trait_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, traits } = view
  let left_edge = semantic_type_local_graph_trait(local, left)
  let right_edge = semantic_type_local_graph_trait(local, right)
  semantic_declaration_equal(
    semantic_type_trait_declaration_hash(traits, left_edge),
    semantic_type_trait_declaration_hash(traits, right_edge),
    semantic_type_graph_trait_declaration(graph, left_edge),
    semantic_type_graph_trait_declaration(graph, right_edge)
  )
}

fn semantic_associated_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  let { local, associated } = view
  let left_edge = semantic_type_local_graph_associated(local, left)
  let right_edge = semantic_type_local_graph_associated(local, right)
  if not semantic_declaration_equal(
    semantic_type_associated_declaration_hash(associated, left_edge),
    semantic_type_associated_declaration_hash(associated, right_edge),
    semantic_type_graph_associated_declaration(graph, left_edge),
    semantic_type_graph_associated_declaration(graph, right_edge)
  ) { false }
  else {
    let left_imported = semantic_type_associated_base_is_imported(
      associated,
      left_edge
    )
    let right_imported = semantic_type_associated_base_is_imported(
      associated,
      right_edge
    )
    semantic_local_reference_equal(
      graph,
      view,
      left_imported,
      right_imported,
      if left_imported { left } else {
        semantic_type_associated_base_local_id(associated, left_edge)
      },
      if right_imported { right } else {
        semantic_type_associated_base_local_id(associated, right_edge)
      },
      semantic_type_graph_associated_base_type_id(graph, left_edge),
      semantic_type_graph_associated_base_type_id(graph, right_edge)
    )
  }
}

fn semantic_local_type_equal(
  graph: borrow SemanticTypeGraph,
  view: borrow SemanticTypeEqualityView,
  left: SemanticLocalTypeId,
  right: SemanticLocalTypeId
) -> bool {
  if semantic_local_type_id_eq(left, right) { true }
  else {
    let { local } = view
    match (
      semantic_type_graph_kind_local(local, left),
      semantic_type_graph_kind_local(local, right)
    ) {
      (SemanticBottomKind, SemanticBottomKind) -> true
      (SemanticTopKind, SemanticTopKind) -> true
      (SemanticPrimitiveKind, SemanticPrimitiveKind) -> semantic_primitive_equal(
        semantic_type_graph_primitive(graph, semantic_type_graph_type_id(graph, left)),
        semantic_type_graph_primitive(graph, semantic_type_graph_type_id(graph, right))
      )
      (SemanticUnionKind, SemanticUnionKind) -> semantic_binary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticIntersectionKind, SemanticIntersectionKind) -> semantic_binary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticComplementKind, SemanticComplementKind) -> semantic_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticContinuationKind, SemanticContinuationKind) -> semantic_binary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticWeakKind, SemanticWeakKind) -> semantic_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticAtomicKind, SemanticAtomicKind) -> semantic_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticUniqueKind, SemanticUniqueKind) -> semantic_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticOwnedKind, SemanticOwnedKind) -> semantic_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticPointerKind, SemanticPointerKind) -> semantic_mutable_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticBorrowKind, SemanticBorrowKind) -> semantic_mutable_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticSliceKind, SemanticSliceKind) -> semantic_mutable_unary_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticArrayKind, SemanticArrayKind) -> semantic_array_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticFunctionKind, SemanticFunctionKind) -> semantic_function_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticEffectAtomKind, SemanticEffectAtomKind) -> semantic_effect_atom_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticEffectSignatureKind, SemanticEffectSignatureKind) ->
        semantic_effect_signature_equal(graph, view, left, right)
      (SemanticNamedKind, SemanticNamedKind) -> semantic_named_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticRecordKind, SemanticRecordKind) -> semantic_record_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticVariantKind, SemanticVariantKind) -> semantic_variant_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticVariableKind, SemanticVariableKind) -> semantic_variable_equal(
        view,
        left,
        right
      )
      (SemanticTraitKind, SemanticTraitKind) -> semantic_trait_equal(
        graph,
        view,
        left,
        right
      )
      (SemanticAssociatedKind, SemanticAssociatedKind) -> semantic_associated_equal(
        graph,
        view,
        left,
        right
      )
      _ -> false
    }
  }
}

pub(package) fn semantic_type_graph_equal_within_segment(
  graph: borrow SemanticTypeGraph,
  left: SemanticTypeId,
  right: SemanticTypeId
) -> bool {
  if not semantic_type_graph_contains(graph, left) or
    not semantic_type_graph_contains(graph, right) { false }
  else {
    if semantic_type_id_eq(left, right) { true }
    else {
      let view = semantic_type_equality_view(graph)
      semantic_local_type_equal(
        graph,
        view,
        semantic_type_graph_local_id(graph, left),
        semantic_type_graph_local_id(graph, right)
      )
    }
  }
}
