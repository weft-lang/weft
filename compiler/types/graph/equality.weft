-- Structural equality over catalogued semantic-type segments.
--
-- Exact ids are the fast path. Scalar columns reject unequal shapes and
-- declaration hashes before cold retained identities are compared. Every
-- child traversal stays on scalar local ids until an imported edge actually
-- crosses a segment boundary. Complete ids therefore remain a cold resolver
-- concern instead of carrying retained module identities through recursion.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{*}
use stdlib/option.{None, Some}

type SemanticTypeEqualityContext = SemanticTypeCatalogContext

fn semantic_primitive_equal(
  left: SemanticPrimitive,
  right: SemanticPrimitive
) -> bool {
  match (left, right) {
    (SemanticI64, SemanticI64) -> true
    (SemanticStr, SemanticStr) -> true
    (SemanticBool, SemanticBool) -> true
    (SemanticNil, SemanticNil) -> true
    (SemanticF64, SemanticF64) -> true
    (SemanticI32, SemanticI32) -> true
    (SemanticI8, SemanticI8) -> true
    (SemanticI16, SemanticI16) -> true
    (SemanticU8, SemanticU8) -> true
    (SemanticU16, SemanticU16) -> true
    (SemanticU32, SemanticU32) -> true
    (SemanticU64, SemanticU64) -> true
    (SemanticIsize, SemanticIsize) -> true
    (SemanticUsize, SemanticUsize) -> true
    (SemanticF32, SemanticF32) -> true
    _ -> false
  }
}

fn semantic_mutability_equal(
  left: SemanticMutability,
  right: SemanticMutability
) -> bool {
  match (left, right) {
    (SemanticImmutable, SemanticImmutable) -> true
    (SemanticMutable, SemanticMutable) -> true
    _ -> false
  }
}

fn semantic_named_role_equal(
  left: SemanticNamedRole,
  right: SemanticNamedRole
) -> bool {
  match (left, right) {
    (SemanticOpaqueType, SemanticOpaqueType) -> true
    (SemanticNominalType, SemanticNominalType) -> true
    (SemanticPayloadlessVariantType, SemanticPayloadlessVariantType) -> true
    _ -> false
  }
}

fn semantic_record_shape_equal(
  left: SemanticRecordShape,
  right: SemanticRecordShape
) -> bool {
  match (left, right) {
    (SemanticStructuralRecord, SemanticStructuralRecord) -> true
    (SemanticTupleRecord, SemanticTupleRecord) -> true
    _ -> false
  }
}

fn semantic_record_openness_equal(
  left: SemanticRecordOpenness,
  right: SemanticRecordOpenness
) -> bool {
  match (left, right) {
    (SemanticClosedRecord, SemanticClosedRecord) -> true
    (SemanticOpenRecord, SemanticOpenRecord) -> true
    _ -> false
  }
}

fn semantic_record_field_name_equal(
  left: SemanticRecordFieldName,
  right: SemanticRecordFieldName
) -> bool {
  match (left, right) {
    (SemanticNamedRecordField(left_name), SemanticNamedRecordField(right_name)) ->
      left_name == right_name
    (SemanticTupleRecordField(left_position),
      SemanticTupleRecordField(right_position)) -> left_position == right_position
    _ -> false
  }
}

fn semantic_declaration_equal(
  left_hash: i64,
  right_hash: i64,
  left: DeclarationIdentity,
  right: DeclarationIdentity
) -> bool {
  left_hash == right_hash and declaration_identity_eq(left, right)
}

fn semantic_type_list_edge_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_edge: SemanticTypeListEdge,
  right: borrow SemanticTypeEqualityContext,
  right_edge: SemanticTypeListEdge
) -> bool {
  let { graph: left_graph, lists: left_lists } = left
  let { graph: right_graph, lists: right_lists } = right
  let left_imported = semantic_type_list_edge_is_imported(left_lists, left_edge)
  let right_imported = semantic_type_list_edge_is_imported(right_lists, right_edge)
  if not left_imported and not right_imported {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_list_edge_local_id(left_lists, left_edge),
      right,
      semantic_type_list_edge_local_id(right_lists, right_edge)
    )
  }
  else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_list_type_id(left_graph, left_edge),
      semantic_type_graph_list_type_id(right_graph, right_edge)
    )
  }
}

fn semantic_type_list_equal_from(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_lists: borrow SemanticTypeListLocalGraph,
  left_list: SemanticTypeListId,
  right: borrow SemanticTypeEqualityContext,
  right_lists: borrow SemanticTypeListLocalGraph,
  right_list: SemanticTypeListId,
  offset: usize
) -> bool {
  let left_len = semantic_type_list_len(left_lists, left_list)
  let right_len = semantic_type_list_len(right_lists, right_list)
  if left_len != right_len { false }
  else {
    if offset >= left_len { true }
    else {
      let left_edge = semantic_type_list_edge(left_lists, left_list, offset)
      let right_edge = semantic_type_list_edge(right_lists, right_list, offset)
      semantic_type_list_edge_equal(
        catalog,
        left,
        left_edge,
        right,
        right_edge
      ) and semantic_type_list_equal_from(
        catalog,
        left,
        left_lists,
        left_list,
        right,
        right_lists,
        right_list,
        offset + 1
      )
    }
  }
}

fn semantic_type_list_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_list: SemanticTypeListId,
  right: borrow SemanticTypeEqualityContext,
  right_list: SemanticTypeListId
) -> bool {
  let { lists: left_lists } = left
  let { lists: right_lists } = right
  semantic_type_list_equal_from(
    catalog,
    left,
    left_lists,
    left_list,
    right,
    right_lists,
    right_list,
    __i64_to_usize(0)
  )
}

fn semantic_type_list_contains(
  catalog: borrow SemanticTypeCatalog,
  haystack: borrow SemanticTypeEqualityContext,
  lists: borrow SemanticTypeListLocalGraph,
  list: SemanticTypeListId,
  needle_context: borrow SemanticTypeEqualityContext,
  needle: SemanticTypeListEdge,
  offset: usize
) -> bool {
  let length = semantic_type_list_len(lists, list)
  if offset >= length { false }
  else {
    let edge = semantic_type_list_edge(lists, list, offset)
    semantic_type_list_edge_equal(
      catalog,
      haystack,
      edge,
      needle_context,
      needle
    ) or semantic_type_list_contains(
      catalog,
      haystack,
      lists,
      list,
      needle_context,
      needle,
      offset + 1
    )
  }
}

fn semantic_type_set_is_subset_from(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_lists: borrow SemanticTypeListLocalGraph,
  left_list: SemanticTypeListId,
  right: borrow SemanticTypeEqualityContext,
  right_lists: borrow SemanticTypeListLocalGraph,
  right_list: SemanticTypeListId,
  offset: usize
) -> bool {
  let left_len = semantic_type_list_len(left_lists, left_list)
  if offset >= left_len { true }
  else {
    let edge = semantic_type_list_edge(left_lists, left_list, offset)
    semantic_type_list_contains(
      catalog,
      right,
      right_lists,
      right_list,
      left,
      edge,
      __i64_to_usize(0)
    ) and semantic_type_set_is_subset_from(
      catalog,
      left,
      left_lists,
      left_list,
      right,
      right_lists,
      right_list,
      offset + 1
    )
  }
}

fn semantic_type_set_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_list: SemanticTypeListId,
  right: borrow SemanticTypeEqualityContext,
  right_list: SemanticTypeListId
) -> bool {
  let { lists: left_lists } = left
  let { lists: right_lists } = right
  semantic_type_set_is_subset_from(
    catalog,
    left,
    left_lists,
    left_list,
    right,
    right_lists,
    right_list,
    __i64_to_usize(0)
  ) and semantic_type_set_is_subset_from(
    catalog,
    right,
    right_lists,
    right_list,
    left,
    left_lists,
    left_list,
    __i64_to_usize(0)
  )
}

fn semantic_unary_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local } = left
  let { graph: right_graph, local: right_local } = right
  let left_edge = semantic_type_local_graph_unary(left_local, left_id)
  let right_edge = semantic_type_local_graph_unary(right_local, right_id)
  let left_imported = semantic_type_local_graph_unary_is_imported(
    left_local,
    left_edge
  )
  let right_imported = semantic_type_local_graph_unary_is_imported(
    right_local,
    right_edge
  )
  if not left_imported and not right_imported {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_local_graph_unary_id(left_local, left_edge),
      right,
      semantic_type_local_graph_unary_id(right_local, right_edge)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_unary_type_id(left_graph, left_edge),
      semantic_type_graph_unary_type_id(right_graph, right_edge)
    )
  }
}

fn semantic_binary_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local } = left
  let { graph: right_graph, local: right_local } = right
  let left_edges = semantic_type_local_graph_binary(left_local, left_id)
  let right_edges = semantic_type_local_graph_binary(right_local, right_id)
  let left_left_imported = semantic_type_local_graph_binary_left_is_imported(
    left_local,
    left_edges
  )
  let right_left_imported = semantic_type_local_graph_binary_left_is_imported(
    right_local,
    right_edges
  )
  let left_right_imported = semantic_type_local_graph_binary_right_is_imported(
    left_local,
    left_edges
  )
  let right_right_imported = semantic_type_local_graph_binary_right_is_imported(
    right_local,
    right_edges
  )
  let left_equal = if not left_left_imported and not right_left_imported {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_local_graph_binary_left_id(left_local, left_edges),
      right,
      semantic_type_local_graph_binary_left_id(right_local, right_edges)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_binary_left_type_id(left_graph, left_edges),
      semantic_type_graph_binary_left_type_id(right_graph, right_edges)
    )
  }
  left_equal and if not left_right_imported and not right_right_imported {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_local_graph_binary_right_id(left_local, left_edges),
      right,
      semantic_type_local_graph_binary_right_id(right_local, right_edges)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_binary_right_type_id(left_graph, left_edges),
      semantic_type_graph_binary_right_type_id(right_graph, right_edges)
    )
  }
}

fn semantic_mutable_unary_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local } = left
  let { graph: right_graph, local: right_local } = right
  let left_edge = semantic_type_local_graph_mutable_unary(left_local, left_id)
  let right_edge = semantic_type_local_graph_mutable_unary(right_local, right_id)
  if not semantic_mutability_equal(
    semantic_type_local_graph_mutability(left_local, left_edge),
    semantic_type_local_graph_mutability(right_local, right_edge)
  ) { false }
  else {
    let left_imported = semantic_type_local_graph_mutable_unary_is_imported(
      left_local,
      left_edge
    )
    let right_imported = semantic_type_local_graph_mutable_unary_is_imported(
      right_local,
      right_edge
    )
    if not left_imported and not right_imported {
      semantic_local_type_equal(
        catalog,
        left,
        semantic_type_local_graph_mutable_unary_id(left_local, left_edge),
        right,
        semantic_type_local_graph_mutable_unary_id(right_local, right_edge)
      )
    } else {
      semantic_type_catalog_equal(
        catalog,
        semantic_type_graph_mutable_unary_type_id(left_graph, left_edge),
        semantic_type_graph_mutable_unary_type_id(right_graph, right_edge)
      )
    }
  }
}

fn semantic_array_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local } = left
  let { graph: right_graph, local: right_local } = right
  let left_edge = semantic_type_local_graph_array(left_local, left_id)
  let right_edge = semantic_type_local_graph_array(right_local, right_id)
  let left_length = semantic_type_local_graph_array_length(left_local, left_edge)
  let right_length = semantic_type_local_graph_array_length(right_local, right_edge)
  if left_length != right_length { false }
  else {
    if left_length == __i64_to_usize(0) { true }
    else {
      let left_imported = semantic_type_local_graph_array_is_imported(
        left_local,
        left_edge
      )
      let right_imported = semantic_type_local_graph_array_is_imported(
        right_local,
        right_edge
      )
      if not left_imported and not right_imported {
        semantic_local_type_equal(
          catalog,
          left,
          semantic_type_local_graph_array_id(left_local, left_edge),
          right,
          semantic_type_local_graph_array_id(right_local, right_edge)
        )
      } else {
        semantic_type_catalog_equal(
          catalog,
          semantic_type_graph_array_type_id(left_graph, left_edge),
          semantic_type_graph_array_type_id(right_graph, right_edge)
        )
      }
    }
  }
}

fn semantic_function_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let {
    graph: left_graph,
      local: left_local,
      functions: left_functions,
  } = left
  let {
    graph: right_graph,
      local: right_local,
      functions: right_functions,
  } = right
  let left_edge = semantic_type_local_graph_function(left_local, left_id)
  let right_edge = semantic_type_local_graph_function(right_local, right_id)
  if not semantic_type_list_equal(
    catalog,
    left,
    semantic_type_function_parameters(left_functions, left_edge),
    right,
    semantic_type_function_parameters(right_functions, right_edge)
  ) { false }
  else {
    let left_result_imported = semantic_type_function_result_is_imported(
      left_functions,
      left_edge
    )
    let right_result_imported = semantic_type_function_result_is_imported(
      right_functions,
      right_edge
    )
    let result_equal = if not left_result_imported and
      not right_result_imported {
        semantic_local_type_equal(
          catalog,
          left,
          semantic_type_function_result_local_id(left_functions, left_edge),
          right,
          semantic_type_function_result_local_id(right_functions, right_edge)
        )
      } else {
        semantic_type_catalog_equal(
          catalog,
          semantic_type_graph_function_result_type_id(left_graph, left_edge),
          semantic_type_graph_function_result_type_id(right_graph, right_edge)
        )
      }
    if not result_equal { false }
    else {
      let left_effects_imported = semantic_type_function_effects_are_imported(
        left_functions,
        left_edge
      )
      let right_effects_imported = semantic_type_function_effects_are_imported(
        right_functions,
        right_edge
      )
      if not left_effects_imported and not right_effects_imported {
        semantic_local_type_equal(
          catalog,
          left,
          semantic_type_function_effects_local_id(left_functions, left_edge),
          right,
          semantic_type_function_effects_local_id(right_functions, right_edge)
        )
      } else {
        semantic_type_catalog_equal(
          catalog,
          semantic_type_graph_function_effects_type_id(left_graph, left_edge),
          semantic_type_graph_function_effects_type_id(right_graph, right_edge)
        )
      }
    }
  }
}

fn semantic_effect_atom_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local, effects: left_effects } = left
  let { graph: right_graph, local: right_local, effects: right_effects } = right
  let left_edge = semantic_type_local_graph_effect_atom(left_local, left_id)
  let right_edge = semantic_type_local_graph_effect_atom(right_local, right_id)
  semantic_declaration_equal(
    semantic_type_effect_atom_declaration_hash(left_effects, left_edge),
    semantic_type_effect_atom_declaration_hash(right_effects, right_edge),
    semantic_type_graph_effect_atom_declaration(left_graph, left_edge),
    semantic_type_graph_effect_atom_declaration(right_graph, right_edge)
  ) and semantic_type_list_equal(
    catalog,
    left,
    semantic_type_effect_atom_arguments(left_effects, left_edge),
    right,
    semantic_type_effect_atom_arguments(right_effects, right_edge)
  )
}

fn semantic_effect_signature_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { local: left_local, effects: left_effects } = left
  let { local: right_local, effects: right_effects } = right
  let left_edge = semantic_type_local_graph_effect_signature(left_local, left_id)
  let right_edge = semantic_type_local_graph_effect_signature(right_local, right_id)
  let left_open = semantic_type_effect_signature_is_open(left_effects, left_edge)
  let right_open = semantic_type_effect_signature_is_open(right_effects, right_edge)
  if left_open != right_open { false }
  else {
    let same_tail = if left_open {
      semantic_type_effect_signature_tail(left_effects, left_edge) ==
        semantic_type_effect_signature_tail(right_effects, right_edge)
    } else { true }
    same_tail and semantic_type_set_equal(
      catalog,
      left,
      semantic_type_effect_signature_effects(left_effects, left_edge),
      right,
      semantic_type_effect_signature_effects(right_effects, right_edge)
    )
  }
}

fn semantic_named_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local, named: left_named } = left
  let { graph: right_graph, local: right_local, named: right_named } = right
  let left_edge = semantic_type_local_graph_named(left_local, left_id)
  let right_edge = semantic_type_local_graph_named(right_local, right_id)
  let left_role = semantic_type_named_role(left_named, left_edge)
  let right_role = semantic_type_named_role(right_named, right_edge)
  if not semantic_named_role_equal(left_role, right_role) { false }
  else {
    if not semantic_declaration_equal(
      semantic_type_named_declaration_hash(left_named, left_edge),
      semantic_type_named_declaration_hash(right_named, right_edge),
      semantic_type_graph_named_declaration(left_graph, left_edge),
      semantic_type_graph_named_declaration(right_graph, right_edge)
    ) { false }
    else {
      if not semantic_type_list_equal(
        catalog,
        left,
        semantic_type_named_arguments(left_named, left_edge),
        right,
        semantic_type_named_arguments(right_named, right_edge)
      ) { false }
      else {
        match left_role {
          SemanticOpaqueType -> true
          _ -> {
            let left_imported = semantic_type_named_representation_is_imported(
              left_named,
              left_edge
            )
            let right_imported = semantic_type_named_representation_is_imported(
              right_named,
              right_edge
            )
            if not left_imported and not right_imported {
              semantic_local_type_equal(
                catalog,
                left,
                semantic_type_named_representation_local_id(
                  left_named,
                  left_edge
                ),
                right,
                semantic_type_named_representation_local_id(
                  right_named,
                  right_edge
                )
              )
            } else {
              semantic_type_catalog_equal(
                catalog,
                semantic_type_graph_named_representation_type_id(
                  left_graph,
                  left_edge
                ),
                semantic_type_graph_named_representation_type_id(
                  right_graph,
                  right_edge
                )
              )
            }
          }
        }
      }
    }
  }
}

fn semantic_record_field_type_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_edge: SemanticRecordFieldEdge,
  right: borrow SemanticTypeEqualityContext,
  right_edge: SemanticRecordFieldEdge
) -> bool {
  let { graph: left_graph, records: left_records } = left
  let { graph: right_graph, records: right_records } = right
  let left_imported = semantic_type_record_field_is_imported(
    left_records,
    left_edge
  )
  let right_imported = semantic_type_record_field_is_imported(
    right_records,
    right_edge
  )
  if not left_imported and not right_imported {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_record_field_local_id(left_records, left_edge),
      right,
      semantic_type_record_field_local_id(right_records, right_edge)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_record_field_type_id(left_graph, left_edge),
      semantic_type_graph_record_field_type_id(right_graph, right_edge)
    )
  }
}

fn semantic_record_contains_field(
  catalog: borrow SemanticTypeCatalog,
  haystack: borrow SemanticTypeEqualityContext,
  fields: SemanticRecordFieldListId,
  needle: borrow SemanticTypeEqualityContext,
  candidate: SemanticRecordFieldEdge,
  offset: usize
) -> bool {
  let { graph: haystack_graph, records: haystack_records } = haystack
  let { graph: needle_graph, records: needle_records } = needle
  let length = semantic_type_record_field_count(haystack_records, fields)
  if offset >= length { false }
  else {
    let edge = semantic_type_record_field_edge(haystack_records, fields, offset)
    let same = semantic_type_record_field_hash(haystack_records, edge) ==
      semantic_type_record_field_hash(needle_records, candidate) and
      semantic_record_field_name_equal(
        semantic_type_graph_record_field_name(haystack_graph, edge),
        semantic_type_graph_record_field_name(needle_graph, candidate)
      ) and semantic_record_field_type_equal(
        catalog,
        haystack,
        edge,
        needle,
        candidate
      )
    same or semantic_record_contains_field(
      catalog,
      haystack,
      fields,
      needle,
      candidate,
      offset + 1
    )
  }
}

fn semantic_record_fields_equal_from(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_fields: SemanticRecordFieldListId,
  right: borrow SemanticTypeEqualityContext,
  right_fields: SemanticRecordFieldListId,
  offset: usize
) -> bool {
  let { records: left_records } = left
  let { records: right_records } = right
  let left_len = semantic_type_record_field_count(left_records, left_fields)
  let right_len = semantic_type_record_field_count(right_records, right_fields)
  if left_len != right_len { false }
  else {
    if offset >= left_len { true }
    else {
      semantic_record_contains_field(
        catalog,
        right,
        right_fields,
        left,
        semantic_type_record_field_edge(left_records, left_fields, offset),
        __i64_to_usize(0)
      ) and semantic_record_fields_equal_from(
        catalog,
        left,
        left_fields,
        right,
        right_fields,
        offset + 1
      )
    }
  }
}

fn semantic_record_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { local: left_local, records: left_records } = left
  let { local: right_local, records: right_records } = right
  let left_edge = semantic_type_local_graph_record(left_local, left_id)
  let right_edge = semantic_type_local_graph_record(right_local, right_id)
  semantic_record_shape_equal(
    semantic_type_record_shape(left_records, left_edge),
    semantic_type_record_shape(right_records, right_edge)
  ) and semantic_record_openness_equal(
    semantic_type_record_openness(left_records, left_edge),
    semantic_type_record_openness(right_records, right_edge)
  ) and semantic_record_fields_equal_from(
    catalog,
    left,
    semantic_type_record_fields(left_records, left_edge),
    right,
    semantic_type_record_fields(right_records, right_edge),
    __i64_to_usize(0)
  )
}

fn semantic_variant_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local, variants: left_variants } = left
  let { graph: right_graph, local: right_local, variants: right_variants } = right
  let left_edge = semantic_type_local_graph_variant(left_local, left_id)
  let right_edge = semantic_type_local_graph_variant(right_local, right_id)
  semantic_declaration_equal(
    semantic_type_variant_declaration_hash(left_variants, left_edge),
    semantic_type_variant_declaration_hash(right_variants, right_edge),
    semantic_type_graph_variant_declaration(left_graph, left_edge),
    semantic_type_graph_variant_declaration(right_graph, right_edge)
  ) and if not semantic_type_variant_payload_is_imported(
    left_variants,
    left_edge
  ) and not semantic_type_variant_payload_is_imported(
    right_variants,
    right_edge
  ) {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_variant_payload_local_id(left_variants, left_edge),
      right,
      semantic_type_variant_payload_local_id(right_variants, right_edge)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_variant_payload_type_id(left_graph, left_edge),
      semantic_type_graph_variant_payload_type_id(right_graph, right_edge)
    )
  }
}

fn semantic_variable_equal(
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { local: left_local, variables: left_variables } = left
  let { local: right_local, variables: right_variables } = right
  let left_edge = semantic_type_local_graph_variable(left_local, left_id)
  let right_edge = semantic_type_local_graph_variable(right_local, right_id)
  let left_self = semantic_type_variable_is_self(left_variables, left_edge)
  let right_self = semantic_type_variable_is_self(right_variables, right_edge)
  left_self == right_self and if left_self { true }
  else {
    semantic_type_variable_parameter(left_variables, left_edge) ==
      semantic_type_variable_parameter(right_variables, right_edge)
  }
}

fn semantic_trait_binding_type_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_edge: SemanticTraitBindingEdge,
  right: borrow SemanticTypeEqualityContext,
  right_edge: SemanticTraitBindingEdge
) -> bool {
  let { graph: left_graph, traits: left_traits } = left
  let { graph: right_graph, traits: right_traits } = right
  if not semantic_type_trait_binding_type_is_imported(left_traits, left_edge) and
    not semantic_type_trait_binding_type_is_imported(right_traits, right_edge) {
      semantic_local_type_equal(
        catalog,
        left,
        semantic_type_trait_binding_type_local_id(left_traits, left_edge),
        right,
        semantic_type_trait_binding_type_local_id(right_traits, right_edge)
      )
    } else {
      semantic_type_catalog_equal(
        catalog,
        semantic_type_graph_trait_binding_type_id(left_graph, left_edge),
        semantic_type_graph_trait_binding_type_id(right_graph, right_edge)
      )
    }
}

fn semantic_trait_binding_matches_from(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_edge: SemanticTraitBindingEdge,
  right: borrow SemanticTypeEqualityContext,
  right_bindings: SemanticTraitBindingListId,
  offset: usize
) -> bool {
  let { graph: left_graph, traits: left_traits } = left
  let { graph: right_graph, traits: right_traits } = right
  if offset >= semantic_type_trait_binding_count(right_traits, right_bindings) {
    false
  } else {
    let right_edge = semantic_type_trait_binding_edge(
      right_traits,
      right_bindings,
      offset
    )
    if semantic_declaration_equal(
      semantic_type_trait_binding_declaration_hash(left_traits, left_edge),
      semantic_type_trait_binding_declaration_hash(right_traits, right_edge),
      semantic_type_graph_trait_binding_declaration(left_graph, left_edge),
      semantic_type_graph_trait_binding_declaration(right_graph, right_edge)
    ) {
      semantic_trait_binding_type_equal(
        catalog,
        left,
        left_edge,
        right,
        right_edge
      )
    } else {
      semantic_trait_binding_matches_from(
        catalog,
        left,
        left_edge,
        right,
        right_bindings,
        offset + 1
      )
    }
  }
}

fn semantic_trait_bindings_equal_from(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_bindings: SemanticTraitBindingListId,
  right: borrow SemanticTypeEqualityContext,
  right_bindings: SemanticTraitBindingListId,
  offset: usize
) -> bool {
  let { traits: left_traits } = left
  if offset >= semantic_type_trait_binding_count(left_traits, left_bindings) {
    true
  } else {
    semantic_trait_binding_matches_from(
      catalog,
      left,
      semantic_type_trait_binding_edge(left_traits, left_bindings, offset),
      right,
      right_bindings,
      __i64_to_usize(0)
    ) and semantic_trait_bindings_equal_from(
      catalog,
      left,
      left_bindings,
      right,
      right_bindings,
      offset + 1
    )
  }
}

fn semantic_trait_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local, traits: left_traits } = left
  let { graph: right_graph, local: right_local, traits: right_traits } = right
  let left_edge = semantic_type_local_graph_trait(left_local, left_id)
  let right_edge = semantic_type_local_graph_trait(right_local, right_id)
  semantic_declaration_equal(
    semantic_type_trait_declaration_hash(left_traits, left_edge),
    semantic_type_trait_declaration_hash(right_traits, right_edge),
    semantic_type_graph_trait_declaration(left_graph, left_edge),
    semantic_type_graph_trait_declaration(right_graph, right_edge)
  ) and {
    let left_bindings = semantic_type_trait_bindings(left_edge)
    let right_bindings = semantic_type_trait_bindings(right_edge)
    semantic_type_trait_binding_count(left_traits, left_bindings) ==
      semantic_type_trait_binding_count(right_traits, right_bindings) and
      semantic_trait_bindings_equal_from(
        catalog,
        left,
        left_bindings,
        right,
        right_bindings,
        __i64_to_usize(0)
      )
  }
}

fn semantic_associated_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let {
    graph: left_graph,
      local: left_local,
      associated: left_associated,
  } = left
  let {
    graph: right_graph,
      local: right_local,
      associated: right_associated,
  } = right
  let left_edge = semantic_type_local_graph_associated(left_local, left_id)
  let right_edge = semantic_type_local_graph_associated(right_local, right_id)
  semantic_declaration_equal(
    semantic_type_associated_declaration_hash(left_associated, left_edge),
    semantic_type_associated_declaration_hash(right_associated, right_edge),
    semantic_type_graph_associated_declaration(left_graph, left_edge),
    semantic_type_graph_associated_declaration(right_graph, right_edge)
  ) and if not semantic_type_associated_base_is_imported(
    left_associated,
    left_edge
  ) and not semantic_type_associated_base_is_imported(
    right_associated,
    right_edge
  ) {
    semantic_local_type_equal(
      catalog,
      left,
      semantic_type_associated_base_local_id(left_associated, left_edge),
      right,
      semantic_type_associated_base_local_id(right_associated, right_edge)
    )
  } else {
    semantic_type_catalog_equal(
      catalog,
      semantic_type_graph_associated_base_type_id(left_graph, left_edge),
      semantic_type_graph_associated_base_type_id(right_graph, right_edge)
    )
  }
}

fn semantic_local_type_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  let { graph: left_graph, local: left_local } = left
  let { graph: right_graph, local: right_local } = right
  -- A different local ordinal cannot be the same node; check that scalar
  -- fact before materializing retained segment identities.
  if semantic_local_type_id_eq(left_id, right_id) and semantic_type_segment_id_eq(
    semantic_type_graph_segment(left_graph),
    semantic_type_graph_segment(right_graph)
  ) { true }
  else {
    match (
      semantic_type_graph_kind_local(left_local, left_id),
      semantic_type_graph_kind_local(right_local, right_id)
    ) {
      (SemanticBottomKind, SemanticBottomKind) -> true
      (SemanticTopKind, SemanticTopKind) -> true
      (SemanticPrimitiveKind, SemanticPrimitiveKind) -> semantic_primitive_equal(
        semantic_type_local_graph_primitive(left_local, left_id),
        semantic_type_local_graph_primitive(right_local, right_id)
      )
      (SemanticUnionKind, SemanticUnionKind) -> semantic_binary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticIntersectionKind, SemanticIntersectionKind) ->
        semantic_binary_equal(catalog, left, left_id, right, right_id)
      (SemanticComplementKind, SemanticComplementKind) -> semantic_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticContinuationKind, SemanticContinuationKind) ->
        semantic_binary_equal(catalog, left, left_id, right, right_id)
      (SemanticWeakKind, SemanticWeakKind) -> semantic_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticAtomicKind, SemanticAtomicKind) -> semantic_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticUniqueKind, SemanticUniqueKind) -> semantic_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticOwnedKind, SemanticOwnedKind) -> semantic_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticPointerKind, SemanticPointerKind) -> semantic_mutable_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticBorrowKind, SemanticBorrowKind) -> semantic_mutable_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticSliceKind, SemanticSliceKind) -> semantic_mutable_unary_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticArrayKind, SemanticArrayKind) -> semantic_array_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticFunctionKind, SemanticFunctionKind) -> semantic_function_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticEffectAtomKind, SemanticEffectAtomKind) ->
        semantic_effect_atom_equal(catalog, left, left_id, right, right_id)
      (SemanticEffectSignatureKind, SemanticEffectSignatureKind) ->
        semantic_effect_signature_equal(catalog, left, left_id, right, right_id)
      (SemanticNamedKind, SemanticNamedKind) -> semantic_named_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticRecordKind, SemanticRecordKind) -> semantic_record_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticVariantKind, SemanticVariantKind) -> semantic_variant_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticVariableKind, SemanticVariableKind) -> semantic_variable_equal(
        left,
        left_id,
        right,
        right_id
      )
      (SemanticTraitKind, SemanticTraitKind) -> semantic_trait_equal(
        catalog,
        left,
        left_id,
        right,
        right_id
      )
      (SemanticAssociatedKind, SemanticAssociatedKind) ->
        semantic_associated_equal(catalog, left, left_id, right, right_id)
      _ -> false
    }
  }
}

pub(package) fn semantic_type_catalog_context_equal(
  catalog: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeEqualityContext,
  left_id: SemanticLocalTypeId,
  right: borrow SemanticTypeEqualityContext,
  right_id: SemanticLocalTypeId
) -> bool {
  semantic_local_type_equal(catalog, left, left_id, right, right_id)
}

pub(package) fn semantic_type_catalog_equal(
  catalog: borrow SemanticTypeCatalog,
  left: SemanticTypeId,
  right: SemanticTypeId
) -> bool {
  match (
    catalog.segment(semantic_type_id_segment(left)),
    catalog.segment(semantic_type_id_segment(right))
  ) {
    (
      Some(SemanticTypeCatalogSegmentValue(left_context)),
      Some(SemanticTypeCatalogSegmentValue(right_context)),
    ) -> {
      let { graph: left_graph } = left_context
      let { graph: right_graph } = right_context
      if not semantic_type_graph_contains(left_graph, left) or
        not semantic_type_graph_contains(right_graph, right) { false }
      else {
        if semantic_type_id_eq(left, right) { true }
        else {
          semantic_local_type_equal(
            catalog,
            left_context,
            semantic_type_graph_local_id(left_graph, left),
            right_context,
            semantic_type_graph_local_id(right_graph, right)
          )
        }
      }
    }
    _ -> false
  }
}

pub(package) fn semantic_type_graph_equal_within_segment(
  graph: SemanticTypeGraph,
  left: SemanticTypeId,
  right: SemanticTypeId
) -> bool {
  if not semantic_type_graph_contains(graph, left) or
    not semantic_type_graph_contains(graph, right) { false }
  else {
    let catalog = semantic_type_catalog_single(graph)
    semantic_type_catalog_equal(catalog, left, right)
  }
}
