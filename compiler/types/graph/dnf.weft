-- Disjunctive normal form over catalogued semantic-type graphs.
--
-- A DNF is stored as parallel clause columns. Each clause contains positive
-- and negative semantic atoms; compound union, intersection and complement
-- nodes are eliminated by normalization. Complete ids remain as atoms so an
-- imported child keeps exact segment identity without a global type table.

use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type SemanticDnf {
  positive_clauses: List<List<SemanticTypeId>>,
  negative_clauses: List<List<SemanticTypeId>>
}

fn semantic_dnf_from_columns(
  positive_clauses: List<List<SemanticTypeId>>,
  negative_clauses: List<List<SemanticTypeId>>
) -> SemanticDnf {
  if positive_clauses.len() != negative_clauses.len() {
    panic("Semantic DNF clause columns have different lengths")
  } else {
    SemanticDnf {
      positive_clauses: positive_clauses,
      negative_clauses: negative_clauses
    }
  }
}

pub(package) fn semantic_dnf_positive_clauses(
  dnf: SemanticDnf
) -> List<List<SemanticTypeId>> {
  let { positive_clauses } = dnf
  positive_clauses
}

pub(package) fn semantic_dnf_negative_clauses(
  dnf: SemanticDnf
) -> List<List<SemanticTypeId>> {
  let { negative_clauses } = dnf
  negative_clauses
}

pub(package) fn semantic_dnf_clause_count(
  dnf: SemanticDnf
) -> usize {
  semantic_dnf_positive_clauses(dnf).len()
}

pub(package) fn semantic_dnf_empty() -> SemanticDnf {
  semantic_dnf_from_columns(
    Nil<List<SemanticTypeId>>(),
    Nil<List<SemanticTypeId>>()
  )
}

pub(package) fn semantic_dnf_any() -> SemanticDnf {
  semantic_dnf_from_columns(
    Cons<List<SemanticTypeId>>(
      Nil<SemanticTypeId>(),
      Nil<List<SemanticTypeId>>()
    ),
    Cons<List<SemanticTypeId>>(
      Nil<SemanticTypeId>(),
      Nil<List<SemanticTypeId>>()
    )
  )
}

pub(package) fn semantic_dnf_atom(atom: SemanticTypeId) -> SemanticDnf {
  semantic_dnf_from_columns(
    Cons<List<SemanticTypeId>>(
      Cons<SemanticTypeId>(atom, Nil<SemanticTypeId>()),
      Nil<List<SemanticTypeId>>()
    ),
    Cons<List<SemanticTypeId>>(
      Nil<SemanticTypeId>(),
      Nil<List<SemanticTypeId>>()
    )
  )
}

pub(package) fn semantic_dnf_union(
  left: SemanticDnf,
  right: SemanticDnf
) -> SemanticDnf {
  semantic_dnf_from_columns(
    semantic_dnf_positive_clauses(left).concat(
      semantic_dnf_positive_clauses(right)
    ),
    semantic_dnf_negative_clauses(left).concat(
      semantic_dnf_negative_clauses(right)
    )
  )
}

fn semantic_dnf_intersect_clause(
  left_positive: List<SemanticTypeId>,
  left_negative: List<SemanticTypeId>,
  right_positives: List<List<SemanticTypeId>>,
  right_negatives: List<List<SemanticTypeId>>
) -> SemanticDnf {
  match (right_positives, right_negatives) {
    (Nil, Nil) -> semantic_dnf_empty()
    (
      Cons(right_positive, remaining_positives),
      Cons(right_negative, remaining_negatives),
    ) -> {
      let rest = semantic_dnf_intersect_clause(
        left_positive,
        left_negative,
        remaining_positives,
        remaining_negatives
      )
      semantic_dnf_from_columns(
        Cons<List<SemanticTypeId>>(
          left_positive.concat(right_positive),
          semantic_dnf_positive_clauses(rest)
        ),
        Cons<List<SemanticTypeId>>(
          left_negative.concat(right_negative),
          semantic_dnf_negative_clauses(rest)
        )
      )
    }
    _ -> panic("Semantic DNF clause columns diverged during intersection")
  }
}

fn semantic_dnf_intersect_from(
  left_positives: List<List<SemanticTypeId>>,
  left_negatives: List<List<SemanticTypeId>>,
  right_positives: List<List<SemanticTypeId>>,
  right_negatives: List<List<SemanticTypeId>>
) -> SemanticDnf {
  match (left_positives, left_negatives) {
    (Nil, Nil) -> semantic_dnf_empty()
    (
      Cons(left_positive, remaining_positives),
      Cons(left_negative, remaining_negatives),
    ) -> semantic_dnf_union(
      semantic_dnf_intersect_clause(
        left_positive,
        left_negative,
        right_positives,
        right_negatives
      ),
      semantic_dnf_intersect_from(
        remaining_positives,
        remaining_negatives,
        right_positives,
        right_negatives
      )
    )
    _ -> panic("Semantic DNF clause columns diverged during intersection")
  }
}

pub(package) fn semantic_dnf_intersection(
  left: SemanticDnf,
  right: SemanticDnf
) -> SemanticDnf {
  semantic_dnf_intersect_from(
    semantic_dnf_positive_clauses(left),
    semantic_dnf_negative_clauses(left),
    semantic_dnf_positive_clauses(right),
    semantic_dnf_negative_clauses(right)
  )
}

fn semantic_dnf_negated_positive_atoms(
  atoms: List<SemanticTypeId>
) -> SemanticDnf {
  match atoms {
    Nil -> semantic_dnf_empty()
    Cons(atom, rest) -> {
      let remaining = semantic_dnf_negated_positive_atoms(rest)
      semantic_dnf_from_columns(
        Cons<List<SemanticTypeId>>(
          Nil<SemanticTypeId>(),
          semantic_dnf_positive_clauses(remaining)
        ),
        Cons<List<SemanticTypeId>>(
          Cons<SemanticTypeId>(atom, Nil<SemanticTypeId>()),
          semantic_dnf_negative_clauses(remaining)
        )
      )
    }
  }
}

fn semantic_dnf_negated_negative_atoms(
  atoms: List<SemanticTypeId>
) -> SemanticDnf {
  match atoms {
    Nil -> semantic_dnf_empty()
    Cons(atom, rest) -> {
      let remaining = semantic_dnf_negated_negative_atoms(rest)
      semantic_dnf_from_columns(
        Cons<List<SemanticTypeId>>(
          Cons<SemanticTypeId>(atom, Nil<SemanticTypeId>()),
          semantic_dnf_positive_clauses(remaining)
        ),
        Cons<List<SemanticTypeId>>(
          Nil<SemanticTypeId>(),
          semantic_dnf_negative_clauses(remaining)
        )
      )
    }
  }
}

fn semantic_dnf_negate_clause(
  positive: List<SemanticTypeId>,
  negative: List<SemanticTypeId>
) -> SemanticDnf {
  semantic_dnf_union(
    semantic_dnf_negated_positive_atoms(positive),
    semantic_dnf_negated_negative_atoms(negative)
  )
}

fn semantic_dnf_complement_rest(
  current: SemanticDnf,
  positive_clauses: List<List<SemanticTypeId>>,
  negative_clauses: List<List<SemanticTypeId>>
) -> SemanticDnf {
  match (positive_clauses, negative_clauses) {
    (Nil, Nil) -> current
    (
      Cons(positive, remaining_positives),
      Cons(negative, remaining_negatives),
    ) -> semantic_dnf_complement_rest(
      semantic_dnf_intersection(
        current,
        semantic_dnf_negate_clause(positive, negative)
      ),
      remaining_positives,
      remaining_negatives
    )
    _ -> panic("Semantic DNF clause columns diverged during complement")
  }
}

fn semantic_dnf_complement_general(
  inner: SemanticDnf
) -> SemanticDnf {
  match (
    semantic_dnf_positive_clauses(inner),
    semantic_dnf_negative_clauses(inner),
  ) {
    (Nil, Nil) -> semantic_dnf_any()
    (
      Cons(positive, remaining_positives),
      Cons(negative, remaining_negatives),
    ) -> semantic_dnf_complement_rest(
      semantic_dnf_negate_clause(positive, negative),
      remaining_positives,
      remaining_negatives
    )
    _ -> panic("Semantic DNF clause columns diverged during complement")
  }
}

pub(package) fn semantic_dnf_complement(
  inner: SemanticDnf
) -> SemanticDnf {
  match (
    semantic_dnf_positive_clauses(inner),
    semantic_dnf_negative_clauses(inner),
  ) {
    (
      Cons(Cons(atom, Nil), Nil),
      Cons(Nil, Nil),
    ) -> semantic_dnf_from_columns(
      Cons<List<SemanticTypeId>>(
        Nil<SemanticTypeId>(),
        Nil<List<SemanticTypeId>>()
      ),
      Cons<List<SemanticTypeId>>(
        Cons<SemanticTypeId>(atom, Nil<SemanticTypeId>()),
        Nil<List<SemanticTypeId>>()
      )
    )
    _ -> semantic_dnf_complement_general(inner)
  }
}

fn semantic_dnf_required_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic DNF id is outside its segment") }
    None -> panic("Semantic DNF catalog is missing a segment")
  }
}

pub(package) fn semantic_type_to_dnf(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticDnf {
  let graph = semantic_dnf_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  let local_id = semantic_type_graph_local_id(graph, id)
  match semantic_type_graph_kind_local(local, local_id) {
    SemanticBottomKind -> semantic_dnf_empty()
    SemanticTopKind -> semantic_dnf_any()
    SemanticPrimitiveKind -> semantic_dnf_atom(id)
    SemanticUnionKind -> {
      let edges = semantic_type_local_graph_binary(local, local_id)
      semantic_dnf_union(
        semantic_type_to_dnf(
          catalog,
          semantic_type_graph_binary_left_type_id(graph, edges)
        ),
        semantic_type_to_dnf(
          catalog,
          semantic_type_graph_binary_right_type_id(graph, edges)
        )
      )
    }
    SemanticIntersectionKind -> {
      let edges = semantic_type_local_graph_binary(local, local_id)
      semantic_dnf_intersection(
        semantic_type_to_dnf(
          catalog,
          semantic_type_graph_binary_left_type_id(graph, edges)
        ),
        semantic_type_to_dnf(
          catalog,
          semantic_type_graph_binary_right_type_id(graph, edges)
        )
      )
    }
    SemanticComplementKind -> {
      let edge = semantic_type_local_graph_unary(local, local_id)
      semantic_dnf_complement(
        semantic_type_to_dnf(
          catalog,
          semantic_type_graph_unary_type_id(graph, edge)
        )
      )
    }
    _ -> semantic_dnf_atom(id)
  }
}
