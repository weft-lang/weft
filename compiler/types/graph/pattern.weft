-- Generic semantic-type pattern matching for resolved implementation targets.
--
-- Pattern variables bind complete type ids. Repeated variables are equality
-- constraints, and every other node is matched structurally through the
-- checked-program segment catalog. No raw type node or checker table enters
-- the matching boundary.

use compiler/project/identity.{DeclarationIdentity}
use compiler/project/identity/equality.{declaration_identity_eq}
use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_bind,
  semantic_type_substitution_empty,
  semantic_type_substitution_get
}
use stdlib/option.{None, Some}
use stdlib/panic.{panic}

pub(package) type SemanticTypePatternMatch {
  SemanticTypePatternMatched(SemanticTypeSubstitution),
  SemanticTypePatternRejected
}

fn semantic_pattern_required_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic pattern id is outside its segment") }
    None -> panic("Semantic pattern catalog is missing a segment")
  }
}

fn semantic_pattern_primitive_equal(
  pattern: SemanticPrimitive,
  concrete: SemanticPrimitive
) -> bool {
  match (pattern, concrete) {
    (SemanticI64, SemanticI64) -> true
    (SemanticStr, SemanticStr) -> true
    (SemanticBool, SemanticBool) -> true
    (SemanticNil, SemanticNil) -> true
    (SemanticF64, SemanticF64) -> true
    (SemanticI32, SemanticI32) -> true
    (SemanticI8, SemanticI8) -> true
    (SemanticI16, SemanticI16) -> true
    (SemanticU8, SemanticU8) -> true
    (SemanticU16, SemanticU16) -> true
    (SemanticU32, SemanticU32) -> true
    (SemanticU64, SemanticU64) -> true
    (SemanticIsize, SemanticIsize) -> true
    (SemanticUsize, SemanticUsize) -> true
    (SemanticF32, SemanticF32) -> true
    _ -> false
  }
}

fn semantic_pattern_mutability_equal(
  pattern: SemanticMutability,
  concrete: SemanticMutability
) -> bool {
  match (pattern, concrete) {
    (SemanticImmutable, SemanticImmutable) -> true
    (SemanticMutable, SemanticMutable) -> true
    _ -> false
  }
}

fn semantic_pattern_named_role_equal(
  pattern: SemanticNamedRole,
  concrete: SemanticNamedRole
) -> bool {
  match (pattern, concrete) {
    (SemanticOpaqueType, SemanticOpaqueType) -> true
    (SemanticNominalType, SemanticNominalType) -> true
    (SemanticPayloadlessVariantType, SemanticPayloadlessVariantType) -> true
    _ -> false
  }
}

fn semantic_pattern_record_shape_equal(
  pattern: SemanticRecordShape,
  concrete: SemanticRecordShape
) -> bool {
  match (pattern, concrete) {
    (SemanticStructuralRecord, SemanticStructuralRecord) -> true
    (SemanticTupleRecord, SemanticTupleRecord) -> true
    _ -> false
  }
}

fn semantic_pattern_record_openness_equal(
  pattern: SemanticRecordOpenness,
  concrete: SemanticRecordOpenness
) -> bool {
  match (pattern, concrete) {
    (SemanticClosedRecord, SemanticClosedRecord) -> true
    (SemanticOpenRecord, SemanticOpenRecord) -> true
    _ -> false
  }
}

fn semantic_pattern_effect_tail_equal(
  pattern: SemanticEffectTail,
  concrete: SemanticEffectTail
) -> bool {
  match (pattern, concrete) {
    (SemanticClosedEffects, SemanticClosedEffects) -> true
    (SemanticOpenEffects(left), SemanticOpenEffects(right)) -> left == right
    _ -> false
  }
}

fn semantic_pattern_type_list_from(
  catalog: borrow SemanticTypeCatalog,
  pattern_graph: borrow SemanticTypeGraph,
  pattern: SemanticTypeListId,
  concrete_graph: borrow SemanticTypeGraph,
  concrete: SemanticTypeListId,
  offset: usize,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  let pattern_lists = semantic_type_graph_type_lists_local(pattern_graph)
  let concrete_lists = semantic_type_graph_type_lists_local(concrete_graph)
  let pattern_length = semantic_type_list_len(pattern_lists, pattern)
  let concrete_length = semantic_type_list_len(concrete_lists, concrete)
  if pattern_length != concrete_length { SemanticTypePatternRejected }
  else {
    if offset >= pattern_length { SemanticTypePatternMatched(substitution) }
    else {
      let pattern_item = semantic_type_graph_list_type_id(
        pattern_graph,
        semantic_type_list_edge(pattern_lists, pattern, offset)
      )
      let concrete_item = semantic_type_graph_list_type_id(
        concrete_graph,
        semantic_type_list_edge(concrete_lists, concrete, offset)
      )
      match semantic_type_pattern_match_with(
        catalog,
        pattern_item,
        concrete_item,
        concrete_substitution,
        substitution
      ) {
        SemanticTypePatternRejected -> SemanticTypePatternRejected
        SemanticTypePatternMatched(next) -> semantic_pattern_type_list_from(
          catalog,
          pattern_graph,
          pattern,
          concrete_graph,
          concrete,
          offset + 1,
          concrete_substitution,
          next
        )
      }
    }
  }
}

fn semantic_pattern_type_list(
  catalog: borrow SemanticTypeCatalog,
  pattern_graph: borrow SemanticTypeGraph,
  pattern: SemanticTypeListId,
  concrete_graph: borrow SemanticTypeGraph,
  concrete: SemanticTypeListId,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  semantic_pattern_type_list_from(
    catalog,
    pattern_graph,
    pattern,
    concrete_graph,
    concrete,
    __i64_to_usize(0),
    concrete_substitution,
    substitution
  )
}

fn semantic_pattern_pair(
  catalog: borrow SemanticTypeCatalog,
  pattern_left: SemanticTypeId,
  pattern_right: SemanticTypeId,
  concrete_left: SemanticTypeId,
  concrete_right: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  match semantic_type_pattern_match_with(
    catalog,
    pattern_left,
    concrete_left,
    concrete_substitution,
    substitution
  ) {
    SemanticTypePatternRejected -> SemanticTypePatternRejected
    SemanticTypePatternMatched(next) -> semantic_type_pattern_match_with(
      catalog,
      pattern_right,
      concrete_right,
      concrete_substitution,
      next
    )
  }
}

fn semantic_pattern_record_field_matches(
  pattern_graph: borrow SemanticTypeGraph,
  pattern_edge: SemanticRecordFieldEdge,
  concrete_graph: borrow SemanticTypeGraph,
  concrete_edge: SemanticRecordFieldEdge
) -> bool {
  let pattern_name = semantic_type_graph_record_field_name(
    pattern_graph,
    pattern_edge
  )
  let concrete_name = semantic_type_graph_record_field_name(
    concrete_graph,
    concrete_edge
  )
  match (pattern_name, concrete_name) {
    (SemanticTupleRecordField(left), SemanticTupleRecordField(right)) -> left == right
    (SemanticNamedRecordField(left), SemanticNamedRecordField(right)) -> left == right
    _ -> false
  }
}

fn semantic_pattern_record_find_field_from(
  pattern_graph: borrow SemanticTypeGraph,
  pattern_edge: SemanticRecordFieldEdge,
  concrete_graph: borrow SemanticTypeGraph,
  concrete_fields: SemanticRecordFieldListId,
  offset: usize
) -> Option<SemanticRecordFieldEdge> {
  let concrete_records = semantic_type_graph_records_local(concrete_graph)
  if offset >= semantic_type_record_field_count(concrete_records, concrete_fields) {
    None<SemanticRecordFieldEdge>()
  } else {
    let concrete_edge = semantic_type_record_field_edge(
      concrete_records,
      concrete_fields,
      offset
    )
    if semantic_pattern_record_field_matches(
      pattern_graph,
      pattern_edge,
      concrete_graph,
      concrete_edge
    ) { Some<SemanticRecordFieldEdge>(concrete_edge) }
    else {
      semantic_pattern_record_find_field_from(
        pattern_graph,
        pattern_edge,
        concrete_graph,
        concrete_fields,
        offset + 1
      )
    }
  }
}

fn semantic_pattern_record_fields_from(
  catalog: borrow SemanticTypeCatalog,
  pattern_graph: borrow SemanticTypeGraph,
  pattern_fields: SemanticRecordFieldListId,
  concrete_graph: borrow SemanticTypeGraph,
  concrete_fields: SemanticRecordFieldListId,
  offset: usize,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  let pattern_records = semantic_type_graph_records_local(pattern_graph)
  let concrete_records = semantic_type_graph_records_local(concrete_graph)
  let pattern_count = semantic_type_record_field_count(
    pattern_records,
    pattern_fields
  )
  let concrete_count = semantic_type_record_field_count(
    concrete_records,
    concrete_fields
  )
  if pattern_count != concrete_count { SemanticTypePatternRejected }
  else {
    if offset >= pattern_count { SemanticTypePatternMatched(substitution) }
    else {
      let pattern_edge = semantic_type_record_field_edge(
        pattern_records,
        pattern_fields,
        offset
      )
      match semantic_pattern_record_find_field_from(
        pattern_graph,
        pattern_edge,
        concrete_graph,
        concrete_fields,
        __i64_to_usize(0)
      ) {
        None -> SemanticTypePatternRejected
        Some(concrete_edge) -> match semantic_type_pattern_match_with(
          catalog,
          semantic_type_graph_record_field_type_id(pattern_graph, pattern_edge),
          semantic_type_graph_record_field_type_id(concrete_graph, concrete_edge),
          concrete_substitution,
          substitution
        ) {
          SemanticTypePatternRejected -> SemanticTypePatternRejected
          SemanticTypePatternMatched(next) -> semantic_pattern_record_fields_from(
            catalog,
            pattern_graph,
            pattern_fields,
            concrete_graph,
            concrete_fields,
            offset + 1,
            concrete_substitution,
            next
          )
        }
      }
    }
  }
}

fn semantic_pattern_trait_binding_matches_from(
  catalog: borrow SemanticTypeCatalog,
  pattern_graph: borrow SemanticTypeGraph,
  pattern_edge: SemanticTraitBindingEdge,
  concrete_graph: borrow SemanticTypeGraph,
  concrete_bindings: SemanticTraitBindingListId,
  offset: usize,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  let pattern_traits = semantic_type_graph_traits_local(pattern_graph)
  let concrete_traits = semantic_type_graph_traits_local(concrete_graph)
  if offset >= semantic_type_trait_binding_count(concrete_traits, concrete_bindings) {
    SemanticTypePatternRejected
  } else {
    let concrete_edge = semantic_type_trait_binding_edge(
      concrete_traits,
      concrete_bindings,
      offset
    )
    if declaration_identity_eq(
      semantic_type_graph_trait_binding_declaration(pattern_graph, pattern_edge),
      semantic_type_graph_trait_binding_declaration(concrete_graph, concrete_edge)
    ) {
      semantic_type_pattern_match_with(
        catalog,
        semantic_type_graph_trait_binding_type_id(pattern_graph, pattern_edge),
        semantic_type_graph_trait_binding_type_id(concrete_graph, concrete_edge),
        concrete_substitution,
        substitution
      )
    } else {
      semantic_pattern_trait_binding_matches_from(
        catalog,
        pattern_graph,
        pattern_edge,
        concrete_graph,
        concrete_bindings,
        offset + 1,
        concrete_substitution,
        substitution
      )
    }
  }
}

fn semantic_pattern_trait_bindings_from(
  catalog: borrow SemanticTypeCatalog,
  pattern_graph: borrow SemanticTypeGraph,
  pattern_bindings: SemanticTraitBindingListId,
  concrete_graph: borrow SemanticTypeGraph,
  concrete_bindings: SemanticTraitBindingListId,
  offset: usize,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  let pattern_traits = semantic_type_graph_traits_local(pattern_graph)
  let concrete_traits = semantic_type_graph_traits_local(concrete_graph)
  let pattern_count = semantic_type_trait_binding_count(
    pattern_traits,
    pattern_bindings
  )
  if pattern_count != semantic_type_trait_binding_count(
    concrete_traits,
    concrete_bindings
  ) { SemanticTypePatternRejected }
  else {
    if offset >= pattern_count { SemanticTypePatternMatched(substitution) }
    else {
      match semantic_pattern_trait_binding_matches_from(
        catalog,
        pattern_graph,
        semantic_type_trait_binding_edge(pattern_traits, pattern_bindings, offset),
        concrete_graph,
        concrete_bindings,
        __i64_to_usize(0),
        concrete_substitution,
        substitution
      ) {
        SemanticTypePatternRejected -> SemanticTypePatternRejected
        SemanticTypePatternMatched(next) -> semantic_pattern_trait_bindings_from(
          catalog,
          pattern_graph,
          pattern_bindings,
          concrete_graph,
          concrete_bindings,
          offset + 1,
          concrete_substitution,
          next
        )
      }
    }
  }
}

fn semantic_pattern_variable(
  catalog: borrow SemanticTypeCatalog,
  variable: SemanticTypeVariable,
  concrete: SemanticTypeId,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  match variable {
    SemanticSelfVariable -> {
      let concrete_graph = semantic_pattern_required_graph(catalog, concrete)
      match semantic_type_graph_node(concrete_graph, concrete) {
        SemanticVariableNode(SemanticSelfVariable) ->
          SemanticTypePatternMatched(substitution)
        _ -> SemanticTypePatternRejected
      }
    }
    SemanticParameterVariable(_) -> match semantic_type_substitution_get(
      substitution,
      variable
    ) {
      Some(bound) -> if semantic_type_catalog_equal(catalog, bound, concrete) {
        SemanticTypePatternMatched(substitution)
      } else { SemanticTypePatternRejected }
      None -> SemanticTypePatternMatched(
        semantic_type_substitution_bind(substitution, variable, concrete)
      )
    }
  }
}

fn semantic_type_pattern_match_with(
  catalog: borrow SemanticTypeCatalog,
  pattern: SemanticTypeId,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution,
  substitution: SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  let pattern_graph = semantic_pattern_required_graph(catalog, pattern)
  let unresolved_concrete_graph = semantic_pattern_required_graph(catalog, concrete)
  let resolved_concrete = match semantic_type_graph_node(
    unresolved_concrete_graph,
    concrete
  ) {
    SemanticVariableNode(variable) -> match semantic_type_substitution_get(
      concrete_substitution,
      variable
    ) {
      Some(value) -> value
      None -> concrete
    }
    _ -> concrete
  }
  let concrete_graph = semantic_pattern_required_graph(catalog, resolved_concrete)
  match semantic_type_graph_node(pattern_graph, pattern) {
    SemanticVariableNode(variable) -> semantic_pattern_variable(
      catalog,
      variable,
      resolved_concrete,
      substitution
    )
    pattern_node -> match (
      pattern_node,
      semantic_type_graph_node(concrete_graph, resolved_concrete),
    ) {
      (SemanticBottomNode, SemanticBottomNode) -> SemanticTypePatternMatched(substitution)
      (SemanticTopNode, SemanticTopNode) -> SemanticTypePatternMatched(substitution)
      (SemanticPrimitiveNode(left), SemanticPrimitiveNode(right)) -> {
        if semantic_pattern_primitive_equal(left, right) {
          SemanticTypePatternMatched(substitution)
        } else { SemanticTypePatternRejected }
      }
      (
        SemanticUnionNode(pattern_left, pattern_right),
        SemanticUnionNode(concrete_left, concrete_right),
      ) -> semantic_pattern_pair(
        catalog,
        pattern_left,
        pattern_right,
        concrete_left,
        concrete_right,
        concrete_substitution,
        substitution
      )
      (
        SemanticIntersectionNode(pattern_left, pattern_right),
        SemanticIntersectionNode(concrete_left, concrete_right),
      ) -> semantic_pattern_pair(
        catalog,
        pattern_left,
        pattern_right,
        concrete_left,
        concrete_right,
        concrete_substitution,
        substitution
      )
      (SemanticComplementNode(left), SemanticComplementNode(right)) ->
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      (
        SemanticContinuationNode(pattern_parameter, pattern_result),
        SemanticContinuationNode(concrete_parameter, concrete_result),
      ) -> semantic_pattern_pair(
        catalog,
        pattern_parameter,
        pattern_result,
        concrete_parameter,
        concrete_result,
        concrete_substitution,
        substitution
      )
      (SemanticWeakNode(left), SemanticWeakNode(right)) ->
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      (SemanticAtomicNode(left), SemanticAtomicNode(right)) ->
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      (SemanticUniqueNode(left), SemanticUniqueNode(right)) ->
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      (SemanticOwnedNode(left), SemanticOwnedNode(right)) ->
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      (
        SemanticPointerNode(left, left_mutability),
        SemanticPointerNode(right, right_mutability),
      ) -> if semantic_pattern_mutability_equal(left_mutability, right_mutability) {
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (
        SemanticBorrowNode(left, left_mutability),
        SemanticBorrowNode(right, right_mutability),
      ) -> if semantic_pattern_mutability_equal(left_mutability, right_mutability) {
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (
        SemanticSliceNode(left, left_mutability),
        SemanticSliceNode(right, right_mutability),
      ) -> if semantic_pattern_mutability_equal(left_mutability, right_mutability) {
        semantic_type_pattern_match_with(
          catalog,
          left,
          right,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (SemanticArrayNode(left, left_length), SemanticArrayNode(right, right_length)) -> {
        if left_length == right_length {
          semantic_type_pattern_match_with(
            catalog,
            left,
            right,
            concrete_substitution,
            substitution
          )
        } else { SemanticTypePatternRejected }
      }
      (
        SemanticFunctionNode(left_parameters, left_result, left_effects),
        SemanticFunctionNode(right_parameters, right_result, right_effects),
      ) -> match semantic_pattern_type_list(
        catalog,
        pattern_graph,
        left_parameters,
        concrete_graph,
        right_parameters,
        concrete_substitution,
        substitution
      ) {
        SemanticTypePatternRejected -> SemanticTypePatternRejected
        SemanticTypePatternMatched(next) -> match semantic_type_pattern_match_with(
          catalog,
          left_result,
          right_result,
          concrete_substitution,
          next
        ) {
          SemanticTypePatternRejected -> SemanticTypePatternRejected
          SemanticTypePatternMatched(result_substitution) -> semantic_type_pattern_match_with(
            catalog,
            left_effects,
            right_effects,
            concrete_substitution,
            result_substitution
          )
        }
      }
      (
        SemanticEffectAtomNode(left_declaration, left_arguments),
        SemanticEffectAtomNode(right_declaration, right_arguments),
      ) -> if declaration_identity_eq(left_declaration, right_declaration) {
        semantic_pattern_type_list(
          catalog,
          pattern_graph,
          left_arguments,
          concrete_graph,
          right_arguments,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (
        SemanticEffectSignatureNode(left_effects, left_tail),
        SemanticEffectSignatureNode(right_effects, right_tail),
      ) -> match left_tail {
        SemanticOpenEffects(variable) -> {
          let pattern_lists = semantic_type_graph_type_lists_local(pattern_graph)
          if semantic_type_list_len(pattern_lists, left_effects) == 0 {
            -- A bare effect tail denotes the whole concrete effect set. Bind
            -- it as an effect-signature value; substitution retains its atoms
            -- and any open tail when the enclosing function is specialized.
            semantic_pattern_variable(
              catalog,
              SemanticParameterVariable(variable),
              resolved_concrete,
              substitution
            )
          } else if semantic_pattern_effect_tail_equal(left_tail, right_tail) {
            semantic_pattern_type_list(
              catalog,
              pattern_graph,
              left_effects,
              concrete_graph,
              right_effects,
              concrete_substitution,
              substitution
            )
          } else { SemanticTypePatternRejected }
        }
        SemanticClosedEffects -> if semantic_pattern_effect_tail_equal(left_tail, right_tail) {
          semantic_pattern_type_list(
            catalog,
            pattern_graph,
            left_effects,
            concrete_graph,
            right_effects,
            concrete_substitution,
            substitution
          )
        } else { SemanticTypePatternRejected }
      }
      (
        SemanticNamedNode(left_declaration, left_role, _, left_arguments),
        SemanticNamedNode(right_declaration, right_role, _, right_arguments),
      ) -> if declaration_identity_eq(left_declaration, right_declaration) and
        semantic_pattern_named_role_equal(left_role, right_role) {
          semantic_pattern_type_list(
            catalog,
            pattern_graph,
            left_arguments,
            concrete_graph,
            right_arguments,
            concrete_substitution,
            substitution
          )
        } else { SemanticTypePatternRejected }
      (
        SemanticRecordNode(left_fields, left_shape, left_openness),
        SemanticRecordNode(right_fields, right_shape, right_openness),
      ) -> if semantic_pattern_record_shape_equal(left_shape, right_shape) and
        semantic_pattern_record_openness_equal(left_openness, right_openness) {
          semantic_pattern_record_fields_from(
            catalog,
            pattern_graph,
            left_fields,
            concrete_graph,
            right_fields,
            __i64_to_usize(0),
            concrete_substitution,
            substitution
          )
        } else { SemanticTypePatternRejected }
      (
        SemanticVariantNode(left_declaration, left_payload),
        SemanticVariantNode(right_declaration, right_payload),
      ) -> if declaration_identity_eq(left_declaration, right_declaration) {
        semantic_type_pattern_match_with(
          catalog,
          left_payload,
          right_payload,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (
        SemanticTraitNode(left_declaration, left_bindings),
        SemanticTraitNode(right_declaration, right_bindings),
      ) -> if declaration_identity_eq(left_declaration, right_declaration) {
        semantic_pattern_trait_bindings_from(
          catalog,
          pattern_graph,
          left_bindings,
          concrete_graph,
          right_bindings,
          __i64_to_usize(0),
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      (
        SemanticAssociatedNode(left_base, left_declaration),
        SemanticAssociatedNode(right_base, right_declaration),
      ) -> if declaration_identity_eq(left_declaration, right_declaration) {
        semantic_type_pattern_match_with(
          catalog,
          left_base,
          right_base,
          concrete_substitution,
          substitution
        )
      } else { SemanticTypePatternRejected }
      _ -> SemanticTypePatternRejected
    }
  }
}

pub(package) fn semantic_type_pattern_match(
  catalog: borrow SemanticTypeCatalog,
  pattern: SemanticTypeId,
  concrete: SemanticTypeId
) -> SemanticTypePatternMatch {
  let concrete_substitution = semantic_type_substitution_empty()
  semantic_type_pattern_match_with(
    catalog,
    pattern,
    concrete,
    concrete_substitution,
    semantic_type_substitution_empty()
  )
}

pub(package) fn semantic_type_pattern_match_substituted(
  catalog: borrow SemanticTypeCatalog,
  pattern: SemanticTypeId,
  pattern_substitution: SemanticTypeSubstitution,
  concrete: SemanticTypeId,
  concrete_substitution: borrow SemanticTypeSubstitution
) -> SemanticTypePatternMatch {
  semantic_type_pattern_match_with(
    catalog,
    pattern,
    concrete,
    concrete_substitution,
    pattern_substitution
  )
}
