-- Target-independent value-shape and ownership facts over semantic graphs.
--
-- This layer describes typed-IR word lanes and release actions. Byte sizes,
-- alignments, target calling conventions and aggregate descriptors belong to
-- backend placement and consume these facts rather than redefining them.

use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use stdlib/list.{Cons, List, Nil}
use stdlib/num/scalar.{num_scalar_usize_checked_add}
use stdlib/option.{None, Option, Some}
use stdlib/panic.{panic}

pub(package) type SemanticReleaseKind {
  SemanticNoRelease,
  SemanticManagedRelease,
  SemanticClosureRelease,
  SemanticWeakRelease
}

pub(package) type SemanticValueLaneClass {
  SemanticLaneUnavailable,
  SemanticGprLane,
  SemanticF32Lane,
  SemanticF64Lane
}

pub(package) type SemanticUnionStorageClass {
  SemanticNotUnionStorage,
  SemanticDeferredUnionStorage,
  SemanticWordUnionStorage,
  SemanticManagedUnionStorage,
  SemanticIncompatibleUnionStorage
}

-- Canonical target-independent record order. The source index is retained so
-- lowering can connect physical placement back to the authored field without
-- rediscovering the order from hashes.
pub(package) type SemanticRecordLayoutField {
  SemanticRecordLayoutField(i64, usize, SemanticTypeId)
}

-- Source-order names and types for a closed structural record. Keeping this
-- query with the graph prevents body producers from reading record columns.
pub(package) type SemanticStructuralRecordFields {
  SemanticStructuralRecordFields(List<str>, List<SemanticTypeId>)
}

pub(package) type SemanticRecordFieldProjection {
  SemanticRecordFieldProjected(i64, usize, SemanticTypeId),
  SemanticRecordFieldUnplaced(i64, str, SemanticTypeId),
  SemanticRecordFieldMissing,
  SemanticRecordFieldProjectionUnavailable
}

pub(package) fn semantic_closed_structural_record(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  let graph = semantic_layout_required_graph(catalog, id)
  match semantic_type_graph_node(graph, id) {
    SemanticRecordNode(_, SemanticStructuralRecord, SemanticClosedRecord) -> true
    _ -> false
  }
}

pub(package) fn semantic_structural_record(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  let graph = semantic_layout_required_graph(catalog, id)
  match semantic_type_graph_node(graph, id) {
    SemanticRecordNode(_, SemanticStructuralRecord, _) -> true
    _ -> false
  }
}

-- A tuple pattern consumes positional semantic fields, never parser/checker
-- layout slots. This query rejects open and non-tuple records as a whole.
pub(package) fn semantic_tuple_pattern_arity(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<usize> {
  let graph = semantic_layout_required_graph(catalog, id)
  match semantic_type_graph_node(graph, id) {
    SemanticRecordNode(fields, SemanticTupleRecord, SemanticClosedRecord) -> {
      let records = semantic_type_graph_records_local(graph)
      Some<usize>(semantic_type_record_field_count(records, fields))
    }
    _ -> None<usize>()
  }
}

pub(package) fn semantic_tuple_pattern_element(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  index: usize
) -> Option<SemanticTypeId> {
  let graph = semantic_layout_required_graph(catalog, id)
  match semantic_type_graph_node(graph, id) {
    SemanticRecordNode(fields, SemanticTupleRecord, SemanticClosedRecord) -> {
      let records = semantic_type_graph_records_local(graph)
      if index >= semantic_type_record_field_count(records, fields) {
        None<SemanticTypeId>()
      } else {
        let edge = semantic_type_record_field_edge(records, fields, index)
        Some<SemanticTypeId>(
          semantic_type_graph_record_field_type_id(
            graph,
            edge
          )
        )
      }
    }
    _ -> None<SemanticTypeId>()
  }
}

fn semantic_layout_required_graph(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeGraph {
  match catalog.graph_for(id) {
    Some(graph) -> if semantic_type_graph_contains(graph, id) { graph }
    else { panic("Semantic layout id is outside its segment") }
    None -> panic("Semantic layout catalog is missing a segment")
  }
}

fn semantic_layout_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeKind {
  let graph = semantic_layout_required_graph(catalog, id)
  semantic_type_graph_kind(graph, id)
}

fn semantic_layout_primitive(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticPrimitive {
  let graph = semantic_layout_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_primitive(
    local,
    semantic_type_graph_local_id(graph, id)
  )
}

fn semantic_layout_unary_inner(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_layout_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_unary_type_id(
    graph,
    semantic_type_local_graph_unary(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_layout_mutable_inner(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_layout_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  semantic_type_graph_mutable_unary_type_id(
    graph,
    semantic_type_local_graph_mutable_unary(
      local,
      semantic_type_graph_local_id(graph, id)
    )
  )
}

fn semantic_layout_binary_children(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> (SemanticTypeId, SemanticTypeId) {
  let graph = semantic_layout_required_graph(catalog, id)
  let local = semantic_type_graph_local(graph)
  let edge = semantic_type_local_graph_binary(
    local,
    semantic_type_graph_local_id(graph, id)
  )
  (
    semantic_type_graph_binary_left_type_id(graph, edge),
    semantic_type_graph_binary_right_type_id(graph, edge)
  )
}

fn semantic_layout_named_edge(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticNamedTypeEdge {
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_named(
    local,
    semantic_type_graph_local_id(graph, id)
  )
}

fn semantic_layout_named_role(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticNamedRole {
  let graph = semantic_layout_required_graph(catalog, id)
  let named = semantic_type_graph_named_local(graph)
  semantic_type_named_role(
    named,
    semantic_layout_named_edge(graph, id)
  )
}

fn semantic_layout_named_representation(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticTypeId {
  let graph = semantic_layout_required_graph(catalog, id)
  semantic_type_graph_named_representation_type_id(
    graph,
    semantic_layout_named_edge(graph, id)
  )
}

fn semantic_layout_record_edge(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticRecordTypeEdge {
  let local = semantic_type_graph_local(graph)
  semantic_type_local_graph_record(
    local,
    semantic_type_graph_local_id(graph, id)
  )
}

fn semantic_layout_record_fields(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> SemanticRecordFieldListId {
  let records = semantic_type_graph_records_local(graph)
  semantic_type_record_fields(
    records,
    semantic_layout_record_edge(graph, id)
  )
}

fn semantic_layout_record_is_open(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> bool {
  let records = semantic_type_graph_records_local(graph)
  match semantic_type_record_openness(
    records,
    semantic_layout_record_edge(graph, id)
  ) {
    SemanticClosedRecord -> false
    SemanticOpenRecord -> true
  }
}

fn semantic_layout_record_field_rank(
  records: borrow SemanticRecordLocalGraph,
  fields: SemanticRecordFieldListId,
  candidate: usize,
  offset: usize,
  rank: usize
) -> usize {
  let candidate_edge = semantic_type_record_field_edge(
    records,
    fields,
    candidate
  )
  let candidate_hash = semantic_type_record_field_hash(records, candidate_edge)
  if offset >= semantic_type_record_field_count(records, fields) { rank }
  else {
    let current = semantic_type_record_field_edge(records, fields, offset)
    let current_hash = semantic_type_record_field_hash(records, current)
    semantic_layout_record_field_rank(
      records,
      fields,
      candidate,
      offset + 1,
      if current_hash < candidate_hash or
        (current_hash == candidate_hash and offset < candidate) { rank + 1 }
    else { rank }
    )
  }
}

fn semantic_layout_record_field_at_search(
  records: borrow SemanticRecordLocalGraph,
  fields: SemanticRecordFieldListId,
  layout_index: usize,
  candidate: usize
) -> SemanticRecordFieldEdge {
  if candidate >= semantic_type_record_field_count(records, fields) {
    panic("Semantic record layout index is missing")
  } else {
    if semantic_layout_record_field_rank(
      records,
      fields,
      candidate,
      0,
      0
    ) == layout_index {
      semantic_type_record_field_edge(records, fields, candidate)
    } else {
      semantic_layout_record_field_at_search(
        records,
        fields,
        layout_index,
        candidate + 1
      )
    }
  }
}

fn semantic_layout_record_field_at(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId,
  layout_index: usize
) -> SemanticRecordFieldEdge {
  let records = semantic_type_graph_records_local(graph)
  let edge = semantic_layout_record_edge(graph, id)
  let fields = semantic_type_record_fields(records, edge)
  match semantic_type_record_shape(records, edge) {
    SemanticTupleRecord -> semantic_type_record_field_edge(
      records,
      fields,
      layout_index
    )
    SemanticStructuralRecord -> semantic_layout_record_field_at_search(
      records,
      fields,
      layout_index,
      0
    )
  }
}

fn semantic_layout_record_field_count(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId
) -> usize {
  let records = semantic_type_graph_records_local(graph)
  semantic_type_record_field_count(
    records,
    semantic_layout_record_fields(graph, id)
  )
}

fn semantic_layout_record_field_type(
  graph: borrow SemanticTypeGraph,
  id: SemanticTypeId,
  layout_index: usize
) -> SemanticTypeId {
  semantic_type_graph_record_field_type_id(
    graph,
    semantic_layout_record_field_at(graph, id, layout_index)
  )
}

fn semantic_record_layout_fields_from(
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  layout_index: usize
) -> List<SemanticRecordLayoutField> {
  if layout_index >= semantic_layout_record_field_count(graph, record) {
    Nil<SemanticRecordLayoutField>()
  } else {
    let field = semantic_layout_record_field_at(graph, record, layout_index)
    let records = semantic_type_graph_records_local(graph)
    Cons<SemanticRecordLayoutField>(
      SemanticRecordLayoutField(
        semantic_type_record_field_hash(records, field),
        semantic_type_record_field_source_index(field),
        semantic_type_graph_record_field_type_id(graph, field)
      ),
      semantic_record_layout_fields_from(graph, record, layout_index + 1)
    )
  }
}

pub(package) fn semantic_record_layout_fields(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<List<SemanticRecordLayoutField>> {
  match semantic_layout_kind(catalog, id) {
    SemanticRecordKind -> {
      let graph = semantic_layout_required_graph(catalog, id)
      if semantic_layout_record_is_open(graph, id) {
        None<List<SemanticRecordLayoutField>>()
      } else {
        Some<List<SemanticRecordLayoutField>>(
          semantic_record_layout_fields_from(graph, id, 0)
        )
      }
    }
    _ -> None<List<SemanticRecordLayoutField>>()
  }
}

fn semantic_structural_record_source_fields_from(
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  index: usize
) -> SemanticStructuralRecordFields {
  if index >= semantic_layout_record_field_count(graph, record) {
    SemanticStructuralRecordFields(Nil<str>(), Nil<SemanticTypeId>())
  } else {
    let records = semantic_type_graph_records_local(graph)
    let field = semantic_type_record_field_edge(
      records,
      semantic_layout_record_fields(graph, record),
      index
    )
    let name = match semantic_type_graph_record_field_name(graph, field) {
      SemanticNamedRecordField(value) -> value
      SemanticTupleRecordField(_) -> panic("Structural record has a positional field")
    }
    match semantic_structural_record_source_fields_from(graph, record, index + 1) {
      SemanticStructuralRecordFields(names, types) -> SemanticStructuralRecordFields(
        Cons<str>(name, names),
        Cons<SemanticTypeId>(semantic_type_graph_record_field_type_id(graph, field), types)
      )
    }
  }
}

pub(package) fn semantic_structural_record_source_fields(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<SemanticStructuralRecordFields> {
  if not semantic_closed_structural_record(catalog, id) {
    None<SemanticStructuralRecordFields>()
  } else {
    let graph = semantic_layout_required_graph(catalog, id)
    Some<SemanticStructuralRecordFields>(
      semantic_structural_record_source_fields_from(graph, id, 0)
    )
  }
}

fn semantic_record_named_field_index(
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  wanted: str,
  source_index: usize
) -> Option<usize> {
  if source_index >= semantic_layout_record_field_count(graph, record) {
    None<usize>()
  } else {
    let records = semantic_type_graph_records_local(graph)
    let fields = semantic_layout_record_fields(graph, record)
    let field = semantic_type_record_field_edge(records, fields, source_index)
    match semantic_type_graph_record_field_name(graph, field) {
      SemanticNamedRecordField(name) -> if name == wanted { Some<usize>(source_index) }
      else {
        semantic_record_named_field_index(
          graph,
          record,
          wanted,
          source_index + 1
        )
      }
      SemanticTupleRecordField(_) -> None<usize>()
    }
  }
}

fn semantic_record_field_word_offset_from(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  target_source_index: usize,
  target_hash: i64,
  source_index: usize,
  word_offset: usize
) -> SemanticRecordFieldProjection {
  if source_index >= semantic_layout_record_field_count(graph, record) {
    let records = semantic_type_graph_records_local(graph)
    let fields = semantic_layout_record_fields(graph, record)
    let target = semantic_type_record_field_edge(
      records,
      fields,
      target_source_index
    )
    SemanticRecordFieldProjected(
      target_hash,
      word_offset,
      semantic_type_graph_record_field_type_id(graph, target)
    )
  } else {
    let records = semantic_type_graph_records_local(graph)
    let fields = semantic_layout_record_fields(graph, record)
    let field = semantic_type_record_field_edge(records, fields, source_index)
    let field_hash = semantic_type_record_field_hash(records, field)
    if field_hash < target_hash or
      (field_hash == target_hash and source_index < target_source_index) {
        let field_type = semantic_type_graph_record_field_type_id(graph, field)
        match semantic_value_word_count(catalog, field_type) {
          Some(width) -> match num_scalar_usize_checked_add(word_offset, width) {
            Some(next_offset) -> semantic_record_field_word_offset_from(
              catalog,
              graph,
              record,
              target_source_index,
              target_hash,
              source_index + 1,
              next_offset
            )
            None -> SemanticRecordFieldProjectionUnavailable
          }
          None -> SemanticRecordFieldProjectionUnavailable
        }
      } else {
        semantic_record_field_word_offset_from(
          catalog,
          graph,
          record,
          target_source_index,
          target_hash,
          source_index + 1,
          word_offset
        )
      }
  }
}

-- Resolve a named structural field to its stable key, target-independent word
-- offset and semantic result type. Exact name comparison ensures colliding
-- field hashes cannot select one another.
pub(package) fn semantic_record_field_projection(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  wanted: str
) -> SemanticRecordFieldProjection {
  match semantic_layout_kind(catalog, id) {
    SemanticRecordKind -> {
      let graph = semantic_layout_required_graph(catalog, id)
      let records = semantic_type_graph_records_local(graph)
      let edge = semantic_layout_record_edge(graph, id)
      match semantic_type_record_shape(records, edge) {
        SemanticStructuralRecord -> match semantic_record_named_field_index(
          graph,
          id,
          wanted,
          0
        ) {
          Some(source_index) -> {
            let fields = semantic_layout_record_fields(graph, id)
            let field = semantic_type_record_field_edge(records, fields, source_index)
            let stable_key = semantic_type_record_field_hash(records, field)
            if semantic_layout_record_is_open(graph, id) {
              SemanticRecordFieldUnplaced(
                stable_key,
                wanted,
                semantic_type_graph_record_field_type_id(graph, field)
              )
            } else {
              semantic_record_field_word_offset_from(
                catalog,
                graph,
                id,
                source_index,
                stable_key,
                0,
                0
              )
            }
          }
          None -> SemanticRecordFieldMissing
        }
        SemanticTupleRecord -> SemanticRecordFieldProjectionUnavailable
      }
    }
    _ -> SemanticRecordFieldProjectionUnavailable
  }
}

fn semantic_value_record_words_from(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  offset: usize,
  total: usize
) -> Option<usize> {
  if offset >= semantic_layout_record_field_count(graph, record) {
    Some<usize>(total)
  } else {
    match semantic_value_word_count(
      catalog,
      semantic_layout_record_field_type(graph, record, offset)
    ) {
      None -> None<usize>()
      Some(words) -> match num_scalar_usize_checked_add(total, words) {
        Some(next) -> semantic_value_record_words_from(
          catalog,
          graph,
          record,
          offset + 1,
          next
        )
        None -> None<usize>()
      }
    }
  }
}

fn semantic_value_record_word_count(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<usize> {
  let graph = semantic_layout_required_graph(catalog, id)
  if semantic_layout_record_is_open(graph, id) { None<usize>() }
  else {
    if semantic_layout_record_field_count(graph, id) == 0 { Some<usize>(1) }
    else { semantic_value_record_words_from(catalog, graph, id, 0, 0) }
  }
}

pub(package) fn semantic_value_word_count(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> Option<usize> {
  match semantic_layout_kind(catalog, id) {
    SemanticBottomKind -> None<usize>()
    SemanticEffectAtomKind -> None<usize>()
    SemanticEffectSignatureKind -> None<usize>()
    SemanticVariableKind -> None<usize>()
    SemanticTraitKind -> None<usize>()
    SemanticAssociatedKind -> None<usize>()
    SemanticRecordKind -> semantic_value_record_word_count(catalog, id)
    SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
      SemanticOpaqueType -> semantic_value_word_count(
        catalog,
        semantic_layout_named_representation(catalog, id)
      )
      _ -> Some<usize>(1)
    }
    SemanticUniqueKind -> semantic_value_word_count(
      catalog,
      semantic_layout_unary_inner(catalog, id)
    )
    SemanticOwnedKind -> semantic_value_word_count(
      catalog,
      semantic_layout_unary_inner(catalog, id)
    )
    SemanticBorrowKind -> semantic_value_word_count(
      catalog,
      semantic_layout_mutable_inner(catalog, id)
    )
    SemanticSliceKind -> Some<usize>(2)
    _ -> Some<usize>(1)
  }
}

fn semantic_release_equal(
  left: SemanticReleaseKind,
  right: SemanticReleaseKind
) -> bool {
  match (left, right) {
    (SemanticNoRelease, SemanticNoRelease) -> true
    (SemanticManagedRelease, SemanticManagedRelease) -> true
    (SemanticClosureRelease, SemanticClosureRelease) -> true
    (SemanticWeakRelease, SemanticWeakRelease) -> true
    _ -> false
  }
}

fn semantic_layout_is_nil(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_layout_kind(catalog, id) {
    SemanticPrimitiveKind -> match semantic_layout_primitive(catalog, id) {
      SemanticNil -> true
      _ -> false
    }
    _ -> false
  }
}

fn semantic_layout_is_weakable(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_layout_kind(catalog, id) {
    SemanticFunctionKind -> true
    SemanticContinuationKind -> true
    SemanticRcKind -> true
    SemanticAtomicKind -> true
    _ -> match semantic_field_release_kind(catalog, id) {
      SemanticManagedRelease -> true
      _ -> false
    }
  }
}

fn semantic_union_release_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  value_boundary: bool
) -> SemanticReleaseKind {
  match semantic_layout_binary_children(catalog, id) {
    (left, right) -> {
      let left_kind = if value_boundary {
        semantic_value_release_kind(catalog, left)
      } else { semantic_field_release_kind(catalog, left) }
      let right_kind = if value_boundary {
        semantic_value_release_kind(catalog, right)
      } else { semantic_field_release_kind(catalog, right) }
      if value_boundary and match semantic_layout_kind(catalog, left) {
        SemanticBottomKind -> true
        _ -> false
      } { right_kind }
      else {
        if value_boundary and match semantic_layout_kind(catalog, right) {
          SemanticBottomKind -> true
          _ -> false
        } { left_kind }
        else {
          match left_kind {
            SemanticNoRelease -> match right_kind {
              SemanticNoRelease -> SemanticNoRelease
              _ -> if semantic_layout_is_nil(catalog, left) {
                right_kind
              } else { SemanticNoRelease }
            }
            _ -> if semantic_layout_is_nil(catalog, right) {
              left_kind
            } else {
              if semantic_release_equal(left_kind, right_kind) { left_kind }
              else { SemanticNoRelease }
            }
          }
        }
      }
    }
  }
}

pub(package) fn semantic_field_release_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticReleaseKind {
  match semantic_layout_kind(catalog, id) {
    SemanticPrimitiveKind -> match semantic_layout_primitive(catalog, id) {
      SemanticStr -> SemanticManagedRelease
      _ -> SemanticNoRelease
    }
    SemanticFunctionKind -> SemanticClosureRelease
    SemanticContinuationKind -> SemanticClosureRelease
    SemanticRcKind -> SemanticManagedRelease
    SemanticWeakKind -> if semantic_layout_is_weakable(
      catalog,
      semantic_layout_unary_inner(catalog, id)
    ) { SemanticWeakRelease } else { SemanticNoRelease }
    SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
      SemanticOpaqueType -> semantic_field_release_kind(
        catalog,
        semantic_layout_named_representation(catalog, id)
      )
      SemanticPayloadlessVariantType -> SemanticNoRelease
      SemanticNominalType -> SemanticManagedRelease
    }
    SemanticUnionKind -> semantic_union_release_kind(catalog, id, false)
    _ -> SemanticNoRelease
  }
}

pub(package) fn semantic_value_release_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticReleaseKind {
  match semantic_layout_kind(catalog, id) {
    SemanticBottomKind -> SemanticNoRelease
    SemanticArrayKind -> SemanticManagedRelease
    SemanticUnionKind -> semantic_union_release_kind(catalog, id, true)
    _ -> semantic_field_release_kind(catalog, id)
  }
}

fn semantic_record_lane_release_from(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  lane: usize,
  field_index: usize,
  field_start: usize
) -> SemanticReleaseKind {
  if field_index >= semantic_layout_record_field_count(graph, record) {
    SemanticNoRelease
  } else {
    let field_type = semantic_layout_record_field_type(
      graph,
      record,
      field_index
    )
    match semantic_value_word_count(catalog, field_type) {
      None -> SemanticNoRelease
      Some(words) -> match num_scalar_usize_checked_add(field_start, words) {
        None -> SemanticNoRelease
        Some(field_end) -> if lane >= field_start and lane < field_end {
          semantic_value_lane_release_kind(
            catalog,
            field_type,
            lane - field_start
          )
        } else {
          semantic_record_lane_release_from(
            catalog,
            graph,
            record,
            lane,
            field_index + 1,
            field_end
          )
        }
      }
    }
  }
}

pub(package) fn semantic_value_lane_release_kind(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  lane: usize
) -> SemanticReleaseKind {
  match semantic_value_word_count(catalog, id) {
    None -> SemanticNoRelease
    Some(words) -> if lane >= words { SemanticNoRelease }
    else {
      match semantic_layout_kind(catalog, id) {
        SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
          SemanticOpaqueType -> semantic_value_lane_release_kind(
            catalog,
            semantic_layout_named_representation(catalog, id),
            lane
          )
          _ -> if lane == 0 { semantic_value_release_kind(catalog, id) }
          else { SemanticNoRelease }
        }
        SemanticRecordKind -> {
          let graph = semantic_layout_required_graph(catalog, id)
          if semantic_layout_record_is_open(graph, id) {
            SemanticNoRelease
          } else {
            semantic_record_lane_release_from(catalog, graph, id, lane, 0, 0)
          }
        }
        SemanticUniqueKind -> SemanticNoRelease
        SemanticOwnedKind -> SemanticNoRelease
        SemanticBorrowKind -> SemanticNoRelease
        _ -> if lane == 0 { semantic_value_release_kind(catalog, id) }
        else { SemanticNoRelease }
      }
    }
  }
}

fn semantic_value_has_release_from(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  lane: usize,
  words: usize
) -> bool {
  if lane >= words { false }
  else {
    match semantic_value_lane_release_kind(catalog, id, lane) {
      SemanticNoRelease -> semantic_value_has_release_from(
        catalog,
        id,
        lane + 1,
        words
      )
      _ -> true
    }
  }
}

pub(package) fn semantic_value_has_release_lane(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_value_word_count(catalog, id) {
    Some(words) -> semantic_value_has_release_from(catalog, id, 0, words)
    None -> false
  }
}

fn semantic_record_lane_class_from(
  catalog: borrow SemanticTypeCatalog,
  graph: borrow SemanticTypeGraph,
  record: SemanticTypeId,
  lane: usize,
  field_index: usize,
  field_start: usize
) -> SemanticValueLaneClass {
  if field_index >= semantic_layout_record_field_count(graph, record) {
    SemanticLaneUnavailable
  } else {
    let field_type = semantic_layout_record_field_type(
      graph,
      record,
      field_index
    )
    match semantic_value_word_count(catalog, field_type) {
      None -> SemanticLaneUnavailable
      Some(words) -> match num_scalar_usize_checked_add(field_start, words) {
        None -> SemanticLaneUnavailable
        Some(field_end) -> if lane >= field_start and lane < field_end {
          semantic_value_lane_class(catalog, field_type, lane - field_start)
        } else {
          semantic_record_lane_class_from(
            catalog,
            graph,
            record,
            lane,
            field_index + 1,
            field_end
          )
        }
      }
    }
  }
}

pub(package) fn semantic_value_lane_class(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId,
  lane: usize
) -> SemanticValueLaneClass {
  match semantic_value_word_count(catalog, id) {
    None -> SemanticLaneUnavailable
    Some(words) -> if lane >= words { SemanticLaneUnavailable }
    else {
      match semantic_layout_kind(catalog, id) {
        SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
          SemanticOpaqueType -> semantic_value_lane_class(
            catalog,
            semantic_layout_named_representation(catalog, id),
            lane
          )
          _ -> if lane == 0 { SemanticGprLane }
          else { SemanticLaneUnavailable }
        }
        SemanticRecordKind -> {
          let graph = semantic_layout_required_graph(catalog, id)
          if semantic_layout_record_is_open(graph, id) {
            SemanticLaneUnavailable
          } else {
            if semantic_layout_record_field_count(graph, id) == 0 {
              if lane == 0 { SemanticGprLane }
              else { SemanticLaneUnavailable }
            } else { semantic_record_lane_class_from(catalog, graph, id, lane, 0, 0) }
          }
        }
        SemanticUniqueKind -> semantic_value_lane_class(
          catalog,
          semantic_layout_unary_inner(catalog, id),
          lane
        )
        SemanticOwnedKind -> semantic_value_lane_class(
          catalog,
          semantic_layout_unary_inner(catalog, id),
          lane
        )
        SemanticBorrowKind -> semantic_value_lane_class(
          catalog,
          semantic_layout_mutable_inner(catalog, id),
          lane
        )
        SemanticPrimitiveKind -> if lane != 0 { SemanticLaneUnavailable }
        else {
          match semantic_layout_primitive(catalog, id) {
            SemanticF32 -> SemanticF32Lane
            SemanticF64 -> SemanticF64Lane
            _ -> SemanticGprLane
          }
        }
        SemanticSliceKind -> SemanticGprLane
        _ -> if lane == 0 { SemanticGprLane }
        else { SemanticLaneUnavailable }
      }
    }
  }
}

fn semantic_union_word_scalar_eligible(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_layout_kind(catalog, id) {
    SemanticBottomKind -> true
    SemanticUnionKind -> match semantic_layout_binary_children(catalog, id) {
      (left, right) -> semantic_union_word_scalar_eligible(catalog, left) and
        semantic_union_word_scalar_eligible(catalog, right)
    }
    SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
      SemanticOpaqueType -> semantic_union_word_scalar_eligible(
        catalog,
        semantic_layout_named_representation(catalog, id)
      )
      _ -> false
    }
    SemanticPrimitiveKind -> match semantic_layout_primitive(catalog, id) {
      SemanticStr -> false
      SemanticF32 -> false
      SemanticF64 -> false
      _ -> true
    }
    SemanticPointerKind -> true
    _ -> false
  }
}

fn semantic_union_contains_unresolved_atom(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_layout_kind(catalog, id) {
    -- Bottom is a resolved semantic node. Graphs express absence through
    -- `Option`, so it is never an unresolved storage atom.
    SemanticBottomKind -> false
    SemanticTopKind -> true
    SemanticIntersectionKind -> true
    SemanticComplementKind -> true
    SemanticVariableKind -> true
    SemanticTraitKind -> true
    SemanticAssociatedKind -> true
    SemanticUnionKind -> match semantic_layout_binary_children(catalog, id) {
      (left, right) -> semantic_union_contains_unresolved_atom(catalog, left) or
        semantic_union_contains_unresolved_atom(catalog, right)
    }
    SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
      SemanticOpaqueType -> semantic_union_contains_unresolved_atom(
        catalog,
        semantic_layout_named_representation(catalog, id)
      )
      _ -> false
    }
    _ -> false
  }
}

pub(package) fn semantic_union_storage_class(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> SemanticUnionStorageClass {
  match semantic_layout_kind(catalog, id) {
    SemanticUnionKind -> match semantic_value_release_kind(catalog, id) {
      SemanticNoRelease -> if semantic_union_word_scalar_eligible(catalog, id) {
        SemanticWordUnionStorage
      } else {
        if semantic_union_contains_unresolved_atom(catalog, id) {
          SemanticDeferredUnionStorage
        } else { SemanticIncompatibleUnionStorage }
      }
      _ -> SemanticManagedUnionStorage
    }
    _ -> SemanticNotUnionStorage
  }
}

pub(package) fn semantic_field_may_require_release(
  catalog: borrow SemanticTypeCatalog,
  id: SemanticTypeId
) -> bool {
  match semantic_field_release_kind(catalog, id) {
    SemanticNoRelease -> match semantic_layout_kind(catalog, id) {
      SemanticTopKind -> true
      SemanticComplementKind -> true
      SemanticVariableKind -> true
      SemanticTraitKind -> true
      SemanticWeakKind -> true
      SemanticAtomicKind -> true
      SemanticUnionKind -> match semantic_layout_binary_children(catalog, id) {
        (left, right) -> semantic_field_may_require_release(catalog, left) or
          semantic_field_may_require_release(catalog, right)
      }
      SemanticIntersectionKind -> match semantic_layout_binary_children(catalog, id) {
        (left, right) -> semantic_field_may_require_release(catalog, left) or
          semantic_field_may_require_release(catalog, right)
      }
      SemanticNamedKind -> match semantic_layout_named_role(catalog, id) {
        SemanticOpaqueType -> semantic_field_may_require_release(
          catalog,
          semantic_layout_named_representation(catalog, id)
        )
        _ -> false
      }
      _ -> false
    }
    _ -> true
  }
}
