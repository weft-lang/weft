-- Slice containment over semantic type graphs and resolved declarations.
--
-- Nominal nodes carry identity and type arguments, not their fields. The
-- declaration catalog supplies those templates and their concrete generic
-- substitution; no checker table or authored syntax is consulted here.
-- Unknown is deliberately distinct from a proof of no slice.

use compiler/types/graph.{*}
use compiler/types/graph/catalog.{SemanticTypeCatalog}
use compiler/types/graph/equality.{semantic_type_catalog_equal}
use compiler/types/graph/declarations.{
  SemanticRecordDeclarationLayoutMatched,
  SemanticTypeDeclarationCatalog,
  SemanticTypeDeclarationLayoutMissing,
  SemanticVariantDeclarationLayoutMatched,
  semantic_type_declaration_catalog_resolve,
  semantic_type_declared_record_field_count,
  semantic_type_declared_record_field_type,
  semantic_type_declared_variant_case_count,
  semantic_type_declared_variant_payload_count,
  semantic_type_declared_variant_payload_type
}
use compiler/types/graph/substitution.{
  SemanticTypeSubstitution,
  semantic_type_substitution_copy,
  semantic_type_substitution_empty,
  semantic_type_substitution_get
}
use stdlib/list.{Cons, List, Nil}
use stdlib/option.{None, Some}
use stdlib/state as state
use stdlib/state.{State}

-- `Contains` is a conservative may-contain result for set intersections;
-- `DoesNotContain` is the proof needed to omit an aggregate borrow fact.
-- Unknown covers unexpanded top/complement/associated types and non-regular
-- recursion beyond the bounded proof search.
pub(package) type SemanticSliceContainment {
  SemanticContainsSlice,
  SemanticDoesNotContainSlice,
  SemanticSliceContainmentUnknown
}

fn slice_containment_join(
  left: SemanticSliceContainment,
  right: SemanticSliceContainment
) -> SemanticSliceContainment {
  match (left, right) {
    (SemanticContainsSlice, _) -> SemanticContainsSlice
    (_, SemanticContainsSlice) -> SemanticContainsSlice
    (SemanticSliceContainmentUnknown, _) -> SemanticSliceContainmentUnknown
    (_, SemanticSliceContainmentUnknown) -> SemanticSliceContainmentUnknown
    _ -> SemanticDoesNotContainSlice
  }
}

type SemanticSliceSearch {
  ids: List<SemanticTypeId>,
  substitutions: List<SemanticTypeSubstitution>,
  remaining: usize
}

fn same_bool_list(left: List<bool>, right: List<bool>) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(a, rest_a), Cons(b, rest_b)) -> a == b and same_bool_list(rest_a, rest_b)
    _ -> false
  }
}

fn same_usize_list(left: List<usize>, right: List<usize>) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(a, rest_a), Cons(b, rest_b)) -> a == b and same_usize_list(rest_a, rest_b)
    _ -> false
  }
}

fn same_type_list(
  types: borrow SemanticTypeCatalog,
  left: List<SemanticTypeId>,
  right: List<SemanticTypeId>
) -> bool {
  match (left, right) {
    (Nil, Nil) -> true
    (Cons(a, rest_a), Cons(b, rest_b)) -> semantic_type_catalog_equal(types, a, b) and
      same_type_list(types, rest_a, rest_b)
    _ -> false
  }
}

fn same_substitution(
  types: borrow SemanticTypeCatalog,
  left: borrow SemanticTypeSubstitution,
  right: borrow SemanticTypeSubstitution
) -> bool {
  let {
    variable_self: left_self,
    variable_ids: left_ids,
    values: left_values,
    associated_variable_self: _,
    associated_variable_ids: left_associated,
    associated_declarations: _,
    associated_values: _,
  } = left
  let {
    variable_self: right_self,
    variable_ids: right_ids,
    values: right_values,
    associated_variable_self: _,
    associated_variable_ids: right_associated,
    associated_declarations: _,
    associated_values: _,
  } = right
  -- Associated substitutions are not yet normalized for equality. Failing
  -- the comparison leaves a bounded unknown rather than a false no-slice.
  left_associated.len() == 0 and right_associated.len() == 0 and
    same_bool_list(left_self, right_self) and
    same_usize_list(left_ids, right_ids) and
    same_type_list(types, left_values, right_values)
}

fn slice_containment_seen(
  types: borrow SemanticTypeCatalog,
  search: SemanticSliceSearch,
  wanted: SemanticTypeId,
  substitution: borrow SemanticTypeSubstitution
) -> bool {
  match (search.ids, search.substitutions) {
    (Nil, Nil) -> false
    (Cons(head, remaining_ids), Cons(prior, remaining_substitutions)) ->
      (semantic_type_id_eq(head, wanted) and same_substitution(types, prior, substitution)) or
      slice_containment_seen(
        types,
        SemanticSliceSearch {
          ids: remaining_ids,
          substitutions: remaining_substitutions,
          remaining: search.remaining
        },
        wanted,
        substitution
      )
    _ -> false
  }
}

fn slice_containment_type(
  types: borrow SemanticTypeCatalog,
  declarations: borrow SemanticTypeDeclarationCatalog,
  value: SemanticTypeId,
  substitution: borrow SemanticTypeSubstitution,
  depth: usize
) -[State<SemanticSliceSearch>]> SemanticSliceContainment {
  if depth >= 256 { return SemanticSliceContainmentUnknown }
  let search = State<SemanticSliceSearch>.get()
  if slice_containment_seen(types, search, value, substitution) {
    return SemanticDoesNotContainSlice
  }
  -- Global visitation prevents sibling branches of a recursive declaration
  -- from expanding the same instantiated graph again. Exhaustion is a
  -- may-contain result, never an absence proof.
  if search.remaining == 0 { return SemanticContainsSlice }
  State<SemanticSliceSearch>.put(
    SemanticSliceSearch {
      ids: search.ids.prepend(value),
      substitutions: search.substitutions.prepend(
        semantic_type_substitution_copy(substitution)
      ),
      remaining: search.remaining - 1
    }
  )
  let graph = match types.graph_for(value) {
    Some(found) -> found
    None -> return SemanticSliceContainmentUnknown
  }
  let next_trail = depth + 1
  match semantic_type_graph_node(graph, value) {
    SemanticSliceNode(_, _) -> SemanticContainsSlice
    SemanticUnionNode(left, right) -> slice_containment_join(
      slice_containment_type(types, declarations, left, substitution, next_trail),
      slice_containment_type(types, declarations, right, substitution, next_trail)
    )
    SemanticIntersectionNode(left, right) -> slice_containment_join(
      slice_containment_type(types, declarations, left, substitution, next_trail),
      slice_containment_type(types, declarations, right, substitution, next_trail)
    )
    -- A complement can contain slices even when its operand does not.
    SemanticComplementNode(_) -> SemanticSliceContainmentUnknown
    SemanticTopNode -> SemanticSliceContainmentUnknown
    SemanticWeakNode(inner) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticRcNode(inner) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticAtomicNode(inner) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticUniqueNode(inner) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticOwnedNode(inner) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticPointerNode(inner, _) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticBorrowNode(inner, _) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticArrayNode(inner, _) -> slice_containment_type(
      types,
      declarations,
      inner,
      substitution,
      next_trail
    )
    SemanticContinuationNode(parameter, result) -> slice_containment_join(
      slice_containment_type(types, declarations, parameter, substitution, next_trail),
      slice_containment_type(types, declarations, result, substitution, next_trail)
    )
    SemanticRecordNode(fields, _, _) -> {
      let records = semantic_type_graph_records_local(graph)
      let mut field: usize = 0
      let mut found = SemanticDoesNotContainSlice
      while field < semantic_type_record_field_count(records, fields) {
        let edge = semantic_type_record_field_edge(records, fields, field)
        let field_type = semantic_type_graph_record_field_type_id(graph, edge)
        found = slice_containment_join(
          found,
          slice_containment_type(types, declarations, field_type, substitution, next_trail)
        )
        field = field + 1
      }
      found
    }
    SemanticNamedNode(_, role, representation, _) -> match role {
      SemanticPayloadlessVariantType -> SemanticDoesNotContainSlice
      SemanticOpaqueType -> slice_containment_type(
        types,
        declarations,
        representation,
        substitution,
        next_trail
      )
      SemanticNominalType -> match semantic_type_declaration_catalog_resolve(
        types,
        declarations,
        value,
        substitution
      ) {
        SemanticRecordDeclarationLayoutMatched(layout, concrete) -> {
          let mut field: usize = 0
          let mut found = SemanticDoesNotContainSlice
          let count = match semantic_type_declared_record_field_count(declarations, layout) {
            Some(value) -> value
            None -> return SemanticSliceContainmentUnknown
          }
          while field < count {
            let field_type = match semantic_type_declared_record_field_type(
              declarations,
              layout,
              field
            ) {
              Some(value) -> value
              None -> return SemanticSliceContainmentUnknown
            }
            found = slice_containment_join(
              found,
              slice_containment_type(types, declarations, field_type, concrete, next_trail)
            )
            field = field + 1
          }
          found
        }
        SemanticVariantDeclarationLayoutMatched(layout, concrete) -> {
          let mut case: usize = 0
          let mut found = SemanticDoesNotContainSlice
          let count = match semantic_type_declared_variant_case_count(declarations, layout) {
            Some(value) -> value
            None -> return SemanticSliceContainmentUnknown
          }
          while case < count {
            let payloads = match semantic_type_declared_variant_payload_count(
              declarations,
              layout,
              case
            ) {
              Some(value) -> value
              None -> return SemanticSliceContainmentUnknown
            }
            let mut payload: usize = 0
            while payload < payloads {
              let payload_type = match semantic_type_declared_variant_payload_type(
                declarations,
                layout,
                case,
                payload
              ) {
                Some(value) -> value
                None -> return SemanticSliceContainmentUnknown
              }
              found = slice_containment_join(
                found,
                slice_containment_type(types, declarations, payload_type, concrete, next_trail)
              )
              payload = payload + 1
            }
            case = case + 1
          }
          found
        }
        SemanticTypeDeclarationLayoutMissing -> SemanticSliceContainmentUnknown
      }
    }
    SemanticVariantNode(_, parent) -> slice_containment_type(
      types,
      declarations,
      parent,
      substitution,
      next_trail
    )
    SemanticVariableNode(variable) -> match semantic_type_substitution_get(
      substitution,
      variable
    ) {
      Some(concrete) -> slice_containment_type(
        types,
        declarations,
        concrete,
        substitution,
        next_trail
      )
      None -> SemanticSliceContainmentUnknown
    }
    SemanticAssociatedNode(_, _) -> SemanticSliceContainmentUnknown
    _ -> SemanticDoesNotContainSlice
  }
}

pub(package) fn semantic_type_slice_containment(
  types: SemanticTypeCatalog,
  declarations: SemanticTypeDeclarationCatalog,
  value: SemanticTypeId
) -> SemanticSliceContainment {
  let substitution = semantic_type_substitution_empty()
  let initial = SemanticSliceSearch {
    ids: Nil<SemanticTypeId>(),
    substitutions: Nil<SemanticTypeSubstitution>(),
    remaining: 4096
  }
  let search: () -[State<SemanticSliceSearch>]> SemanticSliceContainment = () =>
    slice_containment_type(
      types,
      declarations,
      value,
      substitution,
      0
    )
  let (result, _) = state.run(initial, search)
  result
}
