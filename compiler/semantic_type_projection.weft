-- compiler/semantic_type_projection.weft -- checker types at the stable L7/L8 boundary

use compiler/lib.{*}
use compiler/module.{*}
use compiler/type_registry.{*}
use compiler/types.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/semantic_type.{*}

pub(package) fn semantic_type_fact_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes_copy(ptr, len)
}

pub(package) fn semantic_type_fact_primitive_name(id: i64) -> str {
  if id == PRIM_I64() { "i64" }
  else { if id == PRIM_STR() { "str" }
  else { if id == PRIM_BOOL() { "bool" }
  else { if id == PRIM_NIL() { "nil" }
  else { if id == PRIM_F64() { "f64" }
  else { if id == PRIM_I32() { "i32" }
  else { if id == PRIM_I8() { "i8" }
  else { if id == PRIM_I16() { "i16" }
  else { if id == PRIM_U8() { "u8" }
  else { if id == PRIM_U16() { "u16" }
  else { if id == PRIM_U32() { "u32" }
  else { if id == PRIM_U64() { "u64" }
  else { if id == PRIM_ISIZE() { "isize" }
  else { if id == PRIM_USIZE() { "usize" }
  else { if id == PRIM_F32() { "f32" } else { "unknown" } } } } } } } } } } } } } } }
}

pub(package) fn semantic_type_fact_entry_name(entry: i64) -> str {
  if entry == 0 { "unknown" }
  else { semantic_type_fact_copy(ttable_entry_name_ptr(entry), ttable_entry_name_len(entry)) }
}

pub(package) fn semantic_type_fact_named_name(tt: i64, hash: i64) -> str {
  let record = ttable_find_entry_by_hash_kind(tt, hash, 0)
  let variant = if record == 0 { ttable_find_entry_by_hash_kind(tt, hash, 1) } else { 0 }
  let opaque = if record == 0 and variant == 0 { ttable_find_entry_by_hash_kind(tt, hash, 5) } else { 0 }
  let entry = if record != 0 { record } else { if variant != 0 { variant } else { opaque } }
  semantic_type_fact_entry_name(entry)
}

-- Preserve the spelling by which the diagnostic's source module knows a
-- foreign declaration.  This is not cosmetic: two opaque modules may export
-- the same short name, and rendering both as `Same` discards the semantic
-- identity that explains the mismatch.
pub(package) fn semantic_type_fact_module_alias(tt: i64, caller_src: i64, target_module: i64) -> str {
  if tt == 0 or target_module == 0 { "" }
  else {
    let caller_module = module_fact_find_source(tt, caller_src)
    let imports = module_fact_imports(tt)
    let mut result = ""
    let mut i = 0
    while i < nlist_len(imports) and __str_len(result) == 0 {
      let import_entry = nlist_get(imports, i)
      if module_import_fact_importer(import_entry) == caller_module and module_import_fact_target(import_entry) == target_module and module_import_fact_alias_len(import_entry) > 0 {
        result = semantic_type_fact_copy(module_import_fact_alias_ptr(import_entry), module_import_fact_alias_len(import_entry))
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn semantic_type_fact_named(ty: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFact {
  let args = semantic_type_fact_list(ty_f3(ty), tt, src, tparams)
  if ty_named_is_opaque(ty) {
    let declaration = ty_named_opaque_declaration(ty)
    let name = semantic_type_fact_copy(module_decl_fact_name_ptr(declaration), module_decl_fact_name_len(declaration))
    let alias = semantic_type_fact_module_alias(tt, src, module_decl_fact_module(declaration))
    if __str_len(alias) > 0 { SemanticTypeQualifiedNamed(alias, name, args) }
    else { SemanticTypeNamed(name, args) }
  } else {
    let record = ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 0)
    let variant = if record == 0 { ttable_find_entry_by_hash_kind(tt, ty_f1(ty), 1) } else { 0 }
    let entry = if record != 0 { record } else { variant }
    let name = semantic_type_fact_entry_name(entry)
    let target_module = if entry == 0 { 0 } else { module_fact_find_source(tt, ttable_entry_source(entry)) }
    let alias = semantic_type_fact_module_alias(tt, src, target_module)
    if __str_len(alias) > 0 { SemanticTypeQualifiedNamed(alias, name, args) }
    else { SemanticTypeNamed(name, args) }
  }
}

pub(package) fn semantic_type_fact_trait_name(tt: i64, hash: i64) -> str {
  semantic_type_fact_entry_name(ttable_find_entry_by_hash_kind(tt, hash, 3))
}

pub(package) fn semantic_type_fact_associated_name(tt: i64, hash: i64) -> str {
  if tt == 0 { "unknown" }
  else {
    let data = mem_load64_at(tt, 0)
    let count = mem_load64_at(tt, 8)
    let mut result = "unknown"
    let mut found = false
    let mut i = 0
    while i < count and not found {
      let entry = data + i * 64
      let kind = ttable_entry_kind(entry)
      if kind == 3 or kind == 4 {
        let src = ttable_entry_source(entry)
        let members = ttable_entry_items(entry)
        let mut mi = 0
        while mi < ttable_entry_item_count(entry) and not found {
          let member = nlist_get(members, mi)
          let tag = node_tag(member)
          if (tag == 42 or tag == 43) and effect_name_hash(src, node_f1(member), node_f2(member)) == hash {
            result = semantic_type_fact_copy(src + node_f1(member), node_f2(member))
            found = true
          } else { mi = mi + 1 }
        }
      } else { 0 }
      i = i + 1
    }
    result
  }
}

pub(package) fn semantic_type_fact_associated_or_qualified(ty: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFact {
  let start = ty_assoc_source_start(ty)
  let len = ty_assoc_source_len(ty)
  let mut dot = 0 - 1
  let mut i = 0
  while i < len and dot < 0 {
    if mem_load8_at(src, start + i) == 46 { dot = i } else { i = i + 1 }
  }
  if dot > 0 and dot + 1 < len and module_scope_qualifier_is_module(tt, src, src, start, dot) == 1 {
    SemanticTypeQualifiedNamed(
      semantic_type_fact_copy(src + start, dot),
      semantic_type_fact_copy(src + start + dot + 1, len - dot - 1),
      SemanticTypeFactListNil
    )
  } else {
    SemanticTypeAssociated(semantic_type_fact(ty_f1(ty), tt, src, tparams), semantic_type_fact_associated_name(tt, ty_f2(ty)))
  }
}

pub(package) fn semantic_type_fact_type_param_name(tparams: i64, src: i64, id: i64) -> str {
  if id == 0 - 1 { "Self" }
  else { if tparams == 0 { "unknown" }
  else {
    let mut i = 0
    let mut found = 0
    while i < nlist_len(tparams) and found == 0 {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == id { found = tp } else { i = i + 1 }
    }
    if found == 0 { "unknown" }
    else { semantic_type_fact_copy(src + node_f1(found), node_f2(found)) }
  } }
}

pub(package) fn semantic_type_fact_list(types: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFactList {
  if types == 0 { SemanticTypeFactListNil }
  else {
    let mut result = SemanticTypeFactListNil
    let mut i = nlist_len(types)
    while i > 0 {
      i = i - 1
      result = SemanticTypeFactListCons(semantic_type_fact(nlist_get(types, i), tt, src, tparams), result)
    }
    result
  }
}

pub(package) fn semantic_type_fact_record_fields(fields: i64, tt: i64, src: i64, tparams: i64, tuple: bool) -> SemanticRecordFieldFactList {
  if fields == 0 { SemanticRecordFieldFactListNil }
  else {
    let mut result = SemanticRecordFieldFactListNil
    let mut i = nlist_len(fields)
    while i > 0 {
      i = i - 1
      let field = nlist_get(fields, i)
      let len = ty_record_field_name_len(field)
      let name = if tuple or len == 0 { "" } else { semantic_type_fact_copy(src + ty_record_field_name_start(field), len) }
      result = SemanticRecordFieldFactListCons(SemanticRecordField(name, i, semantic_type_fact(ty_record_field_type(field), tt, src, tparams)), result)
    }
    result
  }
}

pub(package) fn semantic_type_fact_effect_atom(atom: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectAtomFact {
  if atom == 0 { SemanticEffectAtomOther("missing") }
  else {
    let tag = ty_tag(atom)
    if tag == 25 {
      let decl = ty_f1(atom)
      let module_entry = module_decl_fact_module(decl)
      if module_entry != 0 and module_fact_entry_path_len(module_entry) > 0 {
        SemanticQualifiedEffectAtom(
          semantic_type_fact_copy(module_fact_entry_path_ptr(module_entry), module_fact_entry_path_len(module_entry)),
          semantic_type_fact_copy(module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl)),
          semantic_type_fact_list(effect_atom_args(atom), tt, src, tparams)
        )
      } else {
        SemanticEffectAtom(semantic_type_fact_copy(module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl)), semantic_type_fact_list(effect_atom_args(atom), tt, src, tparams))
      }
    } else { if tag == 11 {
      let entry = ttable_find_entry_by_hash_kind(tt, effect_atom_head(atom), 2)
      if entry == 0 { SemanticEffectAtomOther("unknown_effect") }
      else { SemanticEffectAtom(semantic_type_fact_entry_name(entry), semantic_type_fact_list(effect_atom_args(atom), tt, src, tparams)) }
    } else { SemanticEffectAtomOther("invalid_effect_atom") } }
  }
}

pub(package) fn semantic_type_fact_effect_atoms(atoms: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectAtomFactList {
  if atoms == 0 { SemanticEffectAtomFactListNil }
  else {
    let mut result = SemanticEffectAtomFactListNil
    let mut i = nlist_len(atoms)
    while i > 0 {
      i = i - 1
      result = SemanticEffectAtomFactListCons(semantic_type_fact_effect_atom(nlist_get(atoms, i), tt, src, tparams), result)
    }
    result
  }
}

pub(package) fn semantic_type_fact_effects(effects: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectSetFact {
  if effects == 0 { SemanticEffectsClosed(SemanticEffectAtomFactListNil) }
  else { if ty_tag(effects) != 10 { SemanticEffectsOther("invalid_effect_set") }
  else {
    let atoms = semantic_type_fact_effect_atoms(ty_f1(effects), tt, src, tparams)
    let tail = ty_f2(effects)
    if tail == 0 { SemanticEffectsClosed(atoms) }
    else { SemanticEffectsOpen(atoms, semantic_type_fact_type_param_name(tparams, src, tail - 1)) }
  } }
}

pub(package) fn semantic_type_fact(ty: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFact {
  if ty == 0 { SemanticTypeOther("missing") }
  else {
    match ty_tag(ty) {
      0 -> SemanticTypeBottom
      1 -> SemanticTypeTop
      2 -> SemanticTypePrimitive(semantic_type_fact_primitive_name(ty_f1(ty)))
      3 -> SemanticTypeUnion(semantic_type_fact(ty_f1(ty), tt, src, tparams), semantic_type_fact(ty_f2(ty), tt, src, tparams))
      4 -> SemanticTypeIntersection(semantic_type_fact(ty_f1(ty), tt, src, tparams), semantic_type_fact(ty_f2(ty), tt, src, tparams))
      5 -> SemanticTypeComplement(semantic_type_fact(ty_f1(ty), tt, src, tparams))
      6 -> SemanticTypeFunction(semantic_type_fact_list(ty_f1(ty), tt, src, tparams), semantic_type_fact(ty_f2(ty), tt, src, tparams), semantic_type_fact_effects(ty_f3(ty), tt, src, tparams))
      7 -> SemanticTypeRecord(semantic_type_fact_record_fields(ty_record_fields(ty), tt, src, tparams, ty_record_tuple_kind(ty) != 0), ty_record_open(ty) != 0, ty_record_tuple_kind(ty) != 0)
      9 -> semantic_type_fact_named(ty, tt, src, tparams)
      10 -> SemanticTypeOther("effect_set_is_not_a_value_type")
      12 -> SemanticTypeVariable(semantic_type_fact_type_param_name(tparams, src, ty_var_id(ty)))
      13 -> SemanticTypeTrait(semantic_type_fact_trait_name(tt, ty_f1(ty)))
      14 -> SemanticTypeContinuation(semantic_type_fact(ty_f1(ty), tt, src, tparams), semantic_type_fact(ty_f2(ty), tt, src, tparams))
      15 -> SemanticTypePointer(semantic_type_fact(ty_f1(ty), tt, src, tparams), ty_f2(ty) != 0)
      16 -> SemanticTypeWeak(semantic_type_fact(ty_f1(ty), tt, src, tparams))
      17 -> SemanticTypeOther("promoted_atomic_managed")
      18 -> SemanticTypeUnique(semantic_type_fact(ty_f1(ty), tt, src, tparams))
      19 -> SemanticTypeOwned(semantic_type_fact(ty_f1(ty), tt, src, tparams))
      29 -> SemanticTypeBorrow(semantic_type_fact(ty_f1(ty), tt, src, tparams), ty_f2(ty) != 0)
      21 -> semantic_type_fact_associated_or_qualified(ty, tt, src, tparams)
      22 -> SemanticTypeArray(semantic_type_fact(ty_array_inner(ty), tt, src, tparams), ty_array_length(ty))
      23 -> SemanticTypeSlice(semantic_type_fact(ty_slice_inner(ty), tt, src, tparams), ty_slice_mutable(ty) != 0)
      _ -> SemanticTypeOther("unsupported")
    }
  }
}

pub(package) fn semantic_type_fact_from_checker(ty: i64, tt: i64, src: i64) -> SemanticTypeFact {
  semantic_type_fact(ty, tt, src, if tt == 0 { 0 } else { ttable_get_tparams(tt) })
}
