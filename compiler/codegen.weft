fn cg_par_match_arms_safe_depth(arms: i64, narms: i64, src: i64, loop_depth: i64) -> i64 {
  let mut safe = 1
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    let guard = node_f3(arm)
    if cg_par_body_safe_depth(node_f2(arm), src, loop_depth) == 0 {
      safe = 0
      i = narms
    } else {
      if guard != 0 {
        if cg_par_body_safe_depth(guard, src, loop_depth) == 0 {
          safe = 0
          i = narms
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
  }
  safe
}

fn cg_par_body_safe(node: i64, src: i64) -> i64 {
  cg_par_body_safe_depth(node, src, 0)
}

fn cg_par_body_safe_depth(node: i64, src: i64, loop_depth: i64) -> i64 {
  if node == 0 { 1 }
  else {
    match node_tag(node) {
      1 -> 1
      2 -> 1
      3 -> cg_par_body_safe_depth(node_f2(node), src, loop_depth) and cg_par_body_safe_depth(node_f3(node), src, loop_depth)
      4 -> if cg_par_call_is_pure_intrinsic(node, src) == 1 {
        cg_par_expr_list_safe_depth(node_f3(node), node_f4(node), src, loop_depth)
      } else { 0 }
      5 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth) and cg_par_body_safe_depth(node_f2(node), src, loop_depth) and cg_par_body_safe_depth(node_f3(node), src, loop_depth)
      6 -> cg_par_body_safe_depth(node_f3(node), src, loop_depth) and cg_par_body_safe_depth(node_f4(node), src, loop_depth)
      7 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth) and cg_par_body_safe_depth(node_f2(node), src, loop_depth)
      10 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth) and cg_par_body_safe_depth(node_f2(node), src, loop_depth + 1)
      11 -> cg_par_body_safe_depth(node_f3(node), src, loop_depth) and cg_par_body_safe_depth(node_f4(node), src, loop_depth)
      12 -> cg_par_body_safe_depth(node_f3(node), src, loop_depth)
      13 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth)
      14 -> cg_par_record_fields_safe_depth(node_f3(node), node_f4(node), src, loop_depth)
      15 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth) and cg_par_match_arms_safe_depth(node_f2(node), node_f3(node), src, loop_depth)
      22 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth)
      24 -> 1
      26 -> if loop_depth > 0 { cg_par_body_safe_depth(node_f1(node), src, loop_depth) } else { 0 }
      27 -> if loop_depth > 0 { 1 } else { 0 }
      29 -> 1
      32 -> if cg_par_perform_is_direct(node, src) == 1 {
        cg_par_expr_list_safe_depth(node_f4(node), nlist_len(node_f4(node)), src, loop_depth)
      } else { 0 }
      36 -> cg_par_map_is_direct_i64(node, src)
      37 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth)
      45 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth)
      46 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth) and cg_par_body_safe_depth(node_f2(node), src, loop_depth)
      48 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth)
      49 -> cg_par_body_safe_depth(node_f1(node), src, loop_depth + 1)
      51 -> 1
      _ -> 0
    }
  }
}

