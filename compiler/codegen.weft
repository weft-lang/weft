fn cg_fiber_lowering_ctx_eff_hash_offset() -> i64 { 0 }
fn cg_fiber_lowering_ctx_op_hash_offset() -> i64 { 8 }
fn cg_fiber_lowering_ctx_prev_offset() -> i64 { 16 }

fn cg_fiber_lowering_push(fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let ctx = alloc_bump(24)
  __mem_store64(ctx + cg_fiber_lowering_ctx_eff_hash_offset(), eff_hash)
  __mem_store64(ctx + cg_fiber_lowering_ctx_op_hash_offset(), op_hash)
  __mem_store64(ctx + cg_fiber_lowering_ctx_prev_offset(), fmap_fiber_lowering_top(fm))
  fmap_set_fiber_lowering_top(fm, ctx)
}

fn cg_fiber_lowering_pop(fm: i64) -> i64 {
  let ctx = fmap_fiber_lowering_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_fiber_lowering_top(fm, __mem_load64(ctx + cg_fiber_lowering_ctx_prev_offset()))
    0
  }
}

fn cg_fiber_lowering_matches(fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let ctx = fmap_fiber_lowering_top(fm)
  if ctx == 0 { 0 }
  else {
    if __mem_load64(ctx + cg_fiber_lowering_ctx_eff_hash_offset()) == eff_hash {
      if __mem_load64(ctx + cg_fiber_lowering_ctx_op_hash_offset()) == op_hash { 1 } else { 0 }
    } else { 0 }
  }
}

fn cg_fiber_lowering_eff_hash(fm: i64) -> i64 {
  let ctx = fmap_fiber_lowering_top(fm)
  if ctx == 0 { 0 } else { __mem_load64(ctx + cg_fiber_lowering_ctx_eff_hash_offset()) }
}

fn cg_fiber_lowering_op_hash(fm: i64) -> i64 {
  let ctx = fmap_fiber_lowering_top(fm)
  if ctx == 0 { 0 } else { __mem_load64(ctx + cg_fiber_lowering_ctx_op_hash_offset()) }
}

-- Check if a name exists in fmap (regardless of offset value)
fn fmap_contains_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut found = false
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          found = true
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}
fn fmap_contains(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_contains_qualified(fm, src, ns, nl, 0)
}

-- Update a fmap entry's offset (for hoisting: registered with 0, updated when compiled)
fn fmap_update_offset_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          __mem_store64(d + i * 40 + 16, off)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}
fn fmap_update_offset(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_update_offset_qualified(fm, src, ns, nl, 0, off)
}

-- Record a forward BL reference to be patched later
fn fmap_add_patch(fm: i64, pos: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pn = __mem_load64(fm + 32)
  let pcap = __mem_load64(fm + 40)
  if pn >= pcap {
    let pd = __mem_load64(fm + 24)
    let new_cap = pcap * 2
    let new_pd = alloc_bump(new_cap * 32)
    mem_copy(new_pd, pd, pn * 32)
    __mem_store64(fm + 24, new_pd)
    __mem_store64(fm + 40, new_cap)
    0
  } else { 0 }
  let pd = __mem_load64(fm + 24)
  __mem_store64(pd + pn * 32, pos)
  __mem_store64(pd + pn * 32 + 8, ns)
  __mem_store64(pd + pn * 32 + 16, nl)
  __mem_store64(pd + pn * 32 + 24, src)
  __mem_store64(fm + 32, pn + 1)
  0
}

-- ======================================================================
-- Method map: maps (type_hash, method_hash) → code offset + params
-- Entry: [type_hash(8), method_hash(8), code_offset(8), params(8)] = 32 bytes
-- ======================================================================

fn mmap_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(16000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mmap_add(mm: i64, type_hash: i64, method_hash: i64, off: i64, params: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let cap = __mem_load64(mm + 16)
  if n >= cap {
    eprint("error: method map overflow\n")
    mm
  } else {
    __mem_store64(d + n * 32, type_hash)
    __mem_store64(d + n * 32 + 8, method_hash)
    __mem_store64(d + n * 32 + 16, off)
    __mem_store64(d + n * 32 + 24, params)
    __mem_store64(mm + 8, n + 1)
    mm
  }
}

fn mmap_lookup(mm: i64, type_hash: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        result = __mem_load64(d + i * 32 + 16)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Lookup by method_hash only (for generic code where concrete type is unknown)
fn mmap_lookup_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32 + 8) == method_hash {
      result = __mem_load64(d + i * 32 + 16)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_lookup_params(mm: i64, type_hash: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        result = __mem_load64(d + i * 32 + 24)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn mmap_lookup_params_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32 + 8) == method_hash {
      result = __mem_load64(d + i * 32 + 24)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_update(mm: i64, type_hash: i64, method_hash: i64, off: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        __mem_store64(d + i * 32 + 16, off)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}

-- Check if an identifier node (tag 2) refers to an effect name in the ttable
fn is_effect_ident(node: i64, src: i64, tt: i64) -> i64 {
  if node_tag(node) != 2 { false }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    let entry = ttable_lookup(tt, src, ns, nl)
    if entry == 0 { false }
    else {
      let kind = __mem_load64(entry + 16)
      if kind == 2 { true } else { false }
    }
  }
}

-- ======================================================================
-- Monomorphisation: template map + specialisation cache
-- ======================================================================

-- Template map: stores generic function ASTs for on-demand specialisation
-- Entry: [name_hash(8), fn_wrap_ptr(8), src_ptr(8)] = 24 bytes
fn mono_tmap_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(12000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mono_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64) -> i64 {
  let d = __mem_load64(tm)
  let n = __mem_load64(tm + 8)
  let cap = __mem_load64(tm + 16)
  if n >= cap { tm }
  else {
    __mem_store64(d + n * 24, name_hash)
    __mem_store64(d + n * 24 + 8, fn_wrap)
    __mem_store64(d + n * 24 + 16, src)
    __mem_store64(tm + 8, n + 1)
    tm
  }
}

fn mono_tmap_lookup(tm: i64, name_hash: i64) -> i64 {
  let d = __mem_load64(tm)
  let n = __mem_load64(tm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 24) == name_hash {
      result = d + i * 24
      i = n
    } else { i = i + 1 }
  }
  result
}

-- Specialisation cache: deduplicates identical generic instantiations
-- Entry: [spec_hash(8), code_offset(8)] = 16 bytes
fn mono_cache_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(8000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mono_cache_lookup(mc: i64, spec_hash: i64) -> i64 {
  let d = __mem_load64(mc)
  let n = __mem_load64(mc + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 16) == spec_hash {
      result = __mem_load64(d + i * 16 + 8)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mono_cache_add(mc: i64, spec_hash: i64, off: i64) -> i64 {
  let d = __mem_load64(mc)
  let n = __mem_load64(mc + 8)
  let cap = __mem_load64(mc + 16)
  if n >= cap { mc }
  else {
    __mem_store64(d + n * 16, spec_hash)
    __mem_store64(d + n * 16 + 8, off)
    __mem_store64(mc + 8, n + 1)
    mc
  }
}

fn borrow_tmap_new() -> i64 {
  nlist_new()
}

fn borrow_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64, owner_hash: i64) -> i64 {
  nlist_add(tm, node_new(0, name_hash, fn_wrap, src, owner_hash))
}

fn borrow_tmap_lookup(tm: i64, name_hash: i64, owner_hash: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(tm) {
    let e = nlist_get(tm, i)
    if node_f1(e) == name_hash {
      if node_f4(e) == owner_hash {
        result = e
        i = nlist_len(tm)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn borrow_cache_new() -> i64 {
  nlist_new()
}

fn borrow_cache_lookup(cache: i64, name_hash: i64, owner_hash: i64, mask: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(cache) {
    let e = nlist_get(cache, i)
    if node_f1(e) == name_hash {
      if node_f2(e) == owner_hash {
        if node_f3(e) == mask {
          result = node_f4(e)
          i = nlist_len(cache)
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn borrow_cache_add(cache: i64, name_hash: i64, owner_hash: i64, mask: i64, off: i64) -> i64 {
  nlist_add(cache, node_new(0, name_hash, owner_hash, mask, off))
}

fn fiber_cache_new() -> i64 {
  nlist_new()
}

fn fiber_cache_add(cache: i64, name_hash: i64, owner_hash: i64, eff_hash: i64, op_hash: i64, off: i64) -> i64 {
  let e = alloc_bump(40)
  __mem_store64(e, name_hash)
  __mem_store64(e + 8, owner_hash)
  __mem_store64(e + 16, eff_hash)
  __mem_store64(e + 24, op_hash)
  __mem_store64(e + 32, off)
  nlist_add(cache, e)
}

fn fiber_cache_lookup(cache: i64, name_hash: i64, owner_hash: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(cache) {
    let e = nlist_get(cache, i)
    if __mem_load64(e) == name_hash {
      if __mem_load64(e + 8) == owner_hash {
        if __mem_load64(e + 16) == eff_hash {
          if __mem_load64(e + 24) == op_hash {
            result = __mem_load64(e + 32)
            i = nlist_len(cache)
          } else { i = i + 1 }
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn evidence_cache_new() -> i64 {
  nlist_new()
}

fn evidence_cache_add(cache: i64, name_hash: i64, owner_hash: i64, evidence_hash: i64, callback_hash: i64, off: i64) -> i64 {
  let e = alloc_bump(40)
  __mem_store64(e, name_hash)
  __mem_store64(e + 8, owner_hash)
  __mem_store64(e + 16, evidence_hash)
  __mem_store64(e + 24, callback_hash)
  __mem_store64(e + 32, off)
  nlist_add(cache, e)
}

fn evidence_cache_lookup(cache: i64, name_hash: i64, owner_hash: i64, evidence_hash: i64, callback_hash: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(cache) {
    let e = nlist_get(cache, i)
    if __mem_load64(e) == name_hash {
      if __mem_load64(e + 8) == owner_hash {
        if __mem_load64(e + 16) == evidence_hash {
          if __mem_load64(e + 24) == callback_hash {
            result = __mem_load64(e + 32)
            i = nlist_len(cache)
          } else { i = i + 1 }
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn cg_bit(index: i64) -> i64 {
  let mut result = 1
  let mut i = 0
  while i < index {
    result = result * 2
    i = i + 1
  }
  result
}

fn cg_mask_has(mask: i64, index: i64) -> i64 {
  let bit = cg_bit(index)
  if (mask / bit) - (mask / (bit * 2)) * 2 == 1 { 1 } else { 0 }
}

fn cg_mask_subset(mask: i64, allowed: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < 60 and ok == 1 {
    if cg_mask_has(mask, i) == 1 and cg_mask_has(allowed, i) == 0 {
      ok = 0
    } else { i = i + 1 }
  }
  ok
}

fn cg_type_list_hash(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let mut h = 1469598103934665603
    let n = nlist_len(types)
    for i in 0..n {
      h = h * 1099511628211 + cg_type_node_hash(nlist_get(types, i))
    }
    h
  }
}

fn cg_type_args_in_current_context(fm: i64, type_args: i64) -> i64 {
  let subst = fmap_current_generic_subst(fm)
  if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
}

fn cg_type_node_hash(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      1 -> 101
      2 -> 0 - ty_f1(ty) - 1
      3 -> 301 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      4 -> 401 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      5 -> 501 + cg_type_node_hash(ty_f1(ty)) * 31
      6 -> 601 + cg_type_list_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17 + cg_type_node_hash(ty_f3(ty))
      9 -> 901 + ty_f1(ty) * 31 + cg_type_node_hash(ty_f2(ty)) * 17 + cg_type_list_hash(ty_f3(ty))
      10 -> 1001 + cg_type_list_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty))
      11 -> 1101 + ty_f1(ty)
      12 -> 1201 + ty_f1(ty)
      13 -> 1301 + ty_f1(ty)
      14 -> 1401 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      _ -> tag
    }
  }
}

-- Compute specialisation hash: combine function name hash with type arg values
fn mono_spec_hash(name_hash: i64, type_args: i64) -> i64 {
  let mut h = name_hash
  let n = nlist_len(type_args)
  for i in 0..n {
    h = h * 31 + cg_type_node_hash(nlist_get(type_args, i))
  }
  h
}

-- ======================================================================
-- Prologue / epilogue
-- ======================================================================

fn emit_prologue(code: i64) -> i64 {
  bu32(code, encode_stp_pre(8, 9, 31, 0 - 16))
  bu32(code, encode_stp_pre(10, 11, 31, 0 - 16))
  bu32(code, encode_stp_pre(12, 13, 31, 0 - 16))
  bu32(code, encode_stp_pre(14, 15, 31, 0 - 16))
  emit_prologue2(code)
}
fn emit_prologue2(code: i64) -> i64 {
  bu32(code, encode_stp_pre(19, 20, 31, 0 - 16))
  bu32(code, encode_stp_pre(21, 22, 31, 0 - 16))
  bu32(code, encode_stp_pre(23, 24, 31, 0 - 16))
  bu32(code, encode_stp_pre(25, 26, 31, 0 - 16))
  emit_prologue3(code)
}
fn emit_prologue3(code: i64) -> i64 {
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  bu32(code, encode_add_imm(29, 31, 0))
  bu32(code, encode_sub_imm(31, 31, 2048))
}

fn emit_epilogue(code: i64) -> i64 {
  bu32(code, encode_add_imm(31, 31, 2048))
  bu32(code, encode_ldp_post(29, 30, 31, 16))
  bu32(code, encode_ldp_post(25, 26, 31, 16))
  bu32(code, encode_ldp_post(23, 24, 31, 16))
  emit_epilogue2(code)
}
fn emit_epilogue2(code: i64) -> i64 {
  bu32(code, encode_ldp_post(21, 22, 31, 16))
  bu32(code, encode_ldp_post(19, 20, 31, 16))
  bu32(code, encode_ldp_post(14, 15, 31, 16))
  bu32(code, encode_ldp_post(12, 13, 31, 16))
  emit_epilogue3(code)
}
fn emit_epilogue3(code: i64) -> i64 {
  bu32(code, encode_ldp_post(10, 11, 31, 16))
  bu32(code, encode_ldp_post(8, 9, 31, 16))
  bu32(code, encode_ret())
}

-- ======================================================================
-- Register allocation
-- ======================================================================

-- Map register counter to register identifier
-- 0-7 -> x19-x26 (physical, returned as 19-26)
-- 8+ -> spill slot (returned as negative: -(slot+1))
fn reg_id(counter: i64) -> i64 {
  if counter < 8 { counter + 19 }
  else { 0 - (counter - 7) }
}

-- For backward compatibility
fn reg_phys(counter: i64) -> i64 {
  if counter < 8 { counter + 19 } else { 17 }
}

-- Emit: move value from reg_phys(counter) to a usable register
-- If counter < 8, the value is already in a physical register.
-- If counter >= 8, emit LDR from spill slot into x16 (temp).
fn emit_load_reg(code: i64, counter: i64) -> i64 {
  -- Returns the physical register containing the value
  if counter < 8 { counter + 19 }
  else {
    -- LDR x16, [sp, #((counter-8)*8)]
    -- 0xF9400000 = 4181721088
    let slot = (counter - 8) * 8
    bu32(code, cg_ldr(16, 31, slot))
    16
  }
}

fn emit_load_reg_id(code: i64, rid: i64, temp: i64) -> i64 {
  if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(temp, 31, slot * 8))
    temp
  } else { rid }
}

fn emit_load_counter_to(code: i64, counter: i64, temp: i64) -> i64 {
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    bu32(code, cg_ldr(temp, 31, slot))
    temp
  }
}

fn emit_move_counter_to(code: i64, counter: i64, temp: i64) -> i64 {
  let phys = emit_load_counter_to(code, counter, temp)
  if phys == temp { 0 }
  else { bu32(code, encode_add_imm(temp, phys, 0)) }
}

fn emit_load_rhs(code: i64, counter: i64) -> i64 {
  -- Same as emit_load_reg but uses x17 instead of x16
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    bu32(code, cg_ldr(17, 31, slot))
    17
  }
}

fn emit_store_reg(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter >= 8 {
    -- STR phys_reg, [sp, #((counter-8)*8)]
    -- 0xF9000000 = 4177526784
    let slot = (counter - 8) * 8
    bu32(code, cg_str(phys_reg, 31, slot))
  } else { 0 }
}

fn emit_store_counter_from_phys(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter < 8 {
    bu32(code, encode_add_imm(counter + 19, phys_reg, 0))
  } else {
    emit_store_reg(code, counter, phys_reg)
  }
}

fn cg_span_eq(a_src: i64, a_ns: i64, a_nl: i64, b_src: i64, b_ns: i64, b_nl: i64) -> i64 {
  if a_nl != b_nl { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < a_nl {
      if __mem_load8(a_src + a_ns + i) != __mem_load8(b_src + b_ns + i) {
        ok = 0
        i = a_nl
      } else { i = i + 1 }
    }
    ok
  }
}

fn cg_ident_matches(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 2 { 0 }
  else { cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) } }
}

fn cg_expr_is_nonnegative_i64_literal(node: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 1 { 0 }
  else { if node_f1(node) >= 0 { 1 } else { 0 } } }
}

fn cg_nonnegative_push(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let entry = alloc_bump(32)
  __mem_store64(entry, fmap_nonnegative_top(fm))
  __mem_store64(entry + 8, src)
  __mem_store64(entry + 16, ns)
  __mem_store64(entry + 24, nl)
  fmap_set_nonnegative_top(fm, entry)
}

fn cg_nonnegative_has(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut cur = fmap_nonnegative_top(fm)
  let mut found = 0
  while cur != 0 {
    if cg_span_eq(__mem_load64(cur + 8), __mem_load64(cur + 16), __mem_load64(cur + 24), src, ns, nl) == 1 {
      found = 1
      cur = 0
    } else { cur = __mem_load64(cur) }
  }
  found
}

fn cg_expr_assign_rhs_preserves_nonnegative(val: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if cg_expr_is_nonnegative_i64_literal(val) == 1 { 1 }
  else { if cg_ident_matches(val, src, ns, nl) == 1 { 1 }
  else { if node_tag(val) != 3 { 0 }
  else { if node_f1(val) != 1 { 0 }
  else {
    let lhs = node_f2(val)
    let rhs = node_f3(val)
    if cg_ident_matches(lhs, src, ns, nl) == 1 {
      cg_expr_is_nonnegative_i64_literal(rhs)
    } else { 0 }
  } } } }
}

fn cg_assignment_preserves_existing_nonnegative(fm: i64, node: i64, src: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  if cg_nonnegative_has(fm, src, ns, nl) != 1 { 1 }
  else { cg_expr_assign_rhs_preserves_nonnegative(node_f3(node), src, ns, nl) }
}

fn cg_expr_preserves_nonnegative_var(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 1 }
  else {
    let tag = node_tag(node)
    match tag {
      6 -> {
        if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 { 1 }
        else { cg_expr_preserves_nonnegative_var(node_f4(node), src, ns, nl) }
      }
      7 -> {
        if cg_expr_preserves_nonnegative_var(node_f1(node), src, ns, nl) != 1 { 0 }
        else { cg_expr_preserves_nonnegative_var(node_f2(node), src, ns, nl) }
      }
      8 -> {
        if cg_expr_preserves_nonnegative_var(node_f2(node), src, ns, nl) != 1 { 0 }
        else { cg_expr_preserves_nonnegative_var(node_f3(node), src, ns, nl) }
      }
      10 -> cg_expr_preserves_nonnegative_var(node_f2(node), src, ns, nl)
      11 -> {
        if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 { 1 }
        else { cg_expr_preserves_nonnegative_var(node_f4(node), src, ns, nl) }
      }
      12 -> {
        if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) != 1 { 1 }
        else { cg_expr_assign_rhs_preserves_nonnegative(node_f3(node), src, ns, nl) }
      }
      _ -> 1
    }
  }
}

fn cg_vector_bounds_invalidate(fm: i64) -> i64 {
  fmap_set_vector_bounds_top(fm, 0)
}

fn cg_vector_facts_invalidate(fm: i64) -> i64 {
  fmap_set_vector_bounds_top(fm, 0)
  fmap_set_vector_len_alias_top(fm, 0)
  fmap_set_vector_capacity_top(fm, 0)
}

fn cg_vector_all_facts_invalidate(fm: i64) -> i64 {
  fmap_set_vector_bounds_top(fm, 0)
  fmap_set_vector_len_alias_top(fm, 0)
  fmap_set_vector_data_top(fm, 0)
  fmap_set_vector_capacity_top(fm, 0)
  fmap_set_vector_push_proof_top(fm, 0)
}

fn cg_expr_same_simple(a: i64, b: i64, src: i64) -> i64 {
  if a == 0 or b == 0 { 0 }
  else {
    let at = node_tag(a)
    if at != node_tag(b) { 0 }
    else {
      match at {
        1 -> if node_f1(a) == node_f1(b) { 1 } else { 0 }
        2 -> cg_span_eq(src, node_f1(a), node_f2(a), src, node_f1(b), node_f2(b))
        3 -> {
          if node_f1(a) != node_f1(b) { 0 }
          else { if cg_expr_same_simple(node_f2(a), node_f2(b), src) != 1 { 0 }
          else { cg_expr_same_simple(node_f3(a), node_f3(b), src) } }
        }
        _ -> 0
      }
    }
  }
}

fn cg_vector_with_capacity_i64_arg(node: i64, scope: i64, src: i64) -> i64 {
  if cg_generic_call_is_i64(node, src, "vector_with_capacity", 1, 1) != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { nlist_get(node_f3(call_node), 0) }
  }
}

fn cg_vector_capacity_push_if_needed(fm: i64, src: i64, ns: i64, nl: i64, val: i64, scope: i64) -> i64 {
  let cap = cg_vector_with_capacity_i64_arg(val, scope, src)
  if cap == 0 { 0 }
  else {
    let entry = alloc_bump(48)
    __mem_store64(entry, fmap_vector_capacity_top(fm))
    __mem_store64(entry + 8, src)
    __mem_store64(entry + 16, ns)
    __mem_store64(entry + 24, nl)
    __mem_store64(entry + 32, cap)
    __mem_store64(entry + 40, 0)
    fmap_set_vector_capacity_top(fm, entry)
  }
}

fn cg_vector_capacity_find_for_cap(fm: i64, src: i64, cap: i64) -> i64 {
  let mut cur = fmap_vector_capacity_top(fm)
  let mut found = 0
  while cur != 0 {
    if cg_expr_same_simple(__mem_load64(cur + 32), cap, src) == 1 {
      found = cur
      cur = 0
    } else { cur = __mem_load64(cur) }
  }
  found
}

