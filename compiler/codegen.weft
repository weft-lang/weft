fn fmap_add_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let cap = mem_load64_at(fm + 16, 0)
  if n >= cap {
    -- Grow: allocate 2x, copy
    let d = mem_load64_at(fm, 0)
    let new_cap = cap * 2
    let new_d = cg_alloc_bytes(new_cap * 40)
    mem_copy(new_d, d, n * 40)
    mem_store64_at(fm, 0, new_d)
    mem_store64_at(fm + 16, 0, new_cap)
    0
  } else { 0 }
  let d = mem_load64_at(fm, 0)
  mem_store64_at(d + n * 40, 0, ns)
  mem_store64_at(d + n * 40 + 8, 0, nl)
  mem_store64_at(d + n * 40 + 16, 0, off)
  mem_store64_at(d + n * 40 + 24, 0, src)
  mem_store64_at(d + n * 40 + 32, 0, owner_hash)
  mem_store64_at(fm + 8, 0, n + 1)
  fm
}
fn fmap_add(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_add_qualified(fm, src, ns, nl, 0, off)
}
fn fmap_lookup_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_owner = mem_load64_at(d + i * 40 + 32, 0)
    if e_owner == owner_hash {
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      if e_nl == nl {
        let e_src = mem_load64_at(d + i * 40 + 24, 0)
        if src_eq_at(src, ns, e_src + mem_load64_at(d + i * 40, 0), 0, nl) == 1 {
          result = mem_load64_at(d + i * 40 + 16, 0)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
fn fmap_lookup(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_lookup_qualified(fm, src, ns, nl, 0)
}

fn fmap_contains_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut found = false
  while i < n {
    let e_owner = mem_load64_at(d + i * 40 + 32, 0)
    if e_owner == owner_hash {
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      if e_nl == nl {
        let e_src = mem_load64_at(d + i * 40 + 24, 0)
        if src_eq_at(src, ns, e_src + mem_load64_at(d + i * 40, 0), 0, nl) == 1 {
          found = true
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}
fn fmap_contains(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_contains_qualified(fm, src, ns, nl, 0)
}

-- Update a fmap entry's offset (for hoisting: registered with 0, updated when compiled)
fn fmap_update_offset_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  while i < n {
    let e_owner = mem_load64_at(d + i * 40 + 32, 0)
    if e_owner == owner_hash {
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      if e_nl == nl {
        let e_src = mem_load64_at(d + i * 40 + 24, 0)
        if src_eq_at(src, ns, e_src + mem_load64_at(d + i * 40, 0), 0, nl) == 1 {
          mem_store64_at(d + i * 40 + 16, 0, off)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}
fn fmap_update_offset(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_update_offset_qualified(fm, src, ns, nl, 0, off)
}

-- Record a forward BL reference to be patched later
fn fmap_add_patch(fm: i64, pos: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pn = mem_load64_at(fm + 32, 0)
  let pcap = mem_load64_at(fm + 40, 0)
  if pn >= pcap {
    let pd = mem_load64_at(fm + 24, 0)
    let new_cap = pcap * 2
    let new_pd = cg_alloc_bytes(new_cap * 32)
    mem_copy(new_pd, pd, pn * 32)
    mem_store64_at(fm + 24, 0, new_pd)
    mem_store64_at(fm + 40, 0, new_cap)
    0
  } else { 0 }
  let pd = mem_load64_at(fm + 24, 0)
  mem_store64_at(pd + pn * 32, 0, pos)
  mem_store64_at(pd + pn * 32 + 8, 0, ns)
  mem_store64_at(pd + pn * 32 + 16, 0, nl)
  mem_store64_at(pd + pn * 32 + 24, 0, src)
  mem_store64_at(fm + 32, 0, pn + 1)
  0
}

-- ======================================================================
-- Method map: maps (type_hash, method_hash) → code offset + params
-- Entry: [type_hash(8), method_hash(8), code_offset(8), params(8)] = 32 bytes
-- ======================================================================

fn mmap_new() -> i64 {
  let h = cg_alloc_bytes(24)
  let d = cg_alloc_bytes(16000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 500)
  h
}

-- Returns 1 on overflow (caller must record an emission error), 0 on success.
fn mmap_add(mm: i64, type_hash: i64, method_hash: i64, off: i64, params: i64) -> i64 {
  let d = mem_load64_at(mm, 0)
  let n = mem_load64_at(mm + 8, 0)
  let cap = mem_load64_at(mm + 16, 0)
  if n >= cap {
    eprint("error: method map overflow\n")
    1
  } else {
    mem_store64_at(d + n * 32, 0, type_hash)
    mem_store64_at(d + n * 32 + 8, 0, method_hash)
    mem_store64_at(d + n * 32 + 16, 0, off)
    mem_store64_at(d + n * 32 + 24, 0, params)
    mem_store64_at(mm + 8, 0, n + 1)
    0
  }
}

fn mmap_lookup(mm: i64, type_hash: i64, method_hash: i64) -> i64 {
  let d = mem_load64_at(mm, 0)
  let n = mem_load64_at(mm + 8, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    if mem_load64_at(d + i * 32, 0) == type_hash {
      if mem_load64_at(d + i * 32 + 8, 0) == method_hash {
        result = mem_load64_at(d + i * 32 + 16, 0)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Lookup by method_hash only (for generic code where concrete type is unknown)
fn mmap_lookup_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = mem_load64_at(mm, 0)
  let n = mem_load64_at(mm + 8, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    if mem_load64_at(d + i * 32 + 8, 0) == method_hash {
      result = mem_load64_at(d + i * 32 + 16, 0)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_lookup_type_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = mem_load64_at(mm, 0)
  let n = mem_load64_at(mm + 8, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    if mem_load64_at(d + i * 32 + 8, 0) == method_hash {
      result = mem_load64_at(d + i * 32, 0)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_update(mm: i64, type_hash: i64, method_hash: i64, off: i64) -> i64 {
  let d = mem_load64_at(mm, 0)
  let n = mem_load64_at(mm + 8, 0)
  let mut i = 0
  while i < n {
    if mem_load64_at(d + i * 32, 0) == type_hash {
      if mem_load64_at(d + i * 32 + 8, 0) == method_hash {
        mem_store64_at(d + i * 32 + 16, 0, off)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}

-- Check if an identifier node (tag 2) refers to an effect name in the ttable
fn is_effect_ident(node: i64, src: i64, tt: i64) -> bool {
  if node_tag(node) != 2 { false }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    let entry = ttable_lookup(tt, src, ns, nl)
    if entry == 0 { false }
    else {
      let kind = mem_load64_at(entry + 16, 0)
      if kind == 2 { true } else { false }
    }
  }
}

-- ======================================================================
-- Monomorphisation: template map + specialisation cache
-- ======================================================================

-- Template map: stores generic function ASTs for on-demand specialisation
-- Entry: [name_hash(8), fn_wrap_ptr(8), src_ptr(8)] = 24 bytes
fn mono_tmap_new() -> i64 {
  let h = cg_alloc_bytes(24)
  let d = cg_alloc_bytes(12000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 500)
  h
}

fn mono_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64) -> i64 {
  let d = mem_load64_at(tm, 0)
  let n = mem_load64_at(tm + 8, 0)
  let cap = mem_load64_at(tm + 16, 0)
  if n >= cap { tm }
  else {
    mem_store64_at(d + n * 24, 0, name_hash)
    mem_store64_at(d + n * 24 + 8, 0, fn_wrap)
    mem_store64_at(d + n * 24 + 16, 0, src)
    mem_store64_at(tm + 8, 0, n + 1)
    tm
  }
}

fn mono_tmap_lookup(tm: i64, name_hash: i64) -> i64 {
  let d = mem_load64_at(tm, 0)
  let n = mem_load64_at(tm + 8, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    if mem_load64_at(d + i * 24, 0) == name_hash {
      result = d + i * 24
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mono_cache_new() -> i64 {
  let h = cg_alloc_bytes(48)
  let d = cg_alloc_bytes(8000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 500)
  mem_store64_at(h + 24, 0, 0)
  mem_store64_at(h + 32, 0, 0)
  h
}

fn mono_idx_new_node(spec_hash: i64, idx: i64) -> i64 {
  let nd = cg_alloc_bytes(32)
  mem_store64_at(nd, 0, spec_hash)
  mem_store64_at(nd + 8, 0, idx)
  mem_store64_at(nd + 16, 0, 0)
  mem_store64_at(nd + 24, 0, 0)
  nd
}

fn mono_idx_insert(mc: i64, spec_hash: i64, idx: i64) -> i64 {
  let root = mem_load64_at(mc + 24, 0)
  if root == 0 {
    mem_store64_at(mc + 24, 0, mono_idx_new_node(spec_hash, idx))
  } else {
    let mut cur = root
    let mut done = 0
    while done == 0 {
      let h = mem_load64_at(cur, 0)
      if spec_hash == h {
        mem_store64_at(cur + 8, 0, idx)
        done = 1
      } else {
        let side = if spec_hash < h { 16 } else { 24 }
        let child = mem_load64_at(cur + side, 0)
        if child == 0 {
          mem_store64_at(cur + side, 0, mono_idx_new_node(spec_hash, idx))
          done = 1
        } else {
          cur = child
        }
      }
    }
  }
  1
}

fn mono_idx_probe(mc: i64, spec_hash: i64) -> i64 {
  let mut cur = mem_load64_at(mc + 24, 0)
  let mut result = 0 - 1
  while cur != 0 {
    let h = mem_load64_at(cur, 0)
    if spec_hash == h {
      result = mem_load64_at(cur + 8, 0)
      cur = 0
    } else {
      let side = if spec_hash < h { 16 } else { 24 }
      cur = mem_load64_at(cur + side, 0)
    }
  }
  result
}

fn mono_cache_index_topup(mc: i64) -> i64 {
  let n = mem_load64_at(mc + 8, 0)
  let mut i = mem_load64_at(mc + 32, 0)
  let d = mem_load64_at(mc, 0)
  while i < n {
    mono_idx_insert(mc, mem_load64_at(d + i * 16, 0), i)
    i = i + 1
  }
  mem_store64_at(mc + 32, 0, n)
  1
}

fn mono_cache_grow(mc: i64) -> i64 {
  let old_d = mem_load64_at(mc, 0)
  let n = mem_load64_at(mc + 8, 0)
  let old_cap = mem_load64_at(mc + 16, 0)
  let new_cap = if old_cap <= 0 { 500 } else { old_cap * 2 }
  let new_d = cg_alloc_bytes(new_cap * 16)
  for i in 0..n {
    mem_store64_at(new_d + i * 16, 0, mem_load64_at(old_d + i * 16, 0))
    mem_store64_at(new_d + i * 16 + 8, 0, mem_load64_at(old_d + i * 16 + 8, 0))
  }
  mem_store64_at(mc, 0, new_d)
  mem_store64_at(mc + 16, 0, new_cap)
  mc
}

fn mono_cache_lookup(mc: i64, spec_hash: i64) -> i64 {
  mono_cache_index_topup(mc)
  let idx = mono_idx_probe(mc, spec_hash)
  if idx < 0 {
    0
  } else {
    let d = mem_load64_at(mc, 0)
    mem_load64_at(d + idx * 16 + 8, 0)
  }
}

fn mono_cache_add(mc: i64, spec_hash: i64, off: i64) -> i64 {
  mono_cache_index_topup(mc)
  let idx = mono_idx_probe(mc, spec_hash)
  if idx >= 0 {
    let d = mem_load64_at(mc, 0)
    mem_store64_at(d + idx * 16 + 8, 0, off)
    mc
  } else {
    let n = mem_load64_at(mc + 8, 0)
    let cap = mem_load64_at(mc + 16, 0)
    if n >= cap { mono_cache_grow(mc) } else { mc }
    let next_d = mem_load64_at(mc, 0)
    mem_store64_at(next_d + n * 16, 0, spec_hash)
    mem_store64_at(next_d + n * 16 + 8, 0, off)
    mem_store64_at(mc + 8, 0, n + 1)
    mono_idx_insert(mc, spec_hash, n)
    mem_store64_at(mc + 32, 0, n + 1)
    mc
  }
}

fn borrow_tmap_new() -> i64 {
  nlist_new()
}

fn borrow_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64, owner_hash: i64) -> i64 {
  nlist_add(tm, node_new(0, name_hash, fn_wrap, src, owner_hash))
}

fn borrow_cache_new() -> i64 {
  nlist_new()
}

fn fiber_cache_new() -> i64 {
  nlist_new()
}

fn evidence_cache_new() -> i64 {
  nlist_new()
}

fn evidence_info_cache_new() -> i64 {
  nlist_new()
}

fn cg_bit(index: i64) -> i64 {
  let mut result = 1
  let mut i = 0
  while i < index {
    result = result * 2
    i = i + 1
  }
  result
}

fn cg_mask_has(mask: i64, index: i64) -> i64 {
  let bit = cg_bit(index)
  if (mask / bit) - (mask / (bit * 2)) * 2 == 1 { 1 } else { 0 }
}

fn cg_type_list_hash(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let mut h = 1469598103934665603
    let n = nlist_len(types)
    for i in 0..n {
      h = h * 1099511628211 + cg_type_node_hash(nlist_get(types, i))
    }
    h
  }
}

fn cg_type_args_in_current_context(fm: i64, type_args: i64) -> i64 {
  let subst = fmap_current_generic_subst(fm)
  if subst == 0 { type_args } else { type_list_subst(type_args, subst) }
}

fn cg_type_node_hash(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      1 -> 101
      2 -> 0 - ty_f1(ty) - 1
      3 -> 301 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      4 -> 401 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      5 -> 501 + cg_type_node_hash(ty_f1(ty)) * 31
      6 -> 601 + cg_type_list_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17 + cg_type_node_hash(ty_f3(ty))
      9 -> 901 + ty_f1(ty) * 31 + cg_type_node_hash(ty_f2(ty)) * 17 + cg_type_list_hash(ty_f3(ty))
      10 -> 1001 + cg_type_list_hash(ty_f1(ty)) * 31 + ty_f2(ty) * 17
      11 -> 1101 + ty_f1(ty) * 31 + cg_type_list_hash(ty_f2(ty))
      12 -> 1201 + ty_f1(ty)
      13 -> 1301 + ty_f1(ty)
      14 -> 1401 + cg_type_node_hash(ty_f1(ty)) * 31 + cg_type_node_hash(ty_f2(ty)) * 17
      15 -> 1501 + cg_type_node_hash(ty_f1(ty)) * 31 + ty_f2(ty)
      16 -> 1601 + cg_type_node_hash(ty_f1(ty)) * 31
      17 -> 1701 + cg_type_node_hash(ty_f1(ty)) * 31
      18 -> 1801 + cg_type_node_hash(ty_f1(ty)) * 31
      19 -> 1901 + cg_type_node_hash(ty_f1(ty)) * 31
      _ -> tag
    }
  }
}

-- Compute specialisation hash: combine function name hash with type arg values
fn mono_spec_hash(name_hash: i64, type_args: i64) -> i64 {
  let mut h = name_hash
  let n = nlist_len(type_args)
  for i in 0..n {
    h = h * 31 + cg_type_node_hash(nlist_get(type_args, i))
  }
  h
}

-- ======================================================================
-- Prologue / epilogue
-- ======================================================================

fn emit_stack_sub(code: i64, size: i64) -> i64 {
  let mut remaining = size
  while remaining > 0 {
    let chunk = if remaining > cg_stack_adjust_chunk_size() { cg_stack_adjust_chunk_size() } else { remaining }
    bu32(code, encode_sub_imm(31, 31, chunk))
    remaining = remaining - chunk
  }
  0
}

fn emit_stack_add(code: i64, size: i64) -> i64 {
  let mut remaining = size
  while remaining > 0 {
    let chunk = if remaining > cg_stack_adjust_chunk_size() { cg_stack_adjust_chunk_size() } else { remaining }
    bu32(code, encode_add_imm(31, 31, chunk))
    remaining = remaining - chunk
  }
  0
}

-- x8-x15 are volatile scratch: the pinned-slot bank is leaf-only, the
-- vector-data/FP envs are cleared across calls, and composite emitters
-- re-derive their temps after any BL, so no live state crosses a call in
-- that bank and prologues do not save it (2l stage 1).
-- The x19-x26 value bank saves only the pairs the function can write:
-- gpr_pairs counts pairs from x19/x20 upward, and epilogues must mirror
-- the same count for the same function.
fn emit_prologue(code: i64, save_fp: i64, frame_size: i64, gpr_pairs: i64) -> i64 {
  if save_fp == 1 {
    bu32(code, encode_stp_d_pre(8, 9, 31, 0 - 16))
    bu32(code, encode_stp_d_pre(10, 11, 31, 0 - 16))
    bu32(code, encode_stp_d_pre(12, 13, 31, 0 - 16))
    bu32(code, encode_stp_d_pre(14, 15, 31, 0 - 16))
  } else { 0 }
  emit_prologue2(code, frame_size, gpr_pairs)
}
fn emit_prologue2(code: i64, frame_size: i64, gpr_pairs: i64) -> i64 {
  if gpr_pairs >= 1 { bu32(code, encode_stp_pre(19, 20, 31, 0 - 16)) } else { 0 }
  if gpr_pairs >= 2 { bu32(code, encode_stp_pre(21, 22, 31, 0 - 16)) } else { 0 }
  if gpr_pairs >= 3 { bu32(code, encode_stp_pre(23, 24, 31, 0 - 16)) } else { 0 }
  if gpr_pairs >= 4 { bu32(code, encode_stp_pre(25, 26, 31, 0 - 16)) } else { 0 }
  emit_prologue3(code, frame_size)
}
fn emit_prologue3(code: i64, frame_size: i64) -> i64 {
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  bu32(code, encode_add_imm(29, 31, 0))
  emit_stack_sub(code, frame_size)
}

fn emit_epilogue(code: i64, save_fp: i64, frame_size: i64, gpr_pairs: i64) -> i64 {
  emit_stack_add(code, frame_size)
  bu32(code, encode_ldp_post(29, 30, 31, 16))
  if gpr_pairs >= 4 { bu32(code, encode_ldp_post(25, 26, 31, 16)) } else { 0 }
  if gpr_pairs >= 3 { bu32(code, encode_ldp_post(23, 24, 31, 16)) } else { 0 }
  emit_epilogue2(code, save_fp, gpr_pairs)
}
fn emit_epilogue2(code: i64, save_fp: i64, gpr_pairs: i64) -> i64 {
  if gpr_pairs >= 2 { bu32(code, encode_ldp_post(21, 22, 31, 16)) } else { 0 }
  if gpr_pairs >= 1 { bu32(code, encode_ldp_post(19, 20, 31, 16)) } else { 0 }
  emit_epilogue3(code, save_fp)
}
fn emit_epilogue3(code: i64, save_fp: i64) -> i64 {
  if save_fp == 1 {
    bu32(code, encode_ldp_d_post(14, 15, 31, 16))
    bu32(code, encode_ldp_d_post(12, 13, 31, 16))
    bu32(code, encode_ldp_d_post(10, 11, 31, 16))
    bu32(code, encode_ldp_d_post(8, 9, 31, 16))
  } else { 0 }
  bu32(code, encode_ret())
}

fn emit_prologue_current(code: i64, fm: i64) -> i64 {
  -- A naked leaf touches no callee-saved register, no frame slot, and
  -- contains no BL, so it needs no save area, no fp/lr pair, and no
  -- stack adjustment at all.
  if fmap_current_naked_leaf(fm) == 1 { 0 }
  else { emit_prologue(code, fmap_current_preserve_fp(fm), fmap_current_frame_size(fm), fmap_current_gpr_pairs(fm)) }
}

fn emit_epilogue_current(code: i64, fm: i64) -> i64 {
  if fmap_current_naked_leaf(fm) == 1 { bu32(code, encode_ret()) }
  else { emit_epilogue(code, fmap_current_preserve_fp(fm), fmap_current_frame_size(fm), fmap_current_gpr_pairs(fm)) }
}

-- ======================================================================
-- Register allocation
-- ======================================================================

-- Canonical storage home used when a value has no allocator residency:
-- 0-7 -> x19-x26, 8+ -> spill slot encoded as -(slot+1).
fn cg_canonical_value_home(counter: i64) -> i64 {
  if counter < 8 { counter + 19 }
  else { 0 - (counter - 7) }
}

-- For backward compatibility
fn reg_phys(counter: i64) -> i64 {
  if counter < 8 { counter + 19 } else { 17 }
}

fn cg_f64_fp_reg_base() -> i64 { 1000 }
fn cg_f64_fp_regid(fd: i64) -> i64 { cg_f64_fp_reg_base() + fd }

fn emit_load_spill_offset(code: i64, dst: i64, byte_off: i64) -> i64 {
  if byte_off <= cg_spill_inline_offset_limit() {
    bu32(code, cg_ldr(dst, 31, byte_off))
  } else {
    emit_mov_imm_safe(code, dst, byte_off)
    bu32(code, encode_add_reg(dst, 31, dst))
    bu32(code, cg_ldr(dst, dst, 0))
  }
}

fn emit_store_spill_offset(code: i64, src: i64, byte_off: i64) -> i64 {
  if byte_off <= cg_spill_inline_offset_limit() {
    bu32(code, cg_str(src, 31, byte_off))
  } else {
    let addr = if src != 16 { 16 } else { 17 }
    emit_mov_imm_safe(code, addr, byte_off)
    bu32(code, encode_add_reg(addr, 31, addr))
    bu32(code, cg_str(src, addr, 0))
  }
}

fn emit_load_reg(code: i64, counter: i64) -> i64 {
  -- Returns the physical register containing the value
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    emit_load_spill_offset(code, 16, slot)
    16
  }
}

fn emit_load_home(code: i64, home: i64, temp: i64) -> i64 {
  if home < 0 {
    let slot = 0 - home - 1
    emit_load_spill_offset(code, temp, slot * 8)
    temp
  } else { home }
}

fn emit_load_rhs(code: i64, counter: i64) -> i64 {
  -- Same as emit_load_reg but uses x17 instead of x16
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    emit_load_spill_offset(code, 17, slot)
    17
  }
}

fn emit_store_reg(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter >= 8 {
    let slot = (counter - 8) * 8
    emit_store_spill_offset(code, phys_reg, slot)
  } else { 0 }
}

fn emit_store_counter_from_phys(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter < 8 {
    bu32(code, encode_add_imm(counter + 19, phys_reg, 0))
  } else {
    emit_store_reg(code, counter, phys_reg)
  }
}

fn cg_span_eq(a_src: i64, a_ns: i64, a_nl: i64, b_src: i64, b_ns: i64, b_nl: i64) -> bool {
  if a_nl != b_nl { false }
  else {
    let mut i = 0
    let mut ok = true
    while i < a_nl {
      if mem_load8_at(a_src + a_ns + i, 0) != mem_load8_at(b_src + b_ns + i, 0) {
        ok = false
        i = a_nl
      } else { i = i + 1 }
    }
    ok
  }
}

fn cg_ident_matches(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  if node == 0 { false }
  else { if node_tag(node) != 2 { false }
  else { cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) } }
}

fn cg_direct_branch_true_cond_for_op(op: i64) -> i64 {
  -- Condition code for the true edge of a comparison.
  -- ==5 !=6 <7 >8 <=9 >=10
  match op {
    5 -> 0
    6 -> 1
    7 -> 11
    8 -> 12
    9 -> 13
    10 -> 10
    _ -> 0 - 1
  }
}

fn cg_direct_branch_false_cond_for_op(op: i64) -> i64 {
  -- Condition code for the false edge of a comparison.
  -- ==5 !=6 <7 >8 <=9 >=10
  match op {
    5 -> 1
    6 -> 0
    7 -> 10
    8 -> 13
    9 -> 12
    10 -> 11
    _ -> 0 - 1
  }
}

fn cg_cmp_cond_for_op(op: i64, unsigned: i64) -> i64 {
  if unsigned == 1 {
    match op {
      5 -> 0
      6 -> 1
      7 -> 3
      8 -> 8
      9 -> 9
      10 -> 2
      _ -> 0 - 1
    }
  } else { cg_direct_branch_true_cond_for_op(op) }
}

fn cg_scope_uses_phys(scope: i64, phys: i64) -> i64 {
  let mut cur = scope
  let mut found = 0
  while cur != 0 {
    if mem_load64_at(cur + 16, 0) == phys {
      found = 1
      cur = 0
    } else {
      cur = mem_load64_at(cur + 24, 0)
    }
  }
  found
}

fn cg_scope_uses_f64_fp(scope: i64, fd: i64) -> i64 {
  let mut cur = scope
  let mut found = 0
  let rid = cg_f64_fp_regid(fd)
  while cur != 0 {
    if mem_load64_at(cur + 16, 0) == rid {
      found = 1
      cur = 0
    } else {
      cur = mem_load64_at(cur + 24, 0)
    }
  }
  found
}

fn cg_counter_phys_min() -> i64 { 19 }
fn cg_counter_phys_max() -> i64 { 26 }
fn cg_scratch_phys_min() -> i64 { cg_counter_phys_min() }
fn cg_scratch_phys_max() -> i64 { 20 }
fn cg_pinned_phys_min() -> i64 { cg_scratch_phys_max() + 1 }
fn cg_pinned_phys_max() -> i64 { cg_counter_phys_max() }
fn cg_fp_phys_min() -> i64 { 0 }
fn cg_fp_phys_max() -> i64 { 31 }
fn cg_fp_callee_saved_min() -> i64 { 8 }
fn cg_fp_callee_saved_max() -> i64 { 15 }
fn cg_preserved_f64_fp_min() -> i64 { cg_fp_callee_saved_min() }
fn cg_preserved_f64_fp_max() -> i64 { cg_fp_callee_saved_max() }
fn cg_loop_f64_fp_min() -> i64 { 16 }
fn cg_loop_f64_fp_max() -> i64 { 23 }

fn cg_counter_to_phys(ctr: i64) -> i64 {
  ctr + cg_counter_phys_min()
}

fn cg_phys_is_counter(phys: i64) -> i64 {
  if phys >= cg_counter_phys_min() and phys <= cg_counter_phys_max() { 1 } else { 0 }
}

fn cg_phys_is_scratch(phys: i64) -> i64 {
  if phys >= cg_scratch_phys_min() and phys <= cg_scratch_phys_max() { 1 } else { 0 }
}

fn cg_phys_is_pinned(phys: i64) -> i64 {
  if phys >= cg_pinned_phys_min() and phys <= cg_pinned_phys_max() { 1 } else { 0 }
}

fn cg_fp_phys_is_callee_saved(fd: i64) -> i64 {
  if fd >= cg_fp_callee_saved_min() and fd <= cg_fp_callee_saved_max() { 1 } else { 0 }
}

fn cg_fp_phys_is_call_clobbered(fd: i64) -> i64 {
  if fd < cg_fp_phys_min() or fd > cg_fp_phys_max() { 0 }
  else { if cg_fp_phys_is_callee_saved(fd) == 1 { 0 } else { 1 } }
}

fn cg_f64_loop_fp_phys_is_call_clobbered(fd: i64) -> i64 {
  if fd >= cg_loop_f64_fp_min() and fd <= cg_loop_f64_fp_max() {
    cg_fp_phys_is_call_clobbered(fd)
  } else { 0 }
}

fn cg_phys_to_counter(phys: i64) -> i64 {
  phys - cg_counter_phys_min()
}

fn cg_scope_first_free_phys_between(scope: i64, phys: i64, min_phys: i64) -> i64 {
  if phys < min_phys { 0 }
  else {
    if cg_scope_uses_phys(scope, phys) == 0 { phys }
    else { cg_scope_first_free_phys_between(scope, phys - 1, min_phys) }
  }
}

fn cg_scope_first_free_pinned_phys(scope: i64) -> i64 {
  cg_scope_first_free_phys_between(scope, cg_pinned_phys_max(), cg_pinned_phys_min())
}

fn cg_scope_first_free_loop_f64_fp(scope: i64) -> i64 {
  let mut fd = cg_loop_f64_fp_min()
  let mut found = 0
  while fd <= cg_loop_f64_fp_max() and found == 0 {
    if cg_scope_uses_f64_fp(scope, fd) == 0 { found = fd }
    else { fd = fd + 1 }
  }
  found
}

fn cg_scope_first_free_preserved_f64_fp(scope: i64) -> i64 {
  let mut fd = cg_preserved_f64_fp_min()
  let mut found = 0
  while fd <= cg_preserved_f64_fp_max() and found == 0 {
    if cg_scope_uses_f64_fp(scope, fd) == 0 { found = fd }
    else { fd = fd + 1 }
  }
  found
}

fn cg_vreg_reason_natural() -> i64 { 0 }
fn cg_vreg_reason_scope_collision() -> i64 { 1 }
fn cg_vreg_reason_spill_counter() -> i64 { 2 }
fn cg_vreg_reason_no_free() -> i64 { 3 }

fn cg_vreg_reservation_new(phys: i64, reason: i64, natural_phys: i64) -> i64 {
  let r = cg_alloc_bytes(24)
  mem_store64_at(r, 0, phys)
  mem_store64_at(r + 8, 0, reason)
  mem_store64_at(r + 16, 0, natural_phys)
  r
}

fn cg_vreg_reservation_phys(r: i64) -> i64 { mem_load64_at(r, 0) }
fn cg_vreg_reservation_reason(r: i64) -> i64 { mem_load64_at(r + 8, 0) }
fn cg_vreg_reservation_natural_phys(r: i64) -> i64 { mem_load64_at(r + 16, 0) }

fn cg_vreg_record_reservation(fm: i64, reason: i64) -> i64 {
  match reason {
    1 -> { fmap_inc_register_pinned_count(fm) fmap_inc_register_scope_collision_count(fm) }
    2 -> { fmap_inc_register_pinned_count(fm) fmap_inc_register_spill_counter_count(fm) }
    3 -> fmap_inc_register_no_free_count(fm)
    _ -> 0
  }
}

fn cg_vreg_reserve_counter(scope: i64, ctr: i64, fm: i64) -> i64 {
  if ctr < 8 {
    let natural_phys = cg_counter_to_phys(ctr)
    if cg_scope_uses_phys(scope, natural_phys) == 0 { cg_vreg_reservation_new(natural_phys, cg_vreg_reason_natural(), natural_phys) }
    else {
      let pinned = cg_scope_first_free_pinned_phys(scope)
      let reason = if pinned == 0 { cg_vreg_reason_no_free() } else { cg_vreg_reason_scope_collision() }
      cg_vreg_record_reservation(fm, reason)
      cg_vreg_reservation_new(pinned, reason, natural_phys)
    }
  } else {
    let pinned = cg_scope_first_free_pinned_phys(scope)
    let reason = if pinned == 0 { cg_vreg_reason_no_free() } else { cg_vreg_reason_spill_counter() }
    cg_vreg_record_reservation(fm, reason)
    cg_vreg_reservation_new(pinned, reason, 0)
  }
}

fn cg_counter_after_scope(scope: i64, ctr: i64) -> i64 {
  -- Nested expression codegen must not allocate any counter that maps to a live scope register.
  if ctr >= 8 { ctr }
  else {
    let mut cur = scope
    let mut next = ctr
    while cur != 0 {
      let rid = mem_load64_at(cur + 16, 0)
      if cg_phys_is_counter(rid) == 1 {
        let used_ctr = cg_phys_to_counter(rid)
        if used_ctr >= next { next = used_ctr + 1 } else { 0 }
      } else { 0 }
      cur = mem_load64_at(cur + 24, 0)
    }
    next
  }
}

fn cg_counter_width_unknown() -> i64 { 9 }

fn cg_counter_width_cap(width: i64) -> i64 {
  if width > 8 { cg_counter_width_unknown() } else { width }
}

fn cg_counter_width_max(a: i64, b: i64) -> i64 {
  if a >= cg_counter_width_unknown() or b >= cg_counter_width_unknown() { cg_counter_width_unknown() }
  else { if a > b { a } else { b } }
}

fn cg_counter_width_binop(lhs_width: i64, rhs_width: i64) -> i64 {
  if lhs_width >= cg_counter_width_unknown() or rhs_width >= cg_counter_width_unknown() { cg_counter_width_unknown() }
  else {
    let rhs_live_width = rhs_width + 1
    cg_counter_width_cap(if lhs_width > rhs_live_width { lhs_width } else { rhs_live_width })
  }
}

fn cg_expr_counter_width(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { cg_counter_width_unknown() }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      3 -> {
        if node_f1(node) == 12 or node_f1(node) == 13 { cg_counter_width_unknown() }
        else { if cg_binop_float_kind(node, scope, src, fm) != 0 { cg_counter_width_unknown() }
        else { cg_counter_width_binop(cg_expr_counter_width(node_f2(node), scope, src, fm), cg_expr_counter_width(node_f3(node), scope, src, fm)) } }
      }
      5 -> {
        let cond_width = cg_expr_counter_width(node_f1(node), scope, src, fm)
        let then_width = cg_expr_counter_width(node_f2(node), scope, src, fm)
        let else_width = cg_expr_counter_width(node_f3(node), scope, src, fm)
        cg_counter_width_max(cond_width, cg_counter_width_max(then_width, else_width))
      }
      7 -> cg_counter_width_max(cg_expr_counter_width(node_f1(node), scope, src, fm), cg_expr_counter_width(node_f2(node), scope, src, fm))
      12 -> cg_expr_counter_width(node_f3(node), scope, src, fm)
      22 -> cg_expr_counter_width(node_f1(node), scope, src, fm)
      24 -> 1
      37 -> cg_expr_counter_width(node_f1(node), scope, src, fm)
      51 -> 1
      54 -> 1
      55 -> cg_expr_counter_width(node_f2(node), scope, src, fm)
      56 -> cg_expr_counter_width(node_f1(node), scope, src, fm)
      57 -> cg_counter_width_binop(cg_expr_counter_width(node_f1(node), scope, src, fm), cg_expr_counter_width(node_f2(node), scope, src, fm))
      _ -> cg_counter_width_unknown()
    }
  }
}

fn cg_counter_window_free_with_hidden(scope: i64, ctr: i64, width: i64, hidden_mask: i64) -> i64 {
  if ctr < 0 or ctr >= 8 or width <= 0 or ctr + width > 8 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < width and ok == 1 {
      if cg_mask_has(hidden_mask, ctr + i) == 1 {
        ok = 0
      } else {
        if cg_scope_uses_phys(scope, cg_counter_to_phys(ctr + i)) == 1 {
          ok = 0
        } else { i = i + 1 }
      }
    }
    ok
  }
}

fn cg_counter_after_scope_window_from(scope: i64, start_ctr: i64, fallback: i64, width: i64, fm: i64) -> i64 {
  cg_counter_after_scope_window_from_hidden(scope, start_ctr, fallback, width, 0, fm)
}

fn cg_counter_after_scope_window_from_hidden(scope: i64, start_ctr: i64, fallback: i64, width: i64, hidden_mask: i64, fm: i64) -> i64 {
  if start_ctr >= 8 or width <= 0 or width >= cg_counter_width_unknown() or width > 8 { fallback }
  else {
    let mut start = start_ctr
    let limit = 8 - width
    let mut found = 0 - 1
    while start <= limit and found < 0 {
      if cg_counter_window_free_with_hidden(scope, start, width, hidden_mask) == 1 {
        found = start
      } else { start = start + 1 }
    }
    if found >= 0 {
      if found < fallback and fm != 0 { fmap_inc_register_window_reuse_count(fm) } else { 0 }
      found
    } else { fallback }
  }
}

fn cg_counter_after_scope_window(scope: i64, ctr: i64, width: i64, fm: i64) -> i64 {
  let fallback = cg_counter_after_scope(scope, ctr)
  cg_counter_after_scope_window_from(scope, ctr, fallback, width, fm)
}

fn cg_counter_after_scope_boundary_window(scope: i64, ctr: i64, width: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window_hidden(scope, ctr, width, 0, fm)
}

fn cg_counter_after_scope_boundary_window_hidden(scope: i64, ctr: i64, width: i64, hidden_mask: i64, fm: i64) -> i64 {
  let fallback = cg_counter_after_scope(scope, ctr)
  let start_ctr = if ctr >= 8 { 0 } else { ctr }
  cg_counter_after_scope_window_from_hidden(scope, start_ctr, fallback, width, hidden_mask, fm)
}

fn cg_counter_for_expr(scope: i64, ctr: i64, expr: i64, src: i64, fm: i64) -> i64 {
  cg_counter_after_scope_window(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), fm)
}

fn cg_counter_for_expr_boundary(scope: i64, ctr: i64, expr: i64, src: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), fm)
}

fn cg_counter_for_expr_boundary_hidden(scope: i64, ctr: i64, expr: i64, src: i64, hidden_mask: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window_hidden(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), hidden_mask, fm)
}

fn cg_emit_call_lit(code: i64, fm: i64, name: str) -> i64 {
  cg_reuse_token_clear(fm)
  let sp = __str_ptr(name)
  let sl = __str_len(name)
  let cur = buf_len(code)
  let name_hash = str_hash(sp, 0, sl)
  let typed_target = mono_cache_lookup(fmap_mono_cache(fm), name_hash)
  if typed_target > 1 {
    bu32(code, encode_bl(typed_target - cur))
  } else { if typed_target == 1 {
    fmap_add_patch(fm, cur, 0, name_hash, 0)
    bu32(code, encode_bl(0))
  } else { if fmap_contains(fm, sp, 0, sl) == 0 {
    eprint("error: required runtime function unavailable: ")
    sys_write(2, sp, sl)
    eprint("\n")
    fmap_inc_emit_error_count(fm)
    bu32(code, encode_brk(3))
  } else {
    let target = fmap_lookup(fm, sp, 0, sl)
    if target == 0 {
      fmap_add_patch(fm, cur, sp, 0, sl)
      bu32(code, encode_bl(0))
    } else {
      bu32(code, encode_bl(target - cur))
    }
  } } }
}

-- Nozero variants: allocations whose emission stores EVERY payload word
-- before the value becomes observable. Closure pairs write [thunk, env]
-- at 0/8 on every branch; lambda/continuation envs write the capture
-- count at 0, both words (value + kind flag) of each 16-byte capture
-- entry, and the evidence slot exactly when env_size reserved one. The
-- mask stays 0 by design — env captures are dropped through the kind
-- flags by closure_env_release_captures_raw, never through the
-- deep-release field mask — so routing through the masked entry with
-- mask 0 buys the zero-fill skip AND the fused bin fast path without
-- changing what the walker sees (2r).
fn cg_emit_rc_default_alloc_nozero_raw(code: i64, fm: i64, payload_size: i64, align: i64) -> i64 {
  emit_mov_imm(code, 0, payload_size)
  emit_mov_imm(code, 1, align)
  emit_mov_imm(code, 2, 0)
  cg_emit_call_lit(code, fm, "rc_default_alloc_masked")
}

fn cg_emit_rc_default_alloc_nozero_lit(code: i64, fm: i64, kind: i64, payload_size: i64, align: i64) -> i64 {
  if align == 8 {
    cg_record_managed_reuse_allocation(fm, kind, payload_size)
  } else { cg_reuse_token_clear(fm) }
  cg_emit_rc_default_alloc_nozero_raw(code, fm, payload_size, align)
}

-- Masked variant: the compile-time field mask (2 bits per payload
-- word — none/rc/closure/weak) lands in the header's size-word high
-- bits so deep release knows which fields to drop (2q slice 2).
--
-- Nozero at EVERY mask, including 0. The zero-fill skip never depended
-- on the mask — it rests on ctor emission storing the tag and every
-- payload word — but mask 0 used to divert to the zeroing entry, which
-- left all-unmanaged aggregates (the bulk of compiler IR nodes) paying
-- a mem_fill8 they did not need and missing the fused bin fast path.
-- Callers cover their own size rounding: a payload-less variant and a
-- field-less record each initialise the slack word that no payload
-- store reaches (2r).
fn cg_emit_rc_default_alloc_masked_lit(code: i64, fm: i64, kind: i64, payload_size: i64, align: i64, mask: i64) -> i64 {
  if align == 8 {
    cg_record_managed_reuse_allocation(fm, kind, payload_size)
  } else { cg_reuse_token_clear(fm) }
  emit_mov_imm(code, 0, payload_size)
  emit_mov_imm(code, 1, align)
  emit_mov_imm_safe(code, 2, mask)
  cg_emit_call_lit(code, fm, "rc_default_alloc_masked")
}

-- 2-bit deep-release kind for a payload word of type ty.
fn cg_field_mask_kind(ty: i64) -> i64 {
  ty_field_release_mask_kind(ty)
}

fn cg_emit_rc_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_retain")
}

fn cg_emit_rc_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    emit_load_spill_offset(code, 16, slot * 8)
    16
  } else { rid }
  cg_emit_rc_retain_phys(code, fm, phys)
}

fn cg_emit_weak_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_weak_retain")
}

fn cg_emit_weak_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    emit_load_spill_offset(code, 16, slot * 8)
    16
  } else { rid }
  cg_emit_weak_retain_phys(code, fm, phys)
}

fn cg_ty_is_nil(ty: i64) -> i64 {
  if ty == 0 { 0 } else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_NIL() }
}

fn cg_emit_closure_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "closure_default_retain")
}

fn cg_emit_closure_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    emit_load_spill_offset(code, 16, slot * 8)
    16
  } else { rid }
  cg_emit_closure_retain_phys(code, fm, phys)
}

fn cg_ty_is_managed(ty: i64) -> i64 {
  cg_managed_drop_kind_for_ty(ty) != continuation_cleanup_kind_none()
}

fn cg_managed_drop_kind_for_ty(ty: i64) -> i64 {
  match ty_field_release_mask_kind(ty) {
    1 -> continuation_cleanup_kind_rc()
    2 -> continuation_cleanup_kind_closure()
    3 -> continuation_cleanup_kind_weak()
    _ -> continuation_cleanup_kind_none()
  }
}

fn cg_managed_reuse_static_release_size_for_ty(ty: i64) -> i64 {
  if cg_managed_drop_kind_for_ty(ty) == continuation_cleanup_kind_closure() { 16 } else { 0 }
}

fn cg_reuse_token_clear(fm: i64) -> i64 {
  fmap_set_reuse_token_kind(fm, continuation_cleanup_kind_none())
  fmap_set_reuse_token_size(fm, 0)
}

fn cg_inc_managed_reuse_candidate(fm: i64, kind: i64) -> i64 {
  fmap_inc_managed_reuse_candidate_count(fm)
  match kind {
    1 -> fmap_inc_rc_reuse_candidate_count(fm)
    2 -> fmap_inc_closure_reuse_candidate_count(fm)
    _ -> 0
  }
}

fn cg_record_managed_reuse_allocation(fm: i64, kind: i64, payload_size: i64) -> i64 {
  if payload_size > 0 and kind == fmap_reuse_token_kind(fm) and payload_size == fmap_reuse_token_size(fm) {
    cg_inc_managed_reuse_candidate(fm, kind)
  } else { 0 }
  cg_reuse_token_clear(fm)
}

fn cg_ty_is_f64(ty: i64) -> bool {
  if ty == 0 { false }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F64() }
}

fn cg_ty_is_f32(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F32() }
}

fn cg_prim_is_integer(prim: i64) -> i64 {
  prim == PRIM_I64() or prim == PRIM_I32() or prim == PRIM_I8() or prim == PRIM_I16() or prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_ISIZE() or prim == PRIM_USIZE()
}

fn cg_prim_is_unsigned_integer(prim: i64) -> i64 {
  prim == PRIM_U8() or prim == PRIM_U16() or prim == PRIM_U32() or prim == PRIM_U64() or prim == PRIM_USIZE()
}

fn cg_type_int_prim(ty: i64) -> i64 {
  if ty == 0 { 0 - 1 }
  else { if ty_tag(ty) != 2 { 0 - 1 }
  else {
    let prim = ty_f1(ty)
    if cg_prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  } }
}

fn cg_int_prim_positive_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 127 }
  else { if prim == PRIM_I16() { 32767 }
  else { if prim == PRIM_I32() { 2147483647 }
  else { if prim == PRIM_U8() { 255 }
  else { if prim == PRIM_U16() { 65535 }
  else { if prim == PRIM_U32() { 4294967295 }
  else { if prim == PRIM_U64() { 9223372036854775807 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { if prim == PRIM_USIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } } } } } } }
}

fn cg_int_prim_positive_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "127" }
  else { if prim == PRIM_I16() { "32767" }
  else { if prim == PRIM_I32() { "2147483647" }
  else { if prim == PRIM_U8() { "255" }
  else { if prim == PRIM_U16() { "65535" }
  else { if prim == PRIM_U32() { "4294967295" }
  else { if prim == PRIM_U64() { "18446744073709551615" }
  else { if prim == PRIM_ISIZE() { "9223372036854775807" }
  else { if prim == PRIM_USIZE() { "18446744073709551615" }
  else { "9223372036854775807" } } } } } } } } }
}

fn cg_int_prim_negative_magnitude_max(prim: i64) -> i64 {
  if prim == PRIM_I8() { 128 }
  else { if prim == PRIM_I16() { 32768 }
  else { if prim == PRIM_I32() { 2147483648 }
  else { if prim == PRIM_ISIZE() { 9223372036854775807 }
  else { 9223372036854775807 } } } }
}

fn cg_int_prim_negative_magnitude_max_str(prim: i64) -> str {
  if prim == PRIM_I8() { "128" }
  else { if prim == PRIM_I16() { "32768" }
  else { if prim == PRIM_I32() { "2147483648" }
  else { if prim == PRIM_ISIZE() { "9223372036854775808" }
  else { "9223372036854775808" } } } }
}

fn cg_int_literal_has_span(node: i64) -> i64 {
  node != 0 and node_f3(node) > 0
}

fn cg_int_literal_positive_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if cg_int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), cg_int_prim_positive_max_str(prim))
  } else {
    let value = node_f1(node)
    if value >= 0 and value <= cg_int_prim_positive_max(prim) { 1 } else { 0 }
  }
}

fn cg_int_literal_negative_magnitude_fits_prim(node: i64, prim: i64, src: i64) -> i64 {
  if cg_prim_is_unsigned_integer(prim) == 1 { 0 }
  else { if cg_int_literal_has_span(node) == 1 {
    decimal_span_le_str(src, node_f2(node), node_f3(node), cg_int_prim_negative_magnitude_max_str(prim))
  } else {
    let mag = node_f1(node)
    if mag >= 0 and mag <= cg_int_prim_negative_magnitude_max(prim) { 1 } else { 0 }
  } }
}

fn cg_expr_is_contextual_int_lit_for_prim(node: i64, prim: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 {
      cg_int_literal_positive_fits_prim(node, prim, src)
    } else { if tag == 3 and node_f1(node) == 2 and node_tag(node_f2(node)) == 1 and node_f1(node_f2(node)) == 0 and node_tag(node_f3(node)) == 1 {
      cg_int_literal_negative_magnitude_fits_prim(node_f3(node), prim, src)
    } else { 0 } }
  }
}

fn cg_expr_is_contextual_int_lit_shape(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 1 { 1 }
    else { if tag == 3 and node_f1(node) == 2 and node_tag(node_f2(node)) == 1 and node_f1(node_f2(node)) == 0 and node_tag(node_f3(node)) == 1 { 1 }
    else { 0 } }
  }
}

fn cg_expr_matches_int_prim(node: i64, ty: i64, prim: i64, src: i64) -> i64 {
  if cg_expr_is_contextual_int_lit_shape(node) == 1 { cg_expr_is_contextual_int_lit_for_prim(node, prim, src) }
  else { if cg_type_int_prim(ty) == prim { 1 }
  else { cg_expr_is_contextual_int_lit_for_prim(node, prim, src) }
  }
}

fn cg_expr_is_zero_i64_literal(node: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 1 { if node_f1(node) == 0 { 1 } else { 0 } } else { 0 } }
}

fn cg_expr_is_contextual_f32_literal_tree(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      54 -> 1
      3 -> {
        let op = node_f1(node)
        if op >= 1 and op <= 4 {
          if op == 2 and cg_expr_is_zero_i64_literal(node_f2(node)) == 1 {
            cg_expr_is_contextual_f32_literal_tree(node_f3(node))
          } else {
            cg_expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and cg_expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
          }
        } else { 0 }
      }
      5 -> cg_expr_is_contextual_f32_literal_tree(node_f2(node)) == 1 and cg_expr_is_contextual_f32_literal_tree(node_f3(node)) == 1
      7 -> cg_expr_is_contextual_f32_literal_tree(node_f2(node))
      _ -> 0
    }
  }
}

fn cg_expr_matches_f32_contextual(node: i64, ty: i64) -> i64 {
  if cg_ty_is_f32(ty) == 1 { 1 }
  else { cg_expr_is_contextual_f32_literal_tree(node) }
}

fn cg_ty_for_int_prim(prim: i64) -> i64 {
  if prim == PRIM_I8() { ty_i8() }
  else { if prim == PRIM_I16() { ty_i16() }
  else { if prim == PRIM_I32() { ty_i32() }
  else { if prim == PRIM_U8() { ty_u8() }
  else { if prim == PRIM_U16() { ty_u16() }
  else { if prim == PRIM_U32() { ty_u32() }
  else { if prim == PRIM_U64() { ty_u64() }
  else { if prim == PRIM_ISIZE() { ty_isize() }
  else { if prim == PRIM_USIZE() { ty_usize() }
  else { ty_i64() } } } } } } } } }
}

fn cg_int_binop_candidate_prim(lhs_ty: i64, rhs_ty: i64) -> i64 {
  let lhs_prim = cg_type_int_prim(lhs_ty)
  let rhs_prim = cg_type_int_prim(rhs_ty)
  if lhs_prim >= 0 and lhs_prim != PRIM_I64() { lhs_prim }
  else { if rhs_prim >= 0 and rhs_prim != PRIM_I64() { rhs_prim }
  else { PRIM_I64() } }
}

fn cg_binop_int_result_prim(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = cg_expr_type(lhs, scope, src, fm)
  let rhs_ty = cg_expr_type(rhs, scope, src, fm)
  let prim = cg_int_binop_candidate_prim(lhs_ty, rhs_ty)
  if cg_expr_matches_int_prim(lhs, lhs_ty, prim, src) == 1 and cg_expr_matches_int_prim(rhs, rhs_ty, prim, src) == 1 { prim } else { PRIM_I64() }
}

fn cg_build_subst(tparams: i64, type_args: i64) -> i64 {
  let s = subst_new()
  if tparams == 0 { s }
  else {
    let n = nlist_len(tparams)
    let nargs = if type_args == 0 { 0 } else { nlist_len(type_args) }
    for i in 0..n {
      if i < nargs {
        let tp = nlist_get(tparams, i)
        subst_add(s, node_f3(tp), nlist_get(type_args, i))
      } else { 0 }
    }
    s
  }
}

fn cg_params_subst(params: i64, s: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let result = nlist_new()
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      let ty = node_f3(p)
      let subst_ty = if ty == 0 { 0 } else { ty_subst(ty, s) }
      nlist_add(result, node_new(node_tag(p), node_f1(p), node_f2(p), subst_ty, node_f4(p)))
    }
    result
  }
}

fn cg_generic_subst_ret(tmpl_wrap: i64, type_args: i64) -> i64 {
  let ret_ty = fn_ret_type(tmpl_wrap)
  let s = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
  if ret_ty == 0 { 0 } else { ty_subst(ret_ty, s) }
}

fn cg_generic_call_expr_type(node: i64, fm: i64, src: i64) -> i64 {
  if cg_generic_call_name_is(node, src, "vector_get") == 1 {
    let call_node = node_f2(node)
    if node_f4(call_node) == 3 and nlist_len(node_f1(node)) == 1 {
      let type_args = cg_type_args_in_current_context(fm, node_f1(node))
      if type_args == 0 { 0 } else { nlist_get(type_args, 0) }
    } else { 0 }
  } else { if cg_generic_call_name_is(node, src, "vector_set") == 1 { ty_i64() }
  else { if cg_generic_call_name_is(node, src, "vector_push") == 1 { ty_i64() }
  else { 0 } } }
}

fn cg_generic_call_declared_ret_type(node: i64, fm: i64, src: i64) -> i64 {
  if node == 0 or node_tag(node) != 36 { 0 }
  else {
    let call_node = node_f2(node)
    if call_node != 0 and node_tag(call_node) == 4 {
      let type_args = cg_type_args_in_current_context(fm, node_f1(node))
      let name_hash = str_hash(src, node_f1(call_node), node_f2(call_node))
      let tmpl_entry = mono_tmap_lookup(mem_load64_at(fm + 80, 0), name_hash)
      if tmpl_entry == 0 {
        cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(call_node), node_f2(call_node))
      } else {
        cg_generic_subst_ret(mem_load64_at(tmpl_entry + 8, 0), type_args)
      }
    } else { 0 }
  }
}

fn cg_field_access_base_type(base: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let special = if base != 0 and node_tag(base) == 36 {
    let vector_ty = cg_generic_call_expr_type(base, fm, src)
    if vector_ty != 0 { vector_ty } else { cg_generic_call_declared_ret_type(base, fm, src) }
  } else { 0 }
  if special != 0 { special } else { cg_expr_type(base, scope, src, fm) }
}

fn cg_merge_expr_type(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { if ty_eq(a, b) { a } else { ty_union(a, b) } } }
}

fn cg_match_body_type(arms: i64, n: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < n {
    let arm = nlist_get(arms, i)
    result = cg_merge_expr_type(result, cg_expr_type(node_f2(arm), scope, src, fm))
    i = i + 1
  }
  result
}

fn cg_lambda_param_ty(param: i64) -> i64 {
  let ann_ty = node_f3(param)
  if ann_ty != 0 { ann_ty } else { ty_i64() }
}

fn cg_lambda_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  let param_tys = nlist_new()
  let mut body_scope = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = cg_lambda_param_ty(p)
    nlist_add(param_tys, param_ty)
    body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), 0, param_ty)
  }
  ty_fn(param_tys, cg_expr_type(body, body_scope, src, fm), ty_effect_pure())
}

fn cg_binop_expr_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let lhs_ty = cg_expr_type(lhs, scope, src, fm)
  let rhs_ty = cg_expr_type(rhs, scope, src, fm)
  let float_kind = cg_binop_float_kind_from_types(lhs, rhs, lhs_ty, rhs_ty)
  match op {
    1 -> {
      if float_kind == 1 { ty_f32() }
      else { if cg_ty_is_f64(lhs_ty) or cg_ty_is_f64(rhs_ty) { ty_f64() }
      else { cg_ty_for_int_prim(cg_binop_int_result_prim(node, scope, src, fm)) }
      }
    }
    2 -> {
      if float_kind == 1 { ty_f32() }
      else { if cg_ty_is_f64(lhs_ty) or cg_ty_is_f64(rhs_ty) { ty_f64() }
      else { cg_ty_for_int_prim(cg_binop_int_result_prim(node, scope, src, fm)) }
      }
    }
    3 -> {
      if float_kind == 1 { ty_f32() }
      else { if cg_ty_is_f64(lhs_ty) or cg_ty_is_f64(rhs_ty) { ty_f64() }
      else { cg_ty_for_int_prim(cg_binop_int_result_prim(node, scope, src, fm)) }
      }
    }
    4 -> {
      if float_kind == 1 { ty_f32() }
      else { if cg_ty_is_f64(lhs_ty) or cg_ty_is_f64(rhs_ty) { ty_f64() }
      else { cg_ty_for_int_prim(cg_binop_int_result_prim(node, scope, src, fm)) }
      }
    }
    5 -> ty_bool()
    6 -> ty_bool()
    7 -> ty_bool()
    8 -> ty_bool()
    9 -> ty_bool()
    10 -> ty_bool()
    12 -> ty_bool()
    13 -> ty_bool()
    _ -> cg_ty_for_int_prim(cg_binop_int_result_prim(node, scope, src, fm))
  }
}

fn cg_binop_float_kind_from_types(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64) -> i64 {
  if cg_binop_types_use_f32(lhs, rhs, lhs_ty, rhs_ty) == 1 { 1 }
  else { if cg_ty_is_f64(lhs_ty) == 1 or cg_ty_is_f64(rhs_ty) == 1 { 2 } else { 0 } }
}

fn cg_binop_float_kind(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  if op >= 1 and op <= 10 {
    let lhs = node_f2(node)
    let rhs = node_f3(node)
    let lhs_ty = cg_expr_type(lhs, scope, src, fm)
    let rhs_ty = cg_expr_type(rhs, scope, src, fm)
    cg_binop_float_kind_from_types(lhs, rhs, lhs_ty, rhs_ty)
  } else { 0 }
}

fn cg_binop_types_use_f32(lhs: i64, rhs: i64, lhs_ty: i64, rhs_ty: i64) -> i64 {
  let has_f32 = cg_ty_is_f32(lhs_ty) == 1 or cg_ty_is_f32(rhs_ty) == 1
  has_f32 == 1 and cg_expr_matches_f32_contextual(lhs, lhs_ty) == 1 and cg_expr_matches_f32_contextual(rhs, rhs_ty) == 1
}

fn cg_intrinsic_signed_int_to_f64_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "__i8_to_f64") == 1 or
    src_eq(src, ns, nl, "__i16_to_f64") == 1 or
    src_eq(src, ns, nl, "__i32_to_f64") == 1 or
    src_eq(src, ns, nl, "__i64_to_f64") == 1 or
    src_eq(src, ns, nl, "__isize_to_f64") == 1
}

fn cg_intrinsic_unsigned_int_to_f64_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "__u8_to_f64") == 1 or
    src_eq(src, ns, nl, "__u16_to_f64") == 1 or
    src_eq(src, ns, nl, "__u32_to_f64") == 1 or
    src_eq(src, ns, nl, "__u64_to_f64") == 1 or
    src_eq(src, ns, nl, "__usize_to_f64") == 1
}

fn cg_intrinsic_signed_int_to_f32_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "__i8_to_f32") == 1 or
    src_eq(src, ns, nl, "__i16_to_f32") == 1 or
    src_eq(src, ns, nl, "__i32_to_f32") == 1 or
    src_eq(src, ns, nl, "__i64_to_f32") == 1 or
    src_eq(src, ns, nl, "__isize_to_f32") == 1
}

fn cg_intrinsic_unsigned_int_to_f32_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "__u8_to_f32") == 1 or
    src_eq(src, ns, nl, "__u16_to_f32") == 1 or
    src_eq(src, ns, nl, "__u32_to_f32") == 1 or
    src_eq(src, ns, nl, "__u64_to_f32") == 1 or
    src_eq(src, ns, nl, "__usize_to_f32") == 1
}

fn cg_intrinsic_int_cast_target_prim(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i8_to_i64") == 1 or src_eq(src, ns, nl, "__i16_to_i64") == 1 or src_eq(src, ns, nl, "__i32_to_i64") == 1 or src_eq(src, ns, nl, "__isize_to_i64") == 1 { PRIM_I64() }
  else { if src_eq(src, ns, nl, "__u8_to_u64") == 1 or src_eq(src, ns, nl, "__u16_to_u64") == 1 or src_eq(src, ns, nl, "__u32_to_u64") == 1 or src_eq(src, ns, nl, "__usize_to_u64") == 1 { PRIM_U64() }
  else { if src_eq(src, ns, nl, "__i64_to_i8") == 1 or src_eq(src, ns, nl, "__u64_to_i8") == 1 { PRIM_I8() }
  else { if src_eq(src, ns, nl, "__i64_to_i16") == 1 or src_eq(src, ns, nl, "__u64_to_i16") == 1 { PRIM_I16() }
  else { if src_eq(src, ns, nl, "__i64_to_i32") == 1 or src_eq(src, ns, nl, "__u64_to_i32") == 1 { PRIM_I32() }
  else { if src_eq(src, ns, nl, "__i64_to_isize") == 1 or src_eq(src, ns, nl, "__u64_to_isize") == 1 { PRIM_ISIZE() }
  else { if src_eq(src, ns, nl, "__i64_to_u8") == 1 or src_eq(src, ns, nl, "__u64_to_u8") == 1 { PRIM_U8() }
  else { if src_eq(src, ns, nl, "__i64_to_u16") == 1 or src_eq(src, ns, nl, "__u64_to_u16") == 1 { PRIM_U16() }
  else { if src_eq(src, ns, nl, "__i64_to_u32") == 1 or src_eq(src, ns, nl, "__u64_to_u32") == 1 { PRIM_U32() }
  else { if src_eq(src, ns, nl, "__i64_to_u64") == 1 { PRIM_U64() }
  else { if src_eq(src, ns, nl, "__i64_to_usize") == 1 or src_eq(src, ns, nl, "__u64_to_usize") == 1 { PRIM_USIZE() }
  else { if src_eq(src, ns, nl, "__u64_to_i64") == 1 { PRIM_I64() }
  else { 0 - 1 } } } } } } } } } } } }
}

fn cg_intrinsic_type(src: i64, ns: i64, nl: i64) -> i64 {
  let int_cast_prim = cg_intrinsic_int_cast_target_prim(src, ns, nl)
  if int_cast_prim >= 0 { cg_ty_for_int_prim(int_cast_prim) }
  else { if cg_intrinsic_signed_int_to_f64_name(src, ns, nl) == 1 or cg_intrinsic_unsigned_int_to_f64_name(src, ns, nl) == 1 { ty_f64() }
  else { if cg_intrinsic_signed_int_to_f32_name(src, ns, nl) == 1 or cg_intrinsic_unsigned_int_to_f32_name(src, ns, nl) == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_to_i64_trunc") == 1 { ty_i64() }
  else { if src_eq(src, ns, nl, "__f32_to_f64") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f64_to_f32") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__f64_sqrt") == 1 { ty_f64() }
  else { if src_eq(src, ns, nl, "__f32_sqrt") == 1 { ty_f32() }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { ty_any() }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { ty_any() }
  else { ty_i64() }
  } } } } } } } } } }
}

fn cg_resolved_method_call_type(node: i64, fm: i64) -> i64 {
  let method_ret = ttable_lookup_method_ret(fmap_get_tt(fm), node_f4(node), node_f2(node))
  if method_ret != 0 { method_ret } else { ty_i64() }
}

fn cg_weak_ref_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_ref")
}

fn cg_weak_load_name(src: i64, ns: i64, nl: i64) -> i64 {
  src_eq(src, ns, nl, "weak_load")
}

fn cg_weak_ref_call_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node_f4(node) == 1 {
    ty_weak(cg_expr_type(nlist_get(node_f3(node), 0), scope, src, fm))
  } else { ty_i64() }
}

fn cg_weak_load_call_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node_f4(node) == 1 {
    let weak_ty = cg_expr_type(nlist_get(node_f3(node), 0), scope, src, fm)
    if ty_is_weak(weak_ty) == 1 { ty_nullable(ty_weak_inner(weak_ty)) } else { ty_i64() }
  } else { ty_i64() }
}

fn cg_expr_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> ty_i64()
      2 -> {
        let ty = scope_lookup_type(scope, src, node_f1(node), node_f2(node))
        if ty != 0 { ty }
        else {
          let fn_ty = cg_ftypes_lookup_fn_type(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node))
          if fn_ty != 0 { fn_ty } else { cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node)) }
        }
      }
      3 -> cg_binop_expr_type(node, scope, src, fm)
      4 -> {
        let local_ty = scope_lookup_type(scope, src, node_f1(node), node_f2(node))
        if local_ty != 0 {
          if ty_tag(local_ty) == 6 { ty_f2(local_ty) }
          else { if ty_tag(local_ty) == 14 { ty_f2(local_ty) }
          else { cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node)) } }
        } else {
          if cg_weak_ref_name(src, node_f1(node), node_f2(node)) == 1 { cg_weak_ref_call_type(node, scope, src, fm) }
          else { if cg_weak_load_name(src, node_f1(node), node_f2(node)) == 1 { cg_weak_load_call_type(node, scope, src, fm) }
          else { if is_intrinsic(src, node_f1(node), node_f2(node)) == 1 { cg_intrinsic_type(src, node_f1(node), node_f2(node)) }
          else { cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node)) }
          } }
        }
      }
      5 -> cg_merge_expr_type(cg_expr_type(node_f2(node), scope, src, fm), cg_expr_type(node_f3(node), scope, src, fm))
      6 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
        cg_expr_type(node_f4(node), new_scope, src, fm)
      }
      7 -> cg_expr_type(node_f2(node), scope, src, fm)
      9 -> ty_str()
      11 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
        cg_expr_type(node_f4(node), new_scope, src, fm)
      }
      13 -> {
        let base_ty = cg_field_access_base_type(node_f1(node), scope, src, fm)
        let tt = fmap_get_tt(fm)
        let idx = if node_f4(node) > 0 { node_f4(node) - 1 }
        else { if base_ty != 0 and ty_tag(base_ty) == 9 {
          ttable_find_field_by_type_hash(tt, ty_f1(base_ty), src, node_f2(node), node_f3(node))
        } else { 0 - 1 } }
        let entry = cg_layout_record_entry(tt, base_ty)
        let fty = cg_layout_field_type_at(entry, base_ty, idx)
        if fty != 0 { fty } else { ty_i64() }
      }
      14 -> ty_named(type_name_hash(src, node_f1(node), node_f2(node)), ty_i64())
      15 -> cg_match_body_type(node_f2(node), node_f3(node), scope, src, fm)
      24 -> ty_bool()
      25 -> cg_expr_type(node_f1(node), scope, src, fm)
      26 -> cg_expr_type(node_f1(node), scope, src, fm)
      29 -> cg_lambda_type(node, scope, src, fm)
      36 -> cg_generic_call_expr_type(node, fm, src)
      41 -> cg_resolved_method_call_type(node, fm)
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        let new_scope = scope_push_typed(scope, node_f1(inner), node_f2(inner), 0, ann_ty)
        cg_expr_type(node_f4(inner), new_scope, src, fm)
      }
      52 -> cg_expr_type(node_f2(node), scope, src, fm)
      54 -> ty_f64()
      55 -> ty_ptr_with_mut(cg_expr_type(node_f2(node), scope, src, fm), node_f1(node))
      56 -> {
        let ptr_ty = cg_expr_type(node_f1(node), scope, src, fm)
        if ty_is_ptr(ptr_ty) == 1 { ty_ptr_inner(ptr_ty) } else { ty_i64() }
      }
      57 -> ty_nil()
      51 -> ty_nil()
      49 -> cg_expr_type(node_f1(node), scope, src, fm)
      _ -> 0
    }
  }
}

fn cg_drop_method_hash() -> i64 {
  str_hash(__str_ptr("drop"), 0, 4)
}

fn cg_drop_trait_hash() -> i64 {
  str_hash(__str_ptr("Drop"), 0, 4)
}

fn cg_owned_drop_type_hash(ty: i64) -> i64 {
  if ty_is_owned(ty) != 1 { 0 }
  else {
    let inner = ty_owned_inner(ty)
    if inner != 0 and ty_tag(inner) == 9 { ty_f1(inner) } else { 0 }
  }
}

fn cg_ctable_conforms_direct(ct: i64, type_hash: i64, trait_hash: i64) -> i64 {
  if ct == 0 { 0 }
  else {
    let d = mem_load64_at(ct, 0)
    let n = mem_load64_at(ct + 8, 0)
    let mut i = 0
    let mut found = 0
    while i < n {
      if mem_load64_at(d + i * 32, 0) == type_hash {
        if mem_load64_at(d + i * 32 + 8, 0) == trait_hash {
          found = 1
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

fn cg_owned_drop_conforms(fm: i64, type_hash: i64) -> i64 {
  if type_hash == 0 { 0 }
  else {
    let tt = fmap_get_tt(fm)
    let trait_hash = cg_drop_trait_hash()
    if ttable_hash_is_trait(tt, trait_hash) != 1 { 0 }
    else {
      let ct = ttable_get_ct(tt)
      cg_ctable_conforms_direct(ct, type_hash, trait_hash)
    }
  }
}

fn cg_owned_drop_has_method(fm: i64, ty: i64) -> i64 {
  let type_hash = cg_owned_drop_type_hash(ty)
  if type_hash == 0 { 0 }
  else {
    if cg_owned_drop_conforms(fm, type_hash) != 1 { 0 }
    else {
      let params = ttable_lookup_method_params(fmap_get_tt(fm), type_hash, cg_drop_method_hash())
      if params != 0 { 1 } else { 0 }
    }
  }
}

fn cg_same_name(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> i64 {
  if a_nl != b_nl { 0 } else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

fn cg_expr_list_calls_rc_count(args: i64, nargs: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nargs {
    if cg_expr_calls_rc_count(nlist_get(args, i), src) == 1 {
      found = true
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn cg_record_fields_call_rc_count(fields: i64, nfields: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if cg_expr_calls_rc_count(node_f3(field), src) == 1 {
      found = 1
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn cg_match_arms_call_rc_count(arms: i64, narms: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if cg_expr_calls_rc_count(node_f2(arm), src) == 1 {
      found = true
      i = narms
    } else {
      if cg_expr_calls_rc_count(node_f3(arm), src) == 1 {
        found = true
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn cg_handler_clauses_call_rc_count(clauses: i64, nclauses: i64, src: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if cg_expr_calls_rc_count(node_f3(clause), src) == 1 {
      found = true
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn cg_expr_calls_rc_count(node: i64, src: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> cg_expr_calls_rc_count(node_f2(node), src) or cg_expr_calls_rc_count(node_f3(node), src)
      4 -> if src_eq(src, node_f1(node), node_f2(node), "rc_count") == 1 { true } else { cg_expr_list_calls_rc_count(node_f3(node), node_f4(node), src) }
      5 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src) or cg_expr_calls_rc_count(node_f3(node), src)
      6 -> cg_expr_calls_rc_count(node_f3(node), src) or cg_expr_calls_rc_count(node_f4(node), src)
      7 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
      10 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
      11 -> cg_expr_calls_rc_count(node_f3(node), src) or cg_expr_calls_rc_count(node_f4(node), src)
      12 -> cg_expr_calls_rc_count(node_f3(node), src)
      13 -> cg_expr_calls_rc_count(node_f1(node), src)
      14 -> cg_record_fields_call_rc_count(node_f3(node), node_f4(node), src)
      15 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_match_arms_call_rc_count(node_f2(node), node_f3(node), src)
      22 -> cg_expr_calls_rc_count(node_f1(node), src)
      25 -> cg_expr_calls_rc_count(node_f1(node), src)
      26 -> cg_expr_calls_rc_count(node_f1(node), src)
      29 -> cg_expr_calls_rc_count(node_f2(node), src)
      32 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_list_calls_rc_count(node_f4(node), nlist_len(node_f4(node)), src)
      33 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_handler_clauses_call_rc_count(node_f2(node), node_f3(node), src)
      35 -> cg_expr_calls_rc_count(node_f1(node), src)
      36 -> cg_expr_calls_rc_count(node_f2(node), src)
      37 -> cg_expr_calls_rc_count(node_f1(node), src)
      41 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_list_calls_rc_count(node_f3(node), nlist_len(node_f3(node)), src)
      45 -> cg_expr_calls_rc_count(node_f1(node), src)
      46 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
      47 -> cg_expr_calls_rc_count(node_f3(node), src) or cg_expr_calls_rc_count(node_f4(node), src)
      48 -> cg_expr_calls_rc_count(node_f1(node), src)
      49 -> cg_expr_calls_rc_count(node_f1(node), src)
      52 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
      57 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
      _ -> false
    }
  }
}

fn cg_fn_calls_rc_count(fn_wrap: i64, fn_src: i64, is_test: i64, root_src: i64) -> i64 {
  if fn_src != root_src { 0 }
  else {
    if node_tag(fn_wrap) == 50 {
      cg_expr_calls_rc_count(node_f3(fn_wrap), fn_src)
    } else {
      let inner = unwrap_fn(fn_wrap)
      if inner != 0 and node_tag(inner) == 8 {
        cg_expr_calls_rc_count(node_f4(inner), fn_src)
      } else { 0 }
    }
  }
}

fn cg_fns_call_rc_count(fns: i64, root_src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nlist_len(fns) {
    let pair = nlist_get(fns, i)
    if cg_fn_calls_rc_count(node_f1(pair), node_f2(pair), node_f4(pair), root_src) == 1 {
      found = 1
      i = nlist_len(fns)
    } else { i = i + 1 }
  }
  found
}

fn cg_rc_elision_enabled_for_fns(fns: i64, root_src: i64) -> i64 {
  if cg_fns_call_rc_count(fns, root_src) == 1 { 0 } else { 1 }
}

