fn cg_alloc_mem_call_is_safe(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let args = node_f3(node)
    let nargs = node_f4(node)
    if src_eq(src, node_f1(node), node_f2(node), "__mem_load64") == 1 or src_eq(src, node_f1(node), node_f2(node), "__mem_load8") == 1 {
      if nargs == 1 { cg_alloc_mem_target_is_name(nlist_get(args, 0), src, ns, nl) } else { 0 }
    } else { if src_eq(src, node_f1(node), node_f2(node), "__mem_store64") == 1 or src_eq(src, node_f1(node), node_f2(node), "__mem_store8") == 1 {
      if nargs == 2 {
