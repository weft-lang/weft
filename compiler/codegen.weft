-- Prologue-pair census (2v Stage 2 pre-measurement): which saved
-- callee-saved pairs does the emitted body actually write? Tail-dead
-- pairs fall to a prefix-count shrink; interior-dead need remapping.
pub(package) fn fmap_pair_census_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2560 + which * 8, 0) }
pub(package) fn fmap_add_pair_census_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2560 + which * 8, 0, mem_load64_at(fm + 2560 + which * 8, 0) + count) 0 }
-- Naked-leaf census (2v Stage 2): 0 realized fns, 1 their shed pairs
-- (bank + fp/lr), 2 fns blocked by block params (shuffle-temp
-- conservatism), 3 fns blocked by entry-param cleanup (release BLs
-- need x30 saved), 5/6/7 pool-extended sizing (fns / pairs / spilled
-- defs). Counter index 4 is FORBIDDEN: 2720 holds the per-function
-- naked flag (entry/bail/exit cleared like the split map — the
-- prologue and epilogue emit nothing under it), and a counter add
-- there would arm naked emission on a non-qualifying function.
pub(package) fn fmap_naked_leaf_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2688 + which * 8, 0) }
pub(package) fn fmap_add_naked_leaf_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2688 + which * 8, 0, mem_load64_at(fm + 2688 + which * 8, 0) + count) 0 }
