  let mut found = 0
  let mut i = 0
  while i < nparams and found == 0 {
    let p = nlist_get(params, i)
    if cg_same_name(src, node_f1(p), node_f2(p), ns, nl) == 1 { found = 1 }
    else { i = i + 1 }
  }
  found
}

