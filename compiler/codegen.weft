    __mem_store64(entry + 48, node_f2(vec))
    fmap_set_vector_len_alias_top(fm, entry)
  }
}

fn cg_vector_len_alias_find(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut cur = fmap_vector_len_alias_top(fm)
  let mut found = 0
