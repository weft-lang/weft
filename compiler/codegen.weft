      32 -> if cg_par_perform_is_direct(node, src) == 1 { 1 } else { cg_par_expr_list_has_direct(node_f4(node), nlist_len(node_f4(node)), src) }
      36 -> cg_par_map_is_direct_i64(node, src)
      37 -> cg_par_body_has_direct(node_f1(node), src)
      45 -> cg_par_body_has_direct(node_f1(node), src)
      46 -> cg_par_body_has_direct(node_f1(node), src) or cg_par_body_has_direct(node_f2(node), src)
      48 -> cg_par_body_has_direct(node_f1(node), src)
      49 -> cg_par_body_has_direct(node_f1(node), src)
      _ -> 0
    }
  }
}

