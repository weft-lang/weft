      22 -> cg_expr_assigns_name(node_f1(node), src, ns, nl)
      25 -> cg_expr_assigns_name(node_f1(node), src, ns, nl)
      26 -> cg_expr_assigns_name(node_f1(node), src, ns, nl)
      29 -> cg_expr_assigns_name(node_f2(node), src, ns, nl)
      32 -> cg_expr_assigns_name(node_f1(node), src, ns, nl) or cg_expr_list_assigns_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_expr_assigns_name(node_f1(node), src, ns, nl) or cg_handler_clauses_assign_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_expr_assigns_name(node_f1(node), src, ns, nl)
      36 -> cg_expr_assigns_name(node_f2(node), src, ns, nl)
      37 -> cg_expr_assigns_name(node_f1(node), src, ns, nl)
