fn cg_emit_active_evidence_base_value(code: i64, fm: i64, src: i64, info: i64, dest: i64) -> i64 {
  let first_op = cg_evidence_info_ops(info)
  if first_op == 0 {
    emit_mov_imm_safe(code, dest, 0)
    0
  } else {
  let eff_hash = node_f1(first_op)
  let op_hash = node_f2(first_op)
  let active_evidence_ctr = cg_effect_evidence_find(fm, eff_hash, op_hash)
  if active_evidence_ctr >= 0 {
    let evidence_phys = emit_load_reg(code, active_evidence_ctr)
    bu32(code, encode_add_imm(dest, evidence_phys, 0))
    1
  } else {
    let inline_match = cg_handler_inline_find(fm, src, eff_hash, op_hash)
    if inline_match == 0 {
      emit_mov_imm_safe(code, dest, 0)
      0
    } else {
      let op_index = __mem_load64(inline_match + cg_handler_inline_match_index_offset())
      let ops_ctr = __mem_load64(inline_match + cg_handler_inline_match_ops_ctr_offset())
      let ops_phys = emit_load_reg(code, ops_ctr)
      bu32(code, encode_add_imm(dest, ops_phys, op_index * handler_ops_entry_size()))
      1
    }
  }
  }
}

fn cg_call_effect_evidence_generic(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, entry: i64, info: i64) -> i64 {
  let call_node = node_f2(node)
  let type_args = cg_type_args_in_current_context(fm, node_f1(node))
  let name_hash = node_f4(entry)
  let params = cg_generic_subst_params(fm, name_hash, type_args)
  let first_op = cg_evidence_info_ops(info)
  let active_evidence_ctr = if first_op == 0 { 0 - 1 } else { cg_effect_evidence_find(fm, node_f1(first_op), node_f2(first_op)) }
  let inline_match = if first_op == 0 or active_evidence_ctr >= 0 { 0 } else { cg_handler_inline_find(fm, src, node_f1(first_op), node_f2(first_op)) }
  if first_op == 0 or (active_evidence_ctr < 0 and inline_match == 0) { 0 - 1 }
  else {
    let fn_off = cg_emit_effect_evidence_generic_fn_spec(code, fm, node, entry, info)
    if fn_off == 0 { 0 - 1 }
    else {
      let args = node_f3(call_node)
      let nargs = node_f4(call_node)
      let c = cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
      if active_evidence_ctr >= 0 {
        let evidence_phys = emit_load_reg(code, active_evidence_ctr)
        bu32(code, encode_add_imm(nargs, evidence_phys, 0))
      } else {
        let ops_ctr = __mem_load64(inline_match + cg_handler_inline_match_ops_ctr_offset())
        let ops_phys = emit_load_reg(code, ops_ctr)
        bu32(code, encode_add_imm(nargs, ops_phys, 0))
      }
      let cur = buf_len(code)
      bu32(code, encode_bl(fn_off - cur))
      fmap_inc_effect_evidence_count(fm)
      fmap_inc_semantic_context_call_count(fm)
      if c < 8 {
        bu32(code, encode_add_imm(c + 19, 0, 0))
      } else {
        emit_store_reg(code, c, 0)
      }
      c + 1
    }
  }
}

