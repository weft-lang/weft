        cur = 0
      } else { cur = __mem_load64(cur) }
    }
    found
  } }
}

fn cg_vector_push_call_vec(node: i64, scope: i64, src: i64) -> i64 {
  if cg_generic_call_is_vector_i64(node, scope, src, "vector_push", 2) != 1 { 0 }
  else {
    let call_node = node_f2(node)
    let args = node_f3(call_node)
    let vec = nlist_get(args, 0)
    if node_tag(vec) == 2 { vec } else { 0 }
  }
}

fn cg_vector_push_loop_body_safe(node: i64, scope: i64, src: i64) -> i64 {
  if node == 0 { 1 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      3 -> if cg_vector_push_loop_body_safe(node_f2(node), scope, src) != 1 { 0 } else { cg_vector_push_loop_body_safe(node_f3(node), scope, src) }
      6 -> if cg_vector_push_loop_body_safe(node_f3(node), scope, src) != 1 { 0 } else { cg_vector_push_loop_body_safe(node_f4(node), scope, src) }
      7 -> if cg_vector_push_loop_body_safe(node_f1(node), scope, src) != 1 { 0 } else { cg_vector_push_loop_body_safe(node_f2(node), scope, src) }
      8 -> {
        if cg_vector_push_loop_body_safe(node_f1(node), scope, src) != 1 { 0 }
        else { if cg_vector_push_loop_body_safe(node_f2(node), scope, src) != 1 { 0 }
        else { cg_vector_push_loop_body_safe(node_f3(node), scope, src) } }
      }
      10 -> 0
      11 -> 0
      12 -> cg_vector_push_loop_body_safe(node_f3(node), scope, src)
      22 -> cg_vector_push_loop_body_safe(node_f1(node), scope, src)
      26 -> if node_f1(node) == 0 { 1 } else { cg_vector_push_loop_body_safe(node_f1(node), scope, src) }
      36 -> {
        let vec = cg_vector_push_call_vec(node, scope, src)
        if vec == 0 { 0 }
        else {
          let call_node = node_f2(node)
          let args = node_f3(call_node)
          if cg_vector_push_loop_body_safe(nlist_get(args, 1), scope, src) == 1 { 1 } else { 0 }
        }
      }
      _ -> 0
    }
  }
}

fn cg_vector_push_count_for_ident(node: i64, scope: i64, src: i64, ident: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> cg_vector_push_count_for_ident(node_f2(node), scope, src, ident) + cg_vector_push_count_for_ident(node_f3(node), scope, src, ident)
      6 -> cg_vector_push_count_for_ident(node_f3(node), scope, src, ident) + cg_vector_push_count_for_ident(node_f4(node), scope, src, ident)
      7 -> cg_vector_push_count_for_ident(node_f1(node), scope, src, ident) + cg_vector_push_count_for_ident(node_f2(node), scope, src, ident)
      8 -> cg_vector_push_count_for_ident(node_f1(node), scope, src, ident) + cg_vector_push_count_for_ident(node_f2(node), scope, src, ident) + cg_vector_push_count_for_ident(node_f3(node), scope, src, ident)
      10 -> 0
      11 -> 0
      12 -> cg_vector_push_count_for_ident(node_f3(node), scope, src, ident)
      22 -> cg_vector_push_count_for_ident(node_f1(node), scope, src, ident)
      26 -> if node_f1(node) == 0 { 0 } else { cg_vector_push_count_for_ident(node_f1(node), scope, src, ident) }
      36 -> {
        let vec = cg_vector_push_call_vec(node, scope, src)
        let own = if vec != 0 {
          if cg_span_eq(src, node_f1(vec), node_f2(vec), src, node_f1(ident), node_f2(ident)) == 1 { 1 } else { 0 }
        } else { 0 }
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        own + cg_vector_push_count_for_ident(nlist_get(args, 1), scope, src, ident)
      }
      _ -> 0
    }
  }
}

fn cg_vector_loop_body_is_for_range_shape(body: i64, src: i64, idx: i64) -> i64 {
  if body == 0 { 0 }
  else { if node_tag(body) != 7 { 0 }
  else {
    let first = node_f1(body)
    let second = node_f2(body)
    if node_tag(first) != 6 { 0 }
    else { if cg_span_eq(src, node_f1(first), node_f2(first), src, node_f1(idx), node_f2(idx)) != 1 { 0 }
    else { if node_tag(node_f3(first)) != 2 { 0 }
    else { if cg_span_eq(src, node_f1(node_f3(first)), node_f2(node_f3(first)), src, node_f1(idx), node_f2(idx)) != 1 { 0 }
    else { if node_tag(second) != 12 { 0 }
    else { if cg_span_eq(src, node_f1(second), node_f2(second), src, node_f1(idx), node_f2(idx)) != 1 { 0 }
    else {
      let rhs = node_f3(second)
      if node_tag(rhs) != 3 { 0 }
      else { if node_f1(rhs) != 1 { 0 }
      else { if node_tag(node_f2(rhs)) != 2 { 0 }
      else { if cg_span_eq(src, node_f1(node_f2(rhs)), node_f2(node_f2(rhs)), src, node_f1(idx), node_f2(idx)) != 1 { 0 }
      else { if node_tag(node_f3(rhs)) != 1 { 0 }
      else { if node_f1(node_f3(rhs)) == 1 { 1 } else { 0 } } } } } }
    } } } } } } }
  } }
}

fn cg_vector_push_loop_proofs(cond: i64, body: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cond == 0 { 0 }
  else { if node_tag(cond) != 3 { 0 }
  else { if node_f1(cond) != 7 { 0 }
  else {
    let idx = node_f2(cond)
    let cap = node_f3(cond)
    if node_tag(idx) != 2 { 0 }
    else { if cg_nonnegative_has(fm, src, node_f1(idx), node_f2(idx)) != 1 { 0 }
    else { if cg_vector_loop_body_is_for_range_shape(body, src, idx) != 1 { 0 }
    else { if cg_vector_push_loop_body_safe(body, scope, src) != 1 { 0 }
    else {
      let result = nlist_new()
      let mut cur = cg_vector_capacity_find_for_cap(fm, src, cap)
      while cur != 0 {
        let ident = node_new(2, __mem_load64(cur + 16), __mem_load64(cur + 24), 0, 0)
        if cg_vector_push_count_for_ident(body, scope, src, ident) == 1 {
          nlist_add(result, cur)
        } else { 0 }
        cur = 0
      }
      result
    } } } }
  } } }
}

fn cg_vector_push_activate_loop_proofs(fm: i64, proofs: i64) -> i64 {
  if proofs == 0 { 0 }
  else {
    for i in 0..nlist_len(proofs) {
      cg_vector_push_proof_push(fm, nlist_get(proofs, i))
    }
  }
}

fn cg_vector_data_find(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut cur = fmap_vector_data_top(fm)
  let mut result = 0 - 1
  while cur != 0 {
    if cg_span_eq(__mem_load64(cur + 8), __mem_load64(cur + 16), __mem_load64(cur + 24), src, ns, nl) == 1 {
      result = __mem_load64(cur + 32)
      cur = 0
    } else { cur = __mem_load64(cur) }
  }
  result
}

fn cg_vector_data_find_arg(fm: i64, src: i64, vec: i64) -> i64 {
  if vec == 0 { 0 - 1 }
  else { if node_tag(vec) != 2 { 0 - 1 }
  else { cg_vector_data_find(fm, src, node_f1(vec), node_f2(vec)) } }
}

