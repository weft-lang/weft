        i = narms
      } else {
        let arm_scope = cg_rc_reuse_match_arm_scope(pat, typed_scope, src, scr_ty, fm)
        let arm_plan = cg_rc_reuse_try_prefix_chain_plan(size, node_f2(arm), arm_scope, src, ns, nl, fm, cg_rc_reuse_prefix_chain_state(0, 0))
        if cg_rc_reuse_plan_kind(arm_plan) != cg_rc_reuse_plan_kind_after_prefix() {
          ok = 0
          i = narms
        } else {
          nlist_add(plans, arm_plan)
          i = i + 1
        }
      }
    }
    if ok == 1 { plans } else { 0 }
  }
}

fn cg_rc_reuse_try_match_plan(body: i64, src: i64, ns: i64, nl: i64, fm: i64, facts: i64) -> i64 {
  if body == 0 or node_tag(body) != 15 { 0 }
  else { if cg_rc_reuse_branch_cond_safe(node_f1(body), src, ns, nl) != 1 { 0 }
  else {
    let typed_scope = cg_rc_reuse_facts_typed_scope(facts)
    if cg_ty_is_managed(cg_expr_type(body, typed_scope, src, fm)) == 1 { 0 }
    else {
      let size = cg_rc_reuse_facts_size(facts)
      let scr_ty = cg_expr_type(node_f1(body), typed_scope, src, fm)
      let arm_plans = cg_rc_reuse_match_arms_plan(node_f2(body), node_f3(body), src, ns, nl, fm, facts, scr_ty)
      if arm_plans == 0 { 0 }
      else { cg_rc_reuse_plan_new_match(size, arm_plans) }
    }
  } }
}

fn cg_rc_reuse_plan_for_facts(body: i64, scope: i64, src: i64, ns: i64, nl: i64, fm: i64, facts: i64) -> i64 {
  if fmap_rc_elision_enabled(fm) != 1 or facts == 0 { 0 }
  else {
    let immediate = cg_rc_reuse_try_immediate_plan(body, scope, src, fm, facts)
    if immediate != 0 { immediate }
    else {
      let after_prefix = cg_rc_reuse_try_after_prefix_plan(body, src, ns, nl, fm, facts)
      if after_prefix != 0 { after_prefix }
      else {
        let branch = cg_rc_reuse_try_branch_plan(body, src, ns, nl, fm, facts)
        if branch != 0 { branch }
        else { cg_rc_reuse_try_match_plan(body, src, ns, nl, fm, facts) }
      }
    }
  }
}

fn cg_rc_reuse_emit_after_prefix_let(body: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  let release_size = cg_rc_reuse_plan_size(plan)
  let prefix_count = cg_rc_reuse_plan_prefix_count(plan)
  if prefix_count <= 0 {
    cg_inc_managed_reuse_lowering(fm, continuation_cleanup_kind_rc())
    cg_emit_managed_release_kind_regid_with_size(code, fm, continuation_cleanup_kind_rc(), released_rid, release_size)
    cg_expr(body, code, scope, src, ctr, fm)
  } else {
  let prefix_let = cg_rc_reuse_prefix_let_inner(body)
  let prefix_value = node_f3(prefix_let)
  let prefix_ty = cg_rc_reuse_prefix_let_type(body, prefix_value, scope, src, fm)
  let c_prefix = cg_expr(prefix_value, code, scope, src, ctr, fm)
  let prefix_rid = reg_id(c_prefix - 1)
  let prefix_origin = cg_expr_value_origin(prefix_value, scope, src, fm)
  let prefix_scope = scope_push_typed_meta(scope, node_f1(prefix_let), node_f2(prefix_let), prefix_rid, prefix_ty, prefix_origin)
  let old_vector_len_alias_top = fmap_vector_len_alias_top(fm)
  let old_vector_capacity_top = fmap_vector_capacity_top(fm)
  cg_vector_len_alias_push_if_needed(fm, src, node_f1(prefix_let), node_f2(prefix_let), prefix_value, scope)
  cg_vector_capacity_push_if_needed(fm, src, node_f1(prefix_let), node_f2(prefix_let), prefix_value, scope)
  let rest_plan = cg_rc_reuse_plan_new_with_prefix_count(cg_rc_reuse_plan_kind_after_prefix(), release_size, prefix_count - 1)
  let br = cg_rc_reuse_emit_after_prefix_let(node_f4(prefix_let), code, prefix_scope, src, c_prefix, fm, released_rid, rest_plan)
  fmap_set_vector_len_alias_top(fm, old_vector_len_alias_top)
  fmap_set_vector_capacity_top(fm, old_vector_capacity_top)
  br
  }
}

fn cg_rc_reuse_emit_branch_if(body: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  let cond = node_f1(body)
  let then_n = node_f2(body)
  let else_n = node_f3(body)
  let direct_branch = cg_direct_branch_false(cond, code, scope, src, ctr, fm)
  let mut cond_phys = 0
  let mut branch_pos = 0
  if direct_branch == 0 {
    let c1 = cg_expr(cond, code, scope, src, ctr, fm)
    cond_phys = emit_load_reg(code, c1 - 1)
    branch_pos = buf_len(code)
    bu32(code, 0)
  } else {
    branch_pos = node_f1(direct_branch)
  }
  let c2 = cg_rc_reuse_emit_after_prefix_let(then_n, code, scope, src, ctr, fm, released_rid, cg_rc_reuse_plan_then(plan))
  let then_phys = emit_load_reg(code, c2 - 1)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, then_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, then_phys, 0))
    emit_store_reg(code, ctr, 17)
  }
  let b_pos = buf_len(code)
  bu32(code, 0)
  let else_start = buf_len(code)
  let c3 = cg_rc_reuse_emit_after_prefix_let(else_n, code, scope, src, ctr, fm, released_rid, cg_rc_reuse_plan_else(plan))
  let else_phys = emit_load_reg(code, c3 - 1)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, else_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, else_phys, 0))
    emit_store_reg(code, ctr, 17)
  }
  let after_else = buf_len(code)
  if direct_branch == 0 {
    cg_patch_cbz(code, branch_pos, cond_phys, else_start)
  } else {
    cg_patch_branch_cond_list(code, branch_pos, else_start)
  }
  cg_patch_b(code, b_pos, after_else)
  ctr + 1
}

fn cg_rc_reuse_match_state(scrutinee_ctr: i64, released_rid: i64, arm_plans: i64, arm_index: i64) -> i64 {
  node_new(0, scrutinee_ctr, released_rid, arm_plans, arm_index)
}

fn cg_rc_reuse_match_state_scrutinee_ctr(state: i64) -> i64 { node_f1(state) }
fn cg_rc_reuse_match_state_released_rid(state: i64) -> i64 { node_f2(state) }
fn cg_rc_reuse_match_state_plans(state: i64) -> i64 { node_f3(state) }
fn cg_rc_reuse_match_state_arm_index(state: i64) -> i64 { node_f4(state) }

fn cg_rc_reuse_emit_match_next(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, state: i64) -> i64 {
  let next_state = cg_rc_reuse_match_state(
    cg_rc_reuse_match_state_scrutinee_ctr(state),
    cg_rc_reuse_match_state_released_rid(state),
    cg_rc_reuse_match_state_plans(state),
    cg_rc_reuse_match_state_arm_index(state) + 1
  )
  cg_rc_reuse_emit_match_arms(arms, n_arms, code, scope, src, ctr, fm, next_state)
}

fn cg_rc_reuse_emit_match_ctor_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, state: i64) -> i64 {
  let arm_index = cg_rc_reuse_match_state_arm_index(state)
  let arm = nlist_get(arms, arm_index)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let arm_plan = nlist_get(cg_rc_reuse_match_state_plans(state), arm_index)
  let released_rid = cg_rc_reuse_match_state_released_rid(state)
  let scrutinee_ctr = cg_rc_reuse_match_state_scrutinee_ctr(state)
  let expected_hash = str_hash(src, node_f1(pat), node_f2(pat))
  let known_hash = fmap_match_known_ctor_hash(fm)
  let known_match = if known_hash == expected_hash { 1 } else { 0 }
  if known_hash >= 0 and known_match != 1 {
    fmap_inc_set_narrowing_elision_count(fm)
    cg_rc_reuse_emit_match_next(arms, n_arms, code, scope, src, ctr, fm, state)
  } else { if known_match == 1 {
    fmap_inc_set_narrowing_elision_count(fm)
    let body_scope = if node_f4(pat) != 0 {
      cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat)
    } else { scope }
    let body_ctr = if node_f4(pat) != 0 {
      if node_f4(pat) < 0 { ctr + (0 - node_f4(pat)) } else { ctr + 1 }
    } else { ctr }
    let guard_cbz = if guard > 0 {
      let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
      let gp = emit_load_reg(code, cg - 1)
      let gpos = buf_len(code)
      bu32(code, 0)
      gpos * 256 + gp
    } else { 0 }
    let c_body = cg_rc_reuse_emit_after_prefix_let(body, code, body_scope, src, body_ctr, fm, released_rid, arm_plan)
    cg_match_store_result(code, ctr, c_body)
    if guard > 0 {
      let b_pos = buf_len(code)
      bu32(code, 0)
      let next_start = buf_len(code)
      cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
      cg_rc_reuse_emit_match_next(arms, n_arms, code, scope, src, ctr, fm, state)
      let after = buf_len(code)
      cg_patch_b(code, b_pos, after)
    } else { 0 }
    ctr + 1
  } else {
    cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
    let cbz_pos = buf_len(code)
    bu32(code, 0)
    let body_scope = if node_f4(pat) != 0 {
      cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat)
    } else { scope }
    let body_ctr = if node_f4(pat) != 0 {
      if node_f4(pat) < 0 { ctr + (0 - node_f4(pat)) } else { ctr + 1 }
    } else { ctr }
    let guard_cbz = if guard > 0 {
      let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
      let gp = emit_load_reg(code, cg - 1)
      let gpos = buf_len(code)
      bu32(code, 0)
      gpos * 256 + gp
    } else { 0 }
    let c_body = cg_rc_reuse_emit_after_prefix_let(body, code, body_scope, src, body_ctr, fm, released_rid, arm_plan)
    cg_match_store_result(code, ctr, c_body)
    let b_pos = buf_len(code)
    bu32(code, 0)
    let next_start = buf_len(code)
    cg_patch_cbz(code, cbz_pos, 17, next_start)
    if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
    cg_rc_reuse_emit_match_next(arms, n_arms, code, scope, src, ctr, fm, state)
    let after = buf_len(code)
    cg_patch_b(code, b_pos, after)
    ctr + 1
  } }
}

fn cg_rc_reuse_emit_match_arms(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, state: i64) -> i64 {
  let arm_index = cg_rc_reuse_match_state_arm_index(state)
  if arm_index >= n_arms {
    bu32(code, encode_brk(1))
    cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  } else {
    let arm = nlist_get(arms, arm_index)
    let pat = node_f1(arm)
    let body = node_f2(arm)
    let guard = node_f3(arm)
    let plans = cg_rc_reuse_match_state_plans(state)
    let arm_plan = nlist_get(plans, arm_index)
    let released_rid = cg_rc_reuse_match_state_released_rid(state)
    let scrutinee_ctr = cg_rc_reuse_match_state_scrutinee_ctr(state)
    let pat_tag = node_tag(pat)
    match pat_tag {
      17 -> {
        if guard == 0 {
          let c_body = cg_rc_reuse_emit_after_prefix_let(body, code, scope, src, ctr, fm, released_rid, arm_plan)
          cg_match_store_result(code, ctr, c_body)
          ctr + 1
        } else {
          let cg = cg_expr(guard, code, scope, src, ctr, fm)
          let gp = emit_load_reg(code, cg - 1)
          let cbz_pos = buf_len(code)
          bu32(code, 0)
          let c_body = cg_rc_reuse_emit_after_prefix_let(body, code, scope, src, ctr, fm, released_rid, arm_plan)
          cg_match_store_result(code, ctr, c_body)
          let b_pos = buf_len(code)
          bu32(code, 0)
          let next_start = buf_len(code)
          cg_patch_cbz(code, cbz_pos, gp, next_start)
          cg_rc_reuse_emit_match_next(arms, n_arms, code, scope, src, ctr, fm, state)
          let after = buf_len(code)
          cg_patch_b(code, b_pos, after)
          ctr + 1
        }
      }
      19 -> {
        let lit_val = node_f1(pat)
        let scr_phys = emit_load_reg(code, scrutinee_ctr)
        emit_mov_imm(code, 17, lit_val)
        bu32(code, encode_cmp(scr_phys, 17))
        bu32(code, encode_cset(17, 0))
        let cbz_pos = buf_len(code)
        bu32(code, 0)
        let guard_cbz = if guard > 0 {
          let cg = cg_expr(guard, code, scope, src, ctr, fm)
          let gp = emit_load_reg(code, cg - 1)
          let gpos = buf_len(code)
          bu32(code, 0)
          gpos * 256 + gp
        } else { 0 }
        let c_body = cg_rc_reuse_emit_after_prefix_let(body, code, scope, src, ctr, fm, released_rid, arm_plan)
        cg_match_store_result(code, ctr, c_body)
        let b_pos = buf_len(code)
        bu32(code, 0)
        let next_start = buf_len(code)
        cg_patch_cbz(code, cbz_pos, 17, next_start)
        if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
        cg_rc_reuse_emit_match_next(arms, n_arms, code, scope, src, ctr, fm, state)
        let after = buf_len(code)
        cg_patch_b(code, b_pos, after)
        ctr + 1
      }
      20 -> cg_rc_reuse_emit_match_ctor_arm(arms, n_arms, code, scope, src, ctr, fm, state)
      _ -> {
        bu32(code, encode_brk(1))
        cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
      }
    }
  }
}

fn cg_rc_reuse_emit_match(body: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, released_rid: i64, plan: i64) -> i64 {
  let scrutinee = node_f1(body)
  let arms = node_f2(body)
  let n_arms = node_f3(body)
  let known_hash = cg_expr_known_ctor_hash(scrutinee, scope, src, fm)
  let scrutinee_ty = cg_expr_type(scrutinee, scope, src, fm)
  let value_origin = cg_expr_value_origin(scrutinee, scope, src, fm)
  let c1 = cg_expr(scrutinee, code, scope, src, ctr, fm)
  let old_known_hash = fmap_match_known_ctor_hash(fm)
  let old_scrutinee_ty = fmap_match_scrutinee_type(fm)
  let old_value_origin = fmap_match_value_origin(fm)
  let old_eliminated = fmap_match_eliminated_hashes(fm)
  fmap_set_match_known_ctor_hash(fm, known_hash)
  fmap_set_match_scrutinee_type(fm, scrutinee_ty)
  fmap_set_match_value_origin(fm, value_origin)
  fmap_set_match_eliminated_hashes(fm, 0)
  let state = cg_rc_reuse_match_state(c1 - 1, released_rid, cg_rc_reuse_plan_arms(plan), 0)
  let result = cg_rc_reuse_emit_match_arms(arms, n_arms, code, scope, src, c1, fm, state)
  fmap_set_match_known_ctor_hash(fm, old_known_hash)
  fmap_set_match_scrutinee_type(fm, old_scrutinee_ty)
  fmap_set_match_value_origin(fm, old_value_origin)
  fmap_set_match_eliminated_hashes(fm, old_eliminated)
  result
}

fn cg_alloc_call_size(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 4 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else { if src_eq(src, node_f1(node), node_f2(node), "alloc_bump") != 1 and src_eq(src, node_f1(node), node_f2(node), "__bump_alloc") != 1 { 0 }
  else {
    let arg = nlist_get(node_f3(node), 0)
    if node_tag(arg) != 1 { 0 }
    else {
      let size = node_f1(arg)
      if size <= 0 { 0 }
      else { if size > cg_alloc_elision_max_size() { 0 } else { size } }
    }
  } } } }
}

fn cg_alloc_expr_list_mentions_name(args: i64, nargs: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nargs {
    if cg_alloc_expr_mentions_name(nlist_get(args, i), src, ns, nl) == 1 {
      found = 1
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn cg_alloc_record_fields_mention_name(fields: i64, nfields: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if cg_alloc_expr_mentions_name(node_f3(field), src, ns, nl) == 1 {
      found = 1
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn cg_alloc_match_arms_mention_name(arms: i64, narms: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if cg_alloc_expr_mentions_name(node_f2(arm), src, ns, nl) == 1 {
      found = 1
      i = narms
    } else {
      if cg_alloc_expr_mentions_name(node_f3(arm), src, ns, nl) == 1 {
        found = 1
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn cg_alloc_handler_clauses_mention_name(clauses: i64, nclauses: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if cg_alloc_expr_mentions_name(node_f3(clause), src, ns, nl) == 1 {
      found = 1
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn cg_alloc_expr_mentions_name(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> cg_same_name(src, node_f1(node), node_f2(node), ns, nl)
      3 -> cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl)
      4 -> cg_alloc_expr_list_mentions_name(node_f3(node), node_f4(node), src, ns, nl)
      5 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl)
      6 -> cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f4(node), src, ns, nl)
      7 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl)
      10 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl)
      11 -> cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f4(node), src, ns, nl)
      12 -> cg_same_name(src, node_f1(node), node_f2(node), ns, nl) or cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl)
      13 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      14 -> cg_alloc_record_fields_mention_name(node_f3(node), node_f4(node), src, ns, nl)
      15 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_match_arms_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      22 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      25 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      26 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      29 -> cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl)
      32 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_list_mentions_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_handler_clauses_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      36 -> cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl)
      37 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      41 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_list_mentions_name(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      45 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl)
      46 -> cg_alloc_expr_mentions_name(node_f1(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f2(node), src, ns, nl)
      47 -> cg_alloc_expr_mentions_name(node_f3(node), src, ns, nl) or cg_alloc_expr_mentions_name(node_f4(node), src, ns, nl)
