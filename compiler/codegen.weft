      41 -> if cg_borrow_expr_mentions_name(node, src, ns, nl) == 1 { 1 } else { 0 }
      45 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      46 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f4(node), src, ns, nl)
      }
      48 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      49 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      52 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      _ -> 0
    }
  }
}

fn cg_fn_borrowable_param_mask(fn_wrap: i64, fn_src: i64) -> i64 {
  if cg_ty_is_managed(fn_ret_type(fn_wrap)) == 1 { 0 }
  else {
    let inner = unwrap_fn(fn_wrap)
    let params = node_f3(inner)
    let body = node_f4(inner)
    let mut mask = 0
    let mut i = 0
    let n = nlist_len(params)
    while i < n and i < 60 {
      let p = nlist_get(params, i)
      if cg_ty_is_managed(node_f3(p)) == 1 {
        if cg_borrow_expr_blocks_name(body, fn_src, node_f1(p), node_f2(p)) == 0 {
          mask = mask + cg_bit(i)
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    mask
  }
}

fn cg_expr_has_borrow_call_barrier(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_expr_has_borrow_call_barrier(node_f2(node), src) or cg_expr_has_borrow_call_barrier(node_f3(node), src)
      4 -> if cg_call_name_is_borrow_barrier(node, src) == 1 { 1 } else { cg_expr_list_has_borrow_call_barrier(node_f3(node), node_f4(node), src) }
      5 -> cg_expr_has_borrow_call_barrier(node_f1(node), src) or cg_expr_has_borrow_call_barrier(node_f2(node), src) or cg_expr_has_borrow_call_barrier(node_f3(node), src)
      6 -> cg_expr_has_borrow_call_barrier(node_f3(node), src) or cg_expr_has_borrow_call_barrier(node_f4(node), src)
      7 -> cg_expr_has_borrow_call_barrier(node_f1(node), src) or cg_expr_has_borrow_call_barrier(node_f2(node), src)
      10 -> cg_expr_has_borrow_call_barrier(node_f1(node), src) or cg_expr_has_borrow_call_barrier(node_f2(node), src)
      11 -> cg_expr_has_borrow_call_barrier(node_f3(node), src) or cg_expr_has_borrow_call_barrier(node_f4(node), src)
      12 -> cg_expr_has_borrow_call_barrier(node_f3(node), src)
      13 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      14 -> 1
      15 -> cg_expr_has_borrow_call_barrier(node_f1(node), src) or cg_match_arms_have_borrow_call_barrier(node_f2(node), node_f3(node), src)
      22 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      25 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      26 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      29 -> 1
      32 -> 1
      33 -> 1
      35 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      36 -> 1
      37 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      41 -> 1
      45 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      46 -> cg_expr_has_borrow_call_barrier(node_f1(node), src) or cg_expr_has_borrow_call_barrier(node_f2(node), src)
      47 -> cg_expr_has_borrow_call_barrier(node_f3(node), src) or cg_expr_has_borrow_call_barrier(node_f4(node), src)
      48 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      49 -> cg_expr_has_borrow_call_barrier(node_f1(node), src)
      52 -> 1
      _ -> 0
    }
  }
}

fn cg_call_name_is_borrow_barrier(node: i64, src: i64) -> i64 {
  src_eq(src, node_f1(node), node_f2(node), "__mem_store64") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "__mem_store8") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "rc_default_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "rc_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "closure_default_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "closure_default_release_env") == 1
}

fn cg_expr_list_has_borrow_call_barrier(args: i64, nargs: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nargs {
    if cg_expr_has_borrow_call_barrier(nlist_get(args, i), src) == 1 {
      found = 1
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn cg_match_arms_have_borrow_call_barrier(arms: i64, narms: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if cg_expr_has_borrow_call_barrier(node_f2(arm), src) == 1 {
      found = 1
      i = narms
    } else {
      if cg_expr_has_borrow_call_barrier(node_f3(arm), src) == 1 {
        found = 1
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn cg_fn_allows_borrowed_params(fn_wrap: i64, fn_src: i64) -> i64 {
  if cg_ty_is_managed(fn_ret_type(fn_wrap)) == 1 { 0 }
  else {
    let inner = unwrap_fn(fn_wrap)
    if cg_expr_has_borrow_call_barrier(node_f4(inner), fn_src) == 1 { 0 } else { 1 }
  }
}

fn cg_cleanup_stack(fm: i64) -> i64 {
  __mem_load64(fm + 144)
}

fn cg_cleanup_count(fm: i64) -> i64 {
  nlist_len(cg_cleanup_stack(fm))
}

fn cg_cleanup_push(fm: i64, cleanup: i64, scope: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, cleanup, scope, 0, 0))
  nlist_len(stack)
}

fn cg_cleanup_push_rc(fm: i64, rid: i64) -> i64 {
  cg_cleanup_push_rc_sized(fm, rid, 0)
}

fn cg_cleanup_push_rc_sized(fm: i64, rid: i64, payload_size: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, 0, 1, payload_size))
  nlist_len(stack)
}

fn cg_cleanup_push_closure(fm: i64, rid: i64) -> i64 {
  cg_cleanup_push_closure_sized(fm, rid, 16)
}

fn cg_cleanup_push_closure_sized(fm: i64, rid: i64, payload_size: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, 0, 2, payload_size))
  nlist_len(stack)
}

fn cg_cleanup_push_for_ty(fm: i64, ty: i64, rid: i64) -> i64 {
  cg_cleanup_push_for_ty_sized(fm, ty, rid, cg_managed_reuse_static_release_size_for_ty(ty))
}

fn cg_cleanup_push_for_ty_sized(fm: i64, ty: i64, rid: i64, payload_size: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_cleanup_push_rc_sized(fm, rid, payload_size) }
  else { if cg_ty_is_closure(ty) == 1 { cg_cleanup_push_closure_sized(fm, rid, payload_size) } else { 0 } }
}

fn cg_cleanup_kind_for_ty(ty: i64) -> i64 {
  cg_managed_drop_kind_for_ty(ty)
}

fn cg_cleanup_descriptor_kind(entry: i64) -> i64 {
  match node_f3(entry) {
    1 -> continuation_cleanup_kind_rc()
    2 -> continuation_cleanup_kind_closure()
    _ -> continuation_cleanup_kind_none()
  }
}

fn cg_cleanup_descriptor_size(entry: i64) -> i64 {
  node_f4(entry)
}

fn cg_cleanup_restore(fm: i64, depth: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  __mem_store64(stack + 8, depth)
  0
}

fn cg_emit_cleanups_to_depth(code: i64, src: i64, ctr: i64, fm: i64, depth: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let old_len = nlist_len(stack)
  let mut remaining = old_len - depth
  let mut c = ctr
  while remaining > 0 {
    let i = depth + remaining - 1
    let entry = nlist_get(stack, i)
    __mem_store64(stack + 8, i)
    let kind = cg_cleanup_descriptor_kind(entry)
    if kind != continuation_cleanup_kind_none() {
      cg_emit_managed_release_kind_regid_with_size(code, fm, kind, node_f1(entry), cg_cleanup_descriptor_size(entry))
    } else {
      c = cg_expr(node_f1(entry), code, node_f2(entry), src, c, fm)
    }
    __mem_store64(stack + 8, old_len)
    remaining = remaining - 1
  }
  __mem_store64(stack + 8, old_len)
  c
}

fn cg_defer(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let cleanup = node_f1(node)
  let body = node_f2(node)
  let depth = cg_cleanup_count(fm)
  cg_cleanup_push(fm, cleanup, scope)
  let br = cg_expr(body, code, scope, src, ctr, fm)
  let save_ctr = br
  cg_match_store_result(code, save_ctr, br)
  cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
  cg_cleanup_restore(fm, depth)
  cg_match_store_result(code, ctr, save_ctr + 1)
  ctr + 1
}

-- tags 1-7: int, ident, binop, call, if, let, block
fn cg_expr_low(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    1 -> cg_int(node, code, ctr)
    2 -> cg_ident(node, code, scope, src, ctr, fm)
    3 -> cg_binop(node, code, scope, src, ctr, fm)
    4 -> cg_call(node, code, scope, src, ctr, fm)
    5 -> cg_if(node, code, scope, src, ctr, fm)
    6 -> cg_let(node, code, scope, src, ctr, fm)
    _ -> cg_block(node, code, scope, src, ctr, fm)
  }
}

-- tags 9+: string, while, let_mut, assign, field_access, record_init, match
fn cg_expr_high(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    9 -> cg_string(node, code, scope, src, ctr, fm)
    10 -> cg_while(node, code, scope, src, ctr, fm)
    11 -> cg_let_mut(node, code, scope, src, ctr, fm)
    12 -> cg_assign(node, code, scope, src, ctr, fm)
    13 -> cg_field_access(node, code, scope, src, ctr, fm)
    14 -> cg_record_init(node, code, scope, src, ctr, fm)
    15 -> cg_match(node, code, scope, src, ctr, fm)
    22 -> cg_not(node, code, scope, src, ctr, fm)
    24 -> cg_int(node_new(1, node_f1(node), 0, 0, 0), code, ctr)
    25 -> cg_return(node, code, scope, src, ctr, fm)
    26 -> cg_break(node, code, scope, src, ctr, fm)
    27 -> cg_continue(node, code, scope, src, ctr, fm)
    29 -> cg_lambda(node, code, scope, src, ctr, fm)
    32 -> cg_dot_call(node, code, scope, src, ctr, fm)
    33 -> cg_handle(node, code, scope, src, ctr, fm)
    41 -> cg_method_call_typed(node, code, scope, src, ctr, fm)
    35 -> cg_resume(node, code, scope, src, ctr, fm)
    36 -> cg_generic_call(node, code, scope, src, ctr, fm)
    37 -> cg_let_typed(node, code, scope, src, ctr, fm)
    45 -> cg_try(node, code, scope, src, ctr, fm)
    46 -> cg_interp_concat(node, code, scope, src, ctr, fm)
    47 -> cg_for_iter(node, code, scope, src, ctr, fm)
    48 -> cg_opt_chain(node, code, scope, src, ctr, fm)
    49 -> cg_loop(node, code, scope, src, ctr, fm)
    51 -> cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
    52 -> cg_defer(node, code, scope, src, ctr, fm)
    54 -> cg_f64(node, code, src, ctr, fm)
    _ -> cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  }
}

-- codegen_expr: emit code for an expression, return next counter
fn cg_expr(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  if tag <= 7 {
    cg_expr_low(node, code, scope, src, ctr, fm)
  } else {
    cg_expr_high(node, code, scope, src, ctr, fm)
  }
}

fn cg_expr_floor(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    5 -> cg_if_floor(node, code, scope, src, ctr, fm, floor)
    6 -> cg_let_with_type(node, code, scope, src, ctr, fm, cg_expr_type(node_f3(node), scope, src, fm), floor)
    7 -> cg_block_floor(node, code, scope, src, ctr, fm, floor)
    10 -> cg_while_floor(node, code, scope, src, ctr, fm, floor)
    11 -> cg_let_mut_with_type(node, code, scope, src, ctr, fm, cg_expr_type(node_f3(node), scope, src, fm), floor)
    37 -> cg_let_typed_floor(node, code, scope, src, ctr, fm, floor)
    _ -> cg_expr(node, code, scope, src, ctr, fm)
  }
}

fn cg_expr_discard_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let scaled_store = cg_call_try_mem64_scaled_discard(node, code, scope, src, ctr, fm)
  if scaled_store >= 0 {
    scaled_store
  } else {
    cg_expr(node, code, scope, src, ctr, fm)
    ctr
  }
}

fn cg_expr_discard(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    4 -> cg_expr_discard_call(node, code, scope, src, ctr, fm)
    7 -> {
      cg_expr_discard(node_f1(node), code, scope, src, ctr, fm)
      cg_expr_discard(node_f2(node), code, scope, src, ctr, fm)
    }
    _ -> {
      cg_expr(node, code, scope, src, ctr, fm)
      ctr
    }
  }
}

fn cg_expr_discard_floor(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  let tag = node_tag(node)
  match tag {
    4 -> cg_expr_discard_call(node, code, scope, src, ctr, fm)
    7 -> {
      cg_expr_discard_floor(node_f1(node), code, scope, src, ctr, fm, floor)
      cg_expr_discard_floor(node_f2(node), code, scope, src, ctr, fm, floor)
    }
    5 -> { cg_expr_floor(node, code, scope, src, ctr, fm, floor) ctr }
    6 -> { cg_expr_floor(node, code, scope, src, ctr, fm, floor) ctr }
    10 -> { cg_expr_floor(node, code, scope, src, ctr, fm, floor) ctr }
    11 -> { cg_expr_floor(node, code, scope, src, ctr, fm, floor) ctr }
    37 -> { cg_expr_floor(node, code, scope, src, ctr, fm, floor) ctr }
    _ -> {
      cg_expr(node, code, scope, src, ctr, fm)
      ctr
    }
  }
}

-- return expr: evaluate, move to x0, emit epilogue+RET inline
fn cg_return(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let val = node_f1(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  let save_ctr = c1
  cg_match_store_result(code, save_ctr, c1)
  let ret_ty = fmap_get_current_ret_ty(fm)
  if cg_ty_is_managed(ret_ty) == 1 {
    if cg_expr_is_borrow_for_ty(ret_ty, val, scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, 0)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  ctr + 1
}

-- break: emit B placeholder to after_loop (patched by cg_while)
fn cg_break(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  -- Check for break(expr) — tag 26, f1 = value node or 0
  let val_node = node_f1(node)
  let cleanup_ctr = if val_node != 0 {
    cg_expr(val_node, code, scope, src, ctr, fm)
  } else { ctr }
  if val_node != 0 {
    let loop_result_ctr = fmap_loop_result_ctr(fm)
    if loop_result_ctr >= 0 {
      cg_match_store_result(code, loop_result_ctr, cleanup_ctr)
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, src, cleanup_ctr, fm, __mem_load64(fm + 152))
  let patches = __mem_load64(fm + 64)
  if patches > 0 {
    nlist_add(patches, buf_len(code))
    bu32(code, 0)
  } else {
    eprint("error: break outside of loop\n")
  }
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

-- continue: emit B back to loop_start
fn cg_continue(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let loop_start = __mem_load64(fm + 56)
  if loop_start > 0 {
    cg_emit_cleanups_to_depth(code, src, ctr, fm, __mem_load64(fm + 152))
    let cur = buf_len(code)
    bu32(code, encode_b(loop_start - cur))
  } else {
    eprint("error: continue outside of loop\n")
  }
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

-- ======================================================================
-- Free variable analysis for closures
-- ======================================================================
-- Walk AST, find identifiers not bound in the lambda-local scope but present in
-- the enclosing codegen scope, and add them to free_vars.
fn ffv_add_name(ns: i64, nl: i64, local_scope: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  if scope_lookup(local_scope, src, ns, nl) != 0 - 999 { 0 }
  else {
    if scope_lookup(enclosing_scope, src, ns, nl) == 0 - 999 { 0 }
    else {
      let mut found = false
      let mut i = 0
      while i < nlist_len(fv) {
        let e = nlist_get(fv, i)
        if node_f2(e) == nl {
          if src_eq_at(src, ns, src + node_f1(e), 0, nl) == 1 { found = true i = nlist_len(fv) }
          else { i = i + 1 }
        } else { i = i + 1 }
      }
      if not found { nlist_add(fv, node_new(2, ns, nl, 0, 0)) } else { 0 }
    }
  }
}

fn ffv_add_ident(node: i64, local_scope: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  ffv_add_name(node_f1(node), node_f2(node), local_scope, enclosing_scope, src, fv)
}

fn ffv_push(work: i64, scopes: i64, node: i64, scope: i64) -> i64 {
  if node != 0 {
    nlist_add(work, node)
    nlist_add(scopes, scope)
  } else { 0 }
}

fn ffv_push_list(work: i64, scopes: i64, nodes: i64, n: i64, scope: i64) -> i64 {
  for i in 0..n { ffv_push(work, scopes, nlist_get(nodes, i), scope) }
  0
}

fn ffv_bind_pattern(pat: i64, scope: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> scope_push(scope, node_f1(pat), node_f2(pat), 0)
    20 -> {
      let b_ns = node_f3(pat)
      let b_nl = node_f4(pat)
      if b_nl > 0 {
        scope_push(scope, b_ns, b_nl, 0)
      } else { if b_nl < 0 {
        let bindings = b_ns
        let nb = 0 - b_nl
        let mut result = scope
        for i in 0..nb {
          let b = nlist_get(bindings, i)
          if node_tag(b) == 18 {
            result = scope_push(result, node_f1(b), node_f2(b), 0)
          } else { result = result }
        }
        result
      } else { scope } }
    }
    _ -> scope
  }
}

fn ffv_bind_params(params: i64, nparams: i64, scope: i64) -> i64 {
  let mut result = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    result = scope_push(result, node_f1(p), node_f2(p), 0)
  }
  result
}

-- Walk AST using a worklist (iterative, avoids stack overflow)
fn find_free_vars(node: i64, ls: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  let work = nlist_new()
  let scopes = nlist_new()
  ffv_push(work, scopes, node, ls)
  let mut wi = 0
  while wi < nlist_len(work) {
    let n = nlist_get(work, wi)
    let local_scope = nlist_get(scopes, wi)
    wi = wi + 1
    if n == 0 { 0 }
    else {
      let tag = node_tag(n)
      if tag == 2 { ffv_add_ident(n, local_scope, enclosing_scope, src, fv) }
      else { if tag == 3 { ffv_push(work, scopes, node_f2(n), local_scope) ffv_push(work, scopes, node_f3(n), local_scope) }
      else { if tag == 4 { ffv_add_name(node_f1(n), node_f2(n), local_scope, enclosing_scope, src, fv) ffv_push_list(work, scopes, node_f3(n), node_f4(n), local_scope) }
      else { if tag == 5 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push(work, scopes, node_f2(n), local_scope) ffv_push(work, scopes, node_f3(n), local_scope) }
      else { if tag == 6 {
        ffv_push(work, scopes, node_f3(n), local_scope)
        ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
      }
      else { if tag == 7 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push(work, scopes, node_f2(n), local_scope) }
      else { if tag == 10 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push(work, scopes, node_f2(n), local_scope) }
      else { if tag == 11 {
        ffv_push(work, scopes, node_f3(n), local_scope)
        ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
      }
      else { if tag == 12 { ffv_add_name(node_f1(n), node_f2(n), local_scope, enclosing_scope, src, fv) ffv_push(work, scopes, node_f3(n), local_scope) }
      else { if tag == 15 {
        ffv_push(work, scopes, node_f1(n), local_scope)
        let arms = node_f2(n)
        let narms = node_f3(n)
        for mi in 0..narms {
          let arm = nlist_get(arms, mi)
          let arm_scope = ffv_bind_pattern(node_f1(arm), local_scope, src)
          ffv_push(work, scopes, node_f2(arm), arm_scope)
        }
      }
      else { if tag == 22 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 25 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 29 {
        let nested_scope = ffv_bind_params(node_f1(n), node_f3(n), local_scope)
        ffv_push(work, scopes, node_f2(n), nested_scope)
      }
      else { if tag == 32 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push_list(work, scopes, node_f4(n), nlist_len(node_f4(n)), local_scope) }
      else { if tag == 36 {
        let inner_call = node_f2(n)
        ffv_add_name(node_f1(inner_call), node_f2(inner_call), local_scope, enclosing_scope, src, fv)
        ffv_push_list(work, scopes, node_f3(inner_call), node_f4(inner_call), local_scope)
      }
      else { if tag == 41 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push_list(work, scopes, node_f3(n), nlist_len(node_f3(n)), local_scope) }
      else { if tag == 45 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 46 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push(work, scopes, node_f2(n), local_scope) }
      else { if tag == 47 {
        ffv_push(work, scopes, node_f3(n), local_scope)
        ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
      }
      else { if tag == 48 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 49 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 52 { ffv_push(work, scopes, node_f1(n), local_scope) ffv_push(work, scopes, node_f2(n), local_scope) }
      else { if tag == 33 {
        ffv_push(work, scopes, node_f1(n), local_scope)
        let clauses = node_f2(n)
        let nclauses = node_f3(n)
        for ci in 0..nclauses {
          let clause = nlist_get(clauses, ci)
          let clause_scope = ffv_bind_params(node_f2(clause), nlist_len(node_f2(clause)), local_scope)
          ffv_push(work, scopes, node_f3(clause), clause_scope)
        }
      }
      else { if tag == 35 { ffv_push(work, scopes, node_f1(n), local_scope) }
      else { if tag == 37 {
        let inner = node_f1(n)
        ffv_push(work, scopes, node_f3(inner), local_scope)
        ffv_push(work, scopes, node_f4(inner), scope_push(local_scope, node_f1(inner), node_f2(inner), 0))
      }
      else { 0 } } } } } } } } } } } } } } } } } } } } } } } } } } }
    }
  }
  0
}

-- ======================================================================
-- Lambda codegen
-- ======================================================================
fn cg_lambda(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  -- Build lambda scope with just the params (for free var analysis)
  let mut lambda_scope = scope_new()
  for pi in 0..nparams {
    let p = nlist_get(params, pi)
    lambda_scope = scope_push(lambda_scope, node_f1(p), node_f2(p), pi + 1)
  }
  -- Find free variables
  let free_vars = nlist_new()
  find_free_vars(body, lambda_scope, scope, src, free_vars)
  let nfree = nlist_len(free_vars)
  let lambda_evidence_info = cg_effect_evidence_info_for_lambda(node, fm, src)
  let lambda_evidence_slots = if lambda_evidence_info == 0 { 0 } else { 1 }
  -- Emit B to skip over lambda body
  let skip_pos = buf_len(code)
  bu32(code, 0)
  -- Compile lambda body as anonymous function
  let lambda_start = buf_len(code)
  emit_prologue(code)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let old_cleanup_stack = cg_cleanup_stack(fm)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_par_lowering_top = fmap_par_lowering_top(fm)
  let old_handler_inline_top = fmap_handler_inline_top(fm)
  let old_evidence_top = fmap_effect_evidence_top(fm)
  let old_callback_top = fmap_effect_callback_top(fm)
  let old_reuse_token = cg_reuse_token_snapshot(fm)
  __mem_store64(fm + 144, nlist_new())
  __mem_store64(fm + 152, 0)
  cg_reuse_token_clear(fm)
  fmap_set_par_lowering_top(fm, 0)
  fmap_set_handler_inline_top(fm, 0)
  fmap_set_effect_evidence_top(fm, 0)
  fmap_set_effect_callback_top(fm, 0)
  -- Set up scope: load captures from env_ptr (x0), params from x1..xN
  let mut body_scope = scope_new()
  -- Load captures from env (x0)
  let mut body_ctr = nparams
  for ci in 0..nfree {
    let fv = nlist_get(free_vars, ci)
    -- LDR capture from [env + value_offset(ci)] into a register
    let cap_reg = body_ctr + 19
    let cap_off = 8 + ci * 16
    if body_ctr < 8 {
      bu32(code, cg_ldr(cap_reg, 0, cap_off))
    } else {
      bu32(code, cg_ldr(17, 0, cap_off))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  if lambda_evidence_info != 0 {
    let evidence_off = 8 + nfree * 16
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 0, evidence_off))
    } else {
      bu32(code, cg_ldr(17, 0, evidence_off))
      emit_store_reg(code, body_ctr, 17)
    }
    cg_effect_evidence_push_ops(fm, cg_evidence_info_ops(lambda_evidence_info), body_ctr)
    body_ctr = body_ctr + 1
  } else { 0 }
  -- Set up explicit params from x1..xN (shifted by 1 for env_ptr in x0)
  for param_i in 0..nparams {
    let p = nlist_get(params, param_i)
    let src_reg = param_i + 1
    let param_ty = node_f3(p)
    if body_ctr < 8 {
      let dst_reg = reg_phys(body_ctr)
      bu32(code, encode_add_imm(dst_reg, src_reg, 0))
      body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), dst_reg, param_ty)
      cg_cleanup_push_for_ty(fm, param_ty, dst_reg)
    } else {
      emit_store_reg(code, body_ctr, src_reg)
      body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), reg_id(body_ctr), param_ty)
      cg_cleanup_push_for_ty(fm, param_ty, reg_id(body_ctr))
    }
    body_ctr = body_ctr + 1
  }
  -- Compile body
  let lambda_ret_ty = cg_expr_type(body, body_scope, src, fm)
  fmap_set_current_ret_ty(fm, lambda_ret_ty)
  let body_result = cg_expr(body, code, body_scope, src, body_ctr, fm)
  let save_ctr = body_result
  cg_match_store_result(code, save_ctr, body_result)
  if cg_ty_is_managed(lambda_ret_ty) == 1 {
    if cg_expr_is_borrow_for_ty(lambda_ret_ty, body, body_scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, lambda_ret_ty, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, 0)
  cg_cleanup_restore(fm, 0)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  __mem_store64(fm + 144, old_cleanup_stack)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_par_lowering_top(fm, old_par_lowering_top)
  fmap_set_handler_inline_top(fm, old_handler_inline_top)
  fmap_set_effect_evidence_top(fm, old_evidence_top)
  fmap_set_effect_callback_top(fm, old_callback_top)
  cg_reuse_token_restore(fm, old_reuse_token)
  -- Patch B skip
  let after_lambda = buf_len(code)
  cg_patch_b(code, skip_pos, after_lambda)
  -- Now at the closure creation site:
  -- 1. Allocate managed closure pair: [fn_ptr, env_ptr]
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
  let closure_rid = reg_id(ctr)
  let closure_phys1 = emit_load_reg(code, ctr)
  -- 2. Compute fn_ptr via ADR (PC-relative, ASLR-safe)
  let adr_pos = buf_len(code)
  let adr_off = lambda_start - adr_pos
  bu32(code, encode_adr(17, adr_off))
  bu32(code, cg_str(17, closure_phys1, 0))
  -- 3. Build managed environment (if captures)
  let env_slots = nfree + lambda_evidence_slots
  if env_slots > 0 {
    let env_size = 8 + env_slots * 16
    emit_mov_imm(code, 0, env_size)
    emit_mov_imm(code, 1, 8)
    cg_emit_call_lit(code, fm, "rc_default_alloc")
    let env_ctr = ctr + 1
    if env_ctr < 8 {
      bu32(code, encode_add_imm(env_ctr + 19, 0, 0))
    } else {
      emit_store_reg(code, env_ctr, 0)
    }
    let env_phys0 = emit_load_reg(code, env_ctr)
    emit_mov_imm(code, 9, env_slots)
    bu32(code, cg_str(9, env_phys0, 0))
    -- Store captures plus a per-slot rc marker for env destruction.
    for ei in 0..nfree {
      let fv = nlist_get(free_vars, ei)
      -- Load captured value from ENCLOSING scope
      let enc_reg = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
      let enc_phys = if enc_reg < 0 {
        let slot = 0 - enc_reg - 1
        bu32(code, cg_ldr(9, 31, slot * 8))
        9
      } else { enc_reg }
      let env_phys = emit_load_reg(code, env_ctr)
      let val_off = 8 + ei * 16
      let flag_off = 16 + ei * 16
      bu32(code, cg_str(enc_phys, env_phys, val_off))
      let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
      if cg_ty_is_rc(cap_ty) == 1 {
        cg_emit_rc_retain_phys(code, fm, enc_phys)
        let env_phys2 = emit_load_reg(code, env_ctr)
        emit_mov_imm(code, 9, 1)
        bu32(code, cg_str(9, env_phys2, flag_off))
      } else {
        if cg_ty_is_closure(cap_ty) == 1 {
          cg_emit_closure_retain_phys(code, fm, enc_phys)
          let env_phys3 = emit_load_reg(code, env_ctr)
          emit_mov_imm(code, 9, 2)
          bu32(code, cg_str(9, env_phys3, flag_off))
        } else {
          let env_phys4 = emit_load_reg(code, env_ctr)
          emit_mov_imm(code, 9, 0)
          bu32(code, cg_str(9, env_phys4, flag_off))
        }
      }
    }
    if lambda_evidence_info != 0 {
      let evidence_val_off = 8 + nfree * 16
      let evidence_flag_off = 16 + nfree * 16
      cg_emit_active_evidence_base_value(code, fm, src, lambda_evidence_info, 9)
      let env_phys_evidence = emit_load_reg(code, env_ctr)
      bu32(code, cg_str(9, env_phys_evidence, evidence_val_off))
      let env_phys_evidence_flag = emit_load_reg(code, env_ctr)
      emit_mov_imm(code, 9, 0)
      bu32(code, cg_str(9, env_phys_evidence_flag, evidence_flag_off))
    } else { 0 }
    -- Store env_ptr at [closure, 8]
    let closure_phys2 = if closure_rid < 0 {
      let slot2 = 0 - closure_rid - 1
      bu32(code, cg_ldr(16, 31, slot2 * 8))
      16
    } else { closure_rid }
    let env_phys4 = emit_load_rhs(code, env_ctr)
    bu32(code, cg_str(env_phys4, closure_phys2, 8))
  } else {
    -- No captures: store 0 as env_ptr
    let closure_phys3 = if closure_rid < 0 {
      let slot3 = 0 - closure_rid - 1
      bu32(code, cg_ldr(16, 31, slot3 * 8))
      16
    } else { closure_rid }
    emit_mov_imm(code, 17, 0)
    bu32(code, cg_str(17, closure_phys3, 8))
  }
  ctr + 1
}

-- ======================================================================
-- Effect handler codegen (Tier 2: tail-resumptive)
-- Per brief: resume in tail position = return from closure.
-- Handler clauses compiled as closures. State mutation via heap cells.
-- ======================================================================

-- Resume: evaluate value and return it (Tier 2 only — tail-resumptive)
fn cg_continuation_reg() -> i64 { 0 - 7777 }

fn cg_is_continuation_reg(reg: i64) -> i64 {
  reg == cg_continuation_reg()
}

fn cg_resume(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let val = node_f1(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  let result_phys = emit_load_reg(code, c1 - 1)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  ctr + 1
}

fn cg_call_continuation(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let c1 = if nargs == 0 { ctr } else { cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm) }
  let token_rid = scope_lookup_type(scope, src, ns, nl)
  if token_rid == 0 {
    bu32(code, encode_brk(3))
  } else {
    let token_phys = emit_load_reg_id(code, token_rid, 16)
    bu32(code, encode_add_imm(0, token_phys, 0))
    cg_emit_call_lit(code, fm, "continuation_resume_managed")
    let cbz_pos = buf_len(code)
    bu32(code, 0)
    let jump_ok_pos = buf_len(code)
    bu32(code, 0)
    let trap = buf_len(code)
    bu32(code, encode_brk(4))
    let ok = buf_len(code)
    cg_patch_cbz(code, cbz_pos, 0, trap)
    cg_patch_b(code, jump_ok_pos, ok)
  }
  if nargs == 0 {
    emit_mov_imm(code, 0, 0)
  } else {
    let result_phys = emit_load_reg(code, c1 - 1)
    bu32(code, encode_add_imm(0, result_phys, 0))
  }
  emit_epilogue(code)
  ctr + 1
}

fn cg_cleanup_kind_for_rid(fm: i64, rid: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let n = nlist_len(stack)
  let mut result = continuation_cleanup_kind_none()
  let mut i = 0
  while i < n {
    let entry = nlist_get(stack, i)
    if node_f1(entry) == rid {
      let kind = cg_cleanup_descriptor_kind(entry)
      if kind != continuation_cleanup_kind_none() {
        result = kind
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn cg_hclause_cleanup_kind_for_free_var(fm: i64, scope: i64, src: i64, fv: i64) -> i64 {
  let rid = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
  if rid == 0 - 999 { continuation_cleanup_kind_none() }
  else { cg_cleanup_kind_for_rid(fm, rid) }
}

fn cg_hclause_managed_free_count(free_vars: i64, nfree: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let mut count = 0
  for i in 0..nfree {
    let fv = nlist_get(free_vars, i)
    if cg_hclause_cleanup_kind_for_free_var(fm, scope, src, fv) != continuation_cleanup_kind_none() {
      count = count + 1
    } else { 0 }
  }
  count
}

fn cg_emit_managed_retain_kind_regid(code: i64, fm: i64, kind: i64, rid: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() {
    cg_emit_rc_retain_regid(code, fm, rid)
  } else { if kind == continuation_cleanup_kind_closure() {
    cg_emit_closure_retain_regid(code, fm, rid)
  } else { 0 } }
}

fn cg_hclause_store_x0(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
}

fn cg_emit_continuation_segment_from_scope(code: i64, fm: i64, scope: i64, src: i64, free_vars: i64, desc_ctr: i64, segment_ctr: i64) -> i64 {
  let nfree = nlist_len(free_vars)
  let count = cg_hclause_managed_free_count(free_vars, nfree, scope, src, fm)
  emit_mov_imm_safe(code, 0, count)
  cg_emit_call_lit(code, fm, "continuation_cleanup_desc_new")
  cg_hclause_store_x0(code, desc_ctr)
  emit_mov_imm_safe(code, 0, count * 8)
  cg_emit_call_lit(code, fm, "alloc_zeroed")
  cg_hclause_store_x0(code, segment_ctr)
  let mut out = 0
  for i in 0..nfree {
    let fv = nlist_get(free_vars, i)
    let kind = cg_hclause_cleanup_kind_for_free_var(fm, scope, src, fv)
    if kind != continuation_cleanup_kind_none() {
      let value_rid = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
      let segment_phys = emit_load_reg(code, segment_ctr)
      let value_phys = emit_load_reg_id(code, value_rid, 17)
      let slot = out * 8
      bu32(code, cg_str(value_phys, segment_phys, slot))
      cg_emit_managed_retain_kind_regid(code, fm, kind, value_rid)
      let desc_phys = emit_load_reg(code, desc_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      emit_mov_imm_safe(code, 1, out)
      emit_mov_imm_safe(code, 2, kind)
      emit_mov_imm_safe(code, 3, slot)
      emit_mov_imm_safe(code, 4, 1)
      cg_emit_call_lit(code, fm, "continuation_cleanup_desc_set")
      out = out + 1
    } else { 0 }
  }
  out
}

fn cg_emit_hclause_continuation_segment(code: i64, fm: i64, body_scope: i64, outer_scope: i64, src: i64, free_vars: i64, desc_ctr: i64, segment_ctr: i64) -> i64 {
  let nfree = nlist_len(free_vars)
  let count = cg_hclause_managed_free_count(free_vars, nfree, outer_scope, src, fm)
  emit_mov_imm_safe(code, 0, count)
  cg_emit_call_lit(code, fm, "continuation_cleanup_desc_new")
  cg_hclause_store_x0(code, desc_ctr)
  emit_mov_imm_safe(code, 0, count * 8)
  cg_emit_call_lit(code, fm, "alloc_zeroed")
  cg_hclause_store_x0(code, segment_ctr)
  let mut out = 0
  for i in 0..nfree {
    let fv = nlist_get(free_vars, i)
    let kind = cg_hclause_cleanup_kind_for_free_var(fm, outer_scope, src, fv)
    if kind != continuation_cleanup_kind_none() {
      let value_rid = scope_lookup(body_scope, src, node_f1(fv), node_f2(fv))
      let segment_phys = emit_load_reg(code, segment_ctr)
      let value_phys = emit_load_reg_id(code, value_rid, 17)
      let slot = out * 8
      bu32(code, cg_str(value_phys, segment_phys, slot))
      cg_emit_managed_retain_kind_regid(code, fm, kind, value_rid)
      let desc_phys = emit_load_reg(code, desc_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      emit_mov_imm_safe(code, 1, out)
      emit_mov_imm_safe(code, 2, kind)
      emit_mov_imm_safe(code, 3, slot)
      emit_mov_imm_safe(code, 4, 1)
      cg_emit_call_lit(code, fm, "continuation_cleanup_desc_set")
      out = out + 1
    } else { 0 }
  }
  out
}

-- Compile a handler clause body as a closure function
-- Returns info pointer: [clause_start(8), free_vars_ptr(8), nfree(8)]
fn cg_hclause_body(clause: i64, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  -- Clause layout: f1=name_info, f2=params, f3=body, f4=continuation name or 0
  let params = node_f2(clause)
  let cbody = node_f3(clause)
  let cont = node_f4(clause)
  let nparams = nlist_len(params)
  -- Free variable analysis (clause params form the lambda scope)
  let mut lambda_scope = scope_new()
  for pi in 0..nparams {
    let p = nlist_get(params, pi)
    lambda_scope = scope_push(lambda_scope, node_f1(p), node_f2(p), pi + 1)
  }
  if cont != 0 {
    lambda_scope = scope_push(lambda_scope, node_f1(cont), node_f2(cont), cg_continuation_reg())
  } else { lambda_scope = lambda_scope }
  let free_vars = nlist_new()
  find_free_vars(cbody, lambda_scope, scope, src, free_vars)
  let nfree = nlist_len(free_vars)
  -- B to skip over clause body
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let clause_start = buf_len(code)
  emit_prologue(code)
  -- Load captures from x0 (env_ptr)
  let mut body_scope = scope_new()
  let mut body_ctr = nparams
  for bi in 0..nfree {
    let fv = nlist_get(free_vars, bi)
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 0, bi * 8))
    } else {
      bu32(code, cg_ldr(17, 0, bi * 8))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  -- Load params from x1..xN (operation arguments)
  for param_i in 0..nparams {
    let p = nlist_get(params, param_i)
    let s_reg = param_i + 1
    if body_ctr < 8 {
      let dst = reg_phys(body_ctr)
      bu32(code, encode_add_imm(dst, s_reg, 0))
      body_scope = scope_push(body_scope, node_f1(p), node_f2(p), dst)
    } else {
      emit_store_reg(code, body_ctr, s_reg)
      body_scope = scope_push(body_scope, node_f1(p), node_f2(p), reg_id(body_ctr))
    }
    body_ctr = body_ctr + 1
  }
  if cont != 0 {
    let desc_count = cg_hclause_managed_free_count(free_vars, nfree, scope, src, fm)
    if desc_count > 0 {
      cg_emit_hclause_continuation_segment(code, fm, body_scope, scope, src, free_vars, body_ctr, body_ctr + 1)
      let desc_phys = emit_load_reg(code, body_ctr)
      bu32(code, encode_add_imm(0, desc_phys, 0))
      cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
      if body_ctr < 8 {
        bu32(code, encode_add_imm(body_ctr + 19, 0, 0))
      } else {
        emit_store_reg(code, body_ctr, 0)
      }
      let token_phys = emit_load_reg(code, body_ctr)
      bu32(code, encode_add_imm(0, token_phys, 0))
      let segment_phys = emit_load_reg(code, body_ctr + 1)
      bu32(code, encode_add_imm(1, segment_phys, 0))
      emit_mov_imm(code, 2, 0)
      emit_mov_imm(code, 3, 0)
      cg_emit_call_lit(code, fm, "continuation_set_segment")
      body_scope = scope_push_typed(body_scope, node_f1(cont), node_f2(cont), cg_continuation_reg(), reg_id(body_ctr))
      body_ctr = body_ctr + 2
    } else {
      cg_emit_call_lit(code, fm, "continuation_new_noop")
      if body_ctr < 8 {
        bu32(code, encode_add_imm(body_ctr + 19, 0, 0))
      } else {
        emit_store_reg(code, body_ctr, 0)
      }
      body_scope = scope_push_typed(body_scope, node_f1(cont), node_f2(cont), cg_continuation_reg(), reg_id(body_ctr))
      body_ctr = body_ctr + 1
    }
  } else { body_scope = body_scope }
  -- Compile clause body (resume compiles as return)
  let br = cg_expr(cbody, code, body_scope, src, body_ctr, fm)
  if cont != 0 {
    let token_rid = scope_lookup_type(body_scope, src, node_f1(cont), node_f2(cont))
    if token_rid != 0 {
      let token_phys = emit_load_reg_id(code, token_rid, 16)
      bu32(code, encode_add_imm(0, token_phys, 0))
      cg_emit_call_lit(code, fm, "continuation_drop_managed")
    } else { 0 }
  } else { 0 }
  let rp = emit_load_reg(code, br - 1)
  bu32(code, encode_add_imm(0, rp, 0))
  emit_epilogue(code)
  cg_patch_b(code, skip_pos, buf_len(code))
  -- Return info struct
  let info = alloc_bump(24)
  __mem_store64(info, clause_start)
  __mem_store64(info + 8, free_vars)
  __mem_store64(info + 16, nfree)
  info
}

fn cg_hclause_body_split(clause: i64, code: i64, scope: i64, src: i64, fm: i64, cont_ty: i64) -> i64 {
  let params = node_f2(clause)
  let cbody = node_f3(clause)
  let cont = node_f4(clause)
  let nparams = nlist_len(params)
  let mut lambda_scope = scope_new()
  for pi in 0..nparams {
    let p = nlist_get(params, pi)
    lambda_scope = scope_push(lambda_scope, node_f1(p), node_f2(p), pi + 1)
  }
  if cont != 0 {
    lambda_scope = scope_push(lambda_scope, node_f1(cont), node_f2(cont), nparams + 1)
  } else { lambda_scope = lambda_scope }
  let free_vars = nlist_new()
  find_free_vars(cbody, lambda_scope, scope, src, free_vars)
  let nfree = nlist_len(free_vars)
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let clause_start = buf_len(code)
  emit_prologue(code)
  let mut body_scope = scope_new()
  let mut body_ctr = nparams
  for bi in 0..nfree {
    let fv = nlist_get(free_vars, bi)
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 0, bi * 8))
    } else {
      bu32(code, cg_ldr(17, 0, bi * 8))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  for param_i in 0..nparams {
    let p = nlist_get(params, param_i)
    let s_reg = param_i + 1
    if body_ctr < 8 {
      let dst = reg_phys(body_ctr)
      bu32(code, encode_add_imm(dst, s_reg, 0))
      body_scope = scope_push(body_scope, node_f1(p), node_f2(p), dst)
    } else {
      emit_store_reg(code, body_ctr, s_reg)
      body_scope = scope_push(body_scope, node_f1(p), node_f2(p), reg_id(body_ctr))
    }
    body_ctr = body_ctr + 1
  }
  if cont != 0 {
    let hidden_reg = nparams + 1
    let cont_rid = reg_id(body_ctr)
    if body_ctr < 8 {
      let dst2 = reg_phys(body_ctr)
      bu32(code, encode_add_imm(dst2, hidden_reg, 0))
      body_scope = scope_push_typed(body_scope, node_f1(cont), node_f2(cont), dst2, cont_ty)
    } else {
      emit_store_reg(code, body_ctr, hidden_reg)
      body_scope = scope_push_typed(body_scope, node_f1(cont), node_f2(cont), cont_rid, cont_ty)
    }
    body_ctr = body_ctr + 1
  } else { body_scope = body_scope }
  let br = cg_expr(cbody, code, body_scope, src, body_ctr, fm)
  if cont != 0 {
    let cont_rid2 = scope_lookup(body_scope, src, node_f1(cont), node_f2(cont))
    if cont_rid2 != 0 - 999 {
      cg_emit_closure_release_regid(code, fm, cont_rid2)
    } else { 0 }
  } else { 0 }
  let rp = emit_load_reg(code, br - 1)
  bu32(code, encode_add_imm(0, rp, 0))
  emit_epilogue(code)
  cg_patch_b(code, skip_pos, buf_len(code))
  let info = alloc_bump(24)
  __mem_store64(info, clause_start)
  __mem_store64(info + 8, free_vars)
  __mem_store64(info + 16, nfree)
  info
}

-- Build closure env for a handler clause, store env_ptr in ops array
fn cg_hclause_env(code: i64, scope: i64, src: i64, ops_ctr: i64, ci: i64, fvs: i64, nfree: i64) -> i64 {
  let env_size = nfree * 8
  emit_mov_imm(code, 0, env_size)
  cg_bump_alloc_reg(code, 17, 0)
  -- Store captures into env
  for ei in 0..nfree {
    let fv = nlist_get(fvs, ei)
    let enc_reg = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
    let ep = if enc_reg < 0 {
      let slot = 0 - enc_reg - 1
      bu32(code, cg_ldr(9, 31, slot * 8))
      9
    } else { enc_reg }
    bu32(code, cg_str(ep, 17, ei * 8))
  }
  -- Store env_ptr at ops[ci].env_ptr
  let ops_phys = emit_load_reg(code, ops_ctr)
  bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
  0
}

-- Fill ops array entries for all handler clauses
fn cg_hfill_ops(clauses: i64, n: i64, infos: i64, code: i64, scope: i64, src: i64, ops_ctr: i64) -> i64 {
  for ci in 0..n {
    let clause = nlist_get(clauses, ci)
    let clause_names = node_f1(clause)
    let op_hash = str_hash(src, node_f3(clause_names), node_f4(clause_names))
    let info = __mem_load64(infos + ci * 8)
    let cs = __mem_load64(info)
    let fvs = __mem_load64(info + 8)
    let nfree = __mem_load64(info + 16)
    -- Store op_hash at ops[ci].op_hash
    let ops_phys = emit_load_reg(code, ops_ctr)
    emit_mov_imm_safe(code, 17, op_hash)
    bu32(code, cg_str(17, ops_phys, ci * handler_ops_entry_size() + handler_ops_op_hash_offset()))
    -- Store fn_ptr via ADR at ops[ci].fn_ptr
    let adr_pos = buf_len(code)
    bu32(code, encode_adr(17, cs - adr_pos))
    let ops_p2 = emit_load_reg(code, ops_ctr)
    bu32(code, cg_str(17, ops_p2, ci * handler_ops_entry_size() + handler_ops_fn_ptr_offset()))
    -- Build env and store env_ptr
    if nfree > 0 {
      cg_hclause_env(code, scope, src, ops_ctr, ci, fvs, nfree)
    } else {
      emit_mov_imm(code, 17, 0)
      let ops_p3 = emit_load_reg(code, ops_ctr)
      bu32(code, cg_str(17, ops_p3, ci * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
    }
  }
  0
}

-- Build handler frame [eff_hash, num_ops, ops_ptr, prev] and push onto x27
fn cg_hbuild_frame(code: i64, eff_hash: i64, nclauses: i64, ops_ctr: i64) -> i64 {
  -- Allocate handler frame from bump allocator
  cg_bump_alloc_imm(code, 16, handler_frame_size())
  -- Save frame_ptr to x15 (x16 may be clobbered by emit_load_reg)
  bu32(code, encode_add_imm(15, 16, 0))
  -- Store eff_hash
  emit_mov_imm_safe(code, 17, eff_hash)
  bu32(code, cg_str(17, 15, handler_frame_eff_hash_offset()))
  -- Store num_ops
  emit_mov_imm_safe(code, 17, nclauses)
  bu32(code, cg_str(17, 15, handler_frame_num_ops_offset()))
  -- Store ops_ptr (emit_load_reg may use x16, so we use x15 as frame base)
  let ops_phys = emit_load_reg(code, ops_ctr)
  bu32(code, cg_str(ops_phys, 15, handler_frame_ops_offset()))
  -- Store prev = x27
  bu32(code, cg_str(27, 15, handler_frame_prev_offset()))
  -- Push: x27 = frame_ptr
  bu32(code, encode_add_imm(27, 15, 0))
  0
}

fn cg_clause_matches_perform_node(clause: i64, node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else {
      let names = node_f1(clause)
      if str_hash(src, node_f1(names), node_f2(names)) != str_hash(src, node_f1(lhs), node_f2(lhs)) { 0 }
      else { if str_hash(src, node_f3(names), node_f4(names)) == str_hash(src, node_f2(node), node_f3(node)) { 1 } else { 0 } }
    }
  } }
}

fn cg_split_clause_index_for_target(clauses: i64, nclauses: i64, target: i64, src: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if node_f4(clause) != 0 and cg_clause_matches_perform_node(clause, target, src) == 1 {
      result = i
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn cg_split_info_direct(target: i64) -> i64 {
  node_new(1, target, 0, 0, 0)
}

fn cg_split_info_function(target: i64, call_node: i64, callee_body: i64, callee_params: i64) -> i64 {
  node_new(2, target, call_node, callee_body, callee_params)
}

fn cg_split_info_target(info: i64) -> i64 {
  if info == 0 { 0 } else { node_f1(info) }
}

fn cg_split_info_call_node(info: i64) -> i64 {
  if info == 0 { 0 } else { node_f2(info) }
}

fn cg_split_info_callee_body(info: i64) -> i64 {
  if info == 0 { 0 } else { node_f3(info) }
}

fn cg_split_info_callee_params(info: i64) -> i64 {
  if info == 0 { 0 } else { node_f4(info) }
}

fn cg_clauses_have_continuation(clauses: i64, nclauses: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < nclauses {
    if node_f4(nlist_get(clauses, i)) != 0 {
      result = 1
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn cg_split_pure_context(node: i64) -> i64 {
  if node == 0 { 1 }
  else {
    match node_tag(node) {
      1 -> 1
      2 -> 1
      3 -> cg_split_pure_context(node_f2(node)) and cg_split_pure_context(node_f3(node))
      5 -> cg_split_pure_context(node_f1(node)) and cg_split_pure_context(node_f2(node)) and cg_split_pure_context(node_f3(node))
      24 -> 1
      _ -> 0
    }
  }
}

fn cg_split_args_pure(args: i64, n: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < n {
    if cg_split_pure_context(nlist_get(args, i)) == 0 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

fn cg_split_name_in_params(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_split_expr_refs_only_params(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 1 }
  else {
    match node_tag(node) {
      1 -> 1
      2 -> cg_split_name_in_params(params, src, node_f1(node), node_f2(node))
      3 -> cg_split_expr_refs_only_params(node_f2(node), params, src) and cg_split_expr_refs_only_params(node_f3(node), params, src)
      5 -> cg_split_expr_refs_only_params(node_f1(node), params, src) and cg_split_expr_refs_only_params(node_f2(node), params, src) and cg_split_expr_refs_only_params(node_f3(node), params, src)
      24 -> 1
      _ -> 0
    }
  }
}

fn cg_split_param_type_by_name(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  let n = nlist_len(params)
  while i < n {
    let p = nlist_get(params, i)
    if node_f2(p) == nl and src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
      result = node_f3(p)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn cg_split_expr_refs_managed_param(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      1 -> 0
      2 -> cg_ty_is_managed(cg_split_param_type_by_name(params, src, node_f1(node), node_f2(node)))
      3 -> cg_split_expr_refs_managed_param(node_f2(node), params, src) or cg_split_expr_refs_managed_param(node_f3(node), params, src)
      5 -> cg_split_expr_refs_managed_param(node_f1(node), params, src) or cg_split_expr_refs_managed_param(node_f2(node), params, src) or cg_split_expr_refs_managed_param(node_f3(node), params, src)
      24 -> 0
      _ -> 0
    }
  }
}

fn cg_split_target_args_supported_for_params(target: i64, params: i64, src: i64) -> i64 {
  let args = node_f4(target)
  let n = nlist_len(args)
  let mut ok = 1
  let mut i = 0
  while i < n {
    let arg = nlist_get(args, i)
    if cg_split_pure_context(arg) == 0 or cg_split_expr_refs_only_params(arg, params, src) == 0 or cg_split_expr_refs_managed_param(arg, params, src) == 1 {
      ok = 0
      i = n
    } else { i = i + 1 }
  }
  ok
}

fn cg_split_target_supported(node: i64, target: i64) -> i64 {
  if node == 0 { 0 }
  else { if node == target { 1 }
  else {
    match node_tag(node) {
      3 -> {
        let left = node_f2(node)
        let right = node_f3(node)
        (cg_split_target_supported(left, target) and cg_split_pure_context(right)) or
        (cg_split_target_supported(right, target) and cg_split_pure_context(left))
      }
      6 -> cg_split_target_supported(node_f3(node), target) and cg_split_pure_context(node_f4(node))
      7 -> cg_split_target_supported(node_f1(node), target) and cg_split_pure_context(node_f2(node))
      37 -> cg_split_target_supported(node_f1(node), target)
      _ -> 0
    }
  } }
}

fn cg_split_call_supported(node: i64, call_node: i64) -> i64 {
  if node == 0 { 0 }
  else { if node == call_node { 1 }
  else {
    match node_tag(node) {
      3 -> {
        let left = node_f2(node)
        let right = node_f3(node)
        (cg_split_call_supported(left, call_node) and cg_split_pure_context(right)) or
        (cg_split_call_supported(right, call_node) and cg_split_pure_context(left))
      }
      6 -> cg_split_call_supported(node_f3(node), call_node) and cg_split_pure_context(node_f4(node))
      7 -> cg_split_call_supported(node_f1(node), call_node) and cg_split_pure_context(node_f2(node))
      37 -> cg_split_call_supported(node_f1(node), call_node)
      _ -> 0
    }
  } }
}

fn cg_split_info_supported(body: i64, info: i64) -> i64 {
  if info == 0 { 0 }
  else {
    let target = cg_split_info_target(info)
    if node_tag(info) == 1 {
      cg_split_target_supported(body, target)
    } else { if node_tag(info) == 2 {
      cg_split_call_supported(body, cg_split_info_call_node(info)) and
      cg_split_target_supported(cg_split_info_callee_body(info), target)
    } else { 0 } }
  }
}

fn cg_fiber_count_max(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { if left > right { left } else { right } }
}

fn cg_fiber_count_add(left: i64, right: i64) -> i64 {
  if left < 0 or right < 0 { 0 - 1 }
  else { left + right }
}

fn cg_fiber_count_list(list: i64, n: i64, clause: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let mut count = 0
  for i in 0..n {
    count = cg_fiber_count_add(count, cg_fiber_perform_count(nlist_get(list, i), clause, scope, src, fm))
  }
  count
}

fn cg_fiber_params_unmanaged(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut ok = 1
    let mut i = 0
    while i < nlist_len(params) {
      if cg_ty_is_managed(node_f3(nlist_get(params, i))) == 1 {
        ok = 0
        i = nlist_len(params)
      } else { i = i + 1 }
    }
    ok
  }
}

fn cg_fiber_body_list_has_perform(list: i64, n: i64, clause: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < n {
    if cg_fiber_body_has_perform(nlist_get(list, i), clause, src) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_fiber_body_has_perform(node: i64, clause: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_fiber_body_has_perform(node_f2(node), clause, src) or cg_fiber_body_has_perform(node_f3(node), clause, src)
      4 -> cg_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      5 -> cg_fiber_body_has_perform(node_f1(node), clause, src) or cg_fiber_body_has_perform(node_f2(node), clause, src) or cg_fiber_body_has_perform(node_f3(node), clause, src)
      6 -> cg_fiber_body_has_perform(node_f3(node), clause, src) or cg_fiber_body_has_perform(node_f4(node), clause, src)
      7 -> cg_fiber_body_has_perform(node_f1(node), clause, src) or cg_fiber_body_has_perform(node_f2(node), clause, src)
      11 -> cg_fiber_body_has_perform(node_f3(node), clause, src) or cg_fiber_body_has_perform(node_f4(node), clause, src)
      12 -> cg_fiber_body_has_perform(node_f3(node), clause, src)
      13 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      14 -> cg_fiber_body_list_has_perform(node_f3(node), node_f4(node), clause, src)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut found = cg_fiber_body_has_perform(node_f1(node), clause, src)
        let mut i = 0
        while i < n and found == 0 {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          found = if guard != 0 { cg_fiber_body_has_perform(guard, clause, src) } else { 0 }
          if found == 0 { found = cg_fiber_body_has_perform(node_f2(arm), clause, src) } else { found = found }
          i = i + 1
        }
        found
      }
      22 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      25 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      26 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      32 -> if cg_clause_matches_perform_node(clause, node, src) == 1 { 1 }
        else { cg_fiber_body_list_has_perform(node_f4(node), nlist_len(node_f4(node)), clause, src) }
      35 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      36 -> {
        let call_node = node_f2(node)
        cg_fiber_body_list_has_perform(node_f3(call_node), node_f4(call_node), clause, src)
      }
      37 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      41 -> cg_fiber_body_has_perform(node_f1(node), clause, src) or cg_fiber_body_list_has_perform(node_f3(node), nlist_len(node_f3(node)), clause, src)
      45 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      46 -> cg_fiber_body_has_perform(node_f1(node), clause, src) or cg_fiber_body_has_perform(node_f2(node), clause, src)
      48 -> cg_fiber_body_has_perform(node_f1(node), clause, src)
      52 -> cg_fiber_body_has_perform(node_f1(node), clause, src) or cg_fiber_body_has_perform(node_f2(node), clause, src)
      _ -> 0
    }
  }
}

fn cg_fiber_cont_ref(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 or cont == 0 { 0 }
  else { if node_tag(node) != 2 { 0 }
  else {
    if node_f2(node) != node_f2(cont) { 0 }
    else { src_eq_at(src, node_f1(node), src + node_f1(cont), 0, node_f2(node)) }
  } }
}

fn cg_fiber_call_stores_continuation(node: i64, cont: i64, src: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let stores = src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64") == 1 or
      src_eq(src, node_f1(node), node_f2(node), "continuation_cell_store_i64_raw") == 1
    if stores == 0 { 0 }
    else {
      let args = node_f3(node)
      let nargs = node_f4(node)
      let mut found = 0
      let mut i = 0
      while i < nargs {
        if cg_fiber_cont_ref(nlist_get(args, i), cont, src) == 1 {
          found = 1
          i = nargs
        } else { i = i + 1 }
      }
      found
    }
  }
}

fn cg_fiber_list_stores_continuation(list: i64, n: i64, cont: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < n {
    if cg_fiber_body_stores_continuation(nlist_get(list, i), cont, src) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_fiber_body_stores_continuation(node: i64, cont: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_fiber_body_stores_continuation(node_f2(node), cont, src) or cg_fiber_body_stores_continuation(node_f3(node), cont, src)
      4 -> if cg_fiber_call_stores_continuation(node, cont, src) == 1 { 1 }
        else { cg_fiber_list_stores_continuation(node_f3(node), node_f4(node), cont, src) }
      6 -> cg_fiber_body_stores_continuation(node_f3(node), cont, src) or cg_fiber_body_stores_continuation(node_f4(node), cont, src)
      7 -> cg_fiber_body_stores_continuation(node_f1(node), cont, src) or cg_fiber_body_stores_continuation(node_f2(node), cont, src)
      37 -> cg_fiber_body_stores_continuation(node_f1(node), cont, src)
      _ -> 0
    }
  }
}

fn cg_fiber_clause_stores_continuation(clause: i64, src: i64) -> i64 {
  let cont = node_f4(clause)
  if cont == 0 { 0 } else { cg_fiber_body_stores_continuation(node_f3(clause), cont, src) }
}

fn cg_fiber_direct_call_supported(node: i64, clause: i64, src: i64, fm: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let entry = cg_borrow_entry_for_direct_call(fm, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else {
      let fn_wrap = node_f2(entry)
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      if params == 0 or body == 0 { 0 }
      else { if cg_fiber_clause_stores_continuation(clause, src) == 0 { 0 }
      else { if nlist_len(params) != node_f4(node) { 0 }
      else { if cg_fiber_params_unmanaged(params) == 0 { 0 }
      else { if cg_ty_is_managed(ret_ty) == 1 { 0 }
      else { if cg_fiber_body_has_perform(body, clause, src) == 1 { 1 } else { 0 } } } } } }
    }
  }
}

fn cg_fiber_dynamic_call_supported(node: i64, clause: i64, scope: i64, src: i64) -> i64 {
  0
}

fn cg_fiber_perform_count(node: i64, clause: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_fiber_count_add(cg_fiber_perform_count(node_f2(node), clause, scope, src, fm), cg_fiber_perform_count(node_f3(node), clause, scope, src, fm))
      4 -> {
        let arg_count = cg_fiber_count_list(node_f3(node), node_f4(node), clause, scope, src, fm)
        let direct_count = if cg_fiber_direct_call_supported(node, clause, src, fm) == 1 { 1 } else { 0 }
        let callee_count = if direct_count == 1 { 1 } else { cg_fiber_dynamic_call_supported(node, clause, scope, src) }
        cg_fiber_count_add(arg_count, callee_count)
      }
      5 -> {
        let cond_count = cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
        let then_count = cg_fiber_perform_count(node_f2(node), clause, scope, src, fm)
        let else_count = cg_fiber_perform_count(node_f3(node), clause, scope, src, fm)
        cg_fiber_count_add(cond_count, cg_fiber_count_max(then_count, else_count))
      }
      6 -> cg_fiber_count_add(cg_fiber_perform_count(node_f3(node), clause, scope, src, fm), cg_fiber_perform_count(node_f4(node), clause, scope, src, fm))
      7 -> cg_fiber_count_add(cg_fiber_perform_count(node_f1(node), clause, scope, src, fm), cg_fiber_perform_count(node_f2(node), clause, scope, src, fm))
      10 -> 0 - 1
      11 -> cg_fiber_count_add(cg_fiber_perform_count(node_f3(node), clause, scope, src, fm), cg_fiber_perform_count(node_f4(node), clause, scope, src, fm))
      12 -> cg_fiber_perform_count(node_f3(node), clause, scope, src, fm)
      13 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      14 -> {
        let fields = node_f3(node)
        let nfields = node_f4(node)
        let mut count = 0
        for ri in 0..nfields {
          count = cg_fiber_count_add(count, cg_fiber_perform_count(node_f3(nlist_get(fields, ri)), clause, scope, src, fm))
        }
        count
      }
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut arm_max = 0
        for i in 0..n {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          let guard_count = if guard != 0 { cg_fiber_perform_count(guard, clause, scope, src, fm) } else { 0 }
          let arm_count = cg_fiber_count_add(guard_count, cg_fiber_perform_count(node_f2(arm), clause, scope, src, fm))
          arm_max = cg_fiber_count_max(arm_max, arm_count)
        }
        cg_fiber_count_add(cg_fiber_perform_count(node_f1(node), clause, scope, src, fm), arm_max)
      }
      22 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      25 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      26 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      32 -> if cg_clause_matches_perform_node(clause, node, src) == 1 { 1 }
        else { cg_fiber_count_list(node_f4(node), nlist_len(node_f4(node)), clause, scope, src, fm) }
      33 -> 0 - 1
      35 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      36 -> {
        let call_node = node_f2(node)
        cg_fiber_count_list(node_f3(call_node), node_f4(call_node), clause, scope, src, fm)
      }
      37 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      41 -> cg_fiber_count_add(cg_fiber_perform_count(node_f1(node), clause, scope, src, fm), cg_fiber_count_list(node_f3(node), nlist_len(node_f3(node)), clause, scope, src, fm))
      45 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      46 -> cg_fiber_count_add(cg_fiber_perform_count(node_f1(node), clause, scope, src, fm), cg_fiber_perform_count(node_f2(node), clause, scope, src, fm))
      47 -> 0 - 1
      48 -> cg_fiber_perform_count(node_f1(node), clause, scope, src, fm)
      49 -> 0 - 1
      52 -> cg_fiber_count_add(cg_fiber_perform_count(node_f1(node), clause, scope, src, fm), cg_fiber_perform_count(node_f2(node), clause, scope, src, fm))
      _ -> 0
    }
  }
}

fn cg_handle_deferred_fiber_supported(body: i64, clauses: i64, nclauses: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if nclauses != 1 { 0 }
  else {
    let clause = nlist_get(clauses, 0)
    if node_f4(clause) == 0 { 0 }
    else { if cg_fiber_perform_count(body, clause, scope, src, fm) > 0 { 1 } else { 0 } }
  }
}

fn cg_find_split_target_for_clauses(node: i64, clauses: i64, nclauses: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let idx = cg_split_clause_index_for_target(clauses, nclauses, node, src)
    if idx >= 0 { node }
    else {
      match node_tag(node) {
        3 -> {
          let left = cg_find_split_target_for_clauses(node_f2(node), clauses, nclauses, src)
          if left != 0 { left } else { cg_find_split_target_for_clauses(node_f3(node), clauses, nclauses, src) }
        }
        6 -> cg_find_split_target_for_clauses(node_f3(node), clauses, nclauses, src)
        7 -> cg_find_split_target_for_clauses(node_f1(node), clauses, nclauses, src)
        37 -> cg_find_split_target_for_clauses(node_f1(node), clauses, nclauses, src)
        _ -> 0
      }
    }
  }
}

fn cg_split_direct_call_callee_body(node: i64, src: i64, fm: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let entry = cg_borrow_entry_for_direct_call(fm, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else {
      let fn_wrap = node_f2(entry)
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      if nlist_len(params) != node_f4(node) { 0 }
      else { if cg_split_args_pure(node_f3(node), node_f4(node)) == 0 { 0 }
      else { node_f4(fn_node) } }
    }
  }
}

fn cg_split_direct_call_callee_params(node: i64, src: i64, fm: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let entry = cg_borrow_entry_for_direct_call(fm, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else {
      let fn_wrap = node_f2(entry)
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      if nlist_len(params) != node_f4(node) { 0 }
      else { if cg_split_args_pure(node_f3(node), node_f4(node)) == 0 { 0 }
      else { params } }
    }
  }
}

fn cg_find_split_info_for_clauses(node: i64, clauses: i64, nclauses: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let idx = cg_split_clause_index_for_target(clauses, nclauses, node, src)
    if idx >= 0 { cg_split_info_direct(node) }
    else { if node_tag(node) == 4 {
      let callee_body = cg_split_direct_call_callee_body(node, src, fm)
      if callee_body == 0 { 0 }
      else {
        let callee_params = cg_split_direct_call_callee_params(node, src, fm)
        let target = cg_find_split_target_for_clauses(callee_body, clauses, nclauses, src)
        if target == 0 { 0 }
        else { if cg_split_target_args_supported_for_params(target, callee_params, src) == 0 { 0 }
        else { cg_split_info_function(target, node, callee_body, callee_params) } }
      }
    } else {
      match node_tag(node) {
        3 -> {
          let left = cg_find_split_info_for_clauses(node_f2(node), clauses, nclauses, src, fm)
          if left != 0 { left } else { cg_find_split_info_for_clauses(node_f3(node), clauses, nclauses, src, fm) }
        }
        6 -> cg_find_split_info_for_clauses(node_f3(node), clauses, nclauses, src, fm)
        7 -> cg_find_split_info_for_clauses(node_f1(node), clauses, nclauses, src, fm)
        37 -> cg_find_split_info_for_clauses(node_f1(node), clauses, nclauses, src, fm)
        _ -> 0
      }
    } }
  }
}

fn cg_target_replace_with_ident(target: i64, ns: i64, nl: i64) -> i64 {
  __mem_store64(target, 2)
  __mem_store64(target + 8, ns)
  __mem_store64(target + 16, nl)
  __mem_store64(target + 24, 0)
  __mem_store64(target + 32, 0)
  0
}

fn cg_target_restore(target: i64, tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  __mem_store64(target, tag)
  __mem_store64(target + 8, f1)
  __mem_store64(target + 16, f2)
  __mem_store64(target + 24, f3)
  __mem_store64(target + 32, f4)
  0
}

fn cg_emit_split_token_for_clause(code: i64, fm: i64, scope: i64, src: i64, info: i64, token_ctr: i64) -> i64 {
  let fvs = __mem_load64(info + 8)
  let nfree = __mem_load64(info + 16)
  let desc_count = cg_hclause_managed_free_count(fvs, nfree, scope, src, fm)
  if desc_count > 0 {
    cg_emit_continuation_segment_from_scope(code, fm, scope, src, fvs, token_ctr, token_ctr + 1)
    let desc_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, desc_phys, 0))
    cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
    cg_hclause_store_x0(code, token_ctr)
    let token_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, token_phys, 0))
    let segment_phys = emit_load_reg(code, token_ctr + 1)
    bu32(code, encode_add_imm(1, segment_phys, 0))
    emit_mov_imm(code, 2, 0)
    emit_mov_imm(code, 3, 0)
    cg_emit_call_lit(code, fm, "continuation_set_segment")
    token_ctr + 2
  } else {
    cg_emit_call_lit(code, fm, "continuation_new_noop")
    cg_hclause_store_x0(code, token_ctr)
    token_ctr + 1
  }
}

fn cg_split_push_param_scope(scope: i64, params: i64, results: i64, nparams: i64, src: i64) -> i64 {
  let mut result = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let rid = __mem_load64(results + i * 8)
    result = scope_push_typed(result, node_f1(p), node_f2(p), reg_id(rid), node_f3(p))
  }
  result
}

fn cg_split_free_vars_contains(free_vars: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  let n = nlist_len(free_vars)
  while i < n {
    let fv = nlist_get(free_vars, i)
    if node_f2(fv) == nl and src_eq_at(src, ns, src + node_f1(fv), 0, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_split_add_managed_params_to_free_vars(free_vars: i64, params: i64, src: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      if cg_ty_is_managed(node_f3(p)) == 1 {
        if cg_split_free_vars_contains(free_vars, src, node_f1(p), node_f2(p)) == 0 {
          nlist_add(free_vars, node_new(2, node_f1(p), node_f2(p), 0, 0))
        } else { 0 }
      } else { 0 }
    }
    0
  }
}

fn cg_split_owned_param_kind(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if params == 0 { continuation_cleanup_kind_none() }
  else {
    let ty = cg_split_param_type_by_name(params, src, ns, nl)
    cg_cleanup_kind_for_ty(ty)
  }
}

fn cg_split_free_var_owned_param_kind(params: i64, src: i64, fv: i64) -> i64 {
  cg_split_owned_param_kind(params, src, node_f1(fv), node_f2(fv))
}

fn cg_split_non_owned_free_vars(free_vars: i64, params: i64, src: i64) -> i64 {
  let result = nlist_new()
  let n = nlist_len(free_vars)
  for i in 0..n {
    let fv = nlist_get(free_vars, i)
    if cg_split_free_var_owned_param_kind(params, src, fv) == continuation_cleanup_kind_none() {
      nlist_add(result, fv)
    } else { 0 }
  }
  result
}

fn cg_split_release_managed_params_from_scope(code: i64, fm: i64, scope: i64, params: i64, src: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      let ty = node_f3(p)
      if cg_ty_is_managed(ty) == 1 {
        let rid = scope_lookup(scope, src, node_f1(p), node_f2(p))
        if rid != 0 - 999 { cg_emit_managed_release_regid(code, fm, ty, rid) } else { 0 }
      } else { 0 }
    }
    0
  }
}

fn cg_split_k_free_vars(ctx: i64, scope: i64, src: i64) -> i64 {
  let body = node_f1(ctx)
  let split_info = node_f2(ctx)
  let target = cg_split_info_target(split_info)
  let call_node = cg_split_info_call_node(split_info)
  let callee_body = cg_split_info_callee_body(split_info)
  let callee_params = cg_split_info_callee_params(split_info)
  let cont = node_f3(ctx)
  let old_tag = node_tag(target)
  let old_f1 = node_f1(target)
  let old_f2 = node_f2(target)
  let old_f3 = node_f3(target)
  let old_f4 = node_f4(target)
  cg_target_replace_with_ident(target, node_f1(cont), node_f2(cont))
  let old_call_tag = if call_node == 0 { 0 } else { node_tag(call_node) }
  let old_call_f1 = if call_node == 0 { 0 } else { node_f1(call_node) }
  let old_call_f2 = if call_node == 0 { 0 } else { node_f2(call_node) }
  let old_call_f3 = if call_node == 0 { 0 } else { node_f3(call_node) }
  let old_call_f4 = if call_node == 0 { 0 } else { node_f4(call_node) }
  if call_node != 0 {
    cg_target_restore(call_node, node_tag(callee_body), node_f1(callee_body), node_f2(callee_body), node_f3(callee_body), node_f4(callee_body))
  } else { 0 }
  let mut lambda_scope = scope_new()
  lambda_scope = scope_push(lambda_scope, node_f1(cont), node_f2(cont), 0)
  let free_vars = nlist_new()
  find_free_vars(body, lambda_scope, scope, src, free_vars)
  cg_split_add_managed_params_to_free_vars(free_vars, callee_params, src)
  if call_node != 0 {
    cg_target_restore(call_node, old_call_tag, old_call_f1, old_call_f2, old_call_f3, old_call_f4)
  } else { 0 }
  cg_target_restore(target, old_tag, old_f1, old_f2, old_f3, old_f4)
  free_vars
}

fn cg_emit_split_token_for_free_vars(code: i64, fm: i64, scope: i64, src: i64, free_vars: i64, token_ctr: i64) -> i64 {
  let desc_count = cg_hclause_managed_free_count(free_vars, nlist_len(free_vars), scope, src, fm)
  if desc_count > 0 {
    cg_emit_continuation_segment_from_scope(code, fm, scope, src, free_vars, token_ctr, token_ctr + 1)
    let desc_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, desc_phys, 0))
    cg_emit_call_lit(code, fm, "continuation_new_with_cleanup_desc")
    cg_hclause_store_x0(code, token_ctr)
    let token_phys = emit_load_reg(code, token_ctr)
    bu32(code, encode_add_imm(0, token_phys, 0))
    let segment_phys = emit_load_reg(code, token_ctr + 1)
    bu32(code, encode_add_imm(1, segment_phys, 0))
    emit_mov_imm(code, 2, 0)
    emit_mov_imm(code, 3, 0)
    cg_emit_call_lit(code, fm, "continuation_set_segment")
    token_ctr + 2
  } else {
    cg_emit_call_lit(code, fm, "continuation_new_noop")
    cg_hclause_store_x0(code, token_ctr)
    token_ctr + 1
  }
}

fn cg_split_clear_owned_param_env_kinds(code: i64, free_vars: i64, nfree: i64, params: i64, src: i64) -> i64 {
  for ci in 0..nfree {
    let fv = nlist_get(free_vars, ci)
    if cg_split_free_var_owned_param_kind(params, src, fv) != continuation_cleanup_kind_none() {
      emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
      bu32(code, cg_str(17, 20, 16 + (ci + 1) * 16))
    } else { 0 }
  }
  0
}

fn cg_emit_split_k_closure(ctx: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let body = node_f1(ctx)
  let split_info = node_f2(ctx)
  let target = cg_split_info_target(split_info)
  let call_node = cg_split_info_call_node(split_info)
  let callee_body = cg_split_info_callee_body(split_info)
  let callee_params = cg_split_info_callee_params(split_info)
  let cont = node_f3(ctx)
  let token_ctr = node_f4(ctx)
  let old_tag = node_tag(target)
  let old_f1 = node_f1(target)
  let old_f2 = node_f2(target)
  let old_f3 = node_f3(target)
  let old_f4 = node_f4(target)
  cg_target_replace_with_ident(target, node_f1(cont), node_f2(cont))
  let old_call_tag = if call_node == 0 { 0 } else { node_tag(call_node) }
  let old_call_f1 = if call_node == 0 { 0 } else { node_f1(call_node) }
  let old_call_f2 = if call_node == 0 { 0 } else { node_f2(call_node) }
  let old_call_f3 = if call_node == 0 { 0 } else { node_f3(call_node) }
  let old_call_f4 = if call_node == 0 { 0 } else { node_f4(call_node) }
  if call_node != 0 {
    cg_target_restore(call_node, node_tag(callee_body), node_f1(callee_body), node_f2(callee_body), node_f3(callee_body), node_f4(callee_body))
  } else { 0 }
  let mut lambda_scope = scope_new()
  lambda_scope = scope_push(lambda_scope, node_f1(cont), node_f2(cont), 0)
  let free_vars = nlist_new()
  find_free_vars(body, lambda_scope, scope, src, free_vars)
  cg_split_add_managed_params_to_free_vars(free_vars, callee_params, src)
  let nfree = nlist_len(free_vars)
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let thunk_start = buf_len(code)
  emit_prologue(code)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let old_cleanup_stack = cg_cleanup_stack(fm)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_par_lowering_top = fmap_par_lowering_top(fm)
  __mem_store64(fm + 144, nlist_new())
  __mem_store64(fm + 152, 0)
  fmap_set_par_lowering_top(fm, 0)
  bu32(code, encode_add_imm(19, 1, 0))
  bu32(code, encode_add_imm(20, 0, 0))
  bu32(code, cg_ldr(0, 20, 8))
  cg_emit_call_lit(code, fm, "continuation_resume_managed")
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let jump_ok_pos = buf_len(code)
  bu32(code, 0)
  let trap = buf_len(code)
  bu32(code, encode_brk(4))
  let ok = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 0, trap)
  cg_patch_b(code, jump_ok_pos, ok)
  let mut body_scope = scope_new()
  body_scope = scope_push(body_scope, node_f1(cont), node_f2(cont), 19)
  let mut body_ctr = 2
  for ci in 0..nfree {
    let fv = nlist_get(free_vars, ci)
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 20, 8 + (ci + 1) * 16))
    } else {
      bu32(code, cg_ldr(17, 20, 8 + (ci + 1) * 16))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  let cont_ret_ty = cg_expr_type(body, body_scope, src, fm)
  fmap_set_current_ret_ty(fm, cont_ret_ty)
  let br = cg_expr(body, code, body_scope, src, body_ctr, fm)
  let save_ctr = br
  cg_match_store_result(code, save_ctr, br)
  if cg_ty_is_managed(cont_ret_ty) == 1 {
    if cg_expr_is_borrow_for_ty(cont_ret_ty, body, body_scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, cont_ret_ty, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, 0)
  cg_cleanup_restore(fm, 0)
  cg_split_release_managed_params_from_scope(code, fm, body_scope, callee_params, src)
  cg_split_clear_owned_param_env_kinds(code, free_vars, nfree, callee_params, src)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  __mem_store64(fm + 144, old_cleanup_stack)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_par_lowering_top(fm, old_par_lowering_top)
  cg_patch_b(code, skip_pos, buf_len(code))
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  cg_hclause_store_x0(code, ctr)
  let closure_phys1 = emit_load_reg(code, ctr)
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(17, thunk_start - adr_pos))
  bu32(code, cg_str(17, closure_phys1, 0))
  emit_mov_imm(code, 0, 8 + (nfree + 1) * 16)
  emit_mov_imm(code, 1, 8)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
  let env_ctr = ctr + 1
  cg_hclause_store_x0(code, env_ctr)
  let env_phys0 = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, nfree + 1)
  bu32(code, cg_str(17, env_phys0, 0))
  let env_phys_token = emit_load_counter_to(code, env_ctr, 9)
  let token_phys = emit_load_counter_to(code, token_ctr, 16)
  bu32(code, cg_str(token_phys, env_phys_token, 8))
  let env_phys_token_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_token_kind, 16))
  for ei in 0..nfree {
    let fv2 = nlist_get(free_vars, ei)
    let enc_reg = scope_lookup(scope, src, node_f1(fv2), node_f2(fv2))
    let ep = if enc_reg < 0 {
      let slot = 0 - enc_reg - 1
      bu32(code, cg_ldr(9, 31, slot * 8))
      9
    } else { enc_reg }
    let env_phys = emit_load_reg(code, env_ctr)
    let entry = ei + 1
    bu32(code, cg_str(ep, env_phys, 8 + entry * 16))
    let env_phys_kind = emit_load_reg(code, env_ctr)
    let owned_kind = cg_split_free_var_owned_param_kind(callee_params, src, fv2)
    emit_mov_imm_safe(code, 17, owned_kind)
    bu32(code, cg_str(17, env_phys_kind, 16 + entry * 16))
  }
  let closure_phys2 = emit_load_counter_to(code, ctr, 9)
  let env_phys2 = emit_load_counter_to(code, env_ctr, 16)
  bu32(code, cg_str(env_phys2, closure_phys2, 8))
  if call_node != 0 {
    cg_target_restore(call_node, old_call_tag, old_call_f1, old_call_f2, old_call_f3, old_call_f4)
  } else { 0 }
  cg_target_restore(target, old_tag, old_f1, old_f2, old_f3, old_f4)
  ctr + 1
}

fn cg_handle_deferred_split(node: i64, split_info: i64, target_index: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let target = cg_split_info_target(split_info)
  let target_lhs = node_f1(target)
  let target_ret_ty = cg_effect_op_ret_type(fmap_get_tt(fm), src, node_f1(target_lhs), node_f2(target_lhs), node_f2(target), node_f3(target))
  let handle_result_ty = cg_expr_type(node_f1(node), scope, src, fm)
  let cont_ty = cg_continuation_fn_type(if target_ret_ty != 0 { target_ret_ty } else { ty_i64() }, handle_result_ty)
  let clauses = node_f2(node)
  let nclauses = node_f3(node)
  let first_names = node_f1(nlist_get(clauses, 0))
  let eff_hash = str_hash(src, node_f1(first_names), node_f2(first_names))
  let clause_infos = alloc_bump(nclauses * 8)
  for ci in 0..nclauses {
    let clause = nlist_get(clauses, ci)
    let info = if ci == target_index { cg_hclause_body_split(clause, code, scope, src, fm, cont_ty) } else { cg_hclause_body(clause, code, scope, src, fm) }
    __mem_store64(clause_infos + ci * 8, info)
  }
  cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 16, 0))
  } else { emit_store_reg(code, ctr, 16) }
  let ops_ctr = ctr
  cg_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
  cg_hbuild_frame(code, eff_hash, nclauses, ops_ctr)
  let frame_ctr = ops_ctr + 1
  if frame_ctr < 8 {
    bu32(code, encode_add_imm(frame_ctr + 19, 27, 0))
  } else { emit_store_reg(code, frame_ctr, 27) }
  let call_node = cg_split_info_call_node(split_info)
  let callee_params = cg_split_info_callee_params(split_info)
  let mut c = frame_ctr + 1
  let mut split_scope = scope
  let mut call_results = 0
  let mut call_nargs = 0
  if call_node != 0 {
    let call_args = node_f3(call_node)
    call_nargs = node_f4(call_node)
    call_results = alloc_bump(call_nargs * 8 + 8)
    c = cg_eval_args_typed_results(call_args, call_nargs, code, scope, src, c, fm, node_new(0, node_new(0, 0, callee_params, 0, 0), call_results, 0, 0))
    split_scope = cg_split_push_param_scope(scope, callee_params, call_results, call_nargs, src)
  } else { 0 }
  let args = node_f4(target)
  let nargs = nlist_len(args)
  let arg_results = alloc_bump(nargs * 8 + 8)
  for ai in 0..nargs {
    c = cg_expr(nlist_get(args, ai), code, split_scope, src, c, fm)
    __mem_store64(arg_results + ai * 8, c - 1)
  }
  let lhs = node_f1(target)
  let op_params = cg_effect_op_params(fmap_get_tt(fm), src, node_f1(lhs), node_f2(lhs), node_f2(target), node_f3(target))
  cg_perform_retain_borrowed_args(args, nargs, op_params, arg_results, code, split_scope, src, fm)
  let target_info = __mem_load64(clause_infos + target_index * 8)
  let token_ctr = c
  let clause = nlist_get(clauses, target_index)
  let cont = node_f4(clause)
  let k_free_vars = cg_split_k_free_vars(node_new(0, node_f1(node), split_info, cont, token_ctr), split_scope, src)
  let token_free_vars = cg_split_non_owned_free_vars(k_free_vars, callee_params, src)
  let after_token = cg_emit_split_token_for_free_vars(code, fm, split_scope, src, token_free_vars, token_ctr)
  let closure_ctr = after_token
  let after_closure = cg_emit_split_k_closure(node_new(0, node_f1(node), split_info, cont, token_ctr), code, split_scope, src, closure_ctr, fm)
  for j in 0..nargs {
    let actr = __mem_load64(arg_results + j * 8)
    let ap = emit_load_reg(code, actr)
    bu32(code, encode_add_imm(j + 1, ap, 0))
  }
  let closure_phys = emit_load_reg(code, closure_ctr)
  bu32(code, encode_add_imm(nargs + 1, closure_phys, 0))
  let ops_phys = emit_load_reg(code, ops_ctr)
  bu32(code, cg_ldr(0, ops_phys, target_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
  let clause_start = __mem_load64(target_info)
  let cur = buf_len(code)
  bu32(code, encode_bl(clause_start - cur))
  cg_hclause_store_x0(code, ctr)
  let token_phys2 = emit_load_reg(code, token_ctr)
  bu32(code, encode_add_imm(0, token_phys2, 0))
  cg_emit_call_lit(code, fm, "continuation_drop_managed")
  let fp = emit_load_reg(code, frame_ctr)
  bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
  ctr + 1
}

fn cg_fiber_body_info(body: i64, code: i64, scope: i64, src: i64, fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let free_vars = nlist_new()
  find_free_vars(body, scope_new(), scope, src, free_vars)
  let nfree = nlist_len(free_vars)
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let body_start = buf_len(code)
  emit_prologue(code)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let old_cleanup_stack = cg_cleanup_stack(fm)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_par_lowering_top = fmap_par_lowering_top(fm)
  __mem_store64(fm + 144, nlist_new())
  __mem_store64(fm + 152, 0)
  fmap_set_par_lowering_top(fm, 0)
  cg_fiber_lowering_push(fm, eff_hash, op_hash)
  let mut body_scope = scope_new()
  let mut body_ctr = 0
  for ci in 0..nfree {
    let fv = nlist_get(free_vars, ci)
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 0, ci * 8))
    } else {
      bu32(code, cg_ldr(17, 0, ci * 8))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  let body_ret_ty = cg_expr_type(body, body_scope, src, fm)
  fmap_set_current_ret_ty(fm, body_ret_ty)
  let br = cg_expr(body, code, body_scope, src, body_ctr, fm)
  let result_phys = emit_load_reg(code, br - 1)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  cg_fiber_lowering_pop(fm)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  __mem_store64(fm + 144, old_cleanup_stack)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_par_lowering_top(fm, old_par_lowering_top)
  cg_patch_b(code, skip_pos, buf_len(code))
  let info = alloc_bump(24)
  __mem_store64(info, body_start)
  __mem_store64(info + 8, free_vars)
  __mem_store64(info + 16, nfree)
  info
}

fn cg_fiber_body_env(code: i64, scope: i64, src: i64, info: i64, ctr: i64) -> i64 {
  let free_vars = __mem_load64(info + 8)
  let nfree = __mem_load64(info + 16)
  if nfree == 0 {
    emit_mov_imm(code, 17, 0)
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
  } else {
    cg_bump_alloc_imm(code, 17, nfree * 8)
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
    for ei in 0..nfree {
      let fv = nlist_get(free_vars, ei)
      let enc_reg = scope_lookup(scope, src, node_f1(fv), node_f2(fv))
      let ep = if enc_reg < 0 {
        let slot = 0 - enc_reg - 1
        bu32(code, cg_ldr(9, 31, slot * 8))
        9
      } else { enc_reg }
      let env_phys = emit_load_reg(code, ctr)
      bu32(code, cg_str(ep, env_phys, ei * 8))
    }
  }
  ctr + 1
}

fn cg_emit_fiber_k_closure(code: i64, fm: i64, prompt_ctr: i64, token_ctr: i64, clause_env_ctr: i64, clause_start: i64, nparams: i64, ctr: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let thunk_start = buf_len(code)
  emit_prologue(code)
  bu32(code, encode_add_imm(19, 1, 0))
  bu32(code, encode_add_imm(20, 0, 0))
  bu32(code, cg_ldr(0, 20, 8))
  cg_emit_call_lit(code, fm, "continuation_resume_managed")
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let jump_ok_pos = buf_len(code)
  bu32(code, 0)
  let trap = buf_len(code)
  bu32(code, encode_brk(4))
  let ok = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 0, trap)
  cg_patch_b(code, jump_ok_pos, ok)
  bu32(code, cg_ldr(0, 20, 24))
  bu32(code, encode_add_imm(1, 19, 0))
  cg_emit_call_lit(code, fm, "fiber_resume")
  bu32(code, encode_add_imm(21, 0, 0))
  cg_emit_call_lit(code, fm, "fiber_is_done")
  let suspended_cbz = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(0, 21, 0))
  emit_epilogue(code)
  let suspended = buf_len(code)
  cg_patch_cbz(code, suspended_cbz, 0, suspended)
  cg_emit_call_lit(code, fm, "continuation_new_noop")
  bu32(code, encode_add_imm(22, 0, 0))
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  bu32(code, encode_add_imm(23, 0, 0))
  let nested_adr_pos = buf_len(code)
  bu32(code, encode_adr(17, thunk_start - nested_adr_pos))
  bu32(code, cg_str(17, 23, 0))
  emit_mov_imm(code, 0, 56)
  emit_mov_imm(code, 1, 8)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
  bu32(code, encode_add_imm(24, 0, 0))
  emit_mov_imm_safe(code, 17, 3)
  bu32(code, cg_str(17, 24, 0))
  bu32(code, cg_str(22, 24, 8))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 16))
  bu32(code, cg_ldr(17, 20, 24))
  bu32(code, cg_str(17, 24, 24))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 32))
  bu32(code, cg_ldr(17, 20, 40))
  bu32(code, cg_str(17, 24, 40))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 48))
  bu32(code, cg_str(24, 23, 8))
  for ai in 0..nparams {
    bu32(code, cg_ldr(ai + 1, 21, 8 + ai * 8))
  }
  bu32(code, encode_add_imm(nparams + 1, 23, 0))
  bu32(code, cg_ldr(0, 20, 40))
  let nested_call = buf_len(code)
  bu32(code, encode_bl(clause_start - nested_call))
  bu32(code, encode_add_imm(19, 0, 0))
  bu32(code, encode_add_imm(0, 22, 0))
  cg_emit_call_lit(code, fm, "continuation_drop_managed")
  bu32(code, encode_add_imm(0, 19, 0))
  emit_epilogue(code)
  cg_patch_b(code, skip_pos, buf_len(code))
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  cg_hclause_store_x0(code, ctr)
  let closure_phys1 = emit_load_reg(code, ctr)
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(17, thunk_start - adr_pos))
  bu32(code, cg_str(17, closure_phys1, 0))
  emit_mov_imm(code, 0, 56)
  emit_mov_imm(code, 1, 8)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
  let env_ctr = ctr + 1
  cg_hclause_store_x0(code, env_ctr)
  let env_phys0 = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, 3)
  bu32(code, cg_str(17, env_phys0, 0))
  let env_phys_token = emit_load_counter_to(code, env_ctr, 9)
  let token_phys = emit_load_counter_to(code, token_ctr, 16)
  bu32(code, cg_str(token_phys, env_phys_token, 8))
  let env_phys_token_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_token_kind, 16))
  let env_phys_prompt = emit_load_counter_to(code, env_ctr, 9)
  let prompt_phys = emit_load_counter_to(code, prompt_ctr, 16)
  bu32(code, cg_str(prompt_phys, env_phys_prompt, 24))
  let env_phys_prompt_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_prompt_kind, 32))
  let clause_env_phys = emit_load_counter_to(code, clause_env_ctr, 16)
  let env_phys3 = emit_load_counter_to(code, env_ctr, 9)
  bu32(code, cg_str(clause_env_phys, env_phys3, 40))
  let env_phys_clause_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_clause_kind, 48))
  let closure_phys2 = emit_load_counter_to(code, ctr, 9)
  let env_phys2 = emit_load_counter_to(code, env_ctr, 16)
  bu32(code, cg_str(env_phys2, closure_phys2, 8))
  ctr + 1
}

fn cg_handle_deferred_fiber(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let body = node_f1(node)
  let clauses = node_f2(node)
  let nclauses = node_f3(node)
  let clause = nlist_get(clauses, 0)
  let first_names = node_f1(clause)
  let eff_hash = str_hash(src, node_f1(first_names), node_f2(first_names))
  let op_hash = str_hash(src, node_f3(first_names), node_f4(first_names))
  let op_ret_ty = cg_effect_op_ret_type(fmap_get_tt(fm), src, node_f1(first_names), node_f2(first_names), node_f3(first_names), node_f4(first_names))
  let handle_result_ty = cg_expr_type(body, scope, src, fm)
  let cont_ty = cg_continuation_fn_type(if op_ret_ty != 0 { op_ret_ty } else { ty_i64() }, handle_result_ty)
  let clause_infos = alloc_bump(nclauses * 8)
  let info = cg_hclause_body_split(clause, code, scope, src, fm, cont_ty)
  __mem_store64(clause_infos, info)
  cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
  if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 16, 0)) }
  else { emit_store_reg(code, ctr, 16) }
  let ops_ctr = ctr
  cg_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
  let body_info = cg_fiber_body_info(body, code, scope, src, fm, eff_hash, op_hash)
  let mut c = ops_ctr + 1
  c = cg_fiber_body_env(code, scope, src, body_info, c)
  let env_ctr = c - 1
  emit_mov_imm_safe(code, 0, 65536)
  cg_emit_call_lit(code, fm, "fiber_segment_new")
  cg_hclause_store_x0(code, c)
  let segment_ctr = c
  let segment_phys = emit_load_reg(code, segment_ctr)
  bu32(code, encode_add_imm(0, segment_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_prompt_new")
  cg_hclause_store_x0(code, c + 1)
  let prompt_ctr = c + 1
  let prompt_phys = emit_load_reg(code, prompt_ctr)
  bu32(code, encode_add_imm(0, prompt_phys, 0))
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(1, __mem_load64(body_info) - adr_pos))
  let env_phys = emit_load_reg(code, env_ctr)
  bu32(code, encode_add_imm(2, env_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_trampoline")
  cg_hclause_store_x0(code, c + 2)
  let result_ctr = c + 2
  cg_emit_call_lit(code, fm, "fiber_is_done")
  let done_ctr = c + 3
  cg_hclause_store_x0(code, done_ctr)
  let done_phys = emit_load_reg(code, done_ctr)
  let suspend_pos = buf_len(code)
  bu32(code, 0)
  let result_phys = emit_load_reg(code, result_ctr)
  if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, result_phys, 0)) }
  else { bu32(code, encode_add_imm(17, result_phys, 0)) emit_store_reg(code, ctr, 17) }
  let after_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_cbz(code, suspend_pos, done_phys, suspended)
  cg_emit_call_lit(code, fm, "continuation_new_noop")
  cg_hclause_store_x0(code, c + 4)
  let token_ctr = c + 4
  let clause_env_ctr = c + 5
  let ops_phys_for_env = emit_load_reg(code, ops_ctr)
  bu32(code, cg_ldr(17, ops_phys_for_env, handler_ops_env_ptr_offset()))
  emit_store_counter_from_phys(code, clause_env_ctr, 17)
  let nparams = nlist_len(node_f2(clause))
  let clause_start = __mem_load64(info)
  let closure_ctr = c + 6
  cg_emit_fiber_k_closure(code, fm, prompt_ctr, token_ctr, clause_env_ctr, clause_start, nparams, closure_ctr)
  let packet_phys = emit_load_reg(code, result_ctr)
  for ai in 0..nparams {
    bu32(code, cg_ldr(ai + 1, packet_phys, 8 + ai * 8))
  }
  let closure_phys = emit_load_reg(code, closure_ctr)
  bu32(code, encode_add_imm(nparams + 1, closure_phys, 0))
  let clause_env_phys = emit_load_reg(code, clause_env_ctr)
  bu32(code, encode_add_imm(0, clause_env_phys, 0))
  let cur = buf_len(code)
  bu32(code, encode_bl(clause_start - cur))
  cg_hclause_store_x0(code, ctr)
  let token_phys2 = emit_load_reg(code, token_ctr)
  bu32(code, encode_add_imm(0, token_phys2, 0))
  cg_emit_call_lit(code, fm, "continuation_drop_managed")
  let after = buf_len(code)
  cg_patch_b(code, after_pos, after)
  fmap_inc_fiber_lowering_count(fm)
  ctr + 1
}

-- Handle expression: compile clauses as closures, build frame, run body, pop
fn cg_handle(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let body = node_f1(node)
  let clauses = node_f2(node)
  let nclauses = node_f3(node)
  let split_info = if cg_clauses_have_continuation(clauses, nclauses) == 1 { cg_find_split_info_for_clauses(body, clauses, nclauses, src, fm) } else { 0 }
  if split_info != 0 and cg_split_info_supported(body, split_info) == 1 {
    cg_handle_deferred_split(node, split_info, cg_split_clause_index_for_target(clauses, nclauses, cg_split_info_target(split_info), src), code, scope, src, ctr, fm)
  } else { if cg_handle_deferred_fiber_supported(body, clauses, nclauses, scope, src, fm) == 1 {
    cg_handle_deferred_fiber(node, code, scope, src, ctr, fm)
  } else {
  -- Extract eff_hash from the first clause's name_info
  let first_names = node_f1(nlist_get(clauses, 0))
  let eff_hash = str_hash(src, node_f1(first_names), node_f2(first_names))
  -- Phase 1: Compile all clause bodies as closures
  let clause_infos = alloc_bump(nclauses * 8)
  for ci in 0..nclauses {
    let info = cg_hclause_body(nlist_get(clauses, ci), code, scope, src, fm)
    __mem_store64(clause_infos + ci * 8, info)
  }
  -- Phase 2: Build ops array at runtime
  cg_bump_alloc_imm(code, 16, nclauses * handler_ops_entry_size())
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 16, 0))
  } else { emit_store_reg(code, ctr, 16) }
  let ops_ctr = ctr
  cg_hfill_ops(clauses, nclauses, clause_infos, code, scope, src, ops_ctr)
  -- Phase 3: Build and push handler frame
  cg_hbuild_frame(code, eff_hash, nclauses, ops_ctr)
  -- Save x27 (= frame_ptr) for later pop
  let frame_ctr = ops_ctr + 1
  if frame_ctr < 8 {
    bu32(code, encode_add_imm(frame_ctr + 19, 27, 0))
  } else { emit_store_reg(code, frame_ctr, 27) }
  -- Phase 4: Push handler inlining context for body compilation.
  cg_handler_inline_push(fm, eff_hash, clauses, clause_infos, nclauses, ops_ctr)
  -- Compile body (handler is now active, performs can be inlined)
  let br = cg_expr(body, code, scope, src, frame_ctr + 1, fm)
  cg_handler_inline_pop(fm)
  -- Phase 5: Pop handler — restore x27 from frame.prev
  let fp = emit_load_reg(code, frame_ctr)
  bu32(code, cg_ldr(27, fp, handler_frame_prev_offset()))
  -- Move body result to ctr
  let bp = emit_load_reg(code, br - 1)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, bp, 0))
  } else {
    bu32(code, encode_add_imm(17, bp, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
  } }
}

-- Emit runtime handler lookup.
-- On exit: x13 = matching ops entry ptr.
fn cg_perform_lookup(code: i64, fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  bu32(code, encode_add_imm(0, 27, 0))
  emit_mov_imm_safe(code, 1, eff_hash)
  emit_mov_imm_safe(code, 2, op_hash)
  cg_emit_call_lit(code, fm, "handler_find_entry")
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let jump_found_pos = buf_len(code)
  bu32(code, 0)
  let trap = buf_len(code)
  bu32(code, encode_brk(2))
  let found = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 0, trap)
  cg_patch_b(code, jump_found_pos, found)
  bu32(code, encode_add_imm(13, 0, 0))
  0
}

fn cg_effect_op_params(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { 0 }
    else {
      let kind = __mem_load64(entry + 16)
      if kind != 2 { 0 }
      else {
        let entry_src = __mem_load64(entry + 48)
        let nops = __mem_load64(entry + 24)
        let ops = __mem_load64(entry + 32)
        let op_hash = str_hash(src, op_ns, op_nl)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          if str_hash(entry_src, node_f1(op), node_f2(op)) == op_hash {
            result = node_f3(op)
            i = nops
          } else {
            i = i + 1
          }
        }
        result
      }
    }
  }
}

fn cg_effect_op_ret_type(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { 0 }
    else {
      let kind = __mem_load64(entry + 16)
      if kind != 2 { 0 }
      else {
        let entry_src = __mem_load64(entry + 48)
        let nops = __mem_load64(entry + 24)
        let ops = __mem_load64(entry + 32)
        let op_hash = str_hash(src, op_ns, op_nl)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          if str_hash(entry_src, node_f1(op), node_f2(op)) == op_hash {
            let meta = node_f4(op)
            result = if meta == 0 { 0 }
              else { if node_tag(meta) == 53 { node_f1(meta) } else { meta } }
            i = nops
          } else {
            i = i + 1
          }
        }
        result
      }
    }
  }
}

fn cg_perform_retain_borrowed_args(args: i64, nargs: i64, params: i64, arg_results: i64, code: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut i = 0
    while i < nargs {
      if i < nlist_len(params) {
        let param_ty = node_f3(nlist_get(params, i))
        let arg = nlist_get(args, i)
        if cg_ty_is_managed(param_ty) == 1 {
          if cg_expr_is_borrow_for_ty(param_ty, arg, scope, src, fm) == 1 {
            cg_emit_managed_retain_regid(code, fm, param_ty, reg_id(__mem_load64(arg_results + i * 8)))
          } else { 0 }
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    0
  }
}

fn cg_perform_is_scoped_alloc(node: i64, src: i64, fm: i64) -> i64 {
  if cg_scoped_alloc_arena_ctr(fm) < 0 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else { if src_eq(src, node_f1(lhs), node_f2(lhs), "Alloc") != 1 { 0 }
    else { if src_eq(src, node_f2(node), node_f3(node), "alloc") == 1 { 1 }
    else { if src_eq(src, node_f2(node), node_f3(node), "free") == 1 { 1 } else { 0 } } } }
  }
}

fn cg_perform_scoped_alloc_zero(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    emit_mov_imm(code, ctr + 19, 0)
  } else {
    emit_mov_imm(code, 17, 0)
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_perform_scoped_alloc(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f4(node)
  let nargs = nlist_len(args)
  if src_eq(src, node_f2(node), node_f3(node), "alloc") == 1 {
    if nargs != 2 { cg_perform_scoped_alloc_zero(code, ctr) }
    else {
      let c = cg_call_args(args, nargs, code, scope, src, ctr, fm, 1)
      let arena_ctr = cg_scoped_alloc_arena_ctr(fm)
      let arena_phys = emit_load_reg(code, arena_ctr)
      bu32(code, encode_add_imm(0, arena_phys, 0))
      cg_emit_call_lit(code, fm, "arena_alloc")
      if c < 8 {
        bu32(code, encode_add_imm(c + 19, 0, 0))
      } else { emit_store_reg(code, c, 0) }
      c + 1
    }
  } else {
    let mut c = ctr
    for i in 0..nargs {
      c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    }
    cg_perform_scoped_alloc_zero(code, c)
  }
}

fn cg_store_x0_result(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
  ctr + 1
}

fn cg_perform_fiber_suspend(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f4(node)
  let nargs = nlist_len(args)
  let arg_results = alloc_bump(nargs * 8 + 8)
  let mut c = ctr
  for i in 0..nargs {
    c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    __mem_store64(arg_results + i * 8, c - 1)
  }
  cg_bump_alloc_imm(code, 17, 8 + nargs * 8)
  let packet_ctr = c
  if packet_ctr < 8 {
    bu32(code, encode_add_imm(packet_ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, packet_ctr, 17)
  }
  let packet_phys0 = emit_load_counter_to(code, packet_ctr, 17)
  emit_mov_imm_safe(code, 16, nargs)
  bu32(code, cg_str(16, packet_phys0, 0))
  for pi in 0..nargs {
    let packet_phys = emit_load_counter_to(code, packet_ctr, 16)
    let arg_phys = emit_load_counter_to(code, __mem_load64(arg_results + pi * 8), 17)
    bu32(code, cg_str(arg_phys, packet_phys, 8 + pi * 8))
  }
  let packet_phys2 = emit_load_counter_to(code, packet_ctr, 16)
  bu32(code, encode_add_imm(0, packet_phys2, 0))
  cg_emit_call_lit(code, fm, "fiber_suspend")
  cg_store_x0_result(code, packet_ctr + 1)
}

fn cg_perform_is_direct_par(node: i64, src: i64, fm: i64) -> i64 {
  if cg_par_lowering_mode(fm) == 0 { 0 } else { cg_par_perform_is_direct(node, src) }
}

fn cg_perform_direct_par(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let mode = cg_par_lowering_mode(fm)
  let args = node_f4(node)
  let nargs = nlist_len(args)
  let lhs = node_f1(node)
  let op_ns = node_f2(node)
  let op_nl = node_f3(node)
  let arg_results = alloc_bump(nargs * 8 + 8)
  let mut c = ctr
  for i in 0..nargs {
    c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    __mem_store64(arg_results + i * 8, c - 1)
  }
  let op_params = cg_effect_op_params(fmap_get_tt(fm), src, node_f1(lhs), node_f2(lhs), op_ns, op_nl)
  cg_perform_retain_borrowed_args(args, nargs, op_params, arg_results, code, scope, src, fm)
  if src_eq(src, op_ns, op_nl, "spawn") == 1 {
    if nargs != 2 {
      emit_mov_imm(code, 0, 0)
      cg_store_x0_result(code, c)
    } else {
      if mode == 1 {
        let f_phys = emit_load_reg(code, __mem_load64(arg_results))
        bu32(code, encode_add_imm(0, f_phys, 0))
        let arg_phys = emit_load_reg(code, __mem_load64(arg_results + 8))
        bu32(code, encode_add_imm(1, arg_phys, 0))
        cg_emit_call_lit(code, fm, "par_sequential_submit")
        cg_store_x0_result(code, c)
      } else {
        let pool_phys = emit_load_reg(code, cg_par_lowering_pool_ctr(fm))
        bu32(code, encode_add_imm(0, pool_phys, 0))
        let f_phys2 = emit_load_reg(code, __mem_load64(arg_results))
        bu32(code, encode_add_imm(1, f_phys2, 0))
        let arg_phys2 = emit_load_reg(code, __mem_load64(arg_results + 8))
        bu32(code, encode_add_imm(2, arg_phys2, 0))
        cg_emit_call_lit(code, fm, "par_pthread_pool_submit")
        cg_store_x0_result(code, c)
      }
    }
  } else {
    if nargs != 1 {
      emit_mov_imm(code, 0, 0)
      cg_store_x0_result(code, c)
    } else {
      if mode == 1 {
        let h_phys = emit_load_reg(code, __mem_load64(arg_results))
        bu32(code, encode_add_imm(0, h_phys, 0))
        cg_emit_call_lit(code, fm, "par_task_await")
        cg_store_x0_result(code, c)
      } else {
        let h_phys2 = emit_load_reg(code, __mem_load64(arg_results))
        bu32(code, encode_add_imm(0, h_phys2, 0))
        cg_emit_call_lit(code, fm, "par_pthread_pool_await")
        cg_store_x0_result(code, c)
      }
    }
  }
}

-- Perform: look up handler, call clause closure
fn cg_perform(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let lhs = node_f1(node)
  let op_ns = node_f2(node)
  let op_nl = node_f3(node)
  let op_hash = str_hash(src, op_ns, op_nl)
  let args = node_f4(node)
  let nargs = nlist_len(args)
  -- Compute eff_hash from lhs identifier
  let eff_hash = str_hash(src, node_f1(lhs), node_f2(lhs))
  if cg_fiber_lowering_matches(fm, eff_hash, op_hash) == 1 {
    cg_perform_fiber_suspend(node, code, scope, src, ctr, fm)
  } else { if cg_perform_is_scoped_alloc(node, src, fm) == 1 {
    cg_perform_scoped_alloc(node, code, scope, src, ctr, fm)
  } else { if cg_perform_is_direct_par(node, src, fm) == 1 {
    cg_perform_direct_par(node, code, scope, src, ctr, fm)
  } else {
  -- Evaluate args into callee-saved registers
  let arg_results = alloc_bump(nargs * 8 + 8)
  let mut c = ctr
  for i in 0..nargs {
    c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    __mem_store64(arg_results + i * 8, c - 1)
  }
  let op_params = cg_effect_op_params(fmap_get_tt(fm), src, node_f1(lhs), node_f2(lhs), op_ns, op_nl)
  cg_perform_retain_borrowed_args(args, nargs, op_params, arg_results, code, scope, src, fm)
  let evidence_ctr = cg_effect_evidence_find(fm, eff_hash, op_hash)
  if evidence_ctr >= 0 {
    let evidence_op_index = cg_effect_evidence_find_op_index(fm, eff_hash, op_hash)
    let base_phys = emit_load_reg(code, evidence_ctr)
    bu32(code, encode_add_imm(13, base_phys, evidence_op_index * handler_ops_entry_size()))
    bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
    bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
    for j in 0..nargs {
      let actr = __mem_load64(arg_results + j * 8)
      let ap = emit_load_reg(code, actr)
      bu32(code, encode_add_imm(j + 1, ap, 0))
    }
    bu32(code, encode_blr(9))
    if c < 8 {
      bu32(code, encode_add_imm(c + 19, 0, 0))
    } else { emit_store_reg(code, c, 0) }
    c + 1
  } else {
  let inline_match = cg_handler_inline_find(fm, src, eff_hash, op_hash)
  if inline_match != 0 {
    -- INLINED PATH: handler is statically known. Captured clauses reuse the
    -- env pointer already stored in the handler ops array.
    let info = __mem_load64(inline_match + cg_handler_inline_match_info_offset())
    let clause_start = __mem_load64(info)
    -- Set up args: x1..xN
    for j in 0..nargs {
      let actr = __mem_load64(arg_results + j * 8)
      let ap = emit_load_reg(code, actr)
      bu32(code, encode_add_imm(j + 1, ap, 0))
    }
    let nfree = __mem_load64(inline_match + cg_handler_inline_match_nfree_offset())
    if nfree == 0 {
      emit_mov_imm(code, 0, 0)
    } else {
      let op_index = __mem_load64(inline_match + cg_handler_inline_match_index_offset())
      let ops_ctr = __mem_load64(inline_match + cg_handler_inline_match_ops_ctr_offset())
      let ops_phys = emit_load_reg(code, ops_ctr)
      bu32(code, cg_ldr(0, ops_phys, op_index * handler_ops_entry_size() + handler_ops_env_ptr_offset()))
    }
    let cur = buf_len(code)
    bu32(code, encode_bl(clause_start - cur))
    -- Result in x0
    if c < 8 {
      bu32(code, encode_add_imm(c + 19, 0, 0))
    } else { emit_store_reg(code, c, 0) }
    c + 1
  } else {
    -- RUNTIME PATH: full handler dispatch via x27 stack
    cg_perform_lookup(code, fm, eff_hash, op_hash)
    bu32(code, cg_ldr(9, 13, handler_ops_fn_ptr_offset()))
    bu32(code, cg_ldr(0, 13, handler_ops_env_ptr_offset()))
    for j in 0..nargs {
      let actr = __mem_load64(arg_results + j * 8)
      let ap = emit_load_reg(code, actr)
      bu32(code, encode_add_imm(j + 1, ap, 0))
    }
    bu32(code, encode_blr(9))
    if c < 8 {
      bu32(code, encode_add_imm(c + 19, 0, 0))
    } else { emit_store_reg(code, c, 0) }
    c + 1
  } } } } }
}

-- Dot-call: disambiguate between effect perform and method call
-- Rule: if LHS is a simple identifier in the current scope, it's a method call
-- on a value. If LHS is NOT in scope, it's an effect perform (effect names
-- are never bound as variables).
fn cg_dot_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let lhs = node_f1(node)
  if node_tag(lhs) == 2 {
    -- Simple identifier: check scope
    let ns = node_f1(lhs)
    let nl = node_f2(lhs)
    let var_reg = scope_lookup(scope, src, ns, nl)
    if var_reg != 0 - 999 {
      -- In scope → method call on a value
      cg_method_call(node, code, scope, src, ctr, fm)
    } else {
      -- Not in scope → effect perform (e.g., Counter.inc())
      cg_perform(node, code, scope, src, ctr, fm)
    }
  } else {
    -- Complex expression (e.g., get_thing().method()) → method call
    cg_method_call(node, code, scope, src, ctr, fm)
  }
}

-- Method call: receiver.method(args)
-- Evaluate receiver as self (x0), then args (x1..xN), BL to method
fn cg_method_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  -- Perform node: f1=lhs, f2=op_ns, f3=op_nl, f4=args
  let lhs = node_f1(node)
  let method_hash = str_hash(src, node_f2(node), node_f3(node))
  let args = node_f4(node)
  let nargs = nlist_len(args)
  -- Evaluate receiver (self) first
  let c1 = cg_expr(lhs, code, scope, src, ctr, fm)
  let self_ctr = c1 - 1
  -- Evaluate remaining args
  let results = alloc_bump((nargs + 1) * 8)
  __mem_store64(results, self_ctr)
  let mut c = c1
  for i in 0..nargs {
    c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    __mem_store64(results + (i + 1) * 8, c - 1)
  }
  -- Move self to x0, args to x1..xN
  for j in 0..nargs + 1 {
    let result_ctr = __mem_load64(results + j * 8)
    let phys = emit_load_reg(code, result_ctr)
    bu32(code, encode_add_imm(j, phys, 0))
  }
  -- Determine receiver type hash and look up method in method map
  let mm = __mem_load64(fm + 72)
  let type_hash = cg_method_receiver_type_hash(lhs, scope, src, fm)
  let type_hash_is_trait = ttable_hash_is_trait(fmap_get_tt(fm), type_hash)
  let mut target = if type_hash == 0 { 0 } else { mmap_lookup(mm, type_hash, method_hash) }
  if target == 0 {
    if type_hash == 0 or type_hash_is_trait == 1 {
      target = mmap_lookup_by_method(mm, method_hash)
    } else { 0 }
  } else { 0 }
  -- Emit BL to target
  let cur = buf_len(code)
  if target == 0 {
    -- Method not found — emit error placeholder
    bu32(code, encode_bl(0))
  } else {
    bu32(code, encode_bl(target - cur))
  }
  -- Result in x0 → move to destination register
  if c < 8 {
    bu32(code, encode_add_imm(c + 19, 0, 0))
  } else { emit_store_reg(code, c, 0) }
  c + 1
}

-- Method call with resolved type_hash (tag 41)
-- f1=receiver, f2=method_hash, f3=args, f4=type_hash
fn cg_method_call_typed(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let lhs = node_f1(node)
  let method_hash = node_f2(node)
  let args = node_f3(node)
  let nargs = nlist_len(args)
  let type_hash = node_f4(node)
  let mm = __mem_load64(fm + 72)
  let mut params = mmap_lookup_params(mm, type_hash, method_hash)
  let type_hash_is_trait = ttable_hash_is_trait(fmap_get_tt(fm), type_hash)
  if params == 0 and type_hash_is_trait == 1 { params = mmap_lookup_params_by_method(mm, method_hash) } else { params = params }
  -- Evaluate receiver (self) first
  let c1 = cg_expr(lhs, code, scope, src, ctr, fm)
  let self_ctr = c1 - 1
  -- Evaluate remaining args
  let results = alloc_bump((nargs + 1) * 8)
  __mem_store64(results, self_ctr)
  let mut c = c1
  for i in 0..nargs {
    c = cg_expr(nlist_get(args, i), code, scope, src, c, fm)
    __mem_store64(results + (i + 1) * 8, c - 1)
  }
  -- Borrowed managed receiver/arguments are retained before the method takes ownership.
  if params != 0 {
    let self_ty = cg_param_ty(params, 0)
    if cg_ty_is_managed(self_ty) == 1 {
      if cg_expr_is_borrow_for_ty(self_ty, lhs, scope, src, fm) == 1 {
        cg_emit_managed_retain_regid(code, fm, self_ty, reg_id(self_ctr))
      } else { 0 }
    } else { 0 }
    for ri in 0..nargs {
      let param_ty = cg_param_ty(params, ri + 1)
      let arg_node = nlist_get(args, ri)
      if cg_ty_is_managed(param_ty) == 1 {
        if cg_expr_is_borrow_for_ty(param_ty, arg_node, scope, src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, param_ty, reg_id(__mem_load64(results + (ri + 1) * 8)))
        } else { 0 }
      } else { 0 }
    }
  } else { 0 }
  -- Move self to x0, args to x1..xN
  for j in 0..nargs + 1 {
    let result_ctr = __mem_load64(results + j * 8)
    let phys = emit_load_reg(code, result_ctr)
    bu32(code, encode_add_imm(j, phys, 0))
  }
  -- Look up method in method map with (type_hash, method_hash)
  let mut target = mmap_lookup(mm, type_hash, method_hash)
  -- Fallback only when type_hash is a trait hash (generic bounded code).
  -- Concrete receiver calls must not silently bind to the first same-named
  -- method from an unrelated impl.
  if target == 0 and type_hash_is_trait == 1 {
    target = mmap_lookup_by_method(mm, method_hash)
  } else { target = target }
  -- Emit BL to target
  let cur = buf_len(code)
  if target == 0 {
    eprint("error: method not found (type_hash=")
    eprint_i(type_hash)
    eprint(", method_hash=")
    eprint_i(method_hash)
    eprint(")\n")
    bu32(code, encode_bl(0))
  } else {
    bu32(code, encode_bl(target - cur))
  }
  -- Result in x0
  if c < 8 {
    bu32(code, encode_add_imm(c + 19, 0, 0))
  } else { emit_store_reg(code, c, 0) }
  c + 1
}

fn cg_not(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let operand = node_f1(node)
  let c1 = cg_expr(operand, code, scope, src, ctr, fm)
  let val_phys = emit_load_reg(code, c1 - 1)
  -- CMP val, #0; CSET rd, EQ (0->1, nonzero->0)
  bu32(code, encode_cmp(val_phys, 31))
  if ctr < 8 {
    bu32(code, encode_cset(ctr + 19, 0))
  } else {
    bu32(code, encode_cset(17, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_int(node: i64, code: i64, ctr: i64) -> i64 {
  let val = node_f1(node)
  if ctr < 8 {
    emit_mov_imm(code, ctr + 19, val)
  } else {
    -- Spill: MOV x17, val then STR to stack
    emit_mov_imm(code, 17, val)
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_f64_literal_parts(src: i64, start: i64, len: i64) -> i64 {
  let mut numer = 0
  let mut denom = 1
  let mut after_dot = false
  let mut i = 0
  while i < len {
    let ch = __mem_load8(src + start + i)
    if ch == 46 {
      after_dot = true
    } else {
      numer = numer * 10 + ch - 48
      if after_dot { denom = denom * 10 } else { denom = denom }
    }
    i = i + 1
  }
  node_new(0, numer, denom, 0, 0)
}

fn cg_node_is_f64_literal(node: i64) -> i64 {
  if node == 0 { 0 } else { if node_tag(node) == 54 { 1 } else { 0 } }
}

fn cg_emit_f64_literal_to_d(node: i64, code: i64, src: i64, fd: i64, fm: i64) -> i64 {
  let parts = cg_f64_literal_parts(src, node_f1(node), node_f2(node))
  let numer = node_f1(parts)
  let denom = node_f2(parts)
  emit_mov_imm_safe(code, 16, numer)
  bu32(code, encode_scvtf_d_from_x(fd, 16))
  if denom != 1 {
    emit_mov_imm_safe(code, 17, denom)
    bu32(code, encode_scvtf_d_from_x(3, 17))
    bu32(code, encode_fdiv_d(fd, fd, 3))
  } else { 0 }
  fmap_inc_f64_literal_direct_count(fm)
}

fn cg_f64_tree_depth(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> if cg_ty_is_f64(cg_expr_type(node, scope, src, fm)) == 1 { 1 } else { 0 }
      54 -> 1
      3 -> {
        let op = node_f1(node)
        if op >= 1 and op <= 4 and cg_binop_uses_f64(node, scope, src, fm) == 1 {
          let lhs_depth = cg_f64_tree_depth(node_f2(node), scope, src, fm)
          let rhs_depth = cg_f64_tree_depth(node_f3(node), scope, src, fm)
          if lhs_depth == 0 or rhs_depth == 0 { 0 }
          else {
            let rhs_slots = rhs_depth + 1
            if lhs_depth > rhs_slots { lhs_depth } else { rhs_slots }
          }
        } else { 0 }
      }
      _ -> 0
    }
  }
}

fn cg_f64_tree_contains_arith(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    if node_tag(node) == 3 and node_f1(node) >= 1 and node_f1(node) <= 4 { 1 }
    else {
      match node_tag(node) {
        3 -> cg_f64_tree_contains_arith(node_f2(node)) or cg_f64_tree_contains_arith(node_f3(node))
        _ -> 0
      }
    }
  }
}

fn cg_f64_tree_emit_op(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  match op {
    1 -> bu32(code, encode_fadd_d(rd, rn, rm))
    2 -> bu32(code, encode_fsub_d(rd, rn, rm))
    3 -> bu32(code, encode_fmul_d(rd, rn, rm))
    4 -> bu32(code, encode_fdiv_d(rd, rn, rm))
    _ -> 0
  }
}

fn cg_emit_f64_tree_to_d(node: i64, code: i64, scope: i64, src: i64, fm: i64, fd: i64) -> i64 {
  match node_tag(node) {
    2 -> {
      let rid = scope_lookup(scope, src, node_f1(node), node_f2(node))
      let phys = emit_load_reg_id(code, rid, 16)
      bu32(code, encode_fmov_d_from_x(fd, phys))
    }
    54 -> cg_emit_f64_literal_to_d(node, code, src, fd, fm)
    3 -> {
      cg_emit_f64_tree_to_d(node_f2(node), code, scope, src, fm, fd)
      cg_emit_f64_tree_to_d(node_f3(node), code, scope, src, fm, fd + 1)
      cg_f64_tree_emit_op(code, node_f1(node), fd, fd, fd + 1)
    }
    _ -> 0
  }
}

fn cg_f64_tree_can_direct(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let depth = cg_f64_tree_depth(node, scope, src, fm)
  if depth > 0 and depth <= 12 { 1 } else { 0 }
}

fn cg_f64(node: i64, code: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let parts = cg_f64_literal_parts(src, node_f1(node), node_f2(node))
  let numer = node_f1(parts)
  let denom = node_f2(parts)
  if numer == 0 {
    emit_mov_imm_safe(code, 17, 0)
    fmap_inc_f64_literal_direct_count(fm)
  } else {
    emit_mov_imm_safe(code, 16, numer)
    bu32(code, encode_scvtf_d_from_x(0, 16))
    if denom != 1 {
      emit_mov_imm_safe(code, 17, denom)
      bu32(code, encode_scvtf_d_from_x(1, 17))
      bu32(code, encode_fdiv_d(0, 0, 1))
    } else { 0 }
    bu32(code, encode_fmov_x_from_d(17, 0))
  }
  emit_store_counter_from_phys(code, ctr, 17)
  ctr + 1
}

fn cg_emit_f64_operands_to_d(lhs: i64, rhs: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_f64_tree_can_direct(lhs, scope, src, fm) == 1 and cg_f64_tree_can_direct(rhs, scope, src, fm) == 1 {
    cg_emit_f64_tree_to_d(lhs, code, scope, src, fm, 0)
    cg_emit_f64_tree_to_d(rhs, code, scope, src, fm, 1)
    if cg_f64_tree_contains_arith(lhs) == 1 or cg_f64_tree_contains_arith(rhs) == 1 {
      fmap_inc_f64_expr_tree_count(fm)
    } else { 0 }
    ctr
  } else {
  let lhs_lit = cg_node_is_f64_literal(lhs)
  let rhs_lit = cg_node_is_f64_literal(rhs)
  if lhs_lit == 1 {
    if rhs_lit == 1 {
      cg_emit_f64_literal_to_d(lhs, code, src, 0, fm)
      cg_emit_f64_literal_to_d(rhs, code, src, 1, fm)
      ctr
    } else {
      let c2 = cg_expr(rhs, code, scope, src, ctr, fm)
      let rhs_phys = emit_load_reg(code, c2 - 1)
      bu32(code, encode_fmov_d_from_x(1, rhs_phys))
      cg_emit_f64_literal_to_d(lhs, code, src, 0, fm)
      c2
    }
  } else {
    let c1 = cg_expr(lhs, code, scope, src, ctr, fm)
    if rhs_lit == 1 {
      let lhs_phys = emit_load_reg(code, c1 - 1)
      bu32(code, encode_fmov_d_from_x(0, lhs_phys))
      cg_emit_f64_literal_to_d(rhs, code, src, 1, fm)
      c1
    } else {
      let c2 = cg_expr(rhs, code, scope, src, c1, fm)
      let lhs_phys = emit_load_reg(code, c1 - 1)
      let rhs_phys = emit_load_rhs(code, c2 - 1)
      bu32(code, encode_fmov_d_from_x(0, lhs_phys))
      bu32(code, encode_fmov_d_from_x(1, rhs_phys))
      c2
    }
  }
  }
}

fn cg_f64_binop_emit(code: i64, op: i64) -> i64 {
  match op {
    1 -> bu32(code, encode_fadd_d(2, 0, 1))
    2 -> bu32(code, encode_fsub_d(2, 0, 1))
    3 -> bu32(code, encode_fmul_d(2, 0, 1))
    4 -> bu32(code, encode_fdiv_d(2, 0, 1))
    _ -> 0
  }
}

fn cg_f64_cmp_emit(code: i64, op: i64, rd: i64) -> i64 {
  bu32(code, encode_fcmp_d(0, 1))
  let cond = match op {
    5 -> 0
    6 -> 1
    7 -> 11
    8 -> 12
    9 -> 13
    _ -> 10
  }
  bu32(code, encode_cset(rd, cond))
}

fn cg_f64_binop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  if op >= 1 and op <= 4 and cg_f64_tree_can_direct(node, scope, src, fm) == 1 {
    cg_emit_f64_tree_to_d(node, code, scope, src, fm, 0)
    fmap_inc_f64_expr_tree_count(fm)
    bu32(code, encode_fmov_x_from_d(17, 0))
  } else {
    cg_emit_f64_operands_to_d(lhs, rhs, code, scope, src, ctr, fm)
    if op >= 1 and op <= 4 {
      cg_f64_binop_emit(code, op)
      bu32(code, encode_fmov_x_from_d(17, 2))
    } else {
      cg_f64_cmp_emit(code, op, 17)
    }
  }
  emit_store_counter_from_phys(code, ctr, 17)
  ctr + 1
}

fn cg_ident(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let reg = scope_lookup(scope, src, ns, nl)
  if reg == 0 - 999 {
    -- Not in scope: check if it's a no-payload variant constructor
    let tt = fmap_get_tt(fm)
    let tag_hash = if tt > 0 { ttable_find_variant(tt, src, ns, nl) } else { 0 - 1 }
    if tag_hash >= 0 {
      -- No-payload variant constructor (e.g. None, Nil): inline [tag_hash, 0]
      emit_mov_imm(code, 0, 16)
      cg_bump_alloc_reg(code, 17, 0)
      emit_mov_imm(code, 16, tag_hash)
      bu32(code, cg_str(16, 17, 0))
      emit_mov_imm(code, 16, 0)
      bu32(code, cg_str(16, 17, 8))
      if ctr < 8 {
        bu32(code, encode_add_imm(ctr + 19, 17, 0))
      } else { emit_store_reg(code, ctr, 17) }
      ctr + 1
    } else {
      -- Check if it's a function name → create closure pair (thunk_ptr, nil)
      -- The thunk shifts args: x0=env(ignored), x1..xN=args → x0=x1, x1=x2, ..., B fn
      if fmap_contains(fm, src, ns, nl) == 1 {
        let fn_off = fmap_lookup(fm, src, ns, nl)
        -- Emit thunk stub (jumps over it with B)
        let b_over_pos = buf_len(code)
        bu32(code, 0)
        let thunk_off = buf_len(code)
        -- Thunk: shift x1..x7 down to x0..x6 (supports up to 7 args)
        bu32(code, encode_add_imm(0, 1, 0))
        bu32(code, encode_add_imm(1, 2, 0))
        bu32(code, encode_add_imm(2, 3, 0))
        bu32(code, encode_add_imm(3, 4, 0))
        bu32(code, encode_add_imm(4, 5, 0))
        bu32(code, encode_add_imm(5, 6, 0))
        bu32(code, encode_add_imm(6, 7, 0))
        -- B to original function
        if fn_off > 0 {
          bu32(code, encode_b(fn_off - buf_len(code)))
        } else {
          fmap_add_patch(fm, buf_len(code), src, ns, nl)
          bu32(code, encode_b(0))
        }
        -- Patch B-over to skip the thunk
        bytes_set_u32(code, b_over_pos, encode_b(buf_len(code) - b_over_pos))
        -- Allocate managed closure pair [thunk_ptr, env_ptr=0]
        cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
        if ctr < 8 {
          bu32(code, encode_add_imm(ctr + 19, 0, 0))
        } else { emit_store_reg(code, ctr, 0) }
        let closure_phys = emit_load_reg(code, ctr)
        let adr_pos = buf_len(code)
        bu32(code, encode_adr(17, thunk_off - adr_pos))
        bu32(code, cg_str(17, closure_phys, 0))
        emit_mov_imm(code, 17, 0)
        let closure_phys2 = emit_load_reg(code, ctr)
        bu32(code, cg_str(17, closure_phys2, 8))
        ctr + 1
      } else {
        eprint_span(src, ns)
        eprint("error: undefined variable: ")
        sys_write(2, src + ns, nl)
        eprint("\n")
        cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
      }
    }
  } else {
  -- Load source value into a physical register
  let src_phys = if reg < 0 {
    -- Spill slot: LDR x16, [sp, #(slot*8)]
    let slot = 0 - reg - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { reg }
  -- Store to destination
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, src_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, src_phys, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
  }
}

fn cg_binop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  if op == 12 or op == 13 {
    cg_logical_value(node, code, scope, src, ctr, fm)
  } else { if cg_binop_uses_f64(node, scope, src, fm) == 1 {
    cg_f64_binop(node, code, scope, src, ctr, fm)
  } else {
    let lhs = node_f2(node)
    let rhs = node_f3(node)
    let c1 = cg_expr(lhs, code, scope, src, ctr, fm)
    let c2 = cg_expr(rhs, code, scope, src, c1, fm)
    -- Load LHS into x16, RHS into x17 (use different temps for spilled values)
    let lhs_phys = emit_load_reg(code, c1 - 1)
    let rhs_phys = emit_load_rhs(code, c2 - 1)
    -- Compute into x17
    cg_binop_emit(code, op, 17, lhs_phys, rhs_phys)
    -- Store result at ctr (reuse starting slot — LHS/RHS are dead)
    -- This keeps counter growth O(depth) not O(nodes)
    if ctr < 8 {
      bu32(code, encode_add_imm(ctr + 19, 17, 0))
    } else {
      emit_store_reg(code, ctr, 17)
    }
    ctr + 1
  } }
}

fn cg_binop_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  match op {
    1 -> bu32(code, encode_add_reg(rd, rn, rm))
    2 -> bu32(code, encode_sub_reg(rd, rn, rm))
    3 -> bu32(code, encode_mul(rd, rn, rm))
    4 -> bu32(code, encode_sdiv(rd, rn, rm))
    11 -> {
      -- Modulo: rd = rn - (rn/rm)*rm. Use x15 as temp for SDIV result.
      bu32(code, encode_sdiv(15, rn, rm))
      bu32(code, encode_msub(rd, 15, rm, rn))
    }
    12 -> bu32(code, encode_and_reg(rd, rn, rm))
    13 -> bu32(code, encode_orr_reg(rd, rn, rm))
    14 -> bu32(code, encode_and_reg(rd, rn, rm))
    15 -> bu32(code, encode_orr_reg(rd, rn, rm))
    16 -> bu32(code, encode_eor_reg(rd, rn, rm))
    17 -> bu32(code, encode_lsl_reg(rd, rn, rm))
    18 -> bu32(code, encode_asr_reg(rd, rn, rm))
    _ -> cg_cmp_emit(code, op, rd, rn, rm)
  }
}

fn cg_cmp_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  -- ==5 !=6 <7 >8 <=9 >=10
  bu32(code, encode_cmp(rn, rm))
  let cond = match op {
    5 -> 0
    6 -> 1
    7 -> 11
    8 -> 12
    9 -> 13
    _ -> 10
  }
  bu32(code, encode_cset(rd, cond))
}

-- ======================================================================
-- Intrinsics
-- ======================================================================

-- Intrinsic detection: name starts with __
fn is_intrinsic(src: i64, ns: i64, nl: i64) -> i64 {
  if nl < 2 { 0 }
  else {
    if __mem_load8(src + ns) == 95 {
      if __mem_load8(src + ns + 1) == 95 { 1 }
      else { 0 }
    } else { 0 }
  }
}

-- Move result from x17 to ctr register
fn cg_i_result(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_i_syscall(code: i64, ctr: i64) -> i64 {
  -- Args: x0=num, x1-x6=syscall args
  -- MOV x16, x0
  bu32(code, encode_add_imm(16, 0, 0))
  -- Shift args: x0=x1, x1=x2, ..., x5=x6
  bu32(code, encode_add_imm(0, 1, 0))
  bu32(code, encode_add_imm(1, 2, 0))
  bu32(code, encode_add_imm(2, 3, 0))
  bu32(code, encode_add_imm(3, 4, 0))
  bu32(code, encode_add_imm(4, 5, 0))
  bu32(code, encode_add_imm(5, 6, 0))
  -- MOVK x16, #0x200, LSL #16 (BSD class bit)
  bu32(code, encode_movk(16, 512, 16))
  -- SVC #0x80 = 0xD4001001 = 3556773889
  bu32(code, encode_svc())
  -- Darwin reports syscall failure with carry set and x0 = errno.
  -- Keep success values as-is; normalize failures to negative errno so
  -- runtime wrappers can use the usual fd/result < 0 checks.
  let ok_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_sub_reg(0, 31, 0))
  cg_patch_b_cond(code, ok_pos, 3, buf_len(code))
  -- Result in x0 -> move to ctr register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
  ctr + 1
}

fn cg_i_bump_alloc(code: i64, ctr: i64) -> i64 {
  -- x0 = size. Result = old runtime_state.bump.
  cg_bump_alloc_reg(code, 17, 0)
  cg_i_result(code, ctr)
}

fn cg_i_mem_store64(code: i64, ctr: i64) -> i64 {
  -- x0=addr, x1=val. STR x1, [x0]: 0xF9000000 = 4177526784
  bu32(code, cg_str(1, 0, 0))
  -- Return val (x1) as result
  bu32(code, encode_add_imm(17, 1, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_store8(code: i64, ctr: i64) -> i64 {
  -- x0=addr, x1=val. STRB w1, [x0]: 0x39000000 = 956301312
  bu32(code, cg_strb(1, 0, 0))
  bu32(code, encode_add_imm(17, 1, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_load64(code: i64, ctr: i64) -> i64 {
  -- x0=addr. LDR x17, [x0]: 0xF9400000 = 4181721088
  bu32(code, cg_ldr(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_load8(code: i64, ctr: i64) -> i64 {
  -- x0=addr. LDRB w17, [x0]: 0x39400000 = 960495616
  bu32(code, cg_ldrb(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_str_ptr(code: i64, ctr: i64) -> i64 {
  -- x0=descriptor. LDR x17, [x0, #0]
  bu32(code, cg_ldr(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_str_len(code: i64, ctr: i64) -> i64 {
  -- x0=descriptor. LDR x17, [x0, #8]: offset=8, 8/8=1
  bu32(code, cg_ldr(17, 0, 8))
  cg_i_result(code, ctr)
}

fn cg_i_raw_offset(code: i64, ctr: i64) -> i64 {
  -- x0=ptr, x1=byte offset. Result = ptr + offset.
  bu32(code, encode_add_reg(17, 0, 1))
  cg_i_result(code, ctr)
}

fn cg_i_transmute(code: i64, ctr: i64) -> i64 {
  -- Current runtime representation is word-sized; transmute preserves bits.
  bu32(code, encode_add_imm(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_int_to_ptr(code: i64, ctr: i64) -> i64 {
  -- Pointers are represented as machine words in the current backend.
  bu32(code, encode_add_imm(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_i64_to_f64(code: i64, ctr: i64) -> i64 {
  -- x0 contains the signed integer. Keep f64 values as their raw bits in GPR slots.
  bu32(code, encode_scvtf_d_from_x(0, 0))
  bu32(code, encode_fmov_x_from_d(17, 0))
  cg_i_result(code, ctr)
}

fn cg_i_runtime_state(code: i64, ctr: i64) -> i64 {
  bu32(code, encode_add_imm(17, 28, 0))
  cg_i_result(code, ctr)
}

fn cg_i_set_runtime_state(code: i64, ctr: i64) -> i64 {
  -- x0=runtime state. Install it in x28 for pthread-entered Weft frames.
  bu32(code, encode_add_imm(28, 0, 0))
  bu32(code, encode_add_imm(17, 28, 0))
  cg_i_result(code, ctr)
}

fn cg_i_set_handler_stack(code: i64, ctr: i64) -> i64 {
  -- x0=handler stack head. Workers start with an empty stack.
  bu32(code, encode_add_imm(27, 0, 0))
  bu32(code, encode_add_imm(17, 27, 0))
  cg_i_result(code, ctr)
}

fn cg_i_call_i64(code: i64, ctr: i64) -> i64 {
  -- x0=raw function pointer, x1=i64 arg.
  bu32(code, encode_add_imm(9, 0, 0))
  bu32(code, encode_add_imm(0, 1, 0))
  bu32(code, encode_blr(9))
  cg_i_result(code, ctr)
}

fn cg_i_call_closure_i64(code: i64, ctr: i64) -> i64 {
  -- x0=closure pair [fn_ptr, env_ptr], x1=i64 arg.
  bu32(code, cg_ldr(9, 0, 0))
  bu32(code, cg_ldr(0, 0, 8))
  bu32(code, encode_blr(9))
  cg_i_result(code, ctr)
}

fn cg_fiber_save_regs(code: i64, base_reg: i64, regs_off: i64, lr_reg: i64) -> i64 {
  for r in 19..29 {
    bu32(code, cg_str(r, base_reg, regs_off + (r - 19) * 8))
  }
  bu32(code, cg_str(29, base_reg, regs_off + 80))
  bu32(code, cg_str(lr_reg, base_reg, regs_off + 88))
}

fn cg_fiber_restore_regs(code: i64, base_reg: i64, regs_off: i64) -> i64 {
  for r in 19..29 {
    bu32(code, cg_ldr(r, base_reg, regs_off + (r - 19) * 8))
  }
  bu32(code, cg_ldr(29, base_reg, regs_off + 80))
  bu32(code, cg_ldr(30, base_reg, regs_off + 88))
}

fn cg_fiber_save_sp(code: i64, base_reg: i64, off: i64) -> i64 {
  bu32(code, encode_add_imm(13, 31, 0))
  bu32(code, cg_str(13, base_reg, off))
}

fn cg_fiber_restore_sp_from(code: i64, reg: i64) -> i64 {
  bu32(code, encode_add_imm(31, reg, 0))
}

fn cg_fiber_prompt_save_handler_state(code: i64, prompt_reg: i64, lr_reg: i64) -> i64 {
  cg_fiber_save_sp(code, prompt_reg, fiber_prompt_handler_sp_offset())
  cg_fiber_save_regs(code, prompt_reg, fiber_prompt_handler_regs_offset(), lr_reg)
  bu32(code, cg_ldr(13, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, cg_str(13, prompt_reg, fiber_prompt_prev_prompt_offset()))
}

fn cg_fiber_segment_save_state(code: i64, segment_reg: i64, lr_reg: i64) -> i64 {
  cg_fiber_save_sp(code, segment_reg, fiber_segment_saved_sp_offset())
  cg_fiber_save_regs(code, segment_reg, fiber_segment_saved_regs_offset(), lr_reg)
}

fn cg_fiber_restore_handler_and_ret(code: i64, prompt_reg: i64, value_reg: i64) -> i64 {
  if prompt_reg != 9 { bu32(code, encode_add_imm(9, prompt_reg, 0)) } else { 0 }
  if value_reg != 11 { bu32(code, encode_add_imm(11, value_reg, 0)) } else { 0 }
  bu32(code, cg_ldr(10, 9, fiber_prompt_handler_sp_offset()))
  bu32(code, cg_ldr(13, 9, fiber_prompt_prev_prompt_offset()))
  bu32(code, cg_str(13, 28, runtime_state_fiber_prompt_offset()))
  cg_fiber_restore_regs(code, 9, fiber_prompt_handler_regs_offset())
  cg_fiber_restore_sp_from(code, 10)
  bu32(code, encode_add_imm(0, 11, 0))
  bu32(code, encode_ret())
}

fn cg_fiber_restore_fiber_and_ret(code: i64, segment_reg: i64, value_reg: i64) -> i64 {
  if segment_reg != 9 { bu32(code, encode_add_imm(9, segment_reg, 0)) } else { 0 }
  bu32(code, cg_ldr(10, 9, fiber_segment_saved_sp_offset()))
  bu32(code, cg_str(value_reg, 9, fiber_segment_saved_sp_offset()))
  cg_fiber_restore_regs(code, 9, fiber_segment_saved_regs_offset())
  cg_fiber_restore_sp_from(code, 10)
  bu32(code, cg_ldr(0, 9, fiber_segment_saved_sp_offset()))
  bu32(code, encode_ret())
}

fn cg_i_fiber_trampoline(code: i64, ctr: i64) -> i64 {
  -- x0=prompt, x1=fn_ptr, x2=arg. Returns first suspend value or final result.
  let adr_pos = buf_len(code)
  bu32(code, 0)
  cg_fiber_prompt_save_handler_state(code, 0, 10)
  bu32(code, encode_add_imm(19, 0, 0))
  bu32(code, encode_add_imm(20, 1, 0))
  bu32(code, encode_add_imm(21, 2, 0))
  bu32(code, cg_str(19, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, encode_movz(10, 0, 0))
  bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
  bu32(code, cg_ldr(22, 19, fiber_prompt_segment_offset()))
  bu32(code, cg_ldr(22, 22, fiber_segment_stack_top_offset()))
  cg_fiber_restore_sp_from(code, 22)
  bu32(code, encode_add_imm(0, 21, 0))
  bu32(code, encode_blr(20))
  bu32(code, encode_add_imm(11, 0, 0))
  bu32(code, encode_movz(10, 1, 0))
  bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
  bu32(code, encode_movz(10, 0, 0))
  bu32(code, cg_str(10, 28, runtime_state_fiber_prompt_offset()))
  cg_fiber_restore_handler_and_ret(code, 19, 11)
  let after_pos = buf_len(code)
  bytes_set_u32(code, adr_pos, encode_adr(10, after_pos - adr_pos))
  bu32(code, encode_add_imm(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_fiber_suspend(code: i64, ctr: i64) -> i64 {
  -- x0=value. Returns the value supplied by fiber_resume.
  bu32(code, encode_add_imm(11, 0, 0))
  bu32(code, cg_ldr(9, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, cg_ldr(10, 9, fiber_prompt_segment_offset()))
  let adr_pos = buf_len(code)
  bu32(code, 0)
  cg_fiber_segment_save_state(code, 10, 12)
  bu32(code, encode_movz(13, 0, 0))
  bu32(code, cg_str(13, 28, runtime_state_fiber_done_offset()))
  bu32(code, cg_str(13, 28, runtime_state_fiber_prompt_offset()))
  cg_fiber_restore_handler_and_ret(code, 9, 11)
  let after_pos = buf_len(code)
  bytes_set_u32(code, adr_pos, encode_adr(12, after_pos - adr_pos))
  bu32(code, encode_add_imm(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_fiber_resume(code: i64, ctr: i64) -> i64 {
  -- x0=prompt, x1=value. Returns next suspend value or final result.
  let adr_pos = buf_len(code)
  bu32(code, 0)
  cg_fiber_prompt_save_handler_state(code, 0, 10)
  bu32(code, encode_add_imm(19, 0, 0))
  bu32(code, encode_add_imm(20, 1, 0))
  bu32(code, cg_str(19, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, encode_movz(10, 0, 0))
  bu32(code, cg_str(10, 28, runtime_state_fiber_done_offset()))
  bu32(code, cg_ldr(9, 19, fiber_prompt_segment_offset()))
  cg_fiber_restore_fiber_and_ret(code, 9, 20)
  let after_pos = buf_len(code)
  bytes_set_u32(code, adr_pos, encode_adr(10, after_pos - adr_pos))
  bu32(code, encode_add_imm(17, 0, 0))
  cg_i_result(code, ctr)
}

fn cg_i_fiber_is_done(code: i64, ctr: i64) -> i64 {
  bu32(code, cg_ldr(17, 28, runtime_state_fiber_done_offset()))
  cg_i_result(code, ctr)
}

fn cg_intrinsic(code: i64, src: i64, ns: i64, nl: i64, ctr: i64) -> i64 {
  if src_eq(src, ns, nl, "__syscall") == 1 { cg_i_syscall(code, ctr) }
  else { if src_eq(src, ns, nl, "__bump_alloc") == 1 { cg_i_bump_alloc(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { cg_i_mem_store64(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { cg_i_mem_store8(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_load64") == 1 { cg_i_mem_load64(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { cg_i_mem_load8(code, ctr) }
  else { if src_eq(src, ns, nl, "__str_ptr") == 1 { cg_i_str_ptr(code, ctr) }
  else { if src_eq(src, ns, nl, "__str_len") == 1 { cg_i_str_len(code, ctr) }
  else { if src_eq(src, ns, nl, "__raw_offset") == 1 { cg_i_raw_offset(code, ctr) }
  else { if src_eq(src, ns, nl, "__transmute") == 1 { cg_i_transmute(code, ctr) }
  else { if src_eq(src, ns, nl, "__int_to_ptr") == 1 { cg_i_int_to_ptr(code, ctr) }
  else { if src_eq(src, ns, nl, "__i64_to_f64") == 1 { cg_i_i64_to_f64(code, ctr) }
  else { if src_eq(src, ns, nl, "__runtime_state") == 1 { cg_i_runtime_state(code, ctr) }
  else { if src_eq(src, ns, nl, "__set_runtime_state") == 1 { cg_i_set_runtime_state(code, ctr) }
  else { if src_eq(src, ns, nl, "__set_handler_stack") == 1 { cg_i_set_handler_stack(code, ctr) }
  else { if src_eq(src, ns, nl, "__call_i64") == 1 { cg_i_call_i64(code, ctr) }
  else { if src_eq(src, ns, nl, "__call_closure_i64") == 1 { cg_i_call_closure_i64(code, ctr) }
  else { if src_eq(src, ns, nl, "__fiber_trampoline") == 1 { cg_i_fiber_trampoline(code, ctr) }
  else { if src_eq(src, ns, nl, "__fiber_suspend") == 1 { cg_i_fiber_suspend(code, ctr) }
  else { if src_eq(src, ns, nl, "__fiber_resume") == 1 { cg_i_fiber_resume(code, ctr) }
  else { if src_eq(src, ns, nl, "__fiber_is_done") == 1 { cg_i_fiber_is_done(code, ctr) }
  else { ctr } } } } } } } } } } } } } } } } } } } } }
}

-- ======================================================================
-- Variant constructor
-- ======================================================================

-- Variant constructor: allocate 16 bytes [tag_hash, payload]
fn cg_variant_init(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, tag_hash: i64, args: i64, nargs: i64) -> i64 {
  -- Allocate 8 + nargs*8 bytes (tag_hash slot + payload slots, min 16)
  let alloc_size = 8 + nargs * 8
  let min_size = if alloc_size < 16 { 16 } else { alloc_size }
  emit_mov_imm(code, 0, min_size)
  cg_bump_alloc_reg(code, 17, 0)
  -- Store tag hash at [x17, #0]
  emit_mov_imm(code, 16, tag_hash)
  bu32(code, cg_str(16, 17, 0))
  -- Store variant pointer to ctr register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  -- Store each payload at [variant + 8 + i*8]
  if nargs > 0 {
    let mut c = ctr + 1
    for i in 0..nargs {
      let arg = nlist_get(args, i)
      c = cg_expr(arg, code, scope, src, c, fm)
      let base_phys = emit_load_reg(code, ctr)
      let val_phys = emit_load_rhs(code, c - 1)
      bu32(code, cg_str(val_phys, base_phys, 8 + i * 8))
    }
    ctr + 1
  } else {
    -- No payload: store 0 sentinel at [variant+8]
    emit_mov_imm(code, 16, 0)
    let base_phys = emit_load_reg(code, ctr)
    -- STR x16, [base, #8]
    bu32(code, cg_str(16, base_phys, 8))
    ctr + 1
  }
}

-- ======================================================================
-- Try operator (?) — desugar expr? to Ok/Err check + Fail.fail
-- ======================================================================

-- Tag 45 = TryExpr(inner_expr)
-- Emits: evaluate inner, check tag hash against Ok (5862623).
-- If Ok: extract payload → result.
-- If Err: extract error, perform Fail.fail(error) via handler stack.
fn cg_try(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let inner = node_f1(node)
  -- Evaluate the inner expression (should produce a Result variant)
  let c1 = cg_expr(inner, code, scope, src, ctr, fm)
  let result_ctr = c1 - 1
  -- Load tag hash from [result + 0]
  let result_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, result_phys, 0))
  -- Compare against Ok's tag hash (5862623)
  emit_mov_imm(code, 16, 5862623)
  bu32(code, encode_cmp(17, 16))
  -- B.NE to err_path
  let bne_pos = buf_len(code)
  bu32(code, 0)
  -- Ok path: load payload from [result + 8]
  let ok_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, ok_phys, 8))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else { emit_store_reg(code, ctr, 17) }
  -- Jump over err path
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  -- Err path: perform Fail.fail(error)
  -- The perform goes through the handler stack. For short-circuit behavior,
  -- the handler should not resume (Tier 1 semantics). With Tier 2 handlers,
  -- the perform resumes at this point and execution continues.
  --
  -- For correct ? semantics: perform Fail.fail which invokes the handler.
  -- If the handler doesn't resume (future Tier 1), this is a true short-circuit.
  -- If the handler does resume (Tier 2), the resumed value becomes the ? result.
  let err_start = buf_len(code)
  -- Perform Fail.fail via handler stack
  cg_perform_lookup(code, fm, 6384065697, 6385215681)
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  let err_arg_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, err_arg_phys, 8))
  bu32(code, encode_add_imm(1, 17, 0))
  bu32(code, encode_blr(9))
  -- If handler resumes, x0 has the resumed value
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else { emit_store_reg(code, ctr, 0) }
  -- Patch branches
  let after = buf_len(code)
  -- Patch B.NE to err_start
  let bne_off = err_start - bne_pos
  let bne_enc = encode_b_cond(bne_off, 1)
  let bd = buf_ptr(code)
  __mem_store8(bd + bne_pos, bne_enc - bne_enc / 256 * 256)
  __mem_store8(bd + bne_pos + 1, bne_enc / 256 - bne_enc / 65536 * 256)
  __mem_store8(bd + bne_pos + 2, bne_enc / 65536 - bne_enc / 16777216 * 256)
  __mem_store8(bd + bne_pos + 3, bne_enc / 16777216 - bne_enc / 4294967296 * 256)
  -- Patch B over err path
  let b_enc = encode_b(after - b_over_pos)
  __mem_store8(bd + b_over_pos, b_enc - b_enc / 256 * 256)
  __mem_store8(bd + b_over_pos + 1, b_enc / 256 - b_enc / 65536 * 256)
  __mem_store8(bd + b_over_pos + 2, b_enc / 65536 - b_enc / 16777216 * 256)
  __mem_store8(bd + b_over_pos + 3, b_enc / 16777216 - b_enc / 4294967296 * 256)
  ctr + 1
}

-- ======================================================================
-- String interpolation concat (tag 46)
-- ======================================================================

-- Tag 46 = InterpConcat(left, right)
-- Evaluates both sides and calls str_concat(left, right).
-- str_concat must be available in fmap (via use "stdlib/string.weft").
fn cg_interp_concat(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let left = node_f1(node)
  let right = node_f2(node)
  -- Evaluate left
  let c1 = cg_expr(left, code, scope, src, ctr, fm)
  -- Evaluate right
  let c2 = cg_expr(right, code, scope, src, c1, fm)
  -- Move to x0, x1 for str_concat call
  let lp = emit_load_reg(code, c1 - 1)
  bu32(code, encode_add_imm(0, lp, 0))
  let rp = emit_load_reg(code, c2 - 1)
  bu32(code, encode_add_imm(1, rp, 0))
  -- BL to str_concat (look up in fmap)
  let target = fmap_lookup_by_hash(fm, interp_str_concat_hash())
  let cur = buf_len(code)
  if target > 0 {
    bu32(code, encode_bl(target - cur))
  } else {
    -- str_concat not in fmap — emit placeholder (will fail at runtime)
    fmap_add_patch_by_name(fm, cur, "str_concat")
    bu32(code, encode_bl(0))
  }
  -- Result in x0
  if c2 < 8 {
    bu32(code, encode_add_imm(c2 + 19, 0, 0))
  } else { emit_store_reg(code, c2, 0) }
  c2 + 1
}

-- Hash of "str_concat" for fmap lookup
fn interp_str_concat_hash() -> i64 {
  let mut h = 5381
  -- s=115, t=116, r=114, _=95, c=99, o=111, n=110, c=99, a=97, t=116
  h = h * 33 + 115
  h = h * 33 + 116
  h = h * 33 + 114
  h = h * 33 + 95
  h = h * 33 + 99
  h = h * 33 + 111
  h = h * 33 + 110
  h = h * 33 + 99
  h = h * 33 + 97
  h = h * 33 + 116
  h
}

-- Look up a function in fmap by name hash (for stdlib functions)
fn fmap_lookup_by_hash(fm: i64, target_hash: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let owner_hash = __mem_load64(d + i * 40 + 32)
    if owner_hash == 0 {
      let e_ns = __mem_load64(d + i * 40)
      let e_nl = __mem_load64(d + i * 40 + 8)
      let e_src = __mem_load64(d + i * 40 + 24)
      let fn_hash = str_hash(e_src, e_ns, e_nl)
      if fn_hash == target_hash {
        result = __mem_load64(d + i * 40 + 16)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Placeholder for forward reference by name (not currently patchable)
fn fmap_add_patch_by_name(fm: i64, pos: i64, name: i64) -> i64 { 0 }

-- ======================================================================
-- Loop expression (tag 49)
-- ======================================================================

-- Tag 49 = LoopExpr(body)
-- Infinite loop. Value determined by break(expr).
-- break(expr) stores expr in the loop's result register and jumps out.
fn cg_loop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let body = node_f1(node)
  -- Save outer loop context
  let old_loop_start = __mem_load64(fm + 56)
  let old_break_patches = __mem_load64(fm + 64)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_loop_result_ctr = fmap_loop_result_ctr(fm)
  -- Set up this loop's context
  let loop_start = buf_len(code)
  let break_patches = nlist_new()
  __mem_store64(fm + 56, loop_start)
  __mem_store64(fm + 64, break_patches)
  __mem_store64(fm + 152, cg_cleanup_count(fm))
  fmap_set_loop_result_ctr(fm, ctr)
  -- Compile body (runs repeatedly)
  cg_expr(body, code, scope, src, ctr, fm)
  -- B loop_start (unconditional back-edge)
  bu32(code, encode_b(loop_start - buf_len(code)))
  -- After loop: patch all break targets
  let after_loop = buf_len(code)
  cg_patch_breaks(code, break_patches, after_loop)
  -- Restore outer loop context
  __mem_store64(fm + 56, old_loop_start)
  __mem_store64(fm + 64, old_break_patches)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
  -- Result is in ctr (set by break(expr) in cg_break)
  ctr + 1
}

-- ======================================================================
-- Optional chaining ?. (tag 48)
-- ======================================================================

-- Tag 48 = OptChain(base, field_ns, field_nl)
-- If base == 0 (nil): perform Maybe.none() via handler stack
-- If base != 0: access field at base + field_offset (via ttable lookup)
fn cg_opt_chain(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  -- Evaluate base
  let c1 = cg_expr(base, code, scope, src, ctr, fm)
  let base_ctr = c1 - 1
  -- Check if nil (== 0): CBZ to nil_path, fall through to ok_path
  let base_phys = emit_load_reg(code, base_ctr)
  -- CBZ base, nil_path (branch to nil handling if zero)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Ok path (non-nil): field access
  let tt = fmap_get_tt(fm)
  let idx = if tt > 0 { ttable_find_any_field(tt, src, field_ns, field_nl) } else { 0 }
  let ok_phys = emit_load_reg(code, base_ctr)
  bu32(code, cg_ldr(17, ok_phys, idx * 8))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else { emit_store_reg(code, ctr, 17) }
  -- Jump over nil path
  let b_over_pos = buf_len(code)
  bu32(code, 0)
  -- Nil path: perform Maybe.none()
  let nil_start = buf_len(code)
  cg_perform_lookup(code, fm, 210682486643, 6385518581)
  bu32(code, cg_ldr(9, 13, 8))
  bu32(code, cg_ldr(0, 13, 16))
  bu32(code, encode_blr(9))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else { emit_store_reg(code, ctr, 0) }
  -- Patch branches
  let after = buf_len(code)
  let bd = buf_ptr(code)
  -- Patch CBZ to nil_start
  cg_patch_cbz(code, cbz_pos, base_phys, nil_start)
  -- Patch B-over to after
  let b_enc = encode_b(after - b_over_pos)
  __mem_store8(bd + b_over_pos, b_enc - b_enc / 256 * 256)
  __mem_store8(bd + b_over_pos + 1, b_enc / 256 - b_enc / 65536 * 256)
  __mem_store8(bd + b_over_pos + 2, b_enc / 65536 - b_enc / 16777216 * 256)
  __mem_store8(bd + b_over_pos + 3, b_enc / 16777216 - b_enc / 4294967296 * 256)
  ctr + 1
}

-- ======================================================================
-- For-iter: iterate over a list (tag 47)
-- ======================================================================

-- Tag 47 = ForIter(var_ns, var_nl, collection, body)
-- Walks a Cons/Nil list:
--   let mut __cur = collection
--   loop:
--     load tag from [__cur + 0]
--     if tag == nil_tag: break
--     load item from [__cur + 8]
--     bind item to var
--     execute body
--     __cur = [__cur + 16] (next pointer)
fn cg_for_iter(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let var_ns = node_f1(node)
  let var_nl = node_f2(node)
  let collection = node_f3(node)
  let body = node_f4(node)
  -- Evaluate collection
  let c1 = cg_expr(collection, code, scope, src, ctr, fm)
  let col_ctr = c1 - 1
  -- Allocate a Nil sentinel to get its tag hash
  -- Emit: x17 = Nil variant (allocate [tag_hash, 0])
  let tt = fmap_get_tt(fm)
  -- We need the Nil tag hash. Look up "Nil" in the ttable.
  -- For simplicity, evaluate Nil at runtime and load its tag.
  -- Emit: __cur = collection (mutable, in a register)
  -- Use col_ctr as the current pointer
  -- Emit: Nil for tag comparison — load the tag hash of a Nil value
  -- Actually: the Nil tag hash is a compile-time constant.
  -- Let's compute it: str_hash of "Nil" = djb2("Nil")
  -- N=78, i=105, l=108 → h = 5381*33+78=177651, *33+105=5862588, *33+108=193465512
  let nil_hash = 193465512
  -- Loop start
  let loop_start = buf_len(code)
  -- Load tag: LDR x17, [col_phys, 0]
  let col_phys = emit_load_reg(code, col_ctr)
  bu32(code, cg_ldr(17, col_phys, 0))
  -- Compare with Nil tag hash
  emit_mov_imm(code, 16, nil_hash)
  bu32(code, encode_cmp(17, 16))
  -- B.EQ to loop_end (exit)
  let beq_pos = buf_len(code)
  bu32(code, 0)
  -- Load item: LDR x17, [col_phys, 8]
  let col_phys2 = emit_load_reg(code, col_ctr)
  bu32(code, cg_ldr(17, col_phys2, 8))
  -- Bind item to var name
  let item_ctr = c1
  if item_ctr < 8 {
    bu32(code, encode_add_imm(item_ctr + 19, 17, 0))
  } else { emit_store_reg(code, item_ctr, 17) }
  let body_scope = scope_push(scope, var_ns, var_nl, reg_id(item_ctr))
  -- Execute body
  cg_expr(body, code, body_scope, src, item_ctr + 1, fm)
  -- Advance: __cur = [__cur + 16]
  let col_phys3 = emit_load_reg(code, col_ctr)
  bu32(code, cg_ldr(17, col_phys3, 16))
  if col_ctr < 8 {
    bu32(code, encode_add_imm(col_ctr + 19, 17, 0))
  } else { emit_store_reg(code, col_ctr, 17) }
  -- B to loop_start
  bu32(code, encode_b(loop_start - buf_len(code)))
  -- Loop end: patch B.EQ
  let loop_end = buf_len(code)
  let beq_enc = encode_b_cond(loop_end - beq_pos, 0)
  let bd = buf_ptr(code)
  __mem_store8(bd + beq_pos, beq_enc - beq_enc / 256 * 256)
  __mem_store8(bd + beq_pos + 1, beq_enc / 256 - beq_enc / 65536 * 256)
  __mem_store8(bd + beq_pos + 2, beq_enc / 65536 - beq_enc / 16777216 * 256)
  __mem_store8(bd + beq_pos + 3, beq_enc / 16777216 - beq_enc / 4294967296 * 256)
  -- Result is nil (for loops evaluate to nil)
  emit_mov_imm(code, 17, 0)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else { emit_store_reg(code, ctr, 17) }
  ctr + 1
}

-- ======================================================================
-- Monomorphisation: compile specialised versions of generic functions
-- ======================================================================

fn cg_type_args_are_i64(type_args: i64, expected: i64) -> i64 {
  if type_args == 0 { 0 }
  else { if nlist_len(type_args) != expected { 0 }
  else {
    let mut ok = 1
    for i in 0..expected {
      if ty_eq(nlist_get(type_args, i), ty_i64()) != 1 { ok = 0 } else { 0 }
    }
    ok
  } }
}

fn cg_call_node_name_is(call_node: i64, src: i64, name: str) -> i64 {
  if call_node == 0 { 0 }
  else { if node_tag(call_node) != 4 { 0 }
  else { src_eq(src, node_f1(call_node), node_f2(call_node), name) } }
}

fn cg_generic_call_name_is(node: i64, src: i64, name: str) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 36 { 0 }
  else { cg_call_node_name_is(node_f2(node), src, name) } }
}

fn cg_generic_call_is_i64(node: i64, src: i64, name: str, nargs: i64, ntargs: i64) -> i64 {
  if cg_generic_call_name_is(node, src, name) != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if node_f4(call_node) != nargs { 0 }
    else { cg_type_args_are_i64(node_f1(node), ntargs) }
  }
}

fn cg_generic_call_is_generator_yield(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_generic_call_name_is(node, src, "generator_yield") != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { if node_f4(call_node) != 1 { 0 }
    else {
      let eff_hash = str_hash(__str_ptr("GeneratorYield"), 0, 14)
      let op_hash = str_hash(__str_ptr("yield"), 0, 5)
      cg_fiber_lowering_matches(fm, eff_hash, op_hash)
    } }
  }
}

fn cg_generic_call_is_generator_new(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_generic_call_name_is(node, src, "generator_new") != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { if node_f4(call_node) != 1 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 }
    else {
      let args = node_f3(call_node)
      cg_call_generator_producer_supported(nlist_get(args, 0), scope, src, fm, 1)
    } } }
  }
}

fn cg_generic_call_is_generator_result_or(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_generic_call_name_is(node, src, "generator_result_or") != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { if node_f4(call_node) != 2 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 } else { 1 } } }
  }
}

fn cg_generic_call_is_generator_drop(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_generic_call_name_is(node, src, "generator_drop") != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { if node_f4(call_node) != 1 { 0 }
    else { if nlist_len(node_f1(node)) != 2 { 0 } else { 1 } } }
  }
}

fn cg_generic_call_type_arg(node: i64, index: i64) -> i64 {
  let type_args = node_f1(node)
  if type_args == 0 { 0 }
  else { if index < 0 { 0 }
  else { if index >= nlist_len(type_args) { 0 }
  else { nlist_get(type_args, index) } } }
}

fn cg_store_zero_counter(code: i64, ctr: i64) -> i64 {
  emit_mov_imm(code, 17, 0)
  emit_store_counter_from_phys(code, ctr, 17)
}

fn cg_generator_state_from_handle(code: i64, handle_ctr: i64, state_ctr: i64) -> i64 {
  let handle_phys = emit_load_reg(code, handle_ctr)
  bu32(code, cg_ldr(17, handle_phys, 8))
  emit_store_counter_from_phys(code, state_ctr, 17)
}

fn cg_perform_fiber_suspend_one_owned(call_node: i64, value_ty: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f3(call_node)
  let value = nlist_get(args, 0)
  let c = cg_expr(value, code, scope, src, ctr, fm)
  let value_ctr = c - 1
  if cg_ty_is_managed(value_ty) == 1 {
    if cg_expr_is_borrow_for_ty(value_ty, value, scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, value_ty, reg_id(value_ctr))
    } else { 0 }
  } else { 0 }
  cg_bump_alloc_imm(code, 17, 16)
  let packet_ctr = c
  emit_store_counter_from_phys(code, packet_ctr, 17)
  let packet_phys0 = emit_load_counter_to(code, packet_ctr, 17)
  emit_mov_imm_safe(code, 16, 1)
  bu32(code, cg_str(16, packet_phys0, 0))
  let packet_phys1 = emit_load_counter_to(code, packet_ctr, 16)
  let value_phys = emit_load_counter_to(code, value_ctr, 17)
  bu32(code, cg_str(value_phys, packet_phys1, 8))
  let packet_phys2 = emit_load_counter_to(code, packet_ctr, 16)
  bu32(code, encode_add_imm(0, packet_phys2, 0))
  cg_emit_call_lit(code, fm, "fiber_suspend")
  cg_store_x0_result(code, packet_ctr + 1)
}

fn cg_generator_result_or(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let result_ty = cg_generic_call_type_arg(node, 1)
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let g_expr = nlist_get(args, 0)
  let default_expr = nlist_get(args, 1)
  let c1 = cg_expr(g_expr, code, scope, src, ctr, fm)
  let g_ctr = c1 - 1
  let c2 = cg_expr(default_expr, code, scope, src, c1, fm)
  let default_ctr = c2 - 1
  if cg_ty_is_managed(result_ty) == 1 {
    if cg_expr_is_borrow_for_ty(result_ty, default_expr, scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, result_ty, reg_id(default_ctr))
    } else { 0 }
  } else { 0 }
  let state_ctr = c2
  cg_generator_state_from_handle(code, g_ctr, state_ctr)
  let state_phys0 = emit_load_reg(code, state_ctr)
  bu32(code, cg_ldr(16, state_phys0, 24))
  let not_done_pos = buf_len(code)
  bu32(code, 0)
  if cg_ty_is_managed(result_ty) == 1 {
    cg_emit_managed_release_regid(code, fm, result_ty, reg_id(default_ctr))
  } else { 0 }
  let state_phys1 = emit_load_reg(code, state_ctr)
  bu32(code, cg_ldr(17, state_phys1, 32))
  if cg_ty_is_managed(result_ty) == 1 {
    cg_emit_managed_retain_phys_for_ty(code, fm, result_ty, 17)
  } else { 0 }
  let state_phys2 = emit_load_reg(code, state_ctr)
  bu32(code, cg_ldr(17, state_phys2, 32))
  emit_store_counter_from_phys(code, ctr, 17)
  let done_end_pos = buf_len(code)
  bu32(code, 0)
  let not_done = buf_len(code)
  cg_patch_cbz(code, not_done_pos, 16, not_done)
  let default_phys = emit_load_reg(code, default_ctr)
  emit_store_counter_from_phys(code, ctr, default_phys)
  let end = buf_len(code)
  cg_patch_b(code, done_end_pos, end)
  ctr + 1
}

fn cg_generator_drop_release_current(code: i64, fm: i64, state_ctr: i64, yield_ty: i64) -> i64 {
  if cg_ty_is_managed(yield_ty) == 1 {
    let state_phys0 = emit_load_reg(code, state_ctr)
    bu32(code, cg_ldr(16, state_phys0, 16))
    let skip_pos = buf_len(code)
    bu32(code, 0)
    let state_phys1 = emit_load_reg(code, state_ctr)
    bu32(code, cg_ldr(17, state_phys1, 8))
    cg_emit_managed_release_phys_for_ty(code, fm, yield_ty, 17)
    let skip = buf_len(code)
    cg_patch_cbz(code, skip_pos, 16, skip)
  } else { 0 }
  let state_phys2 = emit_load_reg(code, state_ctr)
  emit_mov_imm_safe(code, 17, 0)
  bu32(code, cg_str(17, state_phys2, 8))
  let state_phys3 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys3, 16))
}

fn cg_generator_drop_release_result(code: i64, fm: i64, state_ctr: i64, result_ty: i64) -> i64 {
  if cg_ty_is_managed(result_ty) != 1 { 0 }
  else {
    let state_phys0 = emit_load_reg(code, state_ctr)
    bu32(code, cg_ldr(17, state_phys0, 32))
    cg_emit_managed_release_phys_for_ty(code, fm, result_ty, 17)
    let state_phys1 = emit_load_reg(code, state_ctr)
    emit_mov_imm_safe(code, 17, 0)
    bu32(code, cg_str(17, state_phys1, 32))
  }
}

fn cg_generator_drop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let yield_ty = cg_generic_call_type_arg(node, 0)
  let result_ty = cg_generic_call_type_arg(node, 1)
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let c1 = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  let g_ctr = c1 - 1
  let state_ctr = c1
  cg_generator_state_from_handle(code, g_ctr, state_ctr)
  let state_phys0 = emit_load_reg(code, state_ctr)
  bu32(code, cg_ldr(16, state_phys0, 24))
  let pending_pos = buf_len(code)
  bu32(code, 0)
  cg_generator_drop_release_result(code, fm, state_ctr, result_ty)
  cg_store_zero_counter(code, ctr)
  let done_end_pos = buf_len(code)
  bu32(code, 0)
  let pending = buf_len(code)
  cg_patch_cbz(code, pending_pos, 16, pending)
  cg_generator_drop_release_current(code, fm, state_ctr, yield_ty)
  let state_phys1 = emit_load_reg(code, state_ctr)
  emit_mov_imm_safe(code, 17, 1)
  bu32(code, cg_str(17, state_phys1, 24))
  let state_phys2 = emit_load_reg(code, state_ctr)
  bu32(code, cg_ldr(0, state_phys2, 0))
  cg_emit_call_lit(code, fm, "continuation_cell_drop_i64_raw")
  cg_hclause_store_x0(code, ctr)
  let end = buf_len(code)
  cg_patch_b(code, done_end_pos, end)
  ctr + 1
}

fn cg_call_fusion_helper_available(fm: i64, name: str) -> i64 {
  let sp = __str_ptr(name)
  let sl = __str_len(name)
  fmap_contains(fm, sp, 0, sl)
}

fn cg_call_fusion_helper(name: str, args: i64, nargs: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_call_fusion_helper_available(fm, name) != 1 { 0 - 1 }
  else {
    let sp = __str_ptr(name)
    let sl = __str_len(name)
    let params = cg_ftypes_lookup_params(fmap_get_cg_ftypes(fm), sp, 0, sl)
    cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
    let result = cg_call_emit(code, sp, 0, sl, fm, ctr)
    fmap_inc_fusion_count(fm)
    result
  }
}

fn cg_call_par_map_helper_available(fm: i64, name: str) -> i64 {
  cg_call_fusion_helper_available(fm, name)
}

fn cg_generic_call_try_par_map_lowering(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_par_lowering_mode(fm) == 0 { 0 - 1 }
  else { if cg_par_map_is_direct_i64(node, src) != 1 { 0 - 1 }
  else {
    let call_node = node_f2(node)
    let args = node_f3(call_node)
    if cg_par_map_callback_pure_i64(nlist_get(args, 1), scope, src, fm) != 1 { 0 - 1 }
    else {
      let helper_name = if cg_par_lowering_mode(fm) == 1 { "par_sequential_map_i64" } else { "par_pthread_pool_map_scoped_i64" }
      if cg_call_par_map_helper_available(fm, helper_name) != 1 { 0 - 1 }
      else {
        let hp = __str_ptr(helper_name)
        let hl = __str_len(helper_name)
        let params = cg_ftypes_lookup_params(fmap_get_cg_ftypes(fm), hp, 0, hl)
        let c = cg_call_args_typed(args, 2, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
        if cg_par_lowering_mode(fm) == 2 {
          let pool_phys = emit_load_reg(code, cg_par_lowering_pool_ctr(fm))
          bu32(code, encode_add_imm(2, pool_phys, 0))
        } else { 0 }
        let result = cg_call_emit(code, hp, 0, hl, fm, ctr)
        fmap_inc_par_lowering_count(fm)
        result
      }
    }
  } }
}

fn cg_generic_call_try_map_fold_fusion(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let fold_call = node_f2(node)
  let fold_args = node_f3(fold_call)
  let mapped = nlist_get(fold_args, 0)
  if cg_generic_call_is_i64(mapped, src, "list_map", 2, 2) != 1 { 0 - 1 }
  else {
    let map_call = node_f2(mapped)
    let map_args = node_f3(map_call)
    let args = nlist_new()
    nlist_add(args, nlist_get(map_args, 0))
    nlist_add(args, nlist_get(fold_args, 1))
    nlist_add(args, nlist_get(map_args, 1))
    nlist_add(args, nlist_get(fold_args, 2))
    cg_call_fusion_helper("list_map_fold_i64", args, 4, code, scope, src, ctr, fm)
  }
}

fn cg_generic_call_try_filter_fold_fusion(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let fold_call = node_f2(node)
  let fold_args = node_f3(fold_call)
  let filtered = nlist_get(fold_args, 0)
  if cg_generic_call_is_i64(filtered, src, "list_filter", 2, 1) != 1 { 0 - 1 }
  else {
    let filter_call = node_f2(filtered)
    let filter_args = node_f3(filter_call)
    let args = nlist_new()
    nlist_add(args, nlist_get(filter_args, 0))
    nlist_add(args, nlist_get(fold_args, 1))
    nlist_add(args, nlist_get(filter_args, 1))
    nlist_add(args, nlist_get(fold_args, 2))
    cg_call_fusion_helper("list_filter_fold_i64", args, 4, code, scope, src, ctr, fm)
  }
}

fn cg_generic_call_try_map_filter_fold_fusion(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let fold_call = node_f2(node)
  let fold_args = node_f3(fold_call)
  let filtered = nlist_get(fold_args, 0)
  if cg_generic_call_is_i64(filtered, src, "list_filter", 2, 1) != 1 { 0 - 1 }
  else {
    let filter_call = node_f2(filtered)
    let filter_args = node_f3(filter_call)
    let mapped = nlist_get(filter_args, 0)
    if cg_generic_call_is_i64(mapped, src, "list_map", 2, 2) != 1 { 0 - 1 }
    else {
      let map_call = node_f2(mapped)
      let map_args = node_f3(map_call)
      let args = nlist_new()
      nlist_add(args, nlist_get(map_args, 0))
      nlist_add(args, nlist_get(fold_args, 1))
      nlist_add(args, nlist_get(map_args, 1))
      nlist_add(args, nlist_get(filter_args, 1))
      nlist_add(args, nlist_get(fold_args, 2))
      cg_call_fusion_helper("list_map_filter_fold_i64", args, 5, code, scope, src, ctr, fm)
    }
  }
}

fn cg_generic_call_try_list_fusion(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_generic_call_is_i64(node, src, "list_fold", 3, 2) != 1 { 0 - 1 }
  else {
    let map_filter = cg_generic_call_try_map_filter_fold_fusion(node, code, scope, src, ctr, fm)
    if map_filter >= 0 { map_filter }
    else {
      let map_fold = cg_generic_call_try_map_fold_fusion(node, code, scope, src, ctr, fm)
      if map_fold >= 0 { map_fold }
      else { cg_generic_call_try_filter_fold_fusion(node, code, scope, src, ctr, fm) }
    }
  }
}

fn cg_generic_call_is_vector_i64(node: i64, scope: i64, src: i64, name: str, nargs: i64) -> i64 {
  if cg_generic_call_is_i64(node, src, name, nargs, 1) != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
    else { 1 }
  }
}

fn cg_emit_vector_index_valid(code: i64, vec_reg: i64, index_reg: i64) -> i64 {
  let null_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 16, 0)
  cg_cmp_emit(code, 10, 13, index_reg, 16)
  let nonneg_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(16, vec_reg, 8))
  cg_cmp_emit(code, 7, 13, index_reg, 16)
  let in_bounds_pos = buf_len(code)
  bu32(code, 0)
  let patches = nlist_new()
  nlist_add(patches, null_pos)
  nlist_add(patches, nonneg_pos)
  nlist_add(patches, in_bounds_pos)
  patches
}

fn cg_emit_vector_index_valid_upper_proven(code: i64, vec_reg: i64, index_reg: i64) -> i64 {
  let null_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 16, 0)
  cg_cmp_emit(code, 10, 13, index_reg, 16)
  let nonneg_pos = buf_len(code)
  bu32(code, 0)
  let patches = nlist_new()
  nlist_add(patches, null_pos)
  nlist_add(patches, nonneg_pos)
  patches
}

fn cg_patch_vector_index_valid(code: i64, patches: i64, vec_reg: i64, cond_reg: i64, done: i64) -> i64 {
  let n = nlist_len(patches)
  if n > 0 { cg_patch_cbz(code, nlist_get(patches, 0), vec_reg, done) } else { 0 }
  if n > 1 { cg_patch_cbz(code, nlist_get(patches, 1), cond_reg, done) } else { 0 }
  if n > 2 { cg_patch_cbz(code, nlist_get(patches, 2), cond_reg, done) } else { 0 }
}

fn cg_emit_vector_data_base(code: i64, fm: i64, src: i64, vec_arg: i64, vec_reg: i64, data_reg: i64) -> i64 {
  let data_ctr = cg_vector_data_find_arg(fm, src, vec_arg)
  if data_ctr >= 0 {
    let data_phys = emit_load_counter_to(code, data_ctr, data_reg)
    if data_phys == data_reg { 0 }
    else { bu32(code, encode_add_imm(data_reg, data_phys, 0)) }
    fmap_inc_vector_data_hoist_use_count(fm)
  } else {
    bu32(code, cg_ldr(data_reg, vec_reg, 0))
  }
}

fn cg_generic_call_vector_get_i64(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let c_vec = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  let c_index = cg_expr(nlist_get(args, 1), code, scope, src, c_vec, fm)
  let c_default = cg_expr(nlist_get(args, 2), code, scope, src, c_index, fm)
  emit_move_counter_to(code, c_default - 1, 17)
  emit_move_counter_to(code, c_vec - 1, 14)
  emit_move_counter_to(code, c_index - 1, 15)
  let bound_mode = cg_vector_bound_mode_for_access(fm, src, nlist_get(args, 0), nlist_get(args, 1))
  let patches = if bound_mode == 2 {
    fmap_inc_vector_bounds_elision_count(fm)
    fmap_inc_vector_full_bounds_elision_count(fm)
    nlist_new()
  } else { if bound_mode > 0 {
    fmap_inc_vector_bounds_elision_count(fm)
    cg_emit_vector_index_valid_upper_proven(code, 14, 15)
  } else { cg_emit_vector_index_valid(code, 14, 15) } }
  cg_emit_vector_data_base(code, fm, src, nlist_get(args, 0), 14, 16)
  bu32(code, encode_ldr_reg_lsl3(17, 16, 15))
  let done = buf_len(code)
  cg_patch_vector_index_valid(code, patches, 14, 13, done)
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  ctr + 1
}

fn cg_generic_call_vector_set_i64(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let c_vec = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  let c_index = cg_expr(nlist_get(args, 1), code, scope, src, c_vec, fm)
  let c_value = cg_expr(nlist_get(args, 2), code, scope, src, c_index, fm)
  emit_move_counter_to(code, c_value - 1, 12)
  emit_move_counter_to(code, c_vec - 1, 14)
  emit_move_counter_to(code, c_index - 1, 15)
  emit_mov_imm_safe(code, 17, 0)
  let bound_mode = cg_vector_bound_mode_for_access(fm, src, nlist_get(args, 0), nlist_get(args, 1))
  let patches = if bound_mode == 2 {
    fmap_inc_vector_bounds_elision_count(fm)
    fmap_inc_vector_full_bounds_elision_count(fm)
    nlist_new()
  } else { if bound_mode > 0 {
    fmap_inc_vector_bounds_elision_count(fm)
    cg_emit_vector_index_valid_upper_proven(code, 14, 15)
  } else { cg_emit_vector_index_valid(code, 14, 15) } }
  cg_emit_vector_data_base(code, fm, src, nlist_get(args, 0), 14, 16)
  bu32(code, encode_str_reg_lsl3(12, 16, 15))
  emit_mov_imm_safe(code, 17, 1)
  let done = buf_len(code)
  cg_patch_vector_index_valid(code, patches, 14, 13, done)
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  ctr + 1
}

fn cg_emit_vector_push_i64_grow(code: i64, fm: i64) -> i64 {
  -- x14=vec, x15=len, x16=capacity. Grow to vector_next_capacity(cap, len + 1).
  bu32(code, encode_add_imm(13, 15, 1))
  emit_mov_imm_safe(code, 17, 1)
  bu32(code, encode_cmp(16, 31))
  let cap_le_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_reg(17, 16, 16))
  let cap_init_done = buf_len(code)
  cg_patch_b_cond(code, cap_le_pos, 13, cap_init_done)

  let cap_loop = buf_len(code)
  bu32(code, encode_cmp(17, 13))
  let cap_done_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_reg(17, 17, 17))
  let cap_back_pos = buf_len(code)
  bu32(code, 0)
  cg_patch_b(code, cap_back_pos, cap_loop)
  let cap_done = buf_len(code)
  cg_patch_b_cond(code, cap_done_pos, 10, cap_done)

  emit_mov_imm_safe(code, 11, 8)
  bu32(code, encode_mul(0, 17, 11))
  cg_bump_alloc_reg(code, 9, 0)
  bu32(code, cg_ldr(10, 14, 0))
  let no_copy_pos = buf_len(code)
  bu32(code, 0)
  emit_mov_imm_safe(code, 11, 0)
  let copy_loop = buf_len(code)
  bu32(code, encode_cmp(11, 15))
  let copy_done_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_ldr_reg_lsl3(12, 10, 11))
  bu32(code, encode_str_reg_lsl3(12, 9, 11))
  fmap_inc_vector_scaled_addr_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  bu32(code, encode_add_imm(11, 11, 1))
  let copy_back_pos = buf_len(code)
  bu32(code, 0)
  cg_patch_b(code, copy_back_pos, copy_loop)
  let copy_done = buf_len(code)
  cg_patch_b_cond(code, copy_done_pos, 10, copy_done)
  cg_patch_cbz(code, no_copy_pos, 10, copy_done)

  bu32(code, cg_str(9, 14, 0))
  bu32(code, cg_str(17, 14, 16))
}

fn cg_generic_call_vector_push_i64_no_grow(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let c_vec = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  let c_value = cg_expr(nlist_get(args, 1), code, scope, src, c_vec, fm)
  emit_move_counter_to(code, c_vec - 1, 14)
  emit_mov_imm_safe(code, 17, 0)
  let null_pos = buf_len(code)
  bu32(code, 0)
  emit_move_counter_to(code, c_value - 1, 12)
  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, cg_ldr(16, 14, 0))
  bu32(code, encode_str_reg_lsl3(12, 16, 15))
  bu32(code, encode_add_imm(15, 15, 1))
  bu32(code, cg_str(15, 14, 8))
  bu32(code, encode_add_imm(17, 14, 0))
  let done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, done)
  emit_store_counter_from_phys(code, ctr, 17)
  cg_vector_all_facts_invalidate(fm)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_push_no_grow_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  ctr + 1
}

fn cg_generic_call_vector_push_i64(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  if cg_vector_push_no_grow_proven(fm, src, nlist_get(args, 0)) == 1 {
    cg_generic_call_vector_push_i64_no_grow(node, code, scope, src, ctr, fm)
  } else {
  let c_vec = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  let c_value = cg_expr(nlist_get(args, 1), code, scope, src, c_vec, fm)
  emit_move_counter_to(code, c_vec - 1, 14)
  emit_mov_imm_safe(code, 17, 0)
  let null_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, cg_ldr(16, 14, 16))
  cg_cmp_emit(code, 7, 13, 15, 16)
  let grow_pos = buf_len(code)
  bu32(code, 0)
  let skip_grow_pos = buf_len(code)
  bu32(code, 0)
  let grow_start = buf_len(code)
  cg_patch_cbz(code, grow_pos, 13, grow_start)
  cg_emit_vector_push_i64_grow(code, fm)
  let store_start = buf_len(code)
  cg_patch_b(code, skip_grow_pos, store_start)

  emit_move_counter_to(code, c_vec - 1, 14)
  emit_move_counter_to(code, c_value - 1, 12)
  bu32(code, cg_ldr(15, 14, 8))
  bu32(code, cg_ldr(16, 14, 0))
  bu32(code, encode_str_reg_lsl3(12, 16, 15))
  bu32(code, encode_add_imm(15, 15, 1))
  bu32(code, cg_str(15, 14, 8))
  bu32(code, encode_add_imm(17, 14, 0))
  let done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, done)
  emit_store_counter_from_phys(code, ctr, 17)
  cg_vector_all_facts_invalidate(fm)
  fmap_inc_vector_lowering_count(fm)
  fmap_inc_vector_scaled_addr_count(fm)
  ctr + 1
  }
}

fn cg_generic_call_is_vector_fold_i64(node: i64, scope: i64, src: i64) -> i64 {
  if cg_generic_call_is_i64(node, src, "vector_fold", 3, 2) != 1 { 0 }
  else {
    let call_node = node_f2(node)
    if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 } else { 1 }
  }
}

fn cg_vector_fold_i64_lambda_supported(lambda: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if lambda == 0 { 0 }
  else { if node_tag(lambda) != 29 { 0 }
  else {
    let params = node_f1(lambda)
    let body = node_f2(lambda)
    let nparams = node_f3(lambda)
    if nparams != 2 { 0 }
    else { if cg_tiny_inline_params_all_i64(params) != 1 { 0 }
    else { if cg_lambda_has_free_vars(lambda, scope, src) == 1 { 0 }
    else {
      let lambda_scope = cg_local_lambda_inline_type_scope(params, nparams)
      if ty_eq(cg_expr_type(body, lambda_scope, src, fm), ty_i64()) == 1 { 1 } else { 0 }
    } } }
  } }
}

fn cg_generic_call_vector_fold_i64(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let call_node = node_f2(node)
  let args = node_f3(call_node)
  let vec_arg = nlist_get(args, 0)
  let init_arg = nlist_get(args, 1)
  let lambda = nlist_get(args, 2)
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let c_vec = cg_expr(vec_arg, code, scope, src, ctr, fm)
  let c_acc = cg_expr(init_arg, code, scope, src, c_vec, fm)
  let acc_ctr = c_acc - 1
  let len_ctr = c_acc
  let data_ctr = c_acc + 1
  let i_ctr = c_acc + 2
  let item_ctr = c_acc + 3

  emit_move_counter_to(code, c_vec - 1, 14)
  emit_mov_imm_safe(code, 17, 0)
  emit_store_counter_from_phys(code, len_ctr, 17)
  emit_store_counter_from_phys(code, data_ctr, 17)
  let null_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 14, 8))
  emit_store_counter_from_phys(code, len_ctr, 17)
  bu32(code, cg_ldr(17, 14, 0))
  emit_store_counter_from_phys(code, data_ctr, 17)
  let header_done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, header_done)

  emit_mov_imm_safe(code, 17, 0)
  emit_store_counter_from_phys(code, i_ctr, 17)
  let loop_start = buf_len(code)
  let i_phys = emit_load_counter_to(code, i_ctr, 14)
  let len_phys = emit_load_counter_to(code, len_ctr, 15)
  bu32(code, encode_cmp(i_phys, len_phys))
  let done_pos = buf_len(code)
  bu32(code, 0)

  let data_phys = emit_load_counter_to(code, data_ctr, 14)
  let index_phys = emit_load_counter_to(code, i_ctr, 15)
  bu32(code, encode_ldr_reg_lsl3(17, data_phys, index_phys))
  emit_store_counter_from_phys(code, item_ctr, 17)
  fmap_inc_vector_scaled_addr_count(fm)

  let results = alloc_bump(16)
  __mem_store64(results, acc_ctr)
  __mem_store64(results + 8, item_ctr)
  let lambda_scope = cg_tiny_inline_scope(params, 2, results, src)
  let body_ctr = cg_expr(body, code, lambda_scope, src, item_ctr + 1, fm)
  cg_match_store_result(code, acc_ctr, body_ctr)

  let i_phys2 = emit_load_counter_to(code, i_ctr, 14)
  bu32(code, encode_add_imm(17, i_phys2, 1))
  emit_store_counter_from_phys(code, i_ctr, 17)
  let back_pos = buf_len(code)
  bu32(code, encode_b(loop_start - back_pos))
  let done = buf_len(code)
  cg_patch_b_cond(code, done_pos, 10, done)

  emit_move_counter_to(code, acc_ctr, 17)
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_vector_lowering_count(fm)
  ctr + 1
}

fn cg_generic_call_try_vector_i64_lowering(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_generic_call_is_vector_i64(node, scope, src, "vector_get", 3) == 1 {
    cg_generic_call_vector_get_i64(node, code, scope, src, ctr, fm)
  } else { if cg_generic_call_is_vector_i64(node, scope, src, "vector_set", 3) == 1 {
    cg_generic_call_vector_set_i64(node, code, scope, src, ctr, fm)
  } else { if cg_generic_call_is_vector_i64(node, scope, src, "vector_push", 2) == 1 {
    cg_generic_call_vector_push_i64(node, code, scope, src, ctr, fm)
  } else { if cg_generic_call_is_vector_fold_i64(node, scope, src) == 1 {
    let call_node = node_f2(node)
    let callback = nlist_get(node_f3(call_node), 2)
    if cg_vector_fold_i64_lambda_supported(callback, scope, src, fm) == 1 {
      cg_generic_call_vector_fold_i64(node, code, scope, src, ctr, fm)
    } else { 0 - 1 }
  } else { 0 - 1 } } } }
}

-- GenericCall: tag 36 = (type_args_list, inner_call_node, num_type_args, 0)
-- Specialise the generic function for the given type args, then call it.
fn cg_generic_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  if cg_generic_call_is_generator_yield(node, scope, src, fm) == 1 {
    let call_node = node_f2(node)
    cg_perform_fiber_suspend_one_owned(call_node, cg_generic_call_type_arg(node, 0), code, scope, src, ctr, fm)
  } else { if cg_generic_call_is_generator_new(node, scope, src, fm) == 1 {
    cg_call_generator_new_with_variant(node_f2(node), code, scope, src, ctr, fm, "Generator", 1)
  } else { if cg_generic_call_is_generator_result_or(node, scope, src, fm) == 1 {
    cg_generator_result_or(node, code, scope, src, ctr, fm)
  } else { if cg_generic_call_is_generator_drop(node, scope, src, fm) == 1 {
    cg_generator_drop(node, code, scope, src, ctr, fm)
  } else {
  let par_mapped = cg_generic_call_try_par_map_lowering(node, code, scope, src, ctr, fm)
  if par_mapped >= 0 { par_mapped }
  else {
  let vector_lowered = cg_generic_call_try_vector_i64_lowering(node, code, scope, src, ctr, fm)
  if vector_lowered >= 0 { vector_lowered }
  else {
  let fused = cg_generic_call_try_list_fusion(node, code, scope, src, ctr, fm)
  if fused >= 0 { fused }
  else {
  let evidence_entry = cg_evidence_generic_entry_for_call(node, fm, src)
  let evidence_info = if evidence_entry == 0 { 0 } else { cg_effect_evidence_info_for_generic_call(node, fm, src, evidence_entry, scope) }
  let evidence_call = if evidence_info == 0 { 0 - 1 } else { cg_call_effect_evidence_generic(node, code, scope, src, ctr, fm, evidence_entry, evidence_info) }
  if evidence_call >= 0 { evidence_call }
  else {
  let type_args = cg_type_args_in_current_context(fm, node_f1(node))
  let call_node = node_f2(node)
  let ns = node_f1(call_node)
  let nl = node_f2(call_node)
  let args = node_f3(call_node)
  let nargs = node_f4(call_node)
  -- Compute the specialisation key
  let name_hash = str_hash(src, ns, nl)
  let spec_hash = mono_spec_hash(name_hash, type_args)
  let call_params = cg_generic_subst_params(fm, name_hash, type_args)
  -- Check specialisation cache
  let mc = __mem_load64(fm + 88)
  let cached = mono_cache_lookup(mc, spec_hash)
  if cached > 0 {
    -- Already specialised: emit call to cached function
    let c = cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, call_params, 0, 0))
    cg_vector_all_facts_invalidate(fm)
    let cur = buf_len(code)
    bu32(code, encode_bl(cached - cur))
    if c < 8 { bu32(code, encode_add_imm(c + 19, 0, 0)) }
    else { emit_store_reg(code, c, 0) }
    c + 1
  } else {
    -- Look up the generic template
    let tm = __mem_load64(fm + 80)
    let tmpl_entry = mono_tmap_lookup(tm, name_hash)
    if tmpl_entry == 0 {
      -- Not a generic function template: fall back to regular call
      -- (This handles non-generic functions called with explicit type args)
      cg_call(call_node, code, scope, src, ctr, fm)
    } else {
      -- Specialise: compile the template body as a new function
      let tmpl_wrap = __mem_load64(tmpl_entry + 8)
      let tmpl_src = __mem_load64(tmpl_entry + 16)
      let tmpl_inner = unwrap_fn(tmpl_wrap)
      let subst = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
      let subst_ret = cg_generic_subst_ret(tmpl_wrap, type_args)
      -- Jump over the specialised body (so caller flow continues after)
      let b_over_pos = buf_len(code)
      bu32(code, 0)
      -- Compile the specialised function body
      let fn_off = buf_len(code)
      -- Cache BEFORE compiling so recursive calls find this specialisation
      mono_cache_add(mc, spec_hash, fn_off)
      emit_prologue(code)
      let params = cg_params_subst(node_f3(tmpl_inner), subst)
      let body = node_f4(tmpl_inner)
      let nparams = nlist_len(params)
      if nparams > 8 {
        eprint("error: specialised function has more than 8 parameters\n")
      } else { 0 }
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_generic_subst = fmap_current_generic_subst(fm)
      fmap_set_current_ret_ty(fm, subst_ret)
      fmap_set_current_generic_subst(fm, subst)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      let fn_scope = cg_fn_params(params, nparams, tmpl_src, scope_new(), code, fm)
      let body_ctr = cg_expr(body, code, fn_scope, tmpl_src, nparams, fm)
      let save_ctr = body_ctr
      cg_match_store_result(code, save_ctr, body_ctr)
      if cg_ty_is_managed(subst_ret) == 1 {
        if cg_expr_is_borrow_for_ty(subst_ret, body, fn_scope, tmpl_src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, subst_ret, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      cg_emit_cleanups_to_depth(code, tmpl_src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      fmap_set_current_generic_subst(fm, old_generic_subst)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue(code)
      -- Patch the jump-over to skip the specialised body
      let b_enc = encode_b(buf_len(code) - b_over_pos)
      let bd = buf_ptr(code)
      __mem_store8(bd + b_over_pos, b_enc - b_enc / 256 * 256)
      __mem_store8(bd + b_over_pos + 1, b_enc / 256 - b_enc / 65536 * 256)
      __mem_store8(bd + b_over_pos + 2, b_enc / 65536 - b_enc / 16777216 * 256)
      __mem_store8(bd + b_over_pos + 3, b_enc / 16777216 - b_enc / 4294967296 * 256)
      -- Emit call args + BL to the specialised function
      let c = cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
      cg_vector_all_facts_invalidate(fm)
      let cur = buf_len(code)
      bu32(code, encode_bl(fn_off - cur))
      if c < 8 { bu32(code, encode_add_imm(c + 19, 0, 0)) }
      else { emit_store_reg(code, c, 0) }
      c + 1
    }
  } } } } } } } } }
}

-- ======================================================================
-- Call, if, let, fn, module
-- ======================================================================

fn cg_borrow_mask_for_call(args: i64, nargs: i64, params: i64, scope: i64, src: i64, fm: i64, eligible_mask: i64) -> i64 {
  if fmap_rc_elision_enabled(fm) != 1 { 0 }
  else { if params == 0 or eligible_mask == 0 { 0 }
  else {
    let mut mask = 0
    let mut i = 0
    while i < nargs {
      if i < nlist_len(params) {
        let param_ty = node_f3(nlist_get(params, i))
        if cg_ty_is_managed(param_ty) == 1 {
          if cg_mask_has(eligible_mask, i) == 1 and cg_expr_is_borrow_for_ty(param_ty, nlist_get(args, i), scope, src, fm) == 1 {
            mask = mask + cg_bit(i)
          } else { 0 }
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    mask
  } }
}

fn cg_borrow_entry_for_direct_call(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let name_hash = str_hash(src, ns, nl)
  let entry = borrow_tmap_lookup(fmap_borrow_tmap(fm), name_hash, 0)
  if entry == 0 { 0 }
  else { if node_f3(entry) == src { entry } else { 0 } }
}

fn cg_perform_node_matches_hash(node: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 32 { 0 }
  else {
    let lhs = node_f1(node)
    if node_tag(lhs) != 2 { 0 }
    else {
      if str_hash(src, node_f1(lhs), node_f2(lhs)) != eff_hash { 0 }
      else { if str_hash(src, node_f2(node), node_f3(node)) == op_hash { 1 } else { 0 } }
    }
  } }
}

fn cg_fiber_body_list_has_perform_hash(list: i64, n: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < n {
    if cg_fiber_body_has_perform_hash(nlist_get(list, i), src, eff_hash, op_hash) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_fiber_body_has_perform_hash(node: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_fiber_body_has_perform_hash(node_f2(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f3(node), src, eff_hash, op_hash)
      4 -> cg_fiber_body_list_has_perform_hash(node_f3(node), node_f4(node), src, eff_hash, op_hash)
      5 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f2(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f3(node), src, eff_hash, op_hash)
      6 -> cg_fiber_body_has_perform_hash(node_f3(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f4(node), src, eff_hash, op_hash)
      7 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f2(node), src, eff_hash, op_hash)
      11 -> cg_fiber_body_has_perform_hash(node_f3(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f4(node), src, eff_hash, op_hash)
      12 -> cg_fiber_body_has_perform_hash(node_f3(node), src, eff_hash, op_hash)
      13 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      14 -> cg_fiber_body_list_has_perform_hash(node_f3(node), node_f4(node), src, eff_hash, op_hash)
      15 -> {
        let arms = node_f2(node)
        let n = node_f3(node)
        let mut found = cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
        let mut i = 0
        while i < n and found == 0 {
          let arm = nlist_get(arms, i)
          let guard = node_f3(arm)
          found = if guard != 0 { cg_fiber_body_has_perform_hash(guard, src, eff_hash, op_hash) } else { 0 }
          if found == 0 { found = cg_fiber_body_has_perform_hash(node_f2(arm), src, eff_hash, op_hash) } else { found = found }
          i = i + 1
        }
        found
      }
      22 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      25 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      26 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      32 -> if cg_perform_node_matches_hash(node, src, eff_hash, op_hash) == 1 { 1 }
        else { cg_fiber_body_list_has_perform_hash(node_f4(node), nlist_len(node_f4(node)), src, eff_hash, op_hash) }
      35 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      36 -> {
        let call_node = node_f2(node)
        cg_fiber_body_list_has_perform_hash(node_f3(call_node), node_f4(call_node), src, eff_hash, op_hash)
      }
      37 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      41 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash) or cg_fiber_body_list_has_perform_hash(node_f3(node), nlist_len(node_f3(node)), src, eff_hash, op_hash)
      45 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      46 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f2(node), src, eff_hash, op_hash)
      48 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash)
      52 -> cg_fiber_body_has_perform_hash(node_f1(node), src, eff_hash, op_hash) or cg_fiber_body_has_perform_hash(node_f2(node), src, eff_hash, op_hash)
      _ -> 0
    }
  }
}

fn cg_fiber_entry_for_direct_call(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let name_hash = str_hash(src, ns, nl)
  let entry = borrow_tmap_lookup(fmap_borrow_tmap(fm), name_hash, 0)
  if entry == 0 { 0 }
  else { if node_f3(entry) == src { entry } else { 0 } }
}

fn cg_effect_sig_contains_hash(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else { if ty_tag(eff) != 10 { 0 }
  else {
    let apps = ty_f1(eff)
    let mut found = 0
    let mut i = 0
    while i < nlist_len(apps) and found == 0 {
      if ty_f1(nlist_get(apps, i)) == eff_hash { found = 1 }
      else { i = i + 1 }
    }
    found
  } }
}

fn cg_fiber_entry_supports_active(entry: i64, fm: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let eff_hash = cg_fiber_lowering_eff_hash(fm)
    let op_hash = cg_fiber_lowering_op_hash(fm)
    if eff_hash == 0 or op_hash == 0 { 0 }
    else {
      let fn_wrap = node_f2(entry)
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      let fn_src = node_f3(entry)
      if cg_fiber_params_unmanaged(params) == 0 { 0 }
      else { if cg_ty_is_managed(ret_ty) == 1 { 0 }
      else {
        let body_has = cg_fiber_body_has_perform_hash(body, fn_src, eff_hash, op_hash)
        let gen_eff = str_hash(__str_ptr("GeneratorYield"), 0, 14)
        let gen_op = str_hash(__str_ptr("yield"), 0, 5)
        let sig_has = if eff_hash == gen_eff and op_hash == gen_op { cg_effect_sig_contains_hash(fn_effects(fn_wrap), eff_hash) } else { 0 }
        if body_has == 1 or sig_has == 1 { 1 } else { 0 }
      } }
    }
  }
}

fn cg_effect_evidence_ctx_size() -> i64 { 40 }
fn cg_effect_evidence_ctx_eff_offset() -> i64 { 0 }
fn cg_effect_evidence_ctx_op_offset() -> i64 { 8 }
fn cg_effect_evidence_ctx_base_ctr_offset() -> i64 { 16 }
fn cg_effect_evidence_ctx_op_index_offset() -> i64 { 24 }
fn cg_effect_evidence_ctx_prev_offset() -> i64 { 32 }

fn cg_effect_evidence_push_index(fm: i64, eff_hash: i64, op_hash: i64, evidence_ctr: i64, op_index: i64) -> i64 {
  let ctx = alloc_bump(cg_effect_evidence_ctx_size())
  __mem_store64(ctx + cg_effect_evidence_ctx_eff_offset(), eff_hash)
  __mem_store64(ctx + cg_effect_evidence_ctx_op_offset(), op_hash)
  __mem_store64(ctx + cg_effect_evidence_ctx_base_ctr_offset(), evidence_ctr)
  __mem_store64(ctx + cg_effect_evidence_ctx_op_index_offset(), op_index)
  __mem_store64(ctx + cg_effect_evidence_ctx_prev_offset(), fmap_effect_evidence_top(fm))
  fmap_set_effect_evidence_top(fm, ctx)
  ctx
}

fn cg_effect_evidence_push(fm: i64, eff_hash: i64, op_hash: i64, evidence_ctr: i64) -> i64 {
  cg_effect_evidence_push_index(fm, eff_hash, op_hash, evidence_ctr, 0)
}

fn cg_effect_evidence_pop(fm: i64) -> i64 {
  let top = fmap_effect_evidence_top(fm)
  if top == 0 { 0 } else { fmap_set_effect_evidence_top(fm, __mem_load64(top + cg_effect_evidence_ctx_prev_offset())) }
}

fn cg_effect_evidence_find_ctx(fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut ctx = fmap_effect_evidence_top(fm)
  let mut result = 0
  while ctx != 0 and result == 0 {
    if __mem_load64(ctx + cg_effect_evidence_ctx_eff_offset()) == eff_hash and __mem_load64(ctx + cg_effect_evidence_ctx_op_offset()) == op_hash {
      result = ctx
    } else {
      ctx = __mem_load64(ctx + cg_effect_evidence_ctx_prev_offset())
    }
  }
  result
}

fn cg_effect_evidence_find(fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let ctx = cg_effect_evidence_find_ctx(fm, eff_hash, op_hash)
  if ctx == 0 { 0 - 1 } else { __mem_load64(ctx + cg_effect_evidence_ctx_base_ctr_offset()) }
}

fn cg_effect_evidence_find_op_index(fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let ctx = cg_effect_evidence_find_ctx(fm, eff_hash, op_hash)
  if ctx == 0 { 0 - 1 } else { __mem_load64(ctx + cg_effect_evidence_ctx_op_index_offset()) }
}

