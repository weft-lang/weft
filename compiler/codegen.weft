-- codegen.weft — code generation for aarch64
-- Scope, type table, function map, prologue/epilogue, register allocation,
-- and all cg_* code generation functions

use "compiler/encode.weft"
use "compiler/parse.weft"
use "compiler/types.weft"
use "compiler/typeck.weft"
use "runtime/alloc.weft"
use "runtime/effects.weft"
use "runtime/memory.weft"

fn cg_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

fn cg_str(rt: i64, rn: i64, off: i64) -> i64 { encode_str(rt, rn, off) }
fn cg_ldr(rt: i64, rn: i64, off: i64) -> i64 { encode_ldr(rt, rn, off) }
fn cg_strb(rt: i64, rn: i64, off: i64) -> i64 { encode_strb(rt, rn, off) }
fn cg_ldrb(rt: i64, rn: i64, off: i64) -> i64 { encode_ldrb(rt, rn, off) }
-- 96 -> 112 (2r slice 1): +16 bytes cache the default rc heap's arena
-- bounds (base at 96, end at 104) so the retain/release magic guard is
-- two state loads instead of a four-call heap/arena pointer chase.
-- 120 -> 128 (2t): +8 bytes for the dynamic-dispatch masked context —
-- handler_find_entry stores the found frame's prev at offset 120 so the
-- perform site can run the clause with its own handler frame masked
-- (self-label performs must dispatch outward). Runtime twin:
-- handler_dispatch_prev_offset in runtime/effects.weft.
fn runtime_state_size() -> i64 { 128 }
fn runtime_state_dispatch_prev_offset() -> i64 { 120 }
fn runtime_state_bump_offset() -> i64 { 0 }
-- Base of the CURRENT bump segment's allocatable range. Written at
-- startup and on every segment chain; alloc_bump_restore_same_segment
-- proves same-segment membership against it (segments are disjoint
-- mappings, so [base, bump] containment is exact). Runtime twin:
-- alloc_bump_base_offset in runtime/alloc.weft.
fn runtime_state_bump_base_offset() -> i64 { 112 }
fn runtime_state_rc_heap_offset() -> i64 { 8 }
fn runtime_state_fiber_prompt_offset() -> i64 { 16 }
fn runtime_state_fiber_done_offset() -> i64 { 24 }
fn runtime_state_bump_end_offset() -> i64 { 32 }
fn runtime_state_deferred_ops_offset() -> i64 { 40 }
fn runtime_state_deferred_prompt_offset() -> i64 { 48 }
fn runtime_state_deferred_effect_hash_offset() -> i64 { 56 }
fn runtime_state_deferred_op_count_offset() -> i64 { 64 }
fn runtime_state_deferred_prev_offset() -> i64 { 72 }
fn runtime_state_deferred_cleanup_desc_offset() -> i64 { 80 }
fn runtime_state_deferred_cleanup_segment_offset() -> i64 { 88 }
fn deferred_runtime_context_size() -> i64 { 40 }
fn deferred_runtime_context_ops_offset() -> i64 { 0 }
fn deferred_runtime_context_prompt_offset() -> i64 { 8 }
fn deferred_runtime_context_effect_hash_offset() -> i64 { 16 }
fn deferred_runtime_context_op_count_offset() -> i64 { 24 }
fn deferred_runtime_context_prev_offset() -> i64 { 32 }
fn runtime_bump_segment_size() -> i64 { 536870912 }

fn cg_bump_tmp(dst: i64, size_reg: i64) -> i64 {
  if dst != 9 and size_reg != 9 { 9 } else { 10 }
}

fn cg_stack_frame_default_size() -> i64 { 2048 }
fn cg_stack_adjust_chunk_size() -> i64 { 4080 }
fn cg_spill_inline_offset_limit() -> i64 { 32760 }

fn cg_align16(size: i64) -> i64 {
  let rem = size % 16
  if rem == 0 { size } else { size + (16 - rem) }
}

fn cg_bump_emit_grow(code: i64, dst: i64, size_reg: i64) -> i64 {
  -- Preserve requested size before setting up the mmap syscall.
  if size_reg != 12 { bu32(code, encode_add_imm(12, size_reg, 0)) } else { 0 }
  bu32(code, encode_add_imm(14, 12, runtime_state_size()))
  emit_mov_imm_safe(code, 1, runtime_bump_segment_size())
  bu32(code, encode_cmp(14, 1))
  let default_len_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(1, 14, 0))
  cg_patch_b_cond(code, default_len_pos, 9, buf_len(code))
  bu32(code, encode_add_imm(13, 1, 0))
  -- mmap(NULL, len, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, -1, 0)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  bu32(code, encode_movz(0, 0, 0))
  bu32(code, encode_movz(2, 3, 0))
  bu32(code, encode_movz(3, 4098, 0))
  bu32(code, encode_movn(4, 0))
  bu32(code, encode_movz(5, 0, 0))
  bu32(code, encode_svc())
  let ok_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_brk(5))
  cg_patch_b_cond(code, ok_pos, 3, buf_len(code))
  bu32(code, encode_add_imm(17, 0, runtime_state_size()))
  bu32(code, encode_add_reg(10, 17, 12))
  bu32(code, cg_str(10, 28, runtime_state_bump_offset()))
  bu32(code, cg_str(17, 28, runtime_state_bump_base_offset()))
  bu32(code, encode_add_reg(11, 0, 13))
  bu32(code, cg_str(11, 28, runtime_state_bump_end_offset()))
  if dst != 17 { bu32(code, encode_add_imm(dst, 17, 0)) } else { 0 }
}

fn cg_bump_alloc_reg(code: i64, dst: i64, size_reg: i64) -> i64 {
  bu32(code, cg_ldr(dst, 28, runtime_state_bump_offset()))
  let tmp = cg_bump_tmp(dst, size_reg)
  bu32(code, encode_add_reg(tmp, dst, size_reg))
  bu32(code, cg_ldr(11, 28, runtime_state_bump_end_offset()))
  bu32(code, encode_cmp(tmp, 11))
  let grow_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_str(tmp, 28, runtime_state_bump_offset()))
  let done_pos = buf_len(code)
  bu32(code, 0)
  let grow_start = buf_len(code)
  cg_bump_emit_grow(code, dst, size_reg)
  let done = buf_len(code)
  cg_patch_b_cond(code, grow_pos, 8, grow_start)
  cg_patch_b(code, done_pos, done)
}

fn cg_bump_alloc_imm(code: i64, dst: i64, size: i64) -> i64 {
  bu32(code, cg_ldr(dst, 28, runtime_state_bump_offset()))
  let tmp = cg_bump_tmp(dst, 0)
  -- ADD's imm12 caps at 4095. In the raw encoding, bit 22 of the
  -- immediate term is the LSL-12 flag and bit 23 is unallocated, so an
  -- oversized size used to either silently over-advance the bump
  -- pointer by size*4096 (4096..8191, e.g. a 6KB string literal leaked
  -- 8.5MB per execution) or emit an undefined instruction and SIGILL
  -- (>= 8192). Bigger sizes go through a register; x13/x14 are dead in
  -- the fast path (the grow arm sets them up itself).
  if size > 4095 {
    let size_tmp = if dst == 13 { 14 } else { 13 }
    emit_mov_imm_safe(code, size_tmp, size)
    bu32(code, encode_add_reg(tmp, dst, size_tmp))
  } else {
    bu32(code, encode_add_imm(tmp, dst, size))
  }
  bu32(code, cg_ldr(11, 28, runtime_state_bump_end_offset()))
  bu32(code, encode_cmp(tmp, 11))
  let grow_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_str(tmp, 28, runtime_state_bump_offset()))
  let done_pos = buf_len(code)
  bu32(code, 0)
  let grow_start = buf_len(code)
  emit_mov_imm_safe(code, 12, size)
  cg_bump_emit_grow(code, dst, 12)
  let done = buf_len(code)
  cg_patch_b_cond(code, grow_pos, 8, grow_start)
  cg_patch_b(code, done_pos, done)
}

fn find_main_in_fmap(fm: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let owner_hash = mem_load64_at(d + i * 40 + 32, 0)
    if owner_hash == 0 {
      let e_src = mem_load64_at(d + i * 40 + 24, 0)
      let e_ns = mem_load64_at(d + i * 40, 0)
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      if src_eq(e_src, e_ns, e_nl, "main") == 1 {
        result = mem_load64_at(d + i * 40 + 16, 0)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Emit startup code: save argc/argv, mmap heap, init runtime, pass argc/argv to main.
fn emit_heap_init(code: i64) -> i64 {
  -- STP x29, x30, [sp, #-16]! (save link register to return to dyld)
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  -- Save argc (x0) and argv (x1) in callee-saved registers across mmap
  bu32(code, encode_add_imm(25, 0, 0))
  bu32(code, encode_add_imm(26, 1, 0))
  -- mmap syscall: x16 = 0x020000C5 (BSD class | 197)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  -- x0 = 0 (addr = NULL)
  bu32(code, encode_movz(0, 0, 0))
  -- x1 = initial bump segment length
  emit_mov_imm_safe(code, 1, runtime_bump_segment_size())
  -- x2 = 3 (PROT_READ | PROT_WRITE)
  bu32(code, encode_movz(2, 3, 0))
  -- x3 = 4098 (MAP_PRIVATE | MAP_ANON)
  bu32(code, encode_movz(3, 4098, 0))
  -- x4 = -1 (fd)
  bu32(code, encode_movn(4, 0))
  -- x5 = 0 (offset)
  bu32(code, encode_movz(5, 0, 0))
  -- SVC #0x80
  bu32(code, encode_svc())
  -- MOV x28, x0 (runtime state base)
  bu32(code, encode_add_imm(28, 0, 0))
  -- runtime_state.bump = mmap_base + runtime_state_size
  bu32(code, encode_add_imm(17, 0, runtime_state_size()))
  bu32(code, cg_str(17, 28, runtime_state_bump_offset()))
  bu32(code, cg_str(17, 28, runtime_state_bump_base_offset()))
  -- runtime_state.bump_end = mmap_base + initial segment length
  bu32(code, encode_add_reg(17, 0, 1))
  bu32(code, cg_str(17, 28, runtime_state_bump_end_offset()))
  -- runtime_state.default_rc_heap = 0 (lazy)
  bu32(code, encode_movz(17, 0, 0))
  bu32(code, cg_str(17, 28, runtime_state_rc_heap_offset()))
  -- runtime_state.fiber/deferred fields = 0
  bu32(code, cg_str(17, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, cg_str(17, 28, runtime_state_fiber_done_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_cleanup_segment_offset()))
  -- MOV x27, #0 (handler stack = empty)
  bu32(code, encode_movz(27, 0, 0))
  -- Restore argc/argv as arguments to main (x0=argc, x1=argv)
  bu32(code, encode_add_imm(0, 25, 0))
  bu32(code, encode_add_imm(1, 26, 0))
  code
}

fn bytes_set_u32(code: i64, pos: i64, val: i64) -> i64 {
  let d = buf_ptr(code)
  mem_store8_at(d + pos, 0, val - val / 256 * 256)
  mem_store8_at(d + pos + 1, 0, val / 256 - val / 65536 * 256)
  mem_store8_at(d + pos + 2, 0, val / 65536 - val / 16777216 * 256)
  mem_store8_at(d + pos + 3, 0, val / 16777216 - val / 4294967296 * 256)
  0
}

fn patch_forward_refs(fm: i64, code: i64) -> i64 {
  let pn = mem_load64_at(fm + 32, 0)
  let pd = mem_load64_at(fm + 24, 0)
  let mut i = 0
  while i < pn {
    let pos = mem_load64_at(pd + i * 32, 0)
    let ns = mem_load64_at(pd + i * 32 + 8, 0)
    let nl = mem_load64_at(pd + i * 32 + 16, 0)
    let p_src = mem_load64_at(pd + i * 32 + 24, 0)
    let adr_patch = if p_src == 0 and nl == 0 - 1 { 1 } else { 0 }
    let branch_patch = if p_src == 0 and nl == 0 - 2 { 1 } else { 0 }
    let target = if p_src == 0 and nl <= 0 {
      let typed_target = mono_cache_lookup(fmap_mono_cache(fm), ns)
      if typed_target > 1 {
        typed_target
      } else {
        let hash_target = fmap_lookup_by_hash(fm, ns)
        if hash_target != 0 { hash_target } else { typed_target }
      }
    } else {
      let legacy_target = fmap_lookup(fm, p_src, ns, nl)
      if legacy_target != 0 {
        legacy_target
      } else {
        let name_hash = str_hash(p_src, ns, nl)
        let hash_target = fmap_lookup_by_hash(fm, name_hash)
        if hash_target != 0 { hash_target } else { mono_cache_lookup(fmap_mono_cache(fm), name_hash) }
      }
    }
    if target == 0 {
      eprint("error: unresolved forward reference: ")
      if p_src != 0 {
        sys_write(2, p_src + ns, nl)
      } else {
        eprint("h")
        eprint_i(ns)
      }
      eprint("\n")
      fmap_inc_emit_error_count(fm)
      bytes_set_u32(code, pos, encode_brk(3))
    } else {
      if adr_patch == 1 {
        bytes_set_u32(code, pos, encode_adr(17, target - pos))
      } else { if branch_patch == 1 {
        bytes_set_u32(code, pos, encode_b(target - pos))
      } else {
        bytes_set_u32(code, pos, encode_bl(target - pos))
      } }
    }
    i = i + 1
  }
  0
}

-- ======================================================================
-- Scope: linked list of {name_start, name_len, reg, next, type, value_origin}
-- ======================================================================

fn scope_new() -> i64 { 0 }
fn scope_push_typed_meta(scope: i64, ns: i64, nl: i64, reg: i64, ty: i64, value_origin: i64) -> i64 {
  let e = cg_alloc_bytes(48)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e + 8, 0, nl)
  mem_store64_at(e + 16, 0, reg)
  mem_store64_at(e + 24, 0, scope)
  mem_store64_at(e + 32, 0, ty)
  mem_store64_at(e + 40, 0, value_origin)
  e
}

fn scope_push_typed(scope: i64, ns: i64, nl: i64, reg: i64, ty: i64) -> i64 {
  scope_push_typed_meta(scope, ns, nl, reg, ty, 0)
}

fn scope_push(scope: i64, ns: i64, nl: i64, reg: i64) -> i64 {
  scope_push_typed(scope, ns, nl, reg, 0)
}

fn scope_lookup(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns register number or -1 if not found
  if scope == 0 { 0 - 999 }
  else {
    let s_ns = mem_load64_at(scope, 0)
    let s_nl = mem_load64_at(scope + 8, 0)
    if s_nl == nl {
      -- Compare src[ns..ns+nl] with src[s_ns..s_ns+nl]
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        mem_load64_at(scope + 16, 0)
      } else {
        scope_lookup(mem_load64_at(scope + 24, 0), src, ns, nl)
      }
    } else {
      scope_lookup(mem_load64_at(scope + 24, 0), src, ns, nl)
    }
  }
}

fn scope_lookup_type(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if scope == 0 { 0 }
  else {
    let s_ns = mem_load64_at(scope, 0)
    let s_nl = mem_load64_at(scope + 8, 0)
    if s_nl == nl {
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        mem_load64_at(scope + 32, 0)
      } else {
        scope_lookup_type(mem_load64_at(scope + 24, 0), src, ns, nl)
      }
    } else {
      scope_lookup_type(mem_load64_at(scope + 24, 0), src, ns, nl)
    }
  }
}

fn ttable_new() -> i64 {
  let h = cg_alloc_bytes(112)
  let d = cg_alloc_bytes(6400)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 100)
  -- Loaded files list for use dedup (stored at h+24)
  mem_store64_at(h + 24, 0, nlist_new())
  -- Conformance table pointer (stored at h+32, set by compile)
  mem_store64_at(h + 32, 0, 0)
  -- Current function's tparams (stored at h+40, set by check_fn)
  mem_store64_at(h + 40, 0, 0)
  -- Trusted source buffers for sealed runtime/platform internals (h+48)
  mem_store64_at(h + 48, 0, nlist_new())
  -- Strict root source buffers loaded from ordinary path-aware CLI inputs (h+56)
  mem_store64_at(h + 56, 0, nlist_new())
  -- Sources allowed to grant import trust while the parser owns use-loading (h+64)
  mem_store64_at(h + 64, 0, nlist_new())
  -- Source registry: (buf, len, path_ptr, path_len) per loaded buffer (h+72).
  -- Lets diagnostics resolve an absolute span to its owning file.
  mem_store64_at(h + 72, 0, nlist_new())
  -- Variant-name hash index (h+80, 2r slice 1): lazily built, staleness-
  -- checked against the entry count. Kills the O(types x variants)
  -- linear scan under the payload-less-ctor classifiers.
  mem_store64_at(h + 80, 0, 0)
  mem_store64_at(h + 88, 0, 0)
  -- Import in-progress stack for cycle detection (h+96, 4a S6): files whose
  -- use-loading has begun but not finished. A use that resolves to a file on
  -- this stack is a circular import and gets a diagnostic; a file merely in
  -- the h+24 loaded list is a diamond re-import and stays silently deduped.
  mem_store64_at(h + 96, 0, nlist_new())
  -- Current function's declared effect sig (h+104, 4c): set by check_fn
  -- like the tparams slot; lets synth-time perform checking find the
  -- parameterized atom that instantiates a generic effect's op types.
  mem_store64_at(h + 104, 0, 0)
  h
}
fn ttable_sources(tt: i64) -> i64 { mem_load64_at(tt + 72, 0) }
fn ttable_register_source(tt: i64, buf: i64, len: i64, path_ptr: i64, path_len: i64) -> i64 {
  let e = cg_alloc_bytes(32)
  mem_store64_at(e, 0, buf)
  mem_store64_at(e + 8, 0, len)
  mem_store64_at(e + 16, 0, path_ptr)
  mem_store64_at(e + 24, 0, path_len)
  nlist_add(ttable_sources(tt), e)
}
fn ttable_find_source_entry(tt: i64, span: i64) -> i64 {
  -- Absolute span -> registry entry whose [buf, buf+len) contains it; 0 if none.
  let sources = ttable_sources(tt)
  let n = nlist_len(sources)
  let mut i = 0
  let mut found = 0
  while i < n {
    let e = nlist_get(sources, i)
    let buf = mem_load64_at(e, 0)
    let len = mem_load64_at(e + 8, 0)
    if span >= buf and span < buf + len { found = e i = n } else { i = i + 1 }
  }
  found
}
fn ttable_set_ct(tt: i64, ct: i64) -> i64 { mem_store64_at(tt + 32, 0, ct) 0 }
fn ttable_get_ct(tt: i64) -> i64 { mem_load64_at(tt + 32, 0) }
fn ttable_set_tparams(tt: i64, tp: i64) -> i64 { mem_store64_at(tt + 40, 0, tp) 0 }
fn ttable_get_tparams(tt: i64) -> i64 { mem_load64_at(tt + 40, 0) }
fn ttable_set_current_fn_eff(tt: i64, eff: i64) -> i64 { mem_store64_at(tt + 104, 0, eff) 0 }
fn ttable_get_current_fn_eff(tt: i64) -> i64 { mem_load64_at(tt + 104, 0) }
fn ttable_get_trusted_sources(tt: i64) -> i64 { mem_load64_at(tt + 48, 0) }
fn ttable_get_strict_sources(tt: i64) -> i64 { mem_load64_at(tt + 56, 0) }
fn ttable_get_source_trust_grant_sources(tt: i64) -> i64 { mem_load64_at(tt + 64, 0) }
fn ttable_source_is_trusted(tt: i64, src: i64) -> i64 {
  let trusted = ttable_get_trusted_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(trusted) {
    if nlist_get(trusted, i) == src {
      found = 1
      i = nlist_len(trusted)
    } else { i = i + 1 }
  }
  found
}
fn ttable_mark_trusted_source(tt: i64, src: i64) -> i64 {
  if ttable_source_is_trusted(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_trusted_sources(tt), src) }
}
fn ttable_source_can_grant_trust(tt: i64, src: i64) -> i64 {
  let sources = ttable_get_source_trust_grant_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(sources) {
    if nlist_get(sources, i) == src {
      found = 1
      i = nlist_len(sources)
    } else { i = i + 1 }
  }
  found
}
fn ttable_mark_source_trust_grant_source(tt: i64, src: i64) -> i64 {
  if ttable_source_can_grant_trust(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_source_trust_grant_sources(tt), src) }
}
fn ttable_source_is_strict(tt: i64, src: i64) -> i64 {
  let strict = ttable_get_strict_sources(tt)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(strict) {
    if nlist_get(strict, i) == src {
      found = 1
      i = nlist_len(strict)
    } else { i = i + 1 }
  }
  found
}
fn ttable_mark_strict_source(tt: i64, src: i64) -> i64 {
  if ttable_source_is_strict(tt, src) == 1 { 0 }
  else { nlist_add(ttable_get_strict_sources(tt), src) }
}
-- Entry layout: [ns(8), nl(8), kind(8), nfields(8), fields(8), tparams(8), src(8)] = 56 bytes
-- src stored per entry for cross-file name resolution
fn ttable_add(tt: i64, src: i64, ns: i64, nl: i64, kind: i64, nfields: i64, fields: i64, tparams: i64) -> i64 {
  let n = mem_load64_at(tt + 8, 0)
  let cap = mem_load64_at(tt + 16, 0)
  if n >= cap {
    let d = mem_load64_at(tt, 0)
    let new_cap = cap * 2
    let new_d = cg_alloc_bytes(new_cap * 64)
    mem_copy(new_d, d, n * 64)
    mem_store64_at(tt, 0, new_d)
    mem_store64_at(tt + 16, 0, new_cap)
    0
  } else { 0 }
  let d = mem_load64_at(tt, 0)
  mem_store64_at(d + n * 64, 0, ns)
  mem_store64_at(d + n * 64 + 8, 0, nl)
  mem_store64_at(d + n * 64 + 16, 0, kind)
  mem_store64_at(d + n * 64 + 24, 0, nfields)
  mem_store64_at(d + n * 64 + 32, 0, fields)
  mem_store64_at(d + n * 64 + 40, 0, tparams)
  mem_store64_at(d + n * 64 + 48, 0, src)
  -- Cached name hash (offset 56): lookups probe this integer instead of
  -- re-hashing name bytes per entry per query. Effect entries (kind 3)
  -- hash with effect_name_hash; type entries with type_name_hash.
  mem_store64_at(d + n * 64 + 56, 0, if kind == 3 { effect_name_hash(src, ns, nl) } else { type_name_hash(src, ns, nl) })
  mem_store64_at(tt + 8, 0, n + 1)
  tt
}
fn ttable_lookup(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns pointer to type entry, or 0 if not found
  -- Uses entry's stored src for cross-file correctness
  let n = mem_load64_at(tt + 8, 0)
  let d = mem_load64_at(tt, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_ns = mem_load64_at(d + i * 64, 0)
    let e_nl = mem_load64_at(d + i * 64 + 8, 0)
    if e_nl == nl {
      let e_src = mem_load64_at(d + i * 64 + 48, 0)
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        result = d + i * 64
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
-- Get field index by name from a record type entry
-- entry_src = the source buffer the entry was parsed from
-- caller_src = the source buffer the lookup name is from
fn ttable_field_index(entry: i64, entry_src: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let nfields = mem_load64_at(entry + 24, 0)
  let fields = mem_load64_at(entry + 32, 0)
  let mut i = 0
  let mut result = 0 - 1
  while i < nfields {
    let f_ns = mem_load64_at(fields + i * 24, 0)
    let f_nl = mem_load64_at(fields + i * 24 + 8, 0)
    if f_nl == field_nl {
      if src_eq_at(caller_src, field_ns, entry_src + f_ns, 0, field_nl) == 1 {
        result = i
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Find variant info by name. Returns tag_hash or -1 if not found.
-- Uses the entry's stored src for cross-file name comparison.
fn ttable_find_variant(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let v = ttable_variant_scan(tt, src, ns, nl, 0, 2, 0)
  if v == 0 { 0 - 1 } else { mem_load64_at(v + 16, 0) }
}

fn ttable_find_field_by_type_hash(tt: i64, type_hash: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = mem_load64_at(tt + 8, 0)
  let d = mem_load64_at(tt, 0)
  let mut i = 0
  let mut result = 0 - 1
  while i < n {
    let kind = mem_load64_at(d + i * 64 + 16, 0)
    if kind == 0 {
      let entry_src = mem_load64_at(d + i * 64 + 48, 0)
      let type_ns = mem_load64_at(d + i * 64, 0)
      let type_nl = mem_load64_at(d + i * 64 + 8, 0)
      if str_hash(entry_src, type_ns, type_nl) == type_hash {
        let idx = ttable_field_index(d + i * 64, entry_src, src, ns, nl)
        if idx >= 0 { result = idx i = n } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn ttable_hash_has_kind(tt: i64, target_hash: i64, target_kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut found = 0
    while i < n {
      let entry = d + i * 64
      let kind = mem_load64_at(entry + 16, 0)
      if kind == target_kind {
        let entry_src = mem_load64_at(entry + 48, 0)
        let ns = mem_load64_at(entry, 0)
        let nl = mem_load64_at(entry + 8, 0)
        let entry_hash = mem_load64_at(entry, 56)
        if entry_hash == target_hash {
          found = 1
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

fn ttable_hash_is_trait(tt: i64, target_hash: i64) -> i64 {
  ttable_hash_has_kind(tt, target_hash, 3)
}

-- 4c: entry lookup by cached name hash + kind. Returns entry ptr or 0.
fn ttable_find_entry_by_hash_kind(tt: i64, target_hash: i64, target_kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut found = 0
    while i < n {
      let entry = d + i * 64
      if mem_load64_at(entry + 16, 0) == target_kind {
        if mem_load64_at(entry, 56) == target_hash {
          found = entry
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    found
  }
}

fn ttable_entry_tparams(entry: i64) -> i64 {
  if entry == 0 { 0 } else { mem_load64_at(entry + 40, 0) }
}

fn cg_layout_unknown() -> i64 { 0 - 1 }
fn cg_layout_word_size() -> i64 { 8 }
fn cg_layout_handle_size() -> i64 { 8 }
fn cg_layout_rc_header_size() -> i64 { 40 }

fn cg_layout_align_up(value: i64, align: i64) -> i64 {
  if value < 0 { cg_layout_unknown() }
  else { if align <= 1 { value }
  else {
    let rem = value - value / align * align
    if rem == 0 { value } else { value + align - rem }
  } }
}

fn cg_layout_max(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

fn cg_layout_prim_size(prim: i64) -> i64 {
  match prim {
    2 -> 1
    3 -> 0
    5 -> 4
    6 -> 1
    7 -> 2
    8 -> 1
    9 -> 2
    10 -> 4
    14 -> 4
    _ -> 8
  }
}

fn cg_layout_prim_align(prim: i64) -> i64 {
  let size = cg_layout_prim_size(prim)
  if size <= 0 { 1 } else { size }
}

fn cg_layout_ttable_lookup_kind_by_hash(tt: i64, type_hash: i64, kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      if mem_load64_at(entry + 16, 0) == kind {
        let entry_src = mem_load64_at(entry + 48, 0)
        let type_ns = mem_load64_at(entry, 0)
        let type_nl = mem_load64_at(entry + 8, 0)
        if mem_load64_at(entry, 56) == type_hash {
          result = entry
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

fn cg_layout_record_entry(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 9 { 0 }
  else { if ty_is_rc(ty) == 1 { 0 }
  else { cg_layout_ttable_lookup_kind_by_hash(tt, ty_f1(ty), 0) } } }
}

fn cg_layout_variant_entry(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 9 { 0 }
  else { if ty_is_rc(ty) == 1 { 0 }
  else { cg_layout_ttable_lookup_kind_by_hash(tt, ty_f1(ty), 1) } } }
}

fn cg_layout_subst_for_entry_ty(entry: i64, ty: i64) -> i64 {
  let tparams = if entry == 0 { 0 } else { mem_load64_at(entry + 40, 0) }
  let type_args = if ty == 0 { 0 } else { ty_f3(ty) }
  cg_build_subst(tparams, type_args)
}

fn cg_layout_field_type_at(entry: i64, ty: i64, index: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
    if index < 0 or index >= nfields { 0 }
    else {
      let fields = mem_load64_at(entry + 32, 0)
      let raw_ty = mem_load64_at(fields + index * 24 + 16, 0)
      ty_subst(raw_ty, cg_layout_subst_for_entry_ty(entry, ty))
    }
  }
}

fn cg_layout_payload_list_size(tt: i64, payloads: i64) -> i64 {
  if payloads == 0 { 0 }
  else {
    let mut offset = 0
    let mut max_align = 1
    let mut ok = 1
    let n = nlist_len(payloads)
    for i in 0..n {
      let pty = nlist_get(payloads, i)
      let align = cg_layout_inline_align(tt, pty)
      let size = cg_layout_inline_size(tt, pty)
      if align < 0 or size < 0 {
        ok = 0
      } else {
        offset = cg_layout_align_up(offset, align)
        offset = offset + size
        max_align = cg_layout_max(max_align, align)
      }
    }
    if ok == 0 { cg_layout_unknown() } else { cg_layout_align_up(offset, max_align) }
  }
}

fn cg_layout_payload_list_align(tt: i64, payloads: i64) -> i64 {
  if payloads == 0 { 1 }
  else {
    let mut max_align = 1
    let mut ok = 1
    let n = nlist_len(payloads)
    for i in 0..n {
      let align = cg_layout_inline_align(tt, nlist_get(payloads, i))
      if align < 0 { ok = 0 } else { max_align = cg_layout_max(max_align, align) }
    }
    if ok == 0 { cg_layout_unknown() } else { max_align }
  }
}

fn cg_layout_record_inline_size(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
    let mut offset = 0
    let mut max_align = 1
    let mut ok = 1
    for i in 0..nfields {
      let fty = cg_layout_field_type_at(entry, ty, i)
      let align = cg_layout_inline_align(tt, fty)
      let size = cg_layout_inline_size(tt, fty)
      if align < 0 or size < 0 {
        ok = 0
      } else {
        offset = cg_layout_align_up(offset, align)
        offset = offset + size
        max_align = cg_layout_max(max_align, align)
      }
    }
    if ok == 0 { cg_layout_unknown() } else { cg_layout_align_up(offset, max_align) }
  }
}

fn cg_layout_record_inline_align(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
    let mut max_align = 1
    let mut ok = 1
    for i in 0..nfields {
      let align = cg_layout_inline_align(tt, cg_layout_field_type_at(entry, ty, i))
      if align < 0 { ok = 0 } else { max_align = cg_layout_max(max_align, align) }
    }
    if ok == 0 { cg_layout_unknown() } else { max_align }
  }
}

fn cg_layout_variant_inline_size(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_variant_entry(tt, ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nvariants = mem_load64_at(entry + 24, 0)
    let variants = mem_load64_at(entry + 32, 0)
    let subst = cg_layout_subst_for_entry_ty(entry, ty)
    let mut max_payload = 0
    let mut max_align = 8
    let mut ok = 1
    for vi in 0..nvariants {
      let raw_payloads = mem_load64_at(variants + vi * 40 + 32, 0)
      let payloads = type_list_subst(raw_payloads, subst)
      let psize = cg_layout_payload_list_size(tt, payloads)
      let palign = cg_layout_payload_list_align(tt, payloads)
      if psize < 0 or palign < 0 {
        ok = 0
      } else {
        max_payload = cg_layout_max(max_payload, psize)
        max_align = cg_layout_max(max_align, palign)
      }
    }
    if ok == 0 { cg_layout_unknown() }
    else {
      let payload_offset = cg_layout_align_up(8, max_align)
      cg_layout_align_up(payload_offset + max_payload, max_align)
    }
  }
}

fn cg_layout_variant_inline_align(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_variant_entry(tt, ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nvariants = mem_load64_at(entry + 24, 0)
    let variants = mem_load64_at(entry + 32, 0)
    let subst = cg_layout_subst_for_entry_ty(entry, ty)
    let mut max_align = 8
    let mut ok = 1
    for vi in 0..nvariants {
      let payloads = type_list_subst(mem_load64_at(variants + vi * 40 + 32, 0), subst)
      let palign = cg_layout_payload_list_align(tt, payloads)
      if palign < 0 { ok = 0 } else { max_align = cg_layout_max(max_align, palign) }
    }
    if ok == 0 { cg_layout_unknown() } else { max_align }
  }
}

fn cg_layout_nullable_handle_size(tt: i64, ty: i64) -> i64 {
  if ty == 0 { cg_layout_unknown() }
  else { if ty_tag(ty) != 3 { cg_layout_unknown() }
  else {
    let lhs = ty_f1(ty)
    let rhs = ty_f2(ty)
    if cg_ty_is_nil(lhs) == 1 {
      if cg_layout_storage_size(tt, rhs) == cg_layout_handle_size() { cg_layout_handle_size() } else { cg_layout_unknown() }
    } else { if cg_ty_is_nil(rhs) == 1 {
      if cg_layout_storage_size(tt, lhs) == cg_layout_handle_size() { cg_layout_handle_size() } else { cg_layout_unknown() }
    } else { cg_layout_unknown() } }
  } }
}

fn cg_layout_inline_size(tt: i64, ty: i64) -> i64 {
  if ty == 0 { cg_layout_unknown() }
  else {
    let tag = ty_tag(ty)
    match tag {
      2 -> cg_layout_prim_size(ty_f1(ty))
      3 -> cg_layout_nullable_handle_size(tt, ty)
      6 -> cg_layout_handle_size()
      8 -> {
        let payload_size = cg_layout_inline_size(tt, ty_f2(ty))
        if payload_size < 0 { cg_layout_unknown() } else { cg_layout_align_up(8 + payload_size, 8) }
      }
      9 -> {
        if ty_is_rc(ty) == 1 { cg_layout_handle_size() }
        else {
          let record_entry = cg_layout_record_entry(tt, ty)
          if record_entry != 0 { cg_layout_record_inline_size(tt, ty) }
          else {
            let variant_entry = cg_layout_variant_entry(tt, ty)
            if variant_entry != 0 { cg_layout_variant_inline_size(tt, ty) } else { cg_layout_handle_size() }
          }
        }
      }
      14 -> cg_layout_handle_size()
      15 -> cg_layout_word_size()
      16 -> cg_layout_word_size()
      17 -> cg_layout_word_size()
      18 -> cg_layout_inline_size(tt, ty_unique_inner(ty))
      19 -> cg_layout_inline_size(tt, ty_owned_inner(ty))
      _ -> cg_layout_unknown()
    }
  }
}

fn cg_layout_inline_align(tt: i64, ty: i64) -> i64 {
  if ty == 0 { cg_layout_unknown() }
  else {
    let tag = ty_tag(ty)
    match tag {
      2 -> cg_layout_prim_align(ty_f1(ty))
      3 -> if cg_layout_nullable_handle_size(tt, ty) == cg_layout_handle_size() { cg_layout_word_size() } else { cg_layout_unknown() }
      6 -> cg_layout_word_size()
      8 -> 8
      9 -> {
        if ty_is_rc(ty) == 1 { cg_layout_word_size() }
        else {
          let record_entry = cg_layout_record_entry(tt, ty)
          if record_entry != 0 { cg_layout_record_inline_align(tt, ty) }
          else {
            let variant_entry = cg_layout_variant_entry(tt, ty)
            if variant_entry != 0 { cg_layout_variant_inline_align(tt, ty) } else { cg_layout_word_size() }
          }
        }
      }
      14 -> cg_layout_word_size()
      15 -> cg_layout_word_size()
      16 -> cg_layout_word_size()
      17 -> cg_layout_word_size()
      18 -> cg_layout_inline_align(tt, ty_unique_inner(ty))
      19 -> cg_layout_inline_align(tt, ty_owned_inner(ty))
      _ -> cg_layout_unknown()
    }
  }
}

fn cg_layout_storage_size(tt: i64, ty: i64) -> i64 {
  if ty == 0 { cg_layout_unknown() }
  else {
    let tag = ty_tag(ty)
    match tag {
      2 -> cg_layout_prim_size(ty_f1(ty))
      3 -> cg_layout_nullable_handle_size(tt, ty)
      6 -> cg_layout_handle_size()
      8 -> cg_layout_handle_size()
      9 -> cg_layout_handle_size()
      14 -> cg_layout_handle_size()
      15 -> cg_layout_word_size()
      16 -> cg_layout_word_size()
      17 -> cg_layout_word_size()
      18 -> cg_layout_storage_size(tt, ty_unique_inner(ty))
      19 -> cg_layout_storage_size(tt, ty_owned_inner(ty))
      _ -> cg_layout_unknown()
    }
  }
}

fn cg_layout_storage_align(tt: i64, ty: i64) -> i64 {
  if ty == 0 { cg_layout_unknown() }
  else {
    let tag = ty_tag(ty)
    match tag {
      2 -> cg_layout_prim_align(ty_f1(ty))
      3 -> if cg_layout_nullable_handle_size(tt, ty) == cg_layout_handle_size() { cg_layout_word_size() } else { cg_layout_unknown() }
      6 -> cg_layout_word_size()
      8 -> cg_layout_word_size()
      9 -> cg_layout_word_size()
      14 -> cg_layout_word_size()
      15 -> cg_layout_word_size()
      16 -> cg_layout_word_size()
      17 -> cg_layout_word_size()
      18 -> cg_layout_storage_align(tt, ty_unique_inner(ty))
      19 -> cg_layout_storage_align(tt, ty_owned_inner(ty))
      _ -> cg_layout_unknown()
    }
  }
}

fn cg_layout_vector_record_mode() -> i64 { 7 }
-- Managed word elements (2q slice 2): stores retain, element drops
-- release, loads retain (call results are owned). Runtime twin:
-- vector_storage_managed_mode.
fn cg_layout_vector_managed_mode() -> i64 { 8 }

fn cg_layout_vector_plain_record_field_eligible(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if cg_ty_is_managed(ty) == 1 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      2 -> if cg_layout_prim_size(ty_f1(ty)) > 0 { 1 } else { 0 }
      15 -> 1
      _ -> 0
    }
  } }
}

fn cg_layout_vector_record_inline_eligible(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  if entry == 0 { 0 }
  else {
    let size = cg_layout_record_inline_size(tt, ty)
    if size <= 0 { 0 }
    else {
      let nfields = mem_load64_at(entry + 24, 0)
      let mut ok = 1
      for i in 0..nfields {
        if cg_layout_vector_plain_record_field_eligible(tt, cg_layout_field_type_at(entry, ty, i)) != 1 {
          ok = 0
        } else { 0 }
      }
      ok
    }
  }
}

fn cg_layout_vector_element_size(tt: i64, ty: i64) -> i64 {
  if cg_layout_vector_record_inline_eligible(tt, ty) == 1 {
    cg_layout_record_inline_size(tt, ty)
  } else { cg_layout_storage_size(tt, ty) }
}

fn cg_layout_field_offset(tt: i64, record_ty: i64, field_index: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, record_ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
    if field_index < 0 or field_index >= nfields { cg_layout_unknown() }
    else {
      let mut offset = 0
      let mut result = cg_layout_unknown()
      let mut ok = 1
      for i in 0..nfields {
        let fty = cg_layout_field_type_at(entry, record_ty, i)
        let align = cg_layout_inline_align(tt, fty)
        let size = cg_layout_inline_size(tt, fty)
        if align < 0 or size < 0 {
          ok = 0
        } else {
          offset = cg_layout_align_up(offset, align)
          if i == field_index { result = offset }
          offset = offset + size
        }
      }
      if ok == 0 { cg_layout_unknown() } else { result }
    }
  }
}

fn cg_layout_field_size(tt: i64, record_ty: i64, field_index: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, record_ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let fty = cg_layout_field_type_at(entry, record_ty, field_index)
    if fty == 0 { cg_layout_unknown() } else { cg_layout_inline_size(tt, fty) }
  }
}

fn cg_layout_field_align(tt: i64, record_ty: i64, field_index: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, record_ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let fty = cg_layout_field_type_at(entry, record_ty, field_index)
    if fty == 0 { cg_layout_unknown() } else { cg_layout_inline_align(tt, fty) }
  }
}

fn cg_layout_rc_payload_size(tt: i64, ty: i64) -> i64 {
  if ty_is_rc(ty) != 1 { cg_layout_unknown() }
  else { cg_layout_inline_size(tt, ty_rc_inner(ty)) }
}

fn cg_layout_rc_block_size(tt: i64, ty: i64) -> i64 {
  let payload = cg_layout_rc_payload_size(tt, ty)
  if payload < 0 { cg_layout_unknown() } else { cg_layout_rc_header_size() + payload }
}

fn cg_layout_vector_element_mode(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if cg_layout_vector_record_inline_eligible(tt, ty) == 1 { cg_layout_vector_record_mode() }
  else { if cg_managed_drop_kind_for_ty(ty) == continuation_cleanup_kind_rc() { cg_layout_vector_managed_mode() }
  else { if ty_tag(ty) != 2 { 0 }
  else {
    let prim = ty_f1(ty)
    if prim == PRIM_BOOL() or prim == PRIM_U8() { 1 }
    else { if prim == PRIM_I8() { 2 }
    else { if prim == PRIM_U16() { 3 }
    else { if prim == PRIM_I16() { 4 }
    else { if prim == PRIM_U32() or prim == PRIM_F32() { 5 }
    else { if prim == PRIM_I32() { 6 } else { 0 } } } } } }
  } } } }
}

-- Simple string hash for variant tags (compile-time). The eight-wide
-- form is bit-identical to the byte loop: djb2's update distributes over
-- wrapping i64 arithmetic (h8 = h0*33^8 + sum b_i*33^(7-i)), and it cuts
-- the loop-carried multiply chain from eight to one per eight bytes.
-- Byte extraction shifts then masks, so the arithmetic-shift sign smear
-- never reaches a term.
fn str_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  let mut i = 0
  while i + 8 <= len {
    let w = mem_load64(src + start + i)
    let wide = h * 1406408618241
    let t0 = (w band 255) * 42618442977
    let t1 = ((w bshr 8) band 255) * 1291467969
    let t2 = ((w bshr 16) band 255) * 39135393
    let t3 = ((w bshr 24) band 255) * 1185921
    let t4 = ((w bshr 32) band 255) * 35937
    let t5 = ((w bshr 40) band 255) * 1089
    let t6 = ((w bshr 48) band 255) * 33
    let t7 = (w bshr 56) band 255
    h = wide + t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7
    i = i + 8
  }
  while i < len {
    h = h * 33 + mem_load8(src + start + i)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}

fn cg_ftypes_new() -> i64 { nlist_new() }

fn cg_ftypes_add(ft: i64, src: i64, ns: i64, nl: i64, ret_ty: i64, params: i64, effects: i64) -> i64 {
  let e = cg_alloc_bytes(56)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e + 8, 0, nl)
  mem_store64_at(e + 16, 0, ret_ty)
  mem_store64_at(e + 24, 0, params)
  mem_store64_at(e + 32, 0, src)
  mem_store64_at(e + 40, 0, 0)
  mem_store64_at(e + 48, 0, effects)
  nlist_add(ft, e)
}

fn cg_ftypes_find(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(ft) {
    let e = nlist_get(ft, i)
    let e_nl = mem_load64_at(e + 8, 0)
    if e_nl == nl {
      let e_src = mem_load64_at(e + 32, 0)
      if src_eq_at(src, ns, e_src + mem_load64_at(e, 0), 0, nl) == 1 {
        result = e
        i = nlist_len(ft)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn cg_ftypes_lookup_ret(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "rc_default_alloc") == 1 {
    ty_rc(ty_i64())
  } else {
    let e = cg_ftypes_find(ft, src, ns, nl)
    if e == 0 { 0 } else { mem_load64_at(e + 16, 0) }
  }
}

fn cg_param_nodes_to_type_list(params: i64) -> i64 {
  let result = nlist_new()
  if params == 0 { result }
  else {
    for i in 0..nlist_len(params) {
      nlist_add(result, node_f3(nlist_get(params, i)))
    }
    result
  }
}

fn cg_ftypes_lookup_fn_type(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = cg_ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 }
  else {
    let effects = mem_load64_at(e + 48, 0)
    ty_fn(cg_param_nodes_to_type_list(mem_load64_at(e + 24, 0)), mem_load64_at(e + 16, 0), if effects == 0 { ty_effect_pure() } else { effects })
  }
}

-- ======================================================================
-- Function map: parallel arrays of {name_start, name_len, offset, src, owner_hash}
-- ======================================================================

fn fmap_new() -> i64 {
  let h = cg_alloc_bytes(2816)
  let d = cg_alloc_bytes(80000)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, 2000)
  -- Patches list for forward BL references: [position, name_start, name_len, src_ptr]
  let pd = cg_alloc_bytes(256000)
  mem_store64_at(h + 24, 0, pd)
  mem_store64_at(h + 32, 0, 0)
  mem_store64_at(h + 40, 0, 8000)
  -- Type table pointer (set by compile)
  mem_store64_at(h + 48, 0, 0)
  -- Loop context: loop_start offset and break patches list
  mem_store64_at(h + 56, 0, 0)
  mem_store64_at(h + 64, 0, 0)
  -- Method map pointer
  mem_store64_at(h + 72, 0, mmap_new())
  -- Template map: generic function ASTs for monomorphisation (offset 80)
  mem_store64_at(h + 80, 0, mono_tmap_new())
  -- Specialisation cache: (spec_hash → code_offset) (offset 88)
  mem_store64_at(h + 88, 0, mono_cache_new())
  -- Handler inlining context stack (offset 96): compile-time handler scopes.
  -- Context layout: [eff_hash, clauses, clause_infos, nclauses, ops_ctr, prev].
  mem_store64_at(h + 96, 0, 0)
  -- RC elision metadata: enabled flag and elided local alias pair count.
  mem_store64_at(h + 104, 0, 1)
  mem_store64_at(h + 112, 0, 0)
  -- GOT patch list (offset 120): [code_position(8), got_index(8)] pairs
  let gp = cg_alloc_bytes(1024)
  mem_store64_at(h + 120, 0, gp)
  mem_store64_at(h + 128, 0, 0)
  mem_store64_at(h + 136, 0, 64)
  -- Active lexical defer cleanup stack and current loop cleanup boundary.
  mem_store64_at(h + 144, 0, nlist_new())
  mem_store64_at(h + 152, 0, 0)
  -- Codegen function signature map and current function return type.
  mem_store64_at(h + 160, 0, cg_ftypes_new())
  mem_store64_at(h + 168, 0, 0)
  -- Native bridge metadata: functions emitted from optimized IR.
  mem_store64_at(h + 176, 0, 0)
  -- Borrowed-parameter specialisation metadata for direct internal calls.
  mem_store64_at(h + 184, 0, borrow_tmap_new())
  mem_store64_at(h + 192, 0, borrow_cache_new())
  -- Alloc elision metadata: stack-rewritten local temporary/scoped handler count.
  mem_store64_at(h + 200, 0, 0)
  -- Active scoped arena lowering context for direct Alloc performs.
  mem_store64_at(h + 208, 0, 0)
  -- Current loop result counter for break(value) lowering.
  mem_store64_at(h + 216, 0, 0 - 1)
  -- Fusion metadata: pure stdlib list pipeline chains rewritten.
  mem_store64_at(h + 224, 0, 0)
  -- Active scoped Par lowering context for direct spawn/await emission.
  mem_store64_at(h + 232, 0, 0)
  -- Spawn emission metadata: scoped Par helper calls lowered directly.
  mem_store64_at(h + 240, 0, 0)
  -- Active deferred-fiber lowering context and rewrite count.
  mem_store64_at(h + 248, 0, 0)
  mem_store64_at(h + 256, 0, 0)
  -- Fiber-aware direct-call specialisation cache.
  mem_store64_at(h + 264, 0, fiber_cache_new())
  -- Effect evidence direct-call specialisation cache and active hidden-cell context.
  mem_store64_at(h + 272, 0, evidence_cache_new())
  mem_store64_at(h + 280, 0, 0)
  mem_store64_at(h + 288, 0, 0)
  mem_store64_at(h + 296, 0, 0)
  -- Direct vector word-access lowerings.
  mem_store64_at(h + 304, 0, 0)
  -- Active vector bounds facts, vector_len aliases, and upper-bound elisions.
  mem_store64_at(h + 312, 0, 0)
  mem_store64_at(h + 320, 0, 0)
  mem_store64_at(h + 328, 0, 0)
  -- Compile-time facts for mutable indices known nonnegative.
  mem_store64_at(h + 336, 0, 0)
  -- Fully proven vector accesses that omit null, lower, and upper checks.
  mem_store64_at(h + 344, 0, 0)
  -- Active hoisted vector data pointers and metrics.
  mem_store64_at(h + 352, 0, 0)
  mem_store64_at(h + 360, 0, 0)
  mem_store64_at(h + 368, 0, 0)
  -- Tiny pure direct-call inline count.
  mem_store64_at(h + 376, 0, 0)
  -- Direct cmp + branch lowering for condition-only comparisons.
  mem_store64_at(h + 384, 0, 0)
  -- Direct scaled raw-memory load/store lowerings.
  mem_store64_at(h + 392, 0, 0)
  -- Direct f64 literal materialisations into FP registers or zero bits.
  mem_store64_at(h + 400, 0, 0)
  -- Direct f64 expression-tree lowerings that keep arithmetic in FP regs.
  mem_store64_at(h + 408, 0, 0)
  -- Semantic optimizer spine metrics: evidence summaries consumed,
  -- reusable context-specialized entries emitted, cache hits, calls, residuals.
  mem_store64_at(h + 416, 0, 0)
  mem_store64_at(h + 424, 0, 0)
  mem_store64_at(h + 432, 0, 0)
  mem_store64_at(h + 440, 0, 0)
  mem_store64_at(h + 448, 0, 0)
  -- Classified semantic residual reasons.
  mem_store64_at(h + 456, 0, 0)
  mem_store64_at(h + 464, 0, 0)
  mem_store64_at(h + 472, 0, 0)
  mem_store64_at(h + 480, 0, 0)
  mem_store64_at(h + 488, 0, 0)
  mem_store64_at(h + 496, 0, 0)
  mem_store64_at(h + 504, 0, 0)
  -- Broader semantic fact summaries: fact count, closed effects, pure,
  -- effectful, Alloc, Unsafe, managed-param, managed-return, managed-capture.
  mem_store64_at(h + 512, 0, 0)
  mem_store64_at(h + 520, 0, 0)
  mem_store64_at(h + 528, 0, 0)
  mem_store64_at(h + 536, 0, 0)
  mem_store64_at(h + 544, 0, 0)
  mem_store64_at(h + 552, 0, 0)
  mem_store64_at(h + 560, 0, 0)
  mem_store64_at(h + 568, 0, 0)
  mem_store64_at(h + 576, 0, 0)
  -- Current generic substitution while emitting a specialised function body.
  mem_store64_at(h + 584, 0, 0)
  -- Active match scrutinee known-constructor hash, narrowing elision count,
  -- scrutinee type, value origin, and eliminated constructor stack for
  -- constructor payload binding and remaining-set facts.
  mem_store64_at(h + 592, 0, 0 - 1)
  mem_store64_at(h + 600, 0, 0)
  mem_store64_at(h + 608, 0, 0)
  mem_store64_at(h + 616, 0, 0)
  mem_store64_at(h + 624, 0, 0)
  -- Vector capacity facts from vector_with_capacity, no-grow push metric,
  -- and active loop-local no-grow proofs.
  mem_store64_at(h + 632, 0, 0)
  mem_store64_at(h + 640, 0, 0)
  mem_store64_at(h + 648, 0, 0)
  -- Vector data loads/stores using scaled register-offset addressing.
  mem_store64_at(h + 656, 0, 0)
  -- Range-for loops lowered with the loop index held in a register.
  mem_store64_at(h + 664, 0, 0)
  -- Mutable while induction variables held in a register for the loop body.
  mem_store64_at(h + 672, 0, 0)
  -- Identifier arguments aliased directly into pure tiny-inline helper scopes.
  mem_store64_at(h + 680, 0, 0)
  -- Optimized loops/calls that reserved a non-natural pinned physical register.
  mem_store64_at(h + 688, 0, 0)
  -- Classified register/lifetime reservation fallbacks.
  mem_store64_at(h + 696, 0, 0)
  mem_store64_at(h + 704, 0, 0)
  mem_store64_at(h + 712, 0, 0)
  mem_store64_at(h + 720, 0, 0)
  -- RC borrowed-parameter eligibility summaries.
  mem_store64_at(h + 728, 0, 0)
  -- Managed drop/release sites emitted through a type-specific cleanup kind.
  mem_store64_at(h + 736, 0, 0)
  mem_store64_at(h + 744, 0, 0)
  mem_store64_at(h + 752, 0, 0)
  -- One-shot managed reuse-token analysis: last release kind/size and
  -- same-layout allocation candidate counts.
  mem_store64_at(h + 760, 0, 0)
  mem_store64_at(h + 768, 0, 0)
  mem_store64_at(h + 776, 0, 0)
  mem_store64_at(h + 784, 0, 0)
  mem_store64_at(h + 792, 0, 0)
  -- Same-layout release/allocation pairs actually lowered for runtime reuse.
  mem_store64_at(h + 800, 0, 0)
  mem_store64_at(h + 808, 0, 0)
  mem_store64_at(h + 816, 0, 0)
  -- Mutable i64 loop-carried values held in registers across loop iterations.
  mem_store64_at(h + 824, 0, 0)
  -- Scope-aware counter windows that reused low register holes safely.
  mem_store64_at(h + 832, 0, 0)
  -- Direct branch condition temporaries reclaimed after branch emission.
  mem_store64_at(h + 840, 0, 0)
  -- Discarded scaled raw-memory stores that omit return-value materialisation.
  mem_store64_at(h + 848, 0, 0)
  -- Active loop-carried raw-memory address recurrences and lowering count.
  mem_store64_at(h + 856, 0, 0)
  mem_store64_at(h + 864, 0, 0)
  -- Direct-call specialisations whose inlined body is native vector get/set.
  mem_store64_at(h + 872, 0, 0)
  -- FP register fallback reasons. Current f64 loop FP registers are
  -- caller-clobbered across calls and finite within a loop.
  mem_store64_at(h + 880, 0, 0)
  mem_store64_at(h + 888, 0, 0)
  -- f64 loop-carried values placed in callee-saved FP registers.
  mem_store64_at(h + 896, 0, 0)
  -- Whether the function currently being emitted saves callee-saved FP regs.
  mem_store64_at(h + 904, 0, 0)
  -- Functions whose prologue saves callee-saved FP regs for planned f64 loops.
  mem_store64_at(h + 912, 0, 0)
  -- Immutable call-free f64 locals held directly in FP registers.
  mem_store64_at(h + 920, 0, 0)
  -- Explicit defer cleanups replayed through the typed fallback adapter.
  mem_store64_at(h + 928, 0, 0)
  -- Plain direct calls whose argument lowering stayed on typed Expr data.
  mem_store64_at(h + 936, 0, 0)
  -- Plain generic calls whose argument lowering stayed on typed Expr data.
  mem_store64_at(h + 944, 0, 0)
  -- Plain method calls whose receiver/argument lowering stayed on typed Expr data.
  mem_store64_at(h + 952, 0, 0)
  -- Pointer leaves whose native-handler fallback lowering stayed on typed Expr data.
  mem_store64_at(h + 960, 0, 0)
  mem_store64_at(h + 968, 0, 0)
  mem_store64_at(h + 976, 0, 0)
  -- Mutable f32/f64 bindings whose native-handler fallback lowering stayed
  -- on typed Expr data.
  mem_store64_at(h + 984, 0, 0)
  -- Mutable managed bindings whose native-handler fallback lowering stayed
  -- on typed Expr data.
  mem_store64_at(h + 992, 0, 0)
  -- Mutable owned/unique bindings whose native-handler fallback lowering
  -- stayed on typed Expr data.
  mem_store64_at(h + 1000, 0, 0)
  -- Iterator-for loops whose native-handler fallback lowering stayed on
  -- typed Expr data.
  mem_store64_at(h + 1008, 0, 0)
  -- Lambda expressions whose native-handler fallback lowering stayed on
  -- typed Expr data.
  mem_store64_at(h + 1016, 0, 0)
  -- Perform and handle expressions whose native-handler lowering stayed on
  -- typed Expr data.
  mem_store64_at(h + 1024, 0, 0)
  mem_store64_at(h + 1032, 0, 0)
  -- Empty handles elided by the typed bridge.
  mem_store64_at(h + 1072, 0, 0)
  -- Tiny verified memory-load leaf functions emitted without a full frame.
  mem_store64_at(h + 1096, 0, 0)
  -- Tiny evidence-specialised scalar helpers inlined at the call site.
  mem_store64_at(h + 1104, 0, 0)
  -- Central typed semantic effect-flag map. Native lowering consumes this
  -- before falling back to local raw-effect scans.
  mem_store64_at(h + 1112, 0, 0)
  -- Callback/lambda raw-effect facts. The producer may inspect callback
  -- syntax, but consumers must go through this cache.
  mem_store64_at(h + 1120, 0, 0)
  mem_store64_at(h + 1128, 0, 0)
  -- Evidence-info summaries keyed by target, callback shape, and active
  -- handler/evidence context. Distinct from the emitted-specialisation cache.
  mem_store64_at(h + 1136, 0, evidence_info_cache_new())
  -- Lambda free-variable facts produced once by pipeline lowering and
  -- consumed by legacy closure/evidence emission.
  mem_store64_at(h + 1144, 0, 0)
  mem_store64_at(h + 1152, 0, 0)
  mem_store64_at(h + 1160, 0, 0)
  mem_store64_at(h + 1168, 0, 0)
  -- Typed IR native cutover coverage: candidates and emitted functions.
  mem_store64_at(h + 1176, 0, 0)
  -- Explicit typed-lowering failure stubs emitted instead of silent omissions.
  mem_store64_at(h + 1184, 0, 0)
  -- Typed IR native slots kept resident in a preserved physical register.
  mem_store64_at(h + 1272, 0, 0)
  -- Typed IR native loop-derived slots kept resident.
  mem_store64_at(h + 1280, 0, 0)
  -- Stack frame bytes for the function currently being emitted.
  mem_store64_at(h + 1288, 0, cg_stack_frame_default_size())
  -- Closure handler evidence for the lambda currently being emitted:
  -- effect hash, op-hash nlist (index = clause index), and the IR value
  -- holding the captured ops-table pointer inside the lambda body.
  mem_store64_at(h + 1296, 0, 0)
  mem_store64_at(h + 1304, 0, 0)
  mem_store64_at(h + 1312, 0, 0)
  -- Value-bank pairs (x19/x20 .. x25/x26) the current function's prologue
  -- saves. Default is the full bank; IR-function emission narrows it to the
  -- pairs its value ids can reach (2l stage 1).
  mem_store64_at(h + 1320, 0, 4)
  -- Spill-slot values kept resident in the volatile x12-x14 pool (2l stage 3).
  mem_store64_at(h + 1328, 0, 0)
  -- f64 values kept resident in the volatile d2-d7 pool (2l stage 3 FP).
  mem_store64_at(h + 1336, 0, 0)
  -- Bank permutation swaps: hot spill values promoted into x19-x26 with the
  -- displaced cold value taking the vacated spill slot (2l bank reassignment).
  mem_store64_at(h + 1344, 0, 0)
  -- Emission-level residency audit (2o step 1 prerequisite, test-only):
  -- mode flag, per-function tenant-range list, per-function inst-offset
  -- list, scan gpos total, nested-emission byte ranges, violation counters
  -- (volatile pools / callee-saved FP), checked-tenant count, numbering-skew
  -- count, and first-violation detail (fn hash, code offset, word, phys).
  -- 1456 counts block-param pool tenants (2o step 1).
  -- 1464 counts callee-saved home-reuse tenants (2l stage 3 linear scan).
  -- Static closure pairs (2q slice 1): 1472 callee-hash → slot-offset
  -- cache, 1480 slot count, 1488/1496/1504 ADRP patch list
  -- [code_pos, slot_off] ptr/count/capacity, 1512 static-pair site count.
  -- Lambda hoisting: 1520 emitted-closure count; 1528 lowering-evidence
  -- registry used by the ordinary IR-function driver.
  -- 1536 counts emission errors (unavailable runtime functions, method map
  -- overflow, unresolved forward refs) — nonzero means the output binary
  -- carries BRK traps and the compile must fail.
  -- 2v allocation checker verdicts: 1544 violation count, 1552 checked
  -- count, 1560 first fn hash, 1568 first byte offset, 1576 first
  -- location, 1584 first expected value, 1592 first found content.
  -- 2v Stage 1 pre-measurement (audit-tier liveness facts):
  -- 1600-1632 function max-pressure buckets (0-8 / 9-13 / 14-21 /
  -- 22-27 / 28+), 1640 overall max pressure, 1648-1672 call-site
  -- live-across-call buckets (0 / 1-4 / 5-8 / 9+), 1680 overall max
  -- crossing, 1688 call sites measured, 1696-1720 loads-per-spilled-def
  -- buckets (0 / 1 / 2-3 / 4+), 1728 functions measured.
  -- Allocation is 1792; 1736-1784 free.
  mem_store64_at(h + 1352, 0, 0)
  mem_store64_at(h + 1456, 0, 0)
  mem_store64_at(h + 1464, 0, 0)
  mem_store64_at(h + 1544, 0, 0)
  mem_store64_at(h + 1552, 0, 0)
  mem_store64_at(h + 1560, 0, 0)
  mem_store64_at(h + 1568, 0, 0)
  mem_store64_at(h + 1576, 0, 0)
  mem_store64_at(h + 1584, 0, 0)
  mem_store64_at(h + 1592, 0, 0)
  mem_store64_at(h + 1472, 0, mono_cache_new())
  mem_store64_at(h + 1480, 0, 0)
  let spp = cg_alloc_bytes(1024)
  mem_store64_at(h + 1488, 0, spp)
  mem_store64_at(h + 1496, 0, 0)
  mem_store64_at(h + 1504, 0, 64)
  mem_store64_at(h + 1512, 0, 0)
  mem_store64_at(h + 1520, 0, 0)
  mem_store64_at(h + 1528, 0, 0)
  mem_store64_at(h + 1536, 0, 0)
  mem_store64_at(h + 1360, 0, 0)
  mem_store64_at(h + 1368, 0, 0)
  mem_store64_at(h + 1376, 0, 0)
  mem_store64_at(h + 1384, 0, 0)
  mem_store64_at(h + 1392, 0, 0)
  mem_store64_at(h + 1400, 0, 0)
  mem_store64_at(h + 1408, 0, 0)
  mem_store64_at(h + 1416, 0, 0)
  mem_store64_at(h + 1424, 0, 0)
  mem_store64_at(h + 1432, 0, 0)
  mem_store64_at(h + 1440, 0, 0)
  mem_store64_at(h + 1448, 0, 0)
  -- 1792-1928: 2v probe counters; 1936 current def-shape map;
  -- 1984-2488: def-shape spill census (4 sets of 16 shape buckets:
  -- loads-0 defs, loads-1 defs, loads-2+ defs, loads-2+ load sum);
  -- 2496/2504 movn remat defs/uses; 2560-2616 prologue-pair census
  -- (saved pairs, tail-dead, interior-dead, half-dead, written-unsaved,
  -- unknown-decode fns, fiber-forced pairs); 2752-2768 soft-barrier
  -- census (2v Stage 2 C0).
  let mut lvo = 1600
  while lvo <= 2808 {
    mem_store64_at(h + lvo, 0, 0)
    lvo = lvo + 8
  }
  h
}

-- 2v Stage 1 pre-measurement counters ---------------------------------

fn fmap_note_fn_pressure(fm: i64, maxlive: i64) -> i64 {
  if maxlive <= 8 { mem_store64_at(fm + 1600, 0, mem_load64_at(fm + 1600, 0) + 1) }
  else { if maxlive <= 13 { mem_store64_at(fm + 1608, 0, mem_load64_at(fm + 1608, 0) + 1) }
  else { if maxlive <= 21 { mem_store64_at(fm + 1616, 0, mem_load64_at(fm + 1616, 0) + 1) }
  else { if maxlive <= 27 { mem_store64_at(fm + 1624, 0, mem_load64_at(fm + 1624, 0) + 1) }
  else { mem_store64_at(fm + 1632, 0, mem_load64_at(fm + 1632, 0) + 1) } } } }
  if maxlive > mem_load64_at(fm + 1640, 0) { mem_store64_at(fm + 1640, 0, maxlive) } else { 0 }
  mem_store64_at(fm + 1728, 0, mem_load64_at(fm + 1728, 0) + 1)
  0
}

fn fmap_note_call_crossing(fm: i64, crossing: i64) -> i64 {
  if crossing <= 0 { mem_store64_at(fm + 1648, 0, mem_load64_at(fm + 1648, 0) + 1) }
  else { if crossing <= 4 { mem_store64_at(fm + 1656, 0, mem_load64_at(fm + 1656, 0) + 1) }
  else { if crossing <= 8 { mem_store64_at(fm + 1664, 0, mem_load64_at(fm + 1664, 0) + 1) }
  else { mem_store64_at(fm + 1672, 0, mem_load64_at(fm + 1672, 0) + 1) } } }
  if crossing > mem_load64_at(fm + 1680, 0) { mem_store64_at(fm + 1680, 0, crossing) } else { 0 }
  mem_store64_at(fm + 1688, 0, mem_load64_at(fm + 1688, 0) + 1)
  0
}

fn fmap_note_spill_def_loads(fm: i64, loads: i64) -> i64 {
  if loads <= 0 { mem_store64_at(fm + 1696, 0, mem_load64_at(fm + 1696, 0) + 1) }
  else { if loads == 1 { mem_store64_at(fm + 1704, 0, mem_load64_at(fm + 1704, 0) + 1) }
  else { if loads <= 3 { mem_store64_at(fm + 1712, 0, mem_load64_at(fm + 1712, 0) + 1) }
  else { mem_store64_at(fm + 1720, 0, mem_load64_at(fm + 1720, 0) + 1) } } }
  0
}

