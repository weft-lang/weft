pub(package) fn fmap_structural_drop_plans(fm: i64) -> i64 { mem_load64_at(fm + 2928, 0) }
pub(package) fn fmap_structural_drop_plan_count(fm: i64) -> i64 { mem_load64_at(fm + 2936, 0) }
pub(package) fn fmap_structural_drop_plan_lookup(fm: i64, key: i64) -> i64 {
  let plans = fmap_structural_drop_plans(fm)
  let mut found = 0
  let mut i = 0
  while plans != 0 and i < nlist_len(plans) and found == 0 {
    let entry = nlist_get(plans, i)
    if node_f1(entry) == key { found = node_f2(entry) } else { i = i + 1 }
  }
  found
}
pub(package) fn fmap_structural_drop_plan_register(fm: i64, key: i64, plan: i64) -> i64 {
  let existing = fmap_structural_drop_plan_lookup(fm, key)
  if key <= 1 or plan == 0 { 0 - 1 }
  else { if existing == 0 {
    nlist_add(fmap_structural_drop_plans(fm), node_new(0, key, plan, 0, 0))
    mem_store64_at(fm + 2936, 0, fmap_structural_drop_plan_count(fm) + 1)
    1
  } else {
    if typeck_linear_layout_plan_kind(existing) == typeck_linear_layout_plan_kind(plan) and
      ty_eq(typeck_linear_layout_plan_type(existing), typeck_linear_layout_plan_type(plan)) { 0 }
    else { 0 - 1 }
  } }
}
