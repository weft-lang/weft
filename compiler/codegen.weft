fn cg_par_body_has_direct(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_par_body_has_direct(node_f2(node), src) or cg_par_body_has_direct(node_f3(node), src)
      4 -> cg_par_expr_list_has_direct(node_f3(node), node_f4(node), src)
      5 -> cg_par_body_has_direct(node_f1(node), src) or cg_par_body_has_direct(node_f2(node), src) or cg_par_body_has_direct(node_f3(node), src)
