fn cg_evidence_info_count(info: i64) -> i64 { if info == 0 { 0 } else { __mem_load64(info + 72) } }
fn cg_evidence_info_callbacks(info: i64) -> i64 { if info == 0 { 0 } else { __mem_load64(info + 80) } }
fn cg_evidence_info_callback_hash(info: i64) -> i64 { if info == 0 { 0 } else { __mem_load64(info + 88) } }

fn cg_effect_sig_effect_count(eff: i64) -> i64 {
  if eff == 0 { 0 }
  else { if ty_tag(eff) == 10 { nlist_len(ty_f1(eff)) } else { 0 } }
}

fn cg_effect_sig_is_closed(eff: i64) -> i64 {
  if eff == 0 { 1 }
  else { if ty_tag(eff) == 10 and ty_f2(eff) == 0 { 1 } else { 0 } }
}

fn cg_effect_sig_contains_effect_hash(eff: i64, eff_hash: i64) -> i64 {
  if eff == 0 { 0 }
  else { if ty_tag(eff) != 10 { 0 }
  else {
    let effects = ty_f1(eff)
    let mut i = 0
    let mut found = 0
    while i < nlist_len(effects) and found == 0 {
      let app = nlist_get(effects, i)
      if ty_tag(app) == 11 and ty_f1(app) == eff_hash { found = 1 }
      else { i = i + 1 }
    }
    found
  } }
}

fn cg_params_managed_mask(params: i64) -> i64 {
  let mut mask = 0
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n and i < 60 {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { mask = mask + cg_bit(i) }
    else { 0 }
    i = i + 1
  }
  mask
}

fn cg_semantic_fact_record_metrics(fm: i64, fact: i64) -> i64 {
  if fm == 0 or fact == 0 { 0 }
  else {
    fmap_inc_semantic_fact_count(fm)
    if cg_semantic_fact_closed(fact) == 1 { fmap_inc_semantic_closed_effect_fact_count(fm) } else { 0 }
    if cg_semantic_fact_pure(fact) == 1 { fmap_inc_semantic_pure_fact_count(fm) }
