-- Def-shape census (2v): 1936 holds the current function's dense
-- value -> shape-class map (0 = no inst def recorded); cleared on the
-- same entry/bail/exit paths as the split map. Census buckets at
-- 1984 + set * 128 + shape * 8, sets: 0 = loads-0 defs, 1 = loads-1
-- defs, 2 = loads-2+ defs, 3 = loads-2+ load sum. 16 shape classes.
fn fmap_current_def_shapes(fm: i64) -> i64 { mem_load64_at(fm + 1936, 0) }
fn fmap_set_current_def_shapes(fm: i64, map: i64) -> i64 { mem_store64_at(fm + 1936, 0, map) 0 }
-- Multi-segment split sizing (2v Stage 5 pre-measurement): 1944 holds
-- the current function's dense value -> use-segment-count map (same
-- entry/bail/exit discipline as 1936). 1952/1960/1968 accumulate the
-- upper bound over loads-2+ tenancies: deletable loads (loads - segs),
-- benefiting tenancies, and those tenancies' total ledger loads.
fn fmap_current_use_segs(fm: i64) -> i64 { mem_load64_at(fm + 1944, 0) }
fn fmap_set_current_use_segs(fm: i64, map: i64) -> i64 { mem_store64_at(fm + 1944, 0, map) 0 }
fn fmap_split2_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 1952 + which * 8, 0) }
fn fmap_note_split2_tenancy(fm: i64, loads: i64, segs: i64) -> i64 {
  if segs >= 1 and loads > segs {
    mem_store64_at(fm + 1952, 0, mem_load64_at(fm + 1952, 0) + (loads - segs))
    mem_store64_at(fm + 1960, 0, mem_load64_at(fm + 1960, 0) + 1)
    mem_store64_at(fm + 1968, 0, mem_load64_at(fm + 1968, 0) + loads)
  } else { 0 }
  0
}
fn fmap_shape_census_count(fm: i64, set: i64, shape: i64) -> i64 { mem_load64_at(fm + 1984 + set * 128 + shape * 8, 0) }
fn fmap_note_shape_spill_loads(fm: i64, shape: i64, loads: i64) -> i64 {
  if shape >= 0 and shape < 16 {
    if loads == 0 { mem_store64_at(fm + 1984 + shape * 8, 0, mem_load64_at(fm + 1984 + shape * 8, 0) + 1) }
    else { if loads == 1 { mem_store64_at(fm + 2112 + shape * 8, 0, mem_load64_at(fm + 2112 + shape * 8, 0) + 1) }
    else {
      mem_store64_at(fm + 2240 + shape * 8, 0, mem_load64_at(fm + 2240 + shape * 8, 0) + 1)
      mem_store64_at(fm + 2368 + shape * 8, 0, mem_load64_at(fm + 2368 + shape * 8, 0) + loads)
    } }
  } else { 0 }
  0
}
