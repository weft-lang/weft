-- codegen.weft — code generation for aarch64
-- Scope, type table, function map, prologue/epilogue, register allocation,
-- and all cg_* code generation functions

use "compiler/encode.weft"
use "compiler/parse.weft"
use "runtime/alloc.weft"
use "runtime/effects.weft"

fn cg_str(rt: i64, rn: i64, off: i64) -> i64 { encode_str(rt, rn, off) }
fn cg_ldr(rt: i64, rn: i64, off: i64) -> i64 { encode_ldr(rt, rn, off) }
fn cg_strb(rt: i64, rn: i64, off: i64) -> i64 { encode_strb(rt, rn, off) }
fn cg_ldrb(rt: i64, rn: i64, off: i64) -> i64 { encode_ldrb(rt, rn, off) }
fn runtime_state_size() -> i64 { 64 }
fn runtime_state_bump_offset() -> i64 { 0 }
fn runtime_state_rc_heap_offset() -> i64 { 8 }

fn cg_bump_tmp(dst: i64, size_reg: i64) -> i64 {
  if dst != 9 and size_reg != 9 { 9 } else { 10 }
}

fn cg_bump_alloc_reg(code: i64, dst: i64, size_reg: i64) -> i64 {
  bu32(code, cg_ldr(dst, 28, runtime_state_bump_offset()))
  let tmp = cg_bump_tmp(dst, size_reg)
  bu32(code, encode_add_reg(tmp, dst, size_reg))
  bu32(code, cg_str(tmp, 28, runtime_state_bump_offset()))
}

fn cg_bump_alloc_imm(code: i64, dst: i64, size: i64) -> i64 {
  bu32(code, cg_ldr(dst, 28, runtime_state_bump_offset()))
  let tmp = cg_bump_tmp(dst, 0)
  bu32(code, encode_add_imm(tmp, dst, size))
  bu32(code, cg_str(tmp, 28, runtime_state_bump_offset()))
}

fn find_main_in_fmap(fm: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let owner_hash = __mem_load64(d + i * 40 + 32)
    if owner_hash == 0 {
      let e_src = __mem_load64(d + i * 40 + 24)
      let e_ns = __mem_load64(d + i * 40)
      let e_nl = __mem_load64(d + i * 40 + 8)
      if src_eq(e_src, e_ns, e_nl, "main") == 1 {
        result = __mem_load64(d + i * 40 + 16)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Emit startup code: save argc/argv, mmap heap, init runtime, pass argc/argv to main.
fn emit_heap_init(code: i64) -> i64 {
  -- STP x29, x30, [sp, #-16]! (save link register to return to dyld)
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  -- Save argc (x0) and argv (x1) in callee-saved registers across mmap
  bu32(code, encode_add_imm(25, 0, 0))
  bu32(code, encode_add_imm(26, 1, 0))
  -- mmap syscall: x16 = 0x020000C5 (BSD class | 197)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  -- x0 = 0 (addr = NULL)
  bu32(code, encode_movz(0, 0, 0))
  -- x1 = 512MB = 0x20000000
  bu32(code, encode_movz(1, 0, 0))
  bu32(code, encode_movk(1, 8192, 16))
  -- x2 = 3 (PROT_READ | PROT_WRITE)
  bu32(code, encode_movz(2, 3, 0))
  -- x3 = 4098 (MAP_PRIVATE | MAP_ANON)
  bu32(code, encode_movz(3, 4098, 0))
  -- x4 = -1 (fd)
  bu32(code, encode_movn(4, 0))
  -- x5 = 0 (offset)
  bu32(code, encode_movz(5, 0, 0))
  -- SVC #0x80
  bu32(code, encode_svc())
  -- MOV x28, x0 (runtime state base)
  bu32(code, encode_add_imm(28, 0, 0))
  -- runtime_state.bump = mmap_base + runtime_state_size
  bu32(code, encode_add_imm(17, 0, runtime_state_size()))
  bu32(code, cg_str(17, 28, runtime_state_bump_offset()))
  -- runtime_state.default_rc_heap = 0 (lazy)
  bu32(code, encode_movz(17, 0, 0))
  bu32(code, cg_str(17, 28, runtime_state_rc_heap_offset()))
  -- MOV x27, #0 (handler stack = empty)
  bu32(code, encode_movz(27, 0, 0))
  -- Restore argc/argv as arguments to main (x0=argc, x1=argv)
  bu32(code, encode_add_imm(0, 25, 0))
  bu32(code, encode_add_imm(1, 26, 0))
  code
}

fn bytes_set_u32(code: i64, pos: i64, val: i64) -> i64 {
  let d = buf_ptr(code)
  __mem_store8(d + pos, val - val / 256 * 256)
  __mem_store8(d + pos + 1, val / 256 - val / 65536 * 256)
  __mem_store8(d + pos + 2, val / 65536 - val / 16777216 * 256)
  __mem_store8(d + pos + 3, val / 16777216 - val / 4294967296 * 256)
  0
}

fn patch_forward_refs(fm: i64, code: i64) -> i64 {
  let pn = __mem_load64(fm + 32)
  let pd = __mem_load64(fm + 24)
  let mut i = 0
  while i < pn {
    let pos = __mem_load64(pd + i * 32)
    let ns = __mem_load64(pd + i * 32 + 8)
    let nl = __mem_load64(pd + i * 32 + 16)
    let p_src = __mem_load64(pd + i * 32 + 24)
    let target = fmap_lookup(fm, p_src, ns, nl)
    bytes_set_u32(code, pos, encode_bl(target - pos))
    i = i + 1
  }
  0
}

-- ======================================================================
-- Scope: linked list of {name_start, name_len, reg, next, type}
-- ======================================================================

fn scope_new() -> i64 { 0 }
fn scope_push_typed(scope: i64, ns: i64, nl: i64, reg: i64, ty: i64) -> i64 {
  let e = alloc_bump(40)
  __mem_store64(e, ns)
  __mem_store64(e + 8, nl)
  __mem_store64(e + 16, reg)
  __mem_store64(e + 24, scope)
  __mem_store64(e + 32, ty)
  e
}

fn scope_push(scope: i64, ns: i64, nl: i64, reg: i64) -> i64 {
  scope_push_typed(scope, ns, nl, reg, 0)
}

fn scope_lookup(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns register number or -1 if not found
  if scope == 0 { 0 - 999 }
  else {
    let s_ns = __mem_load64(scope)
    let s_nl = __mem_load64(scope + 8)
    if s_nl == nl {
      -- Compare src[ns..ns+nl] with src[s_ns..s_ns+nl]
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        __mem_load64(scope + 16)
      } else {
        scope_lookup(__mem_load64(scope + 24), src, ns, nl)
      }
    } else {
      scope_lookup(__mem_load64(scope + 24), src, ns, nl)
    }
  }
}

fn scope_lookup_type(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if scope == 0 { 0 }
  else {
    let s_ns = __mem_load64(scope)
    let s_nl = __mem_load64(scope + 8)
    if s_nl == nl {
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        __mem_load64(scope + 32)
      } else {
        scope_lookup_type(__mem_load64(scope + 24), src, ns, nl)
      }
    } else {
      scope_lookup_type(__mem_load64(scope + 24), src, ns, nl)
    }
  }
}

-- ======================================================================
-- Type table: stores record/variant type declarations
-- ======================================================================
-- Entry: [name_ns(8), name_nl(8), kind(8), num_fields(8), fields_ptr(8)] = 40 bytes
-- kind: 0=record, 1=variant
-- For records: fields_ptr -> array of [field_ns(8), field_nl(8), field_ty(8)] per field (24 bytes each)
-- For variants: fields_ptr -> array of [variant_ns(8), variant_nl(8), tag_hash(8), num_payloads(8), payload_types(8)] per variant (40 bytes each)
fn ttable_new() -> i64 {
  let h = alloc_bump(48)
  let d = alloc_bump(5600)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 100)
  -- Loaded files list for use dedup (stored at h+24)
  __mem_store64(h + 24, nlist_new())
  -- Conformance table pointer (stored at h+32, set by compile)
  __mem_store64(h + 32, 0)
  -- Current function's tparams (stored at h+40, set by check_fn)
  __mem_store64(h + 40, 0)
  h
}
fn ttable_set_ct(tt: i64, ct: i64) -> i64 { __mem_store64(tt + 32, ct) 0 }
fn ttable_get_ct(tt: i64) -> i64 { __mem_load64(tt + 32) }
fn ttable_set_tparams(tt: i64, tp: i64) -> i64 { __mem_store64(tt + 40, tp) 0 }
fn ttable_get_tparams(tt: i64) -> i64 { __mem_load64(tt + 40) }
-- Entry layout: [ns(8), nl(8), kind(8), nfields(8), fields(8), tparams(8), src(8)] = 56 bytes
-- src stored per entry for cross-file name resolution
fn ttable_add(tt: i64, src: i64, ns: i64, nl: i64, kind: i64, nfields: i64, fields: i64, tparams: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let cap = __mem_load64(tt + 16)
  if n >= cap {
    let d = __mem_load64(tt)
    let new_cap = cap * 2
    let new_d = alloc_bump(new_cap * 56)
    mem_copy(new_d, d, n * 56)
    __mem_store64(tt, new_d)
    __mem_store64(tt + 16, new_cap)
    0
  } else { 0 }
  let d = __mem_load64(tt)
  __mem_store64(d + n * 56, ns)
  __mem_store64(d + n * 56 + 8, nl)
  __mem_store64(d + n * 56 + 16, kind)
  __mem_store64(d + n * 56 + 24, nfields)
  __mem_store64(d + n * 56 + 32, fields)
  __mem_store64(d + n * 56 + 40, tparams)
  __mem_store64(d + n * 56 + 48, src)
  __mem_store64(tt + 8, n + 1)
  tt
}
fn ttable_lookup(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns pointer to type entry, or 0 if not found
  -- Uses entry's stored src for cross-file correctness
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_ns = __mem_load64(d + i * 56)
    let e_nl = __mem_load64(d + i * 56 + 8)
    if e_nl == nl {
      let e_src = __mem_load64(d + i * 56 + 48)
      if src_eq_at(src, ns, e_src + e_ns, 0, nl) == 1 {
        result = d + i * 56
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
-- Get field index by name from a record type entry
-- entry_src = the source buffer the entry was parsed from
-- caller_src = the source buffer the lookup name is from
fn ttable_field_index(entry: i64, entry_src: i64, caller_src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let nfields = __mem_load64(entry + 24)
  let fields = __mem_load64(entry + 32)
  let mut i = 0
  let mut result = 0 - 1
  while i < nfields {
    let f_ns = __mem_load64(fields + i * 24)
    let f_nl = __mem_load64(fields + i * 24 + 8)
    if f_nl == field_nl {
      if src_eq_at(caller_src, field_ns, entry_src + f_ns, 0, field_nl) == 1 {
        result = i
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Find variant info by name. Returns tag_hash or -1 if not found.
-- Uses the entry's stored src for cross-file name comparison.
fn ttable_find_variant(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut ti = 0
  let mut result = 0 - 1
  while ti < n {
    let kind = __mem_load64(d + ti * 56 + 16)
    if kind == 1 {
      let nvariants = __mem_load64(d + ti * 56 + 24)
      let variants = __mem_load64(d + ti * 56 + 32)
      let entry_src = __mem_load64(d + ti * 56 + 48)
      let mut vi = 0
      let mut found = 0
      while vi < nvariants {
        let v_ns = __mem_load64(variants + vi * 40)
        let v_nl = __mem_load64(variants + vi * 40 + 8)
        if v_nl == nl {
          -- Compare caller's name with entry's name using entry's src
          if src_eq_at(src, ns, entry_src + v_ns, 0, nl) == 1 {
            result = __mem_load64(variants + vi * 40 + 16)
            vi = nvariants
            found = 1
          } else { vi = vi + 1 }
        } else { vi = vi + 1 }
      }
      if found == 1 { ti = n } else { ti = ti + 1 }
    } else { ti = ti + 1 }
  }
  result
}

-- Search all record types for a field name, return its index
fn ttable_find_any_field(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut i = 0
  let mut result = 0
  while i < n {
    let kind = __mem_load64(d + i * 56 + 16)
    if kind == 0 {
      -- Record type: search its fields using entry's stored src
      let entry = d + i * 56
      let entry_src = __mem_load64(d + i * 56 + 48)
      let idx = ttable_field_index(entry, entry_src, src, ns, nl)
      if idx >= 0 {
        result = idx
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn ttable_find_field_by_type_hash(tt: i64, type_hash: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut i = 0
  let mut result = 0 - 1
  while i < n {
    let kind = __mem_load64(d + i * 56 + 16)
    if kind == 0 {
      let entry_src = __mem_load64(d + i * 56 + 48)
      let type_ns = __mem_load64(d + i * 56)
      let type_nl = __mem_load64(d + i * 56 + 8)
      if str_hash(entry_src, type_ns, type_nl) == type_hash {
        let idx = ttable_field_index(d + i * 56, entry_src, src, ns, nl)
        if idx >= 0 { result = idx i = n } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn ttable_find_field_in_type(tt: i64, src: i64, type_ns: i64, type_nl: i64, field_ns: i64, field_nl: i64, fallback: i64) -> i64 {
  if tt == 0 { fallback }
  else {
    let entry = ttable_lookup(tt, src, type_ns, type_nl)
    if entry == 0 { fallback }
    else {
      let entry_src = __mem_load64(entry + 48)
      let idx = ttable_field_index(entry, entry_src, src, field_ns, field_nl)
      if idx >= 0 { idx } else { fallback }
    }
  }
}

-- Simple string hash for variant tags (compile-time)
fn str_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  for i in 0..len {
    h = h * 33 + __mem_load8(src + start + i)
  }
  if h < 0 { 0 - h } else { h }
}

fn cg_ftypes_new() -> i64 { nlist_new() }

fn cg_ftypes_add(ft: i64, src: i64, ns: i64, nl: i64, ret_ty: i64, params: i64, effects: i64) -> i64 {
  let e = alloc_bump(56)
  __mem_store64(e, ns)
  __mem_store64(e + 8, nl)
  __mem_store64(e + 16, ret_ty)
  __mem_store64(e + 24, params)
  __mem_store64(e + 32, src)
  __mem_store64(e + 40, 0)
  __mem_store64(e + 48, effects)
  nlist_add(ft, e)
}

fn cg_ftypes_find(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(ft) {
    let e = nlist_get(ft, i)
    let e_nl = __mem_load64(e + 8)
    if e_nl == nl {
      let e_src = __mem_load64(e + 32)
      if src_eq_at(src, ns, e_src + __mem_load64(e), 0, nl) == 1 {
        result = e
        i = nlist_len(ft)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn cg_ftypes_lookup_ret(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "rc_default_alloc") == 1 {
    ty_rc(ty_i64())
  } else {
    let e = cg_ftypes_find(ft, src, ns, nl)
    if e == 0 { 0 } else { __mem_load64(e + 16) }
  }
}

fn cg_ftypes_lookup_params(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = cg_ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { __mem_load64(e + 24) }
}

fn cg_ftypes_lookup_effects(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = cg_ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 } else { __mem_load64(e + 48) }
}

fn cg_param_nodes_to_type_list(params: i64) -> i64 {
  let result = nlist_new()
  if params == 0 { result }
  else {
    for i in 0..nlist_len(params) {
      nlist_add(result, node_f3(nlist_get(params, i)))
    }
    result
  }
}

fn cg_ftypes_lookup_fn_type(ft: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let e = cg_ftypes_find(ft, src, ns, nl)
  if e == 0 { 0 }
  else {
    let effects = __mem_load64(e + 48)
    ty_fn(cg_param_nodes_to_type_list(__mem_load64(e + 24)), __mem_load64(e + 16), if effects == 0 { ty_effect_pure() } else { effects })
  }
}

-- ======================================================================
-- Function map: parallel arrays of {name_start, name_len, offset, src, owner_hash}
-- ======================================================================

fn fmap_new() -> i64 {
  let h = alloc_bump(248)
  let d = alloc_bump(80000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 2000)
  -- Patches list for forward BL references: [position, name_start, name_len, src_ptr]
  let pd = alloc_bump(256000)
  __mem_store64(h + 24, pd)
  __mem_store64(h + 32, 0)
  __mem_store64(h + 40, 8000)
  -- Type table pointer (set by compile)
  __mem_store64(h + 48, 0)
  -- Loop context: loop_start offset and break patches list
  __mem_store64(h + 56, 0)
  __mem_store64(h + 64, 0)
  -- Method map pointer
  __mem_store64(h + 72, mmap_new())
  -- Template map: generic function ASTs for monomorphisation (offset 80)
  __mem_store64(h + 80, mono_tmap_new())
  -- Specialisation cache: (spec_hash → code_offset) (offset 88)
  __mem_store64(h + 88, mono_cache_new())
  -- Handler inlining context stack (offset 96): compile-time handler scopes.
  -- Context layout: [eff_hash, clauses, clause_infos, nclauses, ops_ctr, prev].
  __mem_store64(h + 96, 0)
  -- RC elision metadata: enabled flag and elided local alias pair count.
  __mem_store64(h + 104, 1)
  __mem_store64(h + 112, 0)
  -- GOT patch list (offset 120): [code_position(8), got_index(8)] pairs
  let gp = alloc_bump(1024)
  __mem_store64(h + 120, gp)
  __mem_store64(h + 128, 0)
  __mem_store64(h + 136, 64)
  -- Active lexical defer cleanup stack and current loop cleanup boundary.
  __mem_store64(h + 144, nlist_new())
  __mem_store64(h + 152, 0)
  -- Codegen function signature map and current function return type.
  __mem_store64(h + 160, cg_ftypes_new())
  __mem_store64(h + 168, 0)
  -- Native bridge metadata: functions emitted from optimized IR.
  __mem_store64(h + 176, 0)
  -- Borrowed-parameter specialisation metadata for direct internal calls.
  __mem_store64(h + 184, borrow_tmap_new())
  __mem_store64(h + 192, borrow_cache_new())
  -- Alloc elision metadata: stack-rewritten local temporary/scoped handler count.
  __mem_store64(h + 200, 0)
  -- Active scoped arena lowering context for direct Alloc performs.
  __mem_store64(h + 208, 0)
  -- Current loop result counter for break(value) lowering.
  __mem_store64(h + 216, 0 - 1)
  -- Fusion metadata: pure stdlib list pipeline chains rewritten.
  __mem_store64(h + 224, 0)
  -- Active scoped Par lowering context for direct spawn/await emission.
  __mem_store64(h + 232, 0)
  -- Spawn emission metadata: scoped Par helper calls lowered directly.
  __mem_store64(h + 240, 0)
  h
}
fn fmap_set_tt(fm: i64, tt: i64) -> i64 { __mem_store64(fm + 48, tt) 0 }
fn fmap_get_tt(fm: i64) -> i64 { __mem_load64(fm + 48) }
fn fmap_get_cg_ftypes(fm: i64) -> i64 { __mem_load64(fm + 160) }
fn fmap_set_current_ret_ty(fm: i64, ty: i64) -> i64 { __mem_store64(fm + 168, ty) 0 }
fn fmap_get_current_ret_ty(fm: i64) -> i64 { __mem_load64(fm + 168) }
fn fmap_set_rc_elision_enabled(fm: i64, enabled: i64) -> i64 { __mem_store64(fm + 104, enabled) 0 }
fn fmap_rc_elision_enabled(fm: i64) -> i64 { __mem_load64(fm + 104) }
fn fmap_rc_elision_count(fm: i64) -> i64 { __mem_load64(fm + 112) }
fn fmap_inc_rc_elision_count(fm: i64) -> i64 { __mem_store64(fm + 112, __mem_load64(fm + 112) + 1) 0 }
fn fmap_alloc_elision_count(fm: i64) -> i64 { __mem_load64(fm + 200) }
fn fmap_inc_alloc_elision_count(fm: i64) -> i64 { __mem_store64(fm + 200, __mem_load64(fm + 200) + 1) 0 }
fn fmap_fusion_count(fm: i64) -> i64 { __mem_load64(fm + 224) }
fn fmap_inc_fusion_count(fm: i64) -> i64 { __mem_store64(fm + 224, __mem_load64(fm + 224) + 1) 0 }
fn fmap_par_lowering_count(fm: i64) -> i64 { __mem_load64(fm + 240) }
fn fmap_inc_par_lowering_count(fm: i64) -> i64 { __mem_store64(fm + 240, __mem_load64(fm + 240) + 1) 0 }
fn fmap_scoped_alloc_top(fm: i64) -> i64 { __mem_load64(fm + 208) }
fn fmap_set_scoped_alloc_top(fm: i64, top: i64) -> i64 { __mem_store64(fm + 208, top) 0 }
fn fmap_par_lowering_top(fm: i64) -> i64 { __mem_load64(fm + 232) }
fn fmap_set_par_lowering_top(fm: i64, top: i64) -> i64 { __mem_store64(fm + 232, top) 0 }
fn fmap_loop_result_ctr(fm: i64) -> i64 { __mem_load64(fm + 216) }
fn fmap_set_loop_result_ctr(fm: i64, ctr: i64) -> i64 { __mem_store64(fm + 216, ctr) 0 }
fn fmap_borrow_tmap(fm: i64) -> i64 { __mem_load64(fm + 184) }
fn fmap_borrow_cache(fm: i64) -> i64 { __mem_load64(fm + 192) }
fn fmap_add_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let cap = __mem_load64(fm + 16)
  if n >= cap {
    -- Grow: allocate 2x, copy
    let d = __mem_load64(fm)
    let new_cap = cap * 2
    let new_d = alloc_bump(new_cap * 40)
    mem_copy(new_d, d, n * 40)
    __mem_store64(fm, new_d)
    __mem_store64(fm + 16, new_cap)
    0
  } else { 0 }
  let d = __mem_load64(fm)
  __mem_store64(d + n * 40, ns)
  __mem_store64(d + n * 40 + 8, nl)
  __mem_store64(d + n * 40 + 16, off)
  __mem_store64(d + n * 40 + 24, src)
  __mem_store64(d + n * 40 + 32, owner_hash)
  __mem_store64(fm + 8, n + 1)
  fm
}
fn fmap_add(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_add_qualified(fm, src, ns, nl, 0, off)
}
fn fmap_lookup_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          result = __mem_load64(d + i * 40 + 16)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
fn fmap_lookup(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_lookup_qualified(fm, src, ns, nl, 0)
}

fn cg_handler_inline_ctx_size() -> i64 { 48 }
fn cg_handler_inline_ctx_eff_offset() -> i64 { 0 }
fn cg_handler_inline_ctx_clauses_offset() -> i64 { 8 }
fn cg_handler_inline_ctx_infos_offset() -> i64 { 16 }
fn cg_handler_inline_ctx_nclauses_offset() -> i64 { 24 }
fn cg_handler_inline_ctx_ops_ctr_offset() -> i64 { 32 }
fn cg_handler_inline_ctx_prev_offset() -> i64 { 40 }

fn cg_handler_inline_match_size() -> i64 { 32 }
fn cg_handler_inline_match_info_offset() -> i64 { 0 }
fn cg_handler_inline_match_index_offset() -> i64 { 8 }
fn cg_handler_inline_match_ops_ctr_offset() -> i64 { 16 }
fn cg_handler_inline_match_nfree_offset() -> i64 { 24 }

fn fmap_handler_inline_top(fm: i64) -> i64 { __mem_load64(fm + 96) }
fn fmap_set_handler_inline_top(fm: i64, top: i64) -> i64 { __mem_store64(fm + 96, top) 0 }

fn cg_handler_inline_push(fm: i64, eff_hash: i64, clauses: i64, clause_infos: i64, nclauses: i64, ops_ctr: i64) -> i64 {
  let ctx = alloc_bump(cg_handler_inline_ctx_size())
  __mem_store64(ctx + cg_handler_inline_ctx_eff_offset(), eff_hash)
  __mem_store64(ctx + cg_handler_inline_ctx_clauses_offset(), clauses)
  __mem_store64(ctx + cg_handler_inline_ctx_infos_offset(), clause_infos)
  __mem_store64(ctx + cg_handler_inline_ctx_nclauses_offset(), nclauses)
  __mem_store64(ctx + cg_handler_inline_ctx_ops_ctr_offset(), ops_ctr)
  __mem_store64(ctx + cg_handler_inline_ctx_prev_offset(), fmap_handler_inline_top(fm))
  fmap_set_handler_inline_top(fm, ctx)
  ctx
}

fn cg_handler_inline_pop(fm: i64) -> i64 {
  let ctx = fmap_handler_inline_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_handler_inline_top(fm, __mem_load64(ctx + cg_handler_inline_ctx_prev_offset()))
    0
  }
}

fn cg_handler_inline_clause_op_hash(clause: i64, src: i64) -> i64 {
  let clause_names = node_f1(clause)
  str_hash(src, node_f3(clause_names), node_f4(clause_names))
}

fn cg_handler_inline_make_match(info: i64, index: i64, ops_ctr: i64) -> i64 {
  let result = alloc_bump(cg_handler_inline_match_size())
  __mem_store64(result + cg_handler_inline_match_info_offset(), info)
  __mem_store64(result + cg_handler_inline_match_index_offset(), index)
  __mem_store64(result + cg_handler_inline_match_ops_ctr_offset(), ops_ctr)
  __mem_store64(result + cg_handler_inline_match_nfree_offset(), __mem_load64(info + 16))
  result
}

fn cg_handler_inline_find_clause(ctx: i64, src: i64, op_hash: i64) -> i64 {
  let clauses = __mem_load64(ctx + cg_handler_inline_ctx_clauses_offset())
  let infos = __mem_load64(ctx + cg_handler_inline_ctx_infos_offset())
  let nclauses = __mem_load64(ctx + cg_handler_inline_ctx_nclauses_offset())
  let ops_ctr = __mem_load64(ctx + cg_handler_inline_ctx_ops_ctr_offset())
  let mut i = 0
  let mut result = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if cg_handler_inline_clause_op_hash(clause, src) == op_hash {
      result = cg_handler_inline_make_match(__mem_load64(infos + i * 8), i, ops_ctr)
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn cg_handler_inline_find(fm: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut ctx = fmap_handler_inline_top(fm)
  let mut result = 0
  while ctx != 0 {
    if __mem_load64(ctx + cg_handler_inline_ctx_eff_offset()) == eff_hash {
      let found = cg_handler_inline_find_clause(ctx, src, op_hash)
      if found == 0 {
        ctx = __mem_load64(ctx + cg_handler_inline_ctx_prev_offset())
      } else {
        result = found
        ctx = 0
      }
    } else {
      ctx = __mem_load64(ctx + cg_handler_inline_ctx_prev_offset())
    }
  }
  result
}

fn cg_scoped_alloc_ctx_arena_ctr_offset() -> i64 { 0 }
fn cg_scoped_alloc_ctx_prev_offset() -> i64 { 8 }

fn cg_scoped_alloc_push(fm: i64, arena_ctr: i64) -> i64 {
  let ctx = alloc_bump(16)
  __mem_store64(ctx + cg_scoped_alloc_ctx_arena_ctr_offset(), arena_ctr)
  __mem_store64(ctx + cg_scoped_alloc_ctx_prev_offset(), fmap_scoped_alloc_top(fm))
  fmap_set_scoped_alloc_top(fm, ctx)
  ctx
}

fn cg_scoped_alloc_pop(fm: i64) -> i64 {
  let ctx = fmap_scoped_alloc_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_scoped_alloc_top(fm, __mem_load64(ctx + cg_scoped_alloc_ctx_prev_offset()))
    0
  }
}

fn cg_scoped_alloc_arena_ctr(fm: i64) -> i64 {
  let ctx = fmap_scoped_alloc_top(fm)
  if ctx == 0 { 0 - 1 }
  else { __mem_load64(ctx + cg_scoped_alloc_ctx_arena_ctr_offset()) }
}

fn cg_par_lowering_ctx_mode_offset() -> i64 { 0 }
fn cg_par_lowering_ctx_pool_ctr_offset() -> i64 { 8 }
fn cg_par_lowering_ctx_prev_offset() -> i64 { 16 }

fn cg_par_lowering_push(fm: i64, mode: i64, pool_ctr: i64) -> i64 {
  let ctx = alloc_bump(24)
  __mem_store64(ctx + cg_par_lowering_ctx_mode_offset(), mode)
  __mem_store64(ctx + cg_par_lowering_ctx_pool_ctr_offset(), pool_ctr)
  __mem_store64(ctx + cg_par_lowering_ctx_prev_offset(), fmap_par_lowering_top(fm))
  fmap_set_par_lowering_top(fm, ctx)
  ctx
}

fn cg_par_lowering_pop(fm: i64) -> i64 {
  let ctx = fmap_par_lowering_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_par_lowering_top(fm, __mem_load64(ctx + cg_par_lowering_ctx_prev_offset()))
    0
  }
}

fn cg_par_lowering_mode(fm: i64) -> i64 {
  let ctx = fmap_par_lowering_top(fm)
  if ctx == 0 { 0 } else { __mem_load64(ctx + cg_par_lowering_ctx_mode_offset()) }
}

fn cg_par_lowering_pool_ctr(fm: i64) -> i64 {
  let ctx = fmap_par_lowering_top(fm)
  if ctx == 0 { 0 - 1 } else { __mem_load64(ctx + cg_par_lowering_ctx_pool_ctr_offset()) }
}

-- Check if a name exists in fmap (regardless of offset value)
fn fmap_contains_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut found = false
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          found = true
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}
fn fmap_contains(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_contains_qualified(fm, src, ns, nl, 0)
}

-- Update a fmap entry's offset (for hoisting: registered with 0, updated when compiled)
fn fmap_update_offset_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          __mem_store64(d + i * 40 + 16, off)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}
fn fmap_update_offset(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_update_offset_qualified(fm, src, ns, nl, 0, off)
}

-- Record a forward BL reference to be patched later
fn fmap_add_patch(fm: i64, pos: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pn = __mem_load64(fm + 32)
  let pcap = __mem_load64(fm + 40)
  if pn >= pcap {
    let pd = __mem_load64(fm + 24)
    let new_cap = pcap * 2
    let new_pd = alloc_bump(new_cap * 32)
    mem_copy(new_pd, pd, pn * 32)
    __mem_store64(fm + 24, new_pd)
    __mem_store64(fm + 40, new_cap)
    0
  } else { 0 }
  let pd = __mem_load64(fm + 24)
  __mem_store64(pd + pn * 32, pos)
  __mem_store64(pd + pn * 32 + 8, ns)
  __mem_store64(pd + pn * 32 + 16, nl)
  __mem_store64(pd + pn * 32 + 24, src)
  __mem_store64(fm + 32, pn + 1)
  0
}

-- ======================================================================
-- Method map: maps (type_hash, method_hash) → code offset + params
-- Entry: [type_hash(8), method_hash(8), code_offset(8), params(8)] = 32 bytes
-- ======================================================================

fn mmap_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(16000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mmap_add(mm: i64, type_hash: i64, method_hash: i64, off: i64, params: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let cap = __mem_load64(mm + 16)
  if n >= cap {
    eprint("error: method map overflow\n")
    mm
  } else {
    __mem_store64(d + n * 32, type_hash)
    __mem_store64(d + n * 32 + 8, method_hash)
    __mem_store64(d + n * 32 + 16, off)
    __mem_store64(d + n * 32 + 24, params)
    __mem_store64(mm + 8, n + 1)
    mm
  }
}

fn mmap_lookup(mm: i64, type_hash: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        result = __mem_load64(d + i * 32 + 16)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Lookup by method_hash only (for generic code where concrete type is unknown)
fn mmap_lookup_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32 + 8) == method_hash {
      result = __mem_load64(d + i * 32 + 16)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_lookup_params(mm: i64, type_hash: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        result = __mem_load64(d + i * 32 + 24)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn mmap_lookup_params_by_method(mm: i64, method_hash: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 32 + 8) == method_hash {
      result = __mem_load64(d + i * 32 + 24)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mmap_update(mm: i64, type_hash: i64, method_hash: i64, off: i64) -> i64 {
  let d = __mem_load64(mm)
  let n = __mem_load64(mm + 8)
  let mut i = 0
  while i < n {
    if __mem_load64(d + i * 32) == type_hash {
      if __mem_load64(d + i * 32 + 8) == method_hash {
        __mem_store64(d + i * 32 + 16, off)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}

-- Check if an identifier node (tag 2) refers to an effect name in the ttable
fn is_effect_ident(node: i64, src: i64, tt: i64) -> i64 {
  if node_tag(node) != 2 { false }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    let entry = ttable_lookup(tt, src, ns, nl)
    if entry == 0 { false }
    else {
      let kind = __mem_load64(entry + 16)
      if kind == 2 { true } else { false }
    }
  }
}

-- ======================================================================
-- Monomorphisation: template map + specialisation cache
-- ======================================================================

-- Template map: stores generic function ASTs for on-demand specialisation
-- Entry: [name_hash(8), fn_wrap_ptr(8), src_ptr(8)] = 24 bytes
fn mono_tmap_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(12000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mono_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64) -> i64 {
  let d = __mem_load64(tm)
  let n = __mem_load64(tm + 8)
  let cap = __mem_load64(tm + 16)
  if n >= cap { tm }
  else {
    __mem_store64(d + n * 24, name_hash)
    __mem_store64(d + n * 24 + 8, fn_wrap)
    __mem_store64(d + n * 24 + 16, src)
    __mem_store64(tm + 8, n + 1)
    tm
  }
}

fn mono_tmap_lookup(tm: i64, name_hash: i64) -> i64 {
  let d = __mem_load64(tm)
  let n = __mem_load64(tm + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 24) == name_hash {
      result = d + i * 24
      i = n
    } else { i = i + 1 }
  }
  result
}

-- Specialisation cache: deduplicates identical generic instantiations
-- Entry: [spec_hash(8), code_offset(8)] = 16 bytes
fn mono_cache_new() -> i64 {
  let h = alloc_bump(24)
  let d = alloc_bump(8000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 500)
  h
}

fn mono_cache_lookup(mc: i64, spec_hash: i64) -> i64 {
  let d = __mem_load64(mc)
  let n = __mem_load64(mc + 8)
  let mut i = 0
  let mut result = 0
  while i < n {
    if __mem_load64(d + i * 16) == spec_hash {
      result = __mem_load64(d + i * 16 + 8)
      i = n
    } else { i = i + 1 }
  }
  result
}

fn mono_cache_add(mc: i64, spec_hash: i64, off: i64) -> i64 {
  let d = __mem_load64(mc)
  let n = __mem_load64(mc + 8)
  let cap = __mem_load64(mc + 16)
  if n >= cap { mc }
  else {
    __mem_store64(d + n * 16, spec_hash)
    __mem_store64(d + n * 16 + 8, off)
    __mem_store64(mc + 8, n + 1)
    mc
  }
}

fn borrow_tmap_new() -> i64 {
  nlist_new()
}

fn borrow_tmap_add(tm: i64, name_hash: i64, fn_wrap: i64, src: i64, owner_hash: i64) -> i64 {
  nlist_add(tm, node_new(0, name_hash, fn_wrap, src, owner_hash))
}

fn borrow_tmap_lookup(tm: i64, name_hash: i64, owner_hash: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(tm) {
    let e = nlist_get(tm, i)
    if node_f1(e) == name_hash {
      if node_f4(e) == owner_hash {
        result = e
        i = nlist_len(tm)
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn borrow_cache_new() -> i64 {
  nlist_new()
}

fn borrow_cache_lookup(cache: i64, name_hash: i64, owner_hash: i64, mask: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(cache) {
    let e = nlist_get(cache, i)
    if node_f1(e) == name_hash {
      if node_f2(e) == owner_hash {
        if node_f3(e) == mask {
          result = node_f4(e)
          i = nlist_len(cache)
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn borrow_cache_add(cache: i64, name_hash: i64, owner_hash: i64, mask: i64, off: i64) -> i64 {
  nlist_add(cache, node_new(0, name_hash, owner_hash, mask, off))
}

fn cg_bit(index: i64) -> i64 {
  let mut result = 1
  let mut i = 0
  while i < index {
    result = result * 2
    i = i + 1
  }
  result
}

fn cg_mask_has(mask: i64, index: i64) -> i64 {
  let bit = cg_bit(index)
  if (mask / bit) - (mask / (bit * 2)) * 2 == 1 { 1 } else { 0 }
}

-- Compute specialisation hash: combine function name hash with type arg values
fn mono_spec_hash(name_hash: i64, type_args: i64) -> i64 {
  let mut h = name_hash
  let n = nlist_len(type_args)
  for i in 0..n {
    h = h * 31 + nlist_get(type_args, i)
  }
  h
}

-- ======================================================================
-- Prologue / epilogue
-- ======================================================================

fn emit_prologue(code: i64) -> i64 {
  bu32(code, encode_stp_pre(8, 9, 31, 0 - 16))
  bu32(code, encode_stp_pre(10, 11, 31, 0 - 16))
  bu32(code, encode_stp_pre(12, 13, 31, 0 - 16))
  bu32(code, encode_stp_pre(14, 15, 31, 0 - 16))
  emit_prologue2(code)
}
fn emit_prologue2(code: i64) -> i64 {
  bu32(code, encode_stp_pre(19, 20, 31, 0 - 16))
  bu32(code, encode_stp_pre(21, 22, 31, 0 - 16))
  bu32(code, encode_stp_pre(23, 24, 31, 0 - 16))
  bu32(code, encode_stp_pre(25, 26, 31, 0 - 16))
  emit_prologue3(code)
}
fn emit_prologue3(code: i64) -> i64 {
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  bu32(code, encode_add_imm(29, 31, 0))
  bu32(code, encode_sub_imm(31, 31, 2048))
}

fn emit_epilogue(code: i64) -> i64 {
  bu32(code, encode_add_imm(31, 31, 2048))
  bu32(code, encode_ldp_post(29, 30, 31, 16))
  bu32(code, encode_ldp_post(25, 26, 31, 16))
  bu32(code, encode_ldp_post(23, 24, 31, 16))
  emit_epilogue2(code)
}
fn emit_epilogue2(code: i64) -> i64 {
  bu32(code, encode_ldp_post(21, 22, 31, 16))
  bu32(code, encode_ldp_post(19, 20, 31, 16))
  bu32(code, encode_ldp_post(14, 15, 31, 16))
  bu32(code, encode_ldp_post(12, 13, 31, 16))
  emit_epilogue3(code)
}
fn emit_epilogue3(code: i64) -> i64 {
  bu32(code, encode_ldp_post(10, 11, 31, 16))
  bu32(code, encode_ldp_post(8, 9, 31, 16))
  bu32(code, encode_ret())
}

-- ======================================================================
-- Register allocation
-- ======================================================================

-- Map register counter to register identifier
-- 0-7 -> x19-x26 (physical, returned as 19-26)
-- 8+ -> spill slot (returned as negative: -(slot+1))
fn reg_id(counter: i64) -> i64 {
  if counter < 8 { counter + 19 }
  else { 0 - (counter - 7) }
}

-- For backward compatibility
fn reg_phys(counter: i64) -> i64 {
  if counter < 8 { counter + 19 } else { 17 }
}

-- Emit: move value from reg_phys(counter) to a usable register
-- If counter < 8, the value is already in a physical register.
-- If counter >= 8, emit LDR from spill slot into x16 (temp).
fn emit_load_reg(code: i64, counter: i64) -> i64 {
  -- Returns the physical register containing the value
  if counter < 8 { counter + 19 }
  else {
    -- LDR x16, [sp, #((counter-8)*8)]
    -- 0xF9400000 = 4181721088
    let slot = (counter - 8) * 8
    bu32(code, cg_ldr(16, 31, slot))
    16
  }
}

fn emit_load_reg_id(code: i64, rid: i64, temp: i64) -> i64 {
  if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(temp, 31, slot * 8))
    temp
  } else { rid }
}

fn emit_load_rhs(code: i64, counter: i64) -> i64 {
  -- Same as emit_load_reg but uses x17 instead of x16
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    bu32(code, cg_ldr(17, 31, slot))
    17
  }
}

fn emit_store_reg(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter >= 8 {
    -- STR phys_reg, [sp, #((counter-8)*8)]
    -- 0xF9000000 = 4177526784
    let slot = (counter - 8) * 8
    bu32(code, cg_str(phys_reg, 31, slot))
  } else { 0 }
}

-- ======================================================================
-- Code generation: all cg_* functions
-- ======================================================================

-- String literal codegen: emit bytes from source into heap at runtime
-- x16 = data pointer, x17 = byte temp
fn cg_string_bytes(code: i64, src: i64, start: i64, len: i64) -> i64 {
  for i in 0..len {
    let byte = __mem_load8(src + start + i)
    bu32(code, encode_movz(17, byte, 0))
    bu32(code, cg_strb(17, 16, i))
  }
  0
}
fn cg_string(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let str_start = node_f1(node)
  let str_len = node_f2(node)
  let aligned_len = (str_len + 7) / 8 * 8
  -- Step 1: bump-alloc data
  cg_bump_alloc_imm(code, 16, aligned_len)
  -- Step 2: store each byte (compile-time known from source)
  cg_string_bytes(code, src, str_start, str_len)
  -- Step 3: bump-alloc descriptor (16 bytes)
  cg_bump_alloc_imm(code, 17, 16)
  -- Step 4: STR x16, [x17, #0] (data ptr): 0xF9000000 = 4177526784
  bu32(code, cg_str(16, 17, 0))
  -- Step 5: MOVZ x16, #len; STR x16, [x17, #8]
  emit_mov_imm(code, 16, str_len)
  bu32(code, cg_str(16, 17, 8))
  -- Step 6: move x17 (descriptor) to result register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

-- While: loop with condition check, evaluates to 0 (nil)
fn cg_while(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let cond = node_f1(node)
  let body = node_f2(node)
  -- Save outer loop context
  let old_loop_start = __mem_load64(fm + 56)
  let old_break_patches = __mem_load64(fm + 64)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_loop_result_ctr = fmap_loop_result_ctr(fm)
  -- Set up this loop's context
  let loop_start = buf_len(code)
  let break_patches = nlist_new()
  __mem_store64(fm + 56, loop_start)
  __mem_store64(fm + 64, break_patches)
  __mem_store64(fm + 152, cg_cleanup_count(fm))
  fmap_set_loop_result_ctr(fm, ctr)
  let c1 = cg_expr(cond, code, scope, src, ctr, fm)
  let cond_phys = emit_load_reg(code, c1 - 1)
  -- CBZ cond, after_loop (placeholder)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- body (result discarded)
  let c2 = cg_expr(body, code, scope, src, c1, fm)
  -- B loop_start
  let b_pos = buf_len(code)
  bu32(code, encode_b(loop_start - b_pos))
  -- Patch CBZ and all break targets
  let after_loop = buf_len(code)
  cg_patch_cbz(code, cbz_pos, cond_phys, after_loop)
  cg_patch_breaks(code, break_patches, after_loop)
  -- Restore outer loop context
  __mem_store64(fm + 56, old_loop_start)
  __mem_store64(fm + 64, old_break_patches)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
  -- Result is 0 (nil)
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

-- LetMut: like Let but forces value to a spill slot for reassignment
fn cg_let_mut(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_let_mut_with_type(node, code, scope, src, ctr, fm, cg_expr_type(node_f3(node), scope, src, fm))
}

fn cg_let_mut_with_type(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, binding_ty: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let depth = cg_cleanup_count(fm)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  -- Force to a spill slot so assignment can overwrite it
  let val_phys = emit_load_reg(code, c1 - 1)
  -- Use counter 8+ to guarantee a spill slot
  let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
  bu32(code, encode_add_imm(17, val_phys, 0))
  emit_store_reg(code, mut_ctr, 17)
  let val_rid = reg_id(mut_ctr)
  if cg_ty_is_managed(binding_ty) == 1 {
    if cg_expr_is_borrow_for_ty(binding_ty, val, scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, binding_ty, val_rid)
    } else { 0 }
    cg_cleanup_push_for_ty(fm, binding_ty, val_rid)
  } else { 0 }
  let new_scope = scope_push_typed(scope, ns, nl, val_rid, binding_ty)
  let br = cg_expr(body, code, new_scope, src, mut_ctr + 1, fm)
  if cg_ty_is_managed(binding_ty) == 1 {
    let save_ctr = br
    cg_match_store_result(code, save_ctr, br)
    if cg_expr_is_borrow_for_ty(binding_ty, body, new_scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, binding_ty, reg_id(save_ctr))
    } else { 0 }
    cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
    cg_cleanup_restore(fm, depth)
    cg_match_store_result(code, ctr, save_ctr + 1)
    ctr + 1
  } else { br }
}

-- Assignment: write new value to mutable variable's spill slot
fn cg_assign(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  let var_rid = scope_lookup(scope, src, ns, nl)
  let var_ty = scope_lookup_type(scope, src, ns, nl)
  if var_rid == 0 - 999 {
    eprint_span(src, ns)
    eprint("error: assignment to undefined variable: ")
    sys_write(2, src + ns, nl)
    eprint("\n")
    c1
  } else {
    let val_rid = reg_id(c1 - 1)
    if cg_ty_is_managed(var_ty) == 1 {
      if cg_expr_is_borrow_for_ty(var_ty, val, scope, src, fm) == 1 {
        cg_emit_managed_retain_regid(code, fm, var_ty, val_rid)
      } else { 0 }
      cg_emit_managed_release_regid(code, fm, var_ty, var_rid)
    } else { 0 }
    let val_phys = emit_load_reg(code, c1 - 1)
    if var_rid < 0 {
      let slot = 0 - var_rid - 1
      bu32(code, cg_str(val_phys, 31, slot * 8))
    } else {
      bu32(code, encode_add_imm(var_rid, val_phys, 0))
    }
    c1
  }
}

-- Block: evaluate first for side effects, then evaluate and return rest
-- Record construction: allocate num_fields * 8 bytes, store each field value
fn cg_record_init(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let type_ns = node_f1(node)
  let type_nl = node_f2(node)
  let fields = node_f3(node)
  let nfields = node_f4(node)
  -- Allocate nfields * 8 bytes using __bump_alloc inline
  let size = nfields * 8
  emit_mov_imm(code, 0, size)
  cg_bump_alloc_reg(code, 17, 0)
  -- Result (record ptr) in x17. Store to ctr register.
  if ctr < 8 {
    let e3 = encode_add_imm(ctr + 19, 17, 0)
    bu32(code, e3)
  } else {
    emit_store_reg(code, ctr, 17)
  }
  -- Store each field value. Pack base_ctr and i: base*256+i
  -- Fields use temporary registers but the RECORD POINTER is the result
  let record_info = node_new(0, ctr, type_ns, type_nl, 0)
  cg_record_fields(fields, nfields, code, scope, src, ctr + 1, fm, record_info)
  -- Return ctr+1: the record pointer is at counter ctr, result is ctr+1
  ctr + 1
}
-- Store fields at declaration offset (not literal order)
fn cg_record_fields(fields: i64, nfields: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  let tt = fmap_get_tt(fm)
  let base_ctr = node_f1(info)
  let type_ns = node_f2(info)
  let type_nl = node_f3(info)
  let mut c = ctr
  for i in 0..nfields {
    let field_pair = nlist_get(fields, i)
    let f_ns = node_f1(field_pair)
    let f_nl = node_f2(field_pair)
    let val_node = node_f3(field_pair)
    c = cg_expr(val_node, code, scope, src, c, fm)
    let base_phys = emit_load_reg(code, base_ctr)
    let val_phys = emit_load_rhs(code, c - 1)
    -- Look up field index from type table (not positional)
    let field_idx = ttable_find_field_in_type(tt, src, type_ns, type_nl, f_ns, f_nl, i)
    let off = field_idx * 8
    let str_enc = cg_str(val_phys, base_phys, off)
    bu32(code, str_enc)
  }
  c
}

-- Field access: load from record + field_index * 8
fn cg_field_access(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  -- Evaluate base expression
  let c1 = cg_expr(base, code, scope, src, ctr, fm)
  let base_phys = emit_load_reg(code, c1 - 1)
  -- Look up field index from type table
  let tt = fmap_get_tt(fm)
  let idx = if node_f4(node) > 0 { node_f4(node) - 1 } else { ttable_find_any_field(tt, src, field_ns, field_nl) }
  -- LDR x17, [base + idx * 8]
  let off = idx * 8
  let ldr_enc = cg_ldr(17, base_phys, off)
  bu32(code, ldr_enc)
  if c1 < 8 {
    let e_fa = encode_add_imm(c1 + 19, 17, 0)
    bu32(code, e_fa)
  } else {
    emit_store_reg(code, c1, 17)
  }
  c1 + 1
}

-- ======================================================================
-- Match expression codegen
-- ======================================================================

-- Helper: emit comparison test, body, branch for an int literal arm
fn cg_match_int_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let lit_val = node_f1(pat)
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  emit_mov_imm(code, 17, lit_val)
  bu32(code, encode_cmp(scr_phys, 17))
  bu32(code, encode_cset(17, 0))
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard check (if present)
  let guard_cbz = if guard > 0 {
    let cg = cg_expr(guard, code, scope, src, ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  } else { 0 }
  let c_body = cg_expr(body, code, scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 17, next_start)
  if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Helper: emit tag comparison, payload binding, guard, body for constructor arm
fn cg_match_ctor_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  let expected_hash = str_hash(src, tag_ns, tag_nl)
  cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Bind payload(s) (if present: b_nl > 0 for single, b_nl < 0 for multi)
  let body_scope = if b_nl != 0 {
    cg_match_ctor_bind_only(code, scope, ctr, scrutinee_ctr, b_ns, b_nl)
  } else { scope }
  let body_ctr = if b_nl != 0 {
    if b_nl < 0 { ctr + (0 - b_nl) } else { ctr + 1 }
  } else { ctr }
  -- Guard check (if present)
  let guard_cbz = if guard > 0 {
    let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  } else { 0 }
  -- Evaluate body
  let result = cg_expr(body, code, body_scope, src, body_ctr, fm)
  cg_match_store_result(code, ctr, result)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 17, next_start)
  if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Bind constructor payload to scope without evaluating body
fn cg_match_ctor_bind_only(code: i64, scope: i64, ctr: i64, scrutinee_ctr: i64, b_ns: i64, b_nl: i64) -> i64 {
  if b_nl < 0 {
    -- Multi-binding: b_ns is a bindings list, b_nl is negative count
    let bindings = b_ns
    let nb = 0 - b_nl
    let mut s = scope
    let mut c = ctr
    for i in 0..nb {
      let b = nlist_get(bindings, i)
      if node_tag(b) == 18 {
        let scr2 = emit_load_reg(code, scrutinee_ctr)
        bu32(code, cg_ldr(17, scr2, 8 + i * 8))
        if c < 8 {
          bu32(code, encode_add_imm(c + 19, 17, 0))
        } else {
          emit_store_reg(code, c, 17)
        }
        s = scope_push(s, node_f1(b), node_f2(b), reg_id(c))
        c = c + 1
      } else { c = c }
    }
    s
  } else {
    -- Single binding (backward compat)
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 {
      bu32(code, encode_add_imm(ctr + 19, 17, 0))
    } else {
      emit_store_reg(code, ctr, 17)
    }
    scope_push(scope, b_ns, b_nl, reg_id(ctr))
  }
}

-- Emit: LDR tag from scrutinee, compare with expected, CSET result to x17
fn cg_match_ctor_test(code: i64, scrutinee_ctr: i64, expected_hash: i64) -> i64 {
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  -- LDR x17, [scrutinee, #0] (tag hash)
  bu32(code, cg_ldr(17, scr_phys, 0))
  emit_mov_imm(code, 16, expected_hash)
  let cmp_enc = encode_cmp(17, 16)
  bu32(code, cmp_enc)
  let cset_enc = encode_cset(17, 0)
  bu32(code, cset_enc)
  0
}

-- Bind payload (if present) and evaluate body
-- b_packed = b_ns * 256 + b_nl (to stay at 8 params)
fn cg_match_ctor_body(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_nl = b_packed - (b_packed / 256) * 256
  if b_nl > 0 {
    let b_ns = b_packed / 256
    cg_match_ctor_bind(code, scope, src, ctr, fm, scrutinee_ctr, b_ns * 256 + b_nl, body)
  } else {
    cg_expr(body, code, scope, src, ctr, fm)
  }
}

-- Emit payload load, bind to scope, evaluate body
fn cg_match_ctor_bind(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_ns = b_packed / 256
  let b_nl = b_packed - b_ns * 256
  if b_nl > 128 {
    -- Multi-binding encoded: b_nl > 128 means b_ns is list ptr, actual count = 256 - b_nl
    -- This path is unused in current code (cg_match_ctor_body doesn't handle multi)
    -- Fall back to first binding for now
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
    cg_expr(body, code, scope_push(scope, b_ns, b_nl, reg_id(ctr)), src, ctr + 1, fm)
  } else {
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
    let new_scope = scope_push(scope, b_ns, b_nl, reg_id(ctr))
    cg_expr(body, code, new_scope, src, ctr + 1, fm)
  }
}

-- Store match arm result at ctr
fn cg_match_store_result(code: i64, ctr: i64, c_body: i64) -> i64 {
  let body_phys = emit_load_reg(code, c_body - 1)
  if ctr < 8 {
    let e = encode_add_imm(ctr + 19, body_phys, 0)
    bu32(code, e)
  } else {
    let e = encode_add_imm(17, body_phys, 0)
    bu32(code, e)
    emit_store_reg(code, ctr, 17)
  }
  0
}

-- Process remaining arms after current arm
fn cg_match_remaining(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let remaining = nlist_new()
  cg_copy_arms_from(arms, n_arms, remaining, 1)
  cg_match_arms(remaining, n_arms - 1, code, scope, src, ctr, fm, scrutinee_ctr)
}

-- Match expression: compile as if-else chain
fn cg_match(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let scrutinee = node_f1(node)
  let arms = node_f2(node)
  let n_arms = node_f3(node)
  let c1 = cg_expr(scrutinee, code, scope, src, ctr, fm)
  cg_match_arms(arms, n_arms, code, scope, src, c1, fm, c1 - 1)
}
-- scrutinee_ctr: counter where the scrutinee value lives
fn cg_match_arms(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  if n_arms <= 0 {
    -- Non-exhaustive match: emit runtime trap (BRK #1 = 0xD4200020)
    bu32(code, encode_brk(1))
    cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  } else {
    cg_match_dispatch(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Binary tree dispatch: split by pat_tag range to limit nesting depth
fn cg_match_dispatch(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag <= 18 {
    cg_match_arm_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_arm_high(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Handle wildcard (17) and binding (18) patterns
fn cg_match_arm_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  if guard == 0 {
    -- No guard: wildcard/binding always matches
    if pat_tag == 17 {
      let c_body = cg_expr(body, code, scope, src, ctr, fm)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    } else {
      let c_body = cg_match_bind_arm(body, pat, code, scope, src, ctr, fm, scrutinee_ctr)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    }
  } else {
    -- Guard present: bind pattern, eval guard, CBZ to next arm if false
    cg_match_guarded_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

fn cg_match_guarded_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  -- Set up scope (binding adds variable, wildcard doesn't)
  let guard_scope = if pat_tag == 18 {
    let b_ns = node_f1(pat)
    let b_nl = node_f2(pat)
    scope_push(scope, b_ns, b_nl, reg_id(scrutinee_ctr))
  } else { scope }
  -- Evaluate guard
  let cg = cg_expr(guard, code, guard_scope, src, ctr, fm)
  let gp = emit_load_reg(code, cg - 1)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard passed: evaluate body
  let c_body = cg_expr(body, code, guard_scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  -- Guard failed: try remaining arms
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, gp, next_start)
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Handle binding pattern: bind scrutinee to variable name
fn cg_match_bind_arm(body: i64, pat: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let b_ns = node_f1(pat)
  let b_nl = node_f2(pat)
  let scr_rid = reg_id(scrutinee_ctr)
  let new_scope = scope_push(scope, b_ns, b_nl, scr_rid)
  cg_expr(body, code, new_scope, src, ctr, fm)
}

-- Handle int literal (19) and constructor (20) patterns
fn cg_match_arm_high(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag == 19 {
    cg_match_int_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_ctor_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}
-- Copy arms from index start to a new list
fn cg_copy_arms_from(arms: i64, n: i64, dest: i64, start: i64) -> i64 {
  for i in start..n {
    nlist_add(dest, nlist_get(arms, i))
  }
  0
}

fn cg_block(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let first = node_f1(node)
  let rest = node_f2(node)
  cg_expr(first, code, scope, src, ctr, fm)
  cg_expr(rest, code, scope, src, ctr, fm)
}

fn cg_emit_call_lit(code: i64, fm: i64, name: str) -> i64 {
  let sp = __str_ptr(name)
  let sl = __str_len(name)
  let cur = buf_len(code)
  if fmap_contains(fm, sp, 0, sl) == 0 {
    eprint("error: required runtime function unavailable: ")
    sys_write(2, sp, sl)
    eprint("\n")
    bu32(code, encode_bl(0))
  } else {
    let target = fmap_lookup(fm, sp, 0, sl)
    if target == 0 {
      fmap_add_patch(fm, cur, sp, 0, sl)
      bu32(code, encode_bl(0))
    } else {
      bu32(code, encode_bl(target - cur))
    }
  }
}

fn cg_emit_rc_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_retain")
}

fn cg_emit_rc_release_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_release")
}

fn cg_emit_rc_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_rc_retain_phys(code, fm, phys)
}

fn cg_emit_rc_release_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_rc_release_phys(code, fm, phys)
}

fn cg_ty_is_rc(ty: i64) -> i64 {
  if ty == 0 { 0 } else { ty_is_rc(ty) }
}

fn cg_emit_closure_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "closure_default_retain")
}

fn cg_emit_closure_release_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "closure_default_release")
}

fn cg_emit_closure_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_closure_retain_phys(code, fm, phys)
}

fn cg_emit_closure_release_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_closure_release_phys(code, fm, phys)
}

fn cg_ty_is_closure(ty: i64) -> i64 {
  if ty == 0 { 0 } else { ty_tag(ty) == 6 }
}

fn cg_ty_is_managed(ty: i64) -> i64 {
  cg_ty_is_rc(ty) == 1 or cg_ty_is_closure(ty) == 1
}

fn cg_emit_managed_retain_regid(code: i64, fm: i64, ty: i64, rid: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_emit_rc_retain_regid(code, fm, rid) }
  else { if cg_ty_is_closure(ty) == 1 { cg_emit_closure_retain_regid(code, fm, rid) } else { 0 } }
}

fn cg_emit_managed_release_regid(code: i64, fm: i64, ty: i64, rid: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_emit_rc_release_regid(code, fm, rid) }
  else { if cg_ty_is_closure(ty) == 1 { cg_emit_closure_release_regid(code, fm, rid) } else { 0 } }
}

fn cg_param_ty(params: i64, idx: i64) -> i64 {
  if params == 0 { 0 }
  else { if idx >= nlist_len(params) { 0 }
  else { node_f3(nlist_get(params, idx)) } }
}

fn cg_param_info_ty(params: i64, idx: i64, kind: i64) -> i64 {
  if params == 0 { 0 }
  else { if idx >= nlist_len(params) { 0 }
  else {
    if kind == 1 { nlist_get(params, idx) } else { node_f3(nlist_get(params, idx)) }
  } }
}

fn cg_build_subst(tparams: i64, type_args: i64) -> i64 {
  let s = subst_new()
  if tparams == 0 { s }
  else {
    let n = nlist_len(tparams)
    let nargs = if type_args == 0 { 0 } else { nlist_len(type_args) }
    for i in 0..n {
      if i < nargs {
        let tp = nlist_get(tparams, i)
        subst_add(s, node_f3(tp), nlist_get(type_args, i))
      } else { 0 }
    }
    s
  }
}

fn cg_params_subst(params: i64, s: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let result = nlist_new()
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      let ty = node_f3(p)
      let subst_ty = if ty == 0 { 0 } else { ty_subst(ty, s) }
      nlist_add(result, node_new(node_tag(p), node_f1(p), node_f2(p), subst_ty, node_f4(p)))
    }
    result
  }
}

fn cg_generic_subst_params(fm: i64, name_hash: i64, type_args: i64) -> i64 {
  let tm = __mem_load64(fm + 80)
  let tmpl_entry = mono_tmap_lookup(tm, name_hash)
  if tmpl_entry == 0 { 0 }
  else {
    let tmpl_wrap = __mem_load64(tmpl_entry + 8)
    let tmpl_inner = unwrap_fn(tmpl_wrap)
    let s = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
    cg_params_subst(node_f3(tmpl_inner), s)
  }
}

fn cg_generic_subst_ret(tmpl_wrap: i64, type_args: i64) -> i64 {
  let ret_ty = fn_ret_type(tmpl_wrap)
  let s = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
  if ret_ty == 0 { 0 } else { ty_subst(ret_ty, s) }
}

fn cg_merge_expr_type(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { if ty_eq(a, b) { a } else { ty_union(a, b) } } }
}

fn cg_match_body_type(arms: i64, n: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < n {
    let arm = nlist_get(arms, i)
    result = cg_merge_expr_type(result, cg_expr_type(node_f2(arm), scope, src, fm))
    i = i + 1
  }
  result
}

fn cg_lambda_param_ty(param: i64) -> i64 {
  let ann_ty = node_f3(param)
  if ann_ty != 0 { ann_ty } else { ty_i64() }
}

fn cg_lambda_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  let param_tys = nlist_new()
  let mut body_scope = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = cg_lambda_param_ty(p)
    nlist_add(param_tys, param_ty)
    body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), 0, param_ty)
  }
  ty_fn(param_tys, cg_expr_type(body, body_scope, src, fm), ty_effect_pure())
}

fn cg_expr_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> ty_i64()
      2 -> {
        let ty = scope_lookup_type(scope, src, node_f1(node), node_f2(node))
        if ty != 0 { ty }
        else {
          let fn_ty = cg_ftypes_lookup_fn_type(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node))
          if fn_ty != 0 { fn_ty } else { cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node)) }
        }
      }
      4 -> cg_ftypes_lookup_ret(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node))
      5 -> cg_merge_expr_type(cg_expr_type(node_f2(node), scope, src, fm), cg_expr_type(node_f3(node), scope, src, fm))
      6 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
        cg_expr_type(node_f4(node), new_scope, src, fm)
      }
      7 -> cg_expr_type(node_f2(node), scope, src, fm)
      9 -> ty_str()
      11 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
        cg_expr_type(node_f4(node), new_scope, src, fm)
      }
      15 -> cg_match_body_type(node_f2(node), node_f3(node), scope, src, fm)
      24 -> ty_bool()
      25 -> cg_expr_type(node_f1(node), scope, src, fm)
      26 -> cg_expr_type(node_f1(node), scope, src, fm)
      29 -> cg_lambda_type(node, scope, src, fm)
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        let new_scope = scope_push_typed(scope, node_f1(inner), node_f2(inner), 0, ann_ty)
        cg_expr_type(node_f4(inner), new_scope, src, fm)
      }
      52 -> cg_expr_type(node_f2(node), scope, src, fm)
      49 -> cg_expr_type(node_f1(node), scope, src, fm)
      _ -> 0
    }
  }
}

fn cg_match_bodies_are_borrowed(arms: i64, n: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if n == 0 { 0 }
  else {
    let mut all_borrowed = 1
    let mut i = 0
    while i < n {
      let arm = nlist_get(arms, i)
      if cg_rc_expr_is_borrow(node_f2(arm), scope, src, fm) == 0 {
        all_borrowed = 0
        i = n
      } else { i = i + 1 }
    }
    all_borrowed
  }
}

fn cg_rc_expr_is_borrow(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_ty_is_rc(cg_expr_type(node, scope, src, fm)) == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> 1
      5 -> cg_rc_expr_is_borrow(node_f2(node), scope, src, fm) and cg_rc_expr_is_borrow(node_f3(node), scope, src, fm)
      6 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        if cg_ty_is_rc(val_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
          cg_rc_expr_is_borrow(node_f4(node), new_scope, src, fm)
        }
      }
      7 -> cg_rc_expr_is_borrow(node_f2(node), scope, src, fm)
      11 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        if cg_ty_is_rc(val_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
          cg_rc_expr_is_borrow(node_f4(node), new_scope, src, fm)
        }
      }
      15 -> cg_match_bodies_are_borrowed(node_f2(node), node_f3(node), scope, src, fm)
      25 -> cg_rc_expr_is_borrow(node_f1(node), scope, src, fm)
      26 -> cg_rc_expr_is_borrow(node_f1(node), scope, src, fm)
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        if cg_ty_is_rc(ann_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(inner), node_f2(inner), 0, ann_ty)
          cg_rc_expr_is_borrow(node_f4(inner), new_scope, src, fm)
        }
      }
      49 -> cg_rc_expr_is_borrow(node_f1(node), scope, src, fm)
      52 -> cg_rc_expr_is_borrow(node_f2(node), scope, src, fm)
      _ -> 0
    }
  }
}

fn cg_closure_match_bodies_are_borrowed(arms: i64, n: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if n == 0 { 0 }
  else {
    let mut all_borrowed = 1
    let mut i = 0
    while i < n {
      let arm = nlist_get(arms, i)
      if cg_closure_expr_is_borrow(node_f2(arm), scope, src, fm) == 0 {
        all_borrowed = 0
        i = n
      } else { i = i + 1 }
    }
    all_borrowed
  }
}

fn cg_closure_expr_is_borrow(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_ty_is_closure(cg_expr_type(node, scope, src, fm)) == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> if scope_lookup(scope, src, node_f1(node), node_f2(node)) == 0 - 999 { 0 } else { 1 }
      5 -> cg_closure_expr_is_borrow(node_f2(node), scope, src, fm) and cg_closure_expr_is_borrow(node_f3(node), scope, src, fm)
      6 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        if cg_ty_is_closure(val_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
          cg_closure_expr_is_borrow(node_f4(node), new_scope, src, fm)
        }
      }
      7 -> cg_closure_expr_is_borrow(node_f2(node), scope, src, fm)
      11 -> {
        let val_ty = cg_expr_type(node_f3(node), scope, src, fm)
        if cg_ty_is_closure(val_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), 0, val_ty)
          cg_closure_expr_is_borrow(node_f4(node), new_scope, src, fm)
        }
      }
      15 -> cg_closure_match_bodies_are_borrowed(node_f2(node), node_f3(node), scope, src, fm)
      25 -> cg_closure_expr_is_borrow(node_f1(node), scope, src, fm)
      26 -> cg_closure_expr_is_borrow(node_f1(node), scope, src, fm)
      37 -> {
        let inner = node_f1(node)
        let ann_ty = node_f2(node)
        if cg_ty_is_closure(ann_ty) == 1 { 0 }
        else {
          let new_scope = scope_push_typed(scope, node_f1(inner), node_f2(inner), 0, ann_ty)
          cg_closure_expr_is_borrow(node_f4(inner), new_scope, src, fm)
        }
      }
      49 -> cg_closure_expr_is_borrow(node_f1(node), scope, src, fm)
      52 -> cg_closure_expr_is_borrow(node_f2(node), scope, src, fm)
      _ -> 0
    }
  }
}

fn cg_expr_is_borrow_for_ty(ty: i64, node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_rc_expr_is_borrow(node, scope, src, fm) }
  else { if cg_ty_is_closure(ty) == 1 { cg_closure_expr_is_borrow(node, scope, src, fm) } else { 0 } }
}

fn cg_same_name(src: i64, a_ns: i64, a_nl: i64, b_ns: i64, b_nl: i64) -> i64 {
  if a_nl != b_nl { 0 } else { src_eq_at(src, a_ns, src + b_ns, 0, a_nl) }
}

fn cg_expr_list_calls_rc_count(args: i64, nargs: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nargs {
    if cg_expr_calls_rc_count(nlist_get(args, i), src) == 1 {
      found = 1
      i = nargs
    } else { i = i + 1 }
  }
  found
}

fn cg_record_fields_call_rc_count(fields: i64, nfields: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nfields {
    let field = nlist_get(fields, i)
    if cg_expr_calls_rc_count(node_f3(field), src) == 1 {
      found = 1
      i = nfields
    } else { i = i + 1 }
  }
  found
}

fn cg_match_arms_call_rc_count(arms: i64, narms: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < narms {
    let arm = nlist_get(arms, i)
    if cg_expr_calls_rc_count(node_f2(arm), src) == 1 {
      found = 1
      i = narms
    } else {
      if cg_expr_calls_rc_count(node_f3(arm), src) == 1 {
        found = 1
        i = narms
      } else { i = i + 1 }
    }
  }
  found
}

fn cg_handler_clauses_call_rc_count(clauses: i64, nclauses: i64, src: i64) -> i64 {
  let mut found = 0
  let mut i = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if cg_expr_calls_rc_count(node_f3(clause), src) == 1 {
      found = 1
      i = nclauses
    } else { i = i + 1 }
  }
  found
}

fn cg_expr_calls_rc_count(node: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> cg_expr_calls_rc_count(node_f2(node), src) or cg_expr_calls_rc_count(node_f3(node), src)
      4 -> if src_eq(src, node_f1(node), node_f2(node), "rc_count") == 1 { 1 } else { cg_expr_list_calls_rc_count(node_f3(node), node_f4(node), src) }
      5 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src) or cg_expr_calls_rc_count(node_f3(node), src)
      6 -> cg_expr_calls_rc_count(node_f3(node), src) or cg_expr_calls_rc_count(node_f4(node), src)
      7 -> cg_expr_calls_rc_count(node_f1(node), src) or cg_expr_calls_rc_count(node_f2(node), src)
