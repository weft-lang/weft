}

fn cg_vector_ident_list_has(list: i64, src: i64, ident: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(list) {
    let existing = nlist_get(list, i)
    if cg_span_eq(src, node_f1(existing), node_f2(existing), src, node_f1(ident), node_f2(ident)) == 1 {
      found = 1
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

fn cg_vector_ident_list_add(list: i64, src: i64, ident: i64) -> i64 {
  if ident == 0 { 0 }
  else { if node_tag(ident) != 2 { 0 }
  else { if cg_vector_ident_list_has(list, src, ident) == 1 { 0 }
  else { nlist_add(list, ident) } } }
}

fn cg_vector_len_call_vec_ident(node: i64, scope: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 4 { 0 }
  else { if src_eq(src, node_f1(node), node_f2(node), "vector_len") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else {
    let arg = nlist_get(node_f3(node), 0)
    if node_tag(arg) == 2 { arg } else { 0 }
  } } } } } }
}

fn cg_vector_len_alias_push_if_needed(fm: i64, src: i64, ns: i64, nl: i64, val: i64, scope: i64) -> i64 {
  let vec = cg_vector_len_call_vec_ident(val, scope, src)
