-- codegen.weft — code generation for aarch64
-- Scope, type table, function map, prologue/epilogue, register allocation,
-- and all cg_* code generation functions

use compiler/encode.{*}
use compiler/effect_ref.{*}
use compiler/parse.{*}
use compiler/types.{*}
use compiler/typeck.{*}
use compiler/ir.{*}
use compiler/module.{*}
use compiler/type_registry.{*}
use compiler/lib.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/effects.{*}
use runtime/float.{*}
use runtime/memory.{*}
use runtime/syscall.{*}
use stdlib/vector.{*}

pub(package) fn cg_alloc_bytes(size: i64) -> i64 {
  alloc_words((size + 7) / 8)
}

pub(package) fn cg_str(rt: i64, rn: i64, off: i64) -> i64 { encode_str(rt, rn, off) }
pub(package) fn cg_ldr(rt: i64, rn: i64, off: i64) -> i64 { encode_ldr(rt, rn, off) }
pub(package) fn cg_strb(rt: i64, rn: i64, off: i64) -> i64 { encode_strb(rt, rn, off) }
pub(package) fn cg_ldrb(rt: i64, rn: i64, off: i64) -> i64 { encode_ldrb(rt, rn, off) }
-- 96 -> 112 (2r slice 1): +16 bytes cache the default rc heap's arena
-- bounds (base at 96, end at 104) so the retain/release magic guard is
-- two state loads instead of a four-call heap/arena pointer chase.
-- 120 -> 128 (2t): +8 bytes for the dynamic-dispatch masked context —
-- handler_find_entry stores the found frame's prev at offset 120 so the
-- perform site can run the clause with its own handler frame masked
-- (self-label performs must dispatch outward). Runtime twin:
-- handler_dispatch_prev_offset in runtime/effects.weft.
-- 128 -> 160 (4j): the found handler frame plus J3's abort-cleanup shadow
-- chain and active-abortive-handler pointer. 6b claims the word at 152 for
-- the read-only native-provenance table pointer. 4l adds a default-heap
-- initialization lock at 160. 6a owns the diagnostic color request at 168.
-- 3x adds the process-lifetime Darwin poller epoch at 176 and its allocation
-- lock at 184;
-- round the bump arena start to 16-byte alignment.
pub(package) fn runtime_state_size() -> i64 { 192 }
-- 5a measurement-only tail. Ordinary binaries retain the 192-byte ABI;
-- `weft compile --rc-census` reserves thirty-nine additional atomic counters.
-- Runtime twin: runtime/rc_census.weft.
pub(package) fn runtime_state_rc_census_base_offset() -> i64 { 192 }
pub(package) fn runtime_state_rc_census_event_count() -> i64 { 39 }
pub(package) fn runtime_state_rc_census_size() -> i64 { 504 }
pub(package) fn runtime_state_dispatch_prev_offset() -> i64 { 120 }
pub(package) fn runtime_state_dispatch_frame_offset() -> i64 { 128 }
pub(package) fn runtime_state_abort_cleanup_top_offset() -> i64 { 136 }
pub(package) fn runtime_state_abort_cleanup_active_offset() -> i64 { 144 }
pub(package) fn runtime_state_native_provenance_offset() -> i64 { 152 }
pub(package) fn runtime_state_default_heap_init_lock_offset() -> i64 { 160 }
pub(package) fn runtime_state_diagnostic_color_mode_offset() -> i64 { 168 }
pub(package) fn runtime_state_net_poller_epoch_offset() -> i64 { 176 }
pub(package) fn runtime_state_net_poller_epoch_lock_offset() -> i64 { 184 }
pub(package) fn runtime_state_bump_offset() -> i64 { 0 }
-- Base of the CURRENT bump segment's allocatable range. Written at
-- startup and on every segment chain; alloc_bump_restore_same_segment
-- proves same-segment membership against it (segments are disjoint
-- mappings, so [base, bump] containment is exact). Runtime twin:
-- alloc_bump_base_offset in runtime/alloc.weft.
pub(package) fn runtime_state_bump_base_offset() -> i64 { 112 }
pub(package) fn runtime_state_rc_heap_offset() -> i64 { 8 }
pub(package) fn runtime_state_fiber_prompt_offset() -> i64 { 16 }
pub(package) fn runtime_state_fiber_done_offset() -> i64 { 24 }
pub(package) fn runtime_state_bump_end_offset() -> i64 { 32 }
pub(package) fn runtime_state_deferred_ops_offset() -> i64 { 40 }
pub(package) fn runtime_state_deferred_prompt_offset() -> i64 { 48 }
pub(package) fn runtime_state_deferred_effect_hash_offset() -> i64 { 56 }
pub(package) fn runtime_state_deferred_op_count_offset() -> i64 { 64 }
pub(package) fn runtime_state_deferred_prev_offset() -> i64 { 72 }
pub(package) fn runtime_state_deferred_cleanup_desc_offset() -> i64 { 80 }
pub(package) fn runtime_state_deferred_cleanup_segment_offset() -> i64 { 88 }
pub(package) fn deferred_runtime_context_size() -> i64 { 40 }
pub(package) fn deferred_runtime_context_ops_offset() -> i64 { 0 }
pub(package) fn deferred_runtime_context_prompt_offset() -> i64 { 8 }
pub(package) fn deferred_runtime_context_effect_hash_offset() -> i64 { 16 }
pub(package) fn deferred_runtime_context_op_count_offset() -> i64 { 24 }
pub(package) fn deferred_runtime_context_prev_offset() -> i64 { 32 }
pub(package) fn runtime_bump_segment_size() -> i64 { 536870912 }

pub(package) fn cg_stack_frame_default_size() -> i64 { 2048 }
pub(package) fn cg_stack_adjust_chunk_size() -> i64 { 4080 }
pub(package) fn cg_spill_inline_offset_limit() -> i64 { 32760 }

pub(package) fn cg_align16(size: i64) -> i64 {
  let rem = size % 16
  if rem == 0 { size } else { size + (16 - rem) }
}

pub(package) fn cg_bump_emit_grow(code: i64, dst: i64, size_reg: i64, next_reg: i64, status_reg: i64) -> i64 {
  -- Preserve requested size before setting up the mmap syscall.
  if size_reg != 12 { bu32(code, encode_add_imm(12, size_reg, 0)) } else { 0 }
  bu32(code, encode_add_imm(14, 12, runtime_state_size()))
  emit_mov_imm_safe(code, 1, runtime_bump_segment_size())
  bu32(code, encode_cmp(14, 1))
  let default_len_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(1, 14, 0))
  cg_patch_b_cond(code, default_len_pos, 9, buf_len(code))
  bu32(code, encode_add_imm(13, 1, 0))
  -- mmap(NULL, len, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, -1, 0)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  bu32(code, encode_movz(0, 0, 0))
  bu32(code, encode_movz(2, 3, 0))
  bu32(code, encode_movz(3, 4098, 0))
  bu32(code, encode_movn(4, 0))
  bu32(code, encode_movz(5, 0, 0))
  -- The grow arm is inlined into arbitrary generated code. Preserve its
  -- caller-saved scratch population across svc: the kernel already proved it
  -- may clobber more than x0, and values such as a just-built continuation
  -- descriptor can remain live in x10/x15 across the next bump reservation.
  -- LDP does not alter NZCV, so the syscall carry test still observes svc.
  bu32(code, encode_stp_pre(9, 10, 31, 0 - 16))
  bu32(code, encode_stp_pre(11, 12, 31, 0 - 16))
  bu32(code, encode_stp_pre(13, 14, 31, 0 - 16))
  bu32(code, encode_stp_pre(15, 16, 31, 0 - 16))
  bu32(code, encode_svc())
  bu32(code, encode_ldp_post(15, 16, 31, 16))
  bu32(code, encode_ldp_post(13, 14, 31, 16))
  bu32(code, encode_ldp_post(11, 12, 31, 16))
  bu32(code, encode_ldp_post(9, 10, 31, 16))
  let ok_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_brk(5))
  cg_patch_b_cond(code, ok_pos, 3, buf_len(code))
  bu32(code, encode_add_imm(17, 0, runtime_state_size()))
  bu32(code, encode_add_reg(next_reg, 17, 12))
  bu32(code, cg_str(17, 28, runtime_state_bump_base_offset()))
  bu32(code, encode_add_reg(status_reg, 0, 13))
  bu32(code, cg_str(status_reg, 28, runtime_state_bump_end_offset()))
  -- A failed fast-path reservation publishes -1 in the bump cell while it
  -- grows. Publish the new cursor last with release ordering; peer workers
  -- spin on the sentinel and cannot observe a cursor paired with stale bounds.
  bu32(code, encode_stlr(next_reg, 28))
  if dst != 17 { bu32(code, encode_add_imm(dst, 17, 0)) } else { 0 }
}

-- Inline bump reservations have a deliberately narrow fast-path clobber
-- contract. Prefer the historical x9/x11 pair; several emission sequences
-- keep independently allocated objects live in x10/x12 between reservations.
pub(package) fn cg_bump_scratch_primary(dst: i64, size_reg: i64) -> i64 {
  if dst != 9 and size_reg != 9 { 9 }
  else { if dst != 11 and size_reg != 11 { 11 }
  else { if dst != 10 and size_reg != 10 { 10 } else { 12 } } }
}

pub(package) fn cg_bump_scratch_secondary(dst: i64, size_reg: i64, first: i64) -> i64 {
  if dst != 11 and size_reg != 11 and first != 11 { 11 }
  else { if dst != 9 and size_reg != 9 and first != 9 { 9 }
  else { if dst != 10 and size_reg != 10 and first != 10 { 10 } else { 12 } } }
}

pub(package) fn cg_bump_large_imm_tmp(dst: i64, next: i64, status: i64) -> i64 {
  if dst != 13 and next != 13 and status != 13 { 13 }
  else { if dst != 14 and next != 14 and status != 14 { 14 }
  else { if dst != 12 and next != 12 and status != 12 { 12 } else { 10 } } }
}

pub(package) fn cg_bump_alloc_reg(code: i64, dst: i64, size_reg: i64) -> i64 {
  let next = cg_bump_scratch_primary(dst, size_reg)
  let status = cg_bump_scratch_secondary(dst, size_reg, next)
  let retry = buf_len(code)
  bu32(code, encode_ldaxr(dst, 28))
  bu32(code, encode_cmp(dst, 31))
  let growing_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_reg(next, dst, size_reg))
  bu32(code, cg_ldr(status, 28, runtime_state_bump_end_offset()))
  bu32(code, encode_cmp(next, status))
  let grow_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_stlxr(status, next, 28))
  bu32(code, encode_cbnz(status, retry - buf_len(code)))
  let done_pos = buf_len(code)
  bu32(code, 0)
  let grow_start = buf_len(code)
  emit_mov_imm_safe(code, next, 0 - 1)
  bu32(code, encode_stlxr(status, next, 28))
  bu32(code, encode_cbnz(status, retry - buf_len(code)))
  cg_bump_emit_grow(code, dst, size_reg, next, status)
  let done = buf_len(code)
  cg_patch_b_cond(code, growing_pos, 11, retry)
  cg_patch_b_cond(code, grow_pos, 8, grow_start)
  cg_patch_b(code, done_pos, done)
}

pub(package) fn cg_bump_alloc_imm(code: i64, dst: i64, size: i64) -> i64 {
  let next = cg_bump_scratch_primary(dst, 0 - 1)
  let status = cg_bump_scratch_secondary(dst, 0 - 1, next)
  let retry = buf_len(code)
  bu32(code, encode_ldaxr(dst, 28))
  bu32(code, encode_cmp(dst, 31))
  let growing_pos = buf_len(code)
  bu32(code, 0)
  -- ADD's imm12 caps at 4095. In the raw encoding, bit 22 of the
  -- immediate term is the LSL-12 flag and bit 23 is unallocated, so an
  -- oversized size used to either silently over-advance the bump
  -- pointer by size*4096 (4096..8191, e.g. a 6KB string literal leaked
  -- 8.5MB per execution) or emit an undefined instruction and SIGILL
  -- (>= 8192). Bigger sizes go through a register; x13/x14 are dead in
  -- the fast path (the grow arm sets them up itself).
  if size > 4095 {
    let size_tmp = cg_bump_large_imm_tmp(dst, next, status)
    emit_mov_imm_safe(code, size_tmp, size)
    bu32(code, encode_add_reg(next, dst, size_tmp))
  } else {
    bu32(code, encode_add_imm(next, dst, size))
  }
  bu32(code, cg_ldr(status, 28, runtime_state_bump_end_offset()))
  bu32(code, encode_cmp(next, status))
  let grow_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_stlxr(status, next, 28))
  bu32(code, encode_cbnz(status, retry - buf_len(code)))
  let done_pos = buf_len(code)
  bu32(code, 0)
  let grow_start = buf_len(code)
  emit_mov_imm_safe(code, next, 0 - 1)
  bu32(code, encode_stlxr(status, next, 28))
  bu32(code, encode_cbnz(status, retry - buf_len(code)))
  emit_mov_imm_safe(code, 12, size)
  cg_bump_emit_grow(code, dst, 12, next, status)
  let done = buf_len(code)
  cg_patch_b_cond(code, growing_pos, 11, retry)
  cg_patch_b_cond(code, grow_pos, 8, grow_start)
  cg_patch_b(code, done_pos, done)
}

pub(package) fn find_main_in_fmap(fm: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let owner_hash = mem_load64_at(d + i * 40 + 32, 0)
    if owner_hash == 0 {
      let e_src = mem_load64_at(d + i * 40 + 24, 0)
      let e_ns = mem_load64_at(d + i * 40, 0)
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      if src_eq(e_src, e_ns, e_nl, "main") == 1 {
        result = mem_load64_at(d + i * 40 + 16, 0)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Emit startup code: save argc/argv, mmap heap, init runtime, pass argc/argv to main.
pub(package) fn emit_heap_init(code: i64, fm: i64) -> i64 {
  -- STP x29, x30, [sp, #-16]! (save link register to return to dyld)
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  -- Save argc (x0) and argv (x1) in callee-saved registers across mmap
  bu32(code, encode_add_imm(25, 0, 0))
  bu32(code, encode_add_imm(26, 1, 0))
  -- mmap syscall: x16 = 0x020000C5 (BSD class | 197)
  bu32(code, encode_movz(16, 197, 0))
  bu32(code, encode_movk(16, 512, 16))
  -- x0 = 0 (addr = NULL)
  bu32(code, encode_movz(0, 0, 0))
  -- x1 = initial bump segment length
  emit_mov_imm_safe(code, 1, runtime_bump_segment_size())
  -- x2 = 3 (PROT_READ | PROT_WRITE)
  bu32(code, encode_movz(2, 3, 0))
  -- x3 = 4098 (MAP_PRIVATE | MAP_ANON)
  bu32(code, encode_movz(3, 4098, 0))
  -- x4 = -1 (fd)
  bu32(code, encode_movn(4, 0))
  -- x5 = 0 (offset)
  bu32(code, encode_movz(5, 0, 0))
  -- SVC #0x80
  bu32(code, encode_svc())
  -- MOV x28, x0 (runtime state base)
  bu32(code, encode_add_imm(28, 0, 0))
  -- Census builds reserve a private metrics tail before the bump arena.
  -- Ordinary mode still emits the historical immediate byte-for-byte.
  let entry_state_size = if fmap_rc_census_mode(fm) == 1 { runtime_state_rc_census_size() } else { runtime_state_size() }
  -- runtime_state.bump = mmap_base + entry_state_size
  bu32(code, encode_add_imm(17, 0, entry_state_size))
  bu32(code, cg_str(17, 28, runtime_state_bump_offset()))
  bu32(code, cg_str(17, 28, runtime_state_bump_base_offset()))
  -- runtime_state.bump_end = mmap_base + initial segment length
  -- x1 is caller-saved across svc; rematerialise the fixed length instead of
  -- depending on a kernel register-preservation accident.
  emit_mov_imm_safe(code, 17, runtime_bump_segment_size())
  bu32(code, encode_add_reg(17, 0, 17))
  bu32(code, cg_str(17, 28, runtime_state_bump_end_offset()))
  -- runtime_state.default_rc_heap = 0 (lazy)
  bu32(code, encode_movz(17, 0, 0))
  bu32(code, cg_str(17, 28, runtime_state_rc_heap_offset()))
  -- runtime_state.fiber/deferred fields = 0
  bu32(code, cg_str(17, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, cg_str(17, 28, runtime_state_fiber_done_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_ops_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prompt_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_effect_hash_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_op_count_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_prev_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_cleanup_desc_offset()))
  bu32(code, cg_str(17, 28, runtime_state_deferred_cleanup_segment_offset()))
  -- The executable emitter patches this ADRP/ADD pair to the embedded,
  -- versioned provenance table. Relocatable objects carry the equivalent
  -- PAGE21/PAGEOFF12 pair against their local provenance symbol.
  let provenance_adrp_pos = buf_len(code)
  bu32(code, encode_adrp(17, 0))
  bu32(code, encode_add_imm(17, 17, 0))
  bu32(code, cg_str(17, 28, runtime_state_native_provenance_offset()))
  -- Default-heap initialization lock; the mapping is already zero-filled,
  -- but keeping startup explicit pins the runtime-state ABI.
  bu32(code, cg_str(31, 28, runtime_state_default_heap_init_lock_offset()))
  -- CLI presentation request: auto until process-entry policy sees the
  -- environment and an optional explicit --color override.
  bu32(code, cg_str(31, 28, runtime_state_diagnostic_color_mode_offset()))
  -- Process-lifetime generation source for runtime readiness pollers.
  bu32(code, cg_str(31, 28, runtime_state_net_poller_epoch_offset()))
  bu32(code, cg_str(31, 28, runtime_state_net_poller_epoch_lock_offset()))
  fmap_set_native_provenance_adrp_pos(fm, provenance_adrp_pos)
  -- MOV x27, #0 (handler stack = empty)
  bu32(code, encode_movz(27, 0, 0))
  -- Restore argc/argv as arguments to main (x0=argc, x1=argv)
  bu32(code, encode_add_imm(0, 25, 0))
  bu32(code, encode_add_imm(1, 26, 0))
  code
}

pub(package) fn bytes_set_u32(code: i64, pos: i64, val: i64) -> i64 {
  let d = buf_ptr(code)
  mem_store8_at(d + pos, 0, val - val / 256 * 256)
  mem_store8_at(d + pos + 1, 0, val / 256 - val / 65536 * 256)
  mem_store8_at(d + pos + 2, 0, val / 65536 - val / 16777216 * 256)
  mem_store8_at(d + pos + 3, 0, val / 16777216 - val / 4294967296 * 256)
  0
}

pub(package) fn patch_forward_refs(fm: i64, code: i64) -> i64 {
  let pn = mem_load64_at(fm + 32, 0)
  let pd = mem_load64_at(fm + 24, 0)
  let mut i = 0
  while i < pn {
    let pos = mem_load64_at(pd + i * 32, 0)
    let ns = mem_load64_at(pd + i * 32 + 8, 0)
    let nl = mem_load64_at(pd + i * 32 + 16, 0)
    let p_src = mem_load64_at(pd + i * 32 + 24, 0)
    let adr_patch = if p_src == 0 and nl == 0 - 1 { 1 } else { 0 }
    let branch_patch = if p_src == 0 and nl == 0 - 2 { 1 } else { 0 }
    let target = if p_src == 0 and nl <= 0 {
      let typed_target = mono_cache_lookup(fmap_mono_cache(fm), ns)
      if typed_target > 1 {
        typed_target
      } else {
        let hash_target = fmap_lookup_by_hash(fm, ns)
        if hash_target != 0 { hash_target } else { typed_target }
      }
    } else {
      let legacy_target = fmap_lookup(fm, p_src, ns, nl)
      if legacy_target != 0 {
        legacy_target
      } else {
        let name_hash = str_hash(p_src, ns, nl)
        let hash_target = fmap_lookup_by_hash(fm, name_hash)
        if hash_target != 0 { hash_target } else { mono_cache_lookup(fmap_mono_cache(fm), name_hash) }
      }
    }
    if target == 0 {
      eprint("error: unresolved forward reference: ")
      if p_src != 0 {
        sys_write(2, p_src + ns, nl)
      } else {
        eprint("h")
        eprint_i(ns)
      }
      eprint("\n")
      fmap_inc_emit_error_count(fm)
      bytes_set_u32(code, pos, encode_brk(3))
    } else {
      if adr_patch == 1 {
        bytes_set_u32(code, pos, encode_adr(17, target - pos))
      } else { if branch_patch == 1 {
        bytes_set_u32(code, pos, encode_b(target - pos))
      } else {
        bytes_set_u32(code, pos, encode_bl(target - pos))
      } }
    }
    i = i + 1
  }
  0
}

-- ======================================================================
-- Scope: linked list of {name_start, name_len, reg, next, type, value_origin}
-- ======================================================================

pub(package) fn scope_new() -> i64 { 0 }
pub(package) fn scope_push_typed_meta(scope: i64, ns: i64, nl: i64, reg: i64, ty: i64, value_origin: i64) -> i64 {
  let e = cg_alloc_bytes(48)
  mem_store64_at(e, 0, ns)
  mem_store64_at(e + 8, 0, nl)
  mem_store64_at(e + 16, 0, reg)
  mem_store64_at(e + 24, 0, scope)
  mem_store64_at(e + 32, 0, ty)
  mem_store64_at(e + 40, 0, value_origin)
  e
}

pub(package) fn scope_push_typed(scope: i64, ns: i64, nl: i64, reg: i64, ty: i64) -> i64 {
  scope_push_typed_meta(scope, ns, nl, reg, ty, 0)
}

pub(package) fn scope_push(scope: i64, ns: i64, nl: i64, reg: i64) -> i64 {
  scope_push_typed(scope, ns, nl, reg, 0)
}

pub(package) fn scope_lookup(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns register number or -1 if not found
  if scope == 0 { 0 - 999 }
  else {
    let s_ns = mem_load64_at(scope, 0)
    let s_nl = mem_load64_at(scope + 8, 0)
    if s_nl == nl {
      -- Compare src[ns..ns+nl] with src[s_ns..s_ns+nl]
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        mem_load64_at(scope + 16, 0)
      } else {
        scope_lookup(mem_load64_at(scope + 24, 0), src, ns, nl)
      }
    } else {
      scope_lookup(mem_load64_at(scope + 24, 0), src, ns, nl)
    }
  }
}

pub(package) fn scope_lookup_type(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if scope == 0 { 0 }
  else {
    let s_ns = mem_load64_at(scope, 0)
    let s_nl = mem_load64_at(scope + 8, 0)
    if s_nl == nl {
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        mem_load64_at(scope + 32, 0)
      } else {
        scope_lookup_type(mem_load64_at(scope + 24, 0), src, ns, nl)
      }
    } else {
      scope_lookup_type(mem_load64_at(scope + 24, 0), src, ns, nl)
    }
  }
}

-- Find variant info by name. Returns tag_hash or -1 if not found.
-- Uses the entry's stored src for cross-file name comparison.
pub(package) fn ttable_find_variant(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let v = ttable_variant_scan(tt, src, ns, nl, 0, 2, 0)
  if v == 0 { 0 - 1 } else { mem_load64_at(v + 16, 0) }
}

pub(package) fn cg_layout_unknown() -> i64 { 0 - 1 }
pub(package) fn cg_layout_word_size() -> i64 { 8 }
pub(package) fn cg_layout_handle_size() -> i64 { 8 }
pub(package) fn cg_layout_rc_header_size() -> i64 { 48 }

pub(package) fn cg_layout_align_up(value: i64, align: i64) -> i64 {
  if value < 0 { cg_layout_unknown() }
  else { if align <= 0 { cg_layout_unknown() }
  else { if align == 1 { value }
  else {
    let rem = value - value / align * align
    let padding = if rem == 0 { 0 } else { align - rem }
    if padding > 9223372036854775807 - value { cg_layout_unknown() } else { value + padding }
  } } }
}

pub(package) fn cg_layout_max(a: i64, b: i64) -> i64 {
  if a > b { a } else { b }
}

pub(package) fn cg_layout_checked_mul_nonnegative(a: i64, b: i64) -> i64 {
  if a < 0 or b < 0 { cg_layout_unknown() }
  else { if a == 0 or b == 0 { 0 }
  else { if a > 9223372036854775807 / b { cg_layout_unknown() } else { a * b } } }
}

-- Fixed arrays are semantic values. Their elements use the shared indexed-
-- storage layout also consumed by Vector and slices; eligible plain records
-- are therefore inline everywhere a two-word slice can point. The array itself
-- always occupies its complete fixed payload when stored or embedded.
pub(package) fn cg_layout_array_element_size(tt: i64, ty: i64) -> i64 {
  if ty_is_array(ty) { cg_layout_indexed_element_size(tt, ty_array_inner(ty)) } else { cg_layout_unknown() }
}

pub(package) fn cg_layout_array_element_align(tt: i64, ty: i64) -> i64 {
  if ty_is_array(ty) { cg_layout_indexed_element_align(tt, ty_array_inner(ty)) } else { cg_layout_unknown() }
}

pub(package) fn cg_layout_array_stride(tt: i64, ty: i64) -> i64 {
  if not ty_is_array(ty) { cg_layout_unknown() }
  else {
    let size = cg_layout_array_element_size(tt, ty)
    let align = cg_layout_array_element_align(tt, ty)
    if size < 0 or align <= 0 { cg_layout_unknown() } else { cg_layout_align_up(size, align) }
  }
}

pub(package) fn cg_layout_array_size(tt: i64, ty: i64) -> i64 {
  if not ty_is_array(ty) { cg_layout_unknown() }
  else {
    let length = ty_array_length(ty)
    if length < 0 { cg_layout_unknown() }
    else { if length == 0 { 0 }
    else {
      let stride = cg_layout_array_stride(tt, ty)
      if stride < 0 { cg_layout_unknown() } else { cg_layout_checked_mul_nonnegative(length, stride) }
    } }
  }
}

pub(package) fn cg_layout_array_align(tt: i64, ty: i64) -> i64 {
  if not ty_is_array(ty) { cg_layout_unknown() }
  else { if ty_array_length(ty) == 0 { 1 } else { cg_layout_array_element_align(tt, ty) } }
}

-- Nested fixed arrays are homogeneous and padding-free between their leaf
-- storage slots, so destruction can use one flattened counted-loop plan.
-- A negative constituent means the plan is not yet representable (generic or
-- custom Drop leaves); zero-length arrays remain provably cleanup-free.
pub(package) fn cg_layout_array_leaf_type(ty: i64) -> i64 {
  if not ty_is_array(ty) { 0 }
  else {
    let inner = ty_array_inner(ty)
    if ty_is_array(inner) { cg_layout_array_leaf_type(inner) } else { inner }
  }
}

pub(package) fn cg_layout_array_leaf_count(ty: i64) -> i64 {
  if not ty_is_array(ty) { cg_layout_unknown() }
  else {
    let length = ty_array_length(ty)
    if length < 0 { cg_layout_unknown() }
    else { if length == 0 { 0 }
    else {
      let inner = ty_array_inner(ty)
      if not ty_is_array(inner) { length }
      else {
        let inner_count = cg_layout_array_leaf_count(inner)
        if inner_count < 0 { cg_layout_unknown() }
        else { cg_layout_checked_mul_nonnegative(length, inner_count) }
      }
    } }
  }
}

pub(package) fn cg_layout_array_leaf_stride(tt: i64, ty: i64) -> i64 {
  let leaf = cg_layout_array_leaf_type(ty)
  if leaf == 0 { cg_layout_unknown() }
  else {
    let size = cg_layout_indexed_element_size(tt, leaf)
    let align = cg_layout_indexed_element_align(tt, leaf)
    if size < 0 or align <= 0 { cg_layout_unknown() } else { cg_layout_align_up(size, align) }
  }
}

pub(package) fn cg_layout_array_leaf_drop_kind(tt: i64, ty: i64) -> i64 {
  let leaf = cg_layout_array_leaf_type(ty)
  if leaf == 0 or cg_layout_array_leaf_stride(tt, ty) < 0 { cg_layout_unknown() }
  else {
    let tag = ty_tag(leaf)
    let kind = cg_managed_drop_kind_for_ty(leaf)
    if cg_layout_vector_record_inline_eligible(tt, leaf) == 1 { continuation_cleanup_kind_none() }
    else { if tag == 18 or tag == 19 { cg_layout_unknown() }
    else { if kind == continuation_cleanup_kind_none() and ty_field_may_require_release_mask(leaf) == 1 {
      cg_layout_unknown()
    } else { kind } } }
  }
}

pub(package) fn cg_layout_array_needs_drop_glue(tt: i64, ty: i64) -> i64 {
  let count = cg_layout_array_leaf_count(ty)
  if count < 0 { cg_layout_unknown() }
  else { if count == 0 { 0 }
  else {
    let kind = cg_layout_array_leaf_drop_kind(tt, ty)
    if kind < 0 { cg_layout_unknown() }
    else { if kind == continuation_cleanup_kind_none() { 0 } else { 1 } }
  } }
}

pub(package) fn cg_layout_prim_size(prim: i64) -> i64 {
  match prim {
    2 -> 1
    3 -> 0
    5 -> 4
    6 -> 1
    7 -> 2
    8 -> 1
    9 -> 2
    10 -> 4
    14 -> 4
    _ -> 8
  }
}

pub(package) fn cg_layout_prim_align(prim: i64) -> i64 {
  let size = cg_layout_prim_size(prim)
  if size <= 0 { 1 } else { size }
}

pub(package) fn cg_layout_ttable_lookup_kind_by_hash(tt: i64, type_hash: i64, kind: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let n = mem_load64_at(tt + 8, 0)
    let d = mem_load64_at(tt, 0)
    let mut i = 0
    let mut result = 0
    while i < n {
      let entry = d + i * 64
      if mem_load64_at(entry + 16, 0) == kind {
        let entry_src = mem_load64_at(entry + 48, 0)
        let type_ns = mem_load64_at(entry, 0)
        let type_nl = mem_load64_at(entry + 8, 0)
        if mem_load64_at(entry, 56) == type_hash {
          result = entry
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    }
    result
  }
}

pub(package) fn cg_layout_record_entry(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 9 { 0 }
  else { if ty_is_rc(ty) == 1 or ty_named_is_opaque(ty) { 0 }
  else { cg_layout_ttable_lookup_kind_by_hash(tt, ty_f1(ty), 0) } } }
}

pub(package) fn cg_layout_variant_entry(tt: i64, ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_tag(ty) != 9 { 0 }
  else { if ty_is_rc(ty) == 1 or ty_named_is_opaque(ty) { 0 }
  else { cg_layout_ttable_lookup_kind_by_hash(tt, ty_f1(ty), 1) } } }
}

pub(package) fn cg_layout_subst_for_entry_ty(entry: i64, ty: i64) -> i64 {
  let tparams = if entry == 0 { 0 } else { mem_load64_at(entry + 40, 0) }
  let type_args = if ty == 0 { 0 } else { ty_f3(ty) }
  cg_build_subst(tparams, type_args)
}

pub(package) fn cg_layout_field_type_at(entry: i64, ty: i64, index: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
    if index < 0 or index >= nfields { 0 }
    else {
      let fields = mem_load64_at(entry + 32, 0)
      let raw_ty = mem_load64_at(fields + index * 24 + 16, 0)
      ty_subst(raw_ty, cg_layout_subst_for_entry_ty(entry, ty))
    }
  }
}

pub(package) fn cg_layout_structural_record_inline_size(tt: i64, ty: i64) -> i64 {
  if not ty_is_record(ty) or ty_record_open(ty) == 1 { cg_layout_unknown() }
  else {
    let fields = ty_record_fields(ty)
    let mut offset = 0
    let mut max_align = 1
    let mut ok = 1
    if fields != 0 {
      for i in 0..nlist_len(fields) {
        let field_ty = ty_record_field_type(ty_record_field_at_layout_index(ty, i))
        let align = cg_layout_inline_align(tt, field_ty)
        let size = cg_layout_inline_size(tt, field_ty)
        if align < 0 or size < 0 { ok = 0 }
        else {
          offset = cg_layout_align_up(offset, align)
          offset = offset + size
          max_align = cg_layout_max(max_align, align)
        }
      }
    } else { 0 }
    if ok == 0 { cg_layout_unknown() } else { cg_layout_align_up(offset, max_align) }
  }
}

pub(package) fn cg_layout_structural_record_inline_align(tt: i64, ty: i64) -> i64 {
  if not ty_is_record(ty) or ty_record_open(ty) == 1 { cg_layout_unknown() }
  else {
    let fields = ty_record_fields(ty)
    let mut max_align = 1
    let mut ok = 1
    if fields != 0 {
      for i in 0..nlist_len(fields) {
        let align = cg_layout_inline_align(tt, ty_record_field_type(ty_record_field_at_layout_index(ty, i)))
        if align < 0 { ok = 0 } else { max_align = cg_layout_max(max_align, align) }
      }
    } else { 0 }
    if ok == 0 { cg_layout_unknown() } else { max_align }
  }
}

pub(package) fn cg_layout_structural_record_field_offset(tt: i64, ty: i64, name_hash: i64) -> i64 {
  if not ty_is_record(ty) or ty_record_open(ty) == 1 { cg_layout_unknown() }
  else {
    let fields = ty_record_fields(ty)
    let mut offset = 0
    let mut result = cg_layout_unknown()
    let mut i = 0
    while fields != 0 and i < nlist_len(fields) and result < 0 {
      let field = ty_record_field_at_layout_index(ty, i)
      let field_ty = ty_record_field_type(field)
      let align = cg_layout_inline_align(tt, field_ty)
      let size = cg_layout_inline_size(tt, field_ty)
      if align < 0 or size < 0 { i = nlist_len(fields) }
      else {
        offset = cg_layout_align_up(offset, align)
        if ty_record_field_hash(field) == name_hash { result = offset }
        else { offset = offset + size i = i + 1 }
      }
    }
    result
  }
}

pub(package) fn cg_layout_payload_list_size(tt: i64, payloads: i64) -> i64 {
  if payloads == 0 { 0 }
  else {
    let mut offset = 0
    let mut max_align = 1
    let mut ok = 1
    let n = nlist_len(payloads)
    for i in 0..n {
      let pty = nlist_get(payloads, i)
      let align = cg_layout_inline_align(tt, pty)
      let size = cg_layout_inline_size(tt, pty)
      if align < 0 or size < 0 {
        ok = 0
      } else {
        offset = cg_layout_align_up(offset, align)
        offset = offset + size
        max_align = cg_layout_max(max_align, align)
      }
    }
    if ok == 0 { cg_layout_unknown() } else { cg_layout_align_up(offset, max_align) }
  }
}

pub(package) fn cg_layout_payload_list_align(tt: i64, payloads: i64) -> i64 {
  if payloads == 0 { 1 }
  else {
    let mut max_align = 1
    let mut ok = 1
    let n = nlist_len(payloads)
    for i in 0..n {
      let align = cg_layout_inline_align(tt, nlist_get(payloads, i))
      if align < 0 { ok = 0 } else { max_align = cg_layout_max(max_align, align) }
    }
    if ok == 0 { cg_layout_unknown() } else { max_align }
  }
}

pub(package) fn cg_layout_record_inline_size(tt: i64, ty: i64) -> i64 {
  let entry = cg_layout_record_entry(tt, ty)
  if entry == 0 { cg_layout_unknown() }
  else {
    let nfields = mem_load64_at(entry + 24, 0)
