fn fmap_set_match_eliminated_hashes(fm: i64, hashes: i64) -> i64 { __mem_store64(fm + 624, hashes) 0 }
fn fmap_inc_semantic_residual_reason(fm: i64, reason: i64) -> i64 {
  fmap_inc_semantic_residual_count(fm)
  match reason {
    1 -> fmap_inc_semantic_residual_callback_count(fm)
    2 -> fmap_inc_semantic_residual_recursive_count(fm)
    3 -> fmap_inc_semantic_residual_unsupported_count(fm)
    4 -> fmap_inc_semantic_residual_missing_evidence_count(fm)
    5 -> fmap_inc_semantic_residual_no_ops_count(fm)
    6 -> fmap_inc_semantic_residual_arity_count(fm)
    7 -> fmap_inc_semantic_residual_mixed_evidence_count(fm)
    _ -> fmap_inc_semantic_residual_unsupported_count(fm)
  }
}
fn fmap_add_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64, off: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let cap = __mem_load64(fm + 16)
  if n >= cap {
    -- Grow: allocate 2x, copy
    let d = __mem_load64(fm)
    let new_cap = cap * 2
    let new_d = alloc_bump(new_cap * 40)
    mem_copy(new_d, d, n * 40)
    __mem_store64(fm, new_d)
    __mem_store64(fm + 16, new_cap)
    0
  } else { 0 }
  let d = __mem_load64(fm)
  __mem_store64(d + n * 40, ns)
  __mem_store64(d + n * 40 + 8, nl)
  __mem_store64(d + n * 40 + 16, off)
  __mem_store64(d + n * 40 + 24, src)
  __mem_store64(d + n * 40 + 32, owner_hash)
  __mem_store64(fm + 8, n + 1)
  fm
}
fn fmap_add(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  fmap_add_qualified(fm, src, ns, nl, 0, off)
}
fn fmap_lookup_qualified(fm: i64, src: i64, ns: i64, nl: i64, owner_hash: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_owner = __mem_load64(d + i * 40 + 32)
    if e_owner == owner_hash {
      let e_nl = __mem_load64(d + i * 40 + 8)
      if e_nl == nl {
        let e_src = __mem_load64(d + i * 40 + 24)
        if src_eq_at(src, ns, e_src + __mem_load64(d + i * 40), 0, nl) == 1 {
          result = __mem_load64(d + i * 40 + 16)
          i = n
        } else { i = i + 1 }
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
fn fmap_lookup(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  fmap_lookup_qualified(fm, src, ns, nl, 0)
}

fn cg_handler_inline_ctx_size() -> i64 { 48 }
fn cg_handler_inline_ctx_eff_offset() -> i64 { 0 }
fn cg_handler_inline_ctx_clauses_offset() -> i64 { 8 }
fn cg_handler_inline_ctx_infos_offset() -> i64 { 16 }
fn cg_handler_inline_ctx_nclauses_offset() -> i64 { 24 }
fn cg_handler_inline_ctx_ops_ctr_offset() -> i64 { 32 }
fn cg_handler_inline_ctx_prev_offset() -> i64 { 40 }

fn cg_handler_inline_match_size() -> i64 { 32 }
fn cg_handler_inline_match_info_offset() -> i64 { 0 }
fn cg_handler_inline_match_index_offset() -> i64 { 8 }
fn cg_handler_inline_match_ops_ctr_offset() -> i64 { 16 }
fn cg_handler_inline_match_nfree_offset() -> i64 { 24 }

fn fmap_handler_inline_top(fm: i64) -> i64 { __mem_load64(fm + 96) }
fn fmap_set_handler_inline_top(fm: i64, top: i64) -> i64 { __mem_store64(fm + 96, top) 0 }

fn cg_handler_inline_push(fm: i64, eff_hash: i64, clauses: i64, clause_infos: i64, nclauses: i64, ops_ctr: i64) -> i64 {
  let ctx = alloc_bump(cg_handler_inline_ctx_size())
  __mem_store64(ctx + cg_handler_inline_ctx_eff_offset(), eff_hash)
  __mem_store64(ctx + cg_handler_inline_ctx_clauses_offset(), clauses)
  __mem_store64(ctx + cg_handler_inline_ctx_infos_offset(), clause_infos)
  __mem_store64(ctx + cg_handler_inline_ctx_nclauses_offset(), nclauses)
  __mem_store64(ctx + cg_handler_inline_ctx_ops_ctr_offset(), ops_ctr)
  __mem_store64(ctx + cg_handler_inline_ctx_prev_offset(), fmap_handler_inline_top(fm))
  fmap_set_handler_inline_top(fm, ctx)
  ctx
}

fn cg_handler_inline_pop(fm: i64) -> i64 {
  let ctx = fmap_handler_inline_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_handler_inline_top(fm, __mem_load64(ctx + cg_handler_inline_ctx_prev_offset()))
    0
  }
}

fn cg_handler_inline_clause_op_hash(clause: i64, src: i64) -> i64 {
  let clause_names = node_f1(clause)
  str_hash(src, node_f3(clause_names), node_f4(clause_names))
}

fn cg_handler_inline_make_match(info: i64, index: i64, ops_ctr: i64) -> i64 {
  let result = alloc_bump(cg_handler_inline_match_size())
  __mem_store64(result + cg_handler_inline_match_info_offset(), info)
  __mem_store64(result + cg_handler_inline_match_index_offset(), index)
  __mem_store64(result + cg_handler_inline_match_ops_ctr_offset(), ops_ctr)
  __mem_store64(result + cg_handler_inline_match_nfree_offset(), __mem_load64(info + 16))
  result
}

fn cg_handler_inline_find_clause(ctx: i64, src: i64, op_hash: i64) -> i64 {
  let clauses = __mem_load64(ctx + cg_handler_inline_ctx_clauses_offset())
  let infos = __mem_load64(ctx + cg_handler_inline_ctx_infos_offset())
  let nclauses = __mem_load64(ctx + cg_handler_inline_ctx_nclauses_offset())
  let ops_ctr = __mem_load64(ctx + cg_handler_inline_ctx_ops_ctr_offset())
  let mut i = 0
  let mut result = 0
  while i < nclauses {
    let clause = nlist_get(clauses, i)
    if cg_handler_inline_clause_op_hash(clause, src) == op_hash {
      result = cg_handler_inline_make_match(__mem_load64(infos + i * 8), i, ops_ctr)
      i = nclauses
    } else { i = i + 1 }
  }
  result
}

fn cg_handler_inline_find(fm: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut ctx = fmap_handler_inline_top(fm)
  let mut result = 0
  while ctx != 0 {
    if __mem_load64(ctx + cg_handler_inline_ctx_eff_offset()) == eff_hash {
      let found = cg_handler_inline_find_clause(ctx, src, op_hash)
      if found == 0 {
        ctx = __mem_load64(ctx + cg_handler_inline_ctx_prev_offset())
      } else {
        result = found
        ctx = 0
      }
    } else {
      ctx = __mem_load64(ctx + cg_handler_inline_ctx_prev_offset())
    }
  }
  result
}

fn cg_scoped_alloc_ctx_arena_ctr_offset() -> i64 { 0 }
fn cg_scoped_alloc_ctx_prev_offset() -> i64 { 8 }

fn cg_scoped_alloc_push(fm: i64, arena_ctr: i64) -> i64 {
  let ctx = alloc_bump(16)
  __mem_store64(ctx + cg_scoped_alloc_ctx_arena_ctr_offset(), arena_ctr)
  __mem_store64(ctx + cg_scoped_alloc_ctx_prev_offset(), fmap_scoped_alloc_top(fm))
  fmap_set_scoped_alloc_top(fm, ctx)
  ctx
}

fn cg_scoped_alloc_pop(fm: i64) -> i64 {
  let ctx = fmap_scoped_alloc_top(fm)
  if ctx == 0 { 0 }
  else {
    fmap_set_scoped_alloc_top(fm, __mem_load64(ctx + cg_scoped_alloc_ctx_prev_offset()))
    0
  }
}

fn cg_scoped_alloc_arena_ctr(fm: i64) -> i64 {
  let ctx = fmap_scoped_alloc_top(fm)
  if ctx == 0 { 0 - 1 }
  else { __mem_load64(ctx + cg_scoped_alloc_ctx_arena_ctr_offset()) }
}

