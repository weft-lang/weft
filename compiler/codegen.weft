-- Prologue-pair census (2v Stage 2 pre-measurement): which saved
-- callee-saved pairs does the emitted body actually write? Tail-dead
-- pairs fall to a prefix-count shrink; interior-dead need remapping.
fn fmap_pair_census_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2560 + which * 8, 0) }
fn fmap_add_pair_census_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2560 + which * 8, 0, mem_load64_at(fm + 2560 + which * 8, 0) + count) 0 }
-- Naked-leaf census (2v Stage 2): 0 realized fns, 1 their shed pairs
-- (bank + fp/lr), 2 fns blocked by block params (shuffle-temp
-- conservatism), 3 fns blocked by entry-param cleanup (release BLs
-- need x30 saved), 5/6/7 pool-extended sizing (fns / pairs / spilled
-- defs). Counter index 4 is FORBIDDEN: 2720 holds the per-function
-- naked flag (entry/bail/exit cleared like the split map — the
-- prologue and epilogue emit nothing under it), and a counter add
-- there would arm naked emission on a non-qualifying function.
fn fmap_naked_leaf_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2688 + which * 8, 0) }
fn fmap_add_naked_leaf_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2688 + which * 8, 0, mem_load64_at(fm + 2688 + which * 8, 0) + count) 0 }
fn fmap_current_naked_leaf(fm: i64) -> i64 { mem_load64_at(fm + 2720, 0) }
fn fmap_set_current_naked_leaf(fm: i64, flag: i64) -> i64 { mem_store64_at(fm + 2720, 0, flag) 0 }
-- Soft-barrier census (2v Stage 2 C0): barrier events in the residents
-- walk classified by pipeline_ir_native_intrinsic_clobber_mask —
-- 0 soft events (inline scratch-limited intrinsic calls; a mask-aware
-- segment model would not break pool tenancy there), 1 true events
-- (real calls / fiber / syscall / bump-grow / non-intrinsic barriers),
-- 2 fns whose every barrier is soft (the coloring candidates). Base
-- 2752 sits past the 2720 naked flag; slots 2792-2808 spare.
fn fmap_soft_barrier_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2752 + which * 8, 0) }
fn fmap_add_soft_barrier_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2752 + which * 8, 0, mem_load64_at(fm + 2752 + which * 8, 0) + count) 0 }
-- Fn-param pool residency (2v Stage 2 S0): 0 whole-window seats
-- (barrier-free rounded window — the param never claims its bank
-- home), 1 call-final seats (last use is a pinned-aware call; the
-- seat dies at the BL). Base 2776.
fn fmap_fn_param_resident_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2776 + which * 8, 0) }
fn fmap_add_fn_param_resident_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2776 + which * 8, 0, mem_load64_at(fm + 2776 + which * 8, 0) + count) 0 }
-- Cross-block pool residency (2v Stage 2 C3): 0 whole-window seats
-- (rounded barrier-free cross-block windows in caller-saved seats),
-- 1 call-final seats (cross-block window ending at the final call).
-- Base 2792; 2808 stays the last spare slot.
fn fmap_crossblock_pool_counter(fm: i64, which: i64) -> i64 { mem_load64_at(fm + 2792 + which * 8, 0) }
fn fmap_add_crossblock_pool_counter(fm: i64, which: i64, count: i64) -> i64 { mem_store64_at(fm + 2792 + which * 8, 0, mem_load64_at(fm + 2792 + which * 8, 0) + count) 0 }
