  else { if nlist_len(ty_f1(eff)) == 0 { if ty_f2(eff) == 0 { 1 } else { 0 } } else { 0 } } }
}

fn cg_fn_type_is_pure_i64_to_i64(fn_ty: i64) -> i64 {
  if fn_ty == 0 { 0 }
  else { if ty_tag(fn_ty) != 6 { 0 }
  else {
    let params = ty_f1(fn_ty)
    if nlist_len(params) != 1 { 0 }
    else { if ty_eq(nlist_get(params, 0), ty_i64()) != 1 { 0 }
    else { if ty_eq(ty_f2(fn_ty), ty_i64()) != 1 { 0 }
    else { cg_effect_sig_is_pure(ty_f3(fn_ty)) } } }
  } }
}

fn cg_par_map_callback_pure_i64(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    if tag == 29 { 1 }
    else { if tag != 2 { 0 }
    else {
      let local_ty = scope_lookup_type(scope, src, node_f1(node), node_f2(node))
      if local_ty != 0 {
        cg_fn_type_is_pure_i64_to_i64(local_ty)
      } else {
        cg_fn_type_is_pure_i64_to_i64(cg_ftypes_lookup_fn_type(fmap_get_cg_ftypes(fm), src, node_f1(node), node_f2(node)))
      }
    } }
  }
}

fn cg_par_expr_list_safe_depth(args: i64, nargs: i64, src: i64, loop_depth: i64) -> i64 {
  let mut safe = 1
  let mut i = 0
  while i < nargs {
    if cg_par_body_safe_depth(nlist_get(args, i), src, loop_depth) == 0 {
      safe = 0
      i = nargs
    } else { i = i + 1 }
  }
  safe
}

