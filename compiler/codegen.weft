}

fn cg_emit_fiber_fn_spec(code: i64, fm: i64, entry: i64) -> i64 {
  let name_hash = node_f1(entry)
  let fn_wrap = node_f2(entry)
  let fn_src = node_f3(entry)
  let owner_hash = node_f4(entry)
  let eff_hash = cg_fiber_lowering_eff_hash(fm)
  let op_hash = cg_fiber_lowering_op_hash(fm)
  let cache = fmap_fiber_cache(fm)
  let cached = fiber_cache_lookup(cache, name_hash, owner_hash, eff_hash, op_hash)
  if cached != 0 { cached }
  else {
    if cg_fiber_entry_supports_active(entry, fm) != 1 { 0 }
    else {
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      let nparams = nlist_len(params)
      let b_over_pos = buf_len(code)
      bu32(code, 0)
      let fn_off = buf_len(code)
      fiber_cache_add(cache, name_hash, owner_hash, eff_hash, op_hash, fn_off)
      emit_prologue(code)
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_par_lowering_top = fmap_par_lowering_top(fm)
      fmap_set_current_ret_ty(fm, ret_ty)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      fmap_set_par_lowering_top(fm, 0)
      let fn_scope = cg_fn_params(params, nparams, fn_src, scope_new(), code, fm)
      let body_ctr = cg_expr(body, code, fn_scope, fn_src, nparams, fm)
      let save_ctr = body_ctr
      cg_match_store_result(code, save_ctr, body_ctr)
      if cg_ty_is_managed(ret_ty) == 1 {
        if cg_expr_is_borrow_for_ty(ret_ty, body, fn_scope, fn_src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      cg_emit_cleanups_to_depth(code, fn_src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue(code)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      fmap_set_par_lowering_top(fm, old_par_lowering_top)
      cg_patch_b(code, b_over_pos, buf_len(code))
      fn_off
    }
  }
}

fn cg_call_fiber_direct(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, entry: i64) -> i64 {
  let fn_wrap = node_f2(entry)
  let fn_node = unwrap_fn(fn_wrap)
  let params = node_f3(fn_node)
  let fn_off = cg_emit_fiber_fn_spec(code, fm, entry)
  if fn_off == 0 {
    cg_call_args_typed(node_f3(node), node_f4(node), code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
    cg_call_emit(code, src, node_f1(node), node_f2(node), fm, ctr)
  } else {
    let c = cg_call_args_typed(node_f3(node), node_f4(node), code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
    let cur = buf_len(code)
    bu32(code, encode_bl(fn_off - cur))
    if c < 8 {
      bu32(code, encode_add_imm(c + 19, 0, 0))
    } else {
      emit_store_reg(code, c, 0)
    }
    c + 1
  }
}

fn cg_emit_borrowed_fn_spec(code: i64, fm: i64, entry: i64, borrowed_mask: i64) -> i64 {
  let name_hash = node_f1(entry)
  let fn_wrap = node_f2(entry)
  let fn_src = node_f3(entry)
  let owner_hash = node_f4(entry)
  let cache = fmap_borrow_cache(fm)
  let cached = borrow_cache_lookup(cache, name_hash, owner_hash, borrowed_mask)
  if cached != 0 { cached }
  else {
    let eligible_mask = cg_fn_borrowable_param_mask(fn_wrap, fn_src)
    if borrowed_mask == 0 or cg_mask_subset(borrowed_mask, eligible_mask) != 1 { 0 }
    else {
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      let nparams = nlist_len(params)
      let b_over_pos = buf_len(code)
      bu32(code, 0)
      let fn_off = buf_len(code)
      borrow_cache_add(cache, name_hash, owner_hash, borrowed_mask, fn_off)
      emit_prologue(code)
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      fmap_set_current_ret_ty(fm, ret_ty)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      let fn_scope = cg_fn_params_with_borrow_mask(params, nparams, fn_src, scope_new(), code, fm, borrowed_mask)
      let body_ctr = cg_expr(body, code, fn_scope, fn_src, nparams, fm)
      let save_ctr = body_ctr
      cg_match_store_result(code, save_ctr, body_ctr)
      if cg_ty_is_managed(ret_ty) == 1 {
        if cg_expr_is_borrow_for_ty(ret_ty, body, fn_scope, fn_src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      cg_emit_cleanups_to_depth(code, fn_src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue(code)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      cg_patch_b(code, b_over_pos, buf_len(code))
      fn_off
    }
  }
}

fn cg_call_borrowed_direct(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, entry: i64, borrowed_mask: i64) -> i64 {
  let fn_wrap = node_f2(entry)
  let fn_node = unwrap_fn(fn_wrap)
  let params = node_f3(fn_node)
  let fn_off = cg_emit_borrowed_fn_spec(code, fm, entry, borrowed_mask)
  if fn_off == 0 {
    let args = node_f3(node)
    let nargs = node_f4(node)
    let ns = node_f1(node)
    let nl = node_f2(node)
    cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, 0))
    cg_call_emit(code, src, ns, nl, fm, ctr)
  } else {
    let args = node_f3(node)
    let nargs = node_f4(node)
    let c = cg_call_args_typed(args, nargs, code, scope, src, ctr, fm, node_new(0, 0, params, 0, borrowed_mask))
    let cur = buf_len(code)
    bu32(code, encode_bl(fn_off - cur))
    if c < 8 {
      bu32(code, encode_add_imm(c + 19, 0, 0))
    } else {
      emit_store_reg(code, c, 0)
    }
    c + 1
  }
}

fn cg_call_is_scoped_arena_helper(node: i64, scope: i64, src: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "with_scoped_arena_alloc") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 2 { 0 }
  else {
    let args = node_f3(node)
    let lambda = nlist_get(args, 1)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else {
      let body = node_f2(lambda)
      if cg_scoped_alloc_body_has_direct(body, src) != 1 { 0 }
      else { cg_scoped_alloc_body_safe(body, src) }
    } }
  } } }
}

fn cg_call_scoped_arena_helper(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f3(node)
  let arena_expr = nlist_get(args, 0)
  let lambda = nlist_get(args, 1)
  let body = node_f2(lambda)
  let c_arena = cg_expr(arena_expr, code, scope, src, ctr, fm)
  let arena_ctr = c_arena - 1
  let arena_phys = emit_load_reg(code, arena_ctr)
  bu32(code, encode_add_imm(0, arena_phys, 0))
  cg_emit_call_lit(code, fm, "arena_mark")
  let mark_ctr = c_arena
  if mark_ctr < 8 {
    bu32(code, encode_add_imm(mark_ctr + 19, 0, 0))
  } else { emit_store_reg(code, mark_ctr, 0) }
  cg_scoped_alloc_push(fm, arena_ctr)
  let br = cg_expr(body, code, scope, src, mark_ctr + 1, fm)
  cg_scoped_alloc_pop(fm)
  let save_ctr = br
  cg_match_store_result(code, save_ctr, br)
  let arena_phys2 = emit_load_reg(code, arena_ctr)
  bu32(code, encode_add_imm(0, arena_phys2, 0))
  let mark_phys = emit_load_rhs(code, mark_ctr)
  bu32(code, encode_add_imm(1, mark_phys, 0))
  cg_emit_call_lit(code, fm, "arena_restore")
  cg_match_store_result(code, ctr, save_ctr + 1)
  fmap_inc_alloc_elision_count(fm)
  ctr + 1
}

fn cg_call_is_par_sequential_helper(node: i64, scope: i64, src: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "par_with_sequential_i64") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else {
    let args = node_f3(node)
    let lambda = nlist_get(args, 0)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else {
      let body = node_f2(lambda)
      if cg_par_body_has_direct(body, src) != 1 { 0 }
      else { cg_par_body_safe(body, src) }
    } }
  } } }
}

fn cg_call_is_par_pthread_pool_helper(node: i64, scope: i64, src: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "par_with_pthread_pool_i64") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 3 { 0 }
  else {
    let args = node_f3(node)
    let lambda = nlist_get(args, 2)
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else {
      let body = node_f2(lambda)
      if cg_par_body_has_direct(body, src) != 1 { 0 }
      else { cg_par_body_safe(body, src) }
    } }
  } } }
}

fn cg_call_par_sequential_helper(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f3(node)
  let lambda = nlist_get(args, 0)
  cg_par_lowering_push(fm, 1, 0 - 1)
  let br = cg_expr(node_f2(lambda), code, scope, src, ctr, fm)
  cg_par_lowering_pop(fm)
  cg_match_store_result(code, ctr, br)
  fmap_inc_par_lowering_count(fm)
  ctr + 1
}

fn cg_call_par_pthread_pool_helper(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f3(node)
  let workers_expr = nlist_get(args, 0)
  let capacity_expr = nlist_get(args, 1)
  let lambda = nlist_get(args, 2)
  let c_workers = cg_expr(workers_expr, code, scope, src, ctr, fm)
  let c_capacity = cg_expr(capacity_expr, code, scope, src, c_workers, fm)
  let workers_phys = emit_load_reg(code, c_workers - 1)
  bu32(code, encode_add_imm(0, workers_phys, 0))
  let capacity_phys = emit_load_reg(code, c_capacity - 1)
  bu32(code, encode_add_imm(1, capacity_phys, 0))
  cg_emit_call_lit(code, fm, "par_pthread_pool_start")
  let pool_ctr = c_capacity
  if pool_ctr < 8 {
    bu32(code, encode_add_imm(pool_ctr + 19, 0, 0))
  } else { emit_store_reg(code, pool_ctr, 0) }
  let pool_phys = emit_load_reg(code, pool_ctr)
  bu32(code, encode_cmp(pool_phys, 31))
  let bne_pos = buf_len(code)
  bu32(code, 0)
  cg_par_lowering_push(fm, 1, 0 - 1)
  let br_seq = cg_expr(node_f2(lambda), code, scope, src, pool_ctr + 1, fm)
  cg_par_lowering_pop(fm)
  cg_match_store_result(code, ctr, br_seq)
  let b_end_pos = buf_len(code)
  bu32(code, 0)
  let pool_start = buf_len(code)
  cg_patch_b_cond(code, bne_pos, 1, pool_start)
  cg_par_lowering_push(fm, 2, pool_ctr)
  let br_pool = cg_expr(node_f2(lambda), code, scope, src, pool_ctr + 1, fm)
  cg_par_lowering_pop(fm)
  cg_match_store_result(code, ctr, br_pool)
  let pool_phys2 = emit_load_reg(code, pool_ctr)
  bu32(code, encode_add_imm(0, pool_phys2, 0))
  cg_emit_call_lit(code, fm, "par_pthread_pool_shutdown")
  let after = buf_len(code)
  cg_patch_b(code, b_end_pos, after)
  fmap_inc_par_lowering_count(fm)
  ctr + 1
}

fn cg_generator_i64_function_entry_for_arg(arg: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node_tag(arg) != 2 { 0 }
  else { if scope_lookup(scope, src, node_f1(arg), node_f2(arg)) != 0 - 999 { 0 }
  else {
    let name_hash = str_hash(src, node_f1(arg), node_f2(arg))
    borrow_tmap_lookup(fmap_borrow_tmap(fm), name_hash, 0)
  } }
}

fn cg_generator_entry_supported(entry: i64, fm: i64, allow_managed_ret: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let fn_wrap = node_f2(entry)
    let fn_node = unwrap_fn(fn_wrap)
    let params = node_f3(fn_node)
    let ret_ty = fn_ret_type(fn_wrap)
    if params != 0 and nlist_len(params) != 0 { 0 }
    else { if allow_managed_ret != 1 and cg_ty_is_managed(ret_ty) == 1 { 0 } else { 1 } }
  }
}

fn cg_generator_i64_entry_supported(entry: i64, fm: i64) -> i64 {
  cg_generator_entry_supported(entry, fm, 0)
}

fn cg_generator_i64_local_lambda_meta_for_arg(arg: i64, scope: i64, src: i64) -> i64 {
  if node_tag(arg) != 2 { 0 }
  else {
    let rid = scope_lookup(scope, src, node_f1(arg), node_f2(arg))
    if rid == 0 - 999 { 0 } else { scope_lookup_meta(scope, src, node_f1(arg), node_f2(arg)) }
  }
}

fn cg_generator_local_closure_supported(arg: i64, scope: i64, src: i64, fm: i64, allow_managed_ret: i64) -> i64 {
  let meta = cg_generator_i64_local_lambda_meta_for_arg(arg, scope, src)
  if meta == 0 { 0 }
  else {
    let lambda = node_f1(meta)
    let local_ty = scope_lookup_type(scope, src, node_f1(arg), node_f2(arg))
    if node_tag(lambda) != 29 { 0 }
    else { if node_f3(lambda) != 0 { 0 }
    else { if local_ty == 0 { 0 }
    else { if ty_tag(local_ty) != 6 { 0 }
    else {
      let params = ty_f1(local_ty)
      let ret_ty = ty_f2(local_ty)
      if nlist_len(params) != 0 { 0 }
      else { if allow_managed_ret != 1 and cg_ty_is_managed(ret_ty) == 1 { 0 } else { 1 } }
    } } } }
  }
}

fn cg_generator_i64_local_closure_supported(arg: i64, scope: i64, src: i64, fm: i64) -> i64 {
  cg_generator_local_closure_supported(arg, scope, src, fm, 0)
}

fn cg_call_generator_producer_supported(arg: i64, scope: i64, src: i64, fm: i64, allow_managed_ret: i64) -> i64 {
  match node_tag(arg) {
    29 -> if node_f3(arg) == 0 { 1 } else { 0 }
    2 -> {
      if cg_generator_local_closure_supported(arg, scope, src, fm, allow_managed_ret) == 1 { 1 }
      else {
        let entry = cg_generator_i64_function_entry_for_arg(arg, scope, src, fm)
        cg_generator_entry_supported(entry, fm, allow_managed_ret)
      }
    }
    _ -> 0
  }
}

fn cg_call_generator_i64_producer_supported(arg: i64, scope: i64, src: i64, fm: i64) -> i64 {
  cg_call_generator_producer_supported(arg, scope, src, fm, 0)
}

fn cg_call_is_generator_i64_new(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "generator_i64_new") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else {
    let args = node_f3(node)
    cg_call_generator_i64_producer_supported(nlist_get(args, 0), scope, src, fm)
  } } }
}

fn cg_emit_generator_i64_fn_spec(code: i64, fm: i64, entry: i64, eff_hash: i64, op_hash: i64, allow_managed_ret: i64) -> i64 {
  let name_hash = node_f1(entry)
  let fn_wrap = node_f2(entry)
  let fn_src = node_f3(entry)
  let owner_hash = node_f4(entry)
  let cache = fmap_fiber_cache(fm)
  let cached = fiber_cache_lookup(cache, name_hash, owner_hash, eff_hash, op_hash)
  if cached != 0 { cached }
  else {
    if cg_generator_entry_supported(entry, fm, allow_managed_ret) != 1 { 0 }
    else {
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      let nparams = if params == 0 { 0 } else { nlist_len(params) }
      let b_over_pos = buf_len(code)
      bu32(code, 0)
      let fn_off = buf_len(code)
      fiber_cache_add(cache, name_hash, owner_hash, eff_hash, op_hash, fn_off)
      emit_prologue(code)
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_par_lowering_top = fmap_par_lowering_top(fm)
      fmap_set_current_ret_ty(fm, ret_ty)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      fmap_set_par_lowering_top(fm, 0)
      cg_fiber_lowering_push(fm, eff_hash, op_hash)
      let fn_scope = cg_fn_params(params, nparams, fn_src, scope_new(), code, fm)
      let body_ctr = cg_expr(body, code, fn_scope, fn_src, nparams, fm)
      let save_ctr = body_ctr
      cg_match_store_result(code, save_ctr, body_ctr)
      if cg_ty_is_managed(ret_ty) == 1 {
        if cg_expr_is_borrow_for_ty(ret_ty, body, fn_scope, fn_src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      cg_emit_cleanups_to_depth(code, fn_src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue(code)
      cg_fiber_lowering_pop(fm)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      fmap_set_par_lowering_top(fm, old_par_lowering_top)
      cg_patch_b(code, b_over_pos, buf_len(code))
      fn_off
    }
  }
}

fn cg_emit_generator_i64_lambda_spec(code: i64, fm: i64, meta: i64, src: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let lambda = node_f1(meta)
  let def_scope = node_f2(meta)
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let nparams = node_f3(lambda)
  let mut lambda_scope = scope_new()
  for pi in 0..nparams {
    let p = nlist_get(params, pi)
    lambda_scope = scope_push(lambda_scope, node_f1(p), node_f2(p), pi + 1)
  }
  let free_vars = nlist_new()
  find_free_vars(body, lambda_scope, def_scope, src, free_vars)
  let nfree = nlist_len(free_vars)
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let fn_off = buf_len(code)
  emit_prologue(code)
  let old_ret_ty = fmap_get_current_ret_ty(fm)
  let old_cleanup_stack = cg_cleanup_stack(fm)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_par_lowering_top = fmap_par_lowering_top(fm)
  __mem_store64(fm + 144, nlist_new())
  __mem_store64(fm + 152, 0)
  fmap_set_par_lowering_top(fm, 0)
  cg_fiber_lowering_push(fm, eff_hash, op_hash)
  let mut body_scope = scope_new()
  let mut body_ctr = 0
  for ci in 0..nfree {
    let fv = nlist_get(free_vars, ci)
    let cap_off = 8 + ci * 16
    if body_ctr < 8 {
      bu32(code, cg_ldr(body_ctr + 19, 0, cap_off))
    } else {
      bu32(code, cg_ldr(17, 0, cap_off))
      emit_store_reg(code, body_ctr, 17)
    }
    let cap_ty = scope_lookup_type(def_scope, src, node_f1(fv), node_f2(fv))
    body_scope = scope_push_typed(body_scope, node_f1(fv), node_f2(fv), reg_id(body_ctr), cap_ty)
    body_ctr = body_ctr + 1
  }
  for param_i in 0..nparams {
    let p = nlist_get(params, param_i)
    let src_reg = param_i + 1
    let param_ty = node_f3(p)
    if body_ctr < 8 {
      let dst_reg = reg_phys(body_ctr)
      bu32(code, encode_add_imm(dst_reg, src_reg, 0))
      body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), dst_reg, param_ty)
      cg_cleanup_push_for_ty(fm, param_ty, dst_reg)
    } else {
      emit_store_reg(code, body_ctr, src_reg)
      body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), reg_id(body_ctr), param_ty)
      cg_cleanup_push_for_ty(fm, param_ty, reg_id(body_ctr))
    }
    body_ctr = body_ctr + 1
  }
  let lambda_ret_ty = cg_expr_type(body, body_scope, src, fm)
  fmap_set_current_ret_ty(fm, lambda_ret_ty)
  let body_result = cg_expr(body, code, body_scope, src, body_ctr, fm)
  let save_ctr = body_result
  cg_match_store_result(code, save_ctr, body_result)
  if cg_ty_is_managed(lambda_ret_ty) == 1 {
    if cg_expr_is_borrow_for_ty(lambda_ret_ty, body, body_scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, lambda_ret_ty, reg_id(save_ctr))
    } else { 0 }
  } else { 0 }
  cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, 0)
  cg_cleanup_restore(fm, 0)
  let result_phys = emit_load_reg(code, save_ctr)
  bu32(code, encode_add_imm(0, result_phys, 0))
  emit_epilogue(code)
  cg_fiber_lowering_pop(fm)
  fmap_set_current_ret_ty(fm, old_ret_ty)
  __mem_store64(fm + 144, old_cleanup_stack)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_par_lowering_top(fm, old_par_lowering_top)
  cg_patch_b(code, skip_pos, buf_len(code))
  fn_off
}

fn cg_emit_generator_variant(code: i64, state_ctr: i64, ctr: i64, variant_name: str) -> i64 {
  cg_bump_alloc_imm(code, 17, 16)
  emit_mov_imm_safe(code, 16, str_hash(__str_ptr(variant_name), 0, __str_len(variant_name)))
  bu32(code, cg_str(16, 17, 0))
  let state_phys = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(state_phys, 17, 8))
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_emit_generator_i64_variant(code: i64, state_ctr: i64, ctr: i64) -> i64 {
  cg_emit_generator_variant(code, state_ctr, ctr, "GeneratorI64")
}

fn cg_emit_generator_i64_store_k(code: i64, fm: i64, cell_ctr: i64, closure_ctr: i64, token_ctr: i64) -> i64 {
  let cell_reg = emit_load_counter_to(code, cell_ctr, 16)
  bu32(code, encode_add_imm(0, cell_reg, 0))
  let closure_reg = emit_load_counter_to(code, closure_ctr, 17)
  bu32(code, encode_add_imm(1, closure_reg, 0))
  cg_emit_call_lit(code, fm, "continuation_cell_store_i64_raw")
  let closure_reg2 = emit_load_counter_to(code, closure_ctr, 16)
  bu32(code, encode_add_imm(0, closure_reg2, 0))
  cg_emit_call_lit(code, fm, "closure_default_release")
  let token_reg = emit_load_counter_to(code, token_ctr, 16)
  bu32(code, encode_add_imm(0, token_reg, 0))
  cg_emit_call_lit(code, fm, "continuation_drop_managed")
}

fn cg_call_is_generator_yield_i64(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "generator_yield_i64") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else {
    let eff_hash = str_hash(__str_ptr("GeneratorYield"), 0, 14)
    let op_hash = str_hash(__str_ptr("yield"), 0, 5)
    cg_fiber_lowering_matches(fm, eff_hash, op_hash)
  } }
}

fn cg_emit_generator_i64_k_closure(code: i64, fm: i64, prompt_ctr: i64, token_ctr: i64, cell_ctr: i64, ctr: i64) -> i64 {
  let skip_pos = buf_len(code)
  bu32(code, 0)
  let thunk_start = buf_len(code)
  emit_prologue(code)
  bu32(code, encode_add_imm(19, 1, 0))
  bu32(code, encode_add_imm(20, 0, 0))
  bu32(code, cg_ldr(0, 20, 8))
  cg_emit_call_lit(code, fm, "continuation_resume_managed")
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let jump_ok_pos = buf_len(code)
  bu32(code, 0)
  let trap = buf_len(code)
  bu32(code, encode_brk(4))
  let ok = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 0, trap)
  cg_patch_b(code, jump_ok_pos, ok)
  bu32(code, cg_ldr(0, 20, 24))
  bu32(code, encode_add_imm(1, 19, 0))
  cg_emit_call_lit(code, fm, "fiber_resume")
  bu32(code, encode_add_imm(21, 0, 0))
  cg_emit_call_lit(code, fm, "fiber_is_done")
  let suspended_cbz = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_imm(0, 21, 0))
  emit_epilogue(code)
  let suspended = buf_len(code)
  cg_patch_cbz(code, suspended_cbz, 0, suspended)
  cg_emit_call_lit(code, fm, "continuation_new_noop")
  bu32(code, encode_add_imm(22, 0, 0))
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  bu32(code, encode_add_imm(23, 0, 0))
  let nested_adr_pos = buf_len(code)
  bu32(code, encode_adr(17, thunk_start - nested_adr_pos))
  bu32(code, cg_str(17, 23, 0))
  emit_mov_imm(code, 0, 56)
  emit_mov_imm(code, 1, 8)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
  bu32(code, encode_add_imm(24, 0, 0))
  emit_mov_imm_safe(code, 17, 3)
  bu32(code, cg_str(17, 24, 0))
  bu32(code, cg_str(22, 24, 8))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 16))
  bu32(code, cg_ldr(17, 20, 24))
  bu32(code, cg_str(17, 24, 24))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 32))
  bu32(code, cg_ldr(17, 20, 40))
  bu32(code, cg_str(17, 24, 40))
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, 24, 48))
  bu32(code, cg_str(24, 23, 8))
  bu32(code, cg_ldr(0, 20, 40))
  bu32(code, encode_add_imm(1, 23, 0))
  cg_emit_call_lit(code, fm, "continuation_cell_store_i64_raw")
  bu32(code, encode_add_imm(0, 23, 0))
  cg_emit_call_lit(code, fm, "closure_default_release")
  bu32(code, encode_add_imm(0, 22, 0))
  cg_emit_call_lit(code, fm, "continuation_drop_managed")
  bu32(code, cg_ldr(0, 21, 8))
  emit_epilogue(code)
  cg_patch_b(code, skip_pos, buf_len(code))
  cg_emit_rc_default_alloc_lit(code, fm, continuation_cleanup_kind_closure(), 16, 8)
  cg_hclause_store_x0(code, ctr)
  let closure_phys1 = emit_load_reg(code, ctr)
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(17, thunk_start - adr_pos))
  bu32(code, cg_str(17, closure_phys1, 0))
  emit_mov_imm(code, 0, 56)
  emit_mov_imm(code, 1, 8)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
  let env_ctr = ctr + 1
  cg_hclause_store_x0(code, env_ctr)
  let env_phys0 = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, 3)
  bu32(code, cg_str(17, env_phys0, 0))
  let env_phys_token = emit_load_counter_to(code, env_ctr, 9)
  let token_phys = emit_load_counter_to(code, token_ctr, 16)
  bu32(code, cg_str(token_phys, env_phys_token, 8))
  let env_phys_token_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_token_kind, 16))
  let env_phys_prompt = emit_load_counter_to(code, env_ctr, 9)
  let prompt_phys = emit_load_counter_to(code, prompt_ctr, 16)
  bu32(code, cg_str(prompt_phys, env_phys_prompt, 24))
  let env_phys_prompt_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_prompt_kind, 32))
  let env_phys_cell = emit_load_counter_to(code, env_ctr, 9)
  let cell_phys = emit_load_counter_to(code, cell_ctr, 16)
  bu32(code, cg_str(cell_phys, env_phys_cell, 40))
  let env_phys_cell_kind = emit_load_counter_to(code, env_ctr, 9)
  emit_mov_imm_safe(code, 17, continuation_cleanup_kind_none())
  bu32(code, cg_str(17, env_phys_cell_kind, 48))
  let closure_phys2 = emit_load_counter_to(code, ctr, 9)
  let env_phys2 = emit_load_counter_to(code, env_ctr, 16)
  bu32(code, cg_str(env_phys2, closure_phys2, 8))
  ctr + 1
}

fn cg_call_generator_new_with_variant(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, variant_name: str, allow_managed_ret: i64) -> i64 {
  let producer = nlist_get(node_f3(node), 0)
  cg_bump_alloc_imm(code, 16, 40)
  if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 16, 0)) }
  else { emit_store_reg(code, ctr, 16) }
  let state_ctr = ctr
  cg_emit_call_lit(code, fm, "continuation_cell_new")
  let cell_ctr = ctr + 1
  cg_hclause_store_x0(code, cell_ctr)
  let cell_variant_phys = emit_load_reg(code, cell_ctr)
  bu32(code, cg_ldr(17, cell_variant_phys, 8))
  emit_store_counter_from_phys(code, cell_ctr, 17)
  let state_phys0 = emit_load_reg(code, state_ctr)
  let cell_phys0 = emit_load_reg(code, cell_ctr)
  bu32(code, cg_str(cell_phys0, state_phys0, 0))
  emit_mov_imm_safe(code, 17, 0)
  let state_phys1 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys1, 8))
  let state_phys2 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys2, 16))
  let state_phys3 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys3, 24))
  let state_phys4 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys4, 32))
  let eff_hash = str_hash(__str_ptr("GeneratorYield"), 0, 14)
  let op_hash = str_hash(__str_ptr("yield"), 0, 5)
  let mut c = ctr + 2
  let mut body_start = 0
  if node_tag(producer) == 29 {
    let body_info = cg_fiber_body_info(node_f2(producer), code, scope, src, fm, eff_hash, op_hash)
    body_start = __mem_load64(body_info)
    c = cg_fiber_body_env(code, scope, src, body_info, c)
  } else {
    let local_meta = cg_generator_i64_local_lambda_meta_for_arg(producer, scope, src)
    if local_meta != 0 {
      body_start = cg_emit_generator_i64_lambda_spec(code, fm, local_meta, src, eff_hash, op_hash)
      let closure_rid = scope_lookup(scope, src, node_f1(producer), node_f2(producer))
      let closure_phys = emit_load_reg_id(code, closure_rid, 16)
      bu32(code, cg_ldr(17, closure_phys, 8))
      if c < 8 { bu32(code, encode_add_imm(c + 19, 17, 0)) }
      else { emit_store_reg(code, c, 17) }
      c = c + 1
    } else {
      let entry = cg_generator_i64_function_entry_for_arg(producer, scope, src, fm)
      body_start = cg_emit_generator_i64_fn_spec(code, fm, entry, eff_hash, op_hash, allow_managed_ret)
      emit_mov_imm_safe(code, 17, 0)
      if c < 8 { bu32(code, encode_add_imm(c + 19, 17, 0)) }
      else { emit_store_reg(code, c, 17) }
      c = c + 1
    }
  }
  let env_ctr = c - 1
  emit_mov_imm_safe(code, 0, 65536)
  cg_emit_call_lit(code, fm, "fiber_segment_new")
  cg_hclause_store_x0(code, c)
  let segment_ctr = c
  let segment_phys = emit_load_reg(code, segment_ctr)
  bu32(code, encode_add_imm(0, segment_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_prompt_new")
  cg_hclause_store_x0(code, c + 1)
  let prompt_ctr = c + 1
  let prompt_phys = emit_load_reg(code, prompt_ctr)
  bu32(code, encode_add_imm(0, prompt_phys, 0))
  let adr_pos = buf_len(code)
  bu32(code, encode_adr(1, body_start - adr_pos))
  let env_phys = emit_load_reg(code, env_ctr)
  bu32(code, encode_add_imm(2, env_phys, 0))
  cg_emit_call_lit(code, fm, "fiber_trampoline")
  cg_hclause_store_x0(code, c + 2)
  let result_ctr = c + 2
  cg_emit_call_lit(code, fm, "fiber_is_done")
  let done_ctr = c + 3
  cg_hclause_store_x0(code, done_ctr)
  let done_phys = emit_load_reg(code, done_ctr)
  let suspend_pos = buf_len(code)
  bu32(code, 0)
  let result_phys_done = emit_load_reg(code, result_ctr)
  let state_phys_done = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(result_phys_done, state_phys_done, 32))
  emit_mov_imm_safe(code, 17, 1)
  let state_phys_done2 = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys_done2, 24))
  let after_pos = buf_len(code)
  bu32(code, 0)
  let suspended = buf_len(code)
  cg_patch_cbz(code, suspend_pos, done_phys, suspended)
  cg_emit_call_lit(code, fm, "continuation_new_noop")
  cg_hclause_store_x0(code, c + 4)
  let token_ctr = c + 4
  let closure_ctr = c + 5
  cg_emit_generator_i64_k_closure(code, fm, prompt_ctr, token_ctr, cell_ctr, closure_ctr)
  cg_emit_generator_i64_store_k(code, fm, cell_ctr, closure_ctr, token_ctr)
  let packet_phys = emit_load_reg(code, result_ctr)
  bu32(code, cg_ldr(17, packet_phys, 8))
  let state_phys_cur = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys_cur, 8))
  emit_mov_imm_safe(code, 17, 1)
  let state_phys_has = emit_load_reg(code, state_ctr)
  bu32(code, cg_str(17, state_phys_has, 16))
  let after = buf_len(code)
  cg_patch_b(code, after_pos, after)
  fmap_inc_fiber_lowering_count(fm)
  cg_emit_generator_variant(code, state_ctr, ctr, variant_name)
}

fn cg_call_generator_i64_new(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_call_generator_new_with_variant(node, code, scope, src, ctr, fm, "GeneratorI64", 0)
}

fn cg_call_is_vector_len(node: i64, scope: i64, src: i64) -> i64 {
  if src_eq(src, node_f1(node), node_f2(node), "vector_len") != 1 { 0 }
  else { if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 }
  else { if node_f4(node) != 1 { 0 } else { 1 } } }
}

fn cg_call_vector_len(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let args = node_f3(node)
  let c_vec = cg_expr(nlist_get(args, 0), code, scope, src, ctr, fm)
  emit_move_counter_to(code, c_vec - 1, 14)
  emit_mov_imm_safe(code, 17, 0)
  let null_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, cg_ldr(17, 14, 8))
  let done = buf_len(code)
  cg_patch_cbz(code, null_pos, 14, done)
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_vector_lowering_count(fm)
  ctr + 1
}

fn cg_tiny_inline_param_index(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut result = 0 - 1
  let mut i = 0
  while i < nlist_len(params) {
    let p = nlist_get(params, i)
    if cg_span_eq(src, node_f1(p), node_f2(p), src, ns, nl) == 1 {
      result = i
      i = nlist_len(params)
    } else { i = i + 1 }
  }
  result
}

fn cg_tiny_inline_params_all_i64(params: i64) -> i64 {
  let mut ok = 1
  let mut i = 0
  while i < nlist_len(params) {
    let p = nlist_get(params, i)
    if ty_eq(node_f3(p), ty_i64()) != 1 {
      ok = 0
      i = nlist_len(params)
    } else { i = i + 1 }
  }
  ok
}

fn cg_tiny_inline_binop_supported(op: i64) -> i64 {
  if op >= 1 { if op <= 18 { 1 } else { 0 } } else { 0 }
}

fn cg_tiny_inline_body_size(node: i64) -> i64 {
  if node == 0 { 1000 }
  else {
    match node_tag(node) {
      1 -> 1
      2 -> 1
      3 -> 1 + cg_tiny_inline_body_size(node_f2(node)) + cg_tiny_inline_body_size(node_f3(node))
      4 -> 2
      24 -> 1
      37 -> cg_tiny_inline_body_size(node_f1(node))
      _ -> 1000
    }
  }
}

fn cg_tiny_inline_load_addr_eligible(node: i64, params: i64, src: i64) -> i64 {
  let param_index = cg_tiny_inline_load_addr_param_index(node, params, src)
  let offset = cg_tiny_inline_load_addr_offset(node, params, src)
  if param_index >= 0 and offset >= 0 and offset % 8 == 0 and offset <= 32760 { 1 } else { 0 }
}

fn cg_tiny_inline_nonnegative_literal_value(node: i64) -> i64 {
  if node == 0 { 0 - 1 }
  else { if node_tag(node) != 1 { 0 - 1 }
  else { if node_f1(node) >= 0 { node_f1(node) } else { 0 - 1 } } }
}

fn cg_tiny_inline_load_addr_param_index(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 0 - 1 }
  else {
    match node_tag(node) {
      2 -> cg_tiny_inline_param_index(params, src, node_f1(node), node_f2(node))
      3 -> if node_f1(node) == 1 {
        let lhs = node_f2(node)
        let rhs = node_f3(node)
        if cg_tiny_inline_load_addr_param_index(lhs, params, src) >= 0 and cg_tiny_inline_nonnegative_literal_value(rhs) >= 0 {
          cg_tiny_inline_load_addr_param_index(lhs, params, src)
        } else { if cg_tiny_inline_nonnegative_literal_value(lhs) >= 0 and cg_tiny_inline_load_addr_param_index(rhs, params, src) >= 0 {
          cg_tiny_inline_load_addr_param_index(rhs, params, src)
        } else { 0 - 1 } }
      } else { 0 - 1 }
      37 -> cg_tiny_inline_load_addr_param_index(node_f1(node), params, src)
      _ -> 0 - 1
    }
  }
}

fn cg_tiny_inline_load_addr_offset(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 0 - 1 }
  else {
    match node_tag(node) {
      2 -> if cg_tiny_inline_param_index(params, src, node_f1(node), node_f2(node)) >= 0 { 0 } else { 0 - 1 }
      3 -> if node_f1(node) == 1 {
        let lhs = node_f2(node)
        let rhs = node_f3(node)
        let rhs_lit = cg_tiny_inline_nonnegative_literal_value(rhs)
        let lhs_lit = cg_tiny_inline_nonnegative_literal_value(lhs)
        if cg_tiny_inline_load_addr_param_index(lhs, params, src) >= 0 and rhs_lit >= 0 {
          let lhs_off = cg_tiny_inline_load_addr_offset(lhs, params, src)
          if lhs_off >= 0 { lhs_off + rhs_lit } else { 0 - 1 }
        } else { if lhs_lit >= 0 and cg_tiny_inline_load_addr_param_index(rhs, params, src) >= 0 {
          let rhs_off = cg_tiny_inline_load_addr_offset(rhs, params, src)
          if rhs_off >= 0 { lhs_lit + rhs_off } else { 0 - 1 }
        } else { 0 - 1 } }
      } else { 0 - 1 }
      37 -> cg_tiny_inline_load_addr_offset(node_f1(node), params, src)
      _ -> 0 - 1
    }
  }
}

fn cg_tiny_inline_mem_load_call_eligible(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 4 { 0 }
  else { if src_eq(src, node_f1(node), node_f2(node), "__mem_load64") != 1 { 0 }
  else { if node_f4(node) != 1 { 0 }
  else { cg_tiny_inline_load_addr_eligible(nlist_get(node_f3(node), 0), params, src) } } } }
}

fn cg_tiny_inline_body_eligible(node: i64, params: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      1 -> 1
      2 -> if cg_tiny_inline_param_index(params, src, node_f1(node), node_f2(node)) >= 0 { 1 } else { 0 }
      3 -> if cg_tiny_inline_binop_supported(node_f1(node)) == 1 {
        cg_tiny_inline_body_eligible(node_f2(node), params, src) and cg_tiny_inline_body_eligible(node_f3(node), params, src)
      } else { 0 }
      4 -> cg_tiny_inline_mem_load_call_eligible(node, params, src)
      24 -> 1
      37 -> cg_tiny_inline_body_eligible(node_f1(node), params, src)
      _ -> 0
    }
  }
}

fn cg_tiny_inline_mem_load_arg(node: i64, params: i64, src: i64) -> i64 {
  if cg_tiny_inline_mem_load_call_eligible(node, params, src) == 1 {
    nlist_get(node_f3(node), 0)
  } else { 0 }
}

fn cg_tiny_inline_entry_for_direct_call(node: i64, src: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let name_hash = str_hash(src, ns, nl)
  let entry = borrow_tmap_lookup(fmap_borrow_tmap(fm), name_hash, 0)
  if entry == 0 { 0 }
  else { entry }
}

fn cg_tiny_inline_entry_supported(entry: i64, nargs: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let fn_wrap = node_f2(entry)
    let fn_src = node_f3(entry)
    let fn_node = unwrap_fn(fn_wrap)
    let params = node_f3(fn_node)
    let body = node_f4(fn_node)
    if fn_tparams(fn_wrap) != 0 { 0 }
    else { if cg_effect_sig_is_pure(fn_effects(fn_wrap)) != 1 { 0 }
    else { if ty_eq(fn_ret_type(fn_wrap), ty_i64()) != 1 { 0 }
    else { if nlist_len(params) != nargs { 0 }
    else { if cg_tiny_inline_params_all_i64(params) != 1 { 0 }
    else { if cg_tiny_inline_body_size(body) > 9 { 0 }
    else { cg_tiny_inline_body_eligible(body, params, fn_src) } } } } } }
  }
}

fn cg_tiny_inline_scope(params: i64, nparams: i64, results: i64, fn_src: i64) -> i64 {
  let mut s = scope_new()
  let mut i = 0
  while i < nparams {
    let p = nlist_get(params, i)
    let result_ctr = __mem_load64(results + i * 8)
    s = scope_push_typed(s, node_f1(p), node_f2(p), reg_id(result_ctr), node_f3(p))
    i = i + 1
  }
  s
}

fn cg_tiny_inline_scope_regids(params: i64, nparams: i64, regids: i64, fn_src: i64) -> i64 {
  let mut s = scope_new()
  let mut i = 0
  while i < nparams {
    let p = nlist_get(params, i)
    let rid = __mem_load64(regids + i * 8)
    s = scope_push_typed(s, node_f1(p), node_f2(p), rid, node_f3(p))
    i = i + 1
  }
  s
}

fn cg_tiny_inline_arg_alias_regid(arg: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if arg == 0 { 0 - 999 }
  else { if node_tag(arg) != 2 { 0 - 999 }
  else {
    let rid = scope_lookup(scope, src, node_f1(arg), node_f2(arg))
    let ty = scope_lookup_type(scope, src, node_f1(arg), node_f2(arg))
    if rid > 0 and ty != 0 and ty_eq(ty, ty_i64()) == 1 { rid }
    else {
      if rid < 0 and ty != 0 and ty_eq(ty, ty_i64()) == 1 { fmap_inc_register_spill_value_count(fm) } else { 0 }
      0 - 999
    }
  } }
}

fn cg_tiny_inline_eval_args_regids(args: i64, nargs: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, regids: i64) -> i64 {
  let mut c = cg_counter_after_scope(scope, ctr)
  for i in 0..nargs {
    let arg = nlist_get(args, i)
    let alias_rid = cg_tiny_inline_arg_alias_regid(arg, scope, src, fm)
    if alias_rid != 0 - 999 {
      __mem_store64(regids + i * 8, alias_rid)
      fmap_inc_tiny_inline_arg_alias_count(fm)
    } else {
      c = cg_expr(arg, code, scope, src, c, fm)
      __mem_store64(regids + i * 8, reg_id(c - 1))
      c = cg_counter_after_scope(scope, c)
    }
  }
  c
}

fn cg_tiny_inline_direct_mem_load_call(body: i64, params: i64, results: i64, code: i64, ctr: i64, fn_src: i64, fm: i64) -> i64 {
  let arg = cg_tiny_inline_mem_load_arg(body, params, fn_src)
  let param_index = cg_tiny_inline_load_addr_param_index(arg, params, fn_src)
  let offset = cg_tiny_inline_load_addr_offset(arg, params, fn_src)
  let param_ctr = __mem_load64(results + param_index * 8)
  let base = emit_load_counter_to(code, param_ctr, 16)
  bu32(code, cg_ldr(17, base, offset))
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_direct_call_inline_count(fm)
  ctr + 1
}

fn cg_tiny_inline_direct_mem_load_call_regids(body: i64, params: i64, regids: i64, code: i64, ctr: i64, fn_src: i64, fm: i64) -> i64 {
  let arg = cg_tiny_inline_mem_load_arg(body, params, fn_src)
  let param_index = cg_tiny_inline_load_addr_param_index(arg, params, fn_src)
  let offset = cg_tiny_inline_load_addr_offset(arg, params, fn_src)
  let rid = __mem_load64(regids + param_index * 8)
  let base = emit_load_reg_id(code, rid, 16)
  bu32(code, cg_ldr(17, base, offset))
  emit_store_counter_from_phys(code, ctr, 17)
  fmap_inc_direct_call_inline_count(fm)
  ctr + 1
}

fn cg_tiny_inline_direct_call(node: i64, entry: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let fn_wrap = node_f2(entry)
  let fn_src = node_f3(entry)
  let fn_node = unwrap_fn(fn_wrap)
  let params = node_f3(fn_node)
  let body = node_f4(fn_node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  let regids = alloc_bump(nargs * 8 + 8)
  let c = cg_tiny_inline_eval_args_regids(args, nargs, code, scope, src, ctr, fm, regids)
  if cg_tiny_inline_mem_load_call_eligible(body, params, fn_src) == 1 {
    cg_tiny_inline_direct_mem_load_call_regids(body, params, regids, code, ctr, fn_src, fm)
  } else {
    let body_ctr = cg_counter_after_scope(scope, c)
    let inline_scope = cg_tiny_inline_scope_regids(params, nlist_len(params), regids, fn_src)
    let body_result = cg_expr(body, code, inline_scope, fn_src, body_ctr, fm)
    cg_match_store_result(code, ctr, body_result)
    fmap_inc_direct_call_inline_count(fm)
    ctr + 1
  }
}

fn cg_tiny_inline_try_direct_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
