  fmap_set_vector_bounds_top(fm, entry)
}

fn cg_vector_bound_mode_for_index(fm: i64, idx: i64, body: i64, src: i64) -> i64 {
  if cg_nonnegative_has(fm, src, node_f1(idx), node_f2(idx)) == 1 {
    if cg_expr_preserves_nonnegative_var(body, src, node_f1(idx), node_f2(idx)) == 1 { 2 }
    else { 1 }
  } else { 1 }
}

fn cg_vector_bound_push_from_cond(fm: i64, cond: i64, body: i64, scope: i64, src: i64) -> i64 {
  if cond == 0 { 0 }
  else { if node_tag(cond) != 3 { 0 }
  else { if node_f1(cond) != 7 { 0 }
  else {
    let idx = node_f2(cond)
    let rhs = node_f3(cond)
    if node_tag(idx) != 2 { 0 }
    else {
      let mode = cg_vector_bound_mode_for_index(fm, idx, body, src)
      let vec = cg_vector_len_call_vec_ident(rhs, scope, src)
      if vec != 0 {
        cg_vector_bound_push(fm, src, idx, src, node_f1(vec), node_f2(vec), mode)
      } else { if node_tag(rhs) != 2 { 0 }
      else {
        let alias = cg_vector_len_alias_find(fm, src, node_f1(rhs), node_f2(rhs))
        if alias == 0 { 0 }
        else { cg_vector_bound_push(fm, src, idx, __mem_load64(alias + 32), __mem_load64(alias + 40), __mem_load64(alias + 48), mode) }
      } }
    }
  } } }
}

fn cg_direct_branch_true_cond_for_op(op: i64) -> i64 {
  -- Condition code for the true edge of a comparison.
  -- ==5 !=6 <7 >8 <=9 >=10
  match op {
    5 -> 0
    6 -> 1
    7 -> 11
    8 -> 12
    9 -> 13
    10 -> 10
    _ -> 0 - 1
  }
}

fn cg_direct_branch_false_cond_for_op(op: i64) -> i64 {
  -- Condition code for the false edge of a comparison.
  -- ==5 !=6 <7 >8 <=9 >=10
  match op {
    5 -> 1
    6 -> 0
    7 -> 10
    8 -> 13
    9 -> 12
    10 -> 11
    _ -> 0 - 1
  }
}

fn cg_branch_result(patches: i64, next_ctr: i64) -> i64 {
  node_new(0, patches, next_ctr, 0, 0)
}

fn cg_branch_result_reclaim(patches: i64, next_ctr: i64, base_ctr: i64, fm: i64) -> i64 {
  if next_ctr > base_ctr and fm != 0 {
    fmap_inc_branch_counter_reuse_count(fm)
  } else { 0 }
  cg_branch_result(patches, base_ctr)
}

fn cg_branch_patch_list_single(pos: i64, cond: i64) -> i64 {
  let patches = nlist_new()
  nlist_add(patches, node_new(0, pos, cond, 0, 0))
  patches
}

fn cg_branch_patch_list_append(dst: i64, src: i64) -> i64 {
  for i in 0..nlist_len(src) {
    nlist_add(dst, nlist_get(src, i))
  }
  dst
}

fn cg_patch_branch_cond_list(code: i64, patches: i64, target: i64) -> i64 {
  for i in 0..nlist_len(patches) {
    let patch = nlist_get(patches, i)
    cg_patch_b_cond(code, node_f1(patch), node_f2(patch), target)
  }
  0
}

fn cg_hidden_counter_mask_below(floor: i64) -> i64 {
  let limit = if floor > 8 { 8 } else { floor }
  let mut mask = 0
  let mut i = 0
  while i < limit {
    mask = mask + cg_bit(i)
    i = i + 1
  }
  mask
}

fn cg_direct_branch_start_ctr(scope: i64, ctr: i64, cond: i64, src: i64, fm: i64, hidden_mask: i64) -> i64 {
  if hidden_mask < 0 {
    cg_counter_for_expr(scope, ctr, cond, src, fm)
  } else {
    cg_counter_for_expr_boundary_hidden(scope, ctr, cond, src, hidden_mask, fm)
  }
}

fn cg_direct_branch_comparison_mode(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, branch_cond: i64, hidden_mask: i64) -> i64 {
  let lhs = node_f2(cond)
  let rhs = node_f3(cond)
  let start_ctr = cg_direct_branch_start_ctr(scope, ctr, cond, src, fm, hidden_mask)
  if cg_binop_uses_f64(cond, scope, src, fm) == 1 {
    let next_ctr = cg_emit_f64_operands_to_d(lhs, rhs, code, scope, src, start_ctr, fm)
    bu32(code, encode_fcmp_d(0, 1))
    let branch_pos = buf_len(code)
    bu32(code, 0)
    fmap_inc_direct_branch_lowering_count(fm)
    cg_branch_result_reclaim(cg_branch_patch_list_single(branch_pos, branch_cond), next_ctr, ctr, fm)
  } else {
    let c1 = cg_expr(lhs, code, scope, src, start_ctr, fm)
    let c2 = cg_expr(rhs, code, scope, src, c1, fm)
    let lhs_phys = emit_load_reg(code, c1 - 1)
    let rhs_phys = emit_load_rhs(code, c2 - 1)
    bu32(code, encode_cmp(lhs_phys, rhs_phys))
    let branch_pos = buf_len(code)
    bu32(code, 0)
    fmap_inc_direct_branch_lowering_count(fm)
    cg_branch_result_reclaim(cg_branch_patch_list_single(branch_pos, branch_cond), c2, ctr, fm)
  }
}

fn cg_direct_branch_generic_mode(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, branch_cond: i64, hidden_mask: i64) -> i64 {
  let start_ctr = cg_direct_branch_start_ctr(scope, ctr, cond, src, fm, hidden_mask)
  let c1 = cg_expr(cond, code, scope, src, start_ctr, fm)
  let cond_phys = emit_load_reg(code, c1 - 1)
  bu32(code, encode_cmp(cond_phys, 31))
  let branch_pos = buf_len(code)
  bu32(code, 0)
  cg_branch_result_reclaim(cg_branch_patch_list_single(branch_pos, branch_cond), c1, ctr, fm)
}

fn cg_direct_branch_false_mode(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, hidden_mask: i64) -> i64 {
  if cond == 0 { 0 }
  else { if node_tag(cond) == 22 {
    cg_direct_branch_true_mode(node_f1(cond), code, scope, src, ctr, fm, hidden_mask)
  }
  else { if node_tag(cond) != 3 {
    cg_direct_branch_generic_mode(cond, code, scope, src, ctr, fm, 0, hidden_mask)
  }
  else {
    let op = node_f1(cond)
    if op == 12 {
      let left = cg_direct_branch_false_mode(node_f2(cond), code, scope, src, ctr, fm, hidden_mask)
      let right = cg_direct_branch_false_mode(node_f3(cond), code, scope, src, node_f2(left), fm, hidden_mask)
      cg_branch_patch_list_append(node_f1(left), node_f1(right))
      cg_branch_result(node_f1(left), node_f2(right))
    } else { if op == 13 {
      let left_true = cg_direct_branch_true_mode(node_f2(cond), code, scope, src, ctr, fm, hidden_mask)
      let right_false = cg_direct_branch_false_mode(node_f3(cond), code, scope, src, node_f2(left_true), fm, hidden_mask)
      cg_patch_branch_cond_list(code, node_f1(left_true), buf_len(code))
      cg_branch_result(node_f1(right_false), node_f2(right_false))
    } else {
      let branch_cond = cg_direct_branch_false_cond_for_op(op)
      if branch_cond < 0 {
        cg_direct_branch_generic_mode(cond, code, scope, src, ctr, fm, 0, hidden_mask)
      } else {
        cg_direct_branch_comparison_mode(cond, code, scope, src, ctr, fm, branch_cond, hidden_mask)
      }
    } }
  } } }
}

fn cg_direct_branch_true_mode(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, hidden_mask: i64) -> i64 {
  if cond == 0 { 0 }
  else { if node_tag(cond) == 22 {
    cg_direct_branch_false_mode(node_f1(cond), code, scope, src, ctr, fm, hidden_mask)
  }
  else { if node_tag(cond) != 3 {
    cg_direct_branch_generic_mode(cond, code, scope, src, ctr, fm, 1, hidden_mask)
  }
  else {
    let op = node_f1(cond)
    if op == 12 {
      let left_false = cg_direct_branch_false_mode(node_f2(cond), code, scope, src, ctr, fm, hidden_mask)
      let right_true = cg_direct_branch_true_mode(node_f3(cond), code, scope, src, node_f2(left_false), fm, hidden_mask)
      cg_patch_branch_cond_list(code, node_f1(left_false), buf_len(code))
      cg_branch_result(node_f1(right_true), node_f2(right_true))
    } else { if op == 13 {
      let left = cg_direct_branch_true_mode(node_f2(cond), code, scope, src, ctr, fm, hidden_mask)
      let right = cg_direct_branch_true_mode(node_f3(cond), code, scope, src, node_f2(left), fm, hidden_mask)
      cg_branch_patch_list_append(node_f1(left), node_f1(right))
      cg_branch_result(node_f1(left), node_f2(right))
    } else {
      let branch_cond = cg_direct_branch_true_cond_for_op(op)
      if branch_cond < 0 {
        cg_direct_branch_generic_mode(cond, code, scope, src, ctr, fm, 1, hidden_mask)
      } else {
        cg_direct_branch_comparison_mode(cond, code, scope, src, ctr, fm, branch_cond, hidden_mask)
      }
    } }
  } } }
}

fn cg_direct_branch_false(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_direct_branch_false_mode(cond, code, scope, src, ctr, fm, 0 - 1)
}

fn cg_direct_branch_true(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_direct_branch_true_mode(cond, code, scope, src, ctr, fm, 0 - 1)
}

fn cg_direct_branch_false_floor(cond: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  if floor >= 0 {
    cg_direct_branch_false_mode(cond, code, scope, src, ctr, fm, cg_hidden_counter_mask_below(floor))
  } else {
    cg_direct_branch_false(cond, code, scope, src, ctr, fm)
  }
}

fn cg_store_bool_imm(code: i64, ctr: i64, value: i64) -> i64 {
  if ctr < 8 {
    emit_mov_imm(code, ctr + 19, value)
  } else {
    emit_mov_imm(code, 17, value)
    emit_store_reg(code, ctr, 17)
  }
  0
}

fn cg_logical_value(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let branch = cg_direct_branch_false(node, code, scope, src, ctr, fm)
  cg_store_bool_imm(code, ctr, 1)
  let done_pos = buf_len(code)
  bu32(code, 0)
  let false_start = buf_len(code)
  cg_patch_branch_cond_list(code, node_f1(branch), false_start)
  cg_store_bool_imm(code, ctr, 0)
  cg_patch_b(code, done_pos, buf_len(code))
  ctr + 1
}

fn cg_vector_bound_mode_for_access(fm: i64, src: i64, vec: i64, idx: i64) -> i64 {
  if vec == 0 or idx == 0 { 0 }
  else { if node_tag(vec) != 2 or node_tag(idx) != 2 { 0 }
  else {
    let mut cur = fmap_vector_bounds_top(fm)
    let mut mode = 0
    while cur != 0 {
      if cg_span_eq(__mem_load64(cur + 8), __mem_load64(cur + 16), __mem_load64(cur + 24), src, node_f1(idx), node_f2(idx)) == 1 {
        if cg_span_eq(__mem_load64(cur + 32), __mem_load64(cur + 40), __mem_load64(cur + 48), src, node_f1(vec), node_f2(vec)) == 1 {
          mode = __mem_load64(cur + 56)
          cur = 0
        } else { cur = __mem_load64(cur) }
      } else { cur = __mem_load64(cur) }
    }
    mode
  } }
}

fn cg_vector_data_collect_candidates(node: i64, scope: i64, src: i64, out: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> {
        cg_vector_data_collect_candidates(node_f2(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f3(node), scope, src, out)
      }
      4 -> {
        let args = node_f3(node)
        for i in 0..node_f4(node) {
          cg_vector_data_collect_candidates(nlist_get(args, i), scope, src, out)
        }
      }
      6 -> {
        cg_vector_data_collect_candidates(node_f3(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f4(node), scope, src, out)
      }
      7 -> {
        cg_vector_data_collect_candidates(node_f1(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f2(node), scope, src, out)
      }
      8 -> {
        cg_vector_data_collect_candidates(node_f1(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f2(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f3(node), scope, src, out)
      }
      10 -> {
        cg_vector_data_collect_candidates(node_f1(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f2(node), scope, src, out)
      }
      11 -> {
        cg_vector_data_collect_candidates(node_f3(node), scope, src, out)
        cg_vector_data_collect_candidates(node_f4(node), scope, src, out)
      }
      12 -> cg_vector_data_collect_candidates(node_f3(node), scope, src, out)
      36 -> {
        let call_node = node_f2(node)
        let args = node_f3(call_node)
        if cg_generic_call_is_vector_i64(node, scope, src, "vector_get", 3) == 1 {
          cg_vector_ident_list_add(out, src, nlist_get(args, 0))
        } else { if cg_generic_call_is_vector_i64(node, scope, src, "vector_set", 3) == 1 {
          cg_vector_ident_list_add(out, src, nlist_get(args, 0))
        } else { 0 } }
        for j in 0..node_f4(call_node) {
          cg_vector_data_collect_candidates(nlist_get(args, j), scope, src, out)
        }
      }
      _ -> 0
    }
  }
}

fn cg_vector_data_body_safe(node: i64, scope: i64, src: i64) -> i64 {
  if node == 0 { 1 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      3 -> if cg_vector_data_body_safe(node_f2(node), scope, src) != 1 { 0 } else { cg_vector_data_body_safe(node_f3(node), scope, src) }
      4 -> {
        if cg_call_is_vector_len(node, scope, src) == 1 { 1 } else { 0 }
      }
      6 -> if cg_vector_data_body_safe(node_f3(node), scope, src) != 1 { 0 } else { cg_vector_data_body_safe(node_f4(node), scope, src) }
      7 -> if cg_vector_data_body_safe(node_f1(node), scope, src) != 1 { 0 } else { cg_vector_data_body_safe(node_f2(node), scope, src) }
      8 -> {
        if cg_vector_data_body_safe(node_f1(node), scope, src) != 1 { 0 }
        else { if cg_vector_data_body_safe(node_f2(node), scope, src) != 1 { 0 }
        else { cg_vector_data_body_safe(node_f3(node), scope, src) } }
      }
      10 -> if cg_vector_data_body_safe(node_f1(node), scope, src) != 1 { 0 } else { cg_vector_data_body_safe(node_f2(node), scope, src) }
      11 -> if cg_vector_data_body_safe(node_f3(node), scope, src) != 1 { 0 } else { cg_vector_data_body_safe(node_f4(node), scope, src) }
      12 -> cg_vector_data_body_safe(node_f3(node), scope, src)
      22 -> cg_vector_data_body_safe(node_f1(node), scope, src)
      26 -> if node_f1(node) == 0 { 1 } else { cg_vector_data_body_safe(node_f1(node), scope, src) }
      36 -> {
        if cg_generic_call_is_vector_i64(node, scope, src, "vector_get", 3) == 1 { 1 }
        else { if cg_generic_call_is_vector_i64(node, scope, src, "vector_set", 3) == 1 { 1 }
        else { 0 } }
      }
      _ -> 0
    }
  }
}

fn cg_vector_data_expr_assigns_ident(node: i64, src: i64, ident: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      6 -> if cg_ident_matches(node_new(2, node_f1(node), node_f2(node), 0, 0), src, node_f1(ident), node_f2(ident)) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f4(node), src, ident) }
      7 -> if cg_vector_data_expr_assigns_ident(node_f1(node), src, ident) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f2(node), src, ident) }
      8 -> {
        if cg_vector_data_expr_assigns_ident(node_f1(node), src, ident) == 1 { 1 }
        else { if cg_vector_data_expr_assigns_ident(node_f2(node), src, ident) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f3(node), src, ident) } }
      }
      10 -> if cg_vector_data_expr_assigns_ident(node_f1(node), src, ident) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f2(node), src, ident) }
      11 -> if cg_ident_matches(node_new(2, node_f1(node), node_f2(node), 0, 0), src, node_f1(ident), node_f2(ident)) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f4(node), src, ident) }
      12 -> if cg_span_eq(src, node_f1(node), node_f2(node), src, node_f1(ident), node_f2(ident)) == 1 { 1 }
        else { cg_vector_data_expr_assigns_ident(node_f3(node), src, ident) }
      _ -> 0
    }
  }
}

fn cg_vector_data_filter_candidates(cond: i64, body: i64, scope: i64, src: i64, fm: i64, candidates: i64) -> i64 {
  let result = nlist_new()
  if cg_vector_data_body_safe(cond, scope, src) != 1 { result }
  else { if cg_vector_data_body_safe(body, scope, src) != 1 { result }
  else {
    for i in 0..nlist_len(candidates) {
      let ident = nlist_get(candidates, i)
      if cg_vector_data_expr_assigns_ident(cond, src, ident) == 1 { 0 }
      else { if cg_vector_data_expr_assigns_ident(body, src, ident) == 1 { 0 }
      else { if cg_vector_data_find(fm, src, node_f1(ident), node_f2(ident)) >= 0 { 0 }
      else { nlist_add(result, ident) } } }
    }
    result
  } }
}

fn cg_vector_data_loop_candidates(cond: i64, body: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let collected = nlist_new()
  cg_vector_data_collect_candidates(body, scope, src, collected)
  cg_vector_data_filter_candidates(cond, body, scope, src, fm, collected)
}

fn cg_vector_data_emit_loop_hoists(candidates: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let mut c = ctr
  for i in 0..nlist_len(candidates) {
    let ident = nlist_get(candidates, i)
    let rid = scope_lookup(scope, src, node_f1(ident), node_f2(ident))
    if rid == 0 - 999 { 0 }
    else {
      let vec_phys = emit_load_reg_id(code, rid, 14)
      emit_mov_imm_safe(code, 17, 0)
      let null_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, cg_ldr(17, vec_phys, 0))
      let done = buf_len(code)
      cg_patch_cbz(code, null_pos, vec_phys, done)
      emit_store_counter_from_phys(code, c, 17)
      cg_vector_data_push(fm, src, ident, c)
      fmap_inc_vector_data_hoist_count(fm)
      c = c + 1
    }
  }
  c
}

-- ======================================================================
-- Code generation: all cg_* functions
-- ======================================================================

-- String literal codegen: emit bytes from source into heap at runtime
-- x16 = data pointer, x17 = byte temp
fn cg_string_bytes(code: i64, src: i64, start: i64, len: i64) -> i64 {
  for i in 0..len {
    let byte = __mem_load8(src + start + i)
    bu32(code, encode_movz(17, byte, 0))
    bu32(code, cg_strb(17, 16, i))
  }
  0
}
fn cg_string(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let str_start = node_f1(node)
  let str_len = node_f2(node)
  let aligned_len = (str_len + 7) / 8 * 8
  -- Step 1: bump-alloc data
  cg_bump_alloc_imm(code, 16, aligned_len)
  -- Step 2: store each byte (compile-time known from source)
  cg_string_bytes(code, src, str_start, str_len)
  -- Step 3: bump-alloc descriptor (16 bytes)
  cg_bump_alloc_imm(code, 17, 16)
  -- Step 4: STR x16, [x17, #0] (data ptr): 0xF9000000 = 4177526784
  bu32(code, cg_str(16, 17, 0))
  -- Step 5: MOVZ x16, #len; STR x16, [x17, #8]
  emit_mov_imm(code, 16, str_len)
  bu32(code, cg_str(16, 17, 8))
  -- Step 6: move x17 (descriptor) to result register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

-- While: loop with condition check, evaluates to 0 (nil)
fn cg_while(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_while_with_floor(node, code, scope, src, ctr, fm, 0 - 1)
}

fn cg_while_floor(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  cg_while_with_floor(node, code, scope, src, ctr, fm, floor)
}

fn cg_while_with_floor(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  let induction_loop = cg_while_try_induction_register(node, code, scope, src, ctr, fm, floor)
  if induction_loop >= 0 { induction_loop } else {
  let cond = node_f1(node)
  let body = node_f2(node)
  -- Save outer loop context
  let old_loop_start = __mem_load64(fm + 56)
  let old_break_patches = __mem_load64(fm + 64)
  let old_loop_cleanup_depth = __mem_load64(fm + 152)
  let old_loop_result_ctr = fmap_loop_result_ctr(fm)
  let old_vector_bounds_top = fmap_vector_bounds_top(fm)
  let old_vector_data_top = fmap_vector_data_top(fm)
  let old_vector_push_proof_top = fmap_vector_push_proof_top(fm)
  let accum_candidates = cg_loop_accum_candidates(body, scope, src)
  let accum_plan = cg_loop_accum_plan(accum_candidates, scope, fm)
  cg_loop_accum_emit_loads(accum_plan, code, fm)
  let loop_scope = if accum_plan == 0 { scope } else { cg_loop_accum_plan_scope(accum_plan) }
  let hoist_candidates = cg_vector_data_loop_candidates(cond, body, loop_scope, src, fm)
  let loop_base_ctr = cg_counter_for_hoists_and_expr(loop_scope, ctr, nlist_len(hoist_candidates), cond, src, fm)
  let loop_ctr = cg_vector_data_emit_loop_hoists(hoist_candidates, code, loop_scope, src, loop_base_ctr, fm)
  let push_proofs = cg_vector_push_loop_proofs(cond, body, loop_scope, src, fm)
  cg_vector_push_activate_loop_proofs(fm, push_proofs)
  -- Set up this loop's context
  let loop_start = buf_len(code)
  let break_patches = nlist_new()
  __mem_store64(fm + 56, loop_start)
  __mem_store64(fm + 64, break_patches)
  __mem_store64(fm + 152, cg_cleanup_count(fm))
  fmap_set_loop_result_ctr(fm, ctr)
  let direct_branch = cg_direct_branch_false_floor(cond, code, loop_scope, src, loop_ctr, fm, floor)
  let mut cond_phys = 0
  let mut branch_pos = 0
  let mut body_ctr = loop_ctr
  if direct_branch == 0 {
    let c1 = cg_expr(cond, code, loop_scope, src, loop_ctr, fm)
    cond_phys = emit_load_reg(code, c1 - 1)
    branch_pos = buf_len(code)
    bu32(code, 0)
    body_ctr = c1
  } else {
    branch_pos = node_f1(direct_branch)
    body_ctr = node_f2(direct_branch)
  }
  -- body (result discarded)
  cg_vector_bound_push_from_cond(fm, cond, body, loop_scope, src)
  let body_start_ctr = cg_counter_for_expr(loop_scope, body_ctr, body, src, fm)
  let c2 = cg_expr(body, code, loop_scope, src, body_start_ctr, fm)
  fmap_set_vector_bounds_top(fm, old_vector_bounds_top)
  fmap_set_vector_data_top(fm, old_vector_data_top)
  fmap_set_vector_push_proof_top(fm, old_vector_push_proof_top)
  -- B loop_start
  let b_pos = buf_len(code)
  bu32(code, encode_b(loop_start - b_pos))
  -- Patch CBZ and all break targets
  let store_start = buf_len(code)
  if direct_branch == 0 {
    cg_patch_cbz(code, branch_pos, cond_phys, store_start)
  } else {
    cg_patch_branch_cond_list(code, branch_pos, store_start)
  }
  cg_patch_breaks(code, break_patches, store_start)
  cg_loop_accum_emit_stores(accum_plan, code)
  -- Restore outer loop context
  __mem_store64(fm + 56, old_loop_start)
  __mem_store64(fm + 64, old_break_patches)
  __mem_store64(fm + 152, old_loop_cleanup_depth)
  fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
  -- Result is 0 (nil)
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  }
}

fn cg_while_step_is_simple(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      _ -> 0
    }
  }
}

fn cg_while_update_value_matches(val: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if val == 0 { 0 }
  else { if node_tag(val) != 3 { 0 }
  else {
    let op = node_f1(val)
    let lhs = node_f2(val)
    let rhs = node_f3(val)
    if op == 1 {
      if cg_ident_matches(lhs, src, ns, nl) == 1 { cg_while_step_is_simple(rhs) }
      else { if cg_ident_matches(rhs, src, ns, nl) == 1 { cg_while_step_is_simple(lhs) } else { 0 } }
    } else { if op == 2 {
      if cg_ident_matches(lhs, src, ns, nl) == 1 { cg_while_step_is_simple(rhs) } else { 0 }
    } else { 0 } }
  } }
}

fn cg_while_update_assign_matches(assign: i64, src: i64) -> i64 {
  if assign == 0 { 0 }
  else { if node_tag(assign) != 12 { 0 }
  else { cg_while_update_value_matches(node_f3(assign), src, node_f1(assign), node_f2(assign)) } }
}

fn cg_while_induction_split_body(body: i64, src: i64) -> i64 {
  if body == 0 { 0 }
  else {
    let tag = node_tag(body)
    if tag == 12 {
      if cg_while_update_assign_matches(body, src) == 1 {
        node_new(0, node_f1(body), node_f2(body), body, node_new(1, 0, 0, 0, 0))
      } else { 0 }
    } else { if tag == 7 {
      let rest_split = cg_while_induction_split_body(node_f2(body), src)
      if rest_split == 0 { 0 }
      else {
        node_new(0, node_f1(rest_split), node_f2(rest_split), node_f3(rest_split), node_new(7, node_f1(body), node_f4(rest_split), 0, 0))
      }
    } else { 0 } }
  }
}

fn cg_args_has_name_write_or_bind(args: i64, n: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < n {
    if cg_expr_has_name_write_or_bind(nlist_get(args, i), src, ns, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_args_mentions_name(args: i64, n: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < n {
    if cg_expr_mentions_name(nlist_get(args, i), src, ns, nl) == 1 {
      found = 1
      i = n
    } else { i = i + 1 }
  }
  found
}

fn cg_expr_mentions_name(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> cg_ident_matches(node, src, ns, nl)
      3 -> if cg_expr_mentions_name(node_f2(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f3(node), src, ns, nl) }
      4 -> cg_args_mentions_name(node_f3(node), node_f4(node), src, ns, nl)
      5 -> if cg_expr_mentions_name(node_f1(node), src, ns, nl) == 1 { 1 } else { if cg_expr_mentions_name(node_f2(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f3(node), src, ns, nl) } }
      6 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 0 } else { if cg_expr_mentions_name(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f4(node), src, ns, nl) } }
      7 -> if cg_expr_mentions_name(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f2(node), src, ns, nl) }
      10 -> if cg_expr_mentions_name(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f2(node), src, ns, nl) }
      11 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 0 } else { if cg_expr_mentions_name(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f4(node), src, ns, nl) } }
      12 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f3(node), src, ns, nl) }
      22 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      25 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      26 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      35 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      36 -> cg_expr_mentions_name(node_f2(node), src, ns, nl)
      37 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 0 } else { if cg_expr_mentions_name(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f4(node), src, ns, nl) } }
      49 -> cg_expr_mentions_name(node_f1(node), src, ns, nl)
      52 -> if cg_expr_mentions_name(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_mentions_name(node_f2(node), src, ns, nl) }
      _ -> 0
    }
  }
}

fn cg_expr_has_name_write_or_bind(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> if cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) }
      4 -> cg_args_has_name_write_or_bind(node_f3(node), node_f4(node), src, ns, nl)
      5 -> if cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl) == 1 { 1 } else { if cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) } }
      6 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 1 } else { if cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f4(node), src, ns, nl) } }
      7 -> if cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl) }
      10 -> if cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl) }
      11 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 1 } else { if cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f4(node), src, ns, nl) } }
      12 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) }
      22 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      25 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      26 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      35 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      36 -> cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl)
      37 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { 1 } else { if cg_expr_has_name_write_or_bind(node_f3(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f4(node), src, ns, nl) } }
      49 -> cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl)
      52 -> if cg_expr_has_name_write_or_bind(node_f1(node), src, ns, nl) == 1 { 1 } else { cg_expr_has_name_write_or_bind(node_f2(node), src, ns, nl) }
      _ -> 0
    }
  }
}

fn cg_expr_has_break(node: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> if cg_expr_has_break(node_f2(node)) == 1 { 1 } else { cg_expr_has_break(node_f3(node)) }
      5 -> if cg_expr_has_break(node_f1(node)) == 1 { 1 } else { if cg_expr_has_break(node_f2(node)) == 1 { 1 } else { cg_expr_has_break(node_f3(node)) } }
      6 -> if cg_expr_has_break(node_f3(node)) == 1 { 1 } else { cg_expr_has_break(node_f4(node)) }
      7 -> if cg_expr_has_break(node_f1(node)) == 1 { 1 } else { cg_expr_has_break(node_f2(node)) }
      10 -> if cg_expr_has_break(node_f1(node)) == 1 { 1 } else { cg_expr_has_break(node_f2(node)) }
      11 -> if cg_expr_has_break(node_f3(node)) == 1 { 1 } else { cg_expr_has_break(node_f4(node)) }
      12 -> cg_expr_has_break(node_f3(node))
      22 -> cg_expr_has_break(node_f1(node))
      25 -> cg_expr_has_break(node_f1(node))
      26 -> 1
      35 -> cg_expr_has_break(node_f1(node))
      36 -> cg_expr_has_break(node_f2(node))
      37 -> cg_expr_has_break(node_f1(node))
      47 -> if cg_expr_has_break(node_f3(node)) == 1 { 1 } else { cg_expr_has_break(node_f4(node)) }
      49 -> cg_expr_has_break(node_f1(node))
      52 -> if cg_expr_has_break(node_f1(node)) == 1 { 1 } else { cg_expr_has_break(node_f2(node)) }
      _ -> 0
    }
  }
}

fn cg_loop_accum_entry_new(ns: i64, nl: i64, rid: i64, ty: i64) -> i64 {
  let e = alloc_bump(40)
  __mem_store64(e, ns)
  __mem_store64(e + 8, nl)
  __mem_store64(e + 16, rid)
  __mem_store64(e + 24, ty)
  __mem_store64(e + 32, 0)
  e
}

fn cg_loop_accum_entry_ns(e: i64) -> i64 { __mem_load64(e) }
fn cg_loop_accum_entry_nl(e: i64) -> i64 { __mem_load64(e + 8) }
fn cg_loop_accum_entry_rid(e: i64) -> i64 { __mem_load64(e + 16) }
fn cg_loop_accum_entry_ty(e: i64) -> i64 { __mem_load64(e + 24) }
fn cg_loop_accum_entry_phys(e: i64) -> i64 { __mem_load64(e + 32) }
fn cg_loop_accum_entry_set_phys(e: i64, phys: i64) -> i64 { __mem_store64(e + 32, phys) 0 }

fn cg_loop_accum_find(entries: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) {
    let e = nlist_get(entries, i)
    if cg_span_eq(src, cg_loop_accum_entry_ns(e), cg_loop_accum_entry_nl(e), src, ns, nl) == 1 {
      found = e
      i = nlist_len(entries)
    } else { i = i + 1 }
  }
  found
}

fn cg_loop_accum_assignment_candidate(assign: i64, scope: i64, src: i64) -> i64 {
  if assign == 0 { 0 }
  else { if node_tag(assign) != 12 { 0 }
  else {
    let ns = node_f1(assign)
    let nl = node_f2(assign)
    let rid = scope_lookup(scope, src, ns, nl)
    let ty = scope_lookup_type(scope, src, ns, nl)
    if rid >= 0 { 0 }
    else { if rid == 0 - 999 { 0 }
    else { if ty == 0 { 0 }
    else { if ty_eq(ty, ty_i64()) != 1 { 0 }
    else { if cg_while_update_value_matches(node_f3(assign), src, ns, nl) != 1 { 0 }
    else { cg_loop_accum_entry_new(ns, nl, rid, ty) } } } } }
  } }
}

fn cg_loop_accum_collect_args(args: i64, n: i64, scope: i64, src: i64, entries: i64) -> i64 {
  for i in 0..n {
    cg_loop_accum_collect(nlist_get(args, i), scope, src, entries)
  }
  0
}

fn cg_loop_accum_collect(node: i64, scope: i64, src: i64, entries: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> { cg_loop_accum_collect(node_f2(node), scope, src, entries) cg_loop_accum_collect(node_f3(node), scope, src, entries) }
      4 -> cg_loop_accum_collect_args(node_f3(node), node_f4(node), scope, src, entries)
      5 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect(node_f2(node), scope, src, entries) cg_loop_accum_collect(node_f3(node), scope, src, entries) }
      6 -> {
        cg_loop_accum_collect(node_f3(node), scope, src, entries)
        let inner_scope = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_accum_collect(node_f4(node), inner_scope, src, entries)
      }
      7 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect(node_f2(node), scope, src, entries) }
      10 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect(node_f2(node), scope, src, entries) }
      11 -> {
        cg_loop_accum_collect(node_f3(node), scope, src, entries)
        let inner_scope = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_accum_collect(node_f4(node), inner_scope, src, entries)
      }
      12 -> {
        cg_loop_accum_collect(node_f3(node), scope, src, entries)
        let candidate = cg_loop_accum_assignment_candidate(node, scope, src)
        if candidate == 0 { 0 }
        else {
          if cg_loop_accum_find(entries, src, node_f1(node), node_f2(node)) == 0 {
            nlist_add(entries, candidate)
          } else { 0 }
        }
      }
      22 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      25 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      26 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      35 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      36 -> {
        let inner = node_f2(node)
        cg_loop_accum_collect_args(node_f3(inner), node_f4(inner), scope, src, entries)
      }
      37 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      41 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect_args(node_f3(node), nlist_len(node_f3(node)), scope, src, entries) }
      45 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      46 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect(node_f2(node), scope, src, entries) }
      47 -> {
        cg_loop_accum_collect(node_f3(node), scope, src, entries)
        let inner_scope = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_accum_collect(node_f4(node), inner_scope, src, entries)
      }
      48 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      49 -> cg_loop_accum_collect(node_f1(node), scope, src, entries)
      52 -> { cg_loop_accum_collect(node_f1(node), scope, src, entries) cg_loop_accum_collect(node_f2(node), scope, src, entries) }
      _ -> 0
    }
  }
}

fn cg_loop_accum_safe_args(args: i64, n: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let mut i = 0
  let mut ok = 1
  while i < n and ok == 1 {
    ok = cg_loop_accum_var_safe(nlist_get(args, i), src, ns, nl)
    i = i + 1
  }
  ok
}

fn cg_loop_accum_var_safe(node: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if node == 0 { 1 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      3 -> if cg_loop_accum_var_safe(node_f2(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f3(node), src, ns, nl) }
      4 -> cg_loop_accum_safe_args(node_f3(node), node_f4(node), src, ns, nl)
      5 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { if cg_loop_accum_var_safe(node_f2(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f3(node), src, ns, nl) } }
      6 -> if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 { 0 } else { if cg_loop_accum_var_safe(node_f3(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f4(node), src, ns, nl) } }
      7 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f2(node), src, ns, nl) }
      10 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f2(node), src, ns, nl) }
      11 -> if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 { 0 } else { if cg_loop_accum_var_safe(node_f3(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f4(node), src, ns, nl) } }
      12 -> {
        if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 {
          cg_while_update_value_matches(node_f3(node), src, ns, nl)
        } else { cg_loop_accum_var_safe(node_f3(node), src, ns, nl) }
      }
      22 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      24 -> 1
      25 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      26 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      35 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      36 -> {
        let inner = node_f2(node)
        cg_loop_accum_safe_args(node_f3(inner), node_f4(inner), src, ns, nl)
      }
      37 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      41 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_safe_args(node_f3(node), nlist_len(node_f3(node)), src, ns, nl) }
      45 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      46 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f2(node), src, ns, nl) }
      47 -> if cg_span_eq(src, node_f1(node), node_f2(node), src, ns, nl) == 1 { 0 } else { if cg_loop_accum_var_safe(node_f3(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f4(node), src, ns, nl) } }
      48 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      49 -> cg_loop_accum_var_safe(node_f1(node), src, ns, nl)
      52 -> if cg_loop_accum_var_safe(node_f1(node), src, ns, nl) != 1 { 0 } else { cg_loop_accum_var_safe(node_f2(node), src, ns, nl) }
      54 -> 1
      _ -> 0
    }
  }
}

fn cg_loop_accum_filter(candidates: i64, body: i64, src: i64) -> i64 {
  let result = nlist_new()
  for i in 0..nlist_len(candidates) {
    let e = nlist_get(candidates, i)
    if cg_loop_accum_var_safe(body, src, cg_loop_accum_entry_ns(e), cg_loop_accum_entry_nl(e)) == 1 {
      nlist_add(result, e)
    } else { 0 }
  }
  result
}

fn cg_loop_accum_candidates(body: i64, scope: i64, src: i64) -> i64 {
  let candidates = nlist_new()
  cg_loop_accum_collect(body, scope, src, candidates)
  cg_loop_accum_filter(candidates, body, src)
}

fn cg_loop_accum_plan(candidates: i64, scope: i64, fm: i64) -> i64 {
  let planned = nlist_new()
  let mut plan_scope = scope
  let mut ok = 1
  let mut i = 0
  while i < nlist_len(candidates) and ok == 1 {
    let e = nlist_get(candidates, i)
    let phys = cg_scope_first_free_loop_accum_phys(plan_scope)
    if phys == 0 {
      ok = 0
    } else {
      let p = cg_loop_accum_entry_new(cg_loop_accum_entry_ns(e), cg_loop_accum_entry_nl(e), cg_loop_accum_entry_rid(e), cg_loop_accum_entry_ty(e))
      cg_loop_accum_entry_set_phys(p, phys)
      nlist_add(planned, p)
      plan_scope = scope_push_typed(plan_scope, cg_loop_accum_entry_ns(p), cg_loop_accum_entry_nl(p), phys, cg_loop_accum_entry_ty(p))
      i = i + 1
    }
  }
  if ok == 1 and nlist_len(planned) > 0 {
    node_new(0, planned, plan_scope, 0, 0)
  } else { 0 }
}

fn cg_loop_accum_plan_entries(plan: i64) -> i64 { node_f1(plan) }
fn cg_loop_accum_plan_scope(plan: i64) -> i64 { node_f2(plan) }

fn cg_loop_accum_emit_loads(plan: i64, code: i64, fm: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let entries = cg_loop_accum_plan_entries(plan)
    for i in 0..nlist_len(entries) {
      let e = nlist_get(entries, i)
      let rid = cg_loop_accum_entry_rid(e)
      let slot = 0 - rid - 1
      bu32(code, cg_ldr(cg_loop_accum_entry_phys(e), 31, slot * 8))
      fmap_inc_loop_accumulator_register_count(fm)
    }
    0
  }
}

fn cg_loop_accum_emit_stores(plan: i64, code: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let entries = cg_loop_accum_plan_entries(plan)
    for i in 0..nlist_len(entries) {
      let e = nlist_get(entries, i)
      cg_store_regid_from_phys(code, cg_loop_accum_entry_rid(e), cg_loop_accum_entry_phys(e))
    }
    0
  }
}

fn cg_loop_addr_recur_entry_new(base_ns: i64, base_nl: i64, idx_ns: i64, idx_nl: i64, base_rid: i64, addr_phys: i64) -> i64 {
  let e = alloc_bump(48)
  __mem_store64(e, base_ns)
  __mem_store64(e + 8, base_nl)
  __mem_store64(e + 16, idx_ns)
  __mem_store64(e + 24, idx_nl)
  __mem_store64(e + 32, base_rid)
  __mem_store64(e + 40, addr_phys)
  e
}

fn cg_loop_addr_recur_base_ns(e: i64) -> i64 { __mem_load64(e) }
fn cg_loop_addr_recur_base_nl(e: i64) -> i64 { __mem_load64(e + 8) }
fn cg_loop_addr_recur_idx_ns(e: i64) -> i64 { __mem_load64(e + 16) }
fn cg_loop_addr_recur_idx_nl(e: i64) -> i64 { __mem_load64(e + 24) }
fn cg_loop_addr_recur_base_rid(e: i64) -> i64 { __mem_load64(e + 32) }
fn cg_loop_addr_recur_addr_phys(e: i64) -> i64 { __mem_load64(e + 40) }

fn cg_loop_addr_recur_find(entries: i64, src: i64, base_ns: i64, base_nl: i64, idx_ns: i64, idx_nl: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let e = nlist_get(entries, i)
    if cg_span_eq(src, cg_loop_addr_recur_base_ns(e), cg_loop_addr_recur_base_nl(e), src, base_ns, base_nl) == 1 {
      if cg_span_eq(src, cg_loop_addr_recur_idx_ns(e), cg_loop_addr_recur_idx_nl(e), src, idx_ns, idx_nl) == 1 {
        found = e
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

fn cg_while_update_assign_unit_increment_matches(assign: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if assign == 0 { 0 }
  else { if node_tag(assign) != 12 { 0 }
  else { if cg_same_name(src, node_f1(assign), node_f2(assign), ns, nl) != 1 { 0 }
  else {
    let val = node_f3(assign)
    if val == 0 { 0 }
    else { if node_tag(val) != 3 { 0 }
    else { if node_f1(val) != 1 { 0 }
    else {
      let lhs = node_f2(val)
      let rhs = node_f3(val)
      if cg_ident_matches(lhs, src, ns, nl) == 1 { cg_int_literal_is(rhs, 1) }
      else { if cg_ident_matches(rhs, src, ns, nl) == 1 { cg_int_literal_is(lhs, 1) } else { 0 } }
    } } }
  } } }
}

fn cg_loop_addr_recur_candidate_from_call(node: i64, scope: i64, src: i64, idx_ns: i64, idx_nl: i64) -> i64 {
  let kind = cg_call_mem64_scaled_kind(node, scope, src)
  if kind == 0 { 0 }
  else {
    let args = node_f3(node)
    let info = cg_mem64_scaled_addr_info(nlist_get(args, 0))
    if info == 0 { 0 }
    else {
      let base = node_f1(info)
      let idx = node_f2(info)
      if base == 0 or idx == 0 { 0 }
      else { if node_tag(base) != 2 or node_tag(idx) != 2 { 0 }
      else { if cg_ident_matches(idx, src, idx_ns, idx_nl) != 1 { 0 }
      else { if cg_ident_matches(base, src, idx_ns, idx_nl) == 1 { 0 }
      else { node_new(0, node_f1(base), node_f2(base), idx_ns, idx_nl) } } } }
    }
  }
}

fn cg_loop_addr_recur_collect_args(args: i64, n: i64, scope: i64, src: i64, idx_ns: i64, idx_nl: i64, entries: i64) -> i64 {
  for i in 0..n {
    cg_loop_addr_recur_collect(nlist_get(args, i), scope, src, idx_ns, idx_nl, entries)
  }
  0
}

fn cg_loop_addr_recur_collect(node: i64, scope: i64, src: i64, idx_ns: i64, idx_nl: i64, entries: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      3 -> { cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries) }
      4 -> {
        let candidate = cg_loop_addr_recur_candidate_from_call(node, scope, src, idx_ns, idx_nl)
        if candidate != 0 {
          nlist_add(entries, candidate)
        } else { 0 }
        cg_loop_addr_recur_collect_args(node_f3(node), node_f4(node), scope, src, idx_ns, idx_nl, entries)
      }
      5 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries) }
      6 -> {
        cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries)
        let inner_scope = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_addr_recur_collect(node_f4(node), inner_scope, src, idx_ns, idx_nl, entries)
      }
      7 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) }
      10 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) }
      11 -> {
        cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries)
        let inner_scope2 = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_addr_recur_collect(node_f4(node), inner_scope2, src, idx_ns, idx_nl, entries)
      }
      12 -> cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries)
      22 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      25 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      26 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      35 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      36 -> {
        let inner = node_f2(node)
        cg_loop_addr_recur_collect_args(node_f3(inner), node_f4(inner), scope, src, idx_ns, idx_nl, entries)
      }
      37 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      41 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect_args(node_f3(node), nlist_len(node_f3(node)), scope, src, idx_ns, idx_nl, entries) }
      45 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      46 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) }
      47 -> {
        cg_loop_addr_recur_collect(node_f3(node), scope, src, idx_ns, idx_nl, entries)
        let inner_scope3 = scope_push(scope, node_f1(node), node_f2(node), 0)
        cg_loop_addr_recur_collect(node_f4(node), inner_scope3, src, idx_ns, idx_nl, entries)
      }
      48 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      49 -> cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries)
      52 -> { cg_loop_addr_recur_collect(node_f1(node), scope, src, idx_ns, idx_nl, entries) cg_loop_addr_recur_collect(node_f2(node), scope, src, idx_ns, idx_nl, entries) }
      _ -> 0
    }
  }
}

fn cg_loop_addr_recur_candidate_count(entries: i64, src: i64, base_ns: i64, base_nl: i64, idx_ns: i64, idx_nl: i64) -> i64 {
  let mut i = 0
  let mut count = 0
  while i < nlist_len(entries) {
    let e = nlist_get(entries, i)
    if cg_span_eq(src, node_f1(e), node_f2(e), src, base_ns, base_nl) == 1 {
      if cg_span_eq(src, node_f3(e), node_f4(e), src, idx_ns, idx_nl) == 1 {
        count = count + 1
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  count
}

fn cg_loop_addr_recur_candidates_checked(cond: i64, body: i64, extra: i64, scope: i64, src: i64, idx_ns: i64, idx_nl: i64) -> i64 {
  let result = nlist_new()
  let collected = nlist_new()
  cg_loop_addr_recur_collect(body, scope, src, idx_ns, idx_nl, collected)
  let mut i = 0
  while i < nlist_len(collected) {
    let c = nlist_get(collected, i)
    let base_ns = node_f1(c)
    let base_nl = node_f2(c)
    let base_rid = scope_lookup(scope, src, base_ns, base_nl)
    let base_ty = scope_lookup_type(scope, src, base_ns, base_nl)
    if cg_loop_addr_recur_candidate_count(result, src, base_ns, base_nl, idx_ns, idx_nl) == 0 and cg_loop_addr_recur_candidate_count(collected, src, base_ns, base_nl, idx_ns, idx_nl) >= 2 and base_rid != 0 - 999 and base_ty != 0 and ty_eq(base_ty, ty_i64()) == 1 {
      if cg_expr_has_name_write_or_bind(cond, src, base_ns, base_nl) == 0 and cg_expr_has_name_write_or_bind(body, src, base_ns, base_nl) == 0 and cg_expr_has_name_write_or_bind(extra, src, base_ns, base_nl) == 0 {
        nlist_add(result, c)
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  result
}

fn cg_loop_addr_recur_candidates(cond: i64, body: i64, update_assign: i64, scope: i64, src: i64, idx_ns: i64, idx_nl: i64) -> i64 {
  if cg_while_update_assign_unit_increment_matches(update_assign, src, idx_ns, idx_nl) != 1 { nlist_new() }
  else { cg_loop_addr_recur_candidates_checked(cond, body, update_assign, scope, src, idx_ns, idx_nl) }
}

fn cg_scope_reserve_phys(scope: i64, phys: i64) -> i64 {
  scope_push_typed(scope, 0, 0, phys, ty_i64())
}

fn cg_loop_addr_recur_plan(candidates: i64, scope: i64, src: i64) -> i64 {
  let planned = nlist_new()
  let mut plan_scope = scope
  let mut i = 0
  while i < nlist_len(candidates) and nlist_len(planned) < 1 {
    let c = nlist_get(candidates, i)
    let phys = cg_scope_first_free_pinned_phys(plan_scope)
    if phys != 0 {
      let base_rid = scope_lookup(plan_scope, src, node_f1(c), node_f2(c))
      let e = cg_loop_addr_recur_entry_new(node_f1(c), node_f2(c), node_f3(c), node_f4(c), base_rid, phys)
      nlist_add(planned, e)
      plan_scope = cg_scope_reserve_phys(plan_scope, phys)
    } else { 0 }
    i = i + 1
  }
  if nlist_len(planned) > 0 { node_new(0, planned, plan_scope, 0, 0) } else { 0 }
}

fn cg_loop_addr_recur_plan_entries(plan: i64) -> i64 { node_f1(plan) }
fn cg_loop_addr_recur_plan_scope(plan: i64) -> i64 { node_f2(plan) }

fn cg_loop_addr_recur_emit_inits(plan: i64, code: i64, idx_phys: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let entries = cg_loop_addr_recur_plan_entries(plan)
    for i in 0..nlist_len(entries) {
      let e = nlist_get(entries, i)
      let addr_phys = cg_loop_addr_recur_addr_phys(e)
      let base_phys = emit_load_reg_id(code, cg_loop_addr_recur_base_rid(e), addr_phys)
      if base_phys != addr_phys { bu32(code, encode_add_imm(addr_phys, base_phys, 0)) } else { 0 }
      bu32(code, encode_add_imm(14, idx_phys, 0))
      bu32(code, encode_add_reg(14, 14, 14))
      bu32(code, encode_add_reg(14, 14, 14))
      bu32(code, encode_add_reg(14, 14, 14))
      bu32(code, encode_add_reg(addr_phys, addr_phys, 14))
    }
    0
  }
}

fn cg_loop_addr_recur_emit_steps(plan: i64, code: i64) -> i64 {
  if plan == 0 { 0 }
  else {
    let entries = cg_loop_addr_recur_plan_entries(plan)
    for i in 0..nlist_len(entries) {
      let e = nlist_get(entries, i)
      bu32(code, encode_add_imm(cg_loop_addr_recur_addr_phys(e), cg_loop_addr_recur_addr_phys(e), 8))
    }
    0
  }
}

fn cg_store_regid_from_phys(code: i64, rid: i64, phys: i64) -> i64 {
  if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_str(phys, 31, slot * 8))
  } else {
    bu32(code, encode_add_imm(rid, phys, 0))
  }
}

fn cg_while_try_induction_register(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  let cond = node_f1(node)
  let body = node_f2(node)
  let split = cg_while_induction_split_body(body, src)
  if split == 0 { 0 - 1 }
  else {
    let ns = node_f1(split)
    let nl = node_f2(split)
    let update_assign = node_f3(split)
    let user_body = node_f4(split)
    let var_rid = scope_lookup(scope, src, ns, nl)
    let var_ty = scope_lookup_type(scope, src, ns, nl)
    if var_rid >= 0 { 0 - 1 }
    else { if var_ty == 0 { 0 - 1 }
    else { if ty_eq(var_ty, ty_i64()) != 1 { 0 - 1 }
    else { if cg_expr_mentions_name(cond, src, ns, nl) != 1 { 0 - 1 }
    else { if cg_expr_has_name_write_or_bind(user_body, src, ns, nl) == 1 { 0 - 1 }
    else { if cg_expr_has_break(user_body) == 1 { 0 - 1 }
    else {
      let idx_res = cg_vreg_reserve_counter_floor(scope, ctr, floor, fm)
      let idx_phys = cg_vreg_reservation_phys(idx_res)
      if idx_phys == 0 { 0 - 1 }
      else {
        let idx_slot = 0 - var_rid - 1
        bu32(code, cg_ldr(idx_phys, 31, idx_slot * 8))
        let loop_scope = scope_push_typed(scope, ns, nl, idx_phys, var_ty)
        let old_loop_start = __mem_load64(fm + 56)
        let old_break_patches = __mem_load64(fm + 64)
        let old_loop_cleanup_depth = __mem_load64(fm + 152)
        let old_loop_result_ctr = fmap_loop_result_ctr(fm)
        let old_vector_bounds_top = fmap_vector_bounds_top(fm)
        let old_vector_data_top = fmap_vector_data_top(fm)
        let old_vector_push_proof_top = fmap_vector_push_proof_top(fm)
        let old_loop_addr_recur_top = fmap_loop_addr_recur_top(fm)
        let accum_candidates = cg_loop_accum_candidates(user_body, loop_scope, src)
        let accum_plan = cg_loop_accum_plan(accum_candidates, loop_scope, fm)
        cg_loop_accum_emit_loads(accum_plan, code, fm)
        let accum_scope = if accum_plan == 0 { loop_scope } else { cg_loop_accum_plan_scope(accum_plan) }
        let addr_recur_candidates = cg_loop_addr_recur_candidates(cond, user_body, update_assign, accum_scope, src, ns, nl)
        let addr_recur_plan = cg_loop_addr_recur_plan(addr_recur_candidates, accum_scope, src)
        cg_loop_addr_recur_emit_inits(addr_recur_plan, code, idx_phys)
        let recur_scope = if addr_recur_plan == 0 { accum_scope } else { cg_loop_addr_recur_plan_scope(addr_recur_plan) }
        let hoist_candidates = cg_vector_data_loop_candidates(cond, user_body, recur_scope, src, fm)
        let body_base_ctr = cg_counter_for_hoists_and_expr(recur_scope, ctr, nlist_len(hoist_candidates), cond, src, fm)
        let loop_ctr = cg_vector_data_emit_loop_hoists(hoist_candidates, code, recur_scope, src, body_base_ctr, fm)
        let push_proofs = cg_vector_push_loop_proofs(cond, user_body, recur_scope, src, fm)
        cg_vector_push_activate_loop_proofs(fm, push_proofs)
        let loop_start = buf_len(code)
        let break_patches = nlist_new()
        __mem_store64(fm + 56, loop_start)
        __mem_store64(fm + 64, break_patches)
        __mem_store64(fm + 152, cg_cleanup_count(fm))
        fmap_set_loop_result_ctr(fm, 0 - 1)
        let direct_branch = cg_direct_branch_false_floor(cond, code, recur_scope, src, loop_ctr, fm, floor)
        let mut cond_phys = 0
        let mut branch_pos = 0
        let mut body_ctr = loop_ctr
        if direct_branch == 0 {
          let c1 = cg_expr(cond, code, recur_scope, src, loop_ctr, fm)
          cond_phys = emit_load_reg(code, c1 - 1)
          branch_pos = buf_len(code)
          bu32(code, 0)
          body_ctr = c1
        } else {
          branch_pos = node_f1(direct_branch)
          body_ctr = node_f2(direct_branch)
        }
        cg_vector_bound_push_from_cond(fm, cond, user_body, recur_scope, src)
        if addr_recur_plan != 0 { fmap_set_loop_addr_recur_top(fm, cg_loop_addr_recur_plan_entries(addr_recur_plan)) } else { 0 }
        let body_start_ctr = cg_counter_for_expr(recur_scope, body_ctr, user_body, src, fm)
        cg_expr(user_body, code, recur_scope, src, body_start_ctr, fm)
        if addr_recur_plan != 0 { fmap_set_loop_addr_recur_top(fm, old_loop_addr_recur_top) } else { 0 }
        fmap_set_vector_bounds_top(fm, old_vector_bounds_top)
        fmap_set_vector_data_top(fm, old_vector_data_top)
        fmap_set_vector_push_proof_top(fm, old_vector_push_proof_top)
        if cg_assignment_preserves_existing_nonnegative(fm, update_assign, src) != 1 {
          fmap_set_nonnegative_top(fm, 0)
        } else { 0 }
        let update_ctr = cg_counter_for_expr(recur_scope, loop_ctr, node_f3(update_assign), src, fm)
        let c_update = cg_expr(node_f3(update_assign), code, recur_scope, src, update_ctr, fm)
        let update_phys = emit_load_reg(code, c_update - 1)
        bu32(code, encode_add_imm(idx_phys, update_phys, 0))
        cg_loop_addr_recur_emit_steps(addr_recur_plan, code)
        let b_pos = buf_len(code)
        bu32(code, encode_b(loop_start - b_pos))
        let store_start = buf_len(code)
        if direct_branch == 0 {
          cg_patch_cbz(code, branch_pos, cond_phys, store_start)
        } else {
          cg_patch_branch_cond_list(code, branch_pos, store_start)
        }
        cg_patch_breaks(code, break_patches, store_start)
        cg_loop_accum_emit_stores(accum_plan, code)
        cg_store_regid_from_phys(code, var_rid, idx_phys)
        __mem_store64(fm + 56, old_loop_start)
        __mem_store64(fm + 64, old_break_patches)
        __mem_store64(fm + 152, old_loop_cleanup_depth)
        fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
        fmap_set_loop_addr_recur_top(fm, old_loop_addr_recur_top)
        fmap_inc_while_induction_register_count(fm)
        cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
      }
    } } } } } }
  }
}

fn cg_scope_uses_phys(scope: i64, phys: i64) -> i64 {
  let mut cur = scope
  let mut found = 0
  while cur != 0 {
    if __mem_load64(cur + 16) == phys {
      found = 1
      cur = 0
    } else {
      cur = __mem_load64(cur + 24)
    }
  }
  found
}

fn cg_counter_phys_min() -> i64 { 19 }
fn cg_counter_phys_max() -> i64 { 26 }
fn cg_scratch_phys_min() -> i64 { cg_counter_phys_min() }
fn cg_scratch_phys_max() -> i64 { 20 }
fn cg_pinned_phys_min() -> i64 { cg_scratch_phys_max() + 1 }
fn cg_pinned_phys_max() -> i64 { cg_counter_phys_max() }

fn cg_counter_to_phys(ctr: i64) -> i64 {
  ctr + cg_counter_phys_min()
}

fn cg_phys_is_counter(phys: i64) -> i64 {
  if phys >= cg_counter_phys_min() and phys <= cg_counter_phys_max() { 1 } else { 0 }
}

fn cg_phys_is_scratch(phys: i64) -> i64 {
  if phys >= cg_scratch_phys_min() and phys <= cg_scratch_phys_max() { 1 } else { 0 }
}

fn cg_phys_is_pinned(phys: i64) -> i64 {
  if phys >= cg_pinned_phys_min() and phys <= cg_pinned_phys_max() { 1 } else { 0 }
}

fn cg_phys_to_counter(phys: i64) -> i64 {
  phys - cg_counter_phys_min()
}

fn cg_scope_first_free_phys_between(scope: i64, phys: i64, min_phys: i64) -> i64 {
  if phys < min_phys { 0 }
  else {
    if cg_scope_uses_phys(scope, phys) == 0 { phys }
    else { cg_scope_first_free_phys_between(scope, phys - 1, min_phys) }
  }
}

fn cg_scope_first_free_pinned_phys(scope: i64) -> i64 {
  cg_scope_first_free_phys_between(scope, cg_pinned_phys_max(), cg_pinned_phys_min())
}

fn cg_scope_first_free_phys_between_low(scope: i64, phys: i64, max_phys: i64) -> i64 {
  if phys > max_phys { 0 }
  else {
    if cg_scope_uses_phys(scope, phys) == 0 { phys }
    else { cg_scope_first_free_phys_between_low(scope, phys + 1, max_phys) }
  }
}

fn cg_scope_first_free_loop_accum_phys(scope: i64) -> i64 {
  cg_scope_first_free_phys_between_low(scope, cg_counter_phys_min(), cg_counter_phys_max())
}

fn cg_vreg_reason_natural() -> i64 { 0 }
fn cg_vreg_reason_scope_collision() -> i64 { 1 }
fn cg_vreg_reason_spill_counter() -> i64 { 2 }
fn cg_vreg_reason_no_free() -> i64 { 3 }

fn cg_vreg_reservation_new(phys: i64, reason: i64, natural_phys: i64) -> i64 {
  let r = alloc_bump(24)
  __mem_store64(r, phys)
  __mem_store64(r + 8, reason)
  __mem_store64(r + 16, natural_phys)
  r
}

fn cg_vreg_reservation_phys(r: i64) -> i64 { __mem_load64(r) }
fn cg_vreg_reservation_reason(r: i64) -> i64 { __mem_load64(r + 8) }
fn cg_vreg_reservation_natural_phys(r: i64) -> i64 { __mem_load64(r + 16) }

fn cg_vreg_record_reservation(fm: i64, reason: i64) -> i64 {
  match reason {
    1 -> { fmap_inc_register_pinned_count(fm) fmap_inc_register_scope_collision_count(fm) }
    2 -> { fmap_inc_register_pinned_count(fm) fmap_inc_register_spill_counter_count(fm) }
    3 -> fmap_inc_register_no_free_count(fm)
    _ -> 0
  }
}

fn cg_vreg_reserve_counter(scope: i64, ctr: i64, fm: i64) -> i64 {
  if ctr < 8 {
    let natural_phys = cg_counter_to_phys(ctr)
    if cg_scope_uses_phys(scope, natural_phys) == 0 { cg_vreg_reservation_new(natural_phys, cg_vreg_reason_natural(), natural_phys) }
    else {
      let pinned = cg_scope_first_free_pinned_phys(scope)
      let reason = if pinned == 0 { cg_vreg_reason_no_free() } else { cg_vreg_reason_scope_collision() }
      cg_vreg_record_reservation(fm, reason)
      cg_vreg_reservation_new(pinned, reason, natural_phys)
    }
  } else {
    let pinned = cg_scope_first_free_pinned_phys(scope)
    let reason = if pinned == 0 { cg_vreg_reason_no_free() } else { cg_vreg_reason_spill_counter() }
    cg_vreg_record_reservation(fm, reason)
    cg_vreg_reservation_new(pinned, reason, 0)
  }
}

fn cg_vreg_reserve_counter_floor(scope: i64, ctr: i64, floor: i64, fm: i64) -> i64 {
  if ctr >= 8 and floor >= 0 and floor < 8 {
    let mut cur = floor
    let mut found = 0
    while cur < 8 and found == 0 {
      let phys = cg_counter_to_phys(cur)
      if cg_scope_uses_phys(scope, phys) == 0 { found = phys }
      else { cur = cur + 1 }
    }
    if found != 0 {
      cg_vreg_reservation_new(found, cg_vreg_reason_natural(), found)
    } else {
      cg_vreg_reserve_counter(scope, ctr, fm)
    }
  } else {
    cg_vreg_reserve_counter(scope, ctr, fm)
  }
}

fn cg_counter_after_scope(scope: i64, ctr: i64) -> i64 {
  -- Nested expression codegen must not allocate any counter that maps to a live scope register.
  if ctr >= 8 { ctr }
  else {
    let mut cur = scope
    let mut next = ctr
    while cur != 0 {
      let rid = __mem_load64(cur + 16)
      if cg_phys_is_counter(rid) == 1 {
        let used_ctr = cg_phys_to_counter(rid)
        if used_ctr >= next { next = used_ctr + 1 } else { 0 }
      } else { 0 }
      cur = __mem_load64(cur + 24)
    }
    next
  }
}

fn cg_counter_width_unknown() -> i64 { 9 }

fn cg_counter_width_cap(width: i64) -> i64 {
  if width > 8 { cg_counter_width_unknown() } else { width }
}

fn cg_counter_width_add(a: i64, b: i64) -> i64 {
  if a >= cg_counter_width_unknown() or b >= cg_counter_width_unknown() { cg_counter_width_unknown() }
  else { cg_counter_width_cap(a + b) }
}

fn cg_counter_width_max(a: i64, b: i64) -> i64 {
  if a >= cg_counter_width_unknown() or b >= cg_counter_width_unknown() { cg_counter_width_unknown() }
  else { if a > b { a } else { b } }
}

fn cg_counter_width_binop(lhs_width: i64, rhs_width: i64) -> i64 {
  if lhs_width >= cg_counter_width_unknown() or rhs_width >= cg_counter_width_unknown() { cg_counter_width_unknown() }
  else {
    let rhs_live_width = rhs_width + 1
    cg_counter_width_cap(if lhs_width > rhs_live_width { lhs_width } else { rhs_live_width })
  }
}

fn cg_expr_counter_width(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { cg_counter_width_unknown() }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> 1
      2 -> 1
      3 -> {
        if node_f1(node) == 12 or node_f1(node) == 13 { cg_counter_width_unknown() }
        else { if cg_binop_uses_f64(node, scope, src, fm) == 1 { cg_counter_width_unknown() }
        else { cg_counter_width_binop(cg_expr_counter_width(node_f2(node), scope, src, fm), cg_expr_counter_width(node_f3(node), scope, src, fm)) } }
      }
      5 -> {
        let cond_width = cg_expr_counter_width(node_f1(node), scope, src, fm)
        let then_width = cg_expr_counter_width(node_f2(node), scope, src, fm)
        let else_width = cg_expr_counter_width(node_f3(node), scope, src, fm)
        cg_counter_width_max(cond_width, cg_counter_width_max(then_width, else_width))
      }
      7 -> cg_counter_width_max(cg_expr_counter_width(node_f1(node), scope, src, fm), cg_expr_counter_width(node_f2(node), scope, src, fm))
      12 -> cg_expr_counter_width(node_f3(node), scope, src, fm)
      22 -> cg_expr_counter_width(node_f1(node), scope, src, fm)
      24 -> 1
      37 -> cg_expr_counter_width(node_f1(node), scope, src, fm)
      51 -> 1
      54 -> 1
      _ -> cg_counter_width_unknown()
    }
  }
}

fn cg_counter_window_free_with_hidden(scope: i64, ctr: i64, width: i64, hidden_mask: i64) -> i64 {
  if ctr < 0 or ctr >= 8 or width <= 0 or ctr + width > 8 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < width and ok == 1 {
      if cg_mask_has(hidden_mask, ctr + i) == 1 {
        ok = 0
      } else {
        if cg_scope_uses_phys(scope, cg_counter_to_phys(ctr + i)) == 1 {
          ok = 0
        } else { i = i + 1 }
      }
    }
    ok
  }
}

fn cg_counter_window_free(scope: i64, ctr: i64, width: i64) -> i64 {
  cg_counter_window_free_with_hidden(scope, ctr, width, 0)
}

fn cg_counter_after_scope_window_from(scope: i64, start_ctr: i64, fallback: i64, width: i64, fm: i64) -> i64 {
  cg_counter_after_scope_window_from_hidden(scope, start_ctr, fallback, width, 0, fm)
}

fn cg_counter_after_scope_window_from_hidden(scope: i64, start_ctr: i64, fallback: i64, width: i64, hidden_mask: i64, fm: i64) -> i64 {
  if start_ctr >= 8 or width <= 0 or width >= cg_counter_width_unknown() or width > 8 { fallback }
  else {
    let mut start = start_ctr
    let limit = 8 - width
    let mut found = 0 - 1
    while start <= limit and found < 0 {
      if cg_counter_window_free_with_hidden(scope, start, width, hidden_mask) == 1 {
        found = start
      } else { start = start + 1 }
    }
    if found >= 0 {
      if found < fallback and fm != 0 { fmap_inc_register_window_reuse_count(fm) } else { 0 }
      found
    } else { fallback }
  }
}

fn cg_counter_after_scope_window(scope: i64, ctr: i64, width: i64, fm: i64) -> i64 {
  let fallback = cg_counter_after_scope(scope, ctr)
  cg_counter_after_scope_window_from(scope, ctr, fallback, width, fm)
}

fn cg_counter_after_scope_boundary_window(scope: i64, ctr: i64, width: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window_hidden(scope, ctr, width, 0, fm)
}

fn cg_counter_after_scope_boundary_window_hidden(scope: i64, ctr: i64, width: i64, hidden_mask: i64, fm: i64) -> i64 {
  let fallback = cg_counter_after_scope(scope, ctr)
  let start_ctr = if ctr >= 8 { 0 } else { ctr }
  cg_counter_after_scope_window_from_hidden(scope, start_ctr, fallback, width, hidden_mask, fm)
}

fn cg_counter_for_expr(scope: i64, ctr: i64, expr: i64, src: i64, fm: i64) -> i64 {
  cg_counter_after_scope_window(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), fm)
}

fn cg_counter_for_expr_boundary(scope: i64, ctr: i64, expr: i64, src: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), fm)
}

fn cg_counter_for_expr_boundary_hidden(scope: i64, ctr: i64, expr: i64, src: i64, hidden_mask: i64, fm: i64) -> i64 {
  cg_counter_after_scope_boundary_window_hidden(scope, ctr, cg_expr_counter_width(expr, scope, src, fm), hidden_mask, fm)
}

fn cg_counter_for_hoists_and_expr(scope: i64, ctr: i64, hoist_count: i64, expr: i64, src: i64, fm: i64) -> i64 {
  let expr_width = cg_expr_counter_width(expr, scope, src, fm)
  let width = if hoist_count > 0 { cg_counter_width_add(hoist_count, expr_width) } else { expr_width }
  cg_counter_after_scope_window(scope, ctr, width, fm)
}

fn cg_for_range_incr_matches(incr: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if incr == 0 { 0 }
  else { if node_tag(incr) != 12 { 0 }
  else { if cg_same_name(src, node_f1(incr), node_f2(incr), ns, nl) != 1 { 0 }
  else {
    let val = node_f3(incr)
    if val == 0 { 0 }
    else { if node_tag(val) != 3 { 0 }
    else { if node_f1(val) != 1 { 0 }
    else { if cg_ident_matches(node_f2(val), src, ns, nl) != 1 { 0 }
    else {
      let rhs = node_f3(val)
      if rhs == 0 { 0 }
      else { if node_tag(rhs) == 1 and node_f1(rhs) == 1 { 1 } else { 0 } }
    } } } }
  } } }
}

fn cg_for_range_user_body(loop_body: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if loop_body == 0 { 0 }
  else { if node_tag(loop_body) != 7 { 0 }
  else {
    let body_index = node_f1(loop_body)
    let incr = node_f2(loop_body)
    if cg_for_range_incr_matches(incr, src, ns, nl) != 1 { 0 }
    else { if body_index == 0 { 0 }
    else { if node_tag(body_index) != 6 { 0 }
    else { if cg_same_name(src, node_f1(body_index), node_f2(body_index), ns, nl) != 1 { 0 }
    else { if cg_ident_matches(node_f3(body_index), src, ns, nl) != 1 { 0 }
    else { node_f4(body_index) } } } } }
  } }
}

fn cg_let_mut_for_range_end(node: i64, src: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let body = node_f4(node)
  if body == 0 { 0 }
  else { if node_tag(body) != 10 { 0 }
  else {
    let cond = node_f1(body)
    if cond == 0 { 0 }
    else { if node_tag(cond) != 3 { 0 }
    else { if node_f1(cond) != 7 { 0 }
    else { if cg_ident_matches(node_f2(cond), src, ns, nl) != 1 { 0 }
    else { node_f3(cond) } } } }
  } }
}

fn cg_let_mut_try_for_range_loop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, binding_ty: i64, floor: i64) -> i64 {
  if binding_ty == 0 { 0 - 1 }
  else { if ty_eq(binding_ty, ty_i64()) != 1 { 0 - 1 }
  else {
    let ns = node_f1(node)
    let nl = node_f2(node)
    let start = node_f3(node)
    let while_node = node_f4(node)
    let end = cg_let_mut_for_range_end(node, src)
    if end == 0 { 0 - 1 }
    else { if while_node == 0 or node_tag(while_node) != 10 { 0 - 1 }
    else {
      let cond = node_f1(while_node)
      let loop_body = node_f2(while_node)
      let user_body = cg_for_range_user_body(loop_body, src, ns, nl)
      if user_body == 0 { 0 - 1 }
      else {
        let idx_res = cg_vreg_reserve_counter_floor(scope, ctr, floor, fm)
        let idx_phys = cg_vreg_reservation_phys(idx_res)
        if idx_phys == 0 { 0 - 1 }
        else {
          let reserved_scope = scope_push_typed(scope, ns, nl, idx_phys, binding_ty)
          let start_ctr = cg_counter_for_expr(reserved_scope, ctr, start, src, fm)
          let c_start = cg_expr(start, code, scope, src, start_ctr, fm)
          let start_phys = emit_load_reg(code, c_start - 1)
          bu32(code, encode_add_imm(idx_phys, start_phys, 0))
          let idx_rid = idx_phys
          let loop_scope = reserved_scope
          let old_loop_start = __mem_load64(fm + 56)
          let old_break_patches = __mem_load64(fm + 64)
          let old_loop_cleanup_depth = __mem_load64(fm + 152)
          let old_loop_result_ctr = fmap_loop_result_ctr(fm)
          let old_vector_bounds_top = fmap_vector_bounds_top(fm)
          let old_vector_data_top = fmap_vector_data_top(fm)
          let old_vector_push_proof_top = fmap_vector_push_proof_top(fm)
          let old_nonnegative_top = fmap_nonnegative_top(fm)
          let old_loop_addr_recur_top = fmap_loop_addr_recur_top(fm)
          if cg_expr_is_nonnegative_i64_literal(start) == 1 { cg_nonnegative_push(fm, src, ns, nl) } else { 0 }
          let accum_candidates = cg_loop_accum_candidates(user_body, loop_scope, src)
          let accum_plan = cg_loop_accum_plan(accum_candidates, loop_scope, fm)
          cg_loop_accum_emit_loads(accum_plan, code, fm)
          let accum_scope = if accum_plan == 0 { loop_scope } else { cg_loop_accum_plan_scope(accum_plan) }
          let addr_recur_candidates = cg_loop_addr_recur_candidates_checked(cond, user_body, end, accum_scope, src, ns, nl)
          let addr_recur_plan = cg_loop_addr_recur_plan(addr_recur_candidates, accum_scope, src)
          cg_loop_addr_recur_emit_inits(addr_recur_plan, code, idx_phys)
          let recur_scope = if addr_recur_plan == 0 { accum_scope } else { cg_loop_addr_recur_plan_scope(addr_recur_plan) }
          let hoist_candidates = cg_vector_data_loop_candidates(cond, loop_body, recur_scope, src, fm)
          let body_base_ctr = cg_counter_for_hoists_and_expr(recur_scope, ctr, nlist_len(hoist_candidates), end, src, fm)
          let loop_ctr = cg_vector_data_emit_loop_hoists(hoist_candidates, code, recur_scope, src, body_base_ctr, fm)
          let push_proofs = cg_vector_push_loop_proofs(cond, loop_body, recur_scope, src, fm)
          cg_vector_push_activate_loop_proofs(fm, push_proofs)
          let loop_start = buf_len(code)
          let break_patches = nlist_new()
          __mem_store64(fm + 56, loop_start)
          __mem_store64(fm + 64, break_patches)
          __mem_store64(fm + 152, cg_cleanup_count(fm))
          fmap_set_loop_result_ctr(fm, ctr)
          let c_end = cg_expr(end, code, recur_scope, src, loop_ctr, fm)
          let end_phys = emit_load_reg(code, c_end - 1)
          bu32(code, encode_cmp(idx_phys, end_phys))
          let branch_pos = buf_len(code)
          bu32(code, 0)
          cg_vector_bound_push_from_cond(fm, cond, loop_body, recur_scope, src)
          let body_scope = scope_push_typed(recur_scope, ns, nl, idx_rid, binding_ty)
          if addr_recur_plan != 0 { fmap_set_loop_addr_recur_top(fm, cg_loop_addr_recur_plan_entries(addr_recur_plan)) } else { 0 }
          let body_start_ctr = cg_counter_for_expr(body_scope, loop_ctr, user_body, src, fm)
          cg_expr(user_body, code, body_scope, src, body_start_ctr, fm)
          if addr_recur_plan != 0 { fmap_set_loop_addr_recur_top(fm, old_loop_addr_recur_top) } else { 0 }
          fmap_set_vector_bounds_top(fm, old_vector_bounds_top)
          fmap_set_vector_data_top(fm, old_vector_data_top)
          fmap_set_vector_push_proof_top(fm, old_vector_push_proof_top)
          bu32(code, encode_add_imm(idx_phys, idx_phys, 1))
          cg_loop_addr_recur_emit_steps(addr_recur_plan, code)
          let b_pos = buf_len(code)
          bu32(code, encode_b(loop_start - b_pos))
          let after_loop = buf_len(code)
          cg_patch_b_cond(code, branch_pos, cg_direct_branch_false_cond_for_op(7), after_loop)
          cg_patch_breaks(code, break_patches, after_loop)
          cg_loop_accum_emit_stores(accum_plan, code)
          __mem_store64(fm + 56, old_loop_start)
          __mem_store64(fm + 64, old_break_patches)
          __mem_store64(fm + 152, old_loop_cleanup_depth)
          fmap_set_loop_result_ctr(fm, old_loop_result_ctr)
          fmap_set_nonnegative_top(fm, old_nonnegative_top)
          fmap_set_loop_addr_recur_top(fm, old_loop_addr_recur_top)
          fmap_inc_range_loop_register_count(fm)
          cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
        }
      }
    } }
  } }
}

-- LetMut: like Let but forces value to a spill slot for reassignment
fn cg_let_mut(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  cg_let_mut_with_type(node, code, scope, src, ctr, fm, cg_expr_type(node_f3(node), scope, src, fm), 0 - 1)
}

fn cg_let_mut_with_type(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, binding_ty: i64, floor: i64) -> i64 {
  let body_floor = if floor >= 0 { floor } else { ctr }
  let range_loop = cg_let_mut_try_for_range_loop(node, code, scope, src, ctr, fm, binding_ty, body_floor)
  if range_loop >= 0 { range_loop } else {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let depth = cg_cleanup_count(fm)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  -- Force to a spill slot so assignment can overwrite it
  let val_phys = emit_load_reg(code, c1 - 1)
  -- Use counter 8+ to guarantee a spill slot
  let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
  bu32(code, encode_add_imm(17, val_phys, 0))
  emit_store_reg(code, mut_ctr, 17)
  let val_rid = reg_id(mut_ctr)
  if cg_ty_is_managed(binding_ty) == 1 {
    cg_record_rc_reuse_body_candidate(fm, binding_ty, val, body, scope, src, ns, nl)
    if cg_expr_is_borrow_for_ty(binding_ty, val, scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, binding_ty, val_rid)
    } else { 0 }
    cg_cleanup_push_for_ty_sized(fm, binding_ty, val_rid, cg_managed_cleanup_release_size_for_expr(binding_ty, val, scope, src, fm))
  } else { 0 }
  let new_scope = scope_push_typed(scope, ns, nl, val_rid, binding_ty)
  let old_nonnegative_top = fmap_nonnegative_top(fm)
  if cg_expr_is_nonnegative_i64_literal(val) == 1 { cg_nonnegative_push(fm, src, ns, nl) } else { 0 }
  let br = cg_expr_floor(body, code, new_scope, src, mut_ctr + 1, fm, body_floor)
  fmap_set_nonnegative_top(fm, old_nonnegative_top)
  if cg_ty_is_managed(binding_ty) == 1 {
    let save_ctr = br
    cg_match_store_result(code, save_ctr, br)
    if cg_expr_is_borrow_for_ty(binding_ty, body, new_scope, src, fm) == 1 {
      cg_emit_managed_retain_regid(code, fm, binding_ty, reg_id(save_ctr))
    } else { 0 }
    cg_emit_cleanups_to_depth(code, src, save_ctr + 1, fm, depth)
    cg_cleanup_restore(fm, depth)
    cg_match_store_result(code, ctr, save_ctr + 1)
    ctr + 1
  } else { br }
  }
}

-- Assignment: write new value to mutable variable's spill slot
fn cg_assign(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  let var_rid = scope_lookup(scope, src, ns, nl)
  let var_ty = scope_lookup_type(scope, src, ns, nl)
  if var_rid == 0 - 999 {
    eprint_span(src, ns)
    eprint("error: assignment to undefined variable: ")
    sys_write(2, src + ns, nl)
    eprint("\n")
    c1
  } else {
    let val_rid = reg_id(c1 - 1)
    if cg_assignment_preserves_existing_nonnegative(fm, node, src) != 1 {
      fmap_set_nonnegative_top(fm, 0)
    } else { 0 }
    if cg_vector_data_find(fm, src, ns, nl) >= 0 {
      fmap_set_vector_data_top(fm, 0)
    } else { 0 }
    cg_vector_facts_invalidate(fm)
    if cg_ty_is_managed(var_ty) == 1 {
      if cg_expr_is_borrow_for_ty(var_ty, val, scope, src, fm) == 1 {
        cg_emit_managed_retain_regid(code, fm, var_ty, val_rid)
      } else { 0 }
      cg_emit_managed_release_regid(code, fm, var_ty, var_rid)
    } else { 0 }
    let val_phys = emit_load_reg(code, c1 - 1)
    if var_rid < 0 {
      let slot = 0 - var_rid - 1
      bu32(code, cg_str(val_phys, 31, slot * 8))
    } else {
      bu32(code, encode_add_imm(var_rid, val_phys, 0))
    }
    c1
  }
}

-- Block: evaluate first for side effects, then evaluate and return rest
-- Record construction: allocate num_fields * 8 bytes, store each field value
fn cg_record_init(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let type_ns = node_f1(node)
  let type_nl = node_f2(node)
  let fields = node_f3(node)
  let nfields = node_f4(node)
  -- Allocate nfields * 8 bytes using __bump_alloc inline
  let size = nfields * 8
  emit_mov_imm(code, 0, size)
  cg_bump_alloc_reg(code, 17, 0)
  -- Result (record ptr) in x17. Store to ctr register.
  if ctr < 8 {
    let e3 = encode_add_imm(ctr + 19, 17, 0)
    bu32(code, e3)
  } else {
    emit_store_reg(code, ctr, 17)
  }
  -- Store each field value. Pack base_ctr and i: base*256+i
  -- Fields use temporary registers but the RECORD POINTER is the result
  let record_info = node_new(0, ctr, type_ns, type_nl, 0)
  cg_record_fields(fields, nfields, code, scope, src, ctr + 1, fm, record_info)
  -- Return ctr+1: the record pointer is at counter ctr, result is ctr+1
  ctr + 1
}
-- Store fields at declaration offset (not literal order)
fn cg_record_fields(fields: i64, nfields: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, info: i64) -> i64 {
  let tt = fmap_get_tt(fm)
  let base_ctr = node_f1(info)
  let type_ns = node_f2(info)
  let type_nl = node_f3(info)
  let mut c = ctr
  for i in 0..nfields {
    let field_pair = nlist_get(fields, i)
    let f_ns = node_f1(field_pair)
    let f_nl = node_f2(field_pair)
    let val_node = node_f3(field_pair)
    c = cg_expr(val_node, code, scope, src, c, fm)
    let base_phys = emit_load_reg(code, base_ctr)
    let val_phys = emit_load_rhs(code, c - 1)
    -- Look up field index from type table (not positional)
    let field_idx = ttable_find_field_in_type(tt, src, type_ns, type_nl, f_ns, f_nl, i)
    let off = field_idx * 8
    let str_enc = cg_str(val_phys, base_phys, off)
    bu32(code, str_enc)
  }
  c
}

-- Field access: load from record + field_index * 8
fn cg_field_access(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  -- Evaluate base expression
  let c1 = cg_expr(base, code, scope, src, ctr, fm)
  let base_phys = emit_load_reg(code, c1 - 1)
  -- Look up field index from type table
  let tt = fmap_get_tt(fm)
  let idx = if node_f4(node) > 0 { node_f4(node) - 1 } else { ttable_find_any_field(tt, src, field_ns, field_nl) }
  -- LDR x17, [base + idx * 8]
  let off = idx * 8
  let ldr_enc = cg_ldr(17, base_phys, off)
  bu32(code, ldr_enc)
  if c1 < 8 {
    let e_fa = encode_add_imm(c1 + 19, 17, 0)
    bu32(code, e_fa)
  } else {
    emit_store_reg(code, c1, 17)
  }
  c1 + 1
}

-- ======================================================================
-- Match expression codegen
-- ======================================================================

-- Helper: emit comparison test, body, branch for an int literal arm
fn cg_match_int_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let lit_val = node_f1(pat)
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  emit_mov_imm(code, 17, lit_val)
  bu32(code, encode_cmp(scr_phys, 17))
  bu32(code, encode_cset(17, 0))
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard check (if present)
  let guard_cbz = if guard > 0 {
    let cg = cg_expr(guard, code, scope, src, ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  } else { 0 }
  let c_body = cg_expr(body, code, scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 17, next_start)
  if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Helper: emit tag comparison, payload binding, guard, body for constructor arm
fn cg_match_ctor_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  let expected_hash = str_hash(src, tag_ns, tag_nl)
  let known_hash = fmap_match_known_ctor_hash(fm)
  let known_match = if known_hash == expected_hash { 1 } else { 0 }
  if known_hash >= 0 and known_match != 1 {
    fmap_inc_set_narrowing_elision_count(fm)
    cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else { if known_match == 1 {
    fmap_inc_set_narrowing_elision_count(fm)
    let body_scope = if b_nl != 0 {
      cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat)
    } else { scope }
    let body_ctr = if b_nl != 0 {
      if b_nl < 0 { ctr + (0 - b_nl) } else { ctr + 1 }
    } else { ctr }
    let guard_cbz = if guard > 0 {
      let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
      let gp = emit_load_reg(code, cg - 1)
      let gpos = buf_len(code)
      bu32(code, 0)
      gpos * 256 + gp
    } else { 0 }
    let result = cg_expr(body, code, body_scope, src, body_ctr, fm)
    cg_match_store_result(code, ctr, result)
    if guard > 0 {
      let b_pos = buf_len(code)
      bu32(code, 0)
      let next_start = buf_len(code)
      cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start)
      cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
      let after = buf_len(code)
      cg_patch_b(code, b_pos, after)
    } else { 0 }
    ctr + 1
  } else {
    cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
    let cbz_pos = buf_len(code)
    bu32(code, 0)
    -- Bind payload(s) (if present: b_nl > 0 for single, b_nl < 0 for multi)
    let body_scope = if b_nl != 0 {
      cg_match_ctor_bind_only(code, scope, src, ctr, fm, scrutinee_ctr, pat)
    } else { scope }
    let body_ctr = if b_nl != 0 {
      if b_nl < 0 { ctr + (0 - b_nl) } else { ctr + 1 }
    } else { ctr }
    -- Guard check (if present)
    let guard_cbz = if guard > 0 {
      let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
      let gp = emit_load_reg(code, cg - 1)
      let gpos = buf_len(code)
      bu32(code, 0)
      gpos * 256 + gp
    } else { 0 }
    -- Evaluate body
    let result = cg_expr(body, code, body_scope, src, body_ctr, fm)
    cg_match_store_result(code, ctr, result)
    let b_pos = buf_len(code)
    bu32(code, 0)
    let next_start = buf_len(code)
    cg_patch_cbz(code, cbz_pos, 17, next_start)
    if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
    let old_eliminated = fmap_match_eliminated_hashes(fm)
    if guard == 0 {
      fmap_set_match_eliminated_hashes(fm, cg_hash_stack_push(old_eliminated, expected_hash))
    } else { 0 }
    cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
    if guard == 0 { fmap_set_match_eliminated_hashes(fm, old_eliminated) } else { 0 }
    let after = buf_len(code)
    cg_patch_b(code, b_pos, after)
    ctr + 1
  } }
}

-- Bind constructor payload to scope without evaluating body.
-- Payload locals keep the matched constructor's declared payload type so nested
-- matches can consume set-theoretic facts from the narrowed arm scope.
fn cg_match_ctor_bind_only(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, pat: i64) -> i64 {
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  let scr_ty = fmap_match_scrutinee_type(fm)
  let tt = fmap_get_tt(fm)
  if b_nl < 0 {
    -- Multi-binding: b_ns is a bindings list, b_nl is negative count
    let bindings = b_ns
    let nb = 0 - b_nl
    let mut s = scope
    let mut c = ctr
    for i in 0..nb {
      let b = nlist_get(bindings, i)
      if node_tag(b) == 18 {
        let scr2 = emit_load_reg(code, scrutinee_ctr)
        bu32(code, cg_ldr(17, scr2, 8 + i * 8))
        if c < 8 {
          bu32(code, encode_add_imm(c + 19, 17, 0))
        } else {
          emit_store_reg(code, c, 17)
        }
        let payload_ty = cg_variant_payload_type(tt, src, tag_ns, tag_nl, scr_ty, i)
        let payload_origin = cg_match_payload_origin(fm, i)
        s = scope_push_typed_meta(s, node_f1(b), node_f2(b), reg_id(c), payload_ty, payload_origin)
        c = c + 1
      } else { c = c }
    }
    s
  } else {
    -- Single binding (backward compat)
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 {
      bu32(code, encode_add_imm(ctr + 19, 17, 0))
    } else {
      emit_store_reg(code, ctr, 17)
    }
    scope_push_typed_meta(scope, b_ns, b_nl, reg_id(ctr), cg_variant_payload_type(tt, src, tag_ns, tag_nl, scr_ty, 0), cg_match_payload_origin(fm, 0))
  }
}

-- Emit: LDR tag from scrutinee, compare with expected, CSET result to x17
fn cg_match_ctor_test(code: i64, scrutinee_ctr: i64, expected_hash: i64) -> i64 {
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  -- LDR x17, [scrutinee, #0] (tag hash)
  bu32(code, cg_ldr(17, scr_phys, 0))
  emit_mov_imm(code, 16, expected_hash)
  let cmp_enc = encode_cmp(17, 16)
  bu32(code, cmp_enc)
  let cset_enc = encode_cset(17, 0)
  bu32(code, cset_enc)
  0
}

-- Bind payload (if present) and evaluate body
-- b_packed = b_ns * 256 + b_nl (to stay at 8 params)
fn cg_match_ctor_body(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_nl = b_packed - (b_packed / 256) * 256
  if b_nl > 0 {
    let b_ns = b_packed / 256
    cg_match_ctor_bind(code, scope, src, ctr, fm, scrutinee_ctr, b_ns * 256 + b_nl, body)
  } else {
    cg_expr(body, code, scope, src, ctr, fm)
  }
}

-- Emit payload load, bind to scope, evaluate body
fn cg_match_ctor_bind(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_ns = b_packed / 256
  let b_nl = b_packed - b_ns * 256
  if b_nl > 128 {
    -- Multi-binding encoded: b_nl > 128 means b_ns is list ptr, actual count = 256 - b_nl
    -- This path is unused in current code (cg_match_ctor_body doesn't handle multi)
    -- Fall back to first binding for now
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
    cg_expr(body, code, scope_push(scope, b_ns, b_nl, reg_id(ctr)), src, ctr + 1, fm)
  } else {
    let scr2 = emit_load_reg(code, scrutinee_ctr)
    bu32(code, cg_ldr(17, scr2, 8))
    if ctr < 8 { bu32(code, encode_add_imm(ctr + 19, 17, 0)) }
    else { emit_store_reg(code, ctr, 17) }
    let new_scope = scope_push(scope, b_ns, b_nl, reg_id(ctr))
    cg_expr(body, code, new_scope, src, ctr + 1, fm)
  }
}

-- Store match arm result at ctr
fn cg_match_store_result(code: i64, ctr: i64, c_body: i64) -> i64 {
  let body_phys = emit_load_reg(code, c_body - 1)
  if ctr < 8 {
    let e = encode_add_imm(ctr + 19, body_phys, 0)
    bu32(code, e)
  } else {
    let e = encode_add_imm(17, body_phys, 0)
    bu32(code, e)
    emit_store_reg(code, ctr, 17)
  }
  0
}

-- Process remaining arms after current arm
fn cg_match_remaining(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let remaining = nlist_new()
  cg_copy_arms_from(arms, n_arms, remaining, 1)
  let old_known = fmap_match_known_ctor_hash(fm)
  let remaining_hash = if old_known >= 0 { old_known } else { cg_match_remaining_known_ctor_hash(fm) }
  let did_set = if old_known < 0 and remaining_hash >= 0 {
    fmap_set_match_known_ctor_hash(fm, remaining_hash)
    1
  } else { 0 }
  let result = cg_match_arms(remaining, n_arms - 1, code, scope, src, ctr, fm, scrutinee_ctr)
  if did_set == 1 { fmap_set_match_known_ctor_hash(fm, old_known) } else { 0 }
  result
}

-- Match expression: compile as if-else chain
fn cg_match_type_known_ctor_hash(ty: i64, fm: i64) -> i64 {
  if ty == 0 { 0 - 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 8 { ty_f1(ty) }
    else { if tag == 9 {
      ttable_single_variant_hash_for_type_hash(fmap_get_tt(fm), ty_f1(ty))
    } else { 0 - 1 } }
  }
}

fn cg_match_remaining_known_ctor_hash(fm: i64) -> i64 {
  let ty = fmap_match_scrutinee_type(fm)
  if ty == 0 { 0 - 1 }
  else {
    let tag = ty_tag(ty)
    match tag {
      8 -> {
        let hash = ty_f1(ty)
        if cg_hash_stack_contains(fmap_match_eliminated_hashes(fm), hash) == 1 { 0 - 1 } else { hash }
      }
      9 -> ttable_remaining_variant_hash_for_type_hash(fmap_get_tt(fm), ty_f1(ty), fmap_match_eliminated_hashes(fm))
      _ -> 0 - 1
    }
  }
}

fn cg_variant_payload_type(tt: i64, src: i64, tag_ns: i64, tag_nl: i64, scr_ty: i64, idx: i64) -> i64 {
  if tt == 0 { ty_i64() }
  else { if scr_ty == 0 { ty_i64() }
  else { if ty_tag(scr_ty) == 8 {
    if idx == 0 { ty_f2(scr_ty) } else { ty_i64() }
  } else { if ty_tag(scr_ty) != 9 { ty_i64() }
  else {
    let type_hash = ty_f1(scr_ty)
    let type_args = ty_f3(scr_ty)
    let n = __mem_load64(tt + 8)
    let d = __mem_load64(tt)
    let mut ti = 0
    let mut result = ty_i64()
    while ti < n {
      let kind = __mem_load64(d + ti * 56 + 16)
      if kind == 1 {
        let entry_src = __mem_load64(d + ti * 56 + 48)
        let type_ns = __mem_load64(d + ti * 56)
        let type_nl = __mem_load64(d + ti * 56 + 8)
        if type_name_hash(entry_src, type_ns, type_nl) == type_hash {
          let nvariants = __mem_load64(d + ti * 56 + 24)
          let variants = __mem_load64(d + ti * 56 + 32)
          let tparams = __mem_load64(d + ti * 56 + 40)
          let mut vi = 0
          while vi < nvariants {
            let v_ns = __mem_load64(variants + vi * 40)
            let v_nl = __mem_load64(variants + vi * 40 + 8)
            if v_nl == tag_nl {
              if src_eq_at(src, tag_ns, entry_src + v_ns, 0, tag_nl) == 1 {
                let npayloads = __mem_load64(variants + vi * 40 + 24)
                let payloads = __mem_load64(variants + vi * 40 + 32)
                if idx < npayloads {
                  let pty = if payloads != 0 { nlist_get(payloads, idx) } else { ty_i64() }
                  if tparams != 0 {
                    if type_args != 0 { result = ty_subst(pty, cg_build_subst(tparams, type_args)) }
                    else { result = pty }
                  } else { result = pty }
                } else { result = ty_i64() }
                vi = nvariants
                ti = n
              } else { vi = vi + 1 }
            } else { vi = vi + 1 }
          }
          if ti < n { ti = ti + 1 } else { ti = ti }
        } else { ti = ti + 1 }
      } else { ti = ti + 1 }
    }
    result
  } } } }
}

fn cg_origin_make_lambda(lambda: i64, def_scope: i64) -> i64 {
  node_new(0, lambda, def_scope, 0, 0)
}

fn cg_origin_make_ctor(value: i64, payload_origins: i64, ctor_hash: i64) -> i64 {
  node_new(0, value, payload_origins, 1, ctor_hash)
}

fn cg_origin_make_rc_alloc(value: i64, payload_size: i64) -> i64 {
  node_new(0, value, 0, 2, payload_size)
}

fn cg_origin_is_ctor(origin: i64) -> i64 {
  if origin == 0 { 0 } else { node_f3(origin) == 1 }
}

fn cg_origin_is_rc_alloc(origin: i64) -> i64 {
  if origin == 0 { 0 } else { node_f3(origin) == 2 }
}

fn cg_origin_rc_alloc_size(origin: i64) -> i64 {
  if cg_origin_is_rc_alloc(origin) == 1 { node_f4(origin) } else { 0 }
}

fn cg_origin_known_ctor_hash(origin: i64) -> i64 {
  if origin == 0 { 0 - 1 }
  else { if node_f3(origin) == 1 { node_f4(origin) } else { 0 - 1 } }
}

fn cg_origin_payload_origin(origin: i64, idx: i64) -> i64 {
  if cg_origin_is_ctor(origin) != 1 { 0 }
  else {
    let payloads = node_f2(origin)
    if payloads == 0 { 0 }
    else { if idx < nlist_len(payloads) { nlist_get(payloads, idx) } else { 0 } }
  }
}

fn cg_match_payload_origin(fm: i64, idx: i64) -> i64 {
  cg_origin_payload_origin(fmap_match_value_origin(fm), idx)
}

fn cg_origin_payload_count(origin: i64) -> i64 {
  if cg_origin_is_ctor(origin) != 1 { 0 }
  else {
    let payloads = node_f2(origin)
    if payloads == 0 { 0 } else { nlist_len(payloads) }
  }
}

fn cg_origin_join_payloads(a: i64, b: i64) -> i64 {
  let result = nlist_new()
  let na = cg_origin_payload_count(a)
  let nb = cg_origin_payload_count(b)
  let n = if na > nb { na } else { nb }
  for i in 0..n {
    nlist_add(result, cg_origin_join(cg_origin_payload_origin(a, i), cg_origin_payload_origin(b, i), 0))
  }
  result
}

fn cg_origin_join(a: i64, b: i64, value_node: i64) -> i64 {
  if cg_origin_is_ctor(a) != 1 { 0 }
  else { if cg_origin_is_ctor(b) != 1 { 0 }
  else {
    let hash = cg_origin_known_ctor_hash(a)
    if hash != cg_origin_known_ctor_hash(b) { 0 }
    else { cg_origin_make_ctor(value_node, cg_origin_join_payloads(a, b), hash) }
  } }
}

fn cg_expr_payload_origins(args: i64, nargs: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let result = nlist_new()
  for i in 0..nargs {
    nlist_add(result, cg_expr_value_origin(nlist_get(args, i), scope, src, fm))
  }
  result
}

fn cg_expr_call_value_origin(value_node: i64, call_node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 }
  else {
    let rc_size = cg_rc_default_alloc_literal_size(call_node, scope, src)
    if rc_size > 0 { cg_origin_make_rc_alloc(value_node, rc_size) }
    else {
      let tt = fmap_get_tt(fm)
      let ctor_hash = if tt > 0 { ttable_find_variant(tt, src, node_f1(call_node), node_f2(call_node)) } else { 0 - 1 }
      if ctor_hash < 0 { 0 }
      else { cg_origin_make_ctor(value_node, cg_expr_payload_origins(node_f3(call_node), node_f4(call_node), scope, src, fm), ctor_hash) }
    }
  }
}

fn cg_expr_value_origin(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      2 -> {
        if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 {
          let origin = scope_lookup_meta(scope, src, node_f1(node), node_f2(node))
          if cg_origin_is_ctor(origin) == 1 or cg_origin_is_rc_alloc(origin) == 1 { origin } else { 0 }
        } else {
          let tt = fmap_get_tt(fm)
          let ctor_hash = if tt > 0 { ttable_find_variant(tt, src, node_f1(node), node_f2(node)) } else { 0 - 1 }
          if ctor_hash >= 0 { cg_origin_make_ctor(node, nlist_new(), ctor_hash) } else { 0 }
        }
      }
      4 -> cg_expr_call_value_origin(node, node, scope, src, fm)
      36 -> cg_expr_call_value_origin(node, node_f2(node), scope, src, fm)
      5 -> cg_origin_join(cg_expr_value_origin(node_f2(node), scope, src, fm), cg_expr_value_origin(node_f3(node), scope, src, fm), node)
      _ -> 0
    }
  }
}

fn cg_expr_known_ctor_hash(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 - 1 }
  else {
    let origin_hash = cg_origin_known_ctor_hash(cg_expr_value_origin(node, scope, src, fm))
    if origin_hash >= 0 { origin_hash } else {
      let tag = node_tag(node)
      if tag == 2 {
        let reg = scope_lookup(scope, src, node_f1(node), node_f2(node))
        if reg != 0 - 999 {
          cg_match_type_known_ctor_hash(scope_lookup_type(scope, src, node_f1(node), node_f2(node)), fm)
        } else {
          let tt = fmap_get_tt(fm)
          if tt > 0 { ttable_find_variant(tt, src, node_f1(node), node_f2(node)) } else { 0 - 1 }
        }
      } else { if tag == 4 {
        if scope_lookup(scope, src, node_f1(node), node_f2(node)) != 0 - 999 { 0 - 1 }
        else {
          let tt2 = fmap_get_tt(fm)
          let direct_hash = if tt2 > 0 { ttable_find_variant(tt2, src, node_f1(node), node_f2(node)) } else { 0 - 1 }
          if direct_hash >= 0 { direct_hash } else { cg_match_type_known_ctor_hash(cg_expr_type(node, scope, src, fm), fm) }
        }
      } else { if tag == 36 {
        let call_node = node_f2(node)
        if scope_lookup(scope, src, node_f1(call_node), node_f2(call_node)) != 0 - 999 { 0 - 1 }
        else {
          let tt3 = fmap_get_tt(fm)
          let direct_hash2 = if tt3 > 0 { ttable_find_variant(tt3, src, node_f1(call_node), node_f2(call_node)) } else { 0 - 1 }
          if direct_hash2 >= 0 { direct_hash2 } else { cg_match_type_known_ctor_hash(cg_expr_type(node, scope, src, fm), fm) }
        }
      } else { cg_match_type_known_ctor_hash(cg_expr_type(node, scope, src, fm), fm) } } }
    }
  }
}

fn cg_match(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let scrutinee = node_f1(node)
  let arms = node_f2(node)
  let n_arms = node_f3(node)
  let known_hash = cg_expr_known_ctor_hash(scrutinee, scope, src, fm)
  let scrutinee_ty = cg_expr_type(scrutinee, scope, src, fm)
  let value_origin = cg_expr_value_origin(scrutinee, scope, src, fm)
  let c1 = cg_expr(scrutinee, code, scope, src, ctr, fm)
  let old_known_hash = fmap_match_known_ctor_hash(fm)
  let old_scrutinee_ty = fmap_match_scrutinee_type(fm)
  let old_value_origin = fmap_match_value_origin(fm)
  let old_eliminated = fmap_match_eliminated_hashes(fm)
  fmap_set_match_known_ctor_hash(fm, known_hash)
  fmap_set_match_scrutinee_type(fm, scrutinee_ty)
  fmap_set_match_value_origin(fm, value_origin)
  fmap_set_match_eliminated_hashes(fm, 0)
  let result = cg_match_arms(arms, n_arms, code, scope, src, c1, fm, c1 - 1)
  fmap_set_match_known_ctor_hash(fm, old_known_hash)
  fmap_set_match_scrutinee_type(fm, old_scrutinee_ty)
  fmap_set_match_value_origin(fm, old_value_origin)
  fmap_set_match_eliminated_hashes(fm, old_eliminated)
  result
}
-- scrutinee_ctr: counter where the scrutinee value lives
fn cg_match_arms(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  if n_arms <= 0 {
    -- Non-exhaustive match: emit runtime trap (BRK #1 = 0xD4200020)
    bu32(code, encode_brk(1))
    cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  } else {
    cg_match_dispatch(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Binary tree dispatch: split by pat_tag range to limit nesting depth
fn cg_match_dispatch(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag <= 18 {
    cg_match_arm_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_arm_high(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Handle wildcard (17) and binding (18) patterns
fn cg_match_arm_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  if guard == 0 {
    -- No guard: wildcard/binding always matches
    if pat_tag == 17 {
      let c_body = cg_expr(body, code, scope, src, ctr, fm)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    } else {
      let c_body = cg_match_bind_arm(body, pat, code, scope, src, ctr, fm, scrutinee_ctr)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    }
  } else {
    -- Guard present: bind pattern, eval guard, CBZ to next arm if false
    cg_match_guarded_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

fn cg_match_guarded_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  -- Set up scope (binding adds variable, wildcard doesn't)
  let guard_scope = if pat_tag == 18 {
    let b_ns = node_f1(pat)
    let b_nl = node_f2(pat)
    scope_push(scope, b_ns, b_nl, reg_id(scrutinee_ctr))
  } else { scope }
  -- Evaluate guard
  let cg = cg_expr(guard, code, guard_scope, src, ctr, fm)
  let gp = emit_load_reg(code, cg - 1)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard passed: evaluate body
  let c_body = cg_expr(body, code, guard_scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  -- Guard failed: try remaining arms
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, gp, next_start)
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Handle binding pattern: bind scrutinee to variable name
fn cg_match_bind_arm(body: i64, pat: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let b_ns = node_f1(pat)
  let b_nl = node_f2(pat)
  let scr_rid = reg_id(scrutinee_ctr)
  let new_scope = scope_push(scope, b_ns, b_nl, scr_rid)
  cg_expr(body, code, new_scope, src, ctr, fm)
}

-- Handle int literal (19) and constructor (20) patterns
fn cg_match_arm_high(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag == 19 {
    cg_match_int_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_ctor_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}
-- Copy arms from index start to a new list
fn cg_copy_arms_from(arms: i64, n: i64, dest: i64, start: i64) -> i64 {
  for i in start..n {
    nlist_add(dest, nlist_get(arms, i))
  }
  0
}

fn cg_block(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let first = node_f1(node)
  let rest = node_f2(node)
  cg_expr_discard(first, code, scope, src, ctr, fm)
  cg_expr(rest, code, scope, src, ctr, fm)
}

fn cg_block_floor(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, floor: i64) -> i64 {
  let first = node_f1(node)
  let rest = node_f2(node)
  cg_expr_discard_floor(first, code, scope, src, ctr, fm, floor)
  cg_expr_floor(rest, code, scope, src, ctr, fm, floor)
}

fn cg_emit_call_lit(code: i64, fm: i64, name: str) -> i64 {
  cg_reuse_token_clear(fm)
  let sp = __str_ptr(name)
  let sl = __str_len(name)
  let cur = buf_len(code)
  if fmap_contains(fm, sp, 0, sl) == 0 {
    eprint("error: required runtime function unavailable: ")
    sys_write(2, sp, sl)
    eprint("\n")
    bu32(code, encode_bl(0))
  } else {
    let target = fmap_lookup(fm, sp, 0, sl)
    if target == 0 {
      fmap_add_patch(fm, cur, sp, 0, sl)
      bu32(code, encode_bl(0))
    } else {
      bu32(code, encode_bl(target - cur))
    }
  }
}

fn cg_emit_rc_default_alloc_lit(code: i64, fm: i64, kind: i64, payload_size: i64, align: i64) -> i64 {
  if align == 8 {
    cg_record_managed_reuse_allocation(fm, kind, payload_size)
  } else { cg_reuse_token_clear(fm) }
  emit_mov_imm(code, 0, payload_size)
  emit_mov_imm(code, 1, align)
  cg_emit_call_lit(code, fm, "rc_default_alloc")
}

fn cg_emit_rc_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_retain")
}

fn cg_emit_rc_release_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "rc_default_release")
}

fn cg_emit_rc_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_rc_retain_phys(code, fm, phys)
}

fn cg_emit_rc_release_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_rc_release_phys(code, fm, phys)
}

fn cg_ty_is_rc(ty: i64) -> i64 {
  if ty == 0 { 0 } else { ty_is_rc(ty) }
}

fn cg_emit_closure_retain_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "closure_default_retain")
}

fn cg_emit_closure_release_phys(code: i64, fm: i64, phys: i64) -> i64 {
  bu32(code, encode_add_imm(0, phys, 0))
  cg_emit_call_lit(code, fm, "closure_default_release")
}

fn cg_emit_closure_retain_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_closure_retain_phys(code, fm, phys)
}

fn cg_emit_closure_release_regid(code: i64, fm: i64, rid: i64) -> i64 {
  let phys = if rid < 0 {
    let slot = 0 - rid - 1
    bu32(code, cg_ldr(16, 31, slot * 8))
    16
  } else { rid }
  cg_emit_closure_release_phys(code, fm, phys)
}

fn cg_ty_is_closure(ty: i64) -> i64 {
  if ty == 0 { 0 } else { ty_tag(ty) == 6 or ty_tag(ty) == 14 }
}

fn cg_ty_is_managed(ty: i64) -> i64 {
  cg_ty_is_rc(ty) == 1 or cg_ty_is_closure(ty) == 1
}

fn cg_managed_drop_kind_for_ty(ty: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { continuation_cleanup_kind_rc() }
  else { if cg_ty_is_closure(ty) == 1 { continuation_cleanup_kind_closure() }
  else { continuation_cleanup_kind_none() } }
}

fn cg_managed_reuse_static_release_size_for_ty(ty: i64) -> i64 {
  if cg_ty_is_closure(ty) == 1 { 16 } else { 0 }
}

fn cg_record_managed_drop_specialization(fm: i64, kind: i64) -> i64 {
  match kind {
    1 -> {
      fmap_inc_managed_drop_specialization_count(fm)
      fmap_inc_rc_drop_specialization_count(fm)
    }
    2 -> {
      fmap_inc_managed_drop_specialization_count(fm)
      fmap_inc_closure_drop_specialization_count(fm)
    }
    _ -> 0
  }
}

fn cg_reuse_token_clear(fm: i64) -> i64 {
  fmap_set_reuse_token_kind(fm, continuation_cleanup_kind_none())
  fmap_set_reuse_token_size(fm, 0)
}

fn cg_reuse_token_snapshot(fm: i64) -> i64 {
  node_new(0, fmap_reuse_token_kind(fm), fmap_reuse_token_size(fm), 0, 0)
}

fn cg_reuse_token_restore(fm: i64, snapshot: i64) -> i64 {
  if snapshot == 0 { cg_reuse_token_clear(fm) }
  else {
    fmap_set_reuse_token_kind(fm, node_f1(snapshot))
    fmap_set_reuse_token_size(fm, node_f2(snapshot))
  }
}

fn cg_record_managed_reuse_release_token(fm: i64, kind: i64, payload_size: i64) -> i64 {
  if payload_size <= 0 { cg_reuse_token_clear(fm) }
  else { if kind == continuation_cleanup_kind_rc() or kind == continuation_cleanup_kind_closure() {
    fmap_set_reuse_token_kind(fm, kind)
    fmap_set_reuse_token_size(fm, payload_size)
  } else { cg_reuse_token_clear(fm) } }
}

fn cg_inc_managed_reuse_candidate(fm: i64, kind: i64) -> i64 {
  fmap_inc_managed_reuse_candidate_count(fm)
  match kind {
    1 -> fmap_inc_rc_reuse_candidate_count(fm)
    2 -> fmap_inc_closure_reuse_candidate_count(fm)
    _ -> 0
  }
}

fn cg_inc_managed_reuse_lowering(fm: i64, kind: i64) -> i64 {
  fmap_inc_managed_reuse_lowering_count(fm)
  match kind {
    1 -> fmap_inc_rc_reuse_lowering_count(fm)
    2 -> fmap_inc_closure_reuse_lowering_count(fm)
    _ -> 0
  }
}

fn cg_record_managed_reuse_allocation(fm: i64, kind: i64, payload_size: i64) -> i64 {
  if payload_size > 0 and kind == fmap_reuse_token_kind(fm) and payload_size == fmap_reuse_token_size(fm) {
    cg_inc_managed_reuse_candidate(fm, kind)
  } else { 0 }
  cg_reuse_token_clear(fm)
}

fn cg_ty_is_f64(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F64() }
}

fn cg_type_list_single(ty: i64) -> i64 {
  let params = nlist_new()
  nlist_add(params, ty)
  params
}

fn cg_continuation_fn_type(value_ty: i64, result_ty: i64) -> i64 {
  ty_continuation(value_ty, result_ty)
}

fn cg_continuation_direct_ref_token(node: i64, scope: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) == 2 {
    let rid = scope_lookup(scope, src, node_f1(node), node_f2(node))
    if cg_is_continuation_reg(rid) == 1 { scope_lookup_type(scope, src, node_f1(node), node_f2(node)) } else { 0 }
  } else { 0 } }
}

fn cg_continuation_direct_result_for_param(node: i64, param: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> if node_f2(node) == node_f2(param) and src_eq_at(src, node_f1(node), src + node_f1(param), 0, node_f2(node)) == 1 { 1 } else { 0 }
      36 -> cg_continuation_direct_result_for_param(node_f2(node), param, src)
      37 -> cg_continuation_direct_result_for_param(node_f1(node), param, src)
      _ -> 0
    }
  }
}

fn cg_continuation_token_alias_from_call(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node_tag(node) != 4 { 0 }
  else {
    let entry = cg_borrow_entry_for_direct_call(fm, src, node_f1(node), node_f2(node))
    if entry == 0 { 0 }
    else {
      let fn_wrap = node_f2(entry)
      let fn_node = unwrap_fn(fn_wrap)
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let ret_ty = fn_ret_type(fn_wrap)
      if ty_is_continuation(ret_ty) == 0 or params == 0 or body == 0 { 0 }
      else {
        let args = node_f3(node)
        let nargs = node_f4(node)
        let mut result = 0
        let mut i = 0
        while i < nargs {
          if i < nlist_len(params) {
            let token_rid = cg_continuation_direct_ref_token(nlist_get(args, i), scope, src)
            let param = nlist_get(params, i)
            if token_rid != 0 and ty_is_continuation(node_f3(param)) == 1 and cg_continuation_direct_result_for_param(body, param, src) == 1 {
              result = token_rid
              i = nargs
            } else { i = i + 1 }
          } else { i = i + 1 }
        }
        result
      }
    }
  }
}

fn cg_continuation_token_alias_from_value(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    match node_tag(node) {
      2 -> cg_continuation_direct_ref_token(node, scope, src)
      4 -> cg_continuation_token_alias_from_call(node, scope, src, fm)
      36 -> cg_continuation_token_alias_from_value(node_f2(node), scope, src, fm)
      37 -> cg_continuation_token_alias_from_value(node_f1(node), scope, src, fm)
      _ -> 0
    }
  }
}

fn cg_let_continuation_token_alias(node: i64, token_rid: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let new_scope = scope_push_typed(scope, node_f1(node), node_f2(node), cg_continuation_reg(), token_rid)
  cg_expr(node_f4(node), code, new_scope, src, ctr, fm)
}

fn cg_emit_managed_retain_regid(code: i64, fm: i64, ty: i64, rid: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_emit_rc_retain_regid(code, fm, rid) }
  else { if cg_ty_is_closure(ty) == 1 { cg_emit_closure_retain_regid(code, fm, rid) } else { 0 } }
}

fn cg_emit_managed_release_kind_regid_with_size(code: i64, fm: i64, kind: i64, rid: i64, payload_size: i64) -> i64 {
  match kind {
    1 -> {
      cg_record_managed_drop_specialization(fm, kind)
      cg_emit_rc_release_regid(code, fm, rid)
      cg_record_managed_reuse_release_token(fm, kind, payload_size)
    }
    2 -> {
      cg_record_managed_drop_specialization(fm, kind)
      cg_emit_closure_release_regid(code, fm, rid)
      cg_record_managed_reuse_release_token(fm, kind, payload_size)
    }
    _ -> 0
  }
}

fn cg_emit_managed_release_kind_regid(code: i64, fm: i64, kind: i64, rid: i64) -> i64 {
  cg_emit_managed_release_kind_regid_with_size(code, fm, kind, rid, 0)
}

fn cg_emit_managed_release_regid(code: i64, fm: i64, ty: i64, rid: i64) -> i64 {
  cg_emit_managed_release_kind_regid_with_size(code, fm, cg_managed_drop_kind_for_ty(ty), rid, cg_managed_reuse_static_release_size_for_ty(ty))
}

fn cg_emit_managed_retain_phys_for_ty(code: i64, fm: i64, ty: i64, phys: i64) -> i64 {
  if cg_ty_is_rc(ty) == 1 { cg_emit_rc_retain_phys(code, fm, phys) }
  else { if cg_ty_is_closure(ty) == 1 { cg_emit_closure_retain_phys(code, fm, phys) } else { 0 } }
}

fn cg_emit_managed_release_kind_phys_with_size(code: i64, fm: i64, kind: i64, phys: i64, payload_size: i64) -> i64 {
  match kind {
    1 -> {
      cg_record_managed_drop_specialization(fm, kind)
      cg_emit_rc_release_phys(code, fm, phys)
      cg_record_managed_reuse_release_token(fm, kind, payload_size)
    }
    2 -> {
      cg_record_managed_drop_specialization(fm, kind)
      cg_emit_closure_release_phys(code, fm, phys)
      cg_record_managed_reuse_release_token(fm, kind, payload_size)
    }
    _ -> 0
  }
}

fn cg_emit_managed_release_kind_phys(code: i64, fm: i64, kind: i64, phys: i64) -> i64 {
  cg_emit_managed_release_kind_phys_with_size(code, fm, kind, phys, 0)
}

fn cg_emit_managed_release_phys_for_ty(code: i64, fm: i64, ty: i64, phys: i64) -> i64 {
  cg_emit_managed_release_kind_phys_with_size(code, fm, cg_managed_drop_kind_for_ty(ty), phys, cg_managed_reuse_static_release_size_for_ty(ty))
}

fn cg_param_ty(params: i64, idx: i64) -> i64 {
  if params == 0 { 0 }
  else { if idx >= nlist_len(params) { 0 }
  else { node_f3(nlist_get(params, idx)) } }
}

fn cg_param_info_ty(params: i64, idx: i64, kind: i64) -> i64 {
  if params == 0 { 0 }
  else { if idx >= nlist_len(params) { 0 }
  else {
    if kind == 1 { nlist_get(params, idx) } else { node_f3(nlist_get(params, idx)) }
  } }
}

fn cg_build_subst(tparams: i64, type_args: i64) -> i64 {
  let s = subst_new()
  if tparams == 0 { s }
  else {
    let n = nlist_len(tparams)
    let nargs = if type_args == 0 { 0 } else { nlist_len(type_args) }
    for i in 0..n {
      if i < nargs {
        let tp = nlist_get(tparams, i)
        subst_add(s, node_f3(tp), nlist_get(type_args, i))
      } else { 0 }
    }
    s
  }
}

fn cg_params_subst(params: i64, s: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let result = nlist_new()
    let n = nlist_len(params)
    for i in 0..n {
      let p = nlist_get(params, i)
      let ty = node_f3(p)
      let subst_ty = if ty == 0 { 0 } else { ty_subst(ty, s) }
      nlist_add(result, node_new(node_tag(p), node_f1(p), node_f2(p), subst_ty, node_f4(p)))
    }
    result
  }
}

fn cg_generic_subst_params(fm: i64, name_hash: i64, type_args: i64) -> i64 {
  let tm = __mem_load64(fm + 80)
  let tmpl_entry = mono_tmap_lookup(tm, name_hash)
  if tmpl_entry == 0 { 0 }
  else {
    let tmpl_wrap = __mem_load64(tmpl_entry + 8)
    let tmpl_inner = unwrap_fn(tmpl_wrap)
    let s = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
    cg_params_subst(node_f3(tmpl_inner), s)
  }
}

fn cg_generic_subst_ret(tmpl_wrap: i64, type_args: i64) -> i64 {
  let ret_ty = fn_ret_type(tmpl_wrap)
  let s = cg_build_subst(fn_tparams(tmpl_wrap), type_args)
  if ret_ty == 0 { 0 } else { ty_subst(ret_ty, s) }
}

fn cg_merge_expr_type(a: i64, b: i64) -> i64 {
  if a == 0 { b }
  else { if b == 0 { a }
  else { if ty_eq(a, b) { a } else { ty_union(a, b) } } }
}

fn cg_match_body_type(arms: i64, n: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let mut result = 0
  let mut i = 0
  while i < n {
    let arm = nlist_get(arms, i)
    result = cg_merge_expr_type(result, cg_expr_type(node_f2(arm), scope, src, fm))
    i = i + 1
  }
  result
}

fn cg_lambda_param_ty(param: i64) -> i64 {
  let ann_ty = node_f3(param)
  if ann_ty != 0 { ann_ty } else { ty_i64() }
}

fn cg_lambda_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let params = node_f1(node)
  let body = node_f2(node)
  let nparams = node_f3(node)
  let param_tys = nlist_new()
  let mut body_scope = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    let param_ty = cg_lambda_param_ty(p)
    nlist_add(param_tys, param_ty)
    body_scope = scope_push_typed(body_scope, node_f1(p), node_f2(p), 0, param_ty)
  }
  ty_fn(param_tys, cg_expr_type(body, body_scope, src, fm), ty_effect_pure())
}

fn cg_binop_expr_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  match op {
    1 -> {
      if cg_ty_is_f64(cg_expr_type(node_f2(node), scope, src, fm)) or cg_ty_is_f64(cg_expr_type(node_f3(node), scope, src, fm)) { ty_f64() }
      else { ty_i64() }
    }
    2 -> {
      if cg_ty_is_f64(cg_expr_type(node_f2(node), scope, src, fm)) or cg_ty_is_f64(cg_expr_type(node_f3(node), scope, src, fm)) { ty_f64() }
      else { ty_i64() }
    }
    3 -> {
      if cg_ty_is_f64(cg_expr_type(node_f2(node), scope, src, fm)) or cg_ty_is_f64(cg_expr_type(node_f3(node), scope, src, fm)) { ty_f64() }
      else { ty_i64() }
    }
    4 -> {
      if cg_ty_is_f64(cg_expr_type(node_f2(node), scope, src, fm)) or cg_ty_is_f64(cg_expr_type(node_f3(node), scope, src, fm)) { ty_f64() }
      else { ty_i64() }
    }
    5 -> ty_bool()
    6 -> ty_bool()
    7 -> ty_bool()
    8 -> ty_bool()
    9 -> ty_bool()
    10 -> ty_bool()
    12 -> ty_bool()
    13 -> ty_bool()
    _ -> ty_i64()
  }
}

fn cg_binop_uses_f64(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  if op >= 1 and op <= 10 {
    let lhs_ty = cg_expr_type(node_f2(node), scope, src, fm)
    let rhs_ty = cg_expr_type(node_f3(node), scope, src, fm)
    cg_ty_is_f64(lhs_ty) == 1 or cg_ty_is_f64(rhs_ty) == 1
  } else { false }
}

fn cg_intrinsic_type(src: i64, ns: i64, nl: i64) -> i64 {
  if src_eq(src, ns, nl, "__i64_to_f64") == 1 { ty_f64() }
  else { ty_i64() }
}

fn cg_resolved_method_call_type(node: i64, fm: i64) -> i64 {
  let method_ret = ttable_lookup_method_ret(fmap_get_tt(fm), node_f4(node), node_f2(node))
  if method_ret != 0 { method_ret } else { ty_i64() }
}

fn cg_expr_type(node: i64, scope: i64, src: i64, fm: i64) -> i64 {
  if node == 0 { 0 }
  else {
    let tag = node_tag(node)
    match tag {
      1 -> ty_i64()
      2 -> {
        let ty = scope_lookup_type(scope, src, node_f1(node), node_f2(node))
