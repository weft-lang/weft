      22 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      25 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      26 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      29 -> {
        if cg_borrow_param_list_has_name(node_f1(node), node_f3(node), src, ns, nl) == 1 { 0 }
        else { cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) }
      }
      32 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_handler_clauses_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      36 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      37 -> {
        let inner = node_f1(node)
        if cg_same_name(src, node_f1(inner), node_f2(inner), ns, nl) == 1 {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl)
        } else {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(inner), src, ns, nl)
        }
