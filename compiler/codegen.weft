fn cg_borrow_match_arms_mention_name(arms: i64, narms: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms and found == 0 {
    let arm = nlist_get(arms, i)
    if cg_borrow_expr_mentions_name(node_f2(arm), src, ns, nl) == 1 {
      found = true
    } else {
      if cg_borrow_expr_mentions_name(node_f3(arm), src, ns, nl) == 1 { found = true }
      else { i = i + 1 }
    }
  }
  found
}

fn cg_borrow_handler_clauses_mention_name(clauses: i64, nclauses: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nclauses and found == 0 {
    let clause = nlist_get(clauses, i)
    if cg_borrow_expr_mentions_name(node_f3(clause), src, ns, nl) == 1 { found = true }
    else { i = i + 1 }
  }
  found
}

fn cg_borrow_expr_mentions_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> cg_ident_matches(node, src, ns, nl)
      3 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      4 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { true } else { cg_borrow_expr_list_mentions_name(node_f3(node), node_f4(node), src, ns, nl) }
      5 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      6 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      7 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      10 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      11 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      12 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { true } else { cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) }
      13 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      14 -> cg_borrow_record_fields_mention_name(node_f3(node), node_f4(node), src, ns, nl)
      15 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_match_arms_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      22 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      25 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      26 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      29 -> {
        if cg_borrow_param_list_has_name(node_f1(node), node_f3(node), src, ns, nl) == 1 { false }
        else { cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) }
      }
      32 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_handler_clauses_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      36 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      37 -> {
        let inner = node_f1(node)
        if cg_same_name(src, node_f1(inner), node_f2(inner), ns, nl) == 1 {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl)
        } else {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(inner), src, ns, nl)
        }
      }
      41 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      45 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      46 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      48 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      49 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      52 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      55 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      56 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      57 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      _ -> false
    }
  }
}

fn cg_borrow_expr_list_blocks_name(args: i64, nargs: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < nargs and found == false {
    if cg_borrow_expr_blocks_name(nlist_get(args, i), src, ns, nl) == 1 { found = true }
    else { i = i + 1 }
  }
  found
}

fn cg_borrow_match_arms_block_name(arms: i64, narms: i64, src: i64, ns: i64, nl: i64) -> bool {
  let mut found = false
  let mut i = 0
  while i < narms and found == 0 {
    let arm = nlist_get(arms, i)
    if cg_borrow_expr_blocks_name(node_f2(arm), src, ns, nl) == 1 {
      found = true
    } else {
      if cg_borrow_expr_blocks_name(node_f3(arm), src, ns, nl) == 1 { found = true }
      else { i = i + 1 }
    }
  }
  found
}

fn cg_borrow_call_blocks_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  let args = node_f3(node)
  let nargs = node_f4(node)
  if cg_borrow_expr_list_blocks_name(args, nargs, src, ns, nl) == 1 { true }
  else {
    if cg_call_name_is_borrow_barrier(node, src) == 1 {
      cg_borrow_expr_list_mentions_name(args, nargs, src, ns, nl)
    } else { false }
  }
}

fn cg_borrow_expr_blocks_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      3 -> cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      4 -> cg_borrow_call_blocks_name(node, src, ns, nl)
      5 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      6 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f4(node), src, ns, nl)
      }
      7 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl)
      10 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl)
      11 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f4(node), src, ns, nl)
      }
      12 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { true } else { cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl) }
      13 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      14 -> cg_borrow_record_fields_mention_name(node_f3(node), node_f4(node), src, ns, nl)
      15 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_match_arms_block_name(node_f2(node), node_f3(node), src, ns, nl)
      22 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      25 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      26 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      29 -> {
        if cg_borrow_param_list_has_name(node_f1(node), node_f3(node), src, ns, nl) == 1 { false }
        else { cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) }
      }
      32 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_handler_clauses_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      36 -> {
        if cg_generic_call_name_is_borrow_transparent(node, src) == 1 {
          cg_borrow_transparent_generic_call_blocks_name(node, src, ns, nl)
        } else {
          if cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) == 1 { true } else { false }
        }
      }
      37 -> {
        let inner = node_f1(node)
        if cg_same_name(src, node_f1(inner), node_f2(inner), ns, nl) == 1 {
          cg_borrow_expr_blocks_name(node_f3(inner), src, ns, nl)
        } else {
          cg_borrow_expr_blocks_name(node_f3(inner), src, ns, nl) or cg_borrow_expr_blocks_name(node_f4(inner), src, ns, nl)
        }
      }
      41 -> if cg_borrow_expr_mentions_name(node, src, ns, nl) == 1 { true } else { false }
      45 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      46 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f2(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_blocks_name(node_f3(node), src, ns, nl) or cg_borrow_expr_blocks_name(node_f4(node), src, ns, nl)
      }
      48 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      49 -> cg_borrow_expr_blocks_name(node_f1(node), src, ns, nl)
      52 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      57 -> true
      _ -> false
    }
  }
}

-- Kept coherent with pipeline_fn_borrowable_param_mask_with_params:
-- the managed-return blanket gate is lifted (2r slice 1b); callers and
-- callee-side releases must derive the SAME mask for a given fn.
fn cg_fn_borrowable_param_mask(fn_wrap: i64, fn_src: i64) -> i64 {
  let inner = unwrap_fn(fn_wrap)
  let params = node_f3(inner)
  let body = node_f4(inner)
  let mut mask = 0
  let mut i = 0
  let n = nlist_len(params)
  while i < n and i < 60 {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 {
      if cg_borrow_expr_blocks_name(body, fn_src, node_f1(p), node_f2(p)) == 0 {
        mask = mask + cg_bit(i)
      } else { 0 }
    } else { 0 }
    i = i + 1
  }
  mask
}

fn cg_call_name_is_borrow_barrier(node: i64, src: i64) -> i64 {
  src_eq(src, node_f1(node), node_f2(node), "__mem_store64") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "__mem_store8") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "rc_default_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "rc_default_weak_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "weak_load") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "rc_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "closure_default_release") == 1 or
  src_eq(src, node_f1(node), node_f2(node), "closure_default_release_env") == 1
}

fn cg_generic_call_name_is_borrow_transparent(node: i64, src: i64) -> i64 {
  if node == 0 or node_tag(node) != 36 { 0 }
  else {
    let inner = node_f2(node)
    if inner == 0 or node_tag(inner) != 4 { 0 }
    else {
      src_eq(src, node_f1(inner), node_f2(inner), "runtime_generator_state_word_from")
    }
  }
}

fn cg_borrow_transparent_generic_call_blocks_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  let inner = node_f2(node)
  cg_borrow_expr_list_blocks_name(node_f3(inner), node_f4(inner), src, ns, nl)
}

fn cg_cleanup_stack(fm: i64) -> i64 {
  mem_load64_at(fm + 144, 0)
}

fn cg_cleanup_push_rc_sized(fm: i64, rid: i64, payload_size: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, 0, 1, payload_size))
  nlist_len(stack)
}

fn cg_cleanup_push_closure_sized(fm: i64, rid: i64, payload_size: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, 0, 2, payload_size))
  nlist_len(stack)
}

fn cg_cleanup_push_weak_sized(fm: i64, rid: i64, payload_size: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, 0, 4, payload_size))
  nlist_len(stack)
}

fn cg_cleanup_push_owned_drop(fm: i64, rid: i64, type_hash: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_add(stack, node_new(0, rid, type_hash, 8, 0))
  nlist_len(stack)
}

fn cg_cleanup_push_owned_drop_for_ty(fm: i64, ty: i64, rid: i64) -> i64 {
  let type_hash = cg_owned_drop_type_hash(ty)
  if type_hash == 0 { 0 }
  else { if cg_owned_drop_has_method(fm, ty) == 1 {
    cg_cleanup_push_owned_drop(fm, rid, type_hash)
  } else { 0 } }
}

fn cg_cleanup_push_for_ty(fm: i64, ty: i64, rid: i64) -> i64 {
  cg_cleanup_push_for_ty_sized(fm, ty, rid, cg_managed_reuse_static_release_size_for_ty(ty))
}

fn cg_cleanup_push_for_ty_sized(fm: i64, ty: i64, rid: i64, payload_size: i64) -> i64 {
  let kind = cg_managed_drop_kind_for_ty(ty)
  if kind == continuation_cleanup_kind_rc() { cg_cleanup_push_rc_sized(fm, rid, payload_size) }
  else { if kind == continuation_cleanup_kind_closure() { cg_cleanup_push_closure_sized(fm, rid, payload_size) }
  else { if kind == continuation_cleanup_kind_weak() { cg_cleanup_push_weak_sized(fm, rid, payload_size) }
  else { 0 } } }
}

fn cg_cleanup_descriptor_kind(entry: i64) -> i64 {
  match node_f3(entry) {
    1 -> continuation_cleanup_kind_rc()
    2 -> continuation_cleanup_kind_closure()
    4 -> continuation_cleanup_kind_weak()
    _ -> continuation_cleanup_kind_none()
  }
}

fn cg_cleanup_restore(fm: i64, depth: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  nlist_set_len(stack, depth)
  0
}

fn ffv_add_name(ns: i64, nl: i64, local_scope: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  if scope_lookup(local_scope, src, ns, nl) != 0 - 999 { 0 }
  else {
    if scope_lookup(enclosing_scope, src, ns, nl) == 0 - 999 { 0 }
    else {
      let mut found = false
      let mut i = 0
      while i < nlist_len(fv) {
        let e = nlist_get(fv, i)
        if node_f2(e) == nl {
          if src_eq_at(src, ns, src + node_f1(e), 0, nl) == 1 { found = true i = nlist_len(fv) }
          else { i = i + 1 }
        } else { i = i + 1 }
      }
      if not found { nlist_add(fv, node_new(2, ns, nl, 0, 0)) } else { 0 }
    }
  }
}

fn ffv_add_ident(node: i64, local_scope: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  ffv_add_name(node_f1(node), node_f2(node), local_scope, enclosing_scope, src, fv)
}

fn ffv_push(work: i64, scopes: i64, node: i64, scope: i64) -> i64 {
  if node != 0 {
    nlist_add(work, node)
    nlist_add(scopes, scope)
  } else { 0 }
}

fn ffv_push_list(work: i64, scopes: i64, nodes: i64, n: i64, scope: i64) -> i64 {
  for i in 0..n { ffv_push(work, scopes, nlist_get(nodes, i), scope) }
  0
}

fn ffv_bind_pattern(pat: i64, scope: i64, src: i64) -> i64 {
  let tag = node_tag(pat)
  match tag {
    18 -> scope_push(scope, node_f1(pat), node_f2(pat), 0)
    20 -> {
      let b_ns = node_f3(pat)
      let b_nl = node_f4(pat)
      if b_nl > 0 {
        scope_push(scope, b_ns, b_nl, 0)
      } else { if b_nl < 0 {
        let bindings = b_ns
        let nb = 0 - b_nl
        let mut result = scope
        for i in 0..nb {
          let b = nlist_get(bindings, i)
          if node_tag(b) == 18 {
            result = scope_push(result, node_f1(b), node_f2(b), 0)
          } else { result = result }
        }
        result
      } else { scope } }
    }
    _ -> scope
  }
}

fn ffv_bind_params(params: i64, nparams: i64, scope: i64) -> i64 {
  let mut result = scope
  for i in 0..nparams {
    let p = nlist_get(params, i)
    result = scope_push(result, node_f1(p), node_f2(p), 0)
  }
  result
}

-- Walk AST using a worklist (iterative, avoids stack overflow)
fn find_free_vars(node: i64, ls: i64, enclosing_scope: i64, src: i64, fv: i64) -> i64 {
  let work = nlist_new()
  let scopes = nlist_new()
  ffv_push(work, scopes, node, ls)
  let mut wi = 0
  while wi < nlist_len(work) {
    let n = nlist_get(work, wi)
    let local_scope = nlist_get(scopes, wi)
    wi = wi + 1
    if n == 0 { 0 }
    else {
      let tag = node_tag(n)
      match tag {
        2 -> ffv_add_ident(n, local_scope, enclosing_scope, src, fv)
        3 -> {
          ffv_push(work, scopes, node_f2(n), local_scope)
          ffv_push(work, scopes, node_f3(n), local_scope)
        }
        4 -> {
          ffv_add_name(node_f1(n), node_f2(n), local_scope, enclosing_scope, src, fv)
          ffv_push_list(work, scopes, node_f3(n), node_f4(n), local_scope)
        }
        5 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push(work, scopes, node_f2(n), local_scope)
          ffv_push(work, scopes, node_f3(n), local_scope)
        }
        6 -> {
          ffv_push(work, scopes, node_f3(n), local_scope)
          ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        7 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push(work, scopes, node_f2(n), local_scope)
        }
        10 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push(work, scopes, node_f2(n), local_scope)
        }
        11 -> {
          ffv_push(work, scopes, node_f3(n), local_scope)
          ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        12 -> {
          ffv_add_name(node_f1(n), node_f2(n), local_scope, enclosing_scope, src, fv)
          ffv_push(work, scopes, node_f3(n), local_scope)
        }
        15 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          let arms = node_f2(n)
          let narms = node_f3(n)
          for mi in 0..narms {
            let arm = nlist_get(arms, mi)
            let arm_scope = ffv_bind_pattern(node_f1(arm), local_scope, src)
            ffv_push(work, scopes, node_f2(arm), arm_scope)
          }
          0
        }
        22 -> ffv_push(work, scopes, node_f1(n), local_scope)
        25 -> ffv_push(work, scopes, node_f1(n), local_scope)
        29 -> {
          let nested_scope = ffv_bind_params(node_f1(n), node_f3(n), local_scope)
          ffv_push(work, scopes, node_f2(n), nested_scope)
        }
        32 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push_list(work, scopes, node_f4(n), nlist_len(node_f4(n)), local_scope)
        }
        36 -> {
          let inner_call = node_f2(n)
          ffv_add_name(node_f1(inner_call), node_f2(inner_call), local_scope, enclosing_scope, src, fv)
          ffv_push_list(work, scopes, node_f3(inner_call), node_f4(inner_call), local_scope)
        }
        41 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push_list(work, scopes, node_f3(n), nlist_len(node_f3(n)), local_scope)
        }
        45 -> ffv_push(work, scopes, node_f1(n), local_scope)
        46 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push(work, scopes, node_f2(n), local_scope)
        }
        47 -> {
          ffv_push(work, scopes, node_f3(n), local_scope)
          ffv_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        48 -> ffv_push(work, scopes, node_f1(n), local_scope)
        49 -> ffv_push(work, scopes, node_f1(n), local_scope)
        52 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          ffv_push(work, scopes, node_f2(n), local_scope)
        }
        33 -> {
          ffv_push(work, scopes, node_f1(n), local_scope)
          let clauses = node_f2(n)
          let nclauses = node_f3(n)
          for ci in 0..nclauses {
            let clause = nlist_get(clauses, ci)
            let param_scope = ffv_bind_params(node_f2(clause), nlist_len(node_f2(clause)), local_scope)
            let cont = node_f4(clause)
            let clause_scope = if cont == 0 { param_scope } else { scope_push(param_scope, node_f1(cont), node_f2(cont), cg_continuation_reg()) }
            ffv_push(work, scopes, node_f3(clause), clause_scope)
          }
          0
        }
        35 -> ffv_push(work, scopes, node_f1(n), local_scope)
        37 -> {
          let inner = node_f1(n)
          ffv_push(work, scopes, node_f3(inner), local_scope)
          ffv_push(work, scopes, node_f4(inner), scope_push(local_scope, node_f1(inner), node_f2(inner), 0))
        }
        _ -> 0
      }
    }
  }
  0
}

fn cg_lambda_free_var_fact_map_prepend(lambda: i64, src: i64, free_vars: i64, rest: i64) -> i64 {
  node_new(0, lambda, src, 0, node_new(0, free_vars, rest, 0, 0))
}

fn cg_lambda_free_vars_compute(lambda: i64, scope: i64, src: i64) -> i64 {
  let params = node_f1(lambda)
  let body = node_f2(lambda)
  let nparams = node_f3(lambda)
  let lambda_scope = ffv_bind_params(params, nparams, scope_new())
  let free_vars = nlist_new()
  find_free_vars(body, lambda_scope, scope, src, free_vars)
  free_vars
}

fn cg_lambda_free_var_fact_push(work: i64, scopes: i64, node: i64, scope: i64) -> i64 {
  ffv_push(work, scopes, node, scope)
}

fn cg_lambda_free_var_fact_push_list(work: i64, scopes: i64, nodes: i64, n: i64, scope: i64) -> i64 {
  ffv_push_list(work, scopes, nodes, n, scope)
}

fn cg_lambda_free_var_facts_collect_expr(node: i64, lexical_scope: i64, src: i64, facts: i64, count: i64) -> i64 {
  let work = nlist_new()
  let scopes = nlist_new()
  cg_lambda_free_var_fact_push(work, scopes, node, lexical_scope)
  let mut result_facts = facts
  let mut result_count = count
  let mut wi = 0
  while wi < nlist_len(work) {
    let n = nlist_get(work, wi)
    let local_scope = nlist_get(scopes, wi)
    wi = wi + 1
    if n == 0 { 0 }
    else {
      let tag = node_tag(n)
      match tag {
        3 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
        }
        4 -> cg_lambda_free_var_fact_push_list(work, scopes, node_f3(n), node_f4(n), local_scope)
        5 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
        }
        6 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        7 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
        }
        10 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
        }
        11 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        12 -> cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
        15 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          let arms = node_f2(n)
          let narms = node_f3(n)
          for mi in 0..narms {
            let arm = nlist_get(arms, mi)
            let arm_scope = ffv_bind_pattern(node_f1(arm), local_scope, src)
            cg_lambda_free_var_fact_push(work, scopes, node_f2(arm), arm_scope)
          }
          0
        }
        22 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        25 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        29 -> {
          let free_vars = cg_lambda_free_vars_compute(n, local_scope, src)
          result_facts = cg_lambda_free_var_fact_map_prepend(n, src, free_vars, result_facts)
          result_count = result_count + 1
          let nested_scope = ffv_bind_params(node_f1(n), node_f3(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), nested_scope)
        }
        32 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push_list(work, scopes, node_f4(n), nlist_len(node_f4(n)), local_scope)
        }
        33 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          let clauses = node_f2(n)
          let nclauses = node_f3(n)
          for ci in 0..nclauses {
            let clause = nlist_get(clauses, ci)
            let param_scope = ffv_bind_params(node_f2(clause), nlist_len(node_f2(clause)), local_scope)
            let cont = node_f4(clause)
            let clause_scope = if cont == 0 { param_scope } else { scope_push(param_scope, node_f1(cont), node_f2(cont), cg_continuation_reg()) }
            cg_lambda_free_var_fact_push(work, scopes, node_f3(clause), clause_scope)
          }
          0
        }
        35 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        36 -> {
          let inner_call = node_f2(n)
          cg_lambda_free_var_fact_push_list(work, scopes, node_f3(inner_call), node_f4(inner_call), local_scope)
        }
        37 -> {
          let inner = node_f1(n)
          cg_lambda_free_var_fact_push(work, scopes, node_f3(inner), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f4(inner), scope_push(local_scope, node_f1(inner), node_f2(inner), 0))
        }
        41 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push_list(work, scopes, node_f3(n), nlist_len(node_f3(n)), local_scope)
        }
        45 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        46 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
        }
        47 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f3(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f4(n), scope_push(local_scope, node_f1(n), node_f2(n), 0))
        }
        48 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        49 -> cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
        52 -> {
          cg_lambda_free_var_fact_push(work, scopes, node_f1(n), local_scope)
          cg_lambda_free_var_fact_push(work, scopes, node_f2(n), local_scope)
        }
        _ -> 0
      }
    }
  }
  node_new(0, result_facts, result_count, 0, 0)
}

fn cg_lambda_free_var_facts_from_fns(fns: i64) -> i64 {
  let mut facts = 0
  let mut count = 0
  let n = nlist_len(fns)
  for i in 0..n {
    let pair = nlist_get(fns, i)
    let fn_wrap = node_f1(pair)
    let fn_node = unwrap_fn(fn_wrap)
    let fn_src = node_f2(pair)
    if fn_node != 0 and node_tag(fn_node) == 8 {
      let params = node_f3(fn_node)
      let body = node_f4(fn_node)
      let scope = ffv_bind_params(params, nlist_len(params), scope_new())
      let result = cg_lambda_free_var_facts_collect_expr(body, scope, fn_src, facts, count)
      facts = node_f1(result)
      count = node_f2(result)
    } else { 0 }
  }
  node_new(0, facts, count, 0, 0)
}

-- ======================================================================
-- Lambda codegen
-- ======================================================================
fn cg_continuation_reg() -> i64 { 0 - 7777 }

fn cg_cleanup_kind_for_rid(fm: i64, rid: i64) -> i64 {
  let stack = cg_cleanup_stack(fm)
  let n = nlist_len(stack)
  let mut result = continuation_cleanup_kind_none()
  let mut i = 0
  while i < n {
    let entry = nlist_get(stack, i)
    if node_f1(entry) == rid {
      let kind = cg_cleanup_descriptor_kind(entry)
      if kind != continuation_cleanup_kind_none() {
        result = kind
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn cg_emit_managed_retain_kind_regid(code: i64, fm: i64, kind: i64, rid: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() {
    cg_emit_rc_retain_regid(code, fm, rid)
  } else { if kind == continuation_cleanup_kind_closure() {
    cg_emit_closure_retain_regid(code, fm, rid)
  } else { if kind == continuation_cleanup_kind_weak() {
    cg_emit_weak_retain_regid(code, fm, rid)
  } else { 0 } } }
}

fn cg_hclause_store_x0(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
}

-- Fill ops array entries for all handler clauses
fn cg_hbuild_frame(code: i64, eff_hash: i64, nclauses: i64, ops_ctr: i64) -> i64 {
  cg_hbuild_frame_maybe_abort(code, eff_hash, nclauses, ops_ctr, 0)
}

-- 4j: `has_abortive` selects the extended frame. When 0 the emitted code
-- is byte-identical to pre-4j output (same allocation size, same stores),
-- so non-abortive handlers pay nothing. When 1 the frame additionally
-- captures sp and x19-x30, with the abort landing address occupying the
-- x30 slot — see runtime/effects.weft for why. Returns the code position
-- of the ADR that materialises that address (0 when not abortive) so the
-- caller can patch it once the landing block's offset is known.
fn cg_hbuild_frame_maybe_abort(code: i64, eff_hash: i64, nclauses: i64, ops_ctr: i64, has_abortive: i64) -> i64 {
  -- Allocate handler frame from bump allocator
  cg_bump_alloc_imm(code, 16, if has_abortive == 1 { handler_frame_abort_size() } else { handler_frame_size() })
  -- Save frame_ptr to x15 (x16 may be clobbered by emit_load_reg)
  bu32(code, encode_add_imm(15, 16, 0))
  -- Store eff_hash
  emit_mov_imm_safe(code, 17, eff_hash)
  bu32(code, cg_str(17, 15, handler_frame_eff_hash_offset()))
  -- Store num_ops
  emit_mov_imm_safe(code, 17, nclauses)
  bu32(code, cg_str(17, 15, handler_frame_num_ops_offset()))
  -- Store ops_ptr (emit_load_reg may use x16, so we use x15 as frame base)
  let ops_phys = emit_load_reg(code, ops_ctr)
  bu32(code, cg_str(ops_phys, 15, handler_frame_ops_offset()))
  -- Store prev = x27
  bu32(code, cg_str(27, 15, handler_frame_prev_offset()))
  -- 4j: capture the abort state BEFORE the push, so the saved x27 is the
  -- enclosing frame and restoring it pops this handler automatically.
  let adr_pos = if has_abortive == 1 {
    cg_fiber_save_sp(code, 15, handler_frame_abort_sp_offset())
    let pos = buf_len(code)
    bu32(code, 0)
    cg_fiber_save_regs(code, 15, handler_frame_abort_regs_offset(), 17)
    pos
  } else { 0 }
  -- Push: x27 = frame_ptr
  bu32(code, encode_add_imm(27, 15, 0))
  adr_pos
}

-- 4j: restore the handle site's machine state from an extended frame and
-- `ret` — which lands at the abort block, because the x30 slot holds its
-- address. `value_reg` carries the aborting clause's value into x0.
-- Mirrors cg_fiber_restore_handler_and_ret.
fn cg_habort_restore_and_ret(code: i64, frame_reg: i64, value_reg: i64) -> i64 {
  if frame_reg != 9 { bu32(code, encode_add_imm(9, frame_reg, 0)) } else { 0 }
  if value_reg != 11 { bu32(code, encode_add_imm(11, value_reg, 0)) } else { 0 }
  bu32(code, cg_ldr(10, 9, handler_frame_abort_sp_offset()))
  cg_fiber_restore_regs(code, 9, handler_frame_abort_regs_offset())
  cg_fiber_restore_sp_from(code, 10)
  bu32(code, encode_add_imm(0, 11, 0))
  bu32(code, encode_ret())
}

fn cg_perform_lookup(code: i64, fm: i64, eff_hash: i64, op_hash: i64) -> i64 {
  bu32(code, encode_add_imm(0, 27, 0))
  emit_mov_imm_safe(code, 1, eff_hash)
  emit_mov_imm_safe(code, 2, op_hash)
  cg_emit_call_lit(code, fm, "handler_find_entry")
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  let jump_found_pos = buf_len(code)
  bu32(code, 0)
  let trap = buf_len(code)
  bu32(code, encode_brk(2))
  let found = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 0, trap)
  cg_patch_b(code, jump_found_pos, found)
  bu32(code, encode_add_imm(13, 0, 0))
  0
}

fn cg_effect_op_ret_type(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { 0 }
    else {
      let kind = mem_load64_at(entry + 16, 0)
      if kind != 2 { 0 }
      else {
        let entry_src = mem_load64_at(entry + 48, 0)
        let nops = mem_load64_at(entry + 24, 0)
        let ops = mem_load64_at(entry + 32, 0)
        let op_hash = str_hash(src, op_ns, op_nl)
        let mut i = 0
        let mut result = 0
        while i < nops {
          let op = nlist_get(ops, i)
          if str_hash(entry_src, node_f1(op), node_f2(op)) == op_hash {
            let meta = node_f4(op)
            result = if meta == 0 { 0 }
              else { if node_tag(meta) == 53 { node_f1(meta) } else { meta } }
            i = nops
          } else {
            i = i + 1
          }
        }
        result
      }
    }
  }
}

fn cg_i64_pow2(exp: i64) -> i64 {
  let mut v = 1
  let mut i = 0
  while i < exp {
    v = v * 2
    i = i + 1
  }
  v
}

fn cg_i64_cmp(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

fn cg_i64_mul_checked(a: i64, b: i64) -> i64 {
  if a == 0 or b == 0 { 0 }
  else {
    if a > 9223372036854775807 / b { 0 - 1 } else { a * b }
  }
}

fn cg_i64_pow5_checked(exp: i64) -> i64 {
  if exp < 0 or exp > 27 { 0 - 1 }
  else {
    let mut v = 1
    let mut i = 0
    while i < exp {
      v = v * 5
      i = i + 1
    }
    v
  }
}

fn cg_i64_mul_pow2_clamped(value: i64, shift: i64) -> i64 {
  let mut v = value
  let mut i = 0
  let mut overflow = 0
  while i < shift {
    if v > 4611686018427387903 {
      overflow = 1
      i = shift
    } else {
      v = v * 2
      i = i + 1
    }
  }
  if overflow == 1 { 0 - 1 } else { v }
}

fn cg_big_base() -> i64 { 1073741824 }

fn cg_big_new(cap0: i64) -> i64 {
  let cap = if cap0 < 1 { 1 } else { cap0 }
  let h = cg_alloc_bytes(24)
  let d = cg_alloc_bytes(cap * 8)
  mem_store64_at(h, 0, d)
  mem_store64_at(h + 8, 0, 0)
  mem_store64_at(h + 16, 0, cap)
  h
}

fn cg_big_data(b: i64) -> i64 { mem_load64_at(b, 0) }
fn cg_big_len(b: i64) -> i64 { mem_load64_at(b + 8, 0) }
fn cg_big_set_len(b: i64, n: i64) -> i64 { mem_store64_at(b + 8, 0, n) 0 }

fn cg_big_zero_fill(b: i64, n: i64) -> i64 {
  let d = cg_big_data(b)
  let mut i = 0
  while i < n {
    mem_store64_at(d + i * 8, 0, 0)
    i = i + 1
  }
  0
}

fn cg_big_normalize(b: i64) -> i64 {
  let d = cg_big_data(b)
  let mut n = cg_big_len(b)
  while n > 0 and mem_load64_at(d + (n - 1) * 8, 0) == 0 {
    n = n - 1
  }
  cg_big_set_len(b, n)
  b
}

fn cg_big_from_i64(value: i64) -> i64 {
  let b = cg_big_new(4)
  let d = cg_big_data(b)
  let base = cg_big_base()
  let mut v = value
  let mut n = 0
  while v > 0 {
    mem_store64_at(d + n * 8, 0, v % base)
    v = v / base
    n = n + 1
  }
  cg_big_set_len(b, n)
  b
}

fn cg_big_mul_small(a: i64, m: i64) -> i64 {
  let n = cg_big_len(a)
  if n == 0 or m == 0 { cg_big_from_i64(0) }
  else {
    let r = cg_big_new(n + 4)
    let ad = cg_big_data(a)
    let rd = cg_big_data(r)
    let base = cg_big_base()
    let mut carry = 0
    let mut i = 0
    while i < n {
      let cur = mem_load64_at(ad + i * 8, 0) * m + carry
      mem_store64_at(rd + i * 8, 0, cur % base)
      carry = cur / base
      i = i + 1
    }
    let mut out_len = n
    while carry > 0 {
      mem_store64_at(rd + out_len * 8, 0, carry % base)
      carry = carry / base
      out_len = out_len + 1
    }
    cg_big_set_len(r, out_len)
    cg_big_normalize(r)
  }
}

fn cg_big_add_small(a: i64, m: i64) -> i64 {
  let n = cg_big_len(a)
  let r = cg_big_new(n + 4)
  let ad = cg_big_data(a)
  let rd = cg_big_data(r)
  let base = cg_big_base()
  let mut carry = m
  let mut i = 0
  while i < n {
    let cur = mem_load64_at(ad + i * 8, 0) + carry
    mem_store64_at(rd + i * 8, 0, cur % base)
    carry = cur / base
    i = i + 1
  }
  let mut out_len = n
  while carry > 0 {
    mem_store64_at(rd + out_len * 8, 0, carry % base)
    carry = carry / base
    out_len = out_len + 1
  }
  cg_big_set_len(r, out_len)
  cg_big_normalize(r)
}

fn cg_big_mul_pow5(a: i64, exp: i64) -> i64 {
  let mut r = a
  let mut i = 0
  while i < exp {
    r = cg_big_mul_small(r, 5)
    i = i + 1
  }
  r
}

fn cg_big_shl(a: i64, bits: i64) -> i64 {
  let n = cg_big_len(a)
  if n == 0 { cg_big_from_i64(0) }
  else {
    let limb_shift = bits / 30
    let bit_shift = bits % 30
    let mul = cg_i64_pow2(bit_shift)
    let r = cg_big_new(n + limb_shift + 4)
    cg_big_zero_fill(r, n + limb_shift + 4)
    let ad = cg_big_data(a)
    let rd = cg_big_data(r)
    let base = cg_big_base()
    let mut carry = 0
    let mut i = 0
    while i < n {
      let cur = mem_load64_at(ad + i * 8, 0) * mul + carry
      mem_store64_at(rd + (i + limb_shift) * 8, 0, cur % base)
      carry = cur / base
      i = i + 1
    }
    let mut out_len = n + limb_shift
    while carry > 0 {
      mem_store64_at(rd + out_len * 8, 0, carry % base)
      carry = carry / base
      out_len = out_len + 1
    }
    cg_big_set_len(r, out_len)
    cg_big_normalize(r)
  }
}

fn cg_big_cmp(a: i64, b: i64) -> i64 {
  let an = cg_big_len(a)
  let bn = cg_big_len(b)
  if an < bn { 0 - 1 }
  else { if an > bn { 1 }
  else {
    let ad = cg_big_data(a)
    let bd = cg_big_data(b)
    let mut i = an
    let mut done = 0
    let mut r = 0
    while done == 0 {
      if i <= 0 { done = 1 }
      else {
        i = i - 1
        let av = mem_load64_at(ad + i * 8, 0)
        let bv = mem_load64_at(bd + i * 8, 0)
        if av < bv { r = 0 - 1 done = 1 }
        else { if av > bv { r = 1 done = 1 }
        else { 0 } }
      }
    }
    r
  } }
}

fn cg_i64_bit_length(v0: i64) -> i64 {
  let mut v = v0
  let mut n = 0
  while v > 0 {
    v = v / 2
    n = n + 1
  }
  n
}

fn cg_big_bit_length(a: i64) -> i64 {
  let n = cg_big_len(a)
  if n == 0 { 0 }
  else {
    let d = cg_big_data(a)
    (n - 1) * 30 + cg_i64_bit_length(mem_load64_at(d + (n - 1) * 8, 0))
  }
}

fn cg_big_add_product_at(r: i64, idx0: i64, limb: i64, chunk: i64) -> i64 {
  if chunk == 0 { 0 }
  else {
    let rd = cg_big_data(r)
    let base = cg_big_base()
    let mut idx = idx0
    let mut carry = limb * chunk
    while carry > 0 {
      let cur = mem_load64_at(rd + idx * 8, 0) + carry
      mem_store64_at(rd + idx * 8, 0, cur % base)
      carry = cur / base
      idx = idx + 1
    }
    0
  }
}

fn cg_big_mul_i64(a: i64, m: i64) -> i64 {
  let n = cg_big_len(a)
  if n == 0 or m == 0 { cg_big_from_i64(0) }
  else {
    let base = cg_big_base()
    let c0 = m % base
    let c1 = (m / base) % base
    let c2 = m / (base * base)
    let r = cg_big_new(n + 5)
    cg_big_zero_fill(r, n + 5)
    let ad = cg_big_data(a)
    let mut i = 0
    while i < n {
      let limb = mem_load64_at(ad + i * 8, 0)
      cg_big_add_product_at(r, i, limb, c0)
      cg_big_add_product_at(r, i + 1, limb, c1)
      cg_big_add_product_at(r, i + 2, limb, c2)
      i = i + 1
    }
    cg_big_set_len(r, n + 5)
    cg_big_normalize(r)
  }
}

fn cg_big_floor_div_to_i64(num: i64, den: i64, max_q: i64) -> i64 {
  let mut lo = 0
  let mut hi = max_q
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    let prod = cg_big_mul_i64(den, mid)
    if cg_big_cmp(prod, num) <= 0 {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  lo
}

fn cg_big_round_scaled_quotient(a: i64, d: i64, shift: i64, max_q: i64) -> i64 {
  let num = if shift >= 0 { cg_big_shl(a, shift) } else { a }
  let den = if shift >= 0 { d } else { cg_big_shl(d, 0 - shift) }
  let q = cg_big_floor_div_to_i64(num, den, max_q)
  let left = cg_big_shl(num, 1)
  let right = cg_big_mul_i64(den, q * 2 + 1)
  let cmp = cg_big_cmp(left, right)
  if cmp > 0 {
    q + 1
  } else {
    if cmp == 0 and q % 2 == 1 { q + 1 } else { q }
  }
}

fn cg_decimal_exp_pos(src: i64, start: i64, len: i64) -> i64 {
  let mut p = 0
  let mut found = 0 - 1
  while p < len {
    let ch = mem_load8_at(src + start + p, 0)
    if ch == 101 or ch == 69 {
      found = p
      p = len
    } else {
      p = p + 1
    }
  }
  found
}

fn cg_decimal_parse_exponent(src: i64, start: i64, len: i64, exp_pos: i64) -> i64 {
  if exp_pos < 0 { 0 }
  else {
    let mut p = exp_pos + 1
    let mut sign = 1
    if p < len {
      let ch = mem_load8_at(src + start + p, 0)
      if ch == 45 { sign = 0 - 1 p = p + 1 }
      else { if ch == 43 { p = p + 1 } else { 0 } }
    } else { 0 }
    let mut v = 0
    while p < len {
      if v < 10000 { v = v * 10 + mem_load8_at(src + start + p, 0) - 48 } else { 0 }
      p = p + 1
    }
    v * sign
  }
}

fn cg_decimal_big_info(src: i64, start: i64, len: i64) -> i64 {
  let exp_pos = cg_decimal_exp_pos(src, start, len)
  let mant_end = if exp_pos >= 0 { exp_pos } else { len }
  let exp10_src = cg_decimal_parse_exponent(src, start, len, exp_pos)
  let mut dot = 0 - 1
  let mut last_nonzero = 0 - 1
  let mut i = 0
  while i < mant_end {
    let ch = mem_load8_at(src + start + i, 0)
    if ch == 46 { dot = i }
    else { if ch != 48 { last_nonzero = i } else { 0 } }
    i = i + 1
  }
  if last_nonzero < 0 {
    node_new(0, cg_big_from_i64(0), 0, 1, 1)
  } else {
    let last_sig = if dot >= 0 {
      if last_nonzero > dot { last_nonzero } else { dot - 1 }
    } else { mant_end - 1 }
    let mut n = cg_big_from_i64(0)
    let mut frac_digits = 0
    let mut seen = 0
    let mut after_dot = false
    let mut j = 0
    while j <= last_sig {
      let ch = mem_load8_at(src + start + j, 0)
      if ch == 46 {
        after_dot = true
      } else {
        if after_dot { frac_digits = frac_digits + 1 } else { 0 }
        if seen == 1 or ch != 48 {
          seen = 1
          n = cg_big_add_small(cg_big_mul_small(n, 10), ch - 48)
        } else { 0 }
      }
      j = j + 1
    }
    node_new(0, n, exp10_src - frac_digits, 1, 0)
  }
}

fn cg_decimal_cmp_pow2_big(a: i64, d: i64, bin_shift: i64, e: i64) -> i64 {
  let min_shift = if bin_shift < e { bin_shift } else { e }
  let left = cg_big_shl(a, bin_shift - min_shift)
  let right = cg_big_shl(d, e - min_shift)
  cg_big_cmp(left, right)
}

fn cg_decimal_binary_exponent_big(a: i64, d: i64, bin_shift: i64) -> i64 {
  let mut e = cg_big_bit_length(a) - cg_big_bit_length(d) + bin_shift
  while cg_decimal_cmp_pow2_big(a, d, bin_shift, e + 1) >= 0 {
    e = e + 1
  }
  while cg_decimal_cmp_pow2_big(a, d, bin_shift, e) < 0 {
    e = e - 1
  }
  e
}

fn cg_decimal_small_info(src: i64, start: i64, len: i64) -> i64 {
  let exp_pos = cg_decimal_exp_pos(src, start, len)
  let mant_end = if exp_pos >= 0 { exp_pos } else { len }
  let exp10_src = cg_decimal_parse_exponent(src, start, len, exp_pos)
  let mut dot = 0 - 1
  let mut last_nonzero = 0 - 1
  let mut i = 0
  while i < mant_end {
    let ch = mem_load8_at(src + start + i, 0)
    if ch == 46 { dot = i }
    else { if ch != 48 { last_nonzero = i } else { 0 } }
    i = i + 1
  }
  if last_nonzero < 0 {
    node_new(0, 0, 0, 1, 1)
  } else {
    let last_sig = if dot >= 0 {
      if last_nonzero > dot { last_nonzero } else { dot - 1 }
    } else { mant_end - 1 }
    let mut n = 0
    let mut frac_digits = 0
    let mut sig = 0
    let mut seen = 0
    let mut after_dot = false
    let mut overflow = 0
    let mut j = 0
    while j <= last_sig {
      let ch = mem_load8_at(src + start + j, 0)
      if ch == 46 {
        after_dot = true
      } else {
        if after_dot { frac_digits = frac_digits + 1 } else { 0 }
        if seen == 1 or ch != 48 {
          seen = 1
          if sig >= 18 {
            overflow = 1
          } else {
            n = n * 10 + ch - 48
            sig = sig + 1
          }
        } else { 0 }
      }
      j = j + 1
    }
    let exp10 = exp10_src - frac_digits
    let ok = if overflow == 0 and exp10 >= 0 - 27 and exp10 <= 27 { 1 } else { 0 }
    node_new(0, n, exp10, ok, 0)
  }
}

fn cg_decimal_cmp_pow2_small(n: i64, den: i64, bin_shift: i64, e: i64) -> i64 {
  let k = e - bin_shift
  if k >= 0 {
    let rhs = cg_i64_mul_pow2_clamped(den, k)
    if rhs < 0 { 0 - 1 } else { cg_i64_cmp(n, rhs) }
  } else {
    let lhs = cg_i64_mul_pow2_clamped(n, 0 - k)
    if lhs < 0 { 1 } else { cg_i64_cmp(lhs, den) }
  }
}

fn cg_decimal_binary_exponent_small(n: i64, den: i64, bin_shift: i64) -> i64 {
  let mut e = cg_i64_bit_length(n) - cg_i64_bit_length(den) + bin_shift
  while cg_decimal_cmp_pow2_small(n, den, bin_shift, e + 1) >= 0 {
    e = e + 1
  }
  while cg_decimal_cmp_pow2_small(n, den, bin_shift, e) < 0 {
    e = e - 1
  }
  e
}

fn cg_decimal_round_scaled_quotient_small(n: i64, den0: i64, shift: i64, max_q: i64) -> i64 {
  let mut q = 0
  let mut rem = 0
  let mut den = den0
  if shift >= 0 {
    q = n / den
    rem = n - q * den
    let mut i = 0
    let mut ok = 1
    while i < shift and ok == 1 {
      if rem >= den - rem {
        rem = rem - (den - rem)
        q = q * 2 + 1
      } else {
        rem = rem + rem
        q = q * 2
      }
      if q > max_q { ok = 0 } else { 0 }
      i = i + 1
    }
    if ok == 0 { node_new(0, 0, 0, 0, 0) }
    else {
      let half = den / 2
      if rem > half { q = q + 1 }
      else { if den % 2 == 0 and rem == half and q % 2 == 1 { q = q + 1 } else { 0 } }
      if q > max_q { node_new(0, 0, 0, 0, 0) } else { node_new(0, q, 1, 0, 0) }
    }
  } else {
    den = cg_i64_mul_pow2_clamped(den, 0 - shift)
    if den < 0 { node_new(0, 0, 0, 0, 0) }
    else {
      q = n / den
      rem = n - q * den
      let half = den / 2
      if rem > half { q = q + 1 }
      else { if den % 2 == 0 and rem == half and q % 2 == 1 { q = q + 1 } else { 0 } }
      if q > max_q { node_new(0, 0, 0, 0, 0) } else { node_new(0, q, 1, 0, 0) }
    }
  }
}

fn cg_decimal_ieee_bits_small(src: i64, start: i64, len: i64, frac_bits: i64, bias: i64) -> i64 {
  let info = cg_decimal_small_info(src, start, len)
  let n0 = node_f1(info)
  let exp10 = node_f2(info)
  let ok = node_f3(info)
  if ok != 1 {
    node_new(0, 0, 0, 0, 0)
  } else { if node_f4(info) == 1 {
    node_new(0, 0, 1, 0, 0)
  } else {
    let pow5 = cg_i64_pow5_checked(if exp10 >= 0 { exp10 } else { 0 - exp10 })
    if pow5 < 0 {
      node_new(0, 0, 0, 0, 0)
    } else {
      let n = if exp10 >= 0 { cg_i64_mul_checked(n0, pow5) } else { n0 }
      if n < 0 {
        node_new(0, 0, 0, 0, 0)
      } else {
        let den = if exp10 >= 0 { 1 } else { pow5 }
        let bin_shift = exp10
        let base = cg_i64_pow2(frac_bits)
        let max_exp = bias * 2 + 1
        let mut e = cg_decimal_binary_exponent_small(n, den, bin_shift)
        let mut exp = e + bias
        if exp <= 0 or exp >= max_exp {
          node_new(0, 0, 0, 0, 0)
        } else {
          let shift = bin_shift + frac_bits - e
          let rounded = cg_decimal_round_scaled_quotient_small(n, den, shift, base * 2)
          if node_f2(rounded) != 1 {
            node_new(0, 0, 0, 0, 0)
          } else {
            let mut mant = node_f1(rounded)
            if mant >= base * 2 {
              mant = mant / 2
              e = e + 1
              exp = e + bias
            } else { 0 }
            if exp <= 0 or exp >= max_exp {
              node_new(0, 0, 0, 0, 0)
            } else {
              node_new(0, exp * base + mant - base, 1, 0, 0)
            }
          }
        }
      }
    }
  } }
}

fn cg_decimal_ieee_bits_big(src: i64, start: i64, len: i64, frac_bits: i64, bias: i64) -> i64 {
  let info = cg_decimal_big_info(src, start, len)
  let n0 = node_f1(info)
  let exp10 = node_f2(info)
  let ok = node_f3(info)
  if ok != 1 {
    node_new(0, 0, 0, 0, 0)
  } else { if node_f4(info) == 1 {
    node_new(0, 0, 1, 0, 0)
  } else {
    let base = cg_i64_pow2(frac_bits)
    let max_exp = bias * 2 + 1
    let n = if exp10 >= 0 { cg_big_mul_pow5(n0, exp10) } else { n0 }
    let den = if exp10 >= 0 { cg_big_from_i64(1) } else { cg_big_mul_pow5(cg_big_from_i64(1), 0 - exp10) }
    let bin_shift = exp10
    let mut e = cg_decimal_binary_exponent_big(n, den, bin_shift)
    let mut exp = e + bias
    if exp >= max_exp {
      node_new(0, max_exp * base, 1, 0, 0)
    } else {
      if exp <= 0 {
        let sub_shift = bin_shift + frac_bits + bias - 1
        let sub_mant = cg_big_round_scaled_quotient(n, den, sub_shift, base)
        if sub_mant <= 0 {
          node_new(0, 0, 1, 0, 0)
        } else {
          if sub_mant >= base {
            node_new(0, base, 1, 0, 0)
          } else {
            node_new(0, sub_mant, 1, 0, 0)
          }
        }
      } else {
        let shift = bin_shift + frac_bits - e
        let mut mant = cg_big_round_scaled_quotient(n, den, shift, base * 2)
        if mant >= base * 2 {
          mant = mant / 2
          e = e + 1
          exp = e + bias
        } else { 0 }
        if exp >= max_exp {
          node_new(0, max_exp * base, 1, 0, 0)
        } else {
          node_new(0, exp * base + mant - base, 1, 0, 0)
        }
      }
    }
  } }
}

fn cg_decimal_ieee_bits(src: i64, start: i64, len: i64, frac_bits: i64, bias: i64) -> i64 {
  let fast = cg_decimal_ieee_bits_small(src, start, len, frac_bits, bias)
  if node_f2(fast) == 1 { fast } else { cg_decimal_ieee_bits_big(src, start, len, frac_bits, bias) }
}

fn cg_decimal_f64_bits(src: i64, start: i64, len: i64) -> i64 {
  cg_decimal_ieee_bits(src, start, len, 52, 1023)
}

fn cg_decimal_f32_bits(src: i64, start: i64, len: i64) -> i64 {
  cg_decimal_ieee_bits(src, start, len, 23, 127)
}

fn cg_emit_int_normalize(code: i64, prim: i64, rd: i64) -> i64 {
  if prim == PRIM_I8() { bu32(code, encode_sxtb(rd, rd)) }
  else { if prim == PRIM_I16() { bu32(code, encode_sxth(rd, rd)) }
  else { if prim == PRIM_I32() { bu32(code, encode_sxtw(rd, rd)) }
  else { if prim == PRIM_U8() { bu32(code, encode_uxtb(rd, rd)) }
  else { if prim == PRIM_U16() { bu32(code, encode_uxth(rd, rd)) }
  else { if prim == PRIM_U32() { bu32(code, encode_uxtw(rd, rd)) }
  else { 0 } } } } } }
}

fn cg_binop_emit_typed(code: i64, op: i64, rd: i64, rn: i64, rm: i64, unsigned: i64) -> i64 {
  match op {
    1 -> bu32(code, encode_add_reg(rd, rn, rm))
    2 -> bu32(code, encode_sub_reg(rd, rn, rm))
    3 -> bu32(code, encode_mul(rd, rn, rm))
    4 -> if unsigned == 1 { bu32(code, encode_udiv(rd, rn, rm)) } else { bu32(code, encode_sdiv(rd, rn, rm)) }
    11 -> {
      -- Modulo: rd = rn - (rn/rm)*rm. Use x15 as temp for DIV result.
      if unsigned == 1 { bu32(code, encode_udiv(15, rn, rm)) } else { bu32(code, encode_sdiv(15, rn, rm)) }
      bu32(code, encode_msub(rd, 15, rm, rn))
    }
    12 -> bu32(code, encode_and_reg(rd, rn, rm))
    13 -> bu32(code, encode_orr_reg(rd, rn, rm))
    14 -> bu32(code, encode_and_reg(rd, rn, rm))
    15 -> bu32(code, encode_orr_reg(rd, rn, rm))
    16 -> bu32(code, encode_eor_reg(rd, rn, rm))
    17 -> bu32(code, encode_lsl_reg(rd, rn, rm))
    18 -> if unsigned == 1 { bu32(code, encode_lsr_reg(rd, rn, rm)) } else { bu32(code, encode_asr_reg(rd, rn, rm)) }
    _ -> cg_cmp_emit_typed(code, op, rd, rn, rm, unsigned)
  }
}

fn cg_binop_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  cg_binop_emit_typed(code, op, rd, rn, rm, 0)
}

fn cg_cmp_emit_typed(code: i64, op: i64, rd: i64, rn: i64, rm: i64, unsigned: i64) -> i64 {
  -- ==5 !=6 <7 >8 <=9 >=10
  bu32(code, encode_cmp(rn, rm))
  let cond = cg_cmp_cond_for_op(op, unsigned)
  bu32(code, encode_cset(rd, cond))
}

fn cg_cmp_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  cg_cmp_emit_typed(code, op, rd, rn, rm, 0)
}

-- ======================================================================
-- Intrinsics
-- ======================================================================

-- Intrinsic detection: name starts with __
fn is_intrinsic(src: i64, ns: i64, nl: i64) -> i64 {
  if nl < 2 { 0 }
  else {
    if mem_load8_at(src + ns, 0) == 95 {
      if mem_load8_at(src + ns + 1, 0) == 95 { 1 }
      else { 0 }
    } else { 0 }
  }
}

-- Move result from x17 to ctr register
fn cg_i_sized_load_or_byte(code: i64, off: i64, shift: i64) -> i64 {
  bu32(code, cg_ldrb(12, 0, off))
  if shift == 0 { bu32(code, encode_orr_reg(17, 17, 12)) }
  else {
    emit_mov_imm_safe(code, 13, shift)
    bu32(code, encode_lsl_reg(12, 12, 13))
    bu32(code, encode_orr_reg(17, 17, 12))
  }
}

fn cg_i_sized_store_byte(code: i64, off: i64, shift: i64) -> i64 {
  if shift == 0 { bu32(code, cg_strb(3, 0, off)) }
  else {
    bu32(code, encode_add_imm(12, 3, 0))
    emit_mov_imm_safe(code, 13, shift)
    bu32(code, encode_lsr_reg(12, 12, 13))
    bu32(code, cg_strb(12, 0, off))
  }
}

fn cg_emit_mem_copy_regs(code: i64, dst_reg: i64, src_reg: i64, size_reg: i64) -> i64 {
  emit_mov_imm_safe(code, 11, 0)
  let loop_start = buf_len(code)
  bu32(code, encode_cmp(11, size_reg))
  let done_pos = buf_len(code)
  bu32(code, 0)
  bu32(code, encode_add_reg(13, src_reg, 11))
  bu32(code, cg_ldrb(12, 13, 0))
  bu32(code, encode_add_reg(14, dst_reg, 11))
  bu32(code, cg_strb(12, 14, 0))
  bu32(code, encode_add_imm(11, 11, 1))
  let back_pos = buf_len(code)
  bu32(code, 0)
  cg_patch_b(code, back_pos, loop_start)
  let done = buf_len(code)
  cg_patch_b_cond(code, done_pos, 10, done)
}

fn cg_fiber_save_regs(code: i64, base_reg: i64, regs_off: i64, lr_reg: i64) -> i64 {
  for r in 19..29 {
    bu32(code, cg_str(r, base_reg, regs_off + (r - 19) * 8))
  }
  bu32(code, cg_str(29, base_reg, regs_off + 80))
  bu32(code, cg_str(lr_reg, base_reg, regs_off + 88))
}

fn cg_fiber_restore_regs(code: i64, base_reg: i64, regs_off: i64) -> i64 {
  for r in 19..29 {
    bu32(code, cg_ldr(r, base_reg, regs_off + (r - 19) * 8))
  }
  bu32(code, cg_ldr(29, base_reg, regs_off + 80))
  bu32(code, cg_ldr(30, base_reg, regs_off + 88))
}

fn cg_fiber_save_sp(code: i64, base_reg: i64, off: i64) -> i64 {
  bu32(code, encode_add_imm(13, 31, 0))
  bu32(code, cg_str(13, base_reg, off))
}

fn cg_fiber_restore_sp_from(code: i64, reg: i64) -> i64 {
  bu32(code, encode_add_imm(31, reg, 0))
}

fn cg_fiber_prompt_save_handler_state(code: i64, prompt_reg: i64, lr_reg: i64) -> i64 {
  cg_fiber_save_sp(code, prompt_reg, fiber_prompt_handler_sp_offset())
  cg_fiber_save_regs(code, prompt_reg, fiber_prompt_handler_regs_offset(), lr_reg)
  bu32(code, cg_ldr(13, 28, runtime_state_fiber_prompt_offset()))
  bu32(code, cg_str(13, prompt_reg, fiber_prompt_prev_prompt_offset()))
}

fn cg_fiber_segment_save_state(code: i64, segment_reg: i64, lr_reg: i64) -> i64 {
  cg_fiber_save_sp(code, segment_reg, fiber_segment_saved_sp_offset())
  cg_fiber_save_regs(code, segment_reg, fiber_segment_saved_regs_offset(), lr_reg)
}

fn cg_fiber_restore_handler_and_ret(code: i64, prompt_reg: i64, value_reg: i64) -> i64 {
  if prompt_reg != 9 { bu32(code, encode_add_imm(9, prompt_reg, 0)) } else { 0 }
  if value_reg != 11 { bu32(code, encode_add_imm(11, value_reg, 0)) } else { 0 }
  bu32(code, cg_ldr(10, 9, fiber_prompt_handler_sp_offset()))
  bu32(code, cg_ldr(13, 9, fiber_prompt_prev_prompt_offset()))
  bu32(code, cg_str(13, 28, runtime_state_fiber_prompt_offset()))
  cg_fiber_restore_regs(code, 9, fiber_prompt_handler_regs_offset())
  cg_fiber_restore_sp_from(code, 10)
  bu32(code, encode_add_imm(0, 11, 0))
  bu32(code, encode_ret())
}

fn cg_fiber_restore_fiber_and_ret(code: i64, segment_reg: i64, value_reg: i64) -> i64 {
  if segment_reg != 9 { bu32(code, encode_add_imm(9, segment_reg, 0)) } else { 0 }
  bu32(code, cg_ldr(10, 9, fiber_segment_saved_sp_offset()))
  bu32(code, cg_str(value_reg, 9, fiber_segment_saved_sp_offset()))
  cg_fiber_restore_regs(code, 9, fiber_segment_saved_regs_offset())
  cg_fiber_restore_sp_from(code, 10)
  bu32(code, cg_ldr(0, 9, fiber_segment_saved_sp_offset()))
  bu32(code, encode_ret())
}

fn interp_str_concat_hash() -> i64 {
  let mut h = 5381
  -- s=115, t=116, r=114, _=95, c=99, o=111, n=110, c=99, a=97, t=116
  h = h * 33 + 115
  h = h * 33 + 116
  h = h * 33 + 114
  h = h * 33 + 95
  h = h * 33 + 99
  h = h * 33 + 111
  h = h * 33 + 110
  h = h * 33 + 99
  h = h * 33 + 97
  h = h * 33 + 116
  h
}

-- Look up a function in fmap by name hash (for stdlib functions)
fn fmap_lookup_by_hash(fm: i64, target_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut result = 0
  while i < n {
    let owner_hash = mem_load64_at(d + i * 40 + 32, 0)
    if owner_hash == 0 {
      let e_ns = mem_load64_at(d + i * 40, 0)
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      let e_src = mem_load64_at(d + i * 40 + 24, 0)
      let fn_hash = str_hash(e_src, e_ns, e_nl)
      if fn_hash == target_hash {
        result = mem_load64_at(d + i * 40 + 16, 0)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

fn fmap_contains_hash(fm: i64, target_hash: i64) -> i64 {
  let n = mem_load64_at(fm + 8, 0)
  let d = mem_load64_at(fm, 0)
  let mut i = 0
  let mut found = 0
  while i < n and found == 0 {
    let owner_hash = mem_load64_at(d + i * 40 + 32, 0)
    if owner_hash == 0 {
      let e_ns = mem_load64_at(d + i * 40, 0)
      let e_nl = mem_load64_at(d + i * 40 + 8, 0)
      let e_src = mem_load64_at(d + i * 40 + 24, 0)
      if str_hash(e_src, e_ns, e_nl) == target_hash {
        found = 1
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  found
}

fn fmap_add_patch_by_hash(fm: i64, pos: i64, target_hash: i64) -> i64 {
  fmap_add_patch(fm, pos, 0, target_hash, 0)
  1
}

fn fmap_add_adr_patch_by_hash(fm: i64, pos: i64, target_hash: i64) -> i64 {
  fmap_add_patch(fm, pos, 0, target_hash, 0 - 1)
  1
}

fn fmap_add_branch_patch_by_hash(fm: i64, pos: i64, target_hash: i64) -> i64 {
  fmap_add_patch(fm, pos, 0, target_hash, 0 - 2)
  1
}

-- ======================================================================
-- Loop expression (tag 49)
-- ======================================================================

-- Tag 49 = LoopExpr(body)
-- Infinite loop. Value determined by break(expr).
-- break(expr) stores expr in the loop's result register and jumps out.
fn cg_call_node_name_is(call_node: i64, src: i64, name: str) -> i64 {
  if call_node == 0 { 0 }
  else { if node_tag(call_node) != 4 { 0 }
  else { src_eq(src, node_f1(call_node), node_f2(call_node), name) } }
}

fn cg_generic_call_name_is(node: i64, src: i64, name: str) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 36 { 0 }
  else { cg_call_node_name_is(node_f2(node), src, name) } }
}

fn cg_semantic_fact_size() -> i64 { 96 }
fn cg_semantic_fact_closed(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact, 0) } }
fn cg_semantic_fact_pure(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 8, 0) } }
fn cg_semantic_fact_has_alloc(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 24, 0) } }
fn cg_semantic_fact_has_unsafe(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 32, 0) } }
fn cg_semantic_fact_managed_param_mask(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 40, 0) } }
fn cg_semantic_fact_return_class(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 48, 0) } }
fn cg_semantic_fact_managed_return(fact: i64) -> i64 { if cg_semantic_fact_return_class(fact) == 1 { 1 } else { 0 } }
fn cg_semantic_fact_i64_return(fact: i64) -> i64 { if cg_semantic_fact_return_class(fact) == 2 { 1 } else { 0 } }
fn cg_semantic_fact_managed_capture(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 56, 0) } }
fn cg_semantic_fact_word_abi(fact: i64) -> i64 { if fact == 0 { 0 } else { mem_load64_at(fact + 64, 0) } }
fn cg_semantic_fact_set_word_abi(fact: i64, flag: i64) -> i64 { mem_store64_at(fact + 64, 0, flag) }

fn cg_params_any_float(params: i64) -> i64 {
  let mut found = 0
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n {
    let ty = node_f3(nlist_get(params, i))
    if cg_ty_is_f32(ty) == 1 or cg_ty_is_f64(ty) == 1 { found = 1 } else { 0 }
    i = i + 1
  }
  found
}
fn cg_semantic_fact_effect_flags(fact: i64) -> i64 {
  if fact == 0 { 0 }
  else { cg_semantic_fact_has_alloc(fact) + cg_semantic_fact_has_unsafe(fact) * 2 }
}

fn cg_params_managed_mask(params: i64) -> i64 {
  let mut mask = 0
  let n = if params == 0 { 0 } else { nlist_len(params) }
  let mut i = 0
  while i < n and i < 60 {
    let p = nlist_get(params, i)
    if cg_ty_is_managed(node_f3(p)) == 1 { mask = mask + cg_bit(i) }
    else { 0 }
    i = i + 1
  }
  mask
}

fn cg_semantic_fact_return_class_for_ty(ret_ty: i64) -> i64 {
  if cg_ty_is_managed(ret_ty) == 1 { 1 }
  else { if ty_eq(ret_ty, ty_i64()) == 1 { 2 } else { 0 } }
}

fn cg_semantic_fact_record_metrics(fm: i64, fact: i64) -> i64 {
  if fm == 0 or fact == 0 { 0 }
  else {
    fmap_inc_semantic_fact_count(fm)
    if cg_semantic_fact_closed(fact) == 1 { fmap_inc_semantic_closed_effect_fact_count(fm) } else { 0 }
    if cg_semantic_fact_pure(fact) == 1 { fmap_inc_semantic_pure_fact_count(fm) }
    else { fmap_inc_semantic_effectful_fact_count(fm) }
    if cg_semantic_fact_has_alloc(fact) == 1 { fmap_inc_semantic_alloc_fact_count(fm) } else { 0 }
    if cg_semantic_fact_has_unsafe(fact) == 1 { fmap_inc_semantic_unsafe_fact_count(fm) } else { 0 }
    if cg_semantic_fact_managed_param_mask(fact) != 0 { fmap_inc_semantic_managed_param_fact_count(fm) } else { 0 }
    if cg_semantic_fact_managed_return(fact) == 1 { fmap_inc_semantic_managed_return_fact_count(fm) } else { 0 }
    if cg_semantic_fact_managed_capture(fact) == 1 { fmap_inc_semantic_managed_capture_fact_count(fm) } else { 0 }
    0
  }
}

fn cg_semantic_fact_new_raw(fm: i64, closed: i64, pure: i64, effect_count: i64, effect_flags: i64, managed_param_mask: i64, managed_return: i64, managed_capture: i64) -> i64 {
  let fact = cg_alloc_bytes(cg_semantic_fact_size())
  mem_store64_at(fact, 0, closed)
  mem_store64_at(fact + 8, 0, pure)
  mem_store64_at(fact + 16, 0, effect_count)
  mem_store64_at(fact + 24, 0, cg_mask_has(effect_flags, 0))
  mem_store64_at(fact + 32, 0, cg_mask_has(effect_flags, 1))
  mem_store64_at(fact + 40, 0, managed_param_mask)
  mem_store64_at(fact + 48, 0, managed_return)
  mem_store64_at(fact + 56, 0, managed_capture)
  -- offset 64: word-ABI flag, set by the typed ctor below when neither
  -- params nor return involve f32/f64 (values stay in word registers
  -- across a call boundary, so an inliner may relocate the body).
  mem_store64_at(fact + 64, 0, 0)
  mem_store64_at(fact + 72, 0, 0)
  mem_store64_at(fact + 80, 0, 0)
  mem_store64_at(fact + 88, 0, 0)
  cg_semantic_fact_record_metrics(fm, fact)
  fact
}

fn cg_semantic_effect_summary_new(closed: i64, effect_count: i64, declared_alloc: i64, declared_unsafe: i64) -> i64 {
  node_new(0, closed, effect_count, declared_alloc, declared_unsafe)
}

fn cg_semantic_fact_new_with_effect_summary(fm: i64, effect_summary: i64, params: i64, ret_ty: i64, managed_capture: i64, forced_effect_flags: i64) -> i64 {
  let closed = node_f1(effect_summary)
  let effect_count = node_f2(effect_summary)
  let declared_alloc = node_f3(effect_summary)
  let declared_unsafe = node_f4(effect_summary)
  let forced_alloc = cg_mask_has(forced_effect_flags, 0)
  let forced_unsafe = cg_mask_has(forced_effect_flags, 1)
  let forced_perform = cg_mask_has(forced_effect_flags, 2)
  let forced_memory = cg_mask_has(forced_effect_flags, 3)
  let has_alloc = if declared_alloc == 1 or forced_alloc == 1 { 1 } else { 0 }
  let has_unsafe = if declared_unsafe == 1 or forced_unsafe == 1 { 1 } else { 0 }
  let added_alloc = if forced_alloc == 1 and declared_alloc == 0 { 1 } else { 0 }
  let added_unsafe = if forced_unsafe == 1 and declared_unsafe == 0 { 1 } else { 0 }
  let added_perform = if forced_perform == 1 and effect_count == 0 { 1 } else { 0 }
  let added_memory = if forced_memory == 1 { 1 } else { 0 }
  let total_effect_count = effect_count + added_alloc + added_unsafe + added_perform + added_memory
  let pure = if closed == 1 and total_effect_count == 0 { 1 } else { 0 }
  let effect_flags = has_alloc + has_unsafe * 2
  let fact = cg_semantic_fact_new_raw(fm, closed, pure, total_effect_count, effect_flags, cg_params_managed_mask(params), cg_semantic_fact_return_class_for_ty(ret_ty), managed_capture)
  let ret_float = if ret_ty != 0 and (cg_ty_is_f32(ret_ty) == 1 or cg_ty_is_f64(ret_ty) == 1) { 1 } else { 0 }
  if cg_params_any_float(params) == 0 and ret_float == 0 {
    cg_semantic_fact_set_word_abi(fact, 1)
  } else { 0 }
  fact
}

fn got_index(src: i64, ns: i64, nl: i64) -> i64 {
  if nl > 6 {
    if src_eq_at(src, ns, __str_ptr("__got_"), 0, 6) == 1 {
      -- Matches __got_ prefix. Check which symbol:
      let rest_ns = ns + 6
      let rest_nl = nl - 6
      if src_eq(src, rest_ns, rest_nl, "posix_spawn") == 1 { 0 }
      else { if src_eq(src, rest_ns, rest_nl, "waitpid") == 1 { 1 }
      else { if src_eq(src, rest_ns, rest_nl, "exit") == 1 { 2 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_create") == 1 { 3 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_join") == 1 { 4 }
      else { if src_eq(src, rest_ns, rest_nl, "mmap") == 1 { 5 }
      else { if src_eq(src, rest_ns, rest_nl, "write") == 1 { 6 }
      else { if src_eq(src, rest_ns, rest_nl, "read") == 1 { 7 }
      else { if src_eq(src, rest_ns, rest_nl, "open") == 1 { 8 }
      else { if src_eq(src, rest_ns, rest_nl, "close") == 1 { 9 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_init") == 1 { 10 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_lock") == 1 { 11 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_unlock") == 1 { 12 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_mutex_destroy") == 1 { 13 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_init") == 1 { 14 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_wait") == 1 { 15 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_signal") == 1 { 16 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_broadcast") == 1 { 17 }
      else { if src_eq(src, rest_ns, rest_nl, "pthread_cond_destroy") == 1 { 18 }
      else { 0 - 1 } } } } } } } } } } } } } } } } } } }
    } else { 0 - 1 }
  } else { 0 - 1 }
}

-- Record a GOT ADRP instruction that needs patching once ts is known
fn fmap_add_got_patch(fm: i64, code_pos: i64, gi: i64) -> i64 {
  let gp = mem_load64_at(fm + 120, 0)
  let gn = mem_load64_at(fm + 128, 0)
  let gcap = mem_load64_at(fm + 136, 0)
  if gn >= gcap {
    let new_cap = gcap * 2
    let new_gp = cg_alloc_bytes(new_cap * 16)
    mem_copy(new_gp, gp, gn * 16)
    mem_store64_at(fm + 120, 0, new_gp)
    mem_store64_at(fm + 136, 0, new_cap)
    0
  } else { 0 }
  let gpd = mem_load64_at(fm + 120, 0)
  mem_store64_at(gpd + gn * 16, 0, code_pos)
  mem_store64_at(gpd + gn * 16 + 8, 0, gi)
  mem_store64_at(fm + 128, 0, gn + 1)
  0
}

-- ======================================================================
-- Static closure pairs (2q slice 1): capture-free named-fn values share a
-- lazily-initialised 16-byte [thunk_ptr, env=0] slot in zero-fill data,
-- keyed by callee hash. The slot cache maps callee_hash → slot_off + 1
-- (0 = absent). ADRP sites are recorded here and resolved by the
-- executable patch loop or by PAGE21/PAGEOFF12 relocations in the .o path.
-- ======================================================================

fn fmap_static_pair_cache(fm: i64) -> i64 { mem_load64_at(fm + 1472, 0) }
fn fmap_static_pair_slot_count(fm: i64) -> i64 { mem_load64_at(fm + 1480, 0) }

-- Returns the slot byte offset for callee_hash, or -1 if absent.
fn fmap_static_pair_slot_lookup(fm: i64, callee_hash: i64) -> i64 {
  mono_cache_lookup(fmap_static_pair_cache(fm), callee_hash) - 1
}

-- Reserves the next 16-byte slot for callee_hash and returns its offset.
fn fmap_static_pair_slot_reserve(fm: i64, callee_hash: i64) -> i64 {
  let n = fmap_static_pair_slot_count(fm)
  let off = n * 16
  mono_cache_add(fmap_static_pair_cache(fm), callee_hash, off + 1)
  mem_store64_at(fm + 1480, 0, n + 1)
  off
}

fn fmap_static_pair_patch_count(fm: i64) -> i64 { mem_load64_at(fm + 1496, 0) }

fn fmap_static_pair_patch_code_pos(fm: i64, index: i64) -> i64 {
  mem_load64_at(mem_load64_at(fm + 1488, 0) + index * 16, 0)
}

fn fmap_static_pair_patch_slot_off(fm: i64, index: i64) -> i64 {
  mem_load64_at(mem_load64_at(fm + 1488, 0) + index * 16 + 8, 0)
}

fn fmap_add_static_pair_patch(fm: i64, code_pos: i64, slot_off: i64) -> i64 {
  let pn = mem_load64_at(fm + 1496, 0)
  let pcap = mem_load64_at(fm + 1504, 0)
  if pn >= pcap {
    let new_cap = pcap * 2
    let new_pd = cg_alloc_bytes(new_cap * 16)
    mem_copy(new_pd, mem_load64_at(fm + 1488, 0), pn * 16)
    mem_store64_at(fm + 1488, 0, new_pd)
    mem_store64_at(fm + 1504, 0, new_cap)
    0
  } else { 0 }
  let pd = mem_load64_at(fm + 1488, 0)
  mem_store64_at(pd + pn * 16, 0, code_pos)
  mem_store64_at(pd + pn * 16 + 8, 0, slot_off)
  mem_store64_at(fm + 1496, 0, pn + 1)
  0
}

fn fmap_hoisted_closure_emit_count(fm: i64) -> i64 { mem_load64_at(fm + 1520, 0) }
fn fmap_inc_hoisted_closure_emit_count(fm: i64) -> i64 { mem_store64_at(fm + 1520, 0, mem_load64_at(fm + 1520, 0) + 1) 0 }
fn fmap_lambda_evidence_facts(fm: i64) -> i64 { mem_load64_at(fm + 1528, 0) }
fn fmap_set_lambda_evidence_facts(fm: i64, facts: i64) -> i64 { mem_store64_at(fm + 1528, 0, facts) 0 }
fn fmap_emit_error_count(fm: i64) -> i64 { mem_load64_at(fm + 1536, 0) }
fn fmap_inc_emit_error_count(fm: i64) -> i64 { mem_store64_at(fm + 1536, 0, mem_load64_at(fm + 1536, 0) + 1) 0 }
fn fmap_static_pair_site_count(fm: i64) -> i64 { mem_load64_at(fm + 1512, 0) }
fn fmap_inc_static_pair_site_count(fm: i64) -> i64 { mem_store64_at(fm + 1512, 0, mem_load64_at(fm + 1512, 0) + 1) 0 }

fn cg_patch_cbz(code: i64, pos: i64, reg: i64, target: i64) -> i64 {
  let off = target - pos
  let off4 = off / 4
  -- CBZ: 0xB4000000 = 3019898880
  let masked = if off4 < 0 { 524288 + off4 } else { off4 }
  let enc = 3019898880 + masked * 32 + reg
  let d = buf_ptr(code)
  mem_store8_at(d + pos, 0, enc - enc / 256 * 256)
  mem_store8_at(d + pos + 1, 0, enc / 256 - enc / 65536 * 256)
  mem_store8_at(d + pos + 2, 0, enc / 65536 - enc / 16777216 * 256)
  mem_store8_at(d + pos + 3, 0, enc / 16777216 - enc / 4294967296 * 256)
  0
}

fn cg_patch_b(code: i64, pos: i64, target: i64) -> i64 {
  let off = target - pos
  let enc = encode_b(off)
  let d = buf_ptr(code)
  mem_store8_at(d + pos, 0, enc - enc / 256 * 256)
  mem_store8_at(d + pos + 1, 0, enc / 256 - enc / 65536 * 256)
  mem_store8_at(d + pos + 2, 0, enc / 65536 - enc / 16777216 * 256)
  mem_store8_at(d + pos + 3, 0, enc / 16777216 - enc / 4294967296 * 256)
  0
}

-- Patch all break forward references to target
fn cg_patch_b_cond(code: i64, pos: i64, cond: i64, target: i64) -> i64 {
  let off = target - pos
  let enc = encode_b_cond(off, cond)
  let d = buf_ptr(code)
  mem_store8_at(d + pos, 0, enc - enc / 256 * 256)
  mem_store8_at(d + pos + 1, 0, enc / 256 - enc / 65536 * 256)
  mem_store8_at(d + pos + 2, 0, enc / 65536 - enc / 16777216 * 256)
  mem_store8_at(d + pos + 3, 0, enc / 16777216 - enc / 4294967296 * 256)
  0
}

fn cg_fn_params(params: i64, n: i64, src: i64, scope: i64, code: i64, fm: i64) -> i64 {
  cg_fn_params_with_borrow_mask(params, n, src, scope, code, fm, 0)
}

fn cg_fn_params_with_borrow_mask(params: i64, n: i64, src: i64, scope: i64, code: i64, fm: i64, borrowed_mask: i64) -> i64 {
  let mut s = scope
  for i in 0..n {
    let p = nlist_get(params, i)
    let ns = node_f1(p)
    let nl = node_f2(p)
    let param_ty = node_f3(p)
    if i < 8 {
      let rd = reg_phys(i)
      -- MOV callee_saved, xi
      bu32(code, encode_add_imm(rd, i, 0))
      s = scope_push_typed(s, ns, nl, rd, param_ty)
      if cg_mask_has(borrowed_mask, i) == 1 { 0 } else { cg_cleanup_push_for_ty(fm, param_ty, rd) }
      if ty_is_owned(param_ty) == 1 { cg_cleanup_push_owned_drop_for_ty(fm, param_ty, rd) } else { 0 }
    } else {
      -- Spill xi to stack slot
      emit_store_reg(code, i, i)
      s = scope_push_typed(s, ns, nl, cg_canonical_value_home(i), param_ty)
      if cg_mask_has(borrowed_mask, i) == 1 { 0 } else { cg_cleanup_push_for_ty(fm, param_ty, cg_canonical_value_home(i)) }
      if ty_is_owned(param_ty) == 1 { cg_cleanup_push_owned_drop_for_ty(fm, param_ty, cg_canonical_value_home(i)) } else { 0 }
    }
  }
  s
}

-- Unwrap fn wrapper: tag-23 wraps {inner_fn, ret_type}
fn unwrap_fn(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) }
  else { fn_wrap }
}
