      11 -> cg_expr_assigns_name(node_f3(node), src, ns, nl) or cg_expr_assigns_name(node_f4(node), src, ns, nl)
      12 -> cg_same_name(src, node_f1(node), node_f2(node), ns, nl) or cg_expr_assigns_name(node_f3(node), src, ns, nl)
