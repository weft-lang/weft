fn cg_emit_effect_evidence_generic_fn_spec(code: i64, fm: i64, node: i64, entry: i64, info: i64) -> i64 {
  let type_args = cg_type_args_in_current_context(fm, node_f1(node))
  let name_hash = node_f1(entry)
  let fn_wrap = node_f2(entry)
  let fn_src = node_f3(entry)
  let owner_hash = node_f4(entry)
  let ops = cg_evidence_info_ops(info)
  let callbacks = cg_evidence_info_callbacks(info)
  let callback_hash = cg_evidence_info_callback_hash(info)
  let evidence_hash = cg_evidence_ops_hash(ops)
  let cache = fmap_evidence_cache(fm)
  let cached = evidence_cache_lookup(cache, name_hash, owner_hash, evidence_hash, callback_hash)
  if cached != 0 {
    fmap_inc_semantic_context_cache_hit_count(fm)
    cached
  }
  else {
    let fn_node = unwrap_fn(fn_wrap)
    let subst = cg_build_subst(fn_tparams(fn_wrap), type_args)
    let params = cg_params_subst(node_f3(fn_node), subst)
    let body = node_f4(fn_node)
    let ret_ty = cg_generic_subst_ret(fn_wrap, type_args)
    let nparams = nlist_len(params)
    if nparams > 7 { 0 }
    else {
      let b_over_pos = buf_len(code)
      bu32(code, 0)
      let fn_off = buf_len(code)
      evidence_cache_add(cache, name_hash, owner_hash, evidence_hash, callback_hash, fn_off)
      fmap_inc_semantic_context_entry_count(fm)
      emit_prologue(code)
      let old_ret_ty = fmap_get_current_ret_ty(fm)
      let old_cleanup_stack = cg_cleanup_stack(fm)
      let old_loop_cleanup_depth = __mem_load64(fm + 152)
      let old_evidence_top = fmap_effect_evidence_top(fm)
      let old_callback_top = fmap_effect_callback_top(fm)
      let old_generic_subst = fmap_current_generic_subst(fm)
      fmap_set_current_ret_ty(fm, ret_ty)
      fmap_set_current_generic_subst(fm, subst)
      __mem_store64(fm + 144, nlist_new())
      __mem_store64(fm + 152, 0)
      let fn_scope = cg_fn_params(params, nparams, fn_src, scope_new(), code, fm)
      emit_store_counter_from_phys(code, nparams, nparams)
      cg_effect_evidence_push_ops(fm, ops, nparams)
      fmap_set_effect_callback_top(fm, callbacks)
      let body_ctr = cg_expr(body, code, fn_scope, fn_src, nparams + 1, fm)
      let save_ctr = body_ctr
      cg_match_store_result(code, save_ctr, body_ctr)
      if cg_ty_is_managed(ret_ty) == 1 {
        if cg_expr_is_borrow_for_ty(ret_ty, body, fn_scope, fn_src, fm) == 1 {
          cg_emit_managed_retain_regid(code, fm, ret_ty, reg_id(save_ctr))
        } else { 0 }
      } else { 0 }
      cg_emit_cleanups_to_depth(code, fn_src, save_ctr + 1, fm, 0)
      cg_cleanup_restore(fm, 0)
      let result_phys = emit_load_reg(code, save_ctr)
      bu32(code, encode_add_imm(0, result_phys, 0))
      emit_epilogue(code)
      fmap_set_current_ret_ty(fm, old_ret_ty)
      __mem_store64(fm + 144, old_cleanup_stack)
      __mem_store64(fm + 152, old_loop_cleanup_depth)
      fmap_set_effect_evidence_top(fm, old_evidence_top)
      fmap_set_effect_callback_top(fm, old_callback_top)
      fmap_set_current_generic_subst(fm, old_generic_subst)
      cg_patch_b(code, b_over_pos, buf_len(code))
      fn_off
    }
  }
}

