      48 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      49 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      52 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      _ -> 0
    }
