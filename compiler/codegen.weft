fn cg_evidence_ops_push(ops: i64, eff_hash: i64, op_hash: i64, op_index: i64) -> i64 {
  node_new(0, eff_hash, op_hash, op_index, ops)
}

fn cg_evidence_ops_find(ops: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut cur = ops
  let mut result = 0
  while cur != 0 and result == 0 {
    if node_f1(cur) == eff_hash and node_f2(cur) == op_hash {
      result = cur
    } else {
      cur = node_f4(cur)
    }
  }
  result
}

fn cg_evidence_ops_hash(ops: i64) -> i64 {
  let mut cur = ops
  let mut result = 1469598103934665603
  while cur != 0 {
    result = result * 1099511628211 + node_f1(cur) * 31 + node_f2(cur) * 17 + node_f3(cur)
    cur = node_f4(cur)
  }
  result
}

fn cg_semantic_fact_size() -> i64 { 96 }
fn cg_semantic_fact_closed(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact) } }
fn cg_semantic_fact_pure(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 8) } }
fn cg_semantic_fact_effect_count(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 16) } }
fn cg_semantic_fact_has_alloc(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 24) } }
fn cg_semantic_fact_has_unsafe(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 32) } }
fn cg_semantic_fact_managed_param_mask(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 40) } }
fn cg_semantic_fact_managed_return(fact: i64) -> i64 { if fact == 0 { 0 } else { __mem_load64(fact + 48) } }
