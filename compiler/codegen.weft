-- codegen.weft — code generation for aarch64
-- Scope, type table, function map, prologue/epilogue, register allocation,
-- and all cg_* code generation functions

use "compiler/encode.weft"
use "compiler/parse.weft"

-- ======================================================================
-- Scope: linked list of {name_start, name_len, reg, next}
-- ======================================================================

fn scope_new() -> i64 { 0 }
fn scope_push(scope: i64, ns: i64, nl: i64, reg: i64) -> i64 {
  let e = __bump_alloc(32)
  __mem_store64(e, ns)
  __mem_store64(e + 8, nl)
  __mem_store64(e + 16, reg)
  __mem_store64(e + 24, scope)
  e
}
fn scope_lookup(scope: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns register number or -1 if not found
  if scope == 0 { 0 - 1 }
  else {
    let s_ns = __mem_load64(scope)
    let s_nl = __mem_load64(scope + 8)
    if s_nl == nl {
      -- Compare src[ns..ns+nl] with src[s_ns..s_ns+nl]
      if src_eq_at(src, ns, src + s_ns, 0, nl) == 1 {
        __mem_load64(scope + 16)
      } else {
        scope_lookup(__mem_load64(scope + 24), src, ns, nl)
      }
    } else {
      scope_lookup(__mem_load64(scope + 24), src, ns, nl)
    }
  }
}

-- ======================================================================
-- Type table: stores record/variant type declarations
-- ======================================================================
-- Entry: [name_ns(8), name_nl(8), kind(8), num_fields(8), fields_ptr(8)] = 40 bytes
-- kind: 0=record, 1=variant
-- For records: fields_ptr -> array of [field_ns(8), field_nl(8)] per field (16 bytes each)
-- For variants: fields_ptr -> array of [variant_ns(8), variant_nl(8), tag_hash(8), num_payloads(8)] per variant (32 bytes each)
fn ttable_new() -> i64 {
  let h = __bump_alloc(32)
  let d = __bump_alloc(4000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 100)
  -- Loaded files list for use dedup (stored at h+24)
  __mem_store64(h + 24, nlist_new())
  h
}
fn ttable_add(tt: i64, ns: i64, nl: i64, kind: i64, nfields: i64, fields: i64) -> i64 {
  let d = __mem_load64(tt)
  let n = __mem_load64(tt + 8)
  __mem_store64(d + n * 40, ns)
  __mem_store64(d + n * 40 + 8, nl)
  __mem_store64(d + n * 40 + 16, kind)
  __mem_store64(d + n * 40 + 24, nfields)
  __mem_store64(d + n * 40 + 32, fields)
  __mem_store64(tt + 8, n + 1)
  tt
}
fn ttable_lookup(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  -- Returns pointer to type entry, or 0 if not found
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_ns = __mem_load64(d + i * 40)
    let e_nl = __mem_load64(d + i * 40 + 8)
    if e_nl == nl {
      if src_eq_at(src, ns, src + e_ns, 0, nl) == 1 {
        result = d + i * 40
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}
-- Get field index by name from a record type entry
fn ttable_field_index(entry: i64, src: i64, field_ns: i64, field_nl: i64) -> i64 {
  let nfields = __mem_load64(entry + 24)
  let fields = __mem_load64(entry + 32)
  let mut i = 0
  let mut result = 0 - 1
  while i < nfields {
    let f_ns = __mem_load64(fields + i * 16)
    let f_nl = __mem_load64(fields + i * 16 + 8)
    if f_nl == field_nl {
      if src_eq_at(src, field_ns, src + f_ns, 0, field_nl) == 1 {
        result = i
        i = nfields
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Find variant info by name. Returns tag_hash or -1 if not found.
fn ttable_find_variant(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut ti = 0
  let mut result = 0 - 1
  while ti < n {
    let kind = __mem_load64(d + ti * 40 + 16)
    if kind == 1 {
      -- Variant type: search its constructors
      let nvariants = __mem_load64(d + ti * 40 + 24)
      let variants = __mem_load64(d + ti * 40 + 32)
      let mut vi = 0
      let mut found = 0
      while vi < nvariants {
        let v_ns = __mem_load64(variants + vi * 32)
        let v_nl = __mem_load64(variants + vi * 32 + 8)
        if v_nl == nl {
          if src_eq_at(src, ns, src + v_ns, 0, nl) == 1 {
            result = __mem_load64(variants + vi * 32 + 16)
            vi = nvariants
            found = 1
          } else { vi = vi + 1 }
        } else { vi = vi + 1 }
      }
      if found == 1 { ti = n } else { ti = ti + 1 }
    } else { ti = ti + 1 }
  }
  result
}

-- Search all record types for a field name, return its index
fn ttable_find_any_field(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(tt + 8)
  let d = __mem_load64(tt)
  let mut i = 0
  let mut result = 0
  while i < n {
    let kind = __mem_load64(d + i * 40 + 16)
    if kind == 0 {
      -- Record type: search its fields
      let entry = d + i * 40
      let idx = ttable_field_index(entry, src, ns, nl)
      if idx >= 0 {
        result = idx
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Simple string hash for variant tags (compile-time)
fn str_hash(src: i64, start: i64, len: i64) -> i64 {
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = h * 33 + __mem_load8(src + start + i)
    i = i + 1
  }
  h
}

-- ======================================================================
-- Function map: parallel arrays of {name_start, name_len, offset, src}
-- ======================================================================

fn fmap_new() -> i64 {
  let h = __bump_alloc(56)
  let d = __bump_alloc(64000)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, 2000)
  -- Patches list for forward BL references: [position, name_start, name_len, src_ptr]
  let pd = __bump_alloc(256000)
  __mem_store64(h + 24, pd)
  __mem_store64(h + 32, 0)
  __mem_store64(h + 40, 8000)
  -- Type table pointer (set by compile)
  __mem_store64(h + 48, 0)
  h
}
fn fmap_set_tt(fm: i64, tt: i64) -> i64 { __mem_store64(fm + 48, tt) 0 }
fn fmap_get_tt(fm: i64) -> i64 { __mem_load64(fm + 48) }
fn fmap_add(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  let d = __mem_load64(fm)
  let n = __mem_load64(fm + 8)
  __mem_store64(d + n * 32, ns)
  __mem_store64(d + n * 32 + 8, nl)
  __mem_store64(d + n * 32 + 16, off)
  __mem_store64(d + n * 32 + 24, src)
  __mem_store64(fm + 8, n + 1)
  fm
}
fn fmap_lookup(fm: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  let mut result = 0
  while i < n {
    let e_nl = __mem_load64(d + i * 32 + 8)
    if e_nl == nl {
      let e_src = __mem_load64(d + i * 32 + 24)
      if src_eq_at(src, ns, e_src + __mem_load64(d + i * 32), 0, nl) == 1 {
        result = __mem_load64(d + i * 32 + 16)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  result
}

-- Update a fmap entry's offset (for hoisting: registered with 0, updated when compiled)
fn fmap_update_offset(fm: i64, src: i64, ns: i64, nl: i64, off: i64) -> i64 {
  let n = __mem_load64(fm + 8)
  let d = __mem_load64(fm)
  let mut i = 0
  while i < n {
    let e_nl = __mem_load64(d + i * 32 + 8)
    if e_nl == nl {
      let e_src = __mem_load64(d + i * 32 + 24)
      if src_eq_at(src, ns, e_src + __mem_load64(d + i * 32), 0, nl) == 1 {
        __mem_store64(d + i * 32 + 16, off)
        i = n
      } else { i = i + 1 }
    } else { i = i + 1 }
  }
  0
}

-- Record a forward BL reference to be patched later
fn fmap_add_patch(fm: i64, pos: i64, src: i64, ns: i64, nl: i64) -> i64 {
  let pd = __mem_load64(fm + 24)
  let pn = __mem_load64(fm + 32)
  __mem_store64(pd + pn * 32, pos)
  __mem_store64(pd + pn * 32 + 8, ns)
  __mem_store64(pd + pn * 32 + 16, nl)
  __mem_store64(pd + pn * 32 + 24, src)
  __mem_store64(fm + 32, pn + 1)
  0
}

-- ======================================================================
-- Prologue / epilogue
-- ======================================================================

fn emit_prologue(code: i64) -> i64 {
  bu32(code, encode_stp_pre(8, 9, 31, 0 - 16))
  bu32(code, encode_stp_pre(10, 11, 31, 0 - 16))
  bu32(code, encode_stp_pre(12, 13, 31, 0 - 16))
  bu32(code, encode_stp_pre(14, 15, 31, 0 - 16))
  emit_prologue2(code)
}
fn emit_prologue2(code: i64) -> i64 {
  bu32(code, encode_stp_pre(19, 20, 31, 0 - 16))
  bu32(code, encode_stp_pre(21, 22, 31, 0 - 16))
  bu32(code, encode_stp_pre(23, 24, 31, 0 - 16))
  bu32(code, encode_stp_pre(25, 26, 31, 0 - 16))
  emit_prologue3(code)
}
fn emit_prologue3(code: i64) -> i64 {
  bu32(code, encode_stp_pre(29, 30, 31, 0 - 16))
  bu32(code, encode_add_imm(29, 31, 0))
  bu32(code, 3506438144 + 1024 * 1024 + 31 * 32 + 31)
}

fn emit_epilogue(code: i64) -> i64 {
  bu32(code, encode_add_imm(31, 31, 1024))
  bu32(code, encode_ldp_post(29, 30, 31, 16))
  bu32(code, encode_ldp_post(25, 26, 31, 16))
  bu32(code, encode_ldp_post(23, 24, 31, 16))
  emit_epilogue2(code)
}
fn emit_epilogue2(code: i64) -> i64 {
  bu32(code, encode_ldp_post(21, 22, 31, 16))
  bu32(code, encode_ldp_post(19, 20, 31, 16))
  bu32(code, encode_ldp_post(14, 15, 31, 16))
  bu32(code, encode_ldp_post(12, 13, 31, 16))
  emit_epilogue3(code)
}
fn emit_epilogue3(code: i64) -> i64 {
  bu32(code, encode_ldp_post(10, 11, 31, 16))
  bu32(code, encode_ldp_post(8, 9, 31, 16))
  bu32(code, encode_ret())
}

-- ======================================================================
-- Register allocation
-- ======================================================================

-- Map register counter to register identifier
-- 0-7 -> x19-x26 (physical, returned as 19-26)
-- 8+ -> spill slot (returned as negative: -(slot+1))
fn reg_id(counter: i64) -> i64 {
  if counter < 8 { counter + 19 }
  else { 0 - (counter - 7) }
}

-- For backward compatibility
fn reg_phys(counter: i64) -> i64 {
  if counter < 8 { counter + 19 } else { 17 }
}

-- Emit: move value from reg_phys(counter) to a usable register
-- If counter < 8, the value is already in a physical register.
-- If counter >= 8, emit LDR from spill slot into x16 (temp).
fn emit_load_reg(code: i64, counter: i64) -> i64 {
  -- Returns the physical register containing the value
  if counter < 8 { counter + 19 }
  else {
    -- LDR x16, [sp, #((counter-8)*8)]
    -- 0xF9400000 = 4181721088
    let slot = (counter - 8) * 8
    bu32(code, 4181721088 + slot / 8 * 1024 + 31 * 32 + 16)
    16
  }
}

fn emit_load_rhs(code: i64, counter: i64) -> i64 {
  -- Same as emit_load_reg but uses x17 instead of x16
  if counter < 8 { counter + 19 }
  else {
    let slot = (counter - 8) * 8
    bu32(code, 4181721088 + slot / 8 * 1024 + 31 * 32 + 17)
    17
  }
}

fn emit_store_reg(code: i64, counter: i64, phys_reg: i64) -> i64 {
  if counter >= 8 {
    -- STR phys_reg, [sp, #((counter-8)*8)]
    -- 0xF9000000 = 4177526784
    let slot = (counter - 8) * 8
    bu32(code, 4177526784 + slot / 8 * 1024 + 31 * 32 + phys_reg)
  } else { 0 }
}

-- ======================================================================
-- Code generation: all cg_* functions
-- ======================================================================

-- String literal codegen: emit bytes from source into heap at runtime
-- x16 = data pointer, x17 = byte temp
fn cg_string_bytes(code: i64, src: i64, start: i64, len: i64) -> i64 {
  let mut i = 0
  while i < len {
    let byte = __mem_load8(src + start + i)
    bu32(code, encode_movz(17, byte, 0))
    bu32(code, 956301312 + i * 1024 + 16 * 32 + 17)
    i = i + 1
  }
  0
}
fn cg_string(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let str_start = node_f1(node)
  let str_len = node_f2(node)
  let aligned_len = (str_len + 7) / 8 * 8
  -- Step 1: bump-alloc data: MOV x16, x28; ADD x28, x28, #aligned_len
  bu32(code, encode_add_imm(16, 28, 0))
  bu32(code, encode_add_imm(28, 28, aligned_len))
  -- Step 2: store each byte (compile-time known from source)
  cg_string_bytes(code, src, str_start, str_len)
  -- Step 3: bump-alloc descriptor (16 bytes): MOV x17, x28; ADD x28, x28, #16
  bu32(code, encode_add_imm(17, 28, 0))
  bu32(code, encode_add_imm(28, 28, 16))
  -- Step 4: STR x16, [x17, #0] (data ptr): 0xF9000000 = 4177526784
  bu32(code, 4177526784 + 17 * 32 + 16)
  -- Step 5: MOVZ x16, #len; STR x16, [x17, #8]
  emit_mov_imm(code, 16, str_len)
  bu32(code, 4177526784 + 1 * 1024 + 17 * 32 + 16)
  -- Step 6: move x17 (descriptor) to result register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

-- While: loop with condition check, evaluates to 0 (nil)
fn cg_while(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let cond = node_f1(node)
  let body = node_f2(node)
  -- loop_start: evaluate condition
  let loop_start = buf_len(code)
  let c1 = cg_expr(cond, code, scope, src, ctr, fm)
  let cond_phys = emit_load_reg(code, c1 - 1)
  -- CBZ cond, after_loop (placeholder)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- body (result discarded)
  let c2 = cg_expr(body, code, scope, src, c1, fm)
  -- B loop_start
  let b_pos = buf_len(code)
  bu32(code, encode_b(loop_start - b_pos))
  -- Patch CBZ
  let after_loop = buf_len(code)
  cg_patch_cbz(code, cbz_pos, cond_phys, after_loop)
  -- Result is 0 (nil)
  cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
}

-- LetMut: like Let but forces value to a spill slot for reassignment
fn cg_let_mut(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  -- Force to a spill slot so assignment can overwrite it
  let val_phys = emit_load_reg(code, c1 - 1)
  -- Use counter 8+ to guarantee a spill slot
  let mut_ctr = if c1 - 1 < 8 { 8 } else { c1 - 1 }
  bu32(code, encode_add_imm(17, val_phys, 0))
  emit_store_reg(code, mut_ctr, 17)
  let val_rid = reg_id(mut_ctr)
  let new_scope = scope_push(scope, ns, nl, val_rid)
  cg_expr(body, code, new_scope, src, mut_ctr + 1, fm)
}

-- Assignment: write new value to mutable variable's spill slot
fn cg_assign(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  let val_phys = emit_load_reg(code, c1 - 1)
  -- Look up the variable's spill slot
  let var_rid = scope_lookup(scope, src, ns, nl)
  -- var_rid is negative (spill slot indicator). Convert to slot index.
  let slot = 0 - var_rid - 1
  -- STR val to [sp, #(slot*8)]
  bu32(code, 4177526784 + slot * 1024 + 31 * 32 + val_phys)
  c1
}

-- Block: evaluate first for side effects, then evaluate and return rest
-- Record construction: allocate num_fields * 8 bytes, store each field value
fn cg_record_init(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let type_ns = node_f1(node)
  let type_nl = node_f2(node)
  let fields = node_f3(node)
  let nfields = node_f4(node)
  -- Allocate nfields * 8 bytes using __bump_alloc inline
  let size = nfields * 8
  emit_mov_imm(code, 0, size)
  -- MOV x17, x28; ADD x28, x28, x0
  let e1 = encode_add_imm(17, 28, 0)
  bu32(code, e1)
  let e2 = encode_add_reg(28, 28, 0)
  bu32(code, e2)
  -- Result (record ptr) in x17. Store to ctr register.
  if ctr < 8 {
    let e3 = encode_add_imm(ctr + 19, 17, 0)
    bu32(code, e3)
  } else {
    emit_store_reg(code, ctr, 17)
  }
  -- Store each field value. Pack base_ctr and i: base*256+i
  -- Fields use temporary registers but the RECORD POINTER is the result
  cg_record_fields(fields, nfields, code, scope, src, ctr + 1, fm, ctr)
  -- Return ctr+1: the record pointer is at counter ctr, result is ctr+1
  ctr + 1
}
-- Store fields sequentially: field i at offset i*8
fn cg_record_fields(fields: i64, nfields: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, base_ctr: i64) -> i64 {
  let mut i = 0
  let mut c = ctr
  while i < nfields {
    let field_pair = nlist_get(fields, i)
    let val_node = node_f3(field_pair)
    c = cg_expr(val_node, code, scope, src, c, fm)
    -- Load record base pointer (ALWAYS from base_ctr, not c-1)
    let base_phys = emit_load_reg(code, base_ctr)
    let val_phys = emit_load_rhs(code, c - 1)
    -- STR val, [base + i*8]
    let off = i * 8
    let str_enc = 4177526784 + off / 8 * 1024 + base_phys * 32 + val_phys
    bu32(code, str_enc)
    i = i + 1
  }
  c
}

-- Field access: load from record + field_index * 8
fn cg_field_access(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let base = node_f1(node)
  let field_ns = node_f2(node)
  let field_nl = node_f3(node)
  -- Evaluate base expression
  let c1 = cg_expr(base, code, scope, src, ctr, fm)
  let base_phys = emit_load_reg(code, c1 - 1)
  -- Look up field index from type table
  let tt = fmap_get_tt(fm)
  let idx = ttable_find_any_field(tt, src, field_ns, field_nl)
  -- LDR x17, [base + idx * 8]
  let off = idx * 8
  let ldr_enc = 4181721088 + off / 8 * 1024 + base_phys * 32 + 17
  bu32(code, ldr_enc)
  if c1 < 8 {
    let e_fa = encode_add_imm(c1 + 19, 17, 0)
    bu32(code, e_fa)
  } else {
    emit_store_reg(code, c1, 17)
  }
  c1 + 1
}

-- ======================================================================
-- Match expression codegen
-- ======================================================================

-- Helper: emit comparison test, body, branch for an int literal arm
fn cg_match_int_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let lit_val = node_f1(pat)
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  emit_mov_imm(code, 17, lit_val)
  bu32(code, encode_cmp(scr_phys, 17))
  bu32(code, encode_cset(17, 0))
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard check (if present)
  let guard_cbz = if guard > 0 {
    let cg = cg_expr(guard, code, scope, src, ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  } else { 0 }
  let c_body = cg_expr(body, code, scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 17, next_start)
  if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Helper: emit tag comparison, payload binding, guard, body for constructor arm
fn cg_match_ctor_arm(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let tag_ns = node_f1(pat)
  let tag_nl = node_f2(pat)
  let b_ns = node_f3(pat)
  let b_nl = node_f4(pat)
  let expected_hash = str_hash(src, tag_ns, tag_nl)
  cg_match_ctor_test(code, scrutinee_ctr, expected_hash)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Bind payload (if present)
  let body_scope = if b_nl > 0 {
    cg_match_ctor_bind_only(code, scope, ctr, scrutinee_ctr, b_ns, b_nl)
  } else { scope }
  let body_ctr = if b_nl > 0 { ctr + 1 } else { ctr }
  -- Guard check (if present)
  let guard_cbz = if guard > 0 {
    let cg = cg_expr(guard, code, body_scope, src, body_ctr, fm)
    let gp = emit_load_reg(code, cg - 1)
    let gpos = buf_len(code)
    bu32(code, 0)
    gpos * 256 + gp
  } else { 0 }
  -- Evaluate body
  let result = cg_expr(body, code, body_scope, src, body_ctr, fm)
  cg_match_store_result(code, ctr, result)
  let b_pos = buf_len(code)
  bu32(code, 0)
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, 17, next_start)
  if guard > 0 { cg_patch_cbz(code, guard_cbz / 256, guard_cbz % 256, next_start) } else { 0 }
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Bind constructor payload to scope without evaluating body
fn cg_match_ctor_bind_only(code: i64, scope: i64, ctr: i64, scrutinee_ctr: i64, b_ns: i64, b_nl: i64) -> i64 {
  let scr2 = emit_load_reg(code, scrutinee_ctr)
  -- LDR x17, [scrutinee, #8] (payload)
  bu32(code, 4181721088 + 1024 + scr2 * 32 + 17)
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  scope_push(scope, b_ns, b_nl, reg_id(ctr))
}

-- Emit: LDR tag from scrutinee, compare with expected, CSET result to x17
fn cg_match_ctor_test(code: i64, scrutinee_ctr: i64, expected_hash: i64) -> i64 {
  let scr_phys = emit_load_reg(code, scrutinee_ctr)
  -- LDR x17, [scrutinee, #0] (tag hash)
  bu32(code, 4181721088 + scr_phys * 32 + 17)
  emit_mov_imm(code, 16, expected_hash)
  let cmp_enc = encode_cmp(17, 16)
  bu32(code, cmp_enc)
  let cset_enc = encode_cset(17, 0)
  bu32(code, cset_enc)
  0
}

-- Bind payload (if present) and evaluate body
-- b_packed = b_ns * 256 + b_nl (to stay at 8 params)
fn cg_match_ctor_body(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_nl = b_packed - (b_packed / 256) * 256
  if b_nl > 0 {
    let b_ns = b_packed / 256
    cg_match_ctor_bind(code, scope, src, ctr, fm, scrutinee_ctr, b_ns * 256 + b_nl, body)
  } else {
    cg_expr(body, code, scope, src, ctr, fm)
  }
}

-- Emit payload load, bind to scope, evaluate body
fn cg_match_ctor_bind(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64, b_packed: i64, body: i64) -> i64 {
  let b_ns = b_packed / 256
  let b_nl = b_packed - b_ns * 256
  let scr2 = emit_load_reg(code, scrutinee_ctr)
  -- LDR x17, [scrutinee, #8] (payload)
  bu32(code, 4181721088 + 1024 + scr2 * 32 + 17)
  if ctr < 8 {
    let pe = encode_add_imm(ctr + 19, 17, 0)
    bu32(code, pe)
  } else {
    emit_store_reg(code, ctr, 17)
  }
  let payload_rid = reg_id(ctr)
  let new_scope = scope_push(scope, b_ns, b_nl, payload_rid)
  cg_expr(body, code, new_scope, src, ctr + 1, fm)
}

-- Store match arm result at ctr
fn cg_match_store_result(code: i64, ctr: i64, c_body: i64) -> i64 {
  let body_phys = emit_load_reg(code, c_body - 1)
  if ctr < 8 {
    let e = encode_add_imm(ctr + 19, body_phys, 0)
    bu32(code, e)
  } else {
    let e = encode_add_imm(17, body_phys, 0)
    bu32(code, e)
    emit_store_reg(code, ctr, 17)
  }
  0
}

-- Process remaining arms after current arm
fn cg_match_remaining(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let remaining = nlist_new()
  cg_copy_arms_from(arms, n_arms, remaining, 1)
  cg_match_arms(remaining, n_arms - 1, code, scope, src, ctr, fm, scrutinee_ctr)
}

-- Match expression: compile as if-else chain
fn cg_match(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let scrutinee = node_f1(node)
  let arms = node_f2(node)
  let n_arms = node_f3(node)
  let c1 = cg_expr(scrutinee, code, scope, src, ctr, fm)
  cg_match_arms(arms, n_arms, code, scope, src, c1, fm, c1 - 1)
}
-- scrutinee_ctr: counter where the scrutinee value lives
fn cg_match_arms(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  if n_arms <= 0 {
    cg_int(node_new(1, 0, 0, 0, 0), code, ctr)
  } else {
    cg_match_dispatch(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Binary tree dispatch: split by pat_tag range to limit nesting depth
fn cg_match_dispatch(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag <= 18 {
    cg_match_arm_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_arm_high(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

-- Handle wildcard (17) and binding (18) patterns
fn cg_match_arm_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  if guard == 0 {
    -- No guard: wildcard/binding always matches
    if pat_tag == 17 {
      let c_body = cg_expr(body, code, scope, src, ctr, fm)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    } else {
      let c_body = cg_match_bind_arm(body, pat, code, scope, src, ctr, fm, scrutinee_ctr)
      cg_match_store_result(code, ctr, c_body)
      ctr + 1
    }
  } else {
    -- Guard present: bind pattern, eval guard, CBZ to next arm if false
    cg_match_guarded_low(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}

fn cg_match_guarded_low(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat = node_f1(arm)
  let body = node_f2(arm)
  let guard = node_f3(arm)
  let pat_tag = node_tag(pat)
  -- Set up scope (binding adds variable, wildcard doesn't)
  let guard_scope = if pat_tag == 18 {
    let b_ns = node_f1(pat)
    let b_nl = node_f2(pat)
    scope_push(scope, b_ns, b_nl, reg_id(scrutinee_ctr))
  } else { scope }
  -- Evaluate guard
  let cg = cg_expr(guard, code, guard_scope, src, ctr, fm)
  let gp = emit_load_reg(code, cg - 1)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Guard passed: evaluate body
  let c_body = cg_expr(body, code, guard_scope, src, ctr, fm)
  cg_match_store_result(code, ctr, c_body)
  let b_pos = buf_len(code)
  bu32(code, 0)
  -- Guard failed: try remaining arms
  let next_start = buf_len(code)
  cg_patch_cbz(code, cbz_pos, gp, next_start)
  cg_match_remaining(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  let after = buf_len(code)
  cg_patch_b(code, b_pos, after)
  ctr + 1
}

-- Handle binding pattern: bind scrutinee to variable name
fn cg_match_bind_arm(body: i64, pat: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let b_ns = node_f1(pat)
  let b_nl = node_f2(pat)
  let scr_rid = reg_id(scrutinee_ctr)
  let new_scope = scope_push(scope, b_ns, b_nl, scr_rid)
  cg_expr(body, code, new_scope, src, ctr, fm)
}

-- Handle int literal (19) and constructor (20) patterns
fn cg_match_arm_high(arms: i64, n_arms: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, scrutinee_ctr: i64) -> i64 {
  let arm = nlist_get(arms, 0)
  let pat_tag = node_tag(node_f1(arm))
  if pat_tag == 19 {
    cg_match_int_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  } else {
    cg_match_ctor_arm(arms, n_arms, code, scope, src, ctr, fm, scrutinee_ctr)
  }
}
-- Copy arms from index start to a new list
fn cg_copy_arms_from(arms: i64, n: i64, dest: i64, start: i64) -> i64 {
  let mut i = start
  while i < n {
    nlist_add(dest, nlist_get(arms, i))
    i = i + 1
  }
  0
}

fn cg_block(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let first = node_f1(node)
  let rest = node_f2(node)
  let c = cg_expr(first, code, scope, src, ctr, fm)
  cg_expr(rest, code, scope, src, c, fm)
}

-- tags 1-7: int, ident, binop, call, if, let, block
fn cg_expr_low(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  if tag == 1 { cg_int(node, code, ctr) }
  else { if tag == 2 { cg_ident(node, code, scope, src, ctr) }
  else { if tag == 3 { cg_binop(node, code, scope, src, ctr, fm) }
  else { if tag == 4 { cg_call(node, code, scope, src, ctr, fm) }
  else { if tag == 5 { cg_if(node, code, scope, src, ctr, fm) }
  else { if tag == 6 { cg_let(node, code, scope, src, ctr, fm) }
  else { cg_block(node, code, scope, src, ctr, fm) } } } } } }
}

-- tags 9+: string, while, let_mut, assign, field_access, record_init, match
fn cg_expr_high(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  if tag == 9 { cg_string(node, code, scope, src, ctr, fm) }
  else { if tag == 10 { cg_while(node, code, scope, src, ctr, fm) }
  else { if tag == 11 { cg_let_mut(node, code, scope, src, ctr, fm) }
  else { if tag == 12 { cg_assign(node, code, scope, src, ctr, fm) }
  else { if tag == 13 { cg_field_access(node, code, scope, src, ctr, fm) }
  else { if tag == 14 { cg_record_init(node, code, scope, src, ctr, fm) }
  else { if tag == 15 { cg_match(node, code, scope, src, ctr, fm) }
  else { if tag == 22 { cg_not(node, code, scope, src, ctr, fm) }
  else { if tag == 24 { cg_int(node_new(1, node_f1(node), 0, 0, 0), code, ctr) }
  else { cg_int(node_new(1, 0, 0, 0, 0), code, ctr) } } } } } } } } }
}

-- codegen_expr: emit code for an expression, return next counter
fn cg_expr(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let tag = node_tag(node)
  if tag <= 7 {
    cg_expr_low(node, code, scope, src, ctr, fm)
  } else {
    cg_expr_high(node, code, scope, src, ctr, fm)
  }
}

fn cg_not(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let operand = node_f1(node)
  let c1 = cg_expr(operand, code, scope, src, ctr, fm)
  let val_phys = emit_load_reg(code, c1 - 1)
  -- CMP val, #0; CSET rd, EQ (0->1, nonzero->0)
  bu32(code, encode_cmp(val_phys, 31))
  if ctr < 8 {
    bu32(code, encode_cset(ctr + 19, 0))
  } else {
    bu32(code, encode_cset(17, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_int(node: i64, code: i64, ctr: i64) -> i64 {
  let val = node_f1(node)
  if ctr < 8 {
    emit_mov_imm(code, ctr + 19, val)
  } else {
    -- Spill: MOV x17, val then STR to stack
    emit_mov_imm(code, 17, val)
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_ident(node: i64, code: i64, scope: i64, src: i64, ctr: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let reg = scope_lookup(scope, src, ns, nl)
  -- Load source value into a physical register
  let src_phys = if reg < 0 {
    -- Spill slot: LDR x16, [sp, #(slot*8)]
    let slot = 0 - reg - 1
    bu32(code, 4181721088 + slot * 1024 + 31 * 32 + 16)
    16
  } else { reg }
  -- Store to destination
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, src_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, src_phys, 0))
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_binop(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let op = node_f1(node)
  let lhs = node_f2(node)
  let rhs = node_f3(node)
  let c1 = cg_expr(lhs, code, scope, src, ctr, fm)
  let c2 = cg_expr(rhs, code, scope, src, c1, fm)
  -- Load LHS into x16, RHS into x17 (use different temps for spilled values)
  let lhs_phys = emit_load_reg(code, c1 - 1)
  let rhs_phys = emit_load_rhs(code, c2 - 1)
  -- Compute into x17
  cg_binop_emit(code, op, 17, lhs_phys, rhs_phys)
  -- Store result
  if c2 < 8 {
    bu32(code, encode_add_imm(c2 + 19, 17, 0))
  } else {
    emit_store_reg(code, c2, 17)
  }
  c2 + 1
}

fn cg_binop_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  if op == 1 { bu32(code, encode_add_reg(rd, rn, rm)) }
  else { if op == 2 { bu32(code, encode_sub_reg(rd, rn, rm)) }
  else { if op == 3 { bu32(code, encode_mul(rd, rn, rm)) }
  else { if op == 4 { bu32(code, encode_sdiv(rd, rn, rm)) }
  else { if op == 11 {
    -- Modulo: rd = rn - (rn/rm)*rm. Use x15 as temp for SDIV result.
    bu32(code, encode_sdiv(15, rn, rm))
    bu32(code, encode_msub(rd, 15, rm, rn))
  }
  else { if op == 12 { bu32(code, encode_and_reg(rd, rn, rm)) }
  else { if op == 13 { bu32(code, encode_orr_reg(rd, rn, rm)) }
  else { if op == 14 { bu32(code, encode_and_reg(rd, rn, rm)) }
  else { if op == 15 { bu32(code, encode_orr_reg(rd, rn, rm)) }
  else { if op == 16 { bu32(code, encode_eor_reg(rd, rn, rm)) }
  else { if op == 17 { bu32(code, encode_lsl_reg(rd, rn, rm)) }
  else { if op == 18 { bu32(code, encode_asr_reg(rd, rn, rm)) }
  else { cg_cmp_emit(code, op, rd, rn, rm) } } } } } } } } } } } }
}

fn cg_cmp_emit(code: i64, op: i64, rd: i64, rn: i64, rm: i64) -> i64 {
  -- ==5 !=6 <7 >8 <=9 >=10
  bu32(code, encode_cmp(rn, rm))
  let cond = if op == 5 { 0 }
    else { if op == 6 { 1 }
    else { if op == 7 { 11 }
    else { if op == 8 { 12 }
    else { if op == 9 { 13 }
    else { 10 } } } } }
  bu32(code, encode_cset(rd, cond))
}

-- ======================================================================
-- Intrinsics
-- ======================================================================

-- Intrinsic detection: name starts with __
fn is_intrinsic(src: i64, ns: i64, nl: i64) -> i64 {
  if nl < 2 { 0 }
  else {
    if __mem_load8(src + ns) == 95 {
      if __mem_load8(src + ns + 1) == 95 { 1 }
      else { 0 }
    } else { 0 }
  }
}

-- Move result from x17 to ctr register
fn cg_i_result(code: i64, ctr: i64) -> i64 {
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 17, 0))
  } else {
    emit_store_reg(code, ctr, 17)
  }
  ctr + 1
}

fn cg_i_syscall(code: i64, ctr: i64) -> i64 {
  -- Args: x0=num, x1-x6=syscall args
  -- MOV x16, x0
  bu32(code, encode_add_imm(16, 0, 0))
  -- Shift args: x0=x1, x1=x2, ..., x5=x6
  bu32(code, encode_add_imm(0, 1, 0))
  bu32(code, encode_add_imm(1, 2, 0))
  bu32(code, encode_add_imm(2, 3, 0))
  bu32(code, encode_add_imm(3, 4, 0))
  bu32(code, encode_add_imm(4, 5, 0))
  bu32(code, encode_add_imm(5, 6, 0))
  -- MOVK x16, #0x200, LSL #16 (BSD class bit)
  bu32(code, encode_movk(16, 512, 16))
  -- SVC #0x80 = 0xD4001001 = 3556773889
  bu32(code, 3556773889)
  -- Result in x0 -> move to ctr register
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
  ctr + 1
}

fn cg_i_bump_alloc(code: i64, ctr: i64) -> i64 {
  -- x0 = size. Result = old x28 (bump pointer).
  -- MOV x17, x28
  bu32(code, encode_add_imm(17, 28, 0))
  -- ADD x28, x28, x0 (advance bump pointer)
  bu32(code, encode_add_reg(28, 28, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_store64(code: i64, ctr: i64) -> i64 {
  -- x0=addr, x1=val. STR x1, [x0]: 0xF9000000 = 4177526784
  bu32(code, 4177526784 + 0 * 32 + 1)
  -- Return val (x1) as result
  bu32(code, encode_add_imm(17, 1, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_store8(code: i64, ctr: i64) -> i64 {
  -- x0=addr, x1=val. STRB w1, [x0]: 0x39000000 = 956301312
  bu32(code, 956301312 + 0 * 32 + 1)
  bu32(code, encode_add_imm(17, 1, 0))
  cg_i_result(code, ctr)
}

fn cg_i_mem_load64(code: i64, ctr: i64) -> i64 {
  -- x0=addr. LDR x17, [x0]: 0xF9400000 = 4181721088
  bu32(code, 4181721088 + 0 * 32 + 17)
  cg_i_result(code, ctr)
}

fn cg_i_mem_load8(code: i64, ctr: i64) -> i64 {
  -- x0=addr. LDRB w17, [x0]: 0x39400000 = 960495616
  bu32(code, 960495616 + 0 * 32 + 17)
  cg_i_result(code, ctr)
}

fn cg_i_str_ptr(code: i64, ctr: i64) -> i64 {
  -- x0=descriptor. LDR x17, [x0, #0]
  bu32(code, 4181721088 + 0 * 32 + 17)
  cg_i_result(code, ctr)
}

fn cg_i_str_len(code: i64, ctr: i64) -> i64 {
  -- x0=descriptor. LDR x17, [x0, #8]: offset=8, 8/8=1
  bu32(code, 4181721088 + 1 * 1024 + 0 * 32 + 17)
  cg_i_result(code, ctr)
}

fn cg_intrinsic(code: i64, src: i64, ns: i64, nl: i64, ctr: i64) -> i64 {
  if src_eq(src, ns, nl, "__syscall") == 1 { cg_i_syscall(code, ctr) }
  else { if src_eq(src, ns, nl, "__bump_alloc") == 1 { cg_i_bump_alloc(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_store64") == 1 { cg_i_mem_store64(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_store8") == 1 { cg_i_mem_store8(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_load64") == 1 { cg_i_mem_load64(code, ctr) }
  else { if src_eq(src, ns, nl, "__mem_load8") == 1 { cg_i_mem_load8(code, ctr) }
  else { if src_eq(src, ns, nl, "__str_ptr") == 1 { cg_i_str_ptr(code, ctr) }
  else { if src_eq(src, ns, nl, "__str_len") == 1 { cg_i_str_len(code, ctr) }
  else { ctr } } } } } } } }
}

-- ======================================================================
-- Variant constructor
-- ======================================================================

-- Variant constructor: allocate 16 bytes [tag_hash, payload]
fn cg_variant_init(code: i64, scope: i64, src: i64, ctr: i64, fm: i64, tag_hash: i64, args: i64, nargs: i64) -> i64 {
  -- Allocate 16 bytes: MOV x0, #16; MOV x17, x28; ADD x28, x28, x0
  emit_mov_imm(code, 0, 16)
  let e1 = encode_add_imm(17, 28, 0)
  bu32(code, e1)
  let e2 = encode_add_reg(28, 28, 0)
  bu32(code, e2)
  -- Store tag hash at [x17, #0]
  emit_mov_imm(code, 16, tag_hash)
  -- STR x16, [x17, #0]: 4177526784 + 17*32 + 16
  bu32(code, 4177526784 + 17 * 32 + 16)
  -- Store to ctr register (variant pointer)
  if ctr < 8 {
    let e3 = encode_add_imm(ctr + 19, 17, 0)
    bu32(code, e3)
  } else {
    emit_store_reg(code, ctr, 17)
  }
  -- If has payload, evaluate and store at [variant+8]
  if nargs > 0 {
    let arg = nlist_get(args, 0)
    let c = cg_expr(arg, code, scope, src, ctr + 1, fm)
    -- Load variant base
    let base_phys = emit_load_reg(code, ctr)
    let val_phys = emit_load_rhs(code, c - 1)
    -- STR val, [base, #8]: 4177526784 + 1*1024 + base*32 + val
    bu32(code, 4177526784 + 1024 + base_phys * 32 + val_phys)
    ctr + 1
  } else {
    -- No payload: store -1 sentinel at [variant+8]
    emit_mov_imm(code, 16, 0 - 1)
    let base_phys = emit_load_reg(code, ctr)
    -- STR x16, [base, #8]
    bu32(code, 4177526784 + 1024 + base_phys * 32 + 16)
    ctr + 1
  }
}

-- ======================================================================
-- Call, if, let, fn, module
-- ======================================================================

fn cg_call(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let args = node_f3(node)
  let nargs = node_f4(node)
  -- Check for variant constructor (before evaluating args)
  let tt = fmap_get_tt(fm)
  let tag_hash = if tt > 0 { ttable_find_variant(tt, src, ns, nl) } else { 0 - 1 }
  if tag_hash >= 0 {
    -- Variant constructor: allocate 16 bytes, store [tag_hash, payload]
    cg_variant_init(code, scope, src, ctr, fm, tag_hash, args, nargs)
  } else {
    -- Normal call
    let c = cg_call_args(args, nargs, code, scope, src, ctr, fm, 0)
    if is_intrinsic(src, ns, nl) == 1 {
      cg_intrinsic(code, src, ns, nl, c)
    } else {
      cg_call_emit(code, src, ns, nl, fm, c)
    }
  }
}

-- Two-phase call arg evaluation:
-- Phase 1: evaluate each arg into callee-saved/spill registers, record result counters
-- Phase 2: move each arg from its register to x0..xN (no BL = no clobber)
fn cg_call_args(args: i64, nargs: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64, start: i64) -> i64 {
  let results = __bump_alloc(nargs * 8 + 8)
  -- Phase 1: evaluate args
  let mut i = start
  let mut c = ctr
  while i < nargs {
    let arg = nlist_get(args, i)
    c = cg_expr(arg, code, scope, src, c, fm)
    __mem_store64(results + i * 8, c - 1)
    i = i + 1
  }
  -- Phase 2: move results to x0..xN
  let mut j = start
  while j < nargs {
    let result_ctr = __mem_load64(results + j * 8)
    let arg_phys = emit_load_reg(code, result_ctr)
    bu32(code, encode_add_imm(j, arg_phys, 0))
    j = j + 1
  }
  c
}

fn cg_call_emit(code: i64, src: i64, ns: i64, nl: i64, fm: i64, ctr: i64) -> i64 {
  -- BL to function (may be forward reference)
  let target = fmap_lookup(fm, src, ns, nl)
  let cur = buf_len(code)
  if target == 0 {
    -- Forward reference: emit placeholder, record for patching
    fmap_add_patch(fm, cur, src, ns, nl)
    bu32(code, encode_bl(0))
  } else {
    bu32(code, encode_bl(target - cur))
  }
  -- Move result from x0 to register or spill
  if ctr < 8 {
    bu32(code, encode_add_imm(ctr + 19, 0, 0))
  } else {
    emit_store_reg(code, ctr, 0)
  }
  ctr + 1
}

fn cg_if(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let cond = node_f1(node)
  let then_n = node_f2(node)
  let else_n = node_f3(node)
  -- Emit condition
  let c1 = cg_expr(cond, code, scope, src, ctr, fm)
  let cond_phys = emit_load_reg(code, c1 - 1)
  -- CBZ cond_reg, else_branch (patch later)
  let cbz_pos = buf_len(code)
  bu32(code, 0)
  -- Emit then branch (starts at c1, same as where else will start)
  let c2 = cg_expr(then_n, code, scope, src, c1, fm)
  -- Move then result to merge point at c1
  let then_phys = emit_load_reg(code, c2 - 1)
  if c1 < 8 {
    bu32(code, encode_add_imm(c1 + 19, then_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, then_phys, 0))
    emit_store_reg(code, c1, 17)
  }
  -- B over else (patch later)
  let b_pos = buf_len(code)
  bu32(code, 0)
  -- Else branch (ALSO starts at c1 — both branches share register space)
  let else_start = buf_len(code)
  let c3 = cg_expr(else_n, code, scope, src, c1, fm)
  let else_phys = emit_load_reg(code, c3 - 1)
  if c1 < 8 {
    bu32(code, encode_add_imm(c1 + 19, else_phys, 0))
  } else {
    bu32(code, encode_add_imm(17, else_phys, 0))
    emit_store_reg(code, c1, 17)
  }
  let after_else = buf_len(code)
  -- Patch CBZ: jump to else_start
  cg_patch_cbz(code, cbz_pos, cond_phys, else_start)
  -- Patch B: jump to after_else
  cg_patch_b(code, b_pos, after_else)
  -- Result at c1, next available is c1+1
  c1 + 1
}

fn cg_patch_cbz(code: i64, pos: i64, reg: i64, target: i64) -> i64 {
  let off = target - pos
  let off4 = off / 4
  -- CBZ: 0xB4000000 = 3019898880
  let masked = if off4 < 0 { 524288 + off4 } else { off4 }
  let enc = 3019898880 + masked * 32 + reg
  let d = buf_ptr(code)
  __mem_store8(d + pos, enc - enc / 256 * 256)
  __mem_store8(d + pos + 1, enc / 256 - enc / 65536 * 256)
  __mem_store8(d + pos + 2, enc / 65536 - enc / 16777216 * 256)
  __mem_store8(d + pos + 3, enc / 16777216 - enc / 4294967296 * 256)
  0
}

fn cg_patch_b(code: i64, pos: i64, target: i64) -> i64 {
  let off = target - pos
  let enc = encode_b(off)
  let d = buf_ptr(code)
  __mem_store8(d + pos, enc - enc / 256 * 256)
  __mem_store8(d + pos + 1, enc / 256 - enc / 65536 * 256)
  __mem_store8(d + pos + 2, enc / 65536 - enc / 16777216 * 256)
  __mem_store8(d + pos + 3, enc / 16777216 - enc / 4294967296 * 256)
  0
}

fn cg_let(node: i64, code: i64, scope: i64, src: i64, ctr: i64, fm: i64) -> i64 {
  let ns = node_f1(node)
  let nl = node_f2(node)
  let val = node_f3(node)
  let body = node_f4(node)
  -- Emit value
  let c1 = cg_expr(val, code, scope, src, ctr, fm)
  -- Store register ID for scope (physical reg or negative spill indicator)
  let val_rid = reg_id(c1 - 1)
  let new_scope = scope_push(scope, ns, nl, val_rid)
  cg_expr(body, code, new_scope, src, c1, fm)
}

-- Emit a complete function
fn cg_fn(fn_node: i64, code: i64, fm: i64, src: i64) -> i64 {
  let ns = node_f1(fn_node)
  let nl = node_f2(fn_node)
  let params = node_f3(fn_node)
  let body = node_f4(fn_node)
  -- Update fmap entry with actual offset (registered in pass 1)
  let fn_off = buf_len(code)
  fmap_update_offset(fm, src, ns, nl, fn_off)
  -- Emit prologue
  emit_prologue(code)
  -- Set up scope with params
  let nparams = nlist_len(params)
  let scope = cg_fn_params(params, nparams, src, scope_new(), code)
  -- Emit body
  let ctr = cg_expr(body, code, scope, src, nparams, fm)
  -- Move result to x0
  let result_phys = emit_load_reg(code, ctr - 1)
  bu32(code, encode_add_imm(0, result_phys, 0))
  -- Emit epilogue
  emit_epilogue(code)
  0
}

fn cg_fn_params(params: i64, n: i64, src: i64, scope: i64, code: i64) -> i64 {
  let mut i = 0
  let mut s = scope
  while i < n {
    let p = nlist_get(params, i)
    let ns = node_f1(p)
    let nl = node_f2(p)
    if i < 8 {
      let rd = reg_phys(i)
      -- MOV callee_saved, xi
      bu32(code, encode_add_imm(rd, i, 0))
      s = scope_push(s, ns, nl, rd)
    } else {
      -- Spill xi to stack slot
      emit_store_reg(code, i, i)
      s = scope_push(s, ns, nl, reg_id(i))
    }
    i = i + 1
  }
  s
}

-- Unwrap fn wrapper: tag-23 wraps {inner_fn, ret_type}
fn unwrap_fn(fn_wrap: i64) -> i64 {
  if node_tag(fn_wrap) == 23 { node_f1(fn_wrap) }
  else { fn_wrap }
}

fn cg_module(fns: i64, code: i64, fm: i64) -> i64 {
  let n = nlist_len(fns)
  -- Pass 1: register all function names (hoisting)
  let mut i = 0
  while i < n {
    let pair = nlist_get(fns, i)
    let fn_node = unwrap_fn(node_f1(pair))
    let fn_src = node_f2(pair)
    fmap_add(fm, fn_src, node_f1(fn_node), node_f2(fn_node), 0)
    i = i + 1
  }
  -- Pass 2: compile all function bodies
  let mut j = 0
  while j < n {
    let pair = nlist_get(fns, j)
    cg_fn(unwrap_fn(node_f1(pair)), code, fm, node_f2(pair))
    j = j + 1
  }
  code
}
