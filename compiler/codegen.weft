fn fmap_inc_semantic_residual_count(fm: i64) -> i64 { __mem_store64(fm + 448, __mem_load64(fm + 448) + 1) 0 }
fn fmap_semantic_residual_callback_count(fm: i64) -> i64 { __mem_load64(fm + 456) }
fn fmap_inc_semantic_residual_callback_count(fm: i64) -> i64 { __mem_store64(fm + 456, __mem_load64(fm + 456) + 1) 0 }
