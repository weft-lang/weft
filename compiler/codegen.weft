pub(package) fn cg_borrow_expr_mentions_name(node: i64, src: i64, ns: i64, nl: i64) -> bool {
  if node == 0 { false }
  else {
    match node_tag(node) {
      2 -> cg_ident_matches(node, src, ns, nl)
      3 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      4 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { true } else { cg_borrow_expr_list_mentions_name(node_f3(node), node_f4(node), src, ns, nl) }
      5 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      6 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      7 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      10 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      11 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      12 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 { true } else { cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) }
      13 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      14 -> cg_borrow_record_fields_mention_name(node_f3(node), node_f4(node), src, ns, nl)
      63 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_record_fields_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      15 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_match_arms_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      22 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      25 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      26 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      29 -> {
        if cg_borrow_param_list_has_name(node_f1(node), node_f3(node), src, ns, nl) == 1 { false }
        else { cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl) }
      }
      32 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f4(node), nlist_len(node_f4(node)), src, ns, nl)
      33 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_handler_clauses_mention_name(node_f2(node), node_f3(node), src, ns, nl)
      35 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      36 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      37 -> {
        let inner = node_f1(node)
        if cg_same_name(src, node_f1(inner), node_f2(inner), ns, nl) == 1 {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl)
        } else {
          cg_borrow_expr_mentions_name(node_f3(inner), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(inner), src, ns, nl)
        }
      }
      41 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_list_mentions_name(node_f3(node), nlist_len(node_f3(node)), src, ns, nl)
      45 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      46 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      47 -> if cg_same_name(src, node_f1(node), node_f2(node), ns, nl) == 1 {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl)
      } else {
        cg_borrow_expr_mentions_name(node_f3(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f4(node), src, ns, nl)
      }
      48 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      49 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      52 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      55 -> cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      56 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl)
      57 -> cg_borrow_expr_mentions_name(node_f1(node), src, ns, nl) or cg_borrow_expr_mentions_name(node_f2(node), src, ns, nl)
      _ -> false
    }
  }
}

