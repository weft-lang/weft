    if node_tag(lhs) != 2 { cg_evidence_scan_state_reject_reason(s, cg_evidence_residual_unsupported()) }
    else {
      let eff_hash = str_hash(src, node_f1(lhs), node_f2(lhs))
      let op_hash = str_hash(src, node_f2(node), node_f3(node))
      cg_evidence_scan_record(s, src, fm, eff_hash, op_hash)
    }
  }
}

fn cg_evidence_scan_expr_scoped(node: i64, src: i64, fm: i64, s: i64, bindings: i64, stack: i64, callbacks: i64) -> i64 {
  if node == 0 or __mem_load64(s) == 0 { 0 }
  else {
    match node_tag(node) {
      3 -> { cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f3(node), src, fm, s, bindings, stack, callbacks) }
      4 -> cg_evidence_scan_direct_call(node, src, fm, s, bindings, stack, callbacks)
      5 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f3(node), src, fm, s, bindings, stack, callbacks) }
      6 -> {
        let val = node_f3(node)
        if node_tag(val) == 29 { 0 } else { cg_evidence_scan_expr_scoped(val, src, fm, s, bindings, stack, callbacks) }
        let meta = cg_evidence_lambda_binding_meta(val, node_f4(node), src, bindings, node_f1(node), node_f2(node))
        cg_evidence_scan_expr_scoped(node_f4(node), src, fm, s, cg_evidence_bindings_push_meta(bindings, node_f1(node), node_f2(node), meta), stack, callbacks)
      }
      7 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) }
      10 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) }
      11 -> {
        let val = node_f3(node)
        if node_tag(val) == 29 { 0 } else { cg_evidence_scan_expr_scoped(val, src, fm, s, bindings, stack, callbacks) }
        let meta = cg_evidence_lambda_binding_meta(val, node_f4(node), src, bindings, node_f1(node), node_f2(node))
        cg_evidence_scan_expr_scoped(node_f4(node), src, fm, s, cg_evidence_bindings_push_meta(bindings, node_f1(node), node_f2(node), meta), stack, callbacks)
      }
      12 -> cg_evidence_scan_expr_scoped(node_f3(node), src, fm, s, bindings, stack, callbacks)
      13 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      14 -> cg_evidence_scan_record_fields_scoped(node_f3(node), node_f4(node), src, fm, s, bindings, stack, callbacks)
      15 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_match_arms_scoped(node_f2(node), node_f3(node), src, fm, s, bindings, stack, callbacks) }
      22 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      25 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      26 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      29 -> cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, cg_evidence_bindings_push_params(bindings, node_f1(node)), stack, callbacks)
      32 -> cg_evidence_scan_perform_scoped(node, src, fm, s, bindings, stack, callbacks)
      33 -> cg_evidence_scan_state_reject(s)
      35 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      36 -> cg_evidence_scan_generic_call(node, src, fm, s, bindings, stack, callbacks)
      37 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      41 -> cg_evidence_scan_state_reject(s)
      45 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      46 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) }
      47 -> cg_evidence_scan_state_reject(s)
      48 -> cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks)
      49 -> cg_evidence_scan_state_reject(s)
      52 -> { cg_evidence_scan_expr_scoped(node_f1(node), src, fm, s, bindings, stack, callbacks) cg_evidence_scan_expr_scoped(node_f2(node), src, fm, s, bindings, stack, callbacks) }
      _ -> 0
    }
  }
}

fn cg_evidence_scan_expr(node: i64, src: i64, fm: i64, s: i64) -> i64 {
  cg_evidence_scan_expr_scoped(node, src, fm, s, 0, 0, 0)
}

fn cg_effect_evidence_info_for_lambda(node: i64, fm: i64, src: i64) -> i64 {
  if node == 0 { 0 }
  else { if node_tag(node) != 29 { 0 }
  else {
    let params = node_f1(node)
    let body = node_f2(node)
    let nparams = node_f3(node)
    if nparams > 7 { 0 }
    else {
      let s = cg_evidence_scan_state_new()
      let bindings = cg_evidence_bindings_from_params(params)
      cg_evidence_scan_expr_scoped(body, src, fm, s, bindings, 0, fmap_effect_callback_top(fm))
      if __mem_load64(s) == 1 and __mem_load64(s + 8) > 0 {
        let fact = cg_semantic_fact_new_raw(fm, 0, 0, __mem_load64(s + 8), 0, cg_params_managed_mask(params), 0, 0)
        cg_semantic_fact_set_evidence(fact, __mem_load64(s + 16), __mem_load64(s + 8), 0, 0)
      } else { 0 }
    }
  } }
}

fn cg_effect_evidence_info_for_generic_call(node: i64, fm: i64, src: i64, entry: i64, scope: i64) -> i64 {
  if entry == 0 {
    fmap_inc_semantic_residual_reason(fm, cg_evidence_residual_unsupported())
    0
  }
  else {
    let type_args = cg_type_args_in_current_context(fm, node_f1(node))
    let call_node = node_f2(node)
    let fn_wrap = node_f2(entry)
    let fn_node = unwrap_fn(fn_wrap)
    let subst = cg_build_subst(fn_tparams(fn_wrap), type_args)
    let params = cg_params_subst(node_f3(fn_node), subst)
    let ret_ty = cg_generic_subst_ret(fn_wrap, type_args)
    let fact = cg_semantic_fact_new_for_fn(fm, fn_wrap, params, ret_ty, 0)
    let nparams = nlist_len(params)
    if nparams != node_f4(call_node) {
      fmap_inc_semantic_residual_reason(fm, cg_evidence_residual_arity())
      0
    }
    else { if nparams > 7 {
      fmap_inc_semantic_residual_reason(fm, cg_evidence_residual_arity())
      0
    }
    else {
      let s = cg_evidence_scan_state_new()
      let callbacks = cg_evidence_callback_map_for_call(node_f3(call_node), node_f4(call_node), params, src, fm, fmap_effect_callback_top(fm), scope, 1)
      cg_evidence_scan_generic_entry_body(entry, type_args, fm, s, 0, callbacks)
      if __mem_load64(s) == 1 and __mem_load64(s + 8) > 0 {
        fmap_inc_semantic_summary_count(fm)
        cg_semantic_fact_set_evidence(fact, __mem_load64(s + 16), __mem_load64(s + 8), callbacks, cg_evidence_callback_map_hash(callbacks))
      } else {
        let reason = if __mem_load64(s) == 1 and __mem_load64(s + 8) == 0 { cg_evidence_residual_no_ops() } else { __mem_load64(s + 32) }
        fmap_inc_semantic_residual_reason(fm, reason)
        0
      }
    } }
  }
}

