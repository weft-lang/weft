  __mem_store64(s, 1)
  __mem_store64(s + 8, 0)
  __mem_store64(s + 16, 0)
  __mem_store64(s + 24, 0)
  __mem_store64(s + 32, 0)
  __mem_store64(s + 40, 0)
  s
}

fn cg_evidence_scan_state_reject_reason(s: i64, reason: i64) -> i64 {
  __mem_store64(s, 0)
  if __mem_load64(s + 32) == 0 { __mem_store64(s + 32, reason) } else { 0 }
  0
}

fn cg_evidence_scan_state_reject(s: i64) -> i64 {
  cg_evidence_scan_state_reject_reason(s, cg_evidence_residual_unsupported())
