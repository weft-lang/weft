-- compiler/source_position.weft -- shared UTF-8 source-position facts
--
-- Compiler spans stay byte offsets. This module is the one conversion
-- boundary for human scalar columns and protocol UTF-8/UTF-16/UTF-32 units.

use runtime/memory.{mem_load8_at}

pub type SourcePosition {
  SourcePositionKnown(i64, i64, i64, i64, i64),
    SourcePositionInvalid(i64)
}

pub(package) fn source_position_encoding_utf8() -> i64 { 1 }

pub(package) fn source_position_encoding_utf16() -> i64 { 2 }

pub(package) fn source_position_encoding_utf32() -> i64 { 3 }

-- Return the strict UTF-8 sequence width at `pos`, or -1 for malformed input.
-- The boundary cases exclude overlong encodings, surrogate code points, and
-- scalars above U+10FFFF.
pub(package) fn source_position_utf8_width(src: i64, n: i64, pos: i64) -> i64 {
  if pos < 0 or pos >= n { 0 - 1 }
  else {
    let b1 = mem_load8_at(src, pos)
    if b1 <= 127 { 1 }
    else { if b1 >= 194 and b1 <= 223 {
        if pos + 1 < n {
          let b2 = mem_load8_at(src, pos + 1)
          if b2 >= 128 and b2 <= 191 { 2 } else { 0 - 1 }
        } else { 0 - 1 }
      } else { if b1 >= 224 and b1 <= 239 {
          if pos + 2 < n {
            let b2 = mem_load8_at(src, pos + 1)
            let b3 = mem_load8_at(src, pos + 2)
            let b2_ok = if b1 == 224 { b2 >= 160 and b2 <= 191 }
            else { if b1 == 237 { b2 >= 128 and b2 <= 159 }
              else { b2 >= 128 and b2 <= 191 } }
            if b2_ok and b3 >= 128 and b3 <= 191 { 3 } else { 0 - 1 }
          } else { 0 - 1 }
        } else { if b1 >= 240 and b1 <= 244 {
            if pos + 3 < n {
              let b2 = mem_load8_at(src, pos + 1)
              let b3 = mem_load8_at(src, pos + 2)
              let b4 = mem_load8_at(src, pos + 3)
              let b2_ok = if b1 == 240 { b2 >= 144 and b2 <= 191 }
              else { if b1 == 244 { b2 >= 128 and b2 <= 143 }
                else { b2 >= 128 and b2 <= 191 } }
              if b2_ok and b3 >= 128 and b3 <= 191 and b4 >= 128 and b4 <= 191 { 4 }
              else { 0 - 1 }
            } else { 0 - 1 }
          } else { 0 - 1 } } } }
  }
}

pub(package) fn source_position_is_newline_at(src: i64, n: i64, pos: i64) -> i64 {
  if pos < 0 or pos >= n { 0 }
  else {
    let ch = mem_load8_at(src, pos)
    if ch == 10 { 1 }
    else { if ch == 13 { if pos + 1 < n and mem_load8_at(src, pos + 1) == 10 { 2 } else { 1 } }
      else { 0 } }
  }
}

pub(package) fn source_position_at(src: i64, n: i64, byte_offset: i64) -> SourcePosition {
  let target = if byte_offset < 0 { 0 } else { if byte_offset > n { n } else { byte_offset } }
  let mut pos = 0
  let mut line = 0
  let mut byte_col = 0
  let mut scalar_col = 0
  let mut utf16_col = 0
  let mut invalid = 0 - 1
  while pos < target and invalid < 0 {
    let newline_width = source_position_is_newline_at(src, n, pos)
    if newline_width > 0 and pos + newline_width <= target {
      pos = pos + newline_width
      line = line + 1
      byte_col = 0
      scalar_col = 0
      utf16_col = 0
    } else {
      let width = source_position_utf8_width(src, n, pos)
      if width < 0 { invalid = pos }
      else { if pos + width > target {
          -- UTF-8 protocol cursors may address a byte inside a scalar. Preserve
          -- that byte column while scalar/UTF-16 columns stay at the preceding
          -- scalar boundary.
          byte_col = byte_col + target - pos
          pos = target
        } else {
          pos = pos + width
          byte_col = byte_col + width
          scalar_col = scalar_col + 1
          utf16_col = utf16_col + if width == 4 { 2 } else { 1 }
        } }
    }
  }
  if invalid >= 0 { SourcePositionInvalid(invalid) }
  else { SourcePositionKnown(target, line, byte_col, scalar_col, utf16_col) }
}

pub(package) fn source_position_is_valid(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> 1 SourcePositionInvalid(at) -> 0 }
}

pub(package) fn source_position_invalid_offset(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> 0 - 1 SourcePositionInvalid(at) -> at }
}

pub(package) fn source_position_line0(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> line SourcePositionInvalid(at) -> 0 - 1 }
}

pub(package) fn source_position_byte_column0(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> byte_col SourcePositionInvalid(at) -> 0 - 1 }
}

pub(package) fn source_position_scalar_column0(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> scalar_col SourcePositionInvalid(at) -> 0 - 1 }
}

pub(package) fn source_position_utf16_column0(position: SourcePosition) -> i64 {
  match position { SourcePositionKnown(byte, line, byte_col, scalar_col, utf16_col) -> utf16_col SourcePositionInvalid(at) -> 0 - 1 }
}

pub(package) fn source_position_column0(position: SourcePosition, encoding: i64) -> i64 {
  if encoding == source_position_encoding_utf8() { source_position_byte_column0(position) }
  else { if encoding == source_position_encoding_utf16() { source_position_utf16_column0(position) }
    else { source_position_scalar_column0(position) } }
}

pub(package) fn source_position_unit_width(utf8_width: i64, encoding: i64) -> i64 {
  if encoding == source_position_encoding_utf8() { utf8_width }
  else { if encoding == source_position_encoding_utf16() { if utf8_width == 4 { 2 } else { 1 } }
    else { 1 } }
}

-- Convert a zero-based protocol line/column back to a byte offset. Columns
-- beyond a line clamp to its end as required by LSP. A cursor inside a
-- multi-unit scalar clamps to that scalar's starting byte boundary.
pub(package) fn source_position_offset_for_line_column(src: i64, n: i64, target_line: i64, target_column: i64, encoding: i64) -> i64 {
  let wanted_line = if target_line < 0 { 0 } else { target_line }
  let wanted_column = if target_column < 0 { 0 } else { target_column }
  let mut pos = 0
  let mut line = 0
  let mut invalid = 0
  while pos < n and line < wanted_line and invalid == 0 {
    let newline_width = source_position_is_newline_at(src, n, pos)
    if newline_width > 0 {
      pos = pos + newline_width
      line = line + 1
    } else {
      let width = source_position_utf8_width(src, n, pos)
      if width < 0 { invalid = 1 } else { pos = pos + width }
    }
  }
  if invalid == 1 { 0 - 1 }
  else { if line < wanted_line { n }
    else {
      let mut column = 0
      let mut done = 0
      while pos < n and done == 0 {
        let newline_width = source_position_is_newline_at(src, n, pos)
        if newline_width > 0 or column >= wanted_column { done = 1 }
        else {
          let width = source_position_utf8_width(src, n, pos)
          if width < 0 { invalid = 1 done = 1 }
          else {
            let units = source_position_unit_width(width, encoding)
            if column + units > wanted_column { done = 1 }
            else { column = column + units pos = pos + width }
          }
        }
      }
      if invalid == 1 { 0 - 1 } else { pos }
    } }
}
