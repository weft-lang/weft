-- compiler/types.weft — Set-theoretic type representation and subtyping
--
-- Types are sets. Union (|), intersection (&), complement (~) are primitive.
-- Subtyping is set inclusion: A <: B iff A & ~B is empty.
-- Checked via DNF normalization and emptiness testing.
--
-- The Conformance effect is used by the emptiness checker to determine
-- if a conjunction like `i64 & Display` is satisfiable. The handler
-- is installed in main.weft's compile function, backed by the
-- conformance table built from impl blocks.

use compiler/lib.{*}
use runtime/memory.{*}
use runtime/types_storage.{*}

pub(package) effect Conformance {
  fn conforms(ty: i64, trait_hash: i64) -> i64
}
--
-- Memory layout: each type node is 40 bytes:
--   [0]  tag (type kind)
--   [8]  f1
--   [16] f2
--   [24] f3
--   [32] f4
--
-- Type tags:
--   0 = Never (bottom, empty set)
--   1 = Any (top, complement of never)
--   2 = Prim(id) — primitive atom: i64=0, str=1, bool=2, nil=3, f64=4, i32=5, i8=6, i16=7, u8=8, u16=9, u32=10, u64=11, isize=12, usize=13, f32=14
--   3 = Union(lhs, rhs)
--   4 = Inter(lhs, rhs) — intersection
--   5 = Compl(inner) — complement
--   6 = Fn(params, ret, effects) — function type
--   7 = Record(fields, open) — structural record type
--   8 = Variant(tag_name_hash, payload_type) — variant constructor type
--   9 = Named(name_hash, inner) — nominal type wrapper
--  10 = EffectSig(effects_list, tail_var) — concrete effect set
--  11 = EffectApp(name_hash, type_args) — individual effect atom
--  12 = TypeVar(var_id) — type variable (opaque atom in DNF)
--  13 = Trait(name_hash) — nominal trait atom
--  14 = Continuation(input, result) — linear one-shot continuation
--  15 = Ptr(inner, mutable) — typed raw pointer; mutable = 0/1
--  16 = Weak(inner) — non-owning managed reference
--  17 = Arc(inner) — internal promoted-atomic strong managed reference
--  18 = Unique(inner) — move-only ordinary data
--  19 = Owned(inner) — move-only resource capability
--  20 = Unsupported(kind) — fenced aspirational surface syntax
--  21 = Assoc(base, name_hash) — associated-type projection
--  22 = Array(element, length) — fixed-size value array
--  23 = Slice(element, mutable) — non-owning view; mutable = 0/1
--  24 = RecordField(name_hash, type, name_start, name_len) — internal child
--  25 = QualifiedEffectApp(decl, type_args) — resolved module effect atom
--  26 = SurfaceQualifiedEffect(module span, effect span/args) — parser-only
--  27 = QualifiedTrait(decl) — resolved module trait atom
--  28 = SurfaceQualifiedTrait(module/effect spans) — parser-only

-- ══════════════════════════════════════════════════════════════
-- Type constructors
-- ══════════════════════════════════════════════════════════════

pub(package) fn ty_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  types_storage_type_new(tag, f1, f2, f3, f4)
}
pub(package) fn ty_tag(t: i64) -> i64 { types_storage_type_tag(t) }
pub(package) fn ty_f1(t: i64) -> i64 { types_storage_type_f1(t) }
pub(package) fn ty_f2(t: i64) -> i64 { types_storage_type_f2(t) }
pub(package) fn ty_f3(t: i64) -> i64 { types_storage_type_f3(t) }
pub(package) fn ty_f4(t: i64) -> i64 { types_storage_type_f4(t) }

-- Primitive type IDs
pub(package) fn PRIM_I64() -> i64 { 0 }
pub(package) fn PRIM_STR() -> i64 { 1 }
pub(package) fn PRIM_BOOL() -> i64 { 2 }
pub(package) fn PRIM_NIL() -> i64 { 3 }
pub(package) fn PRIM_F64() -> i64 { 4 }
pub(package) fn PRIM_I32() -> i64 { 5 }
pub(package) fn PRIM_I8() -> i64 { 6 }
pub(package) fn PRIM_I16() -> i64 { 7 }
pub(package) fn PRIM_U8() -> i64 { 8 }
pub(package) fn PRIM_U16() -> i64 { 9 }
pub(package) fn PRIM_U32() -> i64 { 10 }
pub(package) fn PRIM_U64() -> i64 { 11 }
pub(package) fn PRIM_ISIZE() -> i64 { 12 }
pub(package) fn PRIM_USIZE() -> i64 { 13 }
pub(package) fn PRIM_F32() -> i64 { 14 }

-- Constructors
pub(package) fn ty_never() -> i64 { ty_new(0, 0, 0, 0, 0) }
pub(package) fn ty_any() -> i64 { ty_new(1, 0, 0, 0, 0) }
pub(package) fn ty_prim(id: i64) -> i64 { ty_new(2, id, 0, 0, 0) }
pub(package) fn ty_i64() -> i64 { ty_prim(PRIM_I64()) }
pub(package) fn ty_str() -> i64 { ty_prim(PRIM_STR()) }
pub(package) fn ty_bool() -> i64 { ty_prim(PRIM_BOOL()) }
pub(package) fn ty_nil() -> i64 { ty_prim(PRIM_NIL()) }
pub(package) fn ty_f64() -> i64 { ty_prim(PRIM_F64()) }
pub(package) fn ty_i32() -> i64 { ty_prim(PRIM_I32()) }
pub(package) fn ty_i8() -> i64 { ty_prim(PRIM_I8()) }
pub(package) fn ty_i16() -> i64 { ty_prim(PRIM_I16()) }
pub(package) fn ty_u8() -> i64 { ty_prim(PRIM_U8()) }
pub(package) fn ty_u16() -> i64 { ty_prim(PRIM_U16()) }
pub(package) fn ty_u32() -> i64 { ty_prim(PRIM_U32()) }
pub(package) fn ty_u64() -> i64 { ty_prim(PRIM_U64()) }
pub(package) fn ty_isize() -> i64 { ty_prim(PRIM_ISIZE()) }
pub(package) fn ty_usize() -> i64 { ty_prim(PRIM_USIZE()) }
pub(package) fn ty_f32() -> i64 { ty_prim(PRIM_F32()) }
pub(package) fn ty_union(a: i64, b: i64) -> i64 { ty_new(3, a, b, 0, 0) }
pub(package) fn ty_inter(a: i64, b: i64) -> i64 { ty_new(4, a, b, 0, 0) }
pub(package) fn ty_compl(inner: i64) -> i64 { ty_new(5, inner, 0, 0, 0) }

-- Structural record atoms (4f). Fields are an unordered finite map keyed by
-- stable source-name hash. f2 is the open bit; f3 preserves tuple spelling for
-- diagnostics only (tuple keys are reserved negative integers and therefore
-- cannot collide with source identifiers). RecordField is an internal child
-- descriptor, never a standalone value-set atom.
pub(package) fn ty_record_field(name_hash: i64, field_ty: i64, name_start: i64, name_len: i64) -> i64 {
  ty_new(24, name_hash, field_ty, name_start, name_len)
}
pub(package) fn ty_record_field_hash(field: i64) -> i64 { ty_f1(field) }
pub(package) fn ty_record_field_type(field: i64) -> i64 { ty_f2(field) }
pub(package) fn ty_record_field_name_start(field: i64) -> i64 { ty_f3(field) }
pub(package) fn ty_record_field_name_len(field: i64) -> i64 { ty_f4(field) }
pub(package) fn ty_record(fields: i64, open: i64) -> i64 { ty_new(7, fields, open, 0, 0) }
pub(package) fn ty_record_with_kind(fields: i64, open: i64, tuple_kind: i64) -> i64 { ty_new(7, fields, open, tuple_kind, 0) }
pub(package) fn ty_is_record(ty: i64) -> bool { if ty == 0 { false } else { ty_tag(ty) == 7 } }
pub(package) fn ty_record_fields(ty: i64) -> i64 { if ty_is_record(ty) { ty_f1(ty) } else { 0 } }
pub(package) fn ty_record_open(ty: i64) -> i64 { if ty_is_record(ty) { ty_f2(ty) } else { 0 } }
pub(package) fn ty_record_tuple_kind(ty: i64) -> i64 { if ty_is_record(ty) { ty_f3(ty) } else { 0 } }

pub(package) fn ty_record_field_index(fields: i64, name_hash: i64) -> i64 {
  if fields == 0 { 0 - 1 }
  else {
    let mut result = 0 - 1
    let mut i = 0
    while i < nlist_len(fields) and result < 0 {
      if ty_record_field_hash(nlist_get(fields, i)) == name_hash { result = i }
      else { i = i + 1 }
    }
    result
  }
}

pub(package) fn ty_record_field_by_hash(fields: i64, name_hash: i64) -> i64 {
  let index = ty_record_field_index(fields, name_hash)
  if index < 0 { 0 } else { nlist_get(fields, index) }
}

pub(package) fn ty_record_fields_have_duplicate(fields: i64) -> i64 {
  if fields == 0 { 0 }
  else {
    let mut duplicate = 0
    let mut i = 0
    while i < nlist_len(fields) and duplicate == 0 {
      let wanted = ty_record_field_hash(nlist_get(fields, i))
      let mut j = i + 1
      while j < nlist_len(fields) and duplicate == 0 {
        if ty_record_field_hash(nlist_get(fields, j)) == wanted { duplicate = j + 1 }
        else { j = j + 1 }
      }
      i = i + 1
    }
    duplicate
  }
}

-- Concrete structural layouts are canonical by field identity, never source
-- order. Tuple fields retain positional order; record fields use stable hash
-- order with source order only as the deterministic duplicate-label tie-break.
pub(package) fn ty_record_field_canonical_rank(fields: i64, candidate_index: i64) -> i64 {
  let candidate = nlist_get(fields, candidate_index)
  let candidate_hash = ty_record_field_hash(candidate)
  let mut rank = 0
  for i in 0..nlist_len(fields) {
    let current_hash = ty_record_field_hash(nlist_get(fields, i))
    if current_hash < candidate_hash or (current_hash == candidate_hash and i < candidate_index) { rank = rank + 1 } else { 0 }
  }
  rank
}

pub(package) fn ty_record_field_at_layout_index(ty: i64, layout_index: i64) -> i64 {
  let fields = ty_record_fields(ty)
  if fields == 0 or layout_index < 0 or layout_index >= nlist_len(fields) { 0 }
  else { if ty_record_tuple_kind(ty) == 1 { nlist_get(fields, layout_index) }
  else {
    let mut result = 0
    let mut i = 0
    while i < nlist_len(fields) and result == 0 {
      if ty_record_field_canonical_rank(fields, i) == layout_index { result = nlist_get(fields, i) }
      else { i = i + 1 }
    }
    result
  } }
}

pub(package) fn ty_record_field_layout_index(ty: i64, name_hash: i64) -> i64 {
  let fields = ty_record_fields(ty)
  let mut result = 0 - 1
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and result < 0 {
    let field = ty_record_field_at_layout_index(ty, i)
    if field != 0 and ty_record_field_hash(field) == name_hash { result = i }
    else { i = i + 1 }
  }
  result
}

pub(package) fn ty_record_value_word_count(ty: i64) -> i64 {
  if not ty_is_record(ty) or ty_record_open(ty) == 1 { 0 }
  else {
    let fields = ty_record_fields(ty)
    if fields == 0 or nlist_len(fields) == 0 { 1 }
    else {
      let mut total = 0
      let mut known = 1
      for i in 0..nlist_len(fields) {
        let field = ty_record_field_at_layout_index(ty, i)
        let words = ty_value_storage_word_count(ty_record_field_type(field))
        if words <= 0 or total > 9223372036854775807 - words { known = 0 }
        else { total = total + words }
      }
      if known == 1 { total } else { 0 }
    }
  }
}

pub(package) fn ty_record_field_word_offset(ty: i64, name_hash: i64) -> i64 {
  if not ty_is_record(ty) or ty_record_open(ty) == 1 { 0 - 1 }
  else {
    let fields = ty_record_fields(ty)
    let mut offset = 0
    let mut result = 0 - 1
    let mut i = 0
    while fields != 0 and i < nlist_len(fields) and result < 0 {
      let field = ty_record_field_at_layout_index(ty, i)
      if ty_record_field_hash(field) == name_hash { result = offset }
      else {
        let words = ty_value_storage_word_count(ty_record_field_type(field))
        if words <= 0 { i = nlist_len(fields) } else { offset = offset + words i = i + 1 }
      }
    }
    result
  }
}

pub(package) fn ty_tuple(types: i64) -> i64 {
  let fields = nlist_new()
  if types != 0 {
    for i in 0..nlist_len(types) {
      nlist_add(fields, ty_record_field(0 - i - 1, nlist_get(types, i), 0, 0))
    }
  } else { 0 }
  ty_record_with_kind(fields, 0, 1)
}

-- Guard narrowing (2n): the type with nil removed, or 0 when removing
-- nil would not change the type (the caller then keeps the original
-- binding). Union arms drop their nil parts syntactically so the
-- narrowed type stays clean (T | nil -> T) instead of accreting
-- intersection-with-complement wrappers; a bare nil narrows to never
-- (the guarded branch is unreachable for a provably-nil value).
-- 1 when the type is str or a union with a str arm (2u: such values
-- take the nil-safe content-equality lowering for == / !=).
pub(package) fn ty_mentions_str(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { if ty_f1(ty) == PRIM_STR() { 1 } else { 0 } }
  else { if tag == 3 {
    if ty_mentions_str(ty_f1(ty)) == 1 { 1 } else { ty_mentions_str(ty_f2(ty)) }
  } else { 0 } }
}

pub(package) fn ty_narrow_drop_nil(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 {
    if ty_f1(ty) == PRIM_NIL() { ty_never() } else { 0 }
  } else { if tag == 3 {
    let a = ty_narrow_drop_nil(ty_f1(ty))
    let b = ty_narrow_drop_nil(ty_f2(ty))
    if a == 0 and b == 0 { 0 }
    else {
      let left = if a == 0 { ty_f1(ty) } else { a }
      let right = if b == 0 { ty_f2(ty) } else { b }
      if ty_tag(left) == 0 { right }
      else { if ty_tag(right) == 0 { left } else { ty_union(left, right) } }
    }
  } else { 0 } }
}

-- Function type: (params) -> ret or (params) -[effects]> ret
pub(package) fn ty_fn(params: i64, ret: i64, eff: i64) -> i64 { ty_new(6, params, ret, eff, 0) }

-- Continuation type: one-shot callable resource, distinct from ordinary Fn.
pub(package) fn ty_continuation(input: i64, result: i64) -> i64 { ty_new(14, input, result, 0, 0) }
pub(package) fn ty_is_continuation(ty: i64) -> i64 {
  if ty == 0 { false } else { ty_tag(ty) == 14 }
}

-- Pointer type: *T or *mut T.
pub(package) fn ty_ptr(inner: i64) -> i64 { ty_new(15, inner, 0, 0, 0) }
pub(package) fn ty_mut_ptr(inner: i64) -> i64 { ty_new(15, inner, 1, 0, 0) }
pub(package) fn ty_ptr_with_mut(inner: i64, mutable: i64) -> i64 {
  if mutable == 1 { ty_mut_ptr(inner) } else { ty_ptr(inner) }
}
pub(package) fn ty_is_ptr(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 15 }
}
pub(package) fn ty_ptr_inner(ty: i64) -> i64 {
  if ty_is_ptr(ty) { ty_f1(ty) } else { ty_any() }
}
pub(package) fn ty_ptr_mutable(ty: i64) -> i64 {
  if ty_is_ptr(ty) { ty_f2(ty) } else { 0 }
}

-- Managed-reference type nodes. Weak is public; Arc is transitional/internal.
-- unique is public move-only ordinary data; owned is move-only resources.
pub(package) fn ty_weak(inner: i64) -> i64 { ty_new(16, inner, 0, 0, 0) }
pub(package) fn ty_arc(inner: i64) -> i64 { ty_new(17, inner, 0, 0, 0) }
pub(package) fn ty_unique(inner: i64) -> i64 { ty_new(18, inner, 0, 0, 0) }
pub(package) fn ty_owned(inner: i64) -> i64 { ty_new(19, inner, 0, 0, 0) }
pub(package) fn ty_assoc(base: i64, name_hash: i64) -> i64 { ty_new(21, base, name_hash, 0, 0) }
pub(package) fn ty_is_weak(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 16 }
}
pub(package) fn ty_is_arc(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 17 }
}
pub(package) fn ty_is_unique(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 18 }
}
pub(package) fn ty_is_owned(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 19 }
}
pub(package) fn ty_weak_inner(ty: i64) -> i64 {
  if ty_is_weak(ty) { ty_f1(ty) } else { ty }
}
pub(package) fn ty_arc_inner(ty: i64) -> i64 {
  if ty_is_arc(ty) { ty_f1(ty) } else { ty }
}
pub(package) fn ty_unique_inner(ty: i64) -> i64 {
  if ty_is_unique(ty) { ty_f1(ty) } else { ty }
}
pub(package) fn ty_owned_inner(ty: i64) -> i64 {
  if ty_is_owned(ty) { ty_f1(ty) } else { ty }
}

-- Array/slice semantic atoms (4e). Arrays carry their length in the type.
-- Slices are opaque atoms in DNF: even [never] is inhabited by the empty
-- slice, so the DNF engine must never expand a slice through its element.
pub(package) fn ty_array(inner: i64, length: i64) -> i64 { ty_new(22, inner, length, 0, 0) }
pub(package) fn ty_slice(inner: i64) -> i64 { ty_new(23, inner, 0, 0, 0) }
pub(package) fn ty_mut_slice(inner: i64) -> i64 { ty_new(23, inner, 1, 0, 0) }
pub(package) fn ty_slice_with_mut(inner: i64, mutable: i64) -> i64 {
  if mutable == 1 { ty_mut_slice(inner) } else { ty_slice(inner) }
}
pub(package) fn ty_is_array(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 22 }
}
pub(package) fn ty_is_slice(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 23 }
}
pub(package) fn ty_array_inner(ty: i64) -> i64 {
  if ty_is_array(ty) { ty_f1(ty) } else { ty }
}
pub(package) fn ty_array_length(ty: i64) -> i64 {
  if ty_is_array(ty) { ty_f2(ty) } else { 0 - 1 }
}
pub(package) fn ty_slice_inner(ty: i64) -> i64 {
  if ty_is_slice(ty) { ty_f1(ty) } else { ty }
}
pub(package) fn ty_slice_mutable(ty: i64) -> i64 {
  if ty_is_slice(ty) { ty_f2(ty) } else { 0 }
}

-- Unsupported-surface marker (4a): the parser produces this for syntax the
-- kernel specifies but the compiler does not implement yet, instead of
-- silently erasing it to any. The checker rejects it with a targeted
-- diagnostic; to_dnf's default arm keeps it a safe opaque atom if lenient
-- checking continues past the error. Kinds: 1 = structural record type (4f),
-- 2 = tuple type (4f), 3 = array/slice type (4e), 4 = effect type args (4c).
pub(package) fn ty_unsupported(kind: i64) -> i64 { ty_new(20, kind, 0, 0, 0) }
pub(package) fn ty_is_unsupported(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 20 }
}

-- Named type: Named(name_hash, inner) — nominal type wrapper
pub(package) fn ty_named(hash: i64, inner: i64) -> i64 { ty_new(9, hash, inner, 0, 0) }
pub(package) fn ty_named_app(hash: i64, inner: i64, args: i64) -> i64 { ty_new(9, hash, inner, args, 0) }

-- Number of machine words in the semantic value representation currently
-- supported at typed IR boundaries. Zero means the representation is not yet
-- available. This is the shared width constituent of the richer IR lane-shape
-- fact; type checking also consumes it when validating aggregate layouts.
pub(package) fn ty_value_storage_word_count(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 7 { ty_record_value_word_count(ty) }
    else { if tag == 0 or tag == 10 or tag == 11 or tag == 12 or tag == 13 or tag == 20 or tag == 21 {
      0
    } else { if tag == 18 {
      ty_value_storage_word_count(ty_unique_inner(ty))
    } else { if tag == 19 {
      ty_value_storage_word_count(ty_owned_inner(ty))
    } else { if tag == 23 {
      2
    } else {
      1
    } } } } }
  }
}
pub(package) fn ty_rc_hash() -> i64 { 5863770 }
pub(package) fn ty_rc(inner: i64) -> i64 { ty_named(ty_rc_hash(), inner) }
pub(package) fn ty_is_rc(ty: i64) -> bool {
  if ty_tag(ty) == 9 { ty_f1(ty) == ty_rc_hash() } else { false }
}
pub(package) fn ty_rc_inner(ty: i64) -> i64 {
  if ty_is_rc(ty) { ty_f2(ty) } else { ty }
}

-- Shared aggregate-storage fact used by ownership lowering and by the
-- type-level deep-release-mask capacity check. Values are the compact
-- two-bit header encoding: 0 none, 1 default-managed, 2 closure/
-- continuation, 3 weak. Keep this producer semantic; the backend maps
-- these values to its cleanup-descriptor kinds.
pub(package) fn ty_field_release_mask_kind(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_is_rc(ty) { 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 2 and ty_f1(ty) == PRIM_STR() { 1 }
    else { if tag == 6 or tag == 14 { 2 }
    else { if tag == 16 {
      let inner = ty_weak_inner(ty)
      if ty_field_release_mask_kind(inner) == 1 or ty_tag(inner) == 6 or ty_tag(inner) == 14 or ty_is_arc(inner) { 3 } else { 0 }
    } else { if tag == 9 { 1 }
    else { if tag == 3 {
      let lhs = ty_f1(ty)
      let rhs = ty_f2(ty)
      let lhs_kind = ty_field_release_mask_kind(lhs)
      let rhs_kind = ty_field_release_mask_kind(rhs)
      let lhs_nil = ty_tag(lhs) == 2 and ty_f1(lhs) == PRIM_NIL()
      let rhs_nil = ty_tag(rhs) == 2 and ty_f1(rhs) == PRIM_NIL()
      if lhs_kind != 0 and rhs_nil { lhs_kind }
      else { if rhs_kind != 0 and lhs_nil { rhs_kind }
      else { if lhs_kind != 0 and lhs_kind == rhs_kind { lhs_kind } else { 0 } } }
    } else { 0 } } } } }
  } }
}

-- Managed-kind fact for a logical value at a typed-IR boundary. Fixed arrays
-- cross that boundary as one default-managed backing handle even though an
-- array embedded directly in aggregate storage uses its inline element/drop
-- layout. Unions are representable as an untagged word only when every live
-- constituent has the same release action (with never neutral and nil acting
-- as the zero sentinel). Keep this distinction out of codegen recognizers:
-- ownership lowering and aggregate-layout validation consume the same fact.
pub(package) fn ty_value_release_kind(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 0 { 0 }
    else { if tag == 22 { 1 }
    else { if tag == 3 {
      let lhs = ty_f1(ty)
      let rhs = ty_f2(ty)
      let lhs_kind = ty_value_release_kind(lhs)
      let rhs_kind = ty_value_release_kind(rhs)
      let lhs_never = ty_tag(lhs) == 0
      let rhs_never = ty_tag(rhs) == 0
      let lhs_nil = ty_tag(lhs) == 2 and ty_f1(lhs) == PRIM_NIL()
      let rhs_nil = ty_tag(rhs) == 2 and ty_f1(rhs) == PRIM_NIL()
      if lhs_never { rhs_kind }
      else { if rhs_never { lhs_kind }
      else { if lhs_kind != 0 and rhs_nil { lhs_kind }
      else { if rhs_kind != 0 and lhs_nil { rhs_kind }
      else { if lhs_kind != 0 and lhs_kind == rhs_kind { lhs_kind } else { 0 } } } } }
    } else { ty_field_release_mask_kind(ty) } } }
  }
}

-- Per-lane ownership and ABI facts for flattened structural values. The
-- aggregate itself has no single release action: each managed field lane keeps
-- its own RC/closure/weak action, including through nested closed records.
pub(package) fn ty_value_lane_release_kind(ty: i64, lane: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  if ty == 0 or lane < 0 or words <= 0 or lane >= words { 0 }
  else { if ty_tag(ty) == 7 {
    if ty_record_open(ty) == 1 { 0 }
    else {
      let fields = ty_record_fields(ty)
      if fields == 0 or nlist_len(fields) == 0 { 0 }
      else {
        let mut offset = 0
        let mut result = 0
        let mut i = 0
        while i < nlist_len(fields) and result == 0 {
          let field = ty_record_field_at_layout_index(ty, i)
          let field_ty = ty_record_field_type(field)
          let field_words = ty_value_storage_word_count(field_ty)
          if lane >= offset and lane < offset + field_words {
            result = ty_value_lane_release_kind(field_ty, lane - offset)
            -- A selected unmanaged lane correctly has release kind zero. Stop
            -- the field walk explicitly instead of treating zero as "not yet
            -- found" and revisiting the same field forever.
            i = nlist_len(fields)
          }
          else { offset = offset + field_words i = i + 1 }
        }
        result
      }
    }
  } else { if ty_tag(ty) == 18 or ty_tag(ty) == 19 { 0 }
  else { if lane == 0 { ty_value_release_kind(ty) } else { 0 } } } }
}

pub(package) fn ty_value_has_release_lane(ty: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  let mut found = 0
  let mut lane = 0
  while lane < words and found == 0 {
    if ty_value_lane_release_kind(ty, lane) != 0 { found = 1 }
    else { lane = lane + 1 }
  }
  found
}

-- Lane classes mirror the typed-IR values without importing IR into the type
-- layer: 1 = GPR, 2 = f32, 3 = f64, 0 = unavailable.
pub(package) fn ty_value_lane_class(ty: i64, lane: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  if ty == 0 or lane < 0 or words <= 0 or lane >= words { 0 }
  else { if ty_tag(ty) == 7 {
    if ty_record_open(ty) == 1 { 0 }
    else {
      let fields = ty_record_fields(ty)
      if fields == 0 or nlist_len(fields) == 0 { 1 }
      else {
        let mut offset = 0
        let mut result = 0
        let mut i = 0
        while i < nlist_len(fields) and result == 0 {
          let field_ty = ty_record_field_type(ty_record_field_at_layout_index(ty, i))
          let field_words = ty_value_storage_word_count(field_ty)
          if lane >= offset and lane < offset + field_words { result = ty_value_lane_class(field_ty, lane - offset) }
          else { offset = offset + field_words i = i + 1 }
        }
        result
      }
    }
  } else { if ty_tag(ty) == 18 { ty_value_lane_class(ty_unique_inner(ty), lane) }
  else { if ty_tag(ty) == 19 { ty_value_lane_class(ty_owned_inner(ty), lane) }
  else { if lane != 0 and ty_tag(ty) != 23 { 0 }
  else { if ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F32() { 2 }
  else { if ty_tag(ty) == 2 and ty_f1(ty) == PRIM_F64() { 3 }
  else { 1 } } } } } } }
}

-- Uniform untagged scalar-storage constituent. Narrow integer widths widen to
-- the canonical GPR word when different scalar atoms meet in a set union.
-- Floating values use the FP value class and managed values need a release
-- action, so neither belongs to this class.
pub(package) fn ty_union_word_scalar_eligible(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    if tag == 0 { 1 }
    else { if tag == 3 {
      ty_union_word_scalar_eligible(ty_f1(ty)) == 1 and ty_union_word_scalar_eligible(ty_f2(ty)) == 1
    } else { if tag == 2 {
      let prim = ty_f1(ty)
      if prim == PRIM_STR() or prim == PRIM_F32() or prim == PRIM_F64() { 0 } else { 1 }
    } else { if tag == 15 { 1 } else { 0 } } } }
  }
}

pub(package) fn ty_union_contains_unresolved_storage_atom(ty: i64) -> i64 {
  if ty == 0 { 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 1 or tag == 4 or tag == 5 or tag == 12 or tag == 13 or tag == 20 or tag == 21 { 1 }
    else { if tag == 3 {
      if ty_union_contains_unresolved_storage_atom(ty_f1(ty)) == 1 { 1 }
      else { ty_union_contains_unresolved_storage_atom(ty_f2(ty)) }
    } else { 0 } }
  }
}

-- Uniform storage class for an untagged set union: 1 = canonical GPR word,
-- 2 = one managed word with a common release action, 0 = specialization must
-- decide, -1 = statically incompatible. This is deliberately narrower than
-- general union typing: an explicit variant is the tagged representation for
-- values whose constituents need different runtime storage or cleanup.
pub(package) fn ty_union_storage_class(ty: i64) -> i64 {
  if ty == 0 or ty_tag(ty) != 3 { 0 }
  else { if ty_value_release_kind(ty) != 0 { 2 }
  else { if ty_union_word_scalar_eligible(ty) == 1 { 1 }
  else { if ty_union_contains_unresolved_storage_atom(ty) == 1 { 0 } else { 0 - 1 } } } }
}

-- Generic declarations are checked before concrete substitutions exist.
-- A field whose type can later acquire a release kind must therefore be
-- treated conservatively at an unencodable word; otherwise a generic
-- instance can silently regress to shallow release.
pub(package) fn ty_field_may_require_release_mask(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_field_release_mask_kind(ty) != 0 { 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 1 or tag == 5 or tag == 12 or tag == 13 or tag == 16 or tag == 17 { 1 }
    else { if tag == 3 or tag == 4 {
      if ty_field_may_require_release_mask(ty_f1(ty)) == 1 or ty_field_may_require_release_mask(ty_f2(ty)) == 1 { 1 } else { 0 }
    } else { 0 } }
  } }
}

-- Trait type: nominal atom for trait bounds in DNF
pub(package) fn ty_trait(hash: i64) -> i64 { ty_new(13, hash, 0, 0, 0) }
pub(package) fn ty_qualified_trait(decl: i64) -> i64 { ty_new(27, decl, 0, 0, 0) }
pub(package) fn ty_surface_qualified_trait(module_ns: i64, module_nl: i64, trait_ns: i64, trait_nl: i64) -> i64 {
  ty_new(28, module_ns, module_nl, trait_ns, trait_nl)
}
pub(package) fn trait_atom_decl(atom: i64) -> i64 { if ty_tag(atom) == 27 { ty_f1(atom) } else { 0 } }
pub(package) fn trait_atom_head(atom: i64) -> i64 {
  if atom == 0 { 0 }
  else { if ty_tag(atom) == 27 { effect_atom_decl_name_hash(ty_f1(atom)) }
  else { if ty_tag(atom) == 13 { ty_f1(atom) } else { 0 } } }
}
pub(package) fn trait_atom_eq(left: i64, right: i64) -> bool {
  let ld = trait_atom_decl(left)
  let rd = trait_atom_decl(right)
  if ld != 0 and rd != 0 { ld == rd } else { trait_atom_head(left) == trait_atom_head(right) }
}

-- Nullable sugar: T? = T | nil
pub(package) fn ty_nullable(t: i64) -> i64 { ty_union(t, ty_nil()) }

-- ══════════════════════════════════════════════════════════════
-- Effect types (Phase 1: concrete closed sets)
-- ══════════════════════════════════════════════════════════════
--
-- Tag 10 = EffectSig(concrete_effects_list, tail_var_id)
--   f1 = nlist of EffectApp nodes (sorted by name hash)
--   f2 = 0 (closed set) or >0 (effect variable ID — Phase 2)
-- Tag 11 = EffectApp(name_hash, type_args_list)
--   f1 = name hash (effect name, e.g., str_hash for "IO")
--   f2 = nlist of type arg nodes (empty for Phase 1)

pub(package) fn ty_effect_sig(effects: i64) -> i64 { ty_new(10, effects, 0, 0, 0) }
pub(package) fn ty_effect_sig_with_tail(effects: i64, tail: i64) -> i64 { ty_new(10, effects, tail, 0, 0) }
pub(package) fn ty_effect_pure() -> i64 { ty_effect_sig(nlist_new()) }
pub(package) fn ty_effect_app(name_hash: i64) -> i64 { ty_new(11, name_hash, 0, 0, 0) }
-- Canonical prelude effect identities. Keep the name hashes centralized so
-- sugar/checking/lowering share one contract without depending on the parser.
pub(package) fn effect_fail_head_hash() -> i64 { 6384065697 }
pub(package) fn effect_fail_op_hash() -> i64 { 6385215681 }
pub(package) fn effect_maybe_head_hash() -> i64 { 210682486643 }
pub(package) fn effect_maybe_op_hash() -> i64 { 6385518581 }
-- 4c: parameterized effect atom — State<SymTab> is ty_new(11, hash(State),
-- args_nlist). Distinct instantiations are distinct set members (kernel
-- §7.1, law L2). f2 == 0 means the bare, unparameterized form.
pub(package) fn ty_effect_app_args(name_hash: i64, args: i64) -> i64 { ty_new(11, name_hash, args, 0, 0) }
pub(package) fn ty_qualified_effect_app(decl: i64, args: i64) -> i64 { ty_new(25, decl, args, 0, 0) }
pub(package) fn ty_surface_qualified_effect(module_ns: i64, module_nl: i64, effect_ns: i64, effect_nl: i64, args: i64) -> i64 {
  ty_new(26, module_ns, module_nl, effect_ns, node_new(0, effect_nl, args, 0, 0))
}
pub(package) fn effect_atom_args(atom: i64) -> i64 { ty_f2(atom) }
pub(package) fn effect_atom_decl_name_hash(decl: i64) -> i64 {
  -- Decl facts are the representation carried by tag 25. Keep this tiny
  -- projection local: types.weft is below module.weft and parse.weft, so it
  -- must not acquire a backward dependency on their accessor/hash helpers.
  let ptr = mem_load64_at(decl + 24, 0)
  let len = mem_load64_at(decl + 32, 0)
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = h * 33 + mem_load8_at(ptr, i)
    i = i + 1
  }
  if h < 0 { 0 - h } else { h }
}
pub(package) fn effect_atom_head(atom: i64) -> i64 {
  if atom == 0 { 0 }
  else { if ty_tag(atom) == 25 {
    let decl = ty_f1(atom)
    if decl == 0 { 0 } else { effect_atom_decl_name_hash(decl) }
  } else { ty_f1(atom) } }
}

-- Find the first atom with the given head hash in a list/sig (or 0).
-- Callers that accept an unqualified surface reference must pair this with
-- `effect_list_head_is_ambiguous`; qualified references compare full atoms.
pub(package) fn effect_list_find_atom_by_head(list: i64, hash: i64) -> i64 {
  if list == 0 { 0 }
  else {
    let n = nlist_len(list)
    let mut i = 0
    let mut found = 0
    while i < n {
      let atom = nlist_get(list, i)
      if effect_atom_head(atom) == hash { found = atom i = n } else { i = i + 1 }
    }
    found
  }
}

pub(package) fn effect_sig_find_atom_by_head(sig: i64, hash: i64) -> i64 {
  if sig == 0 { 0 }
  else { if ty_tag(sig) != 10 { 0 }
  else { effect_list_find_atom_by_head(ty_f1(sig), hash) } }
}

-- True when a head names more than one DISTINCT atom. Identical repeats are
-- harmless set notation and do not make an unqualified reference ambiguous.
pub(package) fn effect_list_head_is_ambiguous(list: i64, hash: i64) -> i64 {
  if list == 0 { 0 }
  else {
    let first = effect_list_find_atom_by_head(list, hash)
    if first == 0 { 0 }
    else {
      let mut ambiguous = 0
      let mut i = 0
      while i < nlist_len(list) {
        let atom = nlist_get(list, i)
        if effect_atom_head(atom) == hash and not effect_atom_eq(atom, first) {
          ambiguous = 1
          i = nlist_len(list)
        } else { i = i + 1 }
      }
      ambiguous
    }
  }
}

pub(package) fn effect_sig_head_is_ambiguous(sig: i64, hash: i64) -> i64 {
  if sig == 0 or ty_tag(sig) != 10 { 0 }
  else { effect_list_head_is_ambiguous(ty_f1(sig), hash) }
}

-- 4c: effect atom identity is (head hash, type args).
pub(package) fn effect_atom_eq(a: i64, b: i64) -> bool {
  let same_identity = if ty_tag(a) == 25 and ty_tag(b) == 25 { ty_f1(a) == ty_f1(b) }
    else {
      -- An unresolved short atom still crosses this boundary while selected
      -- imports remain hash-backed. Preserve that compatibility behind the
      -- duplicate-head fence; two resolved atoms always compare by DeclId.
      effect_atom_head(a) == effect_atom_head(b)
    }
  if not same_identity { false }
  else {
    let aa = ty_f2(a)
    let ba = ty_f2(b)
    if aa == 0 and ba == 0 { true }
    else { if aa == 0 or ba == 0 { false }
    else { type_list_eq(aa, ba) } }
  }
}

-- Check if effect set A is a subset of effect set B (both EffectSig tag 10)
-- A <: B means every effect in A is also in B (fewer effects = more restricted = subtype)
-- 4a S9: rigid-position effect subset. Used where the expected set is a
-- caller's DECLARED signature: its tail variable is universally quantified
-- (the caller's caller chooses it), so a concrete effect performed or
-- charged inside the body can never be absorbed by the tail — only
-- variable-tailed flows (calling a value typed -[E]>) ride it. The
-- solving-position check below keeps its open-tail permissiveness for
-- argument passing until 4c lands real unification; tail-id matching
-- (rejecting F-charged-to-E) is also 4c-scoped.
pub(package) fn effect_is_subset_rigid(a: i64, b: i64) -> bool {
  if ty_tag(a) != 10 { true }
  else { if ty_tag(b) != 10 { true }
  else {
    let a_list = ty_f1(a)
    let b_list = ty_f1(b)
    let a_tail = ty_f2(a)
    let b_tail = ty_f2(b)
    let na = nlist_len(a_list)
    let nb = nlist_len(b_list)
    let mut ok = true
    let mut i = 0
    while i < na {
      let a_atom = nlist_get(a_list, i)
      let mut found = false
      let mut j = 0
      while j < nb {
        if effect_atom_eq(nlist_get(b_list, j), a_atom) { found = true j = nb }
        else { j = j + 1 }
      }
      if not found { ok = false i = na }
      else { i = i + 1 }
    }
    if a_tail > 0 and b_tail == 0 { false } else { ok }
  } }
}

pub(package) fn effect_is_subset(a: i64, b: i64) -> bool {
  if ty_tag(a) != 10 { true }
  else { if ty_tag(b) != 10 { true }
  else {
    let a_list = ty_f1(a)
    let b_list = ty_f1(b)
    let a_tail = ty_f2(a)
    let b_tail = ty_f2(b)
    let na = nlist_len(a_list)
    let nb = nlist_len(b_list)
    -- If right side has a tail variable, it accepts any additional effects
    -- (the tail represents an unknown open set). Left's concrete effects
    -- must still be in right's concrete set OR absorbed by the tail.
    if b_tail > 0 {
      -- Right is open: left's concrete effects are accepted (tail absorbs extras)
      -- Still check that left's concrete ⊆ right's concrete for the known part
      -- Actually, with an open tail, any concrete effect on the left is fine —
      -- the tail variable can unify to include it. So always true.
      true
    } else {
      -- Right is closed: every effect in a_list must appear in b_list
      let mut ok = true
      let mut i = 0
      while i < na {
        let a_atom = nlist_get(a_list, i)
        let mut found = false
        let mut j = 0
        while j < nb {
          if effect_atom_eq(nlist_get(b_list, j), a_atom) { found = true j = nb }
          else { j = j + 1 }
        }
        if not found { ok = false i = na }
        else { i = i + 1 }
      }
      -- If left has a tail (open), it can't be subset of a closed set
      -- (the tail could contain anything)
      if a_tail > 0 { false } else { ok }
    }
  } }
}

-- ══════════════════════════════════════════════════════════════
-- Type variables (for generics)
-- ══════════════════════════════════════════════════════════════
--
-- Tag 12 = TypeVar(var_id)
--   var_id: sequential integer (0, 1, 2...) within a generic function
--   TypeVars are opaque atoms in DNF — to_dnf treats them via the _ -> dnf_atom fallthrough.

pub(package) fn ty_var(id: i64) -> i64 { ty_new(12, id, 0, 0, 0) }
pub(package) fn ty_var_id(t: i64) -> i64 { ty_f1(t) }

-- `Self` is a rigid, contextual type placeholder rather than an ordinary
-- method type parameter.  Ordinary generic ids are allocated from zero;
-- keeping Self at -1 lets the existing recursive substitution machinery
-- instantiate every nested occurrence without making it solver-owned.
pub(package) fn ty_self() -> i64 { ty_var(0 - 1) }
pub(package) fn ty_is_self(t: i64) -> bool {
  if t == 0 { false }
  else { if ty_tag(t) == 12 { ty_var_id(t) == 0 - 1 } else { false } }
}

-- ══════════════════════════════════════════════════════════════
-- Type substitution (for generic instantiation)
-- ══════════════════════════════════════════════════════════════
--
-- A substitution maps TypeVar ids to concrete types.
-- Stored as an nlist of [var_id, type] pairs (node_new(0, var_id, ty, 0, 0)).

pub(package) fn subst_new() -> i64 { nlist_new() }
pub(package) fn subst_add(s: i64, var_id: i64, ty: i64) -> i64 {
  nlist_add(s, node_new(0, var_id, ty, 0, 0))
  s
}
pub(package) fn subst_lookup(s: i64, var_id: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(s) {
    let e = nlist_get(s, i)
    if node_f1(e) == var_id {
      result = node_f2(e)
      i = nlist_len(s)
    } else { i = i + 1 }
  }
  result
}

-- Effect tails share the generic substitution map with ordinary type
-- variables. A binding for E is an EffectSig, so substituting
-- -[State<S>, E]> merges the substituted State atom with E's concrete
-- effects and carries E's residual tail. This is the Phase-2/mono erasure
-- rule from effect-types.md; leaving the integer tail untouched made every
-- inferred effect-polymorphic call remain open after specialisation.
pub(package) fn effect_atom_list_add_unique(dst: i64, src: i64) -> i64 {
  if src == 0 { dst }
  else {
    for i in 0..nlist_len(src) {
      let atom = nlist_get(src, i)
      let mut found = false
      for j in 0..nlist_len(dst) {
        if effect_atom_eq(nlist_get(dst, j), atom) { found = true } else { 0 }
      }
      if not found { nlist_add(dst, atom) } else { 0 }
    }
    dst
  }
}

pub(package) fn effect_sig_subst(sig: i64, s: i64) -> i64 {
  let concrete = type_list_subst(ty_f1(sig), s)
  let tail = ty_f2(sig)
  if tail == 0 { ty_effect_sig(concrete) }
  else {
    let binding = subst_lookup(s, tail - 1)
    if binding == 0 or ty_tag(binding) != 10 {
      ty_effect_sig_with_tail(concrete, tail)
    } else {
      let merged = nlist_new()
      effect_atom_list_add_unique(merged, concrete)
      effect_atom_list_add_unique(merged, type_list_subst(ty_f1(binding), s))
      ty_effect_sig_with_tail(merged, ty_f2(binding))
    }
  }
}

pub(package) fn ty_record_fields_subst(fields: i64, s: i64) -> i64 {
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(result, ty_record_field(
        ty_record_field_hash(field),
        ty_subst(ty_record_field_type(field), s),
        ty_record_field_name_start(field),
        ty_record_field_name_len(field)
      ))
    }
  } else { 0 }
  result
}

-- Recursively substitute type variables in a type expression
pub(package) fn ty_subst(ty: i64, s: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      0 -> ty
      1 -> ty
      2 -> ty
      3 -> ty_union(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      4 -> ty_inter(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      5 -> ty_compl(ty_subst(ty_f1(ty), s))
      6 -> ty_fn(type_list_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s), ty_subst(ty_f3(ty), s))
      7 -> ty_record_with_kind(ty_record_fields_subst(ty_record_fields(ty), s), ty_record_open(ty), ty_record_tuple_kind(ty))
      9 -> ty_named_app(ty_f1(ty), ty_subst(ty_f2(ty), s), type_list_subst(ty_f3(ty), s))
      -- 4c: effect atoms substitute their type args and effect signatures
      -- resolve their optional tail from the same generic substitution.
      10 -> effect_sig_subst(ty, s)
      11 -> {
        if ty_f2(ty) == 0 { ty }
        else { ty_effect_app_args(ty_f1(ty), type_list_subst(ty_f2(ty), s)) }
      }
      25 -> ty_qualified_effect_app(ty_f1(ty), if ty_f2(ty) == 0 { 0 } else { type_list_subst(ty_f2(ty), s) })
      14 -> ty_continuation(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      15 -> ty_ptr_with_mut(ty_subst(ty_f1(ty), s), ty_f2(ty))
      16 -> ty_weak(ty_subst(ty_f1(ty), s))
      17 -> ty_arc(ty_subst(ty_f1(ty), s))
      18 -> ty_unique(ty_subst(ty_f1(ty), s))
      19 -> ty_owned(ty_subst(ty_f1(ty), s))
      21 -> ty_assoc(ty_subst(ty_f1(ty), s), ty_f2(ty))
      22 -> ty_array(ty_subst(ty_f1(ty), s), ty_f2(ty))
      23 -> ty_slice_with_mut(ty_subst(ty_f1(ty), s), ty_f2(ty))
      12 -> {
        let concrete = subst_lookup(s, ty_f1(ty))
        if concrete != 0 { concrete } else { ty }
      }
      _ -> ty
    }
  }
}

pub(package) fn type_list_subst(types: i64, s: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    let n = nlist_len(types)
    for i in 0..n {
      nlist_add(result, ty_subst(nlist_get(types, i), s))
    }
    result
  }
}

-- Match a generic impl target against a concrete receiver, accumulating the
-- impl-variable bindings used by signature checking and monomorphisation.
-- Repeated variables are equality constraints, not fresh wildcards.
pub(package) fn ty_pattern_match_list(patterns: i64, concrete: i64, s: i64) -> bool {
  let np = if patterns == 0 { 0 } else { nlist_len(patterns) }
  let nc = if concrete == 0 { 0 } else { nlist_len(concrete) }
  if np != nc { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < np {
      if ty_pattern_match(nlist_get(patterns, i), nlist_get(concrete, i), s) {
        i = i + 1
      } else { ok = false i = np }
    }
    ok
  }
}

pub(package) fn ty_record_pattern_match_fields(pattern_fields: i64, concrete_fields: i64, s: i64) -> bool {
  let np = if pattern_fields == 0 { 0 } else { nlist_len(pattern_fields) }
  let nc = if concrete_fields == 0 { 0 } else { nlist_len(concrete_fields) }
  if np != nc { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < np and ok {
      let pattern_field = nlist_get(pattern_fields, i)
      let concrete_field = ty_record_field_by_hash(concrete_fields, ty_record_field_hash(pattern_field))
      if concrete_field == 0 { ok = false }
      else {
        if ty_pattern_match(ty_record_field_type(pattern_field), ty_record_field_type(concrete_field), s) { i = i + 1 }
        else { ok = false }
      }
    }
    ok
  }
}

pub(package) fn ty_pattern_match(pattern: i64, concrete: i64, s: i64) -> bool {
  if pattern == 0 or concrete == 0 { pattern == concrete }
  else { if ty_tag(pattern) == 12 and not ty_is_self(pattern) {
    let var_id = ty_var_id(pattern)
    let bound = subst_lookup(s, var_id)
    if bound == 0 {
      subst_add(s, var_id, concrete)
      true
    } else { ty_eq(bound, concrete) }
  } else {
    let pt = ty_tag(pattern)
    let ct = ty_tag(concrete)
    if pt != ct { false }
    else {
      match pt {
        0 -> true
        1 -> true
        2 -> ty_f1(pattern) == ty_f1(concrete)
        3 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        4 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        5 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        6 -> ty_pattern_match_list(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        7 -> ty_record_open(pattern) == ty_record_open(concrete) and ty_record_tuple_kind(pattern) == ty_record_tuple_kind(concrete) and ty_record_pattern_match_fields(ty_record_fields(pattern), ty_record_fields(concrete), s)
        9 -> ty_f1(pattern) == ty_f1(concrete) and ty_pattern_match_list(ty_f3(pattern), ty_f3(concrete), s)
        14 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        15 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        16 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        17 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        18 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        19 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        21 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        22 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        23 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        _ -> ty_eq(pattern, concrete)
      }
    }
  } }
}

pub(package) fn ty_pattern_bound_args(tparams: i64, s: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let args = nlist_new()
    let mut valid = true
    for i in 0..nlist_len(tparams) {
      let arg = subst_lookup(s, node_f3(nlist_get(tparams, i)))
      if arg == 0 { valid = false } else { nlist_add(args, arg) }
    }
    if valid { args } else { 0 }
  }
}

pub(package) fn ty_rebase_pattern_vars_list(types: i64, delta: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) { nlist_add(result, ty_rebase_pattern_vars(nlist_get(types, i), delta)) }
    result
  }
}

pub(package) fn ty_rebase_pattern_vars_record_fields(fields: i64, delta: i64) -> i64 {
  let result = nlist_new()
  if fields != 0 {
    for i in 0..nlist_len(fields) {
      let field = nlist_get(fields, i)
      nlist_add(result, ty_record_field(
        ty_record_field_hash(field),
        ty_rebase_pattern_vars(ty_record_field_type(field), delta),
        ty_record_field_name_start(field),
        ty_record_field_name_len(field)
      ))
    }
  } else { 0 }
  result
}

pub(package) fn ty_rebase_pattern_vars(ty: i64, delta: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> ty_union(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      4 -> ty_inter(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      5 -> ty_compl(ty_rebase_pattern_vars(ty_f1(ty), delta))
      6 -> ty_fn(ty_rebase_pattern_vars_list(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta), ty_rebase_pattern_vars(ty_f3(ty), delta))
      7 -> ty_record_with_kind(ty_rebase_pattern_vars_record_fields(ty_record_fields(ty), delta), ty_record_open(ty), ty_record_tuple_kind(ty))
      9 -> ty_named_app(ty_f1(ty), ty_rebase_pattern_vars(ty_f2(ty), delta), ty_rebase_pattern_vars_list(ty_f3(ty), delta))
      12 -> if ty_is_self(ty) { ty } else { ty_var(ty_var_id(ty) + delta) }
      14 -> ty_continuation(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      15 -> ty_ptr_with_mut(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      16 -> ty_weak(ty_rebase_pattern_vars(ty_f1(ty), delta))
      17 -> ty_arc(ty_rebase_pattern_vars(ty_f1(ty), delta))
      18 -> ty_unique(ty_rebase_pattern_vars(ty_f1(ty), delta))
      19 -> ty_owned(ty_rebase_pattern_vars(ty_f1(ty), delta))
      21 -> ty_assoc(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      22 -> ty_array(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      23 -> ty_slice_with_mut(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      _ -> ty
    }
  }
}

pub(package) fn ty_pattern_unify_list(left: i64, right: i64, s: i64) -> bool {
  let nl = if left == 0 { 0 } else { nlist_len(left) }
  let nr = if right == 0 { 0 } else { nlist_len(right) }
  if nl != nr { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < nl {
      if ty_pattern_unify(nlist_get(left, i), nlist_get(right, i), s) { i = i + 1 }
      else { ok = false i = nl }
    }
    ok
  }
}

pub(package) fn ty_record_pattern_unify_fields(left_fields: i64, right_fields: i64, s: i64) -> bool {
  let nl = if left_fields == 0 { 0 } else { nlist_len(left_fields) }
  let nr = if right_fields == 0 { 0 } else { nlist_len(right_fields) }
  if nl != nr { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < nl and ok {
      let left_field = nlist_get(left_fields, i)
      let right_field = ty_record_field_by_hash(right_fields, ty_record_field_hash(left_field))
      if right_field == 0 { ok = false }
      else {
        if ty_pattern_unify(ty_record_field_type(left_field), ty_record_field_type(right_field), s) { i = i + 1 }
        else { ok = false }
      }
    }
    ok
  }
}

pub(package) fn ty_pattern_unify(left: i64, right: i64, s: i64) -> bool {
  if left == 0 or right == 0 { left == right }
  else { if ty_tag(left) == 12 and not ty_is_self(left) {
    let bound = subst_lookup(s, ty_var_id(left))
    if bound != 0 { ty_pattern_unify(bound, right, s) }
    else { if ty_tag(right) == 12 and not ty_is_self(right) {
      let right_bound = subst_lookup(s, ty_var_id(right))
      if right_bound != 0 { ty_pattern_unify(left, right_bound, s) }
      else { subst_add(s, ty_var_id(left), right) != 0 }
    } else { subst_add(s, ty_var_id(left), right) != 0 } }
  } else { if ty_tag(right) == 12 and not ty_is_self(right) {
    ty_pattern_unify(right, left, s)
  } else { if ty_tag(left) != ty_tag(right) { false }
  else {
    match ty_tag(left) {
      0 -> true
      1 -> true
      2 -> ty_f1(left) == ty_f1(right)
      3 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      4 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      5 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      6 -> ty_pattern_unify_list(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      7 -> ty_record_open(left) == ty_record_open(right) and ty_record_tuple_kind(left) == ty_record_tuple_kind(right) and ty_record_pattern_unify_fields(ty_record_fields(left), ty_record_fields(right), s)
      9 -> ty_f1(left) == ty_f1(right) and ty_pattern_unify_list(ty_f3(left), ty_f3(right), s)
      14 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      15 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      16 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      17 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      18 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      19 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      21 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      22 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      23 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      _ -> ty_eq(left, right)
    }
  } } } }
}

pub(package) fn ty_patterns_overlap(left: i64, right: i64) -> bool {
  ty_pattern_unify(left, ty_rebase_pattern_vars(right, 1048576), subst_new())
}

-- Resolved method-call fact carried from type checking into lowering.
-- f1 = dispatch owner/head hash, f2 = concrete receiver type,
-- f3 = target/specialisation type arguments, f4 = flags:
--   bit 0: generic template, bit 1: associated (type-qualified) call.
pub(package) fn method_ref_flags(generic: i64, associated: i64) -> i64 {
  (if generic != 0 { 1 } else { 0 }) + (if associated != 0 { 2 } else { 0 })
}
pub(package) fn method_ref_new(owner_hash: i64, receiver_ty: i64, type_args: i64, generic: i64) -> i64 {
  node_new(70, owner_hash, receiver_ty, type_args, node_new(0, method_ref_flags(generic, 0), 0, 0, 0))
}
pub(package) fn method_ref_new_associated(owner_hash: i64, receiver_ty: i64, type_args: i64, generic: i64) -> i64 {
  node_new(70, owner_hash, receiver_ty, type_args, node_new(0, method_ref_flags(generic, 1), 0, 0, 0))
}
pub(package) fn method_ref_owner_hash(ref: i64) -> i64 { node_f1(ref) }
pub(package) fn method_ref_receiver_ty(ref: i64) -> i64 { node_f2(ref) }
pub(package) fn method_ref_type_args(ref: i64) -> i64 { node_f3(ref) }
pub(package) fn method_ref_flags_value(ref: i64) -> i64 { node_f1(node_f4(ref)) }
pub(package) fn method_ref_declaration(ref: i64) -> i64 { node_f2(node_f4(ref)) }
pub(package) fn method_ref_is_generic(ref: i64) -> bool { method_ref_flags_value(ref) % 2 == 1 }
pub(package) fn method_ref_is_associated(ref: i64) -> bool { method_ref_flags_value(ref) >= 2 }
pub(package) fn method_ref_with_declaration(ref: i64, declaration: i64) -> i64 {
  mem_store64_at(node_f4(ref), 16, declaration)
  ref
}
pub(package) fn method_ref_mark_associated(ref: i64) -> i64 {
  method_ref_with_declaration(method_ref_new_associated(
    method_ref_owner_hash(ref),
    method_ref_receiver_ty(ref),
    method_ref_type_args(ref),
    if method_ref_is_generic(ref) { 1 } else { 0 }
  ), method_ref_declaration(ref))
}
pub(package) fn method_ref_subst(ref: i64, s: i64) -> i64 {
  if s == 0 { ref }
  else {
    node_new(
      70,
      method_ref_owner_hash(ref),
      ty_subst(method_ref_receiver_ty(ref), s),
      type_list_subst(method_ref_type_args(ref), s),
      node_new(0, method_ref_flags_value(ref), method_ref_declaration(ref), 0, 0)
    )
  }
}

-- ══════════════════════════════════════════════════════════════
-- DNF representation
-- ══════════════════════════════════════════════════════════════
--
-- A DNF clause is a conjunction: (∩ positives) ∩ (∩ ¬negatives)
-- Stored as two lists of type atoms.
--
-- A DNF type is a disjunction of clauses (list of clauses).
-- Stored as a list of clause pointers.
--
-- Clause: 24 bytes [positives_list, negatives_list, 0]
-- Each list is an nlist of type pointers.

pub(package) fn dnf_clause_new(pos: i64, neg: i64) -> i64 {
  types_storage_dnf_clause_new(pos, neg)
}
pub(package) fn dnf_clause_pos(c: i64) -> i64 { types_storage_dnf_clause_pos(c) }
pub(package) fn dnf_clause_neg(c: i64) -> i64 { types_storage_dnf_clause_neg(c) }

-- DNF is a list of clauses
pub(package) fn dnf_new() -> i64 { nlist_new() }
pub(package) fn dnf_add_clause(dnf: i64, clause: i64) -> i64 { nlist_add(dnf, clause) }
pub(package) fn dnf_len(dnf: i64) -> i64 { nlist_len(dnf) }
pub(package) fn dnf_get(dnf: i64, i: i64) -> i64 { nlist_get(dnf, i) }

-- Single-atom DNF: one clause with one positive atom
pub(package) fn dnf_atom(ty: i64) -> i64 {
  let pos = nlist_new()
  nlist_add(pos, ty)
  let clause = dnf_clause_new(pos, nlist_new())
  let d = dnf_new()
  dnf_add_clause(d, clause)
  d
}

-- Empty DNF (no clauses = empty type)
pub(package) fn dnf_empty() -> i64 { dnf_new() }

-- Universal DNF (one clause with no atoms = any type)
pub(package) fn dnf_any() -> i64 {
  let clause = dnf_clause_new(nlist_new(), nlist_new())
  let d = dnf_new()
  dnf_add_clause(d, clause)
  d
}

-- ══════════════════════════════════════════════════════════════
-- DNF normalization: Type → DNF
-- ══════════════════════════════════════════════════════════════

pub(package) fn to_dnf(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  match tag {
    0 -> dnf_empty()
    1 -> dnf_any()
    2 -> dnf_atom(ty)
    3 -> dnf_union(to_dnf(ty_f1(ty)), to_dnf(ty_f2(ty)))
    4 -> dnf_intersect(to_dnf(ty_f1(ty)), to_dnf(ty_f2(ty)))
    5 -> dnf_complement(to_dnf(ty_f1(ty)))
    _ -> dnf_atom(ty)
  }
}

-- Union of two DNFs: concatenate clause lists
pub(package) fn dnf_union(a: i64, b: i64) -> i64 {
  let result = dnf_new()
  let mut i = 0
  while i < dnf_len(a) {
    dnf_add_clause(result, dnf_get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < dnf_len(b) {
    dnf_add_clause(result, dnf_get(b, j))
    j = j + 1
  }
  result
}

-- Intersection of two DNFs: cartesian product of clauses
pub(package) fn dnf_intersect(a: i64, b: i64) -> i64 {
  let result = dnf_new()
  let mut i = 0
  while i < dnf_len(a) {
    let ca = dnf_get(a, i)
    let mut j = 0
    while j < dnf_len(b) {
      let cb = dnf_get(b, j)
      -- Merge clauses: combine positive and negative lists
      let merged = clause_merge(ca, cb)
      dnf_add_clause(result, merged)
      j = j + 1
    }
    i = i + 1
  }
  result
}

-- Merge two clauses: union their positive and negative atom lists
pub(package) fn clause_merge(ca: i64, cb: i64) -> i64 {
  let pos = list_concat(dnf_clause_pos(ca), dnf_clause_pos(cb))
  let neg = list_concat(dnf_clause_neg(ca), dnf_clause_neg(cb))
  dnf_clause_new(pos, neg)
}

-- Complement of a DNF: De Morgan's law
-- ¬(C1 ∨ C2 ∨ ...) = ¬C1 ∧ ¬C2 ∧ ...
-- For bootstrap: treat complement conservatively as a single negative atom
pub(package) fn dnf_complement(inner: i64) -> i64 {
  -- If inner is a single atom clause, negate it directly
  if dnf_len(inner) == 1 {
    let clause = dnf_get(inner, 0)
    let pos = dnf_clause_pos(clause)
    let neg = dnf_clause_neg(clause)
    if nlist_len(pos) == 1 {
      if nlist_len(neg) == 0 {
        -- Simple case: ¬atom → one clause with atom in negative position
        let new_neg = nlist_new()
        nlist_add(new_neg, nlist_get(pos, 0))
        let c = dnf_clause_new(nlist_new(), new_neg)
        let d = dnf_new()
        dnf_add_clause(d, c)
        d
      } else { dnf_complement_general(inner) }
    } else { dnf_complement_general(inner) }
  } else { dnf_complement_general(inner) }
}

-- General complement: ¬(C1 ∨ C2 ∨ ...) = ¬C1 ∧ ¬C2 ∧ ...
-- Each ¬Ci = ¬(P1 ∧ P2 ∧ ... ∧ ¬N1 ∧ ¬N2 ∧ ...) = ¬P1 ∨ ¬P2 ∨ ... ∨ N1 ∨ N2 ∨ ...
-- Then intersect all the negated clauses
pub(package) fn dnf_complement_general(inner: i64) -> i64 {
  if dnf_len(inner) == 0 { dnf_any() }
  else {
    let mut result = negate_clause(dnf_get(inner, 0))
    let mut i = 1
    while i < dnf_len(inner) {
      result = dnf_intersect(result, negate_clause(dnf_get(inner, i)))
      i = i + 1
    }
    result
  }
}

-- Negate a single clause: ¬(P1 ∧ P2 ∧ ... ∧ ¬N1 ∧ ¬N2 ∧ ...) = ¬P1 ∨ ¬P2 ∨ ... ∨ N1 ∨ N2 ∨ ...
pub(package) fn negate_clause(clause: i64) -> i64 {
  let pos = dnf_clause_pos(clause)
  let neg = dnf_clause_neg(clause)
  let result = dnf_new()
  -- Each positive atom becomes a clause with that atom in negative position
  let mut i = 0
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let n = nlist_new()
    nlist_add(n, atom)
    dnf_add_clause(result, dnf_clause_new(nlist_new(), n))
    i = i + 1
  }
  -- Each negative atom becomes a clause with that atom in positive position
  let mut j = 0
  while j < nlist_len(neg) {
    let atom = nlist_get(neg, j)
    let p = nlist_new()
    nlist_add(p, atom)
    dnf_add_clause(result, dnf_clause_new(p, nlist_new()))
    j = j + 1
  }
  result
}

-- ══════════════════════════════════════════════════════════════
-- Emptiness check
-- ══════════════════════════════════════════════════════════════

-- A type is empty iff all its DNF clauses are unsatisfiable
pub(package) fn ty_is_empty(ty: i64) -[Conformance]> bool {
  let tag = ty_tag(ty)
  if tag == 0 { true }
  else {
    let dnf = to_dnf(ty)
    dnf_is_empty(dnf)
  }
}

pub(package) fn dnf_is_empty(dnf: i64) -[Conformance]> bool {
  if dnf_len(dnf) == 0 { true }
  else {
    let mut i = 0
    let mut all_unsat = true
    while i < dnf_len(dnf) {
      if not clause_is_unsatisfiable(dnf_get(dnf, i)) {
        all_unsat = false
        i = dnf_len(dnf)
      } else { i = i + 1 }
    }
    all_unsat
  }
}

-- A clause (P ∩ ¬N) is unsatisfiable if:
-- 1. Never is in the positive set
-- 2. Two different primitives are in the positive set (disjoint atoms)
-- 3. A concrete type and trait atom are both positive but no conformance exists
-- 4. A concrete type is positive and a trait atom is negative but conformance exists
-- 5. The same atom appears in both positive and negative sets
pub(package) fn clause_is_unsatisfiable(clause: i64) -[Conformance]> bool {
  let pos = dnf_clause_pos(clause)
  let neg = dnf_clause_neg(clause)

  if has_never_in_pos(pos) { true }
  else { if has_disjoint_prims(pos) { true }
  else { if has_empty_record_in_pos(pos) { true }
  else { if has_disjoint_record_pos(pos) { true }
  else { if has_record_nonrecord_disjoint_pos(pos) { true }
  else { if has_empty_array_in_pos(pos) { true }
  else { if has_disjoint_indexed_pos(pos) { true }
  else { if has_prim_subset_of_neg(pos, neg) { true }
  else { if has_record_subset_of_neg(pos, neg) { true }
  else { if has_indexed_subset_of_neg(pos, neg) { true }
  else { if has_unsat_trait_pos(pos) { true }
  else { if has_unsat_trait_neg(pos, neg) { true }
  else { has_overlap(pos, neg) } } } } } } } } } } } }
}

pub(package) fn record_atom_has_empty_field(record: i64) -[Conformance]> bool {
  let fields = ty_record_fields(record)
  let mut empty = false
  let mut i = 0
  while fields != 0 and i < nlist_len(fields) and not empty {
    if ty_is_empty(ty_record_field_type(nlist_get(fields, i))) { empty = true }
    else { i = i + 1 }
  }
  empty
}

pub(package) fn has_empty_record_in_pos(pos: i64) -[Conformance]> bool {
  let mut empty = false
  let mut i = 0
  while i < nlist_len(pos) and not empty {
    let atom = nlist_get(pos, i)
    if ty_is_record(atom) and record_atom_has_empty_field(atom) { empty = true }
    else { i = i + 1 }
  }
  empty
}

pub(package) fn record_fields_domain_equal(left_fields: i64, right_fields: i64) -> bool {
  let nl = if left_fields == 0 { 0 } else { nlist_len(left_fields) }
  let nr = if right_fields == 0 { 0 } else { nlist_len(right_fields) }
  if nl != nr { false }
  else {
    let mut equal = true
    let mut i = 0
    while i < nl and equal {
      if ty_record_field_by_hash(right_fields, ty_record_field_hash(nlist_get(left_fields, i))) == 0 { equal = false }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn record_positive_atoms_are_disjoint(left: i64, right: i64) -[Conformance]> bool {
  if not ty_is_record(left) or not ty_is_record(right) { false }
  else { if ty_record_tuple_kind(left) != ty_record_tuple_kind(right) { true }
  else {
    let left_fields = ty_record_fields(left)
    let right_fields = ty_record_fields(right)
    let left_open = ty_record_open(left)
    let right_open = ty_record_open(right)
    if left_open == 0 and right_open == 0 and not record_fields_domain_equal(left_fields, right_fields) { true }
    else {
      let mut disjoint = false
      let mut i = 0
      while right_fields != 0 and i < nlist_len(right_fields) and not disjoint {
        let right_field = nlist_get(right_fields, i)
        let left_field = ty_record_field_by_hash(left_fields, ty_record_field_hash(right_field))
        if left_field == 0 {
          if left_open == 0 { disjoint = true } else { i = i + 1 }
        } else {
          if ty_is_empty(ty_inter(ty_record_field_type(left_field), ty_record_field_type(right_field))) { disjoint = true }
          else { i = i + 1 }
        }
      }
      let mut j = 0
      while left_fields != 0 and j < nlist_len(left_fields) and not disjoint {
        let left_field = nlist_get(left_fields, j)
        if ty_record_field_by_hash(right_fields, ty_record_field_hash(left_field)) == 0 and right_open == 0 { disjoint = true }
        else { j = j + 1 }
      }
      disjoint
    }
  } }
}

pub(package) fn has_disjoint_record_pos(pos: i64) -[Conformance]> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(pos) and not found {
    let left = nlist_get(pos, i)
    let mut j = i + 1
    while j < nlist_len(pos) and not found {
      if record_positive_atoms_are_disjoint(left, nlist_get(pos, j)) { found = true }
      else { j = j + 1 }
    }
    i = i + 1
  }
  found
}

pub(package) fn record_definitely_disjoint_tag(tag: i64) -> bool {
  tag == 2 or tag == 6 or tag == 8 or tag == 10 or tag == 11 or tag == 14 or
    tag == 15 or tag == 16 or tag == 17 or tag == 18 or tag == 19 or
    tag == 22 or tag == 23
}

pub(package) fn has_record_nonrecord_disjoint_pos(pos: i64) -> bool {
  let mut has_record = false
  let mut has_disjoint = false
  for i in 0..nlist_len(pos) {
    let tag = ty_tag(nlist_get(pos, i))
    if tag == 7 { has_record = true }
    else { if record_definitely_disjoint_tag(tag) { has_disjoint = true } else { 0 } }
  }
  has_record and has_disjoint
}

pub(package) fn record_atom_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  if not ty_is_record(actual) or not ty_is_record(expected) { false }
  else { if ty_record_tuple_kind(actual) != ty_record_tuple_kind(expected) { false }
  else {
    let actual_fields = ty_record_fields(actual)
    let expected_fields = ty_record_fields(expected)
    let actual_open = ty_record_open(actual)
    let expected_open = ty_record_open(expected)
    if expected_open == 0 and (actual_open == 1 or not record_fields_domain_equal(actual_fields, expected_fields)) { false }
    else {
      let mut subtype = true
      let mut i = 0
      while expected_fields != 0 and i < nlist_len(expected_fields) and subtype {
        let expected_field = nlist_get(expected_fields, i)
        let actual_field = ty_record_field_by_hash(actual_fields, ty_record_field_hash(expected_field))
        if actual_field == 0 { subtype = false }
        else {
          if is_subtype(ty_record_field_type(actual_field), ty_record_field_type(expected_field)) { i = i + 1 }
          else { subtype = false }
        }
      }
      subtype
    }
  } }
}

pub(package) fn has_record_subset_of_neg(pos: i64, neg: i64) -[Conformance]> bool {
  let mut found = false
  let mut i = 0
  while i < nlist_len(pos) and not found {
    let actual = nlist_get(pos, i)
    if ty_is_record(actual) {
      let mut j = 0
      while j < nlist_len(neg) and not found {
        if record_atom_is_subtype(actual, nlist_get(neg, j)) { found = true }
        else { j = j + 1 }
      }
    } else { 0 }
    i = i + 1
  }
  found
}

-- A non-empty fixed array whose element set is empty has no values. Length
-- zero is the canonical singleton empty array regardless of its element
-- annotation, so [never; 0] remains inhabited.
pub(package) fn has_empty_array_in_pos(pos: i64) -[Conformance]> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(pos) and not found {
    let atom = nlist_get(pos, i)
    if ty_is_array(atom) and ty_array_length(atom) > 0 {
      if ty_is_empty(ty_array_inner(atom)) { found = true } else { i = i + 1 }
    } else { i = i + 1 }
  }
  found
}

pub(package) fn indexed_positive_atoms_are_disjoint(a: i64, b: i64) -[Conformance]> bool {
  if ty_is_array(a) and ty_is_array(b) {
    let alen = ty_array_length(a)
    let blen = ty_array_length(b)
    if alen != blen { true }
    else { if alen == 0 { false }
    else { ty_is_empty(ty_inter(ty_array_inner(a), ty_array_inner(b))) } }
  } else { if ty_is_slice(a) and ty_is_slice(b) {
    -- Slice intersections are never proven empty from their elements: the
    -- empty view remains an inhabitant even when that intersection is never.
    -- Mutability changes subtyping, not this conservative overlap fact.
    false
  } else {
    (ty_is_array(a) and ty_is_slice(b)) or (ty_is_slice(a) and ty_is_array(b))
  } }
}

pub(package) fn has_disjoint_indexed_pos(pos: i64) -[Conformance]> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(pos) and not found {
    let a = nlist_get(pos, i)
    let mut j = i + 1
    while j < nlist_len(pos) and not found {
      if indexed_positive_atoms_are_disjoint(a, nlist_get(pos, j)) { found = true }
      else { j = j + 1 }
    }
    i = i + 1
  }
  found
}

pub(package) fn indexed_atom_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  if ty_is_array(actual) and ty_is_array(expected) {
    if ty_array_length(actual) != ty_array_length(expected) { false }
    else { if ty_array_length(actual) == 0 { true }
    else { is_subtype(ty_array_inner(actual), ty_array_inner(expected)) } }
  } else { if ty_is_slice(actual) and ty_is_slice(expected) {
    let actual_mut = ty_slice_mutable(actual)
    let expected_mut = ty_slice_mutable(expected)
    if actual_mut != expected_mut { false }
    else { if actual_mut == 1 {
      is_subtype(ty_slice_inner(actual), ty_slice_inner(expected)) and
        is_subtype(ty_slice_inner(expected), ty_slice_inner(actual))
    } else { is_subtype(ty_slice_inner(actual), ty_slice_inner(expected)) } }
  } else { false } }
}

pub(package) fn has_indexed_subset_of_neg(pos: i64, neg: i64) -[Conformance]> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(pos) and not found {
    let actual = nlist_get(pos, i)
    if ty_is_array(actual) or ty_is_slice(actual) {
      let mut j = 0
      while j < nlist_len(neg) and not found {
        if indexed_atom_is_subtype(actual, nlist_get(neg, j)) { found = true }
        else { j = j + 1 }
      }
    } else { 0 }
    i = i + 1
  }
  found
}

-- Check if a positive set has (concrete_type, trait_atom) that the oracle says don't conform
-- e.g., i64 & Display where i64 doesn't impl Display → unsatisfiable
pub(package) fn has_unsat_trait_pos(pos: i64) -[Conformance]> bool {
  -- Find concrete type atoms (Prim=tag 2, Named=tag 9) and trait atoms (tag 13) in pos
  let mut concrete_ty = 0
  let mut has_concrete = false
  let mut i = 0
  -- First pass: find a concrete type
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let atag = ty_tag(atom)
    if atag == 2 {
      -- Primitive: use negative prim ID (matching type_name_hash convention)
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { if atag == 9 {
      -- Named type: use name hash
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { i = i + 1 } }
  }
  if not has_concrete { false }
  else {
    -- Second pass: check each trait atom
    let mut j = 0
    let mut result = false
    while j < nlist_len(pos) {
      let atom = nlist_get(pos, j)
      if ty_tag(atom) == 13 or ty_tag(atom) == 27 {
        -- Ask the oracle: does this concrete type conform to this trait?
        if Conformance.conforms(concrete_ty, atom) == 0 {
          result = true
          j = nlist_len(pos)
        } else { j = j + 1 }
      } else { j = j + 1 }
    }
    result
  }
}

-- Check if (concrete in pos, trait in neg) and conformance EXISTS → unsatisfiable
-- e.g., i64 & ~Display where i64 DOES impl Display → i64 is in Display, contradicts ~Display
pub(package) fn has_unsat_trait_neg(pos: i64, neg: i64) -[Conformance]> bool {
  -- Find concrete type in positive set
  let mut concrete_ty = 0
  let mut has_concrete = false
  let mut i = 0
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let atag = ty_tag(atom)
    if atag == 2 {
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { if atag == 9 {
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { i = i + 1 } }
  }
  if not has_concrete { false }
  else {
    -- Check each trait atom in negative set
    let mut j = 0
    let mut result = false
    while j < nlist_len(neg) {
      let atom = nlist_get(neg, j)
      if ty_tag(atom) == 13 or ty_tag(atom) == 27 {
        -- If the type DOES conform, then type & ~Trait is empty (contradiction)
        if Conformance.conforms(concrete_ty, atom) == 1 {
          result = true
          j = nlist_len(neg)
        } else { j = j + 1 }
      } else { j = j + 1 }
    }
    result
  }
}

pub(package) fn has_never_in_pos(pos: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(pos) {
    if ty_tag(nlist_get(pos, i)) == 0 {
      found = true
      i = nlist_len(pos)
    } else { i = i + 1 }
  }
  found
}

-- The primitive subtype lattice: bool = {0, 1} sits inside i64. All other
-- primitives are pairwise disjoint value sets.
pub(package) fn prim_is_subprim(sub: i64, sup: i64) -> bool {
  sub == PRIM_BOOL() and sup == PRIM_I64()
}

pub(package) fn prims_overlap(p: i64, q: i64) -> bool {
  p == q or prim_is_subprim(p, q) == 1 or prim_is_subprim(q, p) == 1
}

-- Check if the positive list has two atoms with non-overlapping primitive
-- value sets (bool & i64 is bool, not empty).
pub(package) fn has_disjoint_prims(pos: i64) -> bool {
  let mut found_prim = 0 - 1
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let ptag = prim_tag(atom)
    if ptag >= 0 {
      if found_prim >= 0 {
        if prims_overlap(found_prim, ptag) == 0 {
          result = true
          i = nlist_len(pos)
        } else { i = i + 1 }
      } else {
        found_prim = ptag
        i = i + 1
      }
    } else { i = i + 1 }
  }
  result
}

-- A positive prim that is a subset of a negated prim contradicts: e.g.
-- bool & ~i64 is empty because bool ⊆ i64.
pub(package) fn has_prim_subset_of_neg(pos: i64, neg: i64) -> bool {
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let ptag = prim_tag(nlist_get(pos, i))
    if ptag >= 0 {
      let mut j = 0
      while j < nlist_len(neg) {
        let ntag = prim_tag(nlist_get(neg, j))
        if ntag >= 0 {
          if prim_is_subprim(ptag, ntag) == 1 {
            result = true
            j = nlist_len(neg)
            i = nlist_len(pos)
          } else { j = j + 1 }
        } else { j = j + 1 }
      }
      if result == 0 { i = i + 1 } else { 0 }
    } else { i = i + 1 }
  }
  result
}

-- Assign a unique tag to each primitive type (for disjointness checking)
-- Returns -1 for non-primitive types
pub(package) fn prim_tag(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { ty_f1(ty) }
  else { 0 - 1 }
}

-- Check if any atom appears in both lists
pub(package) fn has_overlap(pos: i64, neg: i64) -> bool {
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    if list_contains_type(neg, atom) {
      result = true
      i = nlist_len(pos)
    } else { i = i + 1 }
  }
  result
}

-- Check if a list contains a type (structural equality)
pub(package) fn list_contains_type(list: i64, ty: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(list) {
    if ty_eq(nlist_get(list, i), ty) {
      found = true
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

pub(package) fn ty_record_fields_equal(left_fields: i64, right_fields: i64) -> bool {
  let nl = if left_fields == 0 { 0 } else { nlist_len(left_fields) }
  let nr = if right_fields == 0 { 0 } else { nlist_len(right_fields) }
  if nl != nr { false }
  else {
    let mut equal = true
    let mut i = 0
    while i < nl and equal {
      let left_field = nlist_get(left_fields, i)
      let right_field = ty_record_field_by_hash(right_fields, ty_record_field_hash(left_field))
      if right_field == 0 { equal = false }
      else {
        if ty_eq(ty_record_field_type(left_field), ty_record_field_type(right_field)) { i = i + 1 }
        else { equal = false }
      }
    }
    equal
  }
}

-- Structural type equality
pub(package) fn ty_eq(a: i64, b: i64) -> bool {
  let ta = ty_tag(a)
  let tb = ty_tag(b)
  if ta != tb { false }
  else {
    match ta {
      0 -> true
      1 -> true
      2 -> ty_f1(a) == ty_f1(b)
      3 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      4 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      5 -> ty_eq(ty_f1(a), ty_f1(b))
      6 -> fn_type_eq(a, b)
      7 -> ty_record_open(a) == ty_record_open(b) and ty_record_tuple_kind(a) == ty_record_tuple_kind(b) and ty_record_fields_equal(ty_record_fields(a), ty_record_fields(b))
      9 -> ty_f1(a) == ty_f1(b) and ty_eq(ty_f2(a), ty_f2(b)) and type_arg_list_eq(ty_f3(a), ty_f3(b))
      12 -> ty_f1(a) == ty_f1(b)
      13 -> ty_f1(a) == ty_f1(b)
      14 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      15 -> ty_f2(a) == ty_f2(b) and ty_eq(ty_f1(a), ty_f1(b))
      16 -> ty_eq(ty_f1(a), ty_f1(b))
      17 -> ty_eq(ty_f1(a), ty_f1(b))
      18 -> ty_eq(ty_f1(a), ty_f1(b))
      19 -> ty_eq(ty_f1(a), ty_f1(b))
      21 -> ty_f2(a) == ty_f2(b) and ty_eq(ty_f1(a), ty_f1(b))
      22 -> {
        if ty_f2(a) != ty_f2(b) { false }
        else { if ty_f2(a) == 0 { true } else { ty_eq(ty_f1(a), ty_f1(b)) } }
      }
      23 -> ty_f2(a) == ty_f2(b) and ty_eq(ty_f1(a), ty_f1(b))
      24 -> ty_record_field_hash(a) == ty_record_field_hash(b) and ty_eq(ty_record_field_type(a), ty_record_field_type(b))
      27 -> ty_f1(a) == ty_f1(b)
      _ -> a == b
    }
  }
}

pub(package) fn type_arg_list_eq(a: i64, b: i64) -> bool {
  let a_empty = if a == 0 { true } else { nlist_len(a) == 0 }
  let b_empty = if b == 0 { true } else { nlist_len(b) == 0 }
  if a_empty and b_empty { true }
  else {
    if a_empty or b_empty { false } else { type_list_eq(a, b) }
  }
}

pub(package) fn type_list_eq(a: i64, b: i64) -> bool {
  let na = nlist_len(a)
  let nb = nlist_len(b)
  if na != nb { false }
  else {
    let mut ok = true
    for i in 0..na {
      if not ty_eq(nlist_get(a, i), nlist_get(b, i)) {
        ok = false
      } else { ok = ok }
    }
    ok
  }
}

pub(package) fn fn_type_eq(a: i64, b: i64) -> bool {
  type_list_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b)) and effect_is_subset(ty_f3(a), ty_f3(b)) and effect_is_subset(ty_f3(b), ty_f3(a))
}

pub(package) fn fn_param_subtypes(actual_params: i64, expected_params: i64) -[Conformance]> bool {
  let na = nlist_len(actual_params)
  let nb = nlist_len(expected_params)
  if na != nb { false }
  else {
    let mut ok = true
    for i in 0..na {
      -- Function parameters are contravariant.
      if not is_subtype(nlist_get(expected_params, i), nlist_get(actual_params, i)) {
        ok = false
      } else { ok = ok }
    }
    ok
  }
}

pub(package) fn fn_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  fn_param_subtypes(ty_f1(actual), ty_f1(expected)) and is_subtype(ty_f2(actual), ty_f2(expected)) and effect_is_subset(ty_f3(actual), ty_f3(expected))
}

pub(package) fn continuation_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  is_subtype(ty_f1(expected), ty_f1(actual)) and is_subtype(ty_f2(actual), ty_f2(expected))
}

pub(package) fn ptr_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  if ty_ptr_mutable(expected) == 1 {
    ty_ptr_mutable(actual) == 1 and ty_eq(ty_ptr_inner(actual), ty_ptr_inner(expected))
  } else {
    is_subtype(ty_ptr_inner(actual), ty_ptr_inner(expected))
  }
}

-- ══════════════════════════════════════════════════════════════
-- Subtyping: A <: B iff A & ~B is empty
-- ══════════════════════════════════════════════════════════════

pub(package) fn is_subtype(a: i64, b: i64) -[Conformance]> bool {
  -- Fast path: reflexivity
  if a == b { true }
  else {
    let ta = ty_tag(a)
    let tb = ty_tag(b)
    -- Never <: anything
    if ta == 0 { true }
    -- anything <: Any
    else { if tb == 1 { true }
    else { if ta == 6 {
      if tb == 6 { fn_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 7 {
      if tb == 7 { record_atom_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 14 {
      if tb == 14 { continuation_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 15 {
      if tb == 15 { ptr_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 16 {
      if tb == 16 { is_subtype(ty_weak_inner(a), ty_weak_inner(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 17 {
      if tb == 17 { is_subtype(ty_arc_inner(a), ty_arc_inner(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 18 {
      if tb == 18 { is_subtype(ty_unique_inner(a), ty_unique_inner(b)) }
      else { is_subtype(ty_unique_inner(a), b) }
    }
    else { if ta == 19 {
      if tb == 19 { is_subtype(ty_owned_inner(a), ty_owned_inner(b)) }
      else { is_subtype(ty_owned_inner(a), b) }
    }
    else { if ta == 22 {
      if tb == 22 { indexed_atom_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 23 {
      if tb == 23 { indexed_atom_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    -- Same primitive: equal. bool = {0, 1} is a subset of i64's value set
    -- (true/false ARE the i64 values 1/0 at runtime), so bool <: i64.
    else { if ta == 2 {
      if tb == 2 { ty_f1(a) == ty_f1(b) or prim_is_subprim(ty_f1(a), ty_f1(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 9 and ty_is_rc(a) == 1 and tb == 15 and ty_ptr_mutable(b) == 0 {
      is_subtype(ty_rc_inner(a), ty_ptr_inner(b))
    }
    -- rc values are represented as managed heap pointers at runtime.
    else { if ta == 9 and ty_is_rc(a) == 1 and tb == 2 and ty_f1(b) == PRIM_I64() { true }
    -- General case: A & ~B is empty
    else { ty_is_empty(ty_inter(a, ty_compl(b))) } } } } } } } } } } } } } } }
  }
}

-- ══════════════════════════════════════════════════════════════
-- List utilities (concat)
-- ══════════════════════════════════════════════════════════════

pub(package) fn list_concat(a: i64, b: i64) -> i64 {
  let result = nlist_new()
  let mut i = 0
  while i < nlist_len(a) {
    nlist_add(result, nlist_get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < nlist_len(b) {
    nlist_add(result, nlist_get(b, j))
    j = j + 1
  }
  result
}
