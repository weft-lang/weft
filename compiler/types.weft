-- compiler/types.weft — Set-theoretic type representation and subtyping
--
-- Types are sets. Union (|), intersection (&), complement (~) are primitive.
-- Subtyping is set inclusion: A <: B iff A & ~B is empty.
-- Checked via DNF normalization and emptiness testing.
--
-- The Conformance effect is used by the emptiness checker to determine
-- if a conjunction like `i64 & Display` is satisfiable. The handler
-- is installed in main.weft's compile function, backed by the
-- conformance table built from impl blocks.

use "runtime/types_storage.weft"

effect Conformance {
  fn conforms(ty: i64, trait_hash: i64) -> i64
}
--
-- Memory layout: each type node is 40 bytes:
--   [0]  tag (type kind)
--   [8]  f1
--   [16] f2
--   [24] f3
--   [32] f4
--
-- Type tags:
--   0 = Never (bottom, empty set)
--   1 = Any (top, complement of never)
--   2 = Prim(id) — primitive atom: i64=0, str=1, bool=2, nil=3, f64=4, i32=5, i8=6, i16=7, u8=8, u16=9, u32=10, u64=11, isize=12, usize=13, f32=14
--   3 = Union(lhs, rhs)
--   4 = Inter(lhs, rhs) — intersection
--   5 = Compl(inner) — complement
--   6 = Fn(params, ret, effects) — function type
--   7 = Record(fields, open) — structural record type
--   8 = Variant(tag_name_hash, payload_type) — variant constructor type
--   9 = Named(name_hash, inner) — nominal type wrapper
--  10 = EffectSig(effects_list, tail_var) — concrete effect set
--  11 = EffectApp(name_hash, type_args) — individual effect atom
--  12 = TypeVar(var_id) — type variable (opaque atom in DNF)
--  13 = Trait(name_hash) — nominal trait atom
--  14 = Continuation(input, result) — linear one-shot continuation
--  15 = Ptr(inner, mutable) — typed raw pointer; mutable = 0/1
--  16 = Weak(inner) — non-owning managed reference
--  17 = Arc(inner) — internal promoted-atomic strong managed reference
--  18 = Unique(inner) — move-only ordinary data
--  19 = Owned(inner) — move-only resource capability
--  20 = Unsupported(kind) — fenced aspirational surface syntax
--  21 = Assoc(base, name_hash) — associated-type projection

-- ══════════════════════════════════════════════════════════════
-- Type constructors
-- ══════════════════════════════════════════════════════════════

fn ty_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  types_storage_type_new(tag, f1, f2, f3, f4)
}
fn ty_tag(t: i64) -> i64 { types_storage_type_tag(t) }
fn ty_f1(t: i64) -> i64 { types_storage_type_f1(t) }
fn ty_f2(t: i64) -> i64 { types_storage_type_f2(t) }
fn ty_f3(t: i64) -> i64 { types_storage_type_f3(t) }
fn ty_f4(t: i64) -> i64 { types_storage_type_f4(t) }

-- Primitive type IDs
fn PRIM_I64() -> i64 { 0 }
fn PRIM_STR() -> i64 { 1 }
fn PRIM_BOOL() -> i64 { 2 }
fn PRIM_NIL() -> i64 { 3 }
fn PRIM_F64() -> i64 { 4 }
fn PRIM_I32() -> i64 { 5 }
fn PRIM_I8() -> i64 { 6 }
fn PRIM_I16() -> i64 { 7 }
fn PRIM_U8() -> i64 { 8 }
fn PRIM_U16() -> i64 { 9 }
fn PRIM_U32() -> i64 { 10 }
fn PRIM_U64() -> i64 { 11 }
fn PRIM_ISIZE() -> i64 { 12 }
fn PRIM_USIZE() -> i64 { 13 }
fn PRIM_F32() -> i64 { 14 }

-- Constructors
fn ty_never() -> i64 { ty_new(0, 0, 0, 0, 0) }
fn ty_any() -> i64 { ty_new(1, 0, 0, 0, 0) }
fn ty_prim(id: i64) -> i64 { ty_new(2, id, 0, 0, 0) }
fn ty_i64() -> i64 { ty_prim(PRIM_I64()) }
fn ty_str() -> i64 { ty_prim(PRIM_STR()) }
fn ty_bool() -> i64 { ty_prim(PRIM_BOOL()) }
fn ty_nil() -> i64 { ty_prim(PRIM_NIL()) }
fn ty_f64() -> i64 { ty_prim(PRIM_F64()) }
fn ty_i32() -> i64 { ty_prim(PRIM_I32()) }
fn ty_i8() -> i64 { ty_prim(PRIM_I8()) }
fn ty_i16() -> i64 { ty_prim(PRIM_I16()) }
fn ty_u8() -> i64 { ty_prim(PRIM_U8()) }
fn ty_u16() -> i64 { ty_prim(PRIM_U16()) }
fn ty_u32() -> i64 { ty_prim(PRIM_U32()) }
fn ty_u64() -> i64 { ty_prim(PRIM_U64()) }
fn ty_isize() -> i64 { ty_prim(PRIM_ISIZE()) }
fn ty_usize() -> i64 { ty_prim(PRIM_USIZE()) }
fn ty_f32() -> i64 { ty_prim(PRIM_F32()) }
fn ty_union(a: i64, b: i64) -> i64 { ty_new(3, a, b, 0, 0) }
fn ty_inter(a: i64, b: i64) -> i64 { ty_new(4, a, b, 0, 0) }
fn ty_compl(inner: i64) -> i64 { ty_new(5, inner, 0, 0, 0) }

-- Guard narrowing (2n): the type with nil removed, or 0 when removing
-- nil would not change the type (the caller then keeps the original
-- binding). Union arms drop their nil parts syntactically so the
-- narrowed type stays clean (T | nil -> T) instead of accreting
-- intersection-with-complement wrappers; a bare nil narrows to never
-- (the guarded branch is unreachable for a provably-nil value).
-- 1 when the type is str or a union with a str arm (2u: such values
-- take the nil-safe content-equality lowering for == / !=).
fn ty_mentions_str(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { if ty_f1(ty) == PRIM_STR() { 1 } else { 0 } }
  else { if tag == 3 {
    if ty_mentions_str(ty_f1(ty)) == 1 { 1 } else { ty_mentions_str(ty_f2(ty)) }
  } else { 0 } }
}

fn ty_narrow_drop_nil(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 {
    if ty_f1(ty) == PRIM_NIL() { ty_never() } else { 0 }
  } else { if tag == 3 {
    let a = ty_narrow_drop_nil(ty_f1(ty))
    let b = ty_narrow_drop_nil(ty_f2(ty))
    if a == 0 and b == 0 { 0 }
    else {
      let left = if a == 0 { ty_f1(ty) } else { a }
      let right = if b == 0 { ty_f2(ty) } else { b }
      if ty_tag(left) == 0 { right }
      else { if ty_tag(right) == 0 { left } else { ty_union(left, right) } }
    }
  } else { 0 } }
}

-- Function type: (params) -> ret or (params) -[effects]> ret
fn ty_fn(params: i64, ret: i64, eff: i64) -> i64 { ty_new(6, params, ret, eff, 0) }

-- Continuation type: one-shot callable resource, distinct from ordinary Fn.
fn ty_continuation(input: i64, result: i64) -> i64 { ty_new(14, input, result, 0, 0) }
fn ty_is_continuation(ty: i64) -> i64 {
  if ty == 0 { false } else { ty_tag(ty) == 14 }
}

-- Pointer type: *T or *mut T.
fn ty_ptr(inner: i64) -> i64 { ty_new(15, inner, 0, 0, 0) }
fn ty_mut_ptr(inner: i64) -> i64 { ty_new(15, inner, 1, 0, 0) }
fn ty_ptr_with_mut(inner: i64, mutable: i64) -> i64 {
  if mutable == 1 { ty_mut_ptr(inner) } else { ty_ptr(inner) }
}
fn ty_is_ptr(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 15 }
}
fn ty_ptr_inner(ty: i64) -> i64 {
  if ty_is_ptr(ty) { ty_f1(ty) } else { ty_any() }
}
fn ty_ptr_mutable(ty: i64) -> i64 {
  if ty_is_ptr(ty) { ty_f2(ty) } else { 0 }
}

-- Managed-reference type nodes. Weak is public; Arc is transitional/internal.
-- unique is public move-only ordinary data; owned is move-only resources.
fn ty_weak(inner: i64) -> i64 { ty_new(16, inner, 0, 0, 0) }
fn ty_arc(inner: i64) -> i64 { ty_new(17, inner, 0, 0, 0) }
fn ty_unique(inner: i64) -> i64 { ty_new(18, inner, 0, 0, 0) }
fn ty_owned(inner: i64) -> i64 { ty_new(19, inner, 0, 0, 0) }
fn ty_assoc(base: i64, name_hash: i64) -> i64 { ty_new(21, base, name_hash, 0, 0) }
fn ty_is_weak(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 16 }
}
fn ty_is_arc(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 17 }
}
fn ty_is_unique(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 18 }
}
fn ty_is_owned(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 19 }
}
fn ty_weak_inner(ty: i64) -> i64 {
  if ty_is_weak(ty) { ty_f1(ty) } else { ty }
}
fn ty_arc_inner(ty: i64) -> i64 {
  if ty_is_arc(ty) { ty_f1(ty) } else { ty }
}
fn ty_unique_inner(ty: i64) -> i64 {
  if ty_is_unique(ty) { ty_f1(ty) } else { ty }
}
fn ty_owned_inner(ty: i64) -> i64 {
  if ty_is_owned(ty) { ty_f1(ty) } else { ty }
}

-- Unsupported-surface marker (4a): the parser produces this for syntax the
-- kernel specifies but the compiler does not implement yet, instead of
-- silently erasing it to any. The checker rejects it with a targeted
-- diagnostic; to_dnf's default arm keeps it a safe opaque atom if lenient
-- checking continues past the error. Kinds: 1 = structural record type (4f),
-- 2 = tuple type (4f), 3 = array/slice type (4e), 4 = effect type args (4c).
fn ty_unsupported(kind: i64) -> i64 { ty_new(20, kind, 0, 0, 0) }
fn ty_is_unsupported(ty: i64) -> bool {
  if ty == 0 { false } else { ty_tag(ty) == 20 }
}

-- Named type: Named(name_hash, inner) — nominal type wrapper
fn ty_named(hash: i64, inner: i64) -> i64 { ty_new(9, hash, inner, 0, 0) }
fn ty_named_app(hash: i64, inner: i64, args: i64) -> i64 { ty_new(9, hash, inner, args, 0) }
fn ty_rc_hash() -> i64 { 5863770 }
fn ty_rc(inner: i64) -> i64 { ty_named(ty_rc_hash(), inner) }
fn ty_is_rc(ty: i64) -> bool {
  if ty_tag(ty) == 9 { ty_f1(ty) == ty_rc_hash() } else { false }
}
fn ty_rc_inner(ty: i64) -> i64 {
  if ty_is_rc(ty) { ty_f2(ty) } else { ty }
}

-- Shared aggregate-storage fact used by ownership lowering and by the
-- type-level deep-release-mask capacity check. Values are the compact
-- two-bit header encoding: 0 none, 1 default-managed, 2 closure/
-- continuation, 3 weak. Keep this producer semantic; the backend maps
-- these values to its cleanup-descriptor kinds.
fn ty_field_release_mask_kind(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_is_rc(ty) { 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 2 and ty_f1(ty) == PRIM_STR() { 1 }
    else { if tag == 6 or tag == 14 { 2 }
    else { if tag == 16 {
      let inner = ty_weak_inner(ty)
      if ty_field_release_mask_kind(inner) == 1 or ty_tag(inner) == 6 or ty_tag(inner) == 14 or ty_is_arc(inner) { 3 } else { 0 }
    } else { if tag == 9 { 1 }
    else { if tag == 3 {
      let lhs = ty_f1(ty)
      let rhs = ty_f2(ty)
      let lhs_kind = ty_field_release_mask_kind(lhs)
      let rhs_kind = ty_field_release_mask_kind(rhs)
      let lhs_nil = ty_tag(lhs) == 2 and ty_f1(lhs) == PRIM_NIL()
      let rhs_nil = ty_tag(rhs) == 2 and ty_f1(rhs) == PRIM_NIL()
      if lhs_kind != 0 and rhs_nil { lhs_kind }
      else { if rhs_kind != 0 and lhs_nil { rhs_kind }
      else { if lhs_kind != 0 and lhs_kind == rhs_kind { lhs_kind } else { 0 } } }
    } else { 0 } } } } }
  } }
}

-- Generic declarations are checked before concrete substitutions exist.
-- A field whose type can later acquire a release kind must therefore be
-- treated conservatively at an unencodable word; otherwise a generic
-- instance can silently regress to shallow release.
fn ty_field_may_require_release_mask(ty: i64) -> i64 {
  if ty == 0 { 0 }
  else { if ty_field_release_mask_kind(ty) != 0 { 1 }
  else {
    let tag = ty_tag(ty)
    if tag == 1 or tag == 5 or tag == 12 or tag == 13 or tag == 16 or tag == 17 { 1 }
    else { if tag == 3 or tag == 4 {
      if ty_field_may_require_release_mask(ty_f1(ty)) == 1 or ty_field_may_require_release_mask(ty_f2(ty)) == 1 { 1 } else { 0 }
    } else { 0 } }
  } }
}

-- Trait type: nominal atom for trait bounds in DNF
fn ty_trait(hash: i64) -> i64 { ty_new(13, hash, 0, 0, 0) }

-- Nullable sugar: T? = T | nil
fn ty_nullable(t: i64) -> i64 { ty_union(t, ty_nil()) }

-- ══════════════════════════════════════════════════════════════
-- Effect types (Phase 1: concrete closed sets)
-- ══════════════════════════════════════════════════════════════
--
-- Tag 10 = EffectSig(concrete_effects_list, tail_var_id)
--   f1 = nlist of EffectApp nodes (sorted by name hash)
--   f2 = 0 (closed set) or >0 (effect variable ID — Phase 2)
-- Tag 11 = EffectApp(name_hash, type_args_list)
--   f1 = name hash (effect name, e.g., str_hash for "IO")
--   f2 = nlist of type arg nodes (empty for Phase 1)

fn ty_effect_sig(effects: i64) -> i64 { ty_new(10, effects, 0, 0, 0) }
fn ty_effect_sig_with_tail(effects: i64, tail: i64) -> i64 { ty_new(10, effects, tail, 0, 0) }
fn ty_effect_pure() -> i64 { ty_effect_sig(nlist_new()) }
fn ty_effect_app(name_hash: i64) -> i64 { ty_new(11, name_hash, 0, 0, 0) }
-- 4c: parameterized effect atom — State<SymTab> is ty_new(11, hash(State),
-- args_nlist). Distinct instantiations are distinct set members (kernel
-- §7.1, law L2). f2 == 0 means the bare, unparameterized form.
fn ty_effect_app_args(name_hash: i64, args: i64) -> i64 { ty_new(11, name_hash, args, 0, 0) }
fn effect_atom_args(atom: i64) -> i64 { ty_f2(atom) }

-- Find the first atom with the given head hash in a list/sig (or 0).
-- Callers that accept an unqualified surface reference must pair this with
-- `effect_list_head_is_ambiguous`; qualified references compare full atoms.
fn effect_list_find_atom_by_head(list: i64, hash: i64) -> i64 {
  if list == 0 { 0 }
  else {
    let n = nlist_len(list)
    let mut i = 0
    let mut found = 0
    while i < n {
      let atom = nlist_get(list, i)
      if ty_f1(atom) == hash { found = atom i = n } else { i = i + 1 }
    }
    found
  }
}

fn effect_sig_find_atom_by_head(sig: i64, hash: i64) -> i64 {
  if sig == 0 { 0 }
  else { if ty_tag(sig) != 10 { 0 }
  else { effect_list_find_atom_by_head(ty_f1(sig), hash) } }
}

-- True when a head names more than one DISTINCT atom. Identical repeats are
-- harmless set notation and do not make an unqualified reference ambiguous.
fn effect_list_head_is_ambiguous(list: i64, hash: i64) -> i64 {
  if list == 0 { 0 }
  else {
    let first = effect_list_find_atom_by_head(list, hash)
    if first == 0 { 0 }
    else {
      let mut ambiguous = 0
      let mut i = 0
      while i < nlist_len(list) {
        let atom = nlist_get(list, i)
        if ty_f1(atom) == hash and not effect_atom_eq(atom, first) {
          ambiguous = 1
          i = nlist_len(list)
        } else { i = i + 1 }
      }
      ambiguous
    }
  }
}

fn effect_sig_head_is_ambiguous(sig: i64, hash: i64) -> i64 {
  if sig == 0 or ty_tag(sig) != 10 { 0 }
  else { effect_list_head_is_ambiguous(ty_f1(sig), hash) }
}

-- 4c: effect atom identity is (head hash, type args).
fn effect_atom_eq(a: i64, b: i64) -> bool {
  if ty_f1(a) != ty_f1(b) { false }
  else {
    let aa = ty_f2(a)
    let ba = ty_f2(b)
    if aa == 0 and ba == 0 { true }
    else { if aa == 0 or ba == 0 { false }
    else { type_list_eq(aa, ba) } }
  }
}

-- Check if effect set A is a subset of effect set B (both EffectSig tag 10)
-- A <: B means every effect in A is also in B (fewer effects = more restricted = subtype)
-- 4a S9: rigid-position effect subset. Used where the expected set is a
-- caller's DECLARED signature: its tail variable is universally quantified
-- (the caller's caller chooses it), so a concrete effect performed or
-- charged inside the body can never be absorbed by the tail — only
-- variable-tailed flows (calling a value typed -[E]>) ride it. The
-- solving-position check below keeps its open-tail permissiveness for
-- argument passing until 4c lands real unification; tail-id matching
-- (rejecting F-charged-to-E) is also 4c-scoped.
fn effect_is_subset_rigid(a: i64, b: i64) -> bool {
  if ty_tag(a) != 10 { true }
  else { if ty_tag(b) != 10 { true }
  else {
    let a_list = ty_f1(a)
    let b_list = ty_f1(b)
    let a_tail = ty_f2(a)
    let b_tail = ty_f2(b)
    let na = nlist_len(a_list)
    let nb = nlist_len(b_list)
    let mut ok = true
    let mut i = 0
    while i < na {
      let a_atom = nlist_get(a_list, i)
      let mut found = false
      let mut j = 0
      while j < nb {
        if effect_atom_eq(nlist_get(b_list, j), a_atom) { found = true j = nb }
        else { j = j + 1 }
      }
      if not found { ok = false i = na }
      else { i = i + 1 }
    }
    if a_tail > 0 and b_tail == 0 { false } else { ok }
  } }
}

fn effect_is_subset(a: i64, b: i64) -> bool {
  if ty_tag(a) != 10 { true }
  else { if ty_tag(b) != 10 { true }
  else {
    let a_list = ty_f1(a)
    let b_list = ty_f1(b)
    let a_tail = ty_f2(a)
    let b_tail = ty_f2(b)
    let na = nlist_len(a_list)
    let nb = nlist_len(b_list)
    -- If right side has a tail variable, it accepts any additional effects
    -- (the tail represents an unknown open set). Left's concrete effects
    -- must still be in right's concrete set OR absorbed by the tail.
    if b_tail > 0 {
      -- Right is open: left's concrete effects are accepted (tail absorbs extras)
      -- Still check that left's concrete ⊆ right's concrete for the known part
      -- Actually, with an open tail, any concrete effect on the left is fine —
      -- the tail variable can unify to include it. So always true.
      true
    } else {
      -- Right is closed: every effect in a_list must appear in b_list
      let mut ok = true
      let mut i = 0
      while i < na {
        let a_atom = nlist_get(a_list, i)
        let mut found = false
        let mut j = 0
        while j < nb {
          if effect_atom_eq(nlist_get(b_list, j), a_atom) { found = true j = nb }
          else { j = j + 1 }
        }
        if not found { ok = false i = na }
        else { i = i + 1 }
      }
      -- If left has a tail (open), it can't be subset of a closed set
      -- (the tail could contain anything)
      if a_tail > 0 { false } else { ok }
    }
  } }
}

-- ══════════════════════════════════════════════════════════════
-- Type variables (for generics)
-- ══════════════════════════════════════════════════════════════
--
-- Tag 12 = TypeVar(var_id)
--   var_id: sequential integer (0, 1, 2...) within a generic function
--   TypeVars are opaque atoms in DNF — to_dnf treats them via the _ -> dnf_atom fallthrough.

fn ty_var(id: i64) -> i64 { ty_new(12, id, 0, 0, 0) }
fn ty_var_id(t: i64) -> i64 { ty_f1(t) }

-- `Self` is a rigid, contextual type placeholder rather than an ordinary
-- method type parameter.  Ordinary generic ids are allocated from zero;
-- keeping Self at -1 lets the existing recursive substitution machinery
-- instantiate every nested occurrence without making it solver-owned.
fn ty_self() -> i64 { ty_var(0 - 1) }
fn ty_is_self(t: i64) -> bool {
  if t == 0 { false }
  else { if ty_tag(t) == 12 { ty_var_id(t) == 0 - 1 } else { false } }
}

-- ══════════════════════════════════════════════════════════════
-- Type substitution (for generic instantiation)
-- ══════════════════════════════════════════════════════════════
--
-- A substitution maps TypeVar ids to concrete types.
-- Stored as an nlist of [var_id, type] pairs (node_new(0, var_id, ty, 0, 0)).

fn subst_new() -> i64 { nlist_new() }
fn subst_add(s: i64, var_id: i64, ty: i64) -> i64 {
  nlist_add(s, node_new(0, var_id, ty, 0, 0))
  s
}
fn subst_lookup(s: i64, var_id: i64) -> i64 {
  let mut i = 0
  let mut result = 0
  while i < nlist_len(s) {
    let e = nlist_get(s, i)
    if node_f1(e) == var_id {
      result = node_f2(e)
      i = nlist_len(s)
    } else { i = i + 1 }
  }
  result
}

-- Effect tails share the generic substitution map with ordinary type
-- variables. A binding for E is an EffectSig, so substituting
-- -[State<S>, E]> merges the substituted State atom with E's concrete
-- effects and carries E's residual tail. This is the Phase-2/mono erasure
-- rule from effect-types.md; leaving the integer tail untouched made every
-- inferred effect-polymorphic call remain open after specialisation.
fn effect_atom_list_add_unique(dst: i64, src: i64) -> i64 {
  if src == 0 { dst }
  else {
    for i in 0..nlist_len(src) {
      let atom = nlist_get(src, i)
      let mut found = false
      for j in 0..nlist_len(dst) {
        if effect_atom_eq(nlist_get(dst, j), atom) { found = true } else { 0 }
      }
      if not found { nlist_add(dst, atom) } else { 0 }
    }
    dst
  }
}

fn effect_sig_subst(sig: i64, s: i64) -> i64 {
  let concrete = type_list_subst(ty_f1(sig), s)
  let tail = ty_f2(sig)
  if tail == 0 { ty_effect_sig(concrete) }
  else {
    let binding = subst_lookup(s, tail - 1)
    if binding == 0 or ty_tag(binding) != 10 {
      ty_effect_sig_with_tail(concrete, tail)
    } else {
      let merged = nlist_new()
      effect_atom_list_add_unique(merged, concrete)
      effect_atom_list_add_unique(merged, type_list_subst(ty_f1(binding), s))
      ty_effect_sig_with_tail(merged, ty_f2(binding))
    }
  }
}

-- Recursively substitute type variables in a type expression
fn ty_subst(ty: i64, s: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    let tag = ty_tag(ty)
    match tag {
      0 -> ty
      1 -> ty
      2 -> ty
      3 -> ty_union(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      4 -> ty_inter(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      5 -> ty_compl(ty_subst(ty_f1(ty), s))
      6 -> ty_fn(type_list_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s), ty_subst(ty_f3(ty), s))
      9 -> ty_named_app(ty_f1(ty), ty_subst(ty_f2(ty), s), type_list_subst(ty_f3(ty), s))
      -- 4c: effect atoms substitute their type args and effect signatures
      -- resolve their optional tail from the same generic substitution.
      10 -> effect_sig_subst(ty, s)
      11 -> {
        if ty_f2(ty) == 0 { ty }
        else { ty_effect_app_args(ty_f1(ty), type_list_subst(ty_f2(ty), s)) }
      }
      14 -> ty_continuation(ty_subst(ty_f1(ty), s), ty_subst(ty_f2(ty), s))
      15 -> ty_ptr_with_mut(ty_subst(ty_f1(ty), s), ty_f2(ty))
      16 -> ty_weak(ty_subst(ty_f1(ty), s))
      17 -> ty_arc(ty_subst(ty_f1(ty), s))
      18 -> ty_unique(ty_subst(ty_f1(ty), s))
      19 -> ty_owned(ty_subst(ty_f1(ty), s))
      21 -> ty_assoc(ty_subst(ty_f1(ty), s), ty_f2(ty))
      12 -> {
        let concrete = subst_lookup(s, ty_f1(ty))
        if concrete != 0 { concrete } else { ty }
      }
      _ -> ty
    }
  }
}

fn type_list_subst(types: i64, s: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    let n = nlist_len(types)
    for i in 0..n {
      nlist_add(result, ty_subst(nlist_get(types, i), s))
    }
    result
  }
}

-- Match a generic impl target against a concrete receiver, accumulating the
-- impl-variable bindings used by signature checking and monomorphisation.
-- Repeated variables are equality constraints, not fresh wildcards.
fn ty_pattern_match_list(patterns: i64, concrete: i64, s: i64) -> bool {
  let np = if patterns == 0 { 0 } else { nlist_len(patterns) }
  let nc = if concrete == 0 { 0 } else { nlist_len(concrete) }
  if np != nc { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < np {
      if ty_pattern_match(nlist_get(patterns, i), nlist_get(concrete, i), s) {
        i = i + 1
      } else { ok = false i = np }
    }
    ok
  }
}

fn ty_pattern_match(pattern: i64, concrete: i64, s: i64) -> bool {
  if pattern == 0 or concrete == 0 { pattern == concrete }
  else { if ty_tag(pattern) == 12 and not ty_is_self(pattern) {
    let var_id = ty_var_id(pattern)
    let bound = subst_lookup(s, var_id)
    if bound == 0 {
      subst_add(s, var_id, concrete)
      true
    } else { ty_eq(bound, concrete) }
  } else {
    let pt = ty_tag(pattern)
    let ct = ty_tag(concrete)
    if pt != ct { false }
    else {
      match pt {
        0 -> true
        1 -> true
        2 -> ty_f1(pattern) == ty_f1(concrete)
        3 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        4 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        5 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        6 -> ty_pattern_match_list(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        9 -> ty_f1(pattern) == ty_f1(concrete) and ty_pattern_match_list(ty_f3(pattern), ty_f3(concrete), s)
        14 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s) and ty_pattern_match(ty_f2(pattern), ty_f2(concrete), s)
        15 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        16 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        17 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        18 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        19 -> ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        21 -> ty_f2(pattern) == ty_f2(concrete) and ty_pattern_match(ty_f1(pattern), ty_f1(concrete), s)
        _ -> ty_eq(pattern, concrete)
      }
    }
  } }
}

fn ty_pattern_bound_args(tparams: i64, s: i64) -> i64 {
  if tparams == 0 { 0 }
  else {
    let args = nlist_new()
    let mut valid = true
    for i in 0..nlist_len(tparams) {
      let arg = subst_lookup(s, node_f3(nlist_get(tparams, i)))
      if arg == 0 { valid = false } else { nlist_add(args, arg) }
    }
    if valid { args } else { 0 }
  }
}

fn ty_rebase_pattern_vars_list(types: i64, delta: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let result = nlist_new()
    for i in 0..nlist_len(types) { nlist_add(result, ty_rebase_pattern_vars(nlist_get(types, i), delta)) }
    result
  }
}

fn ty_rebase_pattern_vars(ty: i64, delta: i64) -> i64 {
  if ty == 0 { 0 }
  else {
    match ty_tag(ty) {
      3 -> ty_union(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      4 -> ty_inter(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      5 -> ty_compl(ty_rebase_pattern_vars(ty_f1(ty), delta))
      6 -> ty_fn(ty_rebase_pattern_vars_list(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta), ty_rebase_pattern_vars(ty_f3(ty), delta))
      9 -> ty_named_app(ty_f1(ty), ty_rebase_pattern_vars(ty_f2(ty), delta), ty_rebase_pattern_vars_list(ty_f3(ty), delta))
      12 -> if ty_is_self(ty) { ty } else { ty_var(ty_var_id(ty) + delta) }
      14 -> ty_continuation(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_rebase_pattern_vars(ty_f2(ty), delta))
      15 -> ty_ptr_with_mut(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      16 -> ty_weak(ty_rebase_pattern_vars(ty_f1(ty), delta))
      17 -> ty_arc(ty_rebase_pattern_vars(ty_f1(ty), delta))
      18 -> ty_unique(ty_rebase_pattern_vars(ty_f1(ty), delta))
      19 -> ty_owned(ty_rebase_pattern_vars(ty_f1(ty), delta))
      21 -> ty_assoc(ty_rebase_pattern_vars(ty_f1(ty), delta), ty_f2(ty))
      _ -> ty
    }
  }
}

fn ty_pattern_unify_list(left: i64, right: i64, s: i64) -> bool {
  let nl = if left == 0 { 0 } else { nlist_len(left) }
  let nr = if right == 0 { 0 } else { nlist_len(right) }
  if nl != nr { false }
  else {
    let mut ok = true
    let mut i = 0
    while i < nl {
      if ty_pattern_unify(nlist_get(left, i), nlist_get(right, i), s) { i = i + 1 }
      else { ok = false i = nl }
    }
    ok
  }
}

fn ty_pattern_unify(left: i64, right: i64, s: i64) -> bool {
  if left == 0 or right == 0 { left == right }
  else { if ty_tag(left) == 12 and not ty_is_self(left) {
    let bound = subst_lookup(s, ty_var_id(left))
    if bound != 0 { ty_pattern_unify(bound, right, s) }
    else { if ty_tag(right) == 12 and not ty_is_self(right) {
      let right_bound = subst_lookup(s, ty_var_id(right))
      if right_bound != 0 { ty_pattern_unify(left, right_bound, s) }
      else { subst_add(s, ty_var_id(left), right) != 0 }
    } else { subst_add(s, ty_var_id(left), right) != 0 } }
  } else { if ty_tag(right) == 12 and not ty_is_self(right) {
    ty_pattern_unify(right, left, s)
  } else { if ty_tag(left) != ty_tag(right) { false }
  else {
    match ty_tag(left) {
      0 -> true
      1 -> true
      2 -> ty_f1(left) == ty_f1(right)
      3 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      4 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      5 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      6 -> ty_pattern_unify_list(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      9 -> ty_f1(left) == ty_f1(right) and ty_pattern_unify_list(ty_f3(left), ty_f3(right), s)
      14 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s) and ty_pattern_unify(ty_f2(left), ty_f2(right), s)
      15 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      16 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      17 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      18 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      19 -> ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      21 -> ty_f2(left) == ty_f2(right) and ty_pattern_unify(ty_f1(left), ty_f1(right), s)
      _ -> ty_eq(left, right)
    }
  } } } }
}

fn ty_patterns_overlap(left: i64, right: i64) -> bool {
  ty_pattern_unify(left, ty_rebase_pattern_vars(right, 1048576), subst_new())
}

-- Resolved method-call fact carried from type checking into lowering.
-- f1 = dispatch owner/head hash, f2 = concrete receiver type,
-- f3 = target/specialisation type arguments, f4 = flags:
--   bit 0: generic template, bit 1: associated (type-qualified) call.
fn method_ref_flags(generic: i64, associated: i64) -> i64 {
  (if generic != 0 { 1 } else { 0 }) + (if associated != 0 { 2 } else { 0 })
}
fn method_ref_new(owner_hash: i64, receiver_ty: i64, type_args: i64, generic: i64) -> i64 {
  node_new(70, owner_hash, receiver_ty, type_args, method_ref_flags(generic, 0))
}
fn method_ref_new_associated(owner_hash: i64, receiver_ty: i64, type_args: i64, generic: i64) -> i64 {
  node_new(70, owner_hash, receiver_ty, type_args, method_ref_flags(generic, 1))
}
fn method_ref_owner_hash(ref: i64) -> i64 { node_f1(ref) }
fn method_ref_receiver_ty(ref: i64) -> i64 { node_f2(ref) }
fn method_ref_type_args(ref: i64) -> i64 { node_f3(ref) }
fn method_ref_is_generic(ref: i64) -> bool { node_f4(ref) % 2 == 1 }
fn method_ref_is_associated(ref: i64) -> bool { node_f4(ref) >= 2 }
fn method_ref_mark_associated(ref: i64) -> i64 {
  method_ref_new_associated(
    method_ref_owner_hash(ref),
    method_ref_receiver_ty(ref),
    method_ref_type_args(ref),
    if method_ref_is_generic(ref) { 1 } else { 0 }
  )
}
fn method_ref_subst(ref: i64, s: i64) -> i64 {
  if s == 0 { ref }
  else {
    node_new(
      70,
      method_ref_owner_hash(ref),
      ty_subst(method_ref_receiver_ty(ref), s),
      type_list_subst(method_ref_type_args(ref), s),
      node_f4(ref)
    )
  }
}

-- ══════════════════════════════════════════════════════════════
-- DNF representation
-- ══════════════════════════════════════════════════════════════
--
-- A DNF clause is a conjunction: (∩ positives) ∩ (∩ ¬negatives)
-- Stored as two lists of type atoms.
--
-- A DNF type is a disjunction of clauses (list of clauses).
-- Stored as a list of clause pointers.
--
-- Clause: 24 bytes [positives_list, negatives_list, 0]
-- Each list is an nlist of type pointers.

fn dnf_clause_new(pos: i64, neg: i64) -> i64 {
  types_storage_dnf_clause_new(pos, neg)
}
fn dnf_clause_pos(c: i64) -> i64 { types_storage_dnf_clause_pos(c) }
fn dnf_clause_neg(c: i64) -> i64 { types_storage_dnf_clause_neg(c) }

-- DNF is a list of clauses
fn dnf_new() -> i64 { nlist_new() }
fn dnf_add_clause(dnf: i64, clause: i64) -> i64 { nlist_add(dnf, clause) }
fn dnf_len(dnf: i64) -> i64 { nlist_len(dnf) }
fn dnf_get(dnf: i64, i: i64) -> i64 { nlist_get(dnf, i) }

-- Single-atom DNF: one clause with one positive atom
fn dnf_atom(ty: i64) -> i64 {
  let pos = nlist_new()
  nlist_add(pos, ty)
  let clause = dnf_clause_new(pos, nlist_new())
  let d = dnf_new()
  dnf_add_clause(d, clause)
  d
}

-- Empty DNF (no clauses = empty type)
fn dnf_empty() -> i64 { dnf_new() }

-- Universal DNF (one clause with no atoms = any type)
fn dnf_any() -> i64 {
  let clause = dnf_clause_new(nlist_new(), nlist_new())
  let d = dnf_new()
  dnf_add_clause(d, clause)
  d
}

-- ══════════════════════════════════════════════════════════════
-- DNF normalization: Type → DNF
-- ══════════════════════════════════════════════════════════════

fn to_dnf(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  match tag {
    0 -> dnf_empty()
    1 -> dnf_any()
    2 -> dnf_atom(ty)
    3 -> dnf_union(to_dnf(ty_f1(ty)), to_dnf(ty_f2(ty)))
    4 -> dnf_intersect(to_dnf(ty_f1(ty)), to_dnf(ty_f2(ty)))
    5 -> dnf_complement(to_dnf(ty_f1(ty)))
    _ -> dnf_atom(ty)
  }
}

-- Union of two DNFs: concatenate clause lists
fn dnf_union(a: i64, b: i64) -> i64 {
  let result = dnf_new()
  let mut i = 0
  while i < dnf_len(a) {
    dnf_add_clause(result, dnf_get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < dnf_len(b) {
    dnf_add_clause(result, dnf_get(b, j))
    j = j + 1
  }
  result
}

-- Intersection of two DNFs: cartesian product of clauses
fn dnf_intersect(a: i64, b: i64) -> i64 {
  let result = dnf_new()
  let mut i = 0
  while i < dnf_len(a) {
    let ca = dnf_get(a, i)
    let mut j = 0
    while j < dnf_len(b) {
      let cb = dnf_get(b, j)
      -- Merge clauses: combine positive and negative lists
      let merged = clause_merge(ca, cb)
      dnf_add_clause(result, merged)
      j = j + 1
    }
    i = i + 1
  }
  result
}

-- Merge two clauses: union their positive and negative atom lists
fn clause_merge(ca: i64, cb: i64) -> i64 {
  let pos = list_concat(dnf_clause_pos(ca), dnf_clause_pos(cb))
  let neg = list_concat(dnf_clause_neg(ca), dnf_clause_neg(cb))
  dnf_clause_new(pos, neg)
}

-- Complement of a DNF: De Morgan's law
-- ¬(C1 ∨ C2 ∨ ...) = ¬C1 ∧ ¬C2 ∧ ...
-- For bootstrap: treat complement conservatively as a single negative atom
fn dnf_complement(inner: i64) -> i64 {
  -- If inner is a single atom clause, negate it directly
  if dnf_len(inner) == 1 {
    let clause = dnf_get(inner, 0)
    let pos = dnf_clause_pos(clause)
    let neg = dnf_clause_neg(clause)
    if nlist_len(pos) == 1 {
      if nlist_len(neg) == 0 {
        -- Simple case: ¬atom → one clause with atom in negative position
        let new_neg = nlist_new()
        nlist_add(new_neg, nlist_get(pos, 0))
        let c = dnf_clause_new(nlist_new(), new_neg)
        let d = dnf_new()
        dnf_add_clause(d, c)
        d
      } else { dnf_complement_general(inner) }
    } else { dnf_complement_general(inner) }
  } else { dnf_complement_general(inner) }
}

-- General complement: ¬(C1 ∨ C2 ∨ ...) = ¬C1 ∧ ¬C2 ∧ ...
-- Each ¬Ci = ¬(P1 ∧ P2 ∧ ... ∧ ¬N1 ∧ ¬N2 ∧ ...) = ¬P1 ∨ ¬P2 ∨ ... ∨ N1 ∨ N2 ∨ ...
-- Then intersect all the negated clauses
fn dnf_complement_general(inner: i64) -> i64 {
  if dnf_len(inner) == 0 { dnf_any() }
  else {
    let mut result = negate_clause(dnf_get(inner, 0))
    let mut i = 1
    while i < dnf_len(inner) {
      result = dnf_intersect(result, negate_clause(dnf_get(inner, i)))
      i = i + 1
    }
    result
  }
}

-- Negate a single clause: ¬(P1 ∧ P2 ∧ ... ∧ ¬N1 ∧ ¬N2 ∧ ...) = ¬P1 ∨ ¬P2 ∨ ... ∨ N1 ∨ N2 ∨ ...
fn negate_clause(clause: i64) -> i64 {
  let pos = dnf_clause_pos(clause)
  let neg = dnf_clause_neg(clause)
  let result = dnf_new()
  -- Each positive atom becomes a clause with that atom in negative position
  let mut i = 0
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let n = nlist_new()
    nlist_add(n, atom)
    dnf_add_clause(result, dnf_clause_new(nlist_new(), n))
    i = i + 1
  }
  -- Each negative atom becomes a clause with that atom in positive position
  let mut j = 0
  while j < nlist_len(neg) {
    let atom = nlist_get(neg, j)
    let p = nlist_new()
    nlist_add(p, atom)
    dnf_add_clause(result, dnf_clause_new(p, nlist_new()))
    j = j + 1
  }
  result
}

-- ══════════════════════════════════════════════════════════════
-- Emptiness check
-- ══════════════════════════════════════════════════════════════

-- A type is empty iff all its DNF clauses are unsatisfiable
fn ty_is_empty(ty: i64) -[Conformance]> bool {
  let tag = ty_tag(ty)
  if tag == 0 { true }
  else {
    let dnf = to_dnf(ty)
    dnf_is_empty(dnf)
  }
}

fn dnf_is_empty(dnf: i64) -[Conformance]> bool {
  if dnf_len(dnf) == 0 { true }
  else {
    let mut i = 0
    let mut all_unsat = true
    while i < dnf_len(dnf) {
      if not clause_is_unsatisfiable(dnf_get(dnf, i)) {
        all_unsat = false
        i = dnf_len(dnf)
      } else { i = i + 1 }
    }
    all_unsat
  }
}

-- A clause (P ∩ ¬N) is unsatisfiable if:
-- 1. Never is in the positive set
-- 2. Two different primitives are in the positive set (disjoint atoms)
-- 3. A concrete type and trait atom are both positive but no conformance exists
-- 4. A concrete type is positive and a trait atom is negative but conformance exists
-- 5. The same atom appears in both positive and negative sets
fn clause_is_unsatisfiable(clause: i64) -[Conformance]> bool {
  let pos = dnf_clause_pos(clause)
  let neg = dnf_clause_neg(clause)

  if has_never_in_pos(pos) { true }
  else { if has_disjoint_prims(pos) { true }
  else { if has_prim_subset_of_neg(pos, neg) { true }
  else { if has_unsat_trait_pos(pos) { true }
  else { if has_unsat_trait_neg(pos, neg) { true }
  else { has_overlap(pos, neg) } } } } }
}

-- Check if a positive set has (concrete_type, trait_atom) that the oracle says don't conform
-- e.g., i64 & Display where i64 doesn't impl Display → unsatisfiable
fn has_unsat_trait_pos(pos: i64) -[Conformance]> bool {
  -- Find concrete type atoms (Prim=tag 2, Named=tag 9) and trait atoms (tag 13) in pos
  let mut concrete_ty = 0
  let mut has_concrete = false
  let mut i = 0
  -- First pass: find a concrete type
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let atag = ty_tag(atom)
    if atag == 2 {
      -- Primitive: use negative prim ID (matching type_name_hash convention)
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { if atag == 9 {
      -- Named type: use name hash
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { i = i + 1 } }
  }
  if not has_concrete { false }
  else {
    -- Second pass: check each trait atom
    let mut j = 0
    let mut result = false
    while j < nlist_len(pos) {
      let atom = nlist_get(pos, j)
      if ty_tag(atom) == 13 {
        let trait_hash = ty_f1(atom)
        -- Ask the oracle: does this concrete type conform to this trait?
        if Conformance.conforms(concrete_ty, trait_hash) == 0 {
          result = true
          j = nlist_len(pos)
        } else { j = j + 1 }
      } else { j = j + 1 }
    }
    result
  }
}

-- Check if (concrete in pos, trait in neg) and conformance EXISTS → unsatisfiable
-- e.g., i64 & ~Display where i64 DOES impl Display → i64 is in Display, contradicts ~Display
fn has_unsat_trait_neg(pos: i64, neg: i64) -[Conformance]> bool {
  -- Find concrete type in positive set
  let mut concrete_ty = 0
  let mut has_concrete = false
  let mut i = 0
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let atag = ty_tag(atom)
    if atag == 2 {
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { if atag == 9 {
      concrete_ty = atom
      has_concrete = true
      i = nlist_len(pos)
    } else { i = i + 1 } }
  }
  if not has_concrete { false }
  else {
    -- Check each trait atom in negative set
    let mut j = 0
    let mut result = false
    while j < nlist_len(neg) {
      let atom = nlist_get(neg, j)
      if ty_tag(atom) == 13 {
        let trait_hash = ty_f1(atom)
        -- If the type DOES conform, then type & ~Trait is empty (contradiction)
        if Conformance.conforms(concrete_ty, trait_hash) == 1 {
          result = true
          j = nlist_len(neg)
        } else { j = j + 1 }
      } else { j = j + 1 }
    }
    result
  }
}

fn has_never_in_pos(pos: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(pos) {
    if ty_tag(nlist_get(pos, i)) == 0 {
      found = true
      i = nlist_len(pos)
    } else { i = i + 1 }
  }
  found
}

-- The primitive subtype lattice: bool = {0, 1} sits inside i64. All other
-- primitives are pairwise disjoint value sets.
fn prim_is_subprim(sub: i64, sup: i64) -> bool {
  sub == PRIM_BOOL() and sup == PRIM_I64()
}

fn prims_overlap(p: i64, q: i64) -> bool {
  p == q or prim_is_subprim(p, q) == 1 or prim_is_subprim(q, p) == 1
}

-- Check if the positive list has two atoms with non-overlapping primitive
-- value sets (bool & i64 is bool, not empty).
fn has_disjoint_prims(pos: i64) -> bool {
  let mut found_prim = 0 - 1
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    let ptag = prim_tag(atom)
    if ptag >= 0 {
      if found_prim >= 0 {
        if prims_overlap(found_prim, ptag) == 0 {
          result = true
          i = nlist_len(pos)
        } else { i = i + 1 }
      } else {
        found_prim = ptag
        i = i + 1
      }
    } else { i = i + 1 }
  }
  result
}

-- A positive prim that is a subset of a negated prim contradicts: e.g.
-- bool & ~i64 is empty because bool ⊆ i64.
fn has_prim_subset_of_neg(pos: i64, neg: i64) -> bool {
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let ptag = prim_tag(nlist_get(pos, i))
    if ptag >= 0 {
      let mut j = 0
      while j < nlist_len(neg) {
        let ntag = prim_tag(nlist_get(neg, j))
        if ntag >= 0 {
          if prim_is_subprim(ptag, ntag) == 1 {
            result = true
            j = nlist_len(neg)
            i = nlist_len(pos)
          } else { j = j + 1 }
        } else { j = j + 1 }
      }
      if result == 0 { i = i + 1 } else { 0 }
    } else { i = i + 1 }
  }
  result
}

-- Assign a unique tag to each primitive type (for disjointness checking)
-- Returns -1 for non-primitive types
fn prim_tag(ty: i64) -> i64 {
  let tag = ty_tag(ty)
  if tag == 2 { ty_f1(ty) }
  else { 0 - 1 }
}

-- Check if any atom appears in both lists
fn has_overlap(pos: i64, neg: i64) -> bool {
  let mut i = 0
  let mut result = false
  while i < nlist_len(pos) {
    let atom = nlist_get(pos, i)
    if list_contains_type(neg, atom) {
      result = true
      i = nlist_len(pos)
    } else { i = i + 1 }
  }
  result
}

-- Check if a list contains a type (structural equality)
fn list_contains_type(list: i64, ty: i64) -> bool {
  let mut i = 0
  let mut found = false
  while i < nlist_len(list) {
    if ty_eq(nlist_get(list, i), ty) {
      found = true
      i = nlist_len(list)
    } else { i = i + 1 }
  }
  found
}

-- Structural type equality
fn ty_eq(a: i64, b: i64) -> bool {
  let ta = ty_tag(a)
  let tb = ty_tag(b)
  if ta != tb { false }
  else {
    match ta {
      0 -> true
      1 -> true
      2 -> ty_f1(a) == ty_f1(b)
      3 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      4 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      5 -> ty_eq(ty_f1(a), ty_f1(b))
      6 -> fn_type_eq(a, b)
      9 -> ty_f1(a) == ty_f1(b) and ty_eq(ty_f2(a), ty_f2(b)) and type_arg_list_eq(ty_f3(a), ty_f3(b))
      12 -> ty_f1(a) == ty_f1(b)
      14 -> ty_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b))
      15 -> ty_f2(a) == ty_f2(b) and ty_eq(ty_f1(a), ty_f1(b))
      16 -> ty_eq(ty_f1(a), ty_f1(b))
      17 -> ty_eq(ty_f1(a), ty_f1(b))
      18 -> ty_eq(ty_f1(a), ty_f1(b))
      19 -> ty_eq(ty_f1(a), ty_f1(b))
      21 -> ty_f2(a) == ty_f2(b) and ty_eq(ty_f1(a), ty_f1(b))
      _ -> a == b
    }
  }
}

fn type_arg_list_eq(a: i64, b: i64) -> bool {
  let a_empty = if a == 0 { true } else { nlist_len(a) == 0 }
  let b_empty = if b == 0 { true } else { nlist_len(b) == 0 }
  if a_empty and b_empty { true }
  else {
    if a_empty or b_empty { false } else { type_list_eq(a, b) }
  }
}

fn type_list_eq(a: i64, b: i64) -> bool {
  let na = nlist_len(a)
  let nb = nlist_len(b)
  if na != nb { false }
  else {
    let mut ok = true
    for i in 0..na {
      if not ty_eq(nlist_get(a, i), nlist_get(b, i)) {
        ok = false
      } else { ok = ok }
    }
    ok
  }
}

fn fn_type_eq(a: i64, b: i64) -> bool {
  type_list_eq(ty_f1(a), ty_f1(b)) and ty_eq(ty_f2(a), ty_f2(b)) and effect_is_subset(ty_f3(a), ty_f3(b)) and effect_is_subset(ty_f3(b), ty_f3(a))
}

fn fn_param_subtypes(actual_params: i64, expected_params: i64) -[Conformance]> bool {
  let na = nlist_len(actual_params)
  let nb = nlist_len(expected_params)
  if na != nb { false }
  else {
    let mut ok = true
    for i in 0..na {
      -- Function parameters are contravariant.
      if not is_subtype(nlist_get(expected_params, i), nlist_get(actual_params, i)) {
        ok = false
      } else { ok = ok }
    }
    ok
  }
}

fn fn_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  fn_param_subtypes(ty_f1(actual), ty_f1(expected)) and is_subtype(ty_f2(actual), ty_f2(expected)) and effect_is_subset(ty_f3(actual), ty_f3(expected))
}

fn continuation_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  is_subtype(ty_f1(expected), ty_f1(actual)) and is_subtype(ty_f2(actual), ty_f2(expected))
}

fn ptr_is_subtype(actual: i64, expected: i64) -[Conformance]> bool {
  if ty_ptr_mutable(expected) == 1 {
    ty_ptr_mutable(actual) == 1 and ty_eq(ty_ptr_inner(actual), ty_ptr_inner(expected))
  } else {
    is_subtype(ty_ptr_inner(actual), ty_ptr_inner(expected))
  }
}

-- ══════════════════════════════════════════════════════════════
-- Subtyping: A <: B iff A & ~B is empty
-- ══════════════════════════════════════════════════════════════

fn is_subtype(a: i64, b: i64) -[Conformance]> bool {
  -- Fast path: reflexivity
  if a == b { true }
  else {
    let ta = ty_tag(a)
    let tb = ty_tag(b)
    -- Never <: anything
    if ta == 0 { true }
    -- anything <: Any
    else { if tb == 1 { true }
    else { if ta == 6 {
      if tb == 6 { fn_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 14 {
      if tb == 14 { continuation_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 15 {
      if tb == 15 { ptr_is_subtype(a, b) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 16 {
      if tb == 16 { is_subtype(ty_weak_inner(a), ty_weak_inner(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 17 {
      if tb == 17 { is_subtype(ty_arc_inner(a), ty_arc_inner(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 18 {
      if tb == 18 { is_subtype(ty_unique_inner(a), ty_unique_inner(b)) }
      else { is_subtype(ty_unique_inner(a), b) }
    }
    else { if ta == 19 {
      if tb == 19 { is_subtype(ty_owned_inner(a), ty_owned_inner(b)) }
      else { is_subtype(ty_owned_inner(a), b) }
    }
    -- Same primitive: equal. bool = {0, 1} is a subset of i64's value set
    -- (true/false ARE the i64 values 1/0 at runtime), so bool <: i64.
    else { if ta == 2 {
      if tb == 2 { ty_f1(a) == ty_f1(b) or prim_is_subprim(ty_f1(a), ty_f1(b)) }
      else { ty_is_empty(ty_inter(a, ty_compl(b))) }
    }
    else { if ta == 9 and ty_is_rc(a) == 1 and tb == 15 and ty_ptr_mutable(b) == 0 {
      is_subtype(ty_rc_inner(a), ty_ptr_inner(b))
    }
    -- rc values are represented as managed heap pointers at runtime.
    else { if ta == 9 and ty_is_rc(a) == 1 and tb == 2 and ty_f1(b) == PRIM_I64() { true }
    -- General case: A & ~B is empty
    else { ty_is_empty(ty_inter(a, ty_compl(b))) } } } } } } } } } } } }
  }
}

-- ══════════════════════════════════════════════════════════════
-- List utilities (concat)
-- ══════════════════════════════════════════════════════════════

fn list_concat(a: i64, b: i64) -> i64 {
  let result = nlist_new()
  let mut i = 0
  while i < nlist_len(a) {
    nlist_add(result, nlist_get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < nlist_len(b) {
    nlist_add(result, nlist_get(b, j))
    j = j + 1
  }
  result
}
