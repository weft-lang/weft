-- source_trust.weft — source-origin trust classification.
--
-- This module is intentionally strict ordinary compiler code. It decides
-- which source paths receive trusted origin, but it does not itself need raw
-- memory capability.

use compiler/lib.{*}

pub(package) fn source_trust_path_eq(path: i64, len: i64, target: str) -> i64 {
  let target_len = __str_len(target)
  if len != target_len { 0 }
  else { src_eq_at(path, 0, __str_ptr(target), 0, target_len) }
}

pub(package) fn source_trust_path_has_prefix(path: i64, len: i64, prefix: str) -> i64 {
  let prefix_len = __str_len(prefix)
  if len < prefix_len { 0 }
  else { src_eq_at(path, 0, __str_ptr(prefix), 0, prefix_len) }
}

pub(package) fn source_trust_path_has_suffix(path: i64, len: i64, suffix: str) -> i64 {
  let suffix_len = __str_len(suffix)
  if len < suffix_len { 0 }
  else { src_eq_at(path, len - suffix_len, __str_ptr(suffix), 0, suffix_len) }
}

-- Transitional compiler TCB: these modules still use raw memory, platform
-- leaves, or source-provenance helpers directly. Pure compiler-as-data modules
-- should stay off this list.
pub(package) fn source_trust_is_compiler_file(path: i64, len: i64) -> i64 {
  0
}

-- Internal ownership notation is narrower than trusted execution. These
-- compiler leaves still carry managed byte-buffer words as `rc i64`, but they
-- remain strict for Unsafe, raw allocation, and trust-grant checks. Delete
-- entries as the compiler's buffer facade gains a nominal managed handle.
pub(package) fn source_trust_allows_internal_ownership(path: i64, len: i64) -> i64 {
  if source_trust_path_eq(path, len, "compiler/macho.weft") == 1 { 1 }
  else { if source_trust_path_eq(path, len, "compiler/object.weft") == 1 { 1 }
  else { source_trust_path_eq(path, len, "compiler/pipeline.weft") } }
}

-- Transitional runtime TCB: current runtime modules are all low-level/raw, but
-- trust is still by explicit file name so new runtime files start strict.
pub(package) fn source_trust_is_runtime_file(path: i64, len: i64) -> i64 {
  source_trust_path_eq(path, len, "runtime/alloc.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/alloc_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/buffer.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/defer_order_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/dir.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/dns.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/effects.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/effects_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/env.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/fiber_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/float.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/iter_state.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/map_storage.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/macho_storage.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/memory.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/object_storage.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/opaque_value_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/par_pool_storage.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/par_pthread.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/par_queue.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/par_sync.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/par_task.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/spawn_task.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/panic.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/pointer_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/process.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/provenance.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/rc.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/rc_census.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/rc_implicit_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/region_promotion_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/shutdown.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/source_acquire.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/string.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/syscall.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/net_poller.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/tcp.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/thread.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/time.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/tool_platform.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/types_storage.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/unsafe.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/unsafe_boundary_test.weft") == 1 or
  source_trust_path_eq(path, len, "runtime/vector_storage.weft") == 1
}

-- Transitional stdlib TCB: only modules that currently encapsulate raw
-- storage/platform operations are trusted. New stdlib modules are strict by
-- default until they are deliberately added here or migrated to safe runtime
-- primitives.
pub(package) fn source_trust_is_stdlib_file(path: i64, len: i64) -> i64 {
  0
}

pub(package) fn source_trust_is_metric_test_root(path: i64, len: i64) -> i64 {
  if source_trust_path_has_prefix(path, len, "test/") == 1 {
    source_trust_path_has_suffix(path, len, "_metrics.weft")
  } else { 0 }
}

pub(package) fn source_trust_is_linked_test_root(path: i64, len: i64) -> i64 {
  source_trust_path_has_prefix(path, len, "test/linked/")
}

-- Exact low-level roots whose subject is trusted RC, region, or continuation
-- cleanup machinery.
-- Keep them here until test discovery can collect test declarations imported
-- from explicitly named runtime test modules.
pub(package) fn source_trust_is_runtime_test_root(path: i64, len: i64) -> i64 {
  if source_trust_path_eq(path, len, "test/runtime_rc.weft") == 1 { 1 }
  else { if source_trust_path_eq(path, len, "test/negative/region_scoped_promote_size_region.weft") == 1 { 1 }
  else { if source_trust_path_eq(path, len, "test/negative/region_scoped_promote_align_region.weft") == 1 { 1 }
  else { if source_trust_path_eq(path, len, "test/negative/deferred_k_non_tail.weft") == 1 { 1 }
  else { source_trust_path_eq(path, len, "test/negative/rc_bind_non_rc.weft") } } } }
}

pub(package) fn source_trust_path_is_trusted_import(path: i64, len: i64) -> i64 {
  if source_trust_is_compiler_file(path, len) == 1 { 1 }
  else { if source_trust_is_runtime_file(path, len) == 1 { 1 }
  else { source_trust_is_stdlib_file(path, len) } }
}

pub(package) fn source_trust_path_can_grant_import_trust(path: i64, len: i64) -> i64 {
  if source_trust_path_eq(path, len, "compiler/parse.weft") == 1 { 1 }
  else { if source_trust_path_eq(path, len, "compiler/pipeline.weft") == 1 { 1 }
  else { source_trust_path_eq(path, len, "compiler/main.weft") } }
}

pub(package) fn source_trust_path_is_trusted_root(path: i64, len: i64) -> i64 {
  if source_trust_path_is_trusted_import(path, len) == 1 { 1 }
  else { if source_trust_is_metric_test_root(path, len) == 1 { 1 }
  else { if source_trust_is_linked_test_root(path, len) == 1 { 1 }
  else { source_trust_is_runtime_test_root(path, len) } } }
}
