-- Numeric spelling and magnitude facts shared by lexing and contextual checks.

use stdlib/source.{Span}
use stdlib/option.{Option, Some, None}
use stdlib/num

pub(package) type NumericRadix { DecimalRadix, HexadecimalRadix, BinaryRadix }
pub(package) type NumericPosition { ExpressionNumber, TuplePositionNumber }
pub(package) type IntegerMagnitude { ExactMagnitude(u64), OversizedMagnitude(u64) }
pub(package) type NumericIssue {
  MissingNumericDigits(usize),
  InvalidNumericDigit(usize),
  InvalidNumericSeparator(usize),
}
pub(package) type NumericScan {
  IntegerSpelling(usize, IntegerMagnitude),
  FloatSpelling(usize),
  InvalidNumericSpelling(usize, NumericIssue),
}

type NumericDigitRun {
  end: usize,
  count: usize,
  magnitude: IntegerMagnitude,
  issue: Option<NumericIssue>,
}

fn numeric_radix_value(radix: NumericRadix) -> u64 {
  match radix { DecimalRadix -> 10, HexadecimalRadix -> 16, BinaryRadix -> 2 }
}

fn numeric_digit(byte: u8, radix: NumericRadix) -> Option<u64> {
  let digit = if byte >= 48 and byte <= 57 { Some<u64>((byte - 48).to_u64()) }
    else if byte >= 65 and byte <= 70 { Some<u64>((byte - 65).to_u64() + 10) }
    else if byte >= 97 and byte <= 102 { Some<u64>((byte - 97).to_u64() + 10) }
    else { None<u64>() }
  match digit {
    Some(value) -> if value < numeric_radix_value(radix) { Some(value) } else { None<u64>() }
    None -> None<u64>()
  }
}

fn numeric_byte_is(source: Span, position: usize, wanted: u8) -> bool {
  match source.byte_at(position) { Some(byte) -> byte == wanted, None -> false }
}

fn numeric_decimal_at(source: Span, position: usize) -> bool {
  match source.byte_at(position) {
    Some(byte) -> byte >= 48 and byte <= 57
    None -> false
  }
}

fn numeric_issue_first(previous: Option<NumericIssue>, next: NumericIssue) -> Option<NumericIssue> {
  match previous { Some(_) -> previous, None -> Some(next) }
}

fn numeric_magnitude_append(magnitude: IntegerMagnitude, digit: u64, radix: NumericRadix) -> IntegerMagnitude {
  match magnitude {
    OversizedMagnitude(bits) -> OversizedMagnitude(bits * numeric_radix_value(radix) + digit)
    ExactMagnitude(value) -> {
      let max: u64 = 18446744073709551615
      let base = numeric_radix_value(radix)
      if value > max / base or (value == max / base and digit > max % base) {
        OversizedMagnitude(value * base + digit)
      } else { ExactMagnitude(value * base + digit) }
    }
  }
}

fn numeric_digits(source: Span, start: usize, radix: NumericRadix, position: NumericPosition) -> NumericDigitRun {
  let mut next = start
  let mut count: usize = 0
  let mut magnitude = ExactMagnitude(0)
  let mut issue = None<NumericIssue>()
  let mut after_separator = false
  let mut walking = true
  while walking {
    match source.byte_at(next) {
      None -> { walking = false }
      Some(byte) -> {
        match numeric_digit(byte, radix) {
          Some(digit) -> {
            magnitude = numeric_magnitude_append(magnitude, digit, radix)
            count = count + 1
            next = next + 1
            after_separator = false
          }
          None -> {
            if byte == 95 {
              let forbidden = match position { ExpressionNumber -> false, TuplePositionNumber -> true }
              if count == 0 or after_separator or forbidden {
                issue = numeric_issue_first(issue, InvalidNumericSeparator(next))
              }
              after_separator = true
              next = next + 1
            } else { walking = false }
          }
        }
      }
    }
  }
  if after_separator { issue = numeric_issue_first(issue, InvalidNumericSeparator(next - 1)) }
  if count == 0 { issue = numeric_issue_first(issue, MissingNumericDigits(start)) }
  NumericDigitRun { end: next, count: count, magnitude: magnitude, issue: issue }
}

fn numeric_identifier_byte(byte: u8) -> bool {
  (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
    (byte >= 97 and byte <= 122) or byte == 95 or byte >= 128
}

-- Consume a malformed suffix as one spelling, rather than accepting a prefix.
fn numeric_suffix_end(source: Span, start: usize) -> usize {
  let mut next = start
  let mut walking = true
  while walking {
    match source.byte_at(next) {
      Some(byte) -> if numeric_identifier_byte(byte) { next = next + 1 } else { walking = false }
      None -> { walking = false }
    }
  }
  next
}

fn numeric_finish_integer(source: Span, digits: NumericDigitRun) -> NumericScan {
  let end = numeric_suffix_end(source, digits.end)
  match digits.issue {
    Some(issue) -> InvalidNumericSpelling(end, issue)
    None -> if end != digits.end { InvalidNumericSpelling(end, InvalidNumericDigit(digits.end)) }
      else { IntegerSpelling(end, digits.magnitude) }
  }
}

fn numeric_finish_float(source: Span, digits: NumericDigitRun) -> NumericScan {
  let end = numeric_suffix_end(source, digits.end)
  match digits.issue {
    Some(issue) -> InvalidNumericSpelling(end, issue)
    None -> if end != digits.end { InvalidNumericSpelling(end, InvalidNumericDigit(digits.end)) }
      else { FloatSpelling(end) }
  }
}

fn numeric_exponent(source: Span, marker: usize) -> NumericScan {
  let sign = marker + 1
  let start = if numeric_byte_is(source, sign, 43) or numeric_byte_is(source, sign, 45) { sign + 1 } else { sign }
  numeric_finish_float(source, numeric_digits(source, start, DecimalRadix, ExpressionNumber))
}

fn numeric_after_decimal(source: Span, digits: NumericDigitRun) -> NumericScan {
  match digits.issue {
    Some(_) -> numeric_finish_integer(source, digits)
    None -> {
      if numeric_byte_is(source, digits.end, 46) and numeric_decimal_at(source, digits.end + 1) {
        let fraction = numeric_digits(source, digits.end + 1, DecimalRadix, ExpressionNumber)
        match fraction.issue {
          Some(_) -> numeric_finish_float(source, fraction)
          None -> if numeric_byte_is(source, fraction.end, 101) or numeric_byte_is(source, fraction.end, 69) {
            numeric_exponent(source, fraction.end)
          } else { numeric_finish_float(source, fraction) }
        }
      } else if numeric_byte_is(source, digits.end, 101) or numeric_byte_is(source, digits.end, 69) {
        numeric_exponent(source, digits.end)
      } else { numeric_finish_integer(source, digits) }
    }
  }
}

pub(package) fn numeric_scan(source: Span, start: usize, position: NumericPosition) -> NumericScan {
  if start >= source.len() { InvalidNumericSpelling(source.len(), MissingNumericDigits(source.len())) }
  else { match position {
    TuplePositionNumber -> numeric_finish_integer(source, numeric_digits(source, start, DecimalRadix, position))
    ExpressionNumber -> {
      if numeric_byte_is(source, start, 48) and numeric_byte_is(source, start + 1, 120) {
        numeric_finish_integer(source, numeric_digits(source, start + 2, HexadecimalRadix, position))
      } else if numeric_byte_is(source, start, 48) and numeric_byte_is(source, start + 1, 98) {
        numeric_finish_integer(source, numeric_digits(source, start + 2, BinaryRadix, position))
      } else { numeric_after_decimal(source, numeric_digits(source, start, DecimalRadix, position)) }
    }
  } }
}

-- Editor grammars consume the same spelling contract; positions deliberately
-- retain their narrower decimal-label language and existing integer node name.
pub(package) fn numeric_integer_pattern() -> str {
  "([0-9](_?[0-9])*|0x[0-9a-fA-F](_?[0-9a-fA-F])*|0b[01](_?[01])*)"
}

pub(package) fn numeric_float_pattern() -> str {
  "([0-9](_?[0-9])*\\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?|[0-9](_?[0-9])*[eE][+-]?[0-9](_?[0-9])*)"
}

pub(package) fn numeric_tuple_position_pattern() -> str { "[0-9]+" }
