-- Weft's semantic grammar interpretation over an assembled module graph.
-- Source acquisition and runtime-prelude selection happen before this pass;
-- the checked grammar receives only host inspection and diagnostics.

use compiler/host_type_checking as host_types
use compiler/host_type_checking.{HostTypeIdentity}
use compiler/grammar_host.{SourceLoader, parse_bind_implicit_prelude_with_loader}
use compiler/pipeline.{AstModule, TypedModule, PipelineCheckPurpose, CheckProgram, pipeline_check_loaded_for, pipeline_bind_runtime_preludes_inner_with_loader}
use stdlib/diagnostic/schema.{Diagnose}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/typecheck.{TypeCheck}

pub(package) type WeftChecker {
  WeftChecker(PipelineCheckPurpose)
}

impl CheckedGrammar for WeftChecker {
  type Syntax = AstModule
  type Checked = TypedModule
  type Identity = HostTypeIdentity

  fn check(self, syntax: AstModule) -[TypeCheck<HostTypeIdentity>, Diagnose]> CheckResult<TypedModule> {
    match self {
      WeftChecker(purpose) -> match syntax {
        AstModule(functions, source, table) -> {
          let errors = pipeline_check_loaded_for(functions, source, table, purpose)
          if errors == 0 { Checked(TypedModule(functions, source, table)) }
          else { CheckRejected<TypedModule>() }
        }
      }
    }
  }
}

-- Install the compiler host adapter around the same public contract available
-- to embedded grammars. The identities it issues remain local to this check.
pub(package) fn check_weft_with(purpose: PipelineCheckPurpose, syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table) ->
      host_types.run(table, source, () => WeftChecker(purpose).check(syntax))
  }
}

pub(package) fn check_weft_program(syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  check_weft_with(CheckProgram, syntax)
}

-- Acquire and bind the module graph before invoking the capability-limited
-- checked grammar. Source acquisition remains outside the public grammar
-- contract, while the resulting host identities stay scoped to this check.
pub(package) fn check_weft_program_with_loader<E>(syntax: AstModule, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table) -> {
      parse_bind_implicit_prelude_with_loader<E>(functions, source, table, loader)
      pipeline_bind_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
      check_weft_program(syntax)
    }
  }
}
