-- Weft's semantic grammar interpretation over an assembled module graph.
-- Source acquisition and runtime-prelude selection happen before this pass;
-- the checked grammar receives only host inspection and diagnostics.

use compiler/host_type_checking as host_types
use compiler/host_type_checking.{HostTypeIdentity}
use compiler/diagnostic_observation.{observe_errors}
use compiler/grammar_host.{parse_bind_implicit_prelude_with_loader}
use compiler/source_loading.{SourceLoader, source_loader_owners}
use compiler/source_owners as source_owners
use compiler/pipeline.{AstModule, TypedModule, PipelineCheckPurpose, CheckProgram, pipeline_check_loaded_for, pipeline_bind_runtime_preludes_inner_with_loader, pipeline_bind_native_runtime_preludes_inner_with_loader, pipeline_bind_rc_census_prelude_with_loader}
use stdlib/diagnostic.{Diagnose}
use stdlib/grammar.{CheckedGrammar, CheckResult, Checked, CheckRejected}
use stdlib/typecheck.{TypeCheck}

pub (package) type WeftChecker {
  WeftChecker(PipelineCheckPurpose)
}

pub (package) type NativeRuntimeSupport { NativeRuntime, NativeRuntimeWithRcCensus }

impl CheckedGrammar for WeftChecker {
  type Syntax = AstModule
  type Checked = TypedModule
  type Identity = HostTypeIdentity

  fn check(self, syntax: AstModule) -[TypeCheck<HostTypeIdentity>, Diagnose]> CheckResult<TypedModule> {
    match self {
      WeftChecker(purpose) -> match syntax {
        AstModule(functions, source, table, owners) -> {
          let errors = pipeline_check_loaded_for(functions, source, table, purpose)
          if errors == 0 { Checked(TypedModule(functions, source, table, owners)) }
          else { CheckRejected<TypedModule>() }
        }
      }
    }
  }
}

-- Install the compiler host adapter around the same public contract available
-- to embedded grammars. The identities it issues remain local to this check.
pub (package) fn check_weft_with(purpose: PipelineCheckPurpose, syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table, owners) ->
      host_types.run(table, source, () => WeftChecker(purpose).check(syntax))
  }
}

pub (package) fn check_weft_program(syntax: AstModule) -[Diagnose]> CheckResult<TypedModule> {
  check_weft_with(CheckProgram, syntax)
}

-- Loading can recover enough syntax to let the semantic checker succeed.
-- Its diagnostics still prevent a checked product from being published. Observe
-- and forward them once, before entering the capability-limited checker.
fn check_weft_after_loading<E>(syntax: AstModule, loader: SourceLoader<E>, load: () -[Diagnose, E]> i64) -[Diagnose, E]> CheckResult<TypedModule> {
  let (_, errors) = observe_errors(load)
  if errors != 0 { CheckRejected<TypedModule>() }
  else { match syntax {
      AstModule(functions, source, table, owners) ->
        check_weft_program(AstModule(functions, source, table, source_owners.combined(owners, source_loader_owners(loader))))
    } }
}

-- Acquire and bind the module graph before invoking the capability-limited
-- checked grammar. Source acquisition remains outside the public grammar
-- contract, while the resulting host identities stay scoped to this check.
pub (package) fn check_weft_program_with_loader<E>(syntax: AstModule, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table, owners) -> {
      let load: () -[Diagnose, E]> i64 = () => {
        parse_bind_implicit_prelude_with_loader<E>(functions, source, table, loader)
        pipeline_bind_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
      }
      check_weft_after_loading(syntax, loader, load)
    }
  }
}

-- Native compilation uses the same checked grammar after installing its
-- compiler-owned runtime support. Preserve the historical binding order while
-- keeping source acquisition outside the CheckedGrammar capability contract.
pub (package) fn check_weft_native_program_with_loader<E>(syntax: AstModule, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  check_weft_native_program_with_support_and_loader(syntax, NativeRuntime, loader)
}

pub (package) fn check_weft_native_program_with_support_and_loader<E>(syntax: AstModule, support: NativeRuntimeSupport, loader: SourceLoader<E>) -[Diagnose, E]> CheckResult<TypedModule> {
  match syntax {
    AstModule(functions, source, table, owners) -> {
      let load: () -[Diagnose, E]> i64 = () => {
        pipeline_bind_native_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
        match support {
          NativeRuntime -> 0
          NativeRuntimeWithRcCensus -> pipeline_bind_rc_census_prelude_with_loader<E>(functions, table, loader)
        }
        parse_bind_implicit_prelude_with_loader<E>(functions, source, table, loader)
        pipeline_bind_runtime_preludes_inner_with_loader<E>(functions, source, table, loader)
      }
      check_weft_after_loading(syntax, loader, load)
    }
  }
}
