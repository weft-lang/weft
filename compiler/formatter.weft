-- compiler/formatter.weft -- shared, lossless parse-only formatting engine
--
-- The formatter owns source text, not typed IR.  This first lossless boundary
-- deliberately preserves every source byte after a successful parse: it makes
-- the public command safe while the canonical token/trivia renderer is built
-- on top of the same result contract.  Invalid/recovered syntax never produces
-- replacement text.

use compiler/diagnose.{diagnose_report_severity_tag}
use compiler/grammar.{*}
use compiler/lex.{*}
use compiler/lib.{src_eq_at}
use compiler/type_registry.{ttable_register_source}
use runtime/buffer.{*}
use runtime/memory.{mem_load8_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic_type.{*}
use stdlib/vector.{*}

pub(package) type FormatterResult {
  FormatterSuccess(str),
  FormatterFailure(i64)
}

type FormatterErrorCount {
  FormatterErrorCount(i64)
}

fn formatter_error_slot_new() -> Vector<FormatterErrorCount> {
  let slot = vector_with_capacity<FormatterErrorCount>(1)
  vector_push<FormatterErrorCount>(slot, FormatterErrorCount(0))
  slot
}

fn formatter_error_slot_get(slot: Vector<FormatterErrorCount>) -> i64 {
  match vector_get_in_bounds<FormatterErrorCount>(slot, 0) {
    FormatterErrorCount(count) -> count
  }
}

fn formatter_error_slot_add(slot: Vector<FormatterErrorCount>) -> nil {
  let count = formatter_error_slot_get(slot)
  vector_set<FormatterErrorCount>(slot, 0, FormatterErrorCount(count + 1))
  nil
}

fn formatter_token_ranges_are_lossless(tokens: i64, source_len: i64) -> bool {
  let count = tok_count(tokens)
  let mut previous_end = 0
  let mut valid = true
  let mut i = 0
  while i < count and valid {
    let start = tok_span(tokens, i)
    let end = tok_end(tokens, i)
    if start < previous_end or end < start or end > source_len {
      valid = false
    } else {
      -- Zero-width ranges are reserved for the EOF sentinel and synthetic
      -- auto-semicolons. Every source token must retain at least one byte.
      if end == start and not (tok_tag(tokens, i) == 7 or (tok_tag(tokens, i) == 5 and tok_v1(tokens, i) == 13)) {
        valid = false
      } else { 0 }
      if end > previous_end { previous_end = end } else { 0 }
      i = i + 1
    }
  }
  valid
}

fn formatter_gap_is_attached_trivia(src: i64, start: i64, end: i64) -> bool {
  let mut i = start
  let mut attached = false
  while i < end and not attached {
    if src_eq_at(src, i, __str_ptr("\n"), 0, 1) == 1 or src_eq_at(src, i, __str_ptr("\r"), 0, 1) == 1 {
      attached = true
    } else { if i + 1 < end and src_eq_at(src, i, __str_ptr("--"), 0, 2) == 1 {
      attached = true
    } else {
      i = i + 1
    } }
  }
  attached
}

fn formatter_next_source_token(tokens: i64, current: i64) -> i64 {
  let count = tok_count(tokens)
  let mut i = current
  while i < count and tok_end(tokens, i) == tok_span(tokens, i) and tok_tag(tokens, i) != 7 {
    i = i + 1
  }
  i
}

fn formatter_gap_indent_depth(tokens: i64, previous: i64, current: i64, depth: i64) -> i64 {
  let next = formatter_next_source_token(tokens, current)
  let closing_curly = next < tok_count(tokens) and tok_tag(tokens, next) == 5 and tok_v1(tokens, next) == 4
  let base = if closing_curly and depth > 0 { depth - 1 } else { depth }
  if next >= tok_count(tokens) or tok_tag(tokens, next) == 7 { return base } else { 0 }
  -- A zero-width auto-semicolon proves the newline separates statements.
  if next != current { return base } else { 0 }
  let next_tag = tok_tag(tokens, next)
  let next_value = tok_v1(tokens, next)
  if next_tag == 5 and (next_value == 2 or next_value == 4 or next_value == 14) { return base } else { 0 }
  if next_tag == 3 and next_value == 4 { return base } else { 0 } -- else
  if previous < 0 { return base } else { 0 }
  if tok_tag(tokens, previous) == 5 and tok_v1(tokens, previous) == 3 { return base } else { 0 } -- {
  -- No separator and no block boundary means the source newline continues an
  -- expression/signature. Give every continuation one stable extra level.
  base + 1
}

fn formatter_append_indent(out: i64, depth: i64) -> i64 {
  let mut i = 0
  while i < depth * 2 {
    bu8(out, 32)
    i = i + 1
  }
  out
}

fn formatter_gap_is_hspace(src: i64, index: i64) -> bool {
  let byte = mem_load8_at(src, index)
  byte == 32 or byte == 9
}

fn formatter_gap_is_newline(src: i64, index: i64) -> bool {
  let byte = mem_load8_at(src, index)
  byte == 10 or byte == 13
}

fn formatter_comment_end(src: i64, start: i64, end: i64) -> i64 {
  let mut i = start
  while i < end and not formatter_gap_is_newline(src, i) { i = i + 1 }
  i
}

fn formatter_append_trivia_gap(out: i64, src: i64, start: i64, end: i64, tokens: i64, previous: i64, current: i64, depth: i64) -> i64 {
  let target_depth = formatter_gap_indent_depth(tokens, previous, current, depth)
  let next = formatter_next_source_token(tokens, current)
  let comment_depth = if next < tok_count(tokens) and tok_tag(tokens, next) == 5 and tok_v1(tokens, next) == 4 { depth } else { target_depth }
  let mut i = start
  let mut line_start = previous < 0
  while i < end {
    if formatter_gap_is_hspace(src, i) {
      -- Horizontal trivia is reconstructed at the next comment/token edge.
      i = i + 1
    } else { if not formatter_gap_is_newline(src, i) {
      -- The lexer has already proved this gap is trivia. Treat every
      -- non-whitespace run as opaque comment text so future trivia forms and
      -- arbitrary comment bytes can never be rewritten destructively.
      if line_start { formatter_append_indent(out, comment_depth) } else { bstr(out, " ") }
      let comment_end = formatter_comment_end(src, i, end)
      bscopy(out, src + i, comment_end - i, 0)
      i = comment_end
      line_start = false
    } else { if mem_load8_at(src, i) == 13 {
      bscopy(out, src + i, 1, 0)
      i = i + 1
      if i < end and mem_load8_at(src, i) == 10 {
        bscopy(out, src + i, 1, 0)
        i = i + 1
      } else { 0 }
      line_start = true
    } else { if mem_load8_at(src, i) == 10 {
      bscopy(out, src + i, 1, 0)
      i = i + 1
      line_start = true
    } else { 0 } } } }
  }
  if line_start { formatter_append_indent(out, target_depth) } else { out }
}

fn formatter_punct_attaches_left(value: i64) -> bool {
  value == 2 or value == 5 or value == 6 or value == 8 or
    value == 12 or value == 13 or value == 14 or value == 15
}

fn formatter_punct_attaches_right(value: i64) -> bool {
  value == 1 or value == 8 or value == 11 or value == 15 or
    value == 16 or value == 17
}

fn formatter_token_can_precede_postfix(tokens: i64, index: i64) -> bool {
  let tag = tok_tag(tokens, index)
  if tag == 1 or tag == 2 or tag == 8 or tag == 9 or tag == 13 { true }
  else { if tag == 5 {
    let value = tok_v1(tokens, index)
    value == 2 or value == 4 or value == 12 or value == 14
  } else {
    (tag == 4 and tok_v1(tokens, index) == 8 and tok_syntax_role(tokens, index) == tok_syntax_role_generic_angle()) or
      (tag == 3 and tok_v1(tokens, index) == 25)
  } }
}

fn formatter_gap_wants_space(tokens: i64, previous: i64, current: i64) -> bool {
  if previous < 0 or tok_tag(tokens, current) == 7 { return false } else { 0 }
  let prev_tag = tok_tag(tokens, previous)
  let prev_value = tok_v1(tokens, previous)
  let current_tag = tok_tag(tokens, current)
  let current_value = tok_v1(tokens, current)
  let current_role = tok_syntax_role(tokens, current)
  let prev_role = tok_syntax_role(tokens, previous)
  if current_tag == 4 and current_role == tok_syntax_role_generic_angle() and (current_value == 7 or current_value == 8) { return false } else { 0 }
  if prev_tag == 4 and prev_role == tok_syntax_role_generic_angle() and prev_value == 7 { return false } else { 0 }
  if current_role == tok_syntax_role_module_path() or prev_role == tok_syntax_role_module_path() { return false } else { 0 }
  if current_role == tok_syntax_role_effect_close() or prev_tag == 11 { return false } else { 0 }
  if current_role == tok_syntax_role_import_selection() or prev_role == tok_syntax_role_import_selection() { return false } else { 0 }
  if (current_tag == 4 and current_value == 20) or (prev_tag == 4 and prev_value == 20) { return false } else { 0 }
  if current_tag == 5 and formatter_punct_attaches_left(current_value) { return false } else { 0 }
  if prev_tag == 5 and formatter_punct_attaches_right(prev_value) { return false } else { 0 }
  -- Calls/indexing attach to the preceding value, but a keyword followed by
  -- explicit grouping remains visually separated (`if (cond)`).
  if current_tag == 5 and (current_value == 1 or current_value == 17) {
    not formatter_token_can_precede_postfix(tokens, previous)
  } else { true }
}

fn formatter_append_gap(out: i64, src: i64, start: i64, end: i64, tokens: i64, previous: i64, current: i64, depth: i64) -> i64 {
  if end <= start { return out } else { 0 }
  if formatter_gap_is_attached_trivia(src, start, end) {
    -- Rebuild only whitespace around comments; comment bytes and newline
    -- spelling/count retain exact source order.
    return formatter_append_trivia_gap(out, src, start, end, tokens, previous, current, depth)
  } else { 0 }
  if formatter_gap_wants_space(tokens, previous, current) {
    bstr(out, " ")
  } else { out }
}

pub(package) fn formatter_render_tokens(src: i64, source_len: i64, tokens: i64) -> str {
  let out = buf_new(source_len + 32)
  let count = tok_count(tokens)
  let mut previous = 0 - 1
  let mut previous_end = 0
  let mut depth = 0
  for i in 0..count {
    let start = tok_span(tokens, i)
    let end = tok_end(tokens, i)
    formatter_append_gap(out, src, previous_end, start, tokens, previous, i, depth)
    if end > start {
      bscopy(out, src + start, end - start, 0)
    } else { 0 }
    if end > previous_end { previous_end = end } else { 0 }
    if end > start and tok_tag(tokens, i) == 5 {
      let value = tok_v1(tokens, i)
      if value == 3 { depth = depth + 1 }
      else { if value == 4 and depth > 0 { depth = depth - 1 } else { 0 } }
    } else { 0 }
    previous = i
  }
  runtime_str_from_bytes_copy(buf_ptr(out), buf_len(out))
}

fn formatter_token_text_equal(left_src: i64, left_tokens: i64, left_index: i64, right_src: i64, right_tokens: i64, right_index: i64) -> bool {
  let left_start = tok_span(left_tokens, left_index)
  let left_len = tok_end(left_tokens, left_index) - left_start
  let right_start = tok_span(right_tokens, right_index)
  let right_len = tok_end(right_tokens, right_index) - right_start
  left_len == right_len and (left_len == 0 or src_eq_at(left_src, left_start, right_src + right_start, 0, left_len) == 1)
}

fn formatter_token_payload_equal(left_tokens: i64, left_index: i64, right_tokens: i64, right_index: i64) -> bool {
  let tag = tok_tag(left_tokens, left_index)
  -- Identifiers and literal payloads contain source-relative pointers; exact
  -- lexeme comparison below is their stable equality. Keyword/operator/
  -- punctuation/bool payloads are semantic ids and must match directly.
  if tag == 3 or tag == 4 or tag == 5 or tag == 9 {
    tok_v1(left_tokens, left_index) == tok_v1(right_tokens, right_index)
  } else { true }
}

pub(package) fn formatter_tokens_equivalent(left_src: i64, left_tokens: i64, right_src: i64, right_tokens: i64) -> bool {
  let count = tok_count(left_tokens)
  if count != tok_count(right_tokens) { false }
  else {
    let mut same = true
    let mut i = 0
    while i < count and same {
      if tok_tag(left_tokens, i) != tok_tag(right_tokens, i) or not formatter_token_payload_equal(left_tokens, i, right_tokens, i) {
        same = false
      } else { if not formatter_token_text_equal(left_src, left_tokens, i, right_src, right_tokens, i) {
        same = false
      } else {
        i = i + 1
      } }
    }
    same
  }
}

-- Parse under an audit handler that forwards every structured diagnostic to
-- the caller while retaining only the fatal count needed for fail-closed
-- emission.  Warnings and notes do not suppress otherwise valid output.
pub(package) fn formatter_format_source(src: i64, n: i64, tt: i64) -[Diagnose]> FormatterResult {
  let grammar = weft_grammar()
  ttable_register_source(tt, src, n, 0, 0)
  let tokens = grammar.lex(src, n)
  let errors = formatter_error_slot_new()
  let _ = handle grammar.parse_tokens(tokens, src, tt) {
    Diagnose.report(diagnostic) -> {
      if diagnose_report_severity_tag(diagnostic) == 1 { formatter_error_slot_add(errors) } else { nil }
      Diagnose.report(diagnostic)
      resume(0)
    }
    Diagnose.error(msg, span) -> {
      formatter_error_slot_add(errors)
      Diagnose.error(msg, span)
      resume(0)
    }
    Diagnose.warn(msg, span) -> {
      Diagnose.warn(msg, span)
      resume(0)
    }
    Diagnose.note(msg, span) -> {
      Diagnose.note(msg, span)
      resume(0)
    }
  }
  let count = formatter_error_slot_get(errors)
  if count > 0 {
    FormatterFailure(count)
  } else { if not formatter_token_ranges_are_lossless(tokens, n) {
    Diagnose.error("formatter: invalid lossless token range", src)
    FormatterFailure(1)
  } else {
    let formatted = formatter_render_tokens(src, n, tokens)
    let formatted_src = __str_ptr(formatted)
    let formatted_len = __str_len(formatted)
    let formatted_tokens = grammar.lex(formatted_src, formatted_len)
    if formatter_tokens_equivalent(src, tokens, formatted_src, formatted_tokens) {
      FormatterSuccess(formatted)
    } else {
      Diagnose.error("formatter: token-preservation check failed", src)
      FormatterFailure(1)
    }
  } }
}
