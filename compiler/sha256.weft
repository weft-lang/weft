-- compiler/sha256.weft — SHA-256 implementation for code signing
-- Reference: FIPS 180-4

use "runtime/alloc.weft"

-- SHA-256 initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
fn sha256_h0() -> i64 { 1779033703 }
fn sha256_h1() -> i64 { 3144134277 }
fn sha256_h2() -> i64 { 1013904242 }
fn sha256_h3() -> i64 { 2773480762 }
fn sha256_h4() -> i64 { 1359893119 }
fn sha256_h5() -> i64 { 2600822924 }
fn sha256_h6() -> i64 { 528734635 }
fn sha256_h7() -> i64 { 1541459225 }

-- SHA-256 round constants (first 32 bits of fractional parts of cube roots of first 64 primes)
fn sha256_k_init(k: i64) -> i64 {
  __mem_store64(k, 1116352408) __mem_store64(k + 8, 1899447441)
  __mem_store64(k + 16, 3049323471) __mem_store64(k + 24, 3921009573)
  __mem_store64(k + 32, 961987163) __mem_store64(k + 40, 1508970993)
  __mem_store64(k + 48, 2453635748) __mem_store64(k + 56, 2870763221)
  __mem_store64(k + 64, 3624381080) __mem_store64(k + 72, 310598401)
  __mem_store64(k + 80, 607225278) __mem_store64(k + 88, 1426881987)
  __mem_store64(k + 96, 1925078388) __mem_store64(k + 104, 2162078206)
  __mem_store64(k + 112, 2614888103) __mem_store64(k + 120, 3248222580)
  sha256_k_init2(k)
}
fn sha256_k_init2(k: i64) -> i64 {
  __mem_store64(k + 128, 3835390401) __mem_store64(k + 136, 4022224774)
  __mem_store64(k + 144, 264347078) __mem_store64(k + 152, 604807628)
  __mem_store64(k + 160, 770255983) __mem_store64(k + 168, 1249150122)
  __mem_store64(k + 176, 1555081692) __mem_store64(k + 184, 1996064986)
  __mem_store64(k + 192, 2554220882) __mem_store64(k + 200, 2821834349)
  __mem_store64(k + 208, 2952996808) __mem_store64(k + 216, 3210313671)
  __mem_store64(k + 224, 3336571891) __mem_store64(k + 232, 3584528711)
  __mem_store64(k + 240, 113926993) __mem_store64(k + 248, 338241895)
  sha256_k_init3(k)
}
fn sha256_k_init3(k: i64) -> i64 {
  __mem_store64(k + 256, 666307205) __mem_store64(k + 264, 773529912)
  __mem_store64(k + 272, 1294757372) __mem_store64(k + 280, 1396182291)
  __mem_store64(k + 288, 1695183700) __mem_store64(k + 296, 1986661051)
  __mem_store64(k + 304, 2177026350) __mem_store64(k + 312, 2456956037)
  __mem_store64(k + 320, 2730485921) __mem_store64(k + 328, 2820302411)
  __mem_store64(k + 336, 3259730800) __mem_store64(k + 344, 3345764771)
  __mem_store64(k + 352, 3516065817) __mem_store64(k + 360, 3600352804)
  __mem_store64(k + 368, 4094571909) __mem_store64(k + 376, 275423344)
  sha256_k_init4(k)
}
fn sha256_k_init4(k: i64) -> i64 {
  __mem_store64(k + 384, 430227734) __mem_store64(k + 392, 506948616)
  __mem_store64(k + 400, 659060556) __mem_store64(k + 408, 883997877)
  __mem_store64(k + 416, 958139571) __mem_store64(k + 424, 1322822218)
  __mem_store64(k + 432, 1537002063) __mem_store64(k + 440, 1747873779)
  __mem_store64(k + 448, 1955562222) __mem_store64(k + 456, 2024104815)
  __mem_store64(k + 464, 2227730452) __mem_store64(k + 472, 2361852424)
  __mem_store64(k + 480, 2428436474) __mem_store64(k + 488, 2756734187)
  __mem_store64(k + 496, 3204031479) __mem_store64(k + 504, 3329325298)
  0
}

-- 32-bit operations (mask to 32 bits)
fn u32(x: i64) -> i64 { x band 4294967295 }
fn rotr32(x: i64, n: i64) -> i64 { u32(u32(x) bshr n bor (u32(x) bshl (32 - n))) }
fn shr32(x: i64, n: i64) -> i64 { u32(x) bshr n }

-- SHA-256 functions
fn ch(x: i64, y: i64, z: i64) -> i64 { u32((x band y) bxor ((u32(x) bxor 4294967295) band z)) }
fn maj(x: i64, y: i64, z: i64) -> i64 { u32((x band y) bxor (x band z) bxor (y band z)) }
fn bsig0(x: i64) -> i64 { u32(rotr32(x, 2) bxor rotr32(x, 13) bxor rotr32(x, 22)) }
fn bsig1(x: i64) -> i64 { u32(rotr32(x, 6) bxor rotr32(x, 11) bxor rotr32(x, 25)) }
fn ssig0(x: i64) -> i64 { u32(rotr32(x, 7) bxor rotr32(x, 18) bxor shr32(x, 3)) }
fn ssig1(x: i64) -> i64 { u32(rotr32(x, 17) bxor rotr32(x, 19) bxor shr32(x, 10)) }

-- Read big-endian u32 from buffer
fn read_be32(buf: i64, off: i64) -> i64 {
  __mem_load8(buf + off) * 16777216 + __mem_load8(buf + off + 1) * 65536 + __mem_load8(buf + off + 2) * 256 + __mem_load8(buf + off + 3)
}

-- Write big-endian u32 to buffer
fn write_be32(buf: i64, off: i64, val: i64) -> i64 {
  let v = u32(val)
  __mem_store8(buf + off, v bshr 24)
  __mem_store8(buf + off + 1, (v bshr 16) band 255)
  __mem_store8(buf + off + 2, (v bshr 8) band 255)
  __mem_store8(buf + off + 3, v band 255)
}

-- Process one 64-byte block, updating state (8 u32s stored as i64s)
fn sha256_block(state: i64, block: i64, k: i64) -> i64 {
  -- Expand message schedule (W[0..63])
  let w = alloc_bump(512)
  let mut i = 0
  while i < 16 { __mem_store64(w + i * 8, read_be32(block, i * 4)) i = i + 1 }
  while i < 64 {
    let s0 = ssig0(__mem_load64(w + (i - 15) * 8))
    let s1 = ssig1(__mem_load64(w + (i - 2) * 8))
    __mem_store64(w + i * 8, u32(__mem_load64(w + (i - 16) * 8) + s0 + __mem_load64(w + (i - 7) * 8) + s1))
    i = i + 1
  }
  -- Initialize working variables
  let mut a = __mem_load64(state)
  let mut b = __mem_load64(state + 8)
  let mut c = __mem_load64(state + 16)
  let mut d = __mem_load64(state + 24)
  let mut e = __mem_load64(state + 32)
  let mut f = __mem_load64(state + 40)
  let mut g = __mem_load64(state + 48)
  let mut h = __mem_load64(state + 56)
  -- 64 rounds
  let mut r = 0
  while r < 64 {
    let t1 = u32(h + bsig1(e) + ch(e, f, g) + __mem_load64(k + r * 8) + __mem_load64(w + r * 8))
    let t2 = u32(bsig0(a) + maj(a, b, c))
    h = g g = f f = e e = u32(d + t1) d = c c = b b = a a = u32(t1 + t2)
    r = r + 1
  }
  -- Add compressed chunk to state
  __mem_store64(state, u32(__mem_load64(state) + a))
  __mem_store64(state + 8, u32(__mem_load64(state + 8) + b))
  __mem_store64(state + 16, u32(__mem_load64(state + 16) + c))
  __mem_store64(state + 24, u32(__mem_load64(state + 24) + d))
  __mem_store64(state + 32, u32(__mem_load64(state + 32) + e))
  __mem_store64(state + 40, u32(__mem_load64(state + 40) + f))
  __mem_store64(state + 48, u32(__mem_load64(state + 48) + g))
  __mem_store64(state + 56, u32(__mem_load64(state + 56) + h))
  0
}

-- SHA-256 hash with pre-allocated K constants
fn sha256_with_k(data: i64, len: i64, out: i64, k: i64) -> i64 {
  -- Initialize state
  let state = alloc_bump(64)
  __mem_store64(state, sha256_h0())
  __mem_store64(state + 8, sha256_h1())
  __mem_store64(state + 16, sha256_h2())
  __mem_store64(state + 24, sha256_h3())
  __mem_store64(state + 32, sha256_h4())
  __mem_store64(state + 40, sha256_h5())
  __mem_store64(state + 48, sha256_h6())
  __mem_store64(state + 56, sha256_h7())
  -- Process full 64-byte blocks
  let mut off = 0
  while off + 64 <= len {
    sha256_block(state, data + off, k)
    off = off + 64
  }
  -- Padding: copy remaining bytes + 0x80 + zeros + length
  let pad = alloc_bump(128)
  let rem = len - off
  let mut pi = 0
  while pi < rem { __mem_store8(pad + pi, __mem_load8(data + off + pi)) pi = pi + 1 }
  __mem_store8(pad + rem, 128)
  let mut pj = rem + 1
  -- Determine if we need 1 or 2 blocks for padding
  let pad_blocks = if rem >= 56 { 2 } else { 1 }
  let total_pad = pad_blocks * 64
  while pj < total_pad { __mem_store8(pad + pj, 0) pj = pj + 1 }
  -- Write length in bits as big-endian u64 at end
  let bit_len = len * 8
  write_be32(pad, total_pad - 4, bit_len)
  write_be32(pad, total_pad - 8, bit_len bshr 32)
  -- Process padding block(s)
  sha256_block(state, pad, k)
  if pad_blocks == 2 { sha256_block(state, pad + 64, k) } else { 0 }
  -- Write output
  let mut oi = 0
  while oi < 8 { write_be32(out, oi * 4, __mem_load64(state + oi * 8)) oi = oi + 1 }
  0
}

fn sha256(data: i64, len: i64, out: i64) -> i64 {
  let k = alloc_bump(512)
  sha256_k_init(k)
  sha256_with_k(data, len, out, k)
}
