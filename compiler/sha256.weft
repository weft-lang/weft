-- compiler/sha256.weft — SHA-256 implementation for code signing
-- Reference: FIPS 180-4

use "runtime/alloc.weft"
use "runtime/memory.weft"

-- SHA-256 initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
fn sha256_h0() -> i64 { 1779033703 }
fn sha256_h1() -> i64 { 3144134277 }
fn sha256_h2() -> i64 { 1013904242 }
fn sha256_h3() -> i64 { 2773480762 }
fn sha256_h4() -> i64 { 1359893119 }
fn sha256_h5() -> i64 { 2600822924 }
fn sha256_h6() -> i64 { 528734635 }
fn sha256_h7() -> i64 { 1541459225 }

-- SHA-256 round constants (first 32 bits of fractional parts of cube roots of
-- the first 64 primes). This is immutable compiler data, not a raw buffer.
fn sha256_k_values() -> [i64; 64] {
  [1116352408, 1899447441, 3049323471, 3921009573,
   961987163, 1508970993, 2453635748, 2870763221,
   3624381080, 310598401, 607225278, 1426881987,
   1925078388, 2162078206, 2614888103, 3248222580,
   3835390401, 4022224774, 264347078, 604807628,
   770255983, 1249150122, 1555081692, 1996064986,
   2554220882, 2821834349, 2952996808, 3210313671,
   3336571891, 3584528711, 113926993, 338241895,
   666307205, 773529912, 1294757372, 1396182291,
   1695183700, 1986661051, 2177026350, 2456956037,
   2730485921, 2820302411, 3259730800, 3345764771,
   3516065817, 3600352804, 4094571909, 275423344,
   430227734, 506948616, 659060556, 883997877,
   958139571, 1322822218, 1537002063, 1747873779,
   1955562222, 2024104815, 2227730452, 2361852424,
   2428436474, 2756734187, 3204031479, 3329325298]
}

-- 32-bit operations (mask to 32 bits)
fn u32(x: i64) -> i64 { x band 4294967295 }
fn rotr32(x: i64, n: i64) -> i64 { u32(u32(x) bshr n bor (u32(x) bshl (32 - n))) }
fn shr32(x: i64, n: i64) -> i64 { u32(x) bshr n }

-- SHA-256 functions
fn ch(x: i64, y: i64, z: i64) -> i64 { u32((x band y) bxor ((u32(x) bxor 4294967295) band z)) }
fn maj(x: i64, y: i64, z: i64) -> i64 { u32((x band y) bxor (x band z) bxor (y band z)) }
fn bsig0(x: i64) -> i64 { u32(rotr32(x, 2) bxor rotr32(x, 13) bxor rotr32(x, 22)) }
fn bsig1(x: i64) -> i64 { u32(rotr32(x, 6) bxor rotr32(x, 11) bxor rotr32(x, 25)) }
fn ssig0(x: i64) -> i64 { u32(rotr32(x, 7) bxor rotr32(x, 18) bxor shr32(x, 3)) }
fn ssig1(x: i64) -> i64 { u32(rotr32(x, 17) bxor rotr32(x, 19) bxor shr32(x, 10)) }

-- Read big-endian u32 from buffer
fn read_be32(buf: i64, off: i64) -> i64 {
  mem_load8_at(buf, off) * 16777216 + mem_load8_at(buf, off + 1) * 65536 + mem_load8_at(buf, off + 2) * 256 + mem_load8_at(buf, off + 3)
}

-- Write big-endian u32 to buffer
fn write_be32(buf: i64, off: i64, val: i64) -> i64 {
  let v = u32(val)
  mem_store8_at(buf, off, v bshr 24)
  mem_store8_at(buf, off + 1, (v bshr 16) band 255)
  mem_store8_at(buf, off + 2, (v bshr 8) band 255)
  mem_store8_at(buf, off + 3, v band 255)
}

-- Process one 64-byte block, updating state (8 u32s stored as i64s)
fn sha256_block(state: [mut i64], block: i64, k: [i64; 64]) -> i64 {
  -- Expand message schedule (W[0..63])
  let w = alloc_words(64)
  let mut i = 0
  while i < 16 { mem_store64_at(w, i * 8, read_be32(block, i * 4)) i = i + 1 }
  while i < 64 {
    let s0 = ssig0(mem_load64_at(w, (i - 15) * 8))
    let s1 = ssig1(mem_load64_at(w, (i - 2) * 8))
    mem_store64_at(w, i * 8, u32(mem_load64_at(w, (i - 16) * 8) + s0 + mem_load64_at(w, (i - 7) * 8) + s1))
    i = i + 1
  }
  -- Initialize working variables
  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]
  -- 64 rounds
  let mut r = 0
  while r < 64 {
    let t1 = u32(h + bsig1(e) + ch(e, f, g) + k[__i64_to_usize(r)] + mem_load64_at(w, r * 8))
    let t2 = u32(bsig0(a) + maj(a, b, c))
    h = g g = f f = e e = u32(d + t1) d = c c = b b = a a = u32(t1 + t2)
    r = r + 1
  }
  -- Add compressed chunk to state
  state[0] = u32(state[0] + a)
  state[1] = u32(state[1] + b)
  state[2] = u32(state[2] + c)
  state[3] = u32(state[3] + d)
  state[4] = u32(state[4] + e)
  state[5] = u32(state[5] + f)
  state[6] = u32(state[6] + g)
  state[7] = u32(state[7] + h)
  0
}

-- SHA-256 hash with pre-allocated K constants
fn sha256_with_k(data: i64, len: i64, out: i64, k: [i64; 64]) -> i64 {
  -- Initialize state
  let mut state: [i64; 8] = [sha256_h0(), sha256_h1(), sha256_h2(), sha256_h3(), sha256_h4(), sha256_h5(), sha256_h6(), sha256_h7()]
  -- Process full 64-byte blocks
  let mut off = 0
  while off + 64 <= len {
    sha256_block(state[..], data + off, k)
    off = off + 64
  }
  -- Padding: copy remaining bytes + 0x80 + zeros + length
  let pad = alloc_words(16)
  let rem = len - off
  let mut pi = 0
  while pi < rem { mem_store8_at(pad, pi, mem_load8_at(data, off + pi)) pi = pi + 1 }
  mem_store8_at(pad, rem, 128)
  let mut pj = rem + 1
  -- Determine if we need 1 or 2 blocks for padding
  let pad_blocks = if rem >= 56 { 2 } else { 1 }
  let total_pad = pad_blocks * 64
  while pj < total_pad { mem_store8_at(pad, pj, 0) pj = pj + 1 }
  -- Write length in bits as big-endian u64 at end
  let bit_len = len * 8
  write_be32(pad, total_pad - 4, bit_len)
  write_be32(pad, total_pad - 8, bit_len bshr 32)
  -- Process padding block(s)
  sha256_block(state[..], pad, k)
  if pad_blocks == 2 { sha256_block(state[..], pad + 64, k) } else { 0 }
  -- Write output
  let mut oi = 0
  while oi < 8 { write_be32(out, oi * 4, state[__i64_to_usize(oi)]) oi = oi + 1 }
  0
}

fn sha256(data: i64, len: i64, out: i64) -> i64 {
  let k = sha256_k_values()
  sha256_with_k(data, len, out, k)
}
