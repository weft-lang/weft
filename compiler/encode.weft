-- encode.weft — aarch64 instruction encoders

use "compiler/lib.weft"

fn encode_movz(rd: i64, imm16: i64, shift: i64) -> i64 {
  let hw = shift / 16
  3531603968 + hw * 2097152 + imm16 * 32 + rd
}
fn encode_movk(rd: i64, imm16: i64, shift: i64) -> i64 {
  -- MOVK: 0xF2800000 = 4068474880
  let hw = shift / 16
  4068474880 + hw * 2097152 + imm16 * 32 + rd
}
fn encode_add_imm(rd: i64, rn: i64, imm12: i64) -> i64 {
  2432696320 + imm12 * 1024 + rn * 32 + rd
}
fn encode_add_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  2332033024 + rm * 65536 + rn * 32 + rd
}
fn encode_sub_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  3405774848 + rm * 65536 + rn * 32 + rd
}
fn encode_mul(rd: i64, rn: i64, rm: i64) -> i64 {
  -- MUL: 0x9B007C00 = 2600500224
  2600500224 + rm * 65536 + rn * 32 + rd
}
fn encode_sdiv(rd: i64, rn: i64, rm: i64) -> i64 {
  -- SDIV: 0x9AC00C00 = 2596277248
  2596277248 + rm * 65536 + rn * 32 + rd
}
fn encode_msub(rd: i64, rn: i64, rm: i64, ra: i64) -> i64 {
  -- MSUB Xd, Xn, Xm, Xa: rd = ra - rn*rm
  -- 0x9B008000 = 2600501248
  2600501248 + rm * 65536 + ra * 1024 + rn * 32 + rd
}
fn encode_and_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  -- AND: 0x8A000000 = 2315255808
  2315255808 + rm * 65536 + rn * 32 + rd
}
fn encode_orr_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  -- ORR: 0xAA000000 = 2852126720
  2852126720 + rm * 65536 + rn * 32 + rd
}
fn encode_eor_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  -- EOR: 0xCA000000 = 3388997632
  3388997632 + rm * 65536 + rn * 32 + rd
}
fn encode_lsl_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  -- LSL (LSLV): 0x9AC02000 = 2596282368
  2596282368 + rm * 65536 + rn * 32 + rd
}
fn encode_asr_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  -- ASR (ASRV): 0x9AC02800 = 2596284416
  2596284416 + rm * 65536 + rn * 32 + rd
}
fn encode_cmp(rn: i64, rm: i64) -> i64 {
  -- CMP: 0xEB00001F = 3942645791
  3942645791 + rm * 65536 + rn * 32
}
fn encode_cset(rd: i64, cond: i64) -> i64 {
  -- CSET: 0x9A9F07E0 = 2594113504
  let inv_cond = if cond - cond / 2 * 2 == 0 { cond + 1 } else { cond - 1 }
  2594113504 + inv_cond * 4096 + rd
}
fn encode_b(off: i64) -> i64 {
  let off4 = off / 4
  let masked = if off4 < 0 { 67108864 + off4 } else { off4 }
  335544320 + masked
}
fn encode_b_cond(off: i64, cond: i64) -> i64 {
  let off4 = off / 4
  let masked = if off4 < 0 { 524288 + off4 } else { off4 }
  1409286144 + masked * 32 + cond
}
fn encode_bl(off: i64) -> i64 {
  -- BL: 0x94000000 = 2483027968
  let off4 = off / 4
  let masked = if off4 < 0 { 67108864 + off4 } else { off4 }
  2483027968 + masked
}
fn encode_ret() -> i64 { 3596551104 }
fn encode_stp_pre(rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  let offset = imm7 / 8
  let masked = if offset < 0 { 128 + offset } else { offset }
  2843738112 + masked * 32768 + rt2 * 1024 + rn * 32 + rt
}
fn encode_ldp_post(rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  let offset = imm7 / 8
  let masked = if offset < 0 { 128 + offset } else { offset }
  2831155200 + masked * 32768 + rt2 * 1024 + rn * 32 + rt
}

-- Load 64-bit immediate into register (up to 4 MOVZ/MOVK instructions)
fn emit_mov_imm(code: i64, rd: i64, val: i64) -> i64 {
  bu32(code, encode_movz(rd, val - val / 65536 * 65536, 0))
  if val >= 65536 {
    let v1 = val / 65536
    bu32(code, encode_movk(rd, v1 - v1 / 65536 * 65536, 16))
    if val >= 4294967296 {
      let v2 = val / 4294967296
      bu32(code, encode_movk(rd, v2 - v2 / 65536 * 65536, 32))
      if v2 >= 65536 {
        bu32(code, encode_movk(rd, v2 / 65536, 48))
      } else { code }
    } else { code }
  } else { code }
}
