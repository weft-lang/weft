  match arch {
    Aarch64 -> if imm16 < 0 or imm16 > 65535 { arch_encode_brk(arch, 21) } else { 2457862144 + imm16 * 32 + rd }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
