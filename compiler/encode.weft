fn encode_cmp(rn: i64, rm: i64) -> i64 {
  arch_encode_cmp(arch_aarch64(), rn, rm)
}
fn arch_encode_cmp(arch: Arch, rn: i64, rm: i64) -> i64 {
  match arch {
    Aarch64 -> 3942645791 + rm * 65536 + rn * 32
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_cset(rd: i64, cond: i64) -> i64 {
  arch_encode_cset(arch_aarch64(), rd, cond)
}
fn arch_encode_cset(arch: Arch, rd: i64, cond: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let inv_cond = if cond - cond / 2 * 2 == 0 { cond + 1 } else { cond - 1 }
      2594113504 + inv_cond * 4096 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_b(off: i64) -> i64 {
  arch_encode_b(arch_aarch64(), off)
}
fn encode_b_cond(off: i64, cond: i64) -> i64 {
  arch_encode_b_cond(arch_aarch64(), off, cond)
}
fn arch_encode_b_cond(arch: Arch, off: i64, cond: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let off4 = off / 4
      let masked = if off4 < 0 { 524288 + off4 } else { off4 }
      1409286144 + masked * 32 + cond
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn arch_encode_bl(arch: Arch, off: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let off4 = off / 4
      let masked = if off4 < 0 { 67108864 + off4 } else { off4 }
      2483027968 + masked
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_bl(off: i64) -> i64 {
  arch_encode_bl(arch_aarch64(), off)
}

fn arch_encode_ret(arch: Arch) -> i64 {
  match arch {
    Aarch64 -> 3596551104
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_ret() -> i64 { arch_encode_ret(arch_aarch64()) }

fn arch_encode_stp_pre(arch: Arch, rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let offset = imm7 / 8
      let masked = if offset < 0 { 128 + offset } else { offset }
      2843738112 + masked * 32768 + rt2 * 1024 + rn * 32 + rt
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_stp_pre(rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  arch_encode_stp_pre(arch_aarch64(), rt, rt2, rn, imm7)
}

fn arch_encode_ldp_post(arch: Arch, rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let offset = imm7 / 8
      let masked = if offset < 0 { 128 + offset } else { offset }
      2831155200 + masked * 32768 + rt2 * 1024 + rn * 32 + rt
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_ldp_post(rt: i64, rt2: i64, rn: i64, imm7: i64) -> i64 {
  arch_encode_ldp_post(arch_aarch64(), rt, rt2, rn, imm7)
}

fn arch_encode_b(arch: Arch, off: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let off4 = off / 4
      let masked = if off4 < 0 { 67108864 + off4 } else { off4 }
      335544320 + masked
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_encode_str(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> 4177526784 + byte_off / 8 * 1024 + rn * 32 + rt
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_encode_ldr(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> 4181721088 + byte_off / 8 * 1024 + rn * 32 + rt
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_encode_strb(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> 956301312 + byte_off * 1024 + rn * 32 + rt
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_encode_ldrb(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> 960495616 + byte_off * 1024 + rn * 32 + rt
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_encode_adrp(arch: Arch, rd: i64, page_delta: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let immlo = page_delta - page_delta / 4 * 4
      let immhi = page_delta / 4
      let masked_lo = if immlo < 0 { 4 + immlo } else { immlo }
      let masked_hi = if immhi < 0 { 524288 + immhi } else { immhi }
      2415919104 + masked_lo * 536870912 + masked_hi * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

-- Load 64-bit immediate into register (up to 4 MOVZ/MOVK instructions)
fn emit_mov_imm(code: i64, rd: i64, val: i64) -> i64 {
  bu32(code, encode_movz(rd, val - val / 65536 * 65536, 0))
  if val >= 65536 {
    let v1 = val / 65536
    bu32(code, encode_movk(rd, v1 - v1 / 65536 * 65536, 16))
    if val >= 4294967296 {
      let v2 = val / 4294967296
      bu32(code, encode_movk(rd, v2 - v2 / 65536 * 65536, 32))
      if v2 >= 65536 {
        bu32(code, encode_movk(rd, v2 / 65536, 48))
      } else { code }
    } else { code }
  } else { code }
}

-- Load a 64-bit immediate that may be negative. Handles the case where
-- djb2 hash values overflow to negative. Uses band to extract unsigned
-- 16-bit chunks correctly. Constants kept ≤ 32 bits to avoid nested
-- encoding issues during bootstrap.
fn emit_mov_imm_safe(code: i64, rd: i64, val: i64) -> i64 {
  if val < 0 {
    let w0 = val band 65535
    let w1 = (val - (val band 65535)) / 65536 band 65535
    -- For bits 32-47 and 48-63: subtract low 32 bits, divide by 2^32
    let lo32 = val band 4294967295
    let hi32 = (val - lo32) / 4294967296
    let w2 = hi32 band 65535
    let w3 = (hi32 - (hi32 band 65535)) / 65536 band 65535
    bu32(code, encode_movz(rd, w0, 0))
    bu32(code, encode_movk(rd, w1, 16))
    bu32(code, encode_movk(rd, w2, 32))
    bu32(code, encode_movk(rd, w3, 48))
    code
  } else {
    emit_mov_imm(code, rd, val)
  }
}

-- Named instruction encoders
fn arch_encode_svc(arch: Arch) -> i64 {
  match arch {
    Aarch64 -> 3556773889
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_svc() -> i64 { arch_encode_svc(arch_aarch64()) }

fn arch_encode_brk(arch: Arch, imm16: i64) -> i64 {
  match arch {
    Aarch64 -> 3560890368 + imm16 * 32
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_brk(imm16: i64) -> i64 { arch_encode_brk(arch_aarch64(), imm16) }

fn arch_encode_movn(arch: Arch, rd: i64, imm16: i64) -> i64 {
  match arch {
    Aarch64 -> 2457862144 + imm16 * 32 + rd
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_movn(rd: i64, imm16: i64) -> i64 { arch_encode_movn(arch_aarch64(), rd, imm16) }

fn arch_encode_sub_imm(arch: Arch, rd: i64, rn: i64, imm12: i64) -> i64 {
  match arch {
    Aarch64 -> 3506438144 + imm12 * 1024 + rn * 32 + rd
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_sub_imm(rd: i64, rn: i64, imm12: i64) -> i64 { arch_encode_sub_imm(arch_aarch64(), rd, rn, imm12) }
fn encode_str(rt: i64, rn: i64, byte_off: i64) -> i64 { arch_encode_str(arch_aarch64(), rt, rn, byte_off) }
fn encode_ldr(rt: i64, rn: i64, byte_off: i64) -> i64 { arch_encode_ldr(arch_aarch64(), rt, rn, byte_off) }
fn encode_strb(rt: i64, rn: i64, byte_off: i64) -> i64 { arch_encode_strb(arch_aarch64(), rt, rn, byte_off) }
fn encode_ldrb(rt: i64, rn: i64, byte_off: i64) -> i64 { arch_encode_ldrb(arch_aarch64(), rt, rn, byte_off) }
-- BLR Rn: branch and link to register (indirect call)
-- 0xD63F0000 = 3594452992
fn arch_encode_blr(arch: Arch, rn: i64) -> i64 {
  match arch {
    Aarch64 -> 3594452992 + rn * 32
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_blr(rn: i64) -> i64 { arch_encode_blr(arch_aarch64(), rn) }
-- ADR Rd, #offset: compute PC-relative address (±1MB range)
-- encoding: immlo[1:0] in bits [30:29], immhi[20:2] in bits [23:5], Rd in [4:0]
fn encode_adr(rd: i64, off: i64) -> i64 {
  arch_encode_adr(arch_aarch64(), rd, off)
}
fn arch_encode_adr(arch: Arch, rd: i64, off: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let immlo = off - off / 4 * 4
      let immhi = off / 4
      let masked_lo = if immlo < 0 { 4 + immlo } else { immlo }
      let masked_hi = if immhi < 0 { 524288 + immhi } else { immhi }
      268435456 + masked_lo * 536870912 + masked_hi * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
-- ADRP Rd, #page_delta: compute PC-relative page address
-- Like ADR but base opcode is 0x90000000 (2415919104) and offset is in pages
fn encode_adrp(rd: i64, page_delta: i64) -> i64 {
  arch_encode_adrp(arch_aarch64(), rd, page_delta)
}
