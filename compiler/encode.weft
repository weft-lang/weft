pub(package) fn arch_encode_brk(arch: Arch, imm16: i64) -> i64 {
  match arch {
    -- A malformed BRK immediate cannot recursively encode the common
    -- tripwire; return BRK #21's exact word directly.
    Aarch64 -> if imm16 < 0 or imm16 > 65535 { 3560891040 } else { 3560890368 + imm16 * 32 }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
pub(package) fn encode_brk(imm16: i64) -> i64 { arch_encode_brk(arch_aarch64(), imm16) }

