-- STRB/LDRB unsigned-immediate offsets are 12 bits (0-4095). An
-- out-of-range offset used to overflow the imm field straight into
-- the opcode bits — 4096*1024 is exactly the STRB->LDRB opcode delta,
-- so an oversized store silently became a load and the byte vanished
-- (string literals > 4KB shipped with zeroed tails). Out-of-range now
-- encodes BRK #21: emitters that need larger reaches must advance a
-- base register instead, and a missed case traps loudly at the site
-- instead of corrupting data.
pub(package) fn arch_encode_strb(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> if byte_off < 0 or byte_off > 4095 { arch_encode_brk(arch, 21) } else { 956301312 + byte_off * 1024 + rn * 32 + rt }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

pub(package) fn arch_encode_ldrb(arch: Arch, rt: i64, rn: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> if byte_off < 0 or byte_off > 4095 { arch_encode_brk(arch, 21) } else { 960495616 + byte_off * 1024 + rn * 32 + rt }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

pub(package) fn arch_encode_adrp(arch: Arch, rd: i64, page_delta: i64) -> i64 {
  match arch {
    Aarch64 -> if page_delta < 0 - 1048576 or page_delta > 1048575 {
      arch_encode_brk(arch, 21)
    } else {
      let immlo = page_delta - page_delta / 4 * 4
      let immhi = page_delta / 4
      let masked_lo = if immlo < 0 { 4 + immlo } else { immlo }
      let masked_hi = if immhi < 0 { 524288 + immhi } else { immhi }
      2415919104 + masked_lo * 536870912 + masked_hi * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

-- Load 64-bit immediate into register (up to 4 MOVZ/MOVK instructions)
pub(package) fn emit_mov_imm(code: i64, rd: i64, val: i64) -> i64 {
  bu32(code, encode_movz(rd, val - val / 65536 * 65536, 0))
  if val >= 65536 {
    let v1 = val / 65536
    bu32(code, encode_movk(rd, v1 - v1 / 65536 * 65536, 16))
    if val >= 4294967296 {
      let v2 = val / 4294967296
      bu32(code, encode_movk(rd, v2 - v2 / 65536 * 65536, 32))
      if v2 >= 65536 {
        bu32(code, encode_movk(rd, v2 / 65536, 48))
      } else { code }
    } else { code }
  } else { code }
}

-- Load a 64-bit immediate that may be negative. Handles the case where
-- djb2 hash values overflow to negative. Uses band to extract unsigned
-- 16-bit chunks correctly. Constants kept ≤ 32 bits to avoid nested
-- encoding issues during bootstrap.
pub(package) fn emit_mov_imm_safe(code: i64, rd: i64, val: i64) -> i64 {
  if val < 0 {
    let w0 = val band 65535
    let w1 = (val - (val band 65535)) / 65536 band 65535
    -- For bits 32-47 and 48-63: subtract low 32 bits, divide by 2^32
    let lo32 = val band 4294967295
    let hi32 = (val - lo32) / 4294967296
    let w2 = hi32 band 65535
    let w3 = (hi32 - (hi32 band 65535)) / 65536 band 65535
    bu32(code, encode_movz(rd, w0, 0))
    bu32(code, encode_movk(rd, w1, 16))
    bu32(code, encode_movk(rd, w2, 32))
    bu32(code, encode_movk(rd, w3, 48))
    code
  } else {
    emit_mov_imm(code, rd, val)
  }
}

-- Named instruction encoders
pub(package) fn arch_encode_svc(arch: Arch) -> i64 {
  match arch {
    Aarch64 -> 3556773889
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
