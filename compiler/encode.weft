-- BLR Rn: branch and link to register (indirect call)
-- 0xD63F0000 = 3594452992
pub(package) fn arch_encode_blr(arch: Arch, rn: i64) -> i64 {
  match arch {
    Aarch64 -> 3594452992 + rn * 32
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
pub(package) fn encode_blr(rn: i64) -> i64 { arch_encode_blr(arch_aarch64(), rn) }
-- ADR Rd, #offset: compute PC-relative address (±1MB range)
-- encoding: immlo[1:0] in bits [30:29], immhi[20:2] in bits [23:5], Rd in [4:0]
pub(package) fn encode_adr(rd: i64, off: i64) -> i64 {
  arch_encode_adr(arch_aarch64(), rd, off)
}
pub(package) fn arch_encode_adr(arch: Arch, rd: i64, off: i64) -> i64 {
  match arch {
    Aarch64 -> if off < 0 - 1048576 or off > 1048575 {
      arch_encode_brk(arch, 21)
    } else {
      let immlo = off - off / 4 * 4
      let immhi = off / 4
      let masked_lo = if immlo < 0 { 4 + immlo } else { immlo }
      let masked_hi = if immhi < 0 { 524288 + immhi } else { immhi }
      268435456 + masked_lo * 536870912 + masked_hi * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
-- ADRP Rd, #page_delta: compute PC-relative page address
-- Like ADR but base opcode is 0x90000000 (2415919104) and offset is in pages
pub(package) fn encode_adrp(rd: i64, page_delta: i64) -> i64 {
  arch_encode_adrp(arch_aarch64(), rd, page_delta)
}

-- CBNZ Xt, #byte_off: compare-and-branch on nonzero (64-bit)
-- base opcode 0xB5000000 (3036676096), imm19 in bits [23:5]
pub(package) fn encode_cbnz(rt: i64, byte_off: i64) -> i64 {
  arch_encode_cbnz(arch_aarch64(), rt, byte_off)
}
pub(package) fn arch_encode_cbnz(arch: Arch, rt: i64, byte_off: i64) -> i64 {
  match arch {
    Aarch64 -> if byte_off < 0 - 1048576 or byte_off > 1048572 or byte_off % 4 != 0 {
      arch_encode_brk(arch, 21)
    } else {
      let off4 = byte_off / 4
      let masked = if off4 < 0 { 524288 + off4 } else { off4 }
      3036676096 + masked * 32 + rt
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

-- Partial aarch64 write-decoder for the emission-level residency audit
-- (2o). Covers exactly the vocabulary the encoders above produce and
-- returns a bitmask of written registers:
--   bits 0-30  x0-x30, bits 32-47 d0-d15,
--   bit 48     call/svc/placeholder (clobbers volatile pools),
--   bit 49     unknown word (violates every pool window).
-- Constants are verified against every encoder in this file by
-- test/emission_audit_metrics.weft round-trip cases.
pub(package) fn decode_writes_gpr_bit(r: i64) -> i64 {
  if r >= 31 { 0 } else { 1 bshl r }
}
pub(package) fn decode_writes_fp_bit(r: i64) -> i64 {
  if r >= 16 { decode_writes_unknown_bit() } else { 1 bshl (32 + r) }
}
pub(package) fn decode_writes_call_clobber_bit() -> i64 { 1 bshl 48 }
pub(package) fn decode_writes_unknown_bit() -> i64 { 1 bshl 49 }

pub(package) fn decode_writes_group0(w: i64) -> i64 {
  if (w band 4286578688) == 3531603968 { decode_writes_gpr_bit(w band 31) }  -- movz
  else { if (w band 4286578688) == 4068474880 { decode_writes_gpr_bit(w band 31) }  -- movk
  else { if (w band 4292870144) == 2457862144 { decode_writes_gpr_bit(w band 31) }  -- movn
  else { if (w band 4290772992) == 2432696320 { decode_writes_gpr_bit(w band 31) }  -- add_imm
  else { if (w band 4290772992) == 3506438144 { decode_writes_gpr_bit(w band 31) }  -- sub_imm
  else { if (w band 4292934656) == 2332033024 { decode_writes_gpr_bit(w band 31) }  -- add_reg
  else { if (w band 4292934656) == 3405774848 { decode_writes_gpr_bit(w band 31) }  -- sub_reg
  else { if (w band 4292934656) == 2600500224 { decode_writes_gpr_bit(w band 31) }  -- mul
  else { if (w band 4292934656) == 2596277248 { decode_writes_gpr_bit(w band 31) }  -- sdiv
  else { if (w band 4292934656) == 2596276224 { decode_writes_gpr_bit(w band 31) }  -- udiv
  else { if (w band 4292902912) == 2600501248 { decode_writes_gpr_bit(w band 31) }  -- msub
  else { if (w band 4292934656) == 2315255808 { decode_writes_gpr_bit(w band 31) }  -- and_reg
  else { if (w band 4292934656) == 2852126720 { decode_writes_gpr_bit(w band 31) }  -- orr_reg
  else { if (w band 4292934656) == 3388997632 { decode_writes_gpr_bit(w band 31) }  -- eor_reg
  else { if (w band 4292934656) == 2596282368 { decode_writes_gpr_bit(w band 31) }  -- lsl_reg
  else { if (w band 4292934656) == 2596284416 { decode_writes_gpr_bit(w band 31) }  -- asr_reg
  else { if (w band 4292934656) == 2596283392 { decode_writes_gpr_bit(w band 31) }  -- lsr_reg
  else { if (w band 4294966272) == 3361733632 { decode_writes_gpr_bit(w band 31) }  -- ldaxr
  else { if (w band 4292934656) == 3355507712 { decode_writes_gpr_bit((w bshr 16) band 31) }  -- stlxr
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_writes_group1(w: i64) -> i64 {
  if (w band 4294966272) == 3365927936 { 0 }  -- stlr
  else { if (w band 4292934687) == 3942645791 { 0 }  -- cmp
  else { if (w band 4294905824) == 2594113504 { decode_writes_gpr_bit(w band 31) }  -- cset
  else { if (w band 4294966272) == 2657550336 { decode_writes_fp_bit(w band 31) }  -- fmov_d_from_x
  else { if (w band 4294966272) == 2657484800 { decode_writes_gpr_bit(w band 31) }  -- fmov_x_from_d
  else { if (w band 4294966272) == 509624320 { decode_writes_fp_bit(w band 31) }  -- fmov_d_from_d
  else { if (w band 4294966272) == 505872384 { decode_writes_fp_bit(w band 31) }  -- fmov_s_from_w
  else { if (w band 4294966272) == 505806848 { decode_writes_gpr_bit(w band 31) }  -- fmov_w_from_s
  else { if (w band 4294966272) == 505430016 { decode_writes_fp_bit(w band 31) }  -- fmov_s_from_s
  else { if (w band 4294966272) == 2470476800 { decode_writes_gpr_bit(w band 31) }  -- sxtw
  else { if (w band 4294966272) == 2470452224 { decode_writes_gpr_bit(w band 31) }  -- sxtb
  else { if (w band 4294966272) == 2470460416 { decode_writes_gpr_bit(w band 31) }  -- sxth
  else { if (w band 4294966272) == 1392516096 { decode_writes_gpr_bit(w band 31) }  -- uxtb
  else { if (w band 4294966272) == 1392524288 { decode_writes_gpr_bit(w band 31) }  -- uxth
  else { if (w band 4294966272) == 3544218624 { decode_writes_gpr_bit(w band 31) }  -- uxtw
  else { if (w band 4294966272) == 2657222656 { decode_writes_fp_bit(w band 31) }  -- scvtf_d_from_x
  else { if (w band 4294966272) == 2657288192 { decode_writes_fp_bit(w band 31) }  -- ucvtf_d_from_x
  else { if (w band 4294966272) == 2658664448 { decode_writes_gpr_bit(w band 31) }  -- fcvtzs_x_from_d
  else { if (w band 4294966272) == 2653028352 { decode_writes_fp_bit(w band 31) }  -- scvtf_s_from_x
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_writes_group2(w: i64) -> i64 {
  if (w band 4294966272) == 2653093888 { decode_writes_fp_bit(w band 31) }  -- ucvtf_s_from_x
  else { if (w band 4294966272) == 2654470144 { decode_writes_gpr_bit(w band 31) }  -- fcvtzs_x_from_s
  else { if (w band 4294966272) == 505593856 { decode_writes_fp_bit(w band 31) }  -- fcvt_d_from_s
  else { if (w band 4294966272) == 509755392 { decode_writes_fp_bit(w band 31) }  -- fcvt_s_from_d
  else { if (w band 4292934656) == 509618176 { decode_writes_fp_bit(w band 31) }  -- fadd_d
  else { if (w band 4292934656) == 509622272 { decode_writes_fp_bit(w band 31) }  -- fsub_d
  else { if (w band 4292934656) == 509609984 { decode_writes_fp_bit(w band 31) }  -- fmul_d
  else { if (w band 4292934656) == 509614080 { decode_writes_fp_bit(w band 31) }  -- fdiv_d
  else { if (w band 4292934687) == 509616128 { 0 }  -- fcmp_d
  else { if (w band 4294966272) == 509722624 { decode_writes_fp_bit(w band 31) }  -- fsqrt_d
  else { if (w band 4292934656) == 505423872 { decode_writes_fp_bit(w band 31) }  -- fadd_s
  else { if (w band 4292934656) == 505427968 { decode_writes_fp_bit(w band 31) }  -- fsub_s
  else { if (w band 4292934656) == 505415680 { decode_writes_fp_bit(w band 31) }  -- fmul_s
  else { if (w band 4292934656) == 505419776 { decode_writes_fp_bit(w band 31) }  -- fdiv_s
  else { if (w band 4292934687) == 505421824 { 0 }  -- fcmp_s
  else { if (w band 4294966272) == 505528320 { decode_writes_fp_bit(w band 31) }  -- fsqrt_s
  else { if (w band 4227858432) == 335544320 { 0 }  -- b
  else { if (w band 4278190096) == 1409286144 { 0 }  -- b_cond
  else { if (w band 4227858432) == 2483027968 { decode_writes_gpr_bit(30) bor decode_writes_call_clobber_bit() }  -- bl
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_writes_group3(w: i64) -> i64 {
  if (w band 4294967295) == 3596551104 { 0 }  -- ret
  else { if (w band 4290772992) == 2843738112 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- stp_pre
  else { if (w band 4290772992) == 1837105152 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- stp_d_pre
  else { if (w band 4290772992) == 2831155200 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 10) band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldp_post
  else { if (w band 4290772992) == 1824522240 { decode_writes_fp_bit(w band 31) bor decode_writes_fp_bit((w bshr 10) band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldp_d_post
  else { if (w band 4290772992) == 4177526784 { 0 }  -- str
  else { if (w band 4290772992) == 4181721088 { decode_writes_gpr_bit(w band 31) }  -- ldr
  else { if (w band 4290772992) == 956301312 { 0 }  -- strb
  else { if (w band 4290772992) == 960495616 { decode_writes_gpr_bit(w band 31) }  -- ldrb
  else { if (w band 2667577344) == 2415919104 { decode_writes_gpr_bit(w band 31) }  -- adrp
  else { if (w band 2667577344) == 268435456 { decode_writes_gpr_bit(w band 31) }  -- adr
  else { if (w band 4294967295) == 3556773889 { decode_writes_gpr_bit(0) bor decode_writes_gpr_bit(1) bor decode_writes_call_clobber_bit() }  -- svc
  else { if (w band 4292870175) == 3558866944 { 0 }  -- brk
  else { if (w band 4292934656) == 4167071744 { decode_writes_gpr_bit(w band 31) }  -- ldr_reg_lsl3
  else { if (w band 4292934656) == 4234180608 { decode_writes_fp_bit(w band 31) }  -- ldr_d_reg_lsl3
  else { if (w band 4292934656) == 4162877440 { 0 }  -- str_reg_lsl3
  else { if (w band 4292934656) == 4229986304 { 0 }  -- str_d_reg_lsl3
  else { if (w band 4294966303) == 3594452992 { decode_writes_gpr_bit(30) bor decode_writes_call_clobber_bit() }  -- blr
  else { if (w band 4278190080) == 3019898880 { 0 }  -- cbz
  else { if (w band 4278190080) == 3036676096 { 0 }  -- cbnz
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_writes_aarch64(w: i64) -> i64 {
  -- A zero word is an unpatched forward branch/call placeholder.
  if w == 0 { decode_writes_call_clobber_bit() }
  else { let g0 = decode_writes_group0(w)
  if g0 >= 0 { g0 }
  else { let g1 = decode_writes_group1(w)
  if g1 >= 0 { g1 }
  else { let g2 = decode_writes_group2(w)
  if g2 >= 0 { g2 }
  else { let g3 = decode_writes_group3(w)
  if g3 >= 0 { g3 }
  else { decode_writes_unknown_bit() }
  }}}}
}

-- Read-side dual of decode_writes_aarch64 for the 2v allocation checker:
-- a bitmask of registers an instruction READS, same bit scheme (bits 0-30
-- x0-x30, bits 32-47 d0-d15, bit 49 unknown word). Register 31 in an
-- operand field is xzr/sp and sets no bit, matching the write decoder.
-- Strictly architectural: only encoded operand fields count as reads.
-- ABI reads at calls (argument registers at bl/blr, the syscall contract
-- at svc) are the checker's job, keyed off the write decoder's clobber
-- bit — they are not encoded in the instruction word. Condition flags are
-- not modeled (cmp/fcmp set them, b_cond/cset consume them).
pub(package) fn decode_reads_group0(w: i64) -> i64 {
  if (w band 4286578688) == 3531603968 { 0 }  -- movz
  else { if (w band 4286578688) == 4068474880 { decode_writes_gpr_bit(w band 31) }  -- movk (read-modify-write)
  else { if (w band 4292870144) == 2457862144 { 0 }  -- movn
  else { if (w band 4290772992) == 2432696320 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- add_imm
  else { if (w band 4290772992) == 3506438144 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- sub_imm
  else { if (w band 4292934656) == 2332033024 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- add_reg
  else { if (w band 4292934656) == 3405774848 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- sub_reg
  else { if (w band 4292934656) == 2600500224 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- mul
  else { if (w band 4292934656) == 2596277248 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- sdiv
  else { if (w band 4292934656) == 2596276224 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- udiv
  else { if (w band 4292902912) == 2600501248 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) bor decode_writes_gpr_bit((w bshr 10) band 31) }  -- msub
  else { if (w band 4292934656) == 2315255808 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- and_reg
  else { if (w band 4292934656) == 2852126720 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- orr_reg
  else { if (w band 4292934656) == 3388997632 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- eor_reg
  else { if (w band 4292934656) == 2596282368 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- lsl_reg
  else { if (w band 4292934656) == 2596284416 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- asr_reg
  else { if (w band 4292934656) == 2596283392 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- lsr_reg
  else { if (w band 4294966272) == 3361733632 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldaxr
  else { if (w band 4292934656) == 3355507712 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- stlxr
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_reads_group1(w: i64) -> i64 {
  if (w band 4294966272) == 3365927936 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- stlr
  else { if (w band 4292934687) == 3942645791 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- cmp
  else { if (w band 4294905824) == 2594113504 { 0 }  -- cset (flags)
  else { if (w band 4294966272) == 2657550336 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- fmov_d_from_x
  else { if (w band 4294966272) == 2657484800 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fmov_x_from_d
  else { if (w band 4294966272) == 509624320 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fmov_d_from_d
  else { if (w band 4294966272) == 505872384 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- fmov_s_from_w
  else { if (w band 4294966272) == 505806848 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fmov_w_from_s
  else { if (w band 4294966272) == 505430016 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fmov_s_from_s
  else { if (w band 4294966272) == 2470476800 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- sxtw
  else { if (w band 4294966272) == 2470452224 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- sxtb
  else { if (w band 4294966272) == 2470460416 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- sxth
  else { if (w band 4294966272) == 1392516096 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- uxtb
  else { if (w band 4294966272) == 1392524288 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- uxth
  else { if (w band 4294966272) == 3544218624 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- uxtw
  else { if (w band 4294966272) == 2657222656 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- scvtf_d_from_x
  else { if (w band 4294966272) == 2657288192 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ucvtf_d_from_x
  else { if (w band 4294966272) == 2658664448 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fcvtzs_x_from_d
  else { if (w band 4294966272) == 2653028352 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- scvtf_s_from_x
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_reads_group2(w: i64) -> i64 {
  if (w band 4294966272) == 2653093888 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ucvtf_s_from_x
  else { if (w band 4294966272) == 2654470144 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fcvtzs_x_from_s
  else { if (w band 4294966272) == 505593856 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fcvt_d_from_s
  else { if (w band 4294966272) == 509755392 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fcvt_s_from_d
  else { if (w band 4292934656) == 509618176 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fadd_d
  else { if (w band 4292934656) == 509622272 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fsub_d
  else { if (w band 4292934656) == 509609984 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fmul_d
  else { if (w band 4292934656) == 509614080 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fdiv_d
  else { if (w band 4292934687) == 509616128 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fcmp_d
  else { if (w band 4294966272) == 509722624 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fsqrt_d
  else { if (w band 4292934656) == 505423872 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fadd_s
  else { if (w band 4292934656) == 505427968 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fsub_s
  else { if (w band 4292934656) == 505415680 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fmul_s
  else { if (w band 4292934656) == 505419776 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fdiv_s
  else { if (w band 4292934687) == 505421824 { decode_writes_fp_bit((w bshr 5) band 31) bor decode_writes_fp_bit((w bshr 16) band 31) }  -- fcmp_s
  else { if (w band 4294966272) == 505528320 { decode_writes_fp_bit((w bshr 5) band 31) }  -- fsqrt_s
  else { if (w band 4227858432) == 335544320 { 0 }  -- b
  else { if (w band 4278190096) == 1409286144 { 0 }  -- b_cond (flags)
  else { if (w band 4227858432) == 2483027968 { 0 }  -- bl (ABI reads are the checker's)
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_reads_group3(w: i64) -> i64 {
  if (w band 4294967295) == 3596551104 { decode_writes_gpr_bit(30) }  -- ret
  else { if (w band 4290772992) == 2843738112 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 10) band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- stp_pre
  else { if (w band 4290772992) == 1837105152 { decode_writes_fp_bit(w band 31) bor decode_writes_fp_bit((w bshr 10) band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- stp_d_pre
  else { if (w band 4290772992) == 2831155200 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldp_post
  else { if (w band 4290772992) == 1824522240 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldp_d_post
  else { if (w band 4290772992) == 4177526784 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- str
  else { if (w band 4290772992) == 4181721088 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldr
  else { if (w band 4290772992) == 956301312 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) }  -- strb
  else { if (w band 4290772992) == 960495616 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- ldrb
  else { if (w band 2667577344) == 2415919104 { 0 }  -- adrp
  else { if (w band 2667577344) == 268435456 { 0 }  -- adr
  else { if (w band 4294967295) == 3556773889 { 0 }  -- svc (ABI reads are the checker's)
  else { if (w band 4292870175) == 3558866944 { 0 }  -- brk
  else { if (w band 4292934656) == 4167071744 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- ldr_reg_lsl3
  else { if (w band 4292934656) == 4234180608 { decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- ldr_d_reg_lsl3
  else { if (w band 4292934656) == 4162877440 { decode_writes_gpr_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- str_reg_lsl3
  else { if (w band 4292934656) == 4229986304 { decode_writes_fp_bit(w band 31) bor decode_writes_gpr_bit((w bshr 5) band 31) bor decode_writes_gpr_bit((w bshr 16) band 31) }  -- str_d_reg_lsl3
  else { if (w band 4294966303) == 3594452992 { decode_writes_gpr_bit((w bshr 5) band 31) }  -- blr
  else { if (w band 4278190080) == 3019898880 { decode_writes_gpr_bit(w band 31) }  -- cbz
  else { if (w band 4278190080) == 3036676096 { decode_writes_gpr_bit(w band 31) }  -- cbnz
  else { 0 - 1 }
  }}}}}}}}}}}}}}}}}}}}
}

pub(package) fn decode_reads_aarch64(w: i64) -> i64 {
  -- A zero word is an unpatched forward branch/call placeholder: no
  -- encoded operand reads (the write decoder carries its clobber bit).
  if w == 0 { 0 }
  else { let g0 = decode_reads_group0(w)
  if g0 >= 0 { g0 }
  else { let g1 = decode_reads_group1(w)
  if g1 >= 0 { g1 }
  else { let g2 = decode_reads_group2(w)
  if g2 >= 0 { g2 }
  else { let g3 = decode_reads_group3(w)
  if g3 >= 0 { g3 }
  else { decode_writes_unknown_bit() }
  }}}}
}
