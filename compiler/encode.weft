}
pub(package) fn arch_encode_cset(arch: Arch, rd: i64, cond: i64) -> i64 {
  match arch {
    Aarch64 -> if cond < 0 or cond > 15 {
      arch_encode_brk(arch, 21)
    } else {
      let inv_cond = if cond - cond / 2 * 2 == 0 { cond + 1 } else { cond - 1 }
      2594113504 + inv_cond * 4096 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
