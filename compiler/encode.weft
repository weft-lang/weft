pub(package) fn arch_encode_b_cond(arch: Arch, off: i64, cond: i64) -> i64 {
  match arch {
    Aarch64 -> {
      if off < 0 - 1048576 or off > 1048572 or off % 4 != 0 {
        arch_encode_brk(arch, 21)
      } else {
        if cond < 0 or cond > 15 {
          arch_encode_brk(arch, 21)
        } else {
          let off4 = off / 4
          let masked = if off4 < 0 { 524288 + off4 } else { off4 }
          1409286144 + masked * 32 + cond
        }
      }
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
