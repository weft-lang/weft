-- encode.weft — aarch64 instruction encoders

use compiler/lib.{*}
use runtime/buffer.{*}

pub(package) type Arch {
  Aarch64,
  X8664,
  UnsupportedArch
}

pub(package) fn arch_aarch64() -> Arch { Aarch64 }
pub(package) fn arch_x8664() -> Arch { X8664 }
pub(package) fn arch_unsupported() -> Arch { UnsupportedArch }

pub(package) fn arch_is_supported(arch: Arch) -> i64 {
  match arch {
    Aarch64 -> 1
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

pub(package) fn arch_name_len_or(arch: Arch, default: i64) -> i64 {
  match arch {
    Aarch64 -> __str_len("aarch64")
    X8664 -> __str_len("x86_64")
    UnsupportedArch -> default
  }
}

-- Every caller-supplied AArch64 immediate is checked at this boundary.
-- Field overflow otherwise carries into neighbouring opcode bits and
-- silently changes the instruction. Invalid fields encode BRK #21;
-- emitters needing a larger range must select a different sequence.
-- SVC is the sole fixed immediate below (#1), so it has no input to
-- validate. Register fields are audited separately by residency tests.
pub(package) fn arch_encode_movz(arch: Arch, rd: i64, imm16: i64, shift: i64) -> i64 {
  match arch {
    Aarch64 -> {
      if imm16 < 0 or imm16 > 65535 {
        arch_encode_brk(arch, 21)
      } else {
        if shift != 0 and shift != 16 and shift != 32 and shift != 48 {
          arch_encode_brk(arch, 21)
        } else {
          let hw = shift / 16
          3531603968 + hw * 2097152 + imm16 * 32 + rd
        }
      }
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

pub(package) fn encode_movz(rd: i64, imm16: i64, shift: i64) -> i64 {
  arch_encode_movz(arch_aarch64(), rd, imm16, shift)
}

pub(package) fn arch_encode_movk(arch: Arch, rd: i64, imm16: i64, shift: i64) -> i64 {
  match arch {
    Aarch64 -> {
      if imm16 < 0 or imm16 > 65535 {
        arch_encode_brk(arch, 21)
      } else {
        if shift != 0 and shift != 16 and shift != 32 and shift != 48 {
          arch_encode_brk(arch, 21)
        } else {
          let hw = shift / 16
          4068474880 + hw * 2097152 + imm16 * 32 + rd
        }
      }
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
pub(package) fn encode_movk(rd: i64, imm16: i64, shift: i64) -> i64 {
  arch_encode_movk(arch_aarch64(), rd, imm16, shift)
}

-- ADD-immediate's imm12 field is 12 bits; bit 22 of the term is the
-- LSL-12 flag and bit 23 is unallocated, so an out-of-range immediate
-- silently multiplies by 4096 or produces an undefined instruction.
-- Out-of-range now encodes BRK #21 (same contract as strb/ldrb below):
-- emitters needing a larger reach must go through a register.
pub(package) fn arch_encode_add_imm(arch: Arch, rd: i64, rn: i64, imm12: i64) -> i64 {
  match arch {
    Aarch64 -> if imm12 < 0 or imm12 > 4095 { arch_encode_brk(arch, 21) } else { 2432696320 + imm12 * 1024 + rn * 32 + rd }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
pub(package) fn encode_add_imm(rd: i64, rn: i64, imm12: i64) -> i64 {
  arch_encode_add_imm(arch_aarch64(), rd, rn, imm12)
}
pub(package) fn encode_add_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  arch_encode_add_reg(arch_aarch64(), rd, rn, rm)
}
pub(package) fn arch_encode_add_reg(arch: Arch, rd: i64, rn: i64, rm: i64) -> i64 {
  match arch {
    Aarch64 -> 2332033024 + rm * 65536 + rn * 32 + rd
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
