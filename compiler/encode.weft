-- encode.weft — aarch64 instruction encoders

use "compiler/lib.weft"

type Arch {
  Aarch64,
  X8664,
  UnsupportedArch
}

fn arch_aarch64() -> Arch { Aarch64 }
fn arch_x8664() -> Arch { X8664 }
fn arch_unsupported() -> Arch { UnsupportedArch }

fn arch_is_supported(arch: Arch) -> i64 {
  match arch {
    Aarch64 -> 1
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn arch_name_len_or(arch: Arch, default: i64) -> i64 {
  match arch {
    Aarch64 -> __str_len("aarch64")
    X8664 -> __str_len("x86_64")
    UnsupportedArch -> default
  }
}

fn arch_encode_movz(arch: Arch, rd: i64, imm16: i64, shift: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let hw = shift / 16
      3531603968 + hw * 2097152 + imm16 * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}

fn encode_movz(rd: i64, imm16: i64, shift: i64) -> i64 {
  arch_encode_movz(arch_aarch64(), rd, imm16, shift)
}

fn arch_encode_movk(arch: Arch, rd: i64, imm16: i64, shift: i64) -> i64 {
  match arch {
    Aarch64 -> {
      let hw = shift / 16
      4068474880 + hw * 2097152 + imm16 * 32 + rd
    }
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_movk(rd: i64, imm16: i64, shift: i64) -> i64 {
  arch_encode_movk(arch_aarch64(), rd, imm16, shift)
}

fn arch_encode_add_imm(arch: Arch, rd: i64, rn: i64, imm12: i64) -> i64 {
  match arch {
    Aarch64 -> 2432696320 + imm12 * 1024 + rn * 32 + rd
    X8664 -> 0
    UnsupportedArch -> 0
  }
}
fn encode_add_imm(rd: i64, rn: i64, imm12: i64) -> i64 {
  arch_encode_add_imm(arch_aarch64(), rd, rn, imm12)
}
