pub(package) fn pipeline_ir_edge_value_lookup_or(params: IrValueList, args: IrValueList, value: i64, default: i64) -> i64 {
  match params {
    IrValueNil -> default
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> default
        IrValueCons(arg, arg_rest) -> {
          if arg == value { param }
          else { pipeline_ir_edge_value_lookup_or(param_rest, arg_rest, value, default) }
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_edge_translate_value(params: IrValueList, args: IrValueList, value: i64) -> i64 {
  pipeline_ir_edge_value_lookup_or(params, args, value, value)
}

pub(package) fn pipeline_ir_edge_translate_values(values: IrValueList, params: IrValueList, args: IrValueList) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      ir_value_list_prepend(pipeline_ir_edge_translate_value(params, args, value), pipeline_ir_edge_translate_values(rest, params, args))
    }
  }
}

pub(package) fn pipeline_ir_block_entry_facts_add_ctor_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, ctor_hash: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_ctor(facts, target_block, param, ctor_hash)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_ctor_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, ctor_hash)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_entry_facts_add_not_ctor_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, ctor_hash: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_not_ctor(facts, target_block, param, ctor_hash)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_not_ctor_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, ctor_hash)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
    }
  }
}

pub(package) fn pipeline_ir_block_entry_facts_add_scalar_for_matching_params(params: IrValueList, args: IrValueList, facts: PipelineIrBlockEntryFactList, target_block: i64, source_value: i64, kind: i64, value: i64) -> PipelineIrBlockEntryFactAddResult {
  match params {
    IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
    IrValueCons(param, param_rest) -> {
      match args {
        IrValueNil -> pipeline_ir_block_entry_fact_add_result(facts, 0)
        IrValueCons(arg, arg_rest) -> {
          let head = if arg == source_value {
            pipeline_ir_block_entry_facts_add_scalar(facts, target_block, param, kind, value)
          } else {
            pipeline_ir_block_entry_fact_add_result(facts, 0)
          }
          let tail = pipeline_ir_block_entry_facts_add_scalar_for_matching_params(param_rest, arg_rest, pipeline_ir_block_entry_fact_add_result_facts(head), target_block, source_value, kind, value)
          let changed = if pipeline_ir_block_entry_fact_add_result_changed(head) == 1 or pipeline_ir_block_entry_fact_add_result_changed(tail) == 1 { 1 } else { 0 }
          pipeline_ir_block_entry_fact_add_result(pipeline_ir_block_entry_fact_add_result_facts(tail), changed)
        }
      }
