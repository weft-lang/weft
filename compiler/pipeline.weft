  match facts {
    PipelineIrSemanticFactNil -> 0
    PipelineIrSemanticFactNode(hash, fact, borrow, left, right) -> {
      ir_borrow_value_facts_count_unknown_owner(ir_borrow_facts_values(borrow)) +
      pipeline_ir_semantic_borrow_unknown_owner_count_list(left) +
      pipeline_ir_semantic_borrow_unknown_owner_count_list(right)
