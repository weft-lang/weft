      else { if which == 1 { fmap_ir_native_residual_machinery_count(fm) }
      else { if which == 2 { fmap_ir_native_residual_calluse_count(fm) }
      else { if which == 3 { fmap_ir_native_residual_pool_full_count(fm) }
      else { if which == 4 { fmap_ir_native_residual_cs_exhausted_count(fm) }
      else { fmap_ir_native_residual_use_sum_count(fm) } } } } }
    }
  }
}

fn pipeline_native_bank_swap_count(native: NativeModule) -> i64 {
  match native {
