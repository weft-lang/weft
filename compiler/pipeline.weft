fn pipeline_runtime_index_address_lower_proven_hash() -> i64 {
  str_hash(__str_ptr("runtime_index_address_lower_proven"), 0, __str_len("runtime_index_address_lower_proven"))
}

fn pipeline_runtime_index_address_upper_proven_hash() -> i64 {
  str_hash(__str_ptr("runtime_index_address_upper_proven"), 0, __str_len("runtime_index_address_upper_proven"))
}

fn pipeline_runtime_index_address_full_proven_hash() -> i64 {
  str_hash(__str_ptr("runtime_index_address_full_proven"), 0, __str_len("runtime_index_address_full_proven"))
}

fn pipeline_runtime_index_address_check_mode(callee_hash: i64) -> i64 {
  if callee_hash == pipeline_runtime_index_address_hash() { 0 }
  else { if callee_hash == pipeline_runtime_index_address_lower_proven_hash() { 2 }
  else { if callee_hash == pipeline_runtime_index_address_upper_proven_hash() { 4 }
  else { if callee_hash == pipeline_runtime_index_address_full_proven_hash() { 6 } else { 0 - 1 } } } }
}

fn pipeline_runtime_index_address_is_abi_hash(callee_hash: i64) -> i64 {
  if pipeline_runtime_index_address_check_mode(callee_hash) >= 0 { 1 } else { 0 }
}

fn pipeline_runtime_index_address_hash_for_mode(check_mode: i64) -> i64 {
  if check_mode == 6 { pipeline_runtime_index_address_full_proven_hash() }
  else { if check_mode == 4 { pipeline_runtime_index_address_upper_proven_hash() }
  else { if check_mode == 2 { pipeline_runtime_index_address_lower_proven_hash() }
  else { pipeline_runtime_index_address_hash() } } }
}

