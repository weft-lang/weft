    PipelineIrBlockEntryNotCtorFact(fact_block, fact_value, ctor_hash, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryScalarFact(fact_block, fact_value, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntrySlotScalarFact(fact_block, fact_slot, kind, value, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorLenFact(fact_block, len_value, fact_vec, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorUpperFact(fact_block, fact_vec, fact_index, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorSlotUpperFact(fact_block, fact_vec, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorSlotRowUpperFact(fact_block, fact_vec, row_width, fact_slot, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
    PipelineIrBlockEntryVectorRowUpperFact(fact_block, fact_vec, row_width, fact_value, rest) -> {
      if fact_block == block_id and row_width == width and fact_value == value_id { fact_vec }
      else { pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id) }
    }
    PipelineIrBlockEntryVariantOriginFact(fact_block, fact_value, ctor_hash, payloads, rest) -> pipeline_ir_block_entry_vector_row_upper_vec_chain(rest, block_id, width, value_id)
