pub(package) fn pipeline_call_callee_is_direct(params: i64, locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  if pipeline_value_env_lookup(locals, src, ns, nl) >= 0 { 0 }
  else { if params != 0 and pipeline_param_index(params, src, ns, nl) >= 0 { 0 }
  else { 1 } }
}

pub(package) fn pipeline_call_callee_value(params: i64, locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  let local = pipeline_value_env_lookup(locals, src, ns, nl)
  if local >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 0 { local } else { 0 - 1 }
  } else {
    if params == 0 { 0 - 1 } else { pipeline_param_index(params, src, ns, nl) }
  }
}

pub(package) fn pipeline_call_callee_slot(locals: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  let local = pipeline_value_env_lookup(locals, src, ns, nl)
  if local >= 0 {
    if pipeline_value_env_lookup_kind(locals, src, ns, nl) == 1 { local } else { 0 - 1 }
  } else {
    0 - 1
  }
}

pub(package) fn pipeline_call_callee_type_node(params: i64, locals: PipelineValueEnv, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
  if local_ty != 0 { local_ty }
  else { pipeline_param_type_node_by_name(params, src, ns, nl, subst) }
}

pub(package) fn pipeline_call_indirect_expected_types(direct: i64, callee_ty: i64) -> i64 {
  if direct == 0 and callee_ty != 0 and ty_tag(callee_ty) == 6 { ty_f1(callee_ty) } else { 0 }
}

-- The legacy node-CFG call context carries parameter-shaped entries. Adapt
-- the function type's raw parameter-type list at the boundary so it consumes
-- the same semantic shape fact as the typed lowering family.
pub(package) fn pipeline_call_expected_param_nodes_from_types(types: i64) -> i64 {
  if types == 0 { 0 }
  else {
    let params = nlist_new()
    for i in 0..nlist_len(types) {
      nlist_add(params, node_new(0, 0, 0, nlist_get(types, i), 0))
    }
    params
  }
}

-- Shared semantic result fact for call-shaped expressions. Direct names
-- resolve through the function/variant tables; indirect calls resolve
-- through the typed local or parameter that holds the function value.
-- Keeping this next to the indirect parameter fact prevents lowering
-- consumers from treating an owned indirect result as untyped.
pub(package) fn pipeline_call_result_type_node(params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64, ns: i64, nl: i64) -> i64 {
  let direct = pipeline_call_callee_is_direct(params, locals, src, ns, nl)
  if direct == 0 {
    let callee_ty = pipeline_call_callee_type_node(params, locals, src, ns, nl, subst)
    if callee_ty != 0 and ty_tag(callee_ty) == 6 { ty_subst(ty_f2(callee_ty), subst) } else { 0 }
  } else {
    let pair = pipeline_fns_lookup_pair_resolved(fns, tt, src, ns, nl)
    let native_entry = if pair == 0 { pipeline_fns_resolved_native_entry(tt, src, ns, nl) } else { 0 }
    let fn_ret = if pair == 0 { ftypes_entry_return_type(native_entry) } else {
      let raw_ty = fn_ret_type(node_f1(pair))
      if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    }
    if fn_ret != 0 { fn_ret }
    else {
      let opaque = typeck_named_type_from_declaration(tt, pipeline_local_opaque_type_declaration(tt, src, ns, nl), 0)
      if opaque != 0 { opaque } else { pipeline_variant_parent_type_node(tt, src, ns, nl) }
    }
  }
}

pub(package) fn pipeline_variant_tag_hash(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { ttable_find_variant(tt, src, ns, nl) }
}

pub(package) fn pipeline_variant_payload_count(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { ttable_variant_payload_count(tt, src, ns, nl) }
}

-- Payload-less ctor Idents (DNil) are CONSTRUCTIONS, not borrows: under
-- call-results-are-owned they allocate an owned node exactly like
-- DNode(...). Syntactic Ident classification made every consumer
-- borrow-retain them while nothing owned the base stake, leaking one
-- node per construction. Variable Idents never name-match a ctor;
-- payload-ful ctor Idents are static closure pairs and stay borrowed.
pub(package) fn pipeline_ident_is_payloadless_ctor(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    -- Local-shadows-imported: prefer a variant declared in this src.
    let v_local = ttable_variant_scan(tt, src, ns, nl, 1, 2, 0)
    let v = if v_local != 0 { v_local } else { ttable_variant_scan(tt, src, ns, nl, 0, 2, 0) }
    if v != 0 and mem_load64_at(v, 24) == 0 { 1 } else { 0 }
  }
}

-- Parent Named type node for a variant constructor name. The fns table misses
-- ctor calls, but let/return ownership machinery needs the declaration-owned
-- result type, including its scalar/unmanaged representation metadata.
pub(package) fn pipeline_variant_parent_type_node(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_variant_parent_type_node_with_args(tt, src, ns, nl, 0)
}

pub(package) fn pipeline_variant_parent_type_node_with_args(tt: i64, src: i64, ns: i64, nl: i64, type_args: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let entry = ttable_variant_scan(tt, src, ns, nl, 0, 3, 0)
    if entry == 0 { 0 }
    else {
      let entry_src = mem_load64_at(entry, 48)
      let declaration = module_decl_fact_find(
        tt,
        entry_src,
        module_decl_namespace_type(),
        entry_src,
        mem_load64_at(entry, 0),
        mem_load64_at(entry, 8)
      )
      typeck_named_type_from_declaration(tt, declaration, type_args)
    }
  }
}

pub(package) fn pipeline_variant_payload_types(tt: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if tt == 0 { 0 }
  else {
    let v = ttable_variant_scan(tt, src, ns, nl, 0, 2, 0)
    if v == 0 { 0 } else { mem_load64_at(v, 32) }
  }
}

-- Nullary variants carry only identity. Encode that tag as a negative scalar;
-- native variant-tag projection reverses the sign, while every real managed
-- payload pointer remains positive. Payload-bearing constructors retain the
-- ordinary managed aggregate representation.
pub(package) fn pipeline_variant_value_init_inst(dst: i64, tag_hash: i64, args: IrValueList, field_mask: i64) -> IrInst {
  if ir_value_list_len(args) == 0 { ir_inst_const_i64(dst, 0 - tag_hash) }
  else { ir_inst_variant_init_i64(dst, tag_hash, args, field_mask) }
}

pub(package) fn pipeline_direct_call_inst(dst: i64, src: i64, tt: i64, fns: i64, ns: i64, nl: i64, subst: i64, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    pipeline_variant_value_init_inst(dst, tag_hash, args, pipeline_variant_field_mask_for_payload_types(pipeline_variant_payload_types(tt, src, ns, nl), subst))
  } else {
    ir_inst_call_i64(dst, pipeline_fns_resolved_key(fns, tt, src, ns, nl), args)
  }
}

pub(package) fn pipeline_generic_call_inst(dst: i64, src: i64, tt: i64, fns: i64, ns: i64, nl: i64, type_args: i64, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    let tparams = ttable_variant_tparams(tt, src, ns, nl)
    let inst_subst = if tparams == 0 { 0 } else { cg_build_subst(tparams, type_args) }
    pipeline_variant_value_init_inst(dst, tag_hash, args, pipeline_variant_field_mask_for_payload_types(pipeline_variant_payload_types(tt, src, ns, nl), inst_subst))
  } else {
    let typed_type_args = type_expr_list_from_type_nodes(type_args)
    if src_eq(src, ns, nl, "vector_len") == 1 and type_expr_list_len(typed_type_args) == 1 and ir_value_list_len(args) == 1 {
      IrCallI64(dst, str_hash(src, ns, nl), args)
    } else { if src_eq(src, ns, nl, "vector_get") == 1 and type_expr_list_len(typed_type_args) == 1 and type_expr_list_nth_prim_id_or(typed_type_args, 0, 0 - 1) == PRIM_I64() and ir_value_list_len(args) == 3 {
      IrVectorGetI64(dst, pipeline_ir_value_list_get_or(args, 0, 0 - 1), pipeline_ir_value_list_get_or(args, 1, 0 - 1), pipeline_ir_value_list_get_or(args, 2, 0 - 1), 0)
    } else { if src_eq(src, ns, nl, "vector_set") == 1 and type_expr_list_len(typed_type_args) == 1 and type_expr_list_nth_prim_id_or(typed_type_args, 0, 0 - 1) == PRIM_I64() and ir_value_list_len(args) == 3 {
      IrVectorSetI64(dst, pipeline_ir_value_list_get_or(args, 0, 0 - 1), pipeline_ir_value_list_get_or(args, 1, 0 - 1), pipeline_ir_value_list_get_or(args, 2, 0 - 1), 0)
    } else {
      ir_inst_generic_call_i64(dst, pipeline_fns_resolved_key(fns, tt, src, ns, nl), type_args, args)
    } } }
  }
}

pub(package) fn pipeline_generic_call_inst_typed(dst: i64, src: i64, tt: i64, fns: i64, ns: i64, nl: i64, type_args: TypeExprList, args: IrValueList) -> IrInst {
  let tag_hash = pipeline_variant_tag_hash(tt, src, ns, nl)
  if tag_hash >= 0 {
    let tparams = ttable_variant_tparams(tt, src, ns, nl)
    let inst_subst = if tparams == 0 { 0 } else { cg_build_subst(tparams, type_expr_list_to_nodes(type_args)) }
    pipeline_variant_value_init_inst(dst, tag_hash, args, pipeline_variant_field_mask_for_payload_types(pipeline_variant_payload_types(tt, src, ns, nl), inst_subst))
  } else {
    if src_eq(src, ns, nl, "vector_len") == 1 and type_expr_list_len(type_args) == 1 and ir_value_list_len(args) == 1 {
      IrCallI64(dst, str_hash(src, ns, nl), args)
    } else { if src_eq(src, ns, nl, "vector_get") == 1 and type_expr_list_len(type_args) == 1 and type_expr_list_nth_prim_id_or(type_args, 0, 0 - 1) == PRIM_I64() and ir_value_list_len(args) == 3 {
      IrVectorGetI64(dst, pipeline_ir_value_list_get_or(args, 0, 0 - 1), pipeline_ir_value_list_get_or(args, 1, 0 - 1), pipeline_ir_value_list_get_or(args, 2, 0 - 1), 0)
    } else { if src_eq(src, ns, nl, "vector_set") == 1 and type_expr_list_len(type_args) == 1 and type_expr_list_nth_prim_id_or(type_args, 0, 0 - 1) == PRIM_I64() and ir_value_list_len(args) == 3 {
      IrVectorSetI64(dst, pipeline_ir_value_list_get_or(args, 0, 0 - 1), pipeline_ir_value_list_get_or(args, 1, 0 - 1), pipeline_ir_value_list_get_or(args, 2, 0 - 1), 0)
    } else {
      IrGenericCallI64(dst, pipeline_fns_resolved_key(fns, tt, src, ns, nl), type_args, args)
    } } }
  }
}

pub(package) fn pipeline_ir_native_vector_storage_new_hash() -> i64 { 5888537397965780885 }

pub(package) fn pipeline_lower_vector_storage_new_call(call_dst: i64, cap_value: i64, next_value: i64) -> IrLoweredExpr {
  let elem_size_value = if next_value == call_dst { next_value + 1 } else { next_value }
  let elem_mode_value = elem_size_value + 1
  let consts = ir_inst_list_append(
    ir_inst_list_prepend(ir_inst_const_i64(elem_size_value, 8), ir_inst_list_empty()),
    ir_inst_list_prepend(ir_inst_const_i64(elem_mode_value, 0), ir_inst_list_empty())
  )
  let storage_args = ir_value_list_prepend(cap_value, ir_value_list_prepend(elem_size_value, ir_value_list_prepend(elem_mode_value, ir_value_list_empty())))
  let call = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pipeline_ir_native_vector_storage_new_hash(), storage_args), ir_inst_list_empty())
  ir_lowered_expr(call_dst, elem_mode_value + 1, ir_inst_list_append(consts, call))
}

pub(package) fn pipeline_lower_vector_storage_new_const_cap(call_dst: i64, cap: i64) -> IrLoweredExpr {
  let cap_value = call_dst + 1
  let elem_size_value = call_dst + 2
  let elem_mode_value = call_dst + 3
  let consts = ir_inst_list_append(
    ir_inst_list_prepend(ir_inst_const_i64(cap_value, cap), ir_inst_list_empty()),
    ir_inst_list_append(
      ir_inst_list_prepend(ir_inst_const_i64(elem_size_value, 8), ir_inst_list_empty()),
      ir_inst_list_prepend(ir_inst_const_i64(elem_mode_value, 0), ir_inst_list_empty())
    )
  )
  let storage_args = ir_value_list_prepend(cap_value, ir_value_list_prepend(elem_size_value, ir_value_list_prepend(elem_mode_value, ir_value_list_empty())))
  let call = ir_inst_list_prepend(ir_inst_call_i64(call_dst, pipeline_ir_native_vector_storage_new_hash(), storage_args), ir_inst_list_empty())
  ir_lowered_expr(call_dst, call_dst + 4, ir_inst_list_append(consts, call))
}

