fn pipeline_binop_result_is_bool_typed(op: i64) -> i64 {
  if op >= 5 and op <= 10 { 1 } else { 0 }
}

-- 2u: `==`/`!=` with a str operand is CONTENT equality, not pointer
-- identity (literal pooling made pointer results program-dependent).
-- Detection uses the typed oracle with literal/interp fast paths; the
-- checker guarantees both operands agree, so one confirmed side wins.
fn pipeline_expr_is_str_typed(expr: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    StringLit(start, len) -> 1
    InterpConcat(left, right) -> 1
    Ident(ns, nl) -> {
      let hash = pipeline_expr_type_hash_typed_temp(expr, params, locals, src, tt, fns, subst)
      if hash == pipeline_type_hash_of_prim_id(PRIM_STR()) { 1 }
      else {
        -- Union types hash to 0: consult the type NODE so str | nil
        -- operands also take the (nil-safe) content equality.
        let local_node = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
        let node = if local_node != 0 { local_node } else { pipeline_param_type_node_by_name(params, src, ns, nl, subst) }
        if node == 0 { 0 } else { ty_mentions_str(node) }
      }
    }
    _ -> {
      if pipeline_expr_type_hash_typed_temp(expr, params, locals, src, tt, fns, subst) == pipeline_type_hash_of_prim_id(PRIM_STR()) { 1 } else { 0 }
    }
  }
}

fn pipeline_expr_is_nil_lit(expr: Expr) -> i64 {
  match expr {
    NilExpr -> 1
    LetTyped(inner, ann_type) -> pipeline_expr_is_nil_lit(inner)
    _ -> 0
  }
}

fn pipeline_binop_is_str_content_eq(op_id: i64, lhs: Expr, rhs: Expr, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  if op_id != 5 and op_id != 6 { 0 }
  -- Comparisons against the nil LITERAL are guards: nil is represented
  -- as 0 and a str value is never 0, so identity comparison is the
  -- correct (and narrowing-compatible) semantics there.
  else { if pipeline_expr_is_nil_lit(lhs) == 1 or pipeline_expr_is_nil_lit(rhs) == 1 { 0 }
  else {
    if pipeline_expr_is_str_typed(lhs, params, locals, src, tt, fns, subst) == 1 { 1 }
    else { pipeline_expr_is_str_typed(rhs, params, locals, src, tt, fns, subst) }
  } }
}

-- The content-eq instruction pair: the intrinsic call computes 0/1
-- equality into base; `!=` (op 6) adds a logical-not into base + 1.
-- The RESULT value is base for ==, base + 1 for !=.
fn pipeline_str_content_eq_insts(op_id: i64, base: i64, lv: i64, rv: i64) -> IrInstList {
  let args = ir_value_list_prepend(lv, ir_value_list_prepend(rv, ir_value_list_empty()))
  let call = ir_inst_call_i64(base, pipeline_ir_native_intrinsic_str_content_eq_hash(), args)
  if op_id == 6 {
    ir_inst_list_prepend(call, ir_inst_list_prepend(ir_inst_unary_i64(base + 1, ir_unary_op_not(), base), ir_inst_list_empty()))
  } else {
    ir_inst_list_prepend(call, ir_inst_list_empty())
  }
}

fn pipeline_str_content_eq_result(op_id: i64, base: i64) -> i64 {
  if op_id == 6 { base + 1 } else { base }
}

fn pipeline_expr_type_hash_sharpen_int_typed(expr: Expr, inferred_hash: i64, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  match expr {
    BinOp(op, lhs, rhs) -> {
      if pipeline_binop_result_is_bool_typed(op) == 1 {
        inferred_hash
      } else {
        let int_prim = pipeline_binop_int_prim_typed(op, lhs, rhs, params, locals, src, fns, subst)
        if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { inferred_hash }
      }
    }
    -- BINDER-only str typing (2u): a let bound to a string literal or
    -- interpolation records the str hash so `a == b` on such binders
    -- takes the content-equality lowering. Deliberately NOT in the
    -- general type-hash oracle: giving bare literal ARGUMENTS a str
    -- hash flipped a call-site ownership classification and released
    -- static literal storage (guard_narrowing multi-test SIGSEGV).
    StringLit(start, len) -> pipeline_type_hash_of_prim_id(PRIM_STR())
    InterpConcat(left, right) -> pipeline_type_hash_of_prim_id(PRIM_STR())
    LetTyped(inner, ann_type) -> pipeline_expr_type_hash_sharpen_int_typed(inner, inferred_hash, params, locals, src, fns, subst)
    _ -> inferred_hash
  }
}

fn pipeline_expr_type_hash_sharpen_int_node(expr: i64, inferred_hash: i64, params: i64, locals: PipelineValueEnv, src: i64, tt: i64, fns: i64, subst: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped != 0 and node_tag(stripped) == 3 {
    let op = node_f1(stripped)
    if pipeline_binop_result_is_bool_typed(op) == 1 {
      inferred_hash
    } else {
      let int_prim = pipeline_binop_int_prim_node(op, node_f2(stripped), node_f3(stripped), params, locals, src, tt, fns, subst)
      if int_prim >= 0 { pipeline_type_hash_of_prim_id(int_prim) } else { inferred_hash }
    }
  } else { if stripped != 0 and node_tag(stripped) == 37 {
    pipeline_expr_type_hash_sharpen_int_node(node_f1(stripped), inferred_hash, params, locals, src, tt, fns, subst)
  } else { if stripped != 0 and node_tag(stripped) == 9 {
    -- binder-only str typing, matching the typed variant above
    pipeline_type_hash_of_prim_id(PRIM_STR())
  } else { if stripped != 0 and node_tag(stripped) == 46 {
    pipeline_type_hash_of_prim_id(PRIM_STR())
  } else {
    inferred_hash
  } } } }
}

fn pipeline_binop_float_prim_typed_temp(op_id: i64, lhs: Expr, rhs: Expr, params: i64, locals: PipelineValueEnv, src: i64, fns: i64, subst: i64) -> i64 {
  let mark = alloc_bump_mark()
  let result = pipeline_binop_float_prim_typed(op_id, lhs, rhs, params, locals, src, fns, subst)
  alloc_bump_restore_same_segment(mark)
  result
}

