-- compiler/pipeline.weft -- Compiler pass boundaries

type PipelineParsed {
  PipelineParsed(i64, i64, i64)
}

type PipelineChecked {
  PipelineChecked(i64, i64, i64)
}

type PipelineNative {
  PipelineNative(i64, i64)
}

type PipelineBinary {
  PipelineBinary(i64)
}

fn pipeline_parse(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> i64 {
  grammar.parse(src, n, tt)
}

fn pipeline_check(fns: i64, src: i64, tt: i64) -> i64 {
  let ct = build_ctable(tt, src)
  ttable_set_ct(tt, ct)
  handle check_user_fns(fns, src, tt) {
    Conformance.conforms(th, trh) -> resume(ctable_conforms(ct, th, trh))
  }
}

fn pipeline_parse_module(grammar: WeftGrammar, src: i64, n: i64, tt: i64) -> PipelineParsed {
  let fns = pipeline_parse(grammar, src, n, tt)
  PipelineParsed(fns, src, tt)
}

fn pipeline_check_fns(fns: i64, src: i64, tt: i64) -> PipelineChecked {
  pipeline_check(fns, src, tt)
  PipelineChecked(fns, src, tt)
}

fn pipeline_check_module(parsed: PipelineParsed) -> PipelineChecked {
  match parsed {
    PipelineParsed(fns, src, tt) -> pipeline_check_fns(fns, src, tt)
  }
}

fn pipeline_parsed_fns(parsed: PipelineParsed) -> i64 {
  match parsed {
    PipelineParsed(fns, src, tt) -> fns
  }
}

fn pipeline_checked_fns(checked: PipelineChecked) -> i64 {
  match checked {
    PipelineChecked(fns, src, tt) -> fns
  }
}

fn pipeline_native_result(code: i64, fm: i64) -> PipelineNative {
  PipelineNative(code, fm)
}

fn pipeline_binary_result(o: i64) -> PipelineBinary {
  PipelineBinary(o)
}

fn pipeline_native_code(native: PipelineNative) -> i64 {
  match native {
    PipelineNative(code, fm) -> code
  }
}

fn pipeline_native_fmap(native: PipelineNative) -> i64 {
  match native {
    PipelineNative(code, fm) -> fm
  }
}

fn pipeline_binary_buf(binary: PipelineBinary) -> i64 {
  match binary {
    PipelineBinary(o) -> o
  }
}

fn pipeline_parse_source(src: i64, n: i64) -> PipelineParsed {
  let grammar = weft_grammar()
  let tt = ttable_new()
  pipeline_parse_module(grammar, src, n, tt)
}

fn pipeline_check_source(src: i64, n: i64) -> PipelineChecked {
  let parsed = pipeline_parse_source(src, n)
  pipeline_check_module(parsed)
}

fn pipeline_lower_native(checked: PipelineChecked) -> PipelineNative {
  match checked {
    PipelineChecked(fns, src, tt) -> {
      let code = buf_new(1048576)
      let fm = fmap_new()
      emit_heap_init(code)
      let bl_main_pos = buf_len(code)
      bu32(code, 0)
      bu32(code, encode_ldp_post(29, 30, 31, 16))
      bu32(code, encode_ret())
      fmap_set_tt(fm, tt)
      cg_module(fns, code, fm)
      patch_forward_refs(fm, code)
      let main_off = find_main_in_fmap(fm)
      bytes_set_u32(code, bl_main_pos, encode_bl(main_off - bl_main_pos))
      PipelineNative(code, fm)
    }
  }
}

fn pipeline_emit_binary(native: PipelineNative, src: i64) -> PipelineBinary {
  match native {
    PipelineNative(code, fm) -> {
      let ngot = __mem_load64(fm + 128)
      if ngot > 0 {
        let o = compile_object(code, fm, src, ngot)
        PipelineBinary(o)
      } else {
        let o = emit_macho(code, 0)
        PipelineBinary(o)
      }
    }
  }
}

fn pipeline_optimise_native(native: PipelineNative) -> PipelineNative {
  native
}

fn pipeline_emit_native(checked: PipelineChecked) -> PipelineBinary {
  match checked {
    PipelineChecked(fns, src, tt) -> {
      let native = pipeline_lower_native(checked)
      let optimised = pipeline_optimise_native(native)
      pipeline_emit_binary(optimised, src)
    }
  }
}

fn pipeline_write_binary(binary: PipelineBinary) -> i64 {
  match binary {
    PipelineBinary(o) -> {
      sys_write(1, buf_ptr(o), buf_len(o))
      0
    }
  }
}

fn pipeline_compile_native_source(src: i64, n: i64) -> i64 {
  let checked = pipeline_check_source(src, n)
  let binary = pipeline_emit_native(checked)
  pipeline_write_binary(binary)
}
