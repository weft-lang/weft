fn pipeline_type_expr_is_non_native_scalar(ty: TypeExpr) -> i64 {
  let prim = type_expr_prim_id_or(ty, 0 - 1)
  if prim < 0 { 0 }
  else { if prim == PRIM_I64() or prim == PRIM_BOOL() or prim == PRIM_NIL() { 0 } else { 1 } }
}

fn pipeline_expr_list_has_non_native_scalar_typed(exprs: ExprList) -> bool {
  match exprs {
    ExprListNil -> false
    ExprListCons(expr, rest) -> {
      if pipeline_expr_has_non_native_scalar_typed(expr) == 1 { true } else { pipeline_expr_list_has_non_native_scalar_typed(rest) }
    }
  }
}

