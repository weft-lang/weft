-- Transitional compiler-as-data pass results. The payloads are still the
-- existing parser/checker/codegen handles while the public boundary moves
-- toward Ast -> TypedAst -> IrModule -> BinaryObject.
pub(package) type AstModule {
  AstModule(i64, i64, i64)
}

pub(package) type PipelineParseResult {
  PipelineParseResult(i64, i64)
}

pub(package) type TypedModule {
  TypedModule(i64, i64, i64)
}

pub(package) type AstMigrationMetrics {
  AstMigrationMetrics(i64, i64, i64, i64, i64)
}

pub(package) type IrModule {
  IrModule(IrFunctionList),
  OptimisedIrModule(IrFunctionList, i64, i64, i64, i64, i64, i64, PipelineIrSemanticFactList, i64, i64, i64, i64)
}

-- Exact reusable result of the expensive function-local optimiser prefix for
-- a closed checked dependency forest. Global specialization, aggregate
-- scalarisation, ownership transfer, and reuse remain root-local: importing
-- roots may request fresh generic/callback clones even though dependency
-- functions themselves cannot call back into their importers.
pub(package) type PipelineOptimisedDependencyProduct {
  PipelineOptimisedDependencyProduct(
    IrFunctionList,
    i64,
    i64,
    i64,
    i64,
    i64,
    i64
  ),
  PipelineOptimisedDependencyProductUnavailable
}

pub(package) type NativeModule {
  NativeModule(rc i64, i64, IrFunctionList)
}

-- Shared native provenance facts join semantic function identity with the
-- final code layout. Emission offsets and frame shape stay codegen-owned;
-- source identity comes only from checked declarations. Consumers (symbols,
-- embedded fatal reporting) use this API instead of rescanning syntax or the
-- monomorphisation cache.
pub(package) type PipelineNativeSourceLocation {
  PipelineNativeSourceUnknown,
  PipelineNativeSourceKnown(i64, i64, i64, i64, i64, i64, i64)
}

pub(package) type PipelineNativeProvenanceFact {
  PipelineNativeProvenanceFact(i64, i64, i64, i64, i64, PipelineNativeSourceLocation)
}

pub(package) type PipelineNativeProvenanceFactList {
  PipelineNativeProvenanceFactNil,
  PipelineNativeProvenanceFactCons(PipelineNativeProvenanceFact, PipelineNativeProvenanceFactList)
}

pub(package) type BinaryObject {
  BinaryObject(rc i64, i64)
}

pub(package) fn pipeline_word_array_new(words: i64) -> i64 {
  alloc_words(words)
}

pub(package) fn pipeline_word_array_get(array: i64, index: i64) -> i64 {
  mem_load64_at(array, index * 8)
}

pub(package) fn pipeline_word_array_set(array: i64, index: i64, value: i64) -> i64 {
  mem_store64_at(array, index * 8, value)
}

pub(package) fn pipeline_hclause_info_new(clause_start: i64, free_vars: i64, nfree: i64) -> i64 {
  let info = alloc_words(3)
  mem_store64_at(info, 0, clause_start)
  mem_store64_at(info, 8, free_vars)
  mem_store64_at(info, 16, nfree)
  info
}

pub(package) fn pipeline_hclause_info_clause_start(info: i64) -> i64 { mem_load64_at(info, 0) }
pub(package) fn pipeline_hclause_info_free_vars(info: i64) -> i64 { mem_load64_at(info, 8) }
pub(package) fn pipeline_hclause_info_nfree(info: i64) -> i64 { mem_load64_at(info, 16) }

pub(package) type PipelineParLowerCtx {
  PipelineParLowerNone,
  PipelineParLowerSequential(i64),
  PipelineParLowerPthread(i64, i64)
}

-- A compiler-owned task-result transport fact. The lane shape and ownership
-- plan come only from the shared semantic type facts; the runtime encoding is
-- emitted from this value without rescanning syntax. Zero is a valid physical
-- result shape and therefore has its own constructor instead of sharing the
-- IR value-shape layer's zero = unknown sentinel.
pub(package) type PipelineParWorkDescriptor {
  PipelineParWorkDescriptorZero,
  PipelineParWorkDescriptorLanes(i64, i64),
  PipelineParWorkDescriptorInvalid(i64)
}

pub(package) type PipelineLowerModule {
  PipelineLowerModule(i64, i64, i64, PipelineHandlerInlineCtx, i64, PipelineParLowerCtx, i64)
}

