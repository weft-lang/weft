  }
}

fn pipeline_par_lower_ctx_is_active(par_ctx: PipelineParLowerCtx) -> i64 {
  match par_ctx {
    PipelineParLowerNone -> 0
    PipelineParLowerSequential -> 1
    PipelineParLowerPthread(pool_slot) -> 1
  }
}

fn pipeline_effect_hash_par() -> i64 {
  effect_name_hash(__str_ptr("Par"), 0, __str_len("Par"))
}

fn pipeline_fn_declares_par_effect(fn_wrap: i64) -> i64 {
  effect_sig_contains_hash(effect_sig_from_node(fn_effects(fn_wrap)), pipeline_effect_hash_par())
}

fn pipeline_type_value_lane_count_or_one(ty: i64) -> i64 {
  let words = ty_value_storage_word_count(ty)
  if words > 0 { words } else { 1 }
}

fn pipeline_type_value_lane_release_kind(ty: i64, lane: i64) -> i64 {
  cg_managed_drop_kind_for_ty_lane(ty, lane)
}

fn pipeline_type_managed_release_lane_count(ty: i64) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut count = 0
  for lane in 0..lanes {
    if pipeline_type_value_lane_release_kind(ty, lane) != continuation_cleanup_kind_none() { count = count + 1 } else { 0 }
  }
  count
}

-- Three bits per value lane preserve the existing cleanup-kind numbers
-- (none=0, rc=1, closure=2, weak=4). A scalar mask is therefore byte-for-byte
-- identical to the old scalar kind while structural results can describe
-- managed fields at arbitrary lane positions.
fn pipeline_type_value_lane_cleanup_mask(ty: i64) -> i64 {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut mask = 0
  for lane in 0..lanes {
    mask = mask + pipeline_type_value_lane_release_kind(ty, lane) * cg_bit(lane * 3)
  }
  mask
}

fn pipeline_value_lane_cleanup_mask_kind(mask: i64, lane: i64) -> i64 {
  (mask / cg_bit(lane * 3)) band 7
}

fn pipeline_params_value_lane_count(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut total = 0
    for i in 0..nlist_len(params) {
      total = total + pipeline_type_value_lane_count_or_one(node_f3(nlist_get(params, i)))
    }
    total
  }
}

fn pipeline_param_value_index_at(params: i64, index: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) { 0 - 1 }
  else {
    let mut value_index = 0
    for i in 0..index {
      value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(nlist_get(params, i)))
    }
    value_index
  }
}

fn pipeline_param_index(params: i64, src: i64, ns: i64, nl: i64) -> i64 {
  if params == 0 {
    0 - 1
  } else {
    let n = nlist_len(params)
    let mut i = 0
    let mut value_index = 0
    let mut result = 0 - 1
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          result = value_index
          i = n
        } else {
          value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(p))
          i = i + 1
        }
      } else {
        value_index = value_index + pipeline_type_value_lane_count_or_one(node_f3(p))
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_param_type_hash_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          let ty = if raw_ty == 0 or subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          result = if ty == 0 { 0 } else { type_hash_of(ty) }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_param_type_node_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          result = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_param_float_prim_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let n = nlist_len(params)
    let mut i = 0
    let mut result = 0
    while i < n {
      let p = nlist_get(params, i)
      if node_f2(p) == nl {
        if src_eq_at(src, ns, src + node_f1(p), 0, nl) == 1 {
          let raw_ty = node_f3(p)
          let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
          let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
          if prim == PRIM_F32() or prim == PRIM_F64() { result = prim } else { result = 0 }
          i = n
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    }
    result
  }
}

fn pipeline_fns_fact_list_valid(fns: i64) -> i64 {
  if fns <= 4096 { 0 } else { 1 }
}

-- Decl-list lookup index (2m): a hash-ordered tree over the function
-- declarations, keyed by name hash, valued by the decl pair, built once
-- per list length into the nlist's fourth header word. Insertion follows
-- list order and keeps the first entry per hash, matching the linear
-- scans' first-declaration-wins resolution exactly.
fn pipeline_fns_index_insert(tree: i64, hash: i64, pair: i64) -> i64 {
  let leaf = node_new(0, hash, pair, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        done = 1
      } }
    }
    tree
  }
}

fn pipeline_fns_index_insert_replace(tree: i64, hash: i64, pair: i64) -> i64 {
  -- Last-wins variant for generic templates, matching the linear scan
  -- that kept overwriting its result to the end of the list.
  let leaf = node_new(0, hash, pair, 0, 0)
  if tree == 0 { leaf }
  else {
    let mut cur = tree
    let mut done = 0
    while done == 0 {
      let cur_hash = node_f1(cur)
      if hash < cur_hash {
        if node_f3(cur) == 0 {
          mem_store64_at(cur, 24, leaf)
          done = 1
        } else { cur = node_f3(cur) }
      } else { if hash > cur_hash {
        if node_f4(cur) == 0 {
          mem_store64_at(cur, 32, leaf)
          done = 1
        } else { cur = node_f4(cur) }
      } else {
        mem_store64_at(cur, 16, pair)
        done = 1
      } }
    }
    tree
  }
}

fn pipeline_fns_index_probe(tree: i64, hash: i64) -> i64 {
  let mut cur = tree
  let mut result = 0
  while cur != 0 {
    let cur_hash = node_f1(cur)
    if hash == cur_hash {
      result = node_f2(cur)
      cur = 0
    } else { if hash < cur_hash { cur = node_f3(cur) } else { cur = node_f4(cur) } }
  }
  result
}

fn pipeline_fns_index_magic() -> i64 { 762342361276 }

fn pipeline_impl_pair_target_type_args(pair: i64) -> i64 {
  if node_f3(pair) == 0 { 0 }
  else {
    let target_ty = node_f4(pair)
    if target_ty != 0 and ty_tag(target_ty) == 9 { ty_f3(target_ty) } else { 0 }
  }
}

fn pipeline_impl_pair_method_key(pair: i64, name_hash: i64) -> i64 {
  let base = pipeline_ir_method_patch_key(node_f3(pair), name_hash)
  let args = pipeline_impl_pair_target_type_args(pair)
  if fn_tparams(node_f1(pair)) == 0 and args != 0 and nlist_len(args) > 0 { mono_spec_hash(base, args) } else { base }
}

-- One walk builds three trees: function names (first-wins), method pairs
-- keyed by the (type, method) patch key (first-wins), and generic
-- templates (last-wins). The auxiliary node also carries the exact set
-- of named functions created as first-class values. Indirect calls use
-- an all-owned ABI, so those address-taken entries must use borrow mask
-- zero at both direct and indirect call sites.
--
-- The cache node may die in a bump rollback while the list header
-- survives; rolled-back memory is zeroed (or reused), so validity
-- requires the length, the owning list pointer, and a magic to all match
-- before the trees or address-taken facts are trusted.
fn pipeline_fns_index_bundle(fns: i64) -> i64 {
  let cached = mem_load64_at(fns, 24)
  let n = nlist_len(fns)
  let aux_ok = if cached != 0 {
    let aux = node_f4(cached)
    if aux != 0 and node_f1(aux) == n and node_f2(aux) == fns and node_f3(aux) == pipeline_fns_index_magic() { 1 } else { 0 }
  } else { 0 }
  if aux_ok == 1 { cached }
  else {
    let mut name_tree = 0
    let mut method_tree = 0
    let mut template_tree = 0
    let mut i = 0
    while i < n {
      let pair = nlist_get(fns, i)
      let fn_wrap = node_f1(pair)
      if pipeline_decl_node_is_function(fn_wrap) == 1 {
        let inner = pipeline_fn_inner(fn_wrap)
        let fn_src = node_f2(pair)
        let name_hash = str_hash(fn_src, node_f1(inner), node_f2(inner))
        name_tree = pipeline_fns_index_insert(name_tree, name_hash, pair)
        if node_f3(pair) != 0 {
          method_tree = pipeline_fns_index_insert(method_tree, pipeline_impl_pair_method_key(pair, name_hash), pair)
        } else { 0 }
        -- Generic methods are already indexed by their qualified method key
        -- above. Admitting them to the unqualified template tree lets an
        -- impl method replace a free generic function with the same name.
        if fn_tparams(fn_wrap) != 0 and node_f3(pair) == 0 {
          template_tree = pipeline_fns_index_insert_replace(template_tree, name_hash, pair)
        } else { 0 }
      } else { 0 }
      i = i + 1
    }
    let address_taken = pipeline_fns_collect_function_value_hashes(fns, name_tree)
    let bundle = node_new(0, name_tree, method_tree, template_tree, node_new(0, n, fns, pipeline_fns_index_magic(), address_taken))
    mem_store64_at(fns, 24, bundle)
    bundle
  }
}

fn pipeline_fns_index(fns: i64) -> i64 {
  node_f1(pipeline_fns_index_bundle(fns))
}

fn pipeline_fns_address_taken_hashes(fns: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else { node_f4(node_f4(pipeline_fns_index_bundle(fns))) }
}

fn pipeline_fns_hash_is_address_taken(fns: i64, target_hash: i64) -> i64 {
  if pipeline_hash_list_contains(pipeline_fns_address_taken_hashes(fns), target_hash) { 1 } else { 0 }
}

fn pipeline_fns_lookup_pair_by_hash(fns: i64, target_hash: i64) -> i64 {
  if pipeline_fns_fact_list_valid(fns) == 0 { 0 }
  else {
    pipeline_fns_index_probe(pipeline_fns_index(fns), target_hash)
  }
}

fn pipeline_fns_lookup_pair(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_fns_lookup_pair_by_hash(fns, str_hash(src, ns, nl))
}

fn pipeline_fns_lookup_params_by_hash(fns: i64, target_hash: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else { node_f3(pipeline_fn_inner(node_f1(pair))) }
}

fn pipeline_fns_lookup_params(fns: i64, src: i64, ns: i64, nl: i64) -> i64 {
  pipeline_fns_lookup_params_by_hash(fns, str_hash(src, ns, nl))
}

fn pipeline_fns_contains_hash(fns: i64, target_hash: i64) -> i64 {
  -- Probe then re-apply the non-generic filter; coherence forbids a
  -- same-name generic and non-generic pair, so this matches the linear
  -- scan's answer.
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else { if fn_tparams(node_f1(pair)) == 0 { 1 } else { 0 } }
}

fn pipeline_fns_lookup_ret_type_hash_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let fn_wrap = node_f1(pair)
    let raw_ty = fn_ret_type(fn_wrap)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    type_hash_of(ty)
  }
}

fn pipeline_fns_lookup_ret_type_hash(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_type_hash_by_hash(fns, str_hash(src, ns, nl), subst)
}

fn pipeline_fns_lookup_ret_type_node_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    let fn_wrap = node_f1(pair)
    let raw_ty = fn_ret_type(fn_wrap)
    if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  }
}

fn pipeline_fns_lookup_ret_type_node(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_type_node_by_hash(fns, str_hash(src, ns, nl), subst)
}

fn pipeline_fns_lookup_ret_float_prim_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 }
  else {
    pipeline_fn_return_float_prim(node_f1(pair), subst)
  }
}

fn pipeline_fns_lookup_ret_float_prim(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_float_prim_by_hash(fns, str_hash(src, ns, nl), subst)
}

fn pipeline_param_float_prim_at(params: i64, index: i64, subst: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) {
    0
  } else {
    let raw_ty = node_f3(nlist_get(params, index))
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
  }
}

fn pipeline_type_hash_int_prim_or(type_hash: i64, default: i64) -> i64 {
  if type_hash < 0 {
    let prim = (0 - type_hash) - 1
    if prim_is_integer(prim) == 1 { prim } else { default }
  } else {
    default
  }
}

fn pipeline_type_hash_of_prim_id(prim: i64) -> i64 {
  (0 - prim) - 1
}

fn pipeline_param_int_prim_by_name(params: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_type_hash_int_prim_or(pipeline_param_type_hash_by_name(params, src, ns, nl, subst), 0 - 1)
}

fn pipeline_param_int_prim_at(params: i64, index: i64, subst: i64) -> i64 {
  if params == 0 or index < 0 or index >= nlist_len(params) {
    0 - 1
  } else {
    let raw_ty = node_f3(nlist_get(params, index))
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0 - 1)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  }
}

fn pipeline_type_node_float_prim_at(types: i64, index: i64, subst: i64) -> i64 {
  if types == 0 or index < 0 or index >= nlist_len(types) {
    0
  } else {
    let raw_ty = nlist_get(types, index)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
  }
}

fn pipeline_type_node_int_prim_at(types: i64, index: i64, subst: i64) -> i64 {
  if types == 0 or index < 0 or index >= nlist_len(types) {
    0 - 1
  } else {
    let raw_ty = nlist_get(types, index)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let prim = type_expr_prim_id_or(type_expr_from_node(ty), 0 - 1)
    if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
  }
}

fn pipeline_expected_arg_float_prim(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  if expected_types != 0 {
    pipeline_type_node_float_prim_at(expected_types, index, subst)
  } else {
    pipeline_param_float_prim_at(expected_params, index + expected_offset, subst)
  }
}

fn pipeline_expected_arg_int_prim(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  if expected_types != 0 {
    pipeline_type_node_int_prim_at(expected_types, index, subst)
  } else {
    pipeline_param_int_prim_at(expected_params, index + expected_offset, subst)
  }
}

fn pipeline_expected_arg_type_node(expected_params: i64, expected_types: i64, index: i64, expected_offset: i64, subst: i64) -> i64 {
  let raw_ty = if expected_types != 0 {
    if index < 0 or index >= nlist_len(expected_types) { 0 } else { nlist_get(expected_types, index) }
  } else {
    if expected_params == 0 or index + expected_offset < 0 or index + expected_offset >= nlist_len(expected_params) { 0 }
    else { node_f3(nlist_get(expected_params, index + expected_offset)) }
  }
  if raw_ty == 0 { 0 } else { if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) } }
}

fn pipeline_ir_value_lane_ids(value: i64, lane: i64, count: i64) -> IrValueList {
  if lane >= count { ir_value_list_empty() }
  else { ir_value_list_prepend(value + lane, pipeline_ir_value_lane_ids(value, lane + 1, count)) }
}

fn pipeline_ir_slot_lane_init_insts(slot: i64, value: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_slot_i64(slot + lane),
      ir_inst_list_prepend(
        ir_inst_store_i64(slot + lane, value + lane),
        pipeline_ir_slot_lane_init_insts(slot, value, lane + 1, count)
      )
    )
  }
}

fn pipeline_ir_slot_load_lane_insts(dst: i64, slot: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_load_i64(dst + lane, slot + lane),
      pipeline_ir_slot_load_lane_insts(dst, slot, lane + 1, count)
    )
  }
}

fn pipeline_ir_slot_store_lane_insts(slot: i64, value: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_store_i64(slot + lane, value + lane),
      pipeline_ir_slot_store_lane_insts(slot, value, lane + 1, count)
    )
  }
}

fn pipeline_ir_slot_managed_lane_load_insts(dst: i64, slot: i64, ty: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    let rest = pipeline_ir_slot_managed_lane_load_insts(dst, slot, ty, lane + 1, count)
    if pipeline_type_value_lane_release_kind(ty, lane) == continuation_cleanup_kind_none() { rest }
    else { ir_inst_list_prepend(ir_inst_load_i64(dst + lane, slot + lane), rest) }
  }
}

fn pipeline_ir_record_field_lane_entries_inner(field_hash: i64, word_offset: i64, value: i64, lane: i64, count: i64) -> IrRecordFieldList {
  if lane >= count { ir_record_field_list_empty() }
  else {
    ir_record_field_list_prepend(
      field_hash,
      word_offset + lane,
      value + lane,
      pipeline_ir_record_field_lane_entries_inner(field_hash, word_offset, value, lane + 1, count)
    )
  }
}

fn pipeline_ir_record_field_lane_entries(field_hash: i64, word_offset: i64, value: i64, ty: i64) -> IrRecordFieldList {
  pipeline_ir_record_field_lane_entries_inner(field_hash, word_offset, value, 0, pipeline_type_value_lane_count_or_one(ty))
}

fn pipeline_ir_field_load_lane_insts_inner(dst: i64, base: i64, field_hash: i64, word_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_field_load_i64(dst + lane, base, field_hash, word_offset + lane),
      pipeline_ir_field_load_lane_insts_inner(dst, base, field_hash, word_offset, lane + 1, count)
    )
  }
}

fn pipeline_ir_field_load_lane_insts(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64) -> IrInstList {
  pipeline_ir_field_load_lane_insts_inner(dst, base, field_hash, word_offset, 0, pipeline_type_value_lane_count_or_one(ty))
}

fn pipeline_ir_record_layout_word_load_lane_insts_inner(dst: i64, base: i64, record_data_size: i64, field_hash: i64, byte_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_record_layout_word_load_i64(dst + lane, base, record_data_size, field_hash, byte_offset + lane * 8),
      pipeline_ir_record_layout_word_load_lane_insts_inner(dst, base, record_data_size, field_hash, byte_offset, lane + 1, count)
    )
  }
}

fn pipeline_ir_invalid_field_load_lane_insts(dst: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_prepend(ir_inst_lowering_failure_i64(14), ir_inst_list_empty()) }
  else { ir_inst_list_prepend(ir_inst_const_i64(dst + lane, 0), pipeline_ir_invalid_field_load_lane_insts(dst, lane + 1, count)) }
}

fn pipeline_ir_field_load_lane_insts_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64, layout: PipelineRecordStorageLayout) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  match layout {
    PipelineRecordStorageLayoutCompact -> pipeline_ir_field_load_lane_insts(dst, base, field_hash, word_offset, ty)
    PipelineRecordStorageLayoutInvalid -> pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
    PipelineRecordStorageLayoutDescribed(record_data_size, record_align, fields) -> {
      match pipeline_record_storage_field_fact_at_word_offset(fields, word_offset) {
        PipelineRecordStorageFieldFactWord(fact_hash, fact_word_offset, byte_offset, field_ty, fact_lanes, rest) -> {
          if fact_hash == field_hash and fact_lanes == lanes {
            pipeline_ir_record_layout_word_load_lane_insts_inner(dst, base, record_data_size, field_hash, byte_offset, 0, lanes)
          } else { pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes) }
        }
        -- Array projection changes ownership and therefore goes through the
        -- IrLoweredExpr-producing wrapper below. A caller that bypasses that
        -- semantic placement fact remains fail-closed.
        PipelineRecordStorageFieldFactArray(fact_hash, fact_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
          pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
        }
        PipelineRecordStorageFieldFactNil -> pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes)
      }
    }
  }
}

fn pipeline_ir_array_storage_new_args(byte_size_value: i64, align_value: i64, leaf_count_value: i64, leaf_stride_value: i64, leaf_kind_value: i64) -> IrValueList {
  ir_value_list_prepend(
    byte_size_value,
    ir_value_list_prepend(
      align_value,
      ir_value_list_prepend(
        leaf_count_value,
        ir_value_list_prepend(leaf_stride_value, ir_value_list_prepend(leaf_kind_value, ir_value_list_empty()))
      )
    )
  )
}

-- An extracted array is a fresh semantic value, not an interior borrow of the
-- record. Allocate its default-managed backing first, expose the backing data
-- only to the copy instruction, and return the owned storage handle. Higher
-- lowering then uses the ordinary managed-value ownership machinery.
fn pipeline_ir_owned_record_array_load(dst: i64, base: i64, record_data_size: i64, byte_offset: i64, byte_size: i64, align: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> IrLoweredExpr {
  let byte_size_value = dst + 1
  let align_value = dst + 2
  let leaf_count_value = dst + 3
  let leaf_stride_value = dst + 4
  let leaf_kind_value = dst + 5
  let data = dst + 6
  let insts = ir_inst_list_prepend(
    ir_inst_const_i64(byte_size_value, byte_size),
    ir_inst_list_prepend(
      ir_inst_const_i64(align_value, align),
      ir_inst_list_prepend(
        ir_inst_const_i64(leaf_count_value, leaf_count),
        ir_inst_list_prepend(
          ir_inst_const_i64(leaf_stride_value, leaf_stride),
          ir_inst_list_prepend(
            ir_inst_const_i64(leaf_kind_value, leaf_kind),
            ir_inst_list_prepend(
              ir_inst_call_i64(dst, pipeline_rc_array_storage_new_hash(), pipeline_ir_array_storage_new_args(byte_size_value, align_value, leaf_count_value, leaf_stride_value, leaf_kind_value)),
              ir_inst_list_prepend(
                ir_inst_call_i64(data, pipeline_rc_array_storage_data_hash(), ir_value_list_prepend(dst, ir_value_list_empty())),
                ir_inst_list_prepend(
                  ir_inst_record_layout_array_load_i64(data, base, record_data_size, byte_offset, byte_size, leaf_count, leaf_stride, leaf_kind),
                  ir_inst_list_empty()
                )
              )
            )
          )
        )
      )
    )
  )
  ir_lowered_expr(dst, data + 1, insts)
}

fn pipeline_lower_field_load_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, ty: i64, layout: PipelineRecordStorageLayout) -> IrLoweredExpr {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  match layout {
    PipelineRecordStorageLayoutDescribed(record_data_size, record_align, fields) -> {
      match pipeline_record_storage_field_fact_at_word_offset(fields, word_offset) {
        PipelineRecordStorageFieldFactArray(fact_hash, fact_word_offset, byte_offset, field_ty, byte_size, align, leaf_count, leaf_stride, leaf_kind, rest) -> {
          if fact_hash == field_hash and ty_is_array(ty) {
            pipeline_ir_owned_record_array_load(dst, base, record_data_size, byte_offset, byte_size, align, leaf_count, leaf_stride, leaf_kind)
          } else {
            ir_lowered_expr(dst, dst + lanes, pipeline_ir_invalid_field_load_lane_insts(dst, 0, lanes))
          }
        }
        _ -> ir_lowered_expr(dst, dst + lanes, pipeline_ir_field_load_lane_insts_for_storage_layout(dst, base, field_hash, word_offset, ty, layout))
      }
    }
    _ -> ir_lowered_expr(dst, dst + lanes, pipeline_ir_field_load_lane_insts_for_storage_layout(dst, base, field_hash, word_offset, ty, layout))
  }
}

fn pipeline_ir_opt_chain_insts_for_storage_layout(dst: i64, base: i64, field_hash: i64, word_offset: i64, effect_key: i64, layout: PipelineRecordStorageLayout) -> IrInstList {
  match layout {
    PipelineRecordStorageLayoutCompact -> ir_inst_list_prepend(ir_inst_opt_chain_i64(dst, base, field_hash, word_offset, effect_key), ir_inst_list_empty())
    -- Optional projection needs the same descriptor-aware field selection as a
    -- direct projection, plus its Maybe wrapping. Keep described and invalid
    -- layouts fenced until that combined producer exists.
    _ -> ir_inst_list_prepend(ir_inst_const_i64(dst, 0), ir_inst_list_prepend(ir_inst_lowering_failure_i64(15), ir_inst_list_empty()))
  }
}

fn pipeline_ir_variant_payload_lane_insts_inner(dst: i64, base: i64, word_offset: i64, lane: i64, count: i64) -> IrInstList {
  if lane >= count { ir_inst_list_empty() }
  else {
    ir_inst_list_prepend(
      ir_inst_variant_payload_i64(dst + lane, base, word_offset + lane),
      pipeline_ir_variant_payload_lane_insts_inner(dst, base, word_offset, lane + 1, count)
    )
  }
}

fn pipeline_ir_variant_payload_lane_insts(dst: i64, base: i64, word_offset: i64, ty: i64) -> IrInstList {
  pipeline_ir_variant_payload_lane_insts_inner(dst, base, word_offset, 0, pipeline_type_value_lane_count_or_one(ty))
}

fn pipeline_expr_value_lane_count(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  pipeline_type_value_lane_count_or_one(pipeline_return_expr_type_node_typed(expr, params, locals, module))
}

fn pipeline_expr_node_value_lane_count(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  pipeline_type_value_lane_count_or_one(pipeline_return_expr_type_node_from_node(expr, params, locals, module))
}

-- Lowering keeps one logical head value per source argument for ownership
-- accounting. Only the ABI call list is flattened, using the shared typed
-- value-shape fact; every extra lane is the consecutive SSA id after its
-- logical head.
fn pipeline_call_abi_args(values: IrValueList, expected_params: i64, expected_types: i64, subst: i64, expected_offset: i64, index: i64) -> IrValueList {
  match values {
    IrValueNil -> ir_value_list_empty()
    IrValueCons(value, rest) -> {
      let ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, subst)
      let lanes = pipeline_type_value_lane_count_or_one(ty)
      ir_value_list_append(
        pipeline_ir_value_lane_ids(value, 0, lanes),
        pipeline_call_abi_args(rest, expected_params, expected_types, subst, expected_offset, index + 1)
      )
    }
  }
}

fn pipeline_ir_call_result_lane_insts(dst: i64, ty: i64) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut insts = ir_inst_list_empty()
  for lane in 1..lanes {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_call_result_lane_i64(dst + lane, lane), ir_inst_list_empty()))
  }
  insts
}

fn pipeline_ir_return_lane_insts(value: i64, ty: i64) -> IrInstList {
  let lanes = pipeline_type_value_lane_count_or_one(ty)
  let mut insts = ir_inst_list_empty()
  for lane in 1..lanes {
    insts = ir_inst_list_append(insts, ir_inst_list_prepend(ir_inst_return_lane_i64(lane, value + lane), ir_inst_list_empty()))
  }
  insts
}

fn pipeline_lookup_effect_op(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> TypeEffectOp {
  if tt == 0 { MissingTypeEffectOp }
  else {
    let entry = ttable_lookup(tt, src, eff_ns, eff_nl)
    if entry == 0 { MissingTypeEffectOp }
    else {
      let kind = mem_load64_at(entry, 16)
      if kind != 2 { MissingTypeEffectOp }
      else {
        let entry_src = mem_load64_at(entry, 48)
        let target_hash = effect_name_hash(src, op_ns, op_nl)
        let nops = mem_load64_at(entry, 24)
        let ops = mem_load64_at(entry, 32)
        let mut i = 0
        let mut result = MissingTypeEffectOp
        while i < nops {
          let op = nlist_get(ops, i)
          let op_hash = effect_name_hash(entry_src, node_f1(op), node_f2(op))
          if op_hash == target_hash {
            result = type_effect_op_from_node(op)
            i = nops
          } else {
            i = i + 1
          }
        }
        result
      }
    }
  }
}

fn pipeline_lookup_effect_op_params_nodes(tt: i64, src: i64, eff_ns: i64, eff_nl: i64, op_ns: i64, op_nl: i64) -> i64 {
  let op = pipeline_lookup_effect_op(tt, src, eff_ns, eff_nl, op_ns, op_nl)
  param_list_to_nodes(type_effect_op_params(op))
}

fn pipeline_effect_ref_decl_subst_typed(tt: i64, src: i64, effect_ref: Expr, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let entry = if tt == 0 or nl == 0 { 0 } else { ttable_lookup(tt, src, ns, nl) }
  match effect_ref {
    GenericCall(type_args, inner) -> {
      let raw_args = type_expr_list_to_nodes(type_args)
      let args = if outer_subst == 0 { raw_args } else { type_list_subst(raw_args, outer_subst) }
      effect_entry_atom_subst(entry, ty_effect_app_args(effect_name_hash(src, ns, nl), args))
    }
    _ -> 0
  }
}

fn pipeline_effect_op_params_nodes_typed(tt: i64, src: i64, effect_ref: Expr, op_ns: i64, op_nl: i64, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let raw = pipeline_lookup_effect_op_params_nodes(tt, src, ns, nl, op_ns, op_nl)
  let effect_subst = pipeline_effect_ref_decl_subst_typed(tt, src, effect_ref, outer_subst)
  let locally_concrete = if effect_subst == 0 { raw } else { cg_params_subst(raw, effect_subst) }
  if outer_subst == 0 { locally_concrete } else { cg_params_subst(locally_concrete, outer_subst) }
}

fn pipeline_effect_op_return_type_typed(tt: i64, src: i64, effect_ref: Expr, op_ns: i64, op_nl: i64, outer_subst: i64) -> i64 {
  let ns = pipeline_effect_ref_name_start_typed(effect_ref, 0)
  let nl = pipeline_effect_ref_name_len_typed(effect_ref, 0)
  let raw = cg_effect_op_ret_type(tt, src, ns, nl, op_ns, op_nl)
  let effect_subst = pipeline_effect_ref_decl_subst_typed(tt, src, effect_ref, outer_subst)
  let locally_concrete = if raw != 0 and effect_subst != 0 { ty_subst(raw, effect_subst) } else { raw }
  if locally_concrete != 0 and outer_subst != 0 { ty_subst(locally_concrete, outer_subst) } else { locally_concrete }
}

fn pipeline_fn_return_int_prim(fn_wrap: i64, subst: i64) -> i64 {
  let raw_ty = fn_ret_type(fn_wrap)
  let concrete_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  let prim = type_expr_prim_id_or(type_expr_from_node(concrete_ty), 0 - 1)
  if prim_is_integer(prim) == 1 { prim } else { 0 - 1 }
}

fn pipeline_fns_lookup_ret_int_prim_by_hash(fns: i64, target_hash: i64, subst: i64) -> i64 {
  let pair = pipeline_fns_lookup_pair_by_hash(fns, target_hash)
  if pair == 0 { 0 - 1 }
  else {
    pipeline_fn_return_int_prim(node_f1(pair), subst)
  }
}

fn pipeline_fns_lookup_ret_int_prim(fns: i64, src: i64, ns: i64, nl: i64, subst: i64) -> i64 {
  pipeline_fns_lookup_ret_int_prim_by_hash(fns, str_hash(src, ns, nl), subst)
}

fn pipeline_prim_is_native_i64_equivalent(prim: i64) -> i64 {
  prim == PRIM_I64() or prim == PRIM_ISIZE()
}

fn pipeline_prim_is_non_native_int(prim: i64) -> i64 {
  prim_is_integer(prim) == 1 and pipeline_prim_is_native_i64_equivalent(prim) == 0
}

fn pipeline_prim_is_numeric_context(prim: i64) -> i64 {
  prim == PRIM_F32() or prim == PRIM_F64() or prim_is_integer(prim) == 1
}

fn pipeline_prim_is_forced_numeric_context(prim: i64) -> i64 {
  if prim == PRIM_F32() or prim == PRIM_F64() {
    1
  } else {
    prim_is_integer(prim) == 1 and pipeline_prim_is_native_i64_equivalent(prim) == 0
  }
}

fn pipeline_fns_call_arg_float_prim(fns: i64, src: i64, ns: i64, nl: i64, arg_index: i64, subst: i64) -> i64 {
  pipeline_param_float_prim_at(pipeline_fns_lookup_params(fns, src, ns, nl), arg_index, subst)
}

fn pipeline_fn_return_float_prim(fn_wrap: i64, subst: i64) -> i64 {
  let raw_ty = fn_ret_type(fn_wrap)
  let concrete_ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
  let prim = type_expr_prim_id_or(type_expr_from_node(concrete_ty), 0)
  if prim == PRIM_F32() or prim == PRIM_F64() { prim } else { 0 }
}

fn pipeline_value_env_empty() -> PipelineValueEnv {
  PipelineValueEnvNil
}

fn pipeline_value_env_push(env: PipelineValueEnv, ns: i64, nl: i64, value: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, 0, 0, 0, env)
}

fn pipeline_value_env_push_float(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, 0, 0, env)
}

fn pipeline_value_env_push_float_typed(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64, type_hash: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, type_hash, 0, env)
}

fn pipeline_value_env_push_float_typed_node(env: PipelineValueEnv, ns: i64, nl: i64, value: i64, float_prim: i64, type_hash: i64, type_node: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, value, 0, float_prim, type_hash, type_node, env)
}

fn pipeline_value_env_push_slot(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, 0, 0, 0, env)
}

fn pipeline_value_env_push_slot_float(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, 0, 0, env)
}

fn pipeline_value_env_push_slot_float_typed(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64, type_hash: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, type_hash, 0, env)
}

fn pipeline_value_env_push_slot_float_typed_node(env: PipelineValueEnv, ns: i64, nl: i64, slot: i64, float_prim: i64, type_hash: i64, type_node: i64) -> PipelineValueEnv {
  PipelineValueEnvCons(ns, nl, slot, 1, float_prim, type_hash, type_node, env)
}

fn pipeline_value_env_push_param_values(params: i64, values: IrValueList, index: i64, count: i64, subst: i64, env: PipelineValueEnv) -> PipelineValueEnv {
  if params == 0 or index >= count {
    env
  } else {
    let param = nlist_get(params, index)
    let raw_ty = node_f3(param)
    let ty = if subst == 0 { raw_ty } else { ty_subst(raw_ty, subst) }
    let type_hash = if ty == 0 { 0 } else { type_hash_of(ty) }
    let float_prim = type_expr_prim_id_or(type_expr_from_node(ty), 0)
    let value = pipeline_ir_value_list_get_or(values, index, 0 - 1)
    let next = if value < 0 {
      env
    } else {
      pipeline_value_env_push_float_typed_node(env, node_f1(param), node_f2(param), value, float_prim, type_hash, ty)
    }
    pipeline_value_env_push_param_values(params, values, index + 1, count, subst, next)
  }
}

fn pipeline_value_env_lookup(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          value
        } else {
          pipeline_value_env_lookup(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup(rest, src, ns, nl)
      }
    } }
  }
}

fn pipeline_value_env_lookup_kind(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0 - 1
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          kind
        } else {
          pipeline_value_env_lookup_kind(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_kind(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_value_env_lookup_float_prim(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          float_prim
        } else {
          pipeline_value_env_lookup_float_prim(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_float_prim(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_value_env_lookup_type_hash(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          type_hash
        } else {
          pipeline_value_env_lookup_type_hash(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_type_hash(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_value_env_lookup_type_node(env: PipelineValueEnv, src: i64, ns: i64, nl: i64) -> i64 {
  match env {
    PipelineValueEnvNil -> 0
    PipelineValueEnvCons(bind_ns, bind_nl, value, kind, float_prim, type_hash, type_node, rest) -> {
      if bind_nl == nl {
        if src_eq_at(src, ns, src + bind_ns, 0, nl) == 1 {
          type_node
        } else {
          pipeline_value_env_lookup_type_node(rest, src, ns, nl)
        }
      } else {
        pipeline_value_env_lookup_type_node(rest, src, ns, nl)
      }
    }
  }
}

fn pipeline_param_type_node_default_i64(param: Param) -> i64 {
  match param {
    Param(ns, nl, ty, label) -> {
      match ty {
        MissingTypeExpr -> ty_i64()
        _ -> type_expr_to_node(ty)
      }
    }
    UnknownParam(tag) -> ty_i64()
  }
}

fn pipeline_param_list_type_nodes_default_i64_into(params: ParamList, nodes: i64) -> i64 {
  match params {
    ParamListNil -> nodes
    ParamListCons(param, rest) -> {
      nlist_add(nodes, pipeline_param_type_node_default_i64(param))
      pipeline_param_list_type_nodes_default_i64_into(rest, nodes)
    }
  }
}

fn pipeline_param_list_type_nodes_default_i64(params: ParamList) -> i64 {
  pipeline_param_list_type_nodes_default_i64_into(params, nlist_new())
}

fn pipeline_lambda_type_node(params: ParamList) -> i64 {
  ty_fn(pipeline_param_list_type_nodes_default_i64(params), ty_any(), ty_effect_pure())
}

fn pipeline_lambda_type_node_typed(lambda_params: ParamList, body: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let available = pipeline_lambda_capture_env_with_params(params, locals, src)
  let lambda_param_nodes = param_list_to_nodes(lambda_params)
  let inferred_return = pipeline_return_expr_type_node_typed(body, lambda_param_nodes, available, module)
  let return_ty = if inferred_return != 0 { inferred_return } else { ty_any() }
  ty_fn(pipeline_param_list_type_nodes_default_i64(lambda_params), return_ty, ty_effect_pure())
}

fn pipeline_structural_record_types_into(fields: RecordFieldList, types: i64) -> i64 {
  match fields {
    RecordFieldListNil -> types
    RecordFieldListCons(field, rest) -> {
      nlist_add(types, record_field_resolved_type_node(field))
      pipeline_structural_record_types_into(rest, types)
    }
  }
}

fn pipeline_structural_record_fields_into(fields: RecordFieldList, typed_fields: i64) -> i64 {
  match fields {
    RecordFieldListNil -> typed_fields
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> {
          nlist_add(typed_fields, ty_record_field(record_field_hash_or(field, 0), record_field_resolved_type_node(field), ns, nl))
          pipeline_structural_record_fields_into(rest, typed_fields)
        }
        UnknownRecordField(tag) -> pipeline_structural_record_fields_into(rest, typed_fields)
      }
    }
  }
}

fn pipeline_structural_record_value_type(fields: RecordFieldList, tuple_kind: i64) -> i64 {
  if tuple_kind == 1 {
    ty_tuple(pipeline_structural_record_types_into(fields, nlist_new()))
  } else {
    ty_record(pipeline_structural_record_fields_into(fields, nlist_new()), 0)
  }
}

fn pipeline_expr_type_node_typed(expr: Expr) -> i64 {
  match expr {
    Lambda(params, body) -> pipeline_lambda_type_node(params)
    LetTyped(inner, ann_type) -> type_expr_to_node(ann_type)
    ArrayLiteral(elements, resolved_ty, span) -> resolved_ty
    IndexedLen(base, fixed_len) -> ty_usize()
    IndexedGet(base, index, element_ty, fixed_len) -> element_ty
    IndexedSet(base, index, value, fact) -> ty_nil()
    IndexedSlice(base, start, end, fact) -> if fact == 0 { ty_any() } else { ty_slice_with_mut(node_f1(fact), node_f4(fact)) }
    RecordInit(type_ns, type_nl, fields) -> if type_ns == 0 and type_nl <= 0 {
      pipeline_structural_record_value_type(fields, if type_nl < 0 { 1 } else { 0 })
    } else { 0 }
    _ -> 0
  }
}

fn pipeline_expr_type_node_from_node(expr: i64) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 }
  else {
    if node_tag(stripped) == 29 {
      pipeline_lambda_type_node(param_list_from_nodes(node_f1(stripped), 0, node_f3(stripped)))
    } else {
      if node_tag(stripped) == 37 { node_f2(stripped) }
      else { if node_tag(stripped) == 58 { node_f3(stripped) }
      else { if node_tag(stripped) == 59 { ty_usize() }
      else { if node_tag(stripped) == 60 { node_f3(stripped) }
      else { if node_tag(stripped) == 61 { ty_nil() }
      else { if node_tag(stripped) == 62 {
        let fact = node_f4(stripped)
        if fact == 0 { ty_any() } else { ty_slice_with_mut(node_f1(fact), node_f4(fact)) }
      } else { 0 } } } } } }
    }
  }
}

fn pipeline_return_expr_type_node_typed(expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  match expr {
    Ident(ns, nl) -> {
      let local_ty = pipeline_value_env_lookup_type_node(locals, src, ns, nl)
      if local_ty != 0 { local_ty } else { pipeline_param_type_node_by_name(params, src, ns, nl, subst) }
    }
    Call(ns, nl, args) -> {
      pipeline_call_result_type_node(params, locals, src, pipeline_lower_module_tt(module), fns, subst, ns, nl)
    }
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> {
          let pair = pipeline_generic_template_find(fns, src, str_hash(src, ns, nl))
          if pair == 0 { pipeline_variant_parent_type_node(pipeline_lower_module_tt(module), src, ns, nl) }
          else {
            let fn_wrap = node_f1(pair)
            let concrete = pipeline_type_expr_list_subst(type_args, subst)
            let s = cg_build_subst(fn_tparams(fn_wrap), type_expr_list_to_nodes(concrete))
            ty_subst(fn_ret_type(fn_wrap), s)
          }
        }
        _ -> pipeline_return_expr_type_node_typed(inner_call, params, locals, module)
      }
    }
    Perform(lhs, op_ns, op_nl, args) -> pipeline_effect_op_return_type_typed(
      pipeline_lower_module_tt(module),
      src,
      lhs,
      op_ns,
      op_nl,
      subst
    )
    RecordInit(type_ns, type_nl, fields) -> if type_ns == 0 and type_nl <= 0 {
      pipeline_structural_record_value_type(fields, if type_nl < 0 { 1 } else { 0 })
    } else { typecheck_resolve_type(pipeline_lower_module_tt(module), src, type_ns, type_nl) }
    FieldAccess(base, field_ns, field_nl, fact) -> {
      let resolved = field_access_fact_field_type_node(fact)
      if resolved != 0 { ty_subst(resolved, subst) }
      else {
        pipeline_typed_field_type_for_base(
          pipeline_lower_module_tt(module),
          src,
          field_ns,
          field_nl,
          base,
          params,
          locals,
          module
        )
      }
    }
    ArrayLiteral(elements, resolved_ty, span) -> ty_subst(resolved_ty, subst)
    IndexedLen(base, fixed_len) -> ty_usize()
    IndexedGet(base, index, element_ty, fixed_len) -> ty_subst(element_ty, subst)
    IndexedSet(base, index, value, fact) -> ty_nil()
    IndexedSlice(base, start, end, fact) -> if fact == 0 { ty_any() } else { ty_slice_with_mut(ty_subst(node_f1(fact), subst), node_f4(fact)) }
    Block(first, rest) -> pipeline_return_expr_type_node_typed(rest, params, locals, module)
    -- A body that returns its own binding types as the binding's init:
    -- transfer retains for match-arm-local bindings depend on this (the
    -- binding is not in the fn-level locals env at transfer time).
    Let(ns, nl, value, body) -> {
      let body_ty = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if body_ty != 0 { body_ty }
      else {
        if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 {
          pipeline_return_expr_type_node_typed(value, params, locals, module)
        } else { 0 }
      }
    }
    LetMut(ns, nl, value, body) -> {
      let body_ty = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if body_ty != 0 { body_ty }
      else {
        if pipeline_expr_final_returns_binding_typed(body, src, ns, nl) == 1 {
          pipeline_return_expr_type_node_typed(value, params, locals, module)
        } else { 0 }
      }
    }
    LetTyped(inner, ann_type) -> type_expr_to_node(ann_type)
    Defer(cleanup, body) -> pipeline_return_expr_type_node_typed(body, params, locals, module)
    Resume(value) -> pipeline_return_expr_type_node_typed(value, params, locals, module)
    Handle(body, clauses, hret) -> {
      match hret {
        NoHandleReturn -> pipeline_return_expr_type_node_typed(body, params, locals, module)
        HandleReturnClause(rns, rnl, rb) -> pipeline_return_expr_type_node_typed(rb, params, locals, module)
      }
    }
    If(cond, then_expr, else_expr) -> {
      let then_ty = pipeline_return_expr_type_node_typed(then_expr, params, locals, module)
      let else_ty = pipeline_return_expr_type_node_typed(else_expr, params, locals, module)
      if then_ty != 0 and else_ty != 0 and type_hash_of(then_ty) == type_hash_of(else_ty) { then_ty } else { 0 }
    }
    Match(scrutinee, arms) -> {
      let scrutinee_ty = pipeline_return_expr_type_node_typed(scrutinee, params, locals, module)
      pipeline_match_arms_result_type_node_with_scrutinee_typed(arms, params, locals, module, scrutinee_ty)
    }
    Lambda(lambda_params, body) -> pipeline_lambda_type_node_typed(lambda_params, body, params, locals, module)
    _ -> pipeline_expr_type_node_typed(expr)
  }
}

-- Index of a named binding within a ctor pattern's binding list, or -1.
fn pipeline_pattern_binding_index(bindings: PatternList, src: i64, ns: i64, nl: i64, index: i64) -> i64 {
  match bindings {
    PatternListNil -> 0 - 1
    PatternListCons(binding, rest) -> {
      let found = match binding {
        Binding(bns, bnl) -> pipeline_name_matches(src, ns, nl, bns, bnl)
        _ -> 0
      }
      if found == 1 { index } else { pipeline_pattern_binding_index(rest, src, ns, nl, index + 1) }
    }
  }
}

-- Result type of a match arm. The accessor shape — an arm body that
-- returns a ctor-pattern payload binding — resolves the Ident against
-- the ctor's payload types (2q slice 2): the ownership machinery needs
-- Named payload types to classify accessor returns as managed borrows,
-- or the transfer retain never fires while callee/caller releases do.
fn pipeline_match_arm_result_type_node_typed(arm: MatchArm, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match arm {
    Arm(pattern, body, guard, has_guard) -> {
      let direct = pipeline_return_expr_type_node_typed(body, params, locals, module)
      if direct != 0 { direct }
      else {
        let src = pipeline_lower_module_src(module)
        let payload_ty = match pattern {
          CtorPattern(tag_ns, tag_nl, bindings) -> {
            match body {
              Ident(ns, nl) -> {
                let idx = pipeline_pattern_binding_index(bindings, src, ns, nl, 0)
                if idx < 0 { 0 }
                else {
                  let payload_types = pipeline_variant_payload_types(pipeline_lower_module_tt(module), src, tag_ns, tag_nl)
                  pipeline_expected_arg_type_node(0, payload_types, idx, 0, pipeline_lower_module_subst(module))
                }
              }
              _ -> 0
            }
          }
          _ -> 0
        }
        if payload_ty != 0 { payload_ty }
        else {
          -- Payload-less variant ctors in arm position are Ident-shaped
          -- (e.g. `UnknownHandlerClause(tag) -> ParamListNil`): resolve
          -- them here so accessors' arms agree on the type and the
          -- transfer retain fires. Scoped to match arms on purpose —
          -- resolving ctor Idents in general expression positions
          -- changes if-arm mixedness and emission broadly.
          match body {
            Ident(ns, nl) -> pipeline_variant_parent_type_node(pipeline_lower_module_tt(module), src, ns, nl)
            _ -> 0
          }
        }
      }
    }
    UnknownArm(tag) -> 0
  }
}

fn pipeline_match_arm_result_type_node_with_scrutinee_typed(arm: MatchArm, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, scrutinee_ty: i64) -> i64 {
  let direct = pipeline_match_arm_result_type_node_typed(arm, params, locals, module)
  if direct != 0 {
    match arm {
      Arm(pattern, body, guard, has_guard) -> match pattern {
        CtorPattern(tag_ns, tag_nl, bindings) -> {
          let subst = pipeline_match_variant_instance_subst(
            pipeline_lower_module_tt(module),
            pipeline_lower_module_src(module),
            tag_ns,
            tag_nl,
            scrutinee_ty,
            pipeline_lower_module_subst(module)
          )
          if subst == 0 { direct } else { ty_subst(direct, subst) }
        }
        _ -> direct
      }
      UnknownArm(tag) -> direct
    }
  }
  else {
    match arm {
      Arm(pattern, body, guard, has_guard) -> {
        match pattern {
          Binding(ns, nl) -> {
            if pipeline_expr_final_returns_binding_typed(body, pipeline_lower_module_src(module), ns, nl) == 1 { scrutinee_ty } else { 0 }
          }
          _ -> 0
        }
      }
      UnknownArm(tag) -> 0
    }
  }
}

fn pipeline_match_arms_result_type_node_typed(arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let ty = pipeline_match_arm_result_type_node_typed(arm, params, locals, module)
      if ty == 0 { 0 }
      else {
        match rest {
          MatchArmListNil -> ty
          MatchArmListCons(next_arm, next_rest) -> {
            let rest_ty = pipeline_match_arms_result_type_node_typed(rest, params, locals, module)
            if rest_ty != 0 and type_hash_of(rest_ty) == type_hash_of(ty) { ty } else { 0 }
          }
        }
      }
    }
  }
}

fn pipeline_match_arms_result_type_node_with_scrutinee_typed(arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, scrutinee_ty: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let ty = pipeline_match_arm_result_type_node_with_scrutinee_typed(arm, params, locals, module, scrutinee_ty)
      if ty == 0 { 0 }
      else {
        match rest {
          MatchArmListNil -> ty
          MatchArmListCons(next_arm, next_rest) -> {
            let rest_ty = pipeline_match_arms_result_type_node_with_scrutinee_typed(rest, params, locals, module, scrutinee_ty)
            if rest_ty != 0 and type_hash_of(rest_ty) == type_hash_of(ty) { ty } else { 0 }
          }
        }
      }
    }
  }
}

fn pipeline_return_expr_type_node_from_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_return_expr_type_node_typed(expr_from_node(stripped), params, locals, module) }
}

-- Binding-init type inference: like the return-expr inference plus a
-- payload-less-ctor fallback (let mut t = DNil is Ident-shaped). The
-- fallback is scoped to INIT positions on purpose — resolving ctor
-- Idents in general expression positions flips if-arm mixedness and
-- changes emission broadly.
fn pipeline_init_type_node_typed(init_expr: Expr, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let direct = pipeline_return_expr_type_node_typed(init_expr, params, locals, module)
  if direct != 0 { direct }
  else {
    match init_expr {
      Ident(ns, nl) -> pipeline_variant_parent_type_node(pipeline_lower_module_tt(module), pipeline_lower_module_src(module), ns, nl)
      _ -> 0
    }
  }
}

fn pipeline_init_type_node_from_node(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let stripped = pipeline_expr_node_strip_typed(expr)
  if stripped == 0 { 0 } else { pipeline_init_type_node_typed(expr_from_node(stripped), params, locals, module) }
}

fn pipeline_lower_return_transfer_typed_with_ty(value_expr: Expr, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, forced_ty: i64) -> IrLoweredExpr {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let inferred_ty = pipeline_return_expr_type_node_typed(value_expr, params, locals, module)
  let ty = if forced_ty != 0 { forced_ty } else { inferred_ty }
  let retain = if ty != 0 and ty_is_continuation(ty) == 0 and pipeline_expr_result_is_borrowed_for_ty_typed(value_expr, ty, src, fns, subst, pipeline_lower_module_tt(module)) == 1 {
    pipeline_managed_retain_inst_list(value, ty, next_value)
  } else {
    ir_inst_list_empty()
  }
  let after_retain = next_value + ir_inst_list_len(retain)
  -- The local-release half exists only to balance the transfer retain
  -- above. A let whose final binding already transfers an owned count
  -- needs neither operation; releasing without a retain returns a
  -- zero-count payload to the caller.
  let release = if ir_inst_list_len(retain) > 0 and pipeline_expr_final_returns_non_param_ident_typed(value_expr, params, src) == 1 {
    pipeline_managed_release_inst_list(value, ty, after_retain)
  } else {
    ir_inst_list_empty()
  }
  let after_release = after_retain + ir_inst_list_len(release)
  ir_lowered_expr(value, after_release, ir_inst_list_append(retain, release))
}

fn pipeline_lower_return_transfer_typed(value_expr: Expr, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  pipeline_lower_return_transfer_typed_with_ty(value_expr, value, next_value, params, locals, module, 0)
}

fn pipeline_lower_return_transfer_from_node(value_expr: i64, value: i64, next_value: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> IrLoweredExpr {
  let src = pipeline_lower_module_src(module)
  let fns = pipeline_lower_module_fns(module)
  let subst = pipeline_lower_module_subst(module)
  let ty = pipeline_return_expr_type_node_from_node(value_expr, params, locals, module)
  let retain = if ty != 0 and ty_is_continuation(ty) == 0 and pipeline_expr_node_result_is_borrowed_for_ty_typed(value_expr, ty, src, fns, subst, pipeline_lower_module_tt(module)) == 1 {
    pipeline_managed_retain_inst_list(value, ty, next_value)
  } else {
    ir_inst_list_empty()
  }
  let after_retain = next_value + ir_inst_list_len(retain)
  let release = if ir_inst_list_len(retain) > 0 and pipeline_expr_node_final_returns_non_param_ident(value_expr, params, src) == 1 {
    pipeline_managed_release_inst_list(value, ty, after_retain)
  } else {
    ir_inst_list_empty()
  }
  let after_release = after_retain + ir_inst_list_len(release)
  ir_lowered_expr(value, after_release, ir_inst_list_append(retain, release))
}

