      41 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), node_f2(expr), pipeline_expr_node_list_subst_types(node_f3(expr), nlist_len(node_f3(expr)), subst), method_ref_subst(node_f4(expr), subst))
      45 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), node_f2(expr), node_f3(expr), node_f4(expr))
      46 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), pipeline_expr_node_subst_types(node_f2(expr), subst), node_f3(expr), node_f4(expr))
      47 -> node_new(tag, node_f1(expr), node_f2(expr), pipeline_expr_node_subst_types(node_f3(expr), subst), pipeline_expr_node_subst_types(node_f4(expr), subst))
      48 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), node_f2(expr), node_f3(expr), node_f4(expr))
      49 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), node_f2(expr), node_f3(expr), node_f4(expr))
      52 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), pipeline_expr_node_subst_types(node_f2(expr), subst), node_f3(expr), node_f4(expr))
      55 -> node_new(tag, node_f1(expr), pipeline_expr_node_subst_types(node_f2(expr), subst), node_f3(expr), node_f4(expr))
      56 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), node_f2(expr), node_f3(expr), node_f4(expr))
      57 -> node_new(tag, pipeline_expr_node_subst_types(node_f1(expr), subst), pipeline_expr_node_subst_types(node_f2(expr), subst), node_f3(expr), node_f4(expr))
      _ -> expr
    }
  }
}





pub(package) fn pipeline_lambda_ir_params_subst(params: ParamList, subst: i64) -> ParamList {
  if subst == 0 { params } else { param_list_from_param_nodes(cg_params_subst(param_list_to_nodes(params), subst)) }
}

pub(package) fn pipeline_lambda_ir_body_subst(body: Expr, subst: i64) -> Expr {
  if subst == 0 { body } else { expr_from_node(pipeline_expr_node_subst_types(expr_to_node(body), subst)) }
}

pub(package) fn pipeline_call_inst_resolved(dst: i64, direct: i64, indirect_callee: i64, src: i64, tt: i64, fns: i64, ns: i64, nl: i64, subst: i64, args: IrValueList, result_ty: i64) -> IrInst {
  if direct == 1 {
    pipeline_direct_call_inst(dst, src, tt, fns, ns, nl, subst, args)
  } else {
    ir_inst_indirect_call_i64(dst, indirect_callee, args, result_ty)
  }
}

pub(package) fn pipeline_perform_inst(dst: i64, src: i64, lhs: i64, op_ns: i64, op_nl: i64, args: IrValueList) -> IrInst {
  ir_inst_perform_i64(dst, effect_name_hash(src, node_f1(lhs), node_f2(lhs)), effect_name_hash(src, op_ns, op_nl), args)
}

-- Effect operations are typed call boundaries: a by-value linear argument
-- moves into the selected handler clause exactly as it moves into an ordinary
-- function parameter. Preserve that producer fact explicitly in IR because
-- effect dispatch has no callee declaration hash from which native emission
-- could recover the parameter types.
pub(package) fn pipeline_effect_linear_transfer_insts_typed(
  exprs: ExprList,
  expected_params: i64,
  index: i64,
  arg_word: i64,
  args: IrValueList,
  params: i64,
  locals: PipelineValueEnv,
  module: PipelineLowerModule
) -> IrInstList {
  match exprs {
    ExprListNil -> ir_inst_list_empty()
    ExprListCons(expr, rest_exprs) -> {
      if expected_params == 0 or index >= nlist_len(expected_params) { ir_inst_list_empty() }
      else {
        let expected_ty = node_f3(nlist_get(expected_params, index))
        let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
        let actual_ty = pipeline_return_expr_type_node_typed(expr, params, locals, module)
        let plan = if actual_ty == 0 {
          pipeline_linear_cleanup_plan(pipeline_lower_module_tt(module), expected_ty)
        } else {
          pipeline_linear_cleanup_plan(pipeline_lower_module_tt(module), actual_ty)
        }
        let tail = pipeline_effect_linear_transfer_insts_typed(
          rest_exprs, expected_params, index + 1, arg_word + lanes, args,
          params, locals, module
        )
        let value = pipeline_ir_value_list_get_or(args, arg_word, 0 - 1)
        if plan == 0 or value < 0 { tail }
        else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(value, plan), tail) }
      }
    }
  }
}

pub(package) fn pipeline_effect_linear_transfer_insts_node(
  exprs: i64,
  expr_count: i64,
  expected_params: i64,
  index: i64,
  arg_word: i64,
  args: IrValueList,
  lower_ctx: PipelineHandlerLowerCtx
) -> IrInstList {
  if index >= expr_count or expected_params == 0 or index >= nlist_len(expected_params) {
    ir_inst_list_empty()
  } else {
    let expected_ty = node_f3(nlist_get(expected_params, index))
    let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
    let actual_ty = pipeline_return_expr_type_node_from_node(
      nlist_get(exprs, index),
      pipeline_handler_lower_ctx_params(lower_ctx),
      pipeline_handler_lower_ctx_locals(lower_ctx),
      pipeline_handler_lower_ctx_module(lower_ctx)
    )
    let plan = if actual_ty == 0 {
      pipeline_linear_cleanup_plan(pipeline_handler_lower_ctx_tt(lower_ctx), expected_ty)
    } else {
      pipeline_linear_cleanup_plan(pipeline_handler_lower_ctx_tt(lower_ctx), actual_ty)
    }
    let tail = pipeline_effect_linear_transfer_insts_node(
      exprs, expr_count, expected_params, index + 1, arg_word + lanes, args, lower_ctx
    )
    let value = pipeline_ir_value_list_get_or(args, arg_word, 0 - 1)
    if plan == 0 or value < 0 { tail }
    else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(value, plan), tail) }
  }
}

-- Effect dispatch is an owned ABI boundary just like a function call. The
-- selected handler owns every by-value managed lane as soon as the operation
-- is performed, including an owned rvalue whose producing continuation may
-- later be dropped. Preserve that transfer explicitly so suspended cleanup
-- cannot release the caller's former stake after the handler has received it.
-- A negative callee sentinel is disjoint from direct and indirect calls while
-- the nonnegative destination and lane still bind the marker to the exact
-- immediately following perform instruction.
pub(package) fn pipeline_effect_managed_transfer_hash() -> i64 {
  0 - 1
}

-- Lowering-owned direct transfers survive semantic call rewrites such as
-- generic, callback-identity, and consuming specialisation. Their checked
-- parameter lane and immediately following destination/value association are
-- stable; a dedicated sentinel avoids pretending the pre-rewrite callee hash
-- remains the semantic authority after those transformations.
pub(package) fn pipeline_direct_managed_transfer_hash() -> i64 {
  0 - 2
}

pub(package) fn pipeline_effect_managed_transfer_lane_insts(expected_ty: i64, lane: i64, lanes: i64, arg_word: i64, args: IrValueList, perform_dst: i64) -> IrInstList {
  if lane >= lanes { ir_inst_list_empty() }
  else {
    let rest = pipeline_effect_managed_transfer_lane_insts(expected_ty, lane + 1, lanes, arg_word, args, perform_dst)
    let cleanup_kind = pipeline_type_value_lane_release_kind(expected_ty, lane)
    let value = pipeline_ir_value_list_get_or(args, arg_word + lane, 0 - 1)
    if cleanup_kind == continuation_cleanup_kind_none() or value < 0 { rest }
    else { ir_inst_list_prepend(IrManagedTransferI64(perform_dst, pipeline_effect_managed_transfer_hash(), value, arg_word + lane, cleanup_kind), rest) }
  }
}

pub(package) fn pipeline_effect_managed_transfer_insts(expected_params: i64, index: i64, arg_word: i64, args: IrValueList, perform_dst: i64) -> IrInstList {
  if expected_params == 0 or index >= nlist_len(expected_params) { ir_inst_list_empty() }
  else {
    let expected_ty = node_f3(nlist_get(expected_params, index))
    let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
    let current = pipeline_effect_managed_transfer_lane_insts(expected_ty, 0, lanes, arg_word, args, perform_dst)
    let rest = pipeline_effect_managed_transfer_insts(expected_params, index + 1, arg_word + lanes, args, perform_dst)
    ir_inst_list_append(current, rest)
  }
}

-- Function values erase the concrete callee hash, but their checked function
-- type still gives every physical parameter lane and cleanup kind. Record the
-- ABI-entry ownership transfer explicitly so abort/cancellation cleanup can
-- disarm the caller stake before an indirect callee takes responsibility for
-- it. A zero callee hash distinguishes this marker from direct-call transfers;
-- the nonnegative call destination and argument lane distinguish it from the
-- aggregate-commit sentinel.
pub(package) fn pipeline_indirect_managed_transfer_lane_insts(expected_ty: i64, lane: i64, lanes: i64, arg_word: i64, args: IrValueList, call_dst: i64) -> IrInstList {
  if lane >= lanes { ir_inst_list_empty() }
  else {
    let rest = pipeline_indirect_managed_transfer_lane_insts(expected_ty, lane + 1, lanes, arg_word, args, call_dst)
    let cleanup_kind = pipeline_type_value_lane_release_kind(expected_ty, lane)
    let value = pipeline_ir_value_list_get_or(args, arg_word + lane, 0 - 1)
    if cleanup_kind == continuation_cleanup_kind_none() or value < 0 { rest }
    else { ir_inst_list_prepend(IrManagedTransferI64(call_dst, 0, value, arg_word + lane, cleanup_kind), rest) }
  }
}

pub(package) fn pipeline_indirect_managed_transfer_insts(expected_types: i64, expected_subst: i64, index: i64, arg_word: i64, args: IrValueList, call_dst: i64) -> IrInstList {
  if expected_types == 0 or index >= nlist_len(expected_types) { ir_inst_list_empty() }
  else {
    let raw_ty = nlist_get(expected_types, index)
    let expected_ty = if expected_subst == 0 { raw_ty } else { ty_subst(raw_ty, expected_subst) }
    let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
    let current = pipeline_indirect_managed_transfer_lane_insts(expected_ty, 0, lanes, arg_word, args, call_dst)
    let rest = pipeline_indirect_managed_transfer_insts(expected_types, expected_subst, index + 1, arg_word + lanes, args, call_dst)
    ir_inst_list_append(current, rest)
  }
}

-- Direct calls retain their typed parameter contract only while lowering.
-- Preserve each by-value managed ABI lane in IR before generic
-- monomorphisation replaces the source callable identity with a specialised
-- hash. Native emission can then implement the exact two-phase transfer:
-- keep the caller's stake armed while the callee may abort, and retire it
-- only after a normal return.
pub(package) fn pipeline_direct_managed_transfer_call_dst_or(call: IrInst, default: i64) -> i64 {
  match call {
    IrCallI64(dst, callee_hash, args) -> dst
    IrGenericCallI64(dst, callee_hash, type_args, args) -> dst
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> dst
    _ -> default
  }
}

pub(package) fn pipeline_direct_managed_transfer_call_hash(call: IrInst) -> i64 {
  match call {
    IrCallI64(dst, callee_hash, args) -> callee_hash
    IrGenericCallI64(dst, callee_hash, type_args, args) -> mono_spec_hash(callee_hash, type_expr_list_to_nodes(type_args))
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> pipeline_ir_method_patch_key(type_hash, method_hash)
    _ -> 0
  }
}

pub(package) fn pipeline_direct_managed_transfer_call_args(call: IrInst) -> IrValueList {
  match call {
    IrCallI64(dst, callee_hash, args) -> args
    IrGenericCallI64(dst, callee_hash, type_args, args) -> args
    IrMethodCallI64(dst, type_hash, method_hash, receiver, args) -> ir_value_list_prepend(receiver, args)
    _ -> ir_value_list_empty()
  }
}

pub(package) fn pipeline_direct_managed_transfer_lane_insts(expected_ty: i64, lane: i64, lanes: i64, arg_word: i64, args: IrValueList, call_dst: i64) -> IrInstList {
  if lane >= lanes { ir_inst_list_empty() }
  else {
    let rest = pipeline_direct_managed_transfer_lane_insts(expected_ty, lane + 1, lanes, arg_word, args, call_dst)
    let cleanup_kind = pipeline_type_value_lane_release_kind(expected_ty, lane)
    let value = pipeline_ir_value_list_get_or(args, arg_word + lane, 0 - 1)
    if cleanup_kind == continuation_cleanup_kind_none() or value < 0 { rest }
    else { ir_inst_list_prepend(IrManagedTransferI64(call_dst, pipeline_direct_managed_transfer_hash(), value, arg_word + lane, cleanup_kind), rest) }
  }
}

pub(package) fn pipeline_direct_managed_transfer_param_insts(expected_params: i64, expected_subst: i64, borrowed_mask: i64, index: i64, arg_word: i64, args: IrValueList, call_dst: i64, tt: i64) -> IrInstList {
  if expected_params == 0 or index >= nlist_len(expected_params) { ir_inst_list_empty() }
  else {
    let raw_ty = node_f3(nlist_get(expected_params, index))
    let expected_ty = if expected_subst == 0 { raw_ty } else { ty_subst(raw_ty, expected_subst) }
    let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
    let current = if cg_mask_has(borrowed_mask, index) == 0 and
      not ty_is_borrow(expected_ty) and
      pipeline_linear_cleanup_plan(tt, expected_ty) == 0 {
      pipeline_direct_managed_transfer_lane_insts(expected_ty, 0, lanes, arg_word, args, call_dst)
    } else { ir_inst_list_empty() }
    let rest = pipeline_direct_managed_transfer_param_insts(expected_params, expected_subst, borrowed_mask, index + 1, arg_word + lanes, args, call_dst, tt)
    ir_inst_list_append(current, rest)
  }
}

pub(package) fn pipeline_direct_managed_transfer_insts(expected_params: i64, expected_subst: i64, borrowed_mask: i64, call: IrInst, tt: i64) -> IrInstList {
  let call_dst = pipeline_direct_managed_transfer_call_dst_or(call, 0 - 1)
  let callee_hash = pipeline_direct_managed_transfer_call_hash(call)
  if call_dst < 0 or callee_hash == 0 { ir_inst_list_empty() }
  else {
    pipeline_direct_managed_transfer_param_insts(
      expected_params, expected_subst, borrowed_mask, 0, 0,
      pipeline_direct_managed_transfer_call_args(call), call_dst, tt
    )
  }
}

-- Method lowering knows the receiver expression's exact type, including every
-- generic opaque argument. Preserve that semantic identity at the call site:
-- reconstructing an owned receiver later from the nominal method pair loses
-- information needed to select the exact Drop specialisation.
pub(package) fn pipeline_method_receiver_linear_transfer_insts_typed(
  recv_expr: Expr,
  receiver: i64,
  method_params: i64,
  params: i64,
  locals: PipelineValueEnv,
  module: PipelineLowerModule
) -> IrInstList {
  if method_params == 0 or nlist_len(method_params) == 0 { ir_inst_list_empty() }
  else {
    let self_ty = node_f3(nlist_get(method_params, 0))
    if ty_is_borrow(self_ty) { ir_inst_list_empty() }
    else {
      let actual_ty = pipeline_return_expr_type_node_typed(recv_expr, params, locals, module)
      let plan = pipeline_linear_cleanup_plan(pipeline_lower_module_tt(module), actual_ty)
      if plan == 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(receiver, plan), ir_inst_list_empty()) }
    }
  }
}

pub(package) fn pipeline_method_receiver_linear_transfer_insts_node(
  recv_node: i64,
  receiver: i64,
  method_params: i64,
  lower_ctx: PipelineHandlerLowerCtx
) -> IrInstList {
  if method_params == 0 or nlist_len(method_params) == 0 { ir_inst_list_empty() }
  else {
    let self_ty = node_f3(nlist_get(method_params, 0))
    if ty_is_borrow(self_ty) { ir_inst_list_empty() }
    else {
      let actual_ty = pipeline_return_expr_type_node_from_node(
        recv_node,
        pipeline_handler_lower_ctx_params(lower_ctx),
        pipeline_handler_lower_ctx_locals(lower_ctx),
        pipeline_handler_lower_ctx_module(lower_ctx)
      )
      let plan = pipeline_linear_cleanup_plan(pipeline_handler_lower_ctx_tt(lower_ctx), actual_ty)
      if plan == 0 { ir_inst_list_empty() }
      else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(receiver, plan), ir_inst_list_empty()) }
    }
  }
}

-- Aggregate construction moves each payload into the enclosing value. The
-- payload expression's actual cleanup plan is the source obligation: its
-- declared field type determines ABI lane placement, but may intentionally
-- differ at an ownership boundary such as T -> owned T.
pub(package) fn pipeline_aggregate_linear_transfer_insts_typed(
  exprs: ExprList,
  expected_types: i64,
  expected_subst: i64,
  index: i64,
  arg_word: i64,
  args: IrValueList,
  params: i64,
  locals: PipelineValueEnv,
  module: PipelineLowerModule
) -> IrInstList {
  match exprs {
    ExprListNil -> ir_inst_list_empty()
    ExprListCons(expr, rest_exprs) -> {
      if expected_types == 0 or index >= nlist_len(expected_types) { ir_inst_list_empty() }
      else {
        let raw_expected_ty = nlist_get(expected_types, index)
        let expected_ty = if expected_subst == 0 { raw_expected_ty } else { ty_subst(raw_expected_ty, expected_subst) }
        let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
        let actual_ty = pipeline_return_expr_type_node_typed(expr, params, locals, module)
        let plan = if actual_ty == 0 {
          pipeline_linear_cleanup_plan(pipeline_lower_module_tt(module), expected_ty)
        } else {
          pipeline_linear_cleanup_plan(pipeline_lower_module_tt(module), actual_ty)
        }
        let tail = pipeline_aggregate_linear_transfer_insts_typed(
          rest_exprs, expected_types, expected_subst, index + 1, arg_word + lanes,
          args, params, locals, module
        )
        let value = pipeline_ir_value_list_get_or(args, arg_word, 0 - 1)
        if plan == 0 or value < 0 { tail }
        else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(value, plan), tail) }
      }
    }
  }
}

pub(package) fn pipeline_aggregate_linear_transfer_insts_node(
  exprs: i64,
  expr_count: i64,
  expected_types: i64,
  expected_subst: i64,
  index: i64,
  arg_word: i64,
  args: IrValueList,
  lower_ctx: PipelineHandlerLowerCtx
) -> IrInstList {
  if index >= expr_count or expected_types == 0 or index >= nlist_len(expected_types) {
    ir_inst_list_empty()
  } else {
    let raw_expected_ty = nlist_get(expected_types, index)
    let expected_ty = if expected_subst == 0 { raw_expected_ty } else { ty_subst(raw_expected_ty, expected_subst) }
    let lanes = pipeline_type_value_lane_count_or_one(expected_ty)
    let actual_ty = pipeline_return_expr_type_node_from_node(
      nlist_get(exprs, index),
      pipeline_handler_lower_ctx_params(lower_ctx),
      pipeline_handler_lower_ctx_locals(lower_ctx),
      pipeline_handler_lower_ctx_module(lower_ctx)
    )
    let plan = if actual_ty == 0 {
      pipeline_linear_cleanup_plan(pipeline_handler_lower_ctx_tt(lower_ctx), expected_ty)
    } else {
      pipeline_linear_cleanup_plan(pipeline_handler_lower_ctx_tt(lower_ctx), actual_ty)
    }
    let tail = pipeline_aggregate_linear_transfer_insts_node(
      exprs, expr_count, expected_types, expected_subst, index + 1,
      arg_word + lanes, args, lower_ctx
    )
    let value = pipeline_ir_value_list_get_or(args, arg_word, 0 - 1)
    if plan == 0 or value < 0 { tail }
    else { ir_inst_list_prepend(ir_inst_linear_effect_transfer_i64(value, plan), tail) }
  }
}

-- Indirect calls have no declaration parameter list, but their checked
-- function type still supplies exact substituted argument types. Move every
-- linear argument obligation at that ABI boundary just as direct calls do;
-- otherwise an aborting callback leaves both its parameter and the caller's
-- former argument armed.
pub(package) fn pipeline_indirect_linear_transfer_insts_typed(
  exprs: ExprList,
  expected_types: i64,
  expected_subst: i64,
  args: IrValueList,
  params: i64,
  locals: PipelineValueEnv,
  module: PipelineLowerModule
) -> IrInstList {
  pipeline_aggregate_linear_transfer_insts_typed(
    exprs, expected_types, expected_subst, 0, 0, args,
    params, locals, module
  )
}

pub(package) fn pipeline_indirect_linear_transfer_insts_node(
  exprs: i64,
  expr_count: i64,
  expected_types: i64,
  expected_subst: i64,
  args: IrValueList,
  lower_ctx: PipelineHandlerLowerCtx
) -> IrInstList {
  pipeline_aggregate_linear_transfer_insts_node(
    exprs, expr_count, expected_types, expected_subst, 0, 0, args, lower_ctx
  )
}

-- Opaque construction is a typed ownership boundary even though it emits no
-- runtime representation change. Replace the representation's exact cleanup
-- obligation with the opaque wrapper's obligation at that boundary so an
-- abort during later argument evaluation observes exactly one owner.
pub(package) fn pipeline_linear_rewrap_insts(value: i64, source_ty: i64, target_ty: i64, tt: i64) -> IrInstList {
  let source_plan = pipeline_linear_cleanup_plan(tt, source_ty)
  let target_plan = pipeline_linear_cleanup_plan(tt, target_ty)
  if target_plan == 0 { ir_inst_list_empty() }
  else {
    let acquire = ir_inst_list_prepend(
      ir_inst_linear_rewrap_acquire_i64(value, target_plan), ir_inst_list_empty()
    )
    if source_plan == 0 { acquire }
    else {
      ir_inst_list_prepend(
        ir_inst_linear_effect_transfer_i64(value, source_plan), acquire
      )
    }
  }
}

pub(package) fn pipeline_lower_internal_block_after_target(next_block: i64, target_block: i64) -> i64 {
  if next_block <= target_block { target_block + 1 } else { next_block }
}

pub(package) fn pipeline_lower_operation_child_start_block(operation_block: i64, child_count: i64) -> i64 {
  if child_count <= 0 { operation_block } else { operation_block + 1 }
}

pub(package) fn pipeline_lower_operation_next_block(next_block: i64, operation_block: i64) -> i64 {
  pipeline_ir_max_i64(next_block, operation_block + 1)
}

pub(package) fn pipeline_field_access_index(expr: i64) -> i64 {
  if node_f4(expr) > 0 { node_f4(expr) - 1 } else { 0 - 1 }
}

pub(package) fn pipeline_opt_chain_field_index(expr: i64, src: i64, tt: i64) -> i64 {
  if tt == 0 { 0 - 1 } else { pipeline_type_find_any_field_index(tt, src, node_f2(expr), node_f3(expr)) }
}

-- Match-on-rvalue scrutinee release (managed aggregate cleanup): an owned
-- rvalue scrutinee (call/ctor result) is consumed by the match — its
-- count must drop at the merge or every such match leaks a node.
-- An owned-rvalue match is itself ownership-normalised: every borrowed
-- arm retains on its way to the merge, so releasing the root cannot
-- invalidate an extracted payload and the merged result carries the
-- count its consumers expect.
pub(package) fn pipeline_match_arms_have_binding_pattern(arms: MatchArmList) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let found = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          match pattern {
            Binding(ns, nl) -> 1
            _ -> 0
          }
        }
        UnknownArm(tag) -> 0
      }
      if found == 1 { 1 } else { pipeline_match_arms_have_binding_pattern(rest) }
    }
  }
}

-- Any arm whose result is a borrowed value that would reach the merge
-- without its own count. Per-arm retains fire only when the whole
-- match classifies owned AND the arm type resolves, so an arm is
-- unprotected when it is borrowed and either its type is unresolvable
-- or (the type is managed and the whole match classifies borrowed).
-- Under deep release, freeing the scrutinee kills its payloads, so an
-- unprotected borrowed return would dangle — the release must not
-- fire (bounded leak instead).
pub(package) fn pipeline_match_arms_any_unprotected_borrow(arms: MatchArmList, whole_borrowed: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, src: i64, fns: i64, subst: i64, scrutinee_ty: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let unsafe_arm = match arm {
        Arm(pattern, body, guard, has_guard) -> {
          let ty = pipeline_match_arm_result_type_node_with_scrutinee_typed(arm, params, locals, module, scrutinee_ty)
          if pipeline_expr_result_is_borrowed_for_ty_typed(body, ty, src, fns, subst, pipeline_lower_module_tt(module)) == 0 { 0 }
          else {
            if ty == 0 { 1 }
            else { if ty_value_has_release_lane(ty) == 1 and whole_borrowed == 1 { 1 } else { 0 } }
          }
        }
        UnknownArm(tag) -> 1
      }
      if unsafe_arm == 1 { 1 } else { pipeline_match_arms_any_unprotected_borrow(rest, whole_borrowed, params, locals, module, src, fns, subst, scrutinee_ty) }
    }
  }
}

pub(package) fn pipeline_match_scrutinee_release_type(scrutinee: Expr, arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule) -> i64 {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let ty = pipeline_return_expr_type_node_typed(scrutinee, params, locals, module)
  let is_owned = if pipeline_expr_owned_rvalue_temp_typed(scrutinee, src, tt) == 1 { 1 }
    else { pipeline_expr_owned_array_value_typed(scrutinee, ty, src, pipeline_lower_module_fns(module), pipeline_lower_module_subst(module), tt) }
  if is_owned == 0 { 0 }
  else {
    -- Linear pattern ownership consumes or residualises the aggregate
    -- backing itself. Scheduling the ordinary managed-rvalue release as
    -- well double-releases that backing after an owned payload is moved.
    if pipeline_linear_cleanup_plan(tt, ty) != 0 { 0 }
    else {
      let fns = pipeline_lower_module_fns(module)
      let subst = pipeline_lower_module_subst(module)
      let blocked = pipeline_match_arms_any_unprotected_borrow(arms, 0, params, locals, module, src, fns, subst, ty)
      if blocked == 1 { 0 }
      else {
        if ty != 0 and ty_value_has_release_lane(ty) == 1 { ty } else { 0 }
      }
    }
  }
}

-- Interposes a release block between the match arms and their merge
-- target: takes the merged result as its param, releases the scrutinee
-- temp, forwards the result. Mirrors pipeline_managed_arm_retain_append.
pub(package) fn pipeline_ir_first_jump_arg_count_to_target(blocks: IrBlockList, target_block: i64, default: i64) -> i64 {
  match blocks {
    IrBlockListNil -> default
    IrBlockListCons(block, rest) -> match block {
      IrBlock(id, params, insts, term) -> match term {
        IrTermJump(target, args) -> if target == target_block { ir_value_list_len(args) } else { pipeline_ir_first_jump_arg_count_to_target(rest, target_block, default) }
        _ -> pipeline_ir_first_jump_arg_count_to_target(rest, target_block, default)
      }
    }
  }
}

-- A scope-cleanup block is an IR materialisation boundary, so its carried
-- width must follow the already-lowered incoming edge. Source expression
-- inference can be deliberately conservative across imported constructors;
-- using that fallback alone silently narrows a wide result before cleanup.
pub(package) fn pipeline_ir_cleanup_carried_lane_count(body_blocks: PipelineLoweredBlocks, cleanup_block: i64, inferred_lanes: i64, wrapped: i64) -> i64 {
  if pipeline_lowered_blocks_falls_through(body_blocks) == 0 { 0 }
  else { if wrapped == 1 {
    pipeline_ir_first_jump_arg_count_to_target(pipeline_lowered_blocks_blocks(body_blocks), cleanup_block, inferred_lanes)
  } else { inferred_lanes } }
}

pub(package) fn pipeline_ir_block_list_append_return_scrutinee_cleanup(blocks: IrBlockList, scrutinee_value: i64, release_ty: i64, base_dst: i64, index: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = match block {
        IrBlock(id, params, insts, term) -> match term { IrTermReturn(value) -> 1 _ -> 0 }
      }
      let patched = if applies == 1 {
        let cleanup = pipeline_managed_release_inst_list_with_origin(
          scrutinee_value, release_ty,
          base_dst + index * pipeline_type_managed_release_lane_count(release_ty),
          ir_managed_stake_origin_control()
        )
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, cleanup), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_return_scrutinee_cleanup(rest, scrutinee_value, release_ty, base_dst, index + applies)
      )
    }
  }
}

pub(package) fn pipeline_ir_block_list_append_loop_scrutinee_cleanup(blocks: IrBlockList, scrutinee_value: i64, release_ty: i64, base_dst: i64, index: i64, continue_block: i64, target_block: i64) -> IrBlockList {
  match blocks {
    IrBlockListNil -> IrBlockListNil
    IrBlockListCons(block, rest) -> {
      let applies = match block {
        IrBlock(id, params, insts, term) -> pipeline_ir_term_jumps_to_loop_control(term, continue_block, target_block)
      }
      let patched = if applies == 1 {
        let cleanup = pipeline_managed_release_inst_list_with_origin(
          scrutinee_value, release_ty,
          base_dst + index * pipeline_type_managed_release_lane_count(release_ty),
          ir_managed_stake_origin_control()
        )
        match block {
          IrBlock(id, params, insts, term) -> IrBlock(id, params, ir_inst_list_append(insts, cleanup), term)
        }
      } else { block }
      IrBlockListCons(
        patched,
        pipeline_ir_block_list_append_loop_scrutinee_cleanup(rest, scrutinee_value, release_ty, base_dst, index + applies, continue_block, target_block)
      )
    }
  }
}

pub(package) fn pipeline_managed_scrutinee_release_append(arm_blocks: PipelineLoweredBlocks, release_ty: i64, release_block: i64, target_block: i64, scrutinee_value: i64, carried_lanes: i64, loop_continue_block: i64, loop_target_block: i64) -> PipelineLoweredBlocks {
  if release_ty == 0 or pipeline_lowered_blocks_is_valid(arm_blocks) == 0 {
    arm_blocks
  } else {
    let blocks = pipeline_lowered_blocks_blocks(arm_blocks)
    let release_stride = pipeline_type_managed_release_lane_count(release_ty)
    let return_base = pipeline_lowered_blocks_next_value(arm_blocks)
    let return_count = pipeline_ir_block_list_return_count(blocks)
    let return_cleaned = pipeline_ir_block_list_append_return_scrutinee_cleanup(blocks, scrutinee_value, release_ty, return_base, 0)
    let loop_base = return_base + return_count * release_stride
    let loop_count = if loop_target_block >= 0 {
      pipeline_ir_block_list_loop_pattern_cleanup_count(blocks, loop_continue_block, loop_target_block)
    } else { 0 }
    let control_cleaned = if loop_target_block >= 0 {
      pipeline_ir_block_list_append_loop_scrutinee_cleanup(return_cleaned, scrutinee_value, release_ty, loop_base, 0, loop_continue_block, loop_target_block)
    } else { return_cleaned }
    let after_control = loop_base + loop_count * release_stride
    if pipeline_lowered_blocks_falls_through(arm_blocks) == 0 {
      pipeline_lowered_blocks_control(
        pipeline_lowered_blocks_next_block(arm_blocks), after_control,
        control_cleaned, 1, 0
      )
    } else {
      let edge_lanes = pipeline_ir_first_jump_arg_count_to_target(blocks, release_block, carried_lanes)
      let release_insts = pipeline_managed_release_inst_list_with_origin(scrutinee_value, release_ty, after_control + edge_lanes, ir_managed_stake_origin_control())
      let carried_values = pipeline_ir_value_lane_ids(after_control, 0, edge_lanes)
      let block = ir_block_new_params(release_block, carried_values, release_insts, ir_term_jump_args(target_block, carried_values))
      pipeline_lowered_blocks_control(
        pipeline_lowered_blocks_next_block(arm_blocks),
        after_control + edge_lanes + ir_inst_list_len(release_insts),
        ir_block_list_append(control_cleaned, ir_block_list_prepend(block, ir_block_list_empty())),
        1,
        1
      )
    }
  }
}

pub(package) fn pipeline_lower_match_typed_core_to_target_blocks_control_with_float(scrutinee_typed: Expr, arms: MatchArmList, result_prim: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64, loop_target_block: i64, loop_normal_block: i64, loop_continue_block: i64, loop_break_mode: i64) -> PipelineLoweredBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  let n_arms = match_arm_list_len(arms)
  let normalise_owned = pipeline_expr_owned_rvalue_temp_typed(scrutinee_typed, src, tt)
  let scrutinee_ty = pipeline_return_expr_type_node_typed(scrutinee_typed, params, locals, module)
  let result_ty = pipeline_match_arms_result_type_node_with_scrutinee_typed(arms, params, locals, module, scrutinee_ty)
  let result_lanes = pipeline_type_value_lane_count_or_one(result_ty)
  let scrutinee_release_ty = pipeline_match_scrutinee_release_type(scrutinee_typed, arms, params, locals, module)
  if n_arms <= 0 {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    if pipeline_expr_needs_lowering_cfg_typed(scrutinee_typed, src) == 1 {
      let scrutinee_merge_block = pipeline_lower_internal_block_after_target(next_block, target_block)
      let scrutinee_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved(scrutinee_typed, params, locals, module, next_value, start_block, scrutinee_merge_block + 1, scrutinee_merge_block)
      if pipeline_lowered_blocks_is_valid(scrutinee_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(scrutinee_blocks) == 0 {
          scrutinee_blocks
        } else {
          let scrutinee_value = pipeline_lowered_blocks_next_value(scrutinee_blocks)
          let release_block = if scrutinee_release_ty != 0 { pipeline_lower_internal_block_after_target(pipeline_lowered_blocks_next_block(scrutinee_blocks), target_block) } else { 0 }
          let arms_target = if scrutinee_release_ty != 0 { release_block } else { target_block }
          let first_arm_seed = if scrutinee_release_ty != 0 { release_block + 1 } else { pipeline_lowered_blocks_next_block(scrutinee_blocks) }
          let first_arm = pipeline_lower_internal_block_after_target(first_arm_seed, target_block)
          let ctx = PipelineMatchCtx(arms, n_arms, scrutinee_value, params, locals, module, arms_target, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode)
          let arm_blocks_raw = pipeline_lower_match_arm_to_blocks(ctx, 0, scrutinee_value + 1, first_arm, first_arm + 1)
          let arm_blocks = pipeline_managed_scrutinee_release_append(arm_blocks_raw, scrutinee_release_ty, release_block, target_block, scrutinee_value, result_lanes, loop_continue_block, loop_target_block)
          if pipeline_lowered_blocks_is_valid(arm_blocks) == 1 {
            let scrutinee_params = ir_value_list_prepend(scrutinee_value, ir_value_list_empty())
            let scrutinee_merge = ir_block_new_params(scrutinee_merge_block, scrutinee_params, ir_inst_list_empty(), ir_term_jump(first_arm))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(scrutinee_blocks),
              ir_block_list_prepend(scrutinee_merge, pipeline_lowered_blocks_blocks(arm_blocks))
            )
            pipeline_lowered_blocks_control(
              pipeline_lowered_blocks_next_block(arm_blocks),
              pipeline_lowered_blocks_next_value(arm_blocks),
              blocks,
              1,
              pipeline_lowered_blocks_falls_through(arm_blocks)
            )
          } else {
            pipeline_lowered_blocks_invalid(start_block, next_value)
          }
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    } else {
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let scrutinee = pipeline_lower_expr_typed_sidecar_handler_ctx(scrutinee_typed, next_value, lower_ctx)
      if ir_lowered_expr_is_valid(scrutinee) == 1 {
        let release_block = if scrutinee_release_ty != 0 { pipeline_lower_internal_block_after_target(next_block, target_block) } else { 0 }
        let arms_target = if scrutinee_release_ty != 0 { release_block } else { target_block }
        let first_arm_seed = if scrutinee_release_ty != 0 { release_block + 1 } else { next_block }
        let first_arm = pipeline_lower_internal_block_after_target(first_arm_seed, target_block)
        let ctx = PipelineMatchCtx(arms, n_arms, ir_lowered_expr_value(scrutinee), params, locals, module, arms_target, normalise_owned, scrutinee_ty, result_prim, loop_target_block, loop_normal_block, loop_continue_block, loop_break_mode)
        let arm_blocks_raw = pipeline_lower_match_arm_to_blocks(ctx, 0, ir_lowered_expr_next_value(scrutinee), first_arm, first_arm + 1)
        let arm_blocks = pipeline_managed_scrutinee_release_append(arm_blocks_raw, scrutinee_release_ty, release_block, target_block, ir_lowered_expr_value(scrutinee), result_lanes, loop_continue_block, loop_target_block)
        if pipeline_lowered_blocks_is_valid(arm_blocks) == 1 {
          let entry = ir_block_new_term(start_block, ir_lowered_expr_insts(scrutinee), ir_term_jump(first_arm))
          let blocks = ir_block_list_prepend(entry, pipeline_lowered_blocks_blocks(arm_blocks))
          pipeline_lowered_blocks(pipeline_lowered_blocks_next_block(arm_blocks), pipeline_lowered_blocks_next_value(arm_blocks), blocks, 1)
        } else {
          pipeline_lowered_blocks_invalid(start_block, next_value)
        }
      } else {
        pipeline_lowered_blocks_invalid(start_block, next_value)
      }
    }
  }
}

pub(package) fn pipeline_lower_match_typed_core_to_target_blocks_with_float(scrutinee_typed: Expr, arms: MatchArmList, result_prim: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_match_typed_core_to_target_blocks_control_with_float(
    scrutinee_typed, arms, result_prim, params, locals, module,
    next_value, start_block, next_block, target_block,
    0 - 1, 0 - 1, 0 - 1, 0
  )
}

pub(package) fn pipeline_lower_match_typed_core_to_target_blocks(scrutinee_typed: Expr, arms: MatchArmList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_match_typed_core_to_target_blocks_with_float(scrutinee_typed, arms, 0, params, locals, module, next_value, start_block, next_block, target_block)
}

pub(package) fn pipeline_lower_match_to_target_blocks(expr: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  pipeline_lower_match_typed_core_to_target_blocks(
    expr_from_node(node_f1(expr)),
    match_arm_list_from_nodes(node_f2(expr), 0, node_f3(expr)),
    params,
    locals,
    module,
    next_value,
    start_block,
    next_block,
    target_block
  )
}

pub(package) fn pipeline_call_args_have_cfg(args: i64, nargs: i64, index: i64) -> i64 {
  if index >= nargs {
    0
  } else {
    if pipeline_expr_needs_cfg(nlist_get(args, index)) == 1 {
      1
    } else {
      pipeline_call_args_have_cfg(args, nargs, index + 1)
    }
  }
}

pub(package) fn pipeline_record_fields_have_cfg(fields: i64, nfields: i64, index: i64) -> i64 {
  if index >= nfields {
    0
  } else {
    let field = nlist_get(fields, index)
    if pipeline_expr_needs_cfg(node_f3(field)) == 1 {
      1
    } else {
      pipeline_record_fields_have_cfg(fields, nfields, index + 1)
    }
  }
}

pub(package) fn pipeline_expr_needs_cfg(expr: i64) -> i64 {
  let tag = node_tag(expr)
  match tag {
    5 -> 1
    15 -> 1
    25 -> 1
    26 -> 1
    27 -> 1
    10 -> 1
    47 -> 1
    49 -> 1
    52 -> 1
    3 -> {
      if node_f1(expr) == 12 or node_f1(expr) == 13 { 1 }
      else { if pipeline_expr_needs_cfg(node_f2(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f3(expr)) } }
    }
    22 -> pipeline_expr_needs_cfg(node_f1(expr))
    45 -> pipeline_expr_needs_cfg(node_f1(expr))
    46 -> if pipeline_expr_needs_cfg(node_f1(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f2(expr)) }
    4 -> pipeline_call_args_have_cfg(node_f3(expr), node_f4(expr), 0)
    32 -> {
      let args_node = node_f4(expr)
      pipeline_call_args_have_cfg(args_node, nlist_len(args_node), 0)
    }
    33 -> 1
    64 -> 1
    36 -> {
      let call_node = node_f2(expr)
      let args = if node_tag(call_node) == 32 { node_f4(call_node) } else { node_f3(call_node) }
      let arg_count = if node_tag(call_node) == 32 { nlist_len(args) } else { node_f4(call_node) }
      pipeline_call_args_have_cfg(args, arg_count, 0)
    }
    41 -> {
      let args_node = node_f3(expr)
      if pipeline_expr_needs_cfg(node_f1(expr)) == 1 { 1 } else { pipeline_call_args_have_cfg(args_node, nlist_len(args_node), 0) }
    }
    13 -> pipeline_expr_needs_cfg(node_f1(expr))
    59 -> pipeline_expr_needs_cfg(node_f1(expr))
    60 -> if pipeline_expr_needs_cfg(node_f1(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f2(expr)) }
    61 -> if pipeline_expr_needs_cfg(node_f1(expr)) == 1 or pipeline_expr_needs_cfg(node_f2(expr)) == 1 or pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { 0 }
    62 -> if pipeline_expr_needs_cfg(node_f1(expr)) == 1 or pipeline_expr_needs_cfg(node_f2(expr)) == 1 or pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { 0 }
    48 -> pipeline_expr_needs_cfg(node_f1(expr))
    14 -> if node_f1(expr) == 0 and node_f2(expr) <= 0 { 1 }
      else { pipeline_record_fields_have_cfg(node_f3(expr), node_f4(expr), 0) }
    63 -> 1
    58 -> pipeline_call_args_have_cfg(node_f1(expr), node_f2(expr), 0)
    6 -> if pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f4(expr)) }
    11 -> if pipeline_expr_needs_cfg(node_f3(expr)) == 1 { 1 } else { pipeline_expr_needs_cfg(node_f4(expr)) }
    12 -> pipeline_expr_needs_cfg(node_f3(expr))
    7 -> {
      let rest_node = node_f2(expr)
      if pipeline_expr_needs_cfg(node_f1(expr)) == 1 {
        1
      } else {
        if rest_node == 0 { 0 } else { pipeline_expr_needs_cfg(rest_node) }
      }
    }
    37 -> pipeline_expr_needs_cfg(node_f1(expr))
    _ -> 0
  }
}

pub(package) fn pipeline_expr_list_needs_cfg_typed(exprs: ExprList) -> i64 {
  match exprs {
    ExprListNil -> 0
    ExprListCons(expr, rest) -> {
      if pipeline_expr_needs_cfg_typed(expr) == 1 { 1 } else { pipeline_expr_list_needs_cfg_typed(rest) }
    }
  }
}

pub(package) fn pipeline_record_fields_need_cfg_typed(fields: RecordFieldList) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      match field {
        RecordField(ns, nl, value, fact) -> {
          if pipeline_expr_needs_cfg_typed(value) == 1 { 1 } else { pipeline_record_fields_need_cfg_typed(rest) }
        }
        UnknownRecordField(tag) -> pipeline_record_fields_need_cfg_typed(rest)
      }
    }
  }
}

pub(package) fn pipeline_expr_needs_cfg_typed(expr: Expr) -> i64 {
  match expr {
    If(cond, then_expr, else_expr) -> 1
    Match(scrutinee, arms) -> 1
    Return(value) -> 1
    ReturnNoValue -> 1
    Break(value) -> 1
    BreakNoValue -> 1
    Continue -> 1
    While(cond, body) -> 1
    ForIter(var_ns, var_nl, collection, body) -> 1
    Loop(body) -> 1
    Defer(cleanup, body, source_site) -> 1
    BinOp(op, lhs, rhs) -> {
      if op == 12 or op == 13 { 1 }
      else { if pipeline_expr_needs_cfg_typed(lhs) == 1 { 1 } else { pipeline_expr_needs_cfg_typed(rhs) } }
    }
    Not(operand) -> pipeline_expr_needs_cfg_typed(operand)
    Try(inner, effect_atom) -> pipeline_expr_needs_cfg_typed(inner)
    InterpConcat(left, right) -> if pipeline_expr_needs_cfg_typed(left) == 1 { 1 } else { pipeline_expr_needs_cfg_typed(right) }
    Call(ns, nl, args) -> pipeline_expr_list_needs_cfg_typed(args)
    Perform(lhs, op_ns, op_nl, args) -> {
      if pipeline_expr_needs_cfg_typed(lhs) == 1 { 1 } else { pipeline_expr_list_needs_cfg_typed(args) }
    }
    Handle(body, clauses, hret) -> 1
    WithHandler(config, body, fact, source_site) -> 1
    Resume(value) -> pipeline_expr_needs_cfg_typed(value)
    GenericCall(type_args, inner_call) -> pipeline_expr_needs_cfg_typed(inner_call)
    MethodCall(recv, method_hash, args, type_hash) -> {
      if pipeline_expr_needs_cfg_typed(recv) == 1 { 1 } else { pipeline_expr_list_needs_cfg_typed(args) }
    }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_needs_cfg_typed(base)
    IndexedLen(base, fixed_len) -> pipeline_expr_needs_cfg_typed(base)
    IndexedGet(base, index, element_ty, fixed_len) -> if pipeline_expr_needs_cfg_typed(base) == 1 { 1 } else { pipeline_expr_needs_cfg_typed(index) }
    IndexedSet(base, index, value, fact) -> if pipeline_expr_needs_cfg_typed(base) == 1 or pipeline_expr_needs_cfg_typed(index) == 1 or pipeline_expr_needs_cfg_typed(value) == 1 { 1 } else { 0 }
    IndexedSlice(base, start, end, fact) -> if pipeline_expr_needs_cfg_typed(base) == 1 or pipeline_expr_needs_cfg_typed(start) == 1 or pipeline_expr_needs_cfg_typed(end) == 1 { 1 } else { 0 }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_needs_cfg_typed(base)
    RecordInit(type_ns, type_nl, fields) -> if type_ns == 0 and type_nl <= 0 { 1 }
      else { pipeline_record_fields_need_cfg_typed(fields) }
    RecordUpdate(base, fields, fact) -> 1
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_needs_cfg_typed(elements)
    Let(ns, nl, value, body) -> if pipeline_expr_needs_cfg_typed(value) == 1 { 1 } else { pipeline_expr_needs_cfg_typed(body) }
    LetMut(ns, nl, value, body) -> if pipeline_expr_needs_cfg_typed(value) == 1 { 1 } else { pipeline_expr_needs_cfg_typed(body) }
    Assign(ns, nl, value) -> pipeline_expr_needs_cfg_typed(value)
    Block(first, rest) -> {
      if pipeline_expr_needs_cfg_typed(first) == 1 {
        1
      } else {
        if pipeline_expr_is_absent_typed(rest) == 1 { 0 } else { pipeline_expr_needs_cfg_typed(rest) }
      }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_needs_cfg_typed(inner)
    _ -> 0
  }
}

pub(package) fn pipeline_expr_list_needs_par_scope_cfg_typed(args: ExprList, src: i64) -> i64 {
  match args {
    ExprListNil -> 0
    ExprListCons(arg, rest) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(arg, src) == 1 { 1 }
      else { pipeline_expr_list_needs_par_scope_cfg_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_record_fields_need_par_scope_cfg_typed(fields: RecordFieldList, src: i64) -> i64 {
  match fields {
    RecordFieldListNil -> 0
    RecordFieldListCons(field, rest) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(record_field_value_expr(field), src) == 1 { 1 }
      else { pipeline_record_fields_need_par_scope_cfg_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_match_arms_need_par_scope_cfg_typed(arms: MatchArmList, src: i64) -> i64 {
  match arms {
    MatchArmListNil -> 0
    MatchArmListCons(arm, rest) -> {
      let guard_needs = if match_arm_has_guard(arm) == 1 { pipeline_expr_needs_par_scope_cfg_typed(match_arm_guard_expr(arm), src) } else { 0 }
      if guard_needs == 1 { 1 }
      else {
        if pipeline_expr_needs_par_scope_cfg_typed(match_arm_body_expr(arm), src) == 1 { 1 }
        else { pipeline_match_arms_need_par_scope_cfg_typed(rest, src) }
      }
    }
  }
}

-- Static Par lowering follows the checker-owned declaration carried by a
-- qualified call. A bare call has no declaration fact here and therefore
-- cannot acquire Par semantics from its spelling.
pub(package) fn pipeline_par_call_role_typed(expr: Expr, src: i64) -> ParCallRole {
  match expr {
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args) ->
      typeck_par_decl_role(field_access_fact_declaration(fact))
    _ -> ParCallNone
  }
}

pub(package) fn pipeline_par_call_role_needs_scope_cfg(role: ParCallRole) -> i64 {
  match role {
    ParCallScopeSequential -> 1
    ParCallScopePool -> 1
    ParCallMap -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_par_call_role_is_map(role: ParCallRole) -> i64 {
  match role {
    ParCallMap -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_par_call_role_is_fork(role: ParCallRole) -> i64 {
  match role {
    ParCallFork -> 1
    _ -> 0
  }
}

pub(package) fn pipeline_par_call_args_typed(expr: Expr) -> ExprList {
  match expr {
    Call(ns, nl, args) -> args
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args) -> args
    _ -> expr_list_empty()
  }
}

pub(package) fn pipeline_par_call_pair_typed(expr: Expr, src: i64, tt: i64, fns: i64) -> i64 {
  match expr {
    Perform(FieldAccess(base, field_ns, field_nl, fact), op_ns, op_nl, args) ->
      module_decl_fact_function_pair(field_access_fact_declaration(fact))
    _ -> 0
  }
}

pub(package) fn pipeline_expr_needs_par_scope_cfg_typed(expr: Expr, src: i64) -> i64 {
  match expr {
    Call(ns, nl, args) -> pipeline_expr_list_needs_par_scope_cfg_typed(args, src)
    GenericCall(type_args, inner_call) -> {
      if pipeline_expr_is_vector_to_array_typed(expr, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(inner_call, src) }
    }
    If(cond, then_expr, else_expr) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(cond, src) == 1 { 1 }
      else {
        if pipeline_expr_needs_par_scope_cfg_typed(then_expr, src) == 1 { 1 }
        else { pipeline_expr_needs_par_scope_cfg_typed(else_expr, src) }
      }
    }
    While(cond, body) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(cond, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    ForIter(var_ns, var_nl, collection, body) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(collection, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    Loop(body) -> pipeline_expr_needs_par_scope_cfg_typed(body, src)
    Break(value) -> pipeline_expr_needs_par_scope_cfg_typed(value, src)
    Return(value) -> pipeline_expr_needs_par_scope_cfg_typed(value, src)
    Defer(cleanup, body, source_site) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(cleanup, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    Let(ns, nl, value, body) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(value, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    LetMut(ns, nl, value, body) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(value, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    Assign(ns, nl, value) -> pipeline_expr_needs_par_scope_cfg_typed(value, src)
    AddressOf(mutable, target) -> pipeline_expr_needs_par_scope_cfg_typed(target, src)
    Deref(ptr) -> pipeline_expr_needs_par_scope_cfg_typed(ptr, src)
    PtrAssign(ptr, value) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(ptr, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(value, src) }
    }
    Block(first, rest) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(first, src) == 1 { 1 }
      else {
        if pipeline_expr_is_absent_typed(rest) == 1 { 0 }
        else { pipeline_expr_needs_par_scope_cfg_typed(rest, src) }
      }
    }
    FieldAccess(base, field_ns, field_nl, fact) -> pipeline_expr_needs_par_scope_cfg_typed(base, src)
    IndexedLen(base, fixed_len) -> pipeline_expr_needs_par_scope_cfg_typed(base, src)
    IndexedGet(base, index, element_ty, fixed_len) -> if pipeline_expr_needs_par_scope_cfg_typed(base, src) == 1 { 1 } else { pipeline_expr_needs_par_scope_cfg_typed(index, src) }
    IndexedSet(base, index, value, fact) -> if pipeline_expr_needs_par_scope_cfg_typed(base, src) == 1 or pipeline_expr_needs_par_scope_cfg_typed(index, src) == 1 or pipeline_expr_needs_par_scope_cfg_typed(value, src) == 1 { 1 } else { 0 }
    IndexedSlice(base, start, end, fact) -> if pipeline_expr_needs_par_scope_cfg_typed(base, src) == 1 or pipeline_expr_needs_par_scope_cfg_typed(start, src) == 1 or pipeline_expr_needs_par_scope_cfg_typed(end, src) == 1 { 1 } else { 0 }
    OptChain(base, field_ns, field_nl, effect_atom) -> pipeline_expr_needs_par_scope_cfg_typed(base, src)
    RecordInit(type_ns, type_nl, fields) -> pipeline_record_fields_need_par_scope_cfg_typed(fields, src)
    RecordUpdate(base, fields, fact) -> if pipeline_expr_needs_par_scope_cfg_typed(base, src) == 1 { 1 } else { pipeline_record_fields_need_par_scope_cfg_typed(fields, src) }
    ArrayLiteral(elements, resolved_ty, span) -> pipeline_expr_list_needs_par_scope_cfg_typed(elements, src)
    Match(scrutinee, arms) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(scrutinee, src) == 1 { 1 }
      else { pipeline_match_arms_need_par_scope_cfg_typed(arms, src) }
    }
    BinOp(op, lhs, rhs) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(lhs, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(rhs, src) }
    }
    Not(operand) -> pipeline_expr_needs_par_scope_cfg_typed(operand, src)
    Try(inner, effect_atom) -> pipeline_expr_needs_par_scope_cfg_typed(inner, src)
    InterpConcat(left, right) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(left, src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(right, src) }
    }
    Lambda(params, body, source_site) -> pipeline_expr_needs_par_scope_cfg_typed(body, src)
    Perform(lhs, op_ns, op_nl, args) -> {
      if pipeline_par_call_role_needs_scope_cfg(pipeline_par_call_role_typed(expr, src)) == 1 { 1 }
      else { if pipeline_expr_needs_par_scope_cfg_typed(lhs, src) == 1 { 1 }
      else { pipeline_expr_list_needs_par_scope_cfg_typed(args, src) }
      }
    }
    Handle(body, clauses, hret) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(body, src) == 1 { 1 }
      else { if pipeline_handler_clauses_need_par_scope_cfg_typed(clauses, src) == 1 { 1 }
      else { match hret {
        NoHandleReturn -> 0
        HandleReturnClause(rns, rnl, rb) -> pipeline_expr_needs_par_scope_cfg_typed(rb, src)
      } } }
    }
    WithHandler(config, body, fact, source_site) -> {
      if pipeline_expr_list_needs_par_scope_cfg_typed(handler_configuration_args(config), src) == 1 { 1 }
      else { pipeline_expr_needs_par_scope_cfg_typed(body, src) }
    }
    Resume(value) -> pipeline_expr_needs_par_scope_cfg_typed(value, src)
    MethodCall(recv, method_hash, args, type_hash) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(recv, src) == 1 { 1 }
      else { pipeline_expr_list_needs_par_scope_cfg_typed(args, src) }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_needs_par_scope_cfg_typed(inner, src)
    _ -> 0
  }
}

pub(package) fn pipeline_handler_clauses_need_par_scope_cfg_typed(clauses: HandlerClauseList, src: i64) -> i64 {
  match clauses {
    HandlerClauseListNil -> 0
    HandlerClauseListCons(clause, rest) -> {
      if pipeline_expr_needs_par_scope_cfg_typed(handler_clause_body_expr(clause), src) == 1 { 1 }
      else { pipeline_handler_clauses_need_par_scope_cfg_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_expr_is_vector_to_array_typed(expr: Expr, src: i64) -> i64 {
  match expr {
    GenericCall(type_args, inner_call) -> {
      match inner_call {
        Call(ns, nl, args) -> if src_eq(src, ns, nl, "to_array") == 1 and type_expr_list_len(type_args) == 2 and expr_list_len(args) == 1 { 1 } else { 0 }
        _ -> 0
      }
    }
    LetTyped(inner, ann_type) -> pipeline_expr_is_vector_to_array_typed(inner, src)
    _ -> 0
  }
}

pub(package) fn pipeline_expr_needs_lowering_cfg_typed(expr: Expr, src: i64) -> i64 {
  if pipeline_expr_is_vector_to_array_typed(expr, src) == 1 {
    1
  } else { if pipeline_expr_needs_cfg_typed(expr) == 1 {
    1
  } else {
    pipeline_expr_needs_par_scope_cfg_typed(expr, src)
  } }
}

pub(package) fn pipeline_expr_list_needs_lowering_cfg_typed(args: ExprList, src: i64) -> i64 {
  match args {
    ExprListNil -> 0
    ExprListCons(arg, rest) -> {
      if pipeline_expr_needs_lowering_cfg_typed(arg, src) == 1 { 1 }
      else { pipeline_expr_list_needs_lowering_cfg_typed(rest, src) }
    }
  }
}

pub(package) fn pipeline_expr_is_absent_typed(expr: Expr) -> i64 {
  match expr {
    NilExpr -> 1
    UnknownExpr(tag) -> if tag == 0 { 1 } else { 0 }
    _ -> if expr_tag(expr) == 0 { 1 } else { 0 }
  }
}

pub(package) fn pipeline_expr_call_like_typed(expr: Expr) -> i64 {
  match expr {
    Call(ns, nl, args) -> 1
    LetTyped(inner, ann_type) -> pipeline_expr_call_like_typed(inner)
    _ -> 0
  }
}

pub(package) fn pipeline_lower_call_arg_blocks_typed(args: ExprList, nargs: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, call_block: i64, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, index: i64, next_value: i64, next_block: i64, values: IrValueList) -> PipelineLoweredCallBlocks {
  pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args, nargs, params, locals, module, call_block, expected_params, expected_types, expected_subst, expected_offset, 0, index, next_value, next_block, values)
}

pub(package) fn pipeline_lower_call_arg_blocks_typed_with_borrow_mask(args: ExprList, nargs: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, call_block: i64, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, borrowed_mask: i64, index: i64, next_value: i64, next_block: i64, values: IrValueList) -> PipelineLoweredCallBlocks {
  pipeline_lower_call_arg_blocks_typed_with_borrow_mask_origin(args, nargs, params, locals, module, call_block, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask, index, next_value, next_block, values, ir_managed_stake_origin_call_transport())
}

-- A borrowed ordinary managed value needs a transport stake when the callee
-- owns its parameter. A root-linear value already carries the exact unique
-- obligation being moved; retaining its representation would invent a second
-- owner beside the linear transfer fact.
pub(package) fn pipeline_call_transport_retain_type(
  tt: i64,
  expected_ty: i64,
  actual_ty: i64,
  borrowed: i64
) -> i64 {
  let transfer_ty = if actual_ty == 0 { expected_ty } else { actual_ty }
  if borrowed == 1 or pipeline_linear_cleanup_plan(tt, transfer_ty) != 0 { 0 }
  else { expected_ty }
}

pub(package) fn pipeline_lower_call_arg_blocks_typed_with_borrow_mask_origin(args: ExprList, nargs: i64, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, call_block: i64, expected_params: i64, expected_types: i64, expected_subst: i64, expected_offset: i64, borrowed_mask: i64, index: i64, next_value: i64, next_block: i64, values: IrValueList, origin: i64) -> PipelineLoweredCallBlocks {
  let src = pipeline_lower_module_src(module)
  let tt = pipeline_lower_module_tt(module)
  if index >= nargs {
    pipeline_lowered_call_blocks(values, pipeline_lower_operation_next_block(next_block, call_block), next_value, ir_block_list_empty(), 1)
  } else {
    let arg = pipeline_expr_list_nth_or(args, index, NilExpr)
    let expected_float = pipeline_expected_arg_float_prim(expected_params, expected_types, index, expected_offset, expected_subst)
    let expected_int = if expected_float == 0 { pipeline_expected_arg_int_prim(expected_params, expected_types, index, expected_offset, expected_subst) } else { 0 - 1 }
    let expected_prim = if expected_float == PRIM_F32() or expected_float == PRIM_F64() { expected_float } else { expected_int }
    let expected_ty = pipeline_expected_arg_type_node(expected_params, expected_types, index, expected_offset, expected_subst)
    let actual_ty = pipeline_return_expr_type_node_typed(arg, params, locals, module)
    let retain_ty = pipeline_call_transport_retain_type(
      tt,
      expected_ty,
      actual_ty,
      cg_mask_has(borrowed_mask, index + expected_offset)
    )
    if pipeline_expr_needs_lowering_cfg_typed(arg, src) == 1 {
      let arg_merge_block = next_block + 1
      let arg_next_block = next_block + 2
      let arg_blocks = pipeline_lower_expr_typed_to_target_blocks_reserved_with_float(arg, params, locals, module, next_value, next_block, arg_next_block, arg_merge_block, expected_prim)
      if pipeline_lowered_blocks_is_valid(arg_blocks) == 1 {
        if pipeline_lowered_blocks_falls_through(arg_blocks) == 0 {
          pipeline_lowered_call_blocks_control(
            values,
            pipeline_lowered_blocks_next_block(arg_blocks),
            pipeline_lowered_blocks_next_value(arg_blocks),
            pipeline_lowered_blocks_blocks(arg_blocks),
            1,
            0
          )
        } else {
          let arg_value = pipeline_lowered_blocks_next_value(arg_blocks)
          let rest_start = pipeline_lowered_blocks_next_block(arg_blocks)
          let arg_lanes = if expected_ty != 0 { pipeline_type_value_lane_count_or_one(expected_ty) } else { pipeline_expr_value_lane_count(arg, params, locals, module) }
          let retain = pipeline_managed_borrow_retain_arg_typed_with_origin(arg, arg_value, retain_ty, arg_value + arg_lanes, src, pipeline_lower_module_fns(module), expected_subst, pipeline_lower_module_tt(module), origin)
          let next_values = ir_value_list_append(values, ir_value_list_prepend(arg_value, ir_value_list_empty()))
          let rest = pipeline_lower_call_arg_blocks_typed_with_borrow_mask_origin(args, nargs, params, locals, module, call_block, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask, index + 1, pipeline_lowered_args_next_value(retain), rest_start, next_values, origin)
          if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
            let target = if index + 1 >= nargs { call_block } else { rest_start }
            let arg_params = pipeline_ir_value_lane_ids(arg_value, 0, arg_lanes)
            let arg_merge = ir_block_new_params(arg_merge_block, arg_params, pipeline_lowered_args_insts(retain), ir_term_jump(target))
            let blocks = ir_block_list_append(
              pipeline_lowered_blocks_blocks(arg_blocks),
              ir_block_list_prepend(arg_merge, pipeline_lowered_call_blocks_blocks(rest))
            )
            pipeline_lowered_call_blocks_control(
              pipeline_lowered_call_blocks_values(rest),
              pipeline_lowered_call_blocks_next_block(rest),
              pipeline_lowered_call_blocks_next_value(rest),
              blocks,
              1,
              pipeline_lowered_call_blocks_falls_through(rest)
            )
          } else {
            pipeline_lowered_call_blocks_invalid(next_block, next_value)
          }
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    } else {
      -- Argument expressions belong to the caller. The callee substitution
      -- shapes its expected parameter, but must never replace the enclosing
      -- generic substitution while lowering the expression itself.
      let lower_ctx = pipeline_handler_lower_ctx_from_module(params, locals, module)
      let lowered = if pipeline_prim_is_forced_numeric_context(expected_prim) == 1 {
        pipeline_lower_expr_typed_sidecar_handler_opt_with_float_prim(arg, next_value, lower_ctx, expected_prim)
      } else {
        pipeline_lower_expr_typed_sidecar_handler_ctx(arg, next_value, lower_ctx)
      }
      if ir_lowered_expr_is_valid(lowered) == 1 {
        let rest_start = next_block + 1
        let retain = pipeline_managed_borrow_retain_arg_typed_with_origin(arg, ir_lowered_expr_value(lowered), retain_ty, ir_lowered_expr_next_value(lowered), src, pipeline_lower_module_fns(module), expected_subst, pipeline_lower_module_tt(module), origin)
        let next_values = ir_value_list_append(values, ir_value_list_prepend(ir_lowered_expr_value(lowered), ir_value_list_empty()))
        let rest = pipeline_lower_call_arg_blocks_typed_with_borrow_mask_origin(args, nargs, params, locals, module, call_block, expected_params, expected_types, expected_subst, expected_offset, borrowed_mask, index + 1, pipeline_lowered_args_next_value(retain), rest_start, next_values, origin)
        if pipeline_lowered_call_blocks_is_valid(rest) == 1 {
          let target = if index + 1 >= nargs { call_block } else { rest_start }
          let block = ir_block_new_term(next_block, ir_inst_list_append(ir_lowered_expr_insts(lowered), pipeline_lowered_args_insts(retain)), ir_term_jump(target))
          let blocks = ir_block_list_prepend(block, pipeline_lowered_call_blocks_blocks(rest))
          pipeline_lowered_call_blocks_control(
            pipeline_lowered_call_blocks_values(rest),
            pipeline_lowered_call_blocks_next_block(rest),
            pipeline_lowered_call_blocks_next_value(rest),
            blocks,
            1,
            pipeline_lowered_call_blocks_falls_through(rest)
          )
        } else {
          pipeline_lowered_call_blocks_invalid(next_block, next_value)
        }
      } else {
        pipeline_lowered_call_blocks_invalid(next_block, next_value)
      }
    }
  }
}

pub(package) fn pipeline_lower_native_intrinsic_call_typed_to_target_blocks(callee_hash: i64, args_expr: ExprList, params: i64, locals: PipelineValueEnv, module: PipelineLowerModule, next_value: i64, start_block: i64, next_block: i64, target_block: i64) -> PipelineLoweredBlocks {
  let kind = pipeline_ir_native_intrinsic_kind(callee_hash)
  let arity = pipeline_ir_native_intrinsic_arity(kind)
  let arg_count = expr_list_len(args_expr)
  if kind == 0 or arity != arg_count {
    pipeline_lowered_blocks_invalid(start_block, next_value)
  } else {
    let call_block = next_block
    let first_arg_block = pipeline_lower_operation_child_start_block(call_block, arg_count)
    let lowered_args = pipeline_lower_call_arg_blocks_typed(args_expr, arg_count, params, locals, module, call_block, 0, 0, pipeline_lower_module_subst(module), 0, 0, next_value, first_arg_block, ir_value_list_empty())
    if pipeline_lowered_call_blocks_is_valid(lowered_args) == 1 {
      let entry = ir_block_new_term(start_block, ir_inst_list_empty(), ir_term_jump(first_arg_block))
      if pipeline_lowered_call_blocks_falls_through(lowered_args) == 0 {
        let blocks = ir_block_list_prepend(entry, pipeline_lowered_call_blocks_blocks(lowered_args))
        pipeline_lowered_blocks_control(pipeline_lowered_call_blocks_next_block(lowered_args), pipeline_lowered_call_blocks_next_value(lowered_args), blocks, 1, 0)
      } else {
        let values = pipeline_lowered_call_blocks_values(lowered_args)
        if kind == 4 {
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let ptr_value = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
          let load = ir_inst_list_prepend(ir_inst_ptr_load_i64(dst, ptr_value), ir_inst_list_empty())
          let call_args = ir_value_list_prepend(dst, ir_value_list_empty())
          let call = ir_block_new_term(call_block, load, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
        } else { if kind == 2 {
          let ptr_value = pipeline_ir_value_list_get_or(values, 0, 0 - 1)
          let stored_value = pipeline_ir_value_list_get_or(values, 1, 0 - 1)
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let store = ir_inst_list_prepend(ir_inst_ptr_store_i64(dst, ptr_value, stored_value), ir_inst_list_empty())
          let call_args = ir_value_list_prepend(stored_value, ir_value_list_empty())
          let call = ir_block_new_term(call_block, store, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
        } else {
          let dst = pipeline_lowered_call_blocks_next_value(lowered_args)
          let call_inst = ir_inst_list_prepend(ir_inst_call_i64(dst, callee_hash, values), ir_inst_list_empty())
          let call_args = ir_value_list_prepend(dst, ir_value_list_empty())
          let call = ir_block_new_term(call_block, call_inst, ir_term_jump_args(target_block, call_args))
          let blocks = ir_block_list_prepend(entry, ir_block_list_append(pipeline_lowered_call_blocks_blocks(lowered_args), ir_block_list_prepend(call, ir_block_list_empty())))
          pipeline_lowered_blocks(pipeline_lowered_call_blocks_next_block(lowered_args), dst + 1, blocks, 1)
        } }
      }
    } else {
      pipeline_lowered_blocks_invalid(start_block, next_value)
    }
  }
}

